0,"_33600":48154,"_33602":48157,"_33604":48161,"_33606":48164,"_33608":48167,"_33610":48170,"_33612":48173,"_33614":48176,"_33616":48179,"_33618":48182,"_33620":48185,"_33622":48188,"_33624":48191,"_33626":48194,"_33628":48196,"_33630":48199,"_33632":48202,"_33634":48205,"_33636":48208,"_33638":48211,"_33640":48214,"_33642":48217,"_33644":48220,"_33646":48223,"_33648":48226,"_33650":48230,"_33652":48233,"_33654":48237,"_33656":48241,"_33658":48245,"_33660":48248,"_33662":48251,"_33664":48253,"_33666":48256,"_33668":48258,"_33670":48261,"_33672":48264,"_33674":48267,"_33676":48270,"_33678":48273,"_33680":48276,"_33682":48279,"_33684":48282,"_33686":48285,"_33688":48288,"_33690":48291,"_33692":48294,"_33694":48296,"_33696":48299,"_33698":48302,"_33700":48305,"_33702":48308,"_33704":48311,"_33706":48314,"_33708":48317,"_33710":48320,"_33712":48323,"_33714":48326,"_33716":48329,"_33718":48332},{"_2859":15,"_25205":15,"_5":12316,"_2386":40892,"_25540":40893,"_17596":40897,"_23867":15},"Deploy from AWS Marketplace",[40894,40895,40896],"Docs","Deployment","Other models",[],{"_2859":16,"_25205":15,"_17596":40899,"_5":17486,"_23867":15,"_2386":40900},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_2859":17,"_25205":15,"_5":25537,"_17596":40902,"_23867":40903,"_2386":40904},[],"/docs/pr-preview/pr-43/deployment/aws-marketplace#before-you-begin","Before you begin",{"_2859":18,"_25205":15,"_5":25537,"_17596":40906,"_23867":40907,"_2386":40908},[],"/docs/pr-preview/pr-43/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_2859":19,"_25205":15,"_5":25537,"_17596":40910,"_23867":40911,"_2386":40912},[],"/docs/pr-preview/pr-43/deployment/aws-marketplace#open-the-offer","Open the offer",{"_2859":20,"_25205":15,"_5":25537,"_17596":40914,"_23867":40915,"_2386":40916},[],"/docs/pr-preview/pr-43/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_2859":21,"_25205":15,"_5":25537,"_17596":40918,"_23867":40919,"_2386":40920},[],"/docs/pr-preview/pr-43/deployment/aws-marketplace#limit-network-access","Limit network access",{"_2859":22,"_25205":15,"_5":25537,"_17596":40922,"_23867":40923,"_2386":40924},[],"/docs/pr-preview/pr-43/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_2859":23,"_25205":15,"_5":25537,"_17596":40926,"_23867":40927,"_2386":40928},[],"/docs/pr-preview/pr-43/deployment/aws-marketplace#next-step","Next step",{"_2859":24,"_25205":15,"_17596":40930,"_5":17486,"_23867":15,"_2386":40931},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_2859":25,"_25205":15,"_17596":40933,"_5":17486,"_23867":40903,"_2386":40934},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_2859":26,"_25205":15,"_17596":40936,"_5":17486,"_23867":40903,"_2386":40937},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_2859":27,"_25205":15,"_17596":40939,"_5":17486,"_23867":40903,"_2386":40940},[],"A security group allowing the necessary endpoints.",{"_2859":28,"_25205":15,"_17596":40942,"_5":17486,"_23867":40907,"_2386":40943},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_2859":29,"_25205":15,"_17596":40945,"_5":17486,"_23867":40907,"_2386":40946},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_2859":30,"_25205":15,"_17596":40948,"_5":17486,"_23867":40907,"_2386":40949},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_2859":31,"_25205":15,"_17596":40951,"_5":17486,"_23867":40911,"_2386":40952},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_2859":32,"_25205":15,"_17596":40954,"_5":17486,"_23867":40915,"_2386":40955},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_2859":33,"_25205":15,"_17596":40957,"_5":17486,"_23867":40919,"_2386":40958},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_2859":34,"_25205":15,"_17596":40960,"_5":17486,"_23867":40923,"_2386":40961},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_2859":35,"_25205":15,"_17596":40963,"_5":17486,"_23867":40927,"_2386":40964},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_2859":36,"_25205":36,"_5":12316,"_2386":40966,"_25540":40967,"_17596":40968,"_23867":36},"Deploy Lamassu",[40894,40895],[],{"_2859":37,"_25205":36,"_17596":40970,"_5":17486,"_23867":36,"_2386":40971},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_2859":38,"_25205":36,"_5":25537,"_17596":40973,"_23867":40974,"_2386":40975},[],"/docs/pr-preview/pr-43/deployment/overview#choose-a-model","Choose a model",{"_2859":39,"_25205":36,"_5":25537,"_17596":40977,"_23867":40978,"_2386":40979},[],"/docs/pr-preview/pr-43/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_2859":40,"_25205":36,"_5":25537,"_17596":40981,"_23867":40982,"_2386":40983},[],"/docs/pr-preview/pr-43/deployment/overview#after-deployment","After deployment",{"_2859":41,"_25205":36,"_17596":40985,"_5":17486,"_23867":36,"_2386":40986},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_2859":42,"_25205":36,"_17596":40988,"_5":17486,"_23867":40974,"_2386":40989},[],"Model",{"_2859":43,"_25205":36,"_17596":40991,"_5":17486,"_23867":40974,"_2386":40992},[],"Recommended for",{"_2859":44,"_25205":36,"_17596":40994,"_5":17486,"_23867":40974,"_2386":40995},[],"Who operates the infrastructure",{"_2859":45,"_25205":36,"_17596":40997,"_5":17486,"_23867":40974,"_2386":40998},[],"Starting point",{"_2859":46,"_25205":36,"_17596":41000,"_5":17486,"_23867":40974,"_2386":41001},[],"Kubernetes self-managed",{"_2859":47,"_25205":36,"_17596":41003,"_5":17486,"_23867":40974,"_2386":41004},[],"Production, regulated environments and custom deployments",{"_2859":48,"_25205":36,"_17596":41006,"_5":17486,"_23867":40974,"_2386":41007},[],"Your team",{"_2859":49,"_25205":36,"_17596":41009,"_5":17486,"_23867":40974,"_2386":41010},[],"Helm or Fastlane",{"_2859":50,"_25205":36,"_17596":41012,"_5":17486,"_23867":40974,"_2386":41013},[],"AWS Marketplace",{"_2859":51,"_25205":36,"_17596":41015,"_5":17486,"_23867":40974,"_2386":41016},[],"Evaluation or a dedicated deployment inside an AWS account",{"_2859":52,"_25205":36,"_17596":41018,"_5":17486,"_23867":40974,"_2386":41007},[],{"_2859":53,"_25205":36,"_17596":41020,"_5":17486,"_23867":40974,"_2386":41021},[],"Preconfigured image on EC2",{"_2859":54,"_25205":36,"_17596":41023,"_5":17486,"_23867":40974,"_2386":41024},[],"SaaS",{"_2859":55,"_25205":36,"_17596":41026,"_5":17486,"_23867":40974,"_2386":41027},[],"Teams that want to use the platform without operating it",{"_2859":56,"_25205":36,"_17596":41029,"_5":17486,"_23867":40974,"_2386":41030},[],"Lamassu",{"_2859":57,"_25205":36,"_17596":41032,"_5":17486,"_23867":40974,"_2386":41033},[],"Managed subscription",{"_2859":58,"_25205":36,"_17596":41035,"_5":17486,"_23867":40974,"_2386":41036},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2859":59,"_25205":36,"_17596":41038,"_5":17486,"_23867":40974,"_2386":41039},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2859":60,"_25205":36,"_17596":41041,"_5":17486,"_23867":40974,"_2386":41042},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_2859":61,"_25205":36,"_17596":41044,"_5":17486,"_23867":40978,"_2386":41045},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_2859":62,"_25205":36,"_17596":41047,"_5":17486,"_23867":40982,"_2386":41048},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_2859":63,"_25205":63,"_5":12316,"_2386":41050,"_25540":41051,"_17596":41052,"_23867":63},"Use Lamassu as SaaS",[40894,40895,40896],[],{"_2859":64,"_25205":63,"_17596":41054,"_5":17486,"_23867":63,"_2386":41055},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_2859":65,"_25205":63,"_5":25537,"_17596":41057,"_23867":41058,"_2386":41059},[],"/docs/pr-preview/pr-43/deployment/saas#what-the-service-manages","What the service manages",{"_2859":66,"_25205":63,"_5":25537,"_17596":41061,"_23867":41062,"_2386":41063},[],"/docs/pr-preview/pr-43/deployment/saas#plans","Plans",{"_2859":67,"_25205":63,"_5":25537,"_17596":41065,"_23867":41066,"_2386":41067},[],"/docs/pr-preview/pr-43/deployment/saas#request-access","Request access",{"_2859":68,"_25205":63,"_17596":41069,"_5":17486,"_23867":63,"_2386":41070},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_2859":69,"_25205":63,"_17596":41072,"_5":17486,"_23867":41058,"_2386":41073},[],"Platform availability and maintenance.",{"_2859":70,"_25205":63,"_17596":41075,"_5":17486,"_23867":41058,"_2386":41076},[],"Automatic backups.",{"_2859":71,"_25205":63,"_17596":41078,"_5":17486,"_23867":41058,"_2386":41079},[],"Version upgrades.",{"_2859":72,"_25205":63,"_17596":41081,"_5":17486,"_23867":41058,"_2386":41082},[],"Technical support and SLA according to your plan.",{"_2859":73,"_25205":63,"_17596":41084,"_5":17486,"_23867":41062,"_2386":41085},[],"Plan",{"_2859":74,"_25205":63,"_17596":41087,"_5":17486,"_23867":41062,"_2386":41088},[],"Devices",{"_2859":75,"_25205":63,"_17596":41090,"_5":17486,"_23867":41062,"_2386":41091},[],"Support",{"_2859":76,"_25205":63,"_17596":41093,"_5":17486,"_23867":41062,"_2386":41094},[],"SLA",{"_2859":77,"_25205":63,"_17596":41096,"_5":17486,"_23867":41062,"_2386":41097},[],"Starter",{"_2859":78,"_25205":63,"_17596":41099,"_5":17486,"_23867":41062,"_2386":41100},[],"Up to 1,000",{"_2859":79,"_25205":63,"_17596":41102,"_5":17486,"_23867":41062,"_2386":41103},[],"Email",{"_2859":80,"_25205":63,"_17596":41105,"_5":17486,"_23867":41062,"_2386":41106},[],"99.5 %",{"_2859":81,"_25205":63,"_17596":41108,"_5":17486,"_23867":41062,"_2386":41109},[],"Professional",{"_2859":82,"_25205":63,"_17596":41111,"_5":17486,"_23867":41062,"_2386":41112},[],"Up to 10,000",{"_2859":83,"_25205":63,"_17596":41114,"_5":17486,"_23867":41062,"_2386":41115},[],"Email and chat",{"_2859":84,"_25205":63,"_17596":41117,"_5":17486,"_23867":41062,"_2386":41118},[],"99.9 %",{"_2859":85,"_25205":63,"_17596":41120,"_5":17486,"_23867":41062,"_2386":41121},[],"Enterprise",{"_2859":86,"_25205":63,"_17596":41123,"_5":17486,"_23867":41062,"_2386":41124},[],"Unlimited",{"_2859":87,"_25205":63,"_17596":41126,"_5":17486,"_23867":41062,"_2386":41127},[],"Dedicated",{"_2859":88,"_25205":63,"_17596":41129,"_5":17486,"_23867":41062,"_2386":41130},[],"99.99 %",{"_2859":89,"_25205":63,"_17596":41132,"_5":17486,"_23867":41066,"_2386":41133},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_2859":90,"_25205":63,"_17596":41135,"_5":17486,"_23867":41066,"_2386":41136},[],"When you receive your instance's credentials, continue with Get started.",{"_2859":91,"_25205":91,"_5":12316,"_2386":41138,"_25540":41139,"_17596":41140,"_23867":91},"Fastlane",[40894,40895,41001],[],{"_2859":92,"_25205":91,"_17596":41142,"_5":17486,"_23867":91,"_2386":41143},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_2859":93,"_25205":91,"_5":25537,"_17596":41145,"_23867":41146,"_2386":41147},[],"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_2859":94,"_25205":91,"_5":25537,"_17596":41149,"_23867":41150,"_2386":41151},[],"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_2859":95,"_25205":91,"_5":25537,"_17596":41153,"_23867":41154,"_2386":40904},[],"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#before-you-begin",{"_2859":96,"_25205":91,"_5":25537,"_17596":41156,"_23867":41157,"_2386":41158},[],"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#quick-start","Quick start",{"_2859":97,"_25205":91,"_5":25537,"_17596":41160,"_23867":41161,"_2386":41162},[],"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_2859":98,"_25205":91,"_5":25537,"_17596":41164,"_23867":41165,"_2386":41166},[],"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_2859":99,"_25205":91,"_5":25537,"_17596":41168,"_23867":41169,"_2386":41170},[],"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_2859":100,"_25205":91,"_5":25537,"_17596":41172,"_23867":41173,"_2386":41174},[],"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_2859":101,"_25205":91,"_5":25537,"_17596":41176,"_23867":41177,"_2386":41178},[],"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_2859":102,"_25205":91,"_5":25537,"_17596":41180,"_23867":41181,"_2386":41182},[],"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_2859":103,"_25205":91,"_17596":41184,"_5":17486,"_23867":41146,"_2386":41185},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_2859":104,"_25205":91,"_17596":41187,"_5":17486,"_23867":41146,"_2386":41188},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_2859":105,"_25205":91,"_17596":41190,"_5":17486,"_23867":41150,"_2386":41191},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_2859":106,"_25205":91,"_17596":41193,"_5":17486,"_23867":41150,"_2386":41194},[],"Fastlane installs or configures",{"_2859":107,"_25205":91,"_17596":41196,"_5":17486,"_23867":41150,"_2386":41197},[],"You still provide",{"_2859":108,"_25205":91,"_17596":41199,"_5":17486,"_23867":41150,"_2386":41200},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_2859":109,"_25205":91,"_17596":41202,"_5":17486,"_23867":41150,"_2386":41203},[],"The Kubernetes cluster, nodes and persistent storage",{"_2859":110,"_25205":91,"_17596":41205,"_5":17486,"_23867":41150,"_2386":41206},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_2859":111,"_25205":91,"_17596":41208,"_5":17486,"_23867":41150,"_2386":41209},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_2859":112,"_25205":91,"_17596":41211,"_5":17486,"_23867":41150,"_2386":41212},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_2859":113,"_25205":91,"_17596":41214,"_5":17486,"_23867":41150,"_2386":41215},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_2859":114,"_25205":91,"_17596":41217,"_5":17486,"_23867":41150,"_2386":41218},[],"Optional observability and lab HSM components",{"_2859":115,"_25205":91,"_17596":41220,"_5":17486,"_23867":41150,"_2386":41221},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_2859":116,"_25205":91,"_17596":41223,"_5":17486,"_23867":41150,"_2386":41224},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_2859":117,"_25205":91,"_17596":41226,"_5":17486,"_23867":41154,"_2386":41227},[],"You need:",{"_2859":118,"_25205":91,"_17596":41229,"_5":17486,"_23867":41154,"_2386":41230},[],"an existing Kubernetes cluster",{"_2859":119,"_25205":91,"_17596":41232,"_5":17486,"_23867":41154,"_2386":41233},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_2859":120,"_25205":91,"_17596":41235,"_5":17486,"_23867":41154,"_2386":41236},[],"`yq`",{"_2859":121,"_25205":91,"_17596":41238,"_5":17486,"_23867":41154,"_2386":19914},[],{"_2859":122,"_25205":91,"_17596":41240,"_5":17486,"_23867":41154,"_2386":41241},[],"`jq` only when using `--sample-data`",{"_2859":123,"_25205":91,"_17596":41243,"_5":17486,"_23867":41154,"_2386":41244},[],"free external ports 80 and 443 on a single-node K3s host",{"_2859":124,"_25205":91,"_17596":41246,"_5":17486,"_23867":41154,"_2386":41247},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_2859":125,"_25205":91,"_17596":41249,"_5":17486,"_23867":41154,"_2386":41250},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_2859":126,"_25205":91,"_17596":41252,"_5":17486,"_23867":41157,"_2386":41253},[],"Run the script from a clone of the Helm repository:",{"_2859":127,"_25205":91,"_17596":41255,"_5":17486,"_23867":41157,"_2386":41256},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_2859":128,"_25205":91,"_17596":41258,"_5":17486,"_23867":41161,"_2386":41259},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_2859":129,"_25205":91,"_17596":41261,"_5":17486,"_23867":41161,"_2386":41262},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_2859":130,"_25205":91,"_17596":41264,"_5":17486,"_23867":41161,"_2386":41265},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_2859":131,"_25205":91,"_17596":41267,"_5":17486,"_23867":41161,"_2386":41268},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_2859":132,"_25205":91,"_17596":41270,"_5":17486,"_23867":41165,"_2386":41271},[],"Option",{"_2859":133,"_25205":91,"_17596":41273,"_5":17486,"_23867":41165,"_2386":41274},[],"Default",{"_2859":134,"_25205":91,"_17596":41276,"_5":17486,"_23867":41165,"_2386":41277},[],"Purpose",{"_2859":135,"_25205":91,"_17596":41279,"_5":17486,"_23867":41165,"_2386":41280},[],"`-h`, `--help`",{"_2859":136,"_25205":91,"_17596":41282,"_5":17486,"_23867":41165,"_2386":41283},[],"—",{"_2859":137,"_25205":91,"_17596":41285,"_5":17486,"_23867":41165,"_2386":41286},[],"Show help",{"_2859":138,"_25205":91,"_17596":41288,"_5":17486,"_23867":41165,"_2386":41289},[],"`-c`, `--context`",{"_2859":139,"_25205":91,"_17596":41291,"_5":17486,"_23867":41165,"_2386":41292},[],"current context",{"_2859":140,"_25205":91,"_17596":41294,"_5":17486,"_23867":41165,"_2386":41295},[],"Select the kubeconfig context for kubectl and Helm",{"_2859":141,"_25205":91,"_17596":41297,"_5":17486,"_23867":41165,"_2386":41298},[],"`-n`, `--non-interactive`",{"_2859":142,"_25205":91,"_17596":41300,"_5":17486,"_23867":41165,"_2386":5353},[],{"_2859":143,"_25205":91,"_17596":41302,"_5":17486,"_23867":41165,"_2386":41303},[],"Skip prompts and generate dependency credentials",{"_2859":144,"_25205":91,"_17596":41305,"_5":17486,"_23867":41165,"_2386":41306},[],"`-ns`, `--namespace`",{"_2859":145,"_25205":91,"_17596":41308,"_5":17486,"_23867":41165,"_2386":41309},[],"`lamassu-dev`",{"_2859":146,"_25205":91,"_17596":41311,"_5":17486,"_23867":41165,"_2386":41312},[],"Namespace for the installation",{"_2859":147,"_25205":91,"_17596":41314,"_5":17486,"_23867":41165,"_2386":41315},[],"`-d`, `--domain`",{"_2859":148,"_25205":91,"_17596":41317,"_5":17486,"_23867":41165,"_2386":41318},[],"`dev.lamassu.io`",{"_2859":149,"_25205":91,"_17596":41320,"_5":17486,"_23867":41165,"_2386":41321},[],"Domain used by the UI, OIDC and certificate",{"_2859":150,"_25205":91,"_17596":41323,"_5":17486,"_23867":41165,"_2386":41324},[],"`-v`, `--version`",{"_2859":151,"_25205":91,"_17596":41326,"_5":17486,"_23867":41165,"_2386":12554},[],{"_2859":152,"_25205":91,"_17596":41328,"_5":17486,"_23867":41165,"_2386":41329},[],"Lamassu chart version",{"_2859":153,"_25205":91,"_17596":41331,"_5":17486,"_23867":41165,"_2386":41332},[],"`--https-port`",{"_2859":154,"_25205":91,"_17596":41334,"_5":17486,"_23867":41165,"_2386":41335},[],"`443`",{"_2859":155,"_25205":91,"_17596":41337,"_5":17486,"_23867":41165,"_2386":41338},[],"Gateway HTTPS listener port",{"_2859":156,"_25205":91,"_17596":41340,"_5":17486,"_23867":41165,"_2386":41341},[],"`--http-port`",{"_2859":157,"_25205":91,"_17596":41343,"_5":17486,"_23867":41165,"_2386":41344},[],"`80`",{"_2859":158,"_25205":91,"_17596":41346,"_5":17486,"_23867":41165,"_2386":41347},[],"Gateway HTTP listener port",{"_2859":159,"_25205":91,"_17596":41349,"_5":17486,"_23867":41165,"_2386":41350},[],"`--tls-crt`",{"_2859":160,"_25205":91,"_17596":41352,"_5":17486,"_23867":41165,"_2386":41283},[],{"_2859":161,"_25205":91,"_17596":41354,"_5":17486,"_23867":41165,"_2386":41355},[],"PEM certificate for downstream TLS",{"_2859":162,"_25205":91,"_17596":41357,"_5":17486,"_23867":41165,"_2386":41358},[],"`--tls-key`",{"_2859":163,"_25205":91,"_17596":41360,"_5":17486,"_23867":41165,"_2386":41283},[],{"_2859":164,"_25205":91,"_17596":41362,"_5":17486,"_23867":41165,"_2386":41363},[],"PEM private key for downstream TLS",{"_2859":165,"_25205":91,"_17596":41365,"_5":17486,"_23867":41165,"_2386":41366},[],"`-l`, `--local-chart-path`",{"_2859":166,"_25205":91,"_17596":41368,"_5":17486,"_23867":41165,"_2386":41369},[],"repository chart",{"_2859":167,"_25205":91,"_17596":41371,"_5":17486,"_23867":41165,"_2386":41372},[],"Use an unpacked local Lamassu chart",{"_2859":168,"_25205":91,"_17596":41374,"_5":17486,"_23867":41165,"_2386":41375},[],"`-ip`, `--gateway-ip`",{"_2859":169,"_25205":91,"_17596":41377,"_5":17486,"_23867":41165,"_2386":7258},[],{"_2859":170,"_25205":91,"_17596":41379,"_5":17486,"_23867":41165,"_2386":41380},[],"Override the address written to `gateway.addresses`",{"_2859":171,"_25205":91,"_17596":41382,"_5":17486,"_23867":41165,"_2386":41383},[],"`--otel`",{"_2859":172,"_25205":91,"_17596":41385,"_5":17486,"_23867":41165,"_2386":5353},[],{"_2859":173,"_25205":91,"_17596":41387,"_5":17486,"_23867":41165,"_2386":41388},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_2859":174,"_25205":91,"_17596":41390,"_5":17486,"_23867":41165,"_2386":41391},[],"`--sample-data`",{"_2859":175,"_25205":91,"_17596":41393,"_5":17486,"_23867":41165,"_2386":5353},[],{"_2859":176,"_25205":91,"_17596":41395,"_5":17486,"_23867":41165,"_2386":41396},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_2859":177,"_25205":91,"_17596":41398,"_5":17486,"_23867":41165,"_2386":41399},[],"`--with-hsm`",{"_2859":178,"_25205":91,"_17596":41401,"_5":17486,"_23867":41165,"_2386":5353},[],{"_2859":179,"_25205":91,"_17596":41403,"_5":17486,"_23867":41165,"_2386":41404},[],"Install lab HSM components and configure KMS for PKCS#11",{"_2859":180,"_25205":91,"_17596":41406,"_5":17486,"_23867":41165,"_2386":41407},[],"`--softhsm-chart-path`",{"_2859":181,"_25205":91,"_17596":41409,"_5":17486,"_23867":41165,"_2386":41410},[],"`./charts/softhsm`",{"_2859":182,"_25205":91,"_17596":41412,"_5":17486,"_23867":41165,"_2386":41413},[],"Use a different local SoftHSM chart",{"_2859":183,"_25205":91,"_17596":41415,"_5":17486,"_23867":41165,"_2386":41416},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_2859":184,"_25205":91,"_17596":41418,"_5":17486,"_23867":41169,"_2386":41419},[],"Fastlane:",{"_2859":185,"_25205":91,"_17596":41421,"_5":17486,"_23867":41169,"_2386":41422},[],"validates local tools and the selected cluster",{"_2859":186,"_25205":91,"_17596":41424,"_5":17486,"_23867":41169,"_2386":41425},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_2859":187,"_25205":91,"_17596":41427,"_5":17486,"_23867":41169,"_2386":41428},[],"creates the namespace",{"_2859":188,"_25205":91,"_17596":41430,"_5":17486,"_23867":41169,"_2386":41431},[],"installs PostgreSQL and creates the required databases",{"_2859":189,"_25205":91,"_17596":41433,"_5":17486,"_23867":41169,"_2386":41434},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_2859":190,"_25205":91,"_17596":41436,"_5":17486,"_23867":41169,"_2386":41437},[],"installs RabbitMQ",{"_2859":191,"_25205":91,"_17596":41439,"_5":17486,"_23867":41169,"_2386":41440},[],"optionally installs observability and lab HSM components",{"_2859":192,"_25205":91,"_17596":41442,"_5":17486,"_23867":41169,"_2386":41443},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_2859":193,"_25205":91,"_17596":41445,"_5":17486,"_23867":41169,"_2386":41446},[],"optionally loads sample data",{"_2859":194,"_25205":91,"_17596":41448,"_5":17486,"_23867":41169,"_2386":41449},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_2859":195,"_25205":91,"_17596":41451,"_5":17486,"_23867":41173,"_2386":41452},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_2859":196,"_25205":91,"_17596":41454,"_5":17486,"_23867":41173,"_2386":41455},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_2859":197,"_25205":91,"_17596":41457,"_5":17486,"_23867":41177,"_2386":41458},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use.",{"_2859":198,"_25205":91,"_17596":41460,"_5":17486,"_23867":41177,"_2386":41461},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_2859":199,"_25205":91,"_17596":41463,"_5":17486,"_23867":41177,"_2386":41464},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_2859":200,"_25205":91,"_17596":41466,"_5":17486,"_23867":41181,"_2386":41467},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_2859":201,"_25205":201,"_5":12316,"_2386":41469,"_25540":41470,"_17596":41471,"_23867":201},"Install with Helm",[40894,40895,41001],[],{"_2859":202,"_25205":201,"_17596":41473,"_5":17486,"_23867":201,"_2386":41474},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_2859":203,"_25205":201,"_5":25537,"_17596":41476,"_23867":41477,"_2386":41478},[],"/docs/pr-preview/pr-43/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_2859":204,"_25205":201,"_5":25537,"_17596":41480,"_23867":41481,"_2386":40904},[],"/docs/pr-preview/pr-43/deployment/self-hosted/helm#before-you-begin",{"_2859":205,"_25205":201,"_5":25537,"_17596":41483,"_23867":41484,"_2386":41485},[],"/docs/pr-preview/pr-43/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_2859":206,"_25205":201,"_5":25537,"_17596":41487,"_23867":41488,"_2386":41489},[],"/docs/pr-preview/pr-43/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_2859":207,"_25205":201,"_5":25537,"_17596":41491,"_23867":41492,"_2386":41493},[],"/docs/pr-preview/pr-43/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_2859":208,"_25205":201,"_5":25537,"_17596":41495,"_23867":41496,"_2386":41497},[],"/docs/pr-preview/pr-43/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_2859":209,"_25205":201,"_5":25537,"_17596":41499,"_23867":41500,"_2386":41501},[],"/docs/pr-preview/pr-43/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_2859":210,"_25205":201,"_5":25537,"_17596":41503,"_23867":41504,"_2386":41505},[],"/docs/pr-preview/pr-43/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_2859":211,"_25205":201,"_5":25537,"_17596":41507,"_23867":41508,"_2386":41509},[],"/docs/pr-preview/pr-43/deployment/self-hosted/helm#production-decisions","Production decisions",{"_2859":212,"_25205":201,"_17596":41511,"_5":17486,"_23867":41477,"_2386":41512},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_2859":213,"_25205":201,"_17596":41514,"_5":17486,"_23867":41481,"_2386":41515},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_2859":214,"_25205":201,"_17596":41517,"_5":17486,"_23867":41481,"_2386":41518},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_2859":215,"_25205":201,"_17596":41520,"_5":17486,"_23867":41481,"_2386":41521},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_2859":216,"_25205":201,"_17596":41523,"_5":17486,"_23867":41481,"_2386":41524},[],"a reachable RabbitMQ broker and credentials",{"_2859":217,"_25205":201,"_17596":41526,"_5":17486,"_23867":41481,"_2386":41527},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_2859":218,"_25205":201,"_17596":41529,"_5":17486,"_23867":41481,"_2386":41530},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_2859":219,"_25205":201,"_17596":41532,"_5":17486,"_23867":41481,"_2386":41533},[],"cert-manager 1.14+; for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_2859":220,"_25205":201,"_17596":41535,"_5":17486,"_23867":41481,"_2386":41536},[],"a StorageClass and an external traffic design",{"_2859":221,"_25205":201,"_17596":41538,"_5":17486,"_23867":41481,"_2386":41539},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_2859":222,"_25205":201,"_17596":41541,"_5":17486,"_23867":41481,"_2386":41542},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_2859":223,"_25205":201,"_17596":41544,"_5":17486,"_23867":41481,"_2386":41545},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_2859":224,"_25205":201,"_17596":41547,"_5":17486,"_23867":41484,"_2386":41548},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_2859":225,"_25205":201,"_17596":41550,"_5":17486,"_23867":41484,"_2386":41551},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_2859":226,"_25205":201,"_17596":41553,"_5":17486,"_23867":41484,"_2386":41554},[],"Install cert-manager separately before Lamassu. The current chart renders its self-signed issuer and CA certificate resources even when `tls.type: external` makes the Gateway use an existing TLS Secret. Selecting external TLS therefore does not remove the cert-manager prerequisite.",{"_2859":227,"_25205":201,"_17596":41556,"_5":17486,"_23867":41488,"_2386":41557},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_2859":228,"_25205":201,"_17596":41559,"_5":17486,"_23867":41488,"_2386":41560},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_2859":229,"_25205":201,"_17596":41562,"_5":17486,"_23867":41488,"_2386":41563},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_2859":230,"_25205":201,"_17596":41565,"_5":17486,"_23867":41492,"_2386":41566},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it:",{"_2859":231,"_25205":201,"_17596":41568,"_5":17486,"_23867":41496,"_2386":41569},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_2859":232,"_25205":201,"_17596":41571,"_5":17486,"_23867":41496,"_2386":41572},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_2859":233,"_25205":201,"_17596":41574,"_5":17486,"_23867":41496,"_2386":41575},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_2859":234,"_25205":201,"_17596":41577,"_5":17486,"_23867":41496,"_2386":41578},[],"See Access control for the principal and policy model.",{"_2859":235,"_25205":201,"_17596":41580,"_5":17486,"_23867":41500,"_2386":41581},[],"To install a local checkout instead:",{"_2859":236,"_25205":201,"_17596":41583,"_5":17486,"_23867":41504,"_2386":41584},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_2859":237,"_25205":201,"_17596":41586,"_5":17486,"_23867":41504,"_2386":41587},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_2859":238,"_25205":201,"_17596":41589,"_5":17486,"_23867":41508,"_2386":41590},[],"Before going live, review:",{"_2859":239,"_25205":201,"_17596":41592,"_5":17486,"_23867":41508,"_2386":41593},[],"backup and recovery for PostgreSQL and persistent volumes",{"_2859":240,"_25205":201,"_17596":41595,"_5":17486,"_23867":41508,"_2386":41596},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_2859":241,"_25205":201,"_17596":41598,"_5":17486,"_23867":41508,"_2386":41599},[],"shared VA storage before increasing VA replicas",{"_2859":242,"_25205":201,"_17596":41601,"_5":17486,"_23867":41508,"_2386":41602},[],"managed OIDC roles and removal of evaluation credentials",{"_2859":243,"_25205":201,"_17596":41604,"_5":17486,"_23867":41508,"_2386":41605},[],"a trusted TLS issuer or externally managed certificate",{"_2859":244,"_25205":201,"_17596":41607,"_5":17486,"_23867":41508,"_2386":41608},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_2859":245,"_25205":201,"_17596":41610,"_5":17486,"_23867":41508,"_2386":41611},[],"SMTP, observability and alert delivery",{"_2859":246,"_25205":201,"_17596":41613,"_5":17486,"_23867":41508,"_2386":41614},[],"the migration notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_2859":247,"_25205":201,"_17596":41616,"_5":17486,"_23867":41508,"_2386":41617},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_2859":248,"_25205":248,"_5":12316,"_2386":41619,"_25540":41620,"_17596":41621,"_23867":248},"Expose the Gateway",[40894,40895,41001],[],{"_2859":249,"_25205":248,"_17596":41623,"_5":17486,"_23867":248,"_2386":41624},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_2859":250,"_25205":248,"_5":25537,"_17596":41626,"_23867":41627,"_2386":41628},[],"/docs/pr-preview/pr-43/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_2859":251,"_25205":248,"_5":25537,"_17596":41630,"_23867":41631,"_2386":41632},[],"/docs/pr-preview/pr-43/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_2859":252,"_25205":248,"_5":25537,"_17596":41634,"_23867":41635,"_2386":41636},[],"/docs/pr-preview/pr-43/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_2859":253,"_25205":248,"_5":25537,"_17596":41638,"_23867":41639,"_2386":41640},[],"/docs/pr-preview/pr-43/deployment/self-hosted/networking#k3s","K3s",{"_2859":254,"_25205":248,"_5":25537,"_17596":41642,"_23867":41643,"_2386":41644},[],"/docs/pr-preview/pr-43/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_2859":255,"_25205":248,"_5":25537,"_17596":41646,"_23867":41647,"_2386":41648},[],"/docs/pr-preview/pr-43/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_2859":256,"_25205":248,"_5":25537,"_17596":41650,"_23867":41651,"_2386":41652},[],"/docs/pr-preview/pr-43/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_2859":257,"_25205":248,"_5":25537,"_17596":41654,"_23867":41655,"_2386":41656},[],"/docs/pr-preview/pr-43/deployment/self-hosted/networking#decision-guide","Decision guide",{"_2859":258,"_25205":248,"_5":25537,"_17596":41658,"_23867":41659,"_2386":41660},[],"/docs/pr-preview/pr-43/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_2859":259,"_25205":248,"_17596":41662,"_5":17486,"_23867":41627,"_2386":41663},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_2859":260,"_25205":248,"_17596":41665,"_5":17486,"_23867":41627,"_2386":41666},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_2859":261,"_25205":248,"_17596":41668,"_5":17486,"_23867":41631,"_2386":41669},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_2859":262,"_25205":248,"_17596":41671,"_5":17486,"_23867":41631,"_2386":41672},[],"Set it only when:",{"_2859":263,"_25205":248,"_17596":41674,"_5":17486,"_23867":41631,"_2386":41675},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_2859":264,"_25205":248,"_17596":41677,"_5":17486,"_23867":41631,"_2386":41678},[],"that address is allocated to this Gateway",{"_2859":265,"_25205":248,"_17596":41680,"_5":17486,"_23867":41631,"_2386":41681},[],"the surrounding network already routes traffic for it to the cluster",{"_2859":266,"_25205":248,"_17596":41683,"_5":17486,"_23867":41631,"_2386":41684},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_2859":267,"_25205":248,"_17596":41686,"_5":17486,"_23867":41631,"_2386":41687},[],"Keep these two settings separate:",{"_2859":268,"_25205":248,"_17596":41689,"_5":17486,"_23867":41631,"_2386":41690},[],"`gateway.addresses` requests an address for the Gateway.",{"_2859":269,"_25205":248,"_17596":41692,"_5":17486,"_23867":41631,"_2386":41693},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_2859":270,"_25205":248,"_17596":41695,"_5":17486,"_23867":41631,"_2386":41696},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_2859":271,"_25205":248,"_17596":41698,"_5":17486,"_23867":41635,"_2386":41699},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_2859":272,"_25205":248,"_17596":41701,"_5":17486,"_23867":41635,"_2386":41702},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_2859":273,"_25205":248,"_17596":41704,"_5":17486,"_23867":41639,"_2386":41705},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_2859":274,"_25205":248,"_17596":41707,"_5":17486,"_23867":41639,"_2386":41708},[],"For the recommended design:",{"_2859":275,"_25205":248,"_17596":41710,"_5":17486,"_23867":41639,"_2386":41711},[],"Use only one externally exposed Lamassu Gateway.",{"_2859":276,"_25205":248,"_17596":41713,"_5":17486,"_23867":41639,"_2386":41714},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_2859":277,"_25205":248,"_17596":41716,"_5":17486,"_23867":41639,"_2386":41717},[],"Allow those ports through the VM firewall and any upstream security group.",{"_2859":278,"_25205":248,"_17596":41719,"_5":17486,"_23867":41639,"_2386":41720},[],"Point DNS at the VM's reachable address.",{"_2859":279,"_25205":248,"_17596":41722,"_5":17486,"_23867":41639,"_2386":41723},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_2859":280,"_25205":248,"_17596":41725,"_5":17486,"_23867":41643,"_2386":41726},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_2859":281,"_25205":248,"_17596":41728,"_5":17486,"_23867":41647,"_2386":41729},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_2859":282,"_25205":248,"_17596":41731,"_5":17486,"_23867":41647,"_2386":41732},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_2859":283,"_25205":248,"_17596":41734,"_5":17486,"_23867":41651,"_2386":41735},[],"First decide whether you need three independent data planes or only three hostnames.",{"_2859":284,"_25205":248,"_17596":41737,"_5":17486,"_23867":41651,"_2386":41738},[],"Requirement",{"_2859":285,"_25205":248,"_17596":41740,"_5":17486,"_23867":41651,"_2386":41741},[],"Recommended design",{"_2859":286,"_25205":248,"_17596":41743,"_5":17486,"_23867":41651,"_2386":41744},[],"Consequence",{"_2859":287,"_25205":248,"_17596":41746,"_5":17486,"_23867":41651,"_2386":41747},[],"Several Lamassu URLs or services",{"_2859":288,"_25205":248,"_17596":41749,"_5":17486,"_23867":41651,"_2386":41750},[],"One Gateway with multiple routes",{"_2859":289,"_25205":248,"_17596":41752,"_5":17486,"_23867":41651,"_2386":41753},[],"One IP and one proxy fleet; this is the chart default",{"_2859":290,"_25205":248,"_17596":41755,"_5":17486,"_23867":41651,"_2386":41756},[],"Independent Gateways and separate external IPs",{"_2859":291,"_25205":248,"_17596":41758,"_5":17486,"_23867":41651,"_2386":41759},[],"One VIP per Gateway",{"_2859":292,"_25205":248,"_17596":41761,"_5":17486,"_23867":41651,"_2386":41762},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_2859":293,"_25205":248,"_17596":41764,"_5":17486,"_23867":41651,"_2386":41765},[],"Independent Gateways on one node and one IP",{"_2859":294,"_25205":248,"_17596":41767,"_5":17486,"_23867":41651,"_2386":41768},[],"Use different external ports",{"_2859":295,"_25205":248,"_17596":41770,"_5":17486,"_23867":41651,"_2386":41771},[],"Clients must include non-standard ports",{"_2859":296,"_25205":248,"_17596":41773,"_5":17486,"_23867":41651,"_2386":41774},[],"Separate TLS/mTLS termination behind one IP",{"_2859":297,"_25205":248,"_17596":41776,"_5":17486,"_23867":41651,"_2386":41777},[],"Front-door SNI routing to internal Gateways",{"_2859":298,"_25205":248,"_17596":41779,"_5":17486,"_23867":41651,"_2386":41780},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_2859":299,"_25205":248,"_17596":41782,"_5":17486,"_23867":41651,"_2386":41783},[],"Separate Gateway resources but shared proxy infrastructure",{"_2859":300,"_25205":248,"_17596":41785,"_5":17486,"_23867":41651,"_2386":41786},[],"Envoy merged-Gateway mode",{"_2859":301,"_25205":248,"_17596":41788,"_5":17486,"_23867":41651,"_2386":41789},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_2859":302,"_25205":248,"_17596":41791,"_5":17486,"_23867":41651,"_2386":41792},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_2859":303,"_25205":248,"_17596":41794,"_5":17486,"_23867":41651,"_2386":41795},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_2859":304,"_25205":248,"_17596":41797,"_5":17486,"_23867":41651,"_2386":41798},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_2859":305,"_25205":248,"_17596":41800,"_5":17486,"_23867":41651,"_2386":41801},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_2859":306,"_25205":248,"_17596":41803,"_5":17486,"_23867":41655,"_2386":41804},[],"If one Gateway can own TLS and routing, use the chart default.",{"_2859":307,"_25205":248,"_17596":41806,"_5":17486,"_23867":41655,"_2386":41807},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_2859":308,"_25205":248,"_17596":41809,"_5":17486,"_23867":41655,"_2386":41810},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_2859":309,"_25205":248,"_17596":41812,"_5":17486,"_23867":41655,"_2386":41813},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_2859":310,"_25205":248,"_17596":41815,"_5":17486,"_23867":41655,"_2386":41816},[],"If none of those are possible, use different external ports or change the external network design.",{"_2859":311,"_25205":248,"_17596":41818,"_5":17486,"_23867":41659,"_2386":41819},[],"Check, in order:",{"_2859":312,"_25205":248,"_17596":41821,"_5":17486,"_23867":41659,"_2386":41822},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_2859":313,"_25205":248,"_17596":41824,"_5":17486,"_23867":41659,"_2386":41825},[],"Its status contains the expected address.",{"_2859":314,"_25205":248,"_17596":41827,"_5":17486,"_23867":41659,"_2386":41828},[],"The generated `LoadBalancer` Service has a usable external address.",{"_2859":315,"_25205":248,"_17596":41830,"_5":17486,"_23867":41659,"_2386":41831},[],"Port 443 reaches that address from the client network.",{"_2859":316,"_25205":248,"_17596":41833,"_5":17486,"_23867":41659,"_2386":41834},[],"DNS resolves to the externally reachable endpoint.",{"_2859":317,"_25205":248,"_17596":41836,"_5":17486,"_23867":41659,"_2386":41837},[],"The certificate contains the DNS name or IP used by the client.",{"_2859":318,"_25205":248,"_17596":41839,"_5":17486,"_23867":41659,"_2386":41840},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_2859":319,"_25205":319,"_5":12316,"_2386":41001,"_25540":41842,"_17596":41843,"_23867":319},[40894,40895,41001],[],{"_2859":320,"_25205":319,"_17596":41845,"_5":17486,"_23867":319,"_2386":41846},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_2859":321,"_25205":319,"_5":25537,"_17596":41848,"_23867":41849,"_2386":41850},[],"/docs/pr-preview/pr-43/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_2859":322,"_25205":319,"_5":25537,"_17596":41852,"_23867":41853,"_2386":41854},[],"/docs/pr-preview/pr-43/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_2859":323,"_25205":319,"_5":25537,"_17596":41856,"_23867":41857,"_2386":41858},[],"/docs/pr-preview/pr-43/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_2859":324,"_25205":319,"_5":25537,"_17596":41860,"_23867":41861,"_2386":41862},[],"/docs/pr-preview/pr-43/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_2859":325,"_25205":319,"_5":25537,"_17596":41864,"_23867":41865,"_2386":41866},[],"/docs/pr-preview/pr-43/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_2859":326,"_25205":319,"_5":25537,"_17596":41868,"_23867":41869,"_2386":41870},[],"/docs/pr-preview/pr-43/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_2859":327,"_25205":319,"_17596":41872,"_5":17486,"_23867":41849,"_2386":41873},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_2859":328,"_25205":319,"_17596":41875,"_5":17486,"_23867":41853,"_2386":41876},[],"Workflow",{"_2859":329,"_25205":319,"_17596":41878,"_5":17486,"_23867":41853,"_2386":41879},[],"Use it for",{"_2859":330,"_25205":319,"_17596":41881,"_5":17486,"_23867":41853,"_2386":41882},[],"What it installs",{"_2859":331,"_25205":319,"_17596":41884,"_5":17486,"_23867":41853,"_2386":41885},[],"Helm",{"_2859":332,"_25205":319,"_17596":41887,"_5":17486,"_23867":41853,"_2386":41888},[],"Production and controlled environments",{"_2859":333,"_25205":319,"_17596":41890,"_5":17486,"_23867":41853,"_2386":41891},[],"Lamassu services and Gateway API resources",{"_2859":334,"_25205":319,"_17596":41893,"_5":17486,"_23867":41853,"_2386":41138},[],{"_2859":335,"_25205":319,"_17596":41895,"_5":17486,"_23867":41853,"_2386":41896},[],"Evaluation, demos, CI and small lab clusters",{"_2859":336,"_25205":319,"_17596":41898,"_5":17486,"_23867":41853,"_2386":41899},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_2859":337,"_25205":319,"_17596":41901,"_5":17486,"_23867":41857,"_2386":41902},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_2859":338,"_25205":319,"_17596":41904,"_5":17486,"_23867":41857,"_2386":41905},[],"Area",{"_2859":339,"_25205":319,"_17596":41907,"_5":17486,"_23867":41857,"_2386":41908},[],"The Lamassu chart provides",{"_2859":340,"_25205":319,"_17596":41910,"_5":17486,"_23867":41857,"_2386":41911},[],"You provide",{"_2859":341,"_25205":319,"_17596":41913,"_5":17486,"_23867":41857,"_2386":41914},[],"Lamassu applications",{"_2859":342,"_25205":319,"_17596":41916,"_5":17486,"_23867":41857,"_2386":41917},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_2859":343,"_25205":319,"_17596":41919,"_5":17486,"_23867":41857,"_2386":41920},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_2859":344,"_25205":319,"_17596":41922,"_5":17486,"_23867":41857,"_2386":41923},[],"PostgreSQL data",{"_2859":345,"_25205":319,"_17596":41925,"_5":17486,"_23867":41857,"_2386":41926},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_2859":346,"_25205":319,"_17596":41928,"_5":17486,"_23867":41857,"_2386":41929},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_2859":347,"_25205":319,"_17596":41931,"_5":17486,"_23867":41857,"_2386":41932},[],"Messaging",{"_2859":348,"_25205":319,"_17596":41934,"_5":17486,"_23867":41857,"_2386":41935},[],"RabbitMQ connection configuration for the Lamassu services",{"_2859":349,"_25205":319,"_17596":41937,"_5":17486,"_23867":41857,"_2386":41938},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_2859":350,"_25205":319,"_17596":41940,"_5":17486,"_23867":41857,"_2386":41941},[],"Identity",{"_2859":351,"_25205":319,"_17596":41943,"_5":17486,"_23867":41857,"_2386":41944},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_2859":352,"_25205":319,"_17596":41946,"_5":17486,"_23867":41857,"_2386":41947},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_2859":353,"_25205":319,"_17596":41949,"_5":17486,"_23867":41857,"_2386":41950},[],"External routing",{"_2859":354,"_25205":319,"_17596":41952,"_5":17486,"_23867":41857,"_2386":41953},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_2859":355,"_25205":319,"_17596":41955,"_5":17486,"_23867":41857,"_2386":41956},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_2859":356,"_25205":319,"_17596":41958,"_5":17486,"_23867":41857,"_2386":41959},[],"TLS",{"_2859":357,"_25205":319,"_17596":41961,"_5":17486,"_23867":41857,"_2386":41962},[],"cert-manager `Issuer` and CA `Certificate` resources; either a chart-managed downstream `Certificate` or a reference to your TLS Secret",{"_2859":358,"_25205":319,"_17596":41964,"_5":17486,"_23867":41857,"_2386":41965},[],"cert-manager itself; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_2859":359,"_25205":319,"_17596":41967,"_5":17486,"_23867":41857,"_2386":41968},[],"Persistent application data",{"_2859":360,"_25205":319,"_17596":41970,"_5":17486,"_23867":41857,"_2386":41971},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_2859":361,"_25205":319,"_17596":41973,"_5":17486,"_23867":41857,"_2386":41974},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_2859":362,"_25205":319,"_17596":41976,"_5":17486,"_23867":41857,"_2386":41977},[],"Optional integrations",{"_2859":363,"_25205":319,"_17596":41979,"_5":17486,"_23867":41857,"_2386":41980},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_2859":364,"_25205":319,"_17596":41982,"_5":17486,"_23867":41857,"_2386":41983},[],"The observability backends, cloud credentials and production HSM or external key service",{"_2859":365,"_25205":319,"_17596":41985,"_5":17486,"_23867":41857,"_2386":41986},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_2859":366,"_25205":319,"_17596":41988,"_5":17486,"_23867":41857,"_2386":41989},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_2859":367,"_25205":319,"_17596":41991,"_5":17486,"_23867":41861,"_2386":41992},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_2859":368,"_25205":319,"_17596":41994,"_5":17486,"_23867":41861,"_2386":41995},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_2859":369,"_25205":319,"_17596":41997,"_5":17486,"_23867":41865,"_2386":41998},[],"Kubernetes 1.24 or newer",{"_2859":370,"_25205":319,"_17596":42000,"_5":17486,"_23867":41865,"_2386":42001},[],"Helm 3.2 or newer",{"_2859":371,"_25205":319,"_17596":42003,"_5":17486,"_23867":41865,"_2386":42004},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_2859":372,"_25205":319,"_17596":42006,"_5":17486,"_23867":41865,"_2386":42007},[],"cert-manager 1.14 or newer; the current chart renders cert-manager issuer and certificate resources",{"_2859":373,"_25205":319,"_17596":42009,"_5":17486,"_23867":41865,"_2386":42010},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_2859":374,"_25205":319,"_17596":42012,"_5":17486,"_23867":41865,"_2386":42013},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_2859":375,"_25205":319,"_17596":42015,"_5":17486,"_23867":41865,"_2386":42016},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer.",{"_2859":376,"_25205":319,"_17596":42018,"_5":17486,"_23867":41869,"_2386":42019},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2859":377,"_25205":319,"_17596":42021,"_5":17486,"_23867":41869,"_2386":42022},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2859":378,"_25205":319,"_17596":42024,"_5":17486,"_23867":41869,"_2386":42025},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2859":379,"_25205":379,"_5":12316,"_2386":42027,"_25540":42028,"_17596":42030,"_23867":379},"Deployment troubleshooting",[40894,40895,42029],"Operations",[],{"_2859":380,"_25205":379,"_17596":42032,"_5":17486,"_23867":379,"_2386":42033},[],"Diagnose access, service health and infrastructure dependencies.",{"_2859":381,"_25205":379,"_5":25537,"_17596":42035,"_23867":42036,"_2386":42037},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_2859":382,"_25205":379,"_5":25537,"_17596":42039,"_23867":42040,"_2386":42041},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_2859":383,"_25205":379,"_5":25537,"_17596":42043,"_23867":42044,"_2386":42045},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_2859":384,"_25205":379,"_5":25537,"_17596":42047,"_23867":42048,"_2386":42049},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_2859":385,"_25205":379,"_5":25537,"_17596":42051,"_23867":42052,"_2386":42053},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_2859":386,"_25205":379,"_5":25537,"_17596":42055,"_23867":42056,"_2386":42057},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_2859":387,"_25205":379,"_5":25537,"_17596":42059,"_23867":42060,"_2386":42061},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_2859":388,"_25205":379,"_5":25537,"_17596":42063,"_23867":42064,"_2386":42065},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_2859":389,"_25205":379,"_5":25537,"_17596":42067,"_23867":42068,"_2386":42069},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_2859":390,"_25205":379,"_5":25537,"_17596":42071,"_23867":42072,"_2386":42073},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_2859":391,"_25205":379,"_5":25537,"_17596":42075,"_23867":42076,"_2386":42077},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_2859":392,"_25205":379,"_5":25537,"_17596":42079,"_23867":42080,"_2386":42081},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#observability","Observability",{"_2859":393,"_25205":379,"_17596":42083,"_5":17486,"_23867":379,"_2386":42084},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_2859":394,"_25205":379,"_17596":42086,"_5":17486,"_23867":42040,"_2386":42087},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_2859":395,"_25205":379,"_17596":42089,"_5":17486,"_23867":42044,"_2386":42090},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_2859":396,"_25205":379,"_17596":42092,"_5":17486,"_23867":42048,"_2386":42093},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_2859":397,"_25205":379,"_17596":42095,"_5":17486,"_23867":42052,"_2386":42096},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_2859":398,"_25205":379,"_17596":42098,"_5":17486,"_23867":42056,"_2386":42099},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_2859":399,"_25205":379,"_17596":42101,"_5":17486,"_23867":42060,"_2386":42102},[],"Replace the placeholders with your real release, namespace and deployment.",{"_2859":400,"_25205":379,"_17596":42104,"_5":17486,"_23867":42060,"_2386":42105},[],"Also run the chart's connectivity test:",{"_2859":401,"_25205":379,"_17596":42107,"_5":17486,"_23867":42060,"_2386":42108},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_2859":402,"_25205":379,"_17596":42110,"_5":17486,"_23867":42060,"_2386":42111},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_2859":403,"_25205":379,"_17596":42113,"_5":17486,"_23867":42064,"_2386":42114},[],"If you receive a 401:",{"_2859":404,"_25205":379,"_17596":42116,"_5":17486,"_23867":42064,"_2386":42117},[],"check that the UI's OIDC authority is reachable from the browser;",{"_2859":405,"_25205":379,"_17596":42119,"_5":17486,"_23867":42064,"_2386":42120},[],"verify issuer, audience and expiration of the token;",{"_2859":406,"_25205":379,"_17596":42122,"_5":17486,"_23867":42064,"_2386":42123},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_2859":407,"_25205":379,"_17596":42125,"_5":17486,"_23867":42064,"_2386":42126},[],"check that the provider's public and internal routes point to the same realm.",{"_2859":408,"_25205":379,"_17596":42128,"_5":17486,"_23867":42064,"_2386":42129},[],"If login succeeds but the APIs return 403:",{"_2859":409,"_25205":379,"_17596":42131,"_5":17486,"_23867":42064,"_2386":42132},[],"inspect the token's real claims;",{"_2859":410,"_25205":379,"_17596":42134,"_5":17486,"_23867":42064,"_2386":42135},[],"confirm they match an active principal;",{"_2859":411,"_25205":379,"_17596":42137,"_5":17486,"_23867":42064,"_2386":42138},[],"review the policies granted to that principal;",{"_2859":412,"_25205":379,"_17596":42140,"_5":17486,"_23867":42064,"_2386":42141},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_2859":413,"_25205":379,"_17596":42143,"_5":17486,"_23867":42064,"_2386":42144},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_2859":414,"_25205":379,"_17596":42146,"_5":17486,"_23867":42068,"_2386":42147},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_2859":415,"_25205":379,"_17596":42149,"_5":17486,"_23867":42068,"_2386":42150},[],"Locate the authz pod and Service.",{"_2859":416,"_25205":379,"_17596":42152,"_5":17486,"_23867":42068,"_2386":42153},[],"Check /health, logs and its database connection.",{"_2859":417,"_25205":379,"_17596":42155,"_5":17486,"_23867":42068,"_2386":42156},[],"Verify the DNS and port configured in externalAuthorization.",{"_2859":418,"_25205":379,"_17596":42158,"_5":17486,"_23867":42068,"_2386":42159},[],"Check the check route is /v1/ext\\_authz/check.",{"_2859":419,"_25205":379,"_17596":42161,"_5":17486,"_23867":42068,"_2386":42162},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_2859":420,"_25205":379,"_17596":42164,"_5":17486,"_23867":42072,"_2386":42165},[],"Review kubectl describe pod first. Common causes are:",{"_2859":421,"_25205":379,"_17596":42167,"_5":17486,"_23867":42072,"_2386":42168},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_2859":422,"_25205":379,"_17596":42170,"_5":17486,"_23867":42072,"_2386":42171},[],"unbound persistent volume;",{"_2859":423,"_25205":379,"_17596":42173,"_5":17486,"_23867":42072,"_2386":42174},[],"inaccessible image or incorrect pull policy;",{"_2859":424,"_25205":379,"_17596":42176,"_5":17486,"_23867":42072,"_2386":42177},[],"invalid cryptographic engine configuration;",{"_2859":425,"_25205":379,"_17596":42179,"_5":17486,"_23867":42072,"_2386":42180},[],"CPU or memory limits set too low;",{"_2859":426,"_25205":379,"_17596":42182,"_5":17486,"_23867":42072,"_2386":42183},[],"an incomplete prior migration.",{"_2859":427,"_25205":379,"_17596":42185,"_5":17486,"_23867":42072,"_2386":42186},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_2859":428,"_25205":379,"_17596":42188,"_5":17486,"_23867":42072,"_2386":42189},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_2859":429,"_25205":379,"_17596":42191,"_5":17486,"_23867":42076,"_2386":42192},[],"Domain and audit events depend on the bus publisher:",{"_2859":430,"_25205":379,"_17596":42194,"_5":17486,"_23867":42076,"_2386":42195},[],"verify it is enabled in the emitting service;",{"_2859":431,"_25205":379,"_17596":42197,"_5":17486,"_23867":42076,"_2386":42198},[],"check AMQP connectivity and credentials;",{"_2859":432,"_25205":379,"_17596":42200,"_5":17486,"_23867":42076,"_2386":42201},[],"review exchange, routing key, queues and consumers;",{"_2859":433,"_25205":379,"_17596":42203,"_5":17486,"_23867":42076,"_2386":42204},[],"inspect dead-letter queues;",{"_2859":434,"_25205":379,"_17596":42206,"_5":17486,"_23867":42076,"_2386":42207},[],"alert on orphan durable queues and backlog growth.",{"_2859":435,"_25205":379,"_17596":42209,"_5":17486,"_23867":42076,"_2386":42210},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_2859":436,"_25205":379,"_17596":42212,"_5":17486,"_23867":42080,"_2386":42213},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_2859":437,"_25205":379,"_17596":42215,"_5":17486,"_23867":42080,"_2386":42216},[],"Before closing an incident, record:",{"_2859":438,"_25205":379,"_17596":42218,"_5":17486,"_23867":42080,"_2386":42219},[],"the confirmed cause;",{"_2859":439,"_25205":379,"_17596":42221,"_5":17486,"_23867":42080,"_2386":42222},[],"the time scope and affected resources;",{"_2859":440,"_25205":379,"_17596":42224,"_5":17486,"_23867":42080,"_2386":42225},[],"the commands or queries used;",{"_2859":441,"_25205":379,"_17596":42227,"_5":17486,"_23867":42080,"_2386":42228},[],"the applied change and how to revert it;",{"_2859":442,"_25205":379,"_17596":42230,"_5":17486,"_23867":42080,"_2386":42231},[],"validation from a consumer;",{"_2859":443,"_25205":379,"_17596":42233,"_5":17486,"_23867":42080,"_2386":42234},[],"the preventive action and its owner.",{"_2859":444,"_25205":444,"_5":12316,"_2386":42236,"_25540":42237,"_17596":42240,"_23867":444},"Access control",[40894,42238,42239],"Platform","Administration",[],{"_2859":445,"_25205":444,"_17596":42242,"_5":17486,"_23867":444,"_2386":42243},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_2859":446,"_25205":444,"_5":25537,"_17596":42245,"_23867":42246,"_2386":42247},[],"/docs/pr-preview/pr-43/platform/administration/access-control#essential-concepts","Essential concepts",{"_2859":447,"_25205":444,"_5":25537,"_17596":42249,"_23867":42250,"_2386":42251},[],"/docs/pr-preview/pr-43/platform/administration/access-control#two-decision-systems","Two decision systems",{"_2859":448,"_25205":444,"_5":25537,"_17596":42253,"_23867":42254,"_2386":42255},[],"/docs/pr-preview/pr-43/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_2859":449,"_25205":444,"_5":25537,"_17596":42257,"_23867":42258,"_2386":42259},[],"/docs/pr-preview/pr-43/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_2859":450,"_25205":444,"_5":25537,"_17596":42261,"_23867":42262,"_2386":42263},[],"/docs/pr-preview/pr-43/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_2859":451,"_25205":444,"_5":25537,"_17596":42265,"_23867":42266,"_2386":42267},[],"/docs/pr-preview/pr-43/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_2859":452,"_25205":444,"_5":25537,"_17596":42269,"_23867":42270,"_2386":42271},[],"/docs/pr-preview/pr-43/platform/administration/access-control#oidc-principals","OIDC principals",{"_2859":453,"_25205":444,"_5":25537,"_17596":42273,"_23867":42274,"_2386":42275},[],"/docs/pr-preview/pr-43/platform/administration/access-control#x509-principals","X.509 principals",{"_2859":454,"_25205":444,"_5":25537,"_17596":42277,"_23867":42278,"_2386":42279},[],"/docs/pr-preview/pr-43/platform/administration/access-control#when-several-principals-match","When several principals match",{"_2859":455,"_25205":444,"_5":25537,"_17596":42281,"_23867":42282,"_2386":42283},[],"/docs/pr-preview/pr-43/platform/administration/access-control#how-policies-express-access","How policies express access",{"_2859":456,"_25205":444,"_5":25537,"_17596":42285,"_23867":42286,"_2386":42287},[],"/docs/pr-preview/pr-43/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_2859":457,"_25205":444,"_5":25537,"_17596":42289,"_23867":42290,"_2386":42291},[],"/docs/pr-preview/pr-43/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_2859":458,"_25205":444,"_5":25537,"_17596":42293,"_23867":42294,"_2386":42295},[],"/docs/pr-preview/pr-43/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_2859":459,"_25205":444,"_5":25537,"_17596":42297,"_23867":42298,"_2386":42299},[],"/docs/pr-preview/pr-43/platform/administration/access-control#http-rules","HTTP rules",{"_2859":460,"_25205":444,"_5":25537,"_17596":42301,"_23867":42302,"_2386":42303},[],"/docs/pr-preview/pr-43/platform/administration/access-control#included-policies","Included policies",{"_2859":461,"_25205":444,"_5":25537,"_17596":42305,"_23867":42306,"_2386":41497},[],"/docs/pr-preview/pr-43/platform/administration/access-control#provision-the-first-administrator",{"_2859":462,"_25205":444,"_5":25537,"_17596":42308,"_23867":42309,"_2386":42310},[],"/docs/pr-preview/pr-43/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_2859":463,"_25205":444,"_5":25537,"_17596":42312,"_23867":42313,"_2386":42314},[],"/docs/pr-preview/pr-43/platform/administration/access-control#configure-the-two-jwt-validations","Configure the two JWT validations",{"_2859":464,"_25205":444,"_5":25537,"_17596":42316,"_23867":42317,"_2386":42318},[],"/docs/pr-preview/pr-43/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_2859":465,"_25205":444,"_5":25537,"_17596":42320,"_23867":42321,"_2386":42322},[],"/docs/pr-preview/pr-43/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_2859":466,"_25205":444,"_5":25537,"_17596":42324,"_23867":42325,"_2386":42326},[],"/docs/pr-preview/pr-43/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_2859":467,"_25205":444,"_5":25537,"_17596":42328,"_23867":42329,"_2386":42330},[],"/docs/pr-preview/pr-43/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_2859":468,"_25205":444,"_5":25537,"_17596":42332,"_23867":42333,"_2386":42334},[],"/docs/pr-preview/pr-43/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_2859":469,"_25205":444,"_5":25537,"_17596":42336,"_23867":42337,"_2386":42338},[],"/docs/pr-preview/pr-43/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_2859":470,"_25205":444,"_5":25537,"_17596":42340,"_23867":42341,"_2386":42342},[],"/docs/pr-preview/pr-43/platform/administration/access-control#operational-checklist","Operational checklist",{"_2859":471,"_25205":444,"_5":25537,"_17596":42344,"_23867":42345,"_2386":42346},[],"/docs/pr-preview/pr-43/platform/administration/access-control#diagnostics","Diagnostics",{"_2859":472,"_25205":444,"_5":25537,"_17596":42348,"_23867":42349,"_2386":42350},[],"/docs/pr-preview/pr-43/platform/administration/access-control#the-response-is-401","The response is 401",{"_2859":473,"_25205":444,"_5":25537,"_17596":42352,"_23867":42353,"_2386":42354},[],"/docs/pr-preview/pr-43/platform/administration/access-control#the-response-is-403","The response is 403",{"_2859":474,"_25205":444,"_5":25537,"_17596":42356,"_23867":42357,"_2386":42358},[],"/docs/pr-preview/pr-43/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_2859":475,"_25205":444,"_5":25537,"_17596":42360,"_23867":42361,"_2386":42362},[],"/docs/pr-preview/pr-43/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_2859":476,"_25205":444,"_5":25537,"_17596":42364,"_23867":42365,"_2386":42366},[],"/docs/pr-preview/pr-43/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_2859":477,"_25205":444,"_17596":42368,"_5":17486,"_23867":444,"_2386":42369},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_2859":478,"_25205":444,"_17596":42371,"_5":17486,"_23867":444,"_2386":42372},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_2859":479,"_25205":444,"_17596":42374,"_5":17486,"_23867":444,"_2386":42375},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_2859":480,"_25205":444,"_17596":42377,"_5":17486,"_23867":42246,"_2386":42378},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_2859":481,"_25205":444,"_17596":42380,"_5":17486,"_23867":42246,"_2386":42381},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_2859":482,"_25205":444,"_17596":42383,"_5":17486,"_23867":42246,"_2386":42384},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_2859":483,"_25205":444,"_17596":42386,"_5":17486,"_23867":42246,"_2386":42387},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_2859":484,"_25205":444,"_17596":42389,"_5":17486,"_23867":42246,"_2386":42390},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_2859":485,"_25205":444,"_17596":42392,"_5":17486,"_23867":42246,"_2386":42393},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_2859":486,"_25205":444,"_17596":42395,"_5":17486,"_23867":42250,"_2386":42396},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_2859":487,"_25205":444,"_17596":42398,"_5":17486,"_23867":42250,"_2386":42399},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_2859":488,"_25205":444,"_17596":42401,"_5":17486,"_23867":42254,"_2386":42402},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_2859":489,"_25205":444,"_17596":42404,"_5":17486,"_23867":42254,"_2386":42405},[],"The decision is made **before forwarding the request to the service**:",{"_2859":490,"_25205":444,"_17596":42407,"_5":17486,"_23867":42254,"_2386":42408},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_2859":491,"_25205":444,"_17596":42410,"_5":17486,"_23867":42254,"_2386":42411},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_2859":492,"_25205":444,"_17596":42413,"_5":17486,"_23867":42254,"_2386":42414},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_2859":493,"_25205":444,"_17596":42416,"_5":17486,"_23867":42254,"_2386":42417},[],"It separately loads the policies granted to each principal.",{"_2859":494,"_25205":444,"_17596":42419,"_5":17486,"_23867":42254,"_2386":42420},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_2859":495,"_25205":444,"_17596":42422,"_5":17486,"_23867":42254,"_2386":42423},[],"`authz` looks for an HTTP rule granting that action.",{"_2859":496,"_25205":444,"_17596":42425,"_5":17486,"_23867":42254,"_2386":42426},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_2859":497,"_25205":444,"_17596":42428,"_5":17486,"_23867":42254,"_2386":42429},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_2859":498,"_25205":444,"_17596":42431,"_5":17486,"_23867":42254,"_2386":42432},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_2859":499,"_25205":444,"_17596":42434,"_5":17486,"_23867":42254,"_2386":42435},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_2859":500,"_25205":444,"_17596":42437,"_5":17486,"_23867":42258,"_2386":42438},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_2859":501,"_25205":444,"_17596":42440,"_5":17486,"_23867":42258,"_2386":42441},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_2859":502,"_25205":444,"_17596":42443,"_5":17486,"_23867":42258,"_2386":42444},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_2859":503,"_25205":444,"_17596":42446,"_5":17486,"_23867":42258,"_2386":42447},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_2859":504,"_25205":444,"_17596":42449,"_5":17486,"_23867":42258,"_2386":42450},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_2859":505,"_25205":444,"_17596":42452,"_5":17486,"_23867":42258,"_2386":42453},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_2859":506,"_25205":444,"_17596":42455,"_5":17486,"_23867":42258,"_2386":42456},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_2859":507,"_25205":444,"_17596":42458,"_5":17486,"_23867":42258,"_2386":42459},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_2859":508,"_25205":444,"_17596":42461,"_5":17486,"_23867":42262,"_2386":42462},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_2859":509,"_25205":444,"_17596":42464,"_5":17486,"_23867":42262,"_2386":42465},[],"The decision is made with the domain operation context:",{"_2859":510,"_25205":444,"_17596":42467,"_5":17486,"_23867":42262,"_2386":42468},[],"The middleware extracts the credential and resolves the matching principals.",{"_2859":511,"_25205":444,"_17596":42470,"_5":17486,"_23867":42262,"_2386":42471},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_2859":512,"_25205":444,"_17596":42473,"_5":17486,"_23867":42262,"_2386":42474},[],"`authz` gathers the entity rules of the granted policies.",{"_2859":513,"_25205":444,"_17596":42476,"_5":17486,"_23867":42262,"_2386":42477},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_2859":514,"_25205":444,"_17596":42479,"_5":17486,"_23867":42262,"_2386":42480},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_2859":515,"_25205":444,"_17596":42482,"_5":17486,"_23867":42262,"_2386":42483},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_2859":516,"_25205":444,"_17596":42485,"_5":17486,"_23867":42262,"_2386":42486},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_2859":517,"_25205":444,"_17596":42488,"_5":17486,"_23867":42262,"_2386":42489},[],"Actions fall into two groups:",{"_2859":518,"_25205":444,"_17596":42491,"_5":17486,"_23867":42262,"_2386":42492},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_2859":519,"_25205":444,"_17596":42494,"_5":17486,"_23867":42262,"_2386":42495},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_2859":520,"_25205":444,"_17596":42497,"_5":17486,"_23867":42262,"_2386":42498},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_2859":521,"_25205":444,"_17596":42500,"_5":17486,"_23867":42266,"_2386":42501},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_2859":522,"_25205":444,"_17596":42503,"_5":17486,"_23867":42266,"_2386":42504},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_2859":523,"_25205":444,"_17596":42506,"_5":17486,"_23867":42266,"_2386":42507},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_2859":524,"_25205":444,"_17596":42509,"_5":17486,"_23867":42270,"_2386":42510},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_2859":525,"_25205":444,"_17596":42512,"_5":17486,"_23867":42270,"_2386":42513},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_2859":526,"_25205":444,"_17596":42515,"_5":17486,"_23867":42270,"_2386":42516},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_2859":527,"_25205":444,"_17596":42518,"_5":17486,"_23867":42270,"_2386":42519},[],"The implemented operators are:",{"_2859":528,"_25205":444,"_17596":42521,"_5":17486,"_23867":42270,"_2386":42522},[],"`equals`, for exact equality;",{"_2859":529,"_25205":444,"_17596":42524,"_5":17486,"_23867":42270,"_2386":42525},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_2859":530,"_25205":444,"_17596":42527,"_5":17486,"_23867":42270,"_2386":42528},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_2859":531,"_25205":444,"_17596":42530,"_5":17486,"_23867":42270,"_2386":42531},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_2859":532,"_25205":444,"_17596":42533,"_5":17486,"_23867":42274,"_2386":42534},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_2859":533,"_25205":444,"_17596":42536,"_5":17486,"_23867":42274,"_2386":42537},[],"The available modes are:",{"_2859":534,"_25205":444,"_17596":42539,"_5":17486,"_23867":42274,"_2386":42540},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_2859":535,"_25205":444,"_17596":42542,"_5":17486,"_23867":42274,"_2386":42543},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_2859":536,"_25205":444,"_17596":42545,"_5":17486,"_23867":42274,"_2386":42546},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_2859":537,"_25205":444,"_17596":42548,"_5":17486,"_23867":42274,"_2386":42549},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_2859":538,"_25205":444,"_17596":42551,"_5":17486,"_23867":42274,"_2386":42552},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_2859":539,"_25205":444,"_17596":42554,"_5":17486,"_23867":42274,"_2386":42555},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_2859":540,"_25205":444,"_17596":42557,"_5":17486,"_23867":42278,"_2386":42558},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_2859":541,"_25205":444,"_17596":42560,"_5":17486,"_23867":42278,"_2386":42561},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_2859":542,"_25205":444,"_17596":42563,"_5":17486,"_23867":42278,"_2386":42564},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_2859":543,"_25205":444,"_17596":42566,"_5":17486,"_23867":42278,"_2386":42567},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_2859":544,"_25205":444,"_17596":42569,"_5":17486,"_23867":42286,"_2386":42570},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_2859":545,"_25205":444,"_17596":42572,"_5":17486,"_23867":42286,"_2386":42573},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_2859":546,"_25205":444,"_17596":42575,"_5":17486,"_23867":42290,"_2386":42576},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_2859":547,"_25205":444,"_17596":42578,"_5":17486,"_23867":42290,"_2386":42579},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_2859":548,"_25205":444,"_17596":42581,"_5":17486,"_23867":42294,"_2386":42582},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_2859":549,"_25205":444,"_17596":42584,"_5":17486,"_23867":42294,"_2386":42585},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_2859":550,"_25205":444,"_17596":42587,"_5":17486,"_23867":42294,"_2386":42588},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_2859":551,"_25205":444,"_17596":42590,"_5":17486,"_23867":42298,"_2386":42591},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_2859":552,"_25205":444,"_17596":42593,"_5":17486,"_23867":42298,"_2386":42594},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_2859":553,"_25205":444,"_17596":42596,"_5":17486,"_23867":42298,"_2386":42597},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_2859":554,"_25205":444,"_17596":42599,"_5":17486,"_23867":42298,"_2386":42600},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_2859":555,"_25205":444,"_17596":42602,"_5":17486,"_23867":42298,"_2386":42603},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_2859":556,"_25205":444,"_17596":42605,"_5":17486,"_23867":42298,"_2386":42606},[],"Note that:",{"_2859":557,"_25205":444,"_17596":42608,"_5":17486,"_23867":42298,"_2386":42609},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_2859":558,"_25205":444,"_17596":42611,"_5":17486,"_23867":42298,"_2386":42612},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_2859":559,"_25205":444,"_17596":42614,"_5":17486,"_23867":42298,"_2386":42615},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_2859":560,"_25205":444,"_17596":42617,"_5":17486,"_23867":42302,"_2386":42618},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_2859":561,"_25205":444,"_17596":42620,"_5":17486,"_23867":42302,"_2386":42621},[],"full and read-only access to certificates and authorities;",{"_2859":562,"_25205":444,"_17596":42623,"_5":17486,"_23867":42302,"_2386":42624},[],"full and read-only access to the KMS;",{"_2859":563,"_25205":444,"_17596":42626,"_5":17486,"_23867":42302,"_2386":42627},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_2859":564,"_25205":444,"_17596":42629,"_5":17486,"_23867":42302,"_2386":42630},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_2859":565,"_25205":444,"_17596":42632,"_5":17486,"_23867":42302,"_2386":42633},[],"console access;",{"_2859":566,"_25205":444,"_17596":42635,"_5":17486,"_23867":42302,"_2386":42636},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_2859":567,"_25205":444,"_17596":42638,"_5":17486,"_23867":42302,"_2386":42639},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_2859":568,"_25205":444,"_17596":42641,"_5":17486,"_23867":42302,"_2386":42642},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_2859":569,"_25205":444,"_17596":42644,"_5":17486,"_23867":42306,"_2386":42645},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_2859":570,"_25205":444,"_17596":42647,"_5":17486,"_23867":42306,"_2386":42648},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_2859":571,"_25205":444,"_17596":42650,"_5":17486,"_23867":42306,"_2386":42651},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_2859":572,"_25205":444,"_17596":42653,"_5":17486,"_23867":42309,"_2386":42654},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_2859":573,"_25205":444,"_17596":42656,"_5":17486,"_23867":42313,"_2386":42657},[],"The Gateway uses `auth.authentication.apiGateway.jwks` to authenticate requests. `authz` uses `services.authz.jwkUrl` to resolve OIDC principals. Both endpoints must contain the keys of the same issuer and be reachable from their respective components.",{"_2859":574,"_25205":444,"_17596":42659,"_5":17486,"_23867":42317,"_2386":42660},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_2859":575,"_25205":444,"_17596":42662,"_5":17486,"_23867":42321,"_2386":42663},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_2859":576,"_25205":444,"_17596":42665,"_5":17486,"_23867":42325,"_2386":42666},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_2859":577,"_25205":444,"_17596":42668,"_5":17486,"_23867":42329,"_2386":42669},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_2859":578,"_25205":444,"_17596":42671,"_5":17486,"_23867":42329,"_2386":42672},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_2859":579,"_25205":444,"_17596":42674,"_5":17486,"_23867":42333,"_2386":42675},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_2859":580,"_25205":444,"_17596":42677,"_5":17486,"_23867":42333,"_2386":42678},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_2859":581,"_25205":444,"_17596":42680,"_5":17486,"_23867":42333,"_2386":42681},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_2859":582,"_25205":444,"_17596":42683,"_5":17486,"_23867":42333,"_2386":42684},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_2859":583,"_25205":444,"_17596":42686,"_5":17486,"_23867":42333,"_2386":42687},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_2859":584,"_25205":444,"_17596":42689,"_5":17486,"_23867":42333,"_2386":42690},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_2859":585,"_25205":444,"_17596":42692,"_5":17486,"_23867":42333,"_2386":42693},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_2859":586,"_25205":444,"_17596":42695,"_5":17486,"_23867":42333,"_2386":42696},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_2859":587,"_25205":444,"_17596":42698,"_5":17486,"_23867":42337,"_2386":42699},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_2859":588,"_25205":444,"_17596":42701,"_5":17486,"_23867":42337,"_2386":42702},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_2859":589,"_25205":444,"_17596":42704,"_5":17486,"_23867":42337,"_2386":42705},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_2859":590,"_25205":444,"_17596":42707,"_5":17486,"_23867":42341,"_2386":42708},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_2859":591,"_25205":444,"_17596":42710,"_5":17486,"_23867":42341,"_2386":42711},[],"Use groups or stable roles for people and independent identities for automations.",{"_2859":592,"_25205":444,"_17596":42713,"_5":17486,"_23867":42341,"_2386":42714},[],"Keep at least two recovery administrators and test their access periodically.",{"_2859":593,"_25205":444,"_17596":42716,"_5":17486,"_23867":42341,"_2386":42717},[],"Review active principals, their matches and their grants after IdP changes.",{"_2859":594,"_25205":444,"_17596":42719,"_5":17486,"_23867":42341,"_2386":42720},[],"Search for wildcards in policies before upgrading Lamassu.",{"_2859":595,"_25205":444,"_17596":42722,"_5":17486,"_23867":42341,"_2386":42723},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_2859":596,"_25205":444,"_17596":42725,"_5":17486,"_23867":42341,"_2386":42726},[],"Always test one allowed and one denied operation for each role.",{"_2859":597,"_25205":444,"_17596":42728,"_5":17486,"_23867":42341,"_2386":42729},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_2859":598,"_25205":444,"_17596":42731,"_5":17486,"_23867":42349,"_2386":42732},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_2859":599,"_25205":444,"_17596":42734,"_5":17486,"_23867":42353,"_2386":42735},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_2859":600,"_25205":444,"_17596":42737,"_5":17486,"_23867":42353,"_2386":42738},[],"that an active principal of the correct type exists;",{"_2859":601,"_25205":444,"_17596":42740,"_5":17486,"_23867":42353,"_2386":42741},[],"that the claim paths and values match the real token exactly;",{"_2859":602,"_25205":444,"_17596":42743,"_5":17486,"_23867":42353,"_2386":42744},[],"that all of the principal's conditions hold;",{"_2859":603,"_25205":444,"_17596":42746,"_5":17486,"_23867":42353,"_2386":42747},[],"that the principal has the expected policy granted;",{"_2859":604,"_25205":444,"_17596":42749,"_5":17486,"_23867":42353,"_2386":42750},[],"that the policy includes the action and the requested resource type or route;",{"_2859":605,"_25205":444,"_17596":42752,"_5":17486,"_23867":42353,"_2386":42753},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_2859":606,"_25205":444,"_17596":42755,"_5":17486,"_23867":42353,"_2386":42756},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_2859":607,"_25205":444,"_17596":42758,"_5":17486,"_23867":42357,"_2386":42759},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_2859":608,"_25205":444,"_17596":42761,"_5":17486,"_23867":42361,"_2386":42762},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_2859":609,"_25205":444,"_17596":42764,"_5":17486,"_23867":42365,"_2386":42765},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_2859":610,"_25205":444,"_17596":42767,"_5":17486,"_23867":42365,"_2386":42768},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_2859":611,"_25205":611,"_5":12316,"_2386":42770,"_25540":42771,"_17596":42772,"_23867":611},"Alerts and subscriptions",[40894,42238,42239],[],{"_2859":612,"_25205":611,"_17596":42774,"_5":17486,"_23867":611,"_2386":42775},[],"Send PKI events to people and external systems.",{"_2859":613,"_25205":611,"_5":25537,"_17596":42777,"_23867":42778,"_2386":42779},[],"/docs/pr-preview/pr-43/platform/administration/alerts#how-it-works","How it works",{"_2859":614,"_25205":611,"_5":25537,"_17596":42781,"_23867":42782,"_2386":42783},[],"/docs/pr-preview/pr-43/platform/administration/alerts#available-channels","Available channels",{"_2859":615,"_25205":611,"_5":25537,"_17596":42785,"_23867":42786,"_2386":42787},[],"/docs/pr-preview/pr-43/platform/administration/alerts#create-a-subscription","Create a subscription",{"_2859":616,"_25205":611,"_5":25537,"_17596":42789,"_23867":42790,"_2386":42791},[],"/docs/pr-preview/pr-43/platform/administration/alerts#choose-the-event","Choose the event",{"_2859":617,"_25205":611,"_5":25537,"_17596":42793,"_23867":42794,"_2386":42795},[],"/docs/pr-preview/pr-43/platform/administration/alerts#configure-the-destination","Configure the destination",{"_2859":618,"_25205":611,"_5":25537,"_17596":42797,"_23867":42798,"_2386":42799},[],"/docs/pr-preview/pr-43/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_2859":619,"_25205":611,"_5":25537,"_17596":42801,"_23867":42802,"_2386":42803},[],"/docs/pr-preview/pr-43/platform/administration/alerts#review-and-activate","Review and activate",{"_2859":620,"_25205":611,"_5":25537,"_17596":42805,"_23867":42806,"_2386":42807},[],"/docs/pr-preview/pr-43/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_2859":621,"_25205":611,"_5":25537,"_17596":42809,"_23867":42810,"_2386":42811},[],"/docs/pr-preview/pr-43/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_2859":622,"_25205":611,"_5":25537,"_17596":42813,"_23867":42814,"_2386":42815},[],"/docs/pr-preview/pr-43/platform/administration/alerts#event-families","Event families",{"_2859":623,"_25205":611,"_17596":42817,"_5":17486,"_23867":611,"_2386":42818},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_2859":624,"_25205":611,"_17596":42820,"_5":17486,"_23867":42778,"_2386":42821},[],"A service publishes a domain event.",{"_2859":625,"_25205":611,"_17596":42823,"_5":17486,"_23867":42778,"_2386":42824},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_2859":626,"_25205":611,"_17596":42826,"_5":17486,"_23867":42778,"_2386":42827},[],"Each subscription's filter decides whether it should be notified.",{"_2859":627,"_25205":611,"_17596":42829,"_5":17486,"_23867":42778,"_2386":42830},[],"Lamassu delivers the event to the configured channel.",{"_2859":628,"_25205":611,"_17596":42832,"_5":17486,"_23867":42778,"_2386":42833},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_2859":629,"_25205":611,"_17596":42835,"_5":17486,"_23867":42782,"_2386":42836},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_2859":630,"_25205":611,"_17596":42838,"_5":17486,"_23867":42782,"_2386":42839},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_2859":631,"_25205":611,"_17596":42841,"_5":17486,"_23867":42782,"_2386":42842},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_2859":632,"_25205":611,"_17596":42844,"_5":17486,"_23867":42782,"_2386":42845},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_2859":633,"_25205":611,"_17596":42847,"_5":17486,"_23867":42782,"_2386":42848},[],"`apikey_options` requires `header` and `key`.",{"_2859":634,"_25205":611,"_17596":42850,"_5":17486,"_23867":42782,"_2386":42851},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_2859":635,"_25205":611,"_17596":42853,"_5":17486,"_23867":42782,"_2386":42854},[],"`mtls_options` requires the inline PEM `cert_content` and `key_content`; values that reference files on the server are rejected.",{"_2859":636,"_25205":611,"_17596":42856,"_5":17486,"_23867":42782,"_2386":42857},[],"The alerts API reference documents the full `http_client` schema.",{"_2859":637,"_25205":611,"_17596":42859,"_5":17486,"_23867":42790,"_2386":42860},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_2859":638,"_25205":611,"_17596":42862,"_5":17486,"_23867":42794,"_2386":42863},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_2859":639,"_25205":611,"_17596":42865,"_5":17486,"_23867":42798,"_2386":42866},[],"Add a filter if you don't want to receive every instance of the event.",{"_2859":640,"_25205":611,"_17596":42868,"_5":17486,"_23867":42798,"_2386":42869},[],"**None** notifies all instances of the event.",{"_2859":641,"_25205":611,"_17596":42871,"_5":17486,"_23867":42798,"_2386":42872},[],"**JSON Path** evaluates one or more specific fields.",{"_2859":642,"_25205":611,"_17596":42874,"_5":17486,"_23867":42798,"_2386":42875},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_2859":643,"_25205":611,"_17596":42877,"_5":17486,"_23867":42798,"_2386":42878},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_2859":644,"_25205":611,"_17596":42880,"_5":17486,"_23867":42798,"_2386":42881},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_2859":645,"_25205":611,"_17596":42883,"_5":17486,"_23867":42802,"_2386":42884},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_2859":646,"_25205":611,"_17596":42886,"_5":17486,"_23867":42806,"_2386":42887},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_2859":647,"_25205":611,"_17596":42889,"_5":17486,"_23867":42806,"_2386":42890},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_2859":648,"_25205":611,"_17596":42892,"_5":17486,"_23867":42806,"_2386":42893},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_2859":649,"_25205":611,"_17596":42895,"_5":17486,"_23867":42806,"_2386":42896},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_2859":650,"_25205":611,"_17596":42898,"_5":17486,"_23867":42806,"_2386":42899},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_2859":651,"_25205":611,"_17596":42901,"_5":17486,"_23867":42806,"_2386":42902},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_2859":652,"_25205":611,"_17596":42904,"_5":17486,"_23867":42806,"_2386":42905},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_2859":653,"_25205":611,"_17596":42907,"_5":17486,"_23867":42806,"_2386":42908},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_2859":654,"_25205":611,"_17596":42910,"_5":17486,"_23867":42810,"_2386":42911},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_2859":655,"_25205":611,"_17596":42913,"_5":17486,"_23867":42814,"_2386":42914},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_2859":656,"_25205":611,"_17596":42916,"_5":17486,"_23867":42814,"_2386":42917},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_2859":657,"_25205":611,"_17596":42919,"_5":17486,"_23867":42814,"_2386":42920},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_2859":658,"_25205":611,"_17596":42922,"_5":17486,"_23867":42814,"_2386":42923},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_2859":659,"_25205":611,"_17596":42925,"_5":17486,"_23867":42814,"_2386":42926},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_2859":660,"_25205":611,"_17596":42928,"_5":17486,"_23867":42814,"_2386":42929},[],"**Validation:** `va.role.crl.create`.",{"_2859":661,"_25205":611,"_17596":42931,"_5":17486,"_23867":42814,"_2386":42932},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_2859":662,"_25205":611,"_17596":42934,"_5":17486,"_23867":42814,"_2386":42935},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_2859":663,"_25205":663,"_5":12316,"_2386":42937,"_25540":42938,"_17596":42939,"_23867":663},"Audit logs",[40894,42238,42239],[],{"_2859":664,"_25205":663,"_17596":42941,"_5":17486,"_23867":663,"_2386":42942},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_2859":665,"_25205":663,"_5":25537,"_17596":42944,"_23867":42945,"_2386":42946},[],"/docs/pr-preview/pr-43/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_2859":666,"_25205":663,"_5":25537,"_17596":42948,"_23867":42949,"_2386":42950},[],"/docs/pr-preview/pr-43/platform/administration/audit-logs#coverage","Coverage",{"_2859":667,"_25205":663,"_5":25537,"_17596":42952,"_23867":42953,"_2386":42954},[],"/docs/pr-preview/pr-43/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_2859":668,"_25205":663,"_5":25537,"_17596":42956,"_23867":42957,"_2386":42958},[],"/docs/pr-preview/pr-43/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_2859":669,"_25205":663,"_5":25537,"_17596":42960,"_23867":42961,"_2386":42962},[],"/docs/pr-preview/pr-43/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_2859":670,"_25205":663,"_5":25537,"_17596":42964,"_23867":42965,"_2386":42966},[],"/docs/pr-preview/pr-43/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_2859":671,"_25205":663,"_5":25537,"_17596":42968,"_23867":42969,"_2386":42970},[],"/docs/pr-preview/pr-43/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_2859":672,"_25205":663,"_5":25537,"_17596":42972,"_23867":42973,"_2386":42974},[],"/docs/pr-preview/pr-43/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_2859":673,"_25205":663,"_5":25537,"_17596":42976,"_23867":42977,"_2386":42978},[],"/docs/pr-preview/pr-43/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_2859":674,"_25205":663,"_5":25537,"_17596":42980,"_23867":42981,"_2386":42982},[],"/docs/pr-preview/pr-43/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_2859":675,"_25205":663,"_5":25537,"_17596":42984,"_23867":42985,"_2386":42986},[],"/docs/pr-preview/pr-43/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_2859":676,"_25205":663,"_17596":42988,"_5":17486,"_23867":663,"_2386":42989},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_2859":677,"_25205":663,"_17596":42991,"_5":17486,"_23867":42945,"_2386":42992},[],"The audit body includes:",{"_2859":678,"_25205":663,"_17596":42994,"_5":17486,"_23867":42945,"_2386":42995},[],"input: data received by the operation;",{"_2859":679,"_25205":663,"_17596":42997,"_5":17486,"_23867":42945,"_2386":42998},[],"has\\_error: whether the service returned an error;",{"_2859":680,"_25205":663,"_17596":43000,"_5":17486,"_23867":42945,"_2386":43001},[],"output: produced result or error message;",{"_2859":681,"_25205":663,"_17596":43003,"_5":17486,"_23867":42945,"_2386":43004},[],"principals: identifiers of the principals that matched the request.",{"_2859":682,"_25205":663,"_17596":43006,"_5":17486,"_23867":42945,"_2386":43007},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_2859":683,"_25205":663,"_17596":43009,"_5":17486,"_23867":42945,"_2386":43010},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_2859":684,"_25205":663,"_17596":43012,"_5":17486,"_23867":42949,"_2386":43013},[],"The backend applies auditing to mutations of:",{"_2859":685,"_25205":663,"_17596":43015,"_5":17486,"_23867":42949,"_2386":43016},[],"authorities, certificates and issuance profiles;",{"_2859":686,"_25205":663,"_17596":43018,"_5":17486,"_23867":42949,"_2386":43019},[],"keys and KMS engines;",{"_2859":687,"_25205":663,"_17596":43021,"_5":17486,"_23867":42949,"_2386":43022},[],"devices and identities;",{"_2859":688,"_25205":663,"_17596":43024,"_5":17486,"_23867":42949,"_2386":43025},[],"DMSs and enrollment operations;",{"_2859":689,"_25205":663,"_17596":43027,"_5":17486,"_23867":42949,"_2386":43028},[],"validation functions and CRL;",{"_2859":690,"_25205":663,"_17596":43030,"_5":17486,"_23867":42949,"_2386":43031},[],"principals, policies and authorization grants.",{"_2859":691,"_25205":663,"_17596":43033,"_5":17486,"_23867":42949,"_2386":43034},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_2859":692,"_25205":663,"_17596":43036,"_5":17486,"_23867":42953,"_2386":43037},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_2859":693,"_25205":663,"_17596":43039,"_5":17486,"_23867":42953,"_2386":43040},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_2859":694,"_25205":663,"_17596":43042,"_5":17486,"_23867":42953,"_2386":43043},[],"Design the consumer to:",{"_2859":695,"_25205":663,"_17596":43045,"_5":17486,"_23867":42953,"_2386":43046},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_2859":696,"_25205":663,"_17596":43048,"_5":17486,"_23867":42953,"_2386":43049},[],"keep the complete CloudEvent unmodified;",{"_2859":697,"_25205":663,"_17596":43051,"_5":17486,"_23867":42953,"_2386":43052},[],"record the ingestion time and detect duplicates by ID;",{"_2859":698,"_25205":663,"_17596":43054,"_5":17486,"_23867":42953,"_2386":43055},[],"encrypt in transit and at rest;",{"_2859":699,"_25205":663,"_17596":43057,"_5":17486,"_23867":42953,"_2386":43058},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_2859":700,"_25205":663,"_17596":43060,"_5":17486,"_23867":42953,"_2386":43061},[],"apply an explicit retention and legal hold policy;",{"_2859":701,"_25205":663,"_17596":43063,"_5":17486,"_23867":42953,"_2386":43064},[],"alert if it stops consuming or the pending queue grows.",{"_2859":702,"_25205":663,"_17596":43066,"_5":17486,"_23867":42957,"_2386":43067},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_2859":703,"_25205":663,"_17596":43069,"_5":17486,"_23867":42957,"_2386":43070},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_2859":704,"_25205":663,"_17596":43072,"_5":17486,"_23867":42965,"_2386":43073},[],"Start from the reported time and normalize every source to UTC.",{"_2859":705,"_25205":663,"_17596":43075,"_5":17486,"_23867":42969,"_2386":43076},[],"Filter by event type, service source and resource identifier.",{"_2859":706,"_25205":663,"_17596":43078,"_5":17486,"_23867":42973,"_2386":43079},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_2859":707,"_25205":663,"_17596":43081,"_5":17486,"_23867":42977,"_2386":43082},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_2859":708,"_25205":663,"_17596":43084,"_5":17486,"_23867":42981,"_2386":43085},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_2859":709,"_25205":663,"_17596":43087,"_5":17486,"_23867":42985,"_2386":43088},[],"Generate a controlled mutation in a test environment and check that:",{"_2859":710,"_25205":663,"_17596":43090,"_5":17486,"_23867":42985,"_2386":43091},[],"a successful audit event appears;",{"_2859":711,"_25205":663,"_17596":43093,"_5":17486,"_23867":42985,"_2386":43094},[],"the principal matches the identity used;",{"_2859":712,"_25205":663,"_17596":43096,"_5":17486,"_23867":42985,"_2386":43097},[],"the consumer persists it exactly once;",{"_2859":713,"_25205":663,"_17596":43099,"_5":17486,"_23867":42985,"_2386":43100},[],"it can be retrieved by resource, actor and period;",{"_2859":714,"_25205":663,"_17596":43102,"_5":17486,"_23867":42985,"_2386":43103},[],"a consumer outage raises an alert.",{"_2859":715,"_25205":663,"_17596":43105,"_5":17486,"_23867":42985,"_2386":43106},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_2859":716,"_25205":716,"_5":12316,"_2386":43108,"_25540":43109,"_17596":43110,"_23867":716},"Platform architecture",[40894,42238],[],{"_2859":717,"_25205":716,"_17596":43112,"_5":17486,"_23867":716,"_2386":43113},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_2859":718,"_25205":716,"_5":25537,"_17596":43115,"_23867":43116,"_2386":43117},[],"/docs/pr-preview/pr-43/platform/concepts/architecture#control-plane","Control plane",{"_2859":719,"_25205":716,"_5":25537,"_17596":43119,"_23867":43120,"_2386":43121},[],"/docs/pr-preview/pr-43/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_2859":720,"_25205":716,"_5":25537,"_17596":43123,"_23867":43124,"_2386":43125},[],"/docs/pr-preview/pr-43/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_2859":721,"_25205":716,"_5":25537,"_17596":43127,"_23867":43128,"_2386":43129},[],"/docs/pr-preview/pr-43/platform/concepts/architecture#status-and-validation","Status and validation",{"_2859":722,"_25205":716,"_5":25537,"_17596":43131,"_23867":43132,"_2386":43133},[],"/docs/pr-preview/pr-43/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_2859":723,"_25205":716,"_17596":43135,"_5":17486,"_23867":716,"_2386":43136},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_2859":724,"_25205":716,"_17596":43138,"_5":17486,"_23867":716,"_2386":43139},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_2859":725,"_25205":716,"_17596":43141,"_5":17486,"_23867":43116,"_2386":43142},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_2859":726,"_25205":716,"_17596":43144,"_5":17486,"_23867":43120,"_2386":43145},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_2859":727,"_25205":716,"_17596":43147,"_5":17486,"_23867":43124,"_2386":43148},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_2859":728,"_25205":716,"_17596":43150,"_5":17486,"_23867":43128,"_2386":43151},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_2859":729,"_25205":716,"_17596":43153,"_5":17486,"_23867":43132,"_2386":43154},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_2859":730,"_25205":730,"_5":12316,"_2386":43156,"_25540":43157,"_17596":43158,"_23867":730},"How Lamassu works",[40894,42238],[],{"_2859":731,"_25205":730,"_17596":43160,"_5":17486,"_23867":730,"_2386":43161},[],"The mental model of trust, keys, certificates and devices.",{"_2859":732,"_25205":730,"_5":25537,"_17596":43163,"_23867":43164,"_2386":43165},[],"/docs/pr-preview/pr-43/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_2859":733,"_25205":730,"_5":25537,"_17596":43167,"_23867":43168,"_2386":43169},[],"/docs/pr-preview/pr-43/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_2859":734,"_25205":730,"_17596":43171,"_5":17486,"_23867":730,"_2386":43172},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_2859":735,"_25205":730,"_17596":43174,"_5":17486,"_23867":43164,"_2386":43175},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_2859":736,"_25205":730,"_17596":43177,"_5":17486,"_23867":43164,"_2386":43178},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_2859":737,"_25205":730,"_17596":43180,"_5":17486,"_23867":43164,"_2386":43181},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_2859":738,"_25205":730,"_17596":43183,"_5":17486,"_23867":43164,"_2386":43184},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_2859":739,"_25205":730,"_17596":43186,"_5":17486,"_23867":43164,"_2386":43187},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_2859":740,"_25205":730,"_17596":43189,"_5":17486,"_23867":43168,"_2386":43190},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_2859":741,"_25205":730,"_17596":43192,"_5":17486,"_23867":43168,"_2386":43193},[],"A DMS relates that CA to an enrollment policy.",{"_2859":742,"_25205":730,"_17596":43195,"_5":17486,"_23867":43168,"_2386":43196},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_2859":743,"_25205":730,"_17596":43198,"_5":17486,"_23867":43168,"_2386":43199},[],"Lamassu keeps the inventory, history and status of the identity.",{"_2859":744,"_25205":730,"_17596":43201,"_5":17486,"_23867":43168,"_2386":43202},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_2859":745,"_25205":730,"_17596":43204,"_5":17486,"_23867":43168,"_2386":43205},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_2859":746,"_25205":730,"_17596":43207,"_5":17486,"_23867":43168,"_2386":43208},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2859":747,"_25205":747,"_5":12316,"_2386":43210,"_25540":43211,"_17596":43213,"_23867":747},"Devices and identities",[40894,42238,43212,43210],"IoT Fleets",[],{"_2859":748,"_25205":747,"_17596":43215,"_5":17486,"_23867":747,"_2386":43216},[],"Register, inspect and retire devices while checking their current identity and history.",{"_2859":749,"_25205":747,"_5":25537,"_17596":43218,"_23867":43219,"_2386":43220},[],"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#device-states","Device states",{"_2859":750,"_25205":747,"_5":25537,"_17596":43222,"_23867":43223,"_2386":43224},[],"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_2859":751,"_25205":747,"_5":25537,"_17596":43226,"_23867":43227,"_2386":43228},[],"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_2859":752,"_25205":747,"_5":25537,"_17596":43230,"_23867":43231,"_2386":43232},[],"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#create-the-device","Create the device",{"_2859":753,"_25205":747,"_5":25537,"_17596":43234,"_23867":43235,"_2386":43236},[],"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_2859":754,"_25205":747,"_5":25537,"_17596":43238,"_23867":43239,"_2386":43240},[],"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_2859":755,"_25205":747,"_5":25537,"_17596":43242,"_23867":43243,"_2386":43244},[],"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_2859":756,"_25205":747,"_5":25537,"_17596":43246,"_23867":43247,"_2386":43248},[],"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_2859":757,"_25205":747,"_5":25537,"_17596":43250,"_23867":43251,"_2386":43252},[],"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_2859":758,"_25205":747,"_5":25537,"_17596":43254,"_23867":43255,"_2386":43256},[],"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_2859":759,"_25205":747,"_5":25537,"_17596":43258,"_23867":43259,"_2386":43260},[],"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_2859":760,"_25205":747,"_17596":43262,"_5":17486,"_23867":747,"_2386":43263},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_2859":761,"_25205":747,"_17596":43265,"_5":17486,"_23867":747,"_2386":43266},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_2859":762,"_25205":747,"_17596":43268,"_5":17486,"_23867":43219,"_2386":43269},[],"Operational view",{"_2859":763,"_25205":747,"_17596":43271,"_5":17486,"_23867":43219,"_2386":43272},[],"Meaning",{"_2859":764,"_25205":747,"_17596":43274,"_5":17486,"_23867":43219,"_2386":43275},[],"**No Identity**",{"_2859":765,"_25205":747,"_17596":43277,"_5":17486,"_23867":43219,"_2386":43278},[],"A record exists without an associated identity.",{"_2859":766,"_25205":747,"_17596":43280,"_5":17486,"_23867":43219,"_2386":43281},[],"**Active**",{"_2859":767,"_25205":747,"_17596":43283,"_5":17486,"_23867":43219,"_2386":43284},[],"The slot is active; also check certificate dates, status and usages.",{"_2859":768,"_25205":747,"_17596":43286,"_5":17486,"_23867":43219,"_2386":43287},[],"**Renewal Pending**",{"_2859":769,"_25205":747,"_17596":43289,"_5":17486,"_23867":43219,"_2386":43290},[],"The identity is in the operational renewal window.",{"_2859":770,"_25205":747,"_17596":43292,"_5":17486,"_23867":43219,"_2386":43293},[],"**Expiring Soon**",{"_2859":771,"_25205":747,"_17596":43295,"_5":17486,"_23867":43219,"_2386":43296},[],"Expiration is approaching according to configured thresholds.",{"_2859":772,"_25205":747,"_17596":43298,"_5":17486,"_23867":43219,"_2386":43299},[],"**Expired**",{"_2859":773,"_25205":747,"_17596":43301,"_5":17486,"_23867":43219,"_2386":43302},[],"The identity has expired.",{"_2859":774,"_25205":747,"_17596":43304,"_5":17486,"_23867":43219,"_2386":43305},[],"**Revoked**",{"_2859":775,"_25205":747,"_17596":43307,"_5":17486,"_23867":43219,"_2386":43308},[],"The identity is marked revoked.",{"_2859":776,"_25205":747,"_17596":43310,"_5":17486,"_23867":43219,"_2386":43311},[],"**Decommissioned**",{"_2859":777,"_25205":747,"_17596":43313,"_5":17486,"_23867":43219,"_2386":43314},[],"The record is retired and ordinary updates do not restore operation.",{"_2859":778,"_25205":747,"_17596":43316,"_5":17486,"_23867":43219,"_2386":43317},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_2859":779,"_25205":747,"_17596":43319,"_5":17486,"_23867":43223,"_2386":43320},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_2859":780,"_25205":747,"_17596":43322,"_5":17486,"_23867":43223,"_2386":43323},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_2859":781,"_25205":747,"_17596":43325,"_5":17486,"_23867":43223,"_2386":43326},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_2859":782,"_25205":747,"_17596":43328,"_5":17486,"_23867":43223,"_2386":43329},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_2859":783,"_25205":747,"_17596":43331,"_5":17486,"_23867":43227,"_2386":43332},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_2859":784,"_25205":747,"_17596":43334,"_5":17486,"_23867":43231,"_2386":43335},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_2859":785,"_25205":747,"_17596":43337,"_5":17486,"_23867":43235,"_2386":43338},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_2859":786,"_25205":747,"_17596":43340,"_5":17486,"_23867":43239,"_2386":43341},[],"Add model, environment or location tags and an icon according to your inventory.",{"_2859":787,"_25205":747,"_17596":43343,"_5":17486,"_23867":43243,"_2386":43344},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_2859":788,"_25205":747,"_17596":43346,"_5":17486,"_23867":43243,"_2386":43347},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_2859":789,"_25205":747,"_17596":43349,"_5":17486,"_23867":43247,"_2386":43350},[],"From **No Identity**, use **Assign Identity**:",{"_2859":790,"_25205":747,"_17596":43352,"_5":17486,"_23867":43247,"_2386":43353},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_2859":791,"_25205":747,"_17596":43355,"_5":17486,"_23867":43247,"_2386":43356},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_2859":792,"_25205":747,"_17596":43358,"_5":17486,"_23867":43247,"_2386":43359},[],"Confirm and read the serial, active version and history again.",{"_2859":793,"_25205":747,"_17596":43361,"_5":17486,"_23867":43247,"_2386":43362},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_2859":794,"_25205":747,"_17596":43364,"_5":17486,"_23867":43247,"_2386":43365},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_2859":795,"_25205":747,"_17596":43367,"_5":17486,"_23867":43251,"_2386":43368},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_2859":796,"_25205":747,"_17596":43370,"_5":17486,"_23867":43251,"_2386":43371},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_2859":797,"_25205":747,"_17596":43373,"_5":17486,"_23867":43255,"_2386":43374},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_2859":798,"_25205":747,"_17596":43376,"_5":17486,"_23867":43255,"_2386":43377},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_2859":799,"_25205":747,"_17596":43379,"_5":17486,"_23867":43255,"_2386":43380},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_2859":800,"_25205":747,"_17596":43382,"_5":17486,"_23867":43255,"_2386":43383},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_2859":801,"_25205":747,"_17596":43385,"_5":17486,"_23867":43259,"_2386":43386},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2859":802,"_25205":747,"_17596":43388,"_5":17486,"_23867":43259,"_2386":43389},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2859":803,"_25205":803,"_5":12316,"_2386":43391,"_25540":43392,"_17596":43394,"_23867":803},"Bootstrap identity and authentication",[40894,42238,43212,43210,43393],"Enrollment with PKI",[],{"_2859":804,"_25205":803,"_17596":43396,"_5":17486,"_23867":803,"_2386":43397},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_2859":805,"_25205":803,"_5":25537,"_17596":43399,"_23867":43400,"_2386":43401},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_2859":806,"_25205":803,"_5":25537,"_17596":43403,"_23867":43404,"_2386":43405},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_2859":807,"_25205":803,"_5":25537,"_17596":43407,"_23867":43408,"_2386":43409},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_2859":808,"_25205":803,"_5":25537,"_17596":43411,"_23867":43412,"_2386":43413},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_2859":809,"_25205":803,"_5":25537,"_17596":43415,"_23867":43416,"_2386":43417},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_2859":810,"_25205":803,"_17596":43419,"_5":17486,"_23867":803,"_2386":43420},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_2859":811,"_25205":803,"_17596":43422,"_5":17486,"_23867":43400,"_2386":43423},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_2859":812,"_25205":803,"_17596":43425,"_5":17486,"_23867":43400,"_2386":43426},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_2859":813,"_25205":803,"_17596":43428,"_5":17486,"_23867":43404,"_2386":43429},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_2859":814,"_25205":803,"_17596":43431,"_5":17486,"_23867":43404,"_2386":43432},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_2859":815,"_25205":803,"_17596":43434,"_5":17486,"_23867":43404,"_2386":43435},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_2859":816,"_25205":803,"_17596":43437,"_5":17486,"_23867":43408,"_2386":43438},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_2859":817,"_25205":803,"_17596":43440,"_5":17486,"_23867":43408,"_2386":43441},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_2859":818,"_25205":803,"_17596":43443,"_5":17486,"_23867":43412,"_2386":43444},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_2859":819,"_25205":803,"_17596":43446,"_5":17486,"_23867":43412,"_2386":43447},[],"Example body:",{"_2859":820,"_25205":803,"_17596":43449,"_5":17486,"_23867":43412,"_2386":43450},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_2859":821,"_25205":803,"_17596":43452,"_5":17486,"_23867":43412,"_2386":43453},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_2859":822,"_25205":803,"_17596":43455,"_5":17486,"_23867":43412,"_2386":43456},[],"Continuation requires a successful HTTP response and JSON:",{"_2859":823,"_25205":803,"_17596":43458,"_5":17486,"_23867":43412,"_2386":43459},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_2859":824,"_25205":803,"_17596":43461,"_5":17486,"_23867":43416,"_2386":43462},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_2859":825,"_25205":803,"_17596":43464,"_5":17486,"_23867":43416,"_2386":43465},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_2859":826,"_25205":826,"_5":12316,"_2386":43467,"_25540":43468,"_17596":43469,"_23867":826},"Configure and operate the DMS",[40894,42238,43212,43210,43393],[],{"_2859":827,"_25205":826,"_17596":43471,"_5":17486,"_23867":826,"_2386":43472},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_2859":828,"_25205":826,"_5":25537,"_17596":43474,"_23867":43475,"_2386":40904},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#before-you-begin",{"_2859":829,"_25205":826,"_5":25537,"_17596":43477,"_23867":43478,"_2386":43479},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_2859":830,"_25205":826,"_5":25537,"_17596":43481,"_23867":43482,"_2386":43483},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_2859":831,"_25205":826,"_5":25537,"_17596":43485,"_23867":43486,"_2386":43487},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_2859":832,"_25205":826,"_5":25537,"_17596":43489,"_23867":43490,"_2386":43491},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_2859":833,"_25205":826,"_5":25537,"_17596":43493,"_23867":43494,"_2386":43495},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_2859":834,"_25205":826,"_5":25537,"_17596":43497,"_23867":43498,"_2386":43499},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_2859":835,"_25205":826,"_5":25537,"_17596":43501,"_23867":43502,"_2386":43503},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_2859":836,"_25205":826,"_5":25537,"_17596":43505,"_23867":43506,"_2386":43507},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_2859":837,"_25205":826,"_5":25537,"_17596":43509,"_23867":43510,"_2386":43511},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_2859":838,"_25205":826,"_5":25537,"_17596":43513,"_23867":43514,"_2386":43515},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_2859":839,"_25205":826,"_5":25537,"_17596":43517,"_23867":43518,"_2386":43519},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_2859":840,"_25205":826,"_5":25537,"_17596":43521,"_23867":43522,"_2386":43523},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_2859":841,"_25205":826,"_5":25537,"_17596":43525,"_23867":43526,"_2386":43527},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_2859":842,"_25205":826,"_5":25537,"_17596":43529,"_23867":43530,"_2386":43531},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_2859":843,"_25205":826,"_5":25537,"_17596":43533,"_23867":43534,"_2386":43535},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_2859":844,"_25205":826,"_5":25537,"_17596":43537,"_23867":43538,"_2386":43539},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_2859":845,"_25205":826,"_5":25537,"_17596":43541,"_23867":43542,"_2386":43543},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_2859":846,"_25205":826,"_17596":43545,"_5":17486,"_23867":826,"_2386":43546},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_2859":847,"_25205":826,"_17596":43548,"_5":17486,"_23867":43475,"_2386":43549},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_2859":848,"_25205":826,"_17596":43551,"_5":17486,"_23867":43475,"_2386":43552},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_2859":849,"_25205":826,"_17596":43554,"_5":17486,"_23867":43482,"_2386":43555},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_2859":850,"_25205":826,"_17596":43557,"_5":17486,"_23867":43486,"_2386":43558},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_2859":851,"_25205":826,"_17596":43560,"_5":17486,"_23867":43490,"_2386":43561},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_2859":852,"_25205":826,"_17596":43563,"_5":17486,"_23867":43494,"_2386":43564},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_2859":853,"_25205":826,"_17596":43566,"_5":17486,"_23867":43498,"_2386":43567},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_2859":854,"_25205":826,"_17596":43569,"_5":17486,"_23867":43506,"_2386":43570},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_2859":855,"_25205":826,"_17596":43572,"_5":17486,"_23867":43506,"_2386":43573},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_2859":856,"_25205":826,"_17596":43575,"_5":17486,"_23867":43510,"_2386":43576},[],"`settings.enrollment_settings` field",{"_2859":857,"_25205":826,"_17596":43578,"_5":17486,"_23867":43510,"_2386":43579},[],"Decision",{"_2859":858,"_25205":826,"_17596":43581,"_5":17486,"_23867":43510,"_2386":43582},[],"`protocol`",{"_2859":859,"_25205":826,"_17596":43584,"_5":17486,"_23867":43510,"_2386":43585},[],"`EST_RFC7030` for these operations.",{"_2859":860,"_25205":826,"_17596":43587,"_5":17486,"_23867":43510,"_2386":43588},[],"`enrollment_ca`",{"_2859":861,"_25205":826,"_17596":43590,"_5":17486,"_23867":43510,"_2386":43591},[],"ID of the signing CA.",{"_2859":862,"_25205":826,"_17596":43593,"_5":17486,"_23867":43510,"_2386":43594},[],"`verify_csr_signature`",{"_2859":863,"_25205":826,"_17596":43596,"_5":17486,"_23867":43510,"_2386":43597},[],"Keep `true` to verify CSR key possession.",{"_2859":864,"_25205":826,"_17596":43599,"_5":17486,"_23867":43510,"_2386":43600},[],"`enable_replaceable_enrollment`",{"_2859":865,"_25205":826,"_17596":43602,"_5":17486,"_23867":43510,"_2386":43603},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_2859":866,"_25205":826,"_17596":43605,"_5":17486,"_23867":43510,"_2386":43606},[],"`est_rfc7030_settings.auth_mode`",{"_2859":867,"_25205":826,"_17596":43608,"_5":17486,"_23867":43510,"_2386":43609},[],"One of the four authentication modes.",{"_2859":868,"_25205":826,"_17596":43611,"_5":17486,"_23867":43510,"_2386":43612},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_2859":869,"_25205":826,"_17596":43614,"_5":17486,"_23867":43514,"_2386":43615},[],"The blocks are independent:",{"_2859":870,"_25205":826,"_17596":43617,"_5":17486,"_23867":43514,"_2386":43618},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_2859":871,"_25205":826,"_17596":43620,"_5":17486,"_23867":43514,"_2386":43621},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_2859":872,"_25205":826,"_17596":43623,"_5":17486,"_23867":43514,"_2386":43624},[],"`auth_mode`",{"_2859":873,"_25205":826,"_17596":43626,"_5":17486,"_23867":43514,"_2386":43627},[],"Control applied in the configured operation",{"_2859":874,"_25205":826,"_17596":43629,"_5":17486,"_23867":43514,"_2386":43630},[],"`CLIENT_CERTIFICATE`",{"_2859":875,"_25205":826,"_17596":43632,"_5":17486,"_23867":43514,"_2386":43633},[],"Presented certificate validation.",{"_2859":876,"_25205":826,"_17596":43635,"_5":17486,"_23867":43514,"_2386":43636},[],"`EXTERNAL_WEBHOOK`",{"_2859":877,"_25205":826,"_17596":43638,"_5":17486,"_23867":43514,"_2386":43639},[],"Configured webhook authorization.",{"_2859":878,"_25205":826,"_17596":43641,"_5":17486,"_23867":43514,"_2386":43642},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_2859":879,"_25205":826,"_17596":43644,"_5":17486,"_23867":43514,"_2386":43645},[],"Certificate validation followed by webhook approval.",{"_2859":880,"_25205":826,"_17596":43647,"_5":17486,"_23867":43514,"_2386":43648},[],"`NO_AUTH`",{"_2859":881,"_25205":826,"_17596":43650,"_5":17486,"_23867":43514,"_2386":43651},[],"No DMS requester authentication.",{"_2859":882,"_25205":826,"_17596":43653,"_5":17486,"_23867":43514,"_2386":43654},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_2859":883,"_25205":826,"_17596":43656,"_5":17486,"_23867":43514,"_2386":43657},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_2859":884,"_25205":826,"_17596":43659,"_5":17486,"_23867":43514,"_2386":43660},[],"For certificate re-enrollment, the validator uses the enrollment CA, then `additional_validation_cas`, and `enable_expired_renewal`. Do not assume copying initial `validation_cas` changes those issuers.",{"_2859":885,"_25205":826,"_17596":43662,"_5":17486,"_23867":43514,"_2386":43663},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_2859":886,"_25205":826,"_17596":43665,"_5":17486,"_23867":43518,"_2386":43666},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_2859":887,"_25205":826,"_17596":43668,"_5":17486,"_23867":43518,"_2386":43669},[],"`external_webhook_settings` field",{"_2859":888,"_25205":826,"_17596":43671,"_5":17486,"_23867":43518,"_2386":43579},[],{"_2859":889,"_25205":826,"_17596":43673,"_5":17486,"_23867":43518,"_2386":43674},[],"`url`",{"_2859":890,"_25205":826,"_17596":43676,"_5":17486,"_23867":43518,"_2386":43677},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_2859":891,"_25205":826,"_17596":43679,"_5":17486,"_23867":43518,"_2386":43680},[],"`method`",{"_2859":892,"_25205":826,"_17596":43682,"_5":17486,"_23867":43518,"_2386":43683},[],"`POST` or `PUT`; `POST` by default.",{"_2859":893,"_25205":826,"_17596":43685,"_5":17486,"_23867":43518,"_2386":43686},[],"`name`",{"_2859":894,"_25205":826,"_17596":43688,"_5":17486,"_23867":43518,"_2386":43689},[],"Label used in service logs.",{"_2859":895,"_25205":826,"_17596":43691,"_5":17486,"_23867":43518,"_2386":43692},[],"`config.auth_mode`",{"_2859":896,"_25205":826,"_17596":43694,"_5":17486,"_23867":43518,"_2386":43695},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_2859":897,"_25205":826,"_17596":43697,"_5":17486,"_23867":43518,"_2386":43698},[],"`config.apikey_options`",{"_2859":898,"_25205":826,"_17596":43700,"_5":17486,"_23867":43518,"_2386":43701},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_2859":899,"_25205":826,"_17596":43703,"_5":17486,"_23867":43518,"_2386":43704},[],"`config.jwt_options`",{"_2859":900,"_25205":826,"_17596":43706,"_5":17486,"_23867":43518,"_2386":43707},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_2859":901,"_25205":826,"_17596":43709,"_5":17486,"_23867":43518,"_2386":43710},[],"`config.mtls_options`",{"_2859":902,"_25205":826,"_17596":43712,"_5":17486,"_23867":43518,"_2386":43713},[],"Required for `mtls`: `cert_content` and `key_content` as inline PEM.",{"_2859":903,"_25205":826,"_17596":43715,"_5":17486,"_23867":43518,"_2386":43716},[],"`config.insecure_skip_verify`",{"_2859":904,"_25205":826,"_17596":43718,"_5":17486,"_23867":43518,"_2386":43719},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_2859":905,"_25205":826,"_17596":43721,"_5":17486,"_23867":43518,"_2386":43722},[],"`config.call_timeout`",{"_2859":906,"_25205":826,"_17596":43724,"_5":17486,"_23867":43518,"_2386":43725},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_2859":907,"_25205":826,"_17596":43727,"_5":17486,"_23867":43518,"_2386":43728},[],"Rules for that configuration:",{"_2859":908,"_25205":826,"_17596":43730,"_5":17486,"_23867":43518,"_2386":43731},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so supply the PEM as `mtls_options.cert_content` and `key_content`.",{"_2859":909,"_25205":826,"_17596":43733,"_5":17486,"_23867":43518,"_2386":43734},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_2859":910,"_25205":826,"_17596":43736,"_5":17486,"_23867":43518,"_2386":43737},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_2859":911,"_25205":826,"_17596":43739,"_5":17486,"_23867":43518,"_2386":43740},[],"The API ignores the legacy fields `validate_server_cert`, `apikey`, `oidc` and `mtls`. A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` that still carries only the legacy option fields (`apikey`, `oidc`, `mtls`) fails validation with 400; only legacy `noauth` bodies are accepted, and their credentials are dropped.",{"_2859":912,"_25205":826,"_17596":43742,"_5":17486,"_23867":43518,"_2386":43743},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_2859":913,"_25205":826,"_17596":43745,"_5":17486,"_23867":43518,"_2386":43746},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_2859":914,"_25205":826,"_17596":43748,"_5":17486,"_23867":43518,"_2386":43749},[],"Migration `20260604110000` copies initial authentication into renewal settings if missing and the required structure exists. It preserves existing configuration. After upgrading, read both blocks; if your version’s console does not expose independent settings, use the DMS API.",{"_2859":915,"_25205":826,"_17596":43751,"_5":17486,"_23867":43518,"_2386":43752},[],"Migration `20261021120000` rewrites every stored webhook config into this layout: `validate_server_cert` becomes the negated `insecure_skip_verify` (a config where `validate_server_cert` was false keeps skipping verification), `oidc` becomes `jwt_options`, `apikey` becomes `apikey_options` and `mtls` becomes `mtls_options`. When both the legacy certificate and key are PEM, they move into `mtls_options.cert_content` and `key_content` and need no action. Otherwise, including a mixed config (PEM certificate, file-path key), both values become `mtls_options.cert_file` and `key_file`. Delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are re-entered as PEM content, or the leftover file fields are removed if the webhook does not use mTLS. If your version's console does not expose those fields, edit the DMS through the DMS API.",{"_2859":916,"_25205":826,"_17596":43754,"_5":17486,"_23867":43522,"_2386":43755},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_2859":917,"_25205":826,"_17596":43757,"_5":17486,"_23867":43526,"_2386":43758},[],"`settings.reenrollment_settings` field",{"_2859":918,"_25205":826,"_17596":43760,"_5":17486,"_23867":43526,"_2386":41277},[],{"_2859":919,"_25205":826,"_17596":43762,"_5":17486,"_23867":43526,"_2386":43763},[],"`reenrollment_delta`",{"_2859":920,"_25205":826,"_17596":43765,"_5":17486,"_23867":43526,"_2386":43766},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_2859":921,"_25205":826,"_17596":43768,"_5":17486,"_23867":43526,"_2386":43769},[],"`preventive_delta`",{"_2859":922,"_25205":826,"_17596":43771,"_5":17486,"_23867":43526,"_2386":43772},[],"Preventive operational monitoring threshold.",{"_2859":923,"_25205":826,"_17596":43774,"_5":17486,"_23867":43526,"_2386":43775},[],"`critical_delta`",{"_2859":924,"_25205":826,"_17596":43777,"_5":17486,"_23867":43526,"_2386":43778},[],"Critical operational monitoring threshold.",{"_2859":925,"_25205":826,"_17596":43780,"_5":17486,"_23867":43526,"_2386":43781},[],"`enable_expired_renewal`",{"_2859":926,"_25205":826,"_17596":43783,"_5":17486,"_23867":43526,"_2386":43784},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_2859":927,"_25205":826,"_17596":43786,"_5":17486,"_23867":43526,"_2386":43787},[],"`additional_validation_cas`",{"_2859":928,"_25205":826,"_17596":43789,"_5":17486,"_23867":43526,"_2386":43790},[],"Additional mTLS credential issuers during migration.",{"_2859":929,"_25205":826,"_17596":43792,"_5":17486,"_23867":43526,"_2386":43793},[],"`revoke_on_reenrollment`",{"_2859":930,"_25205":826,"_17596":43795,"_5":17486,"_23867":43526,"_2386":43796},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_2859":931,"_25205":826,"_17596":43798,"_5":17486,"_23867":43526,"_2386":43799},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_2859":932,"_25205":826,"_17596":43801,"_5":17486,"_23867":43530,"_2386":43802},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. Algorithm and size come from its `key` field; the profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_2859":933,"_25205":826,"_17596":43804,"_5":17486,"_23867":43534,"_2386":41271},[],{"_2859":934,"_25205":826,"_17596":43806,"_5":17486,"_23867":43534,"_2386":43807},[],"Published material",{"_2859":935,"_25205":826,"_17596":43809,"_5":17486,"_23867":43534,"_2386":43810},[],"**Include Lamassu System CA**",{"_2859":936,"_25205":826,"_17596":43812,"_5":17486,"_23867":43534,"_2386":43813},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_2859":937,"_25205":826,"_17596":43815,"_5":17486,"_23867":43534,"_2386":43816},[],"**Include Enrollment CA**",{"_2859":938,"_25205":826,"_17596":43818,"_5":17486,"_23867":43534,"_2386":43819},[],"Selected issuing CA certificate.",{"_2859":939,"_25205":826,"_17596":43821,"_5":17486,"_23867":43534,"_2386":43822},[],"**Managed CAs**",{"_2859":940,"_25205":826,"_17596":43824,"_5":17486,"_23867":43534,"_2386":43825},[],"Explicitly selected CA certificates.",{"_2859":941,"_25205":826,"_17596":43827,"_5":17486,"_23867":43534,"_2386":43828},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_2859":942,"_25205":826,"_17596":43830,"_5":17486,"_23867":43538,"_2386":43831},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included.",{"_2859":943,"_25205":826,"_17596":43833,"_5":17486,"_23867":43538,"_2386":43834},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_2859":944,"_25205":826,"_17596":43836,"_5":17486,"_23867":43538,"_2386":43837},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_2859":945,"_25205":826,"_17596":43839,"_5":17486,"_23867":43542,"_2386":43840},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_2859":946,"_25205":946,"_5":12316,"_2386":43842,"_25540":43843,"_17596":43844,"_23867":946},"Integrate the EST client",[40894,42238,43212,43210,43393],[],{"_2859":947,"_25205":946,"_17596":43846,"_5":17486,"_23867":946,"_2386":43847},[],"Prepare trust, send a CSR and check the identity you receive.",{"_2859":948,"_25205":946,"_5":25537,"_17596":43849,"_23867":43850,"_2386":40904},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_2859":949,"_25205":946,"_5":25537,"_17596":43852,"_23867":43853,"_2386":43854},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_2859":950,"_25205":946,"_5":25537,"_17596":43856,"_23867":43857,"_2386":43858},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_2859":951,"_25205":946,"_5":25537,"_17596":43860,"_23867":43861,"_2386":43862},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_2859":952,"_25205":946,"_5":25537,"_17596":43864,"_23867":43865,"_2386":43866},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_2859":953,"_25205":946,"_5":25537,"_17596":43868,"_23867":43869,"_2386":43870},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_2859":954,"_25205":946,"_17596":43872,"_5":17486,"_23867":946,"_2386":43873},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_2859":955,"_25205":946,"_17596":43875,"_5":17486,"_23867":43850,"_2386":43876},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_2859":956,"_25205":946,"_17596":43878,"_5":17486,"_23867":43850,"_2386":43879},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_2859":957,"_25205":946,"_17596":43881,"_5":17486,"_23867":43850,"_2386":43882},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_2859":958,"_25205":946,"_17596":43884,"_5":17486,"_23867":43853,"_2386":43885},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_2859":959,"_25205":946,"_17596":43887,"_5":17486,"_23867":43853,"_2386":43888},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_2859":960,"_25205":946,"_17596":43890,"_5":17486,"_23867":43857,"_2386":43891},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_2859":961,"_25205":946,"_17596":43893,"_5":17486,"_23867":43857,"_2386":43894},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_2859":962,"_25205":946,"_17596":43896,"_5":17486,"_23867":43861,"_2386":43897},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_2859":963,"_25205":946,"_17596":43899,"_5":17486,"_23867":43861,"_2386":43900},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_2859":964,"_25205":946,"_17596":43902,"_5":17486,"_23867":43865,"_2386":43903},[],"For a root that issues directly:",{"_2859":965,"_25205":946,"_17596":43905,"_5":17486,"_23867":43865,"_2386":43906},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_2859":966,"_25205":946,"_17596":43908,"_5":17486,"_23867":43865,"_2386":43909},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_2859":967,"_25205":946,"_17596":43911,"_5":17486,"_23867":43869,"_2386":43912},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_2859":968,"_25205":968,"_5":12316,"_2386":43914,"_25540":43915,"_17596":43916,"_23867":968},"EST reference",[40894,42238,43212,43210,43393],[],{"_2859":969,"_25205":968,"_17596":43918,"_5":17486,"_23867":968,"_2386":43919},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_2859":970,"_25205":968,"_5":25537,"_17596":43921,"_23867":43922,"_2386":43923},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_2859":971,"_25205":968,"_5":25537,"_17596":43925,"_23867":43926,"_2386":19104},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2859":972,"_25205":968,"_5":25537,"_17596":43928,"_23867":43929,"_2386":21895},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2859":973,"_25205":968,"_5":25537,"_17596":43931,"_23867":43932,"_2386":21902},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2859":974,"_25205":968,"_5":25537,"_17596":43934,"_23867":43935,"_2386":21272},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2859":975,"_25205":968,"_5":25537,"_17596":43937,"_23867":43938,"_2386":43939},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_2859":976,"_25205":968,"_5":25537,"_17596":43941,"_23867":43942,"_2386":43943},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_2859":977,"_25205":968,"_5":25537,"_17596":43945,"_23867":43946,"_2386":43947},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_2859":978,"_25205":968,"_17596":43949,"_5":17486,"_23867":968,"_2386":43950},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_2859":979,"_25205":968,"_17596":43952,"_5":17486,"_23867":43922,"_2386":43953},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_2859":980,"_25205":968,"_17596":43955,"_5":17486,"_23867":43922,"_2386":43956},[],"Operation",{"_2859":981,"_25205":968,"_17596":43958,"_5":17486,"_23867":43922,"_2386":43959},[],"Method",{"_2859":982,"_25205":968,"_17596":43961,"_5":17486,"_23867":43922,"_2386":43962},[],"Authentication and condition",{"_2859":983,"_25205":968,"_17596":43964,"_5":17486,"_23867":43922,"_2386":43965},[],"`/cacerts`",{"_2859":984,"_25205":968,"_17596":43967,"_5":17486,"_23867":43922,"_2386":43968},[],"GET",{"_2859":985,"_25205":968,"_17596":43970,"_5":17486,"_23867":43922,"_2386":43971},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_2859":986,"_25205":968,"_17596":43973,"_5":17486,"_23867":43922,"_2386":43974},[],"`/simpleenroll`",{"_2859":987,"_25205":968,"_17596":43976,"_5":17486,"_23867":43922,"_2386":43977},[],"POST",{"_2859":988,"_25205":968,"_17596":43979,"_5":17486,"_23867":43922,"_2386":43980},[],"Initial authentication and DMS registration/replacement policy.",{"_2859":989,"_25205":968,"_17596":43982,"_5":17486,"_23867":43922,"_2386":43983},[],"`/simplereenroll`",{"_2859":990,"_25205":968,"_17596":43985,"_5":17486,"_23867":43922,"_2386":43977},[],{"_2859":991,"_25205":968,"_17596":43987,"_5":17486,"_23867":43922,"_2386":43988},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_2859":992,"_25205":968,"_17596":43990,"_5":17486,"_23867":43922,"_2386":43991},[],"`/serverkeygen`",{"_2859":993,"_25205":968,"_17596":43993,"_5":17486,"_23867":43922,"_2386":43977},[],{"_2859":994,"_25205":968,"_17596":43995,"_5":17486,"_23867":43922,"_2386":43996},[],"Initial authentication and admission; server generation enabled.",{"_2859":995,"_25205":968,"_17596":43998,"_5":17486,"_23867":43922,"_2386":43999},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_2859":996,"_25205":968,"_17596":44001,"_5":17486,"_23867":43926,"_2386":44002},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_2859":997,"_25205":968,"_17596":44004,"_5":17486,"_23867":43926,"_2386":44005},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_2859":998,"_25205":968,"_17596":44007,"_5":17486,"_23867":43929,"_2386":44008},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_2859":999,"_25205":968,"_17596":44010,"_5":17486,"_23867":43929,"_2386":44011},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_2859":1000,"_25205":968,"_17596":44013,"_5":17486,"_23867":43932,"_2386":44014},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_2859":1001,"_25205":968,"_17596":44016,"_5":17486,"_23867":43932,"_2386":44017},[],"The enrollment CA or an additional CA validates the credential in mTLS mode. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_2859":1002,"_25205":968,"_17596":44019,"_5":17486,"_23867":43935,"_2386":44020},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_2859":1003,"_25205":968,"_17596":44022,"_5":17486,"_23867":43935,"_2386":44023},[],"The code supports RSA and ECDSA with 224, 256, 384 or 521 bits. An unrecognized ECDSA size can fall back to 256; explicitly select a compatible size and check the resulting key. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_2859":1004,"_25205":968,"_17596":44025,"_5":17486,"_23867":43938,"_2386":44026},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_2859":1005,"_25205":968,"_17596":44028,"_5":17486,"_23867":43938,"_2386":44029},[],"Part",{"_2859":1006,"_25205":968,"_17596":44031,"_5":17486,"_23867":43938,"_2386":44032},[],"Content after decoding its Base64",{"_2859":1007,"_25205":968,"_17596":44034,"_5":17486,"_23867":43938,"_2386":44035},[],"`application/pkcs8`",{"_2859":1008,"_25205":968,"_17596":44037,"_5":17486,"_23867":43938,"_2386":44038},[],"Unencrypted DER PKCS#8 private key.",{"_2859":1009,"_25205":968,"_17596":44040,"_5":17486,"_23867":43938,"_2386":44041},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_2859":1010,"_25205":968,"_17596":44043,"_5":17486,"_23867":43938,"_2386":44044},[],"DER PKCS#7 containing the issued certificate.",{"_2859":1011,"_25205":968,"_17596":44046,"_5":17486,"_23867":43938,"_2386":44047},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_2859":1012,"_25205":968,"_17596":44049,"_5":17486,"_23867":43942,"_2386":44050},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_2859":1013,"_25205":968,"_17596":44052,"_5":17486,"_23867":43942,"_2386":44053},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_2859":1014,"_25205":968,"_17596":44055,"_5":17486,"_23867":43942,"_2386":44056},[],"Convert and check the result:",{"_2859":1015,"_25205":968,"_17596":44058,"_5":17486,"_23867":43942,"_2386":44059},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_2859":1016,"_25205":968,"_17596":44061,"_5":17486,"_23867":43946,"_2386":44062},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_2859":1017,"_25205":968,"_17596":44064,"_5":17486,"_23867":43946,"_2386":44065},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_2859":1018,"_25205":1018,"_5":12316,"_2386":43393,"_25540":44067,"_17596":44068,"_23867":1018},[40894,42238,43212,43210,43393],[],{"_2859":1019,"_25205":1018,"_17596":44070,"_5":17486,"_23867":1018,"_2386":44071},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_2859":1020,"_25205":1018,"_5":25537,"_17596":44073,"_23867":44074,"_2386":44075},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_2859":1021,"_25205":1018,"_5":25537,"_17596":44077,"_23867":44078,"_2386":44079},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_2859":1022,"_25205":1018,"_5":25537,"_17596":44081,"_23867":44082,"_2386":44083},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_2859":1023,"_25205":1018,"_5":25537,"_17596":44085,"_23867":44086,"_2386":44087},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_2859":1024,"_25205":1018,"_17596":44089,"_5":17486,"_23867":1018,"_2386":44090},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_2859":1025,"_25205":1018,"_17596":44092,"_5":17486,"_23867":44074,"_2386":44093},[],"The administrator prepares the CA, issuance profile and DMS.",{"_2859":1026,"_25205":1018,"_17596":44095,"_5":17486,"_23867":44074,"_2386":44096},[],"The integrator installs initial EST server trust and an admission credential.",{"_2859":1027,"_25205":1018,"_17596":44098,"_5":17486,"_23867":44074,"_2386":44099},[],"The client requests an identity for its `Device ID` through EST.",{"_2859":1028,"_25205":1018,"_17596":44101,"_5":17486,"_23867":44074,"_2386":44102},[],"Certificate, device binding and key/certificate installation are checked.",{"_2859":1029,"_25205":1018,"_17596":44104,"_5":17486,"_23867":44074,"_2386":44105},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_2859":1030,"_25205":1018,"_17596":44107,"_5":17486,"_23867":44074,"_2386":44108},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_2859":1031,"_25205":1018,"_17596":44110,"_5":17486,"_23867":44078,"_2386":44111},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2859":1032,"_25205":1018,"_17596":44113,"_5":17486,"_23867":44078,"_2386":44114},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2859":1033,"_25205":1018,"_17596":44116,"_5":17486,"_23867":44078,"_2386":44117},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2859":1034,"_25205":1018,"_17596":44119,"_5":17486,"_23867":44078,"_2386":44120},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2859":1035,"_25205":1018,"_17596":44122,"_5":17486,"_23867":44082,"_2386":44123},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2859":1036,"_25205":1018,"_17596":44125,"_5":17486,"_23867":44082,"_2386":44126},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2859":1037,"_25205":1018,"_17596":44128,"_5":17486,"_23867":44082,"_2386":44129},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2859":1038,"_25205":1018,"_17596":44131,"_5":17486,"_23867":44082,"_2386":44132},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2859":1039,"_25205":1018,"_17596":44134,"_5":17486,"_23867":44086,"_2386":44135},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract and migrations, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_2859":1040,"_25205":1018,"_17596":44137,"_5":17486,"_23867":44086,"_2386":44138},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_2859":1041,"_25205":1041,"_5":12316,"_2386":44140,"_25540":44141,"_17596":44142,"_23867":1041},"Provisioning strategies",[40894,42238,43212,43210,43393],[],{"_2859":1042,"_25205":1041,"_17596":44144,"_5":17486,"_23867":1041,"_2386":44145},[],"Choose device registration, identity authorization and key generation.",{"_2859":1043,"_25205":1041,"_5":25537,"_17596":44147,"_23867":44148,"_2386":44149},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_2859":1044,"_25205":1041,"_5":25537,"_17596":44151,"_23867":44152,"_2386":44153},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_2859":1045,"_25205":1041,"_5":25537,"_17596":44155,"_23867":44156,"_2386":44157},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_2859":1046,"_25205":1041,"_5":25537,"_17596":44159,"_23867":44160,"_2386":44161},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_2859":1047,"_25205":1041,"_5":25537,"_17596":44163,"_23867":44164,"_2386":44165},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_2859":1048,"_25205":1041,"_17596":44167,"_5":17486,"_23867":1041,"_2386":44168},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_2859":1049,"_25205":1041,"_17596":44170,"_5":17486,"_23867":44148,"_2386":44171},[],"Path",{"_2859":1050,"_25205":1041,"_17596":44173,"_5":17486,"_23867":44148,"_2386":44174},[],"When the device exists",{"_2859":1051,"_25205":1041,"_17596":44176,"_5":17486,"_23867":44148,"_2386":44177},[],"What to check",{"_2859":1052,"_25205":1041,"_17596":44179,"_5":17486,"_23867":44148,"_2386":44180},[],"Manual assignment",{"_2859":1053,"_25205":1041,"_17596":44182,"_5":17486,"_23867":44148,"_2386":44183},[],"An operator creates it before associating a certificate.",{"_2859":1054,"_25205":1041,"_17596":44185,"_5":17486,"_23867":44148,"_2386":44186},[],"ID, owning DMS, certificate CN and bound serial.",{"_2859":1055,"_25205":1041,"_17596":44188,"_5":17486,"_23867":44148,"_2386":44189},[],"EST with `JITP`",{"_2859":1056,"_25205":1041,"_17596":44191,"_5":17486,"_23867":44148,"_2386":44192},[],"Created for an unknown CN during `/simpleenroll`.",{"_2859":1057,"_25205":1041,"_17596":44194,"_5":17486,"_23867":44148,"_2386":44195},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_2859":1058,"_25205":1041,"_17596":44197,"_5":17486,"_23867":44148,"_2386":44198},[],"EST with `PRE_REGISTRATION`",{"_2859":1059,"_25205":1041,"_17596":44200,"_5":17486,"_23867":44148,"_2386":44201},[],"Must exist before `/simpleenroll`.",{"_2859":1060,"_25205":1041,"_17596":44203,"_5":17486,"_23867":44148,"_2386":44204},[],"Approved record, same DMS and replacement conditions for your version.",{"_2859":1061,"_25205":1041,"_17596":44206,"_5":17486,"_23867":44148,"_2386":44207},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_2859":1062,"_25205":1041,"_17596":44209,"_5":17486,"_23867":44148,"_2386":44210},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_2859":1063,"_25205":1041,"_17596":44212,"_5":17486,"_23867":44152,"_2386":44213},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_2859":1064,"_25205":1041,"_17596":44215,"_5":17486,"_23867":44152,"_2386":44216},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_2859":1065,"_25205":1041,"_17596":44218,"_5":17486,"_23867":44152,"_2386":44219},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_2859":1066,"_25205":1041,"_17596":44221,"_5":17486,"_23867":44156,"_2386":44222},[],"Decide initial enrollment and re-enrollment separately:",{"_2859":1067,"_25205":1041,"_17596":44224,"_5":17486,"_23867":44156,"_2386":44225},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_2859":1068,"_25205":1041,"_17596":44227,"_5":17486,"_23867":44156,"_2386":44228},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_2859":1069,"_25205":1041,"_17596":44230,"_5":17486,"_23867":44156,"_2386":44231},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_2859":1070,"_25205":1041,"_17596":44233,"_5":17486,"_23867":44156,"_2386":44234},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_2859":1071,"_25205":1041,"_17596":44236,"_5":17486,"_23867":44156,"_2386":44237},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_2859":1072,"_25205":1041,"_17596":44239,"_5":17486,"_23867":44160,"_2386":41271},[],{"_2859":1073,"_25205":1041,"_17596":44241,"_5":17486,"_23867":44160,"_2386":44242},[],"Material crossing EST",{"_2859":1074,"_25205":1041,"_17596":44244,"_5":17486,"_23867":44160,"_2386":44245},[],"Device-generated key",{"_2859":1075,"_25205":1041,"_17596":44247,"_5":17486,"_23867":44160,"_2386":44248},[],"Public CSR and certificate; the key stays on the client.",{"_2859":1076,"_25205":1041,"_17596":44250,"_5":17486,"_23867":44160,"_2386":44251},[],"Existing device key",{"_2859":1077,"_25205":1041,"_17596":44253,"_5":17486,"_23867":44160,"_2386":44254},[],"CSR signed with that key and a new certificate.",{"_2859":1078,"_25205":1041,"_17596":44256,"_5":17486,"_23867":44160,"_2386":43531},[],{"_2859":1079,"_25205":1041,"_17596":44258,"_5":17486,"_23867":44160,"_2386":44259},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_2859":1080,"_25205":1041,"_17596":44261,"_5":17486,"_23867":44160,"_2386":44262},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_2859":1081,"_25205":1041,"_17596":44264,"_5":17486,"_23867":44164,"_2386":44265},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_2859":1082,"_25205":1082,"_5":12316,"_2386":44267,"_25540":44268,"_17596":44269,"_23867":1082},"Renewal and recovery",[40894,42238,43212,43210,43393],[],{"_2859":1083,"_25205":1082,"_17596":44271,"_5":17486,"_23867":1082,"_2386":44272},[],"Renew without losing the identity and recover devices according to their actual state.",{"_2859":1084,"_25205":1082,"_5":25537,"_17596":44274,"_23867":44275,"_2386":44276},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_2859":1085,"_25205":1082,"_5":25537,"_17596":44278,"_23867":44279,"_2386":44280},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_2859":1086,"_25205":1082,"_5":25537,"_17596":44282,"_23867":44283,"_2386":44284},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_2859":1087,"_25205":1082,"_5":25537,"_17596":44286,"_23867":44287,"_2386":44288},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_2859":1088,"_25205":1082,"_5":25537,"_17596":44290,"_23867":44291,"_2386":44292},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_2859":1089,"_25205":1082,"_17596":44294,"_5":17486,"_23867":1082,"_2386":44295},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_2859":1090,"_25205":1082,"_17596":44297,"_5":17486,"_23867":44275,"_2386":44298},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_2859":1091,"_25205":1082,"_17596":44300,"_5":17486,"_23867":44275,"_2386":44301},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_2859":1092,"_25205":1082,"_17596":44303,"_5":17486,"_23867":44275,"_2386":44304},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_2859":1093,"_25205":1082,"_17596":44306,"_5":17486,"_23867":44275,"_2386":44307},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_2859":1094,"_25205":1082,"_17596":44309,"_5":17486,"_23867":44279,"_2386":44310},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_2859":1095,"_25205":1082,"_17596":44312,"_5":17486,"_23867":44279,"_2386":44313},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_2859":1096,"_25205":1082,"_17596":44315,"_5":17486,"_23867":44283,"_2386":44316},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_2859":1097,"_25205":1082,"_17596":44318,"_5":17486,"_23867":44283,"_2386":44319},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_2859":1098,"_25205":1082,"_17596":44321,"_5":17486,"_23867":44283,"_2386":44322},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_2859":1099,"_25205":1082,"_17596":44324,"_5":17486,"_23867":44287,"_2386":44325},[],"Situation",{"_2859":1100,"_25205":1082,"_17596":44327,"_5":17486,"_23867":44287,"_2386":44328},[],"Procedure",{"_2859":1101,"_25205":1082,"_17596":44330,"_5":17486,"_23867":44287,"_2386":44331},[],"Valid certificate, outside the window",{"_2859":1102,"_25205":1082,"_17596":44333,"_5":17486,"_23867":44287,"_2386":44334},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_2859":1103,"_25205":1082,"_17596":44336,"_5":17486,"_23867":44287,"_2386":44337},[],"Expired certificate, key available",{"_2859":1104,"_25205":1082,"_17596":44339,"_5":17486,"_23867":44287,"_2386":44340},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_2859":1105,"_25205":1082,"_17596":44342,"_5":17486,"_23867":44287,"_2386":44343},[],"Renewal through webhook or `NO_AUTH`",{"_2859":1106,"_25205":1082,"_17596":44345,"_5":17486,"_23867":44287,"_2386":44346},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_2859":1107,"_25205":1082,"_17596":44348,"_5":17486,"_23867":44287,"_2386":44349},[],"Lost or inaccessible key",{"_2859":1108,"_25205":1082,"_17596":44351,"_5":17486,"_23867":44287,"_2386":44352},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_2859":1109,"_25205":1082,"_17596":44354,"_5":17486,"_23867":44287,"_2386":44355},[],"Current identity revoked",{"_2859":1110,"_25205":1082,"_17596":44357,"_5":17486,"_23867":44287,"_2386":44358},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_2859":1111,"_25205":1082,"_17596":44360,"_5":17486,"_23867":44287,"_2386":44361},[],"Device without an identity",{"_2859":1112,"_25205":1082,"_17596":44363,"_5":17486,"_23867":44287,"_2386":44364},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_2859":1113,"_25205":1082,"_17596":44366,"_5":17486,"_23867":44287,"_2386":44367},[],"Retired device",{"_2859":1114,"_25205":1082,"_17596":44369,"_5":17486,"_23867":44287,"_2386":44370},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_2859":1115,"_25205":1082,"_17596":44372,"_5":17486,"_23867":44287,"_2386":44373},[],"Timeout, HTTP 500 or installation failure",{"_2859":1116,"_25205":1082,"_17596":44375,"_5":17486,"_23867":44287,"_2386":44376},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_2859":1117,"_25205":1082,"_17596":44378,"_5":17486,"_23867":44291,"_2386":44379},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_2859":1118,"_25205":1082,"_17596":44381,"_5":17486,"_23867":44291,"_2386":44382},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_2859":1119,"_25205":1119,"_5":12316,"_2386":44384,"_25540":44385,"_17596":44386,"_23867":1119},"Enrollment troubleshooting",[40894,42238,43212,43210,43393],[],{"_2859":1120,"_25205":1119,"_17596":44388,"_5":17486,"_23867":1119,"_2386":44389},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_2859":1121,"_25205":1119,"_5":25537,"_17596":44391,"_23867":44392,"_2386":44393},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_2859":1122,"_25205":1119,"_5":25537,"_17596":44395,"_23867":44396,"_2386":44397},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_2859":1123,"_25205":1119,"_5":25537,"_17596":44399,"_23867":44400,"_2386":43947},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_2859":1124,"_25205":1119,"_5":25537,"_17596":44402,"_23867":44403,"_2386":44404},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_2859":1125,"_25205":1119,"_17596":44406,"_5":17486,"_23867":1119,"_2386":44407},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_2859":1126,"_25205":1119,"_17596":44409,"_5":17486,"_23867":44396,"_2386":44410},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_2859":1127,"_25205":1119,"_17596":44412,"_5":17486,"_23867":44396,"_2386":44413},[],"Symptom or message",{"_2859":1128,"_25205":1119,"_17596":44415,"_5":17486,"_23867":44396,"_2386":44177},[],{"_2859":1129,"_25205":1119,"_17596":44417,"_5":17486,"_23867":44396,"_2386":44418},[],"curl rejects TLS, name or issuer",{"_2859":1130,"_25205":1119,"_17596":44420,"_5":17486,"_23867":44396,"_2386":44421},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_2859":1131,"_25205":1119,"_17596":44423,"_5":17486,"_23867":44396,"_2386":44424},[],"404 or missing APS",{"_2859":1132,"_25205":1119,"_17596":44426,"_5":17486,"_23867":44396,"_2386":44427},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_2859":1133,"_25205":1119,"_17596":44429,"_5":17486,"_23867":44396,"_2386":44430},[],"400, CSR or format error",{"_2859":1134,"_25205":1119,"_17596":44432,"_5":17486,"_23867":44396,"_2386":44433},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_2859":1135,"_25205":1119,"_17596":44435,"_5":17486,"_23867":44396,"_2386":44436},[],"Missing credential or invalid certificate",{"_2859":1136,"_25205":1119,"_17596":44438,"_5":17486,"_23867":44396,"_2386":44439},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_2859":1137,"_25205":1119,"_17596":44441,"_5":17486,"_23867":44396,"_2386":44442},[],"Webhook denies, times out or responds without authorization",{"_2859":1138,"_25205":1119,"_17596":44444,"_5":17486,"_23867":44396,"_2386":44445},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_2859":1139,"_25205":1119,"_17596":44447,"_5":17486,"_23867":44396,"_2386":44448},[],"`unexpected status code: <n>: redirects are not followed`",{"_2859":1140,"_25205":1119,"_17596":44450,"_5":17486,"_23867":44396,"_2386":44451},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_2859":1141,"_25205":1119,"_17596":44453,"_5":17486,"_23867":44396,"_2386":44454},[],"`webhook response exceeds 1048576 bytes`",{"_2859":1142,"_25205":1119,"_17596":44456,"_5":17486,"_23867":44396,"_2386":44457},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_2859":1143,"_25205":1119,"_17596":44459,"_5":17486,"_23867":44396,"_2386":44460},[],"`webhook config must not reference files`",{"_2859":1144,"_25205":1119,"_17596":44462,"_5":17486,"_23867":44396,"_2386":44463},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the PEM as `cert_content` and `key_content`; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the upgrade note in DMS.",{"_2859":1145,"_25205":1119,"_17596":44465,"_5":17486,"_23867":44396,"_2386":44466},[],"400 `struct validation error` creating or updating a DMS",{"_2859":1146,"_25205":1119,"_17596":44468,"_5":17486,"_23867":44396,"_2386":44469},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_2859":1147,"_25205":1119,"_17596":44471,"_5":17486,"_23867":44396,"_2386":44472},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_2859":1148,"_25205":1119,"_17596":44474,"_5":17486,"_23867":44396,"_2386":44475},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_2859":1149,"_25205":1119,"_17596":44477,"_5":17486,"_23867":44396,"_2386":44478},[],"`device not preregistered`",{"_2859":1150,"_25205":1119,"_17596":44480,"_5":17486,"_23867":44396,"_2386":44481},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_2859":1151,"_25205":1119,"_17596":44483,"_5":17486,"_23867":44396,"_2386":44484},[],"`forbiddenNewEnrollment`",{"_2859":1152,"_25205":1119,"_17596":44486,"_5":17486,"_23867":44396,"_2386":44487},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_2859":1153,"_25205":1119,"_17596":44489,"_5":17486,"_23867":44396,"_2386":44490},[],"Different owning DMS",{"_2859":1154,"_25205":1119,"_17596":44492,"_5":17486,"_23867":44396,"_2386":44493},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_2859":1155,"_25205":1119,"_17596":44495,"_5":17486,"_23867":44396,"_2386":44496},[],"`invalid RawSubject bytes`",{"_2859":1156,"_25205":1119,"_17596":44498,"_5":17486,"_23867":44396,"_2386":44499},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_2859":1157,"_25205":1119,"_17596":44501,"_5":17486,"_23867":44396,"_2386":44502},[],"`invalid reenroll window`",{"_2859":1158,"_25205":1119,"_17596":44504,"_5":17486,"_23867":44396,"_2386":44505},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_2859":1159,"_25205":1119,"_17596":44507,"_5":17486,"_23867":44396,"_2386":44508},[],"Current certificate revoked",{"_2859":1160,"_25205":1119,"_17596":44510,"_5":17486,"_23867":44396,"_2386":44511},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_2859":1161,"_25205":1119,"_17596":44513,"_5":17486,"_23867":44396,"_2386":44514},[],"CA, profile or signing error",{"_2859":1162,"_25205":1119,"_17596":44516,"_5":17486,"_23867":44396,"_2386":44517},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_2859":1163,"_25205":1119,"_17596":44519,"_5":17486,"_23867":44396,"_2386":44520},[],"HTTP 200 without a device connection",{"_2859":1164,"_25205":1119,"_17596":44522,"_5":17486,"_23867":44396,"_2386":44523},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_2859":1165,"_25205":1119,"_17596":44525,"_5":17486,"_23867":44396,"_2386":44526},[],"Timeout or error after issuance",{"_2859":1166,"_25205":1119,"_17596":44528,"_5":17486,"_23867":44396,"_2386":44529},[],"New certificates, current slot and previous identity's state before retrying.",{"_2859":1167,"_25205":1119,"_17596":44531,"_5":17486,"_23867":44400,"_2386":44532},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode after migration and Gateway behavior with expired certificates and the bootstrap CA.",{"_2859":1168,"_25205":1119,"_17596":44534,"_5":17486,"_23867":44400,"_2386":44535},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_2859":1169,"_25205":1119,"_17596":44537,"_5":17486,"_23867":44403,"_2386":44538},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_2859":1170,"_25205":1119,"_17596":44540,"_5":17486,"_23867":44403,"_2386":44541},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_2859":1171,"_25205":1119,"_17596":44543,"_5":17486,"_23867":44403,"_2386":44544},[],"Verify the CSR locally and relate its CN to the inventory.",{"_2859":1172,"_25205":1119,"_17596":44546,"_5":17486,"_23867":44403,"_2386":44547},[],"Make one request, save headers/body and query the device and certificates.",{"_2859":1173,"_25205":1119,"_17596":44549,"_5":17486,"_23867":44403,"_2386":44550},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_2859":1174,"_25205":1119,"_17596":44552,"_5":17486,"_23867":44403,"_2386":44553},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_2859":1175,"_25205":1119,"_17596":44555,"_5":17486,"_23867":44403,"_2386":44556},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_2859":1176,"_25205":1176,"_5":12316,"_2386":44558,"_25540":44559,"_17596":44560,"_23867":1176},"Trust distribution and updates",[40894,42238,43212,43210,43393],[],{"_2859":1177,"_25205":1176,"_17596":44562,"_5":17486,"_23867":1176,"_2386":44563},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_2859":1178,"_25205":1176,"_5":25537,"_17596":44565,"_23867":44566,"_2386":44567},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_2859":1179,"_25205":1176,"_5":25537,"_17596":44569,"_23867":44570,"_2386":44571},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_2859":1180,"_25205":1176,"_5":25537,"_17596":44573,"_23867":44574,"_2386":44575},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_2859":1181,"_25205":1176,"_5":25537,"_17596":44577,"_23867":44578,"_2386":44579},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_2859":1182,"_25205":1176,"_5":25537,"_17596":44581,"_23867":44582,"_2386":44583},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_2859":1183,"_25205":1176,"_17596":44585,"_5":17486,"_23867":1176,"_2386":44586},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_2859":1184,"_25205":1176,"_17596":44588,"_5":17486,"_23867":44566,"_2386":44589},[],"Relationship",{"_2859":1185,"_25205":1176,"_17596":44591,"_5":17486,"_23867":44566,"_2386":44592},[],"Material prepared by its owner",{"_2859":1186,"_25205":1176,"_17596":44594,"_5":17486,"_23867":44566,"_2386":44595},[],"Device → EST server",{"_2859":1187,"_25205":1176,"_17596":44597,"_5":17486,"_23867":44566,"_2386":44598},[],"Previously verified server root, chain or pin and TLS name.",{"_2859":1188,"_25205":1176,"_17596":44600,"_5":17486,"_23867":44566,"_2386":44601},[],"DMS → requester",{"_2859":1189,"_25205":1176,"_17596":44603,"_5":17486,"_23867":44566,"_2386":44604},[],"CAs and rules authorizing initial or renewal credentials.",{"_2859":1190,"_25205":1176,"_17596":44606,"_5":17486,"_23867":44566,"_2386":44607},[],"Consumer → device",{"_2859":1191,"_25205":1176,"_17596":44609,"_5":17486,"_23867":44566,"_2386":44610},[],"Operational identity roots, intermediates, validation and permissions.",{"_2859":1192,"_25205":1176,"_17596":44612,"_5":17486,"_23867":44566,"_2386":44613},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_2859":1193,"_25205":1176,"_17596":44615,"_5":17486,"_23867":44570,"_2386":44616},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_2859":1194,"_25205":1176,"_17596":44618,"_5":17486,"_23867":44570,"_2386":44619},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_2859":1195,"_25205":1176,"_17596":44621,"_5":17486,"_23867":44574,"_2386":44622},[],"Keep initial EST server trust separate from identity consumer trust.",{"_2859":1196,"_25205":1176,"_17596":44624,"_5":17486,"_23867":44574,"_2386":44625},[],"Select policy-approved roots as anchors.",{"_2859":1197,"_25205":1176,"_17596":44627,"_5":17486,"_23867":44574,"_2386":44628},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_2859":1198,"_25205":1176,"_17596":44630,"_5":17486,"_23867":44574,"_2386":44631},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_2859":1199,"_25205":1176,"_17596":44633,"_5":17486,"_23867":44574,"_2386":44634},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_2859":1200,"_25205":1176,"_17596":44636,"_5":17486,"_23867":44574,"_2386":44637},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_2859":1201,"_25205":1176,"_17596":44639,"_5":17486,"_23867":44578,"_2386":44640},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_2859":1202,"_25205":1176,"_17596":44642,"_5":17486,"_23867":44578,"_2386":44643},[],"In the DMS, separate distributed CAs from `additional_validation_cas`, used for re-enrollment credentials. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_2859":1203,"_25205":1176,"_17596":44645,"_5":17486,"_23867":44578,"_2386":44646},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_2859":1204,"_25205":1176,"_17596":44648,"_5":17486,"_23867":44582,"_2386":44649},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_2859":1205,"_25205":1205,"_5":12316,"_2386":44651,"_25540":44652,"_17596":44654,"_23867":1205},"AWS IoT Core",[40894,42238,43212,43210,44653],"Integrations",[],{"_2859":1206,"_25205":1205,"_17596":44656,"_5":17486,"_23867":1205,"_2386":44657},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_2859":1207,"_25205":1205,"_5":25537,"_17596":44659,"_23867":44660,"_2386":44661},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_2859":1208,"_25205":1205,"_5":25537,"_17596":44663,"_23867":44664,"_2386":44665},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_2859":1209,"_25205":1205,"_5":25537,"_17596":44667,"_23867":44668,"_2386":44669},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_2859":1210,"_25205":1205,"_5":25537,"_17596":44671,"_23867":44672,"_2386":44673},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_2859":1211,"_25205":1205,"_5":25537,"_17596":44675,"_23867":44676,"_2386":44677},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_2859":1212,"_25205":1205,"_5":25537,"_17596":44679,"_23867":44680,"_2386":44681},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_2859":1213,"_25205":1205,"_5":25537,"_17596":44683,"_23867":44684,"_2386":44685},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_2859":1214,"_25205":1205,"_5":25537,"_17596":44687,"_23867":44688,"_2386":44689},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_2859":1215,"_25205":1205,"_5":25537,"_17596":44691,"_23867":44692,"_2386":44693},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_2859":1216,"_25205":1205,"_5":25537,"_17596":44695,"_23867":44696,"_2386":44697},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_2859":1217,"_25205":1205,"_5":25537,"_17596":44699,"_23867":44700,"_2386":44701},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_2859":1218,"_25205":1205,"_5":25537,"_17596":44703,"_23867":44704,"_2386":44705},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_2859":1219,"_25205":1205,"_5":25537,"_17596":44707,"_23867":44708,"_2386":44709},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_2859":1220,"_25205":1205,"_5":25537,"_17596":44711,"_23867":44712,"_2386":44713},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_2859":1221,"_25205":1205,"_5":25537,"_17596":44715,"_23867":44716,"_2386":44717},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_2859":1222,"_25205":1205,"_5":25537,"_17596":44719,"_23867":44720,"_2386":44721},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_2859":1223,"_25205":1205,"_5":25537,"_17596":44723,"_23867":44724,"_2386":44725},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_2859":1224,"_25205":1205,"_5":25537,"_17596":44727,"_23867":44728,"_2386":44729},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_2859":1225,"_25205":1205,"_5":25537,"_17596":44731,"_23867":44732,"_2386":44733},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_2859":1226,"_25205":1205,"_5":25537,"_17596":44735,"_23867":44736,"_2386":44737},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_2859":1227,"_25205":1205,"_17596":44739,"_5":17486,"_23867":1205,"_2386":44740},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_2859":1228,"_25205":1205,"_17596":44742,"_5":17486,"_23867":1205,"_2386":44743},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_2859":1229,"_25205":1205,"_17596":44745,"_5":17486,"_23867":1205,"_2386":44746},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_2859":1230,"_25205":1205,"_17596":44748,"_5":17486,"_23867":44660,"_2386":44749},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_2859":1231,"_25205":1205,"_17596":44751,"_5":17486,"_23867":44660,"_2386":44752},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_2859":1232,"_25205":1205,"_17596":44754,"_5":17486,"_23867":44660,"_2386":44755},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_2859":1233,"_25205":1205,"_17596":44757,"_5":17486,"_23867":44660,"_2386":44758},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_2859":1234,"_25205":1205,"_17596":44760,"_5":17486,"_23867":44664,"_2386":44761},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_2859":1235,"_25205":1205,"_17596":44763,"_5":17486,"_23867":44668,"_2386":44764},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_2859":1236,"_25205":1205,"_17596":44766,"_5":17486,"_23867":44668,"_2386":44767},[],"IAM action",{"_2859":1237,"_25205":1205,"_17596":44769,"_5":17486,"_23867":44668,"_2386":41277},[],{"_2859":1238,"_25205":1205,"_17596":44771,"_5":17486,"_23867":44668,"_2386":44772},[],"`iot:GetRegistrationCode`",{"_2859":1239,"_25205":1205,"_17596":44774,"_5":17486,"_23867":44668,"_2386":44775},[],"Obtain the verification code for CA registration in the Primary Account",{"_2859":1240,"_25205":1205,"_17596":44777,"_5":17486,"_23867":44668,"_2386":44778},[],"`iot:RegisterCACertificate`",{"_2859":1241,"_25205":1205,"_17596":44780,"_5":17486,"_23867":44668,"_2386":44781},[],"Register the CA in AWS IoT",{"_2859":1242,"_25205":1205,"_17596":44783,"_5":17486,"_23867":44668,"_2386":44784},[],"`iot:DescribeCACertificate`",{"_2859":1243,"_25205":1205,"_17596":44786,"_5":17486,"_23867":44668,"_2386":44787},[],"Check the CA registration status",{"_2859":1244,"_25205":1205,"_17596":44789,"_5":17486,"_23867":44668,"_2386":44790},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_2859":1245,"_25205":1205,"_17596":44792,"_5":17486,"_23867":44668,"_2386":44793},[],"Create or update Things in IoT Core",{"_2859":1246,"_25205":1205,"_17596":44795,"_5":17486,"_23867":44668,"_2386":44796},[],"`iot:RegisterThing`",{"_2859":1247,"_25205":1205,"_17596":44798,"_5":17486,"_23867":44668,"_2386":44799},[],"Provision Things through a template",{"_2859":1248,"_25205":1205,"_17596":44801,"_5":17486,"_23867":44668,"_2386":44802},[],"`iot:RegisterCertificate`",{"_2859":1249,"_25205":1205,"_17596":44804,"_5":17486,"_23867":44668,"_2386":44805},[],"Register device certificates",{"_2859":1250,"_25205":1205,"_17596":44807,"_5":17486,"_23867":44668,"_2386":44808},[],"`iot:UpdateCertificate`",{"_2859":1251,"_25205":1205,"_17596":44810,"_5":17486,"_23867":44668,"_2386":44811},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_2859":1252,"_25205":1205,"_17596":44813,"_5":17486,"_23867":44668,"_2386":44814},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_2859":1253,"_25205":1205,"_17596":44816,"_5":17486,"_23867":44668,"_2386":44817},[],"Create and attach IoT policies",{"_2859":1254,"_25205":1205,"_17596":44819,"_5":17486,"_23867":44668,"_2386":44820},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_2859":1255,"_25205":1205,"_17596":44822,"_5":17486,"_23867":44668,"_2386":44823},[],"Manage Thing groups",{"_2859":1256,"_25205":1205,"_17596":44825,"_5":17486,"_23867":44668,"_2386":44826},[],"`iot:CreateProvisioningTemplate`",{"_2859":1257,"_25205":1205,"_17596":44828,"_5":17486,"_23867":44668,"_2386":44829},[],"Create JITP templates",{"_2859":1258,"_25205":1205,"_17596":44831,"_5":17486,"_23867":44668,"_2386":44832},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_2859":1259,"_25205":1205,"_17596":44834,"_5":17486,"_23867":44668,"_2386":44835},[],"Read and write the Device Shadow",{"_2859":1260,"_25205":1205,"_17596":44837,"_5":17486,"_23867":44668,"_2386":44838},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_2859":1261,"_25205":1205,"_17596":44840,"_5":17486,"_23867":44672,"_2386":44841},[],"Parameter",{"_2859":1262,"_25205":1205,"_17596":44843,"_5":17486,"_23867":44672,"_2386":44844},[],"Type",{"_2859":1263,"_25205":1205,"_17596":44846,"_5":17486,"_23867":44672,"_2386":44847},[],"Required",{"_2859":1264,"_25205":1205,"_17596":44849,"_5":17486,"_23867":44672,"_2386":44850},[],"Description",{"_2859":1265,"_25205":1205,"_17596":44852,"_5":17486,"_23867":44672,"_2386":44853},[],"`connector_id`",{"_2859":1266,"_25205":1205,"_17596":44855,"_5":17486,"_23867":44672,"_2386":21016},[],{"_2859":1267,"_25205":1205,"_17596":44857,"_5":17486,"_23867":44672,"_2386":44858},[],"Yes",{"_2859":1268,"_25205":1205,"_17596":44860,"_5":17486,"_23867":44672,"_2386":44861},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_2859":1269,"_25205":1205,"_17596":44863,"_5":17486,"_23867":44672,"_2386":44864},[],"`aws_config.region`",{"_2859":1270,"_25205":1205,"_17596":44866,"_5":17486,"_23867":44672,"_2386":21016},[],{"_2859":1271,"_25205":1205,"_17596":44868,"_5":17486,"_23867":44672,"_2386":44858},[],{"_2859":1272,"_25205":1205,"_17596":44870,"_5":17486,"_23867":44672,"_2386":44871},[],"AWS region where the connector operates.",{"_2859":1273,"_25205":1205,"_17596":44873,"_5":17486,"_23867":44672,"_2386":44874},[],"`aws_config.auth_method`",{"_2859":1274,"_25205":1205,"_17596":44876,"_5":17486,"_23867":44672,"_2386":21016},[],{"_2859":1275,"_25205":1205,"_17596":44878,"_5":17486,"_23867":44672,"_2386":44858},[],{"_2859":1276,"_25205":1205,"_17596":44880,"_5":17486,"_23867":44672,"_2386":44881},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_2859":1277,"_25205":1205,"_17596":44883,"_5":17486,"_23867":44672,"_2386":44884},[],"`aws_config.access_key_id`",{"_2859":1278,"_25205":1205,"_17596":44886,"_5":17486,"_23867":44672,"_2386":21016},[],{"_2859":1279,"_25205":1205,"_17596":44888,"_5":17486,"_23867":44672,"_2386":44889},[],"Only with `auth_method=static`",{"_2859":1280,"_25205":1205,"_17596":44891,"_5":17486,"_23867":44672,"_2386":44892},[],"AWS access key.",{"_2859":1281,"_25205":1205,"_17596":44894,"_5":17486,"_23867":44672,"_2386":44895},[],"`aws_config.secret_access_key`",{"_2859":1282,"_25205":1205,"_17596":44897,"_5":17486,"_23867":44672,"_2386":21016},[],{"_2859":1283,"_25205":1205,"_17596":44899,"_5":17486,"_23867":44672,"_2386":44889},[],{"_2859":1284,"_25205":1205,"_17596":44901,"_5":17486,"_23867":44672,"_2386":44902},[],"AWS secret key.",{"_2859":1285,"_25205":1205,"_17596":44904,"_5":17486,"_23867":44672,"_2386":44905},[],"`aws_config.session_token`",{"_2859":1286,"_25205":1205,"_17596":44907,"_5":17486,"_23867":44672,"_2386":21016},[],{"_2859":1287,"_25205":1205,"_17596":44909,"_5":17486,"_23867":44672,"_2386":44910},[],"No",{"_2859":1288,"_25205":1205,"_17596":44912,"_5":17486,"_23867":44672,"_2386":44913},[],"Session token (with `auth_method=static`).",{"_2859":1289,"_25205":1205,"_17596":44915,"_5":17486,"_23867":44672,"_2386":44916},[],"`aws_config.role_arn`",{"_2859":1290,"_25205":1205,"_17596":44918,"_5":17486,"_23867":44672,"_2386":21016},[],{"_2859":1291,"_25205":1205,"_17596":44920,"_5":17486,"_23867":44672,"_2386":44921},[],"Only with `auth_method=role`",{"_2859":1292,"_25205":1205,"_17596":44923,"_5":17486,"_23867":44672,"_2386":44924},[],"ARN of the role to assume.",{"_2859":1293,"_25205":1205,"_17596":44926,"_5":17486,"_23867":44672,"_2386":44927},[],"`aws_config.endpoint_url`",{"_2859":1294,"_25205":1205,"_17596":44929,"_5":17486,"_23867":44672,"_2386":21016},[],{"_2859":1295,"_25205":1205,"_17596":44931,"_5":17486,"_23867":44672,"_2386":44910},[],{"_2859":1296,"_25205":1205,"_17596":44933,"_5":17486,"_23867":44672,"_2386":44934},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_2859":1297,"_25205":1205,"_17596":44936,"_5":17486,"_23867":44672,"_2386":44937},[],"`subscriber_event_bus`",{"_2859":1298,"_25205":1205,"_17596":44939,"_5":17486,"_23867":44672,"_2386":14749},[],{"_2859":1299,"_25205":1205,"_17596":44941,"_5":17486,"_23867":44672,"_2386":44858},[],{"_2859":1300,"_25205":1205,"_17596":44943,"_5":17486,"_23867":44672,"_2386":44944},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_2859":1301,"_25205":1205,"_17596":44946,"_5":17486,"_23867":44672,"_2386":44947},[],"`dms_manager_client`",{"_2859":1302,"_25205":1205,"_17596":44949,"_5":17486,"_23867":44672,"_2386":21016},[],{"_2859":1303,"_25205":1205,"_17596":44951,"_5":17486,"_23867":44672,"_2386":44858},[],{"_2859":1304,"_25205":1205,"_17596":44953,"_5":17486,"_23867":44672,"_2386":44954},[],"HTTP URL of Lamassu's DMS Manager service.",{"_2859":1305,"_25205":1205,"_17596":44956,"_5":17486,"_23867":44672,"_2386":44957},[],"`device_manager_client`",{"_2859":1306,"_25205":1205,"_17596":44959,"_5":17486,"_23867":44672,"_2386":21016},[],{"_2859":1307,"_25205":1205,"_17596":44961,"_5":17486,"_23867":44672,"_2386":44858},[],{"_2859":1308,"_25205":1205,"_17596":44963,"_5":17486,"_23867":44672,"_2386":44964},[],"HTTP URL of Lamassu's Device Manager.",{"_2859":1309,"_25205":1205,"_17596":44966,"_5":17486,"_23867":44672,"_2386":44967},[],"`ca_client`",{"_2859":1310,"_25205":1205,"_17596":44969,"_5":17486,"_23867":44672,"_2386":21016},[],{"_2859":1311,"_25205":1205,"_17596":44971,"_5":17486,"_23867":44672,"_2386":44858},[],{"_2859":1312,"_25205":1205,"_17596":44973,"_5":17486,"_23867":44672,"_2386":44974},[],"HTTP URL of Lamassu's CA service.",{"_2859":1313,"_25205":1205,"_17596":44976,"_5":17486,"_23867":44676,"_2386":44977},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_2859":1314,"_25205":1205,"_17596":44979,"_5":17486,"_23867":44680,"_2386":44980},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_2859":1315,"_25205":1205,"_17596":44982,"_5":17486,"_23867":44680,"_2386":44983},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_2859":1316,"_25205":1205,"_17596":44985,"_5":17486,"_23867":44684,"_2386":44986},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_2859":1317,"_25205":1205,"_17596":44988,"_5":17486,"_23867":44684,"_2386":44989},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_2859":1318,"_25205":1205,"_17596":44991,"_5":17486,"_23867":44684,"_2386":44992},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_2859":1319,"_25205":1205,"_17596":44994,"_5":17486,"_23867":44684,"_2386":44995},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_2859":1320,"_25205":1205,"_17596":44997,"_5":17486,"_23867":44684,"_2386":44998},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_2859":1321,"_25205":1205,"_17596":45000,"_5":17486,"_23867":44684,"_2386":45001},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_2859":1322,"_25205":1205,"_17596":45003,"_5":17486,"_23867":44688,"_2386":45004},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_2859":1323,"_25205":1205,"_17596":45006,"_5":17486,"_23867":44692,"_2386":45007},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_2859":1324,"_25205":1205,"_17596":45009,"_5":17486,"_23867":44692,"_2386":45010},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_2859":1325,"_25205":1205,"_17596":45012,"_5":17486,"_23867":44696,"_2386":45013},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_2859":1326,"_25205":1205,"_17596":45015,"_5":17486,"_23867":44700,"_2386":45016},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_2859":1327,"_25205":1205,"_17596":45018,"_5":17486,"_23867":44700,"_2386":45019},[],"Creates or updates the IoT policies configured in the DMS.",{"_2859":1328,"_25205":1205,"_17596":45021,"_5":17486,"_23867":44700,"_2386":45022},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_2859":1329,"_25205":1205,"_17596":45024,"_5":17486,"_23867":44700,"_2386":45025},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_2859":1330,"_25205":1205,"_17596":45027,"_5":17486,"_23867":44700,"_2386":45028},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_2859":1331,"_25205":1205,"_17596":45030,"_5":17486,"_23867":44700,"_2386":45031},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_2859":1332,"_25205":1205,"_17596":45033,"_5":17486,"_23867":44700,"_2386":45034},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_2859":1333,"_25205":1205,"_17596":45036,"_5":17486,"_23867":44704,"_2386":45037},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_2859":1334,"_25205":1205,"_17596":45039,"_5":17486,"_23867":44704,"_2386":45040},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_2859":1335,"_25205":1205,"_17596":45042,"_5":17486,"_23867":44704,"_2386":45043},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_2859":1336,"_25205":1205,"_17596":45045,"_5":17486,"_23867":44708,"_2386":45046},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_2859":1337,"_25205":1205,"_17596":45048,"_5":17486,"_23867":44708,"_2386":45049},[],"The full flow from the device's perspective is:",{"_2859":1338,"_25205":1205,"_17596":45051,"_5":17486,"_23867":44708,"_2386":45052},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_2859":1339,"_25205":1205,"_17596":45054,"_5":17486,"_23867":44712,"_2386":45055},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_2859":1340,"_25205":1205,"_17596":45057,"_5":17486,"_23867":44712,"_2386":45058},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_2859":1341,"_25205":1205,"_17596":45060,"_5":17486,"_23867":44712,"_2386":45061},[],"For the JITP flow to work correctly:",{"_2859":1342,"_25205":1205,"_17596":45063,"_5":17486,"_23867":44712,"_2386":45064},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_2859":1343,"_25205":1205,"_17596":45066,"_5":17486,"_23867":44712,"_2386":45067},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_2859":1344,"_25205":1205,"_17596":45069,"_5":17486,"_23867":44712,"_2386":45070},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_2859":1345,"_25205":1205,"_17596":45072,"_5":17486,"_23867":44712,"_2386":45073},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_2859":1346,"_25205":1205,"_17596":45075,"_5":17486,"_23867":44716,"_2386":45076},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_2859":1347,"_25205":1205,"_17596":45078,"_5":17486,"_23867":44716,"_2386":45079},[],"Status in Lamassu",{"_2859":1348,"_25205":1205,"_17596":45081,"_5":17486,"_23867":44716,"_2386":45082},[],"Revocation reason",{"_2859":1349,"_25205":1205,"_17596":45084,"_5":17486,"_23867":44716,"_2386":45085},[],"Status in AWS IoT Core",{"_2859":1350,"_25205":1205,"_17596":45087,"_5":17486,"_23867":44716,"_2386":45088},[],"`Active`",{"_2859":1351,"_25205":1205,"_17596":45090,"_5":17486,"_23867":44716,"_2386":45091},[],"None",{"_2859":1352,"_25205":1205,"_17596":45093,"_5":17486,"_23867":44716,"_2386":45094},[],"`ACTIVE`",{"_2859":1353,"_25205":1205,"_17596":45096,"_5":17486,"_23867":44716,"_2386":45097},[],"`Revoked`",{"_2859":1354,"_25205":1205,"_17596":45099,"_5":17486,"_23867":44716,"_2386":45100},[],"`certificateHold`",{"_2859":1355,"_25205":1205,"_17596":45102,"_5":17486,"_23867":44716,"_2386":45103},[],"`INACTIVE`",{"_2859":1356,"_25205":1205,"_17596":45105,"_5":17486,"_23867":44716,"_2386":45097},[],{"_2859":1357,"_25205":1205,"_17596":45107,"_5":17486,"_23867":44716,"_2386":45108},[],"Any other reason",{"_2859":1358,"_25205":1205,"_17596":45110,"_5":17486,"_23867":44716,"_2386":45111},[],"`REVOKED`",{"_2859":1359,"_25205":1205,"_17596":45113,"_5":17486,"_23867":44716,"_2386":45114},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_2859":1360,"_25205":1205,"_17596":45116,"_5":17486,"_23867":44720,"_2386":45117},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_2859":1361,"_25205":1205,"_17596":45119,"_5":17486,"_23867":44720,"_2386":45120},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_2859":1362,"_25205":1205,"_17596":45122,"_5":17486,"_23867":44720,"_2386":45123},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_2859":1363,"_25205":1205,"_17596":45125,"_5":17486,"_23867":44724,"_2386":45126},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_2859":1364,"_25205":1205,"_17596":45128,"_5":17486,"_23867":44724,"_2386":45129},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_2859":1365,"_25205":1205,"_17596":45131,"_5":17486,"_23867":44728,"_2386":45132},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_2859":1366,"_25205":1205,"_17596":45134,"_5":17486,"_23867":44728,"_2386":45135},[],"There are two action types:",{"_2859":1367,"_25205":1205,"_17596":45137,"_5":17486,"_23867":44728,"_2386":45138},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_2859":1368,"_25205":1205,"_17596":45140,"_5":17486,"_23867":44728,"_2386":45141},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_2859":1369,"_25205":1205,"_17596":45143,"_5":17486,"_23867":44728,"_2386":45144},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_2859":1370,"_25205":1205,"_17596":45146,"_5":17486,"_23867":44732,"_2386":45147},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_2859":1371,"_25205":1205,"_17596":45149,"_5":17486,"_23867":44732,"_2386":45150},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_2859":1372,"_25205":1205,"_17596":45152,"_5":17486,"_23867":44732,"_2386":45153},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_2859":1373,"_25205":1205,"_17596":45155,"_5":17486,"_23867":44736,"_2386":45156},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_2859":1374,"_25205":1205,"_17596":45158,"_5":17486,"_23867":44736,"_2386":45159},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_2859":1375,"_25205":1205,"_17596":45161,"_5":17486,"_23867":44736,"_2386":45162},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_2859":1376,"_25205":1205,"_17596":45164,"_5":17486,"_23867":44736,"_2386":45165},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_2859":1377,"_25205":1205,"_17596":45167,"_5":17486,"_23867":44736,"_2386":45168},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_2859":1378,"_25205":1205,"_17596":45170,"_5":17486,"_23867":44736,"_2386":45171},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_2859":1379,"_25205":1205,"_17596":45173,"_5":17486,"_23867":44736,"_2386":45174},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_2859":1380,"_25205":1205,"_17596":45176,"_5":17486,"_23867":44736,"_2386":45177},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_2859":1381,"_25205":1205,"_17596":45179,"_5":17486,"_23867":44736,"_2386":45180},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_2859":1382,"_25205":1205,"_17596":45182,"_5":17486,"_23867":44736,"_2386":45183},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_2859":1383,"_25205":1205,"_17596":45185,"_5":17486,"_23867":44736,"_2386":45186},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_2859":1384,"_25205":1205,"_17596":45188,"_5":17486,"_23867":44736,"_2386":45189},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_2859":1385,"_25205":1205,"_17596":45191,"_5":17486,"_23867":44736,"_2386":45192},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_2859":1386,"_25205":1205,"_17596":45194,"_5":17486,"_23867":44736,"_2386":45195},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_2859":1387,"_25205":1205,"_17596":45197,"_5":17486,"_23867":44736,"_2386":45198},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_2859":1388,"_25205":1205,"_17596":45200,"_5":17486,"_23867":44736,"_2386":45201},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_2859":1389,"_25205":1205,"_17596":45203,"_5":17486,"_23867":44736,"_2386":45204},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_2859":1390,"_25205":1205,"_17596":45206,"_5":17486,"_23867":44736,"_2386":45207},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_2859":1391,"_25205":1205,"_17596":45209,"_5":17486,"_23867":44736,"_2386":45210},[],"**Symptom:** After editing a DMS in `jitp` mode, messages about that DMS update appear in the `lamassu-dlq` poison queue.",{"_2859":1392,"_25205":1205,"_17596":45212,"_5":17486,"_23867":44736,"_2386":45213},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`.",{"_2859":1393,"_25205":1205,"_17596":45215,"_5":17486,"_23867":44736,"_2386":45216},[],"**Resolution:** Verify the template named after the DMS ID still exists in AWS IoT Core and that JITP enrollment works. The `lamassu-dlq` message reflects the failed re-creation attempt, not a broken JITP flow.",{"_2859":1394,"_25205":1205,"_17596":45218,"_5":17486,"_23867":44736,"_2386":45219},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2859":1395,"_25205":1205,"_17596":45221,"_5":17486,"_23867":44736,"_2386":45222},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2859":1396,"_25205":1205,"_17596":45224,"_5":17486,"_23867":44736,"_2386":45225},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_2859":1397,"_25205":1397,"_5":12316,"_2386":43212,"_25540":45227,"_17596":45228,"_23867":1397},[40894,42238,43212],[],{"_2859":1398,"_25205":1397,"_17596":45230,"_5":17486,"_23867":1397,"_2386":45231},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_2859":1399,"_25205":1397,"_5":25537,"_17596":45233,"_23867":45234,"_2386":45235},[],"/docs/pr-preview/pr-43/platform/iot-fleets/overview#start-here","Start here",{"_2859":1400,"_25205":1397,"_5":25537,"_17596":45237,"_23867":45238,"_2386":43210},[],"/docs/pr-preview/pr-43/platform/iot-fleets/overview#devices-and-identities",{"_2859":1401,"_25205":1397,"_5":25537,"_17596":45240,"_23867":45241,"_2386":43393},[],"/docs/pr-preview/pr-43/platform/iot-fleets/overview#enrollment-with-pki",{"_2859":1402,"_25205":1397,"_5":25537,"_17596":45243,"_23867":45244,"_2386":44653},[],"/docs/pr-preview/pr-43/platform/iot-fleets/overview#integrations",{"_2859":1403,"_25205":1397,"_5":25537,"_17596":45246,"_23867":45247,"_2386":45248},[],"/docs/pr-preview/pr-43/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_2859":1404,"_25205":1397,"_17596":45250,"_5":17486,"_23867":1397,"_2386":45251},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_2859":1405,"_25205":1397,"_17596":45253,"_5":17486,"_23867":45234,"_2386":45254},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_2859":1406,"_25205":1397,"_17596":45256,"_5":17486,"_23867":45234,"_2386":45257},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_2859":1407,"_25205":1397,"_17596":45259,"_5":17486,"_23867":45238,"_2386":45260},[],"Resource",{"_2859":1408,"_25205":1397,"_17596":45262,"_5":17486,"_23867":45238,"_2386":45263},[],"What it represents",{"_2859":1409,"_25205":1397,"_17596":45265,"_5":17486,"_23867":45238,"_2386":45266},[],"**Device**",{"_2859":1410,"_25205":1397,"_17596":45268,"_5":17486,"_23867":45238,"_2386":45269},[],"An inventory entry with an identifier, owning DMS and classification.",{"_2859":1411,"_25205":1397,"_17596":45271,"_5":17486,"_23867":45238,"_2386":45272},[],"**Identity**",{"_2859":1412,"_25205":1397,"_17596":45274,"_5":17486,"_23867":45238,"_2386":45275},[],"The device's association with its certificates: an active version and a history.",{"_2859":1413,"_25205":1397,"_17596":45277,"_5":17486,"_23867":45238,"_2386":45278},[],"**DMS**",{"_2859":1414,"_25205":1397,"_17596":45280,"_5":17486,"_23867":45238,"_2386":45281},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_2859":1415,"_25205":1397,"_17596":45283,"_5":17486,"_23867":45238,"_2386":45284},[],"**Fleet**",{"_2859":1416,"_25205":1397,"_17596":45286,"_5":17486,"_23867":45238,"_2386":45287},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_2859":1417,"_25205":1397,"_17596":45289,"_5":17486,"_23867":45238,"_2386":45290},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_2859":1418,"_25205":1397,"_17596":45292,"_5":17486,"_23867":45238,"_2386":45293},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_2859":1419,"_25205":1397,"_17596":45295,"_5":17486,"_23867":45241,"_2386":45296},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_2859":1420,"_25205":1397,"_17596":45298,"_5":17486,"_23867":45241,"_2386":45299},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_2859":1421,"_25205":1397,"_17596":45301,"_5":17486,"_23867":45241,"_2386":45302},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_2859":1422,"_25205":1397,"_17596":45304,"_5":17486,"_23867":45241,"_2386":45305},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_2859":1423,"_25205":1397,"_17596":45307,"_5":17486,"_23867":45241,"_2386":45308},[],"**Result:** request the certificate, install it and check its association with the device.",{"_2859":1424,"_25205":1397,"_17596":45310,"_5":17486,"_23867":45241,"_2386":45311},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_2859":1425,"_25205":1397,"_17596":45313,"_5":17486,"_23867":45241,"_2386":45314},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2859":1426,"_25205":1397,"_17596":45316,"_5":17486,"_23867":45241,"_2386":45317},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2859":1427,"_25205":1397,"_17596":45319,"_5":17486,"_23867":45244,"_2386":45320},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_2859":1428,"_25205":1397,"_17596":45322,"_5":17486,"_23867":45244,"_2386":45323},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_2859":1429,"_25205":1397,"_17596":45325,"_5":17486,"_23867":45247,"_2386":45326},[],"Participant",{"_2859":1430,"_25205":1397,"_17596":45328,"_5":17486,"_23867":45247,"_2386":45329},[],"Responsibility",{"_2859":1431,"_25205":1397,"_17596":45331,"_5":17486,"_23867":45247,"_2386":45332},[],"PKI administrator",{"_2859":1432,"_25205":1397,"_17596":45334,"_5":17486,"_23867":45247,"_2386":45335},[],"CA, issuance profile, chain and revocation publication.",{"_2859":1433,"_25205":1397,"_17596":45337,"_5":17486,"_23867":45247,"_2386":45338},[],"Provisioning administrator",{"_2859":1434,"_25205":1397,"_17596":45340,"_5":17486,"_23867":45247,"_2386":45341},[],"DMS, admission, authentication per operation and inventory.",{"_2859":1435,"_25205":1397,"_17596":45343,"_5":17486,"_23867":45247,"_2386":45344},[],"Device integrator",{"_2859":1436,"_25205":1397,"_17596":45346,"_5":17486,"_23867":45247,"_2386":45347},[],"Initial credential, key, EST client, trust and certificate installation.",{"_2859":1437,"_25205":1397,"_17596":45349,"_5":17486,"_23867":45247,"_2386":45350},[],"Consumer integrator",{"_2859":1438,"_25205":1397,"_17596":45352,"_5":17486,"_23867":45247,"_2386":45353},[],"Trusted issuers, validation and device permissions in the destination.",{"_2859":1439,"_25205":1397,"_17596":45355,"_5":17486,"_23867":45247,"_2386":45356},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_2859":1440,"_25205":1440,"_5":12316,"_2386":45358,"_25540":45359,"_17596":45361,"_23867":1440},"Enroll and connect your first device",[40894,42238,43212,45360],"Getting started",[],{"_2859":1441,"_25205":1440,"_17596":45363,"_5":17486,"_23867":1440,"_2386":45364},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_2859":1442,"_25205":1440,"_5":25537,"_17596":45366,"_23867":45367,"_2386":40904},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_2859":1443,"_25205":1440,"_5":25537,"_17596":45369,"_23867":45370,"_2386":45371},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_2859":1444,"_25205":1440,"_5":25537,"_17596":45373,"_23867":45374,"_2386":45375},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_2859":1445,"_25205":1440,"_5":25537,"_17596":45377,"_23867":45378,"_2386":45379},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_2859":1446,"_25205":1440,"_5":25537,"_17596":45381,"_23867":45382,"_2386":45383},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_2859":1447,"_25205":1440,"_5":25537,"_17596":45385,"_23867":45386,"_2386":45387},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_2859":1448,"_25205":1440,"_5":25537,"_17596":45389,"_23867":45390,"_2386":45391},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_2859":1449,"_25205":1440,"_5":25537,"_17596":45393,"_23867":45394,"_2386":45395},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_2859":1450,"_25205":1440,"_17596":45397,"_5":17486,"_23867":1440,"_2386":45398},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_2859":1451,"_25205":1440,"_17596":45400,"_5":17486,"_23867":45367,"_2386":45401},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_2859":1452,"_25205":1440,"_17596":45403,"_5":17486,"_23867":45367,"_2386":45404},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_2859":1453,"_25205":1440,"_17596":45406,"_5":17486,"_23867":45367,"_2386":45407},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_2859":1454,"_25205":1440,"_17596":45409,"_5":17486,"_23867":45367,"_2386":45410},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_2859":1455,"_25205":1440,"_17596":45412,"_5":17486,"_23867":45367,"_2386":45413},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_2859":1456,"_25205":1440,"_17596":45415,"_5":17486,"_23867":45370,"_2386":45416},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_2859":1457,"_25205":1440,"_17596":45418,"_5":17486,"_23867":45370,"_2386":45419},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_2859":1458,"_25205":1440,"_17596":45421,"_5":17486,"_23867":45374,"_2386":45422},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_2859":1459,"_25205":1440,"_17596":45424,"_5":17486,"_23867":45374,"_2386":45425},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_2859":1460,"_25205":1440,"_17596":45427,"_5":17486,"_23867":45374,"_2386":45428},[],"Setting",{"_2859":1461,"_25205":1440,"_17596":45430,"_5":17486,"_23867":45374,"_2386":45431},[],"Evaluation value",{"_2859":1462,"_25205":1440,"_17596":45433,"_5":17486,"_23867":45374,"_2386":45434},[],"Enrollment CA",{"_2859":1463,"_25205":1440,"_17596":45436,"_5":17486,"_23867":45374,"_2386":45437},[],"Issuing root from `device-root.pem`.",{"_2859":1464,"_25205":1440,"_17596":45439,"_5":17486,"_23867":45374,"_2386":43523},[],{"_2859":1465,"_25205":1440,"_17596":45441,"_5":17486,"_23867":45374,"_2386":45442},[],"The 1-hour leaf profile you just prepared.",{"_2859":1466,"_25205":1440,"_17596":45444,"_5":17486,"_23867":45374,"_2386":45445},[],"Protocol / Registration Mode",{"_2859":1467,"_25205":1440,"_17596":45447,"_5":17486,"_23867":45374,"_2386":45448},[],"`EST_RFC7030` / `JITP`.",{"_2859":1468,"_25205":1440,"_17596":45450,"_5":17486,"_23867":45374,"_2386":45451},[],"Verify CSR Signature",{"_2859":1469,"_25205":1440,"_17596":45453,"_5":17486,"_23867":45374,"_2386":45454},[],"Enabled.",{"_2859":1470,"_25205":1440,"_17596":45456,"_5":17486,"_23867":45374,"_2386":45457},[],"Enable Replaceable Enrollment",{"_2859":1471,"_25205":1440,"_17596":45459,"_5":17486,"_23867":45374,"_2386":45460},[],"Disabled; the ID must be new.",{"_2859":1472,"_25205":1440,"_17596":45462,"_5":17486,"_23867":45374,"_2386":45463},[],"Initial authentication",{"_2859":1473,"_25205":1440,"_17596":45465,"_5":17486,"_23867":45374,"_2386":45466},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_2859":1474,"_25205":1440,"_17596":45468,"_5":17486,"_23867":45374,"_2386":45469},[],"Renewal authentication",{"_2859":1475,"_25205":1440,"_17596":45471,"_5":17486,"_23867":45374,"_2386":45472},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_2859":1476,"_25205":1440,"_17596":45474,"_5":17486,"_23867":45374,"_2386":45475},[],"Additional Validation CAs / Enable Expired Renewal",{"_2859":1477,"_25205":1440,"_17596":45477,"_5":17486,"_23867":45374,"_2386":45478},[],"Empty list for this direct issuance / disabled.",{"_2859":1478,"_25205":1440,"_17596":45480,"_5":17486,"_23867":45374,"_2386":45481},[],"Re-enrollment Delta",{"_2859":1479,"_25205":1440,"_17596":45483,"_5":17486,"_23867":45374,"_2386":45484},[],"1 hour.",{"_2859":1480,"_25205":1440,"_17596":45486,"_5":17486,"_23867":45374,"_2386":45487},[],"Preventive / Critical Delta",{"_2859":1481,"_25205":1440,"_17596":45489,"_5":17486,"_23867":45374,"_2386":45490},[],"30 minutes / 10 minutes.",{"_2859":1482,"_25205":1440,"_17596":45492,"_5":17486,"_23867":45374,"_2386":45493},[],"Revoke on Re-enrollment",{"_2859":1483,"_25205":1440,"_17596":45495,"_5":17486,"_23867":45374,"_2386":45496},[],"Disabled to test the successor before retiring the previous identity.",{"_2859":1484,"_25205":1440,"_17596":45498,"_5":17486,"_23867":45374,"_2386":43531},[],{"_2859":1485,"_25205":1440,"_17596":45500,"_5":17486,"_23867":45374,"_2386":45501},[],"Disabled; the operational key is generated in the client.",{"_2859":1486,"_25205":1440,"_17596":45503,"_5":17486,"_23867":45374,"_2386":45504},[],"CA Distribution",{"_2859":1487,"_25205":1440,"_17596":45506,"_5":17486,"_23867":45374,"_2386":45507},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_2859":1488,"_25205":1440,"_17596":45509,"_5":17486,"_23867":45374,"_2386":45510},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. If your console does not expose the independent block, configure and check the resource through the DMS API and DMS guide.",{"_2859":1489,"_25205":1440,"_17596":45512,"_5":17486,"_23867":45378,"_2386":45513},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_2859":1490,"_25205":1440,"_17596":45515,"_5":17486,"_23867":45378,"_2386":45516},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_2859":1491,"_25205":1440,"_17596":45518,"_5":17486,"_23867":45382,"_2386":45519},[],"Generate a new key and CSR with the selected identifier:",{"_2859":1492,"_25205":1440,"_17596":45521,"_5":17486,"_23867":45382,"_2386":45522},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_2859":1493,"_25205":1440,"_17596":45524,"_5":17486,"_23867":45382,"_2386":45525},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_2859":1494,"_25205":1440,"_17596":45527,"_5":17486,"_23867":45386,"_2386":45528},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_2859":1495,"_25205":1440,"_17596":45530,"_5":17486,"_23867":45386,"_2386":45531},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_2859":1496,"_25205":1440,"_17596":45533,"_5":17486,"_23867":45390,"_2386":45534},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_2859":1497,"_25205":1440,"_17596":45536,"_5":17486,"_23867":45390,"_2386":45537},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_2859":1498,"_25205":1440,"_17596":45539,"_5":17486,"_23867":45390,"_2386":45540},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_2859":1499,"_25205":1440,"_17596":45542,"_5":17486,"_23867":45390,"_2386":45543},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_2859":1500,"_25205":1440,"_17596":45545,"_5":17486,"_23867":45390,"_2386":45546},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_2859":1501,"_25205":1440,"_17596":45548,"_5":17486,"_23867":45394,"_2386":45549},[],"Check",{"_2859":1502,"_25205":1440,"_17596":45551,"_5":17486,"_23867":45394,"_2386":45552},[],"Expected result",{"_2859":1503,"_25205":1440,"_17596":45554,"_5":17486,"_23867":45394,"_2386":45555},[],"Registration",{"_2859":1504,"_25205":1440,"_17596":45557,"_5":17486,"_23867":45394,"_2386":45558},[],"ID created automatically and correct DMS.",{"_2859":1505,"_25205":1440,"_17596":45560,"_5":17486,"_23867":45394,"_2386":45561},[],"Certificate",{"_2859":1506,"_25205":1440,"_17596":45563,"_5":17486,"_23867":45394,"_2386":45564},[],"CN, profile, serial and key verified.",{"_2859":1507,"_25205":1440,"_17596":45566,"_5":17486,"_23867":45394,"_2386":45567},[],"Inventory",{"_2859":1508,"_25205":1440,"_17596":45569,"_5":17486,"_23867":45394,"_2386":45570},[],"Received serial visible as the current identity and in history.",{"_2859":1509,"_25205":1440,"_17596":45572,"_5":17486,"_23867":45394,"_2386":45573},[],"Consumer",{"_2859":1510,"_25205":1440,"_17596":45575,"_5":17486,"_23867":45394,"_2386":45576},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_2859":1511,"_25205":1440,"_17596":45578,"_5":17486,"_23867":45394,"_2386":45579},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_2859":1512,"_25205":1440,"_17596":45581,"_5":17486,"_23867":45394,"_2386":45582},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_2859":1513,"_25205":1513,"_5":12316,"_2386":43228,"_25540":45584,"_17596":45585,"_23867":1513},[40894,42238,43212,45360],[],{"_2859":1514,"_25205":1513,"_17596":45587,"_5":17486,"_23867":1513,"_2386":45588},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_2859":1515,"_25205":1513,"_5":25537,"_17596":45590,"_23867":45591,"_2386":40904},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_2859":1516,"_25205":1513,"_5":25537,"_17596":45593,"_23867":45594,"_2386":45595},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_2859":1517,"_25205":1513,"_5":25537,"_17596":45597,"_23867":45598,"_2386":45599},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_2859":1518,"_25205":1513,"_5":25537,"_17596":45601,"_23867":45602,"_2386":45603},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_2859":1519,"_25205":1513,"_5":25537,"_17596":45605,"_23867":45606,"_2386":45607},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_2859":1520,"_25205":1513,"_5":25537,"_17596":45609,"_23867":45610,"_2386":45611},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_2859":1521,"_25205":1513,"_5":25537,"_17596":45613,"_23867":45614,"_2386":45552},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#expected-result",{"_2859":1522,"_25205":1513,"_5":25537,"_17596":45616,"_23867":45617,"_2386":45618},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_2859":1523,"_25205":1513,"_5":25537,"_17596":45620,"_23867":45621,"_2386":45622},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_2859":1524,"_25205":1513,"_17596":45624,"_5":17486,"_23867":1513,"_2386":45625},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_2859":1525,"_25205":1513,"_17596":45627,"_5":17486,"_23867":1513,"_2386":45628},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_2859":1526,"_25205":1513,"_17596":45630,"_5":17486,"_23867":45591,"_2386":45631},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_2859":1527,"_25205":1513,"_17596":45633,"_5":17486,"_23867":45591,"_2386":45634},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_2859":1528,"_25205":1513,"_17596":45636,"_5":17486,"_23867":45591,"_2386":45637},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_2859":1529,"_25205":1513,"_17596":45639,"_5":17486,"_23867":45591,"_2386":45640},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_2859":1530,"_25205":1513,"_17596":45642,"_5":17486,"_23867":45594,"_2386":45643},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_2859":1531,"_25205":1513,"_17596":45645,"_5":17486,"_23867":45594,"_2386":45646},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_2859":1532,"_25205":1513,"_17596":45648,"_5":17486,"_23867":45594,"_2386":45649},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_2859":1533,"_25205":1513,"_17596":45651,"_5":17486,"_23867":45594,"_2386":45652},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_2859":1534,"_25205":1513,"_17596":45654,"_5":17486,"_23867":45594,"_2386":45655},[],"Set **Authentication Mode** to `CLIENT_CERTIFICATE` and add the CA whose initial certificates you will accept in **Validation CAs**. For this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and server key generation disabled if you will not use it.",{"_2859":1535,"_25205":1513,"_17596":45657,"_5":17486,"_23867":45594,"_2386":45658},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_2859":1536,"_25205":1513,"_17596":45660,"_5":17486,"_23867":45594,"_2386":45661},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_2859":1537,"_25205":1513,"_17596":45663,"_5":17486,"_23867":45594,"_2386":45664},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_2859":1538,"_25205":1513,"_17596":45666,"_5":17486,"_23867":45598,"_2386":45667},[],"Open **Managed Devices** and the registration action. Complete:",{"_2859":1539,"_25205":1513,"_17596":45669,"_5":17486,"_23867":45598,"_2386":45670},[],"**Device ID**: `device-001`.",{"_2859":1540,"_25205":1513,"_17596":45672,"_5":17486,"_23867":45598,"_2386":45673},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_2859":1541,"_25205":1513,"_17596":45675,"_5":17486,"_23867":45598,"_2386":45676},[],"**Icon** and **Tags**: optional classification.",{"_2859":1542,"_25205":1513,"_17596":45678,"_5":17486,"_23867":45598,"_2386":45679},[],"Confirm registration.",{"_2859":1543,"_25205":1513,"_17596":45681,"_5":17486,"_23867":45602,"_2386":45682},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_2859":1544,"_25205":1513,"_17596":45684,"_5":17486,"_23867":45602,"_2386":45685},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_2859":1545,"_25205":1513,"_17596":45687,"_5":17486,"_23867":45606,"_2386":45688},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_2859":1546,"_25205":1513,"_17596":45690,"_5":17486,"_23867":45606,"_2386":45691},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_2859":1547,"_25205":1513,"_17596":45693,"_5":17486,"_23867":45610,"_2386":45694},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_2859":1548,"_25205":1513,"_17596":45696,"_5":17486,"_23867":45610,"_2386":45697},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_2859":1549,"_25205":1513,"_17596":45699,"_5":17486,"_23867":45614,"_2386":45549},[],{"_2859":1550,"_25205":1513,"_17596":45701,"_5":17486,"_23867":45614,"_2386":45702},[],"Result",{"_2859":1551,"_25205":1513,"_17596":45704,"_5":17486,"_23867":45614,"_2386":45705},[],"Device",{"_2859":1552,"_25205":1513,"_17596":45707,"_5":17486,"_23867":45614,"_2386":45708},[],"`device-001` appears in inventory with the expected DMS.",{"_2859":1553,"_25205":1513,"_17596":45710,"_5":17486,"_23867":45614,"_2386":45711},[],"Current identity",{"_2859":1554,"_25205":1513,"_17596":45713,"_5":17486,"_23867":45614,"_2386":45714},[],"The associated certificate matches the one you verified in PKI.",{"_2859":1555,"_25205":1513,"_17596":45716,"_5":17486,"_23867":45614,"_2386":45717},[],"History",{"_2859":1556,"_25205":1513,"_17596":45719,"_5":17486,"_23867":45614,"_2386":45720},[],"The associated issuance appears with its serial number and dates.",{"_2859":1557,"_25205":1513,"_17596":45722,"_5":17486,"_23867":45614,"_2386":45723},[],"Key and certificate",{"_2859":1558,"_25205":1513,"_17596":45725,"_5":17486,"_23867":45614,"_2386":45726},[],"You have the verified pair ready to install on the device.",{"_2859":1559,"_25205":1513,"_17596":45728,"_5":17486,"_23867":45617,"_2386":45729},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_2859":1560,"_25205":1513,"_17596":45731,"_5":17486,"_23867":45617,"_2386":45732},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_2859":1561,"_25205":1513,"_17596":45734,"_5":17486,"_23867":45617,"_2386":45735},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_2859":1562,"_25205":1513,"_17596":45737,"_5":17486,"_23867":45617,"_2386":45738},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_2859":1563,"_25205":1513,"_17596":45740,"_5":17486,"_23867":45621,"_2386":45741},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_2859":1564,"_25205":1513,"_17596":45743,"_5":17486,"_23867":45621,"_2386":45744},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_2859":1565,"_25205":1513,"_17596":45746,"_5":17486,"_23867":45621,"_2386":45747},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_2859":1566,"_25205":1566,"_5":12316,"_2386":45749,"_25540":45750,"_17596":45751,"_23867":1566},"Lamassu IoT Platform",[40894,42238],[],{"_2859":1567,"_25205":1566,"_17596":45753,"_5":17486,"_23867":1566,"_2386":45754},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_2859":1568,"_25205":1566,"_5":25537,"_17596":45756,"_23867":45757,"_2386":45235},[],"/docs/pr-preview/pr-43/platform/overview#start-here",{"_2859":1569,"_25205":1566,"_5":25537,"_17596":45759,"_23867":45760,"_2386":45761},[],"/docs/pr-preview/pr-43/platform/overview#choose-your-path","Choose your path",{"_2859":1570,"_25205":1566,"_5":25537,"_17596":45763,"_23867":45764,"_2386":45765},[],"/docs/pr-preview/pr-43/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_2859":1571,"_25205":1566,"_5":25537,"_17596":45767,"_23867":45768,"_2386":45769},[],"/docs/pr-preview/pr-43/platform/overview#core-capabilities","Core capabilities",{"_2859":1572,"_25205":1566,"_5":25537,"_17596":45771,"_23867":45772,"_2386":45773},[],"/docs/pr-preview/pr-43/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_2859":1573,"_25205":1566,"_5":25537,"_17596":45775,"_23867":45776,"_2386":45777},[],"/docs/pr-preview/pr-43/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_2859":1574,"_25205":1566,"_5":25537,"_17596":45779,"_23867":45780,"_2386":45781},[],"/docs/pr-preview/pr-43/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_2859":1575,"_25205":1566,"_5":25537,"_17596":45783,"_23867":45784,"_2386":45785},[],"/docs/pr-preview/pr-43/platform/overview#automate-device-identities","Automate device identities",{"_2859":1576,"_25205":1566,"_5":25537,"_17596":45787,"_23867":45788,"_2386":45789},[],"/docs/pr-preview/pr-43/platform/overview#publish-validation-status","Publish validation status",{"_2859":1577,"_25205":1566,"_5":25537,"_17596":45791,"_23867":45792,"_2386":45793},[],"/docs/pr-preview/pr-43/platform/overview#react-to-events","React to events",{"_2859":1578,"_25205":1566,"_5":25537,"_17596":45795,"_23867":45796,"_2386":45797},[],"/docs/pr-preview/pr-43/platform/overview#operational-reference","Operational reference",{"_2859":1579,"_25205":1566,"_17596":45799,"_5":17486,"_23867":1566,"_2386":45800},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_2859":1580,"_25205":1566,"_17596":45802,"_5":17486,"_23867":45757,"_2386":45803},[],"Choose the result you need:",{"_2859":1581,"_25205":1566,"_17596":45805,"_5":17486,"_23867":45757,"_2386":45806},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2859":1582,"_25205":1566,"_17596":45808,"_5":17486,"_23867":45757,"_2386":45809},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2859":1583,"_25205":1566,"_17596":45811,"_5":17486,"_23867":45757,"_2386":45812},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_2859":1584,"_25205":1566,"_17596":45814,"_5":17486,"_23867":45760,"_2386":45815},[],"Section",{"_2859":1585,"_25205":1566,"_17596":45817,"_5":17486,"_23867":45760,"_2386":45818},[],"What you manage",{"_2859":1586,"_25205":1566,"_17596":45820,"_5":17486,"_23867":45760,"_2386":45821},[],"Entry point",{"_2859":1587,"_25205":1566,"_17596":45823,"_5":17486,"_23867":45760,"_2386":45824},[],"**PKI**",{"_2859":1588,"_25205":1566,"_17596":45826,"_5":17486,"_23867":45760,"_2386":45827},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_2859":1589,"_25205":1566,"_17596":45829,"_5":17486,"_23867":45760,"_2386":45830},[],"PKI overview",{"_2859":1590,"_25205":1566,"_17596":45832,"_5":17486,"_23867":45760,"_2386":45833},[],"**IoT Fleets**",{"_2859":1591,"_25205":1566,"_17596":45835,"_5":17486,"_23867":45760,"_2386":45836},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_2859":1592,"_25205":1566,"_17596":45838,"_5":17486,"_23867":45760,"_2386":45839},[],"IoT Fleets overview",{"_2859":1593,"_25205":1566,"_17596":45841,"_5":17486,"_23867":45760,"_2386":45842},[],"**Administration**",{"_2859":1594,"_25205":1566,"_17596":45844,"_5":17486,"_23867":45760,"_2386":45845},[],"Operator permissions, audit and event subscriptions.",{"_2859":1595,"_25205":1566,"_17596":45847,"_5":17486,"_23867":45760,"_2386":42236},[],{"_2859":1596,"_25205":1566,"_17596":45849,"_5":17486,"_23867":45760,"_2386":45850},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_2859":1597,"_25205":1566,"_17596":45852,"_5":17486,"_23867":45764,"_2386":45853},[],"An identity's journey connects four responsibilities:",{"_2859":1598,"_25205":1566,"_17596":45855,"_5":17486,"_23867":45764,"_2386":45856},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_2859":1599,"_25205":1566,"_17596":45858,"_5":17486,"_23867":45764,"_2386":45859},[],"The provisioning administrator configures the DMS and initial trust.",{"_2859":1600,"_25205":1566,"_17596":45861,"_5":17486,"_23867":45764,"_2386":45862},[],"The device client requests a certificate and installs it with the matching key.",{"_2859":1601,"_25205":1566,"_17596":45864,"_5":17486,"_23867":45764,"_2386":45865},[],"The consumer validates the identity and applies its access permissions.",{"_2859":1602,"_25205":1566,"_17596":45867,"_5":17486,"_23867":45764,"_2386":45868},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_2859":1603,"_25205":1566,"_17596":45870,"_5":17486,"_23867":45772,"_2386":45871},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_2859":1604,"_25205":1566,"_17596":45873,"_5":17486,"_23867":45776,"_2386":45874},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_2859":1605,"_25205":1566,"_17596":45876,"_5":17486,"_23867":45780,"_2386":45877},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_2859":1606,"_25205":1566,"_17596":45879,"_5":17486,"_23867":45784,"_2386":45880},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_2859":1607,"_25205":1566,"_17596":45882,"_5":17486,"_23867":45788,"_2386":45883},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_2859":1608,"_25205":1566,"_17596":45885,"_5":17486,"_23867":45792,"_2386":45886},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_2859":1609,"_25205":1566,"_17596":45888,"_5":17486,"_23867":45796,"_2386":45329},[],{"_2859":1610,"_25205":1566,"_17596":45890,"_5":17486,"_23867":45796,"_2386":45891},[],"What it prepares or checks",{"_2859":1611,"_25205":1566,"_17596":45893,"_5":17486,"_23867":45796,"_2386":45332},[],{"_2859":1612,"_25205":1566,"_17596":45895,"_5":17486,"_23867":45796,"_2386":45896},[],"Key custody, CA hierarchy, profiles and validation.",{"_2859":1613,"_25205":1566,"_17596":45898,"_5":17486,"_23867":45796,"_2386":45899},[],"Fleet administrator",{"_2859":1614,"_25205":1566,"_17596":45901,"_5":17486,"_23867":45796,"_2386":45902},[],"DMS, device admission, renewal policy and inventory.",{"_2859":1615,"_25205":1566,"_17596":45904,"_5":17486,"_23867":45796,"_2386":45344},[],{"_2859":1616,"_25205":1566,"_17596":45906,"_5":17486,"_23867":45796,"_2386":45907},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_2859":1617,"_25205":1566,"_17596":45909,"_5":17486,"_23867":45796,"_2386":45350},[],{"_2859":1618,"_25205":1566,"_17596":45911,"_5":17486,"_23867":45796,"_2386":45912},[],"Issuer trust, certificate validation and permissions in the destination.",{"_2859":1619,"_25205":1566,"_17596":45914,"_5":17486,"_23867":45796,"_2386":45915},[],"Infrastructure operator",{"_2859":1620,"_25205":1566,"_17596":45917,"_5":17486,"_23867":45796,"_2386":45918},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_2859":1621,"_25205":1566,"_17596":45920,"_5":17486,"_23867":45796,"_2386":45921},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_2859":1622,"_25205":1622,"_5":12316,"_2386":45923,"_25540":45924,"_17596":45927,"_23867":1622},"CA hierarchy and rotation",[40894,42238,45925,45926],"PKI","Keys, authorities and certificates",[],{"_2859":1623,"_25205":1622,"_17596":45929,"_5":17486,"_23867":1622,"_2386":45930},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_2859":1624,"_25205":1622,"_5":25537,"_17596":45932,"_23867":45933,"_2386":45934},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_2859":1625,"_25205":1622,"_5":25537,"_17596":45936,"_23867":45937,"_2386":45938},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_2859":1626,"_25205":1622,"_5":25537,"_17596":45940,"_23867":45941,"_2386":45942},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_2859":1627,"_25205":1622,"_5":25537,"_17596":45944,"_23867":45945,"_2386":45946},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_2859":1628,"_25205":1622,"_5":25537,"_17596":45948,"_23867":45949,"_2386":45950},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_2859":1629,"_25205":1622,"_5":25537,"_17596":45952,"_23867":45953,"_2386":45954},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_2859":1630,"_25205":1622,"_5":25537,"_17596":45956,"_23867":45957,"_2386":45958},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_2859":1631,"_25205":1622,"_5":25537,"_17596":45960,"_23867":45961,"_2386":45962},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_2859":1632,"_25205":1622,"_5":25537,"_17596":45964,"_23867":45965,"_2386":45966},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_2859":1633,"_25205":1622,"_5":25537,"_17596":45968,"_23867":45969,"_2386":45970},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_2859":1634,"_25205":1622,"_5":25537,"_17596":45972,"_23867":45973,"_2386":45974},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_2859":1635,"_25205":1622,"_5":25537,"_17596":45976,"_23867":45977,"_2386":45978},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_2859":1636,"_25205":1622,"_17596":45980,"_5":17486,"_23867":1622,"_2386":45981},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_2859":1637,"_25205":1622,"_17596":45983,"_5":17486,"_23867":1622,"_2386":45984},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_2859":1638,"_25205":1622,"_17596":45986,"_5":17486,"_23867":45933,"_2386":45987},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_2859":1639,"_25205":1622,"_17596":45989,"_5":17486,"_23867":45933,"_2386":45990},[],"environment, such as production and preproduction;",{"_2859":1640,"_25205":1622,"_17596":45992,"_5":17486,"_23867":45933,"_2386":45993},[],"owner or operating team;",{"_2859":1641,"_25205":1622,"_17596":45995,"_5":17486,"_23867":45933,"_2386":45996},[],"device family or manufacturing process;",{"_2859":1642,"_25205":1622,"_17596":45998,"_5":17486,"_23867":45933,"_2386":45999},[],"region or regulatory requirement;",{"_2859":1643,"_25205":1622,"_17596":46001,"_5":17486,"_23867":45933,"_2386":46002},[],"cryptographic engine or key policy;",{"_2859":1644,"_25205":1622,"_17596":46004,"_5":17486,"_23867":45933,"_2386":46005},[],"maintenance window and renewal cadence.",{"_2859":1645,"_25205":1622,"_17596":46007,"_5":17486,"_23867":45933,"_2386":46008},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_2859":1646,"_25205":1622,"_17596":46010,"_5":17486,"_23867":45933,"_2386":46011},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_2859":1647,"_25205":1622,"_17596":46013,"_5":17486,"_23867":45937,"_2386":46014},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_2859":1648,"_25205":1622,"_17596":46016,"_5":17486,"_23867":45937,"_2386":46017},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_2859":1649,"_25205":1622,"_17596":46019,"_5":17486,"_23867":45937,"_2386":46020},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_2859":1650,"_25205":1622,"_17596":46022,"_5":17486,"_23867":45941,"_2386":46023},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_2859":1651,"_25205":1622,"_17596":46025,"_5":17486,"_23867":45941,"_2386":46026},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_2859":1652,"_25205":1622,"_17596":46028,"_5":17486,"_23867":45941,"_2386":46029},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_2859":1653,"_25205":1622,"_17596":46031,"_5":17486,"_23867":45941,"_2386":46032},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_2859":1654,"_25205":1622,"_17596":46034,"_5":17486,"_23867":45949,"_2386":46035},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_2859":1655,"_25205":1622,"_17596":46037,"_5":17486,"_23867":45953,"_2386":46038},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_2859":1656,"_25205":1622,"_17596":46040,"_5":17486,"_23867":45957,"_2386":46041},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_2859":1657,"_25205":1622,"_17596":46043,"_5":17486,"_23867":45961,"_2386":46044},[],"Update the enrollment CA and profile of the DMSs. Keep the additional validation CAs if old certificates still need to be accepted during re-enrollment.",{"_2859":1658,"_25205":1622,"_17596":46046,"_5":17486,"_23867":45965,"_2386":46047},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_2859":1659,"_25205":1622,"_17596":46049,"_5":17486,"_23867":45969,"_2386":46050},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance and from the distributed CAs. Revoke it if policy requires it.",{"_2859":1660,"_25205":1622,"_17596":46052,"_5":17486,"_23867":45973,"_2386":46053},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_2859":1661,"_25205":1622,"_17596":46055,"_5":17486,"_23867":45973,"_2386":46056},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_2859":1662,"_25205":1622,"_17596":46058,"_5":17486,"_23867":45973,"_2386":46059},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_2859":1663,"_25205":1622,"_17596":46061,"_5":17486,"_23867":45973,"_2386":46062},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_2859":1664,"_25205":1622,"_17596":46064,"_5":17486,"_23867":45977,"_2386":46065},[],"The new chain ends in an anchor installed by the consumer.",{"_2859":1665,"_25205":1622,"_17596":46067,"_5":17486,"_23867":45977,"_2386":46068},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_2859":1666,"_25205":1622,"_17596":46070,"_5":17486,"_23867":45977,"_2386":46071},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_2859":1667,"_25205":1622,"_17596":46073,"_5":17486,"_23867":45977,"_2386":46074},[],"Re-enrollment accepts the old identity during the planned period.",{"_2859":1668,"_25205":1622,"_17596":46076,"_5":17486,"_23867":45977,"_2386":46077},[],"OCSP and CRL respond for the authorities that remain active.",{"_2859":1669,"_25205":1622,"_17596":46079,"_5":17486,"_23867":45977,"_2386":46080},[],"No DMS is left accidentally issuing from the old CA.",{"_2859":1670,"_25205":1622,"_17596":46082,"_5":17486,"_23867":45977,"_2386":46083},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_2859":1671,"_25205":1671,"_5":12316,"_2386":46085,"_25540":46086,"_17596":46087,"_23867":1671},"Certification authorities",[40894,42238,45925,45926],[],{"_2859":1672,"_25205":1671,"_17596":46089,"_5":17486,"_23867":1671,"_2386":46090},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_2859":1673,"_25205":1671,"_5":25537,"_17596":46092,"_23867":46093,"_2386":46094},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_2859":1674,"_25205":1671,"_5":25537,"_17596":46096,"_23867":46097,"_2386":46098},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_2859":1675,"_25205":1671,"_5":25537,"_17596":46100,"_23867":46101,"_2386":40904},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#before-you-begin",{"_2859":1676,"_25205":1671,"_5":25537,"_17596":46103,"_23867":46104,"_2386":46105},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_2859":1677,"_25205":1671,"_5":25537,"_17596":46107,"_23867":46108,"_2386":46109},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_2859":1678,"_25205":1671,"_5":25537,"_17596":46111,"_23867":46112,"_2386":46113},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_2859":1679,"_25205":1671,"_5":25537,"_17596":46115,"_23867":46116,"_2386":46117},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_2859":1680,"_25205":1671,"_5":25537,"_17596":46119,"_23867":46120,"_2386":46121},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_2859":1681,"_25205":1671,"_5":25537,"_17596":46123,"_23867":46124,"_2386":46125},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_2859":1682,"_25205":1671,"_5":25537,"_17596":46127,"_23867":46128,"_2386":46129},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_2859":1683,"_25205":1671,"_5":25537,"_17596":46131,"_23867":46132,"_2386":46133},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_2859":1684,"_25205":1671,"_5":25537,"_17596":46135,"_23867":46136,"_2386":46137},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_2859":1685,"_25205":1671,"_5":25537,"_17596":46139,"_23867":46140,"_2386":46141},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#load-the-material","Load the material",{"_2859":1686,"_25205":1671,"_5":25537,"_17596":46143,"_23867":46144,"_2386":46145},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_2859":1687,"_25205":1671,"_5":25537,"_17596":46147,"_23867":46148,"_2386":46149},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_2859":1688,"_25205":1671,"_5":25537,"_17596":46151,"_23867":46152,"_2386":46153},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_2859":1689,"_25205":1671,"_5":25537,"_17596":46155,"_23867":46156,"_2386":46157},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_2859":1690,"_25205":1671,"_5":25537,"_17596":46159,"_23867":46160,"_2386":46161},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_2859":1691,"_25205":1671,"_5":25537,"_17596":46163,"_23867":46164,"_2386":46165},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_2859":1692,"_25205":1671,"_5":25537,"_17596":46167,"_23867":46168,"_2386":46169},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_2859":1693,"_25205":1671,"_5":25537,"_17596":46171,"_23867":46172,"_2386":46173},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_2859":1694,"_25205":1671,"_5":25537,"_17596":46175,"_23867":46176,"_2386":46177},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_2859":1695,"_25205":1671,"_17596":46179,"_5":17486,"_23867":1671,"_2386":46180},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_2859":1696,"_25205":1671,"_17596":46182,"_5":17486,"_23867":1671,"_2386":46183},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_2859":1697,"_25205":1671,"_17596":46185,"_5":17486,"_23867":1671,"_2386":46186},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_2859":1698,"_25205":1671,"_17596":46188,"_5":17486,"_23867":46093,"_2386":46189},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_2859":1699,"_25205":1671,"_17596":46191,"_5":17486,"_23867":46093,"_2386":46192},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_2859":1700,"_25205":1671,"_17596":46194,"_5":17486,"_23867":46093,"_2386":46195},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_2859":1701,"_25205":1671,"_17596":46197,"_5":17486,"_23867":46093,"_2386":46198},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_2859":1702,"_25205":1671,"_17596":46200,"_5":17486,"_23867":46093,"_2386":46201},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_2859":1703,"_25205":1671,"_17596":46203,"_5":17486,"_23867":46101,"_2386":46204},[],"Decide whether the CA will be a root or an intermediate.",{"_2859":1704,"_25205":1671,"_17596":46206,"_5":17486,"_23867":46101,"_2386":46207},[],"Choose the engine that will keep the key.",{"_2859":1705,"_25205":1671,"_17596":46209,"_5":17486,"_23867":46101,"_2386":46210},[],"Define a validity longer than that of the certificates it will issue.",{"_2859":1706,"_25205":1671,"_17596":46212,"_5":17486,"_23867":46101,"_2386":46213},[],"For an intermediate CA, make sure the parent CA is active.",{"_2859":1707,"_25205":1671,"_17596":46215,"_5":17486,"_23867":46104,"_2386":46216},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_2859":1708,"_25205":1671,"_17596":46218,"_5":17486,"_23867":46108,"_2386":46219},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_2859":1709,"_25205":1671,"_17596":46221,"_5":17486,"_23867":46108,"_2386":46222},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_2859":1710,"_25205":1671,"_17596":46224,"_5":17486,"_23867":46112,"_2386":46225},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_2859":1711,"_25205":1671,"_17596":46227,"_5":17486,"_23867":46116,"_2386":46228},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_2859":1712,"_25205":1671,"_17596":46230,"_5":17486,"_23867":46116,"_2386":46231},[],"`C`: two-letter ISO 3166-1 country code.",{"_2859":1713,"_25205":1671,"_17596":46233,"_5":17486,"_23867":46116,"_2386":46234},[],"`ST`: state or province.",{"_2859":1714,"_25205":1671,"_17596":46236,"_5":17486,"_23867":46116,"_2386":46237},[],"`L`: locality.",{"_2859":1715,"_25205":1671,"_17596":46239,"_5":17486,"_23867":46116,"_2386":46240},[],"`O`: organization.",{"_2859":1716,"_25205":1671,"_17596":46242,"_5":17486,"_23867":46116,"_2386":46243},[],"`OU`: organizational unit.",{"_2859":1717,"_25205":1671,"_17596":46245,"_5":17486,"_23867":46116,"_2386":46246},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_2859":1718,"_25205":1671,"_17596":46248,"_5":17486,"_23867":46120,"_2386":46249},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_2859":1719,"_25205":1671,"_17596":46251,"_5":17486,"_23867":46120,"_2386":46252},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_2859":1720,"_25205":1671,"_17596":46254,"_5":17486,"_23867":46124,"_2386":46255},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_2859":1721,"_25205":1671,"_17596":46257,"_5":17486,"_23867":46124,"_2386":46258},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_2859":1722,"_25205":1671,"_17596":46260,"_5":17486,"_23867":46128,"_2386":46261},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_2859":1723,"_25205":1671,"_17596":46263,"_5":17486,"_23867":46128,"_2386":46264},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_2859":1724,"_25205":1671,"_17596":46266,"_5":17486,"_23867":46132,"_2386":46267},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_2859":1725,"_25205":1671,"_17596":46269,"_5":17486,"_23867":46136,"_2386":46270},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_2859":1726,"_25205":1671,"_17596":46272,"_5":17486,"_23867":46140,"_2386":46273},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_2859":1727,"_25205":1671,"_17596":46275,"_5":17486,"_23867":46144,"_2386":46276},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_2859":1728,"_25205":1671,"_17596":46278,"_5":17486,"_23867":46148,"_2386":46279},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_2859":1729,"_25205":1671,"_17596":46281,"_5":17486,"_23867":46148,"_2386":46282},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_2859":1730,"_25205":1671,"_17596":46284,"_5":17486,"_23867":46152,"_2386":46285},[],"Open a CA from the inventory to review:",{"_2859":1731,"_25205":1671,"_17596":46287,"_5":17486,"_23867":46152,"_2386":46288},[],"Status and validity period.",{"_2859":1732,"_25205":1671,"_17596":46290,"_5":17486,"_23867":46152,"_2386":46291},[],"Certificate and chain in PEM format.",{"_2859":1733,"_25205":1671,"_17596":46293,"_5":17486,"_23867":46152,"_2386":46294},[],"Number of active, expired and revoked certificates.",{"_2859":1734,"_25205":1671,"_17596":46296,"_5":17486,"_23867":46152,"_2386":46297},[],"Certificates issued in **Issued Certificates**.",{"_2859":1735,"_25205":1671,"_17596":46299,"_5":17486,"_23867":46152,"_2386":46300},[],"The CRL linked to the authority.",{"_2859":1736,"_25205":1671,"_17596":46302,"_5":17486,"_23867":46152,"_2386":46303},[],"Metadata and the associated cryptographic engine.",{"_2859":1737,"_25205":1671,"_17596":46305,"_5":17486,"_23867":46152,"_2386":46306},[],"You can filter the inventory by name, status and CA type.",{"_2859":1738,"_25205":1671,"_17596":46308,"_5":17486,"_23867":46156,"_2386":46309},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_2859":1739,"_25205":1671,"_17596":46311,"_5":17486,"_23867":46156,"_2386":46312},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_2859":1740,"_25205":1671,"_17596":46314,"_5":17486,"_23867":46156,"_2386":46315},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_2859":1741,"_25205":1671,"_17596":46317,"_5":17486,"_23867":46156,"_2386":46318},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_2859":1742,"_25205":1671,"_17596":46320,"_5":17486,"_23867":46160,"_2386":46321},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_2859":1743,"_25205":1671,"_17596":46323,"_5":17486,"_23867":46164,"_2386":46324},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_2859":1744,"_25205":1671,"_17596":46326,"_5":17486,"_23867":46168,"_2386":46327},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_2859":1745,"_25205":1671,"_17596":46329,"_5":17486,"_23867":46172,"_2386":46330},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_2859":1746,"_25205":1671,"_17596":46332,"_5":17486,"_23867":46176,"_2386":46333},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_2859":1747,"_25205":1671,"_17596":46335,"_5":17486,"_23867":46176,"_2386":46336},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_2859":1748,"_25205":1748,"_5":12316,"_2386":46338,"_25540":46339,"_17596":46340,"_23867":1748},"Certificate profiles",[40894,42238,45925,45926],[],{"_2859":1749,"_25205":1748,"_17596":46342,"_5":17486,"_23867":1748,"_2386":46343},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_2859":1750,"_25205":1748,"_5":25537,"_17596":46345,"_23867":46346,"_2386":46347},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_2859":1751,"_25205":1748,"_5":25537,"_17596":46349,"_23867":46350,"_2386":46351},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#validity","Validity",{"_2859":1752,"_25205":1748,"_5":25537,"_17596":46353,"_23867":46354,"_2386":46355},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_2859":1753,"_25205":1748,"_5":25537,"_17596":46357,"_23867":46358,"_2386":46359},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_2859":1754,"_25205":1748,"_5":25537,"_17596":46361,"_23867":46362,"_2386":46363},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#subject","Subject",{"_2859":1755,"_25205":1748,"_5":25537,"_17596":46365,"_23867":46366,"_2386":46367},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_2859":1756,"_25205":1748,"_5":25537,"_17596":46369,"_23867":46370,"_2386":46371},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_2859":1757,"_25205":1748,"_5":25537,"_17596":46373,"_23867":46374,"_2386":46375},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_2859":1758,"_25205":1748,"_5":25537,"_17596":46377,"_23867":46378,"_2386":46379},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_2859":1759,"_25205":1748,"_5":25537,"_17596":46381,"_23867":46382,"_2386":46383},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_2859":1760,"_25205":1748,"_5":25537,"_17596":46385,"_23867":46386,"_2386":46387},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_2859":1761,"_25205":1748,"_5":25537,"_17596":46389,"_23867":46390,"_2386":46391},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_2859":1762,"_25205":1748,"_5":25537,"_17596":46393,"_23867":46394,"_2386":46395},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_2859":1763,"_25205":1748,"_5":25537,"_17596":46397,"_23867":46398,"_2386":46399},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_2859":1764,"_25205":1748,"_5":25537,"_17596":46401,"_23867":46402,"_2386":46403},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#design-examples","Design examples",{"_2859":1765,"_25205":1748,"_5":25537,"_17596":46405,"_23867":46406,"_2386":46407},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_2859":1766,"_25205":1748,"_17596":46409,"_5":17486,"_23867":1748,"_2386":46410},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_2859":1767,"_25205":1748,"_17596":46412,"_5":17486,"_23867":1748,"_2386":46413},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_2859":1768,"_25205":1748,"_17596":46415,"_5":17486,"_23867":46350,"_2386":46416},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_2859":1769,"_25205":1748,"_17596":46418,"_5":17486,"_23867":46350,"_2386":46419},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_2859":1770,"_25205":1748,"_17596":46421,"_5":17486,"_23867":46354,"_2386":46422},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_2859":1771,"_25205":1748,"_17596":46424,"_5":17486,"_23867":46358,"_2386":46425},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_2859":1772,"_25205":1748,"_17596":46427,"_5":17486,"_23867":46358,"_2386":46428},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_2859":1773,"_25205":1748,"_17596":46430,"_5":17486,"_23867":46358,"_2386":46431},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_2859":1774,"_25205":1748,"_17596":46433,"_5":17486,"_23867":46362,"_2386":46434},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_2859":1775,"_25205":1748,"_17596":46436,"_5":17486,"_23867":46366,"_2386":46437},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_2859":1776,"_25205":1748,"_17596":46439,"_5":17486,"_23867":46366,"_2386":46440},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_2859":1777,"_25205":1748,"_17596":46442,"_5":17486,"_23867":46370,"_2386":46443},[],"The cryptographic enforcement can:",{"_2859":1778,"_25205":1748,"_17596":46445,"_5":17486,"_23867":46370,"_2386":46446},[],"allow or block RSA keys;",{"_2859":1779,"_25205":1748,"_17596":46448,"_5":17486,"_23867":46370,"_2386":46449},[],"limit the supported RSA sizes;",{"_2859":1780,"_25205":1748,"_17596":46451,"_5":17486,"_23867":46370,"_2386":46452},[],"allow or block ECDSA keys;",{"_2859":1781,"_25205":1748,"_17596":46454,"_5":17486,"_23867":46370,"_2386":46455},[],"limit the supported ECDSA sizes or curves.",{"_2859":1782,"_25205":1748,"_17596":46457,"_5":17486,"_23867":46370,"_2386":46458},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_2859":1783,"_25205":1748,"_17596":46460,"_5":17486,"_23867":46374,"_2386":46461},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_2859":1784,"_25205":1748,"_17596":46463,"_5":17486,"_23867":46374,"_2386":43956},[],{"_2859":1785,"_25205":1748,"_17596":46465,"_5":17486,"_23867":46374,"_2386":46466},[],"First choice",{"_2859":1786,"_25205":1748,"_17596":46468,"_5":17486,"_23867":46374,"_2386":46469},[],"Second choice",{"_2859":1787,"_25205":1748,"_17596":46471,"_5":17486,"_23867":46374,"_2386":46472},[],"If neither is supplied",{"_2859":1788,"_25205":1748,"_17596":46474,"_5":17486,"_23867":46374,"_2386":46475},[],"Direct signing with a CA",{"_2859":1789,"_25205":1748,"_17596":46477,"_5":17486,"_23867":46374,"_2386":46478},[],"`issuance_profile` embedded in the request",{"_2859":1790,"_25205":1748,"_17596":46480,"_5":17486,"_23867":46374,"_2386":46481},[],"Request `issuance_profile_id`",{"_2859":1791,"_25205":1748,"_17596":46483,"_5":17486,"_23867":46374,"_2386":46484},[],"CA default profile (`profile_id`).",{"_2859":1792,"_25205":1748,"_17596":46486,"_5":17486,"_23867":46374,"_2386":46487},[],"Issuance through a DMS",{"_2859":1793,"_25205":1748,"_17596":46489,"_5":17486,"_23867":46374,"_2386":46490},[],"`settings.issuance_profile_id`",{"_2859":1794,"_25205":1748,"_17596":46492,"_5":17486,"_23867":46374,"_2386":46493},[],"`settings.issuance_profile` embedded in the DMS",{"_2859":1795,"_25205":1748,"_17596":46495,"_5":17486,"_23867":46374,"_2386":46496},[],"Enrollment CA default profile.",{"_2859":1796,"_25205":1748,"_17596":46498,"_5":17486,"_23867":46374,"_2386":46499},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_2859":1797,"_25205":1748,"_17596":46501,"_5":17486,"_23867":46374,"_2386":46502},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_2859":1798,"_25205":1748,"_17596":46504,"_5":17486,"_23867":46382,"_2386":46505},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_2859":1799,"_25205":1748,"_17596":46507,"_5":17486,"_23867":46386,"_2386":46508},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_2859":1800,"_25205":1748,"_17596":46510,"_5":17486,"_23867":46390,"_2386":46511},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_2859":1801,"_25205":1748,"_17596":46513,"_5":17486,"_23867":46394,"_2386":46514},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_2859":1802,"_25205":1748,"_17596":46516,"_5":17486,"_23867":46398,"_2386":46517},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_2859":1803,"_25205":1748,"_17596":46519,"_5":17486,"_23867":46398,"_2386":46520},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_2859":1804,"_25205":1748,"_17596":46522,"_5":17486,"_23867":46402,"_2386":46523},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_2859":1805,"_25205":1748,"_17596":46525,"_5":17486,"_23867":46402,"_2386":46526},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_2859":1806,"_25205":1748,"_17596":46528,"_5":17486,"_23867":46402,"_2386":46529},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_2859":1807,"_25205":1748,"_17596":46531,"_5":17486,"_23867":46402,"_2386":46532},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_2859":1808,"_25205":1748,"_17596":46534,"_5":17486,"_23867":46406,"_2386":46535},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_2859":1809,"_25205":1748,"_17596":46537,"_5":17486,"_23867":46406,"_2386":46538},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_2859":1810,"_25205":1810,"_5":12316,"_2386":46540,"_25540":46541,"_17596":46543,"_23867":1810},"Certificate validation",[40894,42238,45925,46542],"Validation",[],{"_2859":1811,"_25205":1810,"_17596":46545,"_5":17486,"_23867":1810,"_2386":46546},[],"Check chain, identity, purpose and revocation from the consumer.",{"_2859":1812,"_25205":1810,"_5":25537,"_17596":46548,"_23867":46549,"_2386":46550},[],"/docs/pr-preview/pr-43/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_2859":1813,"_25205":1810,"_5":25537,"_17596":46552,"_23867":46553,"_2386":46554},[],"/docs/pr-preview/pr-43/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_2859":1814,"_25205":1810,"_5":25537,"_17596":46556,"_23867":46557,"_2386":46558},[],"/docs/pr-preview/pr-43/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_2859":1815,"_25205":1810,"_17596":46560,"_5":17486,"_23867":1810,"_2386":46561},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_2859":1816,"_25205":1810,"_17596":46563,"_5":17486,"_23867":46549,"_2386":46564},[],"Verify these criteria together:",{"_2859":1817,"_25205":1810,"_17596":46566,"_5":17486,"_23867":46549,"_2386":45549},[],{"_2859":1818,"_25205":1810,"_17596":46568,"_5":17486,"_23867":46549,"_2386":46569},[],"Required result",{"_2859":1819,"_25205":1810,"_17596":46571,"_5":17486,"_23867":46549,"_2386":46572},[],"Chain and signature",{"_2859":1820,"_25205":1810,"_17596":46574,"_5":17486,"_23867":46549,"_2386":46575},[],"Valid chain to a root deliberately installed in the consumer.",{"_2859":1821,"_25205":1810,"_17596":46577,"_5":17486,"_23867":46549,"_2386":46578},[],"Dates",{"_2859":1822,"_25205":1810,"_17596":46580,"_5":17486,"_23867":46549,"_2386":46581},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_2859":1823,"_25205":1810,"_17596":46583,"_5":17486,"_23867":46549,"_2386":41941},[],{"_2859":1824,"_25205":1810,"_17596":46585,"_5":17486,"_23867":46549,"_2386":46586},[],"Name, SAN or identifier matches the expected peer.",{"_2859":1825,"_25205":1810,"_17596":46588,"_5":17486,"_23867":46549,"_2386":41277},[],{"_2859":1826,"_25205":1810,"_17596":46590,"_5":17486,"_23867":46549,"_2386":46591},[],"KU, EKU and constraints permit the specific operation.",{"_2859":1827,"_25205":1810,"_17596":46593,"_5":17486,"_23867":46549,"_2386":46594},[],"Revocation",{"_2859":1828,"_25205":1810,"_17596":46596,"_5":17486,"_23867":46549,"_2386":46597},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_2859":1829,"_25205":1810,"_17596":46599,"_5":17486,"_23867":46549,"_2386":46600},[],"Authorization",{"_2859":1830,"_25205":1810,"_17596":46602,"_5":17486,"_23867":46549,"_2386":46603},[],"The application permits that identity to perform the action.",{"_2859":1831,"_25205":1810,"_17596":46605,"_5":17486,"_23867":46549,"_2386":46606},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_2859":1832,"_25205":1810,"_17596":46608,"_5":17486,"_23867":46553,"_2386":46609},[],"Mechanism",{"_2859":1833,"_25205":1810,"_17596":46611,"_5":17486,"_23867":46553,"_2386":46612},[],"When to use it",{"_2859":1834,"_25205":1810,"_17596":46614,"_5":17486,"_23867":46553,"_2386":46615},[],"What you must maintain",{"_2859":1835,"_25205":1810,"_17596":46617,"_5":17486,"_23867":46553,"_2386":46618},[],"OCSP",{"_2859":1836,"_25205":1810,"_17596":46620,"_5":17486,"_23867":46553,"_2386":46621},[],"Status query for a specific certificate.",{"_2859":1837,"_25205":1810,"_17596":46623,"_5":17486,"_23867":46553,"_2386":46624},[],"Responder access, signature verification and cache/freshness policy.",{"_2859":1838,"_25205":1810,"_17596":46626,"_5":17486,"_23867":46553,"_2386":46627},[],"CRL",{"_2859":1839,"_25205":1810,"_17596":46629,"_5":17486,"_23867":46553,"_2386":46630},[],"Local checks for many certificates or offline operation.",{"_2859":1840,"_25205":1810,"_17596":46632,"_5":17486,"_23867":46553,"_2386":46633},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_2859":1841,"_25205":1810,"_17596":46635,"_5":17486,"_23867":46553,"_2386":46636},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_2859":1842,"_25205":1810,"_17596":46638,"_5":17486,"_23867":46553,"_2386":46639},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_2859":1843,"_25205":1810,"_17596":46641,"_5":17486,"_23867":46557,"_2386":46642},[],"Accept a current, authorized certificate with a known chain.",{"_2859":1844,"_25205":1810,"_17596":46644,"_5":17486,"_23867":46557,"_2386":46645},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_2859":1845,"_25205":1810,"_17596":46647,"_5":17486,"_23867":46557,"_2386":46648},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_2859":1846,"_25205":1810,"_17596":46650,"_5":17486,"_23867":46557,"_2386":46651},[],"Check that a new connection with that identity is rejected.",{"_2859":1847,"_25205":1810,"_17596":46653,"_5":17486,"_23867":46557,"_2386":46654},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_2859":1848,"_25205":1810,"_17596":46656,"_5":17486,"_23867":46557,"_2386":46657},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_2859":1849,"_25205":1810,"_17596":46659,"_5":17486,"_23867":46557,"_2386":46660},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_2859":1850,"_25205":1810,"_17596":46662,"_5":17486,"_23867":46557,"_2386":46663},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_2859":1851,"_25205":1810,"_17596":46665,"_5":17486,"_23867":46557,"_2386":46666},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_2859":1852,"_25205":1852,"_5":12316,"_2386":46668,"_25540":46669,"_17596":46670,"_23867":1852},"Certificates",[40894,42238,45925,45926],[],{"_2859":1853,"_25205":1852,"_17596":46672,"_5":17486,"_23867":1852,"_2386":46673},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_2859":1854,"_25205":1852,"_5":25537,"_17596":46675,"_23867":46676,"_2386":46677},[],"/docs/pr-preview/pr-43/platform/pki/certificates#find-a-certificate","Find a certificate",{"_2859":1855,"_25205":1852,"_5":25537,"_17596":46679,"_23867":46680,"_2386":46681},[],"/docs/pr-preview/pr-43/platform/pki/certificates#download-the-certificate","Download the certificate",{"_2859":1856,"_25205":1852,"_5":25537,"_17596":46683,"_23867":46684,"_2386":46685},[],"/docs/pr-preview/pr-43/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_2859":1857,"_25205":1852,"_5":25537,"_17596":46687,"_23867":46688,"_2386":46689},[],"/docs/pr-preview/pr-43/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_2859":1858,"_25205":1852,"_5":25537,"_17596":46691,"_23867":46692,"_2386":46693},[],"/docs/pr-preview/pr-43/platform/pki/certificates#open-the-action","Open the action",{"_2859":1859,"_25205":1852,"_5":25537,"_17596":46695,"_23867":46696,"_2386":46697},[],"/docs/pr-preview/pr-43/platform/pki/certificates#choose-a-reason","Choose a reason",{"_2859":1860,"_25205":1852,"_5":25537,"_17596":46699,"_23867":46700,"_2386":46701},[],"/docs/pr-preview/pr-43/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_2859":1861,"_25205":1852,"_5":25537,"_17596":46703,"_23867":46704,"_2386":46705},[],"/docs/pr-preview/pr-43/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_2859":1862,"_25205":1852,"_5":25537,"_17596":46707,"_23867":46708,"_2386":46709},[],"/docs/pr-preview/pr-43/platform/pki/certificates#continue","Continue",{"_2859":1863,"_25205":1852,"_17596":46711,"_5":17486,"_23867":1852,"_2386":46712},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_2859":1864,"_25205":1852,"_17596":46714,"_5":17486,"_23867":46676,"_2386":46715},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_2859":1865,"_25205":1852,"_17596":46717,"_5":17486,"_23867":46676,"_2386":46718},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_2859":1866,"_25205":1852,"_17596":46720,"_5":17486,"_23867":46680,"_2386":46721},[],"Download the PEM and inspect it:",{"_2859":1867,"_25205":1852,"_17596":46723,"_5":17486,"_23867":46680,"_2386":46724},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_2859":1868,"_25205":1852,"_17596":46726,"_5":17486,"_23867":46684,"_2386":46727},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_2859":1869,"_25205":1852,"_17596":46729,"_5":17486,"_23867":46684,"_2386":46730},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_2859":1870,"_25205":1852,"_17596":46732,"_5":17486,"_23867":46684,"_2386":46733},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_2859":1871,"_25205":1852,"_17596":46735,"_5":17486,"_23867":46684,"_2386":46736},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_2859":1872,"_25205":1852,"_17596":46738,"_5":17486,"_23867":46684,"_2386":46739},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_2859":1873,"_25205":1852,"_17596":46741,"_5":17486,"_23867":46684,"_2386":46742},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_2859":1874,"_25205":1852,"_17596":46744,"_5":17486,"_23867":46684,"_2386":46745},[],"For browser key generation, follow Issue your first certificate.",{"_2859":1875,"_25205":1852,"_17596":46747,"_5":17486,"_23867":46688,"_2386":46748},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_2859":1876,"_25205":1852,"_17596":46750,"_5":17486,"_23867":46692,"_2386":46751},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_2859":1877,"_25205":1852,"_17596":46753,"_5":17486,"_23867":46696,"_2386":46754},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_2859":1878,"_25205":1852,"_17596":46756,"_5":17486,"_23867":46700,"_2386":46757},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_2859":1879,"_25205":1852,"_17596":46759,"_5":17486,"_23867":46700,"_2386":46760},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_2859":1880,"_25205":1852,"_17596":46762,"_5":17486,"_23867":46700,"_2386":46763},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_2859":1881,"_25205":1852,"_17596":46765,"_5":17486,"_23867":46704,"_2386":46766},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_2859":1882,"_25205":1852,"_17596":46768,"_5":17486,"_23867":46704,"_2386":46769},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_2859":1883,"_25205":1852,"_17596":46771,"_5":17486,"_23867":46704,"_2386":46772},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_2859":1884,"_25205":1852,"_17596":46774,"_5":17486,"_23867":46708,"_2386":46775},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_2859":1885,"_25205":1852,"_17596":46777,"_5":17486,"_23867":46708,"_2386":46778},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_2859":1886,"_25205":1886,"_5":12316,"_2386":46780,"_25540":46781,"_17596":46783,"_23867":1886},"Certificate lifecycle",[40894,42238,45925,46782],"Concepts",[],{"_2859":1887,"_25205":1886,"_17596":46785,"_5":17486,"_23867":1886,"_2386":46786},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_2859":1888,"_25205":1886,"_5":25537,"_17596":46788,"_23867":46789,"_2386":46790},[],"/docs/pr-preview/pr-43/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_2859":1889,"_25205":1886,"_5":25537,"_17596":46792,"_23867":46793,"_2386":46794},[],"/docs/pr-preview/pr-43/platform/pki/concepts/certificate-lifecycle#request","Request",{"_2859":1890,"_25205":1886,"_5":25537,"_17596":46796,"_23867":46797,"_2386":46798},[],"/docs/pr-preview/pr-43/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_2859":1891,"_25205":1886,"_5":25537,"_17596":46800,"_23867":46801,"_2386":46802},[],"/docs/pr-preview/pr-43/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_2859":1892,"_25205":1886,"_5":25537,"_17596":46804,"_23867":46805,"_2386":46806},[],"/docs/pr-preview/pr-43/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_2859":1893,"_25205":1886,"_5":25537,"_17596":46808,"_23867":46809,"_2386":46810},[],"/docs/pr-preview/pr-43/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_2859":1894,"_25205":1886,"_5":25537,"_17596":46812,"_23867":46813,"_2386":46814},[],"/docs/pr-preview/pr-43/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_2859":1895,"_25205":1886,"_5":25537,"_17596":46816,"_23867":46817,"_2386":46818},[],"/docs/pr-preview/pr-43/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_2859":1896,"_25205":1886,"_5":25537,"_17596":46820,"_23867":46821,"_2386":46822},[],"/docs/pr-preview/pr-43/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_2859":1897,"_25205":1886,"_5":25537,"_17596":46824,"_23867":46825,"_2386":46826},[],"/docs/pr-preview/pr-43/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_2859":1898,"_25205":1886,"_17596":46828,"_5":17486,"_23867":1886,"_2386":46829},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_2859":1899,"_25205":1886,"_17596":46831,"_5":17486,"_23867":46793,"_2386":46832},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_2859":1900,"_25205":1886,"_17596":46834,"_5":17486,"_23867":46797,"_2386":46835},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_2859":1901,"_25205":1886,"_17596":46837,"_5":17486,"_23867":46801,"_2386":46838},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_2859":1902,"_25205":1886,"_17596":46840,"_5":17486,"_23867":46805,"_2386":46841},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_2859":1903,"_25205":1886,"_17596":46843,"_5":17486,"_23867":46809,"_2386":46844},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_2859":1904,"_25205":1886,"_17596":46846,"_5":17486,"_23867":46813,"_2386":46847},[],"Lamassu persists four X.509 states:",{"_2859":1905,"_25205":1886,"_17596":46849,"_5":17486,"_23867":46813,"_2386":46850},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_2859":1906,"_25205":1886,"_17596":46852,"_5":17486,"_23867":46813,"_2386":46853},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_2859":1907,"_25205":1886,"_17596":46855,"_5":17486,"_23867":46813,"_2386":46856},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_2859":1908,"_25205":1886,"_17596":46858,"_5":17486,"_23867":46813,"_2386":46859},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_2859":1909,"_25205":1886,"_17596":46861,"_5":17486,"_23867":46813,"_2386":46862},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_2859":1910,"_25205":1886,"_17596":46864,"_5":17486,"_23867":46817,"_2386":46865},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_2859":1911,"_25205":1886,"_17596":46867,"_5":17486,"_23867":46817,"_2386":46868},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_2859":1912,"_25205":1886,"_17596":46870,"_5":17486,"_23867":46817,"_2386":46871},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_2859":1913,"_25205":1886,"_17596":46873,"_5":17486,"_23867":46821,"_2386":46874},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_2859":1914,"_25205":1886,"_17596":46876,"_5":17486,"_23867":46821,"_2386":46877},[],"Before confirming:",{"_2859":1915,"_25205":1886,"_17596":46879,"_5":17486,"_23867":46821,"_2386":46880},[],"Identify DMSs, devices and services that trust that chain.",{"_2859":1916,"_25205":1886,"_17596":46882,"_5":17486,"_23867":46821,"_2386":46883},[],"Distribute the new chain of trust.",{"_2859":1917,"_25205":1886,"_17596":46885,"_5":17486,"_23867":46821,"_2386":46886},[],"Reissue the necessary identities.",{"_2859":1918,"_25205":1886,"_17596":46888,"_5":17486,"_23867":46821,"_2386":46889},[],"Check OCSP and CRL from a real consumer.",{"_2859":1919,"_25205":1886,"_17596":46891,"_5":17486,"_23867":46821,"_2386":46892},[],"Revoke the old CA once no legitimate traffic remains.",{"_2859":1920,"_25205":1886,"_17596":46894,"_5":17486,"_23867":46821,"_2386":46895},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_2859":1921,"_25205":1886,"_17596":46897,"_5":17486,"_23867":46825,"_2386":46898},[],"Certificates entering the preventive or critical renewal window.",{"_2859":1922,"_25205":1886,"_17596":46900,"_5":17486,"_23867":46825,"_2386":46901},[],"Repeated enrollment or re-enrollment failures.",{"_2859":1923,"_25205":1886,"_17596":46903,"_5":17486,"_23867":46825,"_2386":46904},[],"Status changes and revocation reasons.",{"_2859":1924,"_25205":1886,"_17596":46906,"_5":17486,"_23867":46825,"_2386":46907},[],"OCSP and CRL publication and validity.",{"_2859":1925,"_25205":1886,"_17596":46909,"_5":17486,"_23867":46825,"_2386":46910},[],"Dependencies still presenting a replaced certificate.",{"_2859":1926,"_25205":1886,"_17596":46912,"_5":17486,"_23867":46825,"_2386":46913},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_2859":1927,"_25205":1927,"_5":12316,"_2386":46915,"_25540":46916,"_17596":46917,"_23867":1927},"Trust model",[40894,42238,45925,46782],[],{"_2859":1928,"_25205":1927,"_17596":46919,"_5":17486,"_23867":1927,"_2386":46920},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_2859":1929,"_25205":1927,"_5":25537,"_17596":46922,"_23867":46923,"_2386":46924},[],"/docs/pr-preview/pr-43/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_2859":1930,"_25205":1927,"_5":25537,"_17596":46926,"_23867":46927,"_2386":46928},[],"/docs/pr-preview/pr-43/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_2859":1931,"_25205":1927,"_5":25537,"_17596":46930,"_23867":46931,"_2386":46932},[],"/docs/pr-preview/pr-43/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_2859":1932,"_25205":1927,"_5":25537,"_17596":46934,"_23867":46935,"_2386":46936},[],"/docs/pr-preview/pr-43/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_2859":1933,"_25205":1927,"_5":25537,"_17596":46938,"_23867":46939,"_2386":46940},[],"/docs/pr-preview/pr-43/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_2859":1934,"_25205":1927,"_5":25537,"_17596":46942,"_23867":46943,"_2386":46944},[],"/docs/pr-preview/pr-43/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_2859":1935,"_25205":1927,"_5":25537,"_17596":46946,"_23867":46947,"_2386":46948},[],"/docs/pr-preview/pr-43/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_2859":1936,"_25205":1927,"_5":25537,"_17596":46950,"_23867":46951,"_2386":46952},[],"/docs/pr-preview/pr-43/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_2859":1937,"_25205":1927,"_5":25537,"_17596":46954,"_23867":46955,"_2386":46956},[],"/docs/pr-preview/pr-43/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_2859":1938,"_25205":1927,"_5":25537,"_17596":46958,"_23867":46959,"_2386":46960},[],"/docs/pr-preview/pr-43/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_2859":1939,"_25205":1927,"_17596":46962,"_5":17486,"_23867":1927,"_2386":46963},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_2859":1940,"_25205":1927,"_17596":46965,"_5":17486,"_23867":46927,"_2386":46966},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_2859":1941,"_25205":1927,"_17596":46968,"_5":17486,"_23867":46931,"_2386":46969},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_2859":1942,"_25205":1927,"_17596":46971,"_5":17486,"_23867":46935,"_2386":46972},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_2859":1943,"_25205":1927,"_17596":46974,"_5":17486,"_23867":46939,"_2386":46975},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_2859":1944,"_25205":1927,"_17596":46977,"_5":17486,"_23867":46943,"_2386":46978},[],"The device proves it can enroll according to the DMS policy.",{"_2859":1945,"_25205":1927,"_17596":46980,"_5":17486,"_23867":46943,"_2386":46981},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_2859":1946,"_25205":1927,"_17596":46983,"_5":17486,"_23867":46943,"_2386":46984},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_2859":1947,"_25205":1927,"_17596":46986,"_5":17486,"_23867":46943,"_2386":46987},[],"The device installs the certificate and the chain it needs.",{"_2859":1948,"_25205":1927,"_17596":46989,"_5":17486,"_23867":46943,"_2386":46990},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_2859":1949,"_25205":1927,"_17596":46992,"_5":17486,"_23867":46943,"_2386":46993},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_2859":1950,"_25205":1927,"_17596":46995,"_5":17486,"_23867":46947,"_2386":46996},[],"A DMS relates three sets that are worth designing separately:",{"_2859":1951,"_25205":1927,"_17596":46998,"_5":17486,"_23867":46947,"_2386":46999},[],"**Enrollment CA:** signs the new identities.",{"_2859":1952,"_25205":1927,"_17596":47001,"_5":17486,"_23867":46947,"_2386":47002},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, Lamassu tries the enrollment CA first and then the additional validation CAs.",{"_2859":1953,"_25205":1927,"_17596":47004,"_5":17486,"_23867":46947,"_2386":47005},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_2859":1954,"_25205":1927,"_17596":47007,"_5":17486,"_23867":46947,"_2386":47008},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_2859":1955,"_25205":1927,"_17596":47010,"_5":17486,"_23867":46951,"_2386":47011},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_2859":1956,"_25205":1927,"_17596":47013,"_5":17486,"_23867":46951,"_2386":47014},[],"that the current date is between `Not Before` and `Not After`;",{"_2859":1957,"_25205":1927,"_17596":47016,"_5":17486,"_23867":46951,"_2386":47017},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_2859":1958,"_25205":1927,"_17596":47019,"_5":17486,"_23867":46951,"_2386":47020},[],"that names, SANs and subject match the expected identity;",{"_2859":1959,"_25205":1927,"_17596":47022,"_5":17486,"_23867":46951,"_2386":47023},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_2859":1960,"_25205":1927,"_17596":47025,"_5":17486,"_23867":46951,"_2386":47026},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_2859":1961,"_25205":1927,"_17596":47028,"_5":17486,"_23867":46951,"_2386":47029},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_2859":1962,"_25205":1927,"_17596":47031,"_5":17486,"_23867":46955,"_2386":47032},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_2859":1963,"_25205":1927,"_17596":47034,"_5":17486,"_23867":46959,"_2386":47035},[],"Keep the root out of daily operations, or with very restricted access.",{"_2859":1964,"_25205":1927,"_17596":47037,"_5":17486,"_23867":46959,"_2386":47038},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_2859":1965,"_25205":1927,"_17596":47040,"_5":17486,"_23867":46959,"_2386":47041},[],"Assign explicit profiles to every use case.",{"_2859":1966,"_25205":1927,"_17596":47043,"_5":17486,"_23867":46959,"_2386":47044},[],"Distribute the new trust before starting a rotation.",{"_2859":1967,"_25205":1927,"_17596":47046,"_5":17486,"_23867":46959,"_2386":47047},[],"Keep enough overlap to renew a disconnected fleet.",{"_2859":1968,"_25205":1927,"_17596":47049,"_5":17486,"_23867":46959,"_2386":47050},[],"Validate from the consuming system, not only from the Lamassu console.",{"_2859":1969,"_25205":1927,"_17596":47052,"_5":17486,"_23867":46959,"_2386":47053},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_2859":1970,"_25205":1970,"_5":12316,"_2386":47055,"_25540":47056,"_17596":47057,"_23867":1970},"Revocation lists (CRL)",[40894,42238,45925,46542],[],{"_2859":1971,"_25205":1970,"_17596":47059,"_5":17486,"_23867":1970,"_2386":47060},[],"Generate and distribute signed lists to validate certificates offline.",{"_2859":1972,"_25205":1970,"_5":25537,"_17596":47062,"_23867":47063,"_2386":47064},[],"/docs/pr-preview/pr-43/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_2859":1973,"_25205":1970,"_5":25537,"_17596":47066,"_23867":47067,"_2386":47068},[],"/docs/pr-preview/pr-43/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_2859":1974,"_25205":1970,"_5":25537,"_17596":47070,"_23867":47071,"_2386":47072},[],"/docs/pr-preview/pr-43/platform/pki/crl#crl-contents","CRL contents",{"_2859":1975,"_25205":1970,"_5":25537,"_17596":47074,"_23867":47075,"_2386":47076},[],"/docs/pr-preview/pr-43/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_2859":1976,"_25205":1970,"_5":25537,"_17596":47078,"_23867":47079,"_2386":47080},[],"/docs/pr-preview/pr-43/platform/pki/crl#va-role-management-api","VA role management API",{"_2859":1977,"_25205":1970,"_5":25537,"_17596":47082,"_23867":47083,"_2386":47084},[],"/docs/pr-preview/pr-43/platform/pki/crl#from-the-interface","From the interface",{"_2859":1978,"_25205":1970,"_5":25537,"_17596":47086,"_23867":47087,"_2386":47088},[],"/docs/pr-preview/pr-43/platform/pki/crl#references","References",{"_2859":1979,"_25205":1970,"_17596":47090,"_5":17486,"_23867":1970,"_2386":47091},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_2859":1980,"_25205":1970,"_17596":47093,"_5":17486,"_23867":47063,"_2386":47094},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_2859":1981,"_25205":1970,"_17596":47096,"_5":17486,"_23867":47063,"_2386":47097},[],"`crl_options` field",{"_2859":1982,"_25205":1970,"_17596":47099,"_5":17486,"_23867":47063,"_2386":41277},[],{"_2859":1983,"_25205":1970,"_17596":47101,"_5":17486,"_23867":47063,"_2386":47102},[],"Backend initial value",{"_2859":1984,"_25205":1970,"_17596":47104,"_5":17486,"_23867":47063,"_2386":47105},[],"`validity`",{"_2859":1985,"_25205":1970,"_17596":47107,"_5":17486,"_23867":47063,"_2386":47108},[],"Time from `thisUpdate` to `nextUpdate`.",{"_2859":1986,"_25205":1970,"_17596":47110,"_5":17486,"_23867":47063,"_2386":47111},[],"7 days.",{"_2859":1987,"_25205":1970,"_17596":47113,"_5":17486,"_23867":47063,"_2386":47114},[],"`refresh_interval`",{"_2859":1988,"_25205":1970,"_17596":47116,"_5":17486,"_23867":47063,"_2386":47117},[],"Time since publication that triggers scheduled renewal.",{"_2859":1989,"_25205":1970,"_17596":47119,"_5":17486,"_23867":47063,"_2386":47120},[],"6 days and 23 hours.",{"_2859":1990,"_25205":1970,"_17596":47122,"_5":17486,"_23867":47063,"_2386":47123},[],"`regenerate_on_revoke`",{"_2859":1991,"_25205":1970,"_17596":47125,"_5":17486,"_23867":47063,"_2386":47126},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_2859":1992,"_25205":1970,"_17596":47128,"_5":17486,"_23867":47063,"_2386":47129},[],"`true`.",{"_2859":1993,"_25205":1970,"_17596":47131,"_5":17486,"_23867":47063,"_2386":47132},[],"`subject_key_id_signer`",{"_2859":1994,"_25205":1970,"_17596":47134,"_5":17486,"_23867":47063,"_2386":47135},[],"Configuration field initialized with the CA’s SKI.",{"_2859":1995,"_25205":1970,"_17596":47137,"_5":17486,"_23867":47063,"_2386":47138},[],"CA SKI.",{"_2859":1996,"_25205":1970,"_17596":47140,"_5":17486,"_23867":47063,"_2386":47141},[],"The generator uses the key of the CA identified by the requested SKI. Do not interpret `subject_key_id_signer` as verified support for a different delegated CA: changing that field does not change the signer in this flow.",{"_2859":1997,"_25205":1970,"_17596":47143,"_5":17486,"_23867":47063,"_2386":47144},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_2859":1998,"_25205":1970,"_17596":47146,"_5":17486,"_23867":47067,"_2386":47147},[],"The scheduled job requests another list when `refresh_interval` is reached or when the list approaches expiration within the configured watch period. This depends on working jobs, storage and signing; it does not guarantee renewal during a service failure.",{"_2859":1999,"_25205":1970,"_17596":47149,"_5":17486,"_23867":47067,"_2386":47150},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_2859":2000,"_25205":1970,"_17596":47152,"_5":17486,"_23867":47067,"_2386":47153},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_2859":2001,"_25205":1970,"_17596":47155,"_5":17486,"_23867":47071,"_2386":47156},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_2859":2002,"_25205":1970,"_17596":47158,"_5":17486,"_23867":47071,"_2386":47159},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_2859":2003,"_25205":1970,"_17596":47161,"_5":17486,"_23867":47075,"_2386":47162},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_2859":2004,"_25205":1970,"_17596":47164,"_5":17486,"_23867":47075,"_2386":47165},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_2859":2005,"_25205":1970,"_17596":47167,"_5":17486,"_23867":47075,"_2386":47168},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_2859":2006,"_25205":1970,"_17596":47170,"_5":17486,"_23867":47075,"_2386":47171},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_2859":2007,"_25205":1970,"_17596":47173,"_5":17486,"_23867":47075,"_2386":47174},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_2859":2008,"_25205":1970,"_17596":47176,"_5":17486,"_23867":47079,"_2386":47177},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_2859":2009,"_25205":1970,"_17596":47179,"_5":17486,"_23867":47079,"_2386":43959},[],{"_2859":2010,"_25205":1970,"_17596":47181,"_5":17486,"_23867":47079,"_2386":47182},[],"Relative path",{"_2859":2011,"_25205":1970,"_17596":47184,"_5":17486,"_23867":47079,"_2386":43956},[],{"_2859":2012,"_25205":1970,"_17596":47186,"_5":17486,"_23867":47079,"_2386":47187},[],"`GET`",{"_2859":2013,"_25205":1970,"_17596":47189,"_5":17486,"_23867":47079,"_2386":47190},[],"`/v1/roles/{ca-ski}`",{"_2859":2014,"_25205":1970,"_17596":47192,"_5":17486,"_23867":47079,"_2386":47193},[],"Read `crl_options` and `latest_crl`.",{"_2859":2015,"_25205":1970,"_17596":47195,"_5":17486,"_23867":47079,"_2386":47196},[],"`PUT`",{"_2859":2016,"_25205":1970,"_17596":47198,"_5":17486,"_23867":47079,"_2386":47190},[],{"_2859":2017,"_25205":1970,"_17596":47200,"_5":17486,"_23867":47079,"_2386":47201},[],"Replace CRL configuration.",{"_2859":2018,"_25205":1970,"_17596":47203,"_5":17486,"_23867":47079,"_2386":47204},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_2859":2019,"_25205":1970,"_17596":47206,"_5":17486,"_23867":47079,"_2386":47207},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_2859":2020,"_25205":1970,"_17596":47209,"_5":17486,"_23867":47083,"_2386":47210},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_2859":2021,"_25205":1970,"_17596":47212,"_5":17486,"_23867":47087,"_2386":47213},[],"RFC 5280: X.509 and CRL profile.",{"_2859":2022,"_25205":1970,"_17596":47215,"_5":17486,"_23867":47087,"_2386":47216},[],"OpenSSL: openssl-crl.",{"_2859":2023,"_25205":1970,"_17596":47218,"_5":17486,"_23867":47087,"_2386":47219},[],"OpenSSL: openssl-verify.",{"_2859":2024,"_25205":1970,"_17596":47221,"_5":17486,"_23867":47087,"_2386":47222},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_2859":2025,"_25205":1970,"_17596":47224,"_5":17486,"_23867":47087,"_2386":47225},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2859":2026,"_25205":2026,"_5":12316,"_2386":47227,"_25540":47228,"_17596":47229,"_23867":2026},"Keys and cryptographic engines",[40894,42238,45925,45926],[],{"_2859":2027,"_25205":2026,"_17596":47231,"_5":17486,"_23867":2026,"_2386":47232},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_2859":2028,"_25205":2026,"_5":25537,"_17596":47234,"_23867":47235,"_2386":47236},[],"/docs/pr-preview/pr-43/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_2859":2029,"_25205":2026,"_5":25537,"_17596":47238,"_23867":47239,"_2386":47240},[],"/docs/pr-preview/pr-43/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_2859":2030,"_25205":2026,"_5":25537,"_17596":47242,"_23867":47243,"_2386":47244},[],"/docs/pr-preview/pr-43/platform/pki/key-management#file-system","File System",{"_2859":2031,"_25205":2026,"_5":25537,"_17596":47246,"_23867":47247,"_2386":47248},[],"/docs/pr-preview/pr-43/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_2859":2032,"_25205":2026,"_5":25537,"_17596":47250,"_23867":47251,"_2386":47252},[],"/docs/pr-preview/pr-43/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_2859":2033,"_25205":2026,"_5":25537,"_17596":47254,"_23867":47255,"_2386":47256},[],"/docs/pr-preview/pr-43/platform/pki/key-management#aws-kms","AWS KMS",{"_2859":2034,"_25205":2026,"_5":25537,"_17596":47258,"_23867":47259,"_2386":47260},[],"/docs/pr-preview/pr-43/platform/pki/key-management#pkcs11","PKCS#11",{"_2859":2035,"_25205":2026,"_5":25537,"_17596":47262,"_23867":47263,"_2386":47264},[],"/docs/pr-preview/pr-43/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_2859":2036,"_25205":2026,"_5":25537,"_17596":47266,"_23867":47267,"_2386":47268},[],"/docs/pr-preview/pr-43/platform/pki/key-management#key-inventory","Key inventory",{"_2859":2037,"_25205":2026,"_5":25537,"_17596":47270,"_23867":47271,"_2386":47272},[],"/docs/pr-preview/pr-43/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_2859":2038,"_25205":2026,"_5":25537,"_17596":47274,"_23867":47275,"_2386":47276},[],"/docs/pr-preview/pr-43/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_2859":2039,"_25205":2026,"_5":25537,"_17596":47278,"_23867":47279,"_2386":47280},[],"/docs/pr-preview/pr-43/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_2859":2040,"_25205":2026,"_5":25537,"_17596":47282,"_23867":47283,"_2386":47284},[],"/docs/pr-preview/pr-43/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_2859":2041,"_25205":2026,"_5":25537,"_17596":47286,"_23867":47287,"_2386":47288},[],"/docs/pr-preview/pr-43/platform/pki/key-management#view-details","View details",{"_2859":2042,"_25205":2026,"_5":25537,"_17596":47290,"_23867":47291,"_2386":47292},[],"/docs/pr-preview/pr-43/platform/pki/key-management#sign-and-verify","Sign and verify",{"_2859":2043,"_25205":2026,"_5":25537,"_17596":47294,"_23867":47295,"_2386":47296},[],"/docs/pr-preview/pr-43/platform/pki/key-management#sign","Sign",{"_2859":2044,"_25205":2026,"_5":25537,"_17596":47298,"_23867":47299,"_2386":47300},[],"/docs/pr-preview/pr-43/platform/pki/key-management#verify","Verify",{"_2859":2045,"_25205":2026,"_5":25537,"_17596":47302,"_23867":47303,"_2386":47304},[],"/docs/pr-preview/pr-43/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_2859":2046,"_25205":2026,"_5":25537,"_17596":47306,"_23867":47307,"_2386":47308},[],"/docs/pr-preview/pr-43/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_2859":2047,"_25205":2026,"_5":25537,"_17596":47310,"_23867":47311,"_2386":47312},[],"/docs/pr-preview/pr-43/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_2859":2048,"_25205":2026,"_17596":47314,"_5":17486,"_23867":2026,"_2386":47315},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_2859":2049,"_25205":2026,"_17596":47317,"_5":17486,"_23867":2026,"_2386":47318},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_2859":2050,"_25205":2026,"_17596":47320,"_5":17486,"_23867":47235,"_2386":47321},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_2859":2051,"_25205":2026,"_17596":47323,"_5":17486,"_23867":47235,"_2386":47324},[],"In practice, it lets you:",{"_2859":2052,"_25205":2026,"_17596":47326,"_5":17486,"_23867":47235,"_2386":47327},[],"Generate new key pairs from Lamassu IoT.",{"_2859":2053,"_25205":2026,"_17596":47329,"_5":17486,"_23867":47235,"_2386":47330},[],"Import keys created externally.",{"_2859":2054,"_25205":2026,"_17596":47332,"_5":17486,"_23867":47235,"_2386":47333},[],"Delegate custody and cryptographic operations to external engines.",{"_2859":2055,"_25205":2026,"_17596":47335,"_5":17486,"_23867":47235,"_2386":47336},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_2859":2056,"_25205":2026,"_17596":47338,"_5":17486,"_23867":47239,"_2386":47339},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_2859":2057,"_25205":2026,"_17596":47341,"_5":17486,"_23867":47239,"_2386":47342},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_2859":2058,"_25205":2026,"_17596":47344,"_5":17486,"_23867":47239,"_2386":47345},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_2859":2059,"_25205":2026,"_17596":47347,"_5":17486,"_23867":47243,"_2386":47348},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_2859":2060,"_25205":2026,"_17596":47350,"_5":17486,"_23867":47247,"_2386":47351},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_2859":2061,"_25205":2026,"_17596":47353,"_5":17486,"_23867":47251,"_2386":47354},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_2859":2062,"_25205":2026,"_17596":47356,"_5":17486,"_23867":47255,"_2386":47357},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_2859":2063,"_25205":2026,"_17596":47359,"_5":17486,"_23867":47259,"_2386":47360},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_2859":2064,"_25205":2026,"_17596":47362,"_5":17486,"_23867":47263,"_2386":47363},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_2859":2065,"_25205":2026,"_17596":47365,"_5":17486,"_23867":47263,"_2386":47366},[],"Lamassu shows the enabled engines in the console.",{"_2859":2066,"_25205":2026,"_17596":47368,"_5":17486,"_23867":47263,"_2386":47369},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_2859":2067,"_25205":2026,"_17596":47371,"_5":17486,"_23867":47263,"_2386":47372},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_2859":2068,"_25205":2026,"_17596":47374,"_5":17486,"_23867":47267,"_2386":47375},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_2859":2069,"_25205":2026,"_17596":47377,"_5":17486,"_23867":47267,"_2386":47378},[],"The table includes the following fields:",{"_2859":2070,"_25205":2026,"_17596":47380,"_5":17486,"_23867":47267,"_2386":47381},[],"**Name**: descriptive name of the key.",{"_2859":2071,"_25205":2026,"_17596":47383,"_5":17486,"_23867":47267,"_2386":47384},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_2859":2072,"_25205":2026,"_17596":47386,"_5":17486,"_23867":47267,"_2386":47387},[],"**Strength**: visual indicator of cryptographic strength.",{"_2859":2073,"_25205":2026,"_17596":47389,"_5":17486,"_23867":47267,"_2386":47390},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_2859":2074,"_25205":2026,"_17596":47392,"_5":17486,"_23867":47267,"_2386":47393},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_2859":2075,"_25205":2026,"_17596":47395,"_5":17486,"_23867":47267,"_2386":47396},[],"**Aliases**: alternative names associated with the key.",{"_2859":2076,"_25205":2026,"_17596":47398,"_5":17486,"_23867":47267,"_2386":47399},[],"**Tags**: labels for classification and search.",{"_2859":2077,"_25205":2026,"_17596":47401,"_5":17486,"_23867":47267,"_2386":47402},[],"**Related Entities**: certificates or other entities linked to that key.",{"_2859":2078,"_25205":2026,"_17596":47404,"_5":17486,"_23867":47267,"_2386":47405},[],"From this view you also reach the most common actions:",{"_2859":2079,"_25205":2026,"_17596":47407,"_5":17486,"_23867":47267,"_2386":47408},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_2859":2080,"_25205":2026,"_17596":47410,"_5":17486,"_23867":47267,"_2386":47411},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_2859":2081,"_25205":2026,"_17596":47413,"_5":17486,"_23867":47267,"_2386":47414},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_2859":2082,"_25205":2026,"_17596":47416,"_5":17486,"_23867":47267,"_2386":47417},[],"**Delete Key** to remove the key from the system.",{"_2859":2083,"_25205":2026,"_17596":47419,"_5":17486,"_23867":47271,"_2386":47420},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_2859":2084,"_25205":2026,"_17596":47422,"_5":17486,"_23867":47275,"_2386":47423},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_2859":2085,"_25205":2026,"_17596":47425,"_5":17486,"_23867":47275,"_2386":47426},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_2859":2086,"_25205":2026,"_17596":47428,"_5":17486,"_23867":47275,"_2386":47429},[],"**Key Name**: unique and descriptive name.",{"_2859":2087,"_25205":2026,"_17596":47431,"_5":17486,"_23867":47275,"_2386":47432},[],"**Crypto Engine**: engine that will keep the key.",{"_2859":2088,"_25205":2026,"_17596":47434,"_5":17486,"_23867":47275,"_2386":47435},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_2859":2089,"_25205":2026,"_17596":47437,"_5":17486,"_23867":47275,"_2386":47438},[],"**Tags**: metadata to classify the key.",{"_2859":2090,"_25205":2026,"_17596":47440,"_5":17486,"_23867":47275,"_2386":47441},[],"**Metadata**: additional information for advanced uses.",{"_2859":2091,"_25205":2026,"_17596":47443,"_5":17486,"_23867":47279,"_2386":47444},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_2859":2092,"_25205":2026,"_17596":47446,"_5":17486,"_23867":47279,"_2386":47447},[],"When you have an exportable private key and the destination engine supports import.",{"_2859":2093,"_25205":2026,"_17596":47449,"_5":17486,"_23867":47279,"_2386":47450},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_2859":2094,"_25205":2026,"_17596":47452,"_5":17486,"_23867":47279,"_2386":47453},[],"When Lamassu must operate with a root of trust created by a third party.",{"_2859":2095,"_25205":2026,"_17596":47455,"_5":17486,"_23867":47279,"_2386":47456},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_2859":2096,"_25205":2026,"_17596":47458,"_5":17486,"_23867":47279,"_2386":47459},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_2859":2097,"_25205":2026,"_17596":47461,"_5":17486,"_23867":47279,"_2386":47462},[],"**Crypto Engine**: engine that will keep the imported key.",{"_2859":2098,"_25205":2026,"_17596":47464,"_5":17486,"_23867":47279,"_2386":47465},[],"**Tags**: labels for organization and search.",{"_2859":2099,"_25205":2026,"_17596":47467,"_5":17486,"_23867":47279,"_2386":47468},[],"**Metadata**: additional optional information.",{"_2859":2100,"_25205":2026,"_17596":47470,"_5":17486,"_23867":47279,"_2386":47471},[],"**Private Key (PEM)**: private key in PEM format.",{"_2859":2101,"_25205":2026,"_17596":47473,"_5":17486,"_23867":47279,"_2386":47474},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_2859":2102,"_25205":2026,"_17596":47476,"_5":17486,"_23867":47283,"_2386":47477},[],"Each registered key has a detail view and several operational actions.",{"_2859":2103,"_25205":2026,"_17596":47479,"_5":17486,"_23867":47287,"_2386":47480},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_2859":2104,"_25205":2026,"_17596":47482,"_5":17486,"_23867":47287,"_2386":47483},[],"The **Overview** tab shows, among others, these fields:",{"_2859":2105,"_25205":2026,"_17596":47485,"_5":17486,"_23867":47287,"_2386":47486},[],"**Key Name**: descriptive name.",{"_2859":2106,"_25205":2026,"_17596":47488,"_5":17486,"_23867":47287,"_2386":47489},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_2859":2107,"_25205":2026,"_17596":47491,"_5":17486,"_23867":47287,"_2386":47492},[],"**Tags**: associated labels.",{"_2859":2108,"_25205":2026,"_17596":47494,"_5":17486,"_23867":47287,"_2386":47495},[],"**Aliases**: alternative names.",{"_2859":2109,"_25205":2026,"_17596":47497,"_5":17486,"_23867":47287,"_2386":47498},[],"**Crypto Engine**: engine where the key resides.",{"_2859":2110,"_25205":2026,"_17596":47500,"_5":17486,"_23867":47287,"_2386":47501},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_2859":2111,"_25205":2026,"_17596":47503,"_5":17486,"_23867":47287,"_2386":47504},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_2859":2112,"_25205":2026,"_17596":47506,"_5":17486,"_23867":47287,"_2386":47507},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_2859":2113,"_25205":2026,"_17596":47509,"_5":17486,"_23867":47291,"_2386":47510},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_2859":2114,"_25205":2026,"_17596":47512,"_5":17486,"_23867":47291,"_2386":47513},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_2859":2115,"_25205":2026,"_17596":47515,"_5":17486,"_23867":47291,"_2386":47516},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_2859":2116,"_25205":2026,"_17596":47518,"_5":17486,"_23867":47295,"_2386":47519},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_2859":2117,"_25205":2026,"_17596":47521,"_5":17486,"_23867":47295,"_2386":47522},[],"Main fields:",{"_2859":2118,"_25205":2026,"_17596":47524,"_5":17486,"_23867":47295,"_2386":47525},[],"**Algorithm**: signing algorithm available for the key type.",{"_2859":2119,"_25205":2026,"_17596":47527,"_5":17486,"_23867":47295,"_2386":47528},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_2859":2120,"_25205":2026,"_17596":47530,"_5":17486,"_23867":47295,"_2386":47531},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_2859":2121,"_25205":2026,"_17596":47533,"_5":17486,"_23867":47295,"_2386":47534},[],"**Message**: content to sign.",{"_2859":2122,"_25205":2026,"_17596":47536,"_5":17486,"_23867":47295,"_2386":47537},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_2859":2123,"_25205":2026,"_17596":47539,"_5":17486,"_23867":47299,"_2386":47540},[],"This tab checks whether a signature corresponds to the associated public key.",{"_2859":2124,"_25205":2026,"_17596":47542,"_5":17486,"_23867":47299,"_2386":47522},[],{"_2859":2125,"_25205":2026,"_17596":47544,"_5":17486,"_23867":47299,"_2386":47545},[],"**Algorithm**: must match the algorithm used for the signature.",{"_2859":2126,"_25205":2026,"_17596":47547,"_5":17486,"_23867":47299,"_2386":47548},[],"**Message Type**: `Raw` or `Digest`.",{"_2859":2127,"_25205":2026,"_17596":47550,"_5":17486,"_23867":47299,"_2386":47551},[],"**Payload Encoding**: encoding of the message.",{"_2859":2128,"_25205":2026,"_17596":47553,"_5":17486,"_23867":47299,"_2386":47554},[],"**Message**: original message or hash.",{"_2859":2129,"_25205":2026,"_17596":47556,"_5":17486,"_23867":47299,"_2386":47557},[],"**Signature**: signature to check.",{"_2859":2130,"_25205":2026,"_17596":47559,"_5":17486,"_23867":47299,"_2386":47560},[],"**Result**: indicator of the validation result.",{"_2859":2131,"_25205":2026,"_17596":47562,"_5":17486,"_23867":47303,"_2386":47563},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_2859":2132,"_25205":2026,"_17596":47565,"_5":17486,"_23867":47303,"_2386":47566},[],"This flow is useful for:",{"_2859":2133,"_25205":2026,"_17596":47568,"_5":17486,"_23867":47303,"_2386":47569},[],"Requesting certificates from an external CA.",{"_2859":2134,"_25205":2026,"_17596":47571,"_5":17486,"_23867":47303,"_2386":47572},[],"Renewing an identity while keeping the same key.",{"_2859":2135,"_25205":2026,"_17596":47574,"_5":17486,"_23867":47303,"_2386":47575},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_2859":2136,"_25205":2026,"_17596":47577,"_5":17486,"_23867":47303,"_2386":47578},[],"**Common Name (CN)**: main name of the identity.",{"_2859":2137,"_25205":2026,"_17596":47580,"_5":17486,"_23867":47303,"_2386":47581},[],"**Organization (O)**: organization or company.",{"_2859":2138,"_25205":2026,"_17596":47583,"_5":17486,"_23867":47303,"_2386":47584},[],"**Organizational Unit (OU)**: department or unit.",{"_2859":2139,"_25205":2026,"_17596":47586,"_5":17486,"_23867":47303,"_2386":47587},[],"**Country (C)**: two-letter country code.",{"_2859":2140,"_25205":2026,"_17596":47589,"_5":17486,"_23867":47303,"_2386":47590},[],"**State / Province (ST)**: state or province.",{"_2859":2141,"_25205":2026,"_17596":47592,"_5":17486,"_23867":47303,"_2386":47593},[],"**Locality (L)**: city or locality.",{"_2859":2142,"_25205":2026,"_17596":47595,"_5":17486,"_23867":47303,"_2386":47596},[],"**Email Address**: contact email.",{"_2859":2143,"_25205":2026,"_17596":47598,"_5":17486,"_23867":47303,"_2386":47599},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_2859":2144,"_25205":2026,"_17596":47601,"_5":17486,"_23867":47303,"_2386":47602},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_2859":2145,"_25205":2026,"_17596":47604,"_5":17486,"_23867":47307,"_2386":47605},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_2859":2146,"_25205":2026,"_17596":47607,"_5":17486,"_23867":47307,"_2386":47608},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_2859":2147,"_25205":2026,"_17596":47610,"_5":17486,"_23867":47311,"_2386":47611},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_2859":2148,"_25205":2148,"_5":12316,"_2386":47613,"_25540":47614,"_17596":47615,"_23867":2148},"Online validation with OCSP",[40894,42238,45925,46542],[],{"_2859":2149,"_25205":2148,"_17596":47617,"_5":17486,"_23867":2148,"_2386":47618},[],"Query signed status and verify the responder’s response.",{"_2859":2150,"_25205":2148,"_5":25537,"_17596":47620,"_23867":47621,"_2386":47622},[],"/docs/pr-preview/pr-43/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_2859":2151,"_25205":2148,"_5":25537,"_17596":47624,"_23867":47625,"_2386":47626},[],"/docs/pr-preview/pr-43/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_2859":2152,"_25205":2148,"_5":25537,"_17596":47628,"_23867":47629,"_2386":47630},[],"/docs/pr-preview/pr-43/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_2859":2153,"_25205":2148,"_5":25537,"_17596":47632,"_23867":47633,"_2386":47634},[],"/docs/pr-preview/pr-43/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_2859":2154,"_25205":2148,"_5":25537,"_17596":47636,"_23867":47637,"_2386":47638},[],"/docs/pr-preview/pr-43/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_2859":2155,"_25205":2148,"_5":25537,"_17596":47640,"_23867":47641,"_2386":47088},[],"/docs/pr-preview/pr-43/platform/pki/ocsp#references",{"_2859":2156,"_25205":2148,"_17596":47643,"_5":17486,"_23867":2148,"_2386":47644},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_2859":2157,"_25205":2148,"_17596":47646,"_5":17486,"_23867":47621,"_2386":47647},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_2859":2158,"_25205":2148,"_17596":47649,"_5":17486,"_23867":47621,"_2386":47650},[],"Record status",{"_2859":2159,"_25205":2148,"_17596":47652,"_5":17486,"_23867":47621,"_2386":47653},[],"Signed response",{"_2859":2160,"_25205":2148,"_17596":47655,"_5":17486,"_23867":47621,"_2386":45094},[],{"_2859":2161,"_25205":2148,"_17596":47657,"_5":17486,"_23867":47621,"_2386":47658},[],"`Good`.",{"_2859":2162,"_25205":2148,"_17596":47660,"_5":17486,"_23867":47621,"_2386":45111},[],{"_2859":2163,"_25205":2148,"_17596":47662,"_5":17486,"_23867":47621,"_2386":47663},[],"`Revoked`, with revocation reason and timestamp.",{"_2859":2164,"_25205":2148,"_17596":47665,"_5":17486,"_23867":47621,"_2386":47666},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_2859":2165,"_25205":2148,"_17596":47668,"_5":17486,"_23867":47621,"_2386":47669},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_2859":2166,"_25205":2148,"_17596":47671,"_5":17486,"_23867":47621,"_2386":47672},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_2859":2167,"_25205":2148,"_17596":47674,"_5":17486,"_23867":47621,"_2386":47675},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_2859":2168,"_25205":2148,"_17596":47677,"_5":17486,"_23867":47621,"_2386":47678},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_2859":2169,"_25205":2148,"_17596":47680,"_5":17486,"_23867":47625,"_2386":47681},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_2859":2170,"_25205":2148,"_17596":47683,"_5":17486,"_23867":47625,"_2386":47684},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_2859":2171,"_25205":2148,"_17596":47686,"_5":17486,"_23867":47629,"_2386":47687},[],"The service accepts:",{"_2859":2172,"_25205":2148,"_17596":47689,"_5":17486,"_23867":47629,"_2386":43959},[],{"_2859":2173,"_25205":2148,"_17596":47691,"_5":17486,"_23867":47629,"_2386":47692},[],"VA service path",{"_2859":2174,"_25205":2148,"_17596":47694,"_5":17486,"_23867":47629,"_2386":47695},[],"Format",{"_2859":2175,"_25205":2148,"_17596":47697,"_5":17486,"_23867":47629,"_2386":47698},[],"`POST`",{"_2859":2176,"_25205":2148,"_17596":47700,"_5":17486,"_23867":47629,"_2386":47701},[],"`/ocsp`",{"_2859":2177,"_25205":2148,"_17596":47703,"_5":17486,"_23867":47629,"_2386":47704},[],"DER request, `Content-Type: application/ocsp-request`.",{"_2859":2178,"_25205":2148,"_17596":47706,"_5":17486,"_23867":47629,"_2386":47187},[],{"_2859":2179,"_25205":2148,"_17596":47708,"_5":17486,"_23867":47629,"_2386":47709},[],"`/ocsp/{ocsp_request}`",{"_2859":2180,"_25205":2148,"_17596":47711,"_5":17486,"_23867":47629,"_2386":47712},[],"DER request encoded using padded URL Base64.",{"_2859":2181,"_25205":2148,"_17596":47714,"_5":17486,"_23867":47629,"_2386":47715},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_2859":2182,"_25205":2148,"_17596":47717,"_5":17486,"_23867":47633,"_2386":47718},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_2859":2183,"_25205":2148,"_17596":47720,"_5":17486,"_23867":47633,"_2386":47721},[],"Generate the request:",{"_2859":2184,"_25205":2148,"_17596":47723,"_5":17486,"_23867":47633,"_2386":47724},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_2859":2185,"_25205":2148,"_17596":47726,"_5":17486,"_23867":47633,"_2386":47727},[],"Replace the example URL with the inspected endpoint:",{"_2859":2186,"_25205":2148,"_17596":47729,"_5":17486,"_23867":47633,"_2386":47730},[],"Verify the returned DER:",{"_2859":2187,"_25205":2148,"_17596":47732,"_5":17486,"_23867":47633,"_2386":47733},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_2859":2188,"_25205":2148,"_17596":47735,"_5":17486,"_23867":47637,"_2386":47736},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_2859":2189,"_25205":2148,"_17596":47738,"_5":17486,"_23867":47637,"_2386":47739},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_2859":2190,"_25205":2148,"_17596":47741,"_5":17486,"_23867":47641,"_2386":47742},[],"RFC 6960: OCSP.",{"_2859":2191,"_25205":2148,"_17596":47744,"_5":17486,"_23867":47641,"_2386":47745},[],"OpenSSL: openssl-ocsp.",{"_2859":2192,"_25205":2148,"_17596":47747,"_5":17486,"_23867":47641,"_2386":47748},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_2859":2193,"_25205":2148,"_17596":47750,"_5":17486,"_23867":47641,"_2386":47225},[],{"_2859":2194,"_25205":2194,"_5":12316,"_2386":45925,"_25540":47752,"_17596":47753,"_23867":2194},[40894,42238,45925],[],{"_2859":2195,"_25205":2194,"_17596":47755,"_5":17486,"_23867":2194,"_2386":47756},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_2859":2196,"_25205":2194,"_5":25537,"_17596":47758,"_23867":47759,"_2386":45235},[],"/docs/pr-preview/pr-43/platform/pki/overview#start-here",{"_2859":2197,"_25205":2194,"_5":25537,"_17596":47761,"_23867":47762,"_2386":47763},[],"/docs/pr-preview/pr-43/platform/pki/overview#what-you-need","What you need",{"_2859":2198,"_25205":2194,"_5":25537,"_17596":47765,"_23867":47766,"_2386":45769},[],"/docs/pr-preview/pr-43/platform/pki/overview#core-capabilities",{"_2859":2199,"_25205":2194,"_5":25537,"_17596":47768,"_23867":47769,"_2386":45773},[],"/docs/pr-preview/pr-43/platform/pki/overview#build-your-trust-hierarchy",{"_2859":2200,"_25205":2194,"_5":25537,"_17596":47771,"_23867":47772,"_2386":45777},[],"/docs/pr-preview/pr-43/platform/pki/overview#protect-cryptographic-keys",{"_2859":2201,"_25205":2194,"_5":25537,"_17596":47774,"_23867":47775,"_2386":45781},[],"/docs/pr-preview/pr-43/platform/pki/overview#issue-and-control-certificates",{"_2859":2202,"_25205":2194,"_5":25537,"_17596":47777,"_23867":47778,"_2386":45789},[],"/docs/pr-preview/pr-43/platform/pki/overview#publish-validation-status",{"_2859":2203,"_25205":2194,"_5":25537,"_17596":47780,"_23867":47781,"_2386":47782},[],"/docs/pr-preview/pr-43/platform/pki/overview#how-to-check-the-result","How to check the result",{"_2859":2204,"_25205":2194,"_5":25537,"_17596":47784,"_23867":47785,"_2386":46709},[],"/docs/pr-preview/pr-43/platform/pki/overview#continue",{"_2859":2205,"_25205":2194,"_17596":47787,"_5":17486,"_23867":2194,"_2386":47788},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_2859":2206,"_25205":2194,"_17596":47790,"_5":17486,"_23867":47759,"_2386":47791},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_2859":2207,"_25205":2194,"_17596":47793,"_5":17486,"_23867":47759,"_2386":47794},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_2859":2208,"_25205":2194,"_17596":47796,"_5":17486,"_23867":47762,"_2386":47797},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_2859":2209,"_25205":2194,"_17596":47799,"_5":17486,"_23867":47762,"_2386":47800},[],"An available cryptographic engine to keep the authority's key.",{"_2859":2210,"_25205":2194,"_17596":47802,"_5":17486,"_23867":47762,"_2386":47803},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_2859":2211,"_25205":2194,"_17596":47805,"_5":17486,"_23867":47762,"_2386":47806},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_2859":2212,"_25205":2194,"_17596":47808,"_5":17486,"_23867":47762,"_2386":47809},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_2859":2213,"_25205":2194,"_17596":47811,"_5":17486,"_23867":47769,"_2386":47812},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_2859":2214,"_25205":2194,"_17596":47814,"_5":17486,"_23867":47772,"_2386":47815},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_2859":2215,"_25205":2194,"_17596":47817,"_5":17486,"_23867":47775,"_2386":47818},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_2859":2216,"_25205":2194,"_17596":47820,"_5":17486,"_23867":47778,"_2386":47821},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_2859":2217,"_25205":2194,"_17596":47823,"_5":17486,"_23867":47781,"_2386":47824},[],"An active certificate in the console is one part of the check. Also verify that:",{"_2859":2218,"_25205":2194,"_17596":47826,"_5":17486,"_23867":47781,"_2386":47827},[],"its subject and extensions identify the expected client;",{"_2859":2219,"_25205":2194,"_17596":47829,"_5":17486,"_23867":47781,"_2386":47830},[],"its public key matches the client's private key;",{"_2859":2220,"_25205":2194,"_17596":47832,"_5":17486,"_23867":47781,"_2386":47833},[],"its chain reaches a root trusted by the consumer;",{"_2859":2221,"_25205":2194,"_17596":47835,"_5":17486,"_23867":47781,"_2386":47836},[],"its dates and usages allow the operation;",{"_2859":2222,"_25205":2194,"_17596":47838,"_5":17486,"_23867":47781,"_2386":47839},[],"the consumer applies revocation checks and authorization.",{"_2859":2223,"_25205":2194,"_17596":47841,"_5":17486,"_23867":47781,"_2386":47842},[],"The issuance path includes the first independent checks.",{"_2859":2224,"_25205":2194,"_17596":47844,"_5":17486,"_23867":47785,"_2386":47845},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2859":2225,"_25205":2194,"_17596":47847,"_5":17486,"_23867":47785,"_2386":47848},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2859":2226,"_25205":2194,"_17596":47850,"_5":17486,"_23867":47785,"_2386":47851},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2859":2227,"_25205":2227,"_5":12316,"_2386":47853,"_25540":47854,"_17596":47855,"_23867":2227},"Create your first CA",[40894,42238,45925,45360],[],{"_2859":2228,"_25205":2227,"_17596":47857,"_5":17486,"_23867":2227,"_2386":47858},[],"Create an evaluation root and check its certificate before issuing.",{"_2859":2229,"_25205":2227,"_5":25537,"_17596":47860,"_23867":47861,"_2386":40904},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_2859":2230,"_25205":2227,"_5":25537,"_17596":47863,"_23867":47864,"_2386":47865},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_2859":2231,"_25205":2227,"_5":25537,"_17596":47867,"_23867":47868,"_2386":47869},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_2859":2232,"_25205":2227,"_5":25537,"_17596":47871,"_23867":47872,"_2386":47873},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_2859":2233,"_25205":2227,"_5":25537,"_17596":47875,"_23867":47876,"_2386":47877},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_2859":2234,"_25205":2227,"_5":25537,"_17596":47879,"_23867":47880,"_2386":47881},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_2859":2235,"_25205":2227,"_5":25537,"_17596":47883,"_23867":47884,"_2386":47885},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_2859":2236,"_25205":2227,"_5":25537,"_17596":47887,"_23867":47888,"_2386":45618},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_2859":2237,"_25205":2227,"_5":25537,"_17596":47890,"_23867":47891,"_2386":40928},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/create-certificate-authority#next-step",{"_2859":2238,"_25205":2227,"_17596":47893,"_5":17486,"_23867":2227,"_2386":47894},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_2859":2239,"_25205":2227,"_17596":47896,"_5":17486,"_23867":47861,"_2386":47897},[],"Console access and permission to create keys and authorities.",{"_2859":2240,"_25205":2227,"_17596":47899,"_5":17486,"_23867":47861,"_2386":47900},[],"An available cryptographic engine that supports the chosen algorithm.",{"_2859":2241,"_25205":2227,"_17596":47902,"_5":17486,"_23867":47861,"_2386":47903},[],"OpenSSL 3.x to check the downloaded certificate.",{"_2859":2242,"_25205":2227,"_17596":47905,"_5":17486,"_23867":47861,"_2386":47906},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_2859":2243,"_25205":2227,"_17596":47908,"_5":17486,"_23867":47864,"_2386":47909},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_2859":2244,"_25205":2227,"_17596":47911,"_5":17486,"_23867":47864,"_2386":47912},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_2859":2245,"_25205":2227,"_17596":47914,"_5":17486,"_23867":47868,"_2386":47915},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_2859":2246,"_25205":2227,"_17596":47917,"_5":17486,"_23867":47868,"_2386":47918},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_2859":2247,"_25205":2227,"_17596":47920,"_5":17486,"_23867":47872,"_2386":47921},[],"Select **Root CA** and complete:",{"_2859":2248,"_25205":2227,"_17596":47923,"_5":17486,"_23867":47872,"_2386":47924},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_2859":2249,"_25205":2227,"_17596":47926,"_5":17486,"_23867":47872,"_2386":47927},[],"**Subject**: organization and country details for your evaluation.",{"_2859":2250,"_25205":2227,"_17596":47929,"_5":17486,"_23867":47872,"_2386":47930},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_2859":2251,"_25205":2227,"_17596":47932,"_5":17486,"_23867":47872,"_2386":47933},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_2859":2252,"_25205":2227,"_17596":47935,"_5":17486,"_23867":47872,"_2386":47936},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_2859":2253,"_25205":2227,"_17596":47938,"_5":17486,"_23867":47876,"_2386":47939},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_2859":2254,"_25205":2227,"_17596":47941,"_5":17486,"_23867":47880,"_2386":47942},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_2859":2255,"_25205":2227,"_17596":47944,"_5":17486,"_23867":47880,"_2386":47945},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_2859":2256,"_25205":2227,"_17596":47947,"_5":17486,"_23867":47884,"_2386":47948},[],"Run from the directory where you saved `ca.pem`:",{"_2859":2257,"_25205":2227,"_17596":47950,"_5":17486,"_23867":47884,"_2386":47951},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_2859":2258,"_25205":2227,"_17596":47953,"_5":17486,"_23867":47884,"_2386":47954},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_2859":2259,"_25205":2227,"_17596":47956,"_5":17486,"_23867":47888,"_2386":47957},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_2859":2260,"_25205":2227,"_17596":47959,"_5":17486,"_23867":47888,"_2386":47960},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_2859":2261,"_25205":2227,"_17596":47962,"_5":17486,"_23867":47888,"_2386":47963},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_2859":2262,"_25205":2227,"_17596":47965,"_5":17486,"_23867":47888,"_2386":47966},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_2859":2263,"_25205":2227,"_17596":47968,"_5":17486,"_23867":47891,"_2386":47969},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_2859":2264,"_25205":2264,"_5":12316,"_2386":47971,"_25540":47972,"_17596":47973,"_23867":2264},"Issue and verify a certificate",[40894,42238,45925,45360],[],{"_2859":2265,"_25205":2264,"_17596":47975,"_5":17486,"_23867":2264,"_2386":47976},[],"Issue a client certificate and check content, chain and key correspondence.",{"_2859":2266,"_25205":2264,"_5":25537,"_17596":47978,"_23867":47979,"_2386":40904},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_2859":2267,"_25205":2264,"_5":25537,"_17596":47981,"_23867":47982,"_2386":47983},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_2859":2268,"_25205":2264,"_5":25537,"_17596":47985,"_23867":47986,"_2386":47987},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_2859":2269,"_25205":2264,"_5":25537,"_17596":47989,"_23867":47990,"_2386":47991},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_2859":2270,"_25205":2264,"_5":25537,"_17596":47993,"_23867":47994,"_2386":47995},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_2859":2271,"_25205":2264,"_5":25537,"_17596":47997,"_23867":47998,"_2386":47999},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_2859":2272,"_25205":2264,"_5":25537,"_17596":48001,"_23867":48002,"_2386":47881},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_2859":2273,"_25205":2264,"_5":25537,"_17596":48004,"_23867":48005,"_2386":48006},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_2859":2274,"_25205":2264,"_5":25537,"_17596":48008,"_23867":48009,"_2386":48010},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_2859":2275,"_25205":2264,"_5":25537,"_17596":48012,"_23867":48013,"_2386":48014},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_2859":2276,"_25205":2264,"_5":25537,"_17596":48016,"_23867":48017,"_2386":45618},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_2859":2277,"_25205":2264,"_5":25537,"_17596":48019,"_23867":48020,"_2386":40928},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#next-step",{"_2859":2278,"_25205":2264,"_17596":48022,"_5":17486,"_23867":2264,"_2386":48023},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_2859":2279,"_25205":2264,"_17596":48025,"_5":17486,"_23867":47979,"_2386":48026},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_2859":2280,"_25205":2264,"_17596":48028,"_5":17486,"_23867":47979,"_2386":48029},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_2859":2281,"_25205":2264,"_17596":48031,"_5":17486,"_23867":47979,"_2386":48032},[],"OpenSSL 3.x and a working directory with restricted access.",{"_2859":2282,"_25205":2264,"_17596":48034,"_5":17486,"_23867":47979,"_2386":48035},[],"A client identifier: here we use `device-001`.",{"_2859":2283,"_25205":2264,"_17596":48037,"_5":17486,"_23867":47979,"_2386":48038},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_2859":2284,"_25205":2264,"_17596":48040,"_5":17486,"_23867":47982,"_2386":48041},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_2859":2285,"_25205":2264,"_17596":48043,"_5":17486,"_23867":47986,"_2386":48044},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_2859":2286,"_25205":2264,"_17596":48046,"_5":17486,"_23867":47986,"_2386":48047},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_2859":2287,"_25205":2264,"_17596":48049,"_5":17486,"_23867":47990,"_2386":48050},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_2859":2288,"_25205":2264,"_17596":48052,"_5":17486,"_23867":47990,"_2386":48053},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_2859":2289,"_25205":2264,"_17596":48055,"_5":17486,"_23867":47994,"_2386":48056},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_2859":2290,"_25205":2264,"_17596":48058,"_5":17486,"_23867":47994,"_2386":48059},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_2859":2291,"_25205":2264,"_17596":48061,"_5":17486,"_23867":47998,"_2386":48062},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_2859":2292,"_25205":2264,"_17596":48064,"_5":17486,"_23867":48002,"_2386":48065},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_2859":2293,"_25205":2264,"_17596":48067,"_5":17486,"_23867":48005,"_2386":48068},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_2859":2294,"_25205":2264,"_17596":48070,"_5":17486,"_23867":48009,"_2386":48071},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_2859":2295,"_25205":2264,"_17596":48073,"_5":17486,"_23867":48009,"_2386":48074},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_2859":2296,"_25205":2264,"_17596":48076,"_5":17486,"_23867":48009,"_2386":48077},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_2859":2297,"_25205":2264,"_17596":48079,"_5":17486,"_23867":48013,"_2386":48080},[],"In Bash, compare the two public-key digests:",{"_2859":2298,"_25205":2264,"_17596":48082,"_5":17486,"_23867":48013,"_2386":48083},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_2859":2299,"_25205":2264,"_17596":48085,"_5":17486,"_23867":48013,"_2386":48086},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_2859":2300,"_25205":2264,"_17596":48088,"_5":17486,"_23867":48017,"_2386":45702},[],{"_2859":2301,"_25205":2264,"_17596":48090,"_5":17486,"_23867":48017,"_2386":48091},[],"What to review",{"_2859":2302,"_25205":2264,"_17596":48093,"_5":17486,"_23867":48017,"_2386":48094},[],"The CA rejects issuance",{"_2859":2303,"_25205":2264,"_17596":48096,"_5":17486,"_23867":48017,"_2386":48097},[],"Permissions, CA state and key, algorithm and profile.",{"_2859":2304,"_25205":2264,"_17596":48099,"_5":17486,"_23867":48017,"_2386":48100},[],"Different subject or usages",{"_2859":2305,"_25205":2264,"_17596":48102,"_5":17486,"_23867":48017,"_2386":48103},[],"Applied profile and requested values.",{"_2859":2306,"_25205":2264,"_17596":48105,"_5":17486,"_23867":48017,"_2386":48106},[],"Issuer cannot be found",{"_2859":2307,"_25205":2264,"_17596":48108,"_5":17486,"_23867":48017,"_2386":48109},[],"Downloaded CA and required intermediate chain.",{"_2859":2308,"_25205":2264,"_17596":48111,"_5":17486,"_23867":48017,"_2386":48112},[],"Validity fails",{"_2859":2309,"_25205":2264,"_17596":48114,"_5":17486,"_23867":48017,"_2386":48115},[],"Certificate and CA dates, and the computer's clock.",{"_2859":2310,"_25205":2264,"_17596":48117,"_5":17486,"_23867":48017,"_2386":48118},[],"Public-key digests differ",{"_2859":2311,"_25205":2264,"_17596":48120,"_5":17486,"_23867":48017,"_2386":48121},[],"Certificate and key files from the same issuance.",{"_2859":2312,"_25205":2264,"_17596":48123,"_5":17486,"_23867":48017,"_2386":48124},[],"See PKI diagnostics to narrow an issuance failure.",{"_2859":2313,"_25205":2264,"_17596":48126,"_5":17486,"_23867":48020,"_2386":48127},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_2859":2314,"_25205":2264,"_17596":48129,"_5":17486,"_23867":48020,"_2386":48130},[],"Manage certificates for inspection, status and revocation.",{"_2859":2315,"_25205":2264,"_17596":48132,"_5":17486,"_23867":48020,"_2386":48133},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_2859":2316,"_25205":2264,"_17596":48135,"_5":17486,"_23867":48020,"_2386":48136},[],"Prepare EST for the device to request its next identities.",{"_2859":2317,"_25205":2264,"_17596":48138,"_5":17486,"_23867":48020,"_2386":48139},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_2859":2318,"_25205":2318,"_5":12316,"_2386":48141,"_25540":48142,"_17596":48143,"_23867":2318},"PKI getting started",[40894,42238,45925,45360],[],{"_2859":2319,"_25205":2318,"_17596":48145,"_5":17486,"_23867":2318,"_2386":48146},[],"Create a CA, issue a client certificate and check its chain and key.",{"_2859":2320,"_25205":2318,"_5":25537,"_17596":48148,"_23867":48149,"_2386":40904},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview#before-you-begin",{"_2859":2321,"_25205":2318,"_5":25537,"_17596":48151,"_23867":48152,"_2386":48153},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_2859":2322,"_25205":2318,"_5":25537,"_17596":48155,"_23867":48156,"_2386":45552},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview#expected-result",{"_2859":2323,"_25205":2318,"_5":25537,"_17596":48158,"_23867":48159,"_2386":48160},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_2859":2324,"_25205":2318,"_17596":48162,"_5":17486,"_23867":2318,"_2386":48163},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_2859":2325,"_25205":2318,"_17596":48165,"_5":17486,"_23867":48149,"_2386":48166},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_2859":2326,"_25205":2318,"_17596":48168,"_5":17486,"_23867":48149,"_2386":48169},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_2859":2327,"_25205":2318,"_17596":48171,"_5":17486,"_23867":48149,"_2386":48172},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_2859":2328,"_25205":2318,"_17596":48174,"_5":17486,"_23867":48149,"_2386":48175},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_2859":2329,"_25205":2318,"_17596":48177,"_5":17486,"_23867":48149,"_2386":48178},[],"A working directory with restricted access for the downloaded key.",{"_2859":2330,"_25205":2318,"_17596":48180,"_5":17486,"_23867":48152,"_2386":48181},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2859":2331,"_25205":2318,"_17596":48183,"_5":17486,"_23867":48152,"_2386":48184},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2859":2332,"_25205":2318,"_17596":48186,"_5":17486,"_23867":48152,"_2386":48187},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_2859":2333,"_25205":2318,"_17596":48189,"_5":17486,"_23867":48152,"_2386":48190},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_2859":2334,"_25205":2318,"_17596":48192,"_5":17486,"_23867":48156,"_2386":48193},[],"File or resource",{"_2859":2335,"_25205":2318,"_17596":48195,"_5":17486,"_23867":48156,"_2386":45549},[],{"_2859":2336,"_25205":2318,"_17596":48197,"_5":17486,"_23867":48156,"_2386":48198},[],"Active root CA and `ca.pem`",{"_2859":2337,"_25205":2318,"_17596":48200,"_5":17486,"_23867":48156,"_2386":48201},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_2859":2338,"_25205":2318,"_17596":48203,"_5":17486,"_23867":48156,"_2386":48204},[],"End-entity certificate and `device.crt`",{"_2859":2339,"_25205":2318,"_17596":48206,"_5":17486,"_23867":48156,"_2386":48207},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_2859":2340,"_25205":2318,"_17596":48209,"_5":17486,"_23867":48156,"_2386":48210},[],"Private key `device.key`",{"_2859":2341,"_25205":2318,"_17596":48212,"_5":17486,"_23867":48156,"_2386":48213},[],"Its public key matches the one included in `device.crt`.",{"_2859":2342,"_25205":2318,"_17596":48215,"_5":17486,"_23867":48156,"_2386":48216},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_2859":2343,"_25205":2318,"_17596":48218,"_5":17486,"_23867":48159,"_2386":48219},[],"To operate certificates, continue with Certificates and Validation.",{"_2859":2344,"_25205":2318,"_17596":48221,"_5":17486,"_23867":48159,"_2386":48222},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_2859":2345,"_25205":2318,"_17596":48224,"_5":17486,"_23867":48159,"_2386":48225},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_2859":2346,"_25205":2346,"_5":12316,"_2386":48227,"_25540":48228,"_17596":48229,"_23867":2346},"PKI troubleshooting",[40894,42238,45925,44737],[],{"_2859":2347,"_25205":2346,"_17596":48231,"_5":17486,"_23867":2346,"_2386":48232},[],"Diagnose certificate issuance, OCSP and CRL.",{"_2859":2348,"_25205":2346,"_5":25537,"_17596":48234,"_23867":48235,"_2386":48236},[],"/docs/pr-preview/pr-43/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_2859":2349,"_25205":2346,"_5":25537,"_17596":48238,"_23867":48239,"_2386":48240},[],"/docs/pr-preview/pr-43/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_2859":2350,"_25205":2346,"_5":25537,"_17596":48242,"_23867":48243,"_2386":48244},[],"/docs/pr-preview/pr-43/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_2859":2351,"_25205":2346,"_17596":48246,"_5":17486,"_23867":2346,"_2386":48247},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_2859":2352,"_25205":2346,"_17596":48249,"_5":17486,"_23867":2346,"_2386":48250},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_2859":2353,"_25205":2346,"_17596":48252,"_5":17486,"_23867":48235,"_2386":45549},[],{"_2859":2354,"_25205":2346,"_17596":48254,"_5":17486,"_23867":48235,"_2386":48255},[],"What to inspect",{"_2859":2355,"_25205":2346,"_17596":48257,"_5":17486,"_23867":48235,"_2386":40928},[],{"_2859":2356,"_25205":2346,"_17596":48259,"_5":17486,"_23867":48235,"_2386":48260},[],"CA",{"_2859":2357,"_25205":2346,"_17596":48262,"_5":17486,"_23867":48235,"_2386":48263},[],"Exists, is active and has usable dates.",{"_2859":2358,"_25205":2346,"_17596":48265,"_5":17486,"_23867":48235,"_2386":48266},[],"Authorities.",{"_2859":2359,"_25205":2346,"_17596":48268,"_5":17486,"_23867":48235,"_2386":48269},[],"Key",{"_2859":2360,"_25205":2346,"_17596":48271,"_5":17486,"_23867":48235,"_2386":48272},[],"The record has a usable private key and the engine can sign.",{"_2859":2361,"_25205":2346,"_17596":48274,"_5":17486,"_23867":48235,"_2386":48275},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_2859":2362,"_25205":2346,"_17596":48277,"_5":17486,"_23867":48235,"_2386":48278},[],"CSR",{"_2859":2363,"_25205":2346,"_17596":48280,"_5":17486,"_23867":48235,"_2386":48281},[],"Correct PEM and verifiable signature.",{"_2859":2364,"_25205":2346,"_17596":48283,"_5":17486,"_23867":48235,"_2386":48284},[],"`openssl req -in request.csr -noout -verify -text`.",{"_2859":2365,"_25205":2346,"_17596":48286,"_5":17486,"_23867":48235,"_2386":48287},[],"Profile",{"_2859":2366,"_25205":2346,"_17596":48289,"_5":17486,"_23867":48235,"_2386":48290},[],"Selected source, existing ID, allowed algorithm and size.",{"_2859":2367,"_25205":2346,"_17596":48292,"_5":17486,"_23867":48235,"_2386":48293},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_2859":2368,"_25205":2346,"_17596":48295,"_5":17486,"_23867":48235,"_2386":45702},[],{"_2859":2369,"_25205":2346,"_17596":48297,"_5":17486,"_23867":48235,"_2386":48298},[],"Appropriate subject, SAN, usages and dates.",{"_2859":2370,"_25205":2346,"_17596":48300,"_5":17486,"_23867":48235,"_2386":48301},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_2859":2371,"_25205":2346,"_17596":48303,"_5":17486,"_23867":48235,"_2386":48304},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_2859":2372,"_25205":2346,"_17596":48306,"_5":17486,"_23867":48235,"_2386":48307},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_2859":2373,"_25205":2346,"_17596":48309,"_5":17486,"_23867":48239,"_2386":48310},[],"Check each boundary independently:",{"_2859":2374,"_25205":2346,"_17596":48312,"_5":17486,"_23867":48239,"_2386":48313},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_2859":2375,"_25205":2346,"_17596":48315,"_5":17486,"_23867":48239,"_2386":48316},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_2859":2376,"_25205":2346,"_17596":48318,"_5":17486,"_23867":48239,"_2386":48319},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_2859":2377,"_25205":2346,"_17596":48321,"_5":17486,"_23867":48239,"_2386":48322},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_2859":2378,"_25205":2346,"_17596":48324,"_5":17486,"_23867":48239,"_2386":48325},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_2859":2379,"_25205":2346,"_17596":48327,"_5":17486,"_23867":48239,"_2386":48328},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_2859":2380,"_25205":2346,"_17596":48330,"_5":17486,"_23867":48243,"_2386":48331},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_2859":2381,"_25205":2346,"_17596":48333,"_5":17486,"_23867":48243,"_2386":48334},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.","count","sorting",{"_48338":48339,"_48340":48341,"_48342":48343,"_48344":48345,"_15287":2408,"_57827":2408},"language","english","sortableProperties",[2386,25205,5,23867],"sortablePropertiesWithTypes",{"_2386":21016,"_25205":21016,"_5":21016,"_23867":21016},"sorts",{"_2386":48346,"_25205":50717,"_5":53087,"_23867":55457},{"_3830":48347,"_48348":48349,"_5":21016},{"_12061":3430,"_12404":4255,"_12411":4883,"_24413":2692,"_23980":2738,"_16704":7249,"_12082":2825,"_12089":2824,"_24375":2827,"_24725":3655,"_24746":2751,"_24388":4556,"_29002":3095,"_24757":7816,"_29007":3987,"_29010":14236,"_29013":6145,"_29016":6286,"_29019":2628,"_25058":6156,"_29024":2572,"_29026":23869,"_25106":2617,"_25048":5691,"_29030":2702,"_25074":3377,"_29034":7165,"_24775":16311,"_25053":4292,"_25124":3119,"_29039":5562,"_29041":2709,"_29043":6272,"_29045":3064,"_29047":2676,"_29049":3098,"_29051":12023,"_29053":4461,"_29055":2833,"_24426":2837,"_29058":4409,"_29060":2711,"_24420":4240,"_29063":2530,"_29065":3292,"_29067":4611,"_29070":16956,"_24456":3915,"_29074":16957,"_24366":2630,"_29077":10347,"_24393":2757,"_29080":3922,"_29082":4130,"_29085":8880,"_25101":5680,"_29088":2918,"_29090":10359,"_29093":16796,"_29095":10398,"_29097":4156,"_29099":2771,"_29101":6292,"_16707":6316,"_29104":21276,"_29106":6199,"_29108":14389,"_24769":6046,"_29111":4980,"_29113":4757,"_29115":4896,"_29117":4014,"_29119":4890,"_29121":6200,"_29123":3896,"_25191":4035,"_24796":12109,"_29127":3428,"_29129":5058,"_24404":2920,"_29132":4632,"_29134":3919,"_29136":8450,"_25129":5694,"_29139":9406,"_29141":2786,"_29143":4209,"_29145":4160,"_29147":8361,"_24502":3351,"_29152":6923,"_24763":6239,"_29155":5611,"_29157":6264,"_29159":6759,"_29161":8219,"_29163":3267,"_29165":1