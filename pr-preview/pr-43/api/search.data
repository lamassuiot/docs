3173":16,"_28139":15,"_19503":45577,"_5":13343,"_25626":15,"_2668":45578},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3173":17,"_28139":15,"_5":28478,"_19503":45580,"_25626":45581,"_2668":45582},[],"/docs/pr-preview/pr-43/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3173":18,"_28139":15,"_5":28478,"_19503":45584,"_25626":45585,"_2668":45586},[],"/docs/pr-preview/pr-43/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3173":19,"_28139":15,"_5":28478,"_19503":45588,"_25626":45589,"_2668":45590},[],"/docs/pr-preview/pr-43/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3173":20,"_28139":15,"_5":28478,"_19503":45592,"_25626":45593,"_2668":45594},[],"/docs/pr-preview/pr-43/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3173":21,"_28139":15,"_5":28478,"_19503":45596,"_25626":45597,"_2668":45598},[],"/docs/pr-preview/pr-43/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3173":22,"_28139":15,"_5":28478,"_19503":45600,"_25626":45601,"_2668":45602},[],"/docs/pr-preview/pr-43/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3173":23,"_28139":15,"_5":28478,"_19503":45604,"_25626":45605,"_2668":45606},[],"/docs/pr-preview/pr-43/deployment/aws-marketplace#next-step","Next step",{"_3173":24,"_28139":15,"_19503":45608,"_5":13343,"_25626":15,"_2668":45609},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3173":25,"_28139":15,"_19503":45611,"_5":13343,"_25626":45581,"_2668":45612},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3173":26,"_28139":15,"_19503":45614,"_5":13343,"_25626":45581,"_2668":45615},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3173":27,"_28139":15,"_19503":45617,"_5":13343,"_25626":45581,"_2668":45618},[],"A security group allowing the necessary endpoints.",{"_3173":28,"_28139":15,"_19503":45620,"_5":13343,"_25626":45585,"_2668":45621},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3173":29,"_28139":15,"_19503":45623,"_5":13343,"_25626":45585,"_2668":45624},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3173":30,"_28139":15,"_19503":45626,"_5":13343,"_25626":45585,"_2668":45627},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3173":31,"_28139":15,"_19503":45629,"_5":13343,"_25626":45589,"_2668":45630},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3173":32,"_28139":15,"_19503":45632,"_5":13343,"_25626":45593,"_2668":45633},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3173":33,"_28139":15,"_19503":45635,"_5":13343,"_25626":45597,"_2668":45636},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3173":34,"_28139":15,"_19503":45638,"_5":13343,"_25626":45601,"_2668":45639},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3173":35,"_28139":15,"_19503":45641,"_5":13343,"_25626":45605,"_2668":45642},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3173":36,"_28139":36,"_5":13674,"_2668":45644,"_28481":45645,"_19503":45646,"_25626":36},"Deploy Lamassu",[45572,45573],[],{"_3173":37,"_28139":36,"_19503":45648,"_5":13343,"_25626":36,"_2668":45649},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3173":38,"_28139":36,"_5":28478,"_19503":45651,"_25626":45652,"_2668":45653},[],"/docs/pr-preview/pr-43/deployment/overview#choose-a-model","Choose a model",{"_3173":39,"_28139":36,"_5":28478,"_19503":45655,"_25626":45656,"_2668":45657},[],"/docs/pr-preview/pr-43/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3173":40,"_28139":36,"_5":28478,"_19503":45659,"_25626":45660,"_2668":45661},[],"/docs/pr-preview/pr-43/deployment/overview#after-deployment","After deployment",{"_3173":41,"_28139":36,"_19503":45663,"_5":13343,"_25626":36,"_2668":45664},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3173":42,"_28139":36,"_19503":45666,"_5":13343,"_25626":45652,"_2668":45667},[],"Model",{"_3173":43,"_28139":36,"_19503":45669,"_5":13343,"_25626":45652,"_2668":45670},[],"Recommended for",{"_3173":44,"_28139":36,"_19503":45672,"_5":13343,"_25626":45652,"_2668":45673},[],"Who operates the infrastructure",{"_3173":45,"_28139":36,"_19503":45675,"_5":13343,"_25626":45652,"_2668":45676},[],"Starting point",{"_3173":46,"_28139":36,"_19503":45678,"_5":13343,"_25626":45652,"_2668":45679},[],"Kubernetes self-managed",{"_3173":47,"_28139":36,"_19503":45681,"_5":13343,"_25626":45652,"_2668":45682},[],"Production, regulated environments and custom deployments",{"_3173":48,"_28139":36,"_19503":45684,"_5":13343,"_25626":45652,"_2668":45685},[],"Your team",{"_3173":49,"_28139":36,"_19503":45687,"_5":13343,"_25626":45652,"_2668":45688},[],"Helm or Fastlane",{"_3173":50,"_28139":36,"_19503":45690,"_5":13343,"_25626":45652,"_2668":45691},[],"AWS Marketplace",{"_3173":51,"_28139":36,"_19503":45693,"_5":13343,"_25626":45652,"_2668":45694},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3173":52,"_28139":36,"_19503":45696,"_5":13343,"_25626":45652,"_2668":45685},[],{"_3173":53,"_28139":36,"_19503":45698,"_5":13343,"_25626":45652,"_2668":45699},[],"Preconfigured image on EC2",{"_3173":54,"_28139":36,"_19503":45701,"_5":13343,"_25626":45652,"_2668":45702},[],"SaaS",{"_3173":55,"_28139":36,"_19503":45704,"_5":13343,"_25626":45652,"_2668":45705},[],"Teams that want to use the platform without operating it",{"_3173":56,"_28139":36,"_19503":45707,"_5":13343,"_25626":45652,"_2668":45708},[],"Lamassu",{"_3173":57,"_28139":36,"_19503":45710,"_5":13343,"_25626":45652,"_2668":45711},[],"Managed subscription",{"_3173":58,"_28139":36,"_19503":45713,"_5":13343,"_25626":45652,"_2668":45714},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3173":59,"_28139":36,"_19503":45716,"_5":13343,"_25626":45652,"_2668":45717},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3173":60,"_28139":36,"_19503":45719,"_5":13343,"_25626":45652,"_2668":45720},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3173":61,"_28139":36,"_19503":45722,"_5":13343,"_25626":45656,"_2668":45723},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3173":62,"_28139":36,"_19503":45725,"_5":13343,"_25626":45660,"_2668":45726},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3173":63,"_28139":63,"_5":13674,"_2668":45728,"_28481":45729,"_19503":45730,"_25626":63},"Use Lamassu as SaaS",[45572,45573,45574],[],{"_3173":64,"_28139":63,"_19503":45732,"_5":13343,"_25626":63,"_2668":45733},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3173":65,"_28139":63,"_5":28478,"_19503":45735,"_25626":45736,"_2668":45737},[],"/docs/pr-preview/pr-43/deployment/saas#what-the-service-manages","What the service manages",{"_3173":66,"_28139":63,"_5":28478,"_19503":45739,"_25626":45740,"_2668":45741},[],"/docs/pr-preview/pr-43/deployment/saas#plans","Plans",{"_3173":67,"_28139":63,"_5":28478,"_19503":45743,"_25626":45744,"_2668":45745},[],"/docs/pr-preview/pr-43/deployment/saas#request-access","Request access",{"_3173":68,"_28139":63,"_19503":45747,"_5":13343,"_25626":63,"_2668":45748},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3173":69,"_28139":63,"_19503":45750,"_5":13343,"_25626":45736,"_2668":45751},[],"Platform availability and maintenance.",{"_3173":70,"_28139":63,"_19503":45753,"_5":13343,"_25626":45736,"_2668":45754},[],"Automatic backups.",{"_3173":71,"_28139":63,"_19503":45756,"_5":13343,"_25626":45736,"_2668":45757},[],"Version upgrades.",{"_3173":72,"_28139":63,"_19503":45759,"_5":13343,"_25626":45736,"_2668":45760},[],"Technical support and SLA according to your plan.",{"_3173":73,"_28139":63,"_19503":45762,"_5":13343,"_25626":45740,"_2668":45763},[],"Plan",{"_3173":74,"_28139":63,"_19503":45765,"_5":13343,"_25626":45740,"_2668":45766},[],"Devices",{"_3173":75,"_28139":63,"_19503":45768,"_5":13343,"_25626":45740,"_2668":45769},[],"Support",{"_3173":76,"_28139":63,"_19503":45771,"_5":13343,"_25626":45740,"_2668":45772},[],"SLA",{"_3173":77,"_28139":63,"_19503":45774,"_5":13343,"_25626":45740,"_2668":45775},[],"Starter",{"_3173":78,"_28139":63,"_19503":45777,"_5":13343,"_25626":45740,"_2668":45778},[],"Up to 1,000",{"_3173":79,"_28139":63,"_19503":45780,"_5":13343,"_25626":45740,"_2668":45781},[],"Email",{"_3173":80,"_28139":63,"_19503":45783,"_5":13343,"_25626":45740,"_2668":45784},[],"99.5 %",{"_3173":81,"_28139":63,"_19503":45786,"_5":13343,"_25626":45740,"_2668":45787},[],"Professional",{"_3173":82,"_28139":63,"_19503":45789,"_5":13343,"_25626":45740,"_2668":45790},[],"Up to 10,000",{"_3173":83,"_28139":63,"_19503":45792,"_5":13343,"_25626":45740,"_2668":45793},[],"Email and chat",{"_3173":84,"_28139":63,"_19503":45795,"_5":13343,"_25626":45740,"_2668":45796},[],"99.9 %",{"_3173":85,"_28139":63,"_19503":45798,"_5":13343,"_25626":45740,"_2668":45799},[],"Enterprise",{"_3173":86,"_28139":63,"_19503":45801,"_5":13343,"_25626":45740,"_2668":45802},[],"Unlimited",{"_3173":87,"_28139":63,"_19503":45804,"_5":13343,"_25626":45740,"_2668":45805},[],"Dedicated",{"_3173":88,"_28139":63,"_19503":45807,"_5":13343,"_25626":45740,"_2668":45808},[],"99.99 %",{"_3173":89,"_28139":63,"_19503":45810,"_5":13343,"_25626":45744,"_2668":45811},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3173":90,"_28139":63,"_19503":45813,"_5":13343,"_25626":45744,"_2668":45814},[],"When you receive your instance's credentials, continue with Get started.",{"_3173":91,"_28139":91,"_5":13674,"_2668":45816,"_28481":45817,"_19503":45818,"_25626":91},"Fastlane",[45572,45573,45679],[],{"_3173":92,"_28139":91,"_19503":45820,"_5":13343,"_25626":91,"_2668":45821},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3173":93,"_28139":91,"_5":28478,"_19503":45823,"_25626":45824,"_2668":45825},[],"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3173":94,"_28139":91,"_5":28478,"_19503":45827,"_25626":45828,"_2668":45829},[],"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3173":95,"_28139":91,"_5":28478,"_19503":45831,"_25626":45832,"_2668":45582},[],"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#before-you-begin",{"_3173":96,"_28139":91,"_5":28478,"_19503":45834,"_25626":45835,"_2668":45836},[],"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3173":97,"_28139":91,"_5":28478,"_19503":45838,"_25626":45839,"_2668":45840},[],"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3173":98,"_28139":91,"_5":28478,"_19503":45842,"_25626":45843,"_2668":45844},[],"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3173":99,"_28139":91,"_5":28478,"_19503":45846,"_25626":45847,"_2668":45848},[],"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3173":100,"_28139":91,"_5":28478,"_19503":45850,"_25626":45851,"_2668":45852},[],"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3173":101,"_28139":91,"_5":28478,"_19503":45854,"_25626":45855,"_2668":45856},[],"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3173":102,"_28139":91,"_5":28478,"_19503":45858,"_25626":45859,"_2668":45860},[],"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3173":103,"_28139":91,"_5":28478,"_19503":45862,"_25626":45863,"_2668":45864},[],"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3173":104,"_28139":91,"_19503":45866,"_5":13343,"_25626":45824,"_2668":45867},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3173":105,"_28139":91,"_19503":45869,"_5":13343,"_25626":45824,"_2668":45870},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3173":106,"_28139":91,"_19503":45872,"_5":13343,"_25626":45828,"_2668":45873},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3173":107,"_28139":91,"_19503":45875,"_5":13343,"_25626":45828,"_2668":45876},[],"Fastlane installs or configures",{"_3173":108,"_28139":91,"_19503":45878,"_5":13343,"_25626":45828,"_2668":45879},[],"You still provide",{"_3173":109,"_28139":91,"_19503":45881,"_5":13343,"_25626":45828,"_2668":45882},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3173":110,"_28139":91,"_19503":45884,"_5":13343,"_25626":45828,"_2668":45885},[],"The Kubernetes cluster, nodes and persistent storage",{"_3173":111,"_28139":91,"_19503":45887,"_5":13343,"_25626":45828,"_2668":45888},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3173":112,"_28139":91,"_19503":45890,"_5":13343,"_25626":45828,"_2668":45891},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3173":113,"_28139":91,"_19503":45893,"_5":13343,"_25626":45828,"_2668":45894},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3173":114,"_28139":91,"_19503":45896,"_5":13343,"_25626":45828,"_2668":45897},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3173":115,"_28139":91,"_19503":45899,"_5":13343,"_25626":45828,"_2668":45900},[],"Optional observability and lab HSM components",{"_3173":116,"_28139":91,"_19503":45902,"_5":13343,"_25626":45828,"_2668":45903},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3173":117,"_28139":91,"_19503":45905,"_5":13343,"_25626":45828,"_2668":45906},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3173":118,"_28139":91,"_19503":45908,"_5":13343,"_25626":45832,"_2668":45909},[],"You need:",{"_3173":119,"_28139":91,"_19503":45911,"_5":13343,"_25626":45832,"_2668":45912},[],"an existing Kubernetes cluster",{"_3173":120,"_28139":91,"_19503":45914,"_5":13343,"_25626":45832,"_2668":45915},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3173":121,"_28139":91,"_19503":45917,"_5":13343,"_25626":45832,"_2668":45918},[],"`yq`",{"_3173":122,"_28139":91,"_19503":45920,"_5":13343,"_25626":45832,"_2668":22088},[],{"_3173":123,"_28139":91,"_19503":45922,"_5":13343,"_25626":45832,"_2668":45923},[],"`jq` only when using `--sample-data` or `--development`",{"_3173":124,"_28139":91,"_19503":45925,"_5":13343,"_25626":45832,"_2668":45926},[],"`ssh-keygen` only when using `--with-hsm`",{"_3173":125,"_28139":91,"_19503":45928,"_5":13343,"_25626":45832,"_2668":45929},[],"free external ports 80 and 443 on a single-node K3s host",{"_3173":126,"_28139":91,"_19503":45931,"_5":13343,"_25626":45832,"_2668":45932},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3173":127,"_28139":91,"_19503":45934,"_5":13343,"_25626":45832,"_2668":45935},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3173":128,"_28139":91,"_19503":45937,"_5":13343,"_25626":45835,"_2668":45938},[],"Run the script from a clone of the Helm repository:",{"_3173":129,"_28139":91,"_19503":45940,"_5":13343,"_25626":45835,"_2668":45941},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3173":130,"_28139":91,"_19503":45943,"_5":13343,"_25626":45839,"_2668":45944},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3173":131,"_28139":91,"_19503":45946,"_5":13343,"_25626":45839,"_2668":45947},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3173":132,"_28139":91,"_19503":45949,"_5":13343,"_25626":45839,"_2668":45950},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3173":133,"_28139":91,"_19503":45952,"_5":13343,"_25626":45839,"_2668":45953},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3173":134,"_28139":91,"_19503":45955,"_5":13343,"_25626":45843,"_2668":45956},[],"Option",{"_3173":135,"_28139":91,"_19503":45958,"_5":13343,"_25626":45843,"_2668":45959},[],"Default",{"_3173":136,"_28139":91,"_19503":45961,"_5":13343,"_25626":45843,"_2668":45962},[],"Purpose",{"_3173":137,"_28139":91,"_19503":45964,"_5":13343,"_25626":45843,"_2668":45965},[],"`-h`, `--help`",{"_3173":138,"_28139":91,"_19503":45967,"_5":13343,"_25626":45843,"_2668":45968},[],"—",{"_3173":139,"_28139":91,"_19503":45970,"_5":13343,"_25626":45843,"_2668":45971},[],"Show help",{"_3173":140,"_28139":91,"_19503":45973,"_5":13343,"_25626":45843,"_2668":45974},[],"`-c`, `--context`",{"_3173":141,"_28139":91,"_19503":45976,"_5":13343,"_25626":45843,"_2668":45977},[],"current context",{"_3173":142,"_28139":91,"_19503":45979,"_5":13343,"_25626":45843,"_2668":45980},[],"Select the kubeconfig context for kubectl and Helm",{"_3173":143,"_28139":91,"_19503":45982,"_5":13343,"_25626":45843,"_2668":45983},[],"`-n`, `--non-interactive`",{"_3173":144,"_28139":91,"_19503":45985,"_5":13343,"_25626":45843,"_2668":5967},[],{"_3173":145,"_28139":91,"_19503":45987,"_5":13343,"_25626":45843,"_2668":45988},[],"Skip prompts and generate dependency credentials",{"_3173":146,"_28139":91,"_19503":45990,"_5":13343,"_25626":45843,"_2668":45991},[],"`-ns`, `--namespace`",{"_3173":147,"_28139":91,"_19503":45993,"_5":13343,"_25626":45843,"_2668":45994},[],"`lamassu-dev`",{"_3173":148,"_28139":91,"_19503":45996,"_5":13343,"_25626":45843,"_2668":45997},[],"Namespace for the installation",{"_3173":149,"_28139":91,"_19503":45999,"_5":13343,"_25626":45843,"_2668":46000},[],"`-d`, `--domain`",{"_3173":150,"_28139":91,"_19503":46002,"_5":13343,"_25626":45843,"_2668":46003},[],"`dev.lamassu.io`",{"_3173":151,"_28139":91,"_19503":46005,"_5":13343,"_25626":45843,"_2668":46006},[],"Domain used by the UI, OIDC and certificate",{"_3173":152,"_28139":91,"_19503":46008,"_5":13343,"_25626":45843,"_2668":46009},[],"`-v`, `--version`",{"_3173":153,"_28139":91,"_19503":46011,"_5":13343,"_25626":45843,"_2668":13974},[],{"_3173":154,"_28139":91,"_19503":46013,"_5":13343,"_25626":45843,"_2668":46014},[],"Lamassu chart version",{"_3173":155,"_28139":91,"_19503":46016,"_5":13343,"_25626":45843,"_2668":46017},[],"`--https-port`",{"_3173":156,"_28139":91,"_19503":46019,"_5":13343,"_25626":45843,"_2668":46020},[],"`443`",{"_3173":157,"_28139":91,"_19503":46022,"_5":13343,"_25626":45843,"_2668":46023},[],"Gateway HTTPS listener port",{"_3173":158,"_28139":91,"_19503":46025,"_5":13343,"_25626":45843,"_2668":46026},[],"`--http-port`",{"_3173":159,"_28139":91,"_19503":46028,"_5":13343,"_25626":45843,"_2668":46029},[],"`80`",{"_3173":160,"_28139":91,"_19503":46031,"_5":13343,"_25626":45843,"_2668":46032},[],"Gateway HTTP listener port",{"_3173":161,"_28139":91,"_19503":46034,"_5":13343,"_25626":45843,"_2668":46035},[],"`--tls-crt`",{"_3173":162,"_28139":91,"_19503":46037,"_5":13343,"_25626":45843,"_2668":45968},[],{"_3173":163,"_28139":91,"_19503":46039,"_5":13343,"_25626":45843,"_2668":46040},[],"PEM certificate for downstream TLS",{"_3173":164,"_28139":91,"_19503":46042,"_5":13343,"_25626":45843,"_2668":46043},[],"`--tls-key`",{"_3173":165,"_28139":91,"_19503":46045,"_5":13343,"_25626":45843,"_2668":45968},[],{"_3173":166,"_28139":91,"_19503":46047,"_5":13343,"_25626":45843,"_2668":46048},[],"PEM private key for downstream TLS",{"_3173":167,"_28139":91,"_19503":46050,"_5":13343,"_25626":45843,"_2668":46051},[],"`-l`, `--local-chart-path`",{"_3173":168,"_28139":91,"_19503":46053,"_5":13343,"_25626":45843,"_2668":46054},[],"repository chart",{"_3173":169,"_28139":91,"_19503":46056,"_5":13343,"_25626":45843,"_2668":46057},[],"Use an unpacked local Lamassu chart",{"_3173":170,"_28139":91,"_19503":46059,"_5":13343,"_25626":45843,"_2668":46060},[],"`-ip`, `--gateway-ip`",{"_3173":171,"_28139":91,"_19503":46062,"_5":13343,"_25626":45843,"_2668":8025},[],{"_3173":172,"_28139":91,"_19503":46064,"_5":13343,"_25626":45843,"_2668":46065},[],"Override the address written to `gateway.addresses`",{"_3173":173,"_28139":91,"_19503":46067,"_5":13343,"_25626":45843,"_2668":46068},[],"`--otel`",{"_3173":174,"_28139":91,"_19503":46070,"_5":13343,"_25626":45843,"_2668":5967},[],{"_3173":175,"_28139":91,"_19503":46072,"_5":13343,"_25626":45843,"_2668":46073},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3173":176,"_28139":91,"_19503":46075,"_5":13343,"_25626":45843,"_2668":46076},[],"`--development`",{"_3173":177,"_28139":91,"_19503":46078,"_5":13343,"_25626":45843,"_2668":5967},[],{"_3173":178,"_28139":91,"_19503":46080,"_5":13343,"_25626":45843,"_2668":46081},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3173":179,"_28139":91,"_19503":46083,"_5":13343,"_25626":45843,"_2668":46084},[],"`--sample-data`",{"_3173":180,"_28139":91,"_19503":46086,"_5":13343,"_25626":45843,"_2668":5967},[],{"_3173":181,"_28139":91,"_19503":46088,"_5":13343,"_25626":45843,"_2668":46089},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3173":182,"_28139":91,"_19503":46091,"_5":13343,"_25626":45843,"_2668":46092},[],"`--with-hsm`",{"_3173":183,"_28139":91,"_19503":46094,"_5":13343,"_25626":45843,"_2668":5967},[],{"_3173":184,"_28139":91,"_19503":46096,"_5":13343,"_25626":45843,"_2668":46097},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3173":185,"_28139":91,"_19503":46099,"_5":13343,"_25626":45843,"_2668":46100},[],"`--softhsm-chart-path`",{"_3173":186,"_28139":91,"_19503":46102,"_5":13343,"_25626":45843,"_2668":46103},[],"`./charts/softhsm`",{"_3173":187,"_28139":91,"_19503":46105,"_5":13343,"_25626":45843,"_2668":46106},[],"Use a different local SoftHSM chart",{"_3173":188,"_28139":91,"_19503":46108,"_5":13343,"_25626":45843,"_2668":46109},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3173":189,"_28139":91,"_19503":46111,"_5":13343,"_25626":45847,"_2668":46112},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3173":190,"_28139":91,"_19503":46114,"_5":13343,"_25626":45847,"_2668":46115},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3173":191,"_28139":91,"_19503":46117,"_5":13343,"_25626":45847,"_2668":46118},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3173":192,"_28139":91,"_19503":46120,"_5":13343,"_25626":45847,"_2668":46121},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3173":193,"_28139":91,"_19503":46123,"_5":13343,"_25626":45847,"_2668":46124},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3173":194,"_28139":91,"_19503":46126,"_5":13343,"_25626":45847,"_2668":46127},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3173":195,"_28139":91,"_19503":46129,"_5":13343,"_25626":45851,"_2668":46130},[],"Fastlane:",{"_3173":196,"_28139":91,"_19503":46132,"_5":13343,"_25626":45851,"_2668":46133},[],"validates local tools and the selected cluster",{"_3173":197,"_28139":91,"_19503":46135,"_5":13343,"_25626":45851,"_2668":46136},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3173":198,"_28139":91,"_19503":46138,"_5":13343,"_25626":45851,"_2668":46139},[],"creates the namespace",{"_3173":199,"_28139":91,"_19503":46141,"_5":13343,"_25626":45851,"_2668":46142},[],"installs PostgreSQL and creates the required databases",{"_3173":200,"_28139":91,"_19503":46144,"_5":13343,"_25626":45851,"_2668":46145},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3173":201,"_28139":91,"_19503":46147,"_5":13343,"_25626":45851,"_2668":46148},[],"installs RabbitMQ",{"_3173":202,"_28139":91,"_19503":46150,"_5":13343,"_25626":45851,"_2668":46151},[],"optionally installs observability and lab HSM components",{"_3173":203,"_28139":91,"_19503":46153,"_5":13343,"_25626":45851,"_2668":46154},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3173":204,"_28139":91,"_19503":46156,"_5":13343,"_25626":45851,"_2668":46157},[],"optionally loads sample data",{"_3173":205,"_28139":91,"_19503":46159,"_5":13343,"_25626":45851,"_2668":46160},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3173":206,"_28139":91,"_19503":46162,"_5":13343,"_25626":45855,"_2668":46163},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3173":207,"_28139":91,"_19503":46165,"_5":13343,"_25626":45855,"_2668":46166},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3173":208,"_28139":91,"_19503":46168,"_5":13343,"_25626":45859,"_2668":46169},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3173":209,"_28139":91,"_19503":46171,"_5":13343,"_25626":45859,"_2668":46172},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3173":210,"_28139":91,"_19503":46174,"_5":13343,"_25626":45859,"_2668":46175},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3173":211,"_28139":91,"_19503":46177,"_5":13343,"_25626":45863,"_2668":46178},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3173":212,"_28139":212,"_5":13674,"_2668":46180,"_28481":46181,"_19503":46182,"_25626":212},"Install with Helm",[45572,45573,45679],[],{"_3173":213,"_28139":212,"_19503":46184,"_5":13343,"_25626":212,"_2668":46185},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3173":214,"_28139":212,"_5":28478,"_19503":46187,"_25626":46188,"_2668":46189},[],"/docs/pr-preview/pr-43/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3173":215,"_28139":212,"_5":28478,"_19503":46191,"_25626":46192,"_2668":45582},[],"/docs/pr-preview/pr-43/deployment/self-hosted/helm#before-you-begin",{"_3173":216,"_28139":212,"_5":28478,"_19503":46194,"_25626":46195,"_2668":46196},[],"/docs/pr-preview/pr-43/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3173":217,"_28139":212,"_5":28478,"_19503":46198,"_25626":46199,"_2668":46200},[],"/docs/pr-preview/pr-43/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3173":218,"_28139":212,"_5":28478,"_19503":46202,"_25626":46203,"_2668":46204},[],"/docs/pr-preview/pr-43/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3173":219,"_28139":212,"_5":28478,"_19503":46206,"_25626":46207,"_2668":46208},[],"/docs/pr-preview/pr-43/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3173":220,"_28139":212,"_5":28478,"_19503":46210,"_25626":46211,"_2668":46212},[],"/docs/pr-preview/pr-43/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3173":221,"_28139":212,"_5":28478,"_19503":46214,"_25626":46215,"_2668":46216},[],"/docs/pr-preview/pr-43/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3173":222,"_28139":212,"_5":28478,"_19503":46218,"_25626":46219,"_2668":46220},[],"/docs/pr-preview/pr-43/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3173":223,"_28139":212,"_19503":46222,"_5":13343,"_25626":46188,"_2668":46223},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3173":224,"_28139":212,"_19503":46225,"_5":13343,"_25626":46192,"_2668":46226},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3173":225,"_28139":212,"_19503":46228,"_5":13343,"_25626":46192,"_2668":46229},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3173":226,"_28139":212,"_19503":46231,"_5":13343,"_25626":46192,"_2668":46232},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3173":227,"_28139":212,"_19503":46234,"_5":13343,"_25626":46192,"_2668":46235},[],"a reachable RabbitMQ broker and credentials",{"_3173":228,"_28139":212,"_19503":46237,"_5":13343,"_25626":46192,"_2668":46238},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3173":229,"_28139":212,"_19503":46240,"_5":13343,"_25626":46192,"_2668":46241},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3173":230,"_28139":212,"_19503":46243,"_5":13343,"_25626":46192,"_2668":46244},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3173":231,"_28139":212,"_19503":46246,"_5":13343,"_25626":46192,"_2668":46247},[],"a StorageClass and an external traffic design",{"_3173":232,"_28139":212,"_19503":46249,"_5":13343,"_25626":46192,"_2668":46250},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3173":233,"_28139":212,"_19503":46252,"_5":13343,"_25626":46192,"_2668":46253},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3173":234,"_28139":212,"_19503":46255,"_5":13343,"_25626":46192,"_2668":46256},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3173":235,"_28139":212,"_19503":46258,"_5":13343,"_25626":46195,"_2668":46259},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3173":236,"_28139":212,"_19503":46261,"_5":13343,"_25626":46195,"_2668":46262},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3173":237,"_28139":212,"_19503":46264,"_5":13343,"_25626":46195,"_2668":46265},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3173":238,"_28139":212,"_19503":46267,"_5":13343,"_25626":46199,"_2668":46268},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3173":239,"_28139":212,"_19503":46270,"_5":13343,"_25626":46199,"_2668":46271},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3173":240,"_28139":212,"_19503":46273,"_5":13343,"_25626":46199,"_2668":46274},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3173":241,"_28139":212,"_19503":46276,"_5":13343,"_25626":46203,"_2668":46277},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3173":242,"_28139":212,"_19503":46279,"_5":13343,"_25626":46207,"_2668":46280},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3173":243,"_28139":212,"_19503":46282,"_5":13343,"_25626":46207,"_2668":46283},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3173":244,"_28139":212,"_19503":46285,"_5":13343,"_25626":46207,"_2668":46286},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3173":245,"_28139":212,"_19503":46288,"_5":13343,"_25626":46207,"_2668":46289},[],"See Access control for the principal and policy model.",{"_3173":246,"_28139":212,"_19503":46291,"_5":13343,"_25626":46211,"_2668":46292},[],"To install a local checkout instead:",{"_3173":247,"_28139":212,"_19503":46294,"_5":13343,"_25626":46215,"_2668":46295},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3173":248,"_28139":212,"_19503":46297,"_5":13343,"_25626":46215,"_2668":46298},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3173":249,"_28139":212,"_19503":46300,"_5":13343,"_25626":46219,"_2668":46301},[],"Before going live, review:",{"_3173":250,"_28139":212,"_19503":46303,"_5":13343,"_25626":46219,"_2668":46304},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3173":251,"_28139":212,"_19503":46306,"_5":13343,"_25626":46219,"_2668":46307},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3173":252,"_28139":212,"_19503":46309,"_5":13343,"_25626":46219,"_2668":46310},[],"shared VA storage before increasing VA replicas",{"_3173":253,"_28139":212,"_19503":46312,"_5":13343,"_25626":46219,"_2668":46313},[],"managed OIDC roles and removal of evaluation credentials",{"_3173":254,"_28139":212,"_19503":46315,"_5":13343,"_25626":46219,"_2668":46316},[],"a trusted TLS issuer or externally managed certificate",{"_3173":255,"_28139":212,"_19503":46318,"_5":13343,"_25626":46219,"_2668":46319},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3173":256,"_28139":212,"_19503":46321,"_5":13343,"_25626":46219,"_2668":46322},[],"SMTP, observability and alert delivery",{"_3173":257,"_28139":212,"_19503":46324,"_5":13343,"_25626":46219,"_2668":46325},[],"the version upgrade guides and the notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_3173":258,"_28139":212,"_19503":46327,"_5":13343,"_25626":46219,"_2668":46328},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3173":259,"_28139":259,"_5":13674,"_2668":46330,"_28481":46331,"_19503":46332,"_25626":259},"Expose the Gateway",[45572,45573,45679],[],{"_3173":260,"_28139":259,"_19503":46334,"_5":13343,"_25626":259,"_2668":46335},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3173":261,"_28139":259,"_5":28478,"_19503":46337,"_25626":46338,"_2668":46339},[],"/docs/pr-preview/pr-43/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3173":262,"_28139":259,"_5":28478,"_19503":46341,"_25626":46342,"_2668":46343},[],"/docs/pr-preview/pr-43/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3173":263,"_28139":259,"_5":28478,"_19503":46345,"_25626":46346,"_2668":46347},[],"/docs/pr-preview/pr-43/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3173":264,"_28139":259,"_5":28478,"_19503":46349,"_25626":46350,"_2668":46351},[],"/docs/pr-preview/pr-43/deployment/self-hosted/networking#k3s","K3s",{"_3173":265,"_28139":259,"_5":28478,"_19503":46353,"_25626":46354,"_2668":46355},[],"/docs/pr-preview/pr-43/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3173":266,"_28139":259,"_5":28478,"_19503":46357,"_25626":46358,"_2668":46359},[],"/docs/pr-preview/pr-43/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3173":267,"_28139":259,"_5":28478,"_19503":46361,"_25626":46362,"_2668":46363},[],"/docs/pr-preview/pr-43/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3173":268,"_28139":259,"_5":28478,"_19503":46365,"_25626":46366,"_2668":46367},[],"/docs/pr-preview/pr-43/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3173":269,"_28139":259,"_5":28478,"_19503":46369,"_25626":46370,"_2668":46371},[],"/docs/pr-preview/pr-43/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3173":270,"_28139":259,"_5":28478,"_19503":46373,"_25626":46374,"_2668":46375},[],"/docs/pr-preview/pr-43/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3173":271,"_28139":259,"_19503":46377,"_5":13343,"_25626":46338,"_2668":46378},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3173":272,"_28139":259,"_19503":46380,"_5":13343,"_25626":46338,"_2668":46381},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3173":273,"_28139":259,"_19503":46383,"_5":13343,"_25626":46342,"_2668":46384},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3173":274,"_28139":259,"_19503":46386,"_5":13343,"_25626":46342,"_2668":46387},[],"Set it only when:",{"_3173":275,"_28139":259,"_19503":46389,"_5":13343,"_25626":46342,"_2668":46390},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3173":276,"_28139":259,"_19503":46392,"_5":13343,"_25626":46342,"_2668":46393},[],"that address is allocated to this Gateway",{"_3173":277,"_28139":259,"_19503":46395,"_5":13343,"_25626":46342,"_2668":46396},[],"the surrounding network already routes traffic for it to the cluster",{"_3173":278,"_28139":259,"_19503":46398,"_5":13343,"_25626":46342,"_2668":46399},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3173":279,"_28139":259,"_19503":46401,"_5":13343,"_25626":46342,"_2668":46402},[],"Keep these two settings separate:",{"_3173":280,"_28139":259,"_19503":46404,"_5":13343,"_25626":46342,"_2668":46405},[],"`gateway.addresses` requests an address for the Gateway.",{"_3173":281,"_28139":259,"_19503":46407,"_5":13343,"_25626":46342,"_2668":46408},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3173":282,"_28139":259,"_19503":46410,"_5":13343,"_25626":46342,"_2668":46411},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3173":283,"_28139":259,"_19503":46413,"_5":13343,"_25626":46346,"_2668":46414},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3173":284,"_28139":259,"_19503":46416,"_5":13343,"_25626":46346,"_2668":46417},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3173":285,"_28139":259,"_19503":46419,"_5":13343,"_25626":46350,"_2668":46420},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3173":286,"_28139":259,"_19503":46422,"_5":13343,"_25626":46350,"_2668":46423},[],"For the recommended design:",{"_3173":287,"_28139":259,"_19503":46425,"_5":13343,"_25626":46350,"_2668":46426},[],"Use only one externally exposed Lamassu Gateway.",{"_3173":288,"_28139":259,"_19503":46428,"_5":13343,"_25626":46350,"_2668":46429},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3173":289,"_28139":259,"_19503":46431,"_5":13343,"_25626":46350,"_2668":46432},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3173":290,"_28139":259,"_19503":46434,"_5":13343,"_25626":46350,"_2668":46435},[],"Point DNS at the VM's reachable address.",{"_3173":291,"_28139":259,"_19503":46437,"_5":13343,"_25626":46350,"_2668":46438},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3173":292,"_28139":259,"_19503":46440,"_5":13343,"_25626":46354,"_2668":46441},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3173":293,"_28139":259,"_19503":46443,"_5":13343,"_25626":46358,"_2668":46444},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3173":294,"_28139":259,"_19503":46446,"_5":13343,"_25626":46358,"_2668":46447},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3173":295,"_28139":259,"_19503":46449,"_5":13343,"_25626":46362,"_2668":46450},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3173":296,"_28139":259,"_19503":46452,"_5":13343,"_25626":46362,"_2668":46453},[],"Requirement",{"_3173":297,"_28139":259,"_19503":46455,"_5":13343,"_25626":46362,"_2668":46456},[],"Recommended design",{"_3173":298,"_28139":259,"_19503":46458,"_5":13343,"_25626":46362,"_2668":46459},[],"Consequence",{"_3173":299,"_28139":259,"_19503":46461,"_5":13343,"_25626":46362,"_2668":46462},[],"Several Lamassu URLs or services",{"_3173":300,"_28139":259,"_19503":46464,"_5":13343,"_25626":46362,"_2668":46465},[],"One Gateway with multiple routes",{"_3173":301,"_28139":259,"_19503":46467,"_5":13343,"_25626":46362,"_2668":46468},[],"One IP and one proxy fleet; this is the chart default",{"_3173":302,"_28139":259,"_19503":46470,"_5":13343,"_25626":46362,"_2668":46471},[],"Independent Gateways and separate external IPs",{"_3173":303,"_28139":259,"_19503":46473,"_5":13343,"_25626":46362,"_2668":46474},[],"One VIP per Gateway",{"_3173":304,"_28139":259,"_19503":46476,"_5":13343,"_25626":46362,"_2668":46477},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3173":305,"_28139":259,"_19503":46479,"_5":13343,"_25626":46362,"_2668":46480},[],"Independent Gateways on one node and one IP",{"_3173":306,"_28139":259,"_19503":46482,"_5":13343,"_25626":46362,"_2668":46483},[],"Use different external ports",{"_3173":307,"_28139":259,"_19503":46485,"_5":13343,"_25626":46362,"_2668":46486},[],"Clients must include non-standard ports",{"_3173":308,"_28139":259,"_19503":46488,"_5":13343,"_25626":46362,"_2668":46489},[],"Separate TLS/mTLS termination behind one IP",{"_3173":309,"_28139":259,"_19503":46491,"_5":13343,"_25626":46362,"_2668":46492},[],"Front-door SNI routing to internal Gateways",{"_3173":310,"_28139":259,"_19503":46494,"_5":13343,"_25626":46362,"_2668":46495},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3173":311,"_28139":259,"_19503":46497,"_5":13343,"_25626":46362,"_2668":46498},[],"Separate Gateway resources but shared proxy infrastructure",{"_3173":312,"_28139":259,"_19503":46500,"_5":13343,"_25626":46362,"_2668":46501},[],"Envoy merged-Gateway mode",{"_3173":313,"_28139":259,"_19503":46503,"_5":13343,"_25626":46362,"_2668":46504},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3173":314,"_28139":259,"_19503":46506,"_5":13343,"_25626":46362,"_2668":46507},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3173":315,"_28139":259,"_19503":46509,"_5":13343,"_25626":46362,"_2668":46510},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3173":316,"_28139":259,"_19503":46512,"_5":13343,"_25626":46362,"_2668":46513},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3173":317,"_28139":259,"_19503":46515,"_5":13343,"_25626":46362,"_2668":46516},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3173":318,"_28139":259,"_19503":46518,"_5":13343,"_25626":46366,"_2668":46519},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3173":319,"_28139":259,"_19503":46521,"_5":13343,"_25626":46366,"_2668":46522},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3173":320,"_28139":259,"_19503":46524,"_5":13343,"_25626":46366,"_2668":46525},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3173":321,"_28139":259,"_19503":46527,"_5":13343,"_25626":46366,"_2668":46528},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3173":322,"_28139":259,"_19503":46530,"_5":13343,"_25626":46366,"_2668":46531},[],"If none of those are possible, use different external ports or change the external network design.",{"_3173":323,"_28139":259,"_19503":46533,"_5":13343,"_25626":46370,"_2668":46534},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3173":324,"_28139":259,"_19503":46536,"_5":13343,"_25626":46370,"_2668":46537},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3173":325,"_28139":259,"_19503":46539,"_5":13343,"_25626":46374,"_2668":46540},[],"Check, in order:",{"_3173":326,"_28139":259,"_19503":46542,"_5":13343,"_25626":46374,"_2668":46543},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3173":327,"_28139":259,"_19503":46545,"_5":13343,"_25626":46374,"_2668":46546},[],"Its status contains the expected address.",{"_3173":328,"_28139":259,"_19503":46548,"_5":13343,"_25626":46374,"_2668":46549},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3173":329,"_28139":259,"_19503":46551,"_5":13343,"_25626":46374,"_2668":46552},[],"Port 443 reaches that address from the client network.",{"_3173":330,"_28139":259,"_19503":46554,"_5":13343,"_25626":46374,"_2668":46555},[],"DNS resolves to the externally reachable endpoint.",{"_3173":331,"_28139":259,"_19503":46557,"_5":13343,"_25626":46374,"_2668":46558},[],"The certificate contains the DNS name or IP used by the client.",{"_3173":332,"_28139":259,"_19503":46560,"_5":13343,"_25626":46374,"_2668":46561},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3173":333,"_28139":333,"_5":13674,"_2668":45679,"_28481":46563,"_19503":46564,"_25626":333},[45572,45573,45679],[],{"_3173":334,"_28139":333,"_19503":46566,"_5":13343,"_25626":333,"_2668":46567},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3173":335,"_28139":333,"_5":28478,"_19503":46569,"_25626":46570,"_2668":46571},[],"/docs/pr-preview/pr-43/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3173":336,"_28139":333,"_5":28478,"_19503":46573,"_25626":46574,"_2668":46575},[],"/docs/pr-preview/pr-43/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3173":337,"_28139":333,"_5":28478,"_19503":46577,"_25626":46578,"_2668":46579},[],"/docs/pr-preview/pr-43/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3173":338,"_28139":333,"_5":28478,"_19503":46581,"_25626":46582,"_2668":46583},[],"/docs/pr-preview/pr-43/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3173":339,"_28139":333,"_5":28478,"_19503":46585,"_25626":46586,"_2668":46587},[],"/docs/pr-preview/pr-43/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3173":340,"_28139":333,"_5":28478,"_19503":46589,"_25626":46590,"_2668":46591},[],"/docs/pr-preview/pr-43/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3173":341,"_28139":333,"_19503":46593,"_5":13343,"_25626":46570,"_2668":46594},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3173":342,"_28139":333,"_19503":46596,"_5":13343,"_25626":46574,"_2668":46597},[],"Workflow",{"_3173":343,"_28139":333,"_19503":46599,"_5":13343,"_25626":46574,"_2668":46600},[],"Use it for",{"_3173":344,"_28139":333,"_19503":46602,"_5":13343,"_25626":46574,"_2668":46603},[],"What it installs",{"_3173":345,"_28139":333,"_19503":46605,"_5":13343,"_25626":46574,"_2668":46606},[],"Helm",{"_3173":346,"_28139":333,"_19503":46608,"_5":13343,"_25626":46574,"_2668":46609},[],"Production and controlled environments",{"_3173":347,"_28139":333,"_19503":46611,"_5":13343,"_25626":46574,"_2668":46612},[],"Lamassu services and Gateway API resources",{"_3173":348,"_28139":333,"_19503":46614,"_5":13343,"_25626":46574,"_2668":45816},[],{"_3173":349,"_28139":333,"_19503":46616,"_5":13343,"_25626":46574,"_2668":46617},[],"Evaluation, demos, CI and small lab clusters",{"_3173":350,"_28139":333,"_19503":46619,"_5":13343,"_25626":46574,"_2668":46620},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3173":351,"_28139":333,"_19503":46622,"_5":13343,"_25626":46578,"_2668":46623},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3173":352,"_28139":333,"_19503":46625,"_5":13343,"_25626":46578,"_2668":46626},[],"Area",{"_3173":353,"_28139":333,"_19503":46628,"_5":13343,"_25626":46578,"_2668":46629},[],"The Lamassu chart provides",{"_3173":354,"_28139":333,"_19503":46631,"_5":13343,"_25626":46578,"_2668":46632},[],"You provide",{"_3173":355,"_28139":333,"_19503":46634,"_5":13343,"_25626":46578,"_2668":46635},[],"Lamassu applications",{"_3173":356,"_28139":333,"_19503":46637,"_5":13343,"_25626":46578,"_2668":46638},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3173":357,"_28139":333,"_19503":46640,"_5":13343,"_25626":46578,"_2668":46641},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3173":358,"_28139":333,"_19503":46643,"_5":13343,"_25626":46578,"_2668":46644},[],"PostgreSQL data",{"_3173":359,"_28139":333,"_19503":46646,"_5":13343,"_25626":46578,"_2668":46647},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3173":360,"_28139":333,"_19503":46649,"_5":13343,"_25626":46578,"_2668":46650},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3173":361,"_28139":333,"_19503":46652,"_5":13343,"_25626":46578,"_2668":46653},[],"Messaging",{"_3173":362,"_28139":333,"_19503":46655,"_5":13343,"_25626":46578,"_2668":46656},[],"RabbitMQ connection configuration for the Lamassu services",{"_3173":363,"_28139":333,"_19503":46658,"_5":13343,"_25626":46578,"_2668":46659},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3173":364,"_28139":333,"_19503":46661,"_5":13343,"_25626":46578,"_2668":46662},[],"Identity",{"_3173":365,"_28139":333,"_19503":46664,"_5":13343,"_25626":46578,"_2668":46665},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3173":366,"_28139":333,"_19503":46667,"_5":13343,"_25626":46578,"_2668":46668},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3173":367,"_28139":333,"_19503":46670,"_5":13343,"_25626":46578,"_2668":46671},[],"External routing",{"_3173":368,"_28139":333,"_19503":46673,"_5":13343,"_25626":46578,"_2668":46674},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3173":369,"_28139":333,"_19503":46676,"_5":13343,"_25626":46578,"_2668":46677},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3173":370,"_28139":333,"_19503":46679,"_5":13343,"_25626":46578,"_2668":46680},[],"TLS",{"_3173":371,"_28139":333,"_19503":46682,"_5":13343,"_25626":46578,"_2668":46683},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3173":372,"_28139":333,"_19503":46685,"_5":13343,"_25626":46578,"_2668":46686},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3173":373,"_28139":333,"_19503":46688,"_5":13343,"_25626":46578,"_2668":46689},[],"Persistent application data",{"_3173":374,"_28139":333,"_19503":46691,"_5":13343,"_25626":46578,"_2668":46692},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3173":375,"_28139":333,"_19503":46694,"_5":13343,"_25626":46578,"_2668":46695},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3173":376,"_28139":333,"_19503":46697,"_5":13343,"_25626":46578,"_2668":46698},[],"Optional integrations",{"_3173":377,"_28139":333,"_19503":46700,"_5":13343,"_25626":46578,"_2668":46701},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3173":378,"_28139":333,"_19503":46703,"_5":13343,"_25626":46578,"_2668":46704},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3173":379,"_28139":333,"_19503":46706,"_5":13343,"_25626":46578,"_2668":46707},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3173":380,"_28139":333,"_19503":46709,"_5":13343,"_25626":46578,"_2668":46710},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3173":381,"_28139":333,"_19503":46712,"_5":13343,"_25626":46582,"_2668":46713},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3173":382,"_28139":333,"_19503":46715,"_5":13343,"_25626":46582,"_2668":46716},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3173":383,"_28139":333,"_19503":46718,"_5":13343,"_25626":46586,"_2668":46719},[],"Kubernetes 1.24 or newer",{"_3173":384,"_28139":333,"_19503":46721,"_5":13343,"_25626":46586,"_2668":46722},[],"Helm 3.2 or newer",{"_3173":385,"_28139":333,"_19503":46724,"_5":13343,"_25626":46586,"_2668":46725},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3173":386,"_28139":333,"_19503":46727,"_5":13343,"_25626":46586,"_2668":46728},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3173":387,"_28139":333,"_19503":46730,"_5":13343,"_25626":46586,"_2668":46731},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3173":388,"_28139":333,"_19503":46733,"_5":13343,"_25626":46586,"_2668":46734},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3173":389,"_28139":333,"_19503":46736,"_5":13343,"_25626":46586,"_2668":46737},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3173":390,"_28139":333,"_19503":46739,"_5":13343,"_25626":46590,"_2668":46740},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3173":391,"_28139":333,"_19503":46742,"_5":13343,"_25626":46590,"_2668":46743},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3173":392,"_28139":333,"_19503":46745,"_5":13343,"_25626":46590,"_2668":46746},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3173":393,"_28139":333,"_19503":46748,"_5":13343,"_25626":46590,"_2668":46749},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3173":394,"_28139":394,"_5":13674,"_2668":46751,"_28481":46752,"_19503":46754,"_25626":394},"Deployment troubleshooting",[45572,45573,46753],"Operations",[],{"_3173":395,"_28139":394,"_19503":46756,"_5":13343,"_25626":394,"_2668":46757},[],"Diagnose access, service health and infrastructure dependencies.",{"_3173":396,"_28139":394,"_5":28478,"_19503":46759,"_25626":46760,"_2668":46761},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3173":397,"_28139":394,"_5":28478,"_19503":46763,"_25626":46764,"_2668":46765},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3173":398,"_28139":394,"_5":28478,"_19503":46767,"_25626":46768,"_2668":46769},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3173":399,"_28139":394,"_5":28478,"_19503":46771,"_25626":46772,"_2668":46773},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3173":400,"_28139":394,"_5":28478,"_19503":46775,"_25626":46776,"_2668":46777},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3173":401,"_28139":394,"_5":28478,"_19503":46779,"_25626":46780,"_2668":46781},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3173":402,"_28139":394,"_5":28478,"_19503":46783,"_25626":46784,"_2668":46785},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3173":403,"_28139":394,"_5":28478,"_19503":46787,"_25626":46788,"_2668":46789},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3173":404,"_28139":394,"_5":28478,"_19503":46791,"_25626":46792,"_2668":46793},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3173":405,"_28139":394,"_5":28478,"_19503":46795,"_25626":46796,"_2668":46797},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3173":406,"_28139":394,"_5":28478,"_19503":46799,"_25626":46800,"_2668":46801},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3173":407,"_28139":394,"_5":28478,"_19503":46803,"_25626":46804,"_2668":46805},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#observability","Observability",{"_3173":408,"_28139":394,"_19503":46807,"_5":13343,"_25626":394,"_2668":46808},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3173":409,"_28139":394,"_19503":46810,"_5":13343,"_25626":46764,"_2668":46811},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3173":410,"_28139":394,"_19503":46813,"_5":13343,"_25626":46768,"_2668":46814},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3173":411,"_28139":394,"_19503":46816,"_5":13343,"_25626":46772,"_2668":46817},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3173":412,"_28139":394,"_19503":46819,"_5":13343,"_25626":46776,"_2668":46820},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3173":413,"_28139":394,"_19503":46822,"_5":13343,"_25626":46780,"_2668":46823},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3173":414,"_28139":394,"_19503":46825,"_5":13343,"_25626":46784,"_2668":46826},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3173":415,"_28139":394,"_19503":46828,"_5":13343,"_25626":46784,"_2668":46829},[],"Also run the chart's connectivity test:",{"_3173":416,"_28139":394,"_19503":46831,"_5":13343,"_25626":46784,"_2668":46832},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3173":417,"_28139":394,"_19503":46834,"_5":13343,"_25626":46784,"_2668":46835},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3173":418,"_28139":394,"_19503":46837,"_5":13343,"_25626":46788,"_2668":46838},[],"If you receive a 401:",{"_3173":419,"_28139":394,"_19503":46840,"_5":13343,"_25626":46788,"_2668":46841},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3173":420,"_28139":394,"_19503":46843,"_5":13343,"_25626":46788,"_2668":46844},[],"verify issuer, audience and expiration of the token;",{"_3173":421,"_28139":394,"_19503":46846,"_5":13343,"_25626":46788,"_2668":46847},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3173":422,"_28139":394,"_19503":46849,"_5":13343,"_25626":46788,"_2668":46850},[],"check that the provider's public and internal routes point to the same realm.",{"_3173":423,"_28139":394,"_19503":46852,"_5":13343,"_25626":46788,"_2668":46853},[],"If login succeeds but the APIs return 403:",{"_3173":424,"_28139":394,"_19503":46855,"_5":13343,"_25626":46788,"_2668":46856},[],"inspect the token's real claims;",{"_3173":425,"_28139":394,"_19503":46858,"_5":13343,"_25626":46788,"_2668":46859},[],"confirm they match an active principal;",{"_3173":426,"_28139":394,"_19503":46861,"_5":13343,"_25626":46788,"_2668":46862},[],"review the policies granted to that principal;",{"_3173":427,"_28139":394,"_19503":46864,"_5":13343,"_25626":46788,"_2668":46865},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3173":428,"_28139":394,"_19503":46867,"_5":13343,"_25626":46788,"_2668":46868},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3173":429,"_28139":394,"_19503":46870,"_5":13343,"_25626":46792,"_2668":46871},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3173":430,"_28139":394,"_19503":46873,"_5":13343,"_25626":46792,"_2668":46874},[],"Locate the authz pod and Service.",{"_3173":431,"_28139":394,"_19503":46876,"_5":13343,"_25626":46792,"_2668":46877},[],"Check /health, logs and its database connection.",{"_3173":432,"_28139":394,"_19503":46879,"_5":13343,"_25626":46792,"_2668":46880},[],"Verify the DNS and port configured in externalAuthorization.",{"_3173":433,"_28139":394,"_19503":46882,"_5":13343,"_25626":46792,"_2668":46883},[],"Check the check route is /v1/ext\\_authz/check.",{"_3173":434,"_28139":394,"_19503":46885,"_5":13343,"_25626":46792,"_2668":46886},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3173":435,"_28139":394,"_19503":46888,"_5":13343,"_25626":46796,"_2668":46889},[],"Review kubectl describe pod first. Common causes are:",{"_3173":436,"_28139":394,"_19503":46891,"_5":13343,"_25626":46796,"_2668":46892},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3173":437,"_28139":394,"_19503":46894,"_5":13343,"_25626":46796,"_2668":46895},[],"unbound persistent volume;",{"_3173":438,"_28139":394,"_19503":46897,"_5":13343,"_25626":46796,"_2668":46898},[],"inaccessible image or incorrect pull policy;",{"_3173":439,"_28139":394,"_19503":46900,"_5":13343,"_25626":46796,"_2668":46901},[],"invalid cryptographic engine configuration;",{"_3173":440,"_28139":394,"_19503":46903,"_5":13343,"_25626":46796,"_2668":46904},[],"CPU or memory limits set too low;",{"_3173":441,"_28139":394,"_19503":46906,"_5":13343,"_25626":46796,"_2668":46907},[],"an incomplete prior migration.",{"_3173":442,"_28139":394,"_19503":46909,"_5":13343,"_25626":46796,"_2668":46910},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3173":443,"_28139":394,"_19503":46912,"_5":13343,"_25626":46796,"_2668":46913},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3173":444,"_28139":394,"_19503":46915,"_5":13343,"_25626":46796,"_2668":46916},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3173":445,"_28139":394,"_19503":46918,"_5":13343,"_25626":46800,"_2668":46919},[],"Domain and audit events depend on the bus publisher:",{"_3173":446,"_28139":394,"_19503":46921,"_5":13343,"_25626":46800,"_2668":46922},[],"verify it is enabled in the emitting service;",{"_3173":447,"_28139":394,"_19503":46924,"_5":13343,"_25626":46800,"_2668":46925},[],"check AMQP connectivity and credentials;",{"_3173":448,"_28139":394,"_19503":46927,"_5":13343,"_25626":46800,"_2668":46928},[],"review exchange, routing key, queues and consumers;",{"_3173":449,"_28139":394,"_19503":46930,"_5":13343,"_25626":46800,"_2668":46931},[],"inspect dead-letter queues;",{"_3173":450,"_28139":394,"_19503":46933,"_5":13343,"_25626":46800,"_2668":46934},[],"alert on orphan durable queues and backlog growth.",{"_3173":451,"_28139":394,"_19503":46936,"_5":13343,"_25626":46800,"_2668":46937},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3173":452,"_28139":394,"_19503":46939,"_5":13343,"_25626":46804,"_2668":46940},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_3173":453,"_28139":394,"_19503":46942,"_5":13343,"_25626":46804,"_2668":46943},[],"Before closing an incident, record:",{"_3173":454,"_28139":394,"_19503":46945,"_5":13343,"_25626":46804,"_2668":46946},[],"the confirmed cause;",{"_3173":455,"_28139":394,"_19503":46948,"_5":13343,"_25626":46804,"_2668":46949},[],"the time scope and affected resources;",{"_3173":456,"_28139":394,"_19503":46951,"_5":13343,"_25626":46804,"_2668":46952},[],"the commands or queries used;",{"_3173":457,"_28139":394,"_19503":46954,"_5":13343,"_25626":46804,"_2668":46955},[],"the applied change and how to revert it;",{"_3173":458,"_28139":394,"_19503":46957,"_5":13343,"_25626":46804,"_2668":46958},[],"validation from a consumer;",{"_3173":459,"_28139":394,"_19503":46960,"_5":13343,"_25626":46804,"_2668":46961},[],"the preventive action and its owner.",{"_3173":460,"_28139":460,"_5":13674,"_2668":46963,"_28481":46964,"_19503":46967,"_25626":460},"Access control",[45572,46965,46966],"Platform","Administration",[],{"_3173":461,"_28139":460,"_19503":46969,"_5":13343,"_25626":460,"_2668":46970},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3173":462,"_28139":460,"_5":28478,"_19503":46972,"_25626":46973,"_2668":46974},[],"/docs/pr-preview/pr-43/platform/administration/access-control#essential-concepts","Essential concepts",{"_3173":463,"_28139":460,"_5":28478,"_19503":46976,"_25626":46977,"_2668":46978},[],"/docs/pr-preview/pr-43/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3173":464,"_28139":460,"_5":28478,"_19503":46980,"_25626":46981,"_2668":46982},[],"/docs/pr-preview/pr-43/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3173":465,"_28139":460,"_5":28478,"_19503":46984,"_25626":46985,"_2668":46986},[],"/docs/pr-preview/pr-43/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3173":466,"_28139":460,"_5":28478,"_19503":46988,"_25626":46989,"_2668":46990},[],"/docs/pr-preview/pr-43/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3173":467,"_28139":460,"_5":28478,"_19503":46992,"_25626":46993,"_2668":46994},[],"/docs/pr-preview/pr-43/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3173":468,"_28139":460,"_5":28478,"_19503":46996,"_25626":46997,"_2668":46998},[],"/docs/pr-preview/pr-43/platform/administration/access-control#oidc-principals","OIDC principals",{"_3173":469,"_28139":460,"_5":28478,"_19503":47000,"_25626":47001,"_2668":47002},[],"/docs/pr-preview/pr-43/platform/administration/access-control#x509-principals","X.509 principals",{"_3173":470,"_28139":460,"_5":28478,"_19503":47004,"_25626":47005,"_2668":47006},[],"/docs/pr-preview/pr-43/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3173":471,"_28139":460,"_5":28478,"_19503":47008,"_25626":47009,"_2668":47010},[],"/docs/pr-preview/pr-43/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3173":472,"_28139":460,"_5":28478,"_19503":47012,"_25626":47013,"_2668":47014},[],"/docs/pr-preview/pr-43/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3173":473,"_28139":460,"_5":28478,"_19503":47016,"_25626":47017,"_2668":47018},[],"/docs/pr-preview/pr-43/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3173":474,"_28139":460,"_5":28478,"_19503":47020,"_25626":47021,"_2668":47022},[],"/docs/pr-preview/pr-43/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3173":475,"_28139":460,"_5":28478,"_19503":47024,"_25626":47025,"_2668":47026},[],"/docs/pr-preview/pr-43/platform/administration/access-control#http-rules","HTTP rules",{"_3173":476,"_28139":460,"_5":28478,"_19503":47028,"_25626":47029,"_2668":47030},[],"/docs/pr-preview/pr-43/platform/administration/access-control#included-policies","Included policies",{"_3173":477,"_28139":460,"_5":28478,"_19503":47032,"_25626":47033,"_2668":46208},[],"/docs/pr-preview/pr-43/platform/administration/access-control#provision-the-first-administrator",{"_3173":478,"_28139":460,"_5":28478,"_19503":47035,"_25626":47036,"_2668":47037},[],"/docs/pr-preview/pr-43/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3173":479,"_28139":460,"_5":28478,"_19503":47039,"_25626":47040,"_2668":47041},[],"/docs/pr-preview/pr-43/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3173":480,"_28139":460,"_5":28478,"_19503":47043,"_25626":47044,"_2668":47045},[],"/docs/pr-preview/pr-43/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3173":481,"_28139":460,"_5":28478,"_19503":47047,"_25626":47048,"_2668":47049},[],"/docs/pr-preview/pr-43/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3173":482,"_28139":460,"_5":28478,"_19503":47051,"_25626":47052,"_2668":47053},[],"/docs/pr-preview/pr-43/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3173":483,"_28139":460,"_5":28478,"_19503":47055,"_25626":47056,"_2668":47057},[],"/docs/pr-preview/pr-43/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3173":484,"_28139":460,"_5":28478,"_19503":47059,"_25626":47060,"_2668":47061},[],"/docs/pr-preview/pr-43/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3173":485,"_28139":460,"_5":28478,"_19503":47063,"_25626":47064,"_2668":47065},[],"/docs/pr-preview/pr-43/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3173":486,"_28139":460,"_5":28478,"_19503":47067,"_25626":47068,"_2668":47069},[],"/docs/pr-preview/pr-43/platform/administration/access-control#operational-checklist","Operational checklist",{"_3173":487,"_28139":460,"_5":28478,"_19503":47071,"_25626":47072,"_2668":47073},[],"/docs/pr-preview/pr-43/platform/administration/access-control#diagnostics","Diagnostics",{"_3173":488,"_28139":460,"_5":28478,"_19503":47075,"_25626":47076,"_2668":47077},[],"/docs/pr-preview/pr-43/platform/administration/access-control#the-response-is-401","The response is 401",{"_3173":489,"_28139":460,"_5":28478,"_19503":47079,"_25626":47080,"_2668":47081},[],"/docs/pr-preview/pr-43/platform/administration/access-control#the-response-is-403","The response is 403",{"_3173":490,"_28139":460,"_5":28478,"_19503":47083,"_25626":47084,"_2668":47085},[],"/docs/pr-preview/pr-43/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3173":491,"_28139":460,"_5":28478,"_19503":47087,"_25626":47088,"_2668":47089},[],"/docs/pr-preview/pr-43/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3173":492,"_28139":460,"_5":28478,"_19503":47091,"_25626":47092,"_2668":47093},[],"/docs/pr-preview/pr-43/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3173":493,"_28139":460,"_19503":47095,"_5":13343,"_25626":460,"_2668":47096},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3173":494,"_28139":460,"_19503":47098,"_5":13343,"_25626":460,"_2668":47099},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3173":495,"_28139":460,"_19503":47101,"_5":13343,"_25626":460,"_2668":47102},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3173":496,"_28139":460,"_19503":47104,"_5":13343,"_25626":46973,"_2668":47105},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3173":497,"_28139":460,"_19503":47107,"_5":13343,"_25626":46973,"_2668":47108},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3173":498,"_28139":460,"_19503":47110,"_5":13343,"_25626":46973,"_2668":47111},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3173":499,"_28139":460,"_19503":47113,"_5":13343,"_25626":46973,"_2668":47114},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3173":500,"_28139":460,"_19503":47116,"_5":13343,"_25626":46973,"_2668":47117},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3173":501,"_28139":460,"_19503":47119,"_5":13343,"_25626":46973,"_2668":47120},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3173":502,"_28139":460,"_19503":47122,"_5":13343,"_25626":46977,"_2668":47123},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3173":503,"_28139":460,"_19503":47125,"_5":13343,"_25626":46977,"_2668":47126},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3173":504,"_28139":460,"_19503":47128,"_5":13343,"_25626":46981,"_2668":47129},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3173":505,"_28139":460,"_19503":47131,"_5":13343,"_25626":46981,"_2668":47132},[],"The decision is made **before forwarding the request to the service**:",{"_3173":506,"_28139":460,"_19503":47134,"_5":13343,"_25626":46981,"_2668":47135},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3173":507,"_28139":460,"_19503":47137,"_5":13343,"_25626":46981,"_2668":47138},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3173":508,"_28139":460,"_19503":47140,"_5":13343,"_25626":46981,"_2668":47141},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3173":509,"_28139":460,"_19503":47143,"_5":13343,"_25626":46981,"_2668":47144},[],"It separately loads the policies granted to each principal.",{"_3173":510,"_28139":460,"_19503":47146,"_5":13343,"_25626":46981,"_2668":47147},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3173":511,"_28139":460,"_19503":47149,"_5":13343,"_25626":46981,"_2668":47150},[],"`authz` looks for an HTTP rule granting that action.",{"_3173":512,"_28139":460,"_19503":47152,"_5":13343,"_25626":46981,"_2668":47153},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3173":513,"_28139":460,"_19503":47155,"_5":13343,"_25626":46981,"_2668":47156},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3173":514,"_28139":460,"_19503":47158,"_5":13343,"_25626":46981,"_2668":47159},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3173":515,"_28139":460,"_19503":47161,"_5":13343,"_25626":46981,"_2668":47162},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3173":516,"_28139":460,"_19503":47164,"_5":13343,"_25626":46985,"_2668":47165},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3173":517,"_28139":460,"_19503":47167,"_5":13343,"_25626":46985,"_2668":47168},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3173":518,"_28139":460,"_19503":47170,"_5":13343,"_25626":46985,"_2668":47171},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3173":519,"_28139":460,"_19503":47173,"_5":13343,"_25626":46985,"_2668":47174},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3173":520,"_28139":460,"_19503":47176,"_5":13343,"_25626":46985,"_2668":47177},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3173":521,"_28139":460,"_19503":47179,"_5":13343,"_25626":46985,"_2668":47180},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3173":522,"_28139":460,"_19503":47182,"_5":13343,"_25626":46985,"_2668":47183},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3173":523,"_28139":460,"_19503":47185,"_5":13343,"_25626":46985,"_2668":47186},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3173":524,"_28139":460,"_19503":47188,"_5":13343,"_25626":46989,"_2668":47189},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3173":525,"_28139":460,"_19503":47191,"_5":13343,"_25626":46989,"_2668":47192},[],"The decision is made with the domain operation context:",{"_3173":526,"_28139":460,"_19503":47194,"_5":13343,"_25626":46989,"_2668":47195},[],"The middleware extracts the credential and resolves the matching principals.",{"_3173":527,"_28139":460,"_19503":47197,"_5":13343,"_25626":46989,"_2668":47198},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3173":528,"_28139":460,"_19503":47200,"_5":13343,"_25626":46989,"_2668":47201},[],"`authz` gathers the entity rules of the granted policies.",{"_3173":529,"_28139":460,"_19503":47203,"_5":13343,"_25626":46989,"_2668":47204},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3173":530,"_28139":460,"_19503":47206,"_5":13343,"_25626":46989,"_2668":47207},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3173":531,"_28139":460,"_19503":47209,"_5":13343,"_25626":46989,"_2668":47210},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3173":532,"_28139":460,"_19503":47212,"_5":13343,"_25626":46989,"_2668":47213},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3173":533,"_28139":460,"_19503":47215,"_5":13343,"_25626":46989,"_2668":47216},[],"Actions fall into two groups:",{"_3173":534,"_28139":460,"_19503":47218,"_5":13343,"_25626":46989,"_2668":47219},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3173":535,"_28139":460,"_19503":47221,"_5":13343,"_25626":46989,"_2668":47222},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3173":536,"_28139":460,"_19503":47224,"_5":13343,"_25626":46989,"_2668":47225},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3173":537,"_28139":460,"_19503":47227,"_5":13343,"_25626":46993,"_2668":47228},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3173":538,"_28139":460,"_19503":47230,"_5":13343,"_25626":46993,"_2668":47231},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3173":539,"_28139":460,"_19503":47233,"_5":13343,"_25626":46993,"_2668":47234},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3173":540,"_28139":460,"_19503":47236,"_5":13343,"_25626":46997,"_2668":47237},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3173":541,"_28139":460,"_19503":47239,"_5":13343,"_25626":46997,"_2668":47240},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3173":542,"_28139":460,"_19503":47242,"_5":13343,"_25626":46997,"_2668":47243},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3173":543,"_28139":460,"_19503":47245,"_5":13343,"_25626":46997,"_2668":47246},[],"The implemented operators are:",{"_3173":544,"_28139":460,"_19503":47248,"_5":13343,"_25626":46997,"_2668":47249},[],"`equals`, for exact equality;",{"_3173":545,"_28139":460,"_19503":47251,"_5":13343,"_25626":46997,"_2668":47252},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3173":546,"_28139":460,"_19503":47254,"_5":13343,"_25626":46997,"_2668":47255},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3173":547,"_28139":460,"_19503":47257,"_5":13343,"_25626":46997,"_2668":47258},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3173":548,"_28139":460,"_19503":47260,"_5":13343,"_25626":47001,"_2668":47261},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3173":549,"_28139":460,"_19503":47263,"_5":13343,"_25626":47001,"_2668":47264},[],"The available modes are:",{"_3173":550,"_28139":460,"_19503":47266,"_5":13343,"_25626":47001,"_2668":47267},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3173":551,"_28139":460,"_19503":47269,"_5":13343,"_25626":47001,"_2668":47270},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3173":552,"_28139":460,"_19503":47272,"_5":13343,"_25626":47001,"_2668":47273},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3173":553,"_28139":460,"_19503":47275,"_5":13343,"_25626":47001,"_2668":47276},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3173":554,"_28139":460,"_19503":47278,"_5":13343,"_25626":47001,"_2668":47279},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3173":555,"_28139":460,"_19503":47281,"_5":13343,"_25626":47001,"_2668":47282},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3173":556,"_28139":460,"_19503":47284,"_5":13343,"_25626":47005,"_2668":47285},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3173":557,"_28139":460,"_19503":47287,"_5":13343,"_25626":47005,"_2668":47288},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3173":558,"_28139":460,"_19503":47290,"_5":13343,"_25626":47005,"_2668":47291},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3173":559,"_28139":460,"_19503":47293,"_5":13343,"_25626":47005,"_2668":47294},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3173":560,"_28139":460,"_19503":47296,"_5":13343,"_25626":47013,"_2668":47297},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3173":561,"_28139":460,"_19503":47299,"_5":13343,"_25626":47013,"_2668":47300},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3173":562,"_28139":460,"_19503":47302,"_5":13343,"_25626":47017,"_2668":47303},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3173":563,"_28139":460,"_19503":47305,"_5":13343,"_25626":47017,"_2668":47306},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3173":564,"_28139":460,"_19503":47308,"_5":13343,"_25626":47021,"_2668":47309},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3173":565,"_28139":460,"_19503":47311,"_5":13343,"_25626":47021,"_2668":47312},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3173":566,"_28139":460,"_19503":47314,"_5":13343,"_25626":47021,"_2668":47315},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3173":567,"_28139":460,"_19503":47317,"_5":13343,"_25626":47025,"_2668":47318},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3173":568,"_28139":460,"_19503":47320,"_5":13343,"_25626":47025,"_2668":47321},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3173":569,"_28139":460,"_19503":47323,"_5":13343,"_25626":47025,"_2668":47324},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3173":570,"_28139":460,"_19503":47326,"_5":13343,"_25626":47025,"_2668":47327},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3173":571,"_28139":460,"_19503":47329,"_5":13343,"_25626":47025,"_2668":47330},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3173":572,"_28139":460,"_19503":47332,"_5":13343,"_25626":47025,"_2668":47333},[],"Note that:",{"_3173":573,"_28139":460,"_19503":47335,"_5":13343,"_25626":47025,"_2668":47336},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3173":574,"_28139":460,"_19503":47338,"_5":13343,"_25626":47025,"_2668":47339},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3173":575,"_28139":460,"_19503":47341,"_5":13343,"_25626":47025,"_2668":47342},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3173":576,"_28139":460,"_19503":47344,"_5":13343,"_25626":47029,"_2668":47345},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3173":577,"_28139":460,"_19503":47347,"_5":13343,"_25626":47029,"_2668":47348},[],"full and read-only access to certificates and authorities;",{"_3173":578,"_28139":460,"_19503":47350,"_5":13343,"_25626":47029,"_2668":47351},[],"full and read-only access to the KMS;",{"_3173":579,"_28139":460,"_19503":47353,"_5":13343,"_25626":47029,"_2668":47354},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3173":580,"_28139":460,"_19503":47356,"_5":13343,"_25626":47029,"_2668":47357},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3173":581,"_28139":460,"_19503":47359,"_5":13343,"_25626":47029,"_2668":47360},[],"console access;",{"_3173":582,"_28139":460,"_19503":47362,"_5":13343,"_25626":47029,"_2668":47363},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3173":583,"_28139":460,"_19503":47365,"_5":13343,"_25626":47029,"_2668":47366},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3173":584,"_28139":460,"_19503":47368,"_5":13343,"_25626":47029,"_2668":47369},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3173":585,"_28139":460,"_19503":47371,"_5":13343,"_25626":47033,"_2668":47372},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3173":586,"_28139":460,"_19503":47374,"_5":13343,"_25626":47033,"_2668":47375},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3173":587,"_28139":460,"_19503":47377,"_5":13343,"_25626":47033,"_2668":47378},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3173":588,"_28139":460,"_19503":47380,"_5":13343,"_25626":47036,"_2668":47381},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3173":589,"_28139":460,"_19503":47383,"_5":13343,"_25626":47040,"_2668":47384},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3173":590,"_28139":460,"_19503":47386,"_5":13343,"_25626":47040,"_2668":47387},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3173":591,"_28139":460,"_19503":47389,"_5":13343,"_25626":47044,"_2668":47390},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3173":592,"_28139":460,"_19503":47392,"_5":13343,"_25626":47048,"_2668":47393},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3173":593,"_28139":460,"_19503":47395,"_5":13343,"_25626":47052,"_2668":47396},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3173":594,"_28139":460,"_19503":47398,"_5":13343,"_25626":47056,"_2668":47399},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3173":595,"_28139":460,"_19503":47401,"_5":13343,"_25626":47056,"_2668":47402},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3173":596,"_28139":460,"_19503":47404,"_5":13343,"_25626":47060,"_2668":47405},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3173":597,"_28139":460,"_19503":47407,"_5":13343,"_25626":47060,"_2668":47408},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3173":598,"_28139":460,"_19503":47410,"_5":13343,"_25626":47060,"_2668":47411},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3173":599,"_28139":460,"_19503":47413,"_5":13343,"_25626":47060,"_2668":47414},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3173":600,"_28139":460,"_19503":47416,"_5":13343,"_25626":47060,"_2668":47417},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3173":601,"_28139":460,"_19503":47419,"_5":13343,"_25626":47060,"_2668":47420},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3173":602,"_28139":460,"_19503":47422,"_5":13343,"_25626":47060,"_2668":47423},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3173":603,"_28139":460,"_19503":47425,"_5":13343,"_25626":47060,"_2668":47426},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3173":604,"_28139":460,"_19503":47428,"_5":13343,"_25626":47064,"_2668":47429},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3173":605,"_28139":460,"_19503":47431,"_5":13343,"_25626":47064,"_2668":47432},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3173":606,"_28139":460,"_19503":47434,"_5":13343,"_25626":47064,"_2668":47435},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3173":607,"_28139":460,"_19503":47437,"_5":13343,"_25626":47068,"_2668":47438},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3173":608,"_28139":460,"_19503":47440,"_5":13343,"_25626":47068,"_2668":47441},[],"Use groups or stable roles for people and independent identities for automations.",{"_3173":609,"_28139":460,"_19503":47443,"_5":13343,"_25626":47068,"_2668":47444},[],"Keep at least two recovery administrators and test their access periodically.",{"_3173":610,"_28139":460,"_19503":47446,"_5":13343,"_25626":47068,"_2668":47447},[],"Review active principals, their matches and their grants after IdP changes.",{"_3173":611,"_28139":460,"_19503":47449,"_5":13343,"_25626":47068,"_2668":47450},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3173":612,"_28139":460,"_19503":47452,"_5":13343,"_25626":47068,"_2668":47453},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3173":613,"_28139":460,"_19503":47455,"_5":13343,"_25626":47068,"_2668":47456},[],"Always test one allowed and one denied operation for each role.",{"_3173":614,"_28139":460,"_19503":47458,"_5":13343,"_25626":47068,"_2668":47459},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3173":615,"_28139":460,"_19503":47461,"_5":13343,"_25626":47076,"_2668":47462},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3173":616,"_28139":460,"_19503":47464,"_5":13343,"_25626":47080,"_2668":47465},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3173":617,"_28139":460,"_19503":47467,"_5":13343,"_25626":47080,"_2668":47468},[],"that an active principal of the correct type exists;",{"_3173":618,"_28139":460,"_19503":47470,"_5":13343,"_25626":47080,"_2668":47471},[],"that the claim paths and values match the real token exactly;",{"_3173":619,"_28139":460,"_19503":47473,"_5":13343,"_25626":47080,"_2668":47474},[],"that all of the principal's conditions hold;",{"_3173":620,"_28139":460,"_19503":47476,"_5":13343,"_25626":47080,"_2668":47477},[],"that the principal has the expected policy granted;",{"_3173":621,"_28139":460,"_19503":47479,"_5":13343,"_25626":47080,"_2668":47480},[],"that the policy includes the action and the requested resource type or route;",{"_3173":622,"_28139":460,"_19503":47482,"_5":13343,"_25626":47080,"_2668":47483},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3173":623,"_28139":460,"_19503":47485,"_5":13343,"_25626":47080,"_2668":47486},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_3173":624,"_28139":460,"_19503":47488,"_5":13343,"_25626":47084,"_2668":47489},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3173":625,"_28139":460,"_19503":47491,"_5":13343,"_25626":47088,"_2668":47492},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3173":626,"_28139":460,"_19503":47494,"_5":13343,"_25626":47092,"_2668":47495},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3173":627,"_28139":460,"_19503":47497,"_5":13343,"_25626":47092,"_2668":47498},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3173":628,"_28139":628,"_5":13674,"_2668":47500,"_28481":47501,"_19503":47502,"_25626":628},"Alerts and subscriptions",[45572,46965,46966],[],{"_3173":629,"_28139":628,"_19503":47504,"_5":13343,"_25626":628,"_2668":47505},[],"Send PKI events to people and external systems.",{"_3173":630,"_28139":628,"_5":28478,"_19503":47507,"_25626":47508,"_2668":47509},[],"/docs/pr-preview/pr-43/platform/administration/alerts#how-it-works","How it works",{"_3173":631,"_28139":628,"_5":28478,"_19503":47511,"_25626":47512,"_2668":47513},[],"/docs/pr-preview/pr-43/platform/administration/alerts#available-channels","Available channels",{"_3173":632,"_28139":628,"_5":28478,"_19503":47515,"_25626":47516,"_2668":47517},[],"/docs/pr-preview/pr-43/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3173":633,"_28139":628,"_5":28478,"_19503":47519,"_25626":47520,"_2668":47521},[],"/docs/pr-preview/pr-43/platform/administration/alerts#choose-the-event","Choose the event",{"_3173":634,"_28139":628,"_5":28478,"_19503":47523,"_25626":47524,"_2668":47525},[],"/docs/pr-preview/pr-43/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3173":635,"_28139":628,"_5":28478,"_19503":47527,"_25626":47528,"_2668":47529},[],"/docs/pr-preview/pr-43/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3173":636,"_28139":628,"_5":28478,"_19503":47531,"_25626":47532,"_2668":47533},[],"/docs/pr-preview/pr-43/platform/administration/alerts#review-and-activate","Review and activate",{"_3173":637,"_28139":628,"_5":28478,"_19503":47535,"_25626":47536,"_2668":47537},[],"/docs/pr-preview/pr-43/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3173":638,"_28139":628,"_5":28478,"_19503":47539,"_25626":47540,"_2668":47541},[],"/docs/pr-preview/pr-43/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3173":639,"_28139":628,"_5":28478,"_19503":47543,"_25626":47544,"_2668":47545},[],"/docs/pr-preview/pr-43/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3173":640,"_28139":628,"_5":28478,"_19503":47547,"_25626":47548,"_2668":47549},[],"/docs/pr-preview/pr-43/platform/administration/alerts#event-families","Event families",{"_3173":641,"_28139":628,"_19503":47551,"_5":13343,"_25626":628,"_2668":47552},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3173":642,"_28139":628,"_19503":47554,"_5":13343,"_25626":47508,"_2668":47555},[],"A service publishes a domain event.",{"_3173":643,"_28139":628,"_19503":47557,"_5":13343,"_25626":47508,"_2668":47558},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3173":644,"_28139":628,"_19503":47560,"_5":13343,"_25626":47508,"_2668":47561},[],"Each subscription's filter decides whether it should be notified.",{"_3173":645,"_28139":628,"_19503":47563,"_5":13343,"_25626":47508,"_2668":47564},[],"Lamassu delivers the event to the configured channel.",{"_3173":646,"_28139":628,"_19503":47566,"_5":13343,"_25626":47508,"_2668":47567},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3173":647,"_28139":628,"_19503":47569,"_5":13343,"_25626":47512,"_2668":47570},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3173":648,"_28139":628,"_19503":47572,"_5":13343,"_25626":47512,"_2668":47573},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3173":649,"_28139":628,"_19503":47575,"_5":13343,"_25626":47512,"_2668":47576},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3173":650,"_28139":628,"_19503":47578,"_5":13343,"_25626":47512,"_2668":47579},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3173":651,"_28139":628,"_19503":47581,"_5":13343,"_25626":47512,"_2668":47582},[],"`apikey_options` requires `header` and `key`.",{"_3173":652,"_28139":628,"_19503":47584,"_5":13343,"_25626":47512,"_2668":47585},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3173":653,"_28139":628,"_19503":47587,"_5":13343,"_25626":47512,"_2668":47588},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3173":654,"_28139":628,"_19503":47590,"_5":13343,"_25626":47512,"_2668":47591},[],"The alerts API reference documents the full `http_client` schema.",{"_3173":655,"_28139":628,"_19503":47593,"_5":13343,"_25626":47520,"_2668":47594},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3173":656,"_28139":628,"_19503":47596,"_5":13343,"_25626":47524,"_2668":47597},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3173":657,"_28139":628,"_19503":47599,"_5":13343,"_25626":47528,"_2668":47600},[],"Add a filter if you don't want to receive every instance of the event.",{"_3173":658,"_28139":628,"_19503":47602,"_5":13343,"_25626":47528,"_2668":47603},[],"**None** notifies all instances of the event.",{"_3173":659,"_28139":628,"_19503":47605,"_5":13343,"_25626":47528,"_2668":47606},[],"**JSON Path** evaluates one or more specific fields.",{"_3173":660,"_28139":628,"_19503":47608,"_5":13343,"_25626":47528,"_2668":47609},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3173":661,"_28139":628,"_19503":47611,"_5":13343,"_25626":47528,"_2668":47612},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3173":662,"_28139":628,"_19503":47614,"_5":13343,"_25626":47528,"_2668":47615},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3173":663,"_28139":628,"_19503":47617,"_5":13343,"_25626":47532,"_2668":47618},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3173":664,"_28139":628,"_19503":47620,"_5":13343,"_25626":47536,"_2668":47621},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3173":665,"_28139":628,"_19503":47623,"_5":13343,"_25626":47536,"_2668":47624},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3173":666,"_28139":628,"_19503":47626,"_5":13343,"_25626":47536,"_2668":47627},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3173":667,"_28139":628,"_19503":47629,"_5":13343,"_25626":47536,"_2668":47630},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3173":668,"_28139":628,"_19503":47632,"_5":13343,"_25626":47536,"_2668":47633},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3173":669,"_28139":628,"_19503":47635,"_5":13343,"_25626":47536,"_2668":47636},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3173":670,"_28139":628,"_19503":47638,"_5":13343,"_25626":47536,"_2668":47639},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3173":671,"_28139":628,"_19503":47641,"_5":13343,"_25626":47536,"_2668":47642},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3173":672,"_28139":628,"_19503":47644,"_5":13343,"_25626":47540,"_2668":47645},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3173":673,"_28139":628,"_19503":47647,"_5":13343,"_25626":47540,"_2668":47648},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3173":674,"_28139":628,"_19503":47650,"_5":13343,"_25626":47540,"_2668":47651},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3173":675,"_28139":628,"_19503":47653,"_5":13343,"_25626":47540,"_2668":47654},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3173":676,"_28139":628,"_19503":47656,"_5":13343,"_25626":47540,"_2668":47657},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3173":677,"_28139":628,"_19503":47659,"_5":13343,"_25626":47540,"_2668":47660},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3173":678,"_28139":628,"_19503":47662,"_5":13343,"_25626":47540,"_2668":47663},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3173":679,"_28139":628,"_19503":47665,"_5":13343,"_25626":47540,"_2668":47666},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3173":680,"_28139":628,"_19503":47668,"_5":13343,"_25626":47544,"_2668":47669},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3173":681,"_28139":628,"_19503":47671,"_5":13343,"_25626":47544,"_2668":47672},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3173":682,"_28139":628,"_19503":47674,"_5":13343,"_25626":47548,"_2668":47675},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3173":683,"_28139":628,"_19503":47677,"_5":13343,"_25626":47548,"_2668":47678},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3173":684,"_28139":628,"_19503":47680,"_5":13343,"_25626":47548,"_2668":47681},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3173":685,"_28139":628,"_19503":47683,"_5":13343,"_25626":47548,"_2668":47684},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3173":686,"_28139":628,"_19503":47686,"_5":13343,"_25626":47548,"_2668":47687},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3173":687,"_28139":628,"_19503":47689,"_5":13343,"_25626":47548,"_2668":47690},[],"**Validation:** `va.role.crl.create`.",{"_3173":688,"_28139":628,"_19503":47692,"_5":13343,"_25626":47548,"_2668":47693},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3173":689,"_28139":628,"_19503":47695,"_5":13343,"_25626":47548,"_2668":47696},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3173":690,"_28139":690,"_5":13674,"_2668":47698,"_28481":47699,"_19503":47700,"_25626":690},"Audit logs",[45572,46965,46966],[],{"_3173":691,"_28139":690,"_19503":47702,"_5":13343,"_25626":690,"_2668":47703},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3173":692,"_28139":690,"_5":28478,"_19503":47705,"_25626":47706,"_2668":47707},[],"/docs/pr-preview/pr-43/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3173":693,"_28139":690,"_5":28478,"_19503":47709,"_25626":47710,"_2668":47711},[],"/docs/pr-preview/pr-43/platform/administration/audit-logs#coverage","Coverage",{"_3173":694,"_28139":690,"_5":28478,"_19503":47713,"_25626":47714,"_2668":47715},[],"/docs/pr-preview/pr-43/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3173":695,"_28139":690,"_5":28478,"_19503":47717,"_25626":47718,"_2668":47719},[],"/docs/pr-preview/pr-43/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3173":696,"_28139":690,"_5":28478,"_19503":47721,"_25626":47722,"_2668":47723},[],"/docs/pr-preview/pr-43/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3173":697,"_28139":690,"_5":28478,"_19503":47725,"_25626":47726,"_2668":47727},[],"/docs/pr-preview/pr-43/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3173":698,"_28139":690,"_5":28478,"_19503":47729,"_25626":47730,"_2668":47731},[],"/docs/pr-preview/pr-43/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3173":699,"_28139":690,"_5":28478,"_19503":47733,"_25626":47734,"_2668":47735},[],"/docs/pr-preview/pr-43/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3173":700,"_28139":690,"_5":28478,"_19503":47737,"_25626":47738,"_2668":47739},[],"/docs/pr-preview/pr-43/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3173":701,"_28139":690,"_5":28478,"_19503":47741,"_25626":47742,"_2668":47743},[],"/docs/pr-preview/pr-43/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3173":702,"_28139":690,"_5":28478,"_19503":47745,"_25626":47746,"_2668":47747},[],"/docs/pr-preview/pr-43/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3173":703,"_28139":690,"_19503":47749,"_5":13343,"_25626":690,"_2668":47750},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3173":704,"_28139":690,"_19503":47752,"_5":13343,"_25626":47706,"_2668":47753},[],"The audit body includes:",{"_3173":705,"_28139":690,"_19503":47755,"_5":13343,"_25626":47706,"_2668":47756},[],"input: data received by the operation;",{"_3173":706,"_28139":690,"_19503":47758,"_5":13343,"_25626":47706,"_2668":47759},[],"has\\_error: whether the service returned an error;",{"_3173":707,"_28139":690,"_19503":47761,"_5":13343,"_25626":47706,"_2668":47762},[],"output: produced result or error message;",{"_3173":708,"_28139":690,"_19503":47764,"_5":13343,"_25626":47706,"_2668":47765},[],"principals: identifiers of the principals that matched the request.",{"_3173":709,"_28139":690,"_19503":47767,"_5":13343,"_25626":47706,"_2668":47768},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3173":710,"_28139":690,"_19503":47770,"_5":13343,"_25626":47706,"_2668":47771},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3173":711,"_28139":690,"_19503":47773,"_5":13343,"_25626":47710,"_2668":47774},[],"The backend applies auditing to mutations of:",{"_3173":712,"_28139":690,"_19503":47776,"_5":13343,"_25626":47710,"_2668":47777},[],"authorities, certificates and issuance profiles;",{"_3173":713,"_28139":690,"_19503":47779,"_5":13343,"_25626":47710,"_2668":47780},[],"keys and KMS engines;",{"_3173":714,"_28139":690,"_19503":47782,"_5":13343,"_25626":47710,"_2668":47783},[],"devices and identities;",{"_3173":715,"_28139":690,"_19503":47785,"_5":13343,"_25626":47710,"_2668":47786},[],"DMSs and enrollment operations;",{"_3173":716,"_28139":690,"_19503":47788,"_5":13343,"_25626":47710,"_2668":47789},[],"validation functions and CRL;",{"_3173":717,"_28139":690,"_19503":47791,"_5":13343,"_25626":47710,"_2668":47792},[],"principals, policies and authorization grants.",{"_3173":718,"_28139":690,"_19503":47794,"_5":13343,"_25626":47710,"_2668":47795},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3173":719,"_28139":690,"_19503":47797,"_5":13343,"_25626":47714,"_2668":47798},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3173":720,"_28139":690,"_19503":47800,"_5":13343,"_25626":47714,"_2668":47801},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3173":721,"_28139":690,"_19503":47803,"_5":13343,"_25626":47714,"_2668":47804},[],"Design the consumer to:",{"_3173":722,"_28139":690,"_19503":47806,"_5":13343,"_25626":47714,"_2668":47807},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3173":723,"_28139":690,"_19503":47809,"_5":13343,"_25626":47714,"_2668":47810},[],"keep the complete CloudEvent unmodified;",{"_3173":724,"_28139":690,"_19503":47812,"_5":13343,"_25626":47714,"_2668":47813},[],"record the ingestion time and detect duplicates by ID;",{"_3173":725,"_28139":690,"_19503":47815,"_5":13343,"_25626":47714,"_2668":47816},[],"encrypt in transit and at rest;",{"_3173":726,"_28139":690,"_19503":47818,"_5":13343,"_25626":47714,"_2668":47819},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3173":727,"_28139":690,"_19503":47821,"_5":13343,"_25626":47714,"_2668":47822},[],"apply an explicit retention and legal hold policy;",{"_3173":728,"_28139":690,"_19503":47824,"_5":13343,"_25626":47714,"_2668":47825},[],"alert if it stops consuming or the pending queue grows.",{"_3173":729,"_28139":690,"_19503":47827,"_5":13343,"_25626":47718,"_2668":47828},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3173":730,"_28139":690,"_19503":47830,"_5":13343,"_25626":47718,"_2668":47831},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3173":731,"_28139":690,"_19503":47833,"_5":13343,"_25626":47726,"_2668":47834},[],"Start from the reported time and normalize every source to UTC.",{"_3173":732,"_28139":690,"_19503":47836,"_5":13343,"_25626":47730,"_2668":47837},[],"Filter by event type, service source and resource identifier.",{"_3173":733,"_28139":690,"_19503":47839,"_5":13343,"_25626":47734,"_2668":47840},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3173":734,"_28139":690,"_19503":47842,"_5":13343,"_25626":47738,"_2668":47843},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3173":735,"_28139":690,"_19503":47845,"_5":13343,"_25626":47742,"_2668":47846},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3173":736,"_28139":690,"_19503":47848,"_5":13343,"_25626":47746,"_2668":47849},[],"Generate a controlled mutation in a test environment and check that:",{"_3173":737,"_28139":690,"_19503":47851,"_5":13343,"_25626":47746,"_2668":47852},[],"a successful audit event appears;",{"_3173":738,"_28139":690,"_19503":47854,"_5":13343,"_25626":47746,"_2668":47855},[],"the principal matches the identity used;",{"_3173":739,"_28139":690,"_19503":47857,"_5":13343,"_25626":47746,"_2668":47858},[],"the consumer persists it exactly once;",{"_3173":740,"_28139":690,"_19503":47860,"_5":13343,"_25626":47746,"_2668":47861},[],"it can be retrieved by resource, actor and period;",{"_3173":741,"_28139":690,"_19503":47863,"_5":13343,"_25626":47746,"_2668":47864},[],"a consumer outage raises an alert.",{"_3173":742,"_28139":690,"_19503":47866,"_5":13343,"_25626":47746,"_2668":47867},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3173":743,"_28139":743,"_5":13674,"_2668":47869,"_28481":47870,"_19503":47871,"_25626":743},"Platform architecture",[45572,46965],[],{"_3173":744,"_28139":743,"_19503":47873,"_5":13343,"_25626":743,"_2668":47874},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3173":745,"_28139":743,"_5":28478,"_19503":47876,"_25626":47877,"_2668":47878},[],"/docs/pr-preview/pr-43/platform/concepts/architecture#control-plane","Control plane",{"_3173":746,"_28139":743,"_5":28478,"_19503":47880,"_25626":47881,"_2668":47882},[],"/docs/pr-preview/pr-43/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3173":747,"_28139":743,"_5":28478,"_19503":47884,"_25626":47885,"_2668":47886},[],"/docs/pr-preview/pr-43/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3173":748,"_28139":743,"_5":28478,"_19503":47888,"_25626":47889,"_2668":47890},[],"/docs/pr-preview/pr-43/platform/concepts/architecture#status-and-validation","Status and validation",{"_3173":749,"_28139":743,"_5":28478,"_19503":47892,"_25626":47893,"_2668":47894},[],"/docs/pr-preview/pr-43/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3173":750,"_28139":743,"_19503":47896,"_5":13343,"_25626":743,"_2668":47897},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3173":751,"_28139":743,"_19503":47899,"_5":13343,"_25626":743,"_2668":47900},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3173":752,"_28139":743,"_19503":47902,"_5":13343,"_25626":47877,"_2668":47903},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3173":753,"_28139":743,"_19503":47905,"_5":13343,"_25626":47881,"_2668":47906},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3173":754,"_28139":743,"_19503":47908,"_5":13343,"_25626":47885,"_2668":47909},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3173":755,"_28139":743,"_19503":47911,"_5":13343,"_25626":47889,"_2668":47912},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3173":756,"_28139":743,"_19503":47914,"_5":13343,"_25626":47893,"_2668":47915},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3173":757,"_28139":757,"_5":13674,"_2668":47917,"_28481":47918,"_19503":47919,"_25626":757},"How Lamassu works",[45572,46965],[],{"_3173":758,"_28139":757,"_19503":47921,"_5":13343,"_25626":757,"_2668":47922},[],"The mental model of trust, keys, certificates and devices.",{"_3173":759,"_28139":757,"_5":28478,"_19503":47924,"_25626":47925,"_2668":47926},[],"/docs/pr-preview/pr-43/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3173":760,"_28139":757,"_5":28478,"_19503":47928,"_25626":47929,"_2668":47930},[],"/docs/pr-preview/pr-43/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3173":761,"_28139":757,"_19503":47932,"_5":13343,"_25626":757,"_2668":47933},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3173":762,"_28139":757,"_19503":47935,"_5":13343,"_25626":47925,"_2668":47936},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3173":763,"_28139":757,"_19503":47938,"_5":13343,"_25626":47925,"_2668":47939},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3173":764,"_28139":757,"_19503":47941,"_5":13343,"_25626":47925,"_2668":47942},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3173":765,"_28139":757,"_19503":47944,"_5":13343,"_25626":47925,"_2668":47945},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3173":766,"_28139":757,"_19503":47947,"_5":13343,"_25626":47925,"_2668":47948},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3173":767,"_28139":757,"_19503":47950,"_5":13343,"_25626":47929,"_2668":47951},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3173":768,"_28139":757,"_19503":47953,"_5":13343,"_25626":47929,"_2668":47954},[],"A DMS relates that CA to an enrollment policy.",{"_3173":769,"_28139":757,"_19503":47956,"_5":13343,"_25626":47929,"_2668":47957},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3173":770,"_28139":757,"_19503":47959,"_5":13343,"_25626":47929,"_2668":47960},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3173":771,"_28139":757,"_19503":47962,"_5":13343,"_25626":47929,"_2668":47963},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3173":772,"_28139":757,"_19503":47965,"_5":13343,"_25626":47929,"_2668":47966},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3173":773,"_28139":757,"_19503":47968,"_5":13343,"_25626":47929,"_2668":47969},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3173":774,"_28139":774,"_5":13674,"_2668":47971,"_28481":47972,"_19503":47974,"_25626":774},"Devices and identities",[45572,46965,47973,47971],"IoT Fleets",[],{"_3173":775,"_28139":774,"_19503":47976,"_5":13343,"_25626":774,"_2668":47977},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3173":776,"_28139":774,"_5":28478,"_19503":47979,"_25626":47980,"_2668":47981},[],"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#device-states","Device states",{"_3173":777,"_28139":774,"_5":28478,"_19503":47983,"_25626":47984,"_2668":47985},[],"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3173":778,"_28139":774,"_5":28478,"_19503":47987,"_25626":47988,"_2668":47989},[],"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3173":779,"_28139":774,"_5":28478,"_19503":47991,"_25626":47992,"_2668":47993},[],"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3173":780,"_28139":774,"_5":28478,"_19503":47995,"_25626":47996,"_2668":47997},[],"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3173":781,"_28139":774,"_5":28478,"_19503":47999,"_25626":48000,"_2668":48001},[],"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3173":782,"_28139":774,"_5":28478,"_19503":48003,"_25626":48004,"_2668":48005},[],"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3173":783,"_28139":774,"_5":28478,"_19503":48007,"_25626":48008,"_2668":48009},[],"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3173":784,"_28139":774,"_5":28478,"_19503":48011,"_25626":48012,"_2668":48013},[],"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3173":785,"_28139":774,"_5":28478,"_19503":48015,"_25626":48016,"_2668":48017},[],"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3173":786,"_28139":774,"_5":28478,"_19503":48019,"_25626":48020,"_2668":48021},[],"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3173":787,"_28139":774,"_19503":48023,"_5":13343,"_25626":774,"_2668":48024},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3173":788,"_28139":774,"_19503":48026,"_5":13343,"_25626":774,"_2668":48027},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3173":789,"_28139":774,"_19503":48029,"_5":13343,"_25626":47980,"_2668":48030},[],"Operational view",{"_3173":790,"_28139":774,"_19503":48032,"_5":13343,"_25626":47980,"_2668":48033},[],"Meaning",{"_3173":791,"_28139":774,"_19503":48035,"_5":13343,"_25626":47980,"_2668":48036},[],"**No Identity**",{"_3173":792,"_28139":774,"_19503":48038,"_5":13343,"_25626":47980,"_2668":48039},[],"A record exists without an associated identity.",{"_3173":793,"_28139":774,"_19503":48041,"_5":13343,"_25626":47980,"_2668":48042},[],"**Active**",{"_3173":794,"_28139":774,"_19503":48044,"_5":13343,"_25626":47980,"_2668":48045},[],"The slot is active; also check certificate dates, status and usages.",{"_3173":795,"_28139":774,"_19503":48047,"_5":13343,"_25626":47980,"_2668":48048},[],"**Renewal Pending**",{"_3173":796,"_28139":774,"_19503":48050,"_5":13343,"_25626":47980,"_2668":48051},[],"The identity is in the operational renewal window.",{"_3173":797,"_28139":774,"_19503":48053,"_5":13343,"_25626":47980,"_2668":48054},[],"**Expiring Soon**",{"_3173":798,"_28139":774,"_19503":48056,"_5":13343,"_25626":47980,"_2668":48057},[],"Expiration is approaching according to configured thresholds.",{"_3173":799,"_28139":774,"_19503":48059,"_5":13343,"_25626":47980,"_2668":48060},[],"**Expired**",{"_3173":800,"_28139":774,"_19503":48062,"_5":13343,"_25626":47980,"_2668":48063},[],"The identity has expired.",{"_3173":801,"_28139":774,"_19503":48065,"_5":13343,"_25626":47980,"_2668":48066},[],"**Revoked**",{"_3173":802,"_28139":774,"_19503":48068,"_5":13343,"_25626":47980,"_2668":48069},[],"The identity is marked revoked.",{"_3173":803,"_28139":774,"_19503":48071,"_5":13343,"_25626":47980,"_2668":48072},[],"**Decommissioned**",{"_3173":804,"_28139":774,"_19503":48074,"_5":13343,"_25626":47980,"_2668":48075},[],"The record is retired and ordinary updates do not restore operation.",{"_3173":805,"_28139":774,"_19503":48077,"_5":13343,"_25626":47980,"_2668":48078},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3173":806,"_28139":774,"_19503":48080,"_5":13343,"_25626":47984,"_2668":48081},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3173":807,"_28139":774,"_19503":48083,"_5":13343,"_25626":47984,"_2668":48084},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3173":808,"_28139":774,"_19503":48086,"_5":13343,"_25626":47984,"_2668":48087},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3173":809,"_28139":774,"_19503":48089,"_5":13343,"_25626":47984,"_2668":48090},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3173":810,"_28139":774,"_19503":48092,"_5":13343,"_25626":47988,"_2668":48093},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3173":811,"_28139":774,"_19503":48095,"_5":13343,"_25626":47992,"_2668":48096},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3173":812,"_28139":774,"_19503":48098,"_5":13343,"_25626":47996,"_2668":48099},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3173":813,"_28139":774,"_19503":48101,"_5":13343,"_25626":48000,"_2668":48102},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3173":814,"_28139":774,"_19503":48104,"_5":13343,"_25626":48004,"_2668":48105},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3173":815,"_28139":774,"_19503":48107,"_5":13343,"_25626":48004,"_2668":48108},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3173":816,"_28139":774,"_19503":48110,"_5":13343,"_25626":48008,"_2668":48111},[],"From **No Identity**, use **Assign Identity**:",{"_3173":817,"_28139":774,"_19503":48113,"_5":13343,"_25626":48008,"_2668":48114},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3173":818,"_28139":774,"_19503":48116,"_5":13343,"_25626":48008,"_2668":48117},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3173":819,"_28139":774,"_19503":48119,"_5":13343,"_25626":48008,"_2668":48120},[],"Confirm and read the serial, active version and history again.",{"_3173":820,"_28139":774,"_19503":48122,"_5":13343,"_25626":48008,"_2668":48123},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3173":821,"_28139":774,"_19503":48125,"_5":13343,"_25626":48008,"_2668":48126},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3173":822,"_28139":774,"_19503":48128,"_5":13343,"_25626":48012,"_2668":48129},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3173":823,"_28139":774,"_19503":48131,"_5":13343,"_25626":48012,"_2668":48132},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3173":824,"_28139":774,"_19503":48134,"_5":13343,"_25626":48016,"_2668":48135},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3173":825,"_28139":774,"_19503":48137,"_5":13343,"_25626":48016,"_2668":48138},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3173":826,"_28139":774,"_19503":48140,"_5":13343,"_25626":48016,"_2668":48141},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3173":827,"_28139":774,"_19503":48143,"_5":13343,"_25626":48016,"_2668":48144},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3173":828,"_28139":774,"_19503":48146,"_5":13343,"_25626":48020,"_2668":48147},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3173":829,"_28139":774,"_19503":48149,"_5":13343,"_25626":48020,"_2668":48150},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3173":830,"_28139":830,"_5":13674,"_2668":48152,"_28481":48153,"_19503":48155,"_25626":830},"Bootstrap identity and authentication",[45572,46965,47973,47971,48154],"Enrollment with PKI",[],{"_3173":831,"_28139":830,"_19503":48157,"_5":13343,"_25626":830,"_2668":48158},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3173":832,"_28139":830,"_5":28478,"_19503":48160,"_25626":48161,"_2668":48162},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3173":833,"_28139":830,"_5":28478,"_19503":48164,"_25626":48165,"_2668":48166},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3173":834,"_28139":830,"_5":28478,"_19503":48168,"_25626":48169,"_2668":48170},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3173":835,"_28139":830,"_5":28478,"_19503":48172,"_25626":48173,"_2668":48174},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3173":836,"_28139":830,"_5":28478,"_19503":48176,"_25626":48177,"_2668":48178},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3173":837,"_28139":830,"_19503":48180,"_5":13343,"_25626":830,"_2668":48181},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3173":838,"_28139":830,"_19503":48183,"_5":13343,"_25626":48161,"_2668":48184},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3173":839,"_28139":830,"_19503":48186,"_5":13343,"_25626":48161,"_2668":48187},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3173":840,"_28139":830,"_19503":48189,"_5":13343,"_25626":48165,"_2668":48190},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3173":841,"_28139":830,"_19503":48192,"_5":13343,"_25626":48165,"_2668":48193},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3173":842,"_28139":830,"_19503":48195,"_5":13343,"_25626":48165,"_2668":48196},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3173":843,"_28139":830,"_19503":48198,"_5":13343,"_25626":48169,"_2668":48199},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3173":844,"_28139":830,"_19503":48201,"_5":13343,"_25626":48169,"_2668":48202},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3173":845,"_28139":830,"_19503":48204,"_5":13343,"_25626":48173,"_2668":48205},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3173":846,"_28139":830,"_19503":48207,"_5":13343,"_25626":48173,"_2668":48208},[],"Example body:",{"_3173":847,"_28139":830,"_19503":48210,"_5":13343,"_25626":48173,"_2668":48211},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3173":848,"_28139":830,"_19503":48213,"_5":13343,"_25626":48173,"_2668":48214},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3173":849,"_28139":830,"_19503":48216,"_5":13343,"_25626":48173,"_2668":48217},[],"Continuation requires a successful HTTP response and JSON:",{"_3173":850,"_28139":830,"_19503":48219,"_5":13343,"_25626":48173,"_2668":48220},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3173":851,"_28139":830,"_19503":48222,"_5":13343,"_25626":48177,"_2668":48223},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3173":852,"_28139":830,"_19503":48225,"_5":13343,"_25626":48177,"_2668":48226},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3173":853,"_28139":853,"_5":13674,"_2668":48228,"_28481":48229,"_19503":48230,"_25626":853},"Configure and operate the DMS",[45572,46965,47973,47971,48154],[],{"_3173":854,"_28139":853,"_19503":48232,"_5":13343,"_25626":853,"_2668":48233},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3173":855,"_28139":853,"_5":28478,"_19503":48235,"_25626":48236,"_2668":45582},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3173":856,"_28139":853,"_5":28478,"_19503":48238,"_25626":48239,"_2668":48240},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3173":857,"_28139":853,"_5":28478,"_19503":48242,"_25626":48243,"_2668":48244},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3173":858,"_28139":853,"_5":28478,"_19503":48246,"_25626":48247,"_2668":48248},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3173":859,"_28139":853,"_5":28478,"_19503":48250,"_25626":48251,"_2668":48252},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3173":860,"_28139":853,"_5":28478,"_19503":48254,"_25626":48255,"_2668":48256},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3173":861,"_28139":853,"_5":28478,"_19503":48258,"_25626":48259,"_2668":48260},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3173":862,"_28139":853,"_5":28478,"_19503":48262,"_25626":48263,"_2668":48264},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3173":863,"_28139":853,"_5":28478,"_19503":48266,"_25626":48267,"_2668":48268},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3173":864,"_28139":853,"_5":28478,"_19503":48270,"_25626":48271,"_2668":48272},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3173":865,"_28139":853,"_5":28478,"_19503":48274,"_25626":48275,"_2668":48276},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3173":866,"_28139":853,"_5":28478,"_19503":48278,"_25626":48279,"_2668":48280},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3173":867,"_28139":853,"_5":28478,"_19503":48282,"_25626":48283,"_2668":48284},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3173":868,"_28139":853,"_5":28478,"_19503":48286,"_25626":48287,"_2668":48288},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3173":869,"_28139":853,"_5":28478,"_19503":48290,"_25626":48291,"_2668":48292},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3173":870,"_28139":853,"_5":28478,"_19503":48294,"_25626":48295,"_2668":48296},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3173":871,"_28139":853,"_5":28478,"_19503":48298,"_25626":48299,"_2668":48300},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3173":872,"_28139":853,"_5":28478,"_19503":48302,"_25626":48303,"_2668":48304},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3173":873,"_28139":853,"_19503":48306,"_5":13343,"_25626":853,"_2668":48307},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3173":874,"_28139":853,"_19503":48309,"_5":13343,"_25626":48236,"_2668":48310},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3173":875,"_28139":853,"_19503":48312,"_5":13343,"_25626":48236,"_2668":48313},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3173":876,"_28139":853,"_19503":48315,"_5":13343,"_25626":48243,"_2668":48316},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3173":877,"_28139":853,"_19503":48318,"_5":13343,"_25626":48247,"_2668":48319},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3173":878,"_28139":853,"_19503":48321,"_5":13343,"_25626":48251,"_2668":48322},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3173":879,"_28139":853,"_19503":48324,"_5":13343,"_25626":48255,"_2668":48325},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3173":880,"_28139":853,"_19503":48327,"_5":13343,"_25626":48259,"_2668":48328},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3173":881,"_28139":853,"_19503":48330,"_5":13343,"_25626":48267,"_2668":48331},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3173":882,"_28139":853,"_19503":48333,"_5":13343,"_25626":48267,"_2668":48334},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3173":883,"_28139":853,"_19503":48336,"_5":13343,"_25626":48271,"_2668":48337},[],"`settings.enrollment_settings` field",{"_3173":884,"_28139":853,"_19503":48339,"_5":13343,"_25626":48271,"_2668":48340},[],"Decision",{"_3173":885,"_28139":853,"_19503":48342,"_5":13343,"_25626":48271,"_2668":48343},[],"`protocol`",{"_3173":886,"_28139":853,"_19503":48345,"_5":13343,"_25626":48271,"_2668":48346},[],"`EST_RFC7030` for these operations.",{"_3173":887,"_28139":853,"_19503":48348,"_5":13343,"_25626":48271,"_2668":48349},[],"`enrollment_ca`",{"_3173":888,"_28139":853,"_19503":48351,"_5":13343,"_25626":48271,"_2668":48352},[],"ID of the signing CA.",{"_3173":889,"_28139":853,"_19503":48354,"_5":13343,"_25626":48271,"_2668":48355},[],"`verify_csr_signature`",{"_3173":890,"_28139":853,"_19503":48357,"_5":13343,"_25626":48271,"_2668":48358},[],"Keep `true` to verify CSR key possession.",{"_3173":891,"_28139":853,"_19503":48360,"_5":13343,"_25626":48271,"_2668":48361},[],"`enable_replaceable_enrollment`",{"_3173":892,"_28139":853,"_19503":48363,"_5":13343,"_25626":48271,"_2668":48364},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3173":893,"_28139":853,"_19503":48366,"_5":13343,"_25626":48271,"_2668":48367},[],"`est_rfc7030_settings.auth_mode`",{"_3173":894,"_28139":853,"_19503":48369,"_5":13343,"_25626":48271,"_2668":48370},[],"One of the four authentication modes.",{"_3173":895,"_28139":853,"_19503":48372,"_5":13343,"_25626":48271,"_2668":48373},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3173":896,"_28139":853,"_19503":48375,"_5":13343,"_25626":48275,"_2668":48376},[],"The blocks are independent:",{"_3173":897,"_28139":853,"_19503":48378,"_5":13343,"_25626":48275,"_2668":48379},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3173":898,"_28139":853,"_19503":48381,"_5":13343,"_25626":48275,"_2668":48382},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3173":899,"_28139":853,"_19503":48384,"_5":13343,"_25626":48275,"_2668":48385},[],"`auth_mode`",{"_3173":900,"_28139":853,"_19503":48387,"_5":13343,"_25626":48275,"_2668":48388},[],"Control applied in the configured operation",{"_3173":901,"_28139":853,"_19503":48390,"_5":13343,"_25626":48275,"_2668":48391},[],"`CLIENT_CERTIFICATE`",{"_3173":902,"_28139":853,"_19503":48393,"_5":13343,"_25626":48275,"_2668":48394},[],"Presented certificate validation.",{"_3173":903,"_28139":853,"_19503":48396,"_5":13343,"_25626":48275,"_2668":48397},[],"`EXTERNAL_WEBHOOK`",{"_3173":904,"_28139":853,"_19503":48399,"_5":13343,"_25626":48275,"_2668":48400},[],"Configured webhook authorization.",{"_3173":905,"_28139":853,"_19503":48402,"_5":13343,"_25626":48275,"_2668":48403},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3173":906,"_28139":853,"_19503":48405,"_5":13343,"_25626":48275,"_2668":48406},[],"Certificate validation followed by webhook approval.",{"_3173":907,"_28139":853,"_19503":48408,"_5":13343,"_25626":48275,"_2668":48409},[],"`NO_AUTH`",{"_3173":908,"_28139":853,"_19503":48411,"_5":13343,"_25626":48275,"_2668":48412},[],"No DMS requester authentication.",{"_3173":909,"_28139":853,"_19503":48414,"_5":13343,"_25626":48275,"_2668":48415},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3173":910,"_28139":853,"_19503":48417,"_5":13343,"_25626":48275,"_2668":48418},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3173":911,"_28139":853,"_19503":48420,"_5":13343,"_25626":48275,"_2668":48421},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3173":912,"_28139":853,"_19503":48423,"_5":13343,"_25626":48275,"_2668":48424},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3173":913,"_28139":853,"_19503":48426,"_5":13343,"_25626":48279,"_2668":48427},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3173":914,"_28139":853,"_19503":48429,"_5":13343,"_25626":48279,"_2668":48430},[],"`external_webhook_settings` field",{"_3173":915,"_28139":853,"_19503":48432,"_5":13343,"_25626":48279,"_2668":48340},[],{"_3173":916,"_28139":853,"_19503":48434,"_5":13343,"_25626":48279,"_2668":48435},[],"`url`",{"_3173":917,"_28139":853,"_19503":48437,"_5":13343,"_25626":48279,"_2668":48438},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3173":918,"_28139":853,"_19503":48440,"_5":13343,"_25626":48279,"_2668":48441},[],"`method`",{"_3173":919,"_28139":853,"_19503":48443,"_5":13343,"_25626":48279,"_2668":48444},[],"`POST` or `PUT`; `POST` by default.",{"_3173":920,"_28139":853,"_19503":48446,"_5":13343,"_25626":48279,"_2668":48447},[],"`name`",{"_3173":921,"_28139":853,"_19503":48449,"_5":13343,"_25626":48279,"_2668":48450},[],"Label used in service logs.",{"_3173":922,"_28139":853,"_19503":48452,"_5":13343,"_25626":48279,"_2668":48453},[],"`config.auth_mode`",{"_3173":923,"_28139":853,"_19503":48455,"_5":13343,"_25626":48279,"_2668":48456},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3173":924,"_28139":853,"_19503":48458,"_5":13343,"_25626":48279,"_2668":48459},[],"`config.log_level`",{"_3173":925,"_28139":853,"_19503":48461,"_5":13343,"_25626":48279,"_2668":48462},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3173":926,"_28139":853,"_19503":48464,"_5":13343,"_25626":48279,"_2668":48465},[],"`config.apikey_options`",{"_3173":927,"_28139":853,"_19503":48467,"_5":13343,"_25626":48279,"_2668":48468},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3173":928,"_28139":853,"_19503":48470,"_5":13343,"_25626":48279,"_2668":48471},[],"`config.jwt_options`",{"_3173":929,"_28139":853,"_19503":48473,"_5":13343,"_25626":48279,"_2668":48474},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3173":930,"_28139":853,"_19503":48476,"_5":13343,"_25626":48279,"_2668":48477},[],"`config.mtls_options`",{"_3173":931,"_28139":853,"_19503":48479,"_5":13343,"_25626":48279,"_2668":48480},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3173":932,"_28139":853,"_19503":48482,"_5":13343,"_25626":48279,"_2668":48483},[],"`config.insecure_skip_verify`",{"_3173":933,"_28139":853,"_19503":48485,"_5":13343,"_25626":48279,"_2668":48486},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3173":934,"_28139":853,"_19503":48488,"_5":13343,"_25626":48279,"_2668":48489},[],"`config.call_timeout`",{"_3173":935,"_28139":853,"_19503":48491,"_5":13343,"_25626":48279,"_2668":48492},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3173":936,"_28139":853,"_19503":48494,"_5":13343,"_25626":48279,"_2668":48495},[],"Rules for that configuration:",{"_3173":937,"_28139":853,"_19503":48497,"_5":13343,"_25626":48279,"_2668":48498},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3173":938,"_28139":853,"_19503":48500,"_5":13343,"_25626":48279,"_2668":48501},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3173":939,"_28139":853,"_19503":48503,"_5":13343,"_25626":48279,"_2668":48504},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3173":940,"_28139":853,"_19503":48506,"_5":13343,"_25626":48279,"_2668":48507},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3173":941,"_28139":853,"_19503":48509,"_5":13343,"_25626":48279,"_2668":48510},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3173":942,"_28139":853,"_19503":48512,"_5":13343,"_25626":48279,"_2668":48513},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3173":943,"_28139":853,"_19503":48515,"_5":13343,"_25626":48279,"_2668":48516},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3173":944,"_28139":853,"_19503":48518,"_5":13343,"_25626":48279,"_2668":48519},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3173":945,"_28139":853,"_19503":48521,"_5":13343,"_25626":48279,"_2668":48522},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3173":946,"_28139":853,"_19503":48524,"_5":13343,"_25626":48283,"_2668":48525},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3173":947,"_28139":853,"_19503":48527,"_5":13343,"_25626":48287,"_2668":48528},[],"`settings.reenrollment_settings` field",{"_3173":948,"_28139":853,"_19503":48530,"_5":13343,"_25626":48287,"_2668":45962},[],{"_3173":949,"_28139":853,"_19503":48532,"_5":13343,"_25626":48287,"_2668":48533},[],"`reenrollment_delta`",{"_3173":950,"_28139":853,"_19503":48535,"_5":13343,"_25626":48287,"_2668":48536},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3173":951,"_28139":853,"_19503":48538,"_5":13343,"_25626":48287,"_2668":48539},[],"`preventive_delta`",{"_3173":952,"_28139":853,"_19503":48541,"_5":13343,"_25626":48287,"_2668":48542},[],"Preventive operational monitoring threshold.",{"_3173":953,"_28139":853,"_19503":48544,"_5":13343,"_25626":48287,"_2668":48545},[],"`critical_delta`",{"_3173":954,"_28139":853,"_19503":48547,"_5":13343,"_25626":48287,"_2668":48548},[],"Critical operational monitoring threshold.",{"_3173":955,"_28139":853,"_19503":48550,"_5":13343,"_25626":48287,"_2668":48551},[],"`enable_expired_renewal`",{"_3173":956,"_28139":853,"_19503":48553,"_5":13343,"_25626":48287,"_2668":48554},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3173":957,"_28139":853,"_19503":48556,"_5":13343,"_25626":48287,"_2668":48557},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3173":958,"_28139":853,"_19503":48559,"_5":13343,"_25626":48287,"_2668":48560},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3173":959,"_28139":853,"_19503":48562,"_5":13343,"_25626":48287,"_2668":48563},[],"`revoke_on_reenrollment`",{"_3173":960,"_28139":853,"_19503":48565,"_5":13343,"_25626":48287,"_2668":48566},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3173":961,"_28139":853,"_19503":48568,"_5":13343,"_25626":48287,"_2668":48569},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3173":962,"_28139":853,"_19503":48571,"_5":13343,"_25626":48291,"_2668":48572},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3173":963,"_28139":853,"_19503":48574,"_5":13343,"_25626":48295,"_2668":45956},[],{"_3173":964,"_28139":853,"_19503":48576,"_5":13343,"_25626":48295,"_2668":48577},[],"Published material",{"_3173":965,"_28139":853,"_19503":48579,"_5":13343,"_25626":48295,"_2668":48580},[],"**Include Lamassu System CA**",{"_3173":966,"_28139":853,"_19503":48582,"_5":13343,"_25626":48295,"_2668":48583},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3173":967,"_28139":853,"_19503":48585,"_5":13343,"_25626":48295,"_2668":48586},[],"**Include Enrollment CA**",{"_3173":968,"_28139":853,"_19503":48588,"_5":13343,"_25626":48295,"_2668":48589},[],"Selected issuing CA certificate.",{"_3173":969,"_28139":853,"_19503":48591,"_5":13343,"_25626":48295,"_2668":48592},[],"**Managed CAs**",{"_3173":970,"_28139":853,"_19503":48594,"_5":13343,"_25626":48295,"_2668":48595},[],"Explicitly selected CA certificates.",{"_3173":971,"_28139":853,"_19503":48597,"_5":13343,"_25626":48295,"_2668":48598},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3173":972,"_28139":853,"_19503":48600,"_5":13343,"_25626":48299,"_2668":48601},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included.",{"_3173":973,"_28139":853,"_19503":48603,"_5":13343,"_25626":48299,"_2668":48604},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3173":974,"_28139":853,"_19503":48606,"_5":13343,"_25626":48299,"_2668":48607},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3173":975,"_28139":853,"_19503":48609,"_5":13343,"_25626":48303,"_2668":48610},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3173":976,"_28139":976,"_5":13674,"_2668":48612,"_28481":48613,"_19503":48614,"_25626":976},"Integrate the EST client",[45572,46965,47973,47971,48154],[],{"_3173":977,"_28139":976,"_19503":48616,"_5":13343,"_25626":976,"_2668":48617},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3173":978,"_28139":976,"_5":28478,"_19503":48619,"_25626":48620,"_2668":45582},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3173":979,"_28139":976,"_5":28478,"_19503":48622,"_25626":48623,"_2668":48624},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3173":980,"_28139":976,"_5":28478,"_19503":48626,"_25626":48627,"_2668":48628},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3173":981,"_28139":976,"_5":28478,"_19503":48630,"_25626":48631,"_2668":48632},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3173":982,"_28139":976,"_5":28478,"_19503":48634,"_25626":48635,"_2668":48636},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3173":983,"_28139":976,"_5":28478,"_19503":48638,"_25626":48639,"_2668":48640},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3173":984,"_28139":976,"_19503":48642,"_5":13343,"_25626":976,"_2668":48643},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3173":985,"_28139":976,"_19503":48645,"_5":13343,"_25626":48620,"_2668":48646},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3173":986,"_28139":976,"_19503":48648,"_5":13343,"_25626":48620,"_2668":48649},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3173":987,"_28139":976,"_19503":48651,"_5":13343,"_25626":48620,"_2668":48652},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3173":988,"_28139":976,"_19503":48654,"_5":13343,"_25626":48623,"_2668":48655},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3173":989,"_28139":976,"_19503":48657,"_5":13343,"_25626":48623,"_2668":48658},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3173":990,"_28139":976,"_19503":48660,"_5":13343,"_25626":48627,"_2668":48661},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3173":991,"_28139":976,"_19503":48663,"_5":13343,"_25626":48627,"_2668":48664},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3173":992,"_28139":976,"_19503":48666,"_5":13343,"_25626":48631,"_2668":48667},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3173":993,"_28139":976,"_19503":48669,"_5":13343,"_25626":48631,"_2668":48670},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3173":994,"_28139":976,"_19503":48672,"_5":13343,"_25626":48635,"_2668":48673},[],"For a root that issues directly:",{"_3173":995,"_28139":976,"_19503":48675,"_5":13343,"_25626":48635,"_2668":48676},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3173":996,"_28139":976,"_19503":48678,"_5":13343,"_25626":48635,"_2668":48679},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3173":997,"_28139":976,"_19503":48681,"_5":13343,"_25626":48639,"_2668":48682},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3173":998,"_28139":998,"_5":13674,"_2668":48684,"_28481":48685,"_19503":48686,"_25626":998},"EST reference",[45572,46965,47973,47971,48154],[],{"_3173":999,"_28139":998,"_19503":48688,"_5":13343,"_25626":998,"_2668":48689},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3173":1000,"_28139":998,"_5":28478,"_19503":48691,"_25626":48692,"_2668":48693},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3173":1001,"_28139":998,"_5":28478,"_19503":48695,"_25626":48696,"_2668":21188},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3173":1002,"_28139":998,"_5":28478,"_19503":48698,"_25626":48699,"_2668":24307},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3173":1003,"_28139":998,"_5":28478,"_19503":48701,"_25626":48702,"_2668":24314},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3173":1004,"_28139":998,"_5":28478,"_19503":48704,"_25626":48705,"_2668":23659},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3173":1005,"_28139":998,"_5":28478,"_19503":48707,"_25626":48708,"_2668":48709},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3173":1006,"_28139":998,"_5":28478,"_19503":48711,"_25626":48712,"_2668":48713},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3173":1007,"_28139":998,"_5":28478,"_19503":48715,"_25626":48716,"_2668":48717},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3173":1008,"_28139":998,"_19503":48719,"_5":13343,"_25626":998,"_2668":48720},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3173":1009,"_28139":998,"_19503":48722,"_5":13343,"_25626":48692,"_2668":48723},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3173":1010,"_28139":998,"_19503":48725,"_5":13343,"_25626":48692,"_2668":48726},[],"Operation",{"_3173":1011,"_28139":998,"_19503":48728,"_5":13343,"_25626":48692,"_2668":48729},[],"Method",{"_3173":1012,"_28139":998,"_19503":48731,"_5":13343,"_25626":48692,"_2668":48732},[],"Authentication and condition",{"_3173":1013,"_28139":998,"_19503":48734,"_5":13343,"_25626":48692,"_2668":48735},[],"`/cacerts`",{"_3173":1014,"_28139":998,"_19503":48737,"_5":13343,"_25626":48692,"_2668":48738},[],"GET",{"_3173":1015,"_28139":998,"_19503":48740,"_5":13343,"_25626":48692,"_2668":48741},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3173":1016,"_28139":998,"_19503":48743,"_5":13343,"_25626":48692,"_2668":48744},[],"`/simpleenroll`",{"_3173":1017,"_28139":998,"_19503":48746,"_5":13343,"_25626":48692,"_2668":48747},[],"POST",{"_3173":1018,"_28139":998,"_19503":48749,"_5":13343,"_25626":48692,"_2668":48750},[],"Initial authentication and DMS registration/replacement policy.",{"_3173":1019,"_28139":998,"_19503":48752,"_5":13343,"_25626":48692,"_2668":48753},[],"`/simplereenroll`",{"_3173":1020,"_28139":998,"_19503":48755,"_5":13343,"_25626":48692,"_2668":48747},[],{"_3173":1021,"_28139":998,"_19503":48757,"_5":13343,"_25626":48692,"_2668":48758},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3173":1022,"_28139":998,"_19503":48760,"_5":13343,"_25626":48692,"_2668":48761},[],"`/serverkeygen`",{"_3173":1023,"_28139":998,"_19503":48763,"_5":13343,"_25626":48692,"_2668":48747},[],{"_3173":1024,"_28139":998,"_19503":48765,"_5":13343,"_25626":48692,"_2668":48766},[],"Initial authentication and admission; server generation enabled.",{"_3173":1025,"_28139":998,"_19503":48768,"_5":13343,"_25626":48692,"_2668":48769},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3173":1026,"_28139":998,"_19503":48771,"_5":13343,"_25626":48696,"_2668":48772},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3173":1027,"_28139":998,"_19503":48774,"_5":13343,"_25626":48696,"_2668":48775},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3173":1028,"_28139":998,"_19503":48777,"_5":13343,"_25626":48699,"_2668":48778},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3173":1029,"_28139":998,"_19503":48780,"_5":13343,"_25626":48699,"_2668":48781},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3173":1030,"_28139":998,"_19503":48783,"_5":13343,"_25626":48702,"_2668":48784},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3173":1031,"_28139":998,"_19503":48786,"_5":13343,"_25626":48702,"_2668":48787},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3173":1032,"_28139":998,"_19503":48789,"_5":13343,"_25626":48705,"_2668":48790},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3173":1033,"_28139":998,"_19503":48792,"_5":13343,"_25626":48705,"_2668":48793},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3173":1034,"_28139":998,"_19503":48795,"_5":13343,"_25626":48708,"_2668":48796},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3173":1035,"_28139":998,"_19503":48798,"_5":13343,"_25626":48708,"_2668":48799},[],"Part",{"_3173":1036,"_28139":998,"_19503":48801,"_5":13343,"_25626":48708,"_2668":48802},[],"Content after decoding its Base64",{"_3173":1037,"_28139":998,"_19503":48804,"_5":13343,"_25626":48708,"_2668":48805},[],"`application/pkcs8`",{"_3173":1038,"_28139":998,"_19503":48807,"_5":13343,"_25626":48708,"_2668":48808},[],"Unencrypted DER PKCS#8 private key.",{"_3173":1039,"_28139":998,"_19503":48810,"_5":13343,"_25626":48708,"_2668":48811},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3173":1040,"_28139":998,"_19503":48813,"_5":13343,"_25626":48708,"_2668":48814},[],"DER PKCS#7 containing the issued certificate.",{"_3173":1041,"_28139":998,"_19503":48816,"_5":13343,"_25626":48708,"_2668":48817},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3173":1042,"_28139":998,"_19503":48819,"_5":13343,"_25626":48712,"_2668":48820},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3173":1043,"_28139":998,"_19503":48822,"_5":13343,"_25626":48712,"_2668":48823},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3173":1044,"_28139":998,"_19503":48825,"_5":13343,"_25626":48712,"_2668":48826},[],"Convert and check the result:",{"_3173":1045,"_28139":998,"_19503":48828,"_5":13343,"_25626":48712,"_2668":48829},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3173":1046,"_28139":998,"_19503":48831,"_5":13343,"_25626":48716,"_2668":48832},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3173":1047,"_28139":998,"_19503":48834,"_5":13343,"_25626":48716,"_2668":48835},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3173":1048,"_28139":1048,"_5":13674,"_2668":48154,"_28481":48837,"_19503":48838,"_25626":1048},[45572,46965,47973,47971,48154],[],{"_3173":1049,"_28139":1048,"_19503":48840,"_5":13343,"_25626":1048,"_2668":48841},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3173":1050,"_28139":1048,"_5":28478,"_19503":48843,"_25626":48844,"_2668":48845},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3173":1051,"_28139":1048,"_5":28478,"_19503":48847,"_25626":48848,"_2668":48849},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3173":1052,"_28139":1048,"_5":28478,"_19503":48851,"_25626":48852,"_2668":48853},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3173":1053,"_28139":1048,"_5":28478,"_19503":48855,"_25626":48856,"_2668":48857},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3173":1054,"_28139":1048,"_19503":48859,"_5":13343,"_25626":1048,"_2668":48860},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3173":1055,"_28139":1048,"_19503":48862,"_5":13343,"_25626":48844,"_2668":48863},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3173":1056,"_28139":1048,"_19503":48865,"_5":13343,"_25626":48844,"_2668":48866},[],"The integrator installs initial EST server trust and an admission credential.",{"_3173":1057,"_28139":1048,"_19503":48868,"_5":13343,"_25626":48844,"_2668":48869},[],"The client requests an identity for its `Device ID` through EST.",{"_3173":1058,"_28139":1048,"_19503":48871,"_5":13343,"_25626":48844,"_2668":48872},[],"Certificate, device binding and key/certificate installation are checked.",{"_3173":1059,"_28139":1048,"_19503":48874,"_5":13343,"_25626":48844,"_2668":48875},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3173":1060,"_28139":1048,"_19503":48877,"_5":13343,"_25626":48844,"_2668":48878},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3173":1061,"_28139":1048,"_19503":48880,"_5":13343,"_25626":48848,"_2668":48881},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3173":1062,"_28139":1048,"_19503":48883,"_5":13343,"_25626":48848,"_2668":48884},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3173":1063,"_28139":1048,"_19503":48886,"_5":13343,"_25626":48848,"_2668":48887},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3173":1064,"_28139":1048,"_19503":48889,"_5":13343,"_25626":48848,"_2668":48890},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3173":1065,"_28139":1048,"_19503":48892,"_5":13343,"_25626":48852,"_2668":48893},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3173":1066,"_28139":1048,"_19503":48895,"_5":13343,"_25626":48852,"_2668":48896},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3173":1067,"_28139":1048,"_19503":48898,"_5":13343,"_25626":48852,"_2668":48899},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3173":1068,"_28139":1048,"_19503":48901,"_5":13343,"_25626":48852,"_2668":48902},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3173":1069,"_28139":1048,"_19503":48904,"_5":13343,"_25626":48856,"_2668":48905},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3173":1070,"_28139":1048,"_19503":48907,"_5":13343,"_25626":48856,"_2668":48908},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3173":1071,"_28139":1071,"_5":13674,"_2668":48910,"_28481":48911,"_19503":48912,"_25626":1071},"Provisioning strategies",[45572,46965,47973,47971,48154],[],{"_3173":1072,"_28139":1071,"_19503":48914,"_5":13343,"_25626":1071,"_2668":48915},[],"Choose device registration, identity authorization and key generation.",{"_3173":1073,"_28139":1071,"_5":28478,"_19503":48917,"_25626":48918,"_2668":48919},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3173":1074,"_28139":1071,"_5":28478,"_19503":48921,"_25626":48922,"_2668":48923},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3173":1075,"_28139":1071,"_5":28478,"_19503":48925,"_25626":48926,"_2668":48927},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3173":1076,"_28139":1071,"_5":28478,"_19503":48929,"_25626":48930,"_2668":48931},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3173":1077,"_28139":1071,"_5":28478,"_19503":48933,"_25626":48934,"_2668":48935},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3173":1078,"_28139":1071,"_19503":48937,"_5":13343,"_25626":1071,"_2668":48938},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3173":1079,"_28139":1071,"_19503":48940,"_5":13343,"_25626":48918,"_2668":48941},[],"Path",{"_3173":1080,"_28139":1071,"_19503":48943,"_5":13343,"_25626":48918,"_2668":48944},[],"When the device exists",{"_3173":1081,"_28139":1071,"_19503":48946,"_5":13343,"_25626":48918,"_2668":48947},[],"What to check",{"_3173":1082,"_28139":1071,"_19503":48949,"_5":13343,"_25626":48918,"_2668":48950},[],"Manual assignment",{"_3173":1083,"_28139":1071,"_19503":48952,"_5":13343,"_25626":48918,"_2668":48953},[],"An operator creates it before associating a certificate.",{"_3173":1084,"_28139":1071,"_19503":48955,"_5":13343,"_25626":48918,"_2668":48956},[],"ID, owning DMS, certificate CN and bound serial.",{"_3173":1085,"_28139":1071,"_19503":48958,"_5":13343,"_25626":48918,"_2668":48959},[],"EST with `JITP`",{"_3173":1086,"_28139":1071,"_19503":48961,"_5":13343,"_25626":48918,"_2668":48962},[],"Created for an unknown CN during `/simpleenroll`.",{"_3173":1087,"_28139":1071,"_19503":48964,"_5":13343,"_25626":48918,"_2668":48965},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3173":1088,"_28139":1071,"_19503":48967,"_5":13343,"_25626":48918,"_2668":48968},[],"EST with `PRE_REGISTRATION`",{"_3173":1089,"_28139":1071,"_19503":48970,"_5":13343,"_25626":48918,"_2668":48971},[],"Must exist before `/simpleenroll`.",{"_3173":1090,"_28139":1071,"_19503":48973,"_5":13343,"_25626":48918,"_2668":48974},[],"Approved record, same DMS and replacement conditions for your version.",{"_3173":1091,"_28139":1071,"_19503":48976,"_5":13343,"_25626":48918,"_2668":48977},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3173":1092,"_28139":1071,"_19503":48979,"_5":13343,"_25626":48918,"_2668":48980},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3173":1093,"_28139":1071,"_19503":48982,"_5":13343,"_25626":48922,"_2668":48983},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3173":1094,"_28139":1071,"_19503":48985,"_5":13343,"_25626":48922,"_2668":48986},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3173":1095,"_28139":1071,"_19503":48988,"_5":13343,"_25626":48922,"_2668":48989},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3173":1096,"_28139":1071,"_19503":48991,"_5":13343,"_25626":48926,"_2668":48992},[],"Decide initial enrollment and re-enrollment separately:",{"_3173":1097,"_28139":1071,"_19503":48994,"_5":13343,"_25626":48926,"_2668":48995},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3173":1098,"_28139":1071,"_19503":48997,"_5":13343,"_25626":48926,"_2668":48998},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3173":1099,"_28139":1071,"_19503":49000,"_5":13343,"_25626":48926,"_2668":49001},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3173":1100,"_28139":1071,"_19503":49003,"_5":13343,"_25626":48926,"_2668":49004},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3173":1101,"_28139":1071,"_19503":49006,"_5":13343,"_25626":48926,"_2668":49007},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3173":1102,"_28139":1071,"_19503":49009,"_5":13343,"_25626":48930,"_2668":45956},[],{"_3173":1103,"_28139":1071,"_19503":49011,"_5":13343,"_25626":48930,"_2668":49012},[],"Material crossing EST",{"_3173":1104,"_28139":1071,"_19503":49014,"_5":13343,"_25626":48930,"_2668":49015},[],"Device-generated key",{"_3173":1105,"_28139":1071,"_19503":49017,"_5":13343,"_25626":48930,"_2668":49018},[],"Public CSR and certificate; the key stays on the client.",{"_3173":1106,"_28139":1071,"_19503":49020,"_5":13343,"_25626":48930,"_2668":49021},[],"Existing device key",{"_3173":1107,"_28139":1071,"_19503":49023,"_5":13343,"_25626":48930,"_2668":49024},[],"CSR signed with that key and a new certificate.",{"_3173":1108,"_28139":1071,"_19503":49026,"_5":13343,"_25626":48930,"_2668":48292},[],{"_3173":1109,"_28139":1071,"_19503":49028,"_5":13343,"_25626":48930,"_2668":49029},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3173":1110,"_28139":1071,"_19503":49031,"_5":13343,"_25626":48930,"_2668":49032},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3173":1111,"_28139":1071,"_19503":49034,"_5":13343,"_25626":48934,"_2668":49035},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3173":1112,"_28139":1112,"_5":13674,"_2668":49037,"_28481":49038,"_19503":49039,"_25626":1112},"Renewal and recovery",[45572,46965,47973,47971,48154],[],{"_3173":1113,"_28139":1112,"_19503":49041,"_5":13343,"_25626":1112,"_2668":49042},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3173":1114,"_28139":1112,"_5":28478,"_19503":49044,"_25626":49045,"_2668":49046},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3173":1115,"_28139":1112,"_5":28478,"_19503":49048,"_25626":49049,"_2668":49050},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3173":1116,"_28139":1112,"_5":28478,"_19503":49052,"_25626":49053,"_2668":49054},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3173":1117,"_28139":1112,"_5":28478,"_19503":49056,"_25626":49057,"_2668":49058},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3173":1118,"_28139":1112,"_5":28478,"_19503":49060,"_25626":49061,"_2668":49062},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3173":1119,"_28139":1112,"_19503":49064,"_5":13343,"_25626":1112,"_2668":49065},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3173":1120,"_28139":1112,"_19503":49067,"_5":13343,"_25626":49045,"_2668":49068},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3173":1121,"_28139":1112,"_19503":49070,"_5":13343,"_25626":49045,"_2668":49071},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3173":1122,"_28139":1112,"_19503":49073,"_5":13343,"_25626":49045,"_2668":49074},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3173":1123,"_28139":1112,"_19503":49076,"_5":13343,"_25626":49045,"_2668":49077},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3173":1124,"_28139":1112,"_19503":49079,"_5":13343,"_25626":49049,"_2668":49080},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3173":1125,"_28139":1112,"_19503":49082,"_5":13343,"_25626":49049,"_2668":49083},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3173":1126,"_28139":1112,"_19503":49085,"_5":13343,"_25626":49053,"_2668":49086},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3173":1127,"_28139":1112,"_19503":49088,"_5":13343,"_25626":49053,"_2668":49089},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3173":1128,"_28139":1112,"_19503":49091,"_5":13343,"_25626":49053,"_2668":49092},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3173":1129,"_28139":1112,"_19503":49094,"_5":13343,"_25626":49057,"_2668":49095},[],"Situation",{"_3173":1130,"_28139":1112,"_19503":49097,"_5":13343,"_25626":49057,"_2668":49098},[],"Procedure",{"_3173":1131,"_28139":1112,"_19503":49100,"_5":13343,"_25626":49057,"_2668":49101},[],"Valid certificate, outside the window",{"_3173":1132,"_28139":1112,"_19503":49103,"_5":13343,"_25626":49057,"_2668":49104},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3173":1133,"_28139":1112,"_19503":49106,"_5":13343,"_25626":49057,"_2668":49107},[],"Expired certificate, key available",{"_3173":1134,"_28139":1112,"_19503":49109,"_5":13343,"_25626":49057,"_2668":49110},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3173":1135,"_28139":1112,"_19503":49112,"_5":13343,"_25626":49057,"_2668":49113},[],"Renewal through webhook or `NO_AUTH`",{"_3173":1136,"_28139":1112,"_19503":49115,"_5":13343,"_25626":49057,"_2668":49116},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3173":1137,"_28139":1112,"_19503":49118,"_5":13343,"_25626":49057,"_2668":49119},[],"Lost or inaccessible key",{"_3173":1138,"_28139":1112,"_19503":49121,"_5":13343,"_25626":49057,"_2668":49122},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3173":1139,"_28139":1112,"_19503":49124,"_5":13343,"_25626":49057,"_2668":49125},[],"Current identity revoked",{"_3173":1140,"_28139":1112,"_19503":49127,"_5":13343,"_25626":49057,"_2668":49128},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3173":1141,"_28139":1112,"_19503":49130,"_5":13343,"_25626":49057,"_2668":49131},[],"Device without an identity",{"_3173":1142,"_28139":1112,"_19503":49133,"_5":13343,"_25626":49057,"_2668":49134},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3173":1143,"_28139":1112,"_19503":49136,"_5":13343,"_25626":49057,"_2668":49137},[],"Retired device",{"_3173":1144,"_28139":1112,"_19503":49139,"_5":13343,"_25626":49057,"_2668":49140},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3173":1145,"_28139":1112,"_19503":49142,"_5":13343,"_25626":49057,"_2668":49143},[],"Timeout, HTTP 500 or installation failure",{"_3173":1146,"_28139":1112,"_19503":49145,"_5":13343,"_25626":49057,"_2668":49146},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3173":1147,"_28139":1112,"_19503":49148,"_5":13343,"_25626":49061,"_2668":49149},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3173":1148,"_28139":1112,"_19503":49151,"_5":13343,"_25626":49061,"_2668":49152},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3173":1149,"_28139":1149,"_5":13674,"_2668":49154,"_28481":49155,"_19503":49156,"_25626":1149},"Enrollment troubleshooting",[45572,46965,47973,47971,48154],[],{"_3173":1150,"_28139":1149,"_19503":49158,"_5":13343,"_25626":1149,"_2668":49159},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3173":1151,"_28139":1149,"_5":28478,"_19503":49161,"_25626":49162,"_2668":49163},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3173":1152,"_28139":1149,"_5":28478,"_19503":49165,"_25626":49166,"_2668":49167},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3173":1153,"_28139":1149,"_5":28478,"_19503":49169,"_25626":49170,"_2668":48717},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3173":1154,"_28139":1149,"_5":28478,"_19503":49172,"_25626":49173,"_2668":49174},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3173":1155,"_28139":1149,"_19503":49176,"_5":13343,"_25626":1149,"_2668":49177},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3173":1156,"_28139":1149,"_19503":49179,"_5":13343,"_25626":49166,"_2668":49180},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3173":1157,"_28139":1149,"_19503":49182,"_5":13343,"_25626":49166,"_2668":49183},[],"Symptom or message",{"_3173":1158,"_28139":1149,"_19503":49185,"_5":13343,"_25626":49166,"_2668":48947},[],{"_3173":1159,"_28139":1149,"_19503":49187,"_5":13343,"_25626":49166,"_2668":49188},[],"curl rejects TLS, name or issuer",{"_3173":1160,"_28139":1149,"_19503":49190,"_5":13343,"_25626":49166,"_2668":49191},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3173":1161,"_28139":1149,"_19503":49193,"_5":13343,"_25626":49166,"_2668":49194},[],"404 or missing APS",{"_3173":1162,"_28139":1149,"_19503":49196,"_5":13343,"_25626":49166,"_2668":49197},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3173":1163,"_28139":1149,"_19503":49199,"_5":13343,"_25626":49166,"_2668":49200},[],"400, CSR or format error",{"_3173":1164,"_28139":1149,"_19503":49202,"_5":13343,"_25626":49166,"_2668":49203},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3173":1165,"_28139":1149,"_19503":49205,"_5":13343,"_25626":49166,"_2668":49206},[],"Missing credential or invalid certificate",{"_3173":1166,"_28139":1149,"_19503":49208,"_5":13343,"_25626":49166,"_2668":49209},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3173":1167,"_28139":1149,"_19503":49211,"_5":13343,"_25626":49166,"_2668":49212},[],"Webhook denies, times out or responds without authorization",{"_3173":1168,"_28139":1149,"_19503":49214,"_5":13343,"_25626":49166,"_2668":49215},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3173":1169,"_28139":1149,"_19503":49217,"_5":13343,"_25626":49166,"_2668":49218},[],"`unexpected status code: <n>: redirects are not followed`",{"_3173":1170,"_28139":1149,"_19503":49220,"_5":13343,"_25626":49166,"_2668":49221},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3173":1171,"_28139":1149,"_19503":49223,"_5":13343,"_25626":49166,"_2668":49224},[],"`webhook response exceeds 1048576 bytes`",{"_3173":1172,"_28139":1149,"_19503":49226,"_5":13343,"_25626":49166,"_2668":49227},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3173":1173,"_28139":1149,"_19503":49229,"_5":13343,"_25626":49166,"_2668":49230},[],"`webhook config must not reference files`",{"_3173":1174,"_28139":1149,"_19503":49232,"_5":13343,"_25626":49166,"_2668":49233},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3173":1175,"_28139":1149,"_19503":49235,"_5":13343,"_25626":49166,"_2668":49236},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3173":1176,"_28139":1149,"_19503":49238,"_5":13343,"_25626":49166,"_2668":49239},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3173":1177,"_28139":1149,"_19503":49241,"_5":13343,"_25626":49166,"_2668":49242},[],"`webhook mTLS certificate and key are invalid: …`",{"_3173":1178,"_28139":1149,"_19503":49244,"_5":13343,"_25626":49166,"_2668":49245},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3173":1179,"_28139":1149,"_19503":49247,"_5":13343,"_25626":49166,"_2668":49248},[],"400 `struct validation error` creating or updating a DMS",{"_3173":1180,"_28139":1149,"_19503":49250,"_5":13343,"_25626":49166,"_2668":49251},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3173":1181,"_28139":1149,"_19503":49253,"_5":13343,"_25626":49166,"_2668":49254},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3173":1182,"_28139":1149,"_19503":49256,"_5":13343,"_25626":49166,"_2668":49257},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3173":1183,"_28139":1149,"_19503":49259,"_5":13343,"_25626":49166,"_2668":49260},[],"`device not preregistered`",{"_3173":1184,"_28139":1149,"_19503":49262,"_5":13343,"_25626":49166,"_2668":49263},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3173":1185,"_28139":1149,"_19503":49265,"_5":13343,"_25626":49166,"_2668":49266},[],"`forbiddenNewEnrollment`",{"_3173":1186,"_28139":1149,"_19503":49268,"_5":13343,"_25626":49166,"_2668":49269},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3173":1187,"_28139":1149,"_19503":49271,"_5":13343,"_25626":49166,"_2668":49272},[],"Different owning DMS",{"_3173":1188,"_28139":1149,"_19503":49274,"_5":13343,"_25626":49166,"_2668":49275},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3173":1189,"_28139":1149,"_19503":49277,"_5":13343,"_25626":49166,"_2668":49278},[],"`invalid RawSubject bytes`",{"_3173":1190,"_28139":1149,"_19503":49280,"_5":13343,"_25626":49166,"_2668":49281},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3173":1191,"_28139":1149,"_19503":49283,"_5":13343,"_25626":49166,"_2668":49284},[],"`invalid reenroll window`",{"_3173":1192,"_28139":1149,"_19503":49286,"_5":13343,"_25626":49166,"_2668":49287},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3173":1193,"_28139":1149,"_19503":49289,"_5":13343,"_25626":49166,"_2668":49290},[],"Current certificate revoked",{"_3173":1194,"_28139":1149,"_19503":49292,"_5":13343,"_25626":49166,"_2668":49293},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3173":1195,"_28139":1149,"_19503":49295,"_5":13343,"_25626":49166,"_2668":49296},[],"CA, profile or signing error",{"_3173":1196,"_28139":1149,"_19503":49298,"_5":13343,"_25626":49166,"_2668":49299},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3173":1197,"_28139":1149,"_19503":49301,"_5":13343,"_25626":49166,"_2668":49302},[],"HTTP 200 without a device connection",{"_3173":1198,"_28139":1149,"_19503":49304,"_5":13343,"_25626":49166,"_2668":49305},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3173":1199,"_28139":1149,"_19503":49307,"_5":13343,"_25626":49166,"_2668":49308},[],"Timeout or error after issuance",{"_3173":1200,"_28139":1149,"_19503":49310,"_5":13343,"_25626":49166,"_2668":49311},[],"New certificates, current slot and previous identity's state before retrying.",{"_3173":1201,"_28139":1149,"_19503":49313,"_5":13343,"_25626":49170,"_2668":49314},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3173":1202,"_28139":1149,"_19503":49316,"_5":13343,"_25626":49170,"_2668":49317},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3173":1203,"_28139":1149,"_19503":49319,"_5":13343,"_25626":49173,"_2668":49320},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3173":1204,"_28139":1149,"_19503":49322,"_5":13343,"_25626":49173,"_2668":49323},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3173":1205,"_28139":1149,"_19503":49325,"_5":13343,"_25626":49173,"_2668":49326},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3173":1206,"_28139":1149,"_19503":49328,"_5":13343,"_25626":49173,"_2668":49329},[],"Make one request, save headers/body and query the device and certificates.",{"_3173":1207,"_28139":1149,"_19503":49331,"_5":13343,"_25626":49173,"_2668":49332},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3173":1208,"_28139":1149,"_19503":49334,"_5":13343,"_25626":49173,"_2668":49335},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3173":1209,"_28139":1149,"_19503":49337,"_5":13343,"_25626":49173,"_2668":49338},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3173":1210,"_28139":1210,"_5":13674,"_2668":49340,"_28481":49341,"_19503":49342,"_25626":1210},"Trust distribution and updates",[45572,46965,47973,47971,48154],[],{"_3173":1211,"_28139":1210,"_19503":49344,"_5":13343,"_25626":1210,"_2668":49345},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3173":1212,"_28139":1210,"_5":28478,"_19503":49347,"_25626":49348,"_2668":49349},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3173":1213,"_28139":1210,"_5":28478,"_19503":49351,"_25626":49352,"_2668":49353},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3173":1214,"_28139":1210,"_5":28478,"_19503":49355,"_25626":49356,"_2668":49357},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3173":1215,"_28139":1210,"_5":28478,"_19503":49359,"_25626":49360,"_2668":49361},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3173":1216,"_28139":1210,"_5":28478,"_19503":49363,"_25626":49364,"_2668":49365},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3173":1217,"_28139":1210,"_19503":49367,"_5":13343,"_25626":1210,"_2668":49368},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3173":1218,"_28139":1210,"_19503":49370,"_5":13343,"_25626":49348,"_2668":49371},[],"Relationship",{"_3173":1219,"_28139":1210,"_19503":49373,"_5":13343,"_25626":49348,"_2668":49374},[],"Material prepared by its owner",{"_3173":1220,"_28139":1210,"_19503":49376,"_5":13343,"_25626":49348,"_2668":49377},[],"Device → EST server",{"_3173":1221,"_28139":1210,"_19503":49379,"_5":13343,"_25626":49348,"_2668":49380},[],"Previously verified server root, chain or pin and TLS name.",{"_3173":1222,"_28139":1210,"_19503":49382,"_5":13343,"_25626":49348,"_2668":49383},[],"DMS → requester",{"_3173":1223,"_28139":1210,"_19503":49385,"_5":13343,"_25626":49348,"_2668":49386},[],"CAs and rules authorizing initial or renewal credentials.",{"_3173":1224,"_28139":1210,"_19503":49388,"_5":13343,"_25626":49348,"_2668":49389},[],"Consumer → device",{"_3173":1225,"_28139":1210,"_19503":49391,"_5":13343,"_25626":49348,"_2668":49392},[],"Operational identity roots, intermediates, validation and permissions.",{"_3173":1226,"_28139":1210,"_19503":49394,"_5":13343,"_25626":49348,"_2668":49395},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3173":1227,"_28139":1210,"_19503":49397,"_5":13343,"_25626":49352,"_2668":49398},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3173":1228,"_28139":1210,"_19503":49400,"_5":13343,"_25626":49352,"_2668":49401},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3173":1229,"_28139":1210,"_19503":49403,"_5":13343,"_25626":49356,"_2668":49404},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3173":1230,"_28139":1210,"_19503":49406,"_5":13343,"_25626":49356,"_2668":49407},[],"Select policy-approved roots as anchors.",{"_3173":1231,"_28139":1210,"_19503":49409,"_5":13343,"_25626":49356,"_2668":49410},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3173":1232,"_28139":1210,"_19503":49412,"_5":13343,"_25626":49356,"_2668":49413},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3173":1233,"_28139":1210,"_19503":49415,"_5":13343,"_25626":49356,"_2668":49416},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3173":1234,"_28139":1210,"_19503":49418,"_5":13343,"_25626":49356,"_2668":49419},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3173":1235,"_28139":1210,"_19503":49421,"_5":13343,"_25626":49360,"_2668":49422},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3173":1236,"_28139":1210,"_19503":49424,"_5":13343,"_25626":49360,"_2668":49425},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3173":1237,"_28139":1210,"_19503":49427,"_5":13343,"_25626":49360,"_2668":49428},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3173":1238,"_28139":1210,"_19503":49430,"_5":13343,"_25626":49364,"_2668":49431},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3173":1239,"_28139":1239,"_5":13674,"_2668":49433,"_28481":49434,"_19503":49436,"_25626":1239},"AWS IoT Core",[45572,46965,47973,47971,49435],"Integrations",[],{"_3173":1240,"_28139":1239,"_19503":49438,"_5":13343,"_25626":1239,"_2668":49439},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3173":1241,"_28139":1239,"_5":28478,"_19503":49441,"_25626":49442,"_2668":49443},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3173":1242,"_28139":1239,"_5":28478,"_19503":49445,"_25626":49446,"_2668":49447},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3173":1243,"_28139":1239,"_5":28478,"_19503":49449,"_25626":49450,"_2668":49451},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3173":1244,"_28139":1239,"_5":28478,"_19503":49453,"_25626":49454,"_2668":49455},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3173":1245,"_28139":1239,"_5":28478,"_19503":49457,"_25626":49458,"_2668":49459},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3173":1246,"_28139":1239,"_5":28478,"_19503":49461,"_25626":49462,"_2668":49463},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3173":1247,"_28139":1239,"_5":28478,"_19503":49465,"_25626":49466,"_2668":49467},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3173":1248,"_28139":1239,"_5":28478,"_19503":49469,"_25626":49470,"_2668":49471},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3173":1249,"_28139":1239,"_5":28478,"_19503":49473,"_25626":49474,"_2668":49475},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3173":1250,"_28139":1239,"_5":28478,"_19503":49477,"_25626":49478,"_2668":49479},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3173":1251,"_28139":1239,"_5":28478,"_19503":49481,"_25626":49482,"_2668":49483},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3173":1252,"_28139":1239,"_5":28478,"_19503":49485,"_25626":49486,"_2668":49487},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3173":1253,"_28139":1239,"_5":28478,"_19503":49489,"_25626":49490,"_2668":49491},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3173":1254,"_28139":1239,"_5":28478,"_19503":49493,"_25626":49494,"_2668":49495},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3173":1255,"_28139":1239,"_5":28478,"_19503":49497,"_25626":49498,"_2668":49499},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3173":1256,"_28139":1239,"_5":28478,"_19503":49501,"_25626":49502,"_2668":49503},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3173":1257,"_28139":1239,"_5":28478,"_19503":49505,"_25626":49506,"_2668":49507},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3173":1258,"_28139":1239,"_5":28478,"_19503":49509,"_25626":49510,"_2668":49511},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3173":1259,"_28139":1239,"_5":28478,"_19503":49513,"_25626":49514,"_2668":49515},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3173":1260,"_28139":1239,"_5":28478,"_19503":49517,"_25626":49518,"_2668":49519},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3173":1261,"_28139":1239,"_19503":49521,"_5":13343,"_25626":1239,"_2668":49522},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3173":1262,"_28139":1239,"_19503":49524,"_5":13343,"_25626":1239,"_2668":49525},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3173":1263,"_28139":1239,"_19503":49527,"_5":13343,"_25626":1239,"_2668":49528},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3173":1264,"_28139":1239,"_19503":49530,"_5":13343,"_25626":49442,"_2668":49531},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3173":1265,"_28139":1239,"_19503":49533,"_5":13343,"_25626":49442,"_2668":49534},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3173":1266,"_28139":1239,"_19503":49536,"_5":13343,"_25626":49442,"_2668":49537},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3173":1267,"_28139":1239,"_19503":49539,"_5":13343,"_25626":49442,"_2668":49540},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3173":1268,"_28139":1239,"_19503":49542,"_5":13343,"_25626":49446,"_2668":49543},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3173":1269,"_28139":1239,"_19503":49545,"_5":13343,"_25626":49450,"_2668":49546},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3173":1270,"_28139":1239,"_19503":49548,"_5":13343,"_25626":49450,"_2668":49549},[],"IAM action",{"_3173":1271,"_28139":1239,"_19503":49551,"_5":13343,"_25626":49450,"_2668":45962},[],{"_3173":1272,"_28139":1239,"_19503":49553,"_5":13343,"_25626":49450,"_2668":49554},[],"`iot:GetRegistrationCode`",{"_3173":1273,"_28139":1239,"_19503":49556,"_5":13343,"_25626":49450,"_2668":49557},[],"Obtain the verification code for CA registration in the Primary Account",{"_3173":1274,"_28139":1239,"_19503":49559,"_5":13343,"_25626":49450,"_2668":49560},[],"`iot:RegisterCACertificate`",{"_3173":1275,"_28139":1239,"_19503":49562,"_5":13343,"_25626":49450,"_2668":49563},[],"Register the CA in AWS IoT",{"_3173":1276,"_28139":1239,"_19503":49565,"_5":13343,"_25626":49450,"_2668":49566},[],"`iot:DescribeCACertificate`",{"_3173":1277,"_28139":1239,"_19503":49568,"_5":13343,"_25626":49450,"_2668":49569},[],"Check the CA registration status",{"_3173":1278,"_28139":1239,"_19503":49571,"_5":13343,"_25626":49450,"_2668":49572},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3173":1279,"_28139":1239,"_19503":49574,"_5":13343,"_25626":49450,"_2668":49575},[],"Create or update Things in IoT Core",{"_3173":1280,"_28139":1239,"_19503":49577,"_5":13343,"_25626":49450,"_2668":49578},[],"`iot:RegisterThing`",{"_3173":1281,"_28139":1239,"_19503":49580,"_5":13343,"_25626":49450,"_2668":49581},[],"Provision Things through a template",{"_3173":1282,"_28139":1239,"_19503":49583,"_5":13343,"_25626":49450,"_2668":49584},[],"`iot:RegisterCertificate`",{"_3173":1283,"_28139":1239,"_19503":49586,"_5":13343,"_25626":49450,"_2668":49587},[],"Register device certificates",{"_3173":1284,"_28139":1239,"_19503":49589,"_5":13343,"_25626":49450,"_2668":49590},[],"`iot:UpdateCertificate`",{"_3173":1285,"_28139":1239,"_19503":49592,"_5":13343,"_25626":49450,"_2668":49593},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3173":1286,"_28139":1239,"_19503":49595,"_5":13343,"_25626":49450,"_2668":49596},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3173":1287,"_28139":1239,"_19503":49598,"_5":13343,"_25626":49450,"_2668":49599},[],"Create and attach IoT policies",{"_3173":1288,"_28139":1239,"_19503":49601,"_5":13343,"_25626":49450,"_2668":49602},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3173":1289,"_28139":1239,"_19503":49604,"_5":13343,"_25626":49450,"_2668":49605},[],"Manage Thing groups",{"_3173":1290,"_28139":1239,"_19503":49607,"_5":13343,"_25626":49450,"_2668":49608},[],"`iot:CreateProvisioningTemplate`",{"_3173":1291,"_28139":1239,"_19503":49610,"_5":13343,"_25626":49450,"_2668":49611},[],"Create JITP templates",{"_3173":1292,"_28139":1239,"_19503":49613,"_5":13343,"_25626":49450,"_2668":49614},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3173":1293,"_28139":1239,"_19503":49616,"_5":13343,"_25626":49450,"_2668":49617},[],"Read and write the Device Shadow",{"_3173":1294,"_28139":1239,"_19503":49619,"_5":13343,"_25626":49450,"_2668":49620},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3173":1295,"_28139":1239,"_19503":49622,"_5":13343,"_25626":49454,"_2668":49623},[],"Parameter",{"_3173":1296,"_28139":1239,"_19503":49625,"_5":13343,"_25626":49454,"_2668":49626},[],"Type",{"_3173":1297,"_28139":1239,"_19503":49628,"_5":13343,"_25626":49454,"_2668":49629},[],"Required",{"_3173":1298,"_28139":1239,"_19503":49631,"_5":13343,"_25626":49454,"_2668":49632},[],"Description",{"_3173":1299,"_28139":1239,"_19503":49634,"_5":13343,"_25626":49454,"_2668":49635},[],"`connector_id`",{"_3173":1300,"_28139":1239,"_19503":49637,"_5":13343,"_25626":49454,"_2668":23326},[],{"_3173":1301,"_28139":1239,"_19503":49639,"_5":13343,"_25626":49454,"_2668":49640},[],"Yes",{"_3173":1302,"_28139":1239,"_19503":49642,"_5":13343,"_25626":49454,"_2668":49643},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3173":1303,"_28139":1239,"_19503":49645,"_5":13343,"_25626":49454,"_2668":49646},[],"`aws_config.region`",{"_3173":1304,"_28139":1239,"_19503":49648,"_5":13343,"_25626":49454,"_2668":23326},[],{"_3173":1305,"_28139":1239,"_19503":49650,"_5":13343,"_25626":49454,"_2668":49640},[],{"_3173":1306,"_28139":1239,"_19503":49652,"_5":13343,"_25626":49454,"_2668":49653},[],"AWS region where the connector operates.",{"_3173":1307,"_28139":1239,"_19503":49655,"_5":13343,"_25626":49454,"_2668":49656},[],"`aws_config.auth_method`",{"_3173":1308,"_28139":1239,"_19503":49658,"_5":13343,"_25626":49454,"_2668":23326},[],{"_3173":1309,"_28139":1239,"_19503":49660,"_5":13343,"_25626":49454,"_2668":49640},[],{"_3173":1310,"_28139":1239,"_19503":49662,"_5":13343,"_25626":49454,"_2668":49663},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3173":1311,"_28139":1239,"_19503":49665,"_5":13343,"_25626":49454,"_2668":49666},[],"`aws_config.access_key_id`",{"_3173":1312,"_28139":1239,"_19503":49668,"_5":13343,"_25626":49454,"_2668":23326},[],{"_3173":1313,"_28139":1239,"_19503":49670,"_5":13343,"_25626":49454,"_2668":49671},[],"Only with `auth_method=static`",{"_3173":1314,"_28139":1239,"_19503":49673,"_5":13343,"_25626":49454,"_2668":49674},[],"AWS access key.",{"_3173":1315,"_28139":1239,"_19503":49676,"_5":13343,"_25626":49454,"_2668":49677},[],"`aws_config.secret_access_key`",{"_3173":1316,"_28139":1239,"_19503":49679,"_5":13343,"_25626":49454,"_2668":23326},[],{"_3173":1317,"_28139":1239,"_19503":49681,"_5":13343,"_25626":49454,"_2668":49671},[],{"_3173":1318,"_28139":1239,"_19503":49683,"_5":13343,"_25626":49454,"_2668":49684},[],"AWS secret key.",{"_3173":1319,"_28139":1239,"_19503":49686,"_5":13343,"_25626":49454,"_2668":49687},[],"`aws_config.session_token`",{"_3173":1320,"_28139":1239,"_19503":49689,"_5":13343,"_25626":49454,"_2668":23326},[],{"_3173":1321,"_28139":1239,"_19503":49691,"_5":13343,"_25626":49454,"_2668":49692},[],"No",{"_3173":1322,"_28139":1239,"_19503":49694,"_5":13343,"_25626":49454,"_2668":49695},[],"Session token (with `auth_method=static`).",{"_3173":1323,"_28139":1239,"_19503":49697,"_5":13343,"_25626":49454,"_2668":49698},[],"`aws_config.role_arn`",{"_3173":1324,"_28139":1239,"_19503":49700,"_5":13343,"_25626":49454,"_2668":23326},[],{"_3173":1325,"_28139":1239,"_19503":49702,"_5":13343,"_25626":49454,"_2668":49703},[],"Only with `auth_method=role`",{"_3173":1326,"_28139":1239,"_19503":49705,"_5":13343,"_25626":49454,"_2668":49706},[],"ARN of the role to assume.",{"_3173":1327,"_28139":1239,"_19503":49708,"_5":13343,"_25626":49454,"_2668":49709},[],"`aws_config.endpoint_url`",{"_3173":1328,"_28139":1239,"_19503":49711,"_5":13343,"_25626":49454,"_2668":23326},[],{"_3173":1329,"_28139":1239,"_19503":49713,"_5":13343,"_25626":49454,"_2668":49692},[],{"_3173":1330,"_28139":1239,"_19503":49715,"_5":13343,"_25626":49454,"_2668":49716},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3173":1331,"_28139":1239,"_19503":49718,"_5":13343,"_25626":49454,"_2668":49719},[],"`subscriber_event_bus`",{"_3173":1332,"_28139":1239,"_19503":49721,"_5":13343,"_25626":49454,"_2668":16390},[],{"_3173":1333,"_28139":1239,"_19503":49723,"_5":13343,"_25626":49454,"_2668":49640},[],{"_3173":1334,"_28139":1239,"_19503":49725,"_5":13343,"_25626":49454,"_2668":49726},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3173":1335,"_28139":1239,"_19503":49728,"_5":13343,"_25626":49454,"_2668":49729},[],"`dms_manager_client`",{"_3173":1336,"_28139":1239,"_19503":49731,"_5":13343,"_25626":49454,"_2668":23326},[],{"_3173":1337,"_28139":1239,"_19503":49733,"_5":13343,"_25626":49454,"_2668":49640},[],{"_3173":1338,"_28139":1239,"_19503":49735,"_5":13343,"_25626":49454,"_2668":49736},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3173":1339,"_28139":1239,"_19503":49738,"_5":13343,"_25626":49454,"_2668":49739},[],"`device_manager_client`",{"_3173":1340,"_28139":1239,"_19503":49741,"_5":13343,"_25626":49454,"_2668":23326},[],{"_3173":1341,"_28139":1239,"_19503":49743,"_5":13343,"_25626":49454,"_2668":49640},[],{"_3173":1342,"_28139":1239,"_19503":49745,"_5":13343,"_25626":49454,"_2668":49746},[],"HTTP URL of Lamassu's Device Manager.",{"_3173":1343,"_28139":1239,"_19503":49748,"_5":13343,"_25626":49454,"_2668":49749},[],"`ca_client`",{"_3173":1344,"_28139":1239,"_19503":49751,"_5":13343,"_25626":49454,"_2668":23326},[],{"_3173":1345,"_28139":1239,"_19503":49753,"_5":13343,"_25626":49454,"_2668":49640},[],{"_3173":1346,"_28139":1239,"_19503":49755,"_5":13343,"_25626":49454,"_2668":49756},[],"HTTP URL of Lamassu's CA service.",{"_3173":1347,"_28139":1239,"_19503":49758,"_5":13343,"_25626":49458,"_2668":49759},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3173":1348,"_28139":1239,"_19503":49761,"_5":13343,"_25626":49462,"_2668":49762},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3173":1349,"_28139":1239,"_19503":49764,"_5":13343,"_25626":49462,"_2668":49765},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3173":1350,"_28139":1239,"_19503":49767,"_5":13343,"_25626":49466,"_2668":49768},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3173":1351,"_28139":1239,"_19503":49770,"_5":13343,"_25626":49466,"_2668":49771},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3173":1352,"_28139":1239,"_19503":49773,"_5":13343,"_25626":49466,"_2668":49774},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3173":1353,"_28139":1239,"_19503":49776,"_5":13343,"_25626":49466,"_2668":49777},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3173":1354,"_28139":1239,"_19503":49779,"_5":13343,"_25626":49466,"_2668":49780},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3173":1355,"_28139":1239,"_19503":49782,"_5":13343,"_25626":49466,"_2668":49783},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3173":1356,"_28139":1239,"_19503":49785,"_5":13343,"_25626":49470,"_2668":49786},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3173":1357,"_28139":1239,"_19503":49788,"_5":13343,"_25626":49474,"_2668":49789},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3173":1358,"_28139":1239,"_19503":49791,"_5":13343,"_25626":49474,"_2668":49792},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3173":1359,"_28139":1239,"_19503":49794,"_5":13343,"_25626":49478,"_2668":49795},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3173":1360,"_28139":1239,"_19503":49797,"_5":13343,"_25626":49482,"_2668":49798},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3173":1361,"_28139":1239,"_19503":49800,"_5":13343,"_25626":49482,"_2668":49801},[],"Creates or updates the IoT policies configured in the DMS.",{"_3173":1362,"_28139":1239,"_19503":49803,"_5":13343,"_25626":49482,"_2668":49804},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3173":1363,"_28139":1239,"_19503":49806,"_5":13343,"_25626":49482,"_2668":49807},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3173":1364,"_28139":1239,"_19503":49809,"_5":13343,"_25626":49482,"_2668":49810},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3173":1365,"_28139":1239,"_19503":49812,"_5":13343,"_25626":49482,"_2668":49813},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3173":1366,"_28139":1239,"_19503":49815,"_5":13343,"_25626":49482,"_2668":49816},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3173":1367,"_28139":1239,"_19503":49818,"_5":13343,"_25626":49486,"_2668":49819},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3173":1368,"_28139":1239,"_19503":49821,"_5":13343,"_25626":49486,"_2668":49822},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3173":1369,"_28139":1239,"_19503":49824,"_5":13343,"_25626":49486,"_2668":49825},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3173":1370,"_28139":1239,"_19503":49827,"_5":13343,"_25626":49490,"_2668":49828},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3173":1371,"_28139":1239,"_19503":49830,"_5":13343,"_25626":49490,"_2668":49831},[],"The full flow from the device's perspective is:",{"_3173":1372,"_28139":1239,"_19503":49833,"_5":13343,"_25626":49490,"_2668":49834},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3173":1373,"_28139":1239,"_19503":49836,"_5":13343,"_25626":49494,"_2668":49837},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3173":1374,"_28139":1239,"_19503":49839,"_5":13343,"_25626":49494,"_2668":49840},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3173":1375,"_28139":1239,"_19503":49842,"_5":13343,"_25626":49494,"_2668":49843},[],"For the JITP flow to work correctly:",{"_3173":1376,"_28139":1239,"_19503":49845,"_5":13343,"_25626":49494,"_2668":49846},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3173":1377,"_28139":1239,"_19503":49848,"_5":13343,"_25626":49494,"_2668":49849},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3173":1378,"_28139":1239,"_19503":49851,"_5":13343,"_25626":49494,"_2668":49852},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3173":1379,"_28139":1239,"_19503":49854,"_5":13343,"_25626":49494,"_2668":49855},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3173":1380,"_28139":1239,"_19503":49857,"_5":13343,"_25626":49498,"_2668":49858},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3173":1381,"_28139":1239,"_19503":49860,"_5":13343,"_25626":49498,"_2668":49861},[],"Status in Lamassu",{"_3173":1382,"_28139":1239,"_19503":49863,"_5":13343,"_25626":49498,"_2668":49864},[],"Revocation reason",{"_3173":1383,"_28139":1239,"_19503":49866,"_5":13343,"_25626":49498,"_2668":49867},[],"Status in AWS IoT Core",{"_3173":1384,"_28139":1239,"_19503":49869,"_5":13343,"_25626":49498,"_2668":49870},[],"`Active`",{"_3173":1385,"_28139":1239,"_19503":49872,"_5":13343,"_25626":49498,"_2668":49873},[],"None",{"_3173":1386,"_28139":1239,"_19503":49875,"_5":13343,"_25626":49498,"_2668":49876},[],"`ACTIVE`",{"_3173":1387,"_28139":1239,"_19503":49878,"_5":13343,"_25626":49498,"_2668":49879},[],"`Revoked`",{"_3173":1388,"_28139":1239,"_19503":49881,"_5":13343,"_25626":49498,"_2668":49882},[],"`certificateHold`",{"_3173":1389,"_28139":1239,"_19503":49884,"_5":13343,"_25626":49498,"_2668":49885},[],"`INACTIVE`",{"_3173":1390,"_28139":1239,"_19503":49887,"_5":13343,"_25626":49498,"_2668":49879},[],{"_3173":1391,"_28139":1239,"_19503":49889,"_5":13343,"_25626":49498,"_2668":49890},[],"Any other reason",{"_3173":1392,"_28139":1239,"_19503":49892,"_5":13343,"_25626":49498,"_2668":49893},[],"`REVOKED`",{"_3173":1393,"_28139":1239,"_19503":49895,"_5":13343,"_25626":49498,"_2668":49896},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3173":1394,"_28139":1239,"_19503":49898,"_5":13343,"_25626":49502,"_2668":49899},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3173":1395,"_28139":1239,"_19503":49901,"_5":13343,"_25626":49502,"_2668":49902},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3173":1396,"_28139":1239,"_19503":49904,"_5":13343,"_25626":49502,"_2668":49905},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3173":1397,"_28139":1239,"_19503":49907,"_5":13343,"_25626":49506,"_2668":49908},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3173":1398,"_28139":1239,"_19503":49910,"_5":13343,"_25626":49506,"_2668":49911},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3173":1399,"_28139":1239,"_19503":49913,"_5":13343,"_25626":49510,"_2668":49914},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3173":1400,"_28139":1239,"_19503":49916,"_5":13343,"_25626":49510,"_2668":49917},[],"There are two action types:",{"_3173":1401,"_28139":1239,"_19503":49919,"_5":13343,"_25626":49510,"_2668":49920},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3173":1402,"_28139":1239,"_19503":49922,"_5":13343,"_25626":49510,"_2668":49923},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3173":1403,"_28139":1239,"_19503":49925,"_5":13343,"_25626":49510,"_2668":49926},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3173":1404,"_28139":1239,"_19503":49928,"_5":13343,"_25626":49514,"_2668":49929},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3173":1405,"_28139":1239,"_19503":49931,"_5":13343,"_25626":49514,"_2668":49932},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3173":1406,"_28139":1239,"_19503":49934,"_5":13343,"_25626":49514,"_2668":49935},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3173":1407,"_28139":1239,"_19503":49937,"_5":13343,"_25626":49518,"_2668":49938},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3173":1408,"_28139":1239,"_19503":49940,"_5":13343,"_25626":49518,"_2668":49941},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3173":1409,"_28139":1239,"_19503":49943,"_5":13343,"_25626":49518,"_2668":49944},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3173":1410,"_28139":1239,"_19503":49946,"_5":13343,"_25626":49518,"_2668":49947},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3173":1411,"_28139":1239,"_19503":49949,"_5":13343,"_25626":49518,"_2668":49950},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3173":1412,"_28139":1239,"_19503":49952,"_5":13343,"_25626":49518,"_2668":49953},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3173":1413,"_28139":1239,"_19503":49955,"_5":13343,"_25626":49518,"_2668":49956},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3173":1414,"_28139":1239,"_19503":49958,"_5":13343,"_25626":49518,"_2668":49959},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3173":1415,"_28139":1239,"_19503":49961,"_5":13343,"_25626":49518,"_2668":49962},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3173":1416,"_28139":1239,"_19503":49964,"_5":13343,"_25626":49518,"_2668":49965},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3173":1417,"_28139":1239,"_19503":49967,"_5":13343,"_25626":49518,"_2668":49968},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3173":1418,"_28139":1239,"_19503":49970,"_5":13343,"_25626":49518,"_2668":49971},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3173":1419,"_28139":1239,"_19503":49973,"_5":13343,"_25626":49518,"_2668":49974},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3173":1420,"_28139":1239,"_19503":49976,"_5":13343,"_25626":49518,"_2668":49977},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3173":1421,"_28139":1239,"_19503":49979,"_5":13343,"_25626":49518,"_2668":49980},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3173":1422,"_28139":1239,"_19503":49982,"_5":13343,"_25626":49518,"_2668":49983},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3173":1423,"_28139":1239,"_19503":49985,"_5":13343,"_25626":49518,"_2668":49986},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3173":1424,"_28139":1239,"_19503":49988,"_5":13343,"_25626":49518,"_2668":49989},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3173":1425,"_28139":1239,"_19503":49991,"_5":13343,"_25626":49518,"_2668":49992},[],"**Symptom:** After editing a DMS in `jitp` mode, messages about that DMS update appear in the `lamassu-dlq` poison queue.",{"_3173":1426,"_28139":1239,"_19503":49994,"_5":13343,"_25626":49518,"_2668":49995},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`.",{"_3173":1427,"_28139":1239,"_19503":49997,"_5":13343,"_25626":49518,"_2668":49998},[],"**Resolution:** Verify the template named after the DMS ID still exists in AWS IoT Core and that JITP enrollment works. The `lamassu-dlq` message reflects the failed re-creation attempt, not a broken JITP flow.",{"_3173":1428,"_28139":1239,"_19503":50000,"_5":13343,"_25626":49518,"_2668":50001},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3173":1429,"_28139":1239,"_19503":50003,"_5":13343,"_25626":49518,"_2668":50004},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3173":1430,"_28139":1239,"_19503":50006,"_5":13343,"_25626":49518,"_2668":50007},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3173":1431,"_28139":1431,"_5":13674,"_2668":47973,"_28481":50009,"_19503":50010,"_25626":1431},[45572,46965,47973],[],{"_3173":1432,"_28139":1431,"_19503":50012,"_5":13343,"_25626":1431,"_2668":50013},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3173":1433,"_28139":1431,"_5":28478,"_19503":50015,"_25626":50016,"_2668":50017},[],"/docs/pr-preview/pr-43/platform/iot-fleets/overview#start-here","Start here",{"_3173":1434,"_28139":1431,"_5":28478,"_19503":50019,"_25626":50020,"_2668":47971},[],"/docs/pr-preview/pr-43/platform/iot-fleets/overview#devices-and-identities",{"_3173":1435,"_28139":1431,"_5":28478,"_19503":50022,"_25626":50023,"_2668":48154},[],"/docs/pr-preview/pr-43/platform/iot-fleets/overview#enrollment-with-pki",{"_3173":1436,"_28139":1431,"_5":28478,"_19503":50025,"_25626":50026,"_2668":49435},[],"/docs/pr-preview/pr-43/platform/iot-fleets/overview#integrations",{"_3173":1437,"_28139":1431,"_5":28478,"_19503":50028,"_25626":50029,"_2668":50030},[],"/docs/pr-preview/pr-43/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3173":1438,"_28139":1431,"_19503":50032,"_5":13343,"_25626":1431,"_2668":50033},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3173":1439,"_28139":1431,"_19503":50035,"_5":13343,"_25626":50016,"_2668":50036},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3173":1440,"_28139":1431,"_19503":50038,"_5":13343,"_25626":50016,"_2668":50039},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3173":1441,"_28139":1431,"_19503":50041,"_5":13343,"_25626":50020,"_2668":50042},[],"Resource",{"_3173":1442,"_28139":1431,"_19503":50044,"_5":13343,"_25626":50020,"_2668":50045},[],"What it represents",{"_3173":1443,"_28139":1431,"_19503":50047,"_5":13343,"_25626":50020,"_2668":50048},[],"**Device**",{"_3173":1444,"_28139":1431,"_19503":50050,"_5":13343,"_25626":50020,"_2668":50051},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3173":1445,"_28139":1431,"_19503":50053,"_5":13343,"_25626":50020,"_2668":50054},[],"**Identity**",{"_3173":1446,"_28139":1431,"_19503":50056,"_5":13343,"_25626":50020,"_2668":50057},[],"The device's association with its certificates: an active version and a history.",{"_3173":1447,"_28139":1431,"_19503":50059,"_5":13343,"_25626":50020,"_2668":50060},[],"**DMS**",{"_3173":1448,"_28139":1431,"_19503":50062,"_5":13343,"_25626":50020,"_2668":50063},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3173":1449,"_28139":1431,"_19503":50065,"_5":13343,"_25626":50020,"_2668":50066},[],"**Fleet**",{"_3173":1450,"_28139":1431,"_19503":50068,"_5":13343,"_25626":50020,"_2668":50069},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3173":1451,"_28139":1431,"_19503":50071,"_5":13343,"_25626":50020,"_2668":50072},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3173":1452,"_28139":1431,"_19503":50074,"_5":13343,"_25626":50020,"_2668":50075},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3173":1453,"_28139":1431,"_19503":50077,"_5":13343,"_25626":50023,"_2668":50078},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3173":1454,"_28139":1431,"_19503":50080,"_5":13343,"_25626":50023,"_2668":50081},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3173":1455,"_28139":1431,"_19503":50083,"_5":13343,"_25626":50023,"_2668":50084},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3173":1456,"_28139":1431,"_19503":50086,"_5":13343,"_25626":50023,"_2668":50087},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3173":1457,"_28139":1431,"_19503":50089,"_5":13343,"_25626":50023,"_2668":50090},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3173":1458,"_28139":1431,"_19503":50092,"_5":13343,"_25626":50023,"_2668":50093},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3173":1459,"_28139":1431,"_19503":50095,"_5":13343,"_25626":50023,"_2668":50096},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3173":1460,"_28139":1431,"_19503":50098,"_5":13343,"_25626":50023,"_2668":50099},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3173":1461,"_28139":1431,"_19503":50101,"_5":13343,"_25626":50026,"_2668":50102},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3173":1462,"_28139":1431,"_19503":50104,"_5":13343,"_25626":50026,"_2668":50105},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3173":1463,"_28139":1431,"_19503":50107,"_5":13343,"_25626":50029,"_2668":50108},[],"Participant",{"_3173":1464,"_28139":1431,"_19503":50110,"_5":13343,"_25626":50029,"_2668":50111},[],"Responsibility",{"_3173":1465,"_28139":1431,"_19503":50113,"_5":13343,"_25626":50029,"_2668":50114},[],"PKI administrator",{"_3173":1466,"_28139":1431,"_19503":50116,"_5":13343,"_25626":50029,"_2668":50117},[],"CA, issuance profile, chain and revocation publication.",{"_3173":1467,"_28139":1431,"_19503":50119,"_5":13343,"_25626":50029,"_2668":50120},[],"Provisioning administrator",{"_3173":1468,"_28139":1431,"_19503":50122,"_5":13343,"_25626":50029,"_2668":50123},[],"DMS, admission, authentication per operation and inventory.",{"_3173":1469,"_28139":1431,"_19503":50125,"_5":13343,"_25626":50029,"_2668":50126},[],"Device integrator",{"_3173":1470,"_28139":1431,"_19503":50128,"_5":13343,"_25626":50029,"_2668":50129},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3173":1471,"_28139":1431,"_19503":50131,"_5":13343,"_25626":50029,"_2668":50132},[],"Consumer integrator",{"_3173":1472,"_28139":1431,"_19503":50134,"_5":13343,"_25626":50029,"_2668":50135},[],"Trusted issuers, validation and device permissions in the destination.",{"_3173":1473,"_28139":1431,"_19503":50137,"_5":13343,"_25626":50029,"_2668":50138},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3173":1474,"_28139":1474,"_5":13674,"_2668":50140,"_28481":50141,"_19503":50143,"_25626":1474},"Enroll and connect your first device",[45572,46965,47973,50142],"Getting started",[],{"_3173":1475,"_28139":1474,"_19503":50145,"_5":13343,"_25626":1474,"_2668":50146},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3173":1476,"_28139":1474,"_5":28478,"_19503":50148,"_25626":50149,"_2668":45582},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3173":1477,"_28139":1474,"_5":28478,"_19503":50151,"_25626":50152,"_2668":50153},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3173":1478,"_28139":1474,"_5":28478,"_19503":50155,"_25626":50156,"_2668":50157},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3173":1479,"_28139":1474,"_5":28478,"_19503":50159,"_25626":50160,"_2668":50161},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3173":1480,"_28139":1474,"_5":28478,"_19503":50163,"_25626":50164,"_2668":50165},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3173":1481,"_28139":1474,"_5":28478,"_19503":50167,"_25626":50168,"_2668":50169},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3173":1482,"_28139":1474,"_5":28478,"_19503":50171,"_25626":50172,"_2668":50173},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3173":1483,"_28139":1474,"_5":28478,"_19503":50175,"_25626":50176,"_2668":50177},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3173":1484,"_28139":1474,"_19503":50179,"_5":13343,"_25626":1474,"_2668":50180},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3173":1485,"_28139":1474,"_19503":50182,"_5":13343,"_25626":50149,"_2668":50183},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3173":1486,"_28139":1474,"_19503":50185,"_5":13343,"_25626":50149,"_2668":50186},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3173":1487,"_28139":1474,"_19503":50188,"_5":13343,"_25626":50149,"_2668":50189},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3173":1488,"_28139":1474,"_19503":50191,"_5":13343,"_25626":50149,"_2668":50192},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3173":1489,"_28139":1474,"_19503":50194,"_5":13343,"_25626":50149,"_2668":50195},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3173":1490,"_28139":1474,"_19503":50197,"_5":13343,"_25626":50152,"_2668":50198},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3173":1491,"_28139":1474,"_19503":50200,"_5":13343,"_25626":50152,"_2668":50201},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3173":1492,"_28139":1474,"_19503":50203,"_5":13343,"_25626":50156,"_2668":50204},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3173":1493,"_28139":1474,"_19503":50206,"_5":13343,"_25626":50156,"_2668":50207},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3173":1494,"_28139":1474,"_19503":50209,"_5":13343,"_25626":50156,"_2668":50210},[],"Setting",{"_3173":1495,"_28139":1474,"_19503":50212,"_5":13343,"_25626":50156,"_2668":50213},[],"Evaluation value",{"_3173":1496,"_28139":1474,"_19503":50215,"_5":13343,"_25626":50156,"_2668":50216},[],"Enrollment CA",{"_3173":1497,"_28139":1474,"_19503":50218,"_5":13343,"_25626":50156,"_2668":50219},[],"Issuing root from `device-root.pem`.",{"_3173":1498,"_28139":1474,"_19503":50221,"_5":13343,"_25626":50156,"_2668":48284},[],{"_3173":1499,"_28139":1474,"_19503":50223,"_5":13343,"_25626":50156,"_2668":50224},[],"The 1-hour leaf profile you just prepared.",{"_3173":1500,"_28139":1474,"_19503":50226,"_5":13343,"_25626":50156,"_2668":50227},[],"Protocol / Registration Mode",{"_3173":1501,"_28139":1474,"_19503":50229,"_5":13343,"_25626":50156,"_2668":50230},[],"`EST_RFC7030` / `JITP`.",{"_3173":1502,"_28139":1474,"_19503":50232,"_5":13343,"_25626":50156,"_2668":50233},[],"Verify CSR Signature",{"_3173":1503,"_28139":1474,"_19503":50235,"_5":13343,"_25626":50156,"_2668":50236},[],"Enabled.",{"_3173":1504,"_28139":1474,"_19503":50238,"_5":13343,"_25626":50156,"_2668":50239},[],"Enable Replaceable Enrollment",{"_3173":1505,"_28139":1474,"_19503":50241,"_5":13343,"_25626":50156,"_2668":50242},[],"Disabled; the ID must be new.",{"_3173":1506,"_28139":1474,"_19503":50244,"_5":13343,"_25626":50156,"_2668":50245},[],"Initial authentication",{"_3173":1507,"_28139":1474,"_19503":50247,"_5":13343,"_25626":50156,"_2668":50248},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3173":1508,"_28139":1474,"_19503":50250,"_5":13343,"_25626":50156,"_2668":50251},[],"Renewal authentication",{"_3173":1509,"_28139":1474,"_19503":50253,"_5":13343,"_25626":50156,"_2668":50254},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3173":1510,"_28139":1474,"_19503":50256,"_5":13343,"_25626":50156,"_2668":50257},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3173":1511,"_28139":1474,"_19503":50259,"_5":13343,"_25626":50156,"_2668":50260},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3173":1512,"_28139":1474,"_19503":50262,"_5":13343,"_25626":50156,"_2668":50263},[],"Re-enrollment Delta",{"_3173":1513,"_28139":1474,"_19503":50265,"_5":13343,"_25626":50156,"_2668":50266},[],"1 hour.",{"_3173":1514,"_28139":1474,"_19503":50268,"_5":13343,"_25626":50156,"_2668":50269},[],"Preventive / Critical Delta",{"_3173":1515,"_28139":1474,"_19503":50271,"_5":13343,"_25626":50156,"_2668":50272},[],"30 minutes / 10 minutes.",{"_3173":1516,"_28139":1474,"_19503":50274,"_5":13343,"_25626":50156,"_2668":50275},[],"Revoke on Re-enrollment",{"_3173":1517,"_28139":1474,"_19503":50277,"_5":13343,"_25626":50156,"_2668":50278},[],"Disabled to test the successor before retiring the previous identity.",{"_3173":1518,"_28139":1474,"_19503":50280,"_5":13343,"_25626":50156,"_2668":48292},[],{"_3173":1519,"_28139":1474,"_19503":50282,"_5":13343,"_25626":50156,"_2668":50283},[],"Disabled; the operational key is generated in the client.",{"_3173":1520,"_28139":1474,"_19503":50285,"_5":13343,"_25626":50156,"_2668":50286},[],"CA Distribution",{"_3173":1521,"_28139":1474,"_19503":50288,"_5":13343,"_25626":50156,"_2668":50289},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3173":1522,"_28139":1474,"_19503":50291,"_5":13343,"_25626":50156,"_2668":50292},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3173":1523,"_28139":1474,"_19503":50294,"_5":13343,"_25626":50160,"_2668":50295},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3173":1524,"_28139":1474,"_19503":50297,"_5":13343,"_25626":50160,"_2668":50298},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3173":1525,"_28139":1474,"_19503":50300,"_5":13343,"_25626":50164,"_2668":50301},[],"Generate a new key and CSR with the selected identifier:",{"_3173":1526,"_28139":1474,"_19503":50303,"_5":13343,"_25626":50164,"_2668":50304},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3173":1527,"_28139":1474,"_19503":50306,"_5":13343,"_25626":50164,"_2668":50307},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3173":1528,"_28139":1474,"_19503":50309,"_5":13343,"_25626":50168,"_2668":50310},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3173":1529,"_28139":1474,"_19503":50312,"_5":13343,"_25626":50168,"_2668":50313},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3173":1530,"_28139":1474,"_19503":50315,"_5":13343,"_25626":50172,"_2668":50316},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3173":1531,"_28139":1474,"_19503":50318,"_5":13343,"_25626":50172,"_2668":50319},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3173":1532,"_28139":1474,"_19503":50321,"_5":13343,"_25626":50172,"_2668":50322},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3173":1533,"_28139":1474,"_19503":50324,"_5":13343,"_25626":50172,"_2668":50325},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3173":1534,"_28139":1474,"_19503":50327,"_5":13343,"_25626":50172,"_2668":50328},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3173":1535,"_28139":1474,"_19503":50330,"_5":13343,"_25626":50176,"_2668":50331},[],"Check",{"_3173":1536,"_28139":1474,"_19503":50333,"_5":13343,"_25626":50176,"_2668":50334},[],"Expected result",{"_3173":1537,"_28139":1474,"_19503":50336,"_5":13343,"_25626":50176,"_2668":50337},[],"Registration",{"_3173":1538,"_28139":1474,"_19503":50339,"_5":13343,"_25626":50176,"_2668":50340},[],"ID created automatically and correct DMS.",{"_3173":1539,"_28139":1474,"_19503":50342,"_5":13343,"_25626":50176,"_2668":50343},[],"Certificate",{"_3173":1540,"_28139":1474,"_19503":50345,"_5":13343,"_25626":50176,"_2668":50346},[],"CN, profile, serial and key verified.",{"_3173":1541,"_28139":1474,"_19503":50348,"_5":13343,"_25626":50176,"_2668":50349},[],"Inventory",{"_3173":1542,"_28139":1474,"_19503":50351,"_5":13343,"_25626":50176,"_2668":50352},[],"Received serial visible as the current identity and in history.",{"_3173":1543,"_28139":1474,"_19503":50354,"_5":13343,"_25626":50176,"_2668":50355},[],"Consumer",{"_3173":1544,"_28139":1474,"_19503":50357,"_5":13343,"_25626":50176,"_2668":50358},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3173":1545,"_28139":1474,"_19503":50360,"_5":13343,"_25626":50176,"_2668":50361},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3173":1546,"_28139":1474,"_19503":50363,"_5":13343,"_25626":50176,"_2668":50364},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3173":1547,"_28139":1547,"_5":13674,"_2668":47989,"_28481":50366,"_19503":50367,"_25626":1547},[45572,46965,47973,50142],[],{"_3173":1548,"_28139":1547,"_19503":50369,"_5":13343,"_25626":1547,"_2668":50370},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3173":1549,"_28139":1547,"_5":28478,"_19503":50372,"_25626":50373,"_2668":45582},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3173":1550,"_28139":1547,"_5":28478,"_19503":50375,"_25626":50376,"_2668":50377},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3173":1551,"_28139":1547,"_5":28478,"_19503":50379,"_25626":50380,"_2668":50381},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3173":1552,"_28139":1547,"_5":28478,"_19503":50383,"_25626":50384,"_2668":50385},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3173":1553,"_28139":1547,"_5":28478,"_19503":50387,"_25626":50388,"_2668":50389},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3173":1554,"_28139":1547,"_5":28478,"_19503":50391,"_25626":50392,"_2668":50393},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3173":1555,"_28139":1547,"_5":28478,"_19503":50395,"_25626":50396,"_2668":50334},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3173":1556,"_28139":1547,"_5":28478,"_19503":50398,"_25626":50399,"_2668":50400},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3173":1557,"_28139":1547,"_5":28478,"_19503":50402,"_25626":50403,"_2668":50404},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3173":1558,"_28139":1547,"_19503":50406,"_5":13343,"_25626":1547,"_2668":50407},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3173":1559,"_28139":1547,"_19503":50409,"_5":13343,"_25626":1547,"_2668":50410},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3173":1560,"_28139":1547,"_19503":50412,"_5":13343,"_25626":50373,"_2668":50413},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3173":1561,"_28139":1547,"_19503":50415,"_5":13343,"_25626":50373,"_2668":50416},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3173":1562,"_28139":1547,"_19503":50418,"_5":13343,"_25626":50373,"_2668":50419},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3173":1563,"_28139":1547,"_19503":50421,"_5":13343,"_25626":50373,"_2668":50422},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3173":1564,"_28139":1547,"_19503":50424,"_5":13343,"_25626":50376,"_2668":50425},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3173":1565,"_28139":1547,"_19503":50427,"_5":13343,"_25626":50376,"_2668":50428},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3173":1566,"_28139":1547,"_19503":50430,"_5":13343,"_25626":50376,"_2668":50431},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3173":1567,"_28139":1547,"_19503":50433,"_5":13343,"_25626":50376,"_2668":50434},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3173":1568,"_28139":1547,"_19503":50436,"_5":13343,"_25626":50376,"_2668":50437},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3173":1569,"_28139":1547,"_19503":50439,"_5":13343,"_25626":50376,"_2668":50440},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3173":1570,"_28139":1547,"_19503":50442,"_5":13343,"_25626":50376,"_2668":50443},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3173":1571,"_28139":1547,"_19503":50445,"_5":13343,"_25626":50376,"_2668":50446},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3173":1572,"_28139":1547,"_19503":50448,"_5":13343,"_25626":50380,"_2668":50449},[],"Open **Managed Devices** and the registration action. Complete:",{"_3173":1573,"_28139":1547,"_19503":50451,"_5":13343,"_25626":50380,"_2668":50452},[],"**Device ID**: `device-001`.",{"_3173":1574,"_28139":1547,"_19503":50454,"_5":13343,"_25626":50380,"_2668":50455},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3173":1575,"_28139":1547,"_19503":50457,"_5":13343,"_25626":50380,"_2668":50458},[],"**Icon** and **Tags**: optional classification.",{"_3173":1576,"_28139":1547,"_19503":50460,"_5":13343,"_25626":50380,"_2668":50461},[],"Confirm registration.",{"_3173":1577,"_28139":1547,"_19503":50463,"_5":13343,"_25626":50384,"_2668":50464},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3173":1578,"_28139":1547,"_19503":50466,"_5":13343,"_25626":50384,"_2668":50467},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3173":1579,"_28139":1547,"_19503":50469,"_5":13343,"_25626":50388,"_2668":50470},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3173":1580,"_28139":1547,"_19503":50472,"_5":13343,"_25626":50388,"_2668":50473},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3173":1581,"_28139":1547,"_19503":50475,"_5":13343,"_25626":50392,"_2668":50476},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3173":1582,"_28139":1547,"_19503":50478,"_5":13343,"_25626":50392,"_2668":50479},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3173":1583,"_28139":1547,"_19503":50481,"_5":13343,"_25626":50396,"_2668":50331},[],{"_3173":1584,"_28139":1547,"_19503":50483,"_5":13343,"_25626":50396,"_2668":50484},[],"Result",{"_3173":1585,"_28139":1547,"_19503":50486,"_5":13343,"_25626":50396,"_2668":50487},[],"Device",{"_3173":1586,"_28139":1547,"_19503":50489,"_5":13343,"_25626":50396,"_2668":50490},[],"`device-001` appears in inventory with the expected DMS.",{"_3173":1587,"_28139":1547,"_19503":50492,"_5":13343,"_25626":50396,"_2668":50493},[],"Current identity",{"_3173":1588,"_28139":1547,"_19503":50495,"_5":13343,"_25626":50396,"_2668":50496},[],"The associated certificate matches the one you verified in PKI.",{"_3173":1589,"_28139":1547,"_19503":50498,"_5":13343,"_25626":50396,"_2668":50499},[],"History",{"_3173":1590,"_28139":1547,"_19503":50501,"_5":13343,"_25626":50396,"_2668":50502},[],"The associated issuance appears with its serial number and dates.",{"_3173":1591,"_28139":1547,"_19503":50504,"_5":13343,"_25626":50396,"_2668":50505},[],"Key and certificate",{"_3173":1592,"_28139":1547,"_19503":50507,"_5":13343,"_25626":50396,"_2668":50508},[],"You have the verified pair ready to install on the device.",{"_3173":1593,"_28139":1547,"_19503":50510,"_5":13343,"_25626":50399,"_2668":50511},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3173":1594,"_28139":1547,"_19503":50513,"_5":13343,"_25626":50399,"_2668":50514},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3173":1595,"_28139":1547,"_19503":50516,"_5":13343,"_25626":50399,"_2668":50517},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3173":1596,"_28139":1547,"_19503":50519,"_5":13343,"_25626":50399,"_2668":50520},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3173":1597,"_28139":1547,"_19503":50522,"_5":13343,"_25626":50403,"_2668":50523},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3173":1598,"_28139":1547,"_19503":50525,"_5":13343,"_25626":50403,"_2668":50526},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3173":1599,"_28139":1547,"_19503":50528,"_5":13343,"_25626":50403,"_2668":50529},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3173":1600,"_28139":1600,"_5":13674,"_2668":50531,"_28481":50532,"_19503":50533,"_25626":1600},"Lamassu IoT Platform",[45572,46965],[],{"_3173":1601,"_28139":1600,"_19503":50535,"_5":13343,"_25626":1600,"_2668":50536},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3173":1602,"_28139":1600,"_5":28478,"_19503":50538,"_25626":50539,"_2668":50017},[],"/docs/pr-preview/pr-43/platform/overview#start-here",{"_3173":1603,"_28139":1600,"_5":28478,"_19503":50541,"_25626":50542,"_2668":50543},[],"/docs/pr-preview/pr-43/platform/overview#choose-your-path","Choose your path",{"_3173":1604,"_28139":1600,"_5":28478,"_19503":50545,"_25626":50546,"_2668":50547},[],"/docs/pr-preview/pr-43/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3173":1605,"_28139":1600,"_5":28478,"_19503":50549,"_25626":50550,"_2668":50551},[],"/docs/pr-preview/pr-43/platform/overview#core-capabilities","Core capabilities",{"_3173":1606,"_28139":1600,"_5":28478,"_19503":50553,"_25626":50554,"_2668":50555},[],"/docs/pr-preview/pr-43/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3173":1607,"_28139":1600,"_5":28478,"_19503":50557,"_25626":50558,"_2668":50559},[],"/docs/pr-preview/pr-43/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3173":1608,"_28139":1600,"_5":28478,"_19503":50561,"_25626":50562,"_2668":50563},[],"/docs/pr-preview/pr-43/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3173":1609,"_28139":1600,"_5":28478,"_19503":50565,"_25626":50566,"_2668":50567},[],"/docs/pr-preview/pr-43/platform/overview#automate-device-identities","Automate device identities",{"_3173":1610,"_28139":1600,"_5":28478,"_19503":50569,"_25626":50570,"_2668":50571},[],"/docs/pr-preview/pr-43/platform/overview#publish-validation-status","Publish validation status",{"_3173":1611,"_28139":1600,"_5":28478,"_19503":50573,"_25626":50574,"_2668":50575},[],"/docs/pr-preview/pr-43/platform/overview#react-to-events","React to events",{"_3173":1612,"_28139":1600,"_5":28478,"_19503":50577,"_25626":50578,"_2668":50579},[],"/docs/pr-preview/pr-43/platform/overview#operational-reference","Operational reference",{"_3173":1613,"_28139":1600,"_19503":50581,"_5":13343,"_25626":1600,"_2668":50582},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3173":1614,"_28139":1600,"_19503":50584,"_5":13343,"_25626":50539,"_2668":50585},[],"Choose the result you need:",{"_3173":1615,"_28139":1600,"_19503":50587,"_5":13343,"_25626":50539,"_2668":50588},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3173":1616,"_28139":1600,"_19503":50590,"_5":13343,"_25626":50539,"_2668":50591},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3173":1617,"_28139":1600,"_19503":50593,"_5":13343,"_25626":50539,"_2668":50594},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3173":1618,"_28139":1600,"_19503":50596,"_5":13343,"_25626":50542,"_2668":50597},[],"Section",{"_3173":1619,"_28139":1600,"_19503":50599,"_5":13343,"_25626":50542,"_2668":50600},[],"What you manage",{"_3173":1620,"_28139":1600,"_19503":50602,"_5":13343,"_25626":50542,"_2668":50603},[],"Entry point",{"_3173":1621,"_28139":1600,"_19503":50605,"_5":13343,"_25626":50542,"_2668":50606},[],"**PKI**",{"_3173":1622,"_28139":1600,"_19503":50608,"_5":13343,"_25626":50542,"_2668":50609},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3173":1623,"_28139":1600,"_19503":50611,"_5":13343,"_25626":50542,"_2668":50612},[],"PKI overview",{"_3173":1624,"_28139":1600,"_19503":50614,"_5":13343,"_25626":50542,"_2668":50615},[],"**IoT Fleets**",{"_3173":1625,"_28139":1600,"_19503":50617,"_5":13343,"_25626":50542,"_2668":50618},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3173":1626,"_28139":1600,"_19503":50620,"_5":13343,"_25626":50542,"_2668":50621},[],"IoT Fleets overview",{"_3173":1627,"_28139":1600,"_19503":50623,"_5":13343,"_25626":50542,"_2668":50624},[],"**Administration**",{"_3173":1628,"_28139":1600,"_19503":50626,"_5":13343,"_25626":50542,"_2668":50627},[],"Operator permissions, audit and event subscriptions.",{"_3173":1629,"_28139":1600,"_19503":50629,"_5":13343,"_25626":50542,"_2668":46963},[],{"_3173":1630,"_28139":1600,"_19503":50631,"_5":13343,"_25626":50542,"_2668":50632},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3173":1631,"_28139":1600,"_19503":50634,"_5":13343,"_25626":50546,"_2668":50635},[],"An identity's journey connects four responsibilities:",{"_3173":1632,"_28139":1600,"_19503":50637,"_5":13343,"_25626":50546,"_2668":50638},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3173":1633,"_28139":1600,"_19503":50640,"_5":13343,"_25626":50546,"_2668":50641},[],"The provisioning administrator configures the DMS and initial trust.",{"_3173":1634,"_28139":1600,"_19503":50643,"_5":13343,"_25626":50546,"_2668":50644},[],"The device client requests a certificate and installs it with the matching key.",{"_3173":1635,"_28139":1600,"_19503":50646,"_5":13343,"_25626":50546,"_2668":50647},[],"The consumer validates the identity and applies its access permissions.",{"_3173":1636,"_28139":1600,"_19503":50649,"_5":13343,"_25626":50546,"_2668":50650},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3173":1637,"_28139":1600,"_19503":50652,"_5":13343,"_25626":50554,"_2668":50653},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3173":1638,"_28139":1600,"_19503":50655,"_5":13343,"_25626":50558,"_2668":50656},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3173":1639,"_28139":1600,"_19503":50658,"_5":13343,"_25626":50562,"_2668":50659},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3173":1640,"_28139":1600,"_19503":50661,"_5":13343,"_25626":50566,"_2668":50662},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3173":1641,"_28139":1600,"_19503":50664,"_5":13343,"_25626":50570,"_2668":50665},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3173":1642,"_28139":1600,"_19503":50667,"_5":13343,"_25626":50574,"_2668":50668},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3173":1643,"_28139":1600,"_19503":50670,"_5":13343,"_25626":50578,"_2668":50111},[],{"_3173":1644,"_28139":1600,"_19503":50672,"_5":13343,"_25626":50578,"_2668":50673},[],"What it prepares or checks",{"_3173":1645,"_28139":1600,"_19503":50675,"_5":13343,"_25626":50578,"_2668":50114},[],{"_3173":1646,"_28139":1600,"_19503":50677,"_5":13343,"_25626":50578,"_2668":50678},[],"Key custody, CA hierarchy, profiles and validation.",{"_3173":1647,"_28139":1600,"_19503":50680,"_5":13343,"_25626":50578,"_2668":50681},[],"Fleet administrator",{"_3173":1648,"_28139":1600,"_19503":50683,"_5":13343,"_25626":50578,"_2668":50684},[],"DMS, device admission, renewal policy and inventory.",{"_3173":1649,"_28139":1600,"_19503":50686,"_5":13343,"_25626":50578,"_2668":50126},[],{"_3173":1650,"_28139":1600,"_19503":50688,"_5":13343,"_25626":50578,"_2668":50689},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3173":1651,"_28139":1600,"_19503":50691,"_5":13343,"_25626":50578,"_2668":50132},[],{"_3173":1652,"_28139":1600,"_19503":50693,"_5":13343,"_25626":50578,"_2668":50694},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3173":1653,"_28139":1600,"_19503":50696,"_5":13343,"_25626":50578,"_2668":50697},[],"Infrastructure operator",{"_3173":1654,"_28139":1600,"_19503":50699,"_5":13343,"_25626":50578,"_2668":50700},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3173":1655,"_28139":1600,"_19503":50702,"_5":13343,"_25626":50578,"_2668":50703},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3173":1656,"_28139":1656,"_5":13674,"_2668":50705,"_28481":50706,"_19503":50709,"_25626":1656},"CA hierarchy and rotation",[45572,46965,50707,50708],"PKI","Keys, authorities and certificates",[],{"_3173":1657,"_28139":1656,"_19503":50711,"_5":13343,"_25626":1656,"_2668":50712},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3173":1658,"_28139":1656,"_5":28478,"_19503":50714,"_25626":50715,"_2668":50716},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3173":1659,"_28139":1656,"_5":28478,"_19503":50718,"_25626":50719,"_2668":50720},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3173":1660,"_28139":1656,"_5":28478,"_19503":50722,"_25626":50723,"_2668":50724},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3173":1661,"_28139":1656,"_5":28478,"_19503":50726,"_25626":50727,"_2668":50728},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3173":1662,"_28139":1656,"_5":28478,"_19503":50730,"_25626":50731,"_2668":50732},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3173":1663,"_28139":1656,"_5":28478,"_19503":50734,"_25626":50735,"_2668":50736},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3173":1664,"_28139":1656,"_5":28478,"_19503":50738,"_25626":50739,"_2668":50740},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3173":1665,"_28139":1656,"_5":28478,"_19503":50742,"_25626":50743,"_2668":50744},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3173":1666,"_28139":1656,"_5":28478,"_19503":50746,"_25626":50747,"_2668":50748},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3173":1667,"_28139":1656,"_5":28478,"_19503":50750,"_25626":50751,"_2668":50752},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3173":1668,"_28139":1656,"_5":28478,"_19503":50754,"_25626":50755,"_2668":50756},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3173":1669,"_28139":1656,"_5":28478,"_19503":50758,"_25626":50759,"_2668":50760},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3173":1670,"_28139":1656,"_19503":50762,"_5":13343,"_25626":1656,"_2668":50763},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3173":1671,"_28139":1656,"_19503":50765,"_5":13343,"_25626":1656,"_2668":50766},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3173":1672,"_28139":1656,"_19503":50768,"_5":13343,"_25626":50715,"_2668":50769},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3173":1673,"_28139":1656,"_19503":50771,"_5":13343,"_25626":50715,"_2668":50772},[],"environment, such as production and preproduction;",{"_3173":1674,"_28139":1656,"_19503":50774,"_5":13343,"_25626":50715,"_2668":50775},[],"owner or operating team;",{"_3173":1675,"_28139":1656,"_19503":50777,"_5":13343,"_25626":50715,"_2668":50778},[],"device family or manufacturing process;",{"_3173":1676,"_28139":1656,"_19503":50780,"_5":13343,"_25626":50715,"_2668":50781},[],"region or regulatory requirement;",{"_3173":1677,"_28139":1656,"_19503":50783,"_5":13343,"_25626":50715,"_2668":50784},[],"cryptographic engine or key policy;",{"_3173":1678,"_28139":1656,"_19503":50786,"_5":13343,"_25626":50715,"_2668":50787},[],"maintenance window and renewal cadence.",{"_3173":1679,"_28139":1656,"_19503":50789,"_5":13343,"_25626":50715,"_2668":50790},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3173":1680,"_28139":1656,"_19503":50792,"_5":13343,"_25626":50715,"_2668":50793},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3173":1681,"_28139":1656,"_19503":50795,"_5":13343,"_25626":50719,"_2668":50796},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3173":1682,"_28139":1656,"_19503":50798,"_5":13343,"_25626":50719,"_2668":50799},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3173":1683,"_28139":1656,"_19503":50801,"_5":13343,"_25626":50719,"_2668":50802},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3173":1684,"_28139":1656,"_19503":50804,"_5":13343,"_25626":50723,"_2668":50805},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3173":1685,"_28139":1656,"_19503":50807,"_5":13343,"_25626":50723,"_2668":50808},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3173":1686,"_28139":1656,"_19503":50810,"_5":13343,"_25626":50723,"_2668":50811},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3173":1687,"_28139":1656,"_19503":50813,"_5":13343,"_25626":50723,"_2668":50814},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3173":1688,"_28139":1656,"_19503":50816,"_5":13343,"_25626":50731,"_2668":50817},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3173":1689,"_28139":1656,"_19503":50819,"_5":13343,"_25626":50735,"_2668":50820},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3173":1690,"_28139":1656,"_19503":50822,"_5":13343,"_25626":50739,"_2668":50823},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3173":1691,"_28139":1656,"_19503":50825,"_5":13343,"_25626":50743,"_2668":50826},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3173":1692,"_28139":1656,"_19503":50828,"_5":13343,"_25626":50747,"_2668":50829},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3173":1693,"_28139":1656,"_19503":50831,"_5":13343,"_25626":50751,"_2668":50832},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3173":1694,"_28139":1656,"_19503":50834,"_5":13343,"_25626":50755,"_2668":50835},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3173":1695,"_28139":1656,"_19503":50837,"_5":13343,"_25626":50755,"_2668":50838},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3173":1696,"_28139":1656,"_19503":50840,"_5":13343,"_25626":50755,"_2668":50841},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3173":1697,"_28139":1656,"_19503":50843,"_5":13343,"_25626":50755,"_2668":50844},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3173":1698,"_28139":1656,"_19503":50846,"_5":13343,"_25626":50759,"_2668":50847},[],"The new chain ends in an anchor installed by the consumer.",{"_3173":1699,"_28139":1656,"_19503":50849,"_5":13343,"_25626":50759,"_2668":50850},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3173":1700,"_28139":1656,"_19503":50852,"_5":13343,"_25626":50759,"_2668":50853},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3173":1701,"_28139":1656,"_19503":50855,"_5":13343,"_25626":50759,"_2668":50856},[],"Re-enrollment accepts the old identity during the planned period.",{"_3173":1702,"_28139":1656,"_19503":50858,"_5":13343,"_25626":50759,"_2668":50859},[],"OCSP and CRL respond for the authorities that remain active.",{"_3173":1703,"_28139":1656,"_19503":50861,"_5":13343,"_25626":50759,"_2668":50862},[],"No DMS is left accidentally issuing from the old CA.",{"_3173":1704,"_28139":1656,"_19503":50864,"_5":13343,"_25626":50759,"_2668":50865},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3173":1705,"_28139":1705,"_5":13674,"_2668":50867,"_28481":50868,"_19503":50869,"_25626":1705},"Certification authorities",[45572,46965,50707,50708],[],{"_3173":1706,"_28139":1705,"_19503":50871,"_5":13343,"_25626":1705,"_2668":50872},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3173":1707,"_28139":1705,"_5":28478,"_19503":50874,"_25626":50875,"_2668":50876},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3173":1708,"_28139":1705,"_5":28478,"_19503":50878,"_25626":50879,"_2668":50880},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3173":1709,"_28139":1705,"_5":28478,"_19503":50882,"_25626":50883,"_2668":45582},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#before-you-begin",{"_3173":1710,"_28139":1705,"_5":28478,"_19503":50885,"_25626":50886,"_2668":50887},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3173":1711,"_28139":1705,"_5":28478,"_19503":50889,"_25626":50890,"_2668":50891},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3173":1712,"_28139":1705,"_5":28478,"_19503":50893,"_25626":50894,"_2668":50895},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3173":1713,"_28139":1705,"_5":28478,"_19503":50897,"_25626":50898,"_2668":50899},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3173":1714,"_28139":1705,"_5":28478,"_19503":50901,"_25626":50902,"_2668":50903},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3173":1715,"_28139":1705,"_5":28478,"_19503":50905,"_25626":50906,"_2668":50907},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3173":1716,"_28139":1705,"_5":28478,"_19503":50909,"_25626":50910,"_2668":50911},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3173":1717,"_28139":1705,"_5":28478,"_19503":50913,"_25626":50914,"_2668":50915},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3173":1718,"_28139":1705,"_5":28478,"_19503":50917,"_25626":50918,"_2668":50919},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3173":1719,"_28139":1705,"_5":28478,"_19503":50921,"_25626":50922,"_2668":50923},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3173":1720,"_28139":1705,"_5":28478,"_19503":50925,"_25626":50926,"_2668":50927},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3173":1721,"_28139":1705,"_5":28478,"_19503":50929,"_25626":50930,"_2668":50931},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3173":1722,"_28139":1705,"_5":28478,"_19503":50933,"_25626":50934,"_2668":50935},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3173":1723,"_28139":1705,"_5":28478,"_19503":50937,"_25626":50938,"_2668":50939},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3173":1724,"_28139":1705,"_5":28478,"_19503":50941,"_25626":50942,"_2668":50943},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3173":1725,"_28139":1705,"_5":28478,"_19503":50945,"_25626":50946,"_2668":50947},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3173":1726,"_28139":1705,"_5":28478,"_19503":50949,"_25626":50950,"_2668":50951},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3173":1727,"_28139":1705,"_5":28478,"_19503":50953,"_25626":50954,"_2668":50955},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3173":1728,"_28139":1705,"_5":28478,"_19503":50957,"_25626":50958,"_2668":50959},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3173":1729,"_28139":1705,"_19503":50961,"_5":13343,"_25626":1705,"_2668":50962},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3173":1730,"_28139":1705,"_19503":50964,"_5":13343,"_25626":1705,"_2668":50965},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3173":1731,"_28139":1705,"_19503":50967,"_5":13343,"_25626":1705,"_2668":50968},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3173":1732,"_28139":1705,"_19503":50970,"_5":13343,"_25626":50875,"_2668":50971},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3173":1733,"_28139":1705,"_19503":50973,"_5":13343,"_25626":50875,"_2668":50974},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3173":1734,"_28139":1705,"_19503":50976,"_5":13343,"_25626":50875,"_2668":50977},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3173":1735,"_28139":1705,"_19503":50979,"_5":13343,"_25626":50875,"_2668":50980},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3173":1736,"_28139":1705,"_19503":50982,"_5":13343,"_25626":50875,"_2668":50983},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3173":1737,"_28139":1705,"_19503":50985,"_5":13343,"_25626":50883,"_2668":50986},[],"Decide whether the CA will be a root or an intermediate.",{"_3173":1738,"_28139":1705,"_19503":50988,"_5":13343,"_25626":50883,"_2668":50989},[],"Choose the engine that will keep the key.",{"_3173":1739,"_28139":1705,"_19503":50991,"_5":13343,"_25626":50883,"_2668":50992},[],"Define a validity longer than that of the certificates it will issue.",{"_3173":1740,"_28139":1705,"_19503":50994,"_5":13343,"_25626":50883,"_2668":50995},[],"For an intermediate CA, make sure the parent CA is active.",{"_3173":1741,"_28139":1705,"_19503":50997,"_5":13343,"_25626":50886,"_2668":50998},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3173":1742,"_28139":1705,"_19503":51000,"_5":13343,"_25626":50890,"_2668":51001},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3173":1743,"_28139":1705,"_19503":51003,"_5":13343,"_25626":50890,"_2668":51004},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3173":1744,"_28139":1705,"_19503":51006,"_5":13343,"_25626":50894,"_2668":51007},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3173":1745,"_28139":1705,"_19503":51009,"_5":13343,"_25626":50898,"_2668":51010},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3173":1746,"_28139":1705,"_19503":51012,"_5":13343,"_25626":50898,"_2668":51013},[],"`C`: two-letter ISO 3166-1 country code.",{"_3173":1747,"_28139":1705,"_19503":51015,"_5":13343,"_25626":50898,"_2668":51016},[],"`ST`: state or province.",{"_3173":1748,"_28139":1705,"_19503":51018,"_5":13343,"_25626":50898,"_2668":51019},[],"`L`: locality.",{"_3173":1749,"_28139":1705,"_19503":51021,"_5":13343,"_25626":50898,"_2668":51022},[],"`O`: organization.",{"_3173":1750,"_28139":1705,"_19503":51024,"_5":13343,"_25626":50898,"_2668":51025},[],"`OU`: organizational unit.",{"_3173":1751,"_28139":1705,"_19503":51027,"_5":13343,"_25626":50898,"_2668":51028},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3173":1752,"_28139":1705,"_19503":51030,"_5":13343,"_25626":50902,"_2668":51031},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3173":1753,"_28139":1705,"_19503":51033,"_5":13343,"_25626":50902,"_2668":51034},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3173":1754,"_28139":1705,"_19503":51036,"_5":13343,"_25626":50906,"_2668":51037},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3173":1755,"_28139":1705,"_19503":51039,"_5":13343,"_25626":50906,"_2668":51040},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3173":1756,"_28139":1705,"_19503":51042,"_5":13343,"_25626":50910,"_2668":51043},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3173":1757,"_28139":1705,"_19503":51045,"_5":13343,"_25626":50910,"_2668":51046},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3173":1758,"_28139":1705,"_19503":51048,"_5":13343,"_25626":50914,"_2668":51049},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3173":1759,"_28139":1705,"_19503":51051,"_5":13343,"_25626":50918,"_2668":51052},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3173":1760,"_28139":1705,"_19503":51054,"_5":13343,"_25626":50922,"_2668":51055},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3173":1761,"_28139":1705,"_19503":51057,"_5":13343,"_25626":50926,"_2668":51058},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3173":1762,"_28139":1705,"_19503":51060,"_5":13343,"_25626":50930,"_2668":51061},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3173":1763,"_28139":1705,"_19503":51063,"_5":13343,"_25626":50930,"_2668":51064},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3173":1764,"_28139":1705,"_19503":51066,"_5":13343,"_25626":50934,"_2668":51067},[],"Open a CA from the inventory to review:",{"_3173":1765,"_28139":1705,"_19503":51069,"_5":13343,"_25626":50934,"_2668":51070},[],"Status and validity period.",{"_3173":1766,"_28139":1705,"_19503":51072,"_5":13343,"_25626":50934,"_2668":51073},[],"Certificate and chain in PEM format.",{"_3173":1767,"_28139":1705,"_19503":51075,"_5":13343,"_25626":50934,"_2668":51076},[],"Number of active, expired and revoked certificates.",{"_3173":1768,"_28139":1705,"_19503":51078,"_5":13343,"_25626":50934,"_2668":51079},[],"Certificates issued in **Issued Certificates**.",{"_3173":1769,"_28139":1705,"_19503":51081,"_5":13343,"_25626":50934,"_2668":51082},[],"The CRL linked to the authority.",{"_3173":1770,"_28139":1705,"_19503":51084,"_5":13343,"_25626":50934,"_2668":51085},[],"Metadata and the associated cryptographic engine.",{"_3173":1771,"_28139":1705,"_19503":51087,"_5":13343,"_25626":50934,"_2668":51088},[],"You can filter the inventory by name, status and CA type.",{"_3173":1772,"_28139":1705,"_19503":51090,"_5":13343,"_25626":50938,"_2668":51091},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3173":1773,"_28139":1705,"_19503":51093,"_5":13343,"_25626":50938,"_2668":51094},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3173":1774,"_28139":1705,"_19503":51096,"_5":13343,"_25626":50938,"_2668":51097},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3173":1775,"_28139":1705,"_19503":51099,"_5":13343,"_25626":50938,"_2668":51100},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3173":1776,"_28139":1705,"_19503":51102,"_5":13343,"_25626":50942,"_2668":51103},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3173":1777,"_28139":1705,"_19503":51105,"_5":13343,"_25626":50946,"_2668":51106},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3173":1778,"_28139":1705,"_19503":51108,"_5":13343,"_25626":50950,"_2668":51109},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3173":1779,"_28139":1705,"_19503":51111,"_5":13343,"_25626":50954,"_2668":51112},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3173":1780,"_28139":1705,"_19503":51114,"_5":13343,"_25626":50958,"_2668":51115},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3173":1781,"_28139":1705,"_19503":51117,"_5":13343,"_25626":50958,"_2668":51118},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_3173":1782,"_28139":1782,"_5":13674,"_2668":51120,"_28481":51121,"_19503":51122,"_25626":1782},"Certificate profiles",[45572,46965,50707,50708],[],{"_3173":1783,"_28139":1782,"_19503":51124,"_5":13343,"_25626":1782,"_2668":51125},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3173":1784,"_28139":1782,"_5":28478,"_19503":51127,"_25626":51128,"_2668":51129},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3173":1785,"_28139":1782,"_5":28478,"_19503":51131,"_25626":51132,"_2668":51133},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#validity","Validity",{"_3173":1786,"_28139":1782,"_5":28478,"_19503":51135,"_25626":51136,"_2668":51137},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3173":1787,"_28139":1782,"_5":28478,"_19503":51139,"_25626":51140,"_2668":51141},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3173":1788,"_28139":1782,"_5":28478,"_19503":51143,"_25626":51144,"_2668":51145},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#subject","Subject",{"_3173":1789,"_28139":1782,"_5":28478,"_19503":51147,"_25626":51148,"_2668":51149},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3173":1790,"_28139":1782,"_5":28478,"_19503":51151,"_25626":51152,"_2668":51153},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3173":1791,"_28139":1782,"_5":28478,"_19503":51155,"_25626":51156,"_2668":51157},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3173":1792,"_28139":1782,"_5":28478,"_19503":51159,"_25626":51160,"_2668":51161},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3173":1793,"_28139":1782,"_5":28478,"_19503":51163,"_25626":51164,"_2668":51165},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3173":1794,"_28139":1782,"_5":28478,"_19503":51167,"_25626":51168,"_2668":51169},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3173":1795,"_28139":1782,"_5":28478,"_19503":51171,"_25626":51172,"_2668":51173},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3173":1796,"_28139":1782,"_5":28478,"_19503":51175,"_25626":51176,"_2668":51177},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3173":1797,"_28139":1782,"_5":28478,"_19503":51179,"_25626":51180,"_2668":51181},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3173":1798,"_28139":1782,"_5":28478,"_19503":51183,"_25626":51184,"_2668":51185},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#design-examples","Design examples",{"_3173":1799,"_28139":1782,"_5":28478,"_19503":51187,"_25626":51188,"_2668":51189},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3173":1800,"_28139":1782,"_19503":51191,"_5":13343,"_25626":1782,"_2668":51192},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3173":1801,"_28139":1782,"_19503":51194,"_5":13343,"_25626":1782,"_2668":51195},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3173":1802,"_28139":1782,"_19503":51197,"_5":13343,"_25626":51132,"_2668":51198},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3173":1803,"_28139":1782,"_19503":51200,"_5":13343,"_25626":51132,"_2668":51201},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3173":1804,"_28139":1782,"_19503":51203,"_5":13343,"_25626":51136,"_2668":51204},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3173":1805,"_28139":1782,"_19503":51206,"_5":13343,"_25626":51140,"_2668":51207},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3173":1806,"_28139":1782,"_19503":51209,"_5":13343,"_25626":51140,"_2668":51210},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3173":1807,"_28139":1782,"_19503":51212,"_5":13343,"_25626":51140,"_2668":51213},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3173":1808,"_28139":1782,"_19503":51215,"_5":13343,"_25626":51144,"_2668":51216},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3173":1809,"_28139":1782,"_19503":51218,"_5":13343,"_25626":51148,"_2668":51219},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3173":1810,"_28139":1782,"_19503":51221,"_5":13343,"_25626":51148,"_2668":51222},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3173":1811,"_28139":1782,"_19503":51224,"_5":13343,"_25626":51152,"_2668":51225},[],"The cryptographic enforcement can:",{"_3173":1812,"_28139":1782,"_19503":51227,"_5":13343,"_25626":51152,"_2668":51228},[],"allow or block RSA keys;",{"_3173":1813,"_28139":1782,"_19503":51230,"_5":13343,"_25626":51152,"_2668":51231},[],"limit the supported RSA sizes;",{"_3173":1814,"_28139":1782,"_19503":51233,"_5":13343,"_25626":51152,"_2668":51234},[],"allow or block ECDSA keys;",{"_3173":1815,"_28139":1782,"_19503":51236,"_5":13343,"_25626":51152,"_2668":51237},[],"limit the supported ECDSA sizes or curves.",{"_3173":1816,"_28139":1782,"_19503":51239,"_5":13343,"_25626":51152,"_2668":51240},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3173":1817,"_28139":1782,"_19503":51242,"_5":13343,"_25626":51156,"_2668":51243},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3173":1818,"_28139":1782,"_19503":51245,"_5":13343,"_25626":51156,"_2668":48726},[],{"_3173":1819,"_28139":1782,"_19503":51247,"_5":13343,"_25626":51156,"_2668":51248},[],"First choice",{"_3173":1820,"_28139":1782,"_19503":51250,"_5":13343,"_25626":51156,"_2668":51251},[],"Second choice",{"_3173":1821,"_28139":1782,"_19503":51253,"_5":13343,"_25626":51156,"_2668":51254},[],"If neither is supplied",{"_3173":1822,"_28139":1782,"_19503":51256,"_5":13343,"_25626":51156,"_2668":51257},[],"Direct signing with a CA",{"_3173":1823,"_28139":1782,"_19503":51259,"_5":13343,"_25626":51156,"_2668":51260},[],"`issuance_profile` embedded in the request",{"_3173":1824,"_28139":1782,"_19503":51262,"_5":13343,"_25626":51156,"_2668":51263},[],"Request `issuance_profile_id`",{"_3173":1825,"_28139":1782,"_19503":51265,"_5":13343,"_25626":51156,"_2668":51266},[],"CA default profile (`profile_id`).",{"_3173":1826,"_28139":1782,"_19503":51268,"_5":13343,"_25626":51156,"_2668":51269},[],"Issuance through a DMS",{"_3173":1827,"_28139":1782,"_19503":51271,"_5":13343,"_25626":51156,"_2668":51272},[],"`settings.issuance_profile_id`",{"_3173":1828,"_28139":1782,"_19503":51274,"_5":13343,"_25626":51156,"_2668":51275},[],"`settings.issuance_profile` embedded in the DMS",{"_3173":1829,"_28139":1782,"_19503":51277,"_5":13343,"_25626":51156,"_2668":51278},[],"Enrollment CA default profile.",{"_3173":1830,"_28139":1782,"_19503":51280,"_5":13343,"_25626":51156,"_2668":51281},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3173":1831,"_28139":1782,"_19503":51283,"_5":13343,"_25626":51156,"_2668":51284},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3173":1832,"_28139":1782,"_19503":51286,"_5":13343,"_25626":51164,"_2668":51287},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3173":1833,"_28139":1782,"_19503":51289,"_5":13343,"_25626":51168,"_2668":51290},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3173":1834,"_28139":1782,"_19503":51292,"_5":13343,"_25626":51172,"_2668":51293},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3173":1835,"_28139":1782,"_19503":51295,"_5":13343,"_25626":51176,"_2668":51296},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3173":1836,"_28139":1782,"_19503":51298,"_5":13343,"_25626":51180,"_2668":51299},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3173":1837,"_28139":1782,"_19503":51301,"_5":13343,"_25626":51180,"_2668":51302},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3173":1838,"_28139":1782,"_19503":51304,"_5":13343,"_25626":51184,"_2668":51305},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3173":1839,"_28139":1782,"_19503":51307,"_5":13343,"_25626":51184,"_2668":51308},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3173":1840,"_28139":1782,"_19503":51310,"_5":13343,"_25626":51184,"_2668":51311},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3173":1841,"_28139":1782,"_19503":51313,"_5":13343,"_25626":51184,"_2668":51314},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3173":1842,"_28139":1782,"_19503":51316,"_5":13343,"_25626":51188,"_2668":51317},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3173":1843,"_28139":1782,"_19503":51319,"_5":13343,"_25626":51188,"_2668":51320},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3173":1844,"_28139":1844,"_5":13674,"_2668":51322,"_28481":51323,"_19503":51325,"_25626":1844},"Certificate validation",[45572,46965,50707,51324],"Validation",[],{"_3173":1845,"_28139":1844,"_19503":51327,"_5":13343,"_25626":1844,"_2668":51328},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3173":1846,"_28139":1844,"_5":28478,"_19503":51330,"_25626":51331,"_2668":51332},[],"/docs/pr-preview/pr-43/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3173":1847,"_28139":1844,"_5":28478,"_19503":51334,"_25626":51335,"_2668":51336},[],"/docs/pr-preview/pr-43/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3173":1848,"_28139":1844,"_5":28478,"_19503":51338,"_25626":51339,"_2668":51340},[],"/docs/pr-preview/pr-43/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3173":1849,"_28139":1844,"_19503":51342,"_5":13343,"_25626":1844,"_2668":51343},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3173":1850,"_28139":1844,"_19503":51345,"_5":13343,"_25626":51331,"_2668":51346},[],"Verify these criteria together:",{"_3173":1851,"_28139":1844,"_19503":51348,"_5":13343,"_25626":51331,"_2668":50331},[],{"_3173":1852,"_28139":1844,"_19503":51350,"_5":13343,"_25626":51331,"_2668":51351},[],"Required result",{"_3173":1853,"_28139":1844,"_19503":51353,"_5":13343,"_25626":51331,"_2668":51354},[],"Chain and signature",{"_3173":1854,"_28139":1844,"_19503":51356,"_5":13343,"_25626":51331,"_2668":51357},[],"Valid chain to a root deliberately installed in the consumer.",{"_3173":1855,"_28139":1844,"_19503":51359,"_5":13343,"_25626":51331,"_2668":51360},[],"Dates",{"_3173":1856,"_28139":1844,"_19503":51362,"_5":13343,"_25626":51331,"_2668":51363},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3173":1857,"_28139":1844,"_19503":51365,"_5":13343,"_25626":51331,"_2668":46662},[],{"_3173":1858,"_28139":1844,"_19503":51367,"_5":13343,"_25626":51331,"_2668":51368},[],"Name, SAN or identifier matches the expected peer.",{"_3173":1859,"_28139":1844,"_19503":51370,"_5":13343,"_25626":51331,"_2668":45962},[],{"_3173":1860,"_28139":1844,"_19503":51372,"_5":13343,"_25626":51331,"_2668":51373},[],"KU, EKU and constraints permit the specific operation.",{"_3173":1861,"_28139":1844,"_19503":51375,"_5":13343,"_25626":51331,"_2668":51376},[],"Revocation",{"_3173":1862,"_28139":1844,"_19503":51378,"_5":13343,"_25626":51331,"_2668":51379},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3173":1863,"_28139":1844,"_19503":51381,"_5":13343,"_25626":51331,"_2668":51382},[],"Authorization",{"_3173":1864,"_28139":1844,"_19503":51384,"_5":13343,"_25626":51331,"_2668":51385},[],"The application permits that identity to perform the action.",{"_3173":1865,"_28139":1844,"_19503":51387,"_5":13343,"_25626":51331,"_2668":51388},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3173":1866,"_28139":1844,"_19503":51390,"_5":13343,"_25626":51335,"_2668":51391},[],"Mechanism",{"_3173":1867,"_28139":1844,"_19503":51393,"_5":13343,"_25626":51335,"_2668":51394},[],"When to use it",{"_3173":1868,"_28139":1844,"_19503":51396,"_5":13343,"_25626":51335,"_2668":51397},[],"What you must maintain",{"_3173":1869,"_28139":1844,"_19503":51399,"_5":13343,"_25626":51335,"_2668":51400},[],"OCSP",{"_3173":1870,"_28139":1844,"_19503":51402,"_5":13343,"_25626":51335,"_2668":51403},[],"Status query for a specific certificate.",{"_3173":1871,"_28139":1844,"_19503":51405,"_5":13343,"_25626":51335,"_2668":51406},[],"Responder access, signature verification and cache/freshness policy.",{"_3173":1872,"_28139":1844,"_19503":51408,"_5":13343,"_25626":51335,"_2668":51409},[],"CRL",{"_3173":1873,"_28139":1844,"_19503":51411,"_5":13343,"_25626":51335,"_2668":51412},[],"Local checks for many certificates or offline operation.",{"_3173":1874,"_28139":1844,"_19503":51414,"_5":13343,"_25626":51335,"_2668":51415},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3173":1875,"_28139":1844,"_19503":51417,"_5":13343,"_25626":51335,"_2668":51418},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3173":1876,"_28139":1844,"_19503":51420,"_5":13343,"_25626":51335,"_2668":51421},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3173":1877,"_28139":1844,"_19503":51423,"_5":13343,"_25626":51339,"_2668":51424},[],"Accept a current, authorized certificate with a known chain.",{"_3173":1878,"_28139":1844,"_19503":51426,"_5":13343,"_25626":51339,"_2668":51427},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3173":1879,"_28139":1844,"_19503":51429,"_5":13343,"_25626":51339,"_2668":51430},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3173":1880,"_28139":1844,"_19503":51432,"_5":13343,"_25626":51339,"_2668":51433},[],"Check that a new connection with that identity is rejected.",{"_3173":1881,"_28139":1844,"_19503":51435,"_5":13343,"_25626":51339,"_2668":51436},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3173":1882,"_28139":1844,"_19503":51438,"_5":13343,"_25626":51339,"_2668":51439},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3173":1883,"_28139":1844,"_19503":51441,"_5":13343,"_25626":51339,"_2668":51442},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3173":1884,"_28139":1844,"_19503":51444,"_5":13343,"_25626":51339,"_2668":51445},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3173":1885,"_28139":1844,"_19503":51447,"_5":13343,"_25626":51339,"_2668":51448},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3173":1886,"_28139":1886,"_5":13674,"_2668":51450,"_28481":51451,"_19503":51452,"_25626":1886},"Certificates",[45572,46965,50707,50708],[],{"_3173":1887,"_28139":1886,"_19503":51454,"_5":13343,"_25626":1886,"_2668":51455},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3173":1888,"_28139":1886,"_5":28478,"_19503":51457,"_25626":51458,"_2668":51459},[],"/docs/pr-preview/pr-43/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3173":1889,"_28139":1886,"_5":28478,"_19503":51461,"_25626":51462,"_2668":51463},[],"/docs/pr-preview/pr-43/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3173":1890,"_28139":1886,"_5":28478,"_19503":51465,"_25626":51466,"_2668":51467},[],"/docs/pr-preview/pr-43/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3173":1891,"_28139":1886,"_5":28478,"_19503":51469,"_25626":51470,"_2668":51471},[],"/docs/pr-preview/pr-43/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3173":1892,"_28139":1886,"_5":28478,"_19503":51473,"_25626":51474,"_2668":51475},[],"/docs/pr-preview/pr-43/platform/pki/certificates#open-the-action","Open the action",{"_3173":1893,"_28139":1886,"_5":28478,"_19503":51477,"_25626":51478,"_2668":51479},[],"/docs/pr-preview/pr-43/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3173":1894,"_28139":1886,"_5":28478,"_19503":51481,"_25626":51482,"_2668":51483},[],"/docs/pr-preview/pr-43/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3173":1895,"_28139":1886,"_5":28478,"_19503":51485,"_25626":51486,"_2668":51487},[],"/docs/pr-preview/pr-43/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3173":1896,"_28139":1886,"_5":28478,"_19503":51489,"_25626":51490,"_2668":51491},[],"/docs/pr-preview/pr-43/platform/pki/certificates#continue","Continue",{"_3173":1897,"_28139":1886,"_19503":51493,"_5":13343,"_25626":1886,"_2668":51494},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3173":1898,"_28139":1886,"_19503":51496,"_5":13343,"_25626":51458,"_2668":51497},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3173":1899,"_28139":1886,"_19503":51499,"_5":13343,"_25626":51458,"_2668":51500},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3173":1900,"_28139":1886,"_19503":51502,"_5":13343,"_25626":51462,"_2668":51503},[],"Download the PEM and inspect it:",{"_3173":1901,"_28139":1886,"_19503":51505,"_5":13343,"_25626":51462,"_2668":51506},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3173":1902,"_28139":1886,"_19503":51508,"_5":13343,"_25626":51466,"_2668":51509},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3173":1903,"_28139":1886,"_19503":51511,"_5":13343,"_25626":51466,"_2668":51512},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3173":1904,"_28139":1886,"_19503":51514,"_5":13343,"_25626":51466,"_2668":51515},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3173":1905,"_28139":1886,"_19503":51517,"_5":13343,"_25626":51466,"_2668":51518},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3173":1906,"_28139":1886,"_19503":51520,"_5":13343,"_25626":51466,"_2668":51521},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3173":1907,"_28139":1886,"_19503":51523,"_5":13343,"_25626":51466,"_2668":51524},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3173":1908,"_28139":1886,"_19503":51526,"_5":13343,"_25626":51466,"_2668":51527},[],"For browser key generation, follow Issue your first certificate.",{"_3173":1909,"_28139":1886,"_19503":51529,"_5":13343,"_25626":51470,"_2668":51530},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3173":1910,"_28139":1886,"_19503":51532,"_5":13343,"_25626":51474,"_2668":51533},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3173":1911,"_28139":1886,"_19503":51535,"_5":13343,"_25626":51478,"_2668":51536},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3173":1912,"_28139":1886,"_19503":51538,"_5":13343,"_25626":51482,"_2668":51539},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3173":1913,"_28139":1886,"_19503":51541,"_5":13343,"_25626":51482,"_2668":51542},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3173":1914,"_28139":1886,"_19503":51544,"_5":13343,"_25626":51482,"_2668":51545},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3173":1915,"_28139":1886,"_19503":51547,"_5":13343,"_25626":51486,"_2668":51548},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3173":1916,"_28139":1886,"_19503":51550,"_5":13343,"_25626":51486,"_2668":51551},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3173":1917,"_28139":1886,"_19503":51553,"_5":13343,"_25626":51486,"_2668":51554},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3173":1918,"_28139":1886,"_19503":51556,"_5":13343,"_25626":51490,"_2668":51557},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3173":1919,"_28139":1886,"_19503":51559,"_5":13343,"_25626":51490,"_2668":51560},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3173":1920,"_28139":1920,"_5":13674,"_2668":51562,"_28481":51563,"_19503":51565,"_25626":1920},"Certificate lifecycle",[45572,46965,50707,51564],"Concepts",[],{"_3173":1921,"_28139":1920,"_19503":51567,"_5":13343,"_25626":1920,"_2668":51568},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3173":1922,"_28139":1920,"_5":28478,"_19503":51570,"_25626":51571,"_2668":51572},[],"/docs/pr-preview/pr-43/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3173":1923,"_28139":1920,"_5":28478,"_19503":51574,"_25626":51575,"_2668":51576},[],"/docs/pr-preview/pr-43/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3173":1924,"_28139":1920,"_5":28478,"_19503":51578,"_25626":51579,"_2668":51580},[],"/docs/pr-preview/pr-43/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3173":1925,"_28139":1920,"_5":28478,"_19503":51582,"_25626":51583,"_2668":51584},[],"/docs/pr-preview/pr-43/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3173":1926,"_28139":1920,"_5":28478,"_19503":51586,"_25626":51587,"_2668":51588},[],"/docs/pr-preview/pr-43/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3173":1927,"_28139":1920,"_5":28478,"_19503":51590,"_25626":51591,"_2668":51592},[],"/docs/pr-preview/pr-43/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3173":1928,"_28139":1920,"_5":28478,"_19503":51594,"_25626":51595,"_2668":51596},[],"/docs/pr-preview/pr-43/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3173":1929,"_28139":1920,"_5":28478,"_19503":51598,"_25626":51599,"_2668":51600},[],"/docs/pr-preview/pr-43/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3173":1930,"_28139":1920,"_5":28478,"_19503":51602,"_25626":51603,"_2668":51604},[],"/docs/pr-preview/pr-43/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3173":1931,"_28139":1920,"_5":28478,"_19503":51606,"_25626":51607,"_2668":51608},[],"/docs/pr-preview/pr-43/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3173":1932,"_28139":1920,"_19503":51610,"_5":13343,"_25626":1920,"_2668":51611},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3173":1933,"_28139":1920,"_19503":51613,"_5":13343,"_25626":51575,"_2668":51614},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3173":1934,"_28139":1920,"_19503":51616,"_5":13343,"_25626":51579,"_2668":51617},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3173":1935,"_28139":1920,"_19503":51619,"_5":13343,"_25626":51583,"_2668":51620},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3173":1936,"_28139":1920,"_19503":51622,"_5":13343,"_25626":51587,"_2668":51623},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3173":1937,"_28139":1920,"_19503":51625,"_5":13343,"_25626":51591,"_2668":51626},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3173":1938,"_28139":1920,"_19503":51628,"_5":13343,"_25626":51595,"_2668":51629},[],"Lamassu persists four X.509 states:",{"_3173":1939,"_28139":1920,"_19503":51631,"_5":13343,"_25626":51595,"_2668":51632},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3173":1940,"_28139":1920,"_19503":51634,"_5":13343,"_25626":51595,"_2668":51635},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3173":1941,"_28139":1920,"_19503":51637,"_5":13343,"_25626":51595,"_2668":51638},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3173":1942,"_28139":1920,"_19503":51640,"_5":13343,"_25626":51595,"_2668":51641},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3173":1943,"_28139":1920,"_19503":51643,"_5":13343,"_25626":51595,"_2668":51644},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3173":1944,"_28139":1920,"_19503":51646,"_5":13343,"_25626":51599,"_2668":51647},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3173":1945,"_28139":1920,"_19503":51649,"_5":13343,"_25626":51599,"_2668":51650},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3173":1946,"_28139":1920,"_19503":51652,"_5":13343,"_25626":51599,"_2668":51653},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3173":1947,"_28139":1920,"_19503":51655,"_5":13343,"_25626":51603,"_2668":51656},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3173":1948,"_28139":1920,"_19503":51658,"_5":13343,"_25626":51603,"_2668":51659},[],"Before confirming:",{"_3173":1949,"_28139":1920,"_19503":51661,"_5":13343,"_25626":51603,"_2668":51662},[],"Identify DMSs, devices and services that trust that chain.",{"_3173":1950,"_28139":1920,"_19503":51664,"_5":13343,"_25626":51603,"_2668":51665},[],"Distribute the new chain of trust.",{"_3173":1951,"_28139":1920,"_19503":51667,"_5":13343,"_25626":51603,"_2668":51668},[],"Reissue the necessary identities.",{"_3173":1952,"_28139":1920,"_19503":51670,"_5":13343,"_25626":51603,"_2668":51671},[],"Check OCSP and CRL from a real consumer.",{"_3173":1953,"_28139":1920,"_19503":51673,"_5":13343,"_25626":51603,"_2668":51674},[],"Revoke the old CA once no legitimate traffic remains.",{"_3173":1954,"_28139":1920,"_19503":51676,"_5":13343,"_25626":51603,"_2668":51677},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3173":1955,"_28139":1920,"_19503":51679,"_5":13343,"_25626":51607,"_2668":51680},[],"Certificates entering the preventive or critical renewal window.",{"_3173":1956,"_28139":1920,"_19503":51682,"_5":13343,"_25626":51607,"_2668":51683},[],"Repeated enrollment or re-enrollment failures.",{"_3173":1957,"_28139":1920,"_19503":51685,"_5":13343,"_25626":51607,"_2668":51686},[],"Status changes and revocation reasons.",{"_3173":1958,"_28139":1920,"_19503":51688,"_5":13343,"_25626":51607,"_2668":51689},[],"OCSP and CRL publication and validity.",{"_3173":1959,"_28139":1920,"_19503":51691,"_5":13343,"_25626":51607,"_2668":51692},[],"Dependencies still presenting a replaced certificate.",{"_3173":1960,"_28139":1920,"_19503":51694,"_5":13343,"_25626":51607,"_2668":51695},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3173":1961,"_28139":1961,"_5":13674,"_2668":51697,"_28481":51698,"_19503":51699,"_25626":1961},"Trust model",[45572,46965,50707,51564],[],{"_3173":1962,"_28139":1961,"_19503":51701,"_5":13343,"_25626":1961,"_2668":51702},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3173":1963,"_28139":1961,"_5":28478,"_19503":51704,"_25626":51705,"_2668":51706},[],"/docs/pr-preview/pr-43/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3173":1964,"_28139":1961,"_5":28478,"_19503":51708,"_25626":51709,"_2668":51710},[],"/docs/pr-preview/pr-43/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3173":1965,"_28139":1961,"_5":28478,"_19503":51712,"_25626":51713,"_2668":51714},[],"/docs/pr-preview/pr-43/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3173":1966,"_28139":1961,"_5":28478,"_19503":51716,"_25626":51717,"_2668":51718},[],"/docs/pr-preview/pr-43/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3173":1967,"_28139":1961,"_5":28478,"_19503":51720,"_25626":51721,"_2668":51722},[],"/docs/pr-preview/pr-43/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3173":1968,"_28139":1961,"_5":28478,"_19503":51724,"_25626":51725,"_2668":51726},[],"/docs/pr-preview/pr-43/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3173":1969,"_28139":1961,"_5":28478,"_19503":51728,"_25626":51729,"_2668":51730},[],"/docs/pr-preview/pr-43/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3173":1970,"_28139":1961,"_5":28478,"_19503":51732,"_25626":51733,"_2668":51734},[],"/docs/pr-preview/pr-43/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3173":1971,"_28139":1961,"_5":28478,"_19503":51736,"_25626":51737,"_2668":51738},[],"/docs/pr-preview/pr-43/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3173":1972,"_28139":1961,"_5":28478,"_19503":51740,"_25626":51741,"_2668":51742},[],"/docs/pr-preview/pr-43/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3173":1973,"_28139":1961,"_19503":51744,"_5":13343,"_25626":1961,"_2668":51745},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3173":1974,"_28139":1961,"_19503":51747,"_5":13343,"_25626":51709,"_2668":51748},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3173":1975,"_28139":1961,"_19503":51750,"_5":13343,"_25626":51713,"_2668":51751},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3173":1976,"_28139":1961,"_19503":51753,"_5":13343,"_25626":51717,"_2668":51754},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3173":1977,"_28139":1961,"_19503":51756,"_5":13343,"_25626":51721,"_2668":51757},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3173":1978,"_28139":1961,"_19503":51759,"_5":13343,"_25626":51725,"_2668":51760},[],"The device proves it can enroll according to the DMS policy.",{"_3173":1979,"_28139":1961,"_19503":51762,"_5":13343,"_25626":51725,"_2668":51763},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3173":1980,"_28139":1961,"_19503":51765,"_5":13343,"_25626":51725,"_2668":51766},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3173":1981,"_28139":1961,"_19503":51768,"_5":13343,"_25626":51725,"_2668":51769},[],"The device installs the certificate and the chain it needs.",{"_3173":1982,"_28139":1961,"_19503":51771,"_5":13343,"_25626":51725,"_2668":51772},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3173":1983,"_28139":1961,"_19503":51774,"_5":13343,"_25626":51725,"_2668":51775},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3173":1984,"_28139":1961,"_19503":51777,"_5":13343,"_25626":51729,"_2668":51778},[],"A DMS relates three sets that are worth designing separately:",{"_3173":1985,"_28139":1961,"_19503":51780,"_5":13343,"_25626":51729,"_2668":51781},[],"**Enrollment CA:** signs the new identities.",{"_3173":1986,"_28139":1961,"_19503":51783,"_5":13343,"_25626":51729,"_2668":51784},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3173":1987,"_28139":1961,"_19503":51786,"_5":13343,"_25626":51729,"_2668":51787},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3173":1988,"_28139":1961,"_19503":51789,"_5":13343,"_25626":51729,"_2668":51790},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3173":1989,"_28139":1961,"_19503":51792,"_5":13343,"_25626":51733,"_2668":51793},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3173":1990,"_28139":1961,"_19503":51795,"_5":13343,"_25626":51733,"_2668":51796},[],"that the current date is between `Not Before` and `Not After`;",{"_3173":1991,"_28139":1961,"_19503":51798,"_5":13343,"_25626":51733,"_2668":51799},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3173":1992,"_28139":1961,"_19503":51801,"_5":13343,"_25626":51733,"_2668":51802},[],"that names, SANs and subject match the expected identity;",{"_3173":1993,"_28139":1961,"_19503":51804,"_5":13343,"_25626":51733,"_2668":51805},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3173":1994,"_28139":1961,"_19503":51807,"_5":13343,"_25626":51733,"_2668":51808},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3173":1995,"_28139":1961,"_19503":51810,"_5":13343,"_25626":51733,"_2668":51811},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3173":1996,"_28139":1961,"_19503":51813,"_5":13343,"_25626":51737,"_2668":51814},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3173":1997,"_28139":1961,"_19503":51816,"_5":13343,"_25626":51741,"_2668":51817},[],"Keep the root out of daily operations, or with very restricted access.",{"_3173":1998,"_28139":1961,"_19503":51819,"_5":13343,"_25626":51741,"_2668":51820},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3173":1999,"_28139":1961,"_19503":51822,"_5":13343,"_25626":51741,"_2668":51823},[],"Assign explicit profiles to every use case.",{"_3173":2000,"_28139":1961,"_19503":51825,"_5":13343,"_25626":51741,"_2668":51826},[],"Distribute the new trust before starting a rotation.",{"_3173":2001,"_28139":1961,"_19503":51828,"_5":13343,"_25626":51741,"_2668":51829},[],"Keep enough overlap to renew a disconnected fleet.",{"_3173":2002,"_28139":1961,"_19503":51831,"_5":13343,"_25626":51741,"_2668":51832},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3173":2003,"_28139":1961,"_19503":51834,"_5":13343,"_25626":51741,"_2668":51835},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3173":2004,"_28139":2004,"_5":13674,"_2668":51837,"_28481":51838,"_19503":51839,"_25626":2004},"Revocation lists (CRL)",[45572,46965,50707,51324],[],{"_3173":2005,"_28139":2004,"_19503":51841,"_5":13343,"_25626":2004,"_2668":51842},[],"Generate and distribute signed lists to validate certificates offline.",{"_3173":2006,"_28139":2004,"_5":28478,"_19503":51844,"_25626":51845,"_2668":51846},[],"/docs/pr-preview/pr-43/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_3173":2007,"_28139":2004,"_5":28478,"_19503":51848,"_25626":51849,"_2668":51850},[],"/docs/pr-preview/pr-43/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3173":2008,"_28139":2004,"_5":28478,"_19503":51852,"_25626":51853,"_2668":51854},[],"/docs/pr-preview/pr-43/platform/pki/crl#crl-contents","CRL contents",{"_3173":2009,"_28139":2004,"_5":28478,"_19503":51856,"_25626":51857,"_2668":51858},[],"/docs/pr-preview/pr-43/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3173":2010,"_28139":2004,"_5":28478,"_19503":51860,"_25626":51861,"_2668":51862},[],"/docs/pr-preview/pr-43/platform/pki/crl#va-role-management-api","VA role management API",{"_3173":2011,"_28139":2004,"_5":28478,"_19503":51864,"_25626":51865,"_2668":51866},[],"/docs/pr-preview/pr-43/platform/pki/crl#from-the-interface","From the interface",{"_3173":2012,"_28139":2004,"_5":28478,"_19503":51868,"_25626":51869,"_2668":51870},[],"/docs/pr-preview/pr-43/platform/pki/crl#references","References",{"_3173":2013,"_28139":2004,"_19503":51872,"_5":13343,"_25626":2004,"_2668":51873},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3173":2014,"_28139":2004,"_19503":51875,"_5":13343,"_25626":51845,"_2668":51876},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3173":2015,"_28139":2004,"_19503":51878,"_5":13343,"_25626":51845,"_2668":51879},[],"`crl_options` field",{"_3173":2016,"_28139":2004,"_19503":51881,"_5":13343,"_25626":51845,"_2668":45962},[],{"_3173":2017,"_28139":2004,"_19503":51883,"_5":13343,"_25626":51845,"_2668":51884},[],"Backend initial value",{"_3173":2018,"_28139":2004,"_19503":51886,"_5":13343,"_25626":51845,"_2668":51887},[],"`validity`",{"_3173":2019,"_28139":2004,"_19503":51889,"_5":13343,"_25626":51845,"_2668":51890},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3173":2020,"_28139":2004,"_19503":51892,"_5":13343,"_25626":51845,"_2668":51893},[],"7 days.",{"_3173":2021,"_28139":2004,"_19503":51895,"_5":13343,"_25626":51845,"_2668":51896},[],"`refresh_interval`",{"_3173":2022,"_28139":2004,"_19503":51898,"_5":13343,"_25626":51845,"_2668":51899},[],"Time since publication that triggers scheduled renewal.",{"_3173":2023,"_28139":2004,"_19503":51901,"_5":13343,"_25626":51845,"_2668":51902},[],"6 days and 23 hours.",{"_3173":2024,"_28139":2004,"_19503":51904,"_5":13343,"_25626":51845,"_2668":51905},[],"`regenerate_on_revoke`",{"_3173":2025,"_28139":2004,"_19503":51907,"_5":13343,"_25626":51845,"_2668":51908},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3173":2026,"_28139":2004,"_19503":51910,"_5":13343,"_25626":51845,"_2668":51911},[],"`true`.",{"_3173":2027,"_28139":2004,"_19503":51913,"_5":13343,"_25626":51845,"_2668":51914},[],"`subject_key_id_signer`",{"_3173":2028,"_28139":2004,"_19503":51916,"_5":13343,"_25626":51845,"_2668":51917},[],"Configuration field initialized with the CA’s SKI.",{"_3173":2029,"_28139":2004,"_19503":51919,"_5":13343,"_25626":51845,"_2668":51920},[],"CA SKI.",{"_3173":2030,"_28139":2004,"_19503":51922,"_5":13343,"_25626":51845,"_2668":51923},[],"The generator uses the key of the CA identified by the requested SKI. Do not interpret `subject_key_id_signer` as verified support for a different delegated CA: changing that field does not change the signer in this flow.",{"_3173":2031,"_28139":2004,"_19503":51925,"_5":13343,"_25626":51845,"_2668":51926},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_3173":2032,"_28139":2004,"_19503":51928,"_5":13343,"_25626":51849,"_2668":51929},[],"The scheduled job requests another list when `refresh_interval` is reached or when the list approaches expiration within the configured watch period. This depends on working jobs, storage and signing; it does not guarantee renewal during a service failure.",{"_3173":2033,"_28139":2004,"_19503":51931,"_5":13343,"_25626":51849,"_2668":51932},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3173":2034,"_28139":2004,"_19503":51934,"_5":13343,"_25626":51849,"_2668":51935},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3173":2035,"_28139":2004,"_19503":51937,"_5":13343,"_25626":51853,"_2668":51938},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3173":2036,"_28139":2004,"_19503":51940,"_5":13343,"_25626":51853,"_2668":51941},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3173":2037,"_28139":2004,"_19503":51943,"_5":13343,"_25626":51857,"_2668":51944},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_3173":2038,"_28139":2004,"_19503":51946,"_5":13343,"_25626":51857,"_2668":51947},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3173":2039,"_28139":2004,"_19503":51949,"_5":13343,"_25626":51857,"_2668":51950},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3173":2040,"_28139":2004,"_19503":51952,"_5":13343,"_25626":51857,"_2668":51953},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3173":2041,"_28139":2004,"_19503":51955,"_5":13343,"_25626":51857,"_2668":51956},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3173":2042,"_28139":2004,"_19503":51958,"_5":13343,"_25626":51861,"_2668":51959},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3173":2043,"_28139":2004,"_19503":51961,"_5":13343,"_25626":51861,"_2668":48729},[],{"_3173":2044,"_28139":2004,"_19503":51963,"_5":13343,"_25626":51861,"_2668":51964},[],"Relative path",{"_3173":2045,"_28139":2004,"_19503":51966,"_5":13343,"_25626":51861,"_2668":48726},[],{"_3173":2046,"_28139":2004,"_19503":51968,"_5":13343,"_25626":51861,"_2668":51969},[],"`GET`",{"_3173":2047,"_28139":2004,"_19503":51971,"_5":13343,"_25626":51861,"_2668":51972},[],"`/v1/roles/{ca-ski}`",{"_3173":2048,"_28139":2004,"_19503":51974,"_5":13343,"_25626":51861,"_2668":51975},[],"Read `crl_options` and `latest_crl`.",{"_3173":2049,"_28139":2004,"_19503":51977,"_5":13343,"_25626":51861,"_2668":51978},[],"`PUT`",{"_3173":2050,"_28139":2004,"_19503":51980,"_5":13343,"_25626":51861,"_2668":51972},[],{"_3173":2051,"_28139":2004,"_19503":51982,"_5":13343,"_25626":51861,"_2668":51983},[],"Replace CRL configuration.",{"_3173":2052,"_28139":2004,"_19503":51985,"_5":13343,"_25626":51861,"_2668":51986},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_3173":2053,"_28139":2004,"_19503":51988,"_5":13343,"_25626":51861,"_2668":51989},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_3173":2054,"_28139":2004,"_19503":51991,"_5":13343,"_25626":51865,"_2668":51992},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_3173":2055,"_28139":2004,"_19503":51994,"_5":13343,"_25626":51869,"_2668":51995},[],"RFC 5280: X.509 and CRL profile.",{"_3173":2056,"_28139":2004,"_19503":51997,"_5":13343,"_25626":51869,"_2668":51998},[],"OpenSSL: openssl-crl.",{"_3173":2057,"_28139":2004,"_19503":52000,"_5":13343,"_25626":51869,"_2668":52001},[],"OpenSSL: openssl-verify.",{"_3173":2058,"_28139":2004,"_19503":52003,"_5":13343,"_25626":51869,"_2668":52004},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3173":2059,"_28139":2004,"_19503":52006,"_5":13343,"_25626":51869,"_2668":52007},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3173":2060,"_28139":2060,"_5":13674,"_2668":52009,"_28481":52010,"_19503":52011,"_25626":2060},"Keys and cryptographic engines",[45572,46965,50707,50708],[],{"_3173":2061,"_28139":2060,"_19503":52013,"_5":13343,"_25626":2060,"_2668":52014},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3173":2062,"_28139":2060,"_5":28478,"_19503":52016,"_25626":52017,"_2668":52018},[],"/docs/pr-preview/pr-43/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3173":2063,"_28139":2060,"_5":28478,"_19503":52020,"_25626":52021,"_2668":52022},[],"/docs/pr-preview/pr-43/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3173":2064,"_28139":2060,"_5":28478,"_19503":52024,"_25626":52025,"_2668":52026},[],"/docs/pr-preview/pr-43/platform/pki/key-management#file-system","File System",{"_3173":2065,"_28139":2060,"_5":28478,"_19503":52028,"_25626":52029,"_2668":52030},[],"/docs/pr-preview/pr-43/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3173":2066,"_28139":2060,"_5":28478,"_19503":52032,"_25626":52033,"_2668":52034},[],"/docs/pr-preview/pr-43/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3173":2067,"_28139":2060,"_5":28478,"_19503":52036,"_25626":52037,"_2668":52038},[],"/docs/pr-preview/pr-43/platform/pki/key-management#aws-kms","AWS KMS",{"_3173":2068,"_28139":2060,"_5":28478,"_19503":52040,"_25626":52041,"_2668":52042},[],"/docs/pr-preview/pr-43/platform/pki/key-management#pkcs11","PKCS#11",{"_3173":2069,"_28139":2060,"_5":28478,"_19503":52044,"_25626":52045,"_2668":52046},[],"/docs/pr-preview/pr-43/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3173":2070,"_28139":2060,"_5":28478,"_19503":52048,"_25626":52049,"_2668":52050},[],"/docs/pr-preview/pr-43/platform/pki/key-management#key-inventory","Key inventory",{"_3173":2071,"_28139":2060,"_5":28478,"_19503":52052,"_25626":52053,"_2668":52054},[],"/docs/pr-preview/pr-43/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3173":2072,"_28139":2060,"_5":28478,"_19503":52056,"_25626":52057,"_2668":52058},[],"/docs/pr-preview/pr-43/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3173":2073,"_28139":2060,"_5":28478,"_19503":52060,"_25626":52061,"_2668":52062},[],"/docs/pr-preview/pr-43/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3173":2074,"_28139":2060,"_5":28478,"_19503":52064,"_25626":52065,"_2668":52066},[],"/docs/pr-preview/pr-43/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3173":2075,"_28139":2060,"_5":28478,"_19503":52068,"_25626":52069,"_2668":52070},[],"/docs/pr-preview/pr-43/platform/pki/key-management#view-details","View details",{"_3173":2076,"_28139":2060,"_5":28478,"_19503":52072,"_25626":52073,"_2668":52074},[],"/docs/pr-preview/pr-43/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3173":2077,"_28139":2060,"_5":28478,"_19503":52076,"_25626":52077,"_2668":52078},[],"/docs/pr-preview/pr-43/platform/pki/key-management#sign","Sign",{"_3173":2078,"_28139":2060,"_5":28478,"_19503":52080,"_25626":52081,"_2668":52082},[],"/docs/pr-preview/pr-43/platform/pki/key-management#verify","Verify",{"_3173":2079,"_28139":2060,"_5":28478,"_19503":52084,"_25626":52085,"_2668":52086},[],"/docs/pr-preview/pr-43/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3173":2080,"_28139":2060,"_5":28478,"_19503":52088,"_25626":52089,"_2668":52090},[],"/docs/pr-preview/pr-43/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3173":2081,"_28139":2060,"_5":28478,"_19503":52092,"_25626":52093,"_2668":52094},[],"/docs/pr-preview/pr-43/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3173":2082,"_28139":2060,"_19503":52096,"_5":13343,"_25626":2060,"_2668":52097},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3173":2083,"_28139":2060,"_19503":52099,"_5":13343,"_25626":2060,"_2668":52100},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3173":2084,"_28139":2060,"_19503":52102,"_5":13343,"_25626":52017,"_2668":52103},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3173":2085,"_28139":2060,"_19503":52105,"_5":13343,"_25626":52017,"_2668":52106},[],"In practice, it lets you:",{"_3173":2086,"_28139":2060,"_19503":52108,"_5":13343,"_25626":52017,"_2668":52109},[],"Generate new key pairs from Lamassu IoT.",{"_3173":2087,"_28139":2060,"_19503":52111,"_5":13343,"_25626":52017,"_2668":52112},[],"Import keys created externally.",{"_3173":2088,"_28139":2060,"_19503":52114,"_5":13343,"_25626":52017,"_2668":52115},[],"Delegate custody and cryptographic operations to external engines.",{"_3173":2089,"_28139":2060,"_19503":52117,"_5":13343,"_25626":52017,"_2668":52118},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3173":2090,"_28139":2060,"_19503":52120,"_5":13343,"_25626":52021,"_2668":52121},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3173":2091,"_28139":2060,"_19503":52123,"_5":13343,"_25626":52021,"_2668":52124},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3173":2092,"_28139":2060,"_19503":52126,"_5":13343,"_25626":52021,"_2668":52127},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3173":2093,"_28139":2060,"_19503":52129,"_5":13343,"_25626":52025,"_2668":52130},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3173":2094,"_28139":2060,"_19503":52132,"_5":13343,"_25626":52029,"_2668":52133},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3173":2095,"_28139":2060,"_19503":52135,"_5":13343,"_25626":52029,"_2668":52136},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3173":2096,"_28139":2060,"_19503":52138,"_5":13343,"_25626":52033,"_2668":52139},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3173":2097,"_28139":2060,"_19503":52141,"_5":13343,"_25626":52037,"_2668":52142},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3173":2098,"_28139":2060,"_19503":52144,"_5":13343,"_25626":52041,"_2668":52145},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3173":2099,"_28139":2060,"_19503":52147,"_5":13343,"_25626":52045,"_2668":52148},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3173":2100,"_28139":2060,"_19503":52150,"_5":13343,"_25626":52045,"_2668":52151},[],"Lamassu shows the enabled engines in the console.",{"_3173":2101,"_28139":2060,"_19503":52153,"_5":13343,"_25626":52045,"_2668":52154},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3173":2102,"_28139":2060,"_19503":52156,"_5":13343,"_25626":52045,"_2668":52157},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3173":2103,"_28139":2060,"_19503":52159,"_5":13343,"_25626":52049,"_2668":52160},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3173":2104,"_28139":2060,"_19503":52162,"_5":13343,"_25626":52049,"_2668":52163},[],"The table includes the following fields:",{"_3173":2105,"_28139":2060,"_19503":52165,"_5":13343,"_25626":52049,"_2668":52166},[],"**Name**: descriptive name of the key.",{"_3173":2106,"_28139":2060,"_19503":52168,"_5":13343,"_25626":52049,"_2668":52169},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3173":2107,"_28139":2060,"_19503":52171,"_5":13343,"_25626":52049,"_2668":52172},[],"**Strength**: visual indicator of cryptographic strength.",{"_3173":2108,"_28139":2060,"_19503":52174,"_5":13343,"_25626":52049,"_2668":52175},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3173":2109,"_28139":2060,"_19503":52177,"_5":13343,"_25626":52049,"_2668":52178},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3173":2110,"_28139":2060,"_19503":52180,"_5":13343,"_25626":52049,"_2668":52181},[],"**Aliases**: alternative names associated with the key.",{"_3173":2111,"_28139":2060,"_19503":52183,"_5":13343,"_25626":52049,"_2668":52184},[],"**Tags**: labels for classification and search.",{"_3173":2112,"_28139":2060,"_19503":52186,"_5":13343,"_25626":52049,"_2668":52187},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3173":2113,"_28139":2060,"_19503":52189,"_5":13343,"_25626":52049,"_2668":52190},[],"From this view you also reach the most common actions:",{"_3173":2114,"_28139":2060,"_19503":52192,"_5":13343,"_25626":52049,"_2668":52193},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3173":2115,"_28139":2060,"_19503":52195,"_5":13343,"_25626":52049,"_2668":52196},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3173":2116,"_28139":2060,"_19503":52198,"_5":13343,"_25626":52049,"_2668":52199},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3173":2117,"_28139":2060,"_19503":52201,"_5":13343,"_25626":52049,"_2668":52202},[],"**Delete Key** to remove the key from the system.",{"_3173":2118,"_28139":2060,"_19503":52204,"_5":13343,"_25626":52053,"_2668":52205},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3173":2119,"_28139":2060,"_19503":52207,"_5":13343,"_25626":52057,"_2668":52208},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3173":2120,"_28139":2060,"_19503":52210,"_5":13343,"_25626":52057,"_2668":52211},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3173":2121,"_28139":2060,"_19503":52213,"_5":13343,"_25626":52057,"_2668":52214},[],"**Key Name**: unique and descriptive name.",{"_3173":2122,"_28139":2060,"_19503":52216,"_5":13343,"_25626":52057,"_2668":52217},[],"**Crypto Engine**: engine that will keep the key.",{"_3173":2123,"_28139":2060,"_19503":52219,"_5":13343,"_25626":52057,"_2668":52220},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3173":2124,"_28139":2060,"_19503":52222,"_5":13343,"_25626":52057,"_2668":52223},[],"**Tags**: metadata to classify the key.",{"_3173":2125,"_28139":2060,"_19503":52225,"_5":13343,"_25626":52057,"_2668":52226},[],"**Metadata**: additional information for advanced uses.",{"_3173":2126,"_28139":2060,"_19503":52228,"_5":13343,"_25626":52061,"_2668":52229},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3173":2127,"_28139":2060,"_19503":52231,"_5":13343,"_25626":52061,"_2668":52232},[],"When you have an exportable private key and the destination engine supports import.",{"_3173":2128,"_28139":2060,"_19503":52234,"_5":13343,"_25626":52061,"_2668":52235},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3173":2129,"_28139":2060,"_19503":52237,"_5":13343,"_25626":52061,"_2668":52238},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3173":2130,"_28139":2060,"_19503":52240,"_5":13343,"_25626":52061,"_2668":52241},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3173":2131,"_28139":2060,"_19503":52243,"_5":13343,"_25626":52061,"_2668":52244},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3173":2132,"_28139":2060,"_19503":52246,"_5":13343,"_25626":52061,"_2668":52247},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3173":2133,"_28139":2060,"_19503":52249,"_5":13343,"_25626":52061,"_2668":52250},[],"**Tags**: labels for organization and search.",{"_3173":2134,"_28139":2060,"_19503":52252,"_5":13343,"_25626":52061,"_2668":52253},[],"**Metadata**: additional optional information.",{"_3173":2135,"_28139":2060,"_19503":52255,"_5":13343,"_25626":52061,"_2668":52256},[],"**Private Key (PEM)**: private key in PEM format.",{"_3173":2136,"_28139":2060,"_19503":52258,"_5":13343,"_25626":52061,"_2668":52259},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3173":2137,"_28139":2060,"_19503":52261,"_5":13343,"_25626":52065,"_2668":52262},[],"Each registered key has a detail view and several operational actions.",{"_3173":2138,"_28139":2060,"_19503":52264,"_5":13343,"_25626":52069,"_2668":52265},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3173":2139,"_28139":2060,"_19503":52267,"_5":13343,"_25626":52069,"_2668":52268},[],"The **Overview** tab shows, among others, these fields:",{"_3173":2140,"_28139":2060,"_19503":52270,"_5":13343,"_25626":52069,"_2668":52271},[],"**Key Name**: descriptive name.",{"_3173":2141,"_28139":2060,"_19503":52273,"_5":13343,"_25626":52069,"_2668":52274},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3173":2142,"_28139":2060,"_19503":52276,"_5":13343,"_25626":52069,"_2668":52277},[],"**Tags**: associated labels.",{"_3173":2143,"_28139":2060,"_19503":52279,"_5":13343,"_25626":52069,"_2668":52280},[],"**Aliases**: alternative names.",{"_3173":2144,"_28139":2060,"_19503":52282,"_5":13343,"_25626":52069,"_2668":52283},[],"**Crypto Engine**: engine where the key resides.",{"_3173":2145,"_28139":2060,"_19503":52285,"_5":13343,"_25626":52069,"_2668":52286},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3173":2146,"_28139":2060,"_19503":52288,"_5":13343,"_25626":52069,"_2668":52289},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3173":2147,"_28139":2060,"_19503":52291,"_5":13343,"_25626":52069,"_2668":52292},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3173":2148,"_28139":2060,"_19503":52294,"_5":13343,"_25626":52073,"_2668":52295},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3173":2149,"_28139":2060,"_19503":52297,"_5":13343,"_25626":52073,"_2668":52298},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3173":2150,"_28139":2060,"_19503":52300,"_5":13343,"_25626":52073,"_2668":52301},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3173":2151,"_28139":2060,"_19503":52303,"_5":13343,"_25626":52077,"_2668":52304},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3173":2152,"_28139":2060,"_19503":52306,"_5":13343,"_25626":52077,"_2668":52307},[],"Main fields:",{"_3173":2153,"_28139":2060,"_19503":52309,"_5":13343,"_25626":52077,"_2668":52310},[],"**Algorithm**: signing algorithm available for the key type.",{"_3173":2154,"_28139":2060,"_19503":52312,"_5":13343,"_25626":52077,"_2668":52313},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3173":2155,"_28139":2060,"_19503":52315,"_5":13343,"_25626":52077,"_2668":52316},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3173":2156,"_28139":2060,"_19503":52318,"_5":13343,"_25626":52077,"_2668":52319},[],"**Message**: content to sign.",{"_3173":2157,"_28139":2060,"_19503":52321,"_5":13343,"_25626":52077,"_2668":52322},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3173":2158,"_28139":2060,"_19503":52324,"_5":13343,"_25626":52081,"_2668":52325},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3173":2159,"_28139":2060,"_19503":52327,"_5":13343,"_25626":52081,"_2668":52307},[],{"_3173":2160,"_28139":2060,"_19503":52329,"_5":13343,"_25626":52081,"_2668":52330},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3173":2161,"_28139":2060,"_19503":52332,"_5":13343,"_25626":52081,"_2668":52333},[],"**Message Type**: `Raw` or `Digest`.",{"_3173":2162,"_28139":2060,"_19503":52335,"_5":13343,"_25626":52081,"_2668":52336},[],"**Payload Encoding**: encoding of the message.",{"_3173":2163,"_28139":2060,"_19503":52338,"_5":13343,"_25626":52081,"_2668":52339},[],"**Message**: original message or hash.",{"_3173":2164,"_28139":2060,"_19503":52341,"_5":13343,"_25626":52081,"_2668":52342},[],"**Signature**: signature to check.",{"_3173":2165,"_28139":2060,"_19503":52344,"_5":13343,"_25626":52081,"_2668":52345},[],"**Result**: indicator of the validation result.",{"_3173":2166,"_28139":2060,"_19503":52347,"_5":13343,"_25626":52085,"_2668":52348},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3173":2167,"_28139":2060,"_19503":52350,"_5":13343,"_25626":52085,"_2668":52351},[],"This flow is useful for:",{"_3173":2168,"_28139":2060,"_19503":52353,"_5":13343,"_25626":52085,"_2668":52354},[],"Requesting certificates from an external CA.",{"_3173":2169,"_28139":2060,"_19503":52356,"_5":13343,"_25626":52085,"_2668":52357},[],"Renewing an identity while keeping the same key.",{"_3173":2170,"_28139":2060,"_19503":52359,"_5":13343,"_25626":52085,"_2668":52360},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3173":2171,"_28139":2060,"_19503":52362,"_5":13343,"_25626":52085,"_2668":52363},[],"**Common Name (CN)**: main name of the identity.",{"_3173":2172,"_28139":2060,"_19503":52365,"_5":13343,"_25626":52085,"_2668":52366},[],"**Organization (O)**: organization or company.",{"_3173":2173,"_28139":2060,"_19503":52368,"_5":13343,"_25626":52085,"_2668":52369},[],"**Organizational Unit (OU)**: department or unit.",{"_3173":2174,"_28139":2060,"_19503":52371,"_5":13343,"_25626":52085,"_2668":52372},[],"**Country (C)**: two-letter country code.",{"_3173":2175,"_28139":2060,"_19503":52374,"_5":13343,"_25626":52085,"_2668":52375},[],"**State / Province (ST)**: state or province.",{"_3173":2176,"_28139":2060,"_19503":52377,"_5":13343,"_25626":52085,"_2668":52378},[],"**Locality (L)**: city or locality.",{"_3173":2177,"_28139":2060,"_19503":52380,"_5":13343,"_25626":52085,"_2668":52381},[],"**Email Address**: contact email.",{"_3173":2178,"_28139":2060,"_19503":52383,"_5":13343,"_25626":52085,"_2668":52384},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3173":2179,"_28139":2060,"_19503":52386,"_5":13343,"_25626":52085,"_2668":52387},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3173":2180,"_28139":2060,"_19503":52389,"_5":13343,"_25626":52089,"_2668":52390},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3173":2181,"_28139":2060,"_19503":52392,"_5":13343,"_25626":52089,"_2668":52393},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3173":2182,"_28139":2060,"_19503":52395,"_5":13343,"_25626":52093,"_2668":52396},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3173":2183,"_28139":2183,"_5":13674,"_2668":52398,"_28481":52399,"_19503":52400,"_25626":2183},"Online validation with OCSP",[45572,46965,50707,51324],[],{"_3173":2184,"_28139":2183,"_19503":52402,"_5":13343,"_25626":2183,"_2668":52403},[],"Query signed status and verify the responder’s response.",{"_3173":2185,"_28139":2183,"_5":28478,"_19503":52405,"_25626":52406,"_2668":52407},[],"/docs/pr-preview/pr-43/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3173":2186,"_28139":2183,"_5":28478,"_19503":52409,"_25626":52410,"_2668":52411},[],"/docs/pr-preview/pr-43/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3173":2187,"_28139":2183,"_5":28478,"_19503":52413,"_25626":52414,"_2668":52415},[],"/docs/pr-preview/pr-43/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3173":2188,"_28139":2183,"_5":28478,"_19503":52417,"_25626":52418,"_2668":52419},[],"/docs/pr-preview/pr-43/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3173":2189,"_28139":2183,"_5":28478,"_19503":52421,"_25626":52422,"_2668":52423},[],"/docs/pr-preview/pr-43/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3173":2190,"_28139":2183,"_5":28478,"_19503":52425,"_25626":52426,"_2668":51870},[],"/docs/pr-preview/pr-43/platform/pki/ocsp#references",{"_3173":2191,"_28139":2183,"_19503":52428,"_5":13343,"_25626":2183,"_2668":52429},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3173":2192,"_28139":2183,"_19503":52431,"_5":13343,"_25626":52406,"_2668":52432},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3173":2193,"_28139":2183,"_19503":52434,"_5":13343,"_25626":52406,"_2668":52435},[],"Record status",{"_3173":2194,"_28139":2183,"_19503":52437,"_5":13343,"_25626":52406,"_2668":52438},[],"Signed response",{"_3173":2195,"_28139":2183,"_19503":52440,"_5":13343,"_25626":52406,"_2668":49876},[],{"_3173":2196,"_28139":2183,"_19503":52442,"_5":13343,"_25626":52406,"_2668":52443},[],"`Good`.",{"_3173":2197,"_28139":2183,"_19503":52445,"_5":13343,"_25626":52406,"_2668":49893},[],{"_3173":2198,"_28139":2183,"_19503":52447,"_5":13343,"_25626":52406,"_2668":52448},[],"`Revoked`, with revocation reason and timestamp.",{"_3173":2199,"_28139":2183,"_19503":52450,"_5":13343,"_25626":52406,"_2668":52451},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3173":2200,"_28139":2183,"_19503":52453,"_5":13343,"_25626":52406,"_2668":52454},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3173":2201,"_28139":2183,"_19503":52456,"_5":13343,"_25626":52406,"_2668":52457},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3173":2202,"_28139":2183,"_19503":52459,"_5":13343,"_25626":52406,"_2668":52460},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3173":2203,"_28139":2183,"_19503":52462,"_5":13343,"_25626":52406,"_2668":52463},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3173":2204,"_28139":2183,"_19503":52465,"_5":13343,"_25626":52410,"_2668":52466},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3173":2205,"_28139":2183,"_19503":52468,"_5":13343,"_25626":52410,"_2668":52469},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3173":2206,"_28139":2183,"_19503":52471,"_5":13343,"_25626":52414,"_2668":52472},[],"The service accepts:",{"_3173":2207,"_28139":2183,"_19503":52474,"_5":13343,"_25626":52414,"_2668":48729},[],{"_3173":2208,"_28139":2183,"_19503":52476,"_5":13343,"_25626":52414,"_2668":52477},[],"VA service path",{"_3173":2209,"_28139":2183,"_19503":52479,"_5":13343,"_25626":52414,"_2668":52480},[],"Format",{"_3173":2210,"_28139":2183,"_19503":52482,"_5":13343,"_25626":52414,"_2668":52483},[],"`POST`",{"_3173":2211,"_28139":2183,"_19503":52485,"_5":13343,"_25626":52414,"_2668":52486},[],"`/ocsp`",{"_3173":2212,"_28139":2183,"_19503":52488,"_5":13343,"_25626":52414,"_2668":52489},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3173":2213,"_28139":2183,"_19503":52491,"_5":13343,"_25626":52414,"_2668":51969},[],{"_3173":2214,"_28139":2183,"_19503":52493,"_5":13343,"_25626":52414,"_2668":52494},[],"`/ocsp/{ocsp_request}`",{"_3173":2215,"_28139":2183,"_19503":52496,"_5":13343,"_25626":52414,"_2668":52497},[],"DER request encoded using padded URL Base64.",{"_3173":2216,"_28139":2183,"_19503":52499,"_5":13343,"_25626":52414,"_2668":52500},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3173":2217,"_28139":2183,"_19503":52502,"_5":13343,"_25626":52418,"_2668":52503},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3173":2218,"_28139":2183,"_19503":52505,"_5":13343,"_25626":52418,"_2668":52506},[],"Generate the request:",{"_3173":2219,"_28139":2183,"_19503":52508,"_5":13343,"_25626":52418,"_2668":52509},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3173":2220,"_28139":2183,"_19503":52511,"_5":13343,"_25626":52418,"_2668":52512},[],"Replace the example URL with the inspected endpoint:",{"_3173":2221,"_28139":2183,"_19503":52514,"_5":13343,"_25626":52418,"_2668":52515},[],"Verify the returned DER:",{"_3173":2222,"_28139":2183,"_19503":52517,"_5":13343,"_25626":52418,"_2668":52518},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3173":2223,"_28139":2183,"_19503":52520,"_5":13343,"_25626":52422,"_2668":52521},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3173":2224,"_28139":2183,"_19503":52523,"_5":13343,"_25626":52422,"_2668":52524},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3173":2225,"_28139":2183,"_19503":52526,"_5":13343,"_25626":52426,"_2668":52527},[],"RFC 6960: OCSP.",{"_3173":2226,"_28139":2183,"_19503":52529,"_5":13343,"_25626":52426,"_2668":52530},[],"OpenSSL: openssl-ocsp.",{"_3173":2227,"_28139":2183,"_19503":52532,"_5":13343,"_25626":52426,"_2668":52533},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3173":2228,"_28139":2183,"_19503":52535,"_5":13343,"_25626":52426,"_2668":52007},[],{"_3173":2229,"_28139":2229,"_5":13674,"_2668":50707,"_28481":52537,"_19503":52538,"_25626":2229},[45572,46965,50707],[],{"_3173":2230,"_28139":2229,"_19503":52540,"_5":13343,"_25626":2229,"_2668":52541},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3173":2231,"_28139":2229,"_5":28478,"_19503":52543,"_25626":52544,"_2668":50017},[],"/docs/pr-preview/pr-43/platform/pki/overview#start-here",{"_3173":2232,"_28139":2229,"_5":28478,"_19503":52546,"_25626":52547,"_2668":52548},[],"/docs/pr-preview/pr-43/platform/pki/overview#what-you-need","What you need",{"_3173":2233,"_28139":2229,"_5":28478,"_19503":52550,"_25626":52551,"_2668":50551},[],"/docs/pr-preview/pr-43/platform/pki/overview#core-capabilities",{"_3173":2234,"_28139":2229,"_5":28478,"_19503":52553,"_25626":52554,"_2668":50555},[],"/docs/pr-preview/pr-43/platform/pki/overview#build-your-trust-hierarchy",{"_3173":2235,"_28139":2229,"_5":28478,"_19503":52556,"_25626":52557,"_2668":50559},[],"/docs/pr-preview/pr-43/platform/pki/overview#protect-cryptographic-keys",{"_3173":2236,"_28139":2229,"_5":28478,"_19503":52559,"_25626":52560,"_2668":50563},[],"/docs/pr-preview/pr-43/platform/pki/overview#issue-and-control-certificates",{"_3173":2237,"_28139":2229,"_5":28478,"_19503":52562,"_25626":52563,"_2668":50571},[],"/docs/pr-preview/pr-43/platform/pki/overview#publish-validation-status",{"_3173":2238,"_28139":2229,"_5":28478,"_19503":52565,"_25626":52566,"_2668":52567},[],"/docs/pr-preview/pr-43/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3173":2239,"_28139":2229,"_5":28478,"_19503":52569,"_25626":52570,"_2668":51491},[],"/docs/pr-preview/pr-43/platform/pki/overview#continue",{"_3173":2240,"_28139":2229,"_19503":52572,"_5":13343,"_25626":2229,"_2668":52573},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3173":2241,"_28139":2229,"_19503":52575,"_5":13343,"_25626":52544,"_2668":52576},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3173":2242,"_28139":2229,"_19503":52578,"_5":13343,"_25626":52544,"_2668":52579},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3173":2243,"_28139":2229,"_19503":52581,"_5":13343,"_25626":52547,"_2668":52582},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3173":2244,"_28139":2229,"_19503":52584,"_5":13343,"_25626":52547,"_2668":52585},[],"An available cryptographic engine to keep the authority's key.",{"_3173":2245,"_28139":2229,"_19503":52587,"_5":13343,"_25626":52547,"_2668":52588},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3173":2246,"_28139":2229,"_19503":52590,"_5":13343,"_25626":52547,"_2668":52591},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3173":2247,"_28139":2229,"_19503":52593,"_5":13343,"_25626":52547,"_2668":52594},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3173":2248,"_28139":2229,"_19503":52596,"_5":13343,"_25626":52554,"_2668":52597},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3173":2249,"_28139":2229,"_19503":52599,"_5":13343,"_25626":52557,"_2668":52600},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3173":2250,"_28139":2229,"_19503":52602,"_5":13343,"_25626":52560,"_2668":52603},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3173":2251,"_28139":2229,"_19503":52605,"_5":13343,"_25626":52563,"_2668":52606},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3173":2252,"_28139":2229,"_19503":52608,"_5":13343,"_25626":52566,"_2668":52609},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3173":2253,"_28139":2229,"_19503":52611,"_5":13343,"_25626":52566,"_2668":52612},[],"its subject and extensions identify the expected client;",{"_3173":2254,"_28139":2229,"_19503":52614,"_5":13343,"_25626":52566,"_2668":52615},[],"its public key matches the client's private key;",{"_3173":2255,"_28139":2229,"_19503":52617,"_5":13343,"_25626":52566,"_2668":52618},[],"its chain reaches a root trusted by the consumer;",{"_3173":2256,"_28139":2229,"_19503":52620,"_5":13343,"_25626":52566,"_2668":52621},[],"its dates and usages allow the operation;",{"_3173":2257,"_28139":2229,"_19503":52623,"_5":13343,"_25626":52566,"_2668":52624},[],"the consumer applies revocation checks and authorization.",{"_3173":2258,"_28139":2229,"_19503":52626,"_5":13343,"_25626":52566,"_2668":52627},[],"The issuance path includes the first independent checks.",{"_3173":2259,"_28139":2229,"_19503":52629,"_5":13343,"_25626":52570,"_2668":52630},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3173":2260,"_28139":2229,"_19503":52632,"_5":13343,"_25626":52570,"_2668":52633},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3173":2261,"_28139":2229,"_19503":52635,"_5":13343,"_25626":52570,"_2668":52636},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3173":2262,"_28139":2262,"_5":13674,"_2668":52638,"_28481":52639,"_19503":52640,"_25626":2262},"Create your first CA",[45572,46965,50707,50142],[],{"_3173":2263,"_28139":2262,"_19503":52642,"_5":13343,"_25626":2262,"_2668":52643},[],"Create an evaluation root and check its certificate before issuing.",{"_3173":2264,"_28139":2262,"_5":28478,"_19503":52645,"_25626":52646,"_2668":45582},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3173":2265,"_28139":2262,"_5":28478,"_19503":52648,"_25626":52649,"_2668":52650},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3173":2266,"_28139":2262,"_5":28478,"_19503":52652,"_25626":52653,"_2668":52654},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3173":2267,"_28139":2262,"_5":28478,"_19503":52656,"_25626":52657,"_2668":52658},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3173":2268,"_28139":2262,"_5":28478,"_19503":52660,"_25626":52661,"_2668":52662},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3173":2269,"_28139":2262,"_5":28478,"_19503":52664,"_25626":52665,"_2668":52666},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3173":2270,"_28139":2262,"_5":28478,"_19503":52668,"_25626":52669,"_2668":52670},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3173":2271,"_28139":2262,"_5":28478,"_19503":52672,"_25626":52673,"_2668":50400},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3173":2272,"_28139":2262,"_5":28478,"_19503":52675,"_25626":52676,"_2668":45606},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3173":2273,"_28139":2262,"_19503":52678,"_5":13343,"_25626":2262,"_2668":52679},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3173":2274,"_28139":2262,"_19503":52681,"_5":13343,"_25626":52646,"_2668":52682},[],"Console access and permission to create keys and authorities.",{"_3173":2275,"_28139":2262,"_19503":52684,"_5":13343,"_25626":52646,"_2668":52685},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3173":2276,"_28139":2262,"_19503":52687,"_5":13343,"_25626":52646,"_2668":52688},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3173":2277,"_28139":2262,"_19503":52690,"_5":13343,"_25626":52646,"_2668":52691},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3173":2278,"_28139":2262,"_19503":52693,"_5":13343,"_25626":52649,"_2668":52694},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3173":2279,"_28139":2262,"_19503":52696,"_5":13343,"_25626":52649,"_2668":52697},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3173":2280,"_28139":2262,"_19503":52699,"_5":13343,"_25626":52653,"_2668":52700},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3173":2281,"_28139":2262,"_19503":52702,"_5":13343,"_25626":52653,"_2668":52703},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3173":2282,"_28139":2262,"_19503":52705,"_5":13343,"_25626":52657,"_2668":52706},[],"Select **Root CA** and complete:",{"_3173":2283,"_28139":2262,"_19503":52708,"_5":13343,"_25626":52657,"_2668":52709},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3173":2284,"_28139":2262,"_19503":52711,"_5":13343,"_25626":52657,"_2668":52712},[],"**Subject**: organization and country details for your evaluation.",{"_3173":2285,"_28139":2262,"_19503":52714,"_5":13343,"_25626":52657,"_2668":52715},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3173":2286,"_28139":2262,"_19503":52717,"_5":13343,"_25626":52657,"_2668":52718},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3173":2287,"_28139":2262,"_19503":52720,"_5":13343,"_25626":52657,"_2668":52721},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3173":2288,"_28139":2262,"_19503":52723,"_5":13343,"_25626":52661,"_2668":52724},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3173":2289,"_28139":2262,"_19503":52726,"_5":13343,"_25626":52665,"_2668":52727},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3173":2290,"_28139":2262,"_19503":52729,"_5":13343,"_25626":52665,"_2668":52730},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3173":2291,"_28139":2262,"_19503":52732,"_5":13343,"_25626":52669,"_2668":52733},[],"Run from the directory where you saved `ca.pem`:",{"_3173":2292,"_28139":2262,"_19503":52735,"_5":13343,"_25626":52669,"_2668":52736},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3173":2293,"_28139":2262,"_19503":52738,"_5":13343,"_25626":52669,"_2668":52739},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3173":2294,"_28139":2262,"_19503":52741,"_5":13343,"_25626":52673,"_2668":52742},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3173":2295,"_28139":2262,"_19503":52744,"_5":13343,"_25626":52673,"_2668":52745},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3173":2296,"_28139":2262,"_19503":52747,"_5":13343,"_25626":52673,"_2668":52748},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3173":2297,"_28139":2262,"_19503":52750,"_5":13343,"_25626":52673,"_2668":52751},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3173":2298,"_28139":2262,"_19503":52753,"_5":13343,"_25626":52676,"_2668":52754},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3173":2299,"_28139":2299,"_5":13674,"_2668":52756,"_28481":52757,"_19503":52758,"_25626":2299},"Issue and verify a certificate",[45572,46965,50707,50142],[],{"_3173":2300,"_28139":2299,"_19503":52760,"_5":13343,"_25626":2299,"_2668":52761},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3173":2301,"_28139":2299,"_5":28478,"_19503":52763,"_25626":52764,"_2668":45582},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3173":2302,"_28139":2299,"_5":28478,"_19503":52766,"_25626":52767,"_2668":52768},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3173":2303,"_28139":2299,"_5":28478,"_19503":52770,"_25626":52771,"_2668":52772},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3173":2304,"_28139":2299,"_5":28478,"_19503":52774,"_25626":52775,"_2668":52776},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3173":2305,"_28139":2299,"_5":28478,"_19503":52778,"_25626":52779,"_2668":52780},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3173":2306,"_28139":2299,"_5":28478,"_19503":52782,"_25626":52783,"_2668":52784},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3173":2307,"_28139":2299,"_5":28478,"_19503":52786,"_25626":52787,"_2668":52788},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3173":2308,"_28139":2299,"_5":28478,"_19503":52790,"_25626":52791,"_2668":52792},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3173":2309,"_28139":2299,"_5":28478,"_19503":52794,"_25626":52795,"_2668":52796},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3173":2310,"_28139":2299,"_5":28478,"_19503":52798,"_25626":52799,"_2668":52800},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3173":2311,"_28139":2299,"_5":28478,"_19503":52802,"_25626":52803,"_2668":50400},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3173":2312,"_28139":2299,"_5":28478,"_19503":52805,"_25626":52806,"_2668":45606},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#next-step",{"_3173":2313,"_28139":2299,"_19503":52808,"_5":13343,"_25626":2299,"_2668":52809},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3173":2314,"_28139":2299,"_19503":52811,"_5":13343,"_25626":52764,"_2668":52812},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3173":2315,"_28139":2299,"_19503":52814,"_5":13343,"_25626":52764,"_2668":52815},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3173":2316,"_28139":2299,"_19503":52817,"_5":13343,"_25626":52764,"_2668":52818},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3173":2317,"_28139":2299,"_19503":52820,"_5":13343,"_25626":52764,"_2668":52821},[],"A client identifier: here we use `device-001`.",{"_3173":2318,"_28139":2299,"_19503":52823,"_5":13343,"_25626":52764,"_2668":52824},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3173":2319,"_28139":2299,"_19503":52826,"_5":13343,"_25626":52767,"_2668":52827},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3173":2320,"_28139":2299,"_19503":52829,"_5":13343,"_25626":52771,"_2668":52830},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3173":2321,"_28139":2299,"_19503":52832,"_5":13343,"_25626":52771,"_2668":52833},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3173":2322,"_28139":2299,"_19503":52835,"_5":13343,"_25626":52775,"_2668":52836},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3173":2323,"_28139":2299,"_19503":52838,"_5":13343,"_25626":52775,"_2668":52839},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3173":2324,"_28139":2299,"_19503":52841,"_5":13343,"_25626":52779,"_2668":52842},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3173":2325,"_28139":2299,"_19503":52844,"_5":13343,"_25626":52779,"_2668":52845},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3173":2326,"_28139":2299,"_19503":52847,"_5":13343,"_25626":52783,"_2668":52848},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3173":2327,"_28139":2299,"_19503":52850,"_5":13343,"_25626":52787,"_2668":52851},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3173":2328,"_28139":2299,"_19503":52853,"_5":13343,"_25626":52791,"_2668":52854},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3173":2329,"_28139":2299,"_19503":52856,"_5":13343,"_25626":52795,"_2668":52857},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3173":2330,"_28139":2299,"_19503":52859,"_5":13343,"_25626":52795,"_2668":52860},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3173":2331,"_28139":2299,"_19503":52862,"_5":13343,"_25626":52795,"_2668":52863},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3173":2332,"_28139":2299,"_19503":52865,"_5":13343,"_25626":52799,"_2668":52866},[],"In Bash, compare the two public-key digests:",{"_3173":2333,"_28139":2299,"_19503":52868,"_5":13343,"_25626":52799,"_2668":52869},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3173":2334,"_28139":2299,"_19503":52871,"_5":13343,"_25626":52799,"_2668":52872},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3173":2335,"_28139":2299,"_19503":52874,"_5":13343,"_25626":52803,"_2668":50484},[],{"_3173":2336,"_28139":2299,"_19503":52876,"_5":13343,"_25626":52803,"_2668":52877},[],"What to review",{"_3173":2337,"_28139":2299,"_19503":52879,"_5":13343,"_25626":52803,"_2668":52880},[],"The CA rejects issuance",{"_3173":2338,"_28139":2299,"_19503":52882,"_5":13343,"_25626":52803,"_2668":52883},[],"Permissions, CA state and key, algorithm and profile.",{"_3173":2339,"_28139":2299,"_19503":52885,"_5":13343,"_25626":52803,"_2668":52886},[],"Different subject or usages",{"_3173":2340,"_28139":2299,"_19503":52888,"_5":13343,"_25626":52803,"_2668":52889},[],"Applied profile and requested values.",{"_3173":2341,"_28139":2299,"_19503":52891,"_5":13343,"_25626":52803,"_2668":52892},[],"Issuer cannot be found",{"_3173":2342,"_28139":2299,"_19503":52894,"_5":13343,"_25626":52803,"_2668":52895},[],"Downloaded CA and required intermediate chain.",{"_3173":2343,"_28139":2299,"_19503":52897,"_5":13343,"_25626":52803,"_2668":52898},[],"Validity fails",{"_3173":2344,"_28139":2299,"_19503":52900,"_5":13343,"_25626":52803,"_2668":52901},[],"Certificate and CA dates, and the computer's clock.",{"_3173":2345,"_28139":2299,"_19503":52903,"_5":13343,"_25626":52803,"_2668":52904},[],"Public-key digests differ",{"_3173":2346,"_28139":2299,"_19503":52906,"_5":13343,"_25626":52803,"_2668":52907},[],"Certificate and key files from the same issuance.",{"_3173":2347,"_28139":2299,"_19503":52909,"_5":13343,"_25626":52803,"_2668":52910},[],"See PKI diagnostics to narrow an issuance failure.",{"_3173":2348,"_28139":2299,"_19503":52912,"_5":13343,"_25626":52806,"_2668":52913},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3173":2349,"_28139":2299,"_19503":52915,"_5":13343,"_25626":52806,"_2668":52916},[],"Manage certificates for inspection, status and revocation.",{"_3173":2350,"_28139":2299,"_19503":52918,"_5":13343,"_25626":52806,"_2668":52919},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3173":2351,"_28139":2299,"_19503":52921,"_5":13343,"_25626":52806,"_2668":52922},[],"Prepare EST for the device to request its next identities.",{"_3173":2352,"_28139":2299,"_19503":52924,"_5":13343,"_25626":52806,"_2668":52925},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3173":2353,"_28139":2353,"_5":13674,"_2668":52927,"_28481":52928,"_19503":52929,"_25626":2353},"PKI getting started",[45572,46965,50707,50142],[],{"_3173":2354,"_28139":2353,"_19503":52931,"_5":13343,"_25626":2353,"_2668":52932},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3173":2355,"_28139":2353,"_5":28478,"_19503":52934,"_25626":52935,"_2668":45582},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview#before-you-begin",{"_3173":2356,"_28139":2353,"_5":28478,"_19503":52937,"_25626":52938,"_2668":52939},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3173":2357,"_28139":2353,"_5":28478,"_19503":52941,"_25626":52942,"_2668":50334},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview#expected-result",{"_3173":2358,"_28139":2353,"_5":28478,"_19503":52944,"_25626":52945,"_2668":52946},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3173":2359,"_28139":2353,"_19503":52948,"_5":13343,"_25626":2353,"_2668":52949},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3173":2360,"_28139":2353,"_19503":52951,"_5":13343,"_25626":52935,"_2668":52952},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3173":2361,"_28139":2353,"_19503":52954,"_5":13343,"_25626":52935,"_2668":52955},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3173":2362,"_28139":2353,"_19503":52957,"_5":13343,"_25626":52935,"_2668":52958},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3173":2363,"_28139":2353,"_19503":52960,"_5":13343,"_25626":52935,"_2668":52961},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3173":2364,"_28139":2353,"_19503":52963,"_5":13343,"_25626":52935,"_2668":52964},[],"A working directory with restricted access for the downloaded key.",{"_3173":2365,"_28139":2353,"_19503":52966,"_5":13343,"_25626":52938,"_2668":52967},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3173":2366,"_28139":2353,"_19503":52969,"_5":13343,"_25626":52938,"_2668":52970},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3173":2367,"_28139":2353,"_19503":52972,"_5":13343,"_25626":52938,"_2668":52973},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3173":2368,"_28139":2353,"_19503":52975,"_5":13343,"_25626":52938,"_2668":52976},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3173":2369,"_28139":2353,"_19503":52978,"_5":13343,"_25626":52942,"_2668":52979},[],"File or resource",{"_3173":2370,"_28139":2353,"_19503":52981,"_5":13343,"_25626":52942,"_2668":50331},[],{"_3173":2371,"_28139":2353,"_19503":52983,"_5":13343,"_25626":52942,"_2668":52984},[],"Active root CA and `ca.pem`",{"_3173":2372,"_28139":2353,"_19503":52986,"_5":13343,"_25626":52942,"_2668":52987},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3173":2373,"_28139":2353,"_19503":52989,"_5":13343,"_25626":52942,"_2668":52990},[],"End-entity certificate and `device.crt`",{"_3173":2374,"_28139":2353,"_19503":52992,"_5":13343,"_25626":52942,"_2668":52993},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3173":2375,"_28139":2353,"_19503":52995,"_5":13343,"_25626":52942,"_2668":52996},[],"Private key `device.key`",{"_3173":2376,"_28139":2353,"_19503":52998,"_5":13343,"_25626":52942,"_2668":52999},[],"Its public key matches the one included in `device.crt`.",{"_3173":2377,"_28139":2353,"_19503":53001,"_5":13343,"_25626":52942,"_2668":53002},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3173":2378,"_28139":2353,"_19503":53004,"_5":13343,"_25626":52945,"_2668":53005},[],"To operate certificates, continue with Certificates and Validation.",{"_3173":2379,"_28139":2353,"_19503":53007,"_5":13343,"_25626":52945,"_2668":53008},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3173":2380,"_28139":2353,"_19503":53010,"_5":13343,"_25626":52945,"_2668":53011},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3173":2381,"_28139":2381,"_5":13674,"_2668":53013,"_28481":53014,"_19503":53015,"_25626":2381},"PKI troubleshooting",[45572,46965,50707,49519],[],{"_3173":2382,"_28139":2381,"_19503":53017,"_5":13343,"_25626":2381,"_2668":53018},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3173":2383,"_28139":2381,"_5":28478,"_19503":53020,"_25626":53021,"_2668":53022},[],"/docs/pr-preview/pr-43/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3173":2384,"_28139":2381,"_5":28478,"_19503":53024,"_25626":53025,"_2668":53026},[],"/docs/pr-preview/pr-43/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3173":2385,"_28139":2381,"_5":28478,"_19503":53028,"_25626":53029,"_2668":53030},[],"/docs/pr-preview/pr-43/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3173":2386,"_28139":2381,"_19503":53032,"_5":13343,"_25626":2381,"_2668":53033},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3173":2387,"_28139":2381,"_19503":53035,"_5":13343,"_25626":2381,"_2668":53036},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3173":2388,"_28139":2381,"_19503":53038,"_5":13343,"_25626":53021,"_2668":50331},[],{"_3173":2389,"_28139":2381,"_19503":53040,"_5":13343,"_25626":53021,"_2668":53041},[],"What to inspect",{"_3173":2390,"_28139":2381,"_19503":53043,"_5":13343,"_25626":53021,"_2668":45606},[],{"_3173":2391,"_28139":2381,"_19503":53045,"_5":13343,"_25626":53021,"_2668":53046},[],"CA",{"_3173":2392,"_28139":2381,"_19503":53048,"_5":13343,"_25626":53021,"_2668":53049},[],"Exists, is active and has usable dates.",{"_3173":2393,"_28139":2381,"_19503":53051,"_5":13343,"_25626":53021,"_2668":53052},[],"Authorities.",{"_3173":2394,"_28139":2381,"_19503":53054,"_5":13343,"_25626":53021,"_2668":53055},[],"Key",{"_3173":2395,"_28139":2381,"_19503":53057,"_5":13343,"_25626":53021,"_2668":53058},[],"The record has a usable private key and the engine can sign.",{"_3173":2396,"_28139":2381,"_19503":53060,"_5":13343,"_25626":53021,"_2668":53061},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3173":2397,"_28139":2381,"_19503":53063,"_5":13343,"_25626":53021,"_2668":53064},[],"CSR",{"_3173":2398,"_28139":2381,"_19503":53066,"_5":13343,"_25626":53021,"_2668":53067},[],"Correct PEM and verifiable signature.",{"_3173":2399,"_28139":2381,"_19503":53069,"_5":13343,"_25626":53021,"_2668":53070},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3173":2400,"_28139":2381,"_19503":53072,"_5":13343,"_25626":53021,"_2668":53073},[],"Profile",{"_3173":2401,"_28139":2381,"_19503":53075,"_5":13343,"_25626":53021,"_2668":53076},[],"Selected source, existing ID, allowed algorithm and size.",{"_3173":2402,"_28139":2381,"_19503":53078,"_5":13343,"_25626":53021,"_2668":53079},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3173":2403,"_28139":2381,"_19503":53081,"_5":13343,"_25626":53021,"_2668":50484},[],{"_3173":2404,"_28139":2381,"_19503":53083,"_5":13343,"_25626":53021,"_2668":53084},[],"Appropriate subject, SAN, usages and dates.",{"_3173":2405,"_28139":2381,"_19503":53086,"_5":13343,"_25626":53021,"_2668":53087},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3173":2406,"_28139":2381,"_19503":53089,"_5":13343,"_25626":53021,"_2668":53090},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3173":2407,"_28139":2381,"_19503":53092,"_5":13343,"_25626":53021,"_2668":53093},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3173":2408,"_28139":2381,"_19503":53095,"_5":13343,"_25626":53025,"_2668":53096},[],"Check each boundary independently:",{"_3173":2409,"_28139":2381,"_19503":53098,"_5":13343,"_25626":53025,"_2668":53099},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3173":2410,"_28139":2381,"_19503":53101,"_5":13343,"_25626":53025,"_2668":53102},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3173":2411,"_28139":2381,"_19503":53104,"_5":13343,"_25626":53025,"_2668":53105},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3173":2412,"_28139":2381,"_19503":53107,"_5":13343,"_25626":53025,"_2668":53108},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3173":2413,"_28139":2381,"_19503":53110,"_5":13343,"_25626":53025,"_2668":53111},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3173":2414,"_28139":2381,"_19503":53113,"_5":13343,"_25626":53025,"_2668":53114},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3173":2415,"_28139":2381,"_19503":53116,"_5":13343,"_25626":53029,"_2668":53117},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3173":2416,"_28139":2381,"_19503":53119,"_5":13343,"_25626":53029,"_2668":53120},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3173":2417,"_28139":2417,"_5":13674,"_2668":53122,"_28481":53123,"_19503":53125,"_25626":2417},"3.8.0 to 4.0.0",[45572,53124],"Upgrades",[],{"_3173":2418,"_28139":2417,"_19503":53127,"_5":13343,"_25626":2417,"_2668":53128},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3173":2419,"_28139":2417,"_5":28478,"_19503":53130,"_25626":53131,"_2668":53132},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3173":2420,"_28139":2417,"_5":28478,"_19503":53134,"_25626":53135,"_2668":53136},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3173":2421,"_28139":2417,"_5":28478,"_19503":53138,"_25626":53139,"_2668":53140},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3173":2422,"_28139":2417,"_5":28478,"_19503":53142,"_25626":53143,"_2668":53144},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3173":2423,"_28139":2417,"_5":28478,"_19503":53146,"_25626":53147,"_2668":53148},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3173":2424,"_28139":2417,"_5":28478,"_19503":53150,"_25626":53151,"_2668":53152},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3173":2425,"_28139":2417,"_5":28478,"_19503":53154,"_25626":53155,"_2668":53156},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3173":2426,"_28139":2417,"_5":28478,"_19503":53158,"_25626":53159,"_2668":53160},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3173":2427,"_28139":2417,"_5":28478,"_19503":53162,"_25626":53163,"_2668":53164},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3173":2428,"_28139":2417,"_5":28478,"_19503":53166,"_25626":53167,"_2668":53168},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3173":2429,"_28139":2417,"_5":28478,"_19503":53170,"_25626":53171,"_2668":53172},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3173":2430,"_28139":2417,"_5":28478,"_19503":53174,"_25626":53175,"_2668":53176},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3173":2431,"_28139":2417,"_5":28478,"_19503":53178,"_25626":53179,"_2668":53180},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3173":2432,"_28139":2417,"_5":28478,"_19503":53182,"_25626":53183,"_2668":53184},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3173":2433,"_28139":2417,"_5":28478,"_19503":53186,"_25626":53187,"_2668":53188},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3173":2434,"_28139":2417,"_5":28478,"_19503":53190,"_25626":53191,"_2668":53192},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3173":2435,"_28139":2417,"_5":28478,"_19503":53194,"_25626":53195,"_2668":53196},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3173":2436,"_28139":2417,"_5":28478,"_19503":53198,"_25626":53199,"_2668":53200},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3173":2437,"_28139":2417,"_5":28478,"_19503":53202,"_25626":53203,"_2668":53204},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3173":2438,"_28139":2417,"_5":28478,"_19503":53206,"_25626":53207,"_2668":53208},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3173":2439,"_28139":2417,"_5":28478,"_19503":53210,"_25626":53211,"_2668":53212},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3173":2440,"_28139":2417,"_5":28478,"_19503":53214,"_25626":53215,"_2668":53216},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3173":2441,"_28139":2417,"_5":28478,"_19503":53218,"_25626":53219,"_2668":53220},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3173":2442,"_28139":2417,"_5":28478,"_19503":53222,"_25626":53223,"_2668":53224},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3173":2443,"_28139":2417,"_5":28478,"_19503":53226,"_25626":53227,"_2668":53228},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3173":2444,"_28139":2417,"_5":28478,"_19503":53230,"_25626":53231,"_2668":53232},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3173":2445,"_28139":2417,"_5":28478,"_19503":53234,"_25626":53235,"_2668":53236},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3173":2446,"_28139":2417,"_5":28478,"_19503":53238,"_25626":53239,"_2668":53240},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3173":2447,"_28139":2417,"_5":28478,"_19503":53242,"_25626":53243,"_2668":53244},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3173":2448,"_28139":2417,"_5":28478,"_19503":53246,"_25626":53247,"_2668":53248},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3173":2449,"_28139":2417,"_5":28478,"_19503":53250,"_25626":53251,"_2668":53252},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3173":2450,"_28139":2417,"_5":28478,"_19503":53254,"_25626":53255,"_2668":53256},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3173":2451,"_28139":2417,"_5":28478,"_19503":53258,"_25626":53259,"_2668":53260},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3173":2452,"_28139":2417,"_5":28478,"_19503":53262,"_25626":53263,"_2668":49519},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3173":2453,"_28139":2417,"_5":28478,"_19503":53265,"_25626":53266,"_2668":53267},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3173":2454,"_28139":2417,"_5":28478,"_19503":53269,"_25626":53270,"_2668":53271},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3173":2455,"_28139":2417,"_19503":53273,"_5":13343,"_25626":2417,"_2668":53274},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3173":2456,"_28139":2417,"_19503":53276,"_5":13343,"_25626":2417,"_2668":53277},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3173":2457,"_28139":2417,"_19503":53279,"_5":13343,"_25626":2417,"_2668":53280},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3173":2458,"_28139":2417,"_19503":53282,"_5":13343,"_25626":2417,"_2668":53283},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3173":2459,"_28139":2417,"_19503":53285,"_5":13343,"_25626":2417,"_2668":53286},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3173":2460,"_28139":2417,"_19503":53288,"_5":13343,"_25626":2417,"_2668":53289},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3173":2461,"_28139":2417,"_19503":53291,"_5":13343,"_25626":2417,"_2668":53292},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3173":2462,"_28139":2417,"_19503":53294,"_5":13343,"_25626":53135,"_2668":53295},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3173":2463,"_28139":2417,"_19503":53297,"_5":13343,"_25626":53135,"_2668":53298},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3173":2464,"_28139":2417,"_19503":53300,"_5":13343,"_25626":53139,"_2668":53301},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3173":2465,"_28139":2417,"_19503":53303,"_5":13343,"_25626":53139,"_2668":53304},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3173":2466,"_28139":2417,"_19503":53306,"_5":13343,"_25626":53143,"_2668":53307},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3173":2467,"_28139":2417,"_19503":53309,"_5":13343,"_25626":53147,"_2668":53310},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3173":2468,"_28139":2417,"_19503":53312,"_5":13343,"_25626":53147,"_2668":53313},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3173":2469,"_28139":2417,"_19503":53315,"_5":13343,"_25626":53147,"_2668":53316},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3173":2470,"_28139":2417,"_19503":53318,"_5":13343,"_25626":53147,"_2668":53319},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3173":2471,"_28139":2417,"_19503":53321,"_5":13343,"_25626":53147,"_2668":53322},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3173":2472,"_28139":2417,"_19503":53324,"_5":13343,"_25626":53151,"_2668":53325},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3173":2473,"_28139":2417,"_19503":53327,"_5":13343,"_25626":53151,"_2668":53328},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3173":2474,"_28139":2417,"_19503":53330,"_5":13343,"_25626":53151,"_2668":53331},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3173":2475,"_28139":2417,"_19503":53333,"_5":13343,"_25626":53151,"_2668":53334},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3173":2476,"_28139":2417,"_19503":53336,"_5":13343,"_25626":53151,"_2668":53337},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3173":2477,"_28139":2417,"_19503":53339,"_5":13343,"_25626":53155,"_2668":53340},[],"Change",{"_3173":2478,"_28139":2417,"_19503":53342,"_5":13343,"_25626":53155,"_2668":53343},[],"Who is affected",{"_3173":2479,"_28139":2417,"_19503":53345,"_5":13343,"_25626":53155,"_2668":53346},[],"Severity",{"_3173":2480,"_28139":2417,"_19503":53348,"_5":13343,"_25626":53155,"_2668":53349},[],"Action",{"_3173":2481,"_28139":2417,"_19503":53351,"_5":13343,"_25626":53155,"_2668":53164},[],{"_3173":2482,"_28139":2417,"_19503":53353,"_5":13343,"_25626":53155,"_2668":53354},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3173":2483,"_28139":2417,"_19503":53356,"_5":13343,"_25626":53155,"_2668":53357},[],"High: KMS and VA start on empty volumes",{"_3173":2484,"_28139":2417,"_19503":53359,"_5":13343,"_25626":53155,"_2668":53360},[],"Copy the data into the new volumes",{"_3173":2485,"_28139":2417,"_19503":53362,"_5":13343,"_25626":53155,"_2668":53168},[],{"_3173":2486,"_28139":2417,"_19503":53364,"_5":13343,"_25626":53155,"_2668":53365},[],"Every Helm release",{"_3173":2487,"_28139":2417,"_19503":53367,"_5":13343,"_25626":53155,"_2668":53368},[],"High: `helm upgrade` fails",{"_3173":2488,"_28139":2417,"_19503":53370,"_5":13343,"_25626":53155,"_2668":53371},[],"Remove or rename legacy keys",{"_3173":2489,"_28139":2417,"_19503":53373,"_5":13343,"_25626":53155,"_2668":53172},[],{"_3173":2490,"_28139":2417,"_19503":53375,"_5":13343,"_25626":53155,"_2668":53376},[],"Every deployment",{"_3173":2491,"_28139":2417,"_19503":53378,"_5":13343,"_25626":53155,"_2668":53379},[],"High: without a bootstrap principal there is no administrator",{"_3173":2492,"_28139":2417,"_19503":53381,"_5":13343,"_25626":53155,"_2668":53382},[],"Configure `services.authz`",{"_3173":2493,"_28139":2417,"_19503":53384,"_5":13343,"_25626":53155,"_2668":53176},[],{"_3173":2494,"_28139":2417,"_19503":53386,"_5":13343,"_25626":53155,"_2668":53365},[],{"_3173":2495,"_28139":2417,"_19503":53388,"_5":13343,"_25626":53155,"_2668":53389},[],"High: `helm upgrade` fails on the old keys",{"_3173":2496,"_28139":2417,"_19503":53391,"_5":13343,"_25626":53155,"_2668":53392},[],"Move JWKS and roles into `services.authz`",{"_3173":2497,"_28139":2417,"_19503":53394,"_5":13343,"_25626":53155,"_2668":53196},[],{"_3173":2498,"_28139":2417,"_19503":53396,"_5":13343,"_25626":53155,"_2668":53397},[],"3.8.0 deployments with per-service databases",{"_3173":2499,"_28139":2417,"_19503":53399,"_5":13343,"_25626":53155,"_2668":53400},[],"High: services find no data, or a migration aborts",{"_3173":2500,"_28139":2417,"_19503":53402,"_5":13343,"_25626":53155,"_2668":53403},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3173":2501,"_28139":2417,"_19503":53405,"_5":13343,"_25626":53155,"_2668":53200},[],{"_3173":2502,"_28139":2417,"_19503":53407,"_5":13343,"_25626":53155,"_2668":53408},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3173":2503,"_28139":2417,"_19503":53410,"_5":13343,"_25626":53155,"_2668":53411},[],"High: the backend no longer starts with them",{"_3173":2504,"_28139":2417,"_19503":53413,"_5":13343,"_25626":53155,"_2668":53414},[],"Move to PostgreSQL before upgrading",{"_3173":2505,"_28139":2417,"_19503":53416,"_5":13343,"_25626":53155,"_2668":53417},[],"Webhooks with file references",{"_3173":2506,"_28139":2417,"_19503":53419,"_5":13343,"_25626":53155,"_2668":53420},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3173":2507,"_28139":2417,"_19503":53422,"_5":13343,"_25626":53155,"_2668":53423},[],"High: enrollments calling the webhook fail",{"_3173":2508,"_28139":2417,"_19503":53425,"_5":13343,"_25626":53155,"_2668":53426},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3173":2509,"_28139":2417,"_19503":53428,"_5":13343,"_25626":53155,"_2668":53180},[],{"_3173":2510,"_28139":2417,"_19503":53430,"_5":13343,"_25626":53155,"_2668":53431},[],"Releases with per-service identity overrides or mounted key material",{"_3173":2511,"_28139":2417,"_19503":53433,"_5":13343,"_25626":53155,"_2668":53434},[],"Medium: services cannot read their files",{"_3173":2512,"_28139":2417,"_19503":53436,"_5":13343,"_25626":53155,"_2668":53437},[],"Remove the overrides and fix volume ownership",{"_3173":2513,"_28139":2417,"_19503":53439,"_5":13343,"_25626":53155,"_2668":53184},[],{"_3173":2514,"_28139":2417,"_19503":53441,"_5":13343,"_25626":53155,"_2668":53442},[],"Releases that set `amqp.tls`",{"_3173":2515,"_28139":2417,"_19503":53444,"_5":13343,"_25626":53155,"_2668":53445},[],"Medium: clients connect to the wrong port",{"_3173":2516,"_28139":2417,"_19503":53447,"_5":13343,"_25626":53155,"_2668":53448},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3173":2517,"_28139":2417,"_19503":53450,"_5":13343,"_25626":53155,"_2668":53204},[],{"_3173":2518,"_28139":2417,"_19503":53452,"_5":13343,"_25626":53155,"_2668":53453},[],"Installations whose CA keys predate the KMS",{"_3173":2519,"_28139":2417,"_19503":53455,"_5":13343,"_25626":53155,"_2668":53456},[],"Medium: CA keys stay unmanaged",{"_3173":2520,"_28139":2417,"_19503":53458,"_5":13343,"_25626":53155,"_2668":53459},[],"Run the CA-to-KMS migration",{"_3173":2521,"_28139":2417,"_19503":53461,"_5":13343,"_25626":53155,"_2668":53462},[],"Receiver certificate verification",{"_3173":2522,"_28139":2417,"_19503":53464,"_5":13343,"_25626":53155,"_2668":53465},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3173":2523,"_28139":2417,"_19503":53467,"_5":13343,"_25626":53155,"_2668":53468},[],"Medium: credentials go to an unverified receiver",{"_3173":2524,"_28139":2417,"_19503":53470,"_5":13343,"_25626":53155,"_2668":53471},[],"Set `insecure_skip_verify` to `false`",{"_3173":2525,"_28139":2417,"_19503":53473,"_5":13343,"_25626":53155,"_2668":53216},[],{"_3173":2526,"_28139":2417,"_19503":53475,"_5":13343,"_25626":53155,"_2668":53476},[],"Scripts and consoles that edit DMSs through the API",{"_3173":2527,"_28139":2417,"_19503":53478,"_5":13343,"_25626":53155,"_2668":53479},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3173":2528,"_28139":2417,"_19503":53481,"_5":13343,"_25626":53155,"_2668":53482},[],"Read the DMS before editing and use the new field",{"_3173":2529,"_28139":2417,"_19503":53484,"_5":13343,"_25626":53155,"_2668":53232},[],{"_3173":2530,"_28139":2417,"_19503":53486,"_5":13343,"_25626":53155,"_2668":53487},[],"Consumers that read the device `events` field",{"_3173":2531,"_28139":2417,"_19503":53489,"_5":13343,"_25626":53155,"_2668":53490},[],"Medium: the field disappears",{"_3173":2532,"_28139":2417,"_19503":53492,"_5":13343,"_25626":53155,"_2668":53493},[],"Use the new event endpoints",{"_3173":2533,"_28139":2417,"_19503":53495,"_5":13343,"_25626":53155,"_2668":53188},[],{"_3173":2534,"_28139":2417,"_19503":53497,"_5":13343,"_25626":53155,"_2668":53498},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3173":2535,"_28139":2417,"_19503":53500,"_5":13343,"_25626":53155,"_2668":53501},[],"Low to medium: validation errors or changed defaults",{"_3173":2536,"_28139":2417,"_19503":53503,"_5":13343,"_25626":53155,"_2668":53504},[],"Update the values file",{"_3173":2537,"_28139":2417,"_19503":53506,"_5":13343,"_25626":53155,"_2668":53224},[],{"_3173":2538,"_28139":2417,"_19503":53508,"_5":13343,"_25626":53155,"_2668":53509},[],"Clients that send the DMS ID in the update body",{"_3173":2539,"_28139":2417,"_19503":53511,"_5":13343,"_25626":53155,"_2668":53512},[],"Low: the ID in the URL wins",{"_3173":2540,"_28139":2417,"_19503":53514,"_5":13343,"_25626":53155,"_2668":53515},[],"Send the ID in the URL",{"_3173":2541,"_28139":2417,"_19503":53517,"_5":13343,"_25626":53155,"_2668":53228},[],{"_3173":2542,"_28139":2417,"_19503":53519,"_5":13343,"_25626":53155,"_2668":53520},[],"Consumers that match on certificate `type`",{"_3173":2543,"_28139":2417,"_19503":53522,"_5":13343,"_25626":53155,"_2668":53523},[],"Low: two values are renamed",{"_3173":2544,"_28139":2417,"_19503":53525,"_5":13343,"_25626":53155,"_2668":53526},[],"Adapt consumers",{"_3173":2545,"_28139":2417,"_19503":53528,"_5":13343,"_25626":53155,"_2668":53220},[],{"_3173":2546,"_28139":2417,"_19503":53530,"_5":13343,"_25626":53155,"_2668":53531},[],"Any DMS",{"_3173":2547,"_28139":2417,"_19503":53533,"_5":13343,"_25626":53155,"_2668":53534},[],"Low: informational",{"_3173":2548,"_28139":2417,"_19503":53536,"_5":13343,"_25626":53155,"_2668":53537},[],"Read both blocks before editing",{"_3173":2549,"_28139":2417,"_19503":53539,"_5":13343,"_25626":53163,"_2668":53540},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3173":2550,"_28139":2417,"_19503":53542,"_5":13343,"_25626":53163,"_2668":53543},[],"Step 4 of the migration guide copies the data.",{"_3173":2551,"_28139":2417,"_19503":53545,"_5":13343,"_25626":53167,"_2668":53546},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3173":2552,"_28139":2417,"_19503":53548,"_5":13343,"_25626":53171,"_2668":53549},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3173":2553,"_28139":2417,"_19503":53551,"_5":13343,"_25626":53175,"_2668":53552},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3173":2554,"_28139":2417,"_19503":53554,"_5":13343,"_25626":53179,"_2668":53555},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3173":2555,"_28139":2417,"_19503":53557,"_5":13343,"_25626":53179,"_2668":53558},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3173":2556,"_28139":2417,"_19503":53560,"_5":13343,"_25626":53183,"_2668":53561},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3173":2557,"_28139":2417,"_19503":53563,"_5":13343,"_25626":53187,"_2668":53564},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3173":2558,"_28139":2417,"_19503":53566,"_5":13343,"_25626":53187,"_2668":53567},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3173":2559,"_28139":2417,"_19503":53569,"_5":13343,"_25626":53187,"_2668":53570},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3173":2560,"_28139":2417,"_19503":53572,"_5":13343,"_25626":53187,"_2668":53573},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3173":2561,"_28139":2417,"_19503":53575,"_5":13343,"_25626":53187,"_2668":53576},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3173":2562,"_28139":2417,"_19503":53578,"_5":13343,"_25626":53187,"_2668":53579},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3173":2563,"_28139":2417,"_19503":53581,"_5":13343,"_25626":53195,"_2668":53582},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3173":2564,"_28139":2417,"_19503":53584,"_5":13343,"_25626":53195,"_2668":53585},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3173":2565,"_28139":2417,"_19503":53587,"_5":13343,"_25626":53195,"_2668":53588},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3173":2566,"_28139":2417,"_19503":53590,"_5":13343,"_25626":53195,"_2668":53591},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3173":2567,"_28139":2417,"_19503":53593,"_5":13343,"_25626":53195,"_2668":53594},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3173":2568,"_28139":2417,"_19503":53596,"_5":13343,"_25626":53199,"_2668":53597},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3173":2569,"_28139":2417,"_19503":53599,"_5":13343,"_25626":53203,"_2668":53600},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3173":2570,"_28139":2417,"_19503":53602,"_5":13343,"_25626":53203,"_2668":53603},[],"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_3173":2571,"_28139":2417,"_19503":53605,"_5":13343,"_25626":53203,"_2668":53606},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3173":2572,"_28139":2417,"_19503":53608,"_5":13343,"_25626":53203,"_2668":53609},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3173":2573,"_28139":2417,"_19503":53611,"_5":13343,"_25626":53203,"_2668":53612},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3173":2574,"_28139":2417,"_19503":53614,"_5":13343,"_25626":53203,"_2668":53615},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3173":2575,"_28139":2417,"_19503":53617,"_5":13343,"_25626":53211,"_2668":53618},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3173":2576,"_28139":2417,"_19503":53620,"_5":13343,"_25626":53211,"_2668":53621},[],"Field in 3.8.0",{"_3173":2577,"_28139":2417,"_19503":53623,"_5":13343,"_25626":53211,"_2668":53624},[],"Field in 4.0.0",{"_3173":2578,"_28139":2417,"_19503":53626,"_5":13343,"_25626":53211,"_2668":53627},[],"`validate_server_cert`",{"_3173":2579,"_28139":2417,"_19503":53629,"_5":13343,"_25626":53211,"_2668":53630},[],"`insecure_skip_verify` (value negated)",{"_3173":2580,"_28139":2417,"_19503":53632,"_5":13343,"_25626":53211,"_2668":53633},[],"`oidc`",{"_3173":2581,"_28139":2417,"_19503":53635,"_5":13343,"_25626":53211,"_2668":53636},[],"`jwt_options`",{"_3173":2582,"_28139":2417,"_19503":53638,"_5":13343,"_25626":53211,"_2668":53639},[],"`apikey`",{"_3173":2583,"_28139":2417,"_19503":53641,"_5":13343,"_25626":53211,"_2668":53642},[],"`apikey_options`",{"_3173":2584,"_28139":2417,"_19503":53644,"_5":13343,"_25626":53211,"_2668":53645},[],"`mtls`",{"_3173":2585,"_28139":2417,"_19503":53647,"_5":13343,"_25626":53211,"_2668":53648},[],"`mtls_options`",{"_3173":2586,"_28139":2417,"_19503":53650,"_5":13343,"_25626":53211,"_2668":53651},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3173":2587,"_28139":2417,"_19503":53653,"_5":13343,"_25626":53211,"_2668":53654},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3173":2588,"_28139":2417,"_19503":53656,"_5":13343,"_25626":53211,"_2668":53657},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3173":2589,"_28139":2417,"_19503":53659,"_5":13343,"_25626":53215,"_2668":53660},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3173":2590,"_28139":2417,"_19503":53662,"_5":13343,"_25626":53215,"_2668":53663},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3173":2591,"_28139":2417,"_19503":53665,"_5":13343,"_25626":53215,"_2668":53666},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3173":2592,"_28139":2417,"_19503":53668,"_5":13343,"_25626":53219,"_2668":53669},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3173":2593,"_28139":2417,"_19503":53671,"_5":13343,"_25626":53223,"_2668":53672},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3173":2594,"_28139":2417,"_19503":53674,"_5":13343,"_25626":53227,"_2668":53675},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3173":2595,"_28139":2417,"_19503":53677,"_5":13343,"_25626":53231,"_2668":53678},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3173":2596,"_28139":2417,"_19503":53680,"_5":13343,"_25626":53231,"_2668":53681},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3173":2597,"_28139":2417,"_19503":53683,"_5":13343,"_25626":53231,"_2668":53684},[],"`POST /v1/devices/:id/events` creates an event.",{"_3173":2598,"_28139":2417,"_19503":53686,"_5":13343,"_25626":53231,"_2668":53687},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3173":2599,"_28139":2417,"_19503":53689,"_5":13343,"_25626":53235,"_2668":53690},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3173":2600,"_28139":2417,"_19503":53692,"_5":13343,"_25626":53239,"_2668":53693},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_3173":2601,"_28139":2417,"_19503":53695,"_5":13343,"_25626":53239,"_2668":53696},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3173":2602,"_28139":2417,"_19503":53698,"_5":13343,"_25626":53239,"_2668":53699},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3173":2603,"_28139":2417,"_19503":53701,"_5":13343,"_25626":53239,"_2668":53702},[],"Record the names of your local-storage PVCs:",{"_3173":2604,"_28139":2417,"_19503":53704,"_5":13343,"_25626":53239,"_2668":53705},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3173":2605,"_28139":2417,"_19503":53707,"_5":13343,"_25626":53243,"_2668":53708},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3173":2606,"_28139":2417,"_19503":53710,"_5":13343,"_25626":53243,"_2668":53711},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3173":2607,"_28139":2417,"_19503":53713,"_5":13343,"_25626":53243,"_2668":53714},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3173":2608,"_28139":2417,"_19503":53716,"_5":13343,"_25626":53243,"_2668":53717},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3173":2609,"_28139":2417,"_19503":53719,"_5":13343,"_25626":53243,"_2668":53720},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3173":2610,"_28139":2417,"_19503":53722,"_5":13343,"_25626":53243,"_2668":53723},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3173":2611,"_28139":2417,"_19503":53725,"_5":13343,"_25626":53243,"_2668":53726},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3173":2612,"_28139":2417,"_19503":53728,"_5":13343,"_25626":53243,"_2668":53729},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3173":2613,"_28139":2417,"_19503":53731,"_5":13343,"_25626":53243,"_2668":53732},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3173":2614,"_28139":2417,"_19503":53734,"_5":13343,"_25626":53243,"_2668":53735},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3173":2615,"_28139":2417,"_19503":53737,"_5":13343,"_25626":53243,"_2668":53738},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3173":2616,"_28139":2417,"_19503":53740,"_5":13343,"_25626":53243,"_2668":53741},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3173":2617,"_28139":2417,"_19503":53743,"_5":13343,"_25626":53247,"_2668":53744},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3173":2618,"_28139":2417,"_19503":53746,"_5":13343,"_25626":53247,"_2668":53747},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3173":2619,"_28139":2417,"_19503":53749,"_5":13343,"_25626":53251,"_2668":53750},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3173":2620,"_28139":2417,"_19503":53752,"_5":13343,"_25626":53251,"_2668":53753},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3173":2621,"_28139":2417,"_19503":53755,"_5":13343,"_25626":53251,"_2668":53756},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3173":2622,"_28139":2417,"_19503":53758,"_5":13343,"_25626":53251,"_2668":53759},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3173":2623,"_28139":2417,"_19503":53761,"_5":13343,"_25626":53251,"_2668":53762},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3173":2624,"_28139":2417,"_19503":53764,"_5":13343,"_25626":53251,"_2668":53765},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3173":2625,"_28139":2417,"_19503":53767,"_5":13343,"_25626":53251,"_2668":53768},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3173":2626,"_28139":2417,"_19503":53770,"_5":13343,"_25626":53251,"_2668":53771},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3173":2627,"_28139":2417,"_19503":53773,"_5":13343,"_25626":53251,"_2668":53774},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3173":2628,"_28139":2417,"_19503":53776,"_5":13343,"_25626":53251,"_2668":53777},[],"**Remove the helper and restore the recorded replica counts:**",{"_3173":2629,"_28139":2417,"_19503":53779,"_5":13343,"_25626":53251,"_2668":53780},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3173":2630,"_28139":2417,"_19503":53782,"_5":13343,"_25626":53255,"_2668":53783},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3173":2631,"_28139":2417,"_19503":53785,"_5":13343,"_25626":53255,"_2668":53786},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3173":2632,"_28139":2417,"_19503":53788,"_5":13343,"_25626":53259,"_2668":53789},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3173":2633,"_28139":2417,"_19503":53791,"_5":13343,"_25626":53259,"_2668":53792},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3173":2634,"_28139":2417,"_19503":53794,"_5":13343,"_25626":53259,"_2668":53795},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3173":2635,"_28139":2417,"_19503":53797,"_5":13343,"_25626":53259,"_2668":53798},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3173":2636,"_28139":2417,"_19503":53800,"_5":13343,"_25626":53259,"_2668":53801},[],"The `goose-lamassu` README still shows per-database examples (`dbname=ca`, `dbname=kms`) and claims the tool validates the database name, and the `ca-to-kms-migration` README still describes the pre-4.0.0 two-database layout. Follow the `dbname=pki` form on this page instead of their examples.",{"_3173":2637,"_28139":2417,"_19503":53803,"_5":13343,"_25626":53263,"_2668":53804},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3173":2638,"_28139":2417,"_19503":53806,"_5":13343,"_25626":53263,"_2668":53807},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3173":2639,"_28139":2417,"_19503":53809,"_5":13343,"_25626":53263,"_2668":53810},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3173":2640,"_28139":2417,"_19503":53812,"_5":13343,"_25626":53263,"_2668":53813},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3173":2641,"_28139":2417,"_19503":53815,"_5":13343,"_25626":53263,"_2668":53816},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_3173":2642,"_28139":2417,"_19503":53818,"_5":13343,"_25626":53263,"_2668":53819},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3173":2643,"_28139":2417,"_19503":53821,"_5":13343,"_25626":53263,"_2668":53822},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3173":2644,"_28139":2417,"_19503":53824,"_5":13343,"_25626":53266,"_2668":53825},[],"After the upgrade, check in this order:",{"_3173":2645,"_28139":2417,"_19503":53827,"_5":13343,"_25626":53266,"_2668":53828},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations.",{"_3173":2646,"_28139":2417,"_19503":53830,"_5":13343,"_25626":53266,"_2668":53831},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3173":2647,"_28139":2417,"_19503":53833,"_5":13343,"_25626":53266,"_2668":53834},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3173":2648,"_28139":2417,"_19503":53836,"_5":13343,"_25626":53266,"_2668":53837},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_3173":2649,"_28139":2417,"_19503":53839,"_5":13343,"_25626":53266,"_2668":53840},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS.",{"_3173":2650,"_28139":2417,"_19503":53842,"_5":13343,"_25626":53266,"_2668":53843},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3173":2651,"_28139":2417,"_19503":53845,"_5":13343,"_25626":53266,"_2668":53846},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3173":2652,"_28139":2417,"_19503":53848,"_5":13343,"_25626":53266,"_2668":53849},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3173":2653,"_28139":2417,"_19503":53851,"_5":13343,"_25626":53266,"_2668":53852},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3173":2654,"_28139":2417,"_19503":53854,"_5":13343,"_25626":53266,"_2668":53855},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3173":2655,"_28139":2417,"_19503":53857,"_5":13343,"_25626":53266,"_2668":53858},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3173":2656,"_28139":2417,"_19503":53860,"_5":13343,"_25626":53266,"_2668":53861},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3173":2657,"_28139":2417,"_19503":53863,"_5":13343,"_25626":53266,"_2668":53864},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3173":2658,"_28139":2417,"_19503":53866,"_5":13343,"_25626":53266,"_2668":53867},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3173":2659,"_28139":2417,"_19503":53869,"_5":13343,"_25626":53270,"_2668":53870},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3173":2660,"_28139":2417,"_19503":53872,"_5":13343,"_25626":53270,"_2668":53873},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3173":2661,"_28139":2417,"_19503":53875,"_5":13343,"_25626":53270,"_2668":53876},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3173":2662,"_28139":2417,"_19503":53878,"_5":13343,"_25626":53270,"_2668":53879},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3173":2663,"_28139":2417,"_19503":53881,"_5":13343,"_25626":53270,"_2668":53882},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_53885":53886,"_53887":53888,"_53889":53890,"_53891":53892,"_16981":2690,"_64502":2690},"language","english","sortableProperties",[2668,28139,5,25626],"sortablePropertiesWithTypes",{"_2668":23326,"_28139":23326,"_5":23326,"_25626":23326},"sorts",{"_2668":53893,"_28139":56546,"_5":59198,"_25626":61850},{"_4264":53894,"_53895":53896,"_5":23326},{"_13398":5567,"_13773":6848,"_13792":6908,"_12008":3016,"_13779":2876,"_18509":16922,"_13419":3235,"_13426":3045,"_27178":3144,"_27569":4070,"_27590":3835,"_27196":5441,"_32265":5092,"_27601":8659,"_27630":18770,"_32272":27774,"_32275":14629,"_32278":4069,"_32281":17452,"_27976":13853,"_32286":7882,"_32288":11231,"_28006":6923,"_13788":2934,"_32292":12277,"_32295":3869,"_32297":4388,"_27619":10181,"_27971":7884,"_28019":11204,"_32302":5501,"_32304":4241,"_32306":4892,"_32308":2767,"_32310":6947,"_32312":3963,"_32314":2973,"_32316":3362,"_32318":5489,"_27248":20038,"_32321":4377,"_32323":3218,"_27242":3053,"_32326":18771,"_32328":4681,"_32330":6899,"_32333":11307,"_27288":15503,"