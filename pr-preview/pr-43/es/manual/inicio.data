.json","<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-cloud shrink-0\" aria-hidden=\"true\"><path d=\"M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z\"></path></svg>","es:platform/iot-fleets",{"_199":318},"platform/iot-fleets/meta.json","<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-cpu shrink-0\" aria-hidden=\"true\"><path d=\"M12 20v2\"></path><path d=\"M12 2v2\"></path><path d=\"M17 20v2\"></path><path d=\"M17 2v2\"></path><path d=\"M2 12h2\"></path><path d=\"M2 17h2\"></path><path d=\"M2 7h2\"></path><path d=\"M20 12h2\"></path><path d=\"M20 17h2\"></path><path d=\"M20 7h2\"></path><path d=\"M7 20v2\"></path><path d=\"M7 2v2\"></path><rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"2\"></rect><rect x=\"8\" y=\"8\" width=\"8\" height=\"8\" rx=\"1\"></rect></svg>",{"_42":321,"_49":60,"_44":210,"_54":322,"_63":-7,"_13":323,"_65":324},"es:platform/iot-fleets/overview.mdx","Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.","/docs/pr-preview/pr-43/es/platform/iot-fleets/overview",{"_67":325},"platform/iot-fleets/overview.mdx",{"_49":50,"_44":327,"_51":-7,"_53":-7,"_54":-7,"_56":-7,"_46":328,"_42":350,"_65":351,"_63":-7},"Administración",[329,336,343],{"_42":330,"_49":60,"_44":331,"_54":332,"_63":-7,"_13":333,"_65":334},"es:platform/administration/access-control.mdx","Control de acceso","Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.","/docs/pr-preview/pr-43/es/platform/administration/access-control",{"_67":335},"platform/administration/access-control.mdx",{"_42":337,"_49":60,"_44":338,"_54":339,"_