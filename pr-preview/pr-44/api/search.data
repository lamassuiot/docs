"_33459":102772,"_33461":102775,"_33463":102778,"_33465":102781,"_33467":102784,"_33469":102787,"_33471":102789,"_33473":102792,"_33475":102795,"_33477":102798,"_33479":102801,"_33481":102804,"_33483":102807,"_33485":102810,"_33487":102813,"_33489":102816,"_33491":102819,"_33493":102824,"_33495":102827,"_33497":102831,"_33499":102835,"_33501":102839,"_33503":102842,"_33505":102845,"_33507":102847,"_33509":102849,"_33511":102851,"_33513":102853,"_33515":102856,"_33517":102859,"_33519":102862,"_33521":102865,"_33523":102868,"_33525":102870,"_33527":102873,"_33529":102875,"_33531":102878,"_33533":102881,"_33535":102884,"_33537":102886,"_33539":102889,"_33541":102892,"_33543":102895,"_33545":102898,"_33547":102901,"_33549":102904,"_33551":102907,"_33553":102910,"_33555":102913,"_33557":102916,"_33559":102919,"_33561":102922},{"_2856":57649,"_25058":57649,"_5":12268,"_2383":95663,"_25394":95664,"_17494":95667,"_23725":57649},"Despliega desde AWS Marketplace",[40730,95665,95666],"Despliegue","Otros modelos",[],{"_2856":57650,"_25058":57649,"_17494":95669,"_5":17389,"_23725":57649,"_2383":95670},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_2856":57651,"_25058":57649,"_5":25391,"_17494":95672,"_23725":95673,"_2383":95674},[],"/docs/pr-preview/pr-44/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_2856":57652,"_25058":57649,"_5":25391,"_17494":95676,"_23725":95677,"_2383":95678},[],"/docs/pr-preview/pr-44/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_2856":57653,"_25058":57649,"_5":25391,"_17494":95680,"_23725":95681,"_2383":95682},[],"/docs/pr-preview/pr-44/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_2856":57654,"_25058":57649,"_5":25391,"_17494":95684,"_23725":95685,"_2383":95686},[],"/docs/pr-preview/pr-44/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_2856":57655,"_25058":57649,"_5":25391,"_17494":95688,"_23725":95689,"_2383":95690},[],"/docs/pr-preview/pr-44/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_2856":57656,"_25058":57649,"_5":25391,"_17494":95692,"_23725":95693,"_2383":95694},[],"/docs/pr-preview/pr-44/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_2856":57657,"_25058":57649,"_5":25391,"_17494":95696,"_23725":95697,"_2383":95698},[],"/docs/pr-preview/pr-44/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_2856":57658,"_25058":57649,"_17494":95700,"_5":17389,"_23725":57649,"_2383":95701},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_2856":57659,"_25058":57649,"_17494":95703,"_5":17389,"_23725":95673,"_2383":95704},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_2856":57660,"_25058":57649,"_17494":95706,"_5":17389,"_23725":95673,"_2383":95707},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_2856":57661,"_25058":57649,"_17494":95709,"_5":17389,"_23725":95673,"_2383":95710},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_2856":57662,"_25058":57649,"_17494":95712,"_5":17389,"_23725":95677,"_2383":95713},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_2856":57663,"_25058":57649,"_17494":95715,"_5":17389,"_23725":95677,"_2383":95716},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_2856":57664,"_25058":57649,"_17494":95718,"_5":17389,"_23725":95677,"_2383":95719},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_2856":57665,"_25058":57649,"_17494":95721,"_5":17389,"_23725":95681,"_2383":95722},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_2856":57666,"_25058":57649,"_17494":95724,"_5":17389,"_23725":95685,"_2383":95725},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_2856":57667,"_25058":57649,"_17494":95727,"_5":17389,"_23725":95689,"_2383":95728},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_2856":57668,"_25058":57649,"_17494":95730,"_5":17389,"_23725":95693,"_2383":95731},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_2856":57669,"_25058":57649,"_17494":95733,"_5":17389,"_23725":95697,"_2383":95734},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_2856":57670,"_25058":57670,"_5":12268,"_2383":95736,"_25394":95737,"_17494":95738,"_23725":57670},"Despliega Lamassu",[40730,95665],[],{"_2856":57671,"_25058":57670,"_17494":95740,"_5":17389,"_23725":57670,"_2383":95741},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_2856":57672,"_25058":57670,"_5":25391,"_17494":95743,"_23725":95744,"_2383":95745},[],"/docs/pr-preview/pr-44/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_2856":57673,"_25058":57670,"_5":25391,"_17494":95747,"_23725":95748,"_2383":95749},[],"/docs/pr-preview/pr-44/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_2856":57674,"_25058":57670,"_5":25391,"_17494":95751,"_23725":95752,"_2383":95753},[],"/docs/pr-preview/pr-44/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_2856":57675,"_25058":57670,"_17494":95755,"_5":17389,"_23725":57670,"_2383":95756},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_2856":57676,"_25058":57670,"_17494":95758,"_5":17389,"_23725":95744,"_2383":95759},[],"Modelo",{"_2856":57677,"_25058":57670,"_17494":95761,"_5":17389,"_23725":95744,"_2383":95762},[],"Recomendado para",{"_2856":57678,"_25058":57670,"_17494":95764,"_5":17389,"_23725":95744,"_2383":95765},[],"Quién opera la infraestructura",{"_2856":57679,"_25058":57670,"_17494":95767,"_5":17389,"_23725":95744,"_2383":95768},[],"Punto de partida",{"_2856":57680,"_25058":57670,"_17494":95770,"_5":17389,"_23725":95744,"_2383":40837},[],{"_2856":57681,"_25058":57670,"_17494":95772,"_5":17389,"_23725":95744,"_2383":95773},[],"Producción, entornos regulados y despliegues personalizados",{"_2856":57682,"_25058":57670,"_17494":95775,"_5":17389,"_23725":95744,"_2383":95776},[],"Tu equipo",{"_2856":57683,"_25058":57670,"_17494":95778,"_5":17389,"_23725":95744,"_2383":95779},[],"Helm o Fastlane",{"_2856":57684,"_25058":57670,"_17494":95781,"_5":17389,"_23725":95744,"_2383":40849},[],{"_2856":57685,"_25058":57670,"_17494":95783,"_5":17389,"_23725":95744,"_2383":95784},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_2856":57686,"_25058":57670,"_17494":95786,"_5":17389,"_23725":95744,"_2383":95776},[],{"_2856":57687,"_25058":57670,"_17494":95788,"_5":17389,"_23725":95744,"_2383":95789},[],"Imagen preconfigurada en EC2",{"_2856":57688,"_25058":57670,"_17494":95791,"_5":17389,"_23725":95744,"_2383":40860},[],{"_2856":57689,"_25058":57670,"_17494":95793,"_5":17389,"_23725":95744,"_2383":95794},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_2856":57690,"_25058":57670,"_17494":95796,"_5":17389,"_23725":95744,"_2383":40866},[],{"_2856":57691,"_25058":57670,"_17494":95798,"_5":17389,"_23725":95744,"_2383":95799},[],"Suscripción gestionada",{"_2856":57692,"_25058":57670,"_17494":95801,"_5":17389,"_23725":95744,"_2383":95802},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2856":57693,"_25058":57670,"_17494":95804,"_5":17389,"_23725":95744,"_2383":95805},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2856":57694,"_25058":57670,"_17494":95807,"_5":17389,"_23725":95744,"_2383":95808},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_2856":57695,"_25058":57670,"_17494":95810,"_5":17389,"_23725":95748,"_2383":95811},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_2856":57696,"_25058":57670,"_17494":95813,"_5":17389,"_23725":95752,"_2383":95814},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_2856":57697,"_25058":57697,"_5":12268,"_2383":95816,"_25394":95817,"_17494":95818,"_23725":57697},"Utiliza Lamassu como SaaS",[40730,95665,95666],[],{"_2856":57698,"_25058":57697,"_17494":95820,"_5":17389,"_23725":57697,"_2383":95821},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_2856":57699,"_25058":57697,"_5":25391,"_17494":95823,"_23725":95824,"_2383":95825},[],"/docs/pr-preview/pr-44/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_2856":57700,"_25058":57697,"_5":25391,"_17494":95827,"_23725":95828,"_2383":95829},[],"/docs/pr-preview/pr-44/es/deployment/saas#planes","Planes",{"_2856":57701,"_25058":57697,"_5":25391,"_17494":95831,"_23725":95832,"_2383":95833},[],"/docs/pr-preview/pr-44/es/deployment/saas#solicita-acceso","Solicita acceso",{"_2856":57702,"_25058":57697,"_17494":95835,"_5":17389,"_23725":57697,"_2383":95836},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_2856":57703,"_25058":57697,"_17494":95838,"_5":17389,"_23725":95824,"_2383":95839},[],"Disponibilidad y mantenimiento de la plataforma.",{"_2856":57704,"_25058":57697,"_17494":95841,"_5":17389,"_23725":95824,"_2383":95842},[],"Copias de seguridad automáticas.",{"_2856":57705,"_25058":57697,"_17494":95844,"_5":17389,"_23725":95824,"_2383":95845},[],"Actualizaciones de versión.",{"_2856":57706,"_25058":57697,"_17494":95847,"_5":17389,"_23725":95824,"_2383":95848},[],"Soporte técnico y SLA según el plan contratado.",{"_2856":57707,"_25058":57697,"_17494":95850,"_5":17389,"_23725":95828,"_2383":40921},[],{"_2856":57708,"_25058":57697,"_17494":95852,"_5":17389,"_23725":95828,"_2383":95853},[],"Dispositivos",{"_2856":57709,"_25058":57697,"_17494":95855,"_5":17389,"_23725":95828,"_2383":95856},[],"Soporte",{"_2856":57710,"_25058":57697,"_17494":95858,"_5":17389,"_23725":95828,"_2383":40930},[],{"_2856":57711,"_25058":57697,"_17494":95860,"_5":17389,"_23725":95828,"_2383":40933},[],{"_2856":57712,"_25058":57697,"_17494":95862,"_5":17389,"_23725":95828,"_2383":95863},[],"Hasta 1.000",{"_2856":57713,"_25058":57697,"_17494":95865,"_5":17389,"_23725":95828,"_2383":40939},[],{"_2856":57714,"_25058":57697,"_17494":95867,"_5":17389,"_23725":95828,"_2383":95868},[],"99,5 %",{"_2856":57715,"_25058":57697,"_17494":95870,"_5":17389,"_23725":95828,"_2383":40945},[],{"_2856":57716,"_25058":57697,"_17494":95872,"_5":17389,"_23725":95828,"_2383":95873},[],"Hasta 10.000",{"_2856":57717,"_25058":57697,"_17494":95875,"_5":17389,"_23725":95828,"_2383":95876},[],"Email y chat",{"_2856":57718,"_25058":57697,"_17494":95878,"_5":17389,"_23725":95828,"_2383":95879},[],"99,9 %",{"_2856":57719,"_25058":57697,"_17494":95881,"_5":17389,"_23725":95828,"_2383":40957},[],{"_2856":57720,"_25058":57697,"_17494":95883,"_5":17389,"_23725":95828,"_2383":95884},[],"Ilimitados",{"_2856":57721,"_25058":57697,"_17494":95886,"_5":17389,"_23725":95828,"_2383":95887},[],"Dedicado",{"_2856":57722,"_25058":57697,"_17494":95889,"_5":17389,"_23725":95828,"_2383":95890},[],"99,99 %",{"_2856":57723,"_25058":57697,"_17494":95892,"_5":17389,"_23725":95832,"_2383":95893},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_2856":57724,"_25058":57697,"_17494":95895,"_5":17389,"_23725":95832,"_2383":95896},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_2856":57725,"_25058":57725,"_5":12268,"_2383":40974,"_25394":95898,"_17494":95900,"_23725":57725},[40730,95665,95899],"Kubernetes autogestionado",[],{"_2856":57726,"_25058":57725,"_17494":95902,"_5":17389,"_23725":57725,"_2383":95903},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_2856":57727,"_25058":57725,"_5":25391,"_17494":95905,"_23725":95906,"_2383":95907},[],"/docs/pr-preview/pr-44/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_2856":57728,"_25058":57725,"_5":25391,"_17494":95909,"_23725":95910,"_2383":95911},[],"/docs/pr-preview/pr-44/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_2856":57729,"_25058":57725,"_5":25391,"_17494":95913,"_23725":95914,"_2383":95915},[],"/docs/pr-preview/pr-44/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_2856":57730,"_25058":57725,"_5":25391,"_17494":95917,"_23725":95918,"_2383":95919},[],"/docs/pr-preview/pr-44/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_2856":57731,"_25058":57725,"_5":25391,"_17494":95921,"_23725":95922,"_2383":95923},[],"/docs/pr-preview/pr-44/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_2856":57732,"_25058":57725,"_5":25391,"_17494":95925,"_23725":95926,"_2383":95927},[],"/docs/pr-preview/pr-44/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_2856":57733,"_25058":57725,"_5":25391,"_17494":95929,"_23725":95930,"_2383":95931},[],"/docs/pr-preview/pr-44/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_2856":57734,"_25058":57725,"_5":25391,"_17494":95933,"_23725":95934,"_2383":95935},[],"/docs/pr-preview/pr-44/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_2856":57735,"_25058":57725,"_5":25391,"_17494":95937,"_23725":95938,"_2383":95939},[],"/docs/pr-preview/pr-44/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_2856":57736,"_25058":57725,"_5":25391,"_17494":95941,"_23725":95942,"_2383":95943},[],"/docs/pr-preview/pr-44/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_2856":57737,"_25058":57725,"_17494":95945,"_5":17389,"_23725":95906,"_2383":95946},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_2856":57738,"_25058":57725,"_17494":95948,"_5":17389,"_23725":95906,"_2383":95949},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_2856":57739,"_25058":57725,"_17494":95951,"_5":17389,"_23725":95910,"_2383":95952},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_2856":57740,"_25058":57725,"_17494":95954,"_5":17389,"_23725":95910,"_2383":95955},[],"Fastlane instala o configura",{"_2856":57741,"_25058":57725,"_17494":95957,"_5":17389,"_23725":95910,"_2383":95958},[],"Tú sigues proporcionando",{"_2856":57742,"_25058":57725,"_17494":95960,"_5":17389,"_23725":95910,"_2383":95961},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_2856":57743,"_25058":57725,"_17494":95963,"_5":17389,"_23725":95910,"_2383":95964},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_2856":57744,"_25058":57725,"_17494":95966,"_5":17389,"_23725":95910,"_2383":95967},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_2856":57745,"_25058":57725,"_17494":95969,"_5":17389,"_23725":95910,"_2383":95970},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_2856":57746,"_25058":57725,"_17494":95972,"_5":17389,"_23725":95910,"_2383":95973},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_2856":57747,"_25058":57725,"_17494":95975,"_5":17389,"_23725":95910,"_2383":95976},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_2856":57748,"_25058":57725,"_17494":95978,"_5":17389,"_23725":95910,"_2383":95979},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_2856":57749,"_25058":57725,"_17494":95981,"_5":17389,"_23725":95910,"_2383":95982},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_2856":57750,"_25058":57725,"_17494":95984,"_5":17389,"_23725":95910,"_2383":95985},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_2856":57751,"_25058":57725,"_17494":95987,"_5":17389,"_23725":95914,"_2383":95988},[],"Necesitas:",{"_2856":57752,"_25058":57725,"_17494":95990,"_5":17389,"_23725":95914,"_2383":95991},[],"un clúster Kubernetes existente",{"_2856":57753,"_25058":57725,"_17494":95993,"_5":17389,"_23725":95914,"_2383":95994},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_2856":57754,"_25058":57725,"_17494":95996,"_5":17389,"_23725":95914,"_2383":41072},[],{"_2856":57755,"_25058":57725,"_17494":95998,"_5":17389,"_23725":95914,"_2383":19799},[],{"_2856":57756,"_25058":57725,"_17494":96000,"_5":17389,"_23725":95914,"_2383":96001},[],"`jq` solo si usas `--sample-data`",{"_2856":57757,"_25058":57725,"_17494":96003,"_5":17389,"_23725":95914,"_2383":96004},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_2856":57758,"_25058":57725,"_17494":96006,"_5":17389,"_23725":95914,"_2383":96007},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_2856":57759,"_25058":57725,"_17494":96009,"_5":17389,"_23725":95914,"_2383":96010},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_2856":57760,"_25058":57725,"_17494":96012,"_5":17389,"_23725":95918,"_2383":96013},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_2856":57761,"_25058":57725,"_17494":96015,"_5":17389,"_23725":95918,"_2383":96016},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_2856":57762,"_25058":57725,"_17494":96018,"_5":17389,"_23725":95922,"_2383":96019},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_2856":57763,"_25058":57725,"_17494":96021,"_5":17389,"_23725":95922,"_2383":96022},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_2856":57764,"_25058":57725,"_17494":96024,"_5":17389,"_23725":95922,"_2383":96025},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_2856":57765,"_25058":57725,"_17494":96027,"_5":17389,"_23725":95922,"_2383":96028},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_2856":57766,"_25058":57725,"_17494":96030,"_5":17389,"_23725":95926,"_2383":96031},[],"Opción",{"_2856":57767,"_25058":57725,"_17494":96033,"_5":17389,"_23725":95926,"_2383":96034},[],"Valor predeterminado",{"_2856":57768,"_25058":57725,"_17494":96036,"_5":17389,"_23725":95926,"_2383":96037},[],"Propósito",{"_2856":57769,"_25058":57725,"_17494":96039,"_5":17389,"_23725":95926,"_2383":41116},[],{"_2856":57770,"_25058":57725,"_17494":96041,"_5":17389,"_23725":95926,"_2383":41119},[],{"_2856":57771,"_25058":57725,"_17494":96043,"_5":17389,"_23725":95926,"_2383":96044},[],"Muestra la ayuda",{"_2856":57772,"_25058":57725,"_17494":96046,"_5":17389,"_23725":95926,"_2383":41125},[],{"_2856":57773,"_25058":57725,"_17494":96048,"_5":17389,"_23725":95926,"_2383":96049},[],"contexto actual",{"_2856":57774,"_25058":57725,"_17494":96051,"_5":17389,"_23725":95926,"_2383":96052},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_2856":57775,"_25058":57725,"_17494":96054,"_5":17389,"_23725":95926,"_2383":41134},[],{"_2856":57776,"_25058":57725,"_17494":96056,"_5":17389,"_23725":95926,"_2383":5347},[],{"_2856":57777,"_25058":57725,"_17494":96058,"_5":17389,"_23725":95926,"_2383":96059},[],"Omite prompts y genera credenciales para las dependencias",{"_2856":57778,"_25058":57725,"_17494":96061,"_5":17389,"_23725":95926,"_2383":41142},[],{"_2856":57779,"_25058":57725,"_17494":96063,"_5":17389,"_23725":95926,"_2383":41145},[],{"_2856":57780,"_25058":57725,"_17494":96065,"_5":17389,"_23725":95926,"_2383":96066},[],"Namespace de la instalación",{"_2856":57781,"_25058":57725,"_17494":96068,"_5":17389,"_23725":95926,"_2383":41151},[],{"_2856":57782,"_25058":57725,"_17494":96070,"_5":17389,"_23725":95926,"_2383":41154},[],{"_2856":57783,"_25058":57725,"_17494":96072,"_5":17389,"_23725":95926,"_2383":96073},[],"Dominio usado por la UI, OIDC y el certificado",{"_2856":57784,"_25058":57725,"_17494":96075,"_5":17389,"_23725":95926,"_2383":41160},[],{"_2856":57785,"_25058":57725,"_17494":96077,"_5":17389,"_23725":95926,"_2383":12494},[],{"_2856":57786,"_25058":57725,"_17494":96079,"_5":17389,"_23725":95926,"_2383":96080},[],"Versión del chart de Lamassu",{"_2856":57787,"_25058":57725,"_17494":96082,"_5":17389,"_23725":95926,"_2383":41168},[],{"_2856":57788,"_25058":57725,"_17494":96084,"_5":17389,"_23725":95926,"_2383":41171},[],{"_2856":57789,"_25058":57725,"_17494":96086,"_5":17389,"_23725":95926,"_2383":96087},[],"Puerto del listener HTTPS",{"_2856":57790,"_25058":57725,"_17494":96089,"_5":17389,"_23725":95926,"_2383":41177},[],{"_2856":57791,"_25058":57725,"_17494":96091,"_5":17389,"_23725":95926,"_2383":41180},[],{"_2856":57792,"_25058":57725,"_17494":96093,"_5":17389,"_23725":95926,"_2383":96094},[],"Puerto del listener HTTP",{"_2856":57793,"_25058":57725,"_17494":96096,"_5":17389,"_23725":95926,"_2383":41186},[],{"_2856":57794,"_25058":57725,"_17494":96098,"_5":17389,"_23725":95926,"_2383":41119},[],{"_2856":57795,"_25058":57725,"_17494":96100,"_5":17389,"_23725":95926,"_2383":96101},[],"Certificado PEM para TLS downstream",{"_2856":57796,"_25058":57725,"_17494":96103,"_5":17389,"_23725":95926,"_2383":41194},[],{"_2856":57797,"_25058":57725,"_17494":96105,"_5":17389,"_23725":95926,"_2383":41119},[],{"_2856":57798,"_25058":57725,"_17494":96107,"_5":17389,"_23725":95926,"_2383":96108},[],"Clave privada PEM para TLS downstream",{"_2856":57799,"_25058":57725,"_17494":96110,"_5":17389,"_23725":95926,"_2383":41202},[],{"_2856":57800,"_25058":57725,"_17494":96112,"_5":17389,"_23725":95926,"_2383":96113},[],"chart del repositorio",{"_2856":57801,"_25058":57725,"_17494":96115,"_5":17389,"_23725":95926,"_2383":96116},[],"Usa un chart local de Lamassu sin empaquetar",{"_2856":57802,"_25058":57725,"_17494":96118,"_5":17389,"_23725":95926,"_2383":41211},[],{"_2856":57803,"_25058":57725,"_17494":96120,"_5":17389,"_23725":95926,"_2383":96121},[],"detección automática",{"_2856":57804,"_25058":57725,"_17494":96123,"_5":17389,"_23725":95926,"_2383":96124},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_2856":57805,"_25058":57725,"_17494":96126,"_5":17389,"_23725":95926,"_2383":41219},[],{"_2856":57806,"_25058":57725,"_17494":96128,"_5":17389,"_23725":95926,"_2383":5347},[],{"_2856":57807,"_25058":57725,"_17494":96130,"_5":17389,"_23725":95926,"_2383":96131},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_2856":57808,"_25058":57725,"_17494":96133,"_5":17389,"_23725":95926,"_2383":41227},[],{"_2856":57809,"_25058":57725,"_17494":96135,"_5":17389,"_23725":95926,"_2383":5347},[],{"_2856":57810,"_25058":57725,"_17494":96137,"_5":17389,"_23725":95926,"_2383":96138},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_2856":57811,"_25058":57725,"_17494":96140,"_5":17389,"_23725":95926,"_2383":41235},[],{"_2856":57812,"_25058":57725,"_17494":96142,"_5":17389,"_23725":95926,"_2383":5347},[],{"_2856":57813,"_25058":57725,"_17494":96144,"_5":17389,"_23725":95926,"_2383":96145},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_2856":57814,"_25058":57725,"_17494":96147,"_5":17389,"_23725":95926,"_2383":41243},[],{"_2856":57815,"_25058":57725,"_17494":96149,"_5":17389,"_23725":95926,"_2383":41246},[],{"_2856":57816,"_25058":57725,"_17494":96151,"_5":17389,"_23725":95926,"_2383":96152},[],"Usa otro chart local de SoftHSM",{"_2856":57817,"_25058":57725,"_17494":96154,"_5":17389,"_23725":95926,"_2383":96155},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_2856":57818,"_25058":57725,"_17494":96157,"_5":17389,"_23725":95930,"_2383":41255},[],{"_2856":57819,"_25058":57725,"_17494":96159,"_5":17389,"_23725":95930,"_2383":96160},[],"valida las herramientas locales y el clúster seleccionado",{"_2856":57820,"_25058":57725,"_17494":96162,"_5":17389,"_23725":95930,"_2383":96163},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_2856":57821,"_25058":57725,"_17494":96165,"_5":17389,"_23725":95930,"_2383":96166},[],"crea el namespace",{"_2856":57822,"_25058":57725,"_17494":96168,"_5":17389,"_23725":95930,"_2383":96169},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_2856":57823,"_25058":57725,"_17494":96171,"_5":17389,"_23725":95930,"_2383":96172},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_2856":57824,"_25058":57725,"_17494":96174,"_5":17389,"_23725":95930,"_2383":96175},[],"instala RabbitMQ",{"_2856":57825,"_25058":57725,"_17494":96177,"_5":17389,"_23725":95930,"_2383":96178},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_2856":57826,"_25058":57725,"_17494":96180,"_5":17389,"_23725":95930,"_2383":96181},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_2856":57827,"_25058":57725,"_17494":96183,"_5":17389,"_23725":95930,"_2383":96184},[],"carga datos de ejemplo opcionalmente",{"_2856":57828,"_25058":57725,"_17494":96186,"_5":17389,"_23725":95930,"_2383":96187},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_2856":57829,"_25058":57725,"_17494":96189,"_5":17389,"_23725":95934,"_2383":96190},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_2856":57830,"_25058":57725,"_17494":96192,"_5":17389,"_23725":95934,"_2383":96193},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_2856":57831,"_25058":57725,"_17494":96195,"_5":17389,"_23725":95938,"_2383":96196},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso.",{"_2856":57832,"_25058":57725,"_17494":96198,"_5":17389,"_23725":95938,"_2383":96199},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_2856":57833,"_25058":57725,"_17494":96201,"_5":17389,"_23725":95938,"_2383":96202},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_2856":57834,"_25058":57725,"_17494":96204,"_5":17389,"_23725":95942,"_2383":96205},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_2856":57835,"_25058":57835,"_5":12268,"_2383":96207,"_25394":96208,"_17494":96209,"_23725":57835},"Instala con Helm",[40730,95665,95899],[],{"_2856":57836,"_25058":57835,"_17494":96211,"_5":17389,"_23725":57835,"_2383":96212},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_2856":57837,"_25058":57835,"_5":25391,"_17494":96214,"_23725":96215,"_2383":96216},[],"/docs/pr-preview/pr-44/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_2856":57838,"_25058":57835,"_5":25391,"_17494":96218,"_23725":96219,"_2383":95915},[],"/docs/pr-preview/pr-44/es/deployment/self-hosted/helm#antes-de-comenzar",{"_2856":57839,"_25058":57835,"_5":25391,"_17494":96221,"_23725":96222,"_2383":96223},[],"/docs/pr-preview/pr-44/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_2856":57840,"_25058":57835,"_5":25391,"_17494":96225,"_23725":96226,"_2383":96227},[],"/docs/pr-preview/pr-44/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_2856":57841,"_25058":57835,"_5":25391,"_17494":96229,"_23725":96230,"_2383":96231},[],"/docs/pr-preview/pr-44/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_2856":57842,"_25058":57835,"_5":25391,"_17494":96233,"_23725":96234,"_2383":96235},[],"/docs/pr-preview/pr-44/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_2856":57843,"_25058":57835,"_5":25391,"_17494":96237,"_23725":96238,"_2383":96239},[],"/docs/pr-preview/pr-44/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_2856":57844,"_25058":57835,"_5":25391,"_17494":96241,"_23725":96242,"_2383":96243},[],"/docs/pr-preview/pr-44/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_2856":57845,"_25058":57835,"_5":25391,"_17494":96245,"_23725":96246,"_2383":96247},[],"/docs/pr-preview/pr-44/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_2856":57846,"_25058":57835,"_17494":96249,"_5":17389,"_23725":96215,"_2383":96250},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_2856":57847,"_25058":57835,"_17494":96252,"_5":17389,"_23725":96219,"_2383":96253},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_2856":57848,"_25058":57835,"_17494":96255,"_5":17389,"_23725":96219,"_2383":96256},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_2856":57849,"_25058":57835,"_17494":96258,"_5":17389,"_23725":96219,"_2383":96259},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_2856":57850,"_25058":57835,"_17494":96261,"_5":17389,"_23725":96219,"_2383":96262},[],"un broker RabbitMQ accesible y sus credenciales",{"_2856":57851,"_25058":57835,"_17494":96264,"_5":17389,"_23725":96219,"_2383":96265},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_2856":57852,"_25058":57835,"_17494":96267,"_5":17389,"_23725":96219,"_2383":96268},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_2856":57853,"_25058":57835,"_17494":96270,"_5":17389,"_23725":96219,"_2383":96271},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_2856":57854,"_25058":57835,"_17494":96273,"_5":17389,"_23725":96219,"_2383":96274},[],"una StorageClass y un diseño de tráfico externo",{"_2856":57855,"_25058":57835,"_17494":96276,"_5":17389,"_23725":96219,"_2383":96277},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_2856":57856,"_25058":57835,"_17494":96279,"_5":17389,"_23725":96219,"_2383":96280},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_2856":57857,"_25058":57835,"_17494":96282,"_5":17389,"_23725":96219,"_2383":96283},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_2856":57858,"_25058":57835,"_17494":96285,"_5":17389,"_23725":96222,"_2383":96286},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_2856":57859,"_25058":57835,"_17494":96288,"_5":17389,"_23725":96222,"_2383":96289},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_2856":57860,"_25058":57835,"_17494":96291,"_5":17389,"_23725":96222,"_2383":96292},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_2856":57861,"_25058":57835,"_17494":96294,"_5":17389,"_23725":96226,"_2383":96295},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_2856":57862,"_25058":57835,"_17494":96297,"_5":17389,"_23725":96226,"_2383":96298},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_2856":57863,"_25058":57835,"_17494":96300,"_5":17389,"_23725":96226,"_2383":96301},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_2856":57864,"_25058":57835,"_17494":96303,"_5":17389,"_23725":96230,"_2383":96304},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_2856":57865,"_25058":57835,"_17494":96306,"_5":17389,"_23725":96234,"_2383":96307},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_2856":57866,"_25058":57835,"_17494":96309,"_5":17389,"_23725":96234,"_2383":96310},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_2856":57867,"_25058":57835,"_17494":96312,"_5":17389,"_23725":96234,"_2383":96313},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_2856":57868,"_25058":57835,"_17494":96315,"_5":17389,"_23725":96234,"_2383":96316},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_2856":57869,"_25058":57835,"_17494":96318,"_5":17389,"_23725":96238,"_2383":96319},[],"Para instalar un checkout local:",{"_2856":57870,"_25058":57835,"_17494":96321,"_5":17389,"_23725":96242,"_2383":96322},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_2856":57871,"_25058":57835,"_17494":96324,"_5":17389,"_23725":96242,"_2383":96325},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_2856":57872,"_25058":57835,"_17494":96327,"_5":17389,"_23725":96246,"_2383":96328},[],"Antes de pasar a producción, revisa:",{"_2856":57873,"_25058":57835,"_17494":96330,"_5":17389,"_23725":96246,"_2383":96331},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_2856":57874,"_25058":57835,"_17494":96333,"_5":17389,"_23725":96246,"_2383":96334},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_2856":57875,"_25058":57835,"_17494":96336,"_5":17389,"_23725":96246,"_2383":96337},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_2856":57876,"_25058":57835,"_17494":96339,"_5":17389,"_23725":96246,"_2383":96340},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_2856":57877,"_25058":57835,"_17494":96342,"_5":17389,"_23725":96246,"_2383":96343},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_2856":57878,"_25058":57835,"_17494":96345,"_5":17389,"_23725":96246,"_2383":96346},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_2856":57879,"_25058":57835,"_17494":96348,"_5":17389,"_23725":96246,"_2383":96349},[],"SMTP, observabilidad y entrega de alertas",{"_2856":57880,"_25058":57835,"_17494":96351,"_5":17389,"_23725":96246,"_2383":96352},[],"las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_2856":57881,"_25058":57835,"_17494":96354,"_5":17389,"_23725":96246,"_2383":96355},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_2856":57882,"_25058":57882,"_5":12268,"_2383":96357,"_25394":96358,"_17494":96359,"_23725":57882},"Expón el Gateway",[40730,95665,95899],[],{"_2856":57883,"_25058":57882,"_17494":96361,"_5":17389,"_23725":57882,"_2383":96362},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_2856":57884,"_25058":57882,"_5":25391,"_17494":96364,"_23725":96365,"_2383":96366},[],"/docs/pr-preview/pr-44/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_2856":57885,"_25058":57882,"_5":25391,"_17494":96368,"_23725":96369,"_2383":96370},[],"/docs/pr-preview/pr-44/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_2856":57886,"_25058":57882,"_5":25391,"_17494":96372,"_23725":96373,"_2383":96374},[],"/docs/pr-preview/pr-44/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_2856":57887,"_25058":57882,"_5":25391,"_17494":96376,"_23725":96377,"_2383":41476},[],"/docs/pr-preview/pr-44/es/deployment/self-hosted/networking#k3s",{"_2856":57888,"_25058":57882,"_5":25391,"_17494":96379,"_23725":96380,"_2383":96381},[],"/docs/pr-preview/pr-44/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_2856":57889,"_25058":57882,"_5":25391,"_17494":96383,"_23725":96384,"_2383":96385},[],"/docs/pr-preview/pr-44/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_2856":57890,"_25058":57882,"_5":25391,"_17494":96387,"_23725":96388,"_2383":96389},[],"/docs/pr-preview/pr-44/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_2856":57891,"_25058":57882,"_5":25391,"_17494":96391,"_23725":96392,"_2383":96393},[],"/docs/pr-preview/pr-44/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_2856":57892,"_25058":57882,"_5":25391,"_17494":96395,"_23725":96396,"_2383":96397},[],"/docs/pr-preview/pr-44/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_2856":57893,"_25058":57882,"_17494":96399,"_5":17389,"_23725":96365,"_2383":96400},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_2856":57894,"_25058":57882,"_17494":96402,"_5":17389,"_23725":96365,"_2383":96403},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_2856":57895,"_25058":57882,"_17494":96405,"_5":17389,"_23725":96369,"_2383":96406},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_2856":57896,"_25058":57882,"_17494":96408,"_5":17389,"_23725":96369,"_2383":96409},[],"Defínelo únicamente cuando:",{"_2856":57897,"_25058":57882,"_17494":96411,"_5":17389,"_23725":96369,"_2383":96412},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_2856":57898,"_25058":57882,"_17494":96414,"_5":17389,"_23725":96369,"_2383":96415},[],"esa dirección está asignada a este Gateway",{"_2856":57899,"_25058":57882,"_17494":96417,"_5":17389,"_23725":96369,"_2383":96418},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_2856":57900,"_25058":57882,"_17494":96420,"_5":17389,"_23725":96369,"_2383":96421},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_2856":57901,"_25058":57882,"_17494":96423,"_5":17389,"_23725":96369,"_2383":96424},[],"No confundas estos valores:",{"_2856":57902,"_25058":57882,"_17494":96426,"_5":17389,"_23725":96369,"_2383":96427},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_2856":57903,"_25058":57882,"_17494":96429,"_5":17389,"_23725":96369,"_2383":96430},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_2856":57904,"_25058":57882,"_17494":96432,"_5":17389,"_23725":96369,"_2383":96433},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_2856":57905,"_25058":57882,"_17494":96435,"_5":17389,"_23725":96373,"_2383":96436},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_2856":57906,"_25058":57882,"_17494":96438,"_5":17389,"_23725":96373,"_2383":96439},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_2856":57907,"_25058":57882,"_17494":96441,"_5":17389,"_23725":96377,"_2383":96442},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_2856":57908,"_25058":57882,"_17494":96444,"_5":17389,"_23725":96377,"_2383":96445},[],"Para el diseño recomendado:",{"_2856":57909,"_25058":57882,"_17494":96447,"_5":17389,"_23725":96377,"_2383":96448},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_2856":57910,"_25058":57882,"_17494":96450,"_5":17389,"_23725":96377,"_2383":96451},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_2856":57911,"_25058":57882,"_17494":96453,"_5":17389,"_23725":96377,"_2383":96454},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_2856":57912,"_25058":57882,"_17494":96456,"_5":17389,"_23725":96377,"_2383":96457},[],"Apunta DNS a la dirección accesible de la VM.",{"_2856":57913,"_25058":57882,"_17494":96459,"_5":17389,"_23725":96377,"_2383":96460},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_2856":57914,"_25058":57882,"_17494":96462,"_5":17389,"_23725":96380,"_2383":96463},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_2856":57915,"_25058":57882,"_17494":96465,"_5":17389,"_23725":96384,"_2383":96466},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_2856":57916,"_25058":57882,"_17494":96468,"_5":17389,"_23725":96384,"_2383":96469},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_2856":57917,"_25058":57882,"_17494":96471,"_5":17389,"_23725":96388,"_2383":96472},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_2856":57918,"_25058":57882,"_17494":96474,"_5":17389,"_23725":96388,"_2383":96475},[],"Requisito",{"_2856":57919,"_25058":57882,"_17494":96477,"_5":17389,"_23725":96388,"_2383":96478},[],"Diseño recomendado",{"_2856":57920,"_25058":57882,"_17494":96480,"_5":17389,"_23725":96388,"_2383":96481},[],"Consecuencia",{"_2856":57921,"_25058":57882,"_17494":96483,"_5":17389,"_23725":96388,"_2383":96484},[],"Varias URL o servicios de Lamassu",{"_2856":57922,"_25058":57882,"_17494":96486,"_5":17389,"_23725":96388,"_2383":96487},[],"Un Gateway con varias rutas",{"_2856":57923,"_25058":57882,"_17494":96489,"_5":17389,"_23725":96388,"_2383":96490},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_2856":57924,"_25058":57882,"_17494":96492,"_5":17389,"_23725":96388,"_2383":96493},[],"Gateways independientes e IP externas distintas",{"_2856":57925,"_25058":57882,"_17494":96495,"_5":17389,"_23725":96388,"_2383":96496},[],"Una VIP por Gateway",{"_2856":57926,"_25058":57882,"_17494":96498,"_5":17389,"_23725":96388,"_2383":96499},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_2856":57927,"_25058":57882,"_17494":96501,"_5":17389,"_23725":96388,"_2383":96502},[],"Gateways independientes, un nodo y una IP",{"_2856":57928,"_25058":57882,"_17494":96504,"_5":17389,"_23725":96388,"_2383":96505},[],"Puertos externos diferentes",{"_2856":57929,"_25058":57882,"_17494":96507,"_5":17389,"_23725":96388,"_2383":96508},[],"Los clientes deben indicar puertos no estándar",{"_2856":57930,"_25058":57882,"_17494":96510,"_5":17389,"_23725":96388,"_2383":96511},[],"Terminación TLS/mTLS separada detrás de una IP",{"_2856":57931,"_25058":57882,"_17494":96513,"_5":17389,"_23725":96388,"_2383":96514},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_2856":57932,"_25058":57882,"_17494":96516,"_5":17389,"_23725":96388,"_2383":96517},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_2856":57933,"_25058":57882,"_17494":96519,"_5":17389,"_23725":96388,"_2383":96520},[],"Recursos Gateway separados pero proxy compartido",{"_2856":57934,"_25058":57882,"_17494":96522,"_5":17389,"_23725":96388,"_2383":96523},[],"Modo merged Gateway de Envoy",{"_2856":57935,"_25058":57882,"_17494":96525,"_5":17389,"_23725":96388,"_2383":96526},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_2856":57936,"_25058":57882,"_17494":96528,"_5":17389,"_23725":96388,"_2383":96529},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_2856":57937,"_25058":57882,"_17494":96531,"_5":17389,"_23725":96388,"_2383":96532},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_2856":57938,"_25058":57882,"_17494":96534,"_5":17389,"_23725":96388,"_2383":96535},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_2856":57939,"_25058":57882,"_17494":96537,"_5":17389,"_23725":96388,"_2383":96538},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_2856":57940,"_25058":57882,"_17494":96540,"_5":17389,"_23725":96392,"_2383":96541},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_2856":57941,"_25058":57882,"_17494":96543,"_5":17389,"_23725":96392,"_2383":96544},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_2856":57942,"_25058":57882,"_17494":96546,"_5":17389,"_23725":96392,"_2383":96547},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_2856":57943,"_25058":57882,"_17494":96549,"_5":17389,"_23725":96392,"_2383":96550},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_2856":57944,"_25058":57882,"_17494":96552,"_5":17389,"_23725":96392,"_2383":96553},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_2856":57945,"_25058":57882,"_17494":96555,"_5":17389,"_23725":96396,"_2383":96556},[],"Comprueba, en orden:",{"_2856":57946,"_25058":57882,"_17494":96558,"_5":17389,"_23725":96396,"_2383":96559},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_2856":57947,"_25058":57882,"_17494":96561,"_5":17389,"_23725":96396,"_2383":96562},[],"Su estado contiene la dirección esperada.",{"_2856":57948,"_25058":57882,"_17494":96564,"_5":17389,"_23725":96396,"_2383":96565},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_2856":57949,"_25058":57882,"_17494":96567,"_5":17389,"_23725":96396,"_2383":96568},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_2856":57950,"_25058":57882,"_17494":96570,"_5":17389,"_23725":96396,"_2383":96571},[],"DNS resuelve al endpoint accesible externamente.",{"_2856":57951,"_25058":57882,"_17494":96573,"_5":17389,"_23725":96396,"_2383":96574},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_2856":57952,"_25058":57882,"_17494":96576,"_5":17389,"_23725":96396,"_2383":96577},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_2856":57953,"_25058":57953,"_5":12268,"_2383":40837,"_25394":96579,"_17494":96580,"_23725":57953},[40730,95665,95899],[],{"_2856":57954,"_25058":57953,"_17494":96582,"_5":17389,"_23725":57953,"_2383":96583},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_2856":57955,"_25058":57953,"_5":25391,"_17494":96585,"_23725":96586,"_2383":96587},[],"/docs/pr-preview/pr-44/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_2856":57956,"_25058":57953,"_5":25391,"_17494":96589,"_23725":96590,"_2383":96591},[],"/docs/pr-preview/pr-44/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_2856":57957,"_25058":57953,"_5":25391,"_17494":96593,"_23725":96594,"_2383":96595},[],"/docs/pr-preview/pr-44/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_2856":57958,"_25058":57953,"_5":25391,"_17494":96597,"_23725":96598,"_2383":96599},[],"/docs/pr-preview/pr-44/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_2856":57959,"_25058":57953,"_5":25391,"_17494":96601,"_23725":96602,"_2383":96603},[],"/docs/pr-preview/pr-44/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_2856":57960,"_25058":57953,"_5":25391,"_17494":96605,"_23725":96606,"_2383":96607},[],"/docs/pr-preview/pr-44/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_2856":57961,"_25058":57953,"_17494":96609,"_5":17389,"_23725":96586,"_2383":96610},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_2856":57962,"_25058":57953,"_17494":96612,"_5":17389,"_23725":96590,"_2383":96613},[],"Flujo",{"_2856":57963,"_25058":57953,"_17494":96615,"_5":17389,"_23725":96590,"_2383":96616},[],"Úsalo para",{"_2856":57964,"_25058":57953,"_17494":96618,"_5":17389,"_23725":96590,"_2383":96619},[],"Qué instala",{"_2856":57965,"_25058":57953,"_17494":96621,"_5":17389,"_23725":96590,"_2383":41721},[],{"_2856":57966,"_25058":57953,"_17494":96623,"_5":17389,"_23725":96590,"_2383":96624},[],"Producción y entornos controlados",{"_2856":57967,"_25058":57953,"_17494":96626,"_5":17389,"_23725":96590,"_2383":96627},[],"Servicios de Lamassu y recursos de Gateway API",{"_2856":57968,"_25058":57953,"_17494":96629,"_5":17389,"_23725":96590,"_2383":40974},[],{"_2856":57969,"_25058":57953,"_17494":96631,"_5":17389,"_23725":96590,"_2383":96632},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_2856":57970,"_25058":57953,"_17494":96634,"_5":17389,"_23725":96590,"_2383":96635},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_2856":57971,"_25058":57953,"_17494":96637,"_5":17389,"_23725":96594,"_2383":96638},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_2856":57972,"_25058":57953,"_17494":96640,"_5":17389,"_23725":96594,"_2383":96641},[],"Área",{"_2856":57973,"_25058":57953,"_17494":96643,"_5":17389,"_23725":96594,"_2383":96644},[],"El chart de Lamassu proporciona",{"_2856":57974,"_25058":57953,"_17494":96646,"_5":17389,"_23725":96594,"_2383":96647},[],"Tú proporcionas",{"_2856":57975,"_25058":57953,"_17494":96649,"_5":17389,"_23725":96594,"_2383":96650},[],"Aplicaciones Lamassu",{"_2856":57976,"_25058":57953,"_17494":96652,"_5":17389,"_23725":96594,"_2383":96653},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_2856":57977,"_25058":57953,"_17494":96655,"_5":17389,"_23725":96594,"_2383":96656},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_2856":57978,"_25058":57953,"_17494":96658,"_5":17389,"_23725":96594,"_2383":96659},[],"Datos PostgreSQL",{"_2856":57979,"_25058":57953,"_17494":96661,"_5":17389,"_23725":96594,"_2383":96662},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_2856":57980,"_25058":57953,"_17494":96664,"_5":17389,"_23725":96594,"_2383":96665},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_2856":57981,"_25058":57953,"_17494":96667,"_5":17389,"_23725":96594,"_2383":96668},[],"Mensajería",{"_2856":57982,"_25058":57953,"_17494":96670,"_5":17389,"_23725":96594,"_2383":96671},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_2856":57983,"_25058":57953,"_17494":96673,"_5":17389,"_23725":96594,"_2383":96674},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_2856":57984,"_25058":57953,"_17494":96676,"_5":17389,"_23725":96594,"_2383":96677},[],"Identidad",{"_2856":57985,"_25058":57953,"_17494":96679,"_5":17389,"_23725":96594,"_2383":96680},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_2856":57986,"_25058":57953,"_17494":96682,"_5":17389,"_23725":96594,"_2383":96683},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_2856":57987,"_25058":57953,"_17494":96685,"_5":17389,"_23725":96594,"_2383":96686},[],"Enrutamiento externo",{"_2856":57988,"_25058":57953,"_17494":96688,"_5":17389,"_23725":96594,"_2383":96689},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_2856":57989,"_25058":57953,"_17494":96691,"_5":17389,"_23725":96594,"_2383":96692},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_2856":57990,"_25058":57953,"_17494":96694,"_5":17389,"_23725":96594,"_2383":41795},[],{"_2856":57991,"_25058":57953,"_17494":96696,"_5":17389,"_23725":96594,"_2383":96697},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_2856":57992,"_25058":57953,"_17494":96699,"_5":17389,"_23725":96594,"_2383":96700},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_2856":57993,"_25058":57953,"_17494":96702,"_5":17389,"_23725":96594,"_2383":96703},[],"Datos persistentes de la aplicación",{"_2856":57994,"_25058":57953,"_17494":96705,"_5":17389,"_23725":96594,"_2383":96706},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_2856":57995,"_25058":57953,"_17494":96708,"_5":17389,"_23725":96594,"_2383":96709},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_2856":57996,"_25058":57953,"_17494":96711,"_5":17389,"_23725":96594,"_2383":96712},[],"Integraciones opcionales",{"_2856":57997,"_25058":57953,"_17494":96714,"_5":17389,"_23725":96594,"_2383":96715},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_2856":57998,"_25058":57953,"_17494":96717,"_5":17389,"_23725":96594,"_2383":96718},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_2856":57999,"_25058":57953,"_17494":96720,"_5":17389,"_23725":96594,"_2383":96721},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_2856":58000,"_25058":57953,"_17494":96723,"_5":17389,"_23725":96594,"_2383":96724},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_2856":58001,"_25058":57953,"_17494":96726,"_5":17389,"_23725":96598,"_2383":96727},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_2856":58002,"_25058":57953,"_17494":96729,"_5":17389,"_23725":96598,"_2383":96730},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_2856":58003,"_25058":57953,"_17494":96732,"_5":17389,"_23725":96602,"_2383":96733},[],"Kubernetes 1.24 o posterior",{"_2856":58004,"_25058":57953,"_17494":96735,"_5":17389,"_23725":96602,"_2383":96736},[],"Helm 3.2 o posterior",{"_2856":58005,"_25058":57953,"_17494":96738,"_5":17389,"_23725":96602,"_2383":96739},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_2856":58006,"_25058":57953,"_17494":96741,"_5":17389,"_23725":96602,"_2383":96742},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_2856":58007,"_25058":57953,"_17494":96744,"_5":17389,"_23725":96602,"_2383":96745},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_2856":58008,"_25058":57953,"_17494":96747,"_5":17389,"_23725":96602,"_2383":96748},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_2856":58009,"_25058":57953,"_17494":96750,"_5":17389,"_23725":96602,"_2383":96751},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior.",{"_2856":58010,"_25058":57953,"_17494":96753,"_5":17389,"_23725":96606,"_2383":96754},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2856":58011,"_25058":57953,"_17494":96756,"_5":17389,"_23725":96606,"_2383":96757},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2856":58012,"_25058":57953,"_17494":96759,"_5":17389,"_23725":96606,"_2383":96760},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2856":58013,"_25058":58013,"_5":12268,"_2383":96762,"_25394":96763,"_17494":96765,"_23725":58013},"Resolución de problemas de despliegue",[40730,95665,96764],"Operación",[],{"_2856":58014,"_25058":58013,"_17494":96767,"_5":17389,"_23725":58013,"_2383":96768},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_2856":58015,"_25058":58013,"_5":25391,"_17494":96770,"_23725":96771,"_2383":96772},[],"/docs/pr-preview/pr-44/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_2856":58016,"_25058":58013,"_5":25391,"_17494":96774,"_23725":96775,"_2383":96776},[],"/docs/pr-preview/pr-44/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_2856":58017,"_25058":58013,"_5":25391,"_17494":96778,"_23725":96779,"_2383":96780},[],"/docs/pr-preview/pr-44/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_2856":58018,"_25058":58013,"_5":25391,"_17494":96782,"_23725":96783,"_2383":96784},[],"/docs/pr-preview/pr-44/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_2856":58019,"_25058":58013,"_5":25391,"_17494":96786,"_23725":96787,"_2383":96788},[],"/docs/pr-preview/pr-44/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_2856":58020,"_25058":58013,"_5":25391,"_17494":96790,"_23725":96791,"_2383":96792},[],"/docs/pr-preview/pr-44/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_2856":58021,"_25058":58013,"_5":25391,"_17494":96794,"_23725":96795,"_2383":96796},[],"/docs/pr-preview/pr-44/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_2856":58022,"_25058":58013,"_5":25391,"_17494":96798,"_23725":96799,"_2383":96800},[],"/docs/pr-preview/pr-44/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_2856":58023,"_25058":58013,"_5":25391,"_17494":96802,"_23725":96803,"_2383":96804},[],"/docs/pr-preview/pr-44/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_2856":58024,"_25058":58013,"_5":25391,"_17494":96806,"_23725":96807,"_2383":96808},[],"/docs/pr-preview/pr-44/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_2856":58025,"_25058":58013,"_5":25391,"_17494":96810,"_23725":96811,"_2383":96812},[],"/docs/pr-preview/pr-44/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_2856":58026,"_25058":58013,"_5":25391,"_17494":96814,"_23725":96815,"_2383":96816},[],"/docs/pr-preview/pr-44/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_2856":58027,"_25058":58013,"_17494":96818,"_5":17389,"_23725":58013,"_2383":96819},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_2856":58028,"_25058":58013,"_17494":96821,"_5":17389,"_23725":96775,"_2383":96822},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_2856":58029,"_25058":58013,"_17494":96824,"_5":17389,"_23725":96779,"_2383":96825},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_2856":58030,"_25058":58013,"_17494":96827,"_5":17389,"_23725":96783,"_2383":96828},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_2856":58031,"_25058":58013,"_17494":96830,"_5":17389,"_23725":96787,"_2383":96831},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_2856":58032,"_25058":58013,"_17494":96833,"_5":17389,"_23725":96791,"_2383":96834},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_2856":58033,"_25058":58013,"_17494":96836,"_5":17389,"_23725":96795,"_2383":96837},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_2856":58034,"_25058":58013,"_17494":96839,"_5":17389,"_23725":96795,"_2383":96840},[],"Ejecuta también la prueba de conectividad del chart:",{"_2856":58035,"_25058":58013,"_17494":96842,"_5":17389,"_23725":96795,"_2383":96843},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_2856":58036,"_25058":58013,"_17494":96845,"_5":17389,"_23725":96795,"_2383":96846},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_2856":58037,"_25058":58013,"_17494":96848,"_5":17389,"_23725":96799,"_2383":96849},[],"Si recibes un 401:",{"_2856":58038,"_25058":58013,"_17494":96851,"_5":17389,"_23725":96799,"_2383":96852},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_2856":58039,"_25058":58013,"_17494":96854,"_5":17389,"_23725":96799,"_2383":96855},[],"verifica emisor, audiencia y expiración del token;",{"_2856":58040,"_25058":58013,"_17494":96857,"_5":17389,"_23725":96799,"_2383":96858},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_2856":58041,"_25058":58013,"_17494":96860,"_5":17389,"_23725":96799,"_2383":96861},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_2856":58042,"_25058":58013,"_17494":96863,"_5":17389,"_23725":96799,"_2383":96864},[],"Si el login termina pero las APIs devuelven 403:",{"_2856":58043,"_25058":58013,"_17494":96866,"_5":17389,"_23725":96799,"_2383":96867},[],"inspecciona los claims reales del token;",{"_2856":58044,"_25058":58013,"_17494":96869,"_5":17389,"_23725":96799,"_2383":96870},[],"confirma que coinciden con un principal activo;",{"_2856":58045,"_25058":58013,"_17494":96872,"_5":17389,"_23725":96799,"_2383":96873},[],"revisa las políticas concedidas al principal;",{"_2856":58046,"_25058":58013,"_17494":96875,"_5":17389,"_23725":96799,"_2383":96876},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_2856":58047,"_25058":58013,"_17494":96878,"_5":17389,"_23725":96799,"_2383":96879},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_2856":58048,"_25058":58013,"_17494":96881,"_5":17389,"_23725":96803,"_2383":96882},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_2856":58049,"_25058":58013,"_17494":96884,"_5":17389,"_23725":96803,"_2383":96885},[],"Localiza el pod y Service de authz.",{"_2856":58050,"_25058":58013,"_17494":96887,"_5":17389,"_23725":96803,"_2383":96888},[],"Comprueba /health, logs y conexión a su base de datos.",{"_2856":58051,"_25058":58013,"_17494":96890,"_5":17389,"_23725":96803,"_2383":96891},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_2856":58052,"_25058":58013,"_17494":96893,"_5":17389,"_23725":96803,"_2383":96894},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_2856":58053,"_25058":58013,"_17494":96896,"_5":17389,"_23725":96803,"_2383":96897},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_2856":58054,"_25058":58013,"_17494":96899,"_5":17389,"_23725":96807,"_2383":96900},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_2856":58055,"_25058":58013,"_17494":96902,"_5":17389,"_23725":96807,"_2383":96903},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_2856":58056,"_25058":58013,"_17494":96905,"_5":17389,"_23725":96807,"_2383":96906},[],"volumen persistente sin enlazar;",{"_2856":58057,"_25058":58013,"_17494":96908,"_5":17389,"_23725":96807,"_2383":96909},[],"imagen inaccesible o política de pull incorrecta;",{"_2856":58058,"_25058":58013,"_17494":96911,"_5":17389,"_23725":96807,"_2383":96912},[],"configuración inválida del motor criptográfico;",{"_2856":58059,"_25058":58013,"_17494":96914,"_5":17389,"_23725":96807,"_2383":96915},[],"límites de CPU o memoria demasiado bajos;",{"_2856":58060,"_25058":58013,"_17494":96917,"_5":17389,"_23725":96807,"_2383":96918},[],"migración previa incompleta.",{"_2856":58061,"_25058":58013,"_17494":96920,"_5":17389,"_23725":96807,"_2383":96921},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_2856":58062,"_25058":58013,"_17494":96923,"_5":17389,"_23725":96807,"_2383":96924},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_2856":58063,"_25058":58013,"_17494":96926,"_5":17389,"_23725":96811,"_2383":96927},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_2856":58064,"_25058":58013,"_17494":96929,"_5":17389,"_23725":96811,"_2383":96930},[],"verifica que esté habilitado en el servicio emisor;",{"_2856":58065,"_25058":58013,"_17494":96932,"_5":17389,"_23725":96811,"_2383":96933},[],"comprueba conectividad y credenciales AMQP;",{"_2856":58066,"_25058":58013,"_17494":96935,"_5":17389,"_23725":96811,"_2383":96936},[],"revisa exchange, routing key, colas y consumidores;",{"_2856":58067,"_25058":58013,"_17494":96938,"_5":17389,"_23725":96811,"_2383":96939},[],"inspecciona dead-letter queues;",{"_2856":58068,"_25058":58013,"_17494":96941,"_5":17389,"_23725":96811,"_2383":96942},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_2856":58069,"_25058":58013,"_17494":96944,"_5":17389,"_23725":96811,"_2383":96945},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_2856":58070,"_25058":58013,"_17494":96947,"_5":17389,"_23725":96815,"_2383":96948},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten; el AWS Connector, authz, wfx y la UI no están instrumentados. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_2856":58071,"_25058":58013,"_17494":96950,"_5":17389,"_23725":96815,"_2383":96951},[],"Antes de cerrar una incidencia, guarda:",{"_2856":58072,"_25058":58013,"_17494":96953,"_5":17389,"_23725":96815,"_2383":96954},[],"causa confirmada;",{"_2856":58073,"_25058":58013,"_17494":96956,"_5":17389,"_23725":96815,"_2383":96957},[],"alcance temporal y recursos afectados;",{"_2856":58074,"_25058":58013,"_17494":96959,"_5":17389,"_23725":96815,"_2383":96960},[],"comandos o consultas utilizados;",{"_2856":58075,"_25058":58013,"_17494":96962,"_5":17389,"_23725":96815,"_2383":96963},[],"cambio aplicado y forma de revertirlo;",{"_2856":58076,"_25058":58013,"_17494":96965,"_5":17389,"_23725":96815,"_2383":96966},[],"validación desde un consumidor;",{"_2856":58077,"_25058":58013,"_17494":96968,"_5":17389,"_23725":96815,"_2383":96969},[],"acción preventiva y propietario.",{"_2856":58078,"_25058":58078,"_5":12268,"_2383":96971,"_25394":96972,"_17494":96975,"_23725":58078},"Control de acceso",[40730,96973,96974],"Plataforma","Administración",[],{"_2856":58079,"_25058":58078,"_17494":96977,"_5":17389,"_23725":58078,"_2383":96978},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_2856":58080,"_25058":58078,"_5":25391,"_17494":96980,"_23725":96981,"_2383":96982},[],"/docs/pr-preview/pr-44/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_2856":58081,"_25058":58078,"_5":25391,"_17494":96984,"_23725":96985,"_2383":96986},[],"/docs/pr-preview/pr-44/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_2856":58082,"_25058":58078,"_5":25391,"_17494":96988,"_23725":96989,"_2383":96990},[],"/docs/pr-preview/pr-44/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_2856":58083,"_25058":58078,"_5":25391,"_17494":96992,"_23725":96993,"_2383":96994},[],"/docs/pr-preview/pr-44/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_2856":58084,"_25058":58078,"_5":25391,"_17494":96996,"_23725":96997,"_2383":96998},[],"/docs/pr-preview/pr-44/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_2856":58085,"_25058":58078,"_5":25391,"_17494":97000,"_23725":97001,"_2383":97002},[],"/docs/pr-preview/pr-44/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_2856":58086,"_25058":58078,"_5":25391,"_17494":97004,"_23725":97005,"_2383":97006},[],"/docs/pr-preview/pr-44/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_2856":58087,"_25058":58078,"_5":25391,"_17494":97008,"_23725":97009,"_2383":97010},[],"/docs/pr-preview/pr-44/es/platform/administration/access-control#principales-x509","Principales X.509",{"_2856":58088,"_25058":58078,"_5":25391,"_17494":97012,"_23725":97013,"_2383":97014},[],"/docs/pr-preview/pr-44/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_2856":58089,"_25058":58078,"_5":25391,"_17494":97016,"_23725":97017,"_2383":97018},[],"/docs/pr-preview/pr-44/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_2856":58090,"_25058":58078,"_5":25391,"_17494":97020,"_23725":97021,"_2383":97022},[],"/docs/pr-preview/pr-44/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_2856":58091,"_25058":58078,"_5":25391,"_17494":97024,"_23725":97025,"_2383":97026},[],"/docs/pr-preview/pr-44/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_2856":58092,"_25058":58078,"_5":25391,"_17494":97028,"_23725":97029,"_2383":97030},[],"/docs/pr-preview/pr-44/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_2856":58093,"_25058":58078,"_5":25391,"_17494":97032,"_23725":97033,"_2383":97034},[],"/docs/pr-preview/pr-44/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_2856":58094,"_25058":58078,"_5":25391,"_17494":97036,"_23725":97037,"_2383":97038},[],"/docs/pr-preview/pr-44/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_2856":58095,"_25058":58078,"_5":25391,"_17494":97040,"_23725":97041,"_2383":96235},[],"/docs/pr-preview/pr-44/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_2856":58096,"_25058":58078,"_5":25391,"_17494":97043,"_23725":97044,"_2383":97045},[],"/docs/pr-preview/pr-44/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_2856":58097,"_25058":58078,"_5":25391,"_17494":97047,"_23725":97048,"_2383":97049},[],"/docs/pr-preview/pr-44/es/platform/administration/access-control#configura-las-dos-validaciones-jwt","Configura las dos validaciones JWT",{"_2856":58098,"_25058":58078,"_5":25391,"_17494":97051,"_23725":97052,"_2383":97053},[],"/docs/pr-preview/pr-44/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_2856":58099,"_25058":58078,"_5":25391,"_17494":97055,"_23725":97056,"_2383":97057},[],"/docs/pr-preview/pr-44/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_2856":58100,"_25058":58078,"_5":25391,"_17494":97059,"_23725":97060,"_2383":97061},[],"/docs/pr-preview/pr-44/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_2856":58101,"_25058":58078,"_5":25391,"_17494":97063,"_23725":97064,"_2383":97065},[],"/docs/pr-preview/pr-44/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_2856":58102,"_25058":58078,"_5":25391,"_17494":97067,"_23725":97068,"_2383":97069},[],"/docs/pr-preview/pr-44/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_2856":58103,"_25058":58078,"_5":25391,"_17494":97071,"_23725":97072,"_2383":97073},[],"/docs/pr-preview/pr-44/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_2856":58104,"_25058":58078,"_5":25391,"_17494":97075,"_23725":97076,"_2383":97077},[],"/docs/pr-preview/pr-44/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_2856":58105,"_25058":58078,"_5":25391,"_17494":97079,"_23725":97080,"_2383":97081},[],"/docs/pr-preview/pr-44/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_2856":58106,"_25058":58078,"_5":25391,"_17494":97083,"_23725":97084,"_2383":97085},[],"/docs/pr-preview/pr-44/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_2856":58107,"_25058":58078,"_5":25391,"_17494":97087,"_23725":97088,"_2383":97089},[],"/docs/pr-preview/pr-44/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_2856":58108,"_25058":58078,"_5":25391,"_17494":97091,"_23725":97092,"_2383":97093},[],"/docs/pr-preview/pr-44/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_2856":58109,"_25058":58078,"_5":25391,"_17494":97095,"_23725":97096,"_2383":97097},[],"/docs/pr-preview/pr-44/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_2856":58110,"_25058":58078,"_5":25391,"_17494":97099,"_23725":97100,"_2383":97101},[],"/docs/pr-preview/pr-44/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_2856":58111,"_25058":58078,"_17494":97103,"_5":17389,"_23725":58078,"_2383":97104},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_2856":58112,"_25058":58078,"_17494":97106,"_5":17389,"_23725":58078,"_2383":97107},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_2856":58113,"_25058":58078,"_17494":97109,"_5":17389,"_23725":58078,"_2383":97110},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_2856":58114,"_25058":58078,"_17494":97112,"_5":17389,"_23725":96981,"_2383":97113},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_2856":58115,"_25058":58078,"_17494":97115,"_5":17389,"_23725":96981,"_2383":97116},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_2856":58116,"_25058":58078,"_17494":97118,"_5":17389,"_23725":96981,"_2383":97119},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_2856":58117,"_25058":58078,"_17494":97121,"_5":17389,"_23725":96981,"_2383":97122},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_2856":58118,"_25058":58078,"_17494":97124,"_5":17389,"_23725":96981,"_2383":97125},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_2856":58119,"_25058":58078,"_17494":97127,"_5":17389,"_23725":96981,"_2383":97128},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_2856":58120,"_25058":58078,"_17494":97130,"_5":17389,"_23725":96985,"_2383":97131},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_2856":58121,"_25058":58078,"_17494":97133,"_5":17389,"_23725":96985,"_2383":97134},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_2856":58122,"_25058":58078,"_17494":97136,"_5":17389,"_23725":96989,"_2383":97137},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_2856":58123,"_25058":58078,"_17494":97139,"_5":17389,"_23725":96989,"_2383":97140},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_2856":58124,"_25058":58078,"_17494":97142,"_5":17389,"_23725":96989,"_2383":97143},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_2856":58125,"_25058":58078,"_17494":97145,"_5":17389,"_23725":96989,"_2383":97146},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_2856":58126,"_25058":58078,"_17494":97148,"_5":17389,"_23725":96989,"_2383":97149},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_2856":58127,"_25058":58078,"_17494":97151,"_5":17389,"_23725":96989,"_2383":97152},[],"Carga por separado las políticas concedidas a cada principal.",{"_2856":58128,"_25058":58078,"_17494":97154,"_5":17389,"_23725":96989,"_2383":97155},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_2856":58129,"_25058":58078,"_17494":97157,"_5":17389,"_23725":96989,"_2383":97158},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_2856":58130,"_25058":58078,"_17494":97160,"_5":17389,"_23725":96989,"_2383":97161},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_2856":58131,"_25058":58078,"_17494":97163,"_5":17389,"_23725":96989,"_2383":97164},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_2856":58132,"_25058":58078,"_17494":97166,"_5":17389,"_23725":96989,"_2383":97167},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_2856":58133,"_25058":58078,"_17494":97169,"_5":17389,"_23725":96989,"_2383":97170},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_2856":58134,"_25058":58078,"_17494":97172,"_5":17389,"_23725":96993,"_2383":97173},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_2856":58135,"_25058":58078,"_17494":97175,"_5":17389,"_23725":96993,"_2383":97176},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_2856":58136,"_25058":58078,"_17494":97178,"_5":17389,"_23725":96993,"_2383":97179},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_2856":58137,"_25058":58078,"_17494":97181,"_5":17389,"_23725":96993,"_2383":97182},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_2856":58138,"_25058":58078,"_17494":97184,"_5":17389,"_23725":96993,"_2383":97185},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_2856":58139,"_25058":58078,"_17494":97187,"_5":17389,"_23725":96993,"_2383":97188},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_2856":58140,"_25058":58078,"_17494":97190,"_5":17389,"_23725":96993,"_2383":97191},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_2856":58141,"_25058":58078,"_17494":97193,"_5":17389,"_23725":96993,"_2383":97194},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_2856":58142,"_25058":58078,"_17494":97196,"_5":17389,"_23725":96997,"_2383":97197},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_2856":58143,"_25058":58078,"_17494":97199,"_5":17389,"_23725":96997,"_2383":97200},[],"La decisión se toma con el contexto de la operación de dominio:",{"_2856":58144,"_25058":58078,"_17494":97202,"_5":17389,"_23725":96997,"_2383":97203},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_2856":58145,"_25058":58078,"_17494":97205,"_5":17389,"_23725":96997,"_2383":97206},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_2856":58146,"_25058":58078,"_17494":97208,"_5":17389,"_23725":96997,"_2383":97209},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_2856":58147,"_25058":58078,"_17494":97211,"_5":17389,"_23725":96997,"_2383":97212},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_2856":58148,"_25058":58078,"_17494":97214,"_5":17389,"_23725":96997,"_2383":97215},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_2856":58149,"_25058":58078,"_17494":97217,"_5":17389,"_23725":96997,"_2383":97218},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_2856":58150,"_25058":58078,"_17494":97220,"_5":17389,"_23725":96997,"_2383":97221},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_2856":58151,"_25058":58078,"_17494":97223,"_5":17389,"_23725":96997,"_2383":97224},[],"Las acciones se dividen en dos grupos:",{"_2856":58152,"_25058":58078,"_17494":97226,"_5":17389,"_23725":96997,"_2383":97227},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_2856":58153,"_25058":58078,"_17494":97229,"_5":17389,"_23725":96997,"_2383":97230},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_2856":58154,"_25058":58078,"_17494":97232,"_5":17389,"_23725":96997,"_2383":97233},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_2856":58155,"_25058":58078,"_17494":97235,"_5":17389,"_23725":97001,"_2383":97236},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_2856":58156,"_25058":58078,"_17494":97238,"_5":17389,"_23725":97001,"_2383":97239},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_2856":58157,"_25058":58078,"_17494":97241,"_5":17389,"_23725":97001,"_2383":97242},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_2856":58158,"_25058":58078,"_17494":97244,"_5":17389,"_23725":97005,"_2383":97245},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_2856":58159,"_25058":58078,"_17494":97247,"_5":17389,"_23725":97005,"_2383":97248},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_2856":58160,"_25058":58078,"_17494":97250,"_5":17389,"_23725":97005,"_2383":97251},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_2856":58161,"_25058":58078,"_17494":97253,"_5":17389,"_23725":97005,"_2383":97254},[],"Los operadores implementados son:",{"_2856":58162,"_25058":58078,"_17494":97256,"_5":17389,"_23725":97005,"_2383":97257},[],"`equals`, para igualdad exacta;",{"_2856":58163,"_25058":58078,"_17494":97259,"_5":17389,"_23725":97005,"_2383":97260},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_2856":58164,"_25058":58078,"_17494":97262,"_5":17389,"_23725":97005,"_2383":97263},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_2856":58165,"_25058":58078,"_17494":97265,"_5":17389,"_23725":97005,"_2383":97266},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_2856":58166,"_25058":58078,"_17494":97268,"_5":17389,"_23725":97009,"_2383":97269},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_2856":58167,"_25058":58078,"_17494":97271,"_5":17389,"_23725":97009,"_2383":97272},[],"Los modos disponibles son:",{"_2856":58168,"_25058":58078,"_17494":97274,"_5":17389,"_23725":97009,"_2383":97275},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_2856":58169,"_25058":58078,"_17494":97277,"_5":17389,"_23725":97009,"_2383":97278},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_2856":58170,"_25058":58078,"_17494":97280,"_5":17389,"_23725":97009,"_2383":97281},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_2856":58171,"_25058":58078,"_17494":97283,"_5":17389,"_23725":97009,"_2383":97284},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_2856":58172,"_25058":58078,"_17494":97286,"_5":17389,"_23725":97009,"_2383":97287},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_2856":58173,"_25058":58078,"_17494":97289,"_5":17389,"_23725":97009,"_2383":97290},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_2856":58174,"_25058":58078,"_17494":97292,"_5":17389,"_23725":97013,"_2383":97293},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_2856":58175,"_25058":58078,"_17494":97295,"_5":17389,"_23725":97013,"_2383":97296},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_2856":58176,"_25058":58078,"_17494":97298,"_5":17389,"_23725":97013,"_2383":97299},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_2856":58177,"_25058":58078,"_17494":97301,"_5":17389,"_23725":97013,"_2383":97302},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_2856":58178,"_25058":58078,"_17494":97304,"_5":17389,"_23725":97021,"_2383":97305},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_2856":58179,"_25058":58078,"_17494":97307,"_5":17389,"_23725":97021,"_2383":97308},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_2856":58180,"_25058":58078,"_17494":97310,"_5":17389,"_23725":97025,"_2383":97311},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_2856":58181,"_25058":58078,"_17494":97313,"_5":17389,"_23725":97025,"_2383":97314},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_2856":58182,"_25058":58078,"_17494":97316,"_5":17389,"_23725":97029,"_2383":97317},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_2856":58183,"_25058":58078,"_17494":97319,"_5":17389,"_23725":97029,"_2383":97320},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_2856":58184,"_25058":58078,"_17494":97322,"_5":17389,"_23725":97029,"_2383":97323},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_2856":58185,"_25058":58078,"_17494":97325,"_5":17389,"_23725":97033,"_2383":97326},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_2856":58186,"_25058":58078,"_17494":97328,"_5":17389,"_23725":97033,"_2383":97329},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_2856":58187,"_25058":58078,"_17494":97331,"_5":17389,"_23725":97033,"_2383":97332},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_2856":58188,"_25058":58078,"_17494":97334,"_5":17389,"_23725":97033,"_2383":97335},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_2856":58189,"_25058":58078,"_17494":97337,"_5":17389,"_23725":97033,"_2383":97338},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_2856":58190,"_25058":58078,"_17494":97340,"_5":17389,"_23725":97033,"_2383":97341},[],"Ten en cuenta que:",{"_2856":58191,"_25058":58078,"_17494":97343,"_5":17389,"_23725":97033,"_2383":97344},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_2856":58192,"_25058":58078,"_17494":97346,"_5":17389,"_23725":97033,"_2383":97347},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_2856":58193,"_25058":58078,"_17494":97349,"_5":17389,"_23725":97033,"_2383":97350},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_2856":58194,"_25058":58078,"_17494":97352,"_5":17389,"_23725":97037,"_2383":97353},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_2856":58195,"_25058":58078,"_17494":97355,"_5":17389,"_23725":97037,"_2383":97356},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_2856":58196,"_25058":58078,"_17494":97358,"_5":17389,"_23725":97037,"_2383":97359},[],"acceso completo y de solo lectura a KMS;",{"_2856":58197,"_25058":58078,"_17494":97361,"_5":17389,"_23725":97037,"_2383":97362},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_2856":58198,"_25058":58078,"_17494":97364,"_5":17389,"_23725":97037,"_2383":97365},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_2856":58199,"_25058":58078,"_17494":97367,"_5":17389,"_23725":97037,"_2383":97368},[],"acceso a la interfaz;",{"_2856":58200,"_25058":58078,"_17494":97370,"_5":17389,"_23725":97037,"_2383":97371},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_2856":58201,"_25058":58078,"_17494":97373,"_5":17389,"_23725":97037,"_2383":97374},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_2856":58202,"_25058":58078,"_17494":97376,"_5":17389,"_23725":97037,"_2383":97377},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_2856":58203,"_25058":58078,"_17494":97379,"_5":17389,"_23725":97041,"_2383":97380},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_2856":58204,"_25058":58078,"_17494":97382,"_5":17389,"_23725":97041,"_2383":97383},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_2856":58205,"_25058":58078,"_17494":97385,"_5":17389,"_23725":97041,"_2383":97386},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_2856":58206,"_25058":58078,"_17494":97388,"_5":17389,"_23725":97044,"_2383":97389},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_2856":58207,"_25058":58078,"_17494":97391,"_5":17389,"_23725":97048,"_2383":97392},[],"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes.",{"_2856":58208,"_25058":58078,"_17494":97394,"_5":17389,"_23725":97052,"_2383":97395},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_2856":58209,"_25058":58078,"_17494":97397,"_5":17389,"_23725":97056,"_2383":97398},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_2856":58210,"_25058":58078,"_17494":97400,"_5":17389,"_23725":97060,"_2383":97401},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_2856":58211,"_25058":58078,"_17494":97403,"_5":17389,"_23725":97064,"_2383":97404},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_2856":58212,"_25058":58078,"_17494":97406,"_5":17389,"_23725":97064,"_2383":97407},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_2856":58213,"_25058":58078,"_17494":97409,"_5":17389,"_23725":97068,"_2383":97410},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_2856":58214,"_25058":58078,"_17494":97412,"_5":17389,"_23725":97068,"_2383":97413},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_2856":58215,"_25058":58078,"_17494":97415,"_5":17389,"_23725":97068,"_2383":97416},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_2856":58216,"_25058":58078,"_17494":97418,"_5":17389,"_23725":97068,"_2383":97419},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_2856":58217,"_25058":58078,"_17494":97421,"_5":17389,"_23725":97068,"_2383":97422},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_2856":58218,"_25058":58078,"_17494":97424,"_5":17389,"_23725":97068,"_2383":97425},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_2856":58219,"_25058":58078,"_17494":97427,"_5":17389,"_23725":97068,"_2383":97428},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_2856":58220,"_25058":58078,"_17494":97430,"_5":17389,"_23725":97068,"_2383":97431},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_2856":58221,"_25058":58078,"_17494":97433,"_5":17389,"_23725":97072,"_2383":97434},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_2856":58222,"_25058":58078,"_17494":97436,"_5":17389,"_23725":97072,"_2383":97437},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_2856":58223,"_25058":58078,"_17494":97439,"_5":17389,"_23725":97072,"_2383":97440},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_2856":58224,"_25058":58078,"_17494":97442,"_5":17389,"_23725":97076,"_2383":97443},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_2856":58225,"_25058":58078,"_17494":97445,"_5":17389,"_23725":97076,"_2383":97446},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_2856":58226,"_25058":58078,"_17494":97448,"_5":17389,"_23725":97076,"_2383":97449},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_2856":58227,"_25058":58078,"_17494":97451,"_5":17389,"_23725":97076,"_2383":97452},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_2856":58228,"_25058":58078,"_17494":97454,"_5":17389,"_23725":97076,"_2383":97455},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_2856":58229,"_25058":58078,"_17494":97457,"_5":17389,"_23725":97076,"_2383":97458},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_2856":58230,"_25058":58078,"_17494":97460,"_5":17389,"_23725":97076,"_2383":97461},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_2856":58231,"_25058":58078,"_17494":97463,"_5":17389,"_23725":97076,"_2383":97464},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_2856":58232,"_25058":58078,"_17494":97466,"_5":17389,"_23725":97084,"_2383":97467},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_2856":58233,"_25058":58078,"_17494":97469,"_5":17389,"_23725":97088,"_2383":97470},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_2856":58234,"_25058":58078,"_17494":97472,"_5":17389,"_23725":97088,"_2383":97473},[],"que exista un principal activo del tipo correcto;",{"_2856":58235,"_25058":58078,"_17494":97475,"_5":17389,"_23725":97088,"_2383":97476},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_2856":58236,"_25058":58078,"_17494":97478,"_5":17389,"_23725":97088,"_2383":97479},[],"que todas las condiciones del principal se cumplan;",{"_2856":58237,"_25058":58078,"_17494":97481,"_5":17389,"_23725":97088,"_2383":97482},[],"que el principal tenga concedida la política esperada;",{"_2856":58238,"_25058":58078,"_17494":97484,"_5":17389,"_23725":97088,"_2383":97485},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_2856":58239,"_25058":58078,"_17494":97487,"_5":17389,"_23725":97088,"_2383":97488},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_2856":58240,"_25058":58078,"_17494":97490,"_5":17389,"_23725":97088,"_2383":97491},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_2856":58241,"_25058":58078,"_17494":97493,"_5":17389,"_23725":97092,"_2383":97494},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_2856":58242,"_25058":58078,"_17494":97496,"_5":17389,"_23725":97096,"_2383":97497},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_2856":58243,"_25058":58078,"_17494":97499,"_5":17389,"_23725":97100,"_2383":97500},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_2856":58244,"_25058":58078,"_17494":97502,"_5":17389,"_23725":97100,"_2383":97503},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_2856":58245,"_25058":58245,"_5":12268,"_2383":97505,"_25394":97506,"_17494":97507,"_23725":58245},"Alertas y suscripciones",[40730,96973,96974],[],{"_2856":58246,"_25058":58245,"_17494":97509,"_5":17389,"_23725":58245,"_2383":97510},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_2856":58247,"_25058":58245,"_5":25391,"_17494":97512,"_23725":97513,"_2383":97514},[],"/docs/pr-preview/pr-44/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_2856":58248,"_25058":58245,"_5":25391,"_17494":97516,"_23725":97517,"_2383":97518},[],"/docs/pr-preview/pr-44/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_2856":58249,"_25058":58245,"_5":25391,"_17494":97520,"_23725":97521,"_2383":97522},[],"/docs/pr-preview/pr-44/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_2856":58250,"_25058":58245,"_5":25391,"_17494":97524,"_23725":97525,"_2383":97526},[],"/docs/pr-preview/pr-44/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_2856":58251,"_25058":58245,"_5":25391,"_17494":97528,"_23725":97529,"_2383":97530},[],"/docs/pr-preview/pr-44/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_2856":58252,"_25058":58245,"_5":25391,"_17494":97532,"_23725":97533,"_2383":97534},[],"/docs/pr-preview/pr-44/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_2856":58253,"_25058":58245,"_5":25391,"_17494":97536,"_23725":97537,"_2383":97538},[],"/docs/pr-preview/pr-44/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_2856":58254,"_25058":58245,"_5":25391,"_17494":97540,"_23725":97541,"_2383":97542},[],"/docs/pr-preview/pr-44/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_2856":58255,"_25058":58245,"_5":25391,"_17494":97544,"_23725":97545,"_2383":97546},[],"/docs/pr-preview/pr-44/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_2856":58256,"_25058":58245,"_5":25391,"_17494":97548,"_23725":97549,"_2383":97550},[],"/docs/pr-preview/pr-44/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_2856":58257,"_25058":58245,"_17494":97552,"_5":17389,"_23725":58245,"_2383":97553},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_2856":58258,"_25058":58245,"_17494":97555,"_5":17389,"_23725":97513,"_2383":97556},[],"Un servicio publica un evento de dominio.",{"_2856":58259,"_25058":58245,"_17494":97558,"_5":17389,"_23725":97513,"_2383":97559},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_2856":58260,"_25058":58245,"_17494":97561,"_5":17389,"_23725":97513,"_2383":97562},[],"El filtro de cada suscripción decide si debe notificarse.",{"_2856":58261,"_25058":58245,"_17494":97564,"_5":17389,"_23725":97513,"_2383":97565},[],"Lamassu entrega el evento al canal configurado.",{"_2856":58262,"_25058":58245,"_17494":97567,"_5":17389,"_23725":97513,"_2383":97568},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_2856":58263,"_25058":58245,"_17494":97570,"_5":17389,"_23725":97517,"_2383":97571},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_2856":58264,"_25058":58245,"_17494":97573,"_5":17389,"_23725":97517,"_2383":97574},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_2856":58265,"_25058":58245,"_17494":97576,"_5":17389,"_23725":97517,"_2383":97577},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_2856":58266,"_25058":58245,"_17494":97579,"_5":17389,"_23725":97517,"_2383":97580},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_2856":58267,"_25058":58245,"_17494":97582,"_5":17389,"_23725":97517,"_2383":97583},[],"`apikey_options` necesita `header` y `key`.",{"_2856":58268,"_25058":58245,"_17494":97585,"_5":17389,"_23725":97517,"_2383":97586},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2856":58269,"_25058":58245,"_17494":97588,"_5":17389,"_23725":97517,"_2383":97589},[],"`mtls_options` necesita el PEM en línea `cert_content` y `key_content`; los valores que referencian archivos del servidor se rechazan.",{"_2856":58270,"_25058":58245,"_17494":97591,"_5":17389,"_23725":97517,"_2383":97592},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_2856":58271,"_25058":58245,"_17494":97594,"_5":17389,"_23725":97525,"_2383":97595},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_2856":58272,"_25058":58245,"_17494":97597,"_5":17389,"_23725":97529,"_2383":97598},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_2856":58273,"_25058":58245,"_17494":97600,"_5":17389,"_23725":97533,"_2383":97601},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_2856":58274,"_25058":58245,"_17494":97603,"_5":17389,"_23725":97533,"_2383":97604},[],"**None** notifica todas las instancias del evento.",{"_2856":58275,"_25058":58245,"_17494":97606,"_5":17389,"_23725":97533,"_2383":97607},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_2856":58276,"_25058":58245,"_17494":97609,"_5":17389,"_23725":97533,"_2383":97610},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_2856":58277,"_25058":58245,"_17494":97612,"_5":17389,"_23725":97533,"_2383":97613},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_2856":58278,"_25058":58245,"_17494":97615,"_5":17389,"_23725":97533,"_2383":97616},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_2856":58279,"_25058":58245,"_17494":97618,"_5":17389,"_23725":97537,"_2383":97619},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_2856":58280,"_25058":58245,"_17494":97621,"_5":17389,"_23725":97541,"_2383":97622},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_2856":58281,"_25058":58245,"_17494":97624,"_5":17389,"_23725":97541,"_2383":97625},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_2856":58282,"_25058":58245,"_17494":97627,"_5":17389,"_23725":97541,"_2383":97628},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_2856":58283,"_25058":58245,"_17494":97630,"_5":17389,"_23725":97541,"_2383":97631},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_2856":58284,"_25058":58245,"_17494":97633,"_5":17389,"_23725":97541,"_2383":97634},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_2856":58285,"_25058":58245,"_17494":97636,"_5":17389,"_23725":97541,"_2383":97637},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_2856":58286,"_25058":58245,"_17494":97639,"_5":17389,"_23725":97541,"_2383":97640},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_2856":58287,"_25058":58245,"_17494":97642,"_5":17389,"_23725":97541,"_2383":97643},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_2856":58288,"_25058":58245,"_17494":97645,"_5":17389,"_23725":97545,"_2383":97646},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_2856":58289,"_25058":58245,"_17494":97648,"_5":17389,"_23725":97549,"_2383":97649},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_2856":58290,"_25058":58245,"_17494":97651,"_5":17389,"_23725":97549,"_2383":97652},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_2856":58291,"_25058":58245,"_17494":97654,"_5":17389,"_23725":97549,"_2383":97655},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_2856":58292,"_25058":58245,"_17494":97657,"_5":17389,"_23725":97549,"_2383":97658},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_2856":58293,"_25058":58245,"_17494":97660,"_5":17389,"_23725":97549,"_2383":97661},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_2856":58294,"_25058":58245,"_17494":97663,"_5":17389,"_23725":97549,"_2383":97664},[],"**Validación:** `va.role.crl.create`.",{"_2856":58295,"_25058":58245,"_17494":97666,"_5":17389,"_23725":97549,"_2383":97667},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_2856":58296,"_25058":58245,"_17494":97669,"_5":17389,"_23725":97549,"_2383":97670},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_2856":58297,"_25058":58297,"_5":12268,"_2383":97672,"_25394":97673,"_17494":97674,"_23725":58297},"Registros de auditoría",[40730,96973,96974],[],{"_2856":58298,"_25058":58297,"_17494":97676,"_5":17389,"_23725":58297,"_2383":97677},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_2856":58299,"_25058":58297,"_5":25391,"_17494":97679,"_23725":97680,"_2383":97681},[],"/docs/pr-preview/pr-44/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_2856":58300,"_25058":58297,"_5":25391,"_17494":97683,"_23725":97684,"_2383":97685},[],"/docs/pr-preview/pr-44/es/platform/administration/audit-logs#cobertura","Cobertura",{"_2856":58301,"_25058":58297,"_5":25391,"_17494":97687,"_23725":97688,"_2383":97689},[],"/docs/pr-preview/pr-44/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_2856":58302,"_25058":58297,"_5":25391,"_17494":97691,"_23725":97692,"_2383":97693},[],"/docs/pr-preview/pr-44/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_2856":58303,"_25058":58297,"_5":25391,"_17494":97695,"_23725":97696,"_2383":97697},[],"/docs/pr-preview/pr-44/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_2856":58304,"_25058":58297,"_5":25391,"_17494":97699,"_23725":97700,"_2383":97701},[],"/docs/pr-preview/pr-44/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_2856":58305,"_25058":58297,"_5":25391,"_17494":97703,"_23725":97704,"_2383":97705},[],"/docs/pr-preview/pr-44/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_2856":58306,"_25058":58297,"_5":25391,"_17494":97707,"_23725":97708,"_2383":97709},[],"/docs/pr-preview/pr-44/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_2856":58307,"_25058":58297,"_5":25391,"_17494":97711,"_23725":97712,"_2383":97713},[],"/docs/pr-preview/pr-44/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_2856":58308,"_25058":58297,"_5":25391,"_17494":97715,"_23725":97716,"_2383":97717},[],"/docs/pr-preview/pr-44/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_2856":58309,"_25058":58297,"_5":25391,"_17494":97719,"_23725":97720,"_2383":97721},[],"/docs/pr-preview/pr-44/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_2856":58310,"_25058":58297,"_17494":97723,"_5":17389,"_23725":58297,"_2383":97724},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_2856":58311,"_25058":58297,"_17494":97726,"_5":17389,"_23725":97680,"_2383":97727},[],"El cuerpo de auditoría incluye:",{"_2856":58312,"_25058":58297,"_17494":97729,"_5":17389,"_23725":97680,"_2383":97730},[],"input: datos recibidos por la operación;",{"_2856":58313,"_25058":58297,"_17494":97732,"_5":17389,"_23725":97680,"_2383":97733},[],"has\\_error: indica si el servicio devolvió un error;",{"_2856":58314,"_25058":58297,"_17494":97735,"_5":17389,"_23725":97680,"_2383":97736},[],"output: resultado producido o mensaje de error;",{"_2856":58315,"_25058":58297,"_17494":97738,"_5":17389,"_23725":97680,"_2383":97739},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_2856":58316,"_25058":58297,"_17494":97741,"_5":17389,"_23725":97680,"_2383":97742},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_2856":58317,"_25058":58297,"_17494":97744,"_5":17389,"_23725":97680,"_2383":97745},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_2856":58318,"_25058":58297,"_17494":97747,"_5":17389,"_23725":97684,"_2383":97748},[],"El backend aplica auditoría a mutaciones de:",{"_2856":58319,"_25058":58297,"_17494":97750,"_5":17389,"_23725":97684,"_2383":97751},[],"autoridades, certificados y perfiles de emisión;",{"_2856":58320,"_25058":58297,"_17494":97753,"_5":17389,"_23725":97684,"_2383":97754},[],"claves y motores KMS;",{"_2856":58321,"_25058":58297,"_17494":97756,"_5":17389,"_23725":97684,"_2383":97757},[],"dispositivos e identidades;",{"_2856":58322,"_25058":58297,"_17494":97759,"_5":17389,"_23725":97684,"_2383":97760},[],"DMS y operaciones de enrolamiento;",{"_2856":58323,"_25058":58297,"_17494":97762,"_5":17389,"_23725":97684,"_2383":97763},[],"funciones de validación y CRL;",{"_2856":58324,"_25058":58297,"_17494":97765,"_5":17389,"_23725":97684,"_2383":97766},[],"principales, políticas y concesiones de autorización.",{"_2856":58325,"_25058":58297,"_17494":97768,"_5":17389,"_23725":97684,"_2383":97769},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_2856":58326,"_25058":58297,"_17494":97771,"_5":17389,"_23725":97688,"_2383":97772},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_2856":58327,"_25058":58297,"_17494":97774,"_5":17389,"_23725":97688,"_2383":97775},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_2856":58328,"_25058":58297,"_17494":97777,"_5":17389,"_23725":97688,"_2383":97778},[],"Diseña el consumidor para:",{"_2856":58329,"_25058":58297,"_17494":97780,"_5":17389,"_23725":97688,"_2383":97781},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_2856":58330,"_25058":58297,"_17494":97783,"_5":17389,"_23725":97688,"_2383":97784},[],"conservar el CloudEvent completo sin modificar;",{"_2856":58331,"_25058":58297,"_17494":97786,"_5":17389,"_23725":97688,"_2383":97787},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_2856":58332,"_25058":58297,"_17494":97789,"_5":17389,"_23725":97688,"_2383":97790},[],"cifrar en tránsito y en reposo;",{"_2856":58333,"_25058":58297,"_17494":97792,"_5":17389,"_23725":97688,"_2383":97793},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_2856":58334,"_25058":58297,"_17494":97795,"_5":17389,"_23725":97688,"_2383":97796},[],"aplicar una política explícita de retención y legal hold;",{"_2856":58335,"_25058":58297,"_17494":97798,"_5":17389,"_23725":97688,"_2383":97799},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_2856":58336,"_25058":58297,"_17494":97801,"_5":17389,"_23725":97692,"_2383":97802},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_2856":58337,"_25058":58297,"_17494":97804,"_5":17389,"_23725":97692,"_2383":97805},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_2856":58338,"_25058":58297,"_17494":97807,"_5":17389,"_23725":97700,"_2383":97808},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_2856":58339,"_25058":58297,"_17494":97810,"_5":17389,"_23725":97704,"_2383":97811},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_2856":58340,"_25058":58297,"_17494":97813,"_5":17389,"_23725":97708,"_2383":97814},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_2856":58341,"_25058":58297,"_17494":97816,"_5":17389,"_23725":97712,"_2383":97817},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_2856":58342,"_25058":58297,"_17494":97819,"_5":17389,"_23725":97716,"_2383":97820},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_2856":58343,"_25058":58297,"_17494":97822,"_5":17389,"_23725":97720,"_2383":97823},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_2856":58344,"_25058":58297,"_17494":97825,"_5":17389,"_23725":97720,"_2383":97826},[],"aparece un evento de auditoría correcto;",{"_2856":58345,"_25058":58297,"_17494":97828,"_5":17389,"_23725":97720,"_2383":97829},[],"el principal coincide con la identidad utilizada;",{"_2856":58346,"_25058":58297,"_17494":97831,"_5":17389,"_23725":97720,"_2383":97832},[],"el consumidor lo persiste una sola vez;",{"_2856":58347,"_25058":58297,"_17494":97834,"_5":17389,"_23725":97720,"_2383":97835},[],"puede recuperarse por recurso, actor y periodo;",{"_2856":58348,"_25058":58297,"_17494":97837,"_5":17389,"_23725":97720,"_2383":97838},[],"una interrupción del consumidor produce una alerta.",{"_2856":58349,"_25058":58297,"_17494":97840,"_5":17389,"_23725":97720,"_2383":97841},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_2856":58350,"_25058":58350,"_5":12268,"_2383":97843,"_25394":97844,"_17494":97845,"_23725":58350},"Arquitectura de la plataforma",[40730,96973],[],{"_2856":58351,"_25058":58350,"_17494":97847,"_5":17389,"_23725":58350,"_2383":97848},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_2856":58352,"_25058":58350,"_5":25391,"_17494":97850,"_23725":97851,"_2383":97852},[],"/docs/pr-preview/pr-44/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_2856":58353,"_25058":58350,"_5":25391,"_17494":97854,"_23725":97855,"_2383":97856},[],"/docs/pr-preview/pr-44/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_2856":58354,"_25058":58350,"_5":25391,"_17494":97858,"_23725":97859,"_2383":97860},[],"/docs/pr-preview/pr-44/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_2856":58355,"_25058":58350,"_5":25391,"_17494":97862,"_23725":97863,"_2383":97864},[],"/docs/pr-preview/pr-44/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_2856":58356,"_25058":58350,"_5":25391,"_17494":97866,"_23725":97867,"_2383":97868},[],"/docs/pr-preview/pr-44/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_2856":58357,"_25058":58350,"_17494":97870,"_5":17389,"_23725":58350,"_2383":97871},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_2856":58358,"_25058":58350,"_17494":97873,"_5":17389,"_23725":58350,"_2383":97874},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_2856":58359,"_25058":58350,"_17494":97876,"_5":17389,"_23725":97851,"_2383":97877},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_2856":58360,"_25058":58350,"_17494":97879,"_5":17389,"_23725":97855,"_2383":97880},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_2856":58361,"_25058":58350,"_17494":97882,"_5":17389,"_23725":97859,"_2383":97883},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_2856":58362,"_25058":58350,"_17494":97885,"_5":17389,"_23725":97863,"_2383":97886},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_2856":58363,"_25058":58350,"_17494":97888,"_5":17389,"_23725":97867,"_2383":97889},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_2856":58364,"_25058":58364,"_5":12268,"_2383":97891,"_25394":97892,"_17494":97893,"_23725":58364},"Cómo funciona Lamassu",[40730,96973],[],{"_2856":58365,"_25058":58364,"_17494":97895,"_5":17389,"_23725":58364,"_2383":97896},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_2856":58366,"_25058":58364,"_5":25391,"_17494":97898,"_23725":97899,"_2383":97900},[],"/docs/pr-preview/pr-44/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_2856":58367,"_25058":58364,"_5":25391,"_17494":97902,"_23725":97903,"_2383":97904},[],"/docs/pr-preview/pr-44/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_2856":58368,"_25058":58364,"_17494":97906,"_5":17389,"_23725":58364,"_2383":97907},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_2856":58369,"_25058":58364,"_17494":97909,"_5":17389,"_23725":97899,"_2383":97910},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_2856":58370,"_25058":58364,"_17494":97912,"_5":17389,"_23725":97899,"_2383":97913},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_2856":58371,"_25058":58364,"_17494":97915,"_5":17389,"_23725":97899,"_2383":97916},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_2856":58372,"_25058":58364,"_17494":97918,"_5":17389,"_23725":97899,"_2383":97919},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_2856":58373,"_25058":58364,"_17494":97921,"_5":17389,"_23725":97899,"_2383":97922},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_2856":58374,"_25058":58364,"_17494":97924,"_5":17389,"_23725":97903,"_2383":97925},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_2856":58375,"_25058":58364,"_17494":97927,"_5":17389,"_23725":97903,"_2383":97928},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_2856":58376,"_25058":58364,"_17494":97930,"_5":17389,"_23725":97903,"_2383":97931},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_2856":58377,"_25058":58364,"_17494":97933,"_5":17389,"_23725":97903,"_2383":97934},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_2856":58378,"_25058":58364,"_17494":97936,"_5":17389,"_23725":97903,"_2383":97937},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_2856":58379,"_25058":58364,"_17494":97939,"_5":17389,"_23725":97903,"_2383":97940},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_2856":58380,"_25058":58364,"_17494":97942,"_5":17389,"_23725":97903,"_2383":97943},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2856":58381,"_25058":58381,"_5":12268,"_2383":97945,"_25394":97946,"_17494":97947,"_23725":58381},"Dispositivos e identidades",[40730,96973,43048,97945],[],{"_2856":58382,"_25058":58381,"_17494":97949,"_5":17389,"_23725":58381,"_2383":97950},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_2856":58383,"_25058":58381,"_5":25391,"_17494":97952,"_23725":97953,"_2383":97954},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_2856":58384,"_25058":58381,"_5":25391,"_17494":97956,"_23725":97957,"_2383":97958},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_2856":58385,"_25058":58381,"_5":25391,"_17494":97960,"_23725":97961,"_2383":97962},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_2856":58386,"_25058":58381,"_5":25391,"_17494":97964,"_23725":97965,"_2383":97966},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_2856":58387,"_25058":58381,"_5":25391,"_17494":97968,"_23725":97969,"_2383":97970},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_2856":58388,"_25058":58381,"_5":25391,"_17494":97972,"_23725":97973,"_2383":97974},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_2856":58389,"_25058":58381,"_5":25391,"_17494":97976,"_23725":97977,"_2383":97978},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_2856":58390,"_25058":58381,"_5":25391,"_17494":97980,"_23725":97981,"_2383":97982},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_2856":58391,"_25058":58381,"_5":25391,"_17494":97984,"_23725":97985,"_2383":97986},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_2856":58392,"_25058":58381,"_5":25391,"_17494":97988,"_23725":97989,"_2383":97990},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_2856":58393,"_25058":58381,"_5":25391,"_17494":97992,"_23725":97993,"_2383":97994},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_2856":58394,"_25058":58381,"_17494":97996,"_5":17389,"_23725":58381,"_2383":97997},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_2856":58395,"_25058":58381,"_17494":97999,"_5":17389,"_23725":58381,"_2383":98000},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_2856":58396,"_25058":58381,"_17494":98002,"_5":17389,"_23725":97953,"_2383":98003},[],"Vista operativa",{"_2856":58397,"_25058":58381,"_17494":98005,"_5":17389,"_23725":97953,"_2383":98006},[],"Interpretación",{"_2856":58398,"_25058":58381,"_17494":98008,"_5":17389,"_23725":97953,"_2383":43111},[],{"_2856":58399,"_25058":58381,"_17494":98010,"_5":17389,"_23725":97953,"_2383":98011},[],"Hay registro, pero todavía no hay identidad asociada.",{"_2856":58400,"_25058":58381,"_17494":98013,"_5":17389,"_23725":97953,"_2383":43117},[],{"_2856":58401,"_25058":58381,"_17494":98015,"_5":17389,"_23725":97953,"_2383":98016},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_2856":58402,"_25058":58381,"_17494":98018,"_5":17389,"_23725":97953,"_2383":43123},[],{"_2856":58403,"_25058":58381,"_17494":98020,"_5":17389,"_23725":97953,"_2383":98021},[],"La identidad está en la ventana operativa de renovación.",{"_2856":58404,"_25058":58381,"_17494":98023,"_5":17389,"_23725":97953,"_2383":43129},[],{"_2856":58405,"_25058":58381,"_17494":98025,"_5":17389,"_23725":97953,"_2383":98026},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_2856":58406,"_25058":58381,"_17494":98028,"_5":17389,"_23725":97953,"_2383":43135},[],{"_2856":58407,"_25058":58381,"_17494":98030,"_5":17389,"_23725":97953,"_2383":98031},[],"La identidad ha vencido.",{"_2856":58408,"_25058":58381,"_17494":98033,"_5":17389,"_23725":97953,"_2383":43141},[],{"_2856":58409,"_25058":58381,"_17494":98035,"_5":17389,"_23725":97953,"_2383":98036},[],"La identidad está marcada como revocada.",{"_2856":58410,"_25058":58381,"_17494":98038,"_5":17389,"_23725":97953,"_2383":43147},[],{"_2856":58411,"_25058":58381,"_17494":98040,"_5":17389,"_23725":97953,"_2383":98041},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_2856":58412,"_25058":58381,"_17494":98043,"_5":17389,"_23725":97953,"_2383":98044},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_2856":58413,"_25058":58381,"_17494":98046,"_5":17389,"_23725":97957,"_2383":98047},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_2856":58414,"_25058":58381,"_17494":98049,"_5":17389,"_23725":97957,"_2383":98050},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_2856":58415,"_25058":58381,"_17494":98052,"_5":17389,"_23725":97957,"_2383":98053},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_2856":58416,"_25058":58381,"_17494":98055,"_5":17389,"_23725":97957,"_2383":98056},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_2856":58417,"_25058":58381,"_17494":98058,"_5":17389,"_23725":97961,"_2383":98059},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_2856":58418,"_25058":58381,"_17494":98061,"_5":17389,"_23725":97965,"_2383":98062},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_2856":58419,"_25058":58381,"_17494":98064,"_5":17389,"_23725":97969,"_2383":98065},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_2856":58420,"_25058":58381,"_17494":98067,"_5":17389,"_23725":97973,"_2383":98068},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_2856":58421,"_25058":58381,"_17494":98070,"_5":17389,"_23725":97977,"_2383":98071},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_2856":58422,"_25058":58381,"_17494":98073,"_5":17389,"_23725":97977,"_2383":98074},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_2856":58423,"_25058":58381,"_17494":98076,"_5":17389,"_23725":97981,"_2383":98077},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_2856":58424,"_25058":58381,"_17494":98079,"_5":17389,"_23725":97981,"_2383":98080},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_2856":58425,"_25058":58381,"_17494":98082,"_5":17389,"_23725":97981,"_2383":98083},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_2856":58426,"_25058":58381,"_17494":98085,"_5":17389,"_23725":97981,"_2383":98086},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_2856":58427,"_25058":58381,"_17494":98088,"_5":17389,"_23725":97981,"_2383":98089},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_2856":58428,"_25058":58381,"_17494":98091,"_5":17389,"_23725":97981,"_2383":98092},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_2856":58429,"_25058":58381,"_17494":98094,"_5":17389,"_23725":97985,"_2383":98095},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_2856":58430,"_25058":58381,"_17494":98097,"_5":17389,"_23725":97985,"_2383":98098},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_2856":58431,"_25058":58381,"_17494":98100,"_5":17389,"_23725":97989,"_2383":98101},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_2856":58432,"_25058":58381,"_17494":98103,"_5":17389,"_23725":97989,"_2383":98104},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_2856":58433,"_25058":58381,"_17494":98106,"_5":17389,"_23725":97989,"_2383":98107},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_2856":58434,"_25058":58381,"_17494":98109,"_5":17389,"_23725":97989,"_2383":98110},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_2856":58435,"_25058":58381,"_17494":98112,"_5":17389,"_23725":97993,"_2383":98113},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2856":58436,"_25058":58381,"_17494":98115,"_5":17389,"_23725":97993,"_2383":98116},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2856":58437,"_25058":58437,"_5":12268,"_2383":98118,"_25394":98119,"_17494":98121,"_23725":58437},"Identidad inicial y autenticación",[40730,96973,43048,97945,98120],"Enrolamiento con PKI",[],{"_2856":58438,"_25058":58437,"_17494":98123,"_5":17389,"_23725":58437,"_2383":98124},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_2856":58439,"_25058":58437,"_5":25391,"_17494":98126,"_23725":98127,"_2383":98128},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_2856":58440,"_25058":58437,"_5":25391,"_17494":98130,"_23725":98131,"_2383":98132},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_2856":58441,"_25058":58437,"_5":25391,"_17494":98134,"_23725":98135,"_2383":98136},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_2856":58442,"_25058":58437,"_5":25391,"_17494":98138,"_23725":98139,"_2383":98140},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_2856":58443,"_25058":58437,"_5":25391,"_17494":98142,"_23725":98143,"_2383":98144},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_2856":58444,"_25058":58437,"_17494":98146,"_5":17389,"_23725":58437,"_2383":98147},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_2856":58445,"_25058":58437,"_17494":98149,"_5":17389,"_23725":98127,"_2383":98150},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_2856":58446,"_25058":58437,"_17494":98152,"_5":17389,"_23725":98127,"_2383":98153},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_2856":58447,"_25058":58437,"_17494":98155,"_5":17389,"_23725":98131,"_2383":98156},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_2856":58448,"_25058":58437,"_17494":98158,"_5":17389,"_23725":98131,"_2383":98159},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_2856":58449,"_25058":58437,"_17494":98161,"_5":17389,"_23725":98131,"_2383":98162},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_2856":58450,"_25058":58437,"_17494":98164,"_5":17389,"_23725":98135,"_2383":98165},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_2856":58451,"_25058":58437,"_17494":98167,"_5":17389,"_23725":98135,"_2383":98168},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_2856":58452,"_25058":58437,"_17494":98170,"_5":17389,"_23725":98139,"_2383":98171},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_2856":58453,"_25058":58437,"_17494":98173,"_5":17389,"_23725":98139,"_2383":98174},[],"Ejemplo de cuerpo:",{"_2856":58454,"_25058":58437,"_17494":98176,"_5":17389,"_23725":98139,"_2383":98177},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_2856":58455,"_25058":58437,"_17494":98179,"_5":17389,"_23725":98139,"_2383":98180},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_2856":58456,"_25058":58437,"_17494":98182,"_5":17389,"_23725":98139,"_2383":98183},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_2856":58457,"_25058":58437,"_17494":98185,"_5":17389,"_23725":98139,"_2383":98186},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_2856":58458,"_25058":58437,"_17494":98188,"_5":17389,"_23725":98143,"_2383":98189},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_2856":58459,"_25058":58437,"_17494":98191,"_5":17389,"_23725":98143,"_2383":98192},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_2856":58460,"_25058":58460,"_5":12268,"_2383":98194,"_25394":98195,"_17494":98196,"_23725":58460},"Configura y opera el DMS",[40730,96973,43048,97945,98120],[],{"_2856":58461,"_25058":58460,"_17494":98198,"_5":17389,"_23725":58460,"_2383":98199},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_2856":58462,"_25058":58460,"_5":25391,"_17494":98201,"_23725":98202,"_2383":95674},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_2856":58463,"_25058":58460,"_5":25391,"_17494":98204,"_23725":98205,"_2383":98206},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_2856":58464,"_25058":58460,"_5":25391,"_17494":98208,"_23725":98209,"_2383":98210},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_2856":58465,"_25058":58460,"_5":25391,"_17494":98212,"_23725":98213,"_2383":98214},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_2856":58466,"_25058":58460,"_5":25391,"_17494":98216,"_23725":98217,"_2383":98218},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_2856":58467,"_25058":58460,"_5":25391,"_17494":98220,"_23725":98221,"_2383":98222},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_2856":58468,"_25058":58460,"_5":25391,"_17494":98224,"_23725":98225,"_2383":98226},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_2856":58469,"_25058":58460,"_5":25391,"_17494":98228,"_23725":98229,"_2383":98230},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_2856":58470,"_25058":58460,"_5":25391,"_17494":98232,"_23725":98233,"_2383":43343},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_2856":58471,"_25058":58460,"_5":25391,"_17494":98235,"_23725":98236,"_2383":43347},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_2856":58472,"_25058":58460,"_5":25391,"_17494":98238,"_23725":98239,"_2383":98240},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_2856":58473,"_25058":58460,"_5":25391,"_17494":98242,"_23725":98243,"_2383":98244},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_2856":58474,"_25058":58460,"_5":25391,"_17494":98246,"_23725":98247,"_2383":98248},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_2856":58475,"_25058":58460,"_5":25391,"_17494":98250,"_23725":98251,"_2383":98252},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_2856":58476,"_25058":58460,"_5":25391,"_17494":98254,"_23725":98255,"_2383":43367},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_2856":58477,"_25058":58460,"_5":25391,"_17494":98257,"_23725":98258,"_2383":98259},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_2856":58478,"_25058":58460,"_5":25391,"_17494":98261,"_23725":98262,"_2383":98263},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_2856":58479,"_25058":58460,"_5":25391,"_17494":98265,"_23725":98266,"_2383":98267},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_2856":58480,"_25058":58460,"_17494":98269,"_5":17389,"_23725":58460,"_2383":98270},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_2856":58481,"_25058":58460,"_17494":98272,"_5":17389,"_23725":98202,"_2383":98273},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_2856":58482,"_25058":58460,"_17494":98275,"_5":17389,"_23725":98202,"_2383":98276},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_2856":58483,"_25058":58460,"_17494":98278,"_5":17389,"_23725":98209,"_2383":98279},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_2856":58484,"_25058":58460,"_17494":98281,"_5":17389,"_23725":98213,"_2383":98282},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_2856":58485,"_25058":58460,"_17494":98284,"_5":17389,"_23725":98217,"_2383":98285},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_2856":58486,"_25058":58460,"_17494":98287,"_5":17389,"_23725":98221,"_2383":98288},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_2856":58487,"_25058":58460,"_17494":98290,"_5":17389,"_23725":98225,"_2383":98291},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_2856":58488,"_25058":58460,"_17494":98293,"_5":17389,"_23725":98233,"_2383":98294},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_2856":58489,"_25058":58460,"_17494":98296,"_5":17389,"_23725":98233,"_2383":98297},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_2856":58490,"_25058":58460,"_17494":98299,"_5":17389,"_23725":98236,"_2383":98300},[],"Campo de `settings.enrollment_settings`",{"_2856":58491,"_25058":58460,"_17494":98302,"_5":17389,"_23725":98236,"_2383":98303},[],"Decisión",{"_2856":58492,"_25058":58460,"_17494":98305,"_5":17389,"_23725":98236,"_2383":43418},[],{"_2856":58493,"_25058":58460,"_17494":98307,"_5":17389,"_23725":98236,"_2383":98308},[],"`EST_RFC7030` para estas operaciones.",{"_2856":58494,"_25058":58460,"_17494":98310,"_5":17389,"_23725":98236,"_2383":43424},[],{"_2856":58495,"_25058":58460,"_17494":98312,"_5":17389,"_23725":98236,"_2383":98313},[],"ID de la CA que firmará.",{"_2856":58496,"_25058":58460,"_17494":98315,"_5":17389,"_23725":98236,"_2383":43430},[],{"_2856":58497,"_25058":58460,"_17494":98317,"_5":17389,"_23725":98236,"_2383":98318},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_2856":58498,"_25058":58460,"_17494":98320,"_5":17389,"_23725":98236,"_2383":43436},[],{"_2856":58499,"_25058":58460,"_17494":98322,"_5":17389,"_23725":98236,"_2383":98323},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_2856":58500,"_25058":58460,"_17494":98325,"_5":17389,"_23725":98236,"_2383":43442},[],{"_2856":58501,"_25058":58460,"_17494":98327,"_5":17389,"_23725":98236,"_2383":98328},[],"Uno de los cuatro modos de autenticación.",{"_2856":58502,"_25058":58460,"_17494":98330,"_5":17389,"_23725":98236,"_2383":98331},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_2856":58503,"_25058":58460,"_17494":98333,"_5":17389,"_23725":98239,"_2383":98334},[],"Los bloques son independientes:",{"_2856":58504,"_25058":58460,"_17494":98336,"_5":17389,"_23725":98239,"_2383":98337},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_2856":58505,"_25058":58460,"_17494":98339,"_5":17389,"_23725":98239,"_2383":98340},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_2856":58506,"_25058":58460,"_17494":98342,"_5":17389,"_23725":98239,"_2383":43460},[],{"_2856":58507,"_25058":58460,"_17494":98344,"_5":17389,"_23725":98239,"_2383":98345},[],"Control aplicado en la operación configurada",{"_2856":58508,"_25058":58460,"_17494":98347,"_5":17389,"_23725":98239,"_2383":43466},[],{"_2856":58509,"_25058":58460,"_17494":98349,"_5":17389,"_23725":98239,"_2383":98350},[],"Validación del certificado presentado.",{"_2856":58510,"_25058":58460,"_17494":98352,"_5":17389,"_23725":98239,"_2383":43472},[],{"_2856":58511,"_25058":58460,"_17494":98354,"_5":17389,"_23725":98239,"_2383":98355},[],"Autorización del webhook configurado.",{"_2856":58512,"_25058":58460,"_17494":98357,"_5":17389,"_23725":98239,"_2383":43478},[],{"_2856":58513,"_25058":58460,"_17494":98359,"_5":17389,"_23725":98239,"_2383":98360},[],"Validación del certificado y, después, aprobación del webhook.",{"_2856":58514,"_25058":58460,"_17494":98362,"_5":17389,"_23725":98239,"_2383":43484},[],{"_2856":58515,"_25058":58460,"_17494":98364,"_5":17389,"_23725":98239,"_2383":98365},[],"Sin autenticación del solicitante por el DMS.",{"_2856":58516,"_25058":58460,"_17494":98367,"_5":17389,"_23725":98239,"_2383":98368},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_2856":58517,"_25058":58460,"_17494":98370,"_5":17389,"_23725":98239,"_2383":98371},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_2856":58518,"_25058":58460,"_17494":98373,"_5":17389,"_23725":98239,"_2383":98374},[],"En reenrolamiento con certificado, el validador utiliza la CA de enrolamiento, después `additional_validation_cas`, y la opción `enable_expired_renewal`. No presupongas que copiar `validation_cas` del bloque inicial cambia esos emisores.",{"_2856":58519,"_25058":58460,"_17494":98376,"_5":17389,"_23725":98239,"_2383":98377},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_2856":58520,"_25058":58460,"_17494":98379,"_5":17389,"_23725":98243,"_2383":98380},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_2856":58521,"_25058":58460,"_17494":98382,"_5":17389,"_23725":98243,"_2383":98383},[],"Campo de `external_webhook_settings`",{"_2856":58522,"_25058":58460,"_17494":98385,"_5":17389,"_23725":98243,"_2383":98303},[],{"_2856":58523,"_25058":58460,"_17494":98387,"_5":17389,"_23725":98243,"_2383":43510},[],{"_2856":58524,"_25058":58460,"_17494":98389,"_5":17389,"_23725":98243,"_2383":98390},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_2856":58525,"_25058":58460,"_17494":98392,"_5":17389,"_23725":98243,"_2383":43516},[],{"_2856":58526,"_25058":58460,"_17494":98394,"_5":17389,"_23725":98243,"_2383":98395},[],"`POST` o `PUT`; `POST` por defecto.",{"_2856":58527,"_25058":58460,"_17494":98397,"_5":17389,"_23725":98243,"_2383":43522},[],{"_2856":58528,"_25058":58460,"_17494":98399,"_5":17389,"_23725":98243,"_2383":98400},[],"Etiqueta usada en los logs del servicio.",{"_2856":58529,"_25058":58460,"_17494":98402,"_5":17389,"_23725":98243,"_2383":43528},[],{"_2856":58530,"_25058":58460,"_17494":98404,"_5":17389,"_23725":98243,"_2383":98405},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_2856":58531,"_25058":58460,"_17494":98407,"_5":17389,"_23725":98243,"_2383":43534},[],{"_2856":58532,"_25058":58460,"_17494":98409,"_5":17389,"_23725":98243,"_2383":98410},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_2856":58533,"_25058":58460,"_17494":98412,"_5":17389,"_23725":98243,"_2383":43540},[],{"_2856":58534,"_25058":58460,"_17494":98414,"_5":17389,"_23725":98243,"_2383":98415},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2856":58535,"_25058":58460,"_17494":98417,"_5":17389,"_23725":98243,"_2383":43546},[],{"_2856":58536,"_25058":58460,"_17494":98419,"_5":17389,"_23725":98243,"_2383":98420},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM en línea.",{"_2856":58537,"_25058":58460,"_17494":98422,"_5":17389,"_23725":98243,"_2383":43552},[],{"_2856":58538,"_25058":58460,"_17494":98424,"_5":17389,"_23725":98243,"_2383":98425},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_2856":58539,"_25058":58460,"_17494":98427,"_5":17389,"_23725":98243,"_2383":43558},[],{"_2856":58540,"_25058":58460,"_17494":98429,"_5":17389,"_23725":98243,"_2383":98430},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_2856":58541,"_25058":58460,"_17494":98432,"_5":17389,"_23725":98243,"_2383":98433},[],"Reglas de esa configuración:",{"_2856":58542,"_25058":58460,"_17494":98435,"_5":17389,"_23725":98243,"_2383":98436},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que entrega el PEM como `mtls_options.cert_content` y `key_content`.",{"_2856":58543,"_25058":58460,"_17494":98438,"_5":17389,"_23725":98243,"_2383":98439},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_2856":58544,"_25058":58460,"_17494":98441,"_5":17389,"_23725":98243,"_2383":98442},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_2856":58545,"_25058":58460,"_17494":98444,"_5":17389,"_23725":98243,"_2383":98445},[],"La API ignora los campos heredados `validate_server_cert`, `apikey`, `oidc` y `mtls`. Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` que aún solo contenga los campos de opción heredados (`apikey`, `oidc`, `mtls`) falla la validación con 400; solo se aceptan cuerpos heredados `noauth`, y sus credenciales se descartan.",{"_2856":58546,"_25058":58460,"_17494":98447,"_5":17389,"_23725":98243,"_2383":98448},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_2856":58547,"_25058":58460,"_17494":98450,"_5":17389,"_23725":98243,"_2383":98451},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_2856":58548,"_25058":58460,"_17494":98453,"_5":17389,"_23725":98243,"_2383":98454},[],"La migración `20260604110000` copia la autenticación inicial al bloque de renovación si este falta y existe la estructura necesaria. No sustituye una configuración ya presente. Después de actualizar, lee ambos bloques; si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_2856":58549,"_25058":58460,"_17494":98456,"_5":17389,"_23725":98243,"_2383":98457},[],"La migración `20261021120000` reescribe todas las configuraciones de webhook almacenadas con este formato: `validate_server_cert` pasa a ser `insecure_skip_verify` negado (una configuración con `validate_server_cert` a false sigue sin verificar el certificado), `oidc` pasa a ser `jwt_options`, `apikey` pasa a ser `apikey_options` y `mtls` pasa a ser `mtls_options`. Cuando el certificado y la clave heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `key_content` y no requieren ninguna acción. En cualquier otro caso, incluida una configuración mixta (certificado PEM y clave como ruta de fichero), ambos valores pasan a `mtls_options.cert_file` y `key_file`. La entrega rechaza cualquier configuración de webhook que haga referencia a ficheros, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se vuelvan a introducir como contenido PEM, o se eliminen los campos de fichero sobrantes si el webhook no usa mTLS. Si la consola de tu versión no muestra esos campos, edita el DMS mediante la API de DMS.",{"_2856":58550,"_25058":58460,"_17494":98459,"_5":17389,"_23725":98247,"_2383":98460},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_2856":58551,"_25058":58460,"_17494":98462,"_5":17389,"_23725":98251,"_2383":98463},[],"Campo de `settings.reenrollment_settings`",{"_2856":58552,"_25058":58460,"_17494":98465,"_5":17389,"_23725":98251,"_2383":98466},[],"Función",{"_2856":58553,"_25058":58460,"_17494":98468,"_5":17389,"_23725":98251,"_2383":43599},[],{"_2856":58554,"_25058":58460,"_17494":98470,"_5":17389,"_23725":98251,"_2383":98471},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_2856":58555,"_25058":58460,"_17494":98473,"_5":17389,"_23725":98251,"_2383":43605},[],{"_2856":58556,"_25058":58460,"_17494":98475,"_5":17389,"_23725":98251,"_2383":98476},[],"Umbral operativo preventivo de monitorización.",{"_2856":58557,"_25058":58460,"_17494":98478,"_5":17389,"_23725":98251,"_2383":43611},[],{"_2856":58558,"_25058":58460,"_17494":98480,"_5":17389,"_23725":98251,"_2383":98481},[],"Umbral operativo crítico de monitorización.",{"_2856":58559,"_25058":58460,"_17494":98483,"_5":17389,"_23725":98251,"_2383":43617},[],{"_2856":58560,"_25058":58460,"_17494":98485,"_5":17389,"_23725":98251,"_2383":98486},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_2856":58561,"_25058":58460,"_17494":98488,"_5":17389,"_23725":98251,"_2383":43623},[],{"_2856":58562,"_25058":58460,"_17494":98490,"_5":17389,"_23725":98251,"_2383":98491},[],"Emisores adicionales para la credencial mTLS durante una migración.",{"_2856":58563,"_25058":58460,"_17494":98493,"_5":17389,"_23725":98251,"_2383":43629},[],{"_2856":58564,"_25058":58460,"_17494":98495,"_5":17389,"_23725":98251,"_2383":98496},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_2856":58565,"_25058":58460,"_17494":98498,"_5":17389,"_23725":98251,"_2383":98499},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_2856":58566,"_25058":58460,"_17494":98501,"_5":17389,"_23725":98255,"_2383":98502},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. Algoritmo y tamaño proceden de su campo `key`; el perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_2856":58567,"_25058":58460,"_17494":98504,"_5":17389,"_23725":98258,"_2383":96031},[],{"_2856":58568,"_25058":58460,"_17494":98506,"_5":17389,"_23725":98258,"_2383":98507},[],"Qué publica",{"_2856":58569,"_25058":58460,"_17494":98509,"_5":17389,"_23725":98258,"_2383":43646},[],{"_2856":58570,"_25058":58460,"_17494":98511,"_5":17389,"_23725":98258,"_2383":98512},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_2856":58571,"_25058":58460,"_17494":98514,"_5":17389,"_23725":98258,"_2383":43652},[],{"_2856":58572,"_25058":58460,"_17494":98516,"_5":17389,"_23725":98258,"_2383":98517},[],"Certificado de la CA emisora seleccionada.",{"_2856":58573,"_25058":58460,"_17494":98519,"_5":17389,"_23725":98258,"_2383":43658},[],{"_2856":58574,"_25058":58460,"_17494":98521,"_5":17389,"_23725":98258,"_2383":98522},[],"Certificados de las CAs elegidas explícitamente.",{"_2856":58575,"_25058":58460,"_17494":98524,"_5":17389,"_23725":98258,"_2383":98525},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_2856":58576,"_25058":58460,"_17494":98527,"_5":17389,"_23725":98262,"_2383":98528},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_2856":58577,"_25058":58460,"_17494":98530,"_5":17389,"_23725":98262,"_2383":98531},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_2856":58578,"_25058":58460,"_17494":98533,"_5":17389,"_23725":98262,"_2383":98534},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_2856":58579,"_25058":58460,"_17494":98536,"_5":17389,"_23725":98266,"_2383":98537},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_2856":58580,"_25058":58580,"_5":12268,"_2383":98539,"_25394":98540,"_17494":98541,"_23725":58580},"Integra el cliente EST",[40730,96973,43048,97945,98120],[],{"_2856":58581,"_25058":58580,"_17494":98543,"_5":17389,"_23725":58580,"_2383":98544},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_2856":58582,"_25058":58580,"_5":25391,"_17494":98546,"_23725":98547,"_2383":95674},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_2856":58583,"_25058":58580,"_5":25391,"_17494":98549,"_23725":98550,"_2383":98551},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_2856":58584,"_25058":58580,"_5":25391,"_17494":98553,"_23725":98554,"_2383":98555},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_2856":58585,"_25058":58580,"_5":25391,"_17494":98557,"_23725":98558,"_2383":98559},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_2856":58586,"_25058":58580,"_5":25391,"_17494":98561,"_23725":98562,"_2383":98563},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_2856":58587,"_25058":58580,"_5":25391,"_17494":98565,"_23725":98566,"_2383":98567},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_2856":58588,"_25058":58580,"_17494":98569,"_5":17389,"_23725":58580,"_2383":98570},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_2856":58589,"_25058":58580,"_17494":98572,"_5":17389,"_23725":98547,"_2383":98573},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_2856":58590,"_25058":58580,"_17494":98575,"_5":17389,"_23725":98547,"_2383":98576},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_2856":58591,"_25058":58580,"_17494":98578,"_5":17389,"_23725":98547,"_2383":98579},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_2856":58592,"_25058":58580,"_17494":98581,"_5":17389,"_23725":98550,"_2383":98582},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_2856":58593,"_25058":58580,"_17494":98584,"_5":17389,"_23725":98550,"_2383":98585},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_2856":58594,"_25058":58580,"_17494":98587,"_5":17389,"_23725":98554,"_2383":98588},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_2856":58595,"_25058":58580,"_17494":98590,"_5":17389,"_23725":98554,"_2383":98591},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_2856":58596,"_25058":58580,"_17494":98593,"_5":17389,"_23725":98558,"_2383":98594},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_2856":58597,"_25058":58580,"_17494":98596,"_5":17389,"_23725":98558,"_2383":98597},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_2856":58598,"_25058":58580,"_17494":98599,"_5":17389,"_23725":98562,"_2383":98600},[],"Para el caso de una raíz que emite directamente:",{"_2856":58599,"_25058":58580,"_17494":98602,"_5":17389,"_23725":98562,"_2383":98603},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_2856":58600,"_25058":58580,"_17494":98605,"_5":17389,"_23725":98562,"_2383":98606},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_2856":58601,"_25058":58580,"_17494":98608,"_5":17389,"_23725":98566,"_2383":98609},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_2856":58602,"_25058":58602,"_5":12268,"_2383":98611,"_25394":98612,"_17494":98613,"_23725":58602},"Referencia EST",[40730,96973,43048,97945,98120],[],{"_2856":58603,"_25058":58602,"_17494":98615,"_5":17389,"_23725":58602,"_2383":98616},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_2856":58604,"_25058":58602,"_5":25391,"_17494":98618,"_23725":98619,"_2383":98620},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_2856":58605,"_25058":58602,"_5":25391,"_17494":98622,"_23725":98623,"_2383":18998},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2856":58606,"_25058":58602,"_5":25391,"_17494":98625,"_23725":98626,"_2383":21758},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2856":58607,"_25058":58602,"_5":25391,"_17494":98628,"_23725":98629,"_2383":21765},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2856":58608,"_25058":58602,"_5":25391,"_17494":98631,"_23725":98632,"_2383":21135},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2856":58609,"_25058":58602,"_5":25391,"_17494":98634,"_23725":98635,"_2383":98636},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_2856":58610,"_25058":58602,"_5":25391,"_17494":98638,"_23725":98639,"_2383":98640},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_2856":58611,"_25058":58602,"_5":25391,"_17494":98642,"_23725":98643,"_2383":98644},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_2856":58612,"_25058":58602,"_17494":98646,"_5":17389,"_23725":58602,"_2383":98647},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_2856":58613,"_25058":58602,"_17494":98649,"_5":17389,"_23725":98619,"_2383":98650},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_2856":58614,"_25058":58602,"_17494":98652,"_5":17389,"_23725":98619,"_2383":96764},[],{"_2856":58615,"_25058":58602,"_17494":98654,"_5":17389,"_23725":98619,"_2383":98655},[],"Método",{"_2856":58616,"_25058":58602,"_17494":98657,"_5":17389,"_23725":98619,"_2383":98658},[],"Autenticación y condición",{"_2856":58617,"_25058":58602,"_17494":98660,"_5":17389,"_23725":98619,"_2383":43801},[],{"_2856":58618,"_25058":58602,"_17494":98662,"_5":17389,"_23725":98619,"_2383":43804},[],{"_2856":58619,"_25058":58602,"_17494":98664,"_5":17389,"_23725":98619,"_2383":98665},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_2856":58620,"_25058":58602,"_17494":98667,"_5":17389,"_23725":98619,"_2383":43810},[],{"_2856":58621,"_25058":58602,"_17494":98669,"_5":17389,"_23725":98619,"_2383":43813},[],{"_2856":58622,"_25058":58602,"_17494":98671,"_5":17389,"_23725":98619,"_2383":98672},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_2856":58623,"_25058":58602,"_17494":98674,"_5":17389,"_23725":98619,"_2383":43819},[],{"_2856":58624,"_25058":58602,"_17494":98676,"_5":17389,"_23725":98619,"_2383":43813},[],{"_2856":58625,"_25058":58602,"_17494":98678,"_5":17389,"_23725":98619,"_2383":98679},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_2856":58626,"_25058":58602,"_17494":98681,"_5":17389,"_23725":98619,"_2383":43827},[],{"_2856":58627,"_25058":58602,"_17494":98683,"_5":17389,"_23725":98619,"_2383":43813},[],{"_2856":58628,"_25058":58602,"_17494":98685,"_5":17389,"_23725":98619,"_2383":98686},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_2856":58629,"_25058":58602,"_17494":98688,"_5":17389,"_23725":98619,"_2383":98689},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_2856":58630,"_25058":58602,"_17494":98691,"_5":17389,"_23725":98623,"_2383":98692},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_2856":58631,"_25058":58602,"_17494":98694,"_5":17389,"_23725":98623,"_2383":98695},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_2856":58632,"_25058":58602,"_17494":98697,"_5":17389,"_23725":98626,"_2383":98698},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_2856":58633,"_25058":58602,"_17494":98700,"_5":17389,"_23725":98626,"_2383":98701},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_2856":58634,"_25058":58602,"_17494":98703,"_5":17389,"_23725":98629,"_2383":98704},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_2856":58635,"_25058":58602,"_17494":98706,"_5":17389,"_23725":98629,"_2383":98707},[],"La CA de enrolamiento o una CA adicional valida la credencial en el modo mTLS. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_2856":58636,"_25058":58602,"_17494":98709,"_5":17389,"_23725":98632,"_2383":98710},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_2856":58637,"_25058":58602,"_17494":98712,"_5":17389,"_23725":98632,"_2383":98713},[],"El código admite RSA y ECDSA de 224, 256, 384 o 521 bits. Un tamaño ECDSA no reconocido puede producir fallback a 256; elige explícitamente un tamaño compatible y comprueba la clave resultante. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_2856":58638,"_25058":58602,"_17494":98715,"_5":17389,"_23725":98635,"_2383":98716},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_2856":58639,"_25058":58602,"_17494":98718,"_5":17389,"_23725":98635,"_2383":98719},[],"Parte",{"_2856":58640,"_25058":58602,"_17494":98721,"_5":17389,"_23725":98635,"_2383":98722},[],"Contenido tras decodificar su Base64",{"_2856":58641,"_25058":58602,"_17494":98724,"_5":17389,"_23725":98635,"_2383":43871},[],{"_2856":58642,"_25058":58602,"_17494":98726,"_5":17389,"_23725":98635,"_2383":98727},[],"Clave privada PKCS#8 DER sin cifrar.",{"_2856":58643,"_25058":58602,"_17494":98729,"_5":17389,"_23725":98635,"_2383":43877},[],{"_2856":58644,"_25058":58602,"_17494":98731,"_5":17389,"_23725":98635,"_2383":98732},[],"PKCS#7 DER con el certificado emitido.",{"_2856":58645,"_25058":58602,"_17494":98734,"_5":17389,"_23725":98635,"_2383":98735},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_2856":58646,"_25058":58602,"_17494":98737,"_5":17389,"_23725":98639,"_2383":98738},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_2856":58647,"_25058":58602,"_17494":98740,"_5":17389,"_23725":98639,"_2383":98741},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_2856":58648,"_25058":58602,"_17494":98743,"_5":17389,"_23725":98639,"_2383":98744},[],"Convierte y comprueba el resultado:",{"_2856":58649,"_25058":58602,"_17494":98746,"_5":17389,"_23725":98639,"_2383":98747},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_2856":58650,"_25058":58602,"_17494":98749,"_5":17389,"_23725":98643,"_2383":98750},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_2856":58651,"_25058":58602,"_17494":98752,"_5":17389,"_23725":98643,"_2383":98753},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_2856":58652,"_25058":58652,"_5":12268,"_2383":98120,"_25394":98755,"_17494":98756,"_23725":58652},[40730,96973,43048,97945,98120],[],{"_2856":58653,"_25058":58652,"_17494":98758,"_5":17389,"_23725":58652,"_2383":98759},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_2856":58654,"_25058":58652,"_5":25391,"_17494":98761,"_23725":98762,"_2383":98763},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_2856":58655,"_25058":58652,"_5":25391,"_17494":98765,"_23725":98766,"_2383":98767},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_2856":58656,"_25058":58652,"_5":25391,"_17494":98769,"_23725":98770,"_2383":98771},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_2856":58657,"_25058":58652,"_5":25391,"_17494":98773,"_23725":98774,"_2383":98775},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_2856":58658,"_25058":58652,"_17494":98777,"_5":17389,"_23725":58652,"_2383":98778},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_2856":58659,"_25058":58652,"_17494":98780,"_5":17389,"_23725":98762,"_2383":98781},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_2856":58660,"_25058":58652,"_17494":98783,"_5":17389,"_23725":98762,"_2383":98784},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_2856":58661,"_25058":58652,"_17494":98786,"_5":17389,"_23725":98762,"_2383":98787},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_2856":58662,"_25058":58652,"_17494":98789,"_5":17389,"_23725":98762,"_2383":98790},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_2856":58663,"_25058":58652,"_17494":98792,"_5":17389,"_23725":98762,"_2383":98793},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_2856":58664,"_25058":58652,"_17494":98795,"_5":17389,"_23725":98762,"_2383":98796},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_2856":58665,"_25058":58652,"_17494":98798,"_5":17389,"_23725":98766,"_2383":98799},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2856":58666,"_25058":58652,"_17494":98801,"_5":17389,"_23725":98766,"_2383":98802},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2856":58667,"_25058":58652,"_17494":98804,"_5":17389,"_23725":98766,"_2383":98805},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2856":58668,"_25058":58652,"_17494":98807,"_5":17389,"_23725":98766,"_2383":98808},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2856":58669,"_25058":58652,"_17494":98810,"_5":17389,"_23725":98770,"_2383":98811},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2856":58670,"_25058":58652,"_17494":98813,"_5":17389,"_23725":98770,"_2383":98814},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2856":58671,"_25058":58652,"_17494":98816,"_5":17389,"_23725":98770,"_2383":98817},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2856":58672,"_25058":58652,"_17494":98819,"_5":17389,"_23725":98770,"_2383":98820},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2856":58673,"_25058":58652,"_17494":98822,"_5":17389,"_23725":98774,"_2383":98823},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato y migraciones, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_2856":58674,"_25058":58652,"_17494":98825,"_5":17389,"_23725":98774,"_2383":98826},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_2856":58675,"_25058":58675,"_5":12268,"_2383":98828,"_25394":98829,"_17494":98830,"_23725":58675},"Estrategias de aprovisionamiento",[40730,96973,43048,97945,98120],[],{"_2856":58676,"_25058":58675,"_17494":98832,"_5":17389,"_23725":58675,"_2383":98833},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_2856":58677,"_25058":58675,"_5":25391,"_17494":98835,"_23725":98836,"_2383":98837},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_2856":58678,"_25058":58675,"_5":25391,"_17494":98839,"_23725":98840,"_2383":98841},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_2856":58679,"_25058":58675,"_5":25391,"_17494":98843,"_23725":98844,"_2383":98845},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_2856":58680,"_25058":58675,"_5":25391,"_17494":98847,"_23725":98848,"_2383":98849},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_2856":58681,"_25058":58675,"_5":25391,"_17494":98851,"_23725":98852,"_2383":98853},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_2856":58682,"_25058":58675,"_17494":98855,"_5":17389,"_23725":58675,"_2383":98856},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_2856":58683,"_25058":58675,"_17494":98858,"_5":17389,"_23725":98836,"_2383":98859},[],"Recorrido",{"_2856":58684,"_25058":58675,"_17494":98861,"_5":17389,"_23725":98836,"_2383":98862},[],"Cuándo existe el dispositivo",{"_2856":58685,"_25058":58675,"_17494":98864,"_5":17389,"_23725":98836,"_2383":98865},[],"Qué compruebas",{"_2856":58686,"_25058":58675,"_17494":98867,"_5":17389,"_23725":98836,"_2383":98868},[],"Asignación manual",{"_2856":58687,"_25058":58675,"_17494":98870,"_5":17389,"_23725":98836,"_2383":98871},[],"El operador lo crea antes de asociar un certificado.",{"_2856":58688,"_25058":58675,"_17494":98873,"_5":17389,"_23725":98836,"_2383":98874},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_2856":58689,"_25058":58675,"_17494":98876,"_5":17389,"_23725":98836,"_2383":98877},[],"EST con `JITP`",{"_2856":58690,"_25058":58675,"_17494":98879,"_5":17389,"_23725":98836,"_2383":98880},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_2856":58691,"_25058":58675,"_17494":98882,"_5":17389,"_23725":98836,"_2383":98883},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_2856":58692,"_25058":58675,"_17494":98885,"_5":17389,"_23725":98836,"_2383":98886},[],"EST con `PRE_REGISTRATION`",{"_2856":58693,"_25058":58675,"_17494":98888,"_5":17389,"_23725":98836,"_2383":98889},[],"Debe existir antes de `/simpleenroll`.",{"_2856":58694,"_25058":58675,"_17494":98891,"_5":17389,"_23725":98836,"_2383":98892},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_2856":58695,"_25058":58675,"_17494":98894,"_5":17389,"_23725":98836,"_2383":98895},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_2856":58696,"_25058":58675,"_17494":98897,"_5":17389,"_23725":98836,"_2383":98898},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_2856":58697,"_25058":58675,"_17494":98900,"_5":17389,"_23725":98840,"_2383":98901},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_2856":58698,"_25058":58675,"_17494":98903,"_5":17389,"_23725":98840,"_2383":98904},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_2856":58699,"_25058":58675,"_17494":98906,"_5":17389,"_23725":98840,"_2383":98907},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_2856":58700,"_25058":58675,"_17494":98909,"_5":17389,"_23725":98844,"_2383":98910},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_2856":58701,"_25058":58675,"_17494":98912,"_5":17389,"_23725":98844,"_2383":98913},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_2856":58702,"_25058":58675,"_17494":98915,"_5":17389,"_23725":98844,"_2383":98916},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_2856":58703,"_25058":58675,"_17494":98918,"_5":17389,"_23725":98844,"_2383":98919},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_2856":58704,"_25058":58675,"_17494":98921,"_5":17389,"_23725":98844,"_2383":98922},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_2856":58705,"_25058":58675,"_17494":98924,"_5":17389,"_23725":98844,"_2383":98925},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_2856":58706,"_25058":58675,"_17494":98927,"_5":17389,"_23725":98848,"_2383":96031},[],{"_2856":58707,"_25058":58675,"_17494":98929,"_5":17389,"_23725":98848,"_2383":98930},[],"Material que atraviesa EST",{"_2856":58708,"_25058":58675,"_17494":98932,"_5":17389,"_23725":98848,"_2383":98933},[],"Clave generada por el dispositivo",{"_2856":58709,"_25058":58675,"_17494":98935,"_5":17389,"_23725":98848,"_2383":98936},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_2856":58710,"_25058":58675,"_17494":98938,"_5":17389,"_23725":98848,"_2383":98939},[],"Clave ya disponible en el dispositivo",{"_2856":58711,"_25058":58675,"_17494":98941,"_5":17389,"_23725":98848,"_2383":98942},[],"CSR firmada con la clave existente y certificado nuevo.",{"_2856":58712,"_25058":58675,"_17494":98944,"_5":17389,"_23725":98848,"_2383":43367},[],{"_2856":58713,"_25058":58675,"_17494":98946,"_5":17389,"_23725":98848,"_2383":98947},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_2856":58714,"_25058":58675,"_17494":98949,"_5":17389,"_23725":98848,"_2383":98950},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_2856":58715,"_25058":58675,"_17494":98952,"_5":17389,"_23725":98852,"_2383":98953},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_2856":58716,"_25058":58716,"_5":12268,"_2383":98955,"_25394":98956,"_17494":98957,"_23725":58716},"Renovación y recuperación",[40730,96973,43048,97945,98120],[],{"_2856":58717,"_25058":58716,"_17494":98959,"_5":17389,"_23725":58716,"_2383":98960},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_2856":58718,"_25058":58716,"_5":25391,"_17494":98962,"_23725":98963,"_2383":98964},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_2856":58719,"_25058":58716,"_5":25391,"_17494":98966,"_23725":98967,"_2383":98968},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_2856":58720,"_25058":58716,"_5":25391,"_17494":98970,"_23725":98971,"_2383":98972},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_2856":58721,"_25058":58716,"_5":25391,"_17494":98974,"_23725":98975,"_2383":98976},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_2856":58722,"_25058":58716,"_5":25391,"_17494":98978,"_23725":98979,"_2383":98980},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_2856":58723,"_25058":58716,"_17494":98982,"_5":17389,"_23725":58716,"_2383":98983},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_2856":58724,"_25058":58716,"_17494":98985,"_5":17389,"_23725":98963,"_2383":98986},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_2856":58725,"_25058":58716,"_17494":98988,"_5":17389,"_23725":98963,"_2383":98989},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_2856":58726,"_25058":58716,"_17494":98991,"_5":17389,"_23725":98963,"_2383":98992},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_2856":58727,"_25058":58716,"_17494":98994,"_5":17389,"_23725":98963,"_2383":98995},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_2856":58728,"_25058":58716,"_17494":98997,"_5":17389,"_23725":98967,"_2383":98998},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_2856":58729,"_25058":58716,"_17494":99000,"_5":17389,"_23725":98967,"_2383":99001},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_2856":58730,"_25058":58716,"_17494":99003,"_5":17389,"_23725":98971,"_2383":99004},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_2856":58731,"_25058":58716,"_17494":99006,"_5":17389,"_23725":98971,"_2383":99007},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_2856":58732,"_25058":58716,"_17494":99009,"_5":17389,"_23725":98971,"_2383":99010},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_2856":58733,"_25058":58716,"_17494":99012,"_5":17389,"_23725":98975,"_2383":99013},[],"Situación",{"_2856":58734,"_25058":58716,"_17494":99015,"_5":17389,"_23725":98975,"_2383":99016},[],"Procedimiento",{"_2856":58735,"_25058":58716,"_17494":99018,"_5":17389,"_23725":98975,"_2383":99019},[],"Certificado vigente, fuera de ventana",{"_2856":58736,"_25058":58716,"_17494":99021,"_5":17389,"_23725":98975,"_2383":99022},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_2856":58737,"_25058":58716,"_17494":99024,"_5":17389,"_23725":98975,"_2383":99025},[],"Certificado vencido, clave disponible",{"_2856":58738,"_25058":58716,"_17494":99027,"_5":17389,"_23725":98975,"_2383":99028},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_2856":58739,"_25058":58716,"_17494":99030,"_5":17389,"_23725":98975,"_2383":99031},[],"Renovación por webhook o `NO_AUTH`",{"_2856":58740,"_25058":58716,"_17494":99033,"_5":17389,"_23725":98975,"_2383":99034},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_2856":58741,"_25058":58716,"_17494":99036,"_5":17389,"_23725":98975,"_2383":99037},[],"Clave perdida o inaccesible",{"_2856":58742,"_25058":58716,"_17494":99039,"_5":17389,"_23725":98975,"_2383":99040},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_2856":58743,"_25058":58716,"_17494":99042,"_5":17389,"_23725":98975,"_2383":99043},[],"Identidad actual revocada",{"_2856":58744,"_25058":58716,"_17494":99045,"_5":17389,"_23725":98975,"_2383":99046},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_2856":58745,"_25058":58716,"_17494":99048,"_5":17389,"_23725":98975,"_2383":99049},[],"Dispositivo sin identidad",{"_2856":58746,"_25058":58716,"_17494":99051,"_5":17389,"_23725":98975,"_2383":99052},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_2856":58747,"_25058":58716,"_17494":99054,"_5":17389,"_23725":98975,"_2383":99055},[],"Dispositivo retirado",{"_2856":58748,"_25058":58716,"_17494":99057,"_5":17389,"_23725":98975,"_2383":99058},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_2856":58749,"_25058":58716,"_17494":99060,"_5":17389,"_23725":98975,"_2383":99061},[],"Timeout, HTTP 500 o fallo de instalación",{"_2856":58750,"_25058":58716,"_17494":99063,"_5":17389,"_23725":98975,"_2383":99064},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_2856":58751,"_25058":58716,"_17494":99066,"_5":17389,"_23725":98979,"_2383":99067},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_2856":58752,"_25058":58716,"_17494":99069,"_5":17389,"_23725":98979,"_2383":99070},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_2856":58753,"_25058":58753,"_5":12268,"_2383":99072,"_25394":99073,"_17494":99074,"_23725":58753},"Diagnóstico de enrolamiento",[40730,96973,43048,97945,98120],[],{"_2856":58754,"_25058":58753,"_17494":99076,"_5":17389,"_23725":58753,"_2383":99077},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_2856":58755,"_25058":58753,"_5":25391,"_17494":99079,"_23725":99080,"_2383":99081},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_2856":58756,"_25058":58753,"_5":25391,"_17494":99083,"_23725":99084,"_2383":99085},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_2856":58757,"_25058":58753,"_5":25391,"_17494":99087,"_23725":99088,"_2383":98644},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_2856":58758,"_25058":58753,"_5":25391,"_17494":99090,"_23725":99091,"_2383":99092},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_2856":58759,"_25058":58753,"_17494":99094,"_5":17389,"_23725":58753,"_2383":99095},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_2856":58760,"_25058":58753,"_17494":99097,"_5":17389,"_23725":99084,"_2383":99098},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_2856":58761,"_25058":58753,"_17494":99100,"_5":17389,"_23725":99084,"_2383":99101},[],"Síntoma o mensaje",{"_2856":58762,"_25058":58753,"_17494":99103,"_5":17389,"_23725":99084,"_2383":99104},[],"Qué revisar",{"_2856":58763,"_25058":58753,"_17494":99106,"_5":17389,"_23725":99084,"_2383":99107},[],"curl rechaza TLS, nombre o emisor",{"_2856":58764,"_25058":58753,"_17494":99109,"_5":17389,"_23725":99084,"_2383":99110},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_2856":58765,"_25058":58753,"_17494":99112,"_5":17389,"_23725":99084,"_2383":99113},[],"404 o APS ausente",{"_2856":58766,"_25058":58753,"_17494":99115,"_5":17389,"_23725":99084,"_2383":99116},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_2856":58767,"_25058":58753,"_17494":99118,"_5":17389,"_23725":99084,"_2383":99119},[],"400, error de CSR o formato",{"_2856":58768,"_25058":58753,"_17494":99121,"_5":17389,"_23725":99084,"_2383":99122},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_2856":58769,"_25058":58753,"_17494":99124,"_5":17389,"_23725":99084,"_2383":99125},[],"Credencial ausente o certificado no válido",{"_2856":58770,"_25058":58753,"_17494":99127,"_5":17389,"_23725":99084,"_2383":99128},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_2856":58771,"_25058":58753,"_17494":99130,"_5":17389,"_23725":99084,"_2383":99131},[],"Webhook deniega, expira o responde sin autorización",{"_2856":58772,"_25058":58753,"_17494":99133,"_5":17389,"_23725":99084,"_2383":99134},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_2856":58773,"_25058":58753,"_17494":99136,"_5":17389,"_23725":99084,"_2383":44284},[],{"_2856":58774,"_25058":58753,"_17494":99138,"_5":17389,"_23725":99084,"_2383":99139},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_2856":58775,"_25058":58753,"_17494":99141,"_5":17389,"_23725":99084,"_2383":44290},[],{"_2856":58776,"_25058":58753,"_17494":99143,"_5":17389,"_23725":99084,"_2383":99144},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_2856":58777,"_25058":58753,"_17494":99146,"_5":17389,"_23725":99084,"_2383":44296},[],{"_2856":58778,"_25058":58753,"_17494":99148,"_5":17389,"_23725":99084,"_2383":99149},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el PEM como `cert_content` y `key_content`; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la nota de migración en DMS.",{"_2856":58779,"_25058":58753,"_17494":99151,"_5":17389,"_23725":99084,"_2383":99152},[],"400 `struct validation error` al crear o actualizar un DMS",{"_2856":58780,"_25058":58753,"_17494":99154,"_5":17389,"_23725":99084,"_2383":99155},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_2856":58781,"_25058":58753,"_17494":99157,"_5":17389,"_23725":99084,"_2383":99158},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_2856":58782,"_25058":58753,"_17494":99160,"_5":17389,"_23725":99084,"_2383":99161},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_2856":58783,"_25058":58753,"_17494":99163,"_5":17389,"_23725":99084,"_2383":44314},[],{"_2856":58784,"_25058":58753,"_17494":99165,"_5":17389,"_23725":99084,"_2383":99166},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_2856":58785,"_25058":58753,"_17494":99168,"_5":17389,"_23725":99084,"_2383":44320},[],{"_2856":58786,"_25058":58753,"_17494":99170,"_5":17389,"_23725":99084,"_2383":99171},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_2856":58787,"_25058":58753,"_17494":99173,"_5":17389,"_23725":99084,"_2383":99174},[],"DMS propietario distinto",{"_2856":58788,"_25058":58753,"_17494":99176,"_5":17389,"_23725":99084,"_2383":99177},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_2856":58789,"_25058":58753,"_17494":99179,"_5":17389,"_23725":99084,"_2383":44332},[],{"_2856":58790,"_25058":58753,"_17494":99181,"_5":17389,"_23725":99084,"_2383":99182},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_2856":58791,"_25058":58753,"_17494":99184,"_5":17389,"_23725":99084,"_2383":44338},[],{"_2856":58792,"_25058":58753,"_17494":99186,"_5":17389,"_23725":99084,"_2383":99187},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_2856":58793,"_25058":58753,"_17494":99189,"_5":17389,"_23725":99084,"_2383":99190},[],"Certificado actual revocado",{"_2856":58794,"_25058":58753,"_17494":99192,"_5":17389,"_23725":99084,"_2383":99193},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_2856":58795,"_25058":58753,"_17494":99195,"_5":17389,"_23725":99084,"_2383":99196},[],"Error de CA, perfil o firma",{"_2856":58796,"_25058":58753,"_17494":99198,"_5":17389,"_23725":99084,"_2383":99199},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_2856":58797,"_25058":58753,"_17494":99201,"_5":17389,"_23725":99084,"_2383":99202},[],"HTTP 200 sin conexión del dispositivo",{"_2856":58798,"_25058":58753,"_17494":99204,"_5":17389,"_23725":99084,"_2383":99205},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_2856":58799,"_25058":58753,"_17494":99207,"_5":17389,"_23725":99084,"_2383":99208},[],"Timeout o error después de emitir",{"_2856":58800,"_25058":58753,"_17494":99210,"_5":17389,"_23725":99084,"_2383":99211},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_2856":58801,"_25058":58753,"_17494":99213,"_5":17389,"_23725":99088,"_2383":99214},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado tras una migración y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_2856":58802,"_25058":58753,"_17494":99216,"_5":17389,"_23725":99088,"_2383":99217},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_2856":58803,"_25058":58753,"_17494":99219,"_5":17389,"_23725":99091,"_2383":99220},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_2856":58804,"_25058":58753,"_17494":99222,"_5":17389,"_23725":99091,"_2383":99223},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_2856":58805,"_25058":58753,"_17494":99225,"_5":17389,"_23725":99091,"_2383":99226},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_2856":58806,"_25058":58753,"_17494":99228,"_5":17389,"_23725":99091,"_2383":99229},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_2856":58807,"_25058":58753,"_17494":99231,"_5":17389,"_23725":99091,"_2383":99232},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_2856":58808,"_25058":58753,"_17494":99234,"_5":17389,"_23725":99091,"_2383":99235},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_2856":58809,"_25058":58753,"_17494":99237,"_5":17389,"_23725":99091,"_2383":99238},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_2856":58810,"_25058":58810,"_5":12268,"_2383":99240,"_25394":99241,"_17494":99242,"_23725":58810},"Distribución y actualización de confianza",[40730,96973,43048,97945,98120],[],{"_2856":58811,"_25058":58810,"_17494":99244,"_5":17389,"_23725":58810,"_2383":99245},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_2856":58812,"_25058":58810,"_5":25391,"_17494":99247,"_23725":99248,"_2383":99249},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_2856":58813,"_25058":58810,"_5":25391,"_17494":99251,"_23725":99252,"_2383":99253},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_2856":58814,"_25058":58810,"_5":25391,"_17494":99255,"_23725":99256,"_2383":99257},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_2856":58815,"_25058":58810,"_5":25391,"_17494":99259,"_23725":99260,"_2383":99261},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_2856":58816,"_25058":58810,"_5":25391,"_17494":99263,"_23725":99264,"_2383":99265},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_2856":58817,"_25058":58810,"_17494":99267,"_5":17389,"_23725":58810,"_2383":99268},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_2856":58818,"_25058":58810,"_17494":99270,"_5":17389,"_23725":99248,"_2383":99271},[],"Relación",{"_2856":58819,"_25058":58810,"_17494":99273,"_5":17389,"_23725":99248,"_2383":99274},[],"Material que prepara el responsable",{"_2856":58820,"_25058":58810,"_17494":99276,"_5":17389,"_23725":99248,"_2383":99277},[],"Dispositivo → servidor EST",{"_2856":58821,"_25058":58810,"_17494":99279,"_5":17389,"_23725":99248,"_2383":99280},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_2856":58822,"_25058":58810,"_17494":99282,"_5":17389,"_23725":99248,"_2383":99283},[],"DMS → solicitante",{"_2856":58823,"_25058":58810,"_17494":99285,"_5":17389,"_23725":99248,"_2383":99286},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_2856":58824,"_25058":58810,"_17494":99288,"_5":17389,"_23725":99248,"_2383":99289},[],"Consumidor → dispositivo",{"_2856":58825,"_25058":58810,"_17494":99291,"_5":17389,"_23725":99248,"_2383":99292},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_2856":58826,"_25058":58810,"_17494":99294,"_5":17389,"_23725":99248,"_2383":99295},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_2856":58827,"_25058":58810,"_17494":99297,"_5":17389,"_23725":99252,"_2383":99298},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_2856":58828,"_25058":58810,"_17494":99300,"_5":17389,"_23725":99252,"_2383":99301},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_2856":58829,"_25058":58810,"_17494":99303,"_5":17389,"_23725":99256,"_2383":99304},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_2856":58830,"_25058":58810,"_17494":99306,"_5":17389,"_23725":99256,"_2383":99307},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_2856":58831,"_25058":58810,"_17494":99309,"_5":17389,"_23725":99256,"_2383":99310},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_2856":58832,"_25058":58810,"_17494":99312,"_5":17389,"_23725":99256,"_2383":99313},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_2856":58833,"_25058":58810,"_17494":99315,"_5":17389,"_23725":99256,"_2383":99316},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_2856":58834,"_25058":58810,"_17494":99318,"_5":17389,"_23725":99256,"_2383":99319},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_2856":58835,"_25058":58810,"_17494":99321,"_5":17389,"_23725":99260,"_2383":99322},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_2856":58836,"_25058":58810,"_17494":99324,"_5":17389,"_23725":99260,"_2383":99325},[],"En el DMS, separa las CAs distribuidas de `additional_validation_cas`, utilizadas para la credencial de reenrolamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_2856":58837,"_25058":58810,"_17494":99327,"_5":17389,"_23725":99260,"_2383":99328},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_2856":58838,"_25058":58810,"_17494":99330,"_5":17389,"_23725":99264,"_2383":99331},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_2856":58839,"_25058":58839,"_5":12268,"_2383":44487,"_25394":99333,"_17494":99335,"_23725":58839},[40730,96973,43048,97945,99334],"Integraciones",[],{"_2856":58840,"_25058":58839,"_17494":99337,"_5":17389,"_23725":58839,"_2383":99338},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_2856":58841,"_25058":58839,"_5":25391,"_17494":99340,"_23725":99341,"_2383":99342},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_2856":58842,"_25058":58839,"_5":25391,"_17494":99344,"_23725":99345,"_2383":99346},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_2856":58843,"_25058":58839,"_5":25391,"_17494":99348,"_23725":99349,"_2383":99350},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_2856":58844,"_25058":58839,"_5":25391,"_17494":99352,"_23725":99353,"_2383":99354},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_2856":58845,"_25058":58839,"_5":25391,"_17494":99356,"_23725":99357,"_2383":99358},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_2856":58846,"_25058":58839,"_5":25391,"_17494":99360,"_23725":99361,"_2383":99362},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_2856":58847,"_25058":58839,"_5":25391,"_17494":99364,"_23725":99365,"_2383":44521},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_2856":58848,"_25058":58839,"_5":25391,"_17494":99367,"_23725":99368,"_2383":44525},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_2856":58849,"_25058":58839,"_5":25391,"_17494":99370,"_23725":99371,"_2383":99372},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_2856":58850,"_25058":58839,"_5":25391,"_17494":99374,"_23725":99375,"_2383":99376},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_2856":58851,"_25058":58839,"_5":25391,"_17494":99378,"_23725":99379,"_2383":99380},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_2856":58852,"_25058":58839,"_5":25391,"_17494":99382,"_23725":99383,"_2383":99384},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_2856":58853,"_25058":58839,"_5":25391,"_17494":99386,"_23725":99387,"_2383":99388},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_2856":58854,"_25058":58839,"_5":25391,"_17494":99390,"_23725":99391,"_2383":99392},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_2856":58855,"_25058":58839,"_5":25391,"_17494":99394,"_23725":99395,"_2383":99396},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_2856":58856,"_25058":58839,"_5":25391,"_17494":99398,"_23725":99399,"_2383":99400},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_2856":58857,"_25058":58839,"_5":25391,"_17494":99402,"_23725":99403,"_2383":99404},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_2856":58858,"_25058":58839,"_5":25391,"_17494":99406,"_23725":99407,"_2383":99408},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_2856":58859,"_25058":58839,"_5":25391,"_17494":99410,"_23725":99411,"_2383":99412},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_2856":58860,"_25058":58839,"_5":25391,"_17494":99414,"_23725":99415,"_2383":99416},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_2856":58861,"_25058":58839,"_17494":99418,"_5":17389,"_23725":58839,"_2383":99419},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_2856":58862,"_25058":58839,"_17494":99421,"_5":17389,"_23725":58839,"_2383":99422},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_2856":58863,"_25058":58839,"_17494":99424,"_5":17389,"_23725":58839,"_2383":99425},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_2856":58864,"_25058":58839,"_17494":99427,"_5":17389,"_23725":99341,"_2383":99428},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_2856":58865,"_25058":58839,"_17494":99430,"_5":17389,"_23725":99341,"_2383":99431},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_2856":58866,"_25058":58839,"_17494":99433,"_5":17389,"_23725":99341,"_2383":99434},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_2856":58867,"_25058":58839,"_17494":99436,"_5":17389,"_23725":99341,"_2383":99437},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_2856":58868,"_25058":58839,"_17494":99439,"_5":17389,"_23725":99345,"_2383":99440},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_2856":58869,"_25058":58839,"_17494":99442,"_5":17389,"_23725":99349,"_2383":99443},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_2856":58870,"_25058":58839,"_17494":99445,"_5":17389,"_23725":99349,"_2383":99446},[],"Acción IAM",{"_2856":58871,"_25058":58839,"_17494":99448,"_5":17389,"_23725":99349,"_2383":96037},[],{"_2856":58872,"_25058":58839,"_17494":99450,"_5":17389,"_23725":99349,"_2383":44608},[],{"_2856":58873,"_25058":58839,"_17494":99452,"_5":17389,"_23725":99349,"_2383":99453},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_2856":58874,"_25058":58839,"_17494":99455,"_5":17389,"_23725":99349,"_2383":44614},[],{"_2856":58875,"_25058":58839,"_17494":99457,"_5":17389,"_23725":99349,"_2383":99458},[],"Registrar la CA en AWS IoT",{"_2856":58876,"_25058":58839,"_17494":99460,"_5":17389,"_23725":99349,"_2383":44620},[],{"_2856":58877,"_25058":58839,"_17494":99462,"_5":17389,"_23725":99349,"_2383":99463},[],"Consultar el estado del registro de la CA",{"_2856":58878,"_25058":58839,"_17494":99465,"_5":17389,"_23725":99349,"_2383":44626},[],{"_2856":58879,"_25058":58839,"_17494":99467,"_5":17389,"_23725":99349,"_2383":99468},[],"Crear o actualizar Things en IoT Core",{"_2856":58880,"_25058":58839,"_17494":99470,"_5":17389,"_23725":99349,"_2383":44632},[],{"_2856":58881,"_25058":58839,"_17494":99472,"_5":17389,"_23725":99349,"_2383":99473},[],"Aprovisionar Things mediante plantilla",{"_2856":58882,"_25058":58839,"_17494":99475,"_5":17389,"_23725":99349,"_2383":44638},[],{"_2856":58883,"_25058":58839,"_17494":99477,"_5":17389,"_23725":99349,"_2383":99478},[],"Registrar certificados de dispositivo",{"_2856":58884,"_25058":58839,"_17494":99480,"_5":17389,"_23725":99349,"_2383":44644},[],{"_2856":58885,"_25058":58839,"_17494":99482,"_5":17389,"_23725":99349,"_2383":99483},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_2856":58886,"_25058":58839,"_17494":99485,"_5":17389,"_23725":99349,"_2383":44650},[],{"_2856":58887,"_25058":58839,"_17494":99487,"_5":17389,"_23725":99349,"_2383":99488},[],"Crear y adjuntar políticas IoT",{"_2856":58888,"_25058":58839,"_17494":99490,"_5":17389,"_23725":99349,"_2383":44656},[],{"_2856":58889,"_25058":58839,"_17494":99492,"_5":17389,"_23725":99349,"_2383":99493},[],"Gestionar grupos de Things",{"_2856":58890,"_25058":58839,"_17494":99495,"_5":17389,"_23725":99349,"_2383":44662},[],{"_2856":58891,"_25058":58839,"_17494":99497,"_5":17389,"_23725":99349,"_2383":99498},[],"Crear plantillas JITP",{"_2856":58892,"_25058":58839,"_17494":99500,"_5":17389,"_23725":99349,"_2383":44668},[],{"_2856":58893,"_25058":58839,"_17494":99502,"_5":17389,"_23725":99349,"_2383":99503},[],"Leer y escribir el Device Shadow",{"_2856":58894,"_25058":58839,"_17494":99505,"_5":17389,"_23725":99349,"_2383":99506},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_2856":58895,"_25058":58839,"_17494":99508,"_5":17389,"_23725":99353,"_2383":99509},[],"Parámetro",{"_2856":58896,"_25058":58839,"_17494":99511,"_5":17389,"_23725":99353,"_2383":99512},[],"Tipo",{"_2856":58897,"_25058":58839,"_17494":99514,"_5":17389,"_23725":99353,"_2383":99515},[],"Requerido",{"_2856":58898,"_25058":58839,"_17494":99517,"_5":17389,"_23725":99353,"_2383":99518},[],"Descripción",{"_2856":58899,"_25058":58839,"_17494":99520,"_5":17389,"_23725":99353,"_2383":44689},[],{"_2856":58900,"_25058":58839,"_17494":99522,"_5":17389,"_23725":99353,"_2383":20879},[],{"_2856":58901,"_25058":58839,"_17494":99524,"_5":17389,"_23725":99353,"_2383":99525},[],"Sí",{"_2856":58902,"_25058":58839,"_17494":99527,"_5":17389,"_23725":99353,"_2383":99528},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_2856":58903,"_25058":58839,"_17494":99530,"_5":17389,"_23725":99353,"_2383":44700},[],{"_2856":58904,"_25058":58839,"_17494":99532,"_5":17389,"_23725":99353,"_2383":20879},[],{"_2856":58905,"_25058":58839,"_17494":99534,"_5":17389,"_23725":99353,"_2383":99525},[],{"_2856":58906,"_25058":58839,"_17494":99536,"_5":17389,"_23725":99353,"_2383":99537},[],"Región AWS donde opera el conector.",{"_2856":58907,"_25058":58839,"_17494":99539,"_5":17389,"_23725":99353,"_2383":44710},[],{"_2856":58908,"_25058":58839,"_17494":99541,"_5":17389,"_23725":99353,"_2383":20879},[],{"_2856":58909,"_25058":58839,"_17494":99543,"_5":17389,"_23725":99353,"_2383":99525},[],{"_2856":58910,"_25058":58839,"_17494":99545,"_5":17389,"_23725":99353,"_2383":99546},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_2856":58911,"_25058":58839,"_17494":99548,"_5":17389,"_23725":99353,"_2383":44720},[],{"_2856":58912,"_25058":58839,"_17494":99550,"_5":17389,"_23725":99353,"_2383":20879},[],{"_2856":58913,"_25058":58839,"_17494":99552,"_5":17389,"_23725":99353,"_2383":99553},[],"Solo con `auth_method=static`",{"_2856":58914,"_25058":58839,"_17494":99555,"_5":17389,"_23725":99353,"_2383":99556},[],"Clave de acceso AWS.",{"_2856":58915,"_25058":58839,"_17494":99558,"_5":17389,"_23725":99353,"_2383":44731},[],{"_2856":58916,"_25058":58839,"_17494":99560,"_5":17389,"_23725":99353,"_2383":20879},[],{"_2856":58917,"_25058":58839,"_17494":99562,"_5":17389,"_23725":99353,"_2383":99553},[],{"_2856":58918,"_25058":58839,"_17494":99564,"_5":17389,"_23725":99353,"_2383":99565},[],"Clave secreta AWS.",{"_2856":58919,"_25058":58839,"_17494":99567,"_5":17389,"_23725":99353,"_2383":44741},[],{"_2856":58920,"_25058":58839,"_17494":99569,"_5":17389,"_23725":99353,"_2383":20879},[],{"_2856":58921,"_25058":58839,"_17494":99571,"_5":17389,"_23725":99353,"_2383":44746},[],{"_2856":58922,"_25058":58839,"_17494":99573,"_5":17389,"_23725":99353,"_2383":99574},[],"Token de sesión (con `auth_method=static`).",{"_2856":58923,"_25058":58839,"_17494":99576,"_5":17389,"_23725":99353,"_2383":44752},[],{"_2856":58924,"_25058":58839,"_17494":99578,"_5":17389,"_23725":99353,"_2383":20879},[],{"_2856":58925,"_25058":58839,"_17494":99580,"_5":17389,"_23725":99353,"_2383":99581},[],"Solo con `auth_method=role`",{"_2856":58926,"_25058":58839,"_17494":99583,"_5":17389,"_23725":99353,"_2383":99584},[],"ARN del rol a asumir.",{"_2856":58927,"_25058":58839,"_17494":99586,"_5":17389,"_23725":99353,"_2383":44763},[],{"_2856":58928,"_25058":58839,"_17494":99588,"_5":17389,"_23725":99353,"_2383":20879},[],{"_2856":58929,"_25058":58839,"_17494":99590,"_5":17389,"_23725":99353,"_2383":44746},[],{"_2856":58930,"_25058":58839,"_17494":99592,"_5":17389,"_23725":99353,"_2383":99593},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_2856":58931,"_25058":58839,"_17494":99595,"_5":17389,"_23725":99353,"_2383":44773},[],{"_2856":58932,"_25058":58839,"_17494":99597,"_5":17389,"_23725":99353,"_2383":14698},[],{"_2856":58933,"_25058":58839,"_17494":99599,"_5":17389,"_23725":99353,"_2383":99525},[],{"_2856":58934,"_25058":58839,"_17494":99601,"_5":17389,"_23725":99353,"_2383":99602},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_2856":58935,"_25058":58839,"_17494":99604,"_5":17389,"_23725":99353,"_2383":44783},[],{"_2856":58936,"_25058":58839,"_17494":99606,"_5":17389,"_23725":99353,"_2383":20879},[],{"_2856":58937,"_25058":58839,"_17494":99608,"_5":17389,"_23725":99353,"_2383":99525},[],{"_2856":58938,"_25058":58839,"_17494":99610,"_5":17389,"_23725":99353,"_2383":99611},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_2856":58939,"_25058":58839,"_17494":99613,"_5":17389,"_23725":99353,"_2383":44793},[],{"_2856":58940,"_25058":58839,"_17494":99615,"_5":17389,"_23725":99353,"_2383":20879},[],{"_2856":58941,"_25058":58839,"_17494":99617,"_5":17389,"_23725":99353,"_2383":99525},[],{"_2856":58942,"_25058":58839,"_17494":99619,"_5":17389,"_23725":99353,"_2383":99620},[],"URL HTTP del Device Manager de Lamassu.",{"_2856":58943,"_25058":58839,"_17494":99622,"_5":17389,"_23725":99353,"_2383":44803},[],{"_2856":58944,"_25058":58839,"_17494":99624,"_5":17389,"_23725":99353,"_2383":20879},[],{"_2856":58945,"_25058":58839,"_17494":99626,"_5":17389,"_23725":99353,"_2383":99525},[],{"_2856":58946,"_25058":58839,"_17494":99628,"_5":17389,"_23725":99353,"_2383":99629},[],"URL HTTP del servicio de CA de Lamassu.",{"_2856":58947,"_25058":58839,"_17494":99631,"_5":17389,"_23725":99357,"_2383":99632},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_2856":58948,"_25058":58839,"_17494":99634,"_5":17389,"_23725":99361,"_2383":99635},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_2856":58949,"_25058":58839,"_17494":99637,"_5":17389,"_23725":99361,"_2383":99638},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_2856":58950,"_25058":58839,"_17494":99640,"_5":17389,"_23725":99365,"_2383":99641},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_2856":58951,"_25058":58839,"_17494":99643,"_5":17389,"_23725":99365,"_2383":99644},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_2856":58952,"_25058":58839,"_17494":99646,"_5":17389,"_23725":99365,"_2383":99647},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_2856":58953,"_25058":58839,"_17494":99649,"_5":17389,"_23725":99365,"_2383":99650},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_2856":58954,"_25058":58839,"_17494":99652,"_5":17389,"_23725":99365,"_2383":99653},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_2856":58955,"_25058":58839,"_17494":99655,"_5":17389,"_23725":99365,"_2383":99656},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_2856":58956,"_25058":58839,"_17494":99658,"_5":17389,"_23725":99368,"_2383":99659},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_2856":58957,"_25058":58839,"_17494":99661,"_5":17389,"_23725":99371,"_2383":99662},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_2856":58958,"_25058":58839,"_17494":99664,"_5":17389,"_23725":99371,"_2383":99665},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_2856":58959,"_25058":58839,"_17494":99667,"_5":17389,"_23725":99375,"_2383":99668},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_2856":58960,"_25058":58839,"_17494":99670,"_5":17389,"_23725":99379,"_2383":99671},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_2856":58961,"_25058":58839,"_17494":99673,"_5":17389,"_23725":99379,"_2383":99674},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_2856":58962,"_25058":58839,"_17494":99676,"_5":17389,"_23725":99379,"_2383":99677},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_2856":58963,"_25058":58839,"_17494":99679,"_5":17389,"_23725":99379,"_2383":99680},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_2856":58964,"_25058":58839,"_17494":99682,"_5":17389,"_23725":99379,"_2383":99683},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_2856":58965,"_25058":58839,"_17494":99685,"_5":17389,"_23725":99379,"_2383":99686},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_2856":58966,"_25058":58839,"_17494":99688,"_5":17389,"_23725":99383,"_2383":99689},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_2856":58967,"_25058":58839,"_17494":99691,"_5":17389,"_23725":99383,"_2383":99692},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_2856":58968,"_25058":58839,"_17494":99694,"_5":17389,"_23725":99383,"_2383":99695},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_2856":58969,"_25058":58839,"_17494":99697,"_5":17389,"_23725":99387,"_2383":99698},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_2856":58970,"_25058":58839,"_17494":99700,"_5":17389,"_23725":99387,"_2383":99701},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_2856":58971,"_25058":58839,"_17494":99703,"_5":17389,"_23725":99387,"_2383":99704},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_2856":58972,"_25058":58839,"_17494":99706,"_5":17389,"_23725":99391,"_2383":99707},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_2856":58973,"_25058":58839,"_17494":99709,"_5":17389,"_23725":99391,"_2383":99710},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_2856":58974,"_25058":58839,"_17494":99712,"_5":17389,"_23725":99391,"_2383":99713},[],"Para que el flujo JITP funcione correctamente:",{"_2856":58975,"_25058":58839,"_17494":99715,"_5":17389,"_23725":99391,"_2383":99716},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_2856":58976,"_25058":58839,"_17494":99718,"_5":17389,"_23725":99391,"_2383":99719},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_2856":58977,"_25058":58839,"_17494":99721,"_5":17389,"_23725":99391,"_2383":99722},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_2856":58978,"_25058":58839,"_17494":99724,"_5":17389,"_23725":99391,"_2383":99725},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_2856":58979,"_25058":58839,"_17494":99727,"_5":17389,"_23725":99395,"_2383":99728},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_2856":58980,"_25058":58839,"_17494":99730,"_5":17389,"_23725":99395,"_2383":99731},[],"Estado en Lamassu",{"_2856":58981,"_25058":58839,"_17494":99733,"_5":17389,"_23725":99395,"_2383":99734},[],"Razón de revocación",{"_2856":58982,"_25058":58839,"_17494":99736,"_5":17389,"_23725":99395,"_2383":99737},[],"Estado en AWS IoT Core",{"_2856":58983,"_25058":58839,"_17494":99739,"_5":17389,"_23725":99395,"_2383":44924},[],{"_2856":58984,"_25058":58839,"_17494":99741,"_5":17389,"_23725":99395,"_2383":99742},[],"Ninguna",{"_2856":58985,"_25058":58839,"_17494":99744,"_5":17389,"_23725":99395,"_2383":44930},[],{"_2856":58986,"_25058":58839,"_17494":99746,"_5":17389,"_23725":99395,"_2383":44933},[],{"_2856":58987,"_25058":58839,"_17494":99748,"_5":17389,"_23725":99395,"_2383":44936},[],{"_2856":58988,"_25058":58839,"_17494":99750,"_5":17389,"_23725":99395,"_2383":44939},[],{"_2856":58989,"_25058":58839,"_17494":99752,"_5":17389,"_23725":99395,"_2383":44933},[],{"_2856":58990,"_25058":58839,"_17494":99754,"_5":17389,"_23725":99395,"_2383":99755},[],"Cualquier otra razón",{"_2856":58991,"_25058":58839,"_17494":99757,"_5":17389,"_23725":99395,"_2383":44947},[],{"_2856":58992,"_25058":58839,"_17494":99759,"_5":17389,"_23725":99395,"_2383":99760},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_2856":58993,"_25058":58839,"_17494":99762,"_5":17389,"_23725":99399,"_2383":99763},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_2856":58994,"_25058":58839,"_17494":99765,"_5":17389,"_23725":99399,"_2383":99766},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_2856":58995,"_25058":58839,"_17494":99768,"_5":17389,"_23725":99399,"_2383":99769},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_2856":58996,"_25058":58839,"_17494":99771,"_5":17389,"_23725":99403,"_2383":99772},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_2856":58997,"_25058":58839,"_17494":99774,"_5":17389,"_23725":99403,"_2383":99775},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_2856":58998,"_25058":58839,"_17494":99777,"_5":17389,"_23725":99407,"_2383":99778},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_2856":58999,"_25058":58839,"_17494":99780,"_5":17389,"_23725":99407,"_2383":99781},[],"Existen dos tipos de acciones:",{"_2856":59000,"_25058":58839,"_17494":99783,"_5":17389,"_23725":99407,"_2383":99784},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_2856":59001,"_25058":58839,"_17494":99786,"_5":17389,"_23725":99407,"_2383":99787},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_2856":59002,"_25058":58839,"_17494":99789,"_5":17389,"_23725":99407,"_2383":99790},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_2856":59003,"_25058":58839,"_17494":99792,"_5":17389,"_23725":99411,"_2383":99793},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_2856":59004,"_25058":58839,"_17494":99795,"_5":17389,"_23725":99411,"_2383":99796},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_2856":59005,"_25058":58839,"_17494":99798,"_5":17389,"_23725":99411,"_2383":99799},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_2856":59006,"_25058":58839,"_17494":99801,"_5":17389,"_23725":99415,"_2383":99802},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_2856":59007,"_25058":58839,"_17494":99804,"_5":17389,"_23725":99415,"_2383":99805},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_2856":59008,"_25058":58839,"_17494":99807,"_5":17389,"_23725":99415,"_2383":99808},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_2856":59009,"_25058":58839,"_17494":99810,"_5":17389,"_23725":99415,"_2383":99811},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_2856":59010,"_25058":58839,"_17494":99813,"_5":17389,"_23725":99415,"_2383":99814},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_2856":59011,"_25058":58839,"_17494":99816,"_5":17389,"_23725":99415,"_2383":99817},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_2856":59012,"_25058":58839,"_17494":99819,"_5":17389,"_23725":99415,"_2383":99820},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_2856":59013,"_25058":58839,"_17494":99822,"_5":17389,"_23725":99415,"_2383":99823},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_2856":59014,"_25058":58839,"_17494":99825,"_5":17389,"_23725":99415,"_2383":99826},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_2856":59015,"_25058":58839,"_17494":99828,"_5":17389,"_23725":99415,"_2383":99829},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_2856":59016,"_25058":58839,"_17494":99831,"_5":17389,"_23725":99415,"_2383":99832},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_2856":59017,"_25058":58839,"_17494":99834,"_5":17389,"_23725":99415,"_2383":99835},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_2856":59018,"_25058":58839,"_17494":99837,"_5":17389,"_23725":99415,"_2383":99838},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_2856":59019,"_25058":58839,"_17494":99840,"_5":17389,"_23725":99415,"_2383":99841},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_2856":59020,"_25058":58839,"_17494":99843,"_5":17389,"_23725":99415,"_2383":99844},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_2856":59021,"_25058":58839,"_17494":99846,"_5":17389,"_23725":99415,"_2383":99847},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_2856":59022,"_25058":58839,"_17494":99849,"_5":17389,"_23725":99415,"_2383":99850},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_2856":59023,"_25058":58839,"_17494":99852,"_5":17389,"_23725":99415,"_2383":99853},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_2856":59024,"_25058":58839,"_17494":99855,"_5":17389,"_23725":99415,"_2383":99856},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2856":59025,"_25058":58839,"_17494":99858,"_5":17389,"_23725":99415,"_2383":99859},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2856":59026,"_25058":58839,"_17494":99861,"_5":17389,"_23725":99415,"_2383":99862},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_2856":59027,"_25058":59027,"_5":12268,"_2383":43048,"_25394":99864,"_17494":99865,"_23725":59027},[40730,96973,43048],[],{"_2856":59028,"_25058":59027,"_17494":99867,"_5":17389,"_23725":59027,"_2383":99868},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_2856":59029,"_25058":59027,"_5":25391,"_17494":99870,"_23725":99871,"_2383":99872},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_2856":59030,"_25058":59027,"_5":25391,"_17494":99874,"_23725":99875,"_2383":97945},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_2856":59031,"_25058":59027,"_5":25391,"_17494":99877,"_23725":99878,"_2383":98120},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_2856":59032,"_25058":59027,"_5":25391,"_17494":99880,"_23725":99881,"_2383":99334},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/overview#integraciones",{"_2856":59033,"_25058":59027,"_5":25391,"_17494":99883,"_23725":99884,"_2383":99885},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_2856":59034,"_25058":59027,"_17494":99887,"_5":17389,"_23725":59027,"_2383":99888},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_2856":59035,"_25058":59027,"_17494":99890,"_5":17389,"_23725":99871,"_2383":99891},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_2856":59036,"_25058":59027,"_17494":99893,"_5":17389,"_23725":99871,"_2383":99894},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_2856":59037,"_25058":59027,"_17494":99896,"_5":17389,"_23725":99875,"_2383":99897},[],"Recurso",{"_2856":59038,"_25058":59027,"_17494":99899,"_5":17389,"_23725":99875,"_2383":99900},[],"Qué representa",{"_2856":59039,"_25058":59027,"_17494":99902,"_5":17389,"_23725":99875,"_2383":99903},[],"**Dispositivo**",{"_2856":59040,"_25058":59027,"_17494":99905,"_5":17389,"_23725":99875,"_2383":99906},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_2856":59041,"_25058":59027,"_17494":99908,"_5":17389,"_23725":99875,"_2383":99909},[],"**Identidad**",{"_2856":59042,"_25058":59027,"_17494":99911,"_5":17389,"_23725":99875,"_2383":99912},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_2856":59043,"_25058":59027,"_17494":99914,"_5":17389,"_23725":99875,"_2383":45105},[],{"_2856":59044,"_25058":59027,"_17494":99916,"_5":17389,"_23725":99875,"_2383":99917},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_2856":59045,"_25058":59027,"_17494":99919,"_5":17389,"_23725":99875,"_2383":99920},[],"**Flota**",{"_2856":59046,"_25058":59027,"_17494":99922,"_5":17389,"_23725":99875,"_2383":99923},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_2856":59047,"_25058":59027,"_17494":99925,"_5":17389,"_23725":99875,"_2383":99926},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_2856":59048,"_25058":59027,"_17494":99928,"_5":17389,"_23725":99875,"_2383":99929},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_2856":59049,"_25058":59027,"_17494":99931,"_5":17389,"_23725":99878,"_2383":99932},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_2856":59050,"_25058":59027,"_17494":99934,"_5":17389,"_23725":99878,"_2383":99935},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_2856":59051,"_25058":59027,"_17494":99937,"_5":17389,"_23725":99878,"_2383":99938},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_2856":59052,"_25058":59027,"_17494":99940,"_5":17389,"_23725":99878,"_2383":99941},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_2856":59053,"_25058":59027,"_17494":99943,"_5":17389,"_23725":99878,"_2383":99944},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_2856":59054,"_25058":59027,"_17494":99946,"_5":17389,"_23725":99878,"_2383":99947},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_2856":59055,"_25058":59027,"_17494":99949,"_5":17389,"_23725":99878,"_2383":99950},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2856":59056,"_25058":59027,"_17494":99952,"_5":17389,"_23725":99878,"_2383":99953},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2856":59057,"_25058":59027,"_17494":99955,"_5":17389,"_23725":99881,"_2383":99956},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_2856":59058,"_25058":59027,"_17494":99958,"_5":17389,"_23725":99881,"_2383":99959},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_2856":59059,"_25058":59027,"_17494":99961,"_5":17389,"_23725":99884,"_2383":99962},[],"Participante",{"_2856":59060,"_25058":59027,"_17494":99964,"_5":17389,"_23725":99884,"_2383":99965},[],"Responsabilidad",{"_2856":59061,"_25058":59027,"_17494":99967,"_5":17389,"_23725":99884,"_2383":99968},[],"Administrador PKI",{"_2856":59062,"_25058":59027,"_17494":99970,"_5":17389,"_23725":99884,"_2383":99971},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_2856":59063,"_25058":59027,"_17494":99973,"_5":17389,"_23725":99884,"_2383":99974},[],"Administrador del aprovisionamiento",{"_2856":59064,"_25058":59027,"_17494":99976,"_5":17389,"_23725":99884,"_2383":99977},[],"DMS, admisión, autenticación por operación e inventario.",{"_2856":59065,"_25058":59027,"_17494":99979,"_5":17389,"_23725":99884,"_2383":99980},[],"Integrador del dispositivo",{"_2856":59066,"_25058":59027,"_17494":99982,"_5":17389,"_23725":99884,"_2383":99983},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_2856":59067,"_25058":59027,"_17494":99985,"_5":17389,"_23725":99884,"_2383":99986},[],"Integrador del consumidor",{"_2856":59068,"_25058":59027,"_17494":99988,"_5":17389,"_23725":99884,"_2383":99989},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_2856":59069,"_25058":59027,"_17494":99991,"_5":17389,"_23725":99884,"_2383":99992},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_2856":59070,"_25058":59070,"_5":12268,"_2383":99994,"_25394":99995,"_17494":99997,"_23725":59070},"Enrola y conecta tu primer dispositivo",[40730,96973,43048,99996],"Primeros pasos",[],{"_2856":59071,"_25058":59070,"_17494":99999,"_5":17389,"_23725":59070,"_2383":100000},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_2856":59072,"_25058":59070,"_5":25391,"_17494":100002,"_23725":100003,"_2383":95674},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_2856":59073,"_25058":59070,"_5":25391,"_17494":100005,"_23725":100006,"_2383":100007},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_2856":59074,"_25058":59070,"_5":25391,"_17494":100009,"_23725":100010,"_2383":100011},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_2856":59075,"_25058":59070,"_5":25391,"_17494":100013,"_23725":100014,"_2383":100015},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_2856":59076,"_25058":59070,"_5":25391,"_17494":100017,"_23725":100018,"_2383":100019},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_2856":59077,"_25058":59070,"_5":25391,"_17494":100021,"_23725":100022,"_2383":100023},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_2856":59078,"_25058":59070,"_5":25391,"_17494":100025,"_23725":100026,"_2383":100027},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_2856":59079,"_25058":59070,"_5":25391,"_17494":100029,"_23725":100030,"_2383":100031},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_2856":59080,"_25058":59070,"_17494":100033,"_5":17389,"_23725":59070,"_2383":100034},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_2856":59081,"_25058":59070,"_17494":100036,"_5":17389,"_23725":100003,"_2383":100037},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_2856":59082,"_25058":59070,"_17494":100039,"_5":17389,"_23725":100003,"_2383":100040},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_2856":59083,"_25058":59070,"_17494":100042,"_5":17389,"_23725":100003,"_2383":100043},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_2856":59084,"_25058":59070,"_17494":100045,"_5":17389,"_23725":100003,"_2383":100046},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_2856":59085,"_25058":59070,"_17494":100048,"_5":17389,"_23725":100003,"_2383":100049},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_2856":59086,"_25058":59070,"_17494":100051,"_5":17389,"_23725":100006,"_2383":100052},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_2856":59087,"_25058":59070,"_17494":100054,"_5":17389,"_23725":100006,"_2383":100055},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_2856":59088,"_25058":59070,"_17494":100057,"_5":17389,"_23725":100010,"_2383":100058},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_2856":59089,"_25058":59070,"_17494":100060,"_5":17389,"_23725":100010,"_2383":100061},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_2856":59090,"_25058":59070,"_17494":100063,"_5":17389,"_23725":100010,"_2383":100064},[],"Ajuste",{"_2856":59091,"_25058":59070,"_17494":100066,"_5":17389,"_23725":100010,"_2383":100067},[],"Valor de evaluación",{"_2856":59092,"_25058":59070,"_17494":100069,"_5":17389,"_23725":100010,"_2383":45261},[],{"_2856":59093,"_25058":59070,"_17494":100071,"_5":17389,"_23725":100010,"_2383":100072},[],"Raíz emisora de `device-root.pem`.",{"_2856":59094,"_25058":59070,"_17494":100074,"_5":17389,"_23725":100010,"_2383":98248},[],{"_2856":59095,"_25058":59070,"_17494":100076,"_5":17389,"_23725":100010,"_2383":100077},[],"Perfil final de 1 hora que acabas de preparar.",{"_2856":59096,"_25058":59070,"_17494":100079,"_5":17389,"_23725":100010,"_2383":45272},[],{"_2856":59097,"_25058":59070,"_17494":100081,"_5":17389,"_23725":100010,"_2383":45275},[],{"_2856":59098,"_25058":59070,"_17494":100083,"_5":17389,"_23725":100010,"_2383":45278},[],{"_2856":59099,"_25058":59070,"_17494":100085,"_5":17389,"_23725":100010,"_2383":100086},[],"Habilitado.",{"_2856":59100,"_25058":59070,"_17494":100088,"_5":17389,"_23725":100010,"_2383":45284},[],{"_2856":59101,"_25058":59070,"_17494":100090,"_5":17389,"_23725":100010,"_2383":100091},[],"Deshabilitado; el ID debe ser nuevo.",{"_2856":59102,"_25058":59070,"_17494":100093,"_5":17389,"_23725":100010,"_2383":100094},[],"Autenticación inicial",{"_2856":59103,"_25058":59070,"_17494":100096,"_5":17389,"_23725":100010,"_2383":100097},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_2856":59104,"_25058":59070,"_17494":100099,"_5":17389,"_23725":100010,"_2383":100100},[],"Autenticación de renovación",{"_2856":59105,"_25058":59070,"_17494":100102,"_5":17389,"_23725":100010,"_2383":100103},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_2856":59106,"_25058":59070,"_17494":100105,"_5":17389,"_23725":100010,"_2383":45302},[],{"_2856":59107,"_25058":59070,"_17494":100107,"_5":17389,"_23725":100010,"_2383":100108},[],"Lista vacía para esta emisión directa / deshabilitado.",{"_2856":59108,"_25058":59070,"_17494":100110,"_5":17389,"_23725":100010,"_2383":45308},[],{"_2856":59109,"_25058":59070,"_17494":100112,"_5":17389,"_23725":100010,"_2383":100113},[],"1 hora.",{"_2856":59110,"_25058":59070,"_17494":100115,"_5":17389,"_23725":100010,"_2383":45314},[],{"_2856":59111,"_25058":59070,"_17494":100117,"_5":17389,"_23725":100010,"_2383":100118},[],"30 minutos / 10 minutos.",{"_2856":59112,"_25058":59070,"_17494":100120,"_5":17389,"_23725":100010,"_2383":45320},[],{"_2856":59113,"_25058":59070,"_17494":100122,"_5":17389,"_23725":100010,"_2383":100123},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_2856":59114,"_25058":59070,"_17494":100125,"_5":17389,"_23725":100010,"_2383":43367},[],{"_2856":59115,"_25058":59070,"_17494":100127,"_5":17389,"_23725":100010,"_2383":100128},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_2856":59116,"_25058":59070,"_17494":100130,"_5":17389,"_23725":100010,"_2383":45331},[],{"_2856":59117,"_25058":59070,"_17494":100132,"_5":17389,"_23725":100010,"_2383":100133},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_2856":59118,"_25058":59070,"_17494":100135,"_5":17389,"_23725":100010,"_2383":100136},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_2856":59119,"_25058":59070,"_17494":100138,"_5":17389,"_23725":100014,"_2383":100139},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_2856":59120,"_25058":59070,"_17494":100141,"_5":17389,"_23725":100014,"_2383":100142},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_2856":59121,"_25058":59070,"_17494":100144,"_5":17389,"_23725":100018,"_2383":100145},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_2856":59122,"_25058":59070,"_17494":100147,"_5":17389,"_23725":100018,"_2383":100148},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_2856":59123,"_25058":59070,"_17494":100150,"_5":17389,"_23725":100018,"_2383":100151},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_2856":59124,"_25058":59070,"_17494":100153,"_5":17389,"_23725":100022,"_2383":100154},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_2856":59125,"_25058":59070,"_17494":100156,"_5":17389,"_23725":100022,"_2383":100157},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_2856":59126,"_25058":59070,"_17494":100159,"_5":17389,"_23725":100026,"_2383":100160},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_2856":59127,"_25058":59070,"_17494":100162,"_5":17389,"_23725":100026,"_2383":100163},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_2856":59128,"_25058":59070,"_17494":100165,"_5":17389,"_23725":100026,"_2383":100166},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_2856":59129,"_25058":59070,"_17494":100168,"_5":17389,"_23725":100026,"_2383":100169},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_2856":59130,"_25058":59070,"_17494":100171,"_5":17389,"_23725":100026,"_2383":100172},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_2856":59131,"_25058":59070,"_17494":100174,"_5":17389,"_23725":100030,"_2383":100175},[],"Comprobación",{"_2856":59132,"_25058":59070,"_17494":100177,"_5":17389,"_23725":100030,"_2383":100178},[],"Resultado esperado",{"_2856":59133,"_25058":59070,"_17494":100180,"_5":17389,"_23725":100030,"_2383":100181},[],"Registro",{"_2856":59134,"_25058":59070,"_17494":100183,"_5":17389,"_23725":100030,"_2383":100184},[],"ID creado automáticamente y DMS correcto.",{"_2856":59135,"_25058":59070,"_17494":100186,"_5":17389,"_23725":100030,"_2383":100187},[],"Certificado",{"_2856":59136,"_25058":59070,"_17494":100189,"_5":17389,"_23725":100030,"_2383":100190},[],"CN, perfil, serie y clave verificados.",{"_2856":59137,"_25058":59070,"_17494":100192,"_5":17389,"_23725":100030,"_2383":100193},[],"Inventario",{"_2856":59138,"_25058":59070,"_17494":100195,"_5":17389,"_23725":100030,"_2383":100196},[],"Serie recibida visible como identidad actual y en el historial.",{"_2856":59139,"_25058":59070,"_17494":100198,"_5":17389,"_23725":100030,"_2383":100199},[],"Consumidor",{"_2856":59140,"_25058":59070,"_17494":100201,"_5":17389,"_23725":100030,"_2383":100202},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_2856":59141,"_25058":59070,"_17494":100204,"_5":17389,"_23725":100030,"_2383":100205},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_2856":59142,"_25058":59070,"_17494":100207,"_5":17389,"_23725":100030,"_2383":100208},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_2856":59143,"_25058":59143,"_5":12268,"_2383":97962,"_25394":100210,"_17494":100211,"_23725":59143},[40730,96973,43048,99996],[],{"_2856":59144,"_25058":59143,"_17494":100213,"_5":17389,"_23725":59143,"_2383":100214},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_2856":59145,"_25058":59143,"_5":25391,"_17494":100216,"_23725":100217,"_2383":95674},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_2856":59146,"_25058":59143,"_5":25391,"_17494":100219,"_23725":100220,"_2383":100221},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_2856":59147,"_25058":59143,"_5":25391,"_17494":100223,"_23725":100224,"_2383":100225},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_2856":59148,"_25058":59143,"_5":25391,"_17494":100227,"_23725":100228,"_2383":100229},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_2856":59149,"_25058":59143,"_5":25391,"_17494":100231,"_23725":100232,"_2383":100233},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_2856":59150,"_25058":59143,"_5":25391,"_17494":100235,"_23725":100236,"_2383":100237},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_2856":59151,"_25058":59143,"_5":25391,"_17494":100239,"_23725":100240,"_2383":100178},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_2856":59152,"_25058":59143,"_5":25391,"_17494":100242,"_23725":100243,"_2383":100244},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_2856":59153,"_25058":59143,"_5":25391,"_17494":100246,"_23725":100247,"_2383":100248},[],"/docs/pr-preview/pr-44/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_2856":59154,"_25058":59143,"_17494":100250,"_5":17389,"_23725":59143,"_2383":100251},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_2856":59155,"_25058":59143,"_17494":100253,"_5":17389,"_23725":59143,"_2383":100254},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_2856":59156,"_25058":59143,"_17494":100256,"_5":17389,"_23725":100217,"_2383":100257},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_2856":59157,"_25058":59143,"_17494":100259,"_5":17389,"_23725":100217,"_2383":100260},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_2856":59158,"_25058":59143,"_17494":100262,"_5":17389,"_23725":100217,"_2383":100263},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_2856":59159,"_25058":59143,"_17494":100265,"_5":17389,"_23725":100217,"_2383":100266},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_2856":59160,"_25058":59143,"_17494":100268,"_5":17389,"_23725":100220,"_2383":100269},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_2856":59161,"_25058":59143,"_17494":100271,"_5":17389,"_23725":100220,"_2383":100272},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_2856":59162,"_25058":59143,"_17494":100274,"_5":17389,"_23725":100220,"_2383":100275},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_2856":59163,"_25058":59143,"_17494":100277,"_5":17389,"_23725":100220,"_2383":100278},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_2856":59164,"_25058":59143,"_17494":100280,"_5":17389,"_23725":100220,"_2383":100281},[],"Configura **Authentication Mode** como `CLIENT_CERTIFICATE` y añade en **Validation CAs** la CA cuyos certificados iniciales aceptarás. Para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deshabilitada la generación de claves en servidor si no la vas a utilizar.",{"_2856":59165,"_25058":59143,"_17494":100283,"_5":17389,"_23725":100220,"_2383":100284},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_2856":59166,"_25058":59143,"_17494":100286,"_5":17389,"_23725":100220,"_2383":100287},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_2856":59167,"_25058":59143,"_17494":100289,"_5":17389,"_23725":100220,"_2383":100290},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_2856":59168,"_25058":59143,"_17494":100292,"_5":17389,"_23725":100224,"_2383":100293},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_2856":59169,"_25058":59143,"_17494":100295,"_5":17389,"_23725":100224,"_2383":45497},[],{"_2856":59170,"_25058":59143,"_17494":100297,"_5":17389,"_23725":100224,"_2383":100298},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_2856":59171,"_25058":59143,"_17494":100300,"_5":17389,"_23725":100224,"_2383":100301},[],"**Icon** y **Tags**: clasificación opcional.",{"_2856":59172,"_25058":59143,"_17494":100303,"_5":17389,"_23725":100224,"_2383":100304},[],"Confirma el registro.",{"_2856":59173,"_25058":59143,"_17494":100306,"_5":17389,"_23725":100228,"_2383":100307},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_2856":59174,"_25058":59143,"_17494":100309,"_5":17389,"_23725":100228,"_2383":100310},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_2856":59175,"_25058":59143,"_17494":100312,"_5":17389,"_23725":100232,"_2383":100313},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_2856":59176,"_25058":59143,"_17494":100315,"_5":17389,"_23725":100232,"_2383":100316},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_2856":59177,"_25058":59143,"_17494":100318,"_5":17389,"_23725":100236,"_2383":100319},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_2856":59178,"_25058":59143,"_17494":100321,"_5":17389,"_23725":100236,"_2383":100322},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_2856":59179,"_25058":59143,"_17494":100324,"_5":17389,"_23725":100240,"_2383":100175},[],{"_2856":59180,"_25058":59143,"_17494":100326,"_5":17389,"_23725":100240,"_2383":100327},[],"Resultado",{"_2856":59181,"_25058":59143,"_17494":100329,"_5":17389,"_23725":100240,"_2383":100330},[],"Dispositivo",{"_2856":59182,"_25058":59143,"_17494":100332,"_5":17389,"_23725":100240,"_2383":100333},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_2856":59183,"_25058":59143,"_17494":100335,"_5":17389,"_23725":100240,"_2383":100336},[],"Identidad actual",{"_2856":59184,"_25058":59143,"_17494":100338,"_5":17389,"_23725":100240,"_2383":100339},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_2856":59185,"_25058":59143,"_17494":100341,"_5":17389,"_23725":100240,"_2383":100342},[],"Historial",{"_2856":59186,"_25058":59143,"_17494":100344,"_5":17389,"_23725":100240,"_2383":100345},[],"La emisión asociada aparece con su número de serie y fechas.",{"_2856":59187,"_25058":59143,"_17494":100347,"_5":17389,"_23725":100240,"_2383":100348},[],"Clave y certificado",{"_2856":59188,"_25058":59143,"_17494":100350,"_5":17389,"_23725":100240,"_2383":100351},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_2856":59189,"_25058":59143,"_17494":100353,"_5":17389,"_23725":100243,"_2383":100354},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_2856":59190,"_25058":59143,"_17494":100356,"_5":17389,"_23725":100243,"_2383":100357},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_2856":59191,"_25058":59143,"_17494":100359,"_5":17389,"_23725":100243,"_2383":100360},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_2856":59192,"_25058":59143,"_17494":100362,"_5":17389,"_23725":100243,"_2383":100363},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_2856":59193,"_25058":59143,"_17494":100365,"_5":17389,"_23725":100247,"_2383":100366},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_2856":59194,"_25058":59143,"_17494":100368,"_5":17389,"_23725":100247,"_2383":100369},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_2856":59195,"_25058":59143,"_17494":100371,"_5":17389,"_23725":100247,"_2383":100372},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_2856":59196,"_25058":59196,"_5":12268,"_2383":100374,"_25394":100375,"_17494":100376,"_23725":59196},"Plataforma Lamassu IoT",[40730,96973],[],{"_2856":59197,"_25058":59196,"_17494":100378,"_5":17389,"_23725":59196,"_2383":100379},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_2856":59198,"_25058":59196,"_5":25391,"_17494":100381,"_23725":100382,"_2383":99872},[],"/docs/pr-preview/pr-44/es/platform/overview#empieza-aquí",{"_2856":59199,"_25058":59196,"_5":25391,"_17494":100384,"_23725":100385,"_2383":100386},[],"/docs/pr-preview/pr-44/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_2856":59200,"_25058":59196,"_5":25391,"_17494":100388,"_23725":100389,"_2383":100390},[],"/docs/pr-preview/pr-44/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_2856":59201,"_25058":59196,"_5":25391,"_17494":100392,"_23725":100393,"_2383":100394},[],"/docs/pr-preview/pr-44/es/platform/overview#capacidades-principales","Capacidades principales",{"_2856":59202,"_25058":59196,"_5":25391,"_17494":100396,"_23725":100397,"_2383":100398},[],"/docs/pr-preview/pr-44/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_2856":59203,"_25058":59196,"_5":25391,"_17494":100400,"_23725":100401,"_2383":100402},[],"/docs/pr-preview/pr-44/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_2856":59204,"_25058":59196,"_5":25391,"_17494":100404,"_23725":100405,"_2383":100406},[],"/docs/pr-preview/pr-44/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_2856":59205,"_25058":59196,"_5":25391,"_17494":100408,"_23725":100409,"_2383":100410},[],"/docs/pr-preview/pr-44/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_2856":59206,"_25058":59196,"_5":25391,"_17494":100412,"_23725":100413,"_2383":100414},[],"/docs/pr-preview/pr-44/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_2856":59207,"_25058":59196,"_5":25391,"_17494":100416,"_23725":100417,"_2383":100418},[],"/docs/pr-preview/pr-44/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_2856":59208,"_25058":59196,"_5":25391,"_17494":100420,"_23725":100421,"_2383":100422},[],"/docs/pr-preview/pr-44/es/platform/overview#referencia-operativa","Referencia operativa",{"_2856":59209,"_25058":59196,"_17494":100424,"_5":17389,"_23725":59196,"_2383":100425},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_2856":59210,"_25058":59196,"_17494":100427,"_5":17389,"_23725":100382,"_2383":100428},[],"Elige el resultado que necesitas obtener:",{"_2856":59211,"_25058":59196,"_17494":100430,"_5":17389,"_23725":100382,"_2383":100431},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2856":59212,"_25058":59196,"_17494":100433,"_5":17389,"_23725":100382,"_2383":100434},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2856":59213,"_25058":59196,"_17494":100436,"_5":17389,"_23725":100382,"_2383":100437},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_2856":59214,"_25058":59196,"_17494":100439,"_5":17389,"_23725":100385,"_2383":100440},[],"Bloque",{"_2856":59215,"_25058":59196,"_17494":100442,"_5":17389,"_23725":100385,"_2383":100443},[],"Qué gestionas",{"_2856":59216,"_25058":59196,"_17494":100445,"_5":17389,"_23725":100385,"_2383":100446},[],"Punto de entrada",{"_2856":59217,"_25058":59196,"_17494":100448,"_5":17389,"_23725":100385,"_2383":45651},[],{"_2856":59218,"_25058":59196,"_17494":100450,"_5":17389,"_23725":100385,"_2383":100451},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_2856":59219,"_25058":59196,"_17494":100453,"_5":17389,"_23725":100385,"_2383":100454},[],"Visión general de PKI",{"_2856":59220,"_25058":59196,"_17494":100456,"_5":17389,"_23725":100385,"_2383":45660},[],{"_2856":59221,"_25058":59196,"_17494":100458,"_5":17389,"_23725":100385,"_2383":100459},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_2856":59222,"_25058":59196,"_17494":100461,"_5":17389,"_23725":100385,"_2383":100462},[],"Visión general de IoT Fleets",{"_2856":59223,"_25058":59196,"_17494":100464,"_5":17389,"_23725":100385,"_2383":100465},[],"**Administración**",{"_2856":59224,"_25058":59196,"_17494":100467,"_5":17389,"_23725":100385,"_2383":100468},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_2856":59225,"_25058":59196,"_17494":100470,"_5":17389,"_23725":100385,"_2383":96971},[],{"_2856":59226,"_25058":59196,"_17494":100472,"_5":17389,"_23725":100385,"_2383":100473},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_2856":59227,"_25058":59196,"_17494":100475,"_5":17389,"_23725":100389,"_2383":100476},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_2856":59228,"_25058":59196,"_17494":100478,"_5":17389,"_23725":100389,"_2383":100479},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_2856":59229,"_25058":59196,"_17494":100481,"_5":17389,"_23725":100389,"_2383":100482},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_2856":59230,"_25058":59196,"_17494":100484,"_5":17389,"_23725":100389,"_2383":100485},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_2856":59231,"_25058":59196,"_17494":100487,"_5":17389,"_23725":100389,"_2383":100488},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_2856":59232,"_25058":59196,"_17494":100490,"_5":17389,"_23725":100389,"_2383":100491},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_2856":59233,"_25058":59196,"_17494":100493,"_5":17389,"_23725":100397,"_2383":100494},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_2856":59234,"_25058":59196,"_17494":100496,"_5":17389,"_23725":100401,"_2383":100497},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_2856":59235,"_25058":59196,"_17494":100499,"_5":17389,"_23725":100405,"_2383":100500},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_2856":59236,"_25058":59196,"_17494":100502,"_5":17389,"_23725":100409,"_2383":100503},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_2856":59237,"_25058":59196,"_17494":100505,"_5":17389,"_23725":100413,"_2383":100506},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_2856":59238,"_25058":59196,"_17494":100508,"_5":17389,"_23725":100417,"_2383":100509},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_2856":59239,"_25058":59196,"_17494":100511,"_5":17389,"_23725":100421,"_2383":99965},[],{"_2856":59240,"_25058":59196,"_17494":100513,"_5":17389,"_23725":100421,"_2383":100514},[],"Qué prepara o comprueba",{"_2856":59241,"_25058":59196,"_17494":100516,"_5":17389,"_23725":100421,"_2383":99968},[],{"_2856":59242,"_25058":59196,"_17494":100518,"_5":17389,"_23725":100421,"_2383":100519},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_2856":59243,"_25058":59196,"_17494":100521,"_5":17389,"_23725":100421,"_2383":100522},[],"Administrador de la flota",{"_2856":59244,"_25058":59196,"_17494":100524,"_5":17389,"_23725":100421,"_2383":100525},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_2856":59245,"_25058":59196,"_17494":100527,"_5":17389,"_23725":100421,"_2383":99980},[],{"_2856":59246,"_25058":59196,"_17494":100529,"_5":17389,"_23725":100421,"_2383":100530},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_2856":59247,"_25058":59196,"_17494":100532,"_5":17389,"_23725":100421,"_2383":99986},[],{"_2856":59248,"_25058":59196,"_17494":100534,"_5":17389,"_23725":100421,"_2383":100535},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_2856":59249,"_25058":59196,"_17494":100537,"_5":17389,"_23725":100421,"_2383":100538},[],"Operador de infraestructura",{"_2856":59250,"_25058":59196,"_17494":100540,"_5":17389,"_23725":100421,"_2383":100541},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_2856":59251,"_25058":59196,"_17494":100543,"_5":17389,"_23725":100421,"_2383":100544},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_2856":59252,"_25058":59252,"_5":12268,"_2383":100546,"_25394":100547,"_17494":100549,"_23725":59252},"Jerarquía y rotación de CAs",[40730,96973,45752,100548],"Claves, autoridades y certificados",[],{"_2856":59253,"_25058":59252,"_17494":100551,"_5":17389,"_23725":59252,"_2383":100552},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_2856":59254,"_25058":59252,"_5":25391,"_17494":100554,"_23725":100555,"_2383":100556},[],"/docs/pr-preview/pr-44/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_2856":59255,"_25058":59252,"_5":25391,"_17494":100558,"_23725":100559,"_2383":100560},[],"/docs/pr-preview/pr-44/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_2856":59256,"_25058":59252,"_5":25391,"_17494":100562,"_23725":100563,"_2383":100564},[],"/docs/pr-preview/pr-44/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_2856":59257,"_25058":59252,"_5":25391,"_17494":100566,"_23725":100567,"_2383":100568},[],"/docs/pr-preview/pr-44/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_2856":59258,"_25058":59252,"_5":25391,"_17494":100570,"_23725":100571,"_2383":100572},[],"/docs/pr-preview/pr-44/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_2856":59259,"_25058":59252,"_5":25391,"_17494":100574,"_23725":100575,"_2383":100576},[],"/docs/pr-preview/pr-44/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_2856":59260,"_25058":59252,"_5":25391,"_17494":100578,"_23725":100579,"_2383":100580},[],"/docs/pr-preview/pr-44/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_2856":59261,"_25058":59252,"_5":25391,"_17494":100582,"_23725":100583,"_2383":100584},[],"/docs/pr-preview/pr-44/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_2856":59262,"_25058":59252,"_5":25391,"_17494":100586,"_23725":100587,"_2383":100588},[],"/docs/pr-preview/pr-44/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_2856":59263,"_25058":59252,"_5":25391,"_17494":100590,"_23725":100591,"_2383":100592},[],"/docs/pr-preview/pr-44/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_2856":59264,"_25058":59252,"_5":25391,"_17494":100594,"_23725":100595,"_2383":100596},[],"/docs/pr-preview/pr-44/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_2856":59265,"_25058":59252,"_5":25391,"_17494":100598,"_23725":100599,"_2383":100600},[],"/docs/pr-preview/pr-44/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_2856":59266,"_25058":59252,"_17494":100602,"_5":17389,"_23725":59252,"_2383":100603},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_2856":59267,"_25058":59252,"_17494":100605,"_5":17389,"_23725":59252,"_2383":100606},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_2856":59268,"_25058":59252,"_17494":100608,"_5":17389,"_23725":100555,"_2383":100609},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_2856":59269,"_25058":59252,"_17494":100611,"_5":17389,"_23725":100555,"_2383":100612},[],"entorno, como producción y preproducción;",{"_2856":59270,"_25058":59252,"_17494":100614,"_5":17389,"_23725":100555,"_2383":100615},[],"propietario o equipo operador;",{"_2856":59271,"_25058":59252,"_17494":100617,"_5":17389,"_23725":100555,"_2383":100618},[],"familia de dispositivos o proceso de fabricación;",{"_2856":59272,"_25058":59252,"_17494":100620,"_5":17389,"_23725":100555,"_2383":100621},[],"región o requisito regulatorio;",{"_2856":59273,"_25058":59252,"_17494":100623,"_5":17389,"_23725":100555,"_2383":100624},[],"motor criptográfico o política de clave;",{"_2856":59274,"_25058":59252,"_17494":100626,"_5":17389,"_23725":100555,"_2383":100627},[],"ventana de mantenimiento y ritmo de renovación.",{"_2856":59275,"_25058":59252,"_17494":100629,"_5":17389,"_23725":100555,"_2383":100630},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_2856":59276,"_25058":59252,"_17494":100632,"_5":17389,"_23725":100555,"_2383":100633},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_2856":59277,"_25058":59252,"_17494":100635,"_5":17389,"_23725":100559,"_2383":100636},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_2856":59278,"_25058":59252,"_17494":100638,"_5":17389,"_23725":100559,"_2383":100639},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_2856":59279,"_25058":59252,"_17494":100641,"_5":17389,"_23725":100559,"_2383":100642},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_2856":59280,"_25058":59252,"_17494":100644,"_5":17389,"_23725":100563,"_2383":100645},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_2856":59281,"_25058":59252,"_17494":100647,"_5":17389,"_23725":100563,"_2383":100648},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_2856":59282,"_25058":59252,"_17494":100650,"_5":17389,"_23725":100563,"_2383":100651},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_2856":59283,"_25058":59252,"_17494":100653,"_5":17389,"_23725":100563,"_2383":100654},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_2856":59284,"_25058":59252,"_17494":100656,"_5":17389,"_23725":100571,"_2383":100657},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_2856":59285,"_25058":59252,"_17494":100659,"_5":17389,"_23725":100575,"_2383":100660},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_2856":59286,"_25058":59252,"_17494":100662,"_5":17389,"_23725":100579,"_2383":100663},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_2856":59287,"_25058":59252,"_17494":100665,"_5":17389,"_23725":100583,"_2383":100666},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mantén las CAs de validación adicionales si todavía deben aceptarse certificados antiguos durante el re-enrolamiento.",{"_2856":59288,"_25058":59252,"_17494":100668,"_5":17389,"_23725":100587,"_2383":100669},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_2856":59289,"_25058":59252,"_17494":100671,"_5":17389,"_23725":100591,"_2383":100672},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_2856":59290,"_25058":59252,"_17494":100674,"_5":17389,"_23725":100595,"_2383":100675},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_2856":59291,"_25058":59252,"_17494":100677,"_5":17389,"_23725":100595,"_2383":100678},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_2856":59292,"_25058":59252,"_17494":100680,"_5":17389,"_23725":100595,"_2383":100681},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_2856":59293,"_25058":59252,"_17494":100683,"_5":17389,"_23725":100595,"_2383":100684},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_2856":59294,"_25058":59252,"_17494":100686,"_5":17389,"_23725":100599,"_2383":100687},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_2856":59295,"_25058":59252,"_17494":100689,"_5":17389,"_23725":100599,"_2383":100690},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_2856":59296,"_25058":59252,"_17494":100692,"_5":17389,"_23725":100599,"_2383":100693},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_2856":59297,"_25058":59252,"_17494":100695,"_5":17389,"_23725":100599,"_2383":100696},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_2856":59298,"_25058":59252,"_17494":100698,"_5":17389,"_23725":100599,"_2383":100699},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_2856":59299,"_25058":59252,"_17494":100701,"_5":17389,"_23725":100599,"_2383":100702},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_2856":59300,"_25058":59252,"_17494":100704,"_5":17389,"_23725":100599,"_2383":100705},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_2856":59301,"_25058":59301,"_5":12268,"_2383":100707,"_25394":100708,"_17494":100709,"_23725":59301},"Autoridades de certificación",[40730,96973,45752,100548],[],{"_2856":59302,"_25058":59301,"_17494":100711,"_5":17389,"_23725":59301,"_2383":100712},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_2856":59303,"_25058":59301,"_5":25391,"_17494":100714,"_23725":100715,"_2383":100716},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_2856":59304,"_25058":59301,"_5":25391,"_17494":100718,"_23725":100719,"_2383":100720},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_2856":59305,"_25058":59301,"_5":25391,"_17494":100722,"_23725":100723,"_2383":95674},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-authorities#antes-de-empezar",{"_2856":59306,"_25058":59301,"_5":25391,"_17494":100725,"_23725":100726,"_2383":100727},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_2856":59307,"_25058":59301,"_5":25391,"_17494":100729,"_23725":100730,"_2383":100731},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_2856":59308,"_25058":59301,"_5":25391,"_17494":100733,"_23725":100734,"_2383":100735},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_2856":59309,"_25058":59301,"_5":25391,"_17494":100737,"_23725":100738,"_2383":100739},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_2856":59310,"_25058":59301,"_5":25391,"_17494":100741,"_23725":100742,"_2383":100743},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_2856":59311,"_25058":59301,"_5":25391,"_17494":100745,"_23725":100746,"_2383":100747},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_2856":59312,"_25058":59301,"_5":25391,"_17494":100749,"_23725":100750,"_2383":100751},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_2856":59313,"_25058":59301,"_5":25391,"_17494":100753,"_23725":100754,"_2383":100755},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_2856":59314,"_25058":59301,"_5":25391,"_17494":100757,"_23725":100758,"_2383":100759},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_2856":59315,"_25058":59301,"_5":25391,"_17494":100761,"_23725":100762,"_2383":100763},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_2856":59316,"_25058":59301,"_5":25391,"_17494":100765,"_23725":100766,"_2383":100767},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_2856":59317,"_25058":59301,"_5":25391,"_17494":100769,"_23725":100770,"_2383":100771},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_2856":59318,"_25058":59301,"_5":25391,"_17494":100773,"_23725":100774,"_2383":100775},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_2856":59319,"_25058":59301,"_5":25391,"_17494":100777,"_23725":100778,"_2383":100779},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_2856":59320,"_25058":59301,"_5":25391,"_17494":100781,"_23725":100782,"_2383":100783},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_2856":59321,"_25058":59301,"_5":25391,"_17494":100785,"_23725":100786,"_2383":100787},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_2856":59322,"_25058":59301,"_5":25391,"_17494":100789,"_23725":100790,"_2383":100791},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_2856":59323,"_25058":59301,"_5":25391,"_17494":100793,"_23725":100794,"_2383":100795},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_2856":59324,"_25058":59301,"_5":25391,"_17494":100797,"_23725":100798,"_2383":100799},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_2856":59325,"_25058":59301,"_17494":100801,"_5":17389,"_23725":59301,"_2383":100802},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_2856":59326,"_25058":59301,"_17494":100804,"_5":17389,"_23725":59301,"_2383":100805},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_2856":59327,"_25058":59301,"_17494":100807,"_5":17389,"_23725":59301,"_2383":100808},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_2856":59328,"_25058":59301,"_17494":100810,"_5":17389,"_23725":100715,"_2383":100811},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_2856":59329,"_25058":59301,"_17494":100813,"_5":17389,"_23725":100715,"_2383":100814},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_2856":59330,"_25058":59301,"_17494":100816,"_5":17389,"_23725":100715,"_2383":100817},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_2856":59331,"_25058":59301,"_17494":100819,"_5":17389,"_23725":100715,"_2383":100820},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_2856":59332,"_25058":59301,"_17494":100822,"_5":17389,"_23725":100715,"_2383":100823},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_2856":59333,"_25058":59301,"_17494":100825,"_5":17389,"_23725":100723,"_2383":100826},[],"Decide si la CA será raíz o intermedia.",{"_2856":59334,"_25058":59301,"_17494":100828,"_5":17389,"_23725":100723,"_2383":100829},[],"Elige el motor que custodiará la clave.",{"_2856":59335,"_25058":59301,"_17494":100831,"_5":17389,"_23725":100723,"_2383":100832},[],"Define una validez superior a la de los certificados que emitirá.",{"_2856":59336,"_25058":59301,"_17494":100834,"_5":17389,"_23725":100723,"_2383":100835},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_2856":59337,"_25058":59301,"_17494":100837,"_5":17389,"_23725":100726,"_2383":100838},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_2856":59338,"_25058":59301,"_17494":100840,"_5":17389,"_23725":100730,"_2383":100841},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_2856":59339,"_25058":59301,"_17494":100843,"_5":17389,"_23725":100730,"_2383":100844},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_2856":59340,"_25058":59301,"_17494":100846,"_5":17389,"_23725":100734,"_2383":100847},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_2856":59341,"_25058":59301,"_17494":100849,"_5":17389,"_23725":100738,"_2383":100850},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_2856":59342,"_25058":59301,"_17494":100852,"_5":17389,"_23725":100738,"_2383":100853},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_2856":59343,"_25058":59301,"_17494":100855,"_5":17389,"_23725":100738,"_2383":100856},[],"`ST`: estado o provincia.",{"_2856":59344,"_25058":59301,"_17494":100858,"_5":17389,"_23725":100738,"_2383":100859},[],"`L`: localidad.",{"_2856":59345,"_25058":59301,"_17494":100861,"_5":17389,"_23725":100738,"_2383":100862},[],"`O`: organización.",{"_2856":59346,"_25058":59301,"_17494":100864,"_5":17389,"_23725":100738,"_2383":100865},[],"`OU`: unidad organizativa.",{"_2856":59347,"_25058":59301,"_17494":100867,"_5":17389,"_23725":100738,"_2383":100868},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_2856":59348,"_25058":59301,"_17494":100870,"_5":17389,"_23725":100742,"_2383":100871},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_2856":59349,"_25058":59301,"_17494":100873,"_5":17389,"_23725":100742,"_2383":100874},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_2856":59350,"_25058":59301,"_17494":100876,"_5":17389,"_23725":100746,"_2383":100877},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_2856":59351,"_25058":59301,"_17494":100879,"_5":17389,"_23725":100746,"_2383":100880},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_2856":59352,"_25058":59301,"_17494":100882,"_5":17389,"_23725":100750,"_2383":100883},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_2856":59353,"_25058":59301,"_17494":100885,"_5":17389,"_23725":100750,"_2383":100886},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_2856":59354,"_25058":59301,"_17494":100888,"_5":17389,"_23725":100754,"_2383":100889},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_2856":59355,"_25058":59301,"_17494":100891,"_5":17389,"_23725":100758,"_2383":100892},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_2856":59356,"_25058":59301,"_17494":100894,"_5":17389,"_23725":100762,"_2383":100895},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_2856":59357,"_25058":59301,"_17494":100897,"_5":17389,"_23725":100766,"_2383":100898},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_2856":59358,"_25058":59301,"_17494":100900,"_5":17389,"_23725":100770,"_2383":100901},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_2856":59359,"_25058":59301,"_17494":100903,"_5":17389,"_23725":100770,"_2383":100904},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_2856":59360,"_25058":59301,"_17494":100906,"_5":17389,"_23725":100774,"_2383":100907},[],"Abre una CA desde el inventario para consultar:",{"_2856":59361,"_25058":59301,"_17494":100909,"_5":17389,"_23725":100774,"_2383":100910},[],"Estado y periodo de validez.",{"_2856":59362,"_25058":59301,"_17494":100912,"_5":17389,"_23725":100774,"_2383":100913},[],"Certificado y cadena en formato PEM.",{"_2856":59363,"_25058":59301,"_17494":100915,"_5":17389,"_23725":100774,"_2383":100916},[],"Número de certificados activos, expirados y revocados.",{"_2856":59364,"_25058":59301,"_17494":100918,"_5":17389,"_23725":100774,"_2383":100919},[],"Certificados emitidos en **Issued Certificates**.",{"_2856":59365,"_25058":59301,"_17494":100921,"_5":17389,"_23725":100774,"_2383":100922},[],"CRL vinculada a la autoridad.",{"_2856":59366,"_25058":59301,"_17494":100924,"_5":17389,"_23725":100774,"_2383":100925},[],"Metadatos y motor criptográfico asociado.",{"_2856":59367,"_25058":59301,"_17494":100927,"_5":17389,"_23725":100774,"_2383":100928},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_2856":59368,"_25058":59301,"_17494":100930,"_5":17389,"_23725":100778,"_2383":100931},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_2856":59369,"_25058":59301,"_17494":100933,"_5":17389,"_23725":100778,"_2383":100934},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_2856":59370,"_25058":59301,"_17494":100936,"_5":17389,"_23725":100778,"_2383":100937},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_2856":59371,"_25058":59301,"_17494":100939,"_5":17389,"_23725":100778,"_2383":100940},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_2856":59372,"_25058":59301,"_17494":100942,"_5":17389,"_23725":100782,"_2383":100943},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_2856":59373,"_25058":59301,"_17494":100945,"_5":17389,"_23725":100786,"_2383":100946},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_2856":59374,"_25058":59301,"_17494":100948,"_5":17389,"_23725":100790,"_2383":100949},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_2856":59375,"_25058":59301,"_17494":100951,"_5":17389,"_23725":100794,"_2383":100952},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_2856":59376,"_25058":59301,"_17494":100954,"_5":17389,"_23725":100798,"_2383":100955},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_2856":59377,"_25058":59301,"_17494":100957,"_5":17389,"_23725":100798,"_2383":100958},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_2856":59378,"_25058":59378,"_5":12268,"_2383":100960,"_25394":100961,"_17494":100962,"_23725":59378},"Perfiles de certificado",[40730,96973,45752,100548],[],{"_2856":59379,"_25058":59378,"_17494":100964,"_5":17389,"_23725":59378,"_2383":100965},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_2856":59380,"_25058":59378,"_5":25391,"_17494":100967,"_23725":100968,"_2383":100969},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_2856":59381,"_25058":59378,"_5":25391,"_17494":100971,"_23725":100972,"_2383":100973},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-profiles#validez","Validez",{"_2856":59382,"_25058":59378,"_5":25391,"_17494":100975,"_23725":100976,"_2383":100977},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_2856":59383,"_25058":59378,"_5":25391,"_17494":100979,"_23725":100980,"_2383":100981},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_2856":59384,"_25058":59378,"_5":25391,"_17494":100983,"_23725":100984,"_2383":100985},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_2856":59385,"_25058":59378,"_5":25391,"_17494":100987,"_23725":100988,"_2383":100989},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_2856":59386,"_25058":59378,"_5":25391,"_17494":100991,"_23725":100992,"_2383":100993},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_2856":59387,"_25058":59378,"_5":25391,"_17494":100995,"_23725":100996,"_2383":100997},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_2856":59388,"_25058":59378,"_5":25391,"_17494":100999,"_23725":101000,"_2383":101001},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_2856":59389,"_25058":59378,"_5":25391,"_17494":101003,"_23725":101004,"_2383":101005},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_2856":59390,"_25058":59378,"_5":25391,"_17494":101007,"_23725":101008,"_2383":101009},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_2856":59391,"_25058":59378,"_5":25391,"_17494":101011,"_23725":101012,"_2383":101013},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_2856":59392,"_25058":59378,"_5":25391,"_17494":101015,"_23725":101016,"_2383":101017},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_2856":59393,"_25058":59378,"_5":25391,"_17494":101019,"_23725":101020,"_2383":101021},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_2856":59394,"_25058":59378,"_5":25391,"_17494":101023,"_23725":101024,"_2383":101025},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_2856":59395,"_25058":59378,"_5":25391,"_17494":101027,"_23725":101028,"_2383":101029},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_2856":59396,"_25058":59378,"_17494":101031,"_5":17389,"_23725":59378,"_2383":101032},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_2856":59397,"_25058":59378,"_17494":101034,"_5":17389,"_23725":59378,"_2383":101035},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_2856":59398,"_25058":59378,"_17494":101037,"_5":17389,"_23725":100972,"_2383":101038},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_2856":59399,"_25058":59378,"_17494":101040,"_5":17389,"_23725":100972,"_2383":101041},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_2856":59400,"_25058":59378,"_17494":101043,"_5":17389,"_23725":100976,"_2383":101044},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_2856":59401,"_25058":59378,"_17494":101046,"_5":17389,"_23725":100980,"_2383":101047},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_2856":59402,"_25058":59378,"_17494":101049,"_5":17389,"_23725":100980,"_2383":101050},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_2856":59403,"_25058":59378,"_17494":101052,"_5":17389,"_23725":100980,"_2383":101053},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_2856":59404,"_25058":59378,"_17494":101055,"_5":17389,"_23725":100984,"_2383":101056},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_2856":59405,"_25058":59378,"_17494":101058,"_5":17389,"_23725":100988,"_2383":101059},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_2856":59406,"_25058":59378,"_17494":101061,"_5":17389,"_23725":100988,"_2383":101062},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_2856":59407,"_25058":59378,"_17494":101064,"_5":17389,"_23725":100992,"_2383":101065},[],"La aplicación criptográfica puede:",{"_2856":59408,"_25058":59378,"_17494":101067,"_5":17389,"_23725":100992,"_2383":101068},[],"permitir o bloquear claves RSA;",{"_2856":59409,"_25058":59378,"_17494":101070,"_5":17389,"_23725":100992,"_2383":101071},[],"limitar los tamaños RSA admitidos;",{"_2856":59410,"_25058":59378,"_17494":101073,"_5":17389,"_23725":100992,"_2383":101074},[],"permitir o bloquear claves ECDSA;",{"_2856":59411,"_25058":59378,"_17494":101076,"_5":17389,"_23725":100992,"_2383":101077},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_2856":59412,"_25058":59378,"_17494":101079,"_5":17389,"_23725":100992,"_2383":101080},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_2856":59413,"_25058":59378,"_17494":101082,"_5":17389,"_23725":100996,"_2383":101083},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_2856":59414,"_25058":59378,"_17494":101085,"_5":17389,"_23725":100996,"_2383":96764},[],{"_2856":59415,"_25058":59378,"_17494":101087,"_5":17389,"_23725":100996,"_2383":101088},[],"Primera opción",{"_2856":59416,"_25058":59378,"_17494":101090,"_5":17389,"_23725":100996,"_2383":101091},[],"Segunda opción",{"_2856":59417,"_25058":59378,"_17494":101093,"_5":17389,"_23725":100996,"_2383":101094},[],"Si no hay ninguna",{"_2856":59418,"_25058":59378,"_17494":101096,"_5":17389,"_23725":100996,"_2383":101097},[],"Firma directa con una CA",{"_2856":59419,"_25058":59378,"_17494":101099,"_5":17389,"_23725":100996,"_2383":101100},[],"`issuance_profile` incluido en la solicitud",{"_2856":59420,"_25058":59378,"_17494":101102,"_5":17389,"_23725":100996,"_2383":101103},[],"`issuance_profile_id` de la solicitud",{"_2856":59421,"_25058":59378,"_17494":101105,"_5":17389,"_23725":100996,"_2383":101106},[],"Perfil predeterminado de la CA (`profile_id`).",{"_2856":59422,"_25058":59378,"_17494":101108,"_5":17389,"_23725":100996,"_2383":101109},[],"Emisión mediante DMS",{"_2856":59423,"_25058":59378,"_17494":101111,"_5":17389,"_23725":100996,"_2383":46317},[],{"_2856":59424,"_25058":59378,"_17494":101113,"_5":17389,"_23725":100996,"_2383":101114},[],"`settings.issuance_profile` incluido en el DMS",{"_2856":59425,"_25058":59378,"_17494":101116,"_5":17389,"_23725":100996,"_2383":101117},[],"Perfil predeterminado de la CA de enrolamiento.",{"_2856":59426,"_25058":59378,"_17494":101119,"_5":17389,"_23725":100996,"_2383":101120},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_2856":59427,"_25058":59378,"_17494":101122,"_5":17389,"_23725":100996,"_2383":101123},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_2856":59428,"_25058":59378,"_17494":101125,"_5":17389,"_23725":101004,"_2383":101126},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_2856":59429,"_25058":59378,"_17494":101128,"_5":17389,"_23725":101008,"_2383":101129},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_2856":59430,"_25058":59378,"_17494":101131,"_5":17389,"_23725":101012,"_2383":101132},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_2856":59431,"_25058":59378,"_17494":101134,"_5":17389,"_23725":101016,"_2383":101135},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_2856":59432,"_25058":59378,"_17494":101137,"_5":17389,"_23725":101020,"_2383":101138},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_2856":59433,"_25058":59378,"_17494":101140,"_5":17389,"_23725":101020,"_2383":101141},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_2856":59434,"_25058":59378,"_17494":101143,"_5":17389,"_23725":101024,"_2383":101144},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_2856":59435,"_25058":59378,"_17494":101146,"_5":17389,"_23725":101024,"_2383":101147},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_2856":59436,"_25058":59378,"_17494":101149,"_5":17389,"_23725":101024,"_2383":101150},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_2856":59437,"_25058":59378,"_17494":101152,"_5":17389,"_23725":101024,"_2383":101153},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_2856":59438,"_25058":59378,"_17494":101155,"_5":17389,"_23725":101028,"_2383":101156},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_2856":59439,"_25058":59378,"_17494":101158,"_5":17389,"_23725":101028,"_2383":101159},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_2856":59440,"_25058":59440,"_5":12268,"_2383":101161,"_25394":101162,"_17494":101164,"_23725":59440},"Validación de certificados",[40730,96973,45752,101163],"Validación",[],{"_2856":59441,"_25058":59440,"_17494":101166,"_5":17389,"_23725":59440,"_2383":101167},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_2856":59442,"_25058":59440,"_5":25391,"_17494":101169,"_23725":101170,"_2383":101171},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_2856":59443,"_25058":59440,"_5":25391,"_17494":101173,"_23725":101174,"_2383":101175},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_2856":59444,"_25058":59440,"_5":25391,"_17494":101177,"_23725":101178,"_2383":101179},[],"/docs/pr-preview/pr-44/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_2856":59445,"_25058":59440,"_17494":101181,"_5":17389,"_23725":59440,"_2383":101182},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_2856":59446,"_25058":59440,"_17494":101184,"_5":17389,"_23725":101170,"_2383":101185},[],"Verifica estos criterios juntos:",{"_2856":59447,"_25058":59440,"_17494":101187,"_5":17389,"_23725":101170,"_2383":100175},[],{"_2856":59448,"_25058":59440,"_17494":101189,"_5":17389,"_23725":101170,"_2383":101190},[],"Resultado necesario",{"_2856":59449,"_25058":59440,"_17494":101192,"_5":17389,"_23725":101170,"_2383":101193},[],"Cadena y firma",{"_2856":59450,"_25058":59440,"_17494":101195,"_5":17389,"_23725":101170,"_2383":101196},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_2856":59451,"_25058":59440,"_17494":101198,"_5":17389,"_23725":101170,"_2383":101199},[],"Fechas",{"_2856":59452,"_25058":59440,"_17494":101201,"_5":17389,"_23725":101170,"_2383":101202},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_2856":59453,"_25058":59440,"_17494":101204,"_5":17389,"_23725":101170,"_2383":96677},[],{"_2856":59454,"_25058":59440,"_17494":101206,"_5":17389,"_23725":101170,"_2383":101207},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_2856":59455,"_25058":59440,"_17494":101209,"_5":17389,"_23725":101170,"_2383":101210},[],"Uso",{"_2856":59456,"_25058":59440,"_17494":101212,"_5":17389,"_23725":101170,"_2383":101213},[],"KU, EKU y restricciones permiten la operación concreta.",{"_2856":59457,"_25058":59440,"_17494":101215,"_5":17389,"_23725":101170,"_2383":101216},[],"Revocación",{"_2856":59458,"_25058":59440,"_17494":101218,"_5":17389,"_23725":101170,"_2383":101219},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_2856":59459,"_25058":59440,"_17494":101221,"_5":17389,"_23725":101170,"_2383":101222},[],"Autorización",{"_2856":59460,"_25058":59440,"_17494":101224,"_5":17389,"_23725":101170,"_2383":101225},[],"La aplicación permite la acción a esa identidad.",{"_2856":59461,"_25058":59440,"_17494":101227,"_5":17389,"_23725":101170,"_2383":101228},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_2856":59462,"_25058":59440,"_17494":101230,"_5":17389,"_23725":101174,"_2383":101231},[],"Mecanismo",{"_2856":59463,"_25058":59440,"_17494":101233,"_5":17389,"_23725":101174,"_2383":101234},[],"Cuándo utilizarlo",{"_2856":59464,"_25058":59440,"_17494":101236,"_5":17389,"_23725":101174,"_2383":101237},[],"Qué debes mantener",{"_2856":59465,"_25058":59440,"_17494":101239,"_5":17389,"_23725":101174,"_2383":46445},[],{"_2856":59466,"_25058":59440,"_17494":101241,"_5":17389,"_23725":101174,"_2383":101242},[],"Consulta del estado de un certificado concreto.",{"_2856":59467,"_25058":59440,"_17494":101244,"_5":17389,"_23725":101174,"_2383":101245},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_2856":59468,"_25058":59440,"_17494":101247,"_5":17389,"_23725":101174,"_2383":46454},[],{"_2856":59469,"_25058":59440,"_17494":101249,"_5":17389,"_23725":101174,"_2383":101250},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_2856":59470,"_25058":59440,"_17494":101252,"_5":17389,"_23725":101174,"_2383":101253},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_2856":59471,"_25058":59440,"_17494":101255,"_5":17389,"_23725":101174,"_2383":101256},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_2856":59472,"_25058":59440,"_17494":101258,"_5":17389,"_23725":101174,"_2383":101259},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_2856":59473,"_25058":59440,"_17494":101261,"_5":17389,"_23725":101178,"_2383":101262},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_2856":59474,"_25058":59440,"_17494":101264,"_5":17389,"_23725":101178,"_2383":101265},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_2856":59475,"_25058":59440,"_17494":101267,"_5":17389,"_23725":101178,"_2383":101268},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_2856":59476,"_25058":59440,"_17494":101270,"_5":17389,"_23725":101178,"_2383":101271},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_2856":59477,"_25058":59440,"_17494":101273,"_5":17389,"_23725":101178,"_2383":101274},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_2856":59478,"_25058":59440,"_17494":101276,"_5":17389,"_23725":101178,"_2383":101277},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_2856":59479,"_25058":59440,"_17494":101279,"_5":17389,"_23725":101178,"_2383":101280},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_2856":59480,"_25058":59440,"_17494":101282,"_5":17389,"_23725":101178,"_2383":101283},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_2856":59481,"_25058":59440,"_17494":101285,"_5":17389,"_23725":101178,"_2383":101286},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_2856":59482,"_25058":59482,"_5":12268,"_2383":101288,"_25394":101289,"_17494":101290,"_23725":59482},"Certificados",[40730,96973,45752,100548],[],{"_2856":59483,"_25058":59482,"_17494":101292,"_5":17389,"_23725":59482,"_2383":101293},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_2856":59484,"_25058":59482,"_5":25391,"_17494":101295,"_23725":101296,"_2383":101297},[],"/docs/pr-preview/pr-44/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_2856":59485,"_25058":59482,"_5":25391,"_17494":101299,"_23725":101300,"_2383":101301},[],"/docs/pr-preview/pr-44/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_2856":59486,"_25058":59482,"_5":25391,"_17494":101303,"_23725":101304,"_2383":101305},[],"/docs/pr-preview/pr-44/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_2856":59487,"_25058":59482,"_5":25391,"_17494":101307,"_23725":101308,"_2383":101309},[],"/docs/pr-preview/pr-44/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_2856":59488,"_25058":59482,"_5":25391,"_17494":101311,"_23725":101312,"_2383":101313},[],"/docs/pr-preview/pr-44/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_2856":59489,"_25058":59482,"_5":25391,"_17494":101315,"_23725":101316,"_2383":101317},[],"/docs/pr-preview/pr-44/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_2856":59490,"_25058":59482,"_5":25391,"_17494":101319,"_23725":101320,"_2383":101321},[],"/docs/pr-preview/pr-44/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_2856":59491,"_25058":59482,"_5":25391,"_17494":101323,"_23725":101324,"_2383":101325},[],"/docs/pr-preview/pr-44/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_2856":59492,"_25058":59482,"_5":25391,"_17494":101327,"_23725":101328,"_2383":101329},[],"/docs/pr-preview/pr-44/es/platform/pki/certificates#continúa","Continúa",{"_2856":59493,"_25058":59482,"_17494":101331,"_5":17389,"_23725":59482,"_2383":101332},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_2856":59494,"_25058":59482,"_17494":101334,"_5":17389,"_23725":101296,"_2383":101335},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_2856":59495,"_25058":59482,"_17494":101337,"_5":17389,"_23725":101296,"_2383":101338},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_2856":59496,"_25058":59482,"_17494":101340,"_5":17389,"_23725":101300,"_2383":101341},[],"Descarga el PEM e inspecciónalo:",{"_2856":59497,"_25058":59482,"_17494":101343,"_5":17389,"_23725":101300,"_2383":101344},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_2856":59498,"_25058":59482,"_17494":101346,"_5":17389,"_23725":101304,"_2383":101347},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_2856":59499,"_25058":59482,"_17494":101349,"_5":17389,"_23725":101304,"_2383":101350},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_2856":59500,"_25058":59482,"_17494":101352,"_5":17389,"_23725":101304,"_2383":101353},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_2856":59501,"_25058":59482,"_17494":101355,"_5":17389,"_23725":101304,"_2383":101356},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_2856":59502,"_25058":59482,"_17494":101358,"_5":17389,"_23725":101304,"_2383":101359},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_2856":59503,"_25058":59482,"_17494":101361,"_5":17389,"_23725":101304,"_2383":101362},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_2856":59504,"_25058":59482,"_17494":101364,"_5":17389,"_23725":101304,"_2383":101365},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_2856":59505,"_25058":59482,"_17494":101367,"_5":17389,"_23725":101308,"_2383":101368},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_2856":59506,"_25058":59482,"_17494":101370,"_5":17389,"_23725":101312,"_2383":101371},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_2856":59507,"_25058":59482,"_17494":101373,"_5":17389,"_23725":101316,"_2383":101374},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_2856":59508,"_25058":59482,"_17494":101376,"_5":17389,"_23725":101320,"_2383":101377},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_2856":59509,"_25058":59482,"_17494":101379,"_5":17389,"_23725":101320,"_2383":101380},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_2856":59510,"_25058":59482,"_17494":101382,"_5":17389,"_23725":101320,"_2383":101383},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_2856":59511,"_25058":59482,"_17494":101385,"_5":17389,"_23725":101324,"_2383":101386},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_2856":59512,"_25058":59482,"_17494":101388,"_5":17389,"_23725":101324,"_2383":101389},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_2856":59513,"_25058":59482,"_17494":101391,"_5":17389,"_23725":101324,"_2383":101392},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_2856":59514,"_25058":59482,"_17494":101394,"_5":17389,"_23725":101328,"_2383":101395},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_2856":59515,"_25058":59482,"_17494":101397,"_5":17389,"_23725":101328,"_2383":101398},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_2856":59516,"_25058":59516,"_5":12268,"_2383":101400,"_25394":101401,"_17494":101403,"_23725":59516},"Ciclo de vida de un certificado",[40730,96973,45752,101402],"Conceptos",[],{"_2856":59517,"_25058":59516,"_17494":101405,"_5":17389,"_23725":59516,"_2383":101406},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_2856":59518,"_25058":59516,"_5":25391,"_17494":101408,"_23725":101409,"_2383":101410},[],"/docs/pr-preview/pr-44/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_2856":59519,"_25058":59516,"_5":25391,"_17494":101412,"_23725":101413,"_2383":101414},[],"/docs/pr-preview/pr-44/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_2856":59520,"_25058":59516,"_5":25391,"_17494":101416,"_23725":101417,"_2383":101418},[],"/docs/pr-preview/pr-44/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_2856":59521,"_25058":59516,"_5":25391,"_17494":101420,"_23725":101421,"_2383":101422},[],"/docs/pr-preview/pr-44/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_2856":59522,"_25058":59516,"_5":25391,"_17494":101424,"_23725":101425,"_2383":101426},[],"/docs/pr-preview/pr-44/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_2856":59523,"_25058":59516,"_5":25391,"_17494":101428,"_23725":101429,"_2383":101430},[],"/docs/pr-preview/pr-44/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_2856":59524,"_25058":59516,"_5":25391,"_17494":101432,"_23725":101433,"_2383":101434},[],"/docs/pr-preview/pr-44/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_2856":59525,"_25058":59516,"_5":25391,"_17494":101436,"_23725":101437,"_2383":101438},[],"/docs/pr-preview/pr-44/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_2856":59526,"_25058":59516,"_5":25391,"_17494":101440,"_23725":101441,"_2383":101442},[],"/docs/pr-preview/pr-44/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_2856":59527,"_25058":59516,"_5":25391,"_17494":101444,"_23725":101445,"_2383":101446},[],"/docs/pr-preview/pr-44/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_2856":59528,"_25058":59516,"_17494":101448,"_5":17389,"_23725":59516,"_2383":101449},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_2856":59529,"_25058":59516,"_17494":101451,"_5":17389,"_23725":101413,"_2383":101452},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_2856":59530,"_25058":59516,"_17494":101454,"_5":17389,"_23725":101417,"_2383":101455},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_2856":59531,"_25058":59516,"_17494":101457,"_5":17389,"_23725":101421,"_2383":101458},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_2856":59532,"_25058":59516,"_17494":101460,"_5":17389,"_23725":101425,"_2383":101461},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_2856":59533,"_25058":59516,"_17494":101463,"_5":17389,"_23725":101429,"_2383":101464},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_2856":59534,"_25058":59516,"_17494":101466,"_5":17389,"_23725":101433,"_2383":101467},[],"Lamassu persiste cuatro estados X.509:",{"_2856":59535,"_25058":59516,"_17494":101469,"_5":17389,"_23725":101433,"_2383":101470},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_2856":59536,"_25058":59516,"_17494":101472,"_5":17389,"_23725":101433,"_2383":101473},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_2856":59537,"_25058":59516,"_17494":101475,"_5":17389,"_23725":101433,"_2383":101476},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_2856":59538,"_25058":59516,"_17494":101478,"_5":17389,"_23725":101433,"_2383":101479},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_2856":59539,"_25058":59516,"_17494":101481,"_5":17389,"_23725":101433,"_2383":101482},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_2856":59540,"_25058":59516,"_17494":101484,"_5":17389,"_23725":101437,"_2383":101485},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_2856":59541,"_25058":59516,"_17494":101487,"_5":17389,"_23725":101437,"_2383":101488},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_2856":59542,"_25058":59516,"_17494":101490,"_5":17389,"_23725":101437,"_2383":101491},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_2856":59543,"_25058":59516,"_17494":101493,"_5":17389,"_23725":101441,"_2383":101494},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_2856":59544,"_25058":59516,"_17494":101496,"_5":17389,"_23725":101441,"_2383":101497},[],"Antes de confirmar:",{"_2856":59545,"_25058":59516,"_17494":101499,"_5":17389,"_23725":101441,"_2383":101500},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_2856":59546,"_25058":59516,"_17494":101502,"_5":17389,"_23725":101441,"_2383":101503},[],"Distribuye la nueva cadena de confianza.",{"_2856":59547,"_25058":59516,"_17494":101505,"_5":17389,"_23725":101441,"_2383":101506},[],"Reemite las identidades necesarias.",{"_2856":59548,"_25058":59516,"_17494":101508,"_5":17389,"_23725":101441,"_2383":101509},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_2856":59549,"_25058":59516,"_17494":101511,"_5":17389,"_23725":101441,"_2383":101512},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_2856":59550,"_25058":59516,"_17494":101514,"_5":17389,"_23725":101441,"_2383":101515},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_2856":59551,"_25058":59516,"_17494":101517,"_5":17389,"_23725":101445,"_2383":101518},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_2856":59552,"_25058":59516,"_17494":101520,"_5":17389,"_23725":101445,"_2383":101521},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_2856":59553,"_25058":59516,"_17494":101523,"_5":17389,"_23725":101445,"_2383":101524},[],"Cambios de estado y razones de revocación.",{"_2856":59554,"_25058":59516,"_17494":101526,"_5":17389,"_23725":101445,"_2383":101527},[],"Publicación y vigencia de OCSP y CRLs.",{"_2856":59555,"_25058":59516,"_17494":101529,"_5":17389,"_23725":101445,"_2383":101530},[],"Dependencias que todavía presentan un certificado sustituido.",{"_2856":59556,"_25058":59516,"_17494":101532,"_5":17389,"_23725":101445,"_2383":101533},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_2856":59557,"_25058":59557,"_5":12268,"_2383":101535,"_25394":101536,"_17494":101537,"_23725":59557},"Modelo de confianza",[40730,96973,45752,101402],[],{"_2856":59558,"_25058":59557,"_17494":101539,"_5":17389,"_23725":59557,"_2383":101540},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_2856":59559,"_25058":59557,"_5":25391,"_17494":101542,"_23725":101543,"_2383":101544},[],"/docs/pr-preview/pr-44/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_2856":59560,"_25058":59557,"_5":25391,"_17494":101546,"_23725":101547,"_2383":101548},[],"/docs/pr-preview/pr-44/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_2856":59561,"_25058":59557,"_5":25391,"_17494":101550,"_23725":101551,"_2383":101552},[],"/docs/pr-preview/pr-44/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_2856":59562,"_25058":59557,"_5":25391,"_17494":101554,"_23725":101555,"_2383":101556},[],"/docs/pr-preview/pr-44/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_2856":59563,"_25058":59557,"_5":25391,"_17494":101558,"_23725":101559,"_2383":101560},[],"/docs/pr-preview/pr-44/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_2856":59564,"_25058":59557,"_5":25391,"_17494":101562,"_23725":101563,"_2383":101564},[],"/docs/pr-preview/pr-44/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_2856":59565,"_25058":59557,"_5":25391,"_17494":101566,"_23725":101567,"_2383":101568},[],"/docs/pr-preview/pr-44/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_2856":59566,"_25058":59557,"_5":25391,"_17494":101570,"_23725":101571,"_2383":101572},[],"/docs/pr-preview/pr-44/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_2856":59567,"_25058":59557,"_5":25391,"_17494":101574,"_23725":101575,"_2383":101576},[],"/docs/pr-preview/pr-44/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_2856":59568,"_25058":59557,"_5":25391,"_17494":101578,"_23725":101579,"_2383":101580},[],"/docs/pr-preview/pr-44/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_2856":59569,"_25058":59557,"_17494":101582,"_5":17389,"_23725":59557,"_2383":101583},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_2856":59570,"_25058":59557,"_17494":101585,"_5":17389,"_23725":101547,"_2383":101586},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_2856":59571,"_25058":59557,"_17494":101588,"_5":17389,"_23725":101551,"_2383":101589},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_2856":59572,"_25058":59557,"_17494":101591,"_5":17389,"_23725":101555,"_2383":101592},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_2856":59573,"_25058":59557,"_17494":101594,"_5":17389,"_23725":101559,"_2383":101595},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_2856":59574,"_25058":59557,"_17494":101597,"_5":17389,"_23725":101563,"_2383":101598},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_2856":59575,"_25058":59557,"_17494":101600,"_5":17389,"_23725":101563,"_2383":101601},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_2856":59576,"_25058":59557,"_17494":101603,"_5":17389,"_23725":101563,"_2383":101604},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_2856":59577,"_25058":59557,"_17494":101606,"_5":17389,"_23725":101563,"_2383":101607},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_2856":59578,"_25058":59557,"_17494":101609,"_5":17389,"_23725":101563,"_2383":101610},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_2856":59579,"_25058":59557,"_17494":101612,"_5":17389,"_23725":101563,"_2383":101613},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_2856":59580,"_25058":59557,"_17494":101615,"_5":17389,"_23725":101567,"_2383":101616},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_2856":59581,"_25058":59557,"_17494":101618,"_5":17389,"_23725":101567,"_2383":101619},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_2856":59582,"_25058":59557,"_17494":101621,"_5":17389,"_23725":101567,"_2383":101622},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación adicionales.",{"_2856":59583,"_25058":59557,"_17494":101624,"_5":17389,"_23725":101567,"_2383":101625},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_2856":59584,"_25058":59557,"_17494":101627,"_5":17389,"_23725":101567,"_2383":101628},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_2856":59585,"_25058":59557,"_17494":101630,"_5":17389,"_23725":101571,"_2383":101631},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_2856":59586,"_25058":59557,"_17494":101633,"_5":17389,"_23725":101571,"_2383":101634},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_2856":59587,"_25058":59557,"_17494":101636,"_5":17389,"_23725":101571,"_2383":101637},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_2856":59588,"_25058":59557,"_17494":101639,"_5":17389,"_23725":101571,"_2383":101640},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_2856":59589,"_25058":59557,"_17494":101642,"_5":17389,"_23725":101571,"_2383":101643},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_2856":59590,"_25058":59557,"_17494":101645,"_5":17389,"_23725":101571,"_2383":101646},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_2856":59591,"_25058":59557,"_17494":101648,"_5":17389,"_23725":101571,"_2383":101649},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_2856":59592,"_25058":59557,"_17494":101651,"_5":17389,"_23725":101575,"_2383":101652},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_2856":59593,"_25058":59557,"_17494":101654,"_5":17389,"_23725":101579,"_2383":101655},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_2856":59594,"_25058":59557,"_17494":101657,"_5":17389,"_23725":101579,"_2383":101658},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_2856":59595,"_25058":59557,"_17494":101660,"_5":17389,"_23725":101579,"_2383":101661},[],"Asigna perfiles explícitos a cada caso de uso.",{"_2856":59596,"_25058":59557,"_17494":101663,"_5":17389,"_23725":101579,"_2383":101664},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_2856":59597,"_25058":59557,"_17494":101666,"_5":17389,"_23725":101579,"_2383":101667},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_2856":59598,"_25058":59557,"_17494":101669,"_5":17389,"_23725":101579,"_2383":101670},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_2856":59599,"_25058":59557,"_17494":101672,"_5":17389,"_23725":101579,"_2383":101673},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_2856":59600,"_25058":59600,"_5":12268,"_2383":101675,"_25394":101676,"_17494":101677,"_23725":59600},"Listas de revocación (CRL)",[40730,96973,45752,101163],[],{"_2856":59601,"_25058":59600,"_17494":101679,"_5":17389,"_23725":59600,"_2383":101680},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_2856":59602,"_25058":59600,"_5":25391,"_17494":101682,"_23725":101683,"_2383":101684},[],"/docs/pr-preview/pr-44/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_2856":59603,"_25058":59600,"_5":25391,"_17494":101686,"_23725":101687,"_2383":101688},[],"/docs/pr-preview/pr-44/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_2856":59604,"_25058":59600,"_5":25391,"_17494":101690,"_23725":101691,"_2383":101692},[],"/docs/pr-preview/pr-44/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_2856":59605,"_25058":59600,"_5":25391,"_17494":101694,"_23725":101695,"_2383":101696},[],"/docs/pr-preview/pr-44/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_2856":59606,"_25058":59600,"_5":25391,"_17494":101698,"_23725":101699,"_2383":101700},[],"/docs/pr-preview/pr-44/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_2856":59607,"_25058":59600,"_5":25391,"_17494":101702,"_23725":101703,"_2383":101704},[],"/docs/pr-preview/pr-44/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_2856":59608,"_25058":59600,"_5":25391,"_17494":101706,"_23725":101707,"_2383":101708},[],"/docs/pr-preview/pr-44/es/platform/pki/crl#referencias","Referencias",{"_2856":59609,"_25058":59600,"_17494":101710,"_5":17389,"_23725":59600,"_2383":101711},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_2856":59610,"_25058":59600,"_17494":101713,"_5":17389,"_23725":101683,"_2383":101714},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_2856":59611,"_25058":59600,"_17494":101716,"_5":17389,"_23725":101683,"_2383":101717},[],"Campo de `crl_options`",{"_2856":59612,"_25058":59600,"_17494":101719,"_5":17389,"_23725":101683,"_2383":98466},[],{"_2856":59613,"_25058":59600,"_17494":101721,"_5":17389,"_23725":101683,"_2383":101722},[],"Valor inicial del backend",{"_2856":59614,"_25058":59600,"_17494":101724,"_5":17389,"_23725":101683,"_2383":46932},[],{"_2856":59615,"_25058":59600,"_17494":101726,"_5":17389,"_23725":101683,"_2383":101727},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_2856":59616,"_25058":59600,"_17494":101729,"_5":17389,"_23725":101683,"_2383":101730},[],"7 días.",{"_2856":59617,"_25058":59600,"_17494":101732,"_5":17389,"_23725":101683,"_2383":46941},[],{"_2856":59618,"_25058":59600,"_17494":101734,"_5":17389,"_23725":101683,"_2383":101735},[],"Plazo desde la publicación que activa la renovación programada.",{"_2856":59619,"_25058":59600,"_17494":101737,"_5":17389,"_23725":101683,"_2383":101738},[],"6 días y 23 horas.",{"_2856":59620,"_25058":59600,"_17494":101740,"_5":17389,"_23725":101683,"_2383":46950},[],{"_2856":59621,"_25058":59600,"_17494":101742,"_5":17389,"_23725":101683,"_2383":101743},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_2856":59622,"_25058":59600,"_17494":101745,"_5":17389,"_23725":101683,"_2383":46956},[],{"_2856":59623,"_25058":59600,"_17494":101747,"_5":17389,"_23725":101683,"_2383":46959},[],{"_2856":59624,"_25058":59600,"_17494":101749,"_5":17389,"_23725":101683,"_2383":101750},[],"Campo de configuración inicializado con el SKI de la CA.",{"_2856":59625,"_25058":59600,"_17494":101752,"_5":17389,"_23725":101683,"_2383":101753},[],"SKI de la CA.",{"_2856":59626,"_25058":59600,"_17494":101755,"_5":17389,"_23725":101683,"_2383":101756},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_2856":59627,"_25058":59600,"_17494":101758,"_5":17389,"_23725":101683,"_2383":101759},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_2856":59628,"_25058":59600,"_17494":101761,"_5":17389,"_23725":101687,"_2383":101762},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_2856":59629,"_25058":59600,"_17494":101764,"_5":17389,"_23725":101687,"_2383":101765},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_2856":59630,"_25058":59600,"_17494":101767,"_5":17389,"_23725":101687,"_2383":101768},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_2856":59631,"_25058":59600,"_17494":101770,"_5":17389,"_23725":101691,"_2383":101771},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_2856":59632,"_25058":59600,"_17494":101773,"_5":17389,"_23725":101691,"_2383":101774},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_2856":59633,"_25058":59600,"_17494":101776,"_5":17389,"_23725":101695,"_2383":101777},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_2856":59634,"_25058":59600,"_17494":101779,"_5":17389,"_23725":101695,"_2383":101780},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_2856":59635,"_25058":59600,"_17494":101782,"_5":17389,"_23725":101695,"_2383":101783},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_2856":59636,"_25058":59600,"_17494":101785,"_5":17389,"_23725":101695,"_2383":101786},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_2856":59637,"_25058":59600,"_17494":101788,"_5":17389,"_23725":101695,"_2383":101789},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_2856":59638,"_25058":59600,"_17494":101791,"_5":17389,"_23725":101699,"_2383":101792},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_2856":59639,"_25058":59600,"_17494":101794,"_5":17389,"_23725":101699,"_2383":98655},[],{"_2856":59640,"_25058":59600,"_17494":101796,"_5":17389,"_23725":101699,"_2383":101797},[],"Path relativo",{"_2856":59641,"_25058":59600,"_17494":101799,"_5":17389,"_23725":101699,"_2383":96764},[],{"_2856":59642,"_25058":59600,"_17494":101801,"_5":17389,"_23725":101699,"_2383":47014},[],{"_2856":59643,"_25058":59600,"_17494":101803,"_5":17389,"_23725":101699,"_2383":47017},[],{"_2856":59644,"_25058":59600,"_17494":101805,"_5":17389,"_23725":101699,"_2383":101806},[],"Consultar `crl_options` y `latest_crl`.",{"_2856":59645,"_25058":59600,"_17494":101808,"_5":17389,"_23725":101699,"_2383":47023},[],{"_2856":59646,"_25058":59600,"_17494":101810,"_5":17389,"_23725":101699,"_2383":47017},[],{"_2856":59647,"_25058":59600,"_17494":101812,"_5":17389,"_23725":101699,"_2383":101813},[],"Sustituir la configuración de CRL.",{"_2856":59648,"_25058":59600,"_17494":101815,"_5":17389,"_23725":101699,"_2383":101816},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_2856":59649,"_25058":59600,"_17494":101818,"_5":17389,"_23725":101699,"_2383":101819},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_2856":59650,"_25058":59600,"_17494":101821,"_5":17389,"_23725":101703,"_2383":101822},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_2856":59651,"_25058":59600,"_17494":101824,"_5":17389,"_23725":101707,"_2383":101825},[],"RFC 5280: perfil X.509 y CRL.",{"_2856":59652,"_25058":59600,"_17494":101827,"_5":17389,"_23725":101707,"_2383":47043},[],{"_2856":59653,"_25058":59600,"_17494":101829,"_5":17389,"_23725":101707,"_2383":47046},[],{"_2856":59654,"_25058":59600,"_17494":101831,"_5":17389,"_23725":101707,"_2383":101832},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_2856":59655,"_25058":59600,"_17494":101834,"_5":17389,"_23725":101707,"_2383":101835},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2856":59656,"_25058":59656,"_5":12268,"_2383":101837,"_25394":101838,"_17494":101839,"_23725":59656},"Claves y motores criptográficos",[40730,96973,45752,100548],[],{"_2856":59657,"_25058":59656,"_17494":101841,"_5":17389,"_23725":59656,"_2383":101842},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_2856":59658,"_25058":59656,"_5":25391,"_17494":101844,"_23725":101845,"_2383":101846},[],"/docs/pr-preview/pr-44/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_2856":59659,"_25058":59656,"_5":25391,"_17494":101848,"_23725":101849,"_2383":101850},[],"/docs/pr-preview/pr-44/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_2856":59660,"_25058":59656,"_5":25391,"_17494":101852,"_23725":101853,"_2383":47071},[],"/docs/pr-preview/pr-44/es/platform/pki/key-management#file-system",{"_2856":59661,"_25058":59656,"_5":25391,"_17494":101855,"_23725":101856,"_2383":47075},[],"/docs/pr-preview/pr-44/es/platform/pki/key-management#hashicorp-vault",{"_2856":59662,"_25058":59656,"_5":25391,"_17494":101858,"_23725":101859,"_2383":47079},[],"/docs/pr-preview/pr-44/es/platform/pki/key-management#aws-secrets-manager",{"_2856":59663,"_25058":59656,"_5":25391,"_17494":101861,"_23725":101862,"_2383":47083},[],"/docs/pr-preview/pr-44/es/platform/pki/key-management#aws-kms",{"_2856":59664,"_25058":59656,"_5":25391,"_17494":101864,"_23725":101865,"_2383":47087},[],"/docs/pr-preview/pr-44/es/platform/pki/key-management#pkcs11",{"_2856":59665,"_25058":59656,"_5":25391,"_17494":101867,"_23725":101868,"_2383":47091},[],"/docs/pr-preview/pr-44/es/platform/pki/key-management#azure-key-vault",{"_2856":59666,"_25058":59656,"_5":25391,"_17494":101870,"_23725":101871,"_2383":101872},[],"/docs/pr-preview/pr-44/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_2856":59667,"_25058":59656,"_5":25391,"_17494":101874,"_23725":101875,"_2383":101876},[],"/docs/pr-preview/pr-44/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_2856":59668,"_25058":59656,"_5":25391,"_17494":101878,"_23725":101879,"_2383":101880},[],"/docs/pr-preview/pr-44/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_2856":59669,"_25058":59656,"_5":25391,"_17494":101882,"_23725":101883,"_2383":101884},[],"/docs/pr-preview/pr-44/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_2856":59670,"_25058":59656,"_5":25391,"_17494":101886,"_23725":101887,"_2383":101888},[],"/docs/pr-preview/pr-44/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_2856":59671,"_25058":59656,"_5":25391,"_17494":101890,"_23725":101891,"_2383":101892},[],"/docs/pr-preview/pr-44/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_2856":59672,"_25058":59656,"_5":25391,"_17494":101894,"_23725":101895,"_2383":101896},[],"/docs/pr-preview/pr-44/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_2856":59673,"_25058":59656,"_5":25391,"_17494":101898,"_23725":101899,"_2383":47123},[],"/docs/pr-preview/pr-44/es/platform/pki/key-management#sign",{"_2856":59674,"_25058":59656,"_5":25391,"_17494":101901,"_23725":101902,"_2383":47127},[],"/docs/pr-preview/pr-44/es/platform/pki/key-management#verify",{"_2856":59675,"_25058":59656,"_5":25391,"_17494":101904,"_23725":101905,"_2383":101906},[],"/docs/pr-preview/pr-44/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_2856":59676,"_25058":59656,"_5":25391,"_17494":101908,"_23725":101909,"_2383":101910},[],"/docs/pr-preview/pr-44/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_2856":59677,"_25058":59656,"_5":25391,"_17494":101912,"_23725":101913,"_2383":101914},[],"/docs/pr-preview/pr-44/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_2856":59678,"_25058":59656,"_17494":101916,"_5":17389,"_23725":59656,"_2383":101917},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_2856":59679,"_25058":59656,"_17494":101919,"_5":17389,"_23725":59656,"_2383":101920},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_2856":59680,"_25058":59656,"_17494":101922,"_5":17389,"_23725":101845,"_2383":101923},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_2856":59681,"_25058":59656,"_17494":101925,"_5":17389,"_23725":101845,"_2383":101926},[],"En la práctica, permite:",{"_2856":59682,"_25058":59656,"_17494":101928,"_5":17389,"_23725":101845,"_2383":101929},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_2856":59683,"_25058":59656,"_17494":101931,"_5":17389,"_23725":101845,"_2383":101932},[],"Importar claves creadas externamente.",{"_2856":59684,"_25058":59656,"_17494":101934,"_5":17389,"_23725":101845,"_2383":101935},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_2856":59685,"_25058":59656,"_17494":101937,"_5":17389,"_23725":101845,"_2383":101938},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_2856":59686,"_25058":59656,"_17494":101940,"_5":17389,"_23725":101849,"_2383":101941},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_2856":59687,"_25058":59656,"_17494":101943,"_5":17389,"_23725":101849,"_2383":101944},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_2856":59688,"_25058":59656,"_17494":101946,"_5":17389,"_23725":101849,"_2383":101947},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_2856":59689,"_25058":59656,"_17494":101949,"_5":17389,"_23725":101853,"_2383":101950},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_2856":59690,"_25058":59656,"_17494":101952,"_5":17389,"_23725":101856,"_2383":101953},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_2856":59691,"_25058":59656,"_17494":101955,"_5":17389,"_23725":101859,"_2383":101956},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_2856":59692,"_25058":59656,"_17494":101958,"_5":17389,"_23725":101862,"_2383":101959},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_2856":59693,"_25058":59656,"_17494":101961,"_5":17389,"_23725":101865,"_2383":101962},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_2856":59694,"_25058":59656,"_17494":101964,"_5":17389,"_23725":101868,"_2383":101965},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_2856":59695,"_25058":59656,"_17494":101967,"_5":17389,"_23725":101868,"_2383":101968},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_2856":59696,"_25058":59656,"_17494":101970,"_5":17389,"_23725":101868,"_2383":101971},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_2856":59697,"_25058":59656,"_17494":101973,"_5":17389,"_23725":101868,"_2383":101974},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_2856":59698,"_25058":59656,"_17494":101976,"_5":17389,"_23725":101871,"_2383":101977},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_2856":59699,"_25058":59656,"_17494":101979,"_5":17389,"_23725":101871,"_2383":101980},[],"La tabla incluye los siguientes campos:",{"_2856":59700,"_25058":59656,"_17494":101982,"_5":17389,"_23725":101871,"_2383":101983},[],"**Name**: nombre descriptivo de la clave.",{"_2856":59701,"_25058":59656,"_17494":101985,"_5":17389,"_23725":101871,"_2383":101986},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_2856":59702,"_25058":59656,"_17494":101988,"_5":17389,"_23725":101871,"_2383":101989},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_2856":59703,"_25058":59656,"_17494":101991,"_5":17389,"_23725":101871,"_2383":101992},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_2856":59704,"_25058":59656,"_17494":101994,"_5":17389,"_23725":101871,"_2383":101995},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_2856":59705,"_25058":59656,"_17494":101997,"_5":17389,"_23725":101871,"_2383":101998},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_2856":59706,"_25058":59656,"_17494":102000,"_5":17389,"_23725":101871,"_2383":102001},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_2856":59707,"_25058":59656,"_17494":102003,"_5":17389,"_23725":101871,"_2383":102004},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_2856":59708,"_25058":59656,"_17494":102006,"_5":17389,"_23725":101871,"_2383":102007},[],"Desde esta vista también se accede a las acciones más habituales:",{"_2856":59709,"_25058":59656,"_17494":102009,"_5":17389,"_23725":101871,"_2383":102010},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_2856":59710,"_25058":59656,"_17494":102012,"_5":17389,"_23725":101871,"_2383":102013},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_2856":59711,"_25058":59656,"_17494":102015,"_5":17389,"_23725":101871,"_2383":102016},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_2856":59712,"_25058":59656,"_17494":102018,"_5":17389,"_23725":101871,"_2383":102019},[],"**Delete Key** para eliminar la clave del sistema.",{"_2856":59713,"_25058":59656,"_17494":102021,"_5":17389,"_23725":101875,"_2383":102022},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_2856":59714,"_25058":59656,"_17494":102024,"_5":17389,"_23725":101879,"_2383":102025},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_2856":59715,"_25058":59656,"_17494":102027,"_5":17389,"_23725":101879,"_2383":102028},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_2856":59716,"_25058":59656,"_17494":102030,"_5":17389,"_23725":101879,"_2383":102031},[],"**Key Name**: nombre único y descriptivo.",{"_2856":59717,"_25058":59656,"_17494":102033,"_5":17389,"_23725":101879,"_2383":102034},[],"**Crypto Engine**: motor que custodiará la clave.",{"_2856":59718,"_25058":59656,"_17494":102036,"_5":17389,"_23725":101879,"_2383":102037},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_2856":59719,"_25058":59656,"_17494":102039,"_5":17389,"_23725":101879,"_2383":102040},[],"**Tags**: metadatos para clasificar la clave.",{"_2856":59720,"_25058":59656,"_17494":102042,"_5":17389,"_23725":101879,"_2383":102043},[],"**Metadata**: información adicional para usos avanzados.",{"_2856":59721,"_25058":59656,"_17494":102045,"_5":17389,"_23725":101883,"_2383":102046},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_2856":59722,"_25058":59656,"_17494":102048,"_5":17389,"_23725":101883,"_2383":102049},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_2856":59723,"_25058":59656,"_17494":102051,"_5":17389,"_23725":101883,"_2383":102052},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_2856":59724,"_25058":59656,"_17494":102054,"_5":17389,"_23725":101883,"_2383":102055},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_2856":59725,"_25058":59656,"_17494":102057,"_5":17389,"_23725":101883,"_2383":102058},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_2856":59726,"_25058":59656,"_17494":102060,"_5":17389,"_23725":101883,"_2383":102061},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_2856":59727,"_25058":59656,"_17494":102063,"_5":17389,"_23725":101883,"_2383":102064},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_2856":59728,"_25058":59656,"_17494":102066,"_5":17389,"_23725":101883,"_2383":102067},[],"**Tags**: etiquetas para organización y búsqueda.",{"_2856":59729,"_25058":59656,"_17494":102069,"_5":17389,"_23725":101883,"_2383":102070},[],"**Metadata**: información adicional opcional.",{"_2856":59730,"_25058":59656,"_17494":102072,"_5":17389,"_23725":101883,"_2383":102073},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_2856":59731,"_25058":59656,"_17494":102075,"_5":17389,"_23725":101883,"_2383":102076},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_2856":59732,"_25058":59656,"_17494":102078,"_5":17389,"_23725":101887,"_2383":102079},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_2856":59733,"_25058":59656,"_17494":102081,"_5":17389,"_23725":101891,"_2383":102082},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_2856":59734,"_25058":59656,"_17494":102084,"_5":17389,"_23725":101891,"_2383":102085},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_2856":59735,"_25058":59656,"_17494":102087,"_5":17389,"_23725":101891,"_2383":102088},[],"**Key Name**: nombre descriptivo.",{"_2856":59736,"_25058":59656,"_17494":102090,"_5":17389,"_23725":101891,"_2383":102091},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_2856":59737,"_25058":59656,"_17494":102093,"_5":17389,"_23725":101891,"_2383":102094},[],"**Tags**: etiquetas asociadas.",{"_2856":59738,"_25058":59656,"_17494":102096,"_5":17389,"_23725":101891,"_2383":102097},[],"**Aliases**: nombres alternativos.",{"_2856":59739,"_25058":59656,"_17494":102099,"_5":17389,"_23725":101891,"_2383":102100},[],"**Crypto Engine**: motor en el que reside la clave.",{"_2856":59740,"_25058":59656,"_17494":102102,"_5":17389,"_23725":101891,"_2383":102103},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_2856":59741,"_25058":59656,"_17494":102105,"_5":17389,"_23725":101891,"_2383":102106},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_2856":59742,"_25058":59656,"_17494":102108,"_5":17389,"_23725":101891,"_2383":102109},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_2856":59743,"_25058":59656,"_17494":102111,"_5":17389,"_23725":101895,"_2383":102112},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_2856":59744,"_25058":59656,"_17494":102114,"_5":17389,"_23725":101895,"_2383":102115},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_2856":59745,"_25058":59656,"_17494":102117,"_5":17389,"_23725":101895,"_2383":102118},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_2856":59746,"_25058":59656,"_17494":102120,"_5":17389,"_23725":101899,"_2383":102121},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_2856":59747,"_25058":59656,"_17494":102123,"_5":17389,"_23725":101899,"_2383":102124},[],"Campos principales:",{"_2856":59748,"_25058":59656,"_17494":102126,"_5":17389,"_23725":101899,"_2383":102127},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_2856":59749,"_25058":59656,"_17494":102129,"_5":17389,"_23725":101899,"_2383":102130},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_2856":59750,"_25058":59656,"_17494":102132,"_5":17389,"_23725":101899,"_2383":102133},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_2856":59751,"_25058":59656,"_17494":102135,"_5":17389,"_23725":101899,"_2383":102136},[],"**Message**: contenido que se va a firmar.",{"_2856":59752,"_25058":59656,"_17494":102138,"_5":17389,"_23725":101899,"_2383":102139},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_2856":59753,"_25058":59656,"_17494":102141,"_5":17389,"_23725":101902,"_2383":102142},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_2856":59754,"_25058":59656,"_17494":102144,"_5":17389,"_23725":101902,"_2383":102124},[],{"_2856":59755,"_25058":59656,"_17494":102146,"_5":17389,"_23725":101902,"_2383":102147},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_2856":59756,"_25058":59656,"_17494":102149,"_5":17389,"_23725":101902,"_2383":102150},[],"**Message Type**: `Raw` o `Digest`.",{"_2856":59757,"_25058":59656,"_17494":102152,"_5":17389,"_23725":101902,"_2383":102153},[],"**Payload Encoding**: codificación del mensaje.",{"_2856":59758,"_25058":59656,"_17494":102155,"_5":17389,"_23725":101902,"_2383":102156},[],"**Message**: mensaje original o hash.",{"_2856":59759,"_25058":59656,"_17494":102158,"_5":17389,"_23725":101902,"_2383":102159},[],"**Signature**: firma que se desea comprobar.",{"_2856":59760,"_25058":59656,"_17494":102161,"_5":17389,"_23725":101902,"_2383":102162},[],"**Result**: indicador del resultado de la validación.",{"_2856":59761,"_25058":59656,"_17494":102164,"_5":17389,"_23725":101905,"_2383":102165},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_2856":59762,"_25058":59656,"_17494":102167,"_5":17389,"_23725":101905,"_2383":102168},[],"Este flujo es útil para:",{"_2856":59763,"_25058":59656,"_17494":102170,"_5":17389,"_23725":101905,"_2383":102171},[],"Solicitar certificados a una CA externa.",{"_2856":59764,"_25058":59656,"_17494":102173,"_5":17389,"_23725":101905,"_2383":102174},[],"Renovar una identidad manteniendo la misma clave.",{"_2856":59765,"_25058":59656,"_17494":102176,"_5":17389,"_23725":101905,"_2383":102177},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_2856":59766,"_25058":59656,"_17494":102179,"_5":17389,"_23725":101905,"_2383":102180},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_2856":59767,"_25058":59656,"_17494":102182,"_5":17389,"_23725":101905,"_2383":102183},[],"**Organization (O)**: organización o empresa.",{"_2856":59768,"_25058":59656,"_17494":102185,"_5":17389,"_23725":101905,"_2383":102186},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_2856":59769,"_25058":59656,"_17494":102188,"_5":17389,"_23725":101905,"_2383":102189},[],"**Country (C)**: código de país de dos letras.",{"_2856":59770,"_25058":59656,"_17494":102191,"_5":17389,"_23725":101905,"_2383":102192},[],"**State / Province (ST)**: estado o provincia.",{"_2856":59771,"_25058":59656,"_17494":102194,"_5":17389,"_23725":101905,"_2383":102195},[],"**Locality (L)**: ciudad o localidad.",{"_2856":59772,"_25058":59656,"_17494":102197,"_5":17389,"_23725":101905,"_2383":102198},[],"**Email Address**: correo de contacto.",{"_2856":59773,"_25058":59656,"_17494":102200,"_5":17389,"_23725":101905,"_2383":102201},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_2856":59774,"_25058":59656,"_17494":102203,"_5":17389,"_23725":101905,"_2383":102204},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_2856":59775,"_25058":59656,"_17494":102206,"_5":17389,"_23725":101909,"_2383":102207},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_2856":59776,"_25058":59656,"_17494":102209,"_5":17389,"_23725":101909,"_2383":47435},[],{"_2856":59777,"_25058":59656,"_17494":102211,"_5":17389,"_23725":101913,"_2383":102212},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_2856":59778,"_25058":59778,"_5":12268,"_2383":102214,"_25394":102215,"_17494":102216,"_23725":59778},"Validación online con OCSP",[40730,96973,45752,101163],[],{"_2856":59779,"_25058":59778,"_17494":102218,"_5":17389,"_23725":59778,"_2383":102219},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_2856":59780,"_25058":59778,"_5":25391,"_17494":102221,"_23725":102222,"_2383":102223},[],"/docs/pr-preview/pr-44/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_2856":59781,"_25058":59778,"_5":25391,"_17494":102225,"_23725":102226,"_2383":102227},[],"/docs/pr-preview/pr-44/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_2856":59782,"_25058":59778,"_5":25391,"_17494":102229,"_23725":102230,"_2383":102231},[],"/docs/pr-preview/pr-44/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_2856":59783,"_25058":59778,"_5":25391,"_17494":102233,"_23725":102234,"_2383":102235},[],"/docs/pr-preview/pr-44/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_2856":59784,"_25058":59778,"_5":25391,"_17494":102237,"_23725":102238,"_2383":102239},[],"/docs/pr-preview/pr-44/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_2856":59785,"_25058":59778,"_5":25391,"_17494":102241,"_23725":102242,"_2383":101708},[],"/docs/pr-preview/pr-44/es/platform/pki/ocsp#referencias",{"_2856":59786,"_25058":59778,"_17494":102244,"_5":17389,"_23725":59778,"_2383":102245},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_2856":59787,"_25058":59778,"_17494":102247,"_5":17389,"_23725":102222,"_2383":102248},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_2856":59788,"_25058":59778,"_17494":102250,"_5":17389,"_23725":102222,"_2383":102251},[],"Estado del registro",{"_2856":59789,"_25058":59778,"_17494":102253,"_5":17389,"_23725":102222,"_2383":102254},[],"Respuesta firmada",{"_2856":59790,"_25058":59778,"_17494":102256,"_5":17389,"_23725":102222,"_2383":44930},[],{"_2856":59791,"_25058":59778,"_17494":102258,"_5":17389,"_23725":102222,"_2383":47485},[],{"_2856":59792,"_25058":59778,"_17494":102260,"_5":17389,"_23725":102222,"_2383":44947},[],{"_2856":59793,"_25058":59778,"_17494":102262,"_5":17389,"_23725":102222,"_2383":102263},[],"`Revoked`, con razón y fecha de revocación.",{"_2856":59794,"_25058":59778,"_17494":102265,"_5":17389,"_23725":102222,"_2383":102266},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_2856":59795,"_25058":59778,"_17494":102268,"_5":17389,"_23725":102222,"_2383":102269},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_2856":59796,"_25058":59778,"_17494":102271,"_5":17389,"_23725":102222,"_2383":102272},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_2856":59797,"_25058":59778,"_17494":102274,"_5":17389,"_23725":102222,"_2383":102275},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_2856":59798,"_25058":59778,"_17494":102277,"_5":17389,"_23725":102222,"_2383":102278},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_2856":59799,"_25058":59778,"_17494":102280,"_5":17389,"_23725":102226,"_2383":102281},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_2856":59800,"_25058":59778,"_17494":102283,"_5":17389,"_23725":102226,"_2383":102284},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_2856":59801,"_25058":59778,"_17494":102286,"_5":17389,"_23725":102230,"_2383":102287},[],"El servicio acepta:",{"_2856":59802,"_25058":59778,"_17494":102289,"_5":17389,"_23725":102230,"_2383":98655},[],{"_2856":59803,"_25058":59778,"_17494":102291,"_5":17389,"_23725":102230,"_2383":102292},[],"Ruta del servicio VA",{"_2856":59804,"_25058":59778,"_17494":102294,"_5":17389,"_23725":102230,"_2383":102295},[],"Formato",{"_2856":59805,"_25058":59778,"_17494":102297,"_5":17389,"_23725":102230,"_2383":47525},[],{"_2856":59806,"_25058":59778,"_17494":102299,"_5":17389,"_23725":102230,"_2383":47528},[],{"_2856":59807,"_25058":59778,"_17494":102301,"_5":17389,"_23725":102230,"_2383":102302},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_2856":59808,"_25058":59778,"_17494":102304,"_5":17389,"_23725":102230,"_2383":47014},[],{"_2856":59809,"_25058":59778,"_17494":102306,"_5":17389,"_23725":102230,"_2383":47536},[],{"_2856":59810,"_25058":59778,"_17494":102308,"_5":17389,"_23725":102230,"_2383":102309},[],"Solicitud DER codificada en Base64 URL con padding.",{"_2856":59811,"_25058":59778,"_17494":102311,"_5":17389,"_23725":102230,"_2383":102312},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_2856":59812,"_25058":59778,"_17494":102314,"_5":17389,"_23725":102234,"_2383":102315},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_2856":59813,"_25058":59778,"_17494":102317,"_5":17389,"_23725":102234,"_2383":102318},[],"Genera la solicitud:",{"_2856":59814,"_25058":59778,"_17494":102320,"_5":17389,"_23725":102234,"_2383":102321},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_2856":59815,"_25058":59778,"_17494":102323,"_5":17389,"_23725":102234,"_2383":102324},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_2856":59816,"_25058":59778,"_17494":102326,"_5":17389,"_23725":102234,"_2383":102327},[],"Verifica el DER recibido:",{"_2856":59817,"_25058":59778,"_17494":102329,"_5":17389,"_23725":102234,"_2383":102330},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_2856":59818,"_25058":59778,"_17494":102332,"_5":17389,"_23725":102238,"_2383":102333},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_2856":59819,"_25058":59778,"_17494":102335,"_5":17389,"_23725":102238,"_2383":102336},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_2856":59820,"_25058":59778,"_17494":102338,"_5":17389,"_23725":102242,"_2383":47569},[],{"_2856":59821,"_25058":59778,"_17494":102340,"_5":17389,"_23725":102242,"_2383":47572},[],{"_2856":59822,"_25058":59778,"_17494":102342,"_5":17389,"_23725":102242,"_2383":102343},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_2856":59823,"_25058":59778,"_17494":102345,"_5":17389,"_23725":102242,"_2383":101835},[],{"_2856":59824,"_25058":59824,"_5":12268,"_2383":45752,"_25394":102347,"_17494":102348,"_23725":59824},[40730,96973,45752],[],{"_2856":59825,"_25058":59824,"_17494":102350,"_5":17389,"_23725":59824,"_2383":102351},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_2856":59826,"_25058":59824,"_5":25391,"_17494":102353,"_23725":102354,"_2383":99872},[],"/docs/pr-preview/pr-44/es/platform/pki/overview#empieza-aquí",{"_2856":59827,"_25058":59824,"_5":25391,"_17494":102356,"_23725":102357,"_2383":102358},[],"/docs/pr-preview/pr-44/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_2856":59828,"_25058":59824,"_5":25391,"_17494":102360,"_23725":102361,"_2383":100394},[],"/docs/pr-preview/pr-44/es/platform/pki/overview#capacidades-principales",{"_2856":59829,"_25058":59824,"_5":25391,"_17494":102363,"_23725":102364,"_2383":100398},[],"/docs/pr-preview/pr-44/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_2856":59830,"_25058":59824,"_5":25391,"_17494":102366,"_23725":102367,"_2383":100402},[],"/docs/pr-preview/pr-44/es/platform/pki/overview#protege-las-claves-criptográficas",{"_2856":59831,"_25058":59824,"_5":25391,"_17494":102369,"_23725":102370,"_2383":100406},[],"/docs/pr-preview/pr-44/es/platform/pki/overview#emite-y-controla-certificados",{"_2856":59832,"_25058":59824,"_5":25391,"_17494":102372,"_23725":102373,"_2383":100414},[],"/docs/pr-preview/pr-44/es/platform/pki/overview#publica-el-estado-de-validación",{"_2856":59833,"_25058":59824,"_5":25391,"_17494":102375,"_23725":102376,"_2383":102377},[],"/docs/pr-preview/pr-44/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_2856":59834,"_25058":59824,"_5":25391,"_17494":102379,"_23725":102380,"_2383":101329},[],"/docs/pr-preview/pr-44/es/platform/pki/overview#continúa",{"_2856":59835,"_25058":59824,"_17494":102382,"_5":17389,"_23725":59824,"_2383":102383},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_2856":59836,"_25058":59824,"_17494":102385,"_5":17389,"_23725":102354,"_2383":102386},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_2856":59837,"_25058":59824,"_17494":102388,"_5":17389,"_23725":102354,"_2383":102389},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_2856":59838,"_25058":59824,"_17494":102391,"_5":17389,"_23725":102357,"_2383":102392},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_2856":59839,"_25058":59824,"_17494":102394,"_5":17389,"_23725":102357,"_2383":102395},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_2856":59840,"_25058":59824,"_17494":102397,"_5":17389,"_23725":102357,"_2383":102398},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_2856":59841,"_25058":59824,"_17494":102400,"_5":17389,"_23725":102357,"_2383":102401},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_2856":59842,"_25058":59824,"_17494":102403,"_5":17389,"_23725":102357,"_2383":102404},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_2856":59843,"_25058":59824,"_17494":102406,"_5":17389,"_23725":102364,"_2383":102407},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_2856":59844,"_25058":59824,"_17494":102409,"_5":17389,"_23725":102367,"_2383":102410},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_2856":59845,"_25058":59824,"_17494":102412,"_5":17389,"_23725":102370,"_2383":102413},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_2856":59846,"_25058":59824,"_17494":102415,"_5":17389,"_23725":102373,"_2383":102416},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_2856":59847,"_25058":59824,"_17494":102418,"_5":17389,"_23725":102376,"_2383":102419},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_2856":59848,"_25058":59824,"_17494":102421,"_5":17389,"_23725":102376,"_2383":102422},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_2856":59849,"_25058":59824,"_17494":102424,"_5":17389,"_23725":102376,"_2383":102425},[],"su clave pública corresponda a la clave privada del cliente;",{"_2856":59850,"_25058":59824,"_17494":102427,"_5":17389,"_23725":102376,"_2383":102428},[],"su cadena alcance una raíz confiable para el consumidor;",{"_2856":59851,"_25058":59824,"_17494":102430,"_5":17389,"_23725":102376,"_2383":102431},[],"sus fechas y usos permitan la operación;",{"_2856":59852,"_25058":59824,"_17494":102433,"_5":17389,"_23725":102376,"_2383":102434},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_2856":59853,"_25058":59824,"_17494":102436,"_5":17389,"_23725":102376,"_2383":102437},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_2856":59854,"_25058":59824,"_17494":102439,"_5":17389,"_23725":102380,"_2383":102440},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2856":59855,"_25058":59824,"_17494":102442,"_5":17389,"_23725":102380,"_2383":102443},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2856":59856,"_25058":59824,"_17494":102445,"_5":17389,"_23725":102380,"_2383":102446},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2856":59857,"_25058":59857,"_5":12268,"_2383":102448,"_25394":102449,"_17494":102450,"_23725":59857},"Crea tu primera CA",[40730,96973,45752,99996],[],{"_2856":59858,"_25058":59857,"_17494":102452,"_5":17389,"_23725":59857,"_2383":102453},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_2856":59859,"_25058":59857,"_5":25391,"_17494":102455,"_23725":102456,"_2383":95674},[],"/docs/pr-preview/pr-44/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_2856":59860,"_25058":59857,"_5":25391,"_17494":102458,"_23725":102459,"_2383":102460},[],"/docs/pr-preview/pr-44/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_2856":59861,"_25058":59857,"_5":25391,"_17494":102462,"_23725":102463,"_2383":102464},[],"/docs/pr-preview/pr-44/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_2856":59862,"_25058":59857,"_5":25391,"_17494":102466,"_23725":102467,"_2383":102468},[],"/docs/pr-preview/pr-44/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_2856":59863,"_25058":59857,"_5":25391,"_17494":102470,"_23725":102471,"_2383":102472},[],"/docs/pr-preview/pr-44/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_2856":59864,"_25058":59857,"_5":25391,"_17494":102474,"_23725":102475,"_2383":102476},[],"/docs/pr-preview/pr-44/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_2856":59865,"_25058":59857,"_5":25391,"_17494":102478,"_23725":102479,"_2383":102480},[],"/docs/pr-preview/pr-44/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_2856":59866,"_25058":59857,"_5":25391,"_17494":102482,"_23725":102483,"_2383":100244},[],"/docs/pr-preview/pr-44/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_2856":59867,"_25058":59857,"_5":25391,"_17494":102485,"_23725":102486,"_2383":95698},[],"/docs/pr-preview/pr-44/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_2856":59868,"_25058":59857,"_17494":102488,"_5":17389,"_23725":59857,"_2383":102489},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_2856":59869,"_25058":59857,"_17494":102491,"_5":17389,"_23725":102456,"_2383":102492},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_2856":59870,"_25058":59857,"_17494":102494,"_5":17389,"_23725":102456,"_2383":102495},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_2856":59871,"_25058":59857,"_17494":102497,"_5":17389,"_23725":102456,"_2383":102498},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_2856":59872,"_25058":59857,"_17494":102500,"_5":17389,"_23725":102456,"_2383":102501},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_2856":59873,"_25058":59857,"_17494":102503,"_5":17389,"_23725":102459,"_2383":102504},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_2856":59874,"_25058":59857,"_17494":102506,"_5":17389,"_23725":102459,"_2383":102507},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_2856":59875,"_25058":59857,"_17494":102509,"_5":17389,"_23725":102463,"_2383":102510},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_2856":59876,"_25058":59857,"_17494":102512,"_5":17389,"_23725":102463,"_2383":102513},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_2856":59877,"_25058":59857,"_17494":102515,"_5":17389,"_23725":102467,"_2383":102516},[],"Selecciona **Root CA** y completa:",{"_2856":59878,"_25058":59857,"_17494":102518,"_5":17389,"_23725":102467,"_2383":47751},[],{"_2856":59879,"_25058":59857,"_17494":102520,"_5":17389,"_23725":102467,"_2383":102521},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_2856":59880,"_25058":59857,"_17494":102523,"_5":17389,"_23725":102467,"_2383":102524},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_2856":59881,"_25058":59857,"_17494":102526,"_5":17389,"_23725":102467,"_2383":102527},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_2856":59882,"_25058":59857,"_17494":102529,"_5":17389,"_23725":102467,"_2383":102530},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_2856":59883,"_25058":59857,"_17494":102532,"_5":17389,"_23725":102471,"_2383":102533},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_2856":59884,"_25058":59857,"_17494":102535,"_5":17389,"_23725":102475,"_2383":102536},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_2856":59885,"_25058":59857,"_17494":102538,"_5":17389,"_23725":102475,"_2383":102539},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_2856":59886,"_25058":59857,"_17494":102541,"_5":17389,"_23725":102479,"_2383":102542},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_2856":59887,"_25058":59857,"_17494":102544,"_5":17389,"_23725":102479,"_2383":102545},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_2856":59888,"_25058":59857,"_17494":102547,"_5":17389,"_23725":102479,"_2383":102548},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_2856":59889,"_25058":59857,"_17494":102550,"_5":17389,"_23725":102483,"_2383":102551},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_2856":59890,"_25058":59857,"_17494":102553,"_5":17389,"_23725":102483,"_2383":102554},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_2856":59891,"_25058":59857,"_17494":102556,"_5":17389,"_23725":102483,"_2383":102557},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_2856":59892,"_25058":59857,"_17494":102559,"_5":17389,"_23725":102483,"_2383":102560},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_2856":59893,"_25058":59857,"_17494":102562,"_5":17389,"_23725":102486,"_2383":102563},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_2856":59894,"_25058":59894,"_5":12268,"_2383":102565,"_25394":102566,"_17494":102567,"_23725":59894},"Emite y verifica un certificado",[40730,96973,45752,99996],[],{"_2856":59895,"_25058":59894,"_17494":102569,"_5":17389,"_23725":59894,"_2383":102570},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_2856":59896,"_25058":59894,"_5":25391,"_17494":102572,"_23725":102573,"_2383":95674},[],"/docs/pr-preview/pr-44/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_2856":59897,"_25058":59894,"_5":25391,"_17494":102575,"_23725":102576,"_2383":102577},[],"/docs/pr-preview/pr-44/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_2856":59898,"_25058":59894,"_5":25391,"_17494":102579,"_23725":102580,"_2383":102581},[],"/docs/pr-preview/pr-44/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_2856":59899,"_25058":59894,"_5":25391,"_17494":102583,"_23725":102584,"_2383":102585},[],"/docs/pr-preview/pr-44/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_2856":59900,"_25058":59894,"_5":25391,"_17494":102587,"_23725":102588,"_2383":102589},[],"/docs/pr-preview/pr-44/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_2856":59901,"_25058":59894,"_5":25391,"_17494":102591,"_23725":102592,"_2383":102593},[],"/docs/pr-preview/pr-44/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_2856":59902,"_25058":59894,"_5":25391,"_17494":102595,"_23725":102596,"_2383":102476},[],"/docs/pr-preview/pr-44/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_2856":59903,"_25058":59894,"_5":25391,"_17494":102598,"_23725":102599,"_2383":102600},[],"/docs/pr-preview/pr-44/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_2856":59904,"_25058":59894,"_5":25391,"_17494":102602,"_23725":102603,"_2383":102604},[],"/docs/pr-preview/pr-44/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_2856":59905,"_25058":59894,"_5":25391,"_17494":102606,"_23725":102607,"_2383":102608},[],"/docs/pr-preview/pr-44/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_2856":59906,"_25058":59894,"_5":25391,"_17494":102610,"_23725":102611,"_2383":100244},[],"/docs/pr-preview/pr-44/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_2856":59907,"_25058":59894,"_5":25391,"_17494":102613,"_23725":102614,"_2383":95698},[],"/docs/pr-preview/pr-44/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_2856":59908,"_25058":59894,"_17494":102616,"_5":17389,"_23725":59894,"_2383":102617},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_2856":59909,"_25058":59894,"_17494":102619,"_5":17389,"_23725":102573,"_2383":102620},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_2856":59910,"_25058":59894,"_17494":102622,"_5":17389,"_23725":102573,"_2383":102623},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_2856":59911,"_25058":59894,"_17494":102625,"_5":17389,"_23725":102573,"_2383":102626},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_2856":59912,"_25058":59894,"_17494":102628,"_5":17389,"_23725":102573,"_2383":102629},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_2856":59913,"_25058":59894,"_17494":102631,"_5":17389,"_23725":102573,"_2383":102632},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_2856":59914,"_25058":59894,"_17494":102634,"_5":17389,"_23725":102576,"_2383":102635},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_2856":59915,"_25058":59894,"_17494":102637,"_5":17389,"_23725":102580,"_2383":102638},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_2856":59916,"_25058":59894,"_17494":102640,"_5":17389,"_23725":102580,"_2383":102641},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_2856":59917,"_25058":59894,"_17494":102643,"_5":17389,"_23725":102584,"_2383":102644},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_2856":59918,"_25058":59894,"_17494":102646,"_5":17389,"_23725":102584,"_2383":102647},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_2856":59919,"_25058":59894,"_17494":102649,"_5":17389,"_23725":102588,"_2383":102650},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_2856":59920,"_25058":59894,"_17494":102652,"_5":17389,"_23725":102588,"_2383":102653},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_2856":59921,"_25058":59894,"_17494":102655,"_5":17389,"_23725":102592,"_2383":102656},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_2856":59922,"_25058":59894,"_17494":102658,"_5":17389,"_23725":102596,"_2383":102659},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_2856":59923,"_25058":59894,"_17494":102661,"_5":17389,"_23725":102599,"_2383":102662},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_2856":59924,"_25058":59894,"_17494":102664,"_5":17389,"_23725":102603,"_2383":102665},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_2856":59925,"_25058":59894,"_17494":102667,"_5":17389,"_23725":102603,"_2383":102668},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_2856":59926,"_25058":59894,"_17494":102670,"_5":17389,"_23725":102603,"_2383":102671},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_2856":59927,"_25058":59894,"_17494":102673,"_5":17389,"_23725":102607,"_2383":102674},[],"En Bash, compara los dos resúmenes de clave pública:",{"_2856":59928,"_25058":59894,"_17494":102676,"_5":17389,"_23725":102607,"_2383":102677},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_2856":59929,"_25058":59894,"_17494":102679,"_5":17389,"_23725":102607,"_2383":102680},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_2856":59930,"_25058":59894,"_17494":102682,"_5":17389,"_23725":102611,"_2383":100327},[],{"_2856":59931,"_25058":59894,"_17494":102684,"_5":17389,"_23725":102611,"_2383":99104},[],{"_2856":59932,"_25058":59894,"_17494":102686,"_5":17389,"_23725":102611,"_2383":102687},[],"La CA rechaza la emisión",{"_2856":59933,"_25058":59894,"_17494":102689,"_5":17389,"_23725":102611,"_2383":102690},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_2856":59934,"_25058":59894,"_17494":102692,"_5":17389,"_23725":102611,"_2383":102693},[],"Sujeto o usos diferentes",{"_2856":59935,"_25058":59894,"_17494":102695,"_5":17389,"_23725":102611,"_2383":102696},[],"Perfil aplicado y valores solicitados.",{"_2856":59936,"_25058":59894,"_17494":102698,"_5":17389,"_23725":102611,"_2383":102699},[],"No se encuentra el emisor",{"_2856":59937,"_25058":59894,"_17494":102701,"_5":17389,"_23725":102611,"_2383":102702},[],"CA descargada y cadena intermedia necesaria.",{"_2856":59938,"_25058":59894,"_17494":102704,"_5":17389,"_23725":102611,"_2383":102705},[],"Falla la vigencia",{"_2856":59939,"_25058":59894,"_17494":102707,"_5":17389,"_23725":102611,"_2383":102708},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_2856":59940,"_25058":59894,"_17494":102710,"_5":17389,"_23725":102611,"_2383":102711},[],"Los resúmenes de clave difieren",{"_2856":59941,"_25058":59894,"_17494":102713,"_5":17389,"_23725":102611,"_2383":102714},[],"Archivos de certificado y clave de la misma emisión.",{"_2856":59942,"_25058":59894,"_17494":102716,"_5":17389,"_23725":102611,"_2383":102717},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_2856":59943,"_25058":59894,"_17494":102719,"_5":17389,"_23725":102614,"_2383":102720},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_2856":59944,"_25058":59894,"_17494":102722,"_5":17389,"_23725":102614,"_2383":102723},[],"Gestionar certificados para inspección, estado y revocación.",{"_2856":59945,"_25058":59894,"_17494":102725,"_5":17389,"_23725":102614,"_2383":102726},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_2856":59946,"_25058":59894,"_17494":102728,"_5":17389,"_23725":102614,"_2383":102729},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_2856":59947,"_25058":59894,"_17494":102731,"_5":17389,"_23725":102614,"_2383":102732},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_2856":59948,"_25058":59948,"_5":12268,"_2383":102734,"_25394":102735,"_17494":102736,"_23725":59948},"Primeros pasos de PKI",[40730,96973,45752,99996],[],{"_2856":59949,"_25058":59948,"_17494":102738,"_5":17389,"_23725":59948,"_2383":102739},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_2856":59950,"_25058":59948,"_5":25391,"_17494":102741,"_23725":102742,"_2383":95674},[],"/docs/pr-preview/pr-44/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_2856":59951,"_25058":59948,"_5":25391,"_17494":102744,"_23725":102745,"_2383":102746},[],"/docs/pr-preview/pr-44/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_2856":59952,"_25058":59948,"_5":25391,"_17494":102748,"_23725":102749,"_2383":100178},[],"/docs/pr-preview/pr-44/es/platform/pki/quickstarts/overview#resultado-esperado",{"_2856":59953,"_25058":59948,"_5":25391,"_17494":102751,"_23725":102752,"_2383":102753},[],"/docs/pr-preview/pr-44/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_2856":59954,"_25058":59948,"_17494":102755,"_5":17389,"_23725":59948,"_2383":102756},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_2856":59955,"_25058":59948,"_17494":102758,"_5":17389,"_23725":102742,"_2383":102759},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_2856":59956,"_25058":59948,"_17494":102761,"_5":17389,"_23725":102742,"_2383":102762},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_2856":59957,"_25058":59948,"_17494":102764,"_5":17389,"_23725":102742,"_2383":102765},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_2856":59958,"_25058":59948,"_17494":102767,"_5":17389,"_23725":102742,"_2383":102768},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_2856":59959,"_25058":59948,"_17494":102770,"_5":17389,"_23725":102742,"_2383":102771},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_2856":59960,"_25058":59948,"_17494":102773,"_5":17389,"_23725":102745,"_2383":102774},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2856":59961,"_25058":59948,"_17494":102776,"_5":17389,"_23725":102745,"_2383":102777},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2856":59962,"_25058":59948,"_17494":102779,"_5":17389,"_23725":102745,"_2383":102780},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_2856":59963,"_25058":59948,"_17494":102782,"_5":17389,"_23725":102745,"_2383":102783},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_2856":59964,"_25058":59948,"_17494":102785,"_5":17389,"_23725":102749,"_2383":102786},[],"Archivo o recurso",{"_2856":59965,"_25058":59948,"_17494":102788,"_5":17389,"_23725":102749,"_2383":100175},[],{"_2856":59966,"_25058":59948,"_17494":102790,"_5":17389,"_23725":102749,"_2383":102791},[],"CA raíz activa y `ca.pem`",{"_2856":59967,"_25058":59948,"_17494":102793,"_5":17389,"_23725":102749,"_2383":102794},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_2856":59968,"_25058":59948,"_17494":102796,"_5":17389,"_23725":102749,"_2383":102797},[],"Certificado final y `device.crt`",{"_2856":59969,"_25058":59948,"_17494":102799,"_5":17389,"_23725":102749,"_2383":102800},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_2856":59970,"_25058":59948,"_17494":102802,"_5":17389,"_23725":102749,"_2383":102803},[],"Clave privada `device.key`",{"_2856":59971,"_25058":59948,"_17494":102805,"_5":17389,"_23725":102749,"_2383":102806},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_2856":59972,"_25058":59948,"_17494":102808,"_5":17389,"_23725":102749,"_2383":102809},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_2856":59973,"_25058":59948,"_17494":102811,"_5":17389,"_23725":102752,"_2383":102812},[],"Para operar certificados, continúa con Certificados y Validación.",{"_2856":59974,"_25058":59948,"_17494":102814,"_5":17389,"_23725":102752,"_2383":102815},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_2856":59975,"_25058":59948,"_17494":102817,"_5":17389,"_23725":102752,"_2383":102818},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_2856":59976,"_25058":59976,"_5":12268,"_2383":102820,"_25394":102821,"_17494":102823,"_23725":59976},"Resolución de problemas PKI",[40730,96973,45752,102822],"Resolución de problemas",[],{"_2856":59977,"_25058":59976,"_17494":102825,"_5":17389,"_23725":59976,"_2383":102826},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_2856":59978,"_25058":59976,"_5":25391,"_17494":102828,"_23725":102829,"_2383":102830},[],"/docs/pr-preview/pr-44/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_2856":59979,"_25058":59976,"_5":25391,"_17494":102832,"_23725":102833,"_2383":102834},[],"/docs/pr-preview/pr-44/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_2856":59980,"_25058":59976,"_5":25391,"_17494":102836,"_23725":102837,"_2383":102838},[],"/docs/pr-preview/pr-44/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_2856":59981,"_25058":59976,"_17494":102840,"_5":17389,"_23725":59976,"_2383":102841},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_2856":59982,"_25058":59976,"_17494":102843,"_5":17389,"_23725":59976,"_2383":102844},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_2856":59983,"_25058":59976,"_17494":102846,"_5":17389,"_23725":102829,"_2383":100175},[],{"_2856":59984,"_25058":59976,"_17494":102848,"_5":17389,"_23725":102829,"_2383":99104},[],{"_2856":59985,"_25058":59976,"_17494":102850,"_5":17389,"_23725":102829,"_2383":95698},[],{"_2856":59986,"_25058":59976,"_17494":102852,"_5":17389,"_23725":102829,"_2383":48087},[],{"_2856":59987,"_25058":59976,"_17494":102854,"_5":17389,"_23725":102829,"_2383":102855},[],"Existe, está activa y sus fechas son utilizables.",{"_2856":59988,"_25058":59976,"_17494":102857,"_5":17389,"_23725":102829,"_2383":102858},[],"Autoridades.",{"_2856":59989,"_25058":59976,"_17494":102860,"_5":17389,"_23725":102829,"_2383":102861},[],"Clave",{"_2856":59990,"_25058":59976,"_17494":102863,"_5":17389,"_23725":102829,"_2383":102864},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_2856":59991,"_25058":59976,"_17494":102866,"_5":17389,"_23725":102829,"_2383":102867},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_2856":59992,"_25058":59976,"_17494":102869,"_5":17389,"_23725":102829,"_2383":48105},[],{"_2856":59993,"_25058":59976,"_17494":102871,"_5":17389,"_23725":102829,"_2383":102872},[],"PEM correcto y firma verificable.",{"_2856":59994,"_25058":59976,"_17494":102874,"_5":17389,"_23725":102829,"_2383":48111},[],{"_2856":59995,"_25058":59976,"_17494":102876,"_5":17389,"_23725":102829,"_2383":102877},[],"Perfil",{"_2856":59996,"_25058":59976,"_17494":102879,"_5":17389,"_23725":102829,"_2383":102880},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_2856":59997,"_25058":59976,"_17494":102882,"_5":17389,"_23725":102829,"_2383":102883},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_2856":59998,"_25058":59976,"_17494":102885,"_5":17389,"_23725":102829,"_2383":100327},[],{"_2856":59999,"_25058":59976,"_17494":102887,"_5":17389,"_23725":102829,"_2383":102888},[],"Sujeto, SAN, usos y fechas adecuados.",{"_2856":60000,"_25058":59976,"_17494":102890,"_5":17389,"_23725":102829,"_2383":102891},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_2856":60001,"_25058":59976,"_17494":102893,"_5":17389,"_23725":102829,"_2383":102894},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_2856":60002,"_25058":59976,"_17494":102896,"_5":17389,"_23725":102829,"_2383":102897},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_2856":60003,"_25058":59976,"_17494":102899,"_5":17389,"_23725":102833,"_2383":102900},[],"Revisa cada frontera por separado:",{"_2856":60004,"_25058":59976,"_17494":102902,"_5":17389,"_23725":102833,"_2383":102903},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_2856":60005,"_25058":59976,"_17494":102905,"_5":17389,"_23725":102833,"_2383":102906},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_2856":60006,"_25058":59976,"_17494":102908,"_5":17389,"_23725":102833,"_2383":102909},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_2856":60007,"_25058":59976,"_17494":102911,"_5":17389,"_23725":102833,"_2383":102912},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_2856":60008,"_25058":59976,"_17494":102914,"_5":17389,"_23725":102833,"_2383":102915},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_2856":60009,"_25058":59976,"_17494":102917,"_5":17389,"_23725":102833,"_2383":102918},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_2856":60010,"_25058":59976,"_17494":102920,"_5":17389,"_23725":102837,"_2383":102921},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_2856":60011,"_25058":59976,"_17494":102923,"_5":17389,"_23725":102837,"_2383":102924},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_48165":102926,"_48167":102927,"_48169":102928,"_48171":102929,"_15204":2405,"_57642":2405},"spanish",[2383,25058,5,23725],{"_2383":20879,"_25058":20879,"_5":20879,"_23725":20879},{"_2383":102930,"_25058":105296,"_5":107662,"_23725":110028},{"_3827":102931,"_48175":102932,"_5":20879},{"_12013":5297,"_12356":13475,"_12363":5884,"_24271":3936,"_23838":6029,"_16607":3229,"_12034":9193,"_12041":2911,"_24233":4927,"_24583":4506,"_24604":3100,"_24246":6158,"_28856":9198,"_24615":6897,"_28861":5143,"_28864":2542,"_28867":3366,"_28870":5732,"_28873":3096,"_24916":3305,"_28878":7243,"_28880":3427,"_24964":14326,"_24906":12904,"_28884":13094,"_24932":8493,"_28888":4006,"_24633":2462,"_24911":4153,"_24982":2769,"_28893":4915,"_28895":6248,"_28897":6282,"_28899":9197,"_28901":2695,"_28903":4864,"_28905":9764,"_28907":17884,"_28909":13675,"_24284":3831,"_28912":6244,"_28914":3913,"_24278":2577,"_25116":5663,"_28918":6188,"_28920":6190,"_28923":5080,"_24314":3346,"_28927":9201,"_24224":2618,"_28930":3637,"_24251":3923,"_28933":4101,"_28935":2739,"_28938":5391,"_24959":13990,