ation."},"1596":{"id":"/docs/pr-preview/pr-45/platform/overview-40","page_id":"/docs/pr-preview/pr-45/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/overview#publish-validation-status","content":"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information."},"1597":{"id":"/docs/pr-preview/pr-45/platform/overview-41","page_id":"/docs/pr-preview/pr-45/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/overview#react-to-events","content":"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events."},"1598":{"id":"/docs/pr-preview/pr-45/platform/overview-42","page_id":"/docs/pr-preview/pr-45/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/overview#operational-reference","content":"Responsibility"},"1599":{"id":"/docs/pr-preview/pr-45/platform/overview-43","page_id":"/docs/pr-preview/pr-45/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/overview#operational-reference","content":"What it prepares or checks"},"1600":{"id":"/docs/pr-preview/pr-45/platform/overview-44","page_id":"/docs/pr-preview/pr-45/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/overview#operational-reference","content":"PKI administrator"},"1601":{"id":"/docs/pr-preview/pr-45/platform/overview-45","page_id":"/docs/pr-preview/pr-45/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/overview#operational-reference","content":"Key custody, CA hierarchy, profiles and validation."},"1602":{"id":"/docs/pr-preview/pr-45/platform/overview-46","page_id":"/docs/pr-preview/pr-45/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/overview#operational-reference","content":"Fleet administrator"},"1603":{"id":"/docs/pr-preview/pr-45/platform/overview-47","page_id":"/docs/pr-preview/pr-4