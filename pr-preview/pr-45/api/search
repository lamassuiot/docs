shooting-18","page_id":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting#la-emisión-falla","content":"Perfil"},"2354":{"id":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting-19","page_id":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting#la-emisión-falla","content":"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos."},"2355":{"id":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting-20","page_id":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting#la-emisión-falla","content":"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta."},"2356":{"id":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting-21","page_id":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting#la-emisión-falla","content":"Resultado"},"2357":{"id":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting-22","page_id":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting#la-emisión-falla","content":"Sujeto, SAN, usos y fechas adecuados."},"2358":{"id":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting-23","page_id":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting#la-emisión-falla","content":"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor."},"2359":{"id":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting-24","page_id":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting#la-emisión-falla","content":"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA."},"2360":{"id":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting-25","page_id":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting#la-emisión-falla","content":"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación."},"2361":{"id":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting-26","page_id":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","content":"Revisa cada frontera por separado:"},"2362":{"id":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting-27","page_id":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","content":"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición."},"2363":{"id":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting-28","page_id":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","content":"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia."},"2364":{"id":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting-29","page_id":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","content":"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado."},"2365":{"id":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting-30","page_id":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","content":"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue."},"2366":{"id":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting-31","page_id":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","content":"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva."},"2367":{"id":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting-32","page_id":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","content":"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación."},"2368":{"id":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting-33","page_id":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","content":"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo."},"2369":{"id":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting-34","page_id":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","content":"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora."}},"count":2369},"sorting":{"language":"spanish","sortableProperties":["content","page_id","type","url"],"sortablePropertiesWithTypes":{"content":"string","page_id":"string","type":"string","url":"string"},"sorts":{"content":{"docs":{"1":874,"2":933,"3":451,"4":1948,"5":396,"6":684,"7":1536,"8":1514,"9":2107,"10":1463,"11":1753,"12":2284,"13":2223,"14":49,"15":23,"16":129,"17":399,"18":2027,"19":681,"20":1353,"21":746,"22":875,"23":1077,"24":1096,"25":6,"26":878,"27":1844,"28":1610,"29":1900,"30":1887,"31":1852,"32":1408,"33":1815,"34":2192,"35":1322,"36":511,"37":1237,"38":2193,"39":1344,"40":2013,"41":1178,"42":1497,"43":2170,"44":357,"45":337,"46":358,"47":2295,"48":814,"49":2311,"50":736,"51":1868,"52":1765,"53":2124,"54":1510,"55":899,"56":760,"57":417,"58":2145,"59":1764,"60":904,"61":2144,"62":2121,"63":2146,"64":1317,"65":1099,"66":382,"67":1816,"68":1318,"69":1100,"70":383,"71":1166,"72":1342,"73":836,"74":384,"75":739,"76":819,"77":1255,"78":482,"79":873,"80":1855,"81":445,"82":1356,"83":2021,"84":1675,"85":1857,"86":621,"87":798,"88":2349,"89":1259,"90":1715,"91":1257,"92":1261,"93":21