ent-10","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-45/platform/pki/key-management#create-or-import-keys","content":"Create or import keys"},"2027":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-11","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-45/platform/pki/key-management#generate-a-new-key-pair","content":"Generate a new key pair"},"2028":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-12","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-45/platform/pki/key-management#import-an-existing-pair","content":"Import an existing pair"},"2029":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-13","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-45/platform/pki/key-management#operations-on-a-key","content":"Operations on a key"},"2030":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-14","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-45/platform/pki/key-management#view-details","content":"View details"},"2031":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-15","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-45/platform/pki/key-management#sign-and-verify","content":"Sign and verify"},"2032":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-16","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-45/platform/pki/key-management#sign","content":"Sign"},"2033":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-17","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-45/platform/pki/key-management#verify","content":"Verify"},"2034":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-18","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-45/platform/pki/key-management#generate-a-csr","content":"Generate a CSR"},"2035":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-19","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-45/platform/pki/key-management#sign-locally-with-pkcs11","content":"Sign locally with PKCS#11"},"2036":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-20","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-45/platform/pki/key-management#before-deleting-a-key","content":"Before deleting a key"},"2037":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-21","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management","content":"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI."},"2038":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-22","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management","content":"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system."},"2039":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-23","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#what-the-kms-solves","content":"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider."},"2040":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-24","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#what-the-kms-solves","content":"In practice, it lets you:"},"2041":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-25","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#what-the-kms-solves","content":"Generate new key pairs from Lamassu IoT."},"2042":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-26","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#what-the-kms-solves","content":"Import keys created externally."},"2043":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-27","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#what-the-kms-solves","content":"Delegate custody and cryptographic operations to external engines."},"2044":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-28","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#what-the-kms-solves","content":"Reuse existing keys for CAs, CSRs and signing or verification tasks."},"2045":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-29","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#cryptographic-engines","content":"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform."},"2046":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-30","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#cryptographic-engines","content":"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements."},"2047":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-31","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#cryptographic-engines","content":"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration."},"2048":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-32","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#file-system","content":"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files."},"2049":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-33","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#hashicorp-vault","content":"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner."},"2050":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-34","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#aws-secrets-manager","content":"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM."},"2051":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-35","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#aws-kms","content":"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations."},"2052":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-36","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#pkcs11","content":"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody."},"2053":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-37","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#azure-key-vault","content":"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations."},"2054":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-38","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#azure-key-vault","content":"Lamassu shows the enabled engines in the console."},"2055":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-39","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#azure-key-vault","content":"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate."},"2056":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-40","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#azure-key-vault","content":"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA."},"2057":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-41","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#key-inventory","content":"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to."},"2058":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-42","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#key-inventory","content":"The table includes the following fields:"},"2059":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-43","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#key-inventory","content":"**Name**: descriptive name of the key."},"2060":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-44","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#key-inventory","content":"**Type**: algorithm and key size, for example RSA 2048 or EC P-256."},"2061":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-45","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#key-inventory","content":"**Strength**: visual indicator of cryptographic strength."},"2062":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-46","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#key-inventory","content":"**Public/Private**: whether Lamassu manages the full pair or only the public key."},"2063":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-47","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#key-inventory","content":"**Crypto Engine**: cryptographic engine keeping the key."},"2064":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-48","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#key-inventory","content":"**Aliases**: alternative names associated with the key."},"2065":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-49","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#key-inventory","content":"**Tags**: labels for classification and search."},"2066":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-50","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#key-inventory","content":"**Related Entities**: certificates or other entities linked to that key."},"2067":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-51","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#key-inventory","content":"From this view you also reach the most common actions:"},"2068":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-52","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#key-inventory","content":"**View Details** to inspect metadata, identifiers and relationships."},"2069":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-53","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#key-inventory","content":"**Generate CSR** to create a PKCS#10 request with the selected key."},"2070":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-54","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#key-inventory","content":"**Sign / Verify** to test cryptographic operations on the key."},"2071":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-55","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#key-inventory","content":"**Delete Key** to remove the key from the system."},"2072":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-56","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#create-or-import-keys","content":"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import."},"2073":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-57","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#generate-a-new-key-pair","content":"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines."},"2074":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-58","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#generate-a-new-key-pair","content":"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:"},"2075":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-59","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#generate-a-new-key-pair","content":"**Key Name**: unique and descriptive name."},"2076":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-60","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#generate-a-new-key-pair","content":"**Crypto Engine**: engine that will keep the key."},"2077":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-61","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#generate-a-new-key-pair","content":"**Key Type** and **Key Size**: algorithm and size or curve."},"2078":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-62","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#generate-a-new-key-pair","content":"**Tags**: metadata to classify the key."},"2079":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-63","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#generate-a-new-key-pair","content":"**Metadata**: additional information for advanced uses."},"2080":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-64","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#import-an-existing-pair","content":"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production."},"2081":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-65","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#import-an-existing-pair","content":"When you have an exportable private key and the destination engine supports import."},"2082":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-66","page_id":"/docs/pr-preview/pr-45/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-45/platform/pki/key-management#import-an-existing-pair","content":"When an existing PKI needs to be migrated without reissuing certificates."},"2083":{"id":"/docs/pr-preview/pr-45/platform/pki/key-management-67","page_id":"/docs/pr-preview/pr-45/platform/pki/key-managem