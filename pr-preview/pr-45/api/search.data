1,"_38881":119954,"_38883":119957,"_38885":119960,"_38887":119963,"_38889":119966,"_38891":119969,"_38893":119972,"_38895":119975,"_38897":119978,"_38899":119981,"_38901":119984,"_38903":119987,"_38905":119990,"_38907":119993,"_38909":119996,"_38911":119999,"_38913":120002,"_38915":120005,"_38917":120008,"_38919":120011,"_38921":120014,"_38923":120017,"_38925":120020,"_38927":120023,"_38929":120026,"_38931":120029,"_38933":120032,"_38935":120035,"_38937":120038,"_38939":120041,"_38941":120044,"_38943":120047,"_38945":120050,"_38947":120053,"_38949":120056,"_38951":120059,"_38953":120062,"_38956":120065,"_38958":120068,"_38960":120071},{"_3328":67394,"_29138":67394,"_5":14177,"_2816":111530,"_29482":111531,"_20209":111534,"_26493":67394},"Despliega desde AWS Marketplace",[47429,111532,111533],"Despliegue","Otros modelos",[],{"_3328":67395,"_29138":67394,"_20209":111536,"_5":13819,"_26493":67394,"_2816":111537},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3328":67396,"_29138":67394,"_5":29479,"_20209":111539,"_26493":111540,"_2816":111541},[],"/docs/pr-preview/pr-45/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3328":67397,"_29138":67394,"_5":29479,"_20209":111543,"_26493":111544,"_2816":111545},[],"/docs/pr-preview/pr-45/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3328":67398,"_29138":67394,"_5":29479,"_20209":111547,"_26493":111548,"_2816":111549},[],"/docs/pr-preview/pr-45/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3328":67399,"_29138":67394,"_5":29479,"_20209":111551,"_26493":111552,"_2816":111553},[],"/docs/pr-preview/pr-45/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3328":67400,"_29138":67394,"_5":29479,"_20209":111555,"_26493":111556,"_2816":111557},[],"/docs/pr-preview/pr-45/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3328":67401,"_29138":67394,"_5":29479,"_20209":111559,"_26493":111560,"_2816":111561},[],"/docs/pr-preview/pr-45/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3328":67402,"_29138":67394,"_5":29479,"_20209":111563,"_26493":111564,"_2816":111565},[],"/docs/pr-preview/pr-45/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3328":67403,"_29138":67394,"_20209":111567,"_5":13819,"_26493":67394,"_2816":111568},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3328":67404,"_29138":67394,"_20209":111570,"_5":13819,"_26493":111540,"_2816":111571},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3328":67405,"_29138":67394,"_20209":111573,"_5":13819,"_26493":111540,"_2816":111574},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3328":67406,"_29138":67394,"_20209":111576,"_5":13819,"_26493":111540,"_2816":111577},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3328":67407,"_29138":67394,"_20209":111579,"_5":13819,"_26493":111544,"_2816":111580},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3328":67408,"_29138":67394,"_20209":111582,"_5":13819,"_26493":111544,"_2816":111583},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3328":67409,"_29138":67394,"_20209":111585,"_5":13819,"_26493":111544,"_2816":111586},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3328":67410,"_29138":67394,"_20209":111588,"_5":13819,"_26493":111548,"_2816":111589},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3328":67411,"_29138":67394,"_20209":111591,"_5":13819,"_26493":111552,"_2816":111592},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3328":67412,"_29138":67394,"_20209":111594,"_5":13819,"_26493":111556,"_2816":111595},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3328":67413,"_29138":67394,"_20209":111597,"_5":13819,"_26493":111560,"_2816":111598},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3328":67414,"_29138":67394,"_20209":111600,"_5":13819,"_26493":111564,"_2816":111601},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3328":67415,"_29138":67415,"_5":14177,"_2816":111603,"_29482":111604,"_20209":111605,"_26493":67415},"Despliega Lamassu",[47429,111532],[],{"_3328":67416,"_29138":67415,"_20209":111607,"_5":13819,"_26493":67415,"_2816":111608},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3328":67417,"_29138":67415,"_5":29479,"_20209":111610,"_26493":111611,"_2816":111612},[],"/docs/pr-preview/pr-45/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3328":67418,"_29138":67415,"_5":29479,"_20209":111614,"_26493":111615,"_2816":111616},[],"/docs/pr-preview/pr-45/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3328":67419,"_29138":67415,"_5":29479,"_20209":111618,"_26493":111619,"_2816":111620},[],"/docs/pr-preview/pr-45/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3328":67420,"_29138":67415,"_20209":111622,"_5":13819,"_26493":67415,"_2816":111623},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3328":67421,"_29138":67415,"_20209":111625,"_5":13819,"_26493":111611,"_2816":111626},[],"Modelo",{"_3328":67422,"_29138":67415,"_20209":111628,"_5":13819,"_26493":111611,"_2816":111629},[],"Recomendado para",{"_3328":67423,"_29138":67415,"_20209":111631,"_5":13819,"_26493":111611,"_2816":111632},[],"Quién opera la infraestructura",{"_3328":67424,"_29138":67415,"_20209":111634,"_5":13819,"_26493":111611,"_2816":111635},[],"Punto de partida",{"_3328":67425,"_29138":67415,"_20209":111637,"_5":13819,"_26493":111611,"_2816":47536},[],{"_3328":67426,"_29138":67415,"_20209":111639,"_5":13819,"_26493":111611,"_2816":111640},[],"Producción, entornos regulados y despliegues personalizados",{"_3328":67427,"_29138":67415,"_20209":111642,"_5":13819,"_26493":111611,"_2816":111643},[],"Tu equipo",{"_3328":67428,"_29138":67415,"_20209":111645,"_5":13819,"_26493":111611,"_2816":111646},[],"Helm o Fastlane",{"_3328":67429,"_29138":67415,"_20209":111648,"_5":13819,"_26493":111611,"_2816":47548},[],{"_3328":67430,"_29138":67415,"_20209":111650,"_5":13819,"_26493":111611,"_2816":111651},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3328":67431,"_29138":67415,"_20209":111653,"_5":13819,"_26493":111611,"_2816":111643},[],{"_3328":67432,"_29138":67415,"_20209":111655,"_5":13819,"_26493":111611,"_2816":111656},[],"Imagen preconfigurada en EC2",{"_3328":67433,"_29138":67415,"_20209":111658,"_5":13819,"_26493":111611,"_2816":47559},[],{"_3328":67434,"_29138":67415,"_20209":111660,"_5":13819,"_26493":111611,"_2816":111661},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3328":67435,"_29138":67415,"_20209":111663,"_5":13819,"_26493":111611,"_2816":47565},[],{"_3328":67436,"_29138":67415,"_20209":111665,"_5":13819,"_26493":111611,"_2816":111666},[],"Suscripción gestionada",{"_3328":67437,"_29138":67415,"_20209":111668,"_5":13819,"_26493":111611,"_2816":111669},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3328":67438,"_29138":67415,"_20209":111671,"_5":13819,"_26493":111611,"_2816":111672},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3328":67439,"_29138":67415,"_20209":111674,"_5":13819,"_26493":111611,"_2816":111675},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3328":67440,"_29138":67415,"_20209":111677,"_5":13819,"_26493":111615,"_2816":111678},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3328":67441,"_29138":67415,"_20209":111680,"_5":13819,"_26493":111619,"_2816":111681},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3328":67442,"_29138":67442,"_5":14177,"_2816":111683,"_29482":111684,"_20209":111685,"_26493":67442},"Utiliza Lamassu como SaaS",[47429,111532,111533],[],{"_3328":67443,"_29138":67442,"_20209":111687,"_5":13819,"_26493":67442,"_2816":111688},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3328":67444,"_29138":67442,"_5":29479,"_20209":111690,"_26493":111691,"_2816":111692},[],"/docs/pr-preview/pr-45/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3328":67445,"_29138":67442,"_5":29479,"_20209":111694,"_26493":111695,"_2816":111696},[],"/docs/pr-preview/pr-45/es/deployment/saas#planes","Planes",{"_3328":67446,"_29138":67442,"_5":29479,"_20209":111698,"_26493":111699,"_2816":111700},[],"/docs/pr-preview/pr-45/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3328":67447,"_29138":67442,"_20209":111702,"_5":13819,"_26493":67442,"_2816":111703},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3328":67448,"_29138":67442,"_20209":111705,"_5":13819,"_26493":111691,"_2816":111706},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3328":67449,"_29138":67442,"_20209":111708,"_5":13819,"_26493":111691,"_2816":111709},[],"Copias de seguridad automáticas.",{"_3328":67450,"_29138":67442,"_20209":111711,"_5":13819,"_26493":111691,"_2816":111712},[],"Actualizaciones de versión.",{"_3328":67451,"_29138":67442,"_20209":111714,"_5":13819,"_26493":111691,"_2816":111715},[],"Soporte técnico y SLA según el plan contratado.",{"_3328":67452,"_29138":67442,"_20209":111717,"_5":13819,"_26493":111695,"_2816":47620},[],{"_3328":67453,"_29138":67442,"_20209":111719,"_5":13819,"_26493":111695,"_2816":111720},[],"Dispositivos",{"_3328":67454,"_29138":67442,"_20209":111722,"_5":13819,"_26493":111695,"_2816":111723},[],"Soporte",{"_3328":67455,"_29138":67442,"_20209":111725,"_5":13819,"_26493":111695,"_2816":47629},[],{"_3328":67456,"_29138":67442,"_20209":111727,"_5":13819,"_26493":111695,"_2816":47632},[],{"_3328":67457,"_29138":67442,"_20209":111729,"_5":13819,"_26493":111695,"_2816":111730},[],"Hasta 1.000",{"_3328":67458,"_29138":67442,"_20209":111732,"_5":13819,"_26493":111695,"_2816":47638},[],{"_3328":67459,"_29138":67442,"_20209":111734,"_5":13819,"_26493":111695,"_2816":111735},[],"99,5 %",{"_3328":67460,"_29138":67442,"_20209":111737,"_5":13819,"_26493":111695,"_2816":47644},[],{"_3328":67461,"_29138":67442,"_20209":111739,"_5":13819,"_26493":111695,"_2816":111740},[],"Hasta 10.000",{"_3328":67462,"_29138":67442,"_20209":111742,"_5":13819,"_26493":111695,"_2816":111743},[],"Email y chat",{"_3328":67463,"_29138":67442,"_20209":111745,"_5":13819,"_26493":111695,"_2816":111746},[],"99,9 %",{"_3328":67464,"_29138":67442,"_20209":111748,"_5":13819,"_26493":111695,"_2816":47656},[],{"_3328":67465,"_29138":67442,"_20209":111750,"_5":13819,"_26493":111695,"_2816":111751},[],"Ilimitados",{"_3328":67466,"_29138":67442,"_20209":111753,"_5":13819,"_26493":111695,"_2816":111754},[],"Dedicado",{"_3328":67467,"_29138":67442,"_20209":111756,"_5":13819,"_26493":111695,"_2816":111757},[],"99,99 %",{"_3328":67468,"_29138":67442,"_20209":111759,"_5":13819,"_26493":111699,"_2816":111760},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3328":67469,"_29138":67442,"_20209":111762,"_5":13819,"_26493":111699,"_2816":111763},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3328":67470,"_29138":67470,"_5":14177,"_2816":47673,"_29482":111765,"_20209":111767,"_26493":67470},[47429,111532,111766],"Kubernetes autogestionado",[],{"_3328":67471,"_29138":67470,"_20209":111769,"_5":13819,"_26493":67470,"_2816":111770},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3328":67472,"_29138":67470,"_5":29479,"_20209":111772,"_26493":111773,"_2816":111774},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3328":67473,"_29138":67470,"_5":29479,"_20209":111776,"_26493":111777,"_2816":111778},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3328":67474,"_29138":67470,"_5":29479,"_20209":111780,"_26493":111781,"_2816":111782},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3328":67475,"_29138":67470,"_5":29479,"_20209":111784,"_26493":111785,"_2816":111786},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3328":67476,"_29138":67470,"_5":29479,"_20209":111788,"_26493":111789,"_2816":111790},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3328":67477,"_29138":67470,"_5":29479,"_20209":111792,"_26493":111793,"_2816":111794},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3328":67478,"_29138":67470,"_5":29479,"_20209":111796,"_26493":111797,"_2816":111798},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3328":67479,"_29138":67470,"_5":29479,"_20209":111800,"_26493":111801,"_2816":111802},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3328":67480,"_29138":67470,"_5":29479,"_20209":111804,"_26493":111805,"_2816":111806},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3328":67481,"_29138":67470,"_5":29479,"_20209":111808,"_26493":111809,"_2816":111810},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3328":67482,"_29138":67470,"_5":29479,"_20209":111812,"_26493":111813,"_2816":111814},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3328":67483,"_29138":67470,"_20209":111816,"_5":13819,"_26493":111773,"_2816":111817},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3328":67484,"_29138":67470,"_20209":111819,"_5":13819,"_26493":111773,"_2816":111820},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3328":67485,"_29138":67470,"_20209":111822,"_5":13819,"_26493":111777,"_2816":111823},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3328":67486,"_29138":67470,"_20209":111825,"_5":13819,"_26493":111777,"_2816":111826},[],"Fastlane instala o configura",{"_3328":67487,"_29138":67470,"_20209":111828,"_5":13819,"_26493":111777,"_2816":111829},[],"Tú sigues proporcionando",{"_3328":67488,"_29138":67470,"_20209":111831,"_5":13819,"_26493":111777,"_2816":111832},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3328":67489,"_29138":67470,"_20209":111834,"_5":13819,"_26493":111777,"_2816":111835},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3328":67490,"_29138":67470,"_20209":111837,"_5":13819,"_26493":111777,"_2816":111838},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3328":67491,"_29138":67470,"_20209":111840,"_5":13819,"_26493":111777,"_2816":111841},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3328":67492,"_29138":67470,"_20209":111843,"_5":13819,"_26493":111777,"_2816":111844},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3328":67493,"_29138":67470,"_20209":111846,"_5":13819,"_26493":111777,"_2816":111847},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3328":67494,"_29138":67470,"_20209":111849,"_5":13819,"_26493":111777,"_2816":111850},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3328":67495,"_29138":67470,"_20209":111852,"_5":13819,"_26493":111777,"_2816":111853},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3328":67496,"_29138":67470,"_20209":111855,"_5":13819,"_26493":111777,"_2816":111856},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3328":67497,"_29138":67470,"_20209":111858,"_5":13819,"_26493":111781,"_2816":111859},[],"Necesitas:",{"_3328":67498,"_29138":67470,"_20209":111861,"_5":13819,"_26493":111781,"_2816":111862},[],"un clúster Kubernetes existente",{"_3328":67499,"_29138":67470,"_20209":111864,"_5":13819,"_26493":111781,"_2816":111865},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3328":67500,"_29138":67470,"_20209":111867,"_5":13819,"_26493":111781,"_2816":47775},[],{"_3328":67501,"_29138":67470,"_20209":111869,"_5":13819,"_26493":111781,"_2816":22856},[],{"_3328":67502,"_29138":67470,"_20209":111871,"_5":13819,"_26493":111781,"_2816":111872},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3328":67503,"_29138":67470,"_20209":111874,"_5":13819,"_26493":111781,"_2816":111875},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3328":67504,"_29138":67470,"_20209":111877,"_5":13819,"_26493":111781,"_2816":111878},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3328":67505,"_29138":67470,"_20209":111880,"_5":13819,"_26493":111781,"_2816":111881},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3328":67506,"_29138":67470,"_20209":111883,"_5":13819,"_26493":111781,"_2816":111884},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3328":67507,"_29138":67470,"_20209":111886,"_5":13819,"_26493":111785,"_2816":111887},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3328":67508,"_29138":67470,"_20209":111889,"_5":13819,"_26493":111785,"_2816":111890},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3328":67509,"_29138":67470,"_20209":111892,"_5":13819,"_26493":111789,"_2816":111893},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3328":67510,"_29138":67470,"_20209":111895,"_5":13819,"_26493":111789,"_2816":111896},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3328":67511,"_29138":67470,"_20209":111898,"_5":13819,"_26493":111789,"_2816":111899},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3328":67512,"_29138":67470,"_20209":111901,"_5":13819,"_26493":111789,"_2816":111902},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3328":67513,"_29138":67470,"_20209":111904,"_5":13819,"_26493":111793,"_2816":111905},[],"Opción",{"_3328":67514,"_29138":67470,"_20209":111907,"_5":13819,"_26493":111793,"_2816":111908},[],"Valor predeterminado",{"_3328":67515,"_29138":67470,"_20209":111910,"_5":13819,"_26493":111793,"_2816":111911},[],"Propósito",{"_3328":67516,"_29138":67470,"_20209":111913,"_5":13819,"_26493":111793,"_2816":47822},[],{"_3328":67517,"_29138":67470,"_20209":111915,"_5":13819,"_26493":111793,"_2816":47825},[],{"_3328":67518,"_29138":67470,"_20209":111917,"_5":13819,"_26493":111793,"_2816":111918},[],"Muestra la ayuda",{"_3328":67519,"_29138":67470,"_20209":111920,"_5":13819,"_26493":111793,"_2816":47831},[],{"_3328":67520,"_29138":67470,"_20209":111922,"_5":13819,"_26493":111793,"_2816":111923},[],"contexto actual",{"_3328":67521,"_29138":67470,"_20209":111925,"_5":13819,"_26493":111793,"_2816":111926},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3328":67522,"_29138":67470,"_20209":111928,"_5":13819,"_26493":111793,"_2816":47840},[],{"_3328":67523,"_29138":67470,"_20209":111930,"_5":13819,"_26493":111793,"_2816":6245},[],{"_3328":67524,"_29138":67470,"_20209":111932,"_5":13819,"_26493":111793,"_2816":111933},[],"Omite prompts y genera credenciales para las dependencias",{"_3328":67525,"_29138":67470,"_20209":111935,"_5":13819,"_26493":111793,"_2816":47848},[],{"_3328":67526,"_29138":67470,"_20209":111937,"_5":13819,"_26493":111793,"_2816":47851},[],{"_3328":67527,"_29138":67470,"_20209":111939,"_5":13819,"_26493":111793,"_2816":111940},[],"Namespace de la instalación",{"_3328":67528,"_29138":67470,"_20209":111942,"_5":13819,"_26493":111793,"_2816":47857},[],{"_3328":67529,"_29138":67470,"_20209":111944,"_5":13819,"_26493":111793,"_2816":47860},[],{"_3328":67530,"_29138":67470,"_20209":111946,"_5":13819,"_26493":111793,"_2816":111947},[],"Dominio usado por la UI, OIDC y el certificado",{"_3328":67531,"_29138":67470,"_20209":111949,"_5":13819,"_26493":111793,"_2816":47866},[],{"_3328":67532,"_29138":67470,"_20209":111951,"_5":13819,"_26493":111793,"_2816":14491},[],{"_3328":67533,"_29138":67470,"_20209":111953,"_5":13819,"_26493":111793,"_2816":111954},[],"Versión del chart de Lamassu",{"_3328":67534,"_29138":67470,"_20209":111956,"_5":13819,"_26493":111793,"_2816":47874},[],{"_3328":67535,"_29138":67470,"_20209":111958,"_5":13819,"_26493":111793,"_2816":47877},[],{"_3328":67536,"_29138":67470,"_20209":111960,"_5":13819,"_26493":111793,"_2816":111961},[],"Puerto del listener HTTPS",{"_3328":67537,"_29138":67470,"_20209":111963,"_5":13819,"_26493":111793,"_2816":47883},[],{"_3328":67538,"_29138":67470,"_20209":111965,"_5":13819,"_26493":111793,"_2816":47886},[],{"_3328":67539,"_29138":67470,"_20209":111967,"_5":13819,"_26493":111793,"_2816":111968},[],"Puerto del listener HTTP",{"_3328":67540,"_29138":67470,"_20209":111970,"_5":13819,"_26493":111793,"_2816":47892},[],{"_3328":67541,"_29138":67470,"_20209":111972,"_5":13819,"_26493":111793,"_2816":47825},[],{"_3328":67542,"_29138":67470,"_20209":111974,"_5":13819,"_26493":111793,"_2816":111975},[],"Certificado PEM para TLS downstream",{"_3328":67543,"_29138":67470,"_20209":111977,"_5":13819,"_26493":111793,"_2816":47900},[],{"_3328":67544,"_29138":67470,"_20209":111979,"_5":13819,"_26493":111793,"_2816":47825},[],{"_3328":67545,"_29138":67470,"_20209":111981,"_5":13819,"_26493":111793,"_2816":111982},[],"Clave privada PEM para TLS downstream",{"_3328":67546,"_29138":67470,"_20209":111984,"_5":13819,"_26493":111793,"_2816":47908},[],{"_3328":67547,"_29138":67470,"_20209":111986,"_5":13819,"_26493":111793,"_2816":111987},[],"chart del repositorio",{"_3328":67548,"_29138":67470,"_20209":111989,"_5":13819,"_26493":111793,"_2816":111990},[],"Usa un chart local de Lamassu sin empaquetar",{"_3328":67549,"_29138":67470,"_20209":111992,"_5":13819,"_26493":111793,"_2816":47917},[],{"_3328":67550,"_29138":67470,"_20209":111994,"_5":13819,"_26493":111793,"_2816":111995},[],"detección automática",{"_3328":67551,"_29138":67470,"_20209":111997,"_5":13819,"_26493":111793,"_2816":111998},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3328":67552,"_29138":67470,"_20209":112000,"_5":13819,"_26493":111793,"_2816":47925},[],{"_3328":67553,"_29138":67470,"_20209":112002,"_5":13819,"_26493":111793,"_2816":6245},[],{"_3328":67554,"_29138":67470,"_20209":112004,"_5":13819,"_26493":111793,"_2816":112005},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3328":67555,"_29138":67470,"_20209":112007,"_5":13819,"_26493":111793,"_2816":47933},[],{"_3328":67556,"_29138":67470,"_20209":112009,"_5":13819,"_26493":111793,"_2816":6245},[],{"_3328":67557,"_29138":67470,"_20209":112011,"_5":13819,"_26493":111793,"_2816":112012},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3328":67558,"_29138":67470,"_20209":112014,"_5":13819,"_26493":111793,"_2816":47941},[],{"_3328":67559,"_29138":67470,"_20209":112016,"_5":13819,"_26493":111793,"_2816":6245},[],{"_3328":67560,"_29138":67470,"_20209":112018,"_5":13819,"_26493":111793,"_2816":112019},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3328":67561,"_29138":67470,"_20209":112021,"_5":13819,"_26493":111793,"_2816":47949},[],{"_3328":67562,"_29138":67470,"_20209":112023,"_5":13819,"_26493":111793,"_2816":6245},[],{"_3328":67563,"_29138":67470,"_20209":112025,"_5":13819,"_26493":111793,"_2816":112026},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3328":67564,"_29138":67470,"_20209":112028,"_5":13819,"_26493":111793,"_2816":47957},[],{"_3328":67565,"_29138":67470,"_20209":112030,"_5":13819,"_26493":111793,"_2816":47960},[],{"_3328":67566,"_29138":67470,"_20209":112032,"_5":13819,"_26493":111793,"_2816":112033},[],"Usa otro chart local de SoftHSM",{"_3328":67567,"_29138":67470,"_20209":112035,"_5":13819,"_26493":111793,"_2816":112036},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3328":67568,"_29138":67470,"_20209":112038,"_5":13819,"_26493":111797,"_2816":112039},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3328":67569,"_29138":67470,"_20209":112041,"_5":13819,"_26493":111797,"_2816":112042},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3328":67570,"_29138":67470,"_20209":112044,"_5":13819,"_26493":111797,"_2816":112045},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3328":67571,"_29138":67470,"_20209":112047,"_5":13819,"_26493":111797,"_2816":112048},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3328":67572,"_29138":67470,"_20209":112050,"_5":13819,"_26493":111797,"_2816":112051},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3328":67573,"_29138":67470,"_20209":112053,"_5":13819,"_26493":111797,"_2816":112054},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3328":67574,"_29138":67470,"_20209":112056,"_5":13819,"_26493":111801,"_2816":47987},[],{"_3328":67575,"_29138":67470,"_20209":112058,"_5":13819,"_26493":111801,"_2816":112059},[],"valida las herramientas locales y el clúster seleccionado",{"_3328":67576,"_29138":67470,"_20209":112061,"_5":13819,"_26493":111801,"_2816":112062},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3328":67577,"_29138":67470,"_20209":112064,"_5":13819,"_26493":111801,"_2816":112065},[],"crea el namespace",{"_3328":67578,"_29138":67470,"_20209":112067,"_5":13819,"_26493":111801,"_2816":112068},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3328":67579,"_29138":67470,"_20209":112070,"_5":13819,"_26493":111801,"_2816":112071},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3328":67580,"_29138":67470,"_20209":112073,"_5":13819,"_26493":111801,"_2816":112074},[],"instala RabbitMQ",{"_3328":67581,"_29138":67470,"_20209":112076,"_5":13819,"_26493":111801,"_2816":112077},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3328":67582,"_29138":67470,"_20209":112079,"_5":13819,"_26493":111801,"_2816":112080},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3328":67583,"_29138":67470,"_20209":112082,"_5":13819,"_26493":111801,"_2816":112083},[],"carga datos de ejemplo opcionalmente",{"_3328":67584,"_29138":67470,"_20209":112085,"_5":13819,"_26493":111801,"_2816":112086},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3328":67585,"_29138":67470,"_20209":112088,"_5":13819,"_26493":111805,"_2816":112089},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3328":67586,"_29138":67470,"_20209":112091,"_5":13819,"_26493":111805,"_2816":112092},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3328":67587,"_29138":67470,"_20209":112094,"_5":13819,"_26493":111809,"_2816":112095},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3328":67588,"_29138":67470,"_20209":112097,"_5":13819,"_26493":111809,"_2816":112098},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3328":67589,"_29138":67470,"_20209":112100,"_5":13819,"_26493":111809,"_2816":112101},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3328":67590,"_29138":67470,"_20209":112103,"_5":13819,"_26493":111813,"_2816":112104},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3328":67591,"_29138":67591,"_5":14177,"_2816":112106,"_29482":112107,"_20209":112108,"_26493":67591},"Instala con Helm",[47429,111532,111766],[],{"_3328":67592,"_29138":67591,"_20209":112110,"_5":13819,"_26493":67591,"_2816":112111},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3328":67593,"_29138":67591,"_5":29479,"_20209":112113,"_26493":112114,"_2816":112115},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3328":67594,"_29138":67591,"_5":29479,"_20209":112117,"_26493":112118,"_2816":111782},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3328":67595,"_29138":67591,"_5":29479,"_20209":112120,"_26493":112121,"_2816":112122},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3328":67596,"_29138":67591,"_5":29479,"_20209":112124,"_26493":112125,"_2816":112126},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3328":67597,"_29138":67591,"_5":29479,"_20209":112128,"_26493":112129,"_2816":112130},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3328":67598,"_29138":67591,"_5":29479,"_20209":112132,"_26493":112133,"_2816":112134},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3328":67599,"_29138":67591,"_5":29479,"_20209":112136,"_26493":112137,"_2816":112138},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3328":67600,"_29138":67591,"_5":29479,"_20209":112140,"_26493":112141,"_2816":112142},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3328":67601,"_29138":67591,"_5":29479,"_20209":112144,"_26493":112145,"_2816":112146},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3328":67602,"_29138":67591,"_5":29479,"_20209":112148,"_26493":112149,"_2816":112150},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3328":67603,"_29138":67591,"_5":29479,"_20209":112152,"_26493":112153,"_2816":112154},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3328":67604,"_29138":67591,"_20209":112156,"_5":13819,"_26493":112114,"_2816":112157},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3328":67605,"_29138":67591,"_20209":112159,"_5":13819,"_26493":112118,"_2816":112160},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3328":67606,"_29138":67591,"_20209":112162,"_5":13819,"_26493":112118,"_2816":112163},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3328":67607,"_29138":67591,"_20209":112165,"_5":13819,"_26493":112118,"_2816":112166},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3328":67608,"_29138":67591,"_20209":112168,"_5":13819,"_26493":112118,"_2816":112169},[],"un broker RabbitMQ accesible y sus credenciales",{"_3328":67609,"_29138":67591,"_20209":112171,"_5":13819,"_26493":112118,"_2816":112172},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3328":67610,"_29138":67591,"_20209":112174,"_5":13819,"_26493":112118,"_2816":112175},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3328":67611,"_29138":67591,"_20209":112177,"_5":13819,"_26493":112118,"_2816":112178},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3328":67612,"_29138":67591,"_20209":112180,"_5":13819,"_26493":112118,"_2816":112181},[],"una StorageClass y un diseño de tráfico externo",{"_3328":67613,"_29138":67591,"_20209":112183,"_5":13819,"_26493":112118,"_2816":112184},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3328":67614,"_29138":67591,"_20209":112186,"_5":13819,"_26493":112118,"_2816":112187},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3328":67615,"_29138":67591,"_20209":112189,"_5":13819,"_26493":112118,"_2816":112190},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3328":67616,"_29138":67591,"_20209":112192,"_5":13819,"_26493":112121,"_2816":112193},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3328":67617,"_29138":67591,"_20209":112195,"_5":13819,"_26493":112121,"_2816":112196},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3328":67618,"_29138":67591,"_20209":112198,"_5":13819,"_26493":112121,"_2816":112199},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3328":67619,"_29138":67591,"_20209":112201,"_5":13819,"_26493":112125,"_2816":112202},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3328":67620,"_29138":67591,"_20209":112204,"_5":13819,"_26493":112125,"_2816":112205},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3328":67621,"_29138":67591,"_20209":112207,"_5":13819,"_26493":112125,"_2816":112208},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3328":67622,"_29138":67591,"_20209":112210,"_5":13819,"_26493":112125,"_2816":112211},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3328":67623,"_29138":67591,"_20209":112213,"_5":13819,"_26493":112129,"_2816":112214},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3328":67624,"_29138":67591,"_20209":112216,"_5":13819,"_26493":112133,"_2816":112217},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3328":67625,"_29138":67591,"_20209":112219,"_5":13819,"_26493":112133,"_2816":112220},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3328":67626,"_29138":67591,"_20209":112222,"_5":13819,"_26493":112133,"_2816":112223},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3328":67627,"_29138":67591,"_20209":112225,"_5":13819,"_26493":112133,"_2816":112226},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3328":67628,"_29138":67591,"_20209":112228,"_5":13819,"_26493":112133,"_2816":112229},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3328":67629,"_29138":67591,"_20209":112231,"_5":13819,"_26493":112133,"_2816":112232},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3328":67630,"_29138":67591,"_20209":112234,"_5":13819,"_26493":112133,"_2816":112235},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3328":67631,"_29138":67591,"_20209":112237,"_5":13819,"_26493":112137,"_2816":112238},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3328":67632,"_29138":67591,"_20209":112240,"_5":13819,"_26493":112137,"_2816":112241},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3328":67633,"_29138":67591,"_20209":112243,"_5":13819,"_26493":112137,"_2816":112244},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3328":67634,"_29138":67591,"_20209":112246,"_5":13819,"_26493":112137,"_2816":112247},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3328":67635,"_29138":67591,"_20209":112249,"_5":13819,"_26493":112141,"_2816":112250},[],"Para instalar un checkout local:",{"_3328":67636,"_29138":67591,"_20209":112252,"_5":13819,"_26493":112145,"_2816":112253},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3328":67637,"_29138":67591,"_20209":112255,"_5":13819,"_26493":112145,"_2816":112256},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3328":67638,"_29138":67591,"_20209":112258,"_5":13819,"_26493":112149,"_2816":112259},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3328":67639,"_29138":67591,"_20209":112261,"_5":13819,"_26493":112149,"_2816":112262},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3328":67640,"_29138":67591,"_20209":112264,"_5":13819,"_26493":112149,"_2816":112265},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3328":67641,"_29138":67591,"_20209":112267,"_5":13819,"_26493":112149,"_2816":112268},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3328":67642,"_29138":67591,"_20209":112270,"_5":13819,"_26493":112149,"_2816":112271},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3328":67643,"_29138":67591,"_20209":112273,"_5":13819,"_26493":112153,"_2816":112274},[],"Antes de pasar a producción, revisa:",{"_3328":67644,"_29138":67591,"_20209":112276,"_5":13819,"_26493":112153,"_2816":112277},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3328":67645,"_29138":67591,"_20209":112279,"_5":13819,"_26493":112153,"_2816":112280},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3328":67646,"_29138":67591,"_20209":112282,"_5":13819,"_26493":112153,"_2816":112283},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3328":67647,"_29138":67591,"_20209":112285,"_5":13819,"_26493":112153,"_2816":112286},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3328":67648,"_29138":67591,"_20209":112288,"_5":13819,"_26493":112153,"_2816":112289},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3328":67649,"_29138":67591,"_20209":112291,"_5":13819,"_26493":112153,"_2816":112292},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3328":67650,"_29138":67591,"_20209":112294,"_5":13819,"_26493":112153,"_2816":112295},[],"SMTP, observabilidad y entrega de alertas",{"_3328":67651,"_29138":67591,"_20209":112297,"_5":13819,"_26493":112153,"_2816":112298},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3328":67652,"_29138":67591,"_20209":112300,"_5":13819,"_26493":112153,"_2816":112301},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3328":67653,"_29138":67653,"_5":14177,"_2816":112303,"_29482":112304,"_20209":112305,"_26493":67653},"Expón el Gateway",[47429,111532,111766],[],{"_3328":67654,"_29138":67653,"_20209":112307,"_5":13819,"_26493":67653,"_2816":112308},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3328":67655,"_29138":67653,"_5":29479,"_20209":112310,"_26493":112311,"_2816":112312},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3328":67656,"_29138":67653,"_5":29479,"_20209":112314,"_26493":112315,"_2816":112316},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3328":67657,"_29138":67653,"_5":29479,"_20209":112318,"_26493":112319,"_2816":112320},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3328":67658,"_29138":67653,"_5":29479,"_20209":112322,"_26493":112323,"_2816":48255},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/networking#k3s",{"_3328":67659,"_29138":67653,"_5":29479,"_20209":112325,"_26493":112326,"_2816":112327},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3328":67660,"_29138":67653,"_5":29479,"_20209":112329,"_26493":112330,"_2816":112331},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3328":67661,"_29138":67653,"_5":29479,"_20209":112333,"_26493":112334,"_2816":112335},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3328":67662,"_29138":67653,"_5":29479,"_20209":112337,"_26493":112338,"_2816":112339},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3328":67663,"_29138":67653,"_5":29479,"_20209":112341,"_26493":112342,"_2816":112343},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3328":67664,"_29138":67653,"_5":29479,"_20209":112345,"_26493":112346,"_2816":112347},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3328":67665,"_29138":67653,"_20209":112349,"_5":13819,"_26493":112311,"_2816":112350},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3328":67666,"_29138":67653,"_20209":112352,"_5":13819,"_26493":112311,"_2816":112353},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3328":67667,"_29138":67653,"_20209":112355,"_5":13819,"_26493":112315,"_2816":112356},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3328":67668,"_29138":67653,"_20209":112358,"_5":13819,"_26493":112315,"_2816":112359},[],"Defínelo únicamente cuando:",{"_3328":67669,"_29138":67653,"_20209":112361,"_5":13819,"_26493":112315,"_2816":112362},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3328":67670,"_29138":67653,"_20209":112364,"_5":13819,"_26493":112315,"_2816":112365},[],"esa dirección está asignada a este Gateway",{"_3328":67671,"_29138":67653,"_20209":112367,"_5":13819,"_26493":112315,"_2816":112368},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3328":67672,"_29138":67653,"_20209":112370,"_5":13819,"_26493":112315,"_2816":112371},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3328":67673,"_29138":67653,"_20209":112373,"_5":13819,"_26493":112315,"_2816":112374},[],"No confundas estos valores:",{"_3328":67674,"_29138":67653,"_20209":112376,"_5":13819,"_26493":112315,"_2816":112377},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3328":67675,"_29138":67653,"_20209":112379,"_5":13819,"_26493":112315,"_2816":112380},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3328":67676,"_29138":67653,"_20209":112382,"_5":13819,"_26493":112315,"_2816":112383},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3328":67677,"_29138":67653,"_20209":112385,"_5":13819,"_26493":112319,"_2816":112386},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3328":67678,"_29138":67653,"_20209":112388,"_5":13819,"_26493":112319,"_2816":112389},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3328":67679,"_29138":67653,"_20209":112391,"_5":13819,"_26493":112323,"_2816":112392},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3328":67680,"_29138":67653,"_20209":112394,"_5":13819,"_26493":112323,"_2816":112395},[],"Para el diseño recomendado:",{"_3328":67681,"_29138":67653,"_20209":112397,"_5":13819,"_26493":112323,"_2816":112398},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3328":67682,"_29138":67653,"_20209":112400,"_5":13819,"_26493":112323,"_2816":112401},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3328":67683,"_29138":67653,"_20209":112403,"_5":13819,"_26493":112323,"_2816":112404},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3328":67684,"_29138":67653,"_20209":112406,"_5":13819,"_26493":112323,"_2816":112407},[],"Apunta DNS a la dirección accesible de la VM.",{"_3328":67685,"_29138":67653,"_20209":112409,"_5":13819,"_26493":112323,"_2816":112410},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3328":67686,"_29138":67653,"_20209":112412,"_5":13819,"_26493":112326,"_2816":112413},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3328":67687,"_29138":67653,"_20209":112415,"_5":13819,"_26493":112330,"_2816":112416},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3328":67688,"_29138":67653,"_20209":112418,"_5":13819,"_26493":112330,"_2816":112419},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3328":67689,"_29138":67653,"_20209":112421,"_5":13819,"_26493":112334,"_2816":112422},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3328":67690,"_29138":67653,"_20209":112424,"_5":13819,"_26493":112334,"_2816":112425},[],"Requisito",{"_3328":67691,"_29138":67653,"_20209":112427,"_5":13819,"_26493":112334,"_2816":112428},[],"Diseño recomendado",{"_3328":67692,"_29138":67653,"_20209":112430,"_5":13819,"_26493":112334,"_2816":112431},[],"Consecuencia",{"_3328":67693,"_29138":67653,"_20209":112433,"_5":13819,"_26493":112334,"_2816":112434},[],"Varias URL o servicios de Lamassu",{"_3328":67694,"_29138":67653,"_20209":112436,"_5":13819,"_26493":112334,"_2816":112437},[],"Un Gateway con varias rutas",{"_3328":67695,"_29138":67653,"_20209":112439,"_5":13819,"_26493":112334,"_2816":112440},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3328":67696,"_29138":67653,"_20209":112442,"_5":13819,"_26493":112334,"_2816":112443},[],"Gateways independientes e IP externas distintas",{"_3328":67697,"_29138":67653,"_20209":112445,"_5":13819,"_26493":112334,"_2816":112446},[],"Una VIP por Gateway",{"_3328":67698,"_29138":67653,"_20209":112448,"_5":13819,"_26493":112334,"_2816":112449},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3328":67699,"_29138":67653,"_20209":112451,"_5":13819,"_26493":112334,"_2816":112452},[],"Gateways independientes, un nodo y una IP",{"_3328":67700,"_29138":67653,"_20209":112454,"_5":13819,"_26493":112334,"_2816":112455},[],"Puertos externos diferentes",{"_3328":67701,"_29138":67653,"_20209":112457,"_5":13819,"_26493":112334,"_2816":112458},[],"Los clientes deben indicar puertos no estándar",{"_3328":67702,"_29138":67653,"_20209":112460,"_5":13819,"_26493":112334,"_2816":112461},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3328":67703,"_29138":67653,"_20209":112463,"_5":13819,"_26493":112334,"_2816":112464},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3328":67704,"_29138":67653,"_20209":112466,"_5":13819,"_26493":112334,"_2816":112467},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3328":67705,"_29138":67653,"_20209":112469,"_5":13819,"_26493":112334,"_2816":112470},[],"Recursos Gateway separados pero proxy compartido",{"_3328":67706,"_29138":67653,"_20209":112472,"_5":13819,"_26493":112334,"_2816":112473},[],"Modo merged Gateway de Envoy",{"_3328":67707,"_29138":67653,"_20209":112475,"_5":13819,"_26493":112334,"_2816":112476},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3328":67708,"_29138":67653,"_20209":112478,"_5":13819,"_26493":112334,"_2816":112479},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3328":67709,"_29138":67653,"_20209":112481,"_5":13819,"_26493":112334,"_2816":112482},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3328":67710,"_29138":67653,"_20209":112484,"_5":13819,"_26493":112334,"_2816":112485},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3328":67711,"_29138":67653,"_20209":112487,"_5":13819,"_26493":112334,"_2816":112488},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3328":67712,"_29138":67653,"_20209":112490,"_5":13819,"_26493":112338,"_2816":112491},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3328":67713,"_29138":67653,"_20209":112493,"_5":13819,"_26493":112338,"_2816":112494},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3328":67714,"_29138":67653,"_20209":112496,"_5":13819,"_26493":112338,"_2816":112497},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3328":67715,"_29138":67653,"_20209":112499,"_5":13819,"_26493":112338,"_2816":112500},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3328":67716,"_29138":67653,"_20209":112502,"_5":13819,"_26493":112338,"_2816":112503},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3328":67717,"_29138":67653,"_20209":112505,"_5":13819,"_26493":112342,"_2816":112506},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3328":67718,"_29138":67653,"_20209":112508,"_5":13819,"_26493":112342,"_2816":112509},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3328":67719,"_29138":67653,"_20209":112511,"_5":13819,"_26493":112346,"_2816":112512},[],"Comprueba, en orden:",{"_3328":67720,"_29138":67653,"_20209":112514,"_5":13819,"_26493":112346,"_2816":112515},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3328":67721,"_29138":67653,"_20209":112517,"_5":13819,"_26493":112346,"_2816":112518},[],"Su estado contiene la dirección esperada.",{"_3328":67722,"_29138":67653,"_20209":112520,"_5":13819,"_26493":112346,"_2816":112521},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3328":67723,"_29138":67653,"_20209":112523,"_5":13819,"_26493":112346,"_2816":112524},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3328":67724,"_29138":67653,"_20209":112526,"_5":13819,"_26493":112346,"_2816":112527},[],"DNS resuelve al endpoint accesible externamente.",{"_3328":67725,"_29138":67653,"_20209":112529,"_5":13819,"_26493":112346,"_2816":112530},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3328":67726,"_29138":67653,"_20209":112532,"_5":13819,"_26493":112346,"_2816":112533},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3328":67727,"_29138":67727,"_5":14177,"_2816":47536,"_29482":112535,"_20209":112536,"_26493":67727},[47429,111532,111766],[],{"_3328":67728,"_29138":67727,"_20209":112538,"_5":13819,"_26493":67727,"_2816":112539},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3328":67729,"_29138":67727,"_5":29479,"_20209":112541,"_26493":112542,"_2816":112543},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3328":67730,"_29138":67727,"_5":29479,"_20209":112545,"_26493":112546,"_2816":112547},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3328":67731,"_29138":67727,"_5":29479,"_20209":112549,"_26493":112550,"_2816":112551},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3328":67732,"_29138":67727,"_5":29479,"_20209":112553,"_26493":112554,"_2816":112555},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3328":67733,"_29138":67727,"_5":29479,"_20209":112557,"_26493":112558,"_2816":112559},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3328":67734,"_29138":67727,"_5":29479,"_20209":112561,"_26493":112562,"_2816":112563},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3328":67735,"_29138":67727,"_20209":112565,"_5":13819,"_26493":112542,"_2816":112566},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3328":67736,"_29138":67727,"_20209":112568,"_5":13819,"_26493":112546,"_2816":112569},[],"Flujo",{"_3328":67737,"_29138":67727,"_20209":112571,"_5":13819,"_26493":112546,"_2816":112572},[],"Úsalo para",{"_3328":67738,"_29138":67727,"_20209":112574,"_5":13819,"_26493":112546,"_2816":112575},[],"Qué instala",{"_3328":67739,"_29138":67727,"_20209":112577,"_5":13819,"_26493":112546,"_2816":48510},[],{"_3328":67740,"_29138":67727,"_20209":112579,"_5":13819,"_26493":112546,"_2816":112580},[],"Producción y entornos controlados",{"_3328":67741,"_29138":67727,"_20209":112582,"_5":13819,"_26493":112546,"_2816":112583},[],"Servicios de Lamassu y recursos de Gateway API",{"_3328":67742,"_29138":67727,"_20209":112585,"_5":13819,"_26493":112546,"_2816":47673},[],{"_3328":67743,"_29138":67727,"_20209":112587,"_5":13819,"_26493":112546,"_2816":112588},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3328":67744,"_29138":67727,"_20209":112590,"_5":13819,"_26493":112546,"_2816":112591},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3328":67745,"_29138":67727,"_20209":112593,"_5":13819,"_26493":112550,"_2816":112594},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3328":67746,"_29138":67727,"_20209":112596,"_5":13819,"_26493":112550,"_2816":112597},[],"Área",{"_3328":67747,"_29138":67727,"_20209":112599,"_5":13819,"_26493":112550,"_2816":112600},[],"El chart de Lamassu proporciona",{"_3328":67748,"_29138":67727,"_20209":112602,"_5":13819,"_26493":112550,"_2816":112603},[],"Tú proporcionas",{"_3328":67749,"_29138":67727,"_20209":112605,"_5":13819,"_26493":112550,"_2816":112606},[],"Aplicaciones Lamassu",{"_3328":67750,"_29138":67727,"_20209":112608,"_5":13819,"_26493":112550,"_2816":112609},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3328":67751,"_29138":67727,"_20209":112611,"_5":13819,"_26493":112550,"_2816":112612},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3328":67752,"_29138":67727,"_20209":112614,"_5":13819,"_26493":112550,"_2816":112615},[],"Datos PostgreSQL",{"_3328":67753,"_29138":67727,"_20209":112617,"_5":13819,"_26493":112550,"_2816":112618},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3328":67754,"_29138":67727,"_20209":112620,"_5":13819,"_26493":112550,"_2816":112621},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3328":67755,"_29138":67727,"_20209":112623,"_5":13819,"_26493":112550,"_2816":112624},[],"Mensajería",{"_3328":67756,"_29138":67727,"_20209":112626,"_5":13819,"_26493":112550,"_2816":112627},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3328":67757,"_29138":67727,"_20209":112629,"_5":13819,"_26493":112550,"_2816":112630},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3328":67758,"_29138":67727,"_20209":112632,"_5":13819,"_26493":112550,"_2816":112633},[],"Identidad",{"_3328":67759,"_29138":67727,"_20209":112635,"_5":13819,"_26493":112550,"_2816":112636},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3328":67760,"_29138":67727,"_20209":112638,"_5":13819,"_26493":112550,"_2816":112639},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3328":67761,"_29138":67727,"_20209":112641,"_5":13819,"_26493":112550,"_2816":112642},[],"Enrutamiento externo",{"_3328":67762,"_29138":67727,"_20209":112644,"_5":13819,"_26493":112550,"_2816":112645},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3328":67763,"_29138":67727,"_20209":112647,"_5":13819,"_26493":112550,"_2816":112648},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3328":67764,"_29138":67727,"_20209":112650,"_5":13819,"_26493":112550,"_2816":48584},[],{"_3328":67765,"_29138":67727,"_20209":112652,"_5":13819,"_26493":112550,"_2816":112653},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3328":67766,"_29138":67727,"_20209":112655,"_5":13819,"_26493":112550,"_2816":112656},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3328":67767,"_29138":67727,"_20209":112658,"_5":13819,"_26493":112550,"_2816":112659},[],"Datos persistentes de la aplicación",{"_3328":67768,"_29138":67727,"_20209":112661,"_5":13819,"_26493":112550,"_2816":112662},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3328":67769,"_29138":67727,"_20209":112664,"_5":13819,"_26493":112550,"_2816":112665},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3328":67770,"_29138":67727,"_20209":112667,"_5":13819,"_26493":112550,"_2816":112668},[],"Integraciones opcionales",{"_3328":67771,"_29138":67727,"_20209":112670,"_5":13819,"_26493":112550,"_2816":112671},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3328":67772,"_29138":67727,"_20209":112673,"_5":13819,"_26493":112550,"_2816":112674},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3328":67773,"_29138":67727,"_20209":112676,"_5":13819,"_26493":112550,"_2816":112677},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3328":67774,"_29138":67727,"_20209":112679,"_5":13819,"_26493":112550,"_2816":112680},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3328":67775,"_29138":67727,"_20209":112682,"_5":13819,"_26493":112554,"_2816":112683},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3328":67776,"_29138":67727,"_20209":112685,"_5":13819,"_26493":112554,"_2816":112686},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3328":67777,"_29138":67727,"_20209":112688,"_5":13819,"_26493":112558,"_2816":112689},[],"Kubernetes 1.24 o posterior",{"_3328":67778,"_29138":67727,"_20209":112691,"_5":13819,"_26493":112558,"_2816":112692},[],"Helm 3.2 o posterior",{"_3328":67779,"_29138":67727,"_20209":112694,"_5":13819,"_26493":112558,"_2816":112695},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3328":67780,"_29138":67727,"_20209":112697,"_5":13819,"_26493":112558,"_2816":112698},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3328":67781,"_29138":67727,"_20209":112700,"_5":13819,"_26493":112558,"_2816":112701},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3328":67782,"_29138":67727,"_20209":112703,"_5":13819,"_26493":112558,"_2816":112704},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3328":67783,"_29138":67727,"_20209":112706,"_5":13819,"_26493":112558,"_2816":112707},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3328":67784,"_29138":67727,"_20209":112709,"_5":13819,"_26493":112562,"_2816":112710},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3328":67785,"_29138":67727,"_20209":112712,"_5":13819,"_26493":112562,"_2816":112713},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3328":67786,"_29138":67727,"_20209":112715,"_5":13819,"_26493":112562,"_2816":112716},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3328":67787,"_29138":67727,"_20209":112718,"_5":13819,"_26493":112562,"_2816":112719},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3328":67788,"_29138":67788,"_5":14177,"_2816":112721,"_29482":112722,"_20209":112724,"_26493":67788},"Resolución de problemas de despliegue",[47429,111532,112723],"Operación",[],{"_3328":67789,"_29138":67788,"_20209":112726,"_5":13819,"_26493":67788,"_2816":112727},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3328":67790,"_29138":67788,"_5":29479,"_20209":112729,"_26493":112730,"_2816":112731},[],"/docs/pr-preview/pr-45/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3328":67791,"_29138":67788,"_5":29479,"_20209":112733,"_26493":112734,"_2816":112735},[],"/docs/pr-preview/pr-45/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3328":67792,"_29138":67788,"_5":29479,"_20209":112737,"_26493":112738,"_2816":112739},[],"/docs/pr-preview/pr-45/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3328":67793,"_29138":67788,"_5":29479,"_20209":112741,"_26493":112742,"_2816":112743},[],"/docs/pr-preview/pr-45/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3328":67794,"_29138":67788,"_5":29479,"_20209":112745,"_26493":112746,"_2816":112747},[],"/docs/pr-preview/pr-45/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3328":67795,"_29138":67788,"_5":29479,"_20209":112749,"_26493":112750,"_2816":112751},[],"/docs/pr-preview/pr-45/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3328":67796,"_29138":67788,"_5":29479,"_20209":112753,"_26493":112754,"_2816":112755},[],"/docs/pr-preview/pr-45/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3328":67797,"_29138":67788,"_5":29479,"_20209":112757,"_26493":112758,"_2816":112759},[],"/docs/pr-preview/pr-45/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3328":67798,"_29138":67788,"_5":29479,"_20209":112761,"_26493":112762,"_2816":112763},[],"/docs/pr-preview/pr-45/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3328":67799,"_29138":67788,"_5":29479,"_20209":112765,"_26493":112766,"_2816":112767},[],"/docs/pr-preview/pr-45/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3328":67800,"_29138":67788,"_5":29479,"_20209":112769,"_26493":112770,"_2816":112771},[],"/docs/pr-preview/pr-45/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3328":67801,"_29138":67788,"_5":29479,"_20209":112773,"_26493":112774,"_2816":112775},[],"/docs/pr-preview/pr-45/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3328":67802,"_29138":67788,"_5":29479,"_20209":112777,"_26493":112778,"_2816":112779},[],"/docs/pr-preview/pr-45/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3328":67803,"_29138":67788,"_20209":112781,"_5":13819,"_26493":67788,"_2816":112782},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3328":67804,"_29138":67788,"_20209":112784,"_5":13819,"_26493":112734,"_2816":112785},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3328":67805,"_29138":67788,"_20209":112787,"_5":13819,"_26493":112738,"_2816":112788},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3328":67806,"_29138":67788,"_20209":112790,"_5":13819,"_26493":112742,"_2816":112791},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3328":67807,"_29138":67788,"_20209":112793,"_5":13819,"_26493":112746,"_2816":112794},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3328":67808,"_29138":67788,"_20209":112796,"_5":13819,"_26493":112750,"_2816":112797},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3328":67809,"_29138":67788,"_20209":112799,"_5":13819,"_26493":112754,"_2816":112800},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3328":67810,"_29138":67788,"_20209":112802,"_5":13819,"_26493":112754,"_2816":112803},[],"Ejecuta también la prueba de conectividad del chart:",{"_3328":67811,"_29138":67788,"_20209":112805,"_5":13819,"_26493":112754,"_2816":112806},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3328":67812,"_29138":67788,"_20209":112808,"_5":13819,"_26493":112754,"_2816":112809},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3328":67813,"_29138":67788,"_20209":112811,"_5":13819,"_26493":112758,"_2816":112812},[],"Si recibes un 401:",{"_3328":67814,"_29138":67788,"_20209":112814,"_5":13819,"_26493":112758,"_2816":112815},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3328":67815,"_29138":67788,"_20209":112817,"_5":13819,"_26493":112758,"_2816":112818},[],"verifica emisor, audiencia y expiración del token;",{"_3328":67816,"_29138":67788,"_20209":112820,"_5":13819,"_26493":112758,"_2816":112821},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3328":67817,"_29138":67788,"_20209":112823,"_5":13819,"_26493":112758,"_2816":112824},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3328":67818,"_29138":67788,"_20209":112826,"_5":13819,"_26493":112758,"_2816":112827},[],"Si el login termina pero las APIs devuelven 403:",{"_3328":67819,"_29138":67788,"_20209":112829,"_5":13819,"_26493":112758,"_2816":112830},[],"inspecciona los claims reales del token;",{"_3328":67820,"_29138":67788,"_20209":112832,"_5":13819,"_26493":112758,"_2816":112833},[],"confirma que coinciden con un principal activo;",{"_3328":67821,"_29138":67788,"_20209":112835,"_5":13819,"_26493":112758,"_2816":112836},[],"revisa las políticas concedidas al principal;",{"_3328":67822,"_29138":67788,"_20209":112838,"_5":13819,"_26493":112758,"_2816":112839},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3328":67823,"_29138":67788,"_20209":112841,"_5":13819,"_26493":112758,"_2816":112842},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3328":67824,"_29138":67788,"_20209":112844,"_5":13819,"_26493":112762,"_2816":112845},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3328":67825,"_29138":67788,"_20209":112847,"_5":13819,"_26493":112762,"_2816":112848},[],"Localiza el pod y Service de authz.",{"_3328":67826,"_29138":67788,"_20209":112850,"_5":13819,"_26493":112762,"_2816":112851},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3328":67827,"_29138":67788,"_20209":112853,"_5":13819,"_26493":112762,"_2816":112854},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3328":67828,"_29138":67788,"_20209":112856,"_5":13819,"_26493":112762,"_2816":112857},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3328":67829,"_29138":67788,"_20209":112859,"_5":13819,"_26493":112762,"_2816":112860},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3328":67830,"_29138":67788,"_20209":112862,"_5":13819,"_26493":112766,"_2816":112863},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3328":67831,"_29138":67788,"_20209":112865,"_5":13819,"_26493":112770,"_2816":112866},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3328":67832,"_29138":67788,"_20209":112868,"_5":13819,"_26493":112770,"_2816":112869},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3328":67833,"_29138":67788,"_20209":112871,"_5":13819,"_26493":112770,"_2816":112872},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3328":67834,"_29138":67788,"_20209":112874,"_5":13819,"_26493":112770,"_2816":112875},[],"volumen persistente sin enlazar;",{"_3328":67835,"_29138":67788,"_20209":112877,"_5":13819,"_26493":112770,"_2816":112878},[],"imagen inaccesible o política de pull incorrecta;",{"_3328":67836,"_29138":67788,"_20209":112880,"_5":13819,"_26493":112770,"_2816":112881},[],"configuración inválida del motor criptográfico;",{"_3328":67837,"_29138":67788,"_20209":112883,"_5":13819,"_26493":112770,"_2816":112884},[],"límites de CPU o memoria demasiado bajos;",{"_3328":67838,"_29138":67788,"_20209":112886,"_5":13819,"_26493":112770,"_2816":112887},[],"migración previa incompleta.",{"_3328":67839,"_29138":67788,"_20209":112889,"_5":13819,"_26493":112770,"_2816":112890},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3328":67840,"_29138":67788,"_20209":112892,"_5":13819,"_26493":112770,"_2816":112893},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3328":67841,"_29138":67788,"_20209":112895,"_5":13819,"_26493":112770,"_2816":112896},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3328":67842,"_29138":67788,"_20209":112898,"_5":13819,"_26493":112774,"_2816":112899},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3328":67843,"_29138":67788,"_20209":112901,"_5":13819,"_26493":112774,"_2816":112902},[],"verifica que esté habilitado en el servicio emisor;",{"_3328":67844,"_29138":67788,"_20209":112904,"_5":13819,"_26493":112774,"_2816":112905},[],"comprueba conectividad y credenciales AMQP;",{"_3328":67845,"_29138":67788,"_20209":112907,"_5":13819,"_26493":112774,"_2816":112908},[],"revisa exchange, routing key, colas y consumidores;",{"_3328":67846,"_29138":67788,"_20209":112910,"_5":13819,"_26493":112774,"_2816":112911},[],"inspecciona dead-letter queues;",{"_3328":67847,"_29138":67788,"_20209":112913,"_5":13819,"_26493":112774,"_2816":112914},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3328":67848,"_29138":67788,"_20209":112916,"_5":13819,"_26493":112774,"_2816":112917},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3328":67849,"_29138":67788,"_20209":112919,"_5":13819,"_26493":112774,"_2816":112920},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3328":67850,"_29138":67788,"_20209":112922,"_5":13819,"_26493":112774,"_2816":112923},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3328":67851,"_29138":67788,"_20209":112925,"_5":13819,"_26493":112774,"_2816":112926},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3328":67852,"_29138":67788,"_20209":112928,"_5":13819,"_26493":112774,"_2816":112929},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3328":67853,"_29138":67788,"_20209":112931,"_5":13819,"_26493":112774,"_2816":112932},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3328":67854,"_29138":67788,"_20209":112934,"_5":13819,"_26493":112774,"_2816":112935},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3328":67855,"_29138":67788,"_20209":112937,"_5":13819,"_26493":112778,"_2816":112938},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3328":67856,"_29138":67788,"_20209":112940,"_5":13819,"_26493":112778,"_2816":112941},[],"Antes de cerrar una incidencia, guarda:",{"_3328":67857,"_29138":67788,"_20209":112943,"_5":13819,"_26493":112778,"_2816":112944},[],"causa confirmada;",{"_3328":67858,"_29138":67788,"_20209":112946,"_5":13819,"_26493":112778,"_2816":112947},[],"alcance temporal y recursos afectados;",{"_3328":67859,"_29138":67788,"_20209":112949,"_5":13819,"_26493":112778,"_2816":112950},[],"comandos o consultas utilizados;",{"_3328":67860,"_29138":67788,"_20209":112952,"_5":13819,"_26493":112778,"_2816":112953},[],"cambio aplicado y forma de revertirlo;",{"_3328":67861,"_29138":67788,"_20209":112955,"_5":13819,"_26493":112778,"_2816":112956},[],"validación desde un consumidor;",{"_3328":67862,"_29138":67788,"_20209":112958,"_5":13819,"_26493":112778,"_2816":112959},[],"acción preventiva y propietario.",{"_3328":67863,"_29138":67863,"_5":14177,"_2816":112961,"_29482":112962,"_20209":112965,"_26493":67863},"Control de acceso",[47429,112963,112964],"Plataforma","Administración",[],{"_3328":67864,"_29138":67863,"_20209":112967,"_5":13819,"_26493":67863,"_2816":112968},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3328":67865,"_29138":67863,"_5":29479,"_20209":112970,"_26493":112971,"_2816":112972},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3328":67866,"_29138":67863,"_5":29479,"_20209":112974,"_26493":112975,"_2816":112976},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3328":67867,"_29138":67863,"_5":29479,"_20209":112978,"_26493":112979,"_2816":112980},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3328":67868,"_29138":67863,"_5":29479,"_20209":112982,"_26493":112983,"_2816":112984},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3328":67869,"_29138":67863,"_5":29479,"_20209":112986,"_26493":112987,"_2816":112988},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3328":67870,"_29138":67863,"_5":29479,"_20209":112990,"_26493":112991,"_2816":112992},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3328":67871,"_29138":67863,"_5":29479,"_20209":112994,"_26493":112995,"_2816":112996},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3328":67872,"_29138":67863,"_5":29479,"_20209":112998,"_26493":112999,"_2816":113000},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3328":67873,"_29138":67863,"_5":29479,"_20209":113002,"_26493":113003,"_2816":113004},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3328":67874,"_29138":67863,"_5":29479,"_20209":113006,"_26493":113007,"_2816":113008},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3328":67875,"_29138":67863,"_5":29479,"_20209":113010,"_26493":113011,"_2816":113012},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3328":67876,"_29138":67863,"_5":29479,"_20209":113014,"_26493":113015,"_2816":113016},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3328":67877,"_29138":67863,"_5":29479,"_20209":113018,"_26493":113019,"_2816":113020},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3328":67878,"_29138":67863,"_5":29479,"_20209":113022,"_26493":113023,"_2816":113024},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3328":67879,"_29138":67863,"_5":29479,"_20209":113026,"_26493":113027,"_2816":113028},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3328":67880,"_29138":67863,"_5":29479,"_20209":113030,"_26493":113031,"_2816":112138},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3328":67881,"_29138":67863,"_5":29479,"_20209":113033,"_26493":113034,"_2816":113035},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3328":67882,"_29138":67863,"_5":29479,"_20209":113037,"_26493":113038,"_2816":113039},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3328":67883,"_29138":67863,"_5":29479,"_20209":113041,"_26493":113042,"_2816":113043},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3328":67884,"_29138":67863,"_5":29479,"_20209":113045,"_26493":113046,"_2816":113047},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3328":67885,"_29138":67863,"_5":29479,"_20209":113049,"_26493":113050,"_2816":113051},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3328":67886,"_29138":67863,"_5":29479,"_20209":113053,"_26493":113054,"_2816":113055},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3328":67887,"_29138":67863,"_5":29479,"_20209":113057,"_26493":113058,"_2816":113059},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3328":67888,"_29138":67863,"_5":29479,"_20209":113061,"_26493":113062,"_2816":113063},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3328":67889,"_29138":67863,"_5":29479,"_20209":113065,"_26493":113066,"_2816":113067},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3328":67890,"_29138":67863,"_5":29479,"_20209":113069,"_26493":113070,"_2816":113071},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3328":67891,"_29138":67863,"_5":29479,"_20209":113073,"_26493":113074,"_2816":113075},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3328":67892,"_29138":67863,"_5":29479,"_20209":113077,"_26493":113078,"_2816":113079},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3328":67893,"_29138":67863,"_5":29479,"_20209":113081,"_26493":113082,"_2816":113083},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3328":67894,"_29138":67863,"_5":29479,"_20209":113085,"_26493":113086,"_2816":113087},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3328":67895,"_29138":67863,"_5":29479,"_20209":113089,"_26493":113090,"_2816":113091},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3328":67896,"_29138":67863,"_20209":113093,"_5":13819,"_26493":67863,"_2816":113094},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3328":67897,"_29138":67863,"_20209":113096,"_5":13819,"_26493":67863,"_2816":113097},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3328":67898,"_29138":67863,"_20209":113099,"_5":13819,"_26493":67863,"_2816":113100},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3328":67899,"_29138":67863,"_20209":113102,"_5":13819,"_26493":112971,"_2816":113103},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3328":67900,"_29138":67863,"_20209":113105,"_5":13819,"_26493":112971,"_2816":113106},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3328":67901,"_29138":67863,"_20209":113108,"_5":13819,"_26493":112971,"_2816":113109},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3328":67902,"_29138":67863,"_20209":113111,"_5":13819,"_26493":112971,"_2816":113112},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3328":67903,"_29138":67863,"_20209":113114,"_5":13819,"_26493":112971,"_2816":113115},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3328":67904,"_29138":67863,"_20209":113117,"_5":13819,"_26493":112971,"_2816":113118},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3328":67905,"_29138":67863,"_20209":113120,"_5":13819,"_26493":112975,"_2816":113121},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3328":67906,"_29138":67863,"_20209":113123,"_5":13819,"_26493":112975,"_2816":113124},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3328":67907,"_29138":67863,"_20209":113126,"_5":13819,"_26493":112979,"_2816":113127},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3328":67908,"_29138":67863,"_20209":113129,"_5":13819,"_26493":112979,"_2816":113130},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3328":67909,"_29138":67863,"_20209":113132,"_5":13819,"_26493":112979,"_2816":113133},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3328":67910,"_29138":67863,"_20209":113135,"_5":13819,"_26493":112979,"_2816":113136},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3328":67911,"_29138":67863,"_20209":113138,"_5":13819,"_26493":112979,"_2816":113139},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3328":67912,"_29138":67863,"_20209":113141,"_5":13819,"_26493":112979,"_2816":113142},[],"Carga por separado las políticas concedidas a cada principal.",{"_3328":67913,"_29138":67863,"_20209":113144,"_5":13819,"_26493":112979,"_2816":113145},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3328":67914,"_29138":67863,"_20209":113147,"_5":13819,"_26493":112979,"_2816":113148},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3328":67915,"_29138":67863,"_20209":113150,"_5":13819,"_26493":112979,"_2816":113151},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3328":67916,"_29138":67863,"_20209":113153,"_5":13819,"_26493":112979,"_2816":113154},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3328":67917,"_29138":67863,"_20209":113156,"_5":13819,"_26493":112979,"_2816":113157},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3328":67918,"_29138":67863,"_20209":113159,"_5":13819,"_26493":112979,"_2816":113160},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3328":67919,"_29138":67863,"_20209":113162,"_5":13819,"_26493":112983,"_2816":113163},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3328":67920,"_29138":67863,"_20209":113165,"_5":13819,"_26493":112983,"_2816":113166},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3328":67921,"_29138":67863,"_20209":113168,"_5":13819,"_26493":112983,"_2816":113169},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3328":67922,"_29138":67863,"_20209":113171,"_5":13819,"_26493":112983,"_2816":113172},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3328":67923,"_29138":67863,"_20209":113174,"_5":13819,"_26493":112983,"_2816":113175},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3328":67924,"_29138":67863,"_20209":113177,"_5":13819,"_26493":112983,"_2816":113178},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3328":67925,"_29138":67863,"_20209":113180,"_5":13819,"_26493":112983,"_2816":113181},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3328":67926,"_29138":67863,"_20209":113183,"_5":13819,"_26493":112983,"_2816":113184},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3328":67927,"_29138":67863,"_20209":113186,"_5":13819,"_26493":112987,"_2816":113187},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3328":67928,"_29138":67863,"_20209":113189,"_5":13819,"_26493":112987,"_2816":113190},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3328":67929,"_29138":67863,"_20209":113192,"_5":13819,"_26493":112987,"_2816":113193},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3328":67930,"_29138":67863,"_20209":113195,"_5":13819,"_26493":112987,"_2816":113196},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3328":67931,"_29138":67863,"_20209":113198,"_5":13819,"_26493":112987,"_2816":113199},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3328":67932,"_29138":67863,"_20209":113201,"_5":13819,"_26493":112987,"_2816":113202},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3328":67933,"_29138":67863,"_20209":113204,"_5":13819,"_26493":112987,"_2816":113205},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3328":67934,"_29138":67863,"_20209":113207,"_5":13819,"_26493":112987,"_2816":113208},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3328":67935,"_29138":67863,"_20209":113210,"_5":13819,"_26493":112987,"_2816":113211},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3328":67936,"_29138":67863,"_20209":113213,"_5":13819,"_26493":112987,"_2816":113214},[],"Las acciones se dividen en dos grupos:",{"_3328":67937,"_29138":67863,"_20209":113216,"_5":13819,"_26493":112987,"_2816":113217},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3328":67938,"_29138":67863,"_20209":113219,"_5":13819,"_26493":112987,"_2816":113220},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3328":67939,"_29138":67863,"_20209":113222,"_5":13819,"_26493":112987,"_2816":113223},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3328":67940,"_29138":67863,"_20209":113225,"_5":13819,"_26493":112991,"_2816":113226},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3328":67941,"_29138":67863,"_20209":113228,"_5":13819,"_26493":112991,"_2816":113229},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3328":67942,"_29138":67863,"_20209":113231,"_5":13819,"_26493":112991,"_2816":113232},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3328":67943,"_29138":67863,"_20209":113234,"_5":13819,"_26493":112995,"_2816":113235},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3328":67944,"_29138":67863,"_20209":113237,"_5":13819,"_26493":112995,"_2816":113238},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3328":67945,"_29138":67863,"_20209":113240,"_5":13819,"_26493":112995,"_2816":113241},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3328":67946,"_29138":67863,"_20209":113243,"_5":13819,"_26493":112995,"_2816":113244},[],"Los operadores implementados son:",{"_3328":67947,"_29138":67863,"_20209":113246,"_5":13819,"_26493":112995,"_2816":113247},[],"`equals`, para igualdad exacta;",{"_3328":67948,"_29138":67863,"_20209":113249,"_5":13819,"_26493":112995,"_2816":113250},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3328":67949,"_29138":67863,"_20209":113252,"_5":13819,"_26493":112995,"_2816":113253},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3328":67950,"_29138":67863,"_20209":113255,"_5":13819,"_26493":112995,"_2816":113256},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3328":67951,"_29138":67863,"_20209":113258,"_5":13819,"_26493":112999,"_2816":113259},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3328":67952,"_29138":67863,"_20209":113261,"_5":13819,"_26493":112999,"_2816":113262},[],"Los modos disponibles son:",{"_3328":67953,"_29138":67863,"_20209":113264,"_5":13819,"_26493":112999,"_2816":113265},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3328":67954,"_29138":67863,"_20209":113267,"_5":13819,"_26493":112999,"_2816":113268},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3328":67955,"_29138":67863,"_20209":113270,"_5":13819,"_26493":112999,"_2816":113271},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3328":67956,"_29138":67863,"_20209":113273,"_5":13819,"_26493":112999,"_2816":113274},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3328":67957,"_29138":67863,"_20209":113276,"_5":13819,"_26493":112999,"_2816":113277},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3328":67958,"_29138":67863,"_20209":113279,"_5":13819,"_26493":112999,"_2816":113280},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3328":67959,"_29138":67863,"_20209":113282,"_5":13819,"_26493":113003,"_2816":113283},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3328":67960,"_29138":67863,"_20209":113285,"_5":13819,"_26493":113003,"_2816":113286},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3328":67961,"_29138":67863,"_20209":113288,"_5":13819,"_26493":113003,"_2816":113289},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3328":67962,"_29138":67863,"_20209":113291,"_5":13819,"_26493":113003,"_2816":113292},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3328":67963,"_29138":67863,"_20209":113294,"_5":13819,"_26493":113011,"_2816":113295},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3328":67964,"_29138":67863,"_20209":113297,"_5":13819,"_26493":113011,"_2816":113298},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3328":67965,"_29138":67863,"_20209":113300,"_5":13819,"_26493":113015,"_2816":113301},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3328":67966,"_29138":67863,"_20209":113303,"_5":13819,"_26493":113015,"_2816":113304},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3328":67967,"_29138":67863,"_20209":113306,"_5":13819,"_26493":113019,"_2816":113307},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3328":67968,"_29138":67863,"_20209":113309,"_5":13819,"_26493":113019,"_2816":113310},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3328":67969,"_29138":67863,"_20209":113312,"_5":13819,"_26493":113019,"_2816":113313},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3328":67970,"_29138":67863,"_20209":113315,"_5":13819,"_26493":113023,"_2816":113316},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3328":67971,"_29138":67863,"_20209":113318,"_5":13819,"_26493":113023,"_2816":113319},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3328":67972,"_29138":67863,"_20209":113321,"_5":13819,"_26493":113023,"_2816":113322},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3328":67973,"_29138":67863,"_20209":113324,"_5":13819,"_26493":113023,"_2816":113325},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3328":67974,"_29138":67863,"_20209":113327,"_5":13819,"_26493":113023,"_2816":113328},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3328":67975,"_29138":67863,"_20209":113330,"_5":13819,"_26493":113023,"_2816":113331},[],"Ten en cuenta que:",{"_3328":67976,"_29138":67863,"_20209":113333,"_5":13819,"_26493":113023,"_2816":113334},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3328":67977,"_29138":67863,"_20209":113336,"_5":13819,"_26493":113023,"_2816":113337},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3328":67978,"_29138":67863,"_20209":113339,"_5":13819,"_26493":113023,"_2816":113340},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3328":67979,"_29138":67863,"_20209":113342,"_5":13819,"_26493":113027,"_2816":113343},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3328":67980,"_29138":67863,"_20209":113345,"_5":13819,"_26493":113027,"_2816":113346},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3328":67981,"_29138":67863,"_20209":113348,"_5":13819,"_26493":113027,"_2816":113349},[],"acceso completo y de solo lectura a KMS;",{"_3328":67982,"_29138":67863,"_20209":113351,"_5":13819,"_26493":113027,"_2816":113352},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3328":67983,"_29138":67863,"_20209":113354,"_5":13819,"_26493":113027,"_2816":113355},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3328":67984,"_29138":67863,"_20209":113357,"_5":13819,"_26493":113027,"_2816":113358},[],"acceso a la interfaz;",{"_3328":67985,"_29138":67863,"_20209":113360,"_5":13819,"_26493":113027,"_2816":113361},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3328":67986,"_29138":67863,"_20209":113363,"_5":13819,"_26493":113027,"_2816":113364},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3328":67987,"_29138":67863,"_20209":113366,"_5":13819,"_26493":113027,"_2816":113367},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3328":67988,"_29138":67863,"_20209":113369,"_5":13819,"_26493":113031,"_2816":113370},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3328":67989,"_29138":67863,"_20209":113372,"_5":13819,"_26493":113031,"_2816":113373},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3328":67990,"_29138":67863,"_20209":113375,"_5":13819,"_26493":113031,"_2816":113376},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3328":67991,"_29138":67863,"_20209":113378,"_5":13819,"_26493":113034,"_2816":113379},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3328":67992,"_29138":67863,"_20209":113381,"_5":13819,"_26493":113038,"_2816":113382},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3328":67993,"_29138":67863,"_20209":113384,"_5":13819,"_26493":113038,"_2816":113385},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3328":67994,"_29138":67863,"_20209":113387,"_5":13819,"_26493":113042,"_2816":113388},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3328":67995,"_29138":67863,"_20209":113390,"_5":13819,"_26493":113046,"_2816":113391},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3328":67996,"_29138":67863,"_20209":113393,"_5":13819,"_26493":113050,"_2816":113394},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3328":67997,"_29138":67863,"_20209":113396,"_5":13819,"_26493":113054,"_2816":113397},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3328":67998,"_29138":67863,"_20209":113399,"_5":13819,"_26493":113054,"_2816":113400},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3328":67999,"_29138":67863,"_20209":113402,"_5":13819,"_26493":113058,"_2816":113403},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3328":68000,"_29138":67863,"_20209":113405,"_5":13819,"_26493":113058,"_2816":113406},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3328":68001,"_29138":67863,"_20209":113408,"_5":13819,"_26493":113058,"_2816":113409},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3328":68002,"_29138":67863,"_20209":113411,"_5":13819,"_26493":113058,"_2816":113412},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3328":68003,"_29138":67863,"_20209":113414,"_5":13819,"_26493":113058,"_2816":113415},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3328":68004,"_29138":67863,"_20209":113417,"_5":13819,"_26493":113058,"_2816":113418},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3328":68005,"_29138":67863,"_20209":113420,"_5":13819,"_26493":113058,"_2816":113421},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3328":68006,"_29138":67863,"_20209":113423,"_5":13819,"_26493":113058,"_2816":113424},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3328":68007,"_29138":67863,"_20209":113426,"_5":13819,"_26493":113062,"_2816":113427},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3328":68008,"_29138":67863,"_20209":113429,"_5":13819,"_26493":113062,"_2816":113430},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3328":68009,"_29138":67863,"_20209":113432,"_5":13819,"_26493":113062,"_2816":113433},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3328":68010,"_29138":67863,"_20209":113435,"_5":13819,"_26493":113066,"_2816":113436},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3328":68011,"_29138":67863,"_20209":113438,"_5":13819,"_26493":113066,"_2816":113439},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3328":68012,"_29138":67863,"_20209":113441,"_5":13819,"_26493":113066,"_2816":113442},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3328":68013,"_29138":67863,"_20209":113444,"_5":13819,"_26493":113066,"_2816":113445},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3328":68014,"_29138":67863,"_20209":113447,"_5":13819,"_26493":113066,"_2816":113448},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3328":68015,"_29138":67863,"_20209":113450,"_5":13819,"_26493":113066,"_2816":113451},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3328":68016,"_29138":67863,"_20209":113453,"_5":13819,"_26493":113066,"_2816":113454},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3328":68017,"_29138":67863,"_20209":113456,"_5":13819,"_26493":113066,"_2816":113457},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3328":68018,"_29138":67863,"_20209":113459,"_5":13819,"_26493":113074,"_2816":113460},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3328":68019,"_29138":67863,"_20209":113462,"_5":13819,"_26493":113078,"_2816":113463},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3328":68020,"_29138":67863,"_20209":113465,"_5":13819,"_26493":113078,"_2816":113466},[],"que exista un principal activo del tipo correcto;",{"_3328":68021,"_29138":67863,"_20209":113468,"_5":13819,"_26493":113078,"_2816":113469},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3328":68022,"_29138":67863,"_20209":113471,"_5":13819,"_26493":113078,"_2816":113472},[],"que todas las condiciones del principal se cumplan;",{"_3328":68023,"_29138":67863,"_20209":113474,"_5":13819,"_26493":113078,"_2816":113475},[],"que el principal tenga concedida la política esperada;",{"_3328":68024,"_29138":67863,"_20209":113477,"_5":13819,"_26493":113078,"_2816":113478},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3328":68025,"_29138":67863,"_20209":113480,"_5":13819,"_26493":113078,"_2816":113481},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3328":68026,"_29138":67863,"_20209":113483,"_5":13819,"_26493":113078,"_2816":113484},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3328":68027,"_29138":67863,"_20209":113486,"_5":13819,"_26493":113082,"_2816":113487},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3328":68028,"_29138":67863,"_20209":113489,"_5":13819,"_26493":113086,"_2816":113490},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3328":68029,"_29138":67863,"_20209":113492,"_5":13819,"_26493":113090,"_2816":113493},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3328":68030,"_29138":67863,"_20209":113495,"_5":13819,"_26493":113090,"_2816":113496},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3328":68031,"_29138":68031,"_5":14177,"_2816":113498,"_29482":113499,"_20209":113500,"_26493":68031},"Alertas y suscripciones",[47429,112963,112964],[],{"_3328":68032,"_29138":68031,"_20209":113502,"_5":13819,"_26493":68031,"_2816":113503},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3328":68033,"_29138":68031,"_5":29479,"_20209":113505,"_26493":113506,"_2816":113507},[],"/docs/pr-preview/pr-45/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3328":68034,"_29138":68031,"_5":29479,"_20209":113509,"_26493":113510,"_2816":113511},[],"/docs/pr-preview/pr-45/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3328":68035,"_29138":68031,"_5":29479,"_20209":113513,"_26493":113514,"_2816":113515},[],"/docs/pr-preview/pr-45/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3328":68036,"_29138":68031,"_5":29479,"_20209":113517,"_26493":113518,"_2816":113519},[],"/docs/pr-preview/pr-45/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3328":68037,"_29138":68031,"_5":29479,"_20209":113521,"_26493":113522,"_2816":113523},[],"/docs/pr-preview/pr-45/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3328":68038,"_29138":68031,"_5":29479,"_20209":113525,"_26493":113526,"_2816":113527},[],"/docs/pr-preview/pr-45/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3328":68039,"_29138":68031,"_5":29479,"_20209":113529,"_26493":113530,"_2816":113531},[],"/docs/pr-preview/pr-45/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3328":68040,"_29138":68031,"_5":29479,"_20209":113533,"_26493":113534,"_2816":113535},[],"/docs/pr-preview/pr-45/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3328":68041,"_29138":68031,"_5":29479,"_20209":113537,"_26493":113538,"_2816":113539},[],"/docs/pr-preview/pr-45/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3328":68042,"_29138":68031,"_5":29479,"_20209":113541,"_26493":113542,"_2816":113543},[],"/docs/pr-preview/pr-45/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3328":68043,"_29138":68031,"_5":29479,"_20209":113545,"_26493":113546,"_2816":113547},[],"/docs/pr-preview/pr-45/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3328":68044,"_29138":68031,"_20209":113549,"_5":13819,"_26493":68031,"_2816":113550},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3328":68045,"_29138":68031,"_20209":113552,"_5":13819,"_26493":113506,"_2816":113553},[],"Un servicio publica un evento de dominio.",{"_3328":68046,"_29138":68031,"_20209":113555,"_5":13819,"_26493":113506,"_2816":113556},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3328":68047,"_29138":68031,"_20209":113558,"_5":13819,"_26493":113506,"_2816":113559},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3328":68048,"_29138":68031,"_20209":113561,"_5":13819,"_26493":113506,"_2816":113562},[],"Lamassu entrega el evento al canal configurado.",{"_3328":68049,"_29138":68031,"_20209":113564,"_5":13819,"_26493":113506,"_2816":113565},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3328":68050,"_29138":68031,"_20209":113567,"_5":13819,"_26493":113510,"_2816":113568},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3328":68051,"_29138":68031,"_20209":113570,"_5":13819,"_26493":113510,"_2816":113571},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3328":68052,"_29138":68031,"_20209":113573,"_5":13819,"_26493":113510,"_2816":113574},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3328":68053,"_29138":68031,"_20209":113576,"_5":13819,"_26493":113510,"_2816":113577},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3328":68054,"_29138":68031,"_20209":113579,"_5":13819,"_26493":113510,"_2816":113580},[],"`apikey_options` necesita `header` y `key`.",{"_3328":68055,"_29138":68031,"_20209":113582,"_5":13819,"_26493":113510,"_2816":113583},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3328":68056,"_29138":68031,"_20209":113585,"_5":13819,"_26493":113510,"_2816":113586},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3328":68057,"_29138":68031,"_20209":113588,"_5":13819,"_26493":113510,"_2816":113589},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3328":68058,"_29138":68031,"_20209":113591,"_5":13819,"_26493":113518,"_2816":113592},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3328":68059,"_29138":68031,"_20209":113594,"_5":13819,"_26493":113522,"_2816":113595},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3328":68060,"_29138":68031,"_20209":113597,"_5":13819,"_26493":113526,"_2816":113598},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3328":68061,"_29138":68031,"_20209":113600,"_5":13819,"_26493":113526,"_2816":113601},[],"**None** notifica todas las instancias del evento.",{"_3328":68062,"_29138":68031,"_20209":113603,"_5":13819,"_26493":113526,"_2816":113604},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3328":68063,"_29138":68031,"_20209":113606,"_5":13819,"_26493":113526,"_2816":113607},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3328":68064,"_29138":68031,"_20209":113609,"_5":13819,"_26493":113526,"_2816":113610},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3328":68065,"_29138":68031,"_20209":113612,"_5":13819,"_26493":113526,"_2816":113613},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3328":68066,"_29138":68031,"_20209":113615,"_5":13819,"_26493":113530,"_2816":113616},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3328":68067,"_29138":68031,"_20209":113618,"_5":13819,"_26493":113534,"_2816":113619},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3328":68068,"_29138":68031,"_20209":113621,"_5":13819,"_26493":113534,"_2816":113622},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3328":68069,"_29138":68031,"_20209":113624,"_5":13819,"_26493":113534,"_2816":113625},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3328":68070,"_29138":68031,"_20209":113627,"_5":13819,"_26493":113534,"_2816":113628},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3328":68071,"_29138":68031,"_20209":113630,"_5":13819,"_26493":113534,"_2816":113631},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3328":68072,"_29138":68031,"_20209":113633,"_5":13819,"_26493":113534,"_2816":113634},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3328":68073,"_29138":68031,"_20209":113636,"_5":13819,"_26493":113534,"_2816":113637},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3328":68074,"_29138":68031,"_20209":113639,"_5":13819,"_26493":113534,"_2816":113640},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3328":68075,"_29138":68031,"_20209":113642,"_5":13819,"_26493":113538,"_2816":113643},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3328":68076,"_29138":68031,"_20209":113645,"_5":13819,"_26493":113538,"_2816":113646},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3328":68077,"_29138":68031,"_20209":113648,"_5":13819,"_26493":113538,"_2816":113649},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3328":68078,"_29138":68031,"_20209":113651,"_5":13819,"_26493":113538,"_2816":113652},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3328":68079,"_29138":68031,"_20209":113654,"_5":13819,"_26493":113538,"_2816":113655},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3328":68080,"_29138":68031,"_20209":113657,"_5":13819,"_26493":113538,"_2816":113658},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3328":68081,"_29138":68031,"_20209":113660,"_5":13819,"_26493":113538,"_2816":113661},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3328":68082,"_29138":68031,"_20209":113663,"_5":13819,"_26493":113538,"_2816":113664},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3328":68083,"_29138":68031,"_20209":113666,"_5":13819,"_26493":113542,"_2816":113667},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3328":68084,"_29138":68031,"_20209":113669,"_5":13819,"_26493":113542,"_2816":113670},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3328":68085,"_29138":68031,"_20209":113672,"_5":13819,"_26493":113546,"_2816":113673},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3328":68086,"_29138":68031,"_20209":113675,"_5":13819,"_26493":113546,"_2816":113676},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3328":68087,"_29138":68031,"_20209":113678,"_5":13819,"_26493":113546,"_2816":113679},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3328":68088,"_29138":68031,"_20209":113681,"_5":13819,"_26493":113546,"_2816":113682},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3328":68089,"_29138":68031,"_20209":113684,"_5":13819,"_26493":113546,"_2816":113685},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3328":68090,"_29138":68031,"_20209":113687,"_5":13819,"_26493":113546,"_2816":113688},[],"**Validación:** `va.role.crl.create`.",{"_3328":68091,"_29138":68031,"_20209":113690,"_5":13819,"_26493":113546,"_2816":113691},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3328":68092,"_29138":68031,"_20209":113693,"_5":13819,"_26493":113546,"_2816":113694},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3328":68093,"_29138":68093,"_5":14177,"_2816":113696,"_29482":113697,"_20209":113698,"_26493":68093},"Registros de auditoría",[47429,112963,112964],[],{"_3328":68094,"_29138":68093,"_20209":113700,"_5":13819,"_26493":68093,"_2816":113701},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3328":68095,"_29138":68093,"_5":29479,"_20209":113703,"_26493":113704,"_2816":113705},[],"/docs/pr-preview/pr-45/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3328":68096,"_29138":68093,"_5":29479,"_20209":113707,"_26493":113708,"_2816":113709},[],"/docs/pr-preview/pr-45/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3328":68097,"_29138":68093,"_5":29479,"_20209":113711,"_26493":113712,"_2816":113713},[],"/docs/pr-preview/pr-45/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3328":68098,"_29138":68093,"_5":29479,"_20209":113715,"_26493":113716,"_2816":113717},[],"/docs/pr-preview/pr-45/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3328":68099,"_29138":68093,"_5":29479,"_20209":113719,"_26493":113720,"_2816":113721},[],"/docs/pr-preview/pr-45/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3328":68100,"_29138":68093,"_5":29479,"_20209":113723,"_26493":113724,"_2816":113725},[],"/docs/pr-preview/pr-45/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3328":68101,"_29138":68093,"_5":29479,"_20209":113727,"_26493":113728,"_2816":113729},[],"/docs/pr-preview/pr-45/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3328":68102,"_29138":68093,"_5":29479,"_20209":113731,"_26493":113732,"_2816":113733},[],"/docs/pr-preview/pr-45/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3328":68103,"_29138":68093,"_5":29479,"_20209":113735,"_26493":113736,"_2816":113737},[],"/docs/pr-preview/pr-45/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3328":68104,"_29138":68093,"_5":29479,"_20209":113739,"_26493":113740,"_2816":113741},[],"/docs/pr-preview/pr-45/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3328":68105,"_29138":68093,"_5":29479,"_20209":113743,"_26493":113744,"_2816":113745},[],"/docs/pr-preview/pr-45/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3328":68106,"_29138":68093,"_20209":113747,"_5":13819,"_26493":68093,"_2816":113748},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3328":68107,"_29138":68093,"_20209":113750,"_5":13819,"_26493":113704,"_2816":113751},[],"El cuerpo de auditoría incluye:",{"_3328":68108,"_29138":68093,"_20209":113753,"_5":13819,"_26493":113704,"_2816":113754},[],"input: datos recibidos por la operación;",{"_3328":68109,"_29138":68093,"_20209":113756,"_5":13819,"_26493":113704,"_2816":113757},[],"has\\_error: indica si el servicio devolvió un error;",{"_3328":68110,"_29138":68093,"_20209":113759,"_5":13819,"_26493":113704,"_2816":113760},[],"output: resultado producido o mensaje de error;",{"_3328":68111,"_29138":68093,"_20209":113762,"_5":13819,"_26493":113704,"_2816":113763},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3328":68112,"_29138":68093,"_20209":113765,"_5":13819,"_26493":113704,"_2816":113766},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3328":68113,"_29138":68093,"_20209":113768,"_5":13819,"_26493":113704,"_2816":113769},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3328":68114,"_29138":68093,"_20209":113771,"_5":13819,"_26493":113708,"_2816":113772},[],"El backend aplica auditoría a mutaciones de:",{"_3328":68115,"_29138":68093,"_20209":113774,"_5":13819,"_26493":113708,"_2816":113775},[],"autoridades, certificados y perfiles de emisión;",{"_3328":68116,"_29138":68093,"_20209":113777,"_5":13819,"_26493":113708,"_2816":113778},[],"claves y motores KMS;",{"_3328":68117,"_29138":68093,"_20209":113780,"_5":13819,"_26493":113708,"_2816":113781},[],"dispositivos e identidades;",{"_3328":68118,"_29138":68093,"_20209":113783,"_5":13819,"_26493":113708,"_2816":113784},[],"DMS y operaciones de enrolamiento;",{"_3328":68119,"_29138":68093,"_20209":113786,"_5":13819,"_26493":113708,"_2816":113787},[],"funciones de validación y CRL;",{"_3328":68120,"_29138":68093,"_20209":113789,"_5":13819,"_26493":113708,"_2816":113790},[],"principales, políticas y concesiones de autorización.",{"_3328":68121,"_29138":68093,"_20209":113792,"_5":13819,"_26493":113708,"_2816":113793},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3328":68122,"_29138":68093,"_20209":113795,"_5":13819,"_26493":113712,"_2816":113796},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3328":68123,"_29138":68093,"_20209":113798,"_5":13819,"_26493":113712,"_2816":113799},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3328":68124,"_29138":68093,"_20209":113801,"_5":13819,"_26493":113712,"_2816":113802},[],"Diseña el consumidor para:",{"_3328":68125,"_29138":68093,"_20209":113804,"_5":13819,"_26493":113712,"_2816":113805},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3328":68126,"_29138":68093,"_20209":113807,"_5":13819,"_26493":113712,"_2816":113808},[],"conservar el CloudEvent completo sin modificar;",{"_3328":68127,"_29138":68093,"_20209":113810,"_5":13819,"_26493":113712,"_2816":113811},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3328":68128,"_29138":68093,"_20209":113813,"_5":13819,"_26493":113712,"_2816":113814},[],"cifrar en tránsito y en reposo;",{"_3328":68129,"_29138":68093,"_20209":113816,"_5":13819,"_26493":113712,"_2816":113817},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3328":68130,"_29138":68093,"_20209":113819,"_5":13819,"_26493":113712,"_2816":113820},[],"aplicar una política explícita de retención y legal hold;",{"_3328":68131,"_29138":68093,"_20209":113822,"_5":13819,"_26493":113712,"_2816":113823},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3328":68132,"_29138":68093,"_20209":113825,"_5":13819,"_26493":113716,"_2816":113826},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3328":68133,"_29138":68093,"_20209":113828,"_5":13819,"_26493":113716,"_2816":113829},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3328":68134,"_29138":68093,"_20209":113831,"_5":13819,"_26493":113724,"_2816":113832},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3328":68135,"_29138":68093,"_20209":113834,"_5":13819,"_26493":113728,"_2816":113835},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3328":68136,"_29138":68093,"_20209":113837,"_5":13819,"_26493":113732,"_2816":113838},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3328":68137,"_29138":68093,"_20209":113840,"_5":13819,"_26493":113736,"_2816":113841},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3328":68138,"_29138":68093,"_20209":113843,"_5":13819,"_26493":113740,"_2816":113844},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3328":68139,"_29138":68093,"_20209":113846,"_5":13819,"_26493":113744,"_2816":113847},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3328":68140,"_29138":68093,"_20209":113849,"_5":13819,"_26493":113744,"_2816":113850},[],"aparece un evento de auditoría correcto;",{"_3328":68141,"_29138":68093,"_20209":113852,"_5":13819,"_26493":113744,"_2816":113853},[],"el principal coincide con la identidad utilizada;",{"_3328":68142,"_29138":68093,"_20209":113855,"_5":13819,"_26493":113744,"_2816":113856},[],"el consumidor lo persiste una sola vez;",{"_3328":68143,"_29138":68093,"_20209":113858,"_5":13819,"_26493":113744,"_2816":113859},[],"puede recuperarse por recurso, actor y periodo;",{"_3328":68144,"_29138":68093,"_20209":113861,"_5":13819,"_26493":113744,"_2816":113862},[],"una interrupción del consumidor produce una alerta.",{"_3328":68145,"_29138":68093,"_20209":113864,"_5":13819,"_26493":113744,"_2816":113865},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3328":68146,"_29138":68146,"_5":14177,"_2816":113867,"_29482":113868,"_20209":113869,"_26493":68146},"Arquitectura de la plataforma",[47429,112963],[],{"_3328":68147,"_29138":68146,"_20209":113871,"_5":13819,"_26493":68146,"_2816":113872},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3328":68148,"_29138":68146,"_5":29479,"_20209":113874,"_26493":113875,"_2816":113876},[],"/docs/pr-preview/pr-45/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3328":68149,"_29138":68146,"_5":29479,"_20209":113878,"_26493":113879,"_2816":113880},[],"/docs/pr-preview/pr-45/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3328":68150,"_29138":68146,"_5":29479,"_20209":113882,"_26493":113883,"_2816":113884},[],"/docs/pr-preview/pr-45/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3328":68151,"_29138":68146,"_5":29479,"_20209":113886,"_26493":113887,"_2816":113888},[],"/docs/pr-preview/pr-45/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3328":68152,"_29138":68146,"_5":29479,"_20209":113890,"_26493":113891,"_2816":113892},[],"/docs/pr-preview/pr-45/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3328":68153,"_29138":68146,"_20209":113894,"_5":13819,"_26493":68146,"_2816":113895},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3328":68154,"_29138":68146,"_20209":113897,"_5":13819,"_26493":68146,"_2816":113898},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3328":68155,"_29138":68146,"_20209":113900,"_5":13819,"_26493":113875,"_2816":113901},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3328":68156,"_29138":68146,"_20209":113903,"_5":13819,"_26493":113879,"_2816":113904},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3328":68157,"_29138":68146,"_20209":113906,"_5":13819,"_26493":113883,"_2816":113907},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3328":68158,"_29138":68146,"_20209":113909,"_5":13819,"_26493":113887,"_2816":113910},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3328":68159,"_29138":68146,"_20209":113912,"_5":13819,"_26493":113891,"_2816":113913},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3328":68160,"_29138":68160,"_5":14177,"_2816":113915,"_29482":113916,"_20209":113917,"_26493":68160},"Cómo funciona Lamassu",[47429,112963],[],{"_3328":68161,"_29138":68160,"_20209":113919,"_5":13819,"_26493":68160,"_2816":113920},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3328":68162,"_29138":68160,"_5":29479,"_20209":113922,"_26493":113923,"_2816":113924},[],"/docs/pr-preview/pr-45/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3328":68163,"_29138":68160,"_5":29479,"_20209":113926,"_26493":113927,"_2816":113928},[],"/docs/pr-preview/pr-45/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3328":68164,"_29138":68160,"_20209":113930,"_5":13819,"_26493":68160,"_2816":113931},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3328":68165,"_29138":68160,"_20209":113933,"_5":13819,"_26493":113923,"_2816":113934},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3328":68166,"_29138":68160,"_20209":113936,"_5":13819,"_26493":113923,"_2816":113937},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3328":68167,"_29138":68160,"_20209":113939,"_5":13819,"_26493":113923,"_2816":113940},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3328":68168,"_29138":68160,"_20209":113942,"_5":13819,"_26493":113923,"_2816":113943},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3328":68169,"_29138":68160,"_20209":113945,"_5":13819,"_26493":113923,"_2816":113946},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3328":68170,"_29138":68160,"_20209":113948,"_5":13819,"_26493":113927,"_2816":113949},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3328":68171,"_29138":68160,"_20209":113951,"_5":13819,"_26493":113927,"_2816":113952},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3328":68172,"_29138":68160,"_20209":113954,"_5":13819,"_26493":113927,"_2816":113955},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3328":68173,"_29138":68160,"_20209":113957,"_5":13819,"_26493":113927,"_2816":113958},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3328":68174,"_29138":68160,"_20209":113960,"_5":13819,"_26493":113927,"_2816":113961},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3328":68175,"_29138":68160,"_20209":113963,"_5":13819,"_26493":113927,"_2816":113964},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3328":68176,"_29138":68160,"_20209":113966,"_5":13819,"_26493":113927,"_2816":113967},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3328":68177,"_29138":68177,"_5":14177,"_2816":113969,"_29482":113970,"_20209":113971,"_26493":68177},"Dispositivos e identidades",[47429,112963,49905,113969],[],{"_3328":68178,"_29138":68177,"_20209":113973,"_5":13819,"_26493":68177,"_2816":113974},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3328":68179,"_29138":68177,"_5":29479,"_20209":113976,"_26493":113977,"_2816":113978},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3328":68180,"_29138":68177,"_5":29479,"_20209":113980,"_26493":113981,"_2816":113982},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3328":68181,"_29138":68177,"_5":29479,"_20209":113984,"_26493":113985,"_2816":113986},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3328":68182,"_29138":68177,"_5":29479,"_20209":113988,"_26493":113989,"_2816":113990},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3328":68183,"_29138":68177,"_5":29479,"_20209":113992,"_26493":113993,"_2816":113994},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3328":68184,"_29138":68177,"_5":29479,"_20209":113996,"_26493":113997,"_2816":113998},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3328":68185,"_29138":68177,"_5":29479,"_20209":114000,"_26493":114001,"_2816":114002},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3328":68186,"_29138":68177,"_5":29479,"_20209":114004,"_26493":114005,"_2816":114006},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3328":68187,"_29138":68177,"_5":29479,"_20209":114008,"_26493":114009,"_2816":114010},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3328":68188,"_29138":68177,"_5":29479,"_20209":114012,"_26493":114013,"_2816":114014},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3328":68189,"_29138":68177,"_5":29479,"_20209":114016,"_26493":114017,"_2816":114018},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3328":68190,"_29138":68177,"_20209":114020,"_5":13819,"_26493":68177,"_2816":114021},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3328":68191,"_29138":68177,"_20209":114023,"_5":13819,"_26493":68177,"_2816":114024},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3328":68192,"_29138":68177,"_20209":114026,"_5":13819,"_26493":113977,"_2816":114027},[],"Vista operativa",{"_3328":68193,"_29138":68177,"_20209":114029,"_5":13819,"_26493":113977,"_2816":114030},[],"Interpretación",{"_3328":68194,"_29138":68177,"_20209":114032,"_5":13819,"_26493":113977,"_2816":49968},[],{"_3328":68195,"_29138":68177,"_20209":114034,"_5":13819,"_26493":113977,"_2816":114035},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3328":68196,"_29138":68177,"_20209":114037,"_5":13819,"_26493":113977,"_2816":49974},[],{"_3328":68197,"_29138":68177,"_20209":114039,"_5":13819,"_26493":113977,"_2816":114040},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3328":68198,"_29138":68177,"_20209":114042,"_5":13819,"_26493":113977,"_2816":49980},[],{"_3328":68199,"_29138":68177,"_20209":114044,"_5":13819,"_26493":113977,"_2816":114045},[],"La identidad está en la ventana operativa de renovación.",{"_3328":68200,"_29138":68177,"_20209":114047,"_5":13819,"_26493":113977,"_2816":49986},[],{"_3328":68201,"_29138":68177,"_20209":114049,"_5":13819,"_26493":113977,"_2816":114050},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3328":68202,"_29138":68177,"_20209":114052,"_5":13819,"_26493":113977,"_2816":49992},[],{"_3328":68203,"_29138":68177,"_20209":114054,"_5":13819,"_26493":113977,"_2816":114055},[],"La identidad ha vencido.",{"_3328":68204,"_29138":68177,"_20209":114057,"_5":13819,"_26493":113977,"_2816":49998},[],{"_3328":68205,"_29138":68177,"_20209":114059,"_5":13819,"_26493":113977,"_2816":114060},[],"La identidad está marcada como revocada.",{"_3328":68206,"_29138":68177,"_20209":114062,"_5":13819,"_26493":113977,"_2816":50004},[],{"_3328":68207,"_29138":68177,"_20209":114064,"_5":13819,"_26493":113977,"_2816":114065},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3328":68208,"_29138":68177,"_20209":114067,"_5":13819,"_26493":113977,"_2816":114068},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3328":68209,"_29138":68177,"_20209":114070,"_5":13819,"_26493":113981,"_2816":114071},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3328":68210,"_29138":68177,"_20209":114073,"_5":13819,"_26493":113981,"_2816":114074},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3328":68211,"_29138":68177,"_20209":114076,"_5":13819,"_26493":113981,"_2816":114077},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3328":68212,"_29138":68177,"_20209":114079,"_5":13819,"_26493":113981,"_2816":114080},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3328":68213,"_29138":68177,"_20209":114082,"_5":13819,"_26493":113985,"_2816":114083},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3328":68214,"_29138":68177,"_20209":114085,"_5":13819,"_26493":113989,"_2816":114086},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3328":68215,"_29138":68177,"_20209":114088,"_5":13819,"_26493":113993,"_2816":114089},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3328":68216,"_29138":68177,"_20209":114091,"_5":13819,"_26493":113997,"_2816":114092},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3328":68217,"_29138":68177,"_20209":114094,"_5":13819,"_26493":114001,"_2816":114095},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3328":68218,"_29138":68177,"_20209":114097,"_5":13819,"_26493":114001,"_2816":114098},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3328":68219,"_29138":68177,"_20209":114100,"_5":13819,"_26493":114005,"_2816":114101},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3328":68220,"_29138":68177,"_20209":114103,"_5":13819,"_26493":114005,"_2816":114104},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3328":68221,"_29138":68177,"_20209":114106,"_5":13819,"_26493":114005,"_2816":114107},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3328":68222,"_29138":68177,"_20209":114109,"_5":13819,"_26493":114005,"_2816":114110},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3328":68223,"_29138":68177,"_20209":114112,"_5":13819,"_26493":114005,"_2816":114113},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3328":68224,"_29138":68177,"_20209":114115,"_5":13819,"_26493":114005,"_2816":114116},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3328":68225,"_29138":68177,"_20209":114118,"_5":13819,"_26493":114009,"_2816":114119},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3328":68226,"_29138":68177,"_20209":114121,"_5":13819,"_26493":114009,"_2816":114122},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3328":68227,"_29138":68177,"_20209":114124,"_5":13819,"_26493":114013,"_2816":114125},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3328":68228,"_29138":68177,"_20209":114127,"_5":13819,"_26493":114013,"_2816":114128},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3328":68229,"_29138":68177,"_20209":114130,"_5":13819,"_26493":114013,"_2816":114131},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3328":68230,"_29138":68177,"_20209":114133,"_5":13819,"_26493":114013,"_2816":114134},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3328":68231,"_29138":68177,"_20209":114136,"_5":13819,"_26493":114017,"_2816":114137},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3328":68232,"_29138":68177,"_20209":114139,"_5":13819,"_26493":114017,"_2816":114140},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3328":68233,"_29138":68233,"_5":14177,"_2816":114142,"_29482":114143,"_20209":114145,"_26493":68233},"Identidad inicial y autenticación",[47429,112963,49905,113969,114144],"Enrolamiento con PKI",[],{"_3328":68234,"_29138":68233,"_20209":114147,"_5":13819,"_26493":68233,"_2816":114148},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3328":68235,"_29138":68233,"_5":29479,"_20209":114150,"_26493":114151,"_2816":114152},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3328":68236,"_29138":68233,"_5":29479,"_20209":114154,"_26493":114155,"_2816":114156},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3328":68237,"_29138":68233,"_5":29479,"_20209":114158,"_26493":114159,"_2816":114160},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3328":68238,"_29138":68233,"_5":29479,"_20209":114162,"_26493":114163,"_2816":114164},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3328":68239,"_29138":68233,"_5":29479,"_20209":114166,"_26493":114167,"_2816":114168},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3328":68240,"_29138":68233,"_20209":114170,"_5":13819,"_26493":68233,"_2816":114171},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3328":68241,"_29138":68233,"_20209":114173,"_5":13819,"_26493":114151,"_2816":114174},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3328":68242,"_29138":68233,"_20209":114176,"_5":13819,"_26493":114151,"_2816":114177},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3328":68243,"_29138":68233,"_20209":114179,"_5":13819,"_26493":114155,"_2816":114180},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3328":68244,"_29138":68233,"_20209":114182,"_5":13819,"_26493":114155,"_2816":114183},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3328":68245,"_29138":68233,"_20209":114185,"_5":13819,"_26493":114155,"_2816":114186},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3328":68246,"_29138":68233,"_20209":114188,"_5":13819,"_26493":114159,"_2816":114189},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3328":68247,"_29138":68233,"_20209":114191,"_5":13819,"_26493":114159,"_2816":114192},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3328":68248,"_29138":68233,"_20209":114194,"_5":13819,"_26493":114163,"_2816":114195},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3328":68249,"_29138":68233,"_20209":114197,"_5":13819,"_26493":114163,"_2816":114198},[],"Ejemplo de cuerpo:",{"_3328":68250,"_29138":68233,"_20209":114200,"_5":13819,"_26493":114163,"_2816":114201},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3328":68251,"_29138":68233,"_20209":114203,"_5":13819,"_26493":114163,"_2816":114204},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3328":68252,"_29138":68233,"_20209":114206,"_5":13819,"_26493":114163,"_2816":114207},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3328":68253,"_29138":68233,"_20209":114209,"_5":13819,"_26493":114163,"_2816":114210},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3328":68254,"_29138":68233,"_20209":114212,"_5":13819,"_26493":114167,"_2816":114213},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3328":68255,"_29138":68233,"_20209":114215,"_5":13819,"_26493":114167,"_2816":114216},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3328":68256,"_29138":68256,"_5":14177,"_2816":114218,"_29482":114219,"_20209":114220,"_26493":68256},"Configura y opera el DMS",[47429,112963,49905,113969,114144],[],{"_3328":68257,"_29138":68256,"_20209":114222,"_5":13819,"_26493":68256,"_2816":114223},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3328":68258,"_29138":68256,"_5":29479,"_20209":114225,"_26493":114226,"_2816":111541},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3328":68259,"_29138":68256,"_5":29479,"_20209":114228,"_26493":114229,"_2816":114230},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3328":68260,"_29138":68256,"_5":29479,"_20209":114232,"_26493":114233,"_2816":114234},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3328":68261,"_29138":68256,"_5":29479,"_20209":114236,"_26493":114237,"_2816":114238},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3328":68262,"_29138":68256,"_5":29479,"_20209":114240,"_26493":114241,"_2816":114242},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3328":68263,"_29138":68256,"_5":29479,"_20209":114244,"_26493":114245,"_2816":114246},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3328":68264,"_29138":68256,"_5":29479,"_20209":114248,"_26493":114249,"_2816":114250},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3328":68265,"_29138":68256,"_5":29479,"_20209":114252,"_26493":114253,"_2816":114254},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3328":68266,"_29138":68256,"_5":29479,"_20209":114256,"_26493":114257,"_2816":50200},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3328":68267,"_29138":68256,"_5":29479,"_20209":114259,"_26493":114260,"_2816":50204},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3328":68268,"_29138":68256,"_5":29479,"_20209":114262,"_26493":114263,"_2816":114264},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3328":68269,"_29138":68256,"_5":29479,"_20209":114266,"_26493":114267,"_2816":114268},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3328":68270,"_29138":68256,"_5":29479,"_20209":114270,"_26493":114271,"_2816":114272},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3328":68271,"_29138":68256,"_5":29479,"_20209":114274,"_26493":114275,"_2816":114276},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3328":68272,"_29138":68256,"_5":29479,"_20209":114278,"_26493":114279,"_2816":50224},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3328":68273,"_29138":68256,"_5":29479,"_20209":114281,"_26493":114282,"_2816":114283},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3328":68274,"_29138":68256,"_5":29479,"_20209":114285,"_26493":114286,"_2816":114287},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3328":68275,"_29138":68256,"_5":29479,"_20209":114289,"_26493":114290,"_2816":114291},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3328":68276,"_29138":68256,"_20209":114293,"_5":13819,"_26493":68256,"_2816":114294},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3328":68277,"_29138":68256,"_20209":114296,"_5":13819,"_26493":114226,"_2816":114297},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3328":68278,"_29138":68256,"_20209":114299,"_5":13819,"_26493":114226,"_2816":114300},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3328":68279,"_29138":68256,"_20209":114302,"_5":13819,"_26493":114233,"_2816":114303},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3328":68280,"_29138":68256,"_20209":114305,"_5":13819,"_26493":114237,"_2816":114306},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3328":68281,"_29138":68256,"_20209":114308,"_5":13819,"_26493":114241,"_2816":114309},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3328":68282,"_29138":68256,"_20209":114311,"_5":13819,"_26493":114245,"_2816":114312},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3328":68283,"_29138":68256,"_20209":114314,"_5":13819,"_26493":114249,"_2816":114315},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3328":68284,"_29138":68256,"_20209":114317,"_5":13819,"_26493":114257,"_2816":114318},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3328":68285,"_29138":68256,"_20209":114320,"_5":13819,"_26493":114257,"_2816":114321},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3328":68286,"_29138":68256,"_20209":114323,"_5":13819,"_26493":114260,"_2816":114324},[],"Campo de `settings.enrollment_settings`",{"_3328":68287,"_29138":68256,"_20209":114326,"_5":13819,"_26493":114260,"_2816":114327},[],"Decisión",{"_3328":68288,"_29138":68256,"_20209":114329,"_5":13819,"_26493":114260,"_2816":50275},[],{"_3328":68289,"_29138":68256,"_20209":114331,"_5":13819,"_26493":114260,"_2816":114332},[],"`EST_RFC7030` para estas operaciones.",{"_3328":68290,"_29138":68256,"_20209":114334,"_5":13819,"_26493":114260,"_2816":50281},[],{"_3328":68291,"_29138":68256,"_20209":114336,"_5":13819,"_26493":114260,"_2816":114337},[],"ID de la CA que firmará.",{"_3328":68292,"_29138":68256,"_20209":114339,"_5":13819,"_26493":114260,"_2816":50287},[],{"_3328":68293,"_29138":68256,"_20209":114341,"_5":13819,"_26493":114260,"_2816":114342},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3328":68294,"_29138":68256,"_20209":114344,"_5":13819,"_26493":114260,"_2816":50293},[],{"_3328":68295,"_29138":68256,"_20209":114346,"_5":13819,"_26493":114260,"_2816":114347},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3328":68296,"_29138":68256,"_20209":114349,"_5":13819,"_26493":114260,"_2816":50299},[],{"_3328":68297,"_29138":68256,"_20209":114351,"_5":13819,"_26493":114260,"_2816":114352},[],"Uno de los cuatro modos de autenticación.",{"_3328":68298,"_29138":68256,"_20209":114354,"_5":13819,"_26493":114260,"_2816":114355},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3328":68299,"_29138":68256,"_20209":114357,"_5":13819,"_26493":114263,"_2816":114358},[],"Los bloques son independientes:",{"_3328":68300,"_29138":68256,"_20209":114360,"_5":13819,"_26493":114263,"_2816":114361},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3328":68301,"_29138":68256,"_20209":114363,"_5":13819,"_26493":114263,"_2816":114364},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3328":68302,"_29138":68256,"_20209":114366,"_5":13819,"_26493":114263,"_2816":50317},[],{"_3328":68303,"_29138":68256,"_20209":114368,"_5":13819,"_26493":114263,"_2816":114369},[],"Control aplicado en la operación configurada",{"_3328":68304,"_29138":68256,"_20209":114371,"_5":13819,"_26493":114263,"_2816":50323},[],{"_3328":68305,"_29138":68256,"_20209":114373,"_5":13819,"_26493":114263,"_2816":114374},[],"Validación del certificado presentado.",{"_3328":68306,"_29138":68256,"_20209":114376,"_5":13819,"_26493":114263,"_2816":50329},[],{"_3328":68307,"_29138":68256,"_20209":114378,"_5":13819,"_26493":114263,"_2816":114379},[],"Autorización del webhook configurado.",{"_3328":68308,"_29138":68256,"_20209":114381,"_5":13819,"_26493":114263,"_2816":50335},[],{"_3328":68309,"_29138":68256,"_20209":114383,"_5":13819,"_26493":114263,"_2816":114384},[],"Validación del certificado y, después, aprobación del webhook.",{"_3328":68310,"_29138":68256,"_20209":114386,"_5":13819,"_26493":114263,"_2816":50341},[],{"_3328":68311,"_29138":68256,"_20209":114388,"_5":13819,"_26493":114263,"_2816":114389},[],"Sin autenticación del solicitante por el DMS.",{"_3328":68312,"_29138":68256,"_20209":114391,"_5":13819,"_26493":114263,"_2816":114392},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3328":68313,"_29138":68256,"_20209":114394,"_5":13819,"_26493":114263,"_2816":114395},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3328":68314,"_29138":68256,"_20209":114397,"_5":13819,"_26493":114263,"_2816":114398},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3328":68315,"_29138":68256,"_20209":114400,"_5":13819,"_26493":114263,"_2816":114401},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3328":68316,"_29138":68256,"_20209":114403,"_5":13819,"_26493":114267,"_2816":114404},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3328":68317,"_29138":68256,"_20209":114406,"_5":13819,"_26493":114267,"_2816":114407},[],"Campo de `external_webhook_settings`",{"_3328":68318,"_29138":68256,"_20209":114409,"_5":13819,"_26493":114267,"_2816":114327},[],{"_3328":68319,"_29138":68256,"_20209":114411,"_5":13819,"_26493":114267,"_2816":50367},[],{"_3328":68320,"_29138":68256,"_20209":114413,"_5":13819,"_26493":114267,"_2816":114414},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3328":68321,"_29138":68256,"_20209":114416,"_5":13819,"_26493":114267,"_2816":50373},[],{"_3328":68322,"_29138":68256,"_20209":114418,"_5":13819,"_26493":114267,"_2816":114419},[],"`POST` o `PUT`; `POST` por defecto.",{"_3328":68323,"_29138":68256,"_20209":114421,"_5":13819,"_26493":114267,"_2816":50379},[],{"_3328":68324,"_29138":68256,"_20209":114423,"_5":13819,"_26493":114267,"_2816":114424},[],"Etiqueta usada en los logs del servicio.",{"_3328":68325,"_29138":68256,"_20209":114426,"_5":13819,"_26493":114267,"_2816":50385},[],{"_3328":68326,"_29138":68256,"_20209":114428,"_5":13819,"_26493":114267,"_2816":114429},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3328":68327,"_29138":68256,"_20209":114431,"_5":13819,"_26493":114267,"_2816":50391},[],{"_3328":68328,"_29138":68256,"_20209":114433,"_5":13819,"_26493":114267,"_2816":114434},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3328":68329,"_29138":68256,"_20209":114436,"_5":13819,"_26493":114267,"_2816":50397},[],{"_3328":68330,"_29138":68256,"_20209":114438,"_5":13819,"_26493":114267,"_2816":114439},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3328":68331,"_29138":68256,"_20209":114441,"_5":13819,"_26493":114267,"_2816":50403},[],{"_3328":68332,"_29138":68256,"_20209":114443,"_5":13819,"_26493":114267,"_2816":114444},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3328":68333,"_29138":68256,"_20209":114446,"_5":13819,"_26493":114267,"_2816":50409},[],{"_3328":68334,"_29138":68256,"_20209":114448,"_5":13819,"_26493":114267,"_2816":114449},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3328":68335,"_29138":68256,"_20209":114451,"_5":13819,"_26493":114267,"_2816":50415},[],{"_3328":68336,"_29138":68256,"_20209":114453,"_5":13819,"_26493":114267,"_2816":114454},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3328":68337,"_29138":68256,"_20209":114456,"_5":13819,"_26493":114267,"_2816":50421},[],{"_3328":68338,"_29138":68256,"_20209":114458,"_5":13819,"_26493":114267,"_2816":114459},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3328":68339,"_29138":68256,"_20209":114461,"_5":13819,"_26493":114267,"_2816":114462},[],"Reglas de esa configuración:",{"_3328":68340,"_29138":68256,"_20209":114464,"_5":13819,"_26493":114267,"_2816":114465},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3328":68341,"_29138":68256,"_20209":114467,"_5":13819,"_26493":114267,"_2816":114468},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3328":68342,"_29138":68256,"_20209":114470,"_5":13819,"_26493":114267,"_2816":114471},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3328":68343,"_29138":68256,"_20209":114473,"_5":13819,"_26493":114267,"_2816":114474},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3328":68344,"_29138":68256,"_20209":114476,"_5":13819,"_26493":114267,"_2816":114477},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3328":68345,"_29138":68256,"_20209":114479,"_5":13819,"_26493":114267,"_2816":114480},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3328":68346,"_29138":68256,"_20209":114482,"_5":13819,"_26493":114267,"_2816":114483},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3328":68347,"_29138":68256,"_20209":114485,"_5":13819,"_26493":114267,"_2816":114486},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3328":68348,"_29138":68256,"_20209":114488,"_5":13819,"_26493":114267,"_2816":114489},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3328":68349,"_29138":68256,"_20209":114491,"_5":13819,"_26493":114271,"_2816":114492},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3328":68350,"_29138":68256,"_20209":114494,"_5":13819,"_26493":114275,"_2816":114495},[],"Campo de `settings.reenrollment_settings`",{"_3328":68351,"_29138":68256,"_20209":114497,"_5":13819,"_26493":114275,"_2816":114498},[],"Función",{"_3328":68352,"_29138":68256,"_20209":114500,"_5":13819,"_26493":114275,"_2816":50465},[],{"_3328":68353,"_29138":68256,"_20209":114502,"_5":13819,"_26493":114275,"_2816":114503},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3328":68354,"_29138":68256,"_20209":114505,"_5":13819,"_26493":114275,"_2816":50471},[],{"_3328":68355,"_29138":68256,"_20209":114507,"_5":13819,"_26493":114275,"_2816":114508},[],"Umbral operativo preventivo de monitorización.",{"_3328":68356,"_29138":68256,"_20209":114510,"_5":13819,"_26493":114275,"_2816":50477},[],{"_3328":68357,"_29138":68256,"_20209":114512,"_5":13819,"_26493":114275,"_2816":114513},[],"Umbral operativo crítico de monitorización.",{"_3328":68358,"_29138":68256,"_20209":114515,"_5":13819,"_26493":114275,"_2816":50483},[],{"_3328":68359,"_29138":68256,"_20209":114517,"_5":13819,"_26493":114275,"_2816":114518},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3328":68360,"_29138":68256,"_20209":114520,"_5":13819,"_26493":114275,"_2816":50489},[],{"_3328":68361,"_29138":68256,"_20209":114522,"_5":13819,"_26493":114275,"_2816":114523},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3328":68362,"_29138":68256,"_20209":114525,"_5":13819,"_26493":114275,"_2816":50495},[],{"_3328":68363,"_29138":68256,"_20209":114527,"_5":13819,"_26493":114275,"_2816":114528},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3328":68364,"_29138":68256,"_20209":114530,"_5":13819,"_26493":114275,"_2816":114531},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3328":68365,"_29138":68256,"_20209":114533,"_5":13819,"_26493":114279,"_2816":114534},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3328":68366,"_29138":68256,"_20209":114536,"_5":13819,"_26493":114282,"_2816":111905},[],{"_3328":68367,"_29138":68256,"_20209":114538,"_5":13819,"_26493":114282,"_2816":114539},[],"Qué publica",{"_3328":68368,"_29138":68256,"_20209":114541,"_5":13819,"_26493":114282,"_2816":50512},[],{"_3328":68369,"_29138":68256,"_20209":114543,"_5":13819,"_26493":114282,"_2816":114544},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3328":68370,"_29138":68256,"_20209":114546,"_5":13819,"_26493":114282,"_2816":50518},[],{"_3328":68371,"_29138":68256,"_20209":114548,"_5":13819,"_26493":114282,"_2816":114549},[],"Certificado de la CA emisora seleccionada.",{"_3328":68372,"_29138":68256,"_20209":114551,"_5":13819,"_26493":114282,"_2816":50524},[],{"_3328":68373,"_29138":68256,"_20209":114553,"_5":13819,"_26493":114282,"_2816":114554},[],"Certificados de las CAs elegidas explícitamente.",{"_3328":68374,"_29138":68256,"_20209":114556,"_5":13819,"_26493":114282,"_2816":114557},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3328":68375,"_29138":68256,"_20209":114559,"_5":13819,"_26493":114286,"_2816":114560},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3328":68376,"_29138":68256,"_20209":114562,"_5":13819,"_26493":114286,"_2816":114563},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3328":68377,"_29138":68256,"_20209":114565,"_5":13819,"_26493":114286,"_2816":114566},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3328":68378,"_29138":68256,"_20209":114568,"_5":13819,"_26493":114290,"_2816":114569},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3328":68379,"_29138":68379,"_5":14177,"_2816":114571,"_29482":114572,"_20209":114573,"_26493":68379},"Integra el cliente EST",[47429,112963,49905,113969,114144],[],{"_3328":68380,"_29138":68379,"_20209":114575,"_5":13819,"_26493":68379,"_2816":114576},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3328":68381,"_29138":68379,"_5":29479,"_20209":114578,"_26493":114579,"_2816":111541},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3328":68382,"_29138":68379,"_5":29479,"_20209":114581,"_26493":114582,"_2816":114583},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3328":68383,"_29138":68379,"_5":29479,"_20209":114585,"_26493":114586,"_2816":114587},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3328":68384,"_29138":68379,"_5":29479,"_20209":114589,"_26493":114590,"_2816":114591},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3328":68385,"_29138":68379,"_5":29479,"_20209":114593,"_26493":114594,"_2816":114595},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3328":68386,"_29138":68379,"_5":29479,"_20209":114597,"_26493":114598,"_2816":114599},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3328":68387,"_29138":68379,"_20209":114601,"_5":13819,"_26493":68379,"_2816":114602},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3328":68388,"_29138":68379,"_20209":114604,"_5":13819,"_26493":114579,"_2816":114605},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3328":68389,"_29138":68379,"_20209":114607,"_5":13819,"_26493":114579,"_2816":114608},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3328":68390,"_29138":68379,"_20209":114610,"_5":13819,"_26493":114579,"_2816":114611},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3328":68391,"_29138":68379,"_20209":114613,"_5":13819,"_26493":114582,"_2816":114614},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3328":68392,"_29138":68379,"_20209":114616,"_5":13819,"_26493":114582,"_2816":114617},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3328":68393,"_29138":68379,"_20209":114619,"_5":13819,"_26493":114586,"_2816":114620},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3328":68394,"_29138":68379,"_20209":114622,"_5":13819,"_26493":114586,"_2816":114623},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3328":68395,"_29138":68379,"_20209":114625,"_5":13819,"_26493":114590,"_2816":114626},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3328":68396,"_29138":68379,"_20209":114628,"_5":13819,"_26493":114590,"_2816":114629},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3328":68397,"_29138":68379,"_20209":114631,"_5":13819,"_26493":114594,"_2816":114632},[],"Para el caso de una raíz que emite directamente:",{"_3328":68398,"_29138":68379,"_20209":114634,"_5":13819,"_26493":114594,"_2816":114635},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3328":68399,"_29138":68379,"_20209":114637,"_5":13819,"_26493":114594,"_2816":114638},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3328":68400,"_29138":68379,"_20209":114640,"_5":13819,"_26493":114598,"_2816":114641},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3328":68401,"_29138":68401,"_5":14177,"_2816":114643,"_29482":114644,"_20209":114645,"_26493":68401},"Referencia EST",[47429,112963,49905,113969,114144],[],{"_3328":68402,"_29138":68401,"_20209":114647,"_5":13819,"_26493":68401,"_2816":114648},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3328":68403,"_29138":68401,"_5":29479,"_20209":114650,"_26493":114651,"_2816":114652},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3328":68404,"_29138":68401,"_5":29479,"_20209":114654,"_26493":114655,"_2816":21954},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3328":68405,"_29138":68401,"_5":29479,"_20209":114657,"_26493":114658,"_2816":25139},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3328":68406,"_29138":68401,"_5":29479,"_20209":114660,"_26493":114661,"_2816":25146},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3328":68407,"_29138":68401,"_5":29479,"_20209":114663,"_26493":114664,"_2816":24479},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3328":68408,"_29138":68401,"_5":29479,"_20209":114666,"_26493":114667,"_2816":114668},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3328":68409,"_29138":68401,"_5":29479,"_20209":114670,"_26493":114671,"_2816":114672},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3328":68410,"_29138":68401,"_5":29479,"_20209":114674,"_26493":114675,"_2816":114676},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3328":68411,"_29138":68401,"_20209":114678,"_5":13819,"_26493":68401,"_2816":114679},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3328":68412,"_29138":68401,"_20209":114681,"_5":13819,"_26493":114651,"_2816":114682},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3328":68413,"_29138":68401,"_20209":114684,"_5":13819,"_26493":114651,"_2816":112723},[],{"_3328":68414,"_29138":68401,"_20209":114686,"_5":13819,"_26493":114651,"_2816":114687},[],"Método",{"_3328":68415,"_29138":68401,"_20209":114689,"_5":13819,"_26493":114651,"_2816":114690},[],"Autenticación y condición",{"_3328":68416,"_29138":68401,"_20209":114692,"_5":13819,"_26493":114651,"_2816":50667},[],{"_3328":68417,"_29138":68401,"_20209":114694,"_5":13819,"_26493":114651,"_2816":50670},[],{"_3328":68418,"_29138":68401,"_20209":114696,"_5":13819,"_26493":114651,"_2816":114697},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3328":68419,"_29138":68401,"_20209":114699,"_5":13819,"_26493":114651,"_2816":50676},[],{"_3328":68420,"_29138":68401,"_20209":114701,"_5":13819,"_26493":114651,"_2816":50679},[],{"_3328":68421,"_29138":68401,"_20209":114703,"_5":13819,"_26493":114651,"_2816":114704},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3328":68422,"_29138":68401,"_20209":114706,"_5":13819,"_26493":114651,"_2816":50685},[],{"_3328":68423,"_29138":68401,"_20209":114708,"_5":13819,"_26493":114651,"_2816":50679},[],{"_3328":68424,"_29138":68401,"_20209":114710,"_5":13819,"_26493":114651,"_2816":114711},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3328":68425,"_29138":68401,"_20209":114713,"_5":13819,"_26493":114651,"_2816":50693},[],{"_3328":68426,"_29138":68401,"_20209":114715,"_5":13819,"_26493":114651,"_2816":50679},[],{"_3328":68427,"_29138":68401,"_20209":114717,"_5":13819,"_26493":114651,"_2816":114718},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3328":68428,"_29138":68401,"_20209":114720,"_5":13819,"_26493":114651,"_2816":114721},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3328":68429,"_29138":68401,"_20209":114723,"_5":13819,"_26493":114655,"_2816":114724},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3328":68430,"_29138":68401,"_20209":114726,"_5":13819,"_26493":114655,"_2816":114727},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3328":68431,"_29138":68401,"_20209":114729,"_5":13819,"_26493":114658,"_2816":114730},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3328":68432,"_29138":68401,"_20209":114732,"_5":13819,"_26493":114658,"_2816":114733},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3328":68433,"_29138":68401,"_20209":114735,"_5":13819,"_26493":114661,"_2816":114736},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3328":68434,"_29138":68401,"_20209":114738,"_5":13819,"_26493":114661,"_2816":114739},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3328":68435,"_29138":68401,"_20209":114741,"_5":13819,"_26493":114664,"_2816":114742},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3328":68436,"_29138":68401,"_20209":114744,"_5":13819,"_26493":114664,"_2816":114745},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3328":68437,"_29138":68401,"_20209":114747,"_5":13819,"_26493":114667,"_2816":114748},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3328":68438,"_29138":68401,"_20209":114750,"_5":13819,"_26493":114667,"_2816":114751},[],"Parte",{"_3328":68439,"_29138":68401,"_20209":114753,"_5":13819,"_26493":114667,"_2816":114754},[],"Contenido tras decodificar su Base64",{"_3328":68440,"_29138":68401,"_20209":114756,"_5":13819,"_26493":114667,"_2816":50737},[],{"_3328":68441,"_29138":68401,"_20209":114758,"_5":13819,"_26493":114667,"_2816":114759},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3328":68442,"_29138":68401,"_20209":114761,"_5":13819,"_26493":114667,"_2816":50743},[],{"_3328":68443,"_29138":68401,"_20209":114763,"_5":13819,"_26493":114667,"_2816":114764},[],"PKCS#7 DER con el certificado emitido.",{"_3328":68444,"_29138":68401,"_20209":114766,"_5":13819,"_26493":114667,"_2816":114767},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3328":68445,"_29138":68401,"_20209":114769,"_5":13819,"_26493":114671,"_2816":114770},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3328":68446,"_29138":68401,"_20209":114772,"_5":13819,"_26493":114671,"_2816":114773},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3328":68447,"_29138":68401,"_20209":114775,"_5":13819,"_26493":114671,"_2816":114776},[],"Convierte y comprueba el resultado:",{"_3328":68448,"_29138":68401,"_20209":114778,"_5":13819,"_26493":114671,"_2816":114779},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3328":68449,"_29138":68401,"_20209":114781,"_5":13819,"_26493":114675,"_2816":114782},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3328":68450,"_29138":68401,"_20209":114784,"_5":13819,"_26493":114675,"_2816":114785},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3328":68451,"_29138":68451,"_5":14177,"_2816":114144,"_29482":114787,"_20209":114788,"_26493":68451},[47429,112963,49905,113969,114144],[],{"_3328":68452,"_29138":68451,"_20209":114790,"_5":13819,"_26493":68451,"_2816":114791},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3328":68453,"_29138":68451,"_5":29479,"_20209":114793,"_26493":114794,"_2816":114795},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3328":68454,"_29138":68451,"_5":29479,"_20209":114797,"_26493":114798,"_2816":114799},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3328":68455,"_29138":68451,"_5":29479,"_20209":114801,"_26493":114802,"_2816":114803},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3328":68456,"_29138":68451,"_5":29479,"_20209":114805,"_26493":114806,"_2816":114807},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3328":68457,"_29138":68451,"_20209":114809,"_5":13819,"_26493":68451,"_2816":114810},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3328":68458,"_29138":68451,"_20209":114812,"_5":13819,"_26493":114794,"_2816":114813},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3328":68459,"_29138":68451,"_20209":114815,"_5":13819,"_26493":114794,"_2816":114816},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3328":68460,"_29138":68451,"_20209":114818,"_5":13819,"_26493":114794,"_2816":114819},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3328":68461,"_29138":68451,"_20209":114821,"_5":13819,"_26493":114794,"_2816":114822},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3328":68462,"_29138":68451,"_20209":114824,"_5":13819,"_26493":114794,"_2816":114825},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3328":68463,"_29138":68451,"_20209":114827,"_5":13819,"_26493":114794,"_2816":114828},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3328":68464,"_29138":68451,"_20209":114830,"_5":13819,"_26493":114798,"_2816":114831},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3328":68465,"_29138":68451,"_20209":114833,"_5":13819,"_26493":114798,"_2816":114834},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3328":68466,"_29138":68451,"_20209":114836,"_5":13819,"_26493":114798,"_2816":114837},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3328":68467,"_29138":68451,"_20209":114839,"_5":13819,"_26493":114798,"_2816":114840},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3328":68468,"_29138":68451,"_20209":114842,"_5":13819,"_26493":114802,"_2816":114843},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3328":68469,"_29138":68451,"_20209":114845,"_5":13819,"_26493":114802,"_2816":114846},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3328":68470,"_29138":68451,"_20209":114848,"_5":13819,"_26493":114802,"_2816":114849},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3328":68471,"_29138":68451,"_20209":114851,"_5":13819,"_26493":114802,"_2816":114852},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3328":68472,"_29138":68451,"_20209":114854,"_5":13819,"_26493":114806,"_2816":114855},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3328":68473,"_29138":68451,"_20209":114857,"_5":13819,"_26493":114806,"_2816":114858},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3328":68474,"_29138":68474,"_5":14177,"_2816":114860,"_29482":114861,"_20209":114862,"_26493":68474},"Estrategias de aprovisionamiento",[47429,112963,49905,113969,114144],[],{"_3328":68475,"_29138":68474,"_20209":114864,"_5":13819,"_26493":68474,"_2816":114865},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3328":68476,"_29138":68474,"_5":29479,"_20209":114867,"_26493":114868,"_2816":114869},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3328":68477,"_29138":68474,"_5":29479,"_20209":114871,"_26493":114872,"_2816":114873},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3328":68478,"_29138":68474,"_5":29479,"_20209":114875,"_26493":114876,"_2816":114877},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3328":68479,"_29138":68474,"_5":29479,"_20209":114879,"_26493":114880,"_2816":114881},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3328":68480,"_29138":68474,"_5":29479,"_20209":114883,"_26493":114884,"_2816":114885},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3328":68481,"_29138":68474,"_20209":114887,"_5":13819,"_26493":68474,"_2816":114888},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3328":68482,"_29138":68474,"_20209":114890,"_5":13819,"_26493":114868,"_2816":114891},[],"Recorrido",{"_3328":68483,"_29138":68474,"_20209":114893,"_5":13819,"_26493":114868,"_2816":114894},[],"Cuándo existe el dispositivo",{"_3328":68484,"_29138":68474,"_20209":114896,"_5":13819,"_26493":114868,"_2816":114897},[],"Qué compruebas",{"_3328":68485,"_29138":68474,"_20209":114899,"_5":13819,"_26493":114868,"_2816":114900},[],"Asignación manual",{"_3328":68486,"_29138":68474,"_20209":114902,"_5":13819,"_26493":114868,"_2816":114903},[],"El operador lo crea antes de asociar un certificado.",{"_3328":68487,"_29138":68474,"_20209":114905,"_5":13819,"_26493":114868,"_2816":114906},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3328":68488,"_29138":68474,"_20209":114908,"_5":13819,"_26493":114868,"_2816":114909},[],"EST con `JITP`",{"_3328":68489,"_29138":68474,"_20209":114911,"_5":13819,"_26493":114868,"_2816":114912},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3328":68490,"_29138":68474,"_20209":114914,"_5":13819,"_26493":114868,"_2816":114915},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3328":68491,"_29138":68474,"_20209":114917,"_5":13819,"_26493":114868,"_2816":114918},[],"EST con `PRE_REGISTRATION`",{"_3328":68492,"_29138":68474,"_20209":114920,"_5":13819,"_26493":114868,"_2816":114921},[],"Debe existir antes de `/simpleenroll`.",{"_3328":68493,"_29138":68474,"_20209":114923,"_5":13819,"_26493":114868,"_2816":114924},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3328":68494,"_29138":68474,"_20209":114926,"_5":13819,"_26493":114868,"_2816":114927},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3328":68495,"_29138":68474,"_20209":114929,"_5":13819,"_26493":114868,"_2816":114930},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3328":68496,"_29138":68474,"_20209":114932,"_5":13819,"_26493":114872,"_2816":114933},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3328":68497,"_29138":68474,"_20209":114935,"_5":13819,"_26493":114872,"_2816":114936},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3328":68498,"_29138":68474,"_20209":114938,"_5":13819,"_26493":114872,"_2816":114939},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3328":68499,"_29138":68474,"_20209":114941,"_5":13819,"_26493":114876,"_2816":114942},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3328":68500,"_29138":68474,"_20209":114944,"_5":13819,"_26493":114876,"_2816":114945},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3328":68501,"_29138":68474,"_20209":114947,"_5":13819,"_26493":114876,"_2816":114948},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3328":68502,"_29138":68474,"_20209":114950,"_5":13819,"_26493":114876,"_2816":114951},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3328":68503,"_29138":68474,"_20209":114953,"_5":13819,"_26493":114876,"_2816":114954},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3328":68504,"_29138":68474,"_20209":114956,"_5":13819,"_26493":114876,"_2816":114957},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3328":68505,"_29138":68474,"_20209":114959,"_5":13819,"_26493":114880,"_2816":111905},[],{"_3328":68506,"_29138":68474,"_20209":114961,"_5":13819,"_26493":114880,"_2816":114962},[],"Material que atraviesa EST",{"_3328":68507,"_29138":68474,"_20209":114964,"_5":13819,"_26493":114880,"_2816":114965},[],"Clave generada por el dispositivo",{"_3328":68508,"_29138":68474,"_20209":114967,"_5":13819,"_26493":114880,"_2816":114968},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3328":68509,"_29138":68474,"_20209":114970,"_5":13819,"_26493":114880,"_2816":114971},[],"Clave ya disponible en el dispositivo",{"_3328":68510,"_29138":68474,"_20209":114973,"_5":13819,"_26493":114880,"_2816":114974},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3328":68511,"_29138":68474,"_20209":114976,"_5":13819,"_26493":114880,"_2816":50224},[],{"_3328":68512,"_29138":68474,"_20209":114978,"_5":13819,"_26493":114880,"_2816":114979},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3328":68513,"_29138":68474,"_20209":114981,"_5":13819,"_26493":114880,"_2816":114982},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3328":68514,"_29138":68474,"_20209":114984,"_5":13819,"_26493":114884,"_2816":114985},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3328":68515,"_29138":68515,"_5":14177,"_2816":114987,"_29482":114988,"_20209":114989,"_26493":68515},"Renovación y recuperación",[47429,112963,49905,113969,114144],[],{"_3328":68516,"_29138":68515,"_20209":114991,"_5":13819,"_26493":68515,"_2816":114992},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3328":68517,"_29138":68515,"_5":29479,"_20209":114994,"_26493":114995,"_2816":114996},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3328":68518,"_29138":68515,"_5":29479,"_20209":114998,"_26493":114999,"_2816":115000},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3328":68519,"_29138":68515,"_5":29479,"_20209":115002,"_26493":115003,"_2816":115004},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3328":68520,"_29138":68515,"_5":29479,"_20209":115006,"_26493":115007,"_2816":115008},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3328":68521,"_29138":68515,"_5":29479,"_20209":115010,"_26493":115011,"_2816":115012},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3328":68522,"_29138":68515,"_20209":115014,"_5":13819,"_26493":68515,"_2816":115015},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3328":68523,"_29138":68515,"_20209":115017,"_5":13819,"_26493":114995,"_2816":115018},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3328":68524,"_29138":68515,"_20209":115020,"_5":13819,"_26493":114995,"_2816":115021},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3328":68525,"_29138":68515,"_20209":115023,"_5":13819,"_26493":114995,"_2816":115024},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3328":68526,"_29138":68515,"_20209":115026,"_5":13819,"_26493":114995,"_2816":115027},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3328":68527,"_29138":68515,"_20209":115029,"_5":13819,"_26493":114999,"_2816":115030},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3328":68528,"_29138":68515,"_20209":115032,"_5":13819,"_26493":114999,"_2816":115033},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3328":68529,"_29138":68515,"_20209":115035,"_5":13819,"_26493":115003,"_2816":115036},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3328":68530,"_29138":68515,"_20209":115038,"_5":13819,"_26493":115003,"_2816":115039},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3328":68531,"_29138":68515,"_20209":115041,"_5":13819,"_26493":115003,"_2816":115042},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3328":68532,"_29138":68515,"_20209":115044,"_5":13819,"_26493":115007,"_2816":115045},[],"Situación",{"_3328":68533,"_29138":68515,"_20209":115047,"_5":13819,"_26493":115007,"_2816":115048},[],"Procedimiento",{"_3328":68534,"_29138":68515,"_20209":115050,"_5":13819,"_26493":115007,"_2816":115051},[],"Certificado vigente, fuera de ventana",{"_3328":68535,"_29138":68515,"_20209":115053,"_5":13819,"_26493":115007,"_2816":115054},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3328":68536,"_29138":68515,"_20209":115056,"_5":13819,"_26493":115007,"_2816":115057},[],"Certificado vencido, clave disponible",{"_3328":68537,"_29138":68515,"_20209":115059,"_5":13819,"_26493":115007,"_2816":115060},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3328":68538,"_29138":68515,"_20209":115062,"_5":13819,"_26493":115007,"_2816":115063},[],"Renovación por webhook o `NO_AUTH`",{"_3328":68539,"_29138":68515,"_20209":115065,"_5":13819,"_26493":115007,"_2816":115066},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3328":68540,"_29138":68515,"_20209":115068,"_5":13819,"_26493":115007,"_2816":115069},[],"Clave perdida o inaccesible",{"_3328":68541,"_29138":68515,"_20209":115071,"_5":13819,"_26493":115007,"_2816":115072},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3328":68542,"_29138":68515,"_20209":115074,"_5":13819,"_26493":115007,"_2816":115075},[],"Identidad actual revocada",{"_3328":68543,"_29138":68515,"_20209":115077,"_5":13819,"_26493":115007,"_2816":115078},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3328":68544,"_29138":68515,"_20209":115080,"_5":13819,"_26493":115007,"_2816":115081},[],"Dispositivo sin identidad",{"_3328":68545,"_29138":68515,"_20209":115083,"_5":13819,"_26493":115007,"_2816":115084},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3328":68546,"_29138":68515,"_20209":115086,"_5":13819,"_26493":115007,"_2816":115087},[],"Dispositivo retirado",{"_3328":68547,"_29138":68515,"_20209":115089,"_5":13819,"_26493":115007,"_2816":115090},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3328":68548,"_29138":68515,"_20209":115092,"_5":13819,"_26493":115007,"_2816":115093},[],"Timeout, HTTP 500 o fallo de instalación",{"_3328":68549,"_29138":68515,"_20209":115095,"_5":13819,"_26493":115007,"_2816":115096},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3328":68550,"_29138":68515,"_20209":115098,"_5":13819,"_26493":115011,"_2816":115099},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3328":68551,"_29138":68515,"_20209":115101,"_5":13819,"_26493":115011,"_2816":115102},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3328":68552,"_29138":68552,"_5":14177,"_2816":115104,"_29482":115105,"_20209":115106,"_26493":68552},"Diagnóstico de enrolamiento",[47429,112963,49905,113969,114144],[],{"_3328":68553,"_29138":68552,"_20209":115108,"_5":13819,"_26493":68552,"_2816":115109},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3328":68554,"_29138":68552,"_5":29479,"_20209":115111,"_26493":115112,"_2816":115113},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3328":68555,"_29138":68552,"_5":29479,"_20209":115115,"_26493":115116,"_2816":115117},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3328":68556,"_29138":68552,"_5":29479,"_20209":115119,"_26493":115120,"_2816":114676},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3328":68557,"_29138":68552,"_5":29479,"_20209":115122,"_26493":115123,"_2816":115124},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3328":68558,"_29138":68552,"_20209":115126,"_5":13819,"_26493":68552,"_2816":115127},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3328":68559,"_29138":68552,"_20209":115129,"_5":13819,"_26493":115116,"_2816":115130},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3328":68560,"_29138":68552,"_20209":115132,"_5":13819,"_26493":115116,"_2816":115133},[],"Síntoma o mensaje",{"_3328":68561,"_29138":68552,"_20209":115135,"_5":13819,"_26493":115116,"_2816":115136},[],"Qué revisar",{"_3328":68562,"_29138":68552,"_20209":115138,"_5":13819,"_26493":115116,"_2816":115139},[],"curl rechaza TLS, nombre o emisor",{"_3328":68563,"_29138":68552,"_20209":115141,"_5":13819,"_26493":115116,"_2816":115142},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3328":68564,"_29138":68552,"_20209":115144,"_5":13819,"_26493":115116,"_2816":115145},[],"404 o APS ausente",{"_3328":68565,"_29138":68552,"_20209":115147,"_5":13819,"_26493":115116,"_2816":115148},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3328":68566,"_29138":68552,"_20209":115150,"_5":13819,"_26493":115116,"_2816":115151},[],"400, error de CSR o formato",{"_3328":68567,"_29138":68552,"_20209":115153,"_5":13819,"_26493":115116,"_2816":115154},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3328":68568,"_29138":68552,"_20209":115156,"_5":13819,"_26493":115116,"_2816":115157},[],"Credencial ausente o certificado no válido",{"_3328":68569,"_29138":68552,"_20209":115159,"_5":13819,"_26493":115116,"_2816":115160},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3328":68570,"_29138":68552,"_20209":115162,"_5":13819,"_26493":115116,"_2816":115163},[],"Webhook deniega, expira o responde sin autorización",{"_3328":68571,"_29138":68552,"_20209":115165,"_5":13819,"_26493":115116,"_2816":115166},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3328":68572,"_29138":68552,"_20209":115168,"_5":13819,"_26493":115116,"_2816":51150},[],{"_3328":68573,"_29138":68552,"_20209":115170,"_5":13819,"_26493":115116,"_2816":115171},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3328":68574,"_29138":68552,"_20209":115173,"_5":13819,"_26493":115116,"_2816":51156},[],{"_3328":68575,"_29138":68552,"_20209":115175,"_5":13819,"_26493":115116,"_2816":115176},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3328":68576,"_29138":68552,"_20209":115178,"_5":13819,"_26493":115116,"_2816":51162},[],{"_3328":68577,"_29138":68552,"_20209":115180,"_5":13819,"_26493":115116,"_2816":115181},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3328":68578,"_29138":68552,"_20209":115183,"_5":13819,"_26493":115116,"_2816":51168},[],{"_3328":68579,"_29138":68552,"_20209":115185,"_5":13819,"_26493":115116,"_2816":115186},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3328":68580,"_29138":68552,"_20209":115188,"_5":13819,"_26493":115116,"_2816":51174},[],{"_3328":68581,"_29138":68552,"_20209":115190,"_5":13819,"_26493":115116,"_2816":115191},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3328":68582,"_29138":68552,"_20209":115193,"_5":13819,"_26493":115116,"_2816":115194},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3328":68583,"_29138":68552,"_20209":115196,"_5":13819,"_26493":115116,"_2816":115197},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3328":68584,"_29138":68552,"_20209":115199,"_5":13819,"_26493":115116,"_2816":115200},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3328":68585,"_29138":68552,"_20209":115202,"_5":13819,"_26493":115116,"_2816":115203},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3328":68586,"_29138":68552,"_20209":115205,"_5":13819,"_26493":115116,"_2816":51192},[],{"_3328":68587,"_29138":68552,"_20209":115207,"_5":13819,"_26493":115116,"_2816":115208},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3328":68588,"_29138":68552,"_20209":115210,"_5":13819,"_26493":115116,"_2816":51198},[],{"_3328":68589,"_29138":68552,"_20209":115212,"_5":13819,"_26493":115116,"_2816":115213},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3328":68590,"_29138":68552,"_20209":115215,"_5":13819,"_26493":115116,"_2816":115216},[],"DMS propietario distinto",{"_3328":68591,"_29138":68552,"_20209":115218,"_5":13819,"_26493":115116,"_2816":115219},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3328":68592,"_29138":68552,"_20209":115221,"_5":13819,"_26493":115116,"_2816":51210},[],{"_3328":68593,"_29138":68552,"_20209":115223,"_5":13819,"_26493":115116,"_2816":115224},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3328":68594,"_29138":68552,"_20209":115226,"_5":13819,"_26493":115116,"_2816":51216},[],{"_3328":68595,"_29138":68552,"_20209":115228,"_5":13819,"_26493":115116,"_2816":115229},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3328":68596,"_29138":68552,"_20209":115231,"_5":13819,"_26493":115116,"_2816":115232},[],"Certificado actual revocado",{"_3328":68597,"_29138":68552,"_20209":115234,"_5":13819,"_26493":115116,"_2816":115235},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3328":68598,"_29138":68552,"_20209":115237,"_5":13819,"_26493":115116,"_2816":115238},[],"Error de CA, perfil o firma",{"_3328":68599,"_29138":68552,"_20209":115240,"_5":13819,"_26493":115116,"_2816":115241},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3328":68600,"_29138":68552,"_20209":115243,"_5":13819,"_26493":115116,"_2816":115244},[],"HTTP 200 sin conexión del dispositivo",{"_3328":68601,"_29138":68552,"_20209":115246,"_5":13819,"_26493":115116,"_2816":115247},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3328":68602,"_29138":68552,"_20209":115249,"_5":13819,"_26493":115116,"_2816":115250},[],"Timeout o error después de emitir",{"_3328":68603,"_29138":68552,"_20209":115252,"_5":13819,"_26493":115116,"_2816":115253},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3328":68604,"_29138":68552,"_20209":115255,"_5":13819,"_26493":115120,"_2816":115256},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3328":68605,"_29138":68552,"_20209":115258,"_5":13819,"_26493":115120,"_2816":115259},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3328":68606,"_29138":68552,"_20209":115261,"_5":13819,"_26493":115123,"_2816":115262},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3328":68607,"_29138":68552,"_20209":115264,"_5":13819,"_26493":115123,"_2816":115265},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3328":68608,"_29138":68552,"_20209":115267,"_5":13819,"_26493":115123,"_2816":115268},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3328":68609,"_29138":68552,"_20209":115270,"_5":13819,"_26493":115123,"_2816":115271},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3328":68610,"_29138":68552,"_20209":115273,"_5":13819,"_26493":115123,"_2816":115274},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3328":68611,"_29138":68552,"_20209":115276,"_5":13819,"_26493":115123,"_2816":115277},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3328":68612,"_29138":68552,"_20209":115279,"_5":13819,"_26493":115123,"_2816":115280},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3328":68613,"_29138":68613,"_5":14177,"_2816":115282,"_29482":115283,"_20209":115284,"_26493":68613},"Distribución y actualización de confianza",[47429,112963,49905,113969,114144],[],{"_3328":68614,"_29138":68613,"_20209":115286,"_5":13819,"_26493":68613,"_2816":115287},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3328":68615,"_29138":68613,"_5":29479,"_20209":115289,"_26493":115290,"_2816":115291},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3328":68616,"_29138":68613,"_5":29479,"_20209":115293,"_26493":115294,"_2816":115295},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3328":68617,"_29138":68613,"_5":29479,"_20209":115297,"_26493":115298,"_2816":115299},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3328":68618,"_29138":68613,"_5":29479,"_20209":115301,"_26493":115302,"_2816":115303},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3328":68619,"_29138":68613,"_5":29479,"_20209":115305,"_26493":115306,"_2816":115307},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3328":68620,"_29138":68613,"_20209":115309,"_5":13819,"_26493":68613,"_2816":115310},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3328":68621,"_29138":68613,"_20209":115312,"_5":13819,"_26493":115290,"_2816":115313},[],"Relación",{"_3328":68622,"_29138":68613,"_20209":115315,"_5":13819,"_26493":115290,"_2816":115316},[],"Material que prepara el responsable",{"_3328":68623,"_29138":68613,"_20209":115318,"_5":13819,"_26493":115290,"_2816":115319},[],"Dispositivo → servidor EST",{"_3328":68624,"_29138":68613,"_20209":115321,"_5":13819,"_26493":115290,"_2816":115322},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3328":68625,"_29138":68613,"_20209":115324,"_5":13819,"_26493":115290,"_2816":115325},[],"DMS → solicitante",{"_3328":68626,"_29138":68613,"_20209":115327,"_5":13819,"_26493":115290,"_2816":115328},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3328":68627,"_29138":68613,"_20209":115330,"_5":13819,"_26493":115290,"_2816":115331},[],"Consumidor → dispositivo",{"_3328":68628,"_29138":68613,"_20209":115333,"_5":13819,"_26493":115290,"_2816":115334},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3328":68629,"_29138":68613,"_20209":115336,"_5":13819,"_26493":115290,"_2816":115337},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3328":68630,"_29138":68613,"_20209":115339,"_5":13819,"_26493":115294,"_2816":115340},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3328":68631,"_29138":68613,"_20209":115342,"_5":13819,"_26493":115294,"_2816":115343},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3328":68632,"_29138":68613,"_20209":115345,"_5":13819,"_26493":115298,"_2816":115346},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3328":68633,"_29138":68613,"_20209":115348,"_5":13819,"_26493":115298,"_2816":115349},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3328":68634,"_29138":68613,"_20209":115351,"_5":13819,"_26493":115298,"_2816":115352},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3328":68635,"_29138":68613,"_20209":115354,"_5":13819,"_26493":115298,"_2816":115355},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3328":68636,"_29138":68613,"_20209":115357,"_5":13819,"_26493":115298,"_2816":115358},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3328":68637,"_29138":68613,"_20209":115360,"_5":13819,"_26493":115298,"_2816":115361},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3328":68638,"_29138":68613,"_20209":115363,"_5":13819,"_26493":115302,"_2816":115364},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3328":68639,"_29138":68613,"_20209":115366,"_5":13819,"_26493":115302,"_2816":115367},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3328":68640,"_29138":68613,"_20209":115369,"_5":13819,"_26493":115302,"_2816":115370},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3328":68641,"_29138":68613,"_20209":115372,"_5":13819,"_26493":115306,"_2816":115373},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3328":68642,"_29138":68642,"_5":14177,"_2816":51365,"_29482":115375,"_20209":115377,"_26493":68642},[47429,112963,49905,113969,115376],"Integraciones",[],{"_3328":68643,"_29138":68642,"_20209":115379,"_5":13819,"_26493":68642,"_2816":115380},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3328":68644,"_29138":68642,"_5":29479,"_20209":115382,"_26493":115383,"_2816":115384},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3328":68645,"_29138":68642,"_5":29479,"_20209":115386,"_26493":115387,"_2816":115388},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3328":68646,"_29138":68642,"_5":29479,"_20209":115390,"_26493":115391,"_2816":115392},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3328":68647,"_29138":68642,"_5":29479,"_20209":115394,"_26493":115395,"_2816":115396},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3328":68648,"_29138":68642,"_5":29479,"_20209":115398,"_26493":115399,"_2816":115400},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#máquina-de-estados-de-los-recursos","Máquina de estados de los recursos",{"_3328":68649,"_29138":68642,"_5":29479,"_20209":115402,"_26493":115403,"_2816":115404},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#eventos-que-gestiona-el-conector","Eventos que gestiona el conector",{"_3328":68650,"_29138":68642,"_5":29479,"_20209":115406,"_26493":115407,"_2816":115408},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3328":68651,"_29138":68642,"_5":29479,"_20209":115410,"_26493":115411,"_2816":115412},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3328":68652,"_29138":68642,"_5":29479,"_20209":115414,"_26493":115415,"_2816":115416},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3328":68653,"_29138":68642,"_5":29479,"_20209":115418,"_26493":115419,"_2816":115420},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3328":68654,"_29138":68642,"_5":29479,"_20209":115422,"_26493":115423,"_2816":115424},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3328":68655,"_29138":68642,"_5":29479,"_20209":115426,"_26493":115427,"_2816":115428},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3328":68656,"_29138":68642,"_5":29479,"_20209":115430,"_26493":115431,"_2816":51423},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3328":68657,"_29138":68642,"_5":29479,"_20209":115433,"_26493":115434,"_2816":51427},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3328":68658,"_29138":68642,"_5":29479,"_20209":115436,"_26493":115437,"_2816":115438},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3328":68659,"_29138":68642,"_5":29479,"_20209":115440,"_26493":115441,"_2816":115442},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3328":68660,"_29138":68642,"_5":29479,"_20209":115444,"_26493":115445,"_2816":115446},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3328":68661,"_29138":68642,"_5":29479,"_20209":115448,"_26493":115449,"_2816":115450},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3328":68662,"_29138":68642,"_5":29479,"_20209":115452,"_26493":115453,"_2816":115454},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3328":68663,"_29138":68642,"_5":29479,"_20209":115456,"_26493":115457,"_2816":115458},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3328":68664,"_29138":68642,"_5":29479,"_20209":115460,"_26493":115461,"_2816":115462},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3328":68665,"_29138":68642,"_5":29479,"_20209":115464,"_26493":115465,"_2816":115466},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3328":68666,"_29138":68642,"_5":29479,"_20209":115468,"_26493":115469,"_2816":115470},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3328":68667,"_29138":68642,"_5":29479,"_20209":115472,"_26493":115473,"_2816":115474},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3328":68668,"_29138":68642,"_5":29479,"_20209":115476,"_26493":115477,"_2816":115478},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3328":68669,"_29138":68642,"_5":29479,"_20209":115480,"_26493":115481,"_2816":115482},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3328":68670,"_29138":68642,"_20209":115484,"_5":13819,"_26493":68642,"_2816":115485},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3328":68671,"_29138":68642,"_20209":115487,"_5":13819,"_26493":68642,"_2816":115488},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3328":68672,"_29138":68642,"_20209":115490,"_5":13819,"_26493":68642,"_2816":115491},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3328":68673,"_29138":68642,"_20209":115493,"_5":13819,"_26493":115383,"_2816":115494},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3328":68674,"_29138":68642,"_20209":115496,"_5":13819,"_26493":115383,"_2816":115497},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3328":68675,"_29138":68642,"_20209":115499,"_5":13819,"_26493":115383,"_2816":115500},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3328":68676,"_29138":68642,"_20209":115502,"_5":13819,"_26493":115383,"_2816":115503},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3328":68677,"_29138":68642,"_20209":115505,"_5":13819,"_26493":115387,"_2816":115506},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3328":68678,"_29138":68642,"_20209":115508,"_5":13819,"_26493":115391,"_2816":115509},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3328":68679,"_29138":68642,"_20209":115511,"_5":13819,"_26493":115391,"_2816":115512},[],"Acción IAM",{"_3328":68680,"_29138":68642,"_20209":115514,"_5":13819,"_26493":115391,"_2816":111911},[],{"_3328":68681,"_29138":68642,"_20209":115516,"_5":13819,"_26493":115391,"_2816":51510},[],{"_3328":68682,"_29138":68642,"_20209":115518,"_5":13819,"_26493":115391,"_2816":115519},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3328":68683,"_29138":68642,"_20209":115521,"_5":13819,"_26493":115391,"_2816":51516},[],{"_3328":68684,"_29138":68642,"_20209":115523,"_5":13819,"_26493":115391,"_2816":115524},[],"Registrar la CA en AWS IoT",{"_3328":68685,"_29138":68642,"_20209":115526,"_5":13819,"_26493":115391,"_2816":51522},[],{"_3328":68686,"_29138":68642,"_20209":115528,"_5":13819,"_26493":115391,"_2816":115529},[],"Consultar el estado del registro de la CA",{"_3328":68687,"_29138":68642,"_20209":115531,"_5":13819,"_26493":115391,"_2816":51528},[],{"_3328":68688,"_29138":68642,"_20209":115533,"_5":13819,"_26493":115391,"_2816":115534},[],"Crear o actualizar Things en IoT Core",{"_3328":68689,"_29138":68642,"_20209":115536,"_5":13819,"_26493":115391,"_2816":51534},[],{"_3328":68690,"_29138":68642,"_20209":115538,"_5":13819,"_26493":115391,"_2816":115539},[],"Aprovisionar Things mediante plantilla",{"_3328":68691,"_29138":68642,"_20209":115541,"_5":13819,"_26493":115391,"_2816":51540},[],{"_3328":68692,"_29138":68642,"_20209":115543,"_5":13819,"_26493":115391,"_2816":115544},[],"Registrar certificados de dispositivo",{"_3328":68693,"_29138":68642,"_20209":115546,"_5":13819,"_26493":115391,"_2816":51546},[],{"_3328":68694,"_29138":68642,"_20209":115548,"_5":13819,"_26493":115391,"_2816":115549},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3328":68695,"_29138":68642,"_20209":115551,"_5":13819,"_26493":115391,"_2816":51552},[],{"_3328":68696,"_29138":68642,"_20209":115553,"_5":13819,"_26493":115391,"_2816":115554},[],"Crear y adjuntar políticas IoT",{"_3328":68697,"_29138":68642,"_20209":115556,"_5":13819,"_26493":115391,"_2816":51558},[],{"_3328":68698,"_29138":68642,"_20209":115558,"_5":13819,"_26493":115391,"_2816":115559},[],"Gestionar grupos de Things",{"_3328":68699,"_29138":68642,"_20209":115561,"_5":13819,"_26493":115391,"_2816":51564},[],{"_3328":68700,"_29138":68642,"_20209":115563,"_5":13819,"_26493":115391,"_2816":115564},[],"Crear plantillas JITP",{"_3328":68701,"_29138":68642,"_20209":115566,"_5":13819,"_26493":115391,"_2816":51570},[],{"_3328":68702,"_29138":68642,"_20209":115568,"_5":13819,"_26493":115391,"_2816":115569},[],"Leer y escribir el Device Shadow",{"_3328":68703,"_29138":68642,"_20209":115571,"_5":13819,"_26493":115391,"_2816":115572},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3328":68704,"_29138":68642,"_20209":115574,"_5":13819,"_26493":115395,"_2816":115575},[],"Parámetro",{"_3328":68705,"_29138":68642,"_20209":115577,"_5":13819,"_26493":115395,"_2816":115578},[],"Tipo",{"_3328":68706,"_29138":68642,"_20209":115580,"_5":13819,"_26493":115395,"_2816":115581},[],"Requerido",{"_3328":68707,"_29138":68642,"_20209":115583,"_5":13819,"_26493":115395,"_2816":115584},[],"Descripción",{"_3328":68708,"_29138":68642,"_20209":115586,"_5":13819,"_26493":115395,"_2816":51591},[],{"_3328":68709,"_29138":68642,"_20209":115588,"_5":13819,"_26493":115395,"_2816":24136},[],{"_3328":68710,"_29138":68642,"_20209":115590,"_5":13819,"_26493":115395,"_2816":115591},[],"Sí",{"_3328":68711,"_29138":68642,"_20209":115593,"_5":13819,"_26493":115395,"_2816":115594},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3328":68712,"_29138":68642,"_20209":115596,"_5":13819,"_26493":115395,"_2816":51602},[],{"_3328":68713,"_29138":68642,"_20209":115598,"_5":13819,"_26493":115395,"_2816":24136},[],{"_3328":68714,"_29138":68642,"_20209":115600,"_5":13819,"_26493":115395,"_2816":115591},[],{"_3328":68715,"_29138":68642,"_20209":115602,"_5":13819,"_26493":115395,"_2816":115603},[],"Región AWS donde opera el conector.",{"_3328":68716,"_29138":68642,"_20209":115605,"_5":13819,"_26493":115395,"_2816":51612},[],{"_3328":68717,"_29138":68642,"_20209":115607,"_5":13819,"_26493":115395,"_2816":24136},[],{"_3328":68718,"_29138":68642,"_20209":115609,"_5":13819,"_26493":115395,"_2816":115591},[],{"_3328":68719,"_29138":68642,"_20209":115611,"_5":13819,"_26493":115395,"_2816":115612},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3328":68720,"_29138":68642,"_20209":115614,"_5":13819,"_26493":115395,"_2816":51622},[],{"_3328":68721,"_29138":68642,"_20209":115616,"_5":13819,"_26493":115395,"_2816":24136},[],{"_3328":68722,"_29138":68642,"_20209":115618,"_5":13819,"_26493":115395,"_2816":115619},[],"Solo con `auth_method=static`",{"_3328":68723,"_29138":68642,"_20209":115621,"_5":13819,"_26493":115395,"_2816":115622},[],"Clave de acceso AWS.",{"_3328":68724,"_29138":68642,"_20209":115624,"_5":13819,"_26493":115395,"_2816":51633},[],{"_3328":68725,"_29138":68642,"_20209":115626,"_5":13819,"_26493":115395,"_2816":24136},[],{"_3328":68726,"_29138":68642,"_20209":115628,"_5":13819,"_26493":115395,"_2816":115619},[],{"_3328":68727,"_29138":68642,"_20209":115630,"_5":13819,"_26493":115395,"_2816":115631},[],"Clave secreta AWS.",{"_3328":68728,"_29138":68642,"_20209":115633,"_5":13819,"_26493":115395,"_2816":51643},[],{"_3328":68729,"_29138":68642,"_20209":115635,"_5":13819,"_26493":115395,"_2816":24136},[],{"_3328":68730,"_29138":68642,"_20209":115637,"_5":13819,"_26493":115395,"_2816":51648},[],{"_3328":68731,"_29138":68642,"_20209":115639,"_5":13819,"_26493":115395,"_2816":115640},[],"Token de sesión (con `auth_method=static`).",{"_3328":68732,"_29138":68642,"_20209":115642,"_5":13819,"_26493":115395,"_2816":51654},[],{"_3328":68733,"_29138":68642,"_20209":115644,"_5":13819,"_26493":115395,"_2816":24136},[],{"_3328":68734,"_29138":68642,"_20209":115646,"_5":13819,"_26493":115395,"_2816":115647},[],"Solo con `auth_method=role`",{"_3328":68735,"_29138":68642,"_20209":115649,"_5":13819,"_26493":115395,"_2816":115650},[],"ARN del rol a asumir.",{"_3328":68736,"_29138":68642,"_20209":115652,"_5":13819,"_26493":115395,"_2816":51665},[],{"_3328":68737,"_29138":68642,"_20209":115654,"_5":13819,"_26493":115395,"_2816":24136},[],{"_3328":68738,"_29138":68642,"_20209":115656,"_5":13819,"_26493":115395,"_2816":51648},[],{"_3328":68739,"_29138":68642,"_20209":115658,"_5":13819,"_26493":115395,"_2816":115659},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3328":68740,"_29138":68642,"_20209":115661,"_5":13819,"_26493":115395,"_2816":51675},[],{"_3328":68741,"_29138":68642,"_20209":115663,"_5":13819,"_26493":115395,"_2816":16986},[],{"_3328":68742,"_29138":68642,"_20209":115665,"_5":13819,"_26493":115395,"_2816":115591},[],{"_3328":68743,"_29138":68642,"_20209":115667,"_5":13819,"_26493":115395,"_2816":115668},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3328":68744,"_29138":68642,"_20209":115670,"_5":13819,"_26493":115395,"_2816":51685},[],{"_3328":68745,"_29138":68642,"_20209":115672,"_5":13819,"_26493":115395,"_2816":24136},[],{"_3328":68746,"_29138":68642,"_20209":115674,"_5":13819,"_26493":115395,"_2816":115591},[],{"_3328":68747,"_29138":68642,"_20209":115676,"_5":13819,"_26493":115395,"_2816":115677},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3328":68748,"_29138":68642,"_20209":115679,"_5":13819,"_26493":115395,"_2816":51695},[],{"_3328":68749,"_29138":68642,"_20209":115681,"_5":13819,"_26493":115395,"_2816":24136},[],{"_3328":68750,"_29138":68642,"_20209":115683,"_5":13819,"_26493":115395,"_2816":115591},[],{"_3328":68751,"_29138":68642,"_20209":115685,"_5":13819,"_26493":115395,"_2816":115686},[],"URL HTTP del Device Manager de Lamassu.",{"_3328":68752,"_29138":68642,"_20209":115688,"_5":13819,"_26493":115395,"_2816":51705},[],{"_3328":68753,"_29138":68642,"_20209":115690,"_5":13819,"_26493":115395,"_2816":24136},[],{"_3328":68754,"_29138":68642,"_20209":115692,"_5":13819,"_26493":115395,"_2816":115591},[],{"_3328":68755,"_29138":68642,"_20209":115694,"_5":13819,"_26493":115395,"_2816":115695},[],"URL HTTP del servicio de CA de Lamassu.",{"_3328":68756,"_29138":68642,"_20209":115697,"_5":13819,"_26493":115399,"_2816":115698},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada transición. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3328":68757,"_29138":68642,"_20209":115700,"_5":13819,"_26493":115403,"_2816":115701},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3328":68758,"_29138":68642,"_20209":115703,"_5":13819,"_26493":115403,"_2816":115704},[],"Tipo de CloudEvent",{"_3328":68759,"_29138":68642,"_20209":115706,"_5":13819,"_26493":115403,"_2816":115707},[],"Recurso en Lamassu",{"_3328":68760,"_29138":68642,"_20209":115709,"_5":13819,"_26493":115403,"_2816":115710},[],"Recurso AWS",{"_3328":68761,"_29138":68642,"_20209":115712,"_5":13819,"_26493":115403,"_2816":115713},[],"Acciones IAM",{"_3328":68762,"_29138":68642,"_20209":115715,"_5":13819,"_26493":115403,"_2816":115716},[],"Llamadas AWS y efecto",{"_3328":68763,"_29138":68642,"_20209":115718,"_5":13819,"_26493":115403,"_2816":115719},[],"Dónde en esta página",{"_3328":68764,"_29138":68642,"_20209":115721,"_5":13819,"_26493":115403,"_2816":51739},[],{"_3328":68765,"_29138":68642,"_20209":115723,"_5":13819,"_26493":115403,"_2816":51742},[],{"_3328":68766,"_29138":68642,"_20209":115725,"_5":13819,"_26493":115403,"_2816":51745},[],{"_3328":68767,"_29138":68642,"_20209":115727,"_5":13819,"_26493":115403,"_2816":51748},[],{"_3328":68768,"_29138":68642,"_20209":115729,"_5":13819,"_26493":115403,"_2816":115730},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3328":68769,"_29138":68642,"_20209":115732,"_5":13819,"_26493":115403,"_2816":115408},[],{"_3328":68770,"_29138":68642,"_20209":115734,"_5":13819,"_26493":115403,"_2816":51756},[],{"_3328":68771,"_29138":68642,"_20209":115736,"_5":13819,"_26493":115403,"_2816":51759},[],{"_3328":68772,"_29138":68642,"_20209":115738,"_5":13819,"_26493":115403,"_2816":51762},[],{"_3328":68773,"_29138":68642,"_20209":115740,"_5":13819,"_26493":115403,"_2816":51765},[],{"_3328":68774,"_29138":68642,"_20209":115742,"_5":13819,"_26493":115403,"_2816":115743},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3328":68775,"_29138":68642,"_20209":115745,"_5":13819,"_26493":115403,"_2816":115412},[],{"_3328":68776,"_29138":68642,"_20209":115747,"_5":13819,"_26493":115403,"_2816":51773},[],{"_3328":68777,"_29138":68642,"_20209":115749,"_5":13819,"_26493":115403,"_2816":115750},[],"Dispositivo",{"_3328":68778,"_29138":68642,"_20209":115752,"_5":13819,"_26493":115403,"_2816":51779},[],{"_3328":68779,"_29138":68642,"_20209":115754,"_5":13819,"_26493":115403,"_2816":51782},[],{"_3328":68780,"_29138":68642,"_20209":115756,"_5":13819,"_26493":115403,"_2816":115757},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3328":68781,"_29138":68642,"_20209":115759,"_5":13819,"_26493":115403,"_2816":115420},[],{"_3328":68782,"_29138":68642,"_20209":115761,"_5":13819,"_26493":115403,"_2816":51790},[],{"_3328":68783,"_29138":68642,"_20209":115763,"_5":13819,"_26493":115403,"_2816":115764},[],"Certificado",{"_3328":68784,"_29138":68642,"_20209":115766,"_5":13819,"_26493":115403,"_2816":51796},[],{"_3328":68785,"_29138":68642,"_20209":115768,"_5":13819,"_26493":115403,"_2816":115769},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3328":68786,"_29138":68642,"_20209":115771,"_5":13819,"_26493":115403,"_2816":115772},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3328":68787,"_29138":68642,"_20209":115774,"_5":13819,"_26493":115403,"_2816":115416},[],{"_3328":68788,"_29138":68642,"_20209":115776,"_5":13819,"_26493":115403,"_2816":51807},[],{"_3328":68789,"_29138":68642,"_20209":115778,"_5":13819,"_26493":115403,"_2816":115779},[],"Certificado / Dispositivo",{"_3328":68790,"_29138":68642,"_20209":115781,"_5":13819,"_26493":115403,"_2816":51813},[],{"_3328":68791,"_29138":68642,"_20209":115783,"_5":13819,"_26493":115403,"_2816":47825},[],{"_3328":68792,"_29138":68642,"_20209":115785,"_5":13819,"_26493":115403,"_2816":115786},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3328":68793,"_29138":68642,"_20209":115788,"_5":13819,"_26493":115403,"_2816":115470},[],{"_3328":68794,"_29138":68642,"_20209":115790,"_5":13819,"_26493":115407,"_2816":115791},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3328":68795,"_29138":68642,"_20209":115793,"_5":13819,"_26493":115407,"_2816":115794},[],"por el campo `registration.status` de los metadatos del conector en la CA:",{"_3328":68796,"_29138":68642,"_20209":115796,"_5":13819,"_26493":115407,"_2816":115797},[],"Transición",{"_3328":68797,"_29138":68642,"_20209":115799,"_5":13819,"_26493":115407,"_2816":115800},[],"Llamadas AWS",{"_3328":68798,"_29138":68642,"_20209":115802,"_5":13819,"_26493":115407,"_2816":115803},[],"`NoRegistrada` → `Solicitada`",{"_3328":68799,"_29138":68642,"_20209":115805,"_5":13819,"_26493":115407,"_2816":115806},[],"ninguna (solo escritura de metadatos)",{"_3328":68800,"_29138":68642,"_20209":115808,"_5":13819,"_26493":115407,"_2816":115809},[],"`Solicitada` → `Registrando`",{"_3328":68801,"_29138":68642,"_20209":115811,"_5":13819,"_26493":115407,"_2816":115812},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3328":68802,"_29138":68642,"_20209":115814,"_5":13819,"_26493":115407,"_2816":115815},[],"`Registrando` → `Completada`",{"_3328":68803,"_29138":68642,"_20209":115817,"_5":13819,"_26493":115407,"_2816":115818},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3328":68804,"_29138":68642,"_20209":115820,"_5":13819,"_26493":115407,"_2816":115821},[],"`Registrando` → `Fallida`",{"_3328":68805,"_29138":68642,"_20209":115823,"_5":13819,"_26493":115407,"_2816":115824},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3328":68806,"_29138":68642,"_20209":115826,"_5":13819,"_26493":115407,"_2816":115827},[],"`Fallida` / `Completada` → `Solicitada`",{"_3328":68807,"_29138":68642,"_20209":115829,"_5":13819,"_26493":115407,"_2816":115830},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3328":68808,"_29138":68642,"_20209":115832,"_5":13819,"_26493":115411,"_2816":115833},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3328":68809,"_29138":68642,"_20209":115835,"_5":13819,"_26493":115411,"_2816":115797},[],{"_3328":68810,"_29138":68642,"_20209":115837,"_5":13819,"_26493":115411,"_2816":115800},[],{"_3328":68811,"_29138":68642,"_20209":115839,"_5":13819,"_26493":115411,"_2816":115840},[],"`SinConfigurar` → `None` / `Auto`",{"_3328":68812,"_29138":68642,"_20209":115842,"_5":13819,"_26493":115411,"_2816":115843},[],"ninguna (solo configuración)",{"_3328":68813,"_29138":68642,"_20209":115845,"_5":13819,"_26493":115411,"_2816":51878},[],{"_3328":68814,"_29138":68642,"_20209":115847,"_5":13819,"_26493":115411,"_2816":115843},[],{"_3328":68815,"_29138":68642,"_20209":115849,"_5":13819,"_26493":115411,"_2816":115850},[],"Cualquiera → `Jitp`",{"_3328":68816,"_29138":68642,"_20209":115852,"_5":13819,"_26493":115411,"_2816":115853},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3328":68817,"_29138":68642,"_20209":115855,"_5":13819,"_26493":115411,"_2816":51889},[],{"_3328":68818,"_29138":68642,"_20209":115857,"_5":13819,"_26493":115411,"_2816":115858},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3328":68819,"_29138":68642,"_20209":115860,"_5":13819,"_26493":115415,"_2816":115861},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3328":68820,"_29138":68642,"_20209":115863,"_5":13819,"_26493":115415,"_2816":115797},[],{"_3328":68821,"_29138":68642,"_20209":115865,"_5":13819,"_26493":115415,"_2816":115800},[],{"_3328":68822,"_29138":68642,"_20209":115867,"_5":13819,"_26493":115415,"_2816":115868},[],"`NoSincronizado` → `Active`",{"_3328":68823,"_29138":68642,"_20209":115870,"_5":13819,"_26493":115415,"_2816":51546},[],{"_3328":68824,"_29138":68642,"_20209":115872,"_5":13819,"_26493":115415,"_2816":51907},[],{"_3328":68825,"_29138":68642,"_20209":115874,"_5":13819,"_26493":115415,"_2816":115875},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3328":68826,"_29138":68642,"_20209":115877,"_5":13819,"_26493":115415,"_2816":51913},[],{"_3328":68827,"_29138":68642,"_20209":115879,"_5":13819,"_26493":115415,"_2816":115875},[],{"_3328":68828,"_29138":68642,"_20209":115881,"_5":13819,"_26493":115415,"_2816":51918},[],{"_3328":68829,"_29138":68642,"_20209":115883,"_5":13819,"_26493":115415,"_2816":51546},[],{"_3328":68830,"_29138":68642,"_20209":115885,"_5":13819,"_26493":115415,"_2816":51923},[],{"_3328":68831,"_29138":68642,"_20209":115887,"_5":13819,"_26493":115415,"_2816":115888},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3328":68832,"_29138":68642,"_20209":115890,"_5":13819,"_26493":115419,"_2816":115891},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3328":68833,"_29138":68642,"_20209":115893,"_5":13819,"_26493":115419,"_2816":115797},[],{"_3328":68834,"_29138":68642,"_20209":115895,"_5":13819,"_26493":115419,"_2816":115800},[],{"_3328":68835,"_29138":68642,"_20209":115897,"_5":13819,"_26493":115419,"_2816":115898},[],"`Ausente` → `Aprovisionado`",{"_3328":68836,"_29138":68642,"_20209":115900,"_5":13819,"_26493":115419,"_2816":115901},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3328":68837,"_29138":68642,"_20209":115903,"_5":13819,"_26493":115419,"_2816":115904},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3328":68838,"_29138":68642,"_20209":115906,"_5":13819,"_26493":115419,"_2816":115907},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3328":68839,"_29138":68642,"_20209":115909,"_5":13819,"_26493":115419,"_2816":115910},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3328":68840,"_29138":68642,"_20209":115912,"_5":13819,"_26493":115423,"_2816":115913},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3328":68841,"_29138":68642,"_20209":115915,"_5":13819,"_26493":115427,"_2816":115916},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3328":68842,"_29138":68642,"_20209":115918,"_5":13819,"_26493":115427,"_2816":115919},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3328":68843,"_29138":68642,"_20209":115921,"_5":13819,"_26493":115431,"_2816":115922},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3328":68844,"_29138":68642,"_20209":115924,"_5":13819,"_26493":115431,"_2816":115925},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3328":68845,"_29138":68642,"_20209":115927,"_5":13819,"_26493":115431,"_2816":115928},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3328":68846,"_29138":68642,"_20209":115930,"_5":13819,"_26493":115431,"_2816":115931},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3328":68847,"_29138":68642,"_20209":115933,"_5":13819,"_26493":115431,"_2816":115934},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3328":68848,"_29138":68642,"_20209":115936,"_5":13819,"_26493":115431,"_2816":115937},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3328":68849,"_29138":68642,"_20209":115939,"_5":13819,"_26493":115434,"_2816":115940},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3328":68850,"_29138":68642,"_20209":115942,"_5":13819,"_26493":115437,"_2816":115943},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3328":68851,"_29138":68642,"_20209":115945,"_5":13819,"_26493":115437,"_2816":115946},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3328":68852,"_29138":68642,"_20209":115948,"_5":13819,"_26493":115441,"_2816":115949},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3328":68853,"_29138":68642,"_20209":115951,"_5":13819,"_26493":115445,"_2816":115952},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3328":68854,"_29138":68642,"_20209":115954,"_5":13819,"_26493":115445,"_2816":115955},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3328":68855,"_29138":68642,"_20209":115957,"_5":13819,"_26493":115445,"_2816":115958},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3328":68856,"_29138":68642,"_20209":115960,"_5":13819,"_26493":115445,"_2816":115961},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3328":68857,"_29138":68642,"_20209":115963,"_5":13819,"_26493":115445,"_2816":115964},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3328":68858,"_29138":68642,"_20209":115966,"_5":13819,"_26493":115445,"_2816":115967},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3328":68859,"_29138":68642,"_20209":115969,"_5":13819,"_26493":115449,"_2816":115970},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3328":68860,"_29138":68642,"_20209":115972,"_5":13819,"_26493":115449,"_2816":115973},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3328":68861,"_29138":68642,"_20209":115975,"_5":13819,"_26493":115449,"_2816":115976},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3328":68862,"_29138":68642,"_20209":115978,"_5":13819,"_26493":115449,"_2816":115979},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3328":68863,"_29138":68642,"_20209":115981,"_5":13819,"_26493":115449,"_2816":115982},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3328":68864,"_29138":68642,"_20209":115984,"_5":13819,"_26493":115453,"_2816":115985},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3328":68865,"_29138":68642,"_20209":115987,"_5":13819,"_26493":115453,"_2816":115988},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3328":68866,"_29138":68642,"_20209":115990,"_5":13819,"_26493":115453,"_2816":115991},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3328":68867,"_29138":68642,"_20209":115993,"_5":13819,"_26493":115457,"_2816":115994},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3328":68868,"_29138":68642,"_20209":115996,"_5":13819,"_26493":115457,"_2816":115997},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3328":68869,"_29138":68642,"_20209":115999,"_5":13819,"_26493":115457,"_2816":116000},[],"Para que el flujo JITP funcione correctamente:",{"_3328":68870,"_29138":68642,"_20209":116002,"_5":13819,"_26493":115457,"_2816":116003},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3328":68871,"_29138":68642,"_20209":116005,"_5":13819,"_26493":115457,"_2816":116006},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3328":68872,"_29138":68642,"_20209":116008,"_5":13819,"_26493":115457,"_2816":116009},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3328":68873,"_29138":68642,"_20209":116011,"_5":13819,"_26493":115457,"_2816":116012},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3328":68874,"_29138":68642,"_20209":116014,"_5":13819,"_26493":115461,"_2816":116015},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3328":68875,"_29138":68642,"_20209":116017,"_5":13819,"_26493":115461,"_2816":116018},[],"Estado en Lamassu",{"_3328":68876,"_29138":68642,"_20209":116020,"_5":13819,"_26493":115461,"_2816":116021},[],"Razón de revocación",{"_3328":68877,"_29138":68642,"_20209":116023,"_5":13819,"_26493":115461,"_2816":116024},[],"Estado en AWS IoT Core",{"_3328":68878,"_29138":68642,"_20209":116026,"_5":13819,"_26493":115461,"_2816":52068},[],{"_3328":68879,"_29138":68642,"_20209":116028,"_5":13819,"_26493":115461,"_2816":116029},[],"Ninguna",{"_3328":68880,"_29138":68642,"_20209":116031,"_5":13819,"_26493":115461,"_2816":52074},[],{"_3328":68881,"_29138":68642,"_20209":116033,"_5":13819,"_26493":115461,"_2816":52077},[],{"_3328":68882,"_29138":68642,"_20209":116035,"_5":13819,"_26493":115461,"_2816":52080},[],{"_3328":68883,"_29138":68642,"_20209":116037,"_5":13819,"_26493":115461,"_2816":52083},[],{"_3328":68884,"_29138":68642,"_20209":116039,"_5":13819,"_26493":115461,"_2816":52077},[],{"_3328":68885,"_29138":68642,"_20209":116041,"_5":13819,"_26493":115461,"_2816":116042},[],"Cualquier otra razón",{"_3328":68886,"_29138":68642,"_20209":116044,"_5":13819,"_26493":115461,"_2816":52091},[],{"_3328":68887,"_29138":68642,"_20209":116046,"_5":13819,"_26493":115461,"_2816":116047},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3328":68888,"_29138":68642,"_20209":116049,"_5":13819,"_26493":115465,"_2816":116050},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3328":68889,"_29138":68642,"_20209":116052,"_5":13819,"_26493":115465,"_2816":116053},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3328":68890,"_29138":68642,"_20209":116055,"_5":13819,"_26493":115465,"_2816":116056},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3328":68891,"_29138":68642,"_20209":116058,"_5":13819,"_26493":115469,"_2816":116059},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3328":68892,"_29138":68642,"_20209":116061,"_5":13819,"_26493":115469,"_2816":116062},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3328":68893,"_29138":68642,"_20209":116064,"_5":13819,"_26493":115473,"_2816":116065},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3328":68894,"_29138":68642,"_20209":116067,"_5":13819,"_26493":115473,"_2816":116068},[],"Existen dos tipos de acciones:",{"_3328":68895,"_29138":68642,"_20209":116070,"_5":13819,"_26493":115473,"_2816":116071},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3328":68896,"_29138":68642,"_20209":116073,"_5":13819,"_26493":115473,"_2816":116074},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3328":68897,"_29138":68642,"_20209":116076,"_5":13819,"_26493":115473,"_2816":116077},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3328":68898,"_29138":68642,"_20209":116079,"_5":13819,"_26493":115477,"_2816":116080},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3328":68899,"_29138":68642,"_20209":116082,"_5":13819,"_26493":115477,"_2816":116083},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3328":68900,"_29138":68642,"_20209":116085,"_5":13819,"_26493":115477,"_2816":116086},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3328":68901,"_29138":68642,"_20209":116088,"_5":13819,"_26493":115481,"_2816":116089},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3328":68902,"_29138":68642,"_20209":116091,"_5":13819,"_26493":115481,"_2816":116092},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3328":68903,"_29138":68642,"_20209":116094,"_5":13819,"_26493":115481,"_2816":116095},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3328":68904,"_29138":68642,"_20209":116097,"_5":13819,"_26493":115481,"_2816":116098},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3328":68905,"_29138":68642,"_20209":116100,"_5":13819,"_26493":115481,"_2816":116101},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3328":68906,"_29138":68642,"_20209":116103,"_5":13819,"_26493":115481,"_2816":116104},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3328":68907,"_29138":68642,"_20209":116106,"_5":13819,"_26493":115481,"_2816":116107},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3328":68908,"_29138":68642,"_20209":116109,"_5":13819,"_26493":115481,"_2816":116110},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3328":68909,"_29138":68642,"_20209":116112,"_5":13819,"_26493":115481,"_2816":116113},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3328":68910,"_29138":68642,"_20209":116115,"_5":13819,"_26493":115481,"_2816":116116},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3328":68911,"_29138":68642,"_20209":116118,"_5":13819,"_26493":115481,"_2816":116119},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3328":68912,"_29138":68642,"_20209":116121,"_5":13819,"_26493":115481,"_2816":116122},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3328":68913,"_29138":68642,"_20209":116124,"_5":13819,"_26493":115481,"_2816":116125},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3328":68914,"_29138":68642,"_20209":116127,"_5":13819,"_26493":115481,"_2816":116128},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3328":68915,"_29138":68642,"_20209":116130,"_5":13819,"_26493":115481,"_2816":116131},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3328":68916,"_29138":68642,"_20209":116133,"_5":13819,"_26493":115481,"_2816":116134},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3328":68917,"_29138":68642,"_20209":116136,"_5":13819,"_26493":115481,"_2816":116137},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3328":68918,"_29138":68642,"_20209":116139,"_5":13819,"_26493":115481,"_2816":116140},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3328":68919,"_29138":68642,"_20209":116142,"_5":13819,"_26493":115481,"_2816":116143},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3328":68920,"_29138":68642,"_20209":116145,"_5":13819,"_26493":115481,"_2816":116146},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3328":68921,"_29138":68642,"_20209":116148,"_5":13819,"_26493":115481,"_2816":116149},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3328":68922,"_29138":68642,"_20209":116151,"_5":13819,"_26493":115481,"_2816":116152},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3328":68923,"_29138":68642,"_20209":116154,"_5":13819,"_26493":115481,"_2816":116155},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3328":68924,"_29138":68642,"_20209":116157,"_5":13819,"_26493":115481,"_2816":116158},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3328":68925,"_29138":68925,"_5":14177,"_2816":49905,"_29482":116160,"_20209":116161,"_26493":68925},[47429,112963,49905],[],{"_3328":68926,"_29138":68925,"_20209":116163,"_5":13819,"_26493":68925,"_2816":116164},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3328":68927,"_29138":68925,"_5":29479,"_20209":116166,"_26493":116167,"_2816":116168},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3328":68928,"_29138":68925,"_5":29479,"_20209":116170,"_26493":116171,"_2816":113969},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3328":68929,"_29138":68925,"_5":29479,"_20209":116173,"_26493":116174,"_2816":114144},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3328":68930,"_29138":68925,"_5":29479,"_20209":116176,"_26493":116177,"_2816":115376},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/overview#integraciones",{"_3328":68931,"_29138":68925,"_5":29479,"_20209":116179,"_26493":116180,"_2816":116181},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3328":68932,"_29138":68925,"_20209":116183,"_5":13819,"_26493":68925,"_2816":116184},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3328":68933,"_29138":68925,"_20209":116186,"_5":13819,"_26493":116167,"_2816":116187},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3328":68934,"_29138":68925,"_20209":116189,"_5":13819,"_26493":116167,"_2816":116190},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3328":68935,"_29138":68925,"_20209":116192,"_5":13819,"_26493":116171,"_2816":116193},[],"Recurso",{"_3328":68936,"_29138":68925,"_20209":116195,"_5":13819,"_26493":116171,"_2816":116196},[],"Qué representa",{"_3328":68937,"_29138":68925,"_20209":116198,"_5":13819,"_26493":116171,"_2816":116199},[],"**Dispositivo**",{"_3328":68938,"_29138":68925,"_20209":116201,"_5":13819,"_26493":116171,"_2816":116202},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3328":68939,"_29138":68925,"_20209":116204,"_5":13819,"_26493":116171,"_2816":116205},[],"**Identidad**",{"_3328":68940,"_29138":68925,"_20209":116207,"_5":13819,"_26493":116171,"_2816":116208},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3328":68941,"_29138":68925,"_20209":116210,"_5":13819,"_26493":116171,"_2816":52258},[],{"_3328":68942,"_29138":68925,"_20209":116212,"_5":13819,"_26493":116171,"_2816":116213},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3328":68943,"_29138":68925,"_20209":116215,"_5":13819,"_26493":116171,"_2816":116216},[],"**Flota**",{"_3328":68944,"_29138":68925,"_20209":116218,"_5":13819,"_26493":116171,"_2816":116219},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3328":68945,"_29138":68925,"_20209":116221,"_5":13819,"_26493":116171,"_2816":116222},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3328":68946,"_29138":68925,"_20209":116224,"_5":13819,"_26493":116171,"_2816":116225},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3328":68947,"_29138":68925,"_20209":116227,"_5":13819,"_26493":116174,"_2816":116228},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3328":68948,"_29138":68925,"_20209":116230,"_5":13819,"_26493":116174,"_2816":116231},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3328":68949,"_29138":68925,"_20209":116233,"_5":13819,"_26493":116174,"_2816":116234},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3328":68950,"_29138":68925,"_20209":116236,"_5":13819,"_26493":116174,"_2816":116237},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3328":68951,"_29138":68925,"_20209":116239,"_5":13819,"_26493":116174,"_2816":116240},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3328":68952,"_29138":68925,"_20209":116242,"_5":13819,"_26493":116174,"_2816":116243},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3328":68953,"_29138":68925,"_20209":116245,"_5":13819,"_26493":116174,"_2816":116246},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3328":68954,"_29138":68925,"_20209":116248,"_5":13819,"_26493":116174,"_2816":116249},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3328":68955,"_29138":68925,"_20209":116251,"_5":13819,"_26493":116177,"_2816":116252},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3328":68956,"_29138":68925,"_20209":116254,"_5":13819,"_26493":116177,"_2816":116255},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3328":68957,"_29138":68925,"_20209":116257,"_5":13819,"_26493":116180,"_2816":116258},[],"Participante",{"_3328":68958,"_29138":68925,"_20209":116260,"_5":13819,"_26493":116180,"_2816":116261},[],"Responsabilidad",{"_3328":68959,"_29138":68925,"_20209":116263,"_5":13819,"_26493":116180,"_2816":116264},[],"Administrador PKI",{"_3328":68960,"_29138":68925,"_20209":116266,"_5":13819,"_26493":116180,"_2816":116267},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3328":68961,"_29138":68925,"_20209":116269,"_5":13819,"_26493":116180,"_2816":116270},[],"Administrador del aprovisionamiento",{"_3328":68962,"_29138":68925,"_20209":116272,"_5":13819,"_26493":116180,"_2816":116273},[],"DMS, admisión, autenticación por operación e inventario.",{"_3328":68963,"_29138":68925,"_20209":116275,"_5":13819,"_26493":116180,"_2816":116276},[],"Integrador del dispositivo",{"_3328":68964,"_29138":68925,"_20209":116278,"_5":13819,"_26493":116180,"_2816":116279},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3328":68965,"_29138":68925,"_20209":116281,"_5":13819,"_26493":116180,"_2816":116282},[],"Integrador del consumidor",{"_3328":68966,"_29138":68925,"_20209":116284,"_5":13819,"_26493":116180,"_2816":116285},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3328":68967,"_29138":68925,"_20209":116287,"_5":13819,"_26493":116180,"_2816":116288},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3328":68968,"_29138":68968,"_5":14177,"_2816":116290,"_29482":116291,"_20209":116293,"_26493":68968},"Enrola y conecta tu primer dispositivo",[47429,112963,49905,116292],"Primeros pasos",[],{"_3328":68969,"_29138":68968,"_20209":116295,"_5":13819,"_26493":68968,"_2816":116296},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3328":68970,"_29138":68968,"_5":29479,"_20209":116298,"_26493":116299,"_2816":111541},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3328":68971,"_29138":68968,"_5":29479,"_20209":116301,"_26493":116302,"_2816":116303},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3328":68972,"_29138":68968,"_5":29479,"_20209":116305,"_26493":116306,"_2816":116307},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3328":68973,"_29138":68968,"_5":29479,"_20209":116309,"_26493":116310,"_2816":116311},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3328":68974,"_29138":68968,"_5":29479,"_20209":116313,"_26493":116314,"_2816":116315},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3328":68975,"_29138":68968,"_5":29479,"_20209":116317,"_26493":116318,"_2816":116319},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3328":68976,"_29138":68968,"_5":29479,"_20209":116321,"_26493":116322,"_2816":116323},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3328":68977,"_29138":68968,"_5":29479,"_20209":116325,"_26493":116326,"_2816":116327},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3328":68978,"_29138":68968,"_20209":116329,"_5":13819,"_26493":68968,"_2816":116330},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3328":68979,"_29138":68968,"_20209":116332,"_5":13819,"_26493":116299,"_2816":116333},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3328":68980,"_29138":68968,"_20209":116335,"_5":13819,"_26493":116299,"_2816":116336},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3328":68981,"_29138":68968,"_20209":116338,"_5":13819,"_26493":116299,"_2816":116339},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3328":68982,"_29138":68968,"_20209":116341,"_5":13819,"_26493":116299,"_2816":116342},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3328":68983,"_29138":68968,"_20209":116344,"_5":13819,"_26493":116299,"_2816":116345},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3328":68984,"_29138":68968,"_20209":116347,"_5":13819,"_26493":116302,"_2816":116348},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3328":68985,"_29138":68968,"_20209":116350,"_5":13819,"_26493":116302,"_2816":116351},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3328":68986,"_29138":68968,"_20209":116353,"_5":13819,"_26493":116306,"_2816":116354},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3328":68987,"_29138":68968,"_20209":116356,"_5":13819,"_26493":116306,"_2816":116357},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3328":68988,"_29138":68968,"_20209":116359,"_5":13819,"_26493":116306,"_2816":116360},[],"Ajuste",{"_3328":68989,"_29138":68968,"_20209":116362,"_5":13819,"_26493":116306,"_2816":116363},[],"Valor de evaluación",{"_3328":68990,"_29138":68968,"_20209":116365,"_5":13819,"_26493":116306,"_2816":52414},[],{"_3328":68991,"_29138":68968,"_20209":116367,"_5":13819,"_26493":116306,"_2816":116368},[],"Raíz emisora de `device-root.pem`.",{"_3328":68992,"_29138":68968,"_20209":116370,"_5":13819,"_26493":116306,"_2816":114272},[],{"_3328":68993,"_29138":68968,"_20209":116372,"_5":13819,"_26493":116306,"_2816":116373},[],"Perfil final de 1 hora que acabas de preparar.",{"_3328":68994,"_29138":68968,"_20209":116375,"_5":13819,"_26493":116306,"_2816":52425},[],{"_3328":68995,"_29138":68968,"_20209":116377,"_5":13819,"_26493":116306,"_2816":52428},[],{"_3328":68996,"_29138":68968,"_20209":116379,"_5":13819,"_26493":116306,"_2816":52431},[],{"_3328":68997,"_29138":68968,"_20209":116381,"_5":13819,"_26493":116306,"_2816":116382},[],"Habilitado.",{"_3328":68998,"_29138":68968,"_20209":116384,"_5":13819,"_26493":116306,"_2816":52437},[],{"_3328":68999,"_29138":68968,"_20209":116386,"_5":13819,"_26493":116306,"_2816":116387},[],"Deshabilitado; el ID debe ser nuevo.",{"_3328":69000,"_29138":68968,"_20209":116389,"_5":13819,"_26493":116306,"_2816":116390},[],"Autenticación inicial",{"_3328":69001,"_29138":68968,"_20209":116392,"_5":13819,"_26493":116306,"_2816":116393},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3328":69002,"_29138":68968,"_20209":116395,"_5":13819,"_26493":116306,"_2816":116396},[],"Autenticación de renovación",{"_3328":69003,"_29138":68968,"_20209":116398,"_5":13819,"_26493":116306,"_2816":116399},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3328":69004,"_29138":68968,"_20209":116401,"_5":13819,"_26493":116306,"_2816":52455},[],{"_3328":69005,"_29138":68968,"_20209":116403,"_5":13819,"_26493":116306,"_2816":116404},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3328":69006,"_29138":68968,"_20209":116406,"_5":13819,"_26493":116306,"_2816":52461},[],{"_3328":69007,"_29138":68968,"_20209":116408,"_5":13819,"_26493":116306,"_2816":116409},[],"1 hora.",{"_3328":69008,"_29138":68968,"_20209":116411,"_5":13819,"_26493":116306,"_2816":52467},[],{"_3328":69009,"_29138":68968,"_20209":116413,"_5":13819,"_26493":116306,"_2816":116414},[],"30 minutos / 10 minutos.",{"_3328":69010,"_29138":68968,"_20209":116416,"_5":13819,"_26493":116306,"_2816":52473},[],{"_3328":69011,"_29138":68968,"_20209":116418,"_5":13819,"_26493":116306,"_2816":116419},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3328":69012,"_29138":68968,"_20209":116421,"_5":13819,"_26493":116306,"_2816":50224},[],{"_3328":69013,"_29138":68968,"_20209":116423,"_5":13819,"_26493":116306,"_2816":116424},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3328":69014,"_29138":68968,"_20209":116426,"_5":13819,"_26493":116306,"_2816":52484},[],{"_3328":69015,"_29138":68968,"_20209":116428,"_5":13819,"_26493":116306,"_2816":116429},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3328":69016,"_29138":68968,"_20209":116431,"_5":13819,"_26493":116306,"_2816":116432},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3328":69017,"_29138":68968,"_20209":116434,"_5":13819,"_26493":116310,"_2816":116435},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3328":69018,"_29138":68968,"_20209":116437,"_5":13819,"_26493":116310,"_2816":116438},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3328":69019,"_29138":68968,"_20209":116440,"_5":13819,"_26493":116314,"_2816":116441},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3328":69020,"_29138":68968,"_20209":116443,"_5":13819,"_26493":116314,"_2816":116444},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3328":69021,"_29138":68968,"_20209":116446,"_5":13819,"_26493":116314,"_2816":116447},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3328":69022,"_29138":68968,"_20209":116449,"_5":13819,"_26493":116318,"_2816":116450},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3328":69023,"_29138":68968,"_20209":116452,"_5":13819,"_26493":116318,"_2816":116453},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3328":69024,"_29138":68968,"_20209":116455,"_5":13819,"_26493":116322,"_2816":116456},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3328":69025,"_29138":68968,"_20209":116458,"_5":13819,"_26493":116322,"_2816":116459},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3328":69026,"_29138":68968,"_20209":116461,"_5":13819,"_26493":116322,"_2816":116462},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3328":69027,"_29138":68968,"_20209":116464,"_5":13819,"_26493":116322,"_2816":116465},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3328":69028,"_29138":68968,"_20209":116467,"_5":13819,"_26493":116322,"_2816":116468},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3328":69029,"_29138":68968,"_20209":116470,"_5":13819,"_26493":116326,"_2816":116471},[],"Comprobación",{"_3328":69030,"_29138":68968,"_20209":116473,"_5":13819,"_26493":116326,"_2816":116474},[],"Resultado esperado",{"_3328":69031,"_29138":68968,"_20209":116476,"_5":13819,"_26493":116326,"_2816":116477},[],"Registro",{"_3328":69032,"_29138":68968,"_20209":116479,"_5":13819,"_26493":116326,"_2816":116480},[],"ID creado automáticamente y DMS correcto.",{"_3328":69033,"_29138":68968,"_20209":116482,"_5":13819,"_26493":116326,"_2816":115764},[],{"_3328":69034,"_29138":68968,"_20209":116484,"_5":13819,"_26493":116326,"_2816":116485},[],"CN, perfil, serie y clave verificados.",{"_3328":69035,"_29138":68968,"_20209":116487,"_5":13819,"_26493":116326,"_2816":116488},[],"Inventario",{"_3328":69036,"_29138":68968,"_20209":116490,"_5":13819,"_26493":116326,"_2816":116491},[],"Serie recibida visible como identidad actual y en el historial.",{"_3328":69037,"_29138":68968,"_20209":116493,"_5":13819,"_26493":116326,"_2816":116494},[],"Consumidor",{"_3328":69038,"_29138":68968,"_20209":116496,"_5":13819,"_26493":116326,"_2816":116497},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3328":69039,"_29138":68968,"_20209":116499,"_5":13819,"_26493":116326,"_2816":116500},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3328":69040,"_29138":68968,"_20209":116502,"_5":13819,"_26493":116326,"_2816":116503},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3328":69041,"_29138":69041,"_5":14177,"_2816":113986,"_29482":116505,"_20209":116506,"_26493":69041},[47429,112963,49905,116292],[],{"_3328":69042,"_29138":69041,"_20209":116508,"_5":13819,"_26493":69041,"_2816":116509},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3328":69043,"_29138":69041,"_5":29479,"_20209":116511,"_26493":116512,"_2816":111541},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3328":69044,"_29138":69041,"_5":29479,"_20209":116514,"_26493":116515,"_2816":116516},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3328":69045,"_29138":69041,"_5":29479,"_20209":116518,"_26493":116519,"_2816":116520},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3328":69046,"_29138":69041,"_5":29479,"_20209":116522,"_26493":116523,"_2816":116524},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3328":69047,"_29138":69041,"_5":29479,"_20209":116526,"_26493":116527,"_2816":116528},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3328":69048,"_29138":69041,"_5":29479,"_20209":116530,"_26493":116531,"_2816":116532},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3328":69049,"_29138":69041,"_5":29479,"_20209":116534,"_26493":116535,"_2816":116474},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3328":69050,"_29138":69041,"_5":29479,"_20209":116537,"_26493":116538,"_2816":116539},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3328":69051,"_29138":69041,"_5":29479,"_20209":116541,"_26493":116542,"_2816":116543},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3328":69052,"_29138":69041,"_20209":116545,"_5":13819,"_26493":69041,"_2816":116546},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3328":69053,"_29138":69041,"_20209":116548,"_5":13819,"_26493":69041,"_2816":116549},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3328":69054,"_29138":69041,"_20209":116551,"_5":13819,"_26493":116512,"_2816":116552},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3328":69055,"_29138":69041,"_20209":116554,"_5":13819,"_26493":116512,"_2816":116555},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3328":69056,"_29138":69041,"_20209":116557,"_5":13819,"_26493":116512,"_2816":116558},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3328":69057,"_29138":69041,"_20209":116560,"_5":13819,"_26493":116512,"_2816":116561},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3328":69058,"_29138":69041,"_20209":116563,"_5":13819,"_26493":116515,"_2816":116564},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3328":69059,"_29138":69041,"_20209":116566,"_5":13819,"_26493":116515,"_2816":116567},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3328":69060,"_29138":69041,"_20209":116569,"_5":13819,"_26493":116515,"_2816":116570},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3328":69061,"_29138":69041,"_20209":116572,"_5":13819,"_26493":116515,"_2816":116573},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3328":69062,"_29138":69041,"_20209":116575,"_5":13819,"_26493":116515,"_2816":116576},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3328":69063,"_29138":69041,"_20209":116578,"_5":13819,"_26493":116515,"_2816":116579},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3328":69064,"_29138":69041,"_20209":116581,"_5":13819,"_26493":116515,"_2816":116582},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3328":69065,"_29138":69041,"_20209":116584,"_5":13819,"_26493":116515,"_2816":116585},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3328":69066,"_29138":69041,"_20209":116587,"_5":13819,"_26493":116519,"_2816":116588},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3328":69067,"_29138":69041,"_20209":116590,"_5":13819,"_26493":116519,"_2816":52649},[],{"_3328":69068,"_29138":69041,"_20209":116592,"_5":13819,"_26493":116519,"_2816":116593},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3328":69069,"_29138":69041,"_20209":116595,"_5":13819,"_26493":116519,"_2816":116596},[],"**Icon** y **Tags**: clasificación opcional.",{"_3328":69070,"_29138":69041,"_20209":116598,"_5":13819,"_26493":116519,"_2816":116599},[],"Confirma el registro.",{"_3328":69071,"_29138":69041,"_20209":116601,"_5":13819,"_26493":116523,"_2816":116602},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3328":69072,"_29138":69041,"_20209":116604,"_5":13819,"_26493":116523,"_2816":116605},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3328":69073,"_29138":69041,"_20209":116607,"_5":13819,"_26493":116527,"_2816":116608},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3328":69074,"_29138":69041,"_20209":116610,"_5":13819,"_26493":116527,"_2816":116611},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3328":69075,"_29138":69041,"_20209":116613,"_5":13819,"_26493":116531,"_2816":116614},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3328":69076,"_29138":69041,"_20209":116616,"_5":13819,"_26493":116531,"_2816":116617},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3328":69077,"_29138":69041,"_20209":116619,"_5":13819,"_26493":116535,"_2816":116471},[],{"_3328":69078,"_29138":69041,"_20209":116621,"_5":13819,"_26493":116535,"_2816":116622},[],"Resultado",{"_3328":69079,"_29138":69041,"_20209":116624,"_5":13819,"_26493":116535,"_2816":115750},[],{"_3328":69080,"_29138":69041,"_20209":116626,"_5":13819,"_26493":116535,"_2816":116627},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3328":69081,"_29138":69041,"_20209":116629,"_5":13819,"_26493":116535,"_2816":116630},[],"Identidad actual",{"_3328":69082,"_29138":69041,"_20209":116632,"_5":13819,"_26493":116535,"_2816":116633},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3328":69083,"_29138":69041,"_20209":116635,"_5":13819,"_26493":116535,"_2816":116636},[],"Historial",{"_3328":69084,"_29138":69041,"_20209":116638,"_5":13819,"_26493":116535,"_2816":116639},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3328":69085,"_29138":69041,"_20209":116641,"_5":13819,"_26493":116535,"_2816":116642},[],"Clave y certificado",{"_3328":69086,"_29138":69041,"_20209":116644,"_5":13819,"_26493":116535,"_2816":116645},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3328":69087,"_29138":69041,"_20209":116647,"_5":13819,"_26493":116538,"_2816":116648},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3328":69088,"_29138":69041,"_20209":116650,"_5":13819,"_26493":116538,"_2816":116651},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3328":69089,"_29138":69041,"_20209":116653,"_5":13819,"_26493":116538,"_2816":116654},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3328":69090,"_29138":69041,"_20209":116656,"_5":13819,"_26493":116538,"_2816":116657},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3328":69091,"_29138":69041,"_20209":116659,"_5":13819,"_26493":116542,"_2816":116660},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3328":69092,"_29138":69041,"_20209":116662,"_5":13819,"_26493":116542,"_2816":116663},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3328":69093,"_29138":69041,"_20209":116665,"_5":13819,"_26493":116542,"_2816":116666},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3328":69094,"_29138":69094,"_5":14177,"_2816":116668,"_29482":116669,"_20209":116670,"_26493":69094},"Plataforma Lamassu IoT",[47429,112963],[],{"_3328":69095,"_29138":69094,"_20209":116672,"_5":13819,"_26493":69094,"_2816":116673},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3328":69096,"_29138":69094,"_5":29479,"_20209":116675,"_26493":116676,"_2816":116168},[],"/docs/pr-preview/pr-45/es/platform/overview#empieza-aquí",{"_3328":69097,"_29138":69094,"_5":29479,"_20209":116678,"_26493":116679,"_2816":116680},[],"/docs/pr-preview/pr-45/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3328":69098,"_29138":69094,"_5":29479,"_20209":116682,"_26493":116683,"_2816":116684},[],"/docs/pr-preview/pr-45/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3328":69099,"_29138":69094,"_5":29479,"_20209":116686,"_26493":116687,"_2816":116688},[],"/docs/pr-preview/pr-45/es/platform/overview#capacidades-principales","Capacidades principales",{"_3328":69100,"_29138":69094,"_5":29479,"_20209":116690,"_26493":116691,"_2816":116692},[],"/docs/pr-preview/pr-45/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3328":69101,"_29138":69094,"_5":29479,"_20209":116694,"_26493":116695,"_2816":116696},[],"/docs/pr-preview/pr-45/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3328":69102,"_29138":69094,"_5":29479,"_20209":116698,"_26493":116699,"_2816":116700},[],"/docs/pr-preview/pr-45/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3328":69103,"_29138":69094,"_5":29479,"_20209":116702,"_26493":116703,"_2816":116704},[],"/docs/pr-preview/pr-45/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3328":69104,"_29138":69094,"_5":29479,"_20209":116706,"_26493":116707,"_2816":116708},[],"/docs/pr-preview/pr-45/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3328":69105,"_29138":69094,"_5":29479,"_20209":116710,"_26493":116711,"_2816":116712},[],"/docs/pr-preview/pr-45/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3328":69106,"_29138":69094,"_5":29479,"_20209":116714,"_26493":116715,"_2816":116716},[],"/docs/pr-preview/pr-45/es/platform/overview#referencia-operativa","Referencia operativa",{"_3328":69107,"_29138":69094,"_20209":116718,"_5":13819,"_26493":69094,"_2816":116719},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3328":69108,"_29138":69094,"_20209":116721,"_5":13819,"_26493":116676,"_2816":116722},[],"Elige el resultado que necesitas obtener:",{"_3328":69109,"_29138":69094,"_20209":116724,"_5":13819,"_26493":116676,"_2816":116725},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3328":69110,"_29138":69094,"_20209":116727,"_5":13819,"_26493":116676,"_2816":116728},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3328":69111,"_29138":69094,"_20209":116730,"_5":13819,"_26493":116676,"_2816":116731},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3328":69112,"_29138":69094,"_20209":116733,"_5":13819,"_26493":116679,"_2816":116734},[],"Bloque",{"_3328":69113,"_29138":69094,"_20209":116736,"_5":13819,"_26493":116679,"_2816":116737},[],"Qué gestionas",{"_3328":69114,"_29138":69094,"_20209":116739,"_5":13819,"_26493":116679,"_2816":116740},[],"Punto de entrada",{"_3328":69115,"_29138":69094,"_20209":116742,"_5":13819,"_26493":116679,"_2816":52802},[],{"_3328":69116,"_29138":69094,"_20209":116744,"_5":13819,"_26493":116679,"_2816":116745},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3328":69117,"_29138":69094,"_20209":116747,"_5":13819,"_26493":116679,"_2816":116748},[],"Visión general de PKI",{"_3328":69118,"_29138":69094,"_20209":116750,"_5":13819,"_26493":116679,"_2816":52811},[],{"_3328":69119,"_29138":69094,"_20209":116752,"_5":13819,"_26493":116679,"_2816":116753},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3328":69120,"_29138":69094,"_20209":116755,"_5":13819,"_26493":116679,"_2816":116756},[],"Visión general de IoT Fleets",{"_3328":69121,"_29138":69094,"_20209":116758,"_5":13819,"_26493":116679,"_2816":116759},[],"**Administración**",{"_3328":69122,"_29138":69094,"_20209":116761,"_5":13819,"_26493":116679,"_2816":116762},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3328":69123,"_29138":69094,"_20209":116764,"_5":13819,"_26493":116679,"_2816":112961},[],{"_3328":69124,"_29138":69094,"_20209":116766,"_5":13819,"_26493":116679,"_2816":116767},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3328":69125,"_29138":69094,"_20209":116769,"_5":13819,"_26493":116683,"_2816":116770},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3328":69126,"_29138":69094,"_20209":116772,"_5":13819,"_26493":116683,"_2816":116773},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3328":69127,"_29138":69094,"_20209":116775,"_5":13819,"_26493":116683,"_2816":116776},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3328":69128,"_29138":69094,"_20209":116778,"_5":13819,"_26493":116683,"_2816":116779},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3328":69129,"_29138":69094,"_20209":116781,"_5":13819,"_26493":116683,"_2816":116782},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3328":69130,"_29138":69094,"_20209":116784,"_5":13819,"_26493":116683,"_2816":116785},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3328":69131,"_29138":69094,"_20209":116787,"_5":13819,"_26493":116691,"_2816":116788},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3328":69132,"_29138":69094,"_20209":116790,"_5":13819,"_26493":116695,"_2816":116791},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3328":69133,"_29138":69094,"_20209":116793,"_5":13819,"_26493":116699,"_2816":116794},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3328":69134,"_29138":69094,"_20209":116796,"_5":13819,"_26493":116703,"_2816":116797},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3328":69135,"_29138":69094,"_20209":116799,"_5":13819,"_26493":116707,"_2816":116800},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3328":69136,"_29138":69094,"_20209":116802,"_5":13819,"_26493":116711,"_2816":116803},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3328":69137,"_29138":69094,"_20209":116805,"_5":13819,"_26493":116715,"_2816":116261},[],{"_3328":69138,"_29138":69094,"_20209":116807,"_5":13819,"_26493":116715,"_2816":116808},[],"Qué prepara o comprueba",{"_3328":69139,"_29138":69094,"_20209":116810,"_5":13819,"_26493":116715,"_2816":116264},[],{"_3328":69140,"_29138":69094,"_20209":116812,"_5":13819,"_26493":116715,"_2816":116813},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3328":69141,"_29138":69094,"_20209":116815,"_5":13819,"_26493":116715,"_2816":116816},[],"Administrador de la flota",{"_3328":69142,"_29138":69094,"_20209":116818,"_5":13819,"_26493":116715,"_2816":116819},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3328":69143,"_29138":69094,"_20209":116821,"_5":13819,"_26493":116715,"_2816":116276},[],{"_3328":69144,"_29138":69094,"_20209":116823,"_5":13819,"_26493":116715,"_2816":116824},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3328":69145,"_29138":69094,"_20209":116826,"_5":13819,"_26493":116715,"_2816":116282},[],{"_3328":69146,"_29138":69094,"_20209":116828,"_5":13819,"_26493":116715,"_2816":116829},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3328":69147,"_29138":69094,"_20209":116831,"_5":13819,"_26493":116715,"_2816":116832},[],"Operador de infraestructura",{"_3328":69148,"_29138":69094,"_20209":116834,"_5":13819,"_26493":116715,"_2816":116835},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3328":69149,"_29138":69094,"_20209":116837,"_5":13819,"_26493":116715,"_2816":116838},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3328":69150,"_29138":69150,"_5":14177,"_2816":116840,"_29482":116841,"_20209":116843,"_26493":69150},"Jerarquía y rotación de CAs",[47429,112963,52903,116842],"Claves, autoridades y certificados",[],{"_3328":69151,"_29138":69150,"_20209":116845,"_5":13819,"_26493":69150,"_2816":116846},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3328":69152,"_29138":69150,"_5":29479,"_20209":116848,"_26493":116849,"_2816":116850},[],"/docs/pr-preview/pr-45/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3328":69153,"_29138":69150,"_5":29479,"_20209":116852,"_26493":116853,"_2816":116854},[],"/docs/pr-preview/pr-45/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3328":69154,"_29138":69150,"_5":29479,"_20209":116856,"_26493":116857,"_2816":116858},[],"/docs/pr-preview/pr-45/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3328":69155,"_29138":69150,"_5":29479,"_20209":116860,"_26493":116861,"_2816":116862},[],"/docs/pr-preview/pr-45/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3328":69156,"_29138":69150,"_5":29479,"_20209":116864,"_26493":116865,"_2816":116866},[],"/docs/pr-preview/pr-45/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3328":69157,"_29138":69150,"_5":29479,"_20209":116868,"_26493":116869,"_2816":116870},[],"/docs/pr-preview/pr-45/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3328":69158,"_29138":69150,"_5":29479,"_20209":116872,"_26493":116873,"_2816":116874},[],"/docs/pr-preview/pr-45/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3328":69159,"_29138":69150,"_5":29479,"_20209":116876,"_26493":116877,"_2816":116878},[],"/docs/pr-preview/pr-45/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3328":69160,"_29138":69150,"_5":29479,"_20209":116880,"_26493":116881,"_2816":116882},[],"/docs/pr-preview/pr-45/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3328":69161,"_29138":69150,"_5":29479,"_20209":116884,"_26493":116885,"_2816":116886},[],"/docs/pr-preview/pr-45/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3328":69162,"_29138":69150,"_5":29479,"_20209":116888,"_26493":116889,"_2816":116890},[],"/docs/pr-preview/pr-45/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3328":69163,"_29138":69150,"_5":29479,"_20209":116892,"_26493":116893,"_2816":116894},[],"/docs/pr-preview/pr-45/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3328":69164,"_29138":69150,"_20209":116896,"_5":13819,"_26493":69150,"_2816":116897},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3328":69165,"_29138":69150,"_20209":116899,"_5":13819,"_26493":69150,"_2816":116900},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3328":69166,"_29138":69150,"_20209":116902,"_5":13819,"_26493":116849,"_2816":116903},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3328":69167,"_29138":69150,"_20209":116905,"_5":13819,"_26493":116849,"_2816":116906},[],"entorno, como producción y preproducción;",{"_3328":69168,"_29138":69150,"_20209":116908,"_5":13819,"_26493":116849,"_2816":116909},[],"propietario o equipo operador;",{"_3328":69169,"_29138":69150,"_20209":116911,"_5":13819,"_26493":116849,"_2816":116912},[],"familia de dispositivos o proceso de fabricación;",{"_3328":69170,"_29138":69150,"_20209":116914,"_5":13819,"_26493":116849,"_2816":116915},[],"región o requisito regulatorio;",{"_3328":69171,"_29138":69150,"_20209":116917,"_5":13819,"_26493":116849,"_2816":116918},[],"motor criptográfico o política de clave;",{"_3328":69172,"_29138":69150,"_20209":116920,"_5":13819,"_26493":116849,"_2816":116921},[],"ventana de mantenimiento y ritmo de renovación.",{"_3328":69173,"_29138":69150,"_20209":116923,"_5":13819,"_26493":116849,"_2816":116924},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3328":69174,"_29138":69150,"_20209":116926,"_5":13819,"_26493":116849,"_2816":116927},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3328":69175,"_29138":69150,"_20209":116929,"_5":13819,"_26493":116853,"_2816":116930},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3328":69176,"_29138":69150,"_20209":116932,"_5":13819,"_26493":116853,"_2816":116933},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3328":69177,"_29138":69150,"_20209":116935,"_5":13819,"_26493":116853,"_2816":116936},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3328":69178,"_29138":69150,"_20209":116938,"_5":13819,"_26493":116857,"_2816":116939},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3328":69179,"_29138":69150,"_20209":116941,"_5":13819,"_26493":116857,"_2816":116942},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3328":69180,"_29138":69150,"_20209":116944,"_5":13819,"_26493":116857,"_2816":116945},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3328":69181,"_29138":69150,"_20209":116947,"_5":13819,"_26493":116857,"_2816":116948},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3328":69182,"_29138":69150,"_20209":116950,"_5":13819,"_26493":116865,"_2816":116951},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3328":69183,"_29138":69150,"_20209":116953,"_5":13819,"_26493":116869,"_2816":116954},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3328":69184,"_29138":69150,"_20209":116956,"_5":13819,"_26493":116873,"_2816":116957},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3328":69185,"_29138":69150,"_20209":116959,"_5":13819,"_26493":116877,"_2816":116960},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3328":69186,"_29138":69150,"_20209":116962,"_5":13819,"_26493":116881,"_2816":116963},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3328":69187,"_29138":69150,"_20209":116965,"_5":13819,"_26493":116885,"_2816":116966},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3328":69188,"_29138":69150,"_20209":116968,"_5":13819,"_26493":116889,"_2816":116969},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3328":69189,"_29138":69150,"_20209":116971,"_5":13819,"_26493":116889,"_2816":116972},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3328":69190,"_29138":69150,"_20209":116974,"_5":13819,"_26493":116889,"_2816":116975},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3328":69191,"_29138":69150,"_20209":116977,"_5":13819,"_26493":116889,"_2816":116978},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3328":69192,"_29138":69150,"_20209":116980,"_5":13819,"_26493":116893,"_2816":116981},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3328":69193,"_29138":69150,"_20209":116983,"_5":13819,"_26493":116893,"_2816":116984},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3328":69194,"_29138":69150,"_20209":116986,"_5":13819,"_26493":116893,"_2816":116987},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3328":69195,"_29138":69150,"_20209":116989,"_5":13819,"_26493":116893,"_2816":116990},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3328":69196,"_29138":69150,"_20209":116992,"_5":13819,"_26493":116893,"_2816":116993},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3328":69197,"_29138":69150,"_20209":116995,"_5":13819,"_26493":116893,"_2816":116996},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3328":69198,"_29138":69150,"_20209":116998,"_5":13819,"_26493":116893,"_2816":116999},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3328":69199,"_29138":69199,"_5":14177,"_2816":117001,"_29482":117002,"_20209":117003,"_26493":69199},"Autoridades de certificación",[47429,112963,52903,116842],[],{"_3328":69200,"_29138":69199,"_20209":117005,"_5":13819,"_26493":69199,"_2816":117006},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3328":69201,"_29138":69199,"_5":29479,"_20209":117008,"_26493":117009,"_2816":117010},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3328":69202,"_29138":69199,"_5":29479,"_20209":117012,"_26493":117013,"_2816":117014},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3328":69203,"_29138":69199,"_5":29479,"_20209":117016,"_26493":117017,"_2816":111541},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3328":69204,"_29138":69199,"_5":29479,"_20209":117019,"_26493":117020,"_2816":117021},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3328":69205,"_29138":69199,"_5":29479,"_20209":117023,"_26493":117024,"_2816":117025},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3328":69206,"_29138":69199,"_5":29479,"_20209":117027,"_26493":117028,"_2816":117029},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3328":69207,"_29138":69199,"_5":29479,"_20209":117031,"_26493":117032,"_2816":117033},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3328":69208,"_29138":69199,"_5":29479,"_20209":117035,"_26493":117036,"_2816":117037},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3328":69209,"_29138":69199,"_5":29479,"_20209":117039,"_26493":117040,"_2816":117041},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3328":69210,"_29138":69199,"_5":29479,"_20209":117043,"_26493":117044,"_2816":117045},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3328":69211,"_29138":69199,"_5":29479,"_20209":117047,"_26493":117048,"_2816":117049},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3328":69212,"_29138":69199,"_5":29479,"_20209":117051,"_26493":117052,"_2816":117053},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3328":69213,"_29138":69199,"_5":29479,"_20209":117055,"_26493":117056,"_2816":117057},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3328":69214,"_29138":69199,"_5":29479,"_20209":117059,"_26493":117060,"_2816":117061},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3328":69215,"_29138":69199,"_5":29479,"_20209":117063,"_26493":117064,"_2816":117065},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3328":69216,"_29138":69199,"_5":29479,"_20209":117067,"_26493":117068,"_2816":117069},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3328":69217,"_29138":69199,"_5":29479,"_20209":117071,"_26493":117072,"_2816":117073},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3328":69218,"_29138":69199,"_5":29479,"_20209":117075,"_26493":117076,"_2816":117077},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3328":69219,"_29138":69199,"_5":29479,"_20209":117079,"_26493":117080,"_2816":117081},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3328":69220,"_29138":69199,"_5":29479,"_20209":117083,"_26493":117084,"_2816":117085},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3328":69221,"_29138":69199,"_5":29479,"_20209":117087,"_26493":117088,"_2816":117089},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3328":69222,"_29138":69199,"_5":29479,"_20209":117091,"_26493":117092,"_2816":117093},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3328":69223,"_29138":69199,"_5":29479,"_20209":117095,"_26493":117096,"_2816":117097},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3328":69224,"_29138":69199,"_20209":117099,"_5":13819,"_26493":69199,"_2816":117100},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3328":69225,"_29138":69199,"_20209":117102,"_5":13819,"_26493":69199,"_2816":117103},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3328":69226,"_29138":69199,"_20209":117105,"_5":13819,"_26493":69199,"_2816":117106},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3328":69227,"_29138":69199,"_20209":117108,"_5":13819,"_26493":117009,"_2816":117109},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3328":69228,"_29138":69199,"_20209":117111,"_5":13819,"_26493":117009,"_2816":117112},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3328":69229,"_29138":69199,"_20209":117114,"_5":13819,"_26493":117009,"_2816":117115},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3328":69230,"_29138":69199,"_20209":117117,"_5":13819,"_26493":117009,"_2816":117118},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3328":69231,"_29138":69199,"_20209":117120,"_5":13819,"_26493":117009,"_2816":117121},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3328":69232,"_29138":69199,"_20209":117123,"_5":13819,"_26493":117017,"_2816":117124},[],"Decide si la CA será raíz o intermedia.",{"_3328":69233,"_29138":69199,"_20209":117126,"_5":13819,"_26493":117017,"_2816":117127},[],"Elige el motor que custodiará la clave.",{"_3328":69234,"_29138":69199,"_20209":117129,"_5":13819,"_26493":117017,"_2816":117130},[],"Define una validez superior a la de los certificados que emitirá.",{"_3328":69235,"_29138":69199,"_20209":117132,"_5":13819,"_26493":117017,"_2816":117133},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3328":69236,"_29138":69199,"_20209":117135,"_5":13819,"_26493":117020,"_2816":117136},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3328":69237,"_29138":69199,"_20209":117138,"_5":13819,"_26493":117024,"_2816":117139},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3328":69238,"_29138":69199,"_20209":117141,"_5":13819,"_26493":117024,"_2816":117142},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3328":69239,"_29138":69199,"_20209":117144,"_5":13819,"_26493":117028,"_2816":117145},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3328":69240,"_29138":69199,"_20209":117147,"_5":13819,"_26493":117032,"_2816":117148},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3328":69241,"_29138":69199,"_20209":117150,"_5":13819,"_26493":117032,"_2816":117151},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3328":69242,"_29138":69199,"_20209":117153,"_5":13819,"_26493":117032,"_2816":117154},[],"`ST`: estado o provincia.",{"_3328":69243,"_29138":69199,"_20209":117156,"_5":13819,"_26493":117032,"_2816":117157},[],"`L`: localidad.",{"_3328":69244,"_29138":69199,"_20209":117159,"_5":13819,"_26493":117032,"_2816":117160},[],"`O`: organización.",{"_3328":69245,"_29138":69199,"_20209":117162,"_5":13819,"_26493":117032,"_2816":117163},[],"`OU`: unidad organizativa.",{"_3328":69246,"_29138":69199,"_20209":117165,"_5":13819,"_26493":117032,"_2816":117166},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3328":69247,"_29138":69199,"_20209":117168,"_5":13819,"_26493":117036,"_2816":117169},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3328":69248,"_29138":69199,"_20209":117171,"_5":13819,"_26493":117036,"_2816":117172},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3328":69249,"_29138":69199,"_20209":117174,"_5":13819,"_26493":117040,"_2816":117175},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3328":69250,"_29138":69199,"_20209":117177,"_5":13819,"_26493":117040,"_2816":117178},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3328":69251,"_29138":69199,"_20209":117180,"_5":13819,"_26493":117044,"_2816":117181},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3328":69252,"_29138":69199,"_20209":117183,"_5":13819,"_26493":117044,"_2816":117184},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3328":69253,"_29138":69199,"_20209":117186,"_5":13819,"_26493":117048,"_2816":117187},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3328":69254,"_29138":69199,"_20209":117189,"_5":13819,"_26493":117052,"_2816":117190},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3328":69255,"_29138":69199,"_20209":117192,"_5":13819,"_26493":117056,"_2816":117193},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3328":69256,"_29138":69199,"_20209":117195,"_5":13819,"_26493":117060,"_2816":117196},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3328":69257,"_29138":69199,"_20209":117198,"_5":13819,"_26493":117064,"_2816":117199},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3328":69258,"_29138":69199,"_20209":117201,"_5":13819,"_26493":117064,"_2816":117202},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3328":69259,"_29138":69199,"_20209":117204,"_5":13819,"_26493":117068,"_2816":117205},[],"Abre una CA desde el inventario para consultar:",{"_3328":69260,"_29138":69199,"_20209":117207,"_5":13819,"_26493":117068,"_2816":117208},[],"Estado y periodo de validez.",{"_3328":69261,"_29138":69199,"_20209":117210,"_5":13819,"_26493":117068,"_2816":117211},[],"Certificado y cadena en formato PEM.",{"_3328":69262,"_29138":69199,"_20209":117213,"_5":13819,"_26493":117068,"_2816":117214},[],"Número de certificados activos, expirados y revocados.",{"_3328":69263,"_29138":69199,"_20209":117216,"_5":13819,"_26493":117068,"_2816":117217},[],"Certificados emitidos en **Issued Certificates**.",{"_3328":69264,"_29138":69199,"_20209":117219,"_5":13819,"_26493":117068,"_2816":117220},[],"CRL vinculada a la autoridad.",{"_3328":69265,"_29138":69199,"_20209":117222,"_5":13819,"_26493":117068,"_2816":117223},[],"Metadatos y motor criptográfico asociado.",{"_3328":69266,"_29138":69199,"_20209":117225,"_5":13819,"_26493":117068,"_2816":117226},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3328":69267,"_29138":69199,"_20209":117228,"_5":13819,"_26493":117072,"_2816":117229},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3328":69268,"_29138":69199,"_20209":117231,"_5":13819,"_26493":117072,"_2816":117232},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3328":69269,"_29138":69199,"_20209":117234,"_5":13819,"_26493":117072,"_2816":117235},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3328":69270,"_29138":69199,"_20209":117237,"_5":13819,"_26493":117072,"_2816":117238},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3328":69271,"_29138":69199,"_20209":117240,"_5":13819,"_26493":117076,"_2816":117241},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3328":69272,"_29138":69199,"_20209":117243,"_5":13819,"_26493":117080,"_2816":117244},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3328":69273,"_29138":69199,"_20209":117246,"_5":13819,"_26493":117084,"_2816":117247},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3328":69274,"_29138":69199,"_20209":117249,"_5":13819,"_26493":117088,"_2816":117250},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3328":69275,"_29138":69199,"_20209":117252,"_5":13819,"_26493":117092,"_2816":117253},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3328":69276,"_29138":69199,"_20209":117255,"_5":13819,"_26493":117096,"_2816":117256},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3328":69277,"_29138":69199,"_20209":117258,"_5":13819,"_26493":117096,"_2816":117259},[],"El rol VA de la CA se conserva. Si no queda otra CA con el mismo SKI, deja de ser editable (consulta CRL), así que ajusta antes su validez y su firmante. La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3328":69278,"_29138":69199,"_20209":117261,"_5":13819,"_26493":117096,"_2816":117262},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. Si el certificado nuevo usa la misma clave, comparte el SKI con el rol VA retenido de la CA eliminada, cuyo firmante es el certificado antiguo: comprueba que la CRL se genera y, si no es así, asigna con `PUT` un firmante de la CA nueva (consulta CRL).",{"_3328":69279,"_29138":69279,"_5":14177,"_2816":117264,"_29482":117265,"_20209":117266,"_26493":69279},"Perfiles de certificado",[47429,112963,52903,116842],[],{"_3328":69280,"_29138":69279,"_20209":117268,"_5":13819,"_26493":69279,"_2816":117269},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3328":69281,"_29138":69279,"_5":29479,"_20209":117271,"_26493":117272,"_2816":117273},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3328":69282,"_29138":69279,"_5":29479,"_20209":117275,"_26493":117276,"_2816":117277},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-profiles#validez","Validez",{"_3328":69283,"_29138":69279,"_5":29479,"_20209":117279,"_26493":117280,"_2816":117281},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3328":69284,"_29138":69279,"_5":29479,"_20209":117283,"_26493":117284,"_2816":117285},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3328":69285,"_29138":69279,"_5":29479,"_20209":117287,"_26493":117288,"_2816":117289},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3328":69286,"_29138":69279,"_5":29479,"_20209":117291,"_26493":117292,"_2816":117293},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3328":69287,"_29138":69279,"_5":29479,"_20209":117295,"_26493":117296,"_2816":117297},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3328":69288,"_29138":69279,"_5":29479,"_20209":117299,"_26493":117300,"_2816":117301},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3328":69289,"_29138":69279,"_5":29479,"_20209":117303,"_26493":117304,"_2816":117305},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3328":69290,"_29138":69279,"_5":29479,"_20209":117307,"_26493":117308,"_2816":117309},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3328":69291,"_29138":69279,"_5":29479,"_20209":117311,"_26493":117312,"_2816":117313},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3328":69292,"_29138":69279,"_5":29479,"_20209":117315,"_26493":117316,"_2816":117317},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3328":69293,"_29138":69279,"_5":29479,"_20209":117319,"_26493":117320,"_2816":117321},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3328":69294,"_29138":69279,"_5":29479,"_20209":117323,"_26493":117324,"_2816":117325},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3328":69295,"_29138":69279,"_5":29479,"_20209":117327,"_26493":117328,"_2816":117329},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3328":69296,"_29138":69279,"_5":29479,"_20209":117331,"_26493":117332,"_2816":117333},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3328":69297,"_29138":69279,"_20209":117335,"_5":13819,"_26493":69279,"_2816":117336},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3328":69298,"_29138":69279,"_20209":117338,"_5":13819,"_26493":69279,"_2816":117339},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3328":69299,"_29138":69279,"_20209":117341,"_5":13819,"_26493":117276,"_2816":117342},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3328":69300,"_29138":69279,"_20209":117344,"_5":13819,"_26493":117276,"_2816":117345},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3328":69301,"_29138":69279,"_20209":117347,"_5":13819,"_26493":117280,"_2816":117348},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3328":69302,"_29138":69279,"_20209":117350,"_5":13819,"_26493":117284,"_2816":117351},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3328":69303,"_29138":69279,"_20209":117353,"_5":13819,"_26493":117284,"_2816":117354},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3328":69304,"_29138":69279,"_20209":117356,"_5":13819,"_26493":117284,"_2816":117357},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3328":69305,"_29138":69279,"_20209":117359,"_5":13819,"_26493":117288,"_2816":117360},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3328":69306,"_29138":69279,"_20209":117362,"_5":13819,"_26493":117292,"_2816":117363},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3328":69307,"_29138":69279,"_20209":117365,"_5":13819,"_26493":117292,"_2816":117366},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3328":69308,"_29138":69279,"_20209":117368,"_5":13819,"_26493":117296,"_2816":117369},[],"La aplicación criptográfica puede:",{"_3328":69309,"_29138":69279,"_20209":117371,"_5":13819,"_26493":117296,"_2816":117372},[],"permitir o bloquear claves RSA;",{"_3328":69310,"_29138":69279,"_20209":117374,"_5":13819,"_26493":117296,"_2816":117375},[],"limitar los tamaños RSA admitidos;",{"_3328":69311,"_29138":69279,"_20209":117377,"_5":13819,"_26493":117296,"_2816":117378},[],"permitir o bloquear claves ECDSA;",{"_3328":69312,"_29138":69279,"_20209":117380,"_5":13819,"_26493":117296,"_2816":117381},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3328":69313,"_29138":69279,"_20209":117383,"_5":13819,"_26493":117296,"_2816":117384},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3328":69314,"_29138":69279,"_20209":117386,"_5":13819,"_26493":117300,"_2816":117387},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3328":69315,"_29138":69279,"_20209":117389,"_5":13819,"_26493":117300,"_2816":112723},[],{"_3328":69316,"_29138":69279,"_20209":117391,"_5":13819,"_26493":117300,"_2816":117392},[],"Primera opción",{"_3328":69317,"_29138":69279,"_20209":117394,"_5":13819,"_26493":117300,"_2816":117395},[],"Segunda opción",{"_3328":69318,"_29138":69279,"_20209":117397,"_5":13819,"_26493":117300,"_2816":117398},[],"Si no hay ninguna",{"_3328":69319,"_29138":69279,"_20209":117400,"_5":13819,"_26493":117300,"_2816":117401},[],"Firma directa con una CA",{"_3328":69320,"_29138":69279,"_20209":117403,"_5":13819,"_26493":117300,"_2816":117404},[],"`issuance_profile` incluido en la solicitud",{"_3328":69321,"_29138":69279,"_20209":117406,"_5":13819,"_26493":117300,"_2816":117407},[],"`issuance_profile_id` de la solicitud",{"_3328":69322,"_29138":69279,"_20209":117409,"_5":13819,"_26493":117300,"_2816":117410},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3328":69323,"_29138":69279,"_20209":117412,"_5":13819,"_26493":117300,"_2816":117413},[],"Emisión mediante DMS",{"_3328":69324,"_29138":69279,"_20209":117415,"_5":13819,"_26493":117300,"_2816":53478},[],{"_3328":69325,"_29138":69279,"_20209":117417,"_5":13819,"_26493":117300,"_2816":117418},[],"`settings.issuance_profile` incluido en el DMS",{"_3328":69326,"_29138":69279,"_20209":117420,"_5":13819,"_26493":117300,"_2816":117421},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3328":69327,"_29138":69279,"_20209":117423,"_5":13819,"_26493":117300,"_2816":117424},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3328":69328,"_29138":69279,"_20209":117426,"_5":13819,"_26493":117300,"_2816":117427},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3328":69329,"_29138":69279,"_20209":117429,"_5":13819,"_26493":117308,"_2816":117430},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3328":69330,"_29138":69279,"_20209":117432,"_5":13819,"_26493":117312,"_2816":117433},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3328":69331,"_29138":69279,"_20209":117435,"_5":13819,"_26493":117316,"_2816":117436},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3328":69332,"_29138":69279,"_20209":117438,"_5":13819,"_26493":117320,"_2816":117439},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3328":69333,"_29138":69279,"_20209":117441,"_5":13819,"_26493":117324,"_2816":117442},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3328":69334,"_29138":69279,"_20209":117444,"_5":13819,"_26493":117324,"_2816":117445},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3328":69335,"_29138":69279,"_20209":117447,"_5":13819,"_26493":117328,"_2816":117448},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3328":69336,"_29138":69279,"_20209":117450,"_5":13819,"_26493":117328,"_2816":117451},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3328":69337,"_29138":69279,"_20209":117453,"_5":13819,"_26493":117328,"_2816":117454},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3328":69338,"_29138":69279,"_20209":117456,"_5":13819,"_26493":117328,"_2816":117457},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3328":69339,"_29138":69279,"_20209":117459,"_5":13819,"_26493":117332,"_2816":117460},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3328":69340,"_29138":69279,"_20209":117462,"_5":13819,"_26493":117332,"_2816":117463},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3328":69341,"_29138":69341,"_5":14177,"_2816":117465,"_29482":117466,"_20209":117468,"_26493":69341},"Validación de certificados",[47429,112963,52903,117467],"Validación",[],{"_3328":69342,"_29138":69341,"_20209":117470,"_5":13819,"_26493":69341,"_2816":117471},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3328":69343,"_29138":69341,"_5":29479,"_20209":117473,"_26493":117474,"_2816":117475},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3328":69344,"_29138":69341,"_5":29479,"_20209":117477,"_26493":117478,"_2816":117479},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3328":69345,"_29138":69341,"_5":29479,"_20209":117481,"_26493":117482,"_2816":117483},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3328":69346,"_29138":69341,"_20209":117485,"_5":13819,"_26493":69341,"_2816":117486},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3328":69347,"_29138":69341,"_20209":117488,"_5":13819,"_26493":117474,"_2816":117489},[],"Verifica estos criterios juntos:",{"_3328":69348,"_29138":69341,"_20209":117491,"_5":13819,"_26493":117474,"_2816":116471},[],{"_3328":69349,"_29138":69341,"_20209":117493,"_5":13819,"_26493":117474,"_2816":117494},[],"Resultado necesario",{"_3328":69350,"_29138":69341,"_20209":117496,"_5":13819,"_26493":117474,"_2816":117497},[],"Cadena y firma",{"_3328":69351,"_29138":69341,"_20209":117499,"_5":13819,"_26493":117474,"_2816":117500},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3328":69352,"_29138":69341,"_20209":117502,"_5":13819,"_26493":117474,"_2816":117503},[],"Fechas",{"_3328":69353,"_29138":69341,"_20209":117505,"_5":13819,"_26493":117474,"_2816":117506},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3328":69354,"_29138":69341,"_20209":117508,"_5":13819,"_26493":117474,"_2816":112633},[],{"_3328":69355,"_29138":69341,"_20209":117510,"_5":13819,"_26493":117474,"_2816":117511},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3328":69356,"_29138":69341,"_20209":117513,"_5":13819,"_26493":117474,"_2816":117514},[],"Uso",{"_3328":69357,"_29138":69341,"_20209":117516,"_5":13819,"_26493":117474,"_2816":117517},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3328":69358,"_29138":69341,"_20209":117519,"_5":13819,"_26493":117474,"_2816":117520},[],"Revocación",{"_3328":69359,"_29138":69341,"_20209":117522,"_5":13819,"_26493":117474,"_2816":117523},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3328":69360,"_29138":69341,"_20209":117525,"_5":13819,"_26493":117474,"_2816":117526},[],"Autorización",{"_3328":69361,"_29138":69341,"_20209":117528,"_5":13819,"_26493":117474,"_2816":117529},[],"La aplicación permite la acción a esa identidad.",{"_3328":69362,"_29138":69341,"_20209":117531,"_5":13819,"_26493":117474,"_2816":117532},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3328":69363,"_29138":69341,"_20209":117534,"_5":13819,"_26493":117478,"_2816":117535},[],"Mecanismo",{"_3328":69364,"_29138":69341,"_20209":117537,"_5":13819,"_26493":117478,"_2816":117538},[],"Cuándo utilizarlo",{"_3328":69365,"_29138":69341,"_20209":117540,"_5":13819,"_26493":117478,"_2816":117541},[],"Qué debes mantener",{"_3328":69366,"_29138":69341,"_20209":117543,"_5":13819,"_26493":117478,"_2816":53606},[],{"_3328":69367,"_29138":69341,"_20209":117545,"_5":13819,"_26493":117478,"_2816":117546},[],"Consulta del estado de un certificado concreto.",{"_3328":69368,"_29138":69341,"_20209":117548,"_5":13819,"_26493":117478,"_2816":117549},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3328":69369,"_29138":69341,"_20209":117551,"_5":13819,"_26493":117478,"_2816":53615},[],{"_3328":69370,"_29138":69341,"_20209":117553,"_5":13819,"_26493":117478,"_2816":117554},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3328":69371,"_29138":69341,"_20209":117556,"_5":13819,"_26493":117478,"_2816":117557},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3328":69372,"_29138":69341,"_20209":117559,"_5":13819,"_26493":117478,"_2816":117560},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3328":69373,"_29138":69341,"_20209":117562,"_5":13819,"_26493":117478,"_2816":117563},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3328":69374,"_29138":69341,"_20209":117565,"_5":13819,"_26493":117482,"_2816":117566},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3328":69375,"_29138":69341,"_20209":117568,"_5":13819,"_26493":117482,"_2816":117569},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3328":69376,"_29138":69341,"_20209":117571,"_5":13819,"_26493":117482,"_2816":117572},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3328":69377,"_29138":69341,"_20209":117574,"_5":13819,"_26493":117482,"_2816":117575},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3328":69378,"_29138":69341,"_20209":117577,"_5":13819,"_26493":117482,"_2816":117578},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3328":69379,"_29138":69341,"_20209":117580,"_5":13819,"_26493":117482,"_2816":117581},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3328":69380,"_29138":69341,"_20209":117583,"_5":13819,"_26493":117482,"_2816":117584},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3328":69381,"_29138":69341,"_20209":117586,"_5":13819,"_26493":117482,"_2816":117587},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3328":69382,"_29138":69341,"_20209":117589,"_5":13819,"_26493":117482,"_2816":117590},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3328":69383,"_29138":69383,"_5":14177,"_2816":117592,"_29482":117593,"_20209":117594,"_26493":69383},"Certificados",[47429,112963,52903,116842],[],{"_3328":69384,"_29138":69383,"_20209":117596,"_5":13819,"_26493":69383,"_2816":117597},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3328":69385,"_29138":69383,"_5":29479,"_20209":117599,"_26493":117600,"_2816":117601},[],"/docs/pr-preview/pr-45/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3328":69386,"_29138":69383,"_5":29479,"_20209":117603,"_26493":117604,"_2816":117605},[],"/docs/pr-preview/pr-45/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3328":69387,"_29138":69383,"_5":29479,"_20209":117607,"_26493":117608,"_2816":117609},[],"/docs/pr-preview/pr-45/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3328":69388,"_29138":69383,"_5":29479,"_20209":117611,"_26493":117612,"_2816":117613},[],"/docs/pr-preview/pr-45/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3328":69389,"_29138":69383,"_5":29479,"_20209":117615,"_26493":117616,"_2816":117617},[],"/docs/pr-preview/pr-45/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3328":69390,"_29138":69383,"_5":29479,"_20209":117619,"_26493":117620,"_2816":117621},[],"/docs/pr-preview/pr-45/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3328":69391,"_29138":69383,"_5":29479,"_20209":117623,"_26493":117624,"_2816":117625},[],"/docs/pr-preview/pr-45/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3328":69392,"_29138":69383,"_5":29479,"_20209":117627,"_26493":117628,"_2816":117629},[],"/docs/pr-preview/pr-45/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3328":69393,"_29138":69383,"_5":29479,"_20209":117631,"_26493":117632,"_2816":117633},[],"/docs/pr-preview/pr-45/es/platform/pki/certificates#continúa","Continúa",{"_3328":69394,"_29138":69383,"_20209":117635,"_5":13819,"_26493":69383,"_2816":117636},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3328":69395,"_29138":69383,"_20209":117638,"_5":13819,"_26493":117600,"_2816":117639},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3328":69396,"_29138":69383,"_20209":117641,"_5":13819,"_26493":117600,"_2816":117642},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3328":69397,"_29138":69383,"_20209":117644,"_5":13819,"_26493":117604,"_2816":117645},[],"Descarga el PEM e inspecciónalo:",{"_3328":69398,"_29138":69383,"_20209":117647,"_5":13819,"_26493":117604,"_2816":117648},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3328":69399,"_29138":69383,"_20209":117650,"_5":13819,"_26493":117608,"_2816":117651},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3328":69400,"_29138":69383,"_20209":117653,"_5":13819,"_26493":117608,"_2816":117654},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3328":69401,"_29138":69383,"_20209":117656,"_5":13819,"_26493":117608,"_2816":117657},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3328":69402,"_29138":69383,"_20209":117659,"_5":13819,"_26493":117608,"_2816":117660},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3328":69403,"_29138":69383,"_20209":117662,"_5":13819,"_26493":117608,"_2816":117663},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3328":69404,"_29138":69383,"_20209":117665,"_5":13819,"_26493":117608,"_2816":117666},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3328":69405,"_29138":69383,"_20209":117668,"_5":13819,"_26493":117608,"_2816":117669},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3328":69406,"_29138":69383,"_20209":117671,"_5":13819,"_26493":117612,"_2816":117672},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3328":69407,"_29138":69383,"_20209":117674,"_5":13819,"_26493":117616,"_2816":117675},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3328":69408,"_29138":69383,"_20209":117677,"_5":13819,"_26493":117620,"_2816":117678},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3328":69409,"_29138":69383,"_20209":117680,"_5":13819,"_26493":117624,"_2816":117681},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3328":69410,"_29138":69383,"_20209":117683,"_5":13819,"_26493":117624,"_2816":117684},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3328":69411,"_29138":69383,"_20209":117686,"_5":13819,"_26493":117624,"_2816":117687},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3328":69412,"_29138":69383,"_20209":117689,"_5":13819,"_26493":117628,"_2816":117690},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3328":69413,"_29138":69383,"_20209":117692,"_5":13819,"_26493":117628,"_2816":117693},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3328":69414,"_29138":69383,"_20209":117695,"_5":13819,"_26493":117628,"_2816":117696},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3328":69415,"_29138":69383,"_20209":117698,"_5":13819,"_26493":117632,"_2816":117699},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3328":69416,"_29138":69383,"_20209":117701,"_5":13819,"_26493":117632,"_2816":117702},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3328":69417,"_29138":69417,"_5":14177,"_2816":117704,"_29482":117705,"_20209":117707,"_26493":69417},"Ciclo de vida de un certificado",[47429,112963,52903,117706],"Conceptos",[],{"_3328":69418,"_29138":69417,"_20209":117709,"_5":13819,"_26493":69417,"_2816":117710},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3328":69419,"_29138":69417,"_5":29479,"_20209":117712,"_26493":117713,"_2816":117714},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3328":69420,"_29138":69417,"_5":29479,"_20209":117716,"_26493":117717,"_2816":117718},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3328":69421,"_29138":69417,"_5":29479,"_20209":117720,"_26493":117721,"_2816":117722},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3328":69422,"_29138":69417,"_5":29479,"_20209":117724,"_26493":117725,"_2816":117726},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3328":69423,"_29138":69417,"_5":29479,"_20209":117728,"_26493":117729,"_2816":117730},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3328":69424,"_29138":69417,"_5":29479,"_20209":117732,"_26493":117733,"_2816":117734},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3328":69425,"_29138":69417,"_5":29479,"_20209":117736,"_26493":117737,"_2816":115416},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3328":69426,"_29138":69417,"_5":29479,"_20209":117739,"_26493":117740,"_2816":117741},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3328":69427,"_29138":69417,"_5":29479,"_20209":117743,"_26493":117744,"_2816":117745},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3328":69428,"_29138":69417,"_5":29479,"_20209":117747,"_26493":117748,"_2816":117749},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3328":69429,"_29138":69417,"_20209":117751,"_5":13819,"_26493":69417,"_2816":117752},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3328":69430,"_29138":69417,"_20209":117754,"_5":13819,"_26493":117717,"_2816":117755},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3328":69431,"_29138":69417,"_20209":117757,"_5":13819,"_26493":117721,"_2816":117758},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3328":69432,"_29138":69417,"_20209":117760,"_5":13819,"_26493":117725,"_2816":117761},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3328":69433,"_29138":69417,"_20209":117763,"_5":13819,"_26493":117729,"_2816":117764},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3328":69434,"_29138":69417,"_20209":117766,"_5":13819,"_26493":117733,"_2816":117767},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3328":69435,"_29138":69417,"_20209":117769,"_5":13819,"_26493":117737,"_2816":117770},[],"Lamassu persiste cuatro estados X.509:",{"_3328":69436,"_29138":69417,"_20209":117772,"_5":13819,"_26493":117737,"_2816":117773},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3328":69437,"_29138":69417,"_20209":117775,"_5":13819,"_26493":117737,"_2816":117776},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3328":69438,"_29138":69417,"_20209":117778,"_5":13819,"_26493":117737,"_2816":117779},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3328":69439,"_29138":69417,"_20209":117781,"_5":13819,"_26493":117737,"_2816":117782},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3328":69440,"_29138":69417,"_20209":117784,"_5":13819,"_26493":117737,"_2816":117785},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3328":69441,"_29138":69417,"_20209":117787,"_5":13819,"_26493":117740,"_2816":117788},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3328":69442,"_29138":69417,"_20209":117790,"_5":13819,"_26493":117740,"_2816":117791},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3328":69443,"_29138":69417,"_20209":117793,"_5":13819,"_26493":117740,"_2816":117794},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3328":69444,"_29138":69417,"_20209":117796,"_5":13819,"_26493":117744,"_2816":117797},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3328":69445,"_29138":69417,"_20209":117799,"_5":13819,"_26493":117744,"_2816":117800},[],"Antes de confirmar:",{"_3328":69446,"_29138":69417,"_20209":117802,"_5":13819,"_26493":117744,"_2816":117803},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3328":69447,"_29138":69417,"_20209":117805,"_5":13819,"_26493":117744,"_2816":117806},[],"Distribuye la nueva cadena de confianza.",{"_3328":69448,"_29138":69417,"_20209":117808,"_5":13819,"_26493":117744,"_2816":117809},[],"Reemite las identidades necesarias.",{"_3328":69449,"_29138":69417,"_20209":117811,"_5":13819,"_26493":117744,"_2816":117812},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3328":69450,"_29138":69417,"_20209":117814,"_5":13819,"_26493":117744,"_2816":117815},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3328":69451,"_29138":69417,"_20209":117817,"_5":13819,"_26493":117744,"_2816":117818},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3328":69452,"_29138":69417,"_20209":117820,"_5":13819,"_26493":117748,"_2816":117821},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3328":69453,"_29138":69417,"_20209":117823,"_5":13819,"_26493":117748,"_2816":117824},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3328":69454,"_29138":69417,"_20209":117826,"_5":13819,"_26493":117748,"_2816":117827},[],"Cambios de estado y razones de revocación.",{"_3328":69455,"_29138":69417,"_20209":117829,"_5":13819,"_26493":117748,"_2816":117830},[],"Publicación y vigencia de OCSP y CRLs.",{"_3328":69456,"_29138":69417,"_20209":117832,"_5":13819,"_26493":117748,"_2816":117833},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3328":69457,"_29138":69417,"_20209":117835,"_5":13819,"_26493":117748,"_2816":117836},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3328":69458,"_29138":69458,"_5":14177,"_2816":117838,"_29482":117839,"_20209":117840,"_26493":69458},"Modelo de confianza",[47429,112963,52903,117706],[],{"_3328":69459,"_29138":69458,"_20209":117842,"_5":13819,"_26493":69458,"_2816":117843},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3328":69460,"_29138":69458,"_5":29479,"_20209":117845,"_26493":117846,"_2816":117847},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3328":69461,"_29138":69458,"_5":29479,"_20209":117849,"_26493":117850,"_2816":117851},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3328":69462,"_29138":69458,"_5":29479,"_20209":117853,"_26493":117854,"_2816":117855},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3328":69463,"_29138":69458,"_5":29479,"_20209":117857,"_26493":117858,"_2816":117859},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3328":69464,"_29138":69458,"_5":29479,"_20209":117861,"_26493":117862,"_2816":117863},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3328":69465,"_29138":69458,"_5":29479,"_20209":117865,"_26493":117866,"_2816":117867},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3328":69466,"_29138":69458,"_5":29479,"_20209":117869,"_26493":117870,"_2816":117871},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3328":69467,"_29138":69458,"_5":29479,"_20209":117873,"_26493":117874,"_2816":117875},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3328":69468,"_29138":69458,"_5":29479,"_20209":117877,"_26493":117878,"_2816":117879},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3328":69469,"_29138":69458,"_5":29479,"_20209":117881,"_26493":117882,"_2816":117883},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3328":69470,"_29138":69458,"_20209":117885,"_5":13819,"_26493":69458,"_2816":117886},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3328":69471,"_29138":69458,"_20209":117888,"_5":13819,"_26493":117850,"_2816":117889},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3328":69472,"_29138":69458,"_20209":117891,"_5":13819,"_26493":117854,"_2816":117892},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3328":69473,"_29138":69458,"_20209":117894,"_5":13819,"_26493":117858,"_2816":117895},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3328":69474,"_29138":69458,"_20209":117897,"_5":13819,"_26493":117862,"_2816":117898},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3328":69475,"_29138":69458,"_20209":117900,"_5":13819,"_26493":117866,"_2816":117901},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3328":69476,"_29138":69458,"_20209":117903,"_5":13819,"_26493":117866,"_2816":117904},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3328":69477,"_29138":69458,"_20209":117906,"_5":13819,"_26493":117866,"_2816":117907},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3328":69478,"_29138":69458,"_20209":117909,"_5":13819,"_26493":117866,"_2816":117910},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3328":69479,"_29138":69458,"_20209":117912,"_5":13819,"_26493":117866,"_2816":117913},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3328":69480,"_29138":69458,"_20209":117915,"_5":13819,"_26493":117866,"_2816":117916},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3328":69481,"_29138":69458,"_20209":117918,"_5":13819,"_26493":117870,"_2816":117919},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3328":69482,"_29138":69458,"_20209":117921,"_5":13819,"_26493":117870,"_2816":117922},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3328":69483,"_29138":69458,"_20209":117924,"_5":13819,"_26493":117870,"_2816":117925},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3328":69484,"_29138":69458,"_20209":117927,"_5":13819,"_26493":117870,"_2816":117928},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3328":69485,"_29138":69458,"_20209":117930,"_5":13819,"_26493":117870,"_2816":117931},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3328":69486,"_29138":69458,"_20209":117933,"_5":13819,"_26493":117874,"_2816":117934},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3328":69487,"_29138":69458,"_20209":117936,"_5":13819,"_26493":117874,"_2816":117937},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3328":69488,"_29138":69458,"_20209":117939,"_5":13819,"_26493":117874,"_2816":117940},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3328":69489,"_29138":69458,"_20209":117942,"_5":13819,"_26493":117874,"_2816":117943},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3328":69490,"_29138":69458,"_20209":117945,"_5":13819,"_26493":117874,"_2816":117946},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3328":69491,"_29138":69458,"_20209":117948,"_5":13819,"_26493":117874,"_2816":117949},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3328":69492,"_29138":69458,"_20209":117951,"_5":13819,"_26493":117874,"_2816":117952},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3328":69493,"_29138":69458,"_20209":117954,"_5":13819,"_26493":117878,"_2816":117955},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3328":69494,"_29138":69458,"_20209":117957,"_5":13819,"_26493":117882,"_2816":117958},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3328":69495,"_29138":69458,"_20209":117960,"_5":13819,"_26493":117882,"_2816":117961},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3328":69496,"_29138":69458,"_20209":117963,"_5":13819,"_26493":117882,"_2816":117964},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3328":69497,"_29138":69458,"_20209":117966,"_5":13819,"_26493":117882,"_2816":117967},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3328":69498,"_29138":69458,"_20209":117969,"_5":13819,"_26493":117882,"_2816":117970},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3328":69499,"_29138":69458,"_20209":117972,"_5":13819,"_26493":117882,"_2816":117973},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3328":69500,"_29138":69458,"_20209":117975,"_5":13819,"_26493":117882,"_2816":117976},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3328":69501,"_29138":69501,"_5":14177,"_2816":117978,"_29482":117979,"_20209":117980,"_26493":69501},"Listas de revocación (CRL)",[47429,112963,52903,117467],[],{"_3328":69502,"_29138":69501,"_20209":117982,"_5":13819,"_26493":69501,"_2816":117983},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3328":69503,"_29138":69501,"_5":29479,"_20209":117985,"_26493":117986,"_2816":117987},[],"/docs/pr-preview/pr-45/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3328":69504,"_29138":69501,"_5":29479,"_20209":117989,"_26493":117990,"_2816":117991},[],"/docs/pr-preview/pr-45/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3328":69505,"_29138":69501,"_5":29479,"_20209":117993,"_26493":117994,"_2816":117995},[],"/docs/pr-preview/pr-45/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3328":69506,"_29138":69501,"_5":29479,"_20209":117997,"_26493":117998,"_2816":117999},[],"/docs/pr-preview/pr-45/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3328":69507,"_29138":69501,"_5":29479,"_20209":118001,"_26493":118002,"_2816":118003},[],"/docs/pr-preview/pr-45/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3328":69508,"_29138":69501,"_5":29479,"_20209":118005,"_26493":118006,"_2816":118007},[],"/docs/pr-preview/pr-45/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3328":69509,"_29138":69501,"_5":29479,"_20209":118009,"_26493":118010,"_2816":118011},[],"/docs/pr-preview/pr-45/es/platform/pki/crl#errores-frecuentes-del-rol-va","Errores frecuentes del rol VA",{"_3328":69510,"_29138":69501,"_5":29479,"_20209":118013,"_26493":118014,"_2816":118015},[],"/docs/pr-preview/pr-45/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3328":69511,"_29138":69501,"_5":29479,"_20209":118017,"_26493":118018,"_2816":118019},[],"/docs/pr-preview/pr-45/es/platform/pki/crl#referencias","Referencias",{"_3328":69512,"_29138":69501,"_20209":118021,"_5":13819,"_26493":69501,"_2816":118022},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3328":69513,"_29138":69501,"_20209":118024,"_5":13819,"_26493":117986,"_2816":118025},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3328":69514,"_29138":69501,"_20209":118027,"_5":13819,"_26493":117986,"_2816":118028},[],"Campo de `crl_options`",{"_3328":69515,"_29138":69501,"_20209":118030,"_5":13819,"_26493":117986,"_2816":114498},[],{"_3328":69516,"_29138":69501,"_20209":118032,"_5":13819,"_26493":117986,"_2816":118033},[],"Valor inicial del backend",{"_3328":69517,"_29138":69501,"_20209":118035,"_5":13819,"_26493":117986,"_2816":54101},[],{"_3328":69518,"_29138":69501,"_20209":118037,"_5":13819,"_26493":117986,"_2816":118038},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3328":69519,"_29138":69501,"_20209":118040,"_5":13819,"_26493":117986,"_2816":118041},[],"7 días.",{"_3328":69520,"_29138":69501,"_20209":118043,"_5":13819,"_26493":117986,"_2816":54110},[],{"_3328":69521,"_29138":69501,"_20209":118045,"_5":13819,"_26493":117986,"_2816":118046},[],"Se guarda y se devuelve por la API, pero la VA no lo utiliza: la renovación programada no depende de él (consulta Regeneración periódica y automática).",{"_3328":69522,"_29138":69501,"_20209":118048,"_5":13819,"_26493":117986,"_2816":118049},[],"6 días y 23 horas.",{"_3328":69523,"_29138":69501,"_20209":118051,"_5":13819,"_26493":117986,"_2816":54119},[],{"_3328":69524,"_29138":69501,"_20209":118053,"_5":13819,"_26493":117986,"_2816":118054},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3328":69525,"_29138":69501,"_20209":118056,"_5":13819,"_26493":117986,"_2816":54125},[],{"_3328":69526,"_29138":69501,"_20209":118058,"_5":13819,"_26493":117986,"_2816":54128},[],{"_3328":69527,"_29138":69501,"_20209":118060,"_5":13819,"_26493":117986,"_2816":118061},[],"Número de serie del certificado existente que firma la CRL.",{"_3328":69528,"_29138":69501,"_20209":118063,"_5":13819,"_26493":117986,"_2816":118064},[],"Número de serie del certificado actual de la CA.",{"_3328":69529,"_29138":69501,"_20209":118066,"_5":13819,"_26493":117986,"_2816":118067},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3328":69530,"_29138":69501,"_20209":118069,"_5":13819,"_26493":117986,"_2816":118070},[],"Al reemitir una CA, el rol sigue apuntando al certificado anterior. Las CRL siguen siendo válidas porque ambos certificados comparten sujeto y clave, pero el certificado anterior no puede eliminarse mientras el rol lo use. Para retirarlo, actualiza el firmante del rol.",{"_3328":69531,"_29138":69501,"_20209":118072,"_5":13819,"_26493":117986,"_2816":118073},[],"Al eliminar una CA, su rol VA se conserva y no puede borrarse por API. Si no queda ninguna otra CA con el mismo SKI, el rol puede consultarse pero cualquier `PUT` devuelve 404, y el trabajo de renovación registra un aviso en cada ciclo porque ya no encuentra la CA. La API no ofrece salida; solo se corrige editando la base de datos. Si queda otra CA con ese SKI, el rol sigue siendo editable (consulta CAs que comparten clave). Ajusta validez y firmante antes de eliminar la CA.",{"_3328":69532,"_29138":69501,"_20209":118075,"_5":13819,"_26493":117986,"_2816":118076},[],"Una CA cuyo certificado no tiene `cRLSign` no puede generar su CRL ni editar su rol (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y asígnalo como firmante con `PUT`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original.",{"_3328":69533,"_29138":69501,"_20209":118078,"_5":13819,"_26493":117986,"_2816":118079},[],"El `PUT` valida siempre el firmante, aunque la petición no lo cambie. Si el firmante guardado ya no es válido, no se puede modificar ningún campo del rol, ni siquiera la validez, hasta asignar uno válido.",{"_3328":69534,"_29138":69501,"_20209":118081,"_5":13819,"_26493":117986,"_2816":118082},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_3328":69535,"_29138":69501,"_20209":118084,"_5":13819,"_26493":117990,"_2816":118085},[],"La VA identifica cada CRL por el SKI de la CA, y el SKI se deriva de su clave. Dos CAs con la misma clave tienen el mismo SKI y comparten un único rol VA y una única CRL. Ocurre al crear una CA sobre una clave ya existente del KMS, o al importar una CA cuyo certificado declara un SKI en uso. Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. El rol lo crea la primera CA y las demás lo conservan.",{"_3328":69536,"_29138":69501,"_20209":118087,"_5":13819,"_26493":117990,"_2816":118088},[],"Los certificados de todas ellas apuntan a `/crl/{ski}`, pero la lista publicada tiene como emisor a la primera CA y solo incluye sus revocaciones. Un verificador compara el emisor de la CRL con el del certificado que valida (RFC 5280, §6.3.2) y rechaza la lista si no coinciden. Según su política, el certificado queda bloqueado (*hard-fail*) o se acepta aunque esté revocado (*soft-fail*). Las revocaciones de las CAs secundarias no aparecen en ninguna lista.",{"_3328":69537,"_29138":69501,"_20209":118090,"_5":13819,"_26493":117990,"_2816":118091},[],"Si la primera CA se elimina, la generación de CRL de la restante falla porque el firmante configurado ya no corresponde a una CA con ese nombre. Hasta que se actualice el firmante del rol a un certificado de la CA restante, se sigue sirviendo la última lista publicada hasta que venza (7 días por defecto).",{"_3328":69538,"_29138":69501,"_20209":118093,"_5":13819,"_26493":117990,"_2816":118094},[],"Para detectar el problema, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos. Una CA importada con un SKI ya en uso no sustituye a la existente como emisora de la CRL, porque el emisor se resuelve a partir del firmante del rol. Sin embargo, sus propios certificados apuntan a esa misma URL y sus revocaciones no se publican. Hasta que Lamassu rechace estas importaciones, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión, así que tampoco reutilices claves entre CAs. Una CRL por CA y el rechazo de importaciones cuyo SKI colisiona con el de una CA existente están planteados en lamassuiot#834, y ninguno está implementado todavía.",{"_3328":69539,"_29138":69501,"_20209":118096,"_5":13819,"_26493":117994,"_2816":118097},[],"El trabajo programado de la VA revisa todos los roles en cada ejecución y solicita otra lista cuando a `latest_crl` le queda menos validez que el intervalo entre ejecuciones. La frecuencia se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. `refresh_interval` no interviene. Mantén `validity` claramente por encima del intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3328":69540,"_29138":69501,"_20209":118099,"_5":13819,"_26493":117994,"_2816":118100},[],"Si la generación falla (por ejemplo, por un rol sin CA o un firmante inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ski>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3328":69541,"_29138":69501,"_20209":118102,"_5":13819,"_26493":117994,"_2816":118103},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla (rol inexistente, firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3328":69542,"_29138":69501,"_20209":118105,"_5":13819,"_26493":117994,"_2816":118106},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3328":69543,"_29138":69501,"_20209":118108,"_5":13819,"_26493":117998,"_2816":118109},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3328":69544,"_29138":69501,"_20209":118111,"_5":13819,"_26493":117998,"_2816":118112},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3328":69545,"_29138":69501,"_20209":118114,"_5":13819,"_26493":118002,"_2816":118115},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_3328":69546,"_29138":69501,"_20209":118117,"_5":13819,"_26493":118002,"_2816":118118},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3328":69547,"_29138":69501,"_20209":118120,"_5":13819,"_26493":118002,"_2816":118121},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3328":69548,"_29138":69501,"_20209":118123,"_5":13819,"_26493":118002,"_2816":118124},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3328":69549,"_29138":69501,"_20209":118126,"_5":13819,"_26493":118002,"_2816":118127},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3328":69550,"_29138":69501,"_20209":118129,"_5":13819,"_26493":118006,"_2816":118130},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3328":69551,"_29138":69501,"_20209":118132,"_5":13819,"_26493":118006,"_2816":114687},[],{"_3328":69552,"_29138":69501,"_20209":118134,"_5":13819,"_26493":118006,"_2816":118135},[],"Path relativo",{"_3328":69553,"_29138":69501,"_20209":118137,"_5":13819,"_26493":118006,"_2816":112723},[],{"_3328":69554,"_29138":69501,"_20209":118139,"_5":13819,"_26493":118006,"_2816":54210},[],{"_3328":69555,"_29138":69501,"_20209":118141,"_5":13819,"_26493":118006,"_2816":54213},[],{"_3328":69556,"_29138":69501,"_20209":118143,"_5":13819,"_26493":118006,"_2816":118144},[],"Consultar `crl_options` y `latest_crl`.",{"_3328":69557,"_29138":69501,"_20209":118146,"_5":13819,"_26493":118006,"_2816":54219},[],{"_3328":69558,"_29138":69501,"_20209":118148,"_5":13819,"_26493":118006,"_2816":54213},[],{"_3328":69559,"_29138":69501,"_20209":118150,"_5":13819,"_26493":118006,"_2816":118151},[],"Sustituir la configuración de CRL.",{"_3328":69560,"_29138":69501,"_20209":118153,"_5":13819,"_26493":118006,"_2816":118154},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_3328":69561,"_29138":69501,"_20209":118156,"_5":13819,"_26493":118006,"_2816":118157},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3328":69562,"_29138":69501,"_20209":118159,"_5":13819,"_26493":118010,"_2816":118160},[],"Síntoma",{"_3328":69563,"_29138":69501,"_20209":118162,"_5":13819,"_26493":118010,"_2816":118163},[],"Causa",{"_3328":69564,"_29138":69501,"_20209":118165,"_5":13819,"_26493":118010,"_2816":118166},[],"Acción",{"_3328":69565,"_29138":69501,"_20209":118168,"_5":13819,"_26493":118010,"_2816":118169},[],"`PUT /v1/roles/{ca-ski}` devuelve 404 y `GET` devuelve 200.",{"_3328":69566,"_29138":69501,"_20209":118171,"_5":13819,"_26493":118010,"_2816":118172},[],"Se eliminó la CA del rol y no queda otra con el mismo SKI.",{"_3328":69567,"_29138":69501,"_20209":118174,"_5":13819,"_26493":118010,"_2816":118175},[],"No hay salida por API; requiere intervención en la base de datos. Evítalo ajustando el rol antes de eliminar la CA.",{"_3328":69568,"_29138":69501,"_20209":118177,"_5":13819,"_26493":118010,"_2816":118178},[],"`PUT` devuelve 400.",{"_3328":69569,"_29138":69501,"_20209":118180,"_5":13819,"_26493":118010,"_2816":118181},[],"El firmante no tiene `cRLSign`, o su sujeto y su clave no coinciden con ninguna CA de ese SKI (por ejemplo, tras eliminar la primera de dos CAs que comparten clave).",{"_3328":69570,"_29138":69501,"_20209":118183,"_5":13819,"_26493":118010,"_2816":118184},[],"Asigna con `PUT` el número de serie de un certificado válido de la CA restante.",{"_3328":69571,"_29138":69501,"_20209":118186,"_5":13819,"_26493":118010,"_2816":118187},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3328":69572,"_29138":69501,"_20209":118189,"_5":13819,"_26493":118010,"_2816":118190},[],"`crl_options.subject_key_id_signer` se sustituyó por `signer_certificate_serial_number`, que es obligatorio.",{"_3328":69573,"_29138":69501,"_20209":118192,"_5":13819,"_26493":118010,"_2816":118193},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3328":69574,"_29138":69501,"_20209":118195,"_5":13819,"_26493":118010,"_2816":118196},[],"La CRL no cambia tras revocar un certificado.",{"_3328":69575,"_29138":69501,"_20209":118198,"_5":13819,"_26493":118010,"_2816":118199},[],"`regenerate_on_revoke` es `false`, o el evento falló por falta de rol o por un firmante inválido.",{"_3328":69576,"_29138":69501,"_20209":118201,"_5":13819,"_26493":118010,"_2816":118202},[],"Revisa los logs de la VA y la cola de eventos fallidos; corrige el firmante.",{"_3328":69577,"_29138":69501,"_20209":118204,"_5":13819,"_26493":118010,"_2816":118205},[],"Un verificador rechaza la CRL por el emisor.",{"_3328":69578,"_29138":69501,"_20209":118207,"_5":13819,"_26493":118010,"_2816":118208},[],"Varias CAs comparten SKI.",{"_3328":69579,"_29138":69501,"_20209":118210,"_5":13819,"_26493":118010,"_2816":118211},[],"Consulta CAs que comparten clave.",{"_3328":69580,"_29138":69501,"_20209":118213,"_5":13819,"_26493":118014,"_2816":118214},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3328":69581,"_29138":69501,"_20209":118216,"_5":13819,"_26493":118018,"_2816":118217},[],"RFC 5280: perfil X.509 y CRL.",{"_3328":69582,"_29138":69501,"_20209":118219,"_5":13819,"_26493":118018,"_2816":54293},[],{"_3328":69583,"_29138":69501,"_20209":118221,"_5":13819,"_26493":118018,"_2816":54296},[],{"_3328":69584,"_29138":69501,"_20209":118223,"_5":13819,"_26493":118018,"_2816":118224},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3328":69585,"_29138":69501,"_20209":118226,"_5":13819,"_26493":118018,"_2816":118227},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3328":69586,"_29138":69586,"_5":14177,"_2816":118229,"_29482":118230,"_20209":118231,"_26493":69586},"Claves y motores criptográficos",[47429,112963,52903,116842],[],{"_3328":69587,"_29138":69586,"_20209":118233,"_5":13819,"_26493":69586,"_2816":118234},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3328":69588,"_29138":69586,"_5":29479,"_20209":118236,"_26493":118237,"_2816":118238},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3328":69589,"_29138":69586,"_5":29479,"_20209":118240,"_26493":118241,"_2816":118242},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3328":69590,"_29138":69586,"_5":29479,"_20209":118244,"_26493":118245,"_2816":54321},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#file-system",{"_3328":69591,"_29138":69586,"_5":29479,"_20209":118247,"_26493":118248,"_2816":54325},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#hashicorp-vault",{"_3328":69592,"_29138":69586,"_5":29479,"_20209":118250,"_26493":118251,"_2816":54329},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#aws-secrets-manager",{"_3328":69593,"_29138":69586,"_5":29479,"_20209":118253,"_26493":118254,"_2816":54333},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#aws-kms",{"_3328":69594,"_29138":69586,"_5":29479,"_20209":118256,"_26493":118257,"_2816":54337},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#pkcs11",{"_3328":69595,"_29138":69586,"_5":29479,"_20209":118259,"_26493":118260,"_2816":54341},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#azure-key-vault",{"_3328":69596,"_29138":69586,"_5":29479,"_20209":118262,"_26493":118263,"_2816":118264},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3328":69597,"_29138":69586,"_5":29479,"_20209":118266,"_26493":118267,"_2816":118268},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3328":69598,"_29138":69586,"_5":29479,"_20209":118270,"_26493":118271,"_2816":118272},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3328":69599,"_29138":69586,"_5":29479,"_20209":118274,"_26493":118275,"_2816":118276},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3328":69600,"_29138":69586,"_5":29479,"_20209":118278,"_26493":118279,"_2816":118280},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3328":69601,"_29138":69586,"_5":29479,"_20209":118282,"_26493":118283,"_2816":118284},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3328":69602,"_29138":69586,"_5":29479,"_20209":118286,"_26493":118287,"_2816":118288},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3328":69603,"_29138":69586,"_5":29479,"_20209":118290,"_26493":118291,"_2816":54373},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#sign",{"_3328":69604,"_29138":69586,"_5":29479,"_20209":118293,"_26493":118294,"_2816":54377},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#verify",{"_3328":69605,"_29138":69586,"_5":29479,"_20209":118296,"_26493":118297,"_2816":118298},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3328":69606,"_29138":69586,"_5":29479,"_20209":118300,"_26493":118301,"_2816":118302},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3328":69607,"_29138":69586,"_5":29479,"_20209":118304,"_26493":118305,"_2816":118306},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3328":69608,"_29138":69586,"_20209":118308,"_5":13819,"_26493":69586,"_2816":118309},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3328":69609,"_29138":69586,"_20209":118311,"_5":13819,"_26493":69586,"_2816":118312},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3328":69610,"_29138":69586,"_20209":118314,"_5":13819,"_26493":118237,"_2816":118315},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3328":69611,"_29138":69586,"_20209":118317,"_5":13819,"_26493":118237,"_2816":118318},[],"En la práctica, permite:",{"_3328":69612,"_29138":69586,"_20209":118320,"_5":13819,"_26493":118237,"_2816":118321},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3328":69613,"_29138":69586,"_20209":118323,"_5":13819,"_26493":118237,"_2816":118324},[],"Importar claves creadas externamente.",{"_3328":69614,"_29138":69586,"_20209":118326,"_5":13819,"_26493":118237,"_2816":118327},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3328":69615,"_29138":69586,"_20209":118329,"_5":13819,"_26493":118237,"_2816":118330},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3328":69616,"_29138":69586,"_20209":118332,"_5":13819,"_26493":118241,"_2816":118333},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3328":69617,"_29138":69586,"_20209":118335,"_5":13819,"_26493":118241,"_2816":118336},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3328":69618,"_29138":69586,"_20209":118338,"_5":13819,"_26493":118241,"_2816":118339},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3328":69619,"_29138":69586,"_20209":118341,"_5":13819,"_26493":118245,"_2816":118342},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3328":69620,"_29138":69586,"_20209":118344,"_5":13819,"_26493":118248,"_2816":118345},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3328":69621,"_29138":69586,"_20209":118347,"_5":13819,"_26493":118248,"_2816":118348},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3328":69622,"_29138":69586,"_20209":118350,"_5":13819,"_26493":118251,"_2816":118351},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3328":69623,"_29138":69586,"_20209":118353,"_5":13819,"_26493":118254,"_2816":118354},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3328":69624,"_29138":69586,"_20209":118356,"_5":13819,"_26493":118257,"_2816":118357},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3328":69625,"_29138":69586,"_20209":118359,"_5":13819,"_26493":118260,"_2816":118360},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3328":69626,"_29138":69586,"_20209":118362,"_5":13819,"_26493":118260,"_2816":118363},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3328":69627,"_29138":69586,"_20209":118365,"_5":13819,"_26493":118260,"_2816":118366},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3328":69628,"_29138":69586,"_20209":118368,"_5":13819,"_26493":118260,"_2816":118369},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3328":69629,"_29138":69586,"_20209":118371,"_5":13819,"_26493":118263,"_2816":118372},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3328":69630,"_29138":69586,"_20209":118374,"_5":13819,"_26493":118263,"_2816":118375},[],"La tabla incluye los siguientes campos:",{"_3328":69631,"_29138":69586,"_20209":118377,"_5":13819,"_26493":118263,"_2816":118378},[],"**Name**: nombre descriptivo de la clave.",{"_3328":69632,"_29138":69586,"_20209":118380,"_5":13819,"_26493":118263,"_2816":118381},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3328":69633,"_29138":69586,"_20209":118383,"_5":13819,"_26493":118263,"_2816":118384},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3328":69634,"_29138":69586,"_20209":118386,"_5":13819,"_26493":118263,"_2816":118387},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3328":69635,"_29138":69586,"_20209":118389,"_5":13819,"_26493":118263,"_2816":118390},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3328":69636,"_29138":69586,"_20209":118392,"_5":13819,"_26493":118263,"_2816":118393},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3328":69637,"_29138":69586,"_20209":118395,"_5":13819,"_26493":118263,"_2816":118396},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3328":69638,"_29138":69586,"_20209":118398,"_5":13819,"_26493":118263,"_2816":118399},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3328":69639,"_29138":69586,"_20209":118401,"_5":13819,"_26493":118263,"_2816":118402},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3328":69640,"_29138":69586,"_20209":118404,"_5":13819,"_26493":118263,"_2816":118405},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3328":69641,"_29138":69586,"_20209":118407,"_5":13819,"_26493":118263,"_2816":118408},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3328":69642,"_29138":69586,"_20209":118410,"_5":13819,"_26493":118263,"_2816":118411},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3328":69643,"_29138":69586,"_20209":118413,"_5":13819,"_26493":118263,"_2816":118414},[],"**Delete Key** para eliminar la clave del sistema.",{"_3328":69644,"_29138":69586,"_20209":118416,"_5":13819,"_26493":118267,"_2816":118417},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3328":69645,"_29138":69586,"_20209":118419,"_5":13819,"_26493":118271,"_2816":118420},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3328":69646,"_29138":69586,"_20209":118422,"_5":13819,"_26493":118271,"_2816":118423},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3328":69647,"_29138":69586,"_20209":118425,"_5":13819,"_26493":118271,"_2816":118426},[],"**Key Name**: nombre único y descriptivo.",{"_3328":69648,"_29138":69586,"_20209":118428,"_5":13819,"_26493":118271,"_2816":118429},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3328":69649,"_29138":69586,"_20209":118431,"_5":13819,"_26493":118271,"_2816":118432},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3328":69650,"_29138":69586,"_20209":118434,"_5":13819,"_26493":118271,"_2816":118435},[],"**Tags**: metadatos para clasificar la clave.",{"_3328":69651,"_29138":69586,"_20209":118437,"_5":13819,"_26493":118271,"_2816":118438},[],"**Metadata**: información adicional para usos avanzados.",{"_3328":69652,"_29138":69586,"_20209":118440,"_5":13819,"_26493":118275,"_2816":118441},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3328":69653,"_29138":69586,"_20209":118443,"_5":13819,"_26493":118275,"_2816":118444},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3328":69654,"_29138":69586,"_20209":118446,"_5":13819,"_26493":118275,"_2816":118447},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3328":69655,"_29138":69586,"_20209":118449,"_5":13819,"_26493":118275,"_2816":118450},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3328":69656,"_29138":69586,"_20209":118452,"_5":13819,"_26493":118275,"_2816":118453},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3328":69657,"_29138":69586,"_20209":118455,"_5":13819,"_26493":118275,"_2816":118456},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3328":69658,"_29138":69586,"_20209":118458,"_5":13819,"_26493":118275,"_2816":118459},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3328":69659,"_29138":69586,"_20209":118461,"_5":13819,"_26493":118275,"_2816":118462},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3328":69660,"_29138":69586,"_20209":118464,"_5":13819,"_26493":118275,"_2816":118465},[],"**Metadata**: información adicional opcional.",{"_3328":69661,"_29138":69586,"_20209":118467,"_5":13819,"_26493":118275,"_2816":118468},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3328":69662,"_29138":69586,"_20209":118470,"_5":13819,"_26493":118275,"_2816":118471},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3328":69663,"_29138":69586,"_20209":118473,"_5":13819,"_26493":118279,"_2816":118474},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3328":69664,"_29138":69586,"_20209":118476,"_5":13819,"_26493":118283,"_2816":118477},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3328":69665,"_29138":69586,"_20209":118479,"_5":13819,"_26493":118283,"_2816":118480},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3328":69666,"_29138":69586,"_20209":118482,"_5":13819,"_26493":118283,"_2816":118483},[],"**Key Name**: nombre descriptivo.",{"_3328":69667,"_29138":69586,"_20209":118485,"_5":13819,"_26493":118283,"_2816":118486},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3328":69668,"_29138":69586,"_20209":118488,"_5":13819,"_26493":118283,"_2816":118489},[],"**Tags**: etiquetas asociadas.",{"_3328":69669,"_29138":69586,"_20209":118491,"_5":13819,"_26493":118283,"_2816":118492},[],"**Aliases**: nombres alternativos.",{"_3328":69670,"_29138":69586,"_20209":118494,"_5":13819,"_26493":118283,"_2816":118495},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3328":69671,"_29138":69586,"_20209":118497,"_5":13819,"_26493":118283,"_2816":118498},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3328":69672,"_29138":69586,"_20209":118500,"_5":13819,"_26493":118283,"_2816":118501},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3328":69673,"_29138":69586,"_20209":118503,"_5":13819,"_26493":118283,"_2816":118504},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3328":69674,"_29138":69586,"_20209":118506,"_5":13819,"_26493":118287,"_2816":118507},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3328":69675,"_29138":69586,"_20209":118509,"_5":13819,"_26493":118287,"_2816":118510},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3328":69676,"_29138":69586,"_20209":118512,"_5":13819,"_26493":118287,"_2816":118513},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3328":69677,"_29138":69586,"_20209":118515,"_5":13819,"_26493":118291,"_2816":118516},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3328":69678,"_29138":69586,"_20209":118518,"_5":13819,"_26493":118291,"_2816":118519},[],"Campos principales:",{"_3328":69679,"_29138":69586,"_20209":118521,"_5":13819,"_26493":118291,"_2816":118522},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3328":69680,"_29138":69586,"_20209":118524,"_5":13819,"_26493":118291,"_2816":118525},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3328":69681,"_29138":69586,"_20209":118527,"_5":13819,"_26493":118291,"_2816":118528},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3328":69682,"_29138":69586,"_20209":118530,"_5":13819,"_26493":118291,"_2816":118531},[],"**Message**: contenido que se va a firmar.",{"_3328":69683,"_29138":69586,"_20209":118533,"_5":13819,"_26493":118291,"_2816":118534},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3328":69684,"_29138":69586,"_20209":118536,"_5":13819,"_26493":118294,"_2816":118537},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3328":69685,"_29138":69586,"_20209":118539,"_5":13819,"_26493":118294,"_2816":118519},[],{"_3328":69686,"_29138":69586,"_20209":118541,"_5":13819,"_26493":118294,"_2816":118542},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3328":69687,"_29138":69586,"_20209":118544,"_5":13819,"_26493":118294,"_2816":118545},[],"**Message Type**: `Raw` o `Digest`.",{"_3328":69688,"_29138":69586,"_20209":118547,"_5":13819,"_26493":118294,"_2816":118548},[],"**Payload Encoding**: codificación del mensaje.",{"_3328":69689,"_29138":69586,"_20209":118550,"_5":13819,"_26493":118294,"_2816":118551},[],"**Message**: mensaje original o hash.",{"_3328":69690,"_29138":69586,"_20209":118553,"_5":13819,"_26493":118294,"_2816":118554},[],"**Signature**: firma que se desea comprobar.",{"_3328":69691,"_29138":69586,"_20209":118556,"_5":13819,"_26493":118294,"_2816":118557},[],"**Result**: indicador del resultado de la validación.",{"_3328":69692,"_29138":69586,"_20209":118559,"_5":13819,"_26493":118297,"_2816":118560},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3328":69693,"_29138":69586,"_20209":118562,"_5":13819,"_26493":118297,"_2816":118563},[],"Este flujo es útil para:",{"_3328":69694,"_29138":69586,"_20209":118565,"_5":13819,"_26493":118297,"_2816":118566},[],"Solicitar certificados a una CA externa.",{"_3328":69695,"_29138":69586,"_20209":118568,"_5":13819,"_26493":118297,"_2816":118569},[],"Renovar una identidad manteniendo la misma clave.",{"_3328":69696,"_29138":69586,"_20209":118571,"_5":13819,"_26493":118297,"_2816":118572},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3328":69697,"_29138":69586,"_20209":118574,"_5":13819,"_26493":118297,"_2816":118575},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3328":69698,"_29138":69586,"_20209":118577,"_5":13819,"_26493":118297,"_2816":118578},[],"**Organization (O)**: organización o empresa.",{"_3328":69699,"_29138":69586,"_20209":118580,"_5":13819,"_26493":118297,"_2816":118581},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3328":69700,"_29138":69586,"_20209":118583,"_5":13819,"_26493":118297,"_2816":118584},[],"**Country (C)**: código de país de dos letras.",{"_3328":69701,"_29138":69586,"_20209":118586,"_5":13819,"_26493":118297,"_2816":118587},[],"**State / Province (ST)**: estado o provincia.",{"_3328":69702,"_29138":69586,"_20209":118589,"_5":13819,"_26493":118297,"_2816":118590},[],"**Locality (L)**: ciudad o localidad.",{"_3328":69703,"_29138":69586,"_20209":118592,"_5":13819,"_26493":118297,"_2816":118593},[],"**Email Address**: correo de contacto.",{"_3328":69704,"_29138":69586,"_20209":118595,"_5":13819,"_26493":118297,"_2816":118596},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3328":69705,"_29138":69586,"_20209":118598,"_5":13819,"_26493":118297,"_2816":118599},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3328":69706,"_29138":69586,"_20209":118601,"_5":13819,"_26493":118301,"_2816":118602},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3328":69707,"_29138":69586,"_20209":118604,"_5":13819,"_26493":118301,"_2816":54688},[],{"_3328":69708,"_29138":69586,"_20209":118606,"_5":13819,"_26493":118305,"_2816":118607},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3328":69709,"_29138":69709,"_5":14177,"_2816":118609,"_29482":118610,"_20209":118611,"_26493":69709},"Validación online con OCSP",[47429,112963,52903,117467],[],{"_3328":69710,"_29138":69709,"_20209":118613,"_5":13819,"_26493":69709,"_2816":118614},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3328":69711,"_29138":69709,"_5":29479,"_20209":118616,"_26493":118617,"_2816":118618},[],"/docs/pr-preview/pr-45/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3328":69712,"_29138":69709,"_5":29479,"_20209":118620,"_26493":118621,"_2816":118622},[],"/docs/pr-preview/pr-45/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3328":69713,"_29138":69709,"_5":29479,"_20209":118624,"_26493":118625,"_2816":118626},[],"/docs/pr-preview/pr-45/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3328":69714,"_29138":69709,"_5":29479,"_20209":118628,"_26493":118629,"_2816":118630},[],"/docs/pr-preview/pr-45/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3328":69715,"_29138":69709,"_5":29479,"_20209":118632,"_26493":118633,"_2816":118634},[],"/docs/pr-preview/pr-45/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3328":69716,"_29138":69709,"_5":29479,"_20209":118636,"_26493":118637,"_2816":118019},[],"/docs/pr-preview/pr-45/es/platform/pki/ocsp#referencias",{"_3328":69717,"_29138":69709,"_20209":118639,"_5":13819,"_26493":69709,"_2816":118640},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3328":69718,"_29138":69709,"_20209":118642,"_5":13819,"_26493":118617,"_2816":118643},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3328":69719,"_29138":69709,"_20209":118645,"_5":13819,"_26493":118617,"_2816":118646},[],"Estado del registro",{"_3328":69720,"_29138":69709,"_20209":118648,"_5":13819,"_26493":118617,"_2816":118649},[],"Respuesta firmada",{"_3328":69721,"_29138":69709,"_20209":118651,"_5":13819,"_26493":118617,"_2816":52074},[],{"_3328":69722,"_29138":69709,"_20209":118653,"_5":13819,"_26493":118617,"_2816":54738},[],{"_3328":69723,"_29138":69709,"_20209":118655,"_5":13819,"_26493":118617,"_2816":52091},[],{"_3328":69724,"_29138":69709,"_20209":118657,"_5":13819,"_26493":118617,"_2816":118658},[],"`Revoked`, con razón y fecha de revocación.",{"_3328":69725,"_29138":69709,"_20209":118660,"_5":13819,"_26493":118617,"_2816":118661},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3328":69726,"_29138":69709,"_20209":118663,"_5":13819,"_26493":118617,"_2816":118664},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3328":69727,"_29138":69709,"_20209":118666,"_5":13819,"_26493":118617,"_2816":118667},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3328":69728,"_29138":69709,"_20209":118669,"_5":13819,"_26493":118617,"_2816":118670},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3328":69729,"_29138":69709,"_20209":118672,"_5":13819,"_26493":118617,"_2816":118673},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3328":69730,"_29138":69709,"_20209":118675,"_5":13819,"_26493":118621,"_2816":118676},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3328":69731,"_29138":69709,"_20209":118678,"_5":13819,"_26493":118621,"_2816":118679},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3328":69732,"_29138":69709,"_20209":118681,"_5":13819,"_26493":118625,"_2816":118682},[],"El servicio acepta:",{"_3328":69733,"_29138":69709,"_20209":118684,"_5":13819,"_26493":118625,"_2816":114687},[],{"_3328":69734,"_29138":69709,"_20209":118686,"_5":13819,"_26493":118625,"_2816":118687},[],"Ruta del servicio VA",{"_3328":69735,"_29138":69709,"_20209":118689,"_5":13819,"_26493":118625,"_2816":118690},[],"Formato",{"_3328":69736,"_29138":69709,"_20209":118692,"_5":13819,"_26493":118625,"_2816":54778},[],{"_3328":69737,"_29138":69709,"_20209":118694,"_5":13819,"_26493":118625,"_2816":54781},[],{"_3328":69738,"_29138":69709,"_20209":118696,"_5":13819,"_26493":118625,"_2816":118697},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3328":69739,"_29138":69709,"_20209":118699,"_5":13819,"_26493":118625,"_2816":54210},[],{"_3328":69740,"_29138":69709,"_20209":118701,"_5":13819,"_26493":118625,"_2816":54789},[],{"_3328":69741,"_29138":69709,"_20209":118703,"_5":13819,"_26493":118625,"_2816":118704},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3328":69742,"_29138":69709,"_20209":118706,"_5":13819,"_26493":118625,"_2816":118707},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3328":69743,"_29138":69709,"_20209":118709,"_5":13819,"_26493":118629,"_2816":118710},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3328":69744,"_29138":69709,"_20209":118712,"_5":13819,"_26493":118629,"_2816":118713},[],"Genera la solicitud:",{"_3328":69745,"_29138":69709,"_20209":118715,"_5":13819,"_26493":118629,"_2816":118716},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3328":69746,"_29138":69709,"_20209":118718,"_5":13819,"_26493":118629,"_2816":118719},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3328":69747,"_29138":69709,"_20209":118721,"_5":13819,"_26493":118629,"_2816":118722},[],"Verifica el DER recibido:",{"_3328":69748,"_29138":69709,"_20209":118724,"_5":13819,"_26493":118629,"_2816":118725},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3328":69749,"_29138":69709,"_20209":118727,"_5":13819,"_26493":118633,"_2816":118728},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3328":69750,"_29138":69709,"_20209":118730,"_5":13819,"_26493":118633,"_2816":118731},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3328":69751,"_29138":69709,"_20209":118733,"_5":13819,"_26493":118637,"_2816":54822},[],{"_3328":69752,"_29138":69709,"_20209":118735,"_5":13819,"_26493":118637,"_2816":54825},[],{"_3328":69753,"_29138":69709,"_20209":118737,"_5":13819,"_26493":118637,"_2816":118738},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3328":69754,"_29138":69709,"_20209":118740,"_5":13819,"_26493":118637,"_2816":118227},[],{"_3328":69755,"_29138":69755,"_5":14177,"_2816":52903,"_29482":118742,"_20209":118743,"_26493":69755},[47429,112963,52903],[],{"_3328":69756,"_29138":69755,"_20209":118745,"_5":13819,"_26493":69755,"_2816":118746},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3328":69757,"_29138":69755,"_5":29479,"_20209":118748,"_26493":118749,"_2816":116168},[],"/docs/pr-preview/pr-45/es/platform/pki/overview#empieza-aquí",{"_3328":69758,"_29138":69755,"_5":29479,"_20209":118751,"_26493":118752,"_2816":118753},[],"/docs/pr-preview/pr-45/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3328":69759,"_29138":69755,"_5":29479,"_20209":118755,"_26493":118756,"_2816":116688},[],"/docs/pr-preview/pr-45/es/platform/pki/overview#capacidades-principales",{"_3328":69760,"_29138":69755,"_5":29479,"_20209":118758,"_26493":118759,"_2816":116692},[],"/docs/pr-preview/pr-45/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3328":69761,"_29138":69755,"_5":29479,"_20209":118761,"_26493":118762,"_2816":116696},[],"/docs/pr-preview/pr-45/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3328":69762,"_29138":69755,"_5":29479,"_20209":118764,"_26493":118765,"_2816":116700},[],"/docs/pr-preview/pr-45/es/platform/pki/overview#emite-y-controla-certificados",{"_3328":69763,"_29138":69755,"_5":29479,"_20209":118767,"_26493":118768,"_2816":116708},[],"/docs/pr-preview/pr-45/es/platform/pki/overview#publica-el-estado-de-validación",{"_3328":69764,"_29138":69755,"_5":29479,"_20209":118770,"_26493":118771,"_2816":118772},[],"/docs/pr-preview/pr-45/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3328":69765,"_29138":69755,"_5":29479,"_20209":118774,"_26493":118775,"_2816":117633},[],"/docs/pr-preview/pr-45/es/platform/pki/overview#continúa",{"_3328":69766,"_29138":69755,"_20209":118777,"_5":13819,"_26493":69755,"_2816":118778},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3328":69767,"_29138":69755,"_20209":118780,"_5":13819,"_26493":118749,"_2816":118781},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3328":69768,"_29138":69755,"_20209":118783,"_5":13819,"_26493":118749,"_2816":118784},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3328":69769,"_29138":69755,"_20209":118786,"_5":13819,"_26493":118752,"_2816":118787},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3328":69770,"_29138":69755,"_20209":118789,"_5":13819,"_26493":118752,"_2816":118790},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3328":69771,"_29138":69755,"_20209":118792,"_5":13819,"_26493":118752,"_2816":118793},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3328":69772,"_29138":69755,"_20209":118795,"_5":13819,"_26493":118752,"_2816":118796},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3328":69773,"_29138":69755,"_20209":118798,"_5":13819,"_26493":118752,"_2816":118799},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3328":69774,"_29138":69755,"_20209":118801,"_5":13819,"_26493":118759,"_2816":118802},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3328":69775,"_29138":69755,"_20209":118804,"_5":13819,"_26493":118762,"_2816":118805},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3328":69776,"_29138":69755,"_20209":118807,"_5":13819,"_26493":118765,"_2816":118808},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3328":69777,"_29138":69755,"_20209":118810,"_5":13819,"_26493":118768,"_2816":118811},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3328":69778,"_29138":69755,"_20209":118813,"_5":13819,"_26493":118771,"_2816":118814},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3328":69779,"_29138":69755,"_20209":118816,"_5":13819,"_26493":118771,"_2816":118817},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3328":69780,"_29138":69755,"_20209":118819,"_5":13819,"_26493":118771,"_2816":118820},[],"su clave pública corresponda a la clave privada del cliente;",{"_3328":69781,"_29138":69755,"_20209":118822,"_5":13819,"_26493":118771,"_2816":118823},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3328":69782,"_29138":69755,"_20209":118825,"_5":13819,"_26493":118771,"_2816":118826},[],"sus fechas y usos permitan la operación;",{"_3328":69783,"_29138":69755,"_20209":118828,"_5":13819,"_26493":118771,"_2816":118829},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3328":69784,"_29138":69755,"_20209":118831,"_5":13819,"_26493":118771,"_2816":118832},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3328":69785,"_29138":69755,"_20209":118834,"_5":13819,"_26493":118775,"_2816":118835},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3328":69786,"_29138":69755,"_20209":118837,"_5":13819,"_26493":118775,"_2816":118838},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3328":69787,"_29138":69755,"_20209":118840,"_5":13819,"_26493":118775,"_2816":118841},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3328":69788,"_29138":69788,"_5":14177,"_2816":118843,"_29482":118844,"_20209":118845,"_26493":69788},"Crea tu primera CA",[47429,112963,52903,116292],[],{"_3328":69789,"_29138":69788,"_20209":118847,"_5":13819,"_26493":69788,"_2816":118848},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3328":69790,"_29138":69788,"_5":29479,"_20209":118850,"_26493":118851,"_2816":111541},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3328":69791,"_29138":69788,"_5":29479,"_20209":118853,"_26493":118854,"_2816":118855},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3328":69792,"_29138":69788,"_5":29479,"_20209":118857,"_26493":118858,"_2816":118859},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3328":69793,"_29138":69788,"_5":29479,"_20209":118861,"_26493":118862,"_2816":118863},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3328":69794,"_29138":69788,"_5":29479,"_20209":118865,"_26493":118866,"_2816":118867},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3328":69795,"_29138":69788,"_5":29479,"_20209":118869,"_26493":118870,"_2816":118871},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3328":69796,"_29138":69788,"_5":29479,"_20209":118873,"_26493":118874,"_2816":118875},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3328":69797,"_29138":69788,"_5":29479,"_20209":118877,"_26493":118878,"_2816":116539},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3328":69798,"_29138":69788,"_5":29479,"_20209":118880,"_26493":118881,"_2816":111565},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3328":69799,"_29138":69788,"_20209":118883,"_5":13819,"_26493":69788,"_2816":118884},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3328":69800,"_29138":69788,"_20209":118886,"_5":13819,"_26493":118851,"_2816":118887},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3328":69801,"_29138":69788,"_20209":118889,"_5":13819,"_26493":118851,"_2816":118890},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3328":69802,"_29138":69788,"_20209":118892,"_5":13819,"_26493":118851,"_2816":118893},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3328":69803,"_29138":69788,"_20209":118895,"_5":13819,"_26493":118851,"_2816":118896},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3328":69804,"_29138":69788,"_20209":118898,"_5":13819,"_26493":118854,"_2816":118899},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3328":69805,"_29138":69788,"_20209":118901,"_5":13819,"_26493":118854,"_2816":118902},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3328":69806,"_29138":69788,"_20209":118904,"_5":13819,"_26493":118858,"_2816":118905},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3328":69807,"_29138":69788,"_20209":118907,"_5":13819,"_26493":118858,"_2816":118908},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3328":69808,"_29138":69788,"_20209":118910,"_5":13819,"_26493":118862,"_2816":118911},[],"Selecciona **Root CA** y completa:",{"_3328":69809,"_29138":69788,"_20209":118913,"_5":13819,"_26493":118862,"_2816":55004},[],{"_3328":69810,"_29138":69788,"_20209":118915,"_5":13819,"_26493":118862,"_2816":118916},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3328":69811,"_29138":69788,"_20209":118918,"_5":13819,"_26493":118862,"_2816":118919},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3328":69812,"_29138":69788,"_20209":118921,"_5":13819,"_26493":118862,"_2816":118922},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3328":69813,"_29138":69788,"_20209":118924,"_5":13819,"_26493":118862,"_2816":118925},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3328":69814,"_29138":69788,"_20209":118927,"_5":13819,"_26493":118866,"_2816":118928},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3328":69815,"_29138":69788,"_20209":118930,"_5":13819,"_26493":118870,"_2816":118931},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3328":69816,"_29138":69788,"_20209":118933,"_5":13819,"_26493":118870,"_2816":118934},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3328":69817,"_29138":69788,"_20209":118936,"_5":13819,"_26493":118874,"_2816":118937},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3328":69818,"_29138":69788,"_20209":118939,"_5":13819,"_26493":118874,"_2816":118940},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3328":69819,"_29138":69788,"_20209":118942,"_5":13819,"_26493":118874,"_2816":118943},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3328":69820,"_29138":69788,"_20209":118945,"_5":13819,"_26493":118878,"_2816":118946},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3328":69821,"_29138":69788,"_20209":118948,"_5":13819,"_26493":118878,"_2816":118949},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3328":69822,"_29138":69788,"_20209":118951,"_5":13819,"_26493":118878,"_2816":118952},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3328":69823,"_29138":69788,"_20209":118954,"_5":13819,"_26493":118878,"_2816":118955},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3328":69824,"_29138":69788,"_20209":118957,"_5":13819,"_26493":118881,"_2816":118958},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3328":69825,"_29138":69825,"_5":14177,"_2816":118960,"_29482":118961,"_20209":118962,"_26493":69825},"Emite y verifica un certificado",[47429,112963,52903,116292],[],{"_3328":69826,"_29138":69825,"_20209":118964,"_5":13819,"_26493":69825,"_2816":118965},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3328":69827,"_29138":69825,"_5":29479,"_20209":118967,"_26493":118968,"_2816":111541},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3328":69828,"_29138":69825,"_5":29479,"_20209":118970,"_26493":118971,"_2816":118972},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3328":69829,"_29138":69825,"_5":29479,"_20209":118974,"_26493":118975,"_2816":118976},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3328":69830,"_29138":69825,"_5":29479,"_20209":118978,"_26493":118979,"_2816":118980},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3328":69831,"_29138":69825,"_5":29479,"_20209":118982,"_26493":118983,"_2816":118984},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3328":69832,"_29138":69825,"_5":29479,"_20209":118986,"_26493":118987,"_2816":118988},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3328":69833,"_29138":69825,"_5":29479,"_20209":118990,"_26493":118991,"_2816":118992},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3328":69834,"_29138":69825,"_5":29479,"_20209":118994,"_26493":118995,"_2816":118996},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3328":69835,"_29138":69825,"_5":29479,"_20209":118998,"_26493":118999,"_2816":119000},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3328":69836,"_29138":69825,"_5":29479,"_20209":119002,"_26493":119003,"_2816":119004},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3328":69837,"_29138":69825,"_5":29479,"_20209":119006,"_26493":119007,"_2816":116539},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3328":69838,"_29138":69825,"_5":29479,"_20209":119009,"_26493":119010,"_2816":111565},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3328":69839,"_29138":69825,"_20209":119012,"_5":13819,"_26493":69825,"_2816":119013},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3328":69840,"_29138":69825,"_20209":119015,"_5":13819,"_26493":118968,"_2816":119016},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3328":69841,"_29138":69825,"_20209":119018,"_5":13819,"_26493":118968,"_2816":119019},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3328":69842,"_29138":69825,"_20209":119021,"_5":13819,"_26493":118968,"_2816":119022},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3328":69843,"_29138":69825,"_20209":119024,"_5":13819,"_26493":118968,"_2816":119025},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3328":69844,"_29138":69825,"_20209":119027,"_5":13819,"_26493":118968,"_2816":119028},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3328":69845,"_29138":69825,"_20209":119030,"_5":13819,"_26493":118971,"_2816":119031},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3328":69846,"_29138":69825,"_20209":119033,"_5":13819,"_26493":118975,"_2816":119034},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3328":69847,"_29138":69825,"_20209":119036,"_5":13819,"_26493":118975,"_2816":119037},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3328":69848,"_29138":69825,"_20209":119039,"_5":13819,"_26493":118979,"_2816":119040},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3328":69849,"_29138":69825,"_20209":119042,"_5":13819,"_26493":118979,"_2816":119043},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3328":69850,"_29138":69825,"_20209":119045,"_5":13819,"_26493":118983,"_2816":119046},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3328":69851,"_29138":69825,"_20209":119048,"_5":13819,"_26493":118983,"_2816":119049},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3328":69852,"_29138":69825,"_20209":119051,"_5":13819,"_26493":118987,"_2816":119052},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3328":69853,"_29138":69825,"_20209":119054,"_5":13819,"_26493":118991,"_2816":119055},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3328":69854,"_29138":69825,"_20209":119057,"_5":13819,"_26493":118995,"_2816":119058},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3328":69855,"_29138":69825,"_20209":119060,"_5":13819,"_26493":118999,"_2816":119061},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3328":69856,"_29138":69825,"_20209":119063,"_5":13819,"_26493":118999,"_2816":119064},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3328":69857,"_29138":69825,"_20209":119066,"_5":13819,"_26493":118999,"_2816":119067},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3328":69858,"_29138":69825,"_20209":119069,"_5":13819,"_26493":119003,"_2816":119070},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3328":69859,"_29138":69825,"_20209":119072,"_5":13819,"_26493":119003,"_2816":119073},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3328":69860,"_29138":69825,"_20209":119075,"_5":13819,"_26493":119003,"_2816":119076},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3328":69861,"_29138":69825,"_20209":119078,"_5":13819,"_26493":119007,"_2816":116622},[],{"_3328":69862,"_29138":69825,"_20209":119080,"_5":13819,"_26493":119007,"_2816":115136},[],{"_3328":69863,"_29138":69825,"_20209":119082,"_5":13819,"_26493":119007,"_2816":119083},[],"La CA rechaza la emisión",{"_3328":69864,"_29138":69825,"_20209":119085,"_5":13819,"_26493":119007,"_2816":119086},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3328":69865,"_29138":69825,"_20209":119088,"_5":13819,"_26493":119007,"_2816":119089},[],"Sujeto o usos diferentes",{"_3328":69866,"_29138":69825,"_20209":119091,"_5":13819,"_26493":119007,"_2816":119092},[],"Perfil aplicado y valores solicitados.",{"_3328":69867,"_29138":69825,"_20209":119094,"_5":13819,"_26493":119007,"_2816":119095},[],"No se encuentra el emisor",{"_3328":69868,"_29138":69825,"_20209":119097,"_5":13819,"_26493":119007,"_2816":119098},[],"CA descargada y cadena intermedia necesaria.",{"_3328":69869,"_29138":69825,"_20209":119100,"_5":13819,"_26493":119007,"_2816":119101},[],"Falla la vigencia",{"_3328":69870,"_29138":69825,"_20209":119103,"_5":13819,"_26493":119007,"_2816":119104},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3328":69871,"_29138":69825,"_20209":119106,"_5":13819,"_26493":119007,"_2816":119107},[],"Los resúmenes de clave difieren",{"_3328":69872,"_29138":69825,"_20209":119109,"_5":13819,"_26493":119007,"_2816":119110},[],"Archivos de certificado y clave de la misma emisión.",{"_3328":69873,"_29138":69825,"_20209":119112,"_5":13819,"_26493":119007,"_2816":119113},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3328":69874,"_29138":69825,"_20209":119115,"_5":13819,"_26493":119010,"_2816":119116},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3328":69875,"_29138":69825,"_20209":119118,"_5":13819,"_26493":119010,"_2816":119119},[],"Gestionar certificados para inspección, estado y revocación.",{"_3328":69876,"_29138":69825,"_20209":119121,"_5":13819,"_26493":119010,"_2816":119122},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3328":69877,"_29138":69825,"_20209":119124,"_5":13819,"_26493":119010,"_2816":119125},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3328":69878,"_29138":69825,"_20209":119127,"_5":13819,"_26493":119010,"_2816":119128},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3328":69879,"_29138":69879,"_5":14177,"_2816":119130,"_29482":119131,"_20209":119132,"_26493":69879},"Primeros pasos de PKI",[47429,112963,52903,116292],[],{"_3328":69880,"_29138":69879,"_20209":119134,"_5":13819,"_26493":69879,"_2816":119135},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3328":69881,"_29138":69879,"_5":29479,"_20209":119137,"_26493":119138,"_2816":111541},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3328":69882,"_29138":69879,"_5":29479,"_20209":119140,"_26493":119141,"_2816":119142},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3328":69883,"_29138":69879,"_5":29479,"_20209":119144,"_26493":119145,"_2816":116474},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3328":69884,"_29138":69879,"_5":29479,"_20209":119147,"_26493":119148,"_2816":119149},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3328":69885,"_29138":69879,"_20209":119151,"_5":13819,"_26493":69879,"_2816":119152},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3328":69886,"_29138":69879,"_20209":119154,"_5":13819,"_26493":119138,"_2816":119155},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3328":69887,"_29138":69879,"_20209":119157,"_5":13819,"_26493":119138,"_2816":119158},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3328":69888,"_29138":69879,"_20209":119160,"_5":13819,"_26493":119138,"_2816":119161},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3328":69889,"_29138":69879,"_20209":119163,"_5":13819,"_26493":119138,"_2816":119164},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3328":69890,"_29138":69879,"_20209":119166,"_5":13819,"_26493":119138,"_2816":119167},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3328":69891,"_29138":69879,"_20209":119169,"_5":13819,"_26493":119141,"_2816":119170},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3328":69892,"_29138":69879,"_20209":119172,"_5":13819,"_26493":119141,"_2816":119173},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3328":69893,"_29138":69879,"_20209":119175,"_5":13819,"_26493":119141,"_2816":119176},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3328":69894,"_29138":69879,"_20209":119178,"_5":13819,"_26493":119141,"_2816":119179},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3328":69895,"_29138":69879,"_20209":119181,"_5":13819,"_26493":119145,"_2816":119182},[],"Archivo o recurso",{"_3328":69896,"_29138":69879,"_20209":119184,"_5":13819,"_26493":119145,"_2816":116471},[],{"_3328":69897,"_29138":69879,"_20209":119186,"_5":13819,"_26493":119145,"_2816":119187},[],"CA raíz activa y `ca.pem`",{"_3328":69898,"_29138":69879,"_20209":119189,"_5":13819,"_26493":119145,"_2816":119190},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3328":69899,"_29138":69879,"_20209":119192,"_5":13819,"_26493":119145,"_2816":119193},[],"Certificado final y `device.crt`",{"_3328":69900,"_29138":69879,"_20209":119195,"_5":13819,"_26493":119145,"_2816":119196},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3328":69901,"_29138":69879,"_20209":119198,"_5":13819,"_26493":119145,"_2816":119199},[],"Clave privada `device.key`",{"_3328":69902,"_29138":69879,"_20209":119201,"_5":13819,"_26493":119145,"_2816":119202},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3328":69903,"_29138":69879,"_20209":119204,"_5":13819,"_26493":119145,"_2816":119205},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3328":69904,"_29138":69879,"_20209":119207,"_5":13819,"_26493":119148,"_2816":119208},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3328":69905,"_29138":69879,"_20209":119210,"_5":13819,"_26493":119148,"_2816":119211},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3328":69906,"_29138":69879,"_20209":119213,"_5":13819,"_26493":119148,"_2816":119214},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3328":69907,"_29138":69907,"_5":14177,"_2816":119216,"_29482":119217,"_20209":119219,"_26493":69907},"Resolución de problemas PKI",[47429,112963,52903,119218],"Resolución de problemas",[],{"_3328":69908,"_29138":69907,"_20209":119221,"_5":13819,"_26493":69907,"_2816":119222},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3328":69909,"_29138":69907,"_5":29479,"_20209":119224,"_26493":119225,"_2816":119226},[],"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3328":69910,"_29138":69907,"_5":29479,"_20209":119228,"_26493":119229,"_2816":119230},[],"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3328":69911,"_29138":69907,"_5":29479,"_20209":119232,"_26493":119233,"_2816":119234},[],"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3328":69912,"_29138":69907,"_20209":119236,"_5":13819,"_26493":69907,"_2816":119237},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3328":69913,"_29138":69907,"_20209":119239,"_5":13819,"_26493":69907,"_2816":119240},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3328":69914,"_29138":69907,"_20209":119242,"_5":13819,"_26493":119225,"_2816":116471},[],{"_3328":69915,"_29138":69907,"_20209":119244,"_5":13819,"_26493":119225,"_2816":115136},[],{"_3328":69916,"_29138":69907,"_20209":119246,"_5":13819,"_26493":119225,"_2816":111565},[],{"_3328":69917,"_29138":69907,"_20209":119248,"_5":13819,"_26493":119225,"_2816":51742},[],{"_3328":69918,"_29138":69907,"_20209":119250,"_5":13819,"_26493":119225,"_2816":119251},[],"Existe, está activa y sus fechas son utilizables.",{"_3328":69919,"_29138":69907,"_20209":119253,"_5":13819,"_26493":119225,"_2816":119254},[],"Autoridades.",{"_3328":69920,"_29138":69907,"_20209":119256,"_5":13819,"_26493":119225,"_2816":119257},[],"Clave",{"_3328":69921,"_29138":69907,"_20209":119259,"_5":13819,"_26493":119225,"_2816":119260},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3328":69922,"_29138":69907,"_20209":119262,"_5":13819,"_26493":119225,"_2816":119263},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3328":69923,"_29138":69907,"_20209":119265,"_5":13819,"_26493":119225,"_2816":55358},[],{"_3328":69924,"_29138":69907,"_20209":119267,"_5":13819,"_26493":119225,"_2816":119268},[],"PEM correcto y firma verificable.",{"_3328":69925,"_29138":69907,"_20209":119270,"_5":13819,"_26493":119225,"_2816":55364},[],{"_3328":69926,"_29138":69907,"_20209":119272,"_5":13819,"_26493":119225,"_2816":119273},[],"Perfil",{"_3328":69927,"_29138":69907,"_20209":119275,"_5":13819,"_26493":119225,"_2816":119276},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3328":69928,"_29138":69907,"_20209":119278,"_5":13819,"_26493":119225,"_2816":119279},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3328":69929,"_29138":69907,"_20209":119281,"_5":13819,"_26493":119225,"_2816":116622},[],{"_3328":69930,"_29138":69907,"_20209":119283,"_5":13819,"_26493":119225,"_2816":119284},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3328":69931,"_29138":69907,"_20209":119286,"_5":13819,"_26493":119225,"_2816":119287},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3328":69932,"_29138":69907,"_20209":119289,"_5":13819,"_26493":119225,"_2816":119290},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3328":69933,"_29138":69907,"_20209":119292,"_5":13819,"_26493":119225,"_2816":119293},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3328":69934,"_29138":69907,"_20209":119295,"_5":13819,"_26493":119229,"_2816":119296},[],"Revisa cada frontera por separado:",{"_3328":69935,"_29138":69907,"_20209":119298,"_5":13819,"_26493":119229,"_2816":119299},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3328":69936,"_29138":69907,"_20209":119301,"_5":13819,"_26493":119229,"_2816":119302},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3328":69937,"_29138":69907,"_20209":119304,"_5":13819,"_26493":119229,"_2816":119305},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3328":69938,"_29138":69907,"_20209":119307,"_5":13819,"_26493":119229,"_2816":119308},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3328":69939,"_29138":69907,"_20209":119310,"_5":13819,"_26493":119229,"_2816":119311},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3328":69940,"_29138":69907,"_20209":119313,"_5":13819,"_26493":119229,"_2816":119314},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3328":69941,"_29138":69907,"_20209":119316,"_5":13819,"_26493":119233,"_2816":119317},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3328":69942,"_29138":69907,"_20209":119319,"_5":13819,"_26493":119233,"_2816":119320},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3328":69943,"_29138":69943,"_5":14177,"_2816":119322,"_29482":119323,"_20209":119325,"_26493":69943},"3.8.0 a 4.0.0",[47429,119324],"Actualizaciones",[],{"_3328":69944,"_29138":69943,"_20209":119327,"_5":13819,"_26493":69943,"_2816":119328},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3328":69945,"_29138":69943,"_5":29479,"_20209":119330,"_26493":119331,"_2816":119332},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3328":69946,"_29138":69943,"_5":29479,"_20209":119334,"_26493":119335,"_2816":119336},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3328":69947,"_29138":69943,"_5":29479,"_20209":119338,"_26493":119339,"_2816":119340},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3328":69948,"_29138":69943,"_5":29479,"_20209":119342,"_26493":119343,"_2816":119344},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3328":69949,"_29138":69943,"_5":29479,"_20209":119346,"_26493":119347,"_2816":119348},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3328":69950,"_29138":69943,"_5":29479,"_20209":119350,"_26493":119351,"_2816":119352},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3328":69951,"_29138":69943,"_5":29479,"_20209":119354,"_26493":119355,"_2816":55450},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3328":69952,"_29138":69943,"_5":29479,"_20209":119357,"_26493":119358,"_2816":119359},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3328":69953,"_29138":69943,"_5":29479,"_20209":119361,"_26493":119362,"_2816":119363},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3328":69954,"_29138":69943,"_5":29479,"_20209":119365,"_26493":119366,"_2816":119367},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3328":69955,"_29138":69943,"_5":29479,"_20209":119369,"_26493":119370,"_2816":119371},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3328":69956,"_29138":69943,"_5":29479,"_20209":119373,"_26493":119374,"_2816":119375},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3328":69957,"_29138":69943,"_5":29479,"_20209":119377,"_26493":119378,"_2816":119379},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3328":69958,"_29138":69943,"_5":29479,"_20209":119381,"_26493":119382,"_2816":119383},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3328":69959,"_29138":69943,"_5":29479,"_20209":119385,"_26493":119386,"_2816":119387},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3328":69960,"_29138":69943,"_5":29479,"_20209":119389,"_26493":119390,"_2816":119391},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3328":69961,"_29138":69943,"_5":29479,"_20209":119393,"_26493":119394,"_2816":119395},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3328":69962,"_29138":69943,"_5":29479,"_20209":119397,"_26493":119398,"_2816":119399},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3328":69963,"_29138":69943,"_5":29479,"_20209":119401,"_26493":119402,"_2816":119403},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3328":69964,"_29138":69943,"_5":29479,"_20209":119405,"_26493":119406,"_2816":119407},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3328":69965,"_29138":69943,"_5":29479,"_20209":119409,"_26493":119410,"_2816":119411},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3328":69966,"_29138":69943,"_5":29479,"_20209":119413,"_26493":119414,"_2816":119415},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3328":69967,"_29138":69943,"_5":29479,"_20209":119417,"_26493":119418,"_2816":119419},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3328":69968,"_29138":69943,"_5":29479,"_20209":119421,"_26493":119422,"_2816":119423},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3328":69969,"_29138":69943,"_5":29479,"_20209":119425,"_26493":119426,"_2816":119427},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3328":69970,"_29138":69943,"_5":29479,"_20209":119429,"_26493":119430,"_2816":119431},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3328":69971,"_29138":69943,"_5":29479,"_20209":119433,"_26493":119434,"_2816":119435},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3328":69972,"_29138":69943,"_5":29479,"_20209":119437,"_26493":119438,"_2816":119439},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3328":69973,"_29138":69943,"_5":29479,"_20209":119441,"_26493":119442,"_2816":119443},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3328":69974,"_29138":69943,"_5":29479,"_20209":119445,"_26493":119446,"_2816":119447},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3328":69975,"_29138":69943,"_5":29479,"_20209":119449,"_26493":119450,"_2816":119451},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3328":69976,"_29138":69943,"_5":29479,"_20209":119453,"_26493":119454,"_2816":119455},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3328":69977,"_29138":69943,"_5":29479,"_20209":119457,"_26493":119458,"_2816":119459},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3328":69978,"_29138":69943,"_5":29479,"_20209":119461,"_26493":119462,"_2816":115482},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3328":69979,"_29138":69943,"_5":29479,"_20209":119464,"_26493":119465,"_2816":119466},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3328":69980,"_29138":69943,"_5":29479,"_20209":119468,"_26493":119469,"_2816":119470},[],"/docs/pr-preview/pr-45/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3328":69981,"_29138":69943,"_20209":119472,"_5":13819,"_26493":69943,"_2816":119473},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3328":69982,"_29138":69943,"_20209":119475,"_5":13819,"_26493":69943,"_2816":119476},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3328":69983,"_29138":69943,"_20209":119478,"_5":13819,"_26493":69943,"_2816":119479},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3328":69984,"_29138":69943,"_20209":119481,"_5":13819,"_26493":69943,"_2816":119482},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3328":69985,"_29138":69943,"_20209":119484,"_5":13819,"_26493":69943,"_2816":119485},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3328":69986,"_29138":69943,"_20209":119487,"_5":13819,"_26493":69943,"_2816":119488},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3328":69987,"_29138":69943,"_20209":119490,"_5":13819,"_26493":69943,"_2816":119491},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3328":69988,"_29138":69943,"_20209":119493,"_5":13819,"_26493":119335,"_2816":119494},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3328":69989,"_29138":69943,"_20209":119496,"_5":13819,"_26493":119335,"_2816":119497},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3328":69990,"_29138":69943,"_20209":119499,"_5":13819,"_26493":119339,"_2816":119500},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3328":69991,"_29138":69943,"_20209":119502,"_5":13819,"_26493":119339,"_2816":119503},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3328":69992,"_29138":69943,"_20209":119505,"_5":13819,"_26493":119343,"_2816":119506},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3328":69993,"_29138":69943,"_20209":119508,"_5":13819,"_26493":119347,"_2816":119509},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3328":69994,"_29138":69943,"_20209":119511,"_5":13819,"_26493":119347,"_2816":119512},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3328":69995,"_29138":69943,"_20209":119514,"_5":13819,"_26493":119347,"_2816":119515},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3328":69996,"_29138":69943,"_20209":119517,"_5":13819,"_26493":119347,"_2816":119518},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3328":69997,"_29138":69943,"_20209":119520,"_5":13819,"_26493":119347,"_2816":119521},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3328":69998,"_29138":69943,"_20209":119523,"_5":13819,"_26493":119351,"_2816":119524},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3328":69999,"_29138":69943,"_20209":119526,"_5":13819,"_26493":119351,"_2816":119527},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3328":70000,"_29138":69943,"_20209":119529,"_5":13819,"_26493":119351,"_2816":119530},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3328":70001,"_29138":69943,"_20209":119532,"_5":13819,"_26493":119351,"_2816":119533},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3328":70002,"_29138":69943,"_20209":119535,"_5":13819,"_26493":119351,"_2816":119536},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3328":70003,"_29138":69943,"_20209":119538,"_5":13819,"_26493":119355,"_2816":119539},[],"Cambio",{"_3328":70004,"_29138":69943,"_20209":119541,"_5":13819,"_26493":119355,"_2816":119542},[],"A quién afecta",{"_3328":70005,"_29138":69943,"_20209":119544,"_5":13819,"_26493":119355,"_2816":119545},[],"Gravedad",{"_3328":70006,"_29138":69943,"_20209":119547,"_5":13819,"_26493":119355,"_2816":118166},[],{"_3328":70007,"_29138":69943,"_20209":119549,"_5":13819,"_26493":119355,"_2816":119363},[],{"_3328":70008,"_29138":69943,"_20209":119551,"_5":13819,"_26493":119355,"_2816":119552},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3328":70009,"_29138":69943,"_20209":119554,"_5":13819,"_26493":119355,"_2816":119555},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3328":70010,"_29138":69943,"_20209":119557,"_5":13819,"_26493":119355,"_2816":119558},[],"Copiar los datos a los volúmenes nuevos",{"_3328":70011,"_29138":69943,"_20209":119560,"_5":13819,"_26493":119355,"_2816":119367},[],{"_3328":70012,"_29138":69943,"_20209":119562,"_5":13819,"_26493":119355,"_2816":119563},[],"Todas las releases de Helm",{"_3328":70013,"_29138":69943,"_20209":119565,"_5":13819,"_26493":119355,"_2816":119566},[],"Alta: `helm upgrade` falla",{"_3328":70014,"_29138":69943,"_20209":119568,"_5":13819,"_26493":119355,"_2816":119569},[],"Eliminar o renombrar las claves heredadas",{"_3328":70015,"_29138":69943,"_20209":119571,"_5":13819,"_26493":119355,"_2816":119371},[],{"_3328":70016,"_29138":69943,"_20209":119573,"_5":13819,"_26493":119355,"_2816":119574},[],"Todos los despliegues",{"_3328":70017,"_29138":69943,"_20209":119576,"_5":13819,"_26493":119355,"_2816":119577},[],"Alta: sin principal de bootstrap no hay administrador",{"_3328":70018,"_29138":69943,"_20209":119579,"_5":13819,"_26493":119355,"_2816":119580},[],"Configurar `services.authz`",{"_3328":70019,"_29138":69943,"_20209":119582,"_5":13819,"_26493":119355,"_2816":119375},[],{"_3328":70020,"_29138":69943,"_20209":119584,"_5":13819,"_26493":119355,"_2816":119563},[],{"_3328":70021,"_29138":69943,"_20209":119586,"_5":13819,"_26493":119355,"_2816":119587},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3328":70022,"_29138":69943,"_20209":119589,"_5":13819,"_26493":119355,"_2816":119590},[],"Mover JWKS y roles a `services.authz`",{"_3328":70023,"_29138":69943,"_20209":119592,"_5":13819,"_26493":119355,"_2816":119395},[],{"_3328":70024,"_29138":69943,"_20209":119594,"_5":13819,"_26493":119355,"_2816":119595},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3328":70025,"_29138":69943,"_20209":119597,"_5":13819,"_26493":119355,"_2816":119598},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3328":70026,"_29138":69943,"_20209":119600,"_5":13819,"_26493":119355,"_2816":119601},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3328":70027,"_29138":69943,"_20209":119603,"_5":13819,"_26493":119355,"_2816":119399},[],{"_3328":70028,"_29138":69943,"_20209":119605,"_5":13819,"_26493":119355,"_2816":119606},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3328":70029,"_29138":69943,"_20209":119608,"_5":13819,"_26493":119355,"_2816":119609},[],"Alta: el backend ya no arranca con ellos",{"_3328":70030,"_29138":69943,"_20209":119611,"_5":13819,"_26493":119355,"_2816":119612},[],"Pasar a PostgreSQL antes de actualizar",{"_3328":70031,"_29138":69943,"_20209":119614,"_5":13819,"_26493":119355,"_2816":119615},[],"Webhooks con referencias a archivos",{"_3328":70032,"_29138":69943,"_20209":119617,"_5":13819,"_26493":119355,"_2816":119618},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3328":70033,"_29138":69943,"_20209":119620,"_5":13819,"_26493":119355,"_2816":119621},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3328":70034,"_29138":69943,"_20209":119623,"_5":13819,"_26493":119355,"_2816":119624},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3328":70035,"_29138":69943,"_20209":119626,"_5":13819,"_26493":119355,"_2816":119379},[],{"_3328":70036,"_29138":69943,"_20209":119628,"_5":13819,"_26493":119355,"_2816":119629},[],"Releases con identidades por servicio o material de claves montado",{"_3328":70037,"_29138":69943,"_20209":119631,"_5":13819,"_26493":119355,"_2816":119632},[],"Media: los servicios no pueden leer sus archivos",{"_3328":70038,"_29138":69943,"_20209":119634,"_5":13819,"_26493":119355,"_2816":119635},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3328":70039,"_29138":69943,"_20209":119637,"_5":13819,"_26493":119355,"_2816":119383},[],{"_3328":70040,"_29138":69943,"_20209":119639,"_5":13819,"_26493":119355,"_2816":119640},[],"Releases que definen `amqp.tls`",{"_3328":70041,"_29138":69943,"_20209":119642,"_5":13819,"_26493":119355,"_2816":119643},[],"Media: los clientes se conectan al puerto equivocado",{"_3328":70042,"_29138":69943,"_20209":119645,"_5":13819,"_26493":119355,"_2816":119646},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3328":70043,"_29138":69943,"_20209":119648,"_5":13819,"_26493":119355,"_2816":119403},[],{"_3328":70044,"_29138":69943,"_20209":119650,"_5":13819,"_26493":119355,"_2816":119651},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3328":70045,"_29138":69943,"_20209":119653,"_5":13819,"_26493":119355,"_2816":119654},[],"Media: las claves de CA quedan sin gestionar",{"_3328":70046,"_29138":69943,"_20209":119656,"_5":13819,"_26493":119355,"_2816":119657},[],"Ejecutar la migración de CA a KMS",{"_3328":70047,"_29138":69943,"_20209":119659,"_5":13819,"_26493":119355,"_2816":119660},[],"Verificación del certificado del receptor",{"_3328":70048,"_29138":69943,"_20209":119662,"_5":13819,"_26493":119355,"_2816":119663},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3328":70049,"_29138":69943,"_20209":119665,"_5":13819,"_26493":119355,"_2816":119666},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3328":70050,"_29138":69943,"_20209":119668,"_5":13819,"_26493":119355,"_2816":119669},[],"Poner `insecure_skip_verify` a `false`",{"_3328":70051,"_29138":69943,"_20209":119671,"_5":13819,"_26493":119355,"_2816":119415},[],{"_3328":70052,"_29138":69943,"_20209":119673,"_5":13819,"_26493":119355,"_2816":119674},[],"Scripts y consolas que editan DMS por API",{"_3328":70053,"_29138":69943,"_20209":119676,"_5":13819,"_26493":119355,"_2816":119677},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3328":70054,"_29138":69943,"_20209":119679,"_5":13819,"_26493":119355,"_2816":119680},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3328":70055,"_29138":69943,"_20209":119682,"_5":13819,"_26493":119355,"_2816":119431},[],{"_3328":70056,"_29138":69943,"_20209":119684,"_5":13819,"_26493":119355,"_2816":119685},[],"Consumidores que leen el campo `events` del dispositivo",{"_3328":70057,"_29138":69943,"_20209":119687,"_5":13819,"_26493":119355,"_2816":119688},[],"Media: el campo desaparece",{"_3328":70058,"_29138":69943,"_20209":119690,"_5":13819,"_26493":119355,"_2816":119691},[],"Usar los nuevos endpoints de eventos",{"_3328":70059,"_29138":69943,"_20209":119693,"_5":13819,"_26493":119355,"_2816":119387},[],{"_3328":70060,"_29138":69943,"_20209":119695,"_5":13819,"_26493":119355,"_2816":119696},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3328":70061,"_29138":69943,"_20209":119698,"_5":13819,"_26493":119355,"_2816":119699},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3328":70062,"_29138":69943,"_20209":119701,"_5":13819,"_26493":119355,"_2816":119702},[],"Actualizar el archivo de values",{"_3328":70063,"_29138":69943,"_20209":119704,"_5":13819,"_26493":119355,"_2816":119423},[],{"_3328":70064,"_29138":69943,"_20209":119706,"_5":13819,"_26493":119355,"_2816":119707},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3328":70065,"_29138":69943,"_20209":119709,"_5":13819,"_26493":119355,"_2816":119710},[],"Baja: prevalece el ID de la URL",{"_3328":70066,"_29138":69943,"_20209":119712,"_5":13819,"_26493":119355,"_2816":119713},[],"Enviar el ID en la URL",{"_3328":70067,"_29138":69943,"_20209":119715,"_5":13819,"_26493":119355,"_2816":119427},[],{"_3328":70068,"_29138":69943,"_20209":119717,"_5":13819,"_26493":119355,"_2816":119718},[],"Consumidores que comparan el `type` del certificado",{"_3328":70069,"_29138":69943,"_20209":119720,"_5":13819,"_26493":119355,"_2816":119721},[],"Baja: dos valores cambian de nombre",{"_3328":70070,"_29138":69943,"_20209":119723,"_5":13819,"_26493":119355,"_2816":119724},[],"Adaptar los consumidores",{"_3328":70071,"_29138":69943,"_20209":119726,"_5":13819,"_26493":119355,"_2816":119419},[],{"_3328":70072,"_29138":69943,"_20209":119728,"_5":13819,"_26493":119355,"_2816":119729},[],"Cualquier DMS",{"_3328":70073,"_29138":69943,"_20209":119731,"_5":13819,"_26493":119355,"_2816":119732},[],"Baja: solo informativo",{"_3328":70074,"_29138":69943,"_20209":119734,"_5":13819,"_26493":119355,"_2816":119735},[],"Revisar ambos bloques antes de editar",{"_3328":70075,"_29138":69943,"_20209":119737,"_5":13819,"_26493":119362,"_2816":119738},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3328":70076,"_29138":69943,"_20209":119740,"_5":13819,"_26493":119362,"_2816":119741},[],"El paso 4 de la guía de migración copia los datos.",{"_3328":70077,"_29138":69943,"_20209":119743,"_5":13819,"_26493":119366,"_2816":119744},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3328":70078,"_29138":69943,"_20209":119746,"_5":13819,"_26493":119370,"_2816":119747},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3328":70079,"_29138":69943,"_20209":119749,"_5":13819,"_26493":119374,"_2816":119750},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3328":70080,"_29138":69943,"_20209":119752,"_5":13819,"_26493":119378,"_2816":119753},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3328":70081,"_29138":69943,"_20209":119755,"_5":13819,"_26493":119378,"_2816":119756},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3328":70082,"_29138":69943,"_20209":119758,"_5":13819,"_26493":119382,"_2816":119759},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3328":70083,"_29138":69943,"_20209":119761,"_5":13819,"_26493":119386,"_2816":119762},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3328":70084,"_29138":69943,"_20209":119764,"_5":13819,"_26493":119386,"_2816":119765},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3328":70085,"_29138":69943,"_20209":119767,"_5":13819,"_26493":119386,"_2816":119768},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3328":70086,"_29138":69943,"_20209":119770,"_5":13819,"_26493":119386,"_2816":119771},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3328":70087,"_29138":69943,"_20209":119773,"_5":13819,"_26493":119386,"_2816":119774},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3328":70088,"_29138":69943,"_20209":119776,"_5":13819,"_26493":119386,"_2816":119777},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3328":70089,"_29138":69943,"_20209":119779,"_5":13819,"_26493":119394,"_2816":119780},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3328":70090,"_29138":69943,"_20209":119782,"_5":13819,"_26493":119394,"_2816":119783},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3328":70091,"_29138":69943,"_20209":119785,"_5":13819,"_26493":119394,"_2816":119786},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3328":70092,"_29138":69943,"_20209":119788,"_5":13819,"_26493":119394,"_2816":119789},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3328":70093,"_29138":69943,"_20209":119791,"_5":13819,"_26493":119394,"_2816":119792},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3328":70094,"_29138":69943,"_20209":119794,"_5":13819,"_26493":119398,"_2816":119795},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3328":70095,"_29138":69943,"_20209":119797,"_5":13819,"_26493":119402,"_2816":119798},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3328":70096,"_29138":69943,"_20209":119800,"_5":13819,"_26493":119402,"_2816":119801},[],"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_3328":70097,"_29138":69943,"_20209":119803,"_5":13819,"_26493":119402,"_2816":119804},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3328":70098,"_29138":69943,"_20209":119806,"_5":13819,"_26493":119402,"_2816":119807},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3328":70099,"_29138":69943,"_20209":119809,"_5":13819,"_26493":119402,"_2816":119810},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3328":70100,"_29138":69943,"_20209":119812,"_5":13819,"_26493":119402,"_2816":119813},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3328":70101,"_29138":69943,"_20209":119815,"_5":13819,"_26493":119410,"_2816":119816},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3328":70102,"_29138":69943,"_20209":119818,"_5":13819,"_26493":119410,"_2816":119819},[],"Campo en 3.8.0",{"_3328":70103,"_29138":69943,"_20209":119821,"_5":13819,"_26493":119410,"_2816":119822},[],"Campo en 4.0.0",{"_3328":70104,"_29138":69943,"_20209":119824,"_5":13819,"_26493":119410,"_2816":55920},[],{"_3328":70105,"_29138":69943,"_20209":119826,"_5":13819,"_26493":119410,"_2816":119827},[],"`insecure_skip_verify` (con el valor negado)",{"_3328":70106,"_29138":69943,"_20209":119829,"_5":13819,"_26493":119410,"_2816":55926},[],{"_3328":70107,"_29138":69943,"_20209":119831,"_5":13819,"_26493":119410,"_2816":55929},[],{"_3328":70108,"_29138":69943,"_20209":119833,"_5":13819,"_26493":119410,"_2816":55932},[],{"_3328":70109,"_29138":69943,"_20209":119835,"_5":13819,"_26493":119410,"_2816":55935},[],{"_3328":70110,"_29138":69943,"_20209":119837,"_5":13819,"_26493":119410,"_2816":55938},[],{"_3328":70111,"_29138":69943,"_20209":119839,"_5":13819,"_26493":119410,"_2816":55941},[],{"_3328":70112,"_29138":69943,"_20209":119841,"_5":13819,"_26493":119410,"_2816":119842},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3328":70113,"_29138":69943,"_20209":119844,"_5":13819,"_26493":119410,"_2816":119845},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3328":70114,"_29138":69943,"_20209":119847,"_5":13819,"_26493":119410,"_2816":119848},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3328":70115,"_29138":69943,"_20209":119850,"_5":13819,"_26493":119414,"_2816":119851},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3328":70116,"_29138":69943,"_20209":119853,"_5":13819,"_26493":119414,"_2816":119854},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3328":70117,"_29138":69943,"_20209":119856,"_5":13819,"_26493":119414,"_2816":119857},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3328":70118,"_29138":69943,"_20209":119859,"_5":13819,"_26493":119418,"_2816":119860},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3328":70119,"_29138":69943,"_20209":119862,"_5":13819,"_26493":119422,"_2816":119863},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3328":70120,"_29138":69943,"_20209":119865,"_5":13819,"_26493":119426,"_2816":119866},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3328":70121,"_29138":69943,"_20209":119868,"_5":13819,"_26493":119430,"_2816":119869},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3328":70122,"_29138":69943,"_20209":119871,"_5":13819,"_26493":119430,"_2816":119872},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3328":70123,"_29138":69943,"_20209":119874,"_5":13819,"_26493":119430,"_2816":119875},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3328":70124,"_29138":69943,"_20209":119877,"_5":13819,"_26493":119430,"_2816":119878},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3328":70125,"_29138":69943,"_20209":119880,"_5":13819,"_26493":119434,"_2816":119881},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3328":70126,"_29138":69943,"_20209":119883,"_5":13819,"_26493":119438,"_2816":119884},[],"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`.",{"_3328":70127,"_29138":69943,"_20209":119886,"_5":13819,"_26493":119438,"_2816":119887},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3328":70128,"_29138":69943,"_20209":119889,"_5":13819,"_26493":119438,"_2816":119890},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3328":70129,"_29138":69943,"_20209":119892,"_5":13819,"_26493":119438,"_2816":119893},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3328":70130,"_29138":69943,"_20209":119895,"_5":13819,"_26493":119438,"_2816":119896},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3328":70131,"_29138":69943,"_20209":119898,"_5":13819,"_26493":119442,"_2816":119899},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3328":70132,"_29138":69943,"_20209":119901,"_5":13819,"_26493":119442,"_2816":119902},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3328":70133,"_29138":69943,"_20209":119904,"_5":13819,"_26493":119442,"_2816":119905},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3328":70134,"_29138":69943,"_20209":119907,"_5":13819,"_26493":119442,"_2816":119908},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3328":70135,"_29138":69943,"_20209":119910,"_5":13819,"_26493":119442,"_2816":119911},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3328":70136,"_29138":69943,"_20209":119913,"_5":13819,"_26493":119442,"_2816":119914},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3328":70137,"_29138":69943,"_20209":119916,"_5":13819,"_26493":119442,"_2816":119917},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3328":70138,"_29138":69943,"_20209":119919,"_5":13819,"_26493":119442,"_2816":119920},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3328":70139,"_29138":69943,"_20209":119922,"_5":13819,"_26493":119442,"_2816":119923},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3328":70140,"_29138":69943,"_20209":119925,"_5":13819,"_26493":119442,"_2816":119926},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3328":70141,"_29138":69943,"_20209":119928,"_5":13819,"_26493":119442,"_2816":119929},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3328":70142,"_29138":69943,"_20209":119931,"_5":13819,"_26493":119442,"_2816":119932},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3328":70143,"_29138":69943,"_20209":119934,"_5":13819,"_26493":119446,"_2816":119935},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3328":70144,"_29138":69943,"_20209":119937,"_5":13819,"_26493":119446,"_2816":119938},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3328":70145,"_29138":69943,"_20209":119940,"_5":13819,"_26493":119450,"_2816":119941},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3328":70146,"_29138":69943,"_20209":119943,"_5":13819,"_26493":119450,"_2816":119944},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3328":70147,"_29138":69943,"_20209":119946,"_5":13819,"_26493":119450,"_2816":119947},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3328":70148,"_29138":69943,"_20209":119949,"_5":13819,"_26493":119450,"_2816":119950},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3328":70149,"_29138":69943,"_20209":119952,"_5":13819,"_26493":119450,"_2816":119953},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3328":70150,"_29138":69943,"_20209":119955,"_5":13819,"_26493":119450,"_2816":119956},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3328":70151,"_29138":69943,"_20209":119958,"_5":13819,"_26493":119450,"_2816":119959},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3328":70152,"_29138":69943,"_20209":119961,"_5":13819,"_26493":119450,"_2816":119962},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3328":70153,"_29138":69943,"_20209":119964,"_5":13819,"_26493":119450,"_2816":119965},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3328":70154,"_29138":69943,"_20209":119967,"_5":13819,"_26493":119450,"_2816":119968},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3328":70155,"_29138":69943,"_20209":119970,"_5":13819,"_26493":119450,"_2816":119971},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3328":70156,"_29138":69943,"_20209":119973,"_5":13819,"_26493":119454,"_2816":119974},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3328":70157,"_29138":69943,"_20209":119976,"_5":13819,"_26493":119454,"_2816":119977},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3328":70158,"_29138":69943,"_20209":119979,"_5":13819,"_26493":119458,"_2816":119980},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3328":70159,"_29138":69943,"_20209":119982,"_5":13819,"_26493":119458,"_2816":119983},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3328":70160,"_29138":69943,"_20209":119985,"_5":13819,"_26493":119458,"_2816":119986},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3328":70161,"_29138":69943,"_20209":119988,"_5":13819,"_26493":119458,"_2816":119989},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3328":70162,"_29138":69943,"_20209":119991,"_5":13819,"_26493":119458,"_2816":119992},[],"El README de `goose-lamassu` aún muestra ejemplos por base de datos (`dbname=ca`, `dbname=kms`) y afirma que la herramienta valida el nombre de la base de datos, y el README de `ca-to-kms-migration` sigue describiendo el modelo de dos bases anterior a 4.0.0. Sigue la forma con `dbname=pki` de esta página en lugar de sus ejemplos.",{"_3328":70163,"_29138":69943,"_20209":119994,"_5":13819,"_26493":119462,"_2816":119995},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3328":70164,"_29138":69943,"_20209":119997,"_5":13819,"_26493":119462,"_2816":119998},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3328":70165,"_29138":69943,"_20209":120000,"_5":13819,"_26493":119462,"_2816":120001},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3328":70166,"_29138":69943,"_20209":120003,"_5":13819,"_26493":119462,"_2816":120004},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3328":70167,"_29138":69943,"_20209":120006,"_5":13819,"_26493":119462,"_2816":120007},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización.",{"_3328":70168,"_29138":69943,"_20209":120009,"_5":13819,"_26493":119462,"_2816":120010},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3328":70169,"_29138":69943,"_20209":120012,"_5":13819,"_26493":119462,"_2816":120013},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3328":70170,"_29138":69943,"_20209":120015,"_5":13819,"_26493":119465,"_2816":120016},[],"Tras la actualización, comprueba en este orden:",{"_3328":70171,"_29138":69943,"_20209":120018,"_5":13819,"_26493":119465,"_2816":120019},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS.",{"_3328":70172,"_29138":69943,"_20209":120021,"_5":13819,"_26493":119465,"_2816":120022},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3328":70173,"_29138":69943,"_20209":120024,"_5":13819,"_26493":119465,"_2816":120025},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3328":70174,"_29138":69943,"_20209":120027,"_5":13819,"_26493":119465,"_2816":120028},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas.",{"_3328":70175,"_29138":69943,"_20209":120030,"_5":13819,"_26493":119465,"_2816":120031},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS.",{"_3328":70176,"_29138":69943,"_20209":120033,"_5":13819,"_26493":119465,"_2816":120034},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3328":70177,"_29138":69943,"_20209":120036,"_5":13819,"_26493":119465,"_2816":120037},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3328":70178,"_29138":69943,"_20209":120039,"_5":13819,"_26493":119465,"_2816":120040},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3328":70179,"_29138":69943,"_20209":120042,"_5":13819,"_26493":119465,"_2816":120043},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3328":70180,"_29138":69943,"_20209":120045,"_5":13819,"_26493":119465,"_2816":120046},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3328":70181,"_29138":69943,"_20209":120048,"_5":13819,"_26493":119465,"_2816":120049},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3328":70182,"_29138":69943,"_20209":120051,"_5":13819,"_26493":119465,"_2816":120052},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3328":70183,"_29138":69943,"_20209":120054,"_5":13819,"_26493":119465,"_2816":120055},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3328":70184,"_29138":69943,"_20209":120057,"_5":13819,"_26493":119465,"_2816":120058},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3328":70185,"_29138":69943,"_20209":120060,"_5":13819,"_26493":119469,"_2816":120061},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3328":70186,"_29138":69943,"_20209":120063,"_5":13819,"_26493":119469,"_2816":120064},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3328":70187,"_29138":69943,"_20209":120066,"_5":13819,"_26493":119469,"_2816":120067},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3328":70188,"_29138":69943,"_20209":120069,"_5":13819,"_26493":119469,"_2816":120070},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3328":70189,"_29138":69943,"_20209":120072,"_5":13819,"_26493":119469,"_2816":120073},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_56178":120075,"_56180":120076,"_56182":120077,"_56184":120078,"_17488":2838,"_67387":2838},"spanish",[2816,29138,5,26493],{"_2816":24136,"_29138":24136,"_5":24136,"_26493":24136},{"_2816":120079,"_29138":122878,"_5":125677,"_26493":128476},{"_4473":120080,"_56188":120081,"_5":24136},{"_13901":12816,"_14277":4008,"_14296":4537,"_12464":7333,"_14283":5792,"_19180":18501,"_13922":5748,"_13929":7296,"_28090":4697,"_28498":3221,"_28519":7172,"_28124":5532,"_33381":2926,"_28226":23970,"_28563":2856,"_33388":6251,"_33391":4423,"_33394":7179,"_33397":4926,"_28970":3373,"_33402":3848,"_33404":3112,"_29000":19418,"_14292":24145,"_33408":6884,"_33411":3113,"_33413":15424,"_28547":5525,"_28965":6703,"_29013":6701,"_33418":23549,"_33420":16207,"_33422":4248,"_28243":6722,"_33425":12385,"_33427":3799,"_33429":3169,"_33431":3308,"_33433":5306,"_28160":4875,"_33436":3150,"_33438":6450,"_28154":20700,"_28584":13136,"_29197":3836,"_33443":9162,"_33446":6191,"_28200":16573,"_33450":4987,"_28081":14467,"_33453":2901,"_28129":5761,"_33456":6300,"_33458":5747,"_33461":3916,"_14286":4285,"_33464":4534,"_33466":5779,"_33469":11710,"_33471":6660,"_33473":4601,"_33475":3254,"_33477":4859,"_19183":4449,"_33480":5020,"_33482":3273,"_28102":4216,"_28541":4965,"_33486":24146,"_33488":4027,"_33490":7272,"_29030":5305,"_33493":4436,"_33495":5700,"_33497":8681,"_29124":4549,"_28600":4959,"_33501":4425,"_33503":2885,"_28139":4218,"_33506":