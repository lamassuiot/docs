:55870,"_38758":55873,"_38760":55876,"_38762":55879,"_38764":55882,"_38766":55885,"_38768":55888,"_38770":55891,"_38772":55894,"_38774":55897,"_38776":55900,"_38778":55903,"_38780":55906,"_38782":55909,"_38784":55912,"_38786":55915,"_38788":55918,"_38790":55921,"_38792":55924,"_38794":55927,"_38796":55930,"_38798":55933,"_38800":55936,"_38802":55939,"_38804":55942,"_38806":55945,"_38809":55948,"_38811":55951,"_38813":55954,"_38815":55957,"_38817":55960,"_38819":55963,"_38821":55966,"_38823":55969,"_38825":55972,"_38827":55975,"_38829":55978,"_38831":55981,"_38833":55984,"_38835":55987,"_38837":55990,"_38839":55993,"_38841":55996,"_38843":55999,"_38845":56002,"_38847":56005,"_38849":56008,"_38851":56011,"_38853":56014,"_38855":56017,"_38857":56020,"_38859":56023,"_38861":56026,"_38863":56029,"_38865":56032,"_38867":56035,"_38869":56038,"_38872":56041,"_38874":56044,"_38876":56047,"_38879":56050,"_38881":56053,"_38883":56056,"_38885":56059,"_38887":56062,"_38889":56065,"_38891":56068,"_38893":56071,"_38895":56074,"_38897":56077,"_38899":56080,"_38901":56083,"_38903":56086,"_38905":56089,"_38907":56092,"_38909":56095,"_38911":56098,"_38913":56101,"_38915":56104,"_38917":56107,"_38919":56110,"_38921":56113,"_38923":56116,"_38925":56119,"_38927":56122,"_38929":56125,"_38931":56128,"_38933":56131,"_38935":56134,"_38937":56137,"_38939":56140,"_38941":56143,"_38943":56146,"_38945":56149,"_38947":56152,"_38949":56155,"_38951":56158,"_38953":56161,"_38956":56164,"_38958":56167,"_38960":56170,"_38962":56173},{"_3328":15,"_29138":15,"_5":14177,"_2816":47427,"_29482":47428,"_20209":47432,"_26493":15},"Deploy from AWS Marketplace",[47429,47430,47431],"Docs","Deployment","Other models",[],{"_3328":16,"_29138":15,"_20209":47434,"_5":13819,"_26493":15,"_2816":47435},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3328":17,"_29138":15,"_5":29479,"_20209":47437,"_26493":47438,"_2816":47439},[],"/docs/pr-preview/pr-45/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3328":18,"_29138":15,"_5":29479,"_20209":47441,"_26493":47442,"_2816":47443},[],"/docs/pr-preview/pr-45/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3328":19,"_29138":15,"_5":29479,"_20209":47445,"_26493":47446,"_2816":47447},[],"/docs/pr-preview/pr-45/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3328":20,"_29138":15,"_5":29479,"_20209":47449,"_26493":47450,"_2816":47451},[],"/docs/pr-preview/pr-45/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3328":21,"_29138":15,"_5":29479,"_20209":47453,"_26493":47454,"_2816":47455},[],"/docs/pr-preview/pr-45/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3328":22,"_29138":15,"_5":29479,"_20209":47457,"_26493":47458,"_2816":47459},[],"/docs/pr-preview/pr-45/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3328":23,"_29138":15,"_5":29479,"_20209":47461,"_26493":47462,"_2816":47463},[],"/docs/pr-preview/pr-45/deployment/aws-marketplace#next-step","Next step",{"_3328":24,"_29138":15,"_20209":47465,"_5":13819,"_26493":15,"_2816":47466},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3328":25,"_29138":15,"_20209":47468,"_5":13819,"_26493":47438,"_2816":47469},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3328":26,"_29138":15,"_20209":47471,"_5":13819,"_26493":47438,"_2816":47472},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3328":27,"_29138":15,"_20209":47474,"_5":13819,"_26493":47438,"_2816":47475},[],"A security group allowing the necessary endpoints.",{"_3328":28,"_29138":15,"_20209":47477,"_5":13819,"_26493":47442,"_2816":47478},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3328":29,"_29138":15,"_20209":47480,"_5":13819,"_26493":47442,"_2816":47481},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3328":30,"_29138":15,"_20209":47483,"_5":13819,"_26493":47442,"_2816":47484},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3328":31,"_29138":15,"_20209":47486,"_5":13819,"_26493":47446,"_2816":47487},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3328":32,"_29138":15,"_20209":47489,"_5":13819,"_26493":47450,"_2816":47490},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3328":33,"_29138":15,"_20209":47492,"_5":13819,"_26493":47454,"_2816":47493},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3328":34,"_29138":15,"_20209":47495,"_5":13819,"_26493":47458,"_2816":47496},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3328":35,"_29138":15,"_20209":47498,"_5":13819,"_26493":47462,"_2816":47499},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3328":36,"_29138":36,"_5":14177,"_2816":47501,"_29482":47502,"_20209":47503,"_26493":36},"Deploy Lamassu",[47429,47430],[],{"_3328":37,"_29138":36,"_20209":47505,"_5":13819,"_26493":36,"_2816":47506},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3328":38,"_29138":36,"_5":29479,"_20209":47508,"_26493":47509,"_2816":47510},[],"/docs/pr-preview/pr-45/deployment/overview#choose-a-model","Choose a model",{"_3328":39,"_29138":36,"_5":29479,"_20209":47512,"_26493":47513,"_2816":47514},[],"/docs/pr-preview/pr-45/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3328":40,"_29138":36,"_5":29479,"_20209":47516,"_26493":47517,"_2816":47518},[],"/docs/pr-preview/pr-45/deployment/overview#after-deployment","After deployment",{"_3328":41,"_29138":36,"_20209":47520,"_5":13819,"_26493":36,"_2816":47521},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3328":42,"_29138":36,"_20209":47523,"_5":13819,"_26493":47509,"_2816":47524},[],"Model",{"_3328":43,"_29138":36,"_20209":47526,"_5":13819,"_26493":47509,"_2816":47527},[],"Recommended for",{"_3328":44,"_29138":36,"_20209":47529,"_5":13819,"_26493":47509,"_2816":47530},[],"Who operates the infrastructure",{"_3328":45,"_29138":36,"_20209":47532,"_5":13819,"_26493":47509,"_2816":47533},[],"Starting point",{"_3328":46,"_29138":36,"_20209":47535,"_5":13819,"_26493":47509,"_2816":47536},[],"Kubernetes self-managed",{"_3328":47,"_29138":36,"_20209":47538,"_5":13819,"_26493":47509,"_2816":47539},[],"Production, regulated environments and custom deployments",{"_3328":48,"_29138":36,"_20209":47541,"_5":13819,"_26493":47509,"_2816":47542},[],"Your team",{"_3328":49,"_29138":36,"_20209":47544,"_5":13819,"_26493":47509,"_2816":47545},[],"Helm or Fastlane",{"_3328":50,"_29138":36,"_20209":47547,"_5":13819,"_26493":47509,"_2816":47548},[],"AWS Marketplace",{"_3328":51,"_29138":36,"_20209":47550,"_5":13819,"_26493":47509,"_2816":47551},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3328":52,"_29138":36,"_20209":47553,"_5":13819,"_26493":47509,"_2816":47542},[],{"_3328":53,"_29138":36,"_20209":47555,"_5":13819,"_26493":47509,"_2816":47556},[],"Preconfigured image on EC2",{"_3328":54,"_29138":36,"_20209":47558,"_5":13819,"_26493":47509,"_2816":47559},[],"SaaS",{"_3328":55,"_29138":36,"_20209":47561,"_5":13819,"_26493":47509,"_2816":47562},[],"Teams that want to use the platform without operating it",{"_3328":56,"_29138":36,"_20209":47564,"_5":13819,"_26493":47509,"_2816":47565},[],"Lamassu",{"_3328":57,"_29138":36,"_20209":47567,"_5":13819,"_26493":47509,"_2816":47568},[],"Managed subscription",{"_3328":58,"_29138":36,"_20209":47570,"_5":13819,"_26493":47509,"_2816":47571},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3328":59,"_29138":36,"_20209":47573,"_5":13819,"_26493":47509,"_2816":47574},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3328":60,"_29138":36,"_20209":47576,"_5":13819,"_26493":47509,"_2816":47577},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3328":61,"_29138":36,"_20209":47579,"_5":13819,"_26493":47513,"_2816":47580},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3328":62,"_29138":36,"_20209":47582,"_5":13819,"_26493":47517,"_2816":47583},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3328":63,"_29138":63,"_5":14177,"_2816":47585,"_29482":47586,"_20209":47587,"_26493":63},"Use Lamassu as SaaS",[47429,47430,47431],[],{"_3328":64,"_29138":63,"_20209":47589,"_5":13819,"_26493":63,"_2816":47590},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3328":65,"_29138":63,"_5":29479,"_20209":47592,"_26493":47593,"_2816":47594},[],"/docs/pr-preview/pr-45/deployment/saas#what-the-service-manages","What the service manages",{"_3328":66,"_29138":63,"_5":29479,"_20209":47596,"_26493":47597,"_2816":47598},[],"/docs/pr-preview/pr-45/deployment/saas#plans","Plans",{"_3328":67,"_29138":63,"_5":29479,"_20209":47600,"_26493":47601,"_2816":47602},[],"/docs/pr-preview/pr-45/deployment/saas#request-access","Request access",{"_3328":68,"_29138":63,"_20209":47604,"_5":13819,"_26493":63,"_2816":47605},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3328":69,"_29138":63,"_20209":47607,"_5":13819,"_26493":47593,"_2816":47608},[],"Platform availability and maintenance.",{"_3328":70,"_29138":63,"_20209":47610,"_5":13819,"_26493":47593,"_2816":47611},[],"Automatic backups.",{"_3328":71,"_29138":63,"_20209":47613,"_5":13819,"_26493":47593,"_2816":47614},[],"Version upgrades.",{"_3328":72,"_29138":63,"_20209":47616,"_5":13819,"_26493":47593,"_2816":47617},[],"Technical support and SLA according to your plan.",{"_3328":73,"_29138":63,"_20209":47619,"_5":13819,"_26493":47597,"_2816":47620},[],"Plan",{"_3328":74,"_29138":63,"_20209":47622,"_5":13819,"_26493":47597,"_2816":47623},[],"Devices",{"_3328":75,"_29138":63,"_20209":47625,"_5":13819,"_26493":47597,"_2816":47626},[],"Support",{"_3328":76,"_29138":63,"_20209":47628,"_5":13819,"_26493":47597,"_2816":47629},[],"SLA",{"_3328":77,"_29138":63,"_20209":47631,"_5":13819,"_26493":47597,"_2816":47632},[],"Starter",{"_3328":78,"_29138":63,"_20209":47634,"_5":13819,"_26493":47597,"_2816":47635},[],"Up to 1,000",{"_3328":79,"_29138":63,"_20209":47637,"_5":13819,"_26493":47597,"_2816":47638},[],"Email",{"_3328":80,"_29138":63,"_20209":47640,"_5":13819,"_26493":47597,"_2816":47641},[],"99.5 %",{"_3328":81,"_29138":63,"_20209":47643,"_5":13819,"_26493":47597,"_2816":47644},[],"Professional",{"_3328":82,"_29138":63,"_20209":47646,"_5":13819,"_26493":47597,"_2816":47647},[],"Up to 10,000",{"_3328":83,"_29138":63,"_20209":47649,"_5":13819,"_26493":47597,"_2816":47650},[],"Email and chat",{"_3328":84,"_29138":63,"_20209":47652,"_5":13819,"_26493":47597,"_2816":47653},[],"99.9 %",{"_3328":85,"_29138":63,"_20209":47655,"_5":13819,"_26493":47597,"_2816":47656},[],"Enterprise",{"_3328":86,"_29138":63,"_20209":47658,"_5":13819,"_26493":47597,"_2816":47659},[],"Unlimited",{"_3328":87,"_29138":63,"_20209":47661,"_5":13819,"_26493":47597,"_2816":47662},[],"Dedicated",{"_3328":88,"_29138":63,"_20209":47664,"_5":13819,"_26493":47597,"_2816":47665},[],"99.99 %",{"_3328":89,"_29138":63,"_20209":47667,"_5":13819,"_26493":47601,"_2816":47668},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3328":90,"_29138":63,"_20209":47670,"_5":13819,"_26493":47601,"_2816":47671},[],"When you receive your instance's credentials, continue with Get started.",{"_3328":91,"_29138":91,"_5":14177,"_2816":47673,"_29482":47674,"_20209":47675,"_26493":91},"Fastlane",[47429,47430,47536],[],{"_3328":92,"_29138":91,"_20209":47677,"_5":13819,"_26493":91,"_2816":47678},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3328":93,"_29138":91,"_5":29479,"_20209":47680,"_26493":47681,"_2816":47682},[],"/docs/pr-preview/pr-45/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3328":94,"_29138":91,"_5":29479,"_20209":47684,"_26493":47685,"_2816":47686},[],"/docs/pr-preview/pr-45/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3328":95,"_29138":91,"_5":29479,"_20209":47688,"_26493":47689,"_2816":47439},[],"/docs/pr-preview/pr-45/deployment/self-hosted/fastlane#before-you-begin",{"_3328":96,"_29138":91,"_5":29479,"_20209":47691,"_26493":47692,"_2816":47693},[],"/docs/pr-preview/pr-45/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3328":97,"_29138":91,"_5":29479,"_20209":47695,"_26493":47696,"_2816":47697},[],"/docs/pr-preview/pr-45/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3328":98,"_29138":91,"_5":29479,"_20209":47699,"_26493":47700,"_2816":47701},[],"/docs/pr-preview/pr-45/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3328":99,"_29138":91,"_5":29479,"_20209":47703,"_26493":47704,"_2816":47705},[],"/docs/pr-preview/pr-45/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3328":100,"_29138":91,"_5":29479,"_20209":47707,"_26493":47708,"_2816":47709},[],"/docs/pr-preview/pr-45/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3328":101,"_29138":91,"_5":29479,"_20209":47711,"_26493":47712,"_2816":47713},[],"/docs/pr-preview/pr-45/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3328":102,"_29138":91,"_5":29479,"_20209":47715,"_26493":47716,"_2816":47717},[],"/docs/pr-preview/pr-45/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3328":103,"_29138":91,"_5":29479,"_20209":47719,"_26493":47720,"_2816":47721},[],"/docs/pr-preview/pr-45/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3328":104,"_29138":91,"_20209":47723,"_5":13819,"_26493":47681,"_2816":47724},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3328":105,"_29138":91,"_20209":47726,"_5":13819,"_26493":47681,"_2816":47727},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3328":106,"_29138":91,"_20209":47729,"_5":13819,"_26493":47685,"_2816":47730},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3328":107,"_29138":91,"_20209":47732,"_5":13819,"_26493":47685,"_2816":47733},[],"Fastlane installs or configures",{"_3328":108,"_29138":91,"_20209":47735,"_5":13819,"_26493":47685,"_2816":47736},[],"You still provide",{"_3328":109,"_29138":91,"_20209":47738,"_5":13819,"_26493":47685,"_2816":47739},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3328":110,"_29138":91,"_20209":47741,"_5":13819,"_26493":47685,"_2816":47742},[],"The Kubernetes cluster, nodes and persistent storage",{"_3328":111,"_29138":91,"_20209":47744,"_5":13819,"_26493":47685,"_2816":47745},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3328":112,"_29138":91,"_20209":47747,"_5":13819,"_26493":47685,"_2816":47748},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3328":113,"_29138":91,"_20209":47750,"_5":13819,"_26493":47685,"_2816":47751},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3328":114,"_29138":91,"_20209":47753,"_5":13819,"_26493":47685,"_2816":47754},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3328":115,"_29138":91,"_20209":47756,"_5":13819,"_26493":47685,"_2816":47757},[],"Optional observability and lab HSM components",{"_3328":116,"_29138":91,"_20209":47759,"_5":13819,"_26493":47685,"_2816":47760},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3328":117,"_29138":91,"_20209":47762,"_5":13819,"_26493":47685,"_2816":47763},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3328":118,"_29138":91,"_20209":47765,"_5":13819,"_26493":47689,"_2816":47766},[],"You need:",{"_3328":119,"_29138":91,"_20209":47768,"_5":13819,"_26493":47689,"_2816":47769},[],"an existing Kubernetes cluster",{"_3328":120,"_29138":91,"_20209":47771,"_5":13819,"_26493":47689,"_2816":47772},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3328":121,"_29138":91,"_20209":47774,"_5":13819,"_26493":47689,"_2816":47775},[],"`yq`",{"_3328":122,"_29138":91,"_20209":47777,"_5":13819,"_26493":47689,"_2816":22856},[],{"_3328":123,"_29138":91,"_20209":47779,"_5":13819,"_26493":47689,"_2816":47780},[],"`jq` only when using `--sample-data` or `--development`",{"_3328":124,"_29138":91,"_20209":47782,"_5":13819,"_26493":47689,"_2816":47783},[],"`ssh-keygen` only when using `--with-hsm`",{"_3328":125,"_29138":91,"_20209":47785,"_5":13819,"_26493":47689,"_2816":47786},[],"free external ports 80 and 443 on a single-node K3s host",{"_3328":126,"_29138":91,"_20209":47788,"_5":13819,"_26493":47689,"_2816":47789},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3328":127,"_29138":91,"_20209":47791,"_5":13819,"_26493":47689,"_2816":47792},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3328":128,"_29138":91,"_20209":47794,"_5":13819,"_26493":47692,"_2816":47795},[],"Run the script from a clone of the Helm repository:",{"_3328":129,"_29138":91,"_20209":47797,"_5":13819,"_26493":47692,"_2816":47798},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3328":130,"_29138":91,"_20209":47800,"_5":13819,"_26493":47696,"_2816":47801},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3328":131,"_29138":91,"_20209":47803,"_5":13819,"_26493":47696,"_2816":47804},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3328":132,"_29138":91,"_20209":47806,"_5":13819,"_26493":47696,"_2816":47807},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3328":133,"_29138":91,"_20209":47809,"_5":13819,"_26493":47696,"_2816":47810},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3328":134,"_29138":91,"_20209":47812,"_5":13819,"_26493":47700,"_2816":47813},[],"Option",{"_3328":135,"_29138":91,"_20209":47815,"_5":13819,"_26493":47700,"_2816":47816},[],"Default",{"_3328":136,"_29138":91,"_20209":47818,"_5":13819,"_26493":47700,"_2816":47819},[],"Purpose",{"_3328":137,"_29138":91,"_20209":47821,"_5":13819,"_26493":47700,"_2816":47822},[],"`-h`, `--help`",{"_3328":138,"_29138":91,"_20209":47824,"_5":13819,"_26493":47700,"_2816":47825},[],"—",{"_3328":139,"_29138":91,"_20209":47827,"_5":13819,"_26493":47700,"_2816":47828},[],"Show help",{"_3328":140,"_29138":91,"_20209":47830,"_5":13819,"_26493":47700,"_2816":47831},[],"`-c`, `--context`",{"_3328":141,"_29138":91,"_20209":47833,"_5":13819,"_26493":47700,"_2816":47834},[],"current context",{"_3328":142,"_29138":91,"_20209":47836,"_5":13819,"_26493":47700,"_2816":47837},[],"Select the kubeconfig context for kubectl and Helm",{"_3328":143,"_29138":91,"_20209":47839,"_5":13819,"_26493":47700,"_2816":47840},[],"`-n`, `--non-interactive`",{"_3328":144,"_29138":91,"_20209":47842,"_5":13819,"_26493":47700,"_2816":6245},[],{"_3328":145,"_29138":91,"_20209":47844,"_5":13819,"_26493":47700,"_2816":47845},[],"Skip prompts and generate dependency credentials",{"_3328":146,"_29138":91,"_20209":47847,"_5":13819,"_26493":47700,"_2816":47848},[],"`-ns`, `--namespace`",{"_3328":147,"_29138":91,"_20209":47850,"_5":13819,"_26493":47700,"_2816":47851},[],"`lamassu-dev`",{"_3328":148,"_29138":91,"_20209":47853,"_5":13819,"_26493":47700,"_2816":47854},[],"Namespace for the installation",{"_3328":149,"_29138":91,"_20209":47856,"_5":13819,"_26493":47700,"_2816":47857},[],"`-d`, `--domain`",{"_3328":150,"_29138":91,"_20209":47859,"_5":13819,"_26493":47700,"_2816":47860},[],"`dev.lamassu.io`",{"_3328":151,"_29138":91,"_20209":47862,"_5":13819,"_26493":47700,"_2816":47863},[],"Domain used by the UI, OIDC and certificate",{"_3328":152,"_29138":91,"_20209":47865,"_5":13819,"_26493":47700,"_2816":47866},[],"`-v`, `--version`",{"_3328":153,"_29138":91,"_20209":47868,"_5":13819,"_26493":47700,"_2816":14491},[],{"_3328":154,"_29138":91,"_20209":47870,"_5":13819,"_26493":47700,"_2816":47871},[],"Lamassu chart version",{"_3328":155,"_29138":91,"_20209":47873,"_5":13819,"_26493":47700,"_2816":47874},[],"`--https-port`",{"_3328":156,"_29138":91,"_20209":47876,"_5":13819,"_26493":47700,"_2816":47877},[],"`443`",{"_3328":157,"_29138":91,"_20209":47879,"_5":13819,"_26493":47700,"_2816":47880},[],"Gateway HTTPS listener port",{"_3328":158,"_29138":91,"_20209":47882,"_5":13819,"_26493":47700,"_2816":47883},[],"`--http-port`",{"_3328":159,"_29138":91,"_20209":47885,"_5":13819,"_26493":47700,"_2816":47886},[],"`80`",{"_3328":160,"_29138":91,"_20209":47888,"_5":13819,"_26493":47700,"_2816":47889},[],"Gateway HTTP listener port",{"_3328":161,"_29138":91,"_20209":47891,"_5":13819,"_26493":47700,"_2816":47892},[],"`--tls-crt`",{"_3328":162,"_29138":91,"_20209":47894,"_5":13819,"_26493":47700,"_2816":47825},[],{"_3328":163,"_29138":91,"_20209":47896,"_5":13819,"_26493":47700,"_2816":47897},[],"PEM certificate for downstream TLS",{"_3328":164,"_29138":91,"_20209":47899,"_5":13819,"_26493":47700,"_2816":47900},[],"`--tls-key`",{"_3328":165,"_29138":91,"_20209":47902,"_5":13819,"_26493":47700,"_2816":47825},[],{"_3328":166,"_29138":91,"_20209":47904,"_5":13819,"_26493":47700,"_2816":47905},[],"PEM private key for downstream TLS",{"_3328":167,"_29138":91,"_20209":47907,"_5":13819,"_26493":47700,"_2816":47908},[],"`-l`, `--local-chart-path`",{"_3328":168,"_29138":91,"_20209":47910,"_5":13819,"_26493":47700,"_2816":47911},[],"repository chart",{"_3328":169,"_29138":91,"_20209":47913,"_5":13819,"_26493":47700,"_2816":47914},[],"Use an unpacked local Lamassu chart",{"_3328":170,"_29138":91,"_20209":47916,"_5":13819,"_26493":47700,"_2816":47917},[],"`-ip`, `--gateway-ip`",{"_3328":171,"_29138":91,"_20209":47919,"_5":13819,"_26493":47700,"_2816":8395},[],{"_3328":172,"_29138":91,"_20209":47921,"_5":13819,"_26493":47700,"_2816":47922},[],"Override the address written to `gateway.addresses`",{"_3328":173,"_29138":91,"_20209":47924,"_5":13819,"_26493":47700,"_2816":47925},[],"`--otel`",{"_3328":174,"_29138":91,"_20209":47927,"_5":13819,"_26493":47700,"_2816":6245},[],{"_3328":175,"_29138":91,"_20209":47929,"_5":13819,"_26493":47700,"_2816":47930},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3328":176,"_29138":91,"_20209":47932,"_5":13819,"_26493":47700,"_2816":47933},[],"`--development`",{"_3328":177,"_29138":91,"_20209":47935,"_5":13819,"_26493":47700,"_2816":6245},[],{"_3328":178,"_29138":91,"_20209":47937,"_5":13819,"_26493":47700,"_2816":47938},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3328":179,"_29138":91,"_20209":47940,"_5":13819,"_26493":47700,"_2816":47941},[],"`--sample-data`",{"_3328":180,"_29138":91,"_20209":47943,"_5":13819,"_26493":47700,"_2816":6245},[],{"_3328":181,"_29138":91,"_20209":47945,"_5":13819,"_26493":47700,"_2816":47946},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3328":182,"_29138":91,"_20209":47948,"_5":13819,"_26493":47700,"_2816":47949},[],"`--with-hsm`",{"_3328":183,"_29138":91,"_20209":47951,"_5":13819,"_26493":47700,"_2816":6245},[],{"_3328":184,"_29138":91,"_20209":47953,"_5":13819,"_26493":47700,"_2816":47954},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3328":185,"_29138":91,"_20209":47956,"_5":13819,"_26493":47700,"_2816":47957},[],"`--softhsm-chart-path`",{"_3328":186,"_29138":91,"_20209":47959,"_5":13819,"_26493":47700,"_2816":47960},[],"`./charts/softhsm`",{"_3328":187,"_29138":91,"_20209":47962,"_5":13819,"_26493":47700,"_2816":47963},[],"Use a different local SoftHSM chart",{"_3328":188,"_29138":91,"_20209":47965,"_5":13819,"_26493":47700,"_2816":47966},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3328":189,"_29138":91,"_20209":47968,"_5":13819,"_26493":47704,"_2816":47969},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3328":190,"_29138":91,"_20209":47971,"_5":13819,"_26493":47704,"_2816":47972},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3328":191,"_29138":91,"_20209":47974,"_5":13819,"_26493":47704,"_2816":47975},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3328":192,"_29138":91,"_20209":47977,"_5":13819,"_26493":47704,"_2816":47978},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3328":193,"_29138":91,"_20209":47980,"_5":13819,"_26493":47704,"_2816":47981},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3328":194,"_29138":91,"_20209":47983,"_5":13819,"_26493":47704,"_2816":47984},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3328":195,"_29138":91,"_20209":47986,"_5":13819,"_26493":47708,"_2816":47987},[],"Fastlane:",{"_3328":196,"_29138":91,"_20209":47989,"_5":13819,"_26493":47708,"_2816":47990},[],"validates local tools and the selected cluster",{"_3328":197,"_29138":91,"_20209":47992,"_5":13819,"_26493":47708,"_2816":47993},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3328":198,"_29138":91,"_20209":47995,"_5":13819,"_26493":47708,"_2816":47996},[],"creates the namespace",{"_3328":199,"_29138":91,"_20209":47998,"_5":13819,"_26493":47708,"_2816":47999},[],"installs PostgreSQL and creates the required databases",{"_3328":200,"_29138":91,"_20209":48001,"_5":13819,"_26493":47708,"_2816":48002},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3328":201,"_29138":91,"_20209":48004,"_5":13819,"_26493":47708,"_2816":48005},[],"installs RabbitMQ",{"_3328":202,"_29138":91,"_20209":48007,"_5":13819,"_26493":47708,"_2816":48008},[],"optionally installs observability and lab HSM components",{"_3328":203,"_29138":91,"_20209":48010,"_5":13819,"_26493":47708,"_2816":48011},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3328":204,"_29138":91,"_20209":48013,"_5":13819,"_26493":47708,"_2816":48014},[],"optionally loads sample data",{"_3328":205,"_29138":91,"_20209":48016,"_5":13819,"_26493":47708,"_2816":48017},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3328":206,"_29138":91,"_20209":48019,"_5":13819,"_26493":47712,"_2816":48020},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3328":207,"_29138":91,"_20209":48022,"_5":13819,"_26493":47712,"_2816":48023},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3328":208,"_29138":91,"_20209":48025,"_5":13819,"_26493":47716,"_2816":48026},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3328":209,"_29138":91,"_20209":48028,"_5":13819,"_26493":47716,"_2816":48029},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3328":210,"_29138":91,"_20209":48031,"_5":13819,"_26493":47716,"_2816":48032},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3328":211,"_29138":91,"_20209":48034,"_5":13819,"_26493":47720,"_2816":48035},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3328":212,"_29138":212,"_5":14177,"_2816":48037,"_29482":48038,"_20209":48039,"_26493":212},"Install with Helm",[47429,47430,47536],[],{"_3328":213,"_29138":212,"_20209":48041,"_5":13819,"_26493":212,"_2816":48042},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3328":214,"_29138":212,"_5":29479,"_20209":48044,"_26493":48045,"_2816":48046},[],"/docs/pr-preview/pr-45/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3328":215,"_29138":212,"_5":29479,"_20209":48048,"_26493":48049,"_2816":47439},[],"/docs/pr-preview/pr-45/deployment/self-hosted/helm#before-you-begin",{"_3328":216,"_29138":212,"_5":29479,"_20209":48051,"_26493":48052,"_2816":48053},[],"/docs/pr-preview/pr-45/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3328":217,"_29138":212,"_5":29479,"_20209":48055,"_26493":48056,"_2816":48057},[],"/docs/pr-preview/pr-45/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3328":218,"_29138":212,"_5":29479,"_20209":48059,"_26493":48060,"_2816":48061},[],"/docs/pr-preview/pr-45/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3328":219,"_29138":212,"_5":29479,"_20209":48063,"_26493":48064,"_2816":48065},[],"/docs/pr-preview/pr-45/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3328":220,"_29138":212,"_5":29479,"_20209":48067,"_26493":48068,"_2816":48069},[],"/docs/pr-preview/pr-45/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3328":221,"_29138":212,"_5":29479,"_20209":48071,"_26493":48072,"_2816":48073},[],"/docs/pr-preview/pr-45/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3328":222,"_29138":212,"_5":29479,"_20209":48075,"_26493":48076,"_2816":48077},[],"/docs/pr-preview/pr-45/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3328":223,"_29138":212,"_5":29479,"_20209":48079,"_26493":48080,"_2816":48081},[],"/docs/pr-preview/pr-45/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3328":224,"_29138":212,"_5":29479,"_20209":48083,"_26493":48084,"_2816":48085},[],"/docs/pr-preview/pr-45/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3328":225,"_29138":212,"_20209":48087,"_5":13819,"_26493":48045,"_2816":48088},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3328":226,"_29138":212,"_20209":48090,"_5":13819,"_26493":48049,"_2816":48091},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3328":227,"_29138":212,"_20209":48093,"_5":13819,"_26493":48049,"_2816":48094},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3328":228,"_29138":212,"_20209":48096,"_5":13819,"_26493":48049,"_2816":48097},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3328":229,"_29138":212,"_20209":48099,"_5":13819,"_26493":48049,"_2816":48100},[],"a reachable RabbitMQ broker and credentials",{"_3328":230,"_29138":212,"_20209":48102,"_5":13819,"_26493":48049,"_2816":48103},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3328":231,"_29138":212,"_20209":48105,"_5":13819,"_26493":48049,"_2816":48106},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3328":232,"_29138":212,"_20209":48108,"_5":13819,"_26493":48049,"_2816":48109},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3328":233,"_29138":212,"_20209":48111,"_5":13819,"_26493":48049,"_2816":48112},[],"a StorageClass and an external traffic design",{"_3328":234,"_29138":212,"_20209":48114,"_5":13819,"_26493":48049,"_2816":48115},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3328":235,"_29138":212,"_20209":48117,"_5":13819,"_26493":48049,"_2816":48118},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3328":236,"_29138":212,"_20209":48120,"_5":13819,"_26493":48049,"_2816":48121},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3328":237,"_29138":212,"_20209":48123,"_5":13819,"_26493":48052,"_2816":48124},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3328":238,"_29138":212,"_20209":48126,"_5":13819,"_26493":48052,"_2816":48127},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3328":239,"_29138":212,"_20209":48129,"_5":13819,"_26493":48052,"_2816":48130},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3328":240,"_29138":212,"_20209":48132,"_5":13819,"_26493":48056,"_2816":48133},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3328":241,"_29138":212,"_20209":48135,"_5":13819,"_26493":48056,"_2816":48136},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3328":242,"_29138":212,"_20209":48138,"_5":13819,"_26493":48056,"_2816":48139},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3328":243,"_29138":212,"_20209":48141,"_5":13819,"_26493":48056,"_2816":48142},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3328":244,"_29138":212,"_20209":48144,"_5":13819,"_26493":48060,"_2816":48145},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3328":245,"_29138":212,"_20209":48147,"_5":13819,"_26493":48064,"_2816":48148},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3328":246,"_29138":212,"_20209":48150,"_5":13819,"_26493":48064,"_2816":48151},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3328":247,"_29138":212,"_20209":48153,"_5":13819,"_26493":48064,"_2816":48154},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3328":248,"_29138":212,"_20209":48156,"_5":13819,"_26493":48064,"_2816":48157},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3328":249,"_29138":212,"_20209":48159,"_5":13819,"_26493":48064,"_2816":48160},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3328":250,"_29138":212,"_20209":48162,"_5":13819,"_26493":48064,"_2816":48163},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3328":251,"_29138":212,"_20209":48165,"_5":13819,"_26493":48064,"_2816":48166},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3328":252,"_29138":212,"_20209":48168,"_5":13819,"_26493":48068,"_2816":48169},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3328":253,"_29138":212,"_20209":48171,"_5":13819,"_26493":48068,"_2816":48172},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3328":254,"_29138":212,"_20209":48174,"_5":13819,"_26493":48068,"_2816":48175},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3328":255,"_29138":212,"_20209":48177,"_5":13819,"_26493":48068,"_2816":48178},[],"See Access control for the principal and policy model.",{"_3328":256,"_29138":212,"_20209":48180,"_5":13819,"_26493":48072,"_2816":48181},[],"To install a local checkout instead:",{"_3328":257,"_29138":212,"_20209":48183,"_5":13819,"_26493":48076,"_2816":48184},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3328":258,"_29138":212,"_20209":48186,"_5":13819,"_26493":48076,"_2816":48187},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3328":259,"_29138":212,"_20209":48189,"_5":13819,"_26493":48080,"_2816":48190},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3328":260,"_29138":212,"_20209":48192,"_5":13819,"_26493":48080,"_2816":48193},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3328":261,"_29138":212,"_20209":48195,"_5":13819,"_26493":48080,"_2816":48196},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3328":262,"_29138":212,"_20209":48198,"_5":13819,"_26493":48080,"_2816":48199},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3328":263,"_29138":212,"_20209":48201,"_5":13819,"_26493":48080,"_2816":48202},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3328":264,"_29138":212,"_20209":48204,"_5":13819,"_26493":48084,"_2816":48205},[],"Before going live, review:",{"_3328":265,"_29138":212,"_20209":48207,"_5":13819,"_26493":48084,"_2816":48208},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3328":266,"_29138":212,"_20209":48210,"_5":13819,"_26493":48084,"_2816":48211},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3328":267,"_29138":212,"_20209":48213,"_5":13819,"_26493":48084,"_2816":48214},[],"shared VA storage before increasing VA replicas",{"_3328":268,"_29138":212,"_20209":48216,"_5":13819,"_26493":48084,"_2816":48217},[],"managed OIDC roles and removal of evaluation credentials",{"_3328":269,"_29138":212,"_20209":48219,"_5":13819,"_26493":48084,"_2816":48220},[],"a trusted TLS issuer or externally managed certificate",{"_3328":270,"_29138":212,"_20209":48222,"_5":13819,"_26493":48084,"_2816":48223},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3328":271,"_29138":212,"_20209":48225,"_5":13819,"_26493":48084,"_2816":48226},[],"SMTP, observability and alert delivery",{"_3328":272,"_29138":212,"_20209":48228,"_5":13819,"_26493":48084,"_2816":48229},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3328":273,"_29138":212,"_20209":48231,"_5":13819,"_26493":48084,"_2816":48232},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3328":274,"_29138":274,"_5":14177,"_2816":48234,"_29482":48235,"_20209":48236,"_26493":274},"Expose the Gateway",[47429,47430,47536],[],{"_3328":275,"_29138":274,"_20209":48238,"_5":13819,"_26493":274,"_2816":48239},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3328":276,"_29138":274,"_5":29479,"_20209":48241,"_26493":48242,"_2816":48243},[],"/docs/pr-preview/pr-45/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3328":277,"_29138":274,"_5":29479,"_20209":48245,"_26493":48246,"_2816":48247},[],"/docs/pr-preview/pr-45/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3328":278,"_29138":274,"_5":29479,"_20209":48249,"_26493":48250,"_2816":48251},[],"/docs/pr-preview/pr-45/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3328":279,"_29138":274,"_5":29479,"_20209":48253,"_26493":48254,"_2816":48255},[],"/docs/pr-preview/pr-45/deployment/self-hosted/networking#k3s","K3s",{"_3328":280,"_29138":274,"_5":29479,"_20209":48257,"_26493":48258,"_2816":48259},[],"/docs/pr-preview/pr-45/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3328":281,"_29138":274,"_5":29479,"_20209":48261,"_26493":48262,"_2816":48263},[],"/docs/pr-preview/pr-45/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3328":282,"_29138":274,"_5":29479,"_20209":48265,"_26493":48266,"_2816":48267},[],"/docs/pr-preview/pr-45/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3328":283,"_29138":274,"_5":29479,"_20209":48269,"_26493":48270,"_2816":48271},[],"/docs/pr-preview/pr-45/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3328":284,"_29138":274,"_5":29479,"_20209":48273,"_26493":48274,"_2816":48275},[],"/docs/pr-preview/pr-45/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3328":285,"_29138":274,"_5":29479,"_20209":48277,"_26493":48278,"_2816":48279},[],"/docs/pr-preview/pr-45/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3328":286,"_29138":274,"_20209":48281,"_5":13819,"_26493":48242,"_2816":48282},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3328":287,"_29138":274,"_20209":48284,"_5":13819,"_26493":48242,"_2816":48285},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3328":288,"_29138":274,"_20209":48287,"_5":13819,"_26493":48246,"_2816":48288},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3328":289,"_29138":274,"_20209":48290,"_5":13819,"_26493":48246,"_2816":48291},[],"Set it only when:",{"_3328":290,"_29138":274,"_20209":48293,"_5":13819,"_26493":48246,"_2816":48294},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3328":291,"_29138":274,"_20209":48296,"_5":13819,"_26493":48246,"_2816":48297},[],"that address is allocated to this Gateway",{"_3328":292,"_29138":274,"_20209":48299,"_5":13819,"_26493":48246,"_2816":48300},[],"the surrounding network already routes traffic for it to the cluster",{"_3328":293,"_29138":274,"_20209":48302,"_5":13819,"_26493":48246,"_2816":48303},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3328":294,"_29138":274,"_20209":48305,"_5":13819,"_26493":48246,"_2816":48306},[],"Keep these two settings separate:",{"_3328":295,"_29138":274,"_20209":48308,"_5":13819,"_26493":48246,"_2816":48309},[],"`gateway.addresses` requests an address for the Gateway.",{"_3328":296,"_29138":274,"_20209":48311,"_5":13819,"_26493":48246,"_2816":48312},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3328":297,"_29138":274,"_20209":48314,"_5":13819,"_26493":48246,"_2816":48315},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3328":298,"_29138":274,"_20209":48317,"_5":13819,"_26493":48250,"_2816":48318},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3328":299,"_29138":274,"_20209":48320,"_5":13819,"_26493":48250,"_2816":48321},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3328":300,"_29138":274,"_20209":48323,"_5":13819,"_26493":48254,"_2816":48324},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3328":301,"_29138":274,"_20209":48326,"_5":13819,"_26493":48254,"_2816":48327},[],"For the recommended design:",{"_3328":302,"_29138":274,"_20209":48329,"_5":13819,"_26493":48254,"_2816":48330},[],"Use only one externally exposed Lamassu Gateway.",{"_3328":303,"_29138":274,"_20209":48332,"_5":13819,"_26493":48254,"_2816":48333},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3328":304,"_29138":274,"_20209":48335,"_5":13819,"_26493":48254,"_2816":48336},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3328":305,"_29138":274,"_20209":48338,"_5":13819,"_26493":48254,"_2816":48339},[],"Point DNS at the VM's reachable address.",{"_3328":306,"_29138":274,"_20209":48341,"_5":13819,"_26493":48254,"_2816":48342},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3328":307,"_29138":274,"_20209":48344,"_5":13819,"_26493":48258,"_2816":48345},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3328":308,"_29138":274,"_20209":48347,"_5":13819,"_26493":48262,"_2816":48348},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3328":309,"_29138":274,"_20209":48350,"_5":13819,"_26493":48262,"_2816":48351},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3328":310,"_29138":274,"_20209":48353,"_5":13819,"_26493":48266,"_2816":48354},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3328":311,"_29138":274,"_20209":48356,"_5":13819,"_26493":48266,"_2816":48357},[],"Requirement",{"_3328":312,"_29138":274,"_20209":48359,"_5":13819,"_26493":48266,"_2816":48360},[],"Recommended design",{"_3328":313,"_29138":274,"_20209":48362,"_5":13819,"_26493":48266,"_2816":48363},[],"Consequence",{"_3328":314,"_29138":274,"_20209":48365,"_5":13819,"_26493":48266,"_2816":48366},[],"Several Lamassu URLs or services",{"_3328":315,"_29138":274,"_20209":48368,"_5":13819,"_26493":48266,"_2816":48369},[],"One Gateway with multiple routes",{"_3328":316,"_29138":274,"_20209":48371,"_5":13819,"_26493":48266,"_2816":48372},[],"One IP and one proxy fleet; this is the chart default",{"_3328":317,"_29138":274,"_20209":48374,"_5":13819,"_26493":48266,"_2816":48375},[],"Independent Gateways and separate external IPs",{"_3328":318,"_29138":274,"_20209":48377,"_5":13819,"_26493":48266,"_2816":48378},[],"One VIP per Gateway",{"_3328":319,"_29138":274,"_20209":48380,"_5":13819,"_26493":48266,"_2816":48381},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3328":320,"_29138":274,"_20209":48383,"_5":13819,"_26493":48266,"_2816":48384},[],"Independent Gateways on one node and one IP",{"_3328":321,"_29138":274,"_20209":48386,"_5":13819,"_26493":48266,"_2816":48387},[],"Use different external ports",{"_3328":322,"_29138":274,"_20209":48389,"_5":13819,"_26493":48266,"_2816":48390},[],"Clients must include non-standard ports",{"_3328":323,"_29138":274,"_20209":48392,"_5":13819,"_26493":48266,"_2816":48393},[],"Separate TLS/mTLS termination behind one IP",{"_3328":324,"_29138":274,"_20209":48395,"_5":13819,"_26493":48266,"_2816":48396},[],"Front-door SNI routing to internal Gateways",{"_3328":325,"_29138":274,"_20209":48398,"_5":13819,"_26493":48266,"_2816":48399},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3328":326,"_29138":274,"_20209":48401,"_5":13819,"_26493":48266,"_2816":48402},[],"Separate Gateway resources but shared proxy infrastructure",{"_3328":327,"_29138":274,"_20209":48404,"_5":13819,"_26493":48266,"_2816":48405},[],"Envoy merged-Gateway mode",{"_3328":328,"_29138":274,"_20209":48407,"_5":13819,"_26493":48266,"_2816":48408},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3328":329,"_29138":274,"_20209":48410,"_5":13819,"_26493":48266,"_2816":48411},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3328":330,"_29138":274,"_20209":48413,"_5":13819,"_26493":48266,"_2816":48414},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3328":331,"_29138":274,"_20209":48416,"_5":13819,"_26493":48266,"_2816":48417},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3328":332,"_29138":274,"_20209":48419,"_5":13819,"_26493":48266,"_2816":48420},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3328":333,"_29138":274,"_20209":48422,"_5":13819,"_26493":48270,"_2816":48423},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3328":334,"_29138":274,"_20209":48425,"_5":13819,"_26493":48270,"_2816":48426},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3328":335,"_29138":274,"_20209":48428,"_5":13819,"_26493":48270,"_2816":48429},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3328":336,"_29138":274,"_20209":48431,"_5":13819,"_26493":48270,"_2816":48432},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3328":337,"_29138":274,"_20209":48434,"_5":13819,"_26493":48270,"_2816":48435},[],"If none of those are possible, use different external ports or change the external network design.",{"_3328":338,"_29138":274,"_20209":48437,"_5":13819,"_26493":48274,"_2816":48438},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3328":339,"_29138":274,"_20209":48440,"_5":13819,"_26493":48274,"_2816":48441},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3328":340,"_29138":274,"_20209":48443,"_5":13819,"_26493":48278,"_2816":48444},[],"Check, in order:",{"_3328":341,"_29138":274,"_20209":48446,"_5":13819,"_26493":48278,"_2816":48447},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3328":342,"_29138":274,"_20209":48449,"_5":13819,"_26493":48278,"_2816":48450},[],"Its status contains the expected address.",{"_3328":343,"_29138":274,"_20209":48452,"_5":13819,"_26493":48278,"_2816":48453},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3328":344,"_29138":274,"_20209":48455,"_5":13819,"_26493":48278,"_2816":48456},[],"Port 443 reaches that address from the client network.",{"_3328":345,"_29138":274,"_20209":48458,"_5":13819,"_26493":48278,"_2816":48459},[],"DNS resolves to the externally reachable endpoint.",{"_3328":346,"_29138":274,"_20209":48461,"_5":13819,"_26493":48278,"_2816":48462},[],"The certificate contains the DNS name or IP used by the client.",{"_3328":347,"_29138":274,"_20209":48464,"_5":13819,"_26493":48278,"_2816":48465},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3328":348,"_29138":348,"_5":14177,"_2816":47536,"_29482":48467,"_20209":48468,"_26493":348},[47429,47430,47536],[],{"_3328":349,"_29138":348,"_20209":48470,"_5":13819,"_26493":348,"_2816":48471},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3328":350,"_29138":348,"_5":29479,"_20209":48473,"_26493":48474,"_2816":48475},[],"/docs/pr-preview/pr-45/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3328":351,"_29138":348,"_5":29479,"_20209":48477,"_26493":48478,"_2816":48479},[],"/docs/pr-preview/pr-45/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3328":352,"_29138":348,"_5":29479,"_20209":48481,"_26493":48482,"_2816":48483},[],"/docs/pr-preview/pr-45/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3328":353,"_29138":348,"_5":29479,"_20209":48485,"_26493":48486,"_2816":48487},[],"/docs/pr-preview/pr-45/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3328":354,"_29138":348,"_5":29479,"_20209":48489,"_26493":48490,"_2816":48491},[],"/docs/pr-preview/pr-45/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3328":355,"_29138":348,"_5":29479,"_20209":48493,"_26493":48494,"_2816":48495},[],"/docs/pr-preview/pr-45/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3328":356,"_29138":348,"_20209":48497,"_5":13819,"_26493":48474,"_2816":48498},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3328":357,"_29138":348,"_20209":48500,"_5":13819,"_26493":48478,"_2816":48501},[],"Workflow",{"_3328":358,"_29138":348,"_20209":48503,"_5":13819,"_26493":48478,"_2816":48504},[],"Use it for",{"_3328":359,"_29138":348,"_20209":48506,"_5":13819,"_26493":48478,"_2816":48507},[],"What it installs",{"_3328":360,"_29138":348,"_20209":48509,"_5":13819,"_26493":48478,"_2816":48510},[],"Helm",{"_3328":361,"_29138":348,"_20209":48512,"_5":13819,"_26493":48478,"_2816":48513},[],"Production and controlled environments",{"_3328":362,"_29138":348,"_20209":48515,"_5":13819,"_26493":48478,"_2816":48516},[],"Lamassu services and Gateway API resources",{"_3328":363,"_29138":348,"_20209":48518,"_5":13819,"_26493":48478,"_2816":47673},[],{"_3328":364,"_29138":348,"_20209":48520,"_5":13819,"_26493":48478,"_2816":48521},[],"Evaluation, demos, CI and small lab clusters",{"_3328":365,"_29138":348,"_20209":48523,"_5":13819,"_26493":48478,"_2816":48524},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3328":366,"_29138":348,"_20209":48526,"_5":13819,"_26493":48482,"_2816":48527},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3328":367,"_29138":348,"_20209":48529,"_5":13819,"_26493":48482,"_2816":48530},[],"Area",{"_3328":368,"_29138":348,"_20209":48532,"_5":13819,"_26493":48482,"_2816":48533},[],"The Lamassu chart provides",{"_3328":369,"_29138":348,"_20209":48535,"_5":13819,"_26493":48482,"_2816":48536},[],"You provide",{"_3328":370,"_29138":348,"_20209":48538,"_5":13819,"_26493":48482,"_2816":48539},[],"Lamassu applications",{"_3328":371,"_29138":348,"_20209":48541,"_5":13819,"_26493":48482,"_2816":48542},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3328":372,"_29138":348,"_20209":48544,"_5":13819,"_26493":48482,"_2816":48545},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3328":373,"_29138":348,"_20209":48547,"_5":13819,"_26493":48482,"_2816":48548},[],"PostgreSQL data",{"_3328":374,"_29138":348,"_20209":48550,"_5":13819,"_26493":48482,"_2816":48551},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3328":375,"_29138":348,"_20209":48553,"_5":13819,"_26493":48482,"_2816":48554},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3328":376,"_29138":348,"_20209":48556,"_5":13819,"_26493":48482,"_2816":48557},[],"Messaging",{"_3328":377,"_29138":348,"_20209":48559,"_5":13819,"_26493":48482,"_2816":48560},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3328":378,"_29138":348,"_20209":48562,"_5":13819,"_26493":48482,"_2816":48563},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3328":379,"_29138":348,"_20209":48565,"_5":13819,"_26493":48482,"_2816":48566},[],"Identity",{"_3328":380,"_29138":348,"_20209":48568,"_5":13819,"_26493":48482,"_2816":48569},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3328":381,"_29138":348,"_20209":48571,"_5":13819,"_26493":48482,"_2816":48572},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3328":382,"_29138":348,"_20209":48574,"_5":13819,"_26493":48482,"_2816":48575},[],"External routing",{"_3328":383,"_29138":348,"_20209":48577,"_5":13819,"_26493":48482,"_2816":48578},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3328":384,"_29138":348,"_20209":48580,"_5":13819,"_26493":48482,"_2816":48581},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3328":385,"_29138":348,"_20209":48583,"_5":13819,"_26493":48482,"_2816":48584},[],"TLS",{"_3328":386,"_29138":348,"_20209":48586,"_5":13819,"_26493":48482,"_2816":48587},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3328":387,"_29138":348,"_20209":48589,"_5":13819,"_26493":48482,"_2816":48590},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3328":388,"_29138":348,"_20209":48592,"_5":13819,"_26493":48482,"_2816":48593},[],"Persistent application data",{"_3328":389,"_29138":348,"_20209":48595,"_5":13819,"_26493":48482,"_2816":48596},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3328":390,"_29138":348,"_20209":48598,"_5":13819,"_26493":48482,"_2816":48599},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3328":391,"_29138":348,"_20209":48601,"_5":13819,"_26493":48482,"_2816":48602},[],"Optional integrations",{"_3328":392,"_29138":348,"_20209":48604,"_5":13819,"_26493":48482,"_2816":48605},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3328":393,"_29138":348,"_20209":48607,"_5":13819,"_26493":48482,"_2816":48608},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3328":394,"_29138":348,"_20209":48610,"_5":13819,"_26493":48482,"_2816":48611},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3328":395,"_29138":348,"_20209":48613,"_5":13819,"_26493":48482,"_2816":48614},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3328":396,"_29138":348,"_20209":48616,"_5":13819,"_26493":48486,"_2816":48617},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3328":397,"_29138":348,"_20209":48619,"_5":13819,"_26493":48486,"_2816":48620},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3328":398,"_29138":348,"_20209":48622,"_5":13819,"_26493":48490,"_2816":48623},[],"Kubernetes 1.24 or newer",{"_3328":399,"_29138":348,"_20209":48625,"_5":13819,"_26493":48490,"_2816":48626},[],"Helm 3.2 or newer",{"_3328":400,"_29138":348,"_20209":48628,"_5":13819,"_26493":48490,"_2816":48629},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3328":401,"_29138":348,"_20209":48631,"_5":13819,"_26493":48490,"_2816":48632},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3328":402,"_29138":348,"_20209":48634,"_5":13819,"_26493":48490,"_2816":48635},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3328":403,"_29138":348,"_20209":48637,"_5":13819,"_26493":48490,"_2816":48638},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3328":404,"_29138":348,"_20209":48640,"_5":13819,"_26493":48490,"_2816":48641},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3328":405,"_29138":348,"_20209":48643,"_5":13819,"_26493":48494,"_2816":48644},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3328":406,"_29138":348,"_20209":48646,"_5":13819,"_26493":48494,"_2816":48647},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3328":407,"_29138":348,"_20209":48649,"_5":13819,"_26493":48494,"_2816":48650},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3328":408,"_29138":348,"_20209":48652,"_5":13819,"_26493":48494,"_2816":48653},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3328":409,"_29138":409,"_5":14177,"_2816":48655,"_29482":48656,"_20209":48658,"_26493":409},"Deployment troubleshooting",[47429,47430,48657],"Operations",[],{"_3328":410,"_29138":409,"_20209":48660,"_5":13819,"_26493":409,"_2816":48661},[],"Diagnose access, service health and infrastructure dependencies.",{"_3328":411,"_29138":409,"_5":29479,"_20209":48663,"_26493":48664,"_2816":48665},[],"/docs/pr-preview/pr-45/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3328":412,"_29138":409,"_5":29479,"_20209":48667,"_26493":48668,"_2816":48669},[],"/docs/pr-preview/pr-45/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3328":413,"_29138":409,"_5":29479,"_20209":48671,"_26493":48672,"_2816":48673},[],"/docs/pr-preview/pr-45/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3328":414,"_29138":409,"_5":29479,"_20209":48675,"_26493":48676,"_2816":48677},[],"/docs/pr-preview/pr-45/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3328":415,"_29138":409,"_5":29479,"_20209":48679,"_26493":48680,"_2816":48681},[],"/docs/pr-preview/pr-45/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3328":416,"_29138":409,"_5":29479,"_20209":48683,"_26493":48684,"_2816":48685},[],"/docs/pr-preview/pr-45/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3328":417,"_29138":409,"_5":29479,"_20209":48687,"_26493":48688,"_2816":48689},[],"/docs/pr-preview/pr-45/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3328":418,"_29138":409,"_5":29479,"_20209":48691,"_26493":48692,"_2816":48693},[],"/docs/pr-preview/pr-45/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3328":419,"_29138":409,"_5":29479,"_20209":48695,"_26493":48696,"_2816":48697},[],"/docs/pr-preview/pr-45/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3328":420,"_29138":409,"_5":29479,"_20209":48699,"_26493":48700,"_2816":48701},[],"/docs/pr-preview/pr-45/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3328":421,"_29138":409,"_5":29479,"_20209":48703,"_26493":48704,"_2816":48705},[],"/docs/pr-preview/pr-45/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3328":422,"_29138":409,"_5":29479,"_20209":48707,"_26493":48708,"_2816":48709},[],"/docs/pr-preview/pr-45/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3328":423,"_29138":409,"_5":29479,"_20209":48711,"_26493":48712,"_2816":48713},[],"/docs/pr-preview/pr-45/deployment/troubleshooting#observability","Observability",{"_3328":424,"_29138":409,"_20209":48715,"_5":13819,"_26493":409,"_2816":48716},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3328":425,"_29138":409,"_20209":48718,"_5":13819,"_26493":48668,"_2816":48719},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3328":426,"_29138":409,"_20209":48721,"_5":13819,"_26493":48672,"_2816":48722},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3328":427,"_29138":409,"_20209":48724,"_5":13819,"_26493":48676,"_2816":48725},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3328":428,"_29138":409,"_20209":48727,"_5":13819,"_26493":48680,"_2816":48728},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3328":429,"_29138":409,"_20209":48730,"_5":13819,"_26493":48684,"_2816":48731},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3328":430,"_29138":409,"_20209":48733,"_5":13819,"_26493":48688,"_2816":48734},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3328":431,"_29138":409,"_20209":48736,"_5":13819,"_26493":48688,"_2816":48737},[],"Also run the chart's connectivity test:",{"_3328":432,"_29138":409,"_20209":48739,"_5":13819,"_26493":48688,"_2816":48740},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3328":433,"_29138":409,"_20209":48742,"_5":13819,"_26493":48688,"_2816":48743},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3328":434,"_29138":409,"_20209":48745,"_5":13819,"_26493":48692,"_2816":48746},[],"If you receive a 401:",{"_3328":435,"_29138":409,"_20209":48748,"_5":13819,"_26493":48692,"_2816":48749},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3328":436,"_29138":409,"_20209":48751,"_5":13819,"_26493":48692,"_2816":48752},[],"verify issuer, audience and expiration of the token;",{"_3328":437,"_29138":409,"_20209":48754,"_5":13819,"_26493":48692,"_2816":48755},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3328":438,"_29138":409,"_20209":48757,"_5":13819,"_26493":48692,"_2816":48758},[],"check that the provider's public and internal routes point to the same realm.",{"_3328":439,"_29138":409,"_20209":48760,"_5":13819,"_26493":48692,"_2816":48761},[],"If login succeeds but the APIs return 403:",{"_3328":440,"_29138":409,"_20209":48763,"_5":13819,"_26493":48692,"_2816":48764},[],"inspect the token's real claims;",{"_3328":441,"_29138":409,"_20209":48766,"_5":13819,"_26493":48692,"_2816":48767},[],"confirm they match an active principal;",{"_3328":442,"_29138":409,"_20209":48769,"_5":13819,"_26493":48692,"_2816":48770},[],"review the policies granted to that principal;",{"_3328":443,"_29138":409,"_20209":48772,"_5":13819,"_26493":48692,"_2816":48773},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3328":444,"_29138":409,"_20209":48775,"_5":13819,"_26493":48692,"_2816":48776},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3328":445,"_29138":409,"_20209":48778,"_5":13819,"_26493":48696,"_2816":48779},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3328":446,"_29138":409,"_20209":48781,"_5":13819,"_26493":48696,"_2816":48782},[],"Locate the authz pod and Service.",{"_3328":447,"_29138":409,"_20209":48784,"_5":13819,"_26493":48696,"_2816":48785},[],"Check /health, logs and its database connection.",{"_3328":448,"_29138":409,"_20209":48787,"_5":13819,"_26493":48696,"_2816":48788},[],"Verify the DNS and port configured in externalAuthorization.",{"_3328":449,"_29138":409,"_20209":48790,"_5":13819,"_26493":48696,"_2816":48791},[],"Check the check route is /v1/ext\\_authz/check.",{"_3328":450,"_29138":409,"_20209":48793,"_5":13819,"_26493":48696,"_2816":48794},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3328":451,"_29138":409,"_20209":48796,"_5":13819,"_26493":48700,"_2816":48797},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3328":452,"_29138":409,"_20209":48799,"_5":13819,"_26493":48704,"_2816":48800},[],"Review kubectl describe pod first. Common causes are:",{"_3328":453,"_29138":409,"_20209":48802,"_5":13819,"_26493":48704,"_2816":48803},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3328":454,"_29138":409,"_20209":48805,"_5":13819,"_26493":48704,"_2816":48806},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3328":455,"_29138":409,"_20209":48808,"_5":13819,"_26493":48704,"_2816":48809},[],"unbound persistent volume;",{"_3328":456,"_29138":409,"_20209":48811,"_5":13819,"_26493":48704,"_2816":48812},[],"inaccessible image or incorrect pull policy;",{"_3328":457,"_29138":409,"_20209":48814,"_5":13819,"_26493":48704,"_2816":48815},[],"invalid cryptographic engine configuration;",{"_3328":458,"_29138":409,"_20209":48817,"_5":13819,"_26493":48704,"_2816":48818},[],"CPU or memory limits set too low;",{"_3328":459,"_29138":409,"_20209":48820,"_5":13819,"_26493":48704,"_2816":48821},[],"an incomplete prior migration.",{"_3328":460,"_29138":409,"_20209":48823,"_5":13819,"_26493":48704,"_2816":48824},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3328":461,"_29138":409,"_20209":48826,"_5":13819,"_26493":48704,"_2816":48827},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3328":462,"_29138":409,"_20209":48829,"_5":13819,"_26493":48704,"_2816":48830},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3328":463,"_29138":409,"_20209":48832,"_5":13819,"_26493":48708,"_2816":48833},[],"Domain and audit events depend on the bus publisher:",{"_3328":464,"_29138":409,"_20209":48835,"_5":13819,"_26493":48708,"_2816":48836},[],"verify it is enabled in the emitting service;",{"_3328":465,"_29138":409,"_20209":48838,"_5":13819,"_26493":48708,"_2816":48839},[],"check AMQP connectivity and credentials;",{"_3328":466,"_29138":409,"_20209":48841,"_5":13819,"_26493":48708,"_2816":48842},[],"review exchange, routing key, queues and consumers;",{"_3328":467,"_29138":409,"_20209":48844,"_5":13819,"_26493":48708,"_2816":48845},[],"inspect dead-letter queues;",{"_3328":468,"_29138":409,"_20209":48847,"_5":13819,"_26493":48708,"_2816":48848},[],"alert on orphan durable queues and backlog growth.",{"_3328":469,"_29138":409,"_20209":48850,"_5":13819,"_26493":48708,"_2816":48851},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3328":470,"_29138":409,"_20209":48853,"_5":13819,"_26493":48708,"_2816":48854},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3328":471,"_29138":409,"_20209":48856,"_5":13819,"_26493":48708,"_2816":48857},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3328":472,"_29138":409,"_20209":48859,"_5":13819,"_26493":48708,"_2816":48860},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3328":473,"_29138":409,"_20209":48862,"_5":13819,"_26493":48708,"_2816":48863},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3328":474,"_29138":409,"_20209":48865,"_5":13819,"_26493":48708,"_2816":48866},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3328":475,"_29138":409,"_20209":48868,"_5":13819,"_26493":48708,"_2816":48869},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3328":476,"_29138":409,"_20209":48871,"_5":13819,"_26493":48712,"_2816":48872},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3328":477,"_29138":409,"_20209":48874,"_5":13819,"_26493":48712,"_2816":48875},[],"Before closing an incident, record:",{"_3328":478,"_29138":409,"_20209":48877,"_5":13819,"_26493":48712,"_2816":48878},[],"the confirmed cause;",{"_3328":479,"_29138":409,"_20209":48880,"_5":13819,"_26493":48712,"_2816":48881},[],"the time scope and affected resources;",{"_3328":480,"_29138":409,"_20209":48883,"_5":13819,"_26493":48712,"_2816":48884},[],"the commands or queries used;",{"_3328":481,"_29138":409,"_20209":48886,"_5":13819,"_26493":48712,"_2816":48887},[],"the applied change and how to revert it;",{"_3328":482,"_29138":409,"_20209":48889,"_5":13819,"_26493":48712,"_2816":48890},[],"validation from a consumer;",{"_3328":483,"_29138":409,"_20209":48892,"_5":13819,"_26493":48712,"_2816":48893},[],"the preventive action and its owner.",{"_3328":484,"_29138":484,"_5":14177,"_2816":48895,"_29482":48896,"_20209":48899,"_26493":484},"Access control",[47429,48897,48898],"Platform","Administration",[],{"_3328":485,"_29138":484,"_20209":48901,"_5":13819,"_26493":484,"_2816":48902},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3328":486,"_29138":484,"_5":29479,"_20209":48904,"_26493":48905,"_2816":48906},[],"/docs/pr-preview/pr-45/platform/administration/access-control#essential-concepts","Essential concepts",{"_3328":487,"_29138":484,"_5":29479,"_20209":48908,"_26493":48909,"_2816":48910},[],"/docs/pr-preview/pr-45/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3328":488,"_29138":484,"_5":29479,"_20209":48912,"_26493":48913,"_2816":48914},[],"/docs/pr-preview/pr-45/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3328":489,"_29138":484,"_5":29479,"_20209":48916,"_26493":48917,"_2816":48918},[],"/docs/pr-preview/pr-45/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3328":490,"_29138":484,"_5":29479,"_20209":48920,"_26493":48921,"_2816":48922},[],"/docs/pr-preview/pr-45/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3328":491,"_29138":484,"_5":29479,"_20209":48924,"_26493":48925,"_2816":48926},[],"/docs/pr-preview/pr-45/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3328":492,"_29138":484,"_5":29479,"_20209":48928,"_26493":48929,"_2816":48930},[],"/docs/pr-preview/pr-45/platform/administration/access-control#oidc-principals","OIDC principals",{"_3328":493,"_29138":484,"_5":29479,"_20209":48932,"_26493":48933,"_2816":48934},[],"/docs/pr-preview/pr-45/platform/administration/access-control#x509-principals","X.509 principals",{"_3328":494,"_29138":484,"_5":29479,"_20209":48936,"_26493":48937,"_2816":48938},[],"/docs/pr-preview/pr-45/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3328":495,"_29138":484,"_5":29479,"_20209":48940,"_26493":48941,"_2816":48942},[],"/docs/pr-preview/pr-45/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3328":496,"_29138":484,"_5":29479,"_20209":48944,"_26493":48945,"_2816":48946},[],"/docs/pr-preview/pr-45/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3328":497,"_29138":484,"_5":29479,"_20209":48948,"_26493":48949,"_2816":48950},[],"/docs/pr-preview/pr-45/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3328":498,"_29138":484,"_5":29479,"_20209":48952,"_26493":48953,"_2816":48954},[],"/docs/pr-preview/pr-45/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3328":499,"_29138":484,"_5":29479,"_20209":48956,"_26493":48957,"_2816":48958},[],"/docs/pr-preview/pr-45/platform/administration/access-control#http-rules","HTTP rules",{"_3328":500,"_29138":484,"_5":29479,"_20209":48960,"_26493":48961,"_2816":48962},[],"/docs/pr-preview/pr-45/platform/administration/access-control#included-policies","Included policies",{"_3328":501,"_29138":484,"_5":29479,"_20209":48964,"_26493":48965,"_2816":48069},[],"/docs/pr-preview/pr-45/platform/administration/access-control#provision-the-first-administrator",{"_3328":502,"_29138":484,"_5":29479,"_20209":48967,"_26493":48968,"_2816":48969},[],"/docs/pr-preview/pr-45/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3328":503,"_29138":484,"_5":29479,"_20209":48971,"_26493":48972,"_2816":48973},[],"/docs/pr-preview/pr-45/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3328":504,"_29138":484,"_5":29479,"_20209":48975,"_26493":48976,"_2816":48977},[],"/docs/pr-preview/pr-45/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3328":505,"_29138":484,"_5":29479,"_20209":48979,"_26493":48980,"_2816":48981},[],"/docs/pr-preview/pr-45/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3328":506,"_29138":484,"_5":29479,"_20209":48983,"_26493":48984,"_2816":48985},[],"/docs/pr-preview/pr-45/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3328":507,"_29138":484,"_5":29479,"_20209":48987,"_26493":48988,"_2816":48989},[],"/docs/pr-preview/pr-45/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3328":508,"_29138":484,"_5":29479,"_20209":48991,"_26493":48992,"_2816":48993},[],"/docs/pr-preview/pr-45/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3328":509,"_29138":484,"_5":29479,"_20209":48995,"_26493":48996,"_2816":48997},[],"/docs/pr-preview/pr-45/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3328":510,"_29138":484,"_5":29479,"_20209":48999,"_26493":49000,"_2816":49001},[],"/docs/pr-preview/pr-45/platform/administration/access-control#operational-checklist","Operational checklist",{"_3328":511,"_29138":484,"_5":29479,"_20209":49003,"_26493":49004,"_2816":49005},[],"/docs/pr-preview/pr-45/platform/administration/access-control#diagnostics","Diagnostics",{"_3328":512,"_29138":484,"_5":29479,"_20209":49007,"_26493":49008,"_2816":49009},[],"/docs/pr-preview/pr-45/platform/administration/access-control#the-response-is-401","The response is 401",{"_3328":513,"_29138":484,"_5":29479,"_20209":49011,"_26493":49012,"_2816":49013},[],"/docs/pr-preview/pr-45/platform/administration/access-control#the-response-is-403","The response is 403",{"_3328":514,"_29138":484,"_5":29479,"_20209":49015,"_26493":49016,"_2816":49017},[],"/docs/pr-preview/pr-45/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3328":515,"_29138":484,"_5":29479,"_20209":49019,"_26493":49020,"_2816":49021},[],"/docs/pr-preview/pr-45/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3328":516,"_29138":484,"_5":29479,"_20209":49023,"_26493":49024,"_2816":49025},[],"/docs/pr-preview/pr-45/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3328":517,"_29138":484,"_20209":49027,"_5":13819,"_26493":484,"_2816":49028},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3328":518,"_29138":484,"_20209":49030,"_5":13819,"_26493":484,"_2816":49031},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3328":519,"_29138":484,"_20209":49033,"_5":13819,"_26493":484,"_2816":49034},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3328":520,"_29138":484,"_20209":49036,"_5":13819,"_26493":48905,"_2816":49037},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3328":521,"_29138":484,"_20209":49039,"_5":13819,"_26493":48905,"_2816":49040},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3328":522,"_29138":484,"_20209":49042,"_5":13819,"_26493":48905,"_2816":49043},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3328":523,"_29138":484,"_20209":49045,"_5":13819,"_26493":48905,"_2816":49046},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3328":524,"_29138":484,"_20209":49048,"_5":13819,"_26493":48905,"_2816":49049},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3328":525,"_29138":484,"_20209":49051,"_5":13819,"_26493":48905,"_2816":49052},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3328":526,"_29138":484,"_20209":49054,"_5":13819,"_26493":48909,"_2816":49055},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3328":527,"_29138":484,"_20209":49057,"_5":13819,"_26493":48909,"_2816":49058},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3328":528,"_29138":484,"_20209":49060,"_5":13819,"_26493":48913,"_2816":49061},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3328":529,"_29138":484,"_20209":49063,"_5":13819,"_26493":48913,"_2816":49064},[],"The decision is made **before forwarding the request to the service**:",{"_3328":530,"_29138":484,"_20209":49066,"_5":13819,"_26493":48913,"_2816":49067},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3328":531,"_29138":484,"_20209":49069,"_5":13819,"_26493":48913,"_2816":49070},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3328":532,"_29138":484,"_20209":49072,"_5":13819,"_26493":48913,"_2816":49073},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3328":533,"_29138":484,"_20209":49075,"_5":13819,"_26493":48913,"_2816":49076},[],"It separately loads the policies granted to each principal.",{"_3328":534,"_29138":484,"_20209":49078,"_5":13819,"_26493":48913,"_2816":49079},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3328":535,"_29138":484,"_20209":49081,"_5":13819,"_26493":48913,"_2816":49082},[],"`authz` looks for an HTTP rule granting that action.",{"_3328":536,"_29138":484,"_20209":49084,"_5":13819,"_26493":48913,"_2816":49085},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3328":537,"_29138":484,"_20209":49087,"_5":13819,"_26493":48913,"_2816":49088},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3328":538,"_29138":484,"_20209":49090,"_5":13819,"_26493":48913,"_2816":49091},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3328":539,"_29138":484,"_20209":49093,"_5":13819,"_26493":48913,"_2816":49094},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3328":540,"_29138":484,"_20209":49096,"_5":13819,"_26493":48917,"_2816":49097},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3328":541,"_29138":484,"_20209":49099,"_5":13819,"_26493":48917,"_2816":49100},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3328":542,"_29138":484,"_20209":49102,"_5":13819,"_26493":48917,"_2816":49103},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3328":543,"_29138":484,"_20209":49105,"_5":13819,"_26493":48917,"_2816":49106},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3328":544,"_29138":484,"_20209":49108,"_5":13819,"_26493":48917,"_2816":49109},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3328":545,"_29138":484,"_20209":49111,"_5":13819,"_26493":48917,"_2816":49112},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3328":546,"_29138":484,"_20209":49114,"_5":13819,"_26493":48917,"_2816":49115},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3328":547,"_29138":484,"_20209":49117,"_5":13819,"_26493":48917,"_2816":49118},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3328":548,"_29138":484,"_20209":49120,"_5":13819,"_26493":48921,"_2816":49121},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3328":549,"_29138":484,"_20209":49123,"_5":13819,"_26493":48921,"_2816":49124},[],"The decision is made with the domain operation context:",{"_3328":550,"_29138":484,"_20209":49126,"_5":13819,"_26493":48921,"_2816":49127},[],"The middleware extracts the credential and resolves the matching principals.",{"_3328":551,"_29138":484,"_20209":49129,"_5":13819,"_26493":48921,"_2816":49130},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3328":552,"_29138":484,"_20209":49132,"_5":13819,"_26493":48921,"_2816":49133},[],"`authz` gathers the entity rules of the granted policies.",{"_3328":553,"_29138":484,"_20209":49135,"_5":13819,"_26493":48921,"_2816":49136},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3328":554,"_29138":484,"_20209":49138,"_5":13819,"_26493":48921,"_2816":49139},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3328":555,"_29138":484,"_20209":49141,"_5":13819,"_26493":48921,"_2816":49142},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3328":556,"_29138":484,"_20209":49144,"_5":13819,"_26493":48921,"_2816":49145},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3328":557,"_29138":484,"_20209":49147,"_5":13819,"_26493":48921,"_2816":49148},[],"Actions fall into two groups:",{"_3328":558,"_29138":484,"_20209":49150,"_5":13819,"_26493":48921,"_2816":49151},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3328":559,"_29138":484,"_20209":49153,"_5":13819,"_26493":48921,"_2816":49154},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3328":560,"_29138":484,"_20209":49156,"_5":13819,"_26493":48921,"_2816":49157},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3328":561,"_29138":484,"_20209":49159,"_5":13819,"_26493":48925,"_2816":49160},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3328":562,"_29138":484,"_20209":49162,"_5":13819,"_26493":48925,"_2816":49163},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3328":563,"_29138":484,"_20209":49165,"_5":13819,"_26493":48925,"_2816":49166},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3328":564,"_29138":484,"_20209":49168,"_5":13819,"_26493":48929,"_2816":49169},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3328":565,"_29138":484,"_20209":49171,"_5":13819,"_26493":48929,"_2816":49172},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3328":566,"_29138":484,"_20209":49174,"_5":13819,"_26493":48929,"_2816":49175},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3328":567,"_29138":484,"_20209":49177,"_5":13819,"_26493":48929,"_2816":49178},[],"The implemented operators are:",{"_3328":568,"_29138":484,"_20209":49180,"_5":13819,"_26493":48929,"_2816":49181},[],"`equals`, for exact equality;",{"_3328":569,"_29138":484,"_20209":49183,"_5":13819,"_26493":48929,"_2816":49184},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3328":570,"_29138":484,"_20209":49186,"_5":13819,"_26493":48929,"_2816":49187},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3328":571,"_29138":484,"_20209":49189,"_5":13819,"_26493":48929,"_2816":49190},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3328":572,"_29138":484,"_20209":49192,"_5":13819,"_26493":48933,"_2816":49193},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3328":573,"_29138":484,"_20209":49195,"_5":13819,"_26493":48933,"_2816":49196},[],"The available modes are:",{"_3328":574,"_29138":484,"_20209":49198,"_5":13819,"_26493":48933,"_2816":49199},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3328":575,"_29138":484,"_20209":49201,"_5":13819,"_26493":48933,"_2816":49202},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3328":576,"_29138":484,"_20209":49204,"_5":13819,"_26493":48933,"_2816":49205},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3328":577,"_29138":484,"_20209":49207,"_5":13819,"_26493":48933,"_2816":49208},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3328":578,"_29138":484,"_20209":49210,"_5":13819,"_26493":48933,"_2816":49211},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3328":579,"_29138":484,"_20209":49213,"_5":13819,"_26493":48933,"_2816":49214},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3328":580,"_29138":484,"_20209":49216,"_5":13819,"_26493":48937,"_2816":49217},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3328":581,"_29138":484,"_20209":49219,"_5":13819,"_26493":48937,"_2816":49220},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3328":582,"_29138":484,"_20209":49222,"_5":13819,"_26493":48937,"_2816":49223},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3328":583,"_29138":484,"_20209":49225,"_5":13819,"_26493":48937,"_2816":49226},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3328":584,"_29138":484,"_20209":49228,"_5":13819,"_26493":48945,"_2816":49229},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3328":585,"_29138":484,"_20209":49231,"_5":13819,"_26493":48945,"_2816":49232},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3328":586,"_29138":484,"_20209":49234,"_5":13819,"_26493":48949,"_2816":49235},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3328":587,"_29138":484,"_20209":49237,"_5":13819,"_26493":48949,"_2816":49238},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3328":588,"_29138":484,"_20209":49240,"_5":13819,"_26493":48953,"_2816":49241},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3328":589,"_29138":484,"_20209":49243,"_5":13819,"_26493":48953,"_2816":49244},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3328":590,"_29138":484,"_20209":49246,"_5":13819,"_26493":48953,"_2816":49247},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3328":591,"_29138":484,"_20209":49249,"_5":13819,"_26493":48957,"_2816":49250},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3328":592,"_29138":484,"_20209":49252,"_5":13819,"_26493":48957,"_2816":49253},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3328":593,"_29138":484,"_20209":49255,"_5":13819,"_26493":48957,"_2816":49256},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3328":594,"_29138":484,"_20209":49258,"_5":13819,"_26493":48957,"_2816":49259},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3328":595,"_29138":484,"_20209":49261,"_5":13819,"_26493":48957,"_2816":49262},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3328":596,"_29138":484,"_20209":49264,"_5":13819,"_26493":48957,"_2816":49265},[],"Note that:",{"_3328":597,"_29138":484,"_20209":49267,"_5":13819,"_26493":48957,"_2816":49268},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3328":598,"_29138":484,"_20209":49270,"_5":13819,"_26493":48957,"_2816":49271},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3328":599,"_29138":484,"_20209":49273,"_5":13819,"_26493":48957,"_2816":49274},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3328":600,"_29138":484,"_20209":49276,"_5":13819,"_26493":48961,"_2816":49277},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3328":601,"_29138":484,"_20209":49279,"_5":13819,"_26493":48961,"_2816":49280},[],"full and read-only access to certificates and authorities;",{"_3328":602,"_29138":484,"_20209":49282,"_5":13819,"_26493":48961,"_2816":49283},[],"full and read-only access to the KMS;",{"_3328":603,"_29138":484,"_20209":49285,"_5":13819,"_26493":48961,"_2816":49286},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3328":604,"_29138":484,"_20209":49288,"_5":13819,"_26493":48961,"_2816":49289},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3328":605,"_29138":484,"_20209":49291,"_5":13819,"_26493":48961,"_2816":49292},[],"console access;",{"_3328":606,"_29138":484,"_20209":49294,"_5":13819,"_26493":48961,"_2816":49295},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3328":607,"_29138":484,"_20209":49297,"_5":13819,"_26493":48961,"_2816":49298},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3328":608,"_29138":484,"_20209":49300,"_5":13819,"_26493":48961,"_2816":49301},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3328":609,"_29138":484,"_20209":49303,"_5":13819,"_26493":48965,"_2816":49304},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3328":610,"_29138":484,"_20209":49306,"_5":13819,"_26493":48965,"_2816":49307},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3328":611,"_29138":484,"_20209":49309,"_5":13819,"_26493":48965,"_2816":49310},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3328":612,"_29138":484,"_20209":49312,"_5":13819,"_26493":48968,"_2816":49313},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3328":613,"_29138":484,"_20209":49315,"_5":13819,"_26493":48972,"_2816":49316},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3328":614,"_29138":484,"_20209":49318,"_5":13819,"_26493":48972,"_2816":49319},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3328":615,"_29138":484,"_20209":49321,"_5":13819,"_26493":48976,"_2816":49322},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3328":616,"_29138":484,"_20209":49324,"_5":13819,"_26493":48980,"_2816":49325},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3328":617,"_29138":484,"_20209":49327,"_5":13819,"_26493":48984,"_2816":49328},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3328":618,"_29138":484,"_20209":49330,"_5":13819,"_26493":48988,"_2816":49331},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3328":619,"_29138":484,"_20209":49333,"_5":13819,"_26493":48988,"_2816":49334},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3328":620,"_29138":484,"_20209":49336,"_5":13819,"_26493":48992,"_2816":49337},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3328":621,"_29138":484,"_20209":49339,"_5":13819,"_26493":48992,"_2816":49340},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3328":622,"_29138":484,"_20209":49342,"_5":13819,"_26493":48992,"_2816":49343},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3328":623,"_29138":484,"_20209":49345,"_5":13819,"_26493":48992,"_2816":49346},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3328":624,"_29138":484,"_20209":49348,"_5":13819,"_26493":48992,"_2816":49349},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3328":625,"_29138":484,"_20209":49351,"_5":13819,"_26493":48992,"_2816":49352},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3328":626,"_29138":484,"_20209":49354,"_5":13819,"_26493":48992,"_2816":49355},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3328":627,"_29138":484,"_20209":49357,"_5":13819,"_26493":48992,"_2816":49358},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3328":628,"_29138":484,"_20209":49360,"_5":13819,"_26493":48996,"_2816":49361},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3328":629,"_29138":484,"_20209":49363,"_5":13819,"_26493":48996,"_2816":49364},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3328":630,"_29138":484,"_20209":49366,"_5":13819,"_26493":48996,"_2816":49367},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3328":631,"_29138":484,"_20209":49369,"_5":13819,"_26493":49000,"_2816":49370},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3328":632,"_29138":484,"_20209":49372,"_5":13819,"_26493":49000,"_2816":49373},[],"Use groups or stable roles for people and independent identities for automations.",{"_3328":633,"_29138":484,"_20209":49375,"_5":13819,"_26493":49000,"_2816":49376},[],"Keep at least two recovery administrators and test their access periodically.",{"_3328":634,"_29138":484,"_20209":49378,"_5":13819,"_26493":49000,"_2816":49379},[],"Review active principals, their matches and their grants after IdP changes.",{"_3328":635,"_29138":484,"_20209":49381,"_5":13819,"_26493":49000,"_2816":49382},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3328":636,"_29138":484,"_20209":49384,"_5":13819,"_26493":49000,"_2816":49385},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3328":637,"_29138":484,"_20209":49387,"_5":13819,"_26493":49000,"_2816":49388},[],"Always test one allowed and one denied operation for each role.",{"_3328":638,"_29138":484,"_20209":49390,"_5":13819,"_26493":49000,"_2816":49391},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3328":639,"_29138":484,"_20209":49393,"_5":13819,"_26493":49008,"_2816":49394},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3328":640,"_29138":484,"_20209":49396,"_5":13819,"_26493":49012,"_2816":49397},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3328":641,"_29138":484,"_20209":49399,"_5":13819,"_26493":49012,"_2816":49400},[],"that an active principal of the correct type exists;",{"_3328":642,"_29138":484,"_20209":49402,"_5":13819,"_26493":49012,"_2816":49403},[],"that the claim paths and values match the real token exactly;",{"_3328":643,"_29138":484,"_20209":49405,"_5":13819,"_26493":49012,"_2816":49406},[],"that all of the principal's conditions hold;",{"_3328":644,"_29138":484,"_20209":49408,"_5":13819,"_26493":49012,"_2816":49409},[],"that the principal has the expected policy granted;",{"_3328":645,"_29138":484,"_20209":49411,"_5":13819,"_26493":49012,"_2816":49412},[],"that the policy includes the action and the requested resource type or route;",{"_3328":646,"_29138":484,"_20209":49414,"_5":13819,"_26493":49012,"_2816":49415},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3328":647,"_29138":484,"_20209":49417,"_5":13819,"_26493":49012,"_2816":49418},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3328":648,"_29138":484,"_20209":49420,"_5":13819,"_26493":49016,"_2816":49421},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3328":649,"_29138":484,"_20209":49423,"_5":13819,"_26493":49020,"_2816":49424},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3328":650,"_29138":484,"_20209":49426,"_5":13819,"_26493":49024,"_2816":49427},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3328":651,"_29138":484,"_20209":49429,"_5":13819,"_26493":49024,"_2816":49430},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3328":652,"_29138":652,"_5":14177,"_2816":49432,"_29482":49433,"_20209":49434,"_26493":652},"Alerts and subscriptions",[47429,48897,48898],[],{"_3328":653,"_29138":652,"_20209":49436,"_5":13819,"_26493":652,"_2816":49437},[],"Send PKI events to people and external systems.",{"_3328":654,"_29138":652,"_5":29479,"_20209":49439,"_26493":49440,"_2816":49441},[],"/docs/pr-preview/pr-45/platform/administration/alerts#how-it-works","How it works",{"_3328":655,"_29138":652,"_5":29479,"_20209":49443,"_26493":49444,"_2816":49445},[],"/docs/pr-preview/pr-45/platform/administration/alerts#available-channels","Available channels",{"_3328":656,"_29138":652,"_5":29479,"_20209":49447,"_26493":49448,"_2816":49449},[],"/docs/pr-preview/pr-45/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3328":657,"_29138":652,"_5":29479,"_20209":49451,"_26493":49452,"_2816":49453},[],"/docs/pr-preview/pr-45/platform/administration/alerts#choose-the-event","Choose the event",{"_3328":658,"_29138":652,"_5":29479,"_20209":49455,"_26493":49456,"_2816":49457},[],"/docs/pr-preview/pr-45/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3328":659,"_29138":652,"_5":29479,"_20209":49459,"_26493":49460,"_2816":49461},[],"/docs/pr-preview/pr-45/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3328":660,"_29138":652,"_5":29479,"_20209":49463,"_26493":49464,"_2816":49465},[],"/docs/pr-preview/pr-45/platform/administration/alerts#review-and-activate","Review and activate",{"_3328":661,"_29138":652,"_5":29479,"_20209":49467,"_26493":49468,"_2816":49469},[],"/docs/pr-preview/pr-45/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3328":662,"_29138":652,"_5":29479,"_20209":49471,"_26493":49472,"_2816":49473},[],"/docs/pr-preview/pr-45/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3328":663,"_29138":652,"_5":29479,"_20209":49475,"_26493":49476,"_2816":49477},[],"/docs/pr-preview/pr-45/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3328":664,"_29138":652,"_5":29479,"_20209":49479,"_26493":49480,"_2816":49481},[],"/docs/pr-preview/pr-45/platform/administration/alerts#event-families","Event families",{"_3328":665,"_29138":652,"_20209":49483,"_5":13819,"_26493":652,"_2816":49484},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3328":666,"_29138":652,"_20209":49486,"_5":13819,"_26493":49440,"_2816":49487},[],"A service publishes a domain event.",{"_3328":667,"_29138":652,"_20209":49489,"_5":13819,"_26493":49440,"_2816":49490},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3328":668,"_29138":652,"_20209":49492,"_5":13819,"_26493":49440,"_2816":49493},[],"Each subscription's filter decides whether it should be notified.",{"_3328":669,"_29138":652,"_20209":49495,"_5":13819,"_26493":49440,"_2816":49496},[],"Lamassu delivers the event to the configured channel.",{"_3328":670,"_29138":652,"_20209":49498,"_5":13819,"_26493":49440,"_2816":49499},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3328":671,"_29138":652,"_20209":49501,"_5":13819,"_26493":49444,"_2816":49502},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3328":672,"_29138":652,"_20209":49504,"_5":13819,"_26493":49444,"_2816":49505},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3328":673,"_29138":652,"_20209":49507,"_5":13819,"_26493":49444,"_2816":49508},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3328":674,"_29138":652,"_20209":49510,"_5":13819,"_26493":49444,"_2816":49511},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3328":675,"_29138":652,"_20209":49513,"_5":13819,"_26493":49444,"_2816":49514},[],"`apikey_options` requires `header` and `key`.",{"_3328":676,"_29138":652,"_20209":49516,"_5":13819,"_26493":49444,"_2816":49517},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3328":677,"_29138":652,"_20209":49519,"_5":13819,"_26493":49444,"_2816":49520},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3328":678,"_29138":652,"_20209":49522,"_5":13819,"_26493":49444,"_2816":49523},[],"The alerts API reference documents the full `http_client` schema.",{"_3328":679,"_29138":652,"_20209":49525,"_5":13819,"_26493":49452,"_2816":49526},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3328":680,"_29138":652,"_20209":49528,"_5":13819,"_26493":49456,"_2816":49529},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3328":681,"_29138":652,"_20209":49531,"_5":13819,"_26493":49460,"_2816":49532},[],"Add a filter if you don't want to receive every instance of the event.",{"_3328":682,"_29138":652,"_20209":49534,"_5":13819,"_26493":49460,"_2816":49535},[],"**None** notifies all instances of the event.",{"_3328":683,"_29138":652,"_20209":49537,"_5":13819,"_26493":49460,"_2816":49538},[],"**JSON Path** evaluates one or more specific fields.",{"_3328":684,"_29138":652,"_20209":49540,"_5":13819,"_26493":49460,"_2816":49541},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3328":685,"_29138":652,"_20209":49543,"_5":13819,"_26493":49460,"_2816":49544},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3328":686,"_29138":652,"_20209":49546,"_5":13819,"_26493":49460,"_2816":49547},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3328":687,"_29138":652,"_20209":49549,"_5":13819,"_26493":49464,"_2816":49550},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3328":688,"_29138":652,"_20209":49552,"_5":13819,"_26493":49468,"_2816":49553},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3328":689,"_29138":652,"_20209":49555,"_5":13819,"_26493":49468,"_2816":49556},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3328":690,"_29138":652,"_20209":49558,"_5":13819,"_26493":49468,"_2816":49559},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3328":691,"_29138":652,"_20209":49561,"_5":13819,"_26493":49468,"_2816":49562},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3328":692,"_29138":652,"_20209":49564,"_5":13819,"_26493":49468,"_2816":49565},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3328":693,"_29138":652,"_20209":49567,"_5":13819,"_26493":49468,"_2816":49568},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3328":694,"_29138":652,"_20209":49570,"_5":13819,"_26493":49468,"_2816":49571},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3328":695,"_29138":652,"_20209":49573,"_5":13819,"_26493":49468,"_2816":49574},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3328":696,"_29138":652,"_20209":49576,"_5":13819,"_26493":49472,"_2816":49577},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3328":697,"_29138":652,"_20209":49579,"_5":13819,"_26493":49472,"_2816":49580},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3328":698,"_29138":652,"_20209":49582,"_5":13819,"_26493":49472,"_2816":49583},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3328":699,"_29138":652,"_20209":49585,"_5":13819,"_26493":49472,"_2816":49586},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3328":700,"_29138":652,"_20209":49588,"_5":13819,"_26493":49472,"_2816":49589},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3328":701,"_29138":652,"_20209":49591,"_5":13819,"_26493":49472,"_2816":49592},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3328":702,"_29138":652,"_20209":49594,"_5":13819,"_26493":49472,"_2816":49595},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3328":703,"_29138":652,"_20209":49597,"_5":13819,"_26493":49472,"_2816":49598},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3328":704,"_29138":652,"_20209":49600,"_5":13819,"_26493":49476,"_2816":49601},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3328":705,"_29138":652,"_20209":49603,"_5":13819,"_26493":49476,"_2816":49604},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3328":706,"_29138":652,"_20209":49606,"_5":13819,"_26493":49480,"_2816":49607},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3328":707,"_29138":652,"_20209":49609,"_5":13819,"_26493":49480,"_2816":49610},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3328":708,"_29138":652,"_20209":49612,"_5":13819,"_26493":49480,"_2816":49613},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3328":709,"_29138":652,"_20209":49615,"_5":13819,"_26493":49480,"_2816":49616},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3328":710,"_29138":652,"_20209":49618,"_5":13819,"_26493":49480,"_2816":49619},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3328":711,"_29138":652,"_20209":49621,"_5":13819,"_26493":49480,"_2816":49622},[],"**Validation:** `va.role.crl.create`.",{"_3328":712,"_29138":652,"_20209":49624,"_5":13819,"_26493":49480,"_2816":49625},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3328":713,"_29138":652,"_20209":49627,"_5":13819,"_26493":49480,"_2816":49628},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3328":714,"_29138":714,"_5":14177,"_2816":49630,"_29482":49631,"_20209":49632,"_26493":714},"Audit logs",[47429,48897,48898],[],{"_3328":715,"_29138":714,"_20209":49634,"_5":13819,"_26493":714,"_2816":49635},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3328":716,"_29138":714,"_5":29479,"_20209":49637,"_26493":49638,"_2816":49639},[],"/docs/pr-preview/pr-45/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3328":717,"_29138":714,"_5":29479,"_20209":49641,"_26493":49642,"_2816":49643},[],"/docs/pr-preview/pr-45/platform/administration/audit-logs#coverage","Coverage",{"_3328":718,"_29138":714,"_5":29479,"_20209":49645,"_26493":49646,"_2816":49647},[],"/docs/pr-preview/pr-45/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3328":719,"_29138":714,"_5":29479,"_20209":49649,"_26493":49650,"_2816":49651},[],"/docs/pr-preview/pr-45/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3328":720,"_29138":714,"_5":29479,"_20209":49653,"_26493":49654,"_2816":49655},[],"/docs/pr-preview/pr-45/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3328":721,"_29138":714,"_5":29479,"_20209":49657,"_26493":49658,"_2816":49659},[],"/docs/pr-preview/pr-45/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3328":722,"_29138":714,"_5":29479,"_20209":49661,"_26493":49662,"_2816":49663},[],"/docs/pr-preview/pr-45/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3328":723,"_29138":714,"_5":29479,"_20209":49665,"_26493":49666,"_2816":49667},[],"/docs/pr-preview/pr-45/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3328":724,"_29138":714,"_5":29479,"_20209":49669,"_26493":49670,"_2816":49671},[],"/docs/pr-preview/pr-45/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3328":725,"_29138":714,"_5":29479,"_20209":49673,"_26493":49674,"_2816":49675},[],"/docs/pr-preview/pr-45/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3328":726,"_29138":714,"_5":29479,"_20209":49677,"_26493":49678,"_2816":49679},[],"/docs/pr-preview/pr-45/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3328":727,"_29138":714,"_20209":49681,"_5":13819,"_26493":714,"_2816":49682},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3328":728,"_29138":714,"_20209":49684,"_5":13819,"_26493":49638,"_2816":49685},[],"The audit body includes:",{"_3328":729,"_29138":714,"_20209":49687,"_5":13819,"_26493":49638,"_2816":49688},[],"input: data received by the operation;",{"_3328":730,"_29138":714,"_20209":49690,"_5":13819,"_26493":49638,"_2816":49691},[],"has\\_error: whether the service returned an error;",{"_3328":731,"_29138":714,"_20209":49693,"_5":13819,"_26493":49638,"_2816":49694},[],"output: produced result or error message;",{"_3328":732,"_29138":714,"_20209":49696,"_5":13819,"_26493":49638,"_2816":49697},[],"principals: identifiers of the principals that matched the request.",{"_3328":733,"_29138":714,"_20209":49699,"_5":13819,"_26493":49638,"_2816":49700},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3328":734,"_29138":714,"_20209":49702,"_5":13819,"_26493":49638,"_2816":49703},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3328":735,"_29138":714,"_20209":49705,"_5":13819,"_26493":49642,"_2816":49706},[],"The backend applies auditing to mutations of:",{"_3328":736,"_29138":714,"_20209":49708,"_5":13819,"_26493":49642,"_2816":49709},[],"authorities, certificates and issuance profiles;",{"_3328":737,"_29138":714,"_20209":49711,"_5":13819,"_26493":49642,"_2816":49712},[],"keys and KMS engines;",{"_3328":738,"_29138":714,"_20209":49714,"_5":13819,"_26493":49642,"_2816":49715},[],"devices and identities;",{"_3328":739,"_29138":714,"_20209":49717,"_5":13819,"_26493":49642,"_2816":49718},[],"DMSs and enrollment operations;",{"_3328":740,"_29138":714,"_20209":49720,"_5":13819,"_26493":49642,"_2816":49721},[],"validation functions and CRL;",{"_3328":741,"_29138":714,"_20209":49723,"_5":13819,"_26493":49642,"_2816":49724},[],"principals, policies and authorization grants.",{"_3328":742,"_29138":714,"_20209":49726,"_5":13819,"_26493":49642,"_2816":49727},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3328":743,"_29138":714,"_20209":49729,"_5":13819,"_26493":49646,"_2816":49730},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3328":744,"_29138":714,"_20209":49732,"_5":13819,"_26493":49646,"_2816":49733},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3328":745,"_29138":714,"_20209":49735,"_5":13819,"_26493":49646,"_2816":49736},[],"Design the consumer to:",{"_3328":746,"_29138":714,"_20209":49738,"_5":13819,"_26493":49646,"_2816":49739},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3328":747,"_29138":714,"_20209":49741,"_5":13819,"_26493":49646,"_2816":49742},[],"keep the complete CloudEvent unmodified;",{"_3328":748,"_29138":714,"_20209":49744,"_5":13819,"_26493":49646,"_2816":49745},[],"record the ingestion time and detect duplicates by ID;",{"_3328":749,"_29138":714,"_20209":49747,"_5":13819,"_26493":49646,"_2816":49748},[],"encrypt in transit and at rest;",{"_3328":750,"_29138":714,"_20209":49750,"_5":13819,"_26493":49646,"_2816":49751},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3328":751,"_29138":714,"_20209":49753,"_5":13819,"_26493":49646,"_2816":49754},[],"apply an explicit retention and legal hold policy;",{"_3328":752,"_29138":714,"_20209":49756,"_5":13819,"_26493":49646,"_2816":49757},[],"alert if it stops consuming or the pending queue grows.",{"_3328":753,"_29138":714,"_20209":49759,"_5":13819,"_26493":49650,"_2816":49760},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3328":754,"_29138":714,"_20209":49762,"_5":13819,"_26493":49650,"_2816":49763},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3328":755,"_29138":714,"_20209":49765,"_5":13819,"_26493":49658,"_2816":49766},[],"Start from the reported time and normalize every source to UTC.",{"_3328":756,"_29138":714,"_20209":49768,"_5":13819,"_26493":49662,"_2816":49769},[],"Filter by event type, service source and resource identifier.",{"_3328":757,"_29138":714,"_20209":49771,"_5":13819,"_26493":49666,"_2816":49772},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3328":758,"_29138":714,"_20209":49774,"_5":13819,"_26493":49670,"_2816":49775},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3328":759,"_29138":714,"_20209":49777,"_5":13819,"_26493":49674,"_2816":49778},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3328":760,"_29138":714,"_20209":49780,"_5":13819,"_26493":49678,"_2816":49781},[],"Generate a controlled mutation in a test environment and check that:",{"_3328":761,"_29138":714,"_20209":49783,"_5":13819,"_26493":49678,"_2816":49784},[],"a successful audit event appears;",{"_3328":762,"_29138":714,"_20209":49786,"_5":13819,"_26493":49678,"_2816":49787},[],"the principal matches the identity used;",{"_3328":763,"_29138":714,"_20209":49789,"_5":13819,"_26493":49678,"_2816":49790},[],"the consumer persists it exactly once;",{"_3328":764,"_29138":714,"_20209":49792,"_5":13819,"_26493":49678,"_2816":49793},[],"it can be retrieved by resource, actor and period;",{"_3328":765,"_29138":714,"_20209":49795,"_5":13819,"_26493":49678,"_2816":49796},[],"a consumer outage raises an alert.",{"_3328":766,"_29138":714,"_20209":49798,"_5":13819,"_26493":49678,"_2816":49799},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3328":767,"_29138":767,"_5":14177,"_2816":49801,"_29482":49802,"_20209":49803,"_26493":767},"Platform architecture",[47429,48897],[],{"_3328":768,"_29138":767,"_20209":49805,"_5":13819,"_26493":767,"_2816":49806},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3328":769,"_29138":767,"_5":29479,"_20209":49808,"_26493":49809,"_2816":49810},[],"/docs/pr-preview/pr-45/platform/concepts/architecture#control-plane","Control plane",{"_3328":770,"_29138":767,"_5":29479,"_20209":49812,"_26493":49813,"_2816":49814},[],"/docs/pr-preview/pr-45/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3328":771,"_29138":767,"_5":29479,"_20209":49816,"_26493":49817,"_2816":49818},[],"/docs/pr-preview/pr-45/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3328":772,"_29138":767,"_5":29479,"_20209":49820,"_26493":49821,"_2816":49822},[],"/docs/pr-preview/pr-45/platform/concepts/architecture#status-and-validation","Status and validation",{"_3328":773,"_29138":767,"_5":29479,"_20209":49824,"_26493":49825,"_2816":49826},[],"/docs/pr-preview/pr-45/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3328":774,"_29138":767,"_20209":49828,"_5":13819,"_26493":767,"_2816":49829},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3328":775,"_29138":767,"_20209":49831,"_5":13819,"_26493":767,"_2816":49832},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3328":776,"_29138":767,"_20209":49834,"_5":13819,"_26493":49809,"_2816":49835},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3328":777,"_29138":767,"_20209":49837,"_5":13819,"_26493":49813,"_2816":49838},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3328":778,"_29138":767,"_20209":49840,"_5":13819,"_26493":49817,"_2816":49841},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3328":779,"_29138":767,"_20209":49843,"_5":13819,"_26493":49821,"_2816":49844},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3328":780,"_29138":767,"_20209":49846,"_5":13819,"_26493":49825,"_2816":49847},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3328":781,"_29138":781,"_5":14177,"_2816":49849,"_29482":49850,"_20209":49851,"_26493":781},"How Lamassu works",[47429,48897],[],{"_3328":782,"_29138":781,"_20209":49853,"_5":13819,"_26493":781,"_2816":49854},[],"The mental model of trust, keys, certificates and devices.",{"_3328":783,"_29138":781,"_5":29479,"_20209":49856,"_26493":49857,"_2816":49858},[],"/docs/pr-preview/pr-45/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3328":784,"_29138":781,"_5":29479,"_20209":49860,"_26493":49861,"_2816":49862},[],"/docs/pr-preview/pr-45/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3328":785,"_29138":781,"_20209":49864,"_5":13819,"_26493":781,"_2816":49865},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3328":786,"_29138":781,"_20209":49867,"_5":13819,"_26493":49857,"_2816":49868},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3328":787,"_29138":781,"_20209":49870,"_5":13819,"_26493":49857,"_2816":49871},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3328":788,"_29138":781,"_20209":49873,"_5":13819,"_26493":49857,"_2816":49874},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3328":789,"_29138":781,"_20209":49876,"_5":13819,"_26493":49857,"_2816":49877},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3328":790,"_29138":781,"_20209":49879,"_5":13819,"_26493":49857,"_2816":49880},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3328":791,"_29138":781,"_20209":49882,"_5":13819,"_26493":49861,"_2816":49883},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3328":792,"_29138":781,"_20209":49885,"_5":13819,"_26493":49861,"_2816":49886},[],"A DMS relates that CA to an enrollment policy.",{"_3328":793,"_29138":781,"_20209":49888,"_5":13819,"_26493":49861,"_2816":49889},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3328":794,"_29138":781,"_20209":49891,"_5":13819,"_26493":49861,"_2816":49892},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3328":795,"_29138":781,"_20209":49894,"_5":13819,"_26493":49861,"_2816":49895},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3328":796,"_29138":781,"_20209":49897,"_5":13819,"_26493":49861,"_2816":49898},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3328":797,"_29138":781,"_20209":49900,"_5":13819,"_26493":49861,"_2816":49901},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3328":798,"_29138":798,"_5":14177,"_2816":49903,"_29482":49904,"_20209":49906,"_26493":798},"Devices and identities",[47429,48897,49905,49903],"IoT Fleets",[],{"_3328":799,"_29138":798,"_20209":49908,"_5":13819,"_26493":798,"_2816":49909},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3328":800,"_29138":798,"_5":29479,"_20209":49911,"_26493":49912,"_2816":49913},[],"/docs/pr-preview/pr-45/platform/iot-fleets/device-management#device-states","Device states",{"_3328":801,"_29138":798,"_5":29479,"_20209":49915,"_26493":49916,"_2816":49917},[],"/docs/pr-preview/pr-45/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3328":802,"_29138":798,"_5":29479,"_20209":49919,"_26493":49920,"_2816":49921},[],"/docs/pr-preview/pr-45/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3328":803,"_29138":798,"_5":29479,"_20209":49923,"_26493":49924,"_2816":49925},[],"/docs/pr-preview/pr-45/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3328":804,"_29138":798,"_5":29479,"_20209":49927,"_26493":49928,"_2816":49929},[],"/docs/pr-preview/pr-45/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3328":805,"_29138":798,"_5":29479,"_20209":49931,"_26493":49932,"_2816":49933},[],"/docs/pr-preview/pr-45/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3328":806,"_29138":798,"_5":29479,"_20209":49935,"_26493":49936,"_2816":49937},[],"/docs/pr-preview/pr-45/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3328":807,"_29138":798,"_5":29479,"_20209":49939,"_26493":49940,"_2816":49941},[],"/docs/pr-preview/pr-45/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3328":808,"_29138":798,"_5":29479,"_20209":49943,"_26493":49944,"_2816":49945},[],"/docs/pr-preview/pr-45/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3328":809,"_29138":798,"_5":29479,"_20209":49947,"_26493":49948,"_2816":49949},[],"/docs/pr-preview/pr-45/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3328":810,"_29138":798,"_5":29479,"_20209":49951,"_26493":49952,"_2816":49953},[],"/docs/pr-preview/pr-45/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3328":811,"_29138":798,"_20209":49955,"_5":13819,"_26493":798,"_2816":49956},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3328":812,"_29138":798,"_20209":49958,"_5":13819,"_26493":798,"_2816":49959},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3328":813,"_29138":798,"_20209":49961,"_5":13819,"_26493":49912,"_2816":49962},[],"Operational view",{"_3328":814,"_29138":798,"_20209":49964,"_5":13819,"_26493":49912,"_2816":49965},[],"Meaning",{"_3328":815,"_29138":798,"_20209":49967,"_5":13819,"_26493":49912,"_2816":49968},[],"**No Identity**",{"_3328":816,"_29138":798,"_20209":49970,"_5":13819,"_26493":49912,"_2816":49971},[],"A record exists without an associated identity.",{"_3328":817,"_29138":798,"_20209":49973,"_5":13819,"_26493":49912,"_2816":49974},[],"**Active**",{"_3328":818,"_29138":798,"_20209":49976,"_5":13819,"_26493":49912,"_2816":49977},[],"The slot is active; also check certificate dates, status and usages.",{"_3328":819,"_29138":798,"_20209":49979,"_5":13819,"_26493":49912,"_2816":49980},[],"**Renewal Pending**",{"_3328":820,"_29138":798,"_20209":49982,"_5":13819,"_26493":49912,"_2816":49983},[],"The identity is in the operational renewal window.",{"_3328":821,"_29138":798,"_20209":49985,"_5":13819,"_26493":49912,"_2816":49986},[],"**Expiring Soon**",{"_3328":822,"_29138":798,"_20209":49988,"_5":13819,"_26493":49912,"_2816":49989},[],"Expiration is approaching according to configured thresholds.",{"_3328":823,"_29138":798,"_20209":49991,"_5":13819,"_26493":49912,"_2816":49992},[],"**Expired**",{"_3328":824,"_29138":798,"_20209":49994,"_5":13819,"_26493":49912,"_2816":49995},[],"The identity has expired.",{"_3328":825,"_29138":798,"_20209":49997,"_5":13819,"_26493":49912,"_2816":49998},[],"**Revoked**",{"_3328":826,"_29138":798,"_20209":50000,"_5":13819,"_26493":49912,"_2816":50001},[],"The identity is marked revoked.",{"_3328":827,"_29138":798,"_20209":50003,"_5":13819,"_26493":49912,"_2816":50004},[],"**Decommissioned**",{"_3328":828,"_29138":798,"_20209":50006,"_5":13819,"_26493":49912,"_2816":50007},[],"The record is retired and ordinary updates do not restore operation.",{"_3328":829,"_29138":798,"_20209":50009,"_5":13819,"_26493":49912,"_2816":50010},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3328":830,"_29138":798,"_20209":50012,"_5":13819,"_26493":49916,"_2816":50013},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3328":831,"_29138":798,"_20209":50015,"_5":13819,"_26493":49916,"_2816":50016},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3328":832,"_29138":798,"_20209":50018,"_5":13819,"_26493":49916,"_2816":50019},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3328":833,"_29138":798,"_20209":50021,"_5":13819,"_26493":49916,"_2816":50022},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3328":834,"_29138":798,"_20209":50024,"_5":13819,"_26493":49920,"_2816":50025},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3328":835,"_29138":798,"_20209":50027,"_5":13819,"_26493":49924,"_2816":50028},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3328":836,"_29138":798,"_20209":50030,"_5":13819,"_26493":49928,"_2816":50031},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3328":837,"_29138":798,"_20209":50033,"_5":13819,"_26493":49932,"_2816":50034},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3328":838,"_29138":798,"_20209":50036,"_5":13819,"_26493":49936,"_2816":50037},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3328":839,"_29138":798,"_20209":50039,"_5":13819,"_26493":49936,"_2816":50040},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3328":840,"_29138":798,"_20209":50042,"_5":13819,"_26493":49940,"_2816":50043},[],"From **No Identity**, use **Assign Identity**:",{"_3328":841,"_29138":798,"_20209":50045,"_5":13819,"_26493":49940,"_2816":50046},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3328":842,"_29138":798,"_20209":50048,"_5":13819,"_26493":49940,"_2816":50049},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3328":843,"_29138":798,"_20209":50051,"_5":13819,"_26493":49940,"_2816":50052},[],"Confirm and read the serial, active version and history again.",{"_3328":844,"_29138":798,"_20209":50054,"_5":13819,"_26493":49940,"_2816":50055},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3328":845,"_29138":798,"_20209":50057,"_5":13819,"_26493":49940,"_2816":50058},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3328":846,"_29138":798,"_20209":50060,"_5":13819,"_26493":49944,"_2816":50061},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3328":847,"_29138":798,"_20209":50063,"_5":13819,"_26493":49944,"_2816":50064},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3328":848,"_29138":798,"_20209":50066,"_5":13819,"_26493":49948,"_2816":50067},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3328":849,"_29138":798,"_20209":50069,"_5":13819,"_26493":49948,"_2816":50070},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3328":850,"_29138":798,"_20209":50072,"_5":13819,"_26493":49948,"_2816":50073},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3328":851,"_29138":798,"_20209":50075,"_5":13819,"_26493":49948,"_2816":50076},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3328":852,"_29138":798,"_20209":50078,"_5":13819,"_26493":49952,"_2816":50079},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3328":853,"_29138":798,"_20209":50081,"_5":13819,"_26493":49952,"_2816":50082},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3328":854,"_29138":854,"_5":14177,"_2816":50084,"_29482":50085,"_20209":50087,"_26493":854},"Bootstrap identity and authentication",[47429,48897,49905,49903,50086],"Enrollment with PKI",[],{"_3328":855,"_29138":854,"_20209":50089,"_5":13819,"_26493":854,"_2816":50090},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3328":856,"_29138":854,"_5":29479,"_20209":50092,"_26493":50093,"_2816":50094},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3328":857,"_29138":854,"_5":29479,"_20209":50096,"_26493":50097,"_2816":50098},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3328":858,"_29138":854,"_5":29479,"_20209":50100,"_26493":50101,"_2816":50102},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3328":859,"_29138":854,"_5":29479,"_20209":50104,"_26493":50105,"_2816":50106},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3328":860,"_29138":854,"_5":29479,"_20209":50108,"_26493":50109,"_2816":50110},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3328":861,"_29138":854,"_20209":50112,"_5":13819,"_26493":854,"_2816":50113},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3328":862,"_29138":854,"_20209":50115,"_5":13819,"_26493":50093,"_2816":50116},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3328":863,"_29138":854,"_20209":50118,"_5":13819,"_26493":50093,"_2816":50119},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3328":864,"_29138":854,"_20209":50121,"_5":13819,"_26493":50097,"_2816":50122},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3328":865,"_29138":854,"_20209":50124,"_5":13819,"_26493":50097,"_2816":50125},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3328":866,"_29138":854,"_20209":50127,"_5":13819,"_26493":50097,"_2816":50128},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3328":867,"_29138":854,"_20209":50130,"_5":13819,"_26493":50101,"_2816":50131},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3328":868,"_29138":854,"_20209":50133,"_5":13819,"_26493":50101,"_2816":50134},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3328":869,"_29138":854,"_20209":50136,"_5":13819,"_26493":50105,"_2816":50137},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3328":870,"_29138":854,"_20209":50139,"_5":13819,"_26493":50105,"_2816":50140},[],"Example body:",{"_3328":871,"_29138":854,"_20209":50142,"_5":13819,"_26493":50105,"_2816":50143},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3328":872,"_29138":854,"_20209":50145,"_5":13819,"_26493":50105,"_2816":50146},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3328":873,"_29138":854,"_20209":50148,"_5":13819,"_26493":50105,"_2816":50149},[],"Continuation requires a successful HTTP response and JSON:",{"_3328":874,"_29138":854,"_20209":50151,"_5":13819,"_26493":50105,"_2816":50152},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3328":875,"_29138":854,"_20209":50154,"_5":13819,"_26493":50109,"_2816":50155},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3328":876,"_29138":854,"_20209":50157,"_5":13819,"_26493":50109,"_2816":50158},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3328":877,"_29138":877,"_5":14177,"_2816":50160,"_29482":50161,"_20209":50162,"_26493":877},"Configure and operate the DMS",[47429,48897,49905,49903,50086],[],{"_3328":878,"_29138":877,"_20209":50164,"_5":13819,"_26493":877,"_2816":50165},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3328":879,"_29138":877,"_5":29479,"_20209":50167,"_26493":50168,"_2816":47439},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3328":880,"_29138":877,"_5":29479,"_20209":50170,"_26493":50171,"_2816":50172},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3328":881,"_29138":877,"_5":29479,"_20209":50174,"_26493":50175,"_2816":50176},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3328":882,"_29138":877,"_5":29479,"_20209":50178,"_26493":50179,"_2816":50180},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3328":883,"_29138":877,"_5":29479,"_20209":50182,"_26493":50183,"_2816":50184},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3328":884,"_29138":877,"_5":29479,"_20209":50186,"_26493":50187,"_2816":50188},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3328":885,"_29138":877,"_5":29479,"_20209":50190,"_26493":50191,"_2816":50192},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3328":886,"_29138":877,"_5":29479,"_20209":50194,"_26493":50195,"_2816":50196},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3328":887,"_29138":877,"_5":29479,"_20209":50198,"_26493":50199,"_2816":50200},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3328":888,"_29138":877,"_5":29479,"_20209":50202,"_26493":50203,"_2816":50204},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3328":889,"_29138":877,"_5":29479,"_20209":50206,"_26493":50207,"_2816":50208},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3328":890,"_29138":877,"_5":29479,"_20209":50210,"_26493":50211,"_2816":50212},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3328":891,"_29138":877,"_5":29479,"_20209":50214,"_26493":50215,"_2816":50216},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3328":892,"_29138":877,"_5":29479,"_20209":50218,"_26493":50219,"_2816":50220},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3328":893,"_29138":877,"_5":29479,"_20209":50222,"_26493":50223,"_2816":50224},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3328":894,"_29138":877,"_5":29479,"_20209":50226,"_26493":50227,"_2816":50228},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3328":895,"_29138":877,"_5":29479,"_20209":50230,"_26493":50231,"_2816":50232},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3328":896,"_29138":877,"_5":29479,"_20209":50234,"_26493":50235,"_2816":50236},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3328":897,"_29138":877,"_20209":50238,"_5":13819,"_26493":877,"_2816":50239},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3328":898,"_29138":877,"_20209":50241,"_5":13819,"_26493":50168,"_2816":50242},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3328":899,"_29138":877,"_20209":50244,"_5":13819,"_26493":50168,"_2816":50245},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3328":900,"_29138":877,"_20209":50247,"_5":13819,"_26493":50175,"_2816":50248},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3328":901,"_29138":877,"_20209":50250,"_5":13819,"_26493":50179,"_2816":50251},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3328":902,"_29138":877,"_20209":50253,"_5":13819,"_26493":50183,"_2816":50254},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3328":903,"_29138":877,"_20209":50256,"_5":13819,"_26493":50187,"_2816":50257},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3328":904,"_29138":877,"_20209":50259,"_5":13819,"_26493":50191,"_2816":50260},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3328":905,"_29138":877,"_20209":50262,"_5":13819,"_26493":50199,"_2816":50263},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3328":906,"_29138":877,"_20209":50265,"_5":13819,"_26493":50199,"_2816":50266},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3328":907,"_29138":877,"_20209":50268,"_5":13819,"_26493":50203,"_2816":50269},[],"`settings.enrollment_settings` field",{"_3328":908,"_29138":877,"_20209":50271,"_5":13819,"_26493":50203,"_2816":50272},[],"Decision",{"_3328":909,"_29138":877,"_20209":50274,"_5":13819,"_26493":50203,"_2816":50275},[],"`protocol`",{"_3328":910,"_29138":877,"_20209":50277,"_5":13819,"_26493":50203,"_2816":50278},[],"`EST_RFC7030` for these operations.",{"_3328":911,"_29138":877,"_20209":50280,"_5":13819,"_26493":50203,"_2816":50281},[],"`enrollment_ca`",{"_3328":912,"_29138":877,"_20209":50283,"_5":13819,"_26493":50203,"_2816":50284},[],"ID of the signing CA.",{"_3328":913,"_29138":877,"_20209":50286,"_5":13819,"_26493":50203,"_2816":50287},[],"`verify_csr_signature`",{"_3328":914,"_29138":877,"_20209":50289,"_5":13819,"_26493":50203,"_2816":50290},[],"Keep `true` to verify CSR key possession.",{"_3328":915,"_29138":877,"_20209":50292,"_5":13819,"_26493":50203,"_2816":50293},[],"`enable_replaceable_enrollment`",{"_3328":916,"_29138":877,"_20209":50295,"_5":13819,"_26493":50203,"_2816":50296},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3328":917,"_29138":877,"_20209":50298,"_5":13819,"_26493":50203,"_2816":50299},[],"`est_rfc7030_settings.auth_mode`",{"_3328":918,"_29138":877,"_20209":50301,"_5":13819,"_26493":50203,"_2816":50302},[],"One of the four authentication modes.",{"_3328":919,"_29138":877,"_20209":50304,"_5":13819,"_26493":50203,"_2816":50305},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3328":920,"_29138":877,"_20209":50307,"_5":13819,"_26493":50207,"_2816":50308},[],"The blocks are independent:",{"_3328":921,"_29138":877,"_20209":50310,"_5":13819,"_26493":50207,"_2816":50311},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3328":922,"_29138":877,"_20209":50313,"_5":13819,"_26493":50207,"_2816":50314},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3328":923,"_29138":877,"_20209":50316,"_5":13819,"_26493":50207,"_2816":50317},[],"`auth_mode`",{"_3328":924,"_29138":877,"_20209":50319,"_5":13819,"_26493":50207,"_2816":50320},[],"Control applied in the configured operation",{"_3328":925,"_29138":877,"_20209":50322,"_5":13819,"_26493":50207,"_2816":50323},[],"`CLIENT_CERTIFICATE`",{"_3328":926,"_29138":877,"_20209":50325,"_5":13819,"_26493":50207,"_2816":50326},[],"Presented certificate validation.",{"_3328":927,"_29138":877,"_20209":50328,"_5":13819,"_26493":50207,"_2816":50329},[],"`EXTERNAL_WEBHOOK`",{"_3328":928,"_29138":877,"_20209":50331,"_5":13819,"_26493":50207,"_2816":50332},[],"Configured webhook authorization.",{"_3328":929,"_29138":877,"_20209":50334,"_5":13819,"_26493":50207,"_2816":50335},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3328":930,"_29138":877,"_20209":50337,"_5":13819,"_26493":50207,"_2816":50338},[],"Certificate validation followed by webhook approval.",{"_3328":931,"_29138":877,"_20209":50340,"_5":13819,"_26493":50207,"_2816":50341},[],"`NO_AUTH`",{"_3328":932,"_29138":877,"_20209":50343,"_5":13819,"_26493":50207,"_2816":50344},[],"No DMS requester authentication.",{"_3328":933,"_29138":877,"_20209":50346,"_5":13819,"_26493":50207,"_2816":50347},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3328":934,"_29138":877,"_20209":50349,"_5":13819,"_26493":50207,"_2816":50350},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3328":935,"_29138":877,"_20209":50352,"_5":13819,"_26493":50207,"_2816":50353},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3328":936,"_29138":877,"_20209":50355,"_5":13819,"_26493":50207,"_2816":50356},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3328":937,"_29138":877,"_20209":50358,"_5":13819,"_26493":50211,"_2816":50359},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3328":938,"_29138":877,"_20209":50361,"_5":13819,"_26493":50211,"_2816":50362},[],"`external_webhook_settings` field",{"_3328":939,"_29138":877,"_20209":50364,"_5":13819,"_26493":50211,"_2816":50272},[],{"_3328":940,"_29138":877,"_20209":50366,"_5":13819,"_26493":50211,"_2816":50367},[],"`url`",{"_3328":941,"_29138":877,"_20209":50369,"_5":13819,"_26493":50211,"_2816":50370},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3328":942,"_29138":877,"_20209":50372,"_5":13819,"_26493":50211,"_2816":50373},[],"`method`",{"_3328":943,"_29138":877,"_20209":50375,"_5":13819,"_26493":50211,"_2816":50376},[],"`POST` or `PUT`; `POST` by default.",{"_3328":944,"_29138":877,"_20209":50378,"_5":13819,"_26493":50211,"_2816":50379},[],"`name`",{"_3328":945,"_29138":877,"_20209":50381,"_5":13819,"_26493":50211,"_2816":50382},[],"Label used in service logs.",{"_3328":946,"_29138":877,"_20209":50384,"_5":13819,"_26493":50211,"_2816":50385},[],"`config.auth_mode`",{"_3328":947,"_29138":877,"_20209":50387,"_5":13819,"_26493":50211,"_2816":50388},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3328":948,"_29138":877,"_20209":50390,"_5":13819,"_26493":50211,"_2816":50391},[],"`config.log_level`",{"_3328":949,"_29138":877,"_20209":50393,"_5":13819,"_26493":50211,"_2816":50394},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3328":950,"_29138":877,"_20209":50396,"_5":13819,"_26493":50211,"_2816":50397},[],"`config.apikey_options`",{"_3328":951,"_29138":877,"_20209":50399,"_5":13819,"_26493":50211,"_2816":50400},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3328":952,"_29138":877,"_20209":50402,"_5":13819,"_26493":50211,"_2816":50403},[],"`config.jwt_options`",{"_3328":953,"_29138":877,"_20209":50405,"_5":13819,"_26493":50211,"_2816":50406},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3328":954,"_29138":877,"_20209":50408,"_5":13819,"_26493":50211,"_2816":50409},[],"`config.mtls_options`",{"_3328":955,"_29138":877,"_20209":50411,"_5":13819,"_26493":50211,"_2816":50412},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3328":956,"_29138":877,"_20209":50414,"_5":13819,"_26493":50211,"_2816":50415},[],"`config.insecure_skip_verify`",{"_3328":957,"_29138":877,"_20209":50417,"_5":13819,"_26493":50211,"_2816":50418},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3328":958,"_29138":877,"_20209":50420,"_5":13819,"_26493":50211,"_2816":50421},[],"`config.call_timeout`",{"_3328":959,"_29138":877,"_20209":50423,"_5":13819,"_26493":50211,"_2816":50424},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3328":960,"_29138":877,"_20209":50426,"_5":13819,"_26493":50211,"_2816":50427},[],"Rules for that configuration:",{"_3328":961,"_29138":877,"_20209":50429,"_5":13819,"_26493":50211,"_2816":50430},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3328":962,"_29138":877,"_20209":50432,"_5":13819,"_26493":50211,"_2816":50433},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3328":963,"_29138":877,"_20209":50435,"_5":13819,"_26493":50211,"_2816":50436},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3328":964,"_29138":877,"_20209":50438,"_5":13819,"_26493":50211,"_2816":50439},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3328":965,"_29138":877,"_20209":50441,"_5":13819,"_26493":50211,"_2816":50442},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3328":966,"_29138":877,"_20209":50444,"_5":13819,"_26493":50211,"_2816":50445},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3328":967,"_29138":877,"_20209":50447,"_5":13819,"_26493":50211,"_2816":50448},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3328":968,"_29138":877,"_20209":50450,"_5":13819,"_26493":50211,"_2816":50451},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3328":969,"_29138":877,"_20209":50453,"_5":13819,"_26493":50211,"_2816":50454},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3328":970,"_29138":877,"_20209":50456,"_5":13819,"_26493":50215,"_2816":50457},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3328":971,"_29138":877,"_20209":50459,"_5":13819,"_26493":50219,"_2816":50460},[],"`settings.reenrollment_settings` field",{"_3328":972,"_29138":877,"_20209":50462,"_5":13819,"_26493":50219,"_2816":47819},[],{"_3328":973,"_29138":877,"_20209":50464,"_5":13819,"_26493":50219,"_2816":50465},[],"`reenrollment_delta`",{"_3328":974,"_29138":877,"_20209":50467,"_5":13819,"_26493":50219,"_2816":50468},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3328":975,"_29138":877,"_20209":50470,"_5":13819,"_26493":50219,"_2816":50471},[],"`preventive_delta`",{"_3328":976,"_29138":877,"_20209":50473,"_5":13819,"_26493":50219,"_2816":50474},[],"Preventive operational monitoring threshold.",{"_3328":977,"_29138":877,"_20209":50476,"_5":13819,"_26493":50219,"_2816":50477},[],"`critical_delta`",{"_3328":978,"_29138":877,"_20209":50479,"_5":13819,"_26493":50219,"_2816":50480},[],"Critical operational monitoring threshold.",{"_3328":979,"_29138":877,"_20209":50482,"_5":13819,"_26493":50219,"_2816":50483},[],"`enable_expired_renewal`",{"_3328":980,"_29138":877,"_20209":50485,"_5":13819,"_26493":50219,"_2816":50486},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3328":981,"_29138":877,"_20209":50488,"_5":13819,"_26493":50219,"_2816":50489},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3328":982,"_29138":877,"_20209":50491,"_5":13819,"_26493":50219,"_2816":50492},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3328":983,"_29138":877,"_20209":50494,"_5":13819,"_26493":50219,"_2816":50495},[],"`revoke_on_reenrollment`",{"_3328":984,"_29138":877,"_20209":50497,"_5":13819,"_26493":50219,"_2816":50498},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3328":985,"_29138":877,"_20209":50500,"_5":13819,"_26493":50219,"_2816":50501},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3328":986,"_29138":877,"_20209":50503,"_5":13819,"_26493":50223,"_2816":50504},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3328":987,"_29138":877,"_20209":50506,"_5":13819,"_26493":50227,"_2816":47813},[],{"_3328":988,"_29138":877,"_20209":50508,"_5":13819,"_26493":50227,"_2816":50509},[],"Published material",{"_3328":989,"_29138":877,"_20209":50511,"_5":13819,"_26493":50227,"_2816":50512},[],"**Include Lamassu System CA**",{"_3328":990,"_29138":877,"_20209":50514,"_5":13819,"_26493":50227,"_2816":50515},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3328":991,"_29138":877,"_20209":50517,"_5":13819,"_26493":50227,"_2816":50518},[],"**Include Enrollment CA**",{"_3328":992,"_29138":877,"_20209":50520,"_5":13819,"_26493":50227,"_2816":50521},[],"Selected issuing CA certificate.",{"_3328":993,"_29138":877,"_20209":50523,"_5":13819,"_26493":50227,"_2816":50524},[],"**Managed CAs**",{"_3328":994,"_29138":877,"_20209":50526,"_5":13819,"_26493":50227,"_2816":50527},[],"Explicitly selected CA certificates.",{"_3328":995,"_29138":877,"_20209":50529,"_5":13819,"_26493":50227,"_2816":50530},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3328":996,"_29138":877,"_20209":50532,"_5":13819,"_26493":50231,"_2816":50533},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3328":997,"_29138":877,"_20209":50535,"_5":13819,"_26493":50231,"_2816":50536},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3328":998,"_29138":877,"_20209":50538,"_5":13819,"_26493":50231,"_2816":50539},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3328":999,"_29138":877,"_20209":50541,"_5":13819,"_26493":50235,"_2816":50542},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3328":1000,"_29138":1000,"_5":14177,"_2816":50544,"_29482":50545,"_20209":50546,"_26493":1000},"Integrate the EST client",[47429,48897,49905,49903,50086],[],{"_3328":1001,"_29138":1000,"_20209":50548,"_5":13819,"_26493":1000,"_2816":50549},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3328":1002,"_29138":1000,"_5":29479,"_20209":50551,"_26493":50552,"_2816":47439},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3328":1003,"_29138":1000,"_5":29479,"_20209":50554,"_26493":50555,"_2816":50556},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3328":1004,"_29138":1000,"_5":29479,"_20209":50558,"_26493":50559,"_2816":50560},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3328":1005,"_29138":1000,"_5":29479,"_20209":50562,"_26493":50563,"_2816":50564},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3328":1006,"_29138":1000,"_5":29479,"_20209":50566,"_26493":50567,"_2816":50568},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3328":1007,"_29138":1000,"_5":29479,"_20209":50570,"_26493":50571,"_2816":50572},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3328":1008,"_29138":1000,"_20209":50574,"_5":13819,"_26493":1000,"_2816":50575},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3328":1009,"_29138":1000,"_20209":50577,"_5":13819,"_26493":50552,"_2816":50578},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3328":1010,"_29138":1000,"_20209":50580,"_5":13819,"_26493":50552,"_2816":50581},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3328":1011,"_29138":1000,"_20209":50583,"_5":13819,"_26493":50552,"_2816":50584},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3328":1012,"_29138":1000,"_20209":50586,"_5":13819,"_26493":50555,"_2816":50587},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3328":1013,"_29138":1000,"_20209":50589,"_5":13819,"_26493":50555,"_2816":50590},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3328":1014,"_29138":1000,"_20209":50592,"_5":13819,"_26493":50559,"_2816":50593},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3328":1015,"_29138":1000,"_20209":50595,"_5":13819,"_26493":50559,"_2816":50596},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3328":1016,"_29138":1000,"_20209":50598,"_5":13819,"_26493":50563,"_2816":50599},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3328":1017,"_29138":1000,"_20209":50601,"_5":13819,"_26493":50563,"_2816":50602},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3328":1018,"_29138":1000,"_20209":50604,"_5":13819,"_26493":50567,"_2816":50605},[],"For a root that issues directly:",{"_3328":1019,"_29138":1000,"_20209":50607,"_5":13819,"_26493":50567,"_2816":50608},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3328":1020,"_29138":1000,"_20209":50610,"_5":13819,"_26493":50567,"_2816":50611},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3328":1021,"_29138":1000,"_20209":50613,"_5":13819,"_26493":50571,"_2816":50614},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3328":1022,"_29138":1022,"_5":14177,"_2816":50616,"_29482":50617,"_20209":50618,"_26493":1022},"EST reference",[47429,48897,49905,49903,50086],[],{"_3328":1023,"_29138":1022,"_20209":50620,"_5":13819,"_26493":1022,"_2816":50621},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3328":1024,"_29138":1022,"_5":29479,"_20209":50623,"_26493":50624,"_2816":50625},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3328":1025,"_29138":1022,"_5":29479,"_20209":50627,"_26493":50628,"_2816":21954},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3328":1026,"_29138":1022,"_5":29479,"_20209":50630,"_26493":50631,"_2816":25139},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3328":1027,"_29138":1022,"_5":29479,"_20209":50633,"_26493":50634,"_2816":25146},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3328":1028,"_29138":1022,"_5":29479,"_20209":50636,"_26493":50637,"_2816":24479},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3328":1029,"_29138":1022,"_5":29479,"_20209":50639,"_26493":50640,"_2816":50641},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3328":1030,"_29138":1022,"_5":29479,"_20209":50643,"_26493":50644,"_2816":50645},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3328":1031,"_29138":1022,"_5":29479,"_20209":50647,"_26493":50648,"_2816":50649},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3328":1032,"_29138":1022,"_20209":50651,"_5":13819,"_26493":1022,"_2816":50652},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3328":1033,"_29138":1022,"_20209":50654,"_5":13819,"_26493":50624,"_2816":50655},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3328":1034,"_29138":1022,"_20209":50657,"_5":13819,"_26493":50624,"_2816":50658},[],"Operation",{"_3328":1035,"_29138":1022,"_20209":50660,"_5":13819,"_26493":50624,"_2816":50661},[],"Method",{"_3328":1036,"_29138":1022,"_20209":50663,"_5":13819,"_26493":50624,"_2816":50664},[],"Authentication and condition",{"_3328":1037,"_29138":1022,"_20209":50666,"_5":13819,"_26493":50624,"_2816":50667},[],"`/cacerts`",{"_3328":1038,"_29138":1022,"_20209":50669,"_5":13819,"_26493":50624,"_2816":50670},[],"GET",{"_3328":1039,"_29138":1022,"_20209":50672,"_5":13819,"_26493":50624,"_2816":50673},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3328":1040,"_29138":1022,"_20209":50675,"_5":13819,"_26493":50624,"_2816":50676},[],"`/simpleenroll`",{"_3328":1041,"_29138":1022,"_20209":50678,"_5":13819,"_26493":50624,"_2816":50679},[],"POST",{"_3328":1042,"_29138":1022,"_20209":50681,"_5":13819,"_26493":50624,"_2816":50682},[],"Initial authentication and DMS registration/replacement policy.",{"_3328":1043,"_29138":1022,"_20209":50684,"_5":13819,"_26493":50624,"_2816":50685},[],"`/simplereenroll`",{"_3328":1044,"_29138":1022,"_20209":50687,"_5":13819,"_26493":50624,"_2816":50679},[],{"_3328":1045,"_29138":1022,"_20209":50689,"_5":13819,"_26493":50624,"_2816":50690},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3328":1046,"_29138":1022,"_20209":50692,"_5":13819,"_26493":50624,"_2816":50693},[],"`/serverkeygen`",{"_3328":1047,"_29138":1022,"_20209":50695,"_5":13819,"_26493":50624,"_2816":50679},[],{"_3328":1048,"_29138":1022,"_20209":50697,"_5":13819,"_26493":50624,"_2816":50698},[],"Initial authentication and admission; server generation enabled.",{"_3328":1049,"_29138":1022,"_20209":50700,"_5":13819,"_26493":50624,"_2816":50701},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3328":1050,"_29138":1022,"_20209":50703,"_5":13819,"_26493":50628,"_2816":50704},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3328":1051,"_29138":1022,"_20209":50706,"_5":13819,"_26493":50628,"_2816":50707},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3328":1052,"_29138":1022,"_20209":50709,"_5":13819,"_26493":50631,"_2816":50710},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3328":1053,"_29138":1022,"_20209":50712,"_5":13819,"_26493":50631,"_2816":50713},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3328":1054,"_29138":1022,"_20209":50715,"_5":13819,"_26493":50634,"_2816":50716},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3328":1055,"_29138":1022,"_20209":50718,"_5":13819,"_26493":50634,"_2816":50719},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3328":1056,"_29138":1022,"_20209":50721,"_5":13819,"_26493":50637,"_2816":50722},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3328":1057,"_29138":1022,"_20209":50724,"_5":13819,"_26493":50637,"_2816":50725},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3328":1058,"_29138":1022,"_20209":50727,"_5":13819,"_26493":50640,"_2816":50728},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3328":1059,"_29138":1022,"_20209":50730,"_5":13819,"_26493":50640,"_2816":50731},[],"Part",{"_3328":1060,"_29138":1022,"_20209":50733,"_5":13819,"_26493":50640,"_2816":50734},[],"Content after decoding its Base64",{"_3328":1061,"_29138":1022,"_20209":50736,"_5":13819,"_26493":50640,"_2816":50737},[],"`application/pkcs8`",{"_3328":1062,"_29138":1022,"_20209":50739,"_5":13819,"_26493":50640,"_2816":50740},[],"Unencrypted DER PKCS#8 private key.",{"_3328":1063,"_29138":1022,"_20209":50742,"_5":13819,"_26493":50640,"_2816":50743},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3328":1064,"_29138":1022,"_20209":50745,"_5":13819,"_26493":50640,"_2816":50746},[],"DER PKCS#7 containing the issued certificate.",{"_3328":1065,"_29138":1022,"_20209":50748,"_5":13819,"_26493":50640,"_2816":50749},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3328":1066,"_29138":1022,"_20209":50751,"_5":13819,"_26493":50644,"_2816":50752},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3328":1067,"_29138":1022,"_20209":50754,"_5":13819,"_26493":50644,"_2816":50755},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3328":1068,"_29138":1022,"_20209":50757,"_5":13819,"_26493":50644,"_2816":50758},[],"Convert and check the result:",{"_3328":1069,"_29138":1022,"_20209":50760,"_5":13819,"_26493":50644,"_2816":50761},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3328":1070,"_29138":1022,"_20209":50763,"_5":13819,"_26493":50648,"_2816":50764},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3328":1071,"_29138":1022,"_20209":50766,"_5":13819,"_26493":50648,"_2816":50767},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3328":1072,"_29138":1072,"_5":14177,"_2816":50086,"_29482":50769,"_20209":50770,"_26493":1072},[47429,48897,49905,49903,50086],[],{"_3328":1073,"_29138":1072,"_20209":50772,"_5":13819,"_26493":1072,"_2816":50773},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3328":1074,"_29138":1072,"_5":29479,"_20209":50775,"_26493":50776,"_2816":50777},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3328":1075,"_29138":1072,"_5":29479,"_20209":50779,"_26493":50780,"_2816":50781},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3328":1076,"_29138":1072,"_5":29479,"_20209":50783,"_26493":50784,"_2816":50785},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3328":1077,"_29138":1072,"_5":29479,"_20209":50787,"_26493":50788,"_2816":50789},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3328":1078,"_29138":1072,"_20209":50791,"_5":13819,"_26493":1072,"_2816":50792},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3328":1079,"_29138":1072,"_20209":50794,"_5":13819,"_26493":50776,"_2816":50795},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3328":1080,"_29138":1072,"_20209":50797,"_5":13819,"_26493":50776,"_2816":50798},[],"The integrator installs initial EST server trust and an admission credential.",{"_3328":1081,"_29138":1072,"_20209":50800,"_5":13819,"_26493":50776,"_2816":50801},[],"The client requests an identity for its `Device ID` through EST.",{"_3328":1082,"_29138":1072,"_20209":50803,"_5":13819,"_26493":50776,"_2816":50804},[],"Certificate, device binding and key/certificate installation are checked.",{"_3328":1083,"_29138":1072,"_20209":50806,"_5":13819,"_26493":50776,"_2816":50807},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3328":1084,"_29138":1072,"_20209":50809,"_5":13819,"_26493":50776,"_2816":50810},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3328":1085,"_29138":1072,"_20209":50812,"_5":13819,"_26493":50780,"_2816":50813},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3328":1086,"_29138":1072,"_20209":50815,"_5":13819,"_26493":50780,"_2816":50816},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3328":1087,"_29138":1072,"_20209":50818,"_5":13819,"_26493":50780,"_2816":50819},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3328":1088,"_29138":1072,"_20209":50821,"_5":13819,"_26493":50780,"_2816":50822},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3328":1089,"_29138":1072,"_20209":50824,"_5":13819,"_26493":50784,"_2816":50825},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3328":1090,"_29138":1072,"_20209":50827,"_5":13819,"_26493":50784,"_2816":50828},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3328":1091,"_29138":1072,"_20209":50830,"_5":13819,"_26493":50784,"_2816":50831},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3328":1092,"_29138":1072,"_20209":50833,"_5":13819,"_26493":50784,"_2816":50834},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3328":1093,"_29138":1072,"_20209":50836,"_5":13819,"_26493":50788,"_2816":50837},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3328":1094,"_29138":1072,"_20209":50839,"_5":13819,"_26493":50788,"_2816":50840},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3328":1095,"_29138":1095,"_5":14177,"_2816":50842,"_29482":50843,"_20209":50844,"_26493":1095},"Provisioning strategies",[47429,48897,49905,49903,50086],[],{"_3328":1096,"_29138":1095,"_20209":50846,"_5":13819,"_26493":1095,"_2816":50847},[],"Choose device registration, identity authorization and key generation.",{"_3328":1097,"_29138":1095,"_5":29479,"_20209":50849,"_26493":50850,"_2816":50851},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3328":1098,"_29138":1095,"_5":29479,"_20209":50853,"_26493":50854,"_2816":50855},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3328":1099,"_29138":1095,"_5":29479,"_20209":50857,"_26493":50858,"_2816":50859},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3328":1100,"_29138":1095,"_5":29479,"_20209":50861,"_26493":50862,"_2816":50863},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3328":1101,"_29138":1095,"_5":29479,"_20209":50865,"_26493":50866,"_2816":50867},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3328":1102,"_29138":1095,"_20209":50869,"_5":13819,"_26493":1095,"_2816":50870},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3328":1103,"_29138":1095,"_20209":50872,"_5":13819,"_26493":50850,"_2816":50873},[],"Path",{"_3328":1104,"_29138":1095,"_20209":50875,"_5":13819,"_26493":50850,"_2816":50876},[],"When the device exists",{"_3328":1105,"_29138":1095,"_20209":50878,"_5":13819,"_26493":50850,"_2816":50879},[],"What to check",{"_3328":1106,"_29138":1095,"_20209":50881,"_5":13819,"_26493":50850,"_2816":50882},[],"Manual assignment",{"_3328":1107,"_29138":1095,"_20209":50884,"_5":13819,"_26493":50850,"_2816":50885},[],"An operator creates it before associating a certificate.",{"_3328":1108,"_29138":1095,"_20209":50887,"_5":13819,"_26493":50850,"_2816":50888},[],"ID, owning DMS, certificate CN and bound serial.",{"_3328":1109,"_29138":1095,"_20209":50890,"_5":13819,"_26493":50850,"_2816":50891},[],"EST with `JITP`",{"_3328":1110,"_29138":1095,"_20209":50893,"_5":13819,"_26493":50850,"_2816":50894},[],"Created for an unknown CN during `/simpleenroll`.",{"_3328":1111,"_29138":1095,"_20209":50896,"_5":13819,"_26493":50850,"_2816":50897},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3328":1112,"_29138":1095,"_20209":50899,"_5":13819,"_26493":50850,"_2816":50900},[],"EST with `PRE_REGISTRATION`",{"_3328":1113,"_29138":1095,"_20209":50902,"_5":13819,"_26493":50850,"_2816":50903},[],"Must exist before `/simpleenroll`.",{"_3328":1114,"_29138":1095,"_20209":50905,"_5":13819,"_26493":50850,"_2816":50906},[],"Approved record, same DMS and replacement conditions for your version.",{"_3328":1115,"_29138":1095,"_20209":50908,"_5":13819,"_26493":50850,"_2816":50909},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3328":1116,"_29138":1095,"_20209":50911,"_5":13819,"_26493":50850,"_2816":50912},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3328":1117,"_29138":1095,"_20209":50914,"_5":13819,"_26493":50854,"_2816":50915},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3328":1118,"_29138":1095,"_20209":50917,"_5":13819,"_26493":50854,"_2816":50918},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3328":1119,"_29138":1095,"_20209":50920,"_5":13819,"_26493":50854,"_2816":50921},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3328":1120,"_29138":1095,"_20209":50923,"_5":13819,"_26493":50858,"_2816":50924},[],"Decide initial enrollment and re-enrollment separately:",{"_3328":1121,"_29138":1095,"_20209":50926,"_5":13819,"_26493":50858,"_2816":50927},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3328":1122,"_29138":1095,"_20209":50929,"_5":13819,"_26493":50858,"_2816":50930},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3328":1123,"_29138":1095,"_20209":50932,"_5":13819,"_26493":50858,"_2816":50933},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3328":1124,"_29138":1095,"_20209":50935,"_5":13819,"_26493":50858,"_2816":50936},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3328":1125,"_29138":1095,"_20209":50938,"_5":13819,"_26493":50858,"_2816":50939},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3328":1126,"_29138":1095,"_20209":50941,"_5":13819,"_26493":50862,"_2816":47813},[],{"_3328":1127,"_29138":1095,"_20209":50943,"_5":13819,"_26493":50862,"_2816":50944},[],"Material crossing EST",{"_3328":1128,"_29138":1095,"_20209":50946,"_5":13819,"_26493":50862,"_2816":50947},[],"Device-generated key",{"_3328":1129,"_29138":1095,"_20209":50949,"_5":13819,"_26493":50862,"_2816":50950},[],"Public CSR and certificate; the key stays on the client.",{"_3328":1130,"_29138":1095,"_20209":50952,"_5":13819,"_26493":50862,"_2816":50953},[],"Existing device key",{"_3328":1131,"_29138":1095,"_20209":50955,"_5":13819,"_26493":50862,"_2816":50956},[],"CSR signed with that key and a new certificate.",{"_3328":1132,"_29138":1095,"_20209":50958,"_5":13819,"_26493":50862,"_2816":50224},[],{"_3328":1133,"_29138":1095,"_20209":50960,"_5":13819,"_26493":50862,"_2816":50961},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3328":1134,"_29138":1095,"_20209":50963,"_5":13819,"_26493":50862,"_2816":50964},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3328":1135,"_29138":1095,"_20209":50966,"_5":13819,"_26493":50866,"_2816":50967},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3328":1136,"_29138":1136,"_5":14177,"_2816":50969,"_29482":50970,"_20209":50971,"_26493":1136},"Renewal and recovery",[47429,48897,49905,49903,50086],[],{"_3328":1137,"_29138":1136,"_20209":50973,"_5":13819,"_26493":1136,"_2816":50974},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3328":1138,"_29138":1136,"_5":29479,"_20209":50976,"_26493":50977,"_2816":50978},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3328":1139,"_29138":1136,"_5":29479,"_20209":50980,"_26493":50981,"_2816":50982},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3328":1140,"_29138":1136,"_5":29479,"_20209":50984,"_26493":50985,"_2816":50986},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3328":1141,"_29138":1136,"_5":29479,"_20209":50988,"_26493":50989,"_2816":50990},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3328":1142,"_29138":1136,"_5":29479,"_20209":50992,"_26493":50993,"_2816":50994},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3328":1143,"_29138":1136,"_20209":50996,"_5":13819,"_26493":1136,"_2816":50997},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3328":1144,"_29138":1136,"_20209":50999,"_5":13819,"_26493":50977,"_2816":51000},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3328":1145,"_29138":1136,"_20209":51002,"_5":13819,"_26493":50977,"_2816":51003},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3328":1146,"_29138":1136,"_20209":51005,"_5":13819,"_26493":50977,"_2816":51006},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3328":1147,"_29138":1136,"_20209":51008,"_5":13819,"_26493":50977,"_2816":51009},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3328":1148,"_29138":1136,"_20209":51011,"_5":13819,"_26493":50981,"_2816":51012},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3328":1149,"_29138":1136,"_20209":51014,"_5":13819,"_26493":50981,"_2816":51015},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3328":1150,"_29138":1136,"_20209":51017,"_5":13819,"_26493":50985,"_2816":51018},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3328":1151,"_29138":1136,"_20209":51020,"_5":13819,"_26493":50985,"_2816":51021},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3328":1152,"_29138":1136,"_20209":51023,"_5":13819,"_26493":50985,"_2816":51024},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3328":1153,"_29138":1136,"_20209":51026,"_5":13819,"_26493":50989,"_2816":51027},[],"Situation",{"_3328":1154,"_29138":1136,"_20209":51029,"_5":13819,"_26493":50989,"_2816":51030},[],"Procedure",{"_3328":1155,"_29138":1136,"_20209":51032,"_5":13819,"_26493":50989,"_2816":51033},[],"Valid certificate, outside the window",{"_3328":1156,"_29138":1136,"_20209":51035,"_5":13819,"_26493":50989,"_2816":51036},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3328":1157,"_29138":1136,"_20209":51038,"_5":13819,"_26493":50989,"_2816":51039},[],"Expired certificate, key available",{"_3328":1158,"_29138":1136,"_20209":51041,"_5":13819,"_26493":50989,"_2816":51042},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3328":1159,"_29138":1136,"_20209":51044,"_5":13819,"_26493":50989,"_2816":51045},[],"Renewal through webhook or `NO_AUTH`",{"_3328":1160,"_29138":1136,"_20209":51047,"_5":13819,"_26493":50989,"_2816":51048},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3328":1161,"_29138":1136,"_20209":51050,"_5":13819,"_26493":50989,"_2816":51051},[],"Lost or inaccessible key",{"_3328":1162,"_29138":1136,"_20209":51053,"_5":13819,"_26493":50989,"_2816":51054},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3328":1163,"_29138":1136,"_20209":51056,"_5":13819,"_26493":50989,"_2816":51057},[],"Current identity revoked",{"_3328":1164,"_29138":1136,"_20209":51059,"_5":13819,"_26493":50989,"_2816":51060},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3328":1165,"_29138":1136,"_20209":51062,"_5":13819,"_26493":50989,"_2816":51063},[],"Device without an identity",{"_3328":1166,"_29138":1136,"_20209":51065,"_5":13819,"_26493":50989,"_2816":51066},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3328":1167,"_29138":1136,"_20209":51068,"_5":13819,"_26493":50989,"_2816":51069},[],"Retired device",{"_3328":1168,"_29138":1136,"_20209":51071,"_5":13819,"_26493":50989,"_2816":51072},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3328":1169,"_29138":1136,"_20209":51074,"_5":13819,"_26493":50989,"_2816":51075},[],"Timeout, HTTP 500 or installation failure",{"_3328":1170,"_29138":1136,"_20209":51077,"_5":13819,"_26493":50989,"_2816":51078},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3328":1171,"_29138":1136,"_20209":51080,"_5":13819,"_26493":50993,"_2816":51081},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3328":1172,"_29138":1136,"_20209":51083,"_5":13819,"_26493":50993,"_2816":51084},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3328":1173,"_29138":1173,"_5":14177,"_2816":51086,"_29482":51087,"_20209":51088,"_26493":1173},"Enrollment troubleshooting",[47429,48897,49905,49903,50086],[],{"_3328":1174,"_29138":1173,"_20209":51090,"_5":13819,"_26493":1173,"_2816":51091},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3328":1175,"_29138":1173,"_5":29479,"_20209":51093,"_26493":51094,"_2816":51095},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3328":1176,"_29138":1173,"_5":29479,"_20209":51097,"_26493":51098,"_2816":51099},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3328":1177,"_29138":1173,"_5":29479,"_20209":51101,"_26493":51102,"_2816":50649},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3328":1178,"_29138":1173,"_5":29479,"_20209":51104,"_26493":51105,"_2816":51106},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3328":1179,"_29138":1173,"_20209":51108,"_5":13819,"_26493":1173,"_2816":51109},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3328":1180,"_29138":1173,"_20209":51111,"_5":13819,"_26493":51098,"_2816":51112},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3328":1181,"_29138":1173,"_20209":51114,"_5":13819,"_26493":51098,"_2816":51115},[],"Symptom or message",{"_3328":1182,"_29138":1173,"_20209":51117,"_5":13819,"_26493":51098,"_2816":50879},[],{"_3328":1183,"_29138":1173,"_20209":51119,"_5":13819,"_26493":51098,"_2816":51120},[],"curl rejects TLS, name or issuer",{"_3328":1184,"_29138":1173,"_20209":51122,"_5":13819,"_26493":51098,"_2816":51123},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3328":1185,"_29138":1173,"_20209":51125,"_5":13819,"_26493":51098,"_2816":51126},[],"404 or missing APS",{"_3328":1186,"_29138":1173,"_20209":51128,"_5":13819,"_26493":51098,"_2816":51129},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3328":1187,"_29138":1173,"_20209":51131,"_5":13819,"_26493":51098,"_2816":51132},[],"400, CSR or format error",{"_3328":1188,"_29138":1173,"_20209":51134,"_5":13819,"_26493":51098,"_2816":51135},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3328":1189,"_29138":1173,"_20209":51137,"_5":13819,"_26493":51098,"_2816":51138},[],"Missing credential or invalid certificate",{"_3328":1190,"_29138":1173,"_20209":51140,"_5":13819,"_26493":51098,"_2816":51141},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3328":1191,"_29138":1173,"_20209":51143,"_5":13819,"_26493":51098,"_2816":51144},[],"Webhook denies, times out or responds without authorization",{"_3328":1192,"_29138":1173,"_20209":51146,"_5":13819,"_26493":51098,"_2816":51147},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3328":1193,"_29138":1173,"_20209":51149,"_5":13819,"_26493":51098,"_2816":51150},[],"`unexpected status code: <n>: redirects are not followed`",{"_3328":1194,"_29138":1173,"_20209":51152,"_5":13819,"_26493":51098,"_2816":51153},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3328":1195,"_29138":1173,"_20209":51155,"_5":13819,"_26493":51098,"_2816":51156},[],"`webhook response exceeds 1048576 bytes`",{"_3328":1196,"_29138":1173,"_20209":51158,"_5":13819,"_26493":51098,"_2816":51159},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3328":1197,"_29138":1173,"_20209":51161,"_5":13819,"_26493":51098,"_2816":51162},[],"`webhook config must not reference files`",{"_3328":1198,"_29138":1173,"_20209":51164,"_5":13819,"_26493":51098,"_2816":51165},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3328":1199,"_29138":1173,"_20209":51167,"_5":13819,"_26493":51098,"_2816":51168},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3328":1200,"_29138":1173,"_20209":51170,"_5":13819,"_26493":51098,"_2816":51171},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3328":1201,"_29138":1173,"_20209":51173,"_5":13819,"_26493":51098,"_2816":51174},[],"`webhook mTLS certificate and key are invalid: …`",{"_3328":1202,"_29138":1173,"_20209":51176,"_5":13819,"_26493":51098,"_2816":51177},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3328":1203,"_29138":1173,"_20209":51179,"_5":13819,"_26493":51098,"_2816":51180},[],"400 `struct validation error` creating or updating a DMS",{"_3328":1204,"_29138":1173,"_20209":51182,"_5":13819,"_26493":51098,"_2816":51183},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3328":1205,"_29138":1173,"_20209":51185,"_5":13819,"_26493":51098,"_2816":51186},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3328":1206,"_29138":1173,"_20209":51188,"_5":13819,"_26493":51098,"_2816":51189},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3328":1207,"_29138":1173,"_20209":51191,"_5":13819,"_26493":51098,"_2816":51192},[],"`device not preregistered`",{"_3328":1208,"_29138":1173,"_20209":51194,"_5":13819,"_26493":51098,"_2816":51195},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3328":1209,"_29138":1173,"_20209":51197,"_5":13819,"_26493":51098,"_2816":51198},[],"`forbiddenNewEnrollment`",{"_3328":1210,"_29138":1173,"_20209":51200,"_5":13819,"_26493":51098,"_2816":51201},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3328":1211,"_29138":1173,"_20209":51203,"_5":13819,"_26493":51098,"_2816":51204},[],"Different owning DMS",{"_3328":1212,"_29138":1173,"_20209":51206,"_5":13819,"_26493":51098,"_2816":51207},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3328":1213,"_29138":1173,"_20209":51209,"_5":13819,"_26493":51098,"_2816":51210},[],"`invalid RawSubject bytes`",{"_3328":1214,"_29138":1173,"_20209":51212,"_5":13819,"_26493":51098,"_2816":51213},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3328":1215,"_29138":1173,"_20209":51215,"_5":13819,"_26493":51098,"_2816":51216},[],"`invalid reenroll window`",{"_3328":1216,"_29138":1173,"_20209":51218,"_5":13819,"_26493":51098,"_2816":51219},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3328":1217,"_29138":1173,"_20209":51221,"_5":13819,"_26493":51098,"_2816":51222},[],"Current certificate revoked",{"_3328":1218,"_29138":1173,"_20209":51224,"_5":13819,"_26493":51098,"_2816":51225},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3328":1219,"_29138":1173,"_20209":51227,"_5":13819,"_26493":51098,"_2816":51228},[],"CA, profile or signing error",{"_3328":1220,"_29138":1173,"_20209":51230,"_5":13819,"_26493":51098,"_2816":51231},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3328":1221,"_29138":1173,"_20209":51233,"_5":13819,"_26493":51098,"_2816":51234},[],"HTTP 200 without a device connection",{"_3328":1222,"_29138":1173,"_20209":51236,"_5":13819,"_26493":51098,"_2816":51237},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3328":1223,"_29138":1173,"_20209":51239,"_5":13819,"_26493":51098,"_2816":51240},[],"Timeout or error after issuance",{"_3328":1224,"_29138":1173,"_20209":51242,"_5":13819,"_26493":51098,"_2816":51243},[],"New certificates, current slot and previous identity's state before retrying.",{"_3328":1225,"_29138":1173,"_20209":51245,"_5":13819,"_26493":51102,"_2816":51246},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3328":1226,"_29138":1173,"_20209":51248,"_5":13819,"_26493":51102,"_2816":51249},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3328":1227,"_29138":1173,"_20209":51251,"_5":13819,"_26493":51105,"_2816":51252},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3328":1228,"_29138":1173,"_20209":51254,"_5":13819,"_26493":51105,"_2816":51255},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3328":1229,"_29138":1173,"_20209":51257,"_5":13819,"_26493":51105,"_2816":51258},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3328":1230,"_29138":1173,"_20209":51260,"_5":13819,"_26493":51105,"_2816":51261},[],"Make one request, save headers/body and query the device and certificates.",{"_3328":1231,"_29138":1173,"_20209":51263,"_5":13819,"_26493":51105,"_2816":51264},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3328":1232,"_29138":1173,"_20209":51266,"_5":13819,"_26493":51105,"_2816":51267},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3328":1233,"_29138":1173,"_20209":51269,"_5":13819,"_26493":51105,"_2816":51270},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3328":1234,"_29138":1234,"_5":14177,"_2816":51272,"_29482":51273,"_20209":51274,"_26493":1234},"Trust distribution and updates",[47429,48897,49905,49903,50086],[],{"_3328":1235,"_29138":1234,"_20209":51276,"_5":13819,"_26493":1234,"_2816":51277},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3328":1236,"_29138":1234,"_5":29479,"_20209":51279,"_26493":51280,"_2816":51281},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3328":1237,"_29138":1234,"_5":29479,"_20209":51283,"_26493":51284,"_2816":51285},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3328":1238,"_29138":1234,"_5":29479,"_20209":51287,"_26493":51288,"_2816":51289},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3328":1239,"_29138":1234,"_5":29479,"_20209":51291,"_26493":51292,"_2816":51293},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3328":1240,"_29138":1234,"_5":29479,"_20209":51295,"_26493":51296,"_2816":51297},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3328":1241,"_29138":1234,"_20209":51299,"_5":13819,"_26493":1234,"_2816":51300},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3328":1242,"_29138":1234,"_20209":51302,"_5":13819,"_26493":51280,"_2816":51303},[],"Relationship",{"_3328":1243,"_29138":1234,"_20209":51305,"_5":13819,"_26493":51280,"_2816":51306},[],"Material prepared by its owner",{"_3328":1244,"_29138":1234,"_20209":51308,"_5":13819,"_26493":51280,"_2816":51309},[],"Device → EST server",{"_3328":1245,"_29138":1234,"_20209":51311,"_5":13819,"_26493":51280,"_2816":51312},[],"Previously verified server root, chain or pin and TLS name.",{"_3328":1246,"_29138":1234,"_20209":51314,"_5":13819,"_26493":51280,"_2816":51315},[],"DMS → requester",{"_3328":1247,"_29138":1234,"_20209":51317,"_5":13819,"_26493":51280,"_2816":51318},[],"CAs and rules authorizing initial or renewal credentials.",{"_3328":1248,"_29138":1234,"_20209":51320,"_5":13819,"_26493":51280,"_2816":51321},[],"Consumer → device",{"_3328":1249,"_29138":1234,"_20209":51323,"_5":13819,"_26493":51280,"_2816":51324},[],"Operational identity roots, intermediates, validation and permissions.",{"_3328":1250,"_29138":1234,"_20209":51326,"_5":13819,"_26493":51280,"_2816":51327},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3328":1251,"_29138":1234,"_20209":51329,"_5":13819,"_26493":51284,"_2816":51330},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3328":1252,"_29138":1234,"_20209":51332,"_5":13819,"_26493":51284,"_2816":51333},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3328":1253,"_29138":1234,"_20209":51335,"_5":13819,"_26493":51288,"_2816":51336},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3328":1254,"_29138":1234,"_20209":51338,"_5":13819,"_26493":51288,"_2816":51339},[],"Select policy-approved roots as anchors.",{"_3328":1255,"_29138":1234,"_20209":51341,"_5":13819,"_26493":51288,"_2816":51342},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3328":1256,"_29138":1234,"_20209":51344,"_5":13819,"_26493":51288,"_2816":51345},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3328":1257,"_29138":1234,"_20209":51347,"_5":13819,"_26493":51288,"_2816":51348},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3328":1258,"_29138":1234,"_20209":51350,"_5":13819,"_26493":51288,"_2816":51351},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3328":1259,"_29138":1234,"_20209":51353,"_5":13819,"_26493":51292,"_2816":51354},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3328":1260,"_29138":1234,"_20209":51356,"_5":13819,"_26493":51292,"_2816":51357},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3328":1261,"_29138":1234,"_20209":51359,"_5":13819,"_26493":51292,"_2816":51360},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3328":1262,"_29138":1234,"_20209":51362,"_5":13819,"_26493":51296,"_2816":51363},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3328":1263,"_29138":1263,"_5":14177,"_2816":51365,"_29482":51366,"_20209":51368,"_26493":1263},"AWS IoT Core",[47429,48897,49905,49903,51367],"Integrations",[],{"_3328":1264,"_29138":1263,"_20209":51370,"_5":13819,"_26493":1263,"_2816":51371},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3328":1265,"_29138":1263,"_5":29479,"_20209":51373,"_26493":51374,"_2816":51375},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3328":1266,"_29138":1263,"_5":29479,"_20209":51377,"_26493":51378,"_2816":51379},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3328":1267,"_29138":1263,"_5":29479,"_20209":51381,"_26493":51382,"_2816":51383},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3328":1268,"_29138":1263,"_5":29479,"_20209":51385,"_26493":51386,"_2816":51387},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3328":1269,"_29138":1263,"_5":29479,"_20209":51389,"_26493":51390,"_2816":51391},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#resource-state-machine","Resource state machine",{"_3328":1270,"_29138":1263,"_5":29479,"_20209":51393,"_26493":51394,"_2816":51395},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#events-the-connector-handles","Events the connector handles",{"_3328":1271,"_29138":1263,"_5":29479,"_20209":51397,"_26493":51398,"_2816":51399},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3328":1272,"_29138":1263,"_5":29479,"_20209":51401,"_26493":51402,"_2816":51403},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3328":1273,"_29138":1263,"_5":29479,"_20209":51405,"_26493":51406,"_2816":51407},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3328":1274,"_29138":1263,"_5":29479,"_20209":51409,"_26493":51410,"_2816":51411},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3328":1275,"_29138":1263,"_5":29479,"_20209":51413,"_26493":51414,"_2816":51415},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3328":1276,"_29138":1263,"_5":29479,"_20209":51417,"_26493":51418,"_2816":51419},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3328":1277,"_29138":1263,"_5":29479,"_20209":51421,"_26493":51422,"_2816":51423},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3328":1278,"_29138":1263,"_5":29479,"_20209":51425,"_26493":51426,"_2816":51427},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3328":1279,"_29138":1263,"_5":29479,"_20209":51429,"_26493":51430,"_2816":51431},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3328":1280,"_29138":1263,"_5":29479,"_20209":51433,"_26493":51434,"_2816":51435},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3328":1281,"_29138":1263,"_5":29479,"_20209":51437,"_26493":51438,"_2816":51439},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3328":1282,"_29138":1263,"_5":29479,"_20209":51441,"_26493":51442,"_2816":51443},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3328":1283,"_29138":1263,"_5":29479,"_20209":51445,"_26493":51446,"_2816":51447},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3328":1284,"_29138":1263,"_5":29479,"_20209":51449,"_26493":51450,"_2816":51451},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3328":1285,"_29138":1263,"_5":29479,"_20209":51453,"_26493":51454,"_2816":51455},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3328":1286,"_29138":1263,"_5":29479,"_20209":51457,"_26493":51458,"_2816":51459},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3328":1287,"_29138":1263,"_5":29479,"_20209":51461,"_26493":51462,"_2816":51463},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3328":1288,"_29138":1263,"_5":29479,"_20209":51465,"_26493":51466,"_2816":51467},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3328":1289,"_29138":1263,"_5":29479,"_20209":51469,"_26493":51470,"_2816":51471},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3328":1290,"_29138":1263,"_5":29479,"_20209":51473,"_26493":51474,"_2816":51475},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3328":1291,"_29138":1263,"_20209":51477,"_5":13819,"_26493":1263,"_2816":51478},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3328":1292,"_29138":1263,"_20209":51480,"_5":13819,"_26493":1263,"_2816":51481},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3328":1293,"_29138":1263,"_20209":51483,"_5":13819,"_26493":1263,"_2816":51484},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3328":1294,"_29138":1263,"_20209":51486,"_5":13819,"_26493":51374,"_2816":51487},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3328":1295,"_29138":1263,"_20209":51489,"_5":13819,"_26493":51374,"_2816":51490},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3328":1296,"_29138":1263,"_20209":51492,"_5":13819,"_26493":51374,"_2816":51493},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3328":1297,"_29138":1263,"_20209":51495,"_5":13819,"_26493":51374,"_2816":51496},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3328":1298,"_29138":1263,"_20209":51498,"_5":13819,"_26493":51378,"_2816":51499},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3328":1299,"_29138":1263,"_20209":51501,"_5":13819,"_26493":51382,"_2816":51502},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3328":1300,"_29138":1263,"_20209":51504,"_5":13819,"_26493":51382,"_2816":51505},[],"IAM action",{"_3328":1301,"_29138":1263,"_20209":51507,"_5":13819,"_26493":51382,"_2816":47819},[],{"_3328":1302,"_29138":1263,"_20209":51509,"_5":13819,"_26493":51382,"_2816":51510},[],"`iot:GetRegistrationCode`",{"_3328":1303,"_29138":1263,"_20209":51512,"_5":13819,"_26493":51382,"_2816":51513},[],"Obtain the verification code for CA registration in the Primary Account",{"_3328":1304,"_29138":1263,"_20209":51515,"_5":13819,"_26493":51382,"_2816":51516},[],"`iot:RegisterCACertificate`",{"_3328":1305,"_29138":1263,"_20209":51518,"_5":13819,"_26493":51382,"_2816":51519},[],"Register the CA in AWS IoT",{"_3328":1306,"_29138":1263,"_20209":51521,"_5":13819,"_26493":51382,"_2816":51522},[],"`iot:DescribeCACertificate`",{"_3328":1307,"_29138":1263,"_20209":51524,"_5":13819,"_26493":51382,"_2816":51525},[],"Check the CA registration status",{"_3328":1308,"_29138":1263,"_20209":51527,"_5":13819,"_26493":51382,"_2816":51528},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3328":1309,"_29138":1263,"_20209":51530,"_5":13819,"_26493":51382,"_2816":51531},[],"Create or update Things in IoT Core",{"_3328":1310,"_29138":1263,"_20209":51533,"_5":13819,"_26493":51382,"_2816":51534},[],"`iot:RegisterThing`",{"_3328":1311,"_29138":1263,"_20209":51536,"_5":13819,"_26493":51382,"_2816":51537},[],"Provision Things through a template",{"_3328":1312,"_29138":1263,"_20209":51539,"_5":13819,"_26493":51382,"_2816":51540},[],"`iot:RegisterCertificate`",{"_3328":1313,"_29138":1263,"_20209":51542,"_5":13819,"_26493":51382,"_2816":51543},[],"Register device certificates",{"_3328":1314,"_29138":1263,"_20209":51545,"_5":13819,"_26493":51382,"_2816":51546},[],"`iot:UpdateCertificate`",{"_3328":1315,"_29138":1263,"_20209":51548,"_5":13819,"_26493":51382,"_2816":51549},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3328":1316,"_29138":1263,"_20209":51551,"_5":13819,"_26493":51382,"_2816":51552},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3328":1317,"_29138":1263,"_20209":51554,"_5":13819,"_26493":51382,"_2816":51555},[],"Create and attach IoT policies",{"_3328":1318,"_29138":1263,"_20209":51557,"_5":13819,"_26493":51382,"_2816":51558},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3328":1319,"_29138":1263,"_20209":51560,"_5":13819,"_26493":51382,"_2816":51561},[],"Manage Thing groups",{"_3328":1320,"_29138":1263,"_20209":51563,"_5":13819,"_26493":51382,"_2816":51564},[],"`iot:CreateProvisioningTemplate`",{"_3328":1321,"_29138":1263,"_20209":51566,"_5":13819,"_26493":51382,"_2816":51567},[],"Create JITP templates",{"_3328":1322,"_29138":1263,"_20209":51569,"_5":13819,"_26493":51382,"_2816":51570},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3328":1323,"_29138":1263,"_20209":51572,"_5":13819,"_26493":51382,"_2816":51573},[],"Read and write the Device Shadow",{"_3328":1324,"_29138":1263,"_20209":51575,"_5":13819,"_26493":51382,"_2816":51576},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3328":1325,"_29138":1263,"_20209":51578,"_5":13819,"_26493":51386,"_2816":51579},[],"Parameter",{"_3328":1326,"_29138":1263,"_20209":51581,"_5":13819,"_26493":51386,"_2816":51582},[],"Type",{"_3328":1327,"_29138":1263,"_20209":51584,"_5":13819,"_26493":51386,"_2816":51585},[],"Required",{"_3328":1328,"_29138":1263,"_20209":51587,"_5":13819,"_26493":51386,"_2816":51588},[],"Description",{"_3328":1329,"_29138":1263,"_20209":51590,"_5":13819,"_26493":51386,"_2816":51591},[],"`connector_id`",{"_3328":1330,"_29138":1263,"_20209":51593,"_5":13819,"_26493":51386,"_2816":24136},[],{"_3328":1331,"_29138":1263,"_20209":51595,"_5":13819,"_26493":51386,"_2816":51596},[],"Yes",{"_3328":1332,"_29138":1263,"_20209":51598,"_5":13819,"_26493":51386,"_2816":51599},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3328":1333,"_29138":1263,"_20209":51601,"_5":13819,"_26493":51386,"_2816":51602},[],"`aws_config.region`",{"_3328":1334,"_29138":1263,"_20209":51604,"_5":13819,"_26493":51386,"_2816":24136},[],{"_3328":1335,"_29138":1263,"_20209":51606,"_5":13819,"_26493":51386,"_2816":51596},[],{"_3328":1336,"_29138":1263,"_20209":51608,"_5":13819,"_26493":51386,"_2816":51609},[],"AWS region where the connector operates.",{"_3328":1337,"_29138":1263,"_20209":51611,"_5":13819,"_26493":51386,"_2816":51612},[],"`aws_config.auth_method`",{"_3328":1338,"_29138":1263,"_20209":51614,"_5":13819,"_26493":51386,"_2816":24136},[],{"_3328":1339,"_29138":1263,"_20209":51616,"_5":13819,"_26493":51386,"_2816":51596},[],{"_3328":1340,"_29138":1263,"_20209":51618,"_5":13819,"_26493":51386,"_2816":51619},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3328":1341,"_29138":1263,"_20209":51621,"_5":13819,"_26493":51386,"_2816":51622},[],"`aws_config.access_key_id`",{"_3328":1342,"_29138":1263,"_20209":51624,"_5":13819,"_26493":51386,"_2816":24136},[],{"_3328":1343,"_29138":1263,"_20209":51626,"_5":13819,"_26493":51386,"_2816":51627},[],"Only with `auth_method=static`",{"_3328":1344,"_29138":1263,"_20209":51629,"_5":13819,"_26493":51386,"_2816":51630},[],"AWS access key.",{"_3328":1345,"_29138":1263,"_20209":51632,"_5":13819,"_26493":51386,"_2816":51633},[],"`aws_config.secret_access_key`",{"_3328":1346,"_29138":1263,"_20209":51635,"_5":13819,"_26493":51386,"_2816":24136},[],{"_3328":1347,"_29138":1263,"_20209":51637,"_5":13819,"_26493":51386,"_2816":51627},[],{"_3328":1348,"_29138":1263,"_20209":51639,"_5":13819,"_26493":51386,"_2816":51640},[],"AWS secret key.",{"_3328":1349,"_29138":1263,"_20209":51642,"_5":13819,"_26493":51386,"_2816":51643},[],"`aws_config.session_token`",{"_3328":1350,"_29138":1263,"_20209":51645,"_5":13819,"_26493":51386,"_2816":24136},[],{"_3328":1351,"_29138":1263,"_20209":51647,"_5":13819,"_26493":51386,"_2816":51648},[],"No",{"_3328":1352,"_29138":1263,"_20209":51650,"_5":13819,"_26493":51386,"_2816":51651},[],"Session token (with `auth_method=static`).",{"_3328":1353,"_29138":1263,"_20209":51653,"_5":13819,"_26493":51386,"_2816":51654},[],"`aws_config.role_arn`",{"_3328":1354,"_29138":1263,"_20209":51656,"_5":13819,"_26493":51386,"_2816":24136},[],{"_3328":1355,"_29138":1263,"_20209":51658,"_5":13819,"_26493":51386,"_2816":51659},[],"Only with `auth_method=role`",{"_3328":1356,"_29138":1263,"_20209":51661,"_5":13819,"_26493":51386,"_2816":51662},[],"ARN of the role to assume.",{"_3328":1357,"_29138":1263,"_20209":51664,"_5":13819,"_26493":51386,"_2816":51665},[],"`aws_config.endpoint_url`",{"_3328":1358,"_29138":1263,"_20209":51667,"_5":13819,"_26493":51386,"_2816":24136},[],{"_3328":1359,"_29138":1263,"_20209":51669,"_5":13819,"_26493":51386,"_2816":51648},[],{"_3328":1360,"_29138":1263,"_20209":51671,"_5":13819,"_26493":51386,"_2816":51672},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3328":1361,"_29138":1263,"_20209":51674,"_5":13819,"_26493":51386,"_2816":51675},[],"`subscriber_event_bus`",{"_3328":1362,"_29138":1263,"_20209":51677,"_5":13819,"_26493":51386,"_2816":16975},[],{"_3328":1363,"_29138":1263,"_20209":51679,"_5":13819,"_26493":51386,"_2816":51596},[],{"_3328":1364,"_29138":1263,"_20209":51681,"_5":13819,"_26493":51386,"_2816":51682},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3328":1365,"_29138":1263,"_20209":51684,"_5":13819,"_26493":51386,"_2816":51685},[],"`dms_manager_client`",{"_3328":1366,"_29138":1263,"_20209":51687,"_5":13819,"_26493":51386,"_2816":24136},[],{"_3328":1367,"_29138":1263,"_20209":51689,"_5":13819,"_26493":51386,"_2816":51596},[],{"_3328":1368,"_29138":1263,"_20209":51691,"_5":13819,"_26493":51386,"_2816":51692},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3328":1369,"_29138":1263,"_20209":51694,"_5":13819,"_26493":51386,"_2816":51695},[],"`device_manager_client`",{"_3328":1370,"_29138":1263,"_20209":51697,"_5":13819,"_26493":51386,"_2816":24136},[],{"_3328":1371,"_29138":1263,"_20209":51699,"_5":13819,"_26493":51386,"_2816":51596},[],{"_3328":1372,"_29138":1263,"_20209":51701,"_5":13819,"_26493":51386,"_2816":51702},[],"HTTP URL of Lamassu's Device Manager.",{"_3328":1373,"_29138":1263,"_20209":51704,"_5":13819,"_26493":51386,"_2816":51705},[],"`ca_client`",{"_3328":1374,"_29138":1263,"_20209":51707,"_5":13819,"_26493":51386,"_2816":24136},[],{"_3328":1375,"_29138":1263,"_20209":51709,"_5":13819,"_26493":51386,"_2816":51596},[],{"_3328":1376,"_29138":1263,"_20209":51711,"_5":13819,"_26493":51386,"_2816":51712},[],"HTTP URL of Lamassu's CA service.",{"_3328":1377,"_29138":1263,"_20209":51714,"_5":13819,"_26493":51390,"_2816":51715},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each transition performs. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3328":1378,"_29138":1263,"_20209":51717,"_5":13819,"_26493":51394,"_2816":51718},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3328":1379,"_29138":1263,"_20209":51720,"_5":13819,"_26493":51394,"_2816":51721},[],"CloudEvent type",{"_3328":1380,"_29138":1263,"_20209":51723,"_5":13819,"_26493":51394,"_2816":51724},[],"Lamassu resource",{"_3328":1381,"_29138":1263,"_20209":51726,"_5":13819,"_26493":51394,"_2816":51727},[],"AWS Resource",{"_3328":1382,"_29138":1263,"_20209":51729,"_5":13819,"_26493":51394,"_2816":51730},[],"IAM actions",{"_3328":1383,"_29138":1263,"_20209":51732,"_5":13819,"_26493":51394,"_2816":51733},[],"AWS calls and effect",{"_3328":1384,"_29138":1263,"_20209":51735,"_5":13819,"_26493":51394,"_2816":51736},[],"Where in this page",{"_3328":1385,"_29138":1263,"_20209":51738,"_5":13819,"_26493":51394,"_2816":51739},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3328":1386,"_29138":1263,"_20209":51741,"_5":13819,"_26493":51394,"_2816":51742},[],"CA",{"_3328":1387,"_29138":1263,"_20209":51744,"_5":13819,"_26493":51394,"_2816":51745},[],"`IoTCore/CACertificate`",{"_3328":1388,"_29138":1263,"_20209":51747,"_5":13819,"_26493":51394,"_2816":51748},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3328":1389,"_29138":1263,"_20209":51750,"_5":13819,"_26493":51394,"_2816":51751},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3328":1390,"_29138":1263,"_20209":51753,"_5":13819,"_26493":51394,"_2816":51399},[],{"_3328":1391,"_29138":1263,"_20209":51755,"_5":13819,"_26493":51394,"_2816":51756},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3328":1392,"_29138":1263,"_20209":51758,"_5":13819,"_26493":51394,"_2816":51759},[],"DMS",{"_3328":1393,"_29138":1263,"_20209":51761,"_5":13819,"_26493":51394,"_2816":51762},[],"`IoTCore/ProvisioningTemplate`",{"_3328":1394,"_29138":1263,"_20209":51764,"_5":13819,"_26493":51394,"_2816":51765},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3328":1395,"_29138":1263,"_20209":51767,"_5":13819,"_26493":51394,"_2816":51768},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3328":1396,"_29138":1263,"_20209":51770,"_5":13819,"_26493":51394,"_2816":51403},[],{"_3328":1397,"_29138":1263,"_20209":51772,"_5":13819,"_26493":51394,"_2816":51773},[],"`EventBindDeviceIdentityKey`",{"_3328":1398,"_29138":1263,"_20209":51775,"_5":13819,"_26493":51394,"_2816":51776},[],"Device",{"_3328":1399,"_29138":1263,"_20209":51778,"_5":13819,"_26493":51394,"_2816":51779},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3328":1400,"_29138":1263,"_20209":51781,"_5":13819,"_26493":51394,"_2816":51782},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3328":1401,"_29138":1263,"_20209":51784,"_5":13819,"_26493":51394,"_2816":51785},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3328":1402,"_29138":1263,"_20209":51787,"_5":13819,"_26493":51394,"_2816":51411},[],{"_3328":1403,"_29138":1263,"_20209":51789,"_5":13819,"_26493":51394,"_2816":51790},[],"`EventUpdateCertificateStatusKey`",{"_3328":1404,"_29138":1263,"_20209":51792,"_5":13819,"_26493":51394,"_2816":51793},[],"Certificate",{"_3328":1405,"_29138":1263,"_20209":51795,"_5":13819,"_26493":51394,"_2816":51796},[],"`IoTCore/Certificate`",{"_3328":1406,"_29138":1263,"_20209":51798,"_5":13819,"_26493":51394,"_2816":51799},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3328":1407,"_29138":1263,"_20209":51801,"_5":13819,"_26493":51394,"_2816":51802},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3328":1408,"_29138":1263,"_20209":51804,"_5":13819,"_26493":51394,"_2816":51407},[],{"_3328":1409,"_29138":1263,"_20209":51806,"_5":13819,"_26493":51394,"_2816":51807},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3328":1410,"_29138":1263,"_20209":51809,"_5":13819,"_26493":51394,"_2816":51810},[],"Certificate / Device",{"_3328":1411,"_29138":1263,"_20209":51812,"_5":13819,"_26493":51394,"_2816":51813},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3328":1412,"_29138":1263,"_20209":51815,"_5":13819,"_26493":51394,"_2816":47825},[],{"_3328":1413,"_29138":1263,"_20209":51817,"_5":13819,"_26493":51394,"_2816":51818},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3328":1414,"_29138":1263,"_20209":51820,"_5":13819,"_26493":51394,"_2816":51463},[],{"_3328":1415,"_29138":1263,"_20209":51822,"_5":13819,"_26493":51398,"_2816":51823},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3328":1416,"_29138":1263,"_20209":51825,"_5":13819,"_26493":51398,"_2816":51826},[],"by the `registration.status` field of the CA's connector metadata:",{"_3328":1417,"_29138":1263,"_20209":51828,"_5":13819,"_26493":51398,"_2816":51829},[],"Transition",{"_3328":1418,"_29138":1263,"_20209":51831,"_5":13819,"_26493":51398,"_2816":51832},[],"AWS calls",{"_3328":1419,"_29138":1263,"_20209":51834,"_5":13819,"_26493":51398,"_2816":51835},[],"`NotRegistered` → `Requested`",{"_3328":1420,"_29138":1263,"_20209":51837,"_5":13819,"_26493":51398,"_2816":51838},[],"none (metadata write only)",{"_3328":1421,"_29138":1263,"_20209":51840,"_5":13819,"_26493":51398,"_2816":51841},[],"`Requested` → `Registering`",{"_3328":1422,"_29138":1263,"_20209":51843,"_5":13819,"_26493":51398,"_2816":51844},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3328":1423,"_29138":1263,"_20209":51846,"_5":13819,"_26493":51398,"_2816":51847},[],"`Registering` → `Succeeded`",{"_3328":1424,"_29138":1263,"_20209":51849,"_5":13819,"_26493":51398,"_2816":51850},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3328":1425,"_29138":1263,"_20209":51852,"_5":13819,"_26493":51398,"_2816":51853},[],"`Registering` → `Failed`",{"_3328":1426,"_29138":1263,"_20209":51855,"_5":13819,"_26493":51398,"_2816":51856},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3328":1427,"_29138":1263,"_20209":51858,"_5":13819,"_26493":51398,"_2816":51859},[],"`Failed` / `Succeeded` → `Requested`",{"_3328":1428,"_29138":1263,"_20209":51861,"_5":13819,"_26493":51398,"_2816":51862},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3328":1429,"_29138":1263,"_20209":51864,"_5":13819,"_26493":51402,"_2816":51865},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3328":1430,"_29138":1263,"_20209":51867,"_5":13819,"_26493":51402,"_2816":51829},[],{"_3328":1431,"_29138":1263,"_20209":51869,"_5":13819,"_26493":51402,"_2816":51832},[],{"_3328":1432,"_29138":1263,"_20209":51871,"_5":13819,"_26493":51402,"_2816":51872},[],"`Unconfigured` → `None` / `Auto`",{"_3328":1433,"_29138":1263,"_20209":51874,"_5":13819,"_26493":51402,"_2816":51875},[],"none (configuration only)",{"_3328":1434,"_29138":1263,"_20209":51877,"_5":13819,"_26493":51402,"_2816":51878},[],"`None` ↔ `Auto`",{"_3328":1435,"_29138":1263,"_20209":51880,"_5":13819,"_26493":51402,"_2816":51875},[],{"_3328":1436,"_29138":1263,"_20209":51882,"_5":13819,"_26493":51402,"_2816":51883},[],"Any → `Jitp`",{"_3328":1437,"_29138":1263,"_20209":51885,"_5":13819,"_26493":51402,"_2816":51886},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3328":1438,"_29138":1263,"_20209":51888,"_5":13819,"_26493":51402,"_2816":51889},[],"`Jitp` → `None` / `Auto`",{"_3328":1439,"_29138":1263,"_20209":51891,"_5":13819,"_26493":51402,"_2816":51892},[],"none (the template stays in the AWS account)",{"_3328":1440,"_29138":1263,"_20209":51894,"_5":13819,"_26493":51406,"_2816":51895},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3328":1441,"_29138":1263,"_20209":51897,"_5":13819,"_26493":51406,"_2816":51829},[],{"_3328":1442,"_29138":1263,"_20209":51899,"_5":13819,"_26493":51406,"_2816":51832},[],{"_3328":1443,"_29138":1263,"_20209":51901,"_5":13819,"_26493":51406,"_2816":51902},[],"`NotSynced` → `Active`",{"_3328":1444,"_29138":1263,"_20209":51904,"_5":13819,"_26493":51406,"_2816":51546},[],{"_3328":1445,"_29138":1263,"_20209":51906,"_5":13819,"_26493":51406,"_2816":51907},[],"`Active` → `Inactive`",{"_3328":1446,"_29138":1263,"_20209":51909,"_5":13819,"_26493":51406,"_2816":51910},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3328":1447,"_29138":1263,"_20209":51912,"_5":13819,"_26493":51406,"_2816":51913},[],"`Active` → `Revoked`",{"_3328":1448,"_29138":1263,"_20209":51915,"_5":13819,"_26493":51406,"_2816":51910},[],{"_3328":1449,"_29138":1263,"_20209":51917,"_5":13819,"_26493":51406,"_2816":51918},[],"`Inactive` / `Revoked` → `Active`",{"_3328":1450,"_29138":1263,"_20209":51920,"_5":13819,"_26493":51406,"_2816":51546},[],{"_3328":1451,"_29138":1263,"_20209":51922,"_5":13819,"_26493":51406,"_2816":51923},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3328":1452,"_29138":1263,"_20209":51925,"_5":13819,"_26493":51406,"_2816":51926},[],"none (these states are not synced to AWS)",{"_3328":1453,"_29138":1263,"_20209":51928,"_5":13819,"_26493":51410,"_2816":51929},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3328":1454,"_29138":1263,"_20209":51931,"_5":13819,"_26493":51410,"_2816":51829},[],{"_3328":1455,"_29138":1263,"_20209":51933,"_5":13819,"_26493":51410,"_2816":51832},[],{"_3328":1456,"_29138":1263,"_20209":51935,"_5":13819,"_26493":51410,"_2816":51936},[],"`Absent` → `Provisioned`",{"_3328":1457,"_29138":1263,"_20209":51938,"_5":13819,"_26493":51410,"_2816":51939},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3328":1458,"_29138":1263,"_20209":51941,"_5":13819,"_26493":51410,"_2816":51942},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3328":1459,"_29138":1263,"_20209":51944,"_5":13819,"_26493":51410,"_2816":51945},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3328":1460,"_29138":1263,"_20209":51947,"_5":13819,"_26493":51410,"_2816":51948},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3328":1461,"_29138":1263,"_20209":51950,"_5":13819,"_26493":51414,"_2816":51951},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3328":1462,"_29138":1263,"_20209":51953,"_5":13819,"_26493":51418,"_2816":51954},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3328":1463,"_29138":1263,"_20209":51956,"_5":13819,"_26493":51418,"_2816":51957},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3328":1464,"_29138":1263,"_20209":51959,"_5":13819,"_26493":51422,"_2816":51960},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3328":1465,"_29138":1263,"_20209":51962,"_5":13819,"_26493":51422,"_2816":51963},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3328":1466,"_29138":1263,"_20209":51965,"_5":13819,"_26493":51422,"_2816":51966},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3328":1467,"_29138":1263,"_20209":51968,"_5":13819,"_26493":51422,"_2816":51969},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3328":1468,"_29138":1263,"_20209":51971,"_5":13819,"_26493":51422,"_2816":51972},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3328":1469,"_29138":1263,"_20209":51974,"_5":13819,"_26493":51422,"_2816":51975},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3328":1470,"_29138":1263,"_20209":51977,"_5":13819,"_26493":51426,"_2816":51978},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3328":1471,"_29138":1263,"_20209":51980,"_5":13819,"_26493":51430,"_2816":51981},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3328":1472,"_29138":1263,"_20209":51983,"_5":13819,"_26493":51430,"_2816":51984},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3328":1473,"_29138":1263,"_20209":51986,"_5":13819,"_26493":51434,"_2816":51987},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3328":1474,"_29138":1263,"_20209":51989,"_5":13819,"_26493":51438,"_2816":51990},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3328":1475,"_29138":1263,"_20209":51992,"_5":13819,"_26493":51438,"_2816":51993},[],"Creates or updates the IoT policies configured in the DMS.",{"_3328":1476,"_29138":1263,"_20209":51995,"_5":13819,"_26493":51438,"_2816":51996},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3328":1477,"_29138":1263,"_20209":51998,"_5":13819,"_26493":51438,"_2816":51999},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3328":1478,"_29138":1263,"_20209":52001,"_5":13819,"_26493":51438,"_2816":52002},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3328":1479,"_29138":1263,"_20209":52004,"_5":13819,"_26493":51438,"_2816":52005},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3328":1480,"_29138":1263,"_20209":52007,"_5":13819,"_26493":51438,"_2816":52008},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3328":1481,"_29138":1263,"_20209":52010,"_5":13819,"_26493":51442,"_2816":52011},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3328":1482,"_29138":1263,"_20209":52013,"_5":13819,"_26493":51442,"_2816":52014},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3328":1483,"_29138":1263,"_20209":52016,"_5":13819,"_26493":51442,"_2816":52017},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3328":1484,"_29138":1263,"_20209":52019,"_5":13819,"_26493":51442,"_2816":52020},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3328":1485,"_29138":1263,"_20209":52022,"_5":13819,"_26493":51442,"_2816":52023},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3328":1486,"_29138":1263,"_20209":52025,"_5":13819,"_26493":51446,"_2816":52026},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3328":1487,"_29138":1263,"_20209":52028,"_5":13819,"_26493":51446,"_2816":52029},[],"The full flow from the device's perspective is:",{"_3328":1488,"_29138":1263,"_20209":52031,"_5":13819,"_26493":51446,"_2816":52032},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3328":1489,"_29138":1263,"_20209":52034,"_5":13819,"_26493":51450,"_2816":52035},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3328":1490,"_29138":1263,"_20209":52037,"_5":13819,"_26493":51450,"_2816":52038},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3328":1491,"_29138":1263,"_20209":52040,"_5":13819,"_26493":51450,"_2816":52041},[],"For the JITP flow to work correctly:",{"_3328":1492,"_29138":1263,"_20209":52043,"_5":13819,"_26493":51450,"_2816":52044},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3328":1493,"_29138":1263,"_20209":52046,"_5":13819,"_26493":51450,"_2816":52047},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3328":1494,"_29138":1263,"_20209":52049,"_5":13819,"_26493":51450,"_2816":52050},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3328":1495,"_29138":1263,"_20209":52052,"_5":13819,"_26493":51450,"_2816":52053},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3328":1496,"_29138":1263,"_20209":52055,"_5":13819,"_26493":51454,"_2816":52056},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3328":1497,"_29138":1263,"_20209":52058,"_5":13819,"_26493":51454,"_2816":52059},[],"Status in Lamassu",{"_3328":1498,"_29138":1263,"_20209":52061,"_5":13819,"_26493":51454,"_2816":52062},[],"Revocation reason",{"_3328":1499,"_29138":1263,"_20209":52064,"_5":13819,"_26493":51454,"_2816":52065},[],"Status in AWS IoT Core",{"_3328":1500,"_29138":1263,"_20209":52067,"_5":13819,"_26493":51454,"_2816":52068},[],"`Active`",{"_3328":1501,"_29138":1263,"_20209":52070,"_5":13819,"_26493":51454,"_2816":52071},[],"None",{"_3328":1502,"_29138":1263,"_20209":52073,"_5":13819,"_26493":51454,"_2816":52074},[],"`ACTIVE`",{"_3328":1503,"_29138":1263,"_20209":52076,"_5":13819,"_26493":51454,"_2816":52077},[],"`Revoked`",{"_3328":1504,"_29138":1263,"_20209":52079,"_5":13819,"_26493":51454,"_2816":52080},[],"`certificateHold`",{"_3328":1505,"_29138":1263,"_20209":52082,"_5":13819,"_26493":51454,"_2816":52083},[],"`INACTIVE`",{"_3328":1506,"_29138":1263,"_20209":52085,"_5":13819,"_26493":51454,"_2816":52077},[],{"_3328":1507,"_29138":1263,"_20209":52087,"_5":13819,"_26493":51454,"_2816":52088},[],"Any other reason",{"_3328":1508,"_29138":1263,"_20209":52090,"_5":13819,"_26493":51454,"_2816":52091},[],"`REVOKED`",{"_3328":1509,"_29138":1263,"_20209":52093,"_5":13819,"_26493":51454,"_2816":52094},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3328":1510,"_29138":1263,"_20209":52096,"_5":13819,"_26493":51458,"_2816":52097},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3328":1511,"_29138":1263,"_20209":52099,"_5":13819,"_26493":51458,"_2816":52100},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3328":1512,"_29138":1263,"_20209":52102,"_5":13819,"_26493":51458,"_2816":52103},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3328":1513,"_29138":1263,"_20209":52105,"_5":13819,"_26493":51462,"_2816":52106},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3328":1514,"_29138":1263,"_20209":52108,"_5":13819,"_26493":51462,"_2816":52109},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3328":1515,"_29138":1263,"_20209":52111,"_5":13819,"_26493":51466,"_2816":52112},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3328":1516,"_29138":1263,"_20209":52114,"_5":13819,"_26493":51466,"_2816":52115},[],"There are two action types:",{"_3328":1517,"_29138":1263,"_20209":52117,"_5":13819,"_26493":51466,"_2816":52118},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3328":1518,"_29138":1263,"_20209":52120,"_5":13819,"_26493":51466,"_2816":52121},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3328":1519,"_29138":1263,"_20209":52123,"_5":13819,"_26493":51466,"_2816":52124},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3328":1520,"_29138":1263,"_20209":52126,"_5":13819,"_26493":51470,"_2816":52127},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3328":1521,"_29138":1263,"_20209":52129,"_5":13819,"_26493":51470,"_2816":52130},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3328":1522,"_29138":1263,"_20209":52132,"_5":13819,"_26493":51470,"_2816":52133},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3328":1523,"_29138":1263,"_20209":52135,"_5":13819,"_26493":51474,"_2816":52136},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3328":1524,"_29138":1263,"_20209":52138,"_5":13819,"_26493":51474,"_2816":52139},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3328":1525,"_29138":1263,"_20209":52141,"_5":13819,"_26493":51474,"_2816":52142},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3328":1526,"_29138":1263,"_20209":52144,"_5":13819,"_26493":51474,"_2816":52145},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3328":1527,"_29138":1263,"_20209":52147,"_5":13819,"_26493":51474,"_2816":52148},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3328":1528,"_29138":1263,"_20209":52150,"_5":13819,"_26493":51474,"_2816":52151},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3328":1529,"_29138":1263,"_20209":52153,"_5":13819,"_26493":51474,"_2816":52154},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3328":1530,"_29138":1263,"_20209":52156,"_5":13819,"_26493":51474,"_2816":52157},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3328":1531,"_29138":1263,"_20209":52159,"_5":13819,"_26493":51474,"_2816":52160},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3328":1532,"_29138":1263,"_20209":52162,"_5":13819,"_26493":51474,"_2816":52163},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3328":1533,"_29138":1263,"_20209":52165,"_5":13819,"_26493":51474,"_2816":52166},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3328":1534,"_29138":1263,"_20209":52168,"_5":13819,"_26493":51474,"_2816":52169},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3328":1535,"_29138":1263,"_20209":52171,"_5":13819,"_26493":51474,"_2816":52172},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3328":1536,"_29138":1263,"_20209":52174,"_5":13819,"_26493":51474,"_2816":52175},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3328":1537,"_29138":1263,"_20209":52177,"_5":13819,"_26493":51474,"_2816":52178},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3328":1538,"_29138":1263,"_20209":52180,"_5":13819,"_26493":51474,"_2816":52181},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3328":1539,"_29138":1263,"_20209":52183,"_5":13819,"_26493":51474,"_2816":52184},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3328":1540,"_29138":1263,"_20209":52186,"_5":13819,"_26493":51474,"_2816":52187},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3328":1541,"_29138":1263,"_20209":52189,"_5":13819,"_26493":51474,"_2816":52190},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3328":1542,"_29138":1263,"_20209":52192,"_5":13819,"_26493":51474,"_2816":52193},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3328":1543,"_29138":1263,"_20209":52195,"_5":13819,"_26493":51474,"_2816":52196},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3328":1544,"_29138":1263,"_20209":52198,"_5":13819,"_26493":51474,"_2816":52199},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3328":1545,"_29138":1263,"_20209":52201,"_5":13819,"_26493":51474,"_2816":52202},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3328":1546,"_29138":1263,"_20209":52204,"_5":13819,"_26493":51474,"_2816":52205},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3328":1547,"_29138":1547,"_5":14177,"_2816":49905,"_29482":52207,"_20209":52208,"_26493":1547},[47429,48897,49905],[],{"_3328":1548,"_29138":1547,"_20209":52210,"_5":13819,"_26493":1547,"_2816":52211},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3328":1549,"_29138":1547,"_5":29479,"_20209":52213,"_26493":52214,"_2816":52215},[],"/docs/pr-preview/pr-45/platform/iot-fleets/overview#start-here","Start here",{"_3328":1550,"_29138":1547,"_5":29479,"_20209":52217,"_26493":52218,"_2816":49903},[],"/docs/pr-preview/pr-45/platform/iot-fleets/overview#devices-and-identities",{"_3328":1551,"_29138":1547,"_5":29479,"_20209":52220,"_26493":52221,"_2816":50086},[],"/docs/pr-preview/pr-45/platform/iot-fleets/overview#enrollment-with-pki",{"_3328":1552,"_29138":1547,"_5":29479,"_20209":52223,"_26493":52224,"_2816":51367},[],"/docs/pr-preview/pr-45/platform/iot-fleets/overview#integrations",{"_3328":1553,"_29138":1547,"_5":29479,"_20209":52226,"_26493":52227,"_2816":52228},[],"/docs/pr-preview/pr-45/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3328":1554,"_29138":1547,"_20209":52230,"_5":13819,"_26493":1547,"_2816":52231},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3328":1555,"_29138":1547,"_20209":52233,"_5":13819,"_26493":52214,"_2816":52234},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3328":1556,"_29138":1547,"_20209":52236,"_5":13819,"_26493":52214,"_2816":52237},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3328":1557,"_29138":1547,"_20209":52239,"_5":13819,"_26493":52218,"_2816":52240},[],"Resource",{"_3328":1558,"_29138":1547,"_20209":52242,"_5":13819,"_26493":52218,"_2816":52243},[],"What it represents",{"_3328":1559,"_29138":1547,"_20209":52245,"_5":13819,"_26493":52218,"_2816":52246},[],"**Device**",{"_3328":1560,"_29138":1547,"_20209":52248,"_5":13819,"_26493":52218,"_2816":52249},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3328":1561,"_29138":1547,"_20209":52251,"_5":13819,"_26493":52218,"_2816":52252},[],"**Identity**",{"_3328":1562,"_29138":1547,"_20209":52254,"_5":13819,"_26493":52218,"_2816":52255},[],"The device's association with its certificates: an active version and a history.",{"_3328":1563,"_29138":1547,"_20209":52257,"_5":13819,"_26493":52218,"_2816":52258},[],"**DMS**",{"_3328":1564,"_29138":1547,"_20209":52260,"_5":13819,"_26493":52218,"_2816":52261},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3328":1565,"_29138":1547,"_20209":52263,"_5":13819,"_26493":52218,"_2816":52264},[],"**Fleet**",{"_3328":1566,"_29138":1547,"_20209":52266,"_5":13819,"_26493":52218,"_2816":52267},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3328":1567,"_29138":1547,"_20209":52269,"_5":13819,"_26493":52218,"_2816":52270},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3328":1568,"_29138":1547,"_20209":52272,"_5":13819,"_26493":52218,"_2816":52273},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3328":1569,"_29138":1547,"_20209":52275,"_5":13819,"_26493":52221,"_2816":52276},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3328":1570,"_29138":1547,"_20209":52278,"_5":13819,"_26493":52221,"_2816":52279},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3328":1571,"_29138":1547,"_20209":52281,"_5":13819,"_26493":52221,"_2816":52282},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3328":1572,"_29138":1547,"_20209":52284,"_5":13819,"_26493":52221,"_2816":52285},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3328":1573,"_29138":1547,"_20209":52287,"_5":13819,"_26493":52221,"_2816":52288},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3328":1574,"_29138":1547,"_20209":52290,"_5":13819,"_26493":52221,"_2816":52291},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3328":1575,"_29138":1547,"_20209":52293,"_5":13819,"_26493":52221,"_2816":52294},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3328":1576,"_29138":1547,"_20209":52296,"_5":13819,"_26493":52221,"_2816":52297},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3328":1577,"_29138":1547,"_20209":52299,"_5":13819,"_26493":52224,"_2816":52300},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3328":1578,"_29138":1547,"_20209":52302,"_5":13819,"_26493":52224,"_2816":52303},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3328":1579,"_29138":1547,"_20209":52305,"_5":13819,"_26493":52227,"_2816":52306},[],"Participant",{"_3328":1580,"_29138":1547,"_20209":52308,"_5":13819,"_26493":52227,"_2816":52309},[],"Responsibility",{"_3328":1581,"_29138":1547,"_20209":52311,"_5":13819,"_26493":52227,"_2816":52312},[],"PKI administrator",{"_3328":1582,"_29138":1547,"_20209":52314,"_5":13819,"_26493":52227,"_2816":52315},[],"CA, issuance profile, chain and revocation publication.",{"_3328":1583,"_29138":1547,"_20209":52317,"_5":13819,"_26493":52227,"_2816":52318},[],"Provisioning administrator",{"_3328":1584,"_29138":1547,"_20209":52320,"_5":13819,"_26493":52227,"_2816":52321},[],"DMS, admission, authentication per operation and inventory.",{"_3328":1585,"_29138":1547,"_20209":52323,"_5":13819,"_26493":52227,"_2816":52324},[],"Device integrator",{"_3328":1586,"_29138":1547,"_20209":52326,"_5":13819,"_26493":52227,"_2816":52327},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3328":1587,"_29138":1547,"_20209":52329,"_5":13819,"_26493":52227,"_2816":52330},[],"Consumer integrator",{"_3328":1588,"_29138":1547,"_20209":52332,"_5":13819,"_26493":52227,"_2816":52333},[],"Trusted issuers, validation and device permissions in the destination.",{"_3328":1589,"_29138":1547,"_20209":52335,"_5":13819,"_26493":52227,"_2816":52336},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3328":1590,"_29138":1590,"_5":14177,"_2816":52338,"_29482":52339,"_20209":52341,"_26493":1590},"Enroll and connect your first device",[47429,48897,49905,52340],"Getting started",[],{"_3328":1591,"_29138":1590,"_20209":52343,"_5":13819,"_26493":1590,"_2816":52344},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3328":1592,"_29138":1590,"_5":29479,"_20209":52346,"_26493":52347,"_2816":47439},[],"/docs/pr-preview/pr-45/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3328":1593,"_29138":1590,"_5":29479,"_20209":52349,"_26493":52350,"_2816":52351},[],"/docs/pr-preview/pr-45/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3328":1594,"_29138":1590,"_5":29479,"_20209":52353,"_26493":52354,"_2816":52355},[],"/docs/pr-preview/pr-45/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3328":1595,"_29138":1590,"_5":29479,"_20209":52357,"_26493":52358,"_2816":52359},[],"/docs/pr-preview/pr-45/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3328":1596,"_29138":1590,"_5":29479,"_20209":52361,"_26493":52362,"_2816":52363},[],"/docs/pr-preview/pr-45/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3328":1597,"_29138":1590,"_5":29479,"_20209":52365,"_26493":52366,"_2816":52367},[],"/docs/pr-preview/pr-45/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3328":1598,"_29138":1590,"_5":29479,"_20209":52369,"_26493":52370,"_2816":52371},[],"/docs/pr-preview/pr-45/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3328":1599,"_29138":1590,"_5":29479,"_20209":52373,"_26493":52374,"_2816":52375},[],"/docs/pr-preview/pr-45/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3328":1600,"_29138":1590,"_20209":52377,"_5":13819,"_26493":1590,"_2816":52378},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3328":1601,"_29138":1590,"_20209":52380,"_5":13819,"_26493":52347,"_2816":52381},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3328":1602,"_29138":1590,"_20209":52383,"_5":13819,"_26493":52347,"_2816":52384},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3328":1603,"_29138":1590,"_20209":52386,"_5":13819,"_26493":52347,"_2816":52387},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3328":1604,"_29138":1590,"_20209":52389,"_5":13819,"_26493":52347,"_2816":52390},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3328":1605,"_29138":1590,"_20209":52392,"_5":13819,"_26493":52347,"_2816":52393},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3328":1606,"_29138":1590,"_20209":52395,"_5":13819,"_26493":52350,"_2816":52396},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3328":1607,"_29138":1590,"_20209":52398,"_5":13819,"_26493":52350,"_2816":52399},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3328":1608,"_29138":1590,"_20209":52401,"_5":13819,"_26493":52354,"_2816":52402},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3328":1609,"_29138":1590,"_20209":52404,"_5":13819,"_26493":52354,"_2816":52405},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3328":1610,"_29138":1590,"_20209":52407,"_5":13819,"_26493":52354,"_2816":52408},[],"Setting",{"_3328":1611,"_29138":1590,"_20209":52410,"_5":13819,"_26493":52354,"_2816":52411},[],"Evaluation value",{"_3328":1612,"_29138":1590,"_20209":52413,"_5":13819,"_26493":52354,"_2816":52414},[],"Enrollment CA",{"_3328":1613,"_29138":1590,"_20209":52416,"_5":13819,"_26493":52354,"_2816":52417},[],"Issuing root from `device-root.pem`.",{"_3328":1614,"_29138":1590,"_20209":52419,"_5":13819,"_26493":52354,"_2816":50216},[],{"_3328":1615,"_29138":1590,"_20209":52421,"_5":13819,"_26493":52354,"_2816":52422},[],"The 1-hour leaf profile you just prepared.",{"_3328":1616,"_29138":1590,"_20209":52424,"_5":13819,"_26493":52354,"_2816":52425},[],"Protocol / Registration Mode",{"_3328":1617,"_29138":1590,"_20209":52427,"_5":13819,"_26493":52354,"_2816":52428},[],"`EST_RFC7030` / `JITP`.",{"_3328":1618,"_29138":1590,"_20209":52430,"_5":13819,"_26493":52354,"_2816":52431},[],"Verify CSR Signature",{"_3328":1619,"_29138":1590,"_20209":52433,"_5":13819,"_26493":52354,"_2816":52434},[],"Enabled.",{"_3328":1620,"_29138":1590,"_20209":52436,"_5":13819,"_26493":52354,"_2816":52437},[],"Enable Replaceable Enrollment",{"_3328":1621,"_29138":1590,"_20209":52439,"_5":13819,"_26493":52354,"_2816":52440},[],"Disabled; the ID must be new.",{"_3328":1622,"_29138":1590,"_20209":52442,"_5":13819,"_26493":52354,"_2816":52443},[],"Initial authentication",{"_3328":1623,"_29138":1590,"_20209":52445,"_5":13819,"_26493":52354,"_2816":52446},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3328":1624,"_29138":1590,"_20209":52448,"_5":13819,"_26493":52354,"_2816":52449},[],"Renewal authentication",{"_3328":1625,"_29138":1590,"_20209":52451,"_5":13819,"_26493":52354,"_2816":52452},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3328":1626,"_29138":1590,"_20209":52454,"_5":13819,"_26493":52354,"_2816":52455},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3328":1627,"_29138":1590,"_20209":52457,"_5":13819,"_26493":52354,"_2816":52458},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3328":1628,"_29138":1590,"_20209":52460,"_5":13819,"_26493":52354,"_2816":52461},[],"Re-enrollment Delta",{"_3328":1629,"_29138":1590,"_20209":52463,"_5":13819,"_26493":52354,"_2816":52464},[],"1 hour.",{"_3328":1630,"_29138":1590,"_20209":52466,"_5":13819,"_26493":52354,"_2816":52467},[],"Preventive / Critical Delta",{"_3328":1631,"_29138":1590,"_20209":52469,"_5":13819,"_26493":52354,"_2816":52470},[],"30 minutes / 10 minutes.",{"_3328":1632,"_29138":1590,"_20209":52472,"_5":13819,"_26493":52354,"_2816":52473},[],"Revoke on Re-enrollment",{"_3328":1633,"_29138":1590,"_20209":52475,"_5":13819,"_26493":52354,"_2816":52476},[],"Disabled to test the successor before retiring the previous identity.",{"_3328":1634,"_29138":1590,"_20209":52478,"_5":13819,"_26493":52354,"_2816":50224},[],{"_3328":1635,"_29138":1590,"_20209":52480,"_5":13819,"_26493":52354,"_2816":52481},[],"Disabled; the operational key is generated in the client.",{"_3328":1636,"_29138":1590,"_20209":52483,"_5":13819,"_26493":52354,"_2816":52484},[],"CA Distribution",{"_3328":1637,"_29138":1590,"_20209":52486,"_5":13819,"_26493":52354,"_2816":52487},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3328":1638,"_29138":1590,"_20209":52489,"_5":13819,"_26493":52354,"_2816":52490},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3328":1639,"_29138":1590,"_20209":52492,"_5":13819,"_26493":52358,"_2816":52493},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3328":1640,"_29138":1590,"_20209":52495,"_5":13819,"_26493":52358,"_2816":52496},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3328":1641,"_29138":1590,"_20209":52498,"_5":13819,"_26493":52362,"_2816":52499},[],"Generate a new key and CSR with the selected identifier:",{"_3328":1642,"_29138":1590,"_20209":52501,"_5":13819,"_26493":52362,"_2816":52502},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3328":1643,"_29138":1590,"_20209":52504,"_5":13819,"_26493":52362,"_2816":52505},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3328":1644,"_29138":1590,"_20209":52507,"_5":13819,"_26493":52366,"_2816":52508},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3328":1645,"_29138":1590,"_20209":52510,"_5":13819,"_26493":52366,"_2816":52511},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3328":1646,"_29138":1590,"_20209":52513,"_5":13819,"_26493":52370,"_2816":52514},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3328":1647,"_29138":1590,"_20209":52516,"_5":13819,"_26493":52370,"_2816":52517},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3328":1648,"_29138":1590,"_20209":52519,"_5":13819,"_26493":52370,"_2816":52520},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3328":1649,"_29138":1590,"_20209":52522,"_5":13819,"_26493":52370,"_2816":52523},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3328":1650,"_29138":1590,"_20209":52525,"_5":13819,"_26493":52370,"_2816":52526},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3328":1651,"_29138":1590,"_20209":52528,"_5":13819,"_26493":52374,"_2816":52529},[],"Check",{"_3328":1652,"_29138":1590,"_20209":52531,"_5":13819,"_26493":52374,"_2816":52532},[],"Expected result",{"_3328":1653,"_29138":1590,"_20209":52534,"_5":13819,"_26493":52374,"_2816":52535},[],"Registration",{"_3328":1654,"_29138":1590,"_20209":52537,"_5":13819,"_26493":52374,"_2816":52538},[],"ID created automatically and correct DMS.",{"_3328":1655,"_29138":1590,"_20209":52540,"_5":13819,"_26493":52374,"_2816":51793},[],{"_3328":1656,"_29138":1590,"_20209":52542,"_5":13819,"_26493":52374,"_2816":52543},[],"CN, profile, serial and key verified.",{"_3328":1657,"_29138":1590,"_20209":52545,"_5":13819,"_26493":52374,"_2816":52546},[],"Inventory",{"_3328":1658,"_29138":1590,"_20209":52548,"_5":13819,"_26493":52374,"_2816":52549},[],"Received serial visible as the current identity and in history.",{"_3328":1659,"_29138":1590,"_20209":52551,"_5":13819,"_26493":52374,"_2816":52552},[],"Consumer",{"_3328":1660,"_29138":1590,"_20209":52554,"_5":13819,"_26493":52374,"_2816":52555},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3328":1661,"_29138":1590,"_20209":52557,"_5":13819,"_26493":52374,"_2816":52558},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3328":1662,"_29138":1590,"_20209":52560,"_5":13819,"_26493":52374,"_2816":52561},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3328":1663,"_29138":1663,"_5":14177,"_2816":49921,"_29482":52563,"_20209":52564,"_26493":1663},[47429,48897,49905,52340],[],{"_3328":1664,"_29138":1663,"_20209":52566,"_5":13819,"_26493":1663,"_2816":52567},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3328":1665,"_29138":1663,"_5":29479,"_20209":52569,"_26493":52570,"_2816":47439},[],"/docs/pr-preview/pr-45/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3328":1666,"_29138":1663,"_5":29479,"_20209":52572,"_26493":52573,"_2816":52574},[],"/docs/pr-preview/pr-45/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3328":1667,"_29138":1663,"_5":29479,"_20209":52576,"_26493":52577,"_2816":52578},[],"/docs/pr-preview/pr-45/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3328":1668,"_29138":1663,"_5":29479,"_20209":52580,"_26493":52581,"_2816":52582},[],"/docs/pr-preview/pr-45/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3328":1669,"_29138":1663,"_5":29479,"_20209":52584,"_26493":52585,"_2816":52586},[],"/docs/pr-preview/pr-45/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3328":1670,"_29138":1663,"_5":29479,"_20209":52588,"_26493":52589,"_2816":52590},[],"/docs/pr-preview/pr-45/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3328":1671,"_29138":1663,"_5":29479,"_20209":52592,"_26493":52593,"_2816":52532},[],"/docs/pr-preview/pr-45/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3328":1672,"_29138":1663,"_5":29479,"_20209":52595,"_26493":52596,"_2816":52597},[],"/docs/pr-preview/pr-45/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3328":1673,"_29138":1663,"_5":29479,"_20209":52599,"_26493":52600,"_2816":52601},[],"/docs/pr-preview/pr-45/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3328":1674,"_29138":1663,"_20209":52603,"_5":13819,"_26493":1663,"_2816":52604},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3328":1675,"_29138":1663,"_20209":52606,"_5":13819,"_26493":1663,"_2816":52607},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3328":1676,"_29138":1663,"_20209":52609,"_5":13819,"_26493":52570,"_2816":52610},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3328":1677,"_29138":1663,"_20209":52612,"_5":13819,"_26493":52570,"_2816":52613},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3328":1678,"_29138":1663,"_20209":52615,"_5":13819,"_26493":52570,"_2816":52616},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3328":1679,"_29138":1663,"_20209":52618,"_5":13819,"_26493":52570,"_2816":52619},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3328":1680,"_29138":1663,"_20209":52621,"_5":13819,"_26493":52573,"_2816":52622},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3328":1681,"_29138":1663,"_20209":52624,"_5":13819,"_26493":52573,"_2816":52625},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3328":1682,"_29138":1663,"_20209":52627,"_5":13819,"_26493":52573,"_2816":52628},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3328":1683,"_29138":1663,"_20209":52630,"_5":13819,"_26493":52573,"_2816":52631},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3328":1684,"_29138":1663,"_20209":52633,"_5":13819,"_26493":52573,"_2816":52634},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3328":1685,"_29138":1663,"_20209":52636,"_5":13819,"_26493":52573,"_2816":52637},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3328":1686,"_29138":1663,"_20209":52639,"_5":13819,"_26493":52573,"_2816":52640},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3328":1687,"_29138":1663,"_20209":52642,"_5":13819,"_26493":52573,"_2816":52643},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3328":1688,"_29138":1663,"_20209":52645,"_5":13819,"_26493":52577,"_2816":52646},[],"Open **Managed Devices** and the registration action. Complete:",{"_3328":1689,"_29138":1663,"_20209":52648,"_5":13819,"_26493":52577,"_2816":52649},[],"**Device ID**: `device-001`.",{"_3328":1690,"_29138":1663,"_20209":52651,"_5":13819,"_26493":52577,"_2816":52652},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3328":1691,"_29138":1663,"_20209":52654,"_5":13819,"_26493":52577,"_2816":52655},[],"**Icon** and **Tags**: optional classification.",{"_3328":1692,"_29138":1663,"_20209":52657,"_5":13819,"_26493":52577,"_2816":52658},[],"Confirm registration.",{"_3328":1693,"_29138":1663,"_20209":52660,"_5":13819,"_26493":52581,"_2816":52661},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3328":1694,"_29138":1663,"_20209":52663,"_5":13819,"_26493":52581,"_2816":52664},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3328":1695,"_29138":1663,"_20209":52666,"_5":13819,"_26493":52585,"_2816":52667},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3328":1696,"_29138":1663,"_20209":52669,"_5":13819,"_26493":52585,"_2816":52670},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3328":1697,"_29138":1663,"_20209":52672,"_5":13819,"_26493":52589,"_2816":52673},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3328":1698,"_29138":1663,"_20209":52675,"_5":13819,"_26493":52589,"_2816":52676},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3328":1699,"_29138":1663,"_20209":52678,"_5":13819,"_26493":52593,"_2816":52529},[],{"_3328":1700,"_29138":1663,"_20209":52680,"_5":13819,"_26493":52593,"_2816":52681},[],"Result",{"_3328":1701,"_29138":1663,"_20209":52683,"_5":13819,"_26493":52593,"_2816":51776},[],{"_3328":1702,"_29138":1663,"_20209":52685,"_5":13819,"_26493":52593,"_2816":52686},[],"`device-001` appears in inventory with the expected DMS.",{"_3328":1703,"_29138":1663,"_20209":52688,"_5":13819,"_26493":52593,"_2816":52689},[],"Current identity",{"_3328":1704,"_29138":1663,"_20209":52691,"_5":13819,"_26493":52593,"_2816":52692},[],"The associated certificate matches the one you verified in PKI.",{"_3328":1705,"_29138":1663,"_20209":52694,"_5":13819,"_26493":52593,"_2816":52695},[],"History",{"_3328":1706,"_29138":1663,"_20209":52697,"_5":13819,"_26493":52593,"_2816":52698},[],"The associated issuance appears with its serial number and dates.",{"_3328":1707,"_29138":1663,"_20209":52700,"_5":13819,"_26493":52593,"_2816":52701},[],"Key and certificate",{"_3328":1708,"_29138":1663,"_20209":52703,"_5":13819,"_26493":52593,"_2816":52704},[],"You have the verified pair ready to install on the device.",{"_3328":1709,"_29138":1663,"_20209":52706,"_5":13819,"_26493":52596,"_2816":52707},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3328":1710,"_29138":1663,"_20209":52709,"_5":13819,"_26493":52596,"_2816":52710},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3328":1711,"_29138":1663,"_20209":52712,"_5":13819,"_26493":52596,"_2816":52713},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3328":1712,"_29138":1663,"_20209":52715,"_5":13819,"_26493":52596,"_2816":52716},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3328":1713,"_29138":1663,"_20209":52718,"_5":13819,"_26493":52600,"_2816":52719},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3328":1714,"_29138":1663,"_20209":52721,"_5":13819,"_26493":52600,"_2816":52722},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3328":1715,"_29138":1663,"_20209":52724,"_5":13819,"_26493":52600,"_2816":52725},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3328":1716,"_29138":1716,"_5":14177,"_2816":52727,"_29482":52728,"_20209":52729,"_26493":1716},"Lamassu IoT Platform",[47429,48897],[],{"_3328":1717,"_29138":1716,"_20209":52731,"_5":13819,"_26493":1716,"_2816":52732},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3328":1718,"_29138":1716,"_5":29479,"_20209":52734,"_26493":52735,"_2816":52215},[],"/docs/pr-preview/pr-45/platform/overview#start-here",{"_3328":1719,"_29138":1716,"_5":29479,"_20209":52737,"_26493":52738,"_2816":52739},[],"/docs/pr-preview/pr-45/platform/overview#choose-your-path","Choose your path",{"_3328":1720,"_29138":1716,"_5":29479,"_20209":52741,"_26493":52742,"_2816":52743},[],"/docs/pr-preview/pr-45/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3328":1721,"_29138":1716,"_5":29479,"_20209":52745,"_26493":52746,"_2816":52747},[],"/docs/pr-preview/pr-45/platform/overview#core-capabilities","Core capabilities",{"_3328":1722,"_29138":1716,"_5":29479,"_20209":52749,"_26493":52750,"_2816":52751},[],"/docs/pr-preview/pr-45/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3328":1723,"_29138":1716,"_5":29479,"_20209":52753,"_26493":52754,"_2816":52755},[],"/docs/pr-preview/pr-45/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3328":1724,"_29138":1716,"_5":29479,"_20209":52757,"_26493":52758,"_2816":52759},[],"/docs/pr-preview/pr-45/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3328":1725,"_29138":1716,"_5":29479,"_20209":52761,"_26493":52762,"_2816":52763},[],"/docs/pr-preview/pr-45/platform/overview#automate-device-identities","Automate device identities",{"_3328":1726,"_29138":1716,"_5":29479,"_20209":52765,"_26493":52766,"_2816":52767},[],"/docs/pr-preview/pr-45/platform/overview#publish-validation-status","Publish validation status",{"_3328":1727,"_29138":1716,"_5":29479,"_20209":52769,"_26493":52770,"_2816":52771},[],"/docs/pr-preview/pr-45/platform/overview#react-to-events","React to events",{"_3328":1728,"_29138":1716,"_5":29479,"_20209":52773,"_26493":52774,"_2816":52775},[],"/docs/pr-preview/pr-45/platform/overview#operational-reference","Operational reference",{"_3328":1729,"_29138":1716,"_20209":52777,"_5":13819,"_26493":1716,"_2816":52778},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3328":1730,"_29138":1716,"_20209":52780,"_5":13819,"_26493":52735,"_2816":52781},[],"Choose the result you need:",{"_3328":1731,"_29138":1716,"_20209":52783,"_5":13819,"_26493":52735,"_2816":52784},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3328":1732,"_29138":1716,"_20209":52786,"_5":13819,"_26493":52735,"_2816":52787},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3328":1733,"_29138":1716,"_20209":52789,"_5":13819,"_26493":52735,"_2816":52790},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3328":1734,"_29138":1716,"_20209":52792,"_5":13819,"_26493":52738,"_2816":52793},[],"Section",{"_3328":1735,"_29138":1716,"_20209":52795,"_5":13819,"_26493":52738,"_2816":52796},[],"What you manage",{"_3328":1736,"_29138":1716,"_20209":52798,"_5":13819,"_26493":52738,"_2816":52799},[],"Entry point",{"_3328":1737,"_29138":1716,"_20209":52801,"_5":13819,"_26493":52738,"_2816":52802},[],"**PKI**",{"_3328":1738,"_29138":1716,"_20209":52804,"_5":13819,"_26493":52738,"_2816":52805},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3328":1739,"_29138":1716,"_20209":52807,"_5":13819,"_26493":52738,"_2816":52808},[],"PKI overview",{"_3328":1740,"_29138":1716,"_20209":52810,"_5":13819,"_26493":52738,"_2816":52811},[],"**IoT Fleets**",{"_3328":1741,"_29138":1716,"_20209":52813,"_5":13819,"_26493":52738,"_2816":52814},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3328":1742,"_29138":1716,"_20209":52816,"_5":13819,"_26493":52738,"_2816":52817},[],"IoT Fleets overview",{"_3328":1743,"_29138":1716,"_20209":52819,"_5":13819,"_26493":52738,"_2816":52820},[],"**Administration**",{"_3328":1744,"_29138":1716,"_20209":52822,"_5":13819,"_26493":52738,"_2816":52823},[],"Operator permissions, audit and event subscriptions.",{"_3328":1745,"_29138":1716,"_20209":52825,"_5":13819,"_26493":52738,"_2816":48895},[],{"_3328":1746,"_29138":1716,"_20209":52827,"_5":13819,"_26493":52738,"_2816":52828},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3328":1747,"_29138":1716,"_20209":52830,"_5":13819,"_26493":52742,"_2816":52831},[],"An identity's journey connects four responsibilities:",{"_3328":1748,"_29138":1716,"_20209":52833,"_5":13819,"_26493":52742,"_2816":52834},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3328":1749,"_29138":1716,"_20209":52836,"_5":13819,"_26493":52742,"_2816":52837},[],"The provisioning administrator configures the DMS and initial trust.",{"_3328":1750,"_29138":1716,"_20209":52839,"_5":13819,"_26493":52742,"_2816":52840},[],"The device client requests a certificate and installs it with the matching key.",{"_3328":1751,"_29138":1716,"_20209":52842,"_5":13819,"_26493":52742,"_2816":52843},[],"The consumer validates the identity and applies its access permissions.",{"_3328":1752,"_29138":1716,"_20209":52845,"_5":13819,"_26493":52742,"_2816":52846},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3328":1753,"_29138":1716,"_20209":52848,"_5":13819,"_26493":52750,"_2816":52849},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3328":1754,"_29138":1716,"_20209":52851,"_5":13819,"_26493":52754,"_2816":52852},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3328":1755,"_29138":1716,"_20209":52854,"_5":13819,"_26493":52758,"_2816":52855},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3328":1756,"_29138":1716,"_20209":52857,"_5":13819,"_26493":52762,"_2816":52858},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3328":1757,"_29138":1716,"_20209":52860,"_5":13819,"_26493":52766,"_2816":52861},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3328":1758,"_29138":1716,"_20209":52863,"_5":13819,"_26493":52770,"_2816":52864},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3328":1759,"_29138":1716,"_20209":52866,"_5":13819,"_26493":52774,"_2816":52309},[],{"_3328":1760,"_29138":1716,"_20209":52868,"_5":13819,"_26493":52774,"_2816":52869},[],"What it prepares or checks",{"_3328":1761,"_29138":1716,"_20209":52871,"_5":13819,"_26493":52774,"_2816":52312},[],{"_3328":1762,"_29138":1716,"_20209":52873,"_5":13819,"_26493":52774,"_2816":52874},[],"Key custody, CA hierarchy, profiles and validation.",{"_3328":1763,"_29138":1716,"_20209":52876,"_5":13819,"_26493":52774,"_2816":52877},[],"Fleet administrator",{"_3328":1764,"_29138":1716,"_20209":52879,"_5":13819,"_26493":52774,"_2816":52880},[],"DMS, device admission, renewal policy and inventory.",{"_3328":1765,"_29138":1716,"_20209":52882,"_5":13819,"_26493":52774,"_2816":52324},[],{"_3328":1766,"_29138":1716,"_20209":52884,"_5":13819,"_26493":52774,"_2816":52885},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3328":1767,"_29138":1716,"_20209":52887,"_5":13819,"_26493":52774,"_2816":52330},[],{"_3328":1768,"_29138":1716,"_20209":52889,"_5":13819,"_26493":52774,"_2816":52890},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3328":1769,"_29138":1716,"_20209":52892,"_5":13819,"_26493":52774,"_2816":52893},[],"Infrastructure operator",{"_3328":1770,"_29138":1716,"_20209":52895,"_5":13819,"_26493":52774,"_2816":52896},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3328":1771,"_29138":1716,"_20209":52898,"_5":13819,"_26493":52774,"_2816":52899},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3328":1772,"_29138":1772,"_5":14177,"_2816":52901,"_29482":52902,"_20209":52905,"_26493":1772},"CA hierarchy and rotation",[47429,48897,52903,52904],"PKI","Keys, authorities and certificates",[],{"_3328":1773,"_29138":1772,"_20209":52907,"_5":13819,"_26493":1772,"_2816":52908},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3328":1774,"_29138":1772,"_5":29479,"_20209":52910,"_26493":52911,"_2816":52912},[],"/docs/pr-preview/pr-45/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3328":1775,"_29138":1772,"_5":29479,"_20209":52914,"_26493":52915,"_2816":52916},[],"/docs/pr-preview/pr-45/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3328":1776,"_29138":1772,"_5":29479,"_20209":52918,"_26493":52919,"_2816":52920},[],"/docs/pr-preview/pr-45/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3328":1777,"_29138":1772,"_5":29479,"_20209":52922,"_26493":52923,"_2816":52924},[],"/docs/pr-preview/pr-45/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3328":1778,"_29138":1772,"_5":29479,"_20209":52926,"_26493":52927,"_2816":52928},[],"/docs/pr-preview/pr-45/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3328":1779,"_29138":1772,"_5":29479,"_20209":52930,"_26493":52931,"_2816":52932},[],"/docs/pr-preview/pr-45/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3328":1780,"_29138":1772,"_5":29479,"_20209":52934,"_26493":52935,"_2816":52936},[],"/docs/pr-preview/pr-45/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3328":1781,"_29138":1772,"_5":29479,"_20209":52938,"_26493":52939,"_2816":52940},[],"/docs/pr-preview/pr-45/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3328":1782,"_29138":1772,"_5":29479,"_20209":52942,"_26493":52943,"_2816":52944},[],"/docs/pr-preview/pr-45/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3328":1783,"_29138":1772,"_5":29479,"_20209":52946,"_26493":52947,"_2816":52948},[],"/docs/pr-preview/pr-45/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3328":1784,"_29138":1772,"_5":29479,"_20209":52950,"_26493":52951,"_2816":52952},[],"/docs/pr-preview/pr-45/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3328":1785,"_29138":1772,"_5":29479,"_20209":52954,"_26493":52955,"_2816":52956},[],"/docs/pr-preview/pr-45/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3328":1786,"_29138":1772,"_20209":52958,"_5":13819,"_26493":1772,"_2816":52959},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3328":1787,"_29138":1772,"_20209":52961,"_5":13819,"_26493":1772,"_2816":52962},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3328":1788,"_29138":1772,"_20209":52964,"_5":13819,"_26493":52911,"_2816":52965},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3328":1789,"_29138":1772,"_20209":52967,"_5":13819,"_26493":52911,"_2816":52968},[],"environment, such as production and preproduction;",{"_3328":1790,"_29138":1772,"_20209":52970,"_5":13819,"_26493":52911,"_2816":52971},[],"owner or operating team;",{"_3328":1791,"_29138":1772,"_20209":52973,"_5":13819,"_26493":52911,"_2816":52974},[],"device family or manufacturing process;",{"_3328":1792,"_29138":1772,"_20209":52976,"_5":13819,"_26493":52911,"_2816":52977},[],"region or regulatory requirement;",{"_3328":1793,"_29138":1772,"_20209":52979,"_5":13819,"_26493":52911,"_2816":52980},[],"cryptographic engine or key policy;",{"_3328":1794,"_29138":1772,"_20209":52982,"_5":13819,"_26493":52911,"_2816":52983},[],"maintenance window and renewal cadence.",{"_3328":1795,"_29138":1772,"_20209":52985,"_5":13819,"_26493":52911,"_2816":52986},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3328":1796,"_29138":1772,"_20209":52988,"_5":13819,"_26493":52911,"_2816":52989},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3328":1797,"_29138":1772,"_20209":52991,"_5":13819,"_26493":52915,"_2816":52992},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3328":1798,"_29138":1772,"_20209":52994,"_5":13819,"_26493":52915,"_2816":52995},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3328":1799,"_29138":1772,"_20209":52997,"_5":13819,"_26493":52915,"_2816":52998},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3328":1800,"_29138":1772,"_20209":53000,"_5":13819,"_26493":52919,"_2816":53001},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3328":1801,"_29138":1772,"_20209":53003,"_5":13819,"_26493":52919,"_2816":53004},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3328":1802,"_29138":1772,"_20209":53006,"_5":13819,"_26493":52919,"_2816":53007},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3328":1803,"_29138":1772,"_20209":53009,"_5":13819,"_26493":52919,"_2816":53010},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3328":1804,"_29138":1772,"_20209":53012,"_5":13819,"_26493":52927,"_2816":53013},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3328":1805,"_29138":1772,"_20209":53015,"_5":13819,"_26493":52931,"_2816":53016},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3328":1806,"_29138":1772,"_20209":53018,"_5":13819,"_26493":52935,"_2816":53019},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3328":1807,"_29138":1772,"_20209":53021,"_5":13819,"_26493":52939,"_2816":53022},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3328":1808,"_29138":1772,"_20209":53024,"_5":13819,"_26493":52943,"_2816":53025},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3328":1809,"_29138":1772,"_20209":53027,"_5":13819,"_26493":52947,"_2816":53028},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3328":1810,"_29138":1772,"_20209":53030,"_5":13819,"_26493":52951,"_2816":53031},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3328":1811,"_29138":1772,"_20209":53033,"_5":13819,"_26493":52951,"_2816":53034},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3328":1812,"_29138":1772,"_20209":53036,"_5":13819,"_26493":52951,"_2816":53037},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3328":1813,"_29138":1772,"_20209":53039,"_5":13819,"_26493":52951,"_2816":53040},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3328":1814,"_29138":1772,"_20209":53042,"_5":13819,"_26493":52955,"_2816":53043},[],"The new chain ends in an anchor installed by the consumer.",{"_3328":1815,"_29138":1772,"_20209":53045,"_5":13819,"_26493":52955,"_2816":53046},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3328":1816,"_29138":1772,"_20209":53048,"_5":13819,"_26493":52955,"_2816":53049},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3328":1817,"_29138":1772,"_20209":53051,"_5":13819,"_26493":52955,"_2816":53052},[],"Re-enrollment accepts the old identity during the planned period.",{"_3328":1818,"_29138":1772,"_20209":53054,"_5":13819,"_26493":52955,"_2816":53055},[],"OCSP and CRL respond for the authorities that remain active.",{"_3328":1819,"_29138":1772,"_20209":53057,"_5":13819,"_26493":52955,"_2816":53058},[],"No DMS is left accidentally issuing from the old CA.",{"_3328":1820,"_29138":1772,"_20209":53060,"_5":13819,"_26493":52955,"_2816":53061},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3328":1821,"_29138":1821,"_5":14177,"_2816":53063,"_29482":53064,"_20209":53065,"_26493":1821},"Certification authorities",[47429,48897,52903,52904],[],{"_3328":1822,"_29138":1821,"_20209":53067,"_5":13819,"_26493":1821,"_2816":53068},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3328":1823,"_29138":1821,"_5":29479,"_20209":53070,"_26493":53071,"_2816":53072},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3328":1824,"_29138":1821,"_5":29479,"_20209":53074,"_26493":53075,"_2816":53076},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3328":1825,"_29138":1821,"_5":29479,"_20209":53078,"_26493":53079,"_2816":47439},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#before-you-begin",{"_3328":1826,"_29138":1821,"_5":29479,"_20209":53081,"_26493":53082,"_2816":53083},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3328":1827,"_29138":1821,"_5":29479,"_20209":53085,"_26493":53086,"_2816":53087},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3328":1828,"_29138":1821,"_5":29479,"_20209":53089,"_26493":53090,"_2816":53091},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3328":1829,"_29138":1821,"_5":29479,"_20209":53093,"_26493":53094,"_2816":53095},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3328":1830,"_29138":1821,"_5":29479,"_20209":53097,"_26493":53098,"_2816":53099},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3328":1831,"_29138":1821,"_5":29479,"_20209":53101,"_26493":53102,"_2816":53103},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3328":1832,"_29138":1821,"_5":29479,"_20209":53105,"_26493":53106,"_2816":53107},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3328":1833,"_29138":1821,"_5":29479,"_20209":53109,"_26493":53110,"_2816":53111},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3328":1834,"_29138":1821,"_5":29479,"_20209":53113,"_26493":53114,"_2816":53115},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3328":1835,"_29138":1821,"_5":29479,"_20209":53117,"_26493":53118,"_2816":53119},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3328":1836,"_29138":1821,"_5":29479,"_20209":53121,"_26493":53122,"_2816":53123},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3328":1837,"_29138":1821,"_5":29479,"_20209":53125,"_26493":53126,"_2816":53127},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3328":1838,"_29138":1821,"_5":29479,"_20209":53129,"_26493":53130,"_2816":53131},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3328":1839,"_29138":1821,"_5":29479,"_20209":53133,"_26493":53134,"_2816":53135},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3328":1840,"_29138":1821,"_5":29479,"_20209":53137,"_26493":53138,"_2816":53139},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3328":1841,"_29138":1821,"_5":29479,"_20209":53141,"_26493":53142,"_2816":53143},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3328":1842,"_29138":1821,"_5":29479,"_20209":53145,"_26493":53146,"_2816":53147},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3328":1843,"_29138":1821,"_5":29479,"_20209":53149,"_26493":53150,"_2816":53151},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3328":1844,"_29138":1821,"_5":29479,"_20209":53153,"_26493":53154,"_2816":53155},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3328":1845,"_29138":1821,"_5":29479,"_20209":53157,"_26493":53158,"_2816":53159},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3328":1846,"_29138":1821,"_20209":53161,"_5":13819,"_26493":1821,"_2816":53162},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3328":1847,"_29138":1821,"_20209":53164,"_5":13819,"_26493":1821,"_2816":53165},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3328":1848,"_29138":1821,"_20209":53167,"_5":13819,"_26493":1821,"_2816":53168},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3328":1849,"_29138":1821,"_20209":53170,"_5":13819,"_26493":53071,"_2816":53171},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3328":1850,"_29138":1821,"_20209":53173,"_5":13819,"_26493":53071,"_2816":53174},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3328":1851,"_29138":1821,"_20209":53176,"_5":13819,"_26493":53071,"_2816":53177},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3328":1852,"_29138":1821,"_20209":53179,"_5":13819,"_26493":53071,"_2816":53180},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3328":1853,"_29138":1821,"_20209":53182,"_5":13819,"_26493":53071,"_2816":53183},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3328":1854,"_29138":1821,"_20209":53185,"_5":13819,"_26493":53079,"_2816":53186},[],"Decide whether the CA will be a root or an intermediate.",{"_3328":1855,"_29138":1821,"_20209":53188,"_5":13819,"_26493":53079,"_2816":53189},[],"Choose the engine that will keep the key.",{"_3328":1856,"_29138":1821,"_20209":53191,"_5":13819,"_26493":53079,"_2816":53192},[],"Define a validity longer than that of the certificates it will issue.",{"_3328":1857,"_29138":1821,"_20209":53194,"_5":13819,"_26493":53079,"_2816":53195},[],"For an intermediate CA, make sure the parent CA is active.",{"_3328":1858,"_29138":1821,"_20209":53197,"_5":13819,"_26493":53082,"_2816":53198},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3328":1859,"_29138":1821,"_20209":53200,"_5":13819,"_26493":53086,"_2816":53201},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3328":1860,"_29138":1821,"_20209":53203,"_5":13819,"_26493":53086,"_2816":53204},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3328":1861,"_29138":1821,"_20209":53206,"_5":13819,"_26493":53090,"_2816":53207},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3328":1862,"_29138":1821,"_20209":53209,"_5":13819,"_26493":53094,"_2816":53210},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3328":1863,"_29138":1821,"_20209":53212,"_5":13819,"_26493":53094,"_2816":53213},[],"`C`: two-letter ISO 3166-1 country code.",{"_3328":1864,"_29138":1821,"_20209":53215,"_5":13819,"_26493":53094,"_2816":53216},[],"`ST`: state or province.",{"_3328":1865,"_29138":1821,"_20209":53218,"_5":13819,"_26493":53094,"_2816":53219},[],"`L`: locality.",{"_3328":1866,"_29138":1821,"_20209":53221,"_5":13819,"_26493":53094,"_2816":53222},[],"`O`: organization.",{"_3328":1867,"_29138":1821,"_20209":53224,"_5":13819,"_26493":53094,"_2816":53225},[],"`OU`: organizational unit.",{"_3328":1868,"_29138":1821,"_20209":53227,"_5":13819,"_26493":53094,"_2816":53228},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3328":1869,"_29138":1821,"_20209":53230,"_5":13819,"_26493":53098,"_2816":53231},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3328":1870,"_29138":1821,"_20209":53233,"_5":13819,"_26493":53098,"_2816":53234},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3328":1871,"_29138":1821,"_20209":53236,"_5":13819,"_26493":53102,"_2816":53237},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3328":1872,"_29138":1821,"_20209":53239,"_5":13819,"_26493":53102,"_2816":53240},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3328":1873,"_29138":1821,"_20209":53242,"_5":13819,"_26493":53106,"_2816":53243},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3328":1874,"_29138":1821,"_20209":53245,"_5":13819,"_26493":53106,"_2816":53246},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3328":1875,"_29138":1821,"_20209":53248,"_5":13819,"_26493":53110,"_2816":53249},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3328":1876,"_29138":1821,"_20209":53251,"_5":13819,"_26493":53114,"_2816":53252},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3328":1877,"_29138":1821,"_20209":53254,"_5":13819,"_26493":53118,"_2816":53255},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3328":1878,"_29138":1821,"_20209":53257,"_5":13819,"_26493":53122,"_2816":53258},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3328":1879,"_29138":1821,"_20209":53260,"_5":13819,"_26493":53126,"_2816":53261},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3328":1880,"_29138":1821,"_20209":53263,"_5":13819,"_26493":53126,"_2816":53264},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3328":1881,"_29138":1821,"_20209":53266,"_5":13819,"_26493":53130,"_2816":53267},[],"Open a CA from the inventory to review:",{"_3328":1882,"_29138":1821,"_20209":53269,"_5":13819,"_26493":53130,"_2816":53270},[],"Status and validity period.",{"_3328":1883,"_29138":1821,"_20209":53272,"_5":13819,"_26493":53130,"_2816":53273},[],"Certificate and chain in PEM format.",{"_3328":1884,"_29138":1821,"_20209":53275,"_5":13819,"_26493":53130,"_2816":53276},[],"Number of active, expired and revoked certificates.",{"_3328":1885,"_29138":1821,"_20209":53278,"_5":13819,"_26493":53130,"_2816":53279},[],"Certificates issued in **Issued Certificates**.",{"_3328":1886,"_29138":1821,"_20209":53281,"_5":13819,"_26493":53130,"_2816":53282},[],"The CRL linked to the authority.",{"_3328":1887,"_29138":1821,"_20209":53284,"_5":13819,"_26493":53130,"_2816":53285},[],"Metadata and the associated cryptographic engine.",{"_3328":1888,"_29138":1821,"_20209":53287,"_5":13819,"_26493":53130,"_2816":53288},[],"You can filter the inventory by name, status and CA type.",{"_3328":1889,"_29138":1821,"_20209":53290,"_5":13819,"_26493":53134,"_2816":53291},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3328":1890,"_29138":1821,"_20209":53293,"_5":13819,"_26493":53134,"_2816":53294},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3328":1891,"_29138":1821,"_20209":53296,"_5":13819,"_26493":53134,"_2816":53297},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3328":1892,"_29138":1821,"_20209":53299,"_5":13819,"_26493":53134,"_2816":53300},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3328":1893,"_29138":1821,"_20209":53302,"_5":13819,"_26493":53138,"_2816":53303},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3328":1894,"_29138":1821,"_20209":53305,"_5":13819,"_26493":53142,"_2816":53306},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3328":1895,"_29138":1821,"_20209":53308,"_5":13819,"_26493":53146,"_2816":53309},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3328":1896,"_29138":1821,"_20209":53311,"_5":13819,"_26493":53150,"_2816":53312},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3328":1897,"_29138":1821,"_20209":53314,"_5":13819,"_26493":53154,"_2816":53315},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3328":1898,"_29138":1821,"_20209":53317,"_5":13819,"_26493":53158,"_2816":53318},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3328":1899,"_29138":1821,"_20209":53320,"_5":13819,"_26493":53158,"_2816":53321},[],"The CA’s VA role is kept. If no other CA with the same SKI remains, it can no longer be edited (see CRL), so adjust its validity and signer beforehand. The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3328":1900,"_29138":1821,"_20209":53323,"_5":13819,"_26493":53158,"_2816":53324},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. If the new certificate uses the same key, it shares the SKI with the retained VA role of the deleted CA, whose signer is the old certificate: check that the CRL is generated and, if it is not, use `PUT` to set a signer of the new CA (see CRL).",{"_3328":1901,"_29138":1901,"_5":14177,"_2816":53326,"_29482":53327,"_20209":53328,"_26493":1901},"Certificate profiles",[47429,48897,52903,52904],[],{"_3328":1902,"_29138":1901,"_20209":53330,"_5":13819,"_26493":1901,"_2816":53331},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3328":1903,"_29138":1901,"_5":29479,"_20209":53333,"_26493":53334,"_2816":53335},[],"/docs/pr-preview/pr-45/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3328":1904,"_29138":1901,"_5":29479,"_20209":53337,"_26493":53338,"_2816":53339},[],"/docs/pr-preview/pr-45/platform/pki/certificate-profiles#validity","Validity",{"_3328":1905,"_29138":1901,"_5":29479,"_20209":53341,"_26493":53342,"_2816":53343},[],"/docs/pr-preview/pr-45/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3328":1906,"_29138":1901,"_5":29479,"_20209":53345,"_26493":53346,"_2816":53347},[],"/docs/pr-preview/pr-45/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3328":1907,"_29138":1901,"_5":29479,"_20209":53349,"_26493":53350,"_2816":53351},[],"/docs/pr-preview/pr-45/platform/pki/certificate-profiles#subject","Subject",{"_3328":1908,"_29138":1901,"_5":29479,"_20209":53353,"_26493":53354,"_2816":53355},[],"/docs/pr-preview/pr-45/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3328":1909,"_29138":1901,"_5":29479,"_20209":53357,"_26493":53358,"_2816":53359},[],"/docs/pr-preview/pr-45/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3328":1910,"_29138":1901,"_5":29479,"_20209":53361,"_26493":53362,"_2816":53363},[],"/docs/pr-preview/pr-45/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3328":1911,"_29138":1901,"_5":29479,"_20209":53365,"_26493":53366,"_2816":53367},[],"/docs/pr-preview/pr-45/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3328":1912,"_29138":1901,"_5":29479,"_20209":53369,"_26493":53370,"_2816":53371},[],"/docs/pr-preview/pr-45/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3328":1913,"_29138":1901,"_5":29479,"_20209":53373,"_26493":53374,"_2816":53375},[],"/docs/pr-preview/pr-45/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3328":1914,"_29138":1901,"_5":29479,"_20209":53377,"_26493":53378,"_2816":53379},[],"/docs/pr-preview/pr-45/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3328":1915,"_29138":1901,"_5":29479,"_20209":53381,"_26493":53382,"_2816":53383},[],"/docs/pr-preview/pr-45/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3328":1916,"_29138":1901,"_5":29479,"_20209":53385,"_26493":53386,"_2816":53387},[],"/docs/pr-preview/pr-45/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3328":1917,"_29138":1901,"_5":29479,"_20209":53389,"_26493":53390,"_2816":53391},[],"/docs/pr-preview/pr-45/platform/pki/certificate-profiles#design-examples","Design examples",{"_3328":1918,"_29138":1901,"_5":29479,"_20209":53393,"_26493":53394,"_2816":53395},[],"/docs/pr-preview/pr-45/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3328":1919,"_29138":1901,"_20209":53397,"_5":13819,"_26493":1901,"_2816":53398},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3328":1920,"_29138":1901,"_20209":53400,"_5":13819,"_26493":1901,"_2816":53401},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3328":1921,"_29138":1901,"_20209":53403,"_5":13819,"_26493":53338,"_2816":53404},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3328":1922,"_29138":1901,"_20209":53406,"_5":13819,"_26493":53338,"_2816":53407},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3328":1923,"_29138":1901,"_20209":53409,"_5":13819,"_26493":53342,"_2816":53410},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3328":1924,"_29138":1901,"_20209":53412,"_5":13819,"_26493":53346,"_2816":53413},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3328":1925,"_29138":1901,"_20209":53415,"_5":13819,"_26493":53346,"_2816":53416},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3328":1926,"_29138":1901,"_20209":53418,"_5":13819,"_26493":53346,"_2816":53419},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3328":1927,"_29138":1901,"_20209":53421,"_5":13819,"_26493":53350,"_2816":53422},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3328":1928,"_29138":1901,"_20209":53424,"_5":13819,"_26493":53354,"_2816":53425},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3328":1929,"_29138":1901,"_20209":53427,"_5":13819,"_26493":53354,"_2816":53428},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3328":1930,"_29138":1901,"_20209":53430,"_5":13819,"_26493":53358,"_2816":53431},[],"The cryptographic enforcement can:",{"_3328":1931,"_29138":1901,"_20209":53433,"_5":13819,"_26493":53358,"_2816":53434},[],"allow or block RSA keys;",{"_3328":1932,"_29138":1901,"_20209":53436,"_5":13819,"_26493":53358,"_2816":53437},[],"limit the supported RSA sizes;",{"_3328":1933,"_29138":1901,"_20209":53439,"_5":13819,"_26493":53358,"_2816":53440},[],"allow or block ECDSA keys;",{"_3328":1934,"_29138":1901,"_20209":53442,"_5":13819,"_26493":53358,"_2816":53443},[],"limit the supported ECDSA sizes or curves.",{"_3328":1935,"_29138":1901,"_20209":53445,"_5":13819,"_26493":53358,"_2816":53446},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3328":1936,"_29138":1901,"_20209":53448,"_5":13819,"_26493":53362,"_2816":53449},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3328":1937,"_29138":1901,"_20209":53451,"_5":13819,"_26493":53362,"_2816":50658},[],{"_3328":1938,"_29138":1901,"_20209":53453,"_5":13819,"_26493":53362,"_2816":53454},[],"First choice",{"_3328":1939,"_29138":1901,"_20209":53456,"_5":13819,"_26493":53362,"_2816":53457},[],"Second choice",{"_3328":1940,"_29138":1901,"_20209":53459,"_5":13819,"_26493":53362,"_2816":53460},[],"If neither is supplied",{"_3328":1941,"_29138":1901,"_20209":53462,"_5":13819,"_26493":53362,"_2816":53463},[],"Direct signing with a CA",{"_3328":1942,"_29138":1901,"_20209":53465,"_5":13819,"_26493":53362,"_2816":53466},[],"`issuance_profile` embedded in the request",{"_3328":1943,"_29138":1901,"_20209":53468,"_5":13819,"_26493":53362,"_2816":53469},[],"Request `issuance_profile_id`",{"_3328":1944,"_29138":1901,"_20209":53471,"_5":13819,"_26493":53362,"_2816":53472},[],"CA default profile (`profile_id`).",{"_3328":1945,"_29138":1901,"_20209":53474,"_5":13819,"_26493":53362,"_2816":53475},[],"Issuance through a DMS",{"_3328":1946,"_29138":1901,"_20209":53477,"_5":13819,"_26493":53362,"_2816":53478},[],"`settings.issuance_profile_id`",{"_3328":1947,"_29138":1901,"_20209":53480,"_5":13819,"_26493":53362,"_2816":53481},[],"`settings.issuance_profile` embedded in the DMS",{"_3328":1948,"_29138":1901,"_20209":53483,"_5":13819,"_26493":53362,"_2816":53484},[],"Enrollment CA default profile.",{"_3328":1949,"_29138":1901,"_20209":53486,"_5":13819,"_26493":53362,"_2816":53487},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3328":1950,"_29138":1901,"_20209":53489,"_5":13819,"_26493":53362,"_2816":53490},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3328":1951,"_29138":1901,"_20209":53492,"_5":13819,"_26493":53370,"_2816":53493},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3328":1952,"_29138":1901,"_20209":53495,"_5":13819,"_26493":53374,"_2816":53496},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3328":1953,"_29138":1901,"_20209":53498,"_5":13819,"_26493":53378,"_2816":53499},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3328":1954,"_29138":1901,"_20209":53501,"_5":13819,"_26493":53382,"_2816":53502},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3328":1955,"_29138":1901,"_20209":53504,"_5":13819,"_26493":53386,"_2816":53505},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3328":1956,"_29138":1901,"_20209":53507,"_5":13819,"_26493":53386,"_2816":53508},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3328":1957,"_29138":1901,"_20209":53510,"_5":13819,"_26493":53390,"_2816":53511},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3328":1958,"_29138":1901,"_20209":53513,"_5":13819,"_26493":53390,"_2816":53514},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3328":1959,"_29138":1901,"_20209":53516,"_5":13819,"_26493":53390,"_2816":53517},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3328":1960,"_29138":1901,"_20209":53519,"_5":13819,"_26493":53390,"_2816":53520},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3328":1961,"_29138":1901,"_20209":53522,"_5":13819,"_26493":53394,"_2816":53523},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3328":1962,"_29138":1901,"_20209":53525,"_5":13819,"_26493":53394,"_2816":53526},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3328":1963,"_29138":1963,"_5":14177,"_2816":53528,"_29482":53529,"_20209":53531,"_26493":1963},"Certificate validation",[47429,48897,52903,53530],"Validation",[],{"_3328":1964,"_29138":1963,"_20209":53533,"_5":13819,"_26493":1963,"_2816":53534},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3328":1965,"_29138":1963,"_5":29479,"_20209":53536,"_26493":53537,"_2816":53538},[],"/docs/pr-preview/pr-45/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3328":1966,"_29138":1963,"_5":29479,"_20209":53540,"_26493":53541,"_2816":53542},[],"/docs/pr-preview/pr-45/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3328":1967,"_29138":1963,"_5":29479,"_20209":53544,"_26493":53545,"_2816":53546},[],"/docs/pr-preview/pr-45/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3328":1968,"_29138":1963,"_20209":53548,"_5":13819,"_26493":1963,"_2816":53549},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3328":1969,"_29138":1963,"_20209":53551,"_5":13819,"_26493":53537,"_2816":53552},[],"Verify these criteria together:",{"_3328":1970,"_29138":1963,"_20209":53554,"_5":13819,"_26493":53537,"_2816":52529},[],{"_3328":1971,"_29138":1963,"_20209":53556,"_5":13819,"_26493":53537,"_2816":53557},[],"Required result",{"_3328":1972,"_29138":1963,"_20209":53559,"_5":13819,"_26493":53537,"_2816":53560},[],"Chain and signature",{"_3328":1973,"_29138":1963,"_20209":53562,"_5":13819,"_26493":53537,"_2816":53563},[],"Valid chain to a root deliberately installed in the consumer.",{"_3328":1974,"_29138":1963,"_20209":53565,"_5":13819,"_26493":53537,"_2816":53566},[],"Dates",{"_3328":1975,"_29138":1963,"_20209":53568,"_5":13819,"_26493":53537,"_2816":53569},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3328":1976,"_29138":1963,"_20209":53571,"_5":13819,"_26493":53537,"_2816":48566},[],{"_3328":1977,"_29138":1963,"_20209":53573,"_5":13819,"_26493":53537,"_2816":53574},[],"Name, SAN or identifier matches the expected peer.",{"_3328":1978,"_29138":1963,"_20209":53576,"_5":13819,"_26493":53537,"_2816":47819},[],{"_3328":1979,"_29138":1963,"_20209":53578,"_5":13819,"_26493":53537,"_2816":53579},[],"KU, EKU and constraints permit the specific operation.",{"_3328":1980,"_29138":1963,"_20209":53581,"_5":13819,"_26493":53537,"_2816":53582},[],"Revocation",{"_3328":1981,"_29138":1963,"_20209":53584,"_5":13819,"_26493":53537,"_2816":53585},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3328":1982,"_29138":1963,"_20209":53587,"_5":13819,"_26493":53537,"_2816":53588},[],"Authorization",{"_3328":1983,"_29138":1963,"_20209":53590,"_5":13819,"_26493":53537,"_2816":53591},[],"The application permits that identity to perform the action.",{"_3328":1984,"_29138":1963,"_20209":53593,"_5":13819,"_26493":53537,"_2816":53594},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3328":1985,"_29138":1963,"_20209":53596,"_5":13819,"_26493":53541,"_2816":53597},[],"Mechanism",{"_3328":1986,"_29138":1963,"_20209":53599,"_5":13819,"_26493":53541,"_2816":53600},[],"When to use it",{"_3328":1987,"_29138":1963,"_20209":53602,"_5":13819,"_26493":53541,"_2816":53603},[],"What you must maintain",{"_3328":1988,"_29138":1963,"_20209":53605,"_5":13819,"_26493":53541,"_2816":53606},[],"OCSP",{"_3328":1989,"_29138":1963,"_20209":53608,"_5":13819,"_26493":53541,"_2816":53609},[],"Status query for a specific certificate.",{"_3328":1990,"_29138":1963,"_20209":53611,"_5":13819,"_26493":53541,"_2816":53612},[],"Responder access, signature verification and cache/freshness policy.",{"_3328":1991,"_29138":1963,"_20209":53614,"_5":13819,"_26493":53541,"_2816":53615},[],"CRL",{"_3328":1992,"_29138":1963,"_20209":53617,"_5":13819,"_26493":53541,"_2816":53618},[],"Local checks for many certificates or offline operation.",{"_3328":1993,"_29138":1963,"_20209":53620,"_5":13819,"_26493":53541,"_2816":53621},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3328":1994,"_29138":1963,"_20209":53623,"_5":13819,"_26493":53541,"_2816":53624},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3328":1995,"_29138":1963,"_20209":53626,"_5":13819,"_26493":53541,"_2816":53627},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3328":1996,"_29138":1963,"_20209":53629,"_5":13819,"_26493":53545,"_2816":53630},[],"Accept a current, authorized certificate with a known chain.",{"_3328":1997,"_29138":1963,"_20209":53632,"_5":13819,"_26493":53545,"_2816":53633},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3328":1998,"_29138":1963,"_20209":53635,"_5":13819,"_26493":53545,"_2816":53636},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3328":1999,"_29138":1963,"_20209":53638,"_5":13819,"_26493":53545,"_2816":53639},[],"Check that a new connection with that identity is rejected.",{"_3328":2000,"_29138":1963,"_20209":53641,"_5":13819,"_26493":53545,"_2816":53642},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3328":2001,"_29138":1963,"_20209":53644,"_5":13819,"_26493":53545,"_2816":53645},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3328":2002,"_29138":1963,"_20209":53647,"_5":13819,"_26493":53545,"_2816":53648},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3328":2003,"_29138":1963,"_20209":53650,"_5":13819,"_26493":53545,"_2816":53651},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3328":2004,"_29138":1963,"_20209":53653,"_5":13819,"_26493":53545,"_2816":53654},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3328":2005,"_29138":2005,"_5":14177,"_2816":53656,"_29482":53657,"_20209":53658,"_26493":2005},"Certificates",[47429,48897,52903,52904],[],{"_3328":2006,"_29138":2005,"_20209":53660,"_5":13819,"_26493":2005,"_2816":53661},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3328":2007,"_29138":2005,"_5":29479,"_20209":53663,"_26493":53664,"_2816":53665},[],"/docs/pr-preview/pr-45/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3328":2008,"_29138":2005,"_5":29479,"_20209":53667,"_26493":53668,"_2816":53669},[],"/docs/pr-preview/pr-45/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3328":2009,"_29138":2005,"_5":29479,"_20209":53671,"_26493":53672,"_2816":53673},[],"/docs/pr-preview/pr-45/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3328":2010,"_29138":2005,"_5":29479,"_20209":53675,"_26493":53676,"_2816":53677},[],"/docs/pr-preview/pr-45/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3328":2011,"_29138":2005,"_5":29479,"_20209":53679,"_26493":53680,"_2816":53681},[],"/docs/pr-preview/pr-45/platform/pki/certificates#open-the-action","Open the action",{"_3328":2012,"_29138":2005,"_5":29479,"_20209":53683,"_26493":53684,"_2816":53685},[],"/docs/pr-preview/pr-45/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3328":2013,"_29138":2005,"_5":29479,"_20209":53687,"_26493":53688,"_2816":53689},[],"/docs/pr-preview/pr-45/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3328":2014,"_29138":2005,"_5":29479,"_20209":53691,"_26493":53692,"_2816":53693},[],"/docs/pr-preview/pr-45/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3328":2015,"_29138":2005,"_5":29479,"_20209":53695,"_26493":53696,"_2816":53697},[],"/docs/pr-preview/pr-45/platform/pki/certificates#continue","Continue",{"_3328":2016,"_29138":2005,"_20209":53699,"_5":13819,"_26493":2005,"_2816":53700},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3328":2017,"_29138":2005,"_20209":53702,"_5":13819,"_26493":53664,"_2816":53703},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3328":2018,"_29138":2005,"_20209":53705,"_5":13819,"_26493":53664,"_2816":53706},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3328":2019,"_29138":2005,"_20209":53708,"_5":13819,"_26493":53668,"_2816":53709},[],"Download the PEM and inspect it:",{"_3328":2020,"_29138":2005,"_20209":53711,"_5":13819,"_26493":53668,"_2816":53712},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3328":2021,"_29138":2005,"_20209":53714,"_5":13819,"_26493":53672,"_2816":53715},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3328":2022,"_29138":2005,"_20209":53717,"_5":13819,"_26493":53672,"_2816":53718},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3328":2023,"_29138":2005,"_20209":53720,"_5":13819,"_26493":53672,"_2816":53721},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3328":2024,"_29138":2005,"_20209":53723,"_5":13819,"_26493":53672,"_2816":53724},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3328":2025,"_29138":2005,"_20209":53726,"_5":13819,"_26493":53672,"_2816":53727},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3328":2026,"_29138":2005,"_20209":53729,"_5":13819,"_26493":53672,"_2816":53730},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3328":2027,"_29138":2005,"_20209":53732,"_5":13819,"_26493":53672,"_2816":53733},[],"For browser key generation, follow Issue your first certificate.",{"_3328":2028,"_29138":2005,"_20209":53735,"_5":13819,"_26493":53676,"_2816":53736},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3328":2029,"_29138":2005,"_20209":53738,"_5":13819,"_26493":53680,"_2816":53739},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3328":2030,"_29138":2005,"_20209":53741,"_5":13819,"_26493":53684,"_2816":53742},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3328":2031,"_29138":2005,"_20209":53744,"_5":13819,"_26493":53688,"_2816":53745},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3328":2032,"_29138":2005,"_20209":53747,"_5":13819,"_26493":53688,"_2816":53748},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3328":2033,"_29138":2005,"_20209":53750,"_5":13819,"_26493":53688,"_2816":53751},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3328":2034,"_29138":2005,"_20209":53753,"_5":13819,"_26493":53692,"_2816":53754},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3328":2035,"_29138":2005,"_20209":53756,"_5":13819,"_26493":53692,"_2816":53757},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3328":2036,"_29138":2005,"_20209":53759,"_5":13819,"_26493":53692,"_2816":53760},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3328":2037,"_29138":2005,"_20209":53762,"_5":13819,"_26493":53696,"_2816":53763},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3328":2038,"_29138":2005,"_20209":53765,"_5":13819,"_26493":53696,"_2816":53766},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3328":2039,"_29138":2039,"_5":14177,"_2816":53768,"_29482":53769,"_20209":53771,"_26493":2039},"Certificate lifecycle",[47429,48897,52903,53770],"Concepts",[],{"_3328":2040,"_29138":2039,"_20209":53773,"_5":13819,"_26493":2039,"_2816":53774},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3328":2041,"_29138":2039,"_5":29479,"_20209":53776,"_26493":53777,"_2816":53778},[],"/docs/pr-preview/pr-45/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3328":2042,"_29138":2039,"_5":29479,"_20209":53780,"_26493":53781,"_2816":53782},[],"/docs/pr-preview/pr-45/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3328":2043,"_29138":2039,"_5":29479,"_20209":53784,"_26493":53785,"_2816":53786},[],"/docs/pr-preview/pr-45/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3328":2044,"_29138":2039,"_5":29479,"_20209":53788,"_26493":53789,"_2816":53790},[],"/docs/pr-preview/pr-45/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3328":2045,"_29138":2039,"_5":29479,"_20209":53792,"_26493":53793,"_2816":53794},[],"/docs/pr-preview/pr-45/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3328":2046,"_29138":2039,"_5":29479,"_20209":53796,"_26493":53797,"_2816":53798},[],"/docs/pr-preview/pr-45/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3328":2047,"_29138":2039,"_5":29479,"_20209":53800,"_26493":53801,"_2816":53802},[],"/docs/pr-preview/pr-45/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3328":2048,"_29138":2039,"_5":29479,"_20209":53804,"_26493":53805,"_2816":53806},[],"/docs/pr-preview/pr-45/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3328":2049,"_29138":2039,"_5":29479,"_20209":53808,"_26493":53809,"_2816":53810},[],"/docs/pr-preview/pr-45/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3328":2050,"_29138":2039,"_5":29479,"_20209":53812,"_26493":53813,"_2816":53814},[],"/docs/pr-preview/pr-45/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3328":2051,"_29138":2039,"_20209":53816,"_5":13819,"_26493":2039,"_2816":53817},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3328":2052,"_29138":2039,"_20209":53819,"_5":13819,"_26493":53781,"_2816":53820},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3328":2053,"_29138":2039,"_20209":53822,"_5":13819,"_26493":53785,"_2816":53823},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3328":2054,"_29138":2039,"_20209":53825,"_5":13819,"_26493":53789,"_2816":53826},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3328":2055,"_29138":2039,"_20209":53828,"_5":13819,"_26493":53793,"_2816":53829},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3328":2056,"_29138":2039,"_20209":53831,"_5":13819,"_26493":53797,"_2816":53832},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3328":2057,"_29138":2039,"_20209":53834,"_5":13819,"_26493":53801,"_2816":53835},[],"Lamassu persists four X.509 states:",{"_3328":2058,"_29138":2039,"_20209":53837,"_5":13819,"_26493":53801,"_2816":53838},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3328":2059,"_29138":2039,"_20209":53840,"_5":13819,"_26493":53801,"_2816":53841},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3328":2060,"_29138":2039,"_20209":53843,"_5":13819,"_26493":53801,"_2816":53844},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3328":2061,"_29138":2039,"_20209":53846,"_5":13819,"_26493":53801,"_2816":53847},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3328":2062,"_29138":2039,"_20209":53849,"_5":13819,"_26493":53801,"_2816":53850},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3328":2063,"_29138":2039,"_20209":53852,"_5":13819,"_26493":53805,"_2816":53853},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3328":2064,"_29138":2039,"_20209":53855,"_5":13819,"_26493":53805,"_2816":53856},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3328":2065,"_29138":2039,"_20209":53858,"_5":13819,"_26493":53805,"_2816":53859},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3328":2066,"_29138":2039,"_20209":53861,"_5":13819,"_26493":53809,"_2816":53862},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3328":2067,"_29138":2039,"_20209":53864,"_5":13819,"_26493":53809,"_2816":53865},[],"Before confirming:",{"_3328":2068,"_29138":2039,"_20209":53867,"_5":13819,"_26493":53809,"_2816":53868},[],"Identify DMSs, devices and services that trust that chain.",{"_3328":2069,"_29138":2039,"_20209":53870,"_5":13819,"_26493":53809,"_2816":53871},[],"Distribute the new chain of trust.",{"_3328":2070,"_29138":2039,"_20209":53873,"_5":13819,"_26493":53809,"_2816":53874},[],"Reissue the necessary identities.",{"_3328":2071,"_29138":2039,"_20209":53876,"_5":13819,"_26493":53809,"_2816":53877},[],"Check OCSP and CRL from a real consumer.",{"_3328":2072,"_29138":2039,"_20209":53879,"_5":13819,"_26493":53809,"_2816":53880},[],"Revoke the old CA once no legitimate traffic remains.",{"_3328":2073,"_29138":2039,"_20209":53882,"_5":13819,"_26493":53809,"_2816":53883},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3328":2074,"_29138":2039,"_20209":53885,"_5":13819,"_26493":53813,"_2816":53886},[],"Certificates entering the preventive or critical renewal window.",{"_3328":2075,"_29138":2039,"_20209":53888,"_5":13819,"_26493":53813,"_2816":53889},[],"Repeated enrollment or re-enrollment failures.",{"_3328":2076,"_29138":2039,"_20209":53891,"_5":13819,"_26493":53813,"_2816":53892},[],"Status changes and revocation reasons.",{"_3328":2077,"_29138":2039,"_20209":53894,"_5":13819,"_26493":53813,"_2816":53895},[],"OCSP and CRL publication and validity.",{"_3328":2078,"_29138":2039,"_20209":53897,"_5":13819,"_26493":53813,"_2816":53898},[],"Dependencies still presenting a replaced certificate.",{"_3328":2079,"_29138":2039,"_20209":53900,"_5":13819,"_26493":53813,"_2816":53901},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3328":2080,"_29138":2080,"_5":14177,"_2816":53903,"_29482":53904,"_20209":53905,"_26493":2080},"Trust model",[47429,48897,52903,53770],[],{"_3328":2081,"_29138":2080,"_20209":53907,"_5":13819,"_26493":2080,"_2816":53908},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3328":2082,"_29138":2080,"_5":29479,"_20209":53910,"_26493":53911,"_2816":53912},[],"/docs/pr-preview/pr-45/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3328":2083,"_29138":2080,"_5":29479,"_20209":53914,"_26493":53915,"_2816":53916},[],"/docs/pr-preview/pr-45/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3328":2084,"_29138":2080,"_5":29479,"_20209":53918,"_26493":53919,"_2816":53920},[],"/docs/pr-preview/pr-45/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3328":2085,"_29138":2080,"_5":29479,"_20209":53922,"_26493":53923,"_2816":53924},[],"/docs/pr-preview/pr-45/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3328":2086,"_29138":2080,"_5":29479,"_20209":53926,"_26493":53927,"_2816":53928},[],"/docs/pr-preview/pr-45/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3328":2087,"_29138":2080,"_5":29479,"_20209":53930,"_26493":53931,"_2816":53932},[],"/docs/pr-preview/pr-45/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3328":2088,"_29138":2080,"_5":29479,"_20209":53934,"_26493":53935,"_2816":53936},[],"/docs/pr-preview/pr-45/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3328":2089,"_29138":2080,"_5":29479,"_20209":53938,"_26493":53939,"_2816":53940},[],"/docs/pr-preview/pr-45/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3328":2090,"_29138":2080,"_5":29479,"_20209":53942,"_26493":53943,"_2816":53944},[],"/docs/pr-preview/pr-45/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3328":2091,"_29138":2080,"_5":29479,"_20209":53946,"_26493":53947,"_2816":53948},[],"/docs/pr-preview/pr-45/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3328":2092,"_29138":2080,"_20209":53950,"_5":13819,"_26493":2080,"_2816":53951},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3328":2093,"_29138":2080,"_20209":53953,"_5":13819,"_26493":53915,"_2816":53954},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3328":2094,"_29138":2080,"_20209":53956,"_5":13819,"_26493":53919,"_2816":53957},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3328":2095,"_29138":2080,"_20209":53959,"_5":13819,"_26493":53923,"_2816":53960},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3328":2096,"_29138":2080,"_20209":53962,"_5":13819,"_26493":53927,"_2816":53963},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3328":2097,"_29138":2080,"_20209":53965,"_5":13819,"_26493":53931,"_2816":53966},[],"The device proves it can enroll according to the DMS policy.",{"_3328":2098,"_29138":2080,"_20209":53968,"_5":13819,"_26493":53931,"_2816":53969},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3328":2099,"_29138":2080,"_20209":53971,"_5":13819,"_26493":53931,"_2816":53972},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3328":2100,"_29138":2080,"_20209":53974,"_5":13819,"_26493":53931,"_2816":53975},[],"The device installs the certificate and the chain it needs.",{"_3328":2101,"_29138":2080,"_20209":53977,"_5":13819,"_26493":53931,"_2816":53978},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3328":2102,"_29138":2080,"_20209":53980,"_5":13819,"_26493":53931,"_2816":53981},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3328":2103,"_29138":2080,"_20209":53983,"_5":13819,"_26493":53935,"_2816":53984},[],"A DMS relates three sets that are worth designing separately:",{"_3328":2104,"_29138":2080,"_20209":53986,"_5":13819,"_26493":53935,"_2816":53987},[],"**Enrollment CA:** signs the new identities.",{"_3328":2105,"_29138":2080,"_20209":53989,"_5":13819,"_26493":53935,"_2816":53990},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3328":2106,"_29138":2080,"_20209":53992,"_5":13819,"_26493":53935,"_2816":53993},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3328":2107,"_29138":2080,"_20209":53995,"_5":13819,"_26493":53935,"_2816":53996},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3328":2108,"_29138":2080,"_20209":53998,"_5":13819,"_26493":53939,"_2816":53999},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3328":2109,"_29138":2080,"_20209":54001,"_5":13819,"_26493":53939,"_2816":54002},[],"that the current date is between `Not Before` and `Not After`;",{"_3328":2110,"_29138":2080,"_20209":54004,"_5":13819,"_26493":53939,"_2816":54005},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3328":2111,"_29138":2080,"_20209":54007,"_5":13819,"_26493":53939,"_2816":54008},[],"that names, SANs and subject match the expected identity;",{"_3328":2112,"_29138":2080,"_20209":54010,"_5":13819,"_26493":53939,"_2816":54011},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3328":2113,"_29138":2080,"_20209":54013,"_5":13819,"_26493":53939,"_2816":54014},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3328":2114,"_29138":2080,"_20209":54016,"_5":13819,"_26493":53939,"_2816":54017},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3328":2115,"_29138":2080,"_20209":54019,"_5":13819,"_26493":53943,"_2816":54020},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3328":2116,"_29138":2080,"_20209":54022,"_5":13819,"_26493":53947,"_2816":54023},[],"Keep the root out of daily operations, or with very restricted access.",{"_3328":2117,"_29138":2080,"_20209":54025,"_5":13819,"_26493":53947,"_2816":54026},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3328":2118,"_29138":2080,"_20209":54028,"_5":13819,"_26493":53947,"_2816":54029},[],"Assign explicit profiles to every use case.",{"_3328":2119,"_29138":2080,"_20209":54031,"_5":13819,"_26493":53947,"_2816":54032},[],"Distribute the new trust before starting a rotation.",{"_3328":2120,"_29138":2080,"_20209":54034,"_5":13819,"_26493":53947,"_2816":54035},[],"Keep enough overlap to renew a disconnected fleet.",{"_3328":2121,"_29138":2080,"_20209":54037,"_5":13819,"_26493":53947,"_2816":54038},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3328":2122,"_29138":2080,"_20209":54040,"_5":13819,"_26493":53947,"_2816":54041},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3328":2123,"_29138":2123,"_5":14177,"_2816":54043,"_29482":54044,"_20209":54045,"_26493":2123},"Revocation lists (CRL)",[47429,48897,52903,53530],[],{"_3328":2124,"_29138":2123,"_20209":54047,"_5":13819,"_26493":2123,"_2816":54048},[],"Generate and distribute signed lists to validate certificates offline.",{"_3328":2125,"_29138":2123,"_5":29479,"_20209":54050,"_26493":54051,"_2816":54052},[],"/docs/pr-preview/pr-45/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_3328":2126,"_29138":2123,"_5":29479,"_20209":54054,"_26493":54055,"_2816":54056},[],"/docs/pr-preview/pr-45/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3328":2127,"_29138":2123,"_5":29479,"_20209":54058,"_26493":54059,"_2816":54060},[],"/docs/pr-preview/pr-45/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3328":2128,"_29138":2123,"_5":29479,"_20209":54062,"_26493":54063,"_2816":54064},[],"/docs/pr-preview/pr-45/platform/pki/crl#crl-contents","CRL contents",{"_3328":2129,"_29138":2123,"_5":29479,"_20209":54066,"_26493":54067,"_2816":54068},[],"/docs/pr-preview/pr-45/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3328":2130,"_29138":2123,"_5":29479,"_20209":54070,"_26493":54071,"_2816":54072},[],"/docs/pr-preview/pr-45/platform/pki/crl#va-role-management-api","VA role management API",{"_3328":2131,"_29138":2123,"_5":29479,"_20209":54074,"_26493":54075,"_2816":54076},[],"/docs/pr-preview/pr-45/platform/pki/crl#common-va-role-errors","Common VA role errors",{"_3328":2132,"_29138":2123,"_5":29479,"_20209":54078,"_26493":54079,"_2816":54080},[],"/docs/pr-preview/pr-45/platform/pki/crl#from-the-interface","From the interface",{"_3328":2133,"_29138":2123,"_5":29479,"_20209":54082,"_26493":54083,"_2816":54084},[],"/docs/pr-preview/pr-45/platform/pki/crl#references","References",{"_3328":2134,"_29138":2123,"_20209":54086,"_5":13819,"_26493":2123,"_2816":54087},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3328":2135,"_29138":2123,"_20209":54089,"_5":13819,"_26493":54051,"_2816":54090},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3328":2136,"_29138":2123,"_20209":54092,"_5":13819,"_26493":54051,"_2816":54093},[],"`crl_options` field",{"_3328":2137,"_29138":2123,"_20209":54095,"_5":13819,"_26493":54051,"_2816":47819},[],{"_3328":2138,"_29138":2123,"_20209":54097,"_5":13819,"_26493":54051,"_2816":54098},[],"Backend initial value",{"_3328":2139,"_29138":2123,"_20209":54100,"_5":13819,"_26493":54051,"_2816":54101},[],"`validity`",{"_3328":2140,"_29138":2123,"_20209":54103,"_5":13819,"_26493":54051,"_2816":54104},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3328":2141,"_29138":2123,"_20209":54106,"_5":13819,"_26493":54051,"_2816":54107},[],"7 days.",{"_3328":2142,"_29138":2123,"_20209":54109,"_5":13819,"_26493":54051,"_2816":54110},[],"`refresh_interval`",{"_3328":2143,"_29138":2123,"_20209":54112,"_5":13819,"_26493":54051,"_2816":54113},[],"Stored and returned by the API, but the VA does not use it: scheduled renewal does not depend on it (see Periodic and automatic regeneration).",{"_3328":2144,"_29138":2123,"_20209":54115,"_5":13819,"_26493":54051,"_2816":54116},[],"6 days and 23 hours.",{"_3328":2145,"_29138":2123,"_20209":54118,"_5":13819,"_26493":54051,"_2816":54119},[],"`regenerate_on_revoke`",{"_3328":2146,"_29138":2123,"_20209":54121,"_5":13819,"_26493":54051,"_2816":54122},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3328":2147,"_29138":2123,"_20209":54124,"_5":13819,"_26493":54051,"_2816":54125},[],"`true`.",{"_3328":2148,"_29138":2123,"_20209":54127,"_5":13819,"_26493":54051,"_2816":54128},[],"`signer_certificate_serial_number`",{"_3328":2149,"_29138":2123,"_20209":54130,"_5":13819,"_26493":54051,"_2816":54131},[],"Serial number of the existing certificate that signs the CRL.",{"_3328":2150,"_29138":2123,"_20209":54133,"_5":13819,"_26493":54051,"_2816":54134},[],"Serial number of the CA’s current certificate.",{"_3328":2151,"_29138":2123,"_20209":54136,"_5":13819,"_26493":54051,"_2816":54137},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3328":2152,"_29138":2123,"_20209":54139,"_5":13819,"_26493":54051,"_2816":54140},[],"When a CA is reissued, the role keeps pointing at the previous certificate. CRLs remain valid because both certificates share subject and key, but the previous certificate cannot be deleted while the role uses it. To retire it, update the role’s signer.",{"_3328":2153,"_29138":2123,"_20209":54142,"_5":13819,"_26493":54051,"_2816":54143},[],"When a CA is deleted, its VA role is kept and cannot be removed through the API. If no other CA with the same SKI remains, the role can be read but any `PUT` returns 404, and the renewal job logs a warning on every cycle because it no longer finds the CA. The API offers no way out; it can only be fixed by editing the database. If another CA with that SKI remains, the role is still editable (see CAs that share a key). Adjust validity and signer before deleting the CA.",{"_3328":2154,"_29138":2123,"_20209":54145,"_5":13819,"_26493":54051,"_2816":54146},[],"A CA whose certificate lacks `cRLSign` cannot generate its CRL or edit its role (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and set it as the signer with `PUT`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages.",{"_3328":2155,"_29138":2123,"_20209":54148,"_5":13819,"_26493":54051,"_2816":54149},[],"`PUT` always validates the signer, even when the request does not change it. If the stored signer is no longer valid, no field of the role can be modified, not even the validity, until a valid one is set.",{"_3328":2156,"_29138":2123,"_20209":54151,"_5":13819,"_26493":54051,"_2816":54152},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_3328":2157,"_29138":2123,"_20209":54154,"_5":13819,"_26493":54055,"_2816":54155},[],"The VA identifies each CRL by the CA’s SKI, and the SKI is derived from its key. Two CAs with the same key have the same SKI and share a single VA role and a single CRL. This happens when a CA is created on an existing KMS key, or when a CA is imported whose certificate declares an SKI already in use. Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. The first CA creates the role and the others keep it.",{"_3328":2158,"_29138":2123,"_20209":54157,"_5":13819,"_26493":54055,"_2816":54158},[],"The certificates of all of them point to `/crl/{ski}`, but the published list has the first CA as issuer and only includes its revocations. A verifier compares the CRL issuer with the issuer of the certificate it validates (RFC 5280, §6.3.2) and rejects the list if they differ. Depending on its policy, the certificate is blocked (*hard-fail*) or accepted even though it is revoked (*soft-fail*). Revocations of the secondary CAs do not appear in any list.",{"_3328":2159,"_29138":2123,"_20209":54160,"_5":13819,"_26493":54055,"_2816":54161},[],"If the first CA is deleted, CRL generation for the remaining one fails because the configured signer no longer matches a CA with that name. Until the role’s signer is updated to a certificate of the remaining CA, the last published list keeps being served until it expires (7 days by default).",{"_3328":2160,"_29138":2123,"_20209":54163,"_5":13819,"_26493":54055,"_2816":54164},[],"To detect the problem, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued. A CA imported with an SKI already in use does not replace the existing one as CRL issuer, because the issuer is resolved from the role’s signer. However, its own certificates point to that same URL and its revocations are not published. Until Lamassu rejects these imports, restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same collision, so also avoid reusing keys across CAs. A per-CA CRL and the rejection of imports whose SKI collides with an existing CA are both proposed in lamassuiot#834, and neither is implemented yet.",{"_3328":2161,"_29138":2123,"_20209":54166,"_5":13819,"_26493":54059,"_2816":54167},[],"The VA scheduled job checks every role on each run and requests another list when the remaining validity of `latest_crl` is less than the interval between runs. The frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. `refresh_interval` plays no part. Keep `validity` well above the interval: with a shorter validity, the list is regenerated on every cycle.",{"_3328":2162,"_29138":2123,"_20209":54169,"_5":13819,"_26493":54059,"_2816":54170},[],"If generation fails (for example, because of a role without a CA or an invalid signer), the job logs the warning `something went wrong while calculating CRL for CA <ski>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3328":2163,"_29138":2123,"_20209":54172,"_5":13819,"_26493":54059,"_2816":54173},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if it fails (missing role, invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3328":2164,"_29138":2123,"_20209":54175,"_5":13819,"_26493":54059,"_2816":54176},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3328":2165,"_29138":2123,"_20209":54178,"_5":13819,"_26493":54063,"_2816":54179},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3328":2166,"_29138":2123,"_20209":54181,"_5":13819,"_26493":54063,"_2816":54182},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3328":2167,"_29138":2123,"_20209":54184,"_5":13819,"_26493":54067,"_2816":54185},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_3328":2168,"_29138":2123,"_20209":54187,"_5":13819,"_26493":54067,"_2816":54188},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3328":2169,"_29138":2123,"_20209":54190,"_5":13819,"_26493":54067,"_2816":54191},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3328":2170,"_29138":2123,"_20209":54193,"_5":13819,"_26493":54067,"_2816":54194},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3328":2171,"_29138":2123,"_20209":54196,"_5":13819,"_26493":54067,"_2816":54197},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3328":2172,"_29138":2123,"_20209":54199,"_5":13819,"_26493":54071,"_2816":54200},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3328":2173,"_29138":2123,"_20209":54202,"_5":13819,"_26493":54071,"_2816":50661},[],{"_3328":2174,"_29138":2123,"_20209":54204,"_5":13819,"_26493":54071,"_2816":54205},[],"Relative path",{"_3328":2175,"_29138":2123,"_20209":54207,"_5":13819,"_26493":54071,"_2816":50658},[],{"_3328":2176,"_29138":2123,"_20209":54209,"_5":13819,"_26493":54071,"_2816":54210},[],"`GET`",{"_3328":2177,"_29138":2123,"_20209":54212,"_5":13819,"_26493":54071,"_2816":54213},[],"`/v1/roles/{ca-ski}`",{"_3328":2178,"_29138":2123,"_20209":54215,"_5":13819,"_26493":54071,"_2816":54216},[],"Read `crl_options` and `latest_crl`.",{"_3328":2179,"_29138":2123,"_20209":54218,"_5":13819,"_26493":54071,"_2816":54219},[],"`PUT`",{"_3328":2180,"_29138":2123,"_20209":54221,"_5":13819,"_26493":54071,"_2816":54213},[],{"_3328":2181,"_29138":2123,"_20209":54223,"_5":13819,"_26493":54071,"_2816":54224},[],"Replace CRL configuration.",{"_3328":2182,"_29138":2123,"_20209":54226,"_5":13819,"_26493":54071,"_2816":54227},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_3328":2183,"_29138":2123,"_20209":54229,"_5":13819,"_26493":54071,"_2816":54230},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_3328":2184,"_29138":2123,"_20209":54232,"_5":13819,"_26493":54075,"_2816":54233},[],"Symptom",{"_3328":2185,"_29138":2123,"_20209":54235,"_5":13819,"_26493":54075,"_2816":54236},[],"Cause",{"_3328":2186,"_29138":2123,"_20209":54238,"_5":13819,"_26493":54075,"_2816":54239},[],"Action",{"_3328":2187,"_29138":2123,"_20209":54241,"_5":13819,"_26493":54075,"_2816":54242},[],"`PUT /v1/roles/{ca-ski}` returns 404 and `GET` returns 200.",{"_3328":2188,"_29138":2123,"_20209":54244,"_5":13819,"_26493":54075,"_2816":54245},[],"The role’s CA was deleted and no other CA with the same SKI remains.",{"_3328":2189,"_29138":2123,"_20209":54247,"_5":13819,"_26493":54075,"_2816":54248},[],"There is no API way out; it requires database intervention. Avoid it by adjusting the role before deleting the CA.",{"_3328":2190,"_29138":2123,"_20209":54250,"_5":13819,"_26493":54075,"_2816":54251},[],"`PUT` returns 400.",{"_3328":2191,"_29138":2123,"_20209":54253,"_5":13819,"_26493":54075,"_2816":54254},[],"The signer lacks `cRLSign`, or its subject and key match no CA with that SKI (for example, after deleting the first of two CAs that share a key).",{"_3328":2192,"_29138":2123,"_20209":54256,"_5":13819,"_26493":54075,"_2816":54257},[],"Use `PUT` to set the serial number of a valid certificate of the remaining CA.",{"_3328":2193,"_29138":2123,"_20209":54259,"_5":13819,"_26493":54075,"_2816":54260},[],"`PUT` returns 400 from a 3.x client.",{"_3328":2194,"_29138":2123,"_20209":54262,"_5":13819,"_26493":54075,"_2816":54263},[],"`crl_options.subject_key_id_signer` was replaced by `signer_certificate_serial_number`, which is required.",{"_3328":2195,"_29138":2123,"_20209":54265,"_5":13819,"_26493":54075,"_2816":54266},[],"Update the client to send the new field.",{"_3328":2196,"_29138":2123,"_20209":54268,"_5":13819,"_26493":54075,"_2816":54269},[],"The CRL does not change after revoking a certificate.",{"_3328":2197,"_29138":2123,"_20209":54271,"_5":13819,"_26493":54075,"_2816":54272},[],"`regenerate_on_revoke` is `false`, or the event failed because of a missing role or an invalid signer.",{"_3328":2198,"_29138":2123,"_20209":54274,"_5":13819,"_26493":54075,"_2816":54275},[],"Check the VA logs and the failed-events queue; fix the signer.",{"_3328":2199,"_29138":2123,"_20209":54277,"_5":13819,"_26493":54075,"_2816":54278},[],"A verifier rejects the CRL because of the issuer.",{"_3328":2200,"_29138":2123,"_20209":54280,"_5":13819,"_26493":54075,"_2816":54281},[],"Several CAs share an SKI.",{"_3328":2201,"_29138":2123,"_20209":54283,"_5":13819,"_26493":54075,"_2816":54284},[],"See CAs that share a key.",{"_3328":2202,"_29138":2123,"_20209":54286,"_5":13819,"_26493":54079,"_2816":54287},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_3328":2203,"_29138":2123,"_20209":54289,"_5":13819,"_26493":54083,"_2816":54290},[],"RFC 5280: X.509 and CRL profile.",{"_3328":2204,"_29138":2123,"_20209":54292,"_5":13819,"_26493":54083,"_2816":54293},[],"OpenSSL: openssl-crl.",{"_3328":2205,"_29138":2123,"_20209":54295,"_5":13819,"_26493":54083,"_2816":54296},[],"OpenSSL: openssl-verify.",{"_3328":2206,"_29138":2123,"_20209":54298,"_5":13819,"_26493":54083,"_2816":54299},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3328":2207,"_29138":2123,"_20209":54301,"_5":13819,"_26493":54083,"_2816":54302},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3328":2208,"_29138":2208,"_5":14177,"_2816":54304,"_29482":54305,"_20209":54306,"_26493":2208},"Keys and cryptographic engines",[47429,48897,52903,52904],[],{"_3328":2209,"_29138":2208,"_20209":54308,"_5":13819,"_26493":2208,"_2816":54309},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3328":2210,"_29138":2208,"_5":29479,"_20209":54311,"_26493":54312,"_2816":54313},[],"/docs/pr-preview/pr-45/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3328":2211,"_29138":2208,"_5":29479,"_20209":54315,"_26493":54316,"_2816":54317},[],"/docs/pr-preview/pr-45/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3328":2212,"_29138":2208,"_5":29479,"_20209":54319,"_26493":54320,"_2816":54321},[],"/docs/pr-preview/pr-45/platform/pki/key-management#file-system","File System",{"_3328":2213,"_29138":2208,"_5":29479,"_20209":54323,"_26493":54324,"_2816":54325},[],"/docs/pr-preview/pr-45/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3328":2214,"_29138":2208,"_5":29479,"_20209":54327,"_26493":54328,"_2816":54329},[],"/docs/pr-preview/pr-45/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3328":2215,"_29138":2208,"_5":29479,"_20209":54331,"_26493":54332,"_2816":54333},[],"/docs/pr-preview/pr-45/platform/pki/key-management#aws-kms","AWS KMS",{"_3328":2216,"_29138":2208,"_5":29479,"_20209":54335,"_26493":54336,"_2816":54337},[],"/docs/pr-preview/pr-45/platform/pki/key-management#pkcs11","PKCS#11",{"_3328":2217,"_29138":2208,"_5":29479,"_20209":54339,"_26493":54340,"_2816":54341},[],"/docs/pr-preview/pr-45/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3328":2218,"_29138":2208,"_5":29479,"_20209":54343,"_26493":54344,"_2816":54345},[],"/docs/pr-preview/pr-45/platform/pki/key-management#key-inventory","Key inventory",{"_3328":2219,"_29138":2208,"_5":29479,"_20209":54347,"_26493":54348,"_2816":54349},[],"/docs/pr-preview/pr-45/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3328":2220,"_29138":2208,"_5":29479,"_20209":54351,"_26493":54352,"_2816":54353},[],"/docs/pr-preview/pr-45/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3328":2221,"_29138":2208,"_5":29479,"_20209":54355,"_26493":54356,"_2816":54357},[],"/docs/pr-preview/pr-45/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3328":2222,"_29138":2208,"_5":29479,"_20209":54359,"_26493":54360,"_2816":54361},[],"/docs/pr-preview/pr-45/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3328":2223,"_29138":2208,"_5":29479,"_20209":54363,"_26493":54364,"_2816":54365},[],"/docs/pr-preview/pr-45/platform/pki/key-management#view-details","View details",{"_3328":2224,"_29138":2208,"_5":29479,"_20209":54367,"_26493":54368,"_2816":54369},[],"/docs/pr-preview/pr-45/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3328":2225,"_29138":2208,"_5":29479,"_20209":54371,"_26493":54372,"_2816":54373},[],"/docs/pr-preview/pr-45/platform/pki/key-management#sign","Sign",{"_3328":2226,"_29138":2208,"_5":29479,"_20209":54375,"_26493":54376,"_2816":54377},[],"/docs/pr-preview/pr-45/platform/pki/key-management#verify","Verify",{"_3328":2227,"_29138":2208,"_5":29479,"_20209":54379,"_26493":54380,"_2816":54381},[],"/docs/pr-preview/pr-45/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3328":2228,"_29138":2208,"_5":29479,"_20209":54383,"_26493":54384,"_2816":54385},[],"/docs/pr-preview/pr-45/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3328":2229,"_29138":2208,"_5":29479,"_20209":54387,"_26493":54388,"_2816":54389},[],"/docs/pr-preview/pr-45/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3328":2230,"_29138":2208,"_20209":54391,"_5":13819,"_26493":2208,"_2816":54392},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3328":2231,"_29138":2208,"_20209":54394,"_5":13819,"_26493":2208,"_2816":54395},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3328":2232,"_29138":2208,"_20209":54397,"_5":13819,"_26493":54312,"_2816":54398},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3328":2233,"_29138":2208,"_20209":54400,"_5":13819,"_26493":54312,"_2816":54401},[],"In practice, it lets you:",{"_3328":2234,"_29138":2208,"_20209":54403,"_5":13819,"_26493":54312,"_2816":54404},[],"Generate new key pairs from Lamassu IoT.",{"_3328":2235,"_29138":2208,"_20209":54406,"_5":13819,"_26493":54312,"_2816":54407},[],"Import keys created externally.",{"_3328":2236,"_29138":2208,"_20209":54409,"_5":13819,"_26493":54312,"_2816":54410},[],"Delegate custody and cryptographic operations to external engines.",{"_3328":2237,"_29138":2208,"_20209":54412,"_5":13819,"_26493":54312,"_2816":54413},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3328":2238,"_29138":2208,"_20209":54415,"_5":13819,"_26493":54316,"_2816":54416},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3328":2239,"_29138":2208,"_20209":54418,"_5":13819,"_26493":54316,"_2816":54419},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3328":2240,"_29138":2208,"_20209":54421,"_5":13819,"_26493":54316,"_2816":54422},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3328":2241,"_29138":2208,"_20209":54424,"_5":13819,"_26493":54320,"_2816":54425},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3328":2242,"_29138":2208,"_20209":54427,"_5":13819,"_26493":54324,"_2816":54428},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3328":2243,"_29138":2208,"_20209":54430,"_5":13819,"_26493":54324,"_2816":54431},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3328":2244,"_29138":2208,"_20209":54433,"_5":13819,"_26493":54328,"_2816":54434},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3328":2245,"_29138":2208,"_20209":54436,"_5":13819,"_26493":54332,"_2816":54437},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3328":2246,"_29138":2208,"_20209":54439,"_5":13819,"_26493":54336,"_2816":54440},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3328":2247,"_29138":2208,"_20209":54442,"_5":13819,"_26493":54340,"_2816":54443},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3328":2248,"_29138":2208,"_20209":54445,"_5":13819,"_26493":54340,"_2816":54446},[],"Lamassu shows the enabled engines in the console.",{"_3328":2249,"_29138":2208,"_20209":54448,"_5":13819,"_26493":54340,"_2816":54449},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3328":2250,"_29138":2208,"_20209":54451,"_5":13819,"_26493":54340,"_2816":54452},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3328":2251,"_29138":2208,"_20209":54454,"_5":13819,"_26493":54344,"_2816":54455},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3328":2252,"_29138":2208,"_20209":54457,"_5":13819,"_26493":54344,"_2816":54458},[],"The table includes the following fields:",{"_3328":2253,"_29138":2208,"_20209":54460,"_5":13819,"_26493":54344,"_2816":54461},[],"**Name**: descriptive name of the key.",{"_3328":2254,"_29138":2208,"_20209":54463,"_5":13819,"_26493":54344,"_2816":54464},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3328":2255,"_29138":2208,"_20209":54466,"_5":13819,"_26493":54344,"_2816":54467},[],"**Strength**: visual indicator of cryptographic strength.",{"_3328":2256,"_29138":2208,"_20209":54469,"_5":13819,"_26493":54344,"_2816":54470},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3328":2257,"_29138":2208,"_20209":54472,"_5":13819,"_26493":54344,"_2816":54473},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3328":2258,"_29138":2208,"_20209":54475,"_5":13819,"_26493":54344,"_2816":54476},[],"**Aliases**: alternative names associated with the key.",{"_3328":2259,"_29138":2208,"_20209":54478,"_5":13819,"_26493":54344,"_2816":54479},[],"**Tags**: labels for classification and search.",{"_3328":2260,"_29138":2208,"_20209":54481,"_5":13819,"_26493":54344,"_2816":54482},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3328":2261,"_29138":2208,"_20209":54484,"_5":13819,"_26493":54344,"_2816":54485},[],"From this view you also reach the most common actions:",{"_3328":2262,"_29138":2208,"_20209":54487,"_5":13819,"_26493":54344,"_2816":54488},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3328":2263,"_29138":2208,"_20209":54490,"_5":13819,"_26493":54344,"_2816":54491},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3328":2264,"_29138":2208,"_20209":54493,"_5":13819,"_26493":54344,"_2816":54494},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3328":2265,"_29138":2208,"_20209":54496,"_5":13819,"_26493":54344,"_2816":54497},[],"**Delete Key** to remove the key from the system.",{"_3328":2266,"_29138":2208,"_20209":54499,"_5":13819,"_26493":54348,"_2816":54500},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3328":2267,"_29138":2208,"_20209":54502,"_5":13819,"_26493":54352,"_2816":54503},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3328":2268,"_29138":2208,"_20209":54505,"_5":13819,"_26493":54352,"_2816":54506},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3328":2269,"_29138":2208,"_20209":54508,"_5":13819,"_26493":54352,"_2816":54509},[],"**Key Name**: unique and descriptive name.",{"_3328":2270,"_29138":2208,"_20209":54511,"_5":13819,"_26493":54352,"_2816":54512},[],"**Crypto Engine**: engine that will keep the key.",{"_3328":2271,"_29138":2208,"_20209":54514,"_5":13819,"_26493":54352,"_2816":54515},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3328":2272,"_29138":2208,"_20209":54517,"_5":13819,"_26493":54352,"_2816":54518},[],"**Tags**: metadata to classify the key.",{"_3328":2273,"_29138":2208,"_20209":54520,"_5":13819,"_26493":54352,"_2816":54521},[],"**Metadata**: additional information for advanced uses.",{"_3328":2274,"_29138":2208,"_20209":54523,"_5":13819,"_26493":54356,"_2816":54524},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3328":2275,"_29138":2208,"_20209":54526,"_5":13819,"_26493":54356,"_2816":54527},[],"When you have an exportable private key and the destination engine supports import.",{"_3328":2276,"_29138":2208,"_20209":54529,"_5":13819,"_26493":54356,"_2816":54530},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3328":2277,"_29138":2208,"_20209":54532,"_5":13819,"_26493":54356,"_2816":54533},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3328":2278,"_29138":2208,"_20209":54535,"_5":13819,"_26493":54356,"_2816":54536},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3328":2279,"_29138":2208,"_20209":54538,"_5":13819,"_26493":54356,"_2816":54539},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3328":2280,"_29138":2208,"_20209":54541,"_5":13819,"_26493":54356,"_2816":54542},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3328":2281,"_29138":2208,"_20209":54544,"_5":13819,"_26493":54356,"_2816":54545},[],"**Tags**: labels for organization and search.",{"_3328":2282,"_29138":2208,"_20209":54547,"_5":13819,"_26493":54356,"_2816":54548},[],"**Metadata**: additional optional information.",{"_3328":2283,"_29138":2208,"_20209":54550,"_5":13819,"_26493":54356,"_2816":54551},[],"**Private Key (PEM)**: private key in PEM format.",{"_3328":2284,"_29138":2208,"_20209":54553,"_5":13819,"_26493":54356,"_2816":54554},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3328":2285,"_29138":2208,"_20209":54556,"_5":13819,"_26493":54360,"_2816":54557},[],"Each registered key has a detail view and several operational actions.",{"_3328":2286,"_29138":2208,"_20209":54559,"_5":13819,"_26493":54364,"_2816":54560},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3328":2287,"_29138":2208,"_20209":54562,"_5":13819,"_26493":54364,"_2816":54563},[],"The **Overview** tab shows, among others, these fields:",{"_3328":2288,"_29138":2208,"_20209":54565,"_5":13819,"_26493":54364,"_2816":54566},[],"**Key Name**: descriptive name.",{"_3328":2289,"_29138":2208,"_20209":54568,"_5":13819,"_26493":54364,"_2816":54569},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3328":2290,"_29138":2208,"_20209":54571,"_5":13819,"_26493":54364,"_2816":54572},[],"**Tags**: associated labels.",{"_3328":2291,"_29138":2208,"_20209":54574,"_5":13819,"_26493":54364,"_2816":54575},[],"**Aliases**: alternative names.",{"_3328":2292,"_29138":2208,"_20209":54577,"_5":13819,"_26493":54364,"_2816":54578},[],"**Crypto Engine**: engine where the key resides.",{"_3328":2293,"_29138":2208,"_20209":54580,"_5":13819,"_26493":54364,"_2816":54581},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3328":2294,"_29138":2208,"_20209":54583,"_5":13819,"_26493":54364,"_2816":54584},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3328":2295,"_29138":2208,"_20209":54586,"_5":13819,"_26493":54364,"_2816":54587},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3328":2296,"_29138":2208,"_20209":54589,"_5":13819,"_26493":54368,"_2816":54590},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3328":2297,"_29138":2208,"_20209":54592,"_5":13819,"_26493":54368,"_2816":54593},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3328":2298,"_29138":2208,"_20209":54595,"_5":13819,"_26493":54368,"_2816":54596},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3328":2299,"_29138":2208,"_20209":54598,"_5":13819,"_26493":54372,"_2816":54599},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3328":2300,"_29138":2208,"_20209":54601,"_5":13819,"_26493":54372,"_2816":54602},[],"Main fields:",{"_3328":2301,"_29138":2208,"_20209":54604,"_5":13819,"_26493":54372,"_2816":54605},[],"**Algorithm**: signing algorithm available for the key type.",{"_3328":2302,"_29138":2208,"_20209":54607,"_5":13819,"_26493":54372,"_2816":54608},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3328":2303,"_29138":2208,"_20209":54610,"_5":13819,"_26493":54372,"_2816":54611},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3328":2304,"_29138":2208,"_20209":54613,"_5":13819,"_26493":54372,"_2816":54614},[],"**Message**: content to sign.",{"_3328":2305,"_29138":2208,"_20209":54616,"_5":13819,"_26493":54372,"_2816":54617},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3328":2306,"_29138":2208,"_20209":54619,"_5":13819,"_26493":54376,"_2816":54620},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3328":2307,"_29138":2208,"_20209":54622,"_5":13819,"_26493":54376,"_2816":54602},[],{"_3328":2308,"_29138":2208,"_20209":54624,"_5":13819,"_26493":54376,"_2816":54625},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3328":2309,"_29138":2208,"_20209":54627,"_5":13819,"_26493":54376,"_2816":54628},[],"**Message Type**: `Raw` or `Digest`.",{"_3328":2310,"_29138":2208,"_20209":54630,"_5":13819,"_26493":54376,"_2816":54631},[],"**Payload Encoding**: encoding of the message.",{"_3328":2311,"_29138":2208,"_20209":54633,"_5":13819,"_26493":54376,"_2816":54634},[],"**Message**: original message or hash.",{"_3328":2312,"_29138":2208,"_20209":54636,"_5":13819,"_26493":54376,"_2816":54637},[],"**Signature**: signature to check.",{"_3328":2313,"_29138":2208,"_20209":54639,"_5":13819,"_26493":54376,"_2816":54640},[],"**Result**: indicator of the validation result.",{"_3328":2314,"_29138":2208,"_20209":54642,"_5":13819,"_26493":54380,"_2816":54643},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3328":2315,"_29138":2208,"_20209":54645,"_5":13819,"_26493":54380,"_2816":54646},[],"This flow is useful for:",{"_3328":2316,"_29138":2208,"_20209":54648,"_5":13819,"_26493":54380,"_2816":54649},[],"Requesting certificates from an external CA.",{"_3328":2317,"_29138":2208,"_20209":54651,"_5":13819,"_26493":54380,"_2816":54652},[],"Renewing an identity while keeping the same key.",{"_3328":2318,"_29138":2208,"_20209":54654,"_5":13819,"_26493":54380,"_2816":54655},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3328":2319,"_29138":2208,"_20209":54657,"_5":13819,"_26493":54380,"_2816":54658},[],"**Common Name (CN)**: main name of the identity.",{"_3328":2320,"_29138":2208,"_20209":54660,"_5":13819,"_26493":54380,"_2816":54661},[],"**Organization (O)**: organization or company.",{"_3328":2321,"_29138":2208,"_20209":54663,"_5":13819,"_26493":54380,"_2816":54664},[],"**Organizational Unit (OU)**: department or unit.",{"_3328":2322,"_29138":2208,"_20209":54666,"_5":13819,"_26493":54380,"_2816":54667},[],"**Country (C)**: two-letter country code.",{"_3328":2323,"_29138":2208,"_20209":54669,"_5":13819,"_26493":54380,"_2816":54670},[],"**State / Province (ST)**: state or province.",{"_3328":2324,"_29138":2208,"_20209":54672,"_5":13819,"_26493":54380,"_2816":54673},[],"**Locality (L)**: city or locality.",{"_3328":2325,"_29138":2208,"_20209":54675,"_5":13819,"_26493":54380,"_2816":54676},[],"**Email Address**: contact email.",{"_3328":2326,"_29138":2208,"_20209":54678,"_5":13819,"_26493":54380,"_2816":54679},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3328":2327,"_29138":2208,"_20209":54681,"_5":13819,"_26493":54380,"_2816":54682},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3328":2328,"_29138":2208,"_20209":54684,"_5":13819,"_26493":54384,"_2816":54685},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3328":2329,"_29138":2208,"_20209":54687,"_5":13819,"_26493":54384,"_2816":54688},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3328":2330,"_29138":2208,"_20209":54690,"_5":13819,"_26493":54388,"_2816":54691},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3328":2331,"_29138":2331,"_5":14177,"_2816":54693,"_29482":54694,"_20209":54695,"_26493":2331},"Online validation with OCSP",[47429,48897,52903,53530],[],{"_3328":2332,"_29138":2331,"_20209":54697,"_5":13819,"_26493":2331,"_2816":54698},[],"Query signed status and verify the responder’s response.",{"_3328":2333,"_29138":2331,"_5":29479,"_20209":54700,"_26493":54701,"_2816":54702},[],"/docs/pr-preview/pr-45/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3328":2334,"_29138":2331,"_5":29479,"_20209":54704,"_26493":54705,"_2816":54706},[],"/docs/pr-preview/pr-45/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3328":2335,"_29138":2331,"_5":29479,"_20209":54708,"_26493":54709,"_2816":54710},[],"/docs/pr-preview/pr-45/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3328":2336,"_29138":2331,"_5":29479,"_20209":54712,"_26493":54713,"_2816":54714},[],"/docs/pr-preview/pr-45/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3328":2337,"_29138":2331,"_5":29479,"_20209":54716,"_26493":54717,"_2816":54718},[],"/docs/pr-preview/pr-45/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3328":2338,"_29138":2331,"_5":29479,"_20209":54720,"_26493":54721,"_2816":54084},[],"/docs/pr-preview/pr-45/platform/pki/ocsp#references",{"_3328":2339,"_29138":2331,"_20209":54723,"_5":13819,"_26493":2331,"_2816":54724},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3328":2340,"_29138":2331,"_20209":54726,"_5":13819,"_26493":54701,"_2816":54727},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3328":2341,"_29138":2331,"_20209":54729,"_5":13819,"_26493":54701,"_2816":54730},[],"Record status",{"_3328":2342,"_29138":2331,"_20209":54732,"_5":13819,"_26493":54701,"_2816":54733},[],"Signed response",{"_3328":2343,"_29138":2331,"_20209":54735,"_5":13819,"_26493":54701,"_2816":52074},[],{"_3328":2344,"_29138":2331,"_20209":54737,"_5":13819,"_26493":54701,"_2816":54738},[],"`Good`.",{"_3328":2345,"_29138":2331,"_20209":54740,"_5":13819,"_26493":54701,"_2816":52091},[],{"_3328":2346,"_29138":2331,"_20209":54742,"_5":13819,"_26493":54701,"_2816":54743},[],"`Revoked`, with revocation reason and timestamp.",{"_3328":2347,"_29138":2331,"_20209":54745,"_5":13819,"_26493":54701,"_2816":54746},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3328":2348,"_29138":2331,"_20209":54748,"_5":13819,"_26493":54701,"_2816":54749},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3328":2349,"_29138":2331,"_20209":54751,"_5":13819,"_26493":54701,"_2816":54752},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3328":2350,"_29138":2331,"_20209":54754,"_5":13819,"_26493":54701,"_2816":54755},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3328":2351,"_29138":2331,"_20209":54757,"_5":13819,"_26493":54701,"_2816":54758},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3328":2352,"_29138":2331,"_20209":54760,"_5":13819,"_26493":54705,"_2816":54761},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3328":2353,"_29138":2331,"_20209":54763,"_5":13819,"_26493":54705,"_2816":54764},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3328":2354,"_29138":2331,"_20209":54766,"_5":13819,"_26493":54709,"_2816":54767},[],"The service accepts:",{"_3328":2355,"_29138":2331,"_20209":54769,"_5":13819,"_26493":54709,"_2816":50661},[],{"_3328":2356,"_29138":2331,"_20209":54771,"_5":13819,"_26493":54709,"_2816":54772},[],"VA service path",{"_3328":2357,"_29138":2331,"_20209":54774,"_5":13819,"_26493":54709,"_2816":54775},[],"Format",{"_3328":2358,"_29138":2331,"_20209":54777,"_5":13819,"_26493":54709,"_2816":54778},[],"`POST`",{"_3328":2359,"_29138":2331,"_20209":54780,"_5":13819,"_26493":54709,"_2816":54781},[],"`/ocsp`",{"_3328":2360,"_29138":2331,"_20209":54783,"_5":13819,"_26493":54709,"_2816":54784},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3328":2361,"_29138":2331,"_20209":54786,"_5":13819,"_26493":54709,"_2816":54210},[],{"_3328":2362,"_29138":2331,"_20209":54788,"_5":13819,"_26493":54709,"_2816":54789},[],"`/ocsp/{ocsp_request}`",{"_3328":2363,"_29138":2331,"_20209":54791,"_5":13819,"_26493":54709,"_2816":54792},[],"DER request encoded using padded URL Base64.",{"_3328":2364,"_29138":2331,"_20209":54794,"_5":13819,"_26493":54709,"_2816":54795},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3328":2365,"_29138":2331,"_20209":54797,"_5":13819,"_26493":54713,"_2816":54798},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3328":2366,"_29138":2331,"_20209":54800,"_5":13819,"_26493":54713,"_2816":54801},[],"Generate the request:",{"_3328":2367,"_29138":2331,"_20209":54803,"_5":13819,"_26493":54713,"_2816":54804},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3328":2368,"_29138":2331,"_20209":54806,"_5":13819,"_26493":54713,"_2816":54807},[],"Replace the example URL with the inspected endpoint:",{"_3328":2369,"_29138":2331,"_20209":54809,"_5":13819,"_26493":54713,"_2816":54810},[],"Verify the returned DER:",{"_3328":2370,"_29138":2331,"_20209":54812,"_5":13819,"_26493":54713,"_2816":54813},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3328":2371,"_29138":2331,"_20209":54815,"_5":13819,"_26493":54717,"_2816":54816},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3328":2372,"_29138":2331,"_20209":54818,"_5":13819,"_26493":54717,"_2816":54819},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3328":2373,"_29138":2331,"_20209":54821,"_5":13819,"_26493":54721,"_2816":54822},[],"RFC 6960: OCSP.",{"_3328":2374,"_29138":2331,"_20209":54824,"_5":13819,"_26493":54721,"_2816":54825},[],"OpenSSL: openssl-ocsp.",{"_3328":2375,"_29138":2331,"_20209":54827,"_5":13819,"_26493":54721,"_2816":54828},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3328":2376,"_29138":2331,"_20209":54830,"_5":13819,"_26493":54721,"_2816":54302},[],{"_3328":2377,"_29138":2377,"_5":14177,"_2816":52903,"_29482":54832,"_20209":54833,"_26493":2377},[47429,48897,52903],[],{"_3328":2378,"_29138":2377,"_20209":54835,"_5":13819,"_26493":2377,"_2816":54836},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3328":2379,"_29138":2377,"_5":29479,"_20209":54838,"_26493":54839,"_2816":52215},[],"/docs/pr-preview/pr-45/platform/pki/overview#start-here",{"_3328":2380,"_29138":2377,"_5":29479,"_20209":54841,"_26493":54842,"_2816":54843},[],"/docs/pr-preview/pr-45/platform/pki/overview#what-you-need","What you need",{"_3328":2381,"_29138":2377,"_5":29479,"_20209":54845,"_26493":54846,"_2816":52747},[],"/docs/pr-preview/pr-45/platform/pki/overview#core-capabilities",{"_3328":2382,"_29138":2377,"_5":29479,"_20209":54848,"_26493":54849,"_2816":52751},[],"/docs/pr-preview/pr-45/platform/pki/overview#build-your-trust-hierarchy",{"_3328":2383,"_29138":2377,"_5":29479,"_20209":54851,"_26493":54852,"_2816":52755},[],"/docs/pr-preview/pr-45/platform/pki/overview#protect-cryptographic-keys",{"_3328":2384,"_29138":2377,"_5":29479,"_20209":54854,"_26493":54855,"_2816":52759},[],"/docs/pr-preview/pr-45/platform/pki/overview#issue-and-control-certificates",{"_3328":2385,"_29138":2377,"_5":29479,"_20209":54857,"_26493":54858,"_2816":52767},[],"/docs/pr-preview/pr-45/platform/pki/overview#publish-validation-status",{"_3328":2386,"_29138":2377,"_5":29479,"_20209":54860,"_26493":54861,"_2816":54862},[],"/docs/pr-preview/pr-45/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3328":2387,"_29138":2377,"_5":29479,"_20209":54864,"_26493":54865,"_2816":53697},[],"/docs/pr-preview/pr-45/platform/pki/overview#continue",{"_3328":2388,"_29138":2377,"_20209":54867,"_5":13819,"_26493":2377,"_2816":54868},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3328":2389,"_29138":2377,"_20209":54870,"_5":13819,"_26493":54839,"_2816":54871},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3328":2390,"_29138":2377,"_20209":54873,"_5":13819,"_26493":54839,"_2816":54874},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3328":2391,"_29138":2377,"_20209":54876,"_5":13819,"_26493":54842,"_2816":54877},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3328":2392,"_29138":2377,"_20209":54879,"_5":13819,"_26493":54842,"_2816":54880},[],"An available cryptographic engine to keep the authority's key.",{"_3328":2393,"_29138":2377,"_20209":54882,"_5":13819,"_26493":54842,"_2816":54883},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3328":2394,"_29138":2377,"_20209":54885,"_5":13819,"_26493":54842,"_2816":54886},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3328":2395,"_29138":2377,"_20209":54888,"_5":13819,"_26493":54842,"_2816":54889},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3328":2396,"_29138":2377,"_20209":54891,"_5":13819,"_26493":54849,"_2816":54892},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3328":2397,"_29138":2377,"_20209":54894,"_5":13819,"_26493":54852,"_2816":54895},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3328":2398,"_29138":2377,"_20209":54897,"_5":13819,"_26493":54855,"_2816":54898},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3328":2399,"_29138":2377,"_20209":54900,"_5":13819,"_26493":54858,"_2816":54901},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3328":2400,"_29138":2377,"_20209":54903,"_5":13819,"_26493":54861,"_2816":54904},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3328":2401,"_29138":2377,"_20209":54906,"_5":13819,"_26493":54861,"_2816":54907},[],"its subject and extensions identify the expected client;",{"_3328":2402,"_29138":2377,"_20209":54909,"_5":13819,"_26493":54861,"_2816":54910},[],"its public key matches the client's private key;",{"_3328":2403,"_29138":2377,"_20209":54912,"_5":13819,"_26493":54861,"_2816":54913},[],"its chain reaches a root trusted by the consumer;",{"_3328":2404,"_29138":2377,"_20209":54915,"_5":13819,"_26493":54861,"_2816":54916},[],"its dates and usages allow the operation;",{"_3328":2405,"_29138":2377,"_20209":54918,"_5":13819,"_26493":54861,"_2816":54919},[],"the consumer applies revocation checks and authorization.",{"_3328":2406,"_29138":2377,"_20209":54921,"_5":13819,"_26493":54861,"_2816":54922},[],"The issuance path includes the first independent checks.",{"_3328":2407,"_29138":2377,"_20209":54924,"_5":13819,"_26493":54865,"_2816":54925},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3328":2408,"_29138":2377,"_20209":54927,"_5":13819,"_26493":54865,"_2816":54928},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3328":2409,"_29138":2377,"_20209":54930,"_5":13819,"_26493":54865,"_2816":54931},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3328":2410,"_29138":2410,"_5":14177,"_2816":54933,"_29482":54934,"_20209":54935,"_26493":2410},"Create your first CA",[47429,48897,52903,52340],[],{"_3328":2411,"_29138":2410,"_20209":54937,"_5":13819,"_26493":2410,"_2816":54938},[],"Create an evaluation root and check its certificate before issuing.",{"_3328":2412,"_29138":2410,"_5":29479,"_20209":54940,"_26493":54941,"_2816":47439},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3328":2413,"_29138":2410,"_5":29479,"_20209":54943,"_26493":54944,"_2816":54945},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3328":2414,"_29138":2410,"_5":29479,"_20209":54947,"_26493":54948,"_2816":54949},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3328":2415,"_29138":2410,"_5":29479,"_20209":54951,"_26493":54952,"_2816":54953},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3328":2416,"_29138":2410,"_5":29479,"_20209":54955,"_26493":54956,"_2816":54957},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3328":2417,"_29138":2410,"_5":29479,"_20209":54959,"_26493":54960,"_2816":54961},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3328":2418,"_29138":2410,"_5":29479,"_20209":54963,"_26493":54964,"_2816":54965},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3328":2419,"_29138":2410,"_5":29479,"_20209":54967,"_26493":54968,"_2816":52597},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3328":2420,"_29138":2410,"_5":29479,"_20209":54970,"_26493":54971,"_2816":47463},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3328":2421,"_29138":2410,"_20209":54973,"_5":13819,"_26493":2410,"_2816":54974},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3328":2422,"_29138":2410,"_20209":54976,"_5":13819,"_26493":54941,"_2816":54977},[],"Console access and permission to create keys and authorities.",{"_3328":2423,"_29138":2410,"_20209":54979,"_5":13819,"_26493":54941,"_2816":54980},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3328":2424,"_29138":2410,"_20209":54982,"_5":13819,"_26493":54941,"_2816":54983},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3328":2425,"_29138":2410,"_20209":54985,"_5":13819,"_26493":54941,"_2816":54986},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3328":2426,"_29138":2410,"_20209":54988,"_5":13819,"_26493":54944,"_2816":54989},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3328":2427,"_29138":2410,"_20209":54991,"_5":13819,"_26493":54944,"_2816":54992},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3328":2428,"_29138":2410,"_20209":54994,"_5":13819,"_26493":54948,"_2816":54995},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3328":2429,"_29138":2410,"_20209":54997,"_5":13819,"_26493":54948,"_2816":54998},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3328":2430,"_29138":2410,"_20209":55000,"_5":13819,"_26493":54952,"_2816":55001},[],"Select **Root CA** and complete:",{"_3328":2431,"_29138":2410,"_20209":55003,"_5":13819,"_26493":54952,"_2816":55004},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3328":2432,"_29138":2410,"_20209":55006,"_5":13819,"_26493":54952,"_2816":55007},[],"**Subject**: organization and country details for your evaluation.",{"_3328":2433,"_29138":2410,"_20209":55009,"_5":13819,"_26493":54952,"_2816":55010},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3328":2434,"_29138":2410,"_20209":55012,"_5":13819,"_26493":54952,"_2816":55013},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3328":2435,"_29138":2410,"_20209":55015,"_5":13819,"_26493":54952,"_2816":55016},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3328":2436,"_29138":2410,"_20209":55018,"_5":13819,"_26493":54956,"_2816":55019},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3328":2437,"_29138":2410,"_20209":55021,"_5":13819,"_26493":54960,"_2816":55022},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3328":2438,"_29138":2410,"_20209":55024,"_5":13819,"_26493":54960,"_2816":55025},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3328":2439,"_29138":2410,"_20209":55027,"_5":13819,"_26493":54964,"_2816":55028},[],"Run from the directory where you saved `ca.pem`:",{"_3328":2440,"_29138":2410,"_20209":55030,"_5":13819,"_26493":54964,"_2816":55031},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3328":2441,"_29138":2410,"_20209":55033,"_5":13819,"_26493":54964,"_2816":55034},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3328":2442,"_29138":2410,"_20209":55036,"_5":13819,"_26493":54968,"_2816":55037},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3328":2443,"_29138":2410,"_20209":55039,"_5":13819,"_26493":54968,"_2816":55040},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3328":2444,"_29138":2410,"_20209":55042,"_5":13819,"_26493":54968,"_2816":55043},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3328":2445,"_29138":2410,"_20209":55045,"_5":13819,"_26493":54968,"_2816":55046},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3328":2446,"_29138":2410,"_20209":55048,"_5":13819,"_26493":54971,"_2816":55049},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3328":2447,"_29138":2447,"_5":14177,"_2816":55051,"_29482":55052,"_20209":55053,"_26493":2447},"Issue and verify a certificate",[47429,48897,52903,52340],[],{"_3328":2448,"_29138":2447,"_20209":55055,"_5":13819,"_26493":2447,"_2816":55056},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3328":2449,"_29138":2447,"_5":29479,"_20209":55058,"_26493":55059,"_2816":47439},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3328":2450,"_29138":2447,"_5":29479,"_20209":55061,"_26493":55062,"_2816":55063},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3328":2451,"_29138":2447,"_5":29479,"_20209":55065,"_26493":55066,"_2816":55067},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3328":2452,"_29138":2447,"_5":29479,"_20209":55069,"_26493":55070,"_2816":55071},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3328":2453,"_29138":2447,"_5":29479,"_20209":55073,"_26493":55074,"_2816":55075},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3328":2454,"_29138":2447,"_5":29479,"_20209":55077,"_26493":55078,"_2816":55079},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3328":2455,"_29138":2447,"_5":29479,"_20209":55081,"_26493":55082,"_2816":55083},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3328":2456,"_29138":2447,"_5":29479,"_20209":55085,"_26493":55086,"_2816":55087},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3328":2457,"_29138":2447,"_5":29479,"_20209":55089,"_26493":55090,"_2816":55091},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3328":2458,"_29138":2447,"_5":29479,"_20209":55093,"_26493":55094,"_2816":55095},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3328":2459,"_29138":2447,"_5":29479,"_20209":55097,"_26493":55098,"_2816":52597},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3328":2460,"_29138":2447,"_5":29479,"_20209":55100,"_26493":55101,"_2816":47463},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/issue-certificate#next-step",{"_3328":2461,"_29138":2447,"_20209":55103,"_5":13819,"_26493":2447,"_2816":55104},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3328":2462,"_29138":2447,"_20209":55106,"_5":13819,"_26493":55059,"_2816":55107},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3328":2463,"_29138":2447,"_20209":55109,"_5":13819,"_26493":55059,"_2816":55110},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3328":2464,"_29138":2447,"_20209":55112,"_5":13819,"_26493":55059,"_2816":55113},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3328":2465,"_29138":2447,"_20209":55115,"_5":13819,"_26493":55059,"_2816":55116},[],"A client identifier: here we use `device-001`.",{"_3328":2466,"_29138":2447,"_20209":55118,"_5":13819,"_26493":55059,"_2816":55119},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3328":2467,"_29138":2447,"_20209":55121,"_5":13819,"_26493":55062,"_2816":55122},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3328":2468,"_29138":2447,"_20209":55124,"_5":13819,"_26493":55066,"_2816":55125},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3328":2469,"_29138":2447,"_20209":55127,"_5":13819,"_26493":55066,"_2816":55128},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3328":2470,"_29138":2447,"_20209":55130,"_5":13819,"_26493":55070,"_2816":55131},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3328":2471,"_29138":2447,"_20209":55133,"_5":13819,"_26493":55070,"_2816":55134},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3328":2472,"_29138":2447,"_20209":55136,"_5":13819,"_26493":55074,"_2816":55137},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3328":2473,"_29138":2447,"_20209":55139,"_5":13819,"_26493":55074,"_2816":55140},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3328":2474,"_29138":2447,"_20209":55142,"_5":13819,"_26493":55078,"_2816":55143},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3328":2475,"_29138":2447,"_20209":55145,"_5":13819,"_26493":55082,"_2816":55146},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3328":2476,"_29138":2447,"_20209":55148,"_5":13819,"_26493":55086,"_2816":55149},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3328":2477,"_29138":2447,"_20209":55151,"_5":13819,"_26493":55090,"_2816":55152},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3328":2478,"_29138":2447,"_20209":55154,"_5":13819,"_26493":55090,"_2816":55155},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3328":2479,"_29138":2447,"_20209":55157,"_5":13819,"_26493":55090,"_2816":55158},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3328":2480,"_29138":2447,"_20209":55160,"_5":13819,"_26493":55094,"_2816":55161},[],"In Bash, compare the two public-key digests:",{"_3328":2481,"_29138":2447,"_20209":55163,"_5":13819,"_26493":55094,"_2816":55164},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3328":2482,"_29138":2447,"_20209":55166,"_5":13819,"_26493":55094,"_2816":55167},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3328":2483,"_29138":2447,"_20209":55169,"_5":13819,"_26493":55098,"_2816":52681},[],{"_3328":2484,"_29138":2447,"_20209":55171,"_5":13819,"_26493":55098,"_2816":55172},[],"What to review",{"_3328":2485,"_29138":2447,"_20209":55174,"_5":13819,"_26493":55098,"_2816":55175},[],"The CA rejects issuance",{"_3328":2486,"_29138":2447,"_20209":55177,"_5":13819,"_26493":55098,"_2816":55178},[],"Permissions, CA state and key, algorithm and profile.",{"_3328":2487,"_29138":2447,"_20209":55180,"_5":13819,"_26493":55098,"_2816":55181},[],"Different subject or usages",{"_3328":2488,"_29138":2447,"_20209":55183,"_5":13819,"_26493":55098,"_2816":55184},[],"Applied profile and requested values.",{"_3328":2489,"_29138":2447,"_20209":55186,"_5":13819,"_26493":55098,"_2816":55187},[],"Issuer cannot be found",{"_3328":2490,"_29138":2447,"_20209":55189,"_5":13819,"_26493":55098,"_2816":55190},[],"Downloaded CA and required intermediate chain.",{"_3328":2491,"_29138":2447,"_20209":55192,"_5":13819,"_26493":55098,"_2816":55193},[],"Validity fails",{"_3328":2492,"_29138":2447,"_20209":55195,"_5":13819,"_26493":55098,"_2816":55196},[],"Certificate and CA dates, and the computer's clock.",{"_3328":2493,"_29138":2447,"_20209":55198,"_5":13819,"_26493":55098,"_2816":55199},[],"Public-key digests differ",{"_3328":2494,"_29138":2447,"_20209":55201,"_5":13819,"_26493":55098,"_2816":55202},[],"Certificate and key files from the same issuance.",{"_3328":2495,"_29138":2447,"_20209":55204,"_5":13819,"_26493":55098,"_2816":55205},[],"See PKI diagnostics to narrow an issuance failure.",{"_3328":2496,"_29138":2447,"_20209":55207,"_5":13819,"_26493":55101,"_2816":55208},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3328":2497,"_29138":2447,"_20209":55210,"_5":13819,"_26493":55101,"_2816":55211},[],"Manage certificates for inspection, status and revocation.",{"_3328":2498,"_29138":2447,"_20209":55213,"_5":13819,"_26493":55101,"_2816":55214},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3328":2499,"_29138":2447,"_20209":55216,"_5":13819,"_26493":55101,"_2816":55217},[],"Prepare EST for the device to request its next identities.",{"_3328":2500,"_29138":2447,"_20209":55219,"_5":13819,"_26493":55101,"_2816":55220},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3328":2501,"_29138":2501,"_5":14177,"_2816":55222,"_29482":55223,"_20209":55224,"_26493":2501},"PKI getting started",[47429,48897,52903,52340],[],{"_3328":2502,"_29138":2501,"_20209":55226,"_5":13819,"_26493":2501,"_2816":55227},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3328":2503,"_29138":2501,"_5":29479,"_20209":55229,"_26493":55230,"_2816":47439},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/overview#before-you-begin",{"_3328":2504,"_29138":2501,"_5":29479,"_20209":55232,"_26493":55233,"_2816":55234},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3328":2505,"_29138":2501,"_5":29479,"_20209":55236,"_26493":55237,"_2816":52532},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/overview#expected-result",{"_3328":2506,"_29138":2501,"_5":29479,"_20209":55239,"_26493":55240,"_2816":55241},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3328":2507,"_29138":2501,"_20209":55243,"_5":13819,"_26493":2501,"_2816":55244},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3328":2508,"_29138":2501,"_20209":55246,"_5":13819,"_26493":55230,"_2816":55247},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3328":2509,"_29138":2501,"_20209":55249,"_5":13819,"_26493":55230,"_2816":55250},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3328":2510,"_29138":2501,"_20209":55252,"_5":13819,"_26493":55230,"_2816":55253},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3328":2511,"_29138":2501,"_20209":55255,"_5":13819,"_26493":55230,"_2816":55256},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3328":2512,"_29138":2501,"_20209":55258,"_5":13819,"_26493":55230,"_2816":55259},[],"A working directory with restricted access for the downloaded key.",{"_3328":2513,"_29138":2501,"_20209":55261,"_5":13819,"_26493":55233,"_2816":55262},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3328":2514,"_29138":2501,"_20209":55264,"_5":13819,"_26493":55233,"_2816":55265},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3328":2515,"_29138":2501,"_20209":55267,"_5":13819,"_26493":55233,"_2816":55268},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3328":2516,"_29138":2501,"_20209":55270,"_5":13819,"_26493":55233,"_2816":55271},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3328":2517,"_29138":2501,"_20209":55273,"_5":13819,"_26493":55237,"_2816":55274},[],"File or resource",{"_3328":2518,"_29138":2501,"_20209":55276,"_5":13819,"_26493":55237,"_2816":52529},[],{"_3328":2519,"_29138":2501,"_20209":55278,"_5":13819,"_26493":55237,"_2816":55279},[],"Active root CA and `ca.pem`",{"_3328":2520,"_29138":2501,"_20209":55281,"_5":13819,"_26493":55237,"_2816":55282},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3328":2521,"_29138":2501,"_20209":55284,"_5":13819,"_26493":55237,"_2816":55285},[],"End-entity certificate and `device.crt`",{"_3328":2522,"_29138":2501,"_20209":55287,"_5":13819,"_26493":55237,"_2816":55288},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3328":2523,"_29138":2501,"_20209":55290,"_5":13819,"_26493":55237,"_2816":55291},[],"Private key `device.key`",{"_3328":2524,"_29138":2501,"_20209":55293,"_5":13819,"_26493":55237,"_2816":55294},[],"Its public key matches the one included in `device.crt`.",{"_3328":2525,"_29138":2501,"_20209":55296,"_5":13819,"_26493":55237,"_2816":55297},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3328":2526,"_29138":2501,"_20209":55299,"_5":13819,"_26493":55240,"_2816":55300},[],"To operate certificates, continue with Certificates and Validation.",{"_3328":2527,"_29138":2501,"_20209":55302,"_5":13819,"_26493":55240,"_2816":55303},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3328":2528,"_29138":2501,"_20209":55305,"_5":13819,"_26493":55240,"_2816":55306},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3328":2529,"_29138":2529,"_5":14177,"_2816":55308,"_29482":55309,"_20209":55310,"_26493":2529},"PKI troubleshooting",[47429,48897,52903,51475],[],{"_3328":2530,"_29138":2529,"_20209":55312,"_5":13819,"_26493":2529,"_2816":55313},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3328":2531,"_29138":2529,"_5":29479,"_20209":55315,"_26493":55316,"_2816":55317},[],"/docs/pr-preview/pr-45/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3328":2532,"_29138":2529,"_5":29479,"_20209":55319,"_26493":55320,"_2816":55321},[],"/docs/pr-preview/pr-45/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3328":2533,"_29138":2529,"_5":29479,"_20209":55323,"_26493":55324,"_2816":55325},[],"/docs/pr-preview/pr-45/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3328":2534,"_29138":2529,"_20209":55327,"_5":13819,"_26493":2529,"_2816":55328},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3328":2535,"_29138":2529,"_20209":55330,"_5":13819,"_26493":2529,"_2816":55331},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3328":2536,"_29138":2529,"_20209":55333,"_5":13819,"_26493":55316,"_2816":52529},[],{"_3328":2537,"_29138":2529,"_20209":55335,"_5":13819,"_26493":55316,"_2816":55336},[],"What to inspect",{"_3328":2538,"_29138":2529,"_20209":55338,"_5":13819,"_26493":55316,"_2816":47463},[],{"_3328":2539,"_29138":2529,"_20209":55340,"_5":13819,"_26493":55316,"_2816":51742},[],{"_3328":2540,"_29138":2529,"_20209":55342,"_5":13819,"_26493":55316,"_2816":55343},[],"Exists, is active and has usable dates.",{"_3328":2541,"_29138":2529,"_20209":55345,"_5":13819,"_26493":55316,"_2816":55346},[],"Authorities.",{"_3328":2542,"_29138":2529,"_20209":55348,"_5":13819,"_26493":55316,"_2816":55349},[],"Key",{"_3328":2543,"_29138":2529,"_20209":55351,"_5":13819,"_26493":55316,"_2816":55352},[],"The record has a usable private key and the engine can sign.",{"_3328":2544,"_29138":2529,"_20209":55354,"_5":13819,"_26493":55316,"_2816":55355},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3328":2545,"_29138":2529,"_20209":55357,"_5":13819,"_26493":55316,"_2816":55358},[],"CSR",{"_3328":2546,"_29138":2529,"_20209":55360,"_5":13819,"_26493":55316,"_2816":55361},[],"Correct PEM and verifiable signature.",{"_3328":2547,"_29138":2529,"_20209":55363,"_5":13819,"_26493":55316,"_2816":55364},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3328":2548,"_29138":2529,"_20209":55366,"_5":13819,"_26493":55316,"_2816":55367},[],"Profile",{"_3328":2549,"_29138":2529,"_20209":55369,"_5":13819,"_26493":55316,"_2816":55370},[],"Selected source, existing ID, allowed algorithm and size.",{"_3328":2550,"_29138":2529,"_20209":55372,"_5":13819,"_26493":55316,"_2816":55373},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3328":2551,"_29138":2529,"_20209":55375,"_5":13819,"_26493":55316,"_2816":52681},[],{"_3328":2552,"_29138":2529,"_20209":55377,"_5":13819,"_26493":55316,"_2816":55378},[],"Appropriate subject, SAN, usages and dates.",{"_3328":2553,"_29138":2529,"_20209":55380,"_5":13819,"_26493":55316,"_2816":55381},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3328":2554,"_29138":2529,"_20209":55383,"_5":13819,"_26493":55316,"_2816":55384},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3328":2555,"_29138":2529,"_20209":55386,"_5":13819,"_26493":55316,"_2816":55387},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3328":2556,"_29138":2529,"_20209":55389,"_5":13819,"_26493":55320,"_2816":55390},[],"Check each boundary independently:",{"_3328":2557,"_29138":2529,"_20209":55392,"_5":13819,"_26493":55320,"_2816":55393},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3328":2558,"_29138":2529,"_20209":55395,"_5":13819,"_26493":55320,"_2816":55396},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3328":2559,"_29138":2529,"_20209":55398,"_5":13819,"_26493":55320,"_2816":55399},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3328":2560,"_29138":2529,"_20209":55401,"_5":13819,"_26493":55320,"_2816":55402},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3328":2561,"_29138":2529,"_20209":55404,"_5":13819,"_26493":55320,"_2816":55405},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3328":2562,"_29138":2529,"_20209":55407,"_5":13819,"_26493":55320,"_2816":55408},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3328":2563,"_29138":2529,"_20209":55410,"_5":13819,"_26493":55324,"_2816":55411},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3328":2564,"_29138":2529,"_20209":55413,"_5":13819,"_26493":55324,"_2816":55414},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3328":2565,"_29138":2565,"_5":14177,"_2816":55416,"_29482":55417,"_20209":55419,"_26493":2565},"3.8.0 to 4.0.0",[47429,55418],"Upgrades",[],{"_3328":2566,"_29138":2565,"_20209":55421,"_5":13819,"_26493":2565,"_2816":55422},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3328":2567,"_29138":2565,"_5":29479,"_20209":55424,"_26493":55425,"_2816":55426},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3328":2568,"_29138":2565,"_5":29479,"_20209":55428,"_26493":55429,"_2816":55430},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3328":2569,"_29138":2565,"_5":29479,"_20209":55432,"_26493":55433,"_2816":55434},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3328":2570,"_29138":2565,"_5":29479,"_20209":55436,"_26493":55437,"_2816":55438},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3328":2571,"_29138":2565,"_5":29479,"_20209":55440,"_26493":55441,"_2816":55442},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3328":2572,"_29138":2565,"_5":29479,"_20209":55444,"_26493":55445,"_2816":55446},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3328":2573,"_29138":2565,"_5":29479,"_20209":55448,"_26493":55449,"_2816":55450},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3328":2574,"_29138":2565,"_5":29479,"_20209":55452,"_26493":55453,"_2816":55454},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3328":2575,"_29138":2565,"_5":29479,"_20209":55456,"_26493":55457,"_2816":55458},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3328":2576,"_29138":2565,"_5":29479,"_20209":55460,"_26493":55461,"_2816":55462},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3328":2577,"_29138":2565,"_5":29479,"_20209":55464,"_26493":55465,"_2816":55466},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3328":2578,"_29138":2565,"_5":29479,"_20209":55468,"_26493":55469,"_2816":55470},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3328":2579,"_29138":2565,"_5":29479,"_20209":55472,"_26493":55473,"_2816":55474},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3328":2580,"_29138":2565,"_5":29479,"_20209":55476,"_26493":55477,"_2816":55478},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3328":2581,"_29138":2565,"_5":29479,"_20209":55480,"_26493":55481,"_2816":55482},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3328":2582,"_29138":2565,"_5":29479,"_20209":55484,"_26493":55485,"_2816":55486},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3328":2583,"_29138":2565,"_5":29479,"_20209":55488,"_26493":55489,"_2816":55490},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3328":2584,"_29138":2565,"_5":29479,"_20209":55492,"_26493":55493,"_2816":55494},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3328":2585,"_29138":2565,"_5":29479,"_20209":55496,"_26493":55497,"_2816":55498},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3328":2586,"_29138":2565,"_5":29479,"_20209":55500,"_26493":55501,"_2816":55502},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3328":2587,"_29138":2565,"_5":29479,"_20209":55504,"_26493":55505,"_2816":55506},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3328":2588,"_29138":2565,"_5":29479,"_20209":55508,"_26493":55509,"_2816":55510},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3328":2589,"_29138":2565,"_5":29479,"_20209":55512,"_26493":55513,"_2816":55514},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3328":2590,"_29138":2565,"_5":29479,"_20209":55516,"_26493":55517,"_2816":55518},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3328":2591,"_29138":2565,"_5":29479,"_20209":55520,"_26493":55521,"_2816":55522},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3328":2592,"_29138":2565,"_5":29479,"_20209":55524,"_26493":55525,"_2816":55526},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3328":2593,"_29138":2565,"_5":29479,"_20209":55528,"_26493":55529,"_2816":55530},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3328":2594,"_29138":2565,"_5":29479,"_20209":55532,"_26493":55533,"_2816":55534},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3328":2595,"_29138":2565,"_5":29479,"_20209":55536,"_26493":55537,"_2816":55538},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3328":2596,"_29138":2565,"_5":29479,"_20209":55540,"_26493":55541,"_2816":55542},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3328":2597,"_29138":2565,"_5":29479,"_20209":55544,"_26493":55545,"_2816":55546},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3328":2598,"_29138":2565,"_5":29479,"_20209":55548,"_26493":55549,"_2816":55550},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3328":2599,"_29138":2565,"_5":29479,"_20209":55552,"_26493":55553,"_2816":55554},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3328":2600,"_29138":2565,"_5":29479,"_20209":55556,"_26493":55557,"_2816":51475},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3328":2601,"_29138":2565,"_5":29479,"_20209":55559,"_26493":55560,"_2816":55561},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3328":2602,"_29138":2565,"_5":29479,"_20209":55563,"_26493":55564,"_2816":55565},[],"/docs/pr-preview/pr-45/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3328":2603,"_29138":2565,"_20209":55567,"_5":13819,"_26493":2565,"_2816":55568},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3328":2604,"_29138":2565,"_20209":55570,"_5":13819,"_26493":2565,"_2816":55571},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3328":2605,"_29138":2565,"_20209":55573,"_5":13819,"_26493":2565,"_2816":55574},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3328":2606,"_29138":2565,"_20209":55576,"_5":13819,"_26493":2565,"_2816":55577},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3328":2607,"_29138":2565,"_20209":55579,"_5":13819,"_26493":2565,"_2816":55580},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3328":2608,"_29138":2565,"_20209":55582,"_5":13819,"_26493":2565,"_2816":55583},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3328":2609,"_29138":2565,"_20209":55585,"_5":13819,"_26493":2565,"_2816":55586},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3328":2610,"_29138":2565,"_20209":55588,"_5":13819,"_26493":55429,"_2816":55589},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3328":2611,"_29138":2565,"_20209":55591,"_5":13819,"_26493":55429,"_2816":55592},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3328":2612,"_29138":2565,"_20209":55594,"_5":13819,"_26493":55433,"_2816":55595},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3328":2613,"_29138":2565,"_20209":55597,"_5":13819,"_26493":55433,"_2816":55598},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3328":2614,"_29138":2565,"_20209":55600,"_5":13819,"_26493":55437,"_2816":55601},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3328":2615,"_29138":2565,"_20209":55603,"_5":13819,"_26493":55441,"_2816":55604},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3328":2616,"_29138":2565,"_20209":55606,"_5":13819,"_26493":55441,"_2816":55607},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3328":2617,"_29138":2565,"_20209":55609,"_5":13819,"_26493":55441,"_2816":55610},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3328":2618,"_29138":2565,"_20209":55612,"_5":13819,"_26493":55441,"_2816":55613},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3328":2619,"_29138":2565,"_20209":55615,"_5":13819,"_26493":55441,"_2816":55616},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3328":2620,"_29138":2565,"_20209":55618,"_5":13819,"_26493":55445,"_2816":55619},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3328":2621,"_29138":2565,"_20209":55621,"_5":13819,"_26493":55445,"_2816":55622},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3328":2622,"_29138":2565,"_20209":55624,"_5":13819,"_26493":55445,"_2816":55625},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3328":2623,"_29138":2565,"_20209":55627,"_5":13819,"_26493":55445,"_2816":55628},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3328":2624,"_29138":2565,"_20209":55630,"_5":13819,"_26493":55445,"_2816":55631},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3328":2625,"_29138":2565,"_20209":55633,"_5":13819,"_26493":55449,"_2816":55634},[],"Change",{"_3328":2626,"_29138":2565,"_20209":55636,"_5":13819,"_26493":55449,"_2816":55637},[],"Who is affected",{"_3328":2627,"_29138":2565,"_20209":55639,"_5":13819,"_26493":55449,"_2816":55640},[],"Severity",{"_3328":2628,"_29138":2565,"_20209":55642,"_5":13819,"_26493":55449,"_2816":54239},[],{"_3328":2629,"_29138":2565,"_20209":55644,"_5":13819,"_26493":55449,"_2816":55458},[],{"_3328":2630,"_29138":2565,"_20209":55646,"_5":13819,"_26493":55449,"_2816":55647},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3328":2631,"_29138":2565,"_20209":55649,"_5":13819,"_26493":55449,"_2816":55650},[],"High: KMS and VA start on empty volumes",{"_3328":2632,"_29138":2565,"_20209":55652,"_5":13819,"_26493":55449,"_2816":55653},[],"Copy the data into the new volumes",{"_3328":2633,"_29138":2565,"_20209":55655,"_5":13819,"_26493":55449,"_2816":55462},[],{"_3328":2634,"_29138":2565,"_20209":55657,"_5":13819,"_26493":55449,"_2816":55658},[],"Every Helm release",{"_3328":2635,"_29138":2565,"_20209":55660,"_5":13819,"_26493":55449,"_2816":55661},[],"High: `helm upgrade` fails",{"_3328":2636,"_29138":2565,"_20209":55663,"_5":13819,"_26493":55449,"_2816":55664},[],"Remove or rename legacy keys",{"_3328":2637,"_29138":2565,"_20209":55666,"_5":13819,"_26493":55449,"_2816":55466},[],{"_3328":2638,"_29138":2565,"_20209":55668,"_5":13819,"_26493":55449,"_2816":55669},[],"Every deployment",{"_3328":2639,"_29138":2565,"_20209":55671,"_5":13819,"_26493":55449,"_2816":55672},[],"High: without a bootstrap principal there is no administrator",{"_3328":2640,"_29138":2565,"_20209":55674,"_5":13819,"_26493":55449,"_2816":55675},[],"Configure `services.authz`",{"_3328":2641,"_29138":2565,"_20209":55677,"_5":13819,"_26493":55449,"_2816":55470},[],{"_3328":2642,"_29138":2565,"_20209":55679,"_5":13819,"_26493":55449,"_2816":55658},[],{"_3328":2643,"_29138":2565,"_20209":55681,"_5":13819,"_26493":55449,"_2816":55682},[],"High: `helm upgrade` fails on the old keys",{"_3328":2644,"_29138":2565,"_20209":55684,"_5":13819,"_26493":55449,"_2816":55685},[],"Move JWKS and roles into `services.authz`",{"_3328":2645,"_29138":2565,"_20209":55687,"_5":13819,"_26493":55449,"_2816":55490},[],{"_3328":2646,"_29138":2565,"_20209":55689,"_5":13819,"_26493":55449,"_2816":55690},[],"3.8.0 deployments with per-service databases",{"_3328":2647,"_29138":2565,"_20209":55692,"_5":13819,"_26493":55449,"_2816":55693},[],"High: services find no data, or a migration aborts",{"_3328":2648,"_29138":2565,"_20209":55695,"_5":13819,"_26493":55449,"_2816":55696},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3328":2649,"_29138":2565,"_20209":55698,"_5":13819,"_26493":55449,"_2816":55494},[],{"_3328":2650,"_29138":2565,"_20209":55700,"_5":13819,"_26493":55449,"_2816":55701},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3328":2651,"_29138":2565,"_20209":55703,"_5":13819,"_26493":55449,"_2816":55704},[],"High: the backend no longer starts with them",{"_3328":2652,"_29138":2565,"_20209":55706,"_5":13819,"_26493":55449,"_2816":55707},[],"Move to PostgreSQL before upgrading",{"_3328":2653,"_29138":2565,"_20209":55709,"_5":13819,"_26493":55449,"_2816":55710},[],"Webhooks with file references",{"_3328":2654,"_29138":2565,"_20209":55712,"_5":13819,"_26493":55449,"_2816":55713},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3328":2655,"_29138":2565,"_20209":55715,"_5":13819,"_26493":55449,"_2816":55716},[],"High: enrollments calling the webhook fail",{"_3328":2656,"_29138":2565,"_20209":55718,"_5":13819,"_26493":55449,"_2816":55719},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3328":2657,"_29138":2565,"_20209":55721,"_5":13819,"_26493":55449,"_2816":55474},[],{"_3328":2658,"_29138":2565,"_20209":55723,"_5":13819,"_26493":55449,"_2816":55724},[],"Releases with per-service identity overrides or mounted key material",{"_3328":2659,"_29138":2565,"_20209":55726,"_5":13819,"_26493":55449,"_2816":55727},[],"Medium: services cannot read their files",{"_3328":2660,"_29138":2565,"_20209":55729,"_5":13819,"_26493":55449,"_2816":55730},[],"Remove the overrides and fix volume ownership",{"_3328":2661,"_29138":2565,"_20209":55732,"_5":13819,"_26493":55449,"_2816":55478},[],{"_3328":2662,"_29138":2565,"_20209":55734,"_5":13819,"_26493":55449,"_2816":55735},[],"Releases that set `amqp.tls`",{"_3328":2663,"_29138":2565,"_20209":55737,"_5":13819,"_26493":55449,"_2816":55738},[],"Medium: clients connect to the wrong port",{"_3328":2664,"_29138":2565,"_20209":55740,"_5":13819,"_26493":55449,"_2816":55741},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3328":2665,"_29138":2565,"_20209":55743,"_5":13819,"_26493":55449,"_2816":55498},[],{"_3328":2666,"_29138":2565,"_20209":55745,"_5":13819,"_26493":55449,"_2816":55746},[],"Installations whose CA keys predate the KMS",{"_3328":2667,"_29138":2565,"_20209":55748,"_5":13819,"_26493":55449,"_2816":55749},[],"Medium: CA keys stay unmanaged",{"_3328":2668,"_29138":2565,"_20209":55751,"_5":13819,"_26493":55449,"_2816":55752},[],"Run the CA-to-KMS migration",{"_3328":2669,"_29138":2565,"_20209":55754,"_5":13819,"_26493":55449,"_2816":55755},[],"Receiver certificate verification",{"_3328":2670,"_29138":2565,"_20209":55757,"_5":13819,"_26493":55449,"_2816":55758},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3328":2671,"_29138":2565,"_20209":55760,"_5":13819,"_26493":55449,"_2816":55761},[],"Medium: credentials go to an unverified receiver",{"_3328":2672,"_29138":2565,"_20209":55763,"_5":13819,"_26493":55449,"_2816":55764},[],"Set `insecure_skip_verify` to `false`",{"_3328":2673,"_29138":2565,"_20209":55766,"_5":13819,"_26493":55449,"_2816":55510},[],{"_3328":2674,"_29138":2565,"_20209":55768,"_5":13819,"_26493":55449,"_2816":55769},[],"Scripts and consoles that edit DMSs through the API",{"_3328":2675,"_29138":2565,"_20209":55771,"_5":13819,"_26493":55449,"_2816":55772},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3328":2676,"_29138":2565,"_20209":55774,"_5":13819,"_26493":55449,"_2816":55775},[],"Read the DMS before editing and use the new field",{"_3328":2677,"_29138":2565,"_20209":55777,"_5":13819,"_26493":55449,"_2816":55526},[],{"_3328":2678,"_29138":2565,"_20209":55779,"_5":13819,"_26493":55449,"_2816":55780},[],"Consumers that read the device `events` field",{"_3328":2679,"_29138":2565,"_20209":55782,"_5":13819,"_26493":55449,"_2816":55783},[],"Medium: the field disappears",{"_3328":2680,"_29138":2565,"_20209":55785,"_5":13819,"_26493":55449,"_2816":55786},[],"Use the new event endpoints",{"_3328":2681,"_29138":2565,"_20209":55788,"_5":13819,"_26493":55449,"_2816":55482},[],{"_3328":2682,"_29138":2565,"_20209":55790,"_5":13819,"_26493":55449,"_2816":55791},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3328":2683,"_29138":2565,"_20209":55793,"_5":13819,"_26493":55449,"_2816":55794},[],"Low to medium: validation errors or changed defaults",{"_3328":2684,"_29138":2565,"_20209":55796,"_5":13819,"_26493":55449,"_2816":55797},[],"Update the values file",{"_3328":2685,"_29138":2565,"_20209":55799,"_5":13819,"_26493":55449,"_2816":55518},[],{"_3328":2686,"_29138":2565,"_20209":55801,"_5":13819,"_26493":55449,"_2816":55802},[],"Clients that send the DMS ID in the update body",{"_3328":2687,"_29138":2565,"_20209":55804,"_5":13819,"_26493":55449,"_2816":55805},[],"Low: the ID in the URL wins",{"_3328":2688,"_29138":2565,"_20209":55807,"_5":13819,"_26493":55449,"_2816":55808},[],"Send the ID in the URL",{"_3328":2689,"_29138":2565,"_20209":55810,"_5":13819,"_26493":55449,"_2816":55522},[],{"_3328":2690,"_29138":2565,"_20209":55812,"_5":13819,"_26493":55449,"_2816":55813},[],"Consumers that match on certificate `type`",{"_3328":2691,"_29138":2565,"_20209":55815,"_5":13819,"_26493":55449,"_2816":55816},[],"Low: two values are renamed",{"_3328":2692,"_29138":2565,"_20209":55818,"_5":13819,"_26493":55449,"_2816":55819},[],"Adapt consumers",{"_3328":2693,"_29138":2565,"_20209":55821,"_5":13819,"_26493":55449,"_2816":55514},[],{"_3328":2694,"_29138":2565,"_20209":55823,"_5":13819,"_26493":55449,"_2816":55824},[],"Any DMS",{"_3328":2695,"_29138":2565,"_20209":55826,"_5":13819,"_26493":55449,"_2816":55827},[],"Low: informational",{"_3328":2696,"_29138":2565,"_20209":55829,"_5":13819,"_26493":55449,"_2816":55830},[],"Read both blocks before editing",{"_3328":2697,"_29138":2565,"_20209":55832,"_5":13819,"_26493":55457,"_2816":55833},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3328":2698,"_29138":2565,"_20209":55835,"_5":13819,"_26493":55457,"_2816":55836},[],"Step 4 of the migration guide copies the data.",{"_3328":2699,"_29138":2565,"_20209":55838,"_5":13819,"_26493":55461,"_2816":55839},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3328":2700,"_29138":2565,"_20209":55841,"_5":13819,"_26493":55465,"_2816":55842},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3328":2701,"_29138":2565,"_20209":55844,"_5":13819,"_26493":55469,"_2816":55845},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3328":2702,"_29138":2565,"_20209":55847,"_5":13819,"_26493":55473,"_2816":55848},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3328":2703,"_29138":2565,"_20209":55850,"_5":13819,"_26493":55473,"_2816":55851},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3328":2704,"_29138":2565,"_20209":55853,"_5":13819,"_26493":55477,"_2816":55854},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3328":2705,"_29138":2565,"_20209":55856,"_5":13819,"_26493":55481,"_2816":55857},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3328":2706,"_29138":2565,"_20209":55859,"_5":13819,"_26493":55481,"_2816":55860},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3328":2707,"_29138":2565,"_20209":55862,"_5":13819,"_26493":55481,"_2816":55863},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3328":2708,"_29138":2565,"_20209":55865,"_5":13819,"_26493":55481,"_2816":55866},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3328":2709,"_29138":2565,"_20209":55868,"_5":13819,"_26493":55481,"_2816":55869},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3328":2710,"_29138":2565,"_20209":55871,"_5":13819,"_26493":55481,"_2816":55872},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3328":2711,"_29138":2565,"_20209":55874,"_5":13819,"_26493":55489,"_2816":55875},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3328":2712,"_29138":2565,"_20209":55877,"_5":13819,"_26493":55489,"_2816":55878},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3328":2713,"_29138":2565,"_20209":55880,"_5":13819,"_26493":55489,"_2816":55881},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3328":2714,"_29138":2565,"_20209":55883,"_5":13819,"_26493":55489,"_2816":55884},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3328":2715,"_29138":2565,"_20209":55886,"_5":13819,"_26493":55489,"_2816":55887},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3328":2716,"_29138":2565,"_20209":55889,"_5":13819,"_26493":55493,"_2816":55890},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3328":2717,"_29138":2565,"_20209":55892,"_5":13819,"_26493":55497,"_2816":55893},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3328":2718,"_29138":2565,"_20209":55895,"_5":13819,"_26493":55497,"_2816":55896},[],"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_3328":2719,"_29138":2565,"_20209":55898,"_5":13819,"_26493":55497,"_2816":55899},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3328":2720,"_29138":2565,"_20209":55901,"_5":13819,"_26493":55497,"_2816":55902},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3328":2721,"_29138":2565,"_20209":55904,"_5":13819,"_26493":55497,"_2816":55905},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3328":2722,"_29138":2565,"_20209":55907,"_5":13819,"_26493":55497,"_2816":55908},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3328":2723,"_29138":2565,"_20209":55910,"_5":13819,"_26493":55505,"_2816":55911},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3328":2724,"_29138":2565,"_20209":55913,"_5":13819,"_26493":55505,"_2816":55914},[],"Field in 3.8.0",{"_3328":2725,"_29138":2565,"_20209":55916,"_5":13819,"_26493":55505,"_2816":55917},[],"Field in 4.0.0",{"_3328":2726,"_29138":2565,"_20209":55919,"_5":13819,"_26493":55505,"_2816":55920},[],"`validate_server_cert`",{"_3328":2727,"_29138":2565,"_20209":55922,"_5":13819,"_26493":55505,"_2816":55923},[],"`insecure_skip_verify` (value negated)",{"_3328":2728,"_29138":2565,"_20209":55925,"_5":13819,"_26493":55505,"_2816":55926},[],"`oidc`",{"_3328":2729,"_29138":2565,"_20209":55928,"_5":13819,"_26493":55505,"_2816":55929},[],"`jwt_options`",{"_3328":2730,"_29138":2565,"_20209":55931,"_5":13819,"_26493":55505,"_2816":55932},[],"`apikey`",{"_3328":2731,"_29138":2565,"_20209":55934,"_5":13819,"_26493":55505,"_2816":55935},[],"`apikey_options`",{"_3328":2732,"_29138":2565,"_20209":55937,"_5":13819,"_26493":55505,"_2816":55938},[],"`mtls`",{"_3328":2733,"_29138":2565,"_20209":55940,"_5":13819,"_26493":55505,"_2816":55941},[],"`mtls_options`",{"_3328":2734,"_29138":2565,"_20209":55943,"_5":13819,"_26493":55505,"_2816":55944},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3328":2735,"_29138":2565,"_20209":55946,"_5":13819,"_26493":55505,"_2816":55947},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3328":2736,"_29138":2565,"_20209":55949,"_5":13819,"_26493":55505,"_2816":55950},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3328":2737,"_29138":2565,"_20209":55952,"_5":13819,"_26493":55509,"_2816":55953},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3328":2738,"_29138":2565,"_20209":55955,"_5":13819,"_26493":55509,"_2816":55956},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3328":2739,"_29138":2565,"_20209":55958,"_5":13819,"_26493":55509,"_2816":55959},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3328":2740,"_29138":2565,"_20209":55961,"_5":13819,"_26493":55513,"_2816":55962},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3328":2741,"_29138":2565,"_20209":55964,"_5":13819,"_26493":55517,"_2816":55965},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3328":2742,"_29138":2565,"_20209":55967,"_5":13819,"_26493":55521,"_2816":55968},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3328":2743,"_29138":2565,"_20209":55970,"_5":13819,"_26493":55525,"_2816":55971},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3328":2744,"_29138":2565,"_20209":55973,"_5":13819,"_26493":55525,"_2816":55974},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3328":2745,"_29138":2565,"_20209":55976,"_5":13819,"_26493":55525,"_2816":55977},[],"`POST /v1/devices/:id/events` creates an event.",{"_3328":2746,"_29138":2565,"_20209":55979,"_5":13819,"_26493":55525,"_2816":55980},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3328":2747,"_29138":2565,"_20209":55982,"_5":13819,"_26493":55529,"_2816":55983},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3328":2748,"_29138":2565,"_20209":55985,"_5":13819,"_26493":55533,"_2816":55986},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_3328":2749,"_29138":2565,"_20209":55988,"_5":13819,"_26493":55533,"_2816":55989},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3328":2750,"_29138":2565,"_20209":55991,"_5":13819,"_26493":55533,"_2816":55992},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3328":2751,"_29138":2565,"_20209":55994,"_5":13819,"_26493":55533,"_2816":55995},[],"Record the names of your local-storage PVCs:",{"_3328":2752,"_29138":2565,"_20209":55997,"_5":13819,"_26493":55533,"_2816":55998},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3328":2753,"_29138":2565,"_20209":56000,"_5":13819,"_26493":55537,"_2816":56001},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3328":2754,"_29138":2565,"_20209":56003,"_5":13819,"_26493":55537,"_2816":56004},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3328":2755,"_29138":2565,"_20209":56006,"_5":13819,"_26493":55537,"_2816":56007},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3328":2756,"_29138":2565,"_20209":56009,"_5":13819,"_26493":55537,"_2816":56010},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3328":2757,"_29138":2565,"_20209":56012,"_5":13819,"_26493":55537,"_2816":56013},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3328":2758,"_29138":2565,"_20209":56015,"_5":13819,"_26493":55537,"_2816":56016},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3328":2759,"_29138":2565,"_20209":56018,"_5":13819,"_26493":55537,"_2816":56019},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3328":2760,"_29138":2565,"_20209":56021,"_5":13819,"_26493":55537,"_2816":56022},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3328":2761,"_29138":2565,"_20209":56024,"_5":13819,"_26493":55537,"_2816":56025},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3328":2762,"_29138":2565,"_20209":56027,"_5":13819,"_26493":55537,"_2816":56028},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3328":2763,"_29138":2565,"_20209":56030,"_5":13819,"_26493":55537,"_2816":56031},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3328":2764,"_29138":2565,"_20209":56033,"_5":13819,"_26493":55537,"_2816":56034},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3328":2765,"_29138":2565,"_20209":56036,"_5":13819,"_26493":55541,"_2816":56037},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3328":2766,"_29138":2565,"_20209":56039,"_5":13819,"_26493":55541,"_2816":56040},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3328":2767,"_29138":2565,"_20209":56042,"_5":13819,"_26493":55545,"_2816":56043},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3328":2768,"_29138":2565,"_20209":56045,"_5":13819,"_26493":55545,"_2816":56046},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3328":2769,"_29138":2565,"_20209":56048,"_5":13819,"_26493":55545,"_2816":56049},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3328":2770,"_29138":2565,"_20209":56051,"_5":13819,"_26493":55545,"_2816":56052},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3328":2771,"_29138":2565,"_20209":56054,"_5":13819,"_26493":55545,"_2816":56055},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3328":2772,"_29138":2565,"_20209":56057,"_5":13819,"_26493":55545,"_2816":56058},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3328":2773,"_29138":2565,"_20209":56060,"_5":13819,"_26493":55545,"_2816":56061},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3328":2774,"_29138":2565,"_20209":56063,"_5":13819,"_26493":55545,"_2816":56064},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3328":2775,"_29138":2565,"_20209":56066,"_5":13819,"_26493":55545,"_2816":56067},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3328":2776,"_29138":2565,"_20209":56069,"_5":13819,"_26493":55545,"_2816":56070},[],"**Remove the helper and restore the recorded replica counts:**",{"_3328":2777,"_29138":2565,"_20209":56072,"_5":13819,"_26493":55545,"_2816":56073},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3328":2778,"_29138":2565,"_20209":56075,"_5":13819,"_26493":55549,"_2816":56076},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3328":2779,"_29138":2565,"_20209":56078,"_5":13819,"_26493":55549,"_2816":56079},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3328":2780,"_29138":2565,"_20209":56081,"_5":13819,"_26493":55553,"_2816":56082},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3328":2781,"_29138":2565,"_20209":56084,"_5":13819,"_26493":55553,"_2816":56085},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3328":2782,"_29138":2565,"_20209":56087,"_5":13819,"_26493":55553,"_2816":56088},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3328":2783,"_29138":2565,"_20209":56090,"_5":13819,"_26493":55553,"_2816":56091},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3328":2784,"_29138":2565,"_20209":56093,"_5":13819,"_26493":55553,"_2816":56094},[],"The `goose-lamassu` README still shows per-database examples (`dbname=ca`, `dbname=kms`) and claims the tool validates the database name, and the `ca-to-kms-migration` README still describes the pre-4.0.0 two-database layout. Follow the `dbname=pki` form on this page instead of their examples.",{"_3328":2785,"_29138":2565,"_20209":56096,"_5":13819,"_26493":55557,"_2816":56097},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3328":2786,"_29138":2565,"_20209":56099,"_5":13819,"_26493":55557,"_2816":56100},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3328":2787,"_29138":2565,"_20209":56102,"_5":13819,"_26493":55557,"_2816":56103},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3328":2788,"_29138":2565,"_20209":56105,"_5":13819,"_26493":55557,"_2816":56106},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3328":2789,"_29138":2565,"_20209":56108,"_5":13819,"_26493":55557,"_2816":56109},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_3328":2790,"_29138":2565,"_20209":56111,"_5":13819,"_26493":55557,"_2816":56112},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3328":2791,"_29138":2565,"_20209":56114,"_5":13819,"_26493":55557,"_2816":56115},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3328":2792,"_29138":2565,"_20209":56117,"_5":13819,"_26493":55560,"_2816":56118},[],"After the upgrade, check in this order:",{"_3328":2793,"_29138":2565,"_20209":56120,"_5":13819,"_26493":55560,"_2816":56121},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations.",{"_3328":2794,"_29138":2565,"_20209":56123,"_5":13819,"_26493":55560,"_2816":56124},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3328":2795,"_29138":2565,"_20209":56126,"_5":13819,"_26493":55560,"_2816":56127},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3328":2796,"_29138":2565,"_20209":56129,"_5":13819,"_26493":55560,"_2816":56130},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_3328":2797,"_29138":2565,"_20209":56132,"_5":13819,"_26493":55560,"_2816":56133},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS.",{"_3328":2798,"_29138":2565,"_20209":56135,"_5":13819,"_26493":55560,"_2816":56136},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3328":2799,"_29138":2565,"_20209":56138,"_5":13819,"_26493":55560,"_2816":56139},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3328":2800,"_29138":2565,"_20209":56141,"_5":13819,"_26493":55560,"_2816":56142},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3328":2801,"_29138":2565,"_20209":56144,"_5":13819,"_26493":55560,"_2816":56145},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3328":2802,"_29138":2565,"_20209":56147,"_5":13819,"_26493":55560,"_2816":56148},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3328":2803,"_29138":2565,"_20209":56150,"_5":13819,"_26493":55560,"_2816":56151},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3328":2804,"_29138":2565,"_20209":56153,"_5":13819,"_26493":55560,"_2816":56154},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3328":2805,"_29138":2565,"_20209":56156,"_5":13819,"_26493":55560,"_2816":56157},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3328":2806,"_29138":2565,"_20209":56159,"_5":13819,"_26493":55560,"_2816":56160},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3328":2807,"_29138":2565,"_20209":56162,"_5":13819,"_26493":55564,"_2816":56163},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3328":2808,"_29138":2565,"_20209":56165,"_5":13819,"_26493":55564,"_2816":56166},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3328":2809,"_29138":2565,"_20209":56168,"_5":13819,"_26493":55564,"_2816":56169},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3328":2810,"_29138":2565,"_20209":56171,"_5":13819,"_26493":55564,"_2816":56172},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3328":2811,"_29138":2565,"_20209":56174,"_5":13819,"_26493":55564,"_2816":56175},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_56178":56179,"_56180":56181,"_56182":56183,"_56184":56185,"_17488":2838,"_67387":2838},"language","english","sortableProperties",[2816,29138,5,26493],"sortablePropertiesWithTypes",{"_2816":24136,"_29138":24136,"_5":24136,"_26493":24136},"sorts",{"_2816":56186,"_29138":58987,"_5":61787,"_26493":64587},{"_4473":56187,"_56188":56189,"_5":24136},{"_13901":4935,"_14277":7320,"_14296":6200,"_12464":15852,"_14283":4413,"_19180":3102,"_13922":15423,"_13929":11176,"_28090":21442,"_28498":9097,"_28519":6675,"_28124":4064,"_33381":5357,"_28226":13793,"_28563":4811,"_33388":14375,"_33391":24697,"_33394":23744,"_33397":6185,"_28970":23762,"_33402":22384,"_33404":19451,"_29000":3098,"_14292":18501,"_33408":2890,"_33411":4539,"_33413":4604,"_28547":3209,"_28965":18786,"_29013":4234,"_33418":15962,"_33420":17490,"_33422":19457,"_28243":2915,"_33425":3350,"_33427":9723,"_33429":4552,"_33431":3518,"_33433":6679,"_28160":4269,"_33436":3805,"_33438":8189,"_28154":4451,"_28584":6889,"_29197":2998,"_33443":10022,"_33446":11319,"_28200":15641,"_33450":8211,"_28081":5729,"_33453":2929,"_28129":5749,"_33456":5655,"_33458":3192,"_33461":6993,"_14286":7152,"_33464":8707,"_33466":6701,"_33469":4029,"_33471":9625,"_33473":15812,"_33475":6696,"_33477":15424,"_19183":3466,"_33480":21193,"_33482":6630,"_28102":6098,"_28541":6281,"_33486":6293,"_33488":4769,"_33490":4941,"_29030":6106,"_33493":5587,"_33495":7043,"_33497":4432,"_29124":3554,"_28600":4447,"_33501":7114,"_33503":5731,"_28139":3868,"_33506":3668,"_33508":3862,"_33510":19418,"_29046":4928,"_28220":3506,"_27561":4255,"_33515":20700,"_33517":25141,"_33519":7357,"_28269":14156,"_33523":7639,"_28535":5736,"_33527":12426,"_33529":4164,"_33531":3861,"_33533":6714,"_33535":6329,"_33537":3074,"_28258":6362,"_28503":4005,"_33541":4975,"_33543":3923,"_33545":3135,"_33548":3263,"_33550":6639,"_33552":6622,"_33554":3836,"_33556":3498,"_33558":3831,"_33560":3538,"_33563":20998,"_33565":3134,"_33567":10077,"_33569":36