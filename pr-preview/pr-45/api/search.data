48":15,"_5":25581,"_17581":40969,"_23883":40970,"_2389":40971},[],"/docs/pr-preview/pr-45/deployment/aws-marketplace#before-you-begin","Before you begin",{"_2862":18,"_25248":15,"_5":25581,"_17581":40973,"_23883":40974,"_2389":40975},[],"/docs/pr-preview/pr-45/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_2862":19,"_25248":15,"_5":25581,"_17581":40977,"_23883":40978,"_2389":40979},[],"/docs/pr-preview/pr-45/deployment/aws-marketplace#open-the-offer","Open the offer",{"_2862":20,"_25248":15,"_5":25581,"_17581":40981,"_23883":40982,"_2389":40983},[],"/docs/pr-preview/pr-45/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_2862":21,"_25248":15,"_5":25581,"_17581":40985,"_23883":40986,"_2389":40987},[],"/docs/pr-preview/pr-45/deployment/aws-marketplace#limit-network-access","Limit network access",{"_2862":22,"_25248":15,"_5":25581,"_17581":40989,"_23883":40990,"_2389":40991},[],"/docs/pr-preview/pr-45/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_2862":23,"_25248":15,"_5":25581,"_17581":40993,"_23883":40994,"_2389":40995},[],"/docs/pr-preview/pr-45/deployment/aws-marketplace#next-step","Next step",{"_2862":24,"_25248":15,"_17581":40997,"_5":17476,"_23883":15,"_2389":40998},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_2862":25,"_25248":15,"_17581":41000,"_5":17476,"_23883":40970,"_2389":41001},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_2862":26,"_25248":15,"_17581":41003,"_5":17476,"_23883":40970,"_2389":41004},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_2862":27,"_25248":15,"_17581":41006,"_5":17476,"_23883":40970,"_2389":41007},[],"A security group allowing the necessary endpoints.",{"_2862":28,"_25248":15,"_17581":41009,"_5":17476,"_23883":40974,"_2389":41010},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_2862":29,"_25248":15,"_17581":41012,"_5":17476,"_23883":40974,"_2389":41013},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_2862":30,"_25248":15,"_17581":41015,"_5":17476,"_23883":40974,"_2389":41016},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_2862":31,"_25248":15,"_17581":41018,"_5":17476,"_23883":40978,"_2389":41019},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_2862":32,"_25248":15,"_17581":41021,"_5":17476,"_23883":40982,"_2389":41022},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_2862":33,"_25248":15,"_17581":41024,"_5":17476,"_23883":40986,"_2389":41025},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_2862":34,"_25248":15,"_17581":41027,"_5":17476,"_23883":40990,"_2389":41028},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_2862":35,"_25248":15,"_17581":41030,"_5":17476,"_23883":40994,"_2389":41031},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_2862":36,"_25248":36,"_5":12326,"_2389":41033,"_25584":41034,"_17581":41035,"_23883":36},"Deploy Lamassu",[40961,40962],[],{"_2862":37,"_25248":36,"_17581":41037,"_5":17476,"_23883":36,"_2389":41038},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_2862":38,"_25248":36,"_5":25581,"_17581":41040,"_23883":41041,"_2389":41042},[],"/docs/pr-preview/pr-45/deployment/overview#choose-a-model","Choose a model",{"_2862":39,"_25248":36,"_5":25581,"_17581":41044,"_23883":41045,"_2389":41046},[],"/docs/pr-preview/pr-45/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_2862":40,"_25248":36,"_5":25581,"_17581":41048,"_23883":41049,"_2389":41050},[],"/docs/pr-preview/pr-45/deployment/overview#after-deployment","After deployment",{"_2862":41,"_25248":36,"_17581":41052,"_5":17476,"_23883":36,"_2389":41053},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_2862":42,"_25248":36,"_17581":41055,"_5":17476,"_23883":41041,"_2389":41056},[],"Model",{"_2862":43,"_25248":36,"_17581":41058,"_5":17476,"_23883":41041,"_2389":41059},[],"Recommended for",{"_2862":44,"_25248":36,"_17581":41061,"_5":17476,"_23883":41041,"_2389":41062},[],"Who operates the infrastructure",{"_2862":45,"_25248":36,"_17581":41064,"_5":17476,"_23883":41041,"_2389":41065},[],"Starting point",{"_2862":46,"_25248":36,"_17581":41067,"_5":17476,"_23883":41041,"_2389":41068},[],"Kubernetes self-managed",{"_2862":47,"_25248":36,"_17581":41070,"_5":17476,"_23883":41041,"_2389":41071},[],"Production, regulated environments and custom deployments",{"_2862":48,"_25248":36,"_17581":41073,"_5":17476,"_23883":41041,"_2389":41074},[],"Your team",{"_2862":49,"_25248":36,"_17581":41076,"_5":17476,"_23883":41041,"_2389":41077},[],"Helm or Fastlane",{"_2862":50,"_25248":36,"_17581":41079,"_5":17476,"_23883":41041,"_2389":41080},[],"AWS Marketplace",{"_2862":51,"_25248":36,"_17581":41082,"_5":17476,"_23883":41041,"_2389":41083},[],"Evaluation or a dedicated deployment inside an AWS account",{"_2862":52,"_25248":36,"_17581":41085,"_5":17476,"_23883":41041,"_2389":41074},[],{"_2862":53,"_25248":36,"_17581":41087,"_5":17476,"_23883":41041,"_2389":41088},[],"Preconfigured image on EC2",{"_2862":54,"_25248":36,"_17581":41090,"_5":17476,"_23883":41041,"_2389":41091},[],"SaaS",{"_2862":55,"_25248":36,"_17581":41093,"_5":17476,"_23883":41041,"_2389":41094},[],"Teams that want to use the platform without operating it",{"_2862":56,"_25248":36,"_17581":41096,"_5":17476,"_23883":41041,"_2389":41097},[],"Lamassu",{"_2862":57,"_25248":36,"_17581":41099,"_5":17476,"_23883":41041,"_2389":41100},[],"Managed subscription",{"_2862":58,"_25248":36,"_17581":41102,"_5":17476,"_23883":41041,"_2389":41103},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2862":59,"_25248":36,"_17581":41105,"_5":17476,"_23883":41041,"_2389":41106},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2862":60,"_25248":36,"_17581":41108,"_5":17476,"_23883":41041,"_2389":41109},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_2862":61,"_25248":36,"_17581":41111,"_5":17476,"_23883":41045,"_2389":41112},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_2862":62,"_25248":36,"_17581":41114,"_5":17476,"_23883":41049,"_2389":41115},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_2862":63,"_25248":63,"_5":12326,"_2389":41117,"_25584":41118,"_17581":41119,"_23883":63},"Use Lamassu as SaaS",[40961,40962,40963],[],{"_2862":64,"_25248":63,"_17581":41121,"_5":17476,"_23883":63,"_2389":41122},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_2862":65,"_25248":63,"_5":25581,"_17581":41124,"_23883":41125,"_2389":41126},[],"/docs/pr-preview/pr-45/deployment/saas#what-the-service-manages","What the service manages",{"_2862":66,"_25248":63,"_5":25581,"_17581":41128,"_23883":41129,"_2389":41130},[],"/docs/pr-preview/pr-45/deployment/saas#plans","Plans",{"_2862":67,"_25248":63,"_5":25581,"_17581":41132,"_23883":41133,"_2389":41134},[],"/docs/pr-preview/pr-45/deployment/saas#request-access","Request access",{"_2862":68,"_25248":63,"_17581":41136,"_5":17476,"_23883":63,"_2389":41137},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_2862":69,"_25248":63,"_17581":41139,"_5":17476,"_23883":41125,"_2389":41140},[],"Platform availability and maintenance.",{"_2862":70,"_25248":63,"_17581":41142,"_5":17476,"_23883":41125,"_2389":41143},[],"Automatic backups.",{"_2862":71,"_25248":63,"_17581":41145,"_5":17476,"_23883":41125,"_2389":41146},[],"Version upgrades.",{"_2862":72,"_25248":63,"_17581":41148,"_5":17476,"_23883":41125,"_2389":41149},[],"Technical support and SLA according to your plan.",{"_2862":73,"_25248":63,"_17581":41151,"_5":17476,"_23883":41129,"_2389":41152},[],"Plan",{"_2862":74,"_25248":63,"_17581":41154,"_5":17476,"_23883":41129,"_2389":41155},[],"Devices",{"_2862":75,"_25248":63,"_17581":41157,"_5":17476,"_23883":41129,"_2389":41158},[],"Support",{"_2862":76,"_25248":63,"_17581":41160,"_5":17476,"_23883":41129,"_2389":41161},[],"SLA",{"_2862":77,"_25248":63,"_17581":41163,"_5":17476,"_23883":41129,"_2389":41164},[],"Starter",{"_2862":78,"_25248":63,"_17581":41166,"_5":17476,"_23883":41129,"_2389":41167},[],"Up to 1,000",{"_2862":79,"_25248":63,"_17581":41169,"_5":17476,"_23883":41129,"_2389":41170},[],"Email",{"_2862":80,"_25248":63,"_17581":41172,"_5":17476,"_23883":41129,"_2389":41173},[],"99.5 %",{"_2862":81,"_25248":63,"_17581":41175,"_5":17476,"_23883":41129,"_2389":41176},[],"Professional",{"_2862":82,"_25248":63,"_17581":41178,"_5":17476,"_23883":41129,"_2389":41179},[],"Up to 10,000",{"_2862":83,"_25248":63,"_17581":41181,"_5":17476,"_23883":41129,"_2389":41182},[],"Email and chat",{"_2862":84,"_25248":63,"_17581":41184,"_5":17476,"_23883":41129,"_2389":41185},[],"99.9 %",{"_2862":85,"_25248":63,"_17581":41187,"_5":17476,"_23883":41129,"_2389":41188},[],"Enterprise",{"_2862":86,"_25248":63,"_17581":41190,"_5":17476,"_23883":41129,"_2389":41191},[],"Unlimited",{"_2862":87,"_25248":63,"_17581":41193,"_5":17476,"_23883":41129,"_2389":41194},[],"Dedicated",{"_2862":88,"_25248":63,"_17581":41196,"_5":17476,"_23883":41129,"_2389":41197},[],"99.99 %",{"_2862":89,"_25248":63,"_17581":41199,"_5":17476,"_23883":41133,"_2389":41200},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_2862":90,"_25248":63,"_17581":41202,"_5":17476,"_23883":41133,"_2389":41203},[],"When you receive your instance's credentials, continue with Get started.",{"_2862":91,"_25248":91,"_5":12326,"_2389":41205,"_25584":41206,"_17581":41207,"_23883":91},"Fastlane",[40961,40962,41068],[],{"_2862":92,"_25248":91,"_17581":41209,"_5":17476,"_23883":91,"_2389":41210},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_2862":93,"_25248":91,"_5":25581,"_17581":41212,"_23883":41213,"_2389":41214},[],"/docs/pr-preview/pr-45/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_2862":94,"_25248":91,"_5":25581,"_17581":41216,"_23883":41217,"_2389":41218},[],"/docs/pr-preview/pr-45/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_2862":95,"_25248":91,"_5":25581,"_17581":41220,"_23883":41221,"_2389":40971},[],"/docs/pr-preview/pr-45/deployment/self-hosted/fastlane#before-you-begin",{"_2862":96,"_25248":91,"_5":25581,"_17581":41223,"_23883":41224,"_2389":41225},[],"/docs/pr-preview/pr-45/deployment/self-hosted/fastlane#quick-start","Quick start",{"_2862":97,"_25248":91,"_5":25581,"_17581":41227,"_23883":41228,"_2389":41229},[],"/docs/pr-preview/pr-45/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_2862":98,"_25248":91,"_5":25581,"_17581":41231,"_23883":41232,"_2389":41233},[],"/docs/pr-preview/pr-45/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_2862":99,"_25248":91,"_5":25581,"_17581":41235,"_23883":41236,"_2389":41237},[],"/docs/pr-preview/pr-45/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_2862":100,"_25248":91,"_5":25581,"_17581":41239,"_23883":41240,"_2389":41241},[],"/docs/pr-preview/pr-45/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_2862":101,"_25248":91,"_5":25581,"_17581":41243,"_23883":41244,"_2389":41245},[],"/docs/pr-preview/pr-45/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_2862":102,"_25248":91,"_5":25581,"_17581":41247,"_23883":41248,"_2389":41249},[],"/docs/pr-preview/pr-45/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_2862":103,"_25248":91,"_17581":41251,"_5":17476,"_23883":41213,"_2389":41252},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_2862":104,"_25248":91,"_17581":41254,"_5":17476,"_23883":41213,"_2389":41255},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_2862":105,"_25248":91,"_17581":41257,"_5":17476,"_23883":41217,"_2389":41258},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_2862":106,"_25248":91,"_17581":41260,"_5":17476,"_23883":41217,"_2389":41261},[],"Fastlane installs or configures",{"_2862":107,"_25248":91,"_17581":41263,"_5":17476,"_23883":41217,"_2389":41264},[],"You still provide",{"_2862":108,"_25248":91,"_17581":41266,"_5":17476,"_23883":41217,"_2389":41267},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_2862":109,"_25248":91,"_17581":41269,"_5":17476,"_23883":41217,"_2389":41270},[],"The Kubernetes cluster, nodes and persistent storage",{"_2862":110,"_25248":91,"_17581":41272,"_5":17476,"_23883":41217,"_2389":41273},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_2862":111,"_25248":91,"_17581":41275,"_5":17476,"_23883":41217,"_2389":41276},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_2862":112,"_25248":91,"_17581":41278,"_5":17476,"_23883":41217,"_2389":41279},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_2862":113,"_25248":91,"_17581":41281,"_5":17476,"_23883":41217,"_2389":41282},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_2862":114,"_25248":91,"_17581":41284,"_5":17476,"_23883":41217,"_2389":41285},[],"Optional observability and lab HSM components",{"_2862":115,"_25248":91,"_17581":41287,"_5":17476,"_23883":41217,"_2389":41288},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_2862":116,"_25248":91,"_17581":41290,"_5":17476,"_23883":41217,"_2389":41291},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_2862":117,"_25248":91,"_17581":41293,"_5":17476,"_23883":41221,"_2389":41294},[],"You need:",{"_2862":118,"_25248":91,"_17581":41296,"_5":17476,"_23883":41221,"_2389":41297},[],"an existing Kubernetes cluster",{"_2862":119,"_25248":91,"_17581":41299,"_5":17476,"_23883":41221,"_2389":41300},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_2862":120,"_25248":91,"_17581":41302,"_5":17476,"_23883":41221,"_2389":41303},[],"`yq`",{"_2862":121,"_25248":91,"_17581":41305,"_5":17476,"_23883":41221,"_2389":19918},[],{"_2862":122,"_25248":91,"_17581":41307,"_5":17476,"_23883":41221,"_2389":41308},[],"`jq` only when using `--sample-data`",{"_2862":123,"_25248":91,"_17581":41310,"_5":17476,"_23883":41221,"_2389":41311},[],"free external ports 80 and 443 on a single-node K3s host",{"_2862":124,"_25248":91,"_17581":41313,"_5":17476,"_23883":41221,"_2389":41314},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_2862":125,"_25248":91,"_17581":41316,"_5":17476,"_23883":41221,"_2389":41317},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_2862":126,"_25248":91,"_17581":41319,"_5":17476,"_23883":41224,"_2389":41320},[],"Run the script from a clone of the Helm repository:",{"_2862":127,"_25248":91,"_17581":41322,"_5":17476,"_23883":41224,"_2389":41323},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_2862":128,"_25248":91,"_17581":41325,"_5":17476,"_23883":41228,"_2389":41326},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_2862":129,"_25248":91,"_17581":41328,"_5":17476,"_23883":41228,"_2389":41329},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_2862":130,"_25248":91,"_17581":41331,"_5":17476,"_23883":41228,"_2389":41332},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_2862":131,"_25248":91,"_17581":41334,"_5":17476,"_23883":41228,"_2389":41335},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_2862":132,"_25248":91,"_17581":41337,"_5":17476,"_23883":41232,"_2389":41338},[],"Option",{"_2862":133,"_25248":91,"_17581":41340,"_5":17476,"_23883":41232,"_2389":41341},[],"Default",{"_2862":134,"_25248":91,"_17581":41343,"_5":17476,"_23883":41232,"_2389":41344},[],"Purpose",{"_2862":135,"_25248":91,"_17581":41346,"_5":17476,"_23883":41232,"_2389":41347},[],"`-h`, `--help`",{"_2862":136,"_25248":91,"_17581":41349,"_5":17476,"_23883":41232,"_2389":41350},[],"—",{"_2862":137,"_25248":91,"_17581":41352,"_5":17476,"_23883":41232,"_2389":41353},[],"Show help",{"_2862":138,"_25248":91,"_17581":41355,"_5":17476,"_23883":41232,"_2389":41356},[],"`-c`, `--context`",{"_2862":139,"_25248":91,"_17581":41358,"_5":17476,"_23883":41232,"_2389":41359},[],"current context",{"_2862":140,"_25248":91,"_17581":41361,"_5":17476,"_23883":41232,"_2389":41362},[],"Select the kubeconfig context for kubectl and Helm",{"_2862":141,"_25248":91,"_17581":41364,"_5":17476,"_23883":41232,"_2389":41365},[],"`-n`, `--non-interactive`",{"_2862":142,"_25248":91,"_17581":41367,"_5":17476,"_23883":41232,"_2389":5365},[],{"_2862":143,"_25248":91,"_17581":41369,"_5":17476,"_23883":41232,"_2389":41370},[],"Skip prompts and generate dependency credentials",{"_2862":144,"_25248":91,"_17581":41372,"_5":17476,"_23883":41232,"_2389":41373},[],"`-ns`, `--namespace`",{"_2862":145,"_25248":91,"_17581":41375,"_5":17476,"_23883":41232,"_2389":41376},[],"`lamassu-dev`",{"_2862":146,"_25248":91,"_17581":41378,"_5":17476,"_23883":41232,"_2389":41379},[],"Namespace for the installation",{"_2862":147,"_25248":91,"_17581":41381,"_5":17476,"_23883":41232,"_2389":41382},[],"`-d`, `--domain`",{"_2862":148,"_25248":91,"_17581":41384,"_5":17476,"_23883":41232,"_2389":41385},[],"`dev.lamassu.io`",{"_2862":149,"_25248":91,"_17581":41387,"_5":17476,"_23883":41232,"_2389":41388},[],"Domain used by the UI, OIDC and certificate",{"_2862":150,"_25248":91,"_17581":41390,"_5":17476,"_23883":41232,"_2389":41391},[],"`-v`, `--version`",{"_2862":151,"_25248":91,"_17581":41393,"_5":17476,"_23883":41232,"_2389":12571},[],{"_2862":152,"_25248":91,"_17581":41395,"_5":17476,"_23883":41232,"_2389":41396},[],"Lamassu chart version",{"_2862":153,"_25248":91,"_17581":41398,"_5":17476,"_23883":41232,"_2389":41399},[],"`--https-port`",{"_2862":154,"_25248":91,"_17581":41401,"_5":17476,"_23883":41232,"_2389":41402},[],"`443`",{"_2862":155,"_25248":91,"_17581":41404,"_5":17476,"_23883":41232,"_2389":41405},[],"Gateway HTTPS listener port",{"_2862":156,"_25248":91,"_17581":41407,"_5":17476,"_23883":41232,"_2389":41408},[],"`--http-port`",{"_2862":157,"_25248":91,"_17581":41410,"_5":17476,"_23883":41232,"_2389":41411},[],"`80`",{"_2862":158,"_25248":91,"_17581":41413,"_5":17476,"_23883":41232,"_2389":41414},[],"Gateway HTTP listener port",{"_2862":159,"_25248":91,"_17581":41416,"_5":17476,"_23883":41232,"_2389":41417},[],"`--tls-crt`",{"_2862":160,"_25248":91,"_17581":41419,"_5":17476,"_23883":41232,"_2389":41350},[],{"_2862":161,"_25248":91,"_17581":41421,"_5":17476,"_23883":41232,"_2389":41422},[],"PEM certificate for downstream TLS",{"_2862":162,"_25248":91,"_17581":41424,"_5":17476,"_23883":41232,"_2389":41425},[],"`--tls-key`",{"_2862":163,"_25248":91,"_17581":41427,"_5":17476,"_23883":41232,"_2389":41350},[],{"_2862":164,"_25248":91,"_17581":41429,"_5":17476,"_23883":41232,"_2389":41430},[],"PEM private key for downstream TLS",{"_2862":165,"_25248":91,"_17581":41432,"_5":17476,"_23883":41232,"_2389":41433},[],"`-l`, `--local-chart-path`",{"_2862":166,"_25248":91,"_17581":41435,"_5":17476,"_23883":41232,"_2389":41436},[],"repository chart",{"_2862":167,"_25248":91,"_17581":41438,"_5":17476,"_23883":41232,"_2389":41439},[],"Use an unpacked local Lamassu chart",{"_2862":168,"_25248":91,"_17581":41441,"_5":17476,"_23883":41232,"_2389":41442},[],"`-ip`, `--gateway-ip`",{"_2862":169,"_25248":91,"_17581":41444,"_5":17476,"_23883":41232,"_2389":7282},[],{"_2862":170,"_25248":91,"_17581":41446,"_5":17476,"_23883":41232,"_2389":41447},[],"Override the address written to `gateway.addresses`",{"_2862":171,"_25248":91,"_17581":41449,"_5":17476,"_23883":41232,"_2389":41450},[],"`--otel`",{"_2862":172,"_25248":91,"_17581":41452,"_5":17476,"_23883":41232,"_2389":5365},[],{"_2862":173,"_25248":91,"_17581":41454,"_5":17476,"_23883":41232,"_2389":41455},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_2862":174,"_25248":91,"_17581":41457,"_5":17476,"_23883":41232,"_2389":41458},[],"`--sample-data`",{"_2862":175,"_25248":91,"_17581":41460,"_5":17476,"_23883":41232,"_2389":5365},[],{"_2862":176,"_25248":91,"_17581":41462,"_5":17476,"_23883":41232,"_2389":41463},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_2862":177,"_25248":91,"_17581":41465,"_5":17476,"_23883":41232,"_2389":41466},[],"`--with-hsm`",{"_2862":178,"_25248":91,"_17581":41468,"_5":17476,"_23883":41232,"_2389":5365},[],{"_2862":179,"_25248":91,"_17581":41470,"_5":17476,"_23883":41232,"_2389":41471},[],"Install lab HSM components and configure KMS for PKCS#11",{"_2862":180,"_25248":91,"_17581":41473,"_5":17476,"_23883":41232,"_2389":41474},[],"`--softhsm-chart-path`",{"_2862":181,"_25248":91,"_17581":41476,"_5":17476,"_23883":41232,"_2389":41477},[],"`./charts/softhsm`",{"_2862":182,"_25248":91,"_17581":41479,"_5":17476,"_23883":41232,"_2389":41480},[],"Use a different local SoftHSM chart",{"_2862":183,"_25248":91,"_17581":41482,"_5":17476,"_23883":41232,"_2389":41483},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_2862":184,"_25248":91,"_17581":41485,"_5":17476,"_23883":41236,"_2389":41486},[],"Fastlane:",{"_2862":185,"_25248":91,"_17581":41488,"_5":17476,"_23883":41236,"_2389":41489},[],"validates local tools and the selected cluster",{"_2862":186,"_25248":91,"_17581":41491,"_5":17476,"_23883":41236,"_2389":41492},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_2862":187,"_25248":91,"_17581":41494,"_5":17476,"_23883":41236,"_2389":41495},[],"creates the namespace",{"_2862":188,"_25248":91,"_17581":41497,"_5":17476,"_23883":41236,"_2389":41498},[],"installs PostgreSQL and creates the required databases",{"_2862":189,"_25248":91,"_17581":41500,"_5":17476,"_23883":41236,"_2389":41501},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_2862":190,"_25248":91,"_17581":41503,"_5":17476,"_23883":41236,"_2389":41504},[],"installs RabbitMQ",{"_2862":191,"_25248":91,"_17581":41506,"_5":17476,"_23883":41236,"_2389":41507},[],"optionally installs observability and lab HSM components",{"_2862":192,"_25248":91,"_17581":41509,"_5":17476,"_23883":41236,"_2389":41510},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_2862":193,"_25248":91,"_17581":41512,"_5":17476,"_23883":41236,"_2389":41513},[],"optionally loads sample data",{"_2862":194,"_25248":91,"_17581":41515,"_5":17476,"_23883":41236,"_2389":41516},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_2862":195,"_25248":91,"_17581":41518,"_5":17476,"_23883":41240,"_2389":41519},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_2862":196,"_25248":91,"_17581":41521,"_5":17476,"_23883":41240,"_2389":41522},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_2862":197,"_25248":91,"_17581":41524,"_5":17476,"_23883":41244,"_2389":41525},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use.",{"_2862":198,"_25248":91,"_17581":41527,"_5":17476,"_23883":41244,"_2389":41528},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_2862":199,"_25248":91,"_17581":41530,"_5":17476,"_23883":41244,"_2389":41531},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_2862":200,"_25248":91,"_17581":41533,"_5":17476,"_23883":41248,"_2389":41534},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_2862":201,"_25248":201,"_5":12326,"_2389":41536,"_25584":41537,"_17581":41538,"_23883":201},"Install with Helm",[40961,40962,41068],[],{"_2862":202,"_25248":201,"_17581":41540,"_5":17476,"_23883":201,"_2389":41541},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_2862":203,"_25248":201,"_5":25581,"_17581":41543,"_23883":41544,"_2389":41545},[],"/docs/pr-preview/pr-45/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_2862":204,"_25248":201,"_5":25581,"_17581":41547,"_23883":41548,"_2389":40971},[],"/docs/pr-preview/pr-45/deployment/self-hosted/helm#before-you-begin",{"_2862":205,"_25248":201,"_5":25581,"_17581":41550,"_23883":41551,"_2389":41552},[],"/docs/pr-preview/pr-45/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_2862":206,"_25248":201,"_5":25581,"_17581":41554,"_23883":41555,"_2389":41556},[],"/docs/pr-preview/pr-45/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_2862":207,"_25248":201,"_5":25581,"_17581":41558,"_23883":41559,"_2389":41560},[],"/docs/pr-preview/pr-45/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_2862":208,"_25248":201,"_5":25581,"_17581":41562,"_23883":41563,"_2389":41564},[],"/docs/pr-preview/pr-45/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_2862":209,"_25248":201,"_5":25581,"_17581":41566,"_23883":41567,"_2389":41568},[],"/docs/pr-preview/pr-45/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_2862":210,"_25248":201,"_5":25581,"_17581":41570,"_23883":41571,"_2389":41572},[],"/docs/pr-preview/pr-45/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_2862":211,"_25248":201,"_5":25581,"_17581":41574,"_23883":41575,"_2389":41576},[],"/docs/pr-preview/pr-45/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_2862":212,"_25248":201,"_5":25581,"_17581":41578,"_23883":41579,"_2389":41580},[],"/docs/pr-preview/pr-45/deployment/self-hosted/helm#production-decisions","Production decisions",{"_2862":213,"_25248":201,"_17581":41582,"_5":17476,"_23883":41544,"_2389":41583},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_2862":214,"_25248":201,"_17581":41585,"_5":17476,"_23883":41548,"_2389":41586},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_2862":215,"_25248":201,"_17581":41588,"_5":17476,"_23883":41548,"_2389":41589},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_2862":216,"_25248":201,"_17581":41591,"_5":17476,"_23883":41548,"_2389":41592},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_2862":217,"_25248":201,"_17581":41594,"_5":17476,"_23883":41548,"_2389":41595},[],"a reachable RabbitMQ broker and credentials",{"_2862":218,"_25248":201,"_17581":41597,"_5":17476,"_23883":41548,"_2389":41598},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_2862":219,"_25248":201,"_17581":41600,"_5":17476,"_23883":41548,"_2389":41601},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_2862":220,"_25248":201,"_17581":41603,"_5":17476,"_23883":41548,"_2389":41604},[],"cert-manager 1.14+; for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_2862":221,"_25248":201,"_17581":41606,"_5":17476,"_23883":41548,"_2389":41607},[],"a StorageClass and an external traffic design",{"_2862":222,"_25248":201,"_17581":41609,"_5":17476,"_23883":41548,"_2389":41610},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_2862":223,"_25248":201,"_17581":41612,"_5":17476,"_23883":41548,"_2389":41613},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_2862":224,"_25248":201,"_17581":41615,"_5":17476,"_23883":41548,"_2389":41616},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_2862":225,"_25248":201,"_17581":41618,"_5":17476,"_23883":41551,"_2389":41619},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_2862":226,"_25248":201,"_17581":41621,"_5":17476,"_23883":41551,"_2389":41622},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_2862":227,"_25248":201,"_17581":41624,"_5":17476,"_23883":41551,"_2389":41625},[],"Install cert-manager separately before Lamassu. The current chart renders its self-signed issuer and CA certificate resources even when `tls.type: external` makes the Gateway use an existing TLS Secret. Selecting external TLS therefore does not remove the cert-manager prerequisite.",{"_2862":228,"_25248":201,"_17581":41627,"_5":17476,"_23883":41555,"_2389":41628},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_2862":229,"_25248":201,"_17581":41630,"_5":17476,"_23883":41555,"_2389":41631},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_2862":230,"_25248":201,"_17581":41633,"_5":17476,"_23883":41555,"_2389":41634},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_2862":231,"_25248":201,"_17581":41636,"_5":17476,"_23883":41559,"_2389":41637},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it:",{"_2862":232,"_25248":201,"_17581":41639,"_5":17476,"_23883":41563,"_2389":41640},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_2862":233,"_25248":201,"_17581":41642,"_5":17476,"_23883":41563,"_2389":41643},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_2862":234,"_25248":201,"_17581":41645,"_5":17476,"_23883":41563,"_2389":41646},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_2862":235,"_25248":201,"_17581":41648,"_5":17476,"_23883":41563,"_2389":41649},[],"See Access control for the principal and policy model.",{"_2862":236,"_25248":201,"_17581":41651,"_5":17476,"_23883":41567,"_2389":41652},[],"To install a local checkout instead:",{"_2862":237,"_25248":201,"_17581":41654,"_5":17476,"_23883":41571,"_2389":41655},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_2862":238,"_25248":201,"_17581":41657,"_5":17476,"_23883":41571,"_2389":41658},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_2862":239,"_25248":201,"_17581":41660,"_5":17476,"_23883":41575,"_2389":41661},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_2862":240,"_25248":201,"_17581":41663,"_5":17476,"_23883":41575,"_2389":41664},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. It runs before the other pre-upgrade hooks, the authorization bootstrap configuration and the database-migration Job, which use hook weights `-4` and `-3` versus its `-10`.",{"_2862":241,"_25248":201,"_17581":41666,"_5":17476,"_23883":41575,"_2389":41667},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_2862":242,"_25248":201,"_17581":41669,"_5":17476,"_23883":41575,"_2389":41670},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_2862":243,"_25248":201,"_17581":41672,"_5":17476,"_23883":41575,"_2389":41673},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_2862":244,"_25248":201,"_17581":41675,"_5":17476,"_23883":41579,"_2389":41676},[],"Before going live, review:",{"_2862":245,"_25248":201,"_17581":41678,"_5":17476,"_23883":41579,"_2389":41679},[],"backup and recovery for PostgreSQL and persistent volumes",{"_2862":246,"_25248":201,"_17581":41681,"_5":17476,"_23883":41579,"_2389":41682},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_2862":247,"_25248":201,"_17581":41684,"_5":17476,"_23883":41579,"_2389":41685},[],"shared VA storage before increasing VA replicas",{"_2862":248,"_25248":201,"_17581":41687,"_5":17476,"_23883":41579,"_2389":41688},[],"managed OIDC roles and removal of evaluation credentials",{"_2862":249,"_25248":201,"_17581":41690,"_5":17476,"_23883":41579,"_2389":41691},[],"a trusted TLS issuer or externally managed certificate",{"_2862":250,"_25248":201,"_17581":41693,"_5":17476,"_23883":41579,"_2389":41694},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_2862":251,"_25248":201,"_17581":41696,"_5":17476,"_23883":41579,"_2389":41697},[],"SMTP, observability and alert delivery",{"_2862":252,"_25248":201,"_17581":41699,"_5":17476,"_23883":41579,"_2389":41700},[],"the migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_2862":253,"_25248":201,"_17581":41702,"_5":17476,"_23883":41579,"_2389":41703},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_2862":254,"_25248":254,"_5":12326,"_2389":41705,"_25584":41706,"_17581":41707,"_23883":254},"Expose the Gateway",[40961,40962,41068],[],{"_2862":255,"_25248":254,"_17581":41709,"_5":17476,"_23883":254,"_2389":41710},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_2862":256,"_25248":254,"_5":25581,"_17581":41712,"_23883":41713,"_2389":41714},[],"/docs/pr-preview/pr-45/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_2862":257,"_25248":254,"_5":25581,"_17581":41716,"_23883":41717,"_2389":41718},[],"/docs/pr-preview/pr-45/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_2862":258,"_25248":254,"_5":25581,"_17581":41720,"_23883":41721,"_2389":41722},[],"/docs/pr-preview/pr-45/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_2862":259,"_25248":254,"_5":25581,"_17581":41724,"_23883":41725,"_2389":41726},[],"/docs/pr-preview/pr-45/deployment/self-hosted/networking#k3s","K3s",{"_2862":260,"_25248":254,"_5":25581,"_17581":41728,"_23883":41729,"_2389":41730},[],"/docs/pr-preview/pr-45/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_2862":261,"_25248":254,"_5":25581,"_17581":41732,"_23883":41733,"_2389":41734},[],"/docs/pr-preview/pr-45/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_2862":262,"_25248":254,"_5":25581,"_17581":41736,"_23883":41737,"_2389":41738},[],"/docs/pr-preview/pr-45/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_2862":263,"_25248":254,"_5":25581,"_17581":41740,"_23883":41741,"_2389":41742},[],"/docs/pr-preview/pr-45/deployment/self-hosted/networking#decision-guide","Decision guide",{"_2862":264,"_25248":254,"_5":25581,"_17581":41744,"_23883":41745,"_2389":41746},[],"/docs/pr-preview/pr-45/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_2862":265,"_25248":254,"_17581":41748,"_5":17476,"_23883":41713,"_2389":41749},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_2862":266,"_25248":254,"_17581":41751,"_5":17476,"_23883":41713,"_2389":41752},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_2862":267,"_25248":254,"_17581":41754,"_5":17476,"_23883":41717,"_2389":41755},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_2862":268,"_25248":254,"_17581":41757,"_5":17476,"_23883":41717,"_2389":41758},[],"Set it only when:",{"_2862":269,"_25248":254,"_17581":41760,"_5":17476,"_23883":41717,"_2389":41761},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_2862":270,"_25248":254,"_17581":41763,"_5":17476,"_23883":41717,"_2389":41764},[],"that address is allocated to this Gateway",{"_2862":271,"_25248":254,"_17581":41766,"_5":17476,"_23883":41717,"_2389":41767},[],"the surrounding network already routes traffic for it to the cluster",{"_2862":272,"_25248":254,"_17581":41769,"_5":17476,"_23883":41717,"_2389":41770},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_2862":273,"_25248":254,"_17581":41772,"_5":17476,"_23883":41717,"_2389":41773},[],"Keep these two settings separate:",{"_2862":274,"_25248":254,"_17581":41775,"_5":17476,"_23883":41717,"_2389":41776},[],"`gateway.addresses` requests an address for the Gateway.",{"_2862":275,"_25248":254,"_17581":41778,"_5":17476,"_23883":41717,"_2389":41779},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_2862":276,"_25248":254,"_17581":41781,"_5":17476,"_23883":41717,"_2389":41782},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_2862":277,"_25248":254,"_17581":41784,"_5":17476,"_23883":41721,"_2389":41785},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_2862":278,"_25248":254,"_17581":41787,"_5":17476,"_23883":41721,"_2389":41788},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_2862":279,"_25248":254,"_17581":41790,"_5":17476,"_23883":41725,"_2389":41791},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_2862":280,"_25248":254,"_17581":41793,"_5":17476,"_23883":41725,"_2389":41794},[],"For the recommended design:",{"_2862":281,"_25248":254,"_17581":41796,"_5":17476,"_23883":41725,"_2389":41797},[],"Use only one externally exposed Lamassu Gateway.",{"_2862":282,"_25248":254,"_17581":41799,"_5":17476,"_23883":41725,"_2389":41800},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_2862":283,"_25248":254,"_17581":41802,"_5":17476,"_23883":41725,"_2389":41803},[],"Allow those ports through the VM firewall and any upstream security group.",{"_2862":284,"_25248":254,"_17581":41805,"_5":17476,"_23883":41725,"_2389":41806},[],"Point DNS at the VM's reachable address.",{"_2862":285,"_25248":254,"_17581":41808,"_5":17476,"_23883":41725,"_2389":41809},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_2862":286,"_25248":254,"_17581":41811,"_5":17476,"_23883":41729,"_2389":41812},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_2862":287,"_25248":254,"_17581":41814,"_5":17476,"_23883":41733,"_2389":41815},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_2862":288,"_25248":254,"_17581":41817,"_5":17476,"_23883":41733,"_2389":41818},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_2862":289,"_25248":254,"_17581":41820,"_5":17476,"_23883":41737,"_2389":41821},[],"First decide whether you need three independent data planes or only three hostnames.",{"_2862":290,"_25248":254,"_17581":41823,"_5":17476,"_23883":41737,"_2389":41824},[],"Requirement",{"_2862":291,"_25248":254,"_17581":41826,"_5":17476,"_23883":41737,"_2389":41827},[],"Recommended design",{"_2862":292,"_25248":254,"_17581":41829,"_5":17476,"_23883":41737,"_2389":41830},[],"Consequence",{"_2862":293,"_25248":254,"_17581":41832,"_5":17476,"_23883":41737,"_2389":41833},[],"Several Lamassu URLs or services",{"_2862":294,"_25248":254,"_17581":41835,"_5":17476,"_23883":41737,"_2389":41836},[],"One Gateway with multiple routes",{"_2862":295,"_25248":254,"_17581":41838,"_5":17476,"_23883":41737,"_2389":41839},[],"One IP and one proxy fleet; this is the chart default",{"_2862":296,"_25248":254,"_17581":41841,"_5":17476,"_23883":41737,"_2389":41842},[],"Independent Gateways and separate external IPs",{"_2862":297,"_25248":254,"_17581":41844,"_5":17476,"_23883":41737,"_2389":41845},[],"One VIP per Gateway",{"_2862":298,"_25248":254,"_17581":41847,"_5":17476,"_23883":41737,"_2389":41848},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_2862":299,"_25248":254,"_17581":41850,"_5":17476,"_23883":41737,"_2389":41851},[],"Independent Gateways on one node and one IP",{"_2862":300,"_25248":254,"_17581":41853,"_5":17476,"_23883":41737,"_2389":41854},[],"Use different external ports",{"_2862":301,"_25248":254,"_17581":41856,"_5":17476,"_23883":41737,"_2389":41857},[],"Clients must include non-standard ports",{"_2862":302,"_25248":254,"_17581":41859,"_5":17476,"_23883":41737,"_2389":41860},[],"Separate TLS/mTLS termination behind one IP",{"_2862":303,"_25248":254,"_17581":41862,"_5":17476,"_23883":41737,"_2389":41863},[],"Front-door SNI routing to internal Gateways",{"_2862":304,"_25248":254,"_17581":41865,"_5":17476,"_23883":41737,"_2389":41866},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_2862":305,"_25248":254,"_17581":41868,"_5":17476,"_23883":41737,"_2389":41869},[],"Separate Gateway resources but shared proxy infrastructure",{"_2862":306,"_25248":254,"_17581":41871,"_5":17476,"_23883":41737,"_2389":41872},[],"Envoy merged-Gateway mode",{"_2862":307,"_25248":254,"_17581":41874,"_5":17476,"_23883":41737,"_2389":41875},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_2862":308,"_25248":254,"_17581":41877,"_5":17476,"_23883":41737,"_2389":41878},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_2862":309,"_25248":254,"_17581":41880,"_5":17476,"_23883":41737,"_2389":41881},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_2862":310,"_25248":254,"_17581":41883,"_5":17476,"_23883":41737,"_2389":41884},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_2862":311,"_25248":254,"_17581":41886,"_5":17476,"_23883":41737,"_2389":41887},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_2862":312,"_25248":254,"_17581":41889,"_5":17476,"_23883":41741,"_2389":41890},[],"If one Gateway can own TLS and routing, use the chart default.",{"_2862":313,"_25248":254,"_17581":41892,"_5":17476,"_23883":41741,"_2389":41893},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_2862":314,"_25248":254,"_17581":41895,"_5":17476,"_23883":41741,"_2389":41896},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_2862":315,"_25248":254,"_17581":41898,"_5":17476,"_23883":41741,"_2389":41899},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_2862":316,"_25248":254,"_17581":41901,"_5":17476,"_23883":41741,"_2389":41902},[],"If none of those are possible, use different external ports or change the external network design.",{"_2862":317,"_25248":254,"_17581":41904,"_5":17476,"_23883":41745,"_2389":41905},[],"Check, in order:",{"_2862":318,"_25248":254,"_17581":41907,"_5":17476,"_23883":41745,"_2389":41908},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_2862":319,"_25248":254,"_17581":41910,"_5":17476,"_23883":41745,"_2389":41911},[],"Its status contains the expected address.",{"_2862":320,"_25248":254,"_17581":41913,"_5":17476,"_23883":41745,"_2389":41914},[],"The generated `LoadBalancer` Service has a usable external address.",{"_2862":321,"_25248":254,"_17581":41916,"_5":17476,"_23883":41745,"_2389":41917},[],"Port 443 reaches that address from the client network.",{"_2862":322,"_25248":254,"_17581":41919,"_5":17476,"_23883":41745,"_2389":41920},[],"DNS resolves to the externally reachable endpoint.",{"_2862":323,"_25248":254,"_17581":41922,"_5":17476,"_23883":41745,"_2389":41923},[],"The certificate contains the DNS name or IP used by the client.",{"_2862":324,"_25248":254,"_17581":41925,"_5":17476,"_23883":41745,"_2389":41926},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_2862":325,"_25248":325,"_5":12326,"_2389":41068,"_25584":41928,"_17581":41929,"_23883":325},[40961,40962,41068],[],{"_2862":326,"_25248":325,"_17581":41931,"_5":17476,"_23883":325,"_2389":41932},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_2862":327,"_25248":325,"_5":25581,"_17581":41934,"_23883":41935,"_2389":41936},[],"/docs/pr-preview/pr-45/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_2862":328,"_25248":325,"_5":25581,"_17581":41938,"_23883":41939,"_2389":41940},[],"/docs/pr-preview/pr-45/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_2862":329,"_25248":325,"_5":25581,"_17581":41942,"_23883":41943,"_2389":41944},[],"/docs/pr-preview/pr-45/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_2862":330,"_25248":325,"_5":25581,"_17581":41946,"_23883":41947,"_2389":41948},[],"/docs/pr-preview/pr-45/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_2862":331,"_25248":325,"_5":25581,"_17581":41950,"_23883":41951,"_2389":41952},[],"/docs/pr-preview/pr-45/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_2862":332,"_25248":325,"_5":25581,"_17581":41954,"_23883":41955,"_2389":41956},[],"/docs/pr-preview/pr-45/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_2862":333,"_25248":325,"_17581":41958,"_5":17476,"_23883":41935,"_2389":41959},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_2862":334,"_25248":325,"_17581":41961,"_5":17476,"_23883":41939,"_2389":41962},[],"Workflow",{"_2862":335,"_25248":325,"_17581":41964,"_5":17476,"_23883":41939,"_2389":41965},[],"Use it for",{"_2862":336,"_25248":325,"_17581":41967,"_5":17476,"_23883":41939,"_2389":41968},[],"What it installs",{"_2862":337,"_25248":325,"_17581":41970,"_5":17476,"_23883":41939,"_2389":41971},[],"Helm",{"_2862":338,"_25248":325,"_17581":41973,"_5":17476,"_23883":41939,"_2389":41974},[],"Production and controlled environments",{"_2862":339,"_25248":325,"_17581":41976,"_5":17476,"_23883":41939,"_2389":41977},[],"Lamassu services and Gateway API resources",{"_2862":340,"_25248":325,"_17581":41979,"_5":17476,"_23883":41939,"_2389":41205},[],{"_2862":341,"_25248":325,"_17581":41981,"_5":17476,"_23883":41939,"_2389":41982},[],"Evaluation, demos, CI and small lab clusters",{"_2862":342,"_25248":325,"_17581":41984,"_5":17476,"_23883":41939,"_2389":41985},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_2862":343,"_25248":325,"_17581":41987,"_5":17476,"_23883":41943,"_2389":41988},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_2862":344,"_25248":325,"_17581":41990,"_5":17476,"_23883":41943,"_2389":41991},[],"Area",{"_2862":345,"_25248":325,"_17581":41993,"_5":17476,"_23883":41943,"_2389":41994},[],"The Lamassu chart provides",{"_2862":346,"_25248":325,"_17581":41996,"_5":17476,"_23883":41943,"_2389":41997},[],"You provide",{"_2862":347,"_25248":325,"_17581":41999,"_5":17476,"_23883":41943,"_2389":42000},[],"Lamassu applications",{"_2862":348,"_25248":325,"_17581":42002,"_5":17476,"_23883":41943,"_2389":42003},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_2862":349,"_25248":325,"_17581":42005,"_5":17476,"_23883":41943,"_2389":42006},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_2862":350,"_25248":325,"_17581":42008,"_5":17476,"_23883":41943,"_2389":42009},[],"PostgreSQL data",{"_2862":351,"_25248":325,"_17581":42011,"_5":17476,"_23883":41943,"_2389":42012},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_2862":352,"_25248":325,"_17581":42014,"_5":17476,"_23883":41943,"_2389":42015},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_2862":353,"_25248":325,"_17581":42017,"_5":17476,"_23883":41943,"_2389":42018},[],"Messaging",{"_2862":354,"_25248":325,"_17581":42020,"_5":17476,"_23883":41943,"_2389":42021},[],"RabbitMQ connection configuration for the Lamassu services",{"_2862":355,"_25248":325,"_17581":42023,"_5":17476,"_23883":41943,"_2389":42024},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_2862":356,"_25248":325,"_17581":42026,"_5":17476,"_23883":41943,"_2389":42027},[],"Identity",{"_2862":357,"_25248":325,"_17581":42029,"_5":17476,"_23883":41943,"_2389":42030},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_2862":358,"_25248":325,"_17581":42032,"_5":17476,"_23883":41943,"_2389":42033},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_2862":359,"_25248":325,"_17581":42035,"_5":17476,"_23883":41943,"_2389":42036},[],"External routing",{"_2862":360,"_25248":325,"_17581":42038,"_5":17476,"_23883":41943,"_2389":42039},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_2862":361,"_25248":325,"_17581":42041,"_5":17476,"_23883":41943,"_2389":42042},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_2862":362,"_25248":325,"_17581":42044,"_5":17476,"_23883":41943,"_2389":42045},[],"TLS",{"_2862":363,"_25248":325,"_17581":42047,"_5":17476,"_23883":41943,"_2389":42048},[],"cert-manager `Issuer` and CA `Certificate` resources; either a chart-managed downstream `Certificate` or a reference to your TLS Secret",{"_2862":364,"_25248":325,"_17581":42050,"_5":17476,"_23883":41943,"_2389":42051},[],"cert-manager itself; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_2862":365,"_25248":325,"_17581":42053,"_5":17476,"_23883":41943,"_2389":42054},[],"Persistent application data",{"_2862":366,"_25248":325,"_17581":42056,"_5":17476,"_23883":41943,"_2389":42057},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_2862":367,"_25248":325,"_17581":42059,"_5":17476,"_23883":41943,"_2389":42060},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_2862":368,"_25248":325,"_17581":42062,"_5":17476,"_23883":41943,"_2389":42063},[],"Optional integrations",{"_2862":369,"_25248":325,"_17581":42065,"_5":17476,"_23883":41943,"_2389":42066},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_2862":370,"_25248":325,"_17581":42068,"_5":17476,"_23883":41943,"_2389":42069},[],"The observability backends, cloud credentials and production HSM or external key service",{"_2862":371,"_25248":325,"_17581":42071,"_5":17476,"_23883":41943,"_2389":42072},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_2862":372,"_25248":325,"_17581":42074,"_5":17476,"_23883":41943,"_2389":42075},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_2862":373,"_25248":325,"_17581":42077,"_5":17476,"_23883":41947,"_2389":42078},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_2862":374,"_25248":325,"_17581":42080,"_5":17476,"_23883":41947,"_2389":42081},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_2862":375,"_25248":325,"_17581":42083,"_5":17476,"_23883":41951,"_2389":42084},[],"Kubernetes 1.24 or newer",{"_2862":376,"_25248":325,"_17581":42086,"_5":17476,"_23883":41951,"_2389":42087},[],"Helm 3.2 or newer",{"_2862":377,"_25248":325,"_17581":42089,"_5":17476,"_23883":41951,"_2389":42090},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_2862":378,"_25248":325,"_17581":42092,"_5":17476,"_23883":41951,"_2389":42093},[],"cert-manager 1.14 or newer; the current chart renders cert-manager issuer and certificate resources",{"_2862":379,"_25248":325,"_17581":42095,"_5":17476,"_23883":41951,"_2389":42096},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_2862":380,"_25248":325,"_17581":42098,"_5":17476,"_23883":41951,"_2389":42099},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_2862":381,"_25248":325,"_17581":42101,"_5":17476,"_23883":41951,"_2389":42102},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer.",{"_2862":382,"_25248":325,"_17581":42104,"_5":17476,"_23883":41955,"_2389":42105},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2862":383,"_25248":325,"_17581":42107,"_5":17476,"_23883":41955,"_2389":42108},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2862":384,"_25248":325,"_17581":42110,"_5":17476,"_23883":41955,"_2389":42111},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2862":385,"_25248":385,"_5":12326,"_2389":42113,"_25584":42114,"_17581":42116,"_23883":385},"Deployment troubleshooting",[40961,40962,42115],"Operations",[],{"_2862":386,"_25248":385,"_17581":42118,"_5":17476,"_23883":385,"_2389":42119},[],"Diagnose access, service health and infrastructure dependencies.",{"_2862":387,"_25248":385,"_5":25581,"_17581":42121,"_23883":42122,"_2389":42123},[],"/docs/pr-preview/pr-45/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_2862":388,"_25248":385,"_5":25581,"_17581":42125,"_23883":42126,"_2389":42127},[],"/docs/pr-preview/pr-45/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_2862":389,"_25248":385,"_5":25581,"_17581":42129,"_23883":42130,"_2389":42131},[],"/docs/pr-preview/pr-45/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_2862":390,"_25248":385,"_5":25581,"_17581":42133,"_23883":42134,"_2389":42135},[],"/docs/pr-preview/pr-45/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_2862":391,"_25248":385,"_5":25581,"_17581":42137,"_23883":42138,"_2389":42139},[],"/docs/pr-preview/pr-45/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_2862":392,"_25248":385,"_5":25581,"_17581":42141,"_23883":42142,"_2389":42143},[],"/docs/pr-preview/pr-45/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_2862":393,"_25248":385,"_5":25581,"_17581":42145,"_23883":42146,"_2389":42147},[],"/docs/pr-preview/pr-45/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_2862":394,"_25248":385,"_5":25581,"_17581":42149,"_23883":42150,"_2389":42151},[],"/docs/pr-preview/pr-45/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_2862":395,"_25248":385,"_5":25581,"_17581":42153,"_23883":42154,"_2389":42155},[],"/docs/pr-preview/pr-45/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_2862":396,"_25248":385,"_5":25581,"_17581":42157,"_23883":42158,"_2389":42159},[],"/docs/pr-preview/pr-45/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_2862":397,"_25248":385,"_5":25581,"_17581":42161,"_23883":42162,"_2389":42163},[],"/docs/pr-preview/pr-45/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_2862":398,"_25248":385,"_5":25581,"_17581":42165,"_23883":42166,"_2389":42167},[],"/docs/pr-preview/pr-45/deployment/troubleshooting#observability","Observability",{"_2862":399,"_25248":385,"_17581":42169,"_5":17476,"_23883":385,"_2389":42170},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_2862":400,"_25248":385,"_17581":42172,"_5":17476,"_23883":42126,"_2389":42173},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_2862":401,"_25248":385,"_17581":42175,"_5":17476,"_23883":42130,"_2389":42176},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_2862":402,"_25248":385,"_17581":42178,"_5":17476,"_23883":42134,"_2389":42179},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_2862":403,"_25248":385,"_17581":42181,"_5":17476,"_23883":42138,"_2389":42182},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_2862":404,"_25248":385,"_17581":42184,"_5":17476,"_23883":42142,"_2389":42185},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_2862":405,"_25248":385,"_17581":42187,"_5":17476,"_23883":42146,"_2389":42188},[],"Replace the placeholders with your real release, namespace and deployment.",{"_2862":406,"_25248":385,"_17581":42190,"_5":17476,"_23883":42146,"_2389":42191},[],"Also run the chart's connectivity test:",{"_2862":407,"_25248":385,"_17581":42193,"_5":17476,"_23883":42146,"_2389":42194},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_2862":408,"_25248":385,"_17581":42196,"_5":17476,"_23883":42146,"_2389":42197},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_2862":409,"_25248":385,"_17581":42199,"_5":17476,"_23883":42150,"_2389":42200},[],"If you receive a 401:",{"_2862":410,"_25248":385,"_17581":42202,"_5":17476,"_23883":42150,"_2389":42203},[],"check that the UI's OIDC authority is reachable from the browser;",{"_2862":411,"_25248":385,"_17581":42205,"_5":17476,"_23883":42150,"_2389":42206},[],"verify issuer, audience and expiration of the token;",{"_2862":412,"_25248":385,"_17581":42208,"_5":17476,"_23883":42150,"_2389":42209},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_2862":413,"_25248":385,"_17581":42211,"_5":17476,"_23883":42150,"_2389":42212},[],"check that the provider's public and internal routes point to the same realm.",{"_2862":414,"_25248":385,"_17581":42214,"_5":17476,"_23883":42150,"_2389":42215},[],"If login succeeds but the APIs return 403:",{"_2862":415,"_25248":385,"_17581":42217,"_5":17476,"_23883":42150,"_2389":42218},[],"inspect the token's real claims;",{"_2862":416,"_25248":385,"_17581":42220,"_5":17476,"_23883":42150,"_2389":42221},[],"confirm they match an active principal;",{"_2862":417,"_25248":385,"_17581":42223,"_5":17476,"_23883":42150,"_2389":42224},[],"review the policies granted to that principal;",{"_2862":418,"_25248":385,"_17581":42226,"_5":17476,"_23883":42150,"_2389":42227},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_2862":419,"_25248":385,"_17581":42229,"_5":17476,"_23883":42150,"_2389":42230},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_2862":420,"_25248":385,"_17581":42232,"_5":17476,"_23883":42154,"_2389":42233},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_2862":421,"_25248":385,"_17581":42235,"_5":17476,"_23883":42154,"_2389":42236},[],"Locate the authz pod and Service.",{"_2862":422,"_25248":385,"_17581":42238,"_5":17476,"_23883":42154,"_2389":42239},[],"Check /health, logs and its database connection.",{"_2862":423,"_25248":385,"_17581":42241,"_5":17476,"_23883":42154,"_2389":42242},[],"Verify the DNS and port configured in externalAuthorization.",{"_2862":424,"_25248":385,"_17581":42244,"_5":17476,"_23883":42154,"_2389":42245},[],"Check the check route is /v1/ext\\_authz/check.",{"_2862":425,"_25248":385,"_17581":42247,"_5":17476,"_23883":42154,"_2389":42248},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_2862":426,"_25248":385,"_17581":42250,"_5":17476,"_23883":42158,"_2389":42251},[],"Review kubectl describe pod first. Common causes are:",{"_2862":427,"_25248":385,"_17581":42253,"_5":17476,"_23883":42158,"_2389":42254},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_2862":428,"_25248":385,"_17581":42256,"_5":17476,"_23883":42158,"_2389":42257},[],"unbound persistent volume;",{"_2862":429,"_25248":385,"_17581":42259,"_5":17476,"_23883":42158,"_2389":42260},[],"inaccessible image or incorrect pull policy;",{"_2862":430,"_25248":385,"_17581":42262,"_5":17476,"_23883":42158,"_2389":42263},[],"invalid cryptographic engine configuration;",{"_2862":431,"_25248":385,"_17581":42265,"_5":17476,"_23883":42158,"_2389":42266},[],"CPU or memory limits set too low;",{"_2862":432,"_25248":385,"_17581":42268,"_5":17476,"_23883":42158,"_2389":42269},[],"an incomplete prior migration.",{"_2862":433,"_25248":385,"_17581":42271,"_5":17476,"_23883":42158,"_2389":42272},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_2862":434,"_25248":385,"_17581":42274,"_5":17476,"_23883":42158,"_2389":42275},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_2862":435,"_25248":385,"_17581":42277,"_5":17476,"_23883":42162,"_2389":42278},[],"Domain and audit events depend on the bus publisher:",{"_2862":436,"_25248":385,"_17581":42280,"_5":17476,"_23883":42162,"_2389":42281},[],"verify it is enabled in the emitting service;",{"_2862":437,"_25248":385,"_17581":42283,"_5":17476,"_23883":42162,"_2389":42284},[],"check AMQP connectivity and credentials;",{"_2862":438,"_25248":385,"_17581":42286,"_5":17476,"_23883":42162,"_2389":42287},[],"review exchange, routing key, queues and consumers;",{"_2862":439,"_25248":385,"_17581":42289,"_5":17476,"_23883":42162,"_2389":42290},[],"inspect dead-letter queues;",{"_2862":440,"_25248":385,"_17581":42292,"_5":17476,"_23883":42162,"_2389":42293},[],"alert on orphan durable queues and backlog growth.",{"_2862":441,"_25248":385,"_17581":42295,"_5":17476,"_23883":42162,"_2389":42296},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_2862":442,"_25248":385,"_17581":42298,"_5":17476,"_23883":42166,"_2389":42299},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_2862":443,"_25248":385,"_17581":42301,"_5":17476,"_23883":42166,"_2389":42302},[],"Before closing an incident, record:",{"_2862":444,"_25248":385,"_17581":42304,"_5":17476,"_23883":42166,"_2389":42305},[],"the confirmed cause;",{"_2862":445,"_25248":385,"_17581":42307,"_5":17476,"_23883":42166,"_2389":42308},[],"the time scope and affected resources;",{"_2862":446,"_25248":385,"_17581":42310,"_5":17476,"_23883":42166,"_2389":42311},[],"the commands or queries used;",{"_2862":447,"_25248":385,"_17581":42313,"_5":17476,"_23883":42166,"_2389":42314},[],"the applied change and how to revert it;",{"_2862":448,"_25248":385,"_17581":42316,"_5":17476,"_23883":42166,"_2389":42317},[],"validation from a consumer;",{"_2862":449,"_25248":385,"_17581":42319,"_5":17476,"_23883":42166,"_2389":42320},[],"the preventive action and its owner.",{"_2862":450,"_25248":450,"_5":12326,"_2389":42322,"_25584":42323,"_17581":42326,"_23883":450},"Access control",[40961,42324,42325],"Platform","Administration",[],{"_2862":451,"_25248":450,"_17581":42328,"_5":17476,"_23883":450,"_2389":42329},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_2862":452,"_25248":450,"_5":25581,"_17581":42331,"_23883":42332,"_2389":42333},[],"/docs/pr-preview/pr-45/platform/administration/access-control#essential-concepts","Essential concepts",{"_2862":453,"_25248":450,"_5":25581,"_17581":42335,"_23883":42336,"_2389":42337},[],"/docs/pr-preview/pr-45/platform/administration/access-control#two-decision-systems","Two decision systems",{"_2862":454,"_25248":450,"_5":25581,"_17581":42339,"_23883":42340,"_2389":42341},[],"/docs/pr-preview/pr-45/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_2862":455,"_25248":450,"_5":25581,"_17581":42343,"_23883":42344,"_2389":42345},[],"/docs/pr-preview/pr-45/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_2862":456,"_25248":450,"_5":25581,"_17581":42347,"_23883":42348,"_2389":42349},[],"/docs/pr-preview/pr-45/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_2862":457,"_25248":450,"_5":25581,"_17581":42351,"_23883":42352,"_2389":42353},[],"/docs/pr-preview/pr-45/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_2862":458,"_25248":450,"_5":25581,"_17581":42355,"_23883":42356,"_2389":42357},[],"/docs/pr-preview/pr-45/platform/administration/access-control#oidc-principals","OIDC principals",{"_2862":459,"_25248":450,"_5":25581,"_17581":42359,"_23883":42360,"_2389":42361},[],"/docs/pr-preview/pr-45/platform/administration/access-control#x509-principals","X.509 principals",{"_2862":460,"_25248":450,"_5":25581,"_17581":42363,"_23883":42364,"_2389":42365},[],"/docs/pr-preview/pr-45/platform/administration/access-control#when-several-principals-match","When several principals match",{"_2862":461,"_25248":450,"_5":25581,"_17581":42367,"_23883":42368,"_2389":42369},[],"/docs/pr-preview/pr-45/platform/administration/access-control#how-policies-express-access","How policies express access",{"_2862":462,"_25248":450,"_5":25581,"_17581":42371,"_23883":42372,"_2389":42373},[],"/docs/pr-preview/pr-45/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_2862":463,"_25248":450,"_5":25581,"_17581":42375,"_23883":42376,"_2389":42377},[],"/docs/pr-preview/pr-45/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_2862":464,"_25248":450,"_5":25581,"_17581":42379,"_23883":42380,"_2389":42381},[],"/docs/pr-preview/pr-45/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_2862":465,"_25248":450,"_5":25581,"_17581":42383,"_23883":42384,"_2389":42385},[],"/docs/pr-preview/pr-45/platform/administration/access-control#http-rules","HTTP rules",{"_2862":466,"_25248":450,"_5":25581,"_17581":42387,"_23883":42388,"_2389":42389},[],"/docs/pr-preview/pr-45/platform/administration/access-control#included-policies","Included policies",{"_2862":467,"_25248":450,"_5":25581,"_17581":42391,"_23883":42392,"_2389":41564},[],"/docs/pr-preview/pr-45/platform/administration/access-control#provision-the-first-administrator",{"_2862":468,"_25248":450,"_5":25581,"_17581":42394,"_23883":42395,"_2389":42396},[],"/docs/pr-preview/pr-45/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_2862":469,"_25248":450,"_5":25581,"_17581":42398,"_23883":42399,"_2389":42400},[],"/docs/pr-preview/pr-45/platform/administration/access-control#configure-the-two-jwt-validations","Configure the two JWT validations",{"_2862":470,"_25248":450,"_5":25581,"_17581":42402,"_23883":42403,"_2389":42404},[],"/docs/pr-preview/pr-45/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_2862":471,"_25248":450,"_5":25581,"_17581":42406,"_23883":42407,"_2389":42408},[],"/docs/pr-preview/pr-45/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_2862":472,"_25248":450,"_5":25581,"_17581":42410,"_23883":42411,"_2389":42412},[],"/docs/pr-preview/pr-45/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_2862":473,"_25248":450,"_5":25581,"_17581":42414,"_23883":42415,"_2389":42416},[],"/docs/pr-preview/pr-45/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_2862":474,"_25248":450,"_5":25581,"_17581":42418,"_23883":42419,"_2389":42420},[],"/docs/pr-preview/pr-45/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_2862":475,"_25248":450,"_5":25581,"_17581":42422,"_23883":42423,"_2389":42424},[],"/docs/pr-preview/pr-45/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_2862":476,"_25248":450,"_5":25581,"_17581":42426,"_23883":42427,"_2389":42428},[],"/docs/pr-preview/pr-45/platform/administration/access-control#operational-checklist","Operational checklist",{"_2862":477,"_25248":450,"_5":25581,"_17581":42430,"_23883":42431,"_2389":42432},[],"/docs/pr-preview/pr-45/platform/administration/access-control#diagnostics","Diagnostics",{"_2862":478,"_25248":450,"_5":25581,"_17581":42434,"_23883":42435,"_2389":42436},[],"/docs/pr-preview/pr-45/platform/administration/access-control#the-response-is-401","The response is 401",{"_2862":479,"_25248":450,"_5":25581,"_17581":42438,"_23883":42439,"_2389":42440},[],"/docs/pr-preview/pr-45/platform/administration/access-control#the-response-is-403","The response is 403",{"_2862":480,"_25248":450,"_5":25581,"_17581":42442,"_23883":42443,"_2389":42444},[],"/docs/pr-preview/pr-45/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_2862":481,"_25248":450,"_5":25581,"_17581":42446,"_23883":42447,"_2389":42448},[],"/docs/pr-preview/pr-45/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_2862":482,"_25248":450,"_5":25581,"_17581":42450,"_23883":42451,"_2389":42452},[],"/docs/pr-preview/pr-45/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_2862":483,"_25248":450,"_17581":42454,"_5":17476,"_23883":450,"_2389":42455},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_2862":484,"_25248":450,"_17581":42457,"_5":17476,"_23883":450,"_2389":42458},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_2862":485,"_25248":450,"_17581":42460,"_5":17476,"_23883":450,"_2389":42461},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_2862":486,"_25248":450,"_17581":42463,"_5":17476,"_23883":42332,"_2389":42464},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_2862":487,"_25248":450,"_17581":42466,"_5":17476,"_23883":42332,"_2389":42467},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_2862":488,"_25248":450,"_17581":42469,"_5":17476,"_23883":42332,"_2389":42470},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_2862":489,"_25248":450,"_17581":42472,"_5":17476,"_23883":42332,"_2389":42473},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_2862":490,"_25248":450,"_17581":42475,"_5":17476,"_23883":42332,"_2389":42476},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_2862":491,"_25248":450,"_17581":42478,"_5":17476,"_23883":42332,"_2389":42479},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_2862":492,"_25248":450,"_17581":42481,"_5":17476,"_23883":42336,"_2389":42482},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_2862":493,"_25248":450,"_17581":42484,"_5":17476,"_23883":42336,"_2389":42485},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_2862":494,"_25248":450,"_17581":42487,"_5":17476,"_23883":42340,"_2389":42488},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_2862":495,"_25248":450,"_17581":42490,"_5":17476,"_23883":42340,"_2389":42491},[],"The decision is made **before forwarding the request to the service**:",{"_2862":496,"_25248":450,"_17581":42493,"_5":17476,"_23883":42340,"_2389":42494},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_2862":497,"_25248":450,"_17581":42496,"_5":17476,"_23883":42340,"_2389":42497},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_2862":498,"_25248":450,"_17581":42499,"_5":17476,"_23883":42340,"_2389":42500},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_2862":499,"_25248":450,"_17581":42502,"_5":17476,"_23883":42340,"_2389":42503},[],"It separately loads the policies granted to each principal.",{"_2862":500,"_25248":450,"_17581":42505,"_5":17476,"_23883":42340,"_2389":42506},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_2862":501,"_25248":450,"_17581":42508,"_5":17476,"_23883":42340,"_2389":42509},[],"`authz` looks for an HTTP rule granting that action.",{"_2862":502,"_25248":450,"_17581":42511,"_5":17476,"_23883":42340,"_2389":42512},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_2862":503,"_25248":450,"_17581":42514,"_5":17476,"_23883":42340,"_2389":42515},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_2862":504,"_25248":450,"_17581":42517,"_5":17476,"_23883":42340,"_2389":42518},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_2862":505,"_25248":450,"_17581":42520,"_5":17476,"_23883":42340,"_2389":42521},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_2862":506,"_25248":450,"_17581":42523,"_5":17476,"_23883":42344,"_2389":42524},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_2862":507,"_25248":450,"_17581":42526,"_5":17476,"_23883":42344,"_2389":42527},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_2862":508,"_25248":450,"_17581":42529,"_5":17476,"_23883":42344,"_2389":42530},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_2862":509,"_25248":450,"_17581":42532,"_5":17476,"_23883":42344,"_2389":42533},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_2862":510,"_25248":450,"_17581":42535,"_5":17476,"_23883":42344,"_2389":42536},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_2862":511,"_25248":450,"_17581":42538,"_5":17476,"_23883":42344,"_2389":42539},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_2862":512,"_25248":450,"_17581":42541,"_5":17476,"_23883":42344,"_2389":42542},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_2862":513,"_25248":450,"_17581":42544,"_5":17476,"_23883":42344,"_2389":42545},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_2862":514,"_25248":450,"_17581":42547,"_5":17476,"_23883":42348,"_2389":42548},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_2862":515,"_25248":450,"_17581":42550,"_5":17476,"_23883":42348,"_2389":42551},[],"The decision is made with the domain operation context:",{"_2862":516,"_25248":450,"_17581":42553,"_5":17476,"_23883":42348,"_2389":42554},[],"The middleware extracts the credential and resolves the matching principals.",{"_2862":517,"_25248":450,"_17581":42556,"_5":17476,"_23883":42348,"_2389":42557},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_2862":518,"_25248":450,"_17581":42559,"_5":17476,"_23883":42348,"_2389":42560},[],"`authz` gathers the entity rules of the granted policies.",{"_2862":519,"_25248":450,"_17581":42562,"_5":17476,"_23883":42348,"_2389":42563},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_2862":520,"_25248":450,"_17581":42565,"_5":17476,"_23883":42348,"_2389":42566},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_2862":521,"_25248":450,"_17581":42568,"_5":17476,"_23883":42348,"_2389":42569},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_2862":522,"_25248":450,"_17581":42571,"_5":17476,"_23883":42348,"_2389":42572},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_2862":523,"_25248":450,"_17581":42574,"_5":17476,"_23883":42348,"_2389":42575},[],"Actions fall into two groups:",{"_2862":524,"_25248":450,"_17581":42577,"_5":17476,"_23883":42348,"_2389":42578},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_2862":525,"_25248":450,"_17581":42580,"_5":17476,"_23883":42348,"_2389":42581},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_2862":526,"_25248":450,"_17581":42583,"_5":17476,"_23883":42348,"_2389":42584},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_2862":527,"_25248":450,"_17581":42586,"_5":17476,"_23883":42352,"_2389":42587},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_2862":528,"_25248":450,"_17581":42589,"_5":17476,"_23883":42352,"_2389":42590},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_2862":529,"_25248":450,"_17581":42592,"_5":17476,"_23883":42352,"_2389":42593},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_2862":530,"_25248":450,"_17581":42595,"_5":17476,"_23883":42356,"_2389":42596},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_2862":531,"_25248":450,"_17581":42598,"_5":17476,"_23883":42356,"_2389":42599},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_2862":532,"_25248":450,"_17581":42601,"_5":17476,"_23883":42356,"_2389":42602},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_2862":533,"_25248":450,"_17581":42604,"_5":17476,"_23883":42356,"_2389":42605},[],"The implemented operators are:",{"_2862":534,"_25248":450,"_17581":42607,"_5":17476,"_23883":42356,"_2389":42608},[],"`equals`, for exact equality;",{"_2862":535,"_25248":450,"_17581":42610,"_5":17476,"_23883":42356,"_2389":42611},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_2862":536,"_25248":450,"_17581":42613,"_5":17476,"_23883":42356,"_2389":42614},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_2862":537,"_25248":450,"_17581":42616,"_5":17476,"_23883":42356,"_2389":42617},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_2862":538,"_25248":450,"_17581":42619,"_5":17476,"_23883":42360,"_2389":42620},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_2862":539,"_25248":450,"_17581":42622,"_5":17476,"_23883":42360,"_2389":42623},[],"The available modes are:",{"_2862":540,"_25248":450,"_17581":42625,"_5":17476,"_23883":42360,"_2389":42626},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_2862":541,"_25248":450,"_17581":42628,"_5":17476,"_23883":42360,"_2389":42629},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_2862":542,"_25248":450,"_17581":42631,"_5":17476,"_23883":42360,"_2389":42632},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_2862":543,"_25248":450,"_17581":42634,"_5":17476,"_23883":42360,"_2389":42635},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_2862":544,"_25248":450,"_17581":42637,"_5":17476,"_23883":42360,"_2389":42638},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_2862":545,"_25248":450,"_17581":42640,"_5":17476,"_23883":42360,"_2389":42641},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_2862":546,"_25248":450,"_17581":42643,"_5":17476,"_23883":42364,"_2389":42644},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_2862":547,"_25248":450,"_17581":42646,"_5":17476,"_23883":42364,"_2389":42647},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_2862":548,"_25248":450,"_17581":42649,"_5":17476,"_23883":42364,"_2389":42650},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_2862":549,"_25248":450,"_17581":42652,"_5":17476,"_23883":42364,"_2389":42653},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_2862":550,"_25248":450,"_17581":42655,"_5":17476,"_23883":42372,"_2389":42656},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_2862":551,"_25248":450,"_17581":42658,"_5":17476,"_23883":42372,"_2389":42659},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_2862":552,"_25248":450,"_17581":42661,"_5":17476,"_23883":42376,"_2389":42662},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_2862":553,"_25248":450,"_17581":42664,"_5":17476,"_23883":42376,"_2389":42665},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_2862":554,"_25248":450,"_17581":42667,"_5":17476,"_23883":42380,"_2389":42668},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_2862":555,"_25248":450,"_17581":42670,"_5":17476,"_23883":42380,"_2389":42671},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_2862":556,"_25248":450,"_17581":42673,"_5":17476,"_23883":42380,"_2389":42674},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_2862":557,"_25248":450,"_17581":42676,"_5":17476,"_23883":42384,"_2389":42677},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_2862":558,"_25248":450,"_17581":42679,"_5":17476,"_23883":42384,"_2389":42680},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_2862":559,"_25248":450,"_17581":42682,"_5":17476,"_23883":42384,"_2389":42683},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_2862":560,"_25248":450,"_17581":42685,"_5":17476,"_23883":42384,"_2389":42686},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_2862":561,"_25248":450,"_17581":42688,"_5":17476,"_23883":42384,"_2389":42689},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_2862":562,"_25248":450,"_17581":42691,"_5":17476,"_23883":42384,"_2389":42692},[],"Note that:",{"_2862":563,"_25248":450,"_17581":42694,"_5":17476,"_23883":42384,"_2389":42695},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_2862":564,"_25248":450,"_17581":42697,"_5":17476,"_23883":42384,"_2389":42698},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_2862":565,"_25248":450,"_17581":42700,"_5":17476,"_23883":42384,"_2389":42701},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_2862":566,"_25248":450,"_17581":42703,"_5":17476,"_23883":42388,"_2389":42704},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_2862":567,"_25248":450,"_17581":42706,"_5":17476,"_23883":42388,"_2389":42707},[],"full and read-only access to certificates and authorities;",{"_2862":568,"_25248":450,"_17581":42709,"_5":17476,"_23883":42388,"_2389":42710},[],"full and read-only access to the KMS;",{"_2862":569,"_25248":450,"_17581":42712,"_5":17476,"_23883":42388,"_2389":42713},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_2862":570,"_25248":450,"_17581":42715,"_5":17476,"_23883":42388,"_2389":42716},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_2862":571,"_25248":450,"_17581":42718,"_5":17476,"_23883":42388,"_2389":42719},[],"console access;",{"_2862":572,"_25248":450,"_17581":42721,"_5":17476,"_23883":42388,"_2389":42722},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_2862":573,"_25248":450,"_17581":42724,"_5":17476,"_23883":42388,"_2389":42725},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_2862":574,"_25248":450,"_17581":42727,"_5":17476,"_23883":42388,"_2389":42728},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_2862":575,"_25248":450,"_17581":42730,"_5":17476,"_23883":42392,"_2389":42731},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_2862":576,"_25248":450,"_17581":42733,"_5":17476,"_23883":42392,"_2389":42734},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_2862":577,"_25248":450,"_17581":42736,"_5":17476,"_23883":42392,"_2389":42737},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_2862":578,"_25248":450,"_17581":42739,"_5":17476,"_23883":42395,"_2389":42740},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_2862":579,"_25248":450,"_17581":42742,"_5":17476,"_23883":42399,"_2389":42743},[],"The Gateway uses `auth.authentication.apiGateway.jwks` to authenticate requests. `authz` uses `services.authz.jwkUrl` to resolve OIDC principals. Both endpoints must contain the keys of the same issuer and be reachable from their respective components.",{"_2862":580,"_25248":450,"_17581":42745,"_5":17476,"_23883":42403,"_2389":42746},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_2862":581,"_25248":450,"_17581":42748,"_5":17476,"_23883":42407,"_2389":42749},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_2862":582,"_25248":450,"_17581":42751,"_5":17476,"_23883":42411,"_2389":42752},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_2862":583,"_25248":450,"_17581":42754,"_5":17476,"_23883":42415,"_2389":42755},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_2862":584,"_25248":450,"_17581":42757,"_5":17476,"_23883":42415,"_2389":42758},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_2862":585,"_25248":450,"_17581":42760,"_5":17476,"_23883":42419,"_2389":42761},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_2862":586,"_25248":450,"_17581":42763,"_5":17476,"_23883":42419,"_2389":42764},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_2862":587,"_25248":450,"_17581":42766,"_5":17476,"_23883":42419,"_2389":42767},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_2862":588,"_25248":450,"_17581":42769,"_5":17476,"_23883":42419,"_2389":42770},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_2862":589,"_25248":450,"_17581":42772,"_5":17476,"_23883":42419,"_2389":42773},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_2862":590,"_25248":450,"_17581":42775,"_5":17476,"_23883":42419,"_2389":42776},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_2862":591,"_25248":450,"_17581":42778,"_5":17476,"_23883":42419,"_2389":42779},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_2862":592,"_25248":450,"_17581":42781,"_5":17476,"_23883":42419,"_2389":42782},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_2862":593,"_25248":450,"_17581":42784,"_5":17476,"_23883":42423,"_2389":42785},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_2862":594,"_25248":450,"_17581":42787,"_5":17476,"_23883":42423,"_2389":42788},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_2862":595,"_25248":450,"_17581":42790,"_5":17476,"_23883":42423,"_2389":42791},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_2862":596,"_25248":450,"_17581":42793,"_5":17476,"_23883":42427,"_2389":42794},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_2862":597,"_25248":450,"_17581":42796,"_5":17476,"_23883":42427,"_2389":42797},[],"Use groups or stable roles for people and independent identities for automations.",{"_2862":598,"_25248":450,"_17581":42799,"_5":17476,"_23883":42427,"_2389":42800},[],"Keep at least two recovery administrators and test their access periodically.",{"_2862":599,"_25248":450,"_17581":42802,"_5":17476,"_23883":42427,"_2389":42803},[],"Review active principals, their matches and their grants after IdP changes.",{"_2862":600,"_25248":450,"_17581":42805,"_5":17476,"_23883":42427,"_2389":42806},[],"Search for wildcards in policies before upgrading Lamassu.",{"_2862":601,"_25248":450,"_17581":42808,"_5":17476,"_23883":42427,"_2389":42809},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_2862":602,"_25248":450,"_17581":42811,"_5":17476,"_23883":42427,"_2389":42812},[],"Always test one allowed and one denied operation for each role.",{"_2862":603,"_25248":450,"_17581":42814,"_5":17476,"_23883":42427,"_2389":42815},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_2862":604,"_25248":450,"_17581":42817,"_5":17476,"_23883":42435,"_2389":42818},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_2862":605,"_25248":450,"_17581":42820,"_5":17476,"_23883":42439,"_2389":42821},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_2862":606,"_25248":450,"_17581":42823,"_5":17476,"_23883":42439,"_2389":42824},[],"that an active principal of the correct type exists;",{"_2862":607,"_25248":450,"_17581":42826,"_5":17476,"_23883":42439,"_2389":42827},[],"that the claim paths and values match the real token exactly;",{"_2862":608,"_25248":450,"_17581":42829,"_5":17476,"_23883":42439,"_2389":42830},[],"that all of the principal's conditions hold;",{"_2862":609,"_25248":450,"_17581":42832,"_5":17476,"_23883":42439,"_2389":42833},[],"that the principal has the expected policy granted;",{"_2862":610,"_25248":450,"_17581":42835,"_5":17476,"_23883":42439,"_2389":42836},[],"that the policy includes the action and the requested resource type or route;",{"_2862":611,"_25248":450,"_17581":42838,"_5":17476,"_23883":42439,"_2389":42839},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_2862":612,"_25248":450,"_17581":42841,"_5":17476,"_23883":42439,"_2389":42842},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_2862":613,"_25248":450,"_17581":42844,"_5":17476,"_23883":42443,"_2389":42845},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_2862":614,"_25248":450,"_17581":42847,"_5":17476,"_23883":42447,"_2389":42848},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_2862":615,"_25248":450,"_17581":42850,"_5":17476,"_23883":42451,"_2389":42851},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_2862":616,"_25248":450,"_17581":42853,"_5":17476,"_23883":42451,"_2389":42854},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_2862":617,"_25248":617,"_5":12326,"_2389":42856,"_25584":42857,"_17581":42858,"_23883":617},"Alerts and subscriptions",[40961,42324,42325],[],{"_2862":618,"_25248":617,"_17581":42860,"_5":17476,"_23883":617,"_2389":42861},[],"Send PKI events to people and external systems.",{"_2862":619,"_25248":617,"_5":25581,"_17581":42863,"_23883":42864,"_2389":42865},[],"/docs/pr-preview/pr-45/platform/administration/alerts#how-it-works","How it works",{"_2862":620,"_25248":617,"_5":25581,"_17581":42867,"_23883":42868,"_2389":42869},[],"/docs/pr-preview/pr-45/platform/administration/alerts#available-channels","Available channels",{"_2862":621,"_25248":617,"_5":25581,"_17581":42871,"_23883":42872,"_2389":42873},[],"/docs/pr-preview/pr-45/platform/administration/alerts#create-a-subscription","Create a subscription",{"_2862":622,"_25248":617,"_5":25581,"_17581":42875,"_23883":42876,"_2389":42877},[],"/docs/pr-preview/pr-45/platform/administration/alerts#choose-the-event","Choose the event",{"_2862":623,"_25248":617,"_5":25581,"_17581":42879,"_23883":42880,"_2389":42881},[],"/docs/pr-preview/pr-45/platform/administration/alerts#configure-the-destination","Configure the destination",{"_2862":624,"_25248":617,"_5":25581,"_17581":42883,"_23883":42884,"_2389":42885},[],"/docs/pr-preview/pr-45/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_2862":625,"_25248":617,"_5":25581,"_17581":42887,"_23883":42888,"_2389":42889},[],"/docs/pr-preview/pr-45/platform/administration/alerts#review-and-activate","Review and activate",{"_2862":626,"_25248":617,"_5":25581,"_17581":42891,"_23883":42892,"_2389":42893},[],"/docs/pr-preview/pr-45/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_2862":627,"_25248":617,"_5":25581,"_17581":42895,"_23883":42896,"_2389":42897},[],"/docs/pr-preview/pr-45/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_2862":628,"_25248":617,"_5":25581,"_17581":42899,"_23883":42900,"_2389":42901},[],"/docs/pr-preview/pr-45/platform/administration/alerts#event-families","Event families",{"_2862":629,"_25248":617,"_17581":42903,"_5":17476,"_23883":617,"_2389":42904},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_2862":630,"_25248":617,"_17581":42906,"_5":17476,"_23883":42864,"_2389":42907},[],"A service publishes a domain event.",{"_2862":631,"_25248":617,"_17581":42909,"_5":17476,"_23883":42864,"_2389":42910},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_2862":632,"_25248":617,"_17581":42912,"_5":17476,"_23883":42864,"_2389":42913},[],"Each subscription's filter decides whether it should be notified.",{"_2862":633,"_25248":617,"_17581":42915,"_5":17476,"_23883":42864,"_2389":42916},[],"Lamassu delivers the event to the configured channel.",{"_2862":634,"_25248":617,"_17581":42918,"_5":17476,"_23883":42864,"_2389":42919},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_2862":635,"_25248":617,"_17581":42921,"_5":17476,"_23883":42868,"_2389":42922},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_2862":636,"_25248":617,"_17581":42924,"_5":17476,"_23883":42868,"_2389":42925},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_2862":637,"_25248":617,"_17581":42927,"_5":17476,"_23883":42868,"_2389":42928},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_2862":638,"_25248":617,"_17581":42930,"_5":17476,"_23883":42868,"_2389":42931},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_2862":639,"_25248":617,"_17581":42933,"_5":17476,"_23883":42868,"_2389":42934},[],"`apikey_options` requires `header` and `key`.",{"_2862":640,"_25248":617,"_17581":42936,"_5":17476,"_23883":42868,"_2389":42937},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_2862":641,"_25248":617,"_17581":42939,"_5":17476,"_23883":42868,"_2389":42940},[],"`mtls_options` requires the inline PEM `cert_content` and `key_content`; values that reference files on the server are rejected.",{"_2862":642,"_25248":617,"_17581":42942,"_5":17476,"_23883":42868,"_2389":42943},[],"The alerts API reference documents the full `http_client` schema.",{"_2862":643,"_25248":617,"_17581":42945,"_5":17476,"_23883":42876,"_2389":42946},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_2862":644,"_25248":617,"_17581":42948,"_5":17476,"_23883":42880,"_2389":42949},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_2862":645,"_25248":617,"_17581":42951,"_5":17476,"_23883":42884,"_2389":42952},[],"Add a filter if you don't want to receive every instance of the event.",{"_2862":646,"_25248":617,"_17581":42954,"_5":17476,"_23883":42884,"_2389":42955},[],"**None** notifies all instances of the event.",{"_2862":647,"_25248":617,"_17581":42957,"_5":17476,"_23883":42884,"_2389":42958},[],"**JSON Path** evaluates one or more specific fields.",{"_2862":648,"_25248":617,"_17581":42960,"_5":17476,"_23883":42884,"_2389":42961},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_2862":649,"_25248":617,"_17581":42963,"_5":17476,"_23883":42884,"_2389":42964},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_2862":650,"_25248":617,"_17581":42966,"_5":17476,"_23883":42884,"_2389":42967},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_2862":651,"_25248":617,"_17581":42969,"_5":17476,"_23883":42888,"_2389":42970},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_2862":652,"_25248":617,"_17581":42972,"_5":17476,"_23883":42892,"_2389":42973},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_2862":653,"_25248":617,"_17581":42975,"_5":17476,"_23883":42892,"_2389":42976},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_2862":654,"_25248":617,"_17581":42978,"_5":17476,"_23883":42892,"_2389":42979},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_2862":655,"_25248":617,"_17581":42981,"_5":17476,"_23883":42892,"_2389":42982},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_2862":656,"_25248":617,"_17581":42984,"_5":17476,"_23883":42892,"_2389":42985},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_2862":657,"_25248":617,"_17581":42987,"_5":17476,"_23883":42892,"_2389":42988},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_2862":658,"_25248":617,"_17581":42990,"_5":17476,"_23883":42892,"_2389":42991},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_2862":659,"_25248":617,"_17581":42993,"_5":17476,"_23883":42892,"_2389":42994},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_2862":660,"_25248":617,"_17581":42996,"_5":17476,"_23883":42896,"_2389":42997},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_2862":661,"_25248":617,"_17581":42999,"_5":17476,"_23883":42900,"_2389":43000},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_2862":662,"_25248":617,"_17581":43002,"_5":17476,"_23883":42900,"_2389":43003},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_2862":663,"_25248":617,"_17581":43005,"_5":17476,"_23883":42900,"_2389":43006},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_2862":664,"_25248":617,"_17581":43008,"_5":17476,"_23883":42900,"_2389":43009},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_2862":665,"_25248":617,"_17581":43011,"_5":17476,"_23883":42900,"_2389":43012},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_2862":666,"_25248":617,"_17581":43014,"_5":17476,"_23883":42900,"_2389":43015},[],"**Validation:** `va.role.crl.create`.",{"_2862":667,"_25248":617,"_17581":43017,"_5":17476,"_23883":42900,"_2389":43018},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_2862":668,"_25248":617,"_17581":43020,"_5":17476,"_23883":42900,"_2389":43021},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_2862":669,"_25248":669,"_5":12326,"_2389":43023,"_25584":43024,"_17581":43025,"_23883":669},"Audit logs",[40961,42324,42325],[],{"_2862":670,"_25248":669,"_17581":43027,"_5":17476,"_23883":669,"_2389":43028},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_2862":671,"_25248":669,"_5":25581,"_17581":43030,"_23883":43031,"_2389":43032},[],"/docs/pr-preview/pr-45/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_2862":672,"_25248":669,"_5":25581,"_17581":43034,"_23883":43035,"_2389":43036},[],"/docs/pr-preview/pr-45/platform/administration/audit-logs#coverage","Coverage",{"_2862":673,"_25248":669,"_5":25581,"_17581":43038,"_23883":43039,"_2389":43040},[],"/docs/pr-preview/pr-45/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_2862":674,"_25248":669,"_5":25581,"_17581":43042,"_23883":43043,"_2389":43044},[],"/docs/pr-preview/pr-45/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_2862":675,"_25248":669,"_5":25581,"_17581":43046,"_23883":43047,"_2389":43048},[],"/docs/pr-preview/pr-45/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_2862":676,"_25248":669,"_5":25581,"_17581":43050,"_23883":43051,"_2389":43052},[],"/docs/pr-preview/pr-45/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_2862":677,"_25248":669,"_5":25581,"_17581":43054,"_23883":43055,"_2389":43056},[],"/docs/pr-preview/pr-45/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_2862":678,"_25248":669,"_5":25581,"_17581":43058,"_23883":43059,"_2389":43060},[],"/docs/pr-preview/pr-45/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_2862":679,"_25248":669,"_5":25581,"_17581":43062,"_23883":43063,"_2389":43064},[],"/docs/pr-preview/pr-45/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_2862":680,"_25248":669,"_5":25581,"_17581":43066,"_23883":43067,"_2389":43068},[],"/docs/pr-preview/pr-45/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_2862":681,"_25248":669,"_5":25581,"_17581":43070,"_23883":43071,"_2389":43072},[],"/docs/pr-preview/pr-45/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_2862":682,"_25248":669,"_17581":43074,"_5":17476,"_23883":669,"_2389":43075},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_2862":683,"_25248":669,"_17581":43077,"_5":17476,"_23883":43031,"_2389":43078},[],"The audit body includes:",{"_2862":684,"_25248":669,"_17581":43080,"_5":17476,"_23883":43031,"_2389":43081},[],"input: data received by the operation;",{"_2862":685,"_25248":669,"_17581":43083,"_5":17476,"_23883":43031,"_2389":43084},[],"has\\_error: whether the service returned an error;",{"_2862":686,"_25248":669,"_17581":43086,"_5":17476,"_23883":43031,"_2389":43087},[],"output: produced result or error message;",{"_2862":687,"_25248":669,"_17581":43089,"_5":17476,"_23883":43031,"_2389":43090},[],"principals: identifiers of the principals that matched the request.",{"_2862":688,"_25248":669,"_17581":43092,"_5":17476,"_23883":43031,"_2389":43093},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_2862":689,"_25248":669,"_17581":43095,"_5":17476,"_23883":43031,"_2389":43096},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_2862":690,"_25248":669,"_17581":43098,"_5":17476,"_23883":43035,"_2389":43099},[],"The backend applies auditing to mutations of:",{"_2862":691,"_25248":669,"_17581":43101,"_5":17476,"_23883":43035,"_2389":43102},[],"authorities, certificates and issuance profiles;",{"_2862":692,"_25248":669,"_17581":43104,"_5":17476,"_23883":43035,"_2389":43105},[],"keys and KMS engines;",{"_2862":693,"_25248":669,"_17581":43107,"_5":17476,"_23883":43035,"_2389":43108},[],"devices and identities;",{"_2862":694,"_25248":669,"_17581":43110,"_5":17476,"_23883":43035,"_2389":43111},[],"DMSs and enrollment operations;",{"_2862":695,"_25248":669,"_17581":43113,"_5":17476,"_23883":43035,"_2389":43114},[],"validation functions and CRL;",{"_2862":696,"_25248":669,"_17581":43116,"_5":17476,"_23883":43035,"_2389":43117},[],"principals, policies and authorization grants.",{"_2862":697,"_25248":669,"_17581":43119,"_5":17476,"_23883":43035,"_2389":43120},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_2862":698,"_25248":669,"_17581":43122,"_5":17476,"_23883":43039,"_2389":43123},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_2862":699,"_25248":669,"_17581":43125,"_5":17476,"_23883":43039,"_2389":43126},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_2862":700,"_25248":669,"_17581":43128,"_5":17476,"_23883":43039,"_2389":43129},[],"Design the consumer to:",{"_2862":701,"_25248":669,"_17581":43131,"_5":17476,"_23883":43039,"_2389":43132},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_2862":702,"_25248":669,"_17581":43134,"_5":17476,"_23883":43039,"_2389":43135},[],"keep the complete CloudEvent unmodified;",{"_2862":703,"_25248":669,"_17581":43137,"_5":17476,"_23883":43039,"_2389":43138},[],"record the ingestion time and detect duplicates by ID;",{"_2862":704,"_25248":669,"_17581":43140,"_5":17476,"_23883":43039,"_2389":43141},[],"encrypt in transit and at rest;",{"_2862":705,"_25248":669,"_17581":43143,"_5":17476,"_23883":43039,"_2389":43144},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_2862":706,"_25248":669,"_17581":43146,"_5":17476,"_23883":43039,"_2389":43147},[],"apply an explicit retention and legal hold policy;",{"_2862":707,"_25248":669,"_17581":43149,"_5":17476,"_23883":43039,"_2389":43150},[],"alert if it stops consuming or the pending queue grows.",{"_2862":708,"_25248":669,"_17581":43152,"_5":17476,"_23883":43043,"_2389":43153},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_2862":709,"_25248":669,"_17581":43155,"_5":17476,"_23883":43043,"_2389":43156},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_2862":710,"_25248":669,"_17581":43158,"_5":17476,"_23883":43051,"_2389":43159},[],"Start from the reported time and normalize every source to UTC.",{"_2862":711,"_25248":669,"_17581":43161,"_5":17476,"_23883":43055,"_2389":43162},[],"Filter by event type, service source and resource identifier.",{"_2862":712,"_25248":669,"_17581":43164,"_5":17476,"_23883":43059,"_2389":43165},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_2862":713,"_25248":669,"_17581":43167,"_5":17476,"_23883":43063,"_2389":43168},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_2862":714,"_25248":669,"_17581":43170,"_5":17476,"_23883":43067,"_2389":43171},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_2862":715,"_25248":669,"_17581":43173,"_5":17476,"_23883":43071,"_2389":43174},[],"Generate a controlled mutation in a test environment and check that:",{"_2862":716,"_25248":669,"_17581":43176,"_5":17476,"_23883":43071,"_2389":43177},[],"a successful audit event appears;",{"_2862":717,"_25248":669,"_17581":43179,"_5":17476,"_23883":43071,"_2389":43180},[],"the principal matches the identity used;",{"_2862":718,"_25248":669,"_17581":43182,"_5":17476,"_23883":43071,"_2389":43183},[],"the consumer persists it exactly once;",{"_2862":719,"_25248":669,"_17581":43185,"_5":17476,"_23883":43071,"_2389":43186},[],"it can be retrieved by resource, actor and period;",{"_2862":720,"_25248":669,"_17581":43188,"_5":17476,"_23883":43071,"_2389":43189},[],"a consumer outage raises an alert.",{"_2862":721,"_25248":669,"_17581":43191,"_5":17476,"_23883":43071,"_2389":43192},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_2862":722,"_25248":722,"_5":12326,"_2389":43194,"_25584":43195,"_17581":43196,"_23883":722},"Platform architecture",[40961,42324],[],{"_2862":723,"_25248":722,"_17581":43198,"_5":17476,"_23883":722,"_2389":43199},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_2862":724,"_25248":722,"_5":25581,"_17581":43201,"_23883":43202,"_2389":43203},[],"/docs/pr-preview/pr-45/platform/concepts/architecture#control-plane","Control plane",{"_2862":725,"_25248":722,"_5":25581,"_17581":43205,"_23883":43206,"_2389":43207},[],"/docs/pr-preview/pr-45/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_2862":726,"_25248":722,"_5":25581,"_17581":43209,"_23883":43210,"_2389":43211},[],"/docs/pr-preview/pr-45/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_2862":727,"_25248":722,"_5":25581,"_17581":43213,"_23883":43214,"_2389":43215},[],"/docs/pr-preview/pr-45/platform/concepts/architecture#status-and-validation","Status and validation",{"_2862":728,"_25248":722,"_5":25581,"_17581":43217,"_23883":43218,"_2389":43219},[],"/docs/pr-preview/pr-45/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_2862":729,"_25248":722,"_17581":43221,"_5":17476,"_23883":722,"_2389":43222},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_2862":730,"_25248":722,"_17581":43224,"_5":17476,"_23883":722,"_2389":43225},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_2862":731,"_25248":722,"_17581":43227,"_5":17476,"_23883":43202,"_2389":43228},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_2862":732,"_25248":722,"_17581":43230,"_5":17476,"_23883":43206,"_2389":43231},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_2862":733,"_25248":722,"_17581":43233,"_5":17476,"_23883":43210,"_2389":43234},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_2862":734,"_25248":722,"_17581":43236,"_5":17476,"_23883":43214,"_2389":43237},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_2862":735,"_25248":722,"_17581":43239,"_5":17476,"_23883":43218,"_2389":43240},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_2862":736,"_25248":736,"_5":12326,"_2389":43242,"_25584":43243,"_17581":43244,"_23883":736},"How Lamassu works",[40961,42324],[],{"_2862":737,"_25248":736,"_17581":43246,"_5":17476,"_23883":736,"_2389":43247},[],"The mental model of trust, keys, certificates and devices.",{"_2862":738,"_25248":736,"_5":25581,"_17581":43249,"_23883":43250,"_2389":43251},[],"/docs/pr-preview/pr-45/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_2862":739,"_25248":736,"_5":25581,"_17581":43253,"_23883":43254,"_2389":43255},[],"/docs/pr-preview/pr-45/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_2862":740,"_25248":736,"_17581":43257,"_5":17476,"_23883":736,"_2389":43258},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_2862":741,"_25248":736,"_17581":43260,"_5":17476,"_23883":43250,"_2389":43261},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_2862":742,"_25248":736,"_17581":43263,"_5":17476,"_23883":43250,"_2389":43264},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_2862":743,"_25248":736,"_17581":43266,"_5":17476,"_23883":43250,"_2389":43267},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_2862":744,"_25248":736,"_17581":43269,"_5":17476,"_23883":43250,"_2389":43270},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_2862":745,"_25248":736,"_17581":43272,"_5":17476,"_23883":43250,"_2389":43273},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_2862":746,"_25248":736,"_17581":43275,"_5":17476,"_23883":43254,"_2389":43276},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_2862":747,"_25248":736,"_17581":43278,"_5":17476,"_23883":43254,"_2389":43279},[],"A DMS relates that CA to an enrollment policy.",{"_2862":748,"_25248":736,"_17581":43281,"_5":17476,"_23883":43254,"_2389":43282},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_2862":749,"_25248":736,"_17581":43284,"_5":17476,"_23883":43254,"_2389":43285},[],"Lamassu keeps the inventory, history and status of the identity.",{"_2862":750,"_25248":736,"_17581":43287,"_5":17476,"_23883":43254,"_2389":43288},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_2862":751,"_25248":736,"_17581":43290,"_5":17476,"_23883":43254,"_2389":43291},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_2862":752,"_25248":736,"_17581":43293,"_5":17476,"_23883":43254,"_2389":43294},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2862":753,"_25248":753,"_5":12326,"_2389":43296,"_25584":43297,"_17581":43299,"_23883":753},"Devices and identities",[40961,42324,43298,43296],"IoT Fleets",[],{"_2862":754,"_25248":753,"_17581":43301,"_5":17476,"_23883":753,"_2389":43302},[],"Register, inspect and retire devices while checking their current identity and history.",{"_2862":755,"_25248":753,"_5":25581,"_17581":43304,"_23883":43305,"_2389":43306},[],"/docs/pr-preview/pr-45/platform/iot-fleets/device-management#device-states","Device states",{"_2862":756,"_25248":753,"_5":25581,"_17581":43308,"_23883":43309,"_2389":43310},[],"/docs/pr-preview/pr-45/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_2862":757,"_25248":753,"_5":25581,"_17581":43312,"_23883":43313,"_2389":43314},[],"/docs/pr-preview/pr-45/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_2862":758,"_25248":753,"_5":25581,"_17581":43316,"_23883":43317,"_2389":43318},[],"/docs/pr-preview/pr-45/platform/iot-fleets/device-management#create-the-device","Create the device",{"_2862":759,"_25248":753,"_5":25581,"_17581":43320,"_23883":43321,"_2389":43322},[],"/docs/pr-preview/pr-45/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_2862":760,"_25248":753,"_5":25581,"_17581":43324,"_23883":43325,"_2389":43326},[],"/docs/pr-preview/pr-45/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_2862":761,"_25248":753,"_5":25581,"_17581":43328,"_23883":43329,"_2389":43330},[],"/docs/pr-preview/pr-45/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_2862":762,"_25248":753,"_5":25581,"_17581":43332,"_23883":43333,"_2389":43334},[],"/docs/pr-preview/pr-45/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_2862":763,"_25248":753,"_5":25581,"_17581":43336,"_23883":43337,"_2389":43338},[],"/docs/pr-preview/pr-45/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_2862":764,"_25248":753,"_5":25581,"_17581":43340,"_23883":43341,"_2389":43342},[],"/docs/pr-preview/pr-45/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_2862":765,"_25248":753,"_5":25581,"_17581":43344,"_23883":43345,"_2389":43346},[],"/docs/pr-preview/pr-45/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_2862":766,"_25248":753,"_17581":43348,"_5":17476,"_23883":753,"_2389":43349},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_2862":767,"_25248":753,"_17581":43351,"_5":17476,"_23883":753,"_2389":43352},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_2862":768,"_25248":753,"_17581":43354,"_5":17476,"_23883":43305,"_2389":43355},[],"Operational view",{"_2862":769,"_25248":753,"_17581":43357,"_5":17476,"_23883":43305,"_2389":43358},[],"Meaning",{"_2862":770,"_25248":753,"_17581":43360,"_5":17476,"_23883":43305,"_2389":43361},[],"**No Identity**",{"_2862":771,"_25248":753,"_17581":43363,"_5":17476,"_23883":43305,"_2389":43364},[],"A record exists without an associated identity.",{"_2862":772,"_25248":753,"_17581":43366,"_5":17476,"_23883":43305,"_2389":43367},[],"**Active**",{"_2862":773,"_25248":753,"_17581":43369,"_5":17476,"_23883":43305,"_2389":43370},[],"The slot is active; also check certificate dates, status and usages.",{"_2862":774,"_25248":753,"_17581":43372,"_5":17476,"_23883":43305,"_2389":43373},[],"**Renewal Pending**",{"_2862":775,"_25248":753,"_17581":43375,"_5":17476,"_23883":43305,"_2389":43376},[],"The identity is in the operational renewal window.",{"_2862":776,"_25248":753,"_17581":43378,"_5":17476,"_23883":43305,"_2389":43379},[],"**Expiring Soon**",{"_2862":777,"_25248":753,"_17581":43381,"_5":17476,"_23883":43305,"_2389":43382},[],"Expiration is approaching according to configured thresholds.",{"_2862":778,"_25248":753,"_17581":43384,"_5":17476,"_23883":43305,"_2389":43385},[],"**Expired**",{"_2862":779,"_25248":753,"_17581":43387,"_5":17476,"_23883":43305,"_2389":43388},[],"The identity has expired.",{"_2862":780,"_25248":753,"_17581":43390,"_5":17476,"_23883":43305,"_2389":43391},[],"**Revoked**",{"_2862":781,"_25248":753,"_17581":43393,"_5":17476,"_23883":43305,"_2389":43394},[],"The identity is marked revoked.",{"_2862":782,"_25248":753,"_17581":43396,"_5":17476,"_23883":43305,"_2389":43397},[],"**Decommissioned**",{"_2862":783,"_25248":753,"_17581":43399,"_5":17476,"_23883":43305,"_2389":43400},[],"The record is retired and ordinary updates do not restore operation.",{"_2862":784,"_25248":753,"_17581":43402,"_5":17476,"_23883":43305,"_2389":43403},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_2862":785,"_25248":753,"_17581":43405,"_5":17476,"_23883":43309,"_2389":43406},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_2862":786,"_25248":753,"_17581":43408,"_5":17476,"_23883":43309,"_2389":43409},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_2862":787,"_25248":753,"_17581":43411,"_5":17476,"_23883":43309,"_2389":43412},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_2862":788,"_25248":753,"_17581":43414,"_5":17476,"_23883":43309,"_2389":43415},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_2862":789,"_25248":753,"_17581":43417,"_5":17476,"_23883":43313,"_2389":43418},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_2862":790,"_25248":753,"_17581":43420,"_5":17476,"_23883":43317,"_2389":43421},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_2862":791,"_25248":753,"_17581":43423,"_5":17476,"_23883":43321,"_2389":43424},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_2862":792,"_25248":753,"_17581":43426,"_5":17476,"_23883":43325,"_2389":43427},[],"Add model, environment or location tags and an icon according to your inventory.",{"_2862":793,"_25248":753,"_17581":43429,"_5":17476,"_23883":43329,"_2389":43430},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_2862":794,"_25248":753,"_17581":43432,"_5":17476,"_23883":43329,"_2389":43433},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_2862":795,"_25248":753,"_17581":43435,"_5":17476,"_23883":43333,"_2389":43436},[],"From **No Identity**, use **Assign Identity**:",{"_2862":796,"_25248":753,"_17581":43438,"_5":17476,"_23883":43333,"_2389":43439},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_2862":797,"_25248":753,"_17581":43441,"_5":17476,"_23883":43333,"_2389":43442},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_2862":798,"_25248":753,"_17581":43444,"_5":17476,"_23883":43333,"_2389":43445},[],"Confirm and read the serial, active version and history again.",{"_2862":799,"_25248":753,"_17581":43447,"_5":17476,"_23883":43333,"_2389":43448},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_2862":800,"_25248":753,"_17581":43450,"_5":17476,"_23883":43333,"_2389":43451},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_2862":801,"_25248":753,"_17581":43453,"_5":17476,"_23883":43337,"_2389":43454},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_2862":802,"_25248":753,"_17581":43456,"_5":17476,"_23883":43337,"_2389":43457},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_2862":803,"_25248":753,"_17581":43459,"_5":17476,"_23883":43341,"_2389":43460},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_2862":804,"_25248":753,"_17581":43462,"_5":17476,"_23883":43341,"_2389":43463},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_2862":805,"_25248":753,"_17581":43465,"_5":17476,"_23883":43341,"_2389":43466},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_2862":806,"_25248":753,"_17581":43468,"_5":17476,"_23883":43341,"_2389":43469},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_2862":807,"_25248":753,"_17581":43471,"_5":17476,"_23883":43345,"_2389":43472},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2862":808,"_25248":753,"_17581":43474,"_5":17476,"_23883":43345,"_2389":43475},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2862":809,"_25248":809,"_5":12326,"_2389":43477,"_25584":43478,"_17581":43480,"_23883":809},"Bootstrap identity and authentication",[40961,42324,43298,43296,43479],"Enrollment with PKI",[],{"_2862":810,"_25248":809,"_17581":43482,"_5":17476,"_23883":809,"_2389":43483},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_2862":811,"_25248":809,"_5":25581,"_17581":43485,"_23883":43486,"_2389":43487},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_2862":812,"_25248":809,"_5":25581,"_17581":43489,"_23883":43490,"_2389":43491},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_2862":813,"_25248":809,"_5":25581,"_17581":43493,"_23883":43494,"_2389":43495},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_2862":814,"_25248":809,"_5":25581,"_17581":43497,"_23883":43498,"_2389":43499},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_2862":815,"_25248":809,"_5":25581,"_17581":43501,"_23883":43502,"_2389":43503},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_2862":816,"_25248":809,"_17581":43505,"_5":17476,"_23883":809,"_2389":43506},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_2862":817,"_25248":809,"_17581":43508,"_5":17476,"_23883":43486,"_2389":43509},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_2862":818,"_25248":809,"_17581":43511,"_5":17476,"_23883":43486,"_2389":43512},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_2862":819,"_25248":809,"_17581":43514,"_5":17476,"_23883":43490,"_2389":43515},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_2862":820,"_25248":809,"_17581":43517,"_5":17476,"_23883":43490,"_2389":43518},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_2862":821,"_25248":809,"_17581":43520,"_5":17476,"_23883":43490,"_2389":43521},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_2862":822,"_25248":809,"_17581":43523,"_5":17476,"_23883":43494,"_2389":43524},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_2862":823,"_25248":809,"_17581":43526,"_5":17476,"_23883":43494,"_2389":43527},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_2862":824,"_25248":809,"_17581":43529,"_5":17476,"_23883":43498,"_2389":43530},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_2862":825,"_25248":809,"_17581":43532,"_5":17476,"_23883":43498,"_2389":43533},[],"Example body:",{"_2862":826,"_25248":809,"_17581":43535,"_5":17476,"_23883":43498,"_2389":43536},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_2862":827,"_25248":809,"_17581":43538,"_5":17476,"_23883":43498,"_2389":43539},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_2862":828,"_25248":809,"_17581":43541,"_5":17476,"_23883":43498,"_2389":43542},[],"Continuation requires a successful HTTP response and JSON:",{"_2862":829,"_25248":809,"_17581":43544,"_5":17476,"_23883":43498,"_2389":43545},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_2862":830,"_25248":809,"_17581":43547,"_5":17476,"_23883":43502,"_2389":43548},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_2862":831,"_25248":809,"_17581":43550,"_5":17476,"_23883":43502,"_2389":43551},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_2862":832,"_25248":832,"_5":12326,"_2389":43553,"_25584":43554,"_17581":43555,"_23883":832},"Configure and operate the DMS",[40961,42324,43298,43296,43479],[],{"_2862":833,"_25248":832,"_17581":43557,"_5":17476,"_23883":832,"_2389":43558},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_2862":834,"_25248":832,"_5":25581,"_17581":43560,"_23883":43561,"_2389":40971},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#before-you-begin",{"_2862":835,"_25248":832,"_5":25581,"_17581":43563,"_23883":43564,"_2389":43565},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_2862":836,"_25248":832,"_5":25581,"_17581":43567,"_23883":43568,"_2389":43569},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_2862":837,"_25248":832,"_5":25581,"_17581":43571,"_23883":43572,"_2389":43573},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_2862":838,"_25248":832,"_5":25581,"_17581":43575,"_23883":43576,"_2389":43577},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_2862":839,"_25248":832,"_5":25581,"_17581":43579,"_23883":43580,"_2389":43581},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_2862":840,"_25248":832,"_5":25581,"_17581":43583,"_23883":43584,"_2389":43585},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_2862":841,"_25248":832,"_5":25581,"_17581":43587,"_23883":43588,"_2389":43589},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_2862":842,"_25248":832,"_5":25581,"_17581":43591,"_23883":43592,"_2389":43593},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_2862":843,"_25248":832,"_5":25581,"_17581":43595,"_23883":43596,"_2389":43597},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_2862":844,"_25248":832,"_5":25581,"_17581":43599,"_23883":43600,"_2389":43601},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_2862":845,"_25248":832,"_5":25581,"_17581":43603,"_23883":43604,"_2389":43605},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_2862":846,"_25248":832,"_5":25581,"_17581":43607,"_23883":43608,"_2389":43609},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_2862":847,"_25248":832,"_5":25581,"_17581":43611,"_23883":43612,"_2389":43613},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_2862":848,"_25248":832,"_5":25581,"_17581":43615,"_23883":43616,"_2389":43617},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_2862":849,"_25248":832,"_5":25581,"_17581":43619,"_23883":43620,"_2389":43621},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_2862":850,"_25248":832,"_5":25581,"_17581":43623,"_23883":43624,"_2389":43625},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_2862":851,"_25248":832,"_5":25581,"_17581":43627,"_23883":43628,"_2389":43629},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_2862":852,"_25248":832,"_17581":43631,"_5":17476,"_23883":832,"_2389":43632},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_2862":853,"_25248":832,"_17581":43634,"_5":17476,"_23883":43561,"_2389":43635},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_2862":854,"_25248":832,"_17581":43637,"_5":17476,"_23883":43561,"_2389":43638},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_2862":855,"_25248":832,"_17581":43640,"_5":17476,"_23883":43568,"_2389":43641},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_2862":856,"_25248":832,"_17581":43643,"_5":17476,"_23883":43572,"_2389":43644},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_2862":857,"_25248":832,"_17581":43646,"_5":17476,"_23883":43576,"_2389":43647},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_2862":858,"_25248":832,"_17581":43649,"_5":17476,"_23883":43580,"_2389":43650},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_2862":859,"_25248":832,"_17581":43652,"_5":17476,"_23883":43584,"_2389":43653},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_2862":860,"_25248":832,"_17581":43655,"_5":17476,"_23883":43592,"_2389":43656},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_2862":861,"_25248":832,"_17581":43658,"_5":17476,"_23883":43592,"_2389":43659},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_2862":862,"_25248":832,"_17581":43661,"_5":17476,"_23883":43596,"_2389":43662},[],"`settings.enrollment_settings` field",{"_2862":863,"_25248":832,"_17581":43664,"_5":17476,"_23883":43596,"_2389":43665},[],"Decision",{"_2862":864,"_25248":832,"_17581":43667,"_5":17476,"_23883":43596,"_2389":43668},[],"`protocol`",{"_2862":865,"_25248":832,"_17581":43670,"_5":17476,"_23883":43596,"_2389":43671},[],"`EST_RFC7030` for these operations.",{"_2862":866,"_25248":832,"_17581":43673,"_5":17476,"_23883":43596,"_2389":43674},[],"`enrollment_ca`",{"_2862":867,"_25248":832,"_17581":43676,"_5":17476,"_23883":43596,"_2389":43677},[],"ID of the signing CA.",{"_2862":868,"_25248":832,"_17581":43679,"_5":17476,"_23883":43596,"_2389":43680},[],"`verify_csr_signature`",{"_2862":869,"_25248":832,"_17581":43682,"_5":17476,"_23883":43596,"_2389":43683},[],"Keep `true` to verify CSR key possession.",{"_2862":870,"_25248":832,"_17581":43685,"_5":17476,"_23883":43596,"_2389":43686},[],"`enable_replaceable_enrollment`",{"_2862":871,"_25248":832,"_17581":43688,"_5":17476,"_23883":43596,"_2389":43689},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_2862":872,"_25248":832,"_17581":43691,"_5":17476,"_23883":43596,"_2389":43692},[],"`est_rfc7030_settings.auth_mode`",{"_2862":873,"_25248":832,"_17581":43694,"_5":17476,"_23883":43596,"_2389":43695},[],"One of the four authentication modes.",{"_2862":874,"_25248":832,"_17581":43697,"_5":17476,"_23883":43596,"_2389":43698},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_2862":875,"_25248":832,"_17581":43700,"_5":17476,"_23883":43600,"_2389":43701},[],"The blocks are independent:",{"_2862":876,"_25248":832,"_17581":43703,"_5":17476,"_23883":43600,"_2389":43704},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_2862":877,"_25248":832,"_17581":43706,"_5":17476,"_23883":43600,"_2389":43707},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_2862":878,"_25248":832,"_17581":43709,"_5":17476,"_23883":43600,"_2389":43710},[],"`auth_mode`",{"_2862":879,"_25248":832,"_17581":43712,"_5":17476,"_23883":43600,"_2389":43713},[],"Control applied in the configured operation",{"_2862":880,"_25248":832,"_17581":43715,"_5":17476,"_23883":43600,"_2389":43716},[],"`CLIENT_CERTIFICATE`",{"_2862":881,"_25248":832,"_17581":43718,"_5":17476,"_23883":43600,"_2389":43719},[],"Presented certificate validation.",{"_2862":882,"_25248":832,"_17581":43721,"_5":17476,"_23883":43600,"_2389":43722},[],"`EXTERNAL_WEBHOOK`",{"_2862":883,"_25248":832,"_17581":43724,"_5":17476,"_23883":43600,"_2389":43725},[],"Configured webhook authorization.",{"_2862":884,"_25248":832,"_17581":43727,"_5":17476,"_23883":43600,"_2389":43728},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_2862":885,"_25248":832,"_17581":43730,"_5":17476,"_23883":43600,"_2389":43731},[],"Certificate validation followed by webhook approval.",{"_2862":886,"_25248":832,"_17581":43733,"_5":17476,"_23883":43600,"_2389":43734},[],"`NO_AUTH`",{"_2862":887,"_25248":832,"_17581":43736,"_5":17476,"_23883":43600,"_2389":43737},[],"No DMS requester authentication.",{"_2862":888,"_25248":832,"_17581":43739,"_5":17476,"_23883":43600,"_2389":43740},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_2862":889,"_25248":832,"_17581":43742,"_5":17476,"_23883":43600,"_2389":43743},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_2862":890,"_25248":832,"_17581":43745,"_5":17476,"_23883":43600,"_2389":43746},[],"For certificate re-enrollment, the validator uses the enrollment CA, then `additional_validation_cas`, and `enable_expired_renewal`. Do not assume copying initial `validation_cas` changes those issuers.",{"_2862":891,"_25248":832,"_17581":43748,"_5":17476,"_23883":43600,"_2389":43749},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_2862":892,"_25248":832,"_17581":43751,"_5":17476,"_23883":43604,"_2389":43752},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_2862":893,"_25248":832,"_17581":43754,"_5":17476,"_23883":43604,"_2389":43755},[],"`external_webhook_settings` field",{"_2862":894,"_25248":832,"_17581":43757,"_5":17476,"_23883":43604,"_2389":43665},[],{"_2862":895,"_25248":832,"_17581":43759,"_5":17476,"_23883":43604,"_2389":43760},[],"`url`",{"_2862":896,"_25248":832,"_17581":43762,"_5":17476,"_23883":43604,"_2389":43763},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_2862":897,"_25248":832,"_17581":43765,"_5":17476,"_23883":43604,"_2389":43766},[],"`method`",{"_2862":898,"_25248":832,"_17581":43768,"_5":17476,"_23883":43604,"_2389":43769},[],"`POST` or `PUT`; `POST` by default.",{"_2862":899,"_25248":832,"_17581":43771,"_5":17476,"_23883":43604,"_2389":43772},[],"`name`",{"_2862":900,"_25248":832,"_17581":43774,"_5":17476,"_23883":43604,"_2389":43775},[],"Label used in service logs.",{"_2862":901,"_25248":832,"_17581":43777,"_5":17476,"_23883":43604,"_2389":43778},[],"`config.auth_mode`",{"_2862":902,"_25248":832,"_17581":43780,"_5":17476,"_23883":43604,"_2389":43781},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_2862":903,"_25248":832,"_17581":43783,"_5":17476,"_23883":43604,"_2389":43784},[],"`config.apikey_options`",{"_2862":904,"_25248":832,"_17581":43786,"_5":17476,"_23883":43604,"_2389":43787},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_2862":905,"_25248":832,"_17581":43789,"_5":17476,"_23883":43604,"_2389":43790},[],"`config.jwt_options`",{"_2862":906,"_25248":832,"_17581":43792,"_5":17476,"_23883":43604,"_2389":43793},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_2862":907,"_25248":832,"_17581":43795,"_5":17476,"_23883":43604,"_2389":43796},[],"`config.mtls_options`",{"_2862":908,"_25248":832,"_17581":43798,"_5":17476,"_23883":43604,"_2389":43799},[],"Required for `mtls`: `cert_content` and `key_content` as inline PEM.",{"_2862":909,"_25248":832,"_17581":43801,"_5":17476,"_23883":43604,"_2389":43802},[],"`config.insecure_skip_verify`",{"_2862":910,"_25248":832,"_17581":43804,"_5":17476,"_23883":43604,"_2389":43805},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_2862":911,"_25248":832,"_17581":43807,"_5":17476,"_23883":43604,"_2389":43808},[],"`config.call_timeout`",{"_2862":912,"_25248":832,"_17581":43810,"_5":17476,"_23883":43604,"_2389":43811},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_2862":913,"_25248":832,"_17581":43813,"_5":17476,"_23883":43604,"_2389":43814},[],"Rules for that configuration:",{"_2862":914,"_25248":832,"_17581":43816,"_5":17476,"_23883":43604,"_2389":43817},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so supply the PEM as `mtls_options.cert_content` and `key_content`.",{"_2862":915,"_25248":832,"_17581":43819,"_5":17476,"_23883":43604,"_2389":43820},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_2862":916,"_25248":832,"_17581":43822,"_5":17476,"_23883":43604,"_2389":43823},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_2862":917,"_25248":832,"_17581":43825,"_5":17476,"_23883":43604,"_2389":43826},[],"The API ignores the legacy fields `validate_server_cert`, `apikey`, `oidc` and `mtls`. A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` that still carries only the legacy option fields (`apikey`, `oidc`, `mtls`) fails validation with 400; only legacy `noauth` bodies are accepted, and their credentials are dropped.",{"_2862":918,"_25248":832,"_17581":43828,"_5":17476,"_23883":43604,"_2389":43829},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_2862":919,"_25248":832,"_17581":43831,"_5":17476,"_23883":43604,"_2389":43832},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_2862":920,"_25248":832,"_17581":43834,"_5":17476,"_23883":43604,"_2389":43835},[],"Migration `20260604110000` copies initial authentication into renewal settings if missing and the required structure exists. It preserves existing configuration. After upgrading, read both blocks; if your version’s console does not expose independent settings, use the DMS API.",{"_2862":921,"_25248":832,"_17581":43837,"_5":17476,"_23883":43604,"_2389":43838},[],"Migration `20261021120000` rewrites every stored webhook config into this layout: `validate_server_cert` becomes the negated `insecure_skip_verify` (a config where `validate_server_cert` was false keeps skipping verification), `oidc` becomes `jwt_options`, `apikey` becomes `apikey_options` and `mtls` becomes `mtls_options`. When both the legacy certificate and key are PEM, they move into `mtls_options.cert_content` and `key_content` and need no action. Otherwise, including a mixed config (PEM certificate, file-path key), both values become `mtls_options.cert_file` and `key_file`. Delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are re-entered as PEM content, or the leftover file fields are removed if the webhook does not use mTLS. If your version's console does not expose those fields, edit the DMS through the DMS API.",{"_2862":922,"_25248":832,"_17581":43840,"_5":17476,"_23883":43608,"_2389":43841},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_2862":923,"_25248":832,"_17581":43843,"_5":17476,"_23883":43612,"_2389":43844},[],"`settings.reenrollment_settings` field",{"_2862":924,"_25248":832,"_17581":43846,"_5":17476,"_23883":43612,"_2389":41344},[],{"_2862":925,"_25248":832,"_17581":43848,"_5":17476,"_23883":43612,"_2389":43849},[],"`reenrollment_delta`",{"_2862":926,"_25248":832,"_17581":43851,"_5":17476,"_23883":43612,"_2389":43852},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_2862":927,"_25248":832,"_17581":43854,"_5":17476,"_23883":43612,"_2389":43855},[],"`preventive_delta`",{"_2862":928,"_25248":832,"_17581":43857,"_5":17476,"_23883":43612,"_2389":43858},[],"Preventive operational monitoring threshold.",{"_2862":929,"_25248":832,"_17581":43860,"_5":17476,"_23883":43612,"_2389":43861},[],"`critical_delta`",{"_2862":930,"_25248":832,"_17581":43863,"_5":17476,"_23883":43612,"_2389":43864},[],"Critical operational monitoring threshold.",{"_2862":931,"_25248":832,"_17581":43866,"_5":17476,"_23883":43612,"_2389":43867},[],"`enable_expired_renewal`",{"_2862":932,"_25248":832,"_17581":43869,"_5":17476,"_23883":43612,"_2389":43870},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_2862":933,"_25248":832,"_17581":43872,"_5":17476,"_23883":43612,"_2389":43873},[],"`additional_validation_cas`",{"_2862":934,"_25248":832,"_17581":43875,"_5":17476,"_23883":43612,"_2389":43876},[],"Additional mTLS credential issuers during migration.",{"_2862":935,"_25248":832,"_17581":43878,"_5":17476,"_23883":43612,"_2389":43879},[],"`revoke_on_reenrollment`",{"_2862":936,"_25248":832,"_17581":43881,"_5":17476,"_23883":43612,"_2389":43882},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_2862":937,"_25248":832,"_17581":43884,"_5":17476,"_23883":43612,"_2389":43885},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_2862":938,"_25248":832,"_17581":43887,"_5":17476,"_23883":43616,"_2389":43888},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. Algorithm and size come from its `key` field; the profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_2862":939,"_25248":832,"_17581":43890,"_5":17476,"_23883":43620,"_2389":41338},[],{"_2862":940,"_25248":832,"_17581":43892,"_5":17476,"_23883":43620,"_2389":43893},[],"Published material",{"_2862":941,"_25248":832,"_17581":43895,"_5":17476,"_23883":43620,"_2389":43896},[],"**Include Lamassu System CA**",{"_2862":942,"_25248":832,"_17581":43898,"_5":17476,"_23883":43620,"_2389":43899},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_2862":943,"_25248":832,"_17581":43901,"_5":17476,"_23883":43620,"_2389":43902},[],"**Include Enrollment CA**",{"_2862":944,"_25248":832,"_17581":43904,"_5":17476,"_23883":43620,"_2389":43905},[],"Selected issuing CA certificate.",{"_2862":945,"_25248":832,"_17581":43907,"_5":17476,"_23883":43620,"_2389":43908},[],"**Managed CAs**",{"_2862":946,"_25248":832,"_17581":43910,"_5":17476,"_23883":43620,"_2389":43911},[],"Explicitly selected CA certificates.",{"_2862":947,"_25248":832,"_17581":43913,"_5":17476,"_23883":43620,"_2389":43914},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_2862":948,"_25248":832,"_17581":43916,"_5":17476,"_23883":43624,"_2389":43917},[],"**Edit** changes name, settings and metadata. Backend updates replace these complete blocks; read the DMS before sending API edits to avoid losing fields.",{"_2862":949,"_25248":832,"_17581":43919,"_5":17476,"_23883":43624,"_2389":43920},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_2862":950,"_25248":832,"_17581":43922,"_5":17476,"_23883":43624,"_2389":43923},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_2862":951,"_25248":832,"_17581":43925,"_5":17476,"_23883":43628,"_2389":43926},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_2862":952,"_25248":952,"_5":12326,"_2389":43928,"_25584":43929,"_17581":43930,"_23883":952},"Integrate the EST client",[40961,42324,43298,43296,43479],[],{"_2862":953,"_25248":952,"_17581":43932,"_5":17476,"_23883":952,"_2389":43933},[],"Prepare trust, send a CSR and check the identity you receive.",{"_2862":954,"_25248":952,"_5":25581,"_17581":43935,"_23883":43936,"_2389":40971},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_2862":955,"_25248":952,"_5":25581,"_17581":43938,"_23883":43939,"_2389":43940},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_2862":956,"_25248":952,"_5":25581,"_17581":43942,"_23883":43943,"_2389":43944},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_2862":957,"_25248":952,"_5":25581,"_17581":43946,"_23883":43947,"_2389":43948},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_2862":958,"_25248":952,"_5":25581,"_17581":43950,"_23883":43951,"_2389":43952},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_2862":959,"_25248":952,"_5":25581,"_17581":43954,"_23883":43955,"_2389":43956},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_2862":960,"_25248":952,"_17581":43958,"_5":17476,"_23883":952,"_2389":43959},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_2862":961,"_25248":952,"_17581":43961,"_5":17476,"_23883":43936,"_2389":43962},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_2862":962,"_25248":952,"_17581":43964,"_5":17476,"_23883":43936,"_2389":43965},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_2862":963,"_25248":952,"_17581":43967,"_5":17476,"_23883":43936,"_2389":43968},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_2862":964,"_25248":952,"_17581":43970,"_5":17476,"_23883":43939,"_2389":43971},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_2862":965,"_25248":952,"_17581":43973,"_5":17476,"_23883":43939,"_2389":43974},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_2862":966,"_25248":952,"_17581":43976,"_5":17476,"_23883":43943,"_2389":43977},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_2862":967,"_25248":952,"_17581":43979,"_5":17476,"_23883":43943,"_2389":43980},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_2862":968,"_25248":952,"_17581":43982,"_5":17476,"_23883":43947,"_2389":43983},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_2862":969,"_25248":952,"_17581":43985,"_5":17476,"_23883":43947,"_2389":43986},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_2862":970,"_25248":952,"_17581":43988,"_5":17476,"_23883":43951,"_2389":43989},[],"For a root that issues directly:",{"_2862":971,"_25248":952,"_17581":43991,"_5":17476,"_23883":43951,"_2389":43992},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_2862":972,"_25248":952,"_17581":43994,"_5":17476,"_23883":43951,"_2389":43995},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_2862":973,"_25248":952,"_17581":43997,"_5":17476,"_23883":43955,"_2389":43998},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_2862":974,"_25248":974,"_5":12326,"_2389":44000,"_25584":44001,"_17581":44002,"_23883":974},"EST reference",[40961,42324,43298,43296,43479],[],{"_2862":975,"_25248":974,"_17581":44004,"_5":17476,"_23883":974,"_2389":44005},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_2862":976,"_25248":974,"_5":25581,"_17581":44007,"_23883":44008,"_2389":44009},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_2862":977,"_25248":974,"_5":25581,"_17581":44011,"_23883":44012,"_2389":19119},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2862":978,"_25248":974,"_5":25581,"_17581":44014,"_23883":44015,"_2389":21892},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2862":979,"_25248":974,"_5":25581,"_17581":44017,"_23883":44018,"_2389":21899},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2862":980,"_25248":974,"_5":25581,"_17581":44020,"_23883":44021,"_2389":21269},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2862":981,"_25248":974,"_5":25581,"_17581":44023,"_23883":44024,"_2389":44025},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_2862":982,"_25248":974,"_5":25581,"_17581":44027,"_23883":44028,"_2389":44029},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_2862":983,"_25248":974,"_5":25581,"_17581":44031,"_23883":44032,"_2389":44033},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_2862":984,"_25248":974,"_17581":44035,"_5":17476,"_23883":974,"_2389":44036},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_2862":985,"_25248":974,"_17581":44038,"_5":17476,"_23883":44008,"_2389":44039},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_2862":986,"_25248":974,"_17581":44041,"_5":17476,"_23883":44008,"_2389":44042},[],"Operation",{"_2862":987,"_25248":974,"_17581":44044,"_5":17476,"_23883":44008,"_2389":44045},[],"Method",{"_2862":988,"_25248":974,"_17581":44047,"_5":17476,"_23883":44008,"_2389":44048},[],"Authentication and condition",{"_2862":989,"_25248":974,"_17581":44050,"_5":17476,"_23883":44008,"_2389":44051},[],"`/cacerts`",{"_2862":990,"_25248":974,"_17581":44053,"_5":17476,"_23883":44008,"_2389":44054},[],"GET",{"_2862":991,"_25248":974,"_17581":44056,"_5":17476,"_23883":44008,"_2389":44057},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_2862":992,"_25248":974,"_17581":44059,"_5":17476,"_23883":44008,"_2389":44060},[],"`/simpleenroll`",{"_2862":993,"_25248":974,"_17581":44062,"_5":17476,"_23883":44008,"_2389":44063},[],"POST",{"_2862":994,"_25248":974,"_17581":44065,"_5":17476,"_23883":44008,"_2389":44066},[],"Initial authentication and DMS registration/replacement policy.",{"_2862":995,"_25248":974,"_17581":44068,"_5":17476,"_23883":44008,"_2389":44069},[],"`/simplereenroll`",{"_2862":996,"_25248":974,"_17581":44071,"_5":17476,"_23883":44008,"_2389":44063},[],{"_2862":997,"_25248":974,"_17581":44073,"_5":17476,"_23883":44008,"_2389":44074},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_2862":998,"_25248":974,"_17581":44076,"_5":17476,"_23883":44008,"_2389":44077},[],"`/serverkeygen`",{"_2862":999,"_25248":974,"_17581":44079,"_5":17476,"_23883":44008,"_2389":44063},[],{"_2862":1000,"_25248":974,"_17581":44081,"_5":17476,"_23883":44008,"_2389":44082},[],"Initial authentication and admission; server generation enabled.",{"_2862":1001,"_25248":974,"_17581":44084,"_5":17476,"_23883":44008,"_2389":44085},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_2862":1002,"_25248":974,"_17581":44087,"_5":17476,"_23883":44012,"_2389":44088},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_2862":1003,"_25248":974,"_17581":44090,"_5":17476,"_23883":44012,"_2389":44091},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_2862":1004,"_25248":974,"_17581":44093,"_5":17476,"_23883":44015,"_2389":44094},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_2862":1005,"_25248":974,"_17581":44096,"_5":17476,"_23883":44015,"_2389":44097},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_2862":1006,"_25248":974,"_17581":44099,"_5":17476,"_23883":44018,"_2389":44100},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_2862":1007,"_25248":974,"_17581":44102,"_5":17476,"_23883":44018,"_2389":44103},[],"The enrollment CA or an additional CA validates the credential in mTLS mode. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_2862":1008,"_25248":974,"_17581":44105,"_5":17476,"_23883":44021,"_2389":44106},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_2862":1009,"_25248":974,"_17581":44108,"_5":17476,"_23883":44021,"_2389":44109},[],"The code supports RSA and ECDSA with 224, 256, 384 or 521 bits. An unrecognized ECDSA size can fall back to 256; explicitly select a compatible size and check the resulting key. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_2862":1010,"_25248":974,"_17581":44111,"_5":17476,"_23883":44024,"_2389":44112},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_2862":1011,"_25248":974,"_17581":44114,"_5":17476,"_23883":44024,"_2389":44115},[],"Part",{"_2862":1012,"_25248":974,"_17581":44117,"_5":17476,"_23883":44024,"_2389":44118},[],"Content after decoding its Base64",{"_2862":1013,"_25248":974,"_17581":44120,"_5":17476,"_23883":44024,"_2389":44121},[],"`application/pkcs8`",{"_2862":1014,"_25248":974,"_17581":44123,"_5":17476,"_23883":44024,"_2389":44124},[],"Unencrypted DER PKCS#8 private key.",{"_2862":1015,"_25248":974,"_17581":44126,"_5":17476,"_23883":44024,"_2389":44127},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_2862":1016,"_25248":974,"_17581":44129,"_5":17476,"_23883":44024,"_2389":44130},[],"DER PKCS#7 containing the issued certificate.",{"_2862":1017,"_25248":974,"_17581":44132,"_5":17476,"_23883":44024,"_2389":44133},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_2862":1018,"_25248":974,"_17581":44135,"_5":17476,"_23883":44028,"_2389":44136},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_2862":1019,"_25248":974,"_17581":44138,"_5":17476,"_23883":44028,"_2389":44139},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_2862":1020,"_25248":974,"_17581":44141,"_5":17476,"_23883":44028,"_2389":44142},[],"Convert and check the result:",{"_2862":1021,"_25248":974,"_17581":44144,"_5":17476,"_23883":44028,"_2389":44145},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_2862":1022,"_25248":974,"_17581":44147,"_5":17476,"_23883":44032,"_2389":44148},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_2862":1023,"_25248":974,"_17581":44150,"_5":17476,"_23883":44032,"_2389":44151},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_2862":1024,"_25248":1024,"_5":12326,"_2389":43479,"_25584":44153,"_17581":44154,"_23883":1024},[40961,42324,43298,43296,43479],[],{"_2862":1025,"_25248":1024,"_17581":44156,"_5":17476,"_23883":1024,"_2389":44157},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_2862":1026,"_25248":1024,"_5":25581,"_17581":44159,"_23883":44160,"_2389":44161},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_2862":1027,"_25248":1024,"_5":25581,"_17581":44163,"_23883":44164,"_2389":44165},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_2862":1028,"_25248":1024,"_5":25581,"_17581":44167,"_23883":44168,"_2389":44169},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_2862":1029,"_25248":1024,"_5":25581,"_17581":44171,"_23883":44172,"_2389":44173},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_2862":1030,"_25248":1024,"_17581":44175,"_5":17476,"_23883":1024,"_2389":44176},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_2862":1031,"_25248":1024,"_17581":44178,"_5":17476,"_23883":44160,"_2389":44179},[],"The administrator prepares the CA, issuance profile and DMS.",{"_2862":1032,"_25248":1024,"_17581":44181,"_5":17476,"_23883":44160,"_2389":44182},[],"The integrator installs initial EST server trust and an admission credential.",{"_2862":1033,"_25248":1024,"_17581":44184,"_5":17476,"_23883":44160,"_2389":44185},[],"The client requests an identity for its `Device ID` through EST.",{"_2862":1034,"_25248":1024,"_17581":44187,"_5":17476,"_23883":44160,"_2389":44188},[],"Certificate, device binding and key/certificate installation are checked.",{"_2862":1035,"_25248":1024,"_17581":44190,"_5":17476,"_23883":44160,"_2389":44191},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_2862":1036,"_25248":1024,"_17581":44193,"_5":17476,"_23883":44160,"_2389":44194},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_2862":1037,"_25248":1024,"_17581":44196,"_5":17476,"_23883":44164,"_2389":44197},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2862":1038,"_25248":1024,"_17581":44199,"_5":17476,"_23883":44164,"_2389":44200},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2862":1039,"_25248":1024,"_17581":44202,"_5":17476,"_23883":44164,"_2389":44203},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2862":1040,"_25248":1024,"_17581":44205,"_5":17476,"_23883":44164,"_2389":44206},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2862":1041,"_25248":1024,"_17581":44208,"_5":17476,"_23883":44168,"_2389":44209},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2862":1042,"_25248":1024,"_17581":44211,"_5":17476,"_23883":44168,"_2389":44212},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2862":1043,"_25248":1024,"_17581":44214,"_5":17476,"_23883":44168,"_2389":44215},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2862":1044,"_25248":1024,"_17581":44217,"_5":17476,"_23883":44168,"_2389":44218},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2862":1045,"_25248":1024,"_17581":44220,"_5":17476,"_23883":44172,"_2389":44221},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract and migrations, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_2862":1046,"_25248":1024,"_17581":44223,"_5":17476,"_23883":44172,"_2389":44224},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_2862":1047,"_25248":1047,"_5":12326,"_2389":44226,"_25584":44227,"_17581":44228,"_23883":1047},"Provisioning strategies",[40961,42324,43298,43296,43479],[],{"_2862":1048,"_25248":1047,"_17581":44230,"_5":17476,"_23883":1047,"_2389":44231},[],"Choose device registration, identity authorization and key generation.",{"_2862":1049,"_25248":1047,"_5":25581,"_17581":44233,"_23883":44234,"_2389":44235},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_2862":1050,"_25248":1047,"_5":25581,"_17581":44237,"_23883":44238,"_2389":44239},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_2862":1051,"_25248":1047,"_5":25581,"_17581":44241,"_23883":44242,"_2389":44243},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_2862":1052,"_25248":1047,"_5":25581,"_17581":44245,"_23883":44246,"_2389":44247},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_2862":1053,"_25248":1047,"_5":25581,"_17581":44249,"_23883":44250,"_2389":44251},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_2862":1054,"_25248":1047,"_17581":44253,"_5":17476,"_23883":1047,"_2389":44254},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_2862":1055,"_25248":1047,"_17581":44256,"_5":17476,"_23883":44234,"_2389":44257},[],"Path",{"_2862":1056,"_25248":1047,"_17581":44259,"_5":17476,"_23883":44234,"_2389":44260},[],"When the device exists",{"_2862":1057,"_25248":1047,"_17581":44262,"_5":17476,"_23883":44234,"_2389":44263},[],"What to check",{"_2862":1058,"_25248":1047,"_17581":44265,"_5":17476,"_23883":44234,"_2389":44266},[],"Manual assignment",{"_2862":1059,"_25248":1047,"_17581":44268,"_5":17476,"_23883":44234,"_2389":44269},[],"An operator creates it before associating a certificate.",{"_2862":1060,"_25248":1047,"_17581":44271,"_5":17476,"_23883":44234,"_2389":44272},[],"ID, owning DMS, certificate CN and bound serial.",{"_2862":1061,"_25248":1047,"_17581":44274,"_5":17476,"_23883":44234,"_2389":44275},[],"EST with `JITP`",{"_2862":1062,"_25248":1047,"_17581":44277,"_5":17476,"_23883":44234,"_2389":44278},[],"Created for an unknown CN during `/simpleenroll`.",{"_2862":1063,"_25248":1047,"_17581":44280,"_5":17476,"_23883":44234,"_2389":44281},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_2862":1064,"_25248":1047,"_17581":44283,"_5":17476,"_23883":44234,"_2389":44284},[],"EST with `PRE_REGISTRATION`",{"_2862":1065,"_25248":1047,"_17581":44286,"_5":17476,"_23883":44234,"_2389":44287},[],"Must exist before `/simpleenroll`.",{"_2862":1066,"_25248":1047,"_17581":44289,"_5":17476,"_23883":44234,"_2389":44290},[],"Approved record, same DMS and replacement conditions for your version.",{"_2862":1067,"_25248":1047,"_17581":44292,"_5":17476,"_23883":44234,"_2389":44293},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_2862":1068,"_25248":1047,"_17581":44295,"_5":17476,"_23883":44234,"_2389":44296},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_2862":1069,"_25248":1047,"_17581":44298,"_5":17476,"_23883":44238,"_2389":44299},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_2862":1070,"_25248":1047,"_17581":44301,"_5":17476,"_23883":44238,"_2389":44302},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_2862":1071,"_25248":1047,"_17581":44304,"_5":17476,"_23883":44238,"_2389":44305},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_2862":1072,"_25248":1047,"_17581":44307,"_5":17476,"_23883":44242,"_2389":44308},[],"Decide initial enrollment and re-enrollment separately:",{"_2862":1073,"_25248":1047,"_17581":44310,"_5":17476,"_23883":44242,"_2389":44311},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_2862":1074,"_25248":1047,"_17581":44313,"_5":17476,"_23883":44242,"_2389":44314},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_2862":1075,"_25248":1047,"_17581":44316,"_5":17476,"_23883":44242,"_2389":44317},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_2862":1076,"_25248":1047,"_17581":44319,"_5":17476,"_23883":44242,"_2389":44320},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_2862":1077,"_25248":1047,"_17581":44322,"_5":17476,"_23883":44242,"_2389":44323},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_2862":1078,"_25248":1047,"_17581":44325,"_5":17476,"_23883":44246,"_2389":41338},[],{"_2862":1079,"_25248":1047,"_17581":44327,"_5":17476,"_23883":44246,"_2389":44328},[],"Material crossing EST",{"_2862":1080,"_25248":1047,"_17581":44330,"_5":17476,"_23883":44246,"_2389":44331},[],"Device-generated key",{"_2862":1081,"_25248":1047,"_17581":44333,"_5":17476,"_23883":44246,"_2389":44334},[],"Public CSR and certificate; the key stays on the client.",{"_2862":1082,"_25248":1047,"_17581":44336,"_5":17476,"_23883":44246,"_2389":44337},[],"Existing device key",{"_2862":1083,"_25248":1047,"_17581":44339,"_5":17476,"_23883":44246,"_2389":44340},[],"CSR signed with that key and a new certificate.",{"_2862":1084,"_25248":1047,"_17581":44342,"_5":17476,"_23883":44246,"_2389":43617},[],{"_2862":1085,"_25248":1047,"_17581":44344,"_5":17476,"_23883":44246,"_2389":44345},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_2862":1086,"_25248":1047,"_17581":44347,"_5":17476,"_23883":44246,"_2389":44348},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_2862":1087,"_25248":1047,"_17581":44350,"_5":17476,"_23883":44250,"_2389":44351},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_2862":1088,"_25248":1088,"_5":12326,"_2389":44353,"_25584":44354,"_17581":44355,"_23883":1088},"Renewal and recovery",[40961,42324,43298,43296,43479],[],{"_2862":1089,"_25248":1088,"_17581":44357,"_5":17476,"_23883":1088,"_2389":44358},[],"Renew without losing the identity and recover devices according to their actual state.",{"_2862":1090,"_25248":1088,"_5":25581,"_17581":44360,"_23883":44361,"_2389":44362},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_2862":1091,"_25248":1088,"_5":25581,"_17581":44364,"_23883":44365,"_2389":44366},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_2862":1092,"_25248":1088,"_5":25581,"_17581":44368,"_23883":44369,"_2389":44370},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_2862":1093,"_25248":1088,"_5":25581,"_17581":44372,"_23883":44373,"_2389":44374},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_2862":1094,"_25248":1088,"_5":25581,"_17581":44376,"_23883":44377,"_2389":44378},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_2862":1095,"_25248":1088,"_17581":44380,"_5":17476,"_23883":1088,"_2389":44381},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_2862":1096,"_25248":1088,"_17581":44383,"_5":17476,"_23883":44361,"_2389":44384},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_2862":1097,"_25248":1088,"_17581":44386,"_5":17476,"_23883":44361,"_2389":44387},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_2862":1098,"_25248":1088,"_17581":44389,"_5":17476,"_23883":44361,"_2389":44390},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_2862":1099,"_25248":1088,"_17581":44392,"_5":17476,"_23883":44361,"_2389":44393},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_2862":1100,"_25248":1088,"_17581":44395,"_5":17476,"_23883":44365,"_2389":44396},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_2862":1101,"_25248":1088,"_17581":44398,"_5":17476,"_23883":44365,"_2389":44399},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_2862":1102,"_25248":1088,"_17581":44401,"_5":17476,"_23883":44369,"_2389":44402},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_2862":1103,"_25248":1088,"_17581":44404,"_5":17476,"_23883":44369,"_2389":44405},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_2862":1104,"_25248":1088,"_17581":44407,"_5":17476,"_23883":44369,"_2389":44408},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_2862":1105,"_25248":1088,"_17581":44410,"_5":17476,"_23883":44373,"_2389":44411},[],"Situation",{"_2862":1106,"_25248":1088,"_17581":44413,"_5":17476,"_23883":44373,"_2389":44414},[],"Procedure",{"_2862":1107,"_25248":1088,"_17581":44416,"_5":17476,"_23883":44373,"_2389":44417},[],"Valid certificate, outside the window",{"_2862":1108,"_25248":1088,"_17581":44419,"_5":17476,"_23883":44373,"_2389":44420},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_2862":1109,"_25248":1088,"_17581":44422,"_5":17476,"_23883":44373,"_2389":44423},[],"Expired certificate, key available",{"_2862":1110,"_25248":1088,"_17581":44425,"_5":17476,"_23883":44373,"_2389":44426},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_2862":1111,"_25248":1088,"_17581":44428,"_5":17476,"_23883":44373,"_2389":44429},[],"Renewal through webhook or `NO_AUTH`",{"_2862":1112,"_25248":1088,"_17581":44431,"_5":17476,"_23883":44373,"_2389":44432},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_2862":1113,"_25248":1088,"_17581":44434,"_5":17476,"_23883":44373,"_2389":44435},[],"Lost or inaccessible key",{"_2862":1114,"_25248":1088,"_17581":44437,"_5":17476,"_23883":44373,"_2389":44438},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_2862":1115,"_25248":1088,"_17581":44440,"_5":17476,"_23883":44373,"_2389":44441},[],"Current identity revoked",{"_2862":1116,"_25248":1088,"_17581":44443,"_5":17476,"_23883":44373,"_2389":44444},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_2862":1117,"_25248":1088,"_17581":44446,"_5":17476,"_23883":44373,"_2389":44447},[],"Device without an identity",{"_2862":1118,"_25248":1088,"_17581":44449,"_5":17476,"_23883":44373,"_2389":44450},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_2862":1119,"_25248":1088,"_17581":44452,"_5":17476,"_23883":44373,"_2389":44453},[],"Retired device",{"_2862":1120,"_25248":1088,"_17581":44455,"_5":17476,"_23883":44373,"_2389":44456},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_2862":1121,"_25248":1088,"_17581":44458,"_5":17476,"_23883":44373,"_2389":44459},[],"Timeout, HTTP 500 or installation failure",{"_2862":1122,"_25248":1088,"_17581":44461,"_5":17476,"_23883":44373,"_2389":44462},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_2862":1123,"_25248":1088,"_17581":44464,"_5":17476,"_23883":44377,"_2389":44465},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_2862":1124,"_25248":1088,"_17581":44467,"_5":17476,"_23883":44377,"_2389":44468},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_2862":1125,"_25248":1125,"_5":12326,"_2389":44470,"_25584":44471,"_17581":44472,"_23883":1125},"Enrollment troubleshooting",[40961,42324,43298,43296,43479],[],{"_2862":1126,"_25248":1125,"_17581":44474,"_5":17476,"_23883":1125,"_2389":44475},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_2862":1127,"_25248":1125,"_5":25581,"_17581":44477,"_23883":44478,"_2389":44479},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_2862":1128,"_25248":1125,"_5":25581,"_17581":44481,"_23883":44482,"_2389":44483},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_2862":1129,"_25248":1125,"_5":25581,"_17581":44485,"_23883":44486,"_2389":44033},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_2862":1130,"_25248":1125,"_5":25581,"_17581":44488,"_23883":44489,"_2389":44490},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_2862":1131,"_25248":1125,"_17581":44492,"_5":17476,"_23883":1125,"_2389":44493},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_2862":1132,"_25248":1125,"_17581":44495,"_5":17476,"_23883":44482,"_2389":44496},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_2862":1133,"_25248":1125,"_17581":44498,"_5":17476,"_23883":44482,"_2389":44499},[],"Symptom or message",{"_2862":1134,"_25248":1125,"_17581":44501,"_5":17476,"_23883":44482,"_2389":44263},[],{"_2862":1135,"_25248":1125,"_17581":44503,"_5":17476,"_23883":44482,"_2389":44504},[],"curl rejects TLS, name or issuer",{"_2862":1136,"_25248":1125,"_17581":44506,"_5":17476,"_23883":44482,"_2389":44507},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_2862":1137,"_25248":1125,"_17581":44509,"_5":17476,"_23883":44482,"_2389":44510},[],"404 or missing APS",{"_2862":1138,"_25248":1125,"_17581":44512,"_5":17476,"_23883":44482,"_2389":44513},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_2862":1139,"_25248":1125,"_17581":44515,"_5":17476,"_23883":44482,"_2389":44516},[],"400, CSR or format error",{"_2862":1140,"_25248":1125,"_17581":44518,"_5":17476,"_23883":44482,"_2389":44519},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_2862":1141,"_25248":1125,"_17581":44521,"_5":17476,"_23883":44482,"_2389":44522},[],"Missing credential or invalid certificate",{"_2862":1142,"_25248":1125,"_17581":44524,"_5":17476,"_23883":44482,"_2389":44525},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_2862":1143,"_25248":1125,"_17581":44527,"_5":17476,"_23883":44482,"_2389":44528},[],"Webhook denies, times out or responds without authorization",{"_2862":1144,"_25248":1125,"_17581":44530,"_5":17476,"_23883":44482,"_2389":44531},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_2862":1145,"_25248":1125,"_17581":44533,"_5":17476,"_23883":44482,"_2389":44534},[],"`unexpected status code: <n>: redirects are not followed`",{"_2862":1146,"_25248":1125,"_17581":44536,"_5":17476,"_23883":44482,"_2389":44537},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_2862":1147,"_25248":1125,"_17581":44539,"_5":17476,"_23883":44482,"_2389":44540},[],"`webhook response exceeds 1048576 bytes`",{"_2862":1148,"_25248":1125,"_17581":44542,"_5":17476,"_23883":44482,"_2389":44543},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_2862":1149,"_25248":1125,"_17581":44545,"_5":17476,"_23883":44482,"_2389":44546},[],"`webhook config must not reference files`",{"_2862":1150,"_25248":1125,"_17581":44548,"_5":17476,"_23883":44482,"_2389":44549},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the PEM as `cert_content` and `key_content`; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the upgrade note in DMS.",{"_2862":1151,"_25248":1125,"_17581":44551,"_5":17476,"_23883":44482,"_2389":44552},[],"400 `struct validation error` creating or updating a DMS",{"_2862":1152,"_25248":1125,"_17581":44554,"_5":17476,"_23883":44482,"_2389":44555},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_2862":1153,"_25248":1125,"_17581":44557,"_5":17476,"_23883":44482,"_2389":44558},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_2862":1154,"_25248":1125,"_17581":44560,"_5":17476,"_23883":44482,"_2389":44561},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_2862":1155,"_25248":1125,"_17581":44563,"_5":17476,"_23883":44482,"_2389":44564},[],"`device not preregistered`",{"_2862":1156,"_25248":1125,"_17581":44566,"_5":17476,"_23883":44482,"_2389":44567},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_2862":1157,"_25248":1125,"_17581":44569,"_5":17476,"_23883":44482,"_2389":44570},[],"`forbiddenNewEnrollment`",{"_2862":1158,"_25248":1125,"_17581":44572,"_5":17476,"_23883":44482,"_2389":44573},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_2862":1159,"_25248":1125,"_17581":44575,"_5":17476,"_23883":44482,"_2389":44576},[],"Different owning DMS",{"_2862":1160,"_25248":1125,"_17581":44578,"_5":17476,"_23883":44482,"_2389":44579},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_2862":1161,"_25248":1125,"_17581":44581,"_5":17476,"_23883":44482,"_2389":44582},[],"`invalid RawSubject bytes`",{"_2862":1162,"_25248":1125,"_17581":44584,"_5":17476,"_23883":44482,"_2389":44585},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_2862":1163,"_25248":1125,"_17581":44587,"_5":17476,"_23883":44482,"_2389":44588},[],"`invalid reenroll window`",{"_2862":1164,"_25248":1125,"_17581":44590,"_5":17476,"_23883":44482,"_2389":44591},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_2862":1165,"_25248":1125,"_17581":44593,"_5":17476,"_23883":44482,"_2389":44594},[],"Current certificate revoked",{"_2862":1166,"_25248":1125,"_17581":44596,"_5":17476,"_23883":44482,"_2389":44597},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_2862":1167,"_25248":1125,"_17581":44599,"_5":17476,"_23883":44482,"_2389":44600},[],"CA, profile or signing error",{"_2862":1168,"_25248":1125,"_17581":44602,"_5":17476,"_23883":44482,"_2389":44603},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_2862":1169,"_25248":1125,"_17581":44605,"_5":17476,"_23883":44482,"_2389":44606},[],"HTTP 200 without a device connection",{"_2862":1170,"_25248":1125,"_17581":44608,"_5":17476,"_23883":44482,"_2389":44609},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_2862":1171,"_25248":1125,"_17581":44611,"_5":17476,"_23883":44482,"_2389":44612},[],"Timeout or error after issuance",{"_2862":1172,"_25248":1125,"_17581":44614,"_5":17476,"_23883":44482,"_2389":44615},[],"New certificates, current slot and previous identity's state before retrying.",{"_2862":1173,"_25248":1125,"_17581":44617,"_5":17476,"_23883":44486,"_2389":44618},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode after migration and Gateway behavior with expired certificates and the bootstrap CA.",{"_2862":1174,"_25248":1125,"_17581":44620,"_5":17476,"_23883":44486,"_2389":44621},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_2862":1175,"_25248":1125,"_17581":44623,"_5":17476,"_23883":44489,"_2389":44624},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_2862":1176,"_25248":1125,"_17581":44626,"_5":17476,"_23883":44489,"_2389":44627},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_2862":1177,"_25248":1125,"_17581":44629,"_5":17476,"_23883":44489,"_2389":44630},[],"Verify the CSR locally and relate its CN to the inventory.",{"_2862":1178,"_25248":1125,"_17581":44632,"_5":17476,"_23883":44489,"_2389":44633},[],"Make one request, save headers/body and query the device and certificates.",{"_2862":1179,"_25248":1125,"_17581":44635,"_5":17476,"_23883":44489,"_2389":44636},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_2862":1180,"_25248":1125,"_17581":44638,"_5":17476,"_23883":44489,"_2389":44639},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_2862":1181,"_25248":1125,"_17581":44641,"_5":17476,"_23883":44489,"_2389":44642},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_2862":1182,"_25248":1182,"_5":12326,"_2389":44644,"_25584":44645,"_17581":44646,"_23883":1182},"Trust distribution and updates",[40961,42324,43298,43296,43479],[],{"_2862":1183,"_25248":1182,"_17581":44648,"_5":17476,"_23883":1182,"_2389":44649},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_2862":1184,"_25248":1182,"_5":25581,"_17581":44651,"_23883":44652,"_2389":44653},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_2862":1185,"_25248":1182,"_5":25581,"_17581":44655,"_23883":44656,"_2389":44657},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_2862":1186,"_25248":1182,"_5":25581,"_17581":44659,"_23883":44660,"_2389":44661},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_2862":1187,"_25248":1182,"_5":25581,"_17581":44663,"_23883":44664,"_2389":44665},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_2862":1188,"_25248":1182,"_5":25581,"_17581":44667,"_23883":44668,"_2389":44669},[],"/docs/pr-preview/pr-45/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_2862":1189,"_25248":1182,"_17581":44671,"_5":17476,"_23883":1182,"_2389":44672},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_2862":1190,"_25248":1182,"_17581":44674,"_5":17476,"_23883":44652,"_2389":44675},[],"Relationship",{"_2862":1191,"_25248":1182,"_17581":44677,"_5":17476,"_23883":44652,"_2389":44678},[],"Material prepared by its owner",{"_2862":1192,"_25248":1182,"_17581":44680,"_5":17476,"_23883":44652,"_2389":44681},[],"Device → EST server",{"_2862":1193,"_25248":1182,"_17581":44683,"_5":17476,"_23883":44652,"_2389":44684},[],"Previously verified server root, chain or pin and TLS name.",{"_2862":1194,"_25248":1182,"_17581":44686,"_5":17476,"_23883":44652,"_2389":44687},[],"DMS → requester",{"_2862":1195,"_25248":1182,"_17581":44689,"_5":17476,"_23883":44652,"_2389":44690},[],"CAs and rules authorizing initial or renewal credentials.",{"_2862":1196,"_25248":1182,"_17581":44692,"_5":17476,"_23883":44652,"_2389":44693},[],"Consumer → device",{"_2862":1197,"_25248":1182,"_17581":44695,"_5":17476,"_23883":44652,"_2389":44696},[],"Operational identity roots, intermediates, validation and permissions.",{"_2862":1198,"_25248":1182,"_17581":44698,"_5":17476,"_23883":44652,"_2389":44699},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_2862":1199,"_25248":1182,"_17581":44701,"_5":17476,"_23883":44656,"_2389":44702},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_2862":1200,"_25248":1182,"_17581":44704,"_5":17476,"_23883":44656,"_2389":44705},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_2862":1201,"_25248":1182,"_17581":44707,"_5":17476,"_23883":44660,"_2389":44708},[],"Keep initial EST server trust separate from identity consumer trust.",{"_2862":1202,"_25248":1182,"_17581":44710,"_5":17476,"_23883":44660,"_2389":44711},[],"Select policy-approved roots as anchors.",{"_2862":1203,"_25248":1182,"_17581":44713,"_5":17476,"_23883":44660,"_2389":44714},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_2862":1204,"_25248":1182,"_17581":44716,"_5":17476,"_23883":44660,"_2389":44717},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_2862":1205,"_25248":1182,"_17581":44719,"_5":17476,"_23883":44660,"_2389":44720},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_2862":1206,"_25248":1182,"_17581":44722,"_5":17476,"_23883":44660,"_2389":44723},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_2862":1207,"_25248":1182,"_17581":44725,"_5":17476,"_23883":44664,"_2389":44726},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_2862":1208,"_25248":1182,"_17581":44728,"_5":17476,"_23883":44664,"_2389":44729},[],"In the DMS, separate distributed CAs from `additional_validation_cas`, used for re-enrollment credentials. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_2862":1209,"_25248":1182,"_17581":44731,"_5":17476,"_23883":44664,"_2389":44732},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_2862":1210,"_25248":1182,"_17581":44734,"_5":17476,"_23883":44668,"_2389":44735},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_2862":1211,"_25248":1211,"_5":12326,"_2389":44737,"_25584":44738,"_17581":44740,"_23883":1211},"AWS IoT Core",[40961,42324,43298,43296,44739],"Integrations",[],{"_2862":1212,"_25248":1211,"_17581":44742,"_5":17476,"_23883":1211,"_2389":44743},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_2862":1213,"_25248":1211,"_5":25581,"_17581":44745,"_23883":44746,"_2389":44747},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_2862":1214,"_25248":1211,"_5":25581,"_17581":44749,"_23883":44750,"_2389":44751},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_2862":1215,"_25248":1211,"_5":25581,"_17581":44753,"_23883":44754,"_2389":44755},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_2862":1216,"_25248":1211,"_5":25581,"_17581":44757,"_23883":44758,"_2389":44759},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_2862":1217,"_25248":1211,"_5":25581,"_17581":44761,"_23883":44762,"_2389":44763},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_2862":1218,"_25248":1211,"_5":25581,"_17581":44765,"_23883":44766,"_2389":44767},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_2862":1219,"_25248":1211,"_5":25581,"_17581":44769,"_23883":44770,"_2389":44771},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_2862":1220,"_25248":1211,"_5":25581,"_17581":44773,"_23883":44774,"_2389":44775},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_2862":1221,"_25248":1211,"_5":25581,"_17581":44777,"_23883":44778,"_2389":44779},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_2862":1222,"_25248":1211,"_5":25581,"_17581":44781,"_23883":44782,"_2389":44783},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_2862":1223,"_25248":1211,"_5":25581,"_17581":44785,"_23883":44786,"_2389":44787},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_2862":1224,"_25248":1211,"_5":25581,"_17581":44789,"_23883":44790,"_2389":44791},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_2862":1225,"_25248":1211,"_5":25581,"_17581":44793,"_23883":44794,"_2389":44795},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_2862":1226,"_25248":1211,"_5":25581,"_17581":44797,"_23883":44798,"_2389":44799},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_2862":1227,"_25248":1211,"_5":25581,"_17581":44801,"_23883":44802,"_2389":44803},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_2862":1228,"_25248":1211,"_5":25581,"_17581":44805,"_23883":44806,"_2389":44807},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_2862":1229,"_25248":1211,"_5":25581,"_17581":44809,"_23883":44810,"_2389":44811},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_2862":1230,"_25248":1211,"_5":25581,"_17581":44813,"_23883":44814,"_2389":44815},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_2862":1231,"_25248":1211,"_5":25581,"_17581":44817,"_23883":44818,"_2389":44819},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_2862":1232,"_25248":1211,"_5":25581,"_17581":44821,"_23883":44822,"_2389":44823},[],"/docs/pr-preview/pr-45/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_2862":1233,"_25248":1211,"_17581":44825,"_5":17476,"_23883":1211,"_2389":44826},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_2862":1234,"_25248":1211,"_17581":44828,"_5":17476,"_23883":1211,"_2389":44829},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_2862":1235,"_25248":1211,"_17581":44831,"_5":17476,"_23883":1211,"_2389":44832},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_2862":1236,"_25248":1211,"_17581":44834,"_5":17476,"_23883":44746,"_2389":44835},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_2862":1237,"_25248":1211,"_17581":44837,"_5":17476,"_23883":44746,"_2389":44838},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_2862":1238,"_25248":1211,"_17581":44840,"_5":17476,"_23883":44746,"_2389":44841},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_2862":1239,"_25248":1211,"_17581":44843,"_5":17476,"_23883":44746,"_2389":44844},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_2862":1240,"_25248":1211,"_17581":44846,"_5":17476,"_23883":44750,"_2389":44847},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_2862":1241,"_25248":1211,"_17581":44849,"_5":17476,"_23883":44754,"_2389":44850},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_2862":1242,"_25248":1211,"_17581":44852,"_5":17476,"_23883":44754,"_2389":44853},[],"IAM action",{"_2862":1243,"_25248":1211,"_17581":44855,"_5":17476,"_23883":44754,"_2389":41344},[],{"_2862":1244,"_25248":1211,"_17581":44857,"_5":17476,"_23883":44754,"_2389":44858},[],"`iot:GetRegistrationCode`",{"_2862":1245,"_25248":1211,"_17581":44860,"_5":17476,"_23883":44754,"_2389":44861},[],"Obtain the verification code for CA registration in the Primary Account",{"_2862":1246,"_25248":1211,"_17581":44863,"_5":17476,"_23883":44754,"_2389":44864},[],"`iot:RegisterCACertificate`",{"_2862":1247,"_25248":1211,"_17581":44866,"_5":17476,"_23883":44754,"_2389":44867},[],"Register the CA in AWS IoT",{"_2862":1248,"_25248":1211,"_17581":44869,"_5":17476,"_23883":44754,"_2389":44870},[],"`iot:DescribeCACertificate`",{"_2862":1249,"_25248":1211,"_17581":44872,"_5":17476,"_23883":44754,"_2389":44873},[],"Check the CA registration status",{"_2862":1250,"_25248":1211,"_17581":44875,"_5":17476,"_23883":44754,"_2389":44876},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_2862":1251,"_25248":1211,"_17581":44878,"_5":17476,"_23883":44754,"_2389":44879},[],"Create or update Things in IoT Core",{"_2862":1252,"_25248":1211,"_17581":44881,"_5":17476,"_23883":44754,"_2389":44882},[],"`iot:RegisterThing`",{"_2862":1253,"_25248":1211,"_17581":44884,"_5":17476,"_23883":44754,"_2389":44885},[],"Provision Things through a template",{"_2862":1254,"_25248":1211,"_17581":44887,"_5":17476,"_23883":44754,"_2389":44888},[],"`iot:RegisterCertificate`",{"_2862":1255,"_25248":1211,"_17581":44890,"_5":17476,"_23883":44754,"_2389":44891},[],"Register device certificates",{"_2862":1256,"_25248":1211,"_17581":44893,"_5":17476,"_23883":44754,"_2389":44894},[],"`iot:UpdateCertificate`",{"_2862":1257,"_25248":1211,"_17581":44896,"_5":17476,"_23883":44754,"_2389":44897},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_2862":1258,"_25248":1211,"_17581":44899,"_5":17476,"_23883":44754,"_2389":44900},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_2862":1259,"_25248":1211,"_17581":44902,"_5":17476,"_23883":44754,"_2389":44903},[],"Create and attach IoT policies",{"_2862":1260,"_25248":1211,"_17581":44905,"_5":17476,"_23883":44754,"_2389":44906},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_2862":1261,"_25248":1211,"_17581":44908,"_5":17476,"_23883":44754,"_2389":44909},[],"Manage Thing groups",{"_2862":1262,"_25248":1211,"_17581":44911,"_5":17476,"_23883":44754,"_2389":44912},[],"`iot:CreateProvisioningTemplate`",{"_2862":1263,"_25248":1211,"_17581":44914,"_5":17476,"_23883":44754,"_2389":44915},[],"Create JITP templates",{"_2862":1264,"_25248":1211,"_17581":44917,"_5":17476,"_23883":44754,"_2389":44918},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_2862":1265,"_25248":1211,"_17581":44920,"_5":17476,"_23883":44754,"_2389":44921},[],"Read and write the Device Shadow",{"_2862":1266,"_25248":1211,"_17581":44923,"_5":17476,"_23883":44754,"_2389":44924},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_2862":1267,"_25248":1211,"_17581":44926,"_5":17476,"_23883":44758,"_2389":44927},[],"Parameter",{"_2862":1268,"_25248":1211,"_17581":44929,"_5":17476,"_23883":44758,"_2389":44930},[],"Type",{"_2862":1269,"_25248":1211,"_17581":44932,"_5":17476,"_23883":44758,"_2389":44933},[],"Required",{"_2862":1270,"_25248":1211,"_17581":44935,"_5":17476,"_23883":44758,"_2389":44936},[],"Description",{"_2862":1271,"_25248":1211,"_17581":44938,"_5":17476,"_23883":44758,"_2389":44939},[],"`connector_id`",{"_2862":1272,"_25248":1211,"_17581":44941,"_5":17476,"_23883":44758,"_2389":21013},[],{"_2862":1273,"_25248":1211,"_17581":44943,"_5":17476,"_23883":44758,"_2389":44944},[],"Yes",{"_2862":1274,"_25248":1211,"_17581":44946,"_5":17476,"_23883":44758,"_2389":44947},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_2862":1275,"_25248":1211,"_17581":44949,"_5":17476,"_23883":44758,"_2389":44950},[],"`aws_config.region`",{"_2862":1276,"_25248":1211,"_17581":44952,"_5":17476,"_23883":44758,"_2389":21013},[],{"_2862":1277,"_25248":1211,"_17581":44954,"_5":17476,"_23883":44758,"_2389":44944},[],{"_2862":1278,"_25248":1211,"_17581":44956,"_5":17476,"_23883":44758,"_2389":44957},[],"AWS region where the connector operates.",{"_2862":1279,"_25248":1211,"_17581":44959,"_5":17476,"_23883":44758,"_2389":44960},[],"`aws_config.auth_method`",{"_2862":1280,"_25248":1211,"_17581":44962,"_5":17476,"_23883":44758,"_2389":21013},[],{"_2862":1281,"_25248":1211,"_17581":44964,"_5":17476,"_23883":44758,"_2389":44944},[],{"_2862":1282,"_25248":1211,"_17581":44966,"_5":17476,"_23883":44758,"_2389":44967},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_2862":1283,"_25248":1211,"_17581":44969,"_5":17476,"_23883":44758,"_2389":44970},[],"`aws_config.access_key_id`",{"_2862":1284,"_25248":1211,"_17581":44972,"_5":17476,"_23883":44758,"_2389":21013},[],{"_2862":1285,"_25248":1211,"_17581":44974,"_5":17476,"_23883":44758,"_2389":44975},[],"Only with `auth_method=static`",{"_2862":1286,"_25248":1211,"_17581":44977,"_5":17476,"_23883":44758,"_2389":44978},[],"AWS access key.",{"_2862":1287,"_25248":1211,"_17581":44980,"_5":17476,"_23883":44758,"_2389":44981},[],"`aws_config.secret_access_key`",{"_2862":1288,"_25248":1211,"_17581":44983,"_5":17476,"_23883":44758,"_2389":21013},[],{"_2862":1289,"_25248":1211,"_17581":44985,"_5":17476,"_23883":44758,"_2389":44975},[],{"_2862":1290,"_25248":1211,"_17581":44987,"_5":17476,"_23883":44758,"_2389":44988},[],"AWS secret key.",{"_2862":1291,"_25248":1211,"_17581":44990,"_5":17476,"_23883":44758,"_2389":44991},[],"`aws_config.session_token`",{"_2862":1292,"_25248":1211,"_17581":44993,"_5":17476,"_23883":44758,"_2389":21013},[],{"_2862":1293,"_25248":1211,"_17581":44995,"_5":17476,"_23883":44758,"_2389":44996},[],"No",{"_2862":1294,"_25248":1211,"_17581":44998,"_5":17476,"_23883":44758,"_2389":44999},[],"Session token (with `auth_method=static`).",{"_2862":1295,"_25248":1211,"_17581":45001,"_5":17476,"_23883":44758,"_2389":45002},[],"`aws_config.role_arn`",{"_2862":1296,"_25248":1211,"_17581":45004,"_5":17476,"_23883":44758,"_2389":21013},[],{"_2862":1297,"_25248":1211,"_17581":45006,"_5":17476,"_23883":44758,"_2389":45007},[],"Only with `auth_method=role`",{"_2862":1298,"_25248":1211,"_17581":45009,"_5":17476,"_23883":44758,"_2389":45010},[],"ARN of the role to assume.",{"_2862":1299,"_25248":1211,"_17581":45012,"_5":17476,"_23883":44758,"_2389":45013},[],"`aws_config.endpoint_url`",{"_2862":1300,"_25248":1211,"_17581":45015,"_5":17476,"_23883":44758,"_2389":21013},[],{"_2862":1301,"_25248":1211,"_17581":45017,"_5":17476,"_23883":44758,"_2389":44996},[],{"_2862":1302,"_25248":1211,"_17581":45019,"_5":17476,"_23883":44758,"_2389":45020},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_2862":1303,"_25248":1211,"_17581":45022,"_5":17476,"_23883":44758,"_2389":45023},[],"`subscriber_event_bus`",{"_2862":1304,"_25248":1211,"_17581":45025,"_5":17476,"_23883":44758,"_2389":14758},[],{"_2862":1305,"_25248":1211,"_17581":45027,"_5":17476,"_23883":44758,"_2389":44944},[],{"_2862":1306,"_25248":1211,"_17581":45029,"_5":17476,"_23883":44758,"_2389":45030},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_2862":1307,"_25248":1211,"_17581":45032,"_5":17476,"_23883":44758,"_2389":45033},[],"`dms_manager_client`",{"_2862":1308,"_25248":1211,"_17581":45035,"_5":17476,"_23883":44758,"_2389":21013},[],{"_2862":1309,"_25248":1211,"_17581":45037,"_5":17476,"_23883":44758,"_2389":44944},[],{"_2862":1310,"_25248":1211,"_17581":45039,"_5":17476,"_23883":44758,"_2389":45040},[],"HTTP URL of Lamassu's DMS Manager service.",{"_2862":1311,"_25248":1211,"_17581":45042,"_5":17476,"_23883":44758,"_2389":45043},[],"`device_manager_client`",{"_2862":1312,"_25248":1211,"_17581":45045,"_5":17476,"_23883":44758,"_2389":21013},[],{"_2862":1313,"_25248":1211,"_17581":45047,"_5":17476,"_23883":44758,"_2389":44944},[],{"_2862":1314,"_25248":1211,"_17581":45049,"_5":17476,"_23883":44758,"_2389":45050},[],"HTTP URL of Lamassu's Device Manager.",{"_2862":1315,"_25248":1211,"_17581":45052,"_5":17476,"_23883":44758,"_2389":45053},[],"`ca_client`",{"_2862":1316,"_25248":1211,"_17581":45055,"_5":17476,"_23883":44758,"_2389":21013},[],{"_2862":1317,"_25248":1211,"_17581":45057,"_5":17476,"_23883":44758,"_2389":44944},[],{"_2862":1318,"_25248":1211,"_17581":45059,"_5":17476,"_23883":44758,"_2389":45060},[],"HTTP URL of Lamassu's CA service.",{"_2862":1319,"_25248":1211,"_17581":45062,"_5":17476,"_23883":44762,"_2389":45063},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_2862":1320,"_25248":1211,"_17581":45065,"_5":17476,"_23883":44766,"_2389":45066},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_2862":1321,"_25248":1211,"_17581":45068,"_5":17476,"_23883":44766,"_2389":45069},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_2862":1322,"_25248":1211,"_17581":45071,"_5":17476,"_23883":44770,"_2389":45072},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_2862":1323,"_25248":1211,"_17581":45074,"_5":17476,"_23883":44770,"_2389":45075},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_2862":1324,"_25248":1211,"_17581":45077,"_5":17476,"_23883":44770,"_2389":45078},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_2862":1325,"_25248":1211,"_17581":45080,"_5":17476,"_23883":44770,"_2389":45081},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_2862":1326,"_25248":1211,"_17581":45083,"_5":17476,"_23883":44770,"_2389":45084},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_2862":1327,"_25248":1211,"_17581":45086,"_5":17476,"_23883":44770,"_2389":45087},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_2862":1328,"_25248":1211,"_17581":45089,"_5":17476,"_23883":44774,"_2389":45090},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_2862":1329,"_25248":1211,"_17581":45092,"_5":17476,"_23883":44778,"_2389":45093},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_2862":1330,"_25248":1211,"_17581":45095,"_5":17476,"_23883":44778,"_2389":45096},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_2862":1331,"_25248":1211,"_17581":45098,"_5":17476,"_23883":44782,"_2389":45099},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_2862":1332,"_25248":1211,"_17581":45101,"_5":17476,"_23883":44786,"_2389":45102},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_2862":1333,"_25248":1211,"_17581":45104,"_5":17476,"_23883":44786,"_2389":45105},[],"Creates or updates the IoT policies configured in the DMS.",{"_2862":1334,"_25248":1211,"_17581":45107,"_5":17476,"_23883":44786,"_2389":45108},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_2862":1335,"_25248":1211,"_17581":45110,"_5":17476,"_23883":44786,"_2389":45111},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_2862":1336,"_25248":1211,"_17581":45113,"_5":17476,"_23883":44786,"_2389":45114},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_2862":1337,"_25248":1211,"_17581":45116,"_5":17476,"_23883":44786,"_2389":45117},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_2862":1338,"_25248":1211,"_17581":45119,"_5":17476,"_23883":44786,"_2389":45120},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_2862":1339,"_25248":1211,"_17581":45122,"_5":17476,"_23883":44790,"_2389":45123},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_2862":1340,"_25248":1211,"_17581":45125,"_5":17476,"_23883":44790,"_2389":45126},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_2862":1341,"_25248":1211,"_17581":45128,"_5":17476,"_23883":44790,"_2389":45129},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_2862":1342,"_25248":1211,"_17581":45131,"_5":17476,"_23883":44794,"_2389":45132},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_2862":1343,"_25248":1211,"_17581":45134,"_5":17476,"_23883":44794,"_2389":45135},[],"The full flow from the device's perspective is:",{"_2862":1344,"_25248":1211,"_17581":45137,"_5":17476,"_23883":44794,"_2389":45138},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_2862":1345,"_25248":1211,"_17581":45140,"_5":17476,"_23883":44798,"_2389":45141},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_2862":1346,"_25248":1211,"_17581":45143,"_5":17476,"_23883":44798,"_2389":45144},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_2862":1347,"_25248":1211,"_17581":45146,"_5":17476,"_23883":44798,"_2389":45147},[],"For the JITP flow to work correctly:",{"_2862":1348,"_25248":1211,"_17581":45149,"_5":17476,"_23883":44798,"_2389":45150},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_2862":1349,"_25248":1211,"_17581":45152,"_5":17476,"_23883":44798,"_2389":45153},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_2862":1350,"_25248":1211,"_17581":45155,"_5":17476,"_23883":44798,"_2389":45156},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_2862":1351,"_25248":1211,"_17581":45158,"_5":17476,"_23883":44798,"_2389":45159},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_2862":1352,"_25248":1211,"_17581":45161,"_5":17476,"_23883":44802,"_2389":45162},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_2862":1353,"_25248":1211,"_17581":45164,"_5":17476,"_23883":44802,"_2389":45165},[],"Status in Lamassu",{"_2862":1354,"_25248":1211,"_17581":45167,"_5":17476,"_23883":44802,"_2389":45168},[],"Revocation reason",{"_2862":1355,"_25248":1211,"_17581":45170,"_5":17476,"_23883":44802,"_2389":45171},[],"Status in AWS IoT Core",{"_2862":1356,"_25248":1211,"_17581":45173,"_5":17476,"_23883":44802,"_2389":45174},[],"`Active`",{"_2862":1357,"_25248":1211,"_17581":45176,"_5":17476,"_23883":44802,"_2389":45177},[],"None",{"_2862":1358,"_25248":1211,"_17581":45179,"_5":17476,"_23883":44802,"_2389":45180},[],"`ACTIVE`",{"_2862":1359,"_25248":1211,"_17581":45182,"_5":17476,"_23883":44802,"_2389":45183},[],"`Revoked`",{"_2862":1360,"_25248":1211,"_17581":45185,"_5":17476,"_23883":44802,"_2389":45186},[],"`certificateHold`",{"_2862":1361,"_25248":1211,"_17581":45188,"_5":17476,"_23883":44802,"_2389":45189},[],"`INACTIVE`",{"_2862":1362,"_25248":1211,"_17581":45191,"_5":17476,"_23883":44802,"_2389":45183},[],{"_2862":1363,"_25248":1211,"_17581":45193,"_5":17476,"_23883":44802,"_2389":45194},[],"Any other reason",{"_2862":1364,"_25248":1211,"_17581":45196,"_5":17476,"_23883":44802,"_2389":45197},[],"`REVOKED`",{"_2862":1365,"_25248":1211,"_17581":45199,"_5":17476,"_23883":44802,"_2389":45200},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_2862":1366,"_25248":1211,"_17581":45202,"_5":17476,"_23883":44806,"_2389":45203},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_2862":1367,"_25248":1211,"_17581":45205,"_5":17476,"_23883":44806,"_2389":45206},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_2862":1368,"_25248":1211,"_17581":45208,"_5":17476,"_23883":44806,"_2389":45209},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_2862":1369,"_25248":1211,"_17581":45211,"_5":17476,"_23883":44810,"_2389":45212},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_2862":1370,"_25248":1211,"_17581":45214,"_5":17476,"_23883":44810,"_2389":45215},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_2862":1371,"_25248":1211,"_17581":45217,"_5":17476,"_23883":44814,"_2389":45218},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_2862":1372,"_25248":1211,"_17581":45220,"_5":17476,"_23883":44814,"_2389":45221},[],"There are two action types:",{"_2862":1373,"_25248":1211,"_17581":45223,"_5":17476,"_23883":44814,"_2389":45224},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_2862":1374,"_25248":1211,"_17581":45226,"_5":17476,"_23883":44814,"_2389":45227},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_2862":1375,"_25248":1211,"_17581":45229,"_5":17476,"_23883":44814,"_2389":45230},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_2862":1376,"_25248":1211,"_17581":45232,"_5":17476,"_23883":44818,"_2389":45233},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_2862":1377,"_25248":1211,"_17581":45235,"_5":17476,"_23883":44818,"_2389":45236},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_2862":1378,"_25248":1211,"_17581":45238,"_5":17476,"_23883":44818,"_2389":45239},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_2862":1379,"_25248":1211,"_17581":45241,"_5":17476,"_23883":44822,"_2389":45242},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_2862":1380,"_25248":1211,"_17581":45244,"_5":17476,"_23883":44822,"_2389":45245},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_2862":1381,"_25248":1211,"_17581":45247,"_5":17476,"_23883":44822,"_2389":45248},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_2862":1382,"_25248":1211,"_17581":45250,"_5":17476,"_23883":44822,"_2389":45251},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_2862":1383,"_25248":1211,"_17581":45253,"_5":17476,"_23883":44822,"_2389":45254},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_2862":1384,"_25248":1211,"_17581":45256,"_5":17476,"_23883":44822,"_2389":45257},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_2862":1385,"_25248":1211,"_17581":45259,"_5":17476,"_23883":44822,"_2389":45260},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_2862":1386,"_25248":1211,"_17581":45262,"_5":17476,"_23883":44822,"_2389":45263},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_2862":1387,"_25248":1211,"_17581":45265,"_5":17476,"_23883":44822,"_2389":45266},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_2862":1388,"_25248":1211,"_17581":45268,"_5":17476,"_23883":44822,"_2389":45269},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_2862":1389,"_25248":1211,"_17581":45271,"_5":17476,"_23883":44822,"_2389":45272},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_2862":1390,"_25248":1211,"_17581":45274,"_5":17476,"_23883":44822,"_2389":45275},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_2862":1391,"_25248":1211,"_17581":45277,"_5":17476,"_23883":44822,"_2389":45278},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_2862":1392,"_25248":1211,"_17581":45280,"_5":17476,"_23883":44822,"_2389":45281},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_2862":1393,"_25248":1211,"_17581":45283,"_5":17476,"_23883":44822,"_2389":45284},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_2862":1394,"_25248":1211,"_17581":45286,"_5":17476,"_23883":44822,"_2389":45287},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_2862":1395,"_25248":1211,"_17581":45289,"_5":17476,"_23883":44822,"_2389":45290},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_2862":1396,"_25248":1211,"_17581":45292,"_5":17476,"_23883":44822,"_2389":45293},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_2862":1397,"_25248":1211,"_17581":45295,"_5":17476,"_23883":44822,"_2389":45296},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2862":1398,"_25248":1211,"_17581":45298,"_5":17476,"_23883":44822,"_2389":45299},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2862":1399,"_25248":1211,"_17581":45301,"_5":17476,"_23883":44822,"_2389":45302},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_2862":1400,"_25248":1400,"_5":12326,"_2389":43298,"_25584":45304,"_17581":45305,"_23883":1400},[40961,42324,43298],[],{"_2862":1401,"_25248":1400,"_17581":45307,"_5":17476,"_23883":1400,"_2389":45308},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_2862":1402,"_25248":1400,"_5":25581,"_17581":45310,"_23883":45311,"_2389":45312},[],"/docs/pr-preview/pr-45/platform/iot-fleets/overview#start-here","Start here",{"_2862":1403,"_25248":1400,"_5":25581,"_17581":45314,"_23883":45315,"_2389":43296},[],"/docs/pr-preview/pr-45/platform/iot-fleets/overview#devices-and-identities",{"_2862":1404,"_25248":1400,"_5":25581,"_17581":45317,"_23883":45318,"_2389":43479},[],"/docs/pr-preview/pr-45/platform/iot-fleets/overview#enrollment-with-pki",{"_2862":1405,"_25248":1400,"_5":25581,"_17581":45320,"_23883":45321,"_2389":44739},[],"/docs/pr-preview/pr-45/platform/iot-fleets/overview#integrations",{"_2862":1406,"_25248":1400,"_5":25581,"_17581":45323,"_23883":45324,"_2389":45325},[],"/docs/pr-preview/pr-45/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_2862":1407,"_25248":1400,"_17581":45327,"_5":17476,"_23883":1400,"_2389":45328},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_2862":1408,"_25248":1400,"_17581":45330,"_5":17476,"_23883":45311,"_2389":45331},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_2862":1409,"_25248":1400,"_17581":45333,"_5":17476,"_23883":45311,"_2389":45334},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_2862":1410,"_25248":1400,"_17581":45336,"_5":17476,"_23883":45315,"_2389":45337},[],"Resource",{"_2862":1411,"_25248":1400,"_17581":45339,"_5":17476,"_23883":45315,"_2389":45340},[],"What it represents",{"_2862":1412,"_25248":1400,"_17581":45342,"_5":17476,"_23883":45315,"_2389":45343},[],"**Device**",{"_2862":1413,"_25248":1400,"_17581":45345,"_5":17476,"_23883":45315,"_2389":45346},[],"An inventory entry with an identifier, owning DMS and classification.",{"_2862":1414,"_25248":1400,"_17581":45348,"_5":17476,"_23883":45315,"_2389":45349},[],"**Identity**",{"_2862":1415,"_25248":1400,"_17581":45351,"_5":17476,"_23883":45315,"_2389":45352},[],"The device's association with its certificates: an active version and a history.",{"_2862":1416,"_25248":1400,"_17581":45354,"_5":17476,"_23883":45315,"_2389":45355},[],"**DMS**",{"_2862":1417,"_25248":1400,"_17581":45357,"_5":17476,"_23883":45315,"_2389":45358},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_2862":1418,"_25248":1400,"_17581":45360,"_5":17476,"_23883":45315,"_2389":45361},[],"**Fleet**",{"_2862":1419,"_25248":1400,"_17581":45363,"_5":17476,"_23883":45315,"_2389":45364},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_2862":1420,"_25248":1400,"_17581":45366,"_5":17476,"_23883":45315,"_2389":45367},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_2862":1421,"_25248":1400,"_17581":45369,"_5":17476,"_23883":45315,"_2389":45370},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_2862":1422,"_25248":1400,"_17581":45372,"_5":17476,"_23883":45318,"_2389":45373},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_2862":1423,"_25248":1400,"_17581":45375,"_5":17476,"_23883":45318,"_2389":45376},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_2862":1424,"_25248":1400,"_17581":45378,"_5":17476,"_23883":45318,"_2389":45379},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_2862":1425,"_25248":1400,"_17581":45381,"_5":17476,"_23883":45318,"_2389":45382},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_2862":1426,"_25248":1400,"_17581":45384,"_5":17476,"_23883":45318,"_2389":45385},[],"**Result:** request the certificate, install it and check its association with the device.",{"_2862":1427,"_25248":1400,"_17581":45387,"_5":17476,"_23883":45318,"_2389":45388},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_2862":1428,"_25248":1400,"_17581":45390,"_5":17476,"_23883":45318,"_2389":45391},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2862":1429,"_25248":1400,"_17581":45393,"_5":17476,"_23883":45318,"_2389":45394},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2862":1430,"_25248":1400,"_17581":45396,"_5":17476,"_23883":45321,"_2389":45397},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_2862":1431,"_25248":1400,"_17581":45399,"_5":17476,"_23883":45321,"_2389":45400},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_2862":1432,"_25248":1400,"_17581":45402,"_5":17476,"_23883":45324,"_2389":45403},[],"Participant",{"_2862":1433,"_25248":1400,"_17581":45405,"_5":17476,"_23883":45324,"_2389":45406},[],"Responsibility",{"_2862":1434,"_25248":1400,"_17581":45408,"_5":17476,"_23883":45324,"_2389":45409},[],"PKI administrator",{"_2862":1435,"_25248":1400,"_17581":45411,"_5":17476,"_23883":45324,"_2389":45412},[],"CA, issuance profile, chain and revocation publication.",{"_2862":1436,"_25248":1400,"_17581":45414,"_5":17476,"_23883":45324,"_2389":45415},[],"Provisioning administrator",{"_2862":1437,"_25248":1400,"_17581":45417,"_5":17476,"_23883":45324,"_2389":45418},[],"DMS, admission, authentication per operation and inventory.",{"_2862":1438,"_25248":1400,"_17581":45420,"_5":17476,"_23883":45324,"_2389":45421},[],"Device integrator",{"_2862":1439,"_25248":1400,"_17581":45423,"_5":17476,"_23883":45324,"_2389":45424},[],"Initial credential, key, EST client, trust and certificate installation.",{"_2862":1440,"_25248":1400,"_17581":45426,"_5":17476,"_23883":45324,"_2389":45427},[],"Consumer integrator",{"_2862":1441,"_25248":1400,"_17581":45429,"_5":17476,"_23883":45324,"_2389":45430},[],"Trusted issuers, validation and device permissions in the destination.",{"_2862":1442,"_25248":1400,"_17581":45432,"_5":17476,"_23883":45324,"_2389":45433},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_2862":1443,"_25248":1443,"_5":12326,"_2389":45435,"_25584":45436,"_17581":45438,"_23883":1443},"Enroll and connect your first device",[40961,42324,43298,45437],"Getting started",[],{"_2862":1444,"_25248":1443,"_17581":45440,"_5":17476,"_23883":1443,"_2389":45441},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_2862":1445,"_25248":1443,"_5":25581,"_17581":45443,"_23883":45444,"_2389":40971},[],"/docs/pr-preview/pr-45/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_2862":1446,"_25248":1443,"_5":25581,"_17581":45446,"_23883":45447,"_2389":45448},[],"/docs/pr-preview/pr-45/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_2862":1447,"_25248":1443,"_5":25581,"_17581":45450,"_23883":45451,"_2389":45452},[],"/docs/pr-preview/pr-45/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_2862":1448,"_25248":1443,"_5":25581,"_17581":45454,"_23883":45455,"_2389":45456},[],"/docs/pr-preview/pr-45/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_2862":1449,"_25248":1443,"_5":25581,"_17581":45458,"_23883":45459,"_2389":45460},[],"/docs/pr-preview/pr-45/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_2862":1450,"_25248":1443,"_5":25581,"_17581":45462,"_23883":45463,"_2389":45464},[],"/docs/pr-preview/pr-45/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_2862":1451,"_25248":1443,"_5":25581,"_17581":45466,"_23883":45467,"_2389":45468},[],"/docs/pr-preview/pr-45/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_2862":1452,"_25248":1443,"_5":25581,"_17581":45470,"_23883":45471,"_2389":45472},[],"/docs/pr-preview/pr-45/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_2862":1453,"_25248":1443,"_17581":45474,"_5":17476,"_23883":1443,"_2389":45475},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_2862":1454,"_25248":1443,"_17581":45477,"_5":17476,"_23883":45444,"_2389":45478},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_2862":1455,"_25248":1443,"_17581":45480,"_5":17476,"_23883":45444,"_2389":45481},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_2862":1456,"_25248":1443,"_17581":45483,"_5":17476,"_23883":45444,"_2389":45484},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_2862":1457,"_25248":1443,"_17581":45486,"_5":17476,"_23883":45444,"_2389":45487},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_2862":1458,"_25248":1443,"_17581":45489,"_5":17476,"_23883":45444,"_2389":45490},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_2862":1459,"_25248":1443,"_17581":45492,"_5":17476,"_23883":45447,"_2389":45493},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_2862":1460,"_25248":1443,"_17581":45495,"_5":17476,"_23883":45447,"_2389":45496},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_2862":1461,"_25248":1443,"_17581":45498,"_5":17476,"_23883":45451,"_2389":45499},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_2862":1462,"_25248":1443,"_17581":45501,"_5":17476,"_23883":45451,"_2389":45502},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_2862":1463,"_25248":1443,"_17581":45504,"_5":17476,"_23883":45451,"_2389":45505},[],"Setting",{"_2862":1464,"_25248":1443,"_17581":45507,"_5":17476,"_23883":45451,"_2389":45508},[],"Evaluation value",{"_2862":1465,"_25248":1443,"_17581":45510,"_5":17476,"_23883":45451,"_2389":45511},[],"Enrollment CA",{"_2862":1466,"_25248":1443,"_17581":45513,"_5":17476,"_23883":45451,"_2389":45514},[],"Issuing root from `device-root.pem`.",{"_2862":1467,"_25248":1443,"_17581":45516,"_5":17476,"_23883":45451,"_2389":43609},[],{"_2862":1468,"_25248":1443,"_17581":45518,"_5":17476,"_23883":45451,"_2389":45519},[],"The 1-hour leaf profile you just prepared.",{"_2862":1469,"_25248":1443,"_17581":45521,"_5":17476,"_23883":45451,"_2389":45522},[],"Protocol / Registration Mode",{"_2862":1470,"_25248":1443,"_17581":45524,"_5":17476,"_23883":45451,"_2389":45525},[],"`EST_RFC7030` / `JITP`.",{"_2862":1471,"_25248":1443,"_17581":45527,"_5":17476,"_23883":45451,"_2389":45528},[],"Verify CSR Signature",{"_2862":1472,"_25248":1443,"_17581":45530,"_5":17476,"_23883":45451,"_2389":45531},[],"Enabled.",{"_2862":1473,"_25248":1443,"_17581":45533,"_5":17476,"_23883":45451,"_2389":45534},[],"Enable Replaceable Enrollment",{"_2862":1474,"_25248":1443,"_17581":45536,"_5":17476,"_23883":45451,"_2389":45537},[],"Disabled; the ID must be new.",{"_2862":1475,"_25248":1443,"_17581":45539,"_5":17476,"_23883":45451,"_2389":45540},[],"Initial authentication",{"_2862":1476,"_25248":1443,"_17581":45542,"_5":17476,"_23883":45451,"_2389":45543},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_2862":1477,"_25248":1443,"_17581":45545,"_5":17476,"_23883":45451,"_2389":45546},[],"Renewal authentication",{"_2862":1478,"_25248":1443,"_17581":45548,"_5":17476,"_23883":45451,"_2389":45549},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_2862":1479,"_25248":1443,"_17581":45551,"_5":17476,"_23883":45451,"_2389":45552},[],"Additional Validation CAs / Enable Expired Renewal",{"_2862":1480,"_25248":1443,"_17581":45554,"_5":17476,"_23883":45451,"_2389":45555},[],"Empty list for this direct issuance / disabled.",{"_2862":1481,"_25248":1443,"_17581":45557,"_5":17476,"_23883":45451,"_2389":45558},[],"Re-enrollment Delta",{"_2862":1482,"_25248":1443,"_17581":45560,"_5":17476,"_23883":45451,"_2389":45561},[],"1 hour.",{"_2862":1483,"_25248":1443,"_17581":45563,"_5":17476,"_23883":45451,"_2389":45564},[],"Preventive / Critical Delta",{"_2862":1484,"_25248":1443,"_17581":45566,"_5":17476,"_23883":45451,"_2389":45567},[],"30 minutes / 10 minutes.",{"_2862":1485,"_25248":1443,"_17581":45569,"_5":17476,"_23883":45451,"_2389":45570},[],"Revoke on Re-enrollment",{"_2862":1486,"_25248":1443,"_17581":45572,"_5":17476,"_23883":45451,"_2389":45573},[],"Disabled to test the successor before retiring the previous identity.",{"_2862":1487,"_25248":1443,"_17581":45575,"_5":17476,"_23883":45451,"_2389":43617},[],{"_2862":1488,"_25248":1443,"_17581":45577,"_5":17476,"_23883":45451,"_2389":45578},[],"Disabled; the operational key is generated in the client.",{"_2862":1489,"_25248":1443,"_17581":45580,"_5":17476,"_23883":45451,"_2389":45581},[],"CA Distribution",{"_2862":1490,"_25248":1443,"_17581":45583,"_5":17476,"_23883":45451,"_2389":45584},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_2862":1491,"_25248":1443,"_17581":45586,"_5":17476,"_23883":45451,"_2389":45587},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. If your console does not expose the independent block, configure and check the resource through the DMS API and DMS guide.",{"_2862":1492,"_25248":1443,"_17581":45589,"_5":17476,"_23883":45455,"_2389":45590},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_2862":1493,"_25248":1443,"_17581":45592,"_5":17476,"_23883":45455,"_2389":45593},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_2862":1494,"_25248":1443,"_17581":45595,"_5":17476,"_23883":45459,"_2389":45596},[],"Generate a new key and CSR with the selected identifier:",{"_2862":1495,"_25248":1443,"_17581":45598,"_5":17476,"_23883":45459,"_2389":45599},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_2862":1496,"_25248":1443,"_17581":45601,"_5":17476,"_23883":45459,"_2389":45602},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_2862":1497,"_25248":1443,"_17581":45604,"_5":17476,"_23883":45463,"_2389":45605},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_2862":1498,"_25248":1443,"_17581":45607,"_5":17476,"_23883":45463,"_2389":45608},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_2862":1499,"_25248":1443,"_17581":45610,"_5":17476,"_23883":45467,"_2389":45611},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_2862":1500,"_25248":1443,"_17581":45613,"_5":17476,"_23883":45467,"_2389":45614},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_2862":1501,"_25248":1443,"_17581":45616,"_5":17476,"_23883":45467,"_2389":45617},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_2862":1502,"_25248":1443,"_17581":45619,"_5":17476,"_23883":45467,"_2389":45620},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_2862":1503,"_25248":1443,"_17581":45622,"_5":17476,"_23883":45467,"_2389":45623},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_2862":1504,"_25248":1443,"_17581":45625,"_5":17476,"_23883":45471,"_2389":45626},[],"Check",{"_2862":1505,"_25248":1443,"_17581":45628,"_5":17476,"_23883":45471,"_2389":45629},[],"Expected result",{"_2862":1506,"_25248":1443,"_17581":45631,"_5":17476,"_23883":45471,"_2389":45632},[],"Registration",{"_2862":1507,"_25248":1443,"_17581":45634,"_5":17476,"_23883":45471,"_2389":45635},[],"ID created automatically and correct DMS.",{"_2862":1508,"_25248":1443,"_17581":45637,"_5":17476,"_23883":45471,"_2389":45638},[],"Certificate",{"_2862":1509,"_25248":1443,"_17581":45640,"_5":17476,"_23883":45471,"_2389":45641},[],"CN, profile, serial and key verified.",{"_2862":1510,"_25248":1443,"_17581":45643,"_5":17476,"_23883":45471,"_2389":45644},[],"Inventory",{"_2862":1511,"_25248":1443,"_17581":45646,"_5":17476,"_23883":45471,"_2389":45647},[],"Received serial visible as the current identity and in history.",{"_2862":1512,"_25248":1443,"_17581":45649,"_5":17476,"_23883":45471,"_2389":45650},[],"Consumer",{"_2862":1513,"_25248":1443,"_17581":45652,"_5":17476,"_23883":45471,"_2389":45653},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_2862":1514,"_25248":1443,"_17581":45655,"_5":17476,"_23883":45471,"_2389":45656},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_2862":1515,"_25248":1443,"_17581":45658,"_5":17476,"_23883":45471,"_2389":45659},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_2862":1516,"_25248":1516,"_5":12326,"_2389":43314,"_25584":45661,"_17581":45662,"_23883":1516},[40961,42324,43298,45437],[],{"_2862":1517,"_25248":1516,"_17581":45664,"_5":17476,"_23883":1516,"_2389":45665},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_2862":1518,"_25248":1516,"_5":25581,"_17581":45667,"_23883":45668,"_2389":40971},[],"/docs/pr-preview/pr-45/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_2862":1519,"_25248":1516,"_5":25581,"_17581":45670,"_23883":45671,"_2389":45672},[],"/docs/pr-preview/pr-45/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_2862":1520,"_25248":1516,"_5":25581,"_17581":45674,"_23883":45675,"_2389":45676},[],"/docs/pr-preview/pr-45/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_2862":1521,"_25248":1516,"_5":25581,"_17581":45678,"_23883":45679,"_2389":45680},[],"/docs/pr-preview/pr-45/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_2862":1522,"_25248":1516,"_5":25581,"_17581":45682,"_23883":45683,"_2389":45684},[],"/docs/pr-preview/pr-45/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_2862":1523,"_25248":1516,"_5":25581,"_17581":45686,"_23883":45687,"_2389":45688},[],"/docs/pr-preview/pr-45/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_2862":1524,"_25248":1516,"_5":25581,"_17581":45690,"_23883":45691,"_2389":45629},[],"/docs/pr-preview/pr-45/platform/iot-fleets/quickstarts/register-device#expected-result",{"_2862":1525,"_25248":1516,"_5":25581,"_17581":45693,"_23883":45694,"_2389":45695},[],"/docs/pr-preview/pr-45/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_2862":1526,"_25248":1516,"_5":25581,"_17581":45697,"_23883":45698,"_2389":45699},[],"/docs/pr-preview/pr-45/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_2862":1527,"_25248":1516,"_17581":45701,"_5":17476,"_23883":1516,"_2389":45702},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_2862":1528,"_25248":1516,"_17581":45704,"_5":17476,"_23883":1516,"_2389":45705},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_2862":1529,"_25248":1516,"_17581":45707,"_5":17476,"_23883":45668,"_2389":45708},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_2862":1530,"_25248":1516,"_17581":45710,"_5":17476,"_23883":45668,"_2389":45711},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_2862":1531,"_25248":1516,"_17581":45713,"_5":17476,"_23883":45668,"_2389":45714},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_2862":1532,"_25248":1516,"_17581":45716,"_5":17476,"_23883":45668,"_2389":45717},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_2862":1533,"_25248":1516,"_17581":45719,"_5":17476,"_23883":45671,"_2389":45720},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_2862":1534,"_25248":1516,"_17581":45722,"_5":17476,"_23883":45671,"_2389":45723},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_2862":1535,"_25248":1516,"_17581":45725,"_5":17476,"_23883":45671,"_2389":45726},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_2862":1536,"_25248":1516,"_17581":45728,"_5":17476,"_23883":45671,"_2389":45729},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_2862":1537,"_25248":1516,"_17581":45731,"_5":17476,"_23883":45671,"_2389":45732},[],"Set **Authentication Mode** to `CLIENT_CERTIFICATE` and add the CA whose initial certificates you will accept in **Validation CAs**. For this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and server key generation disabled if you will not use it.",{"_2862":1538,"_25248":1516,"_17581":45734,"_5":17476,"_23883":45671,"_2389":45735},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_2862":1539,"_25248":1516,"_17581":45737,"_5":17476,"_23883":45671,"_2389":45738},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_2862":1540,"_25248":1516,"_17581":45740,"_5":17476,"_23883":45671,"_2389":45741},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_2862":1541,"_25248":1516,"_17581":45743,"_5":17476,"_23883":45675,"_2389":45744},[],"Open **Managed Devices** and the registration action. Complete:",{"_2862":1542,"_25248":1516,"_17581":45746,"_5":17476,"_23883":45675,"_2389":45747},[],"**Device ID**: `device-001`.",{"_2862":1543,"_25248":1516,"_17581":45749,"_5":17476,"_23883":45675,"_2389":45750},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_2862":1544,"_25248":1516,"_17581":45752,"_5":17476,"_23883":45675,"_2389":45753},[],"**Icon** and **Tags**: optional classification.",{"_2862":1545,"_25248":1516,"_17581":45755,"_5":17476,"_23883":45675,"_2389":45756},[],"Confirm registration.",{"_2862":1546,"_25248":1516,"_17581":45758,"_5":17476,"_23883":45679,"_2389":45759},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_2862":1547,"_25248":1516,"_17581":45761,"_5":17476,"_23883":45679,"_2389":45762},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_2862":1548,"_25248":1516,"_17581":45764,"_5":17476,"_23883":45683,"_2389":45765},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_2862":1549,"_25248":1516,"_17581":45767,"_5":17476,"_23883":45683,"_2389":45768},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_2862":1550,"_25248":1516,"_17581":45770,"_5":17476,"_23883":45687,"_2389":45771},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_2862":1551,"_25248":1516,"_17581":45773,"_5":17476,"_23883":45687,"_2389":45774},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_2862":1552,"_25248":1516,"_17581":45776,"_5":17476,"_23883":45691,"_2389":45626},[],{"_2862":1553,"_25248":1516,"_17581":45778,"_5":17476,"_23883":45691,"_2389":45779},[],"Result",{"_2862":1554,"_25248":1516,"_17581":45781,"_5":17476,"_23883":45691,"_2389":45782},[],"Device",{"_2862":1555,"_25248":1516,"_17581":45784,"_5":17476,"_23883":45691,"_2389":45785},[],"`device-001` appears in inventory with the expected DMS.",{"_2862":1556,"_25248":1516,"_17581":45787,"_5":17476,"_23883":45691,"_2389":45788},[],"Current identity",{"_2862":1557,"_25248":1516,"_17581":45790,"_5":17476,"_23883":45691,"_2389":45791},[],"The associated certificate matches the one you verified in PKI.",{"_2862":1558,"_25248":1516,"_17581":45793,"_5":17476,"_23883":45691,"_2389":45794},[],"History",{"_2862":1559,"_25248":1516,"_17581":45796,"_5":17476,"_23883":45691,"_2389":45797},[],"The associated issuance appears with its serial number and dates.",{"_2862":1560,"_25248":1516,"_17581":45799,"_5":17476,"_23883":45691,"_2389":45800},[],"Key and certificate",{"_2862":1561,"_25248":1516,"_17581":45802,"_5":17476,"_23883":45691,"_2389":45803},[],"You have the verified pair ready to install on the device.",{"_2862":1562,"_25248":1516,"_17581":45805,"_5":17476,"_23883":45694,"_2389":45806},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_2862":1563,"_25248":1516,"_17581":45808,"_5":17476,"_23883":45694,"_2389":45809},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_2862":1564,"_25248":1516,"_17581":45811,"_5":17476,"_23883":45694,"_2389":45812},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_2862":1565,"_25248":1516,"_17581":45814,"_5":17476,"_23883":45694,"_2389":45815},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_2862":1566,"_25248":1516,"_17581":45817,"_5":17476,"_23883":45698,"_2389":45818},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_2862":1567,"_25248":1516,"_17581":45820,"_5":17476,"_23883":45698,"_2389":45821},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_2862":1568,"_25248":1516,"_17581":45823,"_5":17476,"_23883":45698,"_2389":45824},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_2862":1569,"_25248":1569,"_5":12326,"_2389":45826,"_25584":45827,"_17581":45828,"_23883":1569},"Lamassu IoT Platform",[40961,42324],[],{"_2862":1570,"_25248":1569,"_17581":45830,"_5":17476,"_23883":1569,"_2389":45831},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_2862":1571,"_25248":1569,"_5":25581,"_17581":45833,"_23883":45834,"_2389":45312},[],"/docs/pr-preview/pr-45/platform/overview#start-here",{"_2862":1572,"_25248":1569,"_5":25581,"_17581":45836,"_23883":45837,"_2389":45838},[],"/docs/pr-preview/pr-45/platform/overview#choose-your-path","Choose your path",{"_2862":1573,"_25248":1569,"_5":25581,"_17581":45840,"_23883":45841,"_2389":45842},[],"/docs/pr-preview/pr-45/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_2862":1574,"_25248":1569,"_5":25581,"_17581":45844,"_23883":45845,"_2389":45846},[],"/docs/pr-preview/pr-45/platform/overview#core-capabilities","Core capabilities",{"_2862":1575,"_25248":1569,"_5":25581,"_17581":45848,"_23883":45849,"_2389":45850},[],"/docs/pr-preview/pr-45/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_2862":1576,"_25248":1569,"_5":25581,"_17581":45852,"_23883":45853,"_2389":45854},[],"/docs/pr-preview/pr-45/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_2862":1577,"_25248":1569,"_5":25581,"_17581":45856,"_23883":45857,"_2389":45858},[],"/docs/pr-preview/pr-45/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_2862":1578,"_25248":1569,"_5":25581,"_17581":45860,"_23883":45861,"_2389":45862},[],"/docs/pr-preview/pr-45/platform/overview#automate-device-identities","Automate device identities",{"_2862":1579,"_25248":1569,"_5":25581,"_17581":45864,"_23883":45865,"_2389":45866},[],"/docs/pr-preview/pr-45/platform/overview#publish-validation-status","Publish validation status",{"_2862":1580,"_25248":1569,"_5":25581,"_17581":45868,"_23883":45869,"_2389":45870},[],"/docs/pr-preview/pr-45/platform/overview#react-to-events","React to events",{"_2862":1581,"_25248":1569,"_5":25581,"_17581":45872,"_23883":45873,"_2389":45874},[],"/docs/pr-preview/pr-45/platform/overview#operational-reference","Operational reference",{"_2862":1582,"_25248":1569,"_17581":45876,"_5":17476,"_23883":1569,"_2389":45877},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_2862":1583,"_25248":1569,"_17581":45879,"_5":17476,"_23883":45834,"_2389":45880},[],"Choose the result you need:",{"_2862":1584,"_25248":1569,"_17581":45882,"_5":17476,"_23883":45834,"_2389":45883},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2862":1585,"_25248":1569,"_17581":45885,"_5":17476,"_23883":45834,"_2389":45886},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2862":1586,"_25248":1569,"_17581":45888,"_5":17476,"_23883":45834,"_2389":45889},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_2862":1587,"_25248":1569,"_17581":45891,"_5":17476,"_23883":45837,"_2389":45892},[],"Section",{"_2862":1588,"_25248":1569,"_17581":45894,"_5":17476,"_23883":45837,"_2389":45895},[],"What you manage",{"_2862":1589,"_25248":1569,"_17581":45897,"_5":17476,"_23883":45837,"_2389":45898},[],"Entry point",{"_2862":1590,"_25248":1569,"_17581":45900,"_5":17476,"_23883":45837,"_2389":45901},[],"**PKI**",{"_2862":1591,"_25248":1569,"_17581":45903,"_5":17476,"_23883":45837,"_2389":45904},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_2862":1592,"_25248":1569,"_17581":45906,"_5":17476,"_23883":45837,"_2389":45907},[],"PKI overview",{"_2862":1593,"_25248":1569,"_17581":45909,"_5":17476,"_23883":45837,"_2389":45910},[],"**IoT Fleets**",{"_2862":1594,"_25248":1569,"_17581":45912,"_5":17476,"_23883":45837,"_2389":45913},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_2862":1595,"_25248":1569,"_17581":45915,"_5":17476,"_23883":45837,"_2389":45916},[],"IoT Fleets overview",{"_2862":1596,"_25248":1569,"_17581":45918,"_5":17476,"_23883":45837,"_2389":45919},[],"**Administration**",{"_2862":1597,"_25248":1569,"_17581":45921,"_5":17476,"_23883":45837,"_2389":45922},[],"Operator permissions, audit and event subscriptions.",{"_2862":1598,"_25248":1569,"_17581":45924,"_5":17476,"_23883":45837,"_2389":42322},[],{"_2862":1599,"_25248":1569,"_17581":45926,"_5":17476,"_23883":45837,"_2389":45927},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_2862":1600,"_25248":1569,"_17581":45929,"_5":17476,"_23883":45841,"_2389":45930},[],"An identity's journey connects four responsibilities:",{"_2862":1601,"_25248":1569,"_17581":45932,"_5":17476,"_23883":45841,"_2389":45933},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_2862":1602,"_25248":1569,"_17581":45935,"_5":17476,"_23883":45841,"_2389":45936},[],"The provisioning administrator configures the DMS and initial trust.",{"_2862":1603,"_25248":1569,"_17581":45938,"_5":17476,"_23883":45841,"_2389":45939},[],"The device client requests a certificate and installs it with the matching key.",{"_2862":1604,"_25248":1569,"_17581":45941,"_5":17476,"_23883":45841,"_2389":45942},[],"The consumer validates the identity and applies its access permissions.",{"_2862":1605,"_25248":1569,"_17581":45944,"_5":17476,"_23883":45841,"_2389":45945},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_2862":1606,"_25248":1569,"_17581":45947,"_5":17476,"_23883":45849,"_2389":45948},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_2862":1607,"_25248":1569,"_17581":45950,"_5":17476,"_23883":45853,"_2389":45951},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_2862":1608,"_25248":1569,"_17581":45953,"_5":17476,"_23883":45857,"_2389":45954},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_2862":1609,"_25248":1569,"_17581":45956,"_5":17476,"_23883":45861,"_2389":45957},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_2862":1610,"_25248":1569,"_17581":45959,"_5":17476,"_23883":45865,"_2389":45960},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_2862":1611,"_25248":1569,"_17581":45962,"_5":17476,"_23883":45869,"_2389":45963},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_2862":1612,"_25248":1569,"_17581":45965,"_5":17476,"_23883":45873,"_2389":45406},[],{"_2862":1613,"_25248":1569,"_17581":45967,"_5":17476,"_23883":45873,"_2389":45968},[],"What it prepares or checks",{"_2862":1614,"_25248":1569,"_17581":45970,"_5":17476,"_23883":45873,"_2389":45409},[],{"_2862":1615,"_25248":1569,"_17581":45972,"_5":17476,"_23883":45873,"_2389":45973},[],"Key custody, CA hierarchy, profiles and validation.",{"_2862":1616,"_25248":1569,"_17581":45975,"_5":17476,"_23883":45873,"_2389":45976},[],"Fleet administrator",{"_2862":1617,"_25248":1569,"_17581":45978,"_5":17476,"_23883":45873,"_2389":45979},[],"DMS, device admission, renewal policy and inventory.",{"_2862":1618,"_25248":1569,"_17581":45981,"_5":17476,"_23883":45873,"_2389":45421},[],{"_2862":1619,"_25248":1569,"_17581":45983,"_5":17476,"_23883":45873,"_2389":45984},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_2862":1620,"_25248":1569,"_17581":45986,"_5":17476,"_23883":45873,"_2389":45427},[],{"_2862":1621,"_25248":1569,"_17581":45988,"_5":17476,"_23883":45873,"_2389":45989},[],"Issuer trust, certificate validation and permissions in the destination.",{"_2862":1622,"_25248":1569,"_17581":45991,"_5":17476,"_23883":45873,"_2389":45992},[],"Infrastructure operator",{"_2862":1623,"_25248":1569,"_17581":45994,"_5":17476,"_23883":45873,"_2389":45995},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_2862":1624,"_25248":1569,"_17581":45997,"_5":17476,"_23883":45873,"_2389":45998},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_2862":1625,"_25248":1625,"_5":12326,"_2389":46000,"_25584":46001,"_17581":46004,"_23883":1625},"CA hierarchy and rotation",[40961,42324,46002,46003],"PKI","Keys, authorities and certificates",[],{"_2862":1626,"_25248":1625,"_17581":46006,"_5":17476,"_23883":1625,"_2389":46007},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_2862":1627,"_25248":1625,"_5":25581,"_17581":46009,"_23883":46010,"_2389":46011},[],"/docs/pr-preview/pr-45/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_2862":1628,"_25248":1625,"_5":25581,"_17581":46013,"_23883":46014,"_2389":46015},[],"/docs/pr-preview/pr-45/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_2862":1629,"_25248":1625,"_5":25581,"_17581":46017,"_23883":46018,"_2389":46019},[],"/docs/pr-preview/pr-45/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_2862":1630,"_25248":1625,"_5":25581,"_17581":46021,"_23883":46022,"_2389":46023},[],"/docs/pr-preview/pr-45/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_2862":1631,"_25248":1625,"_5":25581,"_17581":46025,"_23883":46026,"_2389":46027},[],"/docs/pr-preview/pr-45/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_2862":1632,"_25248":1625,"_5":25581,"_17581":46029,"_23883":46030,"_2389":46031},[],"/docs/pr-preview/pr-45/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_2862":1633,"_25248":1625,"_5":25581,"_17581":46033,"_23883":46034,"_2389":46035},[],"/docs/pr-preview/pr-45/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_2862":1634,"_25248":1625,"_5":25581,"_17581":46037,"_23883":46038,"_2389":46039},[],"/docs/pr-preview/pr-45/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_2862":1635,"_25248":1625,"_5":25581,"_17581":46041,"_23883":46042,"_2389":46043},[],"/docs/pr-preview/pr-45/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_2862":1636,"_25248":1625,"_5":25581,"_17581":46045,"_23883":46046,"_2389":46047},[],"/docs/pr-preview/pr-45/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_2862":1637,"_25248":1625,"_5":25581,"_17581":46049,"_23883":46050,"_2389":46051},[],"/docs/pr-preview/pr-45/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_2862":1638,"_25248":1625,"_5":25581,"_17581":46053,"_23883":46054,"_2389":46055},[],"/docs/pr-preview/pr-45/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_2862":1639,"_25248":1625,"_17581":46057,"_5":17476,"_23883":1625,"_2389":46058},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_2862":1640,"_25248":1625,"_17581":46060,"_5":17476,"_23883":1625,"_2389":46061},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_2862":1641,"_25248":1625,"_17581":46063,"_5":17476,"_23883":46010,"_2389":46064},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_2862":1642,"_25248":1625,"_17581":46066,"_5":17476,"_23883":46010,"_2389":46067},[],"environment, such as production and preproduction;",{"_2862":1643,"_25248":1625,"_17581":46069,"_5":17476,"_23883":46010,"_2389":46070},[],"owner or operating team;",{"_2862":1644,"_25248":1625,"_17581":46072,"_5":17476,"_23883":46010,"_2389":46073},[],"device family or manufacturing process;",{"_2862":1645,"_25248":1625,"_17581":46075,"_5":17476,"_23883":46010,"_2389":46076},[],"region or regulatory requirement;",{"_2862":1646,"_25248":1625,"_17581":46078,"_5":17476,"_23883":46010,"_2389":46079},[],"cryptographic engine or key policy;",{"_2862":1647,"_25248":1625,"_17581":46081,"_5":17476,"_23883":46010,"_2389":46082},[],"maintenance window and renewal cadence.",{"_2862":1648,"_25248":1625,"_17581":46084,"_5":17476,"_23883":46010,"_2389":46085},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_2862":1649,"_25248":1625,"_17581":46087,"_5":17476,"_23883":46010,"_2389":46088},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_2862":1650,"_25248":1625,"_17581":46090,"_5":17476,"_23883":46014,"_2389":46091},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_2862":1651,"_25248":1625,"_17581":46093,"_5":17476,"_23883":46014,"_2389":46094},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_2862":1652,"_25248":1625,"_17581":46096,"_5":17476,"_23883":46014,"_2389":46097},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_2862":1653,"_25248":1625,"_17581":46099,"_5":17476,"_23883":46018,"_2389":46100},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_2862":1654,"_25248":1625,"_17581":46102,"_5":17476,"_23883":46018,"_2389":46103},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_2862":1655,"_25248":1625,"_17581":46105,"_5":17476,"_23883":46018,"_2389":46106},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_2862":1656,"_25248":1625,"_17581":46108,"_5":17476,"_23883":46018,"_2389":46109},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_2862":1657,"_25248":1625,"_17581":46111,"_5":17476,"_23883":46026,"_2389":46112},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_2862":1658,"_25248":1625,"_17581":46114,"_5":17476,"_23883":46030,"_2389":46115},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_2862":1659,"_25248":1625,"_17581":46117,"_5":17476,"_23883":46034,"_2389":46118},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_2862":1660,"_25248":1625,"_17581":46120,"_5":17476,"_23883":46038,"_2389":46121},[],"Update the enrollment CA and profile of the DMSs. Keep the additional validation CAs if old certificates still need to be accepted during re-enrollment.",{"_2862":1661,"_25248":1625,"_17581":46123,"_5":17476,"_23883":46042,"_2389":46124},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_2862":1662,"_25248":1625,"_17581":46126,"_5":17476,"_23883":46046,"_2389":46127},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance and from the distributed CAs. Revoke it if policy requires it.",{"_2862":1663,"_25248":1625,"_17581":46129,"_5":17476,"_23883":46050,"_2389":46130},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_2862":1664,"_25248":1625,"_17581":46132,"_5":17476,"_23883":46050,"_2389":46133},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_2862":1665,"_25248":1625,"_17581":46135,"_5":17476,"_23883":46050,"_2389":46136},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_2862":1666,"_25248":1625,"_17581":46138,"_5":17476,"_23883":46050,"_2389":46139},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_2862":1667,"_25248":1625,"_17581":46141,"_5":17476,"_23883":46054,"_2389":46142},[],"The new chain ends in an anchor installed by the consumer.",{"_2862":1668,"_25248":1625,"_17581":46144,"_5":17476,"_23883":46054,"_2389":46145},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_2862":1669,"_25248":1625,"_17581":46147,"_5":17476,"_23883":46054,"_2389":46148},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_2862":1670,"_25248":1625,"_17581":46150,"_5":17476,"_23883":46054,"_2389":46151},[],"Re-enrollment accepts the old identity during the planned period.",{"_2862":1671,"_25248":1625,"_17581":46153,"_5":17476,"_23883":46054,"_2389":46154},[],"OCSP and CRL respond for the authorities that remain active.",{"_2862":1672,"_25248":1625,"_17581":46156,"_5":17476,"_23883":46054,"_2389":46157},[],"No DMS is left accidentally issuing from the old CA.",{"_2862":1673,"_25248":1625,"_17581":46159,"_5":17476,"_23883":46054,"_2389":46160},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_2862":1674,"_25248":1674,"_5":12326,"_2389":46162,"_25584":46163,"_17581":46164,"_23883":1674},"Certification authorities",[40961,42324,46002,46003],[],{"_2862":1675,"_25248":1674,"_17581":46166,"_5":17476,"_23883":1674,"_2389":46167},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_2862":1676,"_25248":1674,"_5":25581,"_17581":46169,"_23883":46170,"_2389":46171},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_2862":1677,"_25248":1674,"_5":25581,"_17581":46173,"_23883":46174,"_2389":46175},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_2862":1678,"_25248":1674,"_5":25581,"_17581":46177,"_23883":46178,"_2389":40971},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#before-you-begin",{"_2862":1679,"_25248":1674,"_5":25581,"_17581":46180,"_23883":46181,"_2389":46182},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_2862":1680,"_25248":1674,"_5":25581,"_17581":46184,"_23883":46185,"_2389":46186},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_2862":1681,"_25248":1674,"_5":25581,"_17581":46188,"_23883":46189,"_2389":46190},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_2862":1682,"_25248":1674,"_5":25581,"_17581":46192,"_23883":46193,"_2389":46194},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_2862":1683,"_25248":1674,"_5":25581,"_17581":46196,"_23883":46197,"_2389":46198},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_2862":1684,"_25248":1674,"_5":25581,"_17581":46200,"_23883":46201,"_2389":46202},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_2862":1685,"_25248":1674,"_5":25581,"_17581":46204,"_23883":46205,"_2389":46206},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_2862":1686,"_25248":1674,"_5":25581,"_17581":46208,"_23883":46209,"_2389":46210},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_2862":1687,"_25248":1674,"_5":25581,"_17581":46212,"_23883":46213,"_2389":46214},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_2862":1688,"_25248":1674,"_5":25581,"_17581":46216,"_23883":46217,"_2389":46218},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#load-the-material","Load the material",{"_2862":1689,"_25248":1674,"_5":25581,"_17581":46220,"_23883":46221,"_2389":46222},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_2862":1690,"_25248":1674,"_5":25581,"_17581":46224,"_23883":46225,"_2389":46226},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_2862":1691,"_25248":1674,"_5":25581,"_17581":46228,"_23883":46229,"_2389":46230},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_2862":1692,"_25248":1674,"_5":25581,"_17581":46232,"_23883":46233,"_2389":46234},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_2862":1693,"_25248":1674,"_5":25581,"_17581":46236,"_23883":46237,"_2389":46238},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_2862":1694,"_25248":1674,"_5":25581,"_17581":46240,"_23883":46241,"_2389":46242},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_2862":1695,"_25248":1674,"_5":25581,"_17581":46244,"_23883":46245,"_2389":46246},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_2862":1696,"_25248":1674,"_5":25581,"_17581":46248,"_23883":46249,"_2389":46250},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_2862":1697,"_25248":1674,"_5":25581,"_17581":46252,"_23883":46253,"_2389":46254},[],"/docs/pr-preview/pr-45/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_2862":1698,"_25248":1674,"_17581":46256,"_5":17476,"_23883":1674,"_2389":46257},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_2862":1699,"_25248":1674,"_17581":46259,"_5":17476,"_23883":1674,"_2389":46260},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_2862":1700,"_25248":1674,"_17581":46262,"_5":17476,"_23883":1674,"_2389":46263},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_2862":1701,"_25248":1674,"_17581":46265,"_5":17476,"_23883":46170,"_2389":46266},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_2862":1702,"_25248":1674,"_17581":46268,"_5":17476,"_23883":46170,"_2389":46269},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_2862":1703,"_25248":1674,"_17581":46271,"_5":17476,"_23883":46170,"_2389":46272},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_2862":1704,"_25248":1674,"_17581":46274,"_5":17476,"_23883":46170,"_2389":46275},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_2862":1705,"_25248":1674,"_17581":46277,"_5":17476,"_23883":46170,"_2389":46278},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_2862":1706,"_25248":1674,"_17581":46280,"_5":17476,"_23883":46178,"_2389":46281},[],"Decide whether the CA will be a root or an intermediate.",{"_2862":1707,"_25248":1674,"_17581":46283,"_5":17476,"_23883":46178,"_2389":46284},[],"Choose the engine that will keep the key.",{"_2862":1708,"_25248":1674,"_17581":46286,"_5":17476,"_23883":46178,"_2389":46287},[],"Define a validity longer than that of the certificates it will issue.",{"_2862":1709,"_25248":1674,"_17581":46289,"_5":17476,"_23883":46178,"_2389":46290},[],"For an intermediate CA, make sure the parent CA is active.",{"_2862":1710,"_25248":1674,"_17581":46292,"_5":17476,"_23883":46181,"_2389":46293},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_2862":1711,"_25248":1674,"_17581":46295,"_5":17476,"_23883":46185,"_2389":46296},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_2862":1712,"_25248":1674,"_17581":46298,"_5":17476,"_23883":46185,"_2389":46299},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_2862":1713,"_25248":1674,"_17581":46301,"_5":17476,"_23883":46189,"_2389":46302},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_2862":1714,"_25248":1674,"_17581":46304,"_5":17476,"_23883":46193,"_2389":46305},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_2862":1715,"_25248":1674,"_17581":46307,"_5":17476,"_23883":46193,"_2389":46308},[],"`C`: two-letter ISO 3166-1 country code.",{"_2862":1716,"_25248":1674,"_17581":46310,"_5":17476,"_23883":46193,"_2389":46311},[],"`ST`: state or province.",{"_2862":1717,"_25248":1674,"_17581":46313,"_5":17476,"_23883":46193,"_2389":46314},[],"`L`: locality.",{"_2862":1718,"_25248":1674,"_17581":46316,"_5":17476,"_23883":46193,"_2389":46317},[],"`O`: organization.",{"_2862":1719,"_25248":1674,"_17581":46319,"_5":17476,"_23883":46193,"_2389":46320},[],"`OU`: organizational unit.",{"_2862":1720,"_25248":1674,"_17581":46322,"_5":17476,"_23883":46193,"_2389":46323},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_2862":1721,"_25248":1674,"_17581":46325,"_5":17476,"_23883":46197,"_2389":46326},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_2862":1722,"_25248":1674,"_17581":46328,"_5":17476,"_23883":46197,"_2389":46329},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_2862":1723,"_25248":1674,"_17581":46331,"_5":17476,"_23883":46201,"_2389":46332},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_2862":1724,"_25248":1674,"_17581":46334,"_5":17476,"_23883":46201,"_2389":46335},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_2862":1725,"_25248":1674,"_17581":46337,"_5":17476,"_23883":46205,"_2389":46338},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_2862":1726,"_25248":1674,"_17581":46340,"_5":17476,"_23883":46205,"_2389":46341},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_2862":1727,"_25248":1674,"_17581":46343,"_5":17476,"_23883":46209,"_2389":46344},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_2862":1728,"_25248":1674,"_17581":46346,"_5":17476,"_23883":46213,"_2389":46347},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_2862":1729,"_25248":1674,"_17581":46349,"_5":17476,"_23883":46217,"_2389":46350},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_2862":1730,"_25248":1674,"_17581":46352,"_5":17476,"_23883":46221,"_2389":46353},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_2862":1731,"_25248":1674,"_17581":46355,"_5":17476,"_23883":46225,"_2389":46356},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_2862":1732,"_25248":1674,"_17581":46358,"_5":17476,"_23883":46225,"_2389":46359},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_2862":1733,"_25248":1674,"_17581":46361,"_5":17476,"_23883":46229,"_2389":46362},[],"Open a CA from the inventory to review:",{"_2862":1734,"_25248":1674,"_17581":46364,"_5":17476,"_23883":46229,"_2389":46365},[],"Status and validity period.",{"_2862":1735,"_25248":1674,"_17581":46367,"_5":17476,"_23883":46229,"_2389":46368},[],"Certificate and chain in PEM format.",{"_2862":1736,"_25248":1674,"_17581":46370,"_5":17476,"_23883":46229,"_2389":46371},[],"Number of active, expired and revoked certificates.",{"_2862":1737,"_25248":1674,"_17581":46373,"_5":17476,"_23883":46229,"_2389":46374},[],"Certificates issued in **Issued Certificates**.",{"_2862":1738,"_25248":1674,"_17581":46376,"_5":17476,"_23883":46229,"_2389":46377},[],"The CRL linked to the authority.",{"_2862":1739,"_25248":1674,"_17581":46379,"_5":17476,"_23883":46229,"_2389":46380},[],"Metadata and the associated cryptographic engine.",{"_2862":1740,"_25248":1674,"_17581":46382,"_5":17476,"_23883":46229,"_2389":46383},[],"You can filter the inventory by name, status and CA type.",{"_2862":1741,"_25248":1674,"_17581":46385,"_5":17476,"_23883":46233,"_2389":46386},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_2862":1742,"_25248":1674,"_17581":46388,"_5":17476,"_23883":46233,"_2389":46389},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_2862":1743,"_25248":1674,"_17581":46391,"_5":17476,"_23883":46233,"_2389":46392},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_2862":1744,"_25248":1674,"_17581":46394,"_5":17476,"_23883":46233,"_2389":46395},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_2862":1745,"_25248":1674,"_17581":46397,"_5":17476,"_23883":46237,"_2389":46398},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_2862":1746,"_25248":1674,"_17581":46400,"_5":17476,"_23883":46241,"_2389":46401},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_2862":1747,"_25248":1674,"_17581":46403,"_5":17476,"_23883":46245,"_2389":46404},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_2862":1748,"_25248":1674,"_17581":46406,"_5":17476,"_23883":46249,"_2389":46407},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_2862":1749,"_25248":1674,"_17581":46409,"_5":17476,"_23883":46253,"_2389":46410},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_2862":1750,"_25248":1674,"_17581":46412,"_5":17476,"_23883":46253,"_2389":46413},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_2862":1751,"_25248":1751,"_5":12326,"_2389":46415,"_25584":46416,"_17581":46417,"_23883":1751},"Certificate profiles",[40961,42324,46002,46003],[],{"_2862":1752,"_25248":1751,"_17581":46419,"_5":17476,"_23883":1751,"_2389":46420},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_2862":1753,"_25248":1751,"_5":25581,"_17581":46422,"_23883":46423,"_2389":46424},[],"/docs/pr-preview/pr-45/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_2862":1754,"_25248":1751,"_5":25581,"_17581":46426,"_23883":46427,"_2389":46428},[],"/docs/pr-preview/pr-45/platform/pki/certificate-profiles#validity","Validity",{"_2862":1755,"_25248":1751,"_5":25581,"_17581":46430,"_23883":46431,"_2389":46432},[],"/docs/pr-preview/pr-45/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_2862":1756,"_25248":1751,"_5":25581,"_17581":46434,"_23883":46435,"_2389":46436},[],"/docs/pr-preview/pr-45/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_2862":1757,"_25248":1751,"_5":25581,"_17581":46438,"_23883":46439,"_2389":46440},[],"/docs/pr-preview/pr-45/platform/pki/certificate-profiles#subject","Subject",{"_2862":1758,"_25248":1751,"_5":25581,"_17581":46442,"_23883":46443,"_2389":46444},[],"/docs/pr-preview/pr-45/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_2862":1759,"_25248":1751,"_5":25581,"_17581":46446,"_23883":46447,"_2389":46448},[],"/docs/pr-preview/pr-45/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_2862":1760,"_25248":1751,"_5":25581,"_17581":46450,"_23883":46451,"_2389":46452},[],"/docs/pr-preview/pr-45/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_2862":1761,"_25248":1751,"_5":25581,"_17581":46454,"_23883":46455,"_2389":46456},[],"/docs/pr-preview/pr-45/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_2862":1762,"_25248":1751,"_5":25581,"_17581":46458,"_23883":46459,"_2389":46460},[],"/docs/pr-preview/pr-45/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_2862":1763,"_25248":1751,"_5":25581,"_17581":46462,"_23883":46463,"_2389":46464},[],"/docs/pr-preview/pr-45/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_2862":1764,"_25248":1751,"_5":25581,"_17581":46466,"_23883":46467,"_2389":46468},[],"/docs/pr-preview/pr-45/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_2862":1765,"_25248":1751,"_5":25581,"_17581":46470,"_23883":46471,"_2389":46472},[],"/docs/pr-preview/pr-45/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_2862":1766,"_25248":1751,"_5":25581,"_17581":46474,"_23883":46475,"_2389":46476},[],"/docs/pr-preview/pr-45/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_2862":1767,"_25248":1751,"_5":25581,"_17581":46478,"_23883":46479,"_2389":46480},[],"/docs/pr-preview/pr-45/platform/pki/certificate-profiles#design-examples","Design examples",{"_2862":1768,"_25248":1751,"_5":25581,"_17581":46482,"_23883":46483,"_2389":46484},[],"/docs/pr-preview/pr-45/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_2862":1769,"_25248":1751,"_17581":46486,"_5":17476,"_23883":1751,"_2389":46487},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_2862":1770,"_25248":1751,"_17581":46489,"_5":17476,"_23883":1751,"_2389":46490},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_2862":1771,"_25248":1751,"_17581":46492,"_5":17476,"_23883":46427,"_2389":46493},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_2862":1772,"_25248":1751,"_17581":46495,"_5":17476,"_23883":46427,"_2389":46496},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_2862":1773,"_25248":1751,"_17581":46498,"_5":17476,"_23883":46431,"_2389":46499},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_2862":1774,"_25248":1751,"_17581":46501,"_5":17476,"_23883":46435,"_2389":46502},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_2862":1775,"_25248":1751,"_17581":46504,"_5":17476,"_23883":46435,"_2389":46505},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_2862":1776,"_25248":1751,"_17581":46507,"_5":17476,"_23883":46435,"_2389":46508},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_2862":1777,"_25248":1751,"_17581":46510,"_5":17476,"_23883":46439,"_2389":46511},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_2862":1778,"_25248":1751,"_17581":46513,"_5":17476,"_23883":46443,"_2389":46514},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_2862":1779,"_25248":1751,"_17581":46516,"_5":17476,"_23883":46443,"_2389":46517},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_2862":1780,"_25248":1751,"_17581":46519,"_5":17476,"_23883":46447,"_2389":46520},[],"The cryptographic enforcement can:",{"_2862":1781,"_25248":1751,"_17581":46522,"_5":17476,"_23883":46447,"_2389":46523},[],"allow or block RSA keys;",{"_2862":1782,"_25248":1751,"_17581":46525,"_5":17476,"_23883":46447,"_2389":46526},[],"limit the supported RSA sizes;",{"_2862":1783,"_25248":1751,"_17581":46528,"_5":17476,"_23883":46447,"_2389":46529},[],"allow or block ECDSA keys;",{"_2862":1784,"_25248":1751,"_17581":46531,"_5":17476,"_23883":46447,"_2389":46532},[],"limit the supported ECDSA sizes or curves.",{"_2862":1785,"_25248":1751,"_17581":46534,"_5":17476,"_23883":46447,"_2389":46535},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_2862":1786,"_25248":1751,"_17581":46537,"_5":17476,"_23883":46451,"_2389":46538},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_2862":1787,"_25248":1751,"_17581":46540,"_5":17476,"_23883":46451,"_2389":44042},[],{"_2862":1788,"_25248":1751,"_17581":46542,"_5":17476,"_23883":46451,"_2389":46543},[],"First choice",{"_2862":1789,"_25248":1751,"_17581":46545,"_5":17476,"_23883":46451,"_2389":46546},[],"Second choice",{"_2862":1790,"_25248":1751,"_17581":46548,"_5":17476,"_23883":46451,"_2389":46549},[],"If neither is supplied",{"_2862":1791,"_25248":1751,"_17581":46551,"_5":17476,"_23883":46451,"_2389":46552},[],"Direct signing with a CA",{"_2862":1792,"_25248":1751,"_17581":46554,"_5":17476,"_23883":46451,"_2389":46555},[],"`issuance_profile` embedded in the request",{"_2862":1793,"_25248":1751,"_17581":46557,"_5":17476,"_23883":46451,"_2389":46558},[],"Request `issuance_profile_id`",{"_2862":1794,"_25248":1751,"_17581":46560,"_5":17476,"_23883":46451,"_2389":46561},[],"CA default profile (`profile_id`).",{"_2862":1795,"_25248":1751,"_17581":46563,"_5":17476,"_23883":46451,"_2389":46564},[],"Issuance through a DMS",{"_2862":1796,"_25248":1751,"_17581":46566,"_5":17476,"_23883":46451,"_2389":46567},[],"`settings.issuance_profile_id`",{"_2862":1797,"_25248":1751,"_17581":46569,"_5":17476,"_23883":46451,"_2389":46570},[],"`settings.issuance_profile` embedded in the DMS",{"_2862":1798,"_25248":1751,"_17581":46572,"_5":17476,"_23883":46451,"_2389":46573},[],"Enrollment CA default profile.",{"_2862":1799,"_25248":1751,"_17581":46575,"_5":17476,"_23883":46451,"_2389":46576},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_2862":1800,"_25248":1751,"_17581":46578,"_5":17476,"_23883":46451,"_2389":46579},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_2862":1801,"_25248":1751,"_17581":46581,"_5":17476,"_23883":46459,"_2389":46582},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_2862":1802,"_25248":1751,"_17581":46584,"_5":17476,"_23883":46463,"_2389":46585},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_2862":1803,"_25248":1751,"_17581":46587,"_5":17476,"_23883":46467,"_2389":46588},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_2862":1804,"_25248":1751,"_17581":46590,"_5":17476,"_23883":46471,"_2389":46591},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_2862":1805,"_25248":1751,"_17581":46593,"_5":17476,"_23883":46475,"_2389":46594},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_2862":1806,"_25248":1751,"_17581":46596,"_5":17476,"_23883":46475,"_2389":46597},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_2862":1807,"_25248":1751,"_17581":46599,"_5":17476,"_23883":46479,"_2389":46600},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_2862":1808,"_25248":1751,"_17581":46602,"_5":17476,"_23883":46479,"_2389":46603},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_2862":1809,"_25248":1751,"_17581":46605,"_5":17476,"_23883":46479,"_2389":46606},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_2862":1810,"_25248":1751,"_17581":46608,"_5":17476,"_23883":46479,"_2389":46609},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_2862":1811,"_25248":1751,"_17581":46611,"_5":17476,"_23883":46483,"_2389":46612},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_2862":1812,"_25248":1751,"_17581":46614,"_5":17476,"_23883":46483,"_2389":46615},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_2862":1813,"_25248":1813,"_5":12326,"_2389":46617,"_25584":46618,"_17581":46620,"_23883":1813},"Certificate validation",[40961,42324,46002,46619],"Validation",[],{"_2862":1814,"_25248":1813,"_17581":46622,"_5":17476,"_23883":1813,"_2389":46623},[],"Check chain, identity, purpose and revocation from the consumer.",{"_2862":1815,"_25248":1813,"_5":25581,"_17581":46625,"_23883":46626,"_2389":46627},[],"/docs/pr-preview/pr-45/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_2862":1816,"_25248":1813,"_5":25581,"_17581":46629,"_23883":46630,"_2389":46631},[],"/docs/pr-preview/pr-45/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_2862":1817,"_25248":1813,"_5":25581,"_17581":46633,"_23883":46634,"_2389":46635},[],"/docs/pr-preview/pr-45/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_2862":1818,"_25248":1813,"_17581":46637,"_5":17476,"_23883":1813,"_2389":46638},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_2862":1819,"_25248":1813,"_17581":46640,"_5":17476,"_23883":46626,"_2389":46641},[],"Verify these criteria together:",{"_2862":1820,"_25248":1813,"_17581":46643,"_5":17476,"_23883":46626,"_2389":45626},[],{"_2862":1821,"_25248":1813,"_17581":46645,"_5":17476,"_23883":46626,"_2389":46646},[],"Required result",{"_2862":1822,"_25248":1813,"_17581":46648,"_5":17476,"_23883":46626,"_2389":46649},[],"Chain and signature",{"_2862":1823,"_25248":1813,"_17581":46651,"_5":17476,"_23883":46626,"_2389":46652},[],"Valid chain to a root deliberately installed in the consumer.",{"_2862":1824,"_25248":1813,"_17581":46654,"_5":17476,"_23883":46626,"_2389":46655},[],"Dates",{"_2862":1825,"_25248":1813,"_17581":46657,"_5":17476,"_23883":46626,"_2389":46658},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_2862":1826,"_25248":1813,"_17581":46660,"_5":17476,"_23883":46626,"_2389":42027},[],{"_2862":1827,"_25248":1813,"_17581":46662,"_5":17476,"_23883":46626,"_2389":46663},[],"Name, SAN or identifier matches the expected peer.",{"_2862":1828,"_25248":1813,"_17581":46665,"_5":17476,"_23883":46626,"_2389":41344},[],{"_2862":1829,"_25248":1813,"_17581":46667,"_5":17476,"_23883":46626,"_2389":46668},[],"KU, EKU and constraints permit the specific operation.",{"_2862":1830,"_25248":1813,"_17581":46670,"_5":17476,"_23883":46626,"_2389":46671},[],"Revocation",{"_2862":1831,"_25248":1813,"_17581":46673,"_5":17476,"_23883":46626,"_2389":46674},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_2862":1832,"_25248":1813,"_17581":46676,"_5":17476,"_23883":46626,"_2389":46677},[],"Authorization",{"_2862":1833,"_25248":1813,"_17581":46679,"_5":17476,"_23883":46626,"_2389":46680},[],"The application permits that identity to perform the action.",{"_2862":1834,"_25248":1813,"_17581":46682,"_5":17476,"_23883":46626,"_2389":46683},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_2862":1835,"_25248":1813,"_17581":46685,"_5":17476,"_23883":46630,"_2389":46686},[],"Mechanism",{"_2862":1836,"_25248":1813,"_17581":46688,"_5":17476,"_23883":46630,"_2389":46689},[],"When to use it",{"_2862":1837,"_25248":1813,"_17581":46691,"_5":17476,"_23883":46630,"_2389":46692},[],"What you must maintain",{"_2862":1838,"_25248":1813,"_17581":46694,"_5":17476,"_23883":46630,"_2389":46695},[],"OCSP",{"_2862":1839,"_25248":1813,"_17581":46697,"_5":17476,"_23883":46630,"_2389":46698},[],"Status query for a specific certificate.",{"_2862":1840,"_25248":1813,"_17581":46700,"_5":17476,"_23883":46630,"_2389":46701},[],"Responder access, signature verification and cache/freshness policy.",{"_2862":1841,"_25248":1813,"_17581":46703,"_5":17476,"_23883":46630,"_2389":46704},[],"CRL",{"_2862":1842,"_25248":1813,"_17581":46706,"_5":17476,"_23883":46630,"_2389":46707},[],"Local checks for many certificates or offline operation.",{"_2862":1843,"_25248":1813,"_17581":46709,"_5":17476,"_23883":46630,"_2389":46710},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_2862":1844,"_25248":1813,"_17581":46712,"_5":17476,"_23883":46630,"_2389":46713},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_2862":1845,"_25248":1813,"_17581":46715,"_5":17476,"_23883":46630,"_2389":46716},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_2862":1846,"_25248":1813,"_17581":46718,"_5":17476,"_23883":46634,"_2389":46719},[],"Accept a current, authorized certificate with a known chain.",{"_2862":1847,"_25248":1813,"_17581":46721,"_5":17476,"_23883":46634,"_2389":46722},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_2862":1848,"_25248":1813,"_17581":46724,"_5":17476,"_23883":46634,"_2389":46725},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_2862":1849,"_25248":1813,"_17581":46727,"_5":17476,"_23883":46634,"_2389":46728},[],"Check that a new connection with that identity is rejected.",{"_2862":1850,"_25248":1813,"_17581":46730,"_5":17476,"_23883":46634,"_2389":46731},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_2862":1851,"_25248":1813,"_17581":46733,"_5":17476,"_23883":46634,"_2389":46734},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_2862":1852,"_25248":1813,"_17581":46736,"_5":17476,"_23883":46634,"_2389":46737},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_2862":1853,"_25248":1813,"_17581":46739,"_5":17476,"_23883":46634,"_2389":46740},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_2862":1854,"_25248":1813,"_17581":46742,"_5":17476,"_23883":46634,"_2389":46743},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_2862":1855,"_25248":1855,"_5":12326,"_2389":46745,"_25584":46746,"_17581":46747,"_23883":1855},"Certificates",[40961,42324,46002,46003],[],{"_2862":1856,"_25248":1855,"_17581":46749,"_5":17476,"_23883":1855,"_2389":46750},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_2862":1857,"_25248":1855,"_5":25581,"_17581":46752,"_23883":46753,"_2389":46754},[],"/docs/pr-preview/pr-45/platform/pki/certificates#find-a-certificate","Find a certificate",{"_2862":1858,"_25248":1855,"_5":25581,"_17581":46756,"_23883":46757,"_2389":46758},[],"/docs/pr-preview/pr-45/platform/pki/certificates#download-the-certificate","Download the certificate",{"_2862":1859,"_25248":1855,"_5":25581,"_17581":46760,"_23883":46761,"_2389":46762},[],"/docs/pr-preview/pr-45/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_2862":1860,"_25248":1855,"_5":25581,"_17581":46764,"_23883":46765,"_2389":46766},[],"/docs/pr-preview/pr-45/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_2862":1861,"_25248":1855,"_5":25581,"_17581":46768,"_23883":46769,"_2389":46770},[],"/docs/pr-preview/pr-45/platform/pki/certificates#open-the-action","Open the action",{"_2862":1862,"_25248":1855,"_5":25581,"_17581":46772,"_23883":46773,"_2389":46774},[],"/docs/pr-preview/pr-45/platform/pki/certificates#choose-a-reason","Choose a reason",{"_2862":1863,"_25248":1855,"_5":25581,"_17581":46776,"_23883":46777,"_2389":46778},[],"/docs/pr-preview/pr-45/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_2862":1864,"_25248":1855,"_5":25581,"_17581":46780,"_23883":46781,"_2389":46782},[],"/docs/pr-preview/pr-45/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_2862":1865,"_25248":1855,"_5":25581,"_17581":46784,"_23883":46785,"_2389":46786},[],"/docs/pr-preview/pr-45/platform/pki/certificates#continue","Continue",{"_2862":1866,"_25248":1855,"_17581":46788,"_5":17476,"_23883":1855,"_2389":46789},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_2862":1867,"_25248":1855,"_17581":46791,"_5":17476,"_23883":46753,"_2389":46792},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_2862":1868,"_25248":1855,"_17581":46794,"_5":17476,"_23883":46753,"_2389":46795},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_2862":1869,"_25248":1855,"_17581":46797,"_5":17476,"_23883":46757,"_2389":46798},[],"Download the PEM and inspect it:",{"_2862":1870,"_25248":1855,"_17581":46800,"_5":17476,"_23883":46757,"_2389":46801},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_2862":1871,"_25248":1855,"_17581":46803,"_5":17476,"_23883":46761,"_2389":46804},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_2862":1872,"_25248":1855,"_17581":46806,"_5":17476,"_23883":46761,"_2389":46807},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_2862":1873,"_25248":1855,"_17581":46809,"_5":17476,"_23883":46761,"_2389":46810},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_2862":1874,"_25248":1855,"_17581":46812,"_5":17476,"_23883":46761,"_2389":46813},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_2862":1875,"_25248":1855,"_17581":46815,"_5":17476,"_23883":46761,"_2389":46816},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_2862":1876,"_25248":1855,"_17581":46818,"_5":17476,"_23883":46761,"_2389":46819},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_2862":1877,"_25248":1855,"_17581":46821,"_5":17476,"_23883":46761,"_2389":46822},[],"For browser key generation, follow Issue your first certificate.",{"_2862":1878,"_25248":1855,"_17581":46824,"_5":17476,"_23883":46765,"_2389":46825},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_2862":1879,"_25248":1855,"_17581":46827,"_5":17476,"_23883":46769,"_2389":46828},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_2862":1880,"_25248":1855,"_17581":46830,"_5":17476,"_23883":46773,"_2389":46831},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_2862":1881,"_25248":1855,"_17581":46833,"_5":17476,"_23883":46777,"_2389":46834},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_2862":1882,"_25248":1855,"_17581":46836,"_5":17476,"_23883":46777,"_2389":46837},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_2862":1883,"_25248":1855,"_17581":46839,"_5":17476,"_23883":46777,"_2389":46840},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_2862":1884,"_25248":1855,"_17581":46842,"_5":17476,"_23883":46781,"_2389":46843},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_2862":1885,"_25248":1855,"_17581":46845,"_5":17476,"_23883":46781,"_2389":46846},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_2862":1886,"_25248":1855,"_17581":46848,"_5":17476,"_23883":46781,"_2389":46849},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_2862":1887,"_25248":1855,"_17581":46851,"_5":17476,"_23883":46785,"_2389":46852},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_2862":1888,"_25248":1855,"_17581":46854,"_5":17476,"_23883":46785,"_2389":46855},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_2862":1889,"_25248":1889,"_5":12326,"_2389":46857,"_25584":46858,"_17581":46860,"_23883":1889},"Certificate lifecycle",[40961,42324,46002,46859],"Concepts",[],{"_2862":1890,"_25248":1889,"_17581":46862,"_5":17476,"_23883":1889,"_2389":46863},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_2862":1891,"_25248":1889,"_5":25581,"_17581":46865,"_23883":46866,"_2389":46867},[],"/docs/pr-preview/pr-45/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_2862":1892,"_25248":1889,"_5":25581,"_17581":46869,"_23883":46870,"_2389":46871},[],"/docs/pr-preview/pr-45/platform/pki/concepts/certificate-lifecycle#request","Request",{"_2862":1893,"_25248":1889,"_5":25581,"_17581":46873,"_23883":46874,"_2389":46875},[],"/docs/pr-preview/pr-45/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_2862":1894,"_25248":1889,"_5":25581,"_17581":46877,"_23883":46878,"_2389":46879},[],"/docs/pr-preview/pr-45/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_2862":1895,"_25248":1889,"_5":25581,"_17581":46881,"_23883":46882,"_2389":46883},[],"/docs/pr-preview/pr-45/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_2862":1896,"_25248":1889,"_5":25581,"_17581":46885,"_23883":46886,"_2389":46887},[],"/docs/pr-preview/pr-45/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_2862":1897,"_25248":1889,"_5":25581,"_17581":46889,"_23883":46890,"_2389":46891},[],"/docs/pr-preview/pr-45/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_2862":1898,"_25248":1889,"_5":25581,"_17581":46893,"_23883":46894,"_2389":46895},[],"/docs/pr-preview/pr-45/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_2862":1899,"_25248":1889,"_5":25581,"_17581":46897,"_23883":46898,"_2389":46899},[],"/docs/pr-preview/pr-45/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_2862":1900,"_25248":1889,"_5":25581,"_17581":46901,"_23883":46902,"_2389":46903},[],"/docs/pr-preview/pr-45/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_2862":1901,"_25248":1889,"_17581":46905,"_5":17476,"_23883":1889,"_2389":46906},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_2862":1902,"_25248":1889,"_17581":46908,"_5":17476,"_23883":46870,"_2389":46909},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_2862":1903,"_25248":1889,"_17581":46911,"_5":17476,"_23883":46874,"_2389":46912},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_2862":1904,"_25248":1889,"_17581":46914,"_5":17476,"_23883":46878,"_2389":46915},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_2862":1905,"_25248":1889,"_17581":46917,"_5":17476,"_23883":46882,"_2389":46918},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_2862":1906,"_25248":1889,"_17581":46920,"_5":17476,"_23883":46886,"_2389":46921},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_2862":1907,"_25248":1889,"_17581":46923,"_5":17476,"_23883":46890,"_2389":46924},[],"Lamassu persists four X.509 states:",{"_2862":1908,"_25248":1889,"_17581":46926,"_5":17476,"_23883":46890,"_2389":46927},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_2862":1909,"_25248":1889,"_17581":46929,"_5":17476,"_23883":46890,"_2389":46930},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_2862":1910,"_25248":1889,"_17581":46932,"_5":17476,"_23883":46890,"_2389":46933},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_2862":1911,"_25248":1889,"_17581":46935,"_5":17476,"_23883":46890,"_2389":46936},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_2862":1912,"_25248":1889,"_17581":46938,"_5":17476,"_23883":46890,"_2389":46939},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_2862":1913,"_25248":1889,"_17581":46941,"_5":17476,"_23883":46894,"_2389":46942},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_2862":1914,"_25248":1889,"_17581":46944,"_5":17476,"_23883":46894,"_2389":46945},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_2862":1915,"_25248":1889,"_17581":46947,"_5":17476,"_23883":46894,"_2389":46948},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_2862":1916,"_25248":1889,"_17581":46950,"_5":17476,"_23883":46898,"_2389":46951},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_2862":1917,"_25248":1889,"_17581":46953,"_5":17476,"_23883":46898,"_2389":46954},[],"Before confirming:",{"_2862":1918,"_25248":1889,"_17581":46956,"_5":17476,"_23883":46898,"_2389":46957},[],"Identify DMSs, devices and services that trust that chain.",{"_2862":1919,"_25248":1889,"_17581":46959,"_5":17476,"_23883":46898,"_2389":46960},[],"Distribute the new chain of trust.",{"_2862":1920,"_25248":1889,"_17581":46962,"_5":17476,"_23883":46898,"_2389":46963},[],"Reissue the necessary identities.",{"_2862":1921,"_25248":1889,"_17581":46965,"_5":17476,"_23883":46898,"_2389":46966},[],"Check OCSP and CRL from a real consumer.",{"_2862":1922,"_25248":1889,"_17581":46968,"_5":17476,"_23883":46898,"_2389":46969},[],"Revoke the old CA once no legitimate traffic remains.",{"_2862":1923,"_25248":1889,"_17581":46971,"_5":17476,"_23883":46898,"_2389":46972},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_2862":1924,"_25248":1889,"_17581":46974,"_5":17476,"_23883":46902,"_2389":46975},[],"Certificates entering the preventive or critical renewal window.",{"_2862":1925,"_25248":1889,"_17581":46977,"_5":17476,"_23883":46902,"_2389":46978},[],"Repeated enrollment or re-enrollment failures.",{"_2862":1926,"_25248":1889,"_17581":46980,"_5":17476,"_23883":46902,"_2389":46981},[],"Status changes and revocation reasons.",{"_2862":1927,"_25248":1889,"_17581":46983,"_5":17476,"_23883":46902,"_2389":46984},[],"OCSP and CRL publication and validity.",{"_2862":1928,"_25248":1889,"_17581":46986,"_5":17476,"_23883":46902,"_2389":46987},[],"Dependencies still presenting a replaced certificate.",{"_2862":1929,"_25248":1889,"_17581":46989,"_5":17476,"_23883":46902,"_2389":46990},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_2862":1930,"_25248":1930,"_5":12326,"_2389":46992,"_25584":46993,"_17581":46994,"_23883":1930},"Trust model",[40961,42324,46002,46859],[],{"_2862":1931,"_25248":1930,"_17581":46996,"_5":17476,"_23883":1930,"_2389":46997},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_2862":1932,"_25248":1930,"_5":25581,"_17581":46999,"_23883":47000,"_2389":47001},[],"/docs/pr-preview/pr-45/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_2862":1933,"_25248":1930,"_5":25581,"_17581":47003,"_23883":47004,"_2389":47005},[],"/docs/pr-preview/pr-45/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_2862":1934,"_25248":1930,"_5":25581,"_17581":47007,"_23883":47008,"_2389":47009},[],"/docs/pr-preview/pr-45/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_2862":1935,"_25248":1930,"_5":25581,"_17581":47011,"_23883":47012,"_2389":47013},[],"/docs/pr-preview/pr-45/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_2862":1936,"_25248":1930,"_5":25581,"_17581":47015,"_23883":47016,"_2389":47017},[],"/docs/pr-preview/pr-45/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_2862":1937,"_25248":1930,"_5":25581,"_17581":47019,"_23883":47020,"_2389":47021},[],"/docs/pr-preview/pr-45/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_2862":1938,"_25248":1930,"_5":25581,"_17581":47023,"_23883":47024,"_2389":47025},[],"/docs/pr-preview/pr-45/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_2862":1939,"_25248":1930,"_5":25581,"_17581":47027,"_23883":47028,"_2389":47029},[],"/docs/pr-preview/pr-45/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_2862":1940,"_25248":1930,"_5":25581,"_17581":47031,"_23883":47032,"_2389":47033},[],"/docs/pr-preview/pr-45/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_2862":1941,"_25248":1930,"_5":25581,"_17581":47035,"_23883":47036,"_2389":47037},[],"/docs/pr-preview/pr-45/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_2862":1942,"_25248":1930,"_17581":47039,"_5":17476,"_23883":1930,"_2389":47040},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_2862":1943,"_25248":1930,"_17581":47042,"_5":17476,"_23883":47004,"_2389":47043},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_2862":1944,"_25248":1930,"_17581":47045,"_5":17476,"_23883":47008,"_2389":47046},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_2862":1945,"_25248":1930,"_17581":47048,"_5":17476,"_23883":47012,"_2389":47049},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_2862":1946,"_25248":1930,"_17581":47051,"_5":17476,"_23883":47016,"_2389":47052},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_2862":1947,"_25248":1930,"_17581":47054,"_5":17476,"_23883":47020,"_2389":47055},[],"The device proves it can enroll according to the DMS policy.",{"_2862":1948,"_25248":1930,"_17581":47057,"_5":17476,"_23883":47020,"_2389":47058},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_2862":1949,"_25248":1930,"_17581":47060,"_5":17476,"_23883":47020,"_2389":47061},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_2862":1950,"_25248":1930,"_17581":47063,"_5":17476,"_23883":47020,"_2389":47064},[],"The device installs the certificate and the chain it needs.",{"_2862":1951,"_25248":1930,"_17581":47066,"_5":17476,"_23883":47020,"_2389":47067},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_2862":1952,"_25248":1930,"_17581":47069,"_5":17476,"_23883":47020,"_2389":47070},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_2862":1953,"_25248":1930,"_17581":47072,"_5":17476,"_23883":47024,"_2389":47073},[],"A DMS relates three sets that are worth designing separately:",{"_2862":1954,"_25248":1930,"_17581":47075,"_5":17476,"_23883":47024,"_2389":47076},[],"**Enrollment CA:** signs the new identities.",{"_2862":1955,"_25248":1930,"_17581":47078,"_5":17476,"_23883":47024,"_2389":47079},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, Lamassu tries the enrollment CA first and then the additional validation CAs.",{"_2862":1956,"_25248":1930,"_17581":47081,"_5":17476,"_23883":47024,"_2389":47082},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_2862":1957,"_25248":1930,"_17581":47084,"_5":17476,"_23883":47024,"_2389":47085},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_2862":1958,"_25248":1930,"_17581":47087,"_5":17476,"_23883":47028,"_2389":47088},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_2862":1959,"_25248":1930,"_17581":47090,"_5":17476,"_23883":47028,"_2389":47091},[],"that the current date is between `Not Before` and `Not After`;",{"_2862":1960,"_25248":1930,"_17581":47093,"_5":17476,"_23883":47028,"_2389":47094},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_2862":1961,"_25248":1930,"_17581":47096,"_5":17476,"_23883":47028,"_2389":47097},[],"that names, SANs and subject match the expected identity;",{"_2862":1962,"_25248":1930,"_17581":47099,"_5":17476,"_23883":47028,"_2389":47100},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_2862":1963,"_25248":1930,"_17581":47102,"_5":17476,"_23883":47028,"_2389":47103},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_2862":1964,"_25248":1930,"_17581":47105,"_5":17476,"_23883":47028,"_2389":47106},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_2862":1965,"_25248":1930,"_17581":47108,"_5":17476,"_23883":47032,"_2389":47109},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_2862":1966,"_25248":1930,"_17581":47111,"_5":17476,"_23883":47036,"_2389":47112},[],"Keep the root out of daily operations, or with very restricted access.",{"_2862":1967,"_25248":1930,"_17581":47114,"_5":17476,"_23883":47036,"_2389":47115},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_2862":1968,"_25248":1930,"_17581":47117,"_5":17476,"_23883":47036,"_2389":47118},[],"Assign explicit profiles to every use case.",{"_2862":1969,"_25248":1930,"_17581":47120,"_5":17476,"_23883":47036,"_2389":47121},[],"Distribute the new trust before starting a rotation.",{"_2862":1970,"_25248":1930,"_17581":47123,"_5":17476,"_23883":47036,"_2389":47124},[],"Keep enough overlap to renew a disconnected fleet.",{"_2862":1971,"_25248":1930,"_17581":47126,"_5":17476,"_23883":47036,"_2389":47127},[],"Validate from the consuming system, not only from the Lamassu console.",{"_2862":1972,"_25248":1930,"_17581":47129,"_5":17476,"_23883":47036,"_2389":47130},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_2862":1973,"_25248":1973,"_5":12326,"_2389":47132,"_25584":47133,"_17581":47134,"_23883":1973},"Revocation lists (CRL)",[40961,42324,46002,46619],[],{"_2862":1974,"_25248":1973,"_17581":47136,"_5":17476,"_23883":1973,"_2389":47137},[],"Generate and distribute signed lists to validate certificates offline.",{"_2862":1975,"_25248":1973,"_5":25581,"_17581":47139,"_23883":47140,"_2389":47141},[],"/docs/pr-preview/pr-45/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_2862":1976,"_25248":1973,"_5":25581,"_17581":47143,"_23883":47144,"_2389":47145},[],"/docs/pr-preview/pr-45/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_2862":1977,"_25248":1973,"_5":25581,"_17581":47147,"_23883":47148,"_2389":47149},[],"/docs/pr-preview/pr-45/platform/pki/crl#crl-contents","CRL contents",{"_2862":1978,"_25248":1973,"_5":25581,"_17581":47151,"_23883":47152,"_2389":47153},[],"/docs/pr-preview/pr-45/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_2862":1979,"_25248":1973,"_5":25581,"_17581":47155,"_23883":47156,"_2389":47157},[],"/docs/pr-preview/pr-45/platform/pki/crl#va-role-management-api","VA role management API",{"_2862":1980,"_25248":1973,"_5":25581,"_17581":47159,"_23883":47160,"_2389":47161},[],"/docs/pr-preview/pr-45/platform/pki/crl#from-the-interface","From the interface",{"_2862":1981,"_25248":1973,"_5":25581,"_17581":47163,"_23883":47164,"_2389":47165},[],"/docs/pr-preview/pr-45/platform/pki/crl#references","References",{"_2862":1982,"_25248":1973,"_17581":47167,"_5":17476,"_23883":1973,"_2389":47168},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_2862":1983,"_25248":1973,"_17581":47170,"_5":17476,"_23883":47140,"_2389":47171},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_2862":1984,"_25248":1973,"_17581":47173,"_5":17476,"_23883":47140,"_2389":47174},[],"`crl_options` field",{"_2862":1985,"_25248":1973,"_17581":47176,"_5":17476,"_23883":47140,"_2389":41344},[],{"_2862":1986,"_25248":1973,"_17581":47178,"_5":17476,"_23883":47140,"_2389":47179},[],"Backend initial value",{"_2862":1987,"_25248":1973,"_17581":47181,"_5":17476,"_23883":47140,"_2389":47182},[],"`validity`",{"_2862":1988,"_25248":1973,"_17581":47184,"_5":17476,"_23883":47140,"_2389":47185},[],"Time from `thisUpdate` to `nextUpdate`.",{"_2862":1989,"_25248":1973,"_17581":47187,"_5":17476,"_23883":47140,"_2389":47188},[],"7 days.",{"_2862":1990,"_25248":1973,"_17581":47190,"_5":17476,"_23883":47140,"_2389":47191},[],"`refresh_interval`",{"_2862":1991,"_25248":1973,"_17581":47193,"_5":17476,"_23883":47140,"_2389":47194},[],"Time since publication that triggers scheduled renewal.",{"_2862":1992,"_25248":1973,"_17581":47196,"_5":17476,"_23883":47140,"_2389":47197},[],"6 days and 23 hours.",{"_2862":1993,"_25248":1973,"_17581":47199,"_5":17476,"_23883":47140,"_2389":47200},[],"`regenerate_on_revoke`",{"_2862":1994,"_25248":1973,"_17581":47202,"_5":17476,"_23883":47140,"_2389":47203},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_2862":1995,"_25248":1973,"_17581":47205,"_5":17476,"_23883":47140,"_2389":47206},[],"`true`.",{"_2862":1996,"_25248":1973,"_17581":47208,"_5":17476,"_23883":47140,"_2389":47209},[],"`subject_key_id_signer`",{"_2862":1997,"_25248":1973,"_17581":47211,"_5":17476,"_23883":47140,"_2389":47212},[],"Configuration field initialized with the CA’s SKI.",{"_2862":1998,"_25248":1973,"_17581":47214,"_5":17476,"_23883":47140,"_2389":47215},[],"CA SKI.",{"_2862":1999,"_25248":1973,"_17581":47217,"_5":17476,"_23883":47140,"_2389":47218},[],"The generator uses the key of the CA identified by the requested SKI. Do not interpret `subject_key_id_signer` as verified support for a different delegated CA: changing that field does not change the signer in this flow.",{"_2862":2000,"_25248":1973,"_17581":47220,"_5":17476,"_23883":47140,"_2389":47221},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_2862":2001,"_25248":1973,"_17581":47223,"_5":17476,"_23883":47144,"_2389":47224},[],"The scheduled job requests another list when `refresh_interval` is reached or when the list approaches expiration within the configured watch period. This depends on working jobs, storage and signing; it does not guarantee renewal during a service failure.",{"_2862":2002,"_25248":1973,"_17581":47226,"_5":17476,"_23883":47144,"_2389":47227},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_2862":2003,"_25248":1973,"_17581":47229,"_5":17476,"_23883":47144,"_2389":47230},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_2862":2004,"_25248":1973,"_17581":47232,"_5":17476,"_23883":47148,"_2389":47233},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_2862":2005,"_25248":1973,"_17581":47235,"_5":17476,"_23883":47148,"_2389":47236},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_2862":2006,"_25248":1973,"_17581":47238,"_5":17476,"_23883":47152,"_2389":47239},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_2862":2007,"_25248":1973,"_17581":47241,"_5":17476,"_23883":47152,"_2389":47242},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_2862":2008,"_25248":1973,"_17581":47244,"_5":17476,"_23883":47152,"_2389":47245},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_2862":2009,"_25248":1973,"_17581":47247,"_5":17476,"_23883":47152,"_2389":47248},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_2862":2010,"_25248":1973,"_17581":47250,"_5":17476,"_23883":47152,"_2389":47251},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_2862":2011,"_25248":1973,"_17581":47253,"_5":17476,"_23883":47156,"_2389":47254},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_2862":2012,"_25248":1973,"_17581":47256,"_5":17476,"_23883":47156,"_2389":44045},[],{"_2862":2013,"_25248":1973,"_17581":47258,"_5":17476,"_23883":47156,"_2389":47259},[],"Relative path",{"_2862":2014,"_25248":1973,"_17581":47261,"_5":17476,"_23883":47156,"_2389":44042},[],{"_2862":2015,"_25248":1973,"_17581":47263,"_5":17476,"_23883":47156,"_2389":47264},[],"`GET`",{"_2862":2016,"_25248":1973,"_17581":47266,"_5":17476,"_23883":47156,"_2389":47267},[],"`/v1/roles/{ca-ski}`",{"_2862":2017,"_25248":1973,"_17581":47269,"_5":17476,"_23883":47156,"_2389":47270},[],"Read `crl_options` and `latest_crl`.",{"_2862":2018,"_25248":1973,"_17581":47272,"_5":17476,"_23883":47156,"_2389":47273},[],"`PUT`",{"_2862":2019,"_25248":1973,"_17581":47275,"_5":17476,"_23883":47156,"_2389":47267},[],{"_2862":2020,"_25248":1973,"_17581":47277,"_5":17476,"_23883":47156,"_2389":47278},[],"Replace CRL configuration.",{"_2862":2021,"_25248":1973,"_17581":47280,"_5":17476,"_23883":47156,"_2389":47281},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_2862":2022,"_25248":1973,"_17581":47283,"_5":17476,"_23883":47156,"_2389":47284},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_2862":2023,"_25248":1973,"_17581":47286,"_5":17476,"_23883":47160,"_2389":47287},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_2862":2024,"_25248":1973,"_17581":47289,"_5":17476,"_23883":47164,"_2389":47290},[],"RFC 5280: X.509 and CRL profile.",{"_2862":2025,"_25248":1973,"_17581":47292,"_5":17476,"_23883":47164,"_2389":47293},[],"OpenSSL: openssl-crl.",{"_2862":2026,"_25248":1973,"_17581":47295,"_5":17476,"_23883":47164,"_2389":47296},[],"OpenSSL: openssl-verify.",{"_2862":2027,"_25248":1973,"_17581":47298,"_5":17476,"_23883":47164,"_2389":47299},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_2862":2028,"_25248":1973,"_17581":47301,"_5":17476,"_23883":47164,"_2389":47302},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2862":2029,"_25248":2029,"_5":12326,"_2389":47304,"_25584":47305,"_17581":47306,"_23883":2029},"Keys and cryptographic engines",[40961,42324,46002,46003],[],{"_2862":2030,"_25248":2029,"_17581":47308,"_5":17476,"_23883":2029,"_2389":47309},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_2862":2031,"_25248":2029,"_5":25581,"_17581":47311,"_23883":47312,"_2389":47313},[],"/docs/pr-preview/pr-45/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_2862":2032,"_25248":2029,"_5":25581,"_17581":47315,"_23883":47316,"_2389":47317},[],"/docs/pr-preview/pr-45/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_2862":2033,"_25248":2029,"_5":25581,"_17581":47319,"_23883":47320,"_2389":47321},[],"/docs/pr-preview/pr-45/platform/pki/key-management#file-system","File System",{"_2862":2034,"_25248":2029,"_5":25581,"_17581":47323,"_23883":47324,"_2389":47325},[],"/docs/pr-preview/pr-45/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_2862":2035,"_25248":2029,"_5":25581,"_17581":47327,"_23883":47328,"_2389":47329},[],"/docs/pr-preview/pr-45/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_2862":2036,"_25248":2029,"_5":25581,"_17581":47331,"_23883":47332,"_2389":47333},[],"/docs/pr-preview/pr-45/platform/pki/key-management#aws-kms","AWS KMS",{"_2862":2037,"_25248":2029,"_5":25581,"_17581":47335,"_23883":47336,"_2389":47337},[],"/docs/pr-preview/pr-45/platform/pki/key-management#pkcs11","PKCS#11",{"_2862":2038,"_25248":2029,"_5":25581,"_17581":47339,"_23883":47340,"_2389":47341},[],"/docs/pr-preview/pr-45/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_2862":2039,"_25248":2029,"_5":25581,"_17581":47343,"_23883":47344,"_2389":47345},[],"/docs/pr-preview/pr-45/platform/pki/key-management#key-inventory","Key inventory",{"_2862":2040,"_25248":2029,"_5":25581,"_17581":47347,"_23883":47348,"_2389":47349},[],"/docs/pr-preview/pr-45/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_2862":2041,"_25248":2029,"_5":25581,"_17581":47351,"_23883":47352,"_2389":47353},[],"/docs/pr-preview/pr-45/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_2862":2042,"_25248":2029,"_5":25581,"_17581":47355,"_23883":47356,"_2389":47357},[],"/docs/pr-preview/pr-45/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_2862":2043,"_25248":2029,"_5":25581,"_17581":47359,"_23883":47360,"_2389":47361},[],"/docs/pr-preview/pr-45/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_2862":2044,"_25248":2029,"_5":25581,"_17581":47363,"_23883":47364,"_2389":47365},[],"/docs/pr-preview/pr-45/platform/pki/key-management#view-details","View details",{"_2862":2045,"_25248":2029,"_5":25581,"_17581":47367,"_23883":47368,"_2389":47369},[],"/docs/pr-preview/pr-45/platform/pki/key-management#sign-and-verify","Sign and verify",{"_2862":2046,"_25248":2029,"_5":25581,"_17581":47371,"_23883":47372,"_2389":47373},[],"/docs/pr-preview/pr-45/platform/pki/key-management#sign","Sign",{"_2862":2047,"_25248":2029,"_5":25581,"_17581":47375,"_23883":47376,"_2389":47377},[],"/docs/pr-preview/pr-45/platform/pki/key-management#verify","Verify",{"_2862":2048,"_25248":2029,"_5":25581,"_17581":47379,"_23883":47380,"_2389":47381},[],"/docs/pr-preview/pr-45/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_2862":2049,"_25248":2029,"_5":25581,"_17581":47383,"_23883":47384,"_2389":47385},[],"/docs/pr-preview/pr-45/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_2862":2050,"_25248":2029,"_5":25581,"_17581":47387,"_23883":47388,"_2389":47389},[],"/docs/pr-preview/pr-45/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_2862":2051,"_25248":2029,"_17581":47391,"_5":17476,"_23883":2029,"_2389":47392},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_2862":2052,"_25248":2029,"_17581":47394,"_5":17476,"_23883":2029,"_2389":47395},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_2862":2053,"_25248":2029,"_17581":47397,"_5":17476,"_23883":47312,"_2389":47398},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_2862":2054,"_25248":2029,"_17581":47400,"_5":17476,"_23883":47312,"_2389":47401},[],"In practice, it lets you:",{"_2862":2055,"_25248":2029,"_17581":47403,"_5":17476,"_23883":47312,"_2389":47404},[],"Generate new key pairs from Lamassu IoT.",{"_2862":2056,"_25248":2029,"_17581":47406,"_5":17476,"_23883":47312,"_2389":47407},[],"Import keys created externally.",{"_2862":2057,"_25248":2029,"_17581":47409,"_5":17476,"_23883":47312,"_2389":47410},[],"Delegate custody and cryptographic operations to external engines.",{"_2862":2058,"_25248":2029,"_17581":47412,"_5":17476,"_23883":47312,"_2389":47413},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_2862":2059,"_25248":2029,"_17581":47415,"_5":17476,"_23883":47316,"_2389":47416},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_2862":2060,"_25248":2029,"_17581":47418,"_5":17476,"_23883":47316,"_2389":47419},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_2862":2061,"_25248":2029,"_17581":47421,"_5":17476,"_23883":47316,"_2389":47422},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_2862":2062,"_25248":2029,"_17581":47424,"_5":17476,"_23883":47320,"_2389":47425},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_2862":2063,"_25248":2029,"_17581":47427,"_5":17476,"_23883":47324,"_2389":47428},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_2862":2064,"_25248":2029,"_17581":47430,"_5":17476,"_23883":47328,"_2389":47431},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_2862":2065,"_25248":2029,"_17581":47433,"_5":17476,"_23883":47332,"_2389":47434},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_2862":2066,"_25248":2029,"_17581":47436,"_5":17476,"_23883":47336,"_2389":47437},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_2862":2067,"_25248":2029,"_17581":47439,"_5":17476,"_23883":47340,"_2389":47440},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_2862":2068,"_25248":2029,"_17581":47442,"_5":17476,"_23883":47340,"_2389":47443},[],"Lamassu shows the enabled engines in the console.",{"_2862":2069,"_25248":2029,"_17581":47445,"_5":17476,"_23883":47340,"_2389":47446},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_2862":2070,"_25248":2029,"_17581":47448,"_5":17476,"_23883":47340,"_2389":47449},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_2862":2071,"_25248":2029,"_17581":47451,"_5":17476,"_23883":47344,"_2389":47452},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_2862":2072,"_25248":2029,"_17581":47454,"_5":17476,"_23883":47344,"_2389":47455},[],"The table includes the following fields:",{"_2862":2073,"_25248":2029,"_17581":47457,"_5":17476,"_23883":47344,"_2389":47458},[],"**Name**: descriptive name of the key.",{"_2862":2074,"_25248":2029,"_17581":47460,"_5":17476,"_23883":47344,"_2389":47461},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_2862":2075,"_25248":2029,"_17581":47463,"_5":17476,"_23883":47344,"_2389":47464},[],"**Strength**: visual indicator of cryptographic strength.",{"_2862":2076,"_25248":2029,"_17581":47466,"_5":17476,"_23883":47344,"_2389":47467},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_2862":2077,"_25248":2029,"_17581":47469,"_5":17476,"_23883":47344,"_2389":47470},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_2862":2078,"_25248":2029,"_17581":47472,"_5":17476,"_23883":47344,"_2389":47473},[],"**Aliases**: alternative names associated with the key.",{"_2862":2079,"_25248":2029,"_17581":47475,"_5":17476,"_23883":47344,"_2389":47476},[],"**Tags**: labels for classification and search.",{"_2862":2080,"_25248":2029,"_17581":47478,"_5":17476,"_23883":47344,"_2389":47479},[],"**Related Entities**: certificates or other entities linked to that key.",{"_2862":2081,"_25248":2029,"_17581":47481,"_5":17476,"_23883":47344,"_2389":47482},[],"From this view you also reach the most common actions:",{"_2862":2082,"_25248":2029,"_17581":47484,"_5":17476,"_23883":47344,"_2389":47485},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_2862":2083,"_25248":2029,"_17581":47487,"_5":17476,"_23883":47344,"_2389":47488},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_2862":2084,"_25248":2029,"_17581":47490,"_5":17476,"_23883":47344,"_2389":47491},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_2862":2085,"_25248":2029,"_17581":47493,"_5":17476,"_23883":47344,"_2389":47494},[],"**Delete Key** to remove the key from the system.",{"_2862":2086,"_25248":2029,"_17581":47496,"_5":17476,"_23883":47348,"_2389":47497},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_2862":2087,"_25248":2029,"_17581":47499,"_5":17476,"_23883":47352,"_2389":47500},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_2862":2088,"_25248":2029,"_17581":47502,"_5":17476,"_23883":47352,"_2389":47503},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_2862":2089,"_25248":2029,"_17581":47505,"_5":17476,"_23883":47352,"_2389":47506},[],"**Key Name**: unique and descriptive name.",{"_2862":2090,"_25248":2029,"_17581":47508,"_5":17476,"_23883":47352,"_2389":47509},[],"**Crypto Engine**: engine that will keep the key.",{"_2862":2091,"_25248":2029,"_17581":47511,"_5":17476,"_23883":47352,"_2389":47512},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_2862":2092,"_25248":2029,"_17581":47514,"_5":17476,"_23883":47352,"_2389":47515},[],"**Tags**: metadata to classify the key.",{"_2862":2093,"_25248":2029,"_17581":47517,"_5":17476,"_23883":47352,"_2389":47518},[],"**Metadata**: additional information for advanced uses.",{"_2862":2094,"_25248":2029,"_17581":47520,"_5":17476,"_23883":47356,"_2389":47521},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_2862":2095,"_25248":2029,"_17581":47523,"_5":17476,"_23883":47356,"_2389":47524},[],"When you have an exportable private key and the destination engine supports import.",{"_2862":2096,"_25248":2029,"_17581":47526,"_5":17476,"_23883":47356,"_2389":47527},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_2862":2097,"_25248":2029,"_17581":47529,"_5":17476,"_23883":47356,"_2389":47530},[],"When Lamassu must operate with a root of trust created by a third party.",{"_2862":2098,"_25248":2029,"_17581":47532,"_5":17476,"_23883":47356,"_2389":47533},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_2862":2099,"_25248":2029,"_17581":47535,"_5":17476,"_23883":47356,"_2389":47536},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_2862":2100,"_25248":2029,"_17581":47538,"_5":17476,"_23883":47356,"_2389":47539},[],"**Crypto Engine**: engine that will keep the imported key.",{"_2862":2101,"_25248":2029,"_17581":47541,"_5":17476,"_23883":47356,"_2389":47542},[],"**Tags**: labels for organization and search.",{"_2862":2102,"_25248":2029,"_17581":47544,"_5":17476,"_23883":47356,"_2389":47545},[],"**Metadata**: additional optional information.",{"_2862":2103,"_25248":2029,"_17581":47547,"_5":17476,"_23883":47356,"_2389":47548},[],"**Private Key (PEM)**: private key in PEM format.",{"_2862":2104,"_25248":2029,"_17581":47550,"_5":17476,"_23883":47356,"_2389":47551},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_2862":2105,"_25248":2029,"_17581":47553,"_5":17476,"_23883":47360,"_2389":47554},[],"Each registered key has a detail view and several operational actions.",{"_2862":2106,"_25248":2029,"_17581":47556,"_5":17476,"_23883":47364,"_2389":47557},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_2862":2107,"_25248":2029,"_17581":47559,"_5":17476,"_23883":47364,"_2389":47560},[],"The **Overview** tab shows, among others, these fields:",{"_2862":2108,"_25248":2029,"_17581":47562,"_5":17476,"_23883":47364,"_2389":47563},[],"**Key Name**: descriptive name.",{"_2862":2109,"_25248":2029,"_17581":47565,"_5":17476,"_23883":47364,"_2389":47566},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_2862":2110,"_25248":2029,"_17581":47568,"_5":17476,"_23883":47364,"_2389":47569},[],"**Tags**: associated labels.",{"_2862":2111,"_25248":2029,"_17581":47571,"_5":17476,"_23883":47364,"_2389":47572},[],"**Aliases**: alternative names.",{"_2862":2112,"_25248":2029,"_17581":47574,"_5":17476,"_23883":47364,"_2389":47575},[],"**Crypto Engine**: engine where the key resides.",{"_2862":2113,"_25248":2029,"_17581":47577,"_5":17476,"_23883":47364,"_2389":47578},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_2862":2114,"_25248":2029,"_17581":47580,"_5":17476,"_23883":47364,"_2389":47581},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_2862":2115,"_25248":2029,"_17581":47583,"_5":17476,"_23883":47364,"_2389":47584},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_2862":2116,"_25248":2029,"_17581":47586,"_5":17476,"_23883":47368,"_2389":47587},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_2862":2117,"_25248":2029,"_17581":47589,"_5":17476,"_23883":47368,"_2389":47590},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_2862":2118,"_25248":2029,"_17581":47592,"_5":17476,"_23883":47368,"_2389":47593},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_2862":2119,"_25248":2029,"_17581":47595,"_5":17476,"_23883":47372,"_2389":47596},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_2862":2120,"_25248":2029,"_17581":47598,"_5":17476,"_23883":47372,"_2389":47599},[],"Main fields:",{"_2862":2121,"_25248":2029,"_17581":47601,"_5":17476,"_23883":47372,"_2389":47602},[],"**Algorithm**: signing algorithm available for the key type.",{"_2862":2122,"_25248":2029,"_17581":47604,"_5":17476,"_23883":47372,"_2389":47605},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_2862":2123,"_25248":2029,"_17581":47607,"_5":17476,"_23883":47372,"_2389":47608},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_2862":2124,"_25248":2029,"_17581":47610,"_5":17476,"_23883":47372,"_2389":47611},[],"**Message**: content to sign.",{"_2862":2125,"_25248":2029,"_17581":47613,"_5":17476,"_23883":47372,"_2389":47614},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_2862":2126,"_25248":2029,"_17581":47616,"_5":17476,"_23883":47376,"_2389":47617},[],"This tab checks whether a signature corresponds to the associated public key.",{"_2862":2127,"_25248":2029,"_17581":47619,"_5":17476,"_23883":47376,"_2389":47599},[],{"_2862":2128,"_25248":2029,"_17581":47621,"_5":17476,"_23883":47376,"_2389":47622},[],"**Algorithm**: must match the algorithm used for the signature.",{"_2862":2129,"_25248":2029,"_17581":47624,"_5":17476,"_23883":47376,"_2389":47625},[],"**Message Type**: `Raw` or `Digest`.",{"_2862":2130,"_25248":2029,"_17581":47627,"_5":17476,"_23883":47376,"_2389":47628},[],"**Payload Encoding**: encoding of the message.",{"_2862":2131,"_25248":2029,"_17581":47630,"_5":17476,"_23883":47376,"_2389":47631},[],"**Message**: original message or hash.",{"_2862":2132,"_25248":2029,"_17581":47633,"_5":17476,"_23883":47376,"_2389":47634},[],"**Signature**: signature to check.",{"_2862":2133,"_25248":2029,"_17581":47636,"_5":17476,"_23883":47376,"_2389":47637},[],"**Result**: indicator of the validation result.",{"_2862":2134,"_25248":2029,"_17581":47639,"_5":17476,"_23883":47380,"_2389":47640},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_2862":2135,"_25248":2029,"_17581":47642,"_5":17476,"_23883":47380,"_2389":47643},[],"This flow is useful for:",{"_2862":2136,"_25248":2029,"_17581":47645,"_5":17476,"_23883":47380,"_2389":47646},[],"Requesting certificates from an external CA.",{"_2862":2137,"_25248":2029,"_17581":47648,"_5":17476,"_23883":47380,"_2389":47649},[],"Renewing an identity while keeping the same key.",{"_2862":2138,"_25248":2029,"_17581":47651,"_5":17476,"_23883":47380,"_2389":47652},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_2862":2139,"_25248":2029,"_17581":47654,"_5":17476,"_23883":47380,"_2389":47655},[],"**Common Name (CN)**: main name of the identity.",{"_2862":2140,"_25248":2029,"_17581":47657,"_5":17476,"_23883":47380,"_2389":47658},[],"**Organization (O)**: organization or company.",{"_2862":2141,"_25248":2029,"_17581":47660,"_5":17476,"_23883":47380,"_2389":47661},[],"**Organizational Unit (OU)**: department or unit.",{"_2862":2142,"_25248":2029,"_17581":47663,"_5":17476,"_23883":47380,"_2389":47664},[],"**Country (C)**: two-letter country code.",{"_2862":2143,"_25248":2029,"_17581":47666,"_5":17476,"_23883":47380,"_2389":47667},[],"**State / Province (ST)**: state or province.",{"_2862":2144,"_25248":2029,"_17581":47669,"_5":17476,"_23883":47380,"_2389":47670},[],"**Locality (L)**: city or locality.",{"_2862":2145,"_25248":2029,"_17581":47672,"_5":17476,"_23883":47380,"_2389":47673},[],"**Email Address**: contact email.",{"_2862":2146,"_25248":2029,"_17581":47675,"_5":17476,"_23883":47380,"_2389":47676},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_2862":2147,"_25248":2029,"_17581":47678,"_5":17476,"_23883":47380,"_2389":47679},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_2862":2148,"_25248":2029,"_17581":47681,"_5":17476,"_23883":47384,"_2389":47682},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_2862":2149,"_25248":2029,"_17581":47684,"_5":17476,"_23883":47384,"_2389":47685},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_2862":2150,"_25248":2029,"_17581":47687,"_5":17476,"_23883":47388,"_2389":47688},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_2862":2151,"_25248":2151,"_5":12326,"_2389":47690,"_25584":47691,"_17581":47692,"_23883":2151},"Online validation with OCSP",[40961,42324,46002,46619],[],{"_2862":2152,"_25248":2151,"_17581":47694,"_5":17476,"_23883":2151,"_2389":47695},[],"Query signed status and verify the responder’s response.",{"_2862":2153,"_25248":2151,"_5":25581,"_17581":47697,"_23883":47698,"_2389":47699},[],"/docs/pr-preview/pr-45/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_2862":2154,"_25248":2151,"_5":25581,"_17581":47701,"_23883":47702,"_2389":47703},[],"/docs/pr-preview/pr-45/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_2862":2155,"_25248":2151,"_5":25581,"_17581":47705,"_23883":47706,"_2389":47707},[],"/docs/pr-preview/pr-45/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_2862":2156,"_25248":2151,"_5":25581,"_17581":47709,"_23883":47710,"_2389":47711},[],"/docs/pr-preview/pr-45/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_2862":2157,"_25248":2151,"_5":25581,"_17581":47713,"_23883":47714,"_2389":47715},[],"/docs/pr-preview/pr-45/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_2862":2158,"_25248":2151,"_5":25581,"_17581":47717,"_23883":47718,"_2389":47165},[],"/docs/pr-preview/pr-45/platform/pki/ocsp#references",{"_2862":2159,"_25248":2151,"_17581":47720,"_5":17476,"_23883":2151,"_2389":47721},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_2862":2160,"_25248":2151,"_17581":47723,"_5":17476,"_23883":47698,"_2389":47724},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_2862":2161,"_25248":2151,"_17581":47726,"_5":17476,"_23883":47698,"_2389":47727},[],"Record status",{"_2862":2162,"_25248":2151,"_17581":47729,"_5":17476,"_23883":47698,"_2389":47730},[],"Signed response",{"_2862":2163,"_25248":2151,"_17581":47732,"_5":17476,"_23883":47698,"_2389":45180},[],{"_2862":2164,"_25248":2151,"_17581":47734,"_5":17476,"_23883":47698,"_2389":47735},[],"`Good`.",{"_2862":2165,"_25248":2151,"_17581":47737,"_5":17476,"_23883":47698,"_2389":45197},[],{"_2862":2166,"_25248":2151,"_17581":47739,"_5":17476,"_23883":47698,"_2389":47740},[],"`Revoked`, with revocation reason and timestamp.",{"_2862":2167,"_25248":2151,"_17581":47742,"_5":17476,"_23883":47698,"_2389":47743},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_2862":2168,"_25248":2151,"_17581":47745,"_5":17476,"_23883":47698,"_2389":47746},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_2862":2169,"_25248":2151,"_17581":47748,"_5":17476,"_23883":47698,"_2389":47749},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_2862":2170,"_25248":2151,"_17581":47751,"_5":17476,"_23883":47698,"_2389":47752},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_2862":2171,"_25248":2151,"_17581":47754,"_5":17476,"_23883":47698,"_2389":47755},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_2862":2172,"_25248":2151,"_17581":47757,"_5":17476,"_23883":47702,"_2389":47758},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_2862":2173,"_25248":2151,"_17581":47760,"_5":17476,"_23883":47702,"_2389":47761},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_2862":2174,"_25248":2151,"_17581":47763,"_5":17476,"_23883":47706,"_2389":47764},[],"The service accepts:",{"_2862":2175,"_25248":2151,"_17581":47766,"_5":17476,"_23883":47706,"_2389":44045},[],{"_2862":2176,"_25248":2151,"_17581":47768,"_5":17476,"_23883":47706,"_2389":47769},[],"VA service path",{"_2862":2177,"_25248":2151,"_17581":47771,"_5":17476,"_23883":47706,"_2389":47772},[],"Format",{"_2862":2178,"_25248":2151,"_17581":47774,"_5":17476,"_23883":47706,"_2389":47775},[],"`POST`",{"_2862":2179,"_25248":2151,"_17581":47777,"_5":17476,"_23883":47706,"_2389":47778},[],"`/ocsp`",{"_2862":2180,"_25248":2151,"_17581":47780,"_5":17476,"_23883":47706,"_2389":47781},[],"DER request, `Content-Type: application/ocsp-request`.",{"_2862":2181,"_25248":2151,"_17581":47783,"_5":17476,"_23883":47706,"_2389":47264},[],{"_2862":2182,"_25248":2151,"_17581":47785,"_5":17476,"_23883":47706,"_2389":47786},[],"`/ocsp/{ocsp_request}`",{"_2862":2183,"_25248":2151,"_17581":47788,"_5":17476,"_23883":47706,"_2389":47789},[],"DER request encoded using padded URL Base64.",{"_2862":2184,"_25248":2151,"_17581":47791,"_5":17476,"_23883":47706,"_2389":47792},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_2862":2185,"_25248":2151,"_17581":47794,"_5":17476,"_23883":47710,"_2389":47795},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_2862":2186,"_25248":2151,"_17581":47797,"_5":17476,"_23883":47710,"_2389":47798},[],"Generate the request:",{"_2862":2187,"_25248":2151,"_17581":47800,"_5":17476,"_23883":47710,"_2389":47801},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_2862":2188,"_25248":2151,"_17581":47803,"_5":17476,"_23883":47710,"_2389":47804},[],"Replace the example URL with the inspected endpoint:",{"_2862":2189,"_25248":2151,"_17581":47806,"_5":17476,"_23883":47710,"_2389":47807},[],"Verify the returned DER:",{"_2862":2190,"_25248":2151,"_17581":47809,"_5":17476,"_23883":47710,"_2389":47810},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_2862":2191,"_25248":2151,"_17581":47812,"_5":17476,"_23883":47714,"_2389":47813},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_2862":2192,"_25248":2151,"_17581":47815,"_5":17476,"_23883":47714,"_2389":47816},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_2862":2193,"_25248":2151,"_17581":47818,"_5":17476,"_23883":47718,"_2389":47819},[],"RFC 6960: OCSP.",{"_2862":2194,"_25248":2151,"_17581":47821,"_5":17476,"_23883":47718,"_2389":47822},[],"OpenSSL: openssl-ocsp.",{"_2862":2195,"_25248":2151,"_17581":47824,"_5":17476,"_23883":47718,"_2389":47825},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_2862":2196,"_25248":2151,"_17581":47827,"_5":17476,"_23883":47718,"_2389":47302},[],{"_2862":2197,"_25248":2197,"_5":12326,"_2389":46002,"_25584":47829,"_17581":47830,"_23883":2197},[40961,42324,46002],[],{"_2862":2198,"_25248":2197,"_17581":47832,"_5":17476,"_23883":2197,"_2389":47833},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_2862":2199,"_25248":2197,"_5":25581,"_17581":47835,"_23883":47836,"_2389":45312},[],"/docs/pr-preview/pr-45/platform/pki/overview#start-here",{"_2862":2200,"_25248":2197,"_5":25581,"_17581":47838,"_23883":47839,"_2389":47840},[],"/docs/pr-preview/pr-45/platform/pki/overview#what-you-need","What you need",{"_2862":2201,"_25248":2197,"_5":25581,"_17581":47842,"_23883":47843,"_2389":45846},[],"/docs/pr-preview/pr-45/platform/pki/overview#core-capabilities",{"_2862":2202,"_25248":2197,"_5":25581,"_17581":47845,"_23883":47846,"_2389":45850},[],"/docs/pr-preview/pr-45/platform/pki/overview#build-your-trust-hierarchy",{"_2862":2203,"_25248":2197,"_5":25581,"_17581":47848,"_23883":47849,"_2389":45854},[],"/docs/pr-preview/pr-45/platform/pki/overview#protect-cryptographic-keys",{"_2862":2204,"_25248":2197,"_5":25581,"_17581":47851,"_23883":47852,"_2389":45858},[],"/docs/pr-preview/pr-45/platform/pki/overview#issue-and-control-certificates",{"_2862":2205,"_25248":2197,"_5":25581,"_17581":47854,"_23883":47855,"_2389":45866},[],"/docs/pr-preview/pr-45/platform/pki/overview#publish-validation-status",{"_2862":2206,"_25248":2197,"_5":25581,"_17581":47857,"_23883":47858,"_2389":47859},[],"/docs/pr-preview/pr-45/platform/pki/overview#how-to-check-the-result","How to check the result",{"_2862":2207,"_25248":2197,"_5":25581,"_17581":47861,"_23883":47862,"_2389":46786},[],"/docs/pr-preview/pr-45/platform/pki/overview#continue",{"_2862":2208,"_25248":2197,"_17581":47864,"_5":17476,"_23883":2197,"_2389":47865},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_2862":2209,"_25248":2197,"_17581":47867,"_5":17476,"_23883":47836,"_2389":47868},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_2862":2210,"_25248":2197,"_17581":47870,"_5":17476,"_23883":47836,"_2389":47871},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_2862":2211,"_25248":2197,"_17581":47873,"_5":17476,"_23883":47839,"_2389":47874},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_2862":2212,"_25248":2197,"_17581":47876,"_5":17476,"_23883":47839,"_2389":47877},[],"An available cryptographic engine to keep the authority's key.",{"_2862":2213,"_25248":2197,"_17581":47879,"_5":17476,"_23883":47839,"_2389":47880},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_2862":2214,"_25248":2197,"_17581":47882,"_5":17476,"_23883":47839,"_2389":47883},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_2862":2215,"_25248":2197,"_17581":47885,"_5":17476,"_23883":47839,"_2389":47886},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_2862":2216,"_25248":2197,"_17581":47888,"_5":17476,"_23883":47846,"_2389":47889},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_2862":2217,"_25248":2197,"_17581":47891,"_5":17476,"_23883":47849,"_2389":47892},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_2862":2218,"_25248":2197,"_17581":47894,"_5":17476,"_23883":47852,"_2389":47895},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_2862":2219,"_25248":2197,"_17581":47897,"_5":17476,"_23883":47855,"_2389":47898},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_2862":2220,"_25248":2197,"_17581":47900,"_5":17476,"_23883":47858,"_2389":47901},[],"An active certificate in the console is one part of the check. Also verify that:",{"_2862":2221,"_25248":2197,"_17581":47903,"_5":17476,"_23883":47858,"_2389":47904},[],"its subject and extensions identify the expected client;",{"_2862":2222,"_25248":2197,"_17581":47906,"_5":17476,"_23883":47858,"_2389":47907},[],"its public key matches the client's private key;",{"_2862":2223,"_25248":2197,"_17581":47909,"_5":17476,"_23883":47858,"_2389":47910},[],"its chain reaches a root trusted by the consumer;",{"_2862":2224,"_25248":2197,"_17581":47912,"_5":17476,"_23883":47858,"_2389":47913},[],"its dates and usages allow the operation;",{"_2862":2225,"_25248":2197,"_17581":47915,"_5":17476,"_23883":47858,"_2389":47916},[],"the consumer applies revocation checks and authorization.",{"_2862":2226,"_25248":2197,"_17581":47918,"_5":17476,"_23883":47858,"_2389":47919},[],"The issuance path includes the first independent checks.",{"_2862":2227,"_25248":2197,"_17581":47921,"_5":17476,"_23883":47862,"_2389":47922},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2862":2228,"_25248":2197,"_17581":47924,"_5":17476,"_23883":47862,"_2389":47925},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2862":2229,"_25248":2197,"_17581":47927,"_5":17476,"_23883":47862,"_2389":47928},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2862":2230,"_25248":2230,"_5":12326,"_2389":47930,"_25584":47931,"_17581":47932,"_23883":2230},"Create your first CA",[40961,42324,46002,45437],[],{"_2862":2231,"_25248":2230,"_17581":47934,"_5":17476,"_23883":2230,"_2389":47935},[],"Create an evaluation root and check its certificate before issuing.",{"_2862":2232,"_25248":2230,"_5":25581,"_17581":47937,"_23883":47938,"_2389":40971},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_2862":2233,"_25248":2230,"_5":25581,"_17581":47940,"_23883":47941,"_2389":47942},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_2862":2234,"_25248":2230,"_5":25581,"_17581":47944,"_23883":47945,"_2389":47946},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_2862":2235,"_25248":2230,"_5":25581,"_17581":47948,"_23883":47949,"_2389":47950},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_2862":2236,"_25248":2230,"_5":25581,"_17581":47952,"_23883":47953,"_2389":47954},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_2862":2237,"_25248":2230,"_5":25581,"_17581":47956,"_23883":47957,"_2389":47958},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_2862":2238,"_25248":2230,"_5":25581,"_17581":47960,"_23883":47961,"_2389":47962},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_2862":2239,"_25248":2230,"_5":25581,"_17581":47964,"_23883":47965,"_2389":45695},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_2862":2240,"_25248":2230,"_5":25581,"_17581":47967,"_23883":47968,"_2389":40995},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/create-certificate-authority#next-step",{"_2862":2241,"_25248":2230,"_17581":47970,"_5":17476,"_23883":2230,"_2389":47971},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_2862":2242,"_25248":2230,"_17581":47973,"_5":17476,"_23883":47938,"_2389":47974},[],"Console access and permission to create keys and authorities.",{"_2862":2243,"_25248":2230,"_17581":47976,"_5":17476,"_23883":47938,"_2389":47977},[],"An available cryptographic engine that supports the chosen algorithm.",{"_2862":2244,"_25248":2230,"_17581":47979,"_5":17476,"_23883":47938,"_2389":47980},[],"OpenSSL 3.x to check the downloaded certificate.",{"_2862":2245,"_25248":2230,"_17581":47982,"_5":17476,"_23883":47938,"_2389":47983},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_2862":2246,"_25248":2230,"_17581":47985,"_5":17476,"_23883":47941,"_2389":47986},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_2862":2247,"_25248":2230,"_17581":47988,"_5":17476,"_23883":47941,"_2389":47989},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_2862":2248,"_25248":2230,"_17581":47991,"_5":17476,"_23883":47945,"_2389":47992},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_2862":2249,"_25248":2230,"_17581":47994,"_5":17476,"_23883":47945,"_2389":47995},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_2862":2250,"_25248":2230,"_17581":47997,"_5":17476,"_23883":47949,"_2389":47998},[],"Select **Root CA** and complete:",{"_2862":2251,"_25248":2230,"_17581":48000,"_5":17476,"_23883":47949,"_2389":48001},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_2862":2252,"_25248":2230,"_17581":48003,"_5":17476,"_23883":47949,"_2389":48004},[],"**Subject**: organization and country details for your evaluation.",{"_2862":2253,"_25248":2230,"_17581":48006,"_5":17476,"_23883":47949,"_2389":48007},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_2862":2254,"_25248":2230,"_17581":48009,"_5":17476,"_23883":47949,"_2389":48010},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_2862":2255,"_25248":2230,"_17581":48012,"_5":17476,"_23883":47949,"_2389":48013},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_2862":2256,"_25248":2230,"_17581":48015,"_5":17476,"_23883":47953,"_2389":48016},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_2862":2257,"_25248":2230,"_17581":48018,"_5":17476,"_23883":47957,"_2389":48019},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_2862":2258,"_25248":2230,"_17581":48021,"_5":17476,"_23883":47957,"_2389":48022},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_2862":2259,"_25248":2230,"_17581":48024,"_5":17476,"_23883":47961,"_2389":48025},[],"Run from the directory where you saved `ca.pem`:",{"_2862":2260,"_25248":2230,"_17581":48027,"_5":17476,"_23883":47961,"_2389":48028},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_2862":2261,"_25248":2230,"_17581":48030,"_5":17476,"_23883":47961,"_2389":48031},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_2862":2262,"_25248":2230,"_17581":48033,"_5":17476,"_23883":47965,"_2389":48034},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_2862":2263,"_25248":2230,"_17581":48036,"_5":17476,"_23883":47965,"_2389":48037},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_2862":2264,"_25248":2230,"_17581":48039,"_5":17476,"_23883":47965,"_2389":48040},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_2862":2265,"_25248":2230,"_17581":48042,"_5":17476,"_23883":47965,"_2389":48043},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_2862":2266,"_25248":2230,"_17581":48045,"_5":17476,"_23883":47968,"_2389":48046},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_2862":2267,"_25248":2267,"_5":12326,"_2389":48048,"_25584":48049,"_17581":48050,"_23883":2267},"Issue and verify a certificate",[40961,42324,46002,45437],[],{"_2862":2268,"_25248":2267,"_17581":48052,"_5":17476,"_23883":2267,"_2389":48053},[],"Issue a client certificate and check content, chain and key correspondence.",{"_2862":2269,"_25248":2267,"_5":25581,"_17581":48055,"_23883":48056,"_2389":40971},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_2862":2270,"_25248":2267,"_5":25581,"_17581":48058,"_23883":48059,"_2389":48060},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_2862":2271,"_25248":2267,"_5":25581,"_17581":48062,"_23883":48063,"_2389":48064},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_2862":2272,"_25248":2267,"_5":25581,"_17581":48066,"_23883":48067,"_2389":48068},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_2862":2273,"_25248":2267,"_5":25581,"_17581":48070,"_23883":48071,"_2389":48072},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_2862":2274,"_25248":2267,"_5":25581,"_17581":48074,"_23883":48075,"_2389":48076},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_2862":2275,"_25248":2267,"_5":25581,"_17581":48078,"_23883":48079,"_2389":47958},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_2862":2276,"_25248":2267,"_5":25581,"_17581":48081,"_23883":48082,"_2389":48083},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_2862":2277,"_25248":2267,"_5":25581,"_17581":48085,"_23883":48086,"_2389":48087},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_2862":2278,"_25248":2267,"_5":25581,"_17581":48089,"_23883":48090,"_2389":48091},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_2862":2279,"_25248":2267,"_5":25581,"_17581":48093,"_23883":48094,"_2389":45695},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_2862":2280,"_25248":2267,"_5":25581,"_17581":48096,"_23883":48097,"_2389":40995},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/issue-certificate#next-step",{"_2862":2281,"_25248":2267,"_17581":48099,"_5":17476,"_23883":2267,"_2389":48100},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_2862":2282,"_25248":2267,"_17581":48102,"_5":17476,"_23883":48056,"_2389":48103},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_2862":2283,"_25248":2267,"_17581":48105,"_5":17476,"_23883":48056,"_2389":48106},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_2862":2284,"_25248":2267,"_17581":48108,"_5":17476,"_23883":48056,"_2389":48109},[],"OpenSSL 3.x and a working directory with restricted access.",{"_2862":2285,"_25248":2267,"_17581":48111,"_5":17476,"_23883":48056,"_2389":48112},[],"A client identifier: here we use `device-001`.",{"_2862":2286,"_25248":2267,"_17581":48114,"_5":17476,"_23883":48056,"_2389":48115},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_2862":2287,"_25248":2267,"_17581":48117,"_5":17476,"_23883":48059,"_2389":48118},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_2862":2288,"_25248":2267,"_17581":48120,"_5":17476,"_23883":48063,"_2389":48121},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_2862":2289,"_25248":2267,"_17581":48123,"_5":17476,"_23883":48063,"_2389":48124},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_2862":2290,"_25248":2267,"_17581":48126,"_5":17476,"_23883":48067,"_2389":48127},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_2862":2291,"_25248":2267,"_17581":48129,"_5":17476,"_23883":48067,"_2389":48130},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_2862":2292,"_25248":2267,"_17581":48132,"_5":17476,"_23883":48071,"_2389":48133},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_2862":2293,"_25248":2267,"_17581":48135,"_5":17476,"_23883":48071,"_2389":48136},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_2862":2294,"_25248":2267,"_17581":48138,"_5":17476,"_23883":48075,"_2389":48139},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_2862":2295,"_25248":2267,"_17581":48141,"_5":17476,"_23883":48079,"_2389":48142},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_2862":2296,"_25248":2267,"_17581":48144,"_5":17476,"_23883":48082,"_2389":48145},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_2862":2297,"_25248":2267,"_17581":48147,"_5":17476,"_23883":48086,"_2389":48148},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_2862":2298,"_25248":2267,"_17581":48150,"_5":17476,"_23883":48086,"_2389":48151},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_2862":2299,"_25248":2267,"_17581":48153,"_5":17476,"_23883":48086,"_2389":48154},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_2862":2300,"_25248":2267,"_17581":48156,"_5":17476,"_23883":48090,"_2389":48157},[],"In Bash, compare the two public-key digests:",{"_2862":2301,"_25248":2267,"_17581":48159,"_5":17476,"_23883":48090,"_2389":48160},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_2862":2302,"_25248":2267,"_17581":48162,"_5":17476,"_23883":48090,"_2389":48163},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_2862":2303,"_25248":2267,"_17581":48165,"_5":17476,"_23883":48094,"_2389":45779},[],{"_2862":2304,"_25248":2267,"_17581":48167,"_5":17476,"_23883":48094,"_2389":48168},[],"What to review",{"_2862":2305,"_25248":2267,"_17581":48170,"_5":17476,"_23883":48094,"_2389":48171},[],"The CA rejects issuance",{"_2862":2306,"_25248":2267,"_17581":48173,"_5":17476,"_23883":48094,"_2389":48174},[],"Permissions, CA state and key, algorithm and profile.",{"_2862":2307,"_25248":2267,"_17581":48176,"_5":17476,"_23883":48094,"_2389":48177},[],"Different subject or usages",{"_2862":2308,"_25248":2267,"_17581":48179,"_5":17476,"_23883":48094,"_2389":48180},[],"Applied profile and requested values.",{"_2862":2309,"_25248":2267,"_17581":48182,"_5":17476,"_23883":48094,"_2389":48183},[],"Issuer cannot be found",{"_2862":2310,"_25248":2267,"_17581":48185,"_5":17476,"_23883":48094,"_2389":48186},[],"Downloaded CA and required intermediate chain.",{"_2862":2311,"_25248":2267,"_17581":48188,"_5":17476,"_23883":48094,"_2389":48189},[],"Validity fails",{"_2862":2312,"_25248":2267,"_17581":48191,"_5":17476,"_23883":48094,"_2389":48192},[],"Certificate and CA dates, and the computer's clock.",{"_2862":2313,"_25248":2267,"_17581":48194,"_5":17476,"_23883":48094,"_2389":48195},[],"Public-key digests differ",{"_2862":2314,"_25248":2267,"_17581":48197,"_5":17476,"_23883":48094,"_2389":48198},[],"Certificate and key files from the same issuance.",{"_2862":2315,"_25248":2267,"_17581":48200,"_5":17476,"_23883":48094,"_2389":48201},[],"See PKI diagnostics to narrow an issuance failure.",{"_2862":2316,"_25248":2267,"_17581":48203,"_5":17476,"_23883":48097,"_2389":48204},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_2862":2317,"_25248":2267,"_17581":48206,"_5":17476,"_23883":48097,"_2389":48207},[],"Manage certificates for inspection, status and revocation.",{"_2862":2318,"_25248":2267,"_17581":48209,"_5":17476,"_23883":48097,"_2389":48210},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_2862":2319,"_25248":2267,"_17581":48212,"_5":17476,"_23883":48097,"_2389":48213},[],"Prepare EST for the device to request its next identities.",{"_2862":2320,"_25248":2267,"_17581":48215,"_5":17476,"_23883":48097,"_2389":48216},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_2862":2321,"_25248":2321,"_5":12326,"_2389":48218,"_25584":48219,"_17581":48220,"_23883":2321},"PKI getting started",[40961,42324,46002,45437],[],{"_2862":2322,"_25248":2321,"_17581":48222,"_5":17476,"_23883":2321,"_2389":48223},[],"Create a CA, issue a client certificate and check its chain and key.",{"_2862":2323,"_25248":2321,"_5":25581,"_17581":48225,"_23883":48226,"_2389":40971},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/overview#before-you-begin",{"_2862":2324,"_25248":2321,"_5":25581,"_17581":48228,"_23883":48229,"_2389":48230},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_2862":2325,"_25248":2321,"_5":25581,"_17581":48232,"_23883":48233,"_2389":45629},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/overview#expected-result",{"_2862":2326,"_25248":2321,"_5":25581,"_17581":48235,"_23883":48236,"_2389":48237},[],"/docs/pr-preview/pr-45/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_2862":2327,"_25248":2321,"_17581":48239,"_5":17476,"_23883":2321,"_2389":48240},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_2862":2328,"_25248":2321,"_17581":48242,"_5":17476,"_23883":48226,"_2389":48243},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_2862":2329,"_25248":2321,"_17581":48245,"_5":17476,"_23883":48226,"_2389":48246},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_2862":2330,"_25248":2321,"_17581":48248,"_5":17476,"_23883":48226,"_2389":48249},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_2862":2331,"_25248":2321,"_17581":48251,"_5":17476,"_23883":48226,"_2389":48252},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_2862":2332,"_25248":2321,"_17581":48254,"_5":17476,"_23883":48226,"_2389":48255},[],"A working directory with restricted access for the downloaded key.",{"_2862":2333,"_25248":2321,"_17581":48257,"_5":17476,"_23883":48229,"_2389":48258},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2862":2334,"_25248":2321,"_17581":48260,"_5":17476,"_23883":48229,"_2389":48261},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2862":2335,"_25248":2321,"_17581":48263,"_5":17476,"_23883":48229,"_2389":48264},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_2862":2336,"_25248":2321,"_17581":48266,"_5":17476,"_23883":48229,"_2389":48267},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_2862":2337,"_25248":2321,"_17581":48269,"_5":17476,"_23883":48233,"_2389":48270},[],"File or resource",{"_2862":2338,"_25248":2321,"_17581":48272,"_5":17476,"_23883":48233,"_2389":45626},[],{"_2862":2339,"_25248":2321,"_17581":48274,"_5":17476,"_23883":48233,"_2389":48275},[],"Active root CA and `ca.pem`",{"_2862":2340,"_25248":2321,"_17581":48277,"_5":17476,"_23883":48233,"_2389":48278},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_2862":2341,"_25248":2321,"_17581":48280,"_5":17476,"_23883":48233,"_2389":48281},[],"End-entity certificate and `device.crt`",{"_2862":2342,"_25248":2321,"_17581":48283,"_5":17476,"_23883":48233,"_2389":48284},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_2862":2343,"_25248":2321,"_17581":48286,"_5":17476,"_23883":48233,"_2389":48287},[],"Private key `device.key`",{"_2862":2344,"_25248":2321,"_17581":48289,"_5":17476,"_23883":48233,"_2389":48290},[],"Its public key matches the one included in `device.crt`.",{"_2862":2345,"_25248":2321,"_17581":48292,"_5":17476,"_23883":48233,"_2389":48293},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_2862":2346,"_25248":2321,"_17581":48295,"_5":17476,"_23883":48236,"_2389":48296},[],"To operate certificates, continue with Certificates and Validation.",{"_2862":2347,"_25248":2321,"_17581":48298,"_5":17476,"_23883":48236,"_2389":48299},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_2862":2348,"_25248":2321,"_17581":48301,"_5":17476,"_23883":48236,"_2389":48302},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_2862":2349,"_25248":2349,"_5":12326,"_2389":48304,"_25584":48305,"_17581":48306,"_23883":2349},"PKI troubleshooting",[40961,42324,46002,44823],[],{"_2862":2350,"_25248":2349,"_17581":48308,"_5":17476,"_23883":2349,"_2389":48309},[],"Diagnose certificate issuance, OCSP and CRL.",{"_2862":2351,"_25248":2349,"_5":25581,"_17581":48311,"_23883":48312,"_2389":48313},[],"/docs/pr-preview/pr-45/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_2862":2352,"_25248":2349,"_5":25581,"_17581":48315,"_23883":48316,"_2389":48317},[],"/docs/pr-preview/pr-45/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_2862":2353,"_25248":2349,"_5":25581,"_17581":48319,"_23883":48320,"_2389":48321},[],"/docs/pr-preview/pr-45/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_2862":2354,"_25248":2349,"_17581":48323,"_5":17476,"_23883":2349,"_2389":48324},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_2862":2355,"_25248":2349,"_17581":48326,"_5":17476,"_23883":2349,"_2389":48327},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_2862":2356,"_25248":2349,"_17581":48329,"_5":17476,"_23883":48312,"_2389":45626},[],{"_2862":2357,"_25248":2349,"_17581":48331,"_5":17476,"_23883":48312,"_2389":48332},[],"What to inspect",{"_2862":2358,"_25248":2349,"_17581":48334,"_5":17476,"_23883":48312,"_2389":40995},[],{"_2862":2359,"_25248":2349,"_17581":48336,"_5":17476,"_23883":48312,"_2389":48337},[],"CA",{"_2862":2360,"_25248":2349,"_17581":48339,"_5":17476,"_23883":48312,"_2389":48340},[],"Exists, is active and has usable dates.",{"_2862":2361,"_25248":2349,"_17581":48342,"_5":17476,"_23883":48312,"_2389":48343},[],"Authorities.",{"_2862":2362,"_25248":2349,"_17581":48345,"_5":17476,"_23883":48312,"_2389":48346},[],"Key",{"_2862":2363,"_25248":2349,"_17581":48348,"_5":17476,"_23883":48312,"_2389":48349},[],"The record has a usable private key and the engine can sign.",{"_2862":2364,"_25248":2349,"_17581":48351,"_5":17476,"_23883":48312,"_2389":48352},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_2862":2365,"_25248":2349,"_17581":48354,"_5":17476,"_23883":48312,"_2389":48355},[],"CSR",{"_2862":2366,"_25248":2349,"_17581":48357,"_5":17476,"_23883":48312,"_2389":48358},[],"Correct PEM and verifiable signature.",{"_2862":2367,"_25248":2349,"_17581":48360,"_5":17476,"_23883":48312,"_2389":48361},[],"`openssl req -in request.csr -noout -verify -text`.",{"_2862":2368,"_25248":2349,"_17581":48363,"_5":17476,"_23883":48312,"_2389":48364},[],"Profile",{"_2862":2369,"_25248":2349,"_17581":48366,"_5":17476,"_23883":48312,"_2389":48367},[],"Selected source, existing ID, allowed algorithm and size.",{"_2862":2370,"_25248":2349,"_17581":48369,"_5":17476,"_23883":48312,"_2389":48370},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_2862":2371,"_25248":2349,"_17581":48372,"_5":17476,"_23883":48312,"_2389":45779},[],{"_2862":2372,"_25248":2349,"_17581":48374,"_5":17476,"_23883":48312,"_2389":48375},[],"Appropriate subject, SAN, usages and dates.",{"_2862":2373,"_25248":2349,"_17581":48377,"_5":17476,"_23883":48312,"_2389":48378},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_2862":2374,"_25248":2349,"_17581":48380,"_5":17476,"_23883":48312,"_2389":48381},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_2862":2375,"_25248":2349,"_17581":48383,"_5":17476,"_23883":48312,"_2389":48384},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_2862":2376,"_25248":2349,"_17581":48386,"_5":17476,"_23883":48316,"_2389":48387},[],"Check each boundary independently:",{"_2862":2377,"_25248":2349,"_17581":48389,"_5":17476,"_23883":48316,"_2389":48390},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_2862":2378,"_25248":2349,"_17581":48392,"_5":17476,"_23883":48316,"_2389":48393},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_2862":2379,"_25248":2349,"_17581":48395,"_5":17476,"_23883":48316,"_2389":48396},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_2862":2380,"_25248":2349,"_17581":48398,"_5":17476,"_23883":48316,"_2389":48399},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_2862":2381,"_25248":2349,"_17581":48401,"_5":17476,"_23883":48316,"_2389":48402},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_2862":2382,"_25248":2349,"_17581":48404,"_5":17476,"_23883":48316,"_2389":48405},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_2862":2383,"_25248":2349,"_17581":48407,"_5":17476,"_23883":48320,"_2389":48408},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_2862":2384,"_25248":2349,"_17581":48410,"_5":17476,"_23883":48320,"_2389":48411},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.","count","sorting",{"_48415":48416,"_48417":48418,"_48419":48420,"_48421":48422,"_15203":2411,"_57916":2411},"language","english","sortableProperties",[2389,25248,5,23883],"sortablePropertiesWithTypes",{"_2389":21013,"_25248":21013,"_5":21013,"_23883":21013},"sorts",{"_2389":48423,"_25248":50797,"_5":53170,"_23883":55543},{"_3837":48424,"_48425":48426,"_5":21013},{"_12071":5069,"_12414":8797,"_12421":3710,"_24431":13128,"_23996":18098,"_16684":2625,"_12092":2720,"_12099":4248,"_24393":2735,"_24743":6317,"_24764":14064,"_24406":3431,"_29056":2551,"_24775":12449,"_29061":24923,"_29064":19921,"_29067":5389,"_29070":16336,"_29073":2627,"_25106":3822,"_29078":2636,"_29080":20362,"_25154":6240,"_25096":6739,"_29084":2698,"_25122":4628,"_29088":7189,"_24793":13558,"_25101":6293,"_25172":3123,"_29093":3942,"_29095":5727,"_29097":2467,"_29099":3068,"_29101":5184,"_29103":5699,"_29105":