03245,"_33678":103248,"_33680":103251,"_33682":103254,"_33684":103256,"_33686":103259,"_33688":103262,"_33690":103265,"_33692":103268,"_33694":103271,"_33696":103274,"_33698":103277,"_33700":103280,"_33702":103283,"_33704":103286,"_33706":103291,"_33708":103294,"_33710":103298,"_33712":103302,"_33714":103306,"_33716":103309,"_33718":103312,"_33720":103314,"_33722":103316,"_33724":103318,"_33726":103320,"_33728":103323,"_33730":103326,"_33732":103329,"_33734":103332,"_33736":103335,"_33738":103337,"_33740":103340,"_33742":103342,"_33744":103345,"_33746":103348,"_33748":103351,"_33750":103353,"_33752":103356,"_33754":103359,"_33756":103362,"_33758":103365,"_33760":103368,"_33762":103371,"_33764":103374,"_33766":103377,"_33768":103380,"_33770":103383,"_33772":103386,"_33774":103389},{"_2862":57923,"_25248":57923,"_5":12326,"_2389":96111,"_25584":96112,"_17581":96115,"_23883":57923},"Despliega desde AWS Marketplace",[40961,96113,96114],"Despliegue","Otros modelos",[],{"_2862":57924,"_25248":57923,"_17581":96117,"_5":17476,"_23883":57923,"_2389":96118},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_2862":57925,"_25248":57923,"_5":25581,"_17581":96120,"_23883":96121,"_2389":96122},[],"/docs/pr-preview/pr-45/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_2862":57926,"_25248":57923,"_5":25581,"_17581":96124,"_23883":96125,"_2389":96126},[],"/docs/pr-preview/pr-45/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_2862":57927,"_25248":57923,"_5":25581,"_17581":96128,"_23883":96129,"_2389":96130},[],"/docs/pr-preview/pr-45/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_2862":57928,"_25248":57923,"_5":25581,"_17581":96132,"_23883":96133,"_2389":96134},[],"/docs/pr-preview/pr-45/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_2862":57929,"_25248":57923,"_5":25581,"_17581":96136,"_23883":96137,"_2389":96138},[],"/docs/pr-preview/pr-45/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_2862":57930,"_25248":57923,"_5":25581,"_17581":96140,"_23883":96141,"_2389":96142},[],"/docs/pr-preview/pr-45/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_2862":57931,"_25248":57923,"_5":25581,"_17581":96144,"_23883":96145,"_2389":96146},[],"/docs/pr-preview/pr-45/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_2862":57932,"_25248":57923,"_17581":96148,"_5":17476,"_23883":57923,"_2389":96149},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_2862":57933,"_25248":57923,"_17581":96151,"_5":17476,"_23883":96121,"_2389":96152},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_2862":57934,"_25248":57923,"_17581":96154,"_5":17476,"_23883":96121,"_2389":96155},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_2862":57935,"_25248":57923,"_17581":96157,"_5":17476,"_23883":96121,"_2389":96158},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_2862":57936,"_25248":57923,"_17581":96160,"_5":17476,"_23883":96125,"_2389":96161},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_2862":57937,"_25248":57923,"_17581":96163,"_5":17476,"_23883":96125,"_2389":96164},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_2862":57938,"_25248":57923,"_17581":96166,"_5":17476,"_23883":96125,"_2389":96167},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_2862":57939,"_25248":57923,"_17581":96169,"_5":17476,"_23883":96129,"_2389":96170},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_2862":57940,"_25248":57923,"_17581":96172,"_5":17476,"_23883":96133,"_2389":96173},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_2862":57941,"_25248":57923,"_17581":96175,"_5":17476,"_23883":96137,"_2389":96176},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_2862":57942,"_25248":57923,"_17581":96178,"_5":17476,"_23883":96141,"_2389":96179},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_2862":57943,"_25248":57923,"_17581":96181,"_5":17476,"_23883":96145,"_2389":96182},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_2862":57944,"_25248":57944,"_5":12326,"_2389":96184,"_25584":96185,"_17581":96186,"_23883":57944},"Despliega Lamassu",[40961,96113],[],{"_2862":57945,"_25248":57944,"_17581":96188,"_5":17476,"_23883":57944,"_2389":96189},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_2862":57946,"_25248":57944,"_5":25581,"_17581":96191,"_23883":96192,"_2389":96193},[],"/docs/pr-preview/pr-45/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_2862":57947,"_25248":57944,"_5":25581,"_17581":96195,"_23883":96196,"_2389":96197},[],"/docs/pr-preview/pr-45/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_2862":57948,"_25248":57944,"_5":25581,"_17581":96199,"_23883":96200,"_2389":96201},[],"/docs/pr-preview/pr-45/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_2862":57949,"_25248":57944,"_17581":96203,"_5":17476,"_23883":57944,"_2389":96204},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_2862":57950,"_25248":57944,"_17581":96206,"_5":17476,"_23883":96192,"_2389":96207},[],"Modelo",{"_2862":57951,"_25248":57944,"_17581":96209,"_5":17476,"_23883":96192,"_2389":96210},[],"Recomendado para",{"_2862":57952,"_25248":57944,"_17581":96212,"_5":17476,"_23883":96192,"_2389":96213},[],"Quién opera la infraestructura",{"_2862":57953,"_25248":57944,"_17581":96215,"_5":17476,"_23883":96192,"_2389":96216},[],"Punto de partida",{"_2862":57954,"_25248":57944,"_17581":96218,"_5":17476,"_23883":96192,"_2389":41068},[],{"_2862":57955,"_25248":57944,"_17581":96220,"_5":17476,"_23883":96192,"_2389":96221},[],"Producción, entornos regulados y despliegues personalizados",{"_2862":57956,"_25248":57944,"_17581":96223,"_5":17476,"_23883":96192,"_2389":96224},[],"Tu equipo",{"_2862":57957,"_25248":57944,"_17581":96226,"_5":17476,"_23883":96192,"_2389":96227},[],"Helm o Fastlane",{"_2862":57958,"_25248":57944,"_17581":96229,"_5":17476,"_23883":96192,"_2389":41080},[],{"_2862":57959,"_25248":57944,"_17581":96231,"_5":17476,"_23883":96192,"_2389":96232},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_2862":57960,"_25248":57944,"_17581":96234,"_5":17476,"_23883":96192,"_2389":96224},[],{"_2862":57961,"_25248":57944,"_17581":96236,"_5":17476,"_23883":96192,"_2389":96237},[],"Imagen preconfigurada en EC2",{"_2862":57962,"_25248":57944,"_17581":96239,"_5":17476,"_23883":96192,"_2389":41091},[],{"_2862":57963,"_25248":57944,"_17581":96241,"_5":17476,"_23883":96192,"_2389":96242},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_2862":57964,"_25248":57944,"_17581":96244,"_5":17476,"_23883":96192,"_2389":41097},[],{"_2862":57965,"_25248":57944,"_17581":96246,"_5":17476,"_23883":96192,"_2389":96247},[],"Suscripción gestionada",{"_2862":57966,"_25248":57944,"_17581":96249,"_5":17476,"_23883":96192,"_2389":96250},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2862":57967,"_25248":57944,"_17581":96252,"_5":17476,"_23883":96192,"_2389":96253},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2862":57968,"_25248":57944,"_17581":96255,"_5":17476,"_23883":96192,"_2389":96256},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_2862":57969,"_25248":57944,"_17581":96258,"_5":17476,"_23883":96196,"_2389":96259},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_2862":57970,"_25248":57944,"_17581":96261,"_5":17476,"_23883":96200,"_2389":96262},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_2862":57971,"_25248":57971,"_5":12326,"_2389":96264,"_25584":96265,"_17581":96266,"_23883":57971},"Utiliza Lamassu como SaaS",[40961,96113,96114],[],{"_2862":57972,"_25248":57971,"_17581":96268,"_5":17476,"_23883":57971,"_2389":96269},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_2862":57973,"_25248":57971,"_5":25581,"_17581":96271,"_23883":96272,"_2389":96273},[],"/docs/pr-preview/pr-45/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_2862":57974,"_25248":57971,"_5":25581,"_17581":96275,"_23883":96276,"_2389":96277},[],"/docs/pr-preview/pr-45/es/deployment/saas#planes","Planes",{"_2862":57975,"_25248":57971,"_5":25581,"_17581":96279,"_23883":96280,"_2389":96281},[],"/docs/pr-preview/pr-45/es/deployment/saas#solicita-acceso","Solicita acceso",{"_2862":57976,"_25248":57971,"_17581":96283,"_5":17476,"_23883":57971,"_2389":96284},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_2862":57977,"_25248":57971,"_17581":96286,"_5":17476,"_23883":96272,"_2389":96287},[],"Disponibilidad y mantenimiento de la plataforma.",{"_2862":57978,"_25248":57971,"_17581":96289,"_5":17476,"_23883":96272,"_2389":96290},[],"Copias de seguridad automáticas.",{"_2862":57979,"_25248":57971,"_17581":96292,"_5":17476,"_23883":96272,"_2389":96293},[],"Actualizaciones de versión.",{"_2862":57980,"_25248":57971,"_17581":96295,"_5":17476,"_23883":96272,"_2389":96296},[],"Soporte técnico y SLA según el plan contratado.",{"_2862":57981,"_25248":57971,"_17581":96298,"_5":17476,"_23883":96276,"_2389":41152},[],{"_2862":57982,"_25248":57971,"_17581":96300,"_5":17476,"_23883":96276,"_2389":96301},[],"Dispositivos",{"_2862":57983,"_25248":57971,"_17581":96303,"_5":17476,"_23883":96276,"_2389":96304},[],"Soporte",{"_2862":57984,"_25248":57971,"_17581":96306,"_5":17476,"_23883":96276,"_2389":41161},[],{"_2862":57985,"_25248":57971,"_17581":96308,"_5":17476,"_23883":96276,"_2389":41164},[],{"_2862":57986,"_25248":57971,"_17581":96310,"_5":17476,"_23883":96276,"_2389":96311},[],"Hasta 1.000",{"_2862":57987,"_25248":57971,"_17581":96313,"_5":17476,"_23883":96276,"_2389":41170},[],{"_2862":57988,"_25248":57971,"_17581":96315,"_5":17476,"_23883":96276,"_2389":96316},[],"99,5 %",{"_2862":57989,"_25248":57971,"_17581":96318,"_5":17476,"_23883":96276,"_2389":41176},[],{"_2862":57990,"_25248":57971,"_17581":96320,"_5":17476,"_23883":96276,"_2389":96321},[],"Hasta 10.000",{"_2862":57991,"_25248":57971,"_17581":96323,"_5":17476,"_23883":96276,"_2389":96324},[],"Email y chat",{"_2862":57992,"_25248":57971,"_17581":96326,"_5":17476,"_23883":96276,"_2389":96327},[],"99,9 %",{"_2862":57993,"_25248":57971,"_17581":96329,"_5":17476,"_23883":96276,"_2389":41188},[],{"_2862":57994,"_25248":57971,"_17581":96331,"_5":17476,"_23883":96276,"_2389":96332},[],"Ilimitados",{"_2862":57995,"_25248":57971,"_17581":96334,"_5":17476,"_23883":96276,"_2389":96335},[],"Dedicado",{"_2862":57996,"_25248":57971,"_17581":96337,"_5":17476,"_23883":96276,"_2389":96338},[],"99,99 %",{"_2862":57997,"_25248":57971,"_17581":96340,"_5":17476,"_23883":96280,"_2389":96341},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_2862":57998,"_25248":57971,"_17581":96343,"_5":17476,"_23883":96280,"_2389":96344},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_2862":57999,"_25248":57999,"_5":12326,"_2389":41205,"_25584":96346,"_17581":96348,"_23883":57999},[40961,96113,96347],"Kubernetes autogestionado",[],{"_2862":58000,"_25248":57999,"_17581":96350,"_5":17476,"_23883":57999,"_2389":96351},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_2862":58001,"_25248":57999,"_5":25581,"_17581":96353,"_23883":96354,"_2389":96355},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_2862":58002,"_25248":57999,"_5":25581,"_17581":96357,"_23883":96358,"_2389":96359},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_2862":58003,"_25248":57999,"_5":25581,"_17581":96361,"_23883":96362,"_2389":96363},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_2862":58004,"_25248":57999,"_5":25581,"_17581":96365,"_23883":96366,"_2389":96367},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_2862":58005,"_25248":57999,"_5":25581,"_17581":96369,"_23883":96370,"_2389":96371},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_2862":58006,"_25248":57999,"_5":25581,"_17581":96373,"_23883":96374,"_2389":96375},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_2862":58007,"_25248":57999,"_5":25581,"_17581":96377,"_23883":96378,"_2389":96379},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_2862":58008,"_25248":57999,"_5":25581,"_17581":96381,"_23883":96382,"_2389":96383},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_2862":58009,"_25248":57999,"_5":25581,"_17581":96385,"_23883":96386,"_2389":96387},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_2862":58010,"_25248":57999,"_5":25581,"_17581":96389,"_23883":96390,"_2389":96391},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_2862":58011,"_25248":57999,"_17581":96393,"_5":17476,"_23883":96354,"_2389":96394},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_2862":58012,"_25248":57999,"_17581":96396,"_5":17476,"_23883":96354,"_2389":96397},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_2862":58013,"_25248":57999,"_17581":96399,"_5":17476,"_23883":96358,"_2389":96400},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_2862":58014,"_25248":57999,"_17581":96402,"_5":17476,"_23883":96358,"_2389":96403},[],"Fastlane instala o configura",{"_2862":58015,"_25248":57999,"_17581":96405,"_5":17476,"_23883":96358,"_2389":96406},[],"Tú sigues proporcionando",{"_2862":58016,"_25248":57999,"_17581":96408,"_5":17476,"_23883":96358,"_2389":96409},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_2862":58017,"_25248":57999,"_17581":96411,"_5":17476,"_23883":96358,"_2389":96412},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_2862":58018,"_25248":57999,"_17581":96414,"_5":17476,"_23883":96358,"_2389":96415},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_2862":58019,"_25248":57999,"_17581":96417,"_5":17476,"_23883":96358,"_2389":96418},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_2862":58020,"_25248":57999,"_17581":96420,"_5":17476,"_23883":96358,"_2389":96421},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_2862":58021,"_25248":57999,"_17581":96423,"_5":17476,"_23883":96358,"_2389":96424},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_2862":58022,"_25248":57999,"_17581":96426,"_5":17476,"_23883":96358,"_2389":96427},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_2862":58023,"_25248":57999,"_17581":96429,"_5":17476,"_23883":96358,"_2389":96430},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_2862":58024,"_25248":57999,"_17581":96432,"_5":17476,"_23883":96358,"_2389":96433},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_2862":58025,"_25248":57999,"_17581":96435,"_5":17476,"_23883":96362,"_2389":96436},[],"Necesitas:",{"_2862":58026,"_25248":57999,"_17581":96438,"_5":17476,"_23883":96362,"_2389":96439},[],"un clúster Kubernetes existente",{"_2862":58027,"_25248":57999,"_17581":96441,"_5":17476,"_23883":96362,"_2389":96442},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_2862":58028,"_25248":57999,"_17581":96444,"_5":17476,"_23883":96362,"_2389":41303},[],{"_2862":58029,"_25248":57999,"_17581":96446,"_5":17476,"_23883":96362,"_2389":19918},[],{"_2862":58030,"_25248":57999,"_17581":96448,"_5":17476,"_23883":96362,"_2389":96449},[],"`jq` solo si usas `--sample-data`",{"_2862":58031,"_25248":57999,"_17581":96451,"_5":17476,"_23883":96362,"_2389":96452},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_2862":58032,"_25248":57999,"_17581":96454,"_5":17476,"_23883":96362,"_2389":96455},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_2862":58033,"_25248":57999,"_17581":96457,"_5":17476,"_23883":96362,"_2389":96458},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_2862":58034,"_25248":57999,"_17581":96460,"_5":17476,"_23883":96366,"_2389":96461},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_2862":58035,"_25248":57999,"_17581":96463,"_5":17476,"_23883":96366,"_2389":96464},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_2862":58036,"_25248":57999,"_17581":96466,"_5":17476,"_23883":96370,"_2389":96467},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_2862":58037,"_25248":57999,"_17581":96469,"_5":17476,"_23883":96370,"_2389":96470},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_2862":58038,"_25248":57999,"_17581":96472,"_5":17476,"_23883":96370,"_2389":96473},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_2862":58039,"_25248":57999,"_17581":96475,"_5":17476,"_23883":96370,"_2389":96476},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_2862":58040,"_25248":57999,"_17581":96478,"_5":17476,"_23883":96374,"_2389":96479},[],"Opción",{"_2862":58041,"_25248":57999,"_17581":96481,"_5":17476,"_23883":96374,"_2389":96482},[],"Valor predeterminado",{"_2862":58042,"_25248":57999,"_17581":96484,"_5":17476,"_23883":96374,"_2389":96485},[],"Propósito",{"_2862":58043,"_25248":57999,"_17581":96487,"_5":17476,"_23883":96374,"_2389":41347},[],{"_2862":58044,"_25248":57999,"_17581":96489,"_5":17476,"_23883":96374,"_2389":41350},[],{"_2862":58045,"_25248":57999,"_17581":96491,"_5":17476,"_23883":96374,"_2389":96492},[],"Muestra la ayuda",{"_2862":58046,"_25248":57999,"_17581":96494,"_5":17476,"_23883":96374,"_2389":41356},[],{"_2862":58047,"_25248":57999,"_17581":96496,"_5":17476,"_23883":96374,"_2389":96497},[],"contexto actual",{"_2862":58048,"_25248":57999,"_17581":96499,"_5":17476,"_23883":96374,"_2389":96500},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_2862":58049,"_25248":57999,"_17581":96502,"_5":17476,"_23883":96374,"_2389":41365},[],{"_2862":58050,"_25248":57999,"_17581":96504,"_5":17476,"_23883":96374,"_2389":5365},[],{"_2862":58051,"_25248":57999,"_17581":96506,"_5":17476,"_23883":96374,"_2389":96507},[],"Omite prompts y genera credenciales para las dependencias",{"_2862":58052,"_25248":57999,"_17581":96509,"_5":17476,"_23883":96374,"_2389":41373},[],{"_2862":58053,"_25248":57999,"_17581":96511,"_5":17476,"_23883":96374,"_2389":41376},[],{"_2862":58054,"_25248":57999,"_17581":96513,"_5":17476,"_23883":96374,"_2389":96514},[],"Namespace de la instalación",{"_2862":58055,"_25248":57999,"_17581":96516,"_5":17476,"_23883":96374,"_2389":41382},[],{"_2862":58056,"_25248":57999,"_17581":96518,"_5":17476,"_23883":96374,"_2389":41385},[],{"_2862":58057,"_25248":57999,"_17581":96520,"_5":17476,"_23883":96374,"_2389":96521},[],"Dominio usado por la UI, OIDC y el certificado",{"_2862":58058,"_25248":57999,"_17581":96523,"_5":17476,"_23883":96374,"_2389":41391},[],{"_2862":58059,"_25248":57999,"_17581":96525,"_5":17476,"_23883":96374,"_2389":12571},[],{"_2862":58060,"_25248":57999,"_17581":96527,"_5":17476,"_23883":96374,"_2389":96528},[],"Versión del chart de Lamassu",{"_2862":58061,"_25248":57999,"_17581":96530,"_5":17476,"_23883":96374,"_2389":41399},[],{"_2862":58062,"_25248":57999,"_17581":96532,"_5":17476,"_23883":96374,"_2389":41402},[],{"_2862":58063,"_25248":57999,"_17581":96534,"_5":17476,"_23883":96374,"_2389":96535},[],"Puerto del listener HTTPS",{"_2862":58064,"_25248":57999,"_17581":96537,"_5":17476,"_23883":96374,"_2389":41408},[],{"_2862":58065,"_25248":57999,"_17581":96539,"_5":17476,"_23883":96374,"_2389":41411},[],{"_2862":58066,"_25248":57999,"_17581":96541,"_5":17476,"_23883":96374,"_2389":96542},[],"Puerto del listener HTTP",{"_2862":58067,"_25248":57999,"_17581":96544,"_5":17476,"_23883":96374,"_2389":41417},[],{"_2862":58068,"_25248":57999,"_17581":96546,"_5":17476,"_23883":96374,"_2389":41350},[],{"_2862":58069,"_25248":57999,"_17581":96548,"_5":17476,"_23883":96374,"_2389":96549},[],"Certificado PEM para TLS downstream",{"_2862":58070,"_25248":57999,"_17581":96551,"_5":17476,"_23883":96374,"_2389":41425},[],{"_2862":58071,"_25248":57999,"_17581":96553,"_5":17476,"_23883":96374,"_2389":41350},[],{"_2862":58072,"_25248":57999,"_17581":96555,"_5":17476,"_23883":96374,"_2389":96556},[],"Clave privada PEM para TLS downstream",{"_2862":58073,"_25248":57999,"_17581":96558,"_5":17476,"_23883":96374,"_2389":41433},[],{"_2862":58074,"_25248":57999,"_17581":96560,"_5":17476,"_23883":96374,"_2389":96561},[],"chart del repositorio",{"_2862":58075,"_25248":57999,"_17581":96563,"_5":17476,"_23883":96374,"_2389":96564},[],"Usa un chart local de Lamassu sin empaquetar",{"_2862":58076,"_25248":57999,"_17581":96566,"_5":17476,"_23883":96374,"_2389":41442},[],{"_2862":58077,"_25248":57999,"_17581":96568,"_5":17476,"_23883":96374,"_2389":96569},[],"detección automática",{"_2862":58078,"_25248":57999,"_17581":96571,"_5":17476,"_23883":96374,"_2389":96572},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_2862":58079,"_25248":57999,"_17581":96574,"_5":17476,"_23883":96374,"_2389":41450},[],{"_2862":58080,"_25248":57999,"_17581":96576,"_5":17476,"_23883":96374,"_2389":5365},[],{"_2862":58081,"_25248":57999,"_17581":96578,"_5":17476,"_23883":96374,"_2389":96579},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_2862":58082,"_25248":57999,"_17581":96581,"_5":17476,"_23883":96374,"_2389":41458},[],{"_2862":58083,"_25248":57999,"_17581":96583,"_5":17476,"_23883":96374,"_2389":5365},[],{"_2862":58084,"_25248":57999,"_17581":96585,"_5":17476,"_23883":96374,"_2389":96586},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_2862":58085,"_25248":57999,"_17581":96588,"_5":17476,"_23883":96374,"_2389":41466},[],{"_2862":58086,"_25248":57999,"_17581":96590,"_5":17476,"_23883":96374,"_2389":5365},[],{"_2862":58087,"_25248":57999,"_17581":96592,"_5":17476,"_23883":96374,"_2389":96593},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_2862":58088,"_25248":57999,"_17581":96595,"_5":17476,"_23883":96374,"_2389":41474},[],{"_2862":58089,"_25248":57999,"_17581":96597,"_5":17476,"_23883":96374,"_2389":41477},[],{"_2862":58090,"_25248":57999,"_17581":96599,"_5":17476,"_23883":96374,"_2389":96600},[],"Usa otro chart local de SoftHSM",{"_2862":58091,"_25248":57999,"_17581":96602,"_5":17476,"_23883":96374,"_2389":96603},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_2862":58092,"_25248":57999,"_17581":96605,"_5":17476,"_23883":96378,"_2389":41486},[],{"_2862":58093,"_25248":57999,"_17581":96607,"_5":17476,"_23883":96378,"_2389":96608},[],"valida las herramientas locales y el clúster seleccionado",{"_2862":58094,"_25248":57999,"_17581":96610,"_5":17476,"_23883":96378,"_2389":96611},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_2862":58095,"_25248":57999,"_17581":96613,"_5":17476,"_23883":96378,"_2389":96614},[],"crea el namespace",{"_2862":58096,"_25248":57999,"_17581":96616,"_5":17476,"_23883":96378,"_2389":96617},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_2862":58097,"_25248":57999,"_17581":96619,"_5":17476,"_23883":96378,"_2389":96620},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_2862":58098,"_25248":57999,"_17581":96622,"_5":17476,"_23883":96378,"_2389":96623},[],"instala RabbitMQ",{"_2862":58099,"_25248":57999,"_17581":96625,"_5":17476,"_23883":96378,"_2389":96626},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_2862":58100,"_25248":57999,"_17581":96628,"_5":17476,"_23883":96378,"_2389":96629},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_2862":58101,"_25248":57999,"_17581":96631,"_5":17476,"_23883":96378,"_2389":96632},[],"carga datos de ejemplo opcionalmente",{"_2862":58102,"_25248":57999,"_17581":96634,"_5":17476,"_23883":96378,"_2389":96635},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_2862":58103,"_25248":57999,"_17581":96637,"_5":17476,"_23883":96382,"_2389":96638},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_2862":58104,"_25248":57999,"_17581":96640,"_5":17476,"_23883":96382,"_2389":96641},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_2862":58105,"_25248":57999,"_17581":96643,"_5":17476,"_23883":96386,"_2389":96644},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso.",{"_2862":58106,"_25248":57999,"_17581":96646,"_5":17476,"_23883":96386,"_2389":96647},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_2862":58107,"_25248":57999,"_17581":96649,"_5":17476,"_23883":96386,"_2389":96650},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_2862":58108,"_25248":57999,"_17581":96652,"_5":17476,"_23883":96390,"_2389":96653},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_2862":58109,"_25248":58109,"_5":12326,"_2389":96655,"_25584":96656,"_17581":96657,"_23883":58109},"Instala con Helm",[40961,96113,96347],[],{"_2862":58110,"_25248":58109,"_17581":96659,"_5":17476,"_23883":58109,"_2389":96660},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_2862":58111,"_25248":58109,"_5":25581,"_17581":96662,"_23883":96663,"_2389":96664},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_2862":58112,"_25248":58109,"_5":25581,"_17581":96666,"_23883":96667,"_2389":96363},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/helm#antes-de-comenzar",{"_2862":58113,"_25248":58109,"_5":25581,"_17581":96669,"_23883":96670,"_2389":96671},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_2862":58114,"_25248":58109,"_5":25581,"_17581":96673,"_23883":96674,"_2389":96675},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_2862":58115,"_25248":58109,"_5":25581,"_17581":96677,"_23883":96678,"_2389":96679},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_2862":58116,"_25248":58109,"_5":25581,"_17581":96681,"_23883":96682,"_2389":96683},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_2862":58117,"_25248":58109,"_5":25581,"_17581":96685,"_23883":96686,"_2389":96687},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_2862":58118,"_25248":58109,"_5":25581,"_17581":96689,"_23883":96690,"_2389":96691},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_2862":58119,"_25248":58109,"_5":25581,"_17581":96693,"_23883":96694,"_2389":96695},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_2862":58120,"_25248":58109,"_5":25581,"_17581":96697,"_23883":96698,"_2389":96699},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_2862":58121,"_25248":58109,"_17581":96701,"_5":17476,"_23883":96663,"_2389":96702},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_2862":58122,"_25248":58109,"_17581":96704,"_5":17476,"_23883":96667,"_2389":96705},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_2862":58123,"_25248":58109,"_17581":96707,"_5":17476,"_23883":96667,"_2389":96708},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_2862":58124,"_25248":58109,"_17581":96710,"_5":17476,"_23883":96667,"_2389":96711},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_2862":58125,"_25248":58109,"_17581":96713,"_5":17476,"_23883":96667,"_2389":96714},[],"un broker RabbitMQ accesible y sus credenciales",{"_2862":58126,"_25248":58109,"_17581":96716,"_5":17476,"_23883":96667,"_2389":96717},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_2862":58127,"_25248":58109,"_17581":96719,"_5":17476,"_23883":96667,"_2389":96720},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_2862":58128,"_25248":58109,"_17581":96722,"_5":17476,"_23883":96667,"_2389":96723},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_2862":58129,"_25248":58109,"_17581":96725,"_5":17476,"_23883":96667,"_2389":96726},[],"una StorageClass y un diseño de tráfico externo",{"_2862":58130,"_25248":58109,"_17581":96728,"_5":17476,"_23883":96667,"_2389":96729},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_2862":58131,"_25248":58109,"_17581":96731,"_5":17476,"_23883":96667,"_2389":96732},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_2862":58132,"_25248":58109,"_17581":96734,"_5":17476,"_23883":96667,"_2389":96735},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_2862":58133,"_25248":58109,"_17581":96737,"_5":17476,"_23883":96670,"_2389":96738},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_2862":58134,"_25248":58109,"_17581":96740,"_5":17476,"_23883":96670,"_2389":96741},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_2862":58135,"_25248":58109,"_17581":96743,"_5":17476,"_23883":96670,"_2389":96744},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_2862":58136,"_25248":58109,"_17581":96746,"_5":17476,"_23883":96674,"_2389":96747},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_2862":58137,"_25248":58109,"_17581":96749,"_5":17476,"_23883":96674,"_2389":96750},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_2862":58138,"_25248":58109,"_17581":96752,"_5":17476,"_23883":96674,"_2389":96753},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_2862":58139,"_25248":58109,"_17581":96755,"_5":17476,"_23883":96678,"_2389":96756},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_2862":58140,"_25248":58109,"_17581":96758,"_5":17476,"_23883":96682,"_2389":96759},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_2862":58141,"_25248":58109,"_17581":96761,"_5":17476,"_23883":96682,"_2389":96762},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_2862":58142,"_25248":58109,"_17581":96764,"_5":17476,"_23883":96682,"_2389":96765},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_2862":58143,"_25248":58109,"_17581":96767,"_5":17476,"_23883":96682,"_2389":96768},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_2862":58144,"_25248":58109,"_17581":96770,"_5":17476,"_23883":96686,"_2389":96771},[],"Para instalar un checkout local:",{"_2862":58145,"_25248":58109,"_17581":96773,"_5":17476,"_23883":96690,"_2389":96774},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_2862":58146,"_25248":58109,"_17581":96776,"_5":17476,"_23883":96690,"_2389":96777},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_2862":58147,"_25248":58109,"_17581":96779,"_5":17476,"_23883":96694,"_2389":96780},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_2862":58148,"_25248":58109,"_17581":96782,"_5":17476,"_23883":96694,"_2389":96783},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Se ejecuta antes del resto de hooks de pre-upgrade, la configuración de bootstrap de autorización y el job de migración de base de datos, que usan hook weights `-4` y `-3` frente a su `-10`.",{"_2862":58149,"_25248":58109,"_17581":96785,"_5":17476,"_23883":96694,"_2389":96786},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_2862":58150,"_25248":58109,"_17581":96788,"_5":17476,"_23883":96694,"_2389":96789},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_2862":58151,"_25248":58109,"_17581":96791,"_5":17476,"_23883":96694,"_2389":96792},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_2862":58152,"_25248":58109,"_17581":96794,"_5":17476,"_23883":96698,"_2389":96795},[],"Antes de pasar a producción, revisa:",{"_2862":58153,"_25248":58109,"_17581":96797,"_5":17476,"_23883":96698,"_2389":96798},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_2862":58154,"_25248":58109,"_17581":96800,"_5":17476,"_23883":96698,"_2389":96801},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_2862":58155,"_25248":58109,"_17581":96803,"_5":17476,"_23883":96698,"_2389":96804},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_2862":58156,"_25248":58109,"_17581":96806,"_5":17476,"_23883":96698,"_2389":96807},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_2862":58157,"_25248":58109,"_17581":96809,"_5":17476,"_23883":96698,"_2389":96810},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_2862":58158,"_25248":58109,"_17581":96812,"_5":17476,"_23883":96698,"_2389":96813},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_2862":58159,"_25248":58109,"_17581":96815,"_5":17476,"_23883":96698,"_2389":96816},[],"SMTP, observabilidad y entrega de alertas",{"_2862":58160,"_25248":58109,"_17581":96818,"_5":17476,"_23883":96698,"_2389":96819},[],"las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_2862":58161,"_25248":58109,"_17581":96821,"_5":17476,"_23883":96698,"_2389":96822},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_2862":58162,"_25248":58162,"_5":12326,"_2389":96824,"_25584":96825,"_17581":96826,"_23883":58162},"Expón el Gateway",[40961,96113,96347],[],{"_2862":58163,"_25248":58162,"_17581":96828,"_5":17476,"_23883":58162,"_2389":96829},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_2862":58164,"_25248":58162,"_5":25581,"_17581":96831,"_23883":96832,"_2389":96833},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_2862":58165,"_25248":58162,"_5":25581,"_17581":96835,"_23883":96836,"_2389":96837},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_2862":58166,"_25248":58162,"_5":25581,"_17581":96839,"_23883":96840,"_2389":96841},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_2862":58167,"_25248":58162,"_5":25581,"_17581":96843,"_23883":96844,"_2389":41726},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/networking#k3s",{"_2862":58168,"_25248":58162,"_5":25581,"_17581":96846,"_23883":96847,"_2389":96848},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_2862":58169,"_25248":58162,"_5":25581,"_17581":96850,"_23883":96851,"_2389":96852},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_2862":58170,"_25248":58162,"_5":25581,"_17581":96854,"_23883":96855,"_2389":96856},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_2862":58171,"_25248":58162,"_5":25581,"_17581":96858,"_23883":96859,"_2389":96860},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_2862":58172,"_25248":58162,"_5":25581,"_17581":96862,"_23883":96863,"_2389":96864},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_2862":58173,"_25248":58162,"_17581":96866,"_5":17476,"_23883":96832,"_2389":96867},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_2862":58174,"_25248":58162,"_17581":96869,"_5":17476,"_23883":96832,"_2389":96870},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_2862":58175,"_25248":58162,"_17581":96872,"_5":17476,"_23883":96836,"_2389":96873},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_2862":58176,"_25248":58162,"_17581":96875,"_5":17476,"_23883":96836,"_2389":96876},[],"Defínelo únicamente cuando:",{"_2862":58177,"_25248":58162,"_17581":96878,"_5":17476,"_23883":96836,"_2389":96879},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_2862":58178,"_25248":58162,"_17581":96881,"_5":17476,"_23883":96836,"_2389":96882},[],"esa dirección está asignada a este Gateway",{"_2862":58179,"_25248":58162,"_17581":96884,"_5":17476,"_23883":96836,"_2389":96885},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_2862":58180,"_25248":58162,"_17581":96887,"_5":17476,"_23883":96836,"_2389":96888},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_2862":58181,"_25248":58162,"_17581":96890,"_5":17476,"_23883":96836,"_2389":96891},[],"No confundas estos valores:",{"_2862":58182,"_25248":58162,"_17581":96893,"_5":17476,"_23883":96836,"_2389":96894},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_2862":58183,"_25248":58162,"_17581":96896,"_5":17476,"_23883":96836,"_2389":96897},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_2862":58184,"_25248":58162,"_17581":96899,"_5":17476,"_23883":96836,"_2389":96900},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_2862":58185,"_25248":58162,"_17581":96902,"_5":17476,"_23883":96840,"_2389":96903},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_2862":58186,"_25248":58162,"_17581":96905,"_5":17476,"_23883":96840,"_2389":96906},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_2862":58187,"_25248":58162,"_17581":96908,"_5":17476,"_23883":96844,"_2389":96909},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_2862":58188,"_25248":58162,"_17581":96911,"_5":17476,"_23883":96844,"_2389":96912},[],"Para el diseño recomendado:",{"_2862":58189,"_25248":58162,"_17581":96914,"_5":17476,"_23883":96844,"_2389":96915},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_2862":58190,"_25248":58162,"_17581":96917,"_5":17476,"_23883":96844,"_2389":96918},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_2862":58191,"_25248":58162,"_17581":96920,"_5":17476,"_23883":96844,"_2389":96921},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_2862":58192,"_25248":58162,"_17581":96923,"_5":17476,"_23883":96844,"_2389":96924},[],"Apunta DNS a la dirección accesible de la VM.",{"_2862":58193,"_25248":58162,"_17581":96926,"_5":17476,"_23883":96844,"_2389":96927},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_2862":58194,"_25248":58162,"_17581":96929,"_5":17476,"_23883":96847,"_2389":96930},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_2862":58195,"_25248":58162,"_17581":96932,"_5":17476,"_23883":96851,"_2389":96933},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_2862":58196,"_25248":58162,"_17581":96935,"_5":17476,"_23883":96851,"_2389":96936},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_2862":58197,"_25248":58162,"_17581":96938,"_5":17476,"_23883":96855,"_2389":96939},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_2862":58198,"_25248":58162,"_17581":96941,"_5":17476,"_23883":96855,"_2389":96942},[],"Requisito",{"_2862":58199,"_25248":58162,"_17581":96944,"_5":17476,"_23883":96855,"_2389":96945},[],"Diseño recomendado",{"_2862":58200,"_25248":58162,"_17581":96947,"_5":17476,"_23883":96855,"_2389":96948},[],"Consecuencia",{"_2862":58201,"_25248":58162,"_17581":96950,"_5":17476,"_23883":96855,"_2389":96951},[],"Varias URL o servicios de Lamassu",{"_2862":58202,"_25248":58162,"_17581":96953,"_5":17476,"_23883":96855,"_2389":96954},[],"Un Gateway con varias rutas",{"_2862":58203,"_25248":58162,"_17581":96956,"_5":17476,"_23883":96855,"_2389":96957},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_2862":58204,"_25248":58162,"_17581":96959,"_5":17476,"_23883":96855,"_2389":96960},[],"Gateways independientes e IP externas distintas",{"_2862":58205,"_25248":58162,"_17581":96962,"_5":17476,"_23883":96855,"_2389":96963},[],"Una VIP por Gateway",{"_2862":58206,"_25248":58162,"_17581":96965,"_5":17476,"_23883":96855,"_2389":96966},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_2862":58207,"_25248":58162,"_17581":96968,"_5":17476,"_23883":96855,"_2389":96969},[],"Gateways independientes, un nodo y una IP",{"_2862":58208,"_25248":58162,"_17581":96971,"_5":17476,"_23883":96855,"_2389":96972},[],"Puertos externos diferentes",{"_2862":58209,"_25248":58162,"_17581":96974,"_5":17476,"_23883":96855,"_2389":96975},[],"Los clientes deben indicar puertos no estándar",{"_2862":58210,"_25248":58162,"_17581":96977,"_5":17476,"_23883":96855,"_2389":96978},[],"Terminación TLS/mTLS separada detrás de una IP",{"_2862":58211,"_25248":58162,"_17581":96980,"_5":17476,"_23883":96855,"_2389":96981},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_2862":58212,"_25248":58162,"_17581":96983,"_5":17476,"_23883":96855,"_2389":96984},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_2862":58213,"_25248":58162,"_17581":96986,"_5":17476,"_23883":96855,"_2389":96987},[],"Recursos Gateway separados pero proxy compartido",{"_2862":58214,"_25248":58162,"_17581":96989,"_5":17476,"_23883":96855,"_2389":96990},[],"Modo merged Gateway de Envoy",{"_2862":58215,"_25248":58162,"_17581":96992,"_5":17476,"_23883":96855,"_2389":96993},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_2862":58216,"_25248":58162,"_17581":96995,"_5":17476,"_23883":96855,"_2389":96996},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_2862":58217,"_25248":58162,"_17581":96998,"_5":17476,"_23883":96855,"_2389":96999},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_2862":58218,"_25248":58162,"_17581":97001,"_5":17476,"_23883":96855,"_2389":97002},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_2862":58219,"_25248":58162,"_17581":97004,"_5":17476,"_23883":96855,"_2389":97005},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_2862":58220,"_25248":58162,"_17581":97007,"_5":17476,"_23883":96859,"_2389":97008},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_2862":58221,"_25248":58162,"_17581":97010,"_5":17476,"_23883":96859,"_2389":97011},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_2862":58222,"_25248":58162,"_17581":97013,"_5":17476,"_23883":96859,"_2389":97014},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_2862":58223,"_25248":58162,"_17581":97016,"_5":17476,"_23883":96859,"_2389":97017},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_2862":58224,"_25248":58162,"_17581":97019,"_5":17476,"_23883":96859,"_2389":97020},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_2862":58225,"_25248":58162,"_17581":97022,"_5":17476,"_23883":96863,"_2389":97023},[],"Comprueba, en orden:",{"_2862":58226,"_25248":58162,"_17581":97025,"_5":17476,"_23883":96863,"_2389":97026},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_2862":58227,"_25248":58162,"_17581":97028,"_5":17476,"_23883":96863,"_2389":97029},[],"Su estado contiene la dirección esperada.",{"_2862":58228,"_25248":58162,"_17581":97031,"_5":17476,"_23883":96863,"_2389":97032},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_2862":58229,"_25248":58162,"_17581":97034,"_5":17476,"_23883":96863,"_2389":97035},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_2862":58230,"_25248":58162,"_17581":97037,"_5":17476,"_23883":96863,"_2389":97038},[],"DNS resuelve al endpoint accesible externamente.",{"_2862":58231,"_25248":58162,"_17581":97040,"_5":17476,"_23883":96863,"_2389":97041},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_2862":58232,"_25248":58162,"_17581":97043,"_5":17476,"_23883":96863,"_2389":97044},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_2862":58233,"_25248":58233,"_5":12326,"_2389":41068,"_25584":97046,"_17581":97047,"_23883":58233},[40961,96113,96347],[],{"_2862":58234,"_25248":58233,"_17581":97049,"_5":17476,"_23883":58233,"_2389":97050},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_2862":58235,"_25248":58233,"_5":25581,"_17581":97052,"_23883":97053,"_2389":97054},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_2862":58236,"_25248":58233,"_5":25581,"_17581":97056,"_23883":97057,"_2389":97058},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_2862":58237,"_25248":58233,"_5":25581,"_17581":97060,"_23883":97061,"_2389":97062},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_2862":58238,"_25248":58233,"_5":25581,"_17581":97064,"_23883":97065,"_2389":97066},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_2862":58239,"_25248":58233,"_5":25581,"_17581":97068,"_23883":97069,"_2389":97070},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_2862":58240,"_25248":58233,"_5":25581,"_17581":97072,"_23883":97073,"_2389":97074},[],"/docs/pr-preview/pr-45/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_2862":58241,"_25248":58233,"_17581":97076,"_5":17476,"_23883":97053,"_2389":97077},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_2862":58242,"_25248":58233,"_17581":97079,"_5":17476,"_23883":97057,"_2389":97080},[],"Flujo",{"_2862":58243,"_25248":58233,"_17581":97082,"_5":17476,"_23883":97057,"_2389":97083},[],"Úsalo para",{"_2862":58244,"_25248":58233,"_17581":97085,"_5":17476,"_23883":97057,"_2389":97086},[],"Qué instala",{"_2862":58245,"_25248":58233,"_17581":97088,"_5":17476,"_23883":97057,"_2389":41971},[],{"_2862":58246,"_25248":58233,"_17581":97090,"_5":17476,"_23883":97057,"_2389":97091},[],"Producción y entornos controlados",{"_2862":58247,"_25248":58233,"_17581":97093,"_5":17476,"_23883":97057,"_2389":97094},[],"Servicios de Lamassu y recursos de Gateway API",{"_2862":58248,"_25248":58233,"_17581":97096,"_5":17476,"_23883":97057,"_2389":41205},[],{"_2862":58249,"_25248":58233,"_17581":97098,"_5":17476,"_23883":97057,"_2389":97099},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_2862":58250,"_25248":58233,"_17581":97101,"_5":17476,"_23883":97057,"_2389":97102},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_2862":58251,"_25248":58233,"_17581":97104,"_5":17476,"_23883":97061,"_2389":97105},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_2862":58252,"_25248":58233,"_17581":97107,"_5":17476,"_23883":97061,"_2389":97108},[],"Área",{"_2862":58253,"_25248":58233,"_17581":97110,"_5":17476,"_23883":97061,"_2389":97111},[],"El chart de Lamassu proporciona",{"_2862":58254,"_25248":58233,"_17581":97113,"_5":17476,"_23883":97061,"_2389":97114},[],"Tú proporcionas",{"_2862":58255,"_25248":58233,"_17581":97116,"_5":17476,"_23883":97061,"_2389":97117},[],"Aplicaciones Lamassu",{"_2862":58256,"_25248":58233,"_17581":97119,"_5":17476,"_23883":97061,"_2389":97120},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_2862":58257,"_25248":58233,"_17581":97122,"_5":17476,"_23883":97061,"_2389":97123},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_2862":58258,"_25248":58233,"_17581":97125,"_5":17476,"_23883":97061,"_2389":97126},[],"Datos PostgreSQL",{"_2862":58259,"_25248":58233,"_17581":97128,"_5":17476,"_23883":97061,"_2389":97129},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_2862":58260,"_25248":58233,"_17581":97131,"_5":17476,"_23883":97061,"_2389":97132},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_2862":58261,"_25248":58233,"_17581":97134,"_5":17476,"_23883":97061,"_2389":97135},[],"Mensajería",{"_2862":58262,"_25248":58233,"_17581":97137,"_5":17476,"_23883":97061,"_2389":97138},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_2862":58263,"_25248":58233,"_17581":97140,"_5":17476,"_23883":97061,"_2389":97141},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_2862":58264,"_25248":58233,"_17581":97143,"_5":17476,"_23883":97061,"_2389":97144},[],"Identidad",{"_2862":58265,"_25248":58233,"_17581":97146,"_5":17476,"_23883":97061,"_2389":97147},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_2862":58266,"_25248":58233,"_17581":97149,"_5":17476,"_23883":97061,"_2389":97150},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_2862":58267,"_25248":58233,"_17581":97152,"_5":17476,"_23883":97061,"_2389":97153},[],"Enrutamiento externo",{"_2862":58268,"_25248":58233,"_17581":97155,"_5":17476,"_23883":97061,"_2389":97156},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_2862":58269,"_25248":58233,"_17581":97158,"_5":17476,"_23883":97061,"_2389":97159},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_2862":58270,"_25248":58233,"_17581":97161,"_5":17476,"_23883":97061,"_2389":42045},[],{"_2862":58271,"_25248":58233,"_17581":97163,"_5":17476,"_23883":97061,"_2389":97164},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_2862":58272,"_25248":58233,"_17581":97166,"_5":17476,"_23883":97061,"_2389":97167},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_2862":58273,"_25248":58233,"_17581":97169,"_5":17476,"_23883":97061,"_2389":97170},[],"Datos persistentes de la aplicación",{"_2862":58274,"_25248":58233,"_17581":97172,"_5":17476,"_23883":97061,"_2389":97173},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_2862":58275,"_25248":58233,"_17581":97175,"_5":17476,"_23883":97061,"_2389":97176},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_2862":58276,"_25248":58233,"_17581":97178,"_5":17476,"_23883":97061,"_2389":97179},[],"Integraciones opcionales",{"_2862":58277,"_25248":58233,"_17581":97181,"_5":17476,"_23883":97061,"_2389":97182},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_2862":58278,"_25248":58233,"_17581":97184,"_5":17476,"_23883":97061,"_2389":97185},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_2862":58279,"_25248":58233,"_17581":97187,"_5":17476,"_23883":97061,"_2389":97188},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_2862":58280,"_25248":58233,"_17581":97190,"_5":17476,"_23883":97061,"_2389":97191},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_2862":58281,"_25248":58233,"_17581":97193,"_5":17476,"_23883":97065,"_2389":97194},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_2862":58282,"_25248":58233,"_17581":97196,"_5":17476,"_23883":97065,"_2389":97197},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_2862":58283,"_25248":58233,"_17581":97199,"_5":17476,"_23883":97069,"_2389":97200},[],"Kubernetes 1.24 o posterior",{"_2862":58284,"_25248":58233,"_17581":97202,"_5":17476,"_23883":97069,"_2389":97203},[],"Helm 3.2 o posterior",{"_2862":58285,"_25248":58233,"_17581":97205,"_5":17476,"_23883":97069,"_2389":97206},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_2862":58286,"_25248":58233,"_17581":97208,"_5":17476,"_23883":97069,"_2389":97209},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_2862":58287,"_25248":58233,"_17581":97211,"_5":17476,"_23883":97069,"_2389":97212},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_2862":58288,"_25248":58233,"_17581":97214,"_5":17476,"_23883":97069,"_2389":97215},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_2862":58289,"_25248":58233,"_17581":97217,"_5":17476,"_23883":97069,"_2389":97218},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior.",{"_2862":58290,"_25248":58233,"_17581":97220,"_5":17476,"_23883":97073,"_2389":97221},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2862":58291,"_25248":58233,"_17581":97223,"_5":17476,"_23883":97073,"_2389":97224},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2862":58292,"_25248":58233,"_17581":97226,"_5":17476,"_23883":97073,"_2389":97227},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2862":58293,"_25248":58293,"_5":12326,"_2389":97229,"_25584":97230,"_17581":97232,"_23883":58293},"Resolución de problemas de despliegue",[40961,96113,97231],"Operación",[],{"_2862":58294,"_25248":58293,"_17581":97234,"_5":17476,"_23883":58293,"_2389":97235},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_2862":58295,"_25248":58293,"_5":25581,"_17581":97237,"_23883":97238,"_2389":97239},[],"/docs/pr-preview/pr-45/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_2862":58296,"_25248":58293,"_5":25581,"_17581":97241,"_23883":97242,"_2389":97243},[],"/docs/pr-preview/pr-45/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_2862":58297,"_25248":58293,"_5":25581,"_17581":97245,"_23883":97246,"_2389":97247},[],"/docs/pr-preview/pr-45/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_2862":58298,"_25248":58293,"_5":25581,"_17581":97249,"_23883":97250,"_2389":97251},[],"/docs/pr-preview/pr-45/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_2862":58299,"_25248":58293,"_5":25581,"_17581":97253,"_23883":97254,"_2389":97255},[],"/docs/pr-preview/pr-45/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_2862":58300,"_25248":58293,"_5":25581,"_17581":97257,"_23883":97258,"_2389":97259},[],"/docs/pr-preview/pr-45/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_2862":58301,"_25248":58293,"_5":25581,"_17581":97261,"_23883":97262,"_2389":97263},[],"/docs/pr-preview/pr-45/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_2862":58302,"_25248":58293,"_5":25581,"_17581":97265,"_23883":97266,"_2389":97267},[],"/docs/pr-preview/pr-45/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_2862":58303,"_25248":58293,"_5":25581,"_17581":97269,"_23883":97270,"_2389":97271},[],"/docs/pr-preview/pr-45/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_2862":58304,"_25248":58293,"_5":25581,"_17581":97273,"_23883":97274,"_2389":97275},[],"/docs/pr-preview/pr-45/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_2862":58305,"_25248":58293,"_5":25581,"_17581":97277,"_23883":97278,"_2389":97279},[],"/docs/pr-preview/pr-45/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_2862":58306,"_25248":58293,"_5":25581,"_17581":97281,"_23883":97282,"_2389":97283},[],"/docs/pr-preview/pr-45/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_2862":58307,"_25248":58293,"_17581":97285,"_5":17476,"_23883":58293,"_2389":97286},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_2862":58308,"_25248":58293,"_17581":97288,"_5":17476,"_23883":97242,"_2389":97289},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_2862":58309,"_25248":58293,"_17581":97291,"_5":17476,"_23883":97246,"_2389":97292},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_2862":58310,"_25248":58293,"_17581":97294,"_5":17476,"_23883":97250,"_2389":97295},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_2862":58311,"_25248":58293,"_17581":97297,"_5":17476,"_23883":97254,"_2389":97298},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_2862":58312,"_25248":58293,"_17581":97300,"_5":17476,"_23883":97258,"_2389":97301},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_2862":58313,"_25248":58293,"_17581":97303,"_5":17476,"_23883":97262,"_2389":97304},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_2862":58314,"_25248":58293,"_17581":97306,"_5":17476,"_23883":97262,"_2389":97307},[],"Ejecuta también la prueba de conectividad del chart:",{"_2862":58315,"_25248":58293,"_17581":97309,"_5":17476,"_23883":97262,"_2389":97310},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_2862":58316,"_25248":58293,"_17581":97312,"_5":17476,"_23883":97262,"_2389":97313},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_2862":58317,"_25248":58293,"_17581":97315,"_5":17476,"_23883":97266,"_2389":97316},[],"Si recibes un 401:",{"_2862":58318,"_25248":58293,"_17581":97318,"_5":17476,"_23883":97266,"_2389":97319},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_2862":58319,"_25248":58293,"_17581":97321,"_5":17476,"_23883":97266,"_2389":97322},[],"verifica emisor, audiencia y expiración del token;",{"_2862":58320,"_25248":58293,"_17581":97324,"_5":17476,"_23883":97266,"_2389":97325},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_2862":58321,"_25248":58293,"_17581":97327,"_5":17476,"_23883":97266,"_2389":97328},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_2862":58322,"_25248":58293,"_17581":97330,"_5":17476,"_23883":97266,"_2389":97331},[],"Si el login termina pero las APIs devuelven 403:",{"_2862":58323,"_25248":58293,"_17581":97333,"_5":17476,"_23883":97266,"_2389":97334},[],"inspecciona los claims reales del token;",{"_2862":58324,"_25248":58293,"_17581":97336,"_5":17476,"_23883":97266,"_2389":97337},[],"confirma que coinciden con un principal activo;",{"_2862":58325,"_25248":58293,"_17581":97339,"_5":17476,"_23883":97266,"_2389":97340},[],"revisa las políticas concedidas al principal;",{"_2862":58326,"_25248":58293,"_17581":97342,"_5":17476,"_23883":97266,"_2389":97343},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_2862":58327,"_25248":58293,"_17581":97345,"_5":17476,"_23883":97266,"_2389":97346},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_2862":58328,"_25248":58293,"_17581":97348,"_5":17476,"_23883":97270,"_2389":97349},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_2862":58329,"_25248":58293,"_17581":97351,"_5":17476,"_23883":97270,"_2389":97352},[],"Localiza el pod y Service de authz.",{"_2862":58330,"_25248":58293,"_17581":97354,"_5":17476,"_23883":97270,"_2389":97355},[],"Comprueba /health, logs y conexión a su base de datos.",{"_2862":58331,"_25248":58293,"_17581":97357,"_5":17476,"_23883":97270,"_2389":97358},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_2862":58332,"_25248":58293,"_17581":97360,"_5":17476,"_23883":97270,"_2389":97361},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_2862":58333,"_25248":58293,"_17581":97363,"_5":17476,"_23883":97270,"_2389":97364},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_2862":58334,"_25248":58293,"_17581":97366,"_5":17476,"_23883":97274,"_2389":97367},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_2862":58335,"_25248":58293,"_17581":97369,"_5":17476,"_23883":97274,"_2389":97370},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_2862":58336,"_25248":58293,"_17581":97372,"_5":17476,"_23883":97274,"_2389":97373},[],"volumen persistente sin enlazar;",{"_2862":58337,"_25248":58293,"_17581":97375,"_5":17476,"_23883":97274,"_2389":97376},[],"imagen inaccesible o política de pull incorrecta;",{"_2862":58338,"_25248":58293,"_17581":97378,"_5":17476,"_23883":97274,"_2389":97379},[],"configuración inválida del motor criptográfico;",{"_2862":58339,"_25248":58293,"_17581":97381,"_5":17476,"_23883":97274,"_2389":97382},[],"límites de CPU o memoria demasiado bajos;",{"_2862":58340,"_25248":58293,"_17581":97384,"_5":17476,"_23883":97274,"_2389":97385},[],"migración previa incompleta.",{"_2862":58341,"_25248":58293,"_17581":97387,"_5":17476,"_23883":97274,"_2389":97388},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_2862":58342,"_25248":58293,"_17581":97390,"_5":17476,"_23883":97274,"_2389":97391},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_2862":58343,"_25248":58293,"_17581":97393,"_5":17476,"_23883":97278,"_2389":97394},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_2862":58344,"_25248":58293,"_17581":97396,"_5":17476,"_23883":97278,"_2389":97397},[],"verifica que esté habilitado en el servicio emisor;",{"_2862":58345,"_25248":58293,"_17581":97399,"_5":17476,"_23883":97278,"_2389":97400},[],"comprueba conectividad y credenciales AMQP;",{"_2862":58346,"_25248":58293,"_17581":97402,"_5":17476,"_23883":97278,"_2389":97403},[],"revisa exchange, routing key, colas y consumidores;",{"_2862":58347,"_25248":58293,"_17581":97405,"_5":17476,"_23883":97278,"_2389":97406},[],"inspecciona dead-letter queues;",{"_2862":58348,"_25248":58293,"_17581":97408,"_5":17476,"_23883":97278,"_2389":97409},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_2862":58349,"_25248":58293,"_17581":97411,"_5":17476,"_23883":97278,"_2389":97412},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_2862":58350,"_25248":58293,"_17581":97414,"_5":17476,"_23883":97282,"_2389":97415},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_2862":58351,"_25248":58293,"_17581":97417,"_5":17476,"_23883":97282,"_2389":97418},[],"Antes de cerrar una incidencia, guarda:",{"_2862":58352,"_25248":58293,"_17581":97420,"_5":17476,"_23883":97282,"_2389":97421},[],"causa confirmada;",{"_2862":58353,"_25248":58293,"_17581":97423,"_5":17476,"_23883":97282,"_2389":97424},[],"alcance temporal y recursos afectados;",{"_2862":58354,"_25248":58293,"_17581":97426,"_5":17476,"_23883":97282,"_2389":97427},[],"comandos o consultas utilizados;",{"_2862":58355,"_25248":58293,"_17581":97429,"_5":17476,"_23883":97282,"_2389":97430},[],"cambio aplicado y forma de revertirlo;",{"_2862":58356,"_25248":58293,"_17581":97432,"_5":17476,"_23883":97282,"_2389":97433},[],"validación desde un consumidor;",{"_2862":58357,"_25248":58293,"_17581":97435,"_5":17476,"_23883":97282,"_2389":97436},[],"acción preventiva y propietario.",{"_2862":58358,"_25248":58358,"_5":12326,"_2389":97438,"_25584":97439,"_17581":97442,"_23883":58358},"Control de acceso",[40961,97440,97441],"Plataforma","Administración",[],{"_2862":58359,"_25248":58358,"_17581":97444,"_5":17476,"_23883":58358,"_2389":97445},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_2862":58360,"_25248":58358,"_5":25581,"_17581":97447,"_23883":97448,"_2389":97449},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_2862":58361,"_25248":58358,"_5":25581,"_17581":97451,"_23883":97452,"_2389":97453},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_2862":58362,"_25248":58358,"_5":25581,"_17581":97455,"_23883":97456,"_2389":97457},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_2862":58363,"_25248":58358,"_5":25581,"_17581":97459,"_23883":97460,"_2389":97461},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_2862":58364,"_25248":58358,"_5":25581,"_17581":97463,"_23883":97464,"_2389":97465},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_2862":58365,"_25248":58358,"_5":25581,"_17581":97467,"_23883":97468,"_2389":97469},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_2862":58366,"_25248":58358,"_5":25581,"_17581":97471,"_23883":97472,"_2389":97473},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_2862":58367,"_25248":58358,"_5":25581,"_17581":97475,"_23883":97476,"_2389":97477},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#principales-x509","Principales X.509",{"_2862":58368,"_25248":58358,"_5":25581,"_17581":97479,"_23883":97480,"_2389":97481},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_2862":58369,"_25248":58358,"_5":25581,"_17581":97483,"_23883":97484,"_2389":97485},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_2862":58370,"_25248":58358,"_5":25581,"_17581":97487,"_23883":97488,"_2389":97489},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_2862":58371,"_25248":58358,"_5":25581,"_17581":97491,"_23883":97492,"_2389":97493},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_2862":58372,"_25248":58358,"_5":25581,"_17581":97495,"_23883":97496,"_2389":97497},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_2862":58373,"_25248":58358,"_5":25581,"_17581":97499,"_23883":97500,"_2389":97501},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_2862":58374,"_25248":58358,"_5":25581,"_17581":97503,"_23883":97504,"_2389":97505},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_2862":58375,"_25248":58358,"_5":25581,"_17581":97507,"_23883":97508,"_2389":96683},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_2862":58376,"_25248":58358,"_5":25581,"_17581":97510,"_23883":97511,"_2389":97512},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_2862":58377,"_25248":58358,"_5":25581,"_17581":97514,"_23883":97515,"_2389":97516},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#configura-las-dos-validaciones-jwt","Configura las dos validaciones JWT",{"_2862":58378,"_25248":58358,"_5":25581,"_17581":97518,"_23883":97519,"_2389":97520},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_2862":58379,"_25248":58358,"_5":25581,"_17581":97522,"_23883":97523,"_2389":97524},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_2862":58380,"_25248":58358,"_5":25581,"_17581":97526,"_23883":97527,"_2389":97528},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_2862":58381,"_25248":58358,"_5":25581,"_17581":97530,"_23883":97531,"_2389":97532},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_2862":58382,"_25248":58358,"_5":25581,"_17581":97534,"_23883":97535,"_2389":97536},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_2862":58383,"_25248":58358,"_5":25581,"_17581":97538,"_23883":97539,"_2389":97540},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_2862":58384,"_25248":58358,"_5":25581,"_17581":97542,"_23883":97543,"_2389":97544},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_2862":58385,"_25248":58358,"_5":25581,"_17581":97546,"_23883":97547,"_2389":97548},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_2862":58386,"_25248":58358,"_5":25581,"_17581":97550,"_23883":97551,"_2389":97552},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_2862":58387,"_25248":58358,"_5":25581,"_17581":97554,"_23883":97555,"_2389":97556},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_2862":58388,"_25248":58358,"_5":25581,"_17581":97558,"_23883":97559,"_2389":97560},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_2862":58389,"_25248":58358,"_5":25581,"_17581":97562,"_23883":97563,"_2389":97564},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_2862":58390,"_25248":58358,"_5":25581,"_17581":97566,"_23883":97567,"_2389":97568},[],"/docs/pr-preview/pr-45/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_2862":58391,"_25248":58358,"_17581":97570,"_5":17476,"_23883":58358,"_2389":97571},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_2862":58392,"_25248":58358,"_17581":97573,"_5":17476,"_23883":58358,"_2389":97574},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_2862":58393,"_25248":58358,"_17581":97576,"_5":17476,"_23883":58358,"_2389":97577},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_2862":58394,"_25248":58358,"_17581":97579,"_5":17476,"_23883":97448,"_2389":97580},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_2862":58395,"_25248":58358,"_17581":97582,"_5":17476,"_23883":97448,"_2389":97583},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_2862":58396,"_25248":58358,"_17581":97585,"_5":17476,"_23883":97448,"_2389":97586},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_2862":58397,"_25248":58358,"_17581":97588,"_5":17476,"_23883":97448,"_2389":97589},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_2862":58398,"_25248":58358,"_17581":97591,"_5":17476,"_23883":97448,"_2389":97592},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_2862":58399,"_25248":58358,"_17581":97594,"_5":17476,"_23883":97448,"_2389":97595},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_2862":58400,"_25248":58358,"_17581":97597,"_5":17476,"_23883":97452,"_2389":97598},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_2862":58401,"_25248":58358,"_17581":97600,"_5":17476,"_23883":97452,"_2389":97601},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_2862":58402,"_25248":58358,"_17581":97603,"_5":17476,"_23883":97456,"_2389":97604},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_2862":58403,"_25248":58358,"_17581":97606,"_5":17476,"_23883":97456,"_2389":97607},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_2862":58404,"_25248":58358,"_17581":97609,"_5":17476,"_23883":97456,"_2389":97610},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_2862":58405,"_25248":58358,"_17581":97612,"_5":17476,"_23883":97456,"_2389":97613},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_2862":58406,"_25248":58358,"_17581":97615,"_5":17476,"_23883":97456,"_2389":97616},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_2862":58407,"_25248":58358,"_17581":97618,"_5":17476,"_23883":97456,"_2389":97619},[],"Carga por separado las políticas concedidas a cada principal.",{"_2862":58408,"_25248":58358,"_17581":97621,"_5":17476,"_23883":97456,"_2389":97622},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_2862":58409,"_25248":58358,"_17581":97624,"_5":17476,"_23883":97456,"_2389":97625},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_2862":58410,"_25248":58358,"_17581":97627,"_5":17476,"_23883":97456,"_2389":97628},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_2862":58411,"_25248":58358,"_17581":97630,"_5":17476,"_23883":97456,"_2389":97631},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_2862":58412,"_25248":58358,"_17581":97633,"_5":17476,"_23883":97456,"_2389":97634},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_2862":58413,"_25248":58358,"_17581":97636,"_5":17476,"_23883":97456,"_2389":97637},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_2862":58414,"_25248":58358,"_17581":97639,"_5":17476,"_23883":97460,"_2389":97640},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_2862":58415,"_25248":58358,"_17581":97642,"_5":17476,"_23883":97460,"_2389":97643},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_2862":58416,"_25248":58358,"_17581":97645,"_5":17476,"_23883":97460,"_2389":97646},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_2862":58417,"_25248":58358,"_17581":97648,"_5":17476,"_23883":97460,"_2389":97649},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_2862":58418,"_25248":58358,"_17581":97651,"_5":17476,"_23883":97460,"_2389":97652},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_2862":58419,"_25248":58358,"_17581":97654,"_5":17476,"_23883":97460,"_2389":97655},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_2862":58420,"_25248":58358,"_17581":97657,"_5":17476,"_23883":97460,"_2389":97658},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_2862":58421,"_25248":58358,"_17581":97660,"_5":17476,"_23883":97460,"_2389":97661},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_2862":58422,"_25248":58358,"_17581":97663,"_5":17476,"_23883":97464,"_2389":97664},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_2862":58423,"_25248":58358,"_17581":97666,"_5":17476,"_23883":97464,"_2389":97667},[],"La decisión se toma con el contexto de la operación de dominio:",{"_2862":58424,"_25248":58358,"_17581":97669,"_5":17476,"_23883":97464,"_2389":97670},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_2862":58425,"_25248":58358,"_17581":97672,"_5":17476,"_23883":97464,"_2389":97673},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_2862":58426,"_25248":58358,"_17581":97675,"_5":17476,"_23883":97464,"_2389":97676},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_2862":58427,"_25248":58358,"_17581":97678,"_5":17476,"_23883":97464,"_2389":97679},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_2862":58428,"_25248":58358,"_17581":97681,"_5":17476,"_23883":97464,"_2389":97682},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_2862":58429,"_25248":58358,"_17581":97684,"_5":17476,"_23883":97464,"_2389":97685},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_2862":58430,"_25248":58358,"_17581":97687,"_5":17476,"_23883":97464,"_2389":97688},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_2862":58431,"_25248":58358,"_17581":97690,"_5":17476,"_23883":97464,"_2389":97691},[],"Las acciones se dividen en dos grupos:",{"_2862":58432,"_25248":58358,"_17581":97693,"_5":17476,"_23883":97464,"_2389":97694},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_2862":58433,"_25248":58358,"_17581":97696,"_5":17476,"_23883":97464,"_2389":97697},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_2862":58434,"_25248":58358,"_17581":97699,"_5":17476,"_23883":97464,"_2389":97700},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_2862":58435,"_25248":58358,"_17581":97702,"_5":17476,"_23883":97468,"_2389":97703},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_2862":58436,"_25248":58358,"_17581":97705,"_5":17476,"_23883":97468,"_2389":97706},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_2862":58437,"_25248":58358,"_17581":97708,"_5":17476,"_23883":97468,"_2389":97709},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_2862":58438,"_25248":58358,"_17581":97711,"_5":17476,"_23883":97472,"_2389":97712},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_2862":58439,"_25248":58358,"_17581":97714,"_5":17476,"_23883":97472,"_2389":97715},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_2862":58440,"_25248":58358,"_17581":97717,"_5":17476,"_23883":97472,"_2389":97718},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_2862":58441,"_25248":58358,"_17581":97720,"_5":17476,"_23883":97472,"_2389":97721},[],"Los operadores implementados son:",{"_2862":58442,"_25248":58358,"_17581":97723,"_5":17476,"_23883":97472,"_2389":97724},[],"`equals`, para igualdad exacta;",{"_2862":58443,"_25248":58358,"_17581":97726,"_5":17476,"_23883":97472,"_2389":97727},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_2862":58444,"_25248":58358,"_17581":97729,"_5":17476,"_23883":97472,"_2389":97730},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_2862":58445,"_25248":58358,"_17581":97732,"_5":17476,"_23883":97472,"_2389":97733},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_2862":58446,"_25248":58358,"_17581":97735,"_5":17476,"_23883":97476,"_2389":97736},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_2862":58447,"_25248":58358,"_17581":97738,"_5":17476,"_23883":97476,"_2389":97739},[],"Los modos disponibles son:",{"_2862":58448,"_25248":58358,"_17581":97741,"_5":17476,"_23883":97476,"_2389":97742},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_2862":58449,"_25248":58358,"_17581":97744,"_5":17476,"_23883":97476,"_2389":97745},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_2862":58450,"_25248":58358,"_17581":97747,"_5":17476,"_23883":97476,"_2389":97748},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_2862":58451,"_25248":58358,"_17581":97750,"_5":17476,"_23883":97476,"_2389":97751},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_2862":58452,"_25248":58358,"_17581":97753,"_5":17476,"_23883":97476,"_2389":97754},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_2862":58453,"_25248":58358,"_17581":97756,"_5":17476,"_23883":97476,"_2389":97757},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_2862":58454,"_25248":58358,"_17581":97759,"_5":17476,"_23883":97480,"_2389":97760},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_2862":58455,"_25248":58358,"_17581":97762,"_5":17476,"_23883":97480,"_2389":97763},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_2862":58456,"_25248":58358,"_17581":97765,"_5":17476,"_23883":97480,"_2389":97766},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_2862":58457,"_25248":58358,"_17581":97768,"_5":17476,"_23883":97480,"_2389":97769},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_2862":58458,"_25248":58358,"_17581":97771,"_5":17476,"_23883":97488,"_2389":97772},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_2862":58459,"_25248":58358,"_17581":97774,"_5":17476,"_23883":97488,"_2389":97775},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_2862":58460,"_25248":58358,"_17581":97777,"_5":17476,"_23883":97492,"_2389":97778},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_2862":58461,"_25248":58358,"_17581":97780,"_5":17476,"_23883":97492,"_2389":97781},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_2862":58462,"_25248":58358,"_17581":97783,"_5":17476,"_23883":97496,"_2389":97784},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_2862":58463,"_25248":58358,"_17581":97786,"_5":17476,"_23883":97496,"_2389":97787},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_2862":58464,"_25248":58358,"_17581":97789,"_5":17476,"_23883":97496,"_2389":97790},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_2862":58465,"_25248":58358,"_17581":97792,"_5":17476,"_23883":97500,"_2389":97793},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_2862":58466,"_25248":58358,"_17581":97795,"_5":17476,"_23883":97500,"_2389":97796},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_2862":58467,"_25248":58358,"_17581":97798,"_5":17476,"_23883":97500,"_2389":97799},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_2862":58468,"_25248":58358,"_17581":97801,"_5":17476,"_23883":97500,"_2389":97802},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_2862":58469,"_25248":58358,"_17581":97804,"_5":17476,"_23883":97500,"_2389":97805},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_2862":58470,"_25248":58358,"_17581":97807,"_5":17476,"_23883":97500,"_2389":97808},[],"Ten en cuenta que:",{"_2862":58471,"_25248":58358,"_17581":97810,"_5":17476,"_23883":97500,"_2389":97811},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_2862":58472,"_25248":58358,"_17581":97813,"_5":17476,"_23883":97500,"_2389":97814},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_2862":58473,"_25248":58358,"_17581":97816,"_5":17476,"_23883":97500,"_2389":97817},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_2862":58474,"_25248":58358,"_17581":97819,"_5":17476,"_23883":97504,"_2389":97820},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_2862":58475,"_25248":58358,"_17581":97822,"_5":17476,"_23883":97504,"_2389":97823},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_2862":58476,"_25248":58358,"_17581":97825,"_5":17476,"_23883":97504,"_2389":97826},[],"acceso completo y de solo lectura a KMS;",{"_2862":58477,"_25248":58358,"_17581":97828,"_5":17476,"_23883":97504,"_2389":97829},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_2862":58478,"_25248":58358,"_17581":97831,"_5":17476,"_23883":97504,"_2389":97832},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_2862":58479,"_25248":58358,"_17581":97834,"_5":17476,"_23883":97504,"_2389":97835},[],"acceso a la interfaz;",{"_2862":58480,"_25248":58358,"_17581":97837,"_5":17476,"_23883":97504,"_2389":97838},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_2862":58481,"_25248":58358,"_17581":97840,"_5":17476,"_23883":97504,"_2389":97841},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_2862":58482,"_25248":58358,"_17581":97843,"_5":17476,"_23883":97504,"_2389":97844},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_2862":58483,"_25248":58358,"_17581":97846,"_5":17476,"_23883":97508,"_2389":97847},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_2862":58484,"_25248":58358,"_17581":97849,"_5":17476,"_23883":97508,"_2389":97850},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_2862":58485,"_25248":58358,"_17581":97852,"_5":17476,"_23883":97508,"_2389":97853},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_2862":58486,"_25248":58358,"_17581":97855,"_5":17476,"_23883":97511,"_2389":97856},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_2862":58487,"_25248":58358,"_17581":97858,"_5":17476,"_23883":97515,"_2389":97859},[],"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes.",{"_2862":58488,"_25248":58358,"_17581":97861,"_5":17476,"_23883":97519,"_2389":97862},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_2862":58489,"_25248":58358,"_17581":97864,"_5":17476,"_23883":97523,"_2389":97865},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_2862":58490,"_25248":58358,"_17581":97867,"_5":17476,"_23883":97527,"_2389":97868},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_2862":58491,"_25248":58358,"_17581":97870,"_5":17476,"_23883":97531,"_2389":97871},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_2862":58492,"_25248":58358,"_17581":97873,"_5":17476,"_23883":97531,"_2389":97874},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_2862":58493,"_25248":58358,"_17581":97876,"_5":17476,"_23883":97535,"_2389":97877},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_2862":58494,"_25248":58358,"_17581":97879,"_5":17476,"_23883":97535,"_2389":97880},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_2862":58495,"_25248":58358,"_17581":97882,"_5":17476,"_23883":97535,"_2389":97883},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_2862":58496,"_25248":58358,"_17581":97885,"_5":17476,"_23883":97535,"_2389":97886},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_2862":58497,"_25248":58358,"_17581":97888,"_5":17476,"_23883":97535,"_2389":97889},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_2862":58498,"_25248":58358,"_17581":97891,"_5":17476,"_23883":97535,"_2389":97892},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_2862":58499,"_25248":58358,"_17581":97894,"_5":17476,"_23883":97535,"_2389":97895},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_2862":58500,"_25248":58358,"_17581":97897,"_5":17476,"_23883":97535,"_2389":97898},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_2862":58501,"_25248":58358,"_17581":97900,"_5":17476,"_23883":97539,"_2389":97901},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_2862":58502,"_25248":58358,"_17581":97903,"_5":17476,"_23883":97539,"_2389":97904},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_2862":58503,"_25248":58358,"_17581":97906,"_5":17476,"_23883":97539,"_2389":97907},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_2862":58504,"_25248":58358,"_17581":97909,"_5":17476,"_23883":97543,"_2389":97910},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_2862":58505,"_25248":58358,"_17581":97912,"_5":17476,"_23883":97543,"_2389":97913},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_2862":58506,"_25248":58358,"_17581":97915,"_5":17476,"_23883":97543,"_2389":97916},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_2862":58507,"_25248":58358,"_17581":97918,"_5":17476,"_23883":97543,"_2389":97919},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_2862":58508,"_25248":58358,"_17581":97921,"_5":17476,"_23883":97543,"_2389":97922},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_2862":58509,"_25248":58358,"_17581":97924,"_5":17476,"_23883":97543,"_2389":97925},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_2862":58510,"_25248":58358,"_17581":97927,"_5":17476,"_23883":97543,"_2389":97928},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_2862":58511,"_25248":58358,"_17581":97930,"_5":17476,"_23883":97543,"_2389":97931},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_2862":58512,"_25248":58358,"_17581":97933,"_5":17476,"_23883":97551,"_2389":97934},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_2862":58513,"_25248":58358,"_17581":97936,"_5":17476,"_23883":97555,"_2389":97937},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_2862":58514,"_25248":58358,"_17581":97939,"_5":17476,"_23883":97555,"_2389":97940},[],"que exista un principal activo del tipo correcto;",{"_2862":58515,"_25248":58358,"_17581":97942,"_5":17476,"_23883":97555,"_2389":97943},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_2862":58516,"_25248":58358,"_17581":97945,"_5":17476,"_23883":97555,"_2389":97946},[],"que todas las condiciones del principal se cumplan;",{"_2862":58517,"_25248":58358,"_17581":97948,"_5":17476,"_23883":97555,"_2389":97949},[],"que el principal tenga concedida la política esperada;",{"_2862":58518,"_25248":58358,"_17581":97951,"_5":17476,"_23883":97555,"_2389":97952},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_2862":58519,"_25248":58358,"_17581":97954,"_5":17476,"_23883":97555,"_2389":97955},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_2862":58520,"_25248":58358,"_17581":97957,"_5":17476,"_23883":97555,"_2389":97958},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_2862":58521,"_25248":58358,"_17581":97960,"_5":17476,"_23883":97559,"_2389":97961},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_2862":58522,"_25248":58358,"_17581":97963,"_5":17476,"_23883":97563,"_2389":97964},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_2862":58523,"_25248":58358,"_17581":97966,"_5":17476,"_23883":97567,"_2389":97967},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_2862":58524,"_25248":58358,"_17581":97969,"_5":17476,"_23883":97567,"_2389":97970},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_2862":58525,"_25248":58525,"_5":12326,"_2389":97972,"_25584":97973,"_17581":97974,"_23883":58525},"Alertas y suscripciones",[40961,97440,97441],[],{"_2862":58526,"_25248":58525,"_17581":97976,"_5":17476,"_23883":58525,"_2389":97977},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_2862":58527,"_25248":58525,"_5":25581,"_17581":97979,"_23883":97980,"_2389":97981},[],"/docs/pr-preview/pr-45/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_2862":58528,"_25248":58525,"_5":25581,"_17581":97983,"_23883":97984,"_2389":97985},[],"/docs/pr-preview/pr-45/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_2862":58529,"_25248":58525,"_5":25581,"_17581":97987,"_23883":97988,"_2389":97989},[],"/docs/pr-preview/pr-45/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_2862":58530,"_25248":58525,"_5":25581,"_17581":97991,"_23883":97992,"_2389":97993},[],"/docs/pr-preview/pr-45/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_2862":58531,"_25248":58525,"_5":25581,"_17581":97995,"_23883":97996,"_2389":97997},[],"/docs/pr-preview/pr-45/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_2862":58532,"_25248":58525,"_5":25581,"_17581":97999,"_23883":98000,"_2389":98001},[],"/docs/pr-preview/pr-45/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_2862":58533,"_25248":58525,"_5":25581,"_17581":98003,"_23883":98004,"_2389":98005},[],"/docs/pr-preview/pr-45/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_2862":58534,"_25248":58525,"_5":25581,"_17581":98007,"_23883":98008,"_2389":98009},[],"/docs/pr-preview/pr-45/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_2862":58535,"_25248":58525,"_5":25581,"_17581":98011,"_23883":98012,"_2389":98013},[],"/docs/pr-preview/pr-45/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_2862":58536,"_25248":58525,"_5":25581,"_17581":98015,"_23883":98016,"_2389":98017},[],"/docs/pr-preview/pr-45/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_2862":58537,"_25248":58525,"_17581":98019,"_5":17476,"_23883":58525,"_2389":98020},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_2862":58538,"_25248":58525,"_17581":98022,"_5":17476,"_23883":97980,"_2389":98023},[],"Un servicio publica un evento de dominio.",{"_2862":58539,"_25248":58525,"_17581":98025,"_5":17476,"_23883":97980,"_2389":98026},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_2862":58540,"_25248":58525,"_17581":98028,"_5":17476,"_23883":97980,"_2389":98029},[],"El filtro de cada suscripción decide si debe notificarse.",{"_2862":58541,"_25248":58525,"_17581":98031,"_5":17476,"_23883":97980,"_2389":98032},[],"Lamassu entrega el evento al canal configurado.",{"_2862":58542,"_25248":58525,"_17581":98034,"_5":17476,"_23883":97980,"_2389":98035},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_2862":58543,"_25248":58525,"_17581":98037,"_5":17476,"_23883":97984,"_2389":98038},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_2862":58544,"_25248":58525,"_17581":98040,"_5":17476,"_23883":97984,"_2389":98041},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_2862":58545,"_25248":58525,"_17581":98043,"_5":17476,"_23883":97984,"_2389":98044},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_2862":58546,"_25248":58525,"_17581":98046,"_5":17476,"_23883":97984,"_2389":98047},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_2862":58547,"_25248":58525,"_17581":98049,"_5":17476,"_23883":97984,"_2389":98050},[],"`apikey_options` necesita `header` y `key`.",{"_2862":58548,"_25248":58525,"_17581":98052,"_5":17476,"_23883":97984,"_2389":98053},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2862":58549,"_25248":58525,"_17581":98055,"_5":17476,"_23883":97984,"_2389":98056},[],"`mtls_options` necesita el PEM en línea `cert_content` y `key_content`; los valores que referencian archivos del servidor se rechazan.",{"_2862":58550,"_25248":58525,"_17581":98058,"_5":17476,"_23883":97984,"_2389":98059},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_2862":58551,"_25248":58525,"_17581":98061,"_5":17476,"_23883":97992,"_2389":98062},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_2862":58552,"_25248":58525,"_17581":98064,"_5":17476,"_23883":97996,"_2389":98065},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_2862":58553,"_25248":58525,"_17581":98067,"_5":17476,"_23883":98000,"_2389":98068},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_2862":58554,"_25248":58525,"_17581":98070,"_5":17476,"_23883":98000,"_2389":98071},[],"**None** notifica todas las instancias del evento.",{"_2862":58555,"_25248":58525,"_17581":98073,"_5":17476,"_23883":98000,"_2389":98074},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_2862":58556,"_25248":58525,"_17581":98076,"_5":17476,"_23883":98000,"_2389":98077},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_2862":58557,"_25248":58525,"_17581":98079,"_5":17476,"_23883":98000,"_2389":98080},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_2862":58558,"_25248":58525,"_17581":98082,"_5":17476,"_23883":98000,"_2389":98083},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_2862":58559,"_25248":58525,"_17581":98085,"_5":17476,"_23883":98004,"_2389":98086},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_2862":58560,"_25248":58525,"_17581":98088,"_5":17476,"_23883":98008,"_2389":98089},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_2862":58561,"_25248":58525,"_17581":98091,"_5":17476,"_23883":98008,"_2389":98092},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_2862":58562,"_25248":58525,"_17581":98094,"_5":17476,"_23883":98008,"_2389":98095},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_2862":58563,"_25248":58525,"_17581":98097,"_5":17476,"_23883":98008,"_2389":98098},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_2862":58564,"_25248":58525,"_17581":98100,"_5":17476,"_23883":98008,"_2389":98101},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_2862":58565,"_25248":58525,"_17581":98103,"_5":17476,"_23883":98008,"_2389":98104},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_2862":58566,"_25248":58525,"_17581":98106,"_5":17476,"_23883":98008,"_2389":98107},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_2862":58567,"_25248":58525,"_17581":98109,"_5":17476,"_23883":98008,"_2389":98110},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_2862":58568,"_25248":58525,"_17581":98112,"_5":17476,"_23883":98012,"_2389":98113},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_2862":58569,"_25248":58525,"_17581":98115,"_5":17476,"_23883":98016,"_2389":98116},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_2862":58570,"_25248":58525,"_17581":98118,"_5":17476,"_23883":98016,"_2389":98119},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_2862":58571,"_25248":58525,"_17581":98121,"_5":17476,"_23883":98016,"_2389":98122},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_2862":58572,"_25248":58525,"_17581":98124,"_5":17476,"_23883":98016,"_2389":98125},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_2862":58573,"_25248":58525,"_17581":98127,"_5":17476,"_23883":98016,"_2389":98128},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_2862":58574,"_25248":58525,"_17581":98130,"_5":17476,"_23883":98016,"_2389":98131},[],"**Validación:** `va.role.crl.create`.",{"_2862":58575,"_25248":58525,"_17581":98133,"_5":17476,"_23883":98016,"_2389":98134},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_2862":58576,"_25248":58525,"_17581":98136,"_5":17476,"_23883":98016,"_2389":98137},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_2862":58577,"_25248":58577,"_5":12326,"_2389":98139,"_25584":98140,"_17581":98141,"_23883":58577},"Registros de auditoría",[40961,97440,97441],[],{"_2862":58578,"_25248":58577,"_17581":98143,"_5":17476,"_23883":58577,"_2389":98144},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_2862":58579,"_25248":58577,"_5":25581,"_17581":98146,"_23883":98147,"_2389":98148},[],"/docs/pr-preview/pr-45/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_2862":58580,"_25248":58577,"_5":25581,"_17581":98150,"_23883":98151,"_2389":98152},[],"/docs/pr-preview/pr-45/es/platform/administration/audit-logs#cobertura","Cobertura",{"_2862":58581,"_25248":58577,"_5":25581,"_17581":98154,"_23883":98155,"_2389":98156},[],"/docs/pr-preview/pr-45/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_2862":58582,"_25248":58577,"_5":25581,"_17581":98158,"_23883":98159,"_2389":98160},[],"/docs/pr-preview/pr-45/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_2862":58583,"_25248":58577,"_5":25581,"_17581":98162,"_23883":98163,"_2389":98164},[],"/docs/pr-preview/pr-45/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_2862":58584,"_25248":58577,"_5":25581,"_17581":98166,"_23883":98167,"_2389":98168},[],"/docs/pr-preview/pr-45/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_2862":58585,"_25248":58577,"_5":25581,"_17581":98170,"_23883":98171,"_2389":98172},[],"/docs/pr-preview/pr-45/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_2862":58586,"_25248":58577,"_5":25581,"_17581":98174,"_23883":98175,"_2389":98176},[],"/docs/pr-preview/pr-45/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_2862":58587,"_25248":58577,"_5":25581,"_17581":98178,"_23883":98179,"_2389":98180},[],"/docs/pr-preview/pr-45/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_2862":58588,"_25248":58577,"_5":25581,"_17581":98182,"_23883":98183,"_2389":98184},[],"/docs/pr-preview/pr-45/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_2862":58589,"_25248":58577,"_5":25581,"_17581":98186,"_23883":98187,"_2389":98188},[],"/docs/pr-preview/pr-45/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_2862":58590,"_25248":58577,"_17581":98190,"_5":17476,"_23883":58577,"_2389":98191},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_2862":58591,"_25248":58577,"_17581":98193,"_5":17476,"_23883":98147,"_2389":98194},[],"El cuerpo de auditoría incluye:",{"_2862":58592,"_25248":58577,"_17581":98196,"_5":17476,"_23883":98147,"_2389":98197},[],"input: datos recibidos por la operación;",{"_2862":58593,"_25248":58577,"_17581":98199,"_5":17476,"_23883":98147,"_2389":98200},[],"has\\_error: indica si el servicio devolvió un error;",{"_2862":58594,"_25248":58577,"_17581":98202,"_5":17476,"_23883":98147,"_2389":98203},[],"output: resultado producido o mensaje de error;",{"_2862":58595,"_25248":58577,"_17581":98205,"_5":17476,"_23883":98147,"_2389":98206},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_2862":58596,"_25248":58577,"_17581":98208,"_5":17476,"_23883":98147,"_2389":98209},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_2862":58597,"_25248":58577,"_17581":98211,"_5":17476,"_23883":98147,"_2389":98212},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_2862":58598,"_25248":58577,"_17581":98214,"_5":17476,"_23883":98151,"_2389":98215},[],"El backend aplica auditoría a mutaciones de:",{"_2862":58599,"_25248":58577,"_17581":98217,"_5":17476,"_23883":98151,"_2389":98218},[],"autoridades, certificados y perfiles de emisión;",{"_2862":58600,"_25248":58577,"_17581":98220,"_5":17476,"_23883":98151,"_2389":98221},[],"claves y motores KMS;",{"_2862":58601,"_25248":58577,"_17581":98223,"_5":17476,"_23883":98151,"_2389":98224},[],"dispositivos e identidades;",{"_2862":58602,"_25248":58577,"_17581":98226,"_5":17476,"_23883":98151,"_2389":98227},[],"DMS y operaciones de enrolamiento;",{"_2862":58603,"_25248":58577,"_17581":98229,"_5":17476,"_23883":98151,"_2389":98230},[],"funciones de validación y CRL;",{"_2862":58604,"_25248":58577,"_17581":98232,"_5":17476,"_23883":98151,"_2389":98233},[],"principales, políticas y concesiones de autorización.",{"_2862":58605,"_25248":58577,"_17581":98235,"_5":17476,"_23883":98151,"_2389":98236},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_2862":58606,"_25248":58577,"_17581":98238,"_5":17476,"_23883":98155,"_2389":98239},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_2862":58607,"_25248":58577,"_17581":98241,"_5":17476,"_23883":98155,"_2389":98242},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_2862":58608,"_25248":58577,"_17581":98244,"_5":17476,"_23883":98155,"_2389":98245},[],"Diseña el consumidor para:",{"_2862":58609,"_25248":58577,"_17581":98247,"_5":17476,"_23883":98155,"_2389":98248},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_2862":58610,"_25248":58577,"_17581":98250,"_5":17476,"_23883":98155,"_2389":98251},[],"conservar el CloudEvent completo sin modificar;",{"_2862":58611,"_25248":58577,"_17581":98253,"_5":17476,"_23883":98155,"_2389":98254},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_2862":58612,"_25248":58577,"_17581":98256,"_5":17476,"_23883":98155,"_2389":98257},[],"cifrar en tránsito y en reposo;",{"_2862":58613,"_25248":58577,"_17581":98259,"_5":17476,"_23883":98155,"_2389":98260},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_2862":58614,"_25248":58577,"_17581":98262,"_5":17476,"_23883":98155,"_2389":98263},[],"aplicar una política explícita de retención y legal hold;",{"_2862":58615,"_25248":58577,"_17581":98265,"_5":17476,"_23883":98155,"_2389":98266},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_2862":58616,"_25248":58577,"_17581":98268,"_5":17476,"_23883":98159,"_2389":98269},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_2862":58617,"_25248":58577,"_17581":98271,"_5":17476,"_23883":98159,"_2389":98272},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_2862":58618,"_25248":58577,"_17581":98274,"_5":17476,"_23883":98167,"_2389":98275},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_2862":58619,"_25248":58577,"_17581":98277,"_5":17476,"_23883":98171,"_2389":98278},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_2862":58620,"_25248":58577,"_17581":98280,"_5":17476,"_23883":98175,"_2389":98281},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_2862":58621,"_25248":58577,"_17581":98283,"_5":17476,"_23883":98179,"_2389":98284},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_2862":58622,"_25248":58577,"_17581":98286,"_5":17476,"_23883":98183,"_2389":98287},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_2862":58623,"_25248":58577,"_17581":98289,"_5":17476,"_23883":98187,"_2389":98290},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_2862":58624,"_25248":58577,"_17581":98292,"_5":17476,"_23883":98187,"_2389":98293},[],"aparece un evento de auditoría correcto;",{"_2862":58625,"_25248":58577,"_17581":98295,"_5":17476,"_23883":98187,"_2389":98296},[],"el principal coincide con la identidad utilizada;",{"_2862":58626,"_25248":58577,"_17581":98298,"_5":17476,"_23883":98187,"_2389":98299},[],"el consumidor lo persiste una sola vez;",{"_2862":58627,"_25248":58577,"_17581":98301,"_5":17476,"_23883":98187,"_2389":98302},[],"puede recuperarse por recurso, actor y periodo;",{"_2862":58628,"_25248":58577,"_17581":98304,"_5":17476,"_23883":98187,"_2389":98305},[],"una interrupción del consumidor produce una alerta.",{"_2862":58629,"_25248":58577,"_17581":98307,"_5":17476,"_23883":98187,"_2389":98308},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_2862":58630,"_25248":58630,"_5":12326,"_2389":98310,"_25584":98311,"_17581":98312,"_23883":58630},"Arquitectura de la plataforma",[40961,97440],[],{"_2862":58631,"_25248":58630,"_17581":98314,"_5":17476,"_23883":58630,"_2389":98315},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_2862":58632,"_25248":58630,"_5":25581,"_17581":98317,"_23883":98318,"_2389":98319},[],"/docs/pr-preview/pr-45/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_2862":58633,"_25248":58630,"_5":25581,"_17581":98321,"_23883":98322,"_2389":98323},[],"/docs/pr-preview/pr-45/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_2862":58634,"_25248":58630,"_5":25581,"_17581":98325,"_23883":98326,"_2389":98327},[],"/docs/pr-preview/pr-45/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_2862":58635,"_25248":58630,"_5":25581,"_17581":98329,"_23883":98330,"_2389":98331},[],"/docs/pr-preview/pr-45/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_2862":58636,"_25248":58630,"_5":25581,"_17581":98333,"_23883":98334,"_2389":98335},[],"/docs/pr-preview/pr-45/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_2862":58637,"_25248":58630,"_17581":98337,"_5":17476,"_23883":58630,"_2389":98338},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_2862":58638,"_25248":58630,"_17581":98340,"_5":17476,"_23883":58630,"_2389":98341},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_2862":58639,"_25248":58630,"_17581":98343,"_5":17476,"_23883":98318,"_2389":98344},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_2862":58640,"_25248":58630,"_17581":98346,"_5":17476,"_23883":98322,"_2389":98347},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_2862":58641,"_25248":58630,"_17581":98349,"_5":17476,"_23883":98326,"_2389":98350},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_2862":58642,"_25248":58630,"_17581":98352,"_5":17476,"_23883":98330,"_2389":98353},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_2862":58643,"_25248":58630,"_17581":98355,"_5":17476,"_23883":98334,"_2389":98356},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_2862":58644,"_25248":58644,"_5":12326,"_2389":98358,"_25584":98359,"_17581":98360,"_23883":58644},"Cómo funciona Lamassu",[40961,97440],[],{"_2862":58645,"_25248":58644,"_17581":98362,"_5":17476,"_23883":58644,"_2389":98363},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_2862":58646,"_25248":58644,"_5":25581,"_17581":98365,"_23883":98366,"_2389":98367},[],"/docs/pr-preview/pr-45/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_2862":58647,"_25248":58644,"_5":25581,"_17581":98369,"_23883":98370,"_2389":98371},[],"/docs/pr-preview/pr-45/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_2862":58648,"_25248":58644,"_17581":98373,"_5":17476,"_23883":58644,"_2389":98374},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_2862":58649,"_25248":58644,"_17581":98376,"_5":17476,"_23883":98366,"_2389":98377},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_2862":58650,"_25248":58644,"_17581":98379,"_5":17476,"_23883":98366,"_2389":98380},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_2862":58651,"_25248":58644,"_17581":98382,"_5":17476,"_23883":98366,"_2389":98383},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_2862":58652,"_25248":58644,"_17581":98385,"_5":17476,"_23883":98366,"_2389":98386},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_2862":58653,"_25248":58644,"_17581":98388,"_5":17476,"_23883":98366,"_2389":98389},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_2862":58654,"_25248":58644,"_17581":98391,"_5":17476,"_23883":98370,"_2389":98392},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_2862":58655,"_25248":58644,"_17581":98394,"_5":17476,"_23883":98370,"_2389":98395},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_2862":58656,"_25248":58644,"_17581":98397,"_5":17476,"_23883":98370,"_2389":98398},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_2862":58657,"_25248":58644,"_17581":98400,"_5":17476,"_23883":98370,"_2389":98401},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_2862":58658,"_25248":58644,"_17581":98403,"_5":17476,"_23883":98370,"_2389":98404},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_2862":58659,"_25248":58644,"_17581":98406,"_5":17476,"_23883":98370,"_2389":98407},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_2862":58660,"_25248":58644,"_17581":98409,"_5":17476,"_23883":98370,"_2389":98410},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2862":58661,"_25248":58661,"_5":12326,"_2389":98412,"_25584":98413,"_17581":98414,"_23883":58661},"Dispositivos e identidades",[40961,97440,43298,98412],[],{"_2862":58662,"_25248":58661,"_17581":98416,"_5":17476,"_23883":58661,"_2389":98417},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_2862":58663,"_25248":58661,"_5":25581,"_17581":98419,"_23883":98420,"_2389":98421},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_2862":58664,"_25248":58661,"_5":25581,"_17581":98423,"_23883":98424,"_2389":98425},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_2862":58665,"_25248":58661,"_5":25581,"_17581":98427,"_23883":98428,"_2389":98429},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_2862":58666,"_25248":58661,"_5":25581,"_17581":98431,"_23883":98432,"_2389":98433},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_2862":58667,"_25248":58661,"_5":25581,"_17581":98435,"_23883":98436,"_2389":98437},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_2862":58668,"_25248":58661,"_5":25581,"_17581":98439,"_23883":98440,"_2389":98441},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_2862":58669,"_25248":58661,"_5":25581,"_17581":98443,"_23883":98444,"_2389":98445},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_2862":58670,"_25248":58661,"_5":25581,"_17581":98447,"_23883":98448,"_2389":98449},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_2862":58671,"_25248":58661,"_5":25581,"_17581":98451,"_23883":98452,"_2389":98453},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_2862":58672,"_25248":58661,"_5":25581,"_17581":98455,"_23883":98456,"_2389":98457},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_2862":58673,"_25248":58661,"_5":25581,"_17581":98459,"_23883":98460,"_2389":98461},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_2862":58674,"_25248":58661,"_17581":98463,"_5":17476,"_23883":58661,"_2389":98464},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_2862":58675,"_25248":58661,"_17581":98466,"_5":17476,"_23883":58661,"_2389":98467},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_2862":58676,"_25248":58661,"_17581":98469,"_5":17476,"_23883":98420,"_2389":98470},[],"Vista operativa",{"_2862":58677,"_25248":58661,"_17581":98472,"_5":17476,"_23883":98420,"_2389":98473},[],"Interpretación",{"_2862":58678,"_25248":58661,"_17581":98475,"_5":17476,"_23883":98420,"_2389":43361},[],{"_2862":58679,"_25248":58661,"_17581":98477,"_5":17476,"_23883":98420,"_2389":98478},[],"Hay registro, pero todavía no hay identidad asociada.",{"_2862":58680,"_25248":58661,"_17581":98480,"_5":17476,"_23883":98420,"_2389":43367},[],{"_2862":58681,"_25248":58661,"_17581":98482,"_5":17476,"_23883":98420,"_2389":98483},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_2862":58682,"_25248":58661,"_17581":98485,"_5":17476,"_23883":98420,"_2389":43373},[],{"_2862":58683,"_25248":58661,"_17581":98487,"_5":17476,"_23883":98420,"_2389":98488},[],"La identidad está en la ventana operativa de renovación.",{"_2862":58684,"_25248":58661,"_17581":98490,"_5":17476,"_23883":98420,"_2389":43379},[],{"_2862":58685,"_25248":58661,"_17581":98492,"_5":17476,"_23883":98420,"_2389":98493},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_2862":58686,"_25248":58661,"_17581":98495,"_5":17476,"_23883":98420,"_2389":43385},[],{"_2862":58687,"_25248":58661,"_17581":98497,"_5":17476,"_23883":98420,"_2389":98498},[],"La identidad ha vencido.",{"_2862":58688,"_25248":58661,"_17581":98500,"_5":17476,"_23883":98420,"_2389":43391},[],{"_2862":58689,"_25248":58661,"_17581":98502,"_5":17476,"_23883":98420,"_2389":98503},[],"La identidad está marcada como revocada.",{"_2862":58690,"_25248":58661,"_17581":98505,"_5":17476,"_23883":98420,"_2389":43397},[],{"_2862":58691,"_25248":58661,"_17581":98507,"_5":17476,"_23883":98420,"_2389":98508},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_2862":58692,"_25248":58661,"_17581":98510,"_5":17476,"_23883":98420,"_2389":98511},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_2862":58693,"_25248":58661,"_17581":98513,"_5":17476,"_23883":98424,"_2389":98514},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_2862":58694,"_25248":58661,"_17581":98516,"_5":17476,"_23883":98424,"_2389":98517},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_2862":58695,"_25248":58661,"_17581":98519,"_5":17476,"_23883":98424,"_2389":98520},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_2862":58696,"_25248":58661,"_17581":98522,"_5":17476,"_23883":98424,"_2389":98523},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_2862":58697,"_25248":58661,"_17581":98525,"_5":17476,"_23883":98428,"_2389":98526},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_2862":58698,"_25248":58661,"_17581":98528,"_5":17476,"_23883":98432,"_2389":98529},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_2862":58699,"_25248":58661,"_17581":98531,"_5":17476,"_23883":98436,"_2389":98532},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_2862":58700,"_25248":58661,"_17581":98534,"_5":17476,"_23883":98440,"_2389":98535},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_2862":58701,"_25248":58661,"_17581":98537,"_5":17476,"_23883":98444,"_2389":98538},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_2862":58702,"_25248":58661,"_17581":98540,"_5":17476,"_23883":98444,"_2389":98541},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_2862":58703,"_25248":58661,"_17581":98543,"_5":17476,"_23883":98448,"_2389":98544},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_2862":58704,"_25248":58661,"_17581":98546,"_5":17476,"_23883":98448,"_2389":98547},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_2862":58705,"_25248":58661,"_17581":98549,"_5":17476,"_23883":98448,"_2389":98550},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_2862":58706,"_25248":58661,"_17581":98552,"_5":17476,"_23883":98448,"_2389":98553},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_2862":58707,"_25248":58661,"_17581":98555,"_5":17476,"_23883":98448,"_2389":98556},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_2862":58708,"_25248":58661,"_17581":98558,"_5":17476,"_23883":98448,"_2389":98559},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_2862":58709,"_25248":58661,"_17581":98561,"_5":17476,"_23883":98452,"_2389":98562},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_2862":58710,"_25248":58661,"_17581":98564,"_5":17476,"_23883":98452,"_2389":98565},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_2862":58711,"_25248":58661,"_17581":98567,"_5":17476,"_23883":98456,"_2389":98568},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_2862":58712,"_25248":58661,"_17581":98570,"_5":17476,"_23883":98456,"_2389":98571},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_2862":58713,"_25248":58661,"_17581":98573,"_5":17476,"_23883":98456,"_2389":98574},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_2862":58714,"_25248":58661,"_17581":98576,"_5":17476,"_23883":98456,"_2389":98577},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_2862":58715,"_25248":58661,"_17581":98579,"_5":17476,"_23883":98460,"_2389":98580},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2862":58716,"_25248":58661,"_17581":98582,"_5":17476,"_23883":98460,"_2389":98583},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2862":58717,"_25248":58717,"_5":12326,"_2389":98585,"_25584":98586,"_17581":98588,"_23883":58717},"Identidad inicial y autenticación",[40961,97440,43298,98412,98587],"Enrolamiento con PKI",[],{"_2862":58718,"_25248":58717,"_17581":98590,"_5":17476,"_23883":58717,"_2389":98591},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_2862":58719,"_25248":58717,"_5":25581,"_17581":98593,"_23883":98594,"_2389":98595},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_2862":58720,"_25248":58717,"_5":25581,"_17581":98597,"_23883":98598,"_2389":98599},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_2862":58721,"_25248":58717,"_5":25581,"_17581":98601,"_23883":98602,"_2389":98603},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_2862":58722,"_25248":58717,"_5":25581,"_17581":98605,"_23883":98606,"_2389":98607},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_2862":58723,"_25248":58717,"_5":25581,"_17581":98609,"_23883":98610,"_2389":98611},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_2862":58724,"_25248":58717,"_17581":98613,"_5":17476,"_23883":58717,"_2389":98614},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_2862":58725,"_25248":58717,"_17581":98616,"_5":17476,"_23883":98594,"_2389":98617},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_2862":58726,"_25248":58717,"_17581":98619,"_5":17476,"_23883":98594,"_2389":98620},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_2862":58727,"_25248":58717,"_17581":98622,"_5":17476,"_23883":98598,"_2389":98623},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_2862":58728,"_25248":58717,"_17581":98625,"_5":17476,"_23883":98598,"_2389":98626},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_2862":58729,"_25248":58717,"_17581":98628,"_5":17476,"_23883":98598,"_2389":98629},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_2862":58730,"_25248":58717,"_17581":98631,"_5":17476,"_23883":98602,"_2389":98632},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_2862":58731,"_25248":58717,"_17581":98634,"_5":17476,"_23883":98602,"_2389":98635},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_2862":58732,"_25248":58717,"_17581":98637,"_5":17476,"_23883":98606,"_2389":98638},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_2862":58733,"_25248":58717,"_17581":98640,"_5":17476,"_23883":98606,"_2389":98641},[],"Ejemplo de cuerpo:",{"_2862":58734,"_25248":58717,"_17581":98643,"_5":17476,"_23883":98606,"_2389":98644},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_2862":58735,"_25248":58717,"_17581":98646,"_5":17476,"_23883":98606,"_2389":98647},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_2862":58736,"_25248":58717,"_17581":98649,"_5":17476,"_23883":98606,"_2389":98650},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_2862":58737,"_25248":58717,"_17581":98652,"_5":17476,"_23883":98606,"_2389":98653},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_2862":58738,"_25248":58717,"_17581":98655,"_5":17476,"_23883":98610,"_2389":98656},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_2862":58739,"_25248":58717,"_17581":98658,"_5":17476,"_23883":98610,"_2389":98659},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_2862":58740,"_25248":58740,"_5":12326,"_2389":98661,"_25584":98662,"_17581":98663,"_23883":58740},"Configura y opera el DMS",[40961,97440,43298,98412,98587],[],{"_2862":58741,"_25248":58740,"_17581":98665,"_5":17476,"_23883":58740,"_2389":98666},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_2862":58742,"_25248":58740,"_5":25581,"_17581":98668,"_23883":98669,"_2389":96122},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_2862":58743,"_25248":58740,"_5":25581,"_17581":98671,"_23883":98672,"_2389":98673},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_2862":58744,"_25248":58740,"_5":25581,"_17581":98675,"_23883":98676,"_2389":98677},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_2862":58745,"_25248":58740,"_5":25581,"_17581":98679,"_23883":98680,"_2389":98681},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_2862":58746,"_25248":58740,"_5":25581,"_17581":98683,"_23883":98684,"_2389":98685},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_2862":58747,"_25248":58740,"_5":25581,"_17581":98687,"_23883":98688,"_2389":98689},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_2862":58748,"_25248":58740,"_5":25581,"_17581":98691,"_23883":98692,"_2389":98693},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_2862":58749,"_25248":58740,"_5":25581,"_17581":98695,"_23883":98696,"_2389":98697},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_2862":58750,"_25248":58740,"_5":25581,"_17581":98699,"_23883":98700,"_2389":43593},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_2862":58751,"_25248":58740,"_5":25581,"_17581":98702,"_23883":98703,"_2389":43597},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_2862":58752,"_25248":58740,"_5":25581,"_17581":98705,"_23883":98706,"_2389":98707},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_2862":58753,"_25248":58740,"_5":25581,"_17581":98709,"_23883":98710,"_2389":98711},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_2862":58754,"_25248":58740,"_5":25581,"_17581":98713,"_23883":98714,"_2389":98715},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_2862":58755,"_25248":58740,"_5":25581,"_17581":98717,"_23883":98718,"_2389":98719},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_2862":58756,"_25248":58740,"_5":25581,"_17581":98721,"_23883":98722,"_2389":43617},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_2862":58757,"_25248":58740,"_5":25581,"_17581":98724,"_23883":98725,"_2389":98726},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_2862":58758,"_25248":58740,"_5":25581,"_17581":98728,"_23883":98729,"_2389":98730},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_2862":58759,"_25248":58740,"_5":25581,"_17581":98732,"_23883":98733,"_2389":98734},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_2862":58760,"_25248":58740,"_17581":98736,"_5":17476,"_23883":58740,"_2389":98737},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_2862":58761,"_25248":58740,"_17581":98739,"_5":17476,"_23883":98669,"_2389":98740},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_2862":58762,"_25248":58740,"_17581":98742,"_5":17476,"_23883":98669,"_2389":98743},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_2862":58763,"_25248":58740,"_17581":98745,"_5":17476,"_23883":98676,"_2389":98746},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_2862":58764,"_25248":58740,"_17581":98748,"_5":17476,"_23883":98680,"_2389":98749},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_2862":58765,"_25248":58740,"_17581":98751,"_5":17476,"_23883":98684,"_2389":98752},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_2862":58766,"_25248":58740,"_17581":98754,"_5":17476,"_23883":98688,"_2389":98755},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_2862":58767,"_25248":58740,"_17581":98757,"_5":17476,"_23883":98692,"_2389":98758},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_2862":58768,"_25248":58740,"_17581":98760,"_5":17476,"_23883":98700,"_2389":98761},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_2862":58769,"_25248":58740,"_17581":98763,"_5":17476,"_23883":98700,"_2389":98764},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_2862":58770,"_25248":58740,"_17581":98766,"_5":17476,"_23883":98703,"_2389":98767},[],"Campo de `settings.enrollment_settings`",{"_2862":58771,"_25248":58740,"_17581":98769,"_5":17476,"_23883":98703,"_2389":98770},[],"Decisión",{"_2862":58772,"_25248":58740,"_17581":98772,"_5":17476,"_23883":98703,"_2389":43668},[],{"_2862":58773,"_25248":58740,"_17581":98774,"_5":17476,"_23883":98703,"_2389":98775},[],"`EST_RFC7030` para estas operaciones.",{"_2862":58774,"_25248":58740,"_17581":98777,"_5":17476,"_23883":98703,"_2389":43674},[],{"_2862":58775,"_25248":58740,"_17581":98779,"_5":17476,"_23883":98703,"_2389":98780},[],"ID de la CA que firmará.",{"_2862":58776,"_25248":58740,"_17581":98782,"_5":17476,"_23883":98703,"_2389":43680},[],{"_2862":58777,"_25248":58740,"_17581":98784,"_5":17476,"_23883":98703,"_2389":98785},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_2862":58778,"_25248":58740,"_17581":98787,"_5":17476,"_23883":98703,"_2389":43686},[],{"_2862":58779,"_25248":58740,"_17581":98789,"_5":17476,"_23883":98703,"_2389":98790},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_2862":58780,"_25248":58740,"_17581":98792,"_5":17476,"_23883":98703,"_2389":43692},[],{"_2862":58781,"_25248":58740,"_17581":98794,"_5":17476,"_23883":98703,"_2389":98795},[],"Uno de los cuatro modos de autenticación.",{"_2862":58782,"_25248":58740,"_17581":98797,"_5":17476,"_23883":98703,"_2389":98798},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_2862":58783,"_25248":58740,"_17581":98800,"_5":17476,"_23883":98706,"_2389":98801},[],"Los bloques son independientes:",{"_2862":58784,"_25248":58740,"_17581":98803,"_5":17476,"_23883":98706,"_2389":98804},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_2862":58785,"_25248":58740,"_17581":98806,"_5":17476,"_23883":98706,"_2389":98807},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_2862":58786,"_25248":58740,"_17581":98809,"_5":17476,"_23883":98706,"_2389":43710},[],{"_2862":58787,"_25248":58740,"_17581":98811,"_5":17476,"_23883":98706,"_2389":98812},[],"Control aplicado en la operación configurada",{"_2862":58788,"_25248":58740,"_17581":98814,"_5":17476,"_23883":98706,"_2389":43716},[],{"_2862":58789,"_25248":58740,"_17581":98816,"_5":17476,"_23883":98706,"_2389":98817},[],"Validación del certificado presentado.",{"_2862":58790,"_25248":58740,"_17581":98819,"_5":17476,"_23883":98706,"_2389":43722},[],{"_2862":58791,"_25248":58740,"_17581":98821,"_5":17476,"_23883":98706,"_2389":98822},[],"Autorización del webhook configurado.",{"_2862":58792,"_25248":58740,"_17581":98824,"_5":17476,"_23883":98706,"_2389":43728},[],{"_2862":58793,"_25248":58740,"_17581":98826,"_5":17476,"_23883":98706,"_2389":98827},[],"Validación del certificado y, después, aprobación del webhook.",{"_2862":58794,"_25248":58740,"_17581":98829,"_5":17476,"_23883":98706,"_2389":43734},[],{"_2862":58795,"_25248":58740,"_17581":98831,"_5":17476,"_23883":98706,"_2389":98832},[],"Sin autenticación del solicitante por el DMS.",{"_2862":58796,"_25248":58740,"_17581":98834,"_5":17476,"_23883":98706,"_2389":98835},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_2862":58797,"_25248":58740,"_17581":98837,"_5":17476,"_23883":98706,"_2389":98838},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_2862":58798,"_25248":58740,"_17581":98840,"_5":17476,"_23883":98706,"_2389":98841},[],"En reenrolamiento con certificado, el validador utiliza la CA de enrolamiento, después `additional_validation_cas`, y la opción `enable_expired_renewal`. No presupongas que copiar `validation_cas` del bloque inicial cambia esos emisores.",{"_2862":58799,"_25248":58740,"_17581":98843,"_5":17476,"_23883":98706,"_2389":98844},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_2862":58800,"_25248":58740,"_17581":98846,"_5":17476,"_23883":98710,"_2389":98847},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_2862":58801,"_25248":58740,"_17581":98849,"_5":17476,"_23883":98710,"_2389":98850},[],"Campo de `external_webhook_settings`",{"_2862":58802,"_25248":58740,"_17581":98852,"_5":17476,"_23883":98710,"_2389":98770},[],{"_2862":58803,"_25248":58740,"_17581":98854,"_5":17476,"_23883":98710,"_2389":43760},[],{"_2862":58804,"_25248":58740,"_17581":98856,"_5":17476,"_23883":98710,"_2389":98857},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_2862":58805,"_25248":58740,"_17581":98859,"_5":17476,"_23883":98710,"_2389":43766},[],{"_2862":58806,"_25248":58740,"_17581":98861,"_5":17476,"_23883":98710,"_2389":98862},[],"`POST` o `PUT`; `POST` por defecto.",{"_2862":58807,"_25248":58740,"_17581":98864,"_5":17476,"_23883":98710,"_2389":43772},[],{"_2862":58808,"_25248":58740,"_17581":98866,"_5":17476,"_23883":98710,"_2389":98867},[],"Etiqueta usada en los logs del servicio.",{"_2862":58809,"_25248":58740,"_17581":98869,"_5":17476,"_23883":98710,"_2389":43778},[],{"_2862":58810,"_25248":58740,"_17581":98871,"_5":17476,"_23883":98710,"_2389":98872},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_2862":58811,"_25248":58740,"_17581":98874,"_5":17476,"_23883":98710,"_2389":43784},[],{"_2862":58812,"_25248":58740,"_17581":98876,"_5":17476,"_23883":98710,"_2389":98877},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_2862":58813,"_25248":58740,"_17581":98879,"_5":17476,"_23883":98710,"_2389":43790},[],{"_2862":58814,"_25248":58740,"_17581":98881,"_5":17476,"_23883":98710,"_2389":98882},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2862":58815,"_25248":58740,"_17581":98884,"_5":17476,"_23883":98710,"_2389":43796},[],{"_2862":58816,"_25248":58740,"_17581":98886,"_5":17476,"_23883":98710,"_2389":98887},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM en línea.",{"_2862":58817,"_25248":58740,"_17581":98889,"_5":17476,"_23883":98710,"_2389":43802},[],{"_2862":58818,"_25248":58740,"_17581":98891,"_5":17476,"_23883":98710,"_2389":98892},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_2862":58819,"_25248":58740,"_17581":98894,"_5":17476,"_23883":98710,"_2389":43808},[],{"_2862":58820,"_25248":58740,"_17581":98896,"_5":17476,"_23883":98710,"_2389":98897},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_2862":58821,"_25248":58740,"_17581":98899,"_5":17476,"_23883":98710,"_2389":98900},[],"Reglas de esa configuración:",{"_2862":58822,"_25248":58740,"_17581":98902,"_5":17476,"_23883":98710,"_2389":98903},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que entrega el PEM como `mtls_options.cert_content` y `key_content`.",{"_2862":58823,"_25248":58740,"_17581":98905,"_5":17476,"_23883":98710,"_2389":98906},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_2862":58824,"_25248":58740,"_17581":98908,"_5":17476,"_23883":98710,"_2389":98909},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_2862":58825,"_25248":58740,"_17581":98911,"_5":17476,"_23883":98710,"_2389":98912},[],"La API ignora los campos heredados `validate_server_cert`, `apikey`, `oidc` y `mtls`. Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` que aún solo contenga los campos de opción heredados (`apikey`, `oidc`, `mtls`) falla la validación con 400; solo se aceptan cuerpos heredados `noauth`, y sus credenciales se descartan.",{"_2862":58826,"_25248":58740,"_17581":98914,"_5":17476,"_23883":98710,"_2389":98915},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_2862":58827,"_25248":58740,"_17581":98917,"_5":17476,"_23883":98710,"_2389":98918},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_2862":58828,"_25248":58740,"_17581":98920,"_5":17476,"_23883":98710,"_2389":98921},[],"La migración `20260604110000` copia la autenticación inicial al bloque de renovación si este falta y existe la estructura necesaria. No sustituye una configuración ya presente. Después de actualizar, lee ambos bloques; si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_2862":58829,"_25248":58740,"_17581":98923,"_5":17476,"_23883":98710,"_2389":98924},[],"La migración `20261021120000` reescribe todas las configuraciones de webhook almacenadas con este formato: `validate_server_cert` pasa a ser `insecure_skip_verify` negado (una configuración con `validate_server_cert` a false sigue sin verificar el certificado), `oidc` pasa a ser `jwt_options`, `apikey` pasa a ser `apikey_options` y `mtls` pasa a ser `mtls_options`. Cuando el certificado y la clave heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `key_content` y no requieren ninguna acción. En cualquier otro caso, incluida una configuración mixta (certificado PEM y clave como ruta de fichero), ambos valores pasan a `mtls_options.cert_file` y `key_file`. La entrega rechaza cualquier configuración de webhook que haga referencia a ficheros, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se vuelvan a introducir como contenido PEM, o se eliminen los campos de fichero sobrantes si el webhook no usa mTLS. Si la consola de tu versión no muestra esos campos, edita el DMS mediante la API de DMS.",{"_2862":58830,"_25248":58740,"_17581":98926,"_5":17476,"_23883":98714,"_2389":98927},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_2862":58831,"_25248":58740,"_17581":98929,"_5":17476,"_23883":98718,"_2389":98930},[],"Campo de `settings.reenrollment_settings`",{"_2862":58832,"_25248":58740,"_17581":98932,"_5":17476,"_23883":98718,"_2389":98933},[],"Función",{"_2862":58833,"_25248":58740,"_17581":98935,"_5":17476,"_23883":98718,"_2389":43849},[],{"_2862":58834,"_25248":58740,"_17581":98937,"_5":17476,"_23883":98718,"_2389":98938},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_2862":58835,"_25248":58740,"_17581":98940,"_5":17476,"_23883":98718,"_2389":43855},[],{"_2862":58836,"_25248":58740,"_17581":98942,"_5":17476,"_23883":98718,"_2389":98943},[],"Umbral operativo preventivo de monitorización.",{"_2862":58837,"_25248":58740,"_17581":98945,"_5":17476,"_23883":98718,"_2389":43861},[],{"_2862":58838,"_25248":58740,"_17581":98947,"_5":17476,"_23883":98718,"_2389":98948},[],"Umbral operativo crítico de monitorización.",{"_2862":58839,"_25248":58740,"_17581":98950,"_5":17476,"_23883":98718,"_2389":43867},[],{"_2862":58840,"_25248":58740,"_17581":98952,"_5":17476,"_23883":98718,"_2389":98953},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_2862":58841,"_25248":58740,"_17581":98955,"_5":17476,"_23883":98718,"_2389":43873},[],{"_2862":58842,"_25248":58740,"_17581":98957,"_5":17476,"_23883":98718,"_2389":98958},[],"Emisores adicionales para la credencial mTLS durante una migración.",{"_2862":58843,"_25248":58740,"_17581":98960,"_5":17476,"_23883":98718,"_2389":43879},[],{"_2862":58844,"_25248":58740,"_17581":98962,"_5":17476,"_23883":98718,"_2389":98963},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_2862":58845,"_25248":58740,"_17581":98965,"_5":17476,"_23883":98718,"_2389":98966},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_2862":58846,"_25248":58740,"_17581":98968,"_5":17476,"_23883":98722,"_2389":98969},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. Algoritmo y tamaño proceden de su campo `key`; el perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_2862":58847,"_25248":58740,"_17581":98971,"_5":17476,"_23883":98725,"_2389":96479},[],{"_2862":58848,"_25248":58740,"_17581":98973,"_5":17476,"_23883":98725,"_2389":98974},[],"Qué publica",{"_2862":58849,"_25248":58740,"_17581":98976,"_5":17476,"_23883":98725,"_2389":43896},[],{"_2862":58850,"_25248":58740,"_17581":98978,"_5":17476,"_23883":98725,"_2389":98979},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_2862":58851,"_25248":58740,"_17581":98981,"_5":17476,"_23883":98725,"_2389":43902},[],{"_2862":58852,"_25248":58740,"_17581":98983,"_5":17476,"_23883":98725,"_2389":98984},[],"Certificado de la CA emisora seleccionada.",{"_2862":58853,"_25248":58740,"_17581":98986,"_5":17476,"_23883":98725,"_2389":43908},[],{"_2862":58854,"_25248":58740,"_17581":98988,"_5":17476,"_23883":98725,"_2389":98989},[],"Certificados de las CAs elegidas explícitamente.",{"_2862":58855,"_25248":58740,"_17581":98991,"_5":17476,"_23883":98725,"_2389":98992},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_2862":58856,"_25248":58740,"_17581":98994,"_5":17476,"_23883":98729,"_2389":98995},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_2862":58857,"_25248":58740,"_17581":98997,"_5":17476,"_23883":98729,"_2389":98998},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_2862":58858,"_25248":58740,"_17581":99000,"_5":17476,"_23883":98729,"_2389":99001},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_2862":58859,"_25248":58740,"_17581":99003,"_5":17476,"_23883":98733,"_2389":99004},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_2862":58860,"_25248":58860,"_5":12326,"_2389":99006,"_25584":99007,"_17581":99008,"_23883":58860},"Integra el cliente EST",[40961,97440,43298,98412,98587],[],{"_2862":58861,"_25248":58860,"_17581":99010,"_5":17476,"_23883":58860,"_2389":99011},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_2862":58862,"_25248":58860,"_5":25581,"_17581":99013,"_23883":99014,"_2389":96122},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_2862":58863,"_25248":58860,"_5":25581,"_17581":99016,"_23883":99017,"_2389":99018},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_2862":58864,"_25248":58860,"_5":25581,"_17581":99020,"_23883":99021,"_2389":99022},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_2862":58865,"_25248":58860,"_5":25581,"_17581":99024,"_23883":99025,"_2389":99026},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_2862":58866,"_25248":58860,"_5":25581,"_17581":99028,"_23883":99029,"_2389":99030},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_2862":58867,"_25248":58860,"_5":25581,"_17581":99032,"_23883":99033,"_2389":99034},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_2862":58868,"_25248":58860,"_17581":99036,"_5":17476,"_23883":58860,"_2389":99037},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_2862":58869,"_25248":58860,"_17581":99039,"_5":17476,"_23883":99014,"_2389":99040},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_2862":58870,"_25248":58860,"_17581":99042,"_5":17476,"_23883":99014,"_2389":99043},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_2862":58871,"_25248":58860,"_17581":99045,"_5":17476,"_23883":99014,"_2389":99046},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_2862":58872,"_25248":58860,"_17581":99048,"_5":17476,"_23883":99017,"_2389":99049},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_2862":58873,"_25248":58860,"_17581":99051,"_5":17476,"_23883":99017,"_2389":99052},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_2862":58874,"_25248":58860,"_17581":99054,"_5":17476,"_23883":99021,"_2389":99055},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_2862":58875,"_25248":58860,"_17581":99057,"_5":17476,"_23883":99021,"_2389":99058},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_2862":58876,"_25248":58860,"_17581":99060,"_5":17476,"_23883":99025,"_2389":99061},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_2862":58877,"_25248":58860,"_17581":99063,"_5":17476,"_23883":99025,"_2389":99064},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_2862":58878,"_25248":58860,"_17581":99066,"_5":17476,"_23883":99029,"_2389":99067},[],"Para el caso de una raíz que emite directamente:",{"_2862":58879,"_25248":58860,"_17581":99069,"_5":17476,"_23883":99029,"_2389":99070},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_2862":58880,"_25248":58860,"_17581":99072,"_5":17476,"_23883":99029,"_2389":99073},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_2862":58881,"_25248":58860,"_17581":99075,"_5":17476,"_23883":99033,"_2389":99076},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_2862":58882,"_25248":58882,"_5":12326,"_2389":99078,"_25584":99079,"_17581":99080,"_23883":58882},"Referencia EST",[40961,97440,43298,98412,98587],[],{"_2862":58883,"_25248":58882,"_17581":99082,"_5":17476,"_23883":58882,"_2389":99083},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_2862":58884,"_25248":58882,"_5":25581,"_17581":99085,"_23883":99086,"_2389":99087},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_2862":58885,"_25248":58882,"_5":25581,"_17581":99089,"_23883":99090,"_2389":19119},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2862":58886,"_25248":58882,"_5":25581,"_17581":99092,"_23883":99093,"_2389":21892},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2862":58887,"_25248":58882,"_5":25581,"_17581":99095,"_23883":99096,"_2389":21899},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2862":58888,"_25248":58882,"_5":25581,"_17581":99098,"_23883":99099,"_2389":21269},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2862":58889,"_25248":58882,"_5":25581,"_17581":99101,"_23883":99102,"_2389":99103},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_2862":58890,"_25248":58882,"_5":25581,"_17581":99105,"_23883":99106,"_2389":99107},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_2862":58891,"_25248":58882,"_5":25581,"_17581":99109,"_23883":99110,"_2389":99111},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_2862":58892,"_25248":58882,"_17581":99113,"_5":17476,"_23883":58882,"_2389":99114},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_2862":58893,"_25248":58882,"_17581":99116,"_5":17476,"_23883":99086,"_2389":99117},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_2862":58894,"_25248":58882,"_17581":99119,"_5":17476,"_23883":99086,"_2389":97231},[],{"_2862":58895,"_25248":58882,"_17581":99121,"_5":17476,"_23883":99086,"_2389":99122},[],"Método",{"_2862":58896,"_25248":58882,"_17581":99124,"_5":17476,"_23883":99086,"_2389":99125},[],"Autenticación y condición",{"_2862":58897,"_25248":58882,"_17581":99127,"_5":17476,"_23883":99086,"_2389":44051},[],{"_2862":58898,"_25248":58882,"_17581":99129,"_5":17476,"_23883":99086,"_2389":44054},[],{"_2862":58899,"_25248":58882,"_17581":99131,"_5":17476,"_23883":99086,"_2389":99132},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_2862":58900,"_25248":58882,"_17581":99134,"_5":17476,"_23883":99086,"_2389":44060},[],{"_2862":58901,"_25248":58882,"_17581":99136,"_5":17476,"_23883":99086,"_2389":44063},[],{"_2862":58902,"_25248":58882,"_17581":99138,"_5":17476,"_23883":99086,"_2389":99139},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_2862":58903,"_25248":58882,"_17581":99141,"_5":17476,"_23883":99086,"_2389":44069},[],{"_2862":58904,"_25248":58882,"_17581":99143,"_5":17476,"_23883":99086,"_2389":44063},[],{"_2862":58905,"_25248":58882,"_17581":99145,"_5":17476,"_23883":99086,"_2389":99146},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_2862":58906,"_25248":58882,"_17581":99148,"_5":17476,"_23883":99086,"_2389":44077},[],{"_2862":58907,"_25248":58882,"_17581":99150,"_5":17476,"_23883":99086,"_2389":44063},[],{"_2862":58908,"_25248":58882,"_17581":99152,"_5":17476,"_23883":99086,"_2389":99153},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_2862":58909,"_25248":58882,"_17581":99155,"_5":17476,"_23883":99086,"_2389":99156},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_2862":58910,"_25248":58882,"_17581":99158,"_5":17476,"_23883":99090,"_2389":99159},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_2862":58911,"_25248":58882,"_17581":99161,"_5":17476,"_23883":99090,"_2389":99162},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_2862":58912,"_25248":58882,"_17581":99164,"_5":17476,"_23883":99093,"_2389":99165},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_2862":58913,"_25248":58882,"_17581":99167,"_5":17476,"_23883":99093,"_2389":99168},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_2862":58914,"_25248":58882,"_17581":99170,"_5":17476,"_23883":99096,"_2389":99171},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_2862":58915,"_25248":58882,"_17581":99173,"_5":17476,"_23883":99096,"_2389":99174},[],"La CA de enrolamiento o una CA adicional valida la credencial en el modo mTLS. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_2862":58916,"_25248":58882,"_17581":99176,"_5":17476,"_23883":99099,"_2389":99177},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_2862":58917,"_25248":58882,"_17581":99179,"_5":17476,"_23883":99099,"_2389":99180},[],"El código admite RSA y ECDSA de 224, 256, 384 o 521 bits. Un tamaño ECDSA no reconocido puede producir fallback a 256; elige explícitamente un tamaño compatible y comprueba la clave resultante. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_2862":58918,"_25248":58882,"_17581":99182,"_5":17476,"_23883":99102,"_2389":99183},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_2862":58919,"_25248":58882,"_17581":99185,"_5":17476,"_23883":99102,"_2389":99186},[],"Parte",{"_2862":58920,"_25248":58882,"_17581":99188,"_5":17476,"_23883":99102,"_2389":99189},[],"Contenido tras decodificar su Base64",{"_2862":58921,"_25248":58882,"_17581":99191,"_5":17476,"_23883":99102,"_2389":44121},[],{"_2862":58922,"_25248":58882,"_17581":99193,"_5":17476,"_23883":99102,"_2389":99194},[],"Clave privada PKCS#8 DER sin cifrar.",{"_2862":58923,"_25248":58882,"_17581":99196,"_5":17476,"_23883":99102,"_2389":44127},[],{"_2862":58924,"_25248":58882,"_17581":99198,"_5":17476,"_23883":99102,"_2389":99199},[],"PKCS#7 DER con el certificado emitido.",{"_2862":58925,"_25248":58882,"_17581":99201,"_5":17476,"_23883":99102,"_2389":99202},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_2862":58926,"_25248":58882,"_17581":99204,"_5":17476,"_23883":99106,"_2389":99205},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_2862":58927,"_25248":58882,"_17581":99207,"_5":17476,"_23883":99106,"_2389":99208},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_2862":58928,"_25248":58882,"_17581":99210,"_5":17476,"_23883":99106,"_2389":99211},[],"Convierte y comprueba el resultado:",{"_2862":58929,"_25248":58882,"_17581":99213,"_5":17476,"_23883":99106,"_2389":99214},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_2862":58930,"_25248":58882,"_17581":99216,"_5":17476,"_23883":99110,"_2389":99217},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_2862":58931,"_25248":58882,"_17581":99219,"_5":17476,"_23883":99110,"_2389":99220},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_2862":58932,"_25248":58932,"_5":12326,"_2389":98587,"_25584":99222,"_17581":99223,"_23883":58932},[40961,97440,43298,98412,98587],[],{"_2862":58933,"_25248":58932,"_17581":99225,"_5":17476,"_23883":58932,"_2389":99226},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_2862":58934,"_25248":58932,"_5":25581,"_17581":99228,"_23883":99229,"_2389":99230},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_2862":58935,"_25248":58932,"_5":25581,"_17581":99232,"_23883":99233,"_2389":99234},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_2862":58936,"_25248":58932,"_5":25581,"_17581":99236,"_23883":99237,"_2389":99238},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_2862":58937,"_25248":58932,"_5":25581,"_17581":99240,"_23883":99241,"_2389":99242},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_2862":58938,"_25248":58932,"_17581":99244,"_5":17476,"_23883":58932,"_2389":99245},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_2862":58939,"_25248":58932,"_17581":99247,"_5":17476,"_23883":99229,"_2389":99248},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_2862":58940,"_25248":58932,"_17581":99250,"_5":17476,"_23883":99229,"_2389":99251},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_2862":58941,"_25248":58932,"_17581":99253,"_5":17476,"_23883":99229,"_2389":99254},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_2862":58942,"_25248":58932,"_17581":99256,"_5":17476,"_23883":99229,"_2389":99257},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_2862":58943,"_25248":58932,"_17581":99259,"_5":17476,"_23883":99229,"_2389":99260},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_2862":58944,"_25248":58932,"_17581":99262,"_5":17476,"_23883":99229,"_2389":99263},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_2862":58945,"_25248":58932,"_17581":99265,"_5":17476,"_23883":99233,"_2389":99266},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2862":58946,"_25248":58932,"_17581":99268,"_5":17476,"_23883":99233,"_2389":99269},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2862":58947,"_25248":58932,"_17581":99271,"_5":17476,"_23883":99233,"_2389":99272},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2862":58948,"_25248":58932,"_17581":99274,"_5":17476,"_23883":99233,"_2389":99275},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2862":58949,"_25248":58932,"_17581":99277,"_5":17476,"_23883":99237,"_2389":99278},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2862":58950,"_25248":58932,"_17581":99280,"_5":17476,"_23883":99237,"_2389":99281},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2862":58951,"_25248":58932,"_17581":99283,"_5":17476,"_23883":99237,"_2389":99284},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2862":58952,"_25248":58932,"_17581":99286,"_5":17476,"_23883":99237,"_2389":99287},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2862":58953,"_25248":58932,"_17581":99289,"_5":17476,"_23883":99241,"_2389":99290},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato y migraciones, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_2862":58954,"_25248":58932,"_17581":99292,"_5":17476,"_23883":99241,"_2389":99293},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_2862":58955,"_25248":58955,"_5":12326,"_2389":99295,"_25584":99296,"_17581":99297,"_23883":58955},"Estrategias de aprovisionamiento",[40961,97440,43298,98412,98587],[],{"_2862":58956,"_25248":58955,"_17581":99299,"_5":17476,"_23883":58955,"_2389":99300},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_2862":58957,"_25248":58955,"_5":25581,"_17581":99302,"_23883":99303,"_2389":99304},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_2862":58958,"_25248":58955,"_5":25581,"_17581":99306,"_23883":99307,"_2389":99308},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_2862":58959,"_25248":58955,"_5":25581,"_17581":99310,"_23883":99311,"_2389":99312},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_2862":58960,"_25248":58955,"_5":25581,"_17581":99314,"_23883":99315,"_2389":99316},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_2862":58961,"_25248":58955,"_5":25581,"_17581":99318,"_23883":99319,"_2389":99320},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_2862":58962,"_25248":58955,"_17581":99322,"_5":17476,"_23883":58955,"_2389":99323},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_2862":58963,"_25248":58955,"_17581":99325,"_5":17476,"_23883":99303,"_2389":99326},[],"Recorrido",{"_2862":58964,"_25248":58955,"_17581":99328,"_5":17476,"_23883":99303,"_2389":99329},[],"Cuándo existe el dispositivo",{"_2862":58965,"_25248":58955,"_17581":99331,"_5":17476,"_23883":99303,"_2389":99332},[],"Qué compruebas",{"_2862":58966,"_25248":58955,"_17581":99334,"_5":17476,"_23883":99303,"_2389":99335},[],"Asignación manual",{"_2862":58967,"_25248":58955,"_17581":99337,"_5":17476,"_23883":99303,"_2389":99338},[],"El operador lo crea antes de asociar un certificado.",{"_2862":58968,"_25248":58955,"_17581":99340,"_5":17476,"_23883":99303,"_2389":99341},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_2862":58969,"_25248":58955,"_17581":99343,"_5":17476,"_23883":99303,"_2389":99344},[],"EST con `JITP`",{"_2862":58970,"_25248":58955,"_17581":99346,"_5":17476,"_23883":99303,"_2389":99347},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_2862":58971,"_25248":58955,"_17581":99349,"_5":17476,"_23883":99303,"_2389":99350},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_2862":58972,"_25248":58955,"_17581":99352,"_5":17476,"_23883":99303,"_2389":99353},[],"EST con `PRE_REGISTRATION`",{"_2862":58973,"_25248":58955,"_17581":99355,"_5":17476,"_23883":99303,"_2389":99356},[],"Debe existir antes de `/simpleenroll`.",{"_2862":58974,"_25248":58955,"_17581":99358,"_5":17476,"_23883":99303,"_2389":99359},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_2862":58975,"_25248":58955,"_17581":99361,"_5":17476,"_23883":99303,"_2389":99362},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_2862":58976,"_25248":58955,"_17581":99364,"_5":17476,"_23883":99303,"_2389":99365},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_2862":58977,"_25248":58955,"_17581":99367,"_5":17476,"_23883":99307,"_2389":99368},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_2862":58978,"_25248":58955,"_17581":99370,"_5":17476,"_23883":99307,"_2389":99371},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_2862":58979,"_25248":58955,"_17581":99373,"_5":17476,"_23883":99307,"_2389":99374},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_2862":58980,"_25248":58955,"_17581":99376,"_5":17476,"_23883":99311,"_2389":99377},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_2862":58981,"_25248":58955,"_17581":99379,"_5":17476,"_23883":99311,"_2389":99380},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_2862":58982,"_25248":58955,"_17581":99382,"_5":17476,"_23883":99311,"_2389":99383},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_2862":58983,"_25248":58955,"_17581":99385,"_5":17476,"_23883":99311,"_2389":99386},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_2862":58984,"_25248":58955,"_17581":99388,"_5":17476,"_23883":99311,"_2389":99389},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_2862":58985,"_25248":58955,"_17581":99391,"_5":17476,"_23883":99311,"_2389":99392},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_2862":58986,"_25248":58955,"_17581":99394,"_5":17476,"_23883":99315,"_2389":96479},[],{"_2862":58987,"_25248":58955,"_17581":99396,"_5":17476,"_23883":99315,"_2389":99397},[],"Material que atraviesa EST",{"_2862":58988,"_25248":58955,"_17581":99399,"_5":17476,"_23883":99315,"_2389":99400},[],"Clave generada por el dispositivo",{"_2862":58989,"_25248":58955,"_17581":99402,"_5":17476,"_23883":99315,"_2389":99403},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_2862":58990,"_25248":58955,"_17581":99405,"_5":17476,"_23883":99315,"_2389":99406},[],"Clave ya disponible en el dispositivo",{"_2862":58991,"_25248":58955,"_17581":99408,"_5":17476,"_23883":99315,"_2389":99409},[],"CSR firmada con la clave existente y certificado nuevo.",{"_2862":58992,"_25248":58955,"_17581":99411,"_5":17476,"_23883":99315,"_2389":43617},[],{"_2862":58993,"_25248":58955,"_17581":99413,"_5":17476,"_23883":99315,"_2389":99414},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_2862":58994,"_25248":58955,"_17581":99416,"_5":17476,"_23883":99315,"_2389":99417},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_2862":58995,"_25248":58955,"_17581":99419,"_5":17476,"_23883":99319,"_2389":99420},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_2862":58996,"_25248":58996,"_5":12326,"_2389":99422,"_25584":99423,"_17581":99424,"_23883":58996},"Renovación y recuperación",[40961,97440,43298,98412,98587],[],{"_2862":58997,"_25248":58996,"_17581":99426,"_5":17476,"_23883":58996,"_2389":99427},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_2862":58998,"_25248":58996,"_5":25581,"_17581":99429,"_23883":99430,"_2389":99431},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_2862":58999,"_25248":58996,"_5":25581,"_17581":99433,"_23883":99434,"_2389":99435},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_2862":59000,"_25248":58996,"_5":25581,"_17581":99437,"_23883":99438,"_2389":99439},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_2862":59001,"_25248":58996,"_5":25581,"_17581":99441,"_23883":99442,"_2389":99443},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_2862":59002,"_25248":58996,"_5":25581,"_17581":99445,"_23883":99446,"_2389":99447},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_2862":59003,"_25248":58996,"_17581":99449,"_5":17476,"_23883":58996,"_2389":99450},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_2862":59004,"_25248":58996,"_17581":99452,"_5":17476,"_23883":99430,"_2389":99453},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_2862":59005,"_25248":58996,"_17581":99455,"_5":17476,"_23883":99430,"_2389":99456},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_2862":59006,"_25248":58996,"_17581":99458,"_5":17476,"_23883":99430,"_2389":99459},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_2862":59007,"_25248":58996,"_17581":99461,"_5":17476,"_23883":99430,"_2389":99462},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_2862":59008,"_25248":58996,"_17581":99464,"_5":17476,"_23883":99434,"_2389":99465},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_2862":59009,"_25248":58996,"_17581":99467,"_5":17476,"_23883":99434,"_2389":99468},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_2862":59010,"_25248":58996,"_17581":99470,"_5":17476,"_23883":99438,"_2389":99471},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_2862":59011,"_25248":58996,"_17581":99473,"_5":17476,"_23883":99438,"_2389":99474},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_2862":59012,"_25248":58996,"_17581":99476,"_5":17476,"_23883":99438,"_2389":99477},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_2862":59013,"_25248":58996,"_17581":99479,"_5":17476,"_23883":99442,"_2389":99480},[],"Situación",{"_2862":59014,"_25248":58996,"_17581":99482,"_5":17476,"_23883":99442,"_2389":99483},[],"Procedimiento",{"_2862":59015,"_25248":58996,"_17581":99485,"_5":17476,"_23883":99442,"_2389":99486},[],"Certificado vigente, fuera de ventana",{"_2862":59016,"_25248":58996,"_17581":99488,"_5":17476,"_23883":99442,"_2389":99489},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_2862":59017,"_25248":58996,"_17581":99491,"_5":17476,"_23883":99442,"_2389":99492},[],"Certificado vencido, clave disponible",{"_2862":59018,"_25248":58996,"_17581":99494,"_5":17476,"_23883":99442,"_2389":99495},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_2862":59019,"_25248":58996,"_17581":99497,"_5":17476,"_23883":99442,"_2389":99498},[],"Renovación por webhook o `NO_AUTH`",{"_2862":59020,"_25248":58996,"_17581":99500,"_5":17476,"_23883":99442,"_2389":99501},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_2862":59021,"_25248":58996,"_17581":99503,"_5":17476,"_23883":99442,"_2389":99504},[],"Clave perdida o inaccesible",{"_2862":59022,"_25248":58996,"_17581":99506,"_5":17476,"_23883":99442,"_2389":99507},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_2862":59023,"_25248":58996,"_17581":99509,"_5":17476,"_23883":99442,"_2389":99510},[],"Identidad actual revocada",{"_2862":59024,"_25248":58996,"_17581":99512,"_5":17476,"_23883":99442,"_2389":99513},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_2862":59025,"_25248":58996,"_17581":99515,"_5":17476,"_23883":99442,"_2389":99516},[],"Dispositivo sin identidad",{"_2862":59026,"_25248":58996,"_17581":99518,"_5":17476,"_23883":99442,"_2389":99519},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_2862":59027,"_25248":58996,"_17581":99521,"_5":17476,"_23883":99442,"_2389":99522},[],"Dispositivo retirado",{"_2862":59028,"_25248":58996,"_17581":99524,"_5":17476,"_23883":99442,"_2389":99525},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_2862":59029,"_25248":58996,"_17581":99527,"_5":17476,"_23883":99442,"_2389":99528},[],"Timeout, HTTP 500 o fallo de instalación",{"_2862":59030,"_25248":58996,"_17581":99530,"_5":17476,"_23883":99442,"_2389":99531},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_2862":59031,"_25248":58996,"_17581":99533,"_5":17476,"_23883":99446,"_2389":99534},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_2862":59032,"_25248":58996,"_17581":99536,"_5":17476,"_23883":99446,"_2389":99537},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_2862":59033,"_25248":59033,"_5":12326,"_2389":99539,"_25584":99540,"_17581":99541,"_23883":59033},"Diagnóstico de enrolamiento",[40961,97440,43298,98412,98587],[],{"_2862":59034,"_25248":59033,"_17581":99543,"_5":17476,"_23883":59033,"_2389":99544},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_2862":59035,"_25248":59033,"_5":25581,"_17581":99546,"_23883":99547,"_2389":99548},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_2862":59036,"_25248":59033,"_5":25581,"_17581":99550,"_23883":99551,"_2389":99552},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_2862":59037,"_25248":59033,"_5":25581,"_17581":99554,"_23883":99555,"_2389":99111},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_2862":59038,"_25248":59033,"_5":25581,"_17581":99557,"_23883":99558,"_2389":99559},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_2862":59039,"_25248":59033,"_17581":99561,"_5":17476,"_23883":59033,"_2389":99562},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_2862":59040,"_25248":59033,"_17581":99564,"_5":17476,"_23883":99551,"_2389":99565},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_2862":59041,"_25248":59033,"_17581":99567,"_5":17476,"_23883":99551,"_2389":99568},[],"Síntoma o mensaje",{"_2862":59042,"_25248":59033,"_17581":99570,"_5":17476,"_23883":99551,"_2389":99571},[],"Qué revisar",{"_2862":59043,"_25248":59033,"_17581":99573,"_5":17476,"_23883":99551,"_2389":99574},[],"curl rechaza TLS, nombre o emisor",{"_2862":59044,"_25248":59033,"_17581":99576,"_5":17476,"_23883":99551,"_2389":99577},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_2862":59045,"_25248":59033,"_17581":99579,"_5":17476,"_23883":99551,"_2389":99580},[],"404 o APS ausente",{"_2862":59046,"_25248":59033,"_17581":99582,"_5":17476,"_23883":99551,"_2389":99583},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_2862":59047,"_25248":59033,"_17581":99585,"_5":17476,"_23883":99551,"_2389":99586},[],"400, error de CSR o formato",{"_2862":59048,"_25248":59033,"_17581":99588,"_5":17476,"_23883":99551,"_2389":99589},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_2862":59049,"_25248":59033,"_17581":99591,"_5":17476,"_23883":99551,"_2389":99592},[],"Credencial ausente o certificado no válido",{"_2862":59050,"_25248":59033,"_17581":99594,"_5":17476,"_23883":99551,"_2389":99595},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_2862":59051,"_25248":59033,"_17581":99597,"_5":17476,"_23883":99551,"_2389":99598},[],"Webhook deniega, expira o responde sin autorización",{"_2862":59052,"_25248":59033,"_17581":99600,"_5":17476,"_23883":99551,"_2389":99601},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_2862":59053,"_25248":59033,"_17581":99603,"_5":17476,"_23883":99551,"_2389":44534},[],{"_2862":59054,"_25248":59033,"_17581":99605,"_5":17476,"_23883":99551,"_2389":99606},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_2862":59055,"_25248":59033,"_17581":99608,"_5":17476,"_23883":99551,"_2389":44540},[],{"_2862":59056,"_25248":59033,"_17581":99610,"_5":17476,"_23883":99551,"_2389":99611},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_2862":59057,"_25248":59033,"_17581":99613,"_5":17476,"_23883":99551,"_2389":44546},[],{"_2862":59058,"_25248":59033,"_17581":99615,"_5":17476,"_23883":99551,"_2389":99616},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el PEM como `cert_content` y `key_content`; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la nota de migración en DMS.",{"_2862":59059,"_25248":59033,"_17581":99618,"_5":17476,"_23883":99551,"_2389":99619},[],"400 `struct validation error` al crear o actualizar un DMS",{"_2862":59060,"_25248":59033,"_17581":99621,"_5":17476,"_23883":99551,"_2389":99622},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_2862":59061,"_25248":59033,"_17581":99624,"_5":17476,"_23883":99551,"_2389":99625},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_2862":59062,"_25248":59033,"_17581":99627,"_5":17476,"_23883":99551,"_2389":99628},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_2862":59063,"_25248":59033,"_17581":99630,"_5":17476,"_23883":99551,"_2389":44564},[],{"_2862":59064,"_25248":59033,"_17581":99632,"_5":17476,"_23883":99551,"_2389":99633},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_2862":59065,"_25248":59033,"_17581":99635,"_5":17476,"_23883":99551,"_2389":44570},[],{"_2862":59066,"_25248":59033,"_17581":99637,"_5":17476,"_23883":99551,"_2389":99638},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_2862":59067,"_25248":59033,"_17581":99640,"_5":17476,"_23883":99551,"_2389":99641},[],"DMS propietario distinto",{"_2862":59068,"_25248":59033,"_17581":99643,"_5":17476,"_23883":99551,"_2389":99644},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_2862":59069,"_25248":59033,"_17581":99646,"_5":17476,"_23883":99551,"_2389":44582},[],{"_2862":59070,"_25248":59033,"_17581":99648,"_5":17476,"_23883":99551,"_2389":99649},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_2862":59071,"_25248":59033,"_17581":99651,"_5":17476,"_23883":99551,"_2389":44588},[],{"_2862":59072,"_25248":59033,"_17581":99653,"_5":17476,"_23883":99551,"_2389":99654},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_2862":59073,"_25248":59033,"_17581":99656,"_5":17476,"_23883":99551,"_2389":99657},[],"Certificado actual revocado",{"_2862":59074,"_25248":59033,"_17581":99659,"_5":17476,"_23883":99551,"_2389":99660},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_2862":59075,"_25248":59033,"_17581":99662,"_5":17476,"_23883":99551,"_2389":99663},[],"Error de CA, perfil o firma",{"_2862":59076,"_25248":59033,"_17581":99665,"_5":17476,"_23883":99551,"_2389":99666},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_2862":59077,"_25248":59033,"_17581":99668,"_5":17476,"_23883":99551,"_2389":99669},[],"HTTP 200 sin conexión del dispositivo",{"_2862":59078,"_25248":59033,"_17581":99671,"_5":17476,"_23883":99551,"_2389":99672},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_2862":59079,"_25248":59033,"_17581":99674,"_5":17476,"_23883":99551,"_2389":99675},[],"Timeout o error después de emitir",{"_2862":59080,"_25248":59033,"_17581":99677,"_5":17476,"_23883":99551,"_2389":99678},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_2862":59081,"_25248":59033,"_17581":99680,"_5":17476,"_23883":99555,"_2389":99681},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado tras una migración y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_2862":59082,"_25248":59033,"_17581":99683,"_5":17476,"_23883":99555,"_2389":99684},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_2862":59083,"_25248":59033,"_17581":99686,"_5":17476,"_23883":99558,"_2389":99687},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_2862":59084,"_25248":59033,"_17581":99689,"_5":17476,"_23883":99558,"_2389":99690},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_2862":59085,"_25248":59033,"_17581":99692,"_5":17476,"_23883":99558,"_2389":99693},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_2862":59086,"_25248":59033,"_17581":99695,"_5":17476,"_23883":99558,"_2389":99696},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_2862":59087,"_25248":59033,"_17581":99698,"_5":17476,"_23883":99558,"_2389":99699},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_2862":59088,"_25248":59033,"_17581":99701,"_5":17476,"_23883":99558,"_2389":99702},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_2862":59089,"_25248":59033,"_17581":99704,"_5":17476,"_23883":99558,"_2389":99705},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_2862":59090,"_25248":59090,"_5":12326,"_2389":99707,"_25584":99708,"_17581":99709,"_23883":59090},"Distribución y actualización de confianza",[40961,97440,43298,98412,98587],[],{"_2862":59091,"_25248":59090,"_17581":99711,"_5":17476,"_23883":59090,"_2389":99712},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_2862":59092,"_25248":59090,"_5":25581,"_17581":99714,"_23883":99715,"_2389":99716},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_2862":59093,"_25248":59090,"_5":25581,"_17581":99718,"_23883":99719,"_2389":99720},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_2862":59094,"_25248":59090,"_5":25581,"_17581":99722,"_23883":99723,"_2389":99724},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_2862":59095,"_25248":59090,"_5":25581,"_17581":99726,"_23883":99727,"_2389":99728},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_2862":59096,"_25248":59090,"_5":25581,"_17581":99730,"_23883":99731,"_2389":99732},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_2862":59097,"_25248":59090,"_17581":99734,"_5":17476,"_23883":59090,"_2389":99735},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_2862":59098,"_25248":59090,"_17581":99737,"_5":17476,"_23883":99715,"_2389":99738},[],"Relación",{"_2862":59099,"_25248":59090,"_17581":99740,"_5":17476,"_23883":99715,"_2389":99741},[],"Material que prepara el responsable",{"_2862":59100,"_25248":59090,"_17581":99743,"_5":17476,"_23883":99715,"_2389":99744},[],"Dispositivo → servidor EST",{"_2862":59101,"_25248":59090,"_17581":99746,"_5":17476,"_23883":99715,"_2389":99747},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_2862":59102,"_25248":59090,"_17581":99749,"_5":17476,"_23883":99715,"_2389":99750},[],"DMS → solicitante",{"_2862":59103,"_25248":59090,"_17581":99752,"_5":17476,"_23883":99715,"_2389":99753},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_2862":59104,"_25248":59090,"_17581":99755,"_5":17476,"_23883":99715,"_2389":99756},[],"Consumidor → dispositivo",{"_2862":59105,"_25248":59090,"_17581":99758,"_5":17476,"_23883":99715,"_2389":99759},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_2862":59106,"_25248":59090,"_17581":99761,"_5":17476,"_23883":99715,"_2389":99762},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_2862":59107,"_25248":59090,"_17581":99764,"_5":17476,"_23883":99719,"_2389":99765},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_2862":59108,"_25248":59090,"_17581":99767,"_5":17476,"_23883":99719,"_2389":99768},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_2862":59109,"_25248":59090,"_17581":99770,"_5":17476,"_23883":99723,"_2389":99771},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_2862":59110,"_25248":59090,"_17581":99773,"_5":17476,"_23883":99723,"_2389":99774},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_2862":59111,"_25248":59090,"_17581":99776,"_5":17476,"_23883":99723,"_2389":99777},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_2862":59112,"_25248":59090,"_17581":99779,"_5":17476,"_23883":99723,"_2389":99780},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_2862":59113,"_25248":59090,"_17581":99782,"_5":17476,"_23883":99723,"_2389":99783},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_2862":59114,"_25248":59090,"_17581":99785,"_5":17476,"_23883":99723,"_2389":99786},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_2862":59115,"_25248":59090,"_17581":99788,"_5":17476,"_23883":99727,"_2389":99789},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_2862":59116,"_25248":59090,"_17581":99791,"_5":17476,"_23883":99727,"_2389":99792},[],"En el DMS, separa las CAs distribuidas de `additional_validation_cas`, utilizadas para la credencial de reenrolamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_2862":59117,"_25248":59090,"_17581":99794,"_5":17476,"_23883":99727,"_2389":99795},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_2862":59118,"_25248":59090,"_17581":99797,"_5":17476,"_23883":99731,"_2389":99798},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_2862":59119,"_25248":59119,"_5":12326,"_2389":44737,"_25584":99800,"_17581":99802,"_23883":59119},[40961,97440,43298,98412,99801],"Integraciones",[],{"_2862":59120,"_25248":59119,"_17581":99804,"_5":17476,"_23883":59119,"_2389":99805},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_2862":59121,"_25248":59119,"_5":25581,"_17581":99807,"_23883":99808,"_2389":99809},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_2862":59122,"_25248":59119,"_5":25581,"_17581":99811,"_23883":99812,"_2389":99813},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_2862":59123,"_25248":59119,"_5":25581,"_17581":99815,"_23883":99816,"_2389":99817},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_2862":59124,"_25248":59119,"_5":25581,"_17581":99819,"_23883":99820,"_2389":99821},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_2862":59125,"_25248":59119,"_5":25581,"_17581":99823,"_23883":99824,"_2389":99825},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_2862":59126,"_25248":59119,"_5":25581,"_17581":99827,"_23883":99828,"_2389":99829},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_2862":59127,"_25248":59119,"_5":25581,"_17581":99831,"_23883":99832,"_2389":44771},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_2862":59128,"_25248":59119,"_5":25581,"_17581":99834,"_23883":99835,"_2389":44775},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_2862":59129,"_25248":59119,"_5":25581,"_17581":99837,"_23883":99838,"_2389":99839},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_2862":59130,"_25248":59119,"_5":25581,"_17581":99841,"_23883":99842,"_2389":99843},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_2862":59131,"_25248":59119,"_5":25581,"_17581":99845,"_23883":99846,"_2389":99847},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_2862":59132,"_25248":59119,"_5":25581,"_17581":99849,"_23883":99850,"_2389":99851},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_2862":59133,"_25248":59119,"_5":25581,"_17581":99853,"_23883":99854,"_2389":99855},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_2862":59134,"_25248":59119,"_5":25581,"_17581":99857,"_23883":99858,"_2389":99859},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_2862":59135,"_25248":59119,"_5":25581,"_17581":99861,"_23883":99862,"_2389":99863},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_2862":59136,"_25248":59119,"_5":25581,"_17581":99865,"_23883":99866,"_2389":99867},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_2862":59137,"_25248":59119,"_5":25581,"_17581":99869,"_23883":99870,"_2389":99871},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_2862":59138,"_25248":59119,"_5":25581,"_17581":99873,"_23883":99874,"_2389":99875},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_2862":59139,"_25248":59119,"_5":25581,"_17581":99877,"_23883":99878,"_2389":99879},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_2862":59140,"_25248":59119,"_5":25581,"_17581":99881,"_23883":99882,"_2389":99883},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_2862":59141,"_25248":59119,"_17581":99885,"_5":17476,"_23883":59119,"_2389":99886},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_2862":59142,"_25248":59119,"_17581":99888,"_5":17476,"_23883":59119,"_2389":99889},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_2862":59143,"_25248":59119,"_17581":99891,"_5":17476,"_23883":59119,"_2389":99892},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_2862":59144,"_25248":59119,"_17581":99894,"_5":17476,"_23883":99808,"_2389":99895},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_2862":59145,"_25248":59119,"_17581":99897,"_5":17476,"_23883":99808,"_2389":99898},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_2862":59146,"_25248":59119,"_17581":99900,"_5":17476,"_23883":99808,"_2389":99901},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_2862":59147,"_25248":59119,"_17581":99903,"_5":17476,"_23883":99808,"_2389":99904},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_2862":59148,"_25248":59119,"_17581":99906,"_5":17476,"_23883":99812,"_2389":99907},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_2862":59149,"_25248":59119,"_17581":99909,"_5":17476,"_23883":99816,"_2389":99910},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_2862":59150,"_25248":59119,"_17581":99912,"_5":17476,"_23883":99816,"_2389":99913},[],"Acción IAM",{"_2862":59151,"_25248":59119,"_17581":99915,"_5":17476,"_23883":99816,"_2389":96485},[],{"_2862":59152,"_25248":59119,"_17581":99917,"_5":17476,"_23883":99816,"_2389":44858},[],{"_2862":59153,"_25248":59119,"_17581":99919,"_5":17476,"_23883":99816,"_2389":99920},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_2862":59154,"_25248":59119,"_17581":99922,"_5":17476,"_23883":99816,"_2389":44864},[],{"_2862":59155,"_25248":59119,"_17581":99924,"_5":17476,"_23883":99816,"_2389":99925},[],"Registrar la CA en AWS IoT",{"_2862":59156,"_25248":59119,"_17581":99927,"_5":17476,"_23883":99816,"_2389":44870},[],{"_2862":59157,"_25248":59119,"_17581":99929,"_5":17476,"_23883":99816,"_2389":99930},[],"Consultar el estado del registro de la CA",{"_2862":59158,"_25248":59119,"_17581":99932,"_5":17476,"_23883":99816,"_2389":44876},[],{"_2862":59159,"_25248":59119,"_17581":99934,"_5":17476,"_23883":99816,"_2389":99935},[],"Crear o actualizar Things en IoT Core",{"_2862":59160,"_25248":59119,"_17581":99937,"_5":17476,"_23883":99816,"_2389":44882},[],{"_2862":59161,"_25248":59119,"_17581":99939,"_5":17476,"_23883":99816,"_2389":99940},[],"Aprovisionar Things mediante plantilla",{"_2862":59162,"_25248":59119,"_17581":99942,"_5":17476,"_23883":99816,"_2389":44888},[],{"_2862":59163,"_25248":59119,"_17581":99944,"_5":17476,"_23883":99816,"_2389":99945},[],"Registrar certificados de dispositivo",{"_2862":59164,"_25248":59119,"_17581":99947,"_5":17476,"_23883":99816,"_2389":44894},[],{"_2862":59165,"_25248":59119,"_17581":99949,"_5":17476,"_23883":99816,"_2389":99950},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_2862":59166,"_25248":59119,"_17581":99952,"_5":17476,"_23883":99816,"_2389":44900},[],{"_2862":59167,"_25248":59119,"_17581":99954,"_5":17476,"_23883":99816,"_2389":99955},[],"Crear y adjuntar políticas IoT",{"_2862":59168,"_25248":59119,"_17581":99957,"_5":17476,"_23883":99816,"_2389":44906},[],{"_2862":59169,"_25248":59119,"_17581":99959,"_5":17476,"_23883":99816,"_2389":99960},[],"Gestionar grupos de Things",{"_2862":59170,"_25248":59119,"_17581":99962,"_5":17476,"_23883":99816,"_2389":44912},[],{"_2862":59171,"_25248":59119,"_17581":99964,"_5":17476,"_23883":99816,"_2389":99965},[],"Crear plantillas JITP",{"_2862":59172,"_25248":59119,"_17581":99967,"_5":17476,"_23883":99816,"_2389":44918},[],{"_2862":59173,"_25248":59119,"_17581":99969,"_5":17476,"_23883":99816,"_2389":99970},[],"Leer y escribir el Device Shadow",{"_2862":59174,"_25248":59119,"_17581":99972,"_5":17476,"_23883":99816,"_2389":99973},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_2862":59175,"_25248":59119,"_17581":99975,"_5":17476,"_23883":99820,"_2389":99976},[],"Parámetro",{"_2862":59176,"_25248":59119,"_17581":99978,"_5":17476,"_23883":99820,"_2389":99979},[],"Tipo",{"_2862":59177,"_25248":59119,"_17581":99981,"_5":17476,"_23883":99820,"_2389":99982},[],"Requerido",{"_2862":59178,"_25248":59119,"_17581":99984,"_5":17476,"_23883":99820,"_2389":99985},[],"Descripción",{"_2862":59179,"_25248":59119,"_17581":99987,"_5":17476,"_23883":99820,"_2389":44939},[],{"_2862":59180,"_25248":59119,"_17581":99989,"_5":17476,"_23883":99820,"_2389":21013},[],{"_2862":59181,"_25248":59119,"_17581":99991,"_5":17476,"_23883":99820,"_2389":99992},[],"Sí",{"_2862":59182,"_25248":59119,"_17581":99994,"_5":17476,"_23883":99820,"_2389":99995},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_2862":59183,"_25248":59119,"_17581":99997,"_5":17476,"_23883":99820,"_2389":44950},[],{"_2862":59184,"_25248":59119,"_17581":99999,"_5":17476,"_23883":99820,"_2389":21013},[],{"_2862":59185,"_25248":59119,"_17581":100001,"_5":17476,"_23883":99820,"_2389":99992},[],{"_2862":59186,"_25248":59119,"_17581":100003,"_5":17476,"_23883":99820,"_2389":100004},[],"Región AWS donde opera el conector.",{"_2862":59187,"_25248":59119,"_17581":100006,"_5":17476,"_23883":99820,"_2389":44960},[],{"_2862":59188,"_25248":59119,"_17581":100008,"_5":17476,"_23883":99820,"_2389":21013},[],{"_2862":59189,"_25248":59119,"_17581":100010,"_5":17476,"_23883":99820,"_2389":99992},[],{"_2862":59190,"_25248":59119,"_17581":100012,"_5":17476,"_23883":99820,"_2389":100013},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_2862":59191,"_25248":59119,"_17581":100015,"_5":17476,"_23883":99820,"_2389":44970},[],{"_2862":59192,"_25248":59119,"_17581":100017,"_5":17476,"_23883":99820,"_2389":21013},[],{"_2862":59193,"_25248":59119,"_17581":100019,"_5":17476,"_23883":99820,"_2389":100020},[],"Solo con `auth_method=static`",{"_2862":59194,"_25248":59119,"_17581":100022,"_5":17476,"_23883":99820,"_2389":100023},[],"Clave de acceso AWS.",{"_2862":59195,"_25248":59119,"_17581":100025,"_5":17476,"_23883":99820,"_2389":44981},[],{"_2862":59196,"_25248":59119,"_17581":100027,"_5":17476,"_23883":99820,"_2389":21013},[],{"_2862":59197,"_25248":59119,"_17581":100029,"_5":17476,"_23883":99820,"_2389":100020},[],{"_2862":59198,"_25248":59119,"_17581":100031,"_5":17476,"_23883":99820,"_2389":100032},[],"Clave secreta AWS.",{"_2862":59199,"_25248":59119,"_17581":100034,"_5":17476,"_23883":99820,"_2389":44991},[],{"_2862":59200,"_25248":59119,"_17581":100036,"_5":17476,"_23883":99820,"_2389":21013},[],{"_2862":59201,"_25248":59119,"_17581":100038,"_5":17476,"_23883":99820,"_2389":44996},[],{"_2862":59202,"_25248":59119,"_17581":100040,"_5":17476,"_23883":99820,"_2389":100041},[],"Token de sesión (con `auth_method=static`).",{"_2862":59203,"_25248":59119,"_17581":100043,"_5":17476,"_23883":99820,"_2389":45002},[],{"_2862":59204,"_25248":59119,"_17581":100045,"_5":17476,"_23883":99820,"_2389":21013},[],{"_2862":59205,"_25248":59119,"_17581":100047,"_5":17476,"_23883":99820,"_2389":100048},[],"Solo con `auth_method=role`",{"_2862":59206,"_25248":59119,"_17581":100050,"_5":17476,"_23883":99820,"_2389":100051},[],"ARN del rol a asumir.",{"_2862":59207,"_25248":59119,"_17581":100053,"_5":17476,"_23883":99820,"_2389":45013},[],{"_2862":59208,"_25248":59119,"_17581":100055,"_5":17476,"_23883":99820,"_2389":21013},[],{"_2862":59209,"_25248":59119,"_17581":100057,"_5":17476,"_23883":99820,"_2389":44996},[],{"_2862":59210,"_25248":59119,"_17581":100059,"_5":17476,"_23883":99820,"_2389":100060},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_2862":59211,"_25248":59119,"_17581":100062,"_5":17476,"_23883":99820,"_2389":45023},[],{"_2862":59212,"_25248":59119,"_17581":100064,"_5":17476,"_23883":99820,"_2389":14769},[],{"_2862":59213,"_25248":59119,"_17581":100066,"_5":17476,"_23883":99820,"_2389":99992},[],{"_2862":59214,"_25248":59119,"_17581":100068,"_5":17476,"_23883":99820,"_2389":100069},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_2862":59215,"_25248":59119,"_17581":100071,"_5":17476,"_23883":99820,"_2389":45033},[],{"_2862":59216,"_25248":59119,"_17581":100073,"_5":17476,"_23883":99820,"_2389":21013},[],{"_2862":59217,"_25248":59119,"_17581":100075,"_5":17476,"_23883":99820,"_2389":99992},[],{"_2862":59218,"_25248":59119,"_17581":100077,"_5":17476,"_23883":99820,"_2389":100078},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_2862":59219,"_25248":59119,"_17581":100080,"_5":17476,"_23883":99820,"_2389":45043},[],{"_2862":59220,"_25248":59119,"_17581":100082,"_5":17476,"_23883":99820,"_2389":21013},[],{"_2862":59221,"_25248":59119,"_17581":100084,"_5":17476,"_23883":99820,"_2389":99992},[],{"_2862":59222,"_25248":59119,"_17581":100086,"_5":17476,"_23883":99820,"_2389":100087},[],"URL HTTP del Device Manager de Lamassu.",{"_2862":59223,"_25248":59119,"_17581":100089,"_5":17476,"_23883":99820,"_2389":45053},[],{"_2862":59224,"_25248":59119,"_17581":100091,"_5":17476,"_23883":99820,"_2389":21013},[],{"_2862":59225,"_25248":59119,"_17581":100093,"_5":17476,"_23883":99820,"_2389":99992},[],{"_2862":59226,"_25248":59119,"_17581":100095,"_5":17476,"_23883":99820,"_2389":100096},[],"URL HTTP del servicio de CA de Lamassu.",{"_2862":59227,"_25248":59119,"_17581":100098,"_5":17476,"_23883":99824,"_2389":100099},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_2862":59228,"_25248":59119,"_17581":100101,"_5":17476,"_23883":99828,"_2389":100102},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_2862":59229,"_25248":59119,"_17581":100104,"_5":17476,"_23883":99828,"_2389":100105},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_2862":59230,"_25248":59119,"_17581":100107,"_5":17476,"_23883":99832,"_2389":100108},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_2862":59231,"_25248":59119,"_17581":100110,"_5":17476,"_23883":99832,"_2389":100111},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_2862":59232,"_25248":59119,"_17581":100113,"_5":17476,"_23883":99832,"_2389":100114},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_2862":59233,"_25248":59119,"_17581":100116,"_5":17476,"_23883":99832,"_2389":100117},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_2862":59234,"_25248":59119,"_17581":100119,"_5":17476,"_23883":99832,"_2389":100120},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_2862":59235,"_25248":59119,"_17581":100122,"_5":17476,"_23883":99832,"_2389":100123},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_2862":59236,"_25248":59119,"_17581":100125,"_5":17476,"_23883":99835,"_2389":100126},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_2862":59237,"_25248":59119,"_17581":100128,"_5":17476,"_23883":99838,"_2389":100129},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_2862":59238,"_25248":59119,"_17581":100131,"_5":17476,"_23883":99838,"_2389":100132},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_2862":59239,"_25248":59119,"_17581":100134,"_5":17476,"_23883":99842,"_2389":100135},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_2862":59240,"_25248":59119,"_17581":100137,"_5":17476,"_23883":99846,"_2389":100138},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_2862":59241,"_25248":59119,"_17581":100140,"_5":17476,"_23883":99846,"_2389":100141},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_2862":59242,"_25248":59119,"_17581":100143,"_5":17476,"_23883":99846,"_2389":100144},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_2862":59243,"_25248":59119,"_17581":100146,"_5":17476,"_23883":99846,"_2389":100147},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_2862":59244,"_25248":59119,"_17581":100149,"_5":17476,"_23883":99846,"_2389":100150},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_2862":59245,"_25248":59119,"_17581":100152,"_5":17476,"_23883":99846,"_2389":100153},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_2862":59246,"_25248":59119,"_17581":100155,"_5":17476,"_23883":99850,"_2389":100156},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_2862":59247,"_25248":59119,"_17581":100158,"_5":17476,"_23883":99850,"_2389":100159},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_2862":59248,"_25248":59119,"_17581":100161,"_5":17476,"_23883":99850,"_2389":100162},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_2862":59249,"_25248":59119,"_17581":100164,"_5":17476,"_23883":99854,"_2389":100165},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_2862":59250,"_25248":59119,"_17581":100167,"_5":17476,"_23883":99854,"_2389":100168},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_2862":59251,"_25248":59119,"_17581":100170,"_5":17476,"_23883":99854,"_2389":100171},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_2862":59252,"_25248":59119,"_17581":100173,"_5":17476,"_23883":99858,"_2389":100174},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_2862":59253,"_25248":59119,"_17581":100176,"_5":17476,"_23883":99858,"_2389":100177},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_2862":59254,"_25248":59119,"_17581":100179,"_5":17476,"_23883":99858,"_2389":100180},[],"Para que el flujo JITP funcione correctamente:",{"_2862":59255,"_25248":59119,"_17581":100182,"_5":17476,"_23883":99858,"_2389":100183},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_2862":59256,"_25248":59119,"_17581":100185,"_5":17476,"_23883":99858,"_2389":100186},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_2862":59257,"_25248":59119,"_17581":100188,"_5":17476,"_23883":99858,"_2389":100189},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_2862":59258,"_25248":59119,"_17581":100191,"_5":17476,"_23883":99858,"_2389":100192},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_2862":59259,"_25248":59119,"_17581":100194,"_5":17476,"_23883":99862,"_2389":100195},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_2862":59260,"_25248":59119,"_17581":100197,"_5":17476,"_23883":99862,"_2389":100198},[],"Estado en Lamassu",{"_2862":59261,"_25248":59119,"_17581":100200,"_5":17476,"_23883":99862,"_2389":100201},[],"Razón de revocación",{"_2862":59262,"_25248":59119,"_17581":100203,"_5":17476,"_23883":99862,"_2389":100204},[],"Estado en AWS IoT Core",{"_2862":59263,"_25248":59119,"_17581":100206,"_5":17476,"_23883":99862,"_2389":45174},[],{"_2862":59264,"_25248":59119,"_17581":100208,"_5":17476,"_23883":99862,"_2389":100209},[],"Ninguna",{"_2862":59265,"_25248":59119,"_17581":100211,"_5":17476,"_23883":99862,"_2389":45180},[],{"_2862":59266,"_25248":59119,"_17581":100213,"_5":17476,"_23883":99862,"_2389":45183},[],{"_2862":59267,"_25248":59119,"_17581":100215,"_5":17476,"_23883":99862,"_2389":45186},[],{"_2862":59268,"_25248":59119,"_17581":100217,"_5":17476,"_23883":99862,"_2389":45189},[],{"_2862":59269,"_25248":59119,"_17581":100219,"_5":17476,"_23883":99862,"_2389":45183},[],{"_2862":59270,"_25248":59119,"_17581":100221,"_5":17476,"_23883":99862,"_2389":100222},[],"Cualquier otra razón",{"_2862":59271,"_25248":59119,"_17581":100224,"_5":17476,"_23883":99862,"_2389":45197},[],{"_2862":59272,"_25248":59119,"_17581":100226,"_5":17476,"_23883":99862,"_2389":100227},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_2862":59273,"_25248":59119,"_17581":100229,"_5":17476,"_23883":99866,"_2389":100230},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_2862":59274,"_25248":59119,"_17581":100232,"_5":17476,"_23883":99866,"_2389":100233},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_2862":59275,"_25248":59119,"_17581":100235,"_5":17476,"_23883":99866,"_2389":100236},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_2862":59276,"_25248":59119,"_17581":100238,"_5":17476,"_23883":99870,"_2389":100239},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_2862":59277,"_25248":59119,"_17581":100241,"_5":17476,"_23883":99870,"_2389":100242},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_2862":59278,"_25248":59119,"_17581":100244,"_5":17476,"_23883":99874,"_2389":100245},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_2862":59279,"_25248":59119,"_17581":100247,"_5":17476,"_23883":99874,"_2389":100248},[],"Existen dos tipos de acciones:",{"_2862":59280,"_25248":59119,"_17581":100250,"_5":17476,"_23883":99874,"_2389":100251},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_2862":59281,"_25248":59119,"_17581":100253,"_5":17476,"_23883":99874,"_2389":100254},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_2862":59282,"_25248":59119,"_17581":100256,"_5":17476,"_23883":99874,"_2389":100257},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_2862":59283,"_25248":59119,"_17581":100259,"_5":17476,"_23883":99878,"_2389":100260},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_2862":59284,"_25248":59119,"_17581":100262,"_5":17476,"_23883":99878,"_2389":100263},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_2862":59285,"_25248":59119,"_17581":100265,"_5":17476,"_23883":99878,"_2389":100266},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_2862":59286,"_25248":59119,"_17581":100268,"_5":17476,"_23883":99882,"_2389":100269},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_2862":59287,"_25248":59119,"_17581":100271,"_5":17476,"_23883":99882,"_2389":100272},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_2862":59288,"_25248":59119,"_17581":100274,"_5":17476,"_23883":99882,"_2389":100275},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_2862":59289,"_25248":59119,"_17581":100277,"_5":17476,"_23883":99882,"_2389":100278},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_2862":59290,"_25248":59119,"_17581":100280,"_5":17476,"_23883":99882,"_2389":100281},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_2862":59291,"_25248":59119,"_17581":100283,"_5":17476,"_23883":99882,"_2389":100284},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_2862":59292,"_25248":59119,"_17581":100286,"_5":17476,"_23883":99882,"_2389":100287},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_2862":59293,"_25248":59119,"_17581":100289,"_5":17476,"_23883":99882,"_2389":100290},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_2862":59294,"_25248":59119,"_17581":100292,"_5":17476,"_23883":99882,"_2389":100293},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_2862":59295,"_25248":59119,"_17581":100295,"_5":17476,"_23883":99882,"_2389":100296},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_2862":59296,"_25248":59119,"_17581":100298,"_5":17476,"_23883":99882,"_2389":100299},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_2862":59297,"_25248":59119,"_17581":100301,"_5":17476,"_23883":99882,"_2389":100302},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_2862":59298,"_25248":59119,"_17581":100304,"_5":17476,"_23883":99882,"_2389":100305},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_2862":59299,"_25248":59119,"_17581":100307,"_5":17476,"_23883":99882,"_2389":100308},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_2862":59300,"_25248":59119,"_17581":100310,"_5":17476,"_23883":99882,"_2389":100311},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_2862":59301,"_25248":59119,"_17581":100313,"_5":17476,"_23883":99882,"_2389":100314},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_2862":59302,"_25248":59119,"_17581":100316,"_5":17476,"_23883":99882,"_2389":100317},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_2862":59303,"_25248":59119,"_17581":100319,"_5":17476,"_23883":99882,"_2389":100320},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_2862":59304,"_25248":59119,"_17581":100322,"_5":17476,"_23883":99882,"_2389":100323},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2862":59305,"_25248":59119,"_17581":100325,"_5":17476,"_23883":99882,"_2389":100326},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2862":59306,"_25248":59119,"_17581":100328,"_5":17476,"_23883":99882,"_2389":100329},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_2862":59307,"_25248":59307,"_5":12326,"_2389":43298,"_25584":100331,"_17581":100332,"_23883":59307},[40961,97440,43298],[],{"_2862":59308,"_25248":59307,"_17581":100334,"_5":17476,"_23883":59307,"_2389":100335},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_2862":59309,"_25248":59307,"_5":25581,"_17581":100337,"_23883":100338,"_2389":100339},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_2862":59310,"_25248":59307,"_5":25581,"_17581":100341,"_23883":100342,"_2389":98412},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_2862":59311,"_25248":59307,"_5":25581,"_17581":100344,"_23883":100345,"_2389":98587},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_2862":59312,"_25248":59307,"_5":25581,"_17581":100347,"_23883":100348,"_2389":99801},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/overview#integraciones",{"_2862":59313,"_25248":59307,"_5":25581,"_17581":100350,"_23883":100351,"_2389":100352},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_2862":59314,"_25248":59307,"_17581":100354,"_5":17476,"_23883":59307,"_2389":100355},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_2862":59315,"_25248":59307,"_17581":100357,"_5":17476,"_23883":100338,"_2389":100358},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_2862":59316,"_25248":59307,"_17581":100360,"_5":17476,"_23883":100338,"_2389":100361},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_2862":59317,"_25248":59307,"_17581":100363,"_5":17476,"_23883":100342,"_2389":100364},[],"Recurso",{"_2862":59318,"_25248":59307,"_17581":100366,"_5":17476,"_23883":100342,"_2389":100367},[],"Qué representa",{"_2862":59319,"_25248":59307,"_17581":100369,"_5":17476,"_23883":100342,"_2389":100370},[],"**Dispositivo**",{"_2862":59320,"_25248":59307,"_17581":100372,"_5":17476,"_23883":100342,"_2389":100373},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_2862":59321,"_25248":59307,"_17581":100375,"_5":17476,"_23883":100342,"_2389":100376},[],"**Identidad**",{"_2862":59322,"_25248":59307,"_17581":100378,"_5":17476,"_23883":100342,"_2389":100379},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_2862":59323,"_25248":59307,"_17581":100381,"_5":17476,"_23883":100342,"_2389":45355},[],{"_2862":59324,"_25248":59307,"_17581":100383,"_5":17476,"_23883":100342,"_2389":100384},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_2862":59325,"_25248":59307,"_17581":100386,"_5":17476,"_23883":100342,"_2389":100387},[],"**Flota**",{"_2862":59326,"_25248":59307,"_17581":100389,"_5":17476,"_23883":100342,"_2389":100390},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_2862":59327,"_25248":59307,"_17581":100392,"_5":17476,"_23883":100342,"_2389":100393},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_2862":59328,"_25248":59307,"_17581":100395,"_5":17476,"_23883":100342,"_2389":100396},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_2862":59329,"_25248":59307,"_17581":100398,"_5":17476,"_23883":100345,"_2389":100399},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_2862":59330,"_25248":59307,"_17581":100401,"_5":17476,"_23883":100345,"_2389":100402},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_2862":59331,"_25248":59307,"_17581":100404,"_5":17476,"_23883":100345,"_2389":100405},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_2862":59332,"_25248":59307,"_17581":100407,"_5":17476,"_23883":100345,"_2389":100408},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_2862":59333,"_25248":59307,"_17581":100410,"_5":17476,"_23883":100345,"_2389":100411},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_2862":59334,"_25248":59307,"_17581":100413,"_5":17476,"_23883":100345,"_2389":100414},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_2862":59335,"_25248":59307,"_17581":100416,"_5":17476,"_23883":100345,"_2389":100417},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2862":59336,"_25248":59307,"_17581":100419,"_5":17476,"_23883":100345,"_2389":100420},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2862":59337,"_25248":59307,"_17581":100422,"_5":17476,"_23883":100348,"_2389":100423},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_2862":59338,"_25248":59307,"_17581":100425,"_5":17476,"_23883":100348,"_2389":100426},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_2862":59339,"_25248":59307,"_17581":100428,"_5":17476,"_23883":100351,"_2389":100429},[],"Participante",{"_2862":59340,"_25248":59307,"_17581":100431,"_5":17476,"_23883":100351,"_2389":100432},[],"Responsabilidad",{"_2862":59341,"_25248":59307,"_17581":100434,"_5":17476,"_23883":100351,"_2389":100435},[],"Administrador PKI",{"_2862":59342,"_25248":59307,"_17581":100437,"_5":17476,"_23883":100351,"_2389":100438},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_2862":59343,"_25248":59307,"_17581":100440,"_5":17476,"_23883":100351,"_2389":100441},[],"Administrador del aprovisionamiento",{"_2862":59344,"_25248":59307,"_17581":100443,"_5":17476,"_23883":100351,"_2389":100444},[],"DMS, admisión, autenticación por operación e inventario.",{"_2862":59345,"_25248":59307,"_17581":100446,"_5":17476,"_23883":100351,"_2389":100447},[],"Integrador del dispositivo",{"_2862":59346,"_25248":59307,"_17581":100449,"_5":17476,"_23883":100351,"_2389":100450},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_2862":59347,"_25248":59307,"_17581":100452,"_5":17476,"_23883":100351,"_2389":100453},[],"Integrador del consumidor",{"_2862":59348,"_25248":59307,"_17581":100455,"_5":17476,"_23883":100351,"_2389":100456},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_2862":59349,"_25248":59307,"_17581":100458,"_5":17476,"_23883":100351,"_2389":100459},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_2862":59350,"_25248":59350,"_5":12326,"_2389":100461,"_25584":100462,"_17581":100464,"_23883":59350},"Enrola y conecta tu primer dispositivo",[40961,97440,43298,100463],"Primeros pasos",[],{"_2862":59351,"_25248":59350,"_17581":100466,"_5":17476,"_23883":59350,"_2389":100467},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_2862":59352,"_25248":59350,"_5":25581,"_17581":100469,"_23883":100470,"_2389":96122},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_2862":59353,"_25248":59350,"_5":25581,"_17581":100472,"_23883":100473,"_2389":100474},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_2862":59354,"_25248":59350,"_5":25581,"_17581":100476,"_23883":100477,"_2389":100478},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_2862":59355,"_25248":59350,"_5":25581,"_17581":100480,"_23883":100481,"_2389":100482},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_2862":59356,"_25248":59350,"_5":25581,"_17581":100484,"_23883":100485,"_2389":100486},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_2862":59357,"_25248":59350,"_5":25581,"_17581":100488,"_23883":100489,"_2389":100490},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_2862":59358,"_25248":59350,"_5":25581,"_17581":100492,"_23883":100493,"_2389":100494},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_2862":59359,"_25248":59350,"_5":25581,"_17581":100496,"_23883":100497,"_2389":100498},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_2862":59360,"_25248":59350,"_17581":100500,"_5":17476,"_23883":59350,"_2389":100501},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_2862":59361,"_25248":59350,"_17581":100503,"_5":17476,"_23883":100470,"_2389":100504},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_2862":59362,"_25248":59350,"_17581":100506,"_5":17476,"_23883":100470,"_2389":100507},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_2862":59363,"_25248":59350,"_17581":100509,"_5":17476,"_23883":100470,"_2389":100510},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_2862":59364,"_25248":59350,"_17581":100512,"_5":17476,"_23883":100470,"_2389":100513},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_2862":59365,"_25248":59350,"_17581":100515,"_5":17476,"_23883":100470,"_2389":100516},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_2862":59366,"_25248":59350,"_17581":100518,"_5":17476,"_23883":100473,"_2389":100519},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_2862":59367,"_25248":59350,"_17581":100521,"_5":17476,"_23883":100473,"_2389":100522},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_2862":59368,"_25248":59350,"_17581":100524,"_5":17476,"_23883":100477,"_2389":100525},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_2862":59369,"_25248":59350,"_17581":100527,"_5":17476,"_23883":100477,"_2389":100528},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_2862":59370,"_25248":59350,"_17581":100530,"_5":17476,"_23883":100477,"_2389":100531},[],"Ajuste",{"_2862":59371,"_25248":59350,"_17581":100533,"_5":17476,"_23883":100477,"_2389":100534},[],"Valor de evaluación",{"_2862":59372,"_25248":59350,"_17581":100536,"_5":17476,"_23883":100477,"_2389":45511},[],{"_2862":59373,"_25248":59350,"_17581":100538,"_5":17476,"_23883":100477,"_2389":100539},[],"Raíz emisora de `device-root.pem`.",{"_2862":59374,"_25248":59350,"_17581":100541,"_5":17476,"_23883":100477,"_2389":98715},[],{"_2862":59375,"_25248":59350,"_17581":100543,"_5":17476,"_23883":100477,"_2389":100544},[],"Perfil final de 1 hora que acabas de preparar.",{"_2862":59376,"_25248":59350,"_17581":100546,"_5":17476,"_23883":100477,"_2389":45522},[],{"_2862":59377,"_25248":59350,"_17581":100548,"_5":17476,"_23883":100477,"_2389":45525},[],{"_2862":59378,"_25248":59350,"_17581":100550,"_5":17476,"_23883":100477,"_2389":45528},[],{"_2862":59379,"_25248":59350,"_17581":100552,"_5":17476,"_23883":100477,"_2389":100553},[],"Habilitado.",{"_2862":59380,"_25248":59350,"_17581":100555,"_5":17476,"_23883":100477,"_2389":45534},[],{"_2862":59381,"_25248":59350,"_17581":100557,"_5":17476,"_23883":100477,"_2389":100558},[],"Deshabilitado; el ID debe ser nuevo.",{"_2862":59382,"_25248":59350,"_17581":100560,"_5":17476,"_23883":100477,"_2389":100561},[],"Autenticación inicial",{"_2862":59383,"_25248":59350,"_17581":100563,"_5":17476,"_23883":100477,"_2389":100564},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_2862":59384,"_25248":59350,"_17581":100566,"_5":17476,"_23883":100477,"_2389":100567},[],"Autenticación de renovación",{"_2862":59385,"_25248":59350,"_17581":100569,"_5":17476,"_23883":100477,"_2389":100570},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_2862":59386,"_25248":59350,"_17581":100572,"_5":17476,"_23883":100477,"_2389":45552},[],{"_2862":59387,"_25248":59350,"_17581":100574,"_5":17476,"_23883":100477,"_2389":100575},[],"Lista vacía para esta emisión directa / deshabilitado.",{"_2862":59388,"_25248":59350,"_17581":100577,"_5":17476,"_23883":100477,"_2389":45558},[],{"_2862":59389,"_25248":59350,"_17581":100579,"_5":17476,"_23883":100477,"_2389":100580},[],"1 hora.",{"_2862":59390,"_25248":59350,"_17581":100582,"_5":17476,"_23883":100477,"_2389":45564},[],{"_2862":59391,"_25248":59350,"_17581":100584,"_5":17476,"_23883":100477,"_2389":100585},[],"30 minutos / 10 minutos.",{"_2862":59392,"_25248":59350,"_17581":100587,"_5":17476,"_23883":100477,"_2389":45570},[],{"_2862":59393,"_25248":59350,"_17581":100589,"_5":17476,"_23883":100477,"_2389":100590},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_2862":59394,"_25248":59350,"_17581":100592,"_5":17476,"_23883":100477,"_2389":43617},[],{"_2862":59395,"_25248":59350,"_17581":100594,"_5":17476,"_23883":100477,"_2389":100595},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_2862":59396,"_25248":59350,"_17581":100597,"_5":17476,"_23883":100477,"_2389":45581},[],{"_2862":59397,"_25248":59350,"_17581":100599,"_5":17476,"_23883":100477,"_2389":100600},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_2862":59398,"_25248":59350,"_17581":100602,"_5":17476,"_23883":100477,"_2389":100603},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_2862":59399,"_25248":59350,"_17581":100605,"_5":17476,"_23883":100481,"_2389":100606},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_2862":59400,"_25248":59350,"_17581":100608,"_5":17476,"_23883":100481,"_2389":100609},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_2862":59401,"_25248":59350,"_17581":100611,"_5":17476,"_23883":100485,"_2389":100612},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_2862":59402,"_25248":59350,"_17581":100614,"_5":17476,"_23883":100485,"_2389":100615},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_2862":59403,"_25248":59350,"_17581":100617,"_5":17476,"_23883":100485,"_2389":100618},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_2862":59404,"_25248":59350,"_17581":100620,"_5":17476,"_23883":100489,"_2389":100621},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_2862":59405,"_25248":59350,"_17581":100623,"_5":17476,"_23883":100489,"_2389":100624},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_2862":59406,"_25248":59350,"_17581":100626,"_5":17476,"_23883":100493,"_2389":100627},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_2862":59407,"_25248":59350,"_17581":100629,"_5":17476,"_23883":100493,"_2389":100630},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_2862":59408,"_25248":59350,"_17581":100632,"_5":17476,"_23883":100493,"_2389":100633},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_2862":59409,"_25248":59350,"_17581":100635,"_5":17476,"_23883":100493,"_2389":100636},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_2862":59410,"_25248":59350,"_17581":100638,"_5":17476,"_23883":100493,"_2389":100639},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_2862":59411,"_25248":59350,"_17581":100641,"_5":17476,"_23883":100497,"_2389":100642},[],"Comprobación",{"_2862":59412,"_25248":59350,"_17581":100644,"_5":17476,"_23883":100497,"_2389":100645},[],"Resultado esperado",{"_2862":59413,"_25248":59350,"_17581":100647,"_5":17476,"_23883":100497,"_2389":100648},[],"Registro",{"_2862":59414,"_25248":59350,"_17581":100650,"_5":17476,"_23883":100497,"_2389":100651},[],"ID creado automáticamente y DMS correcto.",{"_2862":59415,"_25248":59350,"_17581":100653,"_5":17476,"_23883":100497,"_2389":100654},[],"Certificado",{"_2862":59416,"_25248":59350,"_17581":100656,"_5":17476,"_23883":100497,"_2389":100657},[],"CN, perfil, serie y clave verificados.",{"_2862":59417,"_25248":59350,"_17581":100659,"_5":17476,"_23883":100497,"_2389":100660},[],"Inventario",{"_2862":59418,"_25248":59350,"_17581":100662,"_5":17476,"_23883":100497,"_2389":100663},[],"Serie recibida visible como identidad actual y en el historial.",{"_2862":59419,"_25248":59350,"_17581":100665,"_5":17476,"_23883":100497,"_2389":100666},[],"Consumidor",{"_2862":59420,"_25248":59350,"_17581":100668,"_5":17476,"_23883":100497,"_2389":100669},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_2862":59421,"_25248":59350,"_17581":100671,"_5":17476,"_23883":100497,"_2389":100672},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_2862":59422,"_25248":59350,"_17581":100674,"_5":17476,"_23883":100497,"_2389":100675},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_2862":59423,"_25248":59423,"_5":12326,"_2389":98429,"_25584":100677,"_17581":100678,"_23883":59423},[40961,97440,43298,100463],[],{"_2862":59424,"_25248":59423,"_17581":100680,"_5":17476,"_23883":59423,"_2389":100681},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_2862":59425,"_25248":59423,"_5":25581,"_17581":100683,"_23883":100684,"_2389":96122},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_2862":59426,"_25248":59423,"_5":25581,"_17581":100686,"_23883":100687,"_2389":100688},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_2862":59427,"_25248":59423,"_5":25581,"_17581":100690,"_23883":100691,"_2389":100692},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_2862":59428,"_25248":59423,"_5":25581,"_17581":100694,"_23883":100695,"_2389":100696},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_2862":59429,"_25248":59423,"_5":25581,"_17581":100698,"_23883":100699,"_2389":100700},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_2862":59430,"_25248":59423,"_5":25581,"_17581":100702,"_23883":100703,"_2389":100704},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_2862":59431,"_25248":59423,"_5":25581,"_17581":100706,"_23883":100707,"_2389":100645},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_2862":59432,"_25248":59423,"_5":25581,"_17581":100709,"_23883":100710,"_2389":100711},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_2862":59433,"_25248":59423,"_5":25581,"_17581":100713,"_23883":100714,"_2389":100715},[],"/docs/pr-preview/pr-45/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_2862":59434,"_25248":59423,"_17581":100717,"_5":17476,"_23883":59423,"_2389":100718},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_2862":59435,"_25248":59423,"_17581":100720,"_5":17476,"_23883":59423,"_2389":100721},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_2862":59436,"_25248":59423,"_17581":100723,"_5":17476,"_23883":100684,"_2389":100724},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_2862":59437,"_25248":59423,"_17581":100726,"_5":17476,"_23883":100684,"_2389":100727},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_2862":59438,"_25248":59423,"_17581":100729,"_5":17476,"_23883":100684,"_2389":100730},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_2862":59439,"_25248":59423,"_17581":100732,"_5":17476,"_23883":100684,"_2389":100733},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_2862":59440,"_25248":59423,"_17581":100735,"_5":17476,"_23883":100687,"_2389":100736},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_2862":59441,"_25248":59423,"_17581":100738,"_5":17476,"_23883":100687,"_2389":100739},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_2862":59442,"_25248":59423,"_17581":100741,"_5":17476,"_23883":100687,"_2389":100742},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_2862":59443,"_25248":59423,"_17581":100744,"_5":17476,"_23883":100687,"_2389":100745},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_2862":59444,"_25248":59423,"_17581":100747,"_5":17476,"_23883":100687,"_2389":100748},[],"Configura **Authentication Mode** como `CLIENT_CERTIFICATE` y añade en **Validation CAs** la CA cuyos certificados iniciales aceptarás. Para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deshabilitada la generación de claves en servidor si no la vas a utilizar.",{"_2862":59445,"_25248":59423,"_17581":100750,"_5":17476,"_23883":100687,"_2389":100751},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_2862":59446,"_25248":59423,"_17581":100753,"_5":17476,"_23883":100687,"_2389":100754},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_2862":59447,"_25248":59423,"_17581":100756,"_5":17476,"_23883":100687,"_2389":100757},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_2862":59448,"_25248":59423,"_17581":100759,"_5":17476,"_23883":100691,"_2389":100760},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_2862":59449,"_25248":59423,"_17581":100762,"_5":17476,"_23883":100691,"_2389":45747},[],{"_2862":59450,"_25248":59423,"_17581":100764,"_5":17476,"_23883":100691,"_2389":100765},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_2862":59451,"_25248":59423,"_17581":100767,"_5":17476,"_23883":100691,"_2389":100768},[],"**Icon** y **Tags**: clasificación opcional.",{"_2862":59452,"_25248":59423,"_17581":100770,"_5":17476,"_23883":100691,"_2389":100771},[],"Confirma el registro.",{"_2862":59453,"_25248":59423,"_17581":100773,"_5":17476,"_23883":100695,"_2389":100774},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_2862":59454,"_25248":59423,"_17581":100776,"_5":17476,"_23883":100695,"_2389":100777},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_2862":59455,"_25248":59423,"_17581":100779,"_5":17476,"_23883":100699,"_2389":100780},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_2862":59456,"_25248":59423,"_17581":100782,"_5":17476,"_23883":100699,"_2389":100783},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_2862":59457,"_25248":59423,"_17581":100785,"_5":17476,"_23883":100703,"_2389":100786},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_2862":59458,"_25248":59423,"_17581":100788,"_5":17476,"_23883":100703,"_2389":100789},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_2862":59459,"_25248":59423,"_17581":100791,"_5":17476,"_23883":100707,"_2389":100642},[],{"_2862":59460,"_25248":59423,"_17581":100793,"_5":17476,"_23883":100707,"_2389":100794},[],"Resultado",{"_2862":59461,"_25248":59423,"_17581":100796,"_5":17476,"_23883":100707,"_2389":100797},[],"Dispositivo",{"_2862":59462,"_25248":59423,"_17581":100799,"_5":17476,"_23883":100707,"_2389":100800},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_2862":59463,"_25248":59423,"_17581":100802,"_5":17476,"_23883":100707,"_2389":100803},[],"Identidad actual",{"_2862":59464,"_25248":59423,"_17581":100805,"_5":17476,"_23883":100707,"_2389":100806},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_2862":59465,"_25248":59423,"_17581":100808,"_5":17476,"_23883":100707,"_2389":100809},[],"Historial",{"_2862":59466,"_25248":59423,"_17581":100811,"_5":17476,"_23883":100707,"_2389":100812},[],"La emisión asociada aparece con su número de serie y fechas.",{"_2862":59467,"_25248":59423,"_17581":100814,"_5":17476,"_23883":100707,"_2389":100815},[],"Clave y certificado",{"_2862":59468,"_25248":59423,"_17581":100817,"_5":17476,"_23883":100707,"_2389":100818},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_2862":59469,"_25248":59423,"_17581":100820,"_5":17476,"_23883":100710,"_2389":100821},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_2862":59470,"_25248":59423,"_17581":100823,"_5":17476,"_23883":100710,"_2389":100824},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_2862":59471,"_25248":59423,"_17581":100826,"_5":17476,"_23883":100710,"_2389":100827},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_2862":59472,"_25248":59423,"_17581":100829,"_5":17476,"_23883":100710,"_2389":100830},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_2862":59473,"_25248":59423,"_17581":100832,"_5":17476,"_23883":100714,"_2389":100833},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_2862":59474,"_25248":59423,"_17581":100835,"_5":17476,"_23883":100714,"_2389":100836},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_2862":59475,"_25248":59423,"_17581":100838,"_5":17476,"_23883":100714,"_2389":100839},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_2862":59476,"_25248":59476,"_5":12326,"_2389":100841,"_25584":100842,"_17581":100843,"_23883":59476},"Plataforma Lamassu IoT",[40961,97440],[],{"_2862":59477,"_25248":59476,"_17581":100845,"_5":17476,"_23883":59476,"_2389":100846},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_2862":59478,"_25248":59476,"_5":25581,"_17581":100848,"_23883":100849,"_2389":100339},[],"/docs/pr-preview/pr-45/es/platform/overview#empieza-aquí",{"_2862":59479,"_25248":59476,"_5":25581,"_17581":100851,"_23883":100852,"_2389":100853},[],"/docs/pr-preview/pr-45/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_2862":59480,"_25248":59476,"_5":25581,"_17581":100855,"_23883":100856,"_2389":100857},[],"/docs/pr-preview/pr-45/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_2862":59481,"_25248":59476,"_5":25581,"_17581":100859,"_23883":100860,"_2389":100861},[],"/docs/pr-preview/pr-45/es/platform/overview#capacidades-principales","Capacidades principales",{"_2862":59482,"_25248":59476,"_5":25581,"_17581":100863,"_23883":100864,"_2389":100865},[],"/docs/pr-preview/pr-45/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_2862":59483,"_25248":59476,"_5":25581,"_17581":100867,"_23883":100868,"_2389":100869},[],"/docs/pr-preview/pr-45/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_2862":59484,"_25248":59476,"_5":25581,"_17581":100871,"_23883":100872,"_2389":100873},[],"/docs/pr-preview/pr-45/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_2862":59485,"_25248":59476,"_5":25581,"_17581":100875,"_23883":100876,"_2389":100877},[],"/docs/pr-preview/pr-45/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_2862":59486,"_25248":59476,"_5":25581,"_17581":100879,"_23883":100880,"_2389":100881},[],"/docs/pr-preview/pr-45/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_2862":59487,"_25248":59476,"_5":25581,"_17581":100883,"_23883":100884,"_2389":100885},[],"/docs/pr-preview/pr-45/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_2862":59488,"_25248":59476,"_5":25581,"_17581":100887,"_23883":100888,"_2389":100889},[],"/docs/pr-preview/pr-45/es/platform/overview#referencia-operativa","Referencia operativa",{"_2862":59489,"_25248":59476,"_17581":100891,"_5":17476,"_23883":59476,"_2389":100892},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_2862":59490,"_25248":59476,"_17581":100894,"_5":17476,"_23883":100849,"_2389":100895},[],"Elige el resultado que necesitas obtener:",{"_2862":59491,"_25248":59476,"_17581":100897,"_5":17476,"_23883":100849,"_2389":100898},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2862":59492,"_25248":59476,"_17581":100900,"_5":17476,"_23883":100849,"_2389":100901},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2862":59493,"_25248":59476,"_17581":100903,"_5":17476,"_23883":100849,"_2389":100904},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_2862":59494,"_25248":59476,"_17581":100906,"_5":17476,"_23883":100852,"_2389":100907},[],"Bloque",{"_2862":59495,"_25248":59476,"_17581":100909,"_5":17476,"_23883":100852,"_2389":100910},[],"Qué gestionas",{"_2862":59496,"_25248":59476,"_17581":100912,"_5":17476,"_23883":100852,"_2389":100913},[],"Punto de entrada",{"_2862":59497,"_25248":59476,"_17581":100915,"_5":17476,"_23883":100852,"_2389":45901},[],{"_2862":59498,"_25248":59476,"_17581":100917,"_5":17476,"_23883":100852,"_2389":100918},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_2862":59499,"_25248":59476,"_17581":100920,"_5":17476,"_23883":100852,"_2389":100921},[],"Visión general de PKI",{"_2862":59500,"_25248":59476,"_17581":100923,"_5":17476,"_23883":100852,"_2389":45910},[],{"_2862":59501,"_25248":59476,"_17581":100925,"_5":17476,"_23883":100852,"_2389":100926},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_2862":59502,"_25248":59476,"_17581":100928,"_5":17476,"_23883":100852,"_2389":100929},[],"Visión general de IoT Fleets",{"_2862":59503,"_25248":59476,"_17581":100931,"_5":17476,"_23883":100852,"_2389":100932},[],"**Administración**",{"_2862":59504,"_25248":59476,"_17581":100934,"_5":17476,"_23883":100852,"_2389":100935},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_2862":59505,"_25248":59476,"_17581":100937,"_5":17476,"_23883":100852,"_2389":97438},[],{"_2862":59506,"_25248":59476,"_17581":100939,"_5":17476,"_23883":100852,"_2389":100940},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_2862":59507,"_25248":59476,"_17581":100942,"_5":17476,"_23883":100856,"_2389":100943},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_2862":59508,"_25248":59476,"_17581":100945,"_5":17476,"_23883":100856,"_2389":100946},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_2862":59509,"_25248":59476,"_17581":100948,"_5":17476,"_23883":100856,"_2389":100949},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_2862":59510,"_25248":59476,"_17581":100951,"_5":17476,"_23883":100856,"_2389":100952},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_2862":59511,"_25248":59476,"_17581":100954,"_5":17476,"_23883":100856,"_2389":100955},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_2862":59512,"_25248":59476,"_17581":100957,"_5":17476,"_23883":100856,"_2389":100958},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_2862":59513,"_25248":59476,"_17581":100960,"_5":17476,"_23883":100864,"_2389":100961},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_2862":59514,"_25248":59476,"_17581":100963,"_5":17476,"_23883":100868,"_2389":100964},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_2862":59515,"_25248":59476,"_17581":100966,"_5":17476,"_23883":100872,"_2389":100967},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_2862":59516,"_25248":59476,"_17581":100969,"_5":17476,"_23883":100876,"_2389":100970},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_2862":59517,"_25248":59476,"_17581":100972,"_5":17476,"_23883":100880,"_2389":100973},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_2862":59518,"_25248":59476,"_17581":100975,"_5":17476,"_23883":100884,"_2389":100976},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_2862":59519,"_25248":59476,"_17581":100978,"_5":17476,"_23883":100888,"_2389":100432},[],{"_2862":59520,"_25248":59476,"_17581":100980,"_5":17476,"_23883":100888,"_2389":100981},[],"Qué prepara o comprueba",{"_2862":59521,"_25248":59476,"_17581":100983,"_5":17476,"_23883":100888,"_2389":100435},[],{"_2862":59522,"_25248":59476,"_17581":100985,"_5":17476,"_23883":100888,"_2389":100986},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_2862":59523,"_25248":59476,"_17581":100988,"_5":17476,"_23883":100888,"_2389":100989},[],"Administrador de la flota",{"_2862":59524,"_25248":59476,"_17581":100991,"_5":17476,"_23883":100888,"_2389":100992},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_2862":59525,"_25248":59476,"_17581":100994,"_5":17476,"_23883":100888,"_2389":100447},[],{"_2862":59526,"_25248":59476,"_17581":100996,"_5":17476,"_23883":100888,"_2389":100997},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_2862":59527,"_25248":59476,"_17581":100999,"_5":17476,"_23883":100888,"_2389":100453},[],{"_2862":59528,"_25248":59476,"_17581":101001,"_5":17476,"_23883":100888,"_2389":101002},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_2862":59529,"_25248":59476,"_17581":101004,"_5":17476,"_23883":100888,"_2389":101005},[],"Operador de infraestructura",{"_2862":59530,"_25248":59476,"_17581":101007,"_5":17476,"_23883":100888,"_2389":101008},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_2862":59531,"_25248":59476,"_17581":101010,"_5":17476,"_23883":100888,"_2389":101011},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_2862":59532,"_25248":59532,"_5":12326,"_2389":101013,"_25584":101014,"_17581":101016,"_23883":59532},"Jerarquía y rotación de CAs",[40961,97440,46002,101015],"Claves, autoridades y certificados",[],{"_2862":59533,"_25248":59532,"_17581":101018,"_5":17476,"_23883":59532,"_2389":101019},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_2862":59534,"_25248":59532,"_5":25581,"_17581":101021,"_23883":101022,"_2389":101023},[],"/docs/pr-preview/pr-45/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_2862":59535,"_25248":59532,"_5":25581,"_17581":101025,"_23883":101026,"_2389":101027},[],"/docs/pr-preview/pr-45/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_2862":59536,"_25248":59532,"_5":25581,"_17581":101029,"_23883":101030,"_2389":101031},[],"/docs/pr-preview/pr-45/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_2862":59537,"_25248":59532,"_5":25581,"_17581":101033,"_23883":101034,"_2389":101035},[],"/docs/pr-preview/pr-45/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_2862":59538,"_25248":59532,"_5":25581,"_17581":101037,"_23883":101038,"_2389":101039},[],"/docs/pr-preview/pr-45/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_2862":59539,"_25248":59532,"_5":25581,"_17581":101041,"_23883":101042,"_2389":101043},[],"/docs/pr-preview/pr-45/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_2862":59540,"_25248":59532,"_5":25581,"_17581":101045,"_23883":101046,"_2389":101047},[],"/docs/pr-preview/pr-45/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_2862":59541,"_25248":59532,"_5":25581,"_17581":101049,"_23883":101050,"_2389":101051},[],"/docs/pr-preview/pr-45/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_2862":59542,"_25248":59532,"_5":25581,"_17581":101053,"_23883":101054,"_2389":101055},[],"/docs/pr-preview/pr-45/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_2862":59543,"_25248":59532,"_5":25581,"_17581":101057,"_23883":101058,"_2389":101059},[],"/docs/pr-preview/pr-45/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_2862":59544,"_25248":59532,"_5":25581,"_17581":101061,"_23883":101062,"_2389":101063},[],"/docs/pr-preview/pr-45/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_2862":59545,"_25248":59532,"_5":25581,"_17581":101065,"_23883":101066,"_2389":101067},[],"/docs/pr-preview/pr-45/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_2862":59546,"_25248":59532,"_17581":101069,"_5":17476,"_23883":59532,"_2389":101070},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_2862":59547,"_25248":59532,"_17581":101072,"_5":17476,"_23883":59532,"_2389":101073},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_2862":59548,"_25248":59532,"_17581":101075,"_5":17476,"_23883":101022,"_2389":101076},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_2862":59549,"_25248":59532,"_17581":101078,"_5":17476,"_23883":101022,"_2389":101079},[],"entorno, como producción y preproducción;",{"_2862":59550,"_25248":59532,"_17581":101081,"_5":17476,"_23883":101022,"_2389":101082},[],"propietario o equipo operador;",{"_2862":59551,"_25248":59532,"_17581":101084,"_5":17476,"_23883":101022,"_2389":101085},[],"familia de dispositivos o proceso de fabricación;",{"_2862":59552,"_25248":59532,"_17581":101087,"_5":17476,"_23883":101022,"_2389":101088},[],"región o requisito regulatorio;",{"_2862":59553,"_25248":59532,"_17581":101090,"_5":17476,"_23883":101022,"_2389":101091},[],"motor criptográfico o política de clave;",{"_2862":59554,"_25248":59532,"_17581":101093,"_5":17476,"_23883":101022,"_2389":101094},[],"ventana de mantenimiento y ritmo de renovación.",{"_2862":59555,"_25248":59532,"_17581":101096,"_5":17476,"_23883":101022,"_2389":101097},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_2862":59556,"_25248":59532,"_17581":101099,"_5":17476,"_23883":101022,"_2389":101100},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_2862":59557,"_25248":59532,"_17581":101102,"_5":17476,"_23883":101026,"_2389":101103},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_2862":59558,"_25248":59532,"_17581":101105,"_5":17476,"_23883":101026,"_2389":101106},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_2862":59559,"_25248":59532,"_17581":101108,"_5":17476,"_23883":101026,"_2389":101109},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_2862":59560,"_25248":59532,"_17581":101111,"_5":17476,"_23883":101030,"_2389":101112},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_2862":59561,"_25248":59532,"_17581":101114,"_5":17476,"_23883":101030,"_2389":101115},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_2862":59562,"_25248":59532,"_17581":101117,"_5":17476,"_23883":101030,"_2389":101118},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_2862":59563,"_25248":59532,"_17581":101120,"_5":17476,"_23883":101030,"_2389":101121},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_2862":59564,"_25248":59532,"_17581":101123,"_5":17476,"_23883":101038,"_2389":101124},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_2862":59565,"_25248":59532,"_17581":101126,"_5":17476,"_23883":101042,"_2389":101127},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_2862":59566,"_25248":59532,"_17581":101129,"_5":17476,"_23883":101046,"_2389":101130},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_2862":59567,"_25248":59532,"_17581":101132,"_5":17476,"_23883":101050,"_2389":101133},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mantén las CAs de validación adicionales si todavía deben aceptarse certificados antiguos durante el re-enrolamiento.",{"_2862":59568,"_25248":59532,"_17581":101135,"_5":17476,"_23883":101054,"_2389":101136},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_2862":59569,"_25248":59532,"_17581":101138,"_5":17476,"_23883":101058,"_2389":101139},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_2862":59570,"_25248":59532,"_17581":101141,"_5":17476,"_23883":101062,"_2389":101142},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_2862":59571,"_25248":59532,"_17581":101144,"_5":17476,"_23883":101062,"_2389":101145},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_2862":59572,"_25248":59532,"_17581":101147,"_5":17476,"_23883":101062,"_2389":101148},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_2862":59573,"_25248":59532,"_17581":101150,"_5":17476,"_23883":101062,"_2389":101151},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_2862":59574,"_25248":59532,"_17581":101153,"_5":17476,"_23883":101066,"_2389":101154},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_2862":59575,"_25248":59532,"_17581":101156,"_5":17476,"_23883":101066,"_2389":101157},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_2862":59576,"_25248":59532,"_17581":101159,"_5":17476,"_23883":101066,"_2389":101160},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_2862":59577,"_25248":59532,"_17581":101162,"_5":17476,"_23883":101066,"_2389":101163},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_2862":59578,"_25248":59532,"_17581":101165,"_5":17476,"_23883":101066,"_2389":101166},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_2862":59579,"_25248":59532,"_17581":101168,"_5":17476,"_23883":101066,"_2389":101169},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_2862":59580,"_25248":59532,"_17581":101171,"_5":17476,"_23883":101066,"_2389":101172},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_2862":59581,"_25248":59581,"_5":12326,"_2389":101174,"_25584":101175,"_17581":101176,"_23883":59581},"Autoridades de certificación",[40961,97440,46002,101015],[],{"_2862":59582,"_25248":59581,"_17581":101178,"_5":17476,"_23883":59581,"_2389":101179},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_2862":59583,"_25248":59581,"_5":25581,"_17581":101181,"_23883":101182,"_2389":101183},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_2862":59584,"_25248":59581,"_5":25581,"_17581":101185,"_23883":101186,"_2389":101187},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_2862":59585,"_25248":59581,"_5":25581,"_17581":101189,"_23883":101190,"_2389":96122},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#antes-de-empezar",{"_2862":59586,"_25248":59581,"_5":25581,"_17581":101192,"_23883":101193,"_2389":101194},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_2862":59587,"_25248":59581,"_5":25581,"_17581":101196,"_23883":101197,"_2389":101198},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_2862":59588,"_25248":59581,"_5":25581,"_17581":101200,"_23883":101201,"_2389":101202},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_2862":59589,"_25248":59581,"_5":25581,"_17581":101204,"_23883":101205,"_2389":101206},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_2862":59590,"_25248":59581,"_5":25581,"_17581":101208,"_23883":101209,"_2389":101210},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_2862":59591,"_25248":59581,"_5":25581,"_17581":101212,"_23883":101213,"_2389":101214},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_2862":59592,"_25248":59581,"_5":25581,"_17581":101216,"_23883":101217,"_2389":101218},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_2862":59593,"_25248":59581,"_5":25581,"_17581":101220,"_23883":101221,"_2389":101222},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_2862":59594,"_25248":59581,"_5":25581,"_17581":101224,"_23883":101225,"_2389":101226},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_2862":59595,"_25248":59581,"_5":25581,"_17581":101228,"_23883":101229,"_2389":101230},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_2862":59596,"_25248":59581,"_5":25581,"_17581":101232,"_23883":101233,"_2389":101234},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_2862":59597,"_25248":59581,"_5":25581,"_17581":101236,"_23883":101237,"_2389":101238},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_2862":59598,"_25248":59581,"_5":25581,"_17581":101240,"_23883":101241,"_2389":101242},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_2862":59599,"_25248":59581,"_5":25581,"_17581":101244,"_23883":101245,"_2389":101246},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_2862":59600,"_25248":59581,"_5":25581,"_17581":101248,"_23883":101249,"_2389":101250},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_2862":59601,"_25248":59581,"_5":25581,"_17581":101252,"_23883":101253,"_2389":101254},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_2862":59602,"_25248":59581,"_5":25581,"_17581":101256,"_23883":101257,"_2389":101258},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_2862":59603,"_25248":59581,"_5":25581,"_17581":101260,"_23883":101261,"_2389":101262},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_2862":59604,"_25248":59581,"_5":25581,"_17581":101264,"_23883":101265,"_2389":101266},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_2862":59605,"_25248":59581,"_17581":101268,"_5":17476,"_23883":59581,"_2389":101269},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_2862":59606,"_25248":59581,"_17581":101271,"_5":17476,"_23883":59581,"_2389":101272},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_2862":59607,"_25248":59581,"_17581":101274,"_5":17476,"_23883":59581,"_2389":101275},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_2862":59608,"_25248":59581,"_17581":101277,"_5":17476,"_23883":101182,"_2389":101278},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_2862":59609,"_25248":59581,"_17581":101280,"_5":17476,"_23883":101182,"_2389":101281},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_2862":59610,"_25248":59581,"_17581":101283,"_5":17476,"_23883":101182,"_2389":101284},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_2862":59611,"_25248":59581,"_17581":101286,"_5":17476,"_23883":101182,"_2389":101287},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_2862":59612,"_25248":59581,"_17581":101289,"_5":17476,"_23883":101182,"_2389":101290},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_2862":59613,"_25248":59581,"_17581":101292,"_5":17476,"_23883":101190,"_2389":101293},[],"Decide si la CA será raíz o intermedia.",{"_2862":59614,"_25248":59581,"_17581":101295,"_5":17476,"_23883":101190,"_2389":101296},[],"Elige el motor que custodiará la clave.",{"_2862":59615,"_25248":59581,"_17581":101298,"_5":17476,"_23883":101190,"_2389":101299},[],"Define una validez superior a la de los certificados que emitirá.",{"_2862":59616,"_25248":59581,"_17581":101301,"_5":17476,"_23883":101190,"_2389":101302},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_2862":59617,"_25248":59581,"_17581":101304,"_5":17476,"_23883":101193,"_2389":101305},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_2862":59618,"_25248":59581,"_17581":101307,"_5":17476,"_23883":101197,"_2389":101308},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_2862":59619,"_25248":59581,"_17581":101310,"_5":17476,"_23883":101197,"_2389":101311},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_2862":59620,"_25248":59581,"_17581":101313,"_5":17476,"_23883":101201,"_2389":101314},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_2862":59621,"_25248":59581,"_17581":101316,"_5":17476,"_23883":101205,"_2389":101317},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_2862":59622,"_25248":59581,"_17581":101319,"_5":17476,"_23883":101205,"_2389":101320},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_2862":59623,"_25248":59581,"_17581":101322,"_5":17476,"_23883":101205,"_2389":101323},[],"`ST`: estado o provincia.",{"_2862":59624,"_25248":59581,"_17581":101325,"_5":17476,"_23883":101205,"_2389":101326},[],"`L`: localidad.",{"_2862":59625,"_25248":59581,"_17581":101328,"_5":17476,"_23883":101205,"_2389":101329},[],"`O`: organización.",{"_2862":59626,"_25248":59581,"_17581":101331,"_5":17476,"_23883":101205,"_2389":101332},[],"`OU`: unidad organizativa.",{"_2862":59627,"_25248":59581,"_17581":101334,"_5":17476,"_23883":101205,"_2389":101335},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_2862":59628,"_25248":59581,"_17581":101337,"_5":17476,"_23883":101209,"_2389":101338},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_2862":59629,"_25248":59581,"_17581":101340,"_5":17476,"_23883":101209,"_2389":101341},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_2862":59630,"_25248":59581,"_17581":101343,"_5":17476,"_23883":101213,"_2389":101344},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_2862":59631,"_25248":59581,"_17581":101346,"_5":17476,"_23883":101213,"_2389":101347},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_2862":59632,"_25248":59581,"_17581":101349,"_5":17476,"_23883":101217,"_2389":101350},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_2862":59633,"_25248":59581,"_17581":101352,"_5":17476,"_23883":101217,"_2389":101353},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_2862":59634,"_25248":59581,"_17581":101355,"_5":17476,"_23883":101221,"_2389":101356},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_2862":59635,"_25248":59581,"_17581":101358,"_5":17476,"_23883":101225,"_2389":101359},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_2862":59636,"_25248":59581,"_17581":101361,"_5":17476,"_23883":101229,"_2389":101362},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_2862":59637,"_25248":59581,"_17581":101364,"_5":17476,"_23883":101233,"_2389":101365},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_2862":59638,"_25248":59581,"_17581":101367,"_5":17476,"_23883":101237,"_2389":101368},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_2862":59639,"_25248":59581,"_17581":101370,"_5":17476,"_23883":101237,"_2389":101371},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_2862":59640,"_25248":59581,"_17581":101373,"_5":17476,"_23883":101241,"_2389":101374},[],"Abre una CA desde el inventario para consultar:",{"_2862":59641,"_25248":59581,"_17581":101376,"_5":17476,"_23883":101241,"_2389":101377},[],"Estado y periodo de validez.",{"_2862":59642,"_25248":59581,"_17581":101379,"_5":17476,"_23883":101241,"_2389":101380},[],"Certificado y cadena en formato PEM.",{"_2862":59643,"_25248":59581,"_17581":101382,"_5":17476,"_23883":101241,"_2389":101383},[],"Número de certificados activos, expirados y revocados.",{"_2862":59644,"_25248":59581,"_17581":101385,"_5":17476,"_23883":101241,"_2389":101386},[],"Certificados emitidos en **Issued Certificates**.",{"_2862":59645,"_25248":59581,"_17581":101388,"_5":17476,"_23883":101241,"_2389":101389},[],"CRL vinculada a la autoridad.",{"_2862":59646,"_25248":59581,"_17581":101391,"_5":17476,"_23883":101241,"_2389":101392},[],"Metadatos y motor criptográfico asociado.",{"_2862":59647,"_25248":59581,"_17581":101394,"_5":17476,"_23883":101241,"_2389":101395},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_2862":59648,"_25248":59581,"_17581":101397,"_5":17476,"_23883":101245,"_2389":101398},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_2862":59649,"_25248":59581,"_17581":101400,"_5":17476,"_23883":101245,"_2389":101401},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_2862":59650,"_25248":59581,"_17581":101403,"_5":17476,"_23883":101245,"_2389":101404},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_2862":59651,"_25248":59581,"_17581":101406,"_5":17476,"_23883":101245,"_2389":101407},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_2862":59652,"_25248":59581,"_17581":101409,"_5":17476,"_23883":101249,"_2389":101410},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_2862":59653,"_25248":59581,"_17581":101412,"_5":17476,"_23883":101253,"_2389":101413},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_2862":59654,"_25248":59581,"_17581":101415,"_5":17476,"_23883":101257,"_2389":101416},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_2862":59655,"_25248":59581,"_17581":101418,"_5":17476,"_23883":101261,"_2389":101419},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_2862":59656,"_25248":59581,"_17581":101421,"_5":17476,"_23883":101265,"_2389":101422},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_2862":59657,"_25248":59581,"_17581":101424,"_5":17476,"_23883":101265,"_2389":101425},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_2862":59658,"_25248":59658,"_5":12326,"_2389":101427,"_25584":101428,"_17581":101429,"_23883":59658},"Perfiles de certificado",[40961,97440,46002,101015],[],{"_2862":59659,"_25248":59658,"_17581":101431,"_5":17476,"_23883":59658,"_2389":101432},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_2862":59660,"_25248":59658,"_5":25581,"_17581":101434,"_23883":101435,"_2389":101436},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_2862":59661,"_25248":59658,"_5":25581,"_17581":101438,"_23883":101439,"_2389":101440},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-profiles#validez","Validez",{"_2862":59662,"_25248":59658,"_5":25581,"_17581":101442,"_23883":101443,"_2389":101444},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_2862":59663,"_25248":59658,"_5":25581,"_17581":101446,"_23883":101447,"_2389":101448},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_2862":59664,"_25248":59658,"_5":25581,"_17581":101450,"_23883":101451,"_2389":101452},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_2862":59665,"_25248":59658,"_5":25581,"_17581":101454,"_23883":101455,"_2389":101456},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_2862":59666,"_25248":59658,"_5":25581,"_17581":101458,"_23883":101459,"_2389":101460},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_2862":59667,"_25248":59658,"_5":25581,"_17581":101462,"_23883":101463,"_2389":101464},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_2862":59668,"_25248":59658,"_5":25581,"_17581":101466,"_23883":101467,"_2389":101468},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_2862":59669,"_25248":59658,"_5":25581,"_17581":101470,"_23883":101471,"_2389":101472},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_2862":59670,"_25248":59658,"_5":25581,"_17581":101474,"_23883":101475,"_2389":101476},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_2862":59671,"_25248":59658,"_5":25581,"_17581":101478,"_23883":101479,"_2389":101480},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_2862":59672,"_25248":59658,"_5":25581,"_17581":101482,"_23883":101483,"_2389":101484},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_2862":59673,"_25248":59658,"_5":25581,"_17581":101486,"_23883":101487,"_2389":101488},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_2862":59674,"_25248":59658,"_5":25581,"_17581":101490,"_23883":101491,"_2389":101492},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_2862":59675,"_25248":59658,"_5":25581,"_17581":101494,"_23883":101495,"_2389":101496},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_2862":59676,"_25248":59658,"_17581":101498,"_5":17476,"_23883":59658,"_2389":101499},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_2862":59677,"_25248":59658,"_17581":101501,"_5":17476,"_23883":59658,"_2389":101502},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_2862":59678,"_25248":59658,"_17581":101504,"_5":17476,"_23883":101439,"_2389":101505},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_2862":59679,"_25248":59658,"_17581":101507,"_5":17476,"_23883":101439,"_2389":101508},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_2862":59680,"_25248":59658,"_17581":101510,"_5":17476,"_23883":101443,"_2389":101511},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_2862":59681,"_25248":59658,"_17581":101513,"_5":17476,"_23883":101447,"_2389":101514},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_2862":59682,"_25248":59658,"_17581":101516,"_5":17476,"_23883":101447,"_2389":101517},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_2862":59683,"_25248":59658,"_17581":101519,"_5":17476,"_23883":101447,"_2389":101520},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_2862":59684,"_25248":59658,"_17581":101522,"_5":17476,"_23883":101451,"_2389":101523},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_2862":59685,"_25248":59658,"_17581":101525,"_5":17476,"_23883":101455,"_2389":101526},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_2862":59686,"_25248":59658,"_17581":101528,"_5":17476,"_23883":101455,"_2389":101529},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_2862":59687,"_25248":59658,"_17581":101531,"_5":17476,"_23883":101459,"_2389":101532},[],"La aplicación criptográfica puede:",{"_2862":59688,"_25248":59658,"_17581":101534,"_5":17476,"_23883":101459,"_2389":101535},[],"permitir o bloquear claves RSA;",{"_2862":59689,"_25248":59658,"_17581":101537,"_5":17476,"_23883":101459,"_2389":101538},[],"limitar los tamaños RSA admitidos;",{"_2862":59690,"_25248":59658,"_17581":101540,"_5":17476,"_23883":101459,"_2389":101541},[],"permitir o bloquear claves ECDSA;",{"_2862":59691,"_25248":59658,"_17581":101543,"_5":17476,"_23883":101459,"_2389":101544},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_2862":59692,"_25248":59658,"_17581":101546,"_5":17476,"_23883":101459,"_2389":101547},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_2862":59693,"_25248":59658,"_17581":101549,"_5":17476,"_23883":101463,"_2389":101550},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_2862":59694,"_25248":59658,"_17581":101552,"_5":17476,"_23883":101463,"_2389":97231},[],{"_2862":59695,"_25248":59658,"_17581":101554,"_5":17476,"_23883":101463,"_2389":101555},[],"Primera opción",{"_2862":59696,"_25248":59658,"_17581":101557,"_5":17476,"_23883":101463,"_2389":101558},[],"Segunda opción",{"_2862":59697,"_25248":59658,"_17581":101560,"_5":17476,"_23883":101463,"_2389":101561},[],"Si no hay ninguna",{"_2862":59698,"_25248":59658,"_17581":101563,"_5":17476,"_23883":101463,"_2389":101564},[],"Firma directa con una CA",{"_2862":59699,"_25248":59658,"_17581":101566,"_5":17476,"_23883":101463,"_2389":101567},[],"`issuance_profile` incluido en la solicitud",{"_2862":59700,"_25248":59658,"_17581":101569,"_5":17476,"_23883":101463,"_2389":101570},[],"`issuance_profile_id` de la solicitud",{"_2862":59701,"_25248":59658,"_17581":101572,"_5":17476,"_23883":101463,"_2389":101573},[],"Perfil predeterminado de la CA (`profile_id`).",{"_2862":59702,"_25248":59658,"_17581":101575,"_5":17476,"_23883":101463,"_2389":101576},[],"Emisión mediante DMS",{"_2862":59703,"_25248":59658,"_17581":101578,"_5":17476,"_23883":101463,"_2389":46567},[],{"_2862":59704,"_25248":59658,"_17581":101580,"_5":17476,"_23883":101463,"_2389":101581},[],"`settings.issuance_profile` incluido en el DMS",{"_2862":59705,"_25248":59658,"_17581":101583,"_5":17476,"_23883":101463,"_2389":101584},[],"Perfil predeterminado de la CA de enrolamiento.",{"_2862":59706,"_25248":59658,"_17581":101586,"_5":17476,"_23883":101463,"_2389":101587},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_2862":59707,"_25248":59658,"_17581":101589,"_5":17476,"_23883":101463,"_2389":101590},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_2862":59708,"_25248":59658,"_17581":101592,"_5":17476,"_23883":101471,"_2389":101593},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_2862":59709,"_25248":59658,"_17581":101595,"_5":17476,"_23883":101475,"_2389":101596},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_2862":59710,"_25248":59658,"_17581":101598,"_5":17476,"_23883":101479,"_2389":101599},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_2862":59711,"_25248":59658,"_17581":101601,"_5":17476,"_23883":101483,"_2389":101602},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_2862":59712,"_25248":59658,"_17581":101604,"_5":17476,"_23883":101487,"_2389":101605},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_2862":59713,"_25248":59658,"_17581":101607,"_5":17476,"_23883":101487,"_2389":101608},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_2862":59714,"_25248":59658,"_17581":101610,"_5":17476,"_23883":101491,"_2389":101611},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_2862":59715,"_25248":59658,"_17581":101613,"_5":17476,"_23883":101491,"_2389":101614},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_2862":59716,"_25248":59658,"_17581":101616,"_5":17476,"_23883":101491,"_2389":101617},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_2862":59717,"_25248":59658,"_17581":101619,"_5":17476,"_23883":101491,"_2389":101620},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_2862":59718,"_25248":59658,"_17581":101622,"_5":17476,"_23883":101495,"_2389":101623},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_2862":59719,"_25248":59658,"_17581":101625,"_5":17476,"_23883":101495,"_2389":101626},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_2862":59720,"_25248":59720,"_5":12326,"_2389":101628,"_25584":101629,"_17581":101631,"_23883":59720},"Validación de certificados",[40961,97440,46002,101630],"Validación",[],{"_2862":59721,"_25248":59720,"_17581":101633,"_5":17476,"_23883":59720,"_2389":101634},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_2862":59722,"_25248":59720,"_5":25581,"_17581":101636,"_23883":101637,"_2389":101638},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_2862":59723,"_25248":59720,"_5":25581,"_17581":101640,"_23883":101641,"_2389":101642},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_2862":59724,"_25248":59720,"_5":25581,"_17581":101644,"_23883":101645,"_2389":101646},[],"/docs/pr-preview/pr-45/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_2862":59725,"_25248":59720,"_17581":101648,"_5":17476,"_23883":59720,"_2389":101649},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_2862":59726,"_25248":59720,"_17581":101651,"_5":17476,"_23883":101637,"_2389":101652},[],"Verifica estos criterios juntos:",{"_2862":59727,"_25248":59720,"_17581":101654,"_5":17476,"_23883":101637,"_2389":100642},[],{"_2862":59728,"_25248":59720,"_17581":101656,"_5":17476,"_23883":101637,"_2389":101657},[],"Resultado necesario",{"_2862":59729,"_25248":59720,"_17581":101659,"_5":17476,"_23883":101637,"_2389":101660},[],"Cadena y firma",{"_2862":59730,"_25248":59720,"_17581":101662,"_5":17476,"_23883":101637,"_2389":101663},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_2862":59731,"_25248":59720,"_17581":101665,"_5":17476,"_23883":101637,"_2389":101666},[],"Fechas",{"_2862":59732,"_25248":59720,"_17581":101668,"_5":17476,"_23883":101637,"_2389":101669},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_2862":59733,"_25248":59720,"_17581":101671,"_5":17476,"_23883":101637,"_2389":97144},[],{"_2862":59734,"_25248":59720,"_17581":101673,"_5":17476,"_23883":101637,"_2389":101674},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_2862":59735,"_25248":59720,"_17581":101676,"_5":17476,"_23883":101637,"_2389":101677},[],"Uso",{"_2862":59736,"_25248":59720,"_17581":101679,"_5":17476,"_23883":101637,"_2389":101680},[],"KU, EKU y restricciones permiten la operación concreta.",{"_2862":59737,"_25248":59720,"_17581":101682,"_5":17476,"_23883":101637,"_2389":101683},[],"Revocación",{"_2862":59738,"_25248":59720,"_17581":101685,"_5":17476,"_23883":101637,"_2389":101686},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_2862":59739,"_25248":59720,"_17581":101688,"_5":17476,"_23883":101637,"_2389":101689},[],"Autorización",{"_2862":59740,"_25248":59720,"_17581":101691,"_5":17476,"_23883":101637,"_2389":101692},[],"La aplicación permite la acción a esa identidad.",{"_2862":59741,"_25248":59720,"_17581":101694,"_5":17476,"_23883":101637,"_2389":101695},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_2862":59742,"_25248":59720,"_17581":101697,"_5":17476,"_23883":101641,"_2389":101698},[],"Mecanismo",{"_2862":59743,"_25248":59720,"_17581":101700,"_5":17476,"_23883":101641,"_2389":101701},[],"Cuándo utilizarlo",{"_2862":59744,"_25248":59720,"_17581":101703,"_5":17476,"_23883":101641,"_2389":101704},[],"Qué debes mantener",{"_2862":59745,"_25248":59720,"_17581":101706,"_5":17476,"_23883":101641,"_2389":46695},[],{"_2862":59746,"_25248":59720,"_17581":101708,"_5":17476,"_23883":101641,"_2389":101709},[],"Consulta del estado de un certificado concreto.",{"_2862":59747,"_25248":59720,"_17581":101711,"_5":17476,"_23883":101641,"_2389":101712},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_2862":59748,"_25248":59720,"_17581":101714,"_5":17476,"_23883":101641,"_2389":46704},[],{"_2862":59749,"_25248":59720,"_17581":101716,"_5":17476,"_23883":101641,"_2389":101717},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_2862":59750,"_25248":59720,"_17581":101719,"_5":17476,"_23883":101641,"_2389":101720},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_2862":59751,"_25248":59720,"_17581":101722,"_5":17476,"_23883":101641,"_2389":101723},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_2862":59752,"_25248":59720,"_17581":101725,"_5":17476,"_23883":101641,"_2389":101726},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_2862":59753,"_25248":59720,"_17581":101728,"_5":17476,"_23883":101645,"_2389":101729},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_2862":59754,"_25248":59720,"_17581":101731,"_5":17476,"_23883":101645,"_2389":101732},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_2862":59755,"_25248":59720,"_17581":101734,"_5":17476,"_23883":101645,"_2389":101735},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_2862":59756,"_25248":59720,"_17581":101737,"_5":17476,"_23883":101645,"_2389":101738},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_2862":59757,"_25248":59720,"_17581":101740,"_5":17476,"_23883":101645,"_2389":101741},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_2862":59758,"_25248":59720,"_17581":101743,"_5":17476,"_23883":101645,"_2389":101744},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_2862":59759,"_25248":59720,"_17581":101746,"_5":17476,"_23883":101645,"_2389":101747},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_2862":59760,"_25248":59720,"_17581":101749,"_5":17476,"_23883":101645,"_2389":101750},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_2862":59761,"_25248":59720,"_17581":101752,"_5":17476,"_23883":101645,"_2389":101753},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_2862":59762,"_25248":59762,"_5":12326,"_2389":101755,"_25584":101756,"_17581":101757,"_23883":59762},"Certificados",[40961,97440,46002,101015],[],{"_2862":59763,"_25248":59762,"_17581":101759,"_5":17476,"_23883":59762,"_2389":101760},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_2862":59764,"_25248":59762,"_5":25581,"_17581":101762,"_23883":101763,"_2389":101764},[],"/docs/pr-preview/pr-45/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_2862":59765,"_25248":59762,"_5":25581,"_17581":101766,"_23883":101767,"_2389":101768},[],"/docs/pr-preview/pr-45/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_2862":59766,"_25248":59762,"_5":25581,"_17581":101770,"_23883":101771,"_2389":101772},[],"/docs/pr-preview/pr-45/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_2862":59767,"_25248":59762,"_5":25581,"_17581":101774,"_23883":101775,"_2389":101776},[],"/docs/pr-preview/pr-45/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_2862":59768,"_25248":59762,"_5":25581,"_17581":101778,"_23883":101779,"_2389":101780},[],"/docs/pr-preview/pr-45/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_2862":59769,"_25248":59762,"_5":25581,"_17581":101782,"_23883":101783,"_2389":101784},[],"/docs/pr-preview/pr-45/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_2862":59770,"_25248":59762,"_5":25581,"_17581":101786,"_23883":101787,"_2389":101788},[],"/docs/pr-preview/pr-45/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_2862":59771,"_25248":59762,"_5":25581,"_17581":101790,"_23883":101791,"_2389":101792},[],"/docs/pr-preview/pr-45/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_2862":59772,"_25248":59762,"_5":25581,"_17581":101794,"_23883":101795,"_2389":101796},[],"/docs/pr-preview/pr-45/es/platform/pki/certificates#continúa","Continúa",{"_2862":59773,"_25248":59762,"_17581":101798,"_5":17476,"_23883":59762,"_2389":101799},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_2862":59774,"_25248":59762,"_17581":101801,"_5":17476,"_23883":101763,"_2389":101802},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_2862":59775,"_25248":59762,"_17581":101804,"_5":17476,"_23883":101763,"_2389":101805},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_2862":59776,"_25248":59762,"_17581":101807,"_5":17476,"_23883":101767,"_2389":101808},[],"Descarga el PEM e inspecciónalo:",{"_2862":59777,"_25248":59762,"_17581":101810,"_5":17476,"_23883":101767,"_2389":101811},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_2862":59778,"_25248":59762,"_17581":101813,"_5":17476,"_23883":101771,"_2389":101814},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_2862":59779,"_25248":59762,"_17581":101816,"_5":17476,"_23883":101771,"_2389":101817},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_2862":59780,"_25248":59762,"_17581":101819,"_5":17476,"_23883":101771,"_2389":101820},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_2862":59781,"_25248":59762,"_17581":101822,"_5":17476,"_23883":101771,"_2389":101823},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_2862":59782,"_25248":59762,"_17581":101825,"_5":17476,"_23883":101771,"_2389":101826},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_2862":59783,"_25248":59762,"_17581":101828,"_5":17476,"_23883":101771,"_2389":101829},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_2862":59784,"_25248":59762,"_17581":101831,"_5":17476,"_23883":101771,"_2389":101832},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_2862":59785,"_25248":59762,"_17581":101834,"_5":17476,"_23883":101775,"_2389":101835},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_2862":59786,"_25248":59762,"_17581":101837,"_5":17476,"_23883":101779,"_2389":101838},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_2862":59787,"_25248":59762,"_17581":101840,"_5":17476,"_23883":101783,"_2389":101841},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_2862":59788,"_25248":59762,"_17581":101843,"_5":17476,"_23883":101787,"_2389":101844},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_2862":59789,"_25248":59762,"_17581":101846,"_5":17476,"_23883":101787,"_2389":101847},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_2862":59790,"_25248":59762,"_17581":101849,"_5":17476,"_23883":101787,"_2389":101850},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_2862":59791,"_25248":59762,"_17581":101852,"_5":17476,"_23883":101791,"_2389":101853},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_2862":59792,"_25248":59762,"_17581":101855,"_5":17476,"_23883":101791,"_2389":101856},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_2862":59793,"_25248":59762,"_17581":101858,"_5":17476,"_23883":101791,"_2389":101859},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_2862":59794,"_25248":59762,"_17581":101861,"_5":17476,"_23883":101795,"_2389":101862},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_2862":59795,"_25248":59762,"_17581":101864,"_5":17476,"_23883":101795,"_2389":101865},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_2862":59796,"_25248":59796,"_5":12326,"_2389":101867,"_25584":101868,"_17581":101870,"_23883":59796},"Ciclo de vida de un certificado",[40961,97440,46002,101869],"Conceptos",[],{"_2862":59797,"_25248":59796,"_17581":101872,"_5":17476,"_23883":59796,"_2389":101873},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_2862":59798,"_25248":59796,"_5":25581,"_17581":101875,"_23883":101876,"_2389":101877},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_2862":59799,"_25248":59796,"_5":25581,"_17581":101879,"_23883":101880,"_2389":101881},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_2862":59800,"_25248":59796,"_5":25581,"_17581":101883,"_23883":101884,"_2389":101885},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_2862":59801,"_25248":59796,"_5":25581,"_17581":101887,"_23883":101888,"_2389":101889},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_2862":59802,"_25248":59796,"_5":25581,"_17581":101891,"_23883":101892,"_2389":101893},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_2862":59803,"_25248":59796,"_5":25581,"_17581":101895,"_23883":101896,"_2389":101897},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_2862":59804,"_25248":59796,"_5":25581,"_17581":101899,"_23883":101900,"_2389":101901},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_2862":59805,"_25248":59796,"_5":25581,"_17581":101903,"_23883":101904,"_2389":101905},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_2862":59806,"_25248":59796,"_5":25581,"_17581":101907,"_23883":101908,"_2389":101909},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_2862":59807,"_25248":59796,"_5":25581,"_17581":101911,"_23883":101912,"_2389":101913},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_2862":59808,"_25248":59796,"_17581":101915,"_5":17476,"_23883":59796,"_2389":101916},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_2862":59809,"_25248":59796,"_17581":101918,"_5":17476,"_23883":101880,"_2389":101919},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_2862":59810,"_25248":59796,"_17581":101921,"_5":17476,"_23883":101884,"_2389":101922},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_2862":59811,"_25248":59796,"_17581":101924,"_5":17476,"_23883":101888,"_2389":101925},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_2862":59812,"_25248":59796,"_17581":101927,"_5":17476,"_23883":101892,"_2389":101928},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_2862":59813,"_25248":59796,"_17581":101930,"_5":17476,"_23883":101896,"_2389":101931},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_2862":59814,"_25248":59796,"_17581":101933,"_5":17476,"_23883":101900,"_2389":101934},[],"Lamassu persiste cuatro estados X.509:",{"_2862":59815,"_25248":59796,"_17581":101936,"_5":17476,"_23883":101900,"_2389":101937},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_2862":59816,"_25248":59796,"_17581":101939,"_5":17476,"_23883":101900,"_2389":101940},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_2862":59817,"_25248":59796,"_17581":101942,"_5":17476,"_23883":101900,"_2389":101943},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_2862":59818,"_25248":59796,"_17581":101945,"_5":17476,"_23883":101900,"_2389":101946},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_2862":59819,"_25248":59796,"_17581":101948,"_5":17476,"_23883":101900,"_2389":101949},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_2862":59820,"_25248":59796,"_17581":101951,"_5":17476,"_23883":101904,"_2389":101952},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_2862":59821,"_25248":59796,"_17581":101954,"_5":17476,"_23883":101904,"_2389":101955},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_2862":59822,"_25248":59796,"_17581":101957,"_5":17476,"_23883":101904,"_2389":101958},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_2862":59823,"_25248":59796,"_17581":101960,"_5":17476,"_23883":101908,"_2389":101961},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_2862":59824,"_25248":59796,"_17581":101963,"_5":17476,"_23883":101908,"_2389":101964},[],"Antes de confirmar:",{"_2862":59825,"_25248":59796,"_17581":101966,"_5":17476,"_23883":101908,"_2389":101967},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_2862":59826,"_25248":59796,"_17581":101969,"_5":17476,"_23883":101908,"_2389":101970},[],"Distribuye la nueva cadena de confianza.",{"_2862":59827,"_25248":59796,"_17581":101972,"_5":17476,"_23883":101908,"_2389":101973},[],"Reemite las identidades necesarias.",{"_2862":59828,"_25248":59796,"_17581":101975,"_5":17476,"_23883":101908,"_2389":101976},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_2862":59829,"_25248":59796,"_17581":101978,"_5":17476,"_23883":101908,"_2389":101979},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_2862":59830,"_25248":59796,"_17581":101981,"_5":17476,"_23883":101908,"_2389":101982},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_2862":59831,"_25248":59796,"_17581":101984,"_5":17476,"_23883":101912,"_2389":101985},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_2862":59832,"_25248":59796,"_17581":101987,"_5":17476,"_23883":101912,"_2389":101988},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_2862":59833,"_25248":59796,"_17581":101990,"_5":17476,"_23883":101912,"_2389":101991},[],"Cambios de estado y razones de revocación.",{"_2862":59834,"_25248":59796,"_17581":101993,"_5":17476,"_23883":101912,"_2389":101994},[],"Publicación y vigencia de OCSP y CRLs.",{"_2862":59835,"_25248":59796,"_17581":101996,"_5":17476,"_23883":101912,"_2389":101997},[],"Dependencias que todavía presentan un certificado sustituido.",{"_2862":59836,"_25248":59796,"_17581":101999,"_5":17476,"_23883":101912,"_2389":102000},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_2862":59837,"_25248":59837,"_5":12326,"_2389":102002,"_25584":102003,"_17581":102004,"_23883":59837},"Modelo de confianza",[40961,97440,46002,101869],[],{"_2862":59838,"_25248":59837,"_17581":102006,"_5":17476,"_23883":59837,"_2389":102007},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_2862":59839,"_25248":59837,"_5":25581,"_17581":102009,"_23883":102010,"_2389":102011},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_2862":59840,"_25248":59837,"_5":25581,"_17581":102013,"_23883":102014,"_2389":102015},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_2862":59841,"_25248":59837,"_5":25581,"_17581":102017,"_23883":102018,"_2389":102019},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_2862":59842,"_25248":59837,"_5":25581,"_17581":102021,"_23883":102022,"_2389":102023},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_2862":59843,"_25248":59837,"_5":25581,"_17581":102025,"_23883":102026,"_2389":102027},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_2862":59844,"_25248":59837,"_5":25581,"_17581":102029,"_23883":102030,"_2389":102031},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_2862":59845,"_25248":59837,"_5":25581,"_17581":102033,"_23883":102034,"_2389":102035},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_2862":59846,"_25248":59837,"_5":25581,"_17581":102037,"_23883":102038,"_2389":102039},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_2862":59847,"_25248":59837,"_5":25581,"_17581":102041,"_23883":102042,"_2389":102043},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_2862":59848,"_25248":59837,"_5":25581,"_17581":102045,"_23883":102046,"_2389":102047},[],"/docs/pr-preview/pr-45/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_2862":59849,"_25248":59837,"_17581":102049,"_5":17476,"_23883":59837,"_2389":102050},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_2862":59850,"_25248":59837,"_17581":102052,"_5":17476,"_23883":102014,"_2389":102053},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_2862":59851,"_25248":59837,"_17581":102055,"_5":17476,"_23883":102018,"_2389":102056},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_2862":59852,"_25248":59837,"_17581":102058,"_5":17476,"_23883":102022,"_2389":102059},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_2862":59853,"_25248":59837,"_17581":102061,"_5":17476,"_23883":102026,"_2389":102062},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_2862":59854,"_25248":59837,"_17581":102064,"_5":17476,"_23883":102030,"_2389":102065},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_2862":59855,"_25248":59837,"_17581":102067,"_5":17476,"_23883":102030,"_2389":102068},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_2862":59856,"_25248":59837,"_17581":102070,"_5":17476,"_23883":102030,"_2389":102071},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_2862":59857,"_25248":59837,"_17581":102073,"_5":17476,"_23883":102030,"_2389":102074},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_2862":59858,"_25248":59837,"_17581":102076,"_5":17476,"_23883":102030,"_2389":102077},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_2862":59859,"_25248":59837,"_17581":102079,"_5":17476,"_23883":102030,"_2389":102080},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_2862":59860,"_25248":59837,"_17581":102082,"_5":17476,"_23883":102034,"_2389":102083},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_2862":59861,"_25248":59837,"_17581":102085,"_5":17476,"_23883":102034,"_2389":102086},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_2862":59862,"_25248":59837,"_17581":102088,"_5":17476,"_23883":102034,"_2389":102089},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación adicionales.",{"_2862":59863,"_25248":59837,"_17581":102091,"_5":17476,"_23883":102034,"_2389":102092},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_2862":59864,"_25248":59837,"_17581":102094,"_5":17476,"_23883":102034,"_2389":102095},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_2862":59865,"_25248":59837,"_17581":102097,"_5":17476,"_23883":102038,"_2389":102098},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_2862":59866,"_25248":59837,"_17581":102100,"_5":17476,"_23883":102038,"_2389":102101},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_2862":59867,"_25248":59837,"_17581":102103,"_5":17476,"_23883":102038,"_2389":102104},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_2862":59868,"_25248":59837,"_17581":102106,"_5":17476,"_23883":102038,"_2389":102107},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_2862":59869,"_25248":59837,"_17581":102109,"_5":17476,"_23883":102038,"_2389":102110},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_2862":59870,"_25248":59837,"_17581":102112,"_5":17476,"_23883":102038,"_2389":102113},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_2862":59871,"_25248":59837,"_17581":102115,"_5":17476,"_23883":102038,"_2389":102116},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_2862":59872,"_25248":59837,"_17581":102118,"_5":17476,"_23883":102042,"_2389":102119},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_2862":59873,"_25248":59837,"_17581":102121,"_5":17476,"_23883":102046,"_2389":102122},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_2862":59874,"_25248":59837,"_17581":102124,"_5":17476,"_23883":102046,"_2389":102125},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_2862":59875,"_25248":59837,"_17581":102127,"_5":17476,"_23883":102046,"_2389":102128},[],"Asigna perfiles explícitos a cada caso de uso.",{"_2862":59876,"_25248":59837,"_17581":102130,"_5":17476,"_23883":102046,"_2389":102131},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_2862":59877,"_25248":59837,"_17581":102133,"_5":17476,"_23883":102046,"_2389":102134},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_2862":59878,"_25248":59837,"_17581":102136,"_5":17476,"_23883":102046,"_2389":102137},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_2862":59879,"_25248":59837,"_17581":102139,"_5":17476,"_23883":102046,"_2389":102140},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_2862":59880,"_25248":59880,"_5":12326,"_2389":102142,"_25584":102143,"_17581":102144,"_23883":59880},"Listas de revocación (CRL)",[40961,97440,46002,101630],[],{"_2862":59881,"_25248":59880,"_17581":102146,"_5":17476,"_23883":59880,"_2389":102147},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_2862":59882,"_25248":59880,"_5":25581,"_17581":102149,"_23883":102150,"_2389":102151},[],"/docs/pr-preview/pr-45/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_2862":59883,"_25248":59880,"_5":25581,"_17581":102153,"_23883":102154,"_2389":102155},[],"/docs/pr-preview/pr-45/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_2862":59884,"_25248":59880,"_5":25581,"_17581":102157,"_23883":102158,"_2389":102159},[],"/docs/pr-preview/pr-45/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_2862":59885,"_25248":59880,"_5":25581,"_17581":102161,"_23883":102162,"_2389":102163},[],"/docs/pr-preview/pr-45/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_2862":59886,"_25248":59880,"_5":25581,"_17581":102165,"_23883":102166,"_2389":102167},[],"/docs/pr-preview/pr-45/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_2862":59887,"_25248":59880,"_5":25581,"_17581":102169,"_23883":102170,"_2389":102171},[],"/docs/pr-preview/pr-45/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_2862":59888,"_25248":59880,"_5":25581,"_17581":102173,"_23883":102174,"_2389":102175},[],"/docs/pr-preview/pr-45/es/platform/pki/crl#referencias","Referencias",{"_2862":59889,"_25248":59880,"_17581":102177,"_5":17476,"_23883":59880,"_2389":102178},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_2862":59890,"_25248":59880,"_17581":102180,"_5":17476,"_23883":102150,"_2389":102181},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_2862":59891,"_25248":59880,"_17581":102183,"_5":17476,"_23883":102150,"_2389":102184},[],"Campo de `crl_options`",{"_2862":59892,"_25248":59880,"_17581":102186,"_5":17476,"_23883":102150,"_2389":98933},[],{"_2862":59893,"_25248":59880,"_17581":102188,"_5":17476,"_23883":102150,"_2389":102189},[],"Valor inicial del backend",{"_2862":59894,"_25248":59880,"_17581":102191,"_5":17476,"_23883":102150,"_2389":47182},[],{"_2862":59895,"_25248":59880,"_17581":102193,"_5":17476,"_23883":102150,"_2389":102194},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_2862":59896,"_25248":59880,"_17581":102196,"_5":17476,"_23883":102150,"_2389":102197},[],"7 días.",{"_2862":59897,"_25248":59880,"_17581":102199,"_5":17476,"_23883":102150,"_2389":47191},[],{"_2862":59898,"_25248":59880,"_17581":102201,"_5":17476,"_23883":102150,"_2389":102202},[],"Plazo desde la publicación que activa la renovación programada.",{"_2862":59899,"_25248":59880,"_17581":102204,"_5":17476,"_23883":102150,"_2389":102205},[],"6 días y 23 horas.",{"_2862":59900,"_25248":59880,"_17581":102207,"_5":17476,"_23883":102150,"_2389":47200},[],{"_2862":59901,"_25248":59880,"_17581":102209,"_5":17476,"_23883":102150,"_2389":102210},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_2862":59902,"_25248":59880,"_17581":102212,"_5":17476,"_23883":102150,"_2389":47206},[],{"_2862":59903,"_25248":59880,"_17581":102214,"_5":17476,"_23883":102150,"_2389":47209},[],{"_2862":59904,"_25248":59880,"_17581":102216,"_5":17476,"_23883":102150,"_2389":102217},[],"Campo de configuración inicializado con el SKI de la CA.",{"_2862":59905,"_25248":59880,"_17581":102219,"_5":17476,"_23883":102150,"_2389":102220},[],"SKI de la CA.",{"_2862":59906,"_25248":59880,"_17581":102222,"_5":17476,"_23883":102150,"_2389":102223},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_2862":59907,"_25248":59880,"_17581":102225,"_5":17476,"_23883":102150,"_2389":102226},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_2862":59908,"_25248":59880,"_17581":102228,"_5":17476,"_23883":102154,"_2389":102229},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_2862":59909,"_25248":59880,"_17581":102231,"_5":17476,"_23883":102154,"_2389":102232},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_2862":59910,"_25248":59880,"_17581":102234,"_5":17476,"_23883":102154,"_2389":102235},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_2862":59911,"_25248":59880,"_17581":102237,"_5":17476,"_23883":102158,"_2389":102238},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_2862":59912,"_25248":59880,"_17581":102240,"_5":17476,"_23883":102158,"_2389":102241},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_2862":59913,"_25248":59880,"_17581":102243,"_5":17476,"_23883":102162,"_2389":102244},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_2862":59914,"_25248":59880,"_17581":102246,"_5":17476,"_23883":102162,"_2389":102247},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_2862":59915,"_25248":59880,"_17581":102249,"_5":17476,"_23883":102162,"_2389":102250},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_2862":59916,"_25248":59880,"_17581":102252,"_5":17476,"_23883":102162,"_2389":102253},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_2862":59917,"_25248":59880,"_17581":102255,"_5":17476,"_23883":102162,"_2389":102256},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_2862":59918,"_25248":59880,"_17581":102258,"_5":17476,"_23883":102166,"_2389":102259},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_2862":59919,"_25248":59880,"_17581":102261,"_5":17476,"_23883":102166,"_2389":99122},[],{"_2862":59920,"_25248":59880,"_17581":102263,"_5":17476,"_23883":102166,"_2389":102264},[],"Path relativo",{"_2862":59921,"_25248":59880,"_17581":102266,"_5":17476,"_23883":102166,"_2389":97231},[],{"_2862":59922,"_25248":59880,"_17581":102268,"_5":17476,"_23883":102166,"_2389":47264},[],{"_2862":59923,"_25248":59880,"_17581":102270,"_5":17476,"_23883":102166,"_2389":47267},[],{"_2862":59924,"_25248":59880,"_17581":102272,"_5":17476,"_23883":102166,"_2389":102273},[],"Consultar `crl_options` y `latest_crl`.",{"_2862":59925,"_25248":59880,"_17581":102275,"_5":17476,"_23883":102166,"_2389":47273},[],{"_2862":59926,"_25248":59880,"_17581":102277,"_5":17476,"_23883":102166,"_2389":47267},[],{"_2862":59927,"_25248":59880,"_17581":102279,"_5":17476,"_23883":102166,"_2389":102280},[],"Sustituir la configuración de CRL.",{"_2862":59928,"_25248":59880,"_17581":102282,"_5":17476,"_23883":102166,"_2389":102283},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_2862":59929,"_25248":59880,"_17581":102285,"_5":17476,"_23883":102166,"_2389":102286},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_2862":59930,"_25248":59880,"_17581":102288,"_5":17476,"_23883":102170,"_2389":102289},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_2862":59931,"_25248":59880,"_17581":102291,"_5":17476,"_23883":102174,"_2389":102292},[],"RFC 5280: perfil X.509 y CRL.",{"_2862":59932,"_25248":59880,"_17581":102294,"_5":17476,"_23883":102174,"_2389":47293},[],{"_2862":59933,"_25248":59880,"_17581":102296,"_5":17476,"_23883":102174,"_2389":47296},[],{"_2862":59934,"_25248":59880,"_17581":102298,"_5":17476,"_23883":102174,"_2389":102299},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_2862":59935,"_25248":59880,"_17581":102301,"_5":17476,"_23883":102174,"_2389":102302},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2862":59936,"_25248":59936,"_5":12326,"_2389":102304,"_25584":102305,"_17581":102306,"_23883":59936},"Claves y motores criptográficos",[40961,97440,46002,101015],[],{"_2862":59937,"_25248":59936,"_17581":102308,"_5":17476,"_23883":59936,"_2389":102309},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_2862":59938,"_25248":59936,"_5":25581,"_17581":102311,"_23883":102312,"_2389":102313},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_2862":59939,"_25248":59936,"_5":25581,"_17581":102315,"_23883":102316,"_2389":102317},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_2862":59940,"_25248":59936,"_5":25581,"_17581":102319,"_23883":102320,"_2389":47321},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#file-system",{"_2862":59941,"_25248":59936,"_5":25581,"_17581":102322,"_23883":102323,"_2389":47325},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#hashicorp-vault",{"_2862":59942,"_25248":59936,"_5":25581,"_17581":102325,"_23883":102326,"_2389":47329},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#aws-secrets-manager",{"_2862":59943,"_25248":59936,"_5":25581,"_17581":102328,"_23883":102329,"_2389":47333},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#aws-kms",{"_2862":59944,"_25248":59936,"_5":25581,"_17581":102331,"_23883":102332,"_2389":47337},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#pkcs11",{"_2862":59945,"_25248":59936,"_5":25581,"_17581":102334,"_23883":102335,"_2389":47341},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#azure-key-vault",{"_2862":59946,"_25248":59936,"_5":25581,"_17581":102337,"_23883":102338,"_2389":102339},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_2862":59947,"_25248":59936,"_5":25581,"_17581":102341,"_23883":102342,"_2389":102343},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_2862":59948,"_25248":59936,"_5":25581,"_17581":102345,"_23883":102346,"_2389":102347},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_2862":59949,"_25248":59936,"_5":25581,"_17581":102349,"_23883":102350,"_2389":102351},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_2862":59950,"_25248":59936,"_5":25581,"_17581":102353,"_23883":102354,"_2389":102355},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_2862":59951,"_25248":59936,"_5":25581,"_17581":102357,"_23883":102358,"_2389":102359},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_2862":59952,"_25248":59936,"_5":25581,"_17581":102361,"_23883":102362,"_2389":102363},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_2862":59953,"_25248":59936,"_5":25581,"_17581":102365,"_23883":102366,"_2389":47373},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#sign",{"_2862":59954,"_25248":59936,"_5":25581,"_17581":102368,"_23883":102369,"_2389":47377},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#verify",{"_2862":59955,"_25248":59936,"_5":25581,"_17581":102371,"_23883":102372,"_2389":102373},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_2862":59956,"_25248":59936,"_5":25581,"_17581":102375,"_23883":102376,"_2389":102377},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_2862":59957,"_25248":59936,"_5":25581,"_17581":102379,"_23883":102380,"_2389":102381},[],"/docs/pr-preview/pr-45/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_2862":59958,"_25248":59936,"_17581":102383,"_5":17476,"_23883":59936,"_2389":102384},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_2862":59959,"_25248":59936,"_17581":102386,"_5":17476,"_23883":59936,"_2389":102387},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_2862":59960,"_25248":59936,"_17581":102389,"_5":17476,"_23883":102312,"_2389":102390},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_2862":59961,"_25248":59936,"_17581":102392,"_5":17476,"_23883":102312,"_2389":102393},[],"En la práctica, permite:",{"_2862":59962,"_25248":59936,"_17581":102395,"_5":17476,"_23883":102312,"_2389":102396},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_2862":59963,"_25248":59936,"_17581":102398,"_5":17476,"_23883":102312,"_2389":102399},[],"Importar claves creadas externamente.",{"_2862":59964,"_25248":59936,"_17581":102401,"_5":17476,"_23883":102312,"_2389":102402},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_2862":59965,"_25248":59936,"_17581":102404,"_5":17476,"_23883":102312,"_2389":102405},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_2862":59966,"_25248":59936,"_17581":102407,"_5":17476,"_23883":102316,"_2389":102408},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_2862":59967,"_25248":59936,"_17581":102410,"_5":17476,"_23883":102316,"_2389":102411},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_2862":59968,"_25248":59936,"_17581":102413,"_5":17476,"_23883":102316,"_2389":102414},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_2862":59969,"_25248":59936,"_17581":102416,"_5":17476,"_23883":102320,"_2389":102417},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_2862":59970,"_25248":59936,"_17581":102419,"_5":17476,"_23883":102323,"_2389":102420},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_2862":59971,"_25248":59936,"_17581":102422,"_5":17476,"_23883":102326,"_2389":102423},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_2862":59972,"_25248":59936,"_17581":102425,"_5":17476,"_23883":102329,"_2389":102426},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_2862":59973,"_25248":59936,"_17581":102428,"_5":17476,"_23883":102332,"_2389":102429},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_2862":59974,"_25248":59936,"_17581":102431,"_5":17476,"_23883":102335,"_2389":102432},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_2862":59975,"_25248":59936,"_17581":102434,"_5":17476,"_23883":102335,"_2389":102435},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_2862":59976,"_25248":59936,"_17581":102437,"_5":17476,"_23883":102335,"_2389":102438},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_2862":59977,"_25248":59936,"_17581":102440,"_5":17476,"_23883":102335,"_2389":102441},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_2862":59978,"_25248":59936,"_17581":102443,"_5":17476,"_23883":102338,"_2389":102444},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_2862":59979,"_25248":59936,"_17581":102446,"_5":17476,"_23883":102338,"_2389":102447},[],"La tabla incluye los siguientes campos:",{"_2862":59980,"_25248":59936,"_17581":102449,"_5":17476,"_23883":102338,"_2389":102450},[],"**Name**: nombre descriptivo de la clave.",{"_2862":59981,"_25248":59936,"_17581":102452,"_5":17476,"_23883":102338,"_2389":102453},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_2862":59982,"_25248":59936,"_17581":102455,"_5":17476,"_23883":102338,"_2389":102456},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_2862":59983,"_25248":59936,"_17581":102458,"_5":17476,"_23883":102338,"_2389":102459},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_2862":59984,"_25248":59936,"_17581":102461,"_5":17476,"_23883":102338,"_2389":102462},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_2862":59985,"_25248":59936,"_17581":102464,"_5":17476,"_23883":102338,"_2389":102465},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_2862":59986,"_25248":59936,"_17581":102467,"_5":17476,"_23883":102338,"_2389":102468},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_2862":59987,"_25248":59936,"_17581":102470,"_5":17476,"_23883":102338,"_2389":102471},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_2862":59988,"_25248":59936,"_17581":102473,"_5":17476,"_23883":102338,"_2389":102474},[],"Desde esta vista también se accede a las acciones más habituales:",{"_2862":59989,"_25248":59936,"_17581":102476,"_5":17476,"_23883":102338,"_2389":102477},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_2862":59990,"_25248":59936,"_17581":102479,"_5":17476,"_23883":102338,"_2389":102480},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_2862":59991,"_25248":59936,"_17581":102482,"_5":17476,"_23883":102338,"_2389":102483},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_2862":59992,"_25248":59936,"_17581":102485,"_5":17476,"_23883":102338,"_2389":102486},[],"**Delete Key** para eliminar la clave del sistema.",{"_2862":59993,"_25248":59936,"_17581":102488,"_5":17476,"_23883":102342,"_2389":102489},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_2862":59994,"_25248":59936,"_17581":102491,"_5":17476,"_23883":102346,"_2389":102492},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_2862":59995,"_25248":59936,"_17581":102494,"_5":17476,"_23883":102346,"_2389":102495},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_2862":59996,"_25248":59936,"_17581":102497,"_5":17476,"_23883":102346,"_2389":102498},[],"**Key Name**: nombre único y descriptivo.",{"_2862":59997,"_25248":59936,"_17581":102500,"_5":17476,"_23883":102346,"_2389":102501},[],"**Crypto Engine**: motor que custodiará la clave.",{"_2862":59998,"_25248":59936,"_17581":102503,"_5":17476,"_23883":102346,"_2389":102504},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_2862":59999,"_25248":59936,"_17581":102506,"_5":17476,"_23883":102346,"_2389":102507},[],"**Tags**: metadatos para clasificar la clave.",{"_2862":60000,"_25248":59936,"_17581":102509,"_5":17476,"_23883":102346,"_2389":102510},[],"**Metadata**: información adicional para usos avanzados.",{"_2862":60001,"_25248":59936,"_17581":102512,"_5":17476,"_23883":102350,"_2389":102513},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_2862":60002,"_25248":59936,"_17581":102515,"_5":17476,"_23883":102350,"_2389":102516},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_2862":60003,"_25248":59936,"_17581":102518,"_5":17476,"_23883":102350,"_2389":102519},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_2862":60004,"_25248":59936,"_17581":102521,"_5":17476,"_23883":102350,"_2389":102522},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_2862":60005,"_25248":59936,"_17581":102524,"_5":17476,"_23883":102350,"_2389":102525},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_2862":60006,"_25248":59936,"_17581":102527,"_5":17476,"_23883":102350,"_2389":102528},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_2862":60007,"_25248":59936,"_17581":102530,"_5":17476,"_23883":102350,"_2389":102531},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_2862":60008,"_25248":59936,"_17581":102533,"_5":17476,"_23883":102350,"_2389":102534},[],"**Tags**: etiquetas para organización y búsqueda.",{"_2862":60009,"_25248":59936,"_17581":102536,"_5":17476,"_23883":102350,"_2389":102537},[],"**Metadata**: información adicional opcional.",{"_2862":60010,"_25248":59936,"_17581":102539,"_5":17476,"_23883":102350,"_2389":102540},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_2862":60011,"_25248":59936,"_17581":102542,"_5":17476,"_23883":102350,"_2389":102543},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_2862":60012,"_25248":59936,"_17581":102545,"_5":17476,"_23883":102354,"_2389":102546},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_2862":60013,"_25248":59936,"_17581":102548,"_5":17476,"_23883":102358,"_2389":102549},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_2862":60014,"_25248":59936,"_17581":102551,"_5":17476,"_23883":102358,"_2389":102552},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_2862":60015,"_25248":59936,"_17581":102554,"_5":17476,"_23883":102358,"_2389":102555},[],"**Key Name**: nombre descriptivo.",{"_2862":60016,"_25248":59936,"_17581":102557,"_5":17476,"_23883":102358,"_2389":102558},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_2862":60017,"_25248":59936,"_17581":102560,"_5":17476,"_23883":102358,"_2389":102561},[],"**Tags**: etiquetas asociadas.",{"_2862":60018,"_25248":59936,"_17581":102563,"_5":17476,"_23883":102358,"_2389":102564},[],"**Aliases**: nombres alternativos.",{"_2862":60019,"_25248":59936,"_17581":102566,"_5":17476,"_23883":102358,"_2389":102567},[],"**Crypto Engine**: motor en el que reside la clave.",{"_2862":60020,"_25248":59936,"_17581":102569,"_5":17476,"_23883":102358,"_2389":102570},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_2862":60021,"_25248":59936,"_17581":102572,"_5":17476,"_23883":102358,"_2389":102573},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_2862":60022,"_25248":59936,"_17581":102575,"_5":17476,"_23883":102358,"_2389":102576},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_2862":60023,"_25248":59936,"_17581":102578,"_5":17476,"_23883":102362,"_2389":102579},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_2862":60024,"_25248":59936,"_17581":102581,"_5":17476,"_23883":102362,"_2389":102582},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_2862":60025,"_25248":59936,"_17581":102584,"_5":17476,"_23883":102362,"_2389":102585},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_2862":60026,"_25248":59936,"_17581":102587,"_5":17476,"_23883":102366,"_2389":102588},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_2862":60027,"_25248":59936,"_17581":102590,"_5":17476,"_23883":102366,"_2389":102591},[],"Campos principales:",{"_2862":60028,"_25248":59936,"_17581":102593,"_5":17476,"_23883":102366,"_2389":102594},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_2862":60029,"_25248":59936,"_17581":102596,"_5":17476,"_23883":102366,"_2389":102597},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_2862":60030,"_25248":59936,"_17581":102599,"_5":17476,"_23883":102366,"_2389":102600},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_2862":60031,"_25248":59936,"_17581":102602,"_5":17476,"_23883":102366,"_2389":102603},[],"**Message**: contenido que se va a firmar.",{"_2862":60032,"_25248":59936,"_17581":102605,"_5":17476,"_23883":102366,"_2389":102606},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_2862":60033,"_25248":59936,"_17581":102608,"_5":17476,"_23883":102369,"_2389":102609},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_2862":60034,"_25248":59936,"_17581":102611,"_5":17476,"_23883":102369,"_2389":102591},[],{"_2862":60035,"_25248":59936,"_17581":102613,"_5":17476,"_23883":102369,"_2389":102614},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_2862":60036,"_25248":59936,"_17581":102616,"_5":17476,"_23883":102369,"_2389":102617},[],"**Message Type**: `Raw` o `Digest`.",{"_2862":60037,"_25248":59936,"_17581":102619,"_5":17476,"_23883":102369,"_2389":102620},[],"**Payload Encoding**: codificación del mensaje.",{"_2862":60038,"_25248":59936,"_17581":102622,"_5":17476,"_23883":102369,"_2389":102623},[],"**Message**: mensaje original o hash.",{"_2862":60039,"_25248":59936,"_17581":102625,"_5":17476,"_23883":102369,"_2389":102626},[],"**Signature**: firma que se desea comprobar.",{"_2862":60040,"_25248":59936,"_17581":102628,"_5":17476,"_23883":102369,"_2389":102629},[],"**Result**: indicador del resultado de la validación.",{"_2862":60041,"_25248":59936,"_17581":102631,"_5":17476,"_23883":102372,"_2389":102632},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_2862":60042,"_25248":59936,"_17581":102634,"_5":17476,"_23883":102372,"_2389":102635},[],"Este flujo es útil para:",{"_2862":60043,"_25248":59936,"_17581":102637,"_5":17476,"_23883":102372,"_2389":102638},[],"Solicitar certificados a una CA externa.",{"_2862":60044,"_25248":59936,"_17581":102640,"_5":17476,"_23883":102372,"_2389":102641},[],"Renovar una identidad manteniendo la misma clave.",{"_2862":60045,"_25248":59936,"_17581":102643,"_5":17476,"_23883":102372,"_2389":102644},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_2862":60046,"_25248":59936,"_17581":102646,"_5":17476,"_23883":102372,"_2389":102647},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_2862":60047,"_25248":59936,"_17581":102649,"_5":17476,"_23883":102372,"_2389":102650},[],"**Organization (O)**: organización o empresa.",{"_2862":60048,"_25248":59936,"_17581":102652,"_5":17476,"_23883":102372,"_2389":102653},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_2862":60049,"_25248":59936,"_17581":102655,"_5":17476,"_23883":102372,"_2389":102656},[],"**Country (C)**: código de país de dos letras.",{"_2862":60050,"_25248":59936,"_17581":102658,"_5":17476,"_23883":102372,"_2389":102659},[],"**State / Province (ST)**: estado o provincia.",{"_2862":60051,"_25248":59936,"_17581":102661,"_5":17476,"_23883":102372,"_2389":102662},[],"**Locality (L)**: ciudad o localidad.",{"_2862":60052,"_25248":59936,"_17581":102664,"_5":17476,"_23883":102372,"_2389":102665},[],"**Email Address**: correo de contacto.",{"_2862":60053,"_25248":59936,"_17581":102667,"_5":17476,"_23883":102372,"_2389":102668},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_2862":60054,"_25248":59936,"_17581":102670,"_5":17476,"_23883":102372,"_2389":102671},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_2862":60055,"_25248":59936,"_17581":102673,"_5":17476,"_23883":102376,"_2389":102674},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_2862":60056,"_25248":59936,"_17581":102676,"_5":17476,"_23883":102376,"_2389":47685},[],{"_2862":60057,"_25248":59936,"_17581":102678,"_5":17476,"_23883":102380,"_2389":102679},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_2862":60058,"_25248":60058,"_5":12326,"_2389":102681,"_25584":102682,"_17581":102683,"_23883":60058},"Validación online con OCSP",[40961,97440,46002,101630],[],{"_2862":60059,"_25248":60058,"_17581":102685,"_5":17476,"_23883":60058,"_2389":102686},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_2862":60060,"_25248":60058,"_5":25581,"_17581":102688,"_23883":102689,"_2389":102690},[],"/docs/pr-preview/pr-45/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_2862":60061,"_25248":60058,"_5":25581,"_17581":102692,"_23883":102693,"_2389":102694},[],"/docs/pr-preview/pr-45/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_2862":60062,"_25248":60058,"_5":25581,"_17581":102696,"_23883":102697,"_2389":102698},[],"/docs/pr-preview/pr-45/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_2862":60063,"_25248":60058,"_5":25581,"_17581":102700,"_23883":102701,"_2389":102702},[],"/docs/pr-preview/pr-45/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_2862":60064,"_25248":60058,"_5":25581,"_17581":102704,"_23883":102705,"_2389":102706},[],"/docs/pr-preview/pr-45/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_2862":60065,"_25248":60058,"_5":25581,"_17581":102708,"_23883":102709,"_2389":102175},[],"/docs/pr-preview/pr-45/es/platform/pki/ocsp#referencias",{"_2862":60066,"_25248":60058,"_17581":102711,"_5":17476,"_23883":60058,"_2389":102712},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_2862":60067,"_25248":60058,"_17581":102714,"_5":17476,"_23883":102689,"_2389":102715},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_2862":60068,"_25248":60058,"_17581":102717,"_5":17476,"_23883":102689,"_2389":102718},[],"Estado del registro",{"_2862":60069,"_25248":60058,"_17581":102720,"_5":17476,"_23883":102689,"_2389":102721},[],"Respuesta firmada",{"_2862":60070,"_25248":60058,"_17581":102723,"_5":17476,"_23883":102689,"_2389":45180},[],{"_2862":60071,"_25248":60058,"_17581":102725,"_5":17476,"_23883":102689,"_2389":47735},[],{"_2862":60072,"_25248":60058,"_17581":102727,"_5":17476,"_23883":102689,"_2389":45197},[],{"_2862":60073,"_25248":60058,"_17581":102729,"_5":17476,"_23883":102689,"_2389":102730},[],"`Revoked`, con razón y fecha de revocación.",{"_2862":60074,"_25248":60058,"_17581":102732,"_5":17476,"_23883":102689,"_2389":102733},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_2862":60075,"_25248":60058,"_17581":102735,"_5":17476,"_23883":102689,"_2389":102736},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_2862":60076,"_25248":60058,"_17581":102738,"_5":17476,"_23883":102689,"_2389":102739},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_2862":60077,"_25248":60058,"_17581":102741,"_5":17476,"_23883":102689,"_2389":102742},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_2862":60078,"_25248":60058,"_17581":102744,"_5":17476,"_23883":102689,"_2389":102745},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_2862":60079,"_25248":60058,"_17581":102747,"_5":17476,"_23883":102693,"_2389":102748},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_2862":60080,"_25248":60058,"_17581":102750,"_5":17476,"_23883":102693,"_2389":102751},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_2862":60081,"_25248":60058,"_17581":102753,"_5":17476,"_23883":102697,"_2389":102754},[],"El servicio acepta:",{"_2862":60082,"_25248":60058,"_17581":102756,"_5":17476,"_23883":102697,"_2389":99122},[],{"_2862":60083,"_25248":60058,"_17581":102758,"_5":17476,"_23883":102697,"_2389":102759},[],"Ruta del servicio VA",{"_2862":60084,"_25248":60058,"_17581":102761,"_5":17476,"_23883":102697,"_2389":102762},[],"Formato",{"_2862":60085,"_25248":60058,"_17581":102764,"_5":17476,"_23883":102697,"_2389":47775},[],{"_2862":60086,"_25248":60058,"_17581":102766,"_5":17476,"_23883":102697,"_2389":47778},[],{"_2862":60087,"_25248":60058,"_17581":102768,"_5":17476,"_23883":102697,"_2389":102769},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_2862":60088,"_25248":60058,"_17581":102771,"_5":17476,"_23883":102697,"_2389":47264},[],{"_2862":60089,"_25248":60058,"_17581":102773,"_5":17476,"_23883":102697,"_2389":47786},[],{"_2862":60090,"_25248":60058,"_17581":102775,"_5":17476,"_23883":102697,"_2389":102776},[],"Solicitud DER codificada en Base64 URL con padding.",{"_2862":60091,"_25248":60058,"_17581":102778,"_5":17476,"_23883":102697,"_2389":102779},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_2862":60092,"_25248":60058,"_17581":102781,"_5":17476,"_23883":102701,"_2389":102782},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_2862":60093,"_25248":60058,"_17581":102784,"_5":17476,"_23883":102701,"_2389":102785},[],"Genera la solicitud:",{"_2862":60094,"_25248":60058,"_17581":102787,"_5":17476,"_23883":102701,"_2389":102788},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_2862":60095,"_25248":60058,"_17581":102790,"_5":17476,"_23883":102701,"_2389":102791},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_2862":60096,"_25248":60058,"_17581":102793,"_5":17476,"_23883":102701,"_2389":102794},[],"Verifica el DER recibido:",{"_2862":60097,"_25248":60058,"_17581":102796,"_5":17476,"_23883":102701,"_2389":102797},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_2862":60098,"_25248":60058,"_17581":102799,"_5":17476,"_23883":102705,"_2389":102800},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_2862":60099,"_25248":60058,"_17581":102802,"_5":17476,"_23883":102705,"_2389":102803},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_2862":60100,"_25248":60058,"_17581":102805,"_5":17476,"_23883":102709,"_2389":47819},[],{"_2862":60101,"_25248":60058,"_17581":102807,"_5":17476,"_23883":102709,"_2389":47822},[],{"_2862":60102,"_25248":60058,"_17581":102809,"_5":17476,"_23883":102709,"_2389":102810},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_2862":60103,"_25248":60058,"_17581":102812,"_5":17476,"_23883":102709,"_2389":102302},[],{"_2862":60104,"_25248":60104,"_5":12326,"_2389":46002,"_25584":102814,"_17581":102815,"_23883":60104},[40961,97440,46002],[],{"_2862":60105,"_25248":60104,"_17581":102817,"_5":17476,"_23883":60104,"_2389":102818},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_2862":60106,"_25248":60104,"_5":25581,"_17581":102820,"_23883":102821,"_2389":100339},[],"/docs/pr-preview/pr-45/es/platform/pki/overview#empieza-aquí",{"_2862":60107,"_25248":60104,"_5":25581,"_17581":102823,"_23883":102824,"_2389":102825},[],"/docs/pr-preview/pr-45/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_2862":60108,"_25248":60104,"_5":25581,"_17581":102827,"_23883":102828,"_2389":100861},[],"/docs/pr-preview/pr-45/es/platform/pki/overview#capacidades-principales",{"_2862":60109,"_25248":60104,"_5":25581,"_17581":102830,"_23883":102831,"_2389":100865},[],"/docs/pr-preview/pr-45/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_2862":60110,"_25248":60104,"_5":25581,"_17581":102833,"_23883":102834,"_2389":100869},[],"/docs/pr-preview/pr-45/es/platform/pki/overview#protege-las-claves-criptográficas",{"_2862":60111,"_25248":60104,"_5":25581,"_17581":102836,"_23883":102837,"_2389":100873},[],"/docs/pr-preview/pr-45/es/platform/pki/overview#emite-y-controla-certificados",{"_2862":60112,"_25248":60104,"_5":25581,"_17581":102839,"_23883":102840,"_2389":100881},[],"/docs/pr-preview/pr-45/es/platform/pki/overview#publica-el-estado-de-validación",{"_2862":60113,"_25248":60104,"_5":25581,"_17581":102842,"_23883":102843,"_2389":102844},[],"/docs/pr-preview/pr-45/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_2862":60114,"_25248":60104,"_5":25581,"_17581":102846,"_23883":102847,"_2389":101796},[],"/docs/pr-preview/pr-45/es/platform/pki/overview#continúa",{"_2862":60115,"_25248":60104,"_17581":102849,"_5":17476,"_23883":60104,"_2389":102850},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_2862":60116,"_25248":60104,"_17581":102852,"_5":17476,"_23883":102821,"_2389":102853},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_2862":60117,"_25248":60104,"_17581":102855,"_5":17476,"_23883":102821,"_2389":102856},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_2862":60118,"_25248":60104,"_17581":102858,"_5":17476,"_23883":102824,"_2389":102859},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_2862":60119,"_25248":60104,"_17581":102861,"_5":17476,"_23883":102824,"_2389":102862},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_2862":60120,"_25248":60104,"_17581":102864,"_5":17476,"_23883":102824,"_2389":102865},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_2862":60121,"_25248":60104,"_17581":102867,"_5":17476,"_23883":102824,"_2389":102868},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_2862":60122,"_25248":60104,"_17581":102870,"_5":17476,"_23883":102824,"_2389":102871},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_2862":60123,"_25248":60104,"_17581":102873,"_5":17476,"_23883":102831,"_2389":102874},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_2862":60124,"_25248":60104,"_17581":102876,"_5":17476,"_23883":102834,"_2389":102877},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_2862":60125,"_25248":60104,"_17581":102879,"_5":17476,"_23883":102837,"_2389":102880},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_2862":60126,"_25248":60104,"_17581":102882,"_5":17476,"_23883":102840,"_2389":102883},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_2862":60127,"_25248":60104,"_17581":102885,"_5":17476,"_23883":102843,"_2389":102886},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_2862":60128,"_25248":60104,"_17581":102888,"_5":17476,"_23883":102843,"_2389":102889},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_2862":60129,"_25248":60104,"_17581":102891,"_5":17476,"_23883":102843,"_2389":102892},[],"su clave pública corresponda a la clave privada del cliente;",{"_2862":60130,"_25248":60104,"_17581":102894,"_5":17476,"_23883":102843,"_2389":102895},[],"su cadena alcance una raíz confiable para el consumidor;",{"_2862":60131,"_25248":60104,"_17581":102897,"_5":17476,"_23883":102843,"_2389":102898},[],"sus fechas y usos permitan la operación;",{"_2862":60132,"_25248":60104,"_17581":102900,"_5":17476,"_23883":102843,"_2389":102901},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_2862":60133,"_25248":60104,"_17581":102903,"_5":17476,"_23883":102843,"_2389":102904},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_2862":60134,"_25248":60104,"_17581":102906,"_5":17476,"_23883":102847,"_2389":102907},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2862":60135,"_25248":60104,"_17581":102909,"_5":17476,"_23883":102847,"_2389":102910},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2862":60136,"_25248":60104,"_17581":102912,"_5":17476,"_23883":102847,"_2389":102913},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2862":60137,"_25248":60137,"_5":12326,"_2389":102915,"_25584":102916,"_17581":102917,"_23883":60137},"Crea tu primera CA",[40961,97440,46002,100463],[],{"_2862":60138,"_25248":60137,"_17581":102919,"_5":17476,"_23883":60137,"_2389":102920},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_2862":60139,"_25248":60137,"_5":25581,"_17581":102922,"_23883":102923,"_2389":96122},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_2862":60140,"_25248":60137,"_5":25581,"_17581":102925,"_23883":102926,"_2389":102927},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_2862":60141,"_25248":60137,"_5":25581,"_17581":102929,"_23883":102930,"_2389":102931},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_2862":60142,"_25248":60137,"_5":25581,"_17581":102933,"_23883":102934,"_2389":102935},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_2862":60143,"_25248":60137,"_5":25581,"_17581":102937,"_23883":102938,"_2389":102939},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_2862":60144,"_25248":60137,"_5":25581,"_17581":102941,"_23883":102942,"_2389":102943},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_2862":60145,"_25248":60137,"_5":25581,"_17581":102945,"_23883":102946,"_2389":102947},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_2862":60146,"_25248":60137,"_5":25581,"_17581":102949,"_23883":102950,"_2389":100711},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_2862":60147,"_25248":60137,"_5":25581,"_17581":102952,"_23883":102953,"_2389":96146},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_2862":60148,"_25248":60137,"_17581":102955,"_5":17476,"_23883":60137,"_2389":102956},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_2862":60149,"_25248":60137,"_17581":102958,"_5":17476,"_23883":102923,"_2389":102959},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_2862":60150,"_25248":60137,"_17581":102961,"_5":17476,"_23883":102923,"_2389":102962},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_2862":60151,"_25248":60137,"_17581":102964,"_5":17476,"_23883":102923,"_2389":102965},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_2862":60152,"_25248":60137,"_17581":102967,"_5":17476,"_23883":102923,"_2389":102968},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_2862":60153,"_25248":60137,"_17581":102970,"_5":17476,"_23883":102926,"_2389":102971},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_2862":60154,"_25248":60137,"_17581":102973,"_5":17476,"_23883":102926,"_2389":102974},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_2862":60155,"_25248":60137,"_17581":102976,"_5":17476,"_23883":102930,"_2389":102977},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_2862":60156,"_25248":60137,"_17581":102979,"_5":17476,"_23883":102930,"_2389":102980},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_2862":60157,"_25248":60137,"_17581":102982,"_5":17476,"_23883":102934,"_2389":102983},[],"Selecciona **Root CA** y completa:",{"_2862":60158,"_25248":60137,"_17581":102985,"_5":17476,"_23883":102934,"_2389":48001},[],{"_2862":60159,"_25248":60137,"_17581":102987,"_5":17476,"_23883":102934,"_2389":102988},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_2862":60160,"_25248":60137,"_17581":102990,"_5":17476,"_23883":102934,"_2389":102991},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_2862":60161,"_25248":60137,"_17581":102993,"_5":17476,"_23883":102934,"_2389":102994},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_2862":60162,"_25248":60137,"_17581":102996,"_5":17476,"_23883":102934,"_2389":102997},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_2862":60163,"_25248":60137,"_17581":102999,"_5":17476,"_23883":102938,"_2389":103000},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_2862":60164,"_25248":60137,"_17581":103002,"_5":17476,"_23883":102942,"_2389":103003},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_2862":60165,"_25248":60137,"_17581":103005,"_5":17476,"_23883":102942,"_2389":103006},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_2862":60166,"_25248":60137,"_17581":103008,"_5":17476,"_23883":102946,"_2389":103009},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_2862":60167,"_25248":60137,"_17581":103011,"_5":17476,"_23883":102946,"_2389":103012},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_2862":60168,"_25248":60137,"_17581":103014,"_5":17476,"_23883":102946,"_2389":103015},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_2862":60169,"_25248":60137,"_17581":103017,"_5":17476,"_23883":102950,"_2389":103018},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_2862":60170,"_25248":60137,"_17581":103020,"_5":17476,"_23883":102950,"_2389":103021},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_2862":60171,"_25248":60137,"_17581":103023,"_5":17476,"_23883":102950,"_2389":103024},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_2862":60172,"_25248":60137,"_17581":103026,"_5":17476,"_23883":102950,"_2389":103027},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_2862":60173,"_25248":60137,"_17581":103029,"_5":17476,"_23883":102953,"_2389":103030},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_2862":60174,"_25248":60174,"_5":12326,"_2389":103032,"_25584":103033,"_17581":103034,"_23883":60174},"Emite y verifica un certificado",[40961,97440,46002,100463],[],{"_2862":60175,"_25248":60174,"_17581":103036,"_5":17476,"_23883":60174,"_2389":103037},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_2862":60176,"_25248":60174,"_5":25581,"_17581":103039,"_23883":103040,"_2389":96122},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_2862":60177,"_25248":60174,"_5":25581,"_17581":103042,"_23883":103043,"_2389":103044},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_2862":60178,"_25248":60174,"_5":25581,"_17581":103046,"_23883":103047,"_2389":103048},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_2862":60179,"_25248":60174,"_5":25581,"_17581":103050,"_23883":103051,"_2389":103052},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_2862":60180,"_25248":60174,"_5":25581,"_17581":103054,"_23883":103055,"_2389":103056},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_2862":60181,"_25248":60174,"_5":25581,"_17581":103058,"_23883":103059,"_2389":103060},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_2862":60182,"_25248":60174,"_5":25581,"_17581":103062,"_23883":103063,"_2389":102943},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_2862":60183,"_25248":60174,"_5":25581,"_17581":103065,"_23883":103066,"_2389":103067},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_2862":60184,"_25248":60174,"_5":25581,"_17581":103069,"_23883":103070,"_2389":103071},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_2862":60185,"_25248":60174,"_5":25581,"_17581":103073,"_23883":103074,"_2389":103075},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_2862":60186,"_25248":60174,"_5":25581,"_17581":103077,"_23883":103078,"_2389":100711},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_2862":60187,"_25248":60174,"_5":25581,"_17581":103080,"_23883":103081,"_2389":96146},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_2862":60188,"_25248":60174,"_17581":103083,"_5":17476,"_23883":60174,"_2389":103084},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_2862":60189,"_25248":60174,"_17581":103086,"_5":17476,"_23883":103040,"_2389":103087},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_2862":60190,"_25248":60174,"_17581":103089,"_5":17476,"_23883":103040,"_2389":103090},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_2862":60191,"_25248":60174,"_17581":103092,"_5":17476,"_23883":103040,"_2389":103093},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_2862":60192,"_25248":60174,"_17581":103095,"_5":17476,"_23883":103040,"_2389":103096},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_2862":60193,"_25248":60174,"_17581":103098,"_5":17476,"_23883":103040,"_2389":103099},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_2862":60194,"_25248":60174,"_17581":103101,"_5":17476,"_23883":103043,"_2389":103102},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_2862":60195,"_25248":60174,"_17581":103104,"_5":17476,"_23883":103047,"_2389":103105},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_2862":60196,"_25248":60174,"_17581":103107,"_5":17476,"_23883":103047,"_2389":103108},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_2862":60197,"_25248":60174,"_17581":103110,"_5":17476,"_23883":103051,"_2389":103111},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_2862":60198,"_25248":60174,"_17581":103113,"_5":17476,"_23883":103051,"_2389":103114},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_2862":60199,"_25248":60174,"_17581":103116,"_5":17476,"_23883":103055,"_2389":103117},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_2862":60200,"_25248":60174,"_17581":103119,"_5":17476,"_23883":103055,"_2389":103120},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_2862":60201,"_25248":60174,"_17581":103122,"_5":17476,"_23883":103059,"_2389":103123},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_2862":60202,"_25248":60174,"_17581":103125,"_5":17476,"_23883":103063,"_2389":103126},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_2862":60203,"_25248":60174,"_17581":103128,"_5":17476,"_23883":103066,"_2389":103129},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_2862":60204,"_25248":60174,"_17581":103131,"_5":17476,"_23883":103070,"_2389":103132},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_2862":60205,"_25248":60174,"_17581":103134,"_5":17476,"_23883":103070,"_2389":103135},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_2862":60206,"_25248":60174,"_17581":103137,"_5":17476,"_23883":103070,"_2389":103138},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_2862":60207,"_25248":60174,"_17581":103140,"_5":17476,"_23883":103074,"_2389":103141},[],"En Bash, compara los dos resúmenes de clave pública:",{"_2862":60208,"_25248":60174,"_17581":103143,"_5":17476,"_23883":103074,"_2389":103144},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_2862":60209,"_25248":60174,"_17581":103146,"_5":17476,"_23883":103074,"_2389":103147},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_2862":60210,"_25248":60174,"_17581":103149,"_5":17476,"_23883":103078,"_2389":100794},[],{"_2862":60211,"_25248":60174,"_17581":103151,"_5":17476,"_23883":103078,"_2389":99571},[],{"_2862":60212,"_25248":60174,"_17581":103153,"_5":17476,"_23883":103078,"_2389":103154},[],"La CA rechaza la emisión",{"_2862":60213,"_25248":60174,"_17581":103156,"_5":17476,"_23883":103078,"_2389":103157},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_2862":60214,"_25248":60174,"_17581":103159,"_5":17476,"_23883":103078,"_2389":103160},[],"Sujeto o usos diferentes",{"_2862":60215,"_25248":60174,"_17581":103162,"_5":17476,"_23883":103078,"_2389":103163},[],"Perfil aplicado y valores solicitados.",{"_2862":60216,"_25248":60174,"_17581":103165,"_5":17476,"_23883":103078,"_2389":103166},[],"No se encuentra el emisor",{"_2862":60217,"_25248":60174,"_17581":103168,"_5":17476,"_23883":103078,"_2389":103169},[],"CA descargada y cadena intermedia necesaria.",{"_2862":60218,"_25248":60174,"_17581":103171,"_5":17476,"_23883":103078,"_2389":103172},[],"Falla la vigencia",{"_2862":60219,"_25248":60174,"_17581":103174,"_5":17476,"_23883":103078,"_2389":103175},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_2862":60220,"_25248":60174,"_17581":103177,"_5":17476,"_23883":103078,"_2389":103178},[],"Los resúmenes de clave difieren",{"_2862":60221,"_25248":60174,"_17581":103180,"_5":17476,"_23883":103078,"_2389":103181},[],"Archivos de certificado y clave de la misma emisión.",{"_2862":60222,"_25248":60174,"_17581":103183,"_5":17476,"_23883":103078,"_2389":103184},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_2862":60223,"_25248":60174,"_17581":103186,"_5":17476,"_23883":103081,"_2389":103187},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_2862":60224,"_25248":60174,"_17581":103189,"_5":17476,"_23883":103081,"_2389":103190},[],"Gestionar certificados para inspección, estado y revocación.",{"_2862":60225,"_25248":60174,"_17581":103192,"_5":17476,"_23883":103081,"_2389":103193},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_2862":60226,"_25248":60174,"_17581":103195,"_5":17476,"_23883":103081,"_2389":103196},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_2862":60227,"_25248":60174,"_17581":103198,"_5":17476,"_23883":103081,"_2389":103199},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_2862":60228,"_25248":60228,"_5":12326,"_2389":103201,"_25584":103202,"_17581":103203,"_23883":60228},"Primeros pasos de PKI",[40961,97440,46002,100463],[],{"_2862":60229,"_25248":60228,"_17581":103205,"_5":17476,"_23883":60228,"_2389":103206},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_2862":60230,"_25248":60228,"_5":25581,"_17581":103208,"_23883":103209,"_2389":96122},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_2862":60231,"_25248":60228,"_5":25581,"_17581":103211,"_23883":103212,"_2389":103213},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_2862":60232,"_25248":60228,"_5":25581,"_17581":103215,"_23883":103216,"_2389":100645},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/overview#resultado-esperado",{"_2862":60233,"_25248":60228,"_5":25581,"_17581":103218,"_23883":103219,"_2389":103220},[],"/docs/pr-preview/pr-45/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_2862":60234,"_25248":60228,"_17581":103222,"_5":17476,"_23883":60228,"_2389":103223},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_2862":60235,"_25248":60228,"_17581":103225,"_5":17476,"_23883":103209,"_2389":103226},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_2862":60236,"_25248":60228,"_17581":103228,"_5":17476,"_23883":103209,"_2389":103229},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_2862":60237,"_25248":60228,"_17581":103231,"_5":17476,"_23883":103209,"_2389":103232},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_2862":60238,"_25248":60228,"_17581":103234,"_5":17476,"_23883":103209,"_2389":103235},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_2862":60239,"_25248":60228,"_17581":103237,"_5":17476,"_23883":103209,"_2389":103238},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_2862":60240,"_25248":60228,"_17581":103240,"_5":17476,"_23883":103212,"_2389":103241},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2862":60241,"_25248":60228,"_17581":103243,"_5":17476,"_23883":103212,"_2389":103244},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2862":60242,"_25248":60228,"_17581":103246,"_5":17476,"_23883":103212,"_2389":103247},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_2862":60243,"_25248":60228,"_17581":103249,"_5":17476,"_23883":103212,"_2389":103250},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_2862":60244,"_25248":60228,"_17581":103252,"_5":17476,"_23883":103216,"_2389":103253},[],"Archivo o recurso",{"_2862":60245,"_25248":60228,"_17581":103255,"_5":17476,"_23883":103216,"_2389":100642},[],{"_2862":60246,"_25248":60228,"_17581":103257,"_5":17476,"_23883":103216,"_2389":103258},[],"CA raíz activa y `ca.pem`",{"_2862":60247,"_25248":60228,"_17581":103260,"_5":17476,"_23883":103216,"_2389":103261},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_2862":60248,"_25248":60228,"_17581":103263,"_5":17476,"_23883":103216,"_2389":103264},[],"Certificado final y `device.crt`",{"_2862":60249,"_25248":60228,"_17581":103266,"_5":17476,"_23883":103216,"_2389":103267},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_2862":60250,"_25248":60228,"_17581":103269,"_5":17476,"_23883":103216,"_2389":103270},[],"Clave privada `device.key`",{"_2862":60251,"_25248":60228,"_17581":103272,"_5":17476,"_23883":103216,"_2389":103273},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_2862":60252,"_25248":60228,"_17581":103275,"_5":17476,"_23883":103216,"_2389":103276},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_2862":60253,"_25248":60228,"_17581":103278,"_5":17476,"_23883":103219,"_2389":103279},[],"Para operar certificados, continúa con Certificados y Validación.",{"_2862":60254,"_25248":60228,"_17581":103281,"_5":17476,"_23883":103219,"_2389":103282},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_2862":60255,"_25248":60228,"_17581":103284,"_5":17476,"_23883":103219,"_2389":103285},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_2862":60256,"_25248":60256,"_5":12326,"_2389":103287,"_25584":103288,"_17581":103290,"_23883":60256},"Resolución de problemas PKI",[40961,97440,46002,103289],"Resolución de problemas",[],{"_2862":60257,"_25248":60256,"_17581":103292,"_5":17476,"_23883":60256,"_2389":103293},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_2862":60258,"_25248":60256,"_5":25581,"_17581":103295,"_23883":103296,"_2389":103297},[],"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_2862":60259,"_25248":60256,"_5":25581,"_17581":103299,"_23883":103300,"_2389":103301},[],"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_2862":60260,"_25248":60256,"_5":25581,"_17581":103303,"_23883":103304,"_2389":103305},[],"/docs/pr-preview/pr-45/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_2862":60261,"_25248":60256,"_17581":103307,"_5":17476,"_23883":60256,"_2389":103308},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_2862":60262,"_25248":60256,"_17581":103310,"_5":17476,"_23883":60256,"_2389":103311},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_2862":60263,"_25248":60256,"_17581":103313,"_5":17476,"_23883":103296,"_2389":100642},[],{"_2862":60264,"_25248":60256,"_17581":103315,"_5":17476,"_23883":103296,"_2389":99571},[],{"_2862":60265,"_25248":60256,"_17581":103317,"_5":17476,"_23883":103296,"_2389":96146},[],{"_2862":60266,"_25248":60256,"_17581":103319,"_5":17476,"_23883":103296,"_2389":48337},[],{"_2862":60267,"_25248":60256,"_17581":103321,"_5":17476,"_23883":103296,"_2389":103322},[],"Existe, está activa y sus fechas son utilizables.",{"_2862":60268,"_25248":60256,"_17581":103324,"_5":17476,"_23883":103296,"_2389":103325},[],"Autoridades.",{"_2862":60269,"_25248":60256,"_17581":103327,"_5":17476,"_23883":103296,"_2389":103328},[],"Clave",{"_2862":60270,"_25248":60256,"_17581":103330,"_5":17476,"_23883":103296,"_2389":103331},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_2862":60271,"_25248":60256,"_17581":103333,"_5":17476,"_23883":103296,"_2389":103334},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_2862":60272,"_25248":60256,"_17581":103336,"_5":17476,"_23883":103296,"_2389":48355},[],{"_2862":60273,"_25248":60256,"_17581":103338,"_5":17476,"_23883":103296,"_2389":103339},[],"PEM correcto y firma verificable.",{"_2862":60274,"_25248":60256,"_17581":103341,"_5":17476,"_23883":103296,"_2389":48361},[],{"_2862":60275,"_25248":60256,"_17581":103343,"_5":17476,"_23883":103296,"_2389":103344},[],"Perfil",{"_2862":60276,"_25248":60256,"_17581":103346,"_5":17476,"_23883":103296,"_2389":103347},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_2862":60277,"_25248":60256,"_17581":103349,"_5":17476,"_23883":103296,"_2389":103350},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_2862":60278,"_25248":60256,"_17581":103352,"_5":17476,"_23883":103296,"_2389":100794},[],{"_2862":60279,"_25248":60256,"_17581":103354,"_5":17476,"_23883":103296,"_2389":103355},[],"Sujeto, SAN, usos y fechas adecuados.",{"_2862":60280,"_25248":60256,"_17581":103357,"_5":17476,"_23883":103296,"_2389":103358},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_2862":60281,"_25248":60256,"_17581":103360,"_5":17476,"_23883":103296,"_2389":103361},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_2862":60282,"_25248":60256,"_17581":103363,"_5":17476,"_23883":103296,"_2389":103364},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_2862":60283,"_25248":60256,"_17581":103366,"_5":17476,"_23883":103300,"_2389":103367},[],"Revisa cada frontera por separado:",{"_2862":60284,"_25248":60256,"_17581":103369,"_5":17476,"_23883":103300,"_2389":103370},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_2862":60285,"_25248":60256,"_17581":103372,"_5":17476,"_23883":103300,"_2389":103373},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_2862":60286,"_25248":60256,"_17581":103375,"_5":17476,"_23883":103300,"_2389":103376},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_2862":60287,"_25248":60256,"_17581":103378,"_5":17476,"_23883":103300,"_2389":103379},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_2862":60288,"_25248":60256,"_17581":103381,"_5":17476,"_23883":103300,"_2389":103382},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_2862":60289,"_25248":60256,"_17581":103384,"_5":17476,"_23883":103300,"_2389":103385},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_2862":60290,"_25248":60256,"_17581":103387,"_5":17476,"_23883":103304,"_2389":103388},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_2862":60291,"_25248":60256,"_17581":103390,"_5":17476,"_23883":103304,"_2389":103391},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_48415":103393,"_48417":103394,"_48419":103395,"_48421":103396,"_15203":2411,"_57916":2411},"spanish",[2389,2