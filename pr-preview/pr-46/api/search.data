450":102781,"_33452":102784,"_33454":102787,"_33456":102790,"_33458":102793,"_33460":102796,"_33462":102799,"_33464":102802,"_33466":102806,"_33468":102809,"_33470":102812,"_33472":102816,"_33474":102819,"_33476":102823,"_33478":102826,"_33480":102829,"_33482":102832,"_33484":102835,"_33486":102838,"_33488":102841,"_33490":102844,"_33492":102847,"_33494":102850,"_33496":102853,"_33498":102856,"_33500":102858,"_33502":102861,"_33504":102864,"_33506":102867,"_33508":102870,"_33510":102873,"_33512":102876,"_33514":102879,"_33516":102882,"_33518":102885,"_33520":102888,"_33522":102893,"_33524":102896,"_33526":102900,"_33528":102904,"_33530":102908,"_33532":102911,"_33534":102914,"_33536":102916,"_33538":102918,"_33540":102920,"_33542":102922,"_33544":102925,"_33546":102928,"_33548":102931,"_33550":102934,"_33552":102937,"_33554":102939,"_33556":102942,"_33558":102944,"_33560":102947,"_33562":102950,"_33564":102953,"_33566":102955,"_33568":102958,"_33570":102961,"_33572":102964,"_33574":102967,"_33576":102970,"_33578":102973,"_33580":102976,"_33582":102979,"_33584":102982,"_33586":102985,"_33588":102988,"_33590":102991},{"_2857":57688,"_25085":57688,"_5":12285,"_2384":95729,"_25421":95730,"_17521":95733,"_23752":57688},"Despliega desde AWS Marketplace",[40762,95731,95732],"Despliegue","Otros modelos",[],{"_2857":57689,"_25085":57688,"_17521":95735,"_5":17416,"_23752":57688,"_2384":95736},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_2857":57690,"_25085":57688,"_5":25418,"_17521":95738,"_23752":95739,"_2384":95740},[],"/docs/pr-preview/pr-46/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_2857":57691,"_25085":57688,"_5":25418,"_17521":95742,"_23752":95743,"_2384":95744},[],"/docs/pr-preview/pr-46/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_2857":57692,"_25085":57688,"_5":25418,"_17521":95746,"_23752":95747,"_2384":95748},[],"/docs/pr-preview/pr-46/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_2857":57693,"_25085":57688,"_5":25418,"_17521":95750,"_23752":95751,"_2384":95752},[],"/docs/pr-preview/pr-46/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_2857":57694,"_25085":57688,"_5":25418,"_17521":95754,"_23752":95755,"_2384":95756},[],"/docs/pr-preview/pr-46/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_2857":57695,"_25085":57688,"_5":25418,"_17521":95758,"_23752":95759,"_2384":95760},[],"/docs/pr-preview/pr-46/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_2857":57696,"_25085":57688,"_5":25418,"_17521":95762,"_23752":95763,"_2384":95764},[],"/docs/pr-preview/pr-46/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_2857":57697,"_25085":57688,"_17521":95766,"_5":17416,"_23752":57688,"_2384":95767},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_2857":57698,"_25085":57688,"_17521":95769,"_5":17416,"_23752":95739,"_2384":95770},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_2857":57699,"_25085":57688,"_17521":95772,"_5":17416,"_23752":95739,"_2384":95773},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_2857":57700,"_25085":57688,"_17521":95775,"_5":17416,"_23752":95739,"_2384":95776},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_2857":57701,"_25085":57688,"_17521":95778,"_5":17416,"_23752":95743,"_2384":95779},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_2857":57702,"_25085":57688,"_17521":95781,"_5":17416,"_23752":95743,"_2384":95782},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_2857":57703,"_25085":57688,"_17521":95784,"_5":17416,"_23752":95743,"_2384":95785},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_2857":57704,"_25085":57688,"_17521":95787,"_5":17416,"_23752":95747,"_2384":95788},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_2857":57705,"_25085":57688,"_17521":95790,"_5":17416,"_23752":95751,"_2384":95791},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_2857":57706,"_25085":57688,"_17521":95793,"_5":17416,"_23752":95755,"_2384":95794},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_2857":57707,"_25085":57688,"_17521":95796,"_5":17416,"_23752":95759,"_2384":95797},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_2857":57708,"_25085":57688,"_17521":95799,"_5":17416,"_23752":95763,"_2384":95800},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_2857":57709,"_25085":57709,"_5":12285,"_2384":95802,"_25421":95803,"_17521":95804,"_23752":57709},"Despliega Lamassu",[40762,95731],[],{"_2857":57710,"_25085":57709,"_17521":95806,"_5":17416,"_23752":57709,"_2384":95807},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_2857":57711,"_25085":57709,"_5":25418,"_17521":95809,"_23752":95810,"_2384":95811},[],"/docs/pr-preview/pr-46/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_2857":57712,"_25085":57709,"_5":25418,"_17521":95813,"_23752":95814,"_2384":95815},[],"/docs/pr-preview/pr-46/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_2857":57713,"_25085":57709,"_5":25418,"_17521":95817,"_23752":95818,"_2384":95819},[],"/docs/pr-preview/pr-46/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_2857":57714,"_25085":57709,"_17521":95821,"_5":17416,"_23752":57709,"_2384":95822},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_2857":57715,"_25085":57709,"_17521":95824,"_5":17416,"_23752":95810,"_2384":95825},[],"Modelo",{"_2857":57716,"_25085":57709,"_17521":95827,"_5":17416,"_23752":95810,"_2384":95828},[],"Recomendado para",{"_2857":57717,"_25085":57709,"_17521":95830,"_5":17416,"_23752":95810,"_2384":95831},[],"Quién opera la infraestructura",{"_2857":57718,"_25085":57709,"_17521":95833,"_5":17416,"_23752":95810,"_2384":95834},[],"Punto de partida",{"_2857":57719,"_25085":57709,"_17521":95836,"_5":17416,"_23752":95810,"_2384":40869},[],{"_2857":57720,"_25085":57709,"_17521":95838,"_5":17416,"_23752":95810,"_2384":95839},[],"Producción, entornos regulados y despliegues personalizados",{"_2857":57721,"_25085":57709,"_17521":95841,"_5":17416,"_23752":95810,"_2384":95842},[],"Tu equipo",{"_2857":57722,"_25085":57709,"_17521":95844,"_5":17416,"_23752":95810,"_2384":95845},[],"Helm o Fastlane",{"_2857":57723,"_25085":57709,"_17521":95847,"_5":17416,"_23752":95810,"_2384":40881},[],{"_2857":57724,"_25085":57709,"_17521":95849,"_5":17416,"_23752":95810,"_2384":95850},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_2857":57725,"_25085":57709,"_17521":95852,"_5":17416,"_23752":95810,"_2384":95842},[],{"_2857":57726,"_25085":57709,"_17521":95854,"_5":17416,"_23752":95810,"_2384":95855},[],"Imagen preconfigurada en EC2",{"_2857":57727,"_25085":57709,"_17521":95857,"_5":17416,"_23752":95810,"_2384":40892},[],{"_2857":57728,"_25085":57709,"_17521":95859,"_5":17416,"_23752":95810,"_2384":95860},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_2857":57729,"_25085":57709,"_17521":95862,"_5":17416,"_23752":95810,"_2384":40898},[],{"_2857":57730,"_25085":57709,"_17521":95864,"_5":17416,"_23752":95810,"_2384":95865},[],"Suscripción gestionada",{"_2857":57731,"_25085":57709,"_17521":95867,"_5":17416,"_23752":95810,"_2384":95868},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2857":57732,"_25085":57709,"_17521":95870,"_5":17416,"_23752":95810,"_2384":95871},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2857":57733,"_25085":57709,"_17521":95873,"_5":17416,"_23752":95810,"_2384":95874},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_2857":57734,"_25085":57709,"_17521":95876,"_5":17416,"_23752":95814,"_2384":95877},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_2857":57735,"_25085":57709,"_17521":95879,"_5":17416,"_23752":95818,"_2384":95880},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_2857":57736,"_25085":57736,"_5":12285,"_2384":95882,"_25421":95883,"_17521":95884,"_23752":57736},"Utiliza Lamassu como SaaS",[40762,95731,95732],[],{"_2857":57737,"_25085":57736,"_17521":95886,"_5":17416,"_23752":57736,"_2384":95887},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_2857":57738,"_25085":57736,"_5":25418,"_17521":95889,"_23752":95890,"_2384":95891},[],"/docs/pr-preview/pr-46/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_2857":57739,"_25085":57736,"_5":25418,"_17521":95893,"_23752":95894,"_2384":95895},[],"/docs/pr-preview/pr-46/es/deployment/saas#planes","Planes",{"_2857":57740,"_25085":57736,"_5":25418,"_17521":95897,"_23752":95898,"_2384":95899},[],"/docs/pr-preview/pr-46/es/deployment/saas#solicita-acceso","Solicita acceso",{"_2857":57741,"_25085":57736,"_17521":95901,"_5":17416,"_23752":57736,"_2384":95902},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_2857":57742,"_25085":57736,"_17521":95904,"_5":17416,"_23752":95890,"_2384":95905},[],"Disponibilidad y mantenimiento de la plataforma.",{"_2857":57743,"_25085":57736,"_17521":95907,"_5":17416,"_23752":95890,"_2384":95908},[],"Copias de seguridad automáticas.",{"_2857":57744,"_25085":57736,"_17521":95910,"_5":17416,"_23752":95890,"_2384":95911},[],"Actualizaciones de versión.",{"_2857":57745,"_25085":57736,"_17521":95913,"_5":17416,"_23752":95890,"_2384":95914},[],"Soporte técnico y SLA según el plan contratado.",{"_2857":57746,"_25085":57736,"_17521":95916,"_5":17416,"_23752":95894,"_2384":40953},[],{"_2857":57747,"_25085":57736,"_17521":95918,"_5":17416,"_23752":95894,"_2384":95919},[],"Dispositivos",{"_2857":57748,"_25085":57736,"_17521":95921,"_5":17416,"_23752":95894,"_2384":95922},[],"Soporte",{"_2857":57749,"_25085":57736,"_17521":95924,"_5":17416,"_23752":95894,"_2384":40962},[],{"_2857":57750,"_25085":57736,"_17521":95926,"_5":17416,"_23752":95894,"_2384":40965},[],{"_2857":57751,"_25085":57736,"_17521":95928,"_5":17416,"_23752":95894,"_2384":95929},[],"Hasta 1.000",{"_2857":57752,"_25085":57736,"_17521":95931,"_5":17416,"_23752":95894,"_2384":40971},[],{"_2857":57753,"_25085":57736,"_17521":95933,"_5":17416,"_23752":95894,"_2384":95934},[],"99,5 %",{"_2857":57754,"_25085":57736,"_17521":95936,"_5":17416,"_23752":95894,"_2384":40977},[],{"_2857":57755,"_25085":57736,"_17521":95938,"_5":17416,"_23752":95894,"_2384":95939},[],"Hasta 10.000",{"_2857":57756,"_25085":57736,"_17521":95941,"_5":17416,"_23752":95894,"_2384":95942},[],"Email y chat",{"_2857":57757,"_25085":57736,"_17521":95944,"_5":17416,"_23752":95894,"_2384":95945},[],"99,9 %",{"_2857":57758,"_25085":57736,"_17521":95947,"_5":17416,"_23752":95894,"_2384":40989},[],{"_2857":57759,"_25085":57736,"_17521":95949,"_5":17416,"_23752":95894,"_2384":95950},[],"Ilimitados",{"_2857":57760,"_25085":57736,"_17521":95952,"_5":17416,"_23752":95894,"_2384":95953},[],"Dedicado",{"_2857":57761,"_25085":57736,"_17521":95955,"_5":17416,"_23752":95894,"_2384":95956},[],"99,99 %",{"_2857":57762,"_25085":57736,"_17521":95958,"_5":17416,"_23752":95898,"_2384":95959},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_2857":57763,"_25085":57736,"_17521":95961,"_5":17416,"_23752":95898,"_2384":95962},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_2857":57764,"_25085":57764,"_5":12285,"_2384":41006,"_25421":95964,"_17521":95966,"_23752":57764},[40762,95731,95965],"Kubernetes autogestionado",[],{"_2857":57765,"_25085":57764,"_17521":95968,"_5":17416,"_23752":57764,"_2384":95969},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_2857":57766,"_25085":57764,"_5":25418,"_17521":95971,"_23752":95972,"_2384":95973},[],"/docs/pr-preview/pr-46/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_2857":57767,"_25085":57764,"_5":25418,"_17521":95975,"_23752":95976,"_2384":95977},[],"/docs/pr-preview/pr-46/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_2857":57768,"_25085":57764,"_5":25418,"_17521":95979,"_23752":95980,"_2384":95981},[],"/docs/pr-preview/pr-46/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_2857":57769,"_25085":57764,"_5":25418,"_17521":95983,"_23752":95984,"_2384":95985},[],"/docs/pr-preview/pr-46/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_2857":57770,"_25085":57764,"_5":25418,"_17521":95987,"_23752":95988,"_2384":95989},[],"/docs/pr-preview/pr-46/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_2857":57771,"_25085":57764,"_5":25418,"_17521":95991,"_23752":95992,"_2384":95993},[],"/docs/pr-preview/pr-46/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_2857":57772,"_25085":57764,"_5":25418,"_17521":95995,"_23752":95996,"_2384":95997},[],"/docs/pr-preview/pr-46/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_2857":57773,"_25085":57764,"_5":25418,"_17521":95999,"_23752":96000,"_2384":96001},[],"/docs/pr-preview/pr-46/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_2857":57774,"_25085":57764,"_5":25418,"_17521":96003,"_23752":96004,"_2384":96005},[],"/docs/pr-preview/pr-46/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_2857":57775,"_25085":57764,"_5":25418,"_17521":96007,"_23752":96008,"_2384":96009},[],"/docs/pr-preview/pr-46/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_2857":57776,"_25085":57764,"_17521":96011,"_5":17416,"_23752":95972,"_2384":96012},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_2857":57777,"_25085":57764,"_17521":96014,"_5":17416,"_23752":95972,"_2384":96015},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_2857":57778,"_25085":57764,"_17521":96017,"_5":17416,"_23752":95976,"_2384":96018},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_2857":57779,"_25085":57764,"_17521":96020,"_5":17416,"_23752":95976,"_2384":96021},[],"Fastlane instala o configura",{"_2857":57780,"_25085":57764,"_17521":96023,"_5":17416,"_23752":95976,"_2384":96024},[],"Tú sigues proporcionando",{"_2857":57781,"_25085":57764,"_17521":96026,"_5":17416,"_23752":95976,"_2384":96027},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_2857":57782,"_25085":57764,"_17521":96029,"_5":17416,"_23752":95976,"_2384":96030},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_2857":57783,"_25085":57764,"_17521":96032,"_5":17416,"_23752":95976,"_2384":96033},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_2857":57784,"_25085":57764,"_17521":96035,"_5":17416,"_23752":95976,"_2384":96036},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_2857":57785,"_25085":57764,"_17521":96038,"_5":17416,"_23752":95976,"_2384":96039},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_2857":57786,"_25085":57764,"_17521":96041,"_5":17416,"_23752":95976,"_2384":96042},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_2857":57787,"_25085":57764,"_17521":96044,"_5":17416,"_23752":95976,"_2384":96045},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_2857":57788,"_25085":57764,"_17521":96047,"_5":17416,"_23752":95976,"_2384":96048},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_2857":57789,"_25085":57764,"_17521":96050,"_5":17416,"_23752":95976,"_2384":96051},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_2857":57790,"_25085":57764,"_17521":96053,"_5":17416,"_23752":95980,"_2384":96054},[],"Necesitas:",{"_2857":57791,"_25085":57764,"_17521":96056,"_5":17416,"_23752":95980,"_2384":96057},[],"un clúster Kubernetes existente",{"_2857":57792,"_25085":57764,"_17521":96059,"_5":17416,"_23752":95980,"_2384":96060},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_2857":57793,"_25085":57764,"_17521":96062,"_5":17416,"_23752":95980,"_2384":41104},[],{"_2857":57794,"_25085":57764,"_17521":96064,"_5":17416,"_23752":95980,"_2384":19826},[],{"_2857":57795,"_25085":57764,"_17521":96066,"_5":17416,"_23752":95980,"_2384":96067},[],"`jq` solo si usas `--sample-data`",{"_2857":57796,"_25085":57764,"_17521":96069,"_5":17416,"_23752":95980,"_2384":96070},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_2857":57797,"_25085":57764,"_17521":96072,"_5":17416,"_23752":95980,"_2384":96073},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_2857":57798,"_25085":57764,"_17521":96075,"_5":17416,"_23752":95980,"_2384":96076},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_2857":57799,"_25085":57764,"_17521":96078,"_5":17416,"_23752":95984,"_2384":96079},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_2857":57800,"_25085":57764,"_17521":96081,"_5":17416,"_23752":95984,"_2384":96082},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_2857":57801,"_25085":57764,"_17521":96084,"_5":17416,"_23752":95988,"_2384":96085},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_2857":57802,"_25085":57764,"_17521":96087,"_5":17416,"_23752":95988,"_2384":96088},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_2857":57803,"_25085":57764,"_17521":96090,"_5":17416,"_23752":95988,"_2384":96091},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_2857":57804,"_25085":57764,"_17521":96093,"_5":17416,"_23752":95988,"_2384":96094},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_2857":57805,"_25085":57764,"_17521":96096,"_5":17416,"_23752":95992,"_2384":96097},[],"Opción",{"_2857":57806,"_25085":57764,"_17521":96099,"_5":17416,"_23752":95992,"_2384":96100},[],"Valor predeterminado",{"_2857":57807,"_25085":57764,"_17521":96102,"_5":17416,"_23752":95992,"_2384":96103},[],"Propósito",{"_2857":57808,"_25085":57764,"_17521":96105,"_5":17416,"_23752":95992,"_2384":41148},[],{"_2857":57809,"_25085":57764,"_17521":96107,"_5":17416,"_23752":95992,"_2384":41151},[],{"_2857":57810,"_25085":57764,"_17521":96109,"_5":17416,"_23752":95992,"_2384":96110},[],"Muestra la ayuda",{"_2857":57811,"_25085":57764,"_17521":96112,"_5":17416,"_23752":95992,"_2384":41157},[],{"_2857":57812,"_25085":57764,"_17521":96114,"_5":17416,"_23752":95992,"_2384":96115},[],"contexto actual",{"_2857":57813,"_25085":57764,"_17521":96117,"_5":17416,"_23752":95992,"_2384":96118},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_2857":57814,"_25085":57764,"_17521":96120,"_5":17416,"_23752":95992,"_2384":41166},[],{"_2857":57815,"_25085":57764,"_17521":96122,"_5":17416,"_23752":95992,"_2384":5349},[],{"_2857":57816,"_25085":57764,"_17521":96124,"_5":17416,"_23752":95992,"_2384":96125},[],"Omite prompts y genera credenciales para las dependencias",{"_2857":57817,"_25085":57764,"_17521":96127,"_5":17416,"_23752":95992,"_2384":41174},[],{"_2857":57818,"_25085":57764,"_17521":96129,"_5":17416,"_23752":95992,"_2384":41177},[],{"_2857":57819,"_25085":57764,"_17521":96131,"_5":17416,"_23752":95992,"_2384":96132},[],"Namespace de la instalación",{"_2857":57820,"_25085":57764,"_17521":96134,"_5":17416,"_23752":95992,"_2384":41183},[],{"_2857":57821,"_25085":57764,"_17521":96136,"_5":17416,"_23752":95992,"_2384":41186},[],{"_2857":57822,"_25085":57764,"_17521":96138,"_5":17416,"_23752":95992,"_2384":96139},[],"Dominio usado por la UI, OIDC y el certificado",{"_2857":57823,"_25085":57764,"_17521":96141,"_5":17416,"_23752":95992,"_2384":41192},[],{"_2857":57824,"_25085":57764,"_17521":96143,"_5":17416,"_23752":95992,"_2384":12511},[],{"_2857":57825,"_25085":57764,"_17521":96145,"_5":17416,"_23752":95992,"_2384":96146},[],"Versión del chart de Lamassu",{"_2857":57826,"_25085":57764,"_17521":96148,"_5":17416,"_23752":95992,"_2384":41200},[],{"_2857":57827,"_25085":57764,"_17521":96150,"_5":17416,"_23752":95992,"_2384":41203},[],{"_2857":57828,"_25085":57764,"_17521":96152,"_5":17416,"_23752":95992,"_2384":96153},[],"Puerto del listener HTTPS",{"_2857":57829,"_25085":57764,"_17521":96155,"_5":17416,"_23752":95992,"_2384":41209},[],{"_2857":57830,"_25085":57764,"_17521":96157,"_5":17416,"_23752":95992,"_2384":41212},[],{"_2857":57831,"_25085":57764,"_17521":96159,"_5":17416,"_23752":95992,"_2384":96160},[],"Puerto del listener HTTP",{"_2857":57832,"_25085":57764,"_17521":96162,"_5":17416,"_23752":95992,"_2384":41218},[],{"_2857":57833,"_25085":57764,"_17521":96164,"_5":17416,"_23752":95992,"_2384":41151},[],{"_2857":57834,"_25085":57764,"_17521":96166,"_5":17416,"_23752":95992,"_2384":96167},[],"Certificado PEM para TLS downstream",{"_2857":57835,"_25085":57764,"_17521":96169,"_5":17416,"_23752":95992,"_2384":41226},[],{"_2857":57836,"_25085":57764,"_17521":96171,"_5":17416,"_23752":95992,"_2384":41151},[],{"_2857":57837,"_25085":57764,"_17521":96173,"_5":17416,"_23752":95992,"_2384":96174},[],"Clave privada PEM para TLS downstream",{"_2857":57838,"_25085":57764,"_17521":96176,"_5":17416,"_23752":95992,"_2384":41234},[],{"_2857":57839,"_25085":57764,"_17521":96178,"_5":17416,"_23752":95992,"_2384":96179},[],"chart del repositorio",{"_2857":57840,"_25085":57764,"_17521":96181,"_5":17416,"_23752":95992,"_2384":96182},[],"Usa un chart local de Lamassu sin empaquetar",{"_2857":57841,"_25085":57764,"_17521":96184,"_5":17416,"_23752":95992,"_2384":41243},[],{"_2857":57842,"_25085":57764,"_17521":96186,"_5":17416,"_23752":95992,"_2384":96187},[],"detección automática",{"_2857":57843,"_25085":57764,"_17521":96189,"_5":17416,"_23752":95992,"_2384":96190},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_2857":57844,"_25085":57764,"_17521":96192,"_5":17416,"_23752":95992,"_2384":41251},[],{"_2857":57845,"_25085":57764,"_17521":96194,"_5":17416,"_23752":95992,"_2384":5349},[],{"_2857":57846,"_25085":57764,"_17521":96196,"_5":17416,"_23752":95992,"_2384":96197},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_2857":57847,"_25085":57764,"_17521":96199,"_5":17416,"_23752":95992,"_2384":41259},[],{"_2857":57848,"_25085":57764,"_17521":96201,"_5":17416,"_23752":95992,"_2384":5349},[],{"_2857":57849,"_25085":57764,"_17521":96203,"_5":17416,"_23752":95992,"_2384":96204},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_2857":57850,"_25085":57764,"_17521":96206,"_5":17416,"_23752":95992,"_2384":41267},[],{"_2857":57851,"_25085":57764,"_17521":96208,"_5":17416,"_23752":95992,"_2384":5349},[],{"_2857":57852,"_25085":57764,"_17521":96210,"_5":17416,"_23752":95992,"_2384":96211},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_2857":57853,"_25085":57764,"_17521":96213,"_5":17416,"_23752":95992,"_2384":41275},[],{"_2857":57854,"_25085":57764,"_17521":96215,"_5":17416,"_23752":95992,"_2384":41278},[],{"_2857":57855,"_25085":57764,"_17521":96217,"_5":17416,"_23752":95992,"_2384":96218},[],"Usa otro chart local de SoftHSM",{"_2857":57856,"_25085":57764,"_17521":96220,"_5":17416,"_23752":95992,"_2384":96221},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_2857":57857,"_25085":57764,"_17521":96223,"_5":17416,"_23752":95996,"_2384":41287},[],{"_2857":57858,"_25085":57764,"_17521":96225,"_5":17416,"_23752":95996,"_2384":96226},[],"valida las herramientas locales y el clúster seleccionado",{"_2857":57859,"_25085":57764,"_17521":96228,"_5":17416,"_23752":95996,"_2384":96229},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_2857":57860,"_25085":57764,"_17521":96231,"_5":17416,"_23752":95996,"_2384":96232},[],"crea el namespace",{"_2857":57861,"_25085":57764,"_17521":96234,"_5":17416,"_23752":95996,"_2384":96235},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_2857":57862,"_25085":57764,"_17521":96237,"_5":17416,"_23752":95996,"_2384":96238},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_2857":57863,"_25085":57764,"_17521":96240,"_5":17416,"_23752":95996,"_2384":96241},[],"instala RabbitMQ",{"_2857":57864,"_25085":57764,"_17521":96243,"_5":17416,"_23752":95996,"_2384":96244},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_2857":57865,"_25085":57764,"_17521":96246,"_5":17416,"_23752":95996,"_2384":96247},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_2857":57866,"_25085":57764,"_17521":96249,"_5":17416,"_23752":95996,"_2384":96250},[],"carga datos de ejemplo opcionalmente",{"_2857":57867,"_25085":57764,"_17521":96252,"_5":17416,"_23752":95996,"_2384":96253},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_2857":57868,"_25085":57764,"_17521":96255,"_5":17416,"_23752":96000,"_2384":96256},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_2857":57869,"_25085":57764,"_17521":96258,"_5":17416,"_23752":96000,"_2384":96259},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_2857":57870,"_25085":57764,"_17521":96261,"_5":17416,"_23752":96004,"_2384":96262},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso.",{"_2857":57871,"_25085":57764,"_17521":96264,"_5":17416,"_23752":96004,"_2384":96265},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_2857":57872,"_25085":57764,"_17521":96267,"_5":17416,"_23752":96004,"_2384":96268},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_2857":57873,"_25085":57764,"_17521":96270,"_5":17416,"_23752":96008,"_2384":96271},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_2857":57874,"_25085":57874,"_5":12285,"_2384":96273,"_25421":96274,"_17521":96275,"_23752":57874},"Instala con Helm",[40762,95731,95965],[],{"_2857":57875,"_25085":57874,"_17521":96277,"_5":17416,"_23752":57874,"_2384":96278},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_2857":57876,"_25085":57874,"_5":25418,"_17521":96280,"_23752":96281,"_2384":96282},[],"/docs/pr-preview/pr-46/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_2857":57877,"_25085":57874,"_5":25418,"_17521":96284,"_23752":96285,"_2384":95981},[],"/docs/pr-preview/pr-46/es/deployment/self-hosted/helm#antes-de-comenzar",{"_2857":57878,"_25085":57874,"_5":25418,"_17521":96287,"_23752":96288,"_2384":96289},[],"/docs/pr-preview/pr-46/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_2857":57879,"_25085":57874,"_5":25418,"_17521":96291,"_23752":96292,"_2384":96293},[],"/docs/pr-preview/pr-46/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_2857":57880,"_25085":57874,"_5":25418,"_17521":96295,"_23752":96296,"_2384":96297},[],"/docs/pr-preview/pr-46/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_2857":57881,"_25085":57874,"_5":25418,"_17521":96299,"_23752":96300,"_2384":96301},[],"/docs/pr-preview/pr-46/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_2857":57882,"_25085":57874,"_5":25418,"_17521":96303,"_23752":96304,"_2384":96305},[],"/docs/pr-preview/pr-46/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_2857":57883,"_25085":57874,"_5":25418,"_17521":96307,"_23752":96308,"_2384":96309},[],"/docs/pr-preview/pr-46/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_2857":57884,"_25085":57874,"_5":25418,"_17521":96311,"_23752":96312,"_2384":96313},[],"/docs/pr-preview/pr-46/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_2857":57885,"_25085":57874,"_17521":96315,"_5":17416,"_23752":96281,"_2384":96316},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_2857":57886,"_25085":57874,"_17521":96318,"_5":17416,"_23752":96285,"_2384":96319},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_2857":57887,"_25085":57874,"_17521":96321,"_5":17416,"_23752":96285,"_2384":96322},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_2857":57888,"_25085":57874,"_17521":96324,"_5":17416,"_23752":96285,"_2384":96325},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_2857":57889,"_25085":57874,"_17521":96327,"_5":17416,"_23752":96285,"_2384":96328},[],"un broker RabbitMQ accesible y sus credenciales",{"_2857":57890,"_25085":57874,"_17521":96330,"_5":17416,"_23752":96285,"_2384":96331},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_2857":57891,"_25085":57874,"_17521":96333,"_5":17416,"_23752":96285,"_2384":96334},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_2857":57892,"_25085":57874,"_17521":96336,"_5":17416,"_23752":96285,"_2384":96337},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_2857":57893,"_25085":57874,"_17521":96339,"_5":17416,"_23752":96285,"_2384":96340},[],"una StorageClass y un diseño de tráfico externo",{"_2857":57894,"_25085":57874,"_17521":96342,"_5":17416,"_23752":96285,"_2384":96343},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_2857":57895,"_25085":57874,"_17521":96345,"_5":17416,"_23752":96285,"_2384":96346},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_2857":57896,"_25085":57874,"_17521":96348,"_5":17416,"_23752":96285,"_2384":96349},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_2857":57897,"_25085":57874,"_17521":96351,"_5":17416,"_23752":96288,"_2384":96352},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_2857":57898,"_25085":57874,"_17521":96354,"_5":17416,"_23752":96288,"_2384":96355},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_2857":57899,"_25085":57874,"_17521":96357,"_5":17416,"_23752":96288,"_2384":96358},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_2857":57900,"_25085":57874,"_17521":96360,"_5":17416,"_23752":96292,"_2384":96361},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_2857":57901,"_25085":57874,"_17521":96363,"_5":17416,"_23752":96292,"_2384":96364},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_2857":57902,"_25085":57874,"_17521":96366,"_5":17416,"_23752":96292,"_2384":96367},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_2857":57903,"_25085":57874,"_17521":96369,"_5":17416,"_23752":96296,"_2384":96370},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_2857":57904,"_25085":57874,"_17521":96372,"_5":17416,"_23752":96300,"_2384":96373},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_2857":57905,"_25085":57874,"_17521":96375,"_5":17416,"_23752":96300,"_2384":96376},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_2857":57906,"_25085":57874,"_17521":96378,"_5":17416,"_23752":96300,"_2384":96379},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_2857":57907,"_25085":57874,"_17521":96381,"_5":17416,"_23752":96300,"_2384":96382},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_2857":57908,"_25085":57874,"_17521":96384,"_5":17416,"_23752":96304,"_2384":96385},[],"Para instalar un checkout local:",{"_2857":57909,"_25085":57874,"_17521":96387,"_5":17416,"_23752":96308,"_2384":96388},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_2857":57910,"_25085":57874,"_17521":96390,"_5":17416,"_23752":96308,"_2384":96391},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_2857":57911,"_25085":57874,"_17521":96393,"_5":17416,"_23752":96312,"_2384":96394},[],"Antes de pasar a producción, revisa:",{"_2857":57912,"_25085":57874,"_17521":96396,"_5":17416,"_23752":96312,"_2384":96397},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_2857":57913,"_25085":57874,"_17521":96399,"_5":17416,"_23752":96312,"_2384":96400},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_2857":57914,"_25085":57874,"_17521":96402,"_5":17416,"_23752":96312,"_2384":96403},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_2857":57915,"_25085":57874,"_17521":96405,"_5":17416,"_23752":96312,"_2384":96406},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_2857":57916,"_25085":57874,"_17521":96408,"_5":17416,"_23752":96312,"_2384":96409},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_2857":57917,"_25085":57874,"_17521":96411,"_5":17416,"_23752":96312,"_2384":96412},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_2857":57918,"_25085":57874,"_17521":96414,"_5":17416,"_23752":96312,"_2384":96415},[],"SMTP, observabilidad y entrega de alertas",{"_2857":57919,"_25085":57874,"_17521":96417,"_5":17416,"_23752":96312,"_2384":96418},[],"las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_2857":57920,"_25085":57874,"_17521":96420,"_5":17416,"_23752":96312,"_2384":96421},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_2857":57921,"_25085":57921,"_5":12285,"_2384":96423,"_25421":96424,"_17521":96425,"_23752":57921},"Expón el Gateway",[40762,95731,95965],[],{"_2857":57922,"_25085":57921,"_17521":96427,"_5":17416,"_23752":57921,"_2384":96428},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_2857":57923,"_25085":57921,"_5":25418,"_17521":96430,"_23752":96431,"_2384":96432},[],"/docs/pr-preview/pr-46/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_2857":57924,"_25085":57921,"_5":25418,"_17521":96434,"_23752":96435,"_2384":96436},[],"/docs/pr-preview/pr-46/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_2857":57925,"_25085":57921,"_5":25418,"_17521":96438,"_23752":96439,"_2384":96440},[],"/docs/pr-preview/pr-46/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_2857":57926,"_25085":57921,"_5":25418,"_17521":96442,"_23752":96443,"_2384":41508},[],"/docs/pr-preview/pr-46/es/deployment/self-hosted/networking#k3s",{"_2857":57927,"_25085":57921,"_5":25418,"_17521":96445,"_23752":96446,"_2384":96447},[],"/docs/pr-preview/pr-46/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_2857":57928,"_25085":57921,"_5":25418,"_17521":96449,"_23752":96450,"_2384":96451},[],"/docs/pr-preview/pr-46/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_2857":57929,"_25085":57921,"_5":25418,"_17521":96453,"_23752":96454,"_2384":96455},[],"/docs/pr-preview/pr-46/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_2857":57930,"_25085":57921,"_5":25418,"_17521":96457,"_23752":96458,"_2384":96459},[],"/docs/pr-preview/pr-46/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_2857":57931,"_25085":57921,"_5":25418,"_17521":96461,"_23752":96462,"_2384":96463},[],"/docs/pr-preview/pr-46/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_2857":57932,"_25085":57921,"_17521":96465,"_5":17416,"_23752":96431,"_2384":96466},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_2857":57933,"_25085":57921,"_17521":96468,"_5":17416,"_23752":96431,"_2384":96469},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_2857":57934,"_25085":57921,"_17521":96471,"_5":17416,"_23752":96435,"_2384":96472},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_2857":57935,"_25085":57921,"_17521":96474,"_5":17416,"_23752":96435,"_2384":96475},[],"Defínelo únicamente cuando:",{"_2857":57936,"_25085":57921,"_17521":96477,"_5":17416,"_23752":96435,"_2384":96478},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_2857":57937,"_25085":57921,"_17521":96480,"_5":17416,"_23752":96435,"_2384":96481},[],"esa dirección está asignada a este Gateway",{"_2857":57938,"_25085":57921,"_17521":96483,"_5":17416,"_23752":96435,"_2384":96484},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_2857":57939,"_25085":57921,"_17521":96486,"_5":17416,"_23752":96435,"_2384":96487},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_2857":57940,"_25085":57921,"_17521":96489,"_5":17416,"_23752":96435,"_2384":96490},[],"No confundas estos valores:",{"_2857":57941,"_25085":57921,"_17521":96492,"_5":17416,"_23752":96435,"_2384":96493},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_2857":57942,"_25085":57921,"_17521":96495,"_5":17416,"_23752":96435,"_2384":96496},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_2857":57943,"_25085":57921,"_17521":96498,"_5":17416,"_23752":96435,"_2384":96499},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_2857":57944,"_25085":57921,"_17521":96501,"_5":17416,"_23752":96439,"_2384":96502},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_2857":57945,"_25085":57921,"_17521":96504,"_5":17416,"_23752":96439,"_2384":96505},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_2857":57946,"_25085":57921,"_17521":96507,"_5":17416,"_23752":96443,"_2384":96508},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_2857":57947,"_25085":57921,"_17521":96510,"_5":17416,"_23752":96443,"_2384":96511},[],"Para el diseño recomendado:",{"_2857":57948,"_25085":57921,"_17521":96513,"_5":17416,"_23752":96443,"_2384":96514},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_2857":57949,"_25085":57921,"_17521":96516,"_5":17416,"_23752":96443,"_2384":96517},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_2857":57950,"_25085":57921,"_17521":96519,"_5":17416,"_23752":96443,"_2384":96520},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_2857":57951,"_25085":57921,"_17521":96522,"_5":17416,"_23752":96443,"_2384":96523},[],"Apunta DNS a la dirección accesible de la VM.",{"_2857":57952,"_25085":57921,"_17521":96525,"_5":17416,"_23752":96443,"_2384":96526},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_2857":57953,"_25085":57921,"_17521":96528,"_5":17416,"_23752":96446,"_2384":96529},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_2857":57954,"_25085":57921,"_17521":96531,"_5":17416,"_23752":96450,"_2384":96532},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_2857":57955,"_25085":57921,"_17521":96534,"_5":17416,"_23752":96450,"_2384":96535},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_2857":57956,"_25085":57921,"_17521":96537,"_5":17416,"_23752":96454,"_2384":96538},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_2857":57957,"_25085":57921,"_17521":96540,"_5":17416,"_23752":96454,"_2384":96541},[],"Requisito",{"_2857":57958,"_25085":57921,"_17521":96543,"_5":17416,"_23752":96454,"_2384":96544},[],"Diseño recomendado",{"_2857":57959,"_25085":57921,"_17521":96546,"_5":17416,"_23752":96454,"_2384":96547},[],"Consecuencia",{"_2857":57960,"_25085":57921,"_17521":96549,"_5":17416,"_23752":96454,"_2384":96550},[],"Varias URL o servicios de Lamassu",{"_2857":57961,"_25085":57921,"_17521":96552,"_5":17416,"_23752":96454,"_2384":96553},[],"Un Gateway con varias rutas",{"_2857":57962,"_25085":57921,"_17521":96555,"_5":17416,"_23752":96454,"_2384":96556},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_2857":57963,"_25085":57921,"_17521":96558,"_5":17416,"_23752":96454,"_2384":96559},[],"Gateways independientes e IP externas distintas",{"_2857":57964,"_25085":57921,"_17521":96561,"_5":17416,"_23752":96454,"_2384":96562},[],"Una VIP por Gateway",{"_2857":57965,"_25085":57921,"_17521":96564,"_5":17416,"_23752":96454,"_2384":96565},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_2857":57966,"_25085":57921,"_17521":96567,"_5":17416,"_23752":96454,"_2384":96568},[],"Gateways independientes, un nodo y una IP",{"_2857":57967,"_25085":57921,"_17521":96570,"_5":17416,"_23752":96454,"_2384":96571},[],"Puertos externos diferentes",{"_2857":57968,"_25085":57921,"_17521":96573,"_5":17416,"_23752":96454,"_2384":96574},[],"Los clientes deben indicar puertos no estándar",{"_2857":57969,"_25085":57921,"_17521":96576,"_5":17416,"_23752":96454,"_2384":96577},[],"Terminación TLS/mTLS separada detrás de una IP",{"_2857":57970,"_25085":57921,"_17521":96579,"_5":17416,"_23752":96454,"_2384":96580},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_2857":57971,"_25085":57921,"_17521":96582,"_5":17416,"_23752":96454,"_2384":96583},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_2857":57972,"_25085":57921,"_17521":96585,"_5":17416,"_23752":96454,"_2384":96586},[],"Recursos Gateway separados pero proxy compartido",{"_2857":57973,"_25085":57921,"_17521":96588,"_5":17416,"_23752":96454,"_2384":96589},[],"Modo merged Gateway de Envoy",{"_2857":57974,"_25085":57921,"_17521":96591,"_5":17416,"_23752":96454,"_2384":96592},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_2857":57975,"_25085":57921,"_17521":96594,"_5":17416,"_23752":96454,"_2384":96595},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_2857":57976,"_25085":57921,"_17521":96597,"_5":17416,"_23752":96454,"_2384":96598},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_2857":57977,"_25085":57921,"_17521":96600,"_5":17416,"_23752":96454,"_2384":96601},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_2857":57978,"_25085":57921,"_17521":96603,"_5":17416,"_23752":96454,"_2384":96604},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_2857":57979,"_25085":57921,"_17521":96606,"_5":17416,"_23752":96458,"_2384":96607},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_2857":57980,"_25085":57921,"_17521":96609,"_5":17416,"_23752":96458,"_2384":96610},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_2857":57981,"_25085":57921,"_17521":96612,"_5":17416,"_23752":96458,"_2384":96613},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_2857":57982,"_25085":57921,"_17521":96615,"_5":17416,"_23752":96458,"_2384":96616},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_2857":57983,"_25085":57921,"_17521":96618,"_5":17416,"_23752":96458,"_2384":96619},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_2857":57984,"_25085":57921,"_17521":96621,"_5":17416,"_23752":96462,"_2384":96622},[],"Comprueba, en orden:",{"_2857":57985,"_25085":57921,"_17521":96624,"_5":17416,"_23752":96462,"_2384":96625},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_2857":57986,"_25085":57921,"_17521":96627,"_5":17416,"_23752":96462,"_2384":96628},[],"Su estado contiene la dirección esperada.",{"_2857":57987,"_25085":57921,"_17521":96630,"_5":17416,"_23752":96462,"_2384":96631},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_2857":57988,"_25085":57921,"_17521":96633,"_5":17416,"_23752":96462,"_2384":96634},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_2857":57989,"_25085":57921,"_17521":96636,"_5":17416,"_23752":96462,"_2384":96637},[],"DNS resuelve al endpoint accesible externamente.",{"_2857":57990,"_25085":57921,"_17521":96639,"_5":17416,"_23752":96462,"_2384":96640},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_2857":57991,"_25085":57921,"_17521":96642,"_5":17416,"_23752":96462,"_2384":96643},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_2857":57992,"_25085":57992,"_5":12285,"_2384":40869,"_25421":96645,"_17521":96646,"_23752":57992},[40762,95731,95965],[],{"_2857":57993,"_25085":57992,"_17521":96648,"_5":17416,"_23752":57992,"_2384":96649},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_2857":57994,"_25085":57992,"_5":25418,"_17521":96651,"_23752":96652,"_2384":96653},[],"/docs/pr-preview/pr-46/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_2857":57995,"_25085":57992,"_5":25418,"_17521":96655,"_23752":96656,"_2384":96657},[],"/docs/pr-preview/pr-46/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_2857":57996,"_25085":57992,"_5":25418,"_17521":96659,"_23752":96660,"_2384":96661},[],"/docs/pr-preview/pr-46/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_2857":57997,"_25085":57992,"_5":25418,"_17521":96663,"_23752":96664,"_2384":96665},[],"/docs/pr-preview/pr-46/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_2857":57998,"_25085":57992,"_5":25418,"_17521":96667,"_23752":96668,"_2384":96669},[],"/docs/pr-preview/pr-46/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_2857":57999,"_25085":57992,"_5":25418,"_17521":96671,"_23752":96672,"_2384":96673},[],"/docs/pr-preview/pr-46/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_2857":58000,"_25085":57992,"_17521":96675,"_5":17416,"_23752":96652,"_2384":96676},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_2857":58001,"_25085":57992,"_17521":96678,"_5":17416,"_23752":96656,"_2384":96679},[],"Flujo",{"_2857":58002,"_25085":57992,"_17521":96681,"_5":17416,"_23752":96656,"_2384":96682},[],"Úsalo para",{"_2857":58003,"_25085":57992,"_17521":96684,"_5":17416,"_23752":96656,"_2384":96685},[],"Qué instala",{"_2857":58004,"_25085":57992,"_17521":96687,"_5":17416,"_23752":96656,"_2384":41753},[],{"_2857":58005,"_25085":57992,"_17521":96689,"_5":17416,"_23752":96656,"_2384":96690},[],"Producción y entornos controlados",{"_2857":58006,"_25085":57992,"_17521":96692,"_5":17416,"_23752":96656,"_2384":96693},[],"Servicios de Lamassu y recursos de Gateway API",{"_2857":58007,"_25085":57992,"_17521":96695,"_5":17416,"_23752":96656,"_2384":41006},[],{"_2857":58008,"_25085":57992,"_17521":96697,"_5":17416,"_23752":96656,"_2384":96698},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_2857":58009,"_25085":57992,"_17521":96700,"_5":17416,"_23752":96656,"_2384":96701},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_2857":58010,"_25085":57992,"_17521":96703,"_5":17416,"_23752":96660,"_2384":96704},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_2857":58011,"_25085":57992,"_17521":96706,"_5":17416,"_23752":96660,"_2384":96707},[],"Área",{"_2857":58012,"_25085":57992,"_17521":96709,"_5":17416,"_23752":96660,"_2384":96710},[],"El chart de Lamassu proporciona",{"_2857":58013,"_25085":57992,"_17521":96712,"_5":17416,"_23752":96660,"_2384":96713},[],"Tú proporcionas",{"_2857":58014,"_25085":57992,"_17521":96715,"_5":17416,"_23752":96660,"_2384":96716},[],"Aplicaciones Lamassu",{"_2857":58015,"_25085":57992,"_17521":96718,"_5":17416,"_23752":96660,"_2384":96719},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_2857":58016,"_25085":57992,"_17521":96721,"_5":17416,"_23752":96660,"_2384":96722},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_2857":58017,"_25085":57992,"_17521":96724,"_5":17416,"_23752":96660,"_2384":96725},[],"Datos PostgreSQL",{"_2857":58018,"_25085":57992,"_17521":96727,"_5":17416,"_23752":96660,"_2384":96728},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_2857":58019,"_25085":57992,"_17521":96730,"_5":17416,"_23752":96660,"_2384":96731},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_2857":58020,"_25085":57992,"_17521":96733,"_5":17416,"_23752":96660,"_2384":96734},[],"Mensajería",{"_2857":58021,"_25085":57992,"_17521":96736,"_5":17416,"_23752":96660,"_2384":96737},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_2857":58022,"_25085":57992,"_17521":96739,"_5":17416,"_23752":96660,"_2384":96740},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_2857":58023,"_25085":57992,"_17521":96742,"_5":17416,"_23752":96660,"_2384":96743},[],"Identidad",{"_2857":58024,"_25085":57992,"_17521":96745,"_5":17416,"_23752":96660,"_2384":96746},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_2857":58025,"_25085":57992,"_17521":96748,"_5":17416,"_23752":96660,"_2384":96749},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_2857":58026,"_25085":57992,"_17521":96751,"_5":17416,"_23752":96660,"_2384":96752},[],"Enrutamiento externo",{"_2857":58027,"_25085":57992,"_17521":96754,"_5":17416,"_23752":96660,"_2384":96755},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_2857":58028,"_25085":57992,"_17521":96757,"_5":17416,"_23752":96660,"_2384":96758},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_2857":58029,"_25085":57992,"_17521":96760,"_5":17416,"_23752":96660,"_2384":41827},[],{"_2857":58030,"_25085":57992,"_17521":96762,"_5":17416,"_23752":96660,"_2384":96763},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_2857":58031,"_25085":57992,"_17521":96765,"_5":17416,"_23752":96660,"_2384":96766},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_2857":58032,"_25085":57992,"_17521":96768,"_5":17416,"_23752":96660,"_2384":96769},[],"Datos persistentes de la aplicación",{"_2857":58033,"_25085":57992,"_17521":96771,"_5":17416,"_23752":96660,"_2384":96772},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_2857":58034,"_25085":57992,"_17521":96774,"_5":17416,"_23752":96660,"_2384":96775},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_2857":58035,"_25085":57992,"_17521":96777,"_5":17416,"_23752":96660,"_2384":96778},[],"Integraciones opcionales",{"_2857":58036,"_25085":57992,"_17521":96780,"_5":17416,"_23752":96660,"_2384":96781},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_2857":58037,"_25085":57992,"_17521":96783,"_5":17416,"_23752":96660,"_2384":96784},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_2857":58038,"_25085":57992,"_17521":96786,"_5":17416,"_23752":96660,"_2384":96787},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_2857":58039,"_25085":57992,"_17521":96789,"_5":17416,"_23752":96660,"_2384":96790},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_2857":58040,"_25085":57992,"_17521":96792,"_5":17416,"_23752":96664,"_2384":96793},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_2857":58041,"_25085":57992,"_17521":96795,"_5":17416,"_23752":96664,"_2384":96796},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_2857":58042,"_25085":57992,"_17521":96798,"_5":17416,"_23752":96668,"_2384":96799},[],"Kubernetes 1.24 o posterior",{"_2857":58043,"_25085":57992,"_17521":96801,"_5":17416,"_23752":96668,"_2384":96802},[],"Helm 3.2 o posterior",{"_2857":58044,"_25085":57992,"_17521":96804,"_5":17416,"_23752":96668,"_2384":96805},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_2857":58045,"_25085":57992,"_17521":96807,"_5":17416,"_23752":96668,"_2384":96808},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_2857":58046,"_25085":57992,"_17521":96810,"_5":17416,"_23752":96668,"_2384":96811},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_2857":58047,"_25085":57992,"_17521":96813,"_5":17416,"_23752":96668,"_2384":96814},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_2857":58048,"_25085":57992,"_17521":96816,"_5":17416,"_23752":96668,"_2384":96817},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior.",{"_2857":58049,"_25085":57992,"_17521":96819,"_5":17416,"_23752":96672,"_2384":96820},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2857":58050,"_25085":57992,"_17521":96822,"_5":17416,"_23752":96672,"_2384":96823},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2857":58051,"_25085":57992,"_17521":96825,"_5":17416,"_23752":96672,"_2384":96826},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2857":58052,"_25085":58052,"_5":12285,"_2384":96828,"_25421":96829,"_17521":96831,"_23752":58052},"Resolución de problemas de despliegue",[40762,95731,96830],"Operación",[],{"_2857":58053,"_25085":58052,"_17521":96833,"_5":17416,"_23752":58052,"_2384":96834},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_2857":58054,"_25085":58052,"_5":25418,"_17521":96836,"_23752":96837,"_2384":96838},[],"/docs/pr-preview/pr-46/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_2857":58055,"_25085":58052,"_5":25418,"_17521":96840,"_23752":96841,"_2384":96842},[],"/docs/pr-preview/pr-46/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_2857":58056,"_25085":58052,"_5":25418,"_17521":96844,"_23752":96845,"_2384":96846},[],"/docs/pr-preview/pr-46/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_2857":58057,"_25085":58052,"_5":25418,"_17521":96848,"_23752":96849,"_2384":96850},[],"/docs/pr-preview/pr-46/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_2857":58058,"_25085":58052,"_5":25418,"_17521":96852,"_23752":96853,"_2384":96854},[],"/docs/pr-preview/pr-46/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_2857":58059,"_25085":58052,"_5":25418,"_17521":96856,"_23752":96857,"_2384":96858},[],"/docs/pr-preview/pr-46/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_2857":58060,"_25085":58052,"_5":25418,"_17521":96860,"_23752":96861,"_2384":96862},[],"/docs/pr-preview/pr-46/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_2857":58061,"_25085":58052,"_5":25418,"_17521":96864,"_23752":96865,"_2384":96866},[],"/docs/pr-preview/pr-46/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_2857":58062,"_25085":58052,"_5":25418,"_17521":96868,"_23752":96869,"_2384":96870},[],"/docs/pr-preview/pr-46/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_2857":58063,"_25085":58052,"_5":25418,"_17521":96872,"_23752":96873,"_2384":96874},[],"/docs/pr-preview/pr-46/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_2857":58064,"_25085":58052,"_5":25418,"_17521":96876,"_23752":96877,"_2384":96878},[],"/docs/pr-preview/pr-46/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_2857":58065,"_25085":58052,"_5":25418,"_17521":96880,"_23752":96881,"_2384":96882},[],"/docs/pr-preview/pr-46/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_2857":58066,"_25085":58052,"_17521":96884,"_5":17416,"_23752":58052,"_2384":96885},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_2857":58067,"_25085":58052,"_17521":96887,"_5":17416,"_23752":96841,"_2384":96888},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_2857":58068,"_25085":58052,"_17521":96890,"_5":17416,"_23752":96845,"_2384":96891},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_2857":58069,"_25085":58052,"_17521":96893,"_5":17416,"_23752":96849,"_2384":96894},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_2857":58070,"_25085":58052,"_17521":96896,"_5":17416,"_23752":96853,"_2384":96897},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_2857":58071,"_25085":58052,"_17521":96899,"_5":17416,"_23752":96857,"_2384":96900},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_2857":58072,"_25085":58052,"_17521":96902,"_5":17416,"_23752":96861,"_2384":96903},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_2857":58073,"_25085":58052,"_17521":96905,"_5":17416,"_23752":96861,"_2384":96906},[],"Ejecuta también la prueba de conectividad del chart:",{"_2857":58074,"_25085":58052,"_17521":96908,"_5":17416,"_23752":96861,"_2384":96909},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_2857":58075,"_25085":58052,"_17521":96911,"_5":17416,"_23752":96861,"_2384":96912},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_2857":58076,"_25085":58052,"_17521":96914,"_5":17416,"_23752":96865,"_2384":96915},[],"Si recibes un 401:",{"_2857":58077,"_25085":58052,"_17521":96917,"_5":17416,"_23752":96865,"_2384":96918},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_2857":58078,"_25085":58052,"_17521":96920,"_5":17416,"_23752":96865,"_2384":96921},[],"verifica emisor, audiencia y expiración del token;",{"_2857":58079,"_25085":58052,"_17521":96923,"_5":17416,"_23752":96865,"_2384":96924},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_2857":58080,"_25085":58052,"_17521":96926,"_5":17416,"_23752":96865,"_2384":96927},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_2857":58081,"_25085":58052,"_17521":96929,"_5":17416,"_23752":96865,"_2384":96930},[],"Si el login termina pero las APIs devuelven 403:",{"_2857":58082,"_25085":58052,"_17521":96932,"_5":17416,"_23752":96865,"_2384":96933},[],"inspecciona los claims reales del token;",{"_2857":58083,"_25085":58052,"_17521":96935,"_5":17416,"_23752":96865,"_2384":96936},[],"confirma que coinciden con un principal activo;",{"_2857":58084,"_25085":58052,"_17521":96938,"_5":17416,"_23752":96865,"_2384":96939},[],"revisa las políticas concedidas al principal;",{"_2857":58085,"_25085":58052,"_17521":96941,"_5":17416,"_23752":96865,"_2384":96942},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_2857":58086,"_25085":58052,"_17521":96944,"_5":17416,"_23752":96865,"_2384":96945},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_2857":58087,"_25085":58052,"_17521":96947,"_5":17416,"_23752":96869,"_2384":96948},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_2857":58088,"_25085":58052,"_17521":96950,"_5":17416,"_23752":96869,"_2384":96951},[],"Localiza el pod y Service de authz.",{"_2857":58089,"_25085":58052,"_17521":96953,"_5":17416,"_23752":96869,"_2384":96954},[],"Comprueba /health, logs y conexión a su base de datos.",{"_2857":58090,"_25085":58052,"_17521":96956,"_5":17416,"_23752":96869,"_2384":96957},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_2857":58091,"_25085":58052,"_17521":96959,"_5":17416,"_23752":96869,"_2384":96960},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_2857":58092,"_25085":58052,"_17521":96962,"_5":17416,"_23752":96869,"_2384":96963},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_2857":58093,"_25085":58052,"_17521":96965,"_5":17416,"_23752":96873,"_2384":96966},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_2857":58094,"_25085":58052,"_17521":96968,"_5":17416,"_23752":96873,"_2384":96969},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_2857":58095,"_25085":58052,"_17521":96971,"_5":17416,"_23752":96873,"_2384":96972},[],"volumen persistente sin enlazar;",{"_2857":58096,"_25085":58052,"_17521":96974,"_5":17416,"_23752":96873,"_2384":96975},[],"imagen inaccesible o política de pull incorrecta;",{"_2857":58097,"_25085":58052,"_17521":96977,"_5":17416,"_23752":96873,"_2384":96978},[],"configuración inválida del motor criptográfico;",{"_2857":58098,"_25085":58052,"_17521":96980,"_5":17416,"_23752":96873,"_2384":96981},[],"límites de CPU o memoria demasiado bajos;",{"_2857":58099,"_25085":58052,"_17521":96983,"_5":17416,"_23752":96873,"_2384":96984},[],"migración previa incompleta.",{"_2857":58100,"_25085":58052,"_17521":96986,"_5":17416,"_23752":96873,"_2384":96987},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_2857":58101,"_25085":58052,"_17521":96989,"_5":17416,"_23752":96873,"_2384":96990},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_2857":58102,"_25085":58052,"_17521":96992,"_5":17416,"_23752":96877,"_2384":96993},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_2857":58103,"_25085":58052,"_17521":96995,"_5":17416,"_23752":96877,"_2384":96996},[],"verifica que esté habilitado en el servicio emisor;",{"_2857":58104,"_25085":58052,"_17521":96998,"_5":17416,"_23752":96877,"_2384":96999},[],"comprueba conectividad y credenciales AMQP;",{"_2857":58105,"_25085":58052,"_17521":97001,"_5":17416,"_23752":96877,"_2384":97002},[],"revisa exchange, routing key, colas y consumidores;",{"_2857":58106,"_25085":58052,"_17521":97004,"_5":17416,"_23752":96877,"_2384":97005},[],"inspecciona dead-letter queues;",{"_2857":58107,"_25085":58052,"_17521":97007,"_5":17416,"_23752":96877,"_2384":97008},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_2857":58108,"_25085":58052,"_17521":97010,"_5":17416,"_23752":96877,"_2384":97011},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_2857":58109,"_25085":58052,"_17521":97013,"_5":17416,"_23752":96881,"_2384":97014},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_2857":58110,"_25085":58052,"_17521":97016,"_5":17416,"_23752":96881,"_2384":97017},[],"Antes de cerrar una incidencia, guarda:",{"_2857":58111,"_25085":58052,"_17521":97019,"_5":17416,"_23752":96881,"_2384":97020},[],"causa confirmada;",{"_2857":58112,"_25085":58052,"_17521":97022,"_5":17416,"_23752":96881,"_2384":97023},[],"alcance temporal y recursos afectados;",{"_2857":58113,"_25085":58052,"_17521":97025,"_5":17416,"_23752":96881,"_2384":97026},[],"comandos o consultas utilizados;",{"_2857":58114,"_25085":58052,"_17521":97028,"_5":17416,"_23752":96881,"_2384":97029},[],"cambio aplicado y forma de revertirlo;",{"_2857":58115,"_25085":58052,"_17521":97031,"_5":17416,"_23752":96881,"_2384":97032},[],"validación desde un consumidor;",{"_2857":58116,"_25085":58052,"_17521":97034,"_5":17416,"_23752":96881,"_2384":97035},[],"acción preventiva y propietario.",{"_2857":58117,"_25085":58117,"_5":12285,"_2384":97037,"_25421":97038,"_17521":97041,"_23752":58117},"Control de acceso",[40762,97039,97040],"Plataforma","Administración",[],{"_2857":58118,"_25085":58117,"_17521":97043,"_5":17416,"_23752":58117,"_2384":97044},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_2857":58119,"_25085":58117,"_5":25418,"_17521":97046,"_23752":97047,"_2384":97048},[],"/docs/pr-preview/pr-46/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_2857":58120,"_25085":58117,"_5":25418,"_17521":97050,"_23752":97051,"_2384":97052},[],"/docs/pr-preview/pr-46/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_2857":58121,"_25085":58117,"_5":25418,"_17521":97054,"_23752":97055,"_2384":97056},[],"/docs/pr-preview/pr-46/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_2857":58122,"_25085":58117,"_5":25418,"_17521":97058,"_23752":97059,"_2384":97060},[],"/docs/pr-preview/pr-46/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_2857":58123,"_25085":58117,"_5":25418,"_17521":97062,"_23752":97063,"_2384":97064},[],"/docs/pr-preview/pr-46/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_2857":58124,"_25085":58117,"_5":25418,"_17521":97066,"_23752":97067,"_2384":97068},[],"/docs/pr-preview/pr-46/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_2857":58125,"_25085":58117,"_5":25418,"_17521":97070,"_23752":97071,"_2384":97072},[],"/docs/pr-preview/pr-46/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_2857":58126,"_25085":58117,"_5":25418,"_17521":97074,"_23752":97075,"_2384":97076},[],"/docs/pr-preview/pr-46/es/platform/administration/access-control#principales-x509","Principales X.509",{"_2857":58127,"_25085":58117,"_5":25418,"_17521":97078,"_23752":97079,"_2384":97080},[],"/docs/pr-preview/pr-46/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_2857":58128,"_25085":58117,"_5":25418,"_17521":97082,"_23752":97083,"_2384":97084},[],"/docs/pr-preview/pr-46/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_2857":58129,"_25085":58117,"_5":25418,"_17521":97086,"_23752":97087,"_2384":97088},[],"/docs/pr-preview/pr-46/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_2857":58130,"_25085":58117,"_5":25418,"_17521":97090,"_23752":97091,"_2384":97092},[],"/docs/pr-preview/pr-46/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_2857":58131,"_25085":58117,"_5":25418,"_17521":97094,"_23752":97095,"_2384":97096},[],"/docs/pr-preview/pr-46/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_2857":58132,"_25085":58117,"_5":25418,"_17521":97098,"_23752":97099,"_2384":97100},[],"/docs/pr-preview/pr-46/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_2857":58133,"_25085":58117,"_5":25418,"_17521":97102,"_23752":97103,"_2384":97104},[],"/docs/pr-preview/pr-46/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_2857":58134,"_25085":58117,"_5":25418,"_17521":97106,"_23752":97107,"_2384":96301},[],"/docs/pr-preview/pr-46/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_2857":58135,"_25085":58117,"_5":25418,"_17521":97109,"_23752":97110,"_2384":97111},[],"/docs/pr-preview/pr-46/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_2857":58136,"_25085":58117,"_5":25418,"_17521":97113,"_23752":97114,"_2384":97115},[],"/docs/pr-preview/pr-46/es/platform/administration/access-control#configura-las-dos-validaciones-jwt","Configura las dos validaciones JWT",{"_2857":58137,"_25085":58117,"_5":25418,"_17521":97117,"_23752":97118,"_2384":97119},[],"/docs/pr-preview/pr-46/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_2857":58138,"_25085":58117,"_5":25418,"_17521":97121,"_23752":97122,"_2384":97123},[],"/docs/pr-preview/pr-46/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_2857":58139,"_25085":58117,"_5":25418,"_17521":97125,"_23752":97126,"_2384":97127},[],"/docs/pr-preview/pr-46/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_2857":58140,"_25085":58117,"_5":25418,"_17521":97129,"_23752":97130,"_2384":97131},[],"/docs/pr-preview/pr-46/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_2857":58141,"_25085":58117,"_5":25418,"_17521":97133,"_23752":97134,"_2384":97135},[],"/docs/pr-preview/pr-46/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_2857":58142,"_25085":58117,"_5":25418,"_17521":97137,"_23752":97138,"_2384":97139},[],"/docs/pr-preview/pr-46/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_2857":58143,"_25085":58117,"_5":25418,"_17521":97141,"_23752":97142,"_2384":97143},[],"/docs/pr-preview/pr-46/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_2857":58144,"_25085":58117,"_5":25418,"_17521":97145,"_23752":97146,"_2384":97147},[],"/docs/pr-preview/pr-46/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_2857":58145,"_25085":58117,"_5":25418,"_17521":97149,"_23752":97150,"_2384":97151},[],"/docs/pr-preview/pr-46/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_2857":58146,"_25085":58117,"_5":25418,"_17521":97153,"_23752":97154,"_2384":97155},[],"/docs/pr-preview/pr-46/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_2857":58147,"_25085":58117,"_5":25418,"_17521":97157,"_23752":97158,"_2384":97159},[],"/docs/pr-preview/pr-46/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_2857":58148,"_25085":58117,"_5":25418,"_17521":97161,"_23752":97162,"_2384":97163},[],"/docs/pr-preview/pr-46/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_2857":58149,"_25085":58117,"_5":25418,"_17521":97165,"_23752":97166,"_2384":97167},[],"/docs/pr-preview/pr-46/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_2857":58150,"_25085":58117,"_17521":97169,"_5":17416,"_23752":58117,"_2384":97170},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_2857":58151,"_25085":58117,"_17521":97172,"_5":17416,"_23752":58117,"_2384":97173},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_2857":58152,"_25085":58117,"_17521":97175,"_5":17416,"_23752":58117,"_2384":97176},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_2857":58153,"_25085":58117,"_17521":97178,"_5":17416,"_23752":97047,"_2384":97179},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_2857":58154,"_25085":58117,"_17521":97181,"_5":17416,"_23752":97047,"_2384":97182},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_2857":58155,"_25085":58117,"_17521":97184,"_5":17416,"_23752":97047,"_2384":97185},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_2857":58156,"_25085":58117,"_17521":97187,"_5":17416,"_23752":97047,"_2384":97188},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_2857":58157,"_25085":58117,"_17521":97190,"_5":17416,"_23752":97047,"_2384":97191},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_2857":58158,"_25085":58117,"_17521":97193,"_5":17416,"_23752":97047,"_2384":97194},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_2857":58159,"_25085":58117,"_17521":97196,"_5":17416,"_23752":97051,"_2384":97197},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_2857":58160,"_25085":58117,"_17521":97199,"_5":17416,"_23752":97051,"_2384":97200},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_2857":58161,"_25085":58117,"_17521":97202,"_5":17416,"_23752":97055,"_2384":97203},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_2857":58162,"_25085":58117,"_17521":97205,"_5":17416,"_23752":97055,"_2384":97206},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_2857":58163,"_25085":58117,"_17521":97208,"_5":17416,"_23752":97055,"_2384":97209},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_2857":58164,"_25085":58117,"_17521":97211,"_5":17416,"_23752":97055,"_2384":97212},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_2857":58165,"_25085":58117,"_17521":97214,"_5":17416,"_23752":97055,"_2384":97215},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_2857":58166,"_25085":58117,"_17521":97217,"_5":17416,"_23752":97055,"_2384":97218},[],"Carga por separado las políticas concedidas a cada principal.",{"_2857":58167,"_25085":58117,"_17521":97220,"_5":17416,"_23752":97055,"_2384":97221},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_2857":58168,"_25085":58117,"_17521":97223,"_5":17416,"_23752":97055,"_2384":97224},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_2857":58169,"_25085":58117,"_17521":97226,"_5":17416,"_23752":97055,"_2384":97227},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_2857":58170,"_25085":58117,"_17521":97229,"_5":17416,"_23752":97055,"_2384":97230},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_2857":58171,"_25085":58117,"_17521":97232,"_5":17416,"_23752":97055,"_2384":97233},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_2857":58172,"_25085":58117,"_17521":97235,"_5":17416,"_23752":97055,"_2384":97236},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_2857":58173,"_25085":58117,"_17521":97238,"_5":17416,"_23752":97059,"_2384":97239},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_2857":58174,"_25085":58117,"_17521":97241,"_5":17416,"_23752":97059,"_2384":97242},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_2857":58175,"_25085":58117,"_17521":97244,"_5":17416,"_23752":97059,"_2384":97245},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_2857":58176,"_25085":58117,"_17521":97247,"_5":17416,"_23752":97059,"_2384":97248},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_2857":58177,"_25085":58117,"_17521":97250,"_5":17416,"_23752":97059,"_2384":97251},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_2857":58178,"_25085":58117,"_17521":97253,"_5":17416,"_23752":97059,"_2384":97254},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_2857":58179,"_25085":58117,"_17521":97256,"_5":17416,"_23752":97059,"_2384":97257},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_2857":58180,"_25085":58117,"_17521":97259,"_5":17416,"_23752":97059,"_2384":97260},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_2857":58181,"_25085":58117,"_17521":97262,"_5":17416,"_23752":97063,"_2384":97263},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_2857":58182,"_25085":58117,"_17521":97265,"_5":17416,"_23752":97063,"_2384":97266},[],"La decisión se toma con el contexto de la operación de dominio:",{"_2857":58183,"_25085":58117,"_17521":97268,"_5":17416,"_23752":97063,"_2384":97269},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_2857":58184,"_25085":58117,"_17521":97271,"_5":17416,"_23752":97063,"_2384":97272},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_2857":58185,"_25085":58117,"_17521":97274,"_5":17416,"_23752":97063,"_2384":97275},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_2857":58186,"_25085":58117,"_17521":97277,"_5":17416,"_23752":97063,"_2384":97278},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_2857":58187,"_25085":58117,"_17521":97280,"_5":17416,"_23752":97063,"_2384":97281},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_2857":58188,"_25085":58117,"_17521":97283,"_5":17416,"_23752":97063,"_2384":97284},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_2857":58189,"_25085":58117,"_17521":97286,"_5":17416,"_23752":97063,"_2384":97287},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_2857":58190,"_25085":58117,"_17521":97289,"_5":17416,"_23752":97063,"_2384":97290},[],"Las acciones se dividen en dos grupos:",{"_2857":58191,"_25085":58117,"_17521":97292,"_5":17416,"_23752":97063,"_2384":97293},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_2857":58192,"_25085":58117,"_17521":97295,"_5":17416,"_23752":97063,"_2384":97296},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_2857":58193,"_25085":58117,"_17521":97298,"_5":17416,"_23752":97063,"_2384":97299},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_2857":58194,"_25085":58117,"_17521":97301,"_5":17416,"_23752":97067,"_2384":97302},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_2857":58195,"_25085":58117,"_17521":97304,"_5":17416,"_23752":97067,"_2384":97305},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_2857":58196,"_25085":58117,"_17521":97307,"_5":17416,"_23752":97067,"_2384":97308},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_2857":58197,"_25085":58117,"_17521":97310,"_5":17416,"_23752":97071,"_2384":97311},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_2857":58198,"_25085":58117,"_17521":97313,"_5":17416,"_23752":97071,"_2384":97314},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_2857":58199,"_25085":58117,"_17521":97316,"_5":17416,"_23752":97071,"_2384":97317},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_2857":58200,"_25085":58117,"_17521":97319,"_5":17416,"_23752":97071,"_2384":97320},[],"Los operadores implementados son:",{"_2857":58201,"_25085":58117,"_17521":97322,"_5":17416,"_23752":97071,"_2384":97323},[],"`equals`, para igualdad exacta;",{"_2857":58202,"_25085":58117,"_17521":97325,"_5":17416,"_23752":97071,"_2384":97326},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_2857":58203,"_25085":58117,"_17521":97328,"_5":17416,"_23752":97071,"_2384":97329},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_2857":58204,"_25085":58117,"_17521":97331,"_5":17416,"_23752":97071,"_2384":97332},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_2857":58205,"_25085":58117,"_17521":97334,"_5":17416,"_23752":97075,"_2384":97335},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_2857":58206,"_25085":58117,"_17521":97337,"_5":17416,"_23752":97075,"_2384":97338},[],"Los modos disponibles son:",{"_2857":58207,"_25085":58117,"_17521":97340,"_5":17416,"_23752":97075,"_2384":97341},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_2857":58208,"_25085":58117,"_17521":97343,"_5":17416,"_23752":97075,"_2384":97344},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_2857":58209,"_25085":58117,"_17521":97346,"_5":17416,"_23752":97075,"_2384":97347},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_2857":58210,"_25085":58117,"_17521":97349,"_5":17416,"_23752":97075,"_2384":97350},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_2857":58211,"_25085":58117,"_17521":97352,"_5":17416,"_23752":97075,"_2384":97353},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_2857":58212,"_25085":58117,"_17521":97355,"_5":17416,"_23752":97075,"_2384":97356},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_2857":58213,"_25085":58117,"_17521":97358,"_5":17416,"_23752":97079,"_2384":97359},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_2857":58214,"_25085":58117,"_17521":97361,"_5":17416,"_23752":97079,"_2384":97362},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_2857":58215,"_25085":58117,"_17521":97364,"_5":17416,"_23752":97079,"_2384":97365},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_2857":58216,"_25085":58117,"_17521":97367,"_5":17416,"_23752":97079,"_2384":97368},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_2857":58217,"_25085":58117,"_17521":97370,"_5":17416,"_23752":97087,"_2384":97371},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_2857":58218,"_25085":58117,"_17521":97373,"_5":17416,"_23752":97087,"_2384":97374},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_2857":58219,"_25085":58117,"_17521":97376,"_5":17416,"_23752":97091,"_2384":97377},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_2857":58220,"_25085":58117,"_17521":97379,"_5":17416,"_23752":97091,"_2384":97380},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_2857":58221,"_25085":58117,"_17521":97382,"_5":17416,"_23752":97095,"_2384":97383},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_2857":58222,"_25085":58117,"_17521":97385,"_5":17416,"_23752":97095,"_2384":97386},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_2857":58223,"_25085":58117,"_17521":97388,"_5":17416,"_23752":97095,"_2384":97389},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_2857":58224,"_25085":58117,"_17521":97391,"_5":17416,"_23752":97099,"_2384":97392},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_2857":58225,"_25085":58117,"_17521":97394,"_5":17416,"_23752":97099,"_2384":97395},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_2857":58226,"_25085":58117,"_17521":97397,"_5":17416,"_23752":97099,"_2384":97398},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_2857":58227,"_25085":58117,"_17521":97400,"_5":17416,"_23752":97099,"_2384":97401},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_2857":58228,"_25085":58117,"_17521":97403,"_5":17416,"_23752":97099,"_2384":97404},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_2857":58229,"_25085":58117,"_17521":97406,"_5":17416,"_23752":97099,"_2384":97407},[],"Ten en cuenta que:",{"_2857":58230,"_25085":58117,"_17521":97409,"_5":17416,"_23752":97099,"_2384":97410},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_2857":58231,"_25085":58117,"_17521":97412,"_5":17416,"_23752":97099,"_2384":97413},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_2857":58232,"_25085":58117,"_17521":97415,"_5":17416,"_23752":97099,"_2384":97416},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_2857":58233,"_25085":58117,"_17521":97418,"_5":17416,"_23752":97103,"_2384":97419},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_2857":58234,"_25085":58117,"_17521":97421,"_5":17416,"_23752":97103,"_2384":97422},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_2857":58235,"_25085":58117,"_17521":97424,"_5":17416,"_23752":97103,"_2384":97425},[],"acceso completo y de solo lectura a KMS;",{"_2857":58236,"_25085":58117,"_17521":97427,"_5":17416,"_23752":97103,"_2384":97428},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_2857":58237,"_25085":58117,"_17521":97430,"_5":17416,"_23752":97103,"_2384":97431},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_2857":58238,"_25085":58117,"_17521":97433,"_5":17416,"_23752":97103,"_2384":97434},[],"acceso a la interfaz;",{"_2857":58239,"_25085":58117,"_17521":97436,"_5":17416,"_23752":97103,"_2384":97437},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_2857":58240,"_25085":58117,"_17521":97439,"_5":17416,"_23752":97103,"_2384":97440},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_2857":58241,"_25085":58117,"_17521":97442,"_5":17416,"_23752":97103,"_2384":97443},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_2857":58242,"_25085":58117,"_17521":97445,"_5":17416,"_23752":97107,"_2384":97446},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_2857":58243,"_25085":58117,"_17521":97448,"_5":17416,"_23752":97107,"_2384":97449},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_2857":58244,"_25085":58117,"_17521":97451,"_5":17416,"_23752":97107,"_2384":97452},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_2857":58245,"_25085":58117,"_17521":97454,"_5":17416,"_23752":97110,"_2384":97455},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_2857":58246,"_25085":58117,"_17521":97457,"_5":17416,"_23752":97114,"_2384":97458},[],"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes.",{"_2857":58247,"_25085":58117,"_17521":97460,"_5":17416,"_23752":97118,"_2384":97461},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_2857":58248,"_25085":58117,"_17521":97463,"_5":17416,"_23752":97122,"_2384":97464},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_2857":58249,"_25085":58117,"_17521":97466,"_5":17416,"_23752":97126,"_2384":97467},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_2857":58250,"_25085":58117,"_17521":97469,"_5":17416,"_23752":97130,"_2384":97470},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_2857":58251,"_25085":58117,"_17521":97472,"_5":17416,"_23752":97130,"_2384":97473},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_2857":58252,"_25085":58117,"_17521":97475,"_5":17416,"_23752":97134,"_2384":97476},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_2857":58253,"_25085":58117,"_17521":97478,"_5":17416,"_23752":97134,"_2384":97479},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_2857":58254,"_25085":58117,"_17521":97481,"_5":17416,"_23752":97134,"_2384":97482},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_2857":58255,"_25085":58117,"_17521":97484,"_5":17416,"_23752":97134,"_2384":97485},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_2857":58256,"_25085":58117,"_17521":97487,"_5":17416,"_23752":97134,"_2384":97488},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_2857":58257,"_25085":58117,"_17521":97490,"_5":17416,"_23752":97134,"_2384":97491},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_2857":58258,"_25085":58117,"_17521":97493,"_5":17416,"_23752":97134,"_2384":97494},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_2857":58259,"_25085":58117,"_17521":97496,"_5":17416,"_23752":97134,"_2384":97497},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_2857":58260,"_25085":58117,"_17521":97499,"_5":17416,"_23752":97138,"_2384":97500},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_2857":58261,"_25085":58117,"_17521":97502,"_5":17416,"_23752":97138,"_2384":97503},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_2857":58262,"_25085":58117,"_17521":97505,"_5":17416,"_23752":97138,"_2384":97506},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_2857":58263,"_25085":58117,"_17521":97508,"_5":17416,"_23752":97142,"_2384":97509},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_2857":58264,"_25085":58117,"_17521":97511,"_5":17416,"_23752":97142,"_2384":97512},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_2857":58265,"_25085":58117,"_17521":97514,"_5":17416,"_23752":97142,"_2384":97515},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_2857":58266,"_25085":58117,"_17521":97517,"_5":17416,"_23752":97142,"_2384":97518},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_2857":58267,"_25085":58117,"_17521":97520,"_5":17416,"_23752":97142,"_2384":97521},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_2857":58268,"_25085":58117,"_17521":97523,"_5":17416,"_23752":97142,"_2384":97524},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_2857":58269,"_25085":58117,"_17521":97526,"_5":17416,"_23752":97142,"_2384":97527},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_2857":58270,"_25085":58117,"_17521":97529,"_5":17416,"_23752":97142,"_2384":97530},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_2857":58271,"_25085":58117,"_17521":97532,"_5":17416,"_23752":97150,"_2384":97533},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_2857":58272,"_25085":58117,"_17521":97535,"_5":17416,"_23752":97154,"_2384":97536},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_2857":58273,"_25085":58117,"_17521":97538,"_5":17416,"_23752":97154,"_2384":97539},[],"que exista un principal activo del tipo correcto;",{"_2857":58274,"_25085":58117,"_17521":97541,"_5":17416,"_23752":97154,"_2384":97542},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_2857":58275,"_25085":58117,"_17521":97544,"_5":17416,"_23752":97154,"_2384":97545},[],"que todas las condiciones del principal se cumplan;",{"_2857":58276,"_25085":58117,"_17521":97547,"_5":17416,"_23752":97154,"_2384":97548},[],"que el principal tenga concedida la política esperada;",{"_2857":58277,"_25085":58117,"_17521":97550,"_5":17416,"_23752":97154,"_2384":97551},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_2857":58278,"_25085":58117,"_17521":97553,"_5":17416,"_23752":97154,"_2384":97554},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_2857":58279,"_25085":58117,"_17521":97556,"_5":17416,"_23752":97154,"_2384":97557},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_2857":58280,"_25085":58117,"_17521":97559,"_5":17416,"_23752":97158,"_2384":97560},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_2857":58281,"_25085":58117,"_17521":97562,"_5":17416,"_23752":97162,"_2384":97563},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_2857":58282,"_25085":58117,"_17521":97565,"_5":17416,"_23752":97166,"_2384":97566},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_2857":58283,"_25085":58117,"_17521":97568,"_5":17416,"_23752":97166,"_2384":97569},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_2857":58284,"_25085":58284,"_5":12285,"_2384":97571,"_25421":97572,"_17521":97573,"_23752":58284},"Alertas y suscripciones",[40762,97039,97040],[],{"_2857":58285,"_25085":58284,"_17521":97575,"_5":17416,"_23752":58284,"_2384":97576},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_2857":58286,"_25085":58284,"_5":25418,"_17521":97578,"_23752":97579,"_2384":97580},[],"/docs/pr-preview/pr-46/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_2857":58287,"_25085":58284,"_5":25418,"_17521":97582,"_23752":97583,"_2384":97584},[],"/docs/pr-preview/pr-46/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_2857":58288,"_25085":58284,"_5":25418,"_17521":97586,"_23752":97587,"_2384":97588},[],"/docs/pr-preview/pr-46/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_2857":58289,"_25085":58284,"_5":25418,"_17521":97590,"_23752":97591,"_2384":97592},[],"/docs/pr-preview/pr-46/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_2857":58290,"_25085":58284,"_5":25418,"_17521":97594,"_23752":97595,"_2384":97596},[],"/docs/pr-preview/pr-46/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_2857":58291,"_25085":58284,"_5":25418,"_17521":97598,"_23752":97599,"_2384":97600},[],"/docs/pr-preview/pr-46/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_2857":58292,"_25085":58284,"_5":25418,"_17521":97602,"_23752":97603,"_2384":97604},[],"/docs/pr-preview/pr-46/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_2857":58293,"_25085":58284,"_5":25418,"_17521":97606,"_23752":97607,"_2384":97608},[],"/docs/pr-preview/pr-46/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_2857":58294,"_25085":58284,"_5":25418,"_17521":97610,"_23752":97611,"_2384":97612},[],"/docs/pr-preview/pr-46/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_2857":58295,"_25085":58284,"_5":25418,"_17521":97614,"_23752":97615,"_2384":97616},[],"/docs/pr-preview/pr-46/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_2857":58296,"_25085":58284,"_17521":97618,"_5":17416,"_23752":58284,"_2384":97619},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_2857":58297,"_25085":58284,"_17521":97621,"_5":17416,"_23752":97579,"_2384":97622},[],"Un servicio publica un evento de dominio.",{"_2857":58298,"_25085":58284,"_17521":97624,"_5":17416,"_23752":97579,"_2384":97625},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_2857":58299,"_25085":58284,"_17521":97627,"_5":17416,"_23752":97579,"_2384":97628},[],"El filtro de cada suscripción decide si debe notificarse.",{"_2857":58300,"_25085":58284,"_17521":97630,"_5":17416,"_23752":97579,"_2384":97631},[],"Lamassu entrega el evento al canal configurado.",{"_2857":58301,"_25085":58284,"_17521":97633,"_5":17416,"_23752":97579,"_2384":97634},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_2857":58302,"_25085":58284,"_17521":97636,"_5":17416,"_23752":97583,"_2384":97637},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_2857":58303,"_25085":58284,"_17521":97639,"_5":17416,"_23752":97583,"_2384":97640},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_2857":58304,"_25085":58284,"_17521":97642,"_5":17416,"_23752":97583,"_2384":97643},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_2857":58305,"_25085":58284,"_17521":97645,"_5":17416,"_23752":97583,"_2384":97646},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_2857":58306,"_25085":58284,"_17521":97648,"_5":17416,"_23752":97583,"_2384":97649},[],"`apikey_options` necesita `header` y `key`.",{"_2857":58307,"_25085":58284,"_17521":97651,"_5":17416,"_23752":97583,"_2384":97652},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2857":58308,"_25085":58284,"_17521":97654,"_5":17416,"_23752":97583,"_2384":97655},[],"`mtls_options` necesita el PEM en línea `cert_content` y `key_content`; los valores que referencian archivos del servidor se rechazan.",{"_2857":58309,"_25085":58284,"_17521":97657,"_5":17416,"_23752":97583,"_2384":97658},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_2857":58310,"_25085":58284,"_17521":97660,"_5":17416,"_23752":97591,"_2384":97661},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_2857":58311,"_25085":58284,"_17521":97663,"_5":17416,"_23752":97595,"_2384":97664},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_2857":58312,"_25085":58284,"_17521":97666,"_5":17416,"_23752":97599,"_2384":97667},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_2857":58313,"_25085":58284,"_17521":97669,"_5":17416,"_23752":97599,"_2384":97670},[],"**None** notifica todas las instancias del evento.",{"_2857":58314,"_25085":58284,"_17521":97672,"_5":17416,"_23752":97599,"_2384":97673},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_2857":58315,"_25085":58284,"_17521":97675,"_5":17416,"_23752":97599,"_2384":97676},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_2857":58316,"_25085":58284,"_17521":97678,"_5":17416,"_23752":97599,"_2384":97679},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_2857":58317,"_25085":58284,"_17521":97681,"_5":17416,"_23752":97599,"_2384":97682},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_2857":58318,"_25085":58284,"_17521":97684,"_5":17416,"_23752":97599,"_2384":97685},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide (**The filter matches this Cloud Event** / **The filter does not match this Cloud Event**). Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_2857":58319,"_25085":58284,"_17521":97687,"_5":17416,"_23752":97603,"_2384":97688},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_2857":58320,"_25085":58284,"_17521":97690,"_5":17416,"_23752":97607,"_2384":97691},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_2857":58321,"_25085":58284,"_17521":97693,"_5":17416,"_23752":97607,"_2384":97694},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_2857":58322,"_25085":58284,"_17521":97696,"_5":17416,"_23752":97607,"_2384":97697},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_2857":58323,"_25085":58284,"_17521":97699,"_5":17416,"_23752":97607,"_2384":97700},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_2857":58324,"_25085":58284,"_17521":97702,"_5":17416,"_23752":97607,"_2384":97703},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_2857":58325,"_25085":58284,"_17521":97705,"_5":17416,"_23752":97607,"_2384":97706},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_2857":58326,"_25085":58284,"_17521":97708,"_5":17416,"_23752":97607,"_2384":97709},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_2857":58327,"_25085":58284,"_17521":97711,"_5":17416,"_23752":97607,"_2384":97712},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_2857":58328,"_25085":58284,"_17521":97714,"_5":17416,"_23752":97611,"_2384":97715},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_2857":58329,"_25085":58284,"_17521":97717,"_5":17416,"_23752":97615,"_2384":97718},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_2857":58330,"_25085":58284,"_17521":97720,"_5":17416,"_23752":97615,"_2384":97721},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_2857":58331,"_25085":58284,"_17521":97723,"_5":17416,"_23752":97615,"_2384":97724},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_2857":58332,"_25085":58284,"_17521":97726,"_5":17416,"_23752":97615,"_2384":97727},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_2857":58333,"_25085":58284,"_17521":97729,"_5":17416,"_23752":97615,"_2384":97730},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_2857":58334,"_25085":58284,"_17521":97732,"_5":17416,"_23752":97615,"_2384":97733},[],"**Validación:** `va.role.crl.create`.",{"_2857":58335,"_25085":58284,"_17521":97735,"_5":17416,"_23752":97615,"_2384":97736},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_2857":58336,"_25085":58284,"_17521":97738,"_5":17416,"_23752":97615,"_2384":97739},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_2857":58337,"_25085":58337,"_5":12285,"_2384":97741,"_25421":97742,"_17521":97743,"_23752":58337},"Registros de auditoría",[40762,97039,97040],[],{"_2857":58338,"_25085":58337,"_17521":97745,"_5":17416,"_23752":58337,"_2384":97746},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_2857":58339,"_25085":58337,"_5":25418,"_17521":97748,"_23752":97749,"_2384":97750},[],"/docs/pr-preview/pr-46/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_2857":58340,"_25085":58337,"_5":25418,"_17521":97752,"_23752":97753,"_2384":97754},[],"/docs/pr-preview/pr-46/es/platform/administration/audit-logs#cobertura","Cobertura",{"_2857":58341,"_25085":58337,"_5":25418,"_17521":97756,"_23752":97757,"_2384":97758},[],"/docs/pr-preview/pr-46/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_2857":58342,"_25085":58337,"_5":25418,"_17521":97760,"_23752":97761,"_2384":97762},[],"/docs/pr-preview/pr-46/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_2857":58343,"_25085":58337,"_5":25418,"_17521":97764,"_23752":97765,"_2384":97766},[],"/docs/pr-preview/pr-46/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_2857":58344,"_25085":58337,"_5":25418,"_17521":97768,"_23752":97769,"_2384":97770},[],"/docs/pr-preview/pr-46/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_2857":58345,"_25085":58337,"_5":25418,"_17521":97772,"_23752":97773,"_2384":97774},[],"/docs/pr-preview/pr-46/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_2857":58346,"_25085":58337,"_5":25418,"_17521":97776,"_23752":97777,"_2384":97778},[],"/docs/pr-preview/pr-46/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_2857":58347,"_25085":58337,"_5":25418,"_17521":97780,"_23752":97781,"_2384":97782},[],"/docs/pr-preview/pr-46/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_2857":58348,"_25085":58337,"_5":25418,"_17521":97784,"_23752":97785,"_2384":97786},[],"/docs/pr-preview/pr-46/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_2857":58349,"_25085":58337,"_5":25418,"_17521":97788,"_23752":97789,"_2384":97790},[],"/docs/pr-preview/pr-46/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_2857":58350,"_25085":58337,"_17521":97792,"_5":17416,"_23752":58337,"_2384":97793},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_2857":58351,"_25085":58337,"_17521":97795,"_5":17416,"_23752":97749,"_2384":97796},[],"El cuerpo de auditoría incluye:",{"_2857":58352,"_25085":58337,"_17521":97798,"_5":17416,"_23752":97749,"_2384":97799},[],"input: datos recibidos por la operación;",{"_2857":58353,"_25085":58337,"_17521":97801,"_5":17416,"_23752":97749,"_2384":97802},[],"has\\_error: indica si el servicio devolvió un error;",{"_2857":58354,"_25085":58337,"_17521":97804,"_5":17416,"_23752":97749,"_2384":97805},[],"output: resultado producido o mensaje de error;",{"_2857":58355,"_25085":58337,"_17521":97807,"_5":17416,"_23752":97749,"_2384":97808},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_2857":58356,"_25085":58337,"_17521":97810,"_5":17416,"_23752":97749,"_2384":97811},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_2857":58357,"_25085":58337,"_17521":97813,"_5":17416,"_23752":97749,"_2384":97814},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_2857":58358,"_25085":58337,"_17521":97816,"_5":17416,"_23752":97753,"_2384":97817},[],"El backend aplica auditoría a mutaciones de:",{"_2857":58359,"_25085":58337,"_17521":97819,"_5":17416,"_23752":97753,"_2384":97820},[],"autoridades, certificados y perfiles de emisión;",{"_2857":58360,"_25085":58337,"_17521":97822,"_5":17416,"_23752":97753,"_2384":97823},[],"claves y motores KMS;",{"_2857":58361,"_25085":58337,"_17521":97825,"_5":17416,"_23752":97753,"_2384":97826},[],"dispositivos e identidades;",{"_2857":58362,"_25085":58337,"_17521":97828,"_5":17416,"_23752":97753,"_2384":97829},[],"DMS y operaciones de enrolamiento;",{"_2857":58363,"_25085":58337,"_17521":97831,"_5":17416,"_23752":97753,"_2384":97832},[],"funciones de validación y CRL;",{"_2857":58364,"_25085":58337,"_17521":97834,"_5":17416,"_23752":97753,"_2384":97835},[],"principales, políticas y concesiones de autorización.",{"_2857":58365,"_25085":58337,"_17521":97837,"_5":17416,"_23752":97753,"_2384":97838},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_2857":58366,"_25085":58337,"_17521":97840,"_5":17416,"_23752":97757,"_2384":97841},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_2857":58367,"_25085":58337,"_17521":97843,"_5":17416,"_23752":97757,"_2384":97844},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_2857":58368,"_25085":58337,"_17521":97846,"_5":17416,"_23752":97757,"_2384":97847},[],"Diseña el consumidor para:",{"_2857":58369,"_25085":58337,"_17521":97849,"_5":17416,"_23752":97757,"_2384":97850},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_2857":58370,"_25085":58337,"_17521":97852,"_5":17416,"_23752":97757,"_2384":97853},[],"conservar el CloudEvent completo sin modificar;",{"_2857":58371,"_25085":58337,"_17521":97855,"_5":17416,"_23752":97757,"_2384":97856},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_2857":58372,"_25085":58337,"_17521":97858,"_5":17416,"_23752":97757,"_2384":97859},[],"cifrar en tránsito y en reposo;",{"_2857":58373,"_25085":58337,"_17521":97861,"_5":17416,"_23752":97757,"_2384":97862},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_2857":58374,"_25085":58337,"_17521":97864,"_5":17416,"_23752":97757,"_2384":97865},[],"aplicar una política explícita de retención y legal hold;",{"_2857":58375,"_25085":58337,"_17521":97867,"_5":17416,"_23752":97757,"_2384":97868},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_2857":58376,"_25085":58337,"_17521":97870,"_5":17416,"_23752":97761,"_2384":97871},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_2857":58377,"_25085":58337,"_17521":97873,"_5":17416,"_23752":97761,"_2384":97874},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_2857":58378,"_25085":58337,"_17521":97876,"_5":17416,"_23752":97769,"_2384":97877},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_2857":58379,"_25085":58337,"_17521":97879,"_5":17416,"_23752":97773,"_2384":97880},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_2857":58380,"_25085":58337,"_17521":97882,"_5":17416,"_23752":97777,"_2384":97883},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_2857":58381,"_25085":58337,"_17521":97885,"_5":17416,"_23752":97781,"_2384":97886},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_2857":58382,"_25085":58337,"_17521":97888,"_5":17416,"_23752":97785,"_2384":97889},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_2857":58383,"_25085":58337,"_17521":97891,"_5":17416,"_23752":97789,"_2384":97892},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_2857":58384,"_25085":58337,"_17521":97894,"_5":17416,"_23752":97789,"_2384":97895},[],"aparece un evento de auditoría correcto;",{"_2857":58385,"_25085":58337,"_17521":97897,"_5":17416,"_23752":97789,"_2384":97898},[],"el principal coincide con la identidad utilizada;",{"_2857":58386,"_25085":58337,"_17521":97900,"_5":17416,"_23752":97789,"_2384":97901},[],"el consumidor lo persiste una sola vez;",{"_2857":58387,"_25085":58337,"_17521":97903,"_5":17416,"_23752":97789,"_2384":97904},[],"puede recuperarse por recurso, actor y periodo;",{"_2857":58388,"_25085":58337,"_17521":97906,"_5":17416,"_23752":97789,"_2384":97907},[],"una interrupción del consumidor produce una alerta.",{"_2857":58389,"_25085":58337,"_17521":97909,"_5":17416,"_23752":97789,"_2384":97910},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_2857":58390,"_25085":58390,"_5":12285,"_2384":97912,"_25421":97913,"_17521":97914,"_23752":58390},"Arquitectura de la plataforma",[40762,97039],[],{"_2857":58391,"_25085":58390,"_17521":97916,"_5":17416,"_23752":58390,"_2384":97917},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_2857":58392,"_25085":58390,"_5":25418,"_17521":97919,"_23752":97920,"_2384":97921},[],"/docs/pr-preview/pr-46/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_2857":58393,"_25085":58390,"_5":25418,"_17521":97923,"_23752":97924,"_2384":97925},[],"/docs/pr-preview/pr-46/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_2857":58394,"_25085":58390,"_5":25418,"_17521":97927,"_23752":97928,"_2384":97929},[],"/docs/pr-preview/pr-46/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_2857":58395,"_25085":58390,"_5":25418,"_17521":97931,"_23752":97932,"_2384":97933},[],"/docs/pr-preview/pr-46/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_2857":58396,"_25085":58390,"_5":25418,"_17521":97935,"_23752":97936,"_2384":97937},[],"/docs/pr-preview/pr-46/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_2857":58397,"_25085":58390,"_17521":97939,"_5":17416,"_23752":58390,"_2384":97940},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_2857":58398,"_25085":58390,"_17521":97942,"_5":17416,"_23752":58390,"_2384":97943},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_2857":58399,"_25085":58390,"_17521":97945,"_5":17416,"_23752":97920,"_2384":97946},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_2857":58400,"_25085":58390,"_17521":97948,"_5":17416,"_23752":97924,"_2384":97949},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_2857":58401,"_25085":58390,"_17521":97951,"_5":17416,"_23752":97928,"_2384":97952},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_2857":58402,"_25085":58390,"_17521":97954,"_5":17416,"_23752":97932,"_2384":97955},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_2857":58403,"_25085":58390,"_17521":97957,"_5":17416,"_23752":97936,"_2384":97958},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_2857":58404,"_25085":58404,"_5":12285,"_2384":97960,"_25421":97961,"_17521":97962,"_23752":58404},"Cómo funciona Lamassu",[40762,97039],[],{"_2857":58405,"_25085":58404,"_17521":97964,"_5":17416,"_23752":58404,"_2384":97965},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_2857":58406,"_25085":58404,"_5":25418,"_17521":97967,"_23752":97968,"_2384":97969},[],"/docs/pr-preview/pr-46/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_2857":58407,"_25085":58404,"_5":25418,"_17521":97971,"_23752":97972,"_2384":97973},[],"/docs/pr-preview/pr-46/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_2857":58408,"_25085":58404,"_17521":97975,"_5":17416,"_23752":58404,"_2384":97976},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_2857":58409,"_25085":58404,"_17521":97978,"_5":17416,"_23752":97968,"_2384":97979},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_2857":58410,"_25085":58404,"_17521":97981,"_5":17416,"_23752":97968,"_2384":97982},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_2857":58411,"_25085":58404,"_17521":97984,"_5":17416,"_23752":97968,"_2384":97985},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_2857":58412,"_25085":58404,"_17521":97987,"_5":17416,"_23752":97968,"_2384":97988},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_2857":58413,"_25085":58404,"_17521":97990,"_5":17416,"_23752":97968,"_2384":97991},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_2857":58414,"_25085":58404,"_17521":97993,"_5":17416,"_23752":97972,"_2384":97994},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_2857":58415,"_25085":58404,"_17521":97996,"_5":17416,"_23752":97972,"_2384":97997},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_2857":58416,"_25085":58404,"_17521":97999,"_5":17416,"_23752":97972,"_2384":98000},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_2857":58417,"_25085":58404,"_17521":98002,"_5":17416,"_23752":97972,"_2384":98003},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_2857":58418,"_25085":58404,"_17521":98005,"_5":17416,"_23752":97972,"_2384":98006},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_2857":58419,"_25085":58404,"_17521":98008,"_5":17416,"_23752":97972,"_2384":98009},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_2857":58420,"_25085":58404,"_17521":98011,"_5":17416,"_23752":97972,"_2384":98012},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2857":58421,"_25085":58421,"_5":12285,"_2384":98014,"_25421":98015,"_17521":98016,"_23752":58421},"Dispositivos e identidades",[40762,97039,43083,98014],[],{"_2857":58422,"_25085":58421,"_17521":98018,"_5":17416,"_23752":58421,"_2384":98019},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_2857":58423,"_25085":58421,"_5":25418,"_17521":98021,"_23752":98022,"_2384":98023},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_2857":58424,"_25085":58421,"_5":25418,"_17521":98025,"_23752":98026,"_2384":98027},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_2857":58425,"_25085":58421,"_5":25418,"_17521":98029,"_23752":98030,"_2384":98031},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_2857":58426,"_25085":58421,"_5":25418,"_17521":98033,"_23752":98034,"_2384":98035},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_2857":58427,"_25085":58421,"_5":25418,"_17521":98037,"_23752":98038,"_2384":98039},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_2857":58428,"_25085":58421,"_5":25418,"_17521":98041,"_23752":98042,"_2384":98043},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_2857":58429,"_25085":58421,"_5":25418,"_17521":98045,"_23752":98046,"_2384":98047},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_2857":58430,"_25085":58421,"_5":25418,"_17521":98049,"_23752":98050,"_2384":98051},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_2857":58431,"_25085":58421,"_5":25418,"_17521":98053,"_23752":98054,"_2384":98055},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_2857":58432,"_25085":58421,"_5":25418,"_17521":98057,"_23752":98058,"_2384":98059},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_2857":58433,"_25085":58421,"_5":25418,"_17521":98061,"_23752":98062,"_2384":98063},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_2857":58434,"_25085":58421,"_17521":98065,"_5":17416,"_23752":58421,"_2384":98066},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_2857":58435,"_25085":58421,"_17521":98068,"_5":17416,"_23752":58421,"_2384":98069},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_2857":58436,"_25085":58421,"_17521":98071,"_5":17416,"_23752":98022,"_2384":98072},[],"Vista operativa",{"_2857":58437,"_25085":58421,"_17521":98074,"_5":17416,"_23752":98022,"_2384":98075},[],"Interpretación",{"_2857":58438,"_25085":58421,"_17521":98077,"_5":17416,"_23752":98022,"_2384":43146},[],{"_2857":58439,"_25085":58421,"_17521":98079,"_5":17416,"_23752":98022,"_2384":98080},[],"Hay registro, pero todavía no hay identidad asociada.",{"_2857":58440,"_25085":58421,"_17521":98082,"_5":17416,"_23752":98022,"_2384":43152},[],{"_2857":58441,"_25085":58421,"_17521":98084,"_5":17416,"_23752":98022,"_2384":98085},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_2857":58442,"_25085":58421,"_17521":98087,"_5":17416,"_23752":98022,"_2384":43158},[],{"_2857":58443,"_25085":58421,"_17521":98089,"_5":17416,"_23752":98022,"_2384":98090},[],"La identidad está en la ventana operativa de renovación.",{"_2857":58444,"_25085":58421,"_17521":98092,"_5":17416,"_23752":98022,"_2384":43164},[],{"_2857":58445,"_25085":58421,"_17521":98094,"_5":17416,"_23752":98022,"_2384":98095},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_2857":58446,"_25085":58421,"_17521":98097,"_5":17416,"_23752":98022,"_2384":43170},[],{"_2857":58447,"_25085":58421,"_17521":98099,"_5":17416,"_23752":98022,"_2384":98100},[],"La identidad ha vencido.",{"_2857":58448,"_25085":58421,"_17521":98102,"_5":17416,"_23752":98022,"_2384":43176},[],{"_2857":58449,"_25085":58421,"_17521":98104,"_5":17416,"_23752":98022,"_2384":98105},[],"La identidad está marcada como revocada.",{"_2857":58450,"_25085":58421,"_17521":98107,"_5":17416,"_23752":98022,"_2384":43182},[],{"_2857":58451,"_25085":58421,"_17521":98109,"_5":17416,"_23752":98022,"_2384":98110},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_2857":58452,"_25085":58421,"_17521":98112,"_5":17416,"_23752":98022,"_2384":98113},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_2857":58453,"_25085":58421,"_17521":98115,"_5":17416,"_23752":98026,"_2384":98116},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_2857":58454,"_25085":58421,"_17521":98118,"_5":17416,"_23752":98026,"_2384":98119},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_2857":58455,"_25085":58421,"_17521":98121,"_5":17416,"_23752":98026,"_2384":98122},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_2857":58456,"_25085":58421,"_17521":98124,"_5":17416,"_23752":98026,"_2384":98125},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_2857":58457,"_25085":58421,"_17521":98127,"_5":17416,"_23752":98030,"_2384":98128},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_2857":58458,"_25085":58421,"_17521":98130,"_5":17416,"_23752":98034,"_2384":98131},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_2857":58459,"_25085":58421,"_17521":98133,"_5":17416,"_23752":98038,"_2384":98134},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_2857":58460,"_25085":58421,"_17521":98136,"_5":17416,"_23752":98042,"_2384":98137},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_2857":58461,"_25085":58421,"_17521":98139,"_5":17416,"_23752":98046,"_2384":98140},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_2857":58462,"_25085":58421,"_17521":98142,"_5":17416,"_23752":98046,"_2384":98143},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_2857":58463,"_25085":58421,"_17521":98145,"_5":17416,"_23752":98050,"_2384":98146},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_2857":58464,"_25085":58421,"_17521":98148,"_5":17416,"_23752":98050,"_2384":98149},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_2857":58465,"_25085":58421,"_17521":98151,"_5":17416,"_23752":98050,"_2384":98152},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_2857":58466,"_25085":58421,"_17521":98154,"_5":17416,"_23752":98050,"_2384":98155},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_2857":58467,"_25085":58421,"_17521":98157,"_5":17416,"_23752":98050,"_2384":98158},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_2857":58468,"_25085":58421,"_17521":98160,"_5":17416,"_23752":98050,"_2384":98161},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_2857":58469,"_25085":58421,"_17521":98163,"_5":17416,"_23752":98054,"_2384":98164},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_2857":58470,"_25085":58421,"_17521":98166,"_5":17416,"_23752":98054,"_2384":98167},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_2857":58471,"_25085":58421,"_17521":98169,"_5":17416,"_23752":98058,"_2384":98170},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_2857":58472,"_25085":58421,"_17521":98172,"_5":17416,"_23752":98058,"_2384":98173},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_2857":58473,"_25085":58421,"_17521":98175,"_5":17416,"_23752":98058,"_2384":98176},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_2857":58474,"_25085":58421,"_17521":98178,"_5":17416,"_23752":98058,"_2384":98179},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_2857":58475,"_25085":58421,"_17521":98181,"_5":17416,"_23752":98062,"_2384":98182},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2857":58476,"_25085":58421,"_17521":98184,"_5":17416,"_23752":98062,"_2384":98185},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2857":58477,"_25085":58477,"_5":12285,"_2384":98187,"_25421":98188,"_17521":98190,"_23752":58477},"Identidad inicial y autenticación",[40762,97039,43083,98014,98189],"Enrolamiento con PKI",[],{"_2857":58478,"_25085":58477,"_17521":98192,"_5":17416,"_23752":58477,"_2384":98193},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_2857":58479,"_25085":58477,"_5":25418,"_17521":98195,"_23752":98196,"_2384":98197},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_2857":58480,"_25085":58477,"_5":25418,"_17521":98199,"_23752":98200,"_2384":98201},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_2857":58481,"_25085":58477,"_5":25418,"_17521":98203,"_23752":98204,"_2384":98205},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_2857":58482,"_25085":58477,"_5":25418,"_17521":98207,"_23752":98208,"_2384":98209},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_2857":58483,"_25085":58477,"_5":25418,"_17521":98211,"_23752":98212,"_2384":98213},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_2857":58484,"_25085":58477,"_17521":98215,"_5":17416,"_23752":58477,"_2384":98216},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_2857":58485,"_25085":58477,"_17521":98218,"_5":17416,"_23752":98196,"_2384":98219},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_2857":58486,"_25085":58477,"_17521":98221,"_5":17416,"_23752":98196,"_2384":98222},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_2857":58487,"_25085":58477,"_17521":98224,"_5":17416,"_23752":98200,"_2384":98225},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_2857":58488,"_25085":58477,"_17521":98227,"_5":17416,"_23752":98200,"_2384":98228},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_2857":58489,"_25085":58477,"_17521":98230,"_5":17416,"_23752":98200,"_2384":98231},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_2857":58490,"_25085":58477,"_17521":98233,"_5":17416,"_23752":98204,"_2384":98234},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_2857":58491,"_25085":58477,"_17521":98236,"_5":17416,"_23752":98204,"_2384":98237},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_2857":58492,"_25085":58477,"_17521":98239,"_5":17416,"_23752":98208,"_2384":98240},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_2857":58493,"_25085":58477,"_17521":98242,"_5":17416,"_23752":98208,"_2384":98243},[],"Ejemplo de cuerpo:",{"_2857":58494,"_25085":58477,"_17521":98245,"_5":17416,"_23752":98208,"_2384":98246},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_2857":58495,"_25085":58477,"_17521":98248,"_5":17416,"_23752":98208,"_2384":98249},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_2857":58496,"_25085":58477,"_17521":98251,"_5":17416,"_23752":98208,"_2384":98252},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_2857":58497,"_25085":58477,"_17521":98254,"_5":17416,"_23752":98208,"_2384":98255},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_2857":58498,"_25085":58477,"_17521":98257,"_5":17416,"_23752":98212,"_2384":98258},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_2857":58499,"_25085":58477,"_17521":98260,"_5":17416,"_23752":98212,"_2384":98261},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_2857":58500,"_25085":58500,"_5":12285,"_2384":98263,"_25421":98264,"_17521":98265,"_23752":58500},"Configura y opera el DMS",[40762,97039,43083,98014,98189],[],{"_2857":58501,"_25085":58500,"_17521":98267,"_5":17416,"_23752":58500,"_2384":98268},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_2857":58502,"_25085":58500,"_5":25418,"_17521":98270,"_23752":98271,"_2384":95740},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_2857":58503,"_25085":58500,"_5":25418,"_17521":98273,"_23752":98274,"_2384":98275},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_2857":58504,"_25085":58500,"_5":25418,"_17521":98277,"_23752":98278,"_2384":98279},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_2857":58505,"_25085":58500,"_5":25418,"_17521":98281,"_23752":98282,"_2384":98283},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_2857":58506,"_25085":58500,"_5":25418,"_17521":98285,"_23752":98286,"_2384":98287},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_2857":58507,"_25085":58500,"_5":25418,"_17521":98289,"_23752":98290,"_2384":98291},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_2857":58508,"_25085":58500,"_5":25418,"_17521":98293,"_23752":98294,"_2384":98295},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_2857":58509,"_25085":58500,"_5":25418,"_17521":98297,"_23752":98298,"_2384":98299},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_2857":58510,"_25085":58500,"_5":25418,"_17521":98301,"_23752":98302,"_2384":43378},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_2857":58511,"_25085":58500,"_5":25418,"_17521":98304,"_23752":98305,"_2384":43382},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_2857":58512,"_25085":58500,"_5":25418,"_17521":98307,"_23752":98308,"_2384":98309},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_2857":58513,"_25085":58500,"_5":25418,"_17521":98311,"_23752":98312,"_2384":98313},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_2857":58514,"_25085":58500,"_5":25418,"_17521":98315,"_23752":98316,"_2384":98317},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_2857":58515,"_25085":58500,"_5":25418,"_17521":98319,"_23752":98320,"_2384":98321},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_2857":58516,"_25085":58500,"_5":25418,"_17521":98323,"_23752":98324,"_2384":43402},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_2857":58517,"_25085":58500,"_5":25418,"_17521":98326,"_23752":98327,"_2384":98328},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_2857":58518,"_25085":58500,"_5":25418,"_17521":98330,"_23752":98331,"_2384":98332},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_2857":58519,"_25085":58500,"_5":25418,"_17521":98334,"_23752":98335,"_2384":98336},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_2857":58520,"_25085":58500,"_17521":98338,"_5":17416,"_23752":58500,"_2384":98339},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_2857":58521,"_25085":58500,"_17521":98341,"_5":17416,"_23752":98271,"_2384":98342},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_2857":58522,"_25085":58500,"_17521":98344,"_5":17416,"_23752":98271,"_2384":98345},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_2857":58523,"_25085":58500,"_17521":98347,"_5":17416,"_23752":98278,"_2384":98348},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_2857":58524,"_25085":58500,"_17521":98350,"_5":17416,"_23752":98282,"_2384":98351},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_2857":58525,"_25085":58500,"_17521":98353,"_5":17416,"_23752":98286,"_2384":98354},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_2857":58526,"_25085":58500,"_17521":98356,"_5":17416,"_23752":98290,"_2384":98357},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_2857":58527,"_25085":58500,"_17521":98359,"_5":17416,"_23752":98294,"_2384":98360},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_2857":58528,"_25085":58500,"_17521":98362,"_5":17416,"_23752":98302,"_2384":98363},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_2857":58529,"_25085":58500,"_17521":98365,"_5":17416,"_23752":98302,"_2384":98366},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_2857":58530,"_25085":58500,"_17521":98368,"_5":17416,"_23752":98305,"_2384":98369},[],"Campo de `settings.enrollment_settings`",{"_2857":58531,"_25085":58500,"_17521":98371,"_5":17416,"_23752":98305,"_2384":98372},[],"Decisión",{"_2857":58532,"_25085":58500,"_17521":98374,"_5":17416,"_23752":98305,"_2384":43453},[],{"_2857":58533,"_25085":58500,"_17521":98376,"_5":17416,"_23752":98305,"_2384":98377},[],"`EST_RFC7030` para estas operaciones.",{"_2857":58534,"_25085":58500,"_17521":98379,"_5":17416,"_23752":98305,"_2384":43459},[],{"_2857":58535,"_25085":58500,"_17521":98381,"_5":17416,"_23752":98305,"_2384":98382},[],"ID de la CA que firmará.",{"_2857":58536,"_25085":58500,"_17521":98384,"_5":17416,"_23752":98305,"_2384":43465},[],{"_2857":58537,"_25085":58500,"_17521":98386,"_5":17416,"_23752":98305,"_2384":98387},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_2857":58538,"_25085":58500,"_17521":98389,"_5":17416,"_23752":98305,"_2384":43471},[],{"_2857":58539,"_25085":58500,"_17521":98391,"_5":17416,"_23752":98305,"_2384":98392},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_2857":58540,"_25085":58500,"_17521":98394,"_5":17416,"_23752":98305,"_2384":43477},[],{"_2857":58541,"_25085":58500,"_17521":98396,"_5":17416,"_23752":98305,"_2384":98397},[],"Uno de los cuatro modos de autenticación.",{"_2857":58542,"_25085":58500,"_17521":98399,"_5":17416,"_23752":98305,"_2384":98400},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_2857":58543,"_25085":58500,"_17521":98402,"_5":17416,"_23752":98308,"_2384":98403},[],"Los bloques son independientes:",{"_2857":58544,"_25085":58500,"_17521":98405,"_5":17416,"_23752":98308,"_2384":98406},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_2857":58545,"_25085":58500,"_17521":98408,"_5":17416,"_23752":98308,"_2384":98409},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_2857":58546,"_25085":58500,"_17521":98411,"_5":17416,"_23752":98308,"_2384":43495},[],{"_2857":58547,"_25085":58500,"_17521":98413,"_5":17416,"_23752":98308,"_2384":98414},[],"Control aplicado en la operación configurada",{"_2857":58548,"_25085":58500,"_17521":98416,"_5":17416,"_23752":98308,"_2384":43501},[],{"_2857":58549,"_25085":58500,"_17521":98418,"_5":17416,"_23752":98308,"_2384":98419},[],"Validación del certificado presentado.",{"_2857":58550,"_25085":58500,"_17521":98421,"_5":17416,"_23752":98308,"_2384":43507},[],{"_2857":58551,"_25085":58500,"_17521":98423,"_5":17416,"_23752":98308,"_2384":98424},[],"Autorización del webhook configurado.",{"_2857":58552,"_25085":58500,"_17521":98426,"_5":17416,"_23752":98308,"_2384":43513},[],{"_2857":58553,"_25085":58500,"_17521":98428,"_5":17416,"_23752":98308,"_2384":98429},[],"Validación del certificado y, después, aprobación del webhook.",{"_2857":58554,"_25085":58500,"_17521":98431,"_5":17416,"_23752":98308,"_2384":43519},[],{"_2857":58555,"_25085":58500,"_17521":98433,"_5":17416,"_23752":98308,"_2384":98434},[],"Sin autenticación del solicitante por el DMS.",{"_2857":58556,"_25085":58500,"_17521":98436,"_5":17416,"_23752":98308,"_2384":98437},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_2857":58557,"_25085":58500,"_17521":98439,"_5":17416,"_23752":98308,"_2384":98440},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_2857":58558,"_25085":58500,"_17521":98442,"_5":17416,"_23752":98308,"_2384":98443},[],"En reenrolamiento con certificado, el validador utiliza la CA de enrolamiento, después `additional_validation_cas`, y la opción `enable_expired_renewal`. No presupongas que copiar `validation_cas` del bloque inicial cambia esos emisores.",{"_2857":58559,"_25085":58500,"_17521":98445,"_5":17416,"_23752":98308,"_2384":98446},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_2857":58560,"_25085":58500,"_17521":98448,"_5":17416,"_23752":98312,"_2384":98449},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_2857":58561,"_25085":58500,"_17521":98451,"_5":17416,"_23752":98312,"_2384":98452},[],"Campo de `external_webhook_settings`",{"_2857":58562,"_25085":58500,"_17521":98454,"_5":17416,"_23752":98312,"_2384":98372},[],{"_2857":58563,"_25085":58500,"_17521":98456,"_5":17416,"_23752":98312,"_2384":43545},[],{"_2857":58564,"_25085":58500,"_17521":98458,"_5":17416,"_23752":98312,"_2384":98459},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_2857":58565,"_25085":58500,"_17521":98461,"_5":17416,"_23752":98312,"_2384":43551},[],{"_2857":58566,"_25085":58500,"_17521":98463,"_5":17416,"_23752":98312,"_2384":98464},[],"`POST` o `PUT`; `POST` por defecto.",{"_2857":58567,"_25085":58500,"_17521":98466,"_5":17416,"_23752":98312,"_2384":43557},[],{"_2857":58568,"_25085":58500,"_17521":98468,"_5":17416,"_23752":98312,"_2384":98469},[],"Etiqueta usada en los logs del servicio.",{"_2857":58569,"_25085":58500,"_17521":98471,"_5":17416,"_23752":98312,"_2384":43563},[],{"_2857":58570,"_25085":58500,"_17521":98473,"_5":17416,"_23752":98312,"_2384":98474},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_2857":58571,"_25085":58500,"_17521":98476,"_5":17416,"_23752":98312,"_2384":43569},[],{"_2857":58572,"_25085":58500,"_17521":98478,"_5":17416,"_23752":98312,"_2384":98479},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_2857":58573,"_25085":58500,"_17521":98481,"_5":17416,"_23752":98312,"_2384":43575},[],{"_2857":58574,"_25085":58500,"_17521":98483,"_5":17416,"_23752":98312,"_2384":98484},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2857":58575,"_25085":58500,"_17521":98486,"_5":17416,"_23752":98312,"_2384":43581},[],{"_2857":58576,"_25085":58500,"_17521":98488,"_5":17416,"_23752":98312,"_2384":98489},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM en línea.",{"_2857":58577,"_25085":58500,"_17521":98491,"_5":17416,"_23752":98312,"_2384":43587},[],{"_2857":58578,"_25085":58500,"_17521":98493,"_5":17416,"_23752":98312,"_2384":98494},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_2857":58579,"_25085":58500,"_17521":98496,"_5":17416,"_23752":98312,"_2384":43593},[],{"_2857":58580,"_25085":58500,"_17521":98498,"_5":17416,"_23752":98312,"_2384":98499},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_2857":58581,"_25085":58500,"_17521":98501,"_5":17416,"_23752":98312,"_2384":98502},[],"Reglas de esa configuración:",{"_2857":58582,"_25085":58500,"_17521":98504,"_5":17416,"_23752":98312,"_2384":98505},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que entrega el PEM como `mtls_options.cert_content` y `key_content`.",{"_2857":58583,"_25085":58500,"_17521":98507,"_5":17416,"_23752":98312,"_2384":98508},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_2857":58584,"_25085":58500,"_17521":98510,"_5":17416,"_23752":98312,"_2384":98511},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_2857":58585,"_25085":58500,"_17521":98513,"_5":17416,"_23752":98312,"_2384":98514},[],"La API ignora los campos heredados `validate_server_cert`, `apikey`, `oidc` y `mtls`. Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` que aún solo contenga los campos de opción heredados (`apikey`, `oidc`, `mtls`) falla la validación con 400; solo se aceptan cuerpos heredados `noauth`, y sus credenciales se descartan.",{"_2857":58586,"_25085":58500,"_17521":98516,"_5":17416,"_23752":98312,"_2384":98517},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_2857":58587,"_25085":58500,"_17521":98519,"_5":17416,"_23752":98312,"_2384":98520},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_2857":58588,"_25085":58500,"_17521":98522,"_5":17416,"_23752":98312,"_2384":98523},[],"La migración `20260604110000` copia la autenticación inicial al bloque de renovación si este falta y existe la estructura necesaria. No sustituye una configuración ya presente. Después de actualizar, lee ambos bloques; si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_2857":58589,"_25085":58500,"_17521":98525,"_5":17416,"_23752":98312,"_2384":98526},[],"La migración `20261021120000` reescribe todas las configuraciones de webhook almacenadas con este formato: `validate_server_cert` pasa a ser `insecure_skip_verify` negado (una configuración con `validate_server_cert` a false sigue sin verificar el certificado), `oidc` pasa a ser `jwt_options`, `apikey` pasa a ser `apikey_options` y `mtls` pasa a ser `mtls_options`. Cuando el certificado y la clave heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `key_content` y no requieren ninguna acción. En cualquier otro caso, incluida una configuración mixta (certificado PEM y clave como ruta de fichero), ambos valores pasan a `mtls_options.cert_file` y `key_file`. La entrega rechaza cualquier configuración de webhook que haga referencia a ficheros, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se vuelvan a introducir como contenido PEM, o se eliminen los campos de fichero sobrantes si el webhook no usa mTLS. Si la consola de tu versión no muestra esos campos, edita el DMS mediante la API de DMS.",{"_2857":58590,"_25085":58500,"_17521":98528,"_5":17416,"_23752":98316,"_2384":98529},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_2857":58591,"_25085":58500,"_17521":98531,"_5":17416,"_23752":98320,"_2384":98532},[],"Campo de `settings.reenrollment_settings`",{"_2857":58592,"_25085":58500,"_17521":98534,"_5":17416,"_23752":98320,"_2384":98535},[],"Función",{"_2857":58593,"_25085":58500,"_17521":98537,"_5":17416,"_23752":98320,"_2384":43634},[],{"_2857":58594,"_25085":58500,"_17521":98539,"_5":17416,"_23752":98320,"_2384":98540},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_2857":58595,"_25085":58500,"_17521":98542,"_5":17416,"_23752":98320,"_2384":43640},[],{"_2857":58596,"_25085":58500,"_17521":98544,"_5":17416,"_23752":98320,"_2384":98545},[],"Umbral operativo preventivo de monitorización.",{"_2857":58597,"_25085":58500,"_17521":98547,"_5":17416,"_23752":98320,"_2384":43646},[],{"_2857":58598,"_25085":58500,"_17521":98549,"_5":17416,"_23752":98320,"_2384":98550},[],"Umbral operativo crítico de monitorización.",{"_2857":58599,"_25085":58500,"_17521":98552,"_5":17416,"_23752":98320,"_2384":43652},[],{"_2857":58600,"_25085":58500,"_17521":98554,"_5":17416,"_23752":98320,"_2384":98555},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_2857":58601,"_25085":58500,"_17521":98557,"_5":17416,"_23752":98320,"_2384":43658},[],{"_2857":58602,"_25085":58500,"_17521":98559,"_5":17416,"_23752":98320,"_2384":98560},[],"Emisores adicionales para la credencial mTLS durante una migración.",{"_2857":58603,"_25085":58500,"_17521":98562,"_5":17416,"_23752":98320,"_2384":43664},[],{"_2857":58604,"_25085":58500,"_17521":98564,"_5":17416,"_23752":98320,"_2384":98565},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_2857":58605,"_25085":58500,"_17521":98567,"_5":17416,"_23752":98320,"_2384":98568},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_2857":58606,"_25085":58500,"_17521":98570,"_5":17416,"_23752":98324,"_2384":98571},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. Algoritmo y tamaño proceden de su campo `key`; el perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_2857":58607,"_25085":58500,"_17521":98573,"_5":17416,"_23752":98327,"_2384":96097},[],{"_2857":58608,"_25085":58500,"_17521":98575,"_5":17416,"_23752":98327,"_2384":98576},[],"Qué publica",{"_2857":58609,"_25085":58500,"_17521":98578,"_5":17416,"_23752":98327,"_2384":43681},[],{"_2857":58610,"_25085":58500,"_17521":98580,"_5":17416,"_23752":98327,"_2384":98581},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_2857":58611,"_25085":58500,"_17521":98583,"_5":17416,"_23752":98327,"_2384":43687},[],{"_2857":58612,"_25085":58500,"_17521":98585,"_5":17416,"_23752":98327,"_2384":98586},[],"Certificado de la CA emisora seleccionada.",{"_2857":58613,"_25085":58500,"_17521":98588,"_5":17416,"_23752":98327,"_2384":43693},[],{"_2857":58614,"_25085":58500,"_17521":98590,"_5":17416,"_23752":98327,"_2384":98591},[],"Certificados de las CAs elegidas explícitamente.",{"_2857":58615,"_25085":58500,"_17521":98593,"_5":17416,"_23752":98327,"_2384":98594},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_2857":58616,"_25085":58500,"_17521":98596,"_5":17416,"_23752":98331,"_2384":98597},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_2857":58617,"_25085":58500,"_17521":98599,"_5":17416,"_23752":98331,"_2384":98600},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_2857":58618,"_25085":58500,"_17521":98602,"_5":17416,"_23752":98331,"_2384":98603},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_2857":58619,"_25085":58500,"_17521":98605,"_5":17416,"_23752":98335,"_2384":98606},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_2857":58620,"_25085":58620,"_5":12285,"_2384":98608,"_25421":98609,"_17521":98610,"_23752":58620},"Integra el cliente EST",[40762,97039,43083,98014,98189],[],{"_2857":58621,"_25085":58620,"_17521":98612,"_5":17416,"_23752":58620,"_2384":98613},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_2857":58622,"_25085":58620,"_5":25418,"_17521":98615,"_23752":98616,"_2384":95740},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_2857":58623,"_25085":58620,"_5":25418,"_17521":98618,"_23752":98619,"_2384":98620},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_2857":58624,"_25085":58620,"_5":25418,"_17521":98622,"_23752":98623,"_2384":98624},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_2857":58625,"_25085":58620,"_5":25418,"_17521":98626,"_23752":98627,"_2384":98628},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_2857":58626,"_25085":58620,"_5":25418,"_17521":98630,"_23752":98631,"_2384":98632},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_2857":58627,"_25085":58620,"_5":25418,"_17521":98634,"_23752":98635,"_2384":98636},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_2857":58628,"_25085":58620,"_17521":98638,"_5":17416,"_23752":58620,"_2384":98639},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_2857":58629,"_25085":58620,"_17521":98641,"_5":17416,"_23752":98616,"_2384":98642},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_2857":58630,"_25085":58620,"_17521":98644,"_5":17416,"_23752":98616,"_2384":98645},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_2857":58631,"_25085":58620,"_17521":98647,"_5":17416,"_23752":98616,"_2384":98648},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_2857":58632,"_25085":58620,"_17521":98650,"_5":17416,"_23752":98619,"_2384":98651},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_2857":58633,"_25085":58620,"_17521":98653,"_5":17416,"_23752":98619,"_2384":98654},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_2857":58634,"_25085":58620,"_17521":98656,"_5":17416,"_23752":98623,"_2384":98657},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_2857":58635,"_25085":58620,"_17521":98659,"_5":17416,"_23752":98623,"_2384":98660},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_2857":58636,"_25085":58620,"_17521":98662,"_5":17416,"_23752":98627,"_2384":98663},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_2857":58637,"_25085":58620,"_17521":98665,"_5":17416,"_23752":98627,"_2384":98666},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_2857":58638,"_25085":58620,"_17521":98668,"_5":17416,"_23752":98631,"_2384":98669},[],"Para el caso de una raíz que emite directamente:",{"_2857":58639,"_25085":58620,"_17521":98671,"_5":17416,"_23752":98631,"_2384":98672},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_2857":58640,"_25085":58620,"_17521":98674,"_5":17416,"_23752":98631,"_2384":98675},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_2857":58641,"_25085":58620,"_17521":98677,"_5":17416,"_23752":98635,"_2384":98678},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_2857":58642,"_25085":58642,"_5":12285,"_2384":98680,"_25421":98681,"_17521":98682,"_23752":58642},"Referencia EST",[40762,97039,43083,98014,98189],[],{"_2857":58643,"_25085":58642,"_17521":98684,"_5":17416,"_23752":58642,"_2384":98685},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_2857":58644,"_25085":58642,"_5":25418,"_17521":98687,"_23752":98688,"_2384":98689},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_2857":58645,"_25085":58642,"_5":25418,"_17521":98691,"_23752":98692,"_2384":19025},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2857":58646,"_25085":58642,"_5":25418,"_17521":98694,"_23752":98695,"_2384":21785},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2857":58647,"_25085":58642,"_5":25418,"_17521":98697,"_23752":98698,"_2384":21792},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2857":58648,"_25085":58642,"_5":25418,"_17521":98700,"_23752":98701,"_2384":21162},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2857":58649,"_25085":58642,"_5":25418,"_17521":98703,"_23752":98704,"_2384":98705},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_2857":58650,"_25085":58642,"_5":25418,"_17521":98707,"_23752":98708,"_2384":98709},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_2857":58651,"_25085":58642,"_5":25418,"_17521":98711,"_23752":98712,"_2384":98713},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_2857":58652,"_25085":58642,"_17521":98715,"_5":17416,"_23752":58642,"_2384":98716},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_2857":58653,"_25085":58642,"_17521":98718,"_5":17416,"_23752":98688,"_2384":98719},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_2857":58654,"_25085":58642,"_17521":98721,"_5":17416,"_23752":98688,"_2384":96830},[],{"_2857":58655,"_25085":58642,"_17521":98723,"_5":17416,"_23752":98688,"_2384":98724},[],"Método",{"_2857":58656,"_25085":58642,"_17521":98726,"_5":17416,"_23752":98688,"_2384":98727},[],"Autenticación y condición",{"_2857":58657,"_25085":58642,"_17521":98729,"_5":17416,"_23752":98688,"_2384":43836},[],{"_2857":58658,"_25085":58642,"_17521":98731,"_5":17416,"_23752":98688,"_2384":43839},[],{"_2857":58659,"_25085":58642,"_17521":98733,"_5":17416,"_23752":98688,"_2384":98734},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_2857":58660,"_25085":58642,"_17521":98736,"_5":17416,"_23752":98688,"_2384":43845},[],{"_2857":58661,"_25085":58642,"_17521":98738,"_5":17416,"_23752":98688,"_2384":43848},[],{"_2857":58662,"_25085":58642,"_17521":98740,"_5":17416,"_23752":98688,"_2384":98741},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_2857":58663,"_25085":58642,"_17521":98743,"_5":17416,"_23752":98688,"_2384":43854},[],{"_2857":58664,"_25085":58642,"_17521":98745,"_5":17416,"_23752":98688,"_2384":43848},[],{"_2857":58665,"_25085":58642,"_17521":98747,"_5":17416,"_23752":98688,"_2384":98748},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_2857":58666,"_25085":58642,"_17521":98750,"_5":17416,"_23752":98688,"_2384":43862},[],{"_2857":58667,"_25085":58642,"_17521":98752,"_5":17416,"_23752":98688,"_2384":43848},[],{"_2857":58668,"_25085":58642,"_17521":98754,"_5":17416,"_23752":98688,"_2384":98755},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_2857":58669,"_25085":58642,"_17521":98757,"_5":17416,"_23752":98688,"_2384":98758},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_2857":58670,"_25085":58642,"_17521":98760,"_5":17416,"_23752":98692,"_2384":98761},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_2857":58671,"_25085":58642,"_17521":98763,"_5":17416,"_23752":98692,"_2384":98764},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_2857":58672,"_25085":58642,"_17521":98766,"_5":17416,"_23752":98695,"_2384":98767},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_2857":58673,"_25085":58642,"_17521":98769,"_5":17416,"_23752":98695,"_2384":98770},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_2857":58674,"_25085":58642,"_17521":98772,"_5":17416,"_23752":98698,"_2384":98773},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_2857":58675,"_25085":58642,"_17521":98775,"_5":17416,"_23752":98698,"_2384":98776},[],"La CA de enrolamiento o una CA adicional valida la credencial en el modo mTLS. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_2857":58676,"_25085":58642,"_17521":98778,"_5":17416,"_23752":98701,"_2384":98779},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_2857":58677,"_25085":58642,"_17521":98781,"_5":17416,"_23752":98701,"_2384":98782},[],"El código admite RSA y ECDSA de 224, 256, 384 o 521 bits. Un tamaño ECDSA no reconocido puede producir fallback a 256; elige explícitamente un tamaño compatible y comprueba la clave resultante. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_2857":58678,"_25085":58642,"_17521":98784,"_5":17416,"_23752":98704,"_2384":98785},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_2857":58679,"_25085":58642,"_17521":98787,"_5":17416,"_23752":98704,"_2384":98788},[],"Parte",{"_2857":58680,"_25085":58642,"_17521":98790,"_5":17416,"_23752":98704,"_2384":98791},[],"Contenido tras decodificar su Base64",{"_2857":58681,"_25085":58642,"_17521":98793,"_5":17416,"_23752":98704,"_2384":43906},[],{"_2857":58682,"_25085":58642,"_17521":98795,"_5":17416,"_23752":98704,"_2384":98796},[],"Clave privada PKCS#8 DER sin cifrar.",{"_2857":58683,"_25085":58642,"_17521":98798,"_5":17416,"_23752":98704,"_2384":43912},[],{"_2857":58684,"_25085":58642,"_17521":98800,"_5":17416,"_23752":98704,"_2384":98801},[],"PKCS#7 DER con el certificado emitido.",{"_2857":58685,"_25085":58642,"_17521":98803,"_5":17416,"_23752":98704,"_2384":98804},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_2857":58686,"_25085":58642,"_17521":98806,"_5":17416,"_23752":98708,"_2384":98807},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_2857":58687,"_25085":58642,"_17521":98809,"_5":17416,"_23752":98708,"_2384":98810},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_2857":58688,"_25085":58642,"_17521":98812,"_5":17416,"_23752":98708,"_2384":98813},[],"Convierte y comprueba el resultado:",{"_2857":58689,"_25085":58642,"_17521":98815,"_5":17416,"_23752":98708,"_2384":98816},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_2857":58690,"_25085":58642,"_17521":98818,"_5":17416,"_23752":98712,"_2384":98819},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_2857":58691,"_25085":58642,"_17521":98821,"_5":17416,"_23752":98712,"_2384":98822},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_2857":58692,"_25085":58692,"_5":12285,"_2384":98189,"_25421":98824,"_17521":98825,"_23752":58692},[40762,97039,43083,98014,98189],[],{"_2857":58693,"_25085":58692,"_17521":98827,"_5":17416,"_23752":58692,"_2384":98828},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_2857":58694,"_25085":58692,"_5":25418,"_17521":98830,"_23752":98831,"_2384":98832},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_2857":58695,"_25085":58692,"_5":25418,"_17521":98834,"_23752":98835,"_2384":98836},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_2857":58696,"_25085":58692,"_5":25418,"_17521":98838,"_23752":98839,"_2384":98840},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_2857":58697,"_25085":58692,"_5":25418,"_17521":98842,"_23752":98843,"_2384":98844},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_2857":58698,"_25085":58692,"_17521":98846,"_5":17416,"_23752":58692,"_2384":98847},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_2857":58699,"_25085":58692,"_17521":98849,"_5":17416,"_23752":98831,"_2384":98850},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_2857":58700,"_25085":58692,"_17521":98852,"_5":17416,"_23752":98831,"_2384":98853},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_2857":58701,"_25085":58692,"_17521":98855,"_5":17416,"_23752":98831,"_2384":98856},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_2857":58702,"_25085":58692,"_17521":98858,"_5":17416,"_23752":98831,"_2384":98859},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_2857":58703,"_25085":58692,"_17521":98861,"_5":17416,"_23752":98831,"_2384":98862},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_2857":58704,"_25085":58692,"_17521":98864,"_5":17416,"_23752":98831,"_2384":98865},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_2857":58705,"_25085":58692,"_17521":98867,"_5":17416,"_23752":98835,"_2384":98868},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2857":58706,"_25085":58692,"_17521":98870,"_5":17416,"_23752":98835,"_2384":98871},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2857":58707,"_25085":58692,"_17521":98873,"_5":17416,"_23752":98835,"_2384":98874},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2857":58708,"_25085":58692,"_17521":98876,"_5":17416,"_23752":98835,"_2384":98877},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2857":58709,"_25085":58692,"_17521":98879,"_5":17416,"_23752":98839,"_2384":98880},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2857":58710,"_25085":58692,"_17521":98882,"_5":17416,"_23752":98839,"_2384":98883},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2857":58711,"_25085":58692,"_17521":98885,"_5":17416,"_23752":98839,"_2384":98886},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2857":58712,"_25085":58692,"_17521":98888,"_5":17416,"_23752":98839,"_2384":98889},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2857":58713,"_25085":58692,"_17521":98891,"_5":17416,"_23752":98843,"_2384":98892},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato y migraciones, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_2857":58714,"_25085":58692,"_17521":98894,"_5":17416,"_23752":98843,"_2384":98895},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_2857":58715,"_25085":58715,"_5":12285,"_2384":98897,"_25421":98898,"_17521":98899,"_23752":58715},"Estrategias de aprovisionamiento",[40762,97039,43083,98014,98189],[],{"_2857":58716,"_25085":58715,"_17521":98901,"_5":17416,"_23752":58715,"_2384":98902},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_2857":58717,"_25085":58715,"_5":25418,"_17521":98904,"_23752":98905,"_2384":98906},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_2857":58718,"_25085":58715,"_5":25418,"_17521":98908,"_23752":98909,"_2384":98910},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_2857":58719,"_25085":58715,"_5":25418,"_17521":98912,"_23752":98913,"_2384":98914},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_2857":58720,"_25085":58715,"_5":25418,"_17521":98916,"_23752":98917,"_2384":98918},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_2857":58721,"_25085":58715,"_5":25418,"_17521":98920,"_23752":98921,"_2384":98922},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_2857":58722,"_25085":58715,"_17521":98924,"_5":17416,"_23752":58715,"_2384":98925},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_2857":58723,"_25085":58715,"_17521":98927,"_5":17416,"_23752":98905,"_2384":98928},[],"Recorrido",{"_2857":58724,"_25085":58715,"_17521":98930,"_5":17416,"_23752":98905,"_2384":98931},[],"Cuándo existe el dispositivo",{"_2857":58725,"_25085":58715,"_17521":98933,"_5":17416,"_23752":98905,"_2384":98934},[],"Qué compruebas",{"_2857":58726,"_25085":58715,"_17521":98936,"_5":17416,"_23752":98905,"_2384":98937},[],"Asignación manual",{"_2857":58727,"_25085":58715,"_17521":98939,"_5":17416,"_23752":98905,"_2384":98940},[],"El operador lo crea antes de asociar un certificado.",{"_2857":58728,"_25085":58715,"_17521":98942,"_5":17416,"_23752":98905,"_2384":98943},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_2857":58729,"_25085":58715,"_17521":98945,"_5":17416,"_23752":98905,"_2384":98946},[],"EST con `JITP`",{"_2857":58730,"_25085":58715,"_17521":98948,"_5":17416,"_23752":98905,"_2384":98949},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_2857":58731,"_25085":58715,"_17521":98951,"_5":17416,"_23752":98905,"_2384":98952},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_2857":58732,"_25085":58715,"_17521":98954,"_5":17416,"_23752":98905,"_2384":98955},[],"EST con `PRE_REGISTRATION`",{"_2857":58733,"_25085":58715,"_17521":98957,"_5":17416,"_23752":98905,"_2384":98958},[],"Debe existir antes de `/simpleenroll`.",{"_2857":58734,"_25085":58715,"_17521":98960,"_5":17416,"_23752":98905,"_2384":98961},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_2857":58735,"_25085":58715,"_17521":98963,"_5":17416,"_23752":98905,"_2384":98964},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_2857":58736,"_25085":58715,"_17521":98966,"_5":17416,"_23752":98905,"_2384":98967},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_2857":58737,"_25085":58715,"_17521":98969,"_5":17416,"_23752":98909,"_2384":98970},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_2857":58738,"_25085":58715,"_17521":98972,"_5":17416,"_23752":98909,"_2384":98973},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_2857":58739,"_25085":58715,"_17521":98975,"_5":17416,"_23752":98909,"_2384":98976},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_2857":58740,"_25085":58715,"_17521":98978,"_5":17416,"_23752":98913,"_2384":98979},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_2857":58741,"_25085":58715,"_17521":98981,"_5":17416,"_23752":98913,"_2384":98982},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_2857":58742,"_25085":58715,"_17521":98984,"_5":17416,"_23752":98913,"_2384":98985},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_2857":58743,"_25085":58715,"_17521":98987,"_5":17416,"_23752":98913,"_2384":98988},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_2857":58744,"_25085":58715,"_17521":98990,"_5":17416,"_23752":98913,"_2384":98991},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_2857":58745,"_25085":58715,"_17521":98993,"_5":17416,"_23752":98913,"_2384":98994},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_2857":58746,"_25085":58715,"_17521":98996,"_5":17416,"_23752":98917,"_2384":96097},[],{"_2857":58747,"_25085":58715,"_17521":98998,"_5":17416,"_23752":98917,"_2384":98999},[],"Material que atraviesa EST",{"_2857":58748,"_25085":58715,"_17521":99001,"_5":17416,"_23752":98917,"_2384":99002},[],"Clave generada por el dispositivo",{"_2857":58749,"_25085":58715,"_17521":99004,"_5":17416,"_23752":98917,"_2384":99005},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_2857":58750,"_25085":58715,"_17521":99007,"_5":17416,"_23752":98917,"_2384":99008},[],"Clave ya disponible en el dispositivo",{"_2857":58751,"_25085":58715,"_17521":99010,"_5":17416,"_23752":98917,"_2384":99011},[],"CSR firmada con la clave existente y certificado nuevo.",{"_2857":58752,"_25085":58715,"_17521":99013,"_5":17416,"_23752":98917,"_2384":43402},[],{"_2857":58753,"_25085":58715,"_17521":99015,"_5":17416,"_23752":98917,"_2384":99016},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_2857":58754,"_25085":58715,"_17521":99018,"_5":17416,"_23752":98917,"_2384":99019},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_2857":58755,"_25085":58715,"_17521":99021,"_5":17416,"_23752":98921,"_2384":99022},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_2857":58756,"_25085":58756,"_5":12285,"_2384":99024,"_25421":99025,"_17521":99026,"_23752":58756},"Renovación y recuperación",[40762,97039,43083,98014,98189],[],{"_2857":58757,"_25085":58756,"_17521":99028,"_5":17416,"_23752":58756,"_2384":99029},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_2857":58758,"_25085":58756,"_5":25418,"_17521":99031,"_23752":99032,"_2384":99033},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_2857":58759,"_25085":58756,"_5":25418,"_17521":99035,"_23752":99036,"_2384":99037},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_2857":58760,"_25085":58756,"_5":25418,"_17521":99039,"_23752":99040,"_2384":99041},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_2857":58761,"_25085":58756,"_5":25418,"_17521":99043,"_23752":99044,"_2384":99045},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_2857":58762,"_25085":58756,"_5":25418,"_17521":99047,"_23752":99048,"_2384":99049},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_2857":58763,"_25085":58756,"_17521":99051,"_5":17416,"_23752":58756,"_2384":99052},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_2857":58764,"_25085":58756,"_17521":99054,"_5":17416,"_23752":99032,"_2384":99055},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_2857":58765,"_25085":58756,"_17521":99057,"_5":17416,"_23752":99032,"_2384":99058},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_2857":58766,"_25085":58756,"_17521":99060,"_5":17416,"_23752":99032,"_2384":99061},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_2857":58767,"_25085":58756,"_17521":99063,"_5":17416,"_23752":99032,"_2384":99064},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_2857":58768,"_25085":58756,"_17521":99066,"_5":17416,"_23752":99036,"_2384":99067},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_2857":58769,"_25085":58756,"_17521":99069,"_5":17416,"_23752":99036,"_2384":99070},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_2857":58770,"_25085":58756,"_17521":99072,"_5":17416,"_23752":99040,"_2384":99073},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_2857":58771,"_25085":58756,"_17521":99075,"_5":17416,"_23752":99040,"_2384":99076},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_2857":58772,"_25085":58756,"_17521":99078,"_5":17416,"_23752":99040,"_2384":99079},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_2857":58773,"_25085":58756,"_17521":99081,"_5":17416,"_23752":99044,"_2384":99082},[],"Situación",{"_2857":58774,"_25085":58756,"_17521":99084,"_5":17416,"_23752":99044,"_2384":99085},[],"Procedimiento",{"_2857":58775,"_25085":58756,"_17521":99087,"_5":17416,"_23752":99044,"_2384":99088},[],"Certificado vigente, fuera de ventana",{"_2857":58776,"_25085":58756,"_17521":99090,"_5":17416,"_23752":99044,"_2384":99091},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_2857":58777,"_25085":58756,"_17521":99093,"_5":17416,"_23752":99044,"_2384":99094},[],"Certificado vencido, clave disponible",{"_2857":58778,"_25085":58756,"_17521":99096,"_5":17416,"_23752":99044,"_2384":99097},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_2857":58779,"_25085":58756,"_17521":99099,"_5":17416,"_23752":99044,"_2384":99100},[],"Renovación por webhook o `NO_AUTH`",{"_2857":58780,"_25085":58756,"_17521":99102,"_5":17416,"_23752":99044,"_2384":99103},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_2857":58781,"_25085":58756,"_17521":99105,"_5":17416,"_23752":99044,"_2384":99106},[],"Clave perdida o inaccesible",{"_2857":58782,"_25085":58756,"_17521":99108,"_5":17416,"_23752":99044,"_2384":99109},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_2857":58783,"_25085":58756,"_17521":99111,"_5":17416,"_23752":99044,"_2384":99112},[],"Identidad actual revocada",{"_2857":58784,"_25085":58756,"_17521":99114,"_5":17416,"_23752":99044,"_2384":99115},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_2857":58785,"_25085":58756,"_17521":99117,"_5":17416,"_23752":99044,"_2384":99118},[],"Dispositivo sin identidad",{"_2857":58786,"_25085":58756,"_17521":99120,"_5":17416,"_23752":99044,"_2384":99121},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_2857":58787,"_25085":58756,"_17521":99123,"_5":17416,"_23752":99044,"_2384":99124},[],"Dispositivo retirado",{"_2857":58788,"_25085":58756,"_17521":99126,"_5":17416,"_23752":99044,"_2384":99127},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_2857":58789,"_25085":58756,"_17521":99129,"_5":17416,"_23752":99044,"_2384":99130},[],"Timeout, HTTP 500 o fallo de instalación",{"_2857":58790,"_25085":58756,"_17521":99132,"_5":17416,"_23752":99044,"_2384":99133},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_2857":58791,"_25085":58756,"_17521":99135,"_5":17416,"_23752":99048,"_2384":99136},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_2857":58792,"_25085":58756,"_17521":99138,"_5":17416,"_23752":99048,"_2384":99139},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_2857":58793,"_25085":58793,"_5":12285,"_2384":99141,"_25421":99142,"_17521":99143,"_23752":58793},"Diagnóstico de enrolamiento",[40762,97039,43083,98014,98189],[],{"_2857":58794,"_25085":58793,"_17521":99145,"_5":17416,"_23752":58793,"_2384":99146},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_2857":58795,"_25085":58793,"_5":25418,"_17521":99148,"_23752":99149,"_2384":99150},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_2857":58796,"_25085":58793,"_5":25418,"_17521":99152,"_23752":99153,"_2384":99154},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_2857":58797,"_25085":58793,"_5":25418,"_17521":99156,"_23752":99157,"_2384":98713},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_2857":58798,"_25085":58793,"_5":25418,"_17521":99159,"_23752":99160,"_2384":99161},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_2857":58799,"_25085":58793,"_17521":99163,"_5":17416,"_23752":58793,"_2384":99164},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_2857":58800,"_25085":58793,"_17521":99166,"_5":17416,"_23752":99153,"_2384":99167},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_2857":58801,"_25085":58793,"_17521":99169,"_5":17416,"_23752":99153,"_2384":99170},[],"Síntoma o mensaje",{"_2857":58802,"_25085":58793,"_17521":99172,"_5":17416,"_23752":99153,"_2384":99173},[],"Qué revisar",{"_2857":58803,"_25085":58793,"_17521":99175,"_5":17416,"_23752":99153,"_2384":99176},[],"curl rechaza TLS, nombre o emisor",{"_2857":58804,"_25085":58793,"_17521":99178,"_5":17416,"_23752":99153,"_2384":99179},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_2857":58805,"_25085":58793,"_17521":99181,"_5":17416,"_23752":99153,"_2384":99182},[],"404 o APS ausente",{"_2857":58806,"_25085":58793,"_17521":99184,"_5":17416,"_23752":99153,"_2384":99185},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_2857":58807,"_25085":58793,"_17521":99187,"_5":17416,"_23752":99153,"_2384":99188},[],"400, error de CSR o formato",{"_2857":58808,"_25085":58793,"_17521":99190,"_5":17416,"_23752":99153,"_2384":99191},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_2857":58809,"_25085":58793,"_17521":99193,"_5":17416,"_23752":99153,"_2384":99194},[],"Credencial ausente o certificado no válido",{"_2857":58810,"_25085":58793,"_17521":99196,"_5":17416,"_23752":99153,"_2384":99197},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_2857":58811,"_25085":58793,"_17521":99199,"_5":17416,"_23752":99153,"_2384":99200},[],"Webhook deniega, expira o responde sin autorización",{"_2857":58812,"_25085":58793,"_17521":99202,"_5":17416,"_23752":99153,"_2384":99203},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_2857":58813,"_25085":58793,"_17521":99205,"_5":17416,"_23752":99153,"_2384":44319},[],{"_2857":58814,"_25085":58793,"_17521":99207,"_5":17416,"_23752":99153,"_2384":99208},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_2857":58815,"_25085":58793,"_17521":99210,"_5":17416,"_23752":99153,"_2384":44325},[],{"_2857":58816,"_25085":58793,"_17521":99212,"_5":17416,"_23752":99153,"_2384":99213},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_2857":58817,"_25085":58793,"_17521":99215,"_5":17416,"_23752":99153,"_2384":44331},[],{"_2857":58818,"_25085":58793,"_17521":99217,"_5":17416,"_23752":99153,"_2384":99218},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el PEM como `cert_content` y `key_content`; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la nota de migración en DMS.",{"_2857":58819,"_25085":58793,"_17521":99220,"_5":17416,"_23752":99153,"_2384":99221},[],"400 `struct validation error` al crear o actualizar un DMS",{"_2857":58820,"_25085":58793,"_17521":99223,"_5":17416,"_23752":99153,"_2384":99224},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_2857":58821,"_25085":58793,"_17521":99226,"_5":17416,"_23752":99153,"_2384":99227},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_2857":58822,"_25085":58793,"_17521":99229,"_5":17416,"_23752":99153,"_2384":99230},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_2857":58823,"_25085":58793,"_17521":99232,"_5":17416,"_23752":99153,"_2384":44349},[],{"_2857":58824,"_25085":58793,"_17521":99234,"_5":17416,"_23752":99153,"_2384":99235},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_2857":58825,"_25085":58793,"_17521":99237,"_5":17416,"_23752":99153,"_2384":44355},[],{"_2857":58826,"_25085":58793,"_17521":99239,"_5":17416,"_23752":99153,"_2384":99240},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_2857":58827,"_25085":58793,"_17521":99242,"_5":17416,"_23752":99153,"_2384":99243},[],"DMS propietario distinto",{"_2857":58828,"_25085":58793,"_17521":99245,"_5":17416,"_23752":99153,"_2384":99246},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_2857":58829,"_25085":58793,"_17521":99248,"_5":17416,"_23752":99153,"_2384":44367},[],{"_2857":58830,"_25085":58793,"_17521":99250,"_5":17416,"_23752":99153,"_2384":99251},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_2857":58831,"_25085":58793,"_17521":99253,"_5":17416,"_23752":99153,"_2384":44373},[],{"_2857":58832,"_25085":58793,"_17521":99255,"_5":17416,"_23752":99153,"_2384":99256},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_2857":58833,"_25085":58793,"_17521":99258,"_5":17416,"_23752":99153,"_2384":99259},[],"Certificado actual revocado",{"_2857":58834,"_25085":58793,"_17521":99261,"_5":17416,"_23752":99153,"_2384":99262},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_2857":58835,"_25085":58793,"_17521":99264,"_5":17416,"_23752":99153,"_2384":99265},[],"Error de CA, perfil o firma",{"_2857":58836,"_25085":58793,"_17521":99267,"_5":17416,"_23752":99153,"_2384":99268},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_2857":58837,"_25085":58793,"_17521":99270,"_5":17416,"_23752":99153,"_2384":99271},[],"HTTP 200 sin conexión del dispositivo",{"_2857":58838,"_25085":58793,"_17521":99273,"_5":17416,"_23752":99153,"_2384":99274},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_2857":58839,"_25085":58793,"_17521":99276,"_5":17416,"_23752":99153,"_2384":99277},[],"Timeout o error después de emitir",{"_2857":58840,"_25085":58793,"_17521":99279,"_5":17416,"_23752":99153,"_2384":99280},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_2857":58841,"_25085":58793,"_17521":99282,"_5":17416,"_23752":99157,"_2384":99283},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado tras una migración y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_2857":58842,"_25085":58793,"_17521":99285,"_5":17416,"_23752":99157,"_2384":99286},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_2857":58843,"_25085":58793,"_17521":99288,"_5":17416,"_23752":99160,"_2384":99289},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_2857":58844,"_25085":58793,"_17521":99291,"_5":17416,"_23752":99160,"_2384":99292},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_2857":58845,"_25085":58793,"_17521":99294,"_5":17416,"_23752":99160,"_2384":99295},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_2857":58846,"_25085":58793,"_17521":99297,"_5":17416,"_23752":99160,"_2384":99298},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_2857":58847,"_25085":58793,"_17521":99300,"_5":17416,"_23752":99160,"_2384":99301},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_2857":58848,"_25085":58793,"_17521":99303,"_5":17416,"_23752":99160,"_2384":99304},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_2857":58849,"_25085":58793,"_17521":99306,"_5":17416,"_23752":99160,"_2384":99307},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_2857":58850,"_25085":58850,"_5":12285,"_2384":99309,"_25421":99310,"_17521":99311,"_23752":58850},"Distribución y actualización de confianza",[40762,97039,43083,98014,98189],[],{"_2857":58851,"_25085":58850,"_17521":99313,"_5":17416,"_23752":58850,"_2384":99314},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_2857":58852,"_25085":58850,"_5":25418,"_17521":99316,"_23752":99317,"_2384":99318},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_2857":58853,"_25085":58850,"_5":25418,"_17521":99320,"_23752":99321,"_2384":99322},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_2857":58854,"_25085":58850,"_5":25418,"_17521":99324,"_23752":99325,"_2384":99326},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_2857":58855,"_25085":58850,"_5":25418,"_17521":99328,"_23752":99329,"_2384":99330},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_2857":58856,"_25085":58850,"_5":25418,"_17521":99332,"_23752":99333,"_2384":99334},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_2857":58857,"_25085":58850,"_17521":99336,"_5":17416,"_23752":58850,"_2384":99337},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_2857":58858,"_25085":58850,"_17521":99339,"_5":17416,"_23752":99317,"_2384":99340},[],"Relación",{"_2857":58859,"_25085":58850,"_17521":99342,"_5":17416,"_23752":99317,"_2384":99343},[],"Material que prepara el responsable",{"_2857":58860,"_25085":58850,"_17521":99345,"_5":17416,"_23752":99317,"_2384":99346},[],"Dispositivo → servidor EST",{"_2857":58861,"_25085":58850,"_17521":99348,"_5":17416,"_23752":99317,"_2384":99349},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_2857":58862,"_25085":58850,"_17521":99351,"_5":17416,"_23752":99317,"_2384":99352},[],"DMS → solicitante",{"_2857":58863,"_25085":58850,"_17521":99354,"_5":17416,"_23752":99317,"_2384":99355},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_2857":58864,"_25085":58850,"_17521":99357,"_5":17416,"_23752":99317,"_2384":99358},[],"Consumidor → dispositivo",{"_2857":58865,"_25085":58850,"_17521":99360,"_5":17416,"_23752":99317,"_2384":99361},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_2857":58866,"_25085":58850,"_17521":99363,"_5":17416,"_23752":99317,"_2384":99364},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_2857":58867,"_25085":58850,"_17521":99366,"_5":17416,"_23752":99321,"_2384":99367},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_2857":58868,"_25085":58850,"_17521":99369,"_5":17416,"_23752":99321,"_2384":99370},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_2857":58869,"_25085":58850,"_17521":99372,"_5":17416,"_23752":99325,"_2384":99373},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_2857":58870,"_25085":58850,"_17521":99375,"_5":17416,"_23752":99325,"_2384":99376},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_2857":58871,"_25085":58850,"_17521":99378,"_5":17416,"_23752":99325,"_2384":99379},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_2857":58872,"_25085":58850,"_17521":99381,"_5":17416,"_23752":99325,"_2384":99382},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_2857":58873,"_25085":58850,"_17521":99384,"_5":17416,"_23752":99325,"_2384":99385},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_2857":58874,"_25085":58850,"_17521":99387,"_5":17416,"_23752":99325,"_2384":99388},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_2857":58875,"_25085":58850,"_17521":99390,"_5":17416,"_23752":99329,"_2384":99391},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_2857":58876,"_25085":58850,"_17521":99393,"_5":17416,"_23752":99329,"_2384":99394},[],"En el DMS, separa las CAs distribuidas de `additional_validation_cas`, utilizadas para la credencial de reenrolamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_2857":58877,"_25085":58850,"_17521":99396,"_5":17416,"_23752":99329,"_2384":99397},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_2857":58878,"_25085":58850,"_17521":99399,"_5":17416,"_23752":99333,"_2384":99400},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_2857":58879,"_25085":58879,"_5":12285,"_2384":44522,"_25421":99402,"_17521":99404,"_23752":58879},[40762,97039,43083,98014,99403],"Integraciones",[],{"_2857":58880,"_25085":58879,"_17521":99406,"_5":17416,"_23752":58879,"_2384":99407},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_2857":58881,"_25085":58879,"_5":25418,"_17521":99409,"_23752":99410,"_2384":99411},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_2857":58882,"_25085":58879,"_5":25418,"_17521":99413,"_23752":99414,"_2384":99415},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_2857":58883,"_25085":58879,"_5":25418,"_17521":99417,"_23752":99418,"_2384":99419},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_2857":58884,"_25085":58879,"_5":25418,"_17521":99421,"_23752":99422,"_2384":99423},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_2857":58885,"_25085":58879,"_5":25418,"_17521":99425,"_23752":99426,"_2384":99427},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_2857":58886,"_25085":58879,"_5":25418,"_17521":99429,"_23752":99430,"_2384":99431},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_2857":58887,"_25085":58879,"_5":25418,"_17521":99433,"_23752":99434,"_2384":44556},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_2857":58888,"_25085":58879,"_5":25418,"_17521":99436,"_23752":99437,"_2384":44560},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_2857":58889,"_25085":58879,"_5":25418,"_17521":99439,"_23752":99440,"_2384":99441},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_2857":58890,"_25085":58879,"_5":25418,"_17521":99443,"_23752":99444,"_2384":99445},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_2857":58891,"_25085":58879,"_5":25418,"_17521":99447,"_23752":99448,"_2384":99449},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_2857":58892,"_25085":58879,"_5":25418,"_17521":99451,"_23752":99452,"_2384":99453},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_2857":58893,"_25085":58879,"_5":25418,"_17521":99455,"_23752":99456,"_2384":99457},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_2857":58894,"_25085":58879,"_5":25418,"_17521":99459,"_23752":99460,"_2384":99461},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_2857":58895,"_25085":58879,"_5":25418,"_17521":99463,"_23752":99464,"_2384":99465},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_2857":58896,"_25085":58879,"_5":25418,"_17521":99467,"_23752":99468,"_2384":99469},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_2857":58897,"_25085":58879,"_5":25418,"_17521":99471,"_23752":99472,"_2384":99473},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_2857":58898,"_25085":58879,"_5":25418,"_17521":99475,"_23752":99476,"_2384":99477},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_2857":58899,"_25085":58879,"_5":25418,"_17521":99479,"_23752":99480,"_2384":99481},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_2857":58900,"_25085":58879,"_5":25418,"_17521":99483,"_23752":99484,"_2384":99485},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_2857":58901,"_25085":58879,"_17521":99487,"_5":17416,"_23752":58879,"_2384":99488},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_2857":58902,"_25085":58879,"_17521":99490,"_5":17416,"_23752":58879,"_2384":99491},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_2857":58903,"_25085":58879,"_17521":99493,"_5":17416,"_23752":58879,"_2384":99494},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_2857":58904,"_25085":58879,"_17521":99496,"_5":17416,"_23752":99410,"_2384":99497},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_2857":58905,"_25085":58879,"_17521":99499,"_5":17416,"_23752":99410,"_2384":99500},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_2857":58906,"_25085":58879,"_17521":99502,"_5":17416,"_23752":99410,"_2384":99503},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_2857":58907,"_25085":58879,"_17521":99505,"_5":17416,"_23752":99410,"_2384":99506},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_2857":58908,"_25085":58879,"_17521":99508,"_5":17416,"_23752":99414,"_2384":99509},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_2857":58909,"_25085":58879,"_17521":99511,"_5":17416,"_23752":99418,"_2384":99512},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_2857":58910,"_25085":58879,"_17521":99514,"_5":17416,"_23752":99418,"_2384":99515},[],"Acción IAM",{"_2857":58911,"_25085":58879,"_17521":99517,"_5":17416,"_23752":99418,"_2384":96103},[],{"_2857":58912,"_25085":58879,"_17521":99519,"_5":17416,"_23752":99418,"_2384":44643},[],{"_2857":58913,"_25085":58879,"_17521":99521,"_5":17416,"_23752":99418,"_2384":99522},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_2857":58914,"_25085":58879,"_17521":99524,"_5":17416,"_23752":99418,"_2384":44649},[],{"_2857":58915,"_25085":58879,"_17521":99526,"_5":17416,"_23752":99418,"_2384":99527},[],"Registrar la CA en AWS IoT",{"_2857":58916,"_25085":58879,"_17521":99529,"_5":17416,"_23752":99418,"_2384":44655},[],{"_2857":58917,"_25085":58879,"_17521":99531,"_5":17416,"_23752":99418,"_2384":99532},[],"Consultar el estado del registro de la CA",{"_2857":58918,"_25085":58879,"_17521":99534,"_5":17416,"_23752":99418,"_2384":44661},[],{"_2857":58919,"_25085":58879,"_17521":99536,"_5":17416,"_23752":99418,"_2384":99537},[],"Crear o actualizar Things en IoT Core",{"_2857":58920,"_25085":58879,"_17521":99539,"_5":17416,"_23752":99418,"_2384":44667},[],{"_2857":58921,"_25085":58879,"_17521":99541,"_5":17416,"_23752":99418,"_2384":99542},[],"Aprovisionar Things mediante plantilla",{"_2857":58922,"_25085":58879,"_17521":99544,"_5":17416,"_23752":99418,"_2384":44673},[],{"_2857":58923,"_25085":58879,"_17521":99546,"_5":17416,"_23752":99418,"_2384":99547},[],"Registrar certificados de dispositivo",{"_2857":58924,"_25085":58879,"_17521":99549,"_5":17416,"_23752":99418,"_2384":44679},[],{"_2857":58925,"_25085":58879,"_17521":99551,"_5":17416,"_23752":99418,"_2384":99552},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_2857":58926,"_25085":58879,"_17521":99554,"_5":17416,"_23752":99418,"_2384":44685},[],{"_2857":58927,"_25085":58879,"_17521":99556,"_5":17416,"_23752":99418,"_2384":99557},[],"Crear y adjuntar políticas IoT",{"_2857":58928,"_25085":58879,"_17521":99559,"_5":17416,"_23752":99418,"_2384":44691},[],{"_2857":58929,"_25085":58879,"_17521":99561,"_5":17416,"_23752":99418,"_2384":99562},[],"Gestionar grupos de Things",{"_2857":58930,"_25085":58879,"_17521":99564,"_5":17416,"_23752":99418,"_2384":44697},[],{"_2857":58931,"_25085":58879,"_17521":99566,"_5":17416,"_23752":99418,"_2384":99567},[],"Crear plantillas JITP",{"_2857":58932,"_25085":58879,"_17521":99569,"_5":17416,"_23752":99418,"_2384":44703},[],{"_2857":58933,"_25085":58879,"_17521":99571,"_5":17416,"_23752":99418,"_2384":99572},[],"Leer y escribir el Device Shadow",{"_2857":58934,"_25085":58879,"_17521":99574,"_5":17416,"_23752":99418,"_2384":99575},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_2857":58935,"_25085":58879,"_17521":99577,"_5":17416,"_23752":99422,"_2384":99578},[],"Parámetro",{"_2857":58936,"_25085":58879,"_17521":99580,"_5":17416,"_23752":99422,"_2384":99581},[],"Tipo",{"_2857":58937,"_25085":58879,"_17521":99583,"_5":17416,"_23752":99422,"_2384":99584},[],"Requerido",{"_2857":58938,"_25085":58879,"_17521":99586,"_5":17416,"_23752":99422,"_2384":99587},[],"Descripción",{"_2857":58939,"_25085":58879,"_17521":99589,"_5":17416,"_23752":99422,"_2384":44724},[],{"_2857":58940,"_25085":58879,"_17521":99591,"_5":17416,"_23752":99422,"_2384":20906},[],{"_2857":58941,"_25085":58879,"_17521":99593,"_5":17416,"_23752":99422,"_2384":99594},[],"Sí",{"_2857":58942,"_25085":58879,"_17521":99596,"_5":17416,"_23752":99422,"_2384":99597},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_2857":58943,"_25085":58879,"_17521":99599,"_5":17416,"_23752":99422,"_2384":44735},[],{"_2857":58944,"_25085":58879,"_17521":99601,"_5":17416,"_23752":99422,"_2384":20906},[],{"_2857":58945,"_25085":58879,"_17521":99603,"_5":17416,"_23752":99422,"_2384":99594},[],{"_2857":58946,"_25085":58879,"_17521":99605,"_5":17416,"_23752":99422,"_2384":99606},[],"Región AWS donde opera el conector.",{"_2857":58947,"_25085":58879,"_17521":99608,"_5":17416,"_23752":99422,"_2384":44745},[],{"_2857":58948,"_25085":58879,"_17521":99610,"_5":17416,"_23752":99422,"_2384":20906},[],{"_2857":58949,"_25085":58879,"_17521":99612,"_5":17416,"_23752":99422,"_2384":99594},[],{"_2857":58950,"_25085":58879,"_17521":99614,"_5":17416,"_23752":99422,"_2384":99615},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_2857":58951,"_25085":58879,"_17521":99617,"_5":17416,"_23752":99422,"_2384":44755},[],{"_2857":58952,"_25085":58879,"_17521":99619,"_5":17416,"_23752":99422,"_2384":20906},[],{"_2857":58953,"_25085":58879,"_17521":99621,"_5":17416,"_23752":99422,"_2384":99622},[],"Solo con `auth_method=static`",{"_2857":58954,"_25085":58879,"_17521":99624,"_5":17416,"_23752":99422,"_2384":99625},[],"Clave de acceso AWS.",{"_2857":58955,"_25085":58879,"_17521":99627,"_5":17416,"_23752":99422,"_2384":44766},[],{"_2857":58956,"_25085":58879,"_17521":99629,"_5":17416,"_23752":99422,"_2384":20906},[],{"_2857":58957,"_25085":58879,"_17521":99631,"_5":17416,"_23752":99422,"_2384":99622},[],{"_2857":58958,"_25085":58879,"_17521":99633,"_5":17416,"_23752":99422,"_2384":99634},[],"Clave secreta AWS.",{"_2857":58959,"_25085":58879,"_17521":99636,"_5":17416,"_23752":99422,"_2384":44776},[],{"_2857":58960,"_25085":58879,"_17521":99638,"_5":17416,"_23752":99422,"_2384":20906},[],{"_2857":58961,"_25085":58879,"_17521":99640,"_5":17416,"_23752":99422,"_2384":44781},[],{"_2857":58962,"_25085":58879,"_17521":99642,"_5":17416,"_23752":99422,"_2384":99643},[],"Token de sesión (con `auth_method=static`).",{"_2857":58963,"_25085":58879,"_17521":99645,"_5":17416,"_23752":99422,"_2384":44787},[],{"_2857":58964,"_25085":58879,"_17521":99647,"_5":17416,"_23752":99422,"_2384":20906},[],{"_2857":58965,"_25085":58879,"_17521":99649,"_5":17416,"_23752":99422,"_2384":99650},[],"Solo con `auth_method=role`",{"_2857":58966,"_25085":58879,"_17521":99652,"_5":17416,"_23752":99422,"_2384":99653},[],"ARN del rol a asumir.",{"_2857":58967,"_25085":58879,"_17521":99655,"_5":17416,"_23752":99422,"_2384":44798},[],{"_2857":58968,"_25085":58879,"_17521":99657,"_5":17416,"_23752":99422,"_2384":20906},[],{"_2857":58969,"_25085":58879,"_17521":99659,"_5":17416,"_23752":99422,"_2384":44781},[],{"_2857":58970,"_25085":58879,"_17521":99661,"_5":17416,"_23752":99422,"_2384":99662},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_2857":58971,"_25085":58879,"_17521":99664,"_5":17416,"_23752":99422,"_2384":44808},[],{"_2857":58972,"_25085":58879,"_17521":99666,"_5":17416,"_23752":99422,"_2384":14710},[],{"_2857":58973,"_25085":58879,"_17521":99668,"_5":17416,"_23752":99422,"_2384":99594},[],{"_2857":58974,"_25085":58879,"_17521":99670,"_5":17416,"_23752":99422,"_2384":99671},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_2857":58975,"_25085":58879,"_17521":99673,"_5":17416,"_23752":99422,"_2384":44818},[],{"_2857":58976,"_25085":58879,"_17521":99675,"_5":17416,"_23752":99422,"_2384":20906},[],{"_2857":58977,"_25085":58879,"_17521":99677,"_5":17416,"_23752":99422,"_2384":99594},[],{"_2857":58978,"_25085":58879,"_17521":99679,"_5":17416,"_23752":99422,"_2384":99680},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_2857":58979,"_25085":58879,"_17521":99682,"_5":17416,"_23752":99422,"_2384":44828},[],{"_2857":58980,"_25085":58879,"_17521":99684,"_5":17416,"_23752":99422,"_2384":20906},[],{"_2857":58981,"_25085":58879,"_17521":99686,"_5":17416,"_23752":99422,"_2384":99594},[],{"_2857":58982,"_25085":58879,"_17521":99688,"_5":17416,"_23752":99422,"_2384":99689},[],"URL HTTP del Device Manager de Lamassu.",{"_2857":58983,"_25085":58879,"_17521":99691,"_5":17416,"_23752":99422,"_2384":44838},[],{"_2857":58984,"_25085":58879,"_17521":99693,"_5":17416,"_23752":99422,"_2384":20906},[],{"_2857":58985,"_25085":58879,"_17521":99695,"_5":17416,"_23752":99422,"_2384":99594},[],{"_2857":58986,"_25085":58879,"_17521":99697,"_5":17416,"_23752":99422,"_2384":99698},[],"URL HTTP del servicio de CA de Lamassu.",{"_2857":58987,"_25085":58879,"_17521":99700,"_5":17416,"_23752":99426,"_2384":99701},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_2857":58988,"_25085":58879,"_17521":99703,"_5":17416,"_23752":99430,"_2384":99704},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_2857":58989,"_25085":58879,"_17521":99706,"_5":17416,"_23752":99430,"_2384":99707},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_2857":58990,"_25085":58879,"_17521":99709,"_5":17416,"_23752":99434,"_2384":99710},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_2857":58991,"_25085":58879,"_17521":99712,"_5":17416,"_23752":99434,"_2384":99713},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_2857":58992,"_25085":58879,"_17521":99715,"_5":17416,"_23752":99434,"_2384":99716},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_2857":58993,"_25085":58879,"_17521":99718,"_5":17416,"_23752":99434,"_2384":99719},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_2857":58994,"_25085":58879,"_17521":99721,"_5":17416,"_23752":99434,"_2384":99722},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_2857":58995,"_25085":58879,"_17521":99724,"_5":17416,"_23752":99434,"_2384":99725},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_2857":58996,"_25085":58879,"_17521":99727,"_5":17416,"_23752":99437,"_2384":99728},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_2857":58997,"_25085":58879,"_17521":99730,"_5":17416,"_23752":99440,"_2384":99731},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_2857":58998,"_25085":58879,"_17521":99733,"_5":17416,"_23752":99440,"_2384":99734},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_2857":58999,"_25085":58879,"_17521":99736,"_5":17416,"_23752":99444,"_2384":99737},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_2857":59000,"_25085":58879,"_17521":99739,"_5":17416,"_23752":99448,"_2384":99740},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_2857":59001,"_25085":58879,"_17521":99742,"_5":17416,"_23752":99448,"_2384":99743},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_2857":59002,"_25085":58879,"_17521":99745,"_5":17416,"_23752":99448,"_2384":99746},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_2857":59003,"_25085":58879,"_17521":99748,"_5":17416,"_23752":99448,"_2384":99749},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_2857":59004,"_25085":58879,"_17521":99751,"_5":17416,"_23752":99448,"_2384":99752},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_2857":59005,"_25085":58879,"_17521":99754,"_5":17416,"_23752":99448,"_2384":99755},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_2857":59006,"_25085":58879,"_17521":99757,"_5":17416,"_23752":99452,"_2384":99758},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_2857":59007,"_25085":58879,"_17521":99760,"_5":17416,"_23752":99452,"_2384":99761},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_2857":59008,"_25085":58879,"_17521":99763,"_5":17416,"_23752":99452,"_2384":99764},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_2857":59009,"_25085":58879,"_17521":99766,"_5":17416,"_23752":99456,"_2384":99767},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_2857":59010,"_25085":58879,"_17521":99769,"_5":17416,"_23752":99456,"_2384":99770},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_2857":59011,"_25085":58879,"_17521":99772,"_5":17416,"_23752":99456,"_2384":99773},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_2857":59012,"_25085":58879,"_17521":99775,"_5":17416,"_23752":99460,"_2384":99776},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_2857":59013,"_25085":58879,"_17521":99778,"_5":17416,"_23752":99460,"_2384":99779},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_2857":59014,"_25085":58879,"_17521":99781,"_5":17416,"_23752":99460,"_2384":99782},[],"Para que el flujo JITP funcione correctamente:",{"_2857":59015,"_25085":58879,"_17521":99784,"_5":17416,"_23752":99460,"_2384":99785},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_2857":59016,"_25085":58879,"_17521":99787,"_5":17416,"_23752":99460,"_2384":99788},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_2857":59017,"_25085":58879,"_17521":99790,"_5":17416,"_23752":99460,"_2384":99791},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_2857":59018,"_25085":58879,"_17521":99793,"_5":17416,"_23752":99460,"_2384":99794},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_2857":59019,"_25085":58879,"_17521":99796,"_5":17416,"_23752":99464,"_2384":99797},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_2857":59020,"_25085":58879,"_17521":99799,"_5":17416,"_23752":99464,"_2384":99800},[],"Estado en Lamassu",{"_2857":59021,"_25085":58879,"_17521":99802,"_5":17416,"_23752":99464,"_2384":99803},[],"Razón de revocación",{"_2857":59022,"_25085":58879,"_17521":99805,"_5":17416,"_23752":99464,"_2384":99806},[],"Estado en AWS IoT Core",{"_2857":59023,"_25085":58879,"_17521":99808,"_5":17416,"_23752":99464,"_2384":44959},[],{"_2857":59024,"_25085":58879,"_17521":99810,"_5":17416,"_23752":99464,"_2384":99811},[],"Ninguna",{"_2857":59025,"_25085":58879,"_17521":99813,"_5":17416,"_23752":99464,"_2384":44965},[],{"_2857":59026,"_25085":58879,"_17521":99815,"_5":17416,"_23752":99464,"_2384":44968},[],{"_2857":59027,"_25085":58879,"_17521":99817,"_5":17416,"_23752":99464,"_2384":44971},[],{"_2857":59028,"_25085":58879,"_17521":99819,"_5":17416,"_23752":99464,"_2384":44974},[],{"_2857":59029,"_25085":58879,"_17521":99821,"_5":17416,"_23752":99464,"_2384":44968},[],{"_2857":59030,"_25085":58879,"_17521":99823,"_5":17416,"_23752":99464,"_2384":99824},[],"Cualquier otra razón",{"_2857":59031,"_25085":58879,"_17521":99826,"_5":17416,"_23752":99464,"_2384":44982},[],{"_2857":59032,"_25085":58879,"_17521":99828,"_5":17416,"_23752":99464,"_2384":99829},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_2857":59033,"_25085":58879,"_17521":99831,"_5":17416,"_23752":99468,"_2384":99832},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_2857":59034,"_25085":58879,"_17521":99834,"_5":17416,"_23752":99468,"_2384":99835},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_2857":59035,"_25085":58879,"_17521":99837,"_5":17416,"_23752":99468,"_2384":99838},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_2857":59036,"_25085":58879,"_17521":99840,"_5":17416,"_23752":99472,"_2384":99841},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_2857":59037,"_25085":58879,"_17521":99843,"_5":17416,"_23752":99472,"_2384":99844},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_2857":59038,"_25085":58879,"_17521":99846,"_5":17416,"_23752":99476,"_2384":99847},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_2857":59039,"_25085":58879,"_17521":99849,"_5":17416,"_23752":99476,"_2384":99850},[],"Existen dos tipos de acciones:",{"_2857":59040,"_25085":58879,"_17521":99852,"_5":17416,"_23752":99476,"_2384":99853},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_2857":59041,"_25085":58879,"_17521":99855,"_5":17416,"_23752":99476,"_2384":99856},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_2857":59042,"_25085":58879,"_17521":99858,"_5":17416,"_23752":99476,"_2384":99859},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_2857":59043,"_25085":58879,"_17521":99861,"_5":17416,"_23752":99480,"_2384":99862},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_2857":59044,"_25085":58879,"_17521":99864,"_5":17416,"_23752":99480,"_2384":99865},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_2857":59045,"_25085":58879,"_17521":99867,"_5":17416,"_23752":99480,"_2384":99868},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_2857":59046,"_25085":58879,"_17521":99870,"_5":17416,"_23752":99484,"_2384":99871},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_2857":59047,"_25085":58879,"_17521":99873,"_5":17416,"_23752":99484,"_2384":99874},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_2857":59048,"_25085":58879,"_17521":99876,"_5":17416,"_23752":99484,"_2384":99877},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_2857":59049,"_25085":58879,"_17521":99879,"_5":17416,"_23752":99484,"_2384":99880},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_2857":59050,"_25085":58879,"_17521":99882,"_5":17416,"_23752":99484,"_2384":99883},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_2857":59051,"_25085":58879,"_17521":99885,"_5":17416,"_23752":99484,"_2384":99886},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_2857":59052,"_25085":58879,"_17521":99888,"_5":17416,"_23752":99484,"_2384":99889},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_2857":59053,"_25085":58879,"_17521":99891,"_5":17416,"_23752":99484,"_2384":99892},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_2857":59054,"_25085":58879,"_17521":99894,"_5":17416,"_23752":99484,"_2384":99895},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_2857":59055,"_25085":58879,"_17521":99897,"_5":17416,"_23752":99484,"_2384":99898},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_2857":59056,"_25085":58879,"_17521":99900,"_5":17416,"_23752":99484,"_2384":99901},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_2857":59057,"_25085":58879,"_17521":99903,"_5":17416,"_23752":99484,"_2384":99904},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_2857":59058,"_25085":58879,"_17521":99906,"_5":17416,"_23752":99484,"_2384":99907},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_2857":59059,"_25085":58879,"_17521":99909,"_5":17416,"_23752":99484,"_2384":99910},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_2857":59060,"_25085":58879,"_17521":99912,"_5":17416,"_23752":99484,"_2384":99913},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_2857":59061,"_25085":58879,"_17521":99915,"_5":17416,"_23752":99484,"_2384":99916},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_2857":59062,"_25085":58879,"_17521":99918,"_5":17416,"_23752":99484,"_2384":99919},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_2857":59063,"_25085":58879,"_17521":99921,"_5":17416,"_23752":99484,"_2384":99922},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_2857":59064,"_25085":58879,"_17521":99924,"_5":17416,"_23752":99484,"_2384":99925},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2857":59065,"_25085":58879,"_17521":99927,"_5":17416,"_23752":99484,"_2384":99928},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2857":59066,"_25085":58879,"_17521":99930,"_5":17416,"_23752":99484,"_2384":99931},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_2857":59067,"_25085":59067,"_5":12285,"_2384":43083,"_25421":99933,"_17521":99934,"_23752":59067},[40762,97039,43083],[],{"_2857":59068,"_25085":59067,"_17521":99936,"_5":17416,"_23752":59067,"_2384":99937},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_2857":59069,"_25085":59067,"_5":25418,"_17521":99939,"_23752":99940,"_2384":99941},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_2857":59070,"_25085":59067,"_5":25418,"_17521":99943,"_23752":99944,"_2384":98014},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_2857":59071,"_25085":59067,"_5":25418,"_17521":99946,"_23752":99947,"_2384":98189},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_2857":59072,"_25085":59067,"_5":25418,"_17521":99949,"_23752":99950,"_2384":99403},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/overview#integraciones",{"_2857":59073,"_25085":59067,"_5":25418,"_17521":99952,"_23752":99953,"_2384":99954},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_2857":59074,"_25085":59067,"_17521":99956,"_5":17416,"_23752":59067,"_2384":99957},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_2857":59075,"_25085":59067,"_17521":99959,"_5":17416,"_23752":99940,"_2384":99960},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_2857":59076,"_25085":59067,"_17521":99962,"_5":17416,"_23752":99940,"_2384":99963},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_2857":59077,"_25085":59067,"_17521":99965,"_5":17416,"_23752":99944,"_2384":99966},[],"Recurso",{"_2857":59078,"_25085":59067,"_17521":99968,"_5":17416,"_23752":99944,"_2384":99969},[],"Qué representa",{"_2857":59079,"_25085":59067,"_17521":99971,"_5":17416,"_23752":99944,"_2384":99972},[],"**Dispositivo**",{"_2857":59080,"_25085":59067,"_17521":99974,"_5":17416,"_23752":99944,"_2384":99975},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_2857":59081,"_25085":59067,"_17521":99977,"_5":17416,"_23752":99944,"_2384":99978},[],"**Identidad**",{"_2857":59082,"_25085":59067,"_17521":99980,"_5":17416,"_23752":99944,"_2384":99981},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_2857":59083,"_25085":59067,"_17521":99983,"_5":17416,"_23752":99944,"_2384":45140},[],{"_2857":59084,"_25085":59067,"_17521":99985,"_5":17416,"_23752":99944,"_2384":99986},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_2857":59085,"_25085":59067,"_17521":99988,"_5":17416,"_23752":99944,"_2384":99989},[],"**Flota**",{"_2857":59086,"_25085":59067,"_17521":99991,"_5":17416,"_23752":99944,"_2384":99992},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_2857":59087,"_25085":59067,"_17521":99994,"_5":17416,"_23752":99944,"_2384":99995},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_2857":59088,"_25085":59067,"_17521":99997,"_5":17416,"_23752":99944,"_2384":99998},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_2857":59089,"_25085":59067,"_17521":100000,"_5":17416,"_23752":99947,"_2384":100001},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_2857":59090,"_25085":59067,"_17521":100003,"_5":17416,"_23752":99947,"_2384":100004},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_2857":59091,"_25085":59067,"_17521":100006,"_5":17416,"_23752":99947,"_2384":100007},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_2857":59092,"_25085":59067,"_17521":100009,"_5":17416,"_23752":99947,"_2384":100010},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_2857":59093,"_25085":59067,"_17521":100012,"_5":17416,"_23752":99947,"_2384":100013},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_2857":59094,"_25085":59067,"_17521":100015,"_5":17416,"_23752":99947,"_2384":100016},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_2857":59095,"_25085":59067,"_17521":100018,"_5":17416,"_23752":99947,"_2384":100019},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2857":59096,"_25085":59067,"_17521":100021,"_5":17416,"_23752":99947,"_2384":100022},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2857":59097,"_25085":59067,"_17521":100024,"_5":17416,"_23752":99950,"_2384":100025},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_2857":59098,"_25085":59067,"_17521":100027,"_5":17416,"_23752":99950,"_2384":100028},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_2857":59099,"_25085":59067,"_17521":100030,"_5":17416,"_23752":99953,"_2384":100031},[],"Participante",{"_2857":59100,"_25085":59067,"_17521":100033,"_5":17416,"_23752":99953,"_2384":100034},[],"Responsabilidad",{"_2857":59101,"_25085":59067,"_17521":100036,"_5":17416,"_23752":99953,"_2384":100037},[],"Administrador PKI",{"_2857":59102,"_25085":59067,"_17521":100039,"_5":17416,"_23752":99953,"_2384":100040},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_2857":59103,"_25085":59067,"_17521":100042,"_5":17416,"_23752":99953,"_2384":100043},[],"Administrador del aprovisionamiento",{"_2857":59104,"_25085":59067,"_17521":100045,"_5":17416,"_23752":99953,"_2384":100046},[],"DMS, admisión, autenticación por operación e inventario.",{"_2857":59105,"_25085":59067,"_17521":100048,"_5":17416,"_23752":99953,"_2384":100049},[],"Integrador del dispositivo",{"_2857":59106,"_25085":59067,"_17521":100051,"_5":17416,"_23752":99953,"_2384":100052},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_2857":59107,"_25085":59067,"_17521":100054,"_5":17416,"_23752":99953,"_2384":100055},[],"Integrador del consumidor",{"_2857":59108,"_25085":59067,"_17521":100057,"_5":17416,"_23752":99953,"_2384":100058},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_2857":59109,"_25085":59067,"_17521":100060,"_5":17416,"_23752":99953,"_2384":100061},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_2857":59110,"_25085":59110,"_5":12285,"_2384":100063,"_25421":100064,"_17521":100066,"_23752":59110},"Enrola y conecta tu primer dispositivo",[40762,97039,43083,100065],"Primeros pasos",[],{"_2857":59111,"_25085":59110,"_17521":100068,"_5":17416,"_23752":59110,"_2384":100069},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_2857":59112,"_25085":59110,"_5":25418,"_17521":100071,"_23752":100072,"_2384":95740},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_2857":59113,"_25085":59110,"_5":25418,"_17521":100074,"_23752":100075,"_2384":100076},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_2857":59114,"_25085":59110,"_5":25418,"_17521":100078,"_23752":100079,"_2384":100080},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_2857":59115,"_25085":59110,"_5":25418,"_17521":100082,"_23752":100083,"_2384":100084},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_2857":59116,"_25085":59110,"_5":25418,"_17521":100086,"_23752":100087,"_2384":100088},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_2857":59117,"_25085":59110,"_5":25418,"_17521":100090,"_23752":100091,"_2384":100092},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_2857":59118,"_25085":59110,"_5":25418,"_17521":100094,"_23752":100095,"_2384":100096},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_2857":59119,"_25085":59110,"_5":25418,"_17521":100098,"_23752":100099,"_2384":100100},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_2857":59120,"_25085":59110,"_17521":100102,"_5":17416,"_23752":59110,"_2384":100103},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_2857":59121,"_25085":59110,"_17521":100105,"_5":17416,"_23752":100072,"_2384":100106},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_2857":59122,"_25085":59110,"_17521":100108,"_5":17416,"_23752":100072,"_2384":100109},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_2857":59123,"_25085":59110,"_17521":100111,"_5":17416,"_23752":100072,"_2384":100112},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_2857":59124,"_25085":59110,"_17521":100114,"_5":17416,"_23752":100072,"_2384":100115},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_2857":59125,"_25085":59110,"_17521":100117,"_5":17416,"_23752":100072,"_2384":100118},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_2857":59126,"_25085":59110,"_17521":100120,"_5":17416,"_23752":100075,"_2384":100121},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_2857":59127,"_25085":59110,"_17521":100123,"_5":17416,"_23752":100075,"_2384":100124},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_2857":59128,"_25085":59110,"_17521":100126,"_5":17416,"_23752":100079,"_2384":100127},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_2857":59129,"_25085":59110,"_17521":100129,"_5":17416,"_23752":100079,"_2384":100130},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_2857":59130,"_25085":59110,"_17521":100132,"_5":17416,"_23752":100079,"_2384":100133},[],"Ajuste",{"_2857":59131,"_25085":59110,"_17521":100135,"_5":17416,"_23752":100079,"_2384":100136},[],"Valor de evaluación",{"_2857":59132,"_25085":59110,"_17521":100138,"_5":17416,"_23752":100079,"_2384":45296},[],{"_2857":59133,"_25085":59110,"_17521":100140,"_5":17416,"_23752":100079,"_2384":100141},[],"Raíz emisora de `device-root.pem`.",{"_2857":59134,"_25085":59110,"_17521":100143,"_5":17416,"_23752":100079,"_2384":98317},[],{"_2857":59135,"_25085":59110,"_17521":100145,"_5":17416,"_23752":100079,"_2384":100146},[],"Perfil final de 1 hora que acabas de preparar.",{"_2857":59136,"_25085":59110,"_17521":100148,"_5":17416,"_23752":100079,"_2384":45307},[],{"_2857":59137,"_25085":59110,"_17521":100150,"_5":17416,"_23752":100079,"_2384":45310},[],{"_2857":59138,"_25085":59110,"_17521":100152,"_5":17416,"_23752":100079,"_2384":45313},[],{"_2857":59139,"_25085":59110,"_17521":100154,"_5":17416,"_23752":100079,"_2384":100155},[],"Habilitado.",{"_2857":59140,"_25085":59110,"_17521":100157,"_5":17416,"_23752":100079,"_2384":45319},[],{"_2857":59141,"_25085":59110,"_17521":100159,"_5":17416,"_23752":100079,"_2384":100160},[],"Deshabilitado; el ID debe ser nuevo.",{"_2857":59142,"_25085":59110,"_17521":100162,"_5":17416,"_23752":100079,"_2384":100163},[],"Autenticación inicial",{"_2857":59143,"_25085":59110,"_17521":100165,"_5":17416,"_23752":100079,"_2384":100166},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_2857":59144,"_25085":59110,"_17521":100168,"_5":17416,"_23752":100079,"_2384":100169},[],"Autenticación de renovación",{"_2857":59145,"_25085":59110,"_17521":100171,"_5":17416,"_23752":100079,"_2384":100172},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_2857":59146,"_25085":59110,"_17521":100174,"_5":17416,"_23752":100079,"_2384":45337},[],{"_2857":59147,"_25085":59110,"_17521":100176,"_5":17416,"_23752":100079,"_2384":100177},[],"Lista vacía para esta emisión directa / deshabilitado.",{"_2857":59148,"_25085":59110,"_17521":100179,"_5":17416,"_23752":100079,"_2384":45343},[],{"_2857":59149,"_25085":59110,"_17521":100181,"_5":17416,"_23752":100079,"_2384":100182},[],"1 hora.",{"_2857":59150,"_25085":59110,"_17521":100184,"_5":17416,"_23752":100079,"_2384":45349},[],{"_2857":59151,"_25085":59110,"_17521":100186,"_5":17416,"_23752":100079,"_2384":100187},[],"30 minutos / 10 minutos.",{"_2857":59152,"_25085":59110,"_17521":100189,"_5":17416,"_23752":100079,"_2384":45355},[],{"_2857":59153,"_25085":59110,"_17521":100191,"_5":17416,"_23752":100079,"_2384":100192},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_2857":59154,"_25085":59110,"_17521":100194,"_5":17416,"_23752":100079,"_2384":43402},[],{"_2857":59155,"_25085":59110,"_17521":100196,"_5":17416,"_23752":100079,"_2384":100197},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_2857":59156,"_25085":59110,"_17521":100199,"_5":17416,"_23752":100079,"_2384":45366},[],{"_2857":59157,"_25085":59110,"_17521":100201,"_5":17416,"_23752":100079,"_2384":100202},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_2857":59158,"_25085":59110,"_17521":100204,"_5":17416,"_23752":100079,"_2384":100205},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_2857":59159,"_25085":59110,"_17521":100207,"_5":17416,"_23752":100083,"_2384":100208},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_2857":59160,"_25085":59110,"_17521":100210,"_5":17416,"_23752":100083,"_2384":100211},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_2857":59161,"_25085":59110,"_17521":100213,"_5":17416,"_23752":100087,"_2384":100214},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_2857":59162,"_25085":59110,"_17521":100216,"_5":17416,"_23752":100087,"_2384":100217},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_2857":59163,"_25085":59110,"_17521":100219,"_5":17416,"_23752":100087,"_2384":100220},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_2857":59164,"_25085":59110,"_17521":100222,"_5":17416,"_23752":100091,"_2384":100223},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_2857":59165,"_25085":59110,"_17521":100225,"_5":17416,"_23752":100091,"_2384":100226},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_2857":59166,"_25085":59110,"_17521":100228,"_5":17416,"_23752":100095,"_2384":100229},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_2857":59167,"_25085":59110,"_17521":100231,"_5":17416,"_23752":100095,"_2384":100232},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_2857":59168,"_25085":59110,"_17521":100234,"_5":17416,"_23752":100095,"_2384":100235},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_2857":59169,"_25085":59110,"_17521":100237,"_5":17416,"_23752":100095,"_2384":100238},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_2857":59170,"_25085":59110,"_17521":100240,"_5":17416,"_23752":100095,"_2384":100241},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_2857":59171,"_25085":59110,"_17521":100243,"_5":17416,"_23752":100099,"_2384":100244},[],"Comprobación",{"_2857":59172,"_25085":59110,"_17521":100246,"_5":17416,"_23752":100099,"_2384":100247},[],"Resultado esperado",{"_2857":59173,"_25085":59110,"_17521":100249,"_5":17416,"_23752":100099,"_2384":100250},[],"Registro",{"_2857":59174,"_25085":59110,"_17521":100252,"_5":17416,"_23752":100099,"_2384":100253},[],"ID creado automáticamente y DMS correcto.",{"_2857":59175,"_25085":59110,"_17521":100255,"_5":17416,"_23752":100099,"_2384":100256},[],"Certificado",{"_2857":59176,"_25085":59110,"_17521":100258,"_5":17416,"_23752":100099,"_2384":100259},[],"CN, perfil, serie y clave verificados.",{"_2857":59177,"_25085":59110,"_17521":100261,"_5":17416,"_23752":100099,"_2384":100262},[],"Inventario",{"_2857":59178,"_25085":59110,"_17521":100264,"_5":17416,"_23752":100099,"_2384":100265},[],"Serie recibida visible como identidad actual y en el historial.",{"_2857":59179,"_25085":59110,"_17521":100267,"_5":17416,"_23752":100099,"_2384":100268},[],"Consumidor",{"_2857":59180,"_25085":59110,"_17521":100270,"_5":17416,"_23752":100099,"_2384":100271},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_2857":59181,"_25085":59110,"_17521":100273,"_5":17416,"_23752":100099,"_2384":100274},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_2857":59182,"_25085":59110,"_17521":100276,"_5":17416,"_23752":100099,"_2384":100277},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_2857":59183,"_25085":59183,"_5":12285,"_2384":98031,"_25421":100279,"_17521":100280,"_23752":59183},[40762,97039,43083,100065],[],{"_2857":59184,"_25085":59183,"_17521":100282,"_5":17416,"_23752":59183,"_2384":100283},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_2857":59185,"_25085":59183,"_5":25418,"_17521":100285,"_23752":100286,"_2384":95740},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_2857":59186,"_25085":59183,"_5":25418,"_17521":100288,"_23752":100289,"_2384":100290},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_2857":59187,"_25085":59183,"_5":25418,"_17521":100292,"_23752":100293,"_2384":100294},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_2857":59188,"_25085":59183,"_5":25418,"_17521":100296,"_23752":100297,"_2384":100298},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_2857":59189,"_25085":59183,"_5":25418,"_17521":100300,"_23752":100301,"_2384":100302},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_2857":59190,"_25085":59183,"_5":25418,"_17521":100304,"_23752":100305,"_2384":100306},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_2857":59191,"_25085":59183,"_5":25418,"_17521":100308,"_23752":100309,"_2384":100247},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_2857":59192,"_25085":59183,"_5":25418,"_17521":100311,"_23752":100312,"_2384":100313},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_2857":59193,"_25085":59183,"_5":25418,"_17521":100315,"_23752":100316,"_2384":100317},[],"/docs/pr-preview/pr-46/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_2857":59194,"_25085":59183,"_17521":100319,"_5":17416,"_23752":59183,"_2384":100320},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_2857":59195,"_25085":59183,"_17521":100322,"_5":17416,"_23752":59183,"_2384":100323},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_2857":59196,"_25085":59183,"_17521":100325,"_5":17416,"_23752":100286,"_2384":100326},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_2857":59197,"_25085":59183,"_17521":100328,"_5":17416,"_23752":100286,"_2384":100329},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_2857":59198,"_25085":59183,"_17521":100331,"_5":17416,"_23752":100286,"_2384":100332},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_2857":59199,"_25085":59183,"_17521":100334,"_5":17416,"_23752":100286,"_2384":100335},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_2857":59200,"_25085":59183,"_17521":100337,"_5":17416,"_23752":100289,"_2384":100338},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_2857":59201,"_25085":59183,"_17521":100340,"_5":17416,"_23752":100289,"_2384":100341},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_2857":59202,"_25085":59183,"_17521":100343,"_5":17416,"_23752":100289,"_2384":100344},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_2857":59203,"_25085":59183,"_17521":100346,"_5":17416,"_23752":100289,"_2384":100347},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_2857":59204,"_25085":59183,"_17521":100349,"_5":17416,"_23752":100289,"_2384":100350},[],"Configura **Authentication Mode** como `CLIENT_CERTIFICATE` y añade en **Validation CAs** la CA cuyos certificados iniciales aceptarás. Para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deshabilitada la generación de claves en servidor si no la vas a utilizar.",{"_2857":59205,"_25085":59183,"_17521":100352,"_5":17416,"_23752":100289,"_2384":100353},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_2857":59206,"_25085":59183,"_17521":100355,"_5":17416,"_23752":100289,"_2384":100356},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_2857":59207,"_25085":59183,"_17521":100358,"_5":17416,"_23752":100289,"_2384":100359},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_2857":59208,"_25085":59183,"_17521":100361,"_5":17416,"_23752":100293,"_2384":100362},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_2857":59209,"_25085":59183,"_17521":100364,"_5":17416,"_23752":100293,"_2384":45532},[],{"_2857":59210,"_25085":59183,"_17521":100366,"_5":17416,"_23752":100293,"_2384":100367},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_2857":59211,"_25085":59183,"_17521":100369,"_5":17416,"_23752":100293,"_2384":100370},[],"**Icon** y **Tags**: clasificación opcional.",{"_2857":59212,"_25085":59183,"_17521":100372,"_5":17416,"_23752":100293,"_2384":100373},[],"Confirma el registro.",{"_2857":59213,"_25085":59183,"_17521":100375,"_5":17416,"_23752":100297,"_2384":100376},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_2857":59214,"_25085":59183,"_17521":100378,"_5":17416,"_23752":100297,"_2384":100379},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_2857":59215,"_25085":59183,"_17521":100381,"_5":17416,"_23752":100301,"_2384":100382},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_2857":59216,"_25085":59183,"_17521":100384,"_5":17416,"_23752":100301,"_2384":100385},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_2857":59217,"_25085":59183,"_17521":100387,"_5":17416,"_23752":100305,"_2384":100388},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_2857":59218,"_25085":59183,"_17521":100390,"_5":17416,"_23752":100305,"_2384":100391},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_2857":59219,"_25085":59183,"_17521":100393,"_5":17416,"_23752":100309,"_2384":100244},[],{"_2857":59220,"_25085":59183,"_17521":100395,"_5":17416,"_23752":100309,"_2384":100396},[],"Resultado",{"_2857":59221,"_25085":59183,"_17521":100398,"_5":17416,"_23752":100309,"_2384":100399},[],"Dispositivo",{"_2857":59222,"_25085":59183,"_17521":100401,"_5":17416,"_23752":100309,"_2384":100402},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_2857":59223,"_25085":59183,"_17521":100404,"_5":17416,"_23752":100309,"_2384":100405},[],"Identidad actual",{"_2857":59224,"_25085":59183,"_17521":100407,"_5":17416,"_23752":100309,"_2384":100408},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_2857":59225,"_25085":59183,"_17521":100410,"_5":17416,"_23752":100309,"_2384":100411},[],"Historial",{"_2857":59226,"_25085":59183,"_17521":100413,"_5":17416,"_23752":100309,"_2384":100414},[],"La emisión asociada aparece con su número de serie y fechas.",{"_2857":59227,"_25085":59183,"_17521":100416,"_5":17416,"_23752":100309,"_2384":100417},[],"Clave y certificado",{"_2857":59228,"_25085":59183,"_17521":100419,"_5":17416,"_23752":100309,"_2384":100420},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_2857":59229,"_25085":59183,"_17521":100422,"_5":17416,"_23752":100312,"_2384":100423},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_2857":59230,"_25085":59183,"_17521":100425,"_5":17416,"_23752":100312,"_2384":100426},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_2857":59231,"_25085":59183,"_17521":100428,"_5":17416,"_23752":100312,"_2384":100429},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_2857":59232,"_25085":59183,"_17521":100431,"_5":17416,"_23752":100312,"_2384":100432},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_2857":59233,"_25085":59183,"_17521":100434,"_5":17416,"_23752":100316,"_2384":100435},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_2857":59234,"_25085":59183,"_17521":100437,"_5":17416,"_23752":100316,"_2384":100438},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_2857":59235,"_25085":59183,"_17521":100440,"_5":17416,"_23752":100316,"_2384":100441},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_2857":59236,"_25085":59236,"_5":12285,"_2384":100443,"_25421":100444,"_17521":100445,"_23752":59236},"Plataforma Lamassu IoT",[40762,97039],[],{"_2857":59237,"_25085":59236,"_17521":100447,"_5":17416,"_23752":59236,"_2384":100448},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_2857":59238,"_25085":59236,"_5":25418,"_17521":100450,"_23752":100451,"_2384":99941},[],"/docs/pr-preview/pr-46/es/platform/overview#empieza-aquí",{"_2857":59239,"_25085":59236,"_5":25418,"_17521":100453,"_23752":100454,"_2384":100455},[],"/docs/pr-preview/pr-46/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_2857":59240,"_25085":59236,"_5":25418,"_17521":100457,"_23752":100458,"_2384":100459},[],"/docs/pr-preview/pr-46/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_2857":59241,"_25085":59236,"_5":25418,"_17521":100461,"_23752":100462,"_2384":100463},[],"/docs/pr-preview/pr-46/es/platform/overview#capacidades-principales","Capacidades principales",{"_2857":59242,"_25085":59236,"_5":25418,"_17521":100465,"_23752":100466,"_2384":100467},[],"/docs/pr-preview/pr-46/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_2857":59243,"_25085":59236,"_5":25418,"_17521":100469,"_23752":100470,"_2384":100471},[],"/docs/pr-preview/pr-46/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_2857":59244,"_25085":59236,"_5":25418,"_17521":100473,"_23752":100474,"_2384":100475},[],"/docs/pr-preview/pr-46/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_2857":59245,"_25085":59236,"_5":25418,"_17521":100477,"_23752":100478,"_2384":100479},[],"/docs/pr-preview/pr-46/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_2857":59246,"_25085":59236,"_5":25418,"_17521":100481,"_23752":100482,"_2384":100483},[],"/docs/pr-preview/pr-46/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_2857":59247,"_25085":59236,"_5":25418,"_17521":100485,"_23752":100486,"_2384":100487},[],"/docs/pr-preview/pr-46/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_2857":59248,"_25085":59236,"_5":25418,"_17521":100489,"_23752":100490,"_2384":100491},[],"/docs/pr-preview/pr-46/es/platform/overview#referencia-operativa","Referencia operativa",{"_2857":59249,"_25085":59236,"_17521":100493,"_5":17416,"_23752":59236,"_2384":100494},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_2857":59250,"_25085":59236,"_17521":100496,"_5":17416,"_23752":100451,"_2384":100497},[],"Elige el resultado que necesitas obtener:",{"_2857":59251,"_25085":59236,"_17521":100499,"_5":17416,"_23752":100451,"_2384":100500},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2857":59252,"_25085":59236,"_17521":100502,"_5":17416,"_23752":100451,"_2384":100503},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2857":59253,"_25085":59236,"_17521":100505,"_5":17416,"_23752":100451,"_2384":100506},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_2857":59254,"_25085":59236,"_17521":100508,"_5":17416,"_23752":100454,"_2384":100509},[],"Bloque",{"_2857":59255,"_25085":59236,"_17521":100511,"_5":17416,"_23752":100454,"_2384":100512},[],"Qué gestionas",{"_2857":59256,"_25085":59236,"_17521":100514,"_5":17416,"_23752":100454,"_2384":100515},[],"Punto de entrada",{"_2857":59257,"_25085":59236,"_17521":100517,"_5":17416,"_23752":100454,"_2384":45686},[],{"_2857":59258,"_25085":59236,"_17521":100519,"_5":17416,"_23752":100454,"_2384":100520},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_2857":59259,"_25085":59236,"_17521":100522,"_5":17416,"_23752":100454,"_2384":100523},[],"Visión general de PKI",{"_2857":59260,"_25085":59236,"_17521":100525,"_5":17416,"_23752":100454,"_2384":45695},[],{"_2857":59261,"_25085":59236,"_17521":100527,"_5":17416,"_23752":100454,"_2384":100528},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_2857":59262,"_25085":59236,"_17521":100530,"_5":17416,"_23752":100454,"_2384":100531},[],"Visión general de IoT Fleets",{"_2857":59263,"_25085":59236,"_17521":100533,"_5":17416,"_23752":100454,"_2384":100534},[],"**Administración**",{"_2857":59264,"_25085":59236,"_17521":100536,"_5":17416,"_23752":100454,"_2384":100537},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_2857":59265,"_25085":59236,"_17521":100539,"_5":17416,"_23752":100454,"_2384":97037},[],{"_2857":59266,"_25085":59236,"_17521":100541,"_5":17416,"_23752":100454,"_2384":100542},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_2857":59267,"_25085":59236,"_17521":100544,"_5":17416,"_23752":100458,"_2384":100545},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_2857":59268,"_25085":59236,"_17521":100547,"_5":17416,"_23752":100458,"_2384":100548},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_2857":59269,"_25085":59236,"_17521":100550,"_5":17416,"_23752":100458,"_2384":100551},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_2857":59270,"_25085":59236,"_17521":100553,"_5":17416,"_23752":100458,"_2384":100554},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_2857":59271,"_25085":59236,"_17521":100556,"_5":17416,"_23752":100458,"_2384":100557},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_2857":59272,"_25085":59236,"_17521":100559,"_5":17416,"_23752":100458,"_2384":100560},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_2857":59273,"_25085":59236,"_17521":100562,"_5":17416,"_23752":100466,"_2384":100563},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_2857":59274,"_25085":59236,"_17521":100565,"_5":17416,"_23752":100470,"_2384":100566},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_2857":59275,"_25085":59236,"_17521":100568,"_5":17416,"_23752":100474,"_2384":100569},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_2857":59276,"_25085":59236,"_17521":100571,"_5":17416,"_23752":100478,"_2384":100572},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_2857":59277,"_25085":59236,"_17521":100574,"_5":17416,"_23752":100482,"_2384":100575},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_2857":59278,"_25085":59236,"_17521":100577,"_5":17416,"_23752":100486,"_2384":100578},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_2857":59279,"_25085":59236,"_17521":100580,"_5":17416,"_23752":100490,"_2384":100034},[],{"_2857":59280,"_25085":59236,"_17521":100582,"_5":17416,"_23752":100490,"_2384":100583},[],"Qué prepara o comprueba",{"_2857":59281,"_25085":59236,"_17521":100585,"_5":17416,"_23752":100490,"_2384":100037},[],{"_2857":59282,"_25085":59236,"_17521":100587,"_5":17416,"_23752":100490,"_2384":100588},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_2857":59283,"_25085":59236,"_17521":100590,"_5":17416,"_23752":100490,"_2384":100591},[],"Administrador de la flota",{"_2857":59284,"_25085":59236,"_17521":100593,"_5":17416,"_23752":100490,"_2384":100594},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_2857":59285,"_25085":59236,"_17521":100596,"_5":17416,"_23752":100490,"_2384":100049},[],{"_2857":59286,"_25085":59236,"_17521":100598,"_5":17416,"_23752":100490,"_2384":100599},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_2857":59287,"_25085":59236,"_17521":100601,"_5":17416,"_23752":100490,"_2384":100055},[],{"_2857":59288,"_25085":59236,"_17521":100603,"_5":17416,"_23752":100490,"_2384":100604},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_2857":59289,"_25085":59236,"_17521":100606,"_5":17416,"_23752":100490,"_2384":100607},[],"Operador de infraestructura",{"_2857":59290,"_25085":59236,"_17521":100609,"_5":17416,"_23752":100490,"_2384":100610},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_2857":59291,"_25085":59236,"_17521":100612,"_5":17416,"_23752":100490,"_2384":100613},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_2857":59292,"_25085":59292,"_5":12285,"_2384":100615,"_25421":100616,"_17521":100618,"_23752":59292},"Jerarquía y rotación de CAs",[40762,97039,45787,100617],"Claves, autoridades y certificados",[],{"_2857":59293,"_25085":59292,"_17521":100620,"_5":17416,"_23752":59292,"_2384":100621},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_2857":59294,"_25085":59292,"_5":25418,"_17521":100623,"_23752":100624,"_2384":100625},[],"/docs/pr-preview/pr-46/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_2857":59295,"_25085":59292,"_5":25418,"_17521":100627,"_23752":100628,"_2384":100629},[],"/docs/pr-preview/pr-46/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_2857":59296,"_25085":59292,"_5":25418,"_17521":100631,"_23752":100632,"_2384":100633},[],"/docs/pr-preview/pr-46/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_2857":59297,"_25085":59292,"_5":25418,"_17521":100635,"_23752":100636,"_2384":100637},[],"/docs/pr-preview/pr-46/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_2857":59298,"_25085":59292,"_5":25418,"_17521":100639,"_23752":100640,"_2384":100641},[],"/docs/pr-preview/pr-46/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_2857":59299,"_25085":59292,"_5":25418,"_17521":100643,"_23752":100644,"_2384":100645},[],"/docs/pr-preview/pr-46/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_2857":59300,"_25085":59292,"_5":25418,"_17521":100647,"_23752":100648,"_2384":100649},[],"/docs/pr-preview/pr-46/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_2857":59301,"_25085":59292,"_5":25418,"_17521":100651,"_23752":100652,"_2384":100653},[],"/docs/pr-preview/pr-46/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_2857":59302,"_25085":59292,"_5":25418,"_17521":100655,"_23752":100656,"_2384":100657},[],"/docs/pr-preview/pr-46/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_2857":59303,"_25085":59292,"_5":25418,"_17521":100659,"_23752":100660,"_2384":100661},[],"/docs/pr-preview/pr-46/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_2857":59304,"_25085":59292,"_5":25418,"_17521":100663,"_23752":100664,"_2384":100665},[],"/docs/pr-preview/pr-46/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_2857":59305,"_25085":59292,"_5":25418,"_17521":100667,"_23752":100668,"_2384":100669},[],"/docs/pr-preview/pr-46/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_2857":59306,"_25085":59292,"_17521":100671,"_5":17416,"_23752":59292,"_2384":100672},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_2857":59307,"_25085":59292,"_17521":100674,"_5":17416,"_23752":59292,"_2384":100675},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_2857":59308,"_25085":59292,"_17521":100677,"_5":17416,"_23752":100624,"_2384":100678},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_2857":59309,"_25085":59292,"_17521":100680,"_5":17416,"_23752":100624,"_2384":100681},[],"entorno, como producción y preproducción;",{"_2857":59310,"_25085":59292,"_17521":100683,"_5":17416,"_23752":100624,"_2384":100684},[],"propietario o equipo operador;",{"_2857":59311,"_25085":59292,"_17521":100686,"_5":17416,"_23752":100624,"_2384":100687},[],"familia de dispositivos o proceso de fabricación;",{"_2857":59312,"_25085":59292,"_17521":100689,"_5":17416,"_23752":100624,"_2384":100690},[],"región o requisito regulatorio;",{"_2857":59313,"_25085":59292,"_17521":100692,"_5":17416,"_23752":100624,"_2384":100693},[],"motor criptográfico o política de clave;",{"_2857":59314,"_25085":59292,"_17521":100695,"_5":17416,"_23752":100624,"_2384":100696},[],"ventana de mantenimiento y ritmo de renovación.",{"_2857":59315,"_25085":59292,"_17521":100698,"_5":17416,"_23752":100624,"_2384":100699},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_2857":59316,"_25085":59292,"_17521":100701,"_5":17416,"_23752":100624,"_2384":100702},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_2857":59317,"_25085":59292,"_17521":100704,"_5":17416,"_23752":100628,"_2384":100705},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_2857":59318,"_25085":59292,"_17521":100707,"_5":17416,"_23752":100628,"_2384":100708},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_2857":59319,"_25085":59292,"_17521":100710,"_5":17416,"_23752":100628,"_2384":100711},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_2857":59320,"_25085":59292,"_17521":100713,"_5":17416,"_23752":100632,"_2384":100714},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_2857":59321,"_25085":59292,"_17521":100716,"_5":17416,"_23752":100632,"_2384":100717},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_2857":59322,"_25085":59292,"_17521":100719,"_5":17416,"_23752":100632,"_2384":100720},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_2857":59323,"_25085":59292,"_17521":100722,"_5":17416,"_23752":100632,"_2384":100723},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_2857":59324,"_25085":59292,"_17521":100725,"_5":17416,"_23752":100640,"_2384":100726},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_2857":59325,"_25085":59292,"_17521":100728,"_5":17416,"_23752":100644,"_2384":100729},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_2857":59326,"_25085":59292,"_17521":100731,"_5":17416,"_23752":100648,"_2384":100732},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_2857":59327,"_25085":59292,"_17521":100734,"_5":17416,"_23752":100652,"_2384":100735},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mantén las CAs de validación adicionales si todavía deben aceptarse certificados antiguos durante el re-enrolamiento.",{"_2857":59328,"_25085":59292,"_17521":100737,"_5":17416,"_23752":100656,"_2384":100738},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_2857":59329,"_25085":59292,"_17521":100740,"_5":17416,"_23752":100660,"_2384":100741},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_2857":59330,"_25085":59292,"_17521":100743,"_5":17416,"_23752":100664,"_2384":100744},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_2857":59331,"_25085":59292,"_17521":100746,"_5":17416,"_23752":100664,"_2384":100747},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_2857":59332,"_25085":59292,"_17521":100749,"_5":17416,"_23752":100664,"_2384":100750},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_2857":59333,"_25085":59292,"_17521":100752,"_5":17416,"_23752":100664,"_2384":100753},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_2857":59334,"_25085":59292,"_17521":100755,"_5":17416,"_23752":100668,"_2384":100756},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_2857":59335,"_25085":59292,"_17521":100758,"_5":17416,"_23752":100668,"_2384":100759},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_2857":59336,"_25085":59292,"_17521":100761,"_5":17416,"_23752":100668,"_2384":100762},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_2857":59337,"_25085":59292,"_17521":100764,"_5":17416,"_23752":100668,"_2384":100765},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_2857":59338,"_25085":59292,"_17521":100767,"_5":17416,"_23752":100668,"_2384":100768},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_2857":59339,"_25085":59292,"_17521":100770,"_5":17416,"_23752":100668,"_2384":100771},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_2857":59340,"_25085":59292,"_17521":100773,"_5":17416,"_23752":100668,"_2384":100774},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_2857":59341,"_25085":59341,"_5":12285,"_2384":100776,"_25421":100777,"_17521":100778,"_23752":59341},"Autoridades de certificación",[40762,97039,45787,100617],[],{"_2857":59342,"_25085":59341,"_17521":100780,"_5":17416,"_23752":59341,"_2384":100781},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_2857":59343,"_25085":59341,"_5":25418,"_17521":100783,"_23752":100784,"_2384":100785},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_2857":59344,"_25085":59341,"_5":25418,"_17521":100787,"_23752":100788,"_2384":100789},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_2857":59345,"_25085":59341,"_5":25418,"_17521":100791,"_23752":100792,"_2384":95740},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-authorities#antes-de-empezar",{"_2857":59346,"_25085":59341,"_5":25418,"_17521":100794,"_23752":100795,"_2384":100796},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_2857":59347,"_25085":59341,"_5":25418,"_17521":100798,"_23752":100799,"_2384":100800},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_2857":59348,"_25085":59341,"_5":25418,"_17521":100802,"_23752":100803,"_2384":100804},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_2857":59349,"_25085":59341,"_5":25418,"_17521":100806,"_23752":100807,"_2384":100808},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_2857":59350,"_25085":59341,"_5":25418,"_17521":100810,"_23752":100811,"_2384":100812},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_2857":59351,"_25085":59341,"_5":25418,"_17521":100814,"_23752":100815,"_2384":100816},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_2857":59352,"_25085":59341,"_5":25418,"_17521":100818,"_23752":100819,"_2384":100820},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_2857":59353,"_25085":59341,"_5":25418,"_17521":100822,"_23752":100823,"_2384":100824},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_2857":59354,"_25085":59341,"_5":25418,"_17521":100826,"_23752":100827,"_2384":100828},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_2857":59355,"_25085":59341,"_5":25418,"_17521":100830,"_23752":100831,"_2384":100832},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_2857":59356,"_25085":59341,"_5":25418,"_17521":100834,"_23752":100835,"_2384":100836},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_2857":59357,"_25085":59341,"_5":25418,"_17521":100838,"_23752":100839,"_2384":100840},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_2857":59358,"_25085":59341,"_5":25418,"_17521":100842,"_23752":100843,"_2384":100844},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_2857":59359,"_25085":59341,"_5":25418,"_17521":100846,"_23752":100847,"_2384":100848},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_2857":59360,"_25085":59341,"_5":25418,"_17521":100850,"_23752":100851,"_2384":100852},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_2857":59361,"_25085":59341,"_5":25418,"_17521":100854,"_23752":100855,"_2384":100856},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_2857":59362,"_25085":59341,"_5":25418,"_17521":100858,"_23752":100859,"_2384":100860},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_2857":59363,"_25085":59341,"_5":25418,"_17521":100862,"_23752":100863,"_2384":100864},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_2857":59364,"_25085":59341,"_5":25418,"_17521":100866,"_23752":100867,"_2384":100868},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_2857":59365,"_25085":59341,"_17521":100870,"_5":17416,"_23752":59341,"_2384":100871},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_2857":59366,"_25085":59341,"_17521":100873,"_5":17416,"_23752":59341,"_2384":100874},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_2857":59367,"_25085":59341,"_17521":100876,"_5":17416,"_23752":59341,"_2384":100877},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_2857":59368,"_25085":59341,"_17521":100879,"_5":17416,"_23752":100784,"_2384":100880},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_2857":59369,"_25085":59341,"_17521":100882,"_5":17416,"_23752":100784,"_2384":100883},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_2857":59370,"_25085":59341,"_17521":100885,"_5":17416,"_23752":100784,"_2384":100886},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_2857":59371,"_25085":59341,"_17521":100888,"_5":17416,"_23752":100784,"_2384":100889},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_2857":59372,"_25085":59341,"_17521":100891,"_5":17416,"_23752":100784,"_2384":100892},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_2857":59373,"_25085":59341,"_17521":100894,"_5":17416,"_23752":100792,"_2384":100895},[],"Decide si la CA será raíz o intermedia.",{"_2857":59374,"_25085":59341,"_17521":100897,"_5":17416,"_23752":100792,"_2384":100898},[],"Elige el motor que custodiará la clave.",{"_2857":59375,"_25085":59341,"_17521":100900,"_5":17416,"_23752":100792,"_2384":100901},[],"Define una validez superior a la de los certificados que emitirá.",{"_2857":59376,"_25085":59341,"_17521":100903,"_5":17416,"_23752":100792,"_2384":100904},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_2857":59377,"_25085":59341,"_17521":100906,"_5":17416,"_23752":100795,"_2384":100907},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_2857":59378,"_25085":59341,"_17521":100909,"_5":17416,"_23752":100799,"_2384":100910},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_2857":59379,"_25085":59341,"_17521":100912,"_5":17416,"_23752":100799,"_2384":100913},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_2857":59380,"_25085":59341,"_17521":100915,"_5":17416,"_23752":100803,"_2384":100916},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_2857":59381,"_25085":59341,"_17521":100918,"_5":17416,"_23752":100807,"_2384":100919},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_2857":59382,"_25085":59341,"_17521":100921,"_5":17416,"_23752":100807,"_2384":100922},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_2857":59383,"_25085":59341,"_17521":100924,"_5":17416,"_23752":100807,"_2384":100925},[],"`ST`: estado o provincia.",{"_2857":59384,"_25085":59341,"_17521":100927,"_5":17416,"_23752":100807,"_2384":100928},[],"`L`: localidad.",{"_2857":59385,"_25085":59341,"_17521":100930,"_5":17416,"_23752":100807,"_2384":100931},[],"`O`: organización.",{"_2857":59386,"_25085":59341,"_17521":100933,"_5":17416,"_23752":100807,"_2384":100934},[],"`OU`: unidad organizativa.",{"_2857":59387,"_25085":59341,"_17521":100936,"_5":17416,"_23752":100807,"_2384":100937},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_2857":59388,"_25085":59341,"_17521":100939,"_5":17416,"_23752":100811,"_2384":100940},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_2857":59389,"_25085":59341,"_17521":100942,"_5":17416,"_23752":100811,"_2384":100943},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_2857":59390,"_25085":59341,"_17521":100945,"_5":17416,"_23752":100815,"_2384":100946},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_2857":59391,"_25085":59341,"_17521":100948,"_5":17416,"_23752":100815,"_2384":100949},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_2857":59392,"_25085":59341,"_17521":100951,"_5":17416,"_23752":100819,"_2384":100952},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_2857":59393,"_25085":59341,"_17521":100954,"_5":17416,"_23752":100819,"_2384":100955},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_2857":59394,"_25085":59341,"_17521":100957,"_5":17416,"_23752":100823,"_2384":100958},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_2857":59395,"_25085":59341,"_17521":100960,"_5":17416,"_23752":100827,"_2384":100961},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_2857":59396,"_25085":59341,"_17521":100963,"_5":17416,"_23752":100831,"_2384":100964},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_2857":59397,"_25085":59341,"_17521":100966,"_5":17416,"_23752":100835,"_2384":100967},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_2857":59398,"_25085":59341,"_17521":100969,"_5":17416,"_23752":100839,"_2384":100970},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_2857":59399,"_25085":59341,"_17521":100972,"_5":17416,"_23752":100839,"_2384":100973},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_2857":59400,"_25085":59341,"_17521":100975,"_5":17416,"_23752":100843,"_2384":100976},[],"Abre una CA desde el inventario para consultar:",{"_2857":59401,"_25085":59341,"_17521":100978,"_5":17416,"_23752":100843,"_2384":100979},[],"Estado y periodo de validez.",{"_2857":59402,"_25085":59341,"_17521":100981,"_5":17416,"_23752":100843,"_2384":100982},[],"Certificado y cadena en formato PEM.",{"_2857":59403,"_25085":59341,"_17521":100984,"_5":17416,"_23752":100843,"_2384":100985},[],"Número de certificados activos, expirados y revocados.",{"_2857":59404,"_25085":59341,"_17521":100987,"_5":17416,"_23752":100843,"_2384":100988},[],"Certificados emitidos en **Issued Certificates**.",{"_2857":59405,"_25085":59341,"_17521":100990,"_5":17416,"_23752":100843,"_2384":100991},[],"CRL vinculada a la autoridad.",{"_2857":59406,"_25085":59341,"_17521":100993,"_5":17416,"_23752":100843,"_2384":100994},[],"Metadatos y motor criptográfico asociado.",{"_2857":59407,"_25085":59341,"_17521":100996,"_5":17416,"_23752":100843,"_2384":100997},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_2857":59408,"_25085":59341,"_17521":100999,"_5":17416,"_23752":100847,"_2384":101000},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_2857":59409,"_25085":59341,"_17521":101002,"_5":17416,"_23752":100847,"_2384":101003},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_2857":59410,"_25085":59341,"_17521":101005,"_5":17416,"_23752":100847,"_2384":101006},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_2857":59411,"_25085":59341,"_17521":101008,"_5":17416,"_23752":100847,"_2384":101009},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_2857":59412,"_25085":59341,"_17521":101011,"_5":17416,"_23752":100851,"_2384":101012},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_2857":59413,"_25085":59341,"_17521":101014,"_5":17416,"_23752":100855,"_2384":101015},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_2857":59414,"_25085":59341,"_17521":101017,"_5":17416,"_23752":100859,"_2384":101018},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_2857":59415,"_25085":59341,"_17521":101020,"_5":17416,"_23752":100863,"_2384":101021},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_2857":59416,"_25085":59341,"_17521":101023,"_5":17416,"_23752":100867,"_2384":101024},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_2857":59417,"_25085":59341,"_17521":101026,"_5":17416,"_23752":100867,"_2384":101027},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_2857":59418,"_25085":59418,"_5":12285,"_2384":101029,"_25421":101030,"_17521":101031,"_23752":59418},"Perfiles de certificado",[40762,97039,45787,100617],[],{"_2857":59419,"_25085":59418,"_17521":101033,"_5":17416,"_23752":59418,"_2384":101034},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_2857":59420,"_25085":59418,"_5":25418,"_17521":101036,"_23752":101037,"_2384":101038},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_2857":59421,"_25085":59418,"_5":25418,"_17521":101040,"_23752":101041,"_2384":101042},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-profiles#validez","Validez",{"_2857":59422,"_25085":59418,"_5":25418,"_17521":101044,"_23752":101045,"_2384":101046},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_2857":59423,"_25085":59418,"_5":25418,"_17521":101048,"_23752":101049,"_2384":101050},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_2857":59424,"_25085":59418,"_5":25418,"_17521":101052,"_23752":101053,"_2384":101054},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_2857":59425,"_25085":59418,"_5":25418,"_17521":101056,"_23752":101057,"_2384":101058},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_2857":59426,"_25085":59418,"_5":25418,"_17521":101060,"_23752":101061,"_2384":101062},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_2857":59427,"_25085":59418,"_5":25418,"_17521":101064,"_23752":101065,"_2384":101066},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_2857":59428,"_25085":59418,"_5":25418,"_17521":101068,"_23752":101069,"_2384":101070},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_2857":59429,"_25085":59418,"_5":25418,"_17521":101072,"_23752":101073,"_2384":101074},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_2857":59430,"_25085":59418,"_5":25418,"_17521":101076,"_23752":101077,"_2384":101078},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_2857":59431,"_25085":59418,"_5":25418,"_17521":101080,"_23752":101081,"_2384":101082},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_2857":59432,"_25085":59418,"_5":25418,"_17521":101084,"_23752":101085,"_2384":101086},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_2857":59433,"_25085":59418,"_5":25418,"_17521":101088,"_23752":101089,"_2384":101090},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_2857":59434,"_25085":59418,"_5":25418,"_17521":101092,"_23752":101093,"_2384":101094},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_2857":59435,"_25085":59418,"_5":25418,"_17521":101096,"_23752":101097,"_2384":101098},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_2857":59436,"_25085":59418,"_17521":101100,"_5":17416,"_23752":59418,"_2384":101101},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_2857":59437,"_25085":59418,"_17521":101103,"_5":17416,"_23752":59418,"_2384":101104},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_2857":59438,"_25085":59418,"_17521":101106,"_5":17416,"_23752":101041,"_2384":101107},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_2857":59439,"_25085":59418,"_17521":101109,"_5":17416,"_23752":101041,"_2384":101110},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_2857":59440,"_25085":59418,"_17521":101112,"_5":17416,"_23752":101045,"_2384":101113},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_2857":59441,"_25085":59418,"_17521":101115,"_5":17416,"_23752":101049,"_2384":101116},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_2857":59442,"_25085":59418,"_17521":101118,"_5":17416,"_23752":101049,"_2384":101119},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_2857":59443,"_25085":59418,"_17521":101121,"_5":17416,"_23752":101049,"_2384":101122},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_2857":59444,"_25085":59418,"_17521":101124,"_5":17416,"_23752":101053,"_2384":101125},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_2857":59445,"_25085":59418,"_17521":101127,"_5":17416,"_23752":101057,"_2384":101128},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_2857":59446,"_25085":59418,"_17521":101130,"_5":17416,"_23752":101057,"_2384":101131},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_2857":59447,"_25085":59418,"_17521":101133,"_5":17416,"_23752":101061,"_2384":101134},[],"La aplicación criptográfica puede:",{"_2857":59448,"_25085":59418,"_17521":101136,"_5":17416,"_23752":101061,"_2384":101137},[],"permitir o bloquear claves RSA;",{"_2857":59449,"_25085":59418,"_17521":101139,"_5":17416,"_23752":101061,"_2384":101140},[],"limitar los tamaños RSA admitidos;",{"_2857":59450,"_25085":59418,"_17521":101142,"_5":17416,"_23752":101061,"_2384":101143},[],"permitir o bloquear claves ECDSA;",{"_2857":59451,"_25085":59418,"_17521":101145,"_5":17416,"_23752":101061,"_2384":101146},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_2857":59452,"_25085":59418,"_17521":101148,"_5":17416,"_23752":101061,"_2384":101149},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_2857":59453,"_25085":59418,"_17521":101151,"_5":17416,"_23752":101065,"_2384":101152},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_2857":59454,"_25085":59418,"_17521":101154,"_5":17416,"_23752":101065,"_2384":96830},[],{"_2857":59455,"_25085":59418,"_17521":101156,"_5":17416,"_23752":101065,"_2384":101157},[],"Primera opción",{"_2857":59456,"_25085":59418,"_17521":101159,"_5":17416,"_23752":101065,"_2384":101160},[],"Segunda opción",{"_2857":59457,"_25085":59418,"_17521":101162,"_5":17416,"_23752":101065,"_2384":101163},[],"Si no hay ninguna",{"_2857":59458,"_25085":59418,"_17521":101165,"_5":17416,"_23752":101065,"_2384":101166},[],"Firma directa con una CA",{"_2857":59459,"_25085":59418,"_17521":101168,"_5":17416,"_23752":101065,"_2384":101169},[],"`issuance_profile` incluido en la solicitud",{"_2857":59460,"_25085":59418,"_17521":101171,"_5":17416,"_23752":101065,"_2384":101172},[],"`issuance_profile_id` de la solicitud",{"_2857":59461,"_25085":59418,"_17521":101174,"_5":17416,"_23752":101065,"_2384":101175},[],"Perfil predeterminado de la CA (`profile_id`).",{"_2857":59462,"_25085":59418,"_17521":101177,"_5":17416,"_23752":101065,"_2384":101178},[],"Emisión mediante DMS",{"_2857":59463,"_25085":59418,"_17521":101180,"_5":17416,"_23752":101065,"_2384":46352},[],{"_2857":59464,"_25085":59418,"_17521":101182,"_5":17416,"_23752":101065,"_2384":101183},[],"`settings.issuance_profile` incluido en el DMS",{"_2857":59465,"_25085":59418,"_17521":101185,"_5":17416,"_23752":101065,"_2384":101186},[],"Perfil predeterminado de la CA de enrolamiento.",{"_2857":59466,"_25085":59418,"_17521":101188,"_5":17416,"_23752":101065,"_2384":101189},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_2857":59467,"_25085":59418,"_17521":101191,"_5":17416,"_23752":101065,"_2384":101192},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_2857":59468,"_25085":59418,"_17521":101194,"_5":17416,"_23752":101073,"_2384":101195},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_2857":59469,"_25085":59418,"_17521":101197,"_5":17416,"_23752":101077,"_2384":101198},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_2857":59470,"_25085":59418,"_17521":101200,"_5":17416,"_23752":101081,"_2384":101201},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_2857":59471,"_25085":59418,"_17521":101203,"_5":17416,"_23752":101085,"_2384":101204},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_2857":59472,"_25085":59418,"_17521":101206,"_5":17416,"_23752":101089,"_2384":101207},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_2857":59473,"_25085":59418,"_17521":101209,"_5":17416,"_23752":101089,"_2384":101210},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_2857":59474,"_25085":59418,"_17521":101212,"_5":17416,"_23752":101093,"_2384":101213},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_2857":59475,"_25085":59418,"_17521":101215,"_5":17416,"_23752":101093,"_2384":101216},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_2857":59476,"_25085":59418,"_17521":101218,"_5":17416,"_23752":101093,"_2384":101219},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_2857":59477,"_25085":59418,"_17521":101221,"_5":17416,"_23752":101093,"_2384":101222},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_2857":59478,"_25085":59418,"_17521":101224,"_5":17416,"_23752":101097,"_2384":101225},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_2857":59479,"_25085":59418,"_17521":101227,"_5":17416,"_23752":101097,"_2384":101228},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_2857":59480,"_25085":59480,"_5":12285,"_2384":101230,"_25421":101231,"_17521":101233,"_23752":59480},"Validación de certificados",[40762,97039,45787,101232],"Validación",[],{"_2857":59481,"_25085":59480,"_17521":101235,"_5":17416,"_23752":59480,"_2384":101236},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_2857":59482,"_25085":59480,"_5":25418,"_17521":101238,"_23752":101239,"_2384":101240},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_2857":59483,"_25085":59480,"_5":25418,"_17521":101242,"_23752":101243,"_2384":101244},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_2857":59484,"_25085":59480,"_5":25418,"_17521":101246,"_23752":101247,"_2384":101248},[],"/docs/pr-preview/pr-46/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_2857":59485,"_25085":59480,"_17521":101250,"_5":17416,"_23752":59480,"_2384":101251},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_2857":59486,"_25085":59480,"_17521":101253,"_5":17416,"_23752":101239,"_2384":101254},[],"Verifica estos criterios juntos:",{"_2857":59487,"_25085":59480,"_17521":101256,"_5":17416,"_23752":101239,"_2384":100244},[],{"_2857":59488,"_25085":59480,"_17521":101258,"_5":17416,"_23752":101239,"_2384":101259},[],"Resultado necesario",{"_2857":59489,"_25085":59480,"_17521":101261,"_5":17416,"_23752":101239,"_2384":101262},[],"Cadena y firma",{"_2857":59490,"_25085":59480,"_17521":101264,"_5":17416,"_23752":101239,"_2384":101265},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_2857":59491,"_25085":59480,"_17521":101267,"_5":17416,"_23752":101239,"_2384":101268},[],"Fechas",{"_2857":59492,"_25085":59480,"_17521":101270,"_5":17416,"_23752":101239,"_2384":101271},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_2857":59493,"_25085":59480,"_17521":101273,"_5":17416,"_23752":101239,"_2384":96743},[],{"_2857":59494,"_25085":59480,"_17521":101275,"_5":17416,"_23752":101239,"_2384":101276},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_2857":59495,"_25085":59480,"_17521":101278,"_5":17416,"_23752":101239,"_2384":101279},[],"Uso",{"_2857":59496,"_25085":59480,"_17521":101281,"_5":17416,"_23752":101239,"_2384":101282},[],"KU, EKU y restricciones permiten la operación concreta.",{"_2857":59497,"_25085":59480,"_17521":101284,"_5":17416,"_23752":101239,"_2384":101285},[],"Revocación",{"_2857":59498,"_25085":59480,"_17521":101287,"_5":17416,"_23752":101239,"_2384":101288},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_2857":59499,"_25085":59480,"_17521":101290,"_5":17416,"_23752":101239,"_2384":101291},[],"Autorización",{"_2857":59500,"_25085":59480,"_17521":101293,"_5":17416,"_23752":101239,"_2384":101294},[],"La aplicación permite la acción a esa identidad.",{"_2857":59501,"_25085":59480,"_17521":101296,"_5":17416,"_23752":101239,"_2384":101297},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_2857":59502,"_25085":59480,"_17521":101299,"_5":17416,"_23752":101243,"_2384":101300},[],"Mecanismo",{"_2857":59503,"_25085":59480,"_17521":101302,"_5":17416,"_23752":101243,"_2384":101303},[],"Cuándo utilizarlo",{"_2857":59504,"_25085":59480,"_17521":101305,"_5":17416,"_23752":101243,"_2384":101306},[],"Qué debes mantener",{"_2857":59505,"_25085":59480,"_17521":101308,"_5":17416,"_23752":101243,"_2384":46480},[],{"_2857":59506,"_25085":59480,"_17521":101310,"_5":17416,"_23752":101243,"_2384":101311},[],"Consulta del estado de un certificado concreto.",{"_2857":59507,"_25085":59480,"_17521":101313,"_5":17416,"_23752":101243,"_2384":101314},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_2857":59508,"_25085":59480,"_17521":101316,"_5":17416,"_23752":101243,"_2384":46489},[],{"_2857":59509,"_25085":59480,"_17521":101318,"_5":17416,"_23752":101243,"_2384":101319},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_2857":59510,"_25085":59480,"_17521":101321,"_5":17416,"_23752":101243,"_2384":101322},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_2857":59511,"_25085":59480,"_17521":101324,"_5":17416,"_23752":101243,"_2384":101325},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_2857":59512,"_25085":59480,"_17521":101327,"_5":17416,"_23752":101243,"_2384":101328},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_2857":59513,"_25085":59480,"_17521":101330,"_5":17416,"_23752":101247,"_2384":101331},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_2857":59514,"_25085":59480,"_17521":101333,"_5":17416,"_23752":101247,"_2384":101334},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_2857":59515,"_25085":59480,"_17521":101336,"_5":17416,"_23752":101247,"_2384":101337},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_2857":59516,"_25085":59480,"_17521":101339,"_5":17416,"_23752":101247,"_2384":101340},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_2857":59517,"_25085":59480,"_17521":101342,"_5":17416,"_23752":101247,"_2384":101343},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_2857":59518,"_25085":59480,"_17521":101345,"_5":17416,"_23752":101247,"_2384":101346},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_2857":59519,"_25085":59480,"_17521":101348,"_5":17416,"_23752":101247,"_2384":101349},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_2857":59520,"_25085":59480,"_17521":101351,"_5":17416,"_23752":101247,"_2384":101352},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_2857":59521,"_25085":59480,"_17521":101354,"_5":17416,"_23752":101247,"_2384":101355},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_2857":59522,"_25085":59522,"_5":12285,"_2384":101357,"_25421":101358,"_17521":101359,"_23752":59522},"Certificados",[40762,97039,45787,100617],[],{"_2857":59523,"_25085":59522,"_17521":101361,"_5":17416,"_23752":59522,"_2384":101362},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_2857":59524,"_25085":59522,"_5":25418,"_17521":101364,"_23752":101365,"_2384":101366},[],"/docs/pr-preview/pr-46/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_2857":59525,"_25085":59522,"_5":25418,"_17521":101368,"_23752":101369,"_2384":101370},[],"/docs/pr-preview/pr-46/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_2857":59526,"_25085":59522,"_5":25418,"_17521":101372,"_23752":101373,"_2384":101374},[],"/docs/pr-preview/pr-46/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_2857":59527,"_25085":59522,"_5":25418,"_17521":101376,"_23752":101377,"_2384":101378},[],"/docs/pr-preview/pr-46/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_2857":59528,"_25085":59522,"_5":25418,"_17521":101380,"_23752":101381,"_2384":101382},[],"/docs/pr-preview/pr-46/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_2857":59529,"_25085":59522,"_5":25418,"_17521":101384,"_23752":101385,"_2384":101386},[],"/docs/pr-preview/pr-46/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_2857":59530,"_25085":59522,"_5":25418,"_17521":101388,"_23752":101389,"_2384":101390},[],"/docs/pr-preview/pr-46/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_2857":59531,"_25085":59522,"_5":25418,"_17521":101392,"_23752":101393,"_2384":101394},[],"/docs/pr-preview/pr-46/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_2857":59532,"_25085":59522,"_5":25418,"_17521":101396,"_23752":101397,"_2384":101398},[],"/docs/pr-preview/pr-46/es/platform/pki/certificates#continúa","Continúa",{"_2857":59533,"_25085":59522,"_17521":101400,"_5":17416,"_23752":59522,"_2384":101401},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_2857":59534,"_25085":59522,"_17521":101403,"_5":17416,"_23752":101365,"_2384":101404},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_2857":59535,"_25085":59522,"_17521":101406,"_5":17416,"_23752":101365,"_2384":101407},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_2857":59536,"_25085":59522,"_17521":101409,"_5":17416,"_23752":101369,"_2384":101410},[],"Descarga el PEM e inspecciónalo:",{"_2857":59537,"_25085":59522,"_17521":101412,"_5":17416,"_23752":101369,"_2384":101413},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_2857":59538,"_25085":59522,"_17521":101415,"_5":17416,"_23752":101373,"_2384":101416},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_2857":59539,"_25085":59522,"_17521":101418,"_5":17416,"_23752":101373,"_2384":101419},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_2857":59540,"_25085":59522,"_17521":101421,"_5":17416,"_23752":101373,"_2384":101422},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_2857":59541,"_25085":59522,"_17521":101424,"_5":17416,"_23752":101373,"_2384":101425},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_2857":59542,"_25085":59522,"_17521":101427,"_5":17416,"_23752":101373,"_2384":101428},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_2857":59543,"_25085":59522,"_17521":101430,"_5":17416,"_23752":101373,"_2384":101431},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_2857":59544,"_25085":59522,"_17521":101433,"_5":17416,"_23752":101373,"_2384":101434},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_2857":59545,"_25085":59522,"_17521":101436,"_5":17416,"_23752":101377,"_2384":101437},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_2857":59546,"_25085":59522,"_17521":101439,"_5":17416,"_23752":101381,"_2384":101440},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_2857":59547,"_25085":59522,"_17521":101442,"_5":17416,"_23752":101385,"_2384":101443},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_2857":59548,"_25085":59522,"_17521":101445,"_5":17416,"_23752":101389,"_2384":101446},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_2857":59549,"_25085":59522,"_17521":101448,"_5":17416,"_23752":101389,"_2384":101449},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_2857":59550,"_25085":59522,"_17521":101451,"_5":17416,"_23752":101389,"_2384":101452},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_2857":59551,"_25085":59522,"_17521":101454,"_5":17416,"_23752":101393,"_2384":101455},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_2857":59552,"_25085":59522,"_17521":101457,"_5":17416,"_23752":101393,"_2384":101458},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_2857":59553,"_25085":59522,"_17521":101460,"_5":17416,"_23752":101393,"_2384":101461},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_2857":59554,"_25085":59522,"_17521":101463,"_5":17416,"_23752":101397,"_2384":101464},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_2857":59555,"_25085":59522,"_17521":101466,"_5":17416,"_23752":101397,"_2384":101467},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_2857":59556,"_25085":59556,"_5":12285,"_2384":101469,"_25421":101470,"_17521":101472,"_23752":59556},"Ciclo de vida de un certificado",[40762,97039,45787,101471],"Conceptos",[],{"_2857":59557,"_25085":59556,"_17521":101474,"_5":17416,"_23752":59556,"_2384":101475},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_2857":59558,"_25085":59556,"_5":25418,"_17521":101477,"_23752":101478,"_2384":101479},[],"/docs/pr-preview/pr-46/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_2857":59559,"_25085":59556,"_5":25418,"_17521":101481,"_23752":101482,"_2384":101483},[],"/docs/pr-preview/pr-46/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_2857":59560,"_25085":59556,"_5":25418,"_17521":101485,"_23752":101486,"_2384":101487},[],"/docs/pr-preview/pr-46/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_2857":59561,"_25085":59556,"_5":25418,"_17521":101489,"_23752":101490,"_2384":101491},[],"/docs/pr-preview/pr-46/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_2857":59562,"_25085":59556,"_5":25418,"_17521":101493,"_23752":101494,"_2384":101495},[],"/docs/pr-preview/pr-46/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_2857":59563,"_25085":59556,"_5":25418,"_17521":101497,"_23752":101498,"_2384":101499},[],"/docs/pr-preview/pr-46/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_2857":59564,"_25085":59556,"_5":25418,"_17521":101501,"_23752":101502,"_2384":101503},[],"/docs/pr-preview/pr-46/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_2857":59565,"_25085":59556,"_5":25418,"_17521":101505,"_23752":101506,"_2384":101507},[],"/docs/pr-preview/pr-46/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_2857":59566,"_25085":59556,"_5":25418,"_17521":101509,"_23752":101510,"_2384":101511},[],"/docs/pr-preview/pr-46/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_2857":59567,"_25085":59556,"_5":25418,"_17521":101513,"_23752":101514,"_2384":101515},[],"/docs/pr-preview/pr-46/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_2857":59568,"_25085":59556,"_17521":101517,"_5":17416,"_23752":59556,"_2384":101518},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_2857":59569,"_25085":59556,"_17521":101520,"_5":17416,"_23752":101482,"_2384":101521},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_2857":59570,"_25085":59556,"_17521":101523,"_5":17416,"_23752":101486,"_2384":101524},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_2857":59571,"_25085":59556,"_17521":101526,"_5":17416,"_23752":101490,"_2384":101527},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_2857":59572,"_25085":59556,"_17521":101529,"_5":17416,"_23752":101494,"_2384":101530},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_2857":59573,"_25085":59556,"_17521":101532,"_5":17416,"_23752":101498,"_2384":101533},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_2857":59574,"_25085":59556,"_17521":101535,"_5":17416,"_23752":101502,"_2384":101536},[],"Lamassu persiste cuatro estados X.509:",{"_2857":59575,"_25085":59556,"_17521":101538,"_5":17416,"_23752":101502,"_2384":101539},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_2857":59576,"_25085":59556,"_17521":101541,"_5":17416,"_23752":101502,"_2384":101542},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_2857":59577,"_25085":59556,"_17521":101544,"_5":17416,"_23752":101502,"_2384":101545},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_2857":59578,"_25085":59556,"_17521":101547,"_5":17416,"_23752":101502,"_2384":101548},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_2857":59579,"_25085":59556,"_17521":101550,"_5":17416,"_23752":101502,"_2384":101551},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_2857":59580,"_25085":59556,"_17521":101553,"_5":17416,"_23752":101506,"_2384":101554},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_2857":59581,"_25085":59556,"_17521":101556,"_5":17416,"_23752":101506,"_2384":101557},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_2857":59582,"_25085":59556,"_17521":101559,"_5":17416,"_23752":101506,"_2384":101560},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_2857":59583,"_25085":59556,"_17521":101562,"_5":17416,"_23752":101510,"_2384":101563},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_2857":59584,"_25085":59556,"_17521":101565,"_5":17416,"_23752":101510,"_2384":101566},[],"Antes de confirmar:",{"_2857":59585,"_25085":59556,"_17521":101568,"_5":17416,"_23752":101510,"_2384":101569},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_2857":59586,"_25085":59556,"_17521":101571,"_5":17416,"_23752":101510,"_2384":101572},[],"Distribuye la nueva cadena de confianza.",{"_2857":59587,"_25085":59556,"_17521":101574,"_5":17416,"_23752":101510,"_2384":101575},[],"Reemite las identidades necesarias.",{"_2857":59588,"_25085":59556,"_17521":101577,"_5":17416,"_23752":101510,"_2384":101578},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_2857":59589,"_25085":59556,"_17521":101580,"_5":17416,"_23752":101510,"_2384":101581},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_2857":59590,"_25085":59556,"_17521":101583,"_5":17416,"_23752":101510,"_2384":101584},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_2857":59591,"_25085":59556,"_17521":101586,"_5":17416,"_23752":101514,"_2384":101587},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_2857":59592,"_25085":59556,"_17521":101589,"_5":17416,"_23752":101514,"_2384":101590},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_2857":59593,"_25085":59556,"_17521":101592,"_5":17416,"_23752":101514,"_2384":101593},[],"Cambios de estado y razones de revocación.",{"_2857":59594,"_25085":59556,"_17521":101595,"_5":17416,"_23752":101514,"_2384":101596},[],"Publicación y vigencia de OCSP y CRLs.",{"_2857":59595,"_25085":59556,"_17521":101598,"_5":17416,"_23752":101514,"_2384":101599},[],"Dependencias que todavía presentan un certificado sustituido.",{"_2857":59596,"_25085":59556,"_17521":101601,"_5":17416,"_23752":101514,"_2384":101602},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_2857":59597,"_25085":59597,"_5":12285,"_2384":101604,"_25421":101605,"_17521":101606,"_23752":59597},"Modelo de confianza",[40762,97039,45787,101471],[],{"_2857":59598,"_25085":59597,"_17521":101608,"_5":17416,"_23752":59597,"_2384":101609},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_2857":59599,"_25085":59597,"_5":25418,"_17521":101611,"_23752":101612,"_2384":101613},[],"/docs/pr-preview/pr-46/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_2857":59600,"_25085":59597,"_5":25418,"_17521":101615,"_23752":101616,"_2384":101617},[],"/docs/pr-preview/pr-46/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_2857":59601,"_25085":59597,"_5":25418,"_17521":101619,"_23752":101620,"_2384":101621},[],"/docs/pr-preview/pr-46/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_2857":59602,"_25085":59597,"_5":25418,"_17521":101623,"_23752":101624,"_2384":101625},[],"/docs/pr-preview/pr-46/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_2857":59603,"_25085":59597,"_5":25418,"_17521":101627,"_23752":101628,"_2384":101629},[],"/docs/pr-preview/pr-46/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_2857":59604,"_25085":59597,"_5":25418,"_17521":101631,"_23752":101632,"_2384":101633},[],"/docs/pr-preview/pr-46/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_2857":59605,"_25085":59597,"_5":25418,"_17521":101635,"_23752":101636,"_2384":101637},[],"/docs/pr-preview/pr-46/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_2857":59606,"_25085":59597,"_5":25418,"_17521":101639,"_23752":101640,"_2384":101641},[],"/docs/pr-preview/pr-46/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_2857":59607,"_25085":59597,"_5":25418,"_17521":101643,"_23752":101644,"_2384":101645},[],"/docs/pr-preview/pr-46/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_2857":59608,"_25085":59597,"_5":25418,"_17521":101647,"_23752":101648,"_2384":101649},[],"/docs/pr-preview/pr-46/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_2857":59609,"_25085":59597,"_17521":101651,"_5":17416,"_23752":59597,"_2384":101652},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_2857":59610,"_25085":59597,"_17521":101654,"_5":17416,"_23752":101616,"_2384":101655},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_2857":59611,"_25085":59597,"_17521":101657,"_5":17416,"_23752":101620,"_2384":101658},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_2857":59612,"_25085":59597,"_17521":101660,"_5":17416,"_23752":101624,"_2384":101661},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_2857":59613,"_25085":59597,"_17521":101663,"_5":17416,"_23752":101628,"_2384":101664},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_2857":59614,"_25085":59597,"_17521":101666,"_5":17416,"_23752":101632,"_2384":101667},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_2857":59615,"_25085":59597,"_17521":101669,"_5":17416,"_23752":101632,"_2384":101670},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_2857":59616,"_25085":59597,"_17521":101672,"_5":17416,"_23752":101632,"_2384":101673},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_2857":59617,"_25085":59597,"_17521":101675,"_5":17416,"_23752":101632,"_2384":101676},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_2857":59618,"_25085":59597,"_17521":101678,"_5":17416,"_23752":101632,"_2384":101679},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_2857":59619,"_25085":59597,"_17521":101681,"_5":17416,"_23752":101632,"_2384":101682},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_2857":59620,"_25085":59597,"_17521":101684,"_5":17416,"_23752":101636,"_2384":101685},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_2857":59621,"_25085":59597,"_17521":101687,"_5":17416,"_23752":101636,"_2384":101688},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_2857":59622,"_25085":59597,"_17521":101690,"_5":17416,"_23752":101636,"_2384":101691},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación adicionales.",{"_2857":59623,"_25085":59597,"_17521":101693,"_5":17416,"_23752":101636,"_2384":101694},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_2857":59624,"_25085":59597,"_17521":101696,"_5":17416,"_23752":101636,"_2384":101697},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_2857":59625,"_25085":59597,"_17521":101699,"_5":17416,"_23752":101640,"_2384":101700},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_2857":59626,"_25085":59597,"_17521":101702,"_5":17416,"_23752":101640,"_2384":101703},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_2857":59627,"_25085":59597,"_17521":101705,"_5":17416,"_23752":101640,"_2384":101706},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_2857":59628,"_25085":59597,"_17521":101708,"_5":17416,"_23752":101640,"_2384":101709},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_2857":59629,"_25085":59597,"_17521":101711,"_5":17416,"_23752":101640,"_2384":101712},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_2857":59630,"_25085":59597,"_17521":101714,"_5":17416,"_23752":101640,"_2384":101715},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_2857":59631,"_25085":59597,"_17521":101717,"_5":17416,"_23752":101640,"_2384":101718},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_2857":59632,"_25085":59597,"_17521":101720,"_5":17416,"_23752":101644,"_2384":101721},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_2857":59633,"_25085":59597,"_17521":101723,"_5":17416,"_23752":101648,"_2384":101724},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_2857":59634,"_25085":59597,"_17521":101726,"_5":17416,"_23752":101648,"_2384":101727},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_2857":59635,"_25085":59597,"_17521":101729,"_5":17416,"_23752":101648,"_2384":101730},[],"Asigna perfiles explícitos a cada caso de uso.",{"_2857":59636,"_25085":59597,"_17521":101732,"_5":17416,"_23752":101648,"_2384":101733},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_2857":59637,"_25085":59597,"_17521":101735,"_5":17416,"_23752":101648,"_2384":101736},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_2857":59638,"_25085":59597,"_17521":101738,"_5":17416,"_23752":101648,"_2384":101739},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_2857":59639,"_25085":59597,"_17521":101741,"_5":17416,"_23752":101648,"_2384":101742},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_2857":59640,"_25085":59640,"_5":12285,"_2384":101744,"_25421":101745,"_17521":101746,"_23752":59640},"Listas de revocación (CRL)",[40762,97039,45787,101232],[],{"_2857":59641,"_25085":59640,"_17521":101748,"_5":17416,"_23752":59640,"_2384":101749},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_2857":59642,"_25085":59640,"_5":25418,"_17521":101751,"_23752":101752,"_2384":101753},[],"/docs/pr-preview/pr-46/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_2857":59643,"_25085":59640,"_5":25418,"_17521":101755,"_23752":101756,"_2384":101757},[],"/docs/pr-preview/pr-46/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_2857":59644,"_25085":59640,"_5":25418,"_17521":101759,"_23752":101760,"_2384":101761},[],"/docs/pr-preview/pr-46/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_2857":59645,"_25085":59640,"_5":25418,"_17521":101763,"_23752":101764,"_2384":101765},[],"/docs/pr-preview/pr-46/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_2857":59646,"_25085":59640,"_5":25418,"_17521":101767,"_23752":101768,"_2384":101769},[],"/docs/pr-preview/pr-46/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_2857":59647,"_25085":59640,"_5":25418,"_17521":101771,"_23752":101772,"_2384":101773},[],"/docs/pr-preview/pr-46/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_2857":59648,"_25085":59640,"_5":25418,"_17521":101775,"_23752":101776,"_2384":101777},[],"/docs/pr-preview/pr-46/es/platform/pki/crl#referencias","Referencias",{"_2857":59649,"_25085":59640,"_17521":101779,"_5":17416,"_23752":59640,"_2384":101780},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_2857":59650,"_25085":59640,"_17521":101782,"_5":17416,"_23752":101752,"_2384":101783},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_2857":59651,"_25085":59640,"_17521":101785,"_5":17416,"_23752":101752,"_2384":101786},[],"Campo de `crl_options`",{"_2857":59652,"_25085":59640,"_17521":101788,"_5":17416,"_23752":101752,"_2384":98535},[],{"_2857":59653,"_25085":59640,"_17521":101790,"_5":17416,"_23752":101752,"_2384":101791},[],"Valor inicial del backend",{"_2857":59654,"_25085":59640,"_17521":101793,"_5":17416,"_23752":101752,"_2384":46967},[],{"_2857":59655,"_25085":59640,"_17521":101795,"_5":17416,"_23752":101752,"_2384":101796},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_2857":59656,"_25085":59640,"_17521":101798,"_5":17416,"_23752":101752,"_2384":101799},[],"7 días.",{"_2857":59657,"_25085":59640,"_17521":101801,"_5":17416,"_23752":101752,"_2384":46976},[],{"_2857":59658,"_25085":59640,"_17521":101803,"_5":17416,"_23752":101752,"_2384":101804},[],"Plazo desde la publicación que activa la renovación programada.",{"_2857":59659,"_25085":59640,"_17521":101806,"_5":17416,"_23752":101752,"_2384":101807},[],"6 días y 23 horas.",{"_2857":59660,"_25085":59640,"_17521":101809,"_5":17416,"_23752":101752,"_2384":46985},[],{"_2857":59661,"_25085":59640,"_17521":101811,"_5":17416,"_23752":101752,"_2384":101812},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_2857":59662,"_25085":59640,"_17521":101814,"_5":17416,"_23752":101752,"_2384":46991},[],{"_2857":59663,"_25085":59640,"_17521":101816,"_5":17416,"_23752":101752,"_2384":46994},[],{"_2857":59664,"_25085":59640,"_17521":101818,"_5":17416,"_23752":101752,"_2384":101819},[],"Campo de configuración inicializado con el SKI de la CA.",{"_2857":59665,"_25085":59640,"_17521":101821,"_5":17416,"_23752":101752,"_2384":101822},[],"SKI de la CA.",{"_2857":59666,"_25085":59640,"_17521":101824,"_5":17416,"_23752":101752,"_2384":101825},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_2857":59667,"_25085":59640,"_17521":101827,"_5":17416,"_23752":101752,"_2384":101828},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_2857":59668,"_25085":59640,"_17521":101830,"_5":17416,"_23752":101756,"_2384":101831},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_2857":59669,"_25085":59640,"_17521":101833,"_5":17416,"_23752":101756,"_2384":101834},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_2857":59670,"_25085":59640,"_17521":101836,"_5":17416,"_23752":101756,"_2384":101837},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_2857":59671,"_25085":59640,"_17521":101839,"_5":17416,"_23752":101760,"_2384":101840},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_2857":59672,"_25085":59640,"_17521":101842,"_5":17416,"_23752":101760,"_2384":101843},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_2857":59673,"_25085":59640,"_17521":101845,"_5":17416,"_23752":101764,"_2384":101846},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_2857":59674,"_25085":59640,"_17521":101848,"_5":17416,"_23752":101764,"_2384":101849},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_2857":59675,"_25085":59640,"_17521":101851,"_5":17416,"_23752":101764,"_2384":101852},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_2857":59676,"_25085":59640,"_17521":101854,"_5":17416,"_23752":101764,"_2384":101855},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_2857":59677,"_25085":59640,"_17521":101857,"_5":17416,"_23752":101764,"_2384":101858},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_2857":59678,"_25085":59640,"_17521":101860,"_5":17416,"_23752":101768,"_2384":101861},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_2857":59679,"_25085":59640,"_17521":101863,"_5":17416,"_23752":101768,"_2384":98724},[],{"_2857":59680,"_25085":59640,"_17521":101865,"_5":17416,"_23752":101768,"_2384":101866},[],"Path relativo",{"_2857":59681,"_25085":59640,"_17521":101868,"_5":17416,"_23752":101768,"_2384":96830},[],{"_2857":59682,"_25085":59640,"_17521":101870,"_5":17416,"_23752":101768,"_2384":47049},[],{"_2857":59683,"_25085":59640,"_17521":101872,"_5":17416,"_23752":101768,"_2384":47052},[],{"_2857":59684,"_25085":59640,"_17521":101874,"_5":17416,"_23752":101768,"_2384":101875},[],"Consultar `crl_options` y `latest_crl`.",{"_2857":59685,"_25085":59640,"_17521":101877,"_5":17416,"_23752":101768,"_2384":47058},[],{"_2857":59686,"_25085":59640,"_17521":101879,"_5":17416,"_23752":101768,"_2384":47052},[],{"_2857":59687,"_25085":59640,"_17521":101881,"_5":17416,"_23752":101768,"_2384":101882},[],"Sustituir la configuración de CRL.",{"_2857":59688,"_25085":59640,"_17521":101884,"_5":17416,"_23752":101768,"_2384":101885},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_2857":59689,"_25085":59640,"_17521":101887,"_5":17416,"_23752":101768,"_2384":101888},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_2857":59690,"_25085":59640,"_17521":101890,"_5":17416,"_23752":101772,"_2384":101891},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_2857":59691,"_25085":59640,"_17521":101893,"_5":17416,"_23752":101776,"_2384":101894},[],"RFC 5280: perfil X.509 y CRL.",{"_2857":59692,"_25085":59640,"_17521":101896,"_5":17416,"_23752":101776,"_2384":47078},[],{"_2857":59693,"_25085":59640,"_17521":101898,"_5":17416,"_23752":101776,"_2384":47081},[],{"_2857":59694,"_25085":59640,"_17521":101900,"_5":17416,"_23752":101776,"_2384":101901},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_2857":59695,"_25085":59640,"_17521":101903,"_5":17416,"_23752":101776,"_2384":101904},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2857":59696,"_25085":59696,"_5":12285,"_2384":101906,"_25421":101907,"_17521":101908,"_23752":59696},"Claves y motores criptográficos",[40762,97039,45787,100617],[],{"_2857":59697,"_25085":59696,"_17521":101910,"_5":17416,"_23752":59696,"_2384":101911},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_2857":59698,"_25085":59696,"_5":25418,"_17521":101913,"_23752":101914,"_2384":101915},[],"/docs/pr-preview/pr-46/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_2857":59699,"_25085":59696,"_5":25418,"_17521":101917,"_23752":101918,"_2384":101919},[],"/docs/pr-preview/pr-46/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_2857":59700,"_25085":59696,"_5":25418,"_17521":101921,"_23752":101922,"_2384":47106},[],"/docs/pr-preview/pr-46/es/platform/pki/key-management#file-system",{"_2857":59701,"_25085":59696,"_5":25418,"_17521":101924,"_23752":101925,"_2384":47110},[],"/docs/pr-preview/pr-46/es/platform/pki/key-management#hashicorp-vault",{"_2857":59702,"_25085":59696,"_5":25418,"_17521":101927,"_23752":101928,"_2384":47114},[],"/docs/pr-preview/pr-46/es/platform/pki/key-management#aws-secrets-manager",{"_2857":59703,"_25085":59696,"_5":25418,"_17521":101930,"_23752":101931,"_2384":47118},[],"/docs/pr-preview/pr-46/es/platform/pki/key-management#aws-kms",{"_2857":59704,"_25085":59696,"_5":25418,"_17521":101933,"_23752":101934,"_2384":47122},[],"/docs/pr-preview/pr-46/es/platform/pki/key-management#pkcs11",{"_2857":59705,"_25085":59696,"_5":25418,"_17521":101936,"_23752":101937,"_2384":47126},[],"/docs/pr-preview/pr-46/es/platform/pki/key-management#azure-key-vault",{"_2857":59706,"_25085":59696,"_5":25418,"_17521":101939,"_23752":101940,"_2384":101941},[],"/docs/pr-preview/pr-46/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_2857":59707,"_25085":59696,"_5":25418,"_17521":101943,"_23752":101944,"_2384":101945},[],"/docs/pr-preview/pr-46/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_2857":59708,"_25085":59696,"_5":25418,"_17521":101947,"_23752":101948,"_2384":101949},[],"/docs/pr-preview/pr-46/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_2857":59709,"_25085":59696,"_5":25418,"_17521":101951,"_23752":101952,"_2384":101953},[],"/docs/pr-preview/pr-46/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_2857":59710,"_25085":59696,"_5":25418,"_17521":101955,"_23752":101956,"_2384":101957},[],"/docs/pr-preview/pr-46/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_2857":59711,"_25085":59696,"_5":25418,"_17521":101959,"_23752":101960,"_2384":101961},[],"/docs/pr-preview/pr-46/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_2857":59712,"_25085":59696,"_5":25418,"_17521":101963,"_23752":101964,"_2384":101965},[],"/docs/pr-preview/pr-46/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_2857":59713,"_25085":59696,"_5":25418,"_17521":101967,"_23752":101968,"_2384":47158},[],"/docs/pr-preview/pr-46/es/platform/pki/key-management#sign",{"_2857":59714,"_25085":59696,"_5":25418,"_17521":101970,"_23752":101971,"_2384":47162},[],"/docs/pr-preview/pr-46/es/platform/pki/key-management#verify",{"_2857":59715,"_25085":59696,"_5":25418,"_17521":101973,"_23752":101974,"_2384":101975},[],"/docs/pr-preview/pr-46/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_2857":59716,"_25085":59696,"_5":25418,"_17521":101977,"_23752":101978,"_2384":101979},[],"/docs/pr-preview/pr-46/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_2857":59717,"_25085":59696,"_5":25418,"_17521":101981,"_23752":101982,"_2384":101983},[],"/docs/pr-preview/pr-46/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_2857":59718,"_25085":59696,"_17521":101985,"_5":17416,"_23752":59696,"_2384":101986},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_2857":59719,"_25085":59696,"_17521":101988,"_5":17416,"_23752":59696,"_2384":101989},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_2857":59720,"_25085":59696,"_17521":101991,"_5":17416,"_23752":101914,"_2384":101992},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_2857":59721,"_25085":59696,"_17521":101994,"_5":17416,"_23752":101914,"_2384":101995},[],"En la práctica, permite:",{"_2857":59722,"_25085":59696,"_17521":101997,"_5":17416,"_23752":101914,"_2384":101998},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_2857":59723,"_25085":59696,"_17521":102000,"_5":17416,"_23752":101914,"_2384":102001},[],"Importar claves creadas externamente.",{"_2857":59724,"_25085":59696,"_17521":102003,"_5":17416,"_23752":101914,"_2384":102004},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_2857":59725,"_25085":59696,"_17521":102006,"_5":17416,"_23752":101914,"_2384":102007},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_2857":59726,"_25085":59696,"_17521":102009,"_5":17416,"_23752":101918,"_2384":102010},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_2857":59727,"_25085":59696,"_17521":102012,"_5":17416,"_23752":101918,"_2384":102013},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_2857":59728,"_25085":59696,"_17521":102015,"_5":17416,"_23752":101918,"_2384":102016},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_2857":59729,"_25085":59696,"_17521":102018,"_5":17416,"_23752":101922,"_2384":102019},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_2857":59730,"_25085":59696,"_17521":102021,"_5":17416,"_23752":101925,"_2384":102022},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_2857":59731,"_25085":59696,"_17521":102024,"_5":17416,"_23752":101928,"_2384":102025},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_2857":59732,"_25085":59696,"_17521":102027,"_5":17416,"_23752":101931,"_2384":102028},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_2857":59733,"_25085":59696,"_17521":102030,"_5":17416,"_23752":101934,"_2384":102031},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_2857":59734,"_25085":59696,"_17521":102033,"_5":17416,"_23752":101937,"_2384":102034},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_2857":59735,"_25085":59696,"_17521":102036,"_5":17416,"_23752":101937,"_2384":102037},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_2857":59736,"_25085":59696,"_17521":102039,"_5":17416,"_23752":101937,"_2384":102040},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_2857":59737,"_25085":59696,"_17521":102042,"_5":17416,"_23752":101937,"_2384":102043},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_2857":59738,"_25085":59696,"_17521":102045,"_5":17416,"_23752":101940,"_2384":102046},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_2857":59739,"_25085":59696,"_17521":102048,"_5":17416,"_23752":101940,"_2384":102049},[],"La tabla incluye los siguientes campos:",{"_2857":59740,"_25085":59696,"_17521":102051,"_5":17416,"_23752":101940,"_2384":102052},[],"**Name**: nombre descriptivo de la clave.",{"_2857":59741,"_25085":59696,"_17521":102054,"_5":17416,"_23752":101940,"_2384":102055},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_2857":59742,"_25085":59696,"_17521":102057,"_5":17416,"_23752":101940,"_2384":102058},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_2857":59743,"_25085":59696,"_17521":102060,"_5":17416,"_23752":101940,"_2384":102061},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_2857":59744,"_25085":59696,"_17521":102063,"_5":17416,"_23752":101940,"_2384":102064},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_2857":59745,"_25085":59696,"_17521":102066,"_5":17416,"_23752":101940,"_2384":102067},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_2857":59746,"_25085":59696,"_17521":102069,"_5":17416,"_23752":101940,"_2384":102070},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_2857":59747,"_25085":59696,"_17521":102072,"_5":17416,"_23752":101940,"_2384":102073},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_2857":59748,"_25085":59696,"_17521":102075,"_5":17416,"_23752":101940,"_2384":102076},[],"Desde esta vista también se accede a las acciones más habituales:",{"_2857":59749,"_25085":59696,"_17521":102078,"_5":17416,"_23752":101940,"_2384":102079},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_2857":59750,"_25085":59696,"_17521":102081,"_5":17416,"_23752":101940,"_2384":102082},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_2857":59751,"_25085":59696,"_17521":102084,"_5":17416,"_23752":101940,"_2384":102085},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_2857":59752,"_25085":59696,"_17521":102087,"_5":17416,"_23752":101940,"_2384":102088},[],"**Delete Key** para eliminar la clave del sistema.",{"_2857":59753,"_25085":59696,"_17521":102090,"_5":17416,"_23752":101944,"_2384":102091},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_2857":59754,"_25085":59696,"_17521":102093,"_5":17416,"_23752":101948,"_2384":102094},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_2857":59755,"_25085":59696,"_17521":102096,"_5":17416,"_23752":101948,"_2384":102097},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_2857":59756,"_25085":59696,"_17521":102099,"_5":17416,"_23752":101948,"_2384":102100},[],"**Key Name**: nombre único y descriptivo.",{"_2857":59757,"_25085":59696,"_17521":102102,"_5":17416,"_23752":101948,"_2384":102103},[],"**Crypto Engine**: motor que custodiará la clave.",{"_2857":59758,"_25085":59696,"_17521":102105,"_5":17416,"_23752":101948,"_2384":102106},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_2857":59759,"_25085":59696,"_17521":102108,"_5":17416,"_23752":101948,"_2384":102109},[],"**Tags**: metadatos para clasificar la clave.",{"_2857":59760,"_25085":59696,"_17521":102111,"_5":17416,"_23752":101948,"_2384":102112},[],"**Metadata**: información adicional para usos avanzados.",{"_2857":59761,"_25085":59696,"_17521":102114,"_5":17416,"_23752":101952,"_2384":102115},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_2857":59762,"_25085":59696,"_17521":102117,"_5":17416,"_23752":101952,"_2384":102118},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_2857":59763,"_25085":59696,"_17521":102120,"_5":17416,"_23752":101952,"_2384":102121},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_2857":59764,"_25085":59696,"_17521":102123,"_5":17416,"_23752":101952,"_2384":102124},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_2857":59765,"_25085":59696,"_17521":102126,"_5":17416,"_23752":101952,"_2384":102127},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_2857":59766,"_25085":59696,"_17521":102129,"_5":17416,"_23752":101952,"_2384":102130},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_2857":59767,"_25085":59696,"_17521":102132,"_5":17416,"_23752":101952,"_2384":102133},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_2857":59768,"_25085":59696,"_17521":102135,"_5":17416,"_23752":101952,"_2384":102136},[],"**Tags**: etiquetas para organización y búsqueda.",{"_2857":59769,"_25085":59696,"_17521":102138,"_5":17416,"_23752":101952,"_2384":102139},[],"**Metadata**: información adicional opcional.",{"_2857":59770,"_25085":59696,"_17521":102141,"_5":17416,"_23752":101952,"_2384":102142},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_2857":59771,"_25085":59696,"_17521":102144,"_5":17416,"_23752":101952,"_2384":102145},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_2857":59772,"_25085":59696,"_17521":102147,"_5":17416,"_23752":101956,"_2384":102148},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_2857":59773,"_25085":59696,"_17521":102150,"_5":17416,"_23752":101960,"_2384":102151},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_2857":59774,"_25085":59696,"_17521":102153,"_5":17416,"_23752":101960,"_2384":102154},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_2857":59775,"_25085":59696,"_17521":102156,"_5":17416,"_23752":101960,"_2384":102157},[],"**Key Name**: nombre descriptivo.",{"_2857":59776,"_25085":59696,"_17521":102159,"_5":17416,"_23752":101960,"_2384":102160},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_2857":59777,"_25085":59696,"_17521":102162,"_5":17416,"_23752":101960,"_2384":102163},[],"**Tags**: etiquetas asociadas.",{"_2857":59778,"_25085":59696,"_17521":102165,"_5":17416,"_23752":101960,"_2384":102166},[],"**Aliases**: nombres alternativos.",{"_2857":59779,"_25085":59696,"_17521":102168,"_5":17416,"_23752":101960,"_2384":102169},[],"**Crypto Engine**: motor en el que reside la clave.",{"_2857":59780,"_25085":59696,"_17521":102171,"_5":17416,"_23752":101960,"_2384":102172},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_2857":59781,"_25085":59696,"_17521":102174,"_5":17416,"_23752":101960,"_2384":102175},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_2857":59782,"_25085":59696,"_17521":102177,"_5":17416,"_23752":101960,"_2384":102178},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_2857":59783,"_25085":59696,"_17521":102180,"_5":17416,"_23752":101964,"_2384":102181},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_2857":59784,"_25085":59696,"_17521":102183,"_5":17416,"_23752":101964,"_2384":102184},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_2857":59785,"_25085":59696,"_17521":102186,"_5":17416,"_23752":101964,"_2384":102187},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_2857":59786,"_25085":59696,"_17521":102189,"_5":17416,"_23752":101968,"_2384":102190},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_2857":59787,"_25085":59696,"_17521":102192,"_5":17416,"_23752":101968,"_2384":102193},[],"Campos principales:",{"_2857":59788,"_25085":59696,"_17521":102195,"_5":17416,"_23752":101968,"_2384":102196},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_2857":59789,"_25085":59696,"_17521":102198,"_5":17416,"_23752":101968,"_2384":102199},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_2857":59790,"_25085":59696,"_17521":102201,"_5":17416,"_23752":101968,"_2384":102202},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_2857":59791,"_25085":59696,"_17521":102204,"_5":17416,"_23752":101968,"_2384":102205},[],"**Message**: contenido que se va a firmar.",{"_2857":59792,"_25085":59696,"_17521":102207,"_5":17416,"_23752":101968,"_2384":102208},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_2857":59793,"_25085":59696,"_17521":102210,"_5":17416,"_23752":101971,"_2384":102211},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_2857":59794,"_25085":59696,"_17521":102213,"_5":17416,"_23752":101971,"_2384":102193},[],{"_2857":59795,"_25085":59696,"_17521":102215,"_5":17416,"_23752":101971,"_2384":102216},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_2857":59796,"_25085":59696,"_17521":102218,"_5":17416,"_23752":101971,"_2384":102219},[],"**Message Type**: `Raw` o `Digest`.",{"_2857":59797,"_25085":59696,"_17521":102221,"_5":17416,"_23752":101971,"_2384":102222},[],"**Payload Encoding**: codificación del mensaje.",{"_2857":59798,"_25085":59696,"_17521":102224,"_5":17416,"_23752":101971,"_2384":102225},[],"**Message**: mensaje original o hash.",{"_2857":59799,"_25085":59696,"_17521":102227,"_5":17416,"_23752":101971,"_2384":102228},[],"**Signature**: firma que se desea comprobar.",{"_2857":59800,"_25085":59696,"_17521":102230,"_5":17416,"_23752":101971,"_2384":102231},[],"**Result**: indicador del resultado de la validación.",{"_2857":59801,"_25085":59696,"_17521":102233,"_5":17416,"_23752":101974,"_2384":102234},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_2857":59802,"_25085":59696,"_17521":102236,"_5":17416,"_23752":101974,"_2384":102237},[],"Este flujo es útil para:",{"_2857":59803,"_25085":59696,"_17521":102239,"_5":17416,"_23752":101974,"_2384":102240},[],"Solicitar certificados a una CA externa.",{"_2857":59804,"_25085":59696,"_17521":102242,"_5":17416,"_23752":101974,"_2384":102243},[],"Renovar una identidad manteniendo la misma clave.",{"_2857":59805,"_25085":59696,"_17521":102245,"_5":17416,"_23752":101974,"_2384":102246},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_2857":59806,"_25085":59696,"_17521":102248,"_5":17416,"_23752":101974,"_2384":102249},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_2857":59807,"_25085":59696,"_17521":102251,"_5":17416,"_23752":101974,"_2384":102252},[],"**Organization (O)**: organización o empresa.",{"_2857":59808,"_25085":59696,"_17521":102254,"_5":17416,"_23752":101974,"_2384":102255},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_2857":59809,"_25085":59696,"_17521":102257,"_5":17416,"_23752":101974,"_2384":102258},[],"**Country (C)**: código de país de dos letras.",{"_2857":59810,"_25085":59696,"_17521":102260,"_5":17416,"_23752":101974,"_2384":102261},[],"**State / Province (ST)**: estado o provincia.",{"_2857":59811,"_25085":59696,"_17521":102263,"_5":17416,"_23752":101974,"_2384":102264},[],"**Locality (L)**: ciudad o localidad.",{"_2857":59812,"_25085":59696,"_17521":102266,"_5":17416,"_23752":101974,"_2384":102267},[],"**Email Address**: correo de contacto.",{"_2857":59813,"_25085":59696,"_17521":102269,"_5":17416,"_23752":101974,"_2384":102270},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_2857":59814,"_25085":59696,"_17521":102272,"_5":17416,"_23752":101974,"_2384":102273},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_2857":59815,"_25085":59696,"_17521":102275,"_5":17416,"_23752":101978,"_2384":102276},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_2857":59816,"_25085":59696,"_17521":102278,"_5":17416,"_23752":101978,"_2384":47470},[],{"_2857":59817,"_25085":59696,"_17521":102280,"_5":17416,"_23752":101982,"_2384":102281},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_2857":59818,"_25085":59818,"_5":12285,"_2384":102283,"_25421":102284,"_17521":102285,"_23752":59818},"Validación online con OCSP",[40762,97039,45787,101232],[],{"_2857":59819,"_25085":59818,"_17521":102287,"_5":17416,"_23752":59818,"_2384":102288},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_2857":59820,"_25085":59818,"_5":25418,"_17521":102290,"_23752":102291,"_2384":102292},[],"/docs/pr-preview/pr-46/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_2857":59821,"_25085":59818,"_5":25418,"_17521":102294,"_23752":102295,"_2384":102296},[],"/docs/pr-preview/pr-46/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_2857":59822,"_25085":59818,"_5":25418,"_17521":102298,"_23752":102299,"_2384":102300},[],"/docs/pr-preview/pr-46/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_2857":59823,"_25085":59818,"_5":25418,"_17521":102302,"_23752":102303,"_2384":102304},[],"/docs/pr-preview/pr-46/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_2857":59824,"_25085":59818,"_5":25418,"_17521":102306,"_23752":102307,"_2384":102308},[],"/docs/pr-preview/pr-46/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_2857":59825,"_25085":59818,"_5":25418,"_17521":102310,"_23752":102311,"_2384":101777},[],"/docs/pr-preview/pr-46/es/platform/pki/ocsp#referencias",{"_2857":59826,"_25085":59818,"_17521":102313,"_5":17416,"_23752":59818,"_2384":102314},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_2857":59827,"_25085":59818,"_17521":102316,"_5":17416,"_23752":102291,"_2384":102317},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_2857":59828,"_25085":59818,"_17521":102319,"_5":17416,"_23752":102291,"_2384":102320},[],"Estado del registro",{"_2857":59829,"_25085":59818,"_17521":102322,"_5":17416,"_23752":102291,"_2384":102323},[],"Respuesta firmada",{"_2857":59830,"_25085":59818,"_17521":102325,"_5":17416,"_23752":102291,"_2384":44965},[],{"_2857":59831,"_25085":59818,"_17521":102327,"_5":17416,"_23752":102291,"_2384":47520},[],{"_2857":59832,"_25085":59818,"_17521":102329,"_5":17416,"_23752":102291,"_2384":44982},[],{"_2857":59833,"_25085":59818,"_17521":102331,"_5":17416,"_23752":102291,"_2384":102332},[],"`Revoked`, con razón y fecha de revocación.",{"_2857":59834,"_25085":59818,"_17521":102334,"_5":17416,"_23752":102291,"_2384":102335},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_2857":59835,"_25085":59818,"_17521":102337,"_5":17416,"_23752":102291,"_2384":102338},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_2857":59836,"_25085":59818,"_17521":102340,"_5":17416,"_23752":102291,"_2384":102341},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_2857":59837,"_25085":59818,"_17521":102343,"_5":17416,"_23752":102291,"_2384":102344},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_2857":59838,"_25085":59818,"_17521":102346,"_5":17416,"_23752":102291,"_2384":102347},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_2857":59839,"_25085":59818,"_17521":102349,"_5":17416,"_23752":102295,"_2384":102350},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_2857":59840,"_25085":59818,"_17521":102352,"_5":17416,"_23752":102295,"_2384":102353},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_2857":59841,"_25085":59818,"_17521":102355,"_5":17416,"_23752":102299,"_2384":102356},[],"El servicio acepta:",{"_2857":59842,"_25085":59818,"_17521":102358,"_5":17416,"_23752":102299,"_2384":98724},[],{"_2857":59843,"_25085":59818,"_17521":102360,"_5":17416,"_23752":102299,"_2384":102361},[],"Ruta del servicio VA",{"_2857":59844,"_25085":59818,"_17521":102363,"_5":17416,"_23752":102299,"_2384":102364},[],"Formato",{"_2857":59845,"_25085":59818,"_17521":102366,"_5":17416,"_23752":102299,"_2384":47560},[],{"_2857":59846,"_25085":59818,"_17521":102368,"_5":17416,"_23752":102299,"_2384":47563},[],{"_2857":59847,"_25085":59818,"_17521":102370,"_5":17416,"_23752":102299,"_2384":102371},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_2857":59848,"_25085":59818,"_17521":102373,"_5":17416,"_23752":102299,"_2384":47049},[],{"_2857":59849,"_25085":59818,"_17521":102375,"_5":17416,"_23752":102299,"_2384":47571},[],{"_2857":59850,"_25085":59818,"_17521":102377,"_5":17416,"_23752":102299,"_2384":102378},[],"Solicitud DER codificada en Base64 URL con padding.",{"_2857":59851,"_25085":59818,"_17521":102380,"_5":17416,"_23752":102299,"_2384":102381},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_2857":59852,"_25085":59818,"_17521":102383,"_5":17416,"_23752":102303,"_2384":102384},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_2857":59853,"_25085":59818,"_17521":102386,"_5":17416,"_23752":102303,"_2384":102387},[],"Genera la solicitud:",{"_2857":59854,"_25085":59818,"_17521":102389,"_5":17416,"_23752":102303,"_2384":102390},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_2857":59855,"_25085":59818,"_17521":102392,"_5":17416,"_23752":102303,"_2384":102393},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_2857":59856,"_25085":59818,"_17521":102395,"_5":17416,"_23752":102303,"_2384":102396},[],"Verifica el DER recibido:",{"_2857":59857,"_25085":59818,"_17521":102398,"_5":17416,"_23752":102303,"_2384":102399},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_2857":59858,"_25085":59818,"_17521":102401,"_5":17416,"_23752":102307,"_2384":102402},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_2857":59859,"_25085":59818,"_17521":102404,"_5":17416,"_23752":102307,"_2384":102405},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_2857":59860,"_25085":59818,"_17521":102407,"_5":17416,"_23752":102311,"_2384":47604},[],{"_2857":59861,"_25085":59818,"_17521":102409,"_5":17416,"_23752":102311,"_2384":47607},[],{"_2857":59862,"_25085":59818,"_17521":102411,"_5":17416,"_23752":102311,"_2384":102412},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_2857":59863,"_25085":59818,"_17521":102414,"_5":17416,"_23752":102311,"_2384":101904},[],{"_2857":59864,"_25085":59864,"_5":12285,"_2384":45787,"_25421":102416,"_17521":102417,"_23752":59864},[40762,97039,45787],[],{"_2857":59865,"_25085":59864,"_17521":102419,"_5":17416,"_23752":59864,"_2384":102420},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_2857":59866,"_25085":59864,"_5":25418,"_17521":102422,"_23752":102423,"_2384":99941},[],"/docs/pr-preview/pr-46/es/platform/pki/overview#empieza-aquí",{"_2857":59867,"_25085":59864,"_5":25418,"_17521":102425,"_23752":102426,"_2384":102427},[],"/docs/pr-preview/pr-46/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_2857":59868,"_25085":59864,"_5":25418,"_17521":102429,"_23752":102430,"_2384":100463},[],"/docs/pr-preview/pr-46/es/platform/pki/overview#capacidades-principales",{"_2857":59869,"_25085":59864,"_5":25418,"_17521":102432,"_23752":102433,"_2384":100467},[],"/docs/pr-preview/pr-46/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_2857":59870,"_25085":59864,"_5":25418,"_17521":102435,"_23752":102436,"_2384":100471},[],"/docs/pr-preview/pr-46/es/platform/pki/overview#protege-las-claves-criptográficas",{"_2857":59871,"_25085":59864,"_5":25418,"_17521":102438,"_23752":102439,"_2384":100475},[],"/docs/pr-preview/pr-46/es/platform/pki/overview#emite-y-controla-certificados",{"_2857":59872,"_25085":59864,"_5":25418,"_17521":102441,"_23752":102442,"_2384":100483},[],"/docs/pr-preview/pr-46/es/platform/pki/overview#publica-el-estado-de-validación",{"_2857":59873,"_25085":59864,"_5":25418,"_17521":102444,"_23752":102445,"_2384":102446},[],"/docs/pr-preview/pr-46/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_2857":59874,"_25085":59864,"_5":25418,"_17521":102448,"_23752":102449,"_2384":101398},[],"/docs/pr-preview/pr-46/es/platform/pki/overview#continúa",{"_2857":59875,"_25085":59864,"_17521":102451,"_5":17416,"_23752":59864,"_2384":102452},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_2857":59876,"_25085":59864,"_17521":102454,"_5":17416,"_23752":102423,"_2384":102455},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_2857":59877,"_25085":59864,"_17521":102457,"_5":17416,"_23752":102423,"_2384":102458},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_2857":59878,"_25085":59864,"_17521":102460,"_5":17416,"_23752":102426,"_2384":102461},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_2857":59879,"_25085":59864,"_17521":102463,"_5":17416,"_23752":102426,"_2384":102464},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_2857":59880,"_25085":59864,"_17521":102466,"_5":17416,"_23752":102426,"_2384":102467},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_2857":59881,"_25085":59864,"_17521":102469,"_5":17416,"_23752":102426,"_2384":102470},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_2857":59882,"_25085":59864,"_17521":102472,"_5":17416,"_23752":102426,"_2384":102473},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_2857":59883,"_25085":59864,"_17521":102475,"_5":17416,"_23752":102433,"_2384":102476},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_2857":59884,"_25085":59864,"_17521":102478,"_5":17416,"_23752":102436,"_2384":102479},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_2857":59885,"_25085":59864,"_17521":102481,"_5":17416,"_23752":102439,"_2384":102482},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_2857":59886,"_25085":59864,"_17521":102484,"_5":17416,"_23752":102442,"_2384":102485},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_2857":59887,"_25085":59864,"_17521":102487,"_5":17416,"_23752":102445,"_2384":102488},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_2857":59888,"_25085":59864,"_17521":102490,"_5":17416,"_23752":102445,"_2384":102491},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_2857":59889,"_25085":59864,"_17521":102493,"_5":17416,"_23752":102445,"_2384":102494},[],"su clave pública corresponda a la clave privada del cliente;",{"_2857":59890,"_25085":59864,"_17521":102496,"_5":17416,"_23752":102445,"_2384":102497},[],"su cadena alcance una raíz confiable para el consumidor;",{"_2857":59891,"_25085":59864,"_17521":102499,"_5":17416,"_23752":102445,"_2384":102500},[],"sus fechas y usos permitan la operación;",{"_2857":59892,"_25085":59864,"_17521":102502,"_5":17416,"_23752":102445,"_2384":102503},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_2857":59893,"_25085":59864,"_17521":102505,"_5":17416,"_23752":102445,"_2384":102506},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_2857":59894,"_25085":59864,"_17521":102508,"_5":17416,"_23752":102449,"_2384":102509},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2857":59895,"_25085":59864,"_17521":102511,"_5":17416,"_23752":102449,"_2384":102512},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2857":59896,"_25085":59864,"_17521":102514,"_5":17416,"_23752":102449,"_2384":102515},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2857":59897,"_25085":59897,"_5":12285,"_2384":102517,"_25421":102518,"_17521":102519,"_23752":59897},"Crea tu primera CA",[40762,97039,45787,100065],[],{"_2857":59898,"_25085":59897,"_17521":102521,"_5":17416,"_23752":59897,"_2384":102522},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_2857":59899,"_25085":59897,"_5":25418,"_17521":102524,"_23752":102525,"_2384":95740},[],"/docs/pr-preview/pr-46/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_2857":59900,"_25085":59897,"_5":25418,"_17521":102527,"_23752":102528,"_2384":102529},[],"/docs/pr-preview/pr-46/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_2857":59901,"_25085":59897,"_5":25418,"_17521":102531,"_23752":102532,"_2384":102533},[],"/docs/pr-preview/pr-46/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_2857":59902,"_25085":59897,"_5":25418,"_17521":102535,"_23752":102536,"_2384":102537},[],"/docs/pr-preview/pr-46/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_2857":59903,"_25085":59897,"_5":25418,"_17521":102539,"_23752":102540,"_2384":102541},[],"/docs/pr-preview/pr-46/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_2857":59904,"_25085":59897,"_5":25418,"_17521":102543,"_23752":102544,"_2384":102545},[],"/docs/pr-preview/pr-46/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_2857":59905,"_25085":59897,"_5":25418,"_17521":102547,"_23752":102548,"_2384":102549},[],"/docs/pr-preview/pr-46/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_2857":59906,"_25085":59897,"_5":25418,"_17521":102551,"_23752":102552,"_2384":100313},[],"/docs/pr-preview/pr-46/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_2857":59907,"_25085":59897,"_5":25418,"_17521":102554,"_23752":102555,"_2384":95764},[],"/docs/pr-preview/pr-46/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_2857":59908,"_25085":59897,"_17521":102557,"_5":17416,"_23752":59897,"_2384":102558},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_2857":59909,"_25085":59897,"_17521":102560,"_5":17416,"_23752":102525,"_2384":102561},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_2857":59910,"_25085":59897,"_17521":102563,"_5":17416,"_23752":102525,"_2384":102564},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_2857":59911,"_25085":59897,"_17521":102566,"_5":17416,"_23752":102525,"_2384":102567},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_2857":59912,"_25085":59897,"_17521":102569,"_5":17416,"_23752":102525,"_2384":102570},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_2857":59913,"_25085":59897,"_17521":102572,"_5":17416,"_23752":102528,"_2384":102573},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_2857":59914,"_25085":59897,"_17521":102575,"_5":17416,"_23752":102528,"_2384":102576},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_2857":59915,"_25085":59897,"_17521":102578,"_5":17416,"_23752":102532,"_2384":102579},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_2857":59916,"_25085":59897,"_17521":102581,"_5":17416,"_23752":102532,"_2384":102582},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_2857":59917,"_25085":59897,"_17521":102584,"_5":17416,"_23752":102536,"_2384":102585},[],"Selecciona **Root CA** y completa:",{"_2857":59918,"_25085":59897,"_17521":102587,"_5":17416,"_23752":102536,"_2384":47786},[],{"_2857":59919,"_25085":59897,"_17521":102589,"_5":17416,"_23752":102536,"_2384":102590},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_2857":59920,"_25085":59897,"_17521":102592,"_5":17416,"_23752":102536,"_2384":102593},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_2857":59921,"_25085":59897,"_17521":102595,"_5":17416,"_23752":102536,"_2384":102596},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_2857":59922,"_25085":59897,"_17521":102598,"_5":17416,"_23752":102536,"_2384":102599},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_2857":59923,"_25085":59897,"_17521":102601,"_5":17416,"_23752":102540,"_2384":102602},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_2857":59924,"_25085":59897,"_17521":102604,"_5":17416,"_23752":102544,"_2384":102605},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_2857":59925,"_25085":59897,"_17521":102607,"_5":17416,"_23752":102544,"_2384":102608},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_2857":59926,"_25085":59897,"_17521":102610,"_5":17416,"_23752":102548,"_2384":102611},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_2857":59927,"_25085":59897,"_17521":102613,"_5":17416,"_23752":102548,"_2384":102614},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_2857":59928,"_25085":59897,"_17521":102616,"_5":17416,"_23752":102548,"_2384":102617},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_2857":59929,"_25085":59897,"_17521":102619,"_5":17416,"_23752":102552,"_2384":102620},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_2857":59930,"_25085":59897,"_17521":102622,"_5":17416,"_23752":102552,"_2384":102623},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_2857":59931,"_25085":59897,"_17521":102625,"_5":17416,"_23752":102552,"_2384":102626},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_2857":59932,"_25085":59897,"_17521":102628,"_5":17416,"_23752":102552,"_2384":102629},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_2857":59933,"_25085":59897,"_17521":102631,"_5":17416,"_23752":102555,"_2384":102632},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_2857":59934,"_25085":59934,"_5":12285,"_2384":102634,"_25421":102635,"_17521":102636,"_23752":59934},"Emite y verifica un certificado",[40762,97039,45787,100065],[],{"_2857":59935,"_25085":59934,"_17521":102638,"_5":17416,"_23752":59934,"_2384":102639},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_2857":59936,"_25085":59934,"_5":25418,"_17521":102641,"_23752":102642,"_2384":95740},[],"/docs/pr-preview/pr-46/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_2857":59937,"_25085":59934,"_5":25418,"_17521":102644,"_23752":102645,"_2384":102646},[],"/docs/pr-preview/pr-46/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_2857":59938,"_25085":59934,"_5":25418,"_17521":102648,"_23752":102649,"_2384":102650},[],"/docs/pr-preview/pr-46/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_2857":59939,"_25085":59934,"_5":25418,"_17521":102652,"_23752":102653,"_2384":102654},[],"/docs/pr-preview/pr-46/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_2857":59940,"_25085":59934,"_5":25418,"_17521":102656,"_23752":102657,"_2384":102658},[],"/docs/pr-preview/pr-46/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_2857":59941,"_25085":59934,"_5":25418,"_17521":102660,"_23752":102661,"_2384":102662},[],"/docs/pr-preview/pr-46/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_2857":59942,"_25085":59934,"_5":25418,"_17521":102664,"_23752":102665,"_2384":102545},[],"/docs/pr-preview/pr-46/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_2857":59943,"_25085":59934,"_5":25418,"_17521":102667,"_23752":102668,"_2384":102669},[],"/docs/pr-preview/pr-46/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_2857":59944,"_25085":59934,"_5":25418,"_17521":102671,"_23752":102672,"_2384":102673},[],"/docs/pr-preview/pr-46/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_2857":59945,"_25085":59934,"_5":25418,"_17521":102675,"_23752":102676,"_2384":102677},[],"/docs/pr-preview/pr-46/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_2857":59946,"_25085":59934,"_5":25418,"_17521":102679,"_23752":102680,"_2384":100313},[],"/docs/pr-preview/pr-46/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_2857":59947,"_25085":59934,"_5":25418,"_17521":102682,"_23752":102683,"_2384":95764},[],"/docs/pr-preview/pr-46/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_2857":59948,"_25085":59934,"_17521":102685,"_5":17416,"_23752":59934,"_2384":102686},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_2857":59949,"_25085":59934,"_17521":102688,"_5":17416,"_23752":102642,"_2384":102689},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_2857":59950,"_25085":59934,"_17521":102691,"_5":17416,"_23752":102642,"_2384":102692},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_2857":59951,"_25085":59934,"_17521":102694,"_5":17416,"_23752":102642,"_2384":102695},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_2857":59952,"_25085":59934,"_17521":102697,"_5":17416,"_23752":102642,"_2384":102698},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_2857":59953,"_25085":59934,"_17521":102700,"_5":17416,"_23752":102642,"_2384":102701},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_2857":59954,"_25085":59934,"_17521":102703,"_5":17416,"_23752":102645,"_2384":102704},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_2857":59955,"_25085":59934,"_17521":102706,"_5":17416,"_23752":102649,"_2384":102707},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_2857":59956,"_25085":59934,"_17521":102709,"_5":17416,"_23752":102649,"_2384":102710},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_2857":59957,"_25085":59934,"_17521":102712,"_5":17416,"_23752":102653,"_2384":102713},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_2857":59958,"_25085":59934,"_17521":102715,"_5":17416,"_23752":102653,"_2384":102716},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_2857":59959,"_25085":59934,"_17521":102718,"_5":17416,"_23752":102657,"_2384":102719},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_2857":59960,"_25085":59934,"_17521":102721,"_5":17416,"_23752":102657,"_2384":102722},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_2857":59961,"_25085":59934,"_17521":102724,"_5":17416,"_23752":102661,"_2384":102725},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_2857":59962,"_25085":59934,"_17521":102727,"_5":17416,"_23752":102665,"_2384":102728},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_2857":59963,"_25085":59934,"_17521":102730,"_5":17416,"_23752":102668,"_2384":102731},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_2857":59964,"_25085":59934,"_17521":102733,"_5":17416,"_23752":102672,"_2384":102734},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_2857":59965,"_25085":59934,"_17521":102736,"_5":17416,"_23752":102672,"_2384":102737},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_2857":59966,"_25085":59934,"_17521":102739,"_5":17416,"_23752":102672,"_2384":102740},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_2857":59967,"_25085":59934,"_17521":102742,"_5":17416,"_23752":102676,"_2384":102743},[],"En Bash, compara los dos resúmenes de clave pública:",{"_2857":59968,"_25085":59934,"_17521":102745,"_5":17416,"_23752":102676,"_2384":102746},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_2857":59969,"_25085":59934,"_17521":102748,"_5":17416,"_23752":102676,"_2384":102749},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_2857":59970,"_25085":59934,"_17521":102751,"_5":17416,"_23752":102680,"_2384":100396},[],{"_2857":59971,"_25085":59934,"_17521":102753,"_5":17416,"_23752":102680,"_2384":99173},[],{"_2857":59972,"_25085":59934,"_17521":102755,"_5":17416,"_23752":102680,"_2384":102756},[],"La CA rechaza la emisión",{"_2857":59973,"_25085":59934,"_17521":102758,"_5":17416,"_23752":102680,"_2384":102759},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_2857":59974,"_25085":59934,"_17521":102761,"_5":17416,"_23752":102680,"_2384":102762},[],"Sujeto o usos diferentes",{"_2857":59975,"_25085":59934,"_17521":102764,"_5":17416,"_23752":102680,"_2384":102765},[],"Perfil aplicado y valores solicitados.",{"_2857":59976,"_25085":59934,"_17521":102767,"_5":17416,"_23752":102680,"_2384":102768},[],"No se encuentra el emisor",{"_2857":59977,"_25085":59934,"_17521":102770,"_5":17416,"_23752":102680,"_2384":102771},[],"CA descargada y cadena intermedia necesaria.",{"_2857":59978,"_25085":59934,"_17521":102773,"_5":17416,"_23752":102680,"_2384":102774},[],"Falla la vigencia",{"_2857":59979,"_25085":59934,"_17521":102776,"_5":17416,"_23752":102680,"_2384":102777},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_2857":59980,"_25085":59934,"_17521":102779,"_5":17416,"_23752":102680,"_2384":102780},[],"Los resúmenes de clave difieren",{"_2857":59981,"_25085":59934,"_17521":102782,"_5":17416,"_23752":102680,"_2384":102783},[],"Archivos de certificado y clave de la misma emisión.",{"_2857":59982,"_25085":59934,"_17521":102785,"_5":17416,"_23752":102680,"_2384":102786},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_2857":59983,"_25085":59934,"_17521":102788,"_5":17416,"_23752":102683,"_2384":102789},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_2857":59984,"_25085":59934,"_17521":102791,"_5":17416,"_23752":102683,"_2384":102792},[],"Gestionar certificados para inspección, estado y revocación.",{"_2857":59985,"_25085":59934,"_17521":102794,"_5":17416,"_23752":102683,"_2384":102795},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_2857":59986,"_25085":59934,"_17521":102797,"_5":17416,"_23752":102683,"_2384":102798},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_2857":59987,"_25085":59934,"_17521":102800,"_5":17416,"_23752":102683,"_2384":102801},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_2857":59988,"_25085":59988,"_5":12285,"_2384":102803,"_25421":102804,"_17521":102805,"_23752":59988},"Primeros pasos de PKI",[40762,97039,45787,100065],[],{"_2857":59989,"_25085":59988,"_17521":102807,"_5":17416,"_23752":59988,"_2384":102808},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_2857":59990,"_25085":59988,"_5":25418,"_17521":102810,"_23752":102811,"_2384":95740},[],"/docs/pr-preview/pr-46/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_2857":59991,"_25085":59988,"_5":25418,"_17521":102813,"_23752":102814,"_2384":102815},[],"/docs/pr-preview/pr-46/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_2857":59992,"_25085":59988,"_5":25418,"_17521":102817,"_23752":102818,"_2384":100247},[],"/docs/pr-preview/pr-46/es/platform/pki/quickstarts/overview#resultado-esperado",{"_2857":59993,"_25085":59988,"_5":25418,"_17521":102820,"_23752":102821,"_2384":102822},[],"/docs/pr-preview/pr-46/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_2857":59994,"_25085":59988,"_17521":102824,"_5":17416,"_23752":59988,"_2384":102825},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_2857":59995,"_25085":59988,"_17521":102827,"_5":17416,"_23752":102811,"_2384":102828},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_2857":59996,"_25085":59988,"_17521":102830,"_5":17416,"_23752":102811,"_2384":102831},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_2857":59997,"_25085":59988,"_17521":102833,"_5":17416,"_23752":102811,"_2384":102834},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_2857":59998,"_25085":59988,"_17521":102836,"_5":17416,"_23752":102811,"_2384":102837},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_2857":59999,"_25085":59988,"_17521":102839,"_5":17416,"_23752":102811,"_2384":102840},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_2857":60000,"_25085":59988,"_17521":102842,"_5":17416,"_23752":102814,"_2384":102843},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2857":60001,"_25085":59988,"_17521":102845,"_5":17416,"_23752":102814,"_2384":102846},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2857":60002,"_25085":59988,"_17521":102848,"_5":17416,"_23752":102814,"_2384":102849},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_2857":60003,"_25085":59988,"_17521":102851,"_5":17416,"_23752":102814,"_2384":102852},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_2857":60004,"_25085":59988,"_17521":102854,"_5":17416,"_23752":102818,"_2384":102855},[],"Archivo o recurso",{"_2857":60005,"_25085":59988,"_17521":102857,"_5":17416,"_23752":102818,"_2384":100244},[],{"_2857":60006,"_25085":59988,"_17521":102859,"_5":17416,"_23752":102818,"_2384":102860},[],"CA raíz activa y `ca.pem`",{"_2857":60007,"_25085":59988,"_17521":102862,"_5":17416,"_23752":102818,"_2384":102863},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_2857":60008,"_25085":59988,"_17521":102865,"_5":17416,"_23752":102818,"_2384":102866},[],"Certificado final y `device.crt`",{"_2857":60009,"_25085":59988,"_17521":102868,"_5":17416,"_23752":102818,"_2384":102869},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_2857":60010,"_25085":59988,"_17521":102871,"_5":17416,"_23752":102818,"_2384":102872},[],"Clave privada `device.key`",{"_2857":60011,"_25085":59988,"_17521":102874,"_5":17416,"_23752":102818,"_2384":102875},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_2857":60012,"_25085":59988,"_17521":102877,"_5":17416,"_23752":102818,"_2384":102878},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_2857":60013,"_25085":59988,"_17521":102880,"_5":17416,"_23752":102821,"_2384":102881},[],"Para operar certificados, continúa con Certificados y Validación.",{"_2857":60014,"_25085":59988,"_17521":102883,"_5":17416,"_23752":102821,"_2384":102884},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_2857":60015,"_25085":59988,"_17521":102886,"_5":17416,"_23752":102821,"_2384":102887},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_2857":60016,"_25085":60016,"_5":12285,"_2384":102889,"_25421":102890,"_17521":102892,"_23752":60016},"Resolución de problemas PKI",[40762,97039,45787,102891],"Resolución de problemas",[],{"_2857":60017,"_25085":60016,"_17521":102894,"_5":17416,"_23752":60016,"_2384":102895},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_2857":60018,"_25085":60016,"_5":25418,"_17521":102897,"_23752":102898,"_2384":102899},[],"/docs/pr-preview/pr-46/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_2857":60019,"_25085":60016,"_5":25418,"_17521":102901,"_23752":102902,"_2384":102903},[],"/docs/pr-preview/pr-46/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_2857":60020,"_25085":60016,"_5":25418,"_17521":102905,"_23752":102906,"_2384":102907},[],"/docs/pr-preview/pr-46/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_2857":60021,"_25085":60016,"_17521":102909,"_5":17416,"_23752":60016,"_2384":102910},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_2857":60022,"_25085":60016,"_17521":102912,"_5":17416,"_23752":60016,"_2384":102913},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_2857":60023,"_25085":60016,"_17521":102915,"_5":17416,"_23752":102898,"_2384":100244},[],{"_2857":60024,"_25085":60016,"_17521":102917,"_5":17416,"_23752":102898,"_2384":99173},[],{"_2857":60025,"_25085":60016,"_17521":102919,"_5":17416,"_23752":102898,"_2384":95764},[],{"_2857":60026,"_25085":60016,"_17521":102921,"_5":17416,"_23752":102898,"_2384":48122},[],{"_2857":60027,"_25085":60016,"_17521":102923,"_5":17416,"_23752":102898,"_2384":102924},[],"Existe, está activa y sus fechas son utilizables.",{"_2857":60028,"_25085":60016,"_17521":102926,"_5":17416,"_23752":102898,"_2384":102927},[],"Autoridades.",{"_2857":60029,"_25085":60016,"_17521":102929,"_5":17416,"_23752":102898,"_2384":102930},[],"Clave",{"_2857":60030,"_25085":60016,"_17521":102932,"_5":17416,"_23752":102898,"_2384":102933},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_2857":60031,"_25085":60016,"_17521":102935,"_5":17416,"_23752":102898,"_2384":102936},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_2857":60032,"_25085":60016,"_17521":102938,"_5":17416,"_23752":102898,"_2384":48140},[],{"_2857":60033,"_25085":60016,"_17521":102940,"_5":17416,"_23752":102898,"_2384":102941},[],"PEM correcto y firma verificable.",{"_2857":60034,"_25085":60016,"_17521":102943,"_5":17416,"_23752":102898,"_2384":48146},[],{"_2857":60035,"_25085":60016,"_17521":102945,"_5":17416,"_23752":102898,"_2384":102946},[],"Perfil",{"_2857":60036,"_25085":60016,"_17521":102948,"_5":17416,"_23752":102898,"_2384":102949},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_2857":60037,"_25085":60016,"_17521":102951,"_5":17416,"_23752":102898,"_2384":102952},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_2857":60038,"_25085":60016,"_17521":102954,"_5":17416,"_23752":102898,"_2384":100396},[],{"_2857":60039,"_25085":60016,"_17521":102956,"_5":17416,"_23752":102898,"_2384":102957},[],"Sujeto, SAN, usos y fechas adecuados.",{"_2857":60040,"_25085":60016,"_17521":102959,"_5":17416,"_23752":102898,"_2384":102960},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_2857":60041,"_25085":60016,"_17521":102962,"_5":17416,"_23752":102898,"_2384":102963},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_2857":60042,"_25085":60016,"_17521":102965,"_5":17416,"_23752":102898,"_2384":102966},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_2857":60043,"_25085":60016,"_17521":102968,"_5":17416,"_23752":102902,"_2384":102969},[],"Revisa cada frontera por separado:",{"_2857":60044,"_25085":60016,"_17521":102971,"_5":17416,"_23752":102902,"_2384":102972},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_2857":60045,"_25085":60016,"_17521":102974,"_5":17416,"_23752":102902,"_2384":102975},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_2857":60046,"_25085":60016,"_17521":102977,"_5":17416,"_23752":102902,"_2384":102978},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_2857":60047,"_25085":60016,"_17521":102980,"_5":17416,"_23752":102902,"_2384":102981},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_2857":60048,"_25085":60016,"_17521":102983,"_5":17416,"_23752":102902,"_2384":102984},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_2857":60049,"_25085":60016,"_17521":102986,"_5":17416,"_23752":102902,"_2384":102987},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_2857":60050,"_25085":60016,"_17521":102989,"_5":17416,"_23752":102906,"_2384":102990},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_2857":60051,"_25085":60016,"_17521":102992,"_5":17416,"_23752":102906,"_2384":102993},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_48200":102995,"_48202":102996,"_48204":102997,"_48206":102998,"_15216":2406,"_57681":2406},"spanish",[2384,25085,5,23752],{"_2384":20906,"_25085":20906,"_5":20906,"_23752":20906},{"_2384":102999,"_25085":105366,"_5":107733,"_23752":110100},{"_3829":103000,"_48210":103001,"_5":20906},{"_12030":7074,"_12373":4986