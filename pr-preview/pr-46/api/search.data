place#configure-the-instance","Configure the instance",{"_3323":21,"_29044":15,"_5":29385,"_20168":47323,"_26439":47324,"_2811":47325},[],"/docs/pr-preview/pr-46/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3323":22,"_29044":15,"_5":29385,"_20168":47327,"_26439":47328,"_2811":47329},[],"/docs/pr-preview/pr-46/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3323":23,"_29044":15,"_5":29385,"_20168":47331,"_26439":47332,"_2811":47333},[],"/docs/pr-preview/pr-46/deployment/aws-marketplace#next-step","Next step",{"_3323":24,"_29044":15,"_20168":47335,"_5":13790,"_26439":15,"_2811":47336},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3323":25,"_29044":15,"_20168":47338,"_5":13790,"_26439":47308,"_2811":47339},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3323":26,"_29044":15,"_20168":47341,"_5":13790,"_26439":47308,"_2811":47342},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3323":27,"_29044":15,"_20168":47344,"_5":13790,"_26439":47308,"_2811":47345},[],"A security group allowing the necessary endpoints.",{"_3323":28,"_29044":15,"_20168":47347,"_5":13790,"_26439":47312,"_2811":47348},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3323":29,"_29044":15,"_20168":47350,"_5":13790,"_26439":47312,"_2811":47351},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3323":30,"_29044":15,"_20168":47353,"_5":13790,"_26439":47312,"_2811":47354},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3323":31,"_29044":15,"_20168":47356,"_5":13790,"_26439":47316,"_2811":47357},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3323":32,"_29044":15,"_20168":47359,"_5":13790,"_26439":47320,"_2811":47360},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3323":33,"_29044":15,"_20168":47362,"_5":13790,"_26439":47324,"_2811":47363},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3323":34,"_29044":15,"_20168":47365,"_5":13790,"_26439":47328,"_2811":47366},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3323":35,"_29044":15,"_20168":47368,"_5":13790,"_26439":47332,"_2811":47369},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3323":36,"_29044":36,"_5":14148,"_2811":47371,"_29388":47372,"_20168":47373,"_26439":36},"Deploy Lamassu",[47299,47300],[],{"_3323":37,"_29044":36,"_20168":47375,"_5":13790,"_26439":36,"_2811":47376},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3323":38,"_29044":36,"_5":29385,"_20168":47378,"_26439":47379,"_2811":47380},[],"/docs/pr-preview/pr-46/deployment/overview#choose-a-model","Choose a model",{"_3323":39,"_29044":36,"_5":29385,"_20168":47382,"_26439":47383,"_2811":47384},[],"/docs/pr-preview/pr-46/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3323":40,"_29044":36,"_5":29385,"_20168":47386,"_26439":47387,"_2811":47388},[],"/docs/pr-preview/pr-46/deployment/overview#after-deployment","After deployment",{"_3323":41,"_29044":36,"_20168":47390,"_5":13790,"_26439":36,"_2811":47391},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3323":42,"_29044":36,"_20168":47393,"_5":13790,"_26439":47379,"_2811":47394},[],"Model",{"_3323":43,"_29044":36,"_20168":47396,"_5":13790,"_26439":47379,"_2811":47397},[],"Recommended for",{"_3323":44,"_29044":36,"_20168":47399,"_5":13790,"_26439":47379,"_2811":47400},[],"Who operates the infrastructure",{"_3323":45,"_29044":36,"_20168":47402,"_5":13790,"_26439":47379,"_2811":47403},[],"Starting point",{"_3323":46,"_29044":36,"_20168":47405,"_5":13790,"_26439":47379,"_2811":47406},[],"Kubernetes self-managed",{"_3323":47,"_29044":36,"_20168":47408,"_5":13790,"_26439":47379,"_2811":47409},[],"Production, regulated environments and custom deployments",{"_3323":48,"_29044":36,"_20168":47411,"_5":13790,"_26439":47379,"_2811":47412},[],"Your team",{"_3323":49,"_29044":36,"_20168":47414,"_5":13790,"_26439":47379,"_2811":47415},[],"Helm or Fastlane",{"_3323":50,"_29044":36,"_20168":47417,"_5":13790,"_26439":47379,"_2811":47418},[],"AWS Marketplace",{"_3323":51,"_29044":36,"_20168":47420,"_5":13790,"_26439":47379,"_2811":47421},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3323":52,"_29044":36,"_20168":47423,"_5":13790,"_26439":47379,"_2811":47412},[],{"_3323":53,"_29044":36,"_20168":47425,"_5":13790,"_26439":47379,"_2811":47426},[],"Preconfigured image on EC2",{"_3323":54,"_29044":36,"_20168":47428,"_5":13790,"_26439":47379,"_2811":47429},[],"SaaS",{"_3323":55,"_29044":36,"_20168":47431,"_5":13790,"_26439":47379,"_2811":47432},[],"Teams that want to use the platform without operating it",{"_3323":56,"_29044":36,"_20168":47434,"_5":13790,"_26439":47379,"_2811":47435},[],"Lamassu",{"_3323":57,"_29044":36,"_20168":47437,"_5":13790,"_26439":47379,"_2811":47438},[],"Managed subscription",{"_3323":58,"_29044":36,"_20168":47440,"_5":13790,"_26439":47379,"_2811":47441},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3323":59,"_29044":36,"_20168":47443,"_5":13790,"_26439":47379,"_2811":47444},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3323":60,"_29044":36,"_20168":47446,"_5":13790,"_26439":47379,"_2811":47447},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3323":61,"_29044":36,"_20168":47449,"_5":13790,"_26439":47383,"_2811":47450},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3323":62,"_29044":36,"_20168":47452,"_5":13790,"_26439":47387,"_2811":47453},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3323":63,"_29044":63,"_5":14148,"_2811":47455,"_29388":47456,"_20168":47457,"_26439":63},"Use Lamassu as SaaS",[47299,47300,47301],[],{"_3323":64,"_29044":63,"_20168":47459,"_5":13790,"_26439":63,"_2811":47460},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3323":65,"_29044":63,"_5":29385,"_20168":47462,"_26439":47463,"_2811":47464},[],"/docs/pr-preview/pr-46/deployment/saas#what-the-service-manages","What the service manages",{"_3323":66,"_29044":63,"_5":29385,"_20168":47466,"_26439":47467,"_2811":47468},[],"/docs/pr-preview/pr-46/deployment/saas#plans","Plans",{"_3323":67,"_29044":63,"_5":29385,"_20168":47470,"_26439":47471,"_2811":47472},[],"/docs/pr-preview/pr-46/deployment/saas#request-access","Request access",{"_3323":68,"_29044":63,"_20168":47474,"_5":13790,"_26439":63,"_2811":47475},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3323":69,"_29044":63,"_20168":47477,"_5":13790,"_26439":47463,"_2811":47478},[],"Platform availability and maintenance.",{"_3323":70,"_29044":63,"_20168":47480,"_5":13790,"_26439":47463,"_2811":47481},[],"Automatic backups.",{"_3323":71,"_29044":63,"_20168":47483,"_5":13790,"_26439":47463,"_2811":47484},[],"Version upgrades.",{"_3323":72,"_29044":63,"_20168":47486,"_5":13790,"_26439":47463,"_2811":47487},[],"Technical support and SLA according to your plan.",{"_3323":73,"_29044":63,"_20168":47489,"_5":13790,"_26439":47467,"_2811":47490},[],"Plan",{"_3323":74,"_29044":63,"_20168":47492,"_5":13790,"_26439":47467,"_2811":47493},[],"Devices",{"_3323":75,"_29044":63,"_20168":47495,"_5":13790,"_26439":47467,"_2811":47496},[],"Support",{"_3323":76,"_29044":63,"_20168":47498,"_5":13790,"_26439":47467,"_2811":47499},[],"SLA",{"_3323":77,"_29044":63,"_20168":47501,"_5":13790,"_26439":47467,"_2811":47502},[],"Starter",{"_3323":78,"_29044":63,"_20168":47504,"_5":13790,"_26439":47467,"_2811":47505},[],"Up to 1,000",{"_3323":79,"_29044":63,"_20168":47507,"_5":13790,"_26439":47467,"_2811":47508},[],"Email",{"_3323":80,"_29044":63,"_20168":47510,"_5":13790,"_26439":47467,"_2811":47511},[],"99.5 %",{"_3323":81,"_29044":63,"_20168":47513,"_5":13790,"_26439":47467,"_2811":47514},[],"Professional",{"_3323":82,"_29044":63,"_20168":47516,"_5":13790,"_26439":47467,"_2811":47517},[],"Up to 10,000",{"_3323":83,"_29044":63,"_20168":47519,"_5":13790,"_26439":47467,"_2811":47520},[],"Email and chat",{"_3323":84,"_29044":63,"_20168":47522,"_5":13790,"_26439":47467,"_2811":47523},[],"99.9 %",{"_3323":85,"_29044":63,"_20168":47525,"_5":13790,"_26439":47467,"_2811":47526},[],"Enterprise",{"_3323":86,"_29044":63,"_20168":47528,"_5":13790,"_26439":47467,"_2811":47529},[],"Unlimited",{"_3323":87,"_29044":63,"_20168":47531,"_5":13790,"_26439":47467,"_2811":47532},[],"Dedicated",{"_3323":88,"_29044":63,"_20168":47534,"_5":13790,"_26439":47467,"_2811":47535},[],"99.99 %",{"_3323":89,"_29044":63,"_20168":47537,"_5":13790,"_26439":47471,"_2811":47538},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3323":90,"_29044":63,"_20168":47540,"_5":13790,"_26439":47471,"_2811":47541},[],"When you receive your instance's credentials, continue with Get started.",{"_3323":91,"_29044":91,"_5":14148,"_2811":47543,"_29388":47544,"_20168":47545,"_26439":91},"Fastlane",[47299,47300,47406],[],{"_3323":92,"_29044":91,"_20168":47547,"_5":13790,"_26439":91,"_2811":47548},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3323":93,"_29044":91,"_5":29385,"_20168":47550,"_26439":47551,"_2811":47552},[],"/docs/pr-preview/pr-46/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3323":94,"_29044":91,"_5":29385,"_20168":47554,"_26439":47555,"_2811":47556},[],"/docs/pr-preview/pr-46/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3323":95,"_29044":91,"_5":29385,"_20168":47558,"_26439":47559,"_2811":47309},[],"/docs/pr-preview/pr-46/deployment/self-hosted/fastlane#before-you-begin",{"_3323":96,"_29044":91,"_5":29385,"_20168":47561,"_26439":47562,"_2811":47563},[],"/docs/pr-preview/pr-46/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3323":97,"_29044":91,"_5":29385,"_20168":47565,"_26439":47566,"_2811":47567},[],"/docs/pr-preview/pr-46/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3323":98,"_29044":91,"_5":29385,"_20168":47569,"_26439":47570,"_2811":47571},[],"/docs/pr-preview/pr-46/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3323":99,"_29044":91,"_5":29385,"_20168":47573,"_26439":47574,"_2811":47575},[],"/docs/pr-preview/pr-46/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3323":100,"_29044":91,"_5":29385,"_20168":47577,"_26439":47578,"_2811":47579},[],"/docs/pr-preview/pr-46/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3323":101,"_29044":91,"_5":29385,"_20168":47581,"_26439":47582,"_2811":47583},[],"/docs/pr-preview/pr-46/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3323":102,"_29044":91,"_5":29385,"_20168":47585,"_26439":47586,"_2811":47587},[],"/docs/pr-preview/pr-46/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3323":103,"_29044":91,"_5":29385,"_20168":47589,"_26439":47590,"_2811":47591},[],"/docs/pr-preview/pr-46/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3323":104,"_29044":91,"_20168":47593,"_5":13790,"_26439":47551,"_2811":47594},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3323":105,"_29044":91,"_20168":47596,"_5":13790,"_26439":47551,"_2811":47597},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3323":106,"_29044":91,"_20168":47599,"_5":13790,"_26439":47555,"_2811":47600},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3323":107,"_29044":91,"_20168":47602,"_5":13790,"_26439":47555,"_2811":47603},[],"Fastlane installs or configures",{"_3323":108,"_29044":91,"_20168":47605,"_5":13790,"_26439":47555,"_2811":47606},[],"You still provide",{"_3323":109,"_29044":91,"_20168":47608,"_5":13790,"_26439":47555,"_2811":47609},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3323":110,"_29044":91,"_20168":47611,"_5":13790,"_26439":47555,"_2811":47612},[],"The Kubernetes cluster, nodes and persistent storage",{"_3323":111,"_29044":91,"_20168":47614,"_5":13790,"_26439":47555,"_2811":47615},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3323":112,"_29044":91,"_20168":47617,"_5":13790,"_26439":47555,"_2811":47618},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3323":113,"_29044":91,"_20168":47620,"_5":13790,"_26439":47555,"_2811":47621},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3323":114,"_29044":91,"_20168":47623,"_5":13790,"_26439":47555,"_2811":47624},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3323":115,"_29044":91,"_20168":47626,"_5":13790,"_26439":47555,"_2811":47627},[],"Optional observability and lab HSM components",{"_3323":116,"_29044":91,"_20168":47629,"_5":13790,"_26439":47555,"_2811":47630},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3323":117,"_29044":91,"_20168":47632,"_5":13790,"_26439":47555,"_2811":47633},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3323":118,"_29044":91,"_20168":47635,"_5":13790,"_26439":47559,"_2811":47636},[],"You need:",{"_3323":119,"_29044":91,"_20168":47638,"_5":13790,"_26439":47559,"_2811":47639},[],"an existing Kubernetes cluster",{"_3323":120,"_29044":91,"_20168":47641,"_5":13790,"_26439":47559,"_2811":47642},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3323":121,"_29044":91,"_20168":47644,"_5":13790,"_26439":47559,"_2811":47645},[],"`yq`",{"_3323":122,"_29044":91,"_20168":47647,"_5":13790,"_26439":47559,"_2811":22817},[],{"_3323":123,"_29044":91,"_20168":47649,"_5":13790,"_26439":47559,"_2811":47650},[],"`jq` only when using `--sample-data` or `--development`",{"_3323":124,"_29044":91,"_20168":47652,"_5":13790,"_26439":47559,"_2811":47653},[],"`ssh-keygen` only when using `--with-hsm`",{"_3323":125,"_29044":91,"_20168":47655,"_5":13790,"_26439":47559,"_2811":47656},[],"free external ports 80 and 443 on a single-node K3s host",{"_3323":126,"_29044":91,"_20168":47658,"_5":13790,"_26439":47559,"_2811":47659},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3323":127,"_29044":91,"_20168":47661,"_5":13790,"_26439":47559,"_2811":47662},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3323":128,"_29044":91,"_20168":47664,"_5":13790,"_26439":47562,"_2811":47665},[],"Run the script from a clone of the Helm repository:",{"_3323":129,"_29044":91,"_20168":47667,"_5":13790,"_26439":47562,"_2811":47668},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3323":130,"_29044":91,"_20168":47670,"_5":13790,"_26439":47566,"_2811":47671},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3323":131,"_29044":91,"_20168":47673,"_5":13790,"_26439":47566,"_2811":47674},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3323":132,"_29044":91,"_20168":47676,"_5":13790,"_26439":47566,"_2811":47677},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3323":133,"_29044":91,"_20168":47679,"_5":13790,"_26439":47566,"_2811":47680},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3323":134,"_29044":91,"_20168":47682,"_5":13790,"_26439":47570,"_2811":47683},[],"Option",{"_3323":135,"_29044":91,"_20168":47685,"_5":13790,"_26439":47570,"_2811":47686},[],"Default",{"_3323":136,"_29044":91,"_20168":47688,"_5":13790,"_26439":47570,"_2811":47689},[],"Purpose",{"_3323":137,"_29044":91,"_20168":47691,"_5":13790,"_26439":47570,"_2811":47692},[],"`-h`, `--help`",{"_3323":138,"_29044":91,"_20168":47694,"_5":13790,"_26439":47570,"_2811":47695},[],"—",{"_3323":139,"_29044":91,"_20168":47697,"_5":13790,"_26439":47570,"_2811":47698},[],"Show help",{"_3323":140,"_29044":91,"_20168":47700,"_5":13790,"_26439":47570,"_2811":47701},[],"`-c`, `--context`",{"_3323":141,"_29044":91,"_20168":47703,"_5":13790,"_26439":47570,"_2811":47704},[],"current context",{"_3323":142,"_29044":91,"_20168":47706,"_5":13790,"_26439":47570,"_2811":47707},[],"Select the kubeconfig context for kubectl and Helm",{"_3323":143,"_29044":91,"_20168":47709,"_5":13790,"_26439":47570,"_2811":47710},[],"`-n`, `--non-interactive`",{"_3323":144,"_29044":91,"_20168":47712,"_5":13790,"_26439":47570,"_2811":6229},[],{"_3323":145,"_29044":91,"_20168":47714,"_5":13790,"_26439":47570,"_2811":47715},[],"Skip prompts and generate dependency credentials",{"_3323":146,"_29044":91,"_20168":47717,"_5":13790,"_26439":47570,"_2811":47718},[],"`-ns`, `--namespace`",{"_3323":147,"_29044":91,"_20168":47720,"_5":13790,"_26439":47570,"_2811":47721},[],"`lamassu-dev`",{"_3323":148,"_29044":91,"_20168":47723,"_5":13790,"_26439":47570,"_2811":47724},[],"Namespace for the installation",{"_3323":149,"_29044":91,"_20168":47726,"_5":13790,"_26439":47570,"_2811":47727},[],"`-d`, `--domain`",{"_3323":150,"_29044":91,"_20168":47729,"_5":13790,"_26439":47570,"_2811":47730},[],"`dev.lamassu.io`",{"_3323":151,"_29044":91,"_20168":47732,"_5":13790,"_26439":47570,"_2811":47733},[],"Domain used by the UI, OIDC and certificate",{"_3323":152,"_29044":91,"_20168":47735,"_5":13790,"_26439":47570,"_2811":47736},[],"`-v`, `--version`",{"_3323":153,"_29044":91,"_20168":47738,"_5":13790,"_26439":47570,"_2811":14449},[],{"_3323":154,"_29044":91,"_20168":47740,"_5":13790,"_26439":47570,"_2811":47741},[],"Lamassu chart version",{"_3323":155,"_29044":91,"_20168":47743,"_5":13790,"_26439":47570,"_2811":47744},[],"`--https-port`",{"_3323":156,"_29044":91,"_20168":47746,"_5":13790,"_26439":47570,"_2811":47747},[],"`443`",{"_3323":157,"_29044":91,"_20168":47749,"_5":13790,"_26439":47570,"_2811":47750},[],"Gateway HTTPS listener port",{"_3323":158,"_29044":91,"_20168":47752,"_5":13790,"_26439":47570,"_2811":47753},[],"`--http-port`",{"_3323":159,"_29044":91,"_20168":47755,"_5":13790,"_26439":47570,"_2811":47756},[],"`80`",{"_3323":160,"_29044":91,"_20168":47758,"_5":13790,"_26439":47570,"_2811":47759},[],"Gateway HTTP listener port",{"_3323":161,"_29044":91,"_20168":47761,"_5":13790,"_26439":47570,"_2811":47762},[],"`--tls-crt`",{"_3323":162,"_29044":91,"_20168":47764,"_5":13790,"_26439":47570,"_2811":47695},[],{"_3323":163,"_29044":91,"_20168":47766,"_5":13790,"_26439":47570,"_2811":47767},[],"PEM certificate for downstream TLS",{"_3323":164,"_29044":91,"_20168":47769,"_5":13790,"_26439":47570,"_2811":47770},[],"`--tls-key`",{"_3323":165,"_29044":91,"_20168":47772,"_5":13790,"_26439":47570,"_2811":47695},[],{"_3323":166,"_29044":91,"_20168":47774,"_5":13790,"_26439":47570,"_2811":47775},[],"PEM private key for downstream TLS",{"_3323":167,"_29044":91,"_20168":47777,"_5":13790,"_26439":47570,"_2811":47778},[],"`-l`, `--local-chart-path`",{"_3323":168,"_29044":91,"_20168":47780,"_5":13790,"_26439":47570,"_2811":47781},[],"repository chart",{"_3323":169,"_29044":91,"_20168":47783,"_5":13790,"_26439":47570,"_2811":47784},[],"Use an unpacked local Lamassu chart",{"_3323":170,"_29044":91,"_20168":47786,"_5":13790,"_26439":47570,"_2811":47787},[],"`-ip`, `--gateway-ip`",{"_3323":171,"_29044":91,"_20168":47789,"_5":13790,"_26439":47570,"_2811":8368},[],{"_3323":172,"_29044":91,"_20168":47791,"_5":13790,"_26439":47570,"_2811":47792},[],"Override the address written to `gateway.addresses`",{"_3323":173,"_29044":91,"_20168":47794,"_5":13790,"_26439":47570,"_2811":47795},[],"`--otel`",{"_3323":174,"_29044":91,"_20168":47797,"_5":13790,"_26439":47570,"_2811":6229},[],{"_3323":175,"_29044":91,"_20168":47799,"_5":13790,"_26439":47570,"_2811":47800},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3323":176,"_29044":91,"_20168":47802,"_5":13790,"_26439":47570,"_2811":47803},[],"`--development`",{"_3323":177,"_29044":91,"_20168":47805,"_5":13790,"_26439":47570,"_2811":6229},[],{"_3323":178,"_29044":91,"_20168":47807,"_5":13790,"_26439":47570,"_2811":47808},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3323":179,"_29044":91,"_20168":47810,"_5":13790,"_26439":47570,"_2811":47811},[],"`--sample-data`",{"_3323":180,"_29044":91,"_20168":47813,"_5":13790,"_26439":47570,"_2811":6229},[],{"_3323":181,"_29044":91,"_20168":47815,"_5":13790,"_26439":47570,"_2811":47816},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3323":182,"_29044":91,"_20168":47818,"_5":13790,"_26439":47570,"_2811":47819},[],"`--with-hsm`",{"_3323":183,"_29044":91,"_20168":47821,"_5":13790,"_26439":47570,"_2811":6229},[],{"_3323":184,"_29044":91,"_20168":47823,"_5":13790,"_26439":47570,"_2811":47824},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3323":185,"_29044":91,"_20168":47826,"_5":13790,"_26439":47570,"_2811":47827},[],"`--softhsm-chart-path`",{"_3323":186,"_29044":91,"_20168":47829,"_5":13790,"_26439":47570,"_2811":47830},[],"`./charts/softhsm`",{"_3323":187,"_29044":91,"_20168":47832,"_5":13790,"_26439":47570,"_2811":47833},[],"Use a different local SoftHSM chart",{"_3323":188,"_29044":91,"_20168":47835,"_5":13790,"_26439":47570,"_2811":47836},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3323":189,"_29044":91,"_20168":47838,"_5":13790,"_26439":47574,"_2811":47839},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3323":190,"_29044":91,"_20168":47841,"_5":13790,"_26439":47574,"_2811":47842},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3323":191,"_29044":91,"_20168":47844,"_5":13790,"_26439":47574,"_2811":47845},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3323":192,"_29044":91,"_20168":47847,"_5":13790,"_26439":47574,"_2811":47848},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3323":193,"_29044":91,"_20168":47850,"_5":13790,"_26439":47574,"_2811":47851},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3323":194,"_29044":91,"_20168":47853,"_5":13790,"_26439":47574,"_2811":47854},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3323":195,"_29044":91,"_20168":47856,"_5":13790,"_26439":47578,"_2811":47857},[],"Fastlane:",{"_3323":196,"_29044":91,"_20168":47859,"_5":13790,"_26439":47578,"_2811":47860},[],"validates local tools and the selected cluster",{"_3323":197,"_29044":91,"_20168":47862,"_5":13790,"_26439":47578,"_2811":47863},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3323":198,"_29044":91,"_20168":47865,"_5":13790,"_26439":47578,"_2811":47866},[],"creates the namespace",{"_3323":199,"_29044":91,"_20168":47868,"_5":13790,"_26439":47578,"_2811":47869},[],"installs PostgreSQL and creates the required databases",{"_3323":200,"_29044":91,"_20168":47871,"_5":13790,"_26439":47578,"_2811":47872},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3323":201,"_29044":91,"_20168":47874,"_5":13790,"_26439":47578,"_2811":47875},[],"installs RabbitMQ",{"_3323":202,"_29044":91,"_20168":47877,"_5":13790,"_26439":47578,"_2811":47878},[],"optionally installs observability and lab HSM components",{"_3323":203,"_29044":91,"_20168":47880,"_5":13790,"_26439":47578,"_2811":47881},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3323":204,"_29044":91,"_20168":47883,"_5":13790,"_26439":47578,"_2811":47884},[],"optionally loads sample data",{"_3323":205,"_29044":91,"_20168":47886,"_5":13790,"_26439":47578,"_2811":47887},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3323":206,"_29044":91,"_20168":47889,"_5":13790,"_26439":47582,"_2811":47890},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3323":207,"_29044":91,"_20168":47892,"_5":13790,"_26439":47582,"_2811":47893},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3323":208,"_29044":91,"_20168":47895,"_5":13790,"_26439":47586,"_2811":47896},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3323":209,"_29044":91,"_20168":47898,"_5":13790,"_26439":47586,"_2811":47899},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3323":210,"_29044":91,"_20168":47901,"_5":13790,"_26439":47586,"_2811":47902},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3323":211,"_29044":91,"_20168":47904,"_5":13790,"_26439":47590,"_2811":47905},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3323":212,"_29044":212,"_5":14148,"_2811":47907,"_29388":47908,"_20168":47909,"_26439":212},"Install with Helm",[47299,47300,47406],[],{"_3323":213,"_29044":212,"_20168":47911,"_5":13790,"_26439":212,"_2811":47912},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3323":214,"_29044":212,"_5":29385,"_20168":47914,"_26439":47915,"_2811":47916},[],"/docs/pr-preview/pr-46/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3323":215,"_29044":212,"_5":29385,"_20168":47918,"_26439":47919,"_2811":47309},[],"/docs/pr-preview/pr-46/deployment/self-hosted/helm#before-you-begin",{"_3323":216,"_29044":212,"_5":29385,"_20168":47921,"_26439":47922,"_2811":47923},[],"/docs/pr-preview/pr-46/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3323":217,"_29044":212,"_5":29385,"_20168":47925,"_26439":47926,"_2811":47927},[],"/docs/pr-preview/pr-46/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3323":218,"_29044":212,"_5":29385,"_20168":47929,"_26439":47930,"_2811":47931},[],"/docs/pr-preview/pr-46/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3323":219,"_29044":212,"_5":29385,"_20168":47933,"_26439":47934,"_2811":47935},[],"/docs/pr-preview/pr-46/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3323":220,"_29044":212,"_5":29385,"_20168":47937,"_26439":47938,"_2811":47939},[],"/docs/pr-preview/pr-46/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3323":221,"_29044":212,"_5":29385,"_20168":47941,"_26439":47942,"_2811":47943},[],"/docs/pr-preview/pr-46/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3323":222,"_29044":212,"_5":29385,"_20168":47945,"_26439":47946,"_2811":47947},[],"/docs/pr-preview/pr-46/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3323":223,"_29044":212,"_5":29385,"_20168":47949,"_26439":47950,"_2811":47951},[],"/docs/pr-preview/pr-46/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3323":224,"_29044":212,"_20168":47953,"_5":13790,"_26439":47915,"_2811":47954},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3323":225,"_29044":212,"_20168":47956,"_5":13790,"_26439":47919,"_2811":47957},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3323":226,"_29044":212,"_20168":47959,"_5":13790,"_26439":47919,"_2811":47960},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3323":227,"_29044":212,"_20168":47962,"_5":13790,"_26439":47919,"_2811":47963},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3323":228,"_29044":212,"_20168":47965,"_5":13790,"_26439":47919,"_2811":47966},[],"a reachable RabbitMQ broker and credentials",{"_3323":229,"_29044":212,"_20168":47968,"_5":13790,"_26439":47919,"_2811":47969},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3323":230,"_29044":212,"_20168":47971,"_5":13790,"_26439":47919,"_2811":47972},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3323":231,"_29044":212,"_20168":47974,"_5":13790,"_26439":47919,"_2811":47975},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3323":232,"_29044":212,"_20168":47977,"_5":13790,"_26439":47919,"_2811":47978},[],"a StorageClass and an external traffic design",{"_3323":233,"_29044":212,"_20168":47980,"_5":13790,"_26439":47919,"_2811":47981},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3323":234,"_29044":212,"_20168":47983,"_5":13790,"_26439":47919,"_2811":47984},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3323":235,"_29044":212,"_20168":47986,"_5":13790,"_26439":47919,"_2811":47987},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3323":236,"_29044":212,"_20168":47989,"_5":13790,"_26439":47922,"_2811":47990},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3323":237,"_29044":212,"_20168":47992,"_5":13790,"_26439":47922,"_2811":47993},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3323":238,"_29044":212,"_20168":47995,"_5":13790,"_26439":47922,"_2811":47996},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3323":239,"_29044":212,"_20168":47998,"_5":13790,"_26439":47926,"_2811":47999},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3323":240,"_29044":212,"_20168":48001,"_5":13790,"_26439":47926,"_2811":48002},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3323":241,"_29044":212,"_20168":48004,"_5":13790,"_26439":47926,"_2811":48005},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3323":242,"_29044":212,"_20168":48007,"_5":13790,"_26439":47926,"_2811":48008},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3323":243,"_29044":212,"_20168":48010,"_5":13790,"_26439":47930,"_2811":48011},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3323":244,"_29044":212,"_20168":48013,"_5":13790,"_26439":47934,"_2811":48014},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3323":245,"_29044":212,"_20168":48016,"_5":13790,"_26439":47934,"_2811":48017},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3323":246,"_29044":212,"_20168":48019,"_5":13790,"_26439":47934,"_2811":48020},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3323":247,"_29044":212,"_20168":48022,"_5":13790,"_26439":47934,"_2811":48023},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3323":248,"_29044":212,"_20168":48025,"_5":13790,"_26439":47934,"_2811":48026},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3323":249,"_29044":212,"_20168":48028,"_5":13790,"_26439":47934,"_2811":48029},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3323":250,"_29044":212,"_20168":48031,"_5":13790,"_26439":47934,"_2811":48032},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3323":251,"_29044":212,"_20168":48034,"_5":13790,"_26439":47938,"_2811":48035},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3323":252,"_29044":212,"_20168":48037,"_5":13790,"_26439":47938,"_2811":48038},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3323":253,"_29044":212,"_20168":48040,"_5":13790,"_26439":47938,"_2811":48041},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3323":254,"_29044":212,"_20168":48043,"_5":13790,"_26439":47938,"_2811":48044},[],"See Access control for the principal and policy model.",{"_3323":255,"_29044":212,"_20168":48046,"_5":13790,"_26439":47942,"_2811":48047},[],"To install a local checkout instead:",{"_3323":256,"_29044":212,"_20168":48049,"_5":13790,"_26439":47946,"_2811":48050},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3323":257,"_29044":212,"_20168":48052,"_5":13790,"_26439":47946,"_2811":48053},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3323":258,"_29044":212,"_20168":48055,"_5":13790,"_26439":47950,"_2811":48056},[],"Before going live, review:",{"_3323":259,"_29044":212,"_20168":48058,"_5":13790,"_26439":47950,"_2811":48059},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3323":260,"_29044":212,"_20168":48061,"_5":13790,"_26439":47950,"_2811":48062},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3323":261,"_29044":212,"_20168":48064,"_5":13790,"_26439":47950,"_2811":48065},[],"shared VA storage before increasing VA replicas",{"_3323":262,"_29044":212,"_20168":48067,"_5":13790,"_26439":47950,"_2811":48068},[],"managed OIDC roles and removal of evaluation credentials",{"_3323":263,"_29044":212,"_20168":48070,"_5":13790,"_26439":47950,"_2811":48071},[],"a trusted TLS issuer or externally managed certificate",{"_3323":264,"_29044":212,"_20168":48073,"_5":13790,"_26439":47950,"_2811":48074},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3323":265,"_29044":212,"_20168":48076,"_5":13790,"_26439":47950,"_2811":48077},[],"SMTP, observability and alert delivery",{"_3323":266,"_29044":212,"_20168":48079,"_5":13790,"_26439":47950,"_2811":48080},[],"the version upgrade guides and the notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_3323":267,"_29044":212,"_20168":48082,"_5":13790,"_26439":47950,"_2811":48083},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3323":268,"_29044":268,"_5":14148,"_2811":48085,"_29388":48086,"_20168":48087,"_26439":268},"Expose the Gateway",[47299,47300,47406],[],{"_3323":269,"_29044":268,"_20168":48089,"_5":13790,"_26439":268,"_2811":48090},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3323":270,"_29044":268,"_5":29385,"_20168":48092,"_26439":48093,"_2811":48094},[],"/docs/pr-preview/pr-46/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3323":271,"_29044":268,"_5":29385,"_20168":48096,"_26439":48097,"_2811":48098},[],"/docs/pr-preview/pr-46/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3323":272,"_29044":268,"_5":29385,"_20168":48100,"_26439":48101,"_2811":48102},[],"/docs/pr-preview/pr-46/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3323":273,"_29044":268,"_5":29385,"_20168":48104,"_26439":48105,"_2811":48106},[],"/docs/pr-preview/pr-46/deployment/self-hosted/networking#k3s","K3s",{"_3323":274,"_29044":268,"_5":29385,"_20168":48108,"_26439":48109,"_2811":48110},[],"/docs/pr-preview/pr-46/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3323":275,"_29044":268,"_5":29385,"_20168":48112,"_26439":48113,"_2811":48114},[],"/docs/pr-preview/pr-46/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3323":276,"_29044":268,"_5":29385,"_20168":48116,"_26439":48117,"_2811":48118},[],"/docs/pr-preview/pr-46/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3323":277,"_29044":268,"_5":29385,"_20168":48120,"_26439":48121,"_2811":48122},[],"/docs/pr-preview/pr-46/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3323":278,"_29044":268,"_5":29385,"_20168":48124,"_26439":48125,"_2811":48126},[],"/docs/pr-preview/pr-46/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3323":279,"_29044":268,"_5":29385,"_20168":48128,"_26439":48129,"_2811":48130},[],"/docs/pr-preview/pr-46/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3323":280,"_29044":268,"_20168":48132,"_5":13790,"_26439":48093,"_2811":48133},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3323":281,"_29044":268,"_20168":48135,"_5":13790,"_26439":48093,"_2811":48136},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3323":282,"_29044":268,"_20168":48138,"_5":13790,"_26439":48097,"_2811":48139},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3323":283,"_29044":268,"_20168":48141,"_5":13790,"_26439":48097,"_2811":48142},[],"Set it only when:",{"_3323":284,"_29044":268,"_20168":48144,"_5":13790,"_26439":48097,"_2811":48145},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3323":285,"_29044":268,"_20168":48147,"_5":13790,"_26439":48097,"_2811":48148},[],"that address is allocated to this Gateway",{"_3323":286,"_29044":268,"_20168":48150,"_5":13790,"_26439":48097,"_2811":48151},[],"the surrounding network already routes traffic for it to the cluster",{"_3323":287,"_29044":268,"_20168":48153,"_5":13790,"_26439":48097,"_2811":48154},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3323":288,"_29044":268,"_20168":48156,"_5":13790,"_26439":48097,"_2811":48157},[],"Keep these two settings separate:",{"_3323":289,"_29044":268,"_20168":48159,"_5":13790,"_26439":48097,"_2811":48160},[],"`gateway.addresses` requests an address for the Gateway.",{"_3323":290,"_29044":268,"_20168":48162,"_5":13790,"_26439":48097,"_2811":48163},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3323":291,"_29044":268,"_20168":48165,"_5":13790,"_26439":48097,"_2811":48166},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3323":292,"_29044":268,"_20168":48168,"_5":13790,"_26439":48101,"_2811":48169},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3323":293,"_29044":268,"_20168":48171,"_5":13790,"_26439":48101,"_2811":48172},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3323":294,"_29044":268,"_20168":48174,"_5":13790,"_26439":48105,"_2811":48175},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3323":295,"_29044":268,"_20168":48177,"_5":13790,"_26439":48105,"_2811":48178},[],"For the recommended design:",{"_3323":296,"_29044":268,"_20168":48180,"_5":13790,"_26439":48105,"_2811":48181},[],"Use only one externally exposed Lamassu Gateway.",{"_3323":297,"_29044":268,"_20168":48183,"_5":13790,"_26439":48105,"_2811":48184},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3323":298,"_29044":268,"_20168":48186,"_5":13790,"_26439":48105,"_2811":48187},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3323":299,"_29044":268,"_20168":48189,"_5":13790,"_26439":48105,"_2811":48190},[],"Point DNS at the VM's reachable address.",{"_3323":300,"_29044":268,"_20168":48192,"_5":13790,"_26439":48105,"_2811":48193},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3323":301,"_29044":268,"_20168":48195,"_5":13790,"_26439":48109,"_2811":48196},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3323":302,"_29044":268,"_20168":48198,"_5":13790,"_26439":48113,"_2811":48199},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3323":303,"_29044":268,"_20168":48201,"_5":13790,"_26439":48113,"_2811":48202},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3323":304,"_29044":268,"_20168":48204,"_5":13790,"_26439":48117,"_2811":48205},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3323":305,"_29044":268,"_20168":48207,"_5":13790,"_26439":48117,"_2811":48208},[],"Requirement",{"_3323":306,"_29044":268,"_20168":48210,"_5":13790,"_26439":48117,"_2811":48211},[],"Recommended design",{"_3323":307,"_29044":268,"_20168":48213,"_5":13790,"_26439":48117,"_2811":48214},[],"Consequence",{"_3323":308,"_29044":268,"_20168":48216,"_5":13790,"_26439":48117,"_2811":48217},[],"Several Lamassu URLs or services",{"_3323":309,"_29044":268,"_20168":48219,"_5":13790,"_26439":48117,"_2811":48220},[],"One Gateway with multiple routes",{"_3323":310,"_29044":268,"_20168":48222,"_5":13790,"_26439":48117,"_2811":48223},[],"One IP and one proxy fleet; this is the chart default",{"_3323":311,"_29044":268,"_20168":48225,"_5":13790,"_26439":48117,"_2811":48226},[],"Independent Gateways and separate external IPs",{"_3323":312,"_29044":268,"_20168":48228,"_5":13790,"_26439":48117,"_2811":48229},[],"One VIP per Gateway",{"_3323":313,"_29044":268,"_20168":48231,"_5":13790,"_26439":48117,"_2811":48232},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3323":314,"_29044":268,"_20168":48234,"_5":13790,"_26439":48117,"_2811":48235},[],"Independent Gateways on one node and one IP",{"_3323":315,"_29044":268,"_20168":48237,"_5":13790,"_26439":48117,"_2811":48238},[],"Use different external ports",{"_3323":316,"_29044":268,"_20168":48240,"_5":13790,"_26439":48117,"_2811":48241},[],"Clients must include non-standard ports",{"_3323":317,"_29044":268,"_20168":48243,"_5":13790,"_26439":48117,"_2811":48244},[],"Separate TLS/mTLS termination behind one IP",{"_3323":318,"_29044":268,"_20168":48246,"_5":13790,"_26439":48117,"_2811":48247},[],"Front-door SNI routing to internal Gateways",{"_3323":319,"_29044":268,"_20168":48249,"_5":13790,"_26439":48117,"_2811":48250},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3323":320,"_29044":268,"_20168":48252,"_5":13790,"_26439":48117,"_2811":48253},[],"Separate Gateway resources but shared proxy infrastructure",{"_3323":321,"_29044":268,"_20168":48255,"_5":13790,"_26439":48117,"_2811":48256},[],"Envoy merged-Gateway mode",{"_3323":322,"_29044":268,"_20168":48258,"_5":13790,"_26439":48117,"_2811":48259},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3323":323,"_29044":268,"_20168":48261,"_5":13790,"_26439":48117,"_2811":48262},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3323":324,"_29044":268,"_20168":48264,"_5":13790,"_26439":48117,"_2811":48265},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3323":325,"_29044":268,"_20168":48267,"_5":13790,"_26439":48117,"_2811":48268},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3323":326,"_29044":268,"_20168":48270,"_5":13790,"_26439":48117,"_2811":48271},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3323":327,"_29044":268,"_20168":48273,"_5":13790,"_26439":48121,"_2811":48274},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3323":328,"_29044":268,"_20168":48276,"_5":13790,"_26439":48121,"_2811":48277},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3323":329,"_29044":268,"_20168":48279,"_5":13790,"_26439":48121,"_2811":48280},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3323":330,"_29044":268,"_20168":48282,"_5":13790,"_26439":48121,"_2811":48283},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3323":331,"_29044":268,"_20168":48285,"_5":13790,"_26439":48121,"_2811":48286},[],"If none of those are possible, use different external ports or change the external network design.",{"_3323":332,"_29044":268,"_20168":48288,"_5":13790,"_26439":48125,"_2811":48289},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3323":333,"_29044":268,"_20168":48291,"_5":13790,"_26439":48125,"_2811":48292},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3323":334,"_29044":268,"_20168":48294,"_5":13790,"_26439":48129,"_2811":48295},[],"Check, in order:",{"_3323":335,"_29044":268,"_20168":48297,"_5":13790,"_26439":48129,"_2811":48298},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3323":336,"_29044":268,"_20168":48300,"_5":13790,"_26439":48129,"_2811":48301},[],"Its status contains the expected address.",{"_3323":337,"_29044":268,"_20168":48303,"_5":13790,"_26439":48129,"_2811":48304},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3323":338,"_29044":268,"_20168":48306,"_5":13790,"_26439":48129,"_2811":48307},[],"Port 443 reaches that address from the client network.",{"_3323":339,"_29044":268,"_20168":48309,"_5":13790,"_26439":48129,"_2811":48310},[],"DNS resolves to the externally reachable endpoint.",{"_3323":340,"_29044":268,"_20168":48312,"_5":13790,"_26439":48129,"_2811":48313},[],"The certificate contains the DNS name or IP used by the client.",{"_3323":341,"_29044":268,"_20168":48315,"_5":13790,"_26439":48129,"_2811":48316},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3323":342,"_29044":342,"_5":14148,"_2811":47406,"_29388":48318,"_20168":48319,"_26439":342},[47299,47300,47406],[],{"_3323":343,"_29044":342,"_20168":48321,"_5":13790,"_26439":342,"_2811":48322},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3323":344,"_29044":342,"_5":29385,"_20168":48324,"_26439":48325,"_2811":48326},[],"/docs/pr-preview/pr-46/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3323":345,"_29044":342,"_5":29385,"_20168":48328,"_26439":48329,"_2811":48330},[],"/docs/pr-preview/pr-46/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3323":346,"_29044":342,"_5":29385,"_20168":48332,"_26439":48333,"_2811":48334},[],"/docs/pr-preview/pr-46/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3323":347,"_29044":342,"_5":29385,"_20168":48336,"_26439":48337,"_2811":48338},[],"/docs/pr-preview/pr-46/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3323":348,"_29044":342,"_5":29385,"_20168":48340,"_26439":48341,"_2811":48342},[],"/docs/pr-preview/pr-46/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3323":349,"_29044":342,"_5":29385,"_20168":48344,"_26439":48345,"_2811":48346},[],"/docs/pr-preview/pr-46/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3323":350,"_29044":342,"_20168":48348,"_5":13790,"_26439":48325,"_2811":48349},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3323":351,"_29044":342,"_20168":48351,"_5":13790,"_26439":48329,"_2811":48352},[],"Workflow",{"_3323":352,"_29044":342,"_20168":48354,"_5":13790,"_26439":48329,"_2811":48355},[],"Use it for",{"_3323":353,"_29044":342,"_20168":48357,"_5":13790,"_26439":48329,"_2811":48358},[],"What it installs",{"_3323":354,"_29044":342,"_20168":48360,"_5":13790,"_26439":48329,"_2811":48361},[],"Helm",{"_3323":355,"_29044":342,"_20168":48363,"_5":13790,"_26439":48329,"_2811":48364},[],"Production and controlled environments",{"_3323":356,"_29044":342,"_20168":48366,"_5":13790,"_26439":48329,"_2811":48367},[],"Lamassu services and Gateway API resources",{"_3323":357,"_29044":342,"_20168":48369,"_5":13790,"_26439":48329,"_2811":47543},[],{"_3323":358,"_29044":342,"_20168":48371,"_5":13790,"_26439":48329,"_2811":48372},[],"Evaluation, demos, CI and small lab clusters",{"_3323":359,"_29044":342,"_20168":48374,"_5":13790,"_26439":48329,"_2811":48375},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3323":360,"_29044":342,"_20168":48377,"_5":13790,"_26439":48333,"_2811":48378},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3323":361,"_29044":342,"_20168":48380,"_5":13790,"_26439":48333,"_2811":48381},[],"Area",{"_3323":362,"_29044":342,"_20168":48383,"_5":13790,"_26439":48333,"_2811":48384},[],"The Lamassu chart provides",{"_3323":363,"_29044":342,"_20168":48386,"_5":13790,"_26439":48333,"_2811":48387},[],"You provide",{"_3323":364,"_29044":342,"_20168":48389,"_5":13790,"_26439":48333,"_2811":48390},[],"Lamassu applications",{"_3323":365,"_29044":342,"_20168":48392,"_5":13790,"_26439":48333,"_2811":48393},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3323":366,"_29044":342,"_20168":48395,"_5":13790,"_26439":48333,"_2811":48396},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3323":367,"_29044":342,"_20168":48398,"_5":13790,"_26439":48333,"_2811":48399},[],"PostgreSQL data",{"_3323":368,"_29044":342,"_20168":48401,"_5":13790,"_26439":48333,"_2811":48402},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3323":369,"_29044":342,"_20168":48404,"_5":13790,"_26439":48333,"_2811":48405},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3323":370,"_29044":342,"_20168":48407,"_5":13790,"_26439":48333,"_2811":48408},[],"Messaging",{"_3323":371,"_29044":342,"_20168":48410,"_5":13790,"_26439":48333,"_2811":48411},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3323":372,"_29044":342,"_20168":48413,"_5":13790,"_26439":48333,"_2811":48414},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3323":373,"_29044":342,"_20168":48416,"_5":13790,"_26439":48333,"_2811":48417},[],"Identity",{"_3323":374,"_29044":342,"_20168":48419,"_5":13790,"_26439":48333,"_2811":48420},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3323":375,"_29044":342,"_20168":48422,"_5":13790,"_26439":48333,"_2811":48423},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3323":376,"_29044":342,"_20168":48425,"_5":13790,"_26439":48333,"_2811":48426},[],"External routing",{"_3323":377,"_29044":342,"_20168":48428,"_5":13790,"_26439":48333,"_2811":48429},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3323":378,"_29044":342,"_20168":48431,"_5":13790,"_26439":48333,"_2811":48432},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3323":379,"_29044":342,"_20168":48434,"_5":13790,"_26439":48333,"_2811":48435},[],"TLS",{"_3323":380,"_29044":342,"_20168":48437,"_5":13790,"_26439":48333,"_2811":48438},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3323":381,"_29044":342,"_20168":48440,"_5":13790,"_26439":48333,"_2811":48441},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3323":382,"_29044":342,"_20168":48443,"_5":13790,"_26439":48333,"_2811":48444},[],"Persistent application data",{"_3323":383,"_29044":342,"_20168":48446,"_5":13790,"_26439":48333,"_2811":48447},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3323":384,"_29044":342,"_20168":48449,"_5":13790,"_26439":48333,"_2811":48450},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3323":385,"_29044":342,"_20168":48452,"_5":13790,"_26439":48333,"_2811":48453},[],"Optional integrations",{"_3323":386,"_29044":342,"_20168":48455,"_5":13790,"_26439":48333,"_2811":48456},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3323":387,"_29044":342,"_20168":48458,"_5":13790,"_26439":48333,"_2811":48459},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3323":388,"_29044":342,"_20168":48461,"_5":13790,"_26439":48333,"_2811":48462},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3323":389,"_29044":342,"_20168":48464,"_5":13790,"_26439":48333,"_2811":48465},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3323":390,"_29044":342,"_20168":48467,"_5":13790,"_26439":48337,"_2811":48468},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3323":391,"_29044":342,"_20168":48470,"_5":13790,"_26439":48337,"_2811":48471},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3323":392,"_29044":342,"_20168":48473,"_5":13790,"_26439":48341,"_2811":48474},[],"Kubernetes 1.24 or newer",{"_3323":393,"_29044":342,"_20168":48476,"_5":13790,"_26439":48341,"_2811":48477},[],"Helm 3.2 or newer",{"_3323":394,"_29044":342,"_20168":48479,"_5":13790,"_26439":48341,"_2811":48480},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3323":395,"_29044":342,"_20168":48482,"_5":13790,"_26439":48341,"_2811":48483},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3323":396,"_29044":342,"_20168":48485,"_5":13790,"_26439":48341,"_2811":48486},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3323":397,"_29044":342,"_20168":48488,"_5":13790,"_26439":48341,"_2811":48489},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3323":398,"_29044":342,"_20168":48491,"_5":13790,"_26439":48341,"_2811":48492},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3323":399,"_29044":342,"_20168":48494,"_5":13790,"_26439":48345,"_2811":48495},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3323":400,"_29044":342,"_20168":48497,"_5":13790,"_26439":48345,"_2811":48498},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3323":401,"_29044":342,"_20168":48500,"_5":13790,"_26439":48345,"_2811":48501},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3323":402,"_29044":342,"_20168":48503,"_5":13790,"_26439":48345,"_2811":48504},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3323":403,"_29044":403,"_5":14148,"_2811":48506,"_29388":48507,"_20168":48509,"_26439":403},"Deployment troubleshooting",[47299,47300,48508],"Operations",[],{"_3323":404,"_29044":403,"_20168":48511,"_5":13790,"_26439":403,"_2811":48512},[],"Diagnose access, service health and infrastructure dependencies.",{"_3323":405,"_29044":403,"_5":29385,"_20168":48514,"_26439":48515,"_2811":48516},[],"/docs/pr-preview/pr-46/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3323":406,"_29044":403,"_5":29385,"_20168":48518,"_26439":48519,"_2811":48520},[],"/docs/pr-preview/pr-46/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3323":407,"_29044":403,"_5":29385,"_20168":48522,"_26439":48523,"_2811":48524},[],"/docs/pr-preview/pr-46/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3323":408,"_29044":403,"_5":29385,"_20168":48526,"_26439":48527,"_2811":48528},[],"/docs/pr-preview/pr-46/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3323":409,"_29044":403,"_5":29385,"_20168":48530,"_26439":48531,"_2811":48532},[],"/docs/pr-preview/pr-46/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3323":410,"_29044":403,"_5":29385,"_20168":48534,"_26439":48535,"_2811":48536},[],"/docs/pr-preview/pr-46/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3323":411,"_29044":403,"_5":29385,"_20168":48538,"_26439":48539,"_2811":48540},[],"/docs/pr-preview/pr-46/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3323":412,"_29044":403,"_5":29385,"_20168":48542,"_26439":48543,"_2811":48544},[],"/docs/pr-preview/pr-46/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3323":413,"_29044":403,"_5":29385,"_20168":48546,"_26439":48547,"_2811":48548},[],"/docs/pr-preview/pr-46/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3323":414,"_29044":403,"_5":29385,"_20168":48550,"_26439":48551,"_2811":48552},[],"/docs/pr-preview/pr-46/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3323":415,"_29044":403,"_5":29385,"_20168":48554,"_26439":48555,"_2811":48556},[],"/docs/pr-preview/pr-46/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3323":416,"_29044":403,"_5":29385,"_20168":48558,"_26439":48559,"_2811":48560},[],"/docs/pr-preview/pr-46/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3323":417,"_29044":403,"_5":29385,"_20168":48562,"_26439":48563,"_2811":48564},[],"/docs/pr-preview/pr-46/deployment/troubleshooting#observability","Observability",{"_3323":418,"_29044":403,"_20168":48566,"_5":13790,"_26439":403,"_2811":48567},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3323":419,"_29044":403,"_20168":48569,"_5":13790,"_26439":48519,"_2811":48570},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3323":420,"_29044":403,"_20168":48572,"_5":13790,"_26439":48523,"_2811":48573},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3323":421,"_29044":403,"_20168":48575,"_5":13790,"_26439":48527,"_2811":48576},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3323":422,"_29044":403,"_20168":48578,"_5":13790,"_26439":48531,"_2811":48579},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3323":423,"_29044":403,"_20168":48581,"_5":13790,"_26439":48535,"_2811":48582},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3323":424,"_29044":403,"_20168":48584,"_5":13790,"_26439":48539,"_2811":48585},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3323":425,"_29044":403,"_20168":48587,"_5":13790,"_26439":48539,"_2811":48588},[],"Also run the chart's connectivity test:",{"_3323":426,"_29044":403,"_20168":48590,"_5":13790,"_26439":48539,"_2811":48591},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3323":427,"_29044":403,"_20168":48593,"_5":13790,"_26439":48539,"_2811":48594},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3323":428,"_29044":403,"_20168":48596,"_5":13790,"_26439":48543,"_2811":48597},[],"If you receive a 401:",{"_3323":429,"_29044":403,"_20168":48599,"_5":13790,"_26439":48543,"_2811":48600},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3323":430,"_29044":403,"_20168":48602,"_5":13790,"_26439":48543,"_2811":48603},[],"verify issuer, audience and expiration of the token;",{"_3323":431,"_29044":403,"_20168":48605,"_5":13790,"_26439":48543,"_2811":48606},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3323":432,"_29044":403,"_20168":48608,"_5":13790,"_26439":48543,"_2811":48609},[],"check that the provider's public and internal routes point to the same realm.",{"_3323":433,"_29044":403,"_20168":48611,"_5":13790,"_26439":48543,"_2811":48612},[],"If login succeeds but the APIs return 403:",{"_3323":434,"_29044":403,"_20168":48614,"_5":13790,"_26439":48543,"_2811":48615},[],"inspect the token's real claims;",{"_3323":435,"_29044":403,"_20168":48617,"_5":13790,"_26439":48543,"_2811":48618},[],"confirm they match an active principal;",{"_3323":436,"_29044":403,"_20168":48620,"_5":13790,"_26439":48543,"_2811":48621},[],"review the policies granted to that principal;",{"_3323":437,"_29044":403,"_20168":48623,"_5":13790,"_26439":48543,"_2811":48624},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3323":438,"_29044":403,"_20168":48626,"_5":13790,"_26439":48543,"_2811":48627},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3323":439,"_29044":403,"_20168":48629,"_5":13790,"_26439":48547,"_2811":48630},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3323":440,"_29044":403,"_20168":48632,"_5":13790,"_26439":48547,"_2811":48633},[],"Locate the authz pod and Service.",{"_3323":441,"_29044":403,"_20168":48635,"_5":13790,"_26439":48547,"_2811":48636},[],"Check /health, logs and its database connection.",{"_3323":442,"_29044":403,"_20168":48638,"_5":13790,"_26439":48547,"_2811":48639},[],"Verify the DNS and port configured in externalAuthorization.",{"_3323":443,"_29044":403,"_20168":48641,"_5":13790,"_26439":48547,"_2811":48642},[],"Check the check route is /v1/ext\\_authz/check.",{"_3323":444,"_29044":403,"_20168":48644,"_5":13790,"_26439":48547,"_2811":48645},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3323":445,"_29044":403,"_20168":48647,"_5":13790,"_26439":48551,"_2811":48648},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3323":446,"_29044":403,"_20168":48650,"_5":13790,"_26439":48555,"_2811":48651},[],"Review kubectl describe pod first. Common causes are:",{"_3323":447,"_29044":403,"_20168":48653,"_5":13790,"_26439":48555,"_2811":48654},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3323":448,"_29044":403,"_20168":48656,"_5":13790,"_26439":48555,"_2811":48657},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3323":449,"_29044":403,"_20168":48659,"_5":13790,"_26439":48555,"_2811":48660},[],"unbound persistent volume;",{"_3323":450,"_29044":403,"_20168":48662,"_5":13790,"_26439":48555,"_2811":48663},[],"inaccessible image or incorrect pull policy;",{"_3323":451,"_29044":403,"_20168":48665,"_5":13790,"_26439":48555,"_2811":48666},[],"invalid cryptographic engine configuration;",{"_3323":452,"_29044":403,"_20168":48668,"_5":13790,"_26439":48555,"_2811":48669},[],"CPU or memory limits set too low;",{"_3323":453,"_29044":403,"_20168":48671,"_5":13790,"_26439":48555,"_2811":48672},[],"an incomplete prior migration.",{"_3323":454,"_29044":403,"_20168":48674,"_5":13790,"_26439":48555,"_2811":48675},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3323":455,"_29044":403,"_20168":48677,"_5":13790,"_26439":48555,"_2811":48678},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3323":456,"_29044":403,"_20168":48680,"_5":13790,"_26439":48555,"_2811":48681},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3323":457,"_29044":403,"_20168":48683,"_5":13790,"_26439":48559,"_2811":48684},[],"Domain and audit events depend on the bus publisher:",{"_3323":458,"_29044":403,"_20168":48686,"_5":13790,"_26439":48559,"_2811":48687},[],"verify it is enabled in the emitting service;",{"_3323":459,"_29044":403,"_20168":48689,"_5":13790,"_26439":48559,"_2811":48690},[],"check AMQP connectivity and credentials;",{"_3323":460,"_29044":403,"_20168":48692,"_5":13790,"_26439":48559,"_2811":48693},[],"review exchange, routing key, queues and consumers;",{"_3323":461,"_29044":403,"_20168":48695,"_5":13790,"_26439":48559,"_2811":48696},[],"inspect dead-letter queues;",{"_3323":462,"_29044":403,"_20168":48698,"_5":13790,"_26439":48559,"_2811":48699},[],"alert on orphan durable queues and backlog growth.",{"_3323":463,"_29044":403,"_20168":48701,"_5":13790,"_26439":48559,"_2811":48702},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3323":464,"_29044":403,"_20168":48704,"_5":13790,"_26439":48559,"_2811":48705},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3323":465,"_29044":403,"_20168":48707,"_5":13790,"_26439":48559,"_2811":48708},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3323":466,"_29044":403,"_20168":48710,"_5":13790,"_26439":48559,"_2811":48711},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3323":467,"_29044":403,"_20168":48713,"_5":13790,"_26439":48559,"_2811":48714},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3323":468,"_29044":403,"_20168":48716,"_5":13790,"_26439":48559,"_2811":48717},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3323":469,"_29044":403,"_20168":48719,"_5":13790,"_26439":48559,"_2811":48720},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3323":470,"_29044":403,"_20168":48722,"_5":13790,"_26439":48563,"_2811":48723},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3323":471,"_29044":403,"_20168":48725,"_5":13790,"_26439":48563,"_2811":48726},[],"Before closing an incident, record:",{"_3323":472,"_29044":403,"_20168":48728,"_5":13790,"_26439":48563,"_2811":48729},[],"the confirmed cause;",{"_3323":473,"_29044":403,"_20168":48731,"_5":13790,"_26439":48563,"_2811":48732},[],"the time scope and affected resources;",{"_3323":474,"_29044":403,"_20168":48734,"_5":13790,"_26439":48563,"_2811":48735},[],"the commands or queries used;",{"_3323":475,"_29044":403,"_20168":48737,"_5":13790,"_26439":48563,"_2811":48738},[],"the applied change and how to revert it;",{"_3323":476,"_29044":403,"_20168":48740,"_5":13790,"_26439":48563,"_2811":48741},[],"validation from a consumer;",{"_3323":477,"_29044":403,"_20168":48743,"_5":13790,"_26439":48563,"_2811":48744},[],"the preventive action and its owner.",{"_3323":478,"_29044":478,"_5":14148,"_2811":48746,"_29388":48747,"_20168":48750,"_26439":478},"Access control",[47299,48748,48749],"Platform","Administration",[],{"_3323":479,"_29044":478,"_20168":48752,"_5":13790,"_26439":478,"_2811":48753},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3323":480,"_29044":478,"_5":29385,"_20168":48755,"_26439":48756,"_2811":48757},[],"/docs/pr-preview/pr-46/platform/administration/access-control#essential-concepts","Essential concepts",{"_3323":481,"_29044":478,"_5":29385,"_20168":48759,"_26439":48760,"_2811":48761},[],"/docs/pr-preview/pr-46/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3323":482,"_29044":478,"_5":29385,"_20168":48763,"_26439":48764,"_2811":48765},[],"/docs/pr-preview/pr-46/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3323":483,"_29044":478,"_5":29385,"_20168":48767,"_26439":48768,"_2811":48769},[],"/docs/pr-preview/pr-46/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3323":484,"_29044":478,"_5":29385,"_20168":48771,"_26439":48772,"_2811":48773},[],"/docs/pr-preview/pr-46/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3323":485,"_29044":478,"_5":29385,"_20168":48775,"_26439":48776,"_2811":48777},[],"/docs/pr-preview/pr-46/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3323":486,"_29044":478,"_5":29385,"_20168":48779,"_26439":48780,"_2811":48781},[],"/docs/pr-preview/pr-46/platform/administration/access-control#oidc-principals","OIDC principals",{"_3323":487,"_29044":478,"_5":29385,"_20168":48783,"_26439":48784,"_2811":48785},[],"/docs/pr-preview/pr-46/platform/administration/access-control#x509-principals","X.509 principals",{"_3323":488,"_29044":478,"_5":29385,"_20168":48787,"_26439":48788,"_2811":48789},[],"/docs/pr-preview/pr-46/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3323":489,"_29044":478,"_5":29385,"_20168":48791,"_26439":48792,"_2811":48793},[],"/docs/pr-preview/pr-46/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3323":490,"_29044":478,"_5":29385,"_20168":48795,"_26439":48796,"_2811":48797},[],"/docs/pr-preview/pr-46/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3323":491,"_29044":478,"_5":29385,"_20168":48799,"_26439":48800,"_2811":48801},[],"/docs/pr-preview/pr-46/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3323":492,"_29044":478,"_5":29385,"_20168":48803,"_26439":48804,"_2811":48805},[],"/docs/pr-preview/pr-46/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3323":493,"_29044":478,"_5":29385,"_20168":48807,"_26439":48808,"_2811":48809},[],"/docs/pr-preview/pr-46/platform/administration/access-control#http-rules","HTTP rules",{"_3323":494,"_29044":478,"_5":29385,"_20168":48811,"_26439":48812,"_2811":48813},[],"/docs/pr-preview/pr-46/platform/administration/access-control#included-policies","Included policies",{"_3323":495,"_29044":478,"_5":29385,"_20168":48815,"_26439":48816,"_2811":47939},[],"/docs/pr-preview/pr-46/platform/administration/access-control#provision-the-first-administrator",{"_3323":496,"_29044":478,"_5":29385,"_20168":48818,"_26439":48819,"_2811":48820},[],"/docs/pr-preview/pr-46/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3323":497,"_29044":478,"_5":29385,"_20168":48822,"_26439":48823,"_2811":48824},[],"/docs/pr-preview/pr-46/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3323":498,"_29044":478,"_5":29385,"_20168":48826,"_26439":48827,"_2811":48828},[],"/docs/pr-preview/pr-46/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3323":499,"_29044":478,"_5":29385,"_20168":48830,"_26439":48831,"_2811":48832},[],"/docs/pr-preview/pr-46/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3323":500,"_29044":478,"_5":29385,"_20168":48834,"_26439":48835,"_2811":48836},[],"/docs/pr-preview/pr-46/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3323":501,"_29044":478,"_5":29385,"_20168":48838,"_26439":48839,"_2811":48840},[],"/docs/pr-preview/pr-46/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3323":502,"_29044":478,"_5":29385,"_20168":48842,"_26439":48843,"_2811":48844},[],"/docs/pr-preview/pr-46/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3323":503,"_29044":478,"_5":29385,"_20168":48846,"_26439":48847,"_2811":48848},[],"/docs/pr-preview/pr-46/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3323":504,"_29044":478,"_5":29385,"_20168":48850,"_26439":48851,"_2811":48852},[],"/docs/pr-preview/pr-46/platform/administration/access-control#operational-checklist","Operational checklist",{"_3323":505,"_29044":478,"_5":29385,"_20168":48854,"_26439":48855,"_2811":48856},[],"/docs/pr-preview/pr-46/platform/administration/access-control#diagnostics","Diagnostics",{"_3323":506,"_29044":478,"_5":29385,"_20168":48858,"_26439":48859,"_2811":48860},[],"/docs/pr-preview/pr-46/platform/administration/access-control#the-response-is-401","The response is 401",{"_3323":507,"_29044":478,"_5":29385,"_20168":48862,"_26439":48863,"_2811":48864},[],"/docs/pr-preview/pr-46/platform/administration/access-control#the-response-is-403","The response is 403",{"_3323":508,"_29044":478,"_5":29385,"_20168":48866,"_26439":48867,"_2811":48868},[],"/docs/pr-preview/pr-46/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3323":509,"_29044":478,"_5":29385,"_20168":48870,"_26439":48871,"_2811":48872},[],"/docs/pr-preview/pr-46/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3323":510,"_29044":478,"_5":29385,"_20168":48874,"_26439":48875,"_2811":48876},[],"/docs/pr-preview/pr-46/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3323":511,"_29044":478,"_20168":48878,"_5":13790,"_26439":478,"_2811":48879},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3323":512,"_29044":478,"_20168":48881,"_5":13790,"_26439":478,"_2811":48882},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3323":513,"_29044":478,"_20168":48884,"_5":13790,"_26439":478,"_2811":48885},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3323":514,"_29044":478,"_20168":48887,"_5":13790,"_26439":48756,"_2811":48888},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3323":515,"_29044":478,"_20168":48890,"_5":13790,"_26439":48756,"_2811":48891},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3323":516,"_29044":478,"_20168":48893,"_5":13790,"_26439":48756,"_2811":48894},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3323":517,"_29044":478,"_20168":48896,"_5":13790,"_26439":48756,"_2811":48897},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3323":518,"_29044":478,"_20168":48899,"_5":13790,"_26439":48756,"_2811":48900},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3323":519,"_29044":478,"_20168":48902,"_5":13790,"_26439":48756,"_2811":48903},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3323":520,"_29044":478,"_20168":48905,"_5":13790,"_26439":48760,"_2811":48906},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3323":521,"_29044":478,"_20168":48908,"_5":13790,"_26439":48760,"_2811":48909},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3323":522,"_29044":478,"_20168":48911,"_5":13790,"_26439":48764,"_2811":48912},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3323":523,"_29044":478,"_20168":48914,"_5":13790,"_26439":48764,"_2811":48915},[],"The decision is made **before forwarding the request to the service**:",{"_3323":524,"_29044":478,"_20168":48917,"_5":13790,"_26439":48764,"_2811":48918},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3323":525,"_29044":478,"_20168":48920,"_5":13790,"_26439":48764,"_2811":48921},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3323":526,"_29044":478,"_20168":48923,"_5":13790,"_26439":48764,"_2811":48924},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3323":527,"_29044":478,"_20168":48926,"_5":13790,"_26439":48764,"_2811":48927},[],"It separately loads the policies granted to each principal.",{"_3323":528,"_29044":478,"_20168":48929,"_5":13790,"_26439":48764,"_2811":48930},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3323":529,"_29044":478,"_20168":48932,"_5":13790,"_26439":48764,"_2811":48933},[],"`authz` looks for an HTTP rule granting that action.",{"_3323":530,"_29044":478,"_20168":48935,"_5":13790,"_26439":48764,"_2811":48936},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3323":531,"_29044":478,"_20168":48938,"_5":13790,"_26439":48764,"_2811":48939},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3323":532,"_29044":478,"_20168":48941,"_5":13790,"_26439":48764,"_2811":48942},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3323":533,"_29044":478,"_20168":48944,"_5":13790,"_26439":48764,"_2811":48945},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3323":534,"_29044":478,"_20168":48947,"_5":13790,"_26439":48768,"_2811":48948},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3323":535,"_29044":478,"_20168":48950,"_5":13790,"_26439":48768,"_2811":48951},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3323":536,"_29044":478,"_20168":48953,"_5":13790,"_26439":48768,"_2811":48954},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3323":537,"_29044":478,"_20168":48956,"_5":13790,"_26439":48768,"_2811":48957},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3323":538,"_29044":478,"_20168":48959,"_5":13790,"_26439":48768,"_2811":48960},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3323":539,"_29044":478,"_20168":48962,"_5":13790,"_26439":48768,"_2811":48963},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3323":540,"_29044":478,"_20168":48965,"_5":13790,"_26439":48768,"_2811":48966},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3323":541,"_29044":478,"_20168":48968,"_5":13790,"_26439":48768,"_2811":48969},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3323":542,"_29044":478,"_20168":48971,"_5":13790,"_26439":48772,"_2811":48972},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3323":543,"_29044":478,"_20168":48974,"_5":13790,"_26439":48772,"_2811":48975},[],"The decision is made with the domain operation context:",{"_3323":544,"_29044":478,"_20168":48977,"_5":13790,"_26439":48772,"_2811":48978},[],"The middleware extracts the credential and resolves the matching principals.",{"_3323":545,"_29044":478,"_20168":48980,"_5":13790,"_26439":48772,"_2811":48981},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3323":546,"_29044":478,"_20168":48983,"_5":13790,"_26439":48772,"_2811":48984},[],"`authz` gathers the entity rules of the granted policies.",{"_3323":547,"_29044":478,"_20168":48986,"_5":13790,"_26439":48772,"_2811":48987},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3323":548,"_29044":478,"_20168":48989,"_5":13790,"_26439":48772,"_2811":48990},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3323":549,"_29044":478,"_20168":48992,"_5":13790,"_26439":48772,"_2811":48993},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3323":550,"_29044":478,"_20168":48995,"_5":13790,"_26439":48772,"_2811":48996},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3323":551,"_29044":478,"_20168":48998,"_5":13790,"_26439":48772,"_2811":48999},[],"Actions fall into two groups:",{"_3323":552,"_29044":478,"_20168":49001,"_5":13790,"_26439":48772,"_2811":49002},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3323":553,"_29044":478,"_20168":49004,"_5":13790,"_26439":48772,"_2811":49005},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3323":554,"_29044":478,"_20168":49007,"_5":13790,"_26439":48772,"_2811":49008},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3323":555,"_29044":478,"_20168":49010,"_5":13790,"_26439":48776,"_2811":49011},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3323":556,"_29044":478,"_20168":49013,"_5":13790,"_26439":48776,"_2811":49014},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3323":557,"_29044":478,"_20168":49016,"_5":13790,"_26439":48776,"_2811":49017},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3323":558,"_29044":478,"_20168":49019,"_5":13790,"_26439":48780,"_2811":49020},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3323":559,"_29044":478,"_20168":49022,"_5":13790,"_26439":48780,"_2811":49023},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3323":560,"_29044":478,"_20168":49025,"_5":13790,"_26439":48780,"_2811":49026},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3323":561,"_29044":478,"_20168":49028,"_5":13790,"_26439":48780,"_2811":49029},[],"The implemented operators are:",{"_3323":562,"_29044":478,"_20168":49031,"_5":13790,"_26439":48780,"_2811":49032},[],"`equals`, for exact equality;",{"_3323":563,"_29044":478,"_20168":49034,"_5":13790,"_26439":48780,"_2811":49035},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3323":564,"_29044":478,"_20168":49037,"_5":13790,"_26439":48780,"_2811":49038},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3323":565,"_29044":478,"_20168":49040,"_5":13790,"_26439":48780,"_2811":49041},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3323":566,"_29044":478,"_20168":49043,"_5":13790,"_26439":48784,"_2811":49044},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3323":567,"_29044":478,"_20168":49046,"_5":13790,"_26439":48784,"_2811":49047},[],"The available modes are:",{"_3323":568,"_29044":478,"_20168":49049,"_5":13790,"_26439":48784,"_2811":49050},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3323":569,"_29044":478,"_20168":49052,"_5":13790,"_26439":48784,"_2811":49053},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3323":570,"_29044":478,"_20168":49055,"_5":13790,"_26439":48784,"_2811":49056},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3323":571,"_29044":478,"_20168":49058,"_5":13790,"_26439":48784,"_2811":49059},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3323":572,"_29044":478,"_20168":49061,"_5":13790,"_26439":48784,"_2811":49062},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3323":573,"_29044":478,"_20168":49064,"_5":13790,"_26439":48784,"_2811":49065},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3323":574,"_29044":478,"_20168":49067,"_5":13790,"_26439":48788,"_2811":49068},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3323":575,"_29044":478,"_20168":49070,"_5":13790,"_26439":48788,"_2811":49071},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3323":576,"_29044":478,"_20168":49073,"_5":13790,"_26439":48788,"_2811":49074},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3323":577,"_29044":478,"_20168":49076,"_5":13790,"_26439":48788,"_2811":49077},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3323":578,"_29044":478,"_20168":49079,"_5":13790,"_26439":48796,"_2811":49080},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3323":579,"_29044":478,"_20168":49082,"_5":13790,"_26439":48796,"_2811":49083},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3323":580,"_29044":478,"_20168":49085,"_5":13790,"_26439":48800,"_2811":49086},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3323":581,"_29044":478,"_20168":49088,"_5":13790,"_26439":48800,"_2811":49089},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3323":582,"_29044":478,"_20168":49091,"_5":13790,"_26439":48804,"_2811":49092},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3323":583,"_29044":478,"_20168":49094,"_5":13790,"_26439":48804,"_2811":49095},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3323":584,"_29044":478,"_20168":49097,"_5":13790,"_26439":48804,"_2811":49098},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3323":585,"_29044":478,"_20168":49100,"_5":13790,"_26439":48808,"_2811":49101},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3323":586,"_29044":478,"_20168":49103,"_5":13790,"_26439":48808,"_2811":49104},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3323":587,"_29044":478,"_20168":49106,"_5":13790,"_26439":48808,"_2811":49107},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3323":588,"_29044":478,"_20168":49109,"_5":13790,"_26439":48808,"_2811":49110},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3323":589,"_29044":478,"_20168":49112,"_5":13790,"_26439":48808,"_2811":49113},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3323":590,"_29044":478,"_20168":49115,"_5":13790,"_26439":48808,"_2811":49116},[],"Note that:",{"_3323":591,"_29044":478,"_20168":49118,"_5":13790,"_26439":48808,"_2811":49119},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3323":592,"_29044":478,"_20168":49121,"_5":13790,"_26439":48808,"_2811":49122},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3323":593,"_29044":478,"_20168":49124,"_5":13790,"_26439":48808,"_2811":49125},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3323":594,"_29044":478,"_20168":49127,"_5":13790,"_26439":48812,"_2811":49128},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3323":595,"_29044":478,"_20168":49130,"_5":13790,"_26439":48812,"_2811":49131},[],"full and read-only access to certificates and authorities;",{"_3323":596,"_29044":478,"_20168":49133,"_5":13790,"_26439":48812,"_2811":49134},[],"full and read-only access to the KMS;",{"_3323":597,"_29044":478,"_20168":49136,"_5":13790,"_26439":48812,"_2811":49137},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3323":598,"_29044":478,"_20168":49139,"_5":13790,"_26439":48812,"_2811":49140},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3323":599,"_29044":478,"_20168":49142,"_5":13790,"_26439":48812,"_2811":49143},[],"console access;",{"_3323":600,"_29044":478,"_20168":49145,"_5":13790,"_26439":48812,"_2811":49146},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3323":601,"_29044":478,"_20168":49148,"_5":13790,"_26439":48812,"_2811":49149},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3323":602,"_29044":478,"_20168":49151,"_5":13790,"_26439":48812,"_2811":49152},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3323":603,"_29044":478,"_20168":49154,"_5":13790,"_26439":48816,"_2811":49155},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3323":604,"_29044":478,"_20168":49157,"_5":13790,"_26439":48816,"_2811":49158},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3323":605,"_29044":478,"_20168":49160,"_5":13790,"_26439":48816,"_2811":49161},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3323":606,"_29044":478,"_20168":49163,"_5":13790,"_26439":48819,"_2811":49164},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3323":607,"_29044":478,"_20168":49166,"_5":13790,"_26439":48823,"_2811":49167},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3323":608,"_29044":478,"_20168":49169,"_5":13790,"_26439":48823,"_2811":49170},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3323":609,"_29044":478,"_20168":49172,"_5":13790,"_26439":48827,"_2811":49173},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3323":610,"_29044":478,"_20168":49175,"_5":13790,"_26439":48831,"_2811":49176},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3323":611,"_29044":478,"_20168":49178,"_5":13790,"_26439":48835,"_2811":49179},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3323":612,"_29044":478,"_20168":49181,"_5":13790,"_26439":48839,"_2811":49182},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3323":613,"_29044":478,"_20168":49184,"_5":13790,"_26439":48839,"_2811":49185},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3323":614,"_29044":478,"_20168":49187,"_5":13790,"_26439":48843,"_2811":49188},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3323":615,"_29044":478,"_20168":49190,"_5":13790,"_26439":48843,"_2811":49191},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3323":616,"_29044":478,"_20168":49193,"_5":13790,"_26439":48843,"_2811":49194},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3323":617,"_29044":478,"_20168":49196,"_5":13790,"_26439":48843,"_2811":49197},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3323":618,"_29044":478,"_20168":49199,"_5":13790,"_26439":48843,"_2811":49200},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3323":619,"_29044":478,"_20168":49202,"_5":13790,"_26439":48843,"_2811":49203},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3323":620,"_29044":478,"_20168":49205,"_5":13790,"_26439":48843,"_2811":49206},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3323":621,"_29044":478,"_20168":49208,"_5":13790,"_26439":48843,"_2811":49209},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3323":622,"_29044":478,"_20168":49211,"_5":13790,"_26439":48847,"_2811":49212},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3323":623,"_29044":478,"_20168":49214,"_5":13790,"_26439":48847,"_2811":49215},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3323":624,"_29044":478,"_20168":49217,"_5":13790,"_26439":48847,"_2811":49218},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3323":625,"_29044":478,"_20168":49220,"_5":13790,"_26439":48851,"_2811":49221},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3323":626,"_29044":478,"_20168":49223,"_5":13790,"_26439":48851,"_2811":49224},[],"Use groups or stable roles for people and independent identities for automations.",{"_3323":627,"_29044":478,"_20168":49226,"_5":13790,"_26439":48851,"_2811":49227},[],"Keep at least two recovery administrators and test their access periodically.",{"_3323":628,"_29044":478,"_20168":49229,"_5":13790,"_26439":48851,"_2811":49230},[],"Review active principals, their matches and their grants after IdP changes.",{"_3323":629,"_29044":478,"_20168":49232,"_5":13790,"_26439":48851,"_2811":49233},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3323":630,"_29044":478,"_20168":49235,"_5":13790,"_26439":48851,"_2811":49236},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3323":631,"_29044":478,"_20168":49238,"_5":13790,"_26439":48851,"_2811":49239},[],"Always test one allowed and one denied operation for each role.",{"_3323":632,"_29044":478,"_20168":49241,"_5":13790,"_26439":48851,"_2811":49242},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3323":633,"_29044":478,"_20168":49244,"_5":13790,"_26439":48859,"_2811":49245},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3323":634,"_29044":478,"_20168":49247,"_5":13790,"_26439":48863,"_2811":49248},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3323":635,"_29044":478,"_20168":49250,"_5":13790,"_26439":48863,"_2811":49251},[],"that an active principal of the correct type exists;",{"_3323":636,"_29044":478,"_20168":49253,"_5":13790,"_26439":48863,"_2811":49254},[],"that the claim paths and values match the real token exactly;",{"_3323":637,"_29044":478,"_20168":49256,"_5":13790,"_26439":48863,"_2811":49257},[],"that all of the principal's conditions hold;",{"_3323":638,"_29044":478,"_20168":49259,"_5":13790,"_26439":48863,"_2811":49260},[],"that the principal has the expected policy granted;",{"_3323":639,"_29044":478,"_20168":49262,"_5":13790,"_26439":48863,"_2811":49263},[],"that the policy includes the action and the requested resource type or route;",{"_3323":640,"_29044":478,"_20168":49265,"_5":13790,"_26439":48863,"_2811":49266},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3323":641,"_29044":478,"_20168":49268,"_5":13790,"_26439":48863,"_2811":49269},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3323":642,"_29044":478,"_20168":49271,"_5":13790,"_26439":48867,"_2811":49272},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3323":643,"_29044":478,"_20168":49274,"_5":13790,"_26439":48871,"_2811":49275},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3323":644,"_29044":478,"_20168":49277,"_5":13790,"_26439":48875,"_2811":49278},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3323":645,"_29044":478,"_20168":49280,"_5":13790,"_26439":48875,"_2811":49281},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3323":646,"_29044":646,"_5":14148,"_2811":49283,"_29388":49284,"_20168":49285,"_26439":646},"Alerts and subscriptions",[47299,48748,48749],[],{"_3323":647,"_29044":646,"_20168":49287,"_5":13790,"_26439":646,"_2811":49288},[],"Send PKI events to people and external systems.",{"_3323":648,"_29044":646,"_5":29385,"_20168":49290,"_26439":49291,"_2811":49292},[],"/docs/pr-preview/pr-46/platform/administration/alerts#how-it-works","How it works",{"_3323":649,"_29044":646,"_5":29385,"_20168":49294,"_26439":49295,"_2811":49296},[],"/docs/pr-preview/pr-46/platform/administration/alerts#available-channels","Available channels",{"_3323":650,"_29044":646,"_5":29385,"_20168":49298,"_26439":49299,"_2811":49300},[],"/docs/pr-preview/pr-46/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3323":651,"_29044":646,"_5":29385,"_20168":49302,"_26439":49303,"_2811":49304},[],"/docs/pr-preview/pr-46/platform/administration/alerts#choose-the-event","Choose the event",{"_3323":652,"_29044":646,"_5":29385,"_20168":49306,"_26439":49307,"_2811":49308},[],"/docs/pr-preview/pr-46/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3323":653,"_29044":646,"_5":29385,"_20168":49310,"_26439":49311,"_2811":49312},[],"/docs/pr-preview/pr-46/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3323":654,"_29044":646,"_5":29385,"_20168":49314,"_26439":49315,"_2811":49316},[],"/docs/pr-preview/pr-46/platform/administration/alerts#review-and-activate","Review and activate",{"_3323":655,"_29044":646,"_5":29385,"_20168":49318,"_26439":49319,"_2811":49320},[],"/docs/pr-preview/pr-46/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3323":656,"_29044":646,"_5":29385,"_20168":49322,"_26439":49323,"_2811":49324},[],"/docs/pr-preview/pr-46/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3323":657,"_29044":646,"_5":29385,"_20168":49326,"_26439":49327,"_2811":49328},[],"/docs/pr-preview/pr-46/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3323":658,"_29044":646,"_5":29385,"_20168":49330,"_26439":49331,"_2811":49332},[],"/docs/pr-preview/pr-46/platform/administration/alerts#event-families","Event families",{"_3323":659,"_29044":646,"_20168":49334,"_5":13790,"_26439":646,"_2811":49335},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3323":660,"_29044":646,"_20168":49337,"_5":13790,"_26439":49291,"_2811":49338},[],"A service publishes a domain event.",{"_3323":661,"_29044":646,"_20168":49340,"_5":13790,"_26439":49291,"_2811":49341},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3323":662,"_29044":646,"_20168":49343,"_5":13790,"_26439":49291,"_2811":49344},[],"Each subscription's filter decides whether it should be notified.",{"_3323":663,"_29044":646,"_20168":49346,"_5":13790,"_26439":49291,"_2811":49347},[],"Lamassu delivers the event to the configured channel.",{"_3323":664,"_29044":646,"_20168":49349,"_5":13790,"_26439":49291,"_2811":49350},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3323":665,"_29044":646,"_20168":49352,"_5":13790,"_26439":49295,"_2811":49353},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3323":666,"_29044":646,"_20168":49355,"_5":13790,"_26439":49295,"_2811":49356},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3323":667,"_29044":646,"_20168":49358,"_5":13790,"_26439":49295,"_2811":49359},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3323":668,"_29044":646,"_20168":49361,"_5":13790,"_26439":49295,"_2811":49362},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3323":669,"_29044":646,"_20168":49364,"_5":13790,"_26439":49295,"_2811":49365},[],"`apikey_options` requires `header` and `key`.",{"_3323":670,"_29044":646,"_20168":49367,"_5":13790,"_26439":49295,"_2811":49368},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3323":671,"_29044":646,"_20168":49370,"_5":13790,"_26439":49295,"_2811":49371},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3323":672,"_29044":646,"_20168":49373,"_5":13790,"_26439":49295,"_2811":49374},[],"The alerts API reference documents the full `http_client` schema.",{"_3323":673,"_29044":646,"_20168":49376,"_5":13790,"_26439":49303,"_2811":49377},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3323":674,"_29044":646,"_20168":49379,"_5":13790,"_26439":49307,"_2811":49380},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3323":675,"_29044":646,"_20168":49382,"_5":13790,"_26439":49311,"_2811":49383},[],"Add a filter if you don't want to receive every instance of the event.",{"_3323":676,"_29044":646,"_20168":49385,"_5":13790,"_26439":49311,"_2811":49386},[],"**None** notifies all instances of the event.",{"_3323":677,"_29044":646,"_20168":49388,"_5":13790,"_26439":49311,"_2811":49389},[],"**JSON Path** evaluates one or more specific fields.",{"_3323":678,"_29044":646,"_20168":49391,"_5":13790,"_26439":49311,"_2811":49392},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3323":679,"_29044":646,"_20168":49394,"_5":13790,"_26439":49311,"_2811":49395},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3323":680,"_29044":646,"_20168":49397,"_5":13790,"_26439":49311,"_2811":49398},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3323":681,"_29044":646,"_20168":49400,"_5":13790,"_26439":49311,"_2811":49401},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3323":682,"_29044":646,"_20168":49403,"_5":13790,"_26439":49315,"_2811":49404},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3323":683,"_29044":646,"_20168":49406,"_5":13790,"_26439":49319,"_2811":49407},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3323":684,"_29044":646,"_20168":49409,"_5":13790,"_26439":49319,"_2811":49410},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3323":685,"_29044":646,"_20168":49412,"_5":13790,"_26439":49319,"_2811":49413},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3323":686,"_29044":646,"_20168":49415,"_5":13790,"_26439":49319,"_2811":49416},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3323":687,"_29044":646,"_20168":49418,"_5":13790,"_26439":49319,"_2811":49419},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3323":688,"_29044":646,"_20168":49421,"_5":13790,"_26439":49319,"_2811":49422},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3323":689,"_29044":646,"_20168":49424,"_5":13790,"_26439":49319,"_2811":49425},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3323":690,"_29044":646,"_20168":49427,"_5":13790,"_26439":49319,"_2811":49428},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3323":691,"_29044":646,"_20168":49430,"_5":13790,"_26439":49323,"_2811":49431},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3323":692,"_29044":646,"_20168":49433,"_5":13790,"_26439":49323,"_2811":49434},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3323":693,"_29044":646,"_20168":49436,"_5":13790,"_26439":49323,"_2811":49437},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3323":694,"_29044":646,"_20168":49439,"_5":13790,"_26439":49323,"_2811":49440},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3323":695,"_29044":646,"_20168":49442,"_5":13790,"_26439":49323,"_2811":49443},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3323":696,"_29044":646,"_20168":49445,"_5":13790,"_26439":49323,"_2811":49446},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3323":697,"_29044":646,"_20168":49448,"_5":13790,"_26439":49323,"_2811":49449},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3323":698,"_29044":646,"_20168":49451,"_5":13790,"_26439":49323,"_2811":49452},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3323":699,"_29044":646,"_20168":49454,"_5":13790,"_26439":49327,"_2811":49455},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3323":700,"_29044":646,"_20168":49457,"_5":13790,"_26439":49327,"_2811":49458},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3323":701,"_29044":646,"_20168":49460,"_5":13790,"_26439":49331,"_2811":49461},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3323":702,"_29044":646,"_20168":49463,"_5":13790,"_26439":49331,"_2811":49464},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3323":703,"_29044":646,"_20168":49466,"_5":13790,"_26439":49331,"_2811":49467},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3323":704,"_29044":646,"_20168":49469,"_5":13790,"_26439":49331,"_2811":49470},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3323":705,"_29044":646,"_20168":49472,"_5":13790,"_26439":49331,"_2811":49473},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3323":706,"_29044":646,"_20168":49475,"_5":13790,"_26439":49331,"_2811":49476},[],"**Validation:** `va.role.crl.create`.",{"_3323":707,"_29044":646,"_20168":49478,"_5":13790,"_26439":49331,"_2811":49479},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3323":708,"_29044":646,"_20168":49481,"_5":13790,"_26439":49331,"_2811":49482},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3323":709,"_29044":709,"_5":14148,"_2811":49484,"_29388":49485,"_20168":49486,"_26439":709},"Audit logs",[47299,48748,48749],[],{"_3323":710,"_29044":709,"_20168":49488,"_5":13790,"_26439":709,"_2811":49489},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3323":711,"_29044":709,"_5":29385,"_20168":49491,"_26439":49492,"_2811":49493},[],"/docs/pr-preview/pr-46/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3323":712,"_29044":709,"_5":29385,"_20168":49495,"_26439":49496,"_2811":49497},[],"/docs/pr-preview/pr-46/platform/administration/audit-logs#coverage","Coverage",{"_3323":713,"_29044":709,"_5":29385,"_20168":49499,"_26439":49500,"_2811":49501},[],"/docs/pr-preview/pr-46/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3323":714,"_29044":709,"_5":29385,"_20168":49503,"_26439":49504,"_2811":49505},[],"/docs/pr-preview/pr-46/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3323":715,"_29044":709,"_5":29385,"_20168":49507,"_26439":49508,"_2811":49509},[],"/docs/pr-preview/pr-46/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3323":716,"_29044":709,"_5":29385,"_20168":49511,"_26439":49512,"_2811":49513},[],"/docs/pr-preview/pr-46/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3323":717,"_29044":709,"_5":29385,"_20168":49515,"_26439":49516,"_2811":49517},[],"/docs/pr-preview/pr-46/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3323":718,"_29044":709,"_5":29385,"_20168":49519,"_26439":49520,"_2811":49521},[],"/docs/pr-preview/pr-46/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3323":719,"_29044":709,"_5":29385,"_20168":49523,"_26439":49524,"_2811":49525},[],"/docs/pr-preview/pr-46/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3323":720,"_29044":709,"_5":29385,"_20168":49527,"_26439":49528,"_2811":49529},[],"/docs/pr-preview/pr-46/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3323":721,"_29044":709,"_5":29385,"_20168":49531,"_26439":49532,"_2811":49533},[],"/docs/pr-preview/pr-46/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3323":722,"_29044":709,"_20168":49535,"_5":13790,"_26439":709,"_2811":49536},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3323":723,"_29044":709,"_20168":49538,"_5":13790,"_26439":49492,"_2811":49539},[],"The audit body includes:",{"_3323":724,"_29044":709,"_20168":49541,"_5":13790,"_26439":49492,"_2811":49542},[],"input: data received by the operation;",{"_3323":725,"_29044":709,"_20168":49544,"_5":13790,"_26439":49492,"_2811":49545},[],"has\\_error: whether the service returned an error;",{"_3323":726,"_29044":709,"_20168":49547,"_5":13790,"_26439":49492,"_2811":49548},[],"output: produced result or error message;",{"_3323":727,"_29044":709,"_20168":49550,"_5":13790,"_26439":49492,"_2811":49551},[],"principals: identifiers of the principals that matched the request.",{"_3323":728,"_29044":709,"_20168":49553,"_5":13790,"_26439":49492,"_2811":49554},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3323":729,"_29044":709,"_20168":49556,"_5":13790,"_26439":49492,"_2811":49557},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3323":730,"_29044":709,"_20168":49559,"_5":13790,"_26439":49496,"_2811":49560},[],"The backend applies auditing to mutations of:",{"_3323":731,"_29044":709,"_20168":49562,"_5":13790,"_26439":49496,"_2811":49563},[],"authorities, certificates and issuance profiles;",{"_3323":732,"_29044":709,"_20168":49565,"_5":13790,"_26439":49496,"_2811":49566},[],"keys and KMS engines;",{"_3323":733,"_29044":709,"_20168":49568,"_5":13790,"_26439":49496,"_2811":49569},[],"devices and identities;",{"_3323":734,"_29044":709,"_20168":49571,"_5":13790,"_26439":49496,"_2811":49572},[],"DMSs and enrollment operations;",{"_3323":735,"_29044":709,"_20168":49574,"_5":13790,"_26439":49496,"_2811":49575},[],"validation functions and CRL;",{"_3323":736,"_29044":709,"_20168":49577,"_5":13790,"_26439":49496,"_2811":49578},[],"principals, policies and authorization grants.",{"_3323":737,"_29044":709,"_20168":49580,"_5":13790,"_26439":49496,"_2811":49581},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3323":738,"_29044":709,"_20168":49583,"_5":13790,"_26439":49500,"_2811":49584},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3323":739,"_29044":709,"_20168":49586,"_5":13790,"_26439":49500,"_2811":49587},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3323":740,"_29044":709,"_20168":49589,"_5":13790,"_26439":49500,"_2811":49590},[],"Design the consumer to:",{"_3323":741,"_29044":709,"_20168":49592,"_5":13790,"_26439":49500,"_2811":49593},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3323":742,"_29044":709,"_20168":49595,"_5":13790,"_26439":49500,"_2811":49596},[],"keep the complete CloudEvent unmodified;",{"_3323":743,"_29044":709,"_20168":49598,"_5":13790,"_26439":49500,"_2811":49599},[],"record the ingestion time and detect duplicates by ID;",{"_3323":744,"_29044":709,"_20168":49601,"_5":13790,"_26439":49500,"_2811":49602},[],"encrypt in transit and at rest;",{"_3323":745,"_29044":709,"_20168":49604,"_5":13790,"_26439":49500,"_2811":49605},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3323":746,"_29044":709,"_20168":49607,"_5":13790,"_26439":49500,"_2811":49608},[],"apply an explicit retention and legal hold policy;",{"_3323":747,"_29044":709,"_20168":49610,"_5":13790,"_26439":49500,"_2811":49611},[],"alert if it stops consuming or the pending queue grows.",{"_3323":748,"_29044":709,"_20168":49613,"_5":13790,"_26439":49504,"_2811":49614},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3323":749,"_29044":709,"_20168":49616,"_5":13790,"_26439":49504,"_2811":49617},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3323":750,"_29044":709,"_20168":49619,"_5":13790,"_26439":49512,"_2811":49620},[],"Start from the reported time and normalize every source to UTC.",{"_3323":751,"_29044":709,"_20168":49622,"_5":13790,"_26439":49516,"_2811":49623},[],"Filter by event type, service source and resource identifier.",{"_3323":752,"_29044":709,"_20168":49625,"_5":13790,"_26439":49520,"_2811":49626},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3323":753,"_29044":709,"_20168":49628,"_5":13790,"_26439":49524,"_2811":49629},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3323":754,"_29044":709,"_20168":49631,"_5":13790,"_26439":49528,"_2811":49632},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3323":755,"_29044":709,"_20168":49634,"_5":13790,"_26439":49532,"_2811":49635},[],"Generate a controlled mutation in a test environment and check that:",{"_3323":756,"_29044":709,"_20168":49637,"_5":13790,"_26439":49532,"_2811":49638},[],"a successful audit event appears;",{"_3323":757,"_29044":709,"_20168":49640,"_5":13790,"_26439":49532,"_2811":49641},[],"the principal matches the identity used;",{"_3323":758,"_29044":709,"_20168":49643,"_5":13790,"_26439":49532,"_2811":49644},[],"the consumer persists it exactly once;",{"_3323":759,"_29044":709,"_20168":49646,"_5":13790,"_26439":49532,"_2811":49647},[],"it can be retrieved by resource, actor and period;",{"_3323":760,"_29044":709,"_20168":49649,"_5":13790,"_26439":49532,"_2811":49650},[],"a consumer outage raises an alert.",{"_3323":761,"_29044":709,"_20168":49652,"_5":13790,"_26439":49532,"_2811":49653},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3323":762,"_29044":762,"_5":14148,"_2811":49655,"_29388":49656,"_20168":49657,"_26439":762},"Platform architecture",[47299,48748],[],{"_3323":763,"_29044":762,"_20168":49659,"_5":13790,"_26439":762,"_2811":49660},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3323":764,"_29044":762,"_5":29385,"_20168":49662,"_26439":49663,"_2811":49664},[],"/docs/pr-preview/pr-46/platform/concepts/architecture#control-plane","Control plane",{"_3323":765,"_29044":762,"_5":29385,"_20168":49666,"_26439":49667,"_2811":49668},[],"/docs/pr-preview/pr-46/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3323":766,"_29044":762,"_5":29385,"_20168":49670,"_26439":49671,"_2811":49672},[],"/docs/pr-preview/pr-46/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3323":767,"_29044":762,"_5":29385,"_20168":49674,"_26439":49675,"_2811":49676},[],"/docs/pr-preview/pr-46/platform/concepts/architecture#status-and-validation","Status and validation",{"_3323":768,"_29044":762,"_5":29385,"_20168":49678,"_26439":49679,"_2811":49680},[],"/docs/pr-preview/pr-46/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3323":769,"_29044":762,"_20168":49682,"_5":13790,"_26439":762,"_2811":49683},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3323":770,"_29044":762,"_20168":49685,"_5":13790,"_26439":762,"_2811":49686},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3323":771,"_29044":762,"_20168":49688,"_5":13790,"_26439":49663,"_2811":49689},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3323":772,"_29044":762,"_20168":49691,"_5":13790,"_26439":49667,"_2811":49692},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3323":773,"_29044":762,"_20168":49694,"_5":13790,"_26439":49671,"_2811":49695},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3323":774,"_29044":762,"_20168":49697,"_5":13790,"_26439":49675,"_2811":49698},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3323":775,"_29044":762,"_20168":49700,"_5":13790,"_26439":49679,"_2811":49701},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3323":776,"_29044":776,"_5":14148,"_2811":49703,"_29388":49704,"_20168":49705,"_26439":776},"How Lamassu works",[47299,48748],[],{"_3323":777,"_29044":776,"_20168":49707,"_5":13790,"_26439":776,"_2811":49708},[],"The mental model of trust, keys, certificates and devices.",{"_3323":778,"_29044":776,"_5":29385,"_20168":49710,"_26439":49711,"_2811":49712},[],"/docs/pr-preview/pr-46/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3323":779,"_29044":776,"_5":29385,"_20168":49714,"_26439":49715,"_2811":49716},[],"/docs/pr-preview/pr-46/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3323":780,"_29044":776,"_20168":49718,"_5":13790,"_26439":776,"_2811":49719},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3323":781,"_29044":776,"_20168":49721,"_5":13790,"_26439":49711,"_2811":49722},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3323":782,"_29044":776,"_20168":49724,"_5":13790,"_26439":49711,"_2811":49725},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3323":783,"_29044":776,"_20168":49727,"_5":13790,"_26439":49711,"_2811":49728},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3323":784,"_29044":776,"_20168":49730,"_5":13790,"_26439":49711,"_2811":49731},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3323":785,"_29044":776,"_20168":49733,"_5":13790,"_26439":49711,"_2811":49734},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3323":786,"_29044":776,"_20168":49736,"_5":13790,"_26439":49715,"_2811":49737},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3323":787,"_29044":776,"_20168":49739,"_5":13790,"_26439":49715,"_2811":49740},[],"A DMS relates that CA to an enrollment policy.",{"_3323":788,"_29044":776,"_20168":49742,"_5":13790,"_26439":49715,"_2811":49743},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3323":789,"_29044":776,"_20168":49745,"_5":13790,"_26439":49715,"_2811":49746},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3323":790,"_29044":776,"_20168":49748,"_5":13790,"_26439":49715,"_2811":49749},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3323":791,"_29044":776,"_20168":49751,"_5":13790,"_26439":49715,"_2811":49752},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3323":792,"_29044":776,"_20168":49754,"_5":13790,"_26439":49715,"_2811":49755},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3323":793,"_29044":793,"_5":14148,"_2811":49757,"_29388":49758,"_20168":49760,"_26439":793},"Devices and identities",[47299,48748,49759,49757],"IoT Fleets",[],{"_3323":794,"_29044":793,"_20168":49762,"_5":13790,"_26439":793,"_2811":49763},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3323":795,"_29044":793,"_5":29385,"_20168":49765,"_26439":49766,"_2811":49767},[],"/docs/pr-preview/pr-46/platform/iot-fleets/device-management#device-states","Device states",{"_3323":796,"_29044":793,"_5":29385,"_20168":49769,"_26439":49770,"_2811":49771},[],"/docs/pr-preview/pr-46/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3323":797,"_29044":793,"_5":29385,"_20168":49773,"_26439":49774,"_2811":49775},[],"/docs/pr-preview/pr-46/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3323":798,"_29044":793,"_5":29385,"_20168":49777,"_26439":49778,"_2811":49779},[],"/docs/pr-preview/pr-46/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3323":799,"_29044":793,"_5":29385,"_20168":49781,"_26439":49782,"_2811":49783},[],"/docs/pr-preview/pr-46/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3323":800,"_29044":793,"_5":29385,"_20168":49785,"_26439":49786,"_2811":49787},[],"/docs/pr-preview/pr-46/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3323":801,"_29044":793,"_5":29385,"_20168":49789,"_26439":49790,"_2811":49791},[],"/docs/pr-preview/pr-46/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3323":802,"_29044":793,"_5":29385,"_20168":49793,"_26439":49794,"_2811":49795},[],"/docs/pr-preview/pr-46/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3323":803,"_29044":793,"_5":29385,"_20168":49797,"_26439":49798,"_2811":49799},[],"/docs/pr-preview/pr-46/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3323":804,"_29044":793,"_5":29385,"_20168":49801,"_26439":49802,"_2811":49803},[],"/docs/pr-preview/pr-46/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3323":805,"_29044":793,"_5":29385,"_20168":49805,"_26439":49806,"_2811":49807},[],"/docs/pr-preview/pr-46/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3323":806,"_29044":793,"_20168":49809,"_5":13790,"_26439":793,"_2811":49810},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3323":807,"_29044":793,"_20168":49812,"_5":13790,"_26439":793,"_2811":49813},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3323":808,"_29044":793,"_20168":49815,"_5":13790,"_26439":49766,"_2811":49816},[],"Operational view",{"_3323":809,"_29044":793,"_20168":49818,"_5":13790,"_26439":49766,"_2811":49819},[],"Meaning",{"_3323":810,"_29044":793,"_20168":49821,"_5":13790,"_26439":49766,"_2811":49822},[],"**No Identity**",{"_3323":811,"_29044":793,"_20168":49824,"_5":13790,"_26439":49766,"_2811":49825},[],"A record exists without an associated identity.",{"_3323":812,"_29044":793,"_20168":49827,"_5":13790,"_26439":49766,"_2811":49828},[],"**Active**",{"_3323":813,"_29044":793,"_20168":49830,"_5":13790,"_26439":49766,"_2811":49831},[],"The slot is active; also check certificate dates, status and usages.",{"_3323":814,"_29044":793,"_20168":49833,"_5":13790,"_26439":49766,"_2811":49834},[],"**Renewal Pending**",{"_3323":815,"_29044":793,"_20168":49836,"_5":13790,"_26439":49766,"_2811":49837},[],"The identity is in the operational renewal window.",{"_3323":816,"_29044":793,"_20168":49839,"_5":13790,"_26439":49766,"_2811":49840},[],"**Expiring Soon**",{"_3323":817,"_29044":793,"_20168":49842,"_5":13790,"_26439":49766,"_2811":49843},[],"Expiration is approaching according to configured thresholds.",{"_3323":818,"_29044":793,"_20168":49845,"_5":13790,"_26439":49766,"_2811":49846},[],"**Expired**",{"_3323":819,"_29044":793,"_20168":49848,"_5":13790,"_26439":49766,"_2811":49849},[],"The identity has expired.",{"_3323":820,"_29044":793,"_20168":49851,"_5":13790,"_26439":49766,"_2811":49852},[],"**Revoked**",{"_3323":821,"_29044":793,"_20168":49854,"_5":13790,"_26439":49766,"_2811":49855},[],"The identity is marked revoked.",{"_3323":822,"_29044":793,"_20168":49857,"_5":13790,"_26439":49766,"_2811":49858},[],"**Decommissioned**",{"_3323":823,"_29044":793,"_20168":49860,"_5":13790,"_26439":49766,"_2811":49861},[],"The record is retired and ordinary updates do not restore operation.",{"_3323":824,"_29044":793,"_20168":49863,"_5":13790,"_26439":49766,"_2811":49864},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3323":825,"_29044":793,"_20168":49866,"_5":13790,"_26439":49770,"_2811":49867},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3323":826,"_29044":793,"_20168":49869,"_5":13790,"_26439":49770,"_2811":49870},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3323":827,"_29044":793,"_20168":49872,"_5":13790,"_26439":49770,"_2811":49873},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3323":828,"_29044":793,"_20168":49875,"_5":13790,"_26439":49770,"_2811":49876},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3323":829,"_29044":793,"_20168":49878,"_5":13790,"_26439":49774,"_2811":49879},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3323":830,"_29044":793,"_20168":49881,"_5":13790,"_26439":49778,"_2811":49882},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3323":831,"_29044":793,"_20168":49884,"_5":13790,"_26439":49782,"_2811":49885},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3323":832,"_29044":793,"_20168":49887,"_5":13790,"_26439":49786,"_2811":49888},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3323":833,"_29044":793,"_20168":49890,"_5":13790,"_26439":49790,"_2811":49891},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3323":834,"_29044":793,"_20168":49893,"_5":13790,"_26439":49790,"_2811":49894},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3323":835,"_29044":793,"_20168":49896,"_5":13790,"_26439":49794,"_2811":49897},[],"From **No Identity**, use **Assign Identity**:",{"_3323":836,"_29044":793,"_20168":49899,"_5":13790,"_26439":49794,"_2811":49900},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3323":837,"_29044":793,"_20168":49902,"_5":13790,"_26439":49794,"_2811":49903},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3323":838,"_29044":793,"_20168":49905,"_5":13790,"_26439":49794,"_2811":49906},[],"Confirm and read the serial, active version and history again.",{"_3323":839,"_29044":793,"_20168":49908,"_5":13790,"_26439":49794,"_2811":49909},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3323":840,"_29044":793,"_20168":49911,"_5":13790,"_26439":49794,"_2811":49912},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3323":841,"_29044":793,"_20168":49914,"_5":13790,"_26439":49798,"_2811":49915},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3323":842,"_29044":793,"_20168":49917,"_5":13790,"_26439":49798,"_2811":49918},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3323":843,"_29044":793,"_20168":49920,"_5":13790,"_26439":49802,"_2811":49921},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3323":844,"_29044":793,"_20168":49923,"_5":13790,"_26439":49802,"_2811":49924},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3323":845,"_29044":793,"_20168":49926,"_5":13790,"_26439":49802,"_2811":49927},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3323":846,"_29044":793,"_20168":49929,"_5":13790,"_26439":49802,"_2811":49930},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3323":847,"_29044":793,"_20168":49932,"_5":13790,"_26439":49806,"_2811":49933},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3323":848,"_29044":793,"_20168":49935,"_5":13790,"_26439":49806,"_2811":49936},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3323":849,"_29044":849,"_5":14148,"_2811":49938,"_29388":49939,"_20168":49941,"_26439":849},"Bootstrap identity and authentication",[47299,48748,49759,49757,49940],"Enrollment with PKI",[],{"_3323":850,"_29044":849,"_20168":49943,"_5":13790,"_26439":849,"_2811":49944},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3323":851,"_29044":849,"_5":29385,"_20168":49946,"_26439":49947,"_2811":49948},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3323":852,"_29044":849,"_5":29385,"_20168":49950,"_26439":49951,"_2811":49952},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3323":853,"_29044":849,"_5":29385,"_20168":49954,"_26439":49955,"_2811":49956},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3323":854,"_29044":849,"_5":29385,"_20168":49958,"_26439":49959,"_2811":49960},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3323":855,"_29044":849,"_5":29385,"_20168":49962,"_26439":49963,"_2811":49964},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3323":856,"_29044":849,"_20168":49966,"_5":13790,"_26439":849,"_2811":49967},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3323":857,"_29044":849,"_20168":49969,"_5":13790,"_26439":49947,"_2811":49970},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3323":858,"_29044":849,"_20168":49972,"_5":13790,"_26439":49947,"_2811":49973},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3323":859,"_29044":849,"_20168":49975,"_5":13790,"_26439":49951,"_2811":49976},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3323":860,"_29044":849,"_20168":49978,"_5":13790,"_26439":49951,"_2811":49979},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3323":861,"_29044":849,"_20168":49981,"_5":13790,"_26439":49951,"_2811":49982},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3323":862,"_29044":849,"_20168":49984,"_5":13790,"_26439":49955,"_2811":49985},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3323":863,"_29044":849,"_20168":49987,"_5":13790,"_26439":49955,"_2811":49988},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3323":864,"_29044":849,"_20168":49990,"_5":13790,"_26439":49959,"_2811":49991},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3323":865,"_29044":849,"_20168":49993,"_5":13790,"_26439":49959,"_2811":49994},[],"Example body:",{"_3323":866,"_29044":849,"_20168":49996,"_5":13790,"_26439":49959,"_2811":49997},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3323":867,"_29044":849,"_20168":49999,"_5":13790,"_26439":49959,"_2811":50000},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3323":868,"_29044":849,"_20168":50002,"_5":13790,"_26439":49959,"_2811":50003},[],"Continuation requires a successful HTTP response and JSON:",{"_3323":869,"_29044":849,"_20168":50005,"_5":13790,"_26439":49959,"_2811":50006},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3323":870,"_29044":849,"_20168":50008,"_5":13790,"_26439":49963,"_2811":50009},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3323":871,"_29044":849,"_20168":50011,"_5":13790,"_26439":49963,"_2811":50012},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3323":872,"_29044":872,"_5":14148,"_2811":50014,"_29388":50015,"_20168":50016,"_26439":872},"Configure and operate the DMS",[47299,48748,49759,49757,49940],[],{"_3323":873,"_29044":872,"_20168":50018,"_5":13790,"_26439":872,"_2811":50019},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3323":874,"_29044":872,"_5":29385,"_20168":50021,"_26439":50022,"_2811":47309},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3323":875,"_29044":872,"_5":29385,"_20168":50024,"_26439":50025,"_2811":50026},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3323":876,"_29044":872,"_5":29385,"_20168":50028,"_26439":50029,"_2811":50030},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3323":877,"_29044":872,"_5":29385,"_20168":50032,"_26439":50033,"_2811":50034},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3323":878,"_29044":872,"_5":29385,"_20168":50036,"_26439":50037,"_2811":50038},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3323":879,"_29044":872,"_5":29385,"_20168":50040,"_26439":50041,"_2811":50042},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3323":880,"_29044":872,"_5":29385,"_20168":50044,"_26439":50045,"_2811":50046},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3323":881,"_29044":872,"_5":29385,"_20168":50048,"_26439":50049,"_2811":50050},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3323":882,"_29044":872,"_5":29385,"_20168":50052,"_26439":50053,"_2811":50054},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3323":883,"_29044":872,"_5":29385,"_20168":50056,"_26439":50057,"_2811":50058},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3323":884,"_29044":872,"_5":29385,"_20168":50060,"_26439":50061,"_2811":50062},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3323":885,"_29044":872,"_5":29385,"_20168":50064,"_26439":50065,"_2811":50066},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3323":886,"_29044":872,"_5":29385,"_20168":50068,"_26439":50069,"_2811":50070},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3323":887,"_29044":872,"_5":29385,"_20168":50072,"_26439":50073,"_2811":50074},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3323":888,"_29044":872,"_5":29385,"_20168":50076,"_26439":50077,"_2811":50078},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3323":889,"_29044":872,"_5":29385,"_20168":50080,"_26439":50081,"_2811":50082},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3323":890,"_29044":872,"_5":29385,"_20168":50084,"_26439":50085,"_2811":50086},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3323":891,"_29044":872,"_5":29385,"_20168":50088,"_26439":50089,"_2811":50090},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3323":892,"_29044":872,"_20168":50092,"_5":13790,"_26439":872,"_2811":50093},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3323":893,"_29044":872,"_20168":50095,"_5":13790,"_26439":50022,"_2811":50096},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3323":894,"_29044":872,"_20168":50098,"_5":13790,"_26439":50022,"_2811":50099},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3323":895,"_29044":872,"_20168":50101,"_5":13790,"_26439":50029,"_2811":50102},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3323":896,"_29044":872,"_20168":50104,"_5":13790,"_26439":50033,"_2811":50105},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3323":897,"_29044":872,"_20168":50107,"_5":13790,"_26439":50037,"_2811":50108},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3323":898,"_29044":872,"_20168":50110,"_5":13790,"_26439":50041,"_2811":50111},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3323":899,"_29044":872,"_20168":50113,"_5":13790,"_26439":50045,"_2811":50114},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3323":900,"_29044":872,"_20168":50116,"_5":13790,"_26439":50053,"_2811":50117},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3323":901,"_29044":872,"_20168":50119,"_5":13790,"_26439":50053,"_2811":50120},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3323":902,"_29044":872,"_20168":50122,"_5":13790,"_26439":50057,"_2811":50123},[],"`settings.enrollment_settings` field",{"_3323":903,"_29044":872,"_20168":50125,"_5":13790,"_26439":50057,"_2811":50126},[],"Decision",{"_3323":904,"_29044":872,"_20168":50128,"_5":13790,"_26439":50057,"_2811":50129},[],"`protocol`",{"_3323":905,"_29044":872,"_20168":50131,"_5":13790,"_26439":50057,"_2811":50132},[],"`EST_RFC7030` for these operations.",{"_3323":906,"_29044":872,"_20168":50134,"_5":13790,"_26439":50057,"_2811":50135},[],"`enrollment_ca`",{"_3323":907,"_29044":872,"_20168":50137,"_5":13790,"_26439":50057,"_2811":50138},[],"ID of the signing CA.",{"_3323":908,"_29044":872,"_20168":50140,"_5":13790,"_26439":50057,"_2811":50141},[],"`verify_csr_signature`",{"_3323":909,"_29044":872,"_20168":50143,"_5":13790,"_26439":50057,"_2811":50144},[],"Keep `true` to verify CSR key possession.",{"_3323":910,"_29044":872,"_20168":50146,"_5":13790,"_26439":50057,"_2811":50147},[],"`enable_replaceable_enrollment`",{"_3323":911,"_29044":872,"_20168":50149,"_5":13790,"_26439":50057,"_2811":50150},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3323":912,"_29044":872,"_20168":50152,"_5":13790,"_26439":50057,"_2811":50153},[],"`est_rfc7030_settings.auth_mode`",{"_3323":913,"_29044":872,"_20168":50155,"_5":13790,"_26439":50057,"_2811":50156},[],"One of the four authentication modes.",{"_3323":914,"_29044":872,"_20168":50158,"_5":13790,"_26439":50057,"_2811":50159},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3323":915,"_29044":872,"_20168":50161,"_5":13790,"_26439":50061,"_2811":50162},[],"The blocks are independent:",{"_3323":916,"_29044":872,"_20168":50164,"_5":13790,"_26439":50061,"_2811":50165},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3323":917,"_29044":872,"_20168":50167,"_5":13790,"_26439":50061,"_2811":50168},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3323":918,"_29044":872,"_20168":50170,"_5":13790,"_26439":50061,"_2811":50171},[],"`auth_mode`",{"_3323":919,"_29044":872,"_20168":50173,"_5":13790,"_26439":50061,"_2811":50174},[],"Control applied in the configured operation",{"_3323":920,"_29044":872,"_20168":50176,"_5":13790,"_26439":50061,"_2811":50177},[],"`CLIENT_CERTIFICATE`",{"_3323":921,"_29044":872,"_20168":50179,"_5":13790,"_26439":50061,"_2811":50180},[],"Presented certificate validation.",{"_3323":922,"_29044":872,"_20168":50182,"_5":13790,"_26439":50061,"_2811":50183},[],"`EXTERNAL_WEBHOOK`",{"_3323":923,"_29044":872,"_20168":50185,"_5":13790,"_26439":50061,"_2811":50186},[],"Configured webhook authorization.",{"_3323":924,"_29044":872,"_20168":50188,"_5":13790,"_26439":50061,"_2811":50189},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3323":925,"_29044":872,"_20168":50191,"_5":13790,"_26439":50061,"_2811":50192},[],"Certificate validation followed by webhook approval.",{"_3323":926,"_29044":872,"_20168":50194,"_5":13790,"_26439":50061,"_2811":50195},[],"`NO_AUTH`",{"_3323":927,"_29044":872,"_20168":50197,"_5":13790,"_26439":50061,"_2811":50198},[],"No DMS requester authentication.",{"_3323":928,"_29044":872,"_20168":50200,"_5":13790,"_26439":50061,"_2811":50201},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3323":929,"_29044":872,"_20168":50203,"_5":13790,"_26439":50061,"_2811":50204},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3323":930,"_29044":872,"_20168":50206,"_5":13790,"_26439":50061,"_2811":50207},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3323":931,"_29044":872,"_20168":50209,"_5":13790,"_26439":50061,"_2811":50210},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3323":932,"_29044":872,"_20168":50212,"_5":13790,"_26439":50065,"_2811":50213},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3323":933,"_29044":872,"_20168":50215,"_5":13790,"_26439":50065,"_2811":50216},[],"`external_webhook_settings` field",{"_3323":934,"_29044":872,"_20168":50218,"_5":13790,"_26439":50065,"_2811":50126},[],{"_3323":935,"_29044":872,"_20168":50220,"_5":13790,"_26439":50065,"_2811":50221},[],"`url`",{"_3323":936,"_29044":872,"_20168":50223,"_5":13790,"_26439":50065,"_2811":50224},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3323":937,"_29044":872,"_20168":50226,"_5":13790,"_26439":50065,"_2811":50227},[],"`method`",{"_3323":938,"_29044":872,"_20168":50229,"_5":13790,"_26439":50065,"_2811":50230},[],"`POST` or `PUT`; `POST` by default.",{"_3323":939,"_29044":872,"_20168":50232,"_5":13790,"_26439":50065,"_2811":50233},[],"`name`",{"_3323":940,"_29044":872,"_20168":50235,"_5":13790,"_26439":50065,"_2811":50236},[],"Label used in service logs.",{"_3323":941,"_29044":872,"_20168":50238,"_5":13790,"_26439":50065,"_2811":50239},[],"`config.auth_mode`",{"_3323":942,"_29044":872,"_20168":50241,"_5":13790,"_26439":50065,"_2811":50242},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3323":943,"_29044":872,"_20168":50244,"_5":13790,"_26439":50065,"_2811":50245},[],"`config.log_level`",{"_3323":944,"_29044":872,"_20168":50247,"_5":13790,"_26439":50065,"_2811":50248},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3323":945,"_29044":872,"_20168":50250,"_5":13790,"_26439":50065,"_2811":50251},[],"`config.apikey_options`",{"_3323":946,"_29044":872,"_20168":50253,"_5":13790,"_26439":50065,"_2811":50254},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3323":947,"_29044":872,"_20168":50256,"_5":13790,"_26439":50065,"_2811":50257},[],"`config.jwt_options`",{"_3323":948,"_29044":872,"_20168":50259,"_5":13790,"_26439":50065,"_2811":50260},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3323":949,"_29044":872,"_20168":50262,"_5":13790,"_26439":50065,"_2811":50263},[],"`config.mtls_options`",{"_3323":950,"_29044":872,"_20168":50265,"_5":13790,"_26439":50065,"_2811":50266},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3323":951,"_29044":872,"_20168":50268,"_5":13790,"_26439":50065,"_2811":50269},[],"`config.insecure_skip_verify`",{"_3323":952,"_29044":872,"_20168":50271,"_5":13790,"_26439":50065,"_2811":50272},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3323":953,"_29044":872,"_20168":50274,"_5":13790,"_26439":50065,"_2811":50275},[],"`config.call_timeout`",{"_3323":954,"_29044":872,"_20168":50277,"_5":13790,"_26439":50065,"_2811":50278},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3323":955,"_29044":872,"_20168":50280,"_5":13790,"_26439":50065,"_2811":50281},[],"Rules for that configuration:",{"_3323":956,"_29044":872,"_20168":50283,"_5":13790,"_26439":50065,"_2811":50284},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3323":957,"_29044":872,"_20168":50286,"_5":13790,"_26439":50065,"_2811":50287},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3323":958,"_29044":872,"_20168":50289,"_5":13790,"_26439":50065,"_2811":50290},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3323":959,"_29044":872,"_20168":50292,"_5":13790,"_26439":50065,"_2811":50293},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3323":960,"_29044":872,"_20168":50295,"_5":13790,"_26439":50065,"_2811":50296},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3323":961,"_29044":872,"_20168":50298,"_5":13790,"_26439":50065,"_2811":50299},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3323":962,"_29044":872,"_20168":50301,"_5":13790,"_26439":50065,"_2811":50302},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3323":963,"_29044":872,"_20168":50304,"_5":13790,"_26439":50065,"_2811":50305},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3323":964,"_29044":872,"_20168":50307,"_5":13790,"_26439":50065,"_2811":50308},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3323":965,"_29044":872,"_20168":50310,"_5":13790,"_26439":50069,"_2811":50311},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3323":966,"_29044":872,"_20168":50313,"_5":13790,"_26439":50073,"_2811":50314},[],"`settings.reenrollment_settings` field",{"_3323":967,"_29044":872,"_20168":50316,"_5":13790,"_26439":50073,"_2811":47689},[],{"_3323":968,"_29044":872,"_20168":50318,"_5":13790,"_26439":50073,"_2811":50319},[],"`reenrollment_delta`",{"_3323":969,"_29044":872,"_20168":50321,"_5":13790,"_26439":50073,"_2811":50322},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3323":970,"_29044":872,"_20168":50324,"_5":13790,"_26439":50073,"_2811":50325},[],"`preventive_delta`",{"_3323":971,"_29044":872,"_20168":50327,"_5":13790,"_26439":50073,"_2811":50328},[],"Preventive operational monitoring threshold.",{"_3323":972,"_29044":872,"_20168":50330,"_5":13790,"_26439":50073,"_2811":50331},[],"`critical_delta`",{"_3323":973,"_29044":872,"_20168":50333,"_5":13790,"_26439":50073,"_2811":50334},[],"Critical operational monitoring threshold.",{"_3323":974,"_29044":872,"_20168":50336,"_5":13790,"_26439":50073,"_2811":50337},[],"`enable_expired_renewal`",{"_3323":975,"_29044":872,"_20168":50339,"_5":13790,"_26439":50073,"_2811":50340},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3323":976,"_29044":872,"_20168":50342,"_5":13790,"_26439":50073,"_2811":50343},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3323":977,"_29044":872,"_20168":50345,"_5":13790,"_26439":50073,"_2811":50346},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3323":978,"_29044":872,"_20168":50348,"_5":13790,"_26439":50073,"_2811":50349},[],"`revoke_on_reenrollment`",{"_3323":979,"_29044":872,"_20168":50351,"_5":13790,"_26439":50073,"_2811":50352},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3323":980,"_29044":872,"_20168":50354,"_5":13790,"_26439":50073,"_2811":50355},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3323":981,"_29044":872,"_20168":50357,"_5":13790,"_26439":50077,"_2811":50358},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3323":982,"_29044":872,"_20168":50360,"_5":13790,"_26439":50081,"_2811":47683},[],{"_3323":983,"_29044":872,"_20168":50362,"_5":13790,"_26439":50081,"_2811":50363},[],"Published material",{"_3323":984,"_29044":872,"_20168":50365,"_5":13790,"_26439":50081,"_2811":50366},[],"**Include Lamassu System CA**",{"_3323":985,"_29044":872,"_20168":50368,"_5":13790,"_26439":50081,"_2811":50369},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3323":986,"_29044":872,"_20168":50371,"_5":13790,"_26439":50081,"_2811":50372},[],"**Include Enrollment CA**",{"_3323":987,"_29044":872,"_20168":50374,"_5":13790,"_26439":50081,"_2811":50375},[],"Selected issuing CA certificate.",{"_3323":988,"_29044":872,"_20168":50377,"_5":13790,"_26439":50081,"_2811":50378},[],"**Managed CAs**",{"_3323":989,"_29044":872,"_20168":50380,"_5":13790,"_26439":50081,"_2811":50381},[],"Explicitly selected CA certificates.",{"_3323":990,"_29044":872,"_20168":50383,"_5":13790,"_26439":50081,"_2811":50384},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3323":991,"_29044":872,"_20168":50386,"_5":13790,"_26439":50085,"_2811":50387},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3323":992,"_29044":872,"_20168":50389,"_5":13790,"_26439":50085,"_2811":50390},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3323":993,"_29044":872,"_20168":50392,"_5":13790,"_26439":50085,"_2811":50393},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3323":994,"_29044":872,"_20168":50395,"_5":13790,"_26439":50089,"_2811":50396},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3323":995,"_29044":995,"_5":14148,"_2811":50398,"_29388":50399,"_20168":50400,"_26439":995},"Integrate the EST client",[47299,48748,49759,49757,49940],[],{"_3323":996,"_29044":995,"_20168":50402,"_5":13790,"_26439":995,"_2811":50403},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3323":997,"_29044":995,"_5":29385,"_20168":50405,"_26439":50406,"_2811":47309},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3323":998,"_29044":995,"_5":29385,"_20168":50408,"_26439":50409,"_2811":50410},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3323":999,"_29044":995,"_5":29385,"_20168":50412,"_26439":50413,"_2811":50414},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3323":1000,"_29044":995,"_5":29385,"_20168":50416,"_26439":50417,"_2811":50418},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3323":1001,"_29044":995,"_5":29385,"_20168":50420,"_26439":50421,"_2811":50422},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3323":1002,"_29044":995,"_5":29385,"_20168":50424,"_26439":50425,"_2811":50426},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3323":1003,"_29044":995,"_20168":50428,"_5":13790,"_26439":995,"_2811":50429},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3323":1004,"_29044":995,"_20168":50431,"_5":13790,"_26439":50406,"_2811":50432},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3323":1005,"_29044":995,"_20168":50434,"_5":13790,"_26439":50406,"_2811":50435},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3323":1006,"_29044":995,"_20168":50437,"_5":13790,"_26439":50406,"_2811":50438},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3323":1007,"_29044":995,"_20168":50440,"_5":13790,"_26439":50409,"_2811":50441},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3323":1008,"_29044":995,"_20168":50443,"_5":13790,"_26439":50409,"_2811":50444},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3323":1009,"_29044":995,"_20168":50446,"_5":13790,"_26439":50413,"_2811":50447},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3323":1010,"_29044":995,"_20168":50449,"_5":13790,"_26439":50413,"_2811":50450},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3323":1011,"_29044":995,"_20168":50452,"_5":13790,"_26439":50417,"_2811":50453},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3323":1012,"_29044":995,"_20168":50455,"_5":13790,"_26439":50417,"_2811":50456},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3323":1013,"_29044":995,"_20168":50458,"_5":13790,"_26439":50421,"_2811":50459},[],"For a root that issues directly:",{"_3323":1014,"_29044":995,"_20168":50461,"_5":13790,"_26439":50421,"_2811":50462},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3323":1015,"_29044":995,"_20168":50464,"_5":13790,"_26439":50421,"_2811":50465},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3323":1016,"_29044":995,"_20168":50467,"_5":13790,"_26439":50425,"_2811":50468},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3323":1017,"_29044":1017,"_5":14148,"_2811":50470,"_29388":50471,"_20168":50472,"_26439":1017},"EST reference",[47299,48748,49759,49757,49940],[],{"_3323":1018,"_29044":1017,"_20168":50474,"_5":13790,"_26439":1017,"_2811":50475},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3323":1019,"_29044":1017,"_5":29385,"_20168":50477,"_26439":50478,"_2811":50479},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3323":1020,"_29044":1017,"_5":29385,"_20168":50481,"_26439":50482,"_2811":21892},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3323":1021,"_29044":1017,"_5":29385,"_20168":50484,"_26439":50485,"_2811":25084},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3323":1022,"_29044":1017,"_5":29385,"_20168":50487,"_26439":50488,"_2811":25091},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3323":1023,"_29044":1017,"_5":29385,"_20168":50490,"_26439":50491,"_2811":24424},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3323":1024,"_29044":1017,"_5":29385,"_20168":50493,"_26439":50494,"_2811":50495},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3323":1025,"_29044":1017,"_5":29385,"_20168":50497,"_26439":50498,"_2811":50499},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3323":1026,"_29044":1017,"_5":29385,"_20168":50501,"_26439":50502,"_2811":50503},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3323":1027,"_29044":1017,"_20168":50505,"_5":13790,"_26439":1017,"_2811":50506},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3323":1028,"_29044":1017,"_20168":50508,"_5":13790,"_26439":50478,"_2811":50509},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3323":1029,"_29044":1017,"_20168":50511,"_5":13790,"_26439":50478,"_2811":50512},[],"Operation",{"_3323":1030,"_29044":1017,"_20168":50514,"_5":13790,"_26439":50478,"_2811":50515},[],"Method",{"_3323":1031,"_29044":1017,"_20168":50517,"_5":13790,"_26439":50478,"_2811":50518},[],"Authentication and condition",{"_3323":1032,"_29044":1017,"_20168":50520,"_5":13790,"_26439":50478,"_2811":50521},[],"`/cacerts`",{"_3323":1033,"_29044":1017,"_20168":50523,"_5":13790,"_26439":50478,"_2811":50524},[],"GET",{"_3323":1034,"_29044":1017,"_20168":50526,"_5":13790,"_26439":50478,"_2811":50527},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3323":1035,"_29044":1017,"_20168":50529,"_5":13790,"_26439":50478,"_2811":50530},[],"`/simpleenroll`",{"_3323":1036,"_29044":1017,"_20168":50532,"_5":13790,"_26439":50478,"_2811":50533},[],"POST",{"_3323":1037,"_29044":1017,"_20168":50535,"_5":13790,"_26439":50478,"_2811":50536},[],"Initial authentication and DMS registration/replacement policy.",{"_3323":1038,"_29044":1017,"_20168":50538,"_5":13790,"_26439":50478,"_2811":50539},[],"`/simplereenroll`",{"_3323":1039,"_29044":1017,"_20168":50541,"_5":13790,"_26439":50478,"_2811":50533},[],{"_3323":1040,"_29044":1017,"_20168":50543,"_5":13790,"_26439":50478,"_2811":50544},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3323":1041,"_29044":1017,"_20168":50546,"_5":13790,"_26439":50478,"_2811":50547},[],"`/serverkeygen`",{"_3323":1042,"_29044":1017,"_20168":50549,"_5":13790,"_26439":50478,"_2811":50533},[],{"_3323":1043,"_29044":1017,"_20168":50551,"_5":13790,"_26439":50478,"_2811":50552},[],"Initial authentication and admission; server generation enabled.",{"_3323":1044,"_29044":1017,"_20168":50554,"_5":13790,"_26439":50478,"_2811":50555},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3323":1045,"_29044":1017,"_20168":50557,"_5":13790,"_26439":50482,"_2811":50558},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3323":1046,"_29044":1017,"_20168":50560,"_5":13790,"_26439":50482,"_2811":50561},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3323":1047,"_29044":1017,"_20168":50563,"_5":13790,"_26439":50485,"_2811":50564},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3323":1048,"_29044":1017,"_20168":50566,"_5":13790,"_26439":50485,"_2811":50567},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3323":1049,"_29044":1017,"_20168":50569,"_5":13790,"_26439":50488,"_2811":50570},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3323":1050,"_29044":1017,"_20168":50572,"_5":13790,"_26439":50488,"_2811":50573},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3323":1051,"_29044":1017,"_20168":50575,"_5":13790,"_26439":50491,"_2811":50576},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3323":1052,"_29044":1017,"_20168":50578,"_5":13790,"_26439":50491,"_2811":50579},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3323":1053,"_29044":1017,"_20168":50581,"_5":13790,"_26439":50494,"_2811":50582},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3323":1054,"_29044":1017,"_20168":50584,"_5":13790,"_26439":50494,"_2811":50585},[],"Part",{"_3323":1055,"_29044":1017,"_20168":50587,"_5":13790,"_26439":50494,"_2811":50588},[],"Content after decoding its Base64",{"_3323":1056,"_29044":1017,"_20168":50590,"_5":13790,"_26439":50494,"_2811":50591},[],"`application/pkcs8`",{"_3323":1057,"_29044":1017,"_20168":50593,"_5":13790,"_26439":50494,"_2811":50594},[],"Unencrypted DER PKCS#8 private key.",{"_3323":1058,"_29044":1017,"_20168":50596,"_5":13790,"_26439":50494,"_2811":50597},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3323":1059,"_29044":1017,"_20168":50599,"_5":13790,"_26439":50494,"_2811":50600},[],"DER PKCS#7 containing the issued certificate.",{"_3323":1060,"_29044":1017,"_20168":50602,"_5":13790,"_26439":50494,"_2811":50603},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3323":1061,"_29044":1017,"_20168":50605,"_5":13790,"_26439":50498,"_2811":50606},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3323":1062,"_29044":1017,"_20168":50608,"_5":13790,"_26439":50498,"_2811":50609},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3323":1063,"_29044":1017,"_20168":50611,"_5":13790,"_26439":50498,"_2811":50612},[],"Convert and check the result:",{"_3323":1064,"_29044":1017,"_20168":50614,"_5":13790,"_26439":50498,"_2811":50615},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3323":1065,"_29044":1017,"_20168":50617,"_5":13790,"_26439":50502,"_2811":50618},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3323":1066,"_29044":1017,"_20168":50620,"_5":13790,"_26439":50502,"_2811":50621},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3323":1067,"_29044":1067,"_5":14148,"_2811":49940,"_29388":50623,"_20168":50624,"_26439":1067},[47299,48748,49759,49757,49940],[],{"_3323":1068,"_29044":1067,"_20168":50626,"_5":13790,"_26439":1067,"_2811":50627},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3323":1069,"_29044":1067,"_5":29385,"_20168":50629,"_26439":50630,"_2811":50631},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3323":1070,"_29044":1067,"_5":29385,"_20168":50633,"_26439":50634,"_2811":50635},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3323":1071,"_29044":1067,"_5":29385,"_20168":50637,"_26439":50638,"_2811":50639},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3323":1072,"_29044":1067,"_5":29385,"_20168":50641,"_26439":50642,"_2811":50643},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3323":1073,"_29044":1067,"_20168":50645,"_5":13790,"_26439":1067,"_2811":50646},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3323":1074,"_29044":1067,"_20168":50648,"_5":13790,"_26439":50630,"_2811":50649},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3323":1075,"_29044":1067,"_20168":50651,"_5":13790,"_26439":50630,"_2811":50652},[],"The integrator installs initial EST server trust and an admission credential.",{"_3323":1076,"_29044":1067,"_20168":50654,"_5":13790,"_26439":50630,"_2811":50655},[],"The client requests an identity for its `Device ID` through EST.",{"_3323":1077,"_29044":1067,"_20168":50657,"_5":13790,"_26439":50630,"_2811":50658},[],"Certificate, device binding and key/certificate installation are checked.",{"_3323":1078,"_29044":1067,"_20168":50660,"_5":13790,"_26439":50630,"_2811":50661},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3323":1079,"_29044":1067,"_20168":50663,"_5":13790,"_26439":50630,"_2811":50664},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3323":1080,"_29044":1067,"_20168":50666,"_5":13790,"_26439":50634,"_2811":50667},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3323":1081,"_29044":1067,"_20168":50669,"_5":13790,"_26439":50634,"_2811":50670},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3323":1082,"_29044":1067,"_20168":50672,"_5":13790,"_26439":50634,"_2811":50673},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3323":1083,"_29044":1067,"_20168":50675,"_5":13790,"_26439":50634,"_2811":50676},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3323":1084,"_29044":1067,"_20168":50678,"_5":13790,"_26439":50638,"_2811":50679},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3323":1085,"_29044":1067,"_20168":50681,"_5":13790,"_26439":50638,"_2811":50682},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3323":1086,"_29044":1067,"_20168":50684,"_5":13790,"_26439":50638,"_2811":50685},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3323":1087,"_29044":1067,"_20168":50687,"_5":13790,"_26439":50638,"_2811":50688},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3323":1088,"_29044":1067,"_20168":50690,"_5":13790,"_26439":50642,"_2811":50691},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3323":1089,"_29044":1067,"_20168":50693,"_5":13790,"_26439":50642,"_2811":50694},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3323":1090,"_29044":1090,"_5":14148,"_2811":50696,"_29388":50697,"_20168":50698,"_26439":1090},"Provisioning strategies",[47299,48748,49759,49757,49940],[],{"_3323":1091,"_29044":1090,"_20168":50700,"_5":13790,"_26439":1090,"_2811":50701},[],"Choose device registration, identity authorization and key generation.",{"_3323":1092,"_29044":1090,"_5":29385,"_20168":50703,"_26439":50704,"_2811":50705},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3323":1093,"_29044":1090,"_5":29385,"_20168":50707,"_26439":50708,"_2811":50709},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3323":1094,"_29044":1090,"_5":29385,"_20168":50711,"_26439":50712,"_2811":50713},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3323":1095,"_29044":1090,"_5":29385,"_20168":50715,"_26439":50716,"_2811":50717},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3323":1096,"_29044":1090,"_5":29385,"_20168":50719,"_26439":50720,"_2811":50721},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3323":1097,"_29044":1090,"_20168":50723,"_5":13790,"_26439":1090,"_2811":50724},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3323":1098,"_29044":1090,"_20168":50726,"_5":13790,"_26439":50704,"_2811":50727},[],"Path",{"_3323":1099,"_29044":1090,"_20168":50729,"_5":13790,"_26439":50704,"_2811":50730},[],"When the device exists",{"_3323":1100,"_29044":1090,"_20168":50732,"_5":13790,"_26439":50704,"_2811":50733},[],"What to check",{"_3323":1101,"_29044":1090,"_20168":50735,"_5":13790,"_26439":50704,"_2811":50736},[],"Manual assignment",{"_3323":1102,"_29044":1090,"_20168":50738,"_5":13790,"_26439":50704,"_2811":50739},[],"An operator creates it before associating a certificate.",{"_3323":1103,"_29044":1090,"_20168":50741,"_5":13790,"_26439":50704,"_2811":50742},[],"ID, owning DMS, certificate CN and bound serial.",{"_3323":1104,"_29044":1090,"_20168":50744,"_5":13790,"_26439":50704,"_2811":50745},[],"EST with `JITP`",{"_3323":1105,"_29044":1090,"_20168":50747,"_5":13790,"_26439":50704,"_2811":50748},[],"Created for an unknown CN during `/simpleenroll`.",{"_3323":1106,"_29044":1090,"_20168":50750,"_5":13790,"_26439":50704,"_2811":50751},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3323":1107,"_29044":1090,"_20168":50753,"_5":13790,"_26439":50704,"_2811":50754},[],"EST with `PRE_REGISTRATION`",{"_3323":1108,"_29044":1090,"_20168":50756,"_5":13790,"_26439":50704,"_2811":50757},[],"Must exist before `/simpleenroll`.",{"_3323":1109,"_29044":1090,"_20168":50759,"_5":13790,"_26439":50704,"_2811":50760},[],"Approved record, same DMS and replacement conditions for your version.",{"_3323":1110,"_29044":1090,"_20168":50762,"_5":13790,"_26439":50704,"_2811":50763},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3323":1111,"_29044":1090,"_20168":50765,"_5":13790,"_26439":50704,"_2811":50766},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3323":1112,"_29044":1090,"_20168":50768,"_5":13790,"_26439":50708,"_2811":50769},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3323":1113,"_29044":1090,"_20168":50771,"_5":13790,"_26439":50708,"_2811":50772},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3323":1114,"_29044":1090,"_20168":50774,"_5":13790,"_26439":50708,"_2811":50775},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3323":1115,"_29044":1090,"_20168":50777,"_5":13790,"_26439":50712,"_2811":50778},[],"Decide initial enrollment and re-enrollment separately:",{"_3323":1116,"_29044":1090,"_20168":50780,"_5":13790,"_26439":50712,"_2811":50781},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3323":1117,"_29044":1090,"_20168":50783,"_5":13790,"_26439":50712,"_2811":50784},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3323":1118,"_29044":1090,"_20168":50786,"_5":13790,"_26439":50712,"_2811":50787},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3323":1119,"_29044":1090,"_20168":50789,"_5":13790,"_26439":50712,"_2811":50790},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3323":1120,"_29044":1090,"_20168":50792,"_5":13790,"_26439":50712,"_2811":50793},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3323":1121,"_29044":1090,"_20168":50795,"_5":13790,"_26439":50716,"_2811":47683},[],{"_3323":1122,"_29044":1090,"_20168":50797,"_5":13790,"_26439":50716,"_2811":50798},[],"Material crossing EST",{"_3323":1123,"_29044":1090,"_20168":50800,"_5":13790,"_26439":50716,"_2811":50801},[],"Device-generated key",{"_3323":1124,"_29044":1090,"_20168":50803,"_5":13790,"_26439":50716,"_2811":50804},[],"Public CSR and certificate; the key stays on the client.",{"_3323":1125,"_29044":1090,"_20168":50806,"_5":13790,"_26439":50716,"_2811":50807},[],"Existing device key",{"_3323":1126,"_29044":1090,"_20168":50809,"_5":13790,"_26439":50716,"_2811":50810},[],"CSR signed with that key and a new certificate.",{"_3323":1127,"_29044":1090,"_20168":50812,"_5":13790,"_26439":50716,"_2811":50078},[],{"_3323":1128,"_29044":1090,"_20168":50814,"_5":13790,"_26439":50716,"_2811":50815},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3323":1129,"_29044":1090,"_20168":50817,"_5":13790,"_26439":50716,"_2811":50818},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3323":1130,"_29044":1090,"_20168":50820,"_5":13790,"_26439":50720,"_2811":50821},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3323":1131,"_29044":1131,"_5":14148,"_2811":50823,"_29388":50824,"_20168":50825,"_26439":1131},"Renewal and recovery",[47299,48748,49759,49757,49940],[],{"_3323":1132,"_29044":1131,"_20168":50827,"_5":13790,"_26439":1131,"_2811":50828},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3323":1133,"_29044":1131,"_5":29385,"_20168":50830,"_26439":50831,"_2811":50832},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3323":1134,"_29044":1131,"_5":29385,"_20168":50834,"_26439":50835,"_2811":50836},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3323":1135,"_29044":1131,"_5":29385,"_20168":50838,"_26439":50839,"_2811":50840},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3323":1136,"_29044":1131,"_5":29385,"_20168":50842,"_26439":50843,"_2811":50844},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3323":1137,"_29044":1131,"_5":29385,"_20168":50846,"_26439":50847,"_2811":50848},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3323":1138,"_29044":1131,"_20168":50850,"_5":13790,"_26439":1131,"_2811":50851},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3323":1139,"_29044":1131,"_20168":50853,"_5":13790,"_26439":50831,"_2811":50854},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3323":1140,"_29044":1131,"_20168":50856,"_5":13790,"_26439":50831,"_2811":50857},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3323":1141,"_29044":1131,"_20168":50859,"_5":13790,"_26439":50831,"_2811":50860},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3323":1142,"_29044":1131,"_20168":50862,"_5":13790,"_26439":50831,"_2811":50863},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3323":1143,"_29044":1131,"_20168":50865,"_5":13790,"_26439":50835,"_2811":50866},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3323":1144,"_29044":1131,"_20168":50868,"_5":13790,"_26439":50835,"_2811":50869},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3323":1145,"_29044":1131,"_20168":50871,"_5":13790,"_26439":50839,"_2811":50872},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3323":1146,"_29044":1131,"_20168":50874,"_5":13790,"_26439":50839,"_2811":50875},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3323":1147,"_29044":1131,"_20168":50877,"_5":13790,"_26439":50839,"_2811":50878},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3323":1148,"_29044":1131,"_20168":50880,"_5":13790,"_26439":50843,"_2811":50881},[],"Situation",{"_3323":1149,"_29044":1131,"_20168":50883,"_5":13790,"_26439":50843,"_2811":50884},[],"Procedure",{"_3323":1150,"_29044":1131,"_20168":50886,"_5":13790,"_26439":50843,"_2811":50887},[],"Valid certificate, outside the window",{"_3323":1151,"_29044":1131,"_20168":50889,"_5":13790,"_26439":50843,"_2811":50890},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3323":1152,"_29044":1131,"_20168":50892,"_5":13790,"_26439":50843,"_2811":50893},[],"Expired certificate, key available",{"_3323":1153,"_29044":1131,"_20168":50895,"_5":13790,"_26439":50843,"_2811":50896},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3323":1154,"_29044":1131,"_20168":50898,"_5":13790,"_26439":50843,"_2811":50899},[],"Renewal through webhook or `NO_AUTH`",{"_3323":1155,"_29044":1131,"_20168":50901,"_5":13790,"_26439":50843,"_2811":50902},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3323":1156,"_29044":1131,"_20168":50904,"_5":13790,"_26439":50843,"_2811":50905},[],"Lost or inaccessible key",{"_3323":1157,"_29044":1131,"_20168":50907,"_5":13790,"_26439":50843,"_2811":50908},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3323":1158,"_29044":1131,"_20168":50910,"_5":13790,"_26439":50843,"_2811":50911},[],"Current identity revoked",{"_3323":1159,"_29044":1131,"_20168":50913,"_5":13790,"_26439":50843,"_2811":50914},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3323":1160,"_29044":1131,"_20168":50916,"_5":13790,"_26439":50843,"_2811":50917},[],"Device without an identity",{"_3323":1161,"_29044":1131,"_20168":50919,"_5":13790,"_26439":50843,"_2811":50920},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3323":1162,"_29044":1131,"_20168":50922,"_5":13790,"_26439":50843,"_2811":50923},[],"Retired device",{"_3323":1163,"_29044":1131,"_20168":50925,"_5":13790,"_26439":50843,"_2811":50926},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3323":1164,"_29044":1131,"_20168":50928,"_5":13790,"_26439":50843,"_2811":50929},[],"Timeout, HTTP 500 or installation failure",{"_3323":1165,"_29044":1131,"_20168":50931,"_5":13790,"_26439":50843,"_2811":50932},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3323":1166,"_29044":1131,"_20168":50934,"_5":13790,"_26439":50847,"_2811":50935},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3323":1167,"_29044":1131,"_20168":50937,"_5":13790,"_26439":50847,"_2811":50938},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3323":1168,"_29044":1168,"_5":14148,"_2811":50940,"_29388":50941,"_20168":50942,"_26439":1168},"Enrollment troubleshooting",[47299,48748,49759,49757,49940],[],{"_3323":1169,"_29044":1168,"_20168":50944,"_5":13790,"_26439":1168,"_2811":50945},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3323":1170,"_29044":1168,"_5":29385,"_20168":50947,"_26439":50948,"_2811":50949},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3323":1171,"_29044":1168,"_5":29385,"_20168":50951,"_26439":50952,"_2811":50953},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3323":1172,"_29044":1168,"_5":29385,"_20168":50955,"_26439":50956,"_2811":50503},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3323":1173,"_29044":1168,"_5":29385,"_20168":50958,"_26439":50959,"_2811":50960},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3323":1174,"_29044":1168,"_20168":50962,"_5":13790,"_26439":1168,"_2811":50963},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3323":1175,"_29044":1168,"_20168":50965,"_5":13790,"_26439":50952,"_2811":50966},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3323":1176,"_29044":1168,"_20168":50968,"_5":13790,"_26439":50952,"_2811":50969},[],"Symptom or message",{"_3323":1177,"_29044":1168,"_20168":50971,"_5":13790,"_26439":50952,"_2811":50733},[],{"_3323":1178,"_29044":1168,"_20168":50973,"_5":13790,"_26439":50952,"_2811":50974},[],"curl rejects TLS, name or issuer",{"_3323":1179,"_29044":1168,"_20168":50976,"_5":13790,"_26439":50952,"_2811":50977},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3323":1180,"_29044":1168,"_20168":50979,"_5":13790,"_26439":50952,"_2811":50980},[],"404 or missing APS",{"_3323":1181,"_29044":1168,"_20168":50982,"_5":13790,"_26439":50952,"_2811":50983},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3323":1182,"_29044":1168,"_20168":50985,"_5":13790,"_26439":50952,"_2811":50986},[],"400, CSR or format error",{"_3323":1183,"_29044":1168,"_20168":50988,"_5":13790,"_26439":50952,"_2811":50989},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3323":1184,"_29044":1168,"_20168":50991,"_5":13790,"_26439":50952,"_2811":50992},[],"Missing credential or invalid certificate",{"_3323":1185,"_29044":1168,"_20168":50994,"_5":13790,"_26439":50952,"_2811":50995},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3323":1186,"_29044":1168,"_20168":50997,"_5":13790,"_26439":50952,"_2811":50998},[],"Webhook denies, times out or responds without authorization",{"_3323":1187,"_29044":1168,"_20168":51000,"_5":13790,"_26439":50952,"_2811":51001},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3323":1188,"_29044":1168,"_20168":51003,"_5":13790,"_26439":50952,"_2811":51004},[],"`unexpected status code: <n>: redirects are not followed`",{"_3323":1189,"_29044":1168,"_20168":51006,"_5":13790,"_26439":50952,"_2811":51007},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3323":1190,"_29044":1168,"_20168":51009,"_5":13790,"_26439":50952,"_2811":51010},[],"`webhook response exceeds 1048576 bytes`",{"_3323":1191,"_29044":1168,"_20168":51012,"_5":13790,"_26439":50952,"_2811":51013},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3323":1192,"_29044":1168,"_20168":51015,"_5":13790,"_26439":50952,"_2811":51016},[],"`webhook config must not reference files`",{"_3323":1193,"_29044":1168,"_20168":51018,"_5":13790,"_26439":50952,"_2811":51019},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3323":1194,"_29044":1168,"_20168":51021,"_5":13790,"_26439":50952,"_2811":51022},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3323":1195,"_29044":1168,"_20168":51024,"_5":13790,"_26439":50952,"_2811":51025},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3323":1196,"_29044":1168,"_20168":51027,"_5":13790,"_26439":50952,"_2811":51028},[],"`webhook mTLS certificate and key are invalid: …`",{"_3323":1197,"_29044":1168,"_20168":51030,"_5":13790,"_26439":50952,"_2811":51031},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3323":1198,"_29044":1168,"_20168":51033,"_5":13790,"_26439":50952,"_2811":51034},[],"400 `struct validation error` creating or updating a DMS",{"_3323":1199,"_29044":1168,"_20168":51036,"_5":13790,"_26439":50952,"_2811":51037},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3323":1200,"_29044":1168,"_20168":51039,"_5":13790,"_26439":50952,"_2811":51040},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3323":1201,"_29044":1168,"_20168":51042,"_5":13790,"_26439":50952,"_2811":51043},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3323":1202,"_29044":1168,"_20168":51045,"_5":13790,"_26439":50952,"_2811":51046},[],"`device not preregistered`",{"_3323":1203,"_29044":1168,"_20168":51048,"_5":13790,"_26439":50952,"_2811":51049},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3323":1204,"_29044":1168,"_20168":51051,"_5":13790,"_26439":50952,"_2811":51052},[],"`forbiddenNewEnrollment`",{"_3323":1205,"_29044":1168,"_20168":51054,"_5":13790,"_26439":50952,"_2811":51055},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3323":1206,"_29044":1168,"_20168":51057,"_5":13790,"_26439":50952,"_2811":51058},[],"Different owning DMS",{"_3323":1207,"_29044":1168,"_20168":51060,"_5":13790,"_26439":50952,"_2811":51061},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3323":1208,"_29044":1168,"_20168":51063,"_5":13790,"_26439":50952,"_2811":51064},[],"`invalid RawSubject bytes`",{"_3323":1209,"_29044":1168,"_20168":51066,"_5":13790,"_26439":50952,"_2811":51067},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3323":1210,"_29044":1168,"_20168":51069,"_5":13790,"_26439":50952,"_2811":51070},[],"`invalid reenroll window`",{"_3323":1211,"_29044":1168,"_20168":51072,"_5":13790,"_26439":50952,"_2811":51073},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3323":1212,"_29044":1168,"_20168":51075,"_5":13790,"_26439":50952,"_2811":51076},[],"Current certificate revoked",{"_3323":1213,"_29044":1168,"_20168":51078,"_5":13790,"_26439":50952,"_2811":51079},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3323":1214,"_29044":1168,"_20168":51081,"_5":13790,"_26439":50952,"_2811":51082},[],"CA, profile or signing error",{"_3323":1215,"_29044":1168,"_20168":51084,"_5":13790,"_26439":50952,"_2811":51085},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3323":1216,"_29044":1168,"_20168":51087,"_5":13790,"_26439":50952,"_2811":51088},[],"HTTP 200 without a device connection",{"_3323":1217,"_29044":1168,"_20168":51090,"_5":13790,"_26439":50952,"_2811":51091},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3323":1218,"_29044":1168,"_20168":51093,"_5":13790,"_26439":50952,"_2811":51094},[],"Timeout or error after issuance",{"_3323":1219,"_29044":1168,"_20168":51096,"_5":13790,"_26439":50952,"_2811":51097},[],"New certificates, current slot and previous identity's state before retrying.",{"_3323":1220,"_29044":1168,"_20168":51099,"_5":13790,"_26439":50956,"_2811":51100},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3323":1221,"_29044":1168,"_20168":51102,"_5":13790,"_26439":50956,"_2811":51103},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3323":1222,"_29044":1168,"_20168":51105,"_5":13790,"_26439":50959,"_2811":51106},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3323":1223,"_29044":1168,"_20168":51108,"_5":13790,"_26439":50959,"_2811":51109},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3323":1224,"_29044":1168,"_20168":51111,"_5":13790,"_26439":50959,"_2811":51112},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3323":1225,"_29044":1168,"_20168":51114,"_5":13790,"_26439":50959,"_2811":51115},[],"Make one request, save headers/body and query the device and certificates.",{"_3323":1226,"_29044":1168,"_20168":51117,"_5":13790,"_26439":50959,"_2811":51118},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3323":1227,"_29044":1168,"_20168":51120,"_5":13790,"_26439":50959,"_2811":51121},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3323":1228,"_29044":1168,"_20168":51123,"_5":13790,"_26439":50959,"_2811":51124},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3323":1229,"_29044":1229,"_5":14148,"_2811":51126,"_29388":51127,"_20168":51128,"_26439":1229},"Trust distribution and updates",[47299,48748,49759,49757,49940],[],{"_3323":1230,"_29044":1229,"_20168":51130,"_5":13790,"_26439":1229,"_2811":51131},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3323":1231,"_29044":1229,"_5":29385,"_20168":51133,"_26439":51134,"_2811":51135},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3323":1232,"_29044":1229,"_5":29385,"_20168":51137,"_26439":51138,"_2811":51139},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3323":1233,"_29044":1229,"_5":29385,"_20168":51141,"_26439":51142,"_2811":51143},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3323":1234,"_29044":1229,"_5":29385,"_20168":51145,"_26439":51146,"_2811":51147},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3323":1235,"_29044":1229,"_5":29385,"_20168":51149,"_26439":51150,"_2811":51151},[],"/docs/pr-preview/pr-46/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3323":1236,"_29044":1229,"_20168":51153,"_5":13790,"_26439":1229,"_2811":51154},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3323":1237,"_29044":1229,"_20168":51156,"_5":13790,"_26439":51134,"_2811":51157},[],"Relationship",{"_3323":1238,"_29044":1229,"_20168":51159,"_5":13790,"_26439":51134,"_2811":51160},[],"Material prepared by its owner",{"_3323":1239,"_29044":1229,"_20168":51162,"_5":13790,"_26439":51134,"_2811":51163},[],"Device → EST server",{"_3323":1240,"_29044":1229,"_20168":51165,"_5":13790,"_26439":51134,"_2811":51166},[],"Previously verified server root, chain or pin and TLS name.",{"_3323":1241,"_29044":1229,"_20168":51168,"_5":13790,"_26439":51134,"_2811":51169},[],"DMS → requester",{"_3323":1242,"_29044":1229,"_20168":51171,"_5":13790,"_26439":51134,"_2811":51172},[],"CAs and rules authorizing initial or renewal credentials.",{"_3323":1243,"_29044":1229,"_20168":51174,"_5":13790,"_26439":51134,"_2811":51175},[],"Consumer → device",{"_3323":1244,"_29044":1229,"_20168":51177,"_5":13790,"_26439":51134,"_2811":51178},[],"Operational identity roots, intermediates, validation and permissions.",{"_3323":1245,"_29044":1229,"_20168":51180,"_5":13790,"_26439":51134,"_2811":51181},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3323":1246,"_29044":1229,"_20168":51183,"_5":13790,"_26439":51138,"_2811":51184},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3323":1247,"_29044":1229,"_20168":51186,"_5":13790,"_26439":51138,"_2811":51187},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3323":1248,"_29044":1229,"_20168":51189,"_5":13790,"_26439":51142,"_2811":51190},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3323":1249,"_29044":1229,"_20168":51192,"_5":13790,"_26439":51142,"_2811":51193},[],"Select policy-approved roots as anchors.",{"_3323":1250,"_29044":1229,"_20168":51195,"_5":13790,"_26439":51142,"_2811":51196},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3323":1251,"_29044":1229,"_20168":51198,"_5":13790,"_26439":51142,"_2811":51199},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3323":1252,"_29044":1229,"_20168":51201,"_5":13790,"_26439":51142,"_2811":51202},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3323":1253,"_29044":1229,"_20168":51204,"_5":13790,"_26439":51142,"_2811":51205},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3323":1254,"_29044":1229,"_20168":51207,"_5":13790,"_26439":51146,"_2811":51208},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3323":1255,"_29044":1229,"_20168":51210,"_5":13790,"_26439":51146,"_2811":51211},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3323":1256,"_29044":1229,"_20168":51213,"_5":13790,"_26439":51146,"_2811":51214},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3323":1257,"_29044":1229,"_20168":51216,"_5":13790,"_26439":51150,"_2811":51217},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3323":1258,"_29044":1258,"_5":14148,"_2811":51219,"_29388":51220,"_20168":51222,"_26439":1258},"AWS IoT Core",[47299,48748,49759,49757,51221],"Integrations",[],{"_3323":1259,"_29044":1258,"_20168":51224,"_5":13790,"_26439":1258,"_2811":51225},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3323":1260,"_29044":1258,"_5":29385,"_20168":51227,"_26439":51228,"_2811":51229},[],"/docs/pr-preview/pr-46/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3323":1261,"_29044":1258,"_5":29385,"_20168":51231,"_26439":51232,"_2811":51233},[],"/docs/pr-preview/pr-46/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3323":1262,"_29044":1258,"_5":29385,"_20168":51235,"_26439":51236,"_2811":51237},[],"/docs/pr-preview/pr-46/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3323":1263,"_29044":1258,"_5":29385,"_20168":51239,"_26439":51240,"_2811":51241},[],"/docs/pr-preview/pr-46/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3323":1264,"_29044":1258,"_5":29385,"_20168":51243,"_26439":51244,"_2811":51245},[],"/docs/pr-preview/pr-46/platform/iot-fleets/integrations/aws-iot-core#resource-state-machine","Resource state machine",{"_3323":1265,"_29044":1258,"_5":29385,"_20168":51247,"_26439":51248,"_2811":51249},[],"/docs/pr-preview/pr-46/platform/iot-fleets/integrations/aws-iot-core#events-the-connector-handles","Events the connector handles",{"_3323":1266,"_29044":1258,"_5":29385,"_20168":51251,"_26439":51252,"_2811":51253},[],"/docs/pr-preview/pr-46/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3323":1267,"_29044":1258,"_5":29385,"_20168":51255,"_26439":51256,"_2811":51257},[],"/docs/pr-preview/pr-46/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3323":1268,"_29044":1258,"_5":29385,"_20168":51259,"_26439":51260,"_2811":51261},[],"/docs/pr-preview/pr-46/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3323":1269,"_29044":1258,"_5":29385,"_20168":51263,"_26439":51264,"_2811":51265},[],"/docs/pr-preview/pr-46/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3323":1270,"_29044":1258,"_5":29385,"_20168":51267,"_26439":51268,"_2811":51269},[],"/docs/pr-preview/pr-46/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3323":1271,"_29044":1258,"_5":29385,"_20168":51271,"_26439":51272,"_2811":51273},[],"/docs/pr-preview/pr-46/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3323":1272,"_29044":1258,"_5":29385,"_20168":51275,"_26439":51276,"_2811":51277},[],"/docs/pr-preview/pr-46/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3323":1273,"_29044":1258,"_5":29385,"_20168":51279,"_26439":51280,"_2811":51281},[],"/docs/pr-preview/pr-46/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3323":1274,"_29044":1258,"_5":29385,"_20168":51283,"_26439":51284,"_2811":51285},[],"/docs/pr-preview/pr-46/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3323":1275,"_29044":1258,"_5":29385,"_20168":51287,"_26439":51288,"_2811":51289},[],"/docs/pr-preview/pr-46/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3323":1276,"_29044":1258,"_5":29385,"_20168":51291,"_26439":51292,"_2811":51293},[],"/docs/pr-preview/pr-46/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3323":1277,"_29044":1258,"_5":29385,"_20168":51295,"_26439":51296,"_2811":51297},[],"/docs/pr-preview/pr-46/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3323":1278,"_29044":1258,"_5":29385,"_20168":51299,"_26439":51300,"_2811":51301},[],"/docs/pr-preview/pr-46/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3323":1279,"_29044":1258,"_5":29385,"_20168":51303,"_26439":51304,"_2811":51305},[],"/docs/pr-preview/pr-46/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3323":1280,"_29044":1258,"_5":29385,"_20168":51307,"_26439":51308,"_2811":51309},[],"/docs/pr-preview/pr-46/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3323":1281,"_29044":1258,"_5":29385,"_20168":51311,"_26439":51312,"_2811":51313},[],"/docs/pr-preview/pr-46/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3323":1282,"_29044":1258,"_5":29385,"_20168":51315,"_26439":51316,"_2811":51317},[],"/docs/pr-preview/pr-46/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3323":1283,"_29044":1258,"_5":29385,"_20168":51319,"_26439":51320,"_2811":51321},[],"/docs/pr-preview/pr-46/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3323":1284,"_29044":1258,"_5":29385,"_20168":51323,"_26439":51324,"_2811":51325},[],"/docs/pr-preview/pr-46/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3323":1285,"_29044":1258,"_5":29385,"_20168":51327,"_26439":51328,"_2811":51329},[],"/docs/pr-preview/pr-46/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3323":1286,"_29044":1258,"_20168":51331,"_5":13790,"_26439":1258,"_2811":51332},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3323":1287,"_29044":1258,"_20168":51334,"_5":13790,"_26439":1258,"_2811":51335},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3323":1288,"_29044":1258,"_20168":51337,"_5":13790,"_26439":1258,"_2811":51338},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3323":1289,"_29044":1258,"_20168":51340,"_5":13790,"_26439":51228,"_2811":51341},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3323":1290,"_29044":1258,"_20168":51343,"_5":13790,"_26439":51228,"_2811":51344},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3323":1291,"_29044":1258,"_20168":51346,"_5":13790,"_26439":51228,"_2811":51347},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3323":1292,"_29044":1258,"_20168":51349,"_5":13790,"_26439":51228,"_2811":51350},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3323":1293,"_29044":1258,"_20168":51352,"_5":13790,"_26439":51232,"_2811":51353},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3323":1294,"_29044":1258,"_20168":51355,"_5":13790,"_26439":51236,"_2811":51356},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3323":1295,"_29044":1258,"_20168":51358,"_5":13790,"_26439":51236,"_2811":51359},[],"IAM action",{"_3323":1296,"_29044":1258,"_20168":51361,"_5":13790,"_26439":51236,"_2811":47689},[],{"_3323":1297,"_29044":1258,"_20168":51363,"_5":13790,"_26439":51236,"_2811":51364},[],"`iot:GetRegistrationCode`",{"_3323":1298,"_29044":1258,"_20168":51366,"_5":13790,"_26439":51236,"_2811":51367},[],"Obtain the verification code for CA registration in the Primary Account",{"_3323":1299,"_29044":1258,"_20168":51369,"_5":13790,"_26439":51236,"_2811":51370},[],"`iot:RegisterCACertificate`",{"_3323":1300,"_29044":1258,"_20168":51372,"_5":13790,"_26439":51236,"_2811":51373},[],"Register the CA in AWS IoT",{"_3323":1301,"_29044":1258,"_20168":51375,"_5":13790,"_26439":51236,"_2811":51376},[],"`iot:DescribeCACertificate`",{"_3323":1302,"_29044":1258,"_20168":51378,"_5":13790,"_26439":51236,"_2811":51379},[],"Check the CA registration status",{"_3323":1303,"_29044":1258,"_20168":51381,"_5":13790,"_26439":51236,"_2811":51382},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3323":1304,"_29044":1258,"_20168":51384,"_5":13790,"_26439":51236,"_2811":51385},[],"Create or update Things in IoT Core",{"_3323":1305,"_29044":1258,"_20168":51387,"_5":13790,"_26439":51236,"_2811":51388},[],"`iot:RegisterThing`",{"_3323":1306,"_29044":1258,"_20168":51390,"_5":13790,"_26439":51236,"_2811":51391},[],"Provision Things through a template",{"_3323":1307,"_29044":1258,"_20168":51393,"_5":13790,"_26439":51236,"_2811":51394},[],"`iot:RegisterCertificate`",{"_3323":1308,"_29044":1258,"_20168":51396,"_5":13790,"_26439":51236,"_2811":51397},[],"Register device certificates",{"_3323":1309,"_29044":1258,"_20168":51399,"_5":13790,"_26439":51236,"_2811":51400},[],"`iot:UpdateCertificate`",{"_3323":1310,"_29044":1258,"_20168":51402,"_5":13790,"_26439":51236,"_2811":51403},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3323":1311,"_29044":1258,"_20168":51405,"_5":13790,"_26439":51236,"_2811":51406},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3323":1312,"_29044":1258,"_20168":51408,"_5":13790,"_26439":51236,"_2811":51409},[],"Create and attach IoT policies",{"_3323":1313,"_29044":1258,"_20168":51411,"_5":13790,"_26439":51236,"_2811":51412},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3323":1314,"_29044":1258,"_20168":51414,"_5":13790,"_26439":51236,"_2811":51415},[],"Manage Thing groups",{"_3323":1315,"_29044":1258,"_20168":51417,"_5":13790,"_26439":51236,"_2811":51418},[],"`iot:CreateProvisioningTemplate`",{"_3323":1316,"_29044":1258,"_20168":51420,"_5":13790,"_26439":51236,"_2811":51421},[],"Create JITP templates",{"_3323":1317,"_29044":1258,"_20168":51423,"_5":13790,"_26439":51236,"_2811":51424},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3323":1318,"_29044":1258,"_20168":51426,"_5":13790,"_26439":51236,"_2811":51427},[],"Read and write the Device Shadow",{"_3323":1319,"_29044":1258,"_20168":51429,"_5":13790,"_26439":51236,"_2811":51430},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3323":1320,"_29044":1258,"_20168":51432,"_5":13790,"_26439":51240,"_2811":51433},[],"Parameter",{"_3323":1321,"_29044":1258,"_20168":51435,"_5":13790,"_26439":51240,"_2811":51436},[],"Type",{"_3323":1322,"_29044":1258,"_20168":51438,"_5":13790,"_26439":51240,"_2811":51439},[],"Required",{"_3323":1323,"_29044":1258,"_20168":51441,"_5":13790,"_26439":51240,"_2811":51442},[],"Description",{"_3323":1324,"_29044":1258,"_20168":51444,"_5":13790,"_26439":51240,"_2811":51445},[],"`connector_id`",{"_3323":1325,"_29044":1258,"_20168":51447,"_5":13790,"_26439":51240,"_2811":24081},[],{"_3323":1326,"_29044":1258,"_20168":51449,"_5":13790,"_26439":51240,"_2811":51450},[],"Yes",{"_3323":1327,"_29044":1258,"_20168":51452,"_5":13790,"_26439":51240,"_2811":51453},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3323":1328,"_29044":1258,"_20168":51455,"_5":13790,"_26439":51240,"_2811":51456},[],"`aws_config.region`",{"_3323":1329,"_29044":1258,"_20168":51458,"_5":13790,"_26439":51240,"_2811":24081},[],{"_3323":1330,"_29044":1258,"_20168":51460,"_5":13790,"_26439":51240,"_2811":51450},[],{"_3323":1331,"_29044":1258,"_20168":51462,"_5":13790,"_26439":51240,"_2811":51463},[],"AWS region where the connector operates.",{"_3323":1332,"_29044":1258,"_20168":51465,"_5":13790,"_26439":51240,"_2811":51466},[],"`aws_config.auth_method`",{"_3323":1333,"_29044":1258,"_20168":51468,"_5":13790,"_26439":51240,"_2811":24081},[],{"_3323":1334,"_29044":1258,"_20168":51470,"_5":13790,"_26439":51240,"_2811":51450},[],{"_3323":1335,"_29044":1258,"_20168":51472,"_5":13790,"_26439":51240,"_2811":51473},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3323":1336,"_29044":1258,"_20168":51475,"_5":13790,"_26439":51240,"_2811":51476},[],"`aws_config.access_key_id`",{"_3323":1337,"_29044":1258,"_20168":51478,"_5":13790,"_26439":51240,"_2811":24081},[],{"_3323":1338,"_29044":1258,"_20168":51480,"_5":13790,"_26439":51240,"_2811":51481},[],"Only with `auth_method=static`",{"_3323":1339,"_29044":1258,"_20168":51483,"_5":13790,"_26439":51240,"_2811":51484},[],"AWS access key.",{"_3323":1340,"_29044":1258,"_20168":51486,"_5":13790,"_26439":51240,"_2811":51487},[],"`aws_config.secret_access_key`",{"_3323":1341,"_29044":1258,"_20168":51489,"_5":13790,"_26439":51240,"_2811":24081},[],{"_3323":1342,"_29044":1258,"_20168":51491,"_5":13790,"_26439":51240,"_2811":51481},[],{"_3323":1343,"_29044":1258,"_20168":51493,"_5":13790,"_26439":51240,"_2811":51494},[],"AWS secret key.",{"_3323":1344,"_29044":1258,"_20168":51496,"_5":13790,"_26439":51240,"_2811":51497},[],"`aws_config.session_token`",{"_3323":1345,"_29044":1258,"_20168":51499,"_5":13790,"_26439":51240,"_2811":24081},[],{"_3323":1346,"_29044":1258,"_20168":51501,"_5":13790,"_26439":51240,"_2811":51502},[],"No",{"_3323":1347,"_29044":1258,"_20168":51504,"_5":13790,"_26439":51240,"_2811":51505},[],"Session token (with `auth_method=static`).",{"_3323":1348,"_29044":1258,"_20168":51507,"_5":13790,"_26439":51240,"_2811":51508},[],"`aws_config.role_arn`",{"_3323":1349,"_29044":1258,"_20168":51510,"_5":13790,"_26439":51240,"_2811":24081},[],{"_3323":1350,"_29044":1258,"_20168":51512,"_5":13790,"_26439":51240,"_2811":51513},[],"Only with `auth_method=role`",{"_3323":1351,"_29044":1258,"_20168":51515,"_5":13790,"_26439":51240,"_2811":51516},[],"ARN of the role to assume.",{"_3323":1352,"_29044":1258,"_20168":51518,"_5":13790,"_26439":51240,"_2811":51519},[],"`aws_config.endpoint_url`",{"_3323":1353,"_29044":1258,"_20168":51521,"_5":13790,"_26439":51240,"_2811":24081},[],{"_3323":1354,"_29044":1258,"_20168":51523,"_5":13790,"_26439":51240,"_2811":51502},[],{"_3323":1355,"_29044":1258,"_20168":51525,"_5":13790,"_26439":51240,"_2811":51526},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3323":1356,"_29044":1258,"_20168":51528,"_5":13790,"_26439":51240,"_2811":51529},[],"`subscriber_event_bus`",{"_3323":1357,"_29044":1258,"_20168":51531,"_5":13790,"_26439":51240,"_2811":16934},[],{"_3323":1358,"_29044":1258,"_20168":51533,"_5":13790,"_26439":51240,"_2811":51450},[],{"_3323":1359,"_29044":1258,"_20168":51535,"_5":13790,"_26439":51240,"_2811":51536},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3323":1360,"_29044":1258,"_20168":51538,"_5":13790,"_26439":51240,"_2811":51539},[],"`dms_manager_client`",{"_3323":1361,"_29044":1258,"_20168":51541,"_5":13790,"_26439":51240,"_2811":24081},[],{"_3323":1362,"_29044":1258,"_20168":51543,"_5":13790,"_26439":51240,"_2811":51450},[],{"_3323":1363,"_29044":1258,"_20168":51545,"_5":13790,"_26439":51240,"_2811":51546},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3323":1364,"_29044":1258,"_20168":51548,"_5":13790,"_26439":51240,"_2811":51549},[],"`device_manager_client`",{"_3323":1365,"_29044":1258,"_20168":51551,"_5":13790,"_26439":51240,"_2811":24081},[],{"_3323":1366,"_29044":1258,"_20168":51553,"_5":13790,"_26439":51240,"_2811":51450},[],{"_3323":1367,"_29044":1258,"_20168":51555,"_5":13790,"_26439":51240,"_2811":51556},[],"HTTP URL of Lamassu's Device Manager.",{"_3323":1368,"_29044":1258,"_20168":51558,"_5":13790,"_26439":51240,"_2811":51559},[],"`ca_client`",{"_3323":1369,"_29044":1258,"_20168":51561,"_5":13790,"_26439":51240,"_2811":24081},[],{"_3323":1370,"_29044":1258,"_20168":51563,"_5":13790,"_26439":51240,"_2811":51450},[],{"_3323":1371,"_29044":1258,"_20168":51565,"_5":13790,"_26439":51240,"_2811":51566},[],"HTTP URL of Lamassu's CA service.",{"_3323":1372,"_29044":1258,"_20168":51568,"_5":13790,"_26439":51244,"_2811":51569},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each transition performs. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3323":1373,"_29044":1258,"_20168":51571,"_5":13790,"_26439":51248,"_2811":51572},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3323":1374,"_29044":1258,"_20168":51574,"_5":13790,"_26439":51248,"_2811":51575},[],"CloudEvent type",{"_3323":1375,"_29044":1258,"_20168":51577,"_5":13790,"_26439":51248,"_2811":51578},[],"Lamassu resource",{"_3323":1376,"_29044":1258,"_20168":51580,"_5":13790,"_26439":51248,"_2811":51581},[],"AWS Resource",{"_3323":1377,"_29044":1258,"_20168":51583,"_5":13790,"_26439":51248,"_2811":51584},[],"IAM actions",{"_3323":1378,"_29044":1258,"_20168":51586,"_5":13790,"_26439":51248,"_2811":51587},[],"AWS calls and effect",{"_3323":1379,"_29044":1258,"_20168":51589,"_5":13790,"_26439":51248,"_2811":51590},[],"Where in this page",{"_3323":1380,"_29044":1258,"_20168":51592,"_5":13790,"_26439":51248,"_2811":51593},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3323":1381,"_29044":1258,"_20168":51595,"_5":13790,"_26439":51248,"_2811":51596},[],"CA",{"_3323":1382,"_29044":1258,"_20168":51598,"_5":13790,"_26439":51248,"_2811":51599},[],"`IoTCore/CACertificate`",{"_3323":1383,"_29044":1258,"_20168":51601,"_5":13790,"_26439":51248,"_2811":51602},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3323":1384,"_29044":1258,"_20168":51604,"_5":13790,"_26439":51248,"_2811":51605},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3323":1385,"_29044":1258,"_20168":51607,"_5":13790,"_26439":51248,"_2811":51253},[],{"_3323":1386,"_29044":1258,"_20168":51609,"_5":13790,"_26439":51248,"_2811":51610},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3323":1387,"_29044":1258,"_20168":51612,"_5":13790,"_26439":51248,"_2811":51613},[],"DMS",{"_3323":1388,"_29044":1258,"_20168":51615,"_5":13790,"_26439":51248,"_2811":51616},[],"`IoTCore/ProvisioningTemplate`",{"_3323":1389,"_29044":1258,"_20168":51618,"_5":13790,"_26439":51248,"_2811":51619},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3323":1390,"_29044":1258,"_20168":51621,"_5":13790,"_26439":51248,"_2811":51622},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3323":1391,"_29044":1258,"_20168":51624,"_5":13790,"_26439":51248,"_2811":51257},[],{"_3323":1392,"_29044":1258,"_20168":51626,"_5":13790,"_26439":51248,"_2811":51627},[],"`EventBindDeviceIdentityKey`",{"_3323":1393,"_29044":1258,"_20168":51629,"_5":13790,"_26439":51248,"_2811":51630},[],"Device",{"_3323":1394,"_29044":1258,"_20168":51632,"_5":13790,"_26439":51248,"_2811":51633},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3323":1395,"_29044":1258,"_20168":51635,"_5":13790,"_26439":51248,"_2811":51636},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3323":1396,"_29044":1258,"_20168":51638,"_5":13790,"_26439":51248,"_2811":51639},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3323":1397,"_29044":1258,"_20168":51641,"_5":13790,"_26439":51248,"_2811":51265},[],{"_3323":1398,"_29044":1258,"_20168":51643,"_5":13790,"_26439":51248,"_2811":51644},[],"`EventUpdateCertificateStatusKey`",{"_3323":1399,"_29044":1258,"_20168":51646,"_5":13790,"_26439":51248,"_2811":51647},[],"Certificate",{"_3323":1400,"_29044":1258,"_20168":51649,"_5":13790,"_26439":51248,"_2811":51650},[],"`IoTCore/Certificate`",{"_3323":1401,"_29044":1258,"_20168":51652,"_5":13790,"_26439":51248,"_2811":51653},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3323":1402,"_29044":1258,"_20168":51655,"_5":13790,"_26439":51248,"_2811":51656},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3323":1403,"_29044":1258,"_20168":51658,"_5":13790,"_26439":51248,"_2811":51261},[],{"_3323":1404,"_29044":1258,"_20168":51660,"_5":13790,"_26439":51248,"_2811":51661},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3323":1405,"_29044":1258,"_20168":51663,"_5":13790,"_26439":51248,"_2811":51664},[],"Certificate / Device",{"_3323":1406,"_29044":1258,"_20168":51666,"_5":13790,"_26439":51248,"_2811":51667},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3323":1407,"_29044":1258,"_20168":51669,"_5":13790,"_26439":51248,"_2811":47695},[],{"_3323":1408,"_29044":1258,"_20168":51671,"_5":13790,"_26439":51248,"_2811":51672},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3323":1409,"_29044":1258,"_20168":51674,"_5":13790,"_26439":51248,"_2811":51317},[],{"_3323":1410,"_29044":1258,"_20168":51676,"_5":13790,"_26439":51252,"_2811":51677},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3323":1411,"_29044":1258,"_20168":51679,"_5":13790,"_26439":51252,"_2811":51680},[],"by the `registration.status` field of the CA's connector metadata:",{"_3323":1412,"_29044":1258,"_20168":51682,"_5":13790,"_26439":51252,"_2811":51683},[],"Transition",{"_3323":1413,"_29044":1258,"_20168":51685,"_5":13790,"_26439":51252,"_2811":51686},[],"AWS calls",{"_3323":1414,"_29044":1258,"_20168":51688,"_5":13790,"_26439":51252,"_2811":51689},[],"`NotRegistered` → `Requested`",{"_3323":1415,"_29044":1258,"_20168":51691,"_5":13790,"_26439":51252,"_2811":51692},[],"none (metadata write only)",{"_3323":1416,"_29044":1258,"_20168":51694,"_5":13790,"_26439":51252,"_2811":51695},[],"`Requested` → `Registering`",{"_3323":1417,"_29044":1258,"_20168":51697,"_5":13790,"_26439":51252,"_2811":51698},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3323":1418,"_29044":1258,"_20168":51700,"_5":13790,"_26439":51252,"_2811":51701},[],"`Registering` → `Succeeded`",{"_3323":1419,"_29044":1258,"_20168":51703,"_5":13790,"_26439":51252,"_2811":51704},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3323":1420,"_29044":1258,"_20168":51706,"_5":13790,"_26439":51252,"_2811":51707},[],"`Registering` → `Failed`",{"_3323":1421,"_29044":1258,"_20168":51709,"_5":13790,"_26439":51252,"_2811":51710},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3323":1422,"_29044":1258,"_20168":51712,"_5":13790,"_26439":51252,"_2811":51713},[],"`Failed` / `Succeeded` → `Requested`",{"_3323":1423,"_29044":1258,"_20168":51715,"_5":13790,"_26439":51252,"_2811":51716},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3323":1424,"_29044":1258,"_20168":51718,"_5":13790,"_26439":51256,"_2811":51719},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3323":1425,"_29044":1258,"_20168":51721,"_5":13790,"_26439":51256,"_2811":51683},[],{"_3323":1426,"_29044":1258,"_20168":51723,"_5":13790,"_26439":51256,"_2811":51686},[],{"_3323":1427,"_29044":1258,"_20168":51725,"_5":13790,"_26439":51256,"_2811":51726},[],"`Unconfigured` → `None` / `Auto`",{"_3323":1428,"_29044":1258,"_20168":51728,"_5":13790,"_26439":51256,"_2811":51729},[],"none (configuration only)",{"_3323":1429,"_29044":1258,"_20168":51731,"_5":13790,"_26439":51256,"_2811":51732},[],"`None` ↔ `Auto`",{"_3323":1430,"_29044":1258,"_20168":51734,"_5":13790,"_26439":51256,"_2811":51729},[],{"_3323":1431,"_29044":1258,"_20168":51736,"_5":13790,"_26439":51256,"_2811":51737},[],"Any → `Jitp`",{"_3323":1432,"_29044":1258,"_20168":51739,"_5":13790,"_26439":51256,"_2811":51740},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3323":1433,"_29044":1258,"_20168":51742,"_5":13790,"_26439":51256,"_2811":51743},[],"`Jitp` → `None` / `Auto`",{"_3323":1434,"_29044":1258,"_20168":51745,"_5":13790,"_26439":51256,"_2811":51746},[],"none (the template stays in the AWS account)",{"_3323":1435,"_29044":1258,"_20168":51748,"_5":13790,"_26439":51260,"_2811":51749},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3323":1436,"_29044":1258,"_20168":51751,"_5":13790,"_26439":51260,"_2811":51683},[],{"_3323":1437,"_29044":1258,"_20168":51753,"_5":13790,"_26439":51260,"_2811":51686},[],{"_3323":1438,"_29044":1258,"_20168":51755,"_5":13790,"_26439":51260,"_2811":51756},[],"`NotSynced` → `Active`",{"_3323":1439,"_29044":1258,"_20168":51758,"_5":13790,"_26439":51260,"_2811":51400},[],{"_3323":1440,"_29044":1258,"_20168":51760,"_5":13790,"_26439":51260,"_2811":51761},[],"`Active` → `Inactive`",{"_3323":1441,"_29044":1258,"_20168":51763,"_5":13790,"_26439":51260,"_2811":51764},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3323":1442,"_29044":1258,"_20168":51766,"_5":13790,"_26439":51260,"_2811":51767},[],"`Active` → `Revoked`",{"_3323":1443,"_29044":1258,"_20168":51769,"_5":13790,"_26439":51260,"_2811":51764},[],{"_3323":1444,"_29044":1258,"_20168":51771,"_5":13790,"_26439":51260,"_2811":51772},[],"`Inactive` / `Revoked` → `Active`",{"_3323":1445,"_29044":1258,"_20168":51774,"_5":13790,"_26439":51260,"_2811":51400},[],{"_3323":1446,"_29044":1258,"_20168":51776,"_5":13790,"_26439":51260,"_2811":51777},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3323":1447,"_29044":1258,"_20168":51779,"_5":13790,"_26439":51260,"_2811":51780},[],"none (these states are not synced to AWS)",{"_3323":1448,"_29044":1258,"_20168":51782,"_5":13790,"_26439":51264,"_2811":51783},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3323":1449,"_29044":1258,"_20168":51785,"_5":13790,"_26439":51264,"_2811":51683},[],{"_3323":1450,"_29044":1258,"_20168":51787,"_5":13790,"_26439":51264,"_2811":51686},[],{"_3323":1451,"_29044":1258,"_20168":51789,"_5":13790,"_26439":51264,"_2811":51790},[],"`Absent` → `Provisioned`",{"_3323":1452,"_29044":1258,"_20168":51792,"_5":13790,"_26439":51264,"_2811":51793},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3323":1453,"_29044":1258,"_20168":51795,"_5":13790,"_26439":51264,"_2811":51796},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3323":1454,"_29044":1258,"_20168":51798,"_5":13790,"_26439":51264,"_2811":51799},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3323":1455,"_29044":1258,"_20168":51801,"_5":13790,"_26439":51264,"_2811":51802},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3323":1456,"_29044":1258,"_20168":51804,"_5":13790,"_26439":51268,"_2811":51805},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3323":1457,"_29044":1258,"_20168":51807,"_5":13790,"_26439":51272,"_2811":51808},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3323":1458,"_29044":1258,"_20168":51810,"_5":13790,"_26439":51272,"_2811":51811},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3323":1459,"_29044":1258,"_20168":51813,"_5":13790,"_26439":51276,"_2811":51814},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3323":1460,"_29044":1258,"_20168":51816,"_5":13790,"_26439":51276,"_2811":51817},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3323":1461,"_29044":1258,"_20168":51819,"_5":13790,"_26439":51276,"_2811":51820},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3323":1462,"_29044":1258,"_20168":51822,"_5":13790,"_26439":51276,"_2811":51823},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3323":1463,"_29044":1258,"_20168":51825,"_5":13790,"_26439":51276,"_2811":51826},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3323":1464,"_29044":1258,"_20168":51828,"_5":13790,"_26439":51276,"_2811":51829},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3323":1465,"_29044":1258,"_20168":51831,"_5":13790,"_26439":51280,"_2811":51832},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3323":1466,"_29044":1258,"_20168":51834,"_5":13790,"_26439":51284,"_2811":51835},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3323":1467,"_29044":1258,"_20168":51837,"_5":13790,"_26439":51284,"_2811":51838},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3323":1468,"_29044":1258,"_20168":51840,"_5":13790,"_26439":51288,"_2811":51841},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3323":1469,"_29044":1258,"_20168":51843,"_5":13790,"_26439":51292,"_2811":51844},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3323":1470,"_29044":1258,"_20168":51846,"_5":13790,"_26439":51292,"_2811":51847},[],"Creates or updates the IoT policies configured in the DMS.",{"_3323":1471,"_29044":1258,"_20168":51849,"_5":13790,"_26439":51292,"_2811":51850},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3323":1472,"_29044":1258,"_20168":51852,"_5":13790,"_26439":51292,"_2811":51853},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3323":1473,"_29044":1258,"_20168":51855,"_5":13790,"_26439":51292,"_2811":51856},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3323":1474,"_29044":1258,"_20168":51858,"_5":13790,"_26439":51292,"_2811":51859},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3323":1475,"_29044":1258,"_20168":51861,"_5":13790,"_26439":51292,"_2811":51862},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3323":1476,"_29044":1258,"_20168":51864,"_5":13790,"_26439":51296,"_2811":51865},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3323":1477,"_29044":1258,"_20168":51867,"_5":13790,"_26439":51296,"_2811":51868},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3323":1478,"_29044":1258,"_20168":51870,"_5":13790,"_26439":51296,"_2811":51871},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3323":1479,"_29044":1258,"_20168":51873,"_5":13790,"_26439":51296,"_2811":51874},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3323":1480,"_29044":1258,"_20168":51876,"_5":13790,"_26439":51296,"_2811":51877},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3323":1481,"_29044":1258,"_20168":51879,"_5":13790,"_26439":51300,"_2811":51880},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3323":1482,"_29044":1258,"_20168":51882,"_5":13790,"_26439":51300,"_2811":51883},[],"The full flow from the device's perspective is:",{"_3323":1483,"_29044":1258,"_20168":51885,"_5":13790,"_26439":51300,"_2811":51886},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3323":1484,"_29044":1258,"_20168":51888,"_5":13790,"_26439":51304,"_2811":51889},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3323":1485,"_29044":1258,"_20168":51891,"_5":13790,"_26439":51304,"_2811":51892},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3323":1486,"_29044":1258,"_20168":51894,"_5":13790,"_26439":51304,"_2811":51895},[],"For the JITP flow to work correctly:",{"_3323":1487,"_29044":1258,"_20168":51897,"_5":13790,"_26439":51304,"_2811":51898},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3323":1488,"_29044":1258,"_20168":51900,"_5":13790,"_26439":51304,"_2811":51901},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3323":1489,"_29044":1258,"_20168":51903,"_5":13790,"_26439":51304,"_2811":51904},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3323":1490,"_29044":1258,"_20168":51906,"_5":13790,"_26439":51304,"_2811":51907},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3323":1491,"_29044":1258,"_20168":51909,"_5":13790,"_26439":51308,"_2811":51910},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3323":1492,"_29044":1258,"_20168":51912,"_5":13790,"_26439":51308,"_2811":51913},[],"Status in Lamassu",{"_3323":1493,"_29044":1258,"_20168":51915,"_5":13790,"_26439":51308,"_2811":51916},[],"Revocation reason",{"_3323":1494,"_29044":1258,"_20168":51918,"_5":13790,"_26439":51308,"_2811":51919},[],"Status in AWS IoT Core",{"_3323":1495,"_29044":1258,"_20168":51921,"_5":13790,"_26439":51308,"_2811":51922},[],"`Active`",{"_3323":1496,"_29044":1258,"_20168":51924,"_5":13790,"_26439":51308,"_2811":51925},[],"None",{"_3323":1497,"_29044":1258,"_20168":51927,"_5":13790,"_26439":51308,"_2811":51928},[],"`ACTIVE`",{"_3323":1498,"_29044":1258,"_20168":51930,"_5":13790,"_26439":51308,"_2811":51931},[],"`Revoked`",{"_3323":1499,"_29044":1258,"_20168":51933,"_5":13790,"_26439":51308,"_2811":51934},[],"`certificateHold`",{"_3323":1500,"_29044":1258,"_20168":51936,"_5":13790,"_26439":51308,"_2811":51937},[],"`INACTIVE`",{"_3323":1501,"_29044":1258,"_20168":51939,"_5":13790,"_26439":51308,"_2811":51931},[],{"_3323":1502,"_29044":1258,"_20168":51941,"_5":13790,"_26439":51308,"_2811":51942},[],"Any other reason",{"_3323":1503,"_29044":1258,"_20168":51944,"_5":13790,"_26439":51308,"_2811":51945},[],"`REVOKED`",{"_3323":1504,"_29044":1258,"_20168":51947,"_5":13790,"_26439":51308,"_2811":51948},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3323":1505,"_29044":1258,"_20168":51950,"_5":13790,"_26439":51312,"_2811":51951},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3323":1506,"_29044":1258,"_20168":51953,"_5":13790,"_26439":51312,"_2811":51954},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3323":1507,"_29044":1258,"_20168":51956,"_5":13790,"_26439":51312,"_2811":51957},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3323":1508,"_29044":1258,"_20168":51959,"_5":13790,"_26439":51316,"_2811":51960},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3323":1509,"_29044":1258,"_20168":51962,"_5":13790,"_26439":51316,"_2811":51963},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3323":1510,"_29044":1258,"_20168":51965,"_5":13790,"_26439":51320,"_2811":51966},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3323":1511,"_29044":1258,"_20168":51968,"_5":13790,"_26439":51320,"_2811":51969},[],"There are two action types:",{"_3323":1512,"_29044":1258,"_20168":51971,"_5":13790,"_26439":51320,"_2811":51972},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3323":1513,"_29044":1258,"_20168":51974,"_5":13790,"_26439":51320,"_2811":51975},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3323":1514,"_29044":1258,"_20168":51977,"_5":13790,"_26439":51320,"_2811":51978},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3323":1515,"_29044":1258,"_20168":51980,"_5":13790,"_26439":51324,"_2811":51981},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3323":1516,"_29044":1258,"_20168":51983,"_5":13790,"_26439":51324,"_2811":51984},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3323":1517,"_29044":1258,"_20168":51986,"_5":13790,"_26439":51324,"_2811":51987},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3323":1518,"_29044":1258,"_20168":51989,"_5":13790,"_26439":51328,"_2811":51990},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3323":1519,"_29044":1258,"_20168":51992,"_5":13790,"_26439":51328,"_2811":51993},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3323":1520,"_29044":1258,"_20168":51995,"_5":13790,"_26439":51328,"_2811":51996},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3323":1521,"_29044":1258,"_20168":51998,"_5":13790,"_26439":51328,"_2811":51999},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3323":1522,"_29044":1258,"_20168":52001,"_5":13790,"_26439":51328,"_2811":52002},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3323":1523,"_29044":1258,"_20168":52004,"_5":13790,"_26439":51328,"_2811":52005},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3323":1524,"_29044":1258,"_20168":52007,"_5":13790,"_26439":51328,"_2811":52008},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3323":1525,"_29044":1258,"_20168":52010,"_5":13790,"_26439":51328,"_2811":52011},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3323":1526,"_29044":1258,"_20168":52013,"_5":13790,"_26439":51328,"_2811":52014},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3323":1527,"_29044":1258,"_20168":52016,"_5":13790,"_26439":51328,"_2811":52017},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3323":1528,"_29044":1258,"_20168":52019,"_5":13790,"_26439":51328,"_2811":52020},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3323":1529,"_29044":1258,"_20168":52022,"_5":13790,"_26439":51328,"_2811":52023},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3323":1530,"_29044":1258,"_20168":52025,"_5":13790,"_26439":51328,"_2811":52026},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3323":1531,"_29044":1258,"_20168":52028,"_5":13790,"_26439":51328,"_2811":52029},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3323":1532,"_29044":1258,"_20168":52031,"_5":13790,"_26439":51328,"_2811":52032},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3323":1533,"_29044":1258,"_20168":52034,"_5":13790,"_26439":51328,"_2811":52035},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3323":1534,"_29044":1258,"_20168":52037,"_5":13790,"_26439":51328,"_2811":52038},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3323":1535,"_29044":1258,"_20168":52040,"_5":13790,"_26439":51328,"_2811":52041},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3323":1536,"_29044":1258,"_20168":52043,"_5":13790,"_26439":51328,"_2811":52044},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3323":1537,"_29044":1258,"_20168":52046,"_5":13790,"_26439":51328,"_2811":52047},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3323":1538,"_29044":1258,"_20168":52049,"_5":13790,"_26439":51328,"_2811":52050},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3323":1539,"_29044":1258,"_20168":52052,"_5":13790,"_26439":51328,"_2811":52053},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3323":1540,"_29044":1258,"_20168":52055,"_5":13790,"_26439":51328,"_2811":52056},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3323":1541,"_29044":1258,"_20168":52058,"_5":13790,"_26439":51328,"_2811":52059},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3323":1542,"_29044":1542,"_5":14148,"_2811":49759,"_29388":52061,"_20168":52062,"_26439":1542},[47299,48748,49759],[],{"_3323":1543,"_29044":1542,"_20168":52064,"_5":13790,"_26439":1542,"_2811":52065},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3323":1544,"_29044":1542,"_5":29385,"_20168":52067,"_26439":52068,"_2811":52069},[],"/docs/pr-preview/pr-46/platform/iot-fleets/overview#start-here","Start here",{"_3323":1545,"_29044":1542,"_5":29385,"_20168":52071,"_26439":52072,"_2811":49757},[],"/docs/pr-preview/pr-46/platform/iot-fleets/overview#devices-and-identities",{"_3323":1546,"_29044":1542,"_5":29385,"_20168":52074,"_26439":52075,"_2811":49940},[],"/docs/pr-preview/pr-46/platform/iot-fleets/overview#enrollment-with-pki",{"_3323":1547,"_29044":1542,"_5":29385,"_20168":52077,"_26439":52078,"_2811":51221},[],"/docs/pr-preview/pr-46/platform/iot-fleets/overview#integrations",{"_3323":1548,"_29044":1542,"_5":29385,"_20168":52080,"_26439":52081,"_2811":52082},[],"/docs/pr-preview/pr-46/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3323":1549,"_29044":1542,"_20168":52084,"_5":13790,"_26439":1542,"_2811":52085},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3323":1550,"_29044":1542,"_20168":52087,"_5":13790,"_26439":52068,"_2811":52088},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3323":1551,"_29044":1542,"_20168":52090,"_5":13790,"_26439":52068,"_2811":52091},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3323":1552,"_29044":1542,"_20168":52093,"_5":13790,"_26439":52072,"_2811":52094},[],"Resource",{"_3323":1553,"_29044":1542,"_20168":52096,"_5":13790,"_26439":52072,"_2811":52097},[],"What it represents",{"_3323":1554,"_29044":1542,"_20168":52099,"_5":13790,"_26439":52072,"_2811":52100},[],"**Device**",{"_3323":1555,"_29044":1542,"_20168":52102,"_5":13790,"_26439":52072,"_2811":52103},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3323":1556,"_29044":1542,"_20168":52105,"_5":13790,"_26439":52072,"_2811":52106},[],"**Identity**",{"_3323":1557,"_29044":1542,"_20168":52108,"_5":13790,"_26439":52072,"_2811":52109},[],"The device's association with its certificates: an active version and a history.",{"_3323":1558,"_29044":1542,"_20168":52111,"_5":13790,"_26439":52072,"_2811":52112},[],"**DMS**",{"_3323":1559,"_29044":1542,"_20168":52114,"_5":13790,"_26439":52072,"_2811":52115},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3323":1560,"_29044":1542,"_20168":52117,"_5":13790,"_26439":52072,"_2811":52118},[],"**Fleet**",{"_3323":1561,"_29044":1542,"_20168":52120,"_5":13790,"_26439":52072,"_2811":52121},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3323":1562,"_29044":1542,"_20168":52123,"_5":13790,"_26439":52072,"_2811":52124},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3323":1563,"_29044":1542,"_20168":52126,"_5":13790,"_26439":52072,"_2811":52127},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3323":1564,"_29044":1542,"_20168":52129,"_5":13790,"_26439":52075,"_2811":52130},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3323":1565,"_29044":1542,"_20168":52132,"_5":13790,"_26439":52075,"_2811":52133},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3323":1566,"_29044":1542,"_20168":52135,"_5":13790,"_26439":52075,"_2811":52136},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3323":1567,"_29044":1542,"_20168":52138,"_5":13790,"_26439":52075,"_2811":52139},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3323":1568,"_29044":1542,"_20168":52141,"_5":13790,"_26439":52075,"_2811":52142},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3323":1569,"_29044":1542,"_20168":52144,"_5":13790,"_26439":52075,"_2811":52145},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3323":1570,"_29044":1542,"_20168":52147,"_5":13790,"_26439":52075,"_2811":52148},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3323":1571,"_29044":1542,"_20168":52150,"_5":13790,"_26439":52075,"_2811":52151},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3323":1572,"_29044":1542,"_20168":52153,"_5":13790,"_26439":52078,"_2811":52154},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3323":1573,"_29044":1542,"_20168":52156,"_5":13790,"_26439":52078,"_2811":52157},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3323":1574,"_29044":1542,"_20168":52159,"_5":13790,"_26439":52081,"_2811":52160},[],"Participant",{"_3323":1575,"_29044":1542,"_20168":52162,"_5":13790,"_26439":52081,"_2811":52163},[],"Responsibility",{"_3323":1576,"_29044":1542,"_20168":52165,"_5":13790,"_26439":52081,"_2811":52166},[],"PKI administrator",{"_3323":1577,"_29044":1542,"_20168":52168,"_5":13790,"_26439":52081,"_2811":52169},[],"CA, issuance profile, chain and revocation publication.",{"_3323":1578,"_29044":1542,"_20168":52171,"_5":13790,"_26439":52081,"_2811":52172},[],"Provisioning administrator",{"_3323":1579,"_29044":1542,"_20168":52174,"_5":13790,"_26439":52081,"_2811":52175},[],"DMS, admission, authentication per operation and inventory.",{"_3323":1580,"_29044":1542,"_20168":52177,"_5":13790,"_26439":52081,"_2811":52178},[],"Device integrator",{"_3323":1581,"_29044":1542,"_20168":52180,"_5":13790,"_26439":52081,"_2811":52181},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3323":1582,"_29044":1542,"_20168":52183,"_5":13790,"_26439":52081,"_2811":52184},[],"Consumer integrator",{"_3323":1583,"_29044":1542,"_20168":52186,"_5":13790,"_26439":52081,"_2811":52187},[],"Trusted issuers, validation and device permissions in the destination.",{"_3323":1584,"_29044":1542,"_20168":52189,"_5":13790,"_26439":52081,"_2811":52190},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3323":1585,"_29044":1585,"_5":14148,"_2811":52192,"_29388":52193,"_20168":52195,"_26439":1585},"Enroll and connect your first device",[47299,48748,49759,52194],"Getting started",[],{"_3323":1586,"_29044":1585,"_20168":52197,"_5":13790,"_26439":1585,"_2811":52198},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3323":1587,"_29044":1585,"_5":29385,"_20168":52200,"_26439":52201,"_2811":47309},[],"/docs/pr-preview/pr-46/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3323":1588,"_29044":1585,"_5":29385,"_20168":52203,"_26439":52204,"_2811":52205},[],"/docs/pr-preview/pr-46/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3323":1589,"_29044":1585,"_5":29385,"_20168":52207,"_26439":52208,"_2811":52209},[],"/docs/pr-preview/pr-46/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3323":1590,"_29044":1585,"_5":29385,"_20168":52211,"_26439":52212,"_2811":52213},[],"/docs/pr-preview/pr-46/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3323":1591,"_29044":1585,"_5":29385,"_20168":52215,"_26439":52216,"_2811":52217},[],"/docs/pr-preview/pr-46/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3323":1592,"_29044":1585,"_5":29385,"_20168":52219,"_26439":52220,"_2811":52221},[],"/docs/pr-preview/pr-46/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3323":1593,"_29044":1585,"_5":29385,"_20168":52223,"_26439":52224,"_2811":52225},[],"/docs/pr-preview/pr-46/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3323":1594,"_29044":1585,"_5":29385,"_20168":52227,"_26439":52228,"_2811":52229},[],"/docs/pr-preview/pr-46/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3323":1595,"_29044":1585,"_20168":52231,"_5":13790,"_26439":1585,"_2811":52232},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3323":1596,"_29044":1585,"_20168":52234,"_5":13790,"_26439":52201,"_2811":52235},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3323":1597,"_29044":1585,"_20168":52237,"_5":13790,"_26439":52201,"_2811":52238},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3323":1598,"_29044":1585,"_20168":52240,"_5":13790,"_26439":52201,"_2811":52241},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3323":1599,"_29044":1585,"_20168":52243,"_5":13790,"_26439":52201,"_2811":52244},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3323":1600,"_29044":1585,"_20168":52246,"_5":13790,"_26439":52201,"_2811":52247},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3323":1601,"_29044":1585,"_20168":52249,"_5":13790,"_26439":52204,"_2811":52250},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3323":1602,"_29044":1585,"_20168":52252,"_5":13790,"_26439":52204,"_2811":52253},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3323":1603,"_29044":1585,"_20168":52255,"_5":13790,"_26439":52208,"_2811":52256},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3323":1604,"_29044":1585,"_20168":52258,"_5":13790,"_26439":52208,"_2811":52259},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3323":1605,"_29044":1585,"_20168":52261,"_5":13790,"_26439":52208,"_2811":52262},[],"Setting",{"_3323":1606,"_29044":1585,"_20168":52264,"_5":13790,"_26439":52208,"_2811":52265},[],"Evaluation value",{"_3323":1607,"_29044":1585,"_20168":52267,"_5":13790,"_26439":52208,"_2811":52268},[],"Enrollment CA",{"_3323":1608,"_29044":1585,"_20168":52270,"_5":13790,"_26439":52208,"_2811":52271},[],"Issuing root from `device-root.pem`.",{"_3323":1609,"_29044":1585,"_20168":52273,"_5":13790,"_26439":52208,"_2811":50070},[],{"_3323":1610,"_29044":1585,"_20168":52275,"_5":13790,"_26439":52208,"_2811":52276},[],"The 1-hour leaf profile you just prepared.",{"_3323":1611,"_29044":1585,"_20168":52278,"_5":13790,"_26439":52208,"_2811":52279},[],"Protocol / Registration Mode",{"_3323":1612,"_29044":1585,"_20168":52281,"_5":13790,"_26439":52208,"_2811":52282},[],"`EST_RFC7030` / `JITP`.",{"_3323":1613,"_29044":1585,"_20168":52284,"_5":13790,"_26439":52208,"_2811":52285},[],"Verify CSR Signature",{"_3323":1614,"_29044":1585,"_20168":52287,"_5":13790,"_26439":52208,"_2811":52288},[],"Enabled.",{"_3323":1615,"_29044":1585,"_20168":52290,"_5":13790,"_26439":52208,"_2811":52291},[],"Enable Replaceable Enrollment",{"_3323":1616,"_29044":1585,"_20168":52293,"_5":13790,"_26439":52208,"_2811":52294},[],"Disabled; the ID must be new.",{"_3323":1617,"_29044":1585,"_20168":52296,"_5":13790,"_26439":52208,"_2811":52297},[],"Initial authentication",{"_3323":1618,"_29044":1585,"_20168":52299,"_5":13790,"_26439":52208,"_2811":52300},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3323":1619,"_29044":1585,"_20168":52302,"_5":13790,"_26439":52208,"_2811":52303},[],"Renewal authentication",{"_3323":1620,"_29044":1585,"_20168":52305,"_5":13790,"_26439":52208,"_2811":52306},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3323":1621,"_29044":1585,"_20168":52308,"_5":13790,"_26439":52208,"_2811":52309},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3323":1622,"_29044":1585,"_20168":52311,"_5":13790,"_26439":52208,"_2811":52312},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3323":1623,"_29044":1585,"_20168":52314,"_5":13790,"_26439":52208,"_2811":52315},[],"Re-enrollment Delta",{"_3323":1624,"_29044":1585,"_20168":52317,"_5":13790,"_26439":52208,"_2811":52318},[],"1 hour.",{"_3323":1625,"_29044":1585,"_20168":52320,"_5":13790,"_26439":52208,"_2811":52321},[],"Preventive / Critical Delta",{"_3323":1626,"_29044":1585,"_20168":52323,"_5":13790,"_26439":52208,"_2811":52324},[],"30 minutes / 10 minutes.",{"_3323":1627,"_29044":1585,"_20168":52326,"_5":13790,"_26439":52208,"_2811":52327},[],"Revoke on Re-enrollment",{"_3323":1628,"_29044":1585,"_20168":52329,"_5":13790,"_26439":52208,"_2811":52330},[],"Disabled to test the successor before retiring the previous identity.",{"_3323":1629,"_29044":1585,"_20168":52332,"_5":13790,"_26439":52208,"_2811":50078},[],{"_3323":1630,"_29044":1585,"_20168":52334,"_5":13790,"_26439":52208,"_2811":52335},[],"Disabled; the operational key is generated in the client.",{"_3323":1631,"_29044":1585,"_20168":52337,"_5":13790,"_26439":52208,"_2811":52338},[],"CA Distribution",{"_3323":1632,"_29044":1585,"_20168":52340,"_5":13790,"_26439":52208,"_2811":52341},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3323":1633,"_29044":1585,"_20168":52343,"_5":13790,"_26439":52208,"_2811":52344},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3323":1634,"_29044":1585,"_20168":52346,"_5":13790,"_26439":52212,"_2811":52347},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3323":1635,"_29044":1585,"_20168":52349,"_5":13790,"_26439":52212,"_2811":52350},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3323":1636,"_29044":1585,"_20168":52352,"_5":13790,"_26439":52216,"_2811":52353},[],"Generate a new key and CSR with the selected identifier:",{"_3323":1637,"_29044":1585,"_20168":52355,"_5":13790,"_26439":52216,"_2811":52356},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3323":1638,"_29044":1585,"_20168":52358,"_5":13790,"_26439":52216,"_2811":52359},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3323":1639,"_29044":1585,"_20168":52361,"_5":13790,"_26439":52220,"_2811":52362},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3323":1640,"_29044":1585,"_20168":52364,"_5":13790,"_26439":52220,"_2811":52365},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3323":1641,"_29044":1585,"_20168":52367,"_5":13790,"_26439":52224,"_2811":52368},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3323":1642,"_29044":1585,"_20168":52370,"_5":13790,"_26439":52224,"_2811":52371},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3323":1643,"_29044":1585,"_20168":52373,"_5":13790,"_26439":52224,"_2811":52374},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3323":1644,"_29044":1585,"_20168":52376,"_5":13790,"_26439":52224,"_2811":52377},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3323":1645,"_29044":1585,"_20168":52379,"_5":13790,"_26439":52224,"_2811":52380},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3323":1646,"_29044":1585,"_20168":52382,"_5":13790,"_26439":52228,"_2811":52383},[],"Check",{"_3323":1647,"_29044":1585,"_20168":52385,"_5":13790,"_26439":52228,"_2811":52386},[],"Expected result",{"_3323":1648,"_29044":1585,"_20168":52388,"_5":13790,"_26439":52228,"_2811":52389},[],"Registration",{"_3323":1649,"_29044":1585,"_20168":52391,"_5":13790,"_26439":52228,"_2811":52392},[],"ID created automatically and correct DMS.",{"_3323":1650,"_29044":1585,"_20168":52394,"_5":13790,"_26439":52228,"_2811":51647},[],{"_3323":1651,"_29044":1585,"_20168":52396,"_5":13790,"_26439":52228,"_2811":52397},[],"CN, profile, serial and key verified.",{"_3323":1652,"_29044":1585,"_20168":52399,"_5":13790,"_26439":52228,"_2811":52400},[],"Inventory",{"_3323":1653,"_29044":1585,"_20168":52402,"_5":13790,"_26439":52228,"_2811":52403},[],"Received serial visible as the current identity and in history.",{"_3323":1654,"_29044":1585,"_20168":52405,"_5":13790,"_26439":52228,"_2811":52406},[],"Consumer",{"_3323":1655,"_29044":1585,"_20168":52408,"_5":13790,"_26439":52228,"_2811":52409},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3323":1656,"_29044":1585,"_20168":52411,"_5":13790,"_26439":52228,"_2811":52412},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3323":1657,"_29044":1585,"_20168":52414,"_5":13790,"_26439":52228,"_2811":52415},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3323":1658,"_29044":1658,"_5":14148,"_2811":49775,"_29388":52417,"_20168":52418,"_26439":1658},[47299,48748,49759,52194],[],{"_3323":1659,"_29044":1658,"_20168":52420,"_5":13790,"_26439":1658,"_2811":52421},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3323":1660,"_29044":1658,"_5":29385,"_20168":52423,"_26439":52424,"_2811":47309},[],"/docs/pr-preview/pr-46/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3323":1661,"_29044":1658,"_5":29385,"_20168":52426,"_26439":52427,"_2811":52428},[],"/docs/pr-preview/pr-46/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3323":1662,"_29044":1658,"_5":29385,"_20168":52430,"_26439":52431,"_2811":52432},[],"/docs/pr-preview/pr-46/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3323":1663,"_29044":1658,"_5":29385,"_20168":52434,"_26439":52435,"_2811":52436},[],"/docs/pr-preview/pr-46/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3323":1664,"_29044":1658,"_5":29385,"_20168":52438,"_26439":52439,"_2811":52440},[],"/docs/pr-preview/pr-46/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3323":1665,"_29044":1658,"_5":29385,"_20168":52442,"_26439":52443,"_2811":52444},[],"/docs/pr-preview/pr-46/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3323":1666,"_29044":1658,"_5":29385,"_20168":52446,"_26439":52447,"_2811":52386},[],"/docs/pr-preview/pr-46/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3323":1667,"_29044":1658,"_5":29385,"_20168":52449,"_26439":52450,"_2811":52451},[],"/docs/pr-preview/pr-46/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3323":1668,"_29044":1658,"_5":29385,"_20168":52453,"_26439":52454,"_2811":52455},[],"/docs/pr-preview/pr-46/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3323":1669,"_29044":1658,"_20168":52457,"_5":13790,"_26439":1658,"_2811":52458},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3323":1670,"_29044":1658,"_20168":52460,"_5":13790,"_26439":1658,"_2811":52461},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3323":1671,"_29044":1658,"_20168":52463,"_5":13790,"_26439":52424,"_2811":52464},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3323":1672,"_29044":1658,"_20168":52466,"_5":13790,"_26439":52424,"_2811":52467},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3323":1673,"_29044":1658,"_20168":52469,"_5":13790,"_26439":52424,"_2811":52470},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3323":1674,"_29044":1658,"_20168":52472,"_5":13790,"_26439":52424,"_2811":52473},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3323":1675,"_29044":1658,"_20168":52475,"_5":13790,"_26439":52427,"_2811":52476},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3323":1676,"_29044":1658,"_20168":52478,"_5":13790,"_26439":52427,"_2811":52479},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3323":1677,"_29044":1658,"_20168":52481,"_5":13790,"_26439":52427,"_2811":52482},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3323":1678,"_29044":1658,"_20168":52484,"_5":13790,"_26439":52427,"_2811":52485},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3323":1679,"_29044":1658,"_20168":52487,"_5":13790,"_26439":52427,"_2811":52488},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3323":1680,"_29044":1658,"_20168":52490,"_5":13790,"_26439":52427,"_2811":52491},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3323":1681,"_29044":1658,"_20168":52493,"_5":13790,"_26439":52427,"_2811":52494},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3323":1682,"_29044":1658,"_20168":52496,"_5":13790,"_26439":52427,"_2811":52497},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3323":1683,"_29044":1658,"_20168":52499,"_5":13790,"_26439":52431,"_2811":52500},[],"Open **Managed Devices** and the registration action. Complete:",{"_3323":1684,"_29044":1658,"_20168":52502,"_5":13790,"_26439":52431,"_2811":52503},[],"**Device ID**: `device-001`.",{"_3323":1685,"_29044":1658,"_20168":52505,"_5":13790,"_26439":52431,"_2811":52506},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3323":1686,"_29044":1658,"_20168":52508,"_5":13790,"_26439":52431,"_2811":52509},[],"**Icon** and **Tags**: optional classification.",{"_3323":1687,"_29044":1658,"_20168":52511,"_5":13790,"_26439":52431,"_2811":52512},[],"Confirm registration.",{"_3323":1688,"_29044":1658,"_20168":52514,"_5":13790,"_26439":52435,"_2811":52515},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3323":1689,"_29044":1658,"_20168":52517,"_5":13790,"_26439":52435,"_2811":52518},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3323":1690,"_29044":1658,"_20168":52520,"_5":13790,"_26439":52439,"_2811":52521},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3323":1691,"_29044":1658,"_20168":52523,"_5":13790,"_26439":52439,"_2811":52524},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3323":1692,"_29044":1658,"_20168":52526,"_5":13790,"_26439":52443,"_2811":52527},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3323":1693,"_29044":1658,"_20168":52529,"_5":13790,"_26439":52443,"_2811":52530},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3323":1694,"_29044":1658,"_20168":52532,"_5":13790,"_26439":52447,"_2811":52383},[],{"_3323":1695,"_29044":1658,"_20168":52534,"_5":13790,"_26439":52447,"_2811":52535},[],"Result",{"_3323":1696,"_29044":1658,"_20168":52537,"_5":13790,"_26439":52447,"_2811":51630},[],{"_3323":1697,"_29044":1658,"_20168":52539,"_5":13790,"_26439":52447,"_2811":52540},[],"`device-001` appears in inventory with the expected DMS.",{"_3323":1698,"_29044":1658,"_20168":52542,"_5":13790,"_26439":52447,"_2811":52543},[],"Current identity",{"_3323":1699,"_29044":1658,"_20168":52545,"_5":13790,"_26439":52447,"_2811":52546},[],"The associated certificate matches the one you verified in PKI.",{"_3323":1700,"_29044":1658,"_20168":52548,"_5":13790,"_26439":52447,"_2811":52549},[],"History",{"_3323":1701,"_29044":1658,"_20168":52551,"_5":13790,"_26439":52447,"_2811":52552},[],"The associated issuance appears with its serial number and dates.",{"_3323":1702,"_29044":1658,"_20168":52554,"_5":13790,"_26439":52447,"_2811":52555},[],"Key and certificate",{"_3323":1703,"_29044":1658,"_20168":52557,"_5":13790,"_26439":52447,"_2811":52558},[],"You have the verified pair ready to install on the device.",{"_3323":1704,"_29044":1658,"_20168":52560,"_5":13790,"_26439":52450,"_2811":52561},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3323":1705,"_29044":1658,"_20168":52563,"_5":13790,"_26439":52450,"_2811":52564},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3323":1706,"_29044":1658,"_20168":52566,"_5":13790,"_26439":52450,"_2811":52567},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3323":1707,"_29044":1658,"_20168":52569,"_5":13790,"_26439":52450,"_2811":52570},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3323":1708,"_29044":1658,"_20168":52572,"_5":13790,"_26439":52454,"_2811":52573},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3323":1709,"_29044":1658,"_20168":52575,"_5":13790,"_26439":52454,"_2811":52576},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3323":1710,"_29044":1658,"_20168":52578,"_5":13790,"_26439":52454,"_2811":52579},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3323":1711,"_29044":1711,"_5":14148,"_2811":52581,"_29388":52582,"_20168":52583,"_26439":1711},"Lamassu IoT Platform",[47299,48748],[],{"_3323":1712,"_29044":1711,"_20168":52585,"_5":13790,"_26439":1711,"_2811":52586},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3323":1713,"_29044":1711,"_5":29385,"_20168":52588,"_26439":52589,"_2811":52069},[],"/docs/pr-preview/pr-46/platform/overview#start-here",{"_3323":1714,"_29044":1711,"_5":29385,"_20168":52591,"_26439":52592,"_2811":52593},[],"/docs/pr-preview/pr-46/platform/overview#choose-your-path","Choose your path",{"_3323":1715,"_29044":1711,"_5":29385,"_20168":52595,"_26439":52596,"_2811":52597},[],"/docs/pr-preview/pr-46/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3323":1716,"_29044":1711,"_5":29385,"_20168":52599,"_26439":52600,"_2811":52601},[],"/docs/pr-preview/pr-46/platform/overview#core-capabilities","Core capabilities",{"_3323":1717,"_29044":1711,"_5":29385,"_20168":52603,"_26439":52604,"_2811":52605},[],"/docs/pr-preview/pr-46/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3323":1718,"_29044":1711,"_5":29385,"_20168":52607,"_26439":52608,"_2811":52609},[],"/docs/pr-preview/pr-46/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3323":1719,"_29044":1711,"_5":29385,"_20168":52611,"_26439":52612,"_2811":52613},[],"/docs/pr-preview/pr-46/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3323":1720,"_29044":1711,"_5":29385,"_20168":52615,"_26439":52616,"_2811":52617},[],"/docs/pr-preview/pr-46/platform/overview#automate-device-identities","Automate device identities",{"_3323":1721,"_29044":1711,"_5":29385,"_20168":52619,"_26439":52620,"_2811":52621},[],"/docs/pr-preview/pr-46/platform/overview#publish-validation-status","Publish validation status",{"_3323":1722,"_29044":1711,"_5":29385,"_20168":52623,"_26439":52624,"_2811":52625},[],"/docs/pr-preview/pr-46/platform/overview#react-to-events","React to events",{"_3323":1723,"_29044":1711,"_5":29385,"_20168":52627,"_26439":52628,"_2811":52629},[],"/docs/pr-preview/pr-46/platform/overview#operational-reference","Operational reference",{"_3323":1724,"_29044":1711,"_20168":52631,"_5":13790,"_26439":1711,"_2811":52632},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3323":1725,"_29044":1711,"_20168":52634,"_5":13790,"_26439":52589,"_2811":52635},[],"Choose the result you need:",{"_3323":1726,"_29044":1711,"_20168":52637,"_5":13790,"_26439":52589,"_2811":52638},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3323":1727,"_29044":1711,"_20168":52640,"_5":13790,"_26439":52589,"_2811":52641},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3323":1728,"_29044":1711,"_20168":52643,"_5":13790,"_26439":52589,"_2811":52644},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3323":1729,"_29044":1711,"_20168":52646,"_5":13790,"_26439":52592,"_2811":52647},[],"Section",{"_3323":1730,"_29044":1711,"_20168":52649,"_5":13790,"_26439":52592,"_2811":52650},[],"What you manage",{"_3323":1731,"_29044":1711,"_20168":52652,"_5":13790,"_26439":52592,"_2811":52653},[],"Entry point",{"_3323":1732,"_29044":1711,"_20168":52655,"_5":13790,"_26439":52592,"_2811":52656},[],"**PKI**",{"_3323":1733,"_29044":1711,"_20168":52658,"_5":13790,"_26439":52592,"_2811":52659},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3323":1734,"_29044":1711,"_20168":52661,"_5":13790,"_26439":52592,"_2811":52662},[],"PKI overview",{"_3323":1735,"_29044":1711,"_20168":52664,"_5":13790,"_26439":52592,"_2811":52665},[],"**IoT Fleets**",{"_3323":1736,"_29044":1711,"_20168":52667,"_5":13790,"_26439":52592,"_2811":52668},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3323":1737,"_29044":1711,"_20168":52670,"_5":13790,"_26439":52592,"_2811":52671},[],"IoT Fleets overview",{"_3323":1738,"_29044":1711,"_20168":52673,"_5":13790,"_26439":52592,"_2811":52674},[],"**Administration**",{"_3323":1739,"_29044":1711,"_20168":52676,"_5":13790,"_26439":52592,"_2811":52677},[],"Operator permissions, audit and event subscriptions.",{"_3323":1740,"_29044":1711,"_20168":52679,"_5":13790,"_26439":52592,"_2811":48746},[],{"_3323":1741,"_29044":1711,"_20168":52681,"_5":13790,"_26439":52592,"_2811":52682},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3323":1742,"_29044":1711,"_20168":52684,"_5":13790,"_26439":52596,"_2811":52685},[],"An identity's journey connects four responsibilities:",{"_3323":1743,"_29044":1711,"_20168":52687,"_5":13790,"_26439":52596,"_2811":52688},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3323":1744,"_29044":1711,"_20168":52690,"_5":13790,"_26439":52596,"_2811":52691},[],"The provisioning administrator configures the DMS and initial trust.",{"_3323":1745,"_29044":1711,"_20168":52693,"_5":13790,"_26439":52596,"_2811":52694},[],"The device client requests a certificate and installs it with the matching key.",{"_3323":1746,"_29044":1711,"_20168":52696,"_5":13790,"_26439":52596,"_2811":52697},[],"The consumer validates the identity and applies its access permissions.",{"_3323":1747,"_29044":1711,"_20168":52699,"_5":13790,"_26439":52596,"_2811":52700},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3323":1748,"_29044":1711,"_20168":52702,"_5":13790,"_26439":52604,"_2811":52703},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3323":1749,"_29044":1711,"_20168":52705,"_5":13790,"_26439":52608,"_2811":52706},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3323":1750,"_29044":1711,"_20168":52708,"_5":13790,"_26439":52612,"_2811":52709},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3323":1751,"_29044":1711,"_20168":52711,"_5":13790,"_26439":52616,"_2811":52712},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3323":1752,"_29044":1711,"_20168":52714,"_5":13790,"_26439":52620,"_2811":52715},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3323":1753,"_29044":1711,"_20168":52717,"_5":13790,"_26439":52624,"_2811":52718},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3323":1754,"_29044":1711,"_20168":52720,"_5":13790,"_26439":52628,"_2811":52163},[],{"_3323":1755,"_29044":1711,"_20168":52722,"_5":13790,"_26439":52628,"_2811":52723},[],"What it prepares or checks",{"_3323":1756,"_29044":1711,"_20168":52725,"_5":13790,"_26439":52628,"_2811":52166},[],{"_3323":1757,"_29044":1711,"_20168":52727,"_5":13790,"_26439":52628,"_2811":52728},[],"Key custody, CA hierarchy, profiles and validation.",{"_3323":1758,"_29044":1711,"_20168":52730,"_5":13790,"_26439":52628,"_2811":52731},[],"Fleet administrator",{"_3323":1759,"_29044":1711,"_20168":52733,"_5":13790,"_26439":52628,"_2811":52734},[],"DMS, device admission, renewal policy and inventory.",{"_3323":1760,"_29044":1711,"_20168":52736,"_5":13790,"_26439":52628,"_2811":52178},[],{"_3323":1761,"_29044":1711,"_20168":52738,"_5":13790,"_26439":52628,"_2811":52739},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3323":1762,"_29044":1711,"_20168":52741,"_5":13790,"_26439":52628,"_2811":52184},[],{"_3323":1763,"_29044":1711,"_20168":52743,"_5":13790,"_26439":52628,"_2811":52744},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3323":1764,"_29044":1711,"_20168":52746,"_5":13790,"_26439":52628,"_2811":52747},[],"Infrastructure operator",{"_3323":1765,"_29044":1711,"_20168":52749,"_5":13790,"_26439":52628,"_2811":52750},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3323":1766,"_29044":1711,"_20168":52752,"_5":13790,"_26439":52628,"_2811":52753},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3323":1767,"_29044":1767,"_5":14148,"_2811":52755,"_29388":52756,"_20168":52759,"_26439":1767},"CA hierarchy and rotation",[47299,48748,52757,52758],"PKI","Keys, authorities and certificates",[],{"_3323":1768,"_29044":1767,"_20168":52761,"_5":13790,"_26439":1767,"_2811":52762},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3323":1769,"_29044":1767,"_5":29385,"_20168":52764,"_26439":52765,"_2811":52766},[],"/docs/pr-preview/pr-46/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3323":1770,"_29044":1767,"_5":29385,"_20168":52768,"_26439":52769,"_2811":52770},[],"/docs/pr-preview/pr-46/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3323":1771,"_29044":1767,"_5":29385,"_20168":52772,"_26439":52773,"_2811":52774},[],"/docs/pr-preview/pr-46/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3323":1772,"_29044":1767,"_5":29385,"_20168":52776,"_26439":52777,"_2811":52778},[],"/docs/pr-preview/pr-46/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3323":1773,"_29044":1767,"_5":29385,"_20168":52780,"_26439":52781,"_2811":52782},[],"/docs/pr-preview/pr-46/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3323":1774,"_29044":1767,"_5":29385,"_20168":52784,"_26439":52785,"_2811":52786},[],"/docs/pr-preview/pr-46/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3323":1775,"_29044":1767,"_5":29385,"_20168":52788,"_26439":52789,"_2811":52790},[],"/docs/pr-preview/pr-46/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3323":1776,"_29044":1767,"_5":29385,"_20168":52792,"_26439":52793,"_2811":52794},[],"/docs/pr-preview/pr-46/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3323":1777,"_29044":1767,"_5":29385,"_20168":52796,"_26439":52797,"_2811":52798},[],"/docs/pr-preview/pr-46/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3323":1778,"_29044":1767,"_5":29385,"_20168":52800,"_26439":52801,"_2811":52802},[],"/docs/pr-preview/pr-46/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3323":1779,"_29044":1767,"_5":29385,"_20168":52804,"_26439":52805,"_2811":52806},[],"/docs/pr-preview/pr-46/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3323":1780,"_29044":1767,"_5":29385,"_20168":52808,"_26439":52809,"_2811":52810},[],"/docs/pr-preview/pr-46/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3323":1781,"_29044":1767,"_20168":52812,"_5":13790,"_26439":1767,"_2811":52813},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3323":1782,"_29044":1767,"_20168":52815,"_5":13790,"_26439":1767,"_2811":52816},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3323":1783,"_29044":1767,"_20168":52818,"_5":13790,"_26439":52765,"_2811":52819},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3323":1784,"_29044":1767,"_20168":52821,"_5":13790,"_26439":52765,"_2811":52822},[],"environment, such as production and preproduction;",{"_3323":1785,"_29044":1767,"_20168":52824,"_5":13790,"_26439":52765,"_2811":52825},[],"owner or operating team;",{"_3323":1786,"_29044":1767,"_20168":52827,"_5":13790,"_26439":52765,"_2811":52828},[],"device family or manufacturing process;",{"_3323":1787,"_29044":1767,"_20168":52830,"_5":13790,"_26439":52765,"_2811":52831},[],"region or regulatory requirement;",{"_3323":1788,"_29044":1767,"_20168":52833,"_5":13790,"_26439":52765,"_2811":52834},[],"cryptographic engine or key policy;",{"_3323":1789,"_29044":1767,"_20168":52836,"_5":13790,"_26439":52765,"_2811":52837},[],"maintenance window and renewal cadence.",{"_3323":1790,"_29044":1767,"_20168":52839,"_5":13790,"_26439":52765,"_2811":52840},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3323":1791,"_29044":1767,"_20168":52842,"_5":13790,"_26439":52765,"_2811":52843},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3323":1792,"_29044":1767,"_20168":52845,"_5":13790,"_26439":52769,"_2811":52846},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3323":1793,"_29044":1767,"_20168":52848,"_5":13790,"_26439":52769,"_2811":52849},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3323":1794,"_29044":1767,"_20168":52851,"_5":13790,"_26439":52769,"_2811":52852},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3323":1795,"_29044":1767,"_20168":52854,"_5":13790,"_26439":52773,"_2811":52855},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3323":1796,"_29044":1767,"_20168":52857,"_5":13790,"_26439":52773,"_2811":52858},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3323":1797,"_29044":1767,"_20168":52860,"_5":13790,"_26439":52773,"_2811":52861},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3323":1798,"_29044":1767,"_20168":52863,"_5":13790,"_26439":52773,"_2811":52864},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3323":1799,"_29044":1767,"_20168":52866,"_5":13790,"_26439":52781,"_2811":52867},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3323":1800,"_29044":1767,"_20168":52869,"_5":13790,"_26439":52785,"_2811":52870},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3323":1801,"_29044":1767,"_20168":52872,"_5":13790,"_26439":52789,"_2811":52873},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3323":1802,"_29044":1767,"_20168":52875,"_5":13790,"_26439":52793,"_2811":52876},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3323":1803,"_29044":1767,"_20168":52878,"_5":13790,"_26439":52797,"_2811":52879},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3323":1804,"_29044":1767,"_20168":52881,"_5":13790,"_26439":52801,"_2811":52882},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3323":1805,"_29044":1767,"_20168":52884,"_5":13790,"_26439":52805,"_2811":52885},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3323":1806,"_29044":1767,"_20168":52887,"_5":13790,"_26439":52805,"_2811":52888},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3323":1807,"_29044":1767,"_20168":52890,"_5":13790,"_26439":52805,"_2811":52891},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3323":1808,"_29044":1767,"_20168":52893,"_5":13790,"_26439":52805,"_2811":52894},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3323":1809,"_29044":1767,"_20168":52896,"_5":13790,"_26439":52809,"_2811":52897},[],"The new chain ends in an anchor installed by the consumer.",{"_3323":1810,"_29044":1767,"_20168":52899,"_5":13790,"_26439":52809,"_2811":52900},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3323":1811,"_29044":1767,"_20168":52902,"_5":13790,"_26439":52809,"_2811":52903},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3323":1812,"_29044":1767,"_20168":52905,"_5":13790,"_26439":52809,"_2811":52906},[],"Re-enrollment accepts the old identity during the planned period.",{"_3323":1813,"_29044":1767,"_20168":52908,"_5":13790,"_26439":52809,"_2811":52909},[],"OCSP and CRL respond for the authorities that remain active.",{"_3323":1814,"_29044":1767,"_20168":52911,"_5":13790,"_26439":52809,"_2811":52912},[],"No DMS is left accidentally issuing from the old CA.",{"_3323":1815,"_29044":1767,"_20168":52914,"_5":13790,"_26439":52809,"_2811":52915},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3323":1816,"_29044":1816,"_5":14148,"_2811":52917,"_29388":52918,"_20168":52919,"_26439":1816},"Certification authorities",[47299,48748,52757,52758],[],{"_3323":1817,"_29044":1816,"_20168":52921,"_5":13790,"_26439":1816,"_2811":52922},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3323":1818,"_29044":1816,"_5":29385,"_20168":52924,"_26439":52925,"_2811":52926},[],"/docs/pr-preview/pr-46/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3323":1819,"_29044":1816,"_5":29385,"_20168":52928,"_26439":52929,"_2811":52930},[],"/docs/pr-preview/pr-46/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3323":1820,"_29044":1816,"_5":29385,"_20168":52932,"_26439":52933,"_2811":47309},[],"/docs/pr-preview/pr-46/platform/pki/certificate-authorities#before-you-begin",{"_3323":1821,"_29044":1816,"_5":29385,"_20168":52935,"_26439":52936,"_2811":52937},[],"/docs/pr-preview/pr-46/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3323":1822,"_29044":1816,"_5":29385,"_20168":52939,"_26439":52940,"_2811":52941},[],"/docs/pr-preview/pr-46/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3323":1823,"_29044":1816,"_5":29385,"_20168":52943,"_26439":52944,"_2811":52945},[],"/docs/pr-preview/pr-46/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3323":1824,"_29044":1816,"_5":29385,"_20168":52947,"_26439":52948,"_2811":52949},[],"/docs/pr-preview/pr-46/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3323":1825,"_29044":1816,"_5":29385,"_20168":52951,"_26439":52952,"_2811":52953},[],"/docs/pr-preview/pr-46/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3323":1826,"_29044":1816,"_5":29385,"_20168":52955,"_26439":52956,"_2811":52957},[],"/docs/pr-preview/pr-46/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3323":1827,"_29044":1816,"_5":29385,"_20168":52959,"_26439":52960,"_2811":52961},[],"/docs/pr-preview/pr-46/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3323":1828,"_29044":1816,"_5":29385,"_20168":52963,"_26439":52964,"_2811":52965},[],"/docs/pr-preview/pr-46/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3323":1829,"_29044":1816,"_5":29385,"_20168":52967,"_26439":52968,"_2811":52969},[],"/docs/pr-preview/pr-46/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3323":1830,"_29044":1816,"_5":29385,"_20168":52971,"_26439":52972,"_2811":52973},[],"/docs/pr-preview/pr-46/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3323":1831,"_29044":1816,"_5":29385,"_20168":52975,"_26439":52976,"_2811":52977},[],"/docs/pr-preview/pr-46/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3323":1832,"_29044":1816,"_5":29385,"_20168":52979,"_26439":52980,"_2811":52981},[],"/docs/pr-preview/pr-46/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3323":1833,"_29044":1816,"_5":29385,"_20168":52983,"_26439":52984,"_2811":52985},[],"/docs/pr-preview/pr-46/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3323":1834,"_29044":1816,"_5":29385,"_20168":52987,"_26439":52988,"_2811":52989},[],"/docs/pr-preview/pr-46/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3323":1835,"_29044":1816,"_5":29385,"_20168":52991,"_26439":52992,"_2811":52993},[],"/docs/pr-preview/pr-46/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3323":1836,"_29044":1816,"_5":29385,"_20168":52995,"_26439":52996,"_2811":52997},[],"/docs/pr-preview/pr-46/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3323":1837,"_29044":1816,"_5":29385,"_20168":52999,"_26439":53000,"_2811":53001},[],"/docs/pr-preview/pr-46/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3323":1838,"_29044":1816,"_5":29385,"_20168":53003,"_26439":53004,"_2811":53005},[],"/docs/pr-preview/pr-46/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3323":1839,"_29044":1816,"_5":29385,"_20168":53007,"_26439":53008,"_2811":53009},[],"/docs/pr-preview/pr-46/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3323":1840,"_29044":1816,"_5":29385,"_20168":53011,"_26439":53012,"_2811":53013},[],"/docs/pr-preview/pr-46/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3323":1841,"_29044":1816,"_20168":53015,"_5":13790,"_26439":1816,"_2811":53016},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3323":1842,"_29044":1816,"_20168":53018,"_5":13790,"_26439":1816,"_2811":53019},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3323":1843,"_29044":1816,"_20168":53021,"_5":13790,"_26439":1816,"_2811":53022},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3323":1844,"_29044":1816,"_20168":53024,"_5":13790,"_26439":52925,"_2811":53025},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3323":1845,"_29044":1816,"_20168":53027,"_5":13790,"_26439":52925,"_2811":53028},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3323":1846,"_29044":1816,"_20168":53030,"_5":13790,"_26439":52925,"_2811":53031},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3323":1847,"_29044":1816,"_20168":53033,"_5":13790,"_26439":52925,"_2811":53034},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3323":1848,"_29044":1816,"_20168":53036,"_5":13790,"_26439":52925,"_2811":53037},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3323":1849,"_29044":1816,"_20168":53039,"_5":13790,"_26439":52933,"_2811":53040},[],"Decide whether the CA will be a root or an intermediate.",{"_3323":1850,"_29044":1816,"_20168":53042,"_5":13790,"_26439":52933,"_2811":53043},[],"Choose the engine that will keep the key.",{"_3323":1851,"_29044":1816,"_20168":53045,"_5":13790,"_26439":52933,"_2811":53046},[],"Define a validity longer than that of the certificates it will issue.",{"_3323":1852,"_29044":1816,"_20168":53048,"_5":13790,"_26439":52933,"_2811":53049},[],"For an intermediate CA, make sure the parent CA is active.",{"_3323":1853,"_29044":1816,"_20168":53051,"_5":13790,"_26439":52936,"_2811":53052},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3323":1854,"_29044":1816,"_20168":53054,"_5":13790,"_26439":52940,"_2811":53055},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3323":1855,"_29044":1816,"_20168":53057,"_5":13790,"_26439":52940,"_2811":53058},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3323":1856,"_29044":1816,"_20168":53060,"_5":13790,"_26439":52944,"_2811":53061},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3323":1857,"_29044":1816,"_20168":53063,"_5":13790,"_26439":52948,"_2811":53064},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3323":1858,"_29044":1816,"_20168":53066,"_5":13790,"_26439":52948,"_2811":53067},[],"`C`: two-letter ISO 3166-1 country code.",{"_3323":1859,"_29044":1816,"_20168":53069,"_5":13790,"_26439":52948,"_2811":53070},[],"`ST`: state or province.",{"_3323":1860,"_29044":1816,"_20168":53072,"_5":13790,"_26439":52948,"_2811":53073},[],"`L`: locality.",{"_3323":1861,"_29044":1816,"_20168":53075,"_5":13790,"_26439":52948,"_2811":53076},[],"`O`: organization.",{"_3323":1862,"_29044":1816,"_20168":53078,"_5":13790,"_26439":52948,"_2811":53079},[],"`OU`: organizational unit.",{"_3323":1863,"_29044":1816,"_20168":53081,"_5":13790,"_26439":52948,"_2811":53082},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3323":1864,"_29044":1816,"_20168":53084,"_5":13790,"_26439":52952,"_2811":53085},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3323":1865,"_29044":1816,"_20168":53087,"_5":13790,"_26439":52952,"_2811":53088},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3323":1866,"_29044":1816,"_20168":53090,"_5":13790,"_26439":52956,"_2811":53091},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3323":1867,"_29044":1816,"_20168":53093,"_5":13790,"_26439":52956,"_2811":53094},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3323":1868,"_29044":1816,"_20168":53096,"_5":13790,"_26439":52960,"_2811":53097},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3323":1869,"_29044":1816,"_20168":53099,"_5":13790,"_26439":52960,"_2811":53100},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3323":1870,"_29044":1816,"_20168":53102,"_5":13790,"_26439":52964,"_2811":53103},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3323":1871,"_29044":1816,"_20168":53105,"_5":13790,"_26439":52968,"_2811":53106},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3323":1872,"_29044":1816,"_20168":53108,"_5":13790,"_26439":52972,"_2811":53109},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3323":1873,"_29044":1816,"_20168":53111,"_5":13790,"_26439":52976,"_2811":53112},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3323":1874,"_29044":1816,"_20168":53114,"_5":13790,"_26439":52980,"_2811":53115},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3323":1875,"_29044":1816,"_20168":53117,"_5":13790,"_26439":52980,"_2811":53118},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3323":1876,"_29044":1816,"_20168":53120,"_5":13790,"_26439":52984,"_2811":53121},[],"Open a CA from the inventory to review:",{"_3323":1877,"_29044":1816,"_20168":53123,"_5":13790,"_26439":52984,"_2811":53124},[],"Status and validity period.",{"_3323":1878,"_29044":1816,"_20168":53126,"_5":13790,"_26439":52984,"_2811":53127},[],"Certificate and chain in PEM format.",{"_3323":1879,"_29044":1816,"_20168":53129,"_5":13790,"_26439":52984,"_2811":53130},[],"Number of active, expired and revoked certificates.",{"_3323":1880,"_29044":1816,"_20168":53132,"_5":13790,"_26439":52984,"_2811":53133},[],"Certificates issued in **Issued Certificates**.",{"_3323":1881,"_29044":1816,"_20168":53135,"_5":13790,"_26439":52984,"_2811":53136},[],"The CRL linked to the authority.",{"_3323":1882,"_29044":1816,"_20168":53138,"_5":13790,"_26439":52984,"_2811":53139},[],"Metadata and the associated cryptographic engine.",{"_3323":1883,"_29044":1816,"_20168":53141,"_5":13790,"_26439":52984,"_2811":53142},[],"You can filter the inventory by name, status and CA type.",{"_3323":1884,"_29044":1816,"_20168":53144,"_5":13790,"_26439":52988,"_2811":53145},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3323":1885,"_29044":1816,"_20168":53147,"_5":13790,"_26439":52988,"_2811":53148},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3323":1886,"_29044":1816,"_20168":53150,"_5":13790,"_26439":52988,"_2811":53151},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3323":1887,"_29044":1816,"_20168":53153,"_5":13790,"_26439":52988,"_2811":53154},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3323":1888,"_29044":1816,"_20168":53156,"_5":13790,"_26439":52992,"_2811":53157},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3323":1889,"_29044":1816,"_20168":53159,"_5":13790,"_26439":52996,"_2811":53160},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3323":1890,"_29044":1816,"_20168":53162,"_5":13790,"_26439":53000,"_2811":53163},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3323":1891,"_29044":1816,"_20168":53165,"_5":13790,"_26439":53004,"_2811":53166},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3323":1892,"_29044":1816,"_20168":53168,"_5":13790,"_26439":53008,"_2811":53169},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3323":1893,"_29044":1816,"_20168":53171,"_5":13790,"_26439":53012,"_2811":53172},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3323":1894,"_29044":1816,"_20168":53174,"_5":13790,"_26439":53012,"_2811":53175},[],"The CA’s VA role is kept. If no other CA with the same SKI remains, it can no longer be edited (see CRL), so adjust its validity and signer beforehand. The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3323":1895,"_29044":1816,"_20168":53177,"_5":13790,"_26439":53012,"_2811":53178},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. If the new certificate uses the same key, it shares the SKI with the retained VA role of the deleted CA, whose signer is the old certificate: check that the CRL is generated and, if it is not, use `PUT` to set a signer of the new CA (see CRL).",{"_3323":1896,"_29044":1896,"_5":14148,"_2811":53180,"_29388":53181,"_20168":53182,"_26439":1896},"Certificate profiles",[47299,48748,52757,52758],[],{"_3323":1897,"_29044":1896,"_20168":53184,"_5":13790,"_26439":1896,"_2811":53185},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3323":1898,"_29044":1896,"_5":29385,"_20168":53187,"_26439":53188,"_2811":53189},[],"/docs/pr-preview/pr-46/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3323":1899,"_29044":1896,"_5":29385,"_20168":53191,"_26439":53192,"_2811":53193},[],"/docs/pr-preview/pr-46/platform/pki/certificate-profiles#validity","Validity",{"_3323":1900,"_29044":1896,"_5":29385,"_20168":53195,"_26439":53196,"_2811":53197},[],"/docs/pr-preview/pr-46/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3323":1901,"_29044":1896,"_5":29385,"_20168":53199,"_26439":53200,"_2811":53201},[],"/docs/pr-preview/pr-46/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3323":1902,"_29044":1896,"_5":29385,"_20168":53203,"_26439":53204,"_2811":53205},[],"/docs/pr-preview/pr-46/platform/pki/certificate-profiles#subject","Subject",{"_3323":1903,"_29044":1896,"_5":29385,"_20168":53207,"_26439":53208,"_2811":53209},[],"/docs/pr-preview/pr-46/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3323":1904,"_29044":1896,"_5":29385,"_20168":53211,"_26439":53212,"_2811":53213},[],"/docs/pr-preview/pr-46/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3323":1905,"_29044":1896,"_5":29385,"_20168":53215,"_26439":53216,"_2811":53217},[],"/docs/pr-preview/pr-46/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3323":1906,"_29044":1896,"_5":29385,"_20168":53219,"_26439":53220,"_2811":53221},[],"/docs/pr-preview/pr-46/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3323":1907,"_29044":1896,"_5":29385,"_20168":53223,"_26439":53224,"_2811":53225},[],"/docs/pr-preview/pr-46/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3323":1908,"_29044":1896,"_5":29385,"_20168":53227,"_26439":53228,"_2811":53229},[],"/docs/pr-preview/pr-46/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3323":1909,"_29044":1896,"_5":29385,"_20168":53231,"_26439":53232,"_2811":53233},[],"/docs/pr-preview/pr-46/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3323":1910,"_29044":1896,"_5":29385,"_20168":53235,"_26439":53236,"_2811":53237},[],"/docs/pr-preview/pr-46/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3323":1911,"_29044":1896,"_5":29385,"_20168":53239,"_26439":53240,"_2811":53241},[],"/docs/pr-preview/pr-46/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3323":1912,"_29044":1896,"_5":29385,"_20168":53243,"_26439":53244,"_2811":53245},[],"/docs/pr-preview/pr-46/platform/pki/certificate-profiles#design-examples","Design examples",{"_3323":1913,"_29044":1896,"_5":29385,"_20168":53247,"_26439":53248,"_2811":53249},[],"/docs/pr-preview/pr-46/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3323":1914,"_29044":1896,"_20168":53251,"_5":13790,"_26439":1896,"_2811":53252},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3323":1915,"_29044":1896,"_20168":53254,"_5":13790,"_26439":1896,"_2811":53255},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3323":1916,"_29044":1896,"_20168":53257,"_5":13790,"_26439":53192,"_2811":53258},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3323":1917,"_29044":1896,"_20168":53260,"_5":13790,"_26439":53192,"_2811":53261},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3323":1918,"_29044":1896,"_20168":53263,"_5":13790,"_26439":53196,"_2811":53264},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3323":1919,"_29044":1896,"_20168":53266,"_5":13790,"_26439":53200,"_2811":53267},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3323":1920,"_29044":1896,"_20168":53269,"_5":13790,"_26439":53200,"_2811":53270},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3323":1921,"_29044":1896,"_20168":53272,"_5":13790,"_26439":53200,"_2811":53273},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3323":1922,"_29044":1896,"_20168":53275,"_5":13790,"_26439":53204,"_2811":53276},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3323":1923,"_29044":1896,"_20168":53278,"_5":13790,"_26439":53208,"_2811":53279},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3323":1924,"_29044":1896,"_20168":53281,"_5":13790,"_26439":53208,"_2811":53282},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3323":1925,"_29044":1896,"_20168":53284,"_5":13790,"_26439":53212,"_2811":53285},[],"The cryptographic enforcement can:",{"_3323":1926,"_29044":1896,"_20168":53287,"_5":13790,"_26439":53212,"_2811":53288},[],"allow or block RSA keys;",{"_3323":1927,"_29044":1896,"_20168":53290,"_5":13790,"_26439":53212,"_2811":53291},[],"limit the supported RSA sizes;",{"_3323":1928,"_29044":1896,"_20168":53293,"_5":13790,"_26439":53212,"_2811":53294},[],"allow or block ECDSA keys;",{"_3323":1929,"_29044":1896,"_20168":53296,"_5":13790,"_26439":53212,"_2811":53297},[],"limit the supported ECDSA sizes or curves.",{"_3323":1930,"_29044":1896,"_20168":53299,"_5":13790,"_26439":53212,"_2811":53300},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3323":1931,"_29044":1896,"_20168":53302,"_5":13790,"_26439":53216,"_2811":53303},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3323":1932,"_29044":1896,"_20168":53305,"_5":13790,"_26439":53216,"_2811":50512},[],{"_3323":1933,"_29044":1896,"_20168":53307,"_5":13790,"_26439":53216,"_2811":53308},[],"First choice",{"_3323":1934,"_29044":1896,"_20168":53310,"_5":13790,"_26439":53216,"_2811":53311},[],"Second choice",{"_3323":1935,"_29044":1896,"_20168":53313,"_5":13790,"_26439":53216,"_2811":53314},[],"If neither is supplied",{"_3323":1936,"_29044":1896,"_20168":53316,"_5":13790,"_26439":53216,"_2811":53317},[],"Direct signing with a CA",{"_3323":1937,"_29044":1896,"_20168":53319,"_5":13790,"_26439":53216,"_2811":53320},[],"`issuance_profile` embedded in the request",{"_3323":1938,"_29044":1896,"_20168":53322,"_5":13790,"_26439":53216,"_2811":53323},[],"Request `issuance_profile_id`",{"_3323":1939,"_29044":1896,"_20168":53325,"_5":13790,"_26439":53216,"_2811":53326},[],"CA default profile (`profile_id`).",{"_3323":1940,"_29044":1896,"_20168":53328,"_5":13790,"_26439":53216,"_2811":53329},[],"Issuance through a DMS",{"_3323":1941,"_29044":1896,"_20168":53331,"_5":13790,"_26439":53216,"_2811":53332},[],"`settings.issuance_profile_id`",{"_3323":1942,"_29044":1896,"_20168":53334,"_5":13790,"_26439":53216,"_2811":53335},[],"`settings.issuance_profile` embedded in the DMS",{"_3323":1943,"_29044":1896,"_20168":53337,"_5":13790,"_26439":53216,"_2811":53338},[],"Enrollment CA default profile.",{"_3323":1944,"_29044":1896,"_20168":53340,"_5":13790,"_26439":53216,"_2811":53341},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3323":1945,"_29044":1896,"_20168":53343,"_5":13790,"_26439":53216,"_2811":53344},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3323":1946,"_29044":1896,"_20168":53346,"_5":13790,"_26439":53224,"_2811":53347},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3323":1947,"_29044":1896,"_20168":53349,"_5":13790,"_26439":53228,"_2811":53350},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3323":1948,"_29044":1896,"_20168":53352,"_5":13790,"_26439":53232,"_2811":53353},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3323":1949,"_29044":1896,"_20168":53355,"_5":13790,"_26439":53236,"_2811":53356},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3323":1950,"_29044":1896,"_20168":53358,"_5":13790,"_26439":53240,"_2811":53359},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3323":1951,"_29044":1896,"_20168":53361,"_5":13790,"_26439":53240,"_2811":53362},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3323":1952,"_29044":1896,"_20168":53364,"_5":13790,"_26439":53244,"_2811":53365},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3323":1953,"_29044":1896,"_20168":53367,"_5":13790,"_26439":53244,"_2811":53368},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3323":1954,"_29044":1896,"_20168":53370,"_5":13790,"_26439":53244,"_2811":53371},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3323":1955,"_29044":1896,"_20168":53373,"_5":13790,"_26439":53244,"_2811":53374},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3323":1956,"_29044":1896,"_20168":53376,"_5":13790,"_26439":53248,"_2811":53377},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3323":1957,"_29044":1896,"_20168":53379,"_5":13790,"_26439":53248,"_2811":53380},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3323":1958,"_29044":1958,"_5":14148,"_2811":53382,"_29388":53383,"_20168":53385,"_26439":1958},"Certificate validation",[47299,48748,52757,53384],"Validation",[],{"_3323":1959,"_29044":1958,"_20168":53387,"_5":13790,"_26439":1958,"_2811":53388},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3323":1960,"_29044":1958,"_5":29385,"_20168":53390,"_26439":53391,"_2811":53392},[],"/docs/pr-preview/pr-46/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3323":1961,"_29044":1958,"_5":29385,"_20168":53394,"_26439":53395,"_2811":53396},[],"/docs/pr-preview/pr-46/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3323":1962,"_29044":1958,"_5":29385,"_20168":53398,"_26439":53399,"_2811":53400},[],"/docs/pr-preview/pr-46/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3323":1963,"_29044":1958,"_20168":53402,"_5":13790,"_26439":1958,"_2811":53403},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3323":1964,"_29044":1958,"_20168":53405,"_5":13790,"_26439":53391,"_2811":53406},[],"Verify these criteria together:",{"_3323":1965,"_29044":1958,"_20168":53408,"_5":13790,"_26439":53391,"_2811":52383},[],{"_3323":1966,"_29044":1958,"_20168":53410,"_5":13790,"_26439":53391,"_2811":53411},[],"Required result",{"_3323":1967,"_29044":1958,"_20168":53413,"_5":13790,"_26439":53391,"_2811":53414},[],"Chain and signature",{"_3323":1968,"_29044":1958,"_20168":53416,"_5":13790,"_26439":53391,"_2811":53417},[],"Valid chain to a root deliberately installed in the consumer.",{"_3323":1969,"_29044":1958,"_20168":53419,"_5":13790,"_26439":53391,"_2811":53420},[],"Dates",{"_3323":1970,"_29044":1958,"_20168":53422,"_5":13790,"_26439":53391,"_2811":53423},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3323":1971,"_29044":1958,"_20168":53425,"_5":13790,"_26439":53391,"_2811":48417},[],{"_3323":1972,"_29044":1958,"_20168":53427,"_5":13790,"_26439":53391,"_2811":53428},[],"Name, SAN or identifier matches the expected peer.",{"_3323":1973,"_29044":1958,"_20168":53430,"_5":13790,"_26439":53391,"_2811":47689},[],{"_3323":1974,"_29044":1958,"_20168":53432,"_5":13790,"_26439":53391,"_2811":53433},[],"KU, EKU and constraints permit the specific operation.",{"_3323":1975,"_29044":1958,"_20168":53435,"_5":13790,"_26439":53391,"_2811":53436},[],"Revocation",{"_3323":1976,"_29044":1958,"_20168":53438,"_5":13790,"_26439":53391,"_2811":53439},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3323":1977,"_29044":1958,"_20168":53441,"_5":13790,"_26439":53391,"_2811":53442},[],"Authorization",{"_3323":1978,"_29044":1958,"_20168":53444,"_5":13790,"_26439":53391,"_2811":53445},[],"The application permits that identity to perform the action.",{"_3323":1979,"_29044":1958,"_20168":53447,"_5":13790,"_26439":53391,"_2811":53448},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3323":1980,"_29044":1958,"_20168":53450,"_5":13790,"_26439":53395,"_2811":53451},[],"Mechanism",{"_3323":1981,"_29044":1958,"_20168":53453,"_5":13790,"_26439":53395,"_2811":53454},[],"When to use it",{"_3323":1982,"_29044":1958,"_20168":53456,"_5":13790,"_26439":53395,"_2811":53457},[],"What you must maintain",{"_3323":1983,"_29044":1958,"_20168":53459,"_5":13790,"_26439":53395,"_2811":53460},[],"OCSP",{"_3323":1984,"_29044":1958,"_20168":53462,"_5":13790,"_26439":53395,"_2811":53463},[],"Status query for a specific certificate.",{"_3323":1985,"_29044":1958,"_20168":53465,"_5":13790,"_26439":53395,"_2811":53466},[],"Responder access, signature verification and cache/freshness policy.",{"_3323":1986,"_29044":1958,"_20168":53468,"_5":13790,"_26439":53395,"_2811":53469},[],"CRL",{"_3323":1987,"_29044":1958,"_20168":53471,"_5":13790,"_26439":53395,"_2811":53472},[],"Local checks for many certificates or offline operation.",{"_3323":1988,"_29044":1958,"_20168":53474,"_5":13790,"_26439":53395,"_2811":53475},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3323":1989,"_29044":1958,"_20168":53477,"_5":13790,"_26439":53395,"_2811":53478},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3323":1990,"_29044":1958,"_20168":53480,"_5":13790,"_26439":53395,"_2811":53481},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3323":1991,"_29044":1958,"_20168":53483,"_5":13790,"_26439":53399,"_2811":53484},[],"Accept a current, authorized certificate with a known chain.",{"_3323":1992,"_29044":1958,"_20168":53486,"_5":13790,"_26439":53399,"_2811":53487},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3323":1993,"_29044":1958,"_20168":53489,"_5":13790,"_26439":53399,"_2811":53490},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3323":1994,"_29044":1958,"_20168":53492,"_5":13790,"_26439":53399,"_2811":53493},[],"Check that a new connection with that identity is rejected.",{"_3323":1995,"_29044":1958,"_20168":53495,"_5":13790,"_26439":53399,"_2811":53496},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3323":1996,"_29044":1958,"_20168":53498,"_5":13790,"_26439":53399,"_2811":53499},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3323":1997,"_29044":1958,"_20168":53501,"_5":13790,"_26439":53399,"_2811":53502},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3323":1998,"_29044":1958,"_20168":53504,"_5":13790,"_26439":53399,"_2811":53505},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3323":1999,"_29044":1958,"_20168":53507,"_5":13790,"_26439":53399,"_2811":53508},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3323":2000,"_29044":2000,"_5":14148,"_2811":53510,"_29388":53511,"_20168":53512,"_26439":2000},"Certificates",[47299,48748,52757,52758],[],{"_3323":2001,"_29044":2000,"_20168":53514,"_5":13790,"_26439":2000,"_2811":53515},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3323":2002,"_29044":2000,"_5":29385,"_20168":53517,"_26439":53518,"_2811":53519},[],"/docs/pr-preview/pr-46/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3323":2003,"_29044":2000,"_5":29385,"_20168":53521,"_26439":53522,"_2811":53523},[],"/docs/pr-preview/pr-46/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3323":2004,"_29044":2000,"_5":29385,"_20168":53525,"_26439":53526,"_2811":53527},[],"/docs/pr-preview/pr-46/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3323":2005,"_29044":2000,"_5":29385,"_20168":53529,"_26439":53530,"_2811":53531},[],"/docs/pr-preview/pr-46/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3323":2006,"_29044":2000,"_5":29385,"_20168":53533,"_26439":53534,"_2811":53535},[],"/docs/pr-preview/pr-46/platform/pki/certificates#open-the-action","Open the action",{"_3323":2007,"_29044":2000,"_5":29385,"_20168":53537,"_26439":53538,"_2811":53539},[],"/docs/pr-preview/pr-46/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3323":2008,"_29044":2000,"_5":29385,"_20168":53541,"_26439":53542,"_2811":53543},[],"/docs/pr-preview/pr-46/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3323":2009,"_29044":2000,"_5":29385,"_20168":53545,"_26439":53546,"_2811":53547},[],"/docs/pr-preview/pr-46/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3323":2010,"_29044":2000,"_5":29385,"_20168":53549,"_26439":53550,"_2811":53551},[],"/docs/pr-preview/pr-46/platform/pki/certificates#continue","Continue",{"_3323":2011,"_29044":2000,"_20168":53553,"_5":13790,"_26439":2000,"_2811":53554},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3323":2012,"_29044":2000,"_20168":53556,"_5":13790,"_26439":53518,"_2811":53557},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3323":2013,"_29044":2000,"_20168":53559,"_5":13790,"_26439":53518,"_2811":53560},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3323":2014,"_29044":2000,"_20168":53562,"_5":13790,"_26439":53522,"_2811":53563},[],"Download the PEM and inspect it:",{"_3323":2015,"_29044":2000,"_20168":53565,"_5":13790,"_26439":53522,"_2811":53566},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3323":2016,"_29044":2000,"_20168":53568,"_5":13790,"_26439":53526,"_2811":53569},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3323":2017,"_29044":2000,"_20168":53571,"_5":13790,"_26439":53526,"_2811":53572},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3323":2018,"_29044":2000,"_20168":53574,"_5":13790,"_26439":53526,"_2811":53575},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3323":2019,"_29044":2000,"_20168":53577,"_5":13790,"_26439":53526,"_2811":53578},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3323":2020,"_29044":2000,"_20168":53580,"_5":13790,"_26439":53526,"_2811":53581},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3323":2021,"_29044":2000,"_20168":53583,"_5":13790,"_26439":53526,"_2811":53584},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3323":2022,"_29044":2000,"_20168":53586,"_5":13790,"_26439":53526,"_2811":53587},[],"For browser key generation, follow Issue your first certificate.",{"_3323":2023,"_29044":2000,"_20168":53589,"_5":13790,"_26439":53530,"_2811":53590},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3323":2024,"_29044":2000,"_20168":53592,"_5":13790,"_26439":53534,"_2811":53593},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3323":2025,"_29044":2000,"_20168":53595,"_5":13790,"_26439":53538,"_2811":53596},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3323":2026,"_29044":2000,"_20168":53598,"_5":13790,"_26439":53542,"_2811":53599},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3323":2027,"_29044":2000,"_20168":53601,"_5":13790,"_26439":53542,"_2811":53602},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3323":2028,"_29044":2000,"_20168":53604,"_5":13790,"_26439":53542,"_2811":53605},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3323":2029,"_29044":2000,"_20168":53607,"_5":13790,"_26439":53546,"_2811":53608},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3323":2030,"_29044":2000,"_20168":53610,"_5":13790,"_26439":53546,"_2811":53611},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3323":2031,"_29044":2000,"_20168":53613,"_5":13790,"_26439":53546,"_2811":53614},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3323":2032,"_29044":2000,"_20168":53616,"_5":13790,"_26439":53550,"_2811":53617},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3323":2033,"_29044":2000,"_20168":53619,"_5":13790,"_26439":53550,"_2811":53620},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3323":2034,"_29044":2034,"_5":14148,"_2811":53622,"_29388":53623,"_20168":53625,"_26439":2034},"Certificate lifecycle",[47299,48748,52757,53624],"Concepts",[],{"_3323":2035,"_29044":2034,"_20168":53627,"_5":13790,"_26439":2034,"_2811":53628},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3323":2036,"_29044":2034,"_5":29385,"_20168":53630,"_26439":53631,"_2811":53632},[],"/docs/pr-preview/pr-46/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3323":2037,"_29044":2034,"_5":29385,"_20168":53634,"_26439":53635,"_2811":53636},[],"/docs/pr-preview/pr-46/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3323":2038,"_29044":2034,"_5":29385,"_20168":53638,"_26439":53639,"_2811":53640},[],"/docs/pr-preview/pr-46/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3323":2039,"_29044":2034,"_5":29385,"_20168":53642,"_26439":53643,"_2811":53644},[],"/docs/pr-preview/pr-46/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3323":2040,"_29044":2034,"_5":29385,"_20168":53646,"_26439":53647,"_2811":53648},[],"/docs/pr-preview/pr-46/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3323":2041,"_29044":2034,"_5":29385,"_20168":53650,"_26439":53651,"_2811":53652},[],"/docs/pr-preview/pr-46/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3323":2042,"_29044":2034,"_5":29385,"_20168":53654,"_26439":53655,"_2811":53656},[],"/docs/pr-preview/pr-46/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3323":2043,"_29044":2034,"_5":29385,"_20168":53658,"_26439":53659,"_2811":53660},[],"/docs/pr-preview/pr-46/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3323":2044,"_29044":2034,"_5":29385,"_20168":53662,"_26439":53663,"_2811":53664},[],"/docs/pr-preview/pr-46/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3323":2045,"_29044":2034,"_5":29385,"_20168":53666,"_26439":53667,"_2811":53668},[],"/docs/pr-preview/pr-46/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3323":2046,"_29044":2034,"_20168":53670,"_5":13790,"_26439":2034,"_2811":53671},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3323":2047,"_29044":2034,"_20168":53673,"_5":13790,"_26439":53635,"_2811":53674},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3323":2048,"_29044":2034,"_20168":53676,"_5":13790,"_26439":53639,"_2811":53677},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3323":2049,"_29044":2034,"_20168":53679,"_5":13790,"_26439":53643,"_2811":53680},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3323":2050,"_29044":2034,"_20168":53682,"_5":13790,"_26439":53647,"_2811":53683},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3323":2051,"_29044":2034,"_20168":53685,"_5":13790,"_26439":53651,"_2811":53686},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3323":2052,"_29044":2034,"_20168":53688,"_5":13790,"_26439":53655,"_2811":53689},[],"Lamassu persists four X.509 states:",{"_3323":2053,"_29044":2034,"_20168":53691,"_5":13790,"_26439":53655,"_2811":53692},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3323":2054,"_29044":2034,"_20168":53694,"_5":13790,"_26439":53655,"_2811":53695},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3323":2055,"_29044":2034,"_20168":53697,"_5":13790,"_26439":53655,"_2811":53698},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3323":2056,"_29044":2034,"_20168":53700,"_5":13790,"_26439":53655,"_2811":53701},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3323":2057,"_29044":2034,"_20168":53703,"_5":13790,"_26439":53655,"_2811":53704},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3323":2058,"_29044":2034,"_20168":53706,"_5":13790,"_26439":53659,"_2811":53707},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3323":2059,"_29044":2034,"_20168":53709,"_5":13790,"_26439":53659,"_2811":53710},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3323":2060,"_29044":2034,"_20168":53712,"_5":13790,"_26439":53659,"_2811":53713},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3323":2061,"_29044":2034,"_20168":53715,"_5":13790,"_26439":53663,"_2811":53716},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3323":2062,"_29044":2034,"_20168":53718,"_5":13790,"_26439":53663,"_2811":53719},[],"Before confirming:",{"_3323":2063,"_29044":2034,"_20168":53721,"_5":13790,"_26439":53663,"_2811":53722},[],"Identify DMSs, devices and services that trust that chain.",{"_3323":2064,"_29044":2034,"_20168":53724,"_5":13790,"_26439":53663,"_2811":53725},[],"Distribute the new chain of trust.",{"_3323":2065,"_29044":2034,"_20168":53727,"_5":13790,"_26439":53663,"_2811":53728},[],"Reissue the necessary identities.",{"_3323":2066,"_29044":2034,"_20168":53730,"_5":13790,"_26439":53663,"_2811":53731},[],"Check OCSP and CRL from a real consumer.",{"_3323":2067,"_29044":2034,"_20168":53733,"_5":13790,"_26439":53663,"_2811":53734},[],"Revoke the old CA once no legitimate traffic remains.",{"_3323":2068,"_29044":2034,"_20168":53736,"_5":13790,"_26439":53663,"_2811":53737},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3323":2069,"_29044":2034,"_20168":53739,"_5":13790,"_26439":53667,"_2811":53740},[],"Certificates entering the preventive or critical renewal window.",{"_3323":2070,"_29044":2034,"_20168":53742,"_5":13790,"_26439":53667,"_2811":53743},[],"Repeated enrollment or re-enrollment failures.",{"_3323":2071,"_29044":2034,"_20168":53745,"_5":13790,"_26439":53667,"_2811":53746},[],"Status changes and revocation reasons.",{"_3323":2072,"_29044":2034,"_20168":53748,"_5":13790,"_26439":53667,"_2811":53749},[],"OCSP and CRL publication and validity.",{"_3323":2073,"_29044":2034,"_20168":53751,"_5":13790,"_26439":53667,"_2811":53752},[],"Dependencies still presenting a replaced certificate.",{"_3323":2074,"_29044":2034,"_20168":53754,"_5":13790,"_26439":53667,"_2811":53755},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3323":2075,"_29044":2075,"_5":14148,"_2811":53757,"_29388":53758,"_20168":53759,"_26439":2075},"Trust model",[47299,48748,52757,53624],[],{"_3323":2076,"_29044":2075,"_20168":53761,"_5":13790,"_26439":2075,"_2811":53762},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3323":2077,"_29044":2075,"_5":29385,"_20168":53764,"_26439":53765,"_2811":53766},[],"/docs/pr-preview/pr-46/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3323":2078,"_29044":2075,"_5":29385,"_20168":53768,"_26439":53769,"_2811":53770},[],"/docs/pr-preview/pr-46/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3323":2079,"_29044":2075,"_5":29385,"_20168":53772,"_26439":53773,"_2811":53774},[],"/docs/pr-preview/pr-46/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3323":2080,"_29044":2075,"_5":29385,"_20168":53776,"_26439":53777,"_2811":53778},[],"/docs/pr-preview/pr-46/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3323":2081,"_29044":2075,"_5":29385,"_20168":53780,"_26439":53781,"_2811":53782},[],"/docs/pr-preview/pr-46/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3323":2082,"_29044":2075,"_5":29385,"_20168":53784,"_26439":53785,"_2811":53786},[],"/docs/pr-preview/pr-46/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3323":2083,"_29044":2075,"_5":29385,"_20168":53788,"_26439":53789,"_2811":53790},[],"/docs/pr-preview/pr-46/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3323":2084,"_29044":2075,"_5":29385,"_20168":53792,"_26439":53793,"_2811":53794},[],"/docs/pr-preview/pr-46/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3323":2085,"_29044":2075,"_5":29385,"_20168":53796,"_26439":53797,"_2811":53798},[],"/docs/pr-preview/pr-46/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3323":2086,"_29044":2075,"_5":29385,"_20168":53800,"_26439":53801,"_2811":53802},[],"/docs/pr-preview/pr-46/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3323":2087,"_29044":2075,"_20168":53804,"_5":13790,"_26439":2075,"_2811":53805},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3323":2088,"_29044":2075,"_20168":53807,"_5":13790,"_26439":53769,"_2811":53808},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3323":2089,"_29044":2075,"_20168":53810,"_5":13790,"_26439":53773,"_2811":53811},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3323":2090,"_29044":2075,"_20168":53813,"_5":13790,"_26439":53777,"_2811":53814},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3323":2091,"_29044":2075,"_20168":53816,"_5":13790,"_26439":53781,"_2811":53817},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3323":2092,"_29044":2075,"_20168":53819,"_5":13790,"_26439":53785,"_2811":53820},[],"The device proves it can enroll according to the DMS policy.",{"_3323":2093,"_29044":2075,"_20168":53822,"_5":13790,"_26439":53785,"_2811":53823},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3323":2094,"_29044":2075,"_20168":53825,"_5":13790,"_26439":53785,"_2811":53826},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3323":2095,"_29044":2075,"_20168":53828,"_5":13790,"_26439":53785,"_2811":53829},[],"The device installs the certificate and the chain it needs.",{"_3323":2096,"_29044":2075,"_20168":53831,"_5":13790,"_26439":53785,"_2811":53832},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3323":2097,"_29044":2075,"_20168":53834,"_5":13790,"_26439":53785,"_2811":53835},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3323":2098,"_29044":2075,"_20168":53837,"_5":13790,"_26439":53789,"_2811":53838},[],"A DMS relates three sets that are worth designing separately:",{"_3323":2099,"_29044":2075,"_20168":53840,"_5":13790,"_26439":53789,"_2811":53841},[],"**Enrollment CA:** signs the new identities.",{"_3323":2100,"_29044":2075,"_20168":53843,"_5":13790,"_26439":53789,"_2811":53844},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3323":2101,"_29044":2075,"_20168":53846,"_5":13790,"_26439":53789,"_2811":53847},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3323":2102,"_29044":2075,"_20168":53849,"_5":13790,"_26439":53789,"_2811":53850},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3323":2103,"_29044":2075,"_20168":53852,"_5":13790,"_26439":53793,"_2811":53853},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3323":2104,"_29044":2075,"_20168":53855,"_5":13790,"_26439":53793,"_2811":53856},[],"that the current date is between `Not Before` and `Not After`;",{"_3323":2105,"_29044":2075,"_20168":53858,"_5":13790,"_26439":53793,"_2811":53859},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3323":2106,"_29044":2075,"_20168":53861,"_5":13790,"_26439":53793,"_2811":53862},[],"that names, SANs and subject match the expected identity;",{"_3323":2107,"_29044":2075,"_20168":53864,"_5":13790,"_26439":53793,"_2811":53865},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3323":2108,"_29044":2075,"_20168":53867,"_5":13790,"_26439":53793,"_2811":53868},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3323":2109,"_29044":2075,"_20168":53870,"_5":13790,"_26439":53793,"_2811":53871},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3323":2110,"_29044":2075,"_20168":53873,"_5":13790,"_26439":53797,"_2811":53874},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3323":2111,"_29044":2075,"_20168":53876,"_5":13790,"_26439":53801,"_2811":53877},[],"Keep the root out of daily operations, or with very restricted access.",{"_3323":2112,"_29044":2075,"_20168":53879,"_5":13790,"_26439":53801,"_2811":53880},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3323":2113,"_29044":2075,"_20168":53882,"_5":13790,"_26439":53801,"_2811":53883},[],"Assign explicit profiles to every use case.",{"_3323":2114,"_29044":2075,"_20168":53885,"_5":13790,"_26439":53801,"_2811":53886},[],"Distribute the new trust before starting a rotation.",{"_3323":2115,"_29044":2075,"_20168":53888,"_5":13790,"_26439":53801,"_2811":53889},[],"Keep enough overlap to renew a disconnected fleet.",{"_3323":2116,"_29044":2075,"_20168":53891,"_5":13790,"_26439":53801,"_2811":53892},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3323":2117,"_29044":2075,"_20168":53894,"_5":13790,"_26439":53801,"_2811":53895},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3323":2118,"_29044":2118,"_5":14148,"_2811":53897,"_29388":53898,"_20168":53899,"_26439":2118},"Revocation lists (CRL)",[47299,48748,52757,53384],[],{"_3323":2119,"_29044":2118,"_20168":53901,"_5":13790,"_26439":2118,"_2811":53902},[],"Generate and distribute signed lists to validate certificates offline.",{"_3323":2120,"_29044":2118,"_5":29385,"_20168":53904,"_26439":53905,"_2811":53906},[],"/docs/pr-preview/pr-46/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_3323":2121,"_29044":2118,"_5":29385,"_20168":53908,"_26439":53909,"_2811":53910},[],"/docs/pr-preview/pr-46/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3323":2122,"_29044":2118,"_5":29385,"_20168":53912,"_26439":53913,"_2811":53914},[],"/docs/pr-preview/pr-46/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3323":2123,"_29044":2118,"_5":29385,"_20168":53916,"_26439":53917,"_2811":53918},[],"/docs/pr-preview/pr-46/platform/pki/crl#crl-contents","CRL contents",{"_3323":2124,"_29044":2118,"_5":29385,"_20168":53920,"_26439":53921,"_2811":53922},[],"/docs/pr-preview/pr-46/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3323":2125,"_29044":2118,"_5":29385,"_20168":53924,"_26439":53925,"_2811":53926},[],"/docs/pr-preview/pr-46/platform/pki/crl#va-role-management-api","VA role management API",{"_3323":2126,"_29044":2118,"_5":29385,"_20168":53928,"_26439":53929,"_2811":53930},[],"/docs/pr-preview/pr-46/platform/pki/crl#common-va-role-errors","Common VA role errors",{"_3323":2127,"_29044":2118,"_5":29385,"_20168":53932,"_26439":53933,"_2811":53934},[],"/docs/pr-preview/pr-46/platform/pki/crl#from-the-interface","From the interface",{"_3323":2128,"_29044":2118,"_5":29385,"_20168":53936,"_26439":53937,"_2811":53938},[],"/docs/pr-preview/pr-46/platform/pki/crl#references","References",{"_3323":2129,"_29044":2118,"_20168":53940,"_5":13790,"_26439":2118,"_2811":53941},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3323":2130,"_29044":2118,"_20168":53943,"_5":13790,"_26439":53905,"_2811":53944},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3323":2131,"_29044":2118,"_20168":53946,"_5":13790,"_26439":53905,"_2811":53947},[],"`crl_options` field",{"_3323":2132,"_29044":2118,"_20168":53949,"_5":13790,"_26439":53905,"_2811":47689},[],{"_3323":2133,"_29044":2118,"_20168":53951,"_5":13790,"_26439":53905,"_2811":53952},[],"Backend initial value",{"_3323":2134,"_29044":2118,"_20168":53954,"_5":13790,"_26439":53905,"_2811":53955},[],"`validity`",{"_3323":2135,"_29044":2118,"_20168":53957,"_5":13790,"_26439":53905,"_2811":53958},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3323":2136,"_29044":2118,"_20168":53960,"_5":13790,"_26439":53905,"_2811":53961},[],"7 days.",{"_3323":2137,"_29044":2118,"_20168":53963,"_5":13790,"_26439":53905,"_2811":53964},[],"`refresh_interval`",{"_3323":2138,"_29044":2118,"_20168":53966,"_5":13790,"_26439":53905,"_2811":53967},[],"Stored and returned by the API, but the VA does not use it: scheduled renewal does not depend on it (see Periodic and automatic regeneration).",{"_3323":2139,"_29044":2118,"_20168":53969,"_5":13790,"_26439":53905,"_2811":53970},[],"6 days and 23 hours.",{"_3323":2140,"_29044":2118,"_20168":53972,"_5":13790,"_26439":53905,"_2811":53973},[],"`regenerate_on_revoke`",{"_3323":2141,"_29044":2118,"_20168":53975,"_5":13790,"_26439":53905,"_2811":53976},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3323":2142,"_29044":2118,"_20168":53978,"_5":13790,"_26439":53905,"_2811":53979},[],"`true`.",{"_3323":2143,"_29044":2118,"_20168":53981,"_5":13790,"_26439":53905,"_2811":53982},[],"`signer_certificate_serial_number`",{"_3323":2144,"_29044":2118,"_20168":53984,"_5":13790,"_26439":53905,"_2811":53985},[],"Serial number of the existing certificate that signs the CRL.",{"_3323":2145,"_29044":2118,"_20168":53987,"_5":13790,"_26439":53905,"_2811":53988},[],"Serial number of the CA’s current certificate.",{"_3323":2146,"_29044":2118,"_20168":53990,"_5":13790,"_26439":53905,"_2811":53991},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3323":2147,"_29044":2118,"_20168":53993,"_5":13790,"_26439":53905,"_2811":53994},[],"When a CA is reissued, the role keeps pointing at the previous certificate. CRLs remain valid because both certificates share subject and key, but the previous certificate cannot be deleted while the role uses it. To retire it, update the role’s signer.",{"_3323":2148,"_29044":2118,"_20168":53996,"_5":13790,"_26439":53905,"_2811":53997},[],"When a CA is deleted, its VA role is kept and cannot be removed through the API. If no other CA with the same SKI remains, the role can be read but any `PUT` returns 404, and the renewal job logs a warning on every cycle because it no longer finds the CA. The API offers no way out; it can only be fixed by editing the database. If another CA with that SKI remains, the role is still editable (see CAs that share a key). Adjust validity and signer before deleting the CA.",{"_3323":2149,"_29044":2118,"_20168":53999,"_5":13790,"_26439":53905,"_2811":54000},[],"A CA whose certificate lacks `cRLSign` cannot generate its CRL or edit its role (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and set it as the signer with `PUT`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages.",{"_3323":2150,"_29044":2118,"_20168":54002,"_5":13790,"_26439":53905,"_2811":54003},[],"`PUT` always validates the signer, even when the request does not change it. If the stored signer is no longer valid, no field of the role can be modified, not even the validity, until a valid one is set.",{"_3323":2151,"_29044":2118,"_20168":54005,"_5":13790,"_26439":53905,"_2811":54006},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_3323":2152,"_29044":2118,"_20168":54008,"_5":13790,"_26439":53909,"_2811":54009},[],"The VA identifies each CRL by the CA’s SKI, and the SKI is derived from its key. Two CAs with the same key have the same SKI and share a single VA role and a single CRL. This happens when a CA is created on an existing KMS key, or when a CA is imported whose certificate declares an SKI already in use. Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. The first CA creates the role and the others keep it.",{"_3323":2153,"_29044":2118,"_20168":54011,"_5":13790,"_26439":53909,"_2811":54012},[],"The certificates of all of them point to `/crl/{ski}`, but the published list has the first CA as issuer and only includes its revocations. A verifier compares the CRL issuer with the issuer of the certificate it validates (RFC 5280, §6.3.2) and rejects the list if they differ. Depending on its policy, the certificate is blocked (*hard-fail*) or accepted even though it is revoked (*soft-fail*). Revocations of the secondary CAs do not appear in any list.",{"_3323":2154,"_29044":2118,"_20168":54014,"_5":13790,"_26439":53909,"_2811":54015},[],"If the first CA is deleted, CRL generation for the remaining one fails because the configured signer no longer matches a CA with that name. Until the role’s signer is updated to a certificate of the remaining CA, the last published list keeps being served until it expires (7 days by default).",{"_3323":2155,"_29044":2118,"_20168":54017,"_5":13790,"_26439":53909,"_2811":54018},[],"To detect the problem, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued. A CA imported with an SKI already in use does not replace the existing one as CRL issuer, because the issuer is resolved from the role’s signer. However, its own certificates point to that same URL and its revocations are not published. Until Lamassu rejects these imports, restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same collision, so also avoid reusing keys across CAs. A per-CA CRL and the rejection of imports whose SKI collides with an existing CA are both proposed in lamassuiot#834, and neither is implemented yet.",{"_3323":2156,"_29044":2118,"_20168":54020,"_5":13790,"_26439":53913,"_2811":54021},[],"The VA scheduled job checks every role on each run and requests another list when the remaining validity of `latest_crl` is less than the interval between runs. The frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. `refresh_interval` plays no part. Keep `validity` well above the interval: with a shorter validity, the list is regenerated on every cycle.",{"_3323":2157,"_29044":2118,"_20168":54023,"_5":13790,"_26439":53913,"_2811":54024},[],"If generation fails (for example, because of a role without a CA or an invalid signer), the job logs the warning `something went wrong while calculating CRL for CA <ski>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3323":2158,"_29044":2118,"_20168":54026,"_5":13790,"_26439":53913,"_2811":54027},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if it fails (missing role, invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3323":2159,"_29044":2118,"_20168":54029,"_5":13790,"_26439":53913,"_2811":54030},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3323":2160,"_29044":2118,"_20168":54032,"_5":13790,"_26439":53917,"_2811":54033},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3323":2161,"_29044":2118,"_20168":54035,"_5":13790,"_26439":53917,"_2811":54036},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3323":2162,"_29044":2118,"_20168":54038,"_5":13790,"_26439":53921,"_2811":54039},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_3323":2163,"_29044":2118,"_20168":54041,"_5":13790,"_26439":53921,"_2811":54042},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3323":2164,"_29044":2118,"_20168":54044,"_5":13790,"_26439":53921,"_2811":54045},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3323":2165,"_29044":2118,"_20168":54047,"_5":13790,"_26439":53921,"_2811":54048},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3323":2166,"_29044":2118,"_20168":54050,"_5":13790,"_26439":53921,"_2811":54051},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3323":2167,"_29044":2118,"_20168":54053,"_5":13790,"_26439":53925,"_2811":54054},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3323":2168,"_29044":2118,"_20168":54056,"_5":13790,"_26439":53925,"_2811":50515},[],{"_3323":2169,"_29044":2118,"_20168":54058,"_5":13790,"_26439":53925,"_2811":54059},[],"Relative path",{"_3323":2170,"_29044":2118,"_20168":54061,"_5":13790,"_26439":53925,"_2811":50512},[],{"_3323":2171,"_29044":2118,"_20168":54063,"_5":13790,"_26439":53925,"_2811":54064},[],"`GET`",{"_3323":2172,"_29044":2118,"_20168":54066,"_5":13790,"_26439":53925,"_2811":54067},[],"`/v1/roles/{ca-ski}`",{"_3323":2173,"_29044":2118,"_20168":54069,"_5":13790,"_26439":53925,"_2811":54070},[],"Read `crl_options` and `latest_crl`.",{"_3323":2174,"_29044":2118,"_20168":54072,"_5":13790,"_26439":53925,"_2811":54073},[],"`PUT`",{"_3323":2175,"_29044":2118,"_20168":54075,"_5":13790,"_26439":53925,"_2811":54067},[],{"_3323":2176,"_29044":2118,"_20168":54077,"_5":13790,"_26439":53925,"_2811":54078},[],"Replace CRL configuration.",{"_3323":2177,"_29044":2118,"_20168":54080,"_5":13790,"_26439":53925,"_2811":54081},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_3323":2178,"_29044":2118,"_20168":54083,"_5":13790,"_26439":53925,"_2811":54084},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_3323":2179,"_29044":2118,"_20168":54086,"_5":13790,"_26439":53929,"_2811":54087},[],"Symptom",{"_3323":2180,"_29044":2118,"_20168":54089,"_5":13790,"_26439":53929,"_2811":54090},[],"Cause",{"_3323":2181,"_29044":2118,"_20168":54092,"_5":13790,"_26439":53929,"_2811":54093},[],"Action",{"_3323":2182,"_29044":2118,"_20168":54095,"_5":13790,"_26439":53929,"_2811":54096},[],"`PUT /v1/roles/{ca-ski}` returns 404 and `GET` returns 200.",{"_3323":2183,"_29044":2118,"_20168":54098,"_5":13790,"_26439":53929,"_2811":54099},[],"The role’s CA was deleted and no other CA with the same SKI remains.",{"_3323":2184,"_29044":2118,"_20168":54101,"_5":13790,"_26439":53929,"_2811":54102},[],"There is no API way out; it requires database intervention. Avoid it by adjusting the role before deleting the CA.",{"_3323":2185,"_29044":2118,"_20168":54104,"_5":13790,"_26439":53929,"_2811":54105},[],"`PUT` returns 400.",{"_3323":2186,"_29044":2118,"_20168":54107,"_5":13790,"_26439":53929,"_2811":54108},[],"The signer lacks `cRLSign`, or its subject and key match no CA with that SKI (for example, after deleting the first of two CAs that share a key).",{"_3323":2187,"_29044":2118,"_20168":54110,"_5":13790,"_26439":53929,"_2811":54111},[],"Use `PUT` to set the serial number of a valid certificate of the remaining CA.",{"_3323":2188,"_29044":2118,"_20168":54113,"_5":13790,"_26439":53929,"_2811":54114},[],"`PUT` returns 400 from a 3.x client.",{"_3323":2189,"_29044":2118,"_20168":54116,"_5":13790,"_26439":53929,"_2811":54117},[],"`crl_options.subject_key_id_signer` was replaced by `signer_certificate_serial_number`, which is required.",{"_3323":2190,"_29044":2118,"_20168":54119,"_5":13790,"_26439":53929,"_2811":54120},[],"Update the client to send the new field.",{"_3323":2191,"_29044":2118,"_20168":54122,"_5":13790,"_26439":53929,"_2811":54123},[],"The CRL does not change after revoking a certificate.",{"_3323":2192,"_29044":2118,"_20168":54125,"_5":13790,"_26439":53929,"_2811":54126},[],"`regenerate_on_revoke` is `false`, or the event failed because of a missing role or an invalid signer.",{"_3323":2193,"_29044":2118,"_20168":54128,"_5":13790,"_26439":53929,"_2811":54129},[],"Check the VA logs and the failed-events queue; fix the signer.",{"_3323":2194,"_29044":2118,"_20168":54131,"_5":13790,"_26439":53929,"_2811":54132},[],"A verifier rejects the CRL because of the issuer.",{"_3323":2195,"_29044":2118,"_20168":54134,"_5":13790,"_26439":53929,"_2811":54135},[],"Several CAs share an SKI.",{"_3323":2196,"_29044":2118,"_20168":54137,"_5":13790,"_26439":53929,"_2811":54138},[],"See CAs that share a key.",{"_3323":2197,"_29044":2118,"_20168":54140,"_5":13790,"_26439":53933,"_2811":54141},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_3323":2198,"_29044":2118,"_20168":54143,"_5":13790,"_26439":53937,"_2811":54144},[],"RFC 5280: X.509 and CRL profile.",{"_3323":2199,"_29044":2118,"_20168":54146,"_5":13790,"_26439":53937,"_2811":54147},[],"OpenSSL: openssl-crl.",{"_3323":2200,"_29044":2118,"_20168":54149,"_5":13790,"_26439":53937,"_2811":54150},[],"OpenSSL: openssl-verify.",{"_3323":2201,"_29044":2118,"_20168":54152,"_5":13790,"_26439":53937,"_2811":54153},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3323":2202,"_29044":2118,"_20168":54155,"_5":13790,"_26439":53937,"_2811":54156},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3323":2203,"_29044":2203,"_5":14148,"_2811":54158,"_29388":54159,"_20168":54160,"_26439":2203},"Keys and cryptographic engines",[47299,48748,52757,52758],[],{"_3323":2204,"_29044":2203,"_20168":54162,"_5":13790,"_26439":2203,"_2811":54163},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3323":2205,"_29044":2203,"_5":29385,"_20168":54165,"_26439":54166,"_2811":54167},[],"/docs/pr-preview/pr-46/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3323":2206,"_29044":2203,"_5":29385,"_20168":54169,"_26439":54170,"_2811":54171},[],"/docs/pr-preview/pr-46/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3323":2207,"_29044":2203,"_5":29385,"_20168":54173,"_26439":54174,"_2811":54175},[],"/docs/pr-preview/pr-46/platform/pki/key-management#file-system","File System",{"_3323":2208,"_29044":2203,"_5":29385,"_20168":54177,"_26439":54178,"_2811":54179},[],"/docs/pr-preview/pr-46/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3323":2209,"_29044":2203,"_5":29385,"_20168":54181,"_26439":54182,"_2811":54183},[],"/docs/pr-preview/pr-46/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3323":2210,"_29044":2203,"_5":29385,"_20168":54185,"_26439":54186,"_2811":54187},[],"/docs/pr-preview/pr-46/platform/pki/key-management#aws-kms","AWS KMS",{"_3323":2211,"_29044":2203,"_5":29385,"_20168":54189,"_26439":54190,"_2811":54191},[],"/docs/pr-preview/pr-46/platform/pki/key-management#pkcs11","PKCS#11",{"_3323":2212,"_29044":2203,"_5":29385,"_20168":54193,"_26439":54194,"_2811":54195},[],"/docs/pr-preview/pr-46/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3323":2213,"_29044":2203,"_5":29385,"_20168":54197,"_26439":54198,"_2811":54199},[],"/docs/pr-preview/pr-46/platform/pki/key-management#key-inventory","Key inventory",{"_3323":2214,"_29044":2203,"_5":29385,"_20168":54201,"_26439":54202,"_2811":54203},[],"/docs/pr-preview/pr-46/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3323":2215,"_29044":2203,"_5":29385,"_20168":54205,"_26439":54206,"_2811":54207},[],"/docs/pr-preview/pr-46/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3323":2216,"_29044":2203,"_5":29385,"_20168":54209,"_26439":54210,"_2811":54211},[],"/docs/pr-preview/pr-46/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3323":2217,"_29044":2203,"_5":29385,"_20168":54213,"_26439":54214,"_2811":54215},[],"/docs/pr-preview/pr-46/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3323":2218,"_29044":2203,"_5":29385,"_20168":54217,"_26439":54218,"_2811":54219},[],"/docs/pr-preview/pr-46/platform/pki/key-management#view-details","View details",{"_3323":2219,"_29044":2203,"_5":29385,"_20168":54221,"_26439":54222,"_2811":54223},[],"/docs/pr-preview/pr-46/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3323":2220,"_29044":2203,"_5":29385,"_20168":54225,"_26439":54226,"_2811":54227},[],"/docs/pr-preview/pr-46/platform/pki/key-management#sign","Sign",{"_3323":2221,"_29044":2203,"_5":29385,"_20168":54229,"_26439":54230,"_2811":54231},[],"/docs/pr-preview/pr-46/platform/pki/key-management#verify","Verify",{"_3323":2222,"_29044":2203,"_5":29385,"_20168":54233,"_26439":54234,"_2811":54235},[],"/docs/pr-preview/pr-46/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3323":2223,"_29044":2203,"_5":29385,"_20168":54237,"_26439":54238,"_2811":54239},[],"/docs/pr-preview/pr-46/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3323":2224,"_29044":2203,"_5":29385,"_20168":54241,"_26439":54242,"_2811":54243},[],"/docs/pr-preview/pr-46/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3323":2225,"_29044":2203,"_20168":54245,"_5":13790,"_26439":2203,"_2811":54246},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3323":2226,"_29044":2203,"_20168":54248,"_5":13790,"_26439":2203,"_2811":54249},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3323":2227,"_29044":2203,"_20168":54251,"_5":13790,"_26439":54166,"_2811":54252},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3323":2228,"_29044":2203,"_20168":54254,"_5":13790,"_26439":54166,"_2811":54255},[],"In practice, it lets you:",{"_3323":2229,"_29044":2203,"_20168":54257,"_5":13790,"_26439":54166,"_2811":54258},[],"Generate new key pairs from Lamassu IoT.",{"_3323":2230,"_29044":2203,"_20168":54260,"_5":13790,"_26439":54166,"_2811":54261},[],"Import keys created externally.",{"_3323":2231,"_29044":2203,"_20168":54263,"_5":13790,"_26439":54166,"_2811":54264},[],"Delegate custody and cryptographic operations to external engines.",{"_3323":2232,"_29044":2203,"_20168":54266,"_5":13790,"_26439":54166,"_2811":54267},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3323":2233,"_29044":2203,"_20168":54269,"_5":13790,"_26439":54170,"_2811":54270},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3323":2234,"_29044":2203,"_20168":54272,"_5":13790,"_26439":54170,"_2811":54273},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3323":2235,"_29044":2203,"_20168":54275,"_5":13790,"_26439":54170,"_2811":54276},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3323":2236,"_29044":2203,"_20168":54278,"_5":13790,"_26439":54174,"_2811":54279},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3323":2237,"_29044":2203,"_20168":54281,"_5":13790,"_26439":54178,"_2811":54282},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3323":2238,"_29044":2203,"_20168":54284,"_5":13790,"_26439":54178,"_2811":54285},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3323":2239,"_29044":2203,"_20168":54287,"_5":13790,"_26439":54182,"_2811":54288},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3323":2240,"_29044":2203,"_20168":54290,"_5":13790,"_26439":54186,"_2811":54291},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3323":2241,"_29044":2203,"_20168":54293,"_5":13790,"_26439":54190,"_2811":54294},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3323":2242,"_29044":2203,"_20168":54296,"_5":13790,"_26439":54194,"_2811":54297},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3323":2243,"_29044":2203,"_20168":54299,"_5":13790,"_26439":54194,"_2811":54300},[],"Lamassu shows the enabled engines in the console.",{"_3323":2244,"_29044":2203,"_20168":54302,"_5":13790,"_26439":54194,"_2811":54303},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3323":2245,"_29044":2203,"_20168":54305,"_5":13790,"_26439":54194,"_2811":54306},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3323":2246,"_29044":2203,"_20168":54308,"_5":13790,"_26439":54198,"_2811":54309},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3323":2247,"_29044":2203,"_20168":54311,"_5":13790,"_26439":54198,"_2811":54312},[],"The table includes the following fields:",{"_3323":2248,"_29044":2203,"_20168":54314,"_5":13790,"_26439":54198,"_2811":54315},[],"**Name**: descriptive name of the key.",{"_3323":2249,"_29044":2203,"_20168":54317,"_5":13790,"_26439":54198,"_2811":54318},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3323":2250,"_29044":2203,"_20168":54320,"_5":13790,"_26439":54198,"_2811":54321},[],"**Strength**: visual indicator of cryptographic strength.",{"_3323":2251,"_29044":2203,"_20168":54323,"_5":13790,"_26439":54198,"_2811":54324},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3323":2252,"_29044":2203,"_20168":54326,"_5":13790,"_26439":54198,"_2811":54327},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3323":2253,"_29044":2203,"_20168":54329,"_5":13790,"_26439":54198,"_2811":54330},[],"**Aliases**: alternative names associated with the key.",{"_3323":2254,"_29044":2203,"_20168":54332,"_5":13790,"_26439":54198,"_2811":54333},[],"**Tags**: labels for classification and search.",{"_3323":2255,"_29044":2203,"_20168":54335,"_5":13790,"_26439":54198,"_2811":54336},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3323":2256,"_29044":2203,"_20168":54338,"_5":13790,"_26439":54198,"_2811":54339},[],"From this view you also reach the most common actions:",{"_3323":2257,"_29044":2203,"_20168":54341,"_5":13790,"_26439":54198,"_2811":54342},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3323":2258,"_29044":2203,"_20168":54344,"_5":13790,"_26439":54198,"_2811":54345},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3323":2259,"_29044":2203,"_20168":54347,"_5":13790,"_26439":54198,"_2811":54348},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3323":2260,"_29044":2203,"_20168":54350,"_5":13790,"_26439":54198,"_2811":54351},[],"**Delete Key** to remove the key from the system.",{"_3323":2261,"_29044":2203,"_20168":54353,"_5":13790,"_26439":54202,"_2811":54354},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3323":2262,"_29044":2203,"_20168":54356,"_5":13790,"_26439":54206,"_2811":54357},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3323":2263,"_29044":2203,"_20168":54359,"_5":13790,"_26439":54206,"_2811":54360},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3323":2264,"_29044":2203,"_20168":54362,"_5":13790,"_26439":54206,"_2811":54363},[],"**Key Name**: unique and descriptive name.",{"_3323":2265,"_29044":2203,"_20168":54365,"_5":13790,"_26439":54206,"_2811":54366},[],"**Crypto Engine**: engine that will keep the key.",{"_3323":2266,"_29044":2203,"_20168":54368,"_5":13790,"_26439":54206,"_2811":54369},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3323":2267,"_29044":2203,"_20168":54371,"_5":13790,"_26439":54206,"_2811":54372},[],"**Tags**: metadata to classify the key.",{"_3323":2268,"_29044":2203,"_20168":54374,"_5":13790,"_26439":54206,"_2811":54375},[],"**Metadata**: additional information for advanced uses.",{"_3323":2269,"_29044":2203,"_20168":54377,"_5":13790,"_26439":54210,"_2811":54378},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3323":2270,"_29044":2203,"_20168":54380,"_5":13790,"_26439":54210,"_2811":54381},[],"When you have an exportable private key and the destination engine supports import.",{"_3323":2271,"_29044":2203,"_20168":54383,"_5":13790,"_26439":54210,"_2811":54384},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3323":2272,"_29044":2203,"_20168":54386,"_5":13790,"_26439":54210,"_2811":54387},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3323":2273,"_29044":2203,"_20168":54389,"_5":13790,"_26439":54210,"_2811":54390},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3323":2274,"_29044":2203,"_20168":54392,"_5":13790,"_26439":54210,"_2811":54393},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3323":2275,"_29044":2203,"_20168":54395,"_5":13790,"_26439":54210,"_2811":54396},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3323":2276,"_29044":2203,"_20168":54398,"_5":13790,"_26439":54210,"_2811":54399},[],"**Tags**: labels for organization and search.",{"_3323":2277,"_29044":2203,"_20168":54401,"_5":13790,"_26439":54210,"_2811":54402},[],"**Metadata**: additional optional information.",{"_3323":2278,"_29044":2203,"_20168":54404,"_5":13790,"_26439":54210,"_2811":54405},[],"**Private Key (PEM)**: private key in PEM format.",{"_3323":2279,"_29044":2203,"_20168":54407,"_5":13790,"_26439":54210,"_2811":54408},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3323":2280,"_29044":2203,"_20168":54410,"_5":13790,"_26439":54214,"_2811":54411},[],"Each registered key has a detail view and several operational actions.",{"_3323":2281,"_29044":2203,"_20168":54413,"_5":13790,"_26439":54218,"_2811":54414},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3323":2282,"_29044":2203,"_20168":54416,"_5":13790,"_26439":54218,"_2811":54417},[],"The **Overview** tab shows, among others, these fields:",{"_3323":2283,"_29044":2203,"_20168":54419,"_5":13790,"_26439":54218,"_2811":54420},[],"**Key Name**: descriptive name.",{"_3323":2284,"_29044":2203,"_20168":54422,"_5":13790,"_26439":54218,"_2811":54423},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3323":2285,"_29044":2203,"_20168":54425,"_5":13790,"_26439":54218,"_2811":54426},[],"**Tags**: associated labels.",{"_3323":2286,"_29044":2203,"_20168":54428,"_5":13790,"_26439":54218,"_2811":54429},[],"**Aliases**: alternative names.",{"_3323":2287,"_29044":2203,"_20168":54431,"_5":13790,"_26439":54218,"_2811":54432},[],"**Crypto Engine**: engine where the key resides.",{"_3323":2288,"_29044":2203,"_20168":54434,"_5":13790,"_26439":54218,"_2811":54435},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3323":2289,"_29044":2203,"_20168":54437,"_5":13790,"_26439":54218,"_2811":54438},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3323":2290,"_29044":2203,"_20168":54440,"_5":13790,"_26439":54218,"_2811":54441},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3323":2291,"_29044":2203,"_20168":54443,"_5":13790,"_26439":54222,"_2811":54444},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3323":2292,"_29044":2203,"_20168":54446,"_5":13790,"_26439":54222,"_2811":54447},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3323":2293,"_29044":2203,"_20168":54449,"_5":13790,"_26439":54222,"_2811":54450},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3323":2294,"_29044":2203,"_20168":54452,"_5":13790,"_26439":54226,"_2811":54453},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3323":2295,"_29044":2203,"_20168":54455,"_5":13790,"_26439":54226,"_2811":54456},[],"Main fields:",{"_3323":2296,"_29044":2203,"_20168":54458,"_5":13790,"_26439":54226,"_2811":54459},[],"**Algorithm**: signing algorithm available for the key type.",{"_3323":2297,"_29044":2203,"_20168":54461,"_5":13790,"_26439":54226,"_2811":54462},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3323":2298,"_29044":2203,"_20168":54464,"_5":13790,"_26439":54226,"_2811":54465},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3323":2299,"_29044":2203,"_20168":54467,"_5":13790,"_26439":54226,"_2811":54468},[],"**Message**: content to sign.",{"_3323":2300,"_29044":2203,"_20168":54470,"_5":13790,"_26439":54226,"_2811":54471},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3323":2301,"_29044":2203,"_20168":54473,"_5":13790,"_26439":54230,"_2811":54474},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3323":2302,"_29044":2203,"_20168":54476,"_5":13790,"_26439":54230,"_2811":54456},[],{"_3323":2303,"_29044":2203,"_20168":54478,"_5":13790,"_26439":54230,"_2811":54479},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3323":2304,"_29044":2203,"_20168":54481,"_5":13790,"_26439":54230,"_2811":54482},[],"**Message Type**: `Raw` or `Digest`.",{"_3323":2305,"_29044":2203,"_20168":54484,"_5":13790,"_26439":54230,"_2811":54485},[],"**Payload Encoding**: encoding of the message.",{"_3323":2306,"_29044":2203,"_20168":54487,"_5":13790,"_26439":54230,"_2811":54488},[],"**Message**: original message or hash.",{"_3323":2307,"_29044":2203,"_20168":54490,"_5":13790,"_26439":54230,"_2811":54491},[],"**Signature**: signature to check.",{"_3323":2308,"_29044":2203,"_20168":54493,"_5":13790,"_26439":54230,"_2811":54494},[],"**Result**: indicator of the validation result.",{"_3323":2309,"_29044":2203,"_20168":54496,"_5":13790,"_26439":54234,"_2811":54497},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3323":2310,"_29044":2203,"_20168":54499,"_5":13790,"_26439":54234,"_2811":54500},[],"This flow is useful for:",{"_3323":2311,"_29044":2203,"_20168":54502,"_5":13790,"_26439":54234,"_2811":54503},[],"Requesting certificates from an external CA.",{"_3323":2312,"_29044":2203,"_20168":54505,"_5":13790,"_26439":54234,"_2811":54506},[],"Renewing an identity while keeping the same key.",{"_3323":2313,"_29044":2203,"_20168":54508,"_5":13790,"_26439":54234,"_2811":54509},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3323":2314,"_29044":2203,"_20168":54511,"_5":13790,"_26439":54234,"_2811":54512},[],"**Common Name (CN)**: main name of the identity.",{"_3323":2315,"_29044":2203,"_20168":54514,"_5":13790,"_26439":54234,"_2811":54515},[],"**Organization (O)**: organization or company.",{"_3323":2316,"_29044":2203,"_20168":54517,"_5":13790,"_26439":54234,"_2811":54518},[],"**Organizational Unit (OU)**: department or unit.",{"_3323":2317,"_29044":2203,"_20168":54520,"_5":13790,"_26439":54234,"_2811":54521},[],"**Country (C)**: two-letter country code.",{"_3323":2318,"_29044":2203,"_20168":54523,"_5":13790,"_26439":54234,"_2811":54524},[],"**State / Province (ST)**: state or province.",{"_3323":2319,"_29044":2203,"_20168":54526,"_5":13790,"_26439":54234,"_2811":54527},[],"**Locality (L)**: city or locality.",{"_3323":2320,"_29044":2203,"_20168":54529,"_5":13790,"_26439":54234,"_2811":54530},[],"**Email Address**: contact email.",{"_3323":2321,"_29044":2203,"_20168":54532,"_5":13790,"_26439":54234,"_2811":54533},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3323":2322,"_29044":2203,"_20168":54535,"_5":13790,"_26439":54234,"_2811":54536},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3323":2323,"_29044":2203,"_20168":54538,"_5":13790,"_26439":54238,"_2811":54539},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3323":2324,"_29044":2203,"_20168":54541,"_5":13790,"_26439":54238,"_2811":54542},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3323":2325,"_29044":2203,"_20168":54544,"_5":13790,"_26439":54242,"_2811":54545},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3323":2326,"_29044":2326,"_5":14148,"_2811":54547,"_29388":54548,"_20168":54549,"_26439":2326},"Online validation with OCSP",[47299,48748,52757,53384],[],{"_3323":2327,"_29044":2326,"_20168":54551,"_5":13790,"_26439":2326,"_2811":54552},[],"Query signed status and verify the responder’s response.",{"_3323":2328,"_29044":2326,"_5":29385,"_20168":54554,"_26439":54555,"_2811":54556},[],"/docs/pr-preview/pr-46/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3323":2329,"_29044":2326,"_5":29385,"_20168":54558,"_26439":54559,"_2811":54560},[],"/docs/pr-preview/pr-46/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3323":2330,"_29044":2326,"_5":29385,"_20168":54562,"_26439":54563,"_2811":54564},[],"/docs/pr-preview/pr-46/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3323":2331,"_29044":2326,"_5":29385,"_20168":54566,"_26439":54567,"_2811":54568},[],"/docs/pr-preview/pr-46/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3323":2332,"_29044":2326,"_5":29385,"_20168":54570,"_26439":54571,"_2811":54572},[],"/docs/pr-preview/pr-46/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3323":2333,"_29044":2326,"_5":29385,"_20168":54574,"_26439":54575,"_2811":53938},[],"/docs/pr-preview/pr-46/platform/pki/ocsp#references",{"_3323":2334,"_29044":2326,"_20168":54577,"_5":13790,"_26439":2326,"_2811":54578},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3323":2335,"_29044":2326,"_20168":54580,"_5":13790,"_26439":54555,"_2811":54581},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3323":2336,"_29044":2326,"_20168":54583,"_5":13790,"_26439":54555,"_2811":54584},[],"Record status",{"_3323":2337,"_29044":2326,"_20168":54586,"_5":13790,"_26439":54555,"_2811":54587},[],"Signed response",{"_3323":2338,"_29044":2326,"_20168":54589,"_5":13790,"_26439":54555,"_2811":51928},[],{"_3323":2339,"_29044":2326,"_20168":54591,"_5":13790,"_26439":54555,"_2811":54592},[],"`Good`.",{"_3323":2340,"_29044":2326,"_20168":54594,"_5":13790,"_26439":54555,"_2811":51945},[],{"_3323":2341,"_29044":2326,"_20168":54596,"_5":13790,"_26439":54555,"_2811":54597},[],"`Revoked`, with revocation reason and timestamp.",{"_3323":2342,"_29044":2326,"_20168":54599,"_5":13790,"_26439":54555,"_2811":54600},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3323":2343,"_29044":2326,"_20168":54602,"_5":13790,"_26439":54555,"_2811":54603},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3323":2344,"_29044":2326,"_20168":54605,"_5":13790,"_26439":54555,"_2811":54606},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3323":2345,"_29044":2326,"_20168":54608,"_5":13790,"_26439":54555,"_2811":54609},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3323":2346,"_29044":2326,"_20168":54611,"_5":13790,"_26439":54555,"_2811":54612},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3323":2347,"_29044":2326,"_20168":54614,"_5":13790,"_26439":54559,"_2811":54615},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3323":2348,"_29044":2326,"_20168":54617,"_5":13790,"_26439":54559,"_2811":54618},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3323":2349,"_29044":2326,"_20168":54620,"_5":13790,"_26439":54563,"_2811":54621},[],"The service accepts:",{"_3323":2350,"_29044":2326,"_20168":54623,"_5":13790,"_26439":54563,"_2811":50515},[],{"_3323":2351,"_29044":2326,"_20168":54625,"_5":13790,"_26439":54563,"_2811":54626},[],"VA service path",{"_3323":2352,"_29044":2326,"_20168":54628,"_5":13790,"_26439":54563,"_2811":54629},[],"Format",{"_3323":2353,"_29044":2326,"_20168":54631,"_5":13790,"_26439":54563,"_2811":54632},[],"`POST`",{"_3323":2354,"_29044":2326,"_20168":54634,"_5":13790,"_26439":54563,"_2811":54635},[],"`/ocsp`",{"_3323":2355,"_29044":2326,"_20168":54637,"_5":13790,"_26439":54563,"_2811":54638},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3323":2356,"_29044":2326,"_20168":54640,"_5":13790,"_26439":54563,"_2811":54064},[],{"_3323":2357,"_29044":2326,"_20168":54642,"_5":13790,"_26439":54563,"_2811":54643},[],"`/ocsp/{ocsp_request}`",{"_3323":2358,"_29044":2326,"_20168":54645,"_5":13790,"_26439":54563,"_2811":54646},[],"DER request encoded using padded URL Base64.",{"_3323":2359,"_29044":2326,"_20168":54648,"_5":13790,"_26439":54563,"_2811":54649},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3323":2360,"_29044":2326,"_20168":54651,"_5":13790,"_26439":54567,"_2811":54652},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3323":2361,"_29044":2326,"_20168":54654,"_5":13790,"_26439":54567,"_2811":54655},[],"Generate the request:",{"_3323":2362,"_29044":2326,"_20168":54657,"_5":13790,"_26439":54567,"_2811":54658},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3323":2363,"_29044":2326,"_20168":54660,"_5":13790,"_26439":54567,"_2811":54661},[],"Replace the example URL with the inspected endpoint:",{"_3323":2364,"_29044":2326,"_20168":54663,"_5":13790,"_26439":54567,"_2811":54664},[],"Verify the returned DER:",{"_3323":2365,"_29044":2326,"_20168":54666,"_5":13790,"_26439":54567,"_2811":54667},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3323":2366,"_29044":2326,"_20168":54669,"_5":13790,"_26439":54571,"_2811":54670},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3323":2367,"_29044":2326,"_20168":54672,"_5":13790,"_26439":54571,"_2811":54673},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3323":2368,"_29044":2326,"_20168":54675,"_5":13790,"_26439":54575,"_2811":54676},[],"RFC 6960: OCSP.",{"_3323":2369,"_29044":2326,"_20168":54678,"_5":13790,"_26439":54575,"_2811":54679},[],"OpenSSL: openssl-ocsp.",{"_3323":2370,"_29044":2326,"_20168":54681,"_5":13790,"_26439":54575,"_2811":54682},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3323":2371,"_29044":2326,"_20168":54684,"_5":13790,"_26439":54575,"_2811":54156},[],{"_3323":2372,"_29044":2372,"_5":14148,"_2811":52757,"_29388":54686,"_20168":54687,"_26439":2372},[47299,48748,52757],[],{"_3323":2373,"_29044":2372,"_20168":54689,"_5":13790,"_26439":2372,"_2811":54690},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3323":2374,"_29044":2372,"_5":29385,"_20168":54692,"_26439":54693,"_2811":52069},[],"/docs/pr-preview/pr-46/platform/pki/overview#start-here",{"_3323":2375,"_29044":2372,"_5":29385,"_20168":54695,"_26439":54696,"_2811":54697},[],"/docs/pr-preview/pr-46/platform/pki/overview#what-you-need","What you need",{"_3323":2376,"_29044":2372,"_5":29385,"_20168":54699,"_26439":54700,"_2811":52601},[],"/docs/pr-preview/pr-46/platform/pki/overview#core-capabilities",{"_3323":2377,"_29044":2372,"_5":29385,"_20168":54702,"_26439":54703,"_2811":52605},[],"/docs/pr-preview/pr-46/platform/pki/overview#build-your-trust-hierarchy",{"_3323":2378,"_29044":2372,"_5":29385,"_20168":54705,"_26439":54706,"_2811":52609},[],"/docs/pr-preview/pr-46/platform/pki/overview#protect-cryptographic-keys",{"_3323":2379,"_29044":2372,"_5":29385,"_20168":54708,"_26439":54709,"_2811":52613},[],"/docs/pr-preview/pr-46/platform/pki/overview#issue-and-control-certificates",{"_3323":2380,"_29044":2372,"_5":29385,"_20168":54711,"_26439":54712,"_2811":52621},[],"/docs/pr-preview/pr-46/platform/pki/overview#publish-validation-status",{"_3323":2381,"_29044":2372,"_5":29385,"_20168":54714,"_26439":54715,"_2811":54716},[],"/docs/pr-preview/pr-46/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3323":2382,"_29044":2372,"_5":29385,"_20168":54718,"_26439":54719,"_2811":53551},[],"/docs/pr-preview/pr-46/platform/pki/overview#continue",{"_3323":2383,"_29044":2372,"_20168":54721,"_5":13790,"_26439":2372,"_2811":54722},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3323":2384,"_29044":2372,"_20168":54724,"_5":13790,"_26439":54693,"_2811":54725},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3323":2385,"_29044":2372,"_20168":54727,"_5":13790,"_26439":54693,"_2811":54728},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3323":2386,"_29044":2372,"_20168":54730,"_5":13790,"_26439":54696,"_2811":54731},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3323":2387,"_29044":2372,"_20168":54733,"_5":13790,"_26439":54696,"_2811":54734},[],"An available cryptographic engine to keep the authority's key.",{"_3323":2388,"_29044":2372,"_20168":54736,"_5":13790,"_26439":54696,"_2811":54737},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3323":2389,"_29044":2372,"_20168":54739,"_5":13790,"_26439":54696,"_2811":54740},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3323":2390,"_29044":2372,"_20168":54742,"_5":13790,"_26439":54696,"_2811":54743},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3323":2391,"_29044":2372,"_20168":54745,"_5":13790,"_26439":54703,"_2811":54746},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3323":2392,"_29044":2372,"_20168":54748,"_5":13790,"_26439":54706,"_2811":54749},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3323":2393,"_29044":2372,"_20168":54751,"_5":13790,"_26439":54709,"_2811":54752},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3323":2394,"_29044":2372,"_20168":54754,"_5":13790,"_26439":54712,"_2811":54755},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3323":2395,"_29044":2372,"_20168":54757,"_5":13790,"_26439":54715,"_2811":54758},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3323":2396,"_29044":2372,"_20168":54760,"_5":13790,"_26439":54715,"_2811":54761},[],"its subject and extensions identify the expected client;",{"_3323":2397,"_29044":2372,"_20168":54763,"_5":13790,"_26439":54715,"_2811":54764},[],"its public key matches the client's private key;",{"_3323":2398,"_29044":2372,"_20168":54766,"_5":13790,"_26439":54715,"_2811":54767},[],"its chain reaches a root trusted by the consumer;",{"_3323":2399,"_29044":2372,"_20168":54769,"_5":13790,"_26439":54715,"_2811":54770},[],"its dates and usages allow the operation;",{"_3323":2400,"_29044":2372,"_20168":54772,"_5":13790,"_26439":54715,"_2811":54773},[],"the consumer applies revocation checks and authorization.",{"_3323":2401,"_29044":2372,"_20168":54775,"_5":13790,"_26439":54715,"_2811":54776},[],"The issuance path includes the first independent checks.",{"_3323":2402,"_29044":2372,"_20168":54778,"_5":13790,"_26439":54719,"_2811":54779},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3323":2403,"_29044":2372,"_20168":54781,"_5":13790,"_26439":54719,"_2811":54782},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3323":2404,"_29044":2372,"_20168":54784,"_5":13790,"_26439":54719,"_2811":54785},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3323":2405,"_29044":2405,"_5":14148,"_2811":54787,"_29388":54788,"_20168":54789,"_26439":2405},"Create your first CA",[47299,48748,52757,52194],[],{"_3323":2406,"_29044":2405,"_20168":54791,"_5":13790,"_26439":2405,"_2811":54792},[],"Create an evaluation root and check its certificate before issuing.",{"_3323":2407,"_29044":2405,"_5":29385,"_20168":54794,"_26439":54795,"_2811":47309},[],"/docs/pr-preview/pr-46/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3323":2408,"_29044":2405,"_5":29385,"_20168":54797,"_26439":54798,"_2811":54799},[],"/docs/pr-preview/pr-46/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3323":2409,"_29044":2405,"_5":29385,"_20168":54801,"_26439":54802,"_2811":54803},[],"/docs/pr-preview/pr-46/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3323":2410,"_29044":2405,"_5":29385,"_20168":54805,"_26439":54806,"_2811":54807},[],"/docs/pr-preview/pr-46/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3323":2411,"_29044":2405,"_5":29385,"_20168":54809,"_26439":54810,"_2811":54811},[],"/docs/pr-preview/pr-46/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3323":2412,"_29044":2405,"_5":29385,"_20168":54813,"_26439":54814,"_2811":54815},[],"/docs/pr-preview/pr-46/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3323":2413,"_29044":2405,"_5":29385,"_20168":54817,"_26439":54818,"_2811":54819},[],"/docs/pr-preview/pr-46/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3323":2414,"_29044":2405,"_5":29385,"_20168":54821,"_26439":54822,"_2811":52451},[],"/docs/pr-preview/pr-46/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3323":2415,"_29044":2405,"_5":29385,"_20168":54824,"_26439":54825,"_2811":47333},[],"/docs/pr-preview/pr-46/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3323":2416,"_29044":2405,"_20168":54827,"_5":13790,"_26439":2405,"_2811":54828},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3323":2417,"_29044":2405,"_20168":54830,"_5":13790,"_26439":54795,"_2811":54831},[],"Console access and permission to create keys and authorities.",{"_3323":2418,"_29044":2405,"_20168":54833,"_5":13790,"_26439":54795,"_2811":54834},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3323":2419,"_29044":2405,"_20168":54836,"_5":13790,"_26439":54795,"_2811":54837},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3323":2420,"_29044":2405,"_20168":54839,"_5":13790,"_26439":54795,"_2811":54840},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3323":2421,"_29044":2405,"_20168":54842,"_5":13790,"_26439":54798,"_2811":54843},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3323":2422,"_29044":2405,"_20168":54845,"_5":13790,"_26439":54798,"_2811":54846},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3323":2423,"_29044":2405,"_20168":54848,"_5":13790,"_26439":54802,"_2811":54849},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3323":2424,"_29044":2405,"_20168":54851,"_5":13790,"_26439":54802,"_2811":54852},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3323":2425,"_29044":2405,"_20168":54854,"_5":13790,"_26439":54806,"_2811":54855},[],"Select **Root CA** and complete:",{"_3323":2426,"_29044":2405,"_20168":54857,"_5":13790,"_26439":54806,"_2811":54858},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3323":2427,"_29044":2405,"_20168":54860,"_5":13790,"_26439":54806,"_2811":54861},[],"**Subject**: organization and country details for your evaluation.",{"_3323":2428,"_29044":2405,"_20168":54863,"_5":13790,"_26439":54806,"_2811":54864},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3323":2429,"_29044":2405,"_20168":54866,"_5":13790,"_26439":54806,"_2811":54867},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3323":2430,"_29044":2405,"_20168":54869,"_5":13790,"_26439":54806,"_2811":54870},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3323":2431,"_29044":2405,"_20168":54872,"_5":13790,"_26439":54810,"_2811":54873},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3323":2432,"_29044":2405,"_20168":54875,"_5":13790,"_26439":54814,"_2811":54876},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3323":2433,"_29044":2405,"_20168":54878,"_5":13790,"_26439":54814,"_2811":54879},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3323":2434,"_29044":2405,"_20168":54881,"_5":13790,"_26439":54818,"_2811":54882},[],"Run from the directory where you saved `ca.pem`:",{"_3323":2435,"_29044":2405,"_20168":54884,"_5":13790,"_26439":54818,"_2811":54885},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3323":2436,"_29044":2405,"_20168":54887,"_5":13790,"_26439":54818,"_2811":54888},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3323":2437,"_29044":2405,"_20168":54890,"_5":13790,"_26439":54822,"_2811":54891},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3323":2438,"_29044":2405,"_20168":54893,"_5":13790,"_26439":54822,"_2811":54894},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3323":2439,"_29044":2405,"_20168":54896,"_5":13790,"_26439":54822,"_2811":54897},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3323":2440,"_29044":2405,"_20168":54899,"_5":13790,"_26439":54822,"_2811":54900},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3323":2441,"_29044":2405,"_20168":54902,"_5":13790,"_26439":54825,"_2811":54903},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3323":2442,"_29044":2442,"_5":14148,"_2811":54905,"_29388":54906,"_20168":54907,"_26439":2442},"Issue and verify a certificate",[47299,48748,52757,52194],[],{"_3323":2443,"_29044":2442,"_20168":54909,"_5":13790,"_26439":2442,"_2811":54910},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3323":2444,"_29044":2442,"_5":29385,"_20168":54912,"_26439":54913,"_2811":47309},[],"/docs/pr-preview/pr-46/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3323":2445,"_29044":2442,"_5":29385,"_20168":54915,"_26439":54916,"_2811":54917},[],"/docs/pr-preview/pr-46/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3323":2446,"_29044":2442,"_5":29385,"_20168":54919,"_26439":54920,"_2811":54921},[],"/docs/pr-preview/pr-46/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3323":2447,"_29044":2442,"_5":29385,"_20168":54923,"_26439":54924,"_2811":54925},[],"/docs/pr-preview/pr-46/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3323":2448,"_29044":2442,"_5":29385,"_20168":54927,"_26439":54928,"_2811":54929},[],"/docs/pr-preview/pr-46/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3323":2449,"_29044":2442,"_5":29385,"_20168":54931,"_26439":54932,"_2811":54933},[],"/docs/pr-preview/pr-46/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3323":2450,"_29044":2442,"_5":29385,"_20168":54935,"_26439":54936,"_2811":54937},[],"/docs/pr-preview/pr-46/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3323":2451,"_29044":2442,"_5":29385,"_20168":54939,"_26439":54940,"_2811":54941},[],"/docs/pr-preview/pr-46/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3323":2452,"_29044":2442,"_5":29385,"_20168":54943,"_26439":54944,"_2811":54945},[],"/docs/pr-preview/pr-46/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3323":2453,"_29044":2442,"_5":29385,"_20168":54947,"_26439":54948,"_2811":54949},[],"/docs/pr-preview/pr-46/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3323":2454,"_29044":2442,"_5":29385,"_20168":54951,"_26439":54952,"_2811":52451},[],"/docs/pr-preview/pr-46/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3323":2455,"_29044":2442,"_5":29385,"_20168":54954,"_26439":54955,"_2811":47333},[],"/docs/pr-preview/pr-46/platform/pki/quickstarts/issue-certificate#next-step",{"_3323":2456,"_29044":2442,"_20168":54957,"_5":13790,"_26439":2442,"_2811":54958},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3323":2457,"_29044":2442,"_20168":54960,"_5":13790,"_26439":54913,"_2811":54961},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3323":2458,"_29044":2442,"_20168":54963,"_5":13790,"_26439":54913,"_2811":54964},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3323":2459,"_29044":2442,"_20168":54966,"_5":13790,"_26439":54913,"_2811":54967},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3323":2460,"_29044":2442,"_20168":54969,"_5":13790,"_26439":54913,"_2811":54970},[],"A client identifier: here we use `device-001`.",{"_3323":2461,"_29044":2442,"_20168":54972,"_5":13790,"_26439":54913,"_2811":54973},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3323":2462,"_29044":2442,"_20168":54975,"_5":13790,"_26439":54916,"_2811":54976},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3323":2463,"_29044":2442,"_20168":54978,"_5":13790,"_26439":54920,"_2811":54979},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3323":2464,"_29044":2442,"_20168":54981,"_5":13790,"_26439":54920,"_2811":54982},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3323":2465,"_29044":2442,"_20168":54984,"_5":13790,"_26439":54924,"_2811":54985},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3323":2466,"_29044":2442,"_20168":54987,"_5":13790,"_26439":54924,"_2811":54988},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3323":2467,"_29044":2442,"_20168":54990,"_5":13790,"_26439":54928,"_2811":54991},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3323":2468,"_29044":2442,"_20168":54993,"_5":13790,"_26439":54928,"_2811":54994},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3323":2469,"_29044":2442,"_20168":54996,"_5":13790,"_26439":54932,"_2811":54997},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3323":2470,"_29044":2442,"_20168":54999,"_5":13790,"_26439":54936,"_2811":55000},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3323":2471,"_29044":2442,"_20168":55002,"_5":13790,"_26439":54940,"_2811":55003},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3323":2472,"_29044":2442,"_20168":55005,"_5":13790,"_26439":54944,"_2811":55006},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3323":2473,"_29044":2442,"_20168":55008,"_5":13790,"_26439":54944,"_2811":55009},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3323":2474,"_29044":2442,"_20168":55011,"_5":13790,"_26439":54944,"_2811":55012},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3323":2475,"_29044":2442,"_20168":55014,"_5":13790,"_26439":54948,"_2811":55015},[],"In Bash, compare the two public-key digests:",{"_3323":2476,"_29044":2442,"_20168":55017,"_5":13790,"_26439":54948,"_2811":55018},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3323":2477,"_29044":2442,"_20168":55020,"_5":13790,"_26439":54948,"_2811":55021},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3323":2478,"_29044":2442,"_20168":55023,"_5":13790,"_26439":54952,"_2811":52535},[],{"_3323":2479,"_29044":2442,"_20168":55025,"_5":13790,"_26439":54952,"_2811":55026},[],"What to review",{"_3323":2480,"_29044":2442,"_20168":55028,"_5":13790,"_26439":54952,"_2811":55029},[],"The CA rejects issuance",{"_3323":2481,"_29044":2442,"_20168":55031,"_5":13790,"_26439":54952,"_2811":55032},[],"Permissions, CA state and key, algorithm and profile.",{"_3323":2482,"_29044":2442,"_20168":55034,"_5":13790,"_26439":54952,"_2811":55035},[],"Different subject or usages",{"_3323":2483,"_29044":2442,"_20168":55037,"_5":13790,"_26439":54952,"_2811":55038},[],"Applied profile and requested values.",{"_3323":2484,"_29044":2442,"_20168":55040,"_5":13790,"_26439":54952,"_2811":55041},[],"Issuer cannot be found",{"_3323":2485,"_29044":2442,"_20168":55043,"_5":13790,"_26439":54952,"_2811":55044},[],"Downloaded CA and required intermediate chain.",{"_3323":2486,"_29044":2442,"_20168":55046,"_5":13790,"_26439":54952,"_2811":55047},[],"Validity fails",{"_3323":2487,"_29044":2442,"_20168":55049,"_5":13790,"_26439":54952,"_2811":55050},[],"Certificate and CA dates, and the computer's clock.",{"_3323":2488,"_29044":2442,"_20168":55052,"_5":13790,"_26439":54952,"_2811":55053},[],"Public-key digests differ",{"_3323":2489,"_29044":2442,"_20168":55055,"_5":13790,"_26439":54952,"_2811":55056},[],"Certificate and key files from the same issuance.",{"_3323":2490,"_29044":2442,"_20168":55058,"_5":13790,"_26439":54952,"_2811":55059},[],"See PKI diagnostics to narrow an issuance failure.",{"_3323":2491,"_29044":2442,"_20168":55061,"_5":13790,"_26439":54955,"_2811":55062},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3323":2492,"_29044":2442,"_20168":55064,"_5":13790,"_26439":54955,"_2811":55065},[],"Manage certificates for inspection, status and revocation.",{"_3323":2493,"_29044":2442,"_20168":55067,"_5":13790,"_26439":54955,"_2811":55068},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3323":2494,"_29044":2442,"_20168":55070,"_5":13790,"_26439":54955,"_2811":55071},[],"Prepare EST for the device to request its next identities.",{"_3323":2495,"_29044":2442,"_20168":55073,"_5":13790,"_26439":54955,"_2811":55074},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3323":2496,"_29044":2496,"_5":14148,"_2811":55076,"_29388":55077,"_20168":55078,"_26439":2496},"PKI getting started",[47299,48748,52757,52194],[],{"_3323":2497,"_29044":2496,"_20168":55080,"_5":13790,"_26439":2496,"_2811":55081},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3323":2498,"_29044":2496,"_5":29385,"_20168":55083,"_26439":55084,"_2811":47309},[],"/docs/pr-preview/pr-46/platform/pki/quickstarts/overview#before-you-begin",{"_3323":2499,"_29044":2496,"_5":29385,"_20168":55086,"_26439":55087,"_2811":55088},[],"/docs/pr-preview/pr-46/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3323":2500,"_29044":2496,"_5":29385,"_20168":55090,"_26439":55091,"_2811":52386},[],"/docs/pr-preview/pr-46/platform/pki/quickstarts/overview#expected-result",{"_3323":2501,"_29044":2496,"_5":29385,"_20168":55093,"_26439":55094,"_2811":55095},[],"/docs/pr-preview/pr-46/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3323":2502,"_29044":2496,"_20168":55097,"_5":13790,"_26439":2496,"_2811":55098},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3323":2503,"_29044":2496,"_20168":55100,"_5":13790,"_26439":55084,"_2811":55101},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3323":2504,"_29044":2496,"_20168":55103,"_5":13790,"_26439":55084,"_2811":55104},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3323":2505,"_29044":2496,"_20168":55106,"_5":13790,"_26439":55084,"_2811":55107},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3323":2506,"_29044":2496,"_20168":55109,"_5":13790,"_26439":55084,"_2811":55110},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3323":2507,"_29044":2496,"_20168":55112,"_5":13790,"_26439":55084,"_2811":55113},[],"A working directory with restricted access for the downloaded key.",{"_3323":2508,"_29044":2496,"_20168":55115,"_5":13790,"_26439":55087,"_2811":55116},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3323":2509,"_29044":2496,"_20168":55118,"_5":13790,"_26439":55087,"_2811":55119},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3323":2510,"_29044":2496,"_20168":55121,"_5":13790,"_26439":55087,"_2811":55122},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3323":2511,"_29044":2496,"_20168":55124,"_5":13790,"_26439":55087,"_2811":55125},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3323":2512,"_29044":2496,"_20168":55127,"_5":13790,"_26439":55091,"_2811":55128},[],"File or resource",{"_3323":2513,"_29044":2496,"_20168":55130,"_5":13790,"_26439":55091,"_2811":52383},[],{"_3323":2514,"_29044":2496,"_20168":55132,"_5":13790,"_26439":55091,"_2811":55133},[],"Active root CA and `ca.pem`",{"_3323":2515,"_29044":2496,"_20168":55135,"_5":13790,"_26439":55091,"_2811":55136},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3323":2516,"_29044":2496,"_20168":55138,"_5":13790,"_26439":55091,"_2811":55139},[],"End-entity certificate and `device.crt`",{"_3323":2517,"_29044":2496,"_20168":55141,"_5":13790,"_26439":55091,"_2811":55142},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3323":2518,"_29044":2496,"_20168":55144,"_5":13790,"_26439":55091,"_2811":55145},[],"Private key `device.key`",{"_3323":2519,"_29044":2496,"_20168":55147,"_5":13790,"_26439":55091,"_2811":55148},[],"Its public key matches the one included in `device.crt`.",{"_3323":2520,"_29044":2496,"_20168":55150,"_5":13790,"_26439":55091,"_2811":55151},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3323":2521,"_29044":2496,"_20168":55153,"_5":13790,"_26439":55094,"_2811":55154},[],"To operate certificates, continue with Certificates and Validation.",{"_3323":2522,"_29044":2496,"_20168":55156,"_5":13790,"_26439":55094,"_2811":55157},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3323":2523,"_29044":2496,"_20168":55159,"_5":13790,"_26439":55094,"_2811":55160},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3323":2524,"_29044":2524,"_5":14148,"_2811":55162,"_29388":55163,"_20168":55164,"_26439":2524},"PKI troubleshooting",[47299,48748,52757,51329],[],{"_3323":2525,"_29044":2524,"_20168":55166,"_5":13790,"_26439":2524,"_2811":55167},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3323":2526,"_29044":2524,"_5":29385,"_20168":55169,"_26439":55170,"_2811":55171},[],"/docs/pr-preview/pr-46/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3323":2527,"_29044":2524,"_5":29385,"_20168":55173,"_26439":55174,"_2811":55175},[],"/docs/pr-preview/pr-46/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3323":2528,"_29044":2524,"_5":29385,"_20168":55177,"_26439":55178,"_2811":55179},[],"/docs/pr-preview/pr-46/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3323":2529,"_29044":2524,"_20168":55181,"_5":13790,"_26439":2524,"_2811":55182},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3323":2530,"_29044":2524,"_20168":55184,"_5":13790,"_26439":2524,"_2811":55185},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3323":2531,"_29044":2524,"_20168":55187,"_5":13790,"_26439":55170,"_2811":52383},[],{"_3323":2532,"_29044":2524,"_20168":55189,"_5":13790,"_26439":55170,"_2811":55190},[],"What to inspect",{"_3323":2533,"_29044":2524,"_20168":55192,"_5":13790,"_26439":55170,"_2811":47333},[],{"_3323":2534,"_29044":2524,"_20168":55194,"_5":13790,"_26439":55170,"_2811":51596},[],{"_3323":2535,"_29044":2524,"_20168":55196,"_5":13790,"_26439":55170,"_2811":55197},[],"Exists, is active and has usable dates.",{"_3323":2536,"_29044":2524,"_20168":55199,"_5":13790,"_26439":55170,"_2811":55200},[],"Authorities.",{"_3323":2537,"_29044":2524,"_20168":55202,"_5":13790,"_26439":55170,"_2811":55203},[],"Key",{"_3323":2538,"_29044":2524,"_20168":55205,"_5":13790,"_26439":55170,"_2811":55206},[],"The record has a usable private key and the engine can sign.",{"_3323":2539,"_29044":2524,"_20168":55208,"_5":13790,"_26439":55170,"_2811":55209},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3323":2540,"_29044":2524,"_20168":55211,"_5":13790,"_26439":55170,"_2811":55212},[],"CSR",{"_3323":2541,"_29044":2524,"_20168":55214,"_5":13790,"_26439":55170,"_2811":55215},[],"Correct PEM and verifiable signature.",{"_3323":2542,"_29044":2524,"_20168":55217,"_5":13790,"_26439":55170,"_2811":55218},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3323":2543,"_29044":2524,"_20168":55220,"_5":13790,"_26439":55170,"_2811":55221},[],"Profile",{"_3323":2544,"_29044":2524,"_20168":55223,"_5":13790,"_26439":55170,"_2811":55224},[],"Selected source, existing ID, allowed algorithm and size.",{"_3323":2545,"_29044":2524,"_20168":55226,"_5":13790,"_26439":55170,"_2811":55227},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3323":2546,"_29044":2524,"_20168":55229,"_5":13790,"_26439":55170,"_2811":52535},[],{"_3323":2547,"_29044":2524,"_20168":55231,"_5":13790,"_26439":55170,"_2811":55232},[],"Appropriate subject, SAN, usages and dates.",{"_3323":2548,"_29044":2524,"_20168":55234,"_5":13790,"_26439":55170,"_2811":55235},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3323":2549,"_29044":2524,"_20168":55237,"_5":13790,"_26439":55170,"_2811":55238},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3323":2550,"_29044":2524,"_20168":55240,"_5":13790,"_26439":55170,"_2811":55241},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3323":2551,"_29044":2524,"_20168":55243,"_5":13790,"_26439":55174,"_2811":55244},[],"Check each boundary independently:",{"_3323":2552,"_29044":2524,"_20168":55246,"_5":13790,"_26439":55174,"_2811":55247},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3323":2553,"_29044":2524,"_20168":55249,"_5":13790,"_26439":55174,"_2811":55250},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3323":2554,"_29044":2524,"_20168":55252,"_5":13790,"_26439":55174,"_2811":55253},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3323":2555,"_29044":2524,"_20168":55255,"_5":13790,"_26439":55174,"_2811":55256},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3323":2556,"_29044":2524,"_20168":55258,"_5":13790,"_26439":55174,"_2811":55259},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3323":2557,"_29044":2524,"_20168":55261,"_5":13790,"_26439":55174,"_2811":55262},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3323":2558,"_29044":2524,"_20168":55264,"_5":13790,"_26439":55178,"_2811":55265},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3323":2559,"_29044":2524,"_20168":55267,"_5":13790,"_26439":55178,"_2811":55268},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3323":2560,"_29044":2560,"_5":14148,"_2811":55270,"_29388":55271,"_20168":55273,"_26439":2560},"3.8.0 to 4.0.0",[47299,55272],"Upgrades",[],{"_3323":2561,"_29044":2560,"_20168":55275,"_5":13790,"_26439":2560,"_2811":55276},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3323":2562,"_29044":2560,"_5":29385,"_20168":55278,"_26439":55279,"_2811":55280},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3323":2563,"_29044":2560,"_5":29385,"_20168":55282,"_26439":55283,"_2811":55284},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3323":2564,"_29044":2560,"_5":29385,"_20168":55286,"_26439":55287,"_2811":55288},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3323":2565,"_29044":2560,"_5":29385,"_20168":55290,"_26439":55291,"_2811":55292},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3323":2566,"_29044":2560,"_5":29385,"_20168":55294,"_26439":55295,"_2811":55296},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3323":2567,"_29044":2560,"_5":29385,"_20168":55298,"_26439":55299,"_2811":55300},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3323":2568,"_29044":2560,"_5":29385,"_20168":55302,"_26439":55303,"_2811":55304},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3323":2569,"_29044":2560,"_5":29385,"_20168":55306,"_26439":55307,"_2811":55308},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3323":2570,"_29044":2560,"_5":29385,"_20168":55310,"_26439":55311,"_2811":55312},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3323":2571,"_29044":2560,"_5":29385,"_20168":55314,"_26439":55315,"_2811":55316},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3323":2572,"_29044":2560,"_5":29385,"_20168":55318,"_26439":55319,"_2811":55320},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3323":2573,"_29044":2560,"_5":29385,"_20168":55322,"_26439":55323,"_2811":55324},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3323":2574,"_29044":2560,"_5":29385,"_20168":55326,"_26439":55327,"_2811":55328},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3323":2575,"_29044":2560,"_5":29385,"_20168":55330,"_26439":55331,"_2811":55332},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3323":2576,"_29044":2560,"_5":29385,"_20168":55334,"_26439":55335,"_2811":55336},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3323":2577,"_29044":2560,"_5":29385,"_20168":55338,"_26439":55339,"_2811":55340},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3323":2578,"_29044":2560,"_5":29385,"_20168":55342,"_26439":55343,"_2811":55344},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3323":2579,"_29044":2560,"_5":29385,"_20168":55346,"_26439":55347,"_2811":55348},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3323":2580,"_29044":2560,"_5":29385,"_20168":55350,"_26439":55351,"_2811":55352},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3323":2581,"_29044":2560,"_5":29385,"_20168":55354,"_26439":55355,"_2811":55356},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3323":2582,"_29044":2560,"_5":29385,"_20168":55358,"_26439":55359,"_2811":55360},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3323":2583,"_29044":2560,"_5":29385,"_20168":55362,"_26439":55363,"_2811":55364},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3323":2584,"_29044":2560,"_5":29385,"_20168":55366,"_26439":55367,"_2811":55368},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3323":2585,"_29044":2560,"_5":29385,"_20168":55370,"_26439":55371,"_2811":55372},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3323":2586,"_29044":2560,"_5":29385,"_20168":55374,"_26439":55375,"_2811":55376},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3323":2587,"_29044":2560,"_5":29385,"_20168":55378,"_26439":55379,"_2811":55380},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3323":2588,"_29044":2560,"_5":29385,"_20168":55382,"_26439":55383,"_2811":55384},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3323":2589,"_29044":2560,"_5":29385,"_20168":55386,"_26439":55387,"_2811":55388},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3323":2590,"_29044":2560,"_5":29385,"_20168":55390,"_26439":55391,"_2811":55392},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3323":2591,"_29044":2560,"_5":29385,"_20168":55394,"_26439":55395,"_2811":55396},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3323":2592,"_29044":2560,"_5":29385,"_20168":55398,"_26439":55399,"_2811":55400},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3323":2593,"_29044":2560,"_5":29385,"_20168":55402,"_26439":55403,"_2811":55404},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3323":2594,"_29044":2560,"_5":29385,"_20168":55406,"_26439":55407,"_2811":55408},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3323":2595,"_29044":2560,"_5":29385,"_20168":55410,"_26439":55411,"_2811":51329},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3323":2596,"_29044":2560,"_5":29385,"_20168":55413,"_26439":55414,"_2811":55415},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3323":2597,"_29044":2560,"_5":29385,"_20168":55417,"_26439":55418,"_2811":55419},[],"/docs/pr-preview/pr-46/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3323":2598,"_29044":2560,"_20168":55421,"_5":13790,"_26439":2560,"_2811":55422},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3323":2599,"_29044":2560,"_20168":55424,"_5":13790,"_26439":2560,"_2811":55425},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3323":2600,"_29044":2560,"_20168":55427,"_5":13790,"_26439":2560,"_2811":55428},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3323":2601,"_29044":2560,"_20168":55430,"_5":13790,"_26439":2560,"_2811":55431},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3323":2602,"_29044":2560,"_20168":55433,"_5":13790,"_26439":2560,"_2811":55434},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3323":2603,"_29044":2560,"_20168":55436,"_5":13790,"_26439":2560,"_2811":55437},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3323":2604,"_29044":2560,"_20168":55439,"_5":13790,"_26439":2560,"_2811":55440},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3323":2605,"_29044":2560,"_20168":55442,"_5":13790,"_26439":55283,"_2811":55443},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3323":2606,"_29044":2560,"_20168":55445,"_5":13790,"_26439":55283,"_2811":55446},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3323":2607,"_29044":2560,"_20168":55448,"_5":13790,"_26439":55287,"_2811":55449},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3323":2608,"_29044":2560,"_20168":55451,"_5":13790,"_26439":55287,"_2811":55452},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3323":2609,"_29044":2560,"_20168":55454,"_5":13790,"_26439":55291,"_2811":55455},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3323":2610,"_29044":2560,"_20168":55457,"_5":13790,"_26439":55295,"_2811":55458},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3323":2611,"_29044":2560,"_20168":55460,"_5":13790,"_26439":55295,"_2811":55461},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3323":2612,"_29044":2560,"_20168":55463,"_5":13790,"_26439":55295,"_2811":55464},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3323":2613,"_29044":2560,"_20168":55466,"_5":13790,"_26439":55295,"_2811":55467},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3323":2614,"_29044":2560,"_20168":55469,"_5":13790,"_26439":55295,"_2811":55470},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3323":2615,"_29044":2560,"_20168":55472,"_5":13790,"_26439":55299,"_2811":55473},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3323":2616,"_29044":2560,"_20168":55475,"_5":13790,"_26439":55299,"_2811":55476},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3323":2617,"_29044":2560,"_20168":55478,"_5":13790,"_26439":55299,"_2811":55479},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3323":2618,"_29044":2560,"_20168":55481,"_5":13790,"_26439":55299,"_2811":55482},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3323":2619,"_29044":2560,"_20168":55484,"_5":13790,"_26439":55299,"_2811":55485},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3323":2620,"_29044":2560,"_20168":55487,"_5":13790,"_26439":55303,"_2811":55488},[],"Change",{"_3323":2621,"_29044":2560,"_20168":55490,"_5":13790,"_26439":55303,"_2811":55491},[],"Who is affected",{"_3323":2622,"_29044":2560,"_20168":55493,"_5":13790,"_26439":55303,"_2811":55494},[],"Severity",{"_3323":2623,"_29044":2560,"_20168":55496,"_5":13790,"_26439":55303,"_2811":54093},[],{"_3323":2624,"_29044":2560,"_20168":55498,"_5":13790,"_26439":55303,"_2811":55312},[],{"_3323":2625,"_29044":2560,"_20168":55500,"_5":13790,"_26439":55303,"_2811":55501},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3323":2626,"_29044":2560,"_20168":55503,"_5":13790,"_26439":55303,"_2811":55504},[],"High: KMS and VA start on empty volumes",{"_3323":2627,"_29044":2560,"_20168":55506,"_5":13790,"_26439":55303,"_2811":55507},[],"Copy the data into the new volumes",{"_3323":2628,"_29044":2560,"_20168":55509,"_5":13790,"_26439":55303,"_2811":55316},[],{"_3323":2629,"_29044":2560,"_20168":55511,"_5":13790,"_26439":55303,"_2811":55512},[],"Every Helm release",{"_3323":2630,"_29044":2560,"_20168":55514,"_5":13790,"_26439":55303,"_2811":55515},[],"High: `helm upgrade` fails",{"_3323":2631,"_29044":2560,"_20168":55517,"_5":13790,"_26439":55303,"_2811":55518},[],"Remove or rename legacy keys",{"_3323":2632,"_29044":2560,"_20168":55520,"_5":13790,"_26439":55303,"_2811":55320},[],{"_3323":2633,"_29044":2560,"_20168":55522,"_5":13790,"_26439":55303,"_2811":55523},[],"Every deployment",{"_3323":2634,"_29044":2560,"_20168":55525,"_5":13790,"_26439":55303,"_2811":55526},[],"High: without a bootstrap principal there is no administrator",{"_3323":2635,"_29044":2560,"_20168":55528,"_5":13790,"_26439":55303,"_2811":55529},[],"Configure `services.authz`",{"_3323":2636,"_29044":2560,"_20168":55531,"_5":13790,"_26439":55303,"_2811":55324},[],{"_3323":2637,"_29044":2560,"_20168":55533,"_5":13790,"_26439":55303,"_2811":55512},[],{"_3323":2638,"_29044":2560,"_20168":55535,"_5":13790,"_26439":55303,"_2811":55536},[],"High: `helm upgrade` fails on the old keys",{"_3323":2639,"_29044":2560,"_20168":55538,"_5":13790,"_26439":55303,"_2811":55539},[],"Move JWKS and roles into `services.authz`",{"_3323":2640,"_29044":2560,"_20168":55541,"_5":13790,"_26439":55303,"_2811":55344},[],{"_3323":2641,"_29044":2560,"_20168":55543,"_5":13790,"_26439":55303,"_2811":55544},[],"3.8.0 deployments with per-service databases",{"_3323":2642,"_29044":2560,"_20168":55546,"_5":13790,"_26439":55303,"_2811":55547},[],"High: services find no data, or a migration aborts",{"_3323":2643,"_29044":2560,"_20168":55549,"_5":13790,"_26439":55303,"_2811":55550},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3323":2644,"_29044":2560,"_20168":55552,"_5":13790,"_26439":55303,"_2811":55348},[],{"_3323":2645,"_29044":2560,"_20168":55554,"_5":13790,"_26439":55303,"_2811":55555},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3323":2646,"_29044":2560,"_20168":55557,"_5":13790,"_26439":55303,"_2811":55558},[],"High: the backend no longer starts with them",{"_3323":2647,"_29044":2560,"_20168":55560,"_5":13790,"_26439":55303,"_2811":55561},[],"Move to PostgreSQL before upgrading",{"_3323":2648,"_29044":2560,"_20168":55563,"_5":13790,"_26439":55303,"_2811":55564},[],"Webhooks with file references",{"_3323":2649,"_29044":2560,"_20168":55566,"_5":13790,"_26439":55303,"_2811":55567},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3323":2650,"_29044":2560,"_20168":55569,"_5":13790,"_26439":55303,"_2811":55570},[],"High: enrollments calling the webhook fail",{"_3323":2651,"_29044":2560,"_20168":55572,"_5":13790,"_26439":55303,"_2811":55573},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3323":2652,"_29044":2560,"_20168":55575,"_5":13790,"_26439":55303,"_2811":55328},[],{"_3323":2653,"_29044":2560,"_20168":55577,"_5":13790,"_26439":55303,"_2811":55578},[],"Releases with per-service identity overrides or mounted key material",{"_3323":2654,"_29044":2560,"_20168":55580,"_5":13790,"_26439":55303,"_2811":55581},[],"Medium: services cannot read their files",{"_3323":2655,"_29044":2560,"_20168":55583,"_5":13790,"_26439":55303,"_2811":55584},[],"Remove the overrides and fix volume ownership",{"_3323":2656,"_29044":2560,"_20168":55586,"_5":13790,"_26439":55303,"_2811":55332},[],{"_3323":2657,"_29044":2560,"_20168":55588,"_5":13790,"_26439":55303,"_2811":55589},[],"Releases that set `amqp.tls`",{"_3323":2658,"_29044":2560,"_20168":55591,"_5":13790,"_26439":55303,"_2811":55592},[],"Medium: clients connect to the wrong port",{"_3323":2659,"_29044":2560,"_20168":55594,"_5":13790,"_26439":55303,"_2811":55595},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3323":2660,"_29044":2560,"_20168":55597,"_5":13790,"_26439":55303,"_2811":55352},[],{"_3323":2661,"_29044":2560,"_20168":55599,"_5":13790,"_26439":55303,"_2811":55600},[],"Installations whose CA keys predate the KMS",{"_3323":2662,"_29044":2560,"_20168":55602,"_5":13790,"_26439":55303,"_2811":55603},[],"Medium: CA keys stay unmanaged",{"_3323":2663,"_29044":2560,"_20168":55605,"_5":13790,"_26439":55303,"_2811":55606},[],"Run the CA-to-KMS migration",{"_3323":2664,"_29044":2560,"_20168":55608,"_5":13790,"_26439":55303,"_2811":55609},[],"Receiver certificate verification",{"_3323":2665,"_29044":2560,"_20168":55611,"_5":13790,"_26439":55303,"_2811":55612},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3323":2666,"_29044":2560,"_20168":55614,"_5":13790,"_26439":55303,"_2811":55615},[],"Medium: credentials go to an unverified receiver",{"_3323":2667,"_29044":2560,"_20168":55617,"_5":13790,"_26439":55303,"_2811":55618},[],"Set `insecure_skip_verify` to `false`",{"_3323":2668,"_29044":2560,"_20168":55620,"_5":13790,"_26439":55303,"_2811":55364},[],{"_3323":2669,"_29044":2560,"_20168":55622,"_5":13790,"_26439":55303,"_2811":55623},[],"Scripts and consoles that edit DMSs through the API",{"_3323":2670,"_29044":2560,"_20168":55625,"_5":13790,"_26439":55303,"_2811":55626},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3323":2671,"_29044":2560,"_20168":55628,"_5":13790,"_26439":55303,"_2811":55629},[],"Read the DMS before editing and use the new field",{"_3323":2672,"_29044":2560,"_20168":55631,"_5":13790,"_26439":55303,"_2811":55380},[],{"_3323":2673,"_29044":2560,"_20168":55633,"_5":13790,"_26439":55303,"_2811":55634},[],"Consumers that read the device `events` field",{"_3323":2674,"_29044":2560,"_20168":55636,"_5":13790,"_26439":55303,"_2811":55637},[],"Medium: the field disappears",{"_3323":2675,"_29044":2560,"_20168":55639,"_5":13790,"_26439":55303,"_2811":55640},[],"Use the new event endpoints",{"_3323":2676,"_29044":2560,"_20168":55642,"_5":13790,"_26439":55303,"_2811":55336},[],{"_3323":2677,"_29044":2560,"_20168":55644,"_5":13790,"_26439":55303,"_2811":55645},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3323":2678,"_29044":2560,"_20168":55647,"_5":13790,"_26439":55303,"_2811":55648},[],"Low to medium: validation errors or changed defaults",{"_3323":2679,"_29044":2560,"_20168":55650,"_5":13790,"_26439":55303,"_2811":55651},[],"Update the values file",{"_3323":2680,"_29044":2560,"_20168":55653,"_5":13790,"_26439":55303,"_2811":55372},[],{"_3323":2681,"_29044":2560,"_20168":55655,"_5":13790,"_26439":55303,"_2811":55656},[],"Clients that send the DMS ID in the update body",{"_3323":2682,"_29044":2560,"_20168":55658,"_5":13790,"_26439":55303,"_2811":55659},[],"Low: the ID in the URL wins",{"_3323":2683,"_29044":2560,"_20168":55661,"_5":13790,"_26439":55303,"_2811":55662},[],"Send the ID in the URL",{"_3323":2684,"_29044":2560,"_20168":55664,"_5":13790,"_26439":55303,"_2811":55376},[],{"_3323":2685,"_29044":2560,"_20168":55666,"_5":13790,"_26439":55303,"_2811":55667},[],"Consumers that match on certificate `type`",{"_3323":2686,"_29044":2560,"_20168":55669,"_5":13790,"_26439":55303,"_2811":55670},[],"Low: two values are renamed",{"_3323":2687,"_29044":2560,"_20168":55672,"_5":13790,"_26439":55303,"_2811":55673},[],"Adapt consumers",{"_3323":2688,"_29044":2560,"_20168":55675,"_5":13790,"_26439":55303,"_2811":55368},[],{"_3323":2689,"_29044":2560,"_20168":55677,"_5":13790,"_26439":55303,"_2811":55678},[],"Any DMS",{"_3323":2690,"_29044":2560,"_20168":55680,"_5":13790,"_26439":55303,"_2811":55681},[],"Low: informational",{"_3323":2691,"_29044":2560,"_20168":55683,"_5":13790,"_26439":55303,"_2811":55684},[],"Read both blocks before editing",{"_3323":2692,"_29044":2560,"_20168":55686,"_5":13790,"_26439":55311,"_2811":55687},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3323":2693,"_29044":2560,"_20168":55689,"_5":13790,"_26439":55311,"_2811":55690},[],"Step 4 of the migration guide copies the data.",{"_3323":2694,"_29044":2560,"_20168":55692,"_5":13790,"_26439":55315,"_2811":55693},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3323":2695,"_29044":2560,"_20168":55695,"_5":13790,"_26439":55319,"_2811":55696},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3323":2696,"_29044":2560,"_20168":55698,"_5":13790,"_26439":55323,"_2811":55699},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3323":2697,"_29044":2560,"_20168":55701,"_5":13790,"_26439":55327,"_2811":55702},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3323":2698,"_29044":2560,"_20168":55704,"_5":13790,"_26439":55327,"_2811":55705},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3323":2699,"_29044":2560,"_20168":55707,"_5":13790,"_26439":55331,"_2811":55708},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3323":2700,"_29044":2560,"_20168":55710,"_5":13790,"_26439":55335,"_2811":55711},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3323":2701,"_29044":2560,"_20168":55713,"_5":13790,"_26439":55335,"_2811":55714},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3323":2702,"_29044":2560,"_20168":55716,"_5":13790,"_26439":55335,"_2811":55717},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3323":2703,"_29044":2560,"_20168":55719,"_5":13790,"_26439":55335,"_2811":55720},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3323":2704,"_29044":2560,"_20168":55722,"_5":13790,"_26439":55335,"_2811":55723},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3323":2705,"_29044":2560,"_20168":55725,"_5":13790,"_26439":55335,"_2811":55726},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3323":2706,"_29044":2560,"_20168":55728,"_5":13790,"_26439":55343,"_2811":55729},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3323":2707,"_29044":2560,"_20168":55731,"_5":13790,"_26439":55343,"_2811":55732},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3323":2708,"_29044":2560,"_20168":55734,"_5":13790,"_26439":55343,"_2811":55735},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3323":2709,"_29044":2560,"_20168":55737,"_5":13790,"_26439":55343,"_2811":55738},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3323":2710,"_29044":2560,"_20168":55740,"_5":13790,"_26439":55343,"_2811":55741},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3323":2711,"_29044":2560,"_20168":55743,"_5":13790,"_26439":55347,"_2811":55744},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3323":2712,"_29044":2560,"_20168":55746,"_5":13790,"_26439":55351,"_2811":55747},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3323":2713,"_29044":2560,"_20168":55749,"_5":13790,"_26439":55351,"_2811":55750},[],"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_3323":2714,"_29044":2560,"_20168":55752,"_5":13790,"_26439":55351,"_2811":55753},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3323":2715,"_29044":2560,"_20168":55755,"_5":13790,"_26439":55351,"_2811":55756},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3323":2716,"_29044":2560,"_20168":55758,"_5":13790,"_26439":55351,"_2811":55759},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3323":2717,"_29044":2560,"_20168":55761,"_5":13790,"_26439":55351,"_2811":55762},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3323":2718,"_29044":2560,"_20168":55764,"_5":13790,"_26439":55359,"_2811":55765},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3323":2719,"_29044":2560,"_20168":55767,"_5":13790,"_26439":55359,"_2811":55768},[],"Field in 3.8.0",{"_3323":2720,"_29044":2560,"_20168":55770,"_5":13790,"_26439":55359,"_2811":55771},[],"Field in 4.0.0",{"_3323":2721,"_29044":2560,"_20168":55773,"_5":13790,"_26439":55359,"_2811":55774},[],"`validate_server_cert`",{"_3323":2722,"_29044":2560,"_20168":55776,"_5":13790,"_26439":55359,"_2811":55777},[],"`insecure_skip_verify` (value negated)",{"_3323":2723,"_29044":2560,"_20168":55779,"_5":13790,"_26439":55359,"_2811":55780},[],"`oidc`",{"_3323":2724,"_29044":2560,"_20168":55782,"_5":13790,"_26439":55359,"_2811":55783},[],"`jwt_options`",{"_3323":2725,"_29044":2560,"_20168":55785,"_5":13790,"_26439":55359,"_2811":55786},[],"`apikey`",{"_3323":2726,"_29044":2560,"_20168":55788,"_5":13790,"_26439":55359,"_2811":55789},[],"`apikey_options`",{"_3323":2727,"_29044":2560,"_20168":55791,"_5":13790,"_26439":55359,"_2811":55792},[],"`mtls`",{"_3323":2728,"_29044":2560,"_20168":55794,"_5":13790,"_26439":55359,"_2811":55795},[],"`mtls_options`",{"_3323":2729,"_29044":2560,"_20168":55797,"_5":13790,"_26439":55359,"_2811":55798},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3323":2730,"_29044":2560,"_20168":55800,"_5":13790,"_26439":55359,"_2811":55801},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3323":2731,"_29044":2560,"_20168":55803,"_5":13790,"_26439":55359,"_2811":55804},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3323":2732,"_29044":2560,"_20168":55806,"_5":13790,"_26439":55363,"_2811":55807},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3323":2733,"_29044":2560,"_20168":55809,"_5":13790,"_26439":55363,"_2811":55810},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3323":2734,"_29044":2560,"_20168":55812,"_5":13790,"_26439":55363,"_2811":55813},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3323":2735,"_29044":2560,"_20168":55815,"_5":13790,"_26439":55367,"_2811":55816},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3323":2736,"_29044":2560,"_20168":55818,"_5":13790,"_26439":55371,"_2811":55819},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3323":2737,"_29044":2560,"_20168":55821,"_5":13790,"_26439":55375,"_2811":55822},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3323":2738,"_29044":2560,"_20168":55824,"_5":13790,"_26439":55379,"_2811":55825},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3323":2739,"_29044":2560,"_20168":55827,"_5":13790,"_26439":55379,"_2811":55828},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3323":2740,"_29044":2560,"_20168":55830,"_5":13790,"_26439":55379,"_2811":55831},[],"`POST /v1/devices/:id/events` creates an event.",{"_3323":2741,"_29044":2560,"_20168":55833,"_5":13790,"_26439":55379,"_2811":55834},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3323":2742,"_29044":2560,"_20168":55836,"_5":13790,"_26439":55383,"_2811":55837},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3323":2743,"_29044":2560,"_20168":55839,"_5":13790,"_26439":55387,"_2811":55840},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_3323":2744,"_29044":2560,"_20168":55842,"_5":13790,"_26439":55387,"_2811":55843},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3323":2745,"_29044":2560,"_20168":55845,"_5":13790,"_26439":55387,"_2811":55846},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3323":2746,"_29044":2560,"_20168":55848,"_5":13790,"_26439":55387,"_2811":55849},[],"Record the names of your local-storage PVCs:",{"_3323":2747,"_29044":2560,"_20168":55851,"_5":13790,"_26439":55387,"_2811":55852},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3323":2748,"_29044":2560,"_20168":55854,"_5":13790,"_26439":55391,"_2811":55855},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3323":2749,"_29044":2560,"_20168":55857,"_5":13790,"_26439":55391,"_2811":55858},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3323":2750,"_29044":2560,"_20168":55860,"_5":13790,"_26439":55391,"_2811":55861},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3323":2751,"_29044":2560,"_20168":55863,"_5":13790,"_26439":55391,"_2811":55864},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3323":2752,"_29044":2560,"_20168":55866,"_5":13790,"_26439":55391,"_2811":55867},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3323":2753,"_29044":2560,"_20168":55869,"_5":13790,"_26439":55391,"_2811":55870},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3323":2754,"_29044":2560,"_20168":55872,"_5":13790,"_26439":55391,"_2811":55873},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3323":2755,"_29044":2560,"_20168":55875,"_5":13790,"_26439":55391,"_2811":55876},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3323":2756,"_29044":2560,"_20168":55878,"_5":13790,"_26439":55391,"_2811":55879},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3323":2757,"_29044":2560,"_20168":55881,"_5":13790,"_26439":55391,"_2811":55882},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3323":2758,"_29044":2560,"_20168":55884,"_5":13790,"_26439":55391,"_2811":55885},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3323":2759,"_29044":2560,"_20168":55887,"_5":13790,"_26439":55391,"_2811":55888},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3323":2760,"_29044":2560,"_20168":55890,"_5":13790,"_26439":55395,"_2811":55891},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3323":2761,"_29044":2560,"_20168":55893,"_5":13790,"_26439":55395,"_2811":55894},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3323":2762,"_29044":2560,"_20168":55896,"_5":13790,"_26439":55399,"_2811":55897},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3323":2763,"_29044":2560,"_20168":55899,"_5":13790,"_26439":55399,"_2811":55900},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3323":2764,"_29044":2560,"_20168":55902,"_5":13790,"_26439":55399,"_2811":55903},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3323":2765,"_29044":2560,"_20168":55905,"_5":13790,"_26439":55399,"_2811":55906},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3323":2766,"_29044":2560,"_20168":55908,"_5":13790,"_26439":55399,"_2811":55909},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3323":2767,"_29044":2560,"_20168":55911,"_5":13790,"_26439":55399,"_2811":55912},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3323":2768,"_29044":2560,"_20168":55914,"_5":13790,"_26439":55399,"_2811":55915},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3323":2769,"_29044":2560,"_20168":55917,"_5":13790,"_26439":55399,"_2811":55918},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3323":2770,"_29044":2560,"_20168":55920,"_5":13790,"_26439":55399,"_2811":55921},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3323":2771,"_29044":2560,"_20168":55923,"_5":13790,"_26439":55399,"_2811":55924},[],"**Remove the helper and restore the recorded replica counts:**",{"_3323":2772,"_29044":2560,"_20168":55926,"_5":13790,"_26439":55399,"_2811":55927},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3323":2773,"_29044":2560,"_20168":55929,"_5":13790,"_26439":55403,"_2811":55930},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3323":2774,"_29044":2560,"_20168":55932,"_5":13790,"_26439":55403,"_2811":55933},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3323":2775,"_29044":2560,"_20168":55935,"_5":13790,"_26439":55407,"_2811":55936},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3323":2776,"_29044":2560,"_20168":55938,"_5":13790,"_26439":55407,"_2811":55939},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3323":2777,"_29044":2560,"_20168":55941,"_5":13790,"_26439":55407,"_2811":55942},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3323":2778,"_29044":2560,"_20168":55944,"_5":13790,"_26439":55407,"_2811":55945},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3323":2779,"_29044":2560,"_20168":55947,"_5":13790,"_26439":55407,"_2811":55948},[],"The `goose-lamassu` README still shows per-database examples (`dbname=ca`, `dbname=kms`) and claims the tool validates the database name, and the `ca-to-kms-migration` README still describes the pre-4.0.0 two-database layout. Follow the `dbname=pki` form on this page instead of their examples.",{"_3323":2780,"_29044":2560,"_20168":55950,"_5":13790,"_26439":55411,"_2811":55951},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3323":2781,"_29044":2560,"_20168":55953,"_5":13790,"_26439":55411,"_2811":55954},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3323":2782,"_29044":2560,"_20168":55956,"_5":13790,"_26439":55411,"_2811":55957},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3323":2783,"_29044":2560,"_20168":55959,"_5":13790,"_26439":55411,"_2811":55960},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3323":2784,"_29044":2560,"_20168":55962,"_5":13790,"_26439":55411,"_2811":55963},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_3323":2785,"_29044":2560,"_20168":55965,"_5":13790,"_26439":55411,"_2811":55966},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3323":2786,"_29044":2560,"_20168":55968,"_5":13790,"_26439":55411,"_2811":55969},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3323":2787,"_29044":2560,"_20168":55971,"_5":13790,"_26439":55414,"_2811":55972},[],"After the upgrade, check in this order:",{"_3323":2788,"_29044":2560,"_20168":55974,"_5":13790,"_26439":55414,"_2811":55975},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations.",{"_3323":2789,"_29044":2560,"_20168":55977,"_5":13790,"_26439":55414,"_2811":55978},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3323":2790,"_29044":2560,"_20168":55980,"_5":13790,"_26439":55414,"_2811":55981},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3323":2791,"_29044":2560,"_20168":55983,"_5":13790,"_26439":55414,"_2811":55984},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_3323":2792,"_29044":2560,"_20168":55986,"_5":13790,"_26439":55414,"_2811":55987},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS.",{"_3323":2793,"_29044":2560,"_20168":55989,"_5":13790,"_26439":55414,"_2811":55990},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3323":2794,"_29044":2560,"_20168":55992,"_5":13790,"_26439":55414,"_2811":55993},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3323":2795,"_29044":2560,"_20168":55995,"_5":13790,"_26439":55414,"_2811":55996},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3323":2796,"_29044":2560,"_20168":55998,"_5":13790,"_26439":55414,"_2811":55999},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3323":2797,"_29044":2560,"_20168":56001,"_5":13790,"_26439":55414,"_2811":56002},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3323":2798,"_29044":2560,"_20168":56004,"_5":13790,"_26439":55414,"_2811":56005},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3323":2799,"_29044":2560,"_20168":56007,"_5":13790,"_26439":55414,"_2811":56008},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3323":2800,"_29044":2560,"_20168":56010,"_5":13790,"_26439":55414,"_2811":56011},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3323":2801,"_29044":2560,"_20168":56013,"_5":13790,"_26439":55414,"_2811":56014},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3323":2802,"_29044":2560,"_20168":56016,"_5":13790,"_26439":55418,"_2811":56017},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3323":2803,"_29044":2560,"_20168":56019,"_5":13790,"_26439":55418,"_2811":56020},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3323":2804,"_29044":2560,"_20168":56022,"_5":13790,"_26439":55418,"_2811":56023},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3323":2805,"_29044":2560,"_20168":56025,"_5":13790,"_26439":55418,"_2811":56026},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3323":2806,"_29044":2560,"_20168":56028,"_5":13790,"_26439":55418,"_2811":56029},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_56032":56033,"_56034":56035,"_56036":56037,"_56038":56039,"_17447":2833,"_67221":2833},"language","english","sortableProperties",[2811,29044,5,26439],"sortablePropertiesWithTypes",{"_2811":24081,"_29044":24081,"_5":24081,"_26439":24081},"sorts",{"_2811":56040,"_29044":58836,"_5":61631,"_26439":64426},{"_4465":56041,"_56042":56043,"_5":24081},{"_13872":3103,"_14248":3625,"_14267":4532,"_12437":3157,"_14254":4555,"_19144":5886,"_13893":4553,"_13900":15381,"_28026":3209,"_28434":12825,"_28455":13668,"_28060":3018,"_33277":4527,"_28162":13764,"_28499":4802,"_33284":14345,"_33287":24091,"_33290":2950,"_33293":3838,"_28876":8906,"_33298":5486,"_33300":4921,"_28906":3096,"_14263":17521,"_33304":4949,"_33307":3618,"_33309":4595,"_28483":3207,"_28871":10052,"_28919":4226,"_33314":3797,"_33316":5317,"_33318":3623,"_28179":2910,"_33321":24093,"_33323":7213,"_33325":4436,"_33327":3513,"_33329":5806,"_28096":5179,"_33332":6680,"_33334":11597,"_28090":7260,"_28520":6868,"_33338":5565,"_29103":7127,"_33342":2905,"_28136":2891,"_33346":11747,"_28017":6275,"_33349":8991,"_28065":5734,"_33352":7149,"_33354":3188,"_33357":16108,"_14257":15516,"_33360":8171,"_33362":5345,"_33365":6656,"_33367":3974,"_33369":5750,"_33371":16454,"_33373":6677,"_19147":6702,"_33376":19593,"_33378":4048,"_28038":4198,"_28477":3547,"_33382":11633,"_33384":5776,"_33386":7138,"_28936":7450,"_33389":14028,"_33391":6870,"_33393":4277,"_29040":10918,"_28536":6719,"_33397":13769,"_33399":7136,"_28075":7337,"_33402":4606,"_33404":3856,"_33406":6724,"_28952":5708,"_28156":3107,"_27496":2924,"_33411":4769,"_33413":21151,"_33415":3875,"_28205":22753,"_33419":3139,"_28471":12399,"_33423":11146,"_33425":4156,"_33427":4561,"_33429":16041,"_33431":4928,"_33433":11144,"_28194":5693,"_28439":23506,"_33437":6394,"_33439":7284,"_33441":8966,"_33444":3258,"_33446":4147,"_33448":4759,"_33450":2993,"_33452":3070,"_33454":5680,"_33456":9816,"_33459":24084,"_33461":10050,"_33463":4932,"_33465":7999,"_33467":18708,"_33470":2878,"_33472":7269,"_33475":3639,"_33478":11683,"_33480":4960,"_33482":4093,"_33484":21988,"_33486":3819,"_33488":47289,"_33490":10365,"_33492":4754,"_33494":7231,"_28482":4578,"_33497":5558,"_33499":4439,"_33501":4666,"_33503":7180,"_33505":16666,"_33507":19237,"_33509":4755,"_33511":9438,"_33513":4432,"_33515":7181,"_33517":7258,"_33519":5289,"_33521":3817,"_33523":7182,"_33525":8297,"_33527":3816,"_33529":6593,"_33531":24087,"_33533":4491,"_33535":2849,"_33537":9190,"_33539":6591,"_33541":6580,"_33543":3851,"