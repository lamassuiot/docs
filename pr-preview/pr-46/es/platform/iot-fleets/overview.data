-preview/pr-46/es/platform/iot-fleets/enrollment/dms",{"_61":250},"platform/iot-fleets/enrollment/dms.mdx",{"_36":252,"_43":54,"_38":253,"_48":254,"_57":-7,"_12":255,"_59":256},"es:platform/iot-fleets/enrollment/bootstrap-identity.mdx","Identidad inicial y autenticación","Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.","/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/bootstrap-identity",{"_61":257},"platform/iot-fleets/enrollment/bootstrap-identity.mdx",{"_36":259,"_43":54,"_38":260,"_48":261,"_57":-7,"_12":262,"_59":263},"es:platform/iot-fleets/enrollment/est-client.mdx","Integra el cliente EST","Prepara la confianza, envía una CSR y comprueba la identidad recibida.","/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/est-client",{"_61":264},"platform/iot-fleets/enrollment/est-client.mdx",{"_36":266,"_43":54,"_38":267,"_48":268,"_57":-7,"_12":269,"_59":270},"es:platform/iot-fleets/enrollment/renewal-and-recovery.mdx","Renovación y recuperación","Renueva sin perder la identidad y recupera dispositivos según su estado real.","/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/renewal-and-recovery",{"_61":271},"platform/iot-fleets/enrollment/renewal-and-recovery.mdx",{"_36":273,"_43":54,"_38":274,"_48":275,"_57":-7,"_12":276,"_59":277},"es:platform/iot-fleets/enrollment/trust-distribution.mdx","Distribución y actualización de confianza","Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.","/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/trust-distribution",{"_61":278},"platform/iot-fleets/enrollment/trust-distribution.mdx",{"_36":280,"_43":54,"_38":281,"_48":282,"_57":-7,"_12":283,"_59":284},"es:platform/iot-fleets/enrollment/est-reference.mdx","Referencia EST","Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.","/docs/pr-preview/pr-46/es/platform/iot-fleets/enrollment/est-reference",{"_61":285},"platform/iot-fleets/enrollment/est-reference.mdx"