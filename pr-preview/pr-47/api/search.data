301,"_35112":108304,"_35114":108307,"_35116":108310,"_35118":108313,"_35120":108316,"_35122":108318,"_35124":108321,"_35126":108323,"_35128":108325,"_35130":108327,"_35132":108329,"_35134":108331,"_35136":108333,"_35138":108336,"_35140":108339,"_35142":108342,"_35144":108345,"_35146":108348,"_35148":108351,"_35150":108354,"_35152":108357,"_35154":108360,"_35156":108363,"_35158":108366,"_35160":108369,"_35163":108372,"_35165":108375,"_35167":108378,"_35169":108381,"_35171":108384,"_35173":108387,"_35175":108390,"_35177":108393,"_35179":108396,"_35181":108399,"_35183":108402,"_35185":108405,"_35187":108408,"_35189":108411,"_35191":108414,"_35193":108417,"_35195":108420,"_35197":108423,"_35199":108426,"_35201":108429,"_35203":108432,"_35205":108435,"_35207":108438,"_35209":108441,"_35211":108444,"_35213":108447,"_35215":108450,"_35217":108453,"_35219":108456,"_35221":108459,"_35223":108462,"_35225":108465,"_35227":108468,"_35229":108471,"_35231":108474,"_35233":108477,"_35235":108480,"_35237":108483,"_35239":108486,"_35241":108489,"_35243":108492,"_35245":108494,"_35247":108497},{"_3023":60802,"_26291":60802,"_5":12871,"_2529":100804,"_26635":100805,"_18309":100808,"_24913":60802},"Despliega desde AWS Marketplace",[42855,100806,100807],"Despliegue","Otros modelos",[],{"_3023":60803,"_26291":60802,"_18309":100810,"_5":12556,"_24913":60802,"_2529":100811},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3023":60804,"_26291":60802,"_5":26632,"_18309":100813,"_24913":100814,"_2529":100815},[],"/docs/pr-preview/pr-47/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3023":60805,"_26291":60802,"_5":26632,"_18309":100817,"_24913":100818,"_2529":100819},[],"/docs/pr-preview/pr-47/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3023":60806,"_26291":60802,"_5":26632,"_18309":100821,"_24913":100822,"_2529":100823},[],"/docs/pr-preview/pr-47/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3023":60807,"_26291":60802,"_5":26632,"_18309":100825,"_24913":100826,"_2529":100827},[],"/docs/pr-preview/pr-47/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3023":60808,"_26291":60802,"_5":26632,"_18309":100829,"_24913":100830,"_2529":100831},[],"/docs/pr-preview/pr-47/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3023":60809,"_26291":60802,"_5":26632,"_18309":100833,"_24913":100834,"_2529":100835},[],"/docs/pr-preview/pr-47/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3023":60810,"_26291":60802,"_5":26632,"_18309":100837,"_24913":100838,"_2529":100839},[],"/docs/pr-preview/pr-47/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3023":60811,"_26291":60802,"_18309":100841,"_5":12556,"_24913":60802,"_2529":100842},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3023":60812,"_26291":60802,"_18309":100844,"_5":12556,"_24913":100814,"_2529":100845},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3023":60813,"_26291":60802,"_18309":100847,"_5":12556,"_24913":100814,"_2529":100848},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3023":60814,"_26291":60802,"_18309":100850,"_5":12556,"_24913":100814,"_2529":100851},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3023":60815,"_26291":60802,"_18309":100853,"_5":12556,"_24913":100818,"_2529":100854},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3023":60816,"_26291":60802,"_18309":100856,"_5":12556,"_24913":100818,"_2529":100857},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3023":60817,"_26291":60802,"_18309":100859,"_5":12556,"_24913":100818,"_2529":100860},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3023":60818,"_26291":60802,"_18309":100862,"_5":12556,"_24913":100822,"_2529":100863},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3023":60819,"_26291":60802,"_18309":100865,"_5":12556,"_24913":100826,"_2529":100866},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3023":60820,"_26291":60802,"_18309":100868,"_5":12556,"_24913":100830,"_2529":100869},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3023":60821,"_26291":60802,"_18309":100871,"_5":12556,"_24913":100834,"_2529":100872},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3023":60822,"_26291":60802,"_18309":100874,"_5":12556,"_24913":100838,"_2529":100875},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3023":60823,"_26291":60823,"_5":12871,"_2529":100877,"_26635":100878,"_18309":100879,"_24913":60823},"Despliega Lamassu",[42855,100806],[],{"_3023":60824,"_26291":60823,"_18309":100881,"_5":12556,"_24913":60823,"_2529":100882},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3023":60825,"_26291":60823,"_5":26632,"_18309":100884,"_24913":100885,"_2529":100886},[],"/docs/pr-preview/pr-47/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3023":60826,"_26291":60823,"_5":26632,"_18309":100888,"_24913":100889,"_2529":100890},[],"/docs/pr-preview/pr-47/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3023":60827,"_26291":60823,"_5":26632,"_18309":100892,"_24913":100893,"_2529":100894},[],"/docs/pr-preview/pr-47/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3023":60828,"_26291":60823,"_18309":100896,"_5":12556,"_24913":60823,"_2529":100897},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3023":60829,"_26291":60823,"_18309":100899,"_5":12556,"_24913":100885,"_2529":100900},[],"Modelo",{"_3023":60830,"_26291":60823,"_18309":100902,"_5":12556,"_24913":100885,"_2529":100903},[],"Recomendado para",{"_3023":60831,"_26291":60823,"_18309":100905,"_5":12556,"_24913":100885,"_2529":100906},[],"Quién opera la infraestructura",{"_3023":60832,"_26291":60823,"_18309":100908,"_5":12556,"_24913":100885,"_2529":100909},[],"Punto de partida",{"_3023":60833,"_26291":60823,"_18309":100911,"_5":12556,"_24913":100885,"_2529":42962},[],{"_3023":60834,"_26291":60823,"_18309":100913,"_5":12556,"_24913":100885,"_2529":100914},[],"Producción, entornos regulados y despliegues personalizados",{"_3023":60835,"_26291":60823,"_18309":100916,"_5":12556,"_24913":100885,"_2529":100917},[],"Tu equipo",{"_3023":60836,"_26291":60823,"_18309":100919,"_5":12556,"_24913":100885,"_2529":100920},[],"Helm o Fastlane",{"_3023":60837,"_26291":60823,"_18309":100922,"_5":12556,"_24913":100885,"_2529":42974},[],{"_3023":60838,"_26291":60823,"_18309":100924,"_5":12556,"_24913":100885,"_2529":100925},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3023":60839,"_26291":60823,"_18309":100927,"_5":12556,"_24913":100885,"_2529":100917},[],{"_3023":60840,"_26291":60823,"_18309":100929,"_5":12556,"_24913":100885,"_2529":100930},[],"Imagen preconfigurada en EC2",{"_3023":60841,"_26291":60823,"_18309":100932,"_5":12556,"_24913":100885,"_2529":42985},[],{"_3023":60842,"_26291":60823,"_18309":100934,"_5":12556,"_24913":100885,"_2529":100935},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3023":60843,"_26291":60823,"_18309":100937,"_5":12556,"_24913":100885,"_2529":42991},[],{"_3023":60844,"_26291":60823,"_18309":100939,"_5":12556,"_24913":100885,"_2529":100940},[],"Suscripción gestionada",{"_3023":60845,"_26291":60823,"_18309":100942,"_5":12556,"_24913":100885,"_2529":100943},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3023":60846,"_26291":60823,"_18309":100945,"_5":12556,"_24913":100885,"_2529":100946},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3023":60847,"_26291":60823,"_18309":100948,"_5":12556,"_24913":100885,"_2529":100949},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3023":60848,"_26291":60823,"_18309":100951,"_5":12556,"_24913":100889,"_2529":100952},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3023":60849,"_26291":60823,"_18309":100954,"_5":12556,"_24913":100893,"_2529":100955},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3023":60850,"_26291":60850,"_5":12871,"_2529":100957,"_26635":100958,"_18309":100959,"_24913":60850},"Utiliza Lamassu como SaaS",[42855,100806,100807],[],{"_3023":60851,"_26291":60850,"_18309":100961,"_5":12556,"_24913":60850,"_2529":100962},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3023":60852,"_26291":60850,"_5":26632,"_18309":100964,"_24913":100965,"_2529":100966},[],"/docs/pr-preview/pr-47/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3023":60853,"_26291":60850,"_5":26632,"_18309":100968,"_24913":100969,"_2529":100970},[],"/docs/pr-preview/pr-47/es/deployment/saas#planes","Planes",{"_3023":60854,"_26291":60850,"_5":26632,"_18309":100972,"_24913":100973,"_2529":100974},[],"/docs/pr-preview/pr-47/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3023":60855,"_26291":60850,"_18309":100976,"_5":12556,"_24913":60850,"_2529":100977},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3023":60856,"_26291":60850,"_18309":100979,"_5":12556,"_24913":100965,"_2529":100980},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3023":60857,"_26291":60850,"_18309":100982,"_5":12556,"_24913":100965,"_2529":100983},[],"Copias de seguridad automáticas.",{"_3023":60858,"_26291":60850,"_18309":100985,"_5":12556,"_24913":100965,"_2529":100986},[],"Actualizaciones de versión.",{"_3023":60859,"_26291":60850,"_18309":100988,"_5":12556,"_24913":100965,"_2529":100989},[],"Soporte técnico y SLA según el plan contratado.",{"_3023":60860,"_26291":60850,"_18309":100991,"_5":12556,"_24913":100969,"_2529":43046},[],{"_3023":60861,"_26291":60850,"_18309":100993,"_5":12556,"_24913":100969,"_2529":100994},[],"Dispositivos",{"_3023":60862,"_26291":60850,"_18309":100996,"_5":12556,"_24913":100969,"_2529":100997},[],"Soporte",{"_3023":60863,"_26291":60850,"_18309":100999,"_5":12556,"_24913":100969,"_2529":43055},[],{"_3023":60864,"_26291":60850,"_18309":101001,"_5":12556,"_24913":100969,"_2529":43058},[],{"_3023":60865,"_26291":60850,"_18309":101003,"_5":12556,"_24913":100969,"_2529":101004},[],"Hasta 1.000",{"_3023":60866,"_26291":60850,"_18309":101006,"_5":12556,"_24913":100969,"_2529":43064},[],{"_3023":60867,"_26291":60850,"_18309":101008,"_5":12556,"_24913":100969,"_2529":101009},[],"99,5 %",{"_3023":60868,"_26291":60850,"_18309":101011,"_5":12556,"_24913":100969,"_2529":43070},[],{"_3023":60869,"_26291":60850,"_18309":101013,"_5":12556,"_24913":100969,"_2529":101014},[],"Hasta 10.000",{"_3023":60870,"_26291":60850,"_18309":101016,"_5":12556,"_24913":100969,"_2529":101017},[],"Email y chat",{"_3023":60871,"_26291":60850,"_18309":101019,"_5":12556,"_24913":100969,"_2529":101020},[],"99,9 %",{"_3023":60872,"_26291":60850,"_18309":101022,"_5":12556,"_24913":100969,"_2529":43082},[],{"_3023":60873,"_26291":60850,"_18309":101024,"_5":12556,"_24913":100969,"_2529":101025},[],"Ilimitados",{"_3023":60874,"_26291":60850,"_18309":101027,"_5":12556,"_24913":100969,"_2529":101028},[],"Dedicado",{"_3023":60875,"_26291":60850,"_18309":101030,"_5":12556,"_24913":100969,"_2529":101031},[],"99,99 %",{"_3023":60876,"_26291":60850,"_18309":101033,"_5":12556,"_24913":100973,"_2529":101034},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3023":60877,"_26291":60850,"_18309":101036,"_5":12556,"_24913":100973,"_2529":101037},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3023":60878,"_26291":60878,"_5":12871,"_2529":43099,"_26635":101039,"_18309":101041,"_24913":60878},[42855,100806,101040],"Kubernetes autogestionado",[],{"_3023":60879,"_26291":60878,"_18309":101043,"_5":12556,"_24913":60878,"_2529":101044},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3023":60880,"_26291":60878,"_5":26632,"_18309":101046,"_24913":101047,"_2529":101048},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3023":60881,"_26291":60878,"_5":26632,"_18309":101050,"_24913":101051,"_2529":101052},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3023":60882,"_26291":60878,"_5":26632,"_18309":101054,"_24913":101055,"_2529":101056},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3023":60883,"_26291":60878,"_5":26632,"_18309":101058,"_24913":101059,"_2529":101060},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3023":60884,"_26291":60878,"_5":26632,"_18309":101062,"_24913":101063,"_2529":101064},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3023":60885,"_26291":60878,"_5":26632,"_18309":101066,"_24913":101067,"_2529":101068},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3023":60886,"_26291":60878,"_5":26632,"_18309":101070,"_24913":101071,"_2529":101072},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3023":60887,"_26291":60878,"_5":26632,"_18309":101074,"_24913":101075,"_2529":101076},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3023":60888,"_26291":60878,"_5":26632,"_18309":101078,"_24913":101079,"_2529":101080},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3023":60889,"_26291":60878,"_5":26632,"_18309":101082,"_24913":101083,"_2529":101084},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3023":60890,"_26291":60878,"_18309":101086,"_5":12556,"_24913":101047,"_2529":101087},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3023":60891,"_26291":60878,"_18309":101089,"_5":12556,"_24913":101047,"_2529":101090},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3023":60892,"_26291":60878,"_18309":101092,"_5":12556,"_24913":101051,"_2529":101093},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3023":60893,"_26291":60878,"_18309":101095,"_5":12556,"_24913":101051,"_2529":101096},[],"Fastlane instala o configura",{"_3023":60894,"_26291":60878,"_18309":101098,"_5":12556,"_24913":101051,"_2529":101099},[],"Tú sigues proporcionando",{"_3023":60895,"_26291":60878,"_18309":101101,"_5":12556,"_24913":101051,"_2529":101102},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3023":60896,"_26291":60878,"_18309":101104,"_5":12556,"_24913":101051,"_2529":101105},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3023":60897,"_26291":60878,"_18309":101107,"_5":12556,"_24913":101051,"_2529":101108},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3023":60898,"_26291":60878,"_18309":101110,"_5":12556,"_24913":101051,"_2529":101111},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3023":60899,"_26291":60878,"_18309":101113,"_5":12556,"_24913":101051,"_2529":101114},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3023":60900,"_26291":60878,"_18309":101116,"_5":12556,"_24913":101051,"_2529":101117},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3023":60901,"_26291":60878,"_18309":101119,"_5":12556,"_24913":101051,"_2529":101120},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3023":60902,"_26291":60878,"_18309":101122,"_5":12556,"_24913":101051,"_2529":101123},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3023":60903,"_26291":60878,"_18309":101125,"_5":12556,"_24913":101051,"_2529":101126},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3023":60904,"_26291":60878,"_18309":101128,"_5":12556,"_24913":101055,"_2529":101129},[],"Necesitas:",{"_3023":60905,"_26291":60878,"_18309":101131,"_5":12556,"_24913":101055,"_2529":101132},[],"un clúster Kubernetes existente",{"_3023":60906,"_26291":60878,"_18309":101134,"_5":12556,"_24913":101055,"_2529":101135},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3023":60907,"_26291":60878,"_18309":101137,"_5":12556,"_24913":101055,"_2529":43197},[],{"_3023":60908,"_26291":60878,"_18309":101139,"_5":12556,"_24913":101055,"_2529":20755},[],{"_3023":60909,"_26291":60878,"_18309":101141,"_5":12556,"_24913":101055,"_2529":101142},[],"`jq` solo si usas `--sample-data`",{"_3023":60910,"_26291":60878,"_18309":101144,"_5":12556,"_24913":101055,"_2529":101145},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3023":60911,"_26291":60878,"_18309":101147,"_5":12556,"_24913":101055,"_2529":101148},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3023":60912,"_26291":60878,"_18309":101150,"_5":12556,"_24913":101055,"_2529":101151},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3023":60913,"_26291":60878,"_18309":101153,"_5":12556,"_24913":101059,"_2529":101154},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3023":60914,"_26291":60878,"_18309":101156,"_5":12556,"_24913":101059,"_2529":101157},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3023":60915,"_26291":60878,"_18309":101159,"_5":12556,"_24913":101063,"_2529":101160},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3023":60916,"_26291":60878,"_18309":101162,"_5":12556,"_24913":101063,"_2529":101163},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3023":60917,"_26291":60878,"_18309":101165,"_5":12556,"_24913":101063,"_2529":101166},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3023":60918,"_26291":60878,"_18309":101168,"_5":12556,"_24913":101063,"_2529":101169},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3023":60919,"_26291":60878,"_18309":101171,"_5":12556,"_24913":101067,"_2529":101172},[],"Opción",{"_3023":60920,"_26291":60878,"_18309":101174,"_5":12556,"_24913":101067,"_2529":101175},[],"Valor predeterminado",{"_3023":60921,"_26291":60878,"_18309":101177,"_5":12556,"_24913":101067,"_2529":101178},[],"Propósito",{"_3023":60922,"_26291":60878,"_18309":101180,"_5":12556,"_24913":101067,"_2529":43241},[],{"_3023":60923,"_26291":60878,"_18309":101182,"_5":12556,"_24913":101067,"_2529":43244},[],{"_3023":60924,"_26291":60878,"_18309":101184,"_5":12556,"_24913":101067,"_2529":101185},[],"Muestra la ayuda",{"_3023":60925,"_26291":60878,"_18309":101187,"_5":12556,"_24913":101067,"_2529":43250},[],{"_3023":60926,"_26291":60878,"_18309":101189,"_5":12556,"_24913":101067,"_2529":101190},[],"contexto actual",{"_3023":60927,"_26291":60878,"_18309":101192,"_5":12556,"_24913":101067,"_2529":101193},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3023":60928,"_26291":60878,"_18309":101195,"_5":12556,"_24913":101067,"_2529":43259},[],{"_3023":60929,"_26291":60878,"_18309":101197,"_5":12556,"_24913":101067,"_2529":5662},[],{"_3023":60930,"_26291":60878,"_18309":101199,"_5":12556,"_24913":101067,"_2529":101200},[],"Omite prompts y genera credenciales para las dependencias",{"_3023":60931,"_26291":60878,"_18309":101202,"_5":12556,"_24913":101067,"_2529":43267},[],{"_3023":60932,"_26291":60878,"_18309":101204,"_5":12556,"_24913":101067,"_2529":43270},[],{"_3023":60933,"_26291":60878,"_18309":101206,"_5":12556,"_24913":101067,"_2529":101207},[],"Namespace de la instalación",{"_3023":60934,"_26291":60878,"_18309":101209,"_5":12556,"_24913":101067,"_2529":43276},[],{"_3023":60935,"_26291":60878,"_18309":101211,"_5":12556,"_24913":101067,"_2529":43279},[],{"_3023":60936,"_26291":60878,"_18309":101213,"_5":12556,"_24913":101067,"_2529":101214},[],"Dominio usado por la UI, OIDC y el certificado",{"_3023":60937,"_26291":60878,"_18309":101216,"_5":12556,"_24913":101067,"_2529":43285},[],{"_3023":60938,"_26291":60878,"_18309":101218,"_5":12556,"_24913":101067,"_2529":13101},[],{"_3023":60939,"_26291":60878,"_18309":101220,"_5":12556,"_24913":101067,"_2529":101221},[],"Versión del chart de Lamassu",{"_3023":60940,"_26291":60878,"_18309":101223,"_5":12556,"_24913":101067,"_2529":43293},[],{"_3023":60941,"_26291":60878,"_18309":101225,"_5":12556,"_24913":101067,"_2529":43296},[],{"_3023":60942,"_26291":60878,"_18309":101227,"_5":12556,"_24913":101067,"_2529":101228},[],"Puerto del listener HTTPS",{"_3023":60943,"_26291":60878,"_18309":101230,"_5":12556,"_24913":101067,"_2529":43302},[],{"_3023":60944,"_26291":60878,"_18309":101232,"_5":12556,"_24913":101067,"_2529":43305},[],{"_3023":60945,"_26291":60878,"_18309":101234,"_5":12556,"_24913":101067,"_2529":101235},[],"Puerto del listener HTTP",{"_3023":60946,"_26291":60878,"_18309":101237,"_5":12556,"_24913":101067,"_2529":43311},[],{"_3023":60947,"_26291":60878,"_18309":101239,"_5":12556,"_24913":101067,"_2529":43244},[],{"_3023":60948,"_26291":60878,"_18309":101241,"_5":12556,"_24913":101067,"_2529":101242},[],"Certificado PEM para TLS downstream",{"_3023":60949,"_26291":60878,"_18309":101244,"_5":12556,"_24913":101067,"_2529":43319},[],{"_3023":60950,"_26291":60878,"_18309":101246,"_5":12556,"_24913":101067,"_2529":43244},[],{"_3023":60951,"_26291":60878,"_18309":101248,"_5":12556,"_24913":101067,"_2529":101249},[],"Clave privada PEM para TLS downstream",{"_3023":60952,"_26291":60878,"_18309":101251,"_5":12556,"_24913":101067,"_2529":43327},[],{"_3023":60953,"_26291":60878,"_18309":101253,"_5":12556,"_24913":101067,"_2529":101254},[],"chart del repositorio",{"_3023":60954,"_26291":60878,"_18309":101256,"_5":12556,"_24913":101067,"_2529":101257},[],"Usa un chart local de Lamassu sin empaquetar",{"_3023":60955,"_26291":60878,"_18309":101259,"_5":12556,"_24913":101067,"_2529":43336},[],{"_3023":60956,"_26291":60878,"_18309":101261,"_5":12556,"_24913":101067,"_2529":101262},[],"detección automática",{"_3023":60957,"_26291":60878,"_18309":101264,"_5":12556,"_24913":101067,"_2529":101265},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3023":60958,"_26291":60878,"_18309":101267,"_5":12556,"_24913":101067,"_2529":43344},[],{"_3023":60959,"_26291":60878,"_18309":101269,"_5":12556,"_24913":101067,"_2529":5662},[],{"_3023":60960,"_26291":60878,"_18309":101271,"_5":12556,"_24913":101067,"_2529":101272},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3023":60961,"_26291":60878,"_18309":101274,"_5":12556,"_24913":101067,"_2529":43352},[],{"_3023":60962,"_26291":60878,"_18309":101276,"_5":12556,"_24913":101067,"_2529":5662},[],{"_3023":60963,"_26291":60878,"_18309":101278,"_5":12556,"_24913":101067,"_2529":101279},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3023":60964,"_26291":60878,"_18309":101281,"_5":12556,"_24913":101067,"_2529":43360},[],{"_3023":60965,"_26291":60878,"_18309":101283,"_5":12556,"_24913":101067,"_2529":5662},[],{"_3023":60966,"_26291":60878,"_18309":101285,"_5":12556,"_24913":101067,"_2529":101286},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3023":60967,"_26291":60878,"_18309":101288,"_5":12556,"_24913":101067,"_2529":43368},[],{"_3023":60968,"_26291":60878,"_18309":101290,"_5":12556,"_24913":101067,"_2529":43371},[],{"_3023":60969,"_26291":60878,"_18309":101292,"_5":12556,"_24913":101067,"_2529":101293},[],"Usa otro chart local de SoftHSM",{"_3023":60970,"_26291":60878,"_18309":101295,"_5":12556,"_24913":101067,"_2529":101296},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3023":60971,"_26291":60878,"_18309":101298,"_5":12556,"_24913":101071,"_2529":43380},[],{"_3023":60972,"_26291":60878,"_18309":101300,"_5":12556,"_24913":101071,"_2529":101301},[],"valida las herramientas locales y el clúster seleccionado",{"_3023":60973,"_26291":60878,"_18309":101303,"_5":12556,"_24913":101071,"_2529":101304},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3023":60974,"_26291":60878,"_18309":101306,"_5":12556,"_24913":101071,"_2529":101307},[],"crea el namespace",{"_3023":60975,"_26291":60878,"_18309":101309,"_5":12556,"_24913":101071,"_2529":101310},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3023":60976,"_26291":60878,"_18309":101312,"_5":12556,"_24913":101071,"_2529":101313},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3023":60977,"_26291":60878,"_18309":101315,"_5":12556,"_24913":101071,"_2529":101316},[],"instala RabbitMQ",{"_3023":60978,"_26291":60878,"_18309":101318,"_5":12556,"_24913":101071,"_2529":101319},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3023":60979,"_26291":60878,"_18309":101321,"_5":12556,"_24913":101071,"_2529":101322},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3023":60980,"_26291":60878,"_18309":101324,"_5":12556,"_24913":101071,"_2529":101325},[],"carga datos de ejemplo opcionalmente",{"_3023":60981,"_26291":60878,"_18309":101327,"_5":12556,"_24913":101071,"_2529":101328},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3023":60982,"_26291":60878,"_18309":101330,"_5":12556,"_24913":101075,"_2529":101331},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3023":60983,"_26291":60878,"_18309":101333,"_5":12556,"_24913":101075,"_2529":101334},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3023":60984,"_26291":60878,"_18309":101336,"_5":12556,"_24913":101079,"_2529":101337},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso.",{"_3023":60985,"_26291":60878,"_18309":101339,"_5":12556,"_24913":101079,"_2529":101340},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3023":60986,"_26291":60878,"_18309":101342,"_5":12556,"_24913":101079,"_2529":101343},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3023":60987,"_26291":60878,"_18309":101345,"_5":12556,"_24913":101083,"_2529":101346},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3023":60988,"_26291":60988,"_5":12871,"_2529":101348,"_26635":101349,"_18309":101350,"_24913":60988},"Instala con Helm",[42855,100806,101040],[],{"_3023":60989,"_26291":60988,"_18309":101352,"_5":12556,"_24913":60988,"_2529":101353},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3023":60990,"_26291":60988,"_5":26632,"_18309":101355,"_24913":101356,"_2529":101357},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3023":60991,"_26291":60988,"_5":26632,"_18309":101359,"_24913":101360,"_2529":101056},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3023":60992,"_26291":60988,"_5":26632,"_18309":101362,"_24913":101363,"_2529":101364},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3023":60993,"_26291":60988,"_5":26632,"_18309":101366,"_24913":101367,"_2529":101368},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3023":60994,"_26291":60988,"_5":26632,"_18309":101370,"_24913":101371,"_2529":101372},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3023":60995,"_26291":60988,"_5":26632,"_18309":101374,"_24913":101375,"_2529":101376},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3023":60996,"_26291":60988,"_5":26632,"_18309":101378,"_24913":101379,"_2529":101380},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3023":60997,"_26291":60988,"_5":26632,"_18309":101382,"_24913":101383,"_2529":101384},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3023":60998,"_26291":60988,"_5":26632,"_18309":101386,"_24913":101387,"_2529":101388},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3023":60999,"_26291":60988,"_18309":101390,"_5":12556,"_24913":101356,"_2529":101391},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3023":61000,"_26291":60988,"_18309":101393,"_5":12556,"_24913":101360,"_2529":101394},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3023":61001,"_26291":60988,"_18309":101396,"_5":12556,"_24913":101360,"_2529":101397},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3023":61002,"_26291":60988,"_18309":101399,"_5":12556,"_24913":101360,"_2529":101400},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3023":61003,"_26291":60988,"_18309":101402,"_5":12556,"_24913":101360,"_2529":101403},[],"un broker RabbitMQ accesible y sus credenciales",{"_3023":61004,"_26291":60988,"_18309":101405,"_5":12556,"_24913":101360,"_2529":101406},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3023":61005,"_26291":60988,"_18309":101408,"_5":12556,"_24913":101360,"_2529":101409},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3023":61006,"_26291":60988,"_18309":101411,"_5":12556,"_24913":101360,"_2529":101412},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3023":61007,"_26291":60988,"_18309":101414,"_5":12556,"_24913":101360,"_2529":101415},[],"una StorageClass y un diseño de tráfico externo",{"_3023":61008,"_26291":60988,"_18309":101417,"_5":12556,"_24913":101360,"_2529":101418},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3023":61009,"_26291":60988,"_18309":101420,"_5":12556,"_24913":101360,"_2529":101421},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3023":61010,"_26291":60988,"_18309":101423,"_5":12556,"_24913":101360,"_2529":101424},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3023":61011,"_26291":60988,"_18309":101426,"_5":12556,"_24913":101363,"_2529":101427},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3023":61012,"_26291":60988,"_18309":101429,"_5":12556,"_24913":101363,"_2529":101430},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3023":61013,"_26291":60988,"_18309":101432,"_5":12556,"_24913":101363,"_2529":101433},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_3023":61014,"_26291":60988,"_18309":101435,"_5":12556,"_24913":101367,"_2529":101436},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3023":61015,"_26291":60988,"_18309":101438,"_5":12556,"_24913":101367,"_2529":101439},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3023":61016,"_26291":60988,"_18309":101441,"_5":12556,"_24913":101367,"_2529":101442},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3023":61017,"_26291":60988,"_18309":101444,"_5":12556,"_24913":101371,"_2529":101445},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_3023":61018,"_26291":60988,"_18309":101447,"_5":12556,"_24913":101375,"_2529":101448},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3023":61019,"_26291":60988,"_18309":101450,"_5":12556,"_24913":101375,"_2529":101451},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3023":61020,"_26291":60988,"_18309":101453,"_5":12556,"_24913":101375,"_2529":101454},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3023":61021,"_26291":60988,"_18309":101456,"_5":12556,"_24913":101375,"_2529":101457},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3023":61022,"_26291":60988,"_18309":101459,"_5":12556,"_24913":101379,"_2529":101460},[],"Para instalar un checkout local:",{"_3023":61023,"_26291":60988,"_18309":101462,"_5":12556,"_24913":101383,"_2529":101463},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3023":61024,"_26291":60988,"_18309":101465,"_5":12556,"_24913":101383,"_2529":101466},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3023":61025,"_26291":60988,"_18309":101468,"_5":12556,"_24913":101387,"_2529":101469},[],"Antes de pasar a producción, revisa:",{"_3023":61026,"_26291":60988,"_18309":101471,"_5":12556,"_24913":101387,"_2529":101472},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3023":61027,"_26291":60988,"_18309":101474,"_5":12556,"_24913":101387,"_2529":101475},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3023":61028,"_26291":60988,"_18309":101477,"_5":12556,"_24913":101387,"_2529":101478},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3023":61029,"_26291":60988,"_18309":101480,"_5":12556,"_24913":101387,"_2529":101481},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3023":61030,"_26291":60988,"_18309":101483,"_5":12556,"_24913":101387,"_2529":101484},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3023":61031,"_26291":60988,"_18309":101486,"_5":12556,"_24913":101387,"_2529":101487},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3023":61032,"_26291":60988,"_18309":101489,"_5":12556,"_24913":101387,"_2529":101490},[],"SMTP, observabilidad y entrega de alertas",{"_3023":61033,"_26291":60988,"_18309":101492,"_5":12556,"_24913":101387,"_2529":101493},[],"las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_3023":61034,"_26291":60988,"_18309":101495,"_5":12556,"_24913":101387,"_2529":101496},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3023":61035,"_26291":61035,"_5":12871,"_2529":101498,"_26635":101499,"_18309":101500,"_24913":61035},"Expón el Gateway",[42855,100806,101040],[],{"_3023":61036,"_26291":61035,"_18309":101502,"_5":12556,"_24913":61035,"_2529":101503},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3023":61037,"_26291":61035,"_5":26632,"_18309":101505,"_24913":101506,"_2529":101507},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3023":61038,"_26291":61035,"_5":26632,"_18309":101509,"_24913":101510,"_2529":101511},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3023":61039,"_26291":61035,"_5":26632,"_18309":101513,"_24913":101514,"_2529":101515},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3023":61040,"_26291":61035,"_5":26632,"_18309":101517,"_24913":101518,"_2529":43601},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/networking#k3s",{"_3023":61041,"_26291":61035,"_5":26632,"_18309":101520,"_24913":101521,"_2529":101522},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3023":61042,"_26291":61035,"_5":26632,"_18309":101524,"_24913":101525,"_2529":101526},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3023":61043,"_26291":61035,"_5":26632,"_18309":101528,"_24913":101529,"_2529":101530},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3023":61044,"_26291":61035,"_5":26632,"_18309":101532,"_24913":101533,"_2529":101534},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3023":61045,"_26291":61035,"_5":26632,"_18309":101536,"_24913":101537,"_2529":101538},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3023":61046,"_26291":61035,"_18309":101540,"_5":12556,"_24913":101506,"_2529":101541},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3023":61047,"_26291":61035,"_18309":101543,"_5":12556,"_24913":101506,"_2529":101544},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3023":61048,"_26291":61035,"_18309":101546,"_5":12556,"_24913":101510,"_2529":101547},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3023":61049,"_26291":61035,"_18309":101549,"_5":12556,"_24913":101510,"_2529":101550},[],"Defínelo únicamente cuando:",{"_3023":61050,"_26291":61035,"_18309":101552,"_5":12556,"_24913":101510,"_2529":101553},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3023":61051,"_26291":61035,"_18309":101555,"_5":12556,"_24913":101510,"_2529":101556},[],"esa dirección está asignada a este Gateway",{"_3023":61052,"_26291":61035,"_18309":101558,"_5":12556,"_24913":101510,"_2529":101559},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3023":61053,"_26291":61035,"_18309":101561,"_5":12556,"_24913":101510,"_2529":101562},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3023":61054,"_26291":61035,"_18309":101564,"_5":12556,"_24913":101510,"_2529":101565},[],"No confundas estos valores:",{"_3023":61055,"_26291":61035,"_18309":101567,"_5":12556,"_24913":101510,"_2529":101568},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3023":61056,"_26291":61035,"_18309":101570,"_5":12556,"_24913":101510,"_2529":101571},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3023":61057,"_26291":61035,"_18309":101573,"_5":12556,"_24913":101510,"_2529":101574},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3023":61058,"_26291":61035,"_18309":101576,"_5":12556,"_24913":101514,"_2529":101577},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3023":61059,"_26291":61035,"_18309":101579,"_5":12556,"_24913":101514,"_2529":101580},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3023":61060,"_26291":61035,"_18309":101582,"_5":12556,"_24913":101518,"_2529":101583},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3023":61061,"_26291":61035,"_18309":101585,"_5":12556,"_24913":101518,"_2529":101586},[],"Para el diseño recomendado:",{"_3023":61062,"_26291":61035,"_18309":101588,"_5":12556,"_24913":101518,"_2529":101589},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3023":61063,"_26291":61035,"_18309":101591,"_5":12556,"_24913":101518,"_2529":101592},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3023":61064,"_26291":61035,"_18309":101594,"_5":12556,"_24913":101518,"_2529":101595},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3023":61065,"_26291":61035,"_18309":101597,"_5":12556,"_24913":101518,"_2529":101598},[],"Apunta DNS a la dirección accesible de la VM.",{"_3023":61066,"_26291":61035,"_18309":101600,"_5":12556,"_24913":101518,"_2529":101601},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3023":61067,"_26291":61035,"_18309":101603,"_5":12556,"_24913":101521,"_2529":101604},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3023":61068,"_26291":61035,"_18309":101606,"_5":12556,"_24913":101525,"_2529":101607},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3023":61069,"_26291":61035,"_18309":101609,"_5":12556,"_24913":101525,"_2529":101610},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3023":61070,"_26291":61035,"_18309":101612,"_5":12556,"_24913":101529,"_2529":101613},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3023":61071,"_26291":61035,"_18309":101615,"_5":12556,"_24913":101529,"_2529":101616},[],"Requisito",{"_3023":61072,"_26291":61035,"_18309":101618,"_5":12556,"_24913":101529,"_2529":101619},[],"Diseño recomendado",{"_3023":61073,"_26291":61035,"_18309":101621,"_5":12556,"_24913":101529,"_2529":101622},[],"Consecuencia",{"_3023":61074,"_26291":61035,"_18309":101624,"_5":12556,"_24913":101529,"_2529":101625},[],"Varias URL o servicios de Lamassu",{"_3023":61075,"_26291":61035,"_18309":101627,"_5":12556,"_24913":101529,"_2529":101628},[],"Un Gateway con varias rutas",{"_3023":61076,"_26291":61035,"_18309":101630,"_5":12556,"_24913":101529,"_2529":101631},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3023":61077,"_26291":61035,"_18309":101633,"_5":12556,"_24913":101529,"_2529":101634},[],"Gateways independientes e IP externas distintas",{"_3023":61078,"_26291":61035,"_18309":101636,"_5":12556,"_24913":101529,"_2529":101637},[],"Una VIP por Gateway",{"_3023":61079,"_26291":61035,"_18309":101639,"_5":12556,"_24913":101529,"_2529":101640},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3023":61080,"_26291":61035,"_18309":101642,"_5":12556,"_24913":101529,"_2529":101643},[],"Gateways independientes, un nodo y una IP",{"_3023":61081,"_26291":61035,"_18309":101645,"_5":12556,"_24913":101529,"_2529":101646},[],"Puertos externos diferentes",{"_3023":61082,"_26291":61035,"_18309":101648,"_5":12556,"_24913":101529,"_2529":101649},[],"Los clientes deben indicar puertos no estándar",{"_3023":61083,"_26291":61035,"_18309":101651,"_5":12556,"_24913":101529,"_2529":101652},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3023":61084,"_26291":61035,"_18309":101654,"_5":12556,"_24913":101529,"_2529":101655},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3023":61085,"_26291":61035,"_18309":101657,"_5":12556,"_24913":101529,"_2529":101658},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3023":61086,"_26291":61035,"_18309":101660,"_5":12556,"_24913":101529,"_2529":101661},[],"Recursos Gateway separados pero proxy compartido",{"_3023":61087,"_26291":61035,"_18309":101663,"_5":12556,"_24913":101529,"_2529":101664},[],"Modo merged Gateway de Envoy",{"_3023":61088,"_26291":61035,"_18309":101666,"_5":12556,"_24913":101529,"_2529":101667},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3023":61089,"_26291":61035,"_18309":101669,"_5":12556,"_24913":101529,"_2529":101670},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3023":61090,"_26291":61035,"_18309":101672,"_5":12556,"_24913":101529,"_2529":101673},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3023":61091,"_26291":61035,"_18309":101675,"_5":12556,"_24913":101529,"_2529":101676},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3023":61092,"_26291":61035,"_18309":101678,"_5":12556,"_24913":101529,"_2529":101679},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3023":61093,"_26291":61035,"_18309":101681,"_5":12556,"_24913":101533,"_2529":101682},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3023":61094,"_26291":61035,"_18309":101684,"_5":12556,"_24913":101533,"_2529":101685},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3023":61095,"_26291":61035,"_18309":101687,"_5":12556,"_24913":101533,"_2529":101688},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3023":61096,"_26291":61035,"_18309":101690,"_5":12556,"_24913":101533,"_2529":101691},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3023":61097,"_26291":61035,"_18309":101693,"_5":12556,"_24913":101533,"_2529":101694},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3023":61098,"_26291":61035,"_18309":101696,"_5":12556,"_24913":101537,"_2529":101697},[],"Comprueba, en orden:",{"_3023":61099,"_26291":61035,"_18309":101699,"_5":12556,"_24913":101537,"_2529":101700},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3023":61100,"_26291":61035,"_18309":101702,"_5":12556,"_24913":101537,"_2529":101703},[],"Su estado contiene la dirección esperada.",{"_3023":61101,"_26291":61035,"_18309":101705,"_5":12556,"_24913":101537,"_2529":101706},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3023":61102,"_26291":61035,"_18309":101708,"_5":12556,"_24913":101537,"_2529":101709},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3023":61103,"_26291":61035,"_18309":101711,"_5":12556,"_24913":101537,"_2529":101712},[],"DNS resuelve al endpoint accesible externamente.",{"_3023":61104,"_26291":61035,"_18309":101714,"_5":12556,"_24913":101537,"_2529":101715},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3023":61105,"_26291":61035,"_18309":101717,"_5":12556,"_24913":101537,"_2529":101718},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3023":61106,"_26291":61106,"_5":12871,"_2529":42962,"_26635":101720,"_18309":101721,"_24913":61106},[42855,100806,101040],[],{"_3023":61107,"_26291":61106,"_18309":101723,"_5":12556,"_24913":61106,"_2529":101724},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3023":61108,"_26291":61106,"_5":26632,"_18309":101726,"_24913":101727,"_2529":101728},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3023":61109,"_26291":61106,"_5":26632,"_18309":101730,"_24913":101731,"_2529":101732},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3023":61110,"_26291":61106,"_5":26632,"_18309":101734,"_24913":101735,"_2529":101736},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3023":61111,"_26291":61106,"_5":26632,"_18309":101738,"_24913":101739,"_2529":101740},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3023":61112,"_26291":61106,"_5":26632,"_18309":101742,"_24913":101743,"_2529":101744},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3023":61113,"_26291":61106,"_5":26632,"_18309":101746,"_24913":101747,"_2529":101748},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3023":61114,"_26291":61106,"_18309":101750,"_5":12556,"_24913":101727,"_2529":101751},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3023":61115,"_26291":61106,"_18309":101753,"_5":12556,"_24913":101731,"_2529":101754},[],"Flujo",{"_3023":61116,"_26291":61106,"_18309":101756,"_5":12556,"_24913":101731,"_2529":101757},[],"Úsalo para",{"_3023":61117,"_26291":61106,"_18309":101759,"_5":12556,"_24913":101731,"_2529":101760},[],"Qué instala",{"_3023":61118,"_26291":61106,"_18309":101762,"_5":12556,"_24913":101731,"_2529":43846},[],{"_3023":61119,"_26291":61106,"_18309":101764,"_5":12556,"_24913":101731,"_2529":101765},[],"Producción y entornos controlados",{"_3023":61120,"_26291":61106,"_18309":101767,"_5":12556,"_24913":101731,"_2529":101768},[],"Servicios de Lamassu y recursos de Gateway API",{"_3023":61121,"_26291":61106,"_18309":101770,"_5":12556,"_24913":101731,"_2529":43099},[],{"_3023":61122,"_26291":61106,"_18309":101772,"_5":12556,"_24913":101731,"_2529":101773},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3023":61123,"_26291":61106,"_18309":101775,"_5":12556,"_24913":101731,"_2529":101776},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3023":61124,"_26291":61106,"_18309":101778,"_5":12556,"_24913":101735,"_2529":101779},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3023":61125,"_26291":61106,"_18309":101781,"_5":12556,"_24913":101735,"_2529":101782},[],"Área",{"_3023":61126,"_26291":61106,"_18309":101784,"_5":12556,"_24913":101735,"_2529":101785},[],"El chart de Lamassu proporciona",{"_3023":61127,"_26291":61106,"_18309":101787,"_5":12556,"_24913":101735,"_2529":101788},[],"Tú proporcionas",{"_3023":61128,"_26291":61106,"_18309":101790,"_5":12556,"_24913":101735,"_2529":101791},[],"Aplicaciones Lamassu",{"_3023":61129,"_26291":61106,"_18309":101793,"_5":12556,"_24913":101735,"_2529":101794},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3023":61130,"_26291":61106,"_18309":101796,"_5":12556,"_24913":101735,"_2529":101797},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3023":61131,"_26291":61106,"_18309":101799,"_5":12556,"_24913":101735,"_2529":101800},[],"Datos PostgreSQL",{"_3023":61132,"_26291":61106,"_18309":101802,"_5":12556,"_24913":101735,"_2529":101803},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3023":61133,"_26291":61106,"_18309":101805,"_5":12556,"_24913":101735,"_2529":101806},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3023":61134,"_26291":61106,"_18309":101808,"_5":12556,"_24913":101735,"_2529":101809},[],"Mensajería",{"_3023":61135,"_26291":61106,"_18309":101811,"_5":12556,"_24913":101735,"_2529":101812},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_3023":61136,"_26291":61106,"_18309":101814,"_5":12556,"_24913":101735,"_2529":101815},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3023":61137,"_26291":61106,"_18309":101817,"_5":12556,"_24913":101735,"_2529":101818},[],"Identidad",{"_3023":61138,"_26291":61106,"_18309":101820,"_5":12556,"_24913":101735,"_2529":101821},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3023":61139,"_26291":61106,"_18309":101823,"_5":12556,"_24913":101735,"_2529":101824},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3023":61140,"_26291":61106,"_18309":101826,"_5":12556,"_24913":101735,"_2529":101827},[],"Enrutamiento externo",{"_3023":61141,"_26291":61106,"_18309":101829,"_5":12556,"_24913":101735,"_2529":101830},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3023":61142,"_26291":61106,"_18309":101832,"_5":12556,"_24913":101735,"_2529":101833},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3023":61143,"_26291":61106,"_18309":101835,"_5":12556,"_24913":101735,"_2529":43920},[],{"_3023":61144,"_26291":61106,"_18309":101837,"_5":12556,"_24913":101735,"_2529":101838},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_3023":61145,"_26291":61106,"_18309":101840,"_5":12556,"_24913":101735,"_2529":101841},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3023":61146,"_26291":61106,"_18309":101843,"_5":12556,"_24913":101735,"_2529":101844},[],"Datos persistentes de la aplicación",{"_3023":61147,"_26291":61106,"_18309":101846,"_5":12556,"_24913":101735,"_2529":101847},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3023":61148,"_26291":61106,"_18309":101849,"_5":12556,"_24913":101735,"_2529":101850},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3023":61149,"_26291":61106,"_18309":101852,"_5":12556,"_24913":101735,"_2529":101853},[],"Integraciones opcionales",{"_3023":61150,"_26291":61106,"_18309":101855,"_5":12556,"_24913":101735,"_2529":101856},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3023":61151,"_26291":61106,"_18309":101858,"_5":12556,"_24913":101735,"_2529":101859},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3023":61152,"_26291":61106,"_18309":101861,"_5":12556,"_24913":101735,"_2529":101862},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3023":61153,"_26291":61106,"_18309":101864,"_5":12556,"_24913":101735,"_2529":101865},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3023":61154,"_26291":61106,"_18309":101867,"_5":12556,"_24913":101739,"_2529":101868},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3023":61155,"_26291":61106,"_18309":101870,"_5":12556,"_24913":101739,"_2529":101871},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3023":61156,"_26291":61106,"_18309":101873,"_5":12556,"_24913":101743,"_2529":101874},[],"Kubernetes 1.24 o posterior",{"_3023":61157,"_26291":61106,"_18309":101876,"_5":12556,"_24913":101743,"_2529":101877},[],"Helm 3.2 o posterior",{"_3023":61158,"_26291":61106,"_18309":101879,"_5":12556,"_24913":101743,"_2529":101880},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3023":61159,"_26291":61106,"_18309":101882,"_5":12556,"_24913":101743,"_2529":101883},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_3023":61160,"_26291":61106,"_18309":101885,"_5":12556,"_24913":101743,"_2529":101886},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3023":61161,"_26291":61106,"_18309":101888,"_5":12556,"_24913":101743,"_2529":101889},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3023":61162,"_26291":61106,"_18309":101891,"_5":12556,"_24913":101743,"_2529":101892},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior.",{"_3023":61163,"_26291":61106,"_18309":101894,"_5":12556,"_24913":101747,"_2529":101895},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3023":61164,"_26291":61106,"_18309":101897,"_5":12556,"_24913":101747,"_2529":101898},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3023":61165,"_26291":61106,"_18309":101900,"_5":12556,"_24913":101747,"_2529":101901},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3023":61166,"_26291":61166,"_5":12871,"_2529":101903,"_26635":101904,"_18309":101906,"_24913":61166},"Resolución de problemas de despliegue",[42855,100806,101905],"Operación",[],{"_3023":61167,"_26291":61166,"_18309":101908,"_5":12556,"_24913":61166,"_2529":101909},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3023":61168,"_26291":61166,"_5":26632,"_18309":101911,"_24913":101912,"_2529":101913},[],"/docs/pr-preview/pr-47/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3023":61169,"_26291":61166,"_5":26632,"_18309":101915,"_24913":101916,"_2529":101917},[],"/docs/pr-preview/pr-47/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3023":61170,"_26291":61166,"_5":26632,"_18309":101919,"_24913":101920,"_2529":101921},[],"/docs/pr-preview/pr-47/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3023":61171,"_26291":61166,"_5":26632,"_18309":101923,"_24913":101924,"_2529":101925},[],"/docs/pr-preview/pr-47/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3023":61172,"_26291":61166,"_5":26632,"_18309":101927,"_24913":101928,"_2529":101929},[],"/docs/pr-preview/pr-47/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3023":61173,"_26291":61166,"_5":26632,"_18309":101931,"_24913":101932,"_2529":101933},[],"/docs/pr-preview/pr-47/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3023":61174,"_26291":61166,"_5":26632,"_18309":101935,"_24913":101936,"_2529":101937},[],"/docs/pr-preview/pr-47/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3023":61175,"_26291":61166,"_5":26632,"_18309":101939,"_24913":101940,"_2529":101941},[],"/docs/pr-preview/pr-47/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3023":61176,"_26291":61166,"_5":26632,"_18309":101943,"_24913":101944,"_2529":101945},[],"/docs/pr-preview/pr-47/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3023":61177,"_26291":61166,"_5":26632,"_18309":101947,"_24913":101948,"_2529":101949},[],"/docs/pr-preview/pr-47/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3023":61178,"_26291":61166,"_5":26632,"_18309":101951,"_24913":101952,"_2529":101953},[],"/docs/pr-preview/pr-47/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3023":61179,"_26291":61166,"_5":26632,"_18309":101955,"_24913":101956,"_2529":101957},[],"/docs/pr-preview/pr-47/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3023":61180,"_26291":61166,"_18309":101959,"_5":12556,"_24913":61166,"_2529":101960},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3023":61181,"_26291":61166,"_18309":101962,"_5":12556,"_24913":101916,"_2529":101963},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3023":61182,"_26291":61166,"_18309":101965,"_5":12556,"_24913":101920,"_2529":101966},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3023":61183,"_26291":61166,"_18309":101968,"_5":12556,"_24913":101924,"_2529":101969},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3023":61184,"_26291":61166,"_18309":101971,"_5":12556,"_24913":101928,"_2529":101972},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3023":61185,"_26291":61166,"_18309":101974,"_5":12556,"_24913":101932,"_2529":101975},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3023":61186,"_26291":61166,"_18309":101977,"_5":12556,"_24913":101936,"_2529":101978},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3023":61187,"_26291":61166,"_18309":101980,"_5":12556,"_24913":101936,"_2529":101981},[],"Ejecuta también la prueba de conectividad del chart:",{"_3023":61188,"_26291":61166,"_18309":101983,"_5":12556,"_24913":101936,"_2529":101984},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3023":61189,"_26291":61166,"_18309":101986,"_5":12556,"_24913":101936,"_2529":101987},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3023":61190,"_26291":61166,"_18309":101989,"_5":12556,"_24913":101940,"_2529":101990},[],"Si recibes un 401:",{"_3023":61191,"_26291":61166,"_18309":101992,"_5":12556,"_24913":101940,"_2529":101993},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3023":61192,"_26291":61166,"_18309":101995,"_5":12556,"_24913":101940,"_2529":101996},[],"verifica emisor, audiencia y expiración del token;",{"_3023":61193,"_26291":61166,"_18309":101998,"_5":12556,"_24913":101940,"_2529":101999},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3023":61194,"_26291":61166,"_18309":102001,"_5":12556,"_24913":101940,"_2529":102002},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3023":61195,"_26291":61166,"_18309":102004,"_5":12556,"_24913":101940,"_2529":102005},[],"Si el login termina pero las APIs devuelven 403:",{"_3023":61196,"_26291":61166,"_18309":102007,"_5":12556,"_24913":101940,"_2529":102008},[],"inspecciona los claims reales del token;",{"_3023":61197,"_26291":61166,"_18309":102010,"_5":12556,"_24913":101940,"_2529":102011},[],"confirma que coinciden con un principal activo;",{"_3023":61198,"_26291":61166,"_18309":102013,"_5":12556,"_24913":101940,"_2529":102014},[],"revisa las políticas concedidas al principal;",{"_3023":61199,"_26291":61166,"_18309":102016,"_5":12556,"_24913":101940,"_2529":102017},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3023":61200,"_26291":61166,"_18309":102019,"_5":12556,"_24913":101940,"_2529":102020},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3023":61201,"_26291":61166,"_18309":102022,"_5":12556,"_24913":101944,"_2529":102023},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3023":61202,"_26291":61166,"_18309":102025,"_5":12556,"_24913":101944,"_2529":102026},[],"Localiza el pod y Service de authz.",{"_3023":61203,"_26291":61166,"_18309":102028,"_5":12556,"_24913":101944,"_2529":102029},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3023":61204,"_26291":61166,"_18309":102031,"_5":12556,"_24913":101944,"_2529":102032},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3023":61205,"_26291":61166,"_18309":102034,"_5":12556,"_24913":101944,"_2529":102035},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3023":61206,"_26291":61166,"_18309":102037,"_5":12556,"_24913":101944,"_2529":102038},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3023":61207,"_26291":61166,"_18309":102040,"_5":12556,"_24913":101948,"_2529":102041},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3023":61208,"_26291":61166,"_18309":102043,"_5":12556,"_24913":101948,"_2529":102044},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3023":61209,"_26291":61166,"_18309":102046,"_5":12556,"_24913":101948,"_2529":102047},[],"volumen persistente sin enlazar;",{"_3023":61210,"_26291":61166,"_18309":102049,"_5":12556,"_24913":101948,"_2529":102050},[],"imagen inaccesible o política de pull incorrecta;",{"_3023":61211,"_26291":61166,"_18309":102052,"_5":12556,"_24913":101948,"_2529":102053},[],"configuración inválida del motor criptográfico;",{"_3023":61212,"_26291":61166,"_18309":102055,"_5":12556,"_24913":101948,"_2529":102056},[],"límites de CPU o memoria demasiado bajos;",{"_3023":61213,"_26291":61166,"_18309":102058,"_5":12556,"_24913":101948,"_2529":102059},[],"migración previa incompleta.",{"_3023":61214,"_26291":61166,"_18309":102061,"_5":12556,"_24913":101948,"_2529":102062},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3023":61215,"_26291":61166,"_18309":102064,"_5":12556,"_24913":101948,"_2529":102065},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3023":61216,"_26291":61166,"_18309":102067,"_5":12556,"_24913":101952,"_2529":102068},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3023":61217,"_26291":61166,"_18309":102070,"_5":12556,"_24913":101952,"_2529":102071},[],"verifica que esté habilitado en el servicio emisor;",{"_3023":61218,"_26291":61166,"_18309":102073,"_5":12556,"_24913":101952,"_2529":102074},[],"comprueba conectividad y credenciales AMQP;",{"_3023":61219,"_26291":61166,"_18309":102076,"_5":12556,"_24913":101952,"_2529":102077},[],"revisa exchange, routing key, colas y consumidores;",{"_3023":61220,"_26291":61166,"_18309":102079,"_5":12556,"_24913":101952,"_2529":102080},[],"inspecciona dead-letter queues;",{"_3023":61221,"_26291":61166,"_18309":102082,"_5":12556,"_24913":101952,"_2529":102083},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3023":61222,"_26291":61166,"_18309":102085,"_5":12556,"_24913":101952,"_2529":102086},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3023":61223,"_26291":61166,"_18309":102088,"_5":12556,"_24913":101956,"_2529":102089},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_3023":61224,"_26291":61166,"_18309":102091,"_5":12556,"_24913":101956,"_2529":102092},[],"Antes de cerrar una incidencia, guarda:",{"_3023":61225,"_26291":61166,"_18309":102094,"_5":12556,"_24913":101956,"_2529":102095},[],"causa confirmada;",{"_3023":61226,"_26291":61166,"_18309":102097,"_5":12556,"_24913":101956,"_2529":102098},[],"alcance temporal y recursos afectados;",{"_3023":61227,"_26291":61166,"_18309":102100,"_5":12556,"_24913":101956,"_2529":102101},[],"comandos o consultas utilizados;",{"_3023":61228,"_26291":61166,"_18309":102103,"_5":12556,"_24913":101956,"_2529":102104},[],"cambio aplicado y forma de revertirlo;",{"_3023":61229,"_26291":61166,"_18309":102106,"_5":12556,"_24913":101956,"_2529":102107},[],"validación desde un consumidor;",{"_3023":61230,"_26291":61166,"_18309":102109,"_5":12556,"_24913":101956,"_2529":102110},[],"acción preventiva y propietario.",{"_3023":61231,"_26291":61231,"_5":12871,"_2529":102112,"_26635":102113,"_18309":102116,"_24913":61231},"Control de acceso",[42855,102114,102115],"Plataforma","Administración",[],{"_3023":61232,"_26291":61231,"_18309":102118,"_5":12556,"_24913":61231,"_2529":102119},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3023":61233,"_26291":61231,"_5":26632,"_18309":102121,"_24913":102122,"_2529":102123},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3023":61234,"_26291":61231,"_5":26632,"_18309":102125,"_24913":102126,"_2529":102127},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3023":61235,"_26291":61231,"_5":26632,"_18309":102129,"_24913":102130,"_2529":102131},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3023":61236,"_26291":61231,"_5":26632,"_18309":102133,"_24913":102134,"_2529":102135},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3023":61237,"_26291":61231,"_5":26632,"_18309":102137,"_24913":102138,"_2529":102139},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3023":61238,"_26291":61231,"_5":26632,"_18309":102141,"_24913":102142,"_2529":102143},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3023":61239,"_26291":61231,"_5":26632,"_18309":102145,"_24913":102146,"_2529":102147},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3023":61240,"_26291":61231,"_5":26632,"_18309":102149,"_24913":102150,"_2529":102151},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3023":61241,"_26291":61231,"_5":26632,"_18309":102153,"_24913":102154,"_2529":102155},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3023":61242,"_26291":61231,"_5":26632,"_18309":102157,"_24913":102158,"_2529":102159},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3023":61243,"_26291":61231,"_5":26632,"_18309":102161,"_24913":102162,"_2529":102163},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3023":61244,"_26291":61231,"_5":26632,"_18309":102165,"_24913":102166,"_2529":102167},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3023":61245,"_26291":61231,"_5":26632,"_18309":102169,"_24913":102170,"_2529":102171},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3023":61246,"_26291":61231,"_5":26632,"_18309":102173,"_24913":102174,"_2529":102175},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3023":61247,"_26291":61231,"_5":26632,"_18309":102177,"_24913":102178,"_2529":102179},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3023":61248,"_26291":61231,"_5":26632,"_18309":102181,"_24913":102182,"_2529":101376},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3023":61249,"_26291":61231,"_5":26632,"_18309":102184,"_24913":102185,"_2529":102186},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3023":61250,"_26291":61231,"_5":26632,"_18309":102188,"_24913":102189,"_2529":102190},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#configura-las-dos-validaciones-jwt","Configura las dos validaciones JWT",{"_3023":61251,"_26291":61231,"_5":26632,"_18309":102192,"_24913":102193,"_2529":102194},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3023":61252,"_26291":61231,"_5":26632,"_18309":102196,"_24913":102197,"_2529":102198},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3023":61253,"_26291":61231,"_5":26632,"_18309":102200,"_24913":102201,"_2529":102202},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3023":61254,"_26291":61231,"_5":26632,"_18309":102204,"_24913":102205,"_2529":102206},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3023":61255,"_26291":61231,"_5":26632,"_18309":102208,"_24913":102209,"_2529":102210},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3023":61256,"_26291":61231,"_5":26632,"_18309":102212,"_24913":102213,"_2529":102214},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3023":61257,"_26291":61231,"_5":26632,"_18309":102216,"_24913":102217,"_2529":102218},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3023":61258,"_26291":61231,"_5":26632,"_18309":102220,"_24913":102221,"_2529":102222},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3023":61259,"_26291":61231,"_5":26632,"_18309":102224,"_24913":102225,"_2529":102226},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3023":61260,"_26291":61231,"_5":26632,"_18309":102228,"_24913":102229,"_2529":102230},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3023":61261,"_26291":61231,"_5":26632,"_18309":102232,"_24913":102233,"_2529":102234},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3023":61262,"_26291":61231,"_5":26632,"_18309":102236,"_24913":102237,"_2529":102238},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3023":61263,"_26291":61231,"_5":26632,"_18309":102240,"_24913":102241,"_2529":102242},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3023":61264,"_26291":61231,"_18309":102244,"_5":12556,"_24913":61231,"_2529":102245},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3023":61265,"_26291":61231,"_18309":102247,"_5":12556,"_24913":61231,"_2529":102248},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3023":61266,"_26291":61231,"_18309":102250,"_5":12556,"_24913":61231,"_2529":102251},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3023":61267,"_26291":61231,"_18309":102253,"_5":12556,"_24913":102122,"_2529":102254},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3023":61268,"_26291":61231,"_18309":102256,"_5":12556,"_24913":102122,"_2529":102257},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3023":61269,"_26291":61231,"_18309":102259,"_5":12556,"_24913":102122,"_2529":102260},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3023":61270,"_26291":61231,"_18309":102262,"_5":12556,"_24913":102122,"_2529":102263},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3023":61271,"_26291":61231,"_18309":102265,"_5":12556,"_24913":102122,"_2529":102266},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3023":61272,"_26291":61231,"_18309":102268,"_5":12556,"_24913":102122,"_2529":102269},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3023":61273,"_26291":61231,"_18309":102271,"_5":12556,"_24913":102126,"_2529":102272},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3023":61274,"_26291":61231,"_18309":102274,"_5":12556,"_24913":102126,"_2529":102275},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3023":61275,"_26291":61231,"_18309":102277,"_5":12556,"_24913":102130,"_2529":102278},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3023":61276,"_26291":61231,"_18309":102280,"_5":12556,"_24913":102130,"_2529":102281},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3023":61277,"_26291":61231,"_18309":102283,"_5":12556,"_24913":102130,"_2529":102284},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3023":61278,"_26291":61231,"_18309":102286,"_5":12556,"_24913":102130,"_2529":102287},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3023":61279,"_26291":61231,"_18309":102289,"_5":12556,"_24913":102130,"_2529":102290},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3023":61280,"_26291":61231,"_18309":102292,"_5":12556,"_24913":102130,"_2529":102293},[],"Carga por separado las políticas concedidas a cada principal.",{"_3023":61281,"_26291":61231,"_18309":102295,"_5":12556,"_24913":102130,"_2529":102296},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3023":61282,"_26291":61231,"_18309":102298,"_5":12556,"_24913":102130,"_2529":102299},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3023":61283,"_26291":61231,"_18309":102301,"_5":12556,"_24913":102130,"_2529":102302},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3023":61284,"_26291":61231,"_18309":102304,"_5":12556,"_24913":102130,"_2529":102305},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3023":61285,"_26291":61231,"_18309":102307,"_5":12556,"_24913":102130,"_2529":102308},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3023":61286,"_26291":61231,"_18309":102310,"_5":12556,"_24913":102130,"_2529":102311},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3023":61287,"_26291":61231,"_18309":102313,"_5":12556,"_24913":102134,"_2529":102314},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3023":61288,"_26291":61231,"_18309":102316,"_5":12556,"_24913":102134,"_2529":102317},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3023":61289,"_26291":61231,"_18309":102319,"_5":12556,"_24913":102134,"_2529":102320},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3023":61290,"_26291":61231,"_18309":102322,"_5":12556,"_24913":102134,"_2529":102323},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3023":61291,"_26291":61231,"_18309":102325,"_5":12556,"_24913":102134,"_2529":102326},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3023":61292,"_26291":61231,"_18309":102328,"_5":12556,"_24913":102134,"_2529":102329},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3023":61293,"_26291":61231,"_18309":102331,"_5":12556,"_24913":102134,"_2529":102332},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3023":61294,"_26291":61231,"_18309":102334,"_5":12556,"_24913":102134,"_2529":102335},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3023":61295,"_26291":61231,"_18309":102337,"_5":12556,"_24913":102138,"_2529":102338},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3023":61296,"_26291":61231,"_18309":102340,"_5":12556,"_24913":102138,"_2529":102341},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3023":61297,"_26291":61231,"_18309":102343,"_5":12556,"_24913":102138,"_2529":102344},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3023":61298,"_26291":61231,"_18309":102346,"_5":12556,"_24913":102138,"_2529":102347},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3023":61299,"_26291":61231,"_18309":102349,"_5":12556,"_24913":102138,"_2529":102350},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3023":61300,"_26291":61231,"_18309":102352,"_5":12556,"_24913":102138,"_2529":102353},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3023":61301,"_26291":61231,"_18309":102355,"_5":12556,"_24913":102138,"_2529":102356},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3023":61302,"_26291":61231,"_18309":102358,"_5":12556,"_24913":102138,"_2529":102359},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3023":61303,"_26291":61231,"_18309":102361,"_5":12556,"_24913":102138,"_2529":102362},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3023":61304,"_26291":61231,"_18309":102364,"_5":12556,"_24913":102138,"_2529":102365},[],"Las acciones se dividen en dos grupos:",{"_3023":61305,"_26291":61231,"_18309":102367,"_5":12556,"_24913":102138,"_2529":102368},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3023":61306,"_26291":61231,"_18309":102370,"_5":12556,"_24913":102138,"_2529":102371},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3023":61307,"_26291":61231,"_18309":102373,"_5":12556,"_24913":102138,"_2529":102374},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3023":61308,"_26291":61231,"_18309":102376,"_5":12556,"_24913":102142,"_2529":102377},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3023":61309,"_26291":61231,"_18309":102379,"_5":12556,"_24913":102142,"_2529":102380},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3023":61310,"_26291":61231,"_18309":102382,"_5":12556,"_24913":102142,"_2529":102383},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3023":61311,"_26291":61231,"_18309":102385,"_5":12556,"_24913":102146,"_2529":102386},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3023":61312,"_26291":61231,"_18309":102388,"_5":12556,"_24913":102146,"_2529":102389},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3023":61313,"_26291":61231,"_18309":102391,"_5":12556,"_24913":102146,"_2529":102392},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3023":61314,"_26291":61231,"_18309":102394,"_5":12556,"_24913":102146,"_2529":102395},[],"Los operadores implementados son:",{"_3023":61315,"_26291":61231,"_18309":102397,"_5":12556,"_24913":102146,"_2529":102398},[],"`equals`, para igualdad exacta;",{"_3023":61316,"_26291":61231,"_18309":102400,"_5":12556,"_24913":102146,"_2529":102401},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3023":61317,"_26291":61231,"_18309":102403,"_5":12556,"_24913":102146,"_2529":102404},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3023":61318,"_26291":61231,"_18309":102406,"_5":12556,"_24913":102146,"_2529":102407},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3023":61319,"_26291":61231,"_18309":102409,"_5":12556,"_24913":102150,"_2529":102410},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3023":61320,"_26291":61231,"_18309":102412,"_5":12556,"_24913":102150,"_2529":102413},[],"Los modos disponibles son:",{"_3023":61321,"_26291":61231,"_18309":102415,"_5":12556,"_24913":102150,"_2529":102416},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3023":61322,"_26291":61231,"_18309":102418,"_5":12556,"_24913":102150,"_2529":102419},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3023":61323,"_26291":61231,"_18309":102421,"_5":12556,"_24913":102150,"_2529":102422},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3023":61324,"_26291":61231,"_18309":102424,"_5":12556,"_24913":102150,"_2529":102425},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3023":61325,"_26291":61231,"_18309":102427,"_5":12556,"_24913":102150,"_2529":102428},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3023":61326,"_26291":61231,"_18309":102430,"_5":12556,"_24913":102150,"_2529":102431},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3023":61327,"_26291":61231,"_18309":102433,"_5":12556,"_24913":102154,"_2529":102434},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3023":61328,"_26291":61231,"_18309":102436,"_5":12556,"_24913":102154,"_2529":102437},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3023":61329,"_26291":61231,"_18309":102439,"_5":12556,"_24913":102154,"_2529":102440},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3023":61330,"_26291":61231,"_18309":102442,"_5":12556,"_24913":102154,"_2529":102443},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3023":61331,"_26291":61231,"_18309":102445,"_5":12556,"_24913":102162,"_2529":102446},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3023":61332,"_26291":61231,"_18309":102448,"_5":12556,"_24913":102162,"_2529":102449},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3023":61333,"_26291":61231,"_18309":102451,"_5":12556,"_24913":102166,"_2529":102452},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3023":61334,"_26291":61231,"_18309":102454,"_5":12556,"_24913":102166,"_2529":102455},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3023":61335,"_26291":61231,"_18309":102457,"_5":12556,"_24913":102170,"_2529":102458},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3023":61336,"_26291":61231,"_18309":102460,"_5":12556,"_24913":102170,"_2529":102461},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3023":61337,"_26291":61231,"_18309":102463,"_5":12556,"_24913":102170,"_2529":102464},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3023":61338,"_26291":61231,"_18309":102466,"_5":12556,"_24913":102174,"_2529":102467},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3023":61339,"_26291":61231,"_18309":102469,"_5":12556,"_24913":102174,"_2529":102470},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3023":61340,"_26291":61231,"_18309":102472,"_5":12556,"_24913":102174,"_2529":102473},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3023":61341,"_26291":61231,"_18309":102475,"_5":12556,"_24913":102174,"_2529":102476},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3023":61342,"_26291":61231,"_18309":102478,"_5":12556,"_24913":102174,"_2529":102479},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3023":61343,"_26291":61231,"_18309":102481,"_5":12556,"_24913":102174,"_2529":102482},[],"Ten en cuenta que:",{"_3023":61344,"_26291":61231,"_18309":102484,"_5":12556,"_24913":102174,"_2529":102485},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3023":61345,"_26291":61231,"_18309":102487,"_5":12556,"_24913":102174,"_2529":102488},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3023":61346,"_26291":61231,"_18309":102490,"_5":12556,"_24913":102174,"_2529":102491},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3023":61347,"_26291":61231,"_18309":102493,"_5":12556,"_24913":102178,"_2529":102494},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3023":61348,"_26291":61231,"_18309":102496,"_5":12556,"_24913":102178,"_2529":102497},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3023":61349,"_26291":61231,"_18309":102499,"_5":12556,"_24913":102178,"_2529":102500},[],"acceso completo y de solo lectura a KMS;",{"_3023":61350,"_26291":61231,"_18309":102502,"_5":12556,"_24913":102178,"_2529":102503},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3023":61351,"_26291":61231,"_18309":102505,"_5":12556,"_24913":102178,"_2529":102506},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3023":61352,"_26291":61231,"_18309":102508,"_5":12556,"_24913":102178,"_2529":102509},[],"acceso a la interfaz;",{"_3023":61353,"_26291":61231,"_18309":102511,"_5":12556,"_24913":102178,"_2529":102512},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3023":61354,"_26291":61231,"_18309":102514,"_5":12556,"_24913":102178,"_2529":102515},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3023":61355,"_26291":61231,"_18309":102517,"_5":12556,"_24913":102178,"_2529":102518},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3023":61356,"_26291":61231,"_18309":102520,"_5":12556,"_24913":102182,"_2529":102521},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3023":61357,"_26291":61231,"_18309":102523,"_5":12556,"_24913":102182,"_2529":102524},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3023":61358,"_26291":61231,"_18309":102526,"_5":12556,"_24913":102182,"_2529":102527},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3023":61359,"_26291":61231,"_18309":102529,"_5":12556,"_24913":102185,"_2529":102530},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3023":61360,"_26291":61231,"_18309":102532,"_5":12556,"_24913":102189,"_2529":102533},[],"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes.",{"_3023":61361,"_26291":61231,"_18309":102535,"_5":12556,"_24913":102193,"_2529":102536},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3023":61362,"_26291":61231,"_18309":102538,"_5":12556,"_24913":102197,"_2529":102539},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3023":61363,"_26291":61231,"_18309":102541,"_5":12556,"_24913":102201,"_2529":102542},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3023":61364,"_26291":61231,"_18309":102544,"_5":12556,"_24913":102205,"_2529":102545},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3023":61365,"_26291":61231,"_18309":102547,"_5":12556,"_24913":102205,"_2529":102548},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3023":61366,"_26291":61231,"_18309":102550,"_5":12556,"_24913":102209,"_2529":102551},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3023":61367,"_26291":61231,"_18309":102553,"_5":12556,"_24913":102209,"_2529":102554},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3023":61368,"_26291":61231,"_18309":102556,"_5":12556,"_24913":102209,"_2529":102557},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3023":61369,"_26291":61231,"_18309":102559,"_5":12556,"_24913":102209,"_2529":102560},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3023":61370,"_26291":61231,"_18309":102562,"_5":12556,"_24913":102209,"_2529":102563},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3023":61371,"_26291":61231,"_18309":102565,"_5":12556,"_24913":102209,"_2529":102566},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3023":61372,"_26291":61231,"_18309":102568,"_5":12556,"_24913":102209,"_2529":102569},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3023":61373,"_26291":61231,"_18309":102571,"_5":12556,"_24913":102209,"_2529":102572},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3023":61374,"_26291":61231,"_18309":102574,"_5":12556,"_24913":102213,"_2529":102575},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3023":61375,"_26291":61231,"_18309":102577,"_5":12556,"_24913":102213,"_2529":102578},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3023":61376,"_26291":61231,"_18309":102580,"_5":12556,"_24913":102213,"_2529":102581},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3023":61377,"_26291":61231,"_18309":102583,"_5":12556,"_24913":102217,"_2529":102584},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3023":61378,"_26291":61231,"_18309":102586,"_5":12556,"_24913":102217,"_2529":102587},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3023":61379,"_26291":61231,"_18309":102589,"_5":12556,"_24913":102217,"_2529":102590},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3023":61380,"_26291":61231,"_18309":102592,"_5":12556,"_24913":102217,"_2529":102593},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3023":61381,"_26291":61231,"_18309":102595,"_5":12556,"_24913":102217,"_2529":102596},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3023":61382,"_26291":61231,"_18309":102598,"_5":12556,"_24913":102217,"_2529":102599},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3023":61383,"_26291":61231,"_18309":102601,"_5":12556,"_24913":102217,"_2529":102602},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3023":61384,"_26291":61231,"_18309":102604,"_5":12556,"_24913":102217,"_2529":102605},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3023":61385,"_26291":61231,"_18309":102607,"_5":12556,"_24913":102225,"_2529":102608},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3023":61386,"_26291":61231,"_18309":102610,"_5":12556,"_24913":102229,"_2529":102611},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3023":61387,"_26291":61231,"_18309":102613,"_5":12556,"_24913":102229,"_2529":102614},[],"que exista un principal activo del tipo correcto;",{"_3023":61388,"_26291":61231,"_18309":102616,"_5":12556,"_24913":102229,"_2529":102617},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3023":61389,"_26291":61231,"_18309":102619,"_5":12556,"_24913":102229,"_2529":102620},[],"que todas las condiciones del principal se cumplan;",{"_3023":61390,"_26291":61231,"_18309":102622,"_5":12556,"_24913":102229,"_2529":102623},[],"que el principal tenga concedida la política esperada;",{"_3023":61391,"_26291":61231,"_18309":102625,"_5":12556,"_24913":102229,"_2529":102626},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3023":61392,"_26291":61231,"_18309":102628,"_5":12556,"_24913":102229,"_2529":102629},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3023":61393,"_26291":61231,"_18309":102631,"_5":12556,"_24913":102229,"_2529":102632},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_3023":61394,"_26291":61231,"_18309":102634,"_5":12556,"_24913":102233,"_2529":102635},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3023":61395,"_26291":61231,"_18309":102637,"_5":12556,"_24913":102237,"_2529":102638},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3023":61396,"_26291":61231,"_18309":102640,"_5":12556,"_24913":102241,"_2529":102641},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3023":61397,"_26291":61231,"_18309":102643,"_5":12556,"_24913":102241,"_2529":102644},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3023":61398,"_26291":61398,"_5":12871,"_2529":102646,"_26635":102647,"_18309":102648,"_24913":61398},"Alertas y suscripciones",[42855,102114,102115],[],{"_3023":61399,"_26291":61398,"_18309":102650,"_5":12556,"_24913":61398,"_2529":102651},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3023":61400,"_26291":61398,"_5":26632,"_18309":102653,"_24913":102654,"_2529":102655},[],"/docs/pr-preview/pr-47/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3023":61401,"_26291":61398,"_5":26632,"_18309":102657,"_24913":102658,"_2529":102659},[],"/docs/pr-preview/pr-47/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3023":61402,"_26291":61398,"_5":26632,"_18309":102661,"_24913":102662,"_2529":102663},[],"/docs/pr-preview/pr-47/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3023":61403,"_26291":61398,"_5":26632,"_18309":102665,"_24913":102666,"_2529":102667},[],"/docs/pr-preview/pr-47/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3023":61404,"_26291":61398,"_5":26632,"_18309":102669,"_24913":102670,"_2529":102671},[],"/docs/pr-preview/pr-47/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3023":61405,"_26291":61398,"_5":26632,"_18309":102673,"_24913":102674,"_2529":102675},[],"/docs/pr-preview/pr-47/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3023":61406,"_26291":61398,"_5":26632,"_18309":102677,"_24913":102678,"_2529":102679},[],"/docs/pr-preview/pr-47/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3023":61407,"_26291":61398,"_5":26632,"_18309":102681,"_24913":102682,"_2529":102683},[],"/docs/pr-preview/pr-47/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3023":61408,"_26291":61398,"_5":26632,"_18309":102685,"_24913":102686,"_2529":102687},[],"/docs/pr-preview/pr-47/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3023":61409,"_26291":61398,"_5":26632,"_18309":102689,"_24913":102690,"_2529":102691},[],"/docs/pr-preview/pr-47/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3023":61410,"_26291":61398,"_18309":102693,"_5":12556,"_24913":61398,"_2529":102694},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3023":61411,"_26291":61398,"_18309":102696,"_5":12556,"_24913":102654,"_2529":102697},[],"Un servicio publica un evento de dominio.",{"_3023":61412,"_26291":61398,"_18309":102699,"_5":12556,"_24913":102654,"_2529":102700},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3023":61413,"_26291":61398,"_18309":102702,"_5":12556,"_24913":102654,"_2529":102703},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3023":61414,"_26291":61398,"_18309":102705,"_5":12556,"_24913":102654,"_2529":102706},[],"Lamassu entrega el evento al canal configurado.",{"_3023":61415,"_26291":61398,"_18309":102708,"_5":12556,"_24913":102654,"_2529":102709},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3023":61416,"_26291":61398,"_18309":102711,"_5":12556,"_24913":102658,"_2529":102712},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3023":61417,"_26291":61398,"_18309":102714,"_5":12556,"_24913":102658,"_2529":102715},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3023":61418,"_26291":61398,"_18309":102717,"_5":12556,"_24913":102658,"_2529":102718},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3023":61419,"_26291":61398,"_18309":102720,"_5":12556,"_24913":102658,"_2529":102721},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3023":61420,"_26291":61398,"_18309":102723,"_5":12556,"_24913":102658,"_2529":102724},[],"`apikey_options` necesita `header` y `key`.",{"_3023":61421,"_26291":61398,"_18309":102726,"_5":12556,"_24913":102658,"_2529":102727},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3023":61422,"_26291":61398,"_18309":102729,"_5":12556,"_24913":102658,"_2529":102730},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3023":61423,"_26291":61398,"_18309":102732,"_5":12556,"_24913":102658,"_2529":102733},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3023":61424,"_26291":61398,"_18309":102735,"_5":12556,"_24913":102666,"_2529":102736},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3023":61425,"_26291":61398,"_18309":102738,"_5":12556,"_24913":102670,"_2529":102739},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3023":61426,"_26291":61398,"_18309":102741,"_5":12556,"_24913":102674,"_2529":102742},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3023":61427,"_26291":61398,"_18309":102744,"_5":12556,"_24913":102674,"_2529":102745},[],"**None** notifica todas las instancias del evento.",{"_3023":61428,"_26291":61398,"_18309":102747,"_5":12556,"_24913":102674,"_2529":102748},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3023":61429,"_26291":61398,"_18309":102750,"_5":12556,"_24913":102674,"_2529":102751},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3023":61430,"_26291":61398,"_18309":102753,"_5":12556,"_24913":102674,"_2529":102754},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3023":61431,"_26291":61398,"_18309":102756,"_5":12556,"_24913":102674,"_2529":102757},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3023":61432,"_26291":61398,"_18309":102759,"_5":12556,"_24913":102678,"_2529":102760},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3023":61433,"_26291":61398,"_18309":102762,"_5":12556,"_24913":102682,"_2529":102763},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3023":61434,"_26291":61398,"_18309":102765,"_5":12556,"_24913":102682,"_2529":102766},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3023":61435,"_26291":61398,"_18309":102768,"_5":12556,"_24913":102682,"_2529":102769},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3023":61436,"_26291":61398,"_18309":102771,"_5":12556,"_24913":102682,"_2529":102772},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3023":61437,"_26291":61398,"_18309":102774,"_5":12556,"_24913":102682,"_2529":102775},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3023":61438,"_26291":61398,"_18309":102777,"_5":12556,"_24913":102682,"_2529":102778},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3023":61439,"_26291":61398,"_18309":102780,"_5":12556,"_24913":102682,"_2529":102781},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3023":61440,"_26291":61398,"_18309":102783,"_5":12556,"_24913":102682,"_2529":102784},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3023":61441,"_26291":61398,"_18309":102786,"_5":12556,"_24913":102686,"_2529":102787},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3023":61442,"_26291":61398,"_18309":102789,"_5":12556,"_24913":102690,"_2529":102790},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3023":61443,"_26291":61398,"_18309":102792,"_5":12556,"_24913":102690,"_2529":102793},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3023":61444,"_26291":61398,"_18309":102795,"_5":12556,"_24913":102690,"_2529":102796},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3023":61445,"_26291":61398,"_18309":102798,"_5":12556,"_24913":102690,"_2529":102799},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3023":61446,"_26291":61398,"_18309":102801,"_5":12556,"_24913":102690,"_2529":102802},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3023":61447,"_26291":61398,"_18309":102804,"_5":12556,"_24913":102690,"_2529":102805},[],"**Validación:** `va.role.crl.create`.",{"_3023":61448,"_26291":61398,"_18309":102807,"_5":12556,"_24913":102690,"_2529":102808},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3023":61449,"_26291":61398,"_18309":102810,"_5":12556,"_24913":102690,"_2529":102811},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3023":61450,"_26291":61450,"_5":12871,"_2529":102813,"_26635":102814,"_18309":102815,"_24913":61450},"Registros de auditoría",[42855,102114,102115],[],{"_3023":61451,"_26291":61450,"_18309":102817,"_5":12556,"_24913":61450,"_2529":102818},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3023":61452,"_26291":61450,"_5":26632,"_18309":102820,"_24913":102821,"_2529":102822},[],"/docs/pr-preview/pr-47/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3023":61453,"_26291":61450,"_5":26632,"_18309":102824,"_24913":102825,"_2529":102826},[],"/docs/pr-preview/pr-47/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3023":61454,"_26291":61450,"_5":26632,"_18309":102828,"_24913":102829,"_2529":102830},[],"/docs/pr-preview/pr-47/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3023":61455,"_26291":61450,"_5":26632,"_18309":102832,"_24913":102833,"_2529":102834},[],"/docs/pr-preview/pr-47/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3023":61456,"_26291":61450,"_5":26632,"_18309":102836,"_24913":102837,"_2529":102838},[],"/docs/pr-preview/pr-47/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3023":61457,"_26291":61450,"_5":26632,"_18309":102840,"_24913":102841,"_2529":102842},[],"/docs/pr-preview/pr-47/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3023":61458,"_26291":61450,"_5":26632,"_18309":102844,"_24913":102845,"_2529":102846},[],"/docs/pr-preview/pr-47/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3023":61459,"_26291":61450,"_5":26632,"_18309":102848,"_24913":102849,"_2529":102850},[],"/docs/pr-preview/pr-47/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3023":61460,"_26291":61450,"_5":26632,"_18309":102852,"_24913":102853,"_2529":102854},[],"/docs/pr-preview/pr-47/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3023":61461,"_26291":61450,"_5":26632,"_18309":102856,"_24913":102857,"_2529":102858},[],"/docs/pr-preview/pr-47/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3023":61462,"_26291":61450,"_5":26632,"_18309":102860,"_24913":102861,"_2529":102862},[],"/docs/pr-preview/pr-47/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3023":61463,"_26291":61450,"_18309":102864,"_5":12556,"_24913":61450,"_2529":102865},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3023":61464,"_26291":61450,"_18309":102867,"_5":12556,"_24913":102821,"_2529":102868},[],"El cuerpo de auditoría incluye:",{"_3023":61465,"_26291":61450,"_18309":102870,"_5":12556,"_24913":102821,"_2529":102871},[],"input: datos recibidos por la operación;",{"_3023":61466,"_26291":61450,"_18309":102873,"_5":12556,"_24913":102821,"_2529":102874},[],"has\\_error: indica si el servicio devolvió un error;",{"_3023":61467,"_26291":61450,"_18309":102876,"_5":12556,"_24913":102821,"_2529":102877},[],"output: resultado producido o mensaje de error;",{"_3023":61468,"_26291":61450,"_18309":102879,"_5":12556,"_24913":102821,"_2529":102880},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3023":61469,"_26291":61450,"_18309":102882,"_5":12556,"_24913":102821,"_2529":102883},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3023":61470,"_26291":61450,"_18309":102885,"_5":12556,"_24913":102821,"_2529":102886},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3023":61471,"_26291":61450,"_18309":102888,"_5":12556,"_24913":102825,"_2529":102889},[],"El backend aplica auditoría a mutaciones de:",{"_3023":61472,"_26291":61450,"_18309":102891,"_5":12556,"_24913":102825,"_2529":102892},[],"autoridades, certificados y perfiles de emisión;",{"_3023":61473,"_26291":61450,"_18309":102894,"_5":12556,"_24913":102825,"_2529":102895},[],"claves y motores KMS;",{"_3023":61474,"_26291":61450,"_18309":102897,"_5":12556,"_24913":102825,"_2529":102898},[],"dispositivos e identidades;",{"_3023":61475,"_26291":61450,"_18309":102900,"_5":12556,"_24913":102825,"_2529":102901},[],"DMS y operaciones de enrolamiento;",{"_3023":61476,"_26291":61450,"_18309":102903,"_5":12556,"_24913":102825,"_2529":102904},[],"funciones de validación y CRL;",{"_3023":61477,"_26291":61450,"_18309":102906,"_5":12556,"_24913":102825,"_2529":102907},[],"principales, políticas y concesiones de autorización.",{"_3023":61478,"_26291":61450,"_18309":102909,"_5":12556,"_24913":102825,"_2529":102910},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3023":61479,"_26291":61450,"_18309":102912,"_5":12556,"_24913":102829,"_2529":102913},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3023":61480,"_26291":61450,"_18309":102915,"_5":12556,"_24913":102829,"_2529":102916},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3023":61481,"_26291":61450,"_18309":102918,"_5":12556,"_24913":102829,"_2529":102919},[],"Diseña el consumidor para:",{"_3023":61482,"_26291":61450,"_18309":102921,"_5":12556,"_24913":102829,"_2529":102922},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3023":61483,"_26291":61450,"_18309":102924,"_5":12556,"_24913":102829,"_2529":102925},[],"conservar el CloudEvent completo sin modificar;",{"_3023":61484,"_26291":61450,"_18309":102927,"_5":12556,"_24913":102829,"_2529":102928},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3023":61485,"_26291":61450,"_18309":102930,"_5":12556,"_24913":102829,"_2529":102931},[],"cifrar en tránsito y en reposo;",{"_3023":61486,"_26291":61450,"_18309":102933,"_5":12556,"_24913":102829,"_2529":102934},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3023":61487,"_26291":61450,"_18309":102936,"_5":12556,"_24913":102829,"_2529":102937},[],"aplicar una política explícita de retención y legal hold;",{"_3023":61488,"_26291":61450,"_18309":102939,"_5":12556,"_24913":102829,"_2529":102940},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3023":61489,"_26291":61450,"_18309":102942,"_5":12556,"_24913":102833,"_2529":102943},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3023":61490,"_26291":61450,"_18309":102945,"_5":12556,"_24913":102833,"_2529":102946},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3023":61491,"_26291":61450,"_18309":102948,"_5":12556,"_24913":102841,"_2529":102949},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3023":61492,"_26291":61450,"_18309":102951,"_5":12556,"_24913":102845,"_2529":102952},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3023":61493,"_26291":61450,"_18309":102954,"_5":12556,"_24913":102849,"_2529":102955},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3023":61494,"_26291":61450,"_18309":102957,"_5":12556,"_24913":102853,"_2529":102958},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3023":61495,"_26291":61450,"_18309":102960,"_5":12556,"_24913":102857,"_2529":102961},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3023":61496,"_26291":61450,"_18309":102963,"_5":12556,"_24913":102861,"_2529":102964},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3023":61497,"_26291":61450,"_18309":102966,"_5":12556,"_24913":102861,"_2529":102967},[],"aparece un evento de auditoría correcto;",{"_3023":61498,"_26291":61450,"_18309":102969,"_5":12556,"_24913":102861,"_2529":102970},[],"el principal coincide con la identidad utilizada;",{"_3023":61499,"_26291":61450,"_18309":102972,"_5":12556,"_24913":102861,"_2529":102973},[],"el consumidor lo persiste una sola vez;",{"_3023":61500,"_26291":61450,"_18309":102975,"_5":12556,"_24913":102861,"_2529":102976},[],"puede recuperarse por recurso, actor y periodo;",{"_3023":61501,"_26291":61450,"_18309":102978,"_5":12556,"_24913":102861,"_2529":102979},[],"una interrupción del consumidor produce una alerta.",{"_3023":61502,"_26291":61450,"_18309":102981,"_5":12556,"_24913":102861,"_2529":102982},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3023":61503,"_26291":61503,"_5":12871,"_2529":102984,"_26635":102985,"_18309":102986,"_24913":61503},"Arquitectura de la plataforma",[42855,102114],[],{"_3023":61504,"_26291":61503,"_18309":102988,"_5":12556,"_24913":61503,"_2529":102989},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3023":61505,"_26291":61503,"_5":26632,"_18309":102991,"_24913":102992,"_2529":102993},[],"/docs/pr-preview/pr-47/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3023":61506,"_26291":61503,"_5":26632,"_18309":102995,"_24913":102996,"_2529":102997},[],"/docs/pr-preview/pr-47/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3023":61507,"_26291":61503,"_5":26632,"_18309":102999,"_24913":103000,"_2529":103001},[],"/docs/pr-preview/pr-47/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3023":61508,"_26291":61503,"_5":26632,"_18309":103003,"_24913":103004,"_2529":103005},[],"/docs/pr-preview/pr-47/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3023":61509,"_26291":61503,"_5":26632,"_18309":103007,"_24913":103008,"_2529":103009},[],"/docs/pr-preview/pr-47/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3023":61510,"_26291":61503,"_18309":103011,"_5":12556,"_24913":61503,"_2529":103012},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3023":61511,"_26291":61503,"_18309":103014,"_5":12556,"_24913":61503,"_2529":103015},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3023":61512,"_26291":61503,"_18309":103017,"_5":12556,"_24913":102992,"_2529":103018},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3023":61513,"_26291":61503,"_18309":103020,"_5":12556,"_24913":102996,"_2529":103021},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3023":61514,"_26291":61503,"_18309":103023,"_5":12556,"_24913":103000,"_2529":103024},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3023":61515,"_26291":61503,"_18309":103026,"_5":12556,"_24913":103004,"_2529":103027},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3023":61516,"_26291":61503,"_18309":103029,"_5":12556,"_24913":103008,"_2529":103030},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3023":61517,"_26291":61517,"_5":12871,"_2529":103032,"_26635":103033,"_18309":103034,"_24913":61517},"Cómo funciona Lamassu",[42855,102114],[],{"_3023":61518,"_26291":61517,"_18309":103036,"_5":12556,"_24913":61517,"_2529":103037},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3023":61519,"_26291":61517,"_5":26632,"_18309":103039,"_24913":103040,"_2529":103041},[],"/docs/pr-preview/pr-47/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3023":61520,"_26291":61517,"_5":26632,"_18309":103043,"_24913":103044,"_2529":103045},[],"/docs/pr-preview/pr-47/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3023":61521,"_26291":61517,"_18309":103047,"_5":12556,"_24913":61517,"_2529":103048},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3023":61522,"_26291":61517,"_18309":103050,"_5":12556,"_24913":103040,"_2529":103051},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3023":61523,"_26291":61517,"_18309":103053,"_5":12556,"_24913":103040,"_2529":103054},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3023":61524,"_26291":61517,"_18309":103056,"_5":12556,"_24913":103040,"_2529":103057},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3023":61525,"_26291":61517,"_18309":103059,"_5":12556,"_24913":103040,"_2529":103060},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3023":61526,"_26291":61517,"_18309":103062,"_5":12556,"_24913":103040,"_2529":103063},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3023":61527,"_26291":61517,"_18309":103065,"_5":12556,"_24913":103044,"_2529":103066},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3023":61528,"_26291":61517,"_18309":103068,"_5":12556,"_24913":103044,"_2529":103069},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3023":61529,"_26291":61517,"_18309":103071,"_5":12556,"_24913":103044,"_2529":103072},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3023":61530,"_26291":61517,"_18309":103074,"_5":12556,"_24913":103044,"_2529":103075},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3023":61531,"_26291":61517,"_18309":103077,"_5":12556,"_24913":103044,"_2529":103078},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3023":61532,"_26291":61517,"_18309":103080,"_5":12556,"_24913":103044,"_2529":103081},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3023":61533,"_26291":61517,"_18309":103083,"_5":12556,"_24913":103044,"_2529":103084},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3023":61534,"_26291":61534,"_5":12871,"_2529":103086,"_26635":103087,"_18309":103088,"_24913":61534},"Dispositivos e identidades",[42855,102114,45173,103086],[],{"_3023":61535,"_26291":61534,"_18309":103090,"_5":12556,"_24913":61534,"_2529":103091},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3023":61536,"_26291":61534,"_5":26632,"_18309":103093,"_24913":103094,"_2529":103095},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3023":61537,"_26291":61534,"_5":26632,"_18309":103097,"_24913":103098,"_2529":103099},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3023":61538,"_26291":61534,"_5":26632,"_18309":103101,"_24913":103102,"_2529":103103},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3023":61539,"_26291":61534,"_5":26632,"_18309":103105,"_24913":103106,"_2529":103107},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3023":61540,"_26291":61534,"_5":26632,"_18309":103109,"_24913":103110,"_2529":103111},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3023":61541,"_26291":61534,"_5":26632,"_18309":103113,"_24913":103114,"_2529":103115},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3023":61542,"_26291":61534,"_5":26632,"_18309":103117,"_24913":103118,"_2529":103119},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3023":61543,"_26291":61534,"_5":26632,"_18309":103121,"_24913":103122,"_2529":103123},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3023":61544,"_26291":61534,"_5":26632,"_18309":103125,"_24913":103126,"_2529":103127},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3023":61545,"_26291":61534,"_5":26632,"_18309":103129,"_24913":103130,"_2529":103131},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3023":61546,"_26291":61534,"_5":26632,"_18309":103133,"_24913":103134,"_2529":103135},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3023":61547,"_26291":61534,"_18309":103137,"_5":12556,"_24913":61534,"_2529":103138},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3023":61548,"_26291":61534,"_18309":103140,"_5":12556,"_24913":61534,"_2529":103141},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3023":61549,"_26291":61534,"_18309":103143,"_5":12556,"_24913":103094,"_2529":103144},[],"Vista operativa",{"_3023":61550,"_26291":61534,"_18309":103146,"_5":12556,"_24913":103094,"_2529":103147},[],"Interpretación",{"_3023":61551,"_26291":61534,"_18309":103149,"_5":12556,"_24913":103094,"_2529":45236},[],{"_3023":61552,"_26291":61534,"_18309":103151,"_5":12556,"_24913":103094,"_2529":103152},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3023":61553,"_26291":61534,"_18309":103154,"_5":12556,"_24913":103094,"_2529":45242},[],{"_3023":61554,"_26291":61534,"_18309":103156,"_5":12556,"_24913":103094,"_2529":103157},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3023":61555,"_26291":61534,"_18309":103159,"_5":12556,"_24913":103094,"_2529":45248},[],{"_3023":61556,"_26291":61534,"_18309":103161,"_5":12556,"_24913":103094,"_2529":103162},[],"La identidad está en la ventana operativa de renovación.",{"_3023":61557,"_26291":61534,"_18309":103164,"_5":12556,"_24913":103094,"_2529":45254},[],{"_3023":61558,"_26291":61534,"_18309":103166,"_5":12556,"_24913":103094,"_2529":103167},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3023":61559,"_26291":61534,"_18309":103169,"_5":12556,"_24913":103094,"_2529":45260},[],{"_3023":61560,"_26291":61534,"_18309":103171,"_5":12556,"_24913":103094,"_2529":103172},[],"La identidad ha vencido.",{"_3023":61561,"_26291":61534,"_18309":103174,"_5":12556,"_24913":103094,"_2529":45266},[],{"_3023":61562,"_26291":61534,"_18309":103176,"_5":12556,"_24913":103094,"_2529":103177},[],"La identidad está marcada como revocada.",{"_3023":61563,"_26291":61534,"_18309":103179,"_5":12556,"_24913":103094,"_2529":45272},[],{"_3023":61564,"_26291":61534,"_18309":103181,"_5":12556,"_24913":103094,"_2529":103182},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3023":61565,"_26291":61534,"_18309":103184,"_5":12556,"_24913":103094,"_2529":103185},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3023":61566,"_26291":61534,"_18309":103187,"_5":12556,"_24913":103098,"_2529":103188},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3023":61567,"_26291":61534,"_18309":103190,"_5":12556,"_24913":103098,"_2529":103191},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3023":61568,"_26291":61534,"_18309":103193,"_5":12556,"_24913":103098,"_2529":103194},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3023":61569,"_26291":61534,"_18309":103196,"_5":12556,"_24913":103098,"_2529":103197},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3023":61570,"_26291":61534,"_18309":103199,"_5":12556,"_24913":103102,"_2529":103200},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3023":61571,"_26291":61534,"_18309":103202,"_5":12556,"_24913":103106,"_2529":103203},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3023":61572,"_26291":61534,"_18309":103205,"_5":12556,"_24913":103110,"_2529":103206},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3023":61573,"_26291":61534,"_18309":103208,"_5":12556,"_24913":103114,"_2529":103209},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3023":61574,"_26291":61534,"_18309":103211,"_5":12556,"_24913":103118,"_2529":103212},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3023":61575,"_26291":61534,"_18309":103214,"_5":12556,"_24913":103118,"_2529":103215},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3023":61576,"_26291":61534,"_18309":103217,"_5":12556,"_24913":103122,"_2529":103218},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3023":61577,"_26291":61534,"_18309":103220,"_5":12556,"_24913":103122,"_2529":103221},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3023":61578,"_26291":61534,"_18309":103223,"_5":12556,"_24913":103122,"_2529":103224},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3023":61579,"_26291":61534,"_18309":103226,"_5":12556,"_24913":103122,"_2529":103227},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3023":61580,"_26291":61534,"_18309":103229,"_5":12556,"_24913":103122,"_2529":103230},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3023":61581,"_26291":61534,"_18309":103232,"_5":12556,"_24913":103122,"_2529":103233},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3023":61582,"_26291":61534,"_18309":103235,"_5":12556,"_24913":103126,"_2529":103236},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3023":61583,"_26291":61534,"_18309":103238,"_5":12556,"_24913":103126,"_2529":103239},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3023":61584,"_26291":61534,"_18309":103241,"_5":12556,"_24913":103130,"_2529":103242},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3023":61585,"_26291":61534,"_18309":103244,"_5":12556,"_24913":103130,"_2529":103245},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3023":61586,"_26291":61534,"_18309":103247,"_5":12556,"_24913":103130,"_2529":103248},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3023":61587,"_26291":61534,"_18309":103250,"_5":12556,"_24913":103130,"_2529":103251},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3023":61588,"_26291":61534,"_18309":103253,"_5":12556,"_24913":103134,"_2529":103254},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3023":61589,"_26291":61534,"_18309":103256,"_5":12556,"_24913":103134,"_2529":103257},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3023":61590,"_26291":61590,"_5":12871,"_2529":103259,"_26635":103260,"_18309":103262,"_24913":61590},"Identidad inicial y autenticación",[42855,102114,45173,103086,103261],"Enrolamiento con PKI",[],{"_3023":61591,"_26291":61590,"_18309":103264,"_5":12556,"_24913":61590,"_2529":103265},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3023":61592,"_26291":61590,"_5":26632,"_18309":103267,"_24913":103268,"_2529":103269},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3023":61593,"_26291":61590,"_5":26632,"_18309":103271,"_24913":103272,"_2529":103273},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3023":61594,"_26291":61590,"_5":26632,"_18309":103275,"_24913":103276,"_2529":103277},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3023":61595,"_26291":61590,"_5":26632,"_18309":103279,"_24913":103280,"_2529":103281},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3023":61596,"_26291":61590,"_5":26632,"_18309":103283,"_24913":103284,"_2529":103285},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3023":61597,"_26291":61590,"_18309":103287,"_5":12556,"_24913":61590,"_2529":103288},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3023":61598,"_26291":61590,"_18309":103290,"_5":12556,"_24913":103268,"_2529":103291},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3023":61599,"_26291":61590,"_18309":103293,"_5":12556,"_24913":103268,"_2529":103294},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3023":61600,"_26291":61590,"_18309":103296,"_5":12556,"_24913":103272,"_2529":103297},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3023":61601,"_26291":61590,"_18309":103299,"_5":12556,"_24913":103272,"_2529":103300},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3023":61602,"_26291":61590,"_18309":103302,"_5":12556,"_24913":103272,"_2529":103303},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3023":61603,"_26291":61590,"_18309":103305,"_5":12556,"_24913":103276,"_2529":103306},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3023":61604,"_26291":61590,"_18309":103308,"_5":12556,"_24913":103276,"_2529":103309},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3023":61605,"_26291":61590,"_18309":103311,"_5":12556,"_24913":103280,"_2529":103312},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3023":61606,"_26291":61590,"_18309":103314,"_5":12556,"_24913":103280,"_2529":103315},[],"Ejemplo de cuerpo:",{"_3023":61607,"_26291":61590,"_18309":103317,"_5":12556,"_24913":103280,"_2529":103318},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3023":61608,"_26291":61590,"_18309":103320,"_5":12556,"_24913":103280,"_2529":103321},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3023":61609,"_26291":61590,"_18309":103323,"_5":12556,"_24913":103280,"_2529":103324},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3023":61610,"_26291":61590,"_18309":103326,"_5":12556,"_24913":103280,"_2529":103327},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3023":61611,"_26291":61590,"_18309":103329,"_5":12556,"_24913":103284,"_2529":103330},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3023":61612,"_26291":61590,"_18309":103332,"_5":12556,"_24913":103284,"_2529":103333},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3023":61613,"_26291":61613,"_5":12871,"_2529":103335,"_26635":103336,"_18309":103337,"_24913":61613},"Configura y opera el DMS",[42855,102114,45173,103086,103261],[],{"_3023":61614,"_26291":61613,"_18309":103339,"_5":12556,"_24913":61613,"_2529":103340},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3023":61615,"_26291":61613,"_5":26632,"_18309":103342,"_24913":103343,"_2529":100815},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3023":61616,"_26291":61613,"_5":26632,"_18309":103345,"_24913":103346,"_2529":103347},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3023":61617,"_26291":61613,"_5":26632,"_18309":103349,"_24913":103350,"_2529":103351},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3023":61618,"_26291":61613,"_5":26632,"_18309":103353,"_24913":103354,"_2529":103355},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3023":61619,"_26291":61613,"_5":26632,"_18309":103357,"_24913":103358,"_2529":103359},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3023":61620,"_26291":61613,"_5":26632,"_18309":103361,"_24913":103362,"_2529":103363},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3023":61621,"_26291":61613,"_5":26632,"_18309":103365,"_24913":103366,"_2529":103367},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3023":61622,"_26291":61613,"_5":26632,"_18309":103369,"_24913":103370,"_2529":103371},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3023":61623,"_26291":61613,"_5":26632,"_18309":103373,"_24913":103374,"_2529":45468},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3023":61624,"_26291":61613,"_5":26632,"_18309":103376,"_24913":103377,"_2529":45472},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3023":61625,"_26291":61613,"_5":26632,"_18309":103379,"_24913":103380,"_2529":103381},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3023":61626,"_26291":61613,"_5":26632,"_18309":103383,"_24913":103384,"_2529":103385},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3023":61627,"_26291":61613,"_5":26632,"_18309":103387,"_24913":103388,"_2529":103389},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3023":61628,"_26291":61613,"_5":26632,"_18309":103391,"_24913":103392,"_2529":103393},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3023":61629,"_26291":61613,"_5":26632,"_18309":103395,"_24913":103396,"_2529":45492},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3023":61630,"_26291":61613,"_5":26632,"_18309":103398,"_24913":103399,"_2529":103400},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3023":61631,"_26291":61613,"_5":26632,"_18309":103402,"_24913":103403,"_2529":103404},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3023":61632,"_26291":61613,"_5":26632,"_18309":103406,"_24913":103407,"_2529":103408},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3023":61633,"_26291":61613,"_18309":103410,"_5":12556,"_24913":61613,"_2529":103411},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3023":61634,"_26291":61613,"_18309":103413,"_5":12556,"_24913":103343,"_2529":103414},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3023":61635,"_26291":61613,"_18309":103416,"_5":12556,"_24913":103343,"_2529":103417},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3023":61636,"_26291":61613,"_18309":103419,"_5":12556,"_24913":103350,"_2529":103420},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3023":61637,"_26291":61613,"_18309":103422,"_5":12556,"_24913":103354,"_2529":103423},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3023":61638,"_26291":61613,"_18309":103425,"_5":12556,"_24913":103358,"_2529":103426},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3023":61639,"_26291":61613,"_18309":103428,"_5":12556,"_24913":103362,"_2529":103429},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3023":61640,"_26291":61613,"_18309":103431,"_5":12556,"_24913":103366,"_2529":103432},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3023":61641,"_26291":61613,"_18309":103434,"_5":12556,"_24913":103374,"_2529":103435},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3023":61642,"_26291":61613,"_18309":103437,"_5":12556,"_24913":103374,"_2529":103438},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3023":61643,"_26291":61613,"_18309":103440,"_5":12556,"_24913":103377,"_2529":103441},[],"Campo de `settings.enrollment_settings`",{"_3023":61644,"_26291":61613,"_18309":103443,"_5":12556,"_24913":103377,"_2529":103444},[],"Decisión",{"_3023":61645,"_26291":61613,"_18309":103446,"_5":12556,"_24913":103377,"_2529":45543},[],{"_3023":61646,"_26291":61613,"_18309":103448,"_5":12556,"_24913":103377,"_2529":103449},[],"`EST_RFC7030` para estas operaciones.",{"_3023":61647,"_26291":61613,"_18309":103451,"_5":12556,"_24913":103377,"_2529":45549},[],{"_3023":61648,"_26291":61613,"_18309":103453,"_5":12556,"_24913":103377,"_2529":103454},[],"ID de la CA que firmará.",{"_3023":61649,"_26291":61613,"_18309":103456,"_5":12556,"_24913":103377,"_2529":45555},[],{"_3023":61650,"_26291":61613,"_18309":103458,"_5":12556,"_24913":103377,"_2529":103459},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3023":61651,"_26291":61613,"_18309":103461,"_5":12556,"_24913":103377,"_2529":45561},[],{"_3023":61652,"_26291":61613,"_18309":103463,"_5":12556,"_24913":103377,"_2529":103464},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3023":61653,"_26291":61613,"_18309":103466,"_5":12556,"_24913":103377,"_2529":45567},[],{"_3023":61654,"_26291":61613,"_18309":103468,"_5":12556,"_24913":103377,"_2529":103469},[],"Uno de los cuatro modos de autenticación.",{"_3023":61655,"_26291":61613,"_18309":103471,"_5":12556,"_24913":103377,"_2529":103472},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3023":61656,"_26291":61613,"_18309":103474,"_5":12556,"_24913":103380,"_2529":103475},[],"Los bloques son independientes:",{"_3023":61657,"_26291":61613,"_18309":103477,"_5":12556,"_24913":103380,"_2529":103478},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3023":61658,"_26291":61613,"_18309":103480,"_5":12556,"_24913":103380,"_2529":103481},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3023":61659,"_26291":61613,"_18309":103483,"_5":12556,"_24913":103380,"_2529":45585},[],{"_3023":61660,"_26291":61613,"_18309":103485,"_5":12556,"_24913":103380,"_2529":103486},[],"Control aplicado en la operación configurada",{"_3023":61661,"_26291":61613,"_18309":103488,"_5":12556,"_24913":103380,"_2529":45591},[],{"_3023":61662,"_26291":61613,"_18309":103490,"_5":12556,"_24913":103380,"_2529":103491},[],"Validación del certificado presentado.",{"_3023":61663,"_26291":61613,"_18309":103493,"_5":12556,"_24913":103380,"_2529":45597},[],{"_3023":61664,"_26291":61613,"_18309":103495,"_5":12556,"_24913":103380,"_2529":103496},[],"Autorización del webhook configurado.",{"_3023":61665,"_26291":61613,"_18309":103498,"_5":12556,"_24913":103380,"_2529":45603},[],{"_3023":61666,"_26291":61613,"_18309":103500,"_5":12556,"_24913":103380,"_2529":103501},[],"Validación del certificado y, después, aprobación del webhook.",{"_3023":61667,"_26291":61613,"_18309":103503,"_5":12556,"_24913":103380,"_2529":45609},[],{"_3023":61668,"_26291":61613,"_18309":103505,"_5":12556,"_24913":103380,"_2529":103506},[],"Sin autenticación del solicitante por el DMS.",{"_3023":61669,"_26291":61613,"_18309":103508,"_5":12556,"_24913":103380,"_2529":103509},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3023":61670,"_26291":61613,"_18309":103511,"_5":12556,"_24913":103380,"_2529":103512},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3023":61671,"_26291":61613,"_18309":103514,"_5":12556,"_24913":103380,"_2529":103515},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3023":61672,"_26291":61613,"_18309":103517,"_5":12556,"_24913":103380,"_2529":103518},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3023":61673,"_26291":61613,"_18309":103520,"_5":12556,"_24913":103384,"_2529":103521},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3023":61674,"_26291":61613,"_18309":103523,"_5":12556,"_24913":103384,"_2529":103524},[],"Campo de `external_webhook_settings`",{"_3023":61675,"_26291":61613,"_18309":103526,"_5":12556,"_24913":103384,"_2529":103444},[],{"_3023":61676,"_26291":61613,"_18309":103528,"_5":12556,"_24913":103384,"_2529":45635},[],{"_3023":61677,"_26291":61613,"_18309":103530,"_5":12556,"_24913":103384,"_2529":103531},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3023":61678,"_26291":61613,"_18309":103533,"_5":12556,"_24913":103384,"_2529":45641},[],{"_3023":61679,"_26291":61613,"_18309":103535,"_5":12556,"_24913":103384,"_2529":103536},[],"`POST` o `PUT`; `POST` por defecto.",{"_3023":61680,"_26291":61613,"_18309":103538,"_5":12556,"_24913":103384,"_2529":45647},[],{"_3023":61681,"_26291":61613,"_18309":103540,"_5":12556,"_24913":103384,"_2529":103541},[],"Etiqueta usada en los logs del servicio.",{"_3023":61682,"_26291":61613,"_18309":103543,"_5":12556,"_24913":103384,"_2529":45653},[],{"_3023":61683,"_26291":61613,"_18309":103545,"_5":12556,"_24913":103384,"_2529":103546},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3023":61684,"_26291":61613,"_18309":103548,"_5":12556,"_24913":103384,"_2529":45659},[],{"_3023":61685,"_26291":61613,"_18309":103550,"_5":12556,"_24913":103384,"_2529":103551},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3023":61686,"_26291":61613,"_18309":103553,"_5":12556,"_24913":103384,"_2529":45665},[],{"_3023":61687,"_26291":61613,"_18309":103555,"_5":12556,"_24913":103384,"_2529":103556},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3023":61688,"_26291":61613,"_18309":103558,"_5":12556,"_24913":103384,"_2529":45671},[],{"_3023":61689,"_26291":61613,"_18309":103560,"_5":12556,"_24913":103384,"_2529":103561},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3023":61690,"_26291":61613,"_18309":103563,"_5":12556,"_24913":103384,"_2529":45677},[],{"_3023":61691,"_26291":61613,"_18309":103565,"_5":12556,"_24913":103384,"_2529":103566},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3023":61692,"_26291":61613,"_18309":103568,"_5":12556,"_24913":103384,"_2529":45683},[],{"_3023":61693,"_26291":61613,"_18309":103570,"_5":12556,"_24913":103384,"_2529":103571},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3023":61694,"_26291":61613,"_18309":103573,"_5":12556,"_24913":103384,"_2529":103574},[],"Reglas de esa configuración:",{"_3023":61695,"_26291":61613,"_18309":103576,"_5":12556,"_24913":103384,"_2529":103577},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3023":61696,"_26291":61613,"_18309":103579,"_5":12556,"_24913":103384,"_2529":103580},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3023":61697,"_26291":61613,"_18309":103582,"_5":12556,"_24913":103384,"_2529":103583},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3023":61698,"_26291":61613,"_18309":103585,"_5":12556,"_24913":103384,"_2529":103586},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3023":61699,"_26291":61613,"_18309":103588,"_5":12556,"_24913":103384,"_2529":103589},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3023":61700,"_26291":61613,"_18309":103591,"_5":12556,"_24913":103384,"_2529":103592},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3023":61701,"_26291":61613,"_18309":103594,"_5":12556,"_24913":103384,"_2529":103595},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar, y si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_3023":61702,"_26291":61613,"_18309":103597,"_5":12556,"_24913":103384,"_2529":103598},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3023":61703,"_26291":61613,"_18309":103600,"_5":12556,"_24913":103384,"_2529":103601},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3023":61704,"_26291":61613,"_18309":103603,"_5":12556,"_24913":103388,"_2529":103604},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3023":61705,"_26291":61613,"_18309":103606,"_5":12556,"_24913":103392,"_2529":103607},[],"Campo de `settings.reenrollment_settings`",{"_3023":61706,"_26291":61613,"_18309":103609,"_5":12556,"_24913":103392,"_2529":103610},[],"Función",{"_3023":61707,"_26291":61613,"_18309":103612,"_5":12556,"_24913":103392,"_2529":45727},[],{"_3023":61708,"_26291":61613,"_18309":103614,"_5":12556,"_24913":103392,"_2529":103615},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3023":61709,"_26291":61613,"_18309":103617,"_5":12556,"_24913":103392,"_2529":45733},[],{"_3023":61710,"_26291":61613,"_18309":103619,"_5":12556,"_24913":103392,"_2529":103620},[],"Umbral operativo preventivo de monitorización.",{"_3023":61711,"_26291":61613,"_18309":103622,"_5":12556,"_24913":103392,"_2529":45739},[],{"_3023":61712,"_26291":61613,"_18309":103624,"_5":12556,"_24913":103392,"_2529":103625},[],"Umbral operativo crítico de monitorización.",{"_3023":61713,"_26291":61613,"_18309":103627,"_5":12556,"_24913":103392,"_2529":45745},[],{"_3023":61714,"_26291":61613,"_18309":103629,"_5":12556,"_24913":103392,"_2529":103630},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3023":61715,"_26291":61613,"_18309":103632,"_5":12556,"_24913":103392,"_2529":45751},[],{"_3023":61716,"_26291":61613,"_18309":103634,"_5":12556,"_24913":103392,"_2529":103635},[],"CAs de validación adicionales para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3023":61717,"_26291":61613,"_18309":103637,"_5":12556,"_24913":103392,"_2529":45757},[],{"_3023":61718,"_26291":61613,"_18309":103639,"_5":12556,"_24913":103392,"_2529":103640},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3023":61719,"_26291":61613,"_18309":103642,"_5":12556,"_24913":103392,"_2529":103643},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3023":61720,"_26291":61613,"_18309":103645,"_5":12556,"_24913":103396,"_2529":103646},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. Algoritmo y tamaño proceden de su campo `key`; el perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3023":61721,"_26291":61613,"_18309":103648,"_5":12556,"_24913":103399,"_2529":101172},[],{"_3023":61722,"_26291":61613,"_18309":103650,"_5":12556,"_24913":103399,"_2529":103651},[],"Qué publica",{"_3023":61723,"_26291":61613,"_18309":103653,"_5":12556,"_24913":103399,"_2529":45774},[],{"_3023":61724,"_26291":61613,"_18309":103655,"_5":12556,"_24913":103399,"_2529":103656},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3023":61725,"_26291":61613,"_18309":103658,"_5":12556,"_24913":103399,"_2529":45780},[],{"_3023":61726,"_26291":61613,"_18309":103660,"_5":12556,"_24913":103399,"_2529":103661},[],"Certificado de la CA emisora seleccionada.",{"_3023":61727,"_26291":61613,"_18309":103663,"_5":12556,"_24913":103399,"_2529":45786},[],{"_3023":61728,"_26291":61613,"_18309":103665,"_5":12556,"_24913":103399,"_2529":103666},[],"Certificados de las CAs elegidas explícitamente.",{"_3023":61729,"_26291":61613,"_18309":103668,"_5":12556,"_24913":103399,"_2529":103669},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3023":61730,"_26291":61613,"_18309":103671,"_5":12556,"_24913":103403,"_2529":103672},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_3023":61731,"_26291":61613,"_18309":103674,"_5":12556,"_24913":103403,"_2529":103675},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3023":61732,"_26291":61613,"_18309":103677,"_5":12556,"_24913":103403,"_2529":103678},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3023":61733,"_26291":61613,"_18309":103680,"_5":12556,"_24913":103407,"_2529":103681},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3023":61734,"_26291":61734,"_5":12871,"_2529":103683,"_26635":103684,"_18309":103685,"_24913":61734},"Integra el cliente EST",[42855,102114,45173,103086,103261],[],{"_3023":61735,"_26291":61734,"_18309":103687,"_5":12556,"_24913":61734,"_2529":103688},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3023":61736,"_26291":61734,"_5":26632,"_18309":103690,"_24913":103691,"_2529":100815},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3023":61737,"_26291":61734,"_5":26632,"_18309":103693,"_24913":103694,"_2529":103695},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3023":61738,"_26291":61734,"_5":26632,"_18309":103697,"_24913":103698,"_2529":103699},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3023":61739,"_26291":61734,"_5":26632,"_18309":103701,"_24913":103702,"_2529":103703},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3023":61740,"_26291":61734,"_5":26632,"_18309":103705,"_24913":103706,"_2529":103707},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3023":61741,"_26291":61734,"_5":26632,"_18309":103709,"_24913":103710,"_2529":103711},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3023":61742,"_26291":61734,"_18309":103713,"_5":12556,"_24913":61734,"_2529":103714},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3023":61743,"_26291":61734,"_18309":103716,"_5":12556,"_24913":103691,"_2529":103717},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3023":61744,"_26291":61734,"_18309":103719,"_5":12556,"_24913":103691,"_2529":103720},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3023":61745,"_26291":61734,"_18309":103722,"_5":12556,"_24913":103691,"_2529":103723},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3023":61746,"_26291":61734,"_18309":103725,"_5":12556,"_24913":103694,"_2529":103726},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3023":61747,"_26291":61734,"_18309":103728,"_5":12556,"_24913":103694,"_2529":103729},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3023":61748,"_26291":61734,"_18309":103731,"_5":12556,"_24913":103698,"_2529":103732},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3023":61749,"_26291":61734,"_18309":103734,"_5":12556,"_24913":103698,"_2529":103735},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3023":61750,"_26291":61734,"_18309":103737,"_5":12556,"_24913":103702,"_2529":103738},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3023":61751,"_26291":61734,"_18309":103740,"_5":12556,"_24913":103702,"_2529":103741},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3023":61752,"_26291":61734,"_18309":103743,"_5":12556,"_24913":103706,"_2529":103744},[],"Para el caso de una raíz que emite directamente:",{"_3023":61753,"_26291":61734,"_18309":103746,"_5":12556,"_24913":103706,"_2529":103747},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3023":61754,"_26291":61734,"_18309":103749,"_5":12556,"_24913":103706,"_2529":103750},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3023":61755,"_26291":61734,"_18309":103752,"_5":12556,"_24913":103710,"_2529":103753},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3023":61756,"_26291":61756,"_5":12871,"_2529":103755,"_26635":103756,"_18309":103757,"_24913":61756},"Referencia EST",[42855,102114,45173,103086,103261],[],{"_3023":61757,"_26291":61756,"_18309":103759,"_5":12556,"_24913":61756,"_2529":103760},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3023":61758,"_26291":61756,"_5":26632,"_18309":103762,"_24913":103763,"_2529":103764},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3023":61759,"_26291":61756,"_5":26632,"_18309":103766,"_24913":103767,"_2529":19908},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3023":61760,"_26291":61756,"_5":26632,"_18309":103769,"_24913":103770,"_2529":22817},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3023":61761,"_26291":61756,"_5":26632,"_18309":103772,"_24913":103773,"_2529":22824},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3023":61762,"_26291":61756,"_5":26632,"_18309":103775,"_24913":103776,"_2529":22178},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3023":61763,"_26291":61756,"_5":26632,"_18309":103778,"_24913":103779,"_2529":103780},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3023":61764,"_26291":61756,"_5":26632,"_18309":103782,"_24913":103783,"_2529":103784},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3023":61765,"_26291":61756,"_5":26632,"_18309":103786,"_24913":103787,"_2529":103788},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3023":61766,"_26291":61756,"_18309":103790,"_5":12556,"_24913":61756,"_2529":103791},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3023":61767,"_26291":61756,"_18309":103793,"_5":12556,"_24913":103763,"_2529":103794},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3023":61768,"_26291":61756,"_18309":103796,"_5":12556,"_24913":103763,"_2529":101905},[],{"_3023":61769,"_26291":61756,"_18309":103798,"_5":12556,"_24913":103763,"_2529":103799},[],"Método",{"_3023":61770,"_26291":61756,"_18309":103801,"_5":12556,"_24913":103763,"_2529":103802},[],"Autenticación y condición",{"_3023":61771,"_26291":61756,"_18309":103804,"_5":12556,"_24913":103763,"_2529":45929},[],{"_3023":61772,"_26291":61756,"_18309":103806,"_5":12556,"_24913":103763,"_2529":45932},[],{"_3023":61773,"_26291":61756,"_18309":103808,"_5":12556,"_24913":103763,"_2529":103809},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3023":61774,"_26291":61756,"_18309":103811,"_5":12556,"_24913":103763,"_2529":45938},[],{"_3023":61775,"_26291":61756,"_18309":103813,"_5":12556,"_24913":103763,"_2529":45941},[],{"_3023":61776,"_26291":61756,"_18309":103815,"_5":12556,"_24913":103763,"_2529":103816},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3023":61777,"_26291":61756,"_18309":103818,"_5":12556,"_24913":103763,"_2529":45947},[],{"_3023":61778,"_26291":61756,"_18309":103820,"_5":12556,"_24913":103763,"_2529":45941},[],{"_3023":61779,"_26291":61756,"_18309":103822,"_5":12556,"_24913":103763,"_2529":103823},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3023":61780,"_26291":61756,"_18309":103825,"_5":12556,"_24913":103763,"_2529":45955},[],{"_3023":61781,"_26291":61756,"_18309":103827,"_5":12556,"_24913":103763,"_2529":45941},[],{"_3023":61782,"_26291":61756,"_18309":103829,"_5":12556,"_24913":103763,"_2529":103830},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3023":61783,"_26291":61756,"_18309":103832,"_5":12556,"_24913":103763,"_2529":103833},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3023":61784,"_26291":61756,"_18309":103835,"_5":12556,"_24913":103767,"_2529":103836},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3023":61785,"_26291":61756,"_18309":103838,"_5":12556,"_24913":103767,"_2529":103839},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3023":61786,"_26291":61756,"_18309":103841,"_5":12556,"_24913":103770,"_2529":103842},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3023":61787,"_26291":61756,"_18309":103844,"_5":12556,"_24913":103770,"_2529":103845},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3023":61788,"_26291":61756,"_18309":103847,"_5":12556,"_24913":103773,"_2529":103848},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3023":61789,"_26291":61756,"_18309":103850,"_5":12556,"_24913":103773,"_2529":103851},[],"La CA de enrolamiento o una CA de validación configurada en el bloque de reenrolamiento valida la credencial en el modo mTLS. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3023":61790,"_26291":61756,"_18309":103853,"_5":12556,"_24913":103776,"_2529":103854},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3023":61791,"_26291":61756,"_18309":103856,"_5":12556,"_24913":103776,"_2529":103857},[],"El código admite RSA y ECDSA de 224, 256, 384 o 521 bits. Un tamaño ECDSA no reconocido puede producir fallback a 256; elige explícitamente un tamaño compatible y comprueba la clave resultante. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3023":61792,"_26291":61756,"_18309":103859,"_5":12556,"_24913":103779,"_2529":103860},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3023":61793,"_26291":61756,"_18309":103862,"_5":12556,"_24913":103779,"_2529":103863},[],"Parte",{"_3023":61794,"_26291":61756,"_18309":103865,"_5":12556,"_24913":103779,"_2529":103866},[],"Contenido tras decodificar su Base64",{"_3023":61795,"_26291":61756,"_18309":103868,"_5":12556,"_24913":103779,"_2529":45999},[],{"_3023":61796,"_26291":61756,"_18309":103870,"_5":12556,"_24913":103779,"_2529":103871},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3023":61797,"_26291":61756,"_18309":103873,"_5":12556,"_24913":103779,"_2529":46005},[],{"_3023":61798,"_26291":61756,"_18309":103875,"_5":12556,"_24913":103779,"_2529":103876},[],"PKCS#7 DER con el certificado emitido.",{"_3023":61799,"_26291":61756,"_18309":103878,"_5":12556,"_24913":103779,"_2529":103879},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3023":61800,"_26291":61756,"_18309":103881,"_5":12556,"_24913":103783,"_2529":103882},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3023":61801,"_26291":61756,"_18309":103884,"_5":12556,"_24913":103783,"_2529":103885},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3023":61802,"_26291":61756,"_18309":103887,"_5":12556,"_24913":103783,"_2529":103888},[],"Convierte y comprueba el resultado:",{"_3023":61803,"_26291":61756,"_18309":103890,"_5":12556,"_24913":103783,"_2529":103891},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3023":61804,"_26291":61756,"_18309":103893,"_5":12556,"_24913":103787,"_2529":103894},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3023":61805,"_26291":61756,"_18309":103896,"_5":12556,"_24913":103787,"_2529":103897},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3023":61806,"_26291":61806,"_5":12871,"_2529":103261,"_26635":103899,"_18309":103900,"_24913":61806},[42855,102114,45173,103086,103261],[],{"_3023":61807,"_26291":61806,"_18309":103902,"_5":12556,"_24913":61806,"_2529":103903},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3023":61808,"_26291":61806,"_5":26632,"_18309":103905,"_24913":103906,"_2529":103907},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3023":61809,"_26291":61806,"_5":26632,"_18309":103909,"_24913":103910,"_2529":103911},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3023":61810,"_26291":61806,"_5":26632,"_18309":103913,"_24913":103914,"_2529":103915},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3023":61811,"_26291":61806,"_5":26632,"_18309":103917,"_24913":103918,"_2529":103919},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3023":61812,"_26291":61806,"_18309":103921,"_5":12556,"_24913":61806,"_2529":103922},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3023":61813,"_26291":61806,"_18309":103924,"_5":12556,"_24913":103906,"_2529":103925},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3023":61814,"_26291":61806,"_18309":103927,"_5":12556,"_24913":103906,"_2529":103928},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3023":61815,"_26291":61806,"_18309":103930,"_5":12556,"_24913":103906,"_2529":103931},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3023":61816,"_26291":61806,"_18309":103933,"_5":12556,"_24913":103906,"_2529":103934},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3023":61817,"_26291":61806,"_18309":103936,"_5":12556,"_24913":103906,"_2529":103937},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3023":61818,"_26291":61806,"_18309":103939,"_5":12556,"_24913":103906,"_2529":103940},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3023":61819,"_26291":61806,"_18309":103942,"_5":12556,"_24913":103910,"_2529":103943},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3023":61820,"_26291":61806,"_18309":103945,"_5":12556,"_24913":103910,"_2529":103946},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3023":61821,"_26291":61806,"_18309":103948,"_5":12556,"_24913":103910,"_2529":103949},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3023":61822,"_26291":61806,"_18309":103951,"_5":12556,"_24913":103910,"_2529":103952},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3023":61823,"_26291":61806,"_18309":103954,"_5":12556,"_24913":103914,"_2529":103955},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3023":61824,"_26291":61806,"_18309":103957,"_5":12556,"_24913":103914,"_2529":103958},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3023":61825,"_26291":61806,"_18309":103960,"_5":12556,"_24913":103914,"_2529":103961},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3023":61826,"_26291":61806,"_18309":103963,"_5":12556,"_24913":103914,"_2529":103964},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3023":61827,"_26291":61806,"_18309":103966,"_5":12556,"_24913":103918,"_2529":103967},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3023":61828,"_26291":61806,"_18309":103969,"_5":12556,"_24913":103918,"_2529":103970},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3023":61829,"_26291":61829,"_5":12871,"_2529":103972,"_26635":103973,"_18309":103974,"_24913":61829},"Estrategias de aprovisionamiento",[42855,102114,45173,103086,103261],[],{"_3023":61830,"_26291":61829,"_18309":103976,"_5":12556,"_24913":61829,"_2529":103977},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3023":61831,"_26291":61829,"_5":26632,"_18309":103979,"_24913":103980,"_2529":103981},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3023":61832,"_26291":61829,"_5":26632,"_18309":103983,"_24913":103984,"_2529":103985},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3023":61833,"_26291":61829,"_5":26632,"_18309":103987,"_24913":103988,"_2529":103989},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3023":61834,"_26291":61829,"_5":26632,"_18309":103991,"_24913":103992,"_2529":103993},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3023":61835,"_26291":61829,"_5":26632,"_18309":103995,"_24913":103996,"_2529":103997},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3023":61836,"_26291":61829,"_18309":103999,"_5":12556,"_24913":61829,"_2529":104000},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3023":61837,"_26291":61829,"_18309":104002,"_5":12556,"_24913":103980,"_2529":104003},[],"Recorrido",{"_3023":61838,"_26291":61829,"_18309":104005,"_5":12556,"_24913":103980,"_2529":104006},[],"Cuándo existe el dispositivo",{"_3023":61839,"_26291":61829,"_18309":104008,"_5":12556,"_24913":103980,"_2529":104009},[],"Qué compruebas",{"_3023":61840,"_26291":61829,"_18309":104011,"_5":12556,"_24913":103980,"_2529":104012},[],"Asignación manual",{"_3023":61841,"_26291":61829,"_18309":104014,"_5":12556,"_24913":103980,"_2529":104015},[],"El operador lo crea antes de asociar un certificado.",{"_3023":61842,"_26291":61829,"_18309":104017,"_5":12556,"_24913":103980,"_2529":104018},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3023":61843,"_26291":61829,"_18309":104020,"_5":12556,"_24913":103980,"_2529":104021},[],"EST con `JITP`",{"_3023":61844,"_26291":61829,"_18309":104023,"_5":12556,"_24913":103980,"_2529":104024},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3023":61845,"_26291":61829,"_18309":104026,"_5":12556,"_24913":103980,"_2529":104027},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3023":61846,"_26291":61829,"_18309":104029,"_5":12556,"_24913":103980,"_2529":104030},[],"EST con `PRE_REGISTRATION`",{"_3023":61847,"_26291":61829,"_18309":104032,"_5":12556,"_24913":103980,"_2529":104033},[],"Debe existir antes de `/simpleenroll`.",{"_3023":61848,"_26291":61829,"_18309":104035,"_5":12556,"_24913":103980,"_2529":104036},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3023":61849,"_26291":61829,"_18309":104038,"_5":12556,"_24913":103980,"_2529":104039},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3023":61850,"_26291":61829,"_18309":104041,"_5":12556,"_24913":103980,"_2529":104042},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3023":61851,"_26291":61829,"_18309":104044,"_5":12556,"_24913":103984,"_2529":104045},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3023":61852,"_26291":61829,"_18309":104047,"_5":12556,"_24913":103984,"_2529":104048},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3023":61853,"_26291":61829,"_18309":104050,"_5":12556,"_24913":103984,"_2529":104051},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3023":61854,"_26291":61829,"_18309":104053,"_5":12556,"_24913":103988,"_2529":104054},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3023":61855,"_26291":61829,"_18309":104056,"_5":12556,"_24913":103988,"_2529":104057},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3023":61856,"_26291":61829,"_18309":104059,"_5":12556,"_24913":103988,"_2529":104060},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3023":61857,"_26291":61829,"_18309":104062,"_5":12556,"_24913":103988,"_2529":104063},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3023":61858,"_26291":61829,"_18309":104065,"_5":12556,"_24913":103988,"_2529":104066},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3023":61859,"_26291":61829,"_18309":104068,"_5":12556,"_24913":103988,"_2529":104069},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3023":61860,"_26291":61829,"_18309":104071,"_5":12556,"_24913":103992,"_2529":101172},[],{"_3023":61861,"_26291":61829,"_18309":104073,"_5":12556,"_24913":103992,"_2529":104074},[],"Material que atraviesa EST",{"_3023":61862,"_26291":61829,"_18309":104076,"_5":12556,"_24913":103992,"_2529":104077},[],"Clave generada por el dispositivo",{"_3023":61863,"_26291":61829,"_18309":104079,"_5":12556,"_24913":103992,"_2529":104080},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3023":61864,"_26291":61829,"_18309":104082,"_5":12556,"_24913":103992,"_2529":104083},[],"Clave ya disponible en el dispositivo",{"_3023":61865,"_26291":61829,"_18309":104085,"_5":12556,"_24913":103992,"_2529":104086},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3023":61866,"_26291":61829,"_18309":104088,"_5":12556,"_24913":103992,"_2529":45492},[],{"_3023":61867,"_26291":61829,"_18309":104090,"_5":12556,"_24913":103992,"_2529":104091},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3023":61868,"_26291":61829,"_18309":104093,"_5":12556,"_24913":103992,"_2529":104094},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3023":61869,"_26291":61829,"_18309":104096,"_5":12556,"_24913":103996,"_2529":104097},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3023":61870,"_26291":61870,"_5":12871,"_2529":104099,"_26635":104100,"_18309":104101,"_24913":61870},"Renovación y recuperación",[42855,102114,45173,103086,103261],[],{"_3023":61871,"_26291":61870,"_18309":104103,"_5":12556,"_24913":61870,"_2529":104104},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3023":61872,"_26291":61870,"_5":26632,"_18309":104106,"_24913":104107,"_2529":104108},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3023":61873,"_26291":61870,"_5":26632,"_18309":104110,"_24913":104111,"_2529":104112},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3023":61874,"_26291":61870,"_5":26632,"_18309":104114,"_24913":104115,"_2529":104116},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3023":61875,"_26291":61870,"_5":26632,"_18309":104118,"_24913":104119,"_2529":104120},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3023":61876,"_26291":61870,"_5":26632,"_18309":104122,"_24913":104123,"_2529":104124},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3023":61877,"_26291":61870,"_18309":104126,"_5":12556,"_24913":61870,"_2529":104127},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3023":61878,"_26291":61870,"_18309":104129,"_5":12556,"_24913":104107,"_2529":104130},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3023":61879,"_26291":61870,"_18309":104132,"_5":12556,"_24913":104107,"_2529":104133},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3023":61880,"_26291":61870,"_18309":104135,"_5":12556,"_24913":104107,"_2529":104136},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3023":61881,"_26291":61870,"_18309":104138,"_5":12556,"_24913":104107,"_2529":104139},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3023":61882,"_26291":61870,"_18309":104141,"_5":12556,"_24913":104111,"_2529":104142},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3023":61883,"_26291":61870,"_18309":104144,"_5":12556,"_24913":104111,"_2529":104145},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3023":61884,"_26291":61870,"_18309":104147,"_5":12556,"_24913":104115,"_2529":104148},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3023":61885,"_26291":61870,"_18309":104150,"_5":12556,"_24913":104115,"_2529":104151},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3023":61886,"_26291":61870,"_18309":104153,"_5":12556,"_24913":104115,"_2529":104154},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3023":61887,"_26291":61870,"_18309":104156,"_5":12556,"_24913":104119,"_2529":104157},[],"Situación",{"_3023":61888,"_26291":61870,"_18309":104159,"_5":12556,"_24913":104119,"_2529":104160},[],"Procedimiento",{"_3023":61889,"_26291":61870,"_18309":104162,"_5":12556,"_24913":104119,"_2529":104163},[],"Certificado vigente, fuera de ventana",{"_3023":61890,"_26291":61870,"_18309":104165,"_5":12556,"_24913":104119,"_2529":104166},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3023":61891,"_26291":61870,"_18309":104168,"_5":12556,"_24913":104119,"_2529":104169},[],"Certificado vencido, clave disponible",{"_3023":61892,"_26291":61870,"_18309":104171,"_5":12556,"_24913":104119,"_2529":104172},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3023":61893,"_26291":61870,"_18309":104174,"_5":12556,"_24913":104119,"_2529":104175},[],"Renovación por webhook o `NO_AUTH`",{"_3023":61894,"_26291":61870,"_18309":104177,"_5":12556,"_24913":104119,"_2529":104178},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3023":61895,"_26291":61870,"_18309":104180,"_5":12556,"_24913":104119,"_2529":104181},[],"Clave perdida o inaccesible",{"_3023":61896,"_26291":61870,"_18309":104183,"_5":12556,"_24913":104119,"_2529":104184},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3023":61897,"_26291":61870,"_18309":104186,"_5":12556,"_24913":104119,"_2529":104187},[],"Identidad actual revocada",{"_3023":61898,"_26291":61870,"_18309":104189,"_5":12556,"_24913":104119,"_2529":104190},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3023":61899,"_26291":61870,"_18309":104192,"_5":12556,"_24913":104119,"_2529":104193},[],"Dispositivo sin identidad",{"_3023":61900,"_26291":61870,"_18309":104195,"_5":12556,"_24913":104119,"_2529":104196},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3023":61901,"_26291":61870,"_18309":104198,"_5":12556,"_24913":104119,"_2529":104199},[],"Dispositivo retirado",{"_3023":61902,"_26291":61870,"_18309":104201,"_5":12556,"_24913":104119,"_2529":104202},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3023":61903,"_26291":61870,"_18309":104204,"_5":12556,"_24913":104119,"_2529":104205},[],"Timeout, HTTP 500 o fallo de instalación",{"_3023":61904,"_26291":61870,"_18309":104207,"_5":12556,"_24913":104119,"_2529":104208},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3023":61905,"_26291":61870,"_18309":104210,"_5":12556,"_24913":104123,"_2529":104211},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3023":61906,"_26291":61870,"_18309":104213,"_5":12556,"_24913":104123,"_2529":104214},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3023":61907,"_26291":61907,"_5":12871,"_2529":104216,"_26635":104217,"_18309":104218,"_24913":61907},"Diagnóstico de enrolamiento",[42855,102114,45173,103086,103261],[],{"_3023":61908,"_26291":61907,"_18309":104220,"_5":12556,"_24913":61907,"_2529":104221},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3023":61909,"_26291":61907,"_5":26632,"_18309":104223,"_24913":104224,"_2529":104225},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3023":61910,"_26291":61907,"_5":26632,"_18309":104227,"_24913":104228,"_2529":104229},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3023":61911,"_26291":61907,"_5":26632,"_18309":104231,"_24913":104232,"_2529":103788},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3023":61912,"_26291":61907,"_5":26632,"_18309":104234,"_24913":104235,"_2529":104236},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3023":61913,"_26291":61907,"_18309":104238,"_5":12556,"_24913":61907,"_2529":104239},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3023":61914,"_26291":61907,"_18309":104241,"_5":12556,"_24913":104228,"_2529":104242},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3023":61915,"_26291":61907,"_18309":104244,"_5":12556,"_24913":104228,"_2529":104245},[],"Síntoma o mensaje",{"_3023":61916,"_26291":61907,"_18309":104247,"_5":12556,"_24913":104228,"_2529":104248},[],"Qué revisar",{"_3023":61917,"_26291":61907,"_18309":104250,"_5":12556,"_24913":104228,"_2529":104251},[],"curl rechaza TLS, nombre o emisor",{"_3023":61918,"_26291":61907,"_18309":104253,"_5":12556,"_24913":104228,"_2529":104254},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3023":61919,"_26291":61907,"_18309":104256,"_5":12556,"_24913":104228,"_2529":104257},[],"404 o APS ausente",{"_3023":61920,"_26291":61907,"_18309":104259,"_5":12556,"_24913":104228,"_2529":104260},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3023":61921,"_26291":61907,"_18309":104262,"_5":12556,"_24913":104228,"_2529":104263},[],"400, error de CSR o formato",{"_3023":61922,"_26291":61907,"_18309":104265,"_5":12556,"_24913":104228,"_2529":104266},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3023":61923,"_26291":61907,"_18309":104268,"_5":12556,"_24913":104228,"_2529":104269},[],"Credencial ausente o certificado no válido",{"_3023":61924,"_26291":61907,"_18309":104271,"_5":12556,"_24913":104228,"_2529":104272},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3023":61925,"_26291":61907,"_18309":104274,"_5":12556,"_24913":104228,"_2529":104275},[],"Webhook deniega, expira o responde sin autorización",{"_3023":61926,"_26291":61907,"_18309":104277,"_5":12556,"_24913":104228,"_2529":104278},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3023":61927,"_26291":61907,"_18309":104280,"_5":12556,"_24913":104228,"_2529":46412},[],{"_3023":61928,"_26291":61907,"_18309":104282,"_5":12556,"_24913":104228,"_2529":104283},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3023":61929,"_26291":61907,"_18309":104285,"_5":12556,"_24913":104228,"_2529":46418},[],{"_3023":61930,"_26291":61907,"_18309":104287,"_5":12556,"_24913":104228,"_2529":104288},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3023":61931,"_26291":61907,"_18309":104290,"_5":12556,"_24913":104228,"_2529":46424},[],{"_3023":61932,"_26291":61907,"_18309":104292,"_5":12556,"_24913":104228,"_2529":104293},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3023":61933,"_26291":61907,"_18309":104295,"_5":12556,"_24913":104228,"_2529":46430},[],{"_3023":61934,"_26291":61907,"_18309":104297,"_5":12556,"_24913":104228,"_2529":104298},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3023":61935,"_26291":61907,"_18309":104300,"_5":12556,"_24913":104228,"_2529":46436},[],{"_3023":61936,"_26291":61907,"_18309":104302,"_5":12556,"_24913":104228,"_2529":104303},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3023":61937,"_26291":61907,"_18309":104305,"_5":12556,"_24913":104228,"_2529":104306},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3023":61938,"_26291":61907,"_18309":104308,"_5":12556,"_24913":104228,"_2529":104309},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3023":61939,"_26291":61907,"_18309":104311,"_5":12556,"_24913":104228,"_2529":104312},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3023":61940,"_26291":61907,"_18309":104314,"_5":12556,"_24913":104228,"_2529":104315},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3023":61941,"_26291":61907,"_18309":104317,"_5":12556,"_24913":104228,"_2529":46454},[],{"_3023":61942,"_26291":61907,"_18309":104319,"_5":12556,"_24913":104228,"_2529":104320},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3023":61943,"_26291":61907,"_18309":104322,"_5":12556,"_24913":104228,"_2529":46460},[],{"_3023":61944,"_26291":61907,"_18309":104324,"_5":12556,"_24913":104228,"_2529":104325},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3023":61945,"_26291":61907,"_18309":104327,"_5":12556,"_24913":104228,"_2529":104328},[],"DMS propietario distinto",{"_3023":61946,"_26291":61907,"_18309":104330,"_5":12556,"_24913":104228,"_2529":104331},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3023":61947,"_26291":61907,"_18309":104333,"_5":12556,"_24913":104228,"_2529":46472},[],{"_3023":61948,"_26291":61907,"_18309":104335,"_5":12556,"_24913":104228,"_2529":104336},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3023":61949,"_26291":61907,"_18309":104338,"_5":12556,"_24913":104228,"_2529":46478},[],{"_3023":61950,"_26291":61907,"_18309":104340,"_5":12556,"_24913":104228,"_2529":104341},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3023":61951,"_26291":61907,"_18309":104343,"_5":12556,"_24913":104228,"_2529":104344},[],"Certificado actual revocado",{"_3023":61952,"_26291":61907,"_18309":104346,"_5":12556,"_24913":104228,"_2529":104347},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3023":61953,"_26291":61907,"_18309":104349,"_5":12556,"_24913":104228,"_2529":104350},[],"Error de CA, perfil o firma",{"_3023":61954,"_26291":61907,"_18309":104352,"_5":12556,"_24913":104228,"_2529":104353},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3023":61955,"_26291":61907,"_18309":104355,"_5":12556,"_24913":104228,"_2529":104356},[],"HTTP 200 sin conexión del dispositivo",{"_3023":61956,"_26291":61907,"_18309":104358,"_5":12556,"_24913":104228,"_2529":104359},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3023":61957,"_26291":61907,"_18309":104361,"_5":12556,"_24913":104228,"_2529":104362},[],"Timeout o error después de emitir",{"_3023":61958,"_26291":61907,"_18309":104364,"_5":12556,"_24913":104228,"_2529":104365},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3023":61959,"_26291":61907,"_18309":104367,"_5":12556,"_24913":104232,"_2529":104368},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3023":61960,"_26291":61907,"_18309":104370,"_5":12556,"_24913":104232,"_2529":104371},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3023":61961,"_26291":61907,"_18309":104373,"_5":12556,"_24913":104235,"_2529":104374},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3023":61962,"_26291":61907,"_18309":104376,"_5":12556,"_24913":104235,"_2529":104377},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3023":61963,"_26291":61907,"_18309":104379,"_5":12556,"_24913":104235,"_2529":104380},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3023":61964,"_26291":61907,"_18309":104382,"_5":12556,"_24913":104235,"_2529":104383},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3023":61965,"_26291":61907,"_18309":104385,"_5":12556,"_24913":104235,"_2529":104386},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3023":61966,"_26291":61907,"_18309":104388,"_5":12556,"_24913":104235,"_2529":104389},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3023":61967,"_26291":61907,"_18309":104391,"_5":12556,"_24913":104235,"_2529":104392},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3023":61968,"_26291":61968,"_5":12871,"_2529":104394,"_26635":104395,"_18309":104396,"_24913":61968},"Distribución y actualización de confianza",[42855,102114,45173,103086,103261],[],{"_3023":61969,"_26291":61968,"_18309":104398,"_5":12556,"_24913":61968,"_2529":104399},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3023":61970,"_26291":61968,"_5":26632,"_18309":104401,"_24913":104402,"_2529":104403},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3023":61971,"_26291":61968,"_5":26632,"_18309":104405,"_24913":104406,"_2529":104407},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3023":61972,"_26291":61968,"_5":26632,"_18309":104409,"_24913":104410,"_2529":104411},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3023":61973,"_26291":61968,"_5":26632,"_18309":104413,"_24913":104414,"_2529":104415},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3023":61974,"_26291":61968,"_5":26632,"_18309":104417,"_24913":104418,"_2529":104419},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3023":61975,"_26291":61968,"_18309":104421,"_5":12556,"_24913":61968,"_2529":104422},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3023":61976,"_26291":61968,"_18309":104424,"_5":12556,"_24913":104402,"_2529":104425},[],"Relación",{"_3023":61977,"_26291":61968,"_18309":104427,"_5":12556,"_24913":104402,"_2529":104428},[],"Material que prepara el responsable",{"_3023":61978,"_26291":61968,"_18309":104430,"_5":12556,"_24913":104402,"_2529":104431},[],"Dispositivo → servidor EST",{"_3023":61979,"_26291":61968,"_18309":104433,"_5":12556,"_24913":104402,"_2529":104434},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3023":61980,"_26291":61968,"_18309":104436,"_5":12556,"_24913":104402,"_2529":104437},[],"DMS → solicitante",{"_3023":61981,"_26291":61968,"_18309":104439,"_5":12556,"_24913":104402,"_2529":104440},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3023":61982,"_26291":61968,"_18309":104442,"_5":12556,"_24913":104402,"_2529":104443},[],"Consumidor → dispositivo",{"_3023":61983,"_26291":61968,"_18309":104445,"_5":12556,"_24913":104402,"_2529":104446},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3023":61984,"_26291":61968,"_18309":104448,"_5":12556,"_24913":104402,"_2529":104449},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3023":61985,"_26291":61968,"_18309":104451,"_5":12556,"_24913":104406,"_2529":104452},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3023":61986,"_26291":61968,"_18309":104454,"_5":12556,"_24913":104406,"_2529":104455},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3023":61987,"_26291":61968,"_18309":104457,"_5":12556,"_24913":104410,"_2529":104458},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3023":61988,"_26291":61968,"_18309":104460,"_5":12556,"_24913":104410,"_2529":104461},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3023":61989,"_26291":61968,"_18309":104463,"_5":12556,"_24913":104410,"_2529":104464},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3023":61990,"_26291":61968,"_18309":104466,"_5":12556,"_24913":104410,"_2529":104467},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3023":61991,"_26291":61968,"_18309":104469,"_5":12556,"_24913":104410,"_2529":104470},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3023":61992,"_26291":61968,"_18309":104472,"_5":12556,"_24913":104410,"_2529":104473},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3023":61993,"_26291":61968,"_18309":104475,"_5":12556,"_24913":104414,"_2529":104476},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3023":61994,"_26291":61968,"_18309":104478,"_5":12556,"_24913":104414,"_2529":104479},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Al cambiar la CA de enrolamiento, añade a esa lista la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3023":61995,"_26291":61968,"_18309":104481,"_5":12556,"_24913":104414,"_2529":104482},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3023":61996,"_26291":61968,"_18309":104484,"_5":12556,"_24913":104418,"_2529":104485},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3023":61997,"_26291":61997,"_5":12871,"_2529":46627,"_26635":104487,"_18309":104489,"_24913":61997},[42855,102114,45173,103086,104488],"Integraciones",[],{"_3023":61998,"_26291":61997,"_18309":104491,"_5":12556,"_24913":61997,"_2529":104492},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3023":61999,"_26291":61997,"_5":26632,"_18309":104494,"_24913":104495,"_2529":104496},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3023":62000,"_26291":61997,"_5":26632,"_18309":104498,"_24913":104499,"_2529":104500},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3023":62001,"_26291":61997,"_5":26632,"_18309":104502,"_24913":104503,"_2529":104504},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3023":62002,"_26291":61997,"_5":26632,"_18309":104506,"_24913":104507,"_2529":104508},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3023":62003,"_26291":61997,"_5":26632,"_18309":104510,"_24913":104511,"_2529":104512},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3023":62004,"_26291":61997,"_5":26632,"_18309":104514,"_24913":104515,"_2529":104516},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3023":62005,"_26291":61997,"_5":26632,"_18309":104518,"_24913":104519,"_2529":46661},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3023":62006,"_26291":61997,"_5":26632,"_18309":104521,"_24913":104522,"_2529":46665},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3023":62007,"_26291":61997,"_5":26632,"_18309":104524,"_24913":104525,"_2529":104526},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3023":62008,"_26291":61997,"_5":26632,"_18309":104528,"_24913":104529,"_2529":104530},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3023":62009,"_26291":61997,"_5":26632,"_18309":104532,"_24913":104533,"_2529":104534},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3023":62010,"_26291":61997,"_5":26632,"_18309":104536,"_24913":104537,"_2529":104538},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3023":62011,"_26291":61997,"_5":26632,"_18309":104540,"_24913":104541,"_2529":104542},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3023":62012,"_26291":61997,"_5":26632,"_18309":104544,"_24913":104545,"_2529":104546},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3023":62013,"_26291":61997,"_5":26632,"_18309":104548,"_24913":104549,"_2529":104550},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3023":62014,"_26291":61997,"_5":26632,"_18309":104552,"_24913":104553,"_2529":104554},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3023":62015,"_26291":61997,"_5":26632,"_18309":104556,"_24913":104557,"_2529":104558},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3023":62016,"_26291":61997,"_5":26632,"_18309":104560,"_24913":104561,"_2529":104562},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3023":62017,"_26291":61997,"_5":26632,"_18309":104564,"_24913":104565,"_2529":104566},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3023":62018,"_26291":61997,"_5":26632,"_18309":104568,"_24913":104569,"_2529":104570},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3023":62019,"_26291":61997,"_18309":104572,"_5":12556,"_24913":61997,"_2529":104573},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3023":62020,"_26291":61997,"_18309":104575,"_5":12556,"_24913":61997,"_2529":104576},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3023":62021,"_26291":61997,"_18309":104578,"_5":12556,"_24913":61997,"_2529":104579},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3023":62022,"_26291":61997,"_18309":104581,"_5":12556,"_24913":104495,"_2529":104582},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3023":62023,"_26291":61997,"_18309":104584,"_5":12556,"_24913":104495,"_2529":104585},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3023":62024,"_26291":61997,"_18309":104587,"_5":12556,"_24913":104495,"_2529":104588},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3023":62025,"_26291":61997,"_18309":104590,"_5":12556,"_24913":104495,"_2529":104591},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3023":62026,"_26291":61997,"_18309":104593,"_5":12556,"_24913":104499,"_2529":104594},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3023":62027,"_26291":61997,"_18309":104596,"_5":12556,"_24913":104503,"_2529":104597},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3023":62028,"_26291":61997,"_18309":104599,"_5":12556,"_24913":104503,"_2529":104600},[],"Acción IAM",{"_3023":62029,"_26291":61997,"_18309":104602,"_5":12556,"_24913":104503,"_2529":101178},[],{"_3023":62030,"_26291":61997,"_18309":104604,"_5":12556,"_24913":104503,"_2529":46748},[],{"_3023":62031,"_26291":61997,"_18309":104606,"_5":12556,"_24913":104503,"_2529":104607},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3023":62032,"_26291":61997,"_18309":104609,"_5":12556,"_24913":104503,"_2529":46754},[],{"_3023":62033,"_26291":61997,"_18309":104611,"_5":12556,"_24913":104503,"_2529":104612},[],"Registrar la CA en AWS IoT",{"_3023":62034,"_26291":61997,"_18309":104614,"_5":12556,"_24913":104503,"_2529":46760},[],{"_3023":62035,"_26291":61997,"_18309":104616,"_5":12556,"_24913":104503,"_2529":104617},[],"Consultar el estado del registro de la CA",{"_3023":62036,"_26291":61997,"_18309":104619,"_5":12556,"_24913":104503,"_2529":46766},[],{"_3023":62037,"_26291":61997,"_18309":104621,"_5":12556,"_24913":104503,"_2529":104622},[],"Crear o actualizar Things en IoT Core",{"_3023":62038,"_26291":61997,"_18309":104624,"_5":12556,"_24913":104503,"_2529":46772},[],{"_3023":62039,"_26291":61997,"_18309":104626,"_5":12556,"_24913":104503,"_2529":104627},[],"Aprovisionar Things mediante plantilla",{"_3023":62040,"_26291":61997,"_18309":104629,"_5":12556,"_24913":104503,"_2529":46778},[],{"_3023":62041,"_26291":61997,"_18309":104631,"_5":12556,"_24913":104503,"_2529":104632},[],"Registrar certificados de dispositivo",{"_3023":62042,"_26291":61997,"_18309":104634,"_5":12556,"_24913":104503,"_2529":46784},[],{"_3023":62043,"_26291":61997,"_18309":104636,"_5":12556,"_24913":104503,"_2529":104637},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3023":62044,"_26291":61997,"_18309":104639,"_5":12556,"_24913":104503,"_2529":46790},[],{"_3023":62045,"_26291":61997,"_18309":104641,"_5":12556,"_24913":104503,"_2529":104642},[],"Crear y adjuntar políticas IoT",{"_3023":62046,"_26291":61997,"_18309":104644,"_5":12556,"_24913":104503,"_2529":46796},[],{"_3023":62047,"_26291":61997,"_18309":104646,"_5":12556,"_24913":104503,"_2529":104647},[],"Gestionar grupos de Things",{"_3023":62048,"_26291":61997,"_18309":104649,"_5":12556,"_24913":104503,"_2529":46802},[],{"_3023":62049,"_26291":61997,"_18309":104651,"_5":12556,"_24913":104503,"_2529":104652},[],"Crear plantillas JITP",{"_3023":62050,"_26291":61997,"_18309":104654,"_5":12556,"_24913":104503,"_2529":46808},[],{"_3023":62051,"_26291":61997,"_18309":104656,"_5":12556,"_24913":104503,"_2529":104657},[],"Leer y escribir el Device Shadow",{"_3023":62052,"_26291":61997,"_18309":104659,"_5":12556,"_24913":104503,"_2529":104660},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3023":62053,"_26291":61997,"_18309":104662,"_5":12556,"_24913":104507,"_2529":104663},[],"Parámetro",{"_3023":62054,"_26291":61997,"_18309":104665,"_5":12556,"_24913":104507,"_2529":104666},[],"Tipo",{"_3023":62055,"_26291":61997,"_18309":104668,"_5":12556,"_24913":104507,"_2529":104669},[],"Requerido",{"_3023":62056,"_26291":61997,"_18309":104671,"_5":12556,"_24913":104507,"_2529":104672},[],"Descripción",{"_3023":62057,"_26291":61997,"_18309":104674,"_5":12556,"_24913":104507,"_2529":46829},[],{"_3023":62058,"_26291":61997,"_18309":104676,"_5":12556,"_24913":104507,"_2529":21905},[],{"_3023":62059,"_26291":61997,"_18309":104678,"_5":12556,"_24913":104507,"_2529":104679},[],"Sí",{"_3023":62060,"_26291":61997,"_18309":104681,"_5":12556,"_24913":104507,"_2529":104682},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3023":62061,"_26291":61997,"_18309":104684,"_5":12556,"_24913":104507,"_2529":46840},[],{"_3023":62062,"_26291":61997,"_18309":104686,"_5":12556,"_24913":104507,"_2529":21905},[],{"_3023":62063,"_26291":61997,"_18309":104688,"_5":12556,"_24913":104507,"_2529":104679},[],{"_3023":62064,"_26291":61997,"_18309":104690,"_5":12556,"_24913":104507,"_2529":104691},[],"Región AWS donde opera el conector.",{"_3023":62065,"_26291":61997,"_18309":104693,"_5":12556,"_24913":104507,"_2529":46850},[],{"_3023":62066,"_26291":61997,"_18309":104695,"_5":12556,"_24913":104507,"_2529":21905},[],{"_3023":62067,"_26291":61997,"_18309":104697,"_5":12556,"_24913":104507,"_2529":104679},[],{"_3023":62068,"_26291":61997,"_18309":104699,"_5":12556,"_24913":104507,"_2529":104700},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3023":62069,"_26291":61997,"_18309":104702,"_5":12556,"_24913":104507,"_2529":46860},[],{"_3023":62070,"_26291":61997,"_18309":104704,"_5":12556,"_24913":104507,"_2529":21905},[],{"_3023":62071,"_26291":61997,"_18309":104706,"_5":12556,"_24913":104507,"_2529":104707},[],"Solo con `auth_method=static`",{"_3023":62072,"_26291":61997,"_18309":104709,"_5":12556,"_24913":104507,"_2529":104710},[],"Clave de acceso AWS.",{"_3023":62073,"_26291":61997,"_18309":104712,"_5":12556,"_24913":104507,"_2529":46871},[],{"_3023":62074,"_26291":61997,"_18309":104714,"_5":12556,"_24913":104507,"_2529":21905},[],{"_3023":62075,"_26291":61997,"_18309":104716,"_5":12556,"_24913":104507,"_2529":104707},[],{"_3023":62076,"_26291":61997,"_18309":104718,"_5":12556,"_24913":104507,"_2529":104719},[],"Clave secreta AWS.",{"_3023":62077,"_26291":61997,"_18309":104721,"_5":12556,"_24913":104507,"_2529":46881},[],{"_3023":62078,"_26291":61997,"_18309":104723,"_5":12556,"_24913":104507,"_2529":21905},[],{"_3023":62079,"_26291":61997,"_18309":104725,"_5":12556,"_24913":104507,"_2529":46886},[],{"_3023":62080,"_26291":61997,"_18309":104727,"_5":12556,"_24913":104507,"_2529":104728},[],"Token de sesión (con `auth_method=static`).",{"_3023":62081,"_26291":61997,"_18309":104730,"_5":12556,"_24913":104507,"_2529":46892},[],{"_3023":62082,"_26291":61997,"_18309":104732,"_5":12556,"_24913":104507,"_2529":21905},[],{"_3023":62083,"_26291":61997,"_18309":104734,"_5":12556,"_24913":104507,"_2529":104735},[],"Solo con `auth_method=role`",{"_3023":62084,"_26291":61997,"_18309":104737,"_5":12556,"_24913":104507,"_2529":104738},[],"ARN del rol a asumir.",{"_3023":62085,"_26291":61997,"_18309":104740,"_5":12556,"_24913":104507,"_2529":46903},[],{"_3023":62086,"_26291":61997,"_18309":104742,"_5":12556,"_24913":104507,"_2529":21905},[],{"_3023":62087,"_26291":61997,"_18309":104744,"_5":12556,"_24913":104507,"_2529":46886},[],{"_3023":62088,"_26291":61997,"_18309":104746,"_5":12556,"_24913":104507,"_2529":104747},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3023":62089,"_26291":61997,"_18309":104749,"_5":12556,"_24913":104507,"_2529":46913},[],{"_3023":62090,"_26291":61997,"_18309":104751,"_5":12556,"_24913":104507,"_2529":15370},[],{"_3023":62091,"_26291":61997,"_18309":104753,"_5":12556,"_24913":104507,"_2529":104679},[],{"_3023":62092,"_26291":61997,"_18309":104755,"_5":12556,"_24913":104507,"_2529":104756},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3023":62093,"_26291":61997,"_18309":104758,"_5":12556,"_24913":104507,"_2529":46923},[],{"_3023":62094,"_26291":61997,"_18309":104760,"_5":12556,"_24913":104507,"_2529":21905},[],{"_3023":62095,"_26291":61997,"_18309":104762,"_5":12556,"_24913":104507,"_2529":104679},[],{"_3023":62096,"_26291":61997,"_18309":104764,"_5":12556,"_24913":104507,"_2529":104765},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3023":62097,"_26291":61997,"_18309":104767,"_5":12556,"_24913":104507,"_2529":46933},[],{"_3023":62098,"_26291":61997,"_18309":104769,"_5":12556,"_24913":104507,"_2529":21905},[],{"_3023":62099,"_26291":61997,"_18309":104771,"_5":12556,"_24913":104507,"_2529":104679},[],{"_3023":62100,"_26291":61997,"_18309":104773,"_5":12556,"_24913":104507,"_2529":104774},[],"URL HTTP del Device Manager de Lamassu.",{"_3023":62101,"_26291":61997,"_18309":104776,"_5":12556,"_24913":104507,"_2529":46943},[],{"_3023":62102,"_26291":61997,"_18309":104778,"_5":12556,"_24913":104507,"_2529":21905},[],{"_3023":62103,"_26291":61997,"_18309":104780,"_5":12556,"_24913":104507,"_2529":104679},[],{"_3023":62104,"_26291":61997,"_18309":104782,"_5":12556,"_24913":104507,"_2529":104783},[],"URL HTTP del servicio de CA de Lamassu.",{"_3023":62105,"_26291":61997,"_18309":104785,"_5":12556,"_24913":104511,"_2529":104786},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3023":62106,"_26291":61997,"_18309":104788,"_5":12556,"_24913":104515,"_2529":104789},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3023":62107,"_26291":61997,"_18309":104791,"_5":12556,"_24913":104515,"_2529":104792},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3023":62108,"_26291":61997,"_18309":104794,"_5":12556,"_24913":104519,"_2529":104795},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3023":62109,"_26291":61997,"_18309":104797,"_5":12556,"_24913":104519,"_2529":104798},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3023":62110,"_26291":61997,"_18309":104800,"_5":12556,"_24913":104519,"_2529":104801},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3023":62111,"_26291":61997,"_18309":104803,"_5":12556,"_24913":104519,"_2529":104804},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3023":62112,"_26291":61997,"_18309":104806,"_5":12556,"_24913":104519,"_2529":104807},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3023":62113,"_26291":61997,"_18309":104809,"_5":12556,"_24913":104519,"_2529":104810},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3023":62114,"_26291":61997,"_18309":104812,"_5":12556,"_24913":104522,"_2529":104813},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3023":62115,"_26291":61997,"_18309":104815,"_5":12556,"_24913":104525,"_2529":104816},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3023":62116,"_26291":61997,"_18309":104818,"_5":12556,"_24913":104525,"_2529":104819},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3023":62117,"_26291":61997,"_18309":104821,"_5":12556,"_24913":104529,"_2529":104822},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3023":62118,"_26291":61997,"_18309":104824,"_5":12556,"_24913":104533,"_2529":104825},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3023":62119,"_26291":61997,"_18309":104827,"_5":12556,"_24913":104533,"_2529":104828},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3023":62120,"_26291":61997,"_18309":104830,"_5":12556,"_24913":104533,"_2529":104831},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3023":62121,"_26291":61997,"_18309":104833,"_5":12556,"_24913":104533,"_2529":104834},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3023":62122,"_26291":61997,"_18309":104836,"_5":12556,"_24913":104533,"_2529":104837},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3023":62123,"_26291":61997,"_18309":104839,"_5":12556,"_24913":104533,"_2529":104840},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3023":62124,"_26291":61997,"_18309":104842,"_5":12556,"_24913":104537,"_2529":104843},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3023":62125,"_26291":61997,"_18309":104845,"_5":12556,"_24913":104537,"_2529":104846},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3023":62126,"_26291":61997,"_18309":104848,"_5":12556,"_24913":104537,"_2529":104849},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3023":62127,"_26291":61997,"_18309":104851,"_5":12556,"_24913":104541,"_2529":104852},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3023":62128,"_26291":61997,"_18309":104854,"_5":12556,"_24913":104541,"_2529":104855},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3023":62129,"_26291":61997,"_18309":104857,"_5":12556,"_24913":104541,"_2529":104858},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3023":62130,"_26291":61997,"_18309":104860,"_5":12556,"_24913":104545,"_2529":104861},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3023":62131,"_26291":61997,"_18309":104863,"_5":12556,"_24913":104545,"_2529":104864},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3023":62132,"_26291":61997,"_18309":104866,"_5":12556,"_24913":104545,"_2529":104867},[],"Para que el flujo JITP funcione correctamente:",{"_3023":62133,"_26291":61997,"_18309":104869,"_5":12556,"_24913":104545,"_2529":104870},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3023":62134,"_26291":61997,"_18309":104872,"_5":12556,"_24913":104545,"_2529":104873},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3023":62135,"_26291":61997,"_18309":104875,"_5":12556,"_24913":104545,"_2529":104876},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3023":62136,"_26291":61997,"_18309":104878,"_5":12556,"_24913":104545,"_2529":104879},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3023":62137,"_26291":61997,"_18309":104881,"_5":12556,"_24913":104549,"_2529":104882},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3023":62138,"_26291":61997,"_18309":104884,"_5":12556,"_24913":104549,"_2529":104885},[],"Estado en Lamassu",{"_3023":62139,"_26291":61997,"_18309":104887,"_5":12556,"_24913":104549,"_2529":104888},[],"Razón de revocación",{"_3023":62140,"_26291":61997,"_18309":104890,"_5":12556,"_24913":104549,"_2529":104891},[],"Estado en AWS IoT Core",{"_3023":62141,"_26291":61997,"_18309":104893,"_5":12556,"_24913":104549,"_2529":47064},[],{"_3023":62142,"_26291":61997,"_18309":104895,"_5":12556,"_24913":104549,"_2529":104896},[],"Ninguna",{"_3023":62143,"_26291":61997,"_18309":104898,"_5":12556,"_24913":104549,"_2529":47070},[],{"_3023":62144,"_26291":61997,"_18309":104900,"_5":12556,"_24913":104549,"_2529":47073},[],{"_3023":62145,"_26291":61997,"_18309":104902,"_5":12556,"_24913":104549,"_2529":47076},[],{"_3023":62146,"_26291":61997,"_18309":104904,"_5":12556,"_24913":104549,"_2529":47079},[],{"_3023":62147,"_26291":61997,"_18309":104906,"_5":12556,"_24913":104549,"_2529":47073},[],{"_3023":62148,"_26291":61997,"_18309":104908,"_5":12556,"_24913":104549,"_2529":104909},[],"Cualquier otra razón",{"_3023":62149,"_26291":61997,"_18309":104911,"_5":12556,"_24913":104549,"_2529":47087},[],{"_3023":62150,"_26291":61997,"_18309":104913,"_5":12556,"_24913":104549,"_2529":104914},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3023":62151,"_26291":61997,"_18309":104916,"_5":12556,"_24913":104553,"_2529":104917},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3023":62152,"_26291":61997,"_18309":104919,"_5":12556,"_24913":104553,"_2529":104920},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3023":62153,"_26291":61997,"_18309":104922,"_5":12556,"_24913":104553,"_2529":104923},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3023":62154,"_26291":61997,"_18309":104925,"_5":12556,"_24913":104557,"_2529":104926},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3023":62155,"_26291":61997,"_18309":104928,"_5":12556,"_24913":104557,"_2529":104929},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3023":62156,"_26291":61997,"_18309":104931,"_5":12556,"_24913":104561,"_2529":104932},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3023":62157,"_26291":61997,"_18309":104934,"_5":12556,"_24913":104561,"_2529":104935},[],"Existen dos tipos de acciones:",{"_3023":62158,"_26291":61997,"_18309":104937,"_5":12556,"_24913":104561,"_2529":104938},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3023":62159,"_26291":61997,"_18309":104940,"_5":12556,"_24913":104561,"_2529":104941},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3023":62160,"_26291":61997,"_18309":104943,"_5":12556,"_24913":104561,"_2529":104944},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3023":62161,"_26291":61997,"_18309":104946,"_5":12556,"_24913":104565,"_2529":104947},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3023":62162,"_26291":61997,"_18309":104949,"_5":12556,"_24913":104565,"_2529":104950},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3023":62163,"_26291":61997,"_18309":104952,"_5":12556,"_24913":104565,"_2529":104953},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3023":62164,"_26291":61997,"_18309":104955,"_5":12556,"_24913":104569,"_2529":104956},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3023":62165,"_26291":61997,"_18309":104958,"_5":12556,"_24913":104569,"_2529":104959},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3023":62166,"_26291":61997,"_18309":104961,"_5":12556,"_24913":104569,"_2529":104962},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3023":62167,"_26291":61997,"_18309":104964,"_5":12556,"_24913":104569,"_2529":104965},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3023":62168,"_26291":61997,"_18309":104967,"_5":12556,"_24913":104569,"_2529":104968},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3023":62169,"_26291":61997,"_18309":104970,"_5":12556,"_24913":104569,"_2529":104971},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3023":62170,"_26291":61997,"_18309":104973,"_5":12556,"_24913":104569,"_2529":104974},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3023":62171,"_26291":61997,"_18309":104976,"_5":12556,"_24913":104569,"_2529":104977},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3023":62172,"_26291":61997,"_18309":104979,"_5":12556,"_24913":104569,"_2529":104980},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3023":62173,"_26291":61997,"_18309":104982,"_5":12556,"_24913":104569,"_2529":104983},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3023":62174,"_26291":61997,"_18309":104985,"_5":12556,"_24913":104569,"_2529":104986},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3023":62175,"_26291":61997,"_18309":104988,"_5":12556,"_24913":104569,"_2529":104989},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3023":62176,"_26291":61997,"_18309":104991,"_5":12556,"_24913":104569,"_2529":104992},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3023":62177,"_26291":61997,"_18309":104994,"_5":12556,"_24913":104569,"_2529":104995},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3023":62178,"_26291":61997,"_18309":104997,"_5":12556,"_24913":104569,"_2529":104998},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3023":62179,"_26291":61997,"_18309":105000,"_5":12556,"_24913":104569,"_2529":105001},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3023":62180,"_26291":61997,"_18309":105003,"_5":12556,"_24913":104569,"_2529":105004},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3023":62181,"_26291":61997,"_18309":105006,"_5":12556,"_24913":104569,"_2529":105007},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3023":62182,"_26291":61997,"_18309":105009,"_5":12556,"_24913":104569,"_2529":105010},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3023":62183,"_26291":61997,"_18309":105012,"_5":12556,"_24913":104569,"_2529":105013},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3023":62184,"_26291":61997,"_18309":105015,"_5":12556,"_24913":104569,"_2529":105016},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3023":62185,"_26291":62185,"_5":12871,"_2529":45173,"_26635":105018,"_18309":105019,"_24913":62185},[42855,102114,45173],[],{"_3023":62186,"_26291":62185,"_18309":105021,"_5":12556,"_24913":62185,"_2529":105022},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3023":62187,"_26291":62185,"_5":26632,"_18309":105024,"_24913":105025,"_2529":105026},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3023":62188,"_26291":62185,"_5":26632,"_18309":105028,"_24913":105029,"_2529":103086},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3023":62189,"_26291":62185,"_5":26632,"_18309":105031,"_24913":105032,"_2529":103261},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3023":62190,"_26291":62185,"_5":26632,"_18309":105034,"_24913":105035,"_2529":104488},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/overview#integraciones",{"_3023":62191,"_26291":62185,"_5":26632,"_18309":105037,"_24913":105038,"_2529":105039},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3023":62192,"_26291":62185,"_18309":105041,"_5":12556,"_24913":62185,"_2529":105042},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3023":62193,"_26291":62185,"_18309":105044,"_5":12556,"_24913":105025,"_2529":105045},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3023":62194,"_26291":62185,"_18309":105047,"_5":12556,"_24913":105025,"_2529":105048},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3023":62195,"_26291":62185,"_18309":105050,"_5":12556,"_24913":105029,"_2529":105051},[],"Recurso",{"_3023":62196,"_26291":62185,"_18309":105053,"_5":12556,"_24913":105029,"_2529":105054},[],"Qué representa",{"_3023":62197,"_26291":62185,"_18309":105056,"_5":12556,"_24913":105029,"_2529":105057},[],"**Dispositivo**",{"_3023":62198,"_26291":62185,"_18309":105059,"_5":12556,"_24913":105029,"_2529":105060},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3023":62199,"_26291":62185,"_18309":105062,"_5":12556,"_24913":105029,"_2529":105063},[],"**Identidad**",{"_3023":62200,"_26291":62185,"_18309":105065,"_5":12556,"_24913":105029,"_2529":105066},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3023":62201,"_26291":62185,"_18309":105068,"_5":12556,"_24913":105029,"_2529":47245},[],{"_3023":62202,"_26291":62185,"_18309":105070,"_5":12556,"_24913":105029,"_2529":105071},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3023":62203,"_26291":62185,"_18309":105073,"_5":12556,"_24913":105029,"_2529":105074},[],"**Flota**",{"_3023":62204,"_26291":62185,"_18309":105076,"_5":12556,"_24913":105029,"_2529":105077},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3023":62205,"_26291":62185,"_18309":105079,"_5":12556,"_24913":105029,"_2529":105080},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3023":62206,"_26291":62185,"_18309":105082,"_5":12556,"_24913":105029,"_2529":105083},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3023":62207,"_26291":62185,"_18309":105085,"_5":12556,"_24913":105032,"_2529":105086},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3023":62208,"_26291":62185,"_18309":105088,"_5":12556,"_24913":105032,"_2529":105089},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3023":62209,"_26291":62185,"_18309":105091,"_5":12556,"_24913":105032,"_2529":105092},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3023":62210,"_26291":62185,"_18309":105094,"_5":12556,"_24913":105032,"_2529":105095},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3023":62211,"_26291":62185,"_18309":105097,"_5":12556,"_24913":105032,"_2529":105098},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3023":62212,"_26291":62185,"_18309":105100,"_5":12556,"_24913":105032,"_2529":105101},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3023":62213,"_26291":62185,"_18309":105103,"_5":12556,"_24913":105032,"_2529":105104},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3023":62214,"_26291":62185,"_18309":105106,"_5":12556,"_24913":105032,"_2529":105107},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3023":62215,"_26291":62185,"_18309":105109,"_5":12556,"_24913":105035,"_2529":105110},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3023":62216,"_26291":62185,"_18309":105112,"_5":12556,"_24913":105035,"_2529":105113},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3023":62217,"_26291":62185,"_18309":105115,"_5":12556,"_24913":105038,"_2529":105116},[],"Participante",{"_3023":62218,"_26291":62185,"_18309":105118,"_5":12556,"_24913":105038,"_2529":105119},[],"Responsabilidad",{"_3023":62219,"_26291":62185,"_18309":105121,"_5":12556,"_24913":105038,"_2529":105122},[],"Administrador PKI",{"_3023":62220,"_26291":62185,"_18309":105124,"_5":12556,"_24913":105038,"_2529":105125},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3023":62221,"_26291":62185,"_18309":105127,"_5":12556,"_24913":105038,"_2529":105128},[],"Administrador del aprovisionamiento",{"_3023":62222,"_26291":62185,"_18309":105130,"_5":12556,"_24913":105038,"_2529":105131},[],"DMS, admisión, autenticación por operación e inventario.",{"_3023":62223,"_26291":62185,"_18309":105133,"_5":12556,"_24913":105038,"_2529":105134},[],"Integrador del dispositivo",{"_3023":62224,"_26291":62185,"_18309":105136,"_5":12556,"_24913":105038,"_2529":105137},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3023":62225,"_26291":62185,"_18309":105139,"_5":12556,"_24913":105038,"_2529":105140},[],"Integrador del consumidor",{"_3023":62226,"_26291":62185,"_18309":105142,"_5":12556,"_24913":105038,"_2529":105143},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3023":62227,"_26291":62185,"_18309":105145,"_5":12556,"_24913":105038,"_2529":105146},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3023":62228,"_26291":62228,"_5":12871,"_2529":105148,"_26635":105149,"_18309":105151,"_24913":62228},"Enrola y conecta tu primer dispositivo",[42855,102114,45173,105150],"Primeros pasos",[],{"_3023":62229,"_26291":62228,"_18309":105153,"_5":12556,"_24913":62228,"_2529":105154},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3023":62230,"_26291":62228,"_5":26632,"_18309":105156,"_24913":105157,"_2529":100815},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3023":62231,"_26291":62228,"_5":26632,"_18309":105159,"_24913":105160,"_2529":105161},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3023":62232,"_26291":62228,"_5":26632,"_18309":105163,"_24913":105164,"_2529":105165},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3023":62233,"_26291":62228,"_5":26632,"_18309":105167,"_24913":105168,"_2529":105169},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3023":62234,"_26291":62228,"_5":26632,"_18309":105171,"_24913":105172,"_2529":105173},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3023":62235,"_26291":62228,"_5":26632,"_18309":105175,"_24913":105176,"_2529":105177},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3023":62236,"_26291":62228,"_5":26632,"_18309":105179,"_24913":105180,"_2529":105181},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3023":62237,"_26291":62228,"_5":26632,"_18309":105183,"_24913":105184,"_2529":105185},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3023":62238,"_26291":62228,"_18309":105187,"_5":12556,"_24913":62228,"_2529":105188},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3023":62239,"_26291":62228,"_18309":105190,"_5":12556,"_24913":105157,"_2529":105191},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3023":62240,"_26291":62228,"_18309":105193,"_5":12556,"_24913":105157,"_2529":105194},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3023":62241,"_26291":62228,"_18309":105196,"_5":12556,"_24913":105157,"_2529":105197},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3023":62242,"_26291":62228,"_18309":105199,"_5":12556,"_24913":105157,"_2529":105200},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3023":62243,"_26291":62228,"_18309":105202,"_5":12556,"_24913":105157,"_2529":105203},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3023":62244,"_26291":62228,"_18309":105205,"_5":12556,"_24913":105160,"_2529":105206},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3023":62245,"_26291":62228,"_18309":105208,"_5":12556,"_24913":105160,"_2529":105209},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3023":62246,"_26291":62228,"_18309":105211,"_5":12556,"_24913":105164,"_2529":105212},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3023":62247,"_26291":62228,"_18309":105214,"_5":12556,"_24913":105164,"_2529":105215},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3023":62248,"_26291":62228,"_18309":105217,"_5":12556,"_24913":105164,"_2529":105218},[],"Ajuste",{"_3023":62249,"_26291":62228,"_18309":105220,"_5":12556,"_24913":105164,"_2529":105221},[],"Valor de evaluación",{"_3023":62250,"_26291":62228,"_18309":105223,"_5":12556,"_24913":105164,"_2529":47401},[],{"_3023":62251,"_26291":62228,"_18309":105225,"_5":12556,"_24913":105164,"_2529":105226},[],"Raíz emisora de `device-root.pem`.",{"_3023":62252,"_26291":62228,"_18309":105228,"_5":12556,"_24913":105164,"_2529":103389},[],{"_3023":62253,"_26291":62228,"_18309":105230,"_5":12556,"_24913":105164,"_2529":105231},[],"Perfil final de 1 hora que acabas de preparar.",{"_3023":62254,"_26291":62228,"_18309":105233,"_5":12556,"_24913":105164,"_2529":47412},[],{"_3023":62255,"_26291":62228,"_18309":105235,"_5":12556,"_24913":105164,"_2529":47415},[],{"_3023":62256,"_26291":62228,"_18309":105237,"_5":12556,"_24913":105164,"_2529":47418},[],{"_3023":62257,"_26291":62228,"_18309":105239,"_5":12556,"_24913":105164,"_2529":105240},[],"Habilitado.",{"_3023":62258,"_26291":62228,"_18309":105242,"_5":12556,"_24913":105164,"_2529":47424},[],{"_3023":62259,"_26291":62228,"_18309":105244,"_5":12556,"_24913":105164,"_2529":105245},[],"Deshabilitado; el ID debe ser nuevo.",{"_3023":62260,"_26291":62228,"_18309":105247,"_5":12556,"_24913":105164,"_2529":105248},[],"Autenticación inicial",{"_3023":62261,"_26291":62228,"_18309":105250,"_5":12556,"_24913":105164,"_2529":105251},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3023":62262,"_26291":62228,"_18309":105253,"_5":12556,"_24913":105164,"_2529":105254},[],"Autenticación de renovación",{"_3023":62263,"_26291":62228,"_18309":105256,"_5":12556,"_24913":105164,"_2529":105257},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3023":62264,"_26291":62228,"_18309":105259,"_5":12556,"_24913":105164,"_2529":47442},[],{"_3023":62265,"_26291":62228,"_18309":105261,"_5":12556,"_24913":105164,"_2529":105262},[],"Lista vacía para esta emisión directa / deshabilitado.",{"_3023":62266,"_26291":62228,"_18309":105264,"_5":12556,"_24913":105164,"_2529":47448},[],{"_3023":62267,"_26291":62228,"_18309":105266,"_5":12556,"_24913":105164,"_2529":105267},[],"1 hora.",{"_3023":62268,"_26291":62228,"_18309":105269,"_5":12556,"_24913":105164,"_2529":47454},[],{"_3023":62269,"_26291":62228,"_18309":105271,"_5":12556,"_24913":105164,"_2529":105272},[],"30 minutos / 10 minutos.",{"_3023":62270,"_26291":62228,"_18309":105274,"_5":12556,"_24913":105164,"_2529":47460},[],{"_3023":62271,"_26291":62228,"_18309":105276,"_5":12556,"_24913":105164,"_2529":105277},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3023":62272,"_26291":62228,"_18309":105279,"_5":12556,"_24913":105164,"_2529":45492},[],{"_3023":62273,"_26291":62228,"_18309":105281,"_5":12556,"_24913":105164,"_2529":105282},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3023":62274,"_26291":62228,"_18309":105284,"_5":12556,"_24913":105164,"_2529":47471},[],{"_3023":62275,"_26291":62228,"_18309":105286,"_5":12556,"_24913":105164,"_2529":105287},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3023":62276,"_26291":62228,"_18309":105289,"_5":12556,"_24913":105164,"_2529":105290},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_3023":62277,"_26291":62228,"_18309":105292,"_5":12556,"_24913":105168,"_2529":105293},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3023":62278,"_26291":62228,"_18309":105295,"_5":12556,"_24913":105168,"_2529":105296},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3023":62279,"_26291":62228,"_18309":105298,"_5":12556,"_24913":105172,"_2529":105299},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3023":62280,"_26291":62228,"_18309":105301,"_5":12556,"_24913":105172,"_2529":105302},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3023":62281,"_26291":62228,"_18309":105304,"_5":12556,"_24913":105172,"_2529":105305},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3023":62282,"_26291":62228,"_18309":105307,"_5":12556,"_24913":105176,"_2529":105308},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3023":62283,"_26291":62228,"_18309":105310,"_5":12556,"_24913":105176,"_2529":105311},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3023":62284,"_26291":62228,"_18309":105313,"_5":12556,"_24913":105180,"_2529":105314},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3023":62285,"_26291":62228,"_18309":105316,"_5":12556,"_24913":105180,"_2529":105317},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3023":62286,"_26291":62228,"_18309":105319,"_5":12556,"_24913":105180,"_2529":105320},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3023":62287,"_26291":62228,"_18309":105322,"_5":12556,"_24913":105180,"_2529":105323},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3023":62288,"_26291":62228,"_18309":105325,"_5":12556,"_24913":105180,"_2529":105326},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3023":62289,"_26291":62228,"_18309":105328,"_5":12556,"_24913":105184,"_2529":105329},[],"Comprobación",{"_3023":62290,"_26291":62228,"_18309":105331,"_5":12556,"_24913":105184,"_2529":105332},[],"Resultado esperado",{"_3023":62291,"_26291":62228,"_18309":105334,"_5":12556,"_24913":105184,"_2529":105335},[],"Registro",{"_3023":62292,"_26291":62228,"_18309":105337,"_5":12556,"_24913":105184,"_2529":105338},[],"ID creado automáticamente y DMS correcto.",{"_3023":62293,"_26291":62228,"_18309":105340,"_5":12556,"_24913":105184,"_2529":105341},[],"Certificado",{"_3023":62294,"_26291":62228,"_18309":105343,"_5":12556,"_24913":105184,"_2529":105344},[],"CN, perfil, serie y clave verificados.",{"_3023":62295,"_26291":62228,"_18309":105346,"_5":12556,"_24913":105184,"_2529":105347},[],"Inventario",{"_3023":62296,"_26291":62228,"_18309":105349,"_5":12556,"_24913":105184,"_2529":105350},[],"Serie recibida visible como identidad actual y en el historial.",{"_3023":62297,"_26291":62228,"_18309":105352,"_5":12556,"_24913":105184,"_2529":105353},[],"Consumidor",{"_3023":62298,"_26291":62228,"_18309":105355,"_5":12556,"_24913":105184,"_2529":105356},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3023":62299,"_26291":62228,"_18309":105358,"_5":12556,"_24913":105184,"_2529":105359},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3023":62300,"_26291":62228,"_18309":105361,"_5":12556,"_24913":105184,"_2529":105362},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3023":62301,"_26291":62301,"_5":12871,"_2529":103103,"_26635":105364,"_18309":105365,"_24913":62301},[42855,102114,45173,105150],[],{"_3023":62302,"_26291":62301,"_18309":105367,"_5":12556,"_24913":62301,"_2529":105368},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3023":62303,"_26291":62301,"_5":26632,"_18309":105370,"_24913":105371,"_2529":100815},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3023":62304,"_26291":62301,"_5":26632,"_18309":105373,"_24913":105374,"_2529":105375},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3023":62305,"_26291":62301,"_5":26632,"_18309":105377,"_24913":105378,"_2529":105379},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3023":62306,"_26291":62301,"_5":26632,"_18309":105381,"_24913":105382,"_2529":105383},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3023":62307,"_26291":62301,"_5":26632,"_18309":105385,"_24913":105386,"_2529":105387},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3023":62308,"_26291":62301,"_5":26632,"_18309":105389,"_24913":105390,"_2529":105391},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3023":62309,"_26291":62301,"_5":26632,"_18309":105393,"_24913":105394,"_2529":105332},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3023":62310,"_26291":62301,"_5":26632,"_18309":105396,"_24913":105397,"_2529":105398},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3023":62311,"_26291":62301,"_5":26632,"_18309":105400,"_24913":105401,"_2529":105402},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3023":62312,"_26291":62301,"_18309":105404,"_5":12556,"_24913":62301,"_2529":105405},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3023":62313,"_26291":62301,"_18309":105407,"_5":12556,"_24913":62301,"_2529":105408},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3023":62314,"_26291":62301,"_18309":105410,"_5":12556,"_24913":105371,"_2529":105411},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3023":62315,"_26291":62301,"_18309":105413,"_5":12556,"_24913":105371,"_2529":105414},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3023":62316,"_26291":62301,"_18309":105416,"_5":12556,"_24913":105371,"_2529":105417},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3023":62317,"_26291":62301,"_18309":105419,"_5":12556,"_24913":105371,"_2529":105420},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3023":62318,"_26291":62301,"_18309":105422,"_5":12556,"_24913":105374,"_2529":105423},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3023":62319,"_26291":62301,"_18309":105425,"_5":12556,"_24913":105374,"_2529":105426},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3023":62320,"_26291":62301,"_18309":105428,"_5":12556,"_24913":105374,"_2529":105429},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3023":62321,"_26291":62301,"_18309":105431,"_5":12556,"_24913":105374,"_2529":105432},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3023":62322,"_26291":62301,"_18309":105434,"_5":12556,"_24913":105374,"_2529":105435},[],"Configura **Authentication Mode** como `CLIENT_CERTIFICATE` y añade en **Validation CAs** la CA cuyos certificados iniciales aceptarás. Para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deshabilitada la generación de claves en servidor si no la vas a utilizar.",{"_3023":62323,"_26291":62301,"_18309":105437,"_5":12556,"_24913":105374,"_2529":105438},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3023":62324,"_26291":62301,"_18309":105440,"_5":12556,"_24913":105374,"_2529":105441},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3023":62325,"_26291":62301,"_18309":105443,"_5":12556,"_24913":105374,"_2529":105444},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3023":62326,"_26291":62301,"_18309":105446,"_5":12556,"_24913":105378,"_2529":105447},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3023":62327,"_26291":62301,"_18309":105449,"_5":12556,"_24913":105378,"_2529":47637},[],{"_3023":62328,"_26291":62301,"_18309":105451,"_5":12556,"_24913":105378,"_2529":105452},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3023":62329,"_26291":62301,"_18309":105454,"_5":12556,"_24913":105378,"_2529":105455},[],"**Icon** y **Tags**: clasificación opcional.",{"_3023":62330,"_26291":62301,"_18309":105457,"_5":12556,"_24913":105378,"_2529":105458},[],"Confirma el registro.",{"_3023":62331,"_26291":62301,"_18309":105460,"_5":12556,"_24913":105382,"_2529":105461},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3023":62332,"_26291":62301,"_18309":105463,"_5":12556,"_24913":105382,"_2529":105464},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3023":62333,"_26291":62301,"_18309":105466,"_5":12556,"_24913":105386,"_2529":105467},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3023":62334,"_26291":62301,"_18309":105469,"_5":12556,"_24913":105386,"_2529":105470},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3023":62335,"_26291":62301,"_18309":105472,"_5":12556,"_24913":105390,"_2529":105473},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3023":62336,"_26291":62301,"_18309":105475,"_5":12556,"_24913":105390,"_2529":105476},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3023":62337,"_26291":62301,"_18309":105478,"_5":12556,"_24913":105394,"_2529":105329},[],{"_3023":62338,"_26291":62301,"_18309":105480,"_5":12556,"_24913":105394,"_2529":105481},[],"Resultado",{"_3023":62339,"_26291":62301,"_18309":105483,"_5":12556,"_24913":105394,"_2529":105484},[],"Dispositivo",{"_3023":62340,"_26291":62301,"_18309":105486,"_5":12556,"_24913":105394,"_2529":105487},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3023":62341,"_26291":62301,"_18309":105489,"_5":12556,"_24913":105394,"_2529":105490},[],"Identidad actual",{"_3023":62342,"_26291":62301,"_18309":105492,"_5":12556,"_24913":105394,"_2529":105493},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3023":62343,"_26291":62301,"_18309":105495,"_5":12556,"_24913":105394,"_2529":105496},[],"Historial",{"_3023":62344,"_26291":62301,"_18309":105498,"_5":12556,"_24913":105394,"_2529":105499},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3023":62345,"_26291":62301,"_18309":105501,"_5":12556,"_24913":105394,"_2529":105502},[],"Clave y certificado",{"_3023":62346,"_26291":62301,"_18309":105504,"_5":12556,"_24913":105394,"_2529":105505},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3023":62347,"_26291":62301,"_18309":105507,"_5":12556,"_24913":105397,"_2529":105508},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3023":62348,"_26291":62301,"_18309":105510,"_5":12556,"_24913":105397,"_2529":105511},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3023":62349,"_26291":62301,"_18309":105513,"_5":12556,"_24913":105397,"_2529":105514},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3023":62350,"_26291":62301,"_18309":105516,"_5":12556,"_24913":105397,"_2529":105517},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3023":62351,"_26291":62301,"_18309":105519,"_5":12556,"_24913":105401,"_2529":105520},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3023":62352,"_26291":62301,"_18309":105522,"_5":12556,"_24913":105401,"_2529":105523},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3023":62353,"_26291":62301,"_18309":105525,"_5":12556,"_24913":105401,"_2529":105526},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3023":62354,"_26291":62354,"_5":12871,"_2529":105528,"_26635":105529,"_18309":105530,"_24913":62354},"Plataforma Lamassu IoT",[42855,102114],[],{"_3023":62355,"_26291":62354,"_18309":105532,"_5":12556,"_24913":62354,"_2529":105533},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3023":62356,"_26291":62354,"_5":26632,"_18309":105535,"_24913":105536,"_2529":105026},[],"/docs/pr-preview/pr-47/es/platform/overview#empieza-aquí",{"_3023":62357,"_26291":62354,"_5":26632,"_18309":105538,"_24913":105539,"_2529":105540},[],"/docs/pr-preview/pr-47/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3023":62358,"_26291":62354,"_5":26632,"_18309":105542,"_24913":105543,"_2529":105544},[],"/docs/pr-preview/pr-47/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3023":62359,"_26291":62354,"_5":26632,"_18309":105546,"_24913":105547,"_2529":105548},[],"/docs/pr-preview/pr-47/es/platform/overview#capacidades-principales","Capacidades principales",{"_3023":62360,"_26291":62354,"_5":26632,"_18309":105550,"_24913":105551,"_2529":105552},[],"/docs/pr-preview/pr-47/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3023":62361,"_26291":62354,"_5":26632,"_18309":105554,"_24913":105555,"_2529":105556},[],"/docs/pr-preview/pr-47/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3023":62362,"_26291":62354,"_5":26632,"_18309":105558,"_24913":105559,"_2529":105560},[],"/docs/pr-preview/pr-47/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3023":62363,"_26291":62354,"_5":26632,"_18309":105562,"_24913":105563,"_2529":105564},[],"/docs/pr-preview/pr-47/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3023":62364,"_26291":62354,"_5":26632,"_18309":105566,"_24913":105567,"_2529":105568},[],"/docs/pr-preview/pr-47/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3023":62365,"_26291":62354,"_5":26632,"_18309":105570,"_24913":105571,"_2529":105572},[],"/docs/pr-preview/pr-47/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3023":62366,"_26291":62354,"_5":26632,"_18309":105574,"_24913":105575,"_2529":105576},[],"/docs/pr-preview/pr-47/es/platform/overview#referencia-operativa","Referencia operativa",{"_3023":62367,"_26291":62354,"_18309":105578,"_5":12556,"_24913":62354,"_2529":105579},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3023":62368,"_26291":62354,"_18309":105581,"_5":12556,"_24913":105536,"_2529":105582},[],"Elige el resultado que necesitas obtener:",{"_3023":62369,"_26291":62354,"_18309":105584,"_5":12556,"_24913":105536,"_2529":105585},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3023":62370,"_26291":62354,"_18309":105587,"_5":12556,"_24913":105536,"_2529":105588},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3023":62371,"_26291":62354,"_18309":105590,"_5":12556,"_24913":105536,"_2529":105591},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3023":62372,"_26291":62354,"_18309":105593,"_5":12556,"_24913":105539,"_2529":105594},[],"Bloque",{"_3023":62373,"_26291":62354,"_18309":105596,"_5":12556,"_24913":105539,"_2529":105597},[],"Qué gestionas",{"_3023":62374,"_26291":62354,"_18309":105599,"_5":12556,"_24913":105539,"_2529":105600},[],"Punto de entrada",{"_3023":62375,"_26291":62354,"_18309":105602,"_5":12556,"_24913":105539,"_2529":47791},[],{"_3023":62376,"_26291":62354,"_18309":105604,"_5":12556,"_24913":105539,"_2529":105605},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3023":62377,"_26291":62354,"_18309":105607,"_5":12556,"_24913":105539,"_2529":105608},[],"Visión general de PKI",{"_3023":62378,"_26291":62354,"_18309":105610,"_5":12556,"_24913":105539,"_2529":47800},[],{"_3023":62379,"_26291":62354,"_18309":105612,"_5":12556,"_24913":105539,"_2529":105613},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3023":62380,"_26291":62354,"_18309":105615,"_5":12556,"_24913":105539,"_2529":105616},[],"Visión general de IoT Fleets",{"_3023":62381,"_26291":62354,"_18309":105618,"_5":12556,"_24913":105539,"_2529":105619},[],"**Administración**",{"_3023":62382,"_26291":62354,"_18309":105621,"_5":12556,"_24913":105539,"_2529":105622},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3023":62383,"_26291":62354,"_18309":105624,"_5":12556,"_24913":105539,"_2529":102112},[],{"_3023":62384,"_26291":62354,"_18309":105626,"_5":12556,"_24913":105539,"_2529":105627},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3023":62385,"_26291":62354,"_18309":105629,"_5":12556,"_24913":105543,"_2529":105630},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3023":62386,"_26291":62354,"_18309":105632,"_5":12556,"_24913":105543,"_2529":105633},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3023":62387,"_26291":62354,"_18309":105635,"_5":12556,"_24913":105543,"_2529":105636},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3023":62388,"_26291":62354,"_18309":105638,"_5":12556,"_24913":105543,"_2529":105639},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3023":62389,"_26291":62354,"_18309":105641,"_5":12556,"_24913":105543,"_2529":105642},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3023":62390,"_26291":62354,"_18309":105644,"_5":12556,"_24913":105543,"_2529":105645},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3023":62391,"_26291":62354,"_18309":105647,"_5":12556,"_24913":105551,"_2529":105648},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3023":62392,"_26291":62354,"_18309":105650,"_5":12556,"_24913":105555,"_2529":105651},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3023":62393,"_26291":62354,"_18309":105653,"_5":12556,"_24913":105559,"_2529":105654},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3023":62394,"_26291":62354,"_18309":105656,"_5":12556,"_24913":105563,"_2529":105657},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3023":62395,"_26291":62354,"_18309":105659,"_5":12556,"_24913":105567,"_2529":105660},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3023":62396,"_26291":62354,"_18309":105662,"_5":12556,"_24913":105571,"_2529":105663},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3023":62397,"_26291":62354,"_18309":105665,"_5":12556,"_24913":105575,"_2529":105119},[],{"_3023":62398,"_26291":62354,"_18309":105667,"_5":12556,"_24913":105575,"_2529":105668},[],"Qué prepara o comprueba",{"_3023":62399,"_26291":62354,"_18309":105670,"_5":12556,"_24913":105575,"_2529":105122},[],{"_3023":62400,"_26291":62354,"_18309":105672,"_5":12556,"_24913":105575,"_2529":105673},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3023":62401,"_26291":62354,"_18309":105675,"_5":12556,"_24913":105575,"_2529":105676},[],"Administrador de la flota",{"_3023":62402,"_26291":62354,"_18309":105678,"_5":12556,"_24913":105575,"_2529":105679},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3023":62403,"_26291":62354,"_18309":105681,"_5":12556,"_24913":105575,"_2529":105134},[],{"_3023":62404,"_26291":62354,"_18309":105683,"_5":12556,"_24913":105575,"_2529":105684},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3023":62405,"_26291":62354,"_18309":105686,"_5":12556,"_24913":105575,"_2529":105140},[],{"_3023":62406,"_26291":62354,"_18309":105688,"_5":12556,"_24913":105575,"_2529":105689},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3023":62407,"_26291":62354,"_18309":105691,"_5":12556,"_24913":105575,"_2529":105692},[],"Operador de infraestructura",{"_3023":62408,"_26291":62354,"_18309":105694,"_5":12556,"_24913":105575,"_2529":105695},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3023":62409,"_26291":62354,"_18309":105697,"_5":12556,"_24913":105575,"_2529":105698},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3023":62410,"_26291":62410,"_5":12871,"_2529":105700,"_26635":105701,"_18309":105703,"_24913":62410},"Jerarquía y rotación de CAs",[42855,102114,47892,105702],"Claves, autoridades y certificados",[],{"_3023":62411,"_26291":62410,"_18309":105705,"_5":12556,"_24913":62410,"_2529":105706},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3023":62412,"_26291":62410,"_5":26632,"_18309":105708,"_24913":105709,"_2529":105710},[],"/docs/pr-preview/pr-47/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3023":62413,"_26291":62410,"_5":26632,"_18309":105712,"_24913":105713,"_2529":105714},[],"/docs/pr-preview/pr-47/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3023":62414,"_26291":62410,"_5":26632,"_18309":105716,"_24913":105717,"_2529":105718},[],"/docs/pr-preview/pr-47/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3023":62415,"_26291":62410,"_5":26632,"_18309":105720,"_24913":105721,"_2529":105722},[],"/docs/pr-preview/pr-47/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3023":62416,"_26291":62410,"_5":26632,"_18309":105724,"_24913":105725,"_2529":105726},[],"/docs/pr-preview/pr-47/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3023":62417,"_26291":62410,"_5":26632,"_18309":105728,"_24913":105729,"_2529":105730},[],"/docs/pr-preview/pr-47/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3023":62418,"_26291":62410,"_5":26632,"_18309":105732,"_24913":105733,"_2529":105734},[],"/docs/pr-preview/pr-47/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3023":62419,"_26291":62410,"_5":26632,"_18309":105736,"_24913":105737,"_2529":105738},[],"/docs/pr-preview/pr-47/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3023":62420,"_26291":62410,"_5":26632,"_18309":105740,"_24913":105741,"_2529":105742},[],"/docs/pr-preview/pr-47/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3023":62421,"_26291":62410,"_5":26632,"_18309":105744,"_24913":105745,"_2529":105746},[],"/docs/pr-preview/pr-47/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3023":62422,"_26291":62410,"_5":26632,"_18309":105748,"_24913":105749,"_2529":105750},[],"/docs/pr-preview/pr-47/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3023":62423,"_26291":62410,"_5":26632,"_18309":105752,"_24913":105753,"_2529":105754},[],"/docs/pr-preview/pr-47/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3023":62424,"_26291":62410,"_18309":105756,"_5":12556,"_24913":62410,"_2529":105757},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3023":62425,"_26291":62410,"_18309":105759,"_5":12556,"_24913":62410,"_2529":105760},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3023":62426,"_26291":62410,"_18309":105762,"_5":12556,"_24913":105709,"_2529":105763},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3023":62427,"_26291":62410,"_18309":105765,"_5":12556,"_24913":105709,"_2529":105766},[],"entorno, como producción y preproducción;",{"_3023":62428,"_26291":62410,"_18309":105768,"_5":12556,"_24913":105709,"_2529":105769},[],"propietario o equipo operador;",{"_3023":62429,"_26291":62410,"_18309":105771,"_5":12556,"_24913":105709,"_2529":105772},[],"familia de dispositivos o proceso de fabricación;",{"_3023":62430,"_26291":62410,"_18309":105774,"_5":12556,"_24913":105709,"_2529":105775},[],"región o requisito regulatorio;",{"_3023":62431,"_26291":62410,"_18309":105777,"_5":12556,"_24913":105709,"_2529":105778},[],"motor criptográfico o política de clave;",{"_3023":62432,"_26291":62410,"_18309":105780,"_5":12556,"_24913":105709,"_2529":105781},[],"ventana de mantenimiento y ritmo de renovación.",{"_3023":62433,"_26291":62410,"_18309":105783,"_5":12556,"_24913":105709,"_2529":105784},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3023":62434,"_26291":62410,"_18309":105786,"_5":12556,"_24913":105709,"_2529":105787},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3023":62435,"_26291":62410,"_18309":105789,"_5":12556,"_24913":105713,"_2529":105790},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3023":62436,"_26291":62410,"_18309":105792,"_5":12556,"_24913":105713,"_2529":105793},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3023":62437,"_26291":62410,"_18309":105795,"_5":12556,"_24913":105713,"_2529":105796},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3023":62438,"_26291":62410,"_18309":105798,"_5":12556,"_24913":105717,"_2529":105799},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3023":62439,"_26291":62410,"_18309":105801,"_5":12556,"_24913":105717,"_2529":105802},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3023":62440,"_26291":62410,"_18309":105804,"_5":12556,"_24913":105717,"_2529":105805},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3023":62441,"_26291":62410,"_18309":105807,"_5":12556,"_24913":105717,"_2529":105808},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3023":62442,"_26291":62410,"_18309":105810,"_5":12556,"_24913":105725,"_2529":105811},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3023":62443,"_26291":62410,"_18309":105813,"_5":12556,"_24913":105729,"_2529":105814},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3023":62444,"_26291":62410,"_18309":105816,"_5":12556,"_24913":105733,"_2529":105817},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3023":62445,"_26291":62410,"_18309":105819,"_5":12556,"_24913":105737,"_2529":105820},[],"Actualiza la CA de enrolamiento y el perfil de los DMS y añade la CA anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS mientras sigan renovando cohortes con certificados antiguos. La guía DMS documenta ese ajuste.",{"_3023":62446,"_26291":62410,"_18309":105822,"_5":12556,"_24913":105741,"_2529":105823},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3023":62447,"_26291":62410,"_18309":105825,"_5":12556,"_24913":105745,"_2529":105826},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_3023":62448,"_26291":62410,"_18309":105828,"_5":12556,"_24913":105749,"_2529":105829},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3023":62449,"_26291":62410,"_18309":105831,"_5":12556,"_24913":105749,"_2529":105832},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3023":62450,"_26291":62410,"_18309":105834,"_5":12556,"_24913":105749,"_2529":105835},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3023":62451,"_26291":62410,"_18309":105837,"_5":12556,"_24913":105749,"_2529":105838},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3023":62452,"_26291":62410,"_18309":105840,"_5":12556,"_24913":105753,"_2529":105841},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3023":62453,"_26291":62410,"_18309":105843,"_5":12556,"_24913":105753,"_2529":105844},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3023":62454,"_26291":62410,"_18309":105846,"_5":12556,"_24913":105753,"_2529":105847},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3023":62455,"_26291":62410,"_18309":105849,"_5":12556,"_24913":105753,"_2529":105850},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3023":62456,"_26291":62410,"_18309":105852,"_5":12556,"_24913":105753,"_2529":105853},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3023":62457,"_26291":62410,"_18309":105855,"_5":12556,"_24913":105753,"_2529":105856},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3023":62458,"_26291":62410,"_18309":105858,"_5":12556,"_24913":105753,"_2529":105859},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3023":62459,"_26291":62459,"_5":12871,"_2529":105861,"_26635":105862,"_18309":105863,"_24913":62459},"Autoridades de certificación",[42855,102114,47892,105702],[],{"_3023":62460,"_26291":62459,"_18309":105865,"_5":12556,"_24913":62459,"_2529":105866},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3023":62461,"_26291":62459,"_5":26632,"_18309":105868,"_24913":105869,"_2529":105870},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3023":62462,"_26291":62459,"_5":26632,"_18309":105872,"_24913":105873,"_2529":105874},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3023":62463,"_26291":62459,"_5":26632,"_18309":105876,"_24913":105877,"_2529":100815},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3023":62464,"_26291":62459,"_5":26632,"_18309":105879,"_24913":105880,"_2529":105881},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3023":62465,"_26291":62459,"_5":26632,"_18309":105883,"_24913":105884,"_2529":105885},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3023":62466,"_26291":62459,"_5":26632,"_18309":105887,"_24913":105888,"_2529":105889},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3023":62467,"_26291":62459,"_5":26632,"_18309":105891,"_24913":105892,"_2529":105893},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3023":62468,"_26291":62459,"_5":26632,"_18309":105895,"_24913":105896,"_2529":105897},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3023":62469,"_26291":62459,"_5":26632,"_18309":105899,"_24913":105900,"_2529":105901},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3023":62470,"_26291":62459,"_5":26632,"_18309":105903,"_24913":105904,"_2529":105905},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3023":62471,"_26291":62459,"_5":26632,"_18309":105907,"_24913":105908,"_2529":105909},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3023":62472,"_26291":62459,"_5":26632,"_18309":105911,"_24913":105912,"_2529":105913},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3023":62473,"_26291":62459,"_5":26632,"_18309":105915,"_24913":105916,"_2529":105917},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3023":62474,"_26291":62459,"_5":26632,"_18309":105919,"_24913":105920,"_2529":105921},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3023":62475,"_26291":62459,"_5":26632,"_18309":105923,"_24913":105924,"_2529":105925},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3023":62476,"_26291":62459,"_5":26632,"_18309":105927,"_24913":105928,"_2529":105929},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3023":62477,"_26291":62459,"_5":26632,"_18309":105931,"_24913":105932,"_2529":105933},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3023":62478,"_26291":62459,"_5":26632,"_18309":105935,"_24913":105936,"_2529":105937},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3023":62479,"_26291":62459,"_5":26632,"_18309":105939,"_24913":105940,"_2529":105941},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3023":62480,"_26291":62459,"_5":26632,"_18309":105943,"_24913":105944,"_2529":105945},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3023":62481,"_26291":62459,"_5":26632,"_18309":105947,"_24913":105948,"_2529":105949},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3023":62482,"_26291":62459,"_5":26632,"_18309":105951,"_24913":105952,"_2529":105953},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3023":62483,"_26291":62459,"_18309":105955,"_5":12556,"_24913":62459,"_2529":105956},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3023":62484,"_26291":62459,"_18309":105958,"_5":12556,"_24913":62459,"_2529":105959},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3023":62485,"_26291":62459,"_18309":105961,"_5":12556,"_24913":62459,"_2529":105962},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3023":62486,"_26291":62459,"_18309":105964,"_5":12556,"_24913":105869,"_2529":105965},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3023":62487,"_26291":62459,"_18309":105967,"_5":12556,"_24913":105869,"_2529":105968},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3023":62488,"_26291":62459,"_18309":105970,"_5":12556,"_24913":105869,"_2529":105971},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3023":62489,"_26291":62459,"_18309":105973,"_5":12556,"_24913":105869,"_2529":105974},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3023":62490,"_26291":62459,"_18309":105976,"_5":12556,"_24913":105869,"_2529":105977},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3023":62491,"_26291":62459,"_18309":105979,"_5":12556,"_24913":105877,"_2529":105980},[],"Decide si la CA será raíz o intermedia.",{"_3023":62492,"_26291":62459,"_18309":105982,"_5":12556,"_24913":105877,"_2529":105983},[],"Elige el motor que custodiará la clave.",{"_3023":62493,"_26291":62459,"_18309":105985,"_5":12556,"_24913":105877,"_2529":105986},[],"Define una validez superior a la de los certificados que emitirá.",{"_3023":62494,"_26291":62459,"_18309":105988,"_5":12556,"_24913":105877,"_2529":105989},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3023":62495,"_26291":62459,"_18309":105991,"_5":12556,"_24913":105880,"_2529":105992},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3023":62496,"_26291":62459,"_18309":105994,"_5":12556,"_24913":105884,"_2529":105995},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3023":62497,"_26291":62459,"_18309":105997,"_5":12556,"_24913":105884,"_2529":105998},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3023":62498,"_26291":62459,"_18309":106000,"_5":12556,"_24913":105888,"_2529":106001},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3023":62499,"_26291":62459,"_18309":106003,"_5":12556,"_24913":105892,"_2529":106004},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3023":62500,"_26291":62459,"_18309":106006,"_5":12556,"_24913":105892,"_2529":106007},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3023":62501,"_26291":62459,"_18309":106009,"_5":12556,"_24913":105892,"_2529":106010},[],"`ST`: estado o provincia.",{"_3023":62502,"_26291":62459,"_18309":106012,"_5":12556,"_24913":105892,"_2529":106013},[],"`L`: localidad.",{"_3023":62503,"_26291":62459,"_18309":106015,"_5":12556,"_24913":105892,"_2529":106016},[],"`O`: organización.",{"_3023":62504,"_26291":62459,"_18309":106018,"_5":12556,"_24913":105892,"_2529":106019},[],"`OU`: unidad organizativa.",{"_3023":62505,"_26291":62459,"_18309":106021,"_5":12556,"_24913":105892,"_2529":106022},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3023":62506,"_26291":62459,"_18309":106024,"_5":12556,"_24913":105896,"_2529":106025},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3023":62507,"_26291":62459,"_18309":106027,"_5":12556,"_24913":105896,"_2529":106028},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3023":62508,"_26291":62459,"_18309":106030,"_5":12556,"_24913":105900,"_2529":106031},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3023":62509,"_26291":62459,"_18309":106033,"_5":12556,"_24913":105900,"_2529":106034},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3023":62510,"_26291":62459,"_18309":106036,"_5":12556,"_24913":105904,"_2529":106037},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3023":62511,"_26291":62459,"_18309":106039,"_5":12556,"_24913":105904,"_2529":106040},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3023":62512,"_26291":62459,"_18309":106042,"_5":12556,"_24913":105908,"_2529":106043},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3023":62513,"_26291":62459,"_18309":106045,"_5":12556,"_24913":105912,"_2529":106046},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3023":62514,"_26291":62459,"_18309":106048,"_5":12556,"_24913":105916,"_2529":106049},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3023":62515,"_26291":62459,"_18309":106051,"_5":12556,"_24913":105920,"_2529":106052},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3023":62516,"_26291":62459,"_18309":106054,"_5":12556,"_24913":105924,"_2529":106055},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3023":62517,"_26291":62459,"_18309":106057,"_5":12556,"_24913":105924,"_2529":106058},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3023":62518,"_26291":62459,"_18309":106060,"_5":12556,"_24913":105928,"_2529":106061},[],"Abre una CA desde el inventario para consultar:",{"_3023":62519,"_26291":62459,"_18309":106063,"_5":12556,"_24913":105928,"_2529":106064},[],"Estado y periodo de validez.",{"_3023":62520,"_26291":62459,"_18309":106066,"_5":12556,"_24913":105928,"_2529":106067},[],"Certificado y cadena en formato PEM.",{"_3023":62521,"_26291":62459,"_18309":106069,"_5":12556,"_24913":105928,"_2529":106070},[],"Número de certificados activos, expirados y revocados.",{"_3023":62522,"_26291":62459,"_18309":106072,"_5":12556,"_24913":105928,"_2529":106073},[],"Certificados emitidos en **Issued Certificates**.",{"_3023":62523,"_26291":62459,"_18309":106075,"_5":12556,"_24913":105928,"_2529":106076},[],"CRL vinculada a la autoridad.",{"_3023":62524,"_26291":62459,"_18309":106078,"_5":12556,"_24913":105928,"_2529":106079},[],"Metadatos y motor criptográfico asociado.",{"_3023":62525,"_26291":62459,"_18309":106081,"_5":12556,"_24913":105928,"_2529":106082},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3023":62526,"_26291":62459,"_18309":106084,"_5":12556,"_24913":105932,"_2529":106085},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3023":62527,"_26291":62459,"_18309":106087,"_5":12556,"_24913":105932,"_2529":106088},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3023":62528,"_26291":62459,"_18309":106090,"_5":12556,"_24913":105932,"_2529":106091},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3023":62529,"_26291":62459,"_18309":106093,"_5":12556,"_24913":105932,"_2529":106094},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3023":62530,"_26291":62459,"_18309":106096,"_5":12556,"_24913":105936,"_2529":106097},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3023":62531,"_26291":62459,"_18309":106099,"_5":12556,"_24913":105940,"_2529":106100},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3023":62532,"_26291":62459,"_18309":106102,"_5":12556,"_24913":105944,"_2529":106103},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3023":62533,"_26291":62459,"_18309":106105,"_5":12556,"_24913":105948,"_2529":106106},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3023":62534,"_26291":62459,"_18309":106108,"_5":12556,"_24913":105952,"_2529":106109},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3023":62535,"_26291":62459,"_18309":106111,"_5":12556,"_24913":105952,"_2529":106112},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3023":62536,"_26291":62536,"_5":12871,"_2529":106114,"_26635":106115,"_18309":106116,"_24913":62536},"Perfiles de certificado",[42855,102114,47892,105702],[],{"_3023":62537,"_26291":62536,"_18309":106118,"_5":12556,"_24913":62536,"_2529":106119},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3023":62538,"_26291":62536,"_5":26632,"_18309":106121,"_24913":106122,"_2529":106123},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3023":62539,"_26291":62536,"_5":26632,"_18309":106125,"_24913":106126,"_2529":106127},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-profiles#validez","Validez",{"_3023":62540,"_26291":62536,"_5":26632,"_18309":106129,"_24913":106130,"_2529":106131},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3023":62541,"_26291":62536,"_5":26632,"_18309":106133,"_24913":106134,"_2529":106135},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3023":62542,"_26291":62536,"_5":26632,"_18309":106137,"_24913":106138,"_2529":106139},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3023":62543,"_26291":62536,"_5":26632,"_18309":106141,"_24913":106142,"_2529":106143},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3023":62544,"_26291":62536,"_5":26632,"_18309":106145,"_24913":106146,"_2529":106147},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3023":62545,"_26291":62536,"_5":26632,"_18309":106149,"_24913":106150,"_2529":106151},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3023":62546,"_26291":62536,"_5":26632,"_18309":106153,"_24913":106154,"_2529":106155},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3023":62547,"_26291":62536,"_5":26632,"_18309":106157,"_24913":106158,"_2529":106159},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3023":62548,"_26291":62536,"_5":26632,"_18309":106161,"_24913":106162,"_2529":106163},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3023":62549,"_26291":62536,"_5":26632,"_18309":106165,"_24913":106166,"_2529":106167},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3023":62550,"_26291":62536,"_5":26632,"_18309":106169,"_24913":106170,"_2529":106171},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3023":62551,"_26291":62536,"_5":26632,"_18309":106173,"_24913":106174,"_2529":106175},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3023":62552,"_26291":62536,"_5":26632,"_18309":106177,"_24913":106178,"_2529":106179},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3023":62553,"_26291":62536,"_5":26632,"_18309":106181,"_24913":106182,"_2529":106183},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3023":62554,"_26291":62536,"_18309":106185,"_5":12556,"_24913":62536,"_2529":106186},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3023":62555,"_26291":62536,"_18309":106188,"_5":12556,"_24913":62536,"_2529":106189},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3023":62556,"_26291":62536,"_18309":106191,"_5":12556,"_24913":106126,"_2529":106192},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3023":62557,"_26291":62536,"_18309":106194,"_5":12556,"_24913":106126,"_2529":106195},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3023":62558,"_26291":62536,"_18309":106197,"_5":12556,"_24913":106130,"_2529":106198},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3023":62559,"_26291":62536,"_18309":106200,"_5":12556,"_24913":106134,"_2529":106201},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3023":62560,"_26291":62536,"_18309":106203,"_5":12556,"_24913":106134,"_2529":106204},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3023":62561,"_26291":62536,"_18309":106206,"_5":12556,"_24913":106134,"_2529":106207},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3023":62562,"_26291":62536,"_18309":106209,"_5":12556,"_24913":106138,"_2529":106210},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3023":62563,"_26291":62536,"_18309":106212,"_5":12556,"_24913":106142,"_2529":106213},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3023":62564,"_26291":62536,"_18309":106215,"_5":12556,"_24913":106142,"_2529":106216},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3023":62565,"_26291":62536,"_18309":106218,"_5":12556,"_24913":106146,"_2529":106219},[],"La aplicación criptográfica puede:",{"_3023":62566,"_26291":62536,"_18309":106221,"_5":12556,"_24913":106146,"_2529":106222},[],"permitir o bloquear claves RSA;",{"_3023":62567,"_26291":62536,"_18309":106224,"_5":12556,"_24913":106146,"_2529":106225},[],"limitar los tamaños RSA admitidos;",{"_3023":62568,"_26291":62536,"_18309":106227,"_5":12556,"_24913":106146,"_2529":106228},[],"permitir o bloquear claves ECDSA;",{"_3023":62569,"_26291":62536,"_18309":106230,"_5":12556,"_24913":106146,"_2529":106231},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3023":62570,"_26291":62536,"_18309":106233,"_5":12556,"_24913":106146,"_2529":106234},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3023":62571,"_26291":62536,"_18309":106236,"_5":12556,"_24913":106150,"_2529":106237},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3023":62572,"_26291":62536,"_18309":106239,"_5":12556,"_24913":106150,"_2529":101905},[],{"_3023":62573,"_26291":62536,"_18309":106241,"_5":12556,"_24913":106150,"_2529":106242},[],"Primera opción",{"_3023":62574,"_26291":62536,"_18309":106244,"_5":12556,"_24913":106150,"_2529":106245},[],"Segunda opción",{"_3023":62575,"_26291":62536,"_18309":106247,"_5":12556,"_24913":106150,"_2529":106248},[],"Si no hay ninguna",{"_3023":62576,"_26291":62536,"_18309":106250,"_5":12556,"_24913":106150,"_2529":106251},[],"Firma directa con una CA",{"_3023":62577,"_26291":62536,"_18309":106253,"_5":12556,"_24913":106150,"_2529":106254},[],"`issuance_profile` incluido en la solicitud",{"_3023":62578,"_26291":62536,"_18309":106256,"_5":12556,"_24913":106150,"_2529":106257},[],"`issuance_profile_id` de la solicitud",{"_3023":62579,"_26291":62536,"_18309":106259,"_5":12556,"_24913":106150,"_2529":106260},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3023":62580,"_26291":62536,"_18309":106262,"_5":12556,"_24913":106150,"_2529":106263},[],"Emisión mediante DMS",{"_3023":62581,"_26291":62536,"_18309":106265,"_5":12556,"_24913":106150,"_2529":48457},[],{"_3023":62582,"_26291":62536,"_18309":106267,"_5":12556,"_24913":106150,"_2529":106268},[],"`settings.issuance_profile` incluido en el DMS",{"_3023":62583,"_26291":62536,"_18309":106270,"_5":12556,"_24913":106150,"_2529":106271},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3023":62584,"_26291":62536,"_18309":106273,"_5":12556,"_24913":106150,"_2529":106274},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3023":62585,"_26291":62536,"_18309":106276,"_5":12556,"_24913":106150,"_2529":106277},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3023":62586,"_26291":62536,"_18309":106279,"_5":12556,"_24913":106158,"_2529":106280},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3023":62587,"_26291":62536,"_18309":106282,"_5":12556,"_24913":106162,"_2529":106283},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3023":62588,"_26291":62536,"_18309":106285,"_5":12556,"_24913":106166,"_2529":106286},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3023":62589,"_26291":62536,"_18309":106288,"_5":12556,"_24913":106170,"_2529":106289},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3023":62590,"_26291":62536,"_18309":106291,"_5":12556,"_24913":106174,"_2529":106292},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3023":62591,"_26291":62536,"_18309":106294,"_5":12556,"_24913":106174,"_2529":106295},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3023":62592,"_26291":62536,"_18309":106297,"_5":12556,"_24913":106178,"_2529":106298},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3023":62593,"_26291":62536,"_18309":106300,"_5":12556,"_24913":106178,"_2529":106301},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3023":62594,"_26291":62536,"_18309":106303,"_5":12556,"_24913":106178,"_2529":106304},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3023":62595,"_26291":62536,"_18309":106306,"_5":12556,"_24913":106178,"_2529":106307},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3023":62596,"_26291":62536,"_18309":106309,"_5":12556,"_24913":106182,"_2529":106310},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3023":62597,"_26291":62536,"_18309":106312,"_5":12556,"_24913":106182,"_2529":106313},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3023":62598,"_26291":62598,"_5":12871,"_2529":106315,"_26635":106316,"_18309":106318,"_24913":62598},"Validación de certificados",[42855,102114,47892,106317],"Validación",[],{"_3023":62599,"_26291":62598,"_18309":106320,"_5":12556,"_24913":62598,"_2529":106321},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3023":62600,"_26291":62598,"_5":26632,"_18309":106323,"_24913":106324,"_2529":106325},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3023":62601,"_26291":62598,"_5":26632,"_18309":106327,"_24913":106328,"_2529":106329},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3023":62602,"_26291":62598,"_5":26632,"_18309":106331,"_24913":106332,"_2529":106333},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3023":62603,"_26291":62598,"_18309":106335,"_5":12556,"_24913":62598,"_2529":106336},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3023":62604,"_26291":62598,"_18309":106338,"_5":12556,"_24913":106324,"_2529":106339},[],"Verifica estos criterios juntos:",{"_3023":62605,"_26291":62598,"_18309":106341,"_5":12556,"_24913":106324,"_2529":105329},[],{"_3023":62606,"_26291":62598,"_18309":106343,"_5":12556,"_24913":106324,"_2529":106344},[],"Resultado necesario",{"_3023":62607,"_26291":62598,"_18309":106346,"_5":12556,"_24913":106324,"_2529":106347},[],"Cadena y firma",{"_3023":62608,"_26291":62598,"_18309":106349,"_5":12556,"_24913":106324,"_2529":106350},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3023":62609,"_26291":62598,"_18309":106352,"_5":12556,"_24913":106324,"_2529":106353},[],"Fechas",{"_3023":62610,"_26291":62598,"_18309":106355,"_5":12556,"_24913":106324,"_2529":106356},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3023":62611,"_26291":62598,"_18309":106358,"_5":12556,"_24913":106324,"_2529":101818},[],{"_3023":62612,"_26291":62598,"_18309":106360,"_5":12556,"_24913":106324,"_2529":106361},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3023":62613,"_26291":62598,"_18309":106363,"_5":12556,"_24913":106324,"_2529":106364},[],"Uso",{"_3023":62614,"_26291":62598,"_18309":106366,"_5":12556,"_24913":106324,"_2529":106367},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3023":62615,"_26291":62598,"_18309":106369,"_5":12556,"_24913":106324,"_2529":106370},[],"Revocación",{"_3023":62616,"_26291":62598,"_18309":106372,"_5":12556,"_24913":106324,"_2529":106373},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3023":62617,"_26291":62598,"_18309":106375,"_5":12556,"_24913":106324,"_2529":106376},[],"Autorización",{"_3023":62618,"_26291":62598,"_18309":106378,"_5":12556,"_24913":106324,"_2529":106379},[],"La aplicación permite la acción a esa identidad.",{"_3023":62619,"_26291":62598,"_18309":106381,"_5":12556,"_24913":106324,"_2529":106382},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3023":62620,"_26291":62598,"_18309":106384,"_5":12556,"_24913":106328,"_2529":106385},[],"Mecanismo",{"_3023":62621,"_26291":62598,"_18309":106387,"_5":12556,"_24913":106328,"_2529":106388},[],"Cuándo utilizarlo",{"_3023":62622,"_26291":62598,"_18309":106390,"_5":12556,"_24913":106328,"_2529":106391},[],"Qué debes mantener",{"_3023":62623,"_26291":62598,"_18309":106393,"_5":12556,"_24913":106328,"_2529":48585},[],{"_3023":62624,"_26291":62598,"_18309":106395,"_5":12556,"_24913":106328,"_2529":106396},[],"Consulta del estado de un certificado concreto.",{"_3023":62625,"_26291":62598,"_18309":106398,"_5":12556,"_24913":106328,"_2529":106399},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3023":62626,"_26291":62598,"_18309":106401,"_5":12556,"_24913":106328,"_2529":48594},[],{"_3023":62627,"_26291":62598,"_18309":106403,"_5":12556,"_24913":106328,"_2529":106404},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3023":62628,"_26291":62598,"_18309":106406,"_5":12556,"_24913":106328,"_2529":106407},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3023":62629,"_26291":62598,"_18309":106409,"_5":12556,"_24913":106328,"_2529":106410},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3023":62630,"_26291":62598,"_18309":106412,"_5":12556,"_24913":106328,"_2529":106413},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3023":62631,"_26291":62598,"_18309":106415,"_5":12556,"_24913":106332,"_2529":106416},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3023":62632,"_26291":62598,"_18309":106418,"_5":12556,"_24913":106332,"_2529":106419},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3023":62633,"_26291":62598,"_18309":106421,"_5":12556,"_24913":106332,"_2529":106422},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3023":62634,"_26291":62598,"_18309":106424,"_5":12556,"_24913":106332,"_2529":106425},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3023":62635,"_26291":62598,"_18309":106427,"_5":12556,"_24913":106332,"_2529":106428},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3023":62636,"_26291":62598,"_18309":106430,"_5":12556,"_24913":106332,"_2529":106431},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3023":62637,"_26291":62598,"_18309":106433,"_5":12556,"_24913":106332,"_2529":106434},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3023":62638,"_26291":62598,"_18309":106436,"_5":12556,"_24913":106332,"_2529":106437},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3023":62639,"_26291":62598,"_18309":106439,"_5":12556,"_24913":106332,"_2529":106440},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3023":62640,"_26291":62640,"_5":12871,"_2529":106442,"_26635":106443,"_18309":106444,"_24913":62640},"Certificados",[42855,102114,47892,105702],[],{"_3023":62641,"_26291":62640,"_18309":106446,"_5":12556,"_24913":62640,"_2529":106447},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3023":62642,"_26291":62640,"_5":26632,"_18309":106449,"_24913":106450,"_2529":106451},[],"/docs/pr-preview/pr-47/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3023":62643,"_26291":62640,"_5":26632,"_18309":106453,"_24913":106454,"_2529":106455},[],"/docs/pr-preview/pr-47/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3023":62644,"_26291":62640,"_5":26632,"_18309":106457,"_24913":106458,"_2529":106459},[],"/docs/pr-preview/pr-47/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3023":62645,"_26291":62640,"_5":26632,"_18309":106461,"_24913":106462,"_2529":106463},[],"/docs/pr-preview/pr-47/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3023":62646,"_26291":62640,"_5":26632,"_18309":106465,"_24913":106466,"_2529":106467},[],"/docs/pr-preview/pr-47/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3023":62647,"_26291":62640,"_5":26632,"_18309":106469,"_24913":106470,"_2529":106471},[],"/docs/pr-preview/pr-47/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3023":62648,"_26291":62640,"_5":26632,"_18309":106473,"_24913":106474,"_2529":106475},[],"/docs/pr-preview/pr-47/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3023":62649,"_26291":62640,"_5":26632,"_18309":106477,"_24913":106478,"_2529":106479},[],"/docs/pr-preview/pr-47/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3023":62650,"_26291":62640,"_5":26632,"_18309":106481,"_24913":106482,"_2529":106483},[],"/docs/pr-preview/pr-47/es/platform/pki/certificates#continúa","Continúa",{"_3023":62651,"_26291":62640,"_18309":106485,"_5":12556,"_24913":62640,"_2529":106486},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3023":62652,"_26291":62640,"_18309":106488,"_5":12556,"_24913":106450,"_2529":106489},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3023":62653,"_26291":62640,"_18309":106491,"_5":12556,"_24913":106450,"_2529":106492},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3023":62654,"_26291":62640,"_18309":106494,"_5":12556,"_24913":106454,"_2529":106495},[],"Descarga el PEM e inspecciónalo:",{"_3023":62655,"_26291":62640,"_18309":106497,"_5":12556,"_24913":106454,"_2529":106498},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3023":62656,"_26291":62640,"_18309":106500,"_5":12556,"_24913":106458,"_2529":106501},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3023":62657,"_26291":62640,"_18309":106503,"_5":12556,"_24913":106458,"_2529":106504},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3023":62658,"_26291":62640,"_18309":106506,"_5":12556,"_24913":106458,"_2529":106507},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3023":62659,"_26291":62640,"_18309":106509,"_5":12556,"_24913":106458,"_2529":106510},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3023":62660,"_26291":62640,"_18309":106512,"_5":12556,"_24913":106458,"_2529":106513},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3023":62661,"_26291":62640,"_18309":106515,"_5":12556,"_24913":106458,"_2529":106516},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3023":62662,"_26291":62640,"_18309":106518,"_5":12556,"_24913":106458,"_2529":106519},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3023":62663,"_26291":62640,"_18309":106521,"_5":12556,"_24913":106462,"_2529":106522},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3023":62664,"_26291":62640,"_18309":106524,"_5":12556,"_24913":106466,"_2529":106525},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3023":62665,"_26291":62640,"_18309":106527,"_5":12556,"_24913":106470,"_2529":106528},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3023":62666,"_26291":62640,"_18309":106530,"_5":12556,"_24913":106474,"_2529":106531},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3023":62667,"_26291":62640,"_18309":106533,"_5":12556,"_24913":106474,"_2529":106534},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3023":62668,"_26291":62640,"_18309":106536,"_5":12556,"_24913":106474,"_2529":106537},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3023":62669,"_26291":62640,"_18309":106539,"_5":12556,"_24913":106478,"_2529":106540},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3023":62670,"_26291":62640,"_18309":106542,"_5":12556,"_24913":106478,"_2529":106543},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3023":62671,"_26291":62640,"_18309":106545,"_5":12556,"_24913":106478,"_2529":106546},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3023":62672,"_26291":62640,"_18309":106548,"_5":12556,"_24913":106482,"_2529":106549},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3023":62673,"_26291":62640,"_18309":106551,"_5":12556,"_24913":106482,"_2529":106552},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3023":62674,"_26291":62674,"_5":12871,"_2529":106554,"_26635":106555,"_18309":106557,"_24913":62674},"Ciclo de vida de un certificado",[42855,102114,47892,106556],"Conceptos",[],{"_3023":62675,"_26291":62674,"_18309":106559,"_5":12556,"_24913":62674,"_2529":106560},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3023":62676,"_26291":62674,"_5":26632,"_18309":106562,"_24913":106563,"_2529":106564},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3023":62677,"_26291":62674,"_5":26632,"_18309":106566,"_24913":106567,"_2529":106568},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3023":62678,"_26291":62674,"_5":26632,"_18309":106570,"_24913":106571,"_2529":106572},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3023":62679,"_26291":62674,"_5":26632,"_18309":106574,"_24913":106575,"_2529":106576},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3023":62680,"_26291":62674,"_5":26632,"_18309":106578,"_24913":106579,"_2529":106580},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3023":62681,"_26291":62674,"_5":26632,"_18309":106582,"_24913":106583,"_2529":106584},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3023":62682,"_26291":62674,"_5":26632,"_18309":106586,"_24913":106587,"_2529":106588},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_3023":62683,"_26291":62674,"_5":26632,"_18309":106590,"_24913":106591,"_2529":106592},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3023":62684,"_26291":62674,"_5":26632,"_18309":106594,"_24913":106595,"_2529":106596},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3023":62685,"_26291":62674,"_5":26632,"_18309":106598,"_24913":106599,"_2529":106600},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3023":62686,"_26291":62674,"_18309":106602,"_5":12556,"_24913":62674,"_2529":106603},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3023":62687,"_26291":62674,"_18309":106605,"_5":12556,"_24913":106567,"_2529":106606},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3023":62688,"_26291":62674,"_18309":106608,"_5":12556,"_24913":106571,"_2529":106609},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3023":62689,"_26291":62674,"_18309":106611,"_5":12556,"_24913":106575,"_2529":106612},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3023":62690,"_26291":62674,"_18309":106614,"_5":12556,"_24913":106579,"_2529":106615},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3023":62691,"_26291":62674,"_18309":106617,"_5":12556,"_24913":106583,"_2529":106618},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3023":62692,"_26291":62674,"_18309":106620,"_5":12556,"_24913":106587,"_2529":106621},[],"Lamassu persiste cuatro estados X.509:",{"_3023":62693,"_26291":62674,"_18309":106623,"_5":12556,"_24913":106587,"_2529":106624},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3023":62694,"_26291":62674,"_18309":106626,"_5":12556,"_24913":106587,"_2529":106627},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3023":62695,"_26291":62674,"_18309":106629,"_5":12556,"_24913":106587,"_2529":106630},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3023":62696,"_26291":62674,"_18309":106632,"_5":12556,"_24913":106587,"_2529":106633},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3023":62697,"_26291":62674,"_18309":106635,"_5":12556,"_24913":106587,"_2529":106636},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3023":62698,"_26291":62674,"_18309":106638,"_5":12556,"_24913":106591,"_2529":106639},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3023":62699,"_26291":62674,"_18309":106641,"_5":12556,"_24913":106591,"_2529":106642},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3023":62700,"_26291":62674,"_18309":106644,"_5":12556,"_24913":106591,"_2529":106645},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3023":62701,"_26291":62674,"_18309":106647,"_5":12556,"_24913":106595,"_2529":106648},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3023":62702,"_26291":62674,"_18309":106650,"_5":12556,"_24913":106595,"_2529":106651},[],"Antes de confirmar:",{"_3023":62703,"_26291":62674,"_18309":106653,"_5":12556,"_24913":106595,"_2529":106654},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3023":62704,"_26291":62674,"_18309":106656,"_5":12556,"_24913":106595,"_2529":106657},[],"Distribuye la nueva cadena de confianza.",{"_3023":62705,"_26291":62674,"_18309":106659,"_5":12556,"_24913":106595,"_2529":106660},[],"Reemite las identidades necesarias.",{"_3023":62706,"_26291":62674,"_18309":106662,"_5":12556,"_24913":106595,"_2529":106663},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3023":62707,"_26291":62674,"_18309":106665,"_5":12556,"_24913":106595,"_2529":106666},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3023":62708,"_26291":62674,"_18309":106668,"_5":12556,"_24913":106595,"_2529":106669},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3023":62709,"_26291":62674,"_18309":106671,"_5":12556,"_24913":106599,"_2529":106672},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3023":62710,"_26291":62674,"_18309":106674,"_5":12556,"_24913":106599,"_2529":106675},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3023":62711,"_26291":62674,"_18309":106677,"_5":12556,"_24913":106599,"_2529":106678},[],"Cambios de estado y razones de revocación.",{"_3023":62712,"_26291":62674,"_18309":106680,"_5":12556,"_24913":106599,"_2529":106681},[],"Publicación y vigencia de OCSP y CRLs.",{"_3023":62713,"_26291":62674,"_18309":106683,"_5":12556,"_24913":106599,"_2529":106684},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3023":62714,"_26291":62674,"_18309":106686,"_5":12556,"_24913":106599,"_2529":106687},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3023":62715,"_26291":62715,"_5":12871,"_2529":106689,"_26635":106690,"_18309":106691,"_24913":62715},"Modelo de confianza",[42855,102114,47892,106556],[],{"_3023":62716,"_26291":62715,"_18309":106693,"_5":12556,"_24913":62715,"_2529":106694},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3023":62717,"_26291":62715,"_5":26632,"_18309":106696,"_24913":106697,"_2529":106698},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3023":62718,"_26291":62715,"_5":26632,"_18309":106700,"_24913":106701,"_2529":106702},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3023":62719,"_26291":62715,"_5":26632,"_18309":106704,"_24913":106705,"_2529":106706},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3023":62720,"_26291":62715,"_5":26632,"_18309":106708,"_24913":106709,"_2529":106710},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3023":62721,"_26291":62715,"_5":26632,"_18309":106712,"_24913":106713,"_2529":106714},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3023":62722,"_26291":62715,"_5":26632,"_18309":106716,"_24913":106717,"_2529":106718},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3023":62723,"_26291":62715,"_5":26632,"_18309":106720,"_24913":106721,"_2529":106722},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3023":62724,"_26291":62715,"_5":26632,"_18309":106724,"_24913":106725,"_2529":106726},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3023":62725,"_26291":62715,"_5":26632,"_18309":106728,"_24913":106729,"_2529":106730},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3023":62726,"_26291":62715,"_5":26632,"_18309":106732,"_24913":106733,"_2529":106734},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3023":62727,"_26291":62715,"_18309":106736,"_5":12556,"_24913":62715,"_2529":106737},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3023":62728,"_26291":62715,"_18309":106739,"_5":12556,"_24913":106701,"_2529":106740},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3023":62729,"_26291":62715,"_18309":106742,"_5":12556,"_24913":106705,"_2529":106743},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3023":62730,"_26291":62715,"_18309":106745,"_5":12556,"_24913":106709,"_2529":106746},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3023":62731,"_26291":62715,"_18309":106748,"_5":12556,"_24913":106713,"_2529":106749},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3023":62732,"_26291":62715,"_18309":106751,"_5":12556,"_24913":106717,"_2529":106752},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3023":62733,"_26291":62715,"_18309":106754,"_5":12556,"_24913":106717,"_2529":106755},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3023":62734,"_26291":62715,"_18309":106757,"_5":12556,"_24913":106717,"_2529":106758},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3023":62735,"_26291":62715,"_18309":106760,"_5":12556,"_24913":106717,"_2529":106761},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3023":62736,"_26291":62715,"_18309":106763,"_5":12556,"_24913":106717,"_2529":106764},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3023":62737,"_26291":62715,"_18309":106766,"_5":12556,"_24913":106717,"_2529":106767},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3023":62738,"_26291":62715,"_18309":106769,"_5":12556,"_24913":106721,"_2529":106770},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3023":62739,"_26291":62715,"_18309":106772,"_5":12556,"_24913":106721,"_2529":106773},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3023":62740,"_26291":62715,"_18309":106775,"_5":12556,"_24913":106721,"_2529":106776},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación configuradas en el bloque de re-enrolamiento.",{"_3023":62741,"_26291":62715,"_18309":106778,"_5":12556,"_24913":106721,"_2529":106779},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3023":62742,"_26291":62715,"_18309":106781,"_5":12556,"_24913":106721,"_2529":106782},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3023":62743,"_26291":62715,"_18309":106784,"_5":12556,"_24913":106725,"_2529":106785},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3023":62744,"_26291":62715,"_18309":106787,"_5":12556,"_24913":106725,"_2529":106788},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3023":62745,"_26291":62715,"_18309":106790,"_5":12556,"_24913":106725,"_2529":106791},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3023":62746,"_26291":62715,"_18309":106793,"_5":12556,"_24913":106725,"_2529":106794},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3023":62747,"_26291":62715,"_18309":106796,"_5":12556,"_24913":106725,"_2529":106797},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3023":62748,"_26291":62715,"_18309":106799,"_5":12556,"_24913":106725,"_2529":106800},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3023":62749,"_26291":62715,"_18309":106802,"_5":12556,"_24913":106725,"_2529":106803},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3023":62750,"_26291":62715,"_18309":106805,"_5":12556,"_24913":106729,"_2529":106806},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3023":62751,"_26291":62715,"_18309":106808,"_5":12556,"_24913":106733,"_2529":106809},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3023":62752,"_26291":62715,"_18309":106811,"_5":12556,"_24913":106733,"_2529":106812},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3023":62753,"_26291":62715,"_18309":106814,"_5":12556,"_24913":106733,"_2529":106815},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3023":62754,"_26291":62715,"_18309":106817,"_5":12556,"_24913":106733,"_2529":106818},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3023":62755,"_26291":62715,"_18309":106820,"_5":12556,"_24913":106733,"_2529":106821},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3023":62756,"_26291":62715,"_18309":106823,"_5":12556,"_24913":106733,"_2529":106824},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3023":62757,"_26291":62715,"_18309":106826,"_5":12556,"_24913":106733,"_2529":106827},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3023":62758,"_26291":62758,"_5":12871,"_2529":106829,"_26635":106830,"_18309":106831,"_24913":62758},"Listas de revocación (CRL)",[42855,102114,47892,106317],[],{"_3023":62759,"_26291":62758,"_18309":106833,"_5":12556,"_24913":62758,"_2529":106834},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3023":62760,"_26291":62758,"_5":26632,"_18309":106836,"_24913":106837,"_2529":106838},[],"/docs/pr-preview/pr-47/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3023":62761,"_26291":62758,"_5":26632,"_18309":106840,"_24913":106841,"_2529":106842},[],"/docs/pr-preview/pr-47/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3023":62762,"_26291":62758,"_5":26632,"_18309":106844,"_24913":106845,"_2529":106846},[],"/docs/pr-preview/pr-47/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3023":62763,"_26291":62758,"_5":26632,"_18309":106848,"_24913":106849,"_2529":106850},[],"/docs/pr-preview/pr-47/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3023":62764,"_26291":62758,"_5":26632,"_18309":106852,"_24913":106853,"_2529":106854},[],"/docs/pr-preview/pr-47/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3023":62765,"_26291":62758,"_5":26632,"_18309":106856,"_24913":106857,"_2529":106858},[],"/docs/pr-preview/pr-47/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3023":62766,"_26291":62758,"_5":26632,"_18309":106860,"_24913":106861,"_2529":106862},[],"/docs/pr-preview/pr-47/es/platform/pki/crl#referencias","Referencias",{"_3023":62767,"_26291":62758,"_18309":106864,"_5":12556,"_24913":62758,"_2529":106865},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3023":62768,"_26291":62758,"_18309":106867,"_5":12556,"_24913":106837,"_2529":106868},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3023":62769,"_26291":62758,"_18309":106870,"_5":12556,"_24913":106837,"_2529":106871},[],"Campo de `crl_options`",{"_3023":62770,"_26291":62758,"_18309":106873,"_5":12556,"_24913":106837,"_2529":103610},[],{"_3023":62771,"_26291":62758,"_18309":106875,"_5":12556,"_24913":106837,"_2529":106876},[],"Valor inicial del backend",{"_3023":62772,"_26291":62758,"_18309":106878,"_5":12556,"_24913":106837,"_2529":49072},[],{"_3023":62773,"_26291":62758,"_18309":106880,"_5":12556,"_24913":106837,"_2529":106881},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3023":62774,"_26291":62758,"_18309":106883,"_5":12556,"_24913":106837,"_2529":106884},[],"7 días.",{"_3023":62775,"_26291":62758,"_18309":106886,"_5":12556,"_24913":106837,"_2529":49081},[],{"_3023":62776,"_26291":62758,"_18309":106888,"_5":12556,"_24913":106837,"_2529":106889},[],"Plazo desde la publicación que activa la renovación programada.",{"_3023":62777,"_26291":62758,"_18309":106891,"_5":12556,"_24913":106837,"_2529":106892},[],"6 días y 23 horas.",{"_3023":62778,"_26291":62758,"_18309":106894,"_5":12556,"_24913":106837,"_2529":49090},[],{"_3023":62779,"_26291":62758,"_18309":106896,"_5":12556,"_24913":106837,"_2529":106897},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3023":62780,"_26291":62758,"_18309":106899,"_5":12556,"_24913":106837,"_2529":49096},[],{"_3023":62781,"_26291":62758,"_18309":106901,"_5":12556,"_24913":106837,"_2529":49099},[],{"_3023":62782,"_26291":62758,"_18309":106903,"_5":12556,"_24913":106837,"_2529":106904},[],"Campo de configuración inicializado con el SKI de la CA.",{"_3023":62783,"_26291":62758,"_18309":106906,"_5":12556,"_24913":106837,"_2529":106907},[],"SKI de la CA.",{"_3023":62784,"_26291":62758,"_18309":106909,"_5":12556,"_24913":106837,"_2529":106910},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_3023":62785,"_26291":62758,"_18309":106912,"_5":12556,"_24913":106837,"_2529":106913},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_3023":62786,"_26291":62758,"_18309":106915,"_5":12556,"_24913":106841,"_2529":106916},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_3023":62787,"_26291":62758,"_18309":106918,"_5":12556,"_24913":106841,"_2529":106919},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3023":62788,"_26291":62758,"_18309":106921,"_5":12556,"_24913":106841,"_2529":106922},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3023":62789,"_26291":62758,"_18309":106924,"_5":12556,"_24913":106845,"_2529":106925},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3023":62790,"_26291":62758,"_18309":106927,"_5":12556,"_24913":106845,"_2529":106928},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3023":62791,"_26291":62758,"_18309":106930,"_5":12556,"_24913":106849,"_2529":106931},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_3023":62792,"_26291":62758,"_18309":106933,"_5":12556,"_24913":106849,"_2529":106934},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3023":62793,"_26291":62758,"_18309":106936,"_5":12556,"_24913":106849,"_2529":106937},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3023":62794,"_26291":62758,"_18309":106939,"_5":12556,"_24913":106849,"_2529":106940},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3023":62795,"_26291":62758,"_18309":106942,"_5":12556,"_24913":106849,"_2529":106943},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3023":62796,"_26291":62758,"_18309":106945,"_5":12556,"_24913":106853,"_2529":106946},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3023":62797,"_26291":62758,"_18309":106948,"_5":12556,"_24913":106853,"_2529":103799},[],{"_3023":62798,"_26291":62758,"_18309":106950,"_5":12556,"_24913":106853,"_2529":106951},[],"Path relativo",{"_3023":62799,"_26291":62758,"_18309":106953,"_5":12556,"_24913":106853,"_2529":101905},[],{"_3023":62800,"_26291":62758,"_18309":106955,"_5":12556,"_24913":106853,"_2529":49154},[],{"_3023":62801,"_26291":62758,"_18309":106957,"_5":12556,"_24913":106853,"_2529":49157},[],{"_3023":62802,"_26291":62758,"_18309":106959,"_5":12556,"_24913":106853,"_2529":106960},[],"Consultar `crl_options` y `latest_crl`.",{"_3023":62803,"_26291":62758,"_18309":106962,"_5":12556,"_24913":106853,"_2529":49163},[],{"_3023":62804,"_26291":62758,"_18309":106964,"_5":12556,"_24913":106853,"_2529":49157},[],{"_3023":62805,"_26291":62758,"_18309":106966,"_5":12556,"_24913":106853,"_2529":106967},[],"Sustituir la configuración de CRL.",{"_3023":62806,"_26291":62758,"_18309":106969,"_5":12556,"_24913":106853,"_2529":106970},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_3023":62807,"_26291":62758,"_18309":106972,"_5":12556,"_24913":106853,"_2529":106973},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3023":62808,"_26291":62758,"_18309":106975,"_5":12556,"_24913":106857,"_2529":106976},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3023":62809,"_26291":62758,"_18309":106978,"_5":12556,"_24913":106861,"_2529":106979},[],"RFC 5280: perfil X.509 y CRL.",{"_3023":62810,"_26291":62758,"_18309":106981,"_5":12556,"_24913":106861,"_2529":49183},[],{"_3023":62811,"_26291":62758,"_18309":106983,"_5":12556,"_24913":106861,"_2529":49186},[],{"_3023":62812,"_26291":62758,"_18309":106985,"_5":12556,"_24913":106861,"_2529":106986},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3023":62813,"_26291":62758,"_18309":106988,"_5":12556,"_24913":106861,"_2529":106989},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3023":62814,"_26291":62814,"_5":12871,"_2529":106991,"_26635":106992,"_18309":106993,"_24913":62814},"Claves y motores criptográficos",[42855,102114,47892,105702],[],{"_3023":62815,"_26291":62814,"_18309":106995,"_5":12556,"_24913":62814,"_2529":106996},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3023":62816,"_26291":62814,"_5":26632,"_18309":106998,"_24913":106999,"_2529":107000},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3023":62817,"_26291":62814,"_5":26632,"_18309":107002,"_24913":107003,"_2529":107004},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3023":62818,"_26291":62814,"_5":26632,"_18309":107006,"_24913":107007,"_2529":49211},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#file-system",{"_3023":62819,"_26291":62814,"_5":26632,"_18309":107009,"_24913":107010,"_2529":49215},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#hashicorp-vault",{"_3023":62820,"_26291":62814,"_5":26632,"_18309":107012,"_24913":107013,"_2529":49219},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#aws-secrets-manager",{"_3023":62821,"_26291":62814,"_5":26632,"_18309":107015,"_24913":107016,"_2529":49223},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#aws-kms",{"_3023":62822,"_26291":62814,"_5":26632,"_18309":107018,"_24913":107019,"_2529":49227},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#pkcs11",{"_3023":62823,"_26291":62814,"_5":26632,"_18309":107021,"_24913":107022,"_2529":49231},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#azure-key-vault",{"_3023":62824,"_26291":62814,"_5":26632,"_18309":107024,"_24913":107025,"_2529":107026},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3023":62825,"_26291":62814,"_5":26632,"_18309":107028,"_24913":107029,"_2529":107030},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3023":62826,"_26291":62814,"_5":26632,"_18309":107032,"_24913":107033,"_2529":107034},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3023":62827,"_26291":62814,"_5":26632,"_18309":107036,"_24913":107037,"_2529":107038},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3023":62828,"_26291":62814,"_5":26632,"_18309":107040,"_24913":107041,"_2529":107042},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3023":62829,"_26291":62814,"_5":26632,"_18309":107044,"_24913":107045,"_2529":107046},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3023":62830,"_26291":62814,"_5":26632,"_18309":107048,"_24913":107049,"_2529":107050},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3023":62831,"_26291":62814,"_5":26632,"_18309":107052,"_24913":107053,"_2529":49263},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#sign",{"_3023":62832,"_26291":62814,"_5":26632,"_18309":107055,"_24913":107056,"_2529":49267},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#verify",{"_3023":62833,"_26291":62814,"_5":26632,"_18309":107058,"_24913":107059,"_2529":107060},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3023":62834,"_26291":62814,"_5":26632,"_18309":107062,"_24913":107063,"_2529":107064},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3023":62835,"_26291":62814,"_5":26632,"_18309":107066,"_24913":107067,"_2529":107068},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3023":62836,"_26291":62814,"_18309":107070,"_5":12556,"_24913":62814,"_2529":107071},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3023":62837,"_26291":62814,"_18309":107073,"_5":12556,"_24913":62814,"_2529":107074},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3023":62838,"_26291":62814,"_18309":107076,"_5":12556,"_24913":106999,"_2529":107077},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3023":62839,"_26291":62814,"_18309":107079,"_5":12556,"_24913":106999,"_2529":107080},[],"En la práctica, permite:",{"_3023":62840,"_26291":62814,"_18309":107082,"_5":12556,"_24913":106999,"_2529":107083},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3023":62841,"_26291":62814,"_18309":107085,"_5":12556,"_24913":106999,"_2529":107086},[],"Importar claves creadas externamente.",{"_3023":62842,"_26291":62814,"_18309":107088,"_5":12556,"_24913":106999,"_2529":107089},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3023":62843,"_26291":62814,"_18309":107091,"_5":12556,"_24913":106999,"_2529":107092},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3023":62844,"_26291":62814,"_18309":107094,"_5":12556,"_24913":107003,"_2529":107095},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3023":62845,"_26291":62814,"_18309":107097,"_5":12556,"_24913":107003,"_2529":107098},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3023":62846,"_26291":62814,"_18309":107100,"_5":12556,"_24913":107003,"_2529":107101},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3023":62847,"_26291":62814,"_18309":107103,"_5":12556,"_24913":107007,"_2529":107104},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3023":62848,"_26291":62814,"_18309":107106,"_5":12556,"_24913":107010,"_2529":107107},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3023":62849,"_26291":62814,"_18309":107109,"_5":12556,"_24913":107013,"_2529":107110},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3023":62850,"_26291":62814,"_18309":107112,"_5":12556,"_24913":107016,"_2529":107113},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3023":62851,"_26291":62814,"_18309":107115,"_5":12556,"_24913":107019,"_2529":107116},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3023":62852,"_26291":62814,"_18309":107118,"_5":12556,"_24913":107022,"_2529":107119},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3023":62853,"_26291":62814,"_18309":107121,"_5":12556,"_24913":107022,"_2529":107122},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3023":62854,"_26291":62814,"_18309":107124,"_5":12556,"_24913":107022,"_2529":107125},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3023":62855,"_26291":62814,"_18309":107127,"_5":12556,"_24913":107022,"_2529":107128},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3023":62856,"_26291":62814,"_18309":107130,"_5":12556,"_24913":107025,"_2529":107131},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3023":62857,"_26291":62814,"_18309":107133,"_5":12556,"_24913":107025,"_2529":107134},[],"La tabla incluye los siguientes campos:",{"_3023":62858,"_26291":62814,"_18309":107136,"_5":12556,"_24913":107025,"_2529":107137},[],"**Name**: nombre descriptivo de la clave.",{"_3023":62859,"_26291":62814,"_18309":107139,"_5":12556,"_24913":107025,"_2529":107140},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3023":62860,"_26291":62814,"_18309":107142,"_5":12556,"_24913":107025,"_2529":107143},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3023":62861,"_26291":62814,"_18309":107145,"_5":12556,"_24913":107025,"_2529":107146},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3023":62862,"_26291":62814,"_18309":107148,"_5":12556,"_24913":107025,"_2529":107149},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3023":62863,"_26291":62814,"_18309":107151,"_5":12556,"_24913":107025,"_2529":107152},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3023":62864,"_26291":62814,"_18309":107154,"_5":12556,"_24913":107025,"_2529":107155},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3023":62865,"_26291":62814,"_18309":107157,"_5":12556,"_24913":107025,"_2529":107158},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3023":62866,"_26291":62814,"_18309":107160,"_5":12556,"_24913":107025,"_2529":107161},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3023":62867,"_26291":62814,"_18309":107163,"_5":12556,"_24913":107025,"_2529":107164},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3023":62868,"_26291":62814,"_18309":107166,"_5":12556,"_24913":107025,"_2529":107167},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3023":62869,"_26291":62814,"_18309":107169,"_5":12556,"_24913":107025,"_2529":107170},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3023":62870,"_26291":62814,"_18309":107172,"_5":12556,"_24913":107025,"_2529":107173},[],"**Delete Key** para eliminar la clave del sistema.",{"_3023":62871,"_26291":62814,"_18309":107175,"_5":12556,"_24913":107029,"_2529":107176},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3023":62872,"_26291":62814,"_18309":107178,"_5":12556,"_24913":107033,"_2529":107179},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3023":62873,"_26291":62814,"_18309":107181,"_5":12556,"_24913":107033,"_2529":107182},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3023":62874,"_26291":62814,"_18309":107184,"_5":12556,"_24913":107033,"_2529":107185},[],"**Key Name**: nombre único y descriptivo.",{"_3023":62875,"_26291":62814,"_18309":107187,"_5":12556,"_24913":107033,"_2529":107188},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3023":62876,"_26291":62814,"_18309":107190,"_5":12556,"_24913":107033,"_2529":107191},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3023":62877,"_26291":62814,"_18309":107193,"_5":12556,"_24913":107033,"_2529":107194},[],"**Tags**: metadatos para clasificar la clave.",{"_3023":62878,"_26291":62814,"_18309":107196,"_5":12556,"_24913":107033,"_2529":107197},[],"**Metadata**: información adicional para usos avanzados.",{"_3023":62879,"_26291":62814,"_18309":107199,"_5":12556,"_24913":107037,"_2529":107200},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3023":62880,"_26291":62814,"_18309":107202,"_5":12556,"_24913":107037,"_2529":107203},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3023":62881,"_26291":62814,"_18309":107205,"_5":12556,"_24913":107037,"_2529":107206},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3023":62882,"_26291":62814,"_18309":107208,"_5":12556,"_24913":107037,"_2529":107209},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3023":62883,"_26291":62814,"_18309":107211,"_5":12556,"_24913":107037,"_2529":107212},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3023":62884,"_26291":62814,"_18309":107214,"_5":12556,"_24913":107037,"_2529":107215},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3023":62885,"_26291":62814,"_18309":107217,"_5":12556,"_24913":107037,"_2529":107218},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3023":62886,"_26291":62814,"_18309":107220,"_5":12556,"_24913":107037,"_2529":107221},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3023":62887,"_26291":62814,"_18309":107223,"_5":12556,"_24913":107037,"_2529":107224},[],"**Metadata**: información adicional opcional.",{"_3023":62888,"_26291":62814,"_18309":107226,"_5":12556,"_24913":107037,"_2529":107227},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3023":62889,"_26291":62814,"_18309":107229,"_5":12556,"_24913":107037,"_2529":107230},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3023":62890,"_26291":62814,"_18309":107232,"_5":12556,"_24913":107041,"_2529":107233},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3023":62891,"_26291":62814,"_18309":107235,"_5":12556,"_24913":107045,"_2529":107236},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3023":62892,"_26291":62814,"_18309":107238,"_5":12556,"_24913":107045,"_2529":107239},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3023":62893,"_26291":62814,"_18309":107241,"_5":12556,"_24913":107045,"_2529":107242},[],"**Key Name**: nombre descriptivo.",{"_3023":62894,"_26291":62814,"_18309":107244,"_5":12556,"_24913":107045,"_2529":107245},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3023":62895,"_26291":62814,"_18309":107247,"_5":12556,"_24913":107045,"_2529":107248},[],"**Tags**: etiquetas asociadas.",{"_3023":62896,"_26291":62814,"_18309":107250,"_5":12556,"_24913":107045,"_2529":107251},[],"**Aliases**: nombres alternativos.",{"_3023":62897,"_26291":62814,"_18309":107253,"_5":12556,"_24913":107045,"_2529":107254},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3023":62898,"_26291":62814,"_18309":107256,"_5":12556,"_24913":107045,"_2529":107257},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3023":62899,"_26291":62814,"_18309":107259,"_5":12556,"_24913":107045,"_2529":107260},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3023":62900,"_26291":62814,"_18309":107262,"_5":12556,"_24913":107045,"_2529":107263},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3023":62901,"_26291":62814,"_18309":107265,"_5":12556,"_24913":107049,"_2529":107266},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3023":62902,"_26291":62814,"_18309":107268,"_5":12556,"_24913":107049,"_2529":107269},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3023":62903,"_26291":62814,"_18309":107271,"_5":12556,"_24913":107049,"_2529":107272},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3023":62904,"_26291":62814,"_18309":107274,"_5":12556,"_24913":107053,"_2529":107275},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3023":62905,"_26291":62814,"_18309":107277,"_5":12556,"_24913":107053,"_2529":107278},[],"Campos principales:",{"_3023":62906,"_26291":62814,"_18309":107280,"_5":12556,"_24913":107053,"_2529":107281},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3023":62907,"_26291":62814,"_18309":107283,"_5":12556,"_24913":107053,"_2529":107284},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3023":62908,"_26291":62814,"_18309":107286,"_5":12556,"_24913":107053,"_2529":107287},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3023":62909,"_26291":62814,"_18309":107289,"_5":12556,"_24913":107053,"_2529":107290},[],"**Message**: contenido que se va a firmar.",{"_3023":62910,"_26291":62814,"_18309":107292,"_5":12556,"_24913":107053,"_2529":107293},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3023":62911,"_26291":62814,"_18309":107295,"_5":12556,"_24913":107056,"_2529":107296},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3023":62912,"_26291":62814,"_18309":107298,"_5":12556,"_24913":107056,"_2529":107278},[],{"_3023":62913,"_26291":62814,"_18309":107300,"_5":12556,"_24913":107056,"_2529":107301},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3023":62914,"_26291":62814,"_18309":107303,"_5":12556,"_24913":107056,"_2529":107304},[],"**Message Type**: `Raw` o `Digest`.",{"_3023":62915,"_26291":62814,"_18309":107306,"_5":12556,"_24913":107056,"_2529":107307},[],"**Payload Encoding**: codificación del mensaje.",{"_3023":62916,"_26291":62814,"_18309":107309,"_5":12556,"_24913":107056,"_2529":107310},[],"**Message**: mensaje original o hash.",{"_3023":62917,"_26291":62814,"_18309":107312,"_5":12556,"_24913":107056,"_2529":107313},[],"**Signature**: firma que se desea comprobar.",{"_3023":62918,"_26291":62814,"_18309":107315,"_5":12556,"_24913":107056,"_2529":107316},[],"**Result**: indicador del resultado de la validación.",{"_3023":62919,"_26291":62814,"_18309":107318,"_5":12556,"_24913":107059,"_2529":107319},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3023":62920,"_26291":62814,"_18309":107321,"_5":12556,"_24913":107059,"_2529":107322},[],"Este flujo es útil para:",{"_3023":62921,"_26291":62814,"_18309":107324,"_5":12556,"_24913":107059,"_2529":107325},[],"Solicitar certificados a una CA externa.",{"_3023":62922,"_26291":62814,"_18309":107327,"_5":12556,"_24913":107059,"_2529":107328},[],"Renovar una identidad manteniendo la misma clave.",{"_3023":62923,"_26291":62814,"_18309":107330,"_5":12556,"_24913":107059,"_2529":107331},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3023":62924,"_26291":62814,"_18309":107333,"_5":12556,"_24913":107059,"_2529":107334},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3023":62925,"_26291":62814,"_18309":107336,"_5":12556,"_24913":107059,"_2529":107337},[],"**Organization (O)**: organización o empresa.",{"_3023":62926,"_26291":62814,"_18309":107339,"_5":12556,"_24913":107059,"_2529":107340},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3023":62927,"_26291":62814,"_18309":107342,"_5":12556,"_24913":107059,"_2529":107343},[],"**Country (C)**: código de país de dos letras.",{"_3023":62928,"_26291":62814,"_18309":107345,"_5":12556,"_24913":107059,"_2529":107346},[],"**State / Province (ST)**: estado o provincia.",{"_3023":62929,"_26291":62814,"_18309":107348,"_5":12556,"_24913":107059,"_2529":107349},[],"**Locality (L)**: ciudad o localidad.",{"_3023":62930,"_26291":62814,"_18309":107351,"_5":12556,"_24913":107059,"_2529":107352},[],"**Email Address**: correo de contacto.",{"_3023":62931,"_26291":62814,"_18309":107354,"_5":12556,"_24913":107059,"_2529":107355},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3023":62932,"_26291":62814,"_18309":107357,"_5":12556,"_24913":107059,"_2529":107358},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3023":62933,"_26291":62814,"_18309":107360,"_5":12556,"_24913":107063,"_2529":107361},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3023":62934,"_26291":62814,"_18309":107363,"_5":12556,"_24913":107063,"_2529":49575},[],{"_3023":62935,"_26291":62814,"_18309":107365,"_5":12556,"_24913":107067,"_2529":107366},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3023":62936,"_26291":62936,"_5":12871,"_2529":107368,"_26635":107369,"_18309":107370,"_24913":62936},"Validación online con OCSP",[42855,102114,47892,106317],[],{"_3023":62937,"_26291":62936,"_18309":107372,"_5":12556,"_24913":62936,"_2529":107373},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3023":62938,"_26291":62936,"_5":26632,"_18309":107375,"_24913":107376,"_2529":107377},[],"/docs/pr-preview/pr-47/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3023":62939,"_26291":62936,"_5":26632,"_18309":107379,"_24913":107380,"_2529":107381},[],"/docs/pr-preview/pr-47/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3023":62940,"_26291":62936,"_5":26632,"_18309":107383,"_24913":107384,"_2529":107385},[],"/docs/pr-preview/pr-47/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3023":62941,"_26291":62936,"_5":26632,"_18309":107387,"_24913":107388,"_2529":107389},[],"/docs/pr-preview/pr-47/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3023":62942,"_26291":62936,"_5":26632,"_18309":107391,"_24913":107392,"_2529":107393},[],"/docs/pr-preview/pr-47/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3023":62943,"_26291":62936,"_5":26632,"_18309":107395,"_24913":107396,"_2529":106862},[],"/docs/pr-preview/pr-47/es/platform/pki/ocsp#referencias",{"_3023":62944,"_26291":62936,"_18309":107398,"_5":12556,"_24913":62936,"_2529":107399},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3023":62945,"_26291":62936,"_18309":107401,"_5":12556,"_24913":107376,"_2529":107402},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3023":62946,"_26291":62936,"_18309":107404,"_5":12556,"_24913":107376,"_2529":107405},[],"Estado del registro",{"_3023":62947,"_26291":62936,"_18309":107407,"_5":12556,"_24913":107376,"_2529":107408},[],"Respuesta firmada",{"_3023":62948,"_26291":62936,"_18309":107410,"_5":12556,"_24913":107376,"_2529":47070},[],{"_3023":62949,"_26291":62936,"_18309":107412,"_5":12556,"_24913":107376,"_2529":49625},[],{"_3023":62950,"_26291":62936,"_18309":107414,"_5":12556,"_24913":107376,"_2529":47087},[],{"_3023":62951,"_26291":62936,"_18309":107416,"_5":12556,"_24913":107376,"_2529":107417},[],"`Revoked`, con razón y fecha de revocación.",{"_3023":62952,"_26291":62936,"_18309":107419,"_5":12556,"_24913":107376,"_2529":107420},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3023":62953,"_26291":62936,"_18309":107422,"_5":12556,"_24913":107376,"_2529":107423},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3023":62954,"_26291":62936,"_18309":107425,"_5":12556,"_24913":107376,"_2529":107426},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3023":62955,"_26291":62936,"_18309":107428,"_5":12556,"_24913":107376,"_2529":107429},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3023":62956,"_26291":62936,"_18309":107431,"_5":12556,"_24913":107376,"_2529":107432},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3023":62957,"_26291":62936,"_18309":107434,"_5":12556,"_24913":107380,"_2529":107435},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3023":62958,"_26291":62936,"_18309":107437,"_5":12556,"_24913":107380,"_2529":107438},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3023":62959,"_26291":62936,"_18309":107440,"_5":12556,"_24913":107384,"_2529":107441},[],"El servicio acepta:",{"_3023":62960,"_26291":62936,"_18309":107443,"_5":12556,"_24913":107384,"_2529":103799},[],{"_3023":62961,"_26291":62936,"_18309":107445,"_5":12556,"_24913":107384,"_2529":107446},[],"Ruta del servicio VA",{"_3023":62962,"_26291":62936,"_18309":107448,"_5":12556,"_24913":107384,"_2529":107449},[],"Formato",{"_3023":62963,"_26291":62936,"_18309":107451,"_5":12556,"_24913":107384,"_2529":49665},[],{"_3023":62964,"_26291":62936,"_18309":107453,"_5":12556,"_24913":107384,"_2529":49668},[],{"_3023":62965,"_26291":62936,"_18309":107455,"_5":12556,"_24913":107384,"_2529":107456},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3023":62966,"_26291":62936,"_18309":107458,"_5":12556,"_24913":107384,"_2529":49154},[],{"_3023":62967,"_26291":62936,"_18309":107460,"_5":12556,"_24913":107384,"_2529":49676},[],{"_3023":62968,"_26291":62936,"_18309":107462,"_5":12556,"_24913":107384,"_2529":107463},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3023":62969,"_26291":62936,"_18309":107465,"_5":12556,"_24913":107384,"_2529":107466},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3023":62970,"_26291":62936,"_18309":107468,"_5":12556,"_24913":107388,"_2529":107469},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3023":62971,"_26291":62936,"_18309":107471,"_5":12556,"_24913":107388,"_2529":107472},[],"Genera la solicitud:",{"_3023":62972,"_26291":62936,"_18309":107474,"_5":12556,"_24913":107388,"_2529":107475},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3023":62973,"_26291":62936,"_18309":107477,"_5":12556,"_24913":107388,"_2529":107478},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3023":62974,"_26291":62936,"_18309":107480,"_5":12556,"_24913":107388,"_2529":107481},[],"Verifica el DER recibido:",{"_3023":62975,"_26291":62936,"_18309":107483,"_5":12556,"_24913":107388,"_2529":107484},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3023":62976,"_26291":62936,"_18309":107486,"_5":12556,"_24913":107392,"_2529":107487},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3023":62977,"_26291":62936,"_18309":107489,"_5":12556,"_24913":107392,"_2529":107490},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3023":62978,"_26291":62936,"_18309":107492,"_5":12556,"_24913":107396,"_2529":49709},[],{"_3023":62979,"_26291":62936,"_18309":107494,"_5":12556,"_24913":107396,"_2529":49712},[],{"_3023":62980,"_26291":62936,"_18309":107496,"_5":12556,"_24913":107396,"_2529":107497},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3023":62981,"_26291":62936,"_18309":107499,"_5":12556,"_24913":107396,"_2529":106989},[],{"_3023":62982,"_26291":62982,"_5":12871,"_2529":47892,"_26635":107501,"_18309":107502,"_24913":62982},[42855,102114,47892],[],{"_3023":62983,"_26291":62982,"_18309":107504,"_5":12556,"_24913":62982,"_2529":107505},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3023":62984,"_26291":62982,"_5":26632,"_18309":107507,"_24913":107508,"_2529":105026},[],"/docs/pr-preview/pr-47/es/platform/pki/overview#empieza-aquí",{"_3023":62985,"_26291":62982,"_5":26632,"_18309":107510,"_24913":107511,"_2529":107512},[],"/docs/pr-preview/pr-47/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3023":62986,"_26291":62982,"_5":26632,"_18309":107514,"_24913":107515,"_2529":105548},[],"/docs/pr-preview/pr-47/es/platform/pki/overview#capacidades-principales",{"_3023":62987,"_26291":62982,"_5":26632,"_18309":107517,"_24913":107518,"_2529":105552},[],"/docs/pr-preview/pr-47/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3023":62988,"_26291":62982,"_5":26632,"_18309":107520,"_24913":107521,"_2529":105556},[],"/docs/pr-preview/pr-47/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3023":62989,"_26291":62982,"_5":26632,"_18309":107523,"_24913":107524,"_2529":105560},[],"/docs/pr-preview/pr-47/es/platform/pki/overview#emite-y-controla-certificados",{"_3023":62990,"_26291":62982,"_5":26632,"_18309":107526,"_24913":107527,"_2529":105568},[],"/docs/pr-preview/pr-47/es/platform/pki/overview#publica-el-estado-de-validación",{"_3023":62991,"_26291":62982,"_5":26632,"_18309":107529,"_24913":107530,"_2529":107531},[],"/docs/pr-preview/pr-47/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3023":62992,"_26291":62982,"_5":26632,"_18309":107533,"_24913":107534,"_2529":106483},[],"/docs/pr-preview/pr-47/es/platform/pki/overview#continúa",{"_3023":62993,"_26291":62982,"_18309":107536,"_5":12556,"_24913":62982,"_2529":107537},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3023":62994,"_26291":62982,"_18309":107539,"_5":12556,"_24913":107508,"_2529":107540},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3023":62995,"_26291":62982,"_18309":107542,"_5":12556,"_24913":107508,"_2529":107543},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3023":62996,"_26291":62982,"_18309":107545,"_5":12556,"_24913":107511,"_2529":107546},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3023":62997,"_26291":62982,"_18309":107548,"_5":12556,"_24913":107511,"_2529":107549},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3023":62998,"_26291":62982,"_18309":107551,"_5":12556,"_24913":107511,"_2529":107552},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3023":62999,"_26291":62982,"_18309":107554,"_5":12556,"_24913":107511,"_2529":107555},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3023":63000,"_26291":62982,"_18309":107557,"_5":12556,"_24913":107511,"_2529":107558},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3023":63001,"_26291":62982,"_18309":107560,"_5":12556,"_24913":107518,"_2529":107561},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3023":63002,"_26291":62982,"_18309":107563,"_5":12556,"_24913":107521,"_2529":107564},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3023":63003,"_26291":62982,"_18309":107566,"_5":12556,"_24913":107524,"_2529":107567},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3023":63004,"_26291":62982,"_18309":107569,"_5":12556,"_24913":107527,"_2529":107570},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3023":63005,"_26291":62982,"_18309":107572,"_5":12556,"_24913":107530,"_2529":107573},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3023":63006,"_26291":62982,"_18309":107575,"_5":12556,"_24913":107530,"_2529":107576},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3023":63007,"_26291":62982,"_18309":107578,"_5":12556,"_24913":107530,"_2529":107579},[],"su clave pública corresponda a la clave privada del cliente;",{"_3023":63008,"_26291":62982,"_18309":107581,"_5":12556,"_24913":107530,"_2529":107582},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3023":63009,"_26291":62982,"_18309":107584,"_5":12556,"_24913":107530,"_2529":107585},[],"sus fechas y usos permitan la operación;",{"_3023":63010,"_26291":62982,"_18309":107587,"_5":12556,"_24913":107530,"_2529":107588},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3023":63011,"_26291":62982,"_18309":107590,"_5":12556,"_24913":107530,"_2529":107591},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3023":63012,"_26291":62982,"_18309":107593,"_5":12556,"_24913":107534,"_2529":107594},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3023":63013,"_26291":62982,"_18309":107596,"_5":12556,"_24913":107534,"_2529":107597},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3023":63014,"_26291":62982,"_18309":107599,"_5":12556,"_24913":107534,"_2529":107600},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3023":63015,"_26291":63015,"_5":12871,"_2529":107602,"_26635":107603,"_18309":107604,"_24913":63015},"Crea tu primera CA",[42855,102114,47892,105150],[],{"_3023":63016,"_26291":63015,"_18309":107606,"_5":12556,"_24913":63015,"_2529":107607},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3023":63017,"_26291":63015,"_5":26632,"_18309":107609,"_24913":107610,"_2529":100815},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3023":63018,"_26291":63015,"_5":26632,"_18309":107612,"_24913":107613,"_2529":107614},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_3023":63019,"_26291":63015,"_5":26632,"_18309":107616,"_24913":107617,"_2529":107618},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_3023":63020,"_26291":63015,"_5":26632,"_18309":107620,"_24913":107621,"_2529":107622},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_3023":63021,"_26291":63015,"_5":26632,"_18309":107624,"_24913":107625,"_2529":107626},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_3023":63022,"_26291":63015,"_5":26632,"_18309":107628,"_24913":107629,"_2529":107630},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_3023":63023,"_26291":63015,"_5":26632,"_18309":107632,"_24913":107633,"_2529":107634},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3023":63024,"_26291":63015,"_5":26632,"_18309":107636,"_24913":107637,"_2529":105398},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3023":63025,"_26291":63015,"_5":26632,"_18309":107639,"_24913":107640,"_2529":100839},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3023":63026,"_26291":63015,"_18309":107642,"_5":12556,"_24913":63015,"_2529":107643},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3023":63027,"_26291":63015,"_18309":107645,"_5":12556,"_24913":107610,"_2529":107646},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3023":63028,"_26291":63015,"_18309":107648,"_5":12556,"_24913":107610,"_2529":107649},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3023":63029,"_26291":63015,"_18309":107651,"_5":12556,"_24913":107610,"_2529":107652},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3023":63030,"_26291":63015,"_18309":107654,"_5":12556,"_24913":107610,"_2529":107655},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3023":63031,"_26291":63015,"_18309":107657,"_5":12556,"_24913":107613,"_2529":107658},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3023":63032,"_26291":63015,"_18309":107660,"_5":12556,"_24913":107613,"_2529":107661},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3023":63033,"_26291":63015,"_18309":107663,"_5":12556,"_24913":107617,"_2529":107664},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3023":63034,"_26291":63015,"_18309":107666,"_5":12556,"_24913":107617,"_2529":107667},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3023":63035,"_26291":63015,"_18309":107669,"_5":12556,"_24913":107621,"_2529":107670},[],"Selecciona **Root CA** y completa:",{"_3023":63036,"_26291":63015,"_18309":107672,"_5":12556,"_24913":107621,"_2529":49891},[],{"_3023":63037,"_26291":63015,"_18309":107674,"_5":12556,"_24913":107621,"_2529":107675},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3023":63038,"_26291":63015,"_18309":107677,"_5":12556,"_24913":107621,"_2529":107678},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3023":63039,"_26291":63015,"_18309":107680,"_5":12556,"_24913":107621,"_2529":107681},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3023":63040,"_26291":63015,"_18309":107683,"_5":12556,"_24913":107621,"_2529":107684},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3023":63041,"_26291":63015,"_18309":107686,"_5":12556,"_24913":107625,"_2529":107687},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3023":63042,"_26291":63015,"_18309":107689,"_5":12556,"_24913":107629,"_2529":107690},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3023":63043,"_26291":63015,"_18309":107692,"_5":12556,"_24913":107629,"_2529":107693},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3023":63044,"_26291":63015,"_18309":107695,"_5":12556,"_24913":107633,"_2529":107696},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3023":63045,"_26291":63015,"_18309":107698,"_5":12556,"_24913":107633,"_2529":107699},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3023":63046,"_26291":63015,"_18309":107701,"_5":12556,"_24913":107633,"_2529":107702},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3023":63047,"_26291":63015,"_18309":107704,"_5":12556,"_24913":107637,"_2529":107705},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3023":63048,"_26291":63015,"_18309":107707,"_5":12556,"_24913":107637,"_2529":107708},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3023":63049,"_26291":63015,"_18309":107710,"_5":12556,"_24913":107637,"_2529":107711},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3023":63050,"_26291":63015,"_18309":107713,"_5":12556,"_24913":107637,"_2529":107714},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3023":63051,"_26291":63015,"_18309":107716,"_5":12556,"_24913":107640,"_2529":107717},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3023":63052,"_26291":63052,"_5":12871,"_2529":107719,"_26635":107720,"_18309":107721,"_24913":63052},"Emite y verifica un certificado",[42855,102114,47892,105150],[],{"_3023":63053,"_26291":63052,"_18309":107723,"_5":12556,"_24913":63052,"_2529":107724},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3023":63054,"_26291":63052,"_5":26632,"_18309":107726,"_24913":107727,"_2529":100815},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3023":63055,"_26291":63052,"_5":26632,"_18309":107729,"_24913":107730,"_2529":107731},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3023":63056,"_26291":63052,"_5":26632,"_18309":107733,"_24913":107734,"_2529":107735},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3023":63057,"_26291":63052,"_5":26632,"_18309":107737,"_24913":107738,"_2529":107739},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3023":63058,"_26291":63052,"_5":26632,"_18309":107741,"_24913":107742,"_2529":107743},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3023":63059,"_26291":63052,"_5":26632,"_18309":107745,"_24913":107746,"_2529":107747},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3023":63060,"_26291":63052,"_5":26632,"_18309":107749,"_24913":107750,"_2529":107630},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_3023":63061,"_26291":63052,"_5":26632,"_18309":107752,"_24913":107753,"_2529":107754},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3023":63062,"_26291":63052,"_5":26632,"_18309":107756,"_24913":107757,"_2529":107758},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3023":63063,"_26291":63052,"_5":26632,"_18309":107760,"_24913":107761,"_2529":107762},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3023":63064,"_26291":63052,"_5":26632,"_18309":107764,"_24913":107765,"_2529":105398},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3023":63065,"_26291":63052,"_5":26632,"_18309":107767,"_24913":107768,"_2529":100839},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3023":63066,"_26291":63052,"_18309":107770,"_5":12556,"_24913":63052,"_2529":107771},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3023":63067,"_26291":63052,"_18309":107773,"_5":12556,"_24913":107727,"_2529":107774},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3023":63068,"_26291":63052,"_18309":107776,"_5":12556,"_24913":107727,"_2529":107777},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3023":63069,"_26291":63052,"_18309":107779,"_5":12556,"_24913":107727,"_2529":107780},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3023":63070,"_26291":63052,"_18309":107782,"_5":12556,"_24913":107727,"_2529":107783},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3023":63071,"_26291":63052,"_18309":107785,"_5":12556,"_24913":107727,"_2529":107786},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3023":63072,"_26291":63052,"_18309":107788,"_5":12556,"_24913":107730,"_2529":107789},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3023":63073,"_26291":63052,"_18309":107791,"_5":12556,"_24913":107734,"_2529":107792},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3023":63074,"_26291":63052,"_18309":107794,"_5":12556,"_24913":107734,"_2529":107795},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3023":63075,"_26291":63052,"_18309":107797,"_5":12556,"_24913":107738,"_2529":107798},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3023":63076,"_26291":63052,"_18309":107800,"_5":12556,"_24913":107738,"_2529":107801},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3023":63077,"_26291":63052,"_18309":107803,"_5":12556,"_24913":107742,"_2529":107804},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3023":63078,"_26291":63052,"_18309":107806,"_5":12556,"_24913":107742,"_2529":107807},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3023":63079,"_26291":63052,"_18309":107809,"_5":12556,"_24913":107746,"_2529":107810},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3023":63080,"_26291":63052,"_18309":107812,"_5":12556,"_24913":107750,"_2529":107813},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3023":63081,"_26291":63052,"_18309":107815,"_5":12556,"_24913":107753,"_2529":107816},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3023":63082,"_26291":63052,"_18309":107818,"_5":12556,"_24913":107757,"_2529":107819},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3023":63083,"_26291":63052,"_18309":107821,"_5":12556,"_24913":107757,"_2529":107822},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3023":63084,"_26291":63052,"_18309":107824,"_5":12556,"_24913":107757,"_2529":107825},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3023":63085,"_26291":63052,"_18309":107827,"_5":12556,"_24913":107761,"_2529":107828},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3023":63086,"_26291":63052,"_18309":107830,"_5":12556,"_24913":107761,"_2529":107831},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3023":63087,"_26291":63052,"_18309":107833,"_5":12556,"_24913":107761,"_2529":107834},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3023":63088,"_26291":63052,"_18309":107836,"_5":12556,"_24913":107765,"_2529":105481},[],{"_3023":63089,"_26291":63052,"_18309":107838,"_5":12556,"_24913":107765,"_2529":104248},[],{"_3023":63090,"_26291":63052,"_18309":107840,"_5":12556,"_24913":107765,"_2529":107841},[],"La CA rechaza la emisión",{"_3023":63091,"_26291":63052,"_18309":107843,"_5":12556,"_24913":107765,"_2529":107844},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3023":63092,"_26291":63052,"_18309":107846,"_5":12556,"_24913":107765,"_2529":107847},[],"Sujeto o usos diferentes",{"_3023":63093,"_26291":63052,"_18309":107849,"_5":12556,"_24913":107765,"_2529":107850},[],"Perfil aplicado y valores solicitados.",{"_3023":63094,"_26291":63052,"_18309":107852,"_5":12556,"_24913":107765,"_2529":107853},[],"No se encuentra el emisor",{"_3023":63095,"_26291":63052,"_18309":107855,"_5":12556,"_24913":107765,"_2529":107856},[],"CA descargada y cadena intermedia necesaria.",{"_3023":63096,"_26291":63052,"_18309":107858,"_5":12556,"_24913":107765,"_2529":107859},[],"Falla la vigencia",{"_3023":63097,"_26291":63052,"_18309":107861,"_5":12556,"_24913":107765,"_2529":107862},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3023":63098,"_26291":63052,"_18309":107864,"_5":12556,"_24913":107765,"_2529":107865},[],"Los resúmenes de clave difieren",{"_3023":63099,"_26291":63052,"_18309":107867,"_5":12556,"_24913":107765,"_2529":107868},[],"Archivos de certificado y clave de la misma emisión.",{"_3023":63100,"_26291":63052,"_18309":107870,"_5":12556,"_24913":107765,"_2529":107871},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3023":63101,"_26291":63052,"_18309":107873,"_5":12556,"_24913":107768,"_2529":107874},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3023":63102,"_26291":63052,"_18309":107876,"_5":12556,"_24913":107768,"_2529":107877},[],"Gestionar certificados para inspección, estado y revocación.",{"_3023":63103,"_26291":63052,"_18309":107879,"_5":12556,"_24913":107768,"_2529":107880},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3023":63104,"_26291":63052,"_18309":107882,"_5":12556,"_24913":107768,"_2529":107883},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3023":63105,"_26291":63052,"_18309":107885,"_5":12556,"_24913":107768,"_2529":107886},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3023":63106,"_26291":63106,"_5":12871,"_2529":107888,"_26635":107889,"_18309":107890,"_24913":63106},"Primeros pasos de PKI",[42855,102114,47892,105150],[],{"_3023":63107,"_26291":63106,"_18309":107892,"_5":12556,"_24913":63106,"_2529":107893},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3023":63108,"_26291":63106,"_5":26632,"_18309":107895,"_24913":107896,"_2529":100815},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3023":63109,"_26291":63106,"_5":26632,"_18309":107898,"_24913":107899,"_2529":107900},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3023":63110,"_26291":63106,"_5":26632,"_18309":107902,"_24913":107903,"_2529":105332},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3023":63111,"_26291":63106,"_5":26632,"_18309":107905,"_24913":107906,"_2529":107907},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3023":63112,"_26291":63106,"_18309":107909,"_5":12556,"_24913":63106,"_2529":107910},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3023":63113,"_26291":63106,"_18309":107912,"_5":12556,"_24913":107896,"_2529":107913},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3023":63114,"_26291":63106,"_18309":107915,"_5":12556,"_24913":107896,"_2529":107916},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3023":63115,"_26291":63106,"_18309":107918,"_5":12556,"_24913":107896,"_2529":107919},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3023":63116,"_26291":63106,"_18309":107921,"_5":12556,"_24913":107896,"_2529":107922},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3023":63117,"_26291":63106,"_18309":107924,"_5":12556,"_24913":107896,"_2529":107925},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3023":63118,"_26291":63106,"_18309":107927,"_5":12556,"_24913":107899,"_2529":107928},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3023":63119,"_26291":63106,"_18309":107930,"_5":12556,"_24913":107899,"_2529":107931},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3023":63120,"_26291":63106,"_18309":107933,"_5":12556,"_24913":107899,"_2529":107934},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3023":63121,"_26291":63106,"_18309":107936,"_5":12556,"_24913":107899,"_2529":107937},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3023":63122,"_26291":63106,"_18309":107939,"_5":12556,"_24913":107903,"_2529":107940},[],"Archivo o recurso",{"_3023":63123,"_26291":63106,"_18309":107942,"_5":12556,"_24913":107903,"_2529":105329},[],{"_3023":63124,"_26291":63106,"_18309":107944,"_5":12556,"_24913":107903,"_2529":107945},[],"CA raíz activa y `ca.pem`",{"_3023":63125,"_26291":63106,"_18309":107947,"_5":12556,"_24913":107903,"_2529":107948},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3023":63126,"_26291":63106,"_18309":107950,"_5":12556,"_24913":107903,"_2529":107951},[],"Certificado final y `device.crt`",{"_3023":63127,"_26291":63106,"_18309":107953,"_5":12556,"_24913":107903,"_2529":107954},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3023":63128,"_26291":63106,"_18309":107956,"_5":12556,"_24913":107903,"_2529":107957},[],"Clave privada `device.key`",{"_3023":63129,"_26291":63106,"_18309":107959,"_5":12556,"_24913":107903,"_2529":107960},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3023":63130,"_26291":63106,"_18309":107962,"_5":12556,"_24913":107903,"_2529":107963},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3023":63131,"_26291":63106,"_18309":107965,"_5":12556,"_24913":107906,"_2529":107966},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3023":63132,"_26291":63106,"_18309":107968,"_5":12556,"_24913":107906,"_2529":107969},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3023":63133,"_26291":63106,"_18309":107971,"_5":12556,"_24913":107906,"_2529":107972},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3023":63134,"_26291":63134,"_5":12871,"_2529":107974,"_26635":107975,"_18309":107977,"_24913":63134},"Resolución de problemas PKI",[42855,102114,47892,107976],"Resolución de problemas",[],{"_3023":63135,"_26291":63134,"_18309":107979,"_5":12556,"_24913":63134,"_2529":107980},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3023":63136,"_26291":63134,"_5":26632,"_18309":107982,"_24913":107983,"_2529":107984},[],"/docs/pr-preview/pr-47/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3023":63137,"_26291":63134,"_5":26632,"_18309":107986,"_24913":107987,"_2529":107988},[],"/docs/pr-preview/pr-47/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3023":63138,"_26291":63134,"_5":26632,"_18309":107990,"_24913":107991,"_2529":107992},[],"/docs/pr-preview/pr-47/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3023":63139,"_26291":63134,"_18309":107994,"_5":12556,"_24913":63134,"_2529":107995},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3023":63140,"_26291":63134,"_18309":107997,"_5":12556,"_24913":63134,"_2529":107998},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3023":63141,"_26291":63134,"_18309":108000,"_5":12556,"_24913":107983,"_2529":105329},[],{"_3023":63142,"_26291":63134,"_18309":108002,"_5":12556,"_24913":107983,"_2529":104248},[],{"_3023":63143,"_26291":63134,"_18309":108004,"_5":12556,"_24913":107983,"_2529":100839},[],{"_3023":63144,"_26291":63134,"_18309":108006,"_5":12556,"_24913":107983,"_2529":50227},[],{"_3023":63145,"_26291":63134,"_18309":108008,"_5":12556,"_24913":107983,"_2529":108009},[],"Existe, está activa y sus fechas son utilizables.",{"_3023":63146,"_26291":63134,"_18309":108011,"_5":12556,"_24913":107983,"_2529":108012},[],"Autoridades.",{"_3023":63147,"_26291":63134,"_18309":108014,"_5":12556,"_24913":107983,"_2529":108015},[],"Clave",{"_3023":63148,"_26291":63134,"_18309":108017,"_5":12556,"_24913":107983,"_2529":108018},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3023":63149,"_26291":63134,"_18309":108020,"_5":12556,"_24913":107983,"_2529":108021},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3023":63150,"_26291":63134,"_18309":108023,"_5":12556,"_24913":107983,"_2529":50245},[],{"_3023":63151,"_26291":63134,"_18309":108025,"_5":12556,"_24913":107983,"_2529":108026},[],"PEM correcto y firma verificable.",{"_3023":63152,"_26291":63134,"_18309":108028,"_5":12556,"_24913":107983,"_2529":50251},[],{"_3023":63153,"_26291":63134,"_18309":108030,"_5":12556,"_24913":107983,"_2529":108031},[],"Perfil",{"_3023":63154,"_26291":63134,"_18309":108033,"_5":12556,"_24913":107983,"_2529":108034},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3023":63155,"_26291":63134,"_18309":108036,"_5":12556,"_24913":107983,"_2529":108037},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3023":63156,"_26291":63134,"_18309":108039,"_5":12556,"_24913":107983,"_2529":105481},[],{"_3023":63157,"_26291":63134,"_18309":108041,"_5":12556,"_24913":107983,"_2529":108042},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3023":63158,"_26291":63134,"_18309":108044,"_5":12556,"_24913":107983,"_2529":108045},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3023":63159,"_26291":63134,"_18309":108047,"_5":12556,"_24913":107983,"_2529":108048},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3023":63160,"_26291":63134,"_18309":108050,"_5":12556,"_24913":107983,"_2529":108051},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3023":63161,"_26291":63134,"_18309":108053,"_5":12556,"_24913":107987,"_2529":108054},[],"Revisa cada frontera por separado:",{"_3023":63162,"_26291":63134,"_18309":108056,"_5":12556,"_24913":107987,"_2529":108057},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3023":63163,"_26291":63134,"_18309":108059,"_5":12556,"_24913":107987,"_2529":108060},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3023":63164,"_26291":63134,"_18309":108062,"_5":12556,"_24913":107987,"_2529":108063},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3023":63165,"_26291":63134,"_18309":108065,"_5":12556,"_24913":107987,"_2529":108066},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3023":63166,"_26291":63134,"_18309":108068,"_5":12556,"_24913":107987,"_2529":108069},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3023":63167,"_26291":63134,"_18309":108071,"_5":12556,"_24913":107987,"_2529":108072},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3023":63168,"_26291":63134,"_18309":108074,"_5":12556,"_24913":107991,"_2529":108075},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3023":63169,"_26291":63134,"_18309":108077,"_5":12556,"_24913":107991,"_2529":108078},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3023":63170,"_26291":63170,"_5":12871,"_2529":108080,"_26635":108081,"_18309":108083,"_24913":63170},"3.8.0 a 4.0.0",[42855,108082],"Actualizaciones",[],{"_3023":63171,"_26291":63170,"_18309":108085,"_5":12556,"_24913":63170,"_2529":108086},[],"Cambios de 4.0.0 que afectan a la configuración de los DMS, al almacenamiento del backend, a los eventos de dispositivo y a la autorización; qué puede fallar tras actualizar desde 3.8.0 y cómo comprobarlo.",{"_3023":63172,"_26291":63170,"_5":26632,"_18309":108088,"_24913":108089,"_2529":108090},[],"/docs/pr-preview/pr-47/es/upgrades/3-8-0-to-4-0-0#resumen","Resumen",{"_3023":63173,"_26291":63170,"_5":26632,"_18309":108092,"_24913":108093,"_2529":108094},[],"/docs/pr-preview/pr-47/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3023":63174,"_26291":63170,"_5":26632,"_18309":108096,"_24913":108097,"_2529":108098},[],"/docs/pr-preview/pr-47/es/upgrades/3-8-0-to-4-0-0#webhooks-con-referencias-a-archivos","Webhooks con referencias a archivos",{"_3023":63175,"_26291":63170,"_5":26632,"_18309":108100,"_24913":108101,"_2529":108102},[],"/docs/pr-preview/pr-47/es/upgrades/3-8-0-to-4-0-0#verificación-del-certificado-del-receptor","Verificación del certificado del receptor",{"_3023":63176,"_26291":63170,"_5":26632,"_18309":108104,"_24913":108105,"_2529":108106},[],"/docs/pr-preview/pr-47/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3023":63177,"_26291":63170,"_5":26632,"_18309":108108,"_24913":108109,"_2529":108110},[],"/docs/pr-preview/pr-47/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3023":63178,"_26291":63170,"_5":26632,"_18309":108112,"_24913":108113,"_2529":108114},[],"/docs/pr-preview/pr-47/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3023":63179,"_26291":63170,"_5":26632,"_18309":108116,"_24913":108117,"_2529":108118},[],"/docs/pr-preview/pr-47/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3023":63180,"_26291":63170,"_5":26632,"_18309":108120,"_24913":108121,"_2529":108122},[],"/docs/pr-preview/pr-47/es/upgrades/3-8-0-to-4-0-0#migraciones-sobre-la-base-de-datos-pki","Migraciones sobre la base de datos pki",{"_3023":63181,"_26291":63170,"_5":26632,"_18309":108124,"_24913":108125,"_2529":108126},[],"/docs/pr-preview/pr-47/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3023":63182,"_26291":63170,"_5":26632,"_18309":108128,"_24913":108129,"_2529":108130},[],"/docs/pr-preview/pr-47/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3023":63183,"_26291":63170,"_5":26632,"_18309":108132,"_24913":108133,"_2529":108134},[],"/docs/pr-preview/pr-47/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3023":63184,"_26291":63170,"_5":26632,"_18309":108136,"_24913":108137,"_2529":108138},[],"/docs/pr-preview/pr-47/es/upgrades/3-8-0-to-4-0-0#cambio-de-autorización","Cambio de autorización",{"_3023":63185,"_26291":63170,"_5":26632,"_18309":108140,"_24913":108141,"_2529":50365},[],"/docs/pr-preview/pr-47/es/upgrades/3-8-0-to-4-0-0#amqp",{"_3023":63186,"_26291":63170,"_5":26632,"_18309":108143,"_24913":108144,"_2529":108145},[],"/docs/pr-preview/pr-47/es/upgrades/3-8-0-to-4-0-0#almacenamiento-local-e-imágenes-de-contenedor","Almacenamiento local e imágenes de contenedor",{"_3023":63187,"_26291":63170,"_5":26632,"_18309":108147,"_24913":108148,"_2529":108149},[],"/docs/pr-preview/pr-47/es/upgrades/3-8-0-to-4-0-0#lista-de-verificación","Lista de verificación",{"_3023":63188,"_26291":63170,"_18309":108151,"_5":12556,"_24913":63170,"_2529":108152},[],"La actualización de 3.8.0 a 4.0.0 migra automáticamente la configuración almacenada de los DMS. Casi todo se convierte sin intervención, pero hay tres cambios que pueden dejar enrolamientos fallando o configuraciones con valores inesperados si no se revisan. Esta página indica qué cambia, qué síntomas produce y qué hacer en cada caso. El comportamiento vigente de cada funcionalidad está en las páginas de DMS.",{"_3023":63189,"_26291":63170,"_18309":108154,"_5":12556,"_24913":63170,"_2529":108155},[],"La actualización también incluye cambios del backend que no afectan solo a los DMS: el almacenamiento se consolida en la base de datos PostgreSQL `pki`, las claves de CA heredadas pueden registrarse en el KMS, los eventos de dispositivo pasan a un almacenamiento propio, `authz` sustituye a la validación de tokens del gateway y el almacenamiento SQLite desaparece. Estos pasos se cubren a partir de Consolidación en PostgreSQL y conviene completarlos antes de las comprobaciones de los DMS.",{"_3023":63190,"_26291":63170,"_18309":108157,"_5":12556,"_24913":63170,"_2529":108158},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3023":63191,"_26291":63170,"_18309":108160,"_5":12556,"_24913":108089,"_2529":108161},[],"Cambio",{"_3023":63192,"_26291":63170,"_18309":108163,"_5":12556,"_24913":108089,"_2529":108164},[],"Quién se ve afectado",{"_3023":63193,"_26291":63170,"_18309":108166,"_5":12556,"_24913":108089,"_2529":108167},[],"Gravedad",{"_3023":63194,"_26291":63170,"_18309":108169,"_5":12556,"_24913":108089,"_2529":108170},[],"Acción",{"_3023":63195,"_26291":63170,"_18309":108172,"_5":12556,"_24913":108089,"_2529":108098},[],{"_3023":63196,"_26291":63170,"_18309":108174,"_5":12556,"_24913":108089,"_2529":108175},[],"DMS con webhook cuyo certificado o clave de mTLS eran rutas de archivo",{"_3023":63197,"_26291":63170,"_18309":108177,"_5":12556,"_24913":108089,"_2529":108178},[],"Alta: los enrolamientos y reenrolamientos que llaman al webhook fallan",{"_3023":63198,"_26291":63170,"_18309":108180,"_5":12556,"_24913":108089,"_2529":108181},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3023":63199,"_26291":63170,"_18309":108183,"_5":12556,"_24913":108089,"_2529":108102},[],{"_3023":63200,"_26291":63170,"_18309":108185,"_5":12556,"_24913":108089,"_2529":108186},[],"DMS con webhook que tenían `validate_server_cert: false`",{"_3023":63201,"_26291":63170,"_18309":108188,"_5":12556,"_24913":108089,"_2529":108189},[],"Media: las credenciales del webhook viajan sin verificar al receptor",{"_3023":63202,"_26291":63170,"_18309":108191,"_5":12556,"_24913":108089,"_2529":108192},[],"Poner `insecure_skip_verify` a `false`",{"_3023":63203,"_26291":63170,"_18309":108194,"_5":12556,"_24913":108089,"_2529":108106},[],{"_3023":63204,"_26291":63170,"_18309":108196,"_5":12556,"_24913":108089,"_2529":108197},[],"Scripts y consolas que editan DMS por API",{"_3023":63205,"_26291":63170,"_18309":108199,"_5":12556,"_24913":108089,"_2529":108200},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3023":63206,"_26291":63170,"_18309":108202,"_5":12556,"_24913":108089,"_2529":108203},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3023":63207,"_26291":63170,"_18309":108205,"_5":12556,"_24913":108089,"_2529":108110},[],{"_3023":63208,"_26291":63170,"_18309":108207,"_5":12556,"_24913":108089,"_2529":108208},[],"Cualquier DMS",{"_3023":63209,"_26291":63170,"_18309":108210,"_5":12556,"_24913":108089,"_2529":108211},[],"Baja: solo informativo",{"_3023":63210,"_26291":63170,"_18309":108213,"_5":12556,"_24913":108089,"_2529":108214},[],"Revisar ambos bloques antes de editar",{"_3023":63211,"_26291":63170,"_18309":108216,"_5":12556,"_24913":108089,"_2529":108114},[],{"_3023":63212,"_26291":63170,"_18309":108218,"_5":12556,"_24913":108089,"_2529":108219},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3023":63213,"_26291":63170,"_18309":108221,"_5":12556,"_24913":108089,"_2529":108222},[],"Baja: la actualización afecta al ID de la URL",{"_3023":63214,"_26291":63170,"_18309":108224,"_5":12556,"_24913":108089,"_2529":108225},[],"Enviar las actualizaciones con el ID en la URL",{"_3023":63215,"_26291":63170,"_18309":108227,"_5":12556,"_24913":108089,"_2529":108118},[],{"_3023":63216,"_26291":63170,"_18309":108229,"_5":12556,"_24913":108089,"_2529":108230},[],"Despliegues en 3.8.0 con bases de datos por servicio",{"_3023":63217,"_26291":63170,"_18309":108232,"_5":12556,"_24913":108089,"_2529":108233},[],"Alta: los servicios no encuentran datos tras la actualización",{"_3023":63218,"_26291":63170,"_18309":108235,"_5":12556,"_24913":108089,"_2529":108236},[],"Mover datos e historial de migraciones a los esquemas de `pki`",{"_3023":63219,"_26291":63170,"_18309":108238,"_5":12556,"_24913":108089,"_2529":108126},[],{"_3023":63220,"_26291":63170,"_18309":108240,"_5":12556,"_24913":108089,"_2529":108241},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3023":63221,"_26291":63170,"_18309":108243,"_5":12556,"_24913":108089,"_2529":108244},[],"Media: las claves de CA quedan sin gestionar",{"_3023":63222,"_26291":63170,"_18309":108246,"_5":12556,"_24913":108089,"_2529":108247},[],"Ejecutar `ca-to-kms-migration`, primero con `--dry-run`",{"_3023":63223,"_26291":63170,"_18309":108249,"_5":12556,"_24913":108089,"_2529":108130},[],{"_3023":63224,"_26291":63170,"_18309":108251,"_5":12556,"_24913":108089,"_2529":108252},[],"Consumidores que leen el campo `events` del dispositivo",{"_3023":63225,"_26291":63170,"_18309":108254,"_5":12556,"_24913":108089,"_2529":108255},[],"Media: el campo desaparece de la representación del dispositivo",{"_3023":63226,"_26291":63170,"_18309":108257,"_5":12556,"_24913":108089,"_2529":108258},[],"Usar los nuevos endpoints de eventos",{"_3023":63227,"_26291":63170,"_18309":108260,"_5":12556,"_24913":108089,"_2529":108134},[],{"_3023":63228,"_26291":63170,"_18309":108262,"_5":12556,"_24913":108089,"_2529":108263},[],"Despliegues con almacenamiento SQLite",{"_3023":63229,"_26291":63170,"_18309":108265,"_5":12556,"_24913":108089,"_2529":108266},[],"Alta: el backend ya no lo admite",{"_3023":63230,"_26291":63170,"_18309":108268,"_5":12556,"_24913":108089,"_2529":108269},[],"Migrar a PostgreSQL antes de actualizar",{"_3023":63231,"_26291":63170,"_18309":108271,"_5":12556,"_24913":108089,"_2529":108138},[],{"_3023":63232,"_26291":63170,"_18309":108273,"_5":12556,"_24913":108089,"_2529":108274},[],"Todos los despliegues",{"_3023":63233,"_26291":63170,"_18309":108276,"_5":12556,"_24913":108089,"_2529":108277},[],"Alta: sin bootstrap no hay administrador",{"_3023":63234,"_26291":63170,"_18309":108279,"_5":12556,"_24913":108089,"_2529":108280},[],"Configurar `authz` según la guía de control de acceso",{"_3023":63235,"_26291":63170,"_18309":108282,"_5":12556,"_24913":108089,"_2529":108283},[],"AMQP sobre TLS",{"_3023":63236,"_26291":63170,"_18309":108285,"_5":12556,"_24913":108089,"_2529":108286},[],"Despliegues con TLS en el broker de mensajería",{"_3023":63237,"_26291":63170,"_18309":108288,"_5":12556,"_24913":108089,"_2529":108289},[],"Media: los clientes en texto plano son rechazados",{"_3023":63238,"_26291":63170,"_18309":108291,"_5":12556,"_24913":108089,"_2529":108292},[],"Apuntar los clientes al puerto TLS y confiar en el certificado del broker",{"_3023":63239,"_26291":63170,"_18309":108294,"_5":12556,"_24913":108089,"_2529":108145},[],{"_3023":63240,"_26291":63170,"_18309":108296,"_5":12556,"_24913":108089,"_2529":108297},[],"Motores de KMS en sistema de archivos y CRLs locales",{"_3023":63241,"_26291":63170,"_18309":108299,"_5":12556,"_24913":108089,"_2529":108300},[],"Media: los datos pueden quedar atrás",{"_3023":63242,"_26291":63170,"_18309":108302,"_5":12556,"_24913":108089,"_2529":108303},[],"Preservar volúmenes, trasladar los datos y revisar permisos",{"_3023":63243,"_26291":63170,"_18309":108305,"_5":12556,"_24913":108089,"_2529":108306},[],"Al final se incluye una lista de verificación para confirmar el resultado.",{"_3023":63244,"_26291":63170,"_18309":108308,"_5":12556,"_24913":108093,"_2529":108309},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual. Los campos se renombran de la siguiente manera:",{"_3023":63245,"_26291":63170,"_18309":108311,"_5":12556,"_24913":108093,"_2529":108312},[],"Campo en 3.8.0",{"_3023":63246,"_26291":63170,"_18309":108314,"_5":12556,"_24913":108093,"_2529":108315},[],"Campo en 4.0.0",{"_3023":63247,"_26291":63170,"_18309":108317,"_5":12556,"_24913":108093,"_2529":50542},[],{"_3023":63248,"_26291":63170,"_18309":108319,"_5":12556,"_24913":108093,"_2529":108320},[],"`insecure_skip_verify` (con el valor negado)",{"_3023":63249,"_26291":63170,"_18309":108322,"_5":12556,"_24913":108093,"_2529":50548},[],{"_3023":63250,"_26291":63170,"_18309":108324,"_5":12556,"_24913":108093,"_2529":50551},[],{"_3023":63251,"_26291":63170,"_18309":108326,"_5":12556,"_24913":108093,"_2529":50554},[],{"_3023":63252,"_26291":63170,"_18309":108328,"_5":12556,"_24913":108093,"_2529":50557},[],{"_3023":63253,"_26291":63170,"_18309":108330,"_5":12556,"_24913":108093,"_2529":50560},[],{"_3023":63254,"_26291":63170,"_18309":108332,"_5":12556,"_24913":108093,"_2529":50563},[],{"_3023":63255,"_26291":63170,"_18309":108334,"_5":12556,"_24913":108093,"_2529":108335},[],"Cuando el certificado y la clave heredados de mTLS son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren ninguna acción. Los dos casos siguientes son los que sí la requieren.",{"_3023":63256,"_26291":63170,"_18309":108337,"_5":12556,"_24913":108097,"_2529":108338},[],"Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos, y lo hace en cada llamada, sea cual sea el modo de autenticación configurado. El efecto es que todos los enrolamientos y reenrolamientos que invocan ese webhook fallan hasta corregir la configuración.",{"_3023":63257,"_26291":63170,"_18309":108340,"_5":12556,"_24913":108097,"_2529":108341},[],"Para corregirlo hay dos opciones, según el webhook:",{"_3023":63258,"_26291":63170,"_18309":108343,"_5":12556,"_24913":108097,"_2529":108344},[],"Si el webhook usa mTLS, volver a introducir el certificado y la clave como PEM, en Base64 o en texto plano.",{"_3023":63259,"_26291":63170,"_18309":108346,"_5":12556,"_24913":108097,"_2529":108347},[],"Si el webhook no usa mTLS, eliminar los campos de archivo sobrantes.",{"_3023":63260,"_26291":63170,"_18309":108349,"_5":12556,"_24913":108097,"_2529":108350},[],"Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`).",{"_3023":63261,"_26291":63170,"_18309":108352,"_5":12556,"_24913":108097,"_2529":108353},[],"Existe una variante del mismo problema: si la configuración almacenada guarda rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content`, toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`) falla la validación. Los ajustes se sustituyen al completo, de modo que la configuración almacenada debe reenviarse con el certificado y la clave como PEM.",{"_3023":63262,"_26291":63170,"_18309":108355,"_5":12556,"_24913":108101,"_2529":108356},[],"Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`. Por tanto, la verificación del certificado del receptor sigue sin realizarse hasta que se ponga ese campo a `false`.",{"_3023":63263,"_26291":63170,"_18309":108358,"_5":12556,"_24913":108101,"_2529":108359},[],"Conviene corregirlo en cada configuración migrada. El canal de autorización del webhook transporta la API key o el bearer token, de modo que saltarse la verificación expone esas credenciales a un atacante con posición de red. Solo se justifica mantener `insecure_skip_verify: true` si el certificado del receptor no es verificable de forma deliberada.",{"_3023":63264,"_26291":63170,"_18309":108361,"_5":12556,"_24913":108105,"_2529":108362},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`.",{"_3023":63265,"_26291":63170,"_18309":108364,"_5":12556,"_24913":108105,"_2529":108365},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3023":63266,"_26291":63170,"_18309":108367,"_5":12556,"_24913":108105,"_2529":108368},[],"Lo que sí cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se ignora en silencio porque los campos JSON desconocidos se descartan, y las respuestas GET ya no lo incluyen. En consecuencia, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin devolver ningún error. Para evitarlo, leer siempre el DMS antes de enviar una edición y reutilizar el formato que devuelve la API.",{"_3023":63267,"_26291":63170,"_18309":108370,"_5":12556,"_24913":108109,"_2529":108371},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero antes de editar un DMS conviene leer ambos bloques para no modificar uno creyendo que se está editando el otro.",{"_3023":63268,"_26291":63170,"_18309":108373,"_5":12556,"_24913":108109,"_2529":108374},[],"Si la versión de la consola no expone los ajustes independientes, pueden editarse mediante la API DMS.",{"_3023":63269,"_26291":63170,"_18309":108376,"_5":12556,"_24913":108113,"_2529":108377},[],"`PUT /v1/dms/:id` toma ahora el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora. Actualizar los clientes que dependían del ID del cuerpo.",{"_3023":63270,"_26291":63170,"_18309":108379,"_5":12556,"_24913":108117,"_2529":108380},[],"El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El `authz` autónomo puede usar una base de datos `authz` separada; el monolítico de desarrollo almacena sus datos en el esquema `authz` de `pki`. WFX conserva su propia base `wfx`.",{"_3023":63271,"_26291":63170,"_18309":108382,"_5":12556,"_24913":108117,"_2529":108383},[],"Las instalaciones en 3.8.0 con bases de datos separadas por servicio deben mover sus datos y su historial de migraciones al esquema de `pki` correspondiente, preservando estructura, índices, restricciones y datos.",{"_3023":63272,"_26291":63170,"_18309":108385,"_5":12556,"_24913":108117,"_2529":108386},[],"Las herramientas de migración aplican migraciones sobre un esquema existente; ningún comando mueve datos entre bases. El procedimiento de transferencia de esta página es provisional: verifícalo con los artefactos definitivos de la versión antes de actualizar producción.",{"_3023":63273,"_26291":63170,"_18309":108388,"_5":12556,"_24913":108117,"_2529":108389},[],"Planifica la transferencia como cualquier migración de datos: toma antes una copia de seguridad verificable de PostgreSQL, programa la parada de servicio e impide las escrituras mientras se copian los datos.",{"_3023":63274,"_26291":63170,"_18309":108391,"_5":12556,"_24913":108121,"_2529":108392},[],"Para la migración manual, `goose-lamassu` exige `search_path=<esquema>` en la cadena de conexión y debe ejecutarse contra la base `pki`. El binario no valida el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutar el comando:",{"_3023":63275,"_26291":63170,"_18309":108394,"_5":12556,"_24913":108121,"_2529":108395},[],"Usa las opciones de conexión y TLS adecuadas para tu entorno y repítelo por esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`.",{"_3023":63276,"_26291":63170,"_18309":108397,"_5":12556,"_24913":108121,"_2529":108398},[],"La documentación de `goose-lamassu` aún muestra ejemplos por base de datos (`dbname=ca`, `dbname=kms`) y afirma que la herramienta valida el nombre de la base de datos. No lo hace: solo valida `search_path`. Sigue la forma con `dbname=pki` de arriba.",{"_3023":63277,"_26291":63170,"_18309":108400,"_5":12556,"_24913":108125,"_2529":108401},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3023":63278,"_26291":63170,"_18309":108403,"_5":12556,"_24913":108125,"_2529":108404},[],"`key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_3023":63279,"_26291":63170,"_18309":108406,"_5":12556,"_24913":108125,"_2529":108407},[],"La herramienta es idempotente: las claves ya presentes en el KMS se omiten, de modo que puede ejecutarse varias veces con seguridad.",{"_3023":63280,"_26291":63170,"_18309":108409,"_5":12556,"_24913":108125,"_2529":108410},[],"Los certificados que no puedan leerse, o que carezcan de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los registros y resuelve los casos afectados.",{"_3023":63281,"_26291":63170,"_18309":108412,"_5":12556,"_24913":108125,"_2529":108413},[],"Ejecútala primero con `--dry-run` para analizar e informar sin escribir en el almacenamiento del KMS, y después ejecuta la migración real:",{"_3023":63282,"_26291":63170,"_18309":108415,"_5":12556,"_24913":108125,"_2529":108416},[],"Apunta la configuración `storage` de la herramienta a la base `pki`: en 4.0.0 los datos de CA y del KMS viven en los esquemas `ca` y `kms` de la misma base de datos. El README de la herramienta sigue describiendo el modelo de dos bases anterior a 4.0.0, así que no copies sus ejemplos. En Kubernetes, la forma recomendada es ejecutar la migración como un Job de hook `pre-upgrade` de Helm; consulta el README de la herramienta (`backend/cmd/ca-to-kms-migration/README.md` en el repositorio).",{"_3023":63283,"_26291":63170,"_18309":108418,"_5":12556,"_24913":108129,"_2529":108419},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado en `device_events`. La actualización transforma los datos existentes.",{"_3023":63284,"_26291":63170,"_18309":108421,"_5":12556,"_24913":108129,"_2529":108422},[],"El campo `events` ya no aparece en la representación del dispositivo. Adapta los consumidores que lo leen y usa los nuevos endpoints:",{"_3023":63285,"_26291":63170,"_18309":108424,"_5":12556,"_24913":108129,"_2529":108425},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3023":63286,"_26291":63170,"_18309":108427,"_5":12556,"_24913":108129,"_2529":108428},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3023":63287,"_26291":63170,"_18309":108430,"_5":12556,"_24913":108129,"_2529":108431},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite los eventos vía Server-Sent Events, con un keepalive cada 15 segundos. SSE responde `501` cuando está deshabilitado en el despliegue.",{"_3023":63288,"_26291":63170,"_18309":108433,"_5":12556,"_24913":108129,"_2529":108434},[],"SSE necesita difundir entre las instancias del servicio, así que cada instancia enlaza su propia cola AMQP duradera (llamada `device-manager-sse-<uuid>`). Las colas de instancias caídas o reemplazadas permanecen hasta que se limpien fuera de banda: configura en el broker una política de expiración o limpieza para no acumular colas.",{"_3023":63289,"_26291":63170,"_18309":108436,"_5":12556,"_24913":108133,"_2529":108437},[],"El motor de almacenamiento SQLite se elimina. Los proveedores admitidos son `postgres`, `couch_db` y `dynamo_db`. Los despliegues que usaban SQLite deben pasar primero a PostgreSQL y consolidar sus datos en los esquemas de `pki` como se describe en Consolidación en PostgreSQL.",{"_3023":63290,"_26291":63170,"_18309":108439,"_5":12556,"_24913":108137,"_2529":108440},[],"4.0.0 incorpora el servicio `authz`, que valida los tokens contra el endpoint JWKS del proveedor OIDC y aplica autorización de grano fino a las peticiones de los servicios. La validación ya no usa la política JWT anterior del gateway.",{"_3023":63291,"_26291":63170,"_18309":108442,"_5":12556,"_24913":108137,"_2529":108443},[],"Configura el endpoint JWKS, las credenciales para acceder a los datos de PKI y de authz, las políticas y un principal inicial de bootstrap. Sin un principal coincidente no existe administrador inicial implícito, de modo que nadie puede administrar la PKI.",{"_3023":63292,"_26291":63170,"_18309":108445,"_5":12556,"_24913":108137,"_2529":108446},[],"La página de control de acceso documenta los principales, las políticas y el primer administrador. La página de instalación con Helm documenta `services.authz.bootstrap` y cómo lo aplica el job de preinstalación.",{"_3023":63293,"_26291":63170,"_18309":108448,"_5":12556,"_24913":108141,"_2529":108449},[],"Si TLS está habilitado para AMQP, los clientes se conectan al puerto TLS del broker — `amqps`, habitualmente `5671` — y deben confiar en su certificado. Verifica la configuración efectiva antes de actualizar, especialmente si antes se usaba AMQP en texto plano. El puerto es configurable por el operador; comprueba el de tu despliegue.",{"_3023":63294,"_26291":63170,"_18309":108451,"_5":12556,"_24913":108144,"_2529":108452},[],"Si el KMS usa un motor de sistema de archivos o la VA guarda CRLs localmente, preserva esos datos durante la actualización y, cuando sea necesario, trasládalos. Asegúrate de que la identidad con la que corren los servicios puede acceder a las claves, las CRLs y los dispositivos criptográficos, y verifica su funcionamiento antes de retirar los datos originales.",{"_3023":63295,"_26291":63170,"_18309":108454,"_5":12556,"_24913":108144,"_2529":108455},[],"Las imágenes de servicio se basan en distroless sin root, con el UID numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root (el mismo UID numérico). Si montas volúmenes con claves o CRLs, asegúrate de que la propiedad y los permisos permiten a esa identidad leerlos y, cuando corresponda, escribirlos.",{"_3023":63296,"_26291":63170,"_18309":108457,"_5":12556,"_24913":108148,"_2529":108458},[],"Tras aplicar la actualización, comprobar en este orden:",{"_3023":63297,"_26291":63170,"_18309":108460,"_5":12556,"_24913":108148,"_2529":108461},[],"**Bases de datos.** Confirmar que cada servicio lee la base `pki` con su propio esquema (`kms`, `ca`, `va`, `devicemanager`, `dmsmanager`, `alerts`), que los datos de `authz` y `wfx` son accesibles y que el estado de las migraciones está registrado por esquema. Si el despliegue usaba SQLite, confirmar que el nuevo almacenamiento en PostgreSQL funciona de extremo a extremo.",{"_3023":63298,"_26291":63170,"_18309":108463,"_5":12556,"_24913":108148,"_2529":108464},[],"**Claves de CA heredadas.** Ejecutar `ca-to-kms-migration` con `--dry-run`, revisar el informe y los avisos, ejecutarla sin la opción y confirmar que las claves esperadas aparecen en el KMS.",{"_3023":63299,"_26291":63170,"_18309":108466,"_5":12556,"_24913":108148,"_2529":108467},[],"**Eventos de dispositivo.** Consultar `GET /v1/devices/:id/events` en dispositivos con eventos históricos, confirmar que los datos se migraron y apuntar los consumidores a los nuevos endpoints.",{"_3023":63300,"_26291":63170,"_18309":108469,"_5":12556,"_24913":108148,"_2529":108470},[],"**Autorización.** Autenticarse con el principal de bootstrap y confirmar que la administración funciona; comprobar que una identidad sin permiso recibe `403`; revisar los permisos de clientes e integraciones.",{"_3023":63301,"_26291":63170,"_18309":108472,"_5":12556,"_24913":108148,"_2529":108473},[],"**AMQP.** Confirmar que el backend se conecta al broker con la configuración TLS esperada y que la política de limpieza de las colas de SSE está en marcha.",{"_3023":63302,"_26291":63170,"_18309":108475,"_5":12556,"_24913":108148,"_2529":108476},[],"**Almacenamiento local.** Confirmar que los servicios pueden leer las claves del KMS y las CRLs de sus volúmenes, y que la emisión y la recuperación de CRLs funcionan.",{"_3023":63303,"_26291":63170,"_18309":108478,"_5":12556,"_24913":108148,"_2529":108479},[],"**Webhooks sin campos de archivo.** Listar los DMS que usan webhook en enrolamiento o reenrolamiento y confirmar que cada bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3023":63304,"_26291":63170,"_18309":108481,"_5":12556,"_24913":108148,"_2529":108482},[],"**Verificación del receptor.** Confirmar que `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3023":63305,"_26291":63170,"_18309":108484,"_5":12556,"_24913":108148,"_2529":108485},[],"**Entrega.** Lanzar, o esperar a que ocurra, un enrolamiento o reenrolamiento a través de cada webhook migrado y confirmar que la llamada de autorización se completa.",{"_3023":63306,"_26291":63170,"_18309":108487,"_5":12556,"_24913":108148,"_2529":108488},[],"**Conjunto de confianza.** Leer `est_rfc7030_settings.client_certificate_settings.validation_cas` y confirmar que contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3023":63307,"_26291":63170,"_18309":108490,"_5":12556,"_24913":108148,"_2529":108491},[],"**Clientes de la API.** Actualizar los scripts y consolas que usen el formato antiguo del DMS (`additional_validation_cas` plano, o los campos `mtls`, `apikey` y `oidc` heredados), ya que descartan esos valores sin avisar, y confirmar que las actualizaciones del DMS envían el ID en la URL.",{"_3023":63308,"_26291":63170,"_18309":108493,"_5":12556,"_24913":108148,"_2529":105010},[],{"_3023":63309,"_26291":63170,"_18309":108495,"_5":12556,"_24913":108148,"_2529":108496},[],"<Card title=\"API DMS\" href=\"/docs/api-reference/dms-manager\" />",{"_3023":63310,"_26291":63170,"_18309":108498,"_5":12556,"_24913":108148,"_2529":108499},[],"<Card title=\"Control de acceso\" href=\"/docs/platform/administration/access-control\" />",{"_50734":108501,"_50736":108502,"_50738":108503,"_50740":108504,"_15900":2551,"_60795":2551},"spanish",[2529,26291,5,24913],{"_2529":21905,"_26291":21905,"_5":21905,"_24913":21905},{"_2529":108505,"_26291":111017,"_5":113529,"_24913":116041},{"_4036":108506,"_50744":108507,"_5":21905},{"_12611":2803,"_12964":12573,"_12971":3528,"_11328":5219,"_25037":15118,"_17374":10214,"_12632":12308,"_12639":2916,"_25440":5228,"_25811":2993,"_25832":5212,"_25458":2630,"_30248":11565,"_25843":6534,"_25871":5978,"_30255":13000,"_