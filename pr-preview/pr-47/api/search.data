:108800,"_35261":108802,"_35263":108805,"_35265":108808,"_35267":108811,"_35269":108813,"_35271":108816,"_35273":108819,"_35275":108822,"_35277":108824,"_35279":108827,"_35281":108830,"_35283":108833,"_35285":108835,"_35287":108838,"_35289":108841,"_35291":108844,"_35293":108846,"_35295":108849,"_35297":108852,"_35299":108855,"_35301":108858,"_35303":108861,"_35305":108864,"_35307":108867,"_35309":108869,"_35311":108872,"_35313":108875,"_35315":108878,"_35317":108880,"_35319":108883,"_35321":108886,"_35323":108889,"_35325":108892,"_35327":108895,"_35329":108898,"_35331":108901,"_35333":108903,"_35335":108906,"_35337":108908,"_35339":108910,"_35341":108912,"_35343":108914,"_35345":108916,"_35347":108918,"_35349":108921,"_35351":108924,"_35353":108927,"_35355":108930,"_35357":108933,"_35359":108936,"_35361":108939,"_35363":108942,"_35365":108945,"_35367":108948,"_35369":108951,"_35371":108954,"_35374":108957,"_35376":108960,"_35378":108963,"_35380":108966,"_35382":108969,"_35384":108972,"_35386":108975,"_35388":108978,"_35390":108981,"_35392":108984,"_35394":108987,"_35396":108990,"_35398":108993,"_35400":108996,"_35402":108999,"_35404":109002,"_35406":109005,"_35408":109008,"_35410":109011,"_35412":109014,"_35414":109017,"_35416":109020,"_35418":109023,"_35420":109026,"_35422":109029,"_35424":109032,"_35426":109035,"_35428":109038,"_35430":109041,"_35432":109044,"_35434":109047,"_35436":109050,"_35438":109053,"_35440":109056,"_35442":109059,"_35444":109062,"_35446":109065,"_35448":109068,"_35450":109071,"_35452":109074,"_35454":109077,"_35456":109080,"_35458":109083,"_35460":109086,"_35462":109089,"_35464":109092,"_35466":109094,"_35468":109097},{"_3034":61134,"_26479":61134,"_5":12947,"_2540":101370,"_26823":101371,"_18432":101374,"_25092":61134},"Despliega desde AWS Marketplace",[43109,101372,101373],"Despliegue","Otros modelos",[],{"_3034":61135,"_26479":61134,"_18432":101376,"_5":12632,"_25092":61134,"_2540":101377},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3034":61136,"_26479":61134,"_5":26820,"_18432":101379,"_25092":101380,"_2540":101381},[],"/docs/pr-preview/pr-47/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3034":61137,"_26479":61134,"_5":26820,"_18432":101383,"_25092":101384,"_2540":101385},[],"/docs/pr-preview/pr-47/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3034":61138,"_26479":61134,"_5":26820,"_18432":101387,"_25092":101388,"_2540":101389},[],"/docs/pr-preview/pr-47/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3034":61139,"_26479":61134,"_5":26820,"_18432":101391,"_25092":101392,"_2540":101393},[],"/docs/pr-preview/pr-47/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3034":61140,"_26479":61134,"_5":26820,"_18432":101395,"_25092":101396,"_2540":101397},[],"/docs/pr-preview/pr-47/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3034":61141,"_26479":61134,"_5":26820,"_18432":101399,"_25092":101400,"_2540":101401},[],"/docs/pr-preview/pr-47/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3034":61142,"_26479":61134,"_5":26820,"_18432":101403,"_25092":101404,"_2540":101405},[],"/docs/pr-preview/pr-47/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3034":61143,"_26479":61134,"_18432":101407,"_5":12632,"_25092":61134,"_2540":101408},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3034":61144,"_26479":61134,"_18432":101410,"_5":12632,"_25092":101380,"_2540":101411},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3034":61145,"_26479":61134,"_18432":101413,"_5":12632,"_25092":101380,"_2540":101414},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3034":61146,"_26479":61134,"_18432":101416,"_5":12632,"_25092":101380,"_2540":101417},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3034":61147,"_26479":61134,"_18432":101419,"_5":12632,"_25092":101384,"_2540":101420},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3034":61148,"_26479":61134,"_18432":101422,"_5":12632,"_25092":101384,"_2540":101423},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3034":61149,"_26479":61134,"_18432":101425,"_5":12632,"_25092":101384,"_2540":101426},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3034":61150,"_26479":61134,"_18432":101428,"_5":12632,"_25092":101388,"_2540":101429},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3034":61151,"_26479":61134,"_18432":101431,"_5":12632,"_25092":101392,"_2540":101432},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3034":61152,"_26479":61134,"_18432":101434,"_5":12632,"_25092":101396,"_2540":101435},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3034":61153,"_26479":61134,"_18432":101437,"_5":12632,"_25092":101400,"_2540":101438},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3034":61154,"_26479":61134,"_18432":101440,"_5":12632,"_25092":101404,"_2540":101441},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3034":61155,"_26479":61155,"_5":12947,"_2540":101443,"_26823":101444,"_18432":101445,"_25092":61155},"Despliega Lamassu",[43109,101372],[],{"_3034":61156,"_26479":61155,"_18432":101447,"_5":12632,"_25092":61155,"_2540":101448},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3034":61157,"_26479":61155,"_5":26820,"_18432":101450,"_25092":101451,"_2540":101452},[],"/docs/pr-preview/pr-47/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3034":61158,"_26479":61155,"_5":26820,"_18432":101454,"_25092":101455,"_2540":101456},[],"/docs/pr-preview/pr-47/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3034":61159,"_26479":61155,"_5":26820,"_18432":101458,"_25092":101459,"_2540":101460},[],"/docs/pr-preview/pr-47/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3034":61160,"_26479":61155,"_18432":101462,"_5":12632,"_25092":61155,"_2540":101463},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3034":61161,"_26479":61155,"_18432":101465,"_5":12632,"_25092":101451,"_2540":101466},[],"Modelo",{"_3034":61162,"_26479":61155,"_18432":101468,"_5":12632,"_25092":101451,"_2540":101469},[],"Recomendado para",{"_3034":61163,"_26479":61155,"_18432":101471,"_5":12632,"_25092":101451,"_2540":101472},[],"Quién opera la infraestructura",{"_3034":61164,"_26479":61155,"_18432":101474,"_5":12632,"_25092":101451,"_2540":101475},[],"Punto de partida",{"_3034":61165,"_26479":61155,"_18432":101477,"_5":12632,"_25092":101451,"_2540":43216},[],{"_3034":61166,"_26479":61155,"_18432":101479,"_5":12632,"_25092":101451,"_2540":101480},[],"Producción, entornos regulados y despliegues personalizados",{"_3034":61167,"_26479":61155,"_18432":101482,"_5":12632,"_25092":101451,"_2540":101483},[],"Tu equipo",{"_3034":61168,"_26479":61155,"_18432":101485,"_5":12632,"_25092":101451,"_2540":101486},[],"Helm o Fastlane",{"_3034":61169,"_26479":61155,"_18432":101488,"_5":12632,"_25092":101451,"_2540":43228},[],{"_3034":61170,"_26479":61155,"_18432":101490,"_5":12632,"_25092":101451,"_2540":101491},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3034":61171,"_26479":61155,"_18432":101493,"_5":12632,"_25092":101451,"_2540":101483},[],{"_3034":61172,"_26479":61155,"_18432":101495,"_5":12632,"_25092":101451,"_2540":101496},[],"Imagen preconfigurada en EC2",{"_3034":61173,"_26479":61155,"_18432":101498,"_5":12632,"_25092":101451,"_2540":43239},[],{"_3034":61174,"_26479":61155,"_18432":101500,"_5":12632,"_25092":101451,"_2540":101501},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3034":61175,"_26479":61155,"_18432":101503,"_5":12632,"_25092":101451,"_2540":43245},[],{"_3034":61176,"_26479":61155,"_18432":101505,"_5":12632,"_25092":101451,"_2540":101506},[],"Suscripción gestionada",{"_3034":61177,"_26479":61155,"_18432":101508,"_5":12632,"_25092":101451,"_2540":101509},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3034":61178,"_26479":61155,"_18432":101511,"_5":12632,"_25092":101451,"_2540":101512},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3034":61179,"_26479":61155,"_18432":101514,"_5":12632,"_25092":101451,"_2540":101515},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3034":61180,"_26479":61155,"_18432":101517,"_5":12632,"_25092":101455,"_2540":101518},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3034":61181,"_26479":61155,"_18432":101520,"_5":12632,"_25092":101459,"_2540":101521},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3034":61182,"_26479":61182,"_5":12947,"_2540":101523,"_26823":101524,"_18432":101525,"_25092":61182},"Utiliza Lamassu como SaaS",[43109,101372,101373],[],{"_3034":61183,"_26479":61182,"_18432":101527,"_5":12632,"_25092":61182,"_2540":101528},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3034":61184,"_26479":61182,"_5":26820,"_18432":101530,"_25092":101531,"_2540":101532},[],"/docs/pr-preview/pr-47/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3034":61185,"_26479":61182,"_5":26820,"_18432":101534,"_25092":101535,"_2540":101536},[],"/docs/pr-preview/pr-47/es/deployment/saas#planes","Planes",{"_3034":61186,"_26479":61182,"_5":26820,"_18432":101538,"_25092":101539,"_2540":101540},[],"/docs/pr-preview/pr-47/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3034":61187,"_26479":61182,"_18432":101542,"_5":12632,"_25092":61182,"_2540":101543},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3034":61188,"_26479":61182,"_18432":101545,"_5":12632,"_25092":101531,"_2540":101546},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3034":61189,"_26479":61182,"_18432":101548,"_5":12632,"_25092":101531,"_2540":101549},[],"Copias de seguridad automáticas.",{"_3034":61190,"_26479":61182,"_18432":101551,"_5":12632,"_25092":101531,"_2540":101552},[],"Actualizaciones de versión.",{"_3034":61191,"_26479":61182,"_18432":101554,"_5":12632,"_25092":101531,"_2540":101555},[],"Soporte técnico y SLA según el plan contratado.",{"_3034":61192,"_26479":61182,"_18432":101557,"_5":12632,"_25092":101535,"_2540":43300},[],{"_3034":61193,"_26479":61182,"_18432":101559,"_5":12632,"_25092":101535,"_2540":101560},[],"Dispositivos",{"_3034":61194,"_26479":61182,"_18432":101562,"_5":12632,"_25092":101535,"_2540":101563},[],"Soporte",{"_3034":61195,"_26479":61182,"_18432":101565,"_5":12632,"_25092":101535,"_2540":43309},[],{"_3034":61196,"_26479":61182,"_18432":101567,"_5":12632,"_25092":101535,"_2540":43312},[],{"_3034":61197,"_26479":61182,"_18432":101569,"_5":12632,"_25092":101535,"_2540":101570},[],"Hasta 1.000",{"_3034":61198,"_26479":61182,"_18432":101572,"_5":12632,"_25092":101535,"_2540":43318},[],{"_3034":61199,"_26479":61182,"_18432":101574,"_5":12632,"_25092":101535,"_2540":101575},[],"99,5 %",{"_3034":61200,"_26479":61182,"_18432":101577,"_5":12632,"_25092":101535,"_2540":43324},[],{"_3034":61201,"_26479":61182,"_18432":101579,"_5":12632,"_25092":101535,"_2540":101580},[],"Hasta 10.000",{"_3034":61202,"_26479":61182,"_18432":101582,"_5":12632,"_25092":101535,"_2540":101583},[],"Email y chat",{"_3034":61203,"_26479":61182,"_18432":101585,"_5":12632,"_25092":101535,"_2540":101586},[],"99,9 %",{"_3034":61204,"_26479":61182,"_18432":101588,"_5":12632,"_25092":101535,"_2540":43336},[],{"_3034":61205,"_26479":61182,"_18432":101590,"_5":12632,"_25092":101535,"_2540":101591},[],"Ilimitados",{"_3034":61206,"_26479":61182,"_18432":101593,"_5":12632,"_25092":101535,"_2540":101594},[],"Dedicado",{"_3034":61207,"_26479":61182,"_18432":101596,"_5":12632,"_25092":101535,"_2540":101597},[],"99,99 %",{"_3034":61208,"_26479":61182,"_18432":101599,"_5":12632,"_25092":101539,"_2540":101600},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3034":61209,"_26479":61182,"_18432":101602,"_5":12632,"_25092":101539,"_2540":101603},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3034":61210,"_26479":61210,"_5":12947,"_2540":43353,"_26823":101605,"_18432":101607,"_25092":61210},[43109,101372,101606],"Kubernetes autogestionado",[],{"_3034":61211,"_26479":61210,"_18432":101609,"_5":12632,"_25092":61210,"_2540":101610},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3034":61212,"_26479":61210,"_5":26820,"_18432":101612,"_25092":101613,"_2540":101614},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3034":61213,"_26479":61210,"_5":26820,"_18432":101616,"_25092":101617,"_2540":101618},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3034":61214,"_26479":61210,"_5":26820,"_18432":101620,"_25092":101621,"_2540":101622},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3034":61215,"_26479":61210,"_5":26820,"_18432":101624,"_25092":101625,"_2540":101626},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3034":61216,"_26479":61210,"_5":26820,"_18432":101628,"_25092":101629,"_2540":101630},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3034":61217,"_26479":61210,"_5":26820,"_18432":101632,"_25092":101633,"_2540":101634},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3034":61218,"_26479":61210,"_5":26820,"_18432":101636,"_25092":101637,"_2540":101638},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3034":61219,"_26479":61210,"_5":26820,"_18432":101640,"_25092":101641,"_2540":101642},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3034":61220,"_26479":61210,"_5":26820,"_18432":101644,"_25092":101645,"_2540":101646},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3034":61221,"_26479":61210,"_5":26820,"_18432":101648,"_25092":101649,"_2540":101650},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3034":61222,"_26479":61210,"_18432":101652,"_5":12632,"_25092":101613,"_2540":101653},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3034":61223,"_26479":61210,"_18432":101655,"_5":12632,"_25092":101613,"_2540":101656},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3034":61224,"_26479":61210,"_18432":101658,"_5":12632,"_25092":101617,"_2540":101659},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3034":61225,"_26479":61210,"_18432":101661,"_5":12632,"_25092":101617,"_2540":101662},[],"Fastlane instala o configura",{"_3034":61226,"_26479":61210,"_18432":101664,"_5":12632,"_25092":101617,"_2540":101665},[],"Tú sigues proporcionando",{"_3034":61227,"_26479":61210,"_18432":101667,"_5":12632,"_25092":101617,"_2540":101668},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3034":61228,"_26479":61210,"_18432":101670,"_5":12632,"_25092":101617,"_2540":101671},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3034":61229,"_26479":61210,"_18432":101673,"_5":12632,"_25092":101617,"_2540":101674},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3034":61230,"_26479":61210,"_18432":101676,"_5":12632,"_25092":101617,"_2540":101677},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3034":61231,"_26479":61210,"_18432":101679,"_5":12632,"_25092":101617,"_2540":101680},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3034":61232,"_26479":61210,"_18432":101682,"_5":12632,"_25092":101617,"_2540":101683},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3034":61233,"_26479":61210,"_18432":101685,"_5":12632,"_25092":101617,"_2540":101686},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3034":61234,"_26479":61210,"_18432":101688,"_5":12632,"_25092":101617,"_2540":101689},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3034":61235,"_26479":61210,"_18432":101691,"_5":12632,"_25092":101617,"_2540":101692},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3034":61236,"_26479":61210,"_18432":101694,"_5":12632,"_25092":101621,"_2540":101695},[],"Necesitas:",{"_3034":61237,"_26479":61210,"_18432":101697,"_5":12632,"_25092":101621,"_2540":101698},[],"un clúster Kubernetes existente",{"_3034":61238,"_26479":61210,"_18432":101700,"_5":12632,"_25092":101621,"_2540":101701},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3034":61239,"_26479":61210,"_18432":101703,"_5":12632,"_25092":101621,"_2540":43451},[],{"_3034":61240,"_26479":61210,"_18432":101705,"_5":12632,"_25092":101621,"_2540":20912},[],{"_3034":61241,"_26479":61210,"_18432":101707,"_5":12632,"_25092":101621,"_2540":101708},[],"`jq` solo si usas `--sample-data`",{"_3034":61242,"_26479":61210,"_18432":101710,"_5":12632,"_25092":101621,"_2540":101711},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3034":61243,"_26479":61210,"_18432":101713,"_5":12632,"_25092":101621,"_2540":101714},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3034":61244,"_26479":61210,"_18432":101716,"_5":12632,"_25092":101621,"_2540":101717},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3034":61245,"_26479":61210,"_18432":101719,"_5":12632,"_25092":101625,"_2540":101720},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3034":61246,"_26479":61210,"_18432":101722,"_5":12632,"_25092":101625,"_2540":101723},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3034":61247,"_26479":61210,"_18432":101725,"_5":12632,"_25092":101629,"_2540":101726},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3034":61248,"_26479":61210,"_18432":101728,"_5":12632,"_25092":101629,"_2540":101729},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3034":61249,"_26479":61210,"_18432":101731,"_5":12632,"_25092":101629,"_2540":101732},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3034":61250,"_26479":61210,"_18432":101734,"_5":12632,"_25092":101629,"_2540":101735},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3034":61251,"_26479":61210,"_18432":101737,"_5":12632,"_25092":101633,"_2540":101738},[],"Opción",{"_3034":61252,"_26479":61210,"_18432":101740,"_5":12632,"_25092":101633,"_2540":101741},[],"Valor predeterminado",{"_3034":61253,"_26479":61210,"_18432":101743,"_5":12632,"_25092":101633,"_2540":101744},[],"Propósito",{"_3034":61254,"_26479":61210,"_18432":101746,"_5":12632,"_25092":101633,"_2540":43495},[],{"_3034":61255,"_26479":61210,"_18432":101748,"_5":12632,"_25092":101633,"_2540":43498},[],{"_3034":61256,"_26479":61210,"_18432":101750,"_5":12632,"_25092":101633,"_2540":101751},[],"Muestra la ayuda",{"_3034":61257,"_26479":61210,"_18432":101753,"_5":12632,"_25092":101633,"_2540":43504},[],{"_3034":61258,"_26479":61210,"_18432":101755,"_5":12632,"_25092":101633,"_2540":101756},[],"contexto actual",{"_3034":61259,"_26479":61210,"_18432":101758,"_5":12632,"_25092":101633,"_2540":101759},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3034":61260,"_26479":61210,"_18432":101761,"_5":12632,"_25092":101633,"_2540":43513},[],{"_3034":61261,"_26479":61210,"_18432":101763,"_5":12632,"_25092":101633,"_2540":5688},[],{"_3034":61262,"_26479":61210,"_18432":101765,"_5":12632,"_25092":101633,"_2540":101766},[],"Omite prompts y genera credenciales para las dependencias",{"_3034":61263,"_26479":61210,"_18432":101768,"_5":12632,"_25092":101633,"_2540":43521},[],{"_3034":61264,"_26479":61210,"_18432":101770,"_5":12632,"_25092":101633,"_2540":43524},[],{"_3034":61265,"_26479":61210,"_18432":101772,"_5":12632,"_25092":101633,"_2540":101773},[],"Namespace de la instalación",{"_3034":61266,"_26479":61210,"_18432":101775,"_5":12632,"_25092":101633,"_2540":43530},[],{"_3034":61267,"_26479":61210,"_18432":101777,"_5":12632,"_25092":101633,"_2540":43533},[],{"_3034":61268,"_26479":61210,"_18432":101779,"_5":12632,"_25092":101633,"_2540":101780},[],"Dominio usado por la UI, OIDC y el certificado",{"_3034":61269,"_26479":61210,"_18432":101782,"_5":12632,"_25092":101633,"_2540":43539},[],{"_3034":61270,"_26479":61210,"_18432":101784,"_5":12632,"_25092":101633,"_2540":13177},[],{"_3034":61271,"_26479":61210,"_18432":101786,"_5":12632,"_25092":101633,"_2540":101787},[],"Versión del chart de Lamassu",{"_3034":61272,"_26479":61210,"_18432":101789,"_5":12632,"_25092":101633,"_2540":43547},[],{"_3034":61273,"_26479":61210,"_18432":101791,"_5":12632,"_25092":101633,"_2540":43550},[],{"_3034":61274,"_26479":61210,"_18432":101793,"_5":12632,"_25092":101633,"_2540":101794},[],"Puerto del listener HTTPS",{"_3034":61275,"_26479":61210,"_18432":101796,"_5":12632,"_25092":101633,"_2540":43556},[],{"_3034":61276,"_26479":61210,"_18432":101798,"_5":12632,"_25092":101633,"_2540":43559},[],{"_3034":61277,"_26479":61210,"_18432":101800,"_5":12632,"_25092":101633,"_2540":101801},[],"Puerto del listener HTTP",{"_3034":61278,"_26479":61210,"_18432":101803,"_5":12632,"_25092":101633,"_2540":43565},[],{"_3034":61279,"_26479":61210,"_18432":101805,"_5":12632,"_25092":101633,"_2540":43498},[],{"_3034":61280,"_26479":61210,"_18432":101807,"_5":12632,"_25092":101633,"_2540":101808},[],"Certificado PEM para TLS downstream",{"_3034":61281,"_26479":61210,"_18432":101810,"_5":12632,"_25092":101633,"_2540":43573},[],{"_3034":61282,"_26479":61210,"_18432":101812,"_5":12632,"_25092":101633,"_2540":43498},[],{"_3034":61283,"_26479":61210,"_18432":101814,"_5":12632,"_25092":101633,"_2540":101815},[],"Clave privada PEM para TLS downstream",{"_3034":61284,"_26479":61210,"_18432":101817,"_5":12632,"_25092":101633,"_2540":43581},[],{"_3034":61285,"_26479":61210,"_18432":101819,"_5":12632,"_25092":101633,"_2540":101820},[],"chart del repositorio",{"_3034":61286,"_26479":61210,"_18432":101822,"_5":12632,"_25092":101633,"_2540":101823},[],"Usa un chart local de Lamassu sin empaquetar",{"_3034":61287,"_26479":61210,"_18432":101825,"_5":12632,"_25092":101633,"_2540":43590},[],{"_3034":61288,"_26479":61210,"_18432":101827,"_5":12632,"_25092":101633,"_2540":101828},[],"detección automática",{"_3034":61289,"_26479":61210,"_18432":101830,"_5":12632,"_25092":101633,"_2540":101831},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3034":61290,"_26479":61210,"_18432":101833,"_5":12632,"_25092":101633,"_2540":43598},[],{"_3034":61291,"_26479":61210,"_18432":101835,"_5":12632,"_25092":101633,"_2540":5688},[],{"_3034":61292,"_26479":61210,"_18432":101837,"_5":12632,"_25092":101633,"_2540":101838},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3034":61293,"_26479":61210,"_18432":101840,"_5":12632,"_25092":101633,"_2540":43606},[],{"_3034":61294,"_26479":61210,"_18432":101842,"_5":12632,"_25092":101633,"_2540":5688},[],{"_3034":61295,"_26479":61210,"_18432":101844,"_5":12632,"_25092":101633,"_2540":101845},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3034":61296,"_26479":61210,"_18432":101847,"_5":12632,"_25092":101633,"_2540":43614},[],{"_3034":61297,"_26479":61210,"_18432":101849,"_5":12632,"_25092":101633,"_2540":5688},[],{"_3034":61298,"_26479":61210,"_18432":101851,"_5":12632,"_25092":101633,"_2540":101852},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3034":61299,"_26479":61210,"_18432":101854,"_5":12632,"_25092":101633,"_2540":43622},[],{"_3034":61300,"_26479":61210,"_18432":101856,"_5":12632,"_25092":101633,"_2540":43625},[],{"_3034":61301,"_26479":61210,"_18432":101858,"_5":12632,"_25092":101633,"_2540":101859},[],"Usa otro chart local de SoftHSM",{"_3034":61302,"_26479":61210,"_18432":101861,"_5":12632,"_25092":101633,"_2540":101862},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3034":61303,"_26479":61210,"_18432":101864,"_5":12632,"_25092":101637,"_2540":43634},[],{"_3034":61304,"_26479":61210,"_18432":101866,"_5":12632,"_25092":101637,"_2540":101867},[],"valida las herramientas locales y el clúster seleccionado",{"_3034":61305,"_26479":61210,"_18432":101869,"_5":12632,"_25092":101637,"_2540":101870},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3034":61306,"_26479":61210,"_18432":101872,"_5":12632,"_25092":101637,"_2540":101873},[],"crea el namespace",{"_3034":61307,"_26479":61210,"_18432":101875,"_5":12632,"_25092":101637,"_2540":101876},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3034":61308,"_26479":61210,"_18432":101878,"_5":12632,"_25092":101637,"_2540":101879},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3034":61309,"_26479":61210,"_18432":101881,"_5":12632,"_25092":101637,"_2540":101882},[],"instala RabbitMQ",{"_3034":61310,"_26479":61210,"_18432":101884,"_5":12632,"_25092":101637,"_2540":101885},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3034":61311,"_26479":61210,"_18432":101887,"_5":12632,"_25092":101637,"_2540":101888},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3034":61312,"_26479":61210,"_18432":101890,"_5":12632,"_25092":101637,"_2540":101891},[],"carga datos de ejemplo opcionalmente",{"_3034":61313,"_26479":61210,"_18432":101893,"_5":12632,"_25092":101637,"_2540":101894},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3034":61314,"_26479":61210,"_18432":101896,"_5":12632,"_25092":101641,"_2540":101897},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3034":61315,"_26479":61210,"_18432":101899,"_5":12632,"_25092":101641,"_2540":101900},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3034":61316,"_26479":61210,"_18432":101902,"_5":12632,"_25092":101645,"_2540":101903},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso.",{"_3034":61317,"_26479":61210,"_18432":101905,"_5":12632,"_25092":101645,"_2540":101906},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3034":61318,"_26479":61210,"_18432":101908,"_5":12632,"_25092":101645,"_2540":101909},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3034":61319,"_26479":61210,"_18432":101911,"_5":12632,"_25092":101649,"_2540":101912},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3034":61320,"_26479":61320,"_5":12947,"_2540":101914,"_26823":101915,"_18432":101916,"_25092":61320},"Instala con Helm",[43109,101372,101606],[],{"_3034":61321,"_26479":61320,"_18432":101918,"_5":12632,"_25092":61320,"_2540":101919},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3034":61322,"_26479":61320,"_5":26820,"_18432":101921,"_25092":101922,"_2540":101923},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3034":61323,"_26479":61320,"_5":26820,"_18432":101925,"_25092":101926,"_2540":101622},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3034":61324,"_26479":61320,"_5":26820,"_18432":101928,"_25092":101929,"_2540":101930},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3034":61325,"_26479":61320,"_5":26820,"_18432":101932,"_25092":101933,"_2540":101934},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3034":61326,"_26479":61320,"_5":26820,"_18432":101936,"_25092":101937,"_2540":101938},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3034":61327,"_26479":61320,"_5":26820,"_18432":101940,"_25092":101941,"_2540":101942},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3034":61328,"_26479":61320,"_5":26820,"_18432":101944,"_25092":101945,"_2540":101946},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3034":61329,"_26479":61320,"_5":26820,"_18432":101948,"_25092":101949,"_2540":101950},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3034":61330,"_26479":61320,"_5":26820,"_18432":101952,"_25092":101953,"_2540":101954},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3034":61331,"_26479":61320,"_18432":101956,"_5":12632,"_25092":101922,"_2540":101957},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3034":61332,"_26479":61320,"_18432":101959,"_5":12632,"_25092":101926,"_2540":101960},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3034":61333,"_26479":61320,"_18432":101962,"_5":12632,"_25092":101926,"_2540":101963},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3034":61334,"_26479":61320,"_18432":101965,"_5":12632,"_25092":101926,"_2540":101966},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3034":61335,"_26479":61320,"_18432":101968,"_5":12632,"_25092":101926,"_2540":101969},[],"un broker RabbitMQ accesible y sus credenciales",{"_3034":61336,"_26479":61320,"_18432":101971,"_5":12632,"_25092":101926,"_2540":101972},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3034":61337,"_26479":61320,"_18432":101974,"_5":12632,"_25092":101926,"_2540":101975},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3034":61338,"_26479":61320,"_18432":101977,"_5":12632,"_25092":101926,"_2540":101978},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3034":61339,"_26479":61320,"_18432":101980,"_5":12632,"_25092":101926,"_2540":101981},[],"una StorageClass y un diseño de tráfico externo",{"_3034":61340,"_26479":61320,"_18432":101983,"_5":12632,"_25092":101926,"_2540":101984},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3034":61341,"_26479":61320,"_18432":101986,"_5":12632,"_25092":101926,"_2540":101987},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3034":61342,"_26479":61320,"_18432":101989,"_5":12632,"_25092":101926,"_2540":101990},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3034":61343,"_26479":61320,"_18432":101992,"_5":12632,"_25092":101929,"_2540":101993},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3034":61344,"_26479":61320,"_18432":101995,"_5":12632,"_25092":101929,"_2540":101996},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3034":61345,"_26479":61320,"_18432":101998,"_5":12632,"_25092":101929,"_2540":101999},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_3034":61346,"_26479":61320,"_18432":102001,"_5":12632,"_25092":101933,"_2540":102002},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3034":61347,"_26479":61320,"_18432":102004,"_5":12632,"_25092":101933,"_2540":102005},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3034":61348,"_26479":61320,"_18432":102007,"_5":12632,"_25092":101933,"_2540":102008},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3034":61349,"_26479":61320,"_18432":102010,"_5":12632,"_25092":101937,"_2540":102011},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_3034":61350,"_26479":61320,"_18432":102013,"_5":12632,"_25092":101941,"_2540":102014},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3034":61351,"_26479":61320,"_18432":102016,"_5":12632,"_25092":101941,"_2540":102017},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3034":61352,"_26479":61320,"_18432":102019,"_5":12632,"_25092":101941,"_2540":102020},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3034":61353,"_26479":61320,"_18432":102022,"_5":12632,"_25092":101941,"_2540":102023},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3034":61354,"_26479":61320,"_18432":102025,"_5":12632,"_25092":101945,"_2540":102026},[],"Para instalar un checkout local:",{"_3034":61355,"_26479":61320,"_18432":102028,"_5":12632,"_25092":101949,"_2540":102029},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3034":61356,"_26479":61320,"_18432":102031,"_5":12632,"_25092":101949,"_2540":102032},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3034":61357,"_26479":61320,"_18432":102034,"_5":12632,"_25092":101953,"_2540":102035},[],"Antes de pasar a producción, revisa:",{"_3034":61358,"_26479":61320,"_18432":102037,"_5":12632,"_25092":101953,"_2540":102038},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3034":61359,"_26479":61320,"_18432":102040,"_5":12632,"_25092":101953,"_2540":102041},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3034":61360,"_26479":61320,"_18432":102043,"_5":12632,"_25092":101953,"_2540":102044},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3034":61361,"_26479":61320,"_18432":102046,"_5":12632,"_25092":101953,"_2540":102047},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3034":61362,"_26479":61320,"_18432":102049,"_5":12632,"_25092":101953,"_2540":102050},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3034":61363,"_26479":61320,"_18432":102052,"_5":12632,"_25092":101953,"_2540":102053},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3034":61364,"_26479":61320,"_18432":102055,"_5":12632,"_25092":101953,"_2540":102056},[],"SMTP, observabilidad y entrega de alertas",{"_3034":61365,"_26479":61320,"_18432":102058,"_5":12632,"_25092":101953,"_2540":102059},[],"las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_3034":61366,"_26479":61320,"_18432":102061,"_5":12632,"_25092":101953,"_2540":102062},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3034":61367,"_26479":61367,"_5":12947,"_2540":102064,"_26823":102065,"_18432":102066,"_25092":61367},"Expón el Gateway",[43109,101372,101606],[],{"_3034":61368,"_26479":61367,"_18432":102068,"_5":12632,"_25092":61367,"_2540":102069},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3034":61369,"_26479":61367,"_5":26820,"_18432":102071,"_25092":102072,"_2540":102073},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3034":61370,"_26479":61367,"_5":26820,"_18432":102075,"_25092":102076,"_2540":102077},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3034":61371,"_26479":61367,"_5":26820,"_18432":102079,"_25092":102080,"_2540":102081},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3034":61372,"_26479":61367,"_5":26820,"_18432":102083,"_25092":102084,"_2540":43855},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/networking#k3s",{"_3034":61373,"_26479":61367,"_5":26820,"_18432":102086,"_25092":102087,"_2540":102088},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3034":61374,"_26479":61367,"_5":26820,"_18432":102090,"_25092":102091,"_2540":102092},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3034":61375,"_26479":61367,"_5":26820,"_18432":102094,"_25092":102095,"_2540":102096},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3034":61376,"_26479":61367,"_5":26820,"_18432":102098,"_25092":102099,"_2540":102100},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3034":61377,"_26479":61367,"_5":26820,"_18432":102102,"_25092":102103,"_2540":102104},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3034":61378,"_26479":61367,"_18432":102106,"_5":12632,"_25092":102072,"_2540":102107},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3034":61379,"_26479":61367,"_18432":102109,"_5":12632,"_25092":102072,"_2540":102110},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3034":61380,"_26479":61367,"_18432":102112,"_5":12632,"_25092":102076,"_2540":102113},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3034":61381,"_26479":61367,"_18432":102115,"_5":12632,"_25092":102076,"_2540":102116},[],"Defínelo únicamente cuando:",{"_3034":61382,"_26479":61367,"_18432":102118,"_5":12632,"_25092":102076,"_2540":102119},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3034":61383,"_26479":61367,"_18432":102121,"_5":12632,"_25092":102076,"_2540":102122},[],"esa dirección está asignada a este Gateway",{"_3034":61384,"_26479":61367,"_18432":102124,"_5":12632,"_25092":102076,"_2540":102125},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3034":61385,"_26479":61367,"_18432":102127,"_5":12632,"_25092":102076,"_2540":102128},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3034":61386,"_26479":61367,"_18432":102130,"_5":12632,"_25092":102076,"_2540":102131},[],"No confundas estos valores:",{"_3034":61387,"_26479":61367,"_18432":102133,"_5":12632,"_25092":102076,"_2540":102134},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3034":61388,"_26479":61367,"_18432":102136,"_5":12632,"_25092":102076,"_2540":102137},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3034":61389,"_26479":61367,"_18432":102139,"_5":12632,"_25092":102076,"_2540":102140},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3034":61390,"_26479":61367,"_18432":102142,"_5":12632,"_25092":102080,"_2540":102143},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3034":61391,"_26479":61367,"_18432":102145,"_5":12632,"_25092":102080,"_2540":102146},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3034":61392,"_26479":61367,"_18432":102148,"_5":12632,"_25092":102084,"_2540":102149},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3034":61393,"_26479":61367,"_18432":102151,"_5":12632,"_25092":102084,"_2540":102152},[],"Para el diseño recomendado:",{"_3034":61394,"_26479":61367,"_18432":102154,"_5":12632,"_25092":102084,"_2540":102155},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3034":61395,"_26479":61367,"_18432":102157,"_5":12632,"_25092":102084,"_2540":102158},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3034":61396,"_26479":61367,"_18432":102160,"_5":12632,"_25092":102084,"_2540":102161},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3034":61397,"_26479":61367,"_18432":102163,"_5":12632,"_25092":102084,"_2540":102164},[],"Apunta DNS a la dirección accesible de la VM.",{"_3034":61398,"_26479":61367,"_18432":102166,"_5":12632,"_25092":102084,"_2540":102167},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3034":61399,"_26479":61367,"_18432":102169,"_5":12632,"_25092":102087,"_2540":102170},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3034":61400,"_26479":61367,"_18432":102172,"_5":12632,"_25092":102091,"_2540":102173},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3034":61401,"_26479":61367,"_18432":102175,"_5":12632,"_25092":102091,"_2540":102176},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3034":61402,"_26479":61367,"_18432":102178,"_5":12632,"_25092":102095,"_2540":102179},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3034":61403,"_26479":61367,"_18432":102181,"_5":12632,"_25092":102095,"_2540":102182},[],"Requisito",{"_3034":61404,"_26479":61367,"_18432":102184,"_5":12632,"_25092":102095,"_2540":102185},[],"Diseño recomendado",{"_3034":61405,"_26479":61367,"_18432":102187,"_5":12632,"_25092":102095,"_2540":102188},[],"Consecuencia",{"_3034":61406,"_26479":61367,"_18432":102190,"_5":12632,"_25092":102095,"_2540":102191},[],"Varias URL o servicios de Lamassu",{"_3034":61407,"_26479":61367,"_18432":102193,"_5":12632,"_25092":102095,"_2540":102194},[],"Un Gateway con varias rutas",{"_3034":61408,"_26479":61367,"_18432":102196,"_5":12632,"_25092":102095,"_2540":102197},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3034":61409,"_26479":61367,"_18432":102199,"_5":12632,"_25092":102095,"_2540":102200},[],"Gateways independientes e IP externas distintas",{"_3034":61410,"_26479":61367,"_18432":102202,"_5":12632,"_25092":102095,"_2540":102203},[],"Una VIP por Gateway",{"_3034":61411,"_26479":61367,"_18432":102205,"_5":12632,"_25092":102095,"_2540":102206},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3034":61412,"_26479":61367,"_18432":102208,"_5":12632,"_25092":102095,"_2540":102209},[],"Gateways independientes, un nodo y una IP",{"_3034":61413,"_26479":61367,"_18432":102211,"_5":12632,"_25092":102095,"_2540":102212},[],"Puertos externos diferentes",{"_3034":61414,"_26479":61367,"_18432":102214,"_5":12632,"_25092":102095,"_2540":102215},[],"Los clientes deben indicar puertos no estándar",{"_3034":61415,"_26479":61367,"_18432":102217,"_5":12632,"_25092":102095,"_2540":102218},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3034":61416,"_26479":61367,"_18432":102220,"_5":12632,"_25092":102095,"_2540":102221},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3034":61417,"_26479":61367,"_18432":102223,"_5":12632,"_25092":102095,"_2540":102224},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3034":61418,"_26479":61367,"_18432":102226,"_5":12632,"_25092":102095,"_2540":102227},[],"Recursos Gateway separados pero proxy compartido",{"_3034":61419,"_26479":61367,"_18432":102229,"_5":12632,"_25092":102095,"_2540":102230},[],"Modo merged Gateway de Envoy",{"_3034":61420,"_26479":61367,"_18432":102232,"_5":12632,"_25092":102095,"_2540":102233},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3034":61421,"_26479":61367,"_18432":102235,"_5":12632,"_25092":102095,"_2540":102236},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3034":61422,"_26479":61367,"_18432":102238,"_5":12632,"_25092":102095,"_2540":102239},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3034":61423,"_26479":61367,"_18432":102241,"_5":12632,"_25092":102095,"_2540":102242},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3034":61424,"_26479":61367,"_18432":102244,"_5":12632,"_25092":102095,"_2540":102245},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3034":61425,"_26479":61367,"_18432":102247,"_5":12632,"_25092":102099,"_2540":102248},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3034":61426,"_26479":61367,"_18432":102250,"_5":12632,"_25092":102099,"_2540":102251},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3034":61427,"_26479":61367,"_18432":102253,"_5":12632,"_25092":102099,"_2540":102254},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3034":61428,"_26479":61367,"_18432":102256,"_5":12632,"_25092":102099,"_2540":102257},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3034":61429,"_26479":61367,"_18432":102259,"_5":12632,"_25092":102099,"_2540":102260},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3034":61430,"_26479":61367,"_18432":102262,"_5":12632,"_25092":102103,"_2540":102263},[],"Comprueba, en orden:",{"_3034":61431,"_26479":61367,"_18432":102265,"_5":12632,"_25092":102103,"_2540":102266},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3034":61432,"_26479":61367,"_18432":102268,"_5":12632,"_25092":102103,"_2540":102269},[],"Su estado contiene la dirección esperada.",{"_3034":61433,"_26479":61367,"_18432":102271,"_5":12632,"_25092":102103,"_2540":102272},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3034":61434,"_26479":61367,"_18432":102274,"_5":12632,"_25092":102103,"_2540":102275},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3034":61435,"_26479":61367,"_18432":102277,"_5":12632,"_25092":102103,"_2540":102278},[],"DNS resuelve al endpoint accesible externamente.",{"_3034":61436,"_26479":61367,"_18432":102280,"_5":12632,"_25092":102103,"_2540":102281},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3034":61437,"_26479":61367,"_18432":102283,"_5":12632,"_25092":102103,"_2540":102284},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3034":61438,"_26479":61438,"_5":12947,"_2540":43216,"_26823":102286,"_18432":102287,"_25092":61438},[43109,101372,101606],[],{"_3034":61439,"_26479":61438,"_18432":102289,"_5":12632,"_25092":61438,"_2540":102290},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3034":61440,"_26479":61438,"_5":26820,"_18432":102292,"_25092":102293,"_2540":102294},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3034":61441,"_26479":61438,"_5":26820,"_18432":102296,"_25092":102297,"_2540":102298},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3034":61442,"_26479":61438,"_5":26820,"_18432":102300,"_25092":102301,"_2540":102302},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3034":61443,"_26479":61438,"_5":26820,"_18432":102304,"_25092":102305,"_2540":102306},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3034":61444,"_26479":61438,"_5":26820,"_18432":102308,"_25092":102309,"_2540":102310},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3034":61445,"_26479":61438,"_5":26820,"_18432":102312,"_25092":102313,"_2540":102314},[],"/docs/pr-preview/pr-47/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3034":61446,"_26479":61438,"_18432":102316,"_5":12632,"_25092":102293,"_2540":102317},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3034":61447,"_26479":61438,"_18432":102319,"_5":12632,"_25092":102297,"_2540":102320},[],"Flujo",{"_3034":61448,"_26479":61438,"_18432":102322,"_5":12632,"_25092":102297,"_2540":102323},[],"Úsalo para",{"_3034":61449,"_26479":61438,"_18432":102325,"_5":12632,"_25092":102297,"_2540":102326},[],"Qué instala",{"_3034":61450,"_26479":61438,"_18432":102328,"_5":12632,"_25092":102297,"_2540":44100},[],{"_3034":61451,"_26479":61438,"_18432":102330,"_5":12632,"_25092":102297,"_2540":102331},[],"Producción y entornos controlados",{"_3034":61452,"_26479":61438,"_18432":102333,"_5":12632,"_25092":102297,"_2540":102334},[],"Servicios de Lamassu y recursos de Gateway API",{"_3034":61453,"_26479":61438,"_18432":102336,"_5":12632,"_25092":102297,"_2540":43353},[],{"_3034":61454,"_26479":61438,"_18432":102338,"_5":12632,"_25092":102297,"_2540":102339},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3034":61455,"_26479":61438,"_18432":102341,"_5":12632,"_25092":102297,"_2540":102342},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3034":61456,"_26479":61438,"_18432":102344,"_5":12632,"_25092":102301,"_2540":102345},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3034":61457,"_26479":61438,"_18432":102347,"_5":12632,"_25092":102301,"_2540":102348},[],"Área",{"_3034":61458,"_26479":61438,"_18432":102350,"_5":12632,"_25092":102301,"_2540":102351},[],"El chart de Lamassu proporciona",{"_3034":61459,"_26479":61438,"_18432":102353,"_5":12632,"_25092":102301,"_2540":102354},[],"Tú proporcionas",{"_3034":61460,"_26479":61438,"_18432":102356,"_5":12632,"_25092":102301,"_2540":102357},[],"Aplicaciones Lamassu",{"_3034":61461,"_26479":61438,"_18432":102359,"_5":12632,"_25092":102301,"_2540":102360},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3034":61462,"_26479":61438,"_18432":102362,"_5":12632,"_25092":102301,"_2540":102363},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3034":61463,"_26479":61438,"_18432":102365,"_5":12632,"_25092":102301,"_2540":102366},[],"Datos PostgreSQL",{"_3034":61464,"_26479":61438,"_18432":102368,"_5":12632,"_25092":102301,"_2540":102369},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3034":61465,"_26479":61438,"_18432":102371,"_5":12632,"_25092":102301,"_2540":102372},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3034":61466,"_26479":61438,"_18432":102374,"_5":12632,"_25092":102301,"_2540":102375},[],"Mensajería",{"_3034":61467,"_26479":61438,"_18432":102377,"_5":12632,"_25092":102301,"_2540":102378},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_3034":61468,"_26479":61438,"_18432":102380,"_5":12632,"_25092":102301,"_2540":102381},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3034":61469,"_26479":61438,"_18432":102383,"_5":12632,"_25092":102301,"_2540":102384},[],"Identidad",{"_3034":61470,"_26479":61438,"_18432":102386,"_5":12632,"_25092":102301,"_2540":102387},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3034":61471,"_26479":61438,"_18432":102389,"_5":12632,"_25092":102301,"_2540":102390},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3034":61472,"_26479":61438,"_18432":102392,"_5":12632,"_25092":102301,"_2540":102393},[],"Enrutamiento externo",{"_3034":61473,"_26479":61438,"_18432":102395,"_5":12632,"_25092":102301,"_2540":102396},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3034":61474,"_26479":61438,"_18432":102398,"_5":12632,"_25092":102301,"_2540":102399},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3034":61475,"_26479":61438,"_18432":102401,"_5":12632,"_25092":102301,"_2540":44174},[],{"_3034":61476,"_26479":61438,"_18432":102403,"_5":12632,"_25092":102301,"_2540":102404},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_3034":61477,"_26479":61438,"_18432":102406,"_5":12632,"_25092":102301,"_2540":102407},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3034":61478,"_26479":61438,"_18432":102409,"_5":12632,"_25092":102301,"_2540":102410},[],"Datos persistentes de la aplicación",{"_3034":61479,"_26479":61438,"_18432":102412,"_5":12632,"_25092":102301,"_2540":102413},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3034":61480,"_26479":61438,"_18432":102415,"_5":12632,"_25092":102301,"_2540":102416},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3034":61481,"_26479":61438,"_18432":102418,"_5":12632,"_25092":102301,"_2540":102419},[],"Integraciones opcionales",{"_3034":61482,"_26479":61438,"_18432":102421,"_5":12632,"_25092":102301,"_2540":102422},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3034":61483,"_26479":61438,"_18432":102424,"_5":12632,"_25092":102301,"_2540":102425},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3034":61484,"_26479":61438,"_18432":102427,"_5":12632,"_25092":102301,"_2540":102428},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3034":61485,"_26479":61438,"_18432":102430,"_5":12632,"_25092":102301,"_2540":102431},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3034":61486,"_26479":61438,"_18432":102433,"_5":12632,"_25092":102305,"_2540":102434},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3034":61487,"_26479":61438,"_18432":102436,"_5":12632,"_25092":102305,"_2540":102437},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3034":61488,"_26479":61438,"_18432":102439,"_5":12632,"_25092":102309,"_2540":102440},[],"Kubernetes 1.24 o posterior",{"_3034":61489,"_26479":61438,"_18432":102442,"_5":12632,"_25092":102309,"_2540":102443},[],"Helm 3.2 o posterior",{"_3034":61490,"_26479":61438,"_18432":102445,"_5":12632,"_25092":102309,"_2540":102446},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3034":61491,"_26479":61438,"_18432":102448,"_5":12632,"_25092":102309,"_2540":102449},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_3034":61492,"_26479":61438,"_18432":102451,"_5":12632,"_25092":102309,"_2540":102452},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3034":61493,"_26479":61438,"_18432":102454,"_5":12632,"_25092":102309,"_2540":102455},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3034":61494,"_26479":61438,"_18432":102457,"_5":12632,"_25092":102309,"_2540":102458},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior.",{"_3034":61495,"_26479":61438,"_18432":102460,"_5":12632,"_25092":102313,"_2540":102461},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3034":61496,"_26479":61438,"_18432":102463,"_5":12632,"_25092":102313,"_2540":102464},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3034":61497,"_26479":61438,"_18432":102466,"_5":12632,"_25092":102313,"_2540":102467},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3034":61498,"_26479":61498,"_5":12947,"_2540":102469,"_26823":102470,"_18432":102472,"_25092":61498},"Resolución de problemas de despliegue",[43109,101372,102471],"Operación",[],{"_3034":61499,"_26479":61498,"_18432":102474,"_5":12632,"_25092":61498,"_2540":102475},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3034":61500,"_26479":61498,"_5":26820,"_18432":102477,"_25092":102478,"_2540":102479},[],"/docs/pr-preview/pr-47/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3034":61501,"_26479":61498,"_5":26820,"_18432":102481,"_25092":102482,"_2540":102483},[],"/docs/pr-preview/pr-47/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3034":61502,"_26479":61498,"_5":26820,"_18432":102485,"_25092":102486,"_2540":102487},[],"/docs/pr-preview/pr-47/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3034":61503,"_26479":61498,"_5":26820,"_18432":102489,"_25092":102490,"_2540":102491},[],"/docs/pr-preview/pr-47/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3034":61504,"_26479":61498,"_5":26820,"_18432":102493,"_25092":102494,"_2540":102495},[],"/docs/pr-preview/pr-47/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3034":61505,"_26479":61498,"_5":26820,"_18432":102497,"_25092":102498,"_2540":102499},[],"/docs/pr-preview/pr-47/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3034":61506,"_26479":61498,"_5":26820,"_18432":102501,"_25092":102502,"_2540":102503},[],"/docs/pr-preview/pr-47/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3034":61507,"_26479":61498,"_5":26820,"_18432":102505,"_25092":102506,"_2540":102507},[],"/docs/pr-preview/pr-47/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3034":61508,"_26479":61498,"_5":26820,"_18432":102509,"_25092":102510,"_2540":102511},[],"/docs/pr-preview/pr-47/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3034":61509,"_26479":61498,"_5":26820,"_18432":102513,"_25092":102514,"_2540":102515},[],"/docs/pr-preview/pr-47/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3034":61510,"_26479":61498,"_5":26820,"_18432":102517,"_25092":102518,"_2540":102519},[],"/docs/pr-preview/pr-47/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3034":61511,"_26479":61498,"_5":26820,"_18432":102521,"_25092":102522,"_2540":102523},[],"/docs/pr-preview/pr-47/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3034":61512,"_26479":61498,"_18432":102525,"_5":12632,"_25092":61498,"_2540":102526},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3034":61513,"_26479":61498,"_18432":102528,"_5":12632,"_25092":102482,"_2540":102529},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3034":61514,"_26479":61498,"_18432":102531,"_5":12632,"_25092":102486,"_2540":102532},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3034":61515,"_26479":61498,"_18432":102534,"_5":12632,"_25092":102490,"_2540":102535},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3034":61516,"_26479":61498,"_18432":102537,"_5":12632,"_25092":102494,"_2540":102538},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3034":61517,"_26479":61498,"_18432":102540,"_5":12632,"_25092":102498,"_2540":102541},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3034":61518,"_26479":61498,"_18432":102543,"_5":12632,"_25092":102502,"_2540":102544},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3034":61519,"_26479":61498,"_18432":102546,"_5":12632,"_25092":102502,"_2540":102547},[],"Ejecuta también la prueba de conectividad del chart:",{"_3034":61520,"_26479":61498,"_18432":102549,"_5":12632,"_25092":102502,"_2540":102550},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3034":61521,"_26479":61498,"_18432":102552,"_5":12632,"_25092":102502,"_2540":102553},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3034":61522,"_26479":61498,"_18432":102555,"_5":12632,"_25092":102506,"_2540":102556},[],"Si recibes un 401:",{"_3034":61523,"_26479":61498,"_18432":102558,"_5":12632,"_25092":102506,"_2540":102559},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3034":61524,"_26479":61498,"_18432":102561,"_5":12632,"_25092":102506,"_2540":102562},[],"verifica emisor, audiencia y expiración del token;",{"_3034":61525,"_26479":61498,"_18432":102564,"_5":12632,"_25092":102506,"_2540":102565},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3034":61526,"_26479":61498,"_18432":102567,"_5":12632,"_25092":102506,"_2540":102568},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3034":61527,"_26479":61498,"_18432":102570,"_5":12632,"_25092":102506,"_2540":102571},[],"Si el login termina pero las APIs devuelven 403:",{"_3034":61528,"_26479":61498,"_18432":102573,"_5":12632,"_25092":102506,"_2540":102574},[],"inspecciona los claims reales del token;",{"_3034":61529,"_26479":61498,"_18432":102576,"_5":12632,"_25092":102506,"_2540":102577},[],"confirma que coinciden con un principal activo;",{"_3034":61530,"_26479":61498,"_18432":102579,"_5":12632,"_25092":102506,"_2540":102580},[],"revisa las políticas concedidas al principal;",{"_3034":61531,"_26479":61498,"_18432":102582,"_5":12632,"_25092":102506,"_2540":102583},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3034":61532,"_26479":61498,"_18432":102585,"_5":12632,"_25092":102506,"_2540":102586},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3034":61533,"_26479":61498,"_18432":102588,"_5":12632,"_25092":102510,"_2540":102589},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3034":61534,"_26479":61498,"_18432":102591,"_5":12632,"_25092":102510,"_2540":102592},[],"Localiza el pod y Service de authz.",{"_3034":61535,"_26479":61498,"_18432":102594,"_5":12632,"_25092":102510,"_2540":102595},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3034":61536,"_26479":61498,"_18432":102597,"_5":12632,"_25092":102510,"_2540":102598},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3034":61537,"_26479":61498,"_18432":102600,"_5":12632,"_25092":102510,"_2540":102601},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3034":61538,"_26479":61498,"_18432":102603,"_5":12632,"_25092":102510,"_2540":102604},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3034":61539,"_26479":61498,"_18432":102606,"_5":12632,"_25092":102514,"_2540":102607},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3034":61540,"_26479":61498,"_18432":102609,"_5":12632,"_25092":102514,"_2540":102610},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3034":61541,"_26479":61498,"_18432":102612,"_5":12632,"_25092":102514,"_2540":102613},[],"volumen persistente sin enlazar;",{"_3034":61542,"_26479":61498,"_18432":102615,"_5":12632,"_25092":102514,"_2540":102616},[],"imagen inaccesible o política de pull incorrecta;",{"_3034":61543,"_26479":61498,"_18432":102618,"_5":12632,"_25092":102514,"_2540":102619},[],"configuración inválida del motor criptográfico;",{"_3034":61544,"_26479":61498,"_18432":102621,"_5":12632,"_25092":102514,"_2540":102622},[],"límites de CPU o memoria demasiado bajos;",{"_3034":61545,"_26479":61498,"_18432":102624,"_5":12632,"_25092":102514,"_2540":102625},[],"migración previa incompleta.",{"_3034":61546,"_26479":61498,"_18432":102627,"_5":12632,"_25092":102514,"_2540":102628},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3034":61547,"_26479":61498,"_18432":102630,"_5":12632,"_25092":102514,"_2540":102631},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3034":61548,"_26479":61498,"_18432":102633,"_5":12632,"_25092":102518,"_2540":102634},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3034":61549,"_26479":61498,"_18432":102636,"_5":12632,"_25092":102518,"_2540":102637},[],"verifica que esté habilitado en el servicio emisor;",{"_3034":61550,"_26479":61498,"_18432":102639,"_5":12632,"_25092":102518,"_2540":102640},[],"comprueba conectividad y credenciales AMQP;",{"_3034":61551,"_26479":61498,"_18432":102642,"_5":12632,"_25092":102518,"_2540":102643},[],"revisa exchange, routing key, colas y consumidores;",{"_3034":61552,"_26479":61498,"_18432":102645,"_5":12632,"_25092":102518,"_2540":102646},[],"inspecciona dead-letter queues;",{"_3034":61553,"_26479":61498,"_18432":102648,"_5":12632,"_25092":102518,"_2540":102649},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3034":61554,"_26479":61498,"_18432":102651,"_5":12632,"_25092":102518,"_2540":102652},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3034":61555,"_26479":61498,"_18432":102654,"_5":12632,"_25092":102522,"_2540":102655},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_3034":61556,"_26479":61498,"_18432":102657,"_5":12632,"_25092":102522,"_2540":102658},[],"Antes de cerrar una incidencia, guarda:",{"_3034":61557,"_26479":61498,"_18432":102660,"_5":12632,"_25092":102522,"_2540":102661},[],"causa confirmada;",{"_3034":61558,"_26479":61498,"_18432":102663,"_5":12632,"_25092":102522,"_2540":102664},[],"alcance temporal y recursos afectados;",{"_3034":61559,"_26479":61498,"_18432":102666,"_5":12632,"_25092":102522,"_2540":102667},[],"comandos o consultas utilizados;",{"_3034":61560,"_26479":61498,"_18432":102669,"_5":12632,"_25092":102522,"_2540":102670},[],"cambio aplicado y forma de revertirlo;",{"_3034":61561,"_26479":61498,"_18432":102672,"_5":12632,"_25092":102522,"_2540":102673},[],"validación desde un consumidor;",{"_3034":61562,"_26479":61498,"_18432":102675,"_5":12632,"_25092":102522,"_2540":102676},[],"acción preventiva y propietario.",{"_3034":61563,"_26479":61563,"_5":12947,"_2540":102678,"_26823":102679,"_18432":102682,"_25092":61563},"Control de acceso",[43109,102680,102681],"Plataforma","Administración",[],{"_3034":61564,"_26479":61563,"_18432":102684,"_5":12632,"_25092":61563,"_2540":102685},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3034":61565,"_26479":61563,"_5":26820,"_18432":102687,"_25092":102688,"_2540":102689},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3034":61566,"_26479":61563,"_5":26820,"_18432":102691,"_25092":102692,"_2540":102693},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3034":61567,"_26479":61563,"_5":26820,"_18432":102695,"_25092":102696,"_2540":102697},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3034":61568,"_26479":61563,"_5":26820,"_18432":102699,"_25092":102700,"_2540":102701},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3034":61569,"_26479":61563,"_5":26820,"_18432":102703,"_25092":102704,"_2540":102705},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3034":61570,"_26479":61563,"_5":26820,"_18432":102707,"_25092":102708,"_2540":102709},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3034":61571,"_26479":61563,"_5":26820,"_18432":102711,"_25092":102712,"_2540":102713},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3034":61572,"_26479":61563,"_5":26820,"_18432":102715,"_25092":102716,"_2540":102717},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3034":61573,"_26479":61563,"_5":26820,"_18432":102719,"_25092":102720,"_2540":102721},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3034":61574,"_26479":61563,"_5":26820,"_18432":102723,"_25092":102724,"_2540":102725},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3034":61575,"_26479":61563,"_5":26820,"_18432":102727,"_25092":102728,"_2540":102729},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3034":61576,"_26479":61563,"_5":26820,"_18432":102731,"_25092":102732,"_2540":102733},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3034":61577,"_26479":61563,"_5":26820,"_18432":102735,"_25092":102736,"_2540":102737},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3034":61578,"_26479":61563,"_5":26820,"_18432":102739,"_25092":102740,"_2540":102741},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3034":61579,"_26479":61563,"_5":26820,"_18432":102743,"_25092":102744,"_2540":102745},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3034":61580,"_26479":61563,"_5":26820,"_18432":102747,"_25092":102748,"_2540":101942},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3034":61581,"_26479":61563,"_5":26820,"_18432":102750,"_25092":102751,"_2540":102752},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3034":61582,"_26479":61563,"_5":26820,"_18432":102754,"_25092":102755,"_2540":102756},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#configura-las-dos-validaciones-jwt","Configura las dos validaciones JWT",{"_3034":61583,"_26479":61563,"_5":26820,"_18432":102758,"_25092":102759,"_2540":102760},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3034":61584,"_26479":61563,"_5":26820,"_18432":102762,"_25092":102763,"_2540":102764},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3034":61585,"_26479":61563,"_5":26820,"_18432":102766,"_25092":102767,"_2540":102768},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3034":61586,"_26479":61563,"_5":26820,"_18432":102770,"_25092":102771,"_2540":102772},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3034":61587,"_26479":61563,"_5":26820,"_18432":102774,"_25092":102775,"_2540":102776},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3034":61588,"_26479":61563,"_5":26820,"_18432":102778,"_25092":102779,"_2540":102780},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3034":61589,"_26479":61563,"_5":26820,"_18432":102782,"_25092":102783,"_2540":102784},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3034":61590,"_26479":61563,"_5":26820,"_18432":102786,"_25092":102787,"_2540":102788},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3034":61591,"_26479":61563,"_5":26820,"_18432":102790,"_25092":102791,"_2540":102792},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3034":61592,"_26479":61563,"_5":26820,"_18432":102794,"_25092":102795,"_2540":102796},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3034":61593,"_26479":61563,"_5":26820,"_18432":102798,"_25092":102799,"_2540":102800},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3034":61594,"_26479":61563,"_5":26820,"_18432":102802,"_25092":102803,"_2540":102804},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3034":61595,"_26479":61563,"_5":26820,"_18432":102806,"_25092":102807,"_2540":102808},[],"/docs/pr-preview/pr-47/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3034":61596,"_26479":61563,"_18432":102810,"_5":12632,"_25092":61563,"_2540":102811},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3034":61597,"_26479":61563,"_18432":102813,"_5":12632,"_25092":61563,"_2540":102814},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3034":61598,"_26479":61563,"_18432":102816,"_5":12632,"_25092":61563,"_2540":102817},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3034":61599,"_26479":61563,"_18432":102819,"_5":12632,"_25092":102688,"_2540":102820},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3034":61600,"_26479":61563,"_18432":102822,"_5":12632,"_25092":102688,"_2540":102823},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3034":61601,"_26479":61563,"_18432":102825,"_5":12632,"_25092":102688,"_2540":102826},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3034":61602,"_26479":61563,"_18432":102828,"_5":12632,"_25092":102688,"_2540":102829},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3034":61603,"_26479":61563,"_18432":102831,"_5":12632,"_25092":102688,"_2540":102832},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3034":61604,"_26479":61563,"_18432":102834,"_5":12632,"_25092":102688,"_2540":102835},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3034":61605,"_26479":61563,"_18432":102837,"_5":12632,"_25092":102692,"_2540":102838},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3034":61606,"_26479":61563,"_18432":102840,"_5":12632,"_25092":102692,"_2540":102841},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3034":61607,"_26479":61563,"_18432":102843,"_5":12632,"_25092":102696,"_2540":102844},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3034":61608,"_26479":61563,"_18432":102846,"_5":12632,"_25092":102696,"_2540":102847},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3034":61609,"_26479":61563,"_18432":102849,"_5":12632,"_25092":102696,"_2540":102850},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3034":61610,"_26479":61563,"_18432":102852,"_5":12632,"_25092":102696,"_2540":102853},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3034":61611,"_26479":61563,"_18432":102855,"_5":12632,"_25092":102696,"_2540":102856},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3034":61612,"_26479":61563,"_18432":102858,"_5":12632,"_25092":102696,"_2540":102859},[],"Carga por separado las políticas concedidas a cada principal.",{"_3034":61613,"_26479":61563,"_18432":102861,"_5":12632,"_25092":102696,"_2540":102862},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3034":61614,"_26479":61563,"_18432":102864,"_5":12632,"_25092":102696,"_2540":102865},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3034":61615,"_26479":61563,"_18432":102867,"_5":12632,"_25092":102696,"_2540":102868},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3034":61616,"_26479":61563,"_18432":102870,"_5":12632,"_25092":102696,"_2540":102871},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3034":61617,"_26479":61563,"_18432":102873,"_5":12632,"_25092":102696,"_2540":102874},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3034":61618,"_26479":61563,"_18432":102876,"_5":12632,"_25092":102696,"_2540":102877},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3034":61619,"_26479":61563,"_18432":102879,"_5":12632,"_25092":102700,"_2540":102880},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3034":61620,"_26479":61563,"_18432":102882,"_5":12632,"_25092":102700,"_2540":102883},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3034":61621,"_26479":61563,"_18432":102885,"_5":12632,"_25092":102700,"_2540":102886},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3034":61622,"_26479":61563,"_18432":102888,"_5":12632,"_25092":102700,"_2540":102889},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3034":61623,"_26479":61563,"_18432":102891,"_5":12632,"_25092":102700,"_2540":102892},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3034":61624,"_26479":61563,"_18432":102894,"_5":12632,"_25092":102700,"_2540":102895},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3034":61625,"_26479":61563,"_18432":102897,"_5":12632,"_25092":102700,"_2540":102898},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3034":61626,"_26479":61563,"_18432":102900,"_5":12632,"_25092":102700,"_2540":102901},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3034":61627,"_26479":61563,"_18432":102903,"_5":12632,"_25092":102704,"_2540":102904},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3034":61628,"_26479":61563,"_18432":102906,"_5":12632,"_25092":102704,"_2540":102907},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3034":61629,"_26479":61563,"_18432":102909,"_5":12632,"_25092":102704,"_2540":102910},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3034":61630,"_26479":61563,"_18432":102912,"_5":12632,"_25092":102704,"_2540":102913},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3034":61631,"_26479":61563,"_18432":102915,"_5":12632,"_25092":102704,"_2540":102916},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3034":61632,"_26479":61563,"_18432":102918,"_5":12632,"_25092":102704,"_2540":102919},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3034":61633,"_26479":61563,"_18432":102921,"_5":12632,"_25092":102704,"_2540":102922},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3034":61634,"_26479":61563,"_18432":102924,"_5":12632,"_25092":102704,"_2540":102925},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3034":61635,"_26479":61563,"_18432":102927,"_5":12632,"_25092":102704,"_2540":102928},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3034":61636,"_26479":61563,"_18432":102930,"_5":12632,"_25092":102704,"_2540":102931},[],"Las acciones se dividen en dos grupos:",{"_3034":61637,"_26479":61563,"_18432":102933,"_5":12632,"_25092":102704,"_2540":102934},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3034":61638,"_26479":61563,"_18432":102936,"_5":12632,"_25092":102704,"_2540":102937},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3034":61639,"_26479":61563,"_18432":102939,"_5":12632,"_25092":102704,"_2540":102940},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3034":61640,"_26479":61563,"_18432":102942,"_5":12632,"_25092":102708,"_2540":102943},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3034":61641,"_26479":61563,"_18432":102945,"_5":12632,"_25092":102708,"_2540":102946},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3034":61642,"_26479":61563,"_18432":102948,"_5":12632,"_25092":102708,"_2540":102949},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3034":61643,"_26479":61563,"_18432":102951,"_5":12632,"_25092":102712,"_2540":102952},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3034":61644,"_26479":61563,"_18432":102954,"_5":12632,"_25092":102712,"_2540":102955},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3034":61645,"_26479":61563,"_18432":102957,"_5":12632,"_25092":102712,"_2540":102958},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3034":61646,"_26479":61563,"_18432":102960,"_5":12632,"_25092":102712,"_2540":102961},[],"Los operadores implementados son:",{"_3034":61647,"_26479":61563,"_18432":102963,"_5":12632,"_25092":102712,"_2540":102964},[],"`equals`, para igualdad exacta;",{"_3034":61648,"_26479":61563,"_18432":102966,"_5":12632,"_25092":102712,"_2540":102967},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3034":61649,"_26479":61563,"_18432":102969,"_5":12632,"_25092":102712,"_2540":102970},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3034":61650,"_26479":61563,"_18432":102972,"_5":12632,"_25092":102712,"_2540":102973},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3034":61651,"_26479":61563,"_18432":102975,"_5":12632,"_25092":102716,"_2540":102976},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3034":61652,"_26479":61563,"_18432":102978,"_5":12632,"_25092":102716,"_2540":102979},[],"Los modos disponibles son:",{"_3034":61653,"_26479":61563,"_18432":102981,"_5":12632,"_25092":102716,"_2540":102982},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3034":61654,"_26479":61563,"_18432":102984,"_5":12632,"_25092":102716,"_2540":102985},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3034":61655,"_26479":61563,"_18432":102987,"_5":12632,"_25092":102716,"_2540":102988},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3034":61656,"_26479":61563,"_18432":102990,"_5":12632,"_25092":102716,"_2540":102991},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3034":61657,"_26479":61563,"_18432":102993,"_5":12632,"_25092":102716,"_2540":102994},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3034":61658,"_26479":61563,"_18432":102996,"_5":12632,"_25092":102716,"_2540":102997},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3034":61659,"_26479":61563,"_18432":102999,"_5":12632,"_25092":102720,"_2540":103000},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3034":61660,"_26479":61563,"_18432":103002,"_5":12632,"_25092":102720,"_2540":103003},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3034":61661,"_26479":61563,"_18432":103005,"_5":12632,"_25092":102720,"_2540":103006},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3034":61662,"_26479":61563,"_18432":103008,"_5":12632,"_25092":102720,"_2540":103009},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3034":61663,"_26479":61563,"_18432":103011,"_5":12632,"_25092":102728,"_2540":103012},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3034":61664,"_26479":61563,"_18432":103014,"_5":12632,"_25092":102728,"_2540":103015},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3034":61665,"_26479":61563,"_18432":103017,"_5":12632,"_25092":102732,"_2540":103018},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3034":61666,"_26479":61563,"_18432":103020,"_5":12632,"_25092":102732,"_2540":103021},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3034":61667,"_26479":61563,"_18432":103023,"_5":12632,"_25092":102736,"_2540":103024},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3034":61668,"_26479":61563,"_18432":103026,"_5":12632,"_25092":102736,"_2540":103027},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3034":61669,"_26479":61563,"_18432":103029,"_5":12632,"_25092":102736,"_2540":103030},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3034":61670,"_26479":61563,"_18432":103032,"_5":12632,"_25092":102740,"_2540":103033},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3034":61671,"_26479":61563,"_18432":103035,"_5":12632,"_25092":102740,"_2540":103036},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3034":61672,"_26479":61563,"_18432":103038,"_5":12632,"_25092":102740,"_2540":103039},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3034":61673,"_26479":61563,"_18432":103041,"_5":12632,"_25092":102740,"_2540":103042},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3034":61674,"_26479":61563,"_18432":103044,"_5":12632,"_25092":102740,"_2540":103045},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3034":61675,"_26479":61563,"_18432":103047,"_5":12632,"_25092":102740,"_2540":103048},[],"Ten en cuenta que:",{"_3034":61676,"_26479":61563,"_18432":103050,"_5":12632,"_25092":102740,"_2540":103051},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3034":61677,"_26479":61563,"_18432":103053,"_5":12632,"_25092":102740,"_2540":103054},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3034":61678,"_26479":61563,"_18432":103056,"_5":12632,"_25092":102740,"_2540":103057},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3034":61679,"_26479":61563,"_18432":103059,"_5":12632,"_25092":102744,"_2540":103060},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3034":61680,"_26479":61563,"_18432":103062,"_5":12632,"_25092":102744,"_2540":103063},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3034":61681,"_26479":61563,"_18432":103065,"_5":12632,"_25092":102744,"_2540":103066},[],"acceso completo y de solo lectura a KMS;",{"_3034":61682,"_26479":61563,"_18432":103068,"_5":12632,"_25092":102744,"_2540":103069},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3034":61683,"_26479":61563,"_18432":103071,"_5":12632,"_25092":102744,"_2540":103072},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3034":61684,"_26479":61563,"_18432":103074,"_5":12632,"_25092":102744,"_2540":103075},[],"acceso a la interfaz;",{"_3034":61685,"_26479":61563,"_18432":103077,"_5":12632,"_25092":102744,"_2540":103078},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3034":61686,"_26479":61563,"_18432":103080,"_5":12632,"_25092":102744,"_2540":103081},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3034":61687,"_26479":61563,"_18432":103083,"_5":12632,"_25092":102744,"_2540":103084},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3034":61688,"_26479":61563,"_18432":103086,"_5":12632,"_25092":102748,"_2540":103087},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3034":61689,"_26479":61563,"_18432":103089,"_5":12632,"_25092":102748,"_2540":103090},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3034":61690,"_26479":61563,"_18432":103092,"_5":12632,"_25092":102748,"_2540":103093},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3034":61691,"_26479":61563,"_18432":103095,"_5":12632,"_25092":102751,"_2540":103096},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3034":61692,"_26479":61563,"_18432":103098,"_5":12632,"_25092":102755,"_2540":103099},[],"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes.",{"_3034":61693,"_26479":61563,"_18432":103101,"_5":12632,"_25092":102759,"_2540":103102},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3034":61694,"_26479":61563,"_18432":103104,"_5":12632,"_25092":102763,"_2540":103105},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3034":61695,"_26479":61563,"_18432":103107,"_5":12632,"_25092":102767,"_2540":103108},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3034":61696,"_26479":61563,"_18432":103110,"_5":12632,"_25092":102771,"_2540":103111},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3034":61697,"_26479":61563,"_18432":103113,"_5":12632,"_25092":102771,"_2540":103114},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3034":61698,"_26479":61563,"_18432":103116,"_5":12632,"_25092":102775,"_2540":103117},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3034":61699,"_26479":61563,"_18432":103119,"_5":12632,"_25092":102775,"_2540":103120},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3034":61700,"_26479":61563,"_18432":103122,"_5":12632,"_25092":102775,"_2540":103123},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3034":61701,"_26479":61563,"_18432":103125,"_5":12632,"_25092":102775,"_2540":103126},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3034":61702,"_26479":61563,"_18432":103128,"_5":12632,"_25092":102775,"_2540":103129},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3034":61703,"_26479":61563,"_18432":103131,"_5":12632,"_25092":102775,"_2540":103132},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3034":61704,"_26479":61563,"_18432":103134,"_5":12632,"_25092":102775,"_2540":103135},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3034":61705,"_26479":61563,"_18432":103137,"_5":12632,"_25092":102775,"_2540":103138},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3034":61706,"_26479":61563,"_18432":103140,"_5":12632,"_25092":102779,"_2540":103141},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3034":61707,"_26479":61563,"_18432":103143,"_5":12632,"_25092":102779,"_2540":103144},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3034":61708,"_26479":61563,"_18432":103146,"_5":12632,"_25092":102779,"_2540":103147},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3034":61709,"_26479":61563,"_18432":103149,"_5":12632,"_25092":102783,"_2540":103150},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3034":61710,"_26479":61563,"_18432":103152,"_5":12632,"_25092":102783,"_2540":103153},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3034":61711,"_26479":61563,"_18432":103155,"_5":12632,"_25092":102783,"_2540":103156},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3034":61712,"_26479":61563,"_18432":103158,"_5":12632,"_25092":102783,"_2540":103159},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3034":61713,"_26479":61563,"_18432":103161,"_5":12632,"_25092":102783,"_2540":103162},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3034":61714,"_26479":61563,"_18432":103164,"_5":12632,"_25092":102783,"_2540":103165},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3034":61715,"_26479":61563,"_18432":103167,"_5":12632,"_25092":102783,"_2540":103168},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3034":61716,"_26479":61563,"_18432":103170,"_5":12632,"_25092":102783,"_2540":103171},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3034":61717,"_26479":61563,"_18432":103173,"_5":12632,"_25092":102791,"_2540":103174},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3034":61718,"_26479":61563,"_18432":103176,"_5":12632,"_25092":102795,"_2540":103177},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3034":61719,"_26479":61563,"_18432":103179,"_5":12632,"_25092":102795,"_2540":103180},[],"que exista un principal activo del tipo correcto;",{"_3034":61720,"_26479":61563,"_18432":103182,"_5":12632,"_25092":102795,"_2540":103183},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3034":61721,"_26479":61563,"_18432":103185,"_5":12632,"_25092":102795,"_2540":103186},[],"que todas las condiciones del principal se cumplan;",{"_3034":61722,"_26479":61563,"_18432":103188,"_5":12632,"_25092":102795,"_2540":103189},[],"que el principal tenga concedida la política esperada;",{"_3034":61723,"_26479":61563,"_18432":103191,"_5":12632,"_25092":102795,"_2540":103192},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3034":61724,"_26479":61563,"_18432":103194,"_5":12632,"_25092":102795,"_2540":103195},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3034":61725,"_26479":61563,"_18432":103197,"_5":12632,"_25092":102795,"_2540":103198},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_3034":61726,"_26479":61563,"_18432":103200,"_5":12632,"_25092":102799,"_2540":103201},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3034":61727,"_26479":61563,"_18432":103203,"_5":12632,"_25092":102803,"_2540":103204},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3034":61728,"_26479":61563,"_18432":103206,"_5":12632,"_25092":102807,"_2540":103207},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3034":61729,"_26479":61563,"_18432":103209,"_5":12632,"_25092":102807,"_2540":103210},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3034":61730,"_26479":61730,"_5":12947,"_2540":103212,"_26823":103213,"_18432":103214,"_25092":61730},"Alertas y suscripciones",[43109,102680,102681],[],{"_3034":61731,"_26479":61730,"_18432":103216,"_5":12632,"_25092":61730,"_2540":103217},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3034":61732,"_26479":61730,"_5":26820,"_18432":103219,"_25092":103220,"_2540":103221},[],"/docs/pr-preview/pr-47/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3034":61733,"_26479":61730,"_5":26820,"_18432":103223,"_25092":103224,"_2540":103225},[],"/docs/pr-preview/pr-47/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3034":61734,"_26479":61730,"_5":26820,"_18432":103227,"_25092":103228,"_2540":103229},[],"/docs/pr-preview/pr-47/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3034":61735,"_26479":61730,"_5":26820,"_18432":103231,"_25092":103232,"_2540":103233},[],"/docs/pr-preview/pr-47/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3034":61736,"_26479":61730,"_5":26820,"_18432":103235,"_25092":103236,"_2540":103237},[],"/docs/pr-preview/pr-47/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3034":61737,"_26479":61730,"_5":26820,"_18432":103239,"_25092":103240,"_2540":103241},[],"/docs/pr-preview/pr-47/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3034":61738,"_26479":61730,"_5":26820,"_18432":103243,"_25092":103244,"_2540":103245},[],"/docs/pr-preview/pr-47/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3034":61739,"_26479":61730,"_5":26820,"_18432":103247,"_25092":103248,"_2540":103249},[],"/docs/pr-preview/pr-47/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3034":61740,"_26479":61730,"_5":26820,"_18432":103251,"_25092":103252,"_2540":103253},[],"/docs/pr-preview/pr-47/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3034":61741,"_26479":61730,"_5":26820,"_18432":103255,"_25092":103256,"_2540":103257},[],"/docs/pr-preview/pr-47/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3034":61742,"_26479":61730,"_18432":103259,"_5":12632,"_25092":61730,"_2540":103260},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3034":61743,"_26479":61730,"_18432":103262,"_5":12632,"_25092":103220,"_2540":103263},[],"Un servicio publica un evento de dominio.",{"_3034":61744,"_26479":61730,"_18432":103265,"_5":12632,"_25092":103220,"_2540":103266},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3034":61745,"_26479":61730,"_18432":103268,"_5":12632,"_25092":103220,"_2540":103269},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3034":61746,"_26479":61730,"_18432":103271,"_5":12632,"_25092":103220,"_2540":103272},[],"Lamassu entrega el evento al canal configurado.",{"_3034":61747,"_26479":61730,"_18432":103274,"_5":12632,"_25092":103220,"_2540":103275},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3034":61748,"_26479":61730,"_18432":103277,"_5":12632,"_25092":103224,"_2540":103278},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3034":61749,"_26479":61730,"_18432":103280,"_5":12632,"_25092":103224,"_2540":103281},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3034":61750,"_26479":61730,"_18432":103283,"_5":12632,"_25092":103224,"_2540":103284},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3034":61751,"_26479":61730,"_18432":103286,"_5":12632,"_25092":103224,"_2540":103287},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3034":61752,"_26479":61730,"_18432":103289,"_5":12632,"_25092":103224,"_2540":103290},[],"`apikey_options` necesita `header` y `key`.",{"_3034":61753,"_26479":61730,"_18432":103292,"_5":12632,"_25092":103224,"_2540":103293},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3034":61754,"_26479":61730,"_18432":103295,"_5":12632,"_25092":103224,"_2540":103296},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3034":61755,"_26479":61730,"_18432":103298,"_5":12632,"_25092":103224,"_2540":103299},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3034":61756,"_26479":61730,"_18432":103301,"_5":12632,"_25092":103232,"_2540":103302},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3034":61757,"_26479":61730,"_18432":103304,"_5":12632,"_25092":103236,"_2540":103305},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3034":61758,"_26479":61730,"_18432":103307,"_5":12632,"_25092":103240,"_2540":103308},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3034":61759,"_26479":61730,"_18432":103310,"_5":12632,"_25092":103240,"_2540":103311},[],"**None** notifica todas las instancias del evento.",{"_3034":61760,"_26479":61730,"_18432":103313,"_5":12632,"_25092":103240,"_2540":103314},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3034":61761,"_26479":61730,"_18432":103316,"_5":12632,"_25092":103240,"_2540":103317},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3034":61762,"_26479":61730,"_18432":103319,"_5":12632,"_25092":103240,"_2540":103320},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3034":61763,"_26479":61730,"_18432":103322,"_5":12632,"_25092":103240,"_2540":103323},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3034":61764,"_26479":61730,"_18432":103325,"_5":12632,"_25092":103244,"_2540":103326},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3034":61765,"_26479":61730,"_18432":103328,"_5":12632,"_25092":103248,"_2540":103329},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3034":61766,"_26479":61730,"_18432":103331,"_5":12632,"_25092":103248,"_2540":103332},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3034":61767,"_26479":61730,"_18432":103334,"_5":12632,"_25092":103248,"_2540":103335},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3034":61768,"_26479":61730,"_18432":103337,"_5":12632,"_25092":103248,"_2540":103338},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3034":61769,"_26479":61730,"_18432":103340,"_5":12632,"_25092":103248,"_2540":103341},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3034":61770,"_26479":61730,"_18432":103343,"_5":12632,"_25092":103248,"_2540":103344},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3034":61771,"_26479":61730,"_18432":103346,"_5":12632,"_25092":103248,"_2540":103347},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3034":61772,"_26479":61730,"_18432":103349,"_5":12632,"_25092":103248,"_2540":103350},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3034":61773,"_26479":61730,"_18432":103352,"_5":12632,"_25092":103252,"_2540":103353},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3034":61774,"_26479":61730,"_18432":103355,"_5":12632,"_25092":103256,"_2540":103356},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3034":61775,"_26479":61730,"_18432":103358,"_5":12632,"_25092":103256,"_2540":103359},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3034":61776,"_26479":61730,"_18432":103361,"_5":12632,"_25092":103256,"_2540":103362},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3034":61777,"_26479":61730,"_18432":103364,"_5":12632,"_25092":103256,"_2540":103365},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3034":61778,"_26479":61730,"_18432":103367,"_5":12632,"_25092":103256,"_2540":103368},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3034":61779,"_26479":61730,"_18432":103370,"_5":12632,"_25092":103256,"_2540":103371},[],"**Validación:** `va.role.crl.create`.",{"_3034":61780,"_26479":61730,"_18432":103373,"_5":12632,"_25092":103256,"_2540":103374},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3034":61781,"_26479":61730,"_18432":103376,"_5":12632,"_25092":103256,"_2540":103377},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3034":61782,"_26479":61782,"_5":12947,"_2540":103379,"_26823":103380,"_18432":103381,"_25092":61782},"Registros de auditoría",[43109,102680,102681],[],{"_3034":61783,"_26479":61782,"_18432":103383,"_5":12632,"_25092":61782,"_2540":103384},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3034":61784,"_26479":61782,"_5":26820,"_18432":103386,"_25092":103387,"_2540":103388},[],"/docs/pr-preview/pr-47/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3034":61785,"_26479":61782,"_5":26820,"_18432":103390,"_25092":103391,"_2540":103392},[],"/docs/pr-preview/pr-47/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3034":61786,"_26479":61782,"_5":26820,"_18432":103394,"_25092":103395,"_2540":103396},[],"/docs/pr-preview/pr-47/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3034":61787,"_26479":61782,"_5":26820,"_18432":103398,"_25092":103399,"_2540":103400},[],"/docs/pr-preview/pr-47/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3034":61788,"_26479":61782,"_5":26820,"_18432":103402,"_25092":103403,"_2540":103404},[],"/docs/pr-preview/pr-47/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3034":61789,"_26479":61782,"_5":26820,"_18432":103406,"_25092":103407,"_2540":103408},[],"/docs/pr-preview/pr-47/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3034":61790,"_26479":61782,"_5":26820,"_18432":103410,"_25092":103411,"_2540":103412},[],"/docs/pr-preview/pr-47/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3034":61791,"_26479":61782,"_5":26820,"_18432":103414,"_25092":103415,"_2540":103416},[],"/docs/pr-preview/pr-47/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3034":61792,"_26479":61782,"_5":26820,"_18432":103418,"_25092":103419,"_2540":103420},[],"/docs/pr-preview/pr-47/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3034":61793,"_26479":61782,"_5":26820,"_18432":103422,"_25092":103423,"_2540":103424},[],"/docs/pr-preview/pr-47/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3034":61794,"_26479":61782,"_5":26820,"_18432":103426,"_25092":103427,"_2540":103428},[],"/docs/pr-preview/pr-47/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3034":61795,"_26479":61782,"_18432":103430,"_5":12632,"_25092":61782,"_2540":103431},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3034":61796,"_26479":61782,"_18432":103433,"_5":12632,"_25092":103387,"_2540":103434},[],"El cuerpo de auditoría incluye:",{"_3034":61797,"_26479":61782,"_18432":103436,"_5":12632,"_25092":103387,"_2540":103437},[],"input: datos recibidos por la operación;",{"_3034":61798,"_26479":61782,"_18432":103439,"_5":12632,"_25092":103387,"_2540":103440},[],"has\\_error: indica si el servicio devolvió un error;",{"_3034":61799,"_26479":61782,"_18432":103442,"_5":12632,"_25092":103387,"_2540":103443},[],"output: resultado producido o mensaje de error;",{"_3034":61800,"_26479":61782,"_18432":103445,"_5":12632,"_25092":103387,"_2540":103446},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3034":61801,"_26479":61782,"_18432":103448,"_5":12632,"_25092":103387,"_2540":103449},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3034":61802,"_26479":61782,"_18432":103451,"_5":12632,"_25092":103387,"_2540":103452},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3034":61803,"_26479":61782,"_18432":103454,"_5":12632,"_25092":103391,"_2540":103455},[],"El backend aplica auditoría a mutaciones de:",{"_3034":61804,"_26479":61782,"_18432":103457,"_5":12632,"_25092":103391,"_2540":103458},[],"autoridades, certificados y perfiles de emisión;",{"_3034":61805,"_26479":61782,"_18432":103460,"_5":12632,"_25092":103391,"_2540":103461},[],"claves y motores KMS;",{"_3034":61806,"_26479":61782,"_18432":103463,"_5":12632,"_25092":103391,"_2540":103464},[],"dispositivos e identidades;",{"_3034":61807,"_26479":61782,"_18432":103466,"_5":12632,"_25092":103391,"_2540":103467},[],"DMS y operaciones de enrolamiento;",{"_3034":61808,"_26479":61782,"_18432":103469,"_5":12632,"_25092":103391,"_2540":103470},[],"funciones de validación y CRL;",{"_3034":61809,"_26479":61782,"_18432":103472,"_5":12632,"_25092":103391,"_2540":103473},[],"principales, políticas y concesiones de autorización.",{"_3034":61810,"_26479":61782,"_18432":103475,"_5":12632,"_25092":103391,"_2540":103476},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3034":61811,"_26479":61782,"_18432":103478,"_5":12632,"_25092":103395,"_2540":103479},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3034":61812,"_26479":61782,"_18432":103481,"_5":12632,"_25092":103395,"_2540":103482},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3034":61813,"_26479":61782,"_18432":103484,"_5":12632,"_25092":103395,"_2540":103485},[],"Diseña el consumidor para:",{"_3034":61814,"_26479":61782,"_18432":103487,"_5":12632,"_25092":103395,"_2540":103488},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3034":61815,"_26479":61782,"_18432":103490,"_5":12632,"_25092":103395,"_2540":103491},[],"conservar el CloudEvent completo sin modificar;",{"_3034":61816,"_26479":61782,"_18432":103493,"_5":12632,"_25092":103395,"_2540":103494},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3034":61817,"_26479":61782,"_18432":103496,"_5":12632,"_25092":103395,"_2540":103497},[],"cifrar en tránsito y en reposo;",{"_3034":61818,"_26479":61782,"_18432":103499,"_5":12632,"_25092":103395,"_2540":103500},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3034":61819,"_26479":61782,"_18432":103502,"_5":12632,"_25092":103395,"_2540":103503},[],"aplicar una política explícita de retención y legal hold;",{"_3034":61820,"_26479":61782,"_18432":103505,"_5":12632,"_25092":103395,"_2540":103506},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3034":61821,"_26479":61782,"_18432":103508,"_5":12632,"_25092":103399,"_2540":103509},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3034":61822,"_26479":61782,"_18432":103511,"_5":12632,"_25092":103399,"_2540":103512},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3034":61823,"_26479":61782,"_18432":103514,"_5":12632,"_25092":103407,"_2540":103515},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3034":61824,"_26479":61782,"_18432":103517,"_5":12632,"_25092":103411,"_2540":103518},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3034":61825,"_26479":61782,"_18432":103520,"_5":12632,"_25092":103415,"_2540":103521},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3034":61826,"_26479":61782,"_18432":103523,"_5":12632,"_25092":103419,"_2540":103524},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3034":61827,"_26479":61782,"_18432":103526,"_5":12632,"_25092":103423,"_2540":103527},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3034":61828,"_26479":61782,"_18432":103529,"_5":12632,"_25092":103427,"_2540":103530},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3034":61829,"_26479":61782,"_18432":103532,"_5":12632,"_25092":103427,"_2540":103533},[],"aparece un evento de auditoría correcto;",{"_3034":61830,"_26479":61782,"_18432":103535,"_5":12632,"_25092":103427,"_2540":103536},[],"el principal coincide con la identidad utilizada;",{"_3034":61831,"_26479":61782,"_18432":103538,"_5":12632,"_25092":103427,"_2540":103539},[],"el consumidor lo persiste una sola vez;",{"_3034":61832,"_26479":61782,"_18432":103541,"_5":12632,"_25092":103427,"_2540":103542},[],"puede recuperarse por recurso, actor y periodo;",{"_3034":61833,"_26479":61782,"_18432":103544,"_5":12632,"_25092":103427,"_2540":103545},[],"una interrupción del consumidor produce una alerta.",{"_3034":61834,"_26479":61782,"_18432":103547,"_5":12632,"_25092":103427,"_2540":103548},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3034":61835,"_26479":61835,"_5":12947,"_2540":103550,"_26823":103551,"_18432":103552,"_25092":61835},"Arquitectura de la plataforma",[43109,102680],[],{"_3034":61836,"_26479":61835,"_18432":103554,"_5":12632,"_25092":61835,"_2540":103555},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3034":61837,"_26479":61835,"_5":26820,"_18432":103557,"_25092":103558,"_2540":103559},[],"/docs/pr-preview/pr-47/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3034":61838,"_26479":61835,"_5":26820,"_18432":103561,"_25092":103562,"_2540":103563},[],"/docs/pr-preview/pr-47/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3034":61839,"_26479":61835,"_5":26820,"_18432":103565,"_25092":103566,"_2540":103567},[],"/docs/pr-preview/pr-47/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3034":61840,"_26479":61835,"_5":26820,"_18432":103569,"_25092":103570,"_2540":103571},[],"/docs/pr-preview/pr-47/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3034":61841,"_26479":61835,"_5":26820,"_18432":103573,"_25092":103574,"_2540":103575},[],"/docs/pr-preview/pr-47/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3034":61842,"_26479":61835,"_18432":103577,"_5":12632,"_25092":61835,"_2540":103578},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3034":61843,"_26479":61835,"_18432":103580,"_5":12632,"_25092":61835,"_2540":103581},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3034":61844,"_26479":61835,"_18432":103583,"_5":12632,"_25092":103558,"_2540":103584},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3034":61845,"_26479":61835,"_18432":103586,"_5":12632,"_25092":103562,"_2540":103587},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3034":61846,"_26479":61835,"_18432":103589,"_5":12632,"_25092":103566,"_2540":103590},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3034":61847,"_26479":61835,"_18432":103592,"_5":12632,"_25092":103570,"_2540":103593},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3034":61848,"_26479":61835,"_18432":103595,"_5":12632,"_25092":103574,"_2540":103596},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3034":61849,"_26479":61849,"_5":12947,"_2540":103598,"_26823":103599,"_18432":103600,"_25092":61849},"Cómo funciona Lamassu",[43109,102680],[],{"_3034":61850,"_26479":61849,"_18432":103602,"_5":12632,"_25092":61849,"_2540":103603},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3034":61851,"_26479":61849,"_5":26820,"_18432":103605,"_25092":103606,"_2540":103607},[],"/docs/pr-preview/pr-47/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3034":61852,"_26479":61849,"_5":26820,"_18432":103609,"_25092":103610,"_2540":103611},[],"/docs/pr-preview/pr-47/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3034":61853,"_26479":61849,"_18432":103613,"_5":12632,"_25092":61849,"_2540":103614},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3034":61854,"_26479":61849,"_18432":103616,"_5":12632,"_25092":103606,"_2540":103617},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3034":61855,"_26479":61849,"_18432":103619,"_5":12632,"_25092":103606,"_2540":103620},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3034":61856,"_26479":61849,"_18432":103622,"_5":12632,"_25092":103606,"_2540":103623},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3034":61857,"_26479":61849,"_18432":103625,"_5":12632,"_25092":103606,"_2540":103626},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3034":61858,"_26479":61849,"_18432":103628,"_5":12632,"_25092":103606,"_2540":103629},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3034":61859,"_26479":61849,"_18432":103631,"_5":12632,"_25092":103610,"_2540":103632},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3034":61860,"_26479":61849,"_18432":103634,"_5":12632,"_25092":103610,"_2540":103635},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3034":61861,"_26479":61849,"_18432":103637,"_5":12632,"_25092":103610,"_2540":103638},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3034":61862,"_26479":61849,"_18432":103640,"_5":12632,"_25092":103610,"_2540":103641},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3034":61863,"_26479":61849,"_18432":103643,"_5":12632,"_25092":103610,"_2540":103644},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3034":61864,"_26479":61849,"_18432":103646,"_5":12632,"_25092":103610,"_2540":103647},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3034":61865,"_26479":61849,"_18432":103649,"_5":12632,"_25092":103610,"_2540":103650},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3034":61866,"_26479":61866,"_5":12947,"_2540":103652,"_26823":103653,"_18432":103654,"_25092":61866},"Dispositivos e identidades",[43109,102680,45427,103652],[],{"_3034":61867,"_26479":61866,"_18432":103656,"_5":12632,"_25092":61866,"_2540":103657},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3034":61868,"_26479":61866,"_5":26820,"_18432":103659,"_25092":103660,"_2540":103661},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3034":61869,"_26479":61866,"_5":26820,"_18432":103663,"_25092":103664,"_2540":103665},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3034":61870,"_26479":61866,"_5":26820,"_18432":103667,"_25092":103668,"_2540":103669},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3034":61871,"_26479":61866,"_5":26820,"_18432":103671,"_25092":103672,"_2540":103673},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3034":61872,"_26479":61866,"_5":26820,"_18432":103675,"_25092":103676,"_2540":103677},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3034":61873,"_26479":61866,"_5":26820,"_18432":103679,"_25092":103680,"_2540":103681},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3034":61874,"_26479":61866,"_5":26820,"_18432":103683,"_25092":103684,"_2540":103685},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3034":61875,"_26479":61866,"_5":26820,"_18432":103687,"_25092":103688,"_2540":103689},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3034":61876,"_26479":61866,"_5":26820,"_18432":103691,"_25092":103692,"_2540":103693},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3034":61877,"_26479":61866,"_5":26820,"_18432":103695,"_25092":103696,"_2540":103697},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3034":61878,"_26479":61866,"_5":26820,"_18432":103699,"_25092":103700,"_2540":103701},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3034":61879,"_26479":61866,"_18432":103703,"_5":12632,"_25092":61866,"_2540":103704},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3034":61880,"_26479":61866,"_18432":103706,"_5":12632,"_25092":61866,"_2540":103707},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3034":61881,"_26479":61866,"_18432":103709,"_5":12632,"_25092":103660,"_2540":103710},[],"Vista operativa",{"_3034":61882,"_26479":61866,"_18432":103712,"_5":12632,"_25092":103660,"_2540":103713},[],"Interpretación",{"_3034":61883,"_26479":61866,"_18432":103715,"_5":12632,"_25092":103660,"_2540":45490},[],{"_3034":61884,"_26479":61866,"_18432":103717,"_5":12632,"_25092":103660,"_2540":103718},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3034":61885,"_26479":61866,"_18432":103720,"_5":12632,"_25092":103660,"_2540":45496},[],{"_3034":61886,"_26479":61866,"_18432":103722,"_5":12632,"_25092":103660,"_2540":103723},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3034":61887,"_26479":61866,"_18432":103725,"_5":12632,"_25092":103660,"_2540":45502},[],{"_3034":61888,"_26479":61866,"_18432":103727,"_5":12632,"_25092":103660,"_2540":103728},[],"La identidad está en la ventana operativa de renovación.",{"_3034":61889,"_26479":61866,"_18432":103730,"_5":12632,"_25092":103660,"_2540":45508},[],{"_3034":61890,"_26479":61866,"_18432":103732,"_5":12632,"_25092":103660,"_2540":103733},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3034":61891,"_26479":61866,"_18432":103735,"_5":12632,"_25092":103660,"_2540":45514},[],{"_3034":61892,"_26479":61866,"_18432":103737,"_5":12632,"_25092":103660,"_2540":103738},[],"La identidad ha vencido.",{"_3034":61893,"_26479":61866,"_18432":103740,"_5":12632,"_25092":103660,"_2540":45520},[],{"_3034":61894,"_26479":61866,"_18432":103742,"_5":12632,"_25092":103660,"_2540":103743},[],"La identidad está marcada como revocada.",{"_3034":61895,"_26479":61866,"_18432":103745,"_5":12632,"_25092":103660,"_2540":45526},[],{"_3034":61896,"_26479":61866,"_18432":103747,"_5":12632,"_25092":103660,"_2540":103748},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3034":61897,"_26479":61866,"_18432":103750,"_5":12632,"_25092":103660,"_2540":103751},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3034":61898,"_26479":61866,"_18432":103753,"_5":12632,"_25092":103664,"_2540":103754},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3034":61899,"_26479":61866,"_18432":103756,"_5":12632,"_25092":103664,"_2540":103757},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3034":61900,"_26479":61866,"_18432":103759,"_5":12632,"_25092":103664,"_2540":103760},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3034":61901,"_26479":61866,"_18432":103762,"_5":12632,"_25092":103664,"_2540":103763},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3034":61902,"_26479":61866,"_18432":103765,"_5":12632,"_25092":103668,"_2540":103766},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3034":61903,"_26479":61866,"_18432":103768,"_5":12632,"_25092":103672,"_2540":103769},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3034":61904,"_26479":61866,"_18432":103771,"_5":12632,"_25092":103676,"_2540":103772},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3034":61905,"_26479":61866,"_18432":103774,"_5":12632,"_25092":103680,"_2540":103775},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3034":61906,"_26479":61866,"_18432":103777,"_5":12632,"_25092":103684,"_2540":103778},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3034":61907,"_26479":61866,"_18432":103780,"_5":12632,"_25092":103684,"_2540":103781},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3034":61908,"_26479":61866,"_18432":103783,"_5":12632,"_25092":103688,"_2540":103784},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3034":61909,"_26479":61866,"_18432":103786,"_5":12632,"_25092":103688,"_2540":103787},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3034":61910,"_26479":61866,"_18432":103789,"_5":12632,"_25092":103688,"_2540":103790},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3034":61911,"_26479":61866,"_18432":103792,"_5":12632,"_25092":103688,"_2540":103793},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3034":61912,"_26479":61866,"_18432":103795,"_5":12632,"_25092":103688,"_2540":103796},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3034":61913,"_26479":61866,"_18432":103798,"_5":12632,"_25092":103688,"_2540":103799},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3034":61914,"_26479":61866,"_18432":103801,"_5":12632,"_25092":103692,"_2540":103802},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3034":61915,"_26479":61866,"_18432":103804,"_5":12632,"_25092":103692,"_2540":103805},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3034":61916,"_26479":61866,"_18432":103807,"_5":12632,"_25092":103696,"_2540":103808},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3034":61917,"_26479":61866,"_18432":103810,"_5":12632,"_25092":103696,"_2540":103811},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3034":61918,"_26479":61866,"_18432":103813,"_5":12632,"_25092":103696,"_2540":103814},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3034":61919,"_26479":61866,"_18432":103816,"_5":12632,"_25092":103696,"_2540":103817},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3034":61920,"_26479":61866,"_18432":103819,"_5":12632,"_25092":103700,"_2540":103820},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3034":61921,"_26479":61866,"_18432":103822,"_5":12632,"_25092":103700,"_2540":103823},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3034":61922,"_26479":61922,"_5":12947,"_2540":103825,"_26823":103826,"_18432":103828,"_25092":61922},"Identidad inicial y autenticación",[43109,102680,45427,103652,103827],"Enrolamiento con PKI",[],{"_3034":61923,"_26479":61922,"_18432":103830,"_5":12632,"_25092":61922,"_2540":103831},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3034":61924,"_26479":61922,"_5":26820,"_18432":103833,"_25092":103834,"_2540":103835},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3034":61925,"_26479":61922,"_5":26820,"_18432":103837,"_25092":103838,"_2540":103839},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3034":61926,"_26479":61922,"_5":26820,"_18432":103841,"_25092":103842,"_2540":103843},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3034":61927,"_26479":61922,"_5":26820,"_18432":103845,"_25092":103846,"_2540":103847},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3034":61928,"_26479":61922,"_5":26820,"_18432":103849,"_25092":103850,"_2540":103851},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3034":61929,"_26479":61922,"_18432":103853,"_5":12632,"_25092":61922,"_2540":103854},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3034":61930,"_26479":61922,"_18432":103856,"_5":12632,"_25092":103834,"_2540":103857},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3034":61931,"_26479":61922,"_18432":103859,"_5":12632,"_25092":103834,"_2540":103860},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3034":61932,"_26479":61922,"_18432":103862,"_5":12632,"_25092":103838,"_2540":103863},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3034":61933,"_26479":61922,"_18432":103865,"_5":12632,"_25092":103838,"_2540":103866},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3034":61934,"_26479":61922,"_18432":103868,"_5":12632,"_25092":103838,"_2540":103869},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3034":61935,"_26479":61922,"_18432":103871,"_5":12632,"_25092":103842,"_2540":103872},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3034":61936,"_26479":61922,"_18432":103874,"_5":12632,"_25092":103842,"_2540":103875},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3034":61937,"_26479":61922,"_18432":103877,"_5":12632,"_25092":103846,"_2540":103878},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3034":61938,"_26479":61922,"_18432":103880,"_5":12632,"_25092":103846,"_2540":103881},[],"Ejemplo de cuerpo:",{"_3034":61939,"_26479":61922,"_18432":103883,"_5":12632,"_25092":103846,"_2540":103884},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3034":61940,"_26479":61922,"_18432":103886,"_5":12632,"_25092":103846,"_2540":103887},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3034":61941,"_26479":61922,"_18432":103889,"_5":12632,"_25092":103846,"_2540":103890},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3034":61942,"_26479":61922,"_18432":103892,"_5":12632,"_25092":103846,"_2540":103893},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3034":61943,"_26479":61922,"_18432":103895,"_5":12632,"_25092":103850,"_2540":103896},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3034":61944,"_26479":61922,"_18432":103898,"_5":12632,"_25092":103850,"_2540":103899},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3034":61945,"_26479":61945,"_5":12947,"_2540":103901,"_26823":103902,"_18432":103903,"_25092":61945},"Configura y opera el DMS",[43109,102680,45427,103652,103827],[],{"_3034":61946,"_26479":61945,"_18432":103905,"_5":12632,"_25092":61945,"_2540":103906},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3034":61947,"_26479":61945,"_5":26820,"_18432":103908,"_25092":103909,"_2540":101381},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3034":61948,"_26479":61945,"_5":26820,"_18432":103911,"_25092":103912,"_2540":103913},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3034":61949,"_26479":61945,"_5":26820,"_18432":103915,"_25092":103916,"_2540":103917},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3034":61950,"_26479":61945,"_5":26820,"_18432":103919,"_25092":103920,"_2540":103921},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3034":61951,"_26479":61945,"_5":26820,"_18432":103923,"_25092":103924,"_2540":103925},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3034":61952,"_26479":61945,"_5":26820,"_18432":103927,"_25092":103928,"_2540":103929},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3034":61953,"_26479":61945,"_5":26820,"_18432":103931,"_25092":103932,"_2540":103933},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3034":61954,"_26479":61945,"_5":26820,"_18432":103935,"_25092":103936,"_2540":103937},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3034":61955,"_26479":61945,"_5":26820,"_18432":103939,"_25092":103940,"_2540":45722},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3034":61956,"_26479":61945,"_5":26820,"_18432":103942,"_25092":103943,"_2540":45726},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3034":61957,"_26479":61945,"_5":26820,"_18432":103945,"_25092":103946,"_2540":103947},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3034":61958,"_26479":61945,"_5":26820,"_18432":103949,"_25092":103950,"_2540":103951},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3034":61959,"_26479":61945,"_5":26820,"_18432":103953,"_25092":103954,"_2540":103955},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3034":61960,"_26479":61945,"_5":26820,"_18432":103957,"_25092":103958,"_2540":103959},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3034":61961,"_26479":61945,"_5":26820,"_18432":103961,"_25092":103962,"_2540":45746},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3034":61962,"_26479":61945,"_5":26820,"_18432":103964,"_25092":103965,"_2540":103966},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3034":61963,"_26479":61945,"_5":26820,"_18432":103968,"_25092":103969,"_2540":103970},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3034":61964,"_26479":61945,"_5":26820,"_18432":103972,"_25092":103973,"_2540":103974},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3034":61965,"_26479":61945,"_18432":103976,"_5":12632,"_25092":61945,"_2540":103977},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3034":61966,"_26479":61945,"_18432":103979,"_5":12632,"_25092":103909,"_2540":103980},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3034":61967,"_26479":61945,"_18432":103982,"_5":12632,"_25092":103909,"_2540":103983},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3034":61968,"_26479":61945,"_18432":103985,"_5":12632,"_25092":103916,"_2540":103986},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3034":61969,"_26479":61945,"_18432":103988,"_5":12632,"_25092":103920,"_2540":103989},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3034":61970,"_26479":61945,"_18432":103991,"_5":12632,"_25092":103924,"_2540":103992},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3034":61971,"_26479":61945,"_18432":103994,"_5":12632,"_25092":103928,"_2540":103995},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3034":61972,"_26479":61945,"_18432":103997,"_5":12632,"_25092":103932,"_2540":103998},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3034":61973,"_26479":61945,"_18432":104000,"_5":12632,"_25092":103940,"_2540":104001},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3034":61974,"_26479":61945,"_18432":104003,"_5":12632,"_25092":103940,"_2540":104004},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3034":61975,"_26479":61945,"_18432":104006,"_5":12632,"_25092":103943,"_2540":104007},[],"Campo de `settings.enrollment_settings`",{"_3034":61976,"_26479":61945,"_18432":104009,"_5":12632,"_25092":103943,"_2540":104010},[],"Decisión",{"_3034":61977,"_26479":61945,"_18432":104012,"_5":12632,"_25092":103943,"_2540":45797},[],{"_3034":61978,"_26479":61945,"_18432":104014,"_5":12632,"_25092":103943,"_2540":104015},[],"`EST_RFC7030` para estas operaciones.",{"_3034":61979,"_26479":61945,"_18432":104017,"_5":12632,"_25092":103943,"_2540":45803},[],{"_3034":61980,"_26479":61945,"_18432":104019,"_5":12632,"_25092":103943,"_2540":104020},[],"ID de la CA que firmará.",{"_3034":61981,"_26479":61945,"_18432":104022,"_5":12632,"_25092":103943,"_2540":45809},[],{"_3034":61982,"_26479":61945,"_18432":104024,"_5":12632,"_25092":103943,"_2540":104025},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3034":61983,"_26479":61945,"_18432":104027,"_5":12632,"_25092":103943,"_2540":45815},[],{"_3034":61984,"_26479":61945,"_18432":104029,"_5":12632,"_25092":103943,"_2540":104030},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3034":61985,"_26479":61945,"_18432":104032,"_5":12632,"_25092":103943,"_2540":45821},[],{"_3034":61986,"_26479":61945,"_18432":104034,"_5":12632,"_25092":103943,"_2540":104035},[],"Uno de los cuatro modos de autenticación.",{"_3034":61987,"_26479":61945,"_18432":104037,"_5":12632,"_25092":103943,"_2540":104038},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3034":61988,"_26479":61945,"_18432":104040,"_5":12632,"_25092":103946,"_2540":104041},[],"Los bloques son independientes:",{"_3034":61989,"_26479":61945,"_18432":104043,"_5":12632,"_25092":103946,"_2540":104044},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3034":61990,"_26479":61945,"_18432":104046,"_5":12632,"_25092":103946,"_2540":104047},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3034":61991,"_26479":61945,"_18432":104049,"_5":12632,"_25092":103946,"_2540":45839},[],{"_3034":61992,"_26479":61945,"_18432":104051,"_5":12632,"_25092":103946,"_2540":104052},[],"Control aplicado en la operación configurada",{"_3034":61993,"_26479":61945,"_18432":104054,"_5":12632,"_25092":103946,"_2540":45845},[],{"_3034":61994,"_26479":61945,"_18432":104056,"_5":12632,"_25092":103946,"_2540":104057},[],"Validación del certificado presentado.",{"_3034":61995,"_26479":61945,"_18432":104059,"_5":12632,"_25092":103946,"_2540":45851},[],{"_3034":61996,"_26479":61945,"_18432":104061,"_5":12632,"_25092":103946,"_2540":104062},[],"Autorización del webhook configurado.",{"_3034":61997,"_26479":61945,"_18432":104064,"_5":12632,"_25092":103946,"_2540":45857},[],{"_3034":61998,"_26479":61945,"_18432":104066,"_5":12632,"_25092":103946,"_2540":104067},[],"Validación del certificado y, después, aprobación del webhook.",{"_3034":61999,"_26479":61945,"_18432":104069,"_5":12632,"_25092":103946,"_2540":45863},[],{"_3034":62000,"_26479":61945,"_18432":104071,"_5":12632,"_25092":103946,"_2540":104072},[],"Sin autenticación del solicitante por el DMS.",{"_3034":62001,"_26479":61945,"_18432":104074,"_5":12632,"_25092":103946,"_2540":104075},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3034":62002,"_26479":61945,"_18432":104077,"_5":12632,"_25092":103946,"_2540":104078},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3034":62003,"_26479":61945,"_18432":104080,"_5":12632,"_25092":103946,"_2540":104081},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3034":62004,"_26479":61945,"_18432":104083,"_5":12632,"_25092":103946,"_2540":104084},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3034":62005,"_26479":61945,"_18432":104086,"_5":12632,"_25092":103950,"_2540":104087},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3034":62006,"_26479":61945,"_18432":104089,"_5":12632,"_25092":103950,"_2540":104090},[],"Campo de `external_webhook_settings`",{"_3034":62007,"_26479":61945,"_18432":104092,"_5":12632,"_25092":103950,"_2540":104010},[],{"_3034":62008,"_26479":61945,"_18432":104094,"_5":12632,"_25092":103950,"_2540":45889},[],{"_3034":62009,"_26479":61945,"_18432":104096,"_5":12632,"_25092":103950,"_2540":104097},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3034":62010,"_26479":61945,"_18432":104099,"_5":12632,"_25092":103950,"_2540":45895},[],{"_3034":62011,"_26479":61945,"_18432":104101,"_5":12632,"_25092":103950,"_2540":104102},[],"`POST` o `PUT`; `POST` por defecto.",{"_3034":62012,"_26479":61945,"_18432":104104,"_5":12632,"_25092":103950,"_2540":45901},[],{"_3034":62013,"_26479":61945,"_18432":104106,"_5":12632,"_25092":103950,"_2540":104107},[],"Etiqueta usada en los logs del servicio.",{"_3034":62014,"_26479":61945,"_18432":104109,"_5":12632,"_25092":103950,"_2540":45907},[],{"_3034":62015,"_26479":61945,"_18432":104111,"_5":12632,"_25092":103950,"_2540":104112},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3034":62016,"_26479":61945,"_18432":104114,"_5":12632,"_25092":103950,"_2540":45913},[],{"_3034":62017,"_26479":61945,"_18432":104116,"_5":12632,"_25092":103950,"_2540":104117},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3034":62018,"_26479":61945,"_18432":104119,"_5":12632,"_25092":103950,"_2540":45919},[],{"_3034":62019,"_26479":61945,"_18432":104121,"_5":12632,"_25092":103950,"_2540":104122},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3034":62020,"_26479":61945,"_18432":104124,"_5":12632,"_25092":103950,"_2540":45925},[],{"_3034":62021,"_26479":61945,"_18432":104126,"_5":12632,"_25092":103950,"_2540":104127},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3034":62022,"_26479":61945,"_18432":104129,"_5":12632,"_25092":103950,"_2540":45931},[],{"_3034":62023,"_26479":61945,"_18432":104131,"_5":12632,"_25092":103950,"_2540":104132},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3034":62024,"_26479":61945,"_18432":104134,"_5":12632,"_25092":103950,"_2540":45937},[],{"_3034":62025,"_26479":61945,"_18432":104136,"_5":12632,"_25092":103950,"_2540":104137},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3034":62026,"_26479":61945,"_18432":104139,"_5":12632,"_25092":103950,"_2540":104140},[],"Reglas de esa configuración:",{"_3034":62027,"_26479":61945,"_18432":104142,"_5":12632,"_25092":103950,"_2540":104143},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3034":62028,"_26479":61945,"_18432":104145,"_5":12632,"_25092":103950,"_2540":104146},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3034":62029,"_26479":61945,"_18432":104148,"_5":12632,"_25092":103950,"_2540":104149},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3034":62030,"_26479":61945,"_18432":104151,"_5":12632,"_25092":103950,"_2540":104152},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3034":62031,"_26479":61945,"_18432":104154,"_5":12632,"_25092":103950,"_2540":104155},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3034":62032,"_26479":61945,"_18432":104157,"_5":12632,"_25092":103950,"_2540":104158},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3034":62033,"_26479":61945,"_18432":104160,"_5":12632,"_25092":103950,"_2540":104161},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar, y si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_3034":62034,"_26479":61945,"_18432":104163,"_5":12632,"_25092":103950,"_2540":104164},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3034":62035,"_26479":61945,"_18432":104166,"_5":12632,"_25092":103950,"_2540":104167},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3034":62036,"_26479":61945,"_18432":104169,"_5":12632,"_25092":103954,"_2540":104170},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3034":62037,"_26479":61945,"_18432":104172,"_5":12632,"_25092":103958,"_2540":104173},[],"Campo de `settings.reenrollment_settings`",{"_3034":62038,"_26479":61945,"_18432":104175,"_5":12632,"_25092":103958,"_2540":104176},[],"Función",{"_3034":62039,"_26479":61945,"_18432":104178,"_5":12632,"_25092":103958,"_2540":45981},[],{"_3034":62040,"_26479":61945,"_18432":104180,"_5":12632,"_25092":103958,"_2540":104181},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3034":62041,"_26479":61945,"_18432":104183,"_5":12632,"_25092":103958,"_2540":45987},[],{"_3034":62042,"_26479":61945,"_18432":104185,"_5":12632,"_25092":103958,"_2540":104186},[],"Umbral operativo preventivo de monitorización.",{"_3034":62043,"_26479":61945,"_18432":104188,"_5":12632,"_25092":103958,"_2540":45993},[],{"_3034":62044,"_26479":61945,"_18432":104190,"_5":12632,"_25092":103958,"_2540":104191},[],"Umbral operativo crítico de monitorización.",{"_3034":62045,"_26479":61945,"_18432":104193,"_5":12632,"_25092":103958,"_2540":45999},[],{"_3034":62046,"_26479":61945,"_18432":104195,"_5":12632,"_25092":103958,"_2540":104196},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3034":62047,"_26479":61945,"_18432":104198,"_5":12632,"_25092":103958,"_2540":46005},[],{"_3034":62048,"_26479":61945,"_18432":104200,"_5":12632,"_25092":103958,"_2540":104201},[],"CAs de validación adicionales para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3034":62049,"_26479":61945,"_18432":104203,"_5":12632,"_25092":103958,"_2540":46011},[],{"_3034":62050,"_26479":61945,"_18432":104205,"_5":12632,"_25092":103958,"_2540":104206},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3034":62051,"_26479":61945,"_18432":104208,"_5":12632,"_25092":103958,"_2540":104209},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3034":62052,"_26479":61945,"_18432":104211,"_5":12632,"_25092":103962,"_2540":104212},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. Algoritmo y tamaño proceden de su campo `key`; el perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3034":62053,"_26479":61945,"_18432":104214,"_5":12632,"_25092":103965,"_2540":101738},[],{"_3034":62054,"_26479":61945,"_18432":104216,"_5":12632,"_25092":103965,"_2540":104217},[],"Qué publica",{"_3034":62055,"_26479":61945,"_18432":104219,"_5":12632,"_25092":103965,"_2540":46028},[],{"_3034":62056,"_26479":61945,"_18432":104221,"_5":12632,"_25092":103965,"_2540":104222},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3034":62057,"_26479":61945,"_18432":104224,"_5":12632,"_25092":103965,"_2540":46034},[],{"_3034":62058,"_26479":61945,"_18432":104226,"_5":12632,"_25092":103965,"_2540":104227},[],"Certificado de la CA emisora seleccionada.",{"_3034":62059,"_26479":61945,"_18432":104229,"_5":12632,"_25092":103965,"_2540":46040},[],{"_3034":62060,"_26479":61945,"_18432":104231,"_5":12632,"_25092":103965,"_2540":104232},[],"Certificados de las CAs elegidas explícitamente.",{"_3034":62061,"_26479":61945,"_18432":104234,"_5":12632,"_25092":103965,"_2540":104235},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3034":62062,"_26479":61945,"_18432":104237,"_5":12632,"_25092":103969,"_2540":104238},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_3034":62063,"_26479":61945,"_18432":104240,"_5":12632,"_25092":103969,"_2540":104241},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3034":62064,"_26479":61945,"_18432":104243,"_5":12632,"_25092":103969,"_2540":104244},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3034":62065,"_26479":61945,"_18432":104246,"_5":12632,"_25092":103973,"_2540":104247},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3034":62066,"_26479":62066,"_5":12947,"_2540":104249,"_26823":104250,"_18432":104251,"_25092":62066},"Integra el cliente EST",[43109,102680,45427,103652,103827],[],{"_3034":62067,"_26479":62066,"_18432":104253,"_5":12632,"_25092":62066,"_2540":104254},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3034":62068,"_26479":62066,"_5":26820,"_18432":104256,"_25092":104257,"_2540":101381},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3034":62069,"_26479":62066,"_5":26820,"_18432":104259,"_25092":104260,"_2540":104261},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3034":62070,"_26479":62066,"_5":26820,"_18432":104263,"_25092":104264,"_2540":104265},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3034":62071,"_26479":62066,"_5":26820,"_18432":104267,"_25092":104268,"_2540":104269},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3034":62072,"_26479":62066,"_5":26820,"_18432":104271,"_25092":104272,"_2540":104273},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3034":62073,"_26479":62066,"_5":26820,"_18432":104275,"_25092":104276,"_2540":104277},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3034":62074,"_26479":62066,"_18432":104279,"_5":12632,"_25092":62066,"_2540":104280},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3034":62075,"_26479":62066,"_18432":104282,"_5":12632,"_25092":104257,"_2540":104283},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3034":62076,"_26479":62066,"_18432":104285,"_5":12632,"_25092":104257,"_2540":104286},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3034":62077,"_26479":62066,"_18432":104288,"_5":12632,"_25092":104257,"_2540":104289},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3034":62078,"_26479":62066,"_18432":104291,"_5":12632,"_25092":104260,"_2540":104292},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3034":62079,"_26479":62066,"_18432":104294,"_5":12632,"_25092":104260,"_2540":104295},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3034":62080,"_26479":62066,"_18432":104297,"_5":12632,"_25092":104264,"_2540":104298},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3034":62081,"_26479":62066,"_18432":104300,"_5":12632,"_25092":104264,"_2540":104301},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3034":62082,"_26479":62066,"_18432":104303,"_5":12632,"_25092":104268,"_2540":104304},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3034":62083,"_26479":62066,"_18432":104306,"_5":12632,"_25092":104268,"_2540":104307},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3034":62084,"_26479":62066,"_18432":104309,"_5":12632,"_25092":104272,"_2540":104310},[],"Para el caso de una raíz que emite directamente:",{"_3034":62085,"_26479":62066,"_18432":104312,"_5":12632,"_25092":104272,"_2540":104313},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3034":62086,"_26479":62066,"_18432":104315,"_5":12632,"_25092":104272,"_2540":104316},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3034":62087,"_26479":62066,"_18432":104318,"_5":12632,"_25092":104276,"_2540":104319},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3034":62088,"_26479":62088,"_5":12947,"_2540":104321,"_26823":104322,"_18432":104323,"_25092":62088},"Referencia EST",[43109,102680,45427,103652,103827],[],{"_3034":62089,"_26479":62088,"_18432":104325,"_5":12632,"_25092":62088,"_2540":104326},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3034":62090,"_26479":62088,"_5":26820,"_18432":104328,"_25092":104329,"_2540":104330},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3034":62091,"_26479":62088,"_5":26820,"_18432":104332,"_25092":104333,"_2540":20065},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3034":62092,"_26479":62088,"_5":26820,"_18432":104335,"_25092":104336,"_2540":22984},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3034":62093,"_26479":62088,"_5":26820,"_18432":104338,"_25092":104339,"_2540":22991},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3034":62094,"_26479":62088,"_5":26820,"_18432":104341,"_25092":104342,"_2540":22345},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3034":62095,"_26479":62088,"_5":26820,"_18432":104344,"_25092":104345,"_2540":104346},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3034":62096,"_26479":62088,"_5":26820,"_18432":104348,"_25092":104349,"_2540":104350},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3034":62097,"_26479":62088,"_5":26820,"_18432":104352,"_25092":104353,"_2540":104354},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3034":62098,"_26479":62088,"_18432":104356,"_5":12632,"_25092":62088,"_2540":104357},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3034":62099,"_26479":62088,"_18432":104359,"_5":12632,"_25092":104329,"_2540":104360},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3034":62100,"_26479":62088,"_18432":104362,"_5":12632,"_25092":104329,"_2540":102471},[],{"_3034":62101,"_26479":62088,"_18432":104364,"_5":12632,"_25092":104329,"_2540":104365},[],"Método",{"_3034":62102,"_26479":62088,"_18432":104367,"_5":12632,"_25092":104329,"_2540":104368},[],"Autenticación y condición",{"_3034":62103,"_26479":62088,"_18432":104370,"_5":12632,"_25092":104329,"_2540":46183},[],{"_3034":62104,"_26479":62088,"_18432":104372,"_5":12632,"_25092":104329,"_2540":46186},[],{"_3034":62105,"_26479":62088,"_18432":104374,"_5":12632,"_25092":104329,"_2540":104375},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3034":62106,"_26479":62088,"_18432":104377,"_5":12632,"_25092":104329,"_2540":46192},[],{"_3034":62107,"_26479":62088,"_18432":104379,"_5":12632,"_25092":104329,"_2540":46195},[],{"_3034":62108,"_26479":62088,"_18432":104381,"_5":12632,"_25092":104329,"_2540":104382},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3034":62109,"_26479":62088,"_18432":104384,"_5":12632,"_25092":104329,"_2540":46201},[],{"_3034":62110,"_26479":62088,"_18432":104386,"_5":12632,"_25092":104329,"_2540":46195},[],{"_3034":62111,"_26479":62088,"_18432":104388,"_5":12632,"_25092":104329,"_2540":104389},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3034":62112,"_26479":62088,"_18432":104391,"_5":12632,"_25092":104329,"_2540":46209},[],{"_3034":62113,"_26479":62088,"_18432":104393,"_5":12632,"_25092":104329,"_2540":46195},[],{"_3034":62114,"_26479":62088,"_18432":104395,"_5":12632,"_25092":104329,"_2540":104396},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3034":62115,"_26479":62088,"_18432":104398,"_5":12632,"_25092":104329,"_2540":104399},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3034":62116,"_26479":62088,"_18432":104401,"_5":12632,"_25092":104333,"_2540":104402},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3034":62117,"_26479":62088,"_18432":104404,"_5":12632,"_25092":104333,"_2540":104405},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3034":62118,"_26479":62088,"_18432":104407,"_5":12632,"_25092":104336,"_2540":104408},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3034":62119,"_26479":62088,"_18432":104410,"_5":12632,"_25092":104336,"_2540":104411},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3034":62120,"_26479":62088,"_18432":104413,"_5":12632,"_25092":104339,"_2540":104414},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3034":62121,"_26479":62088,"_18432":104416,"_5":12632,"_25092":104339,"_2540":104417},[],"La CA de enrolamiento o una CA de validación configurada en el bloque de reenrolamiento valida la credencial en el modo mTLS. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3034":62122,"_26479":62088,"_18432":104419,"_5":12632,"_25092":104342,"_2540":104420},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3034":62123,"_26479":62088,"_18432":104422,"_5":12632,"_25092":104342,"_2540":104423},[],"El código admite RSA y ECDSA de 224, 256, 384 o 521 bits. Un tamaño ECDSA no reconocido puede producir fallback a 256; elige explícitamente un tamaño compatible y comprueba la clave resultante. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3034":62124,"_26479":62088,"_18432":104425,"_5":12632,"_25092":104345,"_2540":104426},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3034":62125,"_26479":62088,"_18432":104428,"_5":12632,"_25092":104345,"_2540":104429},[],"Parte",{"_3034":62126,"_26479":62088,"_18432":104431,"_5":12632,"_25092":104345,"_2540":104432},[],"Contenido tras decodificar su Base64",{"_3034":62127,"_26479":62088,"_18432":104434,"_5":12632,"_25092":104345,"_2540":46253},[],{"_3034":62128,"_26479":62088,"_18432":104436,"_5":12632,"_25092":104345,"_2540":104437},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3034":62129,"_26479":62088,"_18432":104439,"_5":12632,"_25092":104345,"_2540":46259},[],{"_3034":62130,"_26479":62088,"_18432":104441,"_5":12632,"_25092":104345,"_2540":104442},[],"PKCS#7 DER con el certificado emitido.",{"_3034":62131,"_26479":62088,"_18432":104444,"_5":12632,"_25092":104345,"_2540":104445},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3034":62132,"_26479":62088,"_18432":104447,"_5":12632,"_25092":104349,"_2540":104448},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3034":62133,"_26479":62088,"_18432":104450,"_5":12632,"_25092":104349,"_2540":104451},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3034":62134,"_26479":62088,"_18432":104453,"_5":12632,"_25092":104349,"_2540":104454},[],"Convierte y comprueba el resultado:",{"_3034":62135,"_26479":62088,"_18432":104456,"_5":12632,"_25092":104349,"_2540":104457},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3034":62136,"_26479":62088,"_18432":104459,"_5":12632,"_25092":104353,"_2540":104460},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3034":62137,"_26479":62088,"_18432":104462,"_5":12632,"_25092":104353,"_2540":104463},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3034":62138,"_26479":62138,"_5":12947,"_2540":103827,"_26823":104465,"_18432":104466,"_25092":62138},[43109,102680,45427,103652,103827],[],{"_3034":62139,"_26479":62138,"_18432":104468,"_5":12632,"_25092":62138,"_2540":104469},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3034":62140,"_26479":62138,"_5":26820,"_18432":104471,"_25092":104472,"_2540":104473},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3034":62141,"_26479":62138,"_5":26820,"_18432":104475,"_25092":104476,"_2540":104477},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3034":62142,"_26479":62138,"_5":26820,"_18432":104479,"_25092":104480,"_2540":104481},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3034":62143,"_26479":62138,"_5":26820,"_18432":104483,"_25092":104484,"_2540":104485},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3034":62144,"_26479":62138,"_18432":104487,"_5":12632,"_25092":62138,"_2540":104488},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3034":62145,"_26479":62138,"_18432":104490,"_5":12632,"_25092":104472,"_2540":104491},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3034":62146,"_26479":62138,"_18432":104493,"_5":12632,"_25092":104472,"_2540":104494},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3034":62147,"_26479":62138,"_18432":104496,"_5":12632,"_25092":104472,"_2540":104497},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3034":62148,"_26479":62138,"_18432":104499,"_5":12632,"_25092":104472,"_2540":104500},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3034":62149,"_26479":62138,"_18432":104502,"_5":12632,"_25092":104472,"_2540":104503},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3034":62150,"_26479":62138,"_18432":104505,"_5":12632,"_25092":104472,"_2540":104506},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3034":62151,"_26479":62138,"_18432":104508,"_5":12632,"_25092":104476,"_2540":104509},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3034":62152,"_26479":62138,"_18432":104511,"_5":12632,"_25092":104476,"_2540":104512},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3034":62153,"_26479":62138,"_18432":104514,"_5":12632,"_25092":104476,"_2540":104515},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3034":62154,"_26479":62138,"_18432":104517,"_5":12632,"_25092":104476,"_2540":104518},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3034":62155,"_26479":62138,"_18432":104520,"_5":12632,"_25092":104480,"_2540":104521},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3034":62156,"_26479":62138,"_18432":104523,"_5":12632,"_25092":104480,"_2540":104524},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3034":62157,"_26479":62138,"_18432":104526,"_5":12632,"_25092":104480,"_2540":104527},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3034":62158,"_26479":62138,"_18432":104529,"_5":12632,"_25092":104480,"_2540":104530},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3034":62159,"_26479":62138,"_18432":104532,"_5":12632,"_25092":104484,"_2540":104533},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3034":62160,"_26479":62138,"_18432":104535,"_5":12632,"_25092":104484,"_2540":104536},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3034":62161,"_26479":62161,"_5":12947,"_2540":104538,"_26823":104539,"_18432":104540,"_25092":62161},"Estrategias de aprovisionamiento",[43109,102680,45427,103652,103827],[],{"_3034":62162,"_26479":62161,"_18432":104542,"_5":12632,"_25092":62161,"_2540":104543},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3034":62163,"_26479":62161,"_5":26820,"_18432":104545,"_25092":104546,"_2540":104547},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3034":62164,"_26479":62161,"_5":26820,"_18432":104549,"_25092":104550,"_2540":104551},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3034":62165,"_26479":62161,"_5":26820,"_18432":104553,"_25092":104554,"_2540":104555},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3034":62166,"_26479":62161,"_5":26820,"_18432":104557,"_25092":104558,"_2540":104559},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3034":62167,"_26479":62161,"_5":26820,"_18432":104561,"_25092":104562,"_2540":104563},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3034":62168,"_26479":62161,"_18432":104565,"_5":12632,"_25092":62161,"_2540":104566},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3034":62169,"_26479":62161,"_18432":104568,"_5":12632,"_25092":104546,"_2540":104569},[],"Recorrido",{"_3034":62170,"_26479":62161,"_18432":104571,"_5":12632,"_25092":104546,"_2540":104572},[],"Cuándo existe el dispositivo",{"_3034":62171,"_26479":62161,"_18432":104574,"_5":12632,"_25092":104546,"_2540":104575},[],"Qué compruebas",{"_3034":62172,"_26479":62161,"_18432":104577,"_5":12632,"_25092":104546,"_2540":104578},[],"Asignación manual",{"_3034":62173,"_26479":62161,"_18432":104580,"_5":12632,"_25092":104546,"_2540":104581},[],"El operador lo crea antes de asociar un certificado.",{"_3034":62174,"_26479":62161,"_18432":104583,"_5":12632,"_25092":104546,"_2540":104584},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3034":62175,"_26479":62161,"_18432":104586,"_5":12632,"_25092":104546,"_2540":104587},[],"EST con `JITP`",{"_3034":62176,"_26479":62161,"_18432":104589,"_5":12632,"_25092":104546,"_2540":104590},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3034":62177,"_26479":62161,"_18432":104592,"_5":12632,"_25092":104546,"_2540":104593},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3034":62178,"_26479":62161,"_18432":104595,"_5":12632,"_25092":104546,"_2540":104596},[],"EST con `PRE_REGISTRATION`",{"_3034":62179,"_26479":62161,"_18432":104598,"_5":12632,"_25092":104546,"_2540":104599},[],"Debe existir antes de `/simpleenroll`.",{"_3034":62180,"_26479":62161,"_18432":104601,"_5":12632,"_25092":104546,"_2540":104602},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3034":62181,"_26479":62161,"_18432":104604,"_5":12632,"_25092":104546,"_2540":104605},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3034":62182,"_26479":62161,"_18432":104607,"_5":12632,"_25092":104546,"_2540":104608},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3034":62183,"_26479":62161,"_18432":104610,"_5":12632,"_25092":104550,"_2540":104611},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3034":62184,"_26479":62161,"_18432":104613,"_5":12632,"_25092":104550,"_2540":104614},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3034":62185,"_26479":62161,"_18432":104616,"_5":12632,"_25092":104550,"_2540":104617},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3034":62186,"_26479":62161,"_18432":104619,"_5":12632,"_25092":104554,"_2540":104620},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3034":62187,"_26479":62161,"_18432":104622,"_5":12632,"_25092":104554,"_2540":104623},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3034":62188,"_26479":62161,"_18432":104625,"_5":12632,"_25092":104554,"_2540":104626},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3034":62189,"_26479":62161,"_18432":104628,"_5":12632,"_25092":104554,"_2540":104629},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3034":62190,"_26479":62161,"_18432":104631,"_5":12632,"_25092":104554,"_2540":104632},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3034":62191,"_26479":62161,"_18432":104634,"_5":12632,"_25092":104554,"_2540":104635},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3034":62192,"_26479":62161,"_18432":104637,"_5":12632,"_25092":104558,"_2540":101738},[],{"_3034":62193,"_26479":62161,"_18432":104639,"_5":12632,"_25092":104558,"_2540":104640},[],"Material que atraviesa EST",{"_3034":62194,"_26479":62161,"_18432":104642,"_5":12632,"_25092":104558,"_2540":104643},[],"Clave generada por el dispositivo",{"_3034":62195,"_26479":62161,"_18432":104645,"_5":12632,"_25092":104558,"_2540":104646},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3034":62196,"_26479":62161,"_18432":104648,"_5":12632,"_25092":104558,"_2540":104649},[],"Clave ya disponible en el dispositivo",{"_3034":62197,"_26479":62161,"_18432":104651,"_5":12632,"_25092":104558,"_2540":104652},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3034":62198,"_26479":62161,"_18432":104654,"_5":12632,"_25092":104558,"_2540":45746},[],{"_3034":62199,"_26479":62161,"_18432":104656,"_5":12632,"_25092":104558,"_2540":104657},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3034":62200,"_26479":62161,"_18432":104659,"_5":12632,"_25092":104558,"_2540":104660},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3034":62201,"_26479":62161,"_18432":104662,"_5":12632,"_25092":104562,"_2540":104663},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3034":62202,"_26479":62202,"_5":12947,"_2540":104665,"_26823":104666,"_18432":104667,"_25092":62202},"Renovación y recuperación",[43109,102680,45427,103652,103827],[],{"_3034":62203,"_26479":62202,"_18432":104669,"_5":12632,"_25092":62202,"_2540":104670},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3034":62204,"_26479":62202,"_5":26820,"_18432":104672,"_25092":104673,"_2540":104674},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3034":62205,"_26479":62202,"_5":26820,"_18432":104676,"_25092":104677,"_2540":104678},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3034":62206,"_26479":62202,"_5":26820,"_18432":104680,"_25092":104681,"_2540":104682},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3034":62207,"_26479":62202,"_5":26820,"_18432":104684,"_25092":104685,"_2540":104686},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3034":62208,"_26479":62202,"_5":26820,"_18432":104688,"_25092":104689,"_2540":104690},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3034":62209,"_26479":62202,"_18432":104692,"_5":12632,"_25092":62202,"_2540":104693},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3034":62210,"_26479":62202,"_18432":104695,"_5":12632,"_25092":104673,"_2540":104696},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3034":62211,"_26479":62202,"_18432":104698,"_5":12632,"_25092":104673,"_2540":104699},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3034":62212,"_26479":62202,"_18432":104701,"_5":12632,"_25092":104673,"_2540":104702},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3034":62213,"_26479":62202,"_18432":104704,"_5":12632,"_25092":104673,"_2540":104705},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3034":62214,"_26479":62202,"_18432":104707,"_5":12632,"_25092":104677,"_2540":104708},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3034":62215,"_26479":62202,"_18432":104710,"_5":12632,"_25092":104677,"_2540":104711},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3034":62216,"_26479":62202,"_18432":104713,"_5":12632,"_25092":104681,"_2540":104714},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3034":62217,"_26479":62202,"_18432":104716,"_5":12632,"_25092":104681,"_2540":104717},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3034":62218,"_26479":62202,"_18432":104719,"_5":12632,"_25092":104681,"_2540":104720},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3034":62219,"_26479":62202,"_18432":104722,"_5":12632,"_25092":104685,"_2540":104723},[],"Situación",{"_3034":62220,"_26479":62202,"_18432":104725,"_5":12632,"_25092":104685,"_2540":104726},[],"Procedimiento",{"_3034":62221,"_26479":62202,"_18432":104728,"_5":12632,"_25092":104685,"_2540":104729},[],"Certificado vigente, fuera de ventana",{"_3034":62222,"_26479":62202,"_18432":104731,"_5":12632,"_25092":104685,"_2540":104732},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3034":62223,"_26479":62202,"_18432":104734,"_5":12632,"_25092":104685,"_2540":104735},[],"Certificado vencido, clave disponible",{"_3034":62224,"_26479":62202,"_18432":104737,"_5":12632,"_25092":104685,"_2540":104738},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3034":62225,"_26479":62202,"_18432":104740,"_5":12632,"_25092":104685,"_2540":104741},[],"Renovación por webhook o `NO_AUTH`",{"_3034":62226,"_26479":62202,"_18432":104743,"_5":12632,"_25092":104685,"_2540":104744},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3034":62227,"_26479":62202,"_18432":104746,"_5":12632,"_25092":104685,"_2540":104747},[],"Clave perdida o inaccesible",{"_3034":62228,"_26479":62202,"_18432":104749,"_5":12632,"_25092":104685,"_2540":104750},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3034":62229,"_26479":62202,"_18432":104752,"_5":12632,"_25092":104685,"_2540":104753},[],"Identidad actual revocada",{"_3034":62230,"_26479":62202,"_18432":104755,"_5":12632,"_25092":104685,"_2540":104756},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3034":62231,"_26479":62202,"_18432":104758,"_5":12632,"_25092":104685,"_2540":104759},[],"Dispositivo sin identidad",{"_3034":62232,"_26479":62202,"_18432":104761,"_5":12632,"_25092":104685,"_2540":104762},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3034":62233,"_26479":62202,"_18432":104764,"_5":12632,"_25092":104685,"_2540":104765},[],"Dispositivo retirado",{"_3034":62234,"_26479":62202,"_18432":104767,"_5":12632,"_25092":104685,"_2540":104768},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3034":62235,"_26479":62202,"_18432":104770,"_5":12632,"_25092":104685,"_2540":104771},[],"Timeout, HTTP 500 o fallo de instalación",{"_3034":62236,"_26479":62202,"_18432":104773,"_5":12632,"_25092":104685,"_2540":104774},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3034":62237,"_26479":62202,"_18432":104776,"_5":12632,"_25092":104689,"_2540":104777},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3034":62238,"_26479":62202,"_18432":104779,"_5":12632,"_25092":104689,"_2540":104780},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3034":62239,"_26479":62239,"_5":12947,"_2540":104782,"_26823":104783,"_18432":104784,"_25092":62239},"Diagnóstico de enrolamiento",[43109,102680,45427,103652,103827],[],{"_3034":62240,"_26479":62239,"_18432":104786,"_5":12632,"_25092":62239,"_2540":104787},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3034":62241,"_26479":62239,"_5":26820,"_18432":104789,"_25092":104790,"_2540":104791},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3034":62242,"_26479":62239,"_5":26820,"_18432":104793,"_25092":104794,"_2540":104795},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3034":62243,"_26479":62239,"_5":26820,"_18432":104797,"_25092":104798,"_2540":104354},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3034":62244,"_26479":62239,"_5":26820,"_18432":104800,"_25092":104801,"_2540":104802},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3034":62245,"_26479":62239,"_18432":104804,"_5":12632,"_25092":62239,"_2540":104805},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3034":62246,"_26479":62239,"_18432":104807,"_5":12632,"_25092":104794,"_2540":104808},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3034":62247,"_26479":62239,"_18432":104810,"_5":12632,"_25092":104794,"_2540":104811},[],"Síntoma o mensaje",{"_3034":62248,"_26479":62239,"_18432":104813,"_5":12632,"_25092":104794,"_2540":104814},[],"Qué revisar",{"_3034":62249,"_26479":62239,"_18432":104816,"_5":12632,"_25092":104794,"_2540":104817},[],"curl rechaza TLS, nombre o emisor",{"_3034":62250,"_26479":62239,"_18432":104819,"_5":12632,"_25092":104794,"_2540":104820},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3034":62251,"_26479":62239,"_18432":104822,"_5":12632,"_25092":104794,"_2540":104823},[],"404 o APS ausente",{"_3034":62252,"_26479":62239,"_18432":104825,"_5":12632,"_25092":104794,"_2540":104826},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3034":62253,"_26479":62239,"_18432":104828,"_5":12632,"_25092":104794,"_2540":104829},[],"400, error de CSR o formato",{"_3034":62254,"_26479":62239,"_18432":104831,"_5":12632,"_25092":104794,"_2540":104832},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3034":62255,"_26479":62239,"_18432":104834,"_5":12632,"_25092":104794,"_2540":104835},[],"Credencial ausente o certificado no válido",{"_3034":62256,"_26479":62239,"_18432":104837,"_5":12632,"_25092":104794,"_2540":104838},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3034":62257,"_26479":62239,"_18432":104840,"_5":12632,"_25092":104794,"_2540":104841},[],"Webhook deniega, expira o responde sin autorización",{"_3034":62258,"_26479":62239,"_18432":104843,"_5":12632,"_25092":104794,"_2540":104844},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3034":62259,"_26479":62239,"_18432":104846,"_5":12632,"_25092":104794,"_2540":46666},[],{"_3034":62260,"_26479":62239,"_18432":104848,"_5":12632,"_25092":104794,"_2540":104849},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3034":62261,"_26479":62239,"_18432":104851,"_5":12632,"_25092":104794,"_2540":46672},[],{"_3034":62262,"_26479":62239,"_18432":104853,"_5":12632,"_25092":104794,"_2540":104854},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3034":62263,"_26479":62239,"_18432":104856,"_5":12632,"_25092":104794,"_2540":46678},[],{"_3034":62264,"_26479":62239,"_18432":104858,"_5":12632,"_25092":104794,"_2540":104859},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3034":62265,"_26479":62239,"_18432":104861,"_5":12632,"_25092":104794,"_2540":46684},[],{"_3034":62266,"_26479":62239,"_18432":104863,"_5":12632,"_25092":104794,"_2540":104864},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3034":62267,"_26479":62239,"_18432":104866,"_5":12632,"_25092":104794,"_2540":46690},[],{"_3034":62268,"_26479":62239,"_18432":104868,"_5":12632,"_25092":104794,"_2540":104869},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3034":62269,"_26479":62239,"_18432":104871,"_5":12632,"_25092":104794,"_2540":104872},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3034":62270,"_26479":62239,"_18432":104874,"_5":12632,"_25092":104794,"_2540":104875},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3034":62271,"_26479":62239,"_18432":104877,"_5":12632,"_25092":104794,"_2540":104878},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3034":62272,"_26479":62239,"_18432":104880,"_5":12632,"_25092":104794,"_2540":104881},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3034":62273,"_26479":62239,"_18432":104883,"_5":12632,"_25092":104794,"_2540":46708},[],{"_3034":62274,"_26479":62239,"_18432":104885,"_5":12632,"_25092":104794,"_2540":104886},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3034":62275,"_26479":62239,"_18432":104888,"_5":12632,"_25092":104794,"_2540":46714},[],{"_3034":62276,"_26479":62239,"_18432":104890,"_5":12632,"_25092":104794,"_2540":104891},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3034":62277,"_26479":62239,"_18432":104893,"_5":12632,"_25092":104794,"_2540":104894},[],"DMS propietario distinto",{"_3034":62278,"_26479":62239,"_18432":104896,"_5":12632,"_25092":104794,"_2540":104897},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3034":62279,"_26479":62239,"_18432":104899,"_5":12632,"_25092":104794,"_2540":46726},[],{"_3034":62280,"_26479":62239,"_18432":104901,"_5":12632,"_25092":104794,"_2540":104902},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3034":62281,"_26479":62239,"_18432":104904,"_5":12632,"_25092":104794,"_2540":46732},[],{"_3034":62282,"_26479":62239,"_18432":104906,"_5":12632,"_25092":104794,"_2540":104907},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3034":62283,"_26479":62239,"_18432":104909,"_5":12632,"_25092":104794,"_2540":104910},[],"Certificado actual revocado",{"_3034":62284,"_26479":62239,"_18432":104912,"_5":12632,"_25092":104794,"_2540":104913},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3034":62285,"_26479":62239,"_18432":104915,"_5":12632,"_25092":104794,"_2540":104916},[],"Error de CA, perfil o firma",{"_3034":62286,"_26479":62239,"_18432":104918,"_5":12632,"_25092":104794,"_2540":104919},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3034":62287,"_26479":62239,"_18432":104921,"_5":12632,"_25092":104794,"_2540":104922},[],"HTTP 200 sin conexión del dispositivo",{"_3034":62288,"_26479":62239,"_18432":104924,"_5":12632,"_25092":104794,"_2540":104925},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3034":62289,"_26479":62239,"_18432":104927,"_5":12632,"_25092":104794,"_2540":104928},[],"Timeout o error después de emitir",{"_3034":62290,"_26479":62239,"_18432":104930,"_5":12632,"_25092":104794,"_2540":104931},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3034":62291,"_26479":62239,"_18432":104933,"_5":12632,"_25092":104798,"_2540":104934},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3034":62292,"_26479":62239,"_18432":104936,"_5":12632,"_25092":104798,"_2540":104937},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3034":62293,"_26479":62239,"_18432":104939,"_5":12632,"_25092":104801,"_2540":104940},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3034":62294,"_26479":62239,"_18432":104942,"_5":12632,"_25092":104801,"_2540":104943},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3034":62295,"_26479":62239,"_18432":104945,"_5":12632,"_25092":104801,"_2540":104946},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3034":62296,"_26479":62239,"_18432":104948,"_5":12632,"_25092":104801,"_2540":104949},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3034":62297,"_26479":62239,"_18432":104951,"_5":12632,"_25092":104801,"_2540":104952},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3034":62298,"_26479":62239,"_18432":104954,"_5":12632,"_25092":104801,"_2540":104955},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3034":62299,"_26479":62239,"_18432":104957,"_5":12632,"_25092":104801,"_2540":104958},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3034":62300,"_26479":62300,"_5":12947,"_2540":104960,"_26823":104961,"_18432":104962,"_25092":62300},"Distribución y actualización de confianza",[43109,102680,45427,103652,103827],[],{"_3034":62301,"_26479":62300,"_18432":104964,"_5":12632,"_25092":62300,"_2540":104965},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3034":62302,"_26479":62300,"_5":26820,"_18432":104967,"_25092":104968,"_2540":104969},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3034":62303,"_26479":62300,"_5":26820,"_18432":104971,"_25092":104972,"_2540":104973},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3034":62304,"_26479":62300,"_5":26820,"_18432":104975,"_25092":104976,"_2540":104977},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3034":62305,"_26479":62300,"_5":26820,"_18432":104979,"_25092":104980,"_2540":104981},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3034":62306,"_26479":62300,"_5":26820,"_18432":104983,"_25092":104984,"_2540":104985},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3034":62307,"_26479":62300,"_18432":104987,"_5":12632,"_25092":62300,"_2540":104988},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3034":62308,"_26479":62300,"_18432":104990,"_5":12632,"_25092":104968,"_2540":104991},[],"Relación",{"_3034":62309,"_26479":62300,"_18432":104993,"_5":12632,"_25092":104968,"_2540":104994},[],"Material que prepara el responsable",{"_3034":62310,"_26479":62300,"_18432":104996,"_5":12632,"_25092":104968,"_2540":104997},[],"Dispositivo → servidor EST",{"_3034":62311,"_26479":62300,"_18432":104999,"_5":12632,"_25092":104968,"_2540":105000},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3034":62312,"_26479":62300,"_18432":105002,"_5":12632,"_25092":104968,"_2540":105003},[],"DMS → solicitante",{"_3034":62313,"_26479":62300,"_18432":105005,"_5":12632,"_25092":104968,"_2540":105006},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3034":62314,"_26479":62300,"_18432":105008,"_5":12632,"_25092":104968,"_2540":105009},[],"Consumidor → dispositivo",{"_3034":62315,"_26479":62300,"_18432":105011,"_5":12632,"_25092":104968,"_2540":105012},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3034":62316,"_26479":62300,"_18432":105014,"_5":12632,"_25092":104968,"_2540":105015},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3034":62317,"_26479":62300,"_18432":105017,"_5":12632,"_25092":104972,"_2540":105018},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3034":62318,"_26479":62300,"_18432":105020,"_5":12632,"_25092":104972,"_2540":105021},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3034":62319,"_26479":62300,"_18432":105023,"_5":12632,"_25092":104976,"_2540":105024},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3034":62320,"_26479":62300,"_18432":105026,"_5":12632,"_25092":104976,"_2540":105027},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3034":62321,"_26479":62300,"_18432":105029,"_5":12632,"_25092":104976,"_2540":105030},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3034":62322,"_26479":62300,"_18432":105032,"_5":12632,"_25092":104976,"_2540":105033},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3034":62323,"_26479":62300,"_18432":105035,"_5":12632,"_25092":104976,"_2540":105036},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3034":62324,"_26479":62300,"_18432":105038,"_5":12632,"_25092":104976,"_2540":105039},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3034":62325,"_26479":62300,"_18432":105041,"_5":12632,"_25092":104980,"_2540":105042},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3034":62326,"_26479":62300,"_18432":105044,"_5":12632,"_25092":104980,"_2540":105045},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Al cambiar la CA de enrolamiento, añade a esa lista la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3034":62327,"_26479":62300,"_18432":105047,"_5":12632,"_25092":104980,"_2540":105048},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3034":62328,"_26479":62300,"_18432":105050,"_5":12632,"_25092":104984,"_2540":105051},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3034":62329,"_26479":62329,"_5":12947,"_2540":46881,"_26823":105053,"_18432":105055,"_25092":62329},[43109,102680,45427,103652,105054],"Integraciones",[],{"_3034":62330,"_26479":62329,"_18432":105057,"_5":12632,"_25092":62329,"_2540":105058},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3034":62331,"_26479":62329,"_5":26820,"_18432":105060,"_25092":105061,"_2540":105062},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3034":62332,"_26479":62329,"_5":26820,"_18432":105064,"_25092":105065,"_2540":105066},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3034":62333,"_26479":62329,"_5":26820,"_18432":105068,"_25092":105069,"_2540":105070},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3034":62334,"_26479":62329,"_5":26820,"_18432":105072,"_25092":105073,"_2540":105074},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3034":62335,"_26479":62329,"_5":26820,"_18432":105076,"_25092":105077,"_2540":105078},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3034":62336,"_26479":62329,"_5":26820,"_18432":105080,"_25092":105081,"_2540":105082},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3034":62337,"_26479":62329,"_5":26820,"_18432":105084,"_25092":105085,"_2540":46915},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3034":62338,"_26479":62329,"_5":26820,"_18432":105087,"_25092":105088,"_2540":46919},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3034":62339,"_26479":62329,"_5":26820,"_18432":105090,"_25092":105091,"_2540":105092},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3034":62340,"_26479":62329,"_5":26820,"_18432":105094,"_25092":105095,"_2540":105096},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3034":62341,"_26479":62329,"_5":26820,"_18432":105098,"_25092":105099,"_2540":105100},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3034":62342,"_26479":62329,"_5":26820,"_18432":105102,"_25092":105103,"_2540":105104},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3034":62343,"_26479":62329,"_5":26820,"_18432":105106,"_25092":105107,"_2540":105108},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3034":62344,"_26479":62329,"_5":26820,"_18432":105110,"_25092":105111,"_2540":105112},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3034":62345,"_26479":62329,"_5":26820,"_18432":105114,"_25092":105115,"_2540":105116},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3034":62346,"_26479":62329,"_5":26820,"_18432":105118,"_25092":105119,"_2540":105120},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3034":62347,"_26479":62329,"_5":26820,"_18432":105122,"_25092":105123,"_2540":105124},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3034":62348,"_26479":62329,"_5":26820,"_18432":105126,"_25092":105127,"_2540":105128},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3034":62349,"_26479":62329,"_5":26820,"_18432":105130,"_25092":105131,"_2540":105132},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3034":62350,"_26479":62329,"_5":26820,"_18432":105134,"_25092":105135,"_2540":105136},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3034":62351,"_26479":62329,"_18432":105138,"_5":12632,"_25092":62329,"_2540":105139},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3034":62352,"_26479":62329,"_18432":105141,"_5":12632,"_25092":62329,"_2540":105142},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3034":62353,"_26479":62329,"_18432":105144,"_5":12632,"_25092":62329,"_2540":105145},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3034":62354,"_26479":62329,"_18432":105147,"_5":12632,"_25092":105061,"_2540":105148},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3034":62355,"_26479":62329,"_18432":105150,"_5":12632,"_25092":105061,"_2540":105151},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3034":62356,"_26479":62329,"_18432":105153,"_5":12632,"_25092":105061,"_2540":105154},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3034":62357,"_26479":62329,"_18432":105156,"_5":12632,"_25092":105061,"_2540":105157},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3034":62358,"_26479":62329,"_18432":105159,"_5":12632,"_25092":105065,"_2540":105160},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3034":62359,"_26479":62329,"_18432":105162,"_5":12632,"_25092":105069,"_2540":105163},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3034":62360,"_26479":62329,"_18432":105165,"_5":12632,"_25092":105069,"_2540":105166},[],"Acción IAM",{"_3034":62361,"_26479":62329,"_18432":105168,"_5":12632,"_25092":105069,"_2540":101744},[],{"_3034":62362,"_26479":62329,"_18432":105170,"_5":12632,"_25092":105069,"_2540":47002},[],{"_3034":62363,"_26479":62329,"_18432":105172,"_5":12632,"_25092":105069,"_2540":105173},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3034":62364,"_26479":62329,"_18432":105175,"_5":12632,"_25092":105069,"_2540":47008},[],{"_3034":62365,"_26479":62329,"_18432":105177,"_5":12632,"_25092":105069,"_2540":105178},[],"Registrar la CA en AWS IoT",{"_3034":62366,"_26479":62329,"_18432":105180,"_5":12632,"_25092":105069,"_2540":47014},[],{"_3034":62367,"_26479":62329,"_18432":105182,"_5":12632,"_25092":105069,"_2540":105183},[],"Consultar el estado del registro de la CA",{"_3034":62368,"_26479":62329,"_18432":105185,"_5":12632,"_25092":105069,"_2540":47020},[],{"_3034":62369,"_26479":62329,"_18432":105187,"_5":12632,"_25092":105069,"_2540":105188},[],"Crear o actualizar Things en IoT Core",{"_3034":62370,"_26479":62329,"_18432":105190,"_5":12632,"_25092":105069,"_2540":47026},[],{"_3034":62371,"_26479":62329,"_18432":105192,"_5":12632,"_25092":105069,"_2540":105193},[],"Aprovisionar Things mediante plantilla",{"_3034":62372,"_26479":62329,"_18432":105195,"_5":12632,"_25092":105069,"_2540":47032},[],{"_3034":62373,"_26479":62329,"_18432":105197,"_5":12632,"_25092":105069,"_2540":105198},[],"Registrar certificados de dispositivo",{"_3034":62374,"_26479":62329,"_18432":105200,"_5":12632,"_25092":105069,"_2540":47038},[],{"_3034":62375,"_26479":62329,"_18432":105202,"_5":12632,"_25092":105069,"_2540":105203},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3034":62376,"_26479":62329,"_18432":105205,"_5":12632,"_25092":105069,"_2540":47044},[],{"_3034":62377,"_26479":62329,"_18432":105207,"_5":12632,"_25092":105069,"_2540":105208},[],"Crear y adjuntar políticas IoT",{"_3034":62378,"_26479":62329,"_18432":105210,"_5":12632,"_25092":105069,"_2540":47050},[],{"_3034":62379,"_26479":62329,"_18432":105212,"_5":12632,"_25092":105069,"_2540":105213},[],"Gestionar grupos de Things",{"_3034":62380,"_26479":62329,"_18432":105215,"_5":12632,"_25092":105069,"_2540":47056},[],{"_3034":62381,"_26479":62329,"_18432":105217,"_5":12632,"_25092":105069,"_2540":105218},[],"Crear plantillas JITP",{"_3034":62382,"_26479":62329,"_18432":105220,"_5":12632,"_25092":105069,"_2540":47062},[],{"_3034":62383,"_26479":62329,"_18432":105222,"_5":12632,"_25092":105069,"_2540":105223},[],"Leer y escribir el Device Shadow",{"_3034":62384,"_26479":62329,"_18432":105225,"_5":12632,"_25092":105069,"_2540":105226},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3034":62385,"_26479":62329,"_18432":105228,"_5":12632,"_25092":105073,"_2540":105229},[],"Parámetro",{"_3034":62386,"_26479":62329,"_18432":105231,"_5":12632,"_25092":105073,"_2540":105232},[],"Tipo",{"_3034":62387,"_26479":62329,"_18432":105234,"_5":12632,"_25092":105073,"_2540":105235},[],"Requerido",{"_3034":62388,"_26479":62329,"_18432":105237,"_5":12632,"_25092":105073,"_2540":105238},[],"Descripción",{"_3034":62389,"_26479":62329,"_18432":105240,"_5":12632,"_25092":105073,"_2540":47083},[],{"_3034":62390,"_26479":62329,"_18432":105242,"_5":12632,"_25092":105073,"_2540":22072},[],{"_3034":62391,"_26479":62329,"_18432":105244,"_5":12632,"_25092":105073,"_2540":105245},[],"Sí",{"_3034":62392,"_26479":62329,"_18432":105247,"_5":12632,"_25092":105073,"_2540":105248},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3034":62393,"_26479":62329,"_18432":105250,"_5":12632,"_25092":105073,"_2540":47094},[],{"_3034":62394,"_26479":62329,"_18432":105252,"_5":12632,"_25092":105073,"_2540":22072},[],{"_3034":62395,"_26479":62329,"_18432":105254,"_5":12632,"_25092":105073,"_2540":105245},[],{"_3034":62396,"_26479":62329,"_18432":105256,"_5":12632,"_25092":105073,"_2540":105257},[],"Región AWS donde opera el conector.",{"_3034":62397,"_26479":62329,"_18432":105259,"_5":12632,"_25092":105073,"_2540":47104},[],{"_3034":62398,"_26479":62329,"_18432":105261,"_5":12632,"_25092":105073,"_2540":22072},[],{"_3034":62399,"_26479":62329,"_18432":105263,"_5":12632,"_25092":105073,"_2540":105245},[],{"_3034":62400,"_26479":62329,"_18432":105265,"_5":12632,"_25092":105073,"_2540":105266},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3034":62401,"_26479":62329,"_18432":105268,"_5":12632,"_25092":105073,"_2540":47114},[],{"_3034":62402,"_26479":62329,"_18432":105270,"_5":12632,"_25092":105073,"_2540":22072},[],{"_3034":62403,"_26479":62329,"_18432":105272,"_5":12632,"_25092":105073,"_2540":105273},[],"Solo con `auth_method=static`",{"_3034":62404,"_26479":62329,"_18432":105275,"_5":12632,"_25092":105073,"_2540":105276},[],"Clave de acceso AWS.",{"_3034":62405,"_26479":62329,"_18432":105278,"_5":12632,"_25092":105073,"_2540":47125},[],{"_3034":62406,"_26479":62329,"_18432":105280,"_5":12632,"_25092":105073,"_2540":22072},[],{"_3034":62407,"_26479":62329,"_18432":105282,"_5":12632,"_25092":105073,"_2540":105273},[],{"_3034":62408,"_26479":62329,"_18432":105284,"_5":12632,"_25092":105073,"_2540":105285},[],"Clave secreta AWS.",{"_3034":62409,"_26479":62329,"_18432":105287,"_5":12632,"_25092":105073,"_2540":47135},[],{"_3034":62410,"_26479":62329,"_18432":105289,"_5":12632,"_25092":105073,"_2540":22072},[],{"_3034":62411,"_26479":62329,"_18432":105291,"_5":12632,"_25092":105073,"_2540":47140},[],{"_3034":62412,"_26479":62329,"_18432":105293,"_5":12632,"_25092":105073,"_2540":105294},[],"Token de sesión (con `auth_method=static`).",{"_3034":62413,"_26479":62329,"_18432":105296,"_5":12632,"_25092":105073,"_2540":47146},[],{"_3034":62414,"_26479":62329,"_18432":105298,"_5":12632,"_25092":105073,"_2540":22072},[],{"_3034":62415,"_26479":62329,"_18432":105300,"_5":12632,"_25092":105073,"_2540":105301},[],"Solo con `auth_method=role`",{"_3034":62416,"_26479":62329,"_18432":105303,"_5":12632,"_25092":105073,"_2540":105304},[],"ARN del rol a asumir.",{"_3034":62417,"_26479":62329,"_18432":105306,"_5":12632,"_25092":105073,"_2540":47157},[],{"_3034":62418,"_26479":62329,"_18432":105308,"_5":12632,"_25092":105073,"_2540":22072},[],{"_3034":62419,"_26479":62329,"_18432":105310,"_5":12632,"_25092":105073,"_2540":47140},[],{"_3034":62420,"_26479":62329,"_18432":105312,"_5":12632,"_25092":105073,"_2540":105313},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3034":62421,"_26479":62329,"_18432":105315,"_5":12632,"_25092":105073,"_2540":47167},[],{"_3034":62422,"_26479":62329,"_18432":105317,"_5":12632,"_25092":105073,"_2540":15467},[],{"_3034":62423,"_26479":62329,"_18432":105319,"_5":12632,"_25092":105073,"_2540":105245},[],{"_3034":62424,"_26479":62329,"_18432":105321,"_5":12632,"_25092":105073,"_2540":105322},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3034":62425,"_26479":62329,"_18432":105324,"_5":12632,"_25092":105073,"_2540":47177},[],{"_3034":62426,"_26479":62329,"_18432":105326,"_5":12632,"_25092":105073,"_2540":22072},[],{"_3034":62427,"_26479":62329,"_18432":105328,"_5":12632,"_25092":105073,"_2540":105245},[],{"_3034":62428,"_26479":62329,"_18432":105330,"_5":12632,"_25092":105073,"_2540":105331},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3034":62429,"_26479":62329,"_18432":105333,"_5":12632,"_25092":105073,"_2540":47187},[],{"_3034":62430,"_26479":62329,"_18432":105335,"_5":12632,"_25092":105073,"_2540":22072},[],{"_3034":62431,"_26479":62329,"_18432":105337,"_5":12632,"_25092":105073,"_2540":105245},[],{"_3034":62432,"_26479":62329,"_18432":105339,"_5":12632,"_25092":105073,"_2540":105340},[],"URL HTTP del Device Manager de Lamassu.",{"_3034":62433,"_26479":62329,"_18432":105342,"_5":12632,"_25092":105073,"_2540":47197},[],{"_3034":62434,"_26479":62329,"_18432":105344,"_5":12632,"_25092":105073,"_2540":22072},[],{"_3034":62435,"_26479":62329,"_18432":105346,"_5":12632,"_25092":105073,"_2540":105245},[],{"_3034":62436,"_26479":62329,"_18432":105348,"_5":12632,"_25092":105073,"_2540":105349},[],"URL HTTP del servicio de CA de Lamassu.",{"_3034":62437,"_26479":62329,"_18432":105351,"_5":12632,"_25092":105077,"_2540":105352},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3034":62438,"_26479":62329,"_18432":105354,"_5":12632,"_25092":105081,"_2540":105355},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3034":62439,"_26479":62329,"_18432":105357,"_5":12632,"_25092":105081,"_2540":105358},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3034":62440,"_26479":62329,"_18432":105360,"_5":12632,"_25092":105085,"_2540":105361},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3034":62441,"_26479":62329,"_18432":105363,"_5":12632,"_25092":105085,"_2540":105364},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3034":62442,"_26479":62329,"_18432":105366,"_5":12632,"_25092":105085,"_2540":105367},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3034":62443,"_26479":62329,"_18432":105369,"_5":12632,"_25092":105085,"_2540":105370},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3034":62444,"_26479":62329,"_18432":105372,"_5":12632,"_25092":105085,"_2540":105373},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3034":62445,"_26479":62329,"_18432":105375,"_5":12632,"_25092":105085,"_2540":105376},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3034":62446,"_26479":62329,"_18432":105378,"_5":12632,"_25092":105088,"_2540":105379},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3034":62447,"_26479":62329,"_18432":105381,"_5":12632,"_25092":105091,"_2540":105382},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3034":62448,"_26479":62329,"_18432":105384,"_5":12632,"_25092":105091,"_2540":105385},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3034":62449,"_26479":62329,"_18432":105387,"_5":12632,"_25092":105095,"_2540":105388},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3034":62450,"_26479":62329,"_18432":105390,"_5":12632,"_25092":105099,"_2540":105391},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3034":62451,"_26479":62329,"_18432":105393,"_5":12632,"_25092":105099,"_2540":105394},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3034":62452,"_26479":62329,"_18432":105396,"_5":12632,"_25092":105099,"_2540":105397},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3034":62453,"_26479":62329,"_18432":105399,"_5":12632,"_25092":105099,"_2540":105400},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3034":62454,"_26479":62329,"_18432":105402,"_5":12632,"_25092":105099,"_2540":105403},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3034":62455,"_26479":62329,"_18432":105405,"_5":12632,"_25092":105099,"_2540":105406},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3034":62456,"_26479":62329,"_18432":105408,"_5":12632,"_25092":105103,"_2540":105409},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3034":62457,"_26479":62329,"_18432":105411,"_5":12632,"_25092":105103,"_2540":105412},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3034":62458,"_26479":62329,"_18432":105414,"_5":12632,"_25092":105103,"_2540":105415},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3034":62459,"_26479":62329,"_18432":105417,"_5":12632,"_25092":105107,"_2540":105418},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3034":62460,"_26479":62329,"_18432":105420,"_5":12632,"_25092":105107,"_2540":105421},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3034":62461,"_26479":62329,"_18432":105423,"_5":12632,"_25092":105107,"_2540":105424},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3034":62462,"_26479":62329,"_18432":105426,"_5":12632,"_25092":105111,"_2540":105427},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3034":62463,"_26479":62329,"_18432":105429,"_5":12632,"_25092":105111,"_2540":105430},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3034":62464,"_26479":62329,"_18432":105432,"_5":12632,"_25092":105111,"_2540":105433},[],"Para que el flujo JITP funcione correctamente:",{"_3034":62465,"_26479":62329,"_18432":105435,"_5":12632,"_25092":105111,"_2540":105436},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3034":62466,"_26479":62329,"_18432":105438,"_5":12632,"_25092":105111,"_2540":105439},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3034":62467,"_26479":62329,"_18432":105441,"_5":12632,"_25092":105111,"_2540":105442},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3034":62468,"_26479":62329,"_18432":105444,"_5":12632,"_25092":105111,"_2540":105445},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3034":62469,"_26479":62329,"_18432":105447,"_5":12632,"_25092":105115,"_2540":105448},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3034":62470,"_26479":62329,"_18432":105450,"_5":12632,"_25092":105115,"_2540":105451},[],"Estado en Lamassu",{"_3034":62471,"_26479":62329,"_18432":105453,"_5":12632,"_25092":105115,"_2540":105454},[],"Razón de revocación",{"_3034":62472,"_26479":62329,"_18432":105456,"_5":12632,"_25092":105115,"_2540":105457},[],"Estado en AWS IoT Core",{"_3034":62473,"_26479":62329,"_18432":105459,"_5":12632,"_25092":105115,"_2540":47318},[],{"_3034":62474,"_26479":62329,"_18432":105461,"_5":12632,"_25092":105115,"_2540":105462},[],"Ninguna",{"_3034":62475,"_26479":62329,"_18432":105464,"_5":12632,"_25092":105115,"_2540":47324},[],{"_3034":62476,"_26479":62329,"_18432":105466,"_5":12632,"_25092":105115,"_2540":47327},[],{"_3034":62477,"_26479":62329,"_18432":105468,"_5":12632,"_25092":105115,"_2540":47330},[],{"_3034":62478,"_26479":62329,"_18432":105470,"_5":12632,"_25092":105115,"_2540":47333},[],{"_3034":62479,"_26479":62329,"_18432":105472,"_5":12632,"_25092":105115,"_2540":47327},[],{"_3034":62480,"_26479":62329,"_18432":105474,"_5":12632,"_25092":105115,"_2540":105475},[],"Cualquier otra razón",{"_3034":62481,"_26479":62329,"_18432":105477,"_5":12632,"_25092":105115,"_2540":47341},[],{"_3034":62482,"_26479":62329,"_18432":105479,"_5":12632,"_25092":105115,"_2540":105480},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3034":62483,"_26479":62329,"_18432":105482,"_5":12632,"_25092":105119,"_2540":105483},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3034":62484,"_26479":62329,"_18432":105485,"_5":12632,"_25092":105119,"_2540":105486},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3034":62485,"_26479":62329,"_18432":105488,"_5":12632,"_25092":105119,"_2540":105489},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3034":62486,"_26479":62329,"_18432":105491,"_5":12632,"_25092":105123,"_2540":105492},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3034":62487,"_26479":62329,"_18432":105494,"_5":12632,"_25092":105123,"_2540":105495},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3034":62488,"_26479":62329,"_18432":105497,"_5":12632,"_25092":105127,"_2540":105498},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3034":62489,"_26479":62329,"_18432":105500,"_5":12632,"_25092":105127,"_2540":105501},[],"Existen dos tipos de acciones:",{"_3034":62490,"_26479":62329,"_18432":105503,"_5":12632,"_25092":105127,"_2540":105504},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3034":62491,"_26479":62329,"_18432":105506,"_5":12632,"_25092":105127,"_2540":105507},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3034":62492,"_26479":62329,"_18432":105509,"_5":12632,"_25092":105127,"_2540":105510},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3034":62493,"_26479":62329,"_18432":105512,"_5":12632,"_25092":105131,"_2540":105513},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3034":62494,"_26479":62329,"_18432":105515,"_5":12632,"_25092":105131,"_2540":105516},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3034":62495,"_26479":62329,"_18432":105518,"_5":12632,"_25092":105131,"_2540":105519},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3034":62496,"_26479":62329,"_18432":105521,"_5":12632,"_25092":105135,"_2540":105522},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3034":62497,"_26479":62329,"_18432":105524,"_5":12632,"_25092":105135,"_2540":105525},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3034":62498,"_26479":62329,"_18432":105527,"_5":12632,"_25092":105135,"_2540":105528},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3034":62499,"_26479":62329,"_18432":105530,"_5":12632,"_25092":105135,"_2540":105531},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3034":62500,"_26479":62329,"_18432":105533,"_5":12632,"_25092":105135,"_2540":105534},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3034":62501,"_26479":62329,"_18432":105536,"_5":12632,"_25092":105135,"_2540":105537},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3034":62502,"_26479":62329,"_18432":105539,"_5":12632,"_25092":105135,"_2540":105540},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3034":62503,"_26479":62329,"_18432":105542,"_5":12632,"_25092":105135,"_2540":105543},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3034":62504,"_26479":62329,"_18432":105545,"_5":12632,"_25092":105135,"_2540":105546},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3034":62505,"_26479":62329,"_18432":105548,"_5":12632,"_25092":105135,"_2540":105549},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3034":62506,"_26479":62329,"_18432":105551,"_5":12632,"_25092":105135,"_2540":105552},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3034":62507,"_26479":62329,"_18432":105554,"_5":12632,"_25092":105135,"_2540":105555},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3034":62508,"_26479":62329,"_18432":105557,"_5":12632,"_25092":105135,"_2540":105558},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3034":62509,"_26479":62329,"_18432":105560,"_5":12632,"_25092":105135,"_2540":105561},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3034":62510,"_26479":62329,"_18432":105563,"_5":12632,"_25092":105135,"_2540":105564},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3034":62511,"_26479":62329,"_18432":105566,"_5":12632,"_25092":105135,"_2540":105567},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3034":62512,"_26479":62329,"_18432":105569,"_5":12632,"_25092":105135,"_2540":105570},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3034":62513,"_26479":62329,"_18432":105572,"_5":12632,"_25092":105135,"_2540":105573},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3034":62514,"_26479":62329,"_18432":105575,"_5":12632,"_25092":105135,"_2540":105576},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3034":62515,"_26479":62329,"_18432":105578,"_5":12632,"_25092":105135,"_2540":105579},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3034":62516,"_26479":62329,"_18432":105581,"_5":12632,"_25092":105135,"_2540":105582},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3034":62517,"_26479":62517,"_5":12947,"_2540":45427,"_26823":105584,"_18432":105585,"_25092":62517},[43109,102680,45427],[],{"_3034":62518,"_26479":62517,"_18432":105587,"_5":12632,"_25092":62517,"_2540":105588},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3034":62519,"_26479":62517,"_5":26820,"_18432":105590,"_25092":105591,"_2540":105592},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3034":62520,"_26479":62517,"_5":26820,"_18432":105594,"_25092":105595,"_2540":103652},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3034":62521,"_26479":62517,"_5":26820,"_18432":105597,"_25092":105598,"_2540":103827},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3034":62522,"_26479":62517,"_5":26820,"_18432":105600,"_25092":105601,"_2540":105054},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/overview#integraciones",{"_3034":62523,"_26479":62517,"_5":26820,"_18432":105603,"_25092":105604,"_2540":105605},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3034":62524,"_26479":62517,"_18432":105607,"_5":12632,"_25092":62517,"_2540":105608},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3034":62525,"_26479":62517,"_18432":105610,"_5":12632,"_25092":105591,"_2540":105611},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3034":62526,"_26479":62517,"_18432":105613,"_5":12632,"_25092":105591,"_2540":105614},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3034":62527,"_26479":62517,"_18432":105616,"_5":12632,"_25092":105595,"_2540":105617},[],"Recurso",{"_3034":62528,"_26479":62517,"_18432":105619,"_5":12632,"_25092":105595,"_2540":105620},[],"Qué representa",{"_3034":62529,"_26479":62517,"_18432":105622,"_5":12632,"_25092":105595,"_2540":105623},[],"**Dispositivo**",{"_3034":62530,"_26479":62517,"_18432":105625,"_5":12632,"_25092":105595,"_2540":105626},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3034":62531,"_26479":62517,"_18432":105628,"_5":12632,"_25092":105595,"_2540":105629},[],"**Identidad**",{"_3034":62532,"_26479":62517,"_18432":105631,"_5":12632,"_25092":105595,"_2540":105632},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3034":62533,"_26479":62517,"_18432":105634,"_5":12632,"_25092":105595,"_2540":47499},[],{"_3034":62534,"_26479":62517,"_18432":105636,"_5":12632,"_25092":105595,"_2540":105637},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3034":62535,"_26479":62517,"_18432":105639,"_5":12632,"_25092":105595,"_2540":105640},[],"**Flota**",{"_3034":62536,"_26479":62517,"_18432":105642,"_5":12632,"_25092":105595,"_2540":105643},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3034":62537,"_26479":62517,"_18432":105645,"_5":12632,"_25092":105595,"_2540":105646},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3034":62538,"_26479":62517,"_18432":105648,"_5":12632,"_25092":105595,"_2540":105649},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3034":62539,"_26479":62517,"_18432":105651,"_5":12632,"_25092":105598,"_2540":105652},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3034":62540,"_26479":62517,"_18432":105654,"_5":12632,"_25092":105598,"_2540":105655},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3034":62541,"_26479":62517,"_18432":105657,"_5":12632,"_25092":105598,"_2540":105658},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3034":62542,"_26479":62517,"_18432":105660,"_5":12632,"_25092":105598,"_2540":105661},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3034":62543,"_26479":62517,"_18432":105663,"_5":12632,"_25092":105598,"_2540":105664},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3034":62544,"_26479":62517,"_18432":105666,"_5":12632,"_25092":105598,"_2540":105667},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3034":62545,"_26479":62517,"_18432":105669,"_5":12632,"_25092":105598,"_2540":105670},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3034":62546,"_26479":62517,"_18432":105672,"_5":12632,"_25092":105598,"_2540":105673},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3034":62547,"_26479":62517,"_18432":105675,"_5":12632,"_25092":105601,"_2540":105676},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3034":62548,"_26479":62517,"_18432":105678,"_5":12632,"_25092":105601,"_2540":105679},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3034":62549,"_26479":62517,"_18432":105681,"_5":12632,"_25092":105604,"_2540":105682},[],"Participante",{"_3034":62550,"_26479":62517,"_18432":105684,"_5":12632,"_25092":105604,"_2540":105685},[],"Responsabilidad",{"_3034":62551,"_26479":62517,"_18432":105687,"_5":12632,"_25092":105604,"_2540":105688},[],"Administrador PKI",{"_3034":62552,"_26479":62517,"_18432":105690,"_5":12632,"_25092":105604,"_2540":105691},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3034":62553,"_26479":62517,"_18432":105693,"_5":12632,"_25092":105604,"_2540":105694},[],"Administrador del aprovisionamiento",{"_3034":62554,"_26479":62517,"_18432":105696,"_5":12632,"_25092":105604,"_2540":105697},[],"DMS, admisión, autenticación por operación e inventario.",{"_3034":62555,"_26479":62517,"_18432":105699,"_5":12632,"_25092":105604,"_2540":105700},[],"Integrador del dispositivo",{"_3034":62556,"_26479":62517,"_18432":105702,"_5":12632,"_25092":105604,"_2540":105703},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3034":62557,"_26479":62517,"_18432":105705,"_5":12632,"_25092":105604,"_2540":105706},[],"Integrador del consumidor",{"_3034":62558,"_26479":62517,"_18432":105708,"_5":12632,"_25092":105604,"_2540":105709},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3034":62559,"_26479":62517,"_18432":105711,"_5":12632,"_25092":105604,"_2540":105712},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3034":62560,"_26479":62560,"_5":12947,"_2540":105714,"_26823":105715,"_18432":105717,"_25092":62560},"Enrola y conecta tu primer dispositivo",[43109,102680,45427,105716],"Primeros pasos",[],{"_3034":62561,"_26479":62560,"_18432":105719,"_5":12632,"_25092":62560,"_2540":105720},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3034":62562,"_26479":62560,"_5":26820,"_18432":105722,"_25092":105723,"_2540":101381},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3034":62563,"_26479":62560,"_5":26820,"_18432":105725,"_25092":105726,"_2540":105727},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3034":62564,"_26479":62560,"_5":26820,"_18432":105729,"_25092":105730,"_2540":105731},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3034":62565,"_26479":62560,"_5":26820,"_18432":105733,"_25092":105734,"_2540":105735},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3034":62566,"_26479":62560,"_5":26820,"_18432":105737,"_25092":105738,"_2540":105739},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3034":62567,"_26479":62560,"_5":26820,"_18432":105741,"_25092":105742,"_2540":105743},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3034":62568,"_26479":62560,"_5":26820,"_18432":105745,"_25092":105746,"_2540":105747},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3034":62569,"_26479":62560,"_5":26820,"_18432":105749,"_25092":105750,"_2540":105751},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3034":62570,"_26479":62560,"_18432":105753,"_5":12632,"_25092":62560,"_2540":105754},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3034":62571,"_26479":62560,"_18432":105756,"_5":12632,"_25092":105723,"_2540":105757},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3034":62572,"_26479":62560,"_18432":105759,"_5":12632,"_25092":105723,"_2540":105760},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3034":62573,"_26479":62560,"_18432":105762,"_5":12632,"_25092":105723,"_2540":105763},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3034":62574,"_26479":62560,"_18432":105765,"_5":12632,"_25092":105723,"_2540":105766},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3034":62575,"_26479":62560,"_18432":105768,"_5":12632,"_25092":105723,"_2540":105769},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3034":62576,"_26479":62560,"_18432":105771,"_5":12632,"_25092":105726,"_2540":105772},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3034":62577,"_26479":62560,"_18432":105774,"_5":12632,"_25092":105726,"_2540":105775},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3034":62578,"_26479":62560,"_18432":105777,"_5":12632,"_25092":105730,"_2540":105778},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3034":62579,"_26479":62560,"_18432":105780,"_5":12632,"_25092":105730,"_2540":105781},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3034":62580,"_26479":62560,"_18432":105783,"_5":12632,"_25092":105730,"_2540":105784},[],"Ajuste",{"_3034":62581,"_26479":62560,"_18432":105786,"_5":12632,"_25092":105730,"_2540":105787},[],"Valor de evaluación",{"_3034":62582,"_26479":62560,"_18432":105789,"_5":12632,"_25092":105730,"_2540":47655},[],{"_3034":62583,"_26479":62560,"_18432":105791,"_5":12632,"_25092":105730,"_2540":105792},[],"Raíz emisora de `device-root.pem`.",{"_3034":62584,"_26479":62560,"_18432":105794,"_5":12632,"_25092":105730,"_2540":103955},[],{"_3034":62585,"_26479":62560,"_18432":105796,"_5":12632,"_25092":105730,"_2540":105797},[],"Perfil final de 1 hora que acabas de preparar.",{"_3034":62586,"_26479":62560,"_18432":105799,"_5":12632,"_25092":105730,"_2540":47666},[],{"_3034":62587,"_26479":62560,"_18432":105801,"_5":12632,"_25092":105730,"_2540":47669},[],{"_3034":62588,"_26479":62560,"_18432":105803,"_5":12632,"_25092":105730,"_2540":47672},[],{"_3034":62589,"_26479":62560,"_18432":105805,"_5":12632,"_25092":105730,"_2540":105806},[],"Habilitado.",{"_3034":62590,"_26479":62560,"_18432":105808,"_5":12632,"_25092":105730,"_2540":47678},[],{"_3034":62591,"_26479":62560,"_18432":105810,"_5":12632,"_25092":105730,"_2540":105811},[],"Deshabilitado; el ID debe ser nuevo.",{"_3034":62592,"_26479":62560,"_18432":105813,"_5":12632,"_25092":105730,"_2540":105814},[],"Autenticación inicial",{"_3034":62593,"_26479":62560,"_18432":105816,"_5":12632,"_25092":105730,"_2540":105817},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3034":62594,"_26479":62560,"_18432":105819,"_5":12632,"_25092":105730,"_2540":105820},[],"Autenticación de renovación",{"_3034":62595,"_26479":62560,"_18432":105822,"_5":12632,"_25092":105730,"_2540":105823},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3034":62596,"_26479":62560,"_18432":105825,"_5":12632,"_25092":105730,"_2540":47696},[],{"_3034":62597,"_26479":62560,"_18432":105827,"_5":12632,"_25092":105730,"_2540":105828},[],"Lista vacía para esta emisión directa / deshabilitado.",{"_3034":62598,"_26479":62560,"_18432":105830,"_5":12632,"_25092":105730,"_2540":47702},[],{"_3034":62599,"_26479":62560,"_18432":105832,"_5":12632,"_25092":105730,"_2540":105833},[],"1 hora.",{"_3034":62600,"_26479":62560,"_18432":105835,"_5":12632,"_25092":105730,"_2540":47708},[],{"_3034":62601,"_26479":62560,"_18432":105837,"_5":12632,"_25092":105730,"_2540":105838},[],"30 minutos / 10 minutos.",{"_3034":62602,"_26479":62560,"_18432":105840,"_5":12632,"_25092":105730,"_2540":47714},[],{"_3034":62603,"_26479":62560,"_18432":105842,"_5":12632,"_25092":105730,"_2540":105843},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3034":62604,"_26479":62560,"_18432":105845,"_5":12632,"_25092":105730,"_2540":45746},[],{"_3034":62605,"_26479":62560,"_18432":105847,"_5":12632,"_25092":105730,"_2540":105848},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3034":62606,"_26479":62560,"_18432":105850,"_5":12632,"_25092":105730,"_2540":47725},[],{"_3034":62607,"_26479":62560,"_18432":105852,"_5":12632,"_25092":105730,"_2540":105853},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3034":62608,"_26479":62560,"_18432":105855,"_5":12632,"_25092":105730,"_2540":105856},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_3034":62609,"_26479":62560,"_18432":105858,"_5":12632,"_25092":105734,"_2540":105859},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3034":62610,"_26479":62560,"_18432":105861,"_5":12632,"_25092":105734,"_2540":105862},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3034":62611,"_26479":62560,"_18432":105864,"_5":12632,"_25092":105738,"_2540":105865},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3034":62612,"_26479":62560,"_18432":105867,"_5":12632,"_25092":105738,"_2540":105868},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3034":62613,"_26479":62560,"_18432":105870,"_5":12632,"_25092":105738,"_2540":105871},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3034":62614,"_26479":62560,"_18432":105873,"_5":12632,"_25092":105742,"_2540":105874},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3034":62615,"_26479":62560,"_18432":105876,"_5":12632,"_25092":105742,"_2540":105877},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3034":62616,"_26479":62560,"_18432":105879,"_5":12632,"_25092":105746,"_2540":105880},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3034":62617,"_26479":62560,"_18432":105882,"_5":12632,"_25092":105746,"_2540":105883},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3034":62618,"_26479":62560,"_18432":105885,"_5":12632,"_25092":105746,"_2540":105886},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3034":62619,"_26479":62560,"_18432":105888,"_5":12632,"_25092":105746,"_2540":105889},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3034":62620,"_26479":62560,"_18432":105891,"_5":12632,"_25092":105746,"_2540":105892},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3034":62621,"_26479":62560,"_18432":105894,"_5":12632,"_25092":105750,"_2540":105895},[],"Comprobación",{"_3034":62622,"_26479":62560,"_18432":105897,"_5":12632,"_25092":105750,"_2540":105898},[],"Resultado esperado",{"_3034":62623,"_26479":62560,"_18432":105900,"_5":12632,"_25092":105750,"_2540":105901},[],"Registro",{"_3034":62624,"_26479":62560,"_18432":105903,"_5":12632,"_25092":105750,"_2540":105904},[],"ID creado automáticamente y DMS correcto.",{"_3034":62625,"_26479":62560,"_18432":105906,"_5":12632,"_25092":105750,"_2540":105907},[],"Certificado",{"_3034":62626,"_26479":62560,"_18432":105909,"_5":12632,"_25092":105750,"_2540":105910},[],"CN, perfil, serie y clave verificados.",{"_3034":62627,"_26479":62560,"_18432":105912,"_5":12632,"_25092":105750,"_2540":105913},[],"Inventario",{"_3034":62628,"_26479":62560,"_18432":105915,"_5":12632,"_25092":105750,"_2540":105916},[],"Serie recibida visible como identidad actual y en el historial.",{"_3034":62629,"_26479":62560,"_18432":105918,"_5":12632,"_25092":105750,"_2540":105919},[],"Consumidor",{"_3034":62630,"_26479":62560,"_18432":105921,"_5":12632,"_25092":105750,"_2540":105922},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3034":62631,"_26479":62560,"_18432":105924,"_5":12632,"_25092":105750,"_2540":105925},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3034":62632,"_26479":62560,"_18432":105927,"_5":12632,"_25092":105750,"_2540":105928},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3034":62633,"_26479":62633,"_5":12947,"_2540":103669,"_26823":105930,"_18432":105931,"_25092":62633},[43109,102680,45427,105716],[],{"_3034":62634,"_26479":62633,"_18432":105933,"_5":12632,"_25092":62633,"_2540":105934},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3034":62635,"_26479":62633,"_5":26820,"_18432":105936,"_25092":105937,"_2540":101381},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3034":62636,"_26479":62633,"_5":26820,"_18432":105939,"_25092":105940,"_2540":105941},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3034":62637,"_26479":62633,"_5":26820,"_18432":105943,"_25092":105944,"_2540":105945},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3034":62638,"_26479":62633,"_5":26820,"_18432":105947,"_25092":105948,"_2540":105949},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3034":62639,"_26479":62633,"_5":26820,"_18432":105951,"_25092":105952,"_2540":105953},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3034":62640,"_26479":62633,"_5":26820,"_18432":105955,"_25092":105956,"_2540":105957},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3034":62641,"_26479":62633,"_5":26820,"_18432":105959,"_25092":105960,"_2540":105898},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3034":62642,"_26479":62633,"_5":26820,"_18432":105962,"_25092":105963,"_2540":105964},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3034":62643,"_26479":62633,"_5":26820,"_18432":105966,"_25092":105967,"_2540":105968},[],"/docs/pr-preview/pr-47/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3034":62644,"_26479":62633,"_18432":105970,"_5":12632,"_25092":62633,"_2540":105971},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3034":62645,"_26479":62633,"_18432":105973,"_5":12632,"_25092":62633,"_2540":105974},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3034":62646,"_26479":62633,"_18432":105976,"_5":12632,"_25092":105937,"_2540":105977},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3034":62647,"_26479":62633,"_18432":105979,"_5":12632,"_25092":105937,"_2540":105980},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3034":62648,"_26479":62633,"_18432":105982,"_5":12632,"_25092":105937,"_2540":105983},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3034":62649,"_26479":62633,"_18432":105985,"_5":12632,"_25092":105937,"_2540":105986},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3034":62650,"_26479":62633,"_18432":105988,"_5":12632,"_25092":105940,"_2540":105989},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3034":62651,"_26479":62633,"_18432":105991,"_5":12632,"_25092":105940,"_2540":105992},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3034":62652,"_26479":62633,"_18432":105994,"_5":12632,"_25092":105940,"_2540":105995},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3034":62653,"_26479":62633,"_18432":105997,"_5":12632,"_25092":105940,"_2540":105998},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3034":62654,"_26479":62633,"_18432":106000,"_5":12632,"_25092":105940,"_2540":106001},[],"Configura **Authentication Mode** como `CLIENT_CERTIFICATE` y añade en **Validation CAs** la CA cuyos certificados iniciales aceptarás. Para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deshabilitada la generación de claves en servidor si no la vas a utilizar.",{"_3034":62655,"_26479":62633,"_18432":106003,"_5":12632,"_25092":105940,"_2540":106004},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3034":62656,"_26479":62633,"_18432":106006,"_5":12632,"_25092":105940,"_2540":106007},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3034":62657,"_26479":62633,"_18432":106009,"_5":12632,"_25092":105940,"_2540":106010},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3034":62658,"_26479":62633,"_18432":106012,"_5":12632,"_25092":105944,"_2540":106013},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3034":62659,"_26479":62633,"_18432":106015,"_5":12632,"_25092":105944,"_2540":47891},[],{"_3034":62660,"_26479":62633,"_18432":106017,"_5":12632,"_25092":105944,"_2540":106018},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3034":62661,"_26479":62633,"_18432":106020,"_5":12632,"_25092":105944,"_2540":106021},[],"**Icon** y **Tags**: clasificación opcional.",{"_3034":62662,"_26479":62633,"_18432":106023,"_5":12632,"_25092":105944,"_2540":106024},[],"Confirma el registro.",{"_3034":62663,"_26479":62633,"_18432":106026,"_5":12632,"_25092":105948,"_2540":106027},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3034":62664,"_26479":62633,"_18432":106029,"_5":12632,"_25092":105948,"_2540":106030},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3034":62665,"_26479":62633,"_18432":106032,"_5":12632,"_25092":105952,"_2540":106033},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3034":62666,"_26479":62633,"_18432":106035,"_5":12632,"_25092":105952,"_2540":106036},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3034":62667,"_26479":62633,"_18432":106038,"_5":12632,"_25092":105956,"_2540":106039},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3034":62668,"_26479":62633,"_18432":106041,"_5":12632,"_25092":105956,"_2540":106042},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3034":62669,"_26479":62633,"_18432":106044,"_5":12632,"_25092":105960,"_2540":105895},[],{"_3034":62670,"_26479":62633,"_18432":106046,"_5":12632,"_25092":105960,"_2540":106047},[],"Resultado",{"_3034":62671,"_26479":62633,"_18432":106049,"_5":12632,"_25092":105960,"_2540":106050},[],"Dispositivo",{"_3034":62672,"_26479":62633,"_18432":106052,"_5":12632,"_25092":105960,"_2540":106053},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3034":62673,"_26479":62633,"_18432":106055,"_5":12632,"_25092":105960,"_2540":106056},[],"Identidad actual",{"_3034":62674,"_26479":62633,"_18432":106058,"_5":12632,"_25092":105960,"_2540":106059},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3034":62675,"_26479":62633,"_18432":106061,"_5":12632,"_25092":105960,"_2540":106062},[],"Historial",{"_3034":62676,"_26479":62633,"_18432":106064,"_5":12632,"_25092":105960,"_2540":106065},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3034":62677,"_26479":62633,"_18432":106067,"_5":12632,"_25092":105960,"_2540":106068},[],"Clave y certificado",{"_3034":62678,"_26479":62633,"_18432":106070,"_5":12632,"_25092":105960,"_2540":106071},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3034":62679,"_26479":62633,"_18432":106073,"_5":12632,"_25092":105963,"_2540":106074},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3034":62680,"_26479":62633,"_18432":106076,"_5":12632,"_25092":105963,"_2540":106077},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3034":62681,"_26479":62633,"_18432":106079,"_5":12632,"_25092":105963,"_2540":106080},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3034":62682,"_26479":62633,"_18432":106082,"_5":12632,"_25092":105963,"_2540":106083},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3034":62683,"_26479":62633,"_18432":106085,"_5":12632,"_25092":105967,"_2540":106086},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3034":62684,"_26479":62633,"_18432":106088,"_5":12632,"_25092":105967,"_2540":106089},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3034":62685,"_26479":62633,"_18432":106091,"_5":12632,"_25092":105967,"_2540":106092},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3034":62686,"_26479":62686,"_5":12947,"_2540":106094,"_26823":106095,"_18432":106096,"_25092":62686},"Plataforma Lamassu IoT",[43109,102680],[],{"_3034":62687,"_26479":62686,"_18432":106098,"_5":12632,"_25092":62686,"_2540":106099},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3034":62688,"_26479":62686,"_5":26820,"_18432":106101,"_25092":106102,"_2540":105592},[],"/docs/pr-preview/pr-47/es/platform/overview#empieza-aquí",{"_3034":62689,"_26479":62686,"_5":26820,"_18432":106104,"_25092":106105,"_2540":106106},[],"/docs/pr-preview/pr-47/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3034":62690,"_26479":62686,"_5":26820,"_18432":106108,"_25092":106109,"_2540":106110},[],"/docs/pr-preview/pr-47/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3034":62691,"_26479":62686,"_5":26820,"_18432":106112,"_25092":106113,"_2540":106114},[],"/docs/pr-preview/pr-47/es/platform/overview#capacidades-principales","Capacidades principales",{"_3034":62692,"_26479":62686,"_5":26820,"_18432":106116,"_25092":106117,"_2540":106118},[],"/docs/pr-preview/pr-47/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3034":62693,"_26479":62686,"_5":26820,"_18432":106120,"_25092":106121,"_2540":106122},[],"/docs/pr-preview/pr-47/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3034":62694,"_26479":62686,"_5":26820,"_18432":106124,"_25092":106125,"_2540":106126},[],"/docs/pr-preview/pr-47/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3034":62695,"_26479":62686,"_5":26820,"_18432":106128,"_25092":106129,"_2540":106130},[],"/docs/pr-preview/pr-47/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3034":62696,"_26479":62686,"_5":26820,"_18432":106132,"_25092":106133,"_2540":106134},[],"/docs/pr-preview/pr-47/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3034":62697,"_26479":62686,"_5":26820,"_18432":106136,"_25092":106137,"_2540":106138},[],"/docs/pr-preview/pr-47/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3034":62698,"_26479":62686,"_5":26820,"_18432":106140,"_25092":106141,"_2540":106142},[],"/docs/pr-preview/pr-47/es/platform/overview#referencia-operativa","Referencia operativa",{"_3034":62699,"_26479":62686,"_18432":106144,"_5":12632,"_25092":62686,"_2540":106145},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3034":62700,"_26479":62686,"_18432":106147,"_5":12632,"_25092":106102,"_2540":106148},[],"Elige el resultado que necesitas obtener:",{"_3034":62701,"_26479":62686,"_18432":106150,"_5":12632,"_25092":106102,"_2540":106151},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3034":62702,"_26479":62686,"_18432":106153,"_5":12632,"_25092":106102,"_2540":106154},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3034":62703,"_26479":62686,"_18432":106156,"_5":12632,"_25092":106102,"_2540":106157},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3034":62704,"_26479":62686,"_18432":106159,"_5":12632,"_25092":106105,"_2540":106160},[],"Bloque",{"_3034":62705,"_26479":62686,"_18432":106162,"_5":12632,"_25092":106105,"_2540":106163},[],"Qué gestionas",{"_3034":62706,"_26479":62686,"_18432":106165,"_5":12632,"_25092":106105,"_2540":106166},[],"Punto de entrada",{"_3034":62707,"_26479":62686,"_18432":106168,"_5":12632,"_25092":106105,"_2540":48045},[],{"_3034":62708,"_26479":62686,"_18432":106170,"_5":12632,"_25092":106105,"_2540":106171},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3034":62709,"_26479":62686,"_18432":106173,"_5":12632,"_25092":106105,"_2540":106174},[],"Visión general de PKI",{"_3034":62710,"_26479":62686,"_18432":106176,"_5":12632,"_25092":106105,"_2540":48054},[],{"_3034":62711,"_26479":62686,"_18432":106178,"_5":12632,"_25092":106105,"_2540":106179},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3034":62712,"_26479":62686,"_18432":106181,"_5":12632,"_25092":106105,"_2540":106182},[],"Visión general de IoT Fleets",{"_3034":62713,"_26479":62686,"_18432":106184,"_5":12632,"_25092":106105,"_2540":106185},[],"**Administración**",{"_3034":62714,"_26479":62686,"_18432":106187,"_5":12632,"_25092":106105,"_2540":106188},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3034":62715,"_26479":62686,"_18432":106190,"_5":12632,"_25092":106105,"_2540":102678},[],{"_3034":62716,"_26479":62686,"_18432":106192,"_5":12632,"_25092":106105,"_2540":106193},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3034":62717,"_26479":62686,"_18432":106195,"_5":12632,"_25092":106109,"_2540":106196},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3034":62718,"_26479":62686,"_18432":106198,"_5":12632,"_25092":106109,"_2540":106199},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3034":62719,"_26479":62686,"_18432":106201,"_5":12632,"_25092":106109,"_2540":106202},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3034":62720,"_26479":62686,"_18432":106204,"_5":12632,"_25092":106109,"_2540":106205},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3034":62721,"_26479":62686,"_18432":106207,"_5":12632,"_25092":106109,"_2540":106208},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3034":62722,"_26479":62686,"_18432":106210,"_5":12632,"_25092":106109,"_2540":106211},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3034":62723,"_26479":62686,"_18432":106213,"_5":12632,"_25092":106117,"_2540":106214},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3034":62724,"_26479":62686,"_18432":106216,"_5":12632,"_25092":106121,"_2540":106217},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3034":62725,"_26479":62686,"_18432":106219,"_5":12632,"_25092":106125,"_2540":106220},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3034":62726,"_26479":62686,"_18432":106222,"_5":12632,"_25092":106129,"_2540":106223},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3034":62727,"_26479":62686,"_18432":106225,"_5":12632,"_25092":106133,"_2540":106226},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3034":62728,"_26479":62686,"_18432":106228,"_5":12632,"_25092":106137,"_2540":106229},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3034":62729,"_26479":62686,"_18432":106231,"_5":12632,"_25092":106141,"_2540":105685},[],{"_3034":62730,"_26479":62686,"_18432":106233,"_5":12632,"_25092":106141,"_2540":106234},[],"Qué prepara o comprueba",{"_3034":62731,"_26479":62686,"_18432":106236,"_5":12632,"_25092":106141,"_2540":105688},[],{"_3034":62732,"_26479":62686,"_18432":106238,"_5":12632,"_25092":106141,"_2540":106239},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3034":62733,"_26479":62686,"_18432":106241,"_5":12632,"_25092":106141,"_2540":106242},[],"Administrador de la flota",{"_3034":62734,"_26479":62686,"_18432":106244,"_5":12632,"_25092":106141,"_2540":106245},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3034":62735,"_26479":62686,"_18432":106247,"_5":12632,"_25092":106141,"_2540":105700},[],{"_3034":62736,"_26479":62686,"_18432":106249,"_5":12632,"_25092":106141,"_2540":106250},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3034":62737,"_26479":62686,"_18432":106252,"_5":12632,"_25092":106141,"_2540":105706},[],{"_3034":62738,"_26479":62686,"_18432":106254,"_5":12632,"_25092":106141,"_2540":106255},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3034":62739,"_26479":62686,"_18432":106257,"_5":12632,"_25092":106141,"_2540":106258},[],"Operador de infraestructura",{"_3034":62740,"_26479":62686,"_18432":106260,"_5":12632,"_25092":106141,"_2540":106261},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3034":62741,"_26479":62686,"_18432":106263,"_5":12632,"_25092":106141,"_2540":106264},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3034":62742,"_26479":62742,"_5":12947,"_2540":106266,"_26823":106267,"_18432":106269,"_25092":62742},"Jerarquía y rotación de CAs",[43109,102680,48146,106268],"Claves, autoridades y certificados",[],{"_3034":62743,"_26479":62742,"_18432":106271,"_5":12632,"_25092":62742,"_2540":106272},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3034":62744,"_26479":62742,"_5":26820,"_18432":106274,"_25092":106275,"_2540":106276},[],"/docs/pr-preview/pr-47/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3034":62745,"_26479":62742,"_5":26820,"_18432":106278,"_25092":106279,"_2540":106280},[],"/docs/pr-preview/pr-47/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3034":62746,"_26479":62742,"_5":26820,"_18432":106282,"_25092":106283,"_2540":106284},[],"/docs/pr-preview/pr-47/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3034":62747,"_26479":62742,"_5":26820,"_18432":106286,"_25092":106287,"_2540":106288},[],"/docs/pr-preview/pr-47/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3034":62748,"_26479":62742,"_5":26820,"_18432":106290,"_25092":106291,"_2540":106292},[],"/docs/pr-preview/pr-47/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3034":62749,"_26479":62742,"_5":26820,"_18432":106294,"_25092":106295,"_2540":106296},[],"/docs/pr-preview/pr-47/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3034":62750,"_26479":62742,"_5":26820,"_18432":106298,"_25092":106299,"_2540":106300},[],"/docs/pr-preview/pr-47/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3034":62751,"_26479":62742,"_5":26820,"_18432":106302,"_25092":106303,"_2540":106304},[],"/docs/pr-preview/pr-47/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3034":62752,"_26479":62742,"_5":26820,"_18432":106306,"_25092":106307,"_2540":106308},[],"/docs/pr-preview/pr-47/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3034":62753,"_26479":62742,"_5":26820,"_18432":106310,"_25092":106311,"_2540":106312},[],"/docs/pr-preview/pr-47/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3034":62754,"_26479":62742,"_5":26820,"_18432":106314,"_25092":106315,"_2540":106316},[],"/docs/pr-preview/pr-47/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3034":62755,"_26479":62742,"_5":26820,"_18432":106318,"_25092":106319,"_2540":106320},[],"/docs/pr-preview/pr-47/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3034":62756,"_26479":62742,"_18432":106322,"_5":12632,"_25092":62742,"_2540":106323},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3034":62757,"_26479":62742,"_18432":106325,"_5":12632,"_25092":62742,"_2540":106326},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3034":62758,"_26479":62742,"_18432":106328,"_5":12632,"_25092":106275,"_2540":106329},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3034":62759,"_26479":62742,"_18432":106331,"_5":12632,"_25092":106275,"_2540":106332},[],"entorno, como producción y preproducción;",{"_3034":62760,"_26479":62742,"_18432":106334,"_5":12632,"_25092":106275,"_2540":106335},[],"propietario o equipo operador;",{"_3034":62761,"_26479":62742,"_18432":106337,"_5":12632,"_25092":106275,"_2540":106338},[],"familia de dispositivos o proceso de fabricación;",{"_3034":62762,"_26479":62742,"_18432":106340,"_5":12632,"_25092":106275,"_2540":106341},[],"región o requisito regulatorio;",{"_3034":62763,"_26479":62742,"_18432":106343,"_5":12632,"_25092":106275,"_2540":106344},[],"motor criptográfico o política de clave;",{"_3034":62764,"_26479":62742,"_18432":106346,"_5":12632,"_25092":106275,"_2540":106347},[],"ventana de mantenimiento y ritmo de renovación.",{"_3034":62765,"_26479":62742,"_18432":106349,"_5":12632,"_25092":106275,"_2540":106350},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3034":62766,"_26479":62742,"_18432":106352,"_5":12632,"_25092":106275,"_2540":106353},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3034":62767,"_26479":62742,"_18432":106355,"_5":12632,"_25092":106279,"_2540":106356},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3034":62768,"_26479":62742,"_18432":106358,"_5":12632,"_25092":106279,"_2540":106359},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3034":62769,"_26479":62742,"_18432":106361,"_5":12632,"_25092":106279,"_2540":106362},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3034":62770,"_26479":62742,"_18432":106364,"_5":12632,"_25092":106283,"_2540":106365},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3034":62771,"_26479":62742,"_18432":106367,"_5":12632,"_25092":106283,"_2540":106368},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3034":62772,"_26479":62742,"_18432":106370,"_5":12632,"_25092":106283,"_2540":106371},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3034":62773,"_26479":62742,"_18432":106373,"_5":12632,"_25092":106283,"_2540":106374},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3034":62774,"_26479":62742,"_18432":106376,"_5":12632,"_25092":106291,"_2540":106377},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3034":62775,"_26479":62742,"_18432":106379,"_5":12632,"_25092":106295,"_2540":106380},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3034":62776,"_26479":62742,"_18432":106382,"_5":12632,"_25092":106299,"_2540":106383},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3034":62777,"_26479":62742,"_18432":106385,"_5":12632,"_25092":106303,"_2540":106386},[],"Actualiza la CA de enrolamiento y el perfil de los DMS y añade la CA anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS mientras sigan renovando cohortes con certificados antiguos. La guía DMS documenta ese ajuste.",{"_3034":62778,"_26479":62742,"_18432":106388,"_5":12632,"_25092":106307,"_2540":106389},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3034":62779,"_26479":62742,"_18432":106391,"_5":12632,"_25092":106311,"_2540":106392},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_3034":62780,"_26479":62742,"_18432":106394,"_5":12632,"_25092":106315,"_2540":106395},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3034":62781,"_26479":62742,"_18432":106397,"_5":12632,"_25092":106315,"_2540":106398},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3034":62782,"_26479":62742,"_18432":106400,"_5":12632,"_25092":106315,"_2540":106401},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3034":62783,"_26479":62742,"_18432":106403,"_5":12632,"_25092":106315,"_2540":106404},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3034":62784,"_26479":62742,"_18432":106406,"_5":12632,"_25092":106319,"_2540":106407},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3034":62785,"_26479":62742,"_18432":106409,"_5":12632,"_25092":106319,"_2540":106410},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3034":62786,"_26479":62742,"_18432":106412,"_5":12632,"_25092":106319,"_2540":106413},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3034":62787,"_26479":62742,"_18432":106415,"_5":12632,"_25092":106319,"_2540":106416},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3034":62788,"_26479":62742,"_18432":106418,"_5":12632,"_25092":106319,"_2540":106419},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3034":62789,"_26479":62742,"_18432":106421,"_5":12632,"_25092":106319,"_2540":106422},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3034":62790,"_26479":62742,"_18432":106424,"_5":12632,"_25092":106319,"_2540":106425},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3034":62791,"_26479":62791,"_5":12947,"_2540":106427,"_26823":106428,"_18432":106429,"_25092":62791},"Autoridades de certificación",[43109,102680,48146,106268],[],{"_3034":62792,"_26479":62791,"_18432":106431,"_5":12632,"_25092":62791,"_2540":106432},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3034":62793,"_26479":62791,"_5":26820,"_18432":106434,"_25092":106435,"_2540":106436},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3034":62794,"_26479":62791,"_5":26820,"_18432":106438,"_25092":106439,"_2540":106440},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3034":62795,"_26479":62791,"_5":26820,"_18432":106442,"_25092":106443,"_2540":101381},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3034":62796,"_26479":62791,"_5":26820,"_18432":106445,"_25092":106446,"_2540":106447},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3034":62797,"_26479":62791,"_5":26820,"_18432":106449,"_25092":106450,"_2540":106451},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3034":62798,"_26479":62791,"_5":26820,"_18432":106453,"_25092":106454,"_2540":106455},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3034":62799,"_26479":62791,"_5":26820,"_18432":106457,"_25092":106458,"_2540":106459},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3034":62800,"_26479":62791,"_5":26820,"_18432":106461,"_25092":106462,"_2540":106463},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3034":62801,"_26479":62791,"_5":26820,"_18432":106465,"_25092":106466,"_2540":106467},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3034":62802,"_26479":62791,"_5":26820,"_18432":106469,"_25092":106470,"_2540":106471},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3034":62803,"_26479":62791,"_5":26820,"_18432":106473,"_25092":106474,"_2540":106475},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3034":62804,"_26479":62791,"_5":26820,"_18432":106477,"_25092":106478,"_2540":106479},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3034":62805,"_26479":62791,"_5":26820,"_18432":106481,"_25092":106482,"_2540":106483},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3034":62806,"_26479":62791,"_5":26820,"_18432":106485,"_25092":106486,"_2540":106487},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3034":62807,"_26479":62791,"_5":26820,"_18432":106489,"_25092":106490,"_2540":106491},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3034":62808,"_26479":62791,"_5":26820,"_18432":106493,"_25092":106494,"_2540":106495},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3034":62809,"_26479":62791,"_5":26820,"_18432":106497,"_25092":106498,"_2540":106499},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3034":62810,"_26479":62791,"_5":26820,"_18432":106501,"_25092":106502,"_2540":106503},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3034":62811,"_26479":62791,"_5":26820,"_18432":106505,"_25092":106506,"_2540":106507},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3034":62812,"_26479":62791,"_5":26820,"_18432":106509,"_25092":106510,"_2540":106511},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3034":62813,"_26479":62791,"_5":26820,"_18432":106513,"_25092":106514,"_2540":106515},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3034":62814,"_26479":62791,"_5":26820,"_18432":106517,"_25092":106518,"_2540":106519},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3034":62815,"_26479":62791,"_18432":106521,"_5":12632,"_25092":62791,"_2540":106522},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3034":62816,"_26479":62791,"_18432":106524,"_5":12632,"_25092":62791,"_2540":106525},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3034":62817,"_26479":62791,"_18432":106527,"_5":12632,"_25092":62791,"_2540":106528},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3034":62818,"_26479":62791,"_18432":106530,"_5":12632,"_25092":106435,"_2540":106531},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3034":62819,"_26479":62791,"_18432":106533,"_5":12632,"_25092":106435,"_2540":106534},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3034":62820,"_26479":62791,"_18432":106536,"_5":12632,"_25092":106435,"_2540":106537},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3034":62821,"_26479":62791,"_18432":106539,"_5":12632,"_25092":106435,"_2540":106540},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3034":62822,"_26479":62791,"_18432":106542,"_5":12632,"_25092":106435,"_2540":106543},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3034":62823,"_26479":62791,"_18432":106545,"_5":12632,"_25092":106443,"_2540":106546},[],"Decide si la CA será raíz o intermedia.",{"_3034":62824,"_26479":62791,"_18432":106548,"_5":12632,"_25092":106443,"_2540":106549},[],"Elige el motor que custodiará la clave.",{"_3034":62825,"_26479":62791,"_18432":106551,"_5":12632,"_25092":106443,"_2540":106552},[],"Define una validez superior a la de los certificados que emitirá.",{"_3034":62826,"_26479":62791,"_18432":106554,"_5":12632,"_25092":106443,"_2540":106555},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3034":62827,"_26479":62791,"_18432":106557,"_5":12632,"_25092":106446,"_2540":106558},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3034":62828,"_26479":62791,"_18432":106560,"_5":12632,"_25092":106450,"_2540":106561},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3034":62829,"_26479":62791,"_18432":106563,"_5":12632,"_25092":106450,"_2540":106564},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3034":62830,"_26479":62791,"_18432":106566,"_5":12632,"_25092":106454,"_2540":106567},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3034":62831,"_26479":62791,"_18432":106569,"_5":12632,"_25092":106458,"_2540":106570},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3034":62832,"_26479":62791,"_18432":106572,"_5":12632,"_25092":106458,"_2540":106573},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3034":62833,"_26479":62791,"_18432":106575,"_5":12632,"_25092":106458,"_2540":106576},[],"`ST`: estado o provincia.",{"_3034":62834,"_26479":62791,"_18432":106578,"_5":12632,"_25092":106458,"_2540":106579},[],"`L`: localidad.",{"_3034":62835,"_26479":62791,"_18432":106581,"_5":12632,"_25092":106458,"_2540":106582},[],"`O`: organización.",{"_3034":62836,"_26479":62791,"_18432":106584,"_5":12632,"_25092":106458,"_2540":106585},[],"`OU`: unidad organizativa.",{"_3034":62837,"_26479":62791,"_18432":106587,"_5":12632,"_25092":106458,"_2540":106588},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3034":62838,"_26479":62791,"_18432":106590,"_5":12632,"_25092":106462,"_2540":106591},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3034":62839,"_26479":62791,"_18432":106593,"_5":12632,"_25092":106462,"_2540":106594},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3034":62840,"_26479":62791,"_18432":106596,"_5":12632,"_25092":106466,"_2540":106597},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3034":62841,"_26479":62791,"_18432":106599,"_5":12632,"_25092":106466,"_2540":106600},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3034":62842,"_26479":62791,"_18432":106602,"_5":12632,"_25092":106470,"_2540":106603},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3034":62843,"_26479":62791,"_18432":106605,"_5":12632,"_25092":106470,"_2540":106606},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3034":62844,"_26479":62791,"_18432":106608,"_5":12632,"_25092":106474,"_2540":106609},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3034":62845,"_26479":62791,"_18432":106611,"_5":12632,"_25092":106478,"_2540":106612},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3034":62846,"_26479":62791,"_18432":106614,"_5":12632,"_25092":106482,"_2540":106615},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3034":62847,"_26479":62791,"_18432":106617,"_5":12632,"_25092":106486,"_2540":106618},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3034":62848,"_26479":62791,"_18432":106620,"_5":12632,"_25092":106490,"_2540":106621},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3034":62849,"_26479":62791,"_18432":106623,"_5":12632,"_25092":106490,"_2540":106624},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3034":62850,"_26479":62791,"_18432":106626,"_5":12632,"_25092":106494,"_2540":106627},[],"Abre una CA desde el inventario para consultar:",{"_3034":62851,"_26479":62791,"_18432":106629,"_5":12632,"_25092":106494,"_2540":106630},[],"Estado y periodo de validez.",{"_3034":62852,"_26479":62791,"_18432":106632,"_5":12632,"_25092":106494,"_2540":106633},[],"Certificado y cadena en formato PEM.",{"_3034":62853,"_26479":62791,"_18432":106635,"_5":12632,"_25092":106494,"_2540":106636},[],"Número de certificados activos, expirados y revocados.",{"_3034":62854,"_26479":62791,"_18432":106638,"_5":12632,"_25092":106494,"_2540":106639},[],"Certificados emitidos en **Issued Certificates**.",{"_3034":62855,"_26479":62791,"_18432":106641,"_5":12632,"_25092":106494,"_2540":106642},[],"CRL vinculada a la autoridad.",{"_3034":62856,"_26479":62791,"_18432":106644,"_5":12632,"_25092":106494,"_2540":106645},[],"Metadatos y motor criptográfico asociado.",{"_3034":62857,"_26479":62791,"_18432":106647,"_5":12632,"_25092":106494,"_2540":106648},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3034":62858,"_26479":62791,"_18432":106650,"_5":12632,"_25092":106498,"_2540":106651},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3034":62859,"_26479":62791,"_18432":106653,"_5":12632,"_25092":106498,"_2540":106654},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3034":62860,"_26479":62791,"_18432":106656,"_5":12632,"_25092":106498,"_2540":106657},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3034":62861,"_26479":62791,"_18432":106659,"_5":12632,"_25092":106498,"_2540":106660},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3034":62862,"_26479":62791,"_18432":106662,"_5":12632,"_25092":106502,"_2540":106663},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3034":62863,"_26479":62791,"_18432":106665,"_5":12632,"_25092":106506,"_2540":106666},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3034":62864,"_26479":62791,"_18432":106668,"_5":12632,"_25092":106510,"_2540":106669},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3034":62865,"_26479":62791,"_18432":106671,"_5":12632,"_25092":106514,"_2540":106672},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3034":62866,"_26479":62791,"_18432":106674,"_5":12632,"_25092":106518,"_2540":106675},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3034":62867,"_26479":62791,"_18432":106677,"_5":12632,"_25092":106518,"_2540":106678},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3034":62868,"_26479":62868,"_5":12947,"_2540":106680,"_26823":106681,"_18432":106682,"_25092":62868},"Perfiles de certificado",[43109,102680,48146,106268],[],{"_3034":62869,"_26479":62868,"_18432":106684,"_5":12632,"_25092":62868,"_2540":106685},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3034":62870,"_26479":62868,"_5":26820,"_18432":106687,"_25092":106688,"_2540":106689},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3034":62871,"_26479":62868,"_5":26820,"_18432":106691,"_25092":106692,"_2540":106693},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-profiles#validez","Validez",{"_3034":62872,"_26479":62868,"_5":26820,"_18432":106695,"_25092":106696,"_2540":106697},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3034":62873,"_26479":62868,"_5":26820,"_18432":106699,"_25092":106700,"_2540":106701},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3034":62874,"_26479":62868,"_5":26820,"_18432":106703,"_25092":106704,"_2540":106705},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3034":62875,"_26479":62868,"_5":26820,"_18432":106707,"_25092":106708,"_2540":106709},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3034":62876,"_26479":62868,"_5":26820,"_18432":106711,"_25092":106712,"_2540":106713},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3034":62877,"_26479":62868,"_5":26820,"_18432":106715,"_25092":106716,"_2540":106717},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3034":62878,"_26479":62868,"_5":26820,"_18432":106719,"_25092":106720,"_2540":106721},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3034":62879,"_26479":62868,"_5":26820,"_18432":106723,"_25092":106724,"_2540":106725},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3034":62880,"_26479":62868,"_5":26820,"_18432":106727,"_25092":106728,"_2540":106729},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3034":62881,"_26479":62868,"_5":26820,"_18432":106731,"_25092":106732,"_2540":106733},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3034":62882,"_26479":62868,"_5":26820,"_18432":106735,"_25092":106736,"_2540":106737},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3034":62883,"_26479":62868,"_5":26820,"_18432":106739,"_25092":106740,"_2540":106741},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3034":62884,"_26479":62868,"_5":26820,"_18432":106743,"_25092":106744,"_2540":106745},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3034":62885,"_26479":62868,"_5":26820,"_18432":106747,"_25092":106748,"_2540":106749},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3034":62886,"_26479":62868,"_18432":106751,"_5":12632,"_25092":62868,"_2540":106752},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3034":62887,"_26479":62868,"_18432":106754,"_5":12632,"_25092":62868,"_2540":106755},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3034":62888,"_26479":62868,"_18432":106757,"_5":12632,"_25092":106692,"_2540":106758},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3034":62889,"_26479":62868,"_18432":106760,"_5":12632,"_25092":106692,"_2540":106761},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3034":62890,"_26479":62868,"_18432":106763,"_5":12632,"_25092":106696,"_2540":106764},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3034":62891,"_26479":62868,"_18432":106766,"_5":12632,"_25092":106700,"_2540":106767},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3034":62892,"_26479":62868,"_18432":106769,"_5":12632,"_25092":106700,"_2540":106770},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3034":62893,"_26479":62868,"_18432":106772,"_5":12632,"_25092":106700,"_2540":106773},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3034":62894,"_26479":62868,"_18432":106775,"_5":12632,"_25092":106704,"_2540":106776},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3034":62895,"_26479":62868,"_18432":106778,"_5":12632,"_25092":106708,"_2540":106779},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3034":62896,"_26479":62868,"_18432":106781,"_5":12632,"_25092":106708,"_2540":106782},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3034":62897,"_26479":62868,"_18432":106784,"_5":12632,"_25092":106712,"_2540":106785},[],"La aplicación criptográfica puede:",{"_3034":62898,"_26479":62868,"_18432":106787,"_5":12632,"_25092":106712,"_2540":106788},[],"permitir o bloquear claves RSA;",{"_3034":62899,"_26479":62868,"_18432":106790,"_5":12632,"_25092":106712,"_2540":106791},[],"limitar los tamaños RSA admitidos;",{"_3034":62900,"_26479":62868,"_18432":106793,"_5":12632,"_25092":106712,"_2540":106794},[],"permitir o bloquear claves ECDSA;",{"_3034":62901,"_26479":62868,"_18432":106796,"_5":12632,"_25092":106712,"_2540":106797},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3034":62902,"_26479":62868,"_18432":106799,"_5":12632,"_25092":106712,"_2540":106800},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3034":62903,"_26479":62868,"_18432":106802,"_5":12632,"_25092":106716,"_2540":106803},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3034":62904,"_26479":62868,"_18432":106805,"_5":12632,"_25092":106716,"_2540":102471},[],{"_3034":62905,"_26479":62868,"_18432":106807,"_5":12632,"_25092":106716,"_2540":106808},[],"Primera opción",{"_3034":62906,"_26479":62868,"_18432":106810,"_5":12632,"_25092":106716,"_2540":106811},[],"Segunda opción",{"_3034":62907,"_26479":62868,"_18432":106813,"_5":12632,"_25092":106716,"_2540":106814},[],"Si no hay ninguna",{"_3034":62908,"_26479":62868,"_18432":106816,"_5":12632,"_25092":106716,"_2540":106817},[],"Firma directa con una CA",{"_3034":62909,"_26479":62868,"_18432":106819,"_5":12632,"_25092":106716,"_2540":106820},[],"`issuance_profile` incluido en la solicitud",{"_3034":62910,"_26479":62868,"_18432":106822,"_5":12632,"_25092":106716,"_2540":106823},[],"`issuance_profile_id` de la solicitud",{"_3034":62911,"_26479":62868,"_18432":106825,"_5":12632,"_25092":106716,"_2540":106826},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3034":62912,"_26479":62868,"_18432":106828,"_5":12632,"_25092":106716,"_2540":106829},[],"Emisión mediante DMS",{"_3034":62913,"_26479":62868,"_18432":106831,"_5":12632,"_25092":106716,"_2540":48711},[],{"_3034":62914,"_26479":62868,"_18432":106833,"_5":12632,"_25092":106716,"_2540":106834},[],"`settings.issuance_profile` incluido en el DMS",{"_3034":62915,"_26479":62868,"_18432":106836,"_5":12632,"_25092":106716,"_2540":106837},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3034":62916,"_26479":62868,"_18432":106839,"_5":12632,"_25092":106716,"_2540":106840},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3034":62917,"_26479":62868,"_18432":106842,"_5":12632,"_25092":106716,"_2540":106843},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3034":62918,"_26479":62868,"_18432":106845,"_5":12632,"_25092":106724,"_2540":106846},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3034":62919,"_26479":62868,"_18432":106848,"_5":12632,"_25092":106728,"_2540":106849},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3034":62920,"_26479":62868,"_18432":106851,"_5":12632,"_25092":106732,"_2540":106852},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3034":62921,"_26479":62868,"_18432":106854,"_5":12632,"_25092":106736,"_2540":106855},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3034":62922,"_26479":62868,"_18432":106857,"_5":12632,"_25092":106740,"_2540":106858},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3034":62923,"_26479":62868,"_18432":106860,"_5":12632,"_25092":106740,"_2540":106861},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3034":62924,"_26479":62868,"_18432":106863,"_5":12632,"_25092":106744,"_2540":106864},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3034":62925,"_26479":62868,"_18432":106866,"_5":12632,"_25092":106744,"_2540":106867},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3034":62926,"_26479":62868,"_18432":106869,"_5":12632,"_25092":106744,"_2540":106870},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3034":62927,"_26479":62868,"_18432":106872,"_5":12632,"_25092":106744,"_2540":106873},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3034":62928,"_26479":62868,"_18432":106875,"_5":12632,"_25092":106748,"_2540":106876},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3034":62929,"_26479":62868,"_18432":106878,"_5":12632,"_25092":106748,"_2540":106879},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3034":62930,"_26479":62930,"_5":12947,"_2540":106881,"_26823":106882,"_18432":106884,"_25092":62930},"Validación de certificados",[43109,102680,48146,106883],"Validación",[],{"_3034":62931,"_26479":62930,"_18432":106886,"_5":12632,"_25092":62930,"_2540":106887},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3034":62932,"_26479":62930,"_5":26820,"_18432":106889,"_25092":106890,"_2540":106891},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3034":62933,"_26479":62930,"_5":26820,"_18432":106893,"_25092":106894,"_2540":106895},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3034":62934,"_26479":62930,"_5":26820,"_18432":106897,"_25092":106898,"_2540":106899},[],"/docs/pr-preview/pr-47/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3034":62935,"_26479":62930,"_18432":106901,"_5":12632,"_25092":62930,"_2540":106902},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3034":62936,"_26479":62930,"_18432":106904,"_5":12632,"_25092":106890,"_2540":106905},[],"Verifica estos criterios juntos:",{"_3034":62937,"_26479":62930,"_18432":106907,"_5":12632,"_25092":106890,"_2540":105895},[],{"_3034":62938,"_26479":62930,"_18432":106909,"_5":12632,"_25092":106890,"_2540":106910},[],"Resultado necesario",{"_3034":62939,"_26479":62930,"_18432":106912,"_5":12632,"_25092":106890,"_2540":106913},[],"Cadena y firma",{"_3034":62940,"_26479":62930,"_18432":106915,"_5":12632,"_25092":106890,"_2540":106916},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3034":62941,"_26479":62930,"_18432":106918,"_5":12632,"_25092":106890,"_2540":106919},[],"Fechas",{"_3034":62942,"_26479":62930,"_18432":106921,"_5":12632,"_25092":106890,"_2540":106922},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3034":62943,"_26479":62930,"_18432":106924,"_5":12632,"_25092":106890,"_2540":102384},[],{"_3034":62944,"_26479":62930,"_18432":106926,"_5":12632,"_25092":106890,"_2540":106927},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3034":62945,"_26479":62930,"_18432":106929,"_5":12632,"_25092":106890,"_2540":106930},[],"Uso",{"_3034":62946,"_26479":62930,"_18432":106932,"_5":12632,"_25092":106890,"_2540":106933},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3034":62947,"_26479":62930,"_18432":106935,"_5":12632,"_25092":106890,"_2540":106936},[],"Revocación",{"_3034":62948,"_26479":62930,"_18432":106938,"_5":12632,"_25092":106890,"_2540":106939},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3034":62949,"_26479":62930,"_18432":106941,"_5":12632,"_25092":106890,"_2540":106942},[],"Autorización",{"_3034":62950,"_26479":62930,"_18432":106944,"_5":12632,"_25092":106890,"_2540":106945},[],"La aplicación permite la acción a esa identidad.",{"_3034":62951,"_26479":62930,"_18432":106947,"_5":12632,"_25092":106890,"_2540":106948},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3034":62952,"_26479":62930,"_18432":106950,"_5":12632,"_25092":106894,"_2540":106951},[],"Mecanismo",{"_3034":62953,"_26479":62930,"_18432":106953,"_5":12632,"_25092":106894,"_2540":106954},[],"Cuándo utilizarlo",{"_3034":62954,"_26479":62930,"_18432":106956,"_5":12632,"_25092":106894,"_2540":106957},[],"Qué debes mantener",{"_3034":62955,"_26479":62930,"_18432":106959,"_5":12632,"_25092":106894,"_2540":48839},[],{"_3034":62956,"_26479":62930,"_18432":106961,"_5":12632,"_25092":106894,"_2540":106962},[],"Consulta del estado de un certificado concreto.",{"_3034":62957,"_26479":62930,"_18432":106964,"_5":12632,"_25092":106894,"_2540":106965},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3034":62958,"_26479":62930,"_18432":106967,"_5":12632,"_25092":106894,"_2540":48848},[],{"_3034":62959,"_26479":62930,"_18432":106969,"_5":12632,"_25092":106894,"_2540":106970},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3034":62960,"_26479":62930,"_18432":106972,"_5":12632,"_25092":106894,"_2540":106973},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3034":62961,"_26479":62930,"_18432":106975,"_5":12632,"_25092":106894,"_2540":106976},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3034":62962,"_26479":62930,"_18432":106978,"_5":12632,"_25092":106894,"_2540":106979},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3034":62963,"_26479":62930,"_18432":106981,"_5":12632,"_25092":106898,"_2540":106982},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3034":62964,"_26479":62930,"_18432":106984,"_5":12632,"_25092":106898,"_2540":106985},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3034":62965,"_26479":62930,"_18432":106987,"_5":12632,"_25092":106898,"_2540":106988},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3034":62966,"_26479":62930,"_18432":106990,"_5":12632,"_25092":106898,"_2540":106991},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3034":62967,"_26479":62930,"_18432":106993,"_5":12632,"_25092":106898,"_2540":106994},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3034":62968,"_26479":62930,"_18432":106996,"_5":12632,"_25092":106898,"_2540":106997},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3034":62969,"_26479":62930,"_18432":106999,"_5":12632,"_25092":106898,"_2540":107000},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3034":62970,"_26479":62930,"_18432":107002,"_5":12632,"_25092":106898,"_2540":107003},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3034":62971,"_26479":62930,"_18432":107005,"_5":12632,"_25092":106898,"_2540":107006},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3034":62972,"_26479":62972,"_5":12947,"_2540":107008,"_26823":107009,"_18432":107010,"_25092":62972},"Certificados",[43109,102680,48146,106268],[],{"_3034":62973,"_26479":62972,"_18432":107012,"_5":12632,"_25092":62972,"_2540":107013},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3034":62974,"_26479":62972,"_5":26820,"_18432":107015,"_25092":107016,"_2540":107017},[],"/docs/pr-preview/pr-47/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3034":62975,"_26479":62972,"_5":26820,"_18432":107019,"_25092":107020,"_2540":107021},[],"/docs/pr-preview/pr-47/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3034":62976,"_26479":62972,"_5":26820,"_18432":107023,"_25092":107024,"_2540":107025},[],"/docs/pr-preview/pr-47/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3034":62977,"_26479":62972,"_5":26820,"_18432":107027,"_25092":107028,"_2540":107029},[],"/docs/pr-preview/pr-47/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3034":62978,"_26479":62972,"_5":26820,"_18432":107031,"_25092":107032,"_2540":107033},[],"/docs/pr-preview/pr-47/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3034":62979,"_26479":62972,"_5":26820,"_18432":107035,"_25092":107036,"_2540":107037},[],"/docs/pr-preview/pr-47/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3034":62980,"_26479":62972,"_5":26820,"_18432":107039,"_25092":107040,"_2540":107041},[],"/docs/pr-preview/pr-47/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3034":62981,"_26479":62972,"_5":26820,"_18432":107043,"_25092":107044,"_2540":107045},[],"/docs/pr-preview/pr-47/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3034":62982,"_26479":62972,"_5":26820,"_18432":107047,"_25092":107048,"_2540":107049},[],"/docs/pr-preview/pr-47/es/platform/pki/certificates#continúa","Continúa",{"_3034":62983,"_26479":62972,"_18432":107051,"_5":12632,"_25092":62972,"_2540":107052},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3034":62984,"_26479":62972,"_18432":107054,"_5":12632,"_25092":107016,"_2540":107055},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3034":62985,"_26479":62972,"_18432":107057,"_5":12632,"_25092":107016,"_2540":107058},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3034":62986,"_26479":62972,"_18432":107060,"_5":12632,"_25092":107020,"_2540":107061},[],"Descarga el PEM e inspecciónalo:",{"_3034":62987,"_26479":62972,"_18432":107063,"_5":12632,"_25092":107020,"_2540":107064},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3034":62988,"_26479":62972,"_18432":107066,"_5":12632,"_25092":107024,"_2540":107067},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3034":62989,"_26479":62972,"_18432":107069,"_5":12632,"_25092":107024,"_2540":107070},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3034":62990,"_26479":62972,"_18432":107072,"_5":12632,"_25092":107024,"_2540":107073},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3034":62991,"_26479":62972,"_18432":107075,"_5":12632,"_25092":107024,"_2540":107076},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3034":62992,"_26479":62972,"_18432":107078,"_5":12632,"_25092":107024,"_2540":107079},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3034":62993,"_26479":62972,"_18432":107081,"_5":12632,"_25092":107024,"_2540":107082},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3034":62994,"_26479":62972,"_18432":107084,"_5":12632,"_25092":107024,"_2540":107085},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3034":62995,"_26479":62972,"_18432":107087,"_5":12632,"_25092":107028,"_2540":107088},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3034":62996,"_26479":62972,"_18432":107090,"_5":12632,"_25092":107032,"_2540":107091},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3034":62997,"_26479":62972,"_18432":107093,"_5":12632,"_25092":107036,"_2540":107094},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3034":62998,"_26479":62972,"_18432":107096,"_5":12632,"_25092":107040,"_2540":107097},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3034":62999,"_26479":62972,"_18432":107099,"_5":12632,"_25092":107040,"_2540":107100},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3034":63000,"_26479":62972,"_18432":107102,"_5":12632,"_25092":107040,"_2540":107103},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3034":63001,"_26479":62972,"_18432":107105,"_5":12632,"_25092":107044,"_2540":107106},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3034":63002,"_26479":62972,"_18432":107108,"_5":12632,"_25092":107044,"_2540":107109},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3034":63003,"_26479":62972,"_18432":107111,"_5":12632,"_25092":107044,"_2540":107112},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3034":63004,"_26479":62972,"_18432":107114,"_5":12632,"_25092":107048,"_2540":107115},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3034":63005,"_26479":62972,"_18432":107117,"_5":12632,"_25092":107048,"_2540":107118},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3034":63006,"_26479":63006,"_5":12947,"_2540":107120,"_26823":107121,"_18432":107123,"_25092":63006},"Ciclo de vida de un certificado",[43109,102680,48146,107122],"Conceptos",[],{"_3034":63007,"_26479":63006,"_18432":107125,"_5":12632,"_25092":63006,"_2540":107126},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3034":63008,"_26479":63006,"_5":26820,"_18432":107128,"_25092":107129,"_2540":107130},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3034":63009,"_26479":63006,"_5":26820,"_18432":107132,"_25092":107133,"_2540":107134},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3034":63010,"_26479":63006,"_5":26820,"_18432":107136,"_25092":107137,"_2540":107138},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3034":63011,"_26479":63006,"_5":26820,"_18432":107140,"_25092":107141,"_2540":107142},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3034":63012,"_26479":63006,"_5":26820,"_18432":107144,"_25092":107145,"_2540":107146},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3034":63013,"_26479":63006,"_5":26820,"_18432":107148,"_25092":107149,"_2540":107150},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3034":63014,"_26479":63006,"_5":26820,"_18432":107152,"_25092":107153,"_2540":107154},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_3034":63015,"_26479":63006,"_5":26820,"_18432":107156,"_25092":107157,"_2540":107158},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3034":63016,"_26479":63006,"_5":26820,"_18432":107160,"_25092":107161,"_2540":107162},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3034":63017,"_26479":63006,"_5":26820,"_18432":107164,"_25092":107165,"_2540":107166},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3034":63018,"_26479":63006,"_18432":107168,"_5":12632,"_25092":63006,"_2540":107169},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3034":63019,"_26479":63006,"_18432":107171,"_5":12632,"_25092":107133,"_2540":107172},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3034":63020,"_26479":63006,"_18432":107174,"_5":12632,"_25092":107137,"_2540":107175},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3034":63021,"_26479":63006,"_18432":107177,"_5":12632,"_25092":107141,"_2540":107178},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3034":63022,"_26479":63006,"_18432":107180,"_5":12632,"_25092":107145,"_2540":107181},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3034":63023,"_26479":63006,"_18432":107183,"_5":12632,"_25092":107149,"_2540":107184},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3034":63024,"_26479":63006,"_18432":107186,"_5":12632,"_25092":107153,"_2540":107187},[],"Lamassu persiste cuatro estados X.509:",{"_3034":63025,"_26479":63006,"_18432":107189,"_5":12632,"_25092":107153,"_2540":107190},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3034":63026,"_26479":63006,"_18432":107192,"_5":12632,"_25092":107153,"_2540":107193},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3034":63027,"_26479":63006,"_18432":107195,"_5":12632,"_25092":107153,"_2540":107196},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3034":63028,"_26479":63006,"_18432":107198,"_5":12632,"_25092":107153,"_2540":107199},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3034":63029,"_26479":63006,"_18432":107201,"_5":12632,"_25092":107153,"_2540":107202},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3034":63030,"_26479":63006,"_18432":107204,"_5":12632,"_25092":107157,"_2540":107205},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3034":63031,"_26479":63006,"_18432":107207,"_5":12632,"_25092":107157,"_2540":107208},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3034":63032,"_26479":63006,"_18432":107210,"_5":12632,"_25092":107157,"_2540":107211},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3034":63033,"_26479":63006,"_18432":107213,"_5":12632,"_25092":107161,"_2540":107214},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3034":63034,"_26479":63006,"_18432":107216,"_5":12632,"_25092":107161,"_2540":107217},[],"Antes de confirmar:",{"_3034":63035,"_26479":63006,"_18432":107219,"_5":12632,"_25092":107161,"_2540":107220},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3034":63036,"_26479":63006,"_18432":107222,"_5":12632,"_25092":107161,"_2540":107223},[],"Distribuye la nueva cadena de confianza.",{"_3034":63037,"_26479":63006,"_18432":107225,"_5":12632,"_25092":107161,"_2540":107226},[],"Reemite las identidades necesarias.",{"_3034":63038,"_26479":63006,"_18432":107228,"_5":12632,"_25092":107161,"_2540":107229},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3034":63039,"_26479":63006,"_18432":107231,"_5":12632,"_25092":107161,"_2540":107232},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3034":63040,"_26479":63006,"_18432":107234,"_5":12632,"_25092":107161,"_2540":107235},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3034":63041,"_26479":63006,"_18432":107237,"_5":12632,"_25092":107165,"_2540":107238},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3034":63042,"_26479":63006,"_18432":107240,"_5":12632,"_25092":107165,"_2540":107241},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3034":63043,"_26479":63006,"_18432":107243,"_5":12632,"_25092":107165,"_2540":107244},[],"Cambios de estado y razones de revocación.",{"_3034":63044,"_26479":63006,"_18432":107246,"_5":12632,"_25092":107165,"_2540":107247},[],"Publicación y vigencia de OCSP y CRLs.",{"_3034":63045,"_26479":63006,"_18432":107249,"_5":12632,"_25092":107165,"_2540":107250},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3034":63046,"_26479":63006,"_18432":107252,"_5":12632,"_25092":107165,"_2540":107253},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3034":63047,"_26479":63047,"_5":12947,"_2540":107255,"_26823":107256,"_18432":107257,"_25092":63047},"Modelo de confianza",[43109,102680,48146,107122],[],{"_3034":63048,"_26479":63047,"_18432":107259,"_5":12632,"_25092":63047,"_2540":107260},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3034":63049,"_26479":63047,"_5":26820,"_18432":107262,"_25092":107263,"_2540":107264},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3034":63050,"_26479":63047,"_5":26820,"_18432":107266,"_25092":107267,"_2540":107268},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3034":63051,"_26479":63047,"_5":26820,"_18432":107270,"_25092":107271,"_2540":107272},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3034":63052,"_26479":63047,"_5":26820,"_18432":107274,"_25092":107275,"_2540":107276},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3034":63053,"_26479":63047,"_5":26820,"_18432":107278,"_25092":107279,"_2540":107280},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3034":63054,"_26479":63047,"_5":26820,"_18432":107282,"_25092":107283,"_2540":107284},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3034":63055,"_26479":63047,"_5":26820,"_18432":107286,"_25092":107287,"_2540":107288},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3034":63056,"_26479":63047,"_5":26820,"_18432":107290,"_25092":107291,"_2540":107292},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3034":63057,"_26479":63047,"_5":26820,"_18432":107294,"_25092":107295,"_2540":107296},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3034":63058,"_26479":63047,"_5":26820,"_18432":107298,"_25092":107299,"_2540":107300},[],"/docs/pr-preview/pr-47/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3034":63059,"_26479":63047,"_18432":107302,"_5":12632,"_25092":63047,"_2540":107303},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3034":63060,"_26479":63047,"_18432":107305,"_5":12632,"_25092":107267,"_2540":107306},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3034":63061,"_26479":63047,"_18432":107308,"_5":12632,"_25092":107271,"_2540":107309},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3034":63062,"_26479":63047,"_18432":107311,"_5":12632,"_25092":107275,"_2540":107312},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3034":63063,"_26479":63047,"_18432":107314,"_5":12632,"_25092":107279,"_2540":107315},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3034":63064,"_26479":63047,"_18432":107317,"_5":12632,"_25092":107283,"_2540":107318},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3034":63065,"_26479":63047,"_18432":107320,"_5":12632,"_25092":107283,"_2540":107321},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3034":63066,"_26479":63047,"_18432":107323,"_5":12632,"_25092":107283,"_2540":107324},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3034":63067,"_26479":63047,"_18432":107326,"_5":12632,"_25092":107283,"_2540":107327},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3034":63068,"_26479":63047,"_18432":107329,"_5":12632,"_25092":107283,"_2540":107330},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3034":63069,"_26479":63047,"_18432":107332,"_5":12632,"_25092":107283,"_2540":107333},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3034":63070,"_26479":63047,"_18432":107335,"_5":12632,"_25092":107287,"_2540":107336},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3034":63071,"_26479":63047,"_18432":107338,"_5":12632,"_25092":107287,"_2540":107339},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3034":63072,"_26479":63047,"_18432":107341,"_5":12632,"_25092":107287,"_2540":107342},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación configuradas en el bloque de re-enrolamiento.",{"_3034":63073,"_26479":63047,"_18432":107344,"_5":12632,"_25092":107287,"_2540":107345},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3034":63074,"_26479":63047,"_18432":107347,"_5":12632,"_25092":107287,"_2540":107348},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3034":63075,"_26479":63047,"_18432":107350,"_5":12632,"_25092":107291,"_2540":107351},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3034":63076,"_26479":63047,"_18432":107353,"_5":12632,"_25092":107291,"_2540":107354},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3034":63077,"_26479":63047,"_18432":107356,"_5":12632,"_25092":107291,"_2540":107357},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3034":63078,"_26479":63047,"_18432":107359,"_5":12632,"_25092":107291,"_2540":107360},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3034":63079,"_26479":63047,"_18432":107362,"_5":12632,"_25092":107291,"_2540":107363},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3034":63080,"_26479":63047,"_18432":107365,"_5":12632,"_25092":107291,"_2540":107366},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3034":63081,"_26479":63047,"_18432":107368,"_5":12632,"_25092":107291,"_2540":107369},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3034":63082,"_26479":63047,"_18432":107371,"_5":12632,"_25092":107295,"_2540":107372},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3034":63083,"_26479":63047,"_18432":107374,"_5":12632,"_25092":107299,"_2540":107375},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3034":63084,"_26479":63047,"_18432":107377,"_5":12632,"_25092":107299,"_2540":107378},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3034":63085,"_26479":63047,"_18432":107380,"_5":12632,"_25092":107299,"_2540":107381},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3034":63086,"_26479":63047,"_18432":107383,"_5":12632,"_25092":107299,"_2540":107384},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3034":63087,"_26479":63047,"_18432":107386,"_5":12632,"_25092":107299,"_2540":107387},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3034":63088,"_26479":63047,"_18432":107389,"_5":12632,"_25092":107299,"_2540":107390},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3034":63089,"_26479":63047,"_18432":107392,"_5":12632,"_25092":107299,"_2540":107393},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3034":63090,"_26479":63090,"_5":12947,"_2540":107395,"_26823":107396,"_18432":107397,"_25092":63090},"Listas de revocación (CRL)",[43109,102680,48146,106883],[],{"_3034":63091,"_26479":63090,"_18432":107399,"_5":12632,"_25092":63090,"_2540":107400},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3034":63092,"_26479":63090,"_5":26820,"_18432":107402,"_25092":107403,"_2540":107404},[],"/docs/pr-preview/pr-47/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3034":63093,"_26479":63090,"_5":26820,"_18432":107406,"_25092":107407,"_2540":107408},[],"/docs/pr-preview/pr-47/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3034":63094,"_26479":63090,"_5":26820,"_18432":107410,"_25092":107411,"_2540":107412},[],"/docs/pr-preview/pr-47/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3034":63095,"_26479":63090,"_5":26820,"_18432":107414,"_25092":107415,"_2540":107416},[],"/docs/pr-preview/pr-47/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3034":63096,"_26479":63090,"_5":26820,"_18432":107418,"_25092":107419,"_2540":107420},[],"/docs/pr-preview/pr-47/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3034":63097,"_26479":63090,"_5":26820,"_18432":107422,"_25092":107423,"_2540":107424},[],"/docs/pr-preview/pr-47/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3034":63098,"_26479":63090,"_5":26820,"_18432":107426,"_25092":107427,"_2540":107428},[],"/docs/pr-preview/pr-47/es/platform/pki/crl#referencias","Referencias",{"_3034":63099,"_26479":63090,"_18432":107430,"_5":12632,"_25092":63090,"_2540":107431},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3034":63100,"_26479":63090,"_18432":107433,"_5":12632,"_25092":107403,"_2540":107434},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3034":63101,"_26479":63090,"_18432":107436,"_5":12632,"_25092":107403,"_2540":107437},[],"Campo de `crl_options`",{"_3034":63102,"_26479":63090,"_18432":107439,"_5":12632,"_25092":107403,"_2540":104176},[],{"_3034":63103,"_26479":63090,"_18432":107441,"_5":12632,"_25092":107403,"_2540":107442},[],"Valor inicial del backend",{"_3034":63104,"_26479":63090,"_18432":107444,"_5":12632,"_25092":107403,"_2540":49326},[],{"_3034":63105,"_26479":63090,"_18432":107446,"_5":12632,"_25092":107403,"_2540":107447},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3034":63106,"_26479":63090,"_18432":107449,"_5":12632,"_25092":107403,"_2540":107450},[],"7 días.",{"_3034":63107,"_26479":63090,"_18432":107452,"_5":12632,"_25092":107403,"_2540":49335},[],{"_3034":63108,"_26479":63090,"_18432":107454,"_5":12632,"_25092":107403,"_2540":107455},[],"Plazo desde la publicación que activa la renovación programada.",{"_3034":63109,"_26479":63090,"_18432":107457,"_5":12632,"_25092":107403,"_2540":107458},[],"6 días y 23 horas.",{"_3034":63110,"_26479":63090,"_18432":107460,"_5":12632,"_25092":107403,"_2540":49344},[],{"_3034":63111,"_26479":63090,"_18432":107462,"_5":12632,"_25092":107403,"_2540":107463},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3034":63112,"_26479":63090,"_18432":107465,"_5":12632,"_25092":107403,"_2540":49350},[],{"_3034":63113,"_26479":63090,"_18432":107467,"_5":12632,"_25092":107403,"_2540":49353},[],{"_3034":63114,"_26479":63090,"_18432":107469,"_5":12632,"_25092":107403,"_2540":107470},[],"Campo de configuración inicializado con el SKI de la CA.",{"_3034":63115,"_26479":63090,"_18432":107472,"_5":12632,"_25092":107403,"_2540":107473},[],"SKI de la CA.",{"_3034":63116,"_26479":63090,"_18432":107475,"_5":12632,"_25092":107403,"_2540":107476},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_3034":63117,"_26479":63090,"_18432":107478,"_5":12632,"_25092":107403,"_2540":107479},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_3034":63118,"_26479":63090,"_18432":107481,"_5":12632,"_25092":107407,"_2540":107482},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_3034":63119,"_26479":63090,"_18432":107484,"_5":12632,"_25092":107407,"_2540":107485},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3034":63120,"_26479":63090,"_18432":107487,"_5":12632,"_25092":107407,"_2540":107488},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3034":63121,"_26479":63090,"_18432":107490,"_5":12632,"_25092":107411,"_2540":107491},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3034":63122,"_26479":63090,"_18432":107493,"_5":12632,"_25092":107411,"_2540":107494},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3034":63123,"_26479":63090,"_18432":107496,"_5":12632,"_25092":107415,"_2540":107497},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_3034":63124,"_26479":63090,"_18432":107499,"_5":12632,"_25092":107415,"_2540":107500},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3034":63125,"_26479":63090,"_18432":107502,"_5":12632,"_25092":107415,"_2540":107503},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3034":63126,"_26479":63090,"_18432":107505,"_5":12632,"_25092":107415,"_2540":107506},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3034":63127,"_26479":63090,"_18432":107508,"_5":12632,"_25092":107415,"_2540":107509},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3034":63128,"_26479":63090,"_18432":107511,"_5":12632,"_25092":107419,"_2540":107512},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3034":63129,"_26479":63090,"_18432":107514,"_5":12632,"_25092":107419,"_2540":104365},[],{"_3034":63130,"_26479":63090,"_18432":107516,"_5":12632,"_25092":107419,"_2540":107517},[],"Path relativo",{"_3034":63131,"_26479":63090,"_18432":107519,"_5":12632,"_25092":107419,"_2540":102471},[],{"_3034":63132,"_26479":63090,"_18432":107521,"_5":12632,"_25092":107419,"_2540":49408},[],{"_3034":63133,"_26479":63090,"_18432":107523,"_5":12632,"_25092":107419,"_2540":49411},[],{"_3034":63134,"_26479":63090,"_18432":107525,"_5":12632,"_25092":107419,"_2540":107526},[],"Consultar `crl_options` y `latest_crl`.",{"_3034":63135,"_26479":63090,"_18432":107528,"_5":12632,"_25092":107419,"_2540":49417},[],{"_3034":63136,"_26479":63090,"_18432":107530,"_5":12632,"_25092":107419,"_2540":49411},[],{"_3034":63137,"_26479":63090,"_18432":107532,"_5":12632,"_25092":107419,"_2540":107533},[],"Sustituir la configuración de CRL.",{"_3034":63138,"_26479":63090,"_18432":107535,"_5":12632,"_25092":107419,"_2540":107536},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_3034":63139,"_26479":63090,"_18432":107538,"_5":12632,"_25092":107419,"_2540":107539},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3034":63140,"_26479":63090,"_18432":107541,"_5":12632,"_25092":107423,"_2540":107542},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3034":63141,"_26479":63090,"_18432":107544,"_5":12632,"_25092":107427,"_2540":107545},[],"RFC 5280: perfil X.509 y CRL.",{"_3034":63142,"_26479":63090,"_18432":107547,"_5":12632,"_25092":107427,"_2540":49437},[],{"_3034":63143,"_26479":63090,"_18432":107549,"_5":12632,"_25092":107427,"_2540":49440},[],{"_3034":63144,"_26479":63090,"_18432":107551,"_5":12632,"_25092":107427,"_2540":107552},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3034":63145,"_26479":63090,"_18432":107554,"_5":12632,"_25092":107427,"_2540":107555},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3034":63146,"_26479":63146,"_5":12947,"_2540":107557,"_26823":107558,"_18432":107559,"_25092":63146},"Claves y motores criptográficos",[43109,102680,48146,106268],[],{"_3034":63147,"_26479":63146,"_18432":107561,"_5":12632,"_25092":63146,"_2540":107562},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3034":63148,"_26479":63146,"_5":26820,"_18432":107564,"_25092":107565,"_2540":107566},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3034":63149,"_26479":63146,"_5":26820,"_18432":107568,"_25092":107569,"_2540":107570},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3034":63150,"_26479":63146,"_5":26820,"_18432":107572,"_25092":107573,"_2540":49465},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#file-system",{"_3034":63151,"_26479":63146,"_5":26820,"_18432":107575,"_25092":107576,"_2540":49469},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#hashicorp-vault",{"_3034":63152,"_26479":63146,"_5":26820,"_18432":107578,"_25092":107579,"_2540":49473},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#aws-secrets-manager",{"_3034":63153,"_26479":63146,"_5":26820,"_18432":107581,"_25092":107582,"_2540":49477},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#aws-kms",{"_3034":63154,"_26479":63146,"_5":26820,"_18432":107584,"_25092":107585,"_2540":49481},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#pkcs11",{"_3034":63155,"_26479":63146,"_5":26820,"_18432":107587,"_25092":107588,"_2540":49485},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#azure-key-vault",{"_3034":63156,"_26479":63146,"_5":26820,"_18432":107590,"_25092":107591,"_2540":107592},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3034":63157,"_26479":63146,"_5":26820,"_18432":107594,"_25092":107595,"_2540":107596},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3034":63158,"_26479":63146,"_5":26820,"_18432":107598,"_25092":107599,"_2540":107600},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3034":63159,"_26479":63146,"_5":26820,"_18432":107602,"_25092":107603,"_2540":107604},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3034":63160,"_26479":63146,"_5":26820,"_18432":107606,"_25092":107607,"_2540":107608},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3034":63161,"_26479":63146,"_5":26820,"_18432":107610,"_25092":107611,"_2540":107612},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3034":63162,"_26479":63146,"_5":26820,"_18432":107614,"_25092":107615,"_2540":107616},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3034":63163,"_26479":63146,"_5":26820,"_18432":107618,"_25092":107619,"_2540":49517},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#sign",{"_3034":63164,"_26479":63146,"_5":26820,"_18432":107621,"_25092":107622,"_2540":49521},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#verify",{"_3034":63165,"_26479":63146,"_5":26820,"_18432":107624,"_25092":107625,"_2540":107626},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3034":63166,"_26479":63146,"_5":26820,"_18432":107628,"_25092":107629,"_2540":107630},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3034":63167,"_26479":63146,"_5":26820,"_18432":107632,"_25092":107633,"_2540":107634},[],"/docs/pr-preview/pr-47/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3034":63168,"_26479":63146,"_18432":107636,"_5":12632,"_25092":63146,"_2540":107637},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3034":63169,"_26479":63146,"_18432":107639,"_5":12632,"_25092":63146,"_2540":107640},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3034":63170,"_26479":63146,"_18432":107642,"_5":12632,"_25092":107565,"_2540":107643},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3034":63171,"_26479":63146,"_18432":107645,"_5":12632,"_25092":107565,"_2540":107646},[],"En la práctica, permite:",{"_3034":63172,"_26479":63146,"_18432":107648,"_5":12632,"_25092":107565,"_2540":107649},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3034":63173,"_26479":63146,"_18432":107651,"_5":12632,"_25092":107565,"_2540":107652},[],"Importar claves creadas externamente.",{"_3034":63174,"_26479":63146,"_18432":107654,"_5":12632,"_25092":107565,"_2540":107655},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3034":63175,"_26479":63146,"_18432":107657,"_5":12632,"_25092":107565,"_2540":107658},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3034":63176,"_26479":63146,"_18432":107660,"_5":12632,"_25092":107569,"_2540":107661},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3034":63177,"_26479":63146,"_18432":107663,"_5":12632,"_25092":107569,"_2540":107664},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3034":63178,"_26479":63146,"_18432":107666,"_5":12632,"_25092":107569,"_2540":107667},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3034":63179,"_26479":63146,"_18432":107669,"_5":12632,"_25092":107573,"_2540":107670},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3034":63180,"_26479":63146,"_18432":107672,"_5":12632,"_25092":107576,"_2540":107673},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3034":63181,"_26479":63146,"_18432":107675,"_5":12632,"_25092":107579,"_2540":107676},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3034":63182,"_26479":63146,"_18432":107678,"_5":12632,"_25092":107582,"_2540":107679},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3034":63183,"_26479":63146,"_18432":107681,"_5":12632,"_25092":107585,"_2540":107682},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3034":63184,"_26479":63146,"_18432":107684,"_5":12632,"_25092":107588,"_2540":107685},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3034":63185,"_26479":63146,"_18432":107687,"_5":12632,"_25092":107588,"_2540":107688},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3034":63186,"_26479":63146,"_18432":107690,"_5":12632,"_25092":107588,"_2540":107691},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3034":63187,"_26479":63146,"_18432":107693,"_5":12632,"_25092":107588,"_2540":107694},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3034":63188,"_26479":63146,"_18432":107696,"_5":12632,"_25092":107591,"_2540":107697},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3034":63189,"_26479":63146,"_18432":107699,"_5":12632,"_25092":107591,"_2540":107700},[],"La tabla incluye los siguientes campos:",{"_3034":63190,"_26479":63146,"_18432":107702,"_5":12632,"_25092":107591,"_2540":107703},[],"**Name**: nombre descriptivo de la clave.",{"_3034":63191,"_26479":63146,"_18432":107705,"_5":12632,"_25092":107591,"_2540":107706},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3034":63192,"_26479":63146,"_18432":107708,"_5":12632,"_25092":107591,"_2540":107709},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3034":63193,"_26479":63146,"_18432":107711,"_5":12632,"_25092":107591,"_2540":107712},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3034":63194,"_26479":63146,"_18432":107714,"_5":12632,"_25092":107591,"_2540":107715},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3034":63195,"_26479":63146,"_18432":107717,"_5":12632,"_25092":107591,"_2540":107718},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3034":63196,"_26479":63146,"_18432":107720,"_5":12632,"_25092":107591,"_2540":107721},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3034":63197,"_26479":63146,"_18432":107723,"_5":12632,"_25092":107591,"_2540":107724},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3034":63198,"_26479":63146,"_18432":107726,"_5":12632,"_25092":107591,"_2540":107727},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3034":63199,"_26479":63146,"_18432":107729,"_5":12632,"_25092":107591,"_2540":107730},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3034":63200,"_26479":63146,"_18432":107732,"_5":12632,"_25092":107591,"_2540":107733},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3034":63201,"_26479":63146,"_18432":107735,"_5":12632,"_25092":107591,"_2540":107736},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3034":63202,"_26479":63146,"_18432":107738,"_5":12632,"_25092":107591,"_2540":107739},[],"**Delete Key** para eliminar la clave del sistema.",{"_3034":63203,"_26479":63146,"_18432":107741,"_5":12632,"_25092":107595,"_2540":107742},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3034":63204,"_26479":63146,"_18432":107744,"_5":12632,"_25092":107599,"_2540":107745},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3034":63205,"_26479":63146,"_18432":107747,"_5":12632,"_25092":107599,"_2540":107748},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3034":63206,"_26479":63146,"_18432":107750,"_5":12632,"_25092":107599,"_2540":107751},[],"**Key Name**: nombre único y descriptivo.",{"_3034":63207,"_26479":63146,"_18432":107753,"_5":12632,"_25092":107599,"_2540":107754},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3034":63208,"_26479":63146,"_18432":107756,"_5":12632,"_25092":107599,"_2540":107757},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3034":63209,"_26479":63146,"_18432":107759,"_5":12632,"_25092":107599,"_2540":107760},[],"**Tags**: metadatos para clasificar la clave.",{"_3034":63210,"_26479":63146,"_18432":107762,"_5":12632,"_25092":107599,"_2540":107763},[],"**Metadata**: información adicional para usos avanzados.",{"_3034":63211,"_26479":63146,"_18432":107765,"_5":12632,"_25092":107603,"_2540":107766},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3034":63212,"_26479":63146,"_18432":107768,"_5":12632,"_25092":107603,"_2540":107769},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3034":63213,"_26479":63146,"_18432":107771,"_5":12632,"_25092":107603,"_2540":107772},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3034":63214,"_26479":63146,"_18432":107774,"_5":12632,"_25092":107603,"_2540":107775},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3034":63215,"_26479":63146,"_18432":107777,"_5":12632,"_25092":107603,"_2540":107778},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3034":63216,"_26479":63146,"_18432":107780,"_5":12632,"_25092":107603,"_2540":107781},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3034":63217,"_26479":63146,"_18432":107783,"_5":12632,"_25092":107603,"_2540":107784},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3034":63218,"_26479":63146,"_18432":107786,"_5":12632,"_25092":107603,"_2540":107787},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3034":63219,"_26479":63146,"_18432":107789,"_5":12632,"_25092":107603,"_2540":107790},[],"**Metadata**: información adicional opcional.",{"_3034":63220,"_26479":63146,"_18432":107792,"_5":12632,"_25092":107603,"_2540":107793},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3034":63221,"_26479":63146,"_18432":107795,"_5":12632,"_25092":107603,"_2540":107796},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3034":63222,"_26479":63146,"_18432":107798,"_5":12632,"_25092":107607,"_2540":107799},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3034":63223,"_26479":63146,"_18432":107801,"_5":12632,"_25092":107611,"_2540":107802},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3034":63224,"_26479":63146,"_18432":107804,"_5":12632,"_25092":107611,"_2540":107805},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3034":63225,"_26479":63146,"_18432":107807,"_5":12632,"_25092":107611,"_2540":107808},[],"**Key Name**: nombre descriptivo.",{"_3034":63226,"_26479":63146,"_18432":107810,"_5":12632,"_25092":107611,"_2540":107811},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3034":63227,"_26479":63146,"_18432":107813,"_5":12632,"_25092":107611,"_2540":107814},[],"**Tags**: etiquetas asociadas.",{"_3034":63228,"_26479":63146,"_18432":107816,"_5":12632,"_25092":107611,"_2540":107817},[],"**Aliases**: nombres alternativos.",{"_3034":63229,"_26479":63146,"_18432":107819,"_5":12632,"_25092":107611,"_2540":107820},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3034":63230,"_26479":63146,"_18432":107822,"_5":12632,"_25092":107611,"_2540":107823},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3034":63231,"_26479":63146,"_18432":107825,"_5":12632,"_25092":107611,"_2540":107826},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3034":63232,"_26479":63146,"_18432":107828,"_5":12632,"_25092":107611,"_2540":107829},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3034":63233,"_26479":63146,"_18432":107831,"_5":12632,"_25092":107615,"_2540":107832},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3034":63234,"_26479":63146,"_18432":107834,"_5":12632,"_25092":107615,"_2540":107835},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3034":63235,"_26479":63146,"_18432":107837,"_5":12632,"_25092":107615,"_2540":107838},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3034":63236,"_26479":63146,"_18432":107840,"_5":12632,"_25092":107619,"_2540":107841},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3034":63237,"_26479":63146,"_18432":107843,"_5":12632,"_25092":107619,"_2540":107844},[],"Campos principales:",{"_3034":63238,"_26479":63146,"_18432":107846,"_5":12632,"_25092":107619,"_2540":107847},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3034":63239,"_26479":63146,"_18432":107849,"_5":12632,"_25092":107619,"_2540":107850},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3034":63240,"_26479":63146,"_18432":107852,"_5":12632,"_25092":107619,"_2540":107853},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3034":63241,"_26479":63146,"_18432":107855,"_5":12632,"_25092":107619,"_2540":107856},[],"**Message**: contenido que se va a firmar.",{"_3034":63242,"_26479":63146,"_18432":107858,"_5":12632,"_25092":107619,"_2540":107859},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3034":63243,"_26479":63146,"_18432":107861,"_5":12632,"_25092":107622,"_2540":107862},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3034":63244,"_26479":63146,"_18432":107864,"_5":12632,"_25092":107622,"_2540":107844},[],{"_3034":63245,"_26479":63146,"_18432":107866,"_5":12632,"_25092":107622,"_2540":107867},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3034":63246,"_26479":63146,"_18432":107869,"_5":12632,"_25092":107622,"_2540":107870},[],"**Message Type**: `Raw` o `Digest`.",{"_3034":63247,"_26479":63146,"_18432":107872,"_5":12632,"_25092":107622,"_2540":107873},[],"**Payload Encoding**: codificación del mensaje.",{"_3034":63248,"_26479":63146,"_18432":107875,"_5":12632,"_25092":107622,"_2540":107876},[],"**Message**: mensaje original o hash.",{"_3034":63249,"_26479":63146,"_18432":107878,"_5":12632,"_25092":107622,"_2540":107879},[],"**Signature**: firma que se desea comprobar.",{"_3034":63250,"_26479":63146,"_18432":107881,"_5":12632,"_25092":107622,"_2540":107882},[],"**Result**: indicador del resultado de la validación.",{"_3034":63251,"_26479":63146,"_18432":107884,"_5":12632,"_25092":107625,"_2540":107885},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3034":63252,"_26479":63146,"_18432":107887,"_5":12632,"_25092":107625,"_2540":107888},[],"Este flujo es útil para:",{"_3034":63253,"_26479":63146,"_18432":107890,"_5":12632,"_25092":107625,"_2540":107891},[],"Solicitar certificados a una CA externa.",{"_3034":63254,"_26479":63146,"_18432":107893,"_5":12632,"_25092":107625,"_2540":107894},[],"Renovar una identidad manteniendo la misma clave.",{"_3034":63255,"_26479":63146,"_18432":107896,"_5":12632,"_25092":107625,"_2540":107897},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3034":63256,"_26479":63146,"_18432":107899,"_5":12632,"_25092":107625,"_2540":107900},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3034":63257,"_26479":63146,"_18432":107902,"_5":12632,"_25092":107625,"_2540":107903},[],"**Organization (O)**: organización o empresa.",{"_3034":63258,"_26479":63146,"_18432":107905,"_5":12632,"_25092":107625,"_2540":107906},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3034":63259,"_26479":63146,"_18432":107908,"_5":12632,"_25092":107625,"_2540":107909},[],"**Country (C)**: código de país de dos letras.",{"_3034":63260,"_26479":63146,"_18432":107911,"_5":12632,"_25092":107625,"_2540":107912},[],"**State / Province (ST)**: estado o provincia.",{"_3034":63261,"_26479":63146,"_18432":107914,"_5":12632,"_25092":107625,"_2540":107915},[],"**Locality (L)**: ciudad o localidad.",{"_3034":63262,"_26479":63146,"_18432":107917,"_5":12632,"_25092":107625,"_2540":107918},[],"**Email Address**: correo de contacto.",{"_3034":63263,"_26479":63146,"_18432":107920,"_5":12632,"_25092":107625,"_2540":107921},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3034":63264,"_26479":63146,"_18432":107923,"_5":12632,"_25092":107625,"_2540":107924},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3034":63265,"_26479":63146,"_18432":107926,"_5":12632,"_25092":107629,"_2540":107927},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3034":63266,"_26479":63146,"_18432":107929,"_5":12632,"_25092":107629,"_2540":49829},[],{"_3034":63267,"_26479":63146,"_18432":107931,"_5":12632,"_25092":107633,"_2540":107932},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3034":63268,"_26479":63268,"_5":12947,"_2540":107934,"_26823":107935,"_18432":107936,"_25092":63268},"Validación online con OCSP",[43109,102680,48146,106883],[],{"_3034":63269,"_26479":63268,"_18432":107938,"_5":12632,"_25092":63268,"_2540":107939},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3034":63270,"_26479":63268,"_5":26820,"_18432":107941,"_25092":107942,"_2540":107943},[],"/docs/pr-preview/pr-47/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3034":63271,"_26479":63268,"_5":26820,"_18432":107945,"_25092":107946,"_2540":107947},[],"/docs/pr-preview/pr-47/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3034":63272,"_26479":63268,"_5":26820,"_18432":107949,"_25092":107950,"_2540":107951},[],"/docs/pr-preview/pr-47/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3034":63273,"_26479":63268,"_5":26820,"_18432":107953,"_25092":107954,"_2540":107955},[],"/docs/pr-preview/pr-47/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3034":63274,"_26479":63268,"_5":26820,"_18432":107957,"_25092":107958,"_2540":107959},[],"/docs/pr-preview/pr-47/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3034":63275,"_26479":63268,"_5":26820,"_18432":107961,"_25092":107962,"_2540":107428},[],"/docs/pr-preview/pr-47/es/platform/pki/ocsp#referencias",{"_3034":63276,"_26479":63268,"_18432":107964,"_5":12632,"_25092":63268,"_2540":107965},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3034":63277,"_26479":63268,"_18432":107967,"_5":12632,"_25092":107942,"_2540":107968},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3034":63278,"_26479":63268,"_18432":107970,"_5":12632,"_25092":107942,"_2540":107971},[],"Estado del registro",{"_3034":63279,"_26479":63268,"_18432":107973,"_5":12632,"_25092":107942,"_2540":107974},[],"Respuesta firmada",{"_3034":63280,"_26479":63268,"_18432":107976,"_5":12632,"_25092":107942,"_2540":47324},[],{"_3034":63281,"_26479":63268,"_18432":107978,"_5":12632,"_25092":107942,"_2540":49879},[],{"_3034":63282,"_26479":63268,"_18432":107980,"_5":12632,"_25092":107942,"_2540":47341},[],{"_3034":63283,"_26479":63268,"_18432":107982,"_5":12632,"_25092":107942,"_2540":107983},[],"`Revoked`, con razón y fecha de revocación.",{"_3034":63284,"_26479":63268,"_18432":107985,"_5":12632,"_25092":107942,"_2540":107986},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3034":63285,"_26479":63268,"_18432":107988,"_5":12632,"_25092":107942,"_2540":107989},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3034":63286,"_26479":63268,"_18432":107991,"_5":12632,"_25092":107942,"_2540":107992},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3034":63287,"_26479":63268,"_18432":107994,"_5":12632,"_25092":107942,"_2540":107995},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3034":63288,"_26479":63268,"_18432":107997,"_5":12632,"_25092":107942,"_2540":107998},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3034":63289,"_26479":63268,"_18432":108000,"_5":12632,"_25092":107946,"_2540":108001},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3034":63290,"_26479":63268,"_18432":108003,"_5":12632,"_25092":107946,"_2540":108004},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3034":63291,"_26479":63268,"_18432":108006,"_5":12632,"_25092":107950,"_2540":108007},[],"El servicio acepta:",{"_3034":63292,"_26479":63268,"_18432":108009,"_5":12632,"_25092":107950,"_2540":104365},[],{"_3034":63293,"_26479":63268,"_18432":108011,"_5":12632,"_25092":107950,"_2540":108012},[],"Ruta del servicio VA",{"_3034":63294,"_26479":63268,"_18432":108014,"_5":12632,"_25092":107950,"_2540":108015},[],"Formato",{"_3034":63295,"_26479":63268,"_18432":108017,"_5":12632,"_25092":107950,"_2540":49919},[],{"_3034":63296,"_26479":63268,"_18432":108019,"_5":12632,"_25092":107950,"_2540":49922},[],{"_3034":63297,"_26479":63268,"_18432":108021,"_5":12632,"_25092":107950,"_2540":108022},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3034":63298,"_26479":63268,"_18432":108024,"_5":12632,"_25092":107950,"_2540":49408},[],{"_3034":63299,"_26479":63268,"_18432":108026,"_5":12632,"_25092":107950,"_2540":49930},[],{"_3034":63300,"_26479":63268,"_18432":108028,"_5":12632,"_25092":107950,"_2540":108029},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3034":63301,"_26479":63268,"_18432":108031,"_5":12632,"_25092":107950,"_2540":108032},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3034":63302,"_26479":63268,"_18432":108034,"_5":12632,"_25092":107954,"_2540":108035},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3034":63303,"_26479":63268,"_18432":108037,"_5":12632,"_25092":107954,"_2540":108038},[],"Genera la solicitud:",{"_3034":63304,"_26479":63268,"_18432":108040,"_5":12632,"_25092":107954,"_2540":108041},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3034":63305,"_26479":63268,"_18432":108043,"_5":12632,"_25092":107954,"_2540":108044},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3034":63306,"_26479":63268,"_18432":108046,"_5":12632,"_25092":107954,"_2540":108047},[],"Verifica el DER recibido:",{"_3034":63307,"_26479":63268,"_18432":108049,"_5":12632,"_25092":107954,"_2540":108050},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3034":63308,"_26479":63268,"_18432":108052,"_5":12632,"_25092":107958,"_2540":108053},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3034":63309,"_26479":63268,"_18432":108055,"_5":12632,"_25092":107958,"_2540":108056},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3034":63310,"_26479":63268,"_18432":108058,"_5":12632,"_25092":107962,"_2540":49963},[],{"_3034":63311,"_26479":63268,"_18432":108060,"_5":12632,"_25092":107962,"_2540":49966},[],{"_3034":63312,"_26479":63268,"_18432":108062,"_5":12632,"_25092":107962,"_2540":108063},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3034":63313,"_26479":63268,"_18432":108065,"_5":12632,"_25092":107962,"_2540":107555},[],{"_3034":63314,"_26479":63314,"_5":12947,"_2540":48146,"_26823":108067,"_18432":108068,"_25092":63314},[43109,102680,48146],[],{"_3034":63315,"_26479":63314,"_18432":108070,"_5":12632,"_25092":63314,"_2540":108071},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3034":63316,"_26479":63314,"_5":26820,"_18432":108073,"_25092":108074,"_2540":105592},[],"/docs/pr-preview/pr-47/es/platform/pki/overview#empieza-aquí",{"_3034":63317,"_26479":63314,"_5":26820,"_18432":108076,"_25092":108077,"_2540":108078},[],"/docs/pr-preview/pr-47/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3034":63318,"_26479":63314,"_5":26820,"_18432":108080,"_25092":108081,"_2540":106114},[],"/docs/pr-preview/pr-47/es/platform/pki/overview#capacidades-principales",{"_3034":63319,"_26479":63314,"_5":26820,"_18432":108083,"_25092":108084,"_2540":106118},[],"/docs/pr-preview/pr-47/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3034":63320,"_26479":63314,"_5":26820,"_18432":108086,"_25092":108087,"_2540":106122},[],"/docs/pr-preview/pr-47/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3034":63321,"_26479":63314,"_5":26820,"_18432":108089,"_25092":108090,"_2540":106126},[],"/docs/pr-preview/pr-47/es/platform/pki/overview#emite-y-controla-certificados",{"_3034":63322,"_26479":63314,"_5":26820,"_18432":108092,"_25092":108093,"_2540":106134},[],"/docs/pr-preview/pr-47/es/platform/pki/overview#publica-el-estado-de-validación",{"_3034":63323,"_26479":63314,"_5":26820,"_18432":108095,"_25092":108096,"_2540":108097},[],"/docs/pr-preview/pr-47/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3034":63324,"_26479":63314,"_5":26820,"_18432":108099,"_25092":108100,"_2540":107049},[],"/docs/pr-preview/pr-47/es/platform/pki/overview#continúa",{"_3034":63325,"_26479":63314,"_18432":108102,"_5":12632,"_25092":63314,"_2540":108103},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3034":63326,"_26479":63314,"_18432":108105,"_5":12632,"_25092":108074,"_2540":108106},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3034":63327,"_26479":63314,"_18432":108108,"_5":12632,"_25092":108074,"_2540":108109},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3034":63328,"_26479":63314,"_18432":108111,"_5":12632,"_25092":108077,"_2540":108112},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3034":63329,"_26479":63314,"_18432":108114,"_5":12632,"_25092":108077,"_2540":108115},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3034":63330,"_26479":63314,"_18432":108117,"_5":12632,"_25092":108077,"_2540":108118},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3034":63331,"_26479":63314,"_18432":108120,"_5":12632,"_25092":108077,"_2540":108121},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3034":63332,"_26479":63314,"_18432":108123,"_5":12632,"_25092":108077,"_2540":108124},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3034":63333,"_26479":63314,"_18432":108126,"_5":12632,"_25092":108084,"_2540":108127},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3034":63334,"_26479":63314,"_18432":108129,"_5":12632,"_25092":108087,"_2540":108130},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3034":63335,"_26479":63314,"_18432":108132,"_5":12632,"_25092":108090,"_2540":108133},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3034":63336,"_26479":63314,"_18432":108135,"_5":12632,"_25092":108093,"_2540":108136},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3034":63337,"_26479":63314,"_18432":108138,"_5":12632,"_25092":108096,"_2540":108139},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3034":63338,"_26479":63314,"_18432":108141,"_5":12632,"_25092":108096,"_2540":108142},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3034":63339,"_26479":63314,"_18432":108144,"_5":12632,"_25092":108096,"_2540":108145},[],"su clave pública corresponda a la clave privada del cliente;",{"_3034":63340,"_26479":63314,"_18432":108147,"_5":12632,"_25092":108096,"_2540":108148},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3034":63341,"_26479":63314,"_18432":108150,"_5":12632,"_25092":108096,"_2540":108151},[],"sus fechas y usos permitan la operación;",{"_3034":63342,"_26479":63314,"_18432":108153,"_5":12632,"_25092":108096,"_2540":108154},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3034":63343,"_26479":63314,"_18432":108156,"_5":12632,"_25092":108096,"_2540":108157},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3034":63344,"_26479":63314,"_18432":108159,"_5":12632,"_25092":108100,"_2540":108160},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3034":63345,"_26479":63314,"_18432":108162,"_5":12632,"_25092":108100,"_2540":108163},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3034":63346,"_26479":63314,"_18432":108165,"_5":12632,"_25092":108100,"_2540":108166},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3034":63347,"_26479":63347,"_5":12947,"_2540":108168,"_26823":108169,"_18432":108170,"_25092":63347},"Crea tu primera CA",[43109,102680,48146,105716],[],{"_3034":63348,"_26479":63347,"_18432":108172,"_5":12632,"_25092":63347,"_2540":108173},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3034":63349,"_26479":63347,"_5":26820,"_18432":108175,"_25092":108176,"_2540":101381},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3034":63350,"_26479":63347,"_5":26820,"_18432":108178,"_25092":108179,"_2540":108180},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_3034":63351,"_26479":63347,"_5":26820,"_18432":108182,"_25092":108183,"_2540":108184},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_3034":63352,"_26479":63347,"_5":26820,"_18432":108186,"_25092":108187,"_2540":108188},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_3034":63353,"_26479":63347,"_5":26820,"_18432":108190,"_25092":108191,"_2540":108192},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_3034":63354,"_26479":63347,"_5":26820,"_18432":108194,"_25092":108195,"_2540":108196},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_3034":63355,"_26479":63347,"_5":26820,"_18432":108198,"_25092":108199,"_2540":108200},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3034":63356,"_26479":63347,"_5":26820,"_18432":108202,"_25092":108203,"_2540":105964},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3034":63357,"_26479":63347,"_5":26820,"_18432":108205,"_25092":108206,"_2540":101405},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3034":63358,"_26479":63347,"_18432":108208,"_5":12632,"_25092":63347,"_2540":108209},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3034":63359,"_26479":63347,"_18432":108211,"_5":12632,"_25092":108176,"_2540":108212},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3034":63360,"_26479":63347,"_18432":108214,"_5":12632,"_25092":108176,"_2540":108215},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3034":63361,"_26479":63347,"_18432":108217,"_5":12632,"_25092":108176,"_2540":108218},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3034":63362,"_26479":63347,"_18432":108220,"_5":12632,"_25092":108176,"_2540":108221},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3034":63363,"_26479":63347,"_18432":108223,"_5":12632,"_25092":108179,"_2540":108224},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3034":63364,"_26479":63347,"_18432":108226,"_5":12632,"_25092":108179,"_2540":108227},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3034":63365,"_26479":63347,"_18432":108229,"_5":12632,"_25092":108183,"_2540":108230},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3034":63366,"_26479":63347,"_18432":108232,"_5":12632,"_25092":108183,"_2540":108233},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3034":63367,"_26479":63347,"_18432":108235,"_5":12632,"_25092":108187,"_2540":108236},[],"Selecciona **Root CA** y completa:",{"_3034":63368,"_26479":63347,"_18432":108238,"_5":12632,"_25092":108187,"_2540":50145},[],{"_3034":63369,"_26479":63347,"_18432":108240,"_5":12632,"_25092":108187,"_2540":108241},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3034":63370,"_26479":63347,"_18432":108243,"_5":12632,"_25092":108187,"_2540":108244},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3034":63371,"_26479":63347,"_18432":108246,"_5":12632,"_25092":108187,"_2540":108247},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3034":63372,"_26479":63347,"_18432":108249,"_5":12632,"_25092":108187,"_2540":108250},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3034":63373,"_26479":63347,"_18432":108252,"_5":12632,"_25092":108191,"_2540":108253},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3034":63374,"_26479":63347,"_18432":108255,"_5":12632,"_25092":108195,"_2540":108256},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3034":63375,"_26479":63347,"_18432":108258,"_5":12632,"_25092":108195,"_2540":108259},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3034":63376,"_26479":63347,"_18432":108261,"_5":12632,"_25092":108199,"_2540":108262},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3034":63377,"_26479":63347,"_18432":108264,"_5":12632,"_25092":108199,"_2540":108265},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3034":63378,"_26479":63347,"_18432":108267,"_5":12632,"_25092":108199,"_2540":108268},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3034":63379,"_26479":63347,"_18432":108270,"_5":12632,"_25092":108203,"_2540":108271},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3034":63380,"_26479":63347,"_18432":108273,"_5":12632,"_25092":108203,"_2540":108274},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3034":63381,"_26479":63347,"_18432":108276,"_5":12632,"_25092":108203,"_2540":108277},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3034":63382,"_26479":63347,"_18432":108279,"_5":12632,"_25092":108203,"_2540":108280},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3034":63383,"_26479":63347,"_18432":108282,"_5":12632,"_25092":108206,"_2540":108283},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3034":63384,"_26479":63384,"_5":12947,"_2540":108285,"_26823":108286,"_18432":108287,"_25092":63384},"Emite y verifica un certificado",[43109,102680,48146,105716],[],{"_3034":63385,"_26479":63384,"_18432":108289,"_5":12632,"_25092":63384,"_2540":108290},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3034":63386,"_26479":63384,"_5":26820,"_18432":108292,"_25092":108293,"_2540":101381},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3034":63387,"_26479":63384,"_5":26820,"_18432":108295,"_25092":108296,"_2540":108297},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3034":63388,"_26479":63384,"_5":26820,"_18432":108299,"_25092":108300,"_2540":108301},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3034":63389,"_26479":63384,"_5":26820,"_18432":108303,"_25092":108304,"_2540":108305},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3034":63390,"_26479":63384,"_5":26820,"_18432":108307,"_25092":108308,"_2540":108309},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3034":63391,"_26479":63384,"_5":26820,"_18432":108311,"_25092":108312,"_2540":108313},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3034":63392,"_26479":63384,"_5":26820,"_18432":108315,"_25092":108316,"_2540":108196},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_3034":63393,"_26479":63384,"_5":26820,"_18432":108318,"_25092":108319,"_2540":108320},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3034":63394,"_26479":63384,"_5":26820,"_18432":108322,"_25092":108323,"_2540":108324},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3034":63395,"_26479":63384,"_5":26820,"_18432":108326,"_25092":108327,"_2540":108328},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3034":63396,"_26479":63384,"_5":26820,"_18432":108330,"_25092":108331,"_2540":105964},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3034":63397,"_26479":63384,"_5":26820,"_18432":108333,"_25092":108334,"_2540":101405},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3034":63398,"_26479":63384,"_18432":108336,"_5":12632,"_25092":63384,"_2540":108337},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3034":63399,"_26479":63384,"_18432":108339,"_5":12632,"_25092":108293,"_2540":108340},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3034":63400,"_26479":63384,"_18432":108342,"_5":12632,"_25092":108293,"_2540":108343},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3034":63401,"_26479":63384,"_18432":108345,"_5":12632,"_25092":108293,"_2540":108346},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3034":63402,"_26479":63384,"_18432":108348,"_5":12632,"_25092":108293,"_2540":108349},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3034":63403,"_26479":63384,"_18432":108351,"_5":12632,"_25092":108293,"_2540":108352},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3034":63404,"_26479":63384,"_18432":108354,"_5":12632,"_25092":108296,"_2540":108355},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3034":63405,"_26479":63384,"_18432":108357,"_5":12632,"_25092":108300,"_2540":108358},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3034":63406,"_26479":63384,"_18432":108360,"_5":12632,"_25092":108300,"_2540":108361},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3034":63407,"_26479":63384,"_18432":108363,"_5":12632,"_25092":108304,"_2540":108364},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3034":63408,"_26479":63384,"_18432":108366,"_5":12632,"_25092":108304,"_2540":108367},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3034":63409,"_26479":63384,"_18432":108369,"_5":12632,"_25092":108308,"_2540":108370},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3034":63410,"_26479":63384,"_18432":108372,"_5":12632,"_25092":108308,"_2540":108373},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3034":63411,"_26479":63384,"_18432":108375,"_5":12632,"_25092":108312,"_2540":108376},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3034":63412,"_26479":63384,"_18432":108378,"_5":12632,"_25092":108316,"_2540":108379},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3034":63413,"_26479":63384,"_18432":108381,"_5":12632,"_25092":108319,"_2540":108382},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3034":63414,"_26479":63384,"_18432":108384,"_5":12632,"_25092":108323,"_2540":108385},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3034":63415,"_26479":63384,"_18432":108387,"_5":12632,"_25092":108323,"_2540":108388},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3034":63416,"_26479":63384,"_18432":108390,"_5":12632,"_25092":108323,"_2540":108391},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3034":63417,"_26479":63384,"_18432":108393,"_5":12632,"_25092":108327,"_2540":108394},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3034":63418,"_26479":63384,"_18432":108396,"_5":12632,"_25092":108327,"_2540":108397},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3034":63419,"_26479":63384,"_18432":108399,"_5":12632,"_25092":108327,"_2540":108400},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3034":63420,"_26479":63384,"_18432":108402,"_5":12632,"_25092":108331,"_2540":106047},[],{"_3034":63421,"_26479":63384,"_18432":108404,"_5":12632,"_25092":108331,"_2540":104814},[],{"_3034":63422,"_26479":63384,"_18432":108406,"_5":12632,"_25092":108331,"_2540":108407},[],"La CA rechaza la emisión",{"_3034":63423,"_26479":63384,"_18432":108409,"_5":12632,"_25092":108331,"_2540":108410},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3034":63424,"_26479":63384,"_18432":108412,"_5":12632,"_25092":108331,"_2540":108413},[],"Sujeto o usos diferentes",{"_3034":63425,"_26479":63384,"_18432":108415,"_5":12632,"_25092":108331,"_2540":108416},[],"Perfil aplicado y valores solicitados.",{"_3034":63426,"_26479":63384,"_18432":108418,"_5":12632,"_25092":108331,"_2540":108419},[],"No se encuentra el emisor",{"_3034":63427,"_26479":63384,"_18432":108421,"_5":12632,"_25092":108331,"_2540":108422},[],"CA descargada y cadena intermedia necesaria.",{"_3034":63428,"_26479":63384,"_18432":108424,"_5":12632,"_25092":108331,"_2540":108425},[],"Falla la vigencia",{"_3034":63429,"_26479":63384,"_18432":108427,"_5":12632,"_25092":108331,"_2540":108428},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3034":63430,"_26479":63384,"_18432":108430,"_5":12632,"_25092":108331,"_2540":108431},[],"Los resúmenes de clave difieren",{"_3034":63431,"_26479":63384,"_18432":108433,"_5":12632,"_25092":108331,"_2540":108434},[],"Archivos de certificado y clave de la misma emisión.",{"_3034":63432,"_26479":63384,"_18432":108436,"_5":12632,"_25092":108331,"_2540":108437},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3034":63433,"_26479":63384,"_18432":108439,"_5":12632,"_25092":108334,"_2540":108440},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3034":63434,"_26479":63384,"_18432":108442,"_5":12632,"_25092":108334,"_2540":108443},[],"Gestionar certificados para inspección, estado y revocación.",{"_3034":63435,"_26479":63384,"_18432":108445,"_5":12632,"_25092":108334,"_2540":108446},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3034":63436,"_26479":63384,"_18432":108448,"_5":12632,"_25092":108334,"_2540":108449},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3034":63437,"_26479":63384,"_18432":108451,"_5":12632,"_25092":108334,"_2540":108452},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3034":63438,"_26479":63438,"_5":12947,"_2540":108454,"_26823":108455,"_18432":108456,"_25092":63438},"Primeros pasos de PKI",[43109,102680,48146,105716],[],{"_3034":63439,"_26479":63438,"_18432":108458,"_5":12632,"_25092":63438,"_2540":108459},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3034":63440,"_26479":63438,"_5":26820,"_18432":108461,"_25092":108462,"_2540":101381},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3034":63441,"_26479":63438,"_5":26820,"_18432":108464,"_25092":108465,"_2540":108466},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3034":63442,"_26479":63438,"_5":26820,"_18432":108468,"_25092":108469,"_2540":105898},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3034":63443,"_26479":63438,"_5":26820,"_18432":108471,"_25092":108472,"_2540":108473},[],"/docs/pr-preview/pr-47/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3034":63444,"_26479":63438,"_18432":108475,"_5":12632,"_25092":63438,"_2540":108476},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3034":63445,"_26479":63438,"_18432":108478,"_5":12632,"_25092":108462,"_2540":108479},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3034":63446,"_26479":63438,"_18432":108481,"_5":12632,"_25092":108462,"_2540":108482},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3034":63447,"_26479":63438,"_18432":108484,"_5":12632,"_25092":108462,"_2540":108485},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3034":63448,"_26479":63438,"_18432":108487,"_5":12632,"_25092":108462,"_2540":108488},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3034":63449,"_26479":63438,"_18432":108490,"_5":12632,"_25092":108462,"_2540":108491},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3034":63450,"_26479":63438,"_18432":108493,"_5":12632,"_25092":108465,"_2540":108494},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3034":63451,"_26479":63438,"_18432":108496,"_5":12632,"_25092":108465,"_2540":108497},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3034":63452,"_26479":63438,"_18432":108499,"_5":12632,"_25092":108465,"_2540":108500},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3034":63453,"_26479":63438,"_18432":108502,"_5":12632,"_25092":108465,"_2540":108503},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3034":63454,"_26479":63438,"_18432":108505,"_5":12632,"_25092":108469,"_2540":108506},[],"Archivo o recurso",{"_3034":63455,"_26479":63438,"_18432":108508,"_5":12632,"_25092":108469,"_2540":105895},[],{"_3034":63456,"_26479":63438,"_18432":108510,"_5":12632,"_25092":108469,"_2540":108511},[],"CA raíz activa y `ca.pem`",{"_3034":63457,"_26479":63438,"_18432":108513,"_5":12632,"_25092":108469,"_2540":108514},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3034":63458,"_26479":63438,"_18432":108516,"_5":12632,"_25092":108469,"_2540":108517},[],"Certificado final y `device.crt`",{"_3034":63459,"_26479":63438,"_18432":108519,"_5":12632,"_25092":108469,"_2540":108520},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3034":63460,"_26479":63438,"_18432":108522,"_5":12632,"_25092":108469,"_2540":108523},[],"Clave privada `device.key`",{"_3034":63461,"_26479":63438,"_18432":108525,"_5":12632,"_25092":108469,"_2540":108526},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3034":63462,"_26479":63438,"_18432":108528,"_5":12632,"_25092":108469,"_2540":108529},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3034":63463,"_26479":63438,"_18432":108531,"_5":12632,"_25092":108472,"_2540":108532},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3034":63464,"_26479":63438,"_18432":108534,"_5":12632,"_25092":108472,"_2540":108535},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3034":63465,"_26479":63438,"_18432":108537,"_5":12632,"_25092":108472,"_2540":108538},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3034":63466,"_26479":63466,"_5":12947,"_2540":108540,"_26823":108541,"_18432":108543,"_25092":63466},"Resolución de problemas PKI",[43109,102680,48146,108542],"Resolución de problemas",[],{"_3034":63467,"_26479":63466,"_18432":108545,"_5":12632,"_25092":63466,"_2540":108546},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3034":63468,"_26479":63466,"_5":26820,"_18432":108548,"_25092":108549,"_2540":108550},[],"/docs/pr-preview/pr-47/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3034":63469,"_26479":63466,"_5":26820,"_18432":108552,"_25092":108553,"_2540":108554},[],"/docs/pr-preview/pr-47/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3034":63470,"_26479":63466,"_5":26820,"_18432":108556,"_25092":108557,"_2540":108558},[],"/docs/pr-preview/pr-47/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3034":63471,"_26479":63466,"_18432":108560,"_5":12632,"_25092":63466,"_2540":108561},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3034":63472,"_26479":63466,"_18432":108563,"_5":12632,"_25092":63466,"_2540":108564},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3034":63473,"_26479":63466,"_18432":108566,"_5":12632,"_25092":108549,"_2540":105895},[],{"_3034":63474,"_26479":63466,"_18432":108568,"_5":12632,"_25092":108549,"_2540":104814},[],{"_3034":63475,"_26479":63466,"_18432":108570,"_5":12632,"_25092":108549,"_2540":101405},[],{"_3034":63476,"_26479":63466,"_18432":108572,"_5":12632,"_25092":108549,"_2540":50481},[],{"_3034":63477,"_26479":63466,"_18432":108574,"_5":12632,"_25092":108549,"_2540":108575},[],"Existe, está activa y sus fechas son utilizables.",{"_3034":63478,"_26479":63466,"_18432":108577,"_5":12632,"_25092":108549,"_2540":108578},[],"Autoridades.",{"_3034":63479,"_26479":63466,"_18432":108580,"_5":12632,"_25092":108549,"_2540":108581},[],"Clave",{"_3034":63480,"_26479":63466,"_18432":108583,"_5":12632,"_25092":108549,"_2540":108584},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3034":63481,"_26479":63466,"_18432":108586,"_5":12632,"_25092":108549,"_2540":108587},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3034":63482,"_26479":63466,"_18432":108589,"_5":12632,"_25092":108549,"_2540":50499},[],{"_3034":63483,"_26479":63466,"_18432":108591,"_5":12632,"_25092":108549,"_2540":108592},[],"PEM correcto y firma verificable.",{"_3034":63484,"_26479":63466,"_18432":108594,"_5":12632,"_25092":108549,"_2540":50505},[],{"_3034":63485,"_26479":63466,"_18432":108596,"_5":12632,"_25092":108549,"_2540":108597},[],"Perfil",{"_3034":63486,"_26479":63466,"_18432":108599,"_5":12632,"_25092":108549,"_2540":108600},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3034":63487,"_26479":63466,"_18432":108602,"_5":12632,"_25092":108549,"_2540":108603},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3034":63488,"_26479":63466,"_18432":108605,"_5":12632,"_25092":108549,"_2540":106047},[],{"_3034":63489,"_26479":63466,"_18432":108607,"_5":12632,"_25092":108549,"_2540":108608},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3034":63490,"_26479":63466,"_18432":108610,"_5":12632,"_25092":108549,"_2540":108611},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3034":63491,"_26479":63466,"_18432":108613,"_5":12632,"_25092":108549,"_2540":108614},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3034":63492,"_26479":63466,"_18432":108616,"_5":12632,"_25092":108549,"_2540":108617},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3034":63493,"_26479":63466,"_18432":108619,"_5":12632,"_25092":108553,"_2540":108620},[],"Revisa cada frontera por separado:",{"_3034":63494,"_26479":63466,"_18432":108622,"_5":12632,"_25092":108553,"_2540":108623},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3034":63495,"_26479":63466,"_18432":108625,"_5":12632,"_25092":108553,"_2540":108626},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3034":63496,"_26479":63466,"_18432":108628,"_5":12632,"_25092":108553,"_2540":108629},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3034":63497,"_26479":63466,"_18432":108631,"_5":12632,"_25092":108553,"_2540":108632},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3034":63498,"_26479":63466,"_18432":108634,"_5":12632,"_25092":108553,"_2540":108635},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3034":63499,"_26479":63466,"_18432":108637,"_5":12632,"_25092":108553,"_2540":108638},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3034":63500,"_26479":63466,"_18432":108640,"_5":12632,"_25092":108557,"_2540":108641},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3034":63501,"_26479":63466,"_18432":108643,"_5":12632,"_25092":108557,"_2540":108644},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3034":63502,"_26479":63502,"_5":12947,"_2540":108646,"_26823":108647,"_18432":108649,"_25092":63502},"3.8.0 a 4.0.0",[43109,108648],"Actualizaciones",[],{"_3034":63503,"_26479":63502,"_18432":108651,"_5":12632,"_25092":63502,"_2540":108652},[],"Cambios de 4.0.0 que afectan a la configuración de los DMS, al almacenamiento del backend, a los eventos de dispositivo y a la autorización; qué puede fallar tras actualizar desde 3.8.0 y cómo comprobarlo.",{"_3034":63504,"_26479":63502,"_5":26820,"_18432":108654,"_25092":108655,"_2540":108656},[],"/docs/pr-preview/pr-47/es/upgrades/3-8-0-to-4-0-0#resumen","Resumen",{"_3034":63505,"_26479":63502,"_5":26820,"_18432":108658,"_25092":108659,"_2540":108660},[],"/docs/pr-preview/pr-47/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3034":63506,"_26479":63502,"_5":26820,"_18432":108662,"_25092":108663,"_2540":108664},[],"/docs/pr-preview/pr-47/es/upgrades/3-8-0-to-4-0-0#webhooks-con-referencias-a-archivos","Webhooks con referencias a archivos",{"_3034":63507,"_26479":63502,"_5":26820,"_18432":108666,"_25092":108667,"_2540":108668},[],"/docs/pr-preview/pr-47/es/upgrades/3-8-0-to-4-0-0#verificación-del-certificado-del-receptor","Verificación del certificado del receptor",{"_3034":63508,"_26479":63502,"_5":26820,"_18432":108670,"_25092":108671,"_2540":108672},[],"/docs/pr-preview/pr-47/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3034":63509,"_26479":63502,"_5":26820,"_18432":108674,"_25092":108675,"_2540":108676},[],"/docs/pr-preview/pr-47/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3034":63510,"_26479":63502,"_5":26820,"_18432":108678,"_25092":108679,"_2540":108680},[],"/docs/pr-preview/pr-47/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3034":63511,"_26479":63502,"_5":26820,"_18432":108682,"_25092":108683,"_2540":108684},[],"/docs/pr-preview/pr-47/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3034":63512,"_26479":63502,"_5":26820,"_18432":108686,"_25092":108687,"_2540":108688},[],"/docs/pr-preview/pr-47/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3034":63513,"_26479":63502,"_5":26820,"_18432":108690,"_25092":108691,"_2540":108692},[],"/docs/pr-preview/pr-47/es/upgrades/3-8-0-to-4-0-0#migraciones-sobre-la-base-de-datos-pki","Migraciones sobre la base de datos pki",{"_3034":63514,"_26479":63502,"_5":26820,"_18432":108694,"_25092":108695,"_2540":108696},[],"/docs/pr-preview/pr-47/es/upgrades/3-8-0-to-4-0-0#comprobaciones-previas-a-la-actualización","Comprobaciones previas a la actualización",{"_3034":63515,"_26479":63502,"_5":26820,"_18432":108698,"_25092":108699,"_2540":108700},[],"/docs/pr-preview/pr-47/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3034":63516,"_26479":63502,"_5":26820,"_18432":108702,"_25092":108703,"_2540":108704},[],"/docs/pr-preview/pr-47/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3034":63517,"_26479":63502,"_5":26820,"_18432":108706,"_25092":108707,"_2540":108708},[],"/docs/pr-preview/pr-47/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3034":63518,"_26479":63502,"_5":26820,"_18432":108710,"_25092":108711,"_2540":108712},[],"/docs/pr-preview/pr-47/es/upgrades/3-8-0-to-4-0-0#cambio-de-autorización","Cambio de autorización",{"_3034":63519,"_26479":63502,"_5":26820,"_18432":108714,"_25092":108715,"_2540":50627},[],"/docs/pr-preview/pr-47/es/upgrades/3-8-0-to-4-0-0#amqp",{"_3034":63520,"_26479":63502,"_5":26820,"_18432":108717,"_25092":108718,"_2540":108719},[],"/docs/pr-preview/pr-47/es/upgrades/3-8-0-to-4-0-0#almacenamiento-local-e-imágenes-de-contenedor","Almacenamiento local e imágenes de contenedor",{"_3034":63521,"_26479":63502,"_5":26820,"_18432":108721,"_25092":108722,"_2540":108723},[],"/docs/pr-preview/pr-47/es/upgrades/3-8-0-to-4-0-0#lista-de-verificación","Lista de verificación",{"_3034":63522,"_26479":63502,"_18432":108725,"_5":12632,"_25092":63502,"_2540":108726},[],"La actualización de 3.8.0 a 4.0.0 migra automáticamente la configuración almacenada de los DMS. Casi todo se convierte sin intervención, pero hay tres cambios que pueden dejar enrolamientos fallando o configuraciones con valores inesperados si no se revisan. Esta página indica qué cambia, qué síntomas produce y qué hacer en cada caso. El comportamiento vigente de cada funcionalidad está en las páginas de DMS.",{"_3034":63523,"_26479":63502,"_18432":108728,"_5":12632,"_25092":63502,"_2540":108729},[],"La actualización también incluye cambios del backend que no afectan solo a los DMS: el almacenamiento se consolida en la base de datos PostgreSQL `pki`, las claves de CA heredadas pueden registrarse en el KMS, los eventos de dispositivo pasan a un almacenamiento propio, `authz` sustituye a la validación de tokens del gateway y el almacenamiento SQLite desaparece. Estos pasos se cubren a partir de Consolidación en PostgreSQL y conviene completarlos antes de las comprobaciones de los DMS.",{"_3034":63524,"_26479":63502,"_18432":108731,"_5":12632,"_25092":63502,"_2540":108732},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3034":63525,"_26479":63502,"_18432":108734,"_5":12632,"_25092":108655,"_2540":108735},[],"Cambio",{"_3034":63526,"_26479":63502,"_18432":108737,"_5":12632,"_25092":108655,"_2540":108738},[],"Quién se ve afectado",{"_3034":63527,"_26479":63502,"_18432":108740,"_5":12632,"_25092":108655,"_2540":108741},[],"Gravedad",{"_3034":63528,"_26479":63502,"_18432":108743,"_5":12632,"_25092":108655,"_2540":108744},[],"Acción",{"_3034":63529,"_26479":63502,"_18432":108746,"_5":12632,"_25092":108655,"_2540":108664},[],{"_3034":63530,"_26479":63502,"_18432":108748,"_5":12632,"_25092":108655,"_2540":108749},[],"DMS con webhook cuyo certificado o clave de mTLS eran rutas de archivo",{"_3034":63531,"_26479":63502,"_18432":108751,"_5":12632,"_25092":108655,"_2540":108752},[],"Alta: los enrolamientos y reenrolamientos que llaman al webhook fallan",{"_3034":63532,"_26479":63502,"_18432":108754,"_5":12632,"_25092":108655,"_2540":108755},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3034":63533,"_26479":63502,"_18432":108757,"_5":12632,"_25092":108655,"_2540":108668},[],{"_3034":63534,"_26479":63502,"_18432":108759,"_5":12632,"_25092":108655,"_2540":108760},[],"DMS con webhook que tenían `validate_server_cert: false`",{"_3034":63535,"_26479":63502,"_18432":108762,"_5":12632,"_25092":108655,"_2540":108763},[],"Media: las credenciales del webhook viajan sin verificar al receptor",{"_3034":63536,"_26479":63502,"_18432":108765,"_5":12632,"_25092":108655,"_2540":108766},[],"Poner `insecure_skip_verify` a `false`",{"_3034":63537,"_26479":63502,"_18432":108768,"_5":12632,"_25092":108655,"_2540":108672},[],{"_3034":63538,"_26479":63502,"_18432":108770,"_5":12632,"_25092":108655,"_2540":108771},[],"Scripts y consolas que editan DMS por API",{"_3034":63539,"_26479":63502,"_18432":108773,"_5":12632,"_25092":108655,"_2540":108774},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3034":63540,"_26479":63502,"_18432":108776,"_5":12632,"_25092":108655,"_2540":108777},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3034":63541,"_26479":63502,"_18432":108779,"_5":12632,"_25092":108655,"_2540":108676},[],{"_3034":63542,"_26479":63502,"_18432":108781,"_5":12632,"_25092":108655,"_2540":108782},[],"Cualquier DMS",{"_3034":63543,"_26479":63502,"_18432":108784,"_5":12632,"_25092":108655,"_2540":108785},[],"Baja: solo informativo",{"_3034":63544,"_26479":63502,"_18432":108787,"_5":12632,"_25092":108655,"_2540":108788},[],"Revisar ambos bloques antes de editar",{"_3034":63545,"_26479":63502,"_18432":108790,"_5":12632,"_25092":108655,"_2540":108680},[],{"_3034":63546,"_26479":63502,"_18432":108792,"_5":12632,"_25092":108655,"_2540":108793},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3034":63547,"_26479":63502,"_18432":108795,"_5":12632,"_25092":108655,"_2540":108796},[],"Baja: la actualización afecta al ID de la URL",{"_3034":63548,"_26479":63502,"_18432":108798,"_5":12632,"_25092":108655,"_2540":108799},[],"Enviar las actualizaciones con el ID en la URL",{"_3034":63549,"_26479":63502,"_18432":108801,"_5":12632,"_25092":108655,"_2540":108688},[],{"_3034":63550,"_26479":63502,"_18432":108803,"_5":12632,"_25092":108655,"_2540":108804},[],"Despliegues en 3.8.0 con bases de datos por servicio",{"_3034":63551,"_26479":63502,"_18432":108806,"_5":12632,"_25092":108655,"_2540":108807},[],"Alta: los servicios no encuentran datos tras la actualización",{"_3034":63552,"_26479":63502,"_18432":108809,"_5":12632,"_25092":108655,"_2540":108810},[],"Mover datos e historial de migraciones a los esquemas de `pki`",{"_3034":63553,"_26479":63502,"_18432":108812,"_5":12632,"_25092":108655,"_2540":108700},[],{"_3034":63554,"_26479":63502,"_18432":108814,"_5":12632,"_25092":108655,"_2540":108815},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3034":63555,"_26479":63502,"_18432":108817,"_5":12632,"_25092":108655,"_2540":108818},[],"Media: las claves de CA quedan sin gestionar",{"_3034":63556,"_26479":63502,"_18432":108820,"_5":12632,"_25092":108655,"_2540":108821},[],"Ejecutar `ca-to-kms-migration`, primero con `--dry-run`",{"_3034":63557,"_26479":63502,"_18432":108823,"_5":12632,"_25092":108655,"_2540":108704},[],{"_3034":63558,"_26479":63502,"_18432":108825,"_5":12632,"_25092":108655,"_2540":108826},[],"Consumidores que leen el campo `events` del dispositivo",{"_3034":63559,"_26479":63502,"_18432":108828,"_5":12632,"_25092":108655,"_2540":108829},[],"Media: el campo desaparece de la representación del dispositivo",{"_3034":63560,"_26479":63502,"_18432":108831,"_5":12632,"_25092":108655,"_2540":108832},[],"Usar los nuevos endpoints de eventos",{"_3034":63561,"_26479":63502,"_18432":108834,"_5":12632,"_25092":108655,"_2540":108708},[],{"_3034":63562,"_26479":63502,"_18432":108836,"_5":12632,"_25092":108655,"_2540":108837},[],"Despliegues con almacenamiento SQLite",{"_3034":63563,"_26479":63502,"_18432":108839,"_5":12632,"_25092":108655,"_2540":108840},[],"Alta: el backend ya no lo admite",{"_3034":63564,"_26479":63502,"_18432":108842,"_5":12632,"_25092":108655,"_2540":108843},[],"Migrar a PostgreSQL antes de actualizar",{"_3034":63565,"_26479":63502,"_18432":108845,"_5":12632,"_25092":108655,"_2540":108712},[],{"_3034":63566,"_26479":63502,"_18432":108847,"_5":12632,"_25092":108655,"_2540":108848},[],"Todos los despliegues",{"_3034":63567,"_26479":63502,"_18432":108850,"_5":12632,"_25092":108655,"_2540":108851},[],"Alta: sin bootstrap no hay administrador",{"_3034":63568,"_26479":63502,"_18432":108853,"_5":12632,"_25092":108655,"_2540":108854},[],"Configurar `authz` según la guía de control de acceso",{"_3034":63569,"_26479":63502,"_18432":108856,"_5":12632,"_25092":108655,"_2540":108857},[],"AMQP sobre TLS",{"_3034":63570,"_26479":63502,"_18432":108859,"_5":12632,"_25092":108655,"_2540":108860},[],"Despliegues con TLS en el broker de mensajería",{"_3034":63571,"_26479":63502,"_18432":108862,"_5":12632,"_25092":108655,"_2540":108863},[],"Media: los clientes en texto plano son rechazados",{"_3034":63572,"_26479":63502,"_18432":108865,"_5":12632,"_25092":108655,"_2540":108866},[],"Apuntar los clientes al puerto TLS y confiar en el certificado del broker",{"_3034":63573,"_26479":63502,"_18432":108868,"_5":12632,"_25092":108655,"_2540":108719},[],{"_3034":63574,"_26479":63502,"_18432":108870,"_5":12632,"_25092":108655,"_2540":108871},[],"Motores de KMS en sistema de archivos y CRLs locales",{"_3034":63575,"_26479":63502,"_18432":108873,"_5":12632,"_25092":108655,"_2540":108874},[],"Media: los datos pueden quedar atrás",{"_3034":63576,"_26479":63502,"_18432":108876,"_5":12632,"_25092":108655,"_2540":108877},[],"Preservar volúmenes, trasladar los datos y revisar permisos",{"_3034":63577,"_26479":63502,"_18432":108879,"_5":12632,"_25092":108655,"_2540":108684},[],{"_3034":63578,"_26479":63502,"_18432":108881,"_5":12632,"_25092":108655,"_2540":108882},[],"Consumidores que leen o comparan los valores de `type` del certificado",{"_3034":63579,"_26479":63502,"_18432":108884,"_5":12632,"_25092":108655,"_2540":108885},[],"Baja: dos valores almacenados cambian de nombre",{"_3034":63580,"_26479":63502,"_18432":108887,"_5":12632,"_25092":108655,"_2540":108888},[],"Adaptar los consumidores a los valores nuevos",{"_3034":63581,"_26479":63502,"_18432":108890,"_5":12632,"_25092":108655,"_2540":108891},[],"Al final se incluye una lista de verificación para confirmar el resultado.",{"_3034":63582,"_26479":63502,"_18432":108893,"_5":12632,"_25092":108659,"_2540":108894},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual. Los campos se renombran de la siguiente manera:",{"_3034":63583,"_26479":63502,"_18432":108896,"_5":12632,"_25092":108659,"_2540":108897},[],"Campo en 3.8.0",{"_3034":63584,"_26479":63502,"_18432":108899,"_5":12632,"_25092":108659,"_2540":108900},[],"Campo en 4.0.0",{"_3034":63585,"_26479":63502,"_18432":108902,"_5":12632,"_25092":108659,"_2540":50815},[],{"_3034":63586,"_26479":63502,"_18432":108904,"_5":12632,"_25092":108659,"_2540":108905},[],"`insecure_skip_verify` (con el valor negado)",{"_3034":63587,"_26479":63502,"_18432":108907,"_5":12632,"_25092":108659,"_2540":50821},[],{"_3034":63588,"_26479":63502,"_18432":108909,"_5":12632,"_25092":108659,"_2540":50824},[],{"_3034":63589,"_26479":63502,"_18432":108911,"_5":12632,"_25092":108659,"_2540":50827},[],{"_3034":63590,"_26479":63502,"_18432":108913,"_5":12632,"_25092":108659,"_2540":50830},[],{"_3034":63591,"_26479":63502,"_18432":108915,"_5":12632,"_25092":108659,"_2540":50833},[],{"_3034":63592,"_26479":63502,"_18432":108917,"_5":12632,"_25092":108659,"_2540":50836},[],{"_3034":63593,"_26479":63502,"_18432":108919,"_5":12632,"_25092":108659,"_2540":108920},[],"Cuando el certificado y la clave heredados de mTLS son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren ninguna acción. Los dos casos siguientes son los que sí la requieren.",{"_3034":63594,"_26479":63502,"_18432":108922,"_5":12632,"_25092":108663,"_2540":108923},[],"Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos, y lo hace en cada llamada, sea cual sea el modo de autenticación configurado. El efecto es que todos los enrolamientos y reenrolamientos que invocan ese webhook fallan hasta corregir la configuración.",{"_3034":63595,"_26479":63502,"_18432":108925,"_5":12632,"_25092":108663,"_2540":108926},[],"Para corregirlo hay dos opciones, según el webhook:",{"_3034":63596,"_26479":63502,"_18432":108928,"_5":12632,"_25092":108663,"_2540":108929},[],"Si el webhook usa mTLS, volver a introducir el certificado y la clave como PEM, en Base64 o en texto plano.",{"_3034":63597,"_26479":63502,"_18432":108931,"_5":12632,"_25092":108663,"_2540":108932},[],"Si el webhook no usa mTLS, eliminar los campos de archivo sobrantes.",{"_3034":63598,"_26479":63502,"_18432":108934,"_5":12632,"_25092":108663,"_2540":108935},[],"Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`).",{"_3034":63599,"_26479":63502,"_18432":108937,"_5":12632,"_25092":108663,"_2540":108938},[],"Existe una variante del mismo problema: si la configuración almacenada guarda rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content`, toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`) falla la validación. Los ajustes se sustituyen al completo, de modo que la configuración almacenada debe reenviarse con el certificado y la clave como PEM.",{"_3034":63600,"_26479":63502,"_18432":108940,"_5":12632,"_25092":108667,"_2540":108941},[],"Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`. Por tanto, la verificación del certificado del receptor sigue sin realizarse hasta que se ponga ese campo a `false`.",{"_3034":63601,"_26479":63502,"_18432":108943,"_5":12632,"_25092":108667,"_2540":108944},[],"Conviene corregirlo en cada configuración migrada. El canal de autorización del webhook transporta la API key o el bearer token, de modo que saltarse la verificación expone esas credenciales a un atacante con posición de red. Solo se justifica mantener `insecure_skip_verify: true` si el certificado del receptor no es verificable de forma deliberada.",{"_3034":63602,"_26479":63502,"_18432":108946,"_5":12632,"_25092":108671,"_2540":108947},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`.",{"_3034":63603,"_26479":63502,"_18432":108949,"_5":12632,"_25092":108671,"_2540":108950},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3034":63604,"_26479":63502,"_18432":108952,"_5":12632,"_25092":108671,"_2540":108953},[],"Lo que sí cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se ignora en silencio porque los campos JSON desconocidos se descartan, y las respuestas GET ya no lo incluyen. En consecuencia, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin devolver ningún error. Para evitarlo, leer siempre el DMS antes de enviar una edición y reutilizar el formato que devuelve la API.",{"_3034":63605,"_26479":63502,"_18432":108955,"_5":12632,"_25092":108675,"_2540":108956},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero antes de editar un DMS conviene leer ambos bloques para no modificar uno creyendo que se está editando el otro.",{"_3034":63606,"_26479":63502,"_18432":108958,"_5":12632,"_25092":108675,"_2540":108959},[],"Si la versión de la consola no expone los ajustes independientes, pueden editarse mediante la API DMS.",{"_3034":63607,"_26479":63502,"_18432":108961,"_5":12632,"_25092":108679,"_2540":108962},[],"`PUT /v1/dms/:id` toma ahora el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora. Actualizar los clientes que dependían del ID del cuerpo.",{"_3034":63608,"_26479":63502,"_18432":108964,"_5":12632,"_25092":108683,"_2540":108965},[],"Los valores de tipo de certificado almacenados en los datos cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY`, y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adaptar los consumidores que leen o comparan esos valores.",{"_3034":63609,"_26479":63502,"_18432":108967,"_5":12632,"_25092":108687,"_2540":108968},[],"El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El `authz` autónomo puede usar una base de datos `authz` separada; el monolítico de desarrollo almacena sus datos en el esquema `authz` de `pki`. WFX conserva su propia base `wfx`.",{"_3034":63610,"_26479":63502,"_18432":108970,"_5":12632,"_25092":108687,"_2540":108971},[],"Las instalaciones en 3.8.0 con bases de datos separadas por servicio deben mover sus datos y su historial de migraciones al esquema de `pki` correspondiente, preservando estructura, índices, restricciones y datos.",{"_3034":63611,"_26479":63502,"_18432":108973,"_5":12632,"_25092":108687,"_2540":108974},[],"Las herramientas de migración aplican migraciones sobre un esquema existente; ningún comando mueve datos entre bases. El procedimiento de transferencia de esta página es provisional: verifícalo con los artefactos definitivos de la versión antes de actualizar producción.",{"_3034":63612,"_26479":63502,"_18432":108976,"_5":12632,"_25092":108687,"_2540":108977},[],"Planifica la transferencia como cualquier migración de datos: toma antes una copia de seguridad verificable de PostgreSQL, programa la parada de servicio e impide las escrituras mientras se copian los datos.",{"_3034":63613,"_26479":63502,"_18432":108979,"_5":12632,"_25092":108691,"_2540":108980},[],"Para la migración manual, `goose-lamassu` exige `search_path=<esquema>` en la cadena de conexión y debe ejecutarse contra la base `pki`. El binario no valida el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutar el comando:",{"_3034":63614,"_26479":63502,"_18432":108982,"_5":12632,"_25092":108691,"_2540":108983},[],"Usa las opciones de conexión y TLS adecuadas para tu entorno y repítelo por esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`.",{"_3034":63615,"_26479":63502,"_18432":108985,"_5":12632,"_25092":108691,"_2540":108986},[],"La documentación de `goose-lamassu` aún muestra ejemplos por base de datos (`dbname=ca`, `dbname=kms`) y afirma que la herramienta valida el nombre de la base de datos. No lo hace: solo valida `search_path`. Sigue la forma con `dbname=pki` de arriba.",{"_3034":63616,"_26479":63502,"_18432":108988,"_5":12632,"_25092":108695,"_2540":108989},[],"La migración del esquema de CA añade una restricción UNIQUE sobre `ca_certificates.id`, de modo que aborta si ya existen IDs de CA duplicados. Resuelve cualquier ID de CA duplicado antes de actualizar. Las importaciones ya rechazan IDs de CA duplicados con `409`, así que normalmente no pueden introducirse duplicados nuevos.",{"_3034":63617,"_26479":63502,"_18432":108991,"_5":12632,"_25092":108695,"_2540":108992},[],"La migración del esquema del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con el error `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena `engine_id` antes de ejecutar las migraciones.",{"_3034":63618,"_26479":63502,"_18432":108994,"_5":12632,"_25092":108695,"_2540":108995},[],"Esa misma migración elimina con un `NOTICE` los alias iguales a un key\\_id existente, porque los identificadores se resuelven ahora como key\\_id antes que como alias; los alias afectados se descartan en lugar de redirigirse.",{"_3034":63619,"_26479":63502,"_18432":108997,"_5":12632,"_25092":108699,"_2540":108998},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3034":63620,"_26479":63502,"_18432":109000,"_5":12632,"_25092":108699,"_2540":109001},[],"`key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_3034":63621,"_26479":63502,"_18432":109003,"_5":12632,"_25092":108699,"_2540":109004},[],"La herramienta es idempotente: las claves ya presentes en el KMS se omiten, de modo que puede ejecutarse varias veces con seguridad.",{"_3034":63622,"_26479":63502,"_18432":109006,"_5":12632,"_25092":108699,"_2540":109007},[],"Los certificados que no puedan leerse, o que carezcan de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los registros y resuelve los casos afectados.",{"_3034":63623,"_26479":63502,"_18432":109009,"_5":12632,"_25092":108699,"_2540":109010},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta omite esa clave como fallida y sale con código `1`, lo que hace fallar un hook `pre-upgrade` de Helm. Resuelve el conflicto manualmente antes de volver a ejecutarla.",{"_3034":63624,"_26479":63502,"_18432":109012,"_5":12632,"_25092":108699,"_2540":109013},[],"Ejecútala primero con `--dry-run` para analizar e informar sin escribir en el almacenamiento del KMS, y después ejecuta la migración real:",{"_3034":63625,"_26479":63502,"_18432":109015,"_5":12632,"_25092":108699,"_2540":109016},[],"Apunta la configuración `storage` de la herramienta a la base `pki`: en 4.0.0 los datos de CA y del KMS viven en los esquemas `ca` y `kms` de la misma base de datos. El README de la herramienta sigue describiendo el modelo de dos bases anterior a 4.0.0, así que no copies sus ejemplos. En Kubernetes, la forma recomendada es ejecutar la migración como un Job de hook `pre-upgrade` de Helm; consulta el README de la herramienta (`backend/cmd/ca-to-kms-migration/README.md` en el repositorio).",{"_3034":63626,"_26479":63502,"_18432":109018,"_5":12632,"_25092":108703,"_2540":109019},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado en `device_events`. La actualización transforma los datos existentes.",{"_3034":63627,"_26479":63502,"_18432":109021,"_5":12632,"_25092":108703,"_2540":109022},[],"El campo `events` ya no aparece en la representación del dispositivo. Adapta los consumidores que lo leen y usa los nuevos endpoints:",{"_3034":63628,"_26479":63502,"_18432":109024,"_5":12632,"_25092":108703,"_2540":109025},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3034":63629,"_26479":63502,"_18432":109027,"_5":12632,"_25092":108703,"_2540":109028},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3034":63630,"_26479":63502,"_18432":109030,"_5":12632,"_25092":108703,"_2540":109031},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite los eventos vía Server-Sent Events, con un keepalive cada 15 segundos. SSE responde `501` cuando está deshabilitado en el despliegue.",{"_3034":63631,"_26479":63502,"_18432":109033,"_5":12632,"_25092":108703,"_2540":109034},[],"SSE necesita difundir entre las instancias del servicio, así que cada instancia enlaza su propia cola AMQP duradera, derivada del ID de servicio `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se limpien fuera de banda: configura en el broker una política de expiración o limpieza para no acumular colas.",{"_3034":63632,"_26479":63502,"_18432":109036,"_5":12632,"_25092":108707,"_2540":109037},[],"El motor de almacenamiento SQLite se elimina. El único motor de almacenamiento registrado en 4.0.0 es PostgreSQL: los motores `couch_db` y `dynamo_db` no están registrados en el árbol de 4.0.0 — sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor — así que los despliegues que usaban SQLite, o que aún ejecutan `couch_db` o `dynamo_db`, deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` como se describe en Consolidación en PostgreSQL.",{"_3034":63633,"_26479":63502,"_18432":109039,"_5":12632,"_25092":108711,"_2540":109040},[],"4.0.0 incorpora el servicio `authz`, que valida los tokens contra el endpoint JWKS del proveedor OIDC y aplica autorización de grano fino a las peticiones de los servicios. La validación ya no usa la política JWT anterior del gateway.",{"_3034":63634,"_26479":63502,"_18432":109042,"_5":12632,"_25092":108711,"_2540":109043},[],"Configura el endpoint JWKS, las credenciales para acceder a los datos de PKI y de authz, las políticas y un principal inicial de bootstrap. Sin un principal coincidente no existe administrador inicial implícito, de modo que nadie puede administrar la PKI.",{"_3034":63635,"_26479":63502,"_18432":109045,"_5":12632,"_25092":108711,"_2540":109046},[],"La página de control de acceso documenta los principales, las políticas y el primer administrador. La página de instalación con Helm documenta `services.authz.bootstrap` y cómo lo aplica el job de preinstalación.",{"_3034":63636,"_26479":63502,"_18432":109048,"_5":12632,"_25092":108715,"_2540":109049},[],"Si TLS está habilitado para AMQP, los clientes se conectan al puerto TLS del broker — `amqps`, habitualmente `5671` — y deben confiar en su certificado. Verifica la configuración efectiva antes de actualizar, especialmente si antes se usaba AMQP en texto plano. El puerto es configurable por el operador; comprueba el de tu despliegue.",{"_3034":63637,"_26479":63502,"_18432":109051,"_5":12632,"_25092":108718,"_2540":109052},[],"Si el KMS usa un motor de sistema de archivos o la VA guarda CRLs localmente, preserva esos datos durante la actualización y, cuando sea necesario, trasládalos. Asegúrate de que la identidad con la que corren los servicios puede acceder a las claves, las CRLs y los dispositivos criptográficos, y verifica su funcionamiento antes de retirar los datos originales.",{"_3034":63638,"_26479":63502,"_18432":109054,"_5":12632,"_25092":108718,"_2540":109055},[],"Las imágenes de servicio se basan en distroless sin root, con el UID numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root (el mismo UID numérico). Si montas volúmenes con claves o CRLs, asegúrate de que la propiedad y los permisos permiten a esa identidad leerlos y, cuando corresponda, escribirlos.",{"_3034":63639,"_26479":63502,"_18432":109057,"_5":12632,"_25092":108722,"_2540":109058},[],"Tras aplicar la actualización, comprobar en este orden:",{"_3034":63640,"_26479":63502,"_18432":109060,"_5":12632,"_25092":108722,"_2540":109061},[],"**Bases de datos.** Confirmar que cada servicio lee la base `pki` con su propio esquema (`kms`, `ca`, `va`, `devicemanager`, `dmsmanager`, `alerts`), que los datos de `authz` y `wfx` son accesibles y que el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS. Si el despliegue usaba SQLite, confirmar que el nuevo almacenamiento en PostgreSQL funciona de extremo a extremo.",{"_3034":63641,"_26479":63502,"_18432":109063,"_5":12632,"_25092":108722,"_2540":109064},[],"**Claves de CA heredadas.** Ejecutar `ca-to-kms-migration` con `--dry-run`, revisar el informe y los avisos, ejecutarla sin la opción y confirmar que las claves esperadas aparecen en el KMS.",{"_3034":63642,"_26479":63502,"_18432":109066,"_5":12632,"_25092":108722,"_2540":109067},[],"**Eventos de dispositivo.** Consultar `GET /v1/devices/:id/events` en dispositivos con eventos históricos, confirmar que los datos se migraron y apuntar los consumidores a los nuevos endpoints.",{"_3034":63643,"_26479":63502,"_18432":109069,"_5":12632,"_25092":108722,"_2540":109070},[],"**Autorización.** Autenticarse con el principal de bootstrap y confirmar que la administración funciona; comprobar que una identidad sin permiso recibe `403`; revisar los permisos de clientes e integraciones.",{"_3034":63644,"_26479":63502,"_18432":109072,"_5":12632,"_25092":108722,"_2540":109073},[],"**AMQP.** Confirmar que el backend se conecta al broker con la configuración TLS esperada y que la política de limpieza de las colas de SSE está en marcha.",{"_3034":63645,"_26479":63502,"_18432":109075,"_5":12632,"_25092":108722,"_2540":109076},[],"**Almacenamiento local.** Confirmar que los servicios pueden leer las claves del KMS y las CRLs de sus volúmenes, y que la emisión y la recuperación de CRLs funcionan.",{"_3034":63646,"_26479":63502,"_18432":109078,"_5":12632,"_25092":108722,"_2540":109079},[],"**Webhooks sin campos de archivo.** Listar los DMS que usan webhook en enrolamiento o reenrolamiento y confirmar que cada bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3034":63647,"_26479":63502,"_18432":109081,"_5":12632,"_25092":108722,"_2540":109082},[],"**Verificación del receptor.** Confirmar que `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3034":63648,"_26479":63502,"_18432":109084,"_5":12632,"_25092":108722,"_2540":109085},[],"**Entrega.** Lanzar, o esperar a que ocurra, un enrolamiento o reenrolamiento a través de cada webhook migrado y confirmar que la llamada de autorización se completa.",{"_3034":63649,"_26479":63502,"_18432":109087,"_5":12632,"_25092":108722,"_2540":109088},[],"**Conjunto de confianza.** Leer `est_rfc7030_settings.client_certificate_settings.validation_cas` y confirmar que contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3034":63650,"_26479":63502,"_18432":109090,"_5":12632,"_25092":108722,"_2540":109091},[],"**Clientes de la API.** Actualizar los scripts y consolas que usen el formato antiguo del DMS (`additional_validation_cas` plano, o los campos `mtls`, `apikey` y `oidc` heredados), ya que descartan esos valores sin avisar, y confirmar que las actualizaciones del DMS envían el ID en la URL.",{"_3034":63651,"_26479":63502,"_18432":109093,"_5":12632,"_25092":108722,"_2540":105576},[],{"_3034":63652,"_26479":63502,"_18432":109095,"_5":12632,"_25092":108722,"_2540":109096},[],"<Card title=\"API DMS\" href=\"/docs/api-reference/dms-manager\" />",{"_3034":63653,"_26479":63502,"_18432":109098,"_5":12632,"_25092":108722,"_2540":109099},[],"<Card title=\"Control de acceso\" href=\"/docs/platform/administration/access-control\" />",{"_51022":109101,"_51024":109102,"_51026":109103,"_51028":109104,"_16002":2562,"_61127":2562},"spanish",[2540,26479,5,25092],{"_2540":22072,"_26479":22072,"_5":22072,"_25092":22072},{"_2540":109105,"_26479":111628,"_5":114151,"_25092":116674},{"_4054":109106,"_51032":109107,"_5":22072},{"_12687":4017,"_13040":18804,"_13047":3540,"_11394":3568,"_25216":15215,"_17487":2789,"_12708":6730,"_12715":3307,"_25619":6262,"_25995":6068,"_26016":3214,"_25637":2964,"_30448":5964,"_26027":6560,"_26055":6004,"_30455":13076,"_30458":6460,"_30461":4208,"_30464":10258,"_26345":2614,"_30469":3556,"_30471":2816,"_26375":6636,"_26335":2844,"_30475":13792,"_30478":2817,"_30480":5241,"_26045":5090,"_26340":14540,"_26393":14995,"_30485":10754,"_30487":4145,"_30489":3325,"_30491":6112,"_30493":4489,"_3