34,"_35120":50537,"_35122":50540,"_35124":50543,"_35126":50546,"_35128":50549,"_35130":50552,"_35132":50555,"_35134":50558,"_35136":50561,"_35138":50564,"_35140":50567,"_35142":50570,"_35144":50573,"_35146":50576,"_35148":50579,"_35150":50582,"_35152":50585,"_35154":50588,"_35156":50591,"_35158":50594,"_35160":50597,"_35163":50600,"_35165":50603,"_35167":50606,"_35169":50609,"_35171":50612,"_35173":50615,"_35175":50618,"_35177":50621,"_35179":50624,"_35181":50627,"_35183":50630,"_35185":50633,"_35187":50636,"_35189":50639,"_35191":50642,"_35193":50645,"_35195":50648,"_35197":50651,"_35199":50654,"_35201":50657,"_35203":50660,"_35205":50663,"_35207":50666,"_35209":50669,"_35211":50672,"_35213":50675,"_35215":50678,"_35217":50681,"_35219":50684,"_35221":50687,"_35223":50690,"_35225":50693,"_35227":50696,"_35229":50699,"_35231":50702,"_35233":50705,"_35235":50708,"_35237":50711,"_35239":50714,"_35241":50717,"_35243":50720,"_35245":50723,"_35247":50725,"_35249":50728},{"_3023":15,"_26291":15,"_5":12871,"_2529":42853,"_26635":42854,"_18309":42858,"_24913":15},"Deploy from AWS Marketplace",[42855,42856,42857],"Docs","Deployment","Other models",[],{"_3023":16,"_26291":15,"_18309":42860,"_5":12556,"_24913":15,"_2529":42861},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3023":17,"_26291":15,"_5":26632,"_18309":42863,"_24913":42864,"_2529":42865},[],"/docs/pr-preview/pr-47/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3023":18,"_26291":15,"_5":26632,"_18309":42867,"_24913":42868,"_2529":42869},[],"/docs/pr-preview/pr-47/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3023":19,"_26291":15,"_5":26632,"_18309":42871,"_24913":42872,"_2529":42873},[],"/docs/pr-preview/pr-47/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3023":20,"_26291":15,"_5":26632,"_18309":42875,"_24913":42876,"_2529":42877},[],"/docs/pr-preview/pr-47/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3023":21,"_26291":15,"_5":26632,"_18309":42879,"_24913":42880,"_2529":42881},[],"/docs/pr-preview/pr-47/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3023":22,"_26291":15,"_5":26632,"_18309":42883,"_24913":42884,"_2529":42885},[],"/docs/pr-preview/pr-47/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3023":23,"_26291":15,"_5":26632,"_18309":42887,"_24913":42888,"_2529":42889},[],"/docs/pr-preview/pr-47/deployment/aws-marketplace#next-step","Next step",{"_3023":24,"_26291":15,"_18309":42891,"_5":12556,"_24913":15,"_2529":42892},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3023":25,"_26291":15,"_18309":42894,"_5":12556,"_24913":42864,"_2529":42895},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3023":26,"_26291":15,"_18309":42897,"_5":12556,"_24913":42864,"_2529":42898},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3023":27,"_26291":15,"_18309":42900,"_5":12556,"_24913":42864,"_2529":42901},[],"A security group allowing the necessary endpoints.",{"_3023":28,"_26291":15,"_18309":42903,"_5":12556,"_24913":42868,"_2529":42904},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3023":29,"_26291":15,"_18309":42906,"_5":12556,"_24913":42868,"_2529":42907},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3023":30,"_26291":15,"_18309":42909,"_5":12556,"_24913":42868,"_2529":42910},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3023":31,"_26291":15,"_18309":42912,"_5":12556,"_24913":42872,"_2529":42913},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3023":32,"_26291":15,"_18309":42915,"_5":12556,"_24913":42876,"_2529":42916},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3023":33,"_26291":15,"_18309":42918,"_5":12556,"_24913":42880,"_2529":42919},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3023":34,"_26291":15,"_18309":42921,"_5":12556,"_24913":42884,"_2529":42922},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3023":35,"_26291":15,"_18309":42924,"_5":12556,"_24913":42888,"_2529":42925},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3023":36,"_26291":36,"_5":12871,"_2529":42927,"_26635":42928,"_18309":42929,"_24913":36},"Deploy Lamassu",[42855,42856],[],{"_3023":37,"_26291":36,"_18309":42931,"_5":12556,"_24913":36,"_2529":42932},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3023":38,"_26291":36,"_5":26632,"_18309":42934,"_24913":42935,"_2529":42936},[],"/docs/pr-preview/pr-47/deployment/overview#choose-a-model","Choose a model",{"_3023":39,"_26291":36,"_5":26632,"_18309":42938,"_24913":42939,"_2529":42940},[],"/docs/pr-preview/pr-47/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3023":40,"_26291":36,"_5":26632,"_18309":42942,"_24913":42943,"_2529":42944},[],"/docs/pr-preview/pr-47/deployment/overview#after-deployment","After deployment",{"_3023":41,"_26291":36,"_18309":42946,"_5":12556,"_24913":36,"_2529":42947},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3023":42,"_26291":36,"_18309":42949,"_5":12556,"_24913":42935,"_2529":42950},[],"Model",{"_3023":43,"_26291":36,"_18309":42952,"_5":12556,"_24913":42935,"_2529":42953},[],"Recommended for",{"_3023":44,"_26291":36,"_18309":42955,"_5":12556,"_24913":42935,"_2529":42956},[],"Who operates the infrastructure",{"_3023":45,"_26291":36,"_18309":42958,"_5":12556,"_24913":42935,"_2529":42959},[],"Starting point",{"_3023":46,"_26291":36,"_18309":42961,"_5":12556,"_24913":42935,"_2529":42962},[],"Kubernetes self-managed",{"_3023":47,"_26291":36,"_18309":42964,"_5":12556,"_24913":42935,"_2529":42965},[],"Production, regulated environments and custom deployments",{"_3023":48,"_26291":36,"_18309":42967,"_5":12556,"_24913":42935,"_2529":42968},[],"Your team",{"_3023":49,"_26291":36,"_18309":42970,"_5":12556,"_24913":42935,"_2529":42971},[],"Helm or Fastlane",{"_3023":50,"_26291":36,"_18309":42973,"_5":12556,"_24913":42935,"_2529":42974},[],"AWS Marketplace",{"_3023":51,"_26291":36,"_18309":42976,"_5":12556,"_24913":42935,"_2529":42977},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3023":52,"_26291":36,"_18309":42979,"_5":12556,"_24913":42935,"_2529":42968},[],{"_3023":53,"_26291":36,"_18309":42981,"_5":12556,"_24913":42935,"_2529":42982},[],"Preconfigured image on EC2",{"_3023":54,"_26291":36,"_18309":42984,"_5":12556,"_24913":42935,"_2529":42985},[],"SaaS",{"_3023":55,"_26291":36,"_18309":42987,"_5":12556,"_24913":42935,"_2529":42988},[],"Teams that want to use the platform without operating it",{"_3023":56,"_26291":36,"_18309":42990,"_5":12556,"_24913":42935,"_2529":42991},[],"Lamassu",{"_3023":57,"_26291":36,"_18309":42993,"_5":12556,"_24913":42935,"_2529":42994},[],"Managed subscription",{"_3023":58,"_26291":36,"_18309":42996,"_5":12556,"_24913":42935,"_2529":42997},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3023":59,"_26291":36,"_18309":42999,"_5":12556,"_24913":42935,"_2529":43000},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3023":60,"_26291":36,"_18309":43002,"_5":12556,"_24913":42935,"_2529":43003},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3023":61,"_26291":36,"_18309":43005,"_5":12556,"_24913":42939,"_2529":43006},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3023":62,"_26291":36,"_18309":43008,"_5":12556,"_24913":42943,"_2529":43009},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3023":63,"_26291":63,"_5":12871,"_2529":43011,"_26635":43012,"_18309":43013,"_24913":63},"Use Lamassu as SaaS",[42855,42856,42857],[],{"_3023":64,"_26291":63,"_18309":43015,"_5":12556,"_24913":63,"_2529":43016},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3023":65,"_26291":63,"_5":26632,"_18309":43018,"_24913":43019,"_2529":43020},[],"/docs/pr-preview/pr-47/deployment/saas#what-the-service-manages","What the service manages",{"_3023":66,"_26291":63,"_5":26632,"_18309":43022,"_24913":43023,"_2529":43024},[],"/docs/pr-preview/pr-47/deployment/saas#plans","Plans",{"_3023":67,"_26291":63,"_5":26632,"_18309":43026,"_24913":43027,"_2529":43028},[],"/docs/pr-preview/pr-47/deployment/saas#request-access","Request access",{"_3023":68,"_26291":63,"_18309":43030,"_5":12556,"_24913":63,"_2529":43031},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3023":69,"_26291":63,"_18309":43033,"_5":12556,"_24913":43019,"_2529":43034},[],"Platform availability and maintenance.",{"_3023":70,"_26291":63,"_18309":43036,"_5":12556,"_24913":43019,"_2529":43037},[],"Automatic backups.",{"_3023":71,"_26291":63,"_18309":43039,"_5":12556,"_24913":43019,"_2529":43040},[],"Version upgrades.",{"_3023":72,"_26291":63,"_18309":43042,"_5":12556,"_24913":43019,"_2529":43043},[],"Technical support and SLA according to your plan.",{"_3023":73,"_26291":63,"_18309":43045,"_5":12556,"_24913":43023,"_2529":43046},[],"Plan",{"_3023":74,"_26291":63,"_18309":43048,"_5":12556,"_24913":43023,"_2529":43049},[],"Devices",{"_3023":75,"_26291":63,"_18309":43051,"_5":12556,"_24913":43023,"_2529":43052},[],"Support",{"_3023":76,"_26291":63,"_18309":43054,"_5":12556,"_24913":43023,"_2529":43055},[],"SLA",{"_3023":77,"_26291":63,"_18309":43057,"_5":12556,"_24913":43023,"_2529":43058},[],"Starter",{"_3023":78,"_26291":63,"_18309":43060,"_5":12556,"_24913":43023,"_2529":43061},[],"Up to 1,000",{"_3023":79,"_26291":63,"_18309":43063,"_5":12556,"_24913":43023,"_2529":43064},[],"Email",{"_3023":80,"_26291":63,"_18309":43066,"_5":12556,"_24913":43023,"_2529":43067},[],"99.5 %",{"_3023":81,"_26291":63,"_18309":43069,"_5":12556,"_24913":43023,"_2529":43070},[],"Professional",{"_3023":82,"_26291":63,"_18309":43072,"_5":12556,"_24913":43023,"_2529":43073},[],"Up to 10,000",{"_3023":83,"_26291":63,"_18309":43075,"_5":12556,"_24913":43023,"_2529":43076},[],"Email and chat",{"_3023":84,"_26291":63,"_18309":43078,"_5":12556,"_24913":43023,"_2529":43079},[],"99.9 %",{"_3023":85,"_26291":63,"_18309":43081,"_5":12556,"_24913":43023,"_2529":43082},[],"Enterprise",{"_3023":86,"_26291":63,"_18309":43084,"_5":12556,"_24913":43023,"_2529":43085},[],"Unlimited",{"_3023":87,"_26291":63,"_18309":43087,"_5":12556,"_24913":43023,"_2529":43088},[],"Dedicated",{"_3023":88,"_26291":63,"_18309":43090,"_5":12556,"_24913":43023,"_2529":43091},[],"99.99 %",{"_3023":89,"_26291":63,"_18309":43093,"_5":12556,"_24913":43027,"_2529":43094},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3023":90,"_26291":63,"_18309":43096,"_5":12556,"_24913":43027,"_2529":43097},[],"When you receive your instance's credentials, continue with Get started.",{"_3023":91,"_26291":91,"_5":12871,"_2529":43099,"_26635":43100,"_18309":43101,"_24913":91},"Fastlane",[42855,42856,42962],[],{"_3023":92,"_26291":91,"_18309":43103,"_5":12556,"_24913":91,"_2529":43104},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3023":93,"_26291":91,"_5":26632,"_18309":43106,"_24913":43107,"_2529":43108},[],"/docs/pr-preview/pr-47/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3023":94,"_26291":91,"_5":26632,"_18309":43110,"_24913":43111,"_2529":43112},[],"/docs/pr-preview/pr-47/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3023":95,"_26291":91,"_5":26632,"_18309":43114,"_24913":43115,"_2529":42865},[],"/docs/pr-preview/pr-47/deployment/self-hosted/fastlane#before-you-begin",{"_3023":96,"_26291":91,"_5":26632,"_18309":43117,"_24913":43118,"_2529":43119},[],"/docs/pr-preview/pr-47/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3023":97,"_26291":91,"_5":26632,"_18309":43121,"_24913":43122,"_2529":43123},[],"/docs/pr-preview/pr-47/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3023":98,"_26291":91,"_5":26632,"_18309":43125,"_24913":43126,"_2529":43127},[],"/docs/pr-preview/pr-47/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3023":99,"_26291":91,"_5":26632,"_18309":43129,"_24913":43130,"_2529":43131},[],"/docs/pr-preview/pr-47/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3023":100,"_26291":91,"_5":26632,"_18309":43133,"_24913":43134,"_2529":43135},[],"/docs/pr-preview/pr-47/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3023":101,"_26291":91,"_5":26632,"_18309":43137,"_24913":43138,"_2529":43139},[],"/docs/pr-preview/pr-47/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3023":102,"_26291":91,"_5":26632,"_18309":43141,"_24913":43142,"_2529":43143},[],"/docs/pr-preview/pr-47/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3023":103,"_26291":91,"_18309":43145,"_5":12556,"_24913":43107,"_2529":43146},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3023":104,"_26291":91,"_18309":43148,"_5":12556,"_24913":43107,"_2529":43149},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3023":105,"_26291":91,"_18309":43151,"_5":12556,"_24913":43111,"_2529":43152},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3023":106,"_26291":91,"_18309":43154,"_5":12556,"_24913":43111,"_2529":43155},[],"Fastlane installs or configures",{"_3023":107,"_26291":91,"_18309":43157,"_5":12556,"_24913":43111,"_2529":43158},[],"You still provide",{"_3023":108,"_26291":91,"_18309":43160,"_5":12556,"_24913":43111,"_2529":43161},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3023":109,"_26291":91,"_18309":43163,"_5":12556,"_24913":43111,"_2529":43164},[],"The Kubernetes cluster, nodes and persistent storage",{"_3023":110,"_26291":91,"_18309":43166,"_5":12556,"_24913":43111,"_2529":43167},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3023":111,"_26291":91,"_18309":43169,"_5":12556,"_24913":43111,"_2529":43170},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3023":112,"_26291":91,"_18309":43172,"_5":12556,"_24913":43111,"_2529":43173},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3023":113,"_26291":91,"_18309":43175,"_5":12556,"_24913":43111,"_2529":43176},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3023":114,"_26291":91,"_18309":43178,"_5":12556,"_24913":43111,"_2529":43179},[],"Optional observability and lab HSM components",{"_3023":115,"_26291":91,"_18309":43181,"_5":12556,"_24913":43111,"_2529":43182},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3023":116,"_26291":91,"_18309":43184,"_5":12556,"_24913":43111,"_2529":43185},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3023":117,"_26291":91,"_18309":43187,"_5":12556,"_24913":43115,"_2529":43188},[],"You need:",{"_3023":118,"_26291":91,"_18309":43190,"_5":12556,"_24913":43115,"_2529":43191},[],"an existing Kubernetes cluster",{"_3023":119,"_26291":91,"_18309":43193,"_5":12556,"_24913":43115,"_2529":43194},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3023":120,"_26291":91,"_18309":43196,"_5":12556,"_24913":43115,"_2529":43197},[],"`yq`",{"_3023":121,"_26291":91,"_18309":43199,"_5":12556,"_24913":43115,"_2529":20755},[],{"_3023":122,"_26291":91,"_18309":43201,"_5":12556,"_24913":43115,"_2529":43202},[],"`jq` only when using `--sample-data`",{"_3023":123,"_26291":91,"_18309":43204,"_5":12556,"_24913":43115,"_2529":43205},[],"free external ports 80 and 443 on a single-node K3s host",{"_3023":124,"_26291":91,"_18309":43207,"_5":12556,"_24913":43115,"_2529":43208},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3023":125,"_26291":91,"_18309":43210,"_5":12556,"_24913":43115,"_2529":43211},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3023":126,"_26291":91,"_18309":43213,"_5":12556,"_24913":43118,"_2529":43214},[],"Run the script from a clone of the Helm repository:",{"_3023":127,"_26291":91,"_18309":43216,"_5":12556,"_24913":43118,"_2529":43217},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3023":128,"_26291":91,"_18309":43219,"_5":12556,"_24913":43122,"_2529":43220},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3023":129,"_26291":91,"_18309":43222,"_5":12556,"_24913":43122,"_2529":43223},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3023":130,"_26291":91,"_18309":43225,"_5":12556,"_24913":43122,"_2529":43226},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3023":131,"_26291":91,"_18309":43228,"_5":12556,"_24913":43122,"_2529":43229},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3023":132,"_26291":91,"_18309":43231,"_5":12556,"_24913":43126,"_2529":43232},[],"Option",{"_3023":133,"_26291":91,"_18309":43234,"_5":12556,"_24913":43126,"_2529":43235},[],"Default",{"_3023":134,"_26291":91,"_18309":43237,"_5":12556,"_24913":43126,"_2529":43238},[],"Purpose",{"_3023":135,"_26291":91,"_18309":43240,"_5":12556,"_24913":43126,"_2529":43241},[],"`-h`, `--help`",{"_3023":136,"_26291":91,"_18309":43243,"_5":12556,"_24913":43126,"_2529":43244},[],"—",{"_3023":137,"_26291":91,"_18309":43246,"_5":12556,"_24913":43126,"_2529":43247},[],"Show help",{"_3023":138,"_26291":91,"_18309":43249,"_5":12556,"_24913":43126,"_2529":43250},[],"`-c`, `--context`",{"_3023":139,"_26291":91,"_18309":43252,"_5":12556,"_24913":43126,"_2529":43253},[],"current context",{"_3023":140,"_26291":91,"_18309":43255,"_5":12556,"_24913":43126,"_2529":43256},[],"Select the kubeconfig context for kubectl and Helm",{"_3023":141,"_26291":91,"_18309":43258,"_5":12556,"_24913":43126,"_2529":43259},[],"`-n`, `--non-interactive`",{"_3023":142,"_26291":91,"_18309":43261,"_5":12556,"_24913":43126,"_2529":5662},[],{"_3023":143,"_26291":91,"_18309":43263,"_5":12556,"_24913":43126,"_2529":43264},[],"Skip prompts and generate dependency credentials",{"_3023":144,"_26291":91,"_18309":43266,"_5":12556,"_24913":43126,"_2529":43267},[],"`-ns`, `--namespace`",{"_3023":145,"_26291":91,"_18309":43269,"_5":12556,"_24913":43126,"_2529":43270},[],"`lamassu-dev`",{"_3023":146,"_26291":91,"_18309":43272,"_5":12556,"_24913":43126,"_2529":43273},[],"Namespace for the installation",{"_3023":147,"_26291":91,"_18309":43275,"_5":12556,"_24913":43126,"_2529":43276},[],"`-d`, `--domain`",{"_3023":148,"_26291":91,"_18309":43278,"_5":12556,"_24913":43126,"_2529":43279},[],"`dev.lamassu.io`",{"_3023":149,"_26291":91,"_18309":43281,"_5":12556,"_24913":43126,"_2529":43282},[],"Domain used by the UI, OIDC and certificate",{"_3023":150,"_26291":91,"_18309":43284,"_5":12556,"_24913":43126,"_2529":43285},[],"`-v`, `--version`",{"_3023":151,"_26291":91,"_18309":43287,"_5":12556,"_24913":43126,"_2529":13101},[],{"_3023":152,"_26291":91,"_18309":43289,"_5":12556,"_24913":43126,"_2529":43290},[],"Lamassu chart version",{"_3023":153,"_26291":91,"_18309":43292,"_5":12556,"_24913":43126,"_2529":43293},[],"`--https-port`",{"_3023":154,"_26291":91,"_18309":43295,"_5":12556,"_24913":43126,"_2529":43296},[],"`443`",{"_3023":155,"_26291":91,"_18309":43298,"_5":12556,"_24913":43126,"_2529":43299},[],"Gateway HTTPS listener port",{"_3023":156,"_26291":91,"_18309":43301,"_5":12556,"_24913":43126,"_2529":43302},[],"`--http-port`",{"_3023":157,"_26291":91,"_18309":43304,"_5":12556,"_24913":43126,"_2529":43305},[],"`80`",{"_3023":158,"_26291":91,"_18309":43307,"_5":12556,"_24913":43126,"_2529":43308},[],"Gateway HTTP listener port",{"_3023":159,"_26291":91,"_18309":43310,"_5":12556,"_24913":43126,"_2529":43311},[],"`--tls-crt`",{"_3023":160,"_26291":91,"_18309":43313,"_5":12556,"_24913":43126,"_2529":43244},[],{"_3023":161,"_26291":91,"_18309":43315,"_5":12556,"_24913":43126,"_2529":43316},[],"PEM certificate for downstream TLS",{"_3023":162,"_26291":91,"_18309":43318,"_5":12556,"_24913":43126,"_2529":43319},[],"`--tls-key`",{"_3023":163,"_26291":91,"_18309":43321,"_5":12556,"_24913":43126,"_2529":43244},[],{"_3023":164,"_26291":91,"_18309":43323,"_5":12556,"_24913":43126,"_2529":43324},[],"PEM private key for downstream TLS",{"_3023":165,"_26291":91,"_18309":43326,"_5":12556,"_24913":43126,"_2529":43327},[],"`-l`, `--local-chart-path`",{"_3023":166,"_26291":91,"_18309":43329,"_5":12556,"_24913":43126,"_2529":43330},[],"repository chart",{"_3023":167,"_26291":91,"_18309":43332,"_5":12556,"_24913":43126,"_2529":43333},[],"Use an unpacked local Lamassu chart",{"_3023":168,"_26291":91,"_18309":43335,"_5":12556,"_24913":43126,"_2529":43336},[],"`-ip`, `--gateway-ip`",{"_3023":169,"_26291":91,"_18309":43338,"_5":12556,"_24913":43126,"_2529":7639},[],{"_3023":170,"_26291":91,"_18309":43340,"_5":12556,"_24913":43126,"_2529":43341},[],"Override the address written to `gateway.addresses`",{"_3023":171,"_26291":91,"_18309":43343,"_5":12556,"_24913":43126,"_2529":43344},[],"`--otel`",{"_3023":172,"_26291":91,"_18309":43346,"_5":12556,"_24913":43126,"_2529":5662},[],{"_3023":173,"_26291":91,"_18309":43348,"_5":12556,"_24913":43126,"_2529":43349},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3023":174,"_26291":91,"_18309":43351,"_5":12556,"_24913":43126,"_2529":43352},[],"`--sample-data`",{"_3023":175,"_26291":91,"_18309":43354,"_5":12556,"_24913":43126,"_2529":5662},[],{"_3023":176,"_26291":91,"_18309":43356,"_5":12556,"_24913":43126,"_2529":43357},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3023":177,"_26291":91,"_18309":43359,"_5":12556,"_24913":43126,"_2529":43360},[],"`--with-hsm`",{"_3023":178,"_26291":91,"_18309":43362,"_5":12556,"_24913":43126,"_2529":5662},[],{"_3023":179,"_26291":91,"_18309":43364,"_5":12556,"_24913":43126,"_2529":43365},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3023":180,"_26291":91,"_18309":43367,"_5":12556,"_24913":43126,"_2529":43368},[],"`--softhsm-chart-path`",{"_3023":181,"_26291":91,"_18309":43370,"_5":12556,"_24913":43126,"_2529":43371},[],"`./charts/softhsm`",{"_3023":182,"_26291":91,"_18309":43373,"_5":12556,"_24913":43126,"_2529":43374},[],"Use a different local SoftHSM chart",{"_3023":183,"_26291":91,"_18309":43376,"_5":12556,"_24913":43126,"_2529":43377},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3023":184,"_26291":91,"_18309":43379,"_5":12556,"_24913":43130,"_2529":43380},[],"Fastlane:",{"_3023":185,"_26291":91,"_18309":43382,"_5":12556,"_24913":43130,"_2529":43383},[],"validates local tools and the selected cluster",{"_3023":186,"_26291":91,"_18309":43385,"_5":12556,"_24913":43130,"_2529":43386},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3023":187,"_26291":91,"_18309":43388,"_5":12556,"_24913":43130,"_2529":43389},[],"creates the namespace",{"_3023":188,"_26291":91,"_18309":43391,"_5":12556,"_24913":43130,"_2529":43392},[],"installs PostgreSQL and creates the required databases",{"_3023":189,"_26291":91,"_18309":43394,"_5":12556,"_24913":43130,"_2529":43395},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3023":190,"_26291":91,"_18309":43397,"_5":12556,"_24913":43130,"_2529":43398},[],"installs RabbitMQ",{"_3023":191,"_26291":91,"_18309":43400,"_5":12556,"_24913":43130,"_2529":43401},[],"optionally installs observability and lab HSM components",{"_3023":192,"_26291":91,"_18309":43403,"_5":12556,"_24913":43130,"_2529":43404},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3023":193,"_26291":91,"_18309":43406,"_5":12556,"_24913":43130,"_2529":43407},[],"optionally loads sample data",{"_3023":194,"_26291":91,"_18309":43409,"_5":12556,"_24913":43130,"_2529":43410},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3023":195,"_26291":91,"_18309":43412,"_5":12556,"_24913":43134,"_2529":43413},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3023":196,"_26291":91,"_18309":43415,"_5":12556,"_24913":43134,"_2529":43416},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3023":197,"_26291":91,"_18309":43418,"_5":12556,"_24913":43138,"_2529":43419},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use.",{"_3023":198,"_26291":91,"_18309":43421,"_5":12556,"_24913":43138,"_2529":43422},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3023":199,"_26291":91,"_18309":43424,"_5":12556,"_24913":43138,"_2529":43425},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3023":200,"_26291":91,"_18309":43427,"_5":12556,"_24913":43142,"_2529":43428},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3023":201,"_26291":201,"_5":12871,"_2529":43430,"_26635":43431,"_18309":43432,"_24913":201},"Install with Helm",[42855,42856,42962],[],{"_3023":202,"_26291":201,"_18309":43434,"_5":12556,"_24913":201,"_2529":43435},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3023":203,"_26291":201,"_5":26632,"_18309":43437,"_24913":43438,"_2529":43439},[],"/docs/pr-preview/pr-47/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3023":204,"_26291":201,"_5":26632,"_18309":43441,"_24913":43442,"_2529":42865},[],"/docs/pr-preview/pr-47/deployment/self-hosted/helm#before-you-begin",{"_3023":205,"_26291":201,"_5":26632,"_18309":43444,"_24913":43445,"_2529":43446},[],"/docs/pr-preview/pr-47/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3023":206,"_26291":201,"_5":26632,"_18309":43448,"_24913":43449,"_2529":43450},[],"/docs/pr-preview/pr-47/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3023":207,"_26291":201,"_5":26632,"_18309":43452,"_24913":43453,"_2529":43454},[],"/docs/pr-preview/pr-47/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3023":208,"_26291":201,"_5":26632,"_18309":43456,"_24913":43457,"_2529":43458},[],"/docs/pr-preview/pr-47/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3023":209,"_26291":201,"_5":26632,"_18309":43460,"_24913":43461,"_2529":43462},[],"/docs/pr-preview/pr-47/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3023":210,"_26291":201,"_5":26632,"_18309":43464,"_24913":43465,"_2529":43466},[],"/docs/pr-preview/pr-47/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3023":211,"_26291":201,"_5":26632,"_18309":43468,"_24913":43469,"_2529":43470},[],"/docs/pr-preview/pr-47/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3023":212,"_26291":201,"_18309":43472,"_5":12556,"_24913":43438,"_2529":43473},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3023":213,"_26291":201,"_18309":43475,"_5":12556,"_24913":43442,"_2529":43476},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3023":214,"_26291":201,"_18309":43478,"_5":12556,"_24913":43442,"_2529":43479},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3023":215,"_26291":201,"_18309":43481,"_5":12556,"_24913":43442,"_2529":43482},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3023":216,"_26291":201,"_18309":43484,"_5":12556,"_24913":43442,"_2529":43485},[],"a reachable RabbitMQ broker and credentials",{"_3023":217,"_26291":201,"_18309":43487,"_5":12556,"_24913":43442,"_2529":43488},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3023":218,"_26291":201,"_18309":43490,"_5":12556,"_24913":43442,"_2529":43491},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3023":219,"_26291":201,"_18309":43493,"_5":12556,"_24913":43442,"_2529":43494},[],"cert-manager 1.14+; for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3023":220,"_26291":201,"_18309":43496,"_5":12556,"_24913":43442,"_2529":43497},[],"a StorageClass and an external traffic design",{"_3023":221,"_26291":201,"_18309":43499,"_5":12556,"_24913":43442,"_2529":43500},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3023":222,"_26291":201,"_18309":43502,"_5":12556,"_24913":43442,"_2529":43503},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3023":223,"_26291":201,"_18309":43505,"_5":12556,"_24913":43442,"_2529":43506},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3023":224,"_26291":201,"_18309":43508,"_5":12556,"_24913":43445,"_2529":43509},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3023":225,"_26291":201,"_18309":43511,"_5":12556,"_24913":43445,"_2529":43512},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3023":226,"_26291":201,"_18309":43514,"_5":12556,"_24913":43445,"_2529":43515},[],"Install cert-manager separately before Lamassu. The current chart renders its self-signed issuer and CA certificate resources even when `tls.type: external` makes the Gateway use an existing TLS Secret. Selecting external TLS therefore does not remove the cert-manager prerequisite.",{"_3023":227,"_26291":201,"_18309":43517,"_5":12556,"_24913":43449,"_2529":43518},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3023":228,"_26291":201,"_18309":43520,"_5":12556,"_24913":43449,"_2529":43521},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3023":229,"_26291":201,"_18309":43523,"_5":12556,"_24913":43449,"_2529":43524},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3023":230,"_26291":201,"_18309":43526,"_5":12556,"_24913":43453,"_2529":43527},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it:",{"_3023":231,"_26291":201,"_18309":43529,"_5":12556,"_24913":43457,"_2529":43530},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3023":232,"_26291":201,"_18309":43532,"_5":12556,"_24913":43457,"_2529":43533},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3023":233,"_26291":201,"_18309":43535,"_5":12556,"_24913":43457,"_2529":43536},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3023":234,"_26291":201,"_18309":43538,"_5":12556,"_24913":43457,"_2529":43539},[],"See Access control for the principal and policy model.",{"_3023":235,"_26291":201,"_18309":43541,"_5":12556,"_24913":43461,"_2529":43542},[],"To install a local checkout instead:",{"_3023":236,"_26291":201,"_18309":43544,"_5":12556,"_24913":43465,"_2529":43545},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3023":237,"_26291":201,"_18309":43547,"_5":12556,"_24913":43465,"_2529":43548},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3023":238,"_26291":201,"_18309":43550,"_5":12556,"_24913":43469,"_2529":43551},[],"Before going live, review:",{"_3023":239,"_26291":201,"_18309":43553,"_5":12556,"_24913":43469,"_2529":43554},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3023":240,"_26291":201,"_18309":43556,"_5":12556,"_24913":43469,"_2529":43557},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3023":241,"_26291":201,"_18309":43559,"_5":12556,"_24913":43469,"_2529":43560},[],"shared VA storage before increasing VA replicas",{"_3023":242,"_26291":201,"_18309":43562,"_5":12556,"_24913":43469,"_2529":43563},[],"managed OIDC roles and removal of evaluation credentials",{"_3023":243,"_26291":201,"_18309":43565,"_5":12556,"_24913":43469,"_2529":43566},[],"a trusted TLS issuer or externally managed certificate",{"_3023":244,"_26291":201,"_18309":43568,"_5":12556,"_24913":43469,"_2529":43569},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3023":245,"_26291":201,"_18309":43571,"_5":12556,"_24913":43469,"_2529":43572},[],"SMTP, observability and alert delivery",{"_3023":246,"_26291":201,"_18309":43574,"_5":12556,"_24913":43469,"_2529":43575},[],"the migration notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_3023":247,"_26291":201,"_18309":43577,"_5":12556,"_24913":43469,"_2529":43578},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3023":248,"_26291":248,"_5":12871,"_2529":43580,"_26635":43581,"_18309":43582,"_24913":248},"Expose the Gateway",[42855,42856,42962],[],{"_3023":249,"_26291":248,"_18309":43584,"_5":12556,"_24913":248,"_2529":43585},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3023":250,"_26291":248,"_5":26632,"_18309":43587,"_24913":43588,"_2529":43589},[],"/docs/pr-preview/pr-47/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3023":251,"_26291":248,"_5":26632,"_18309":43591,"_24913":43592,"_2529":43593},[],"/docs/pr-preview/pr-47/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3023":252,"_26291":248,"_5":26632,"_18309":43595,"_24913":43596,"_2529":43597},[],"/docs/pr-preview/pr-47/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3023":253,"_26291":248,"_5":26632,"_18309":43599,"_24913":43600,"_2529":43601},[],"/docs/pr-preview/pr-47/deployment/self-hosted/networking#k3s","K3s",{"_3023":254,"_26291":248,"_5":26632,"_18309":43603,"_24913":43604,"_2529":43605},[],"/docs/pr-preview/pr-47/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3023":255,"_26291":248,"_5":26632,"_18309":43607,"_24913":43608,"_2529":43609},[],"/docs/pr-preview/pr-47/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3023":256,"_26291":248,"_5":26632,"_18309":43611,"_24913":43612,"_2529":43613},[],"/docs/pr-preview/pr-47/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3023":257,"_26291":248,"_5":26632,"_18309":43615,"_24913":43616,"_2529":43617},[],"/docs/pr-preview/pr-47/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3023":258,"_26291":248,"_5":26632,"_18309":43619,"_24913":43620,"_2529":43621},[],"/docs/pr-preview/pr-47/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3023":259,"_26291":248,"_18309":43623,"_5":12556,"_24913":43588,"_2529":43624},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3023":260,"_26291":248,"_18309":43626,"_5":12556,"_24913":43588,"_2529":43627},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3023":261,"_26291":248,"_18309":43629,"_5":12556,"_24913":43592,"_2529":43630},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3023":262,"_26291":248,"_18309":43632,"_5":12556,"_24913":43592,"_2529":43633},[],"Set it only when:",{"_3023":263,"_26291":248,"_18309":43635,"_5":12556,"_24913":43592,"_2529":43636},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3023":264,"_26291":248,"_18309":43638,"_5":12556,"_24913":43592,"_2529":43639},[],"that address is allocated to this Gateway",{"_3023":265,"_26291":248,"_18309":43641,"_5":12556,"_24913":43592,"_2529":43642},[],"the surrounding network already routes traffic for it to the cluster",{"_3023":266,"_26291":248,"_18309":43644,"_5":12556,"_24913":43592,"_2529":43645},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3023":267,"_26291":248,"_18309":43647,"_5":12556,"_24913":43592,"_2529":43648},[],"Keep these two settings separate:",{"_3023":268,"_26291":248,"_18309":43650,"_5":12556,"_24913":43592,"_2529":43651},[],"`gateway.addresses` requests an address for the Gateway.",{"_3023":269,"_26291":248,"_18309":43653,"_5":12556,"_24913":43592,"_2529":43654},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3023":270,"_26291":248,"_18309":43656,"_5":12556,"_24913":43592,"_2529":43657},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3023":271,"_26291":248,"_18309":43659,"_5":12556,"_24913":43596,"_2529":43660},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3023":272,"_26291":248,"_18309":43662,"_5":12556,"_24913":43596,"_2529":43663},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3023":273,"_26291":248,"_18309":43665,"_5":12556,"_24913":43600,"_2529":43666},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3023":274,"_26291":248,"_18309":43668,"_5":12556,"_24913":43600,"_2529":43669},[],"For the recommended design:",{"_3023":275,"_26291":248,"_18309":43671,"_5":12556,"_24913":43600,"_2529":43672},[],"Use only one externally exposed Lamassu Gateway.",{"_3023":276,"_26291":248,"_18309":43674,"_5":12556,"_24913":43600,"_2529":43675},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3023":277,"_26291":248,"_18309":43677,"_5":12556,"_24913":43600,"_2529":43678},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3023":278,"_26291":248,"_18309":43680,"_5":12556,"_24913":43600,"_2529":43681},[],"Point DNS at the VM's reachable address.",{"_3023":279,"_26291":248,"_18309":43683,"_5":12556,"_24913":43600,"_2529":43684},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3023":280,"_26291":248,"_18309":43686,"_5":12556,"_24913":43604,"_2529":43687},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3023":281,"_26291":248,"_18309":43689,"_5":12556,"_24913":43608,"_2529":43690},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3023":282,"_26291":248,"_18309":43692,"_5":12556,"_24913":43608,"_2529":43693},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3023":283,"_26291":248,"_18309":43695,"_5":12556,"_24913":43612,"_2529":43696},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3023":284,"_26291":248,"_18309":43698,"_5":12556,"_24913":43612,"_2529":43699},[],"Requirement",{"_3023":285,"_26291":248,"_18309":43701,"_5":12556,"_24913":43612,"_2529":43702},[],"Recommended design",{"_3023":286,"_26291":248,"_18309":43704,"_5":12556,"_24913":43612,"_2529":43705},[],"Consequence",{"_3023":287,"_26291":248,"_18309":43707,"_5":12556,"_24913":43612,"_2529":43708},[],"Several Lamassu URLs or services",{"_3023":288,"_26291":248,"_18309":43710,"_5":12556,"_24913":43612,"_2529":43711},[],"One Gateway with multiple routes",{"_3023":289,"_26291":248,"_18309":43713,"_5":12556,"_24913":43612,"_2529":43714},[],"One IP and one proxy fleet; this is the chart default",{"_3023":290,"_26291":248,"_18309":43716,"_5":12556,"_24913":43612,"_2529":43717},[],"Independent Gateways and separate external IPs",{"_3023":291,"_26291":248,"_18309":43719,"_5":12556,"_24913":43612,"_2529":43720},[],"One VIP per Gateway",{"_3023":292,"_26291":248,"_18309":43722,"_5":12556,"_24913":43612,"_2529":43723},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3023":293,"_26291":248,"_18309":43725,"_5":12556,"_24913":43612,"_2529":43726},[],"Independent Gateways on one node and one IP",{"_3023":294,"_26291":248,"_18309":43728,"_5":12556,"_24913":43612,"_2529":43729},[],"Use different external ports",{"_3023":295,"_26291":248,"_18309":43731,"_5":12556,"_24913":43612,"_2529":43732},[],"Clients must include non-standard ports",{"_3023":296,"_26291":248,"_18309":43734,"_5":12556,"_24913":43612,"_2529":43735},[],"Separate TLS/mTLS termination behind one IP",{"_3023":297,"_26291":248,"_18309":43737,"_5":12556,"_24913":43612,"_2529":43738},[],"Front-door SNI routing to internal Gateways",{"_3023":298,"_26291":248,"_18309":43740,"_5":12556,"_24913":43612,"_2529":43741},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3023":299,"_26291":248,"_18309":43743,"_5":12556,"_24913":43612,"_2529":43744},[],"Separate Gateway resources but shared proxy infrastructure",{"_3023":300,"_26291":248,"_18309":43746,"_5":12556,"_24913":43612,"_2529":43747},[],"Envoy merged-Gateway mode",{"_3023":301,"_26291":248,"_18309":43749,"_5":12556,"_24913":43612,"_2529":43750},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3023":302,"_26291":248,"_18309":43752,"_5":12556,"_24913":43612,"_2529":43753},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3023":303,"_26291":248,"_18309":43755,"_5":12556,"_24913":43612,"_2529":43756},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3023":304,"_26291":248,"_18309":43758,"_5":12556,"_24913":43612,"_2529":43759},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3023":305,"_26291":248,"_18309":43761,"_5":12556,"_24913":43612,"_2529":43762},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3023":306,"_26291":248,"_18309":43764,"_5":12556,"_24913":43616,"_2529":43765},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3023":307,"_26291":248,"_18309":43767,"_5":12556,"_24913":43616,"_2529":43768},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3023":308,"_26291":248,"_18309":43770,"_5":12556,"_24913":43616,"_2529":43771},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3023":309,"_26291":248,"_18309":43773,"_5":12556,"_24913":43616,"_2529":43774},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3023":310,"_26291":248,"_18309":43776,"_5":12556,"_24913":43616,"_2529":43777},[],"If none of those are possible, use different external ports or change the external network design.",{"_3023":311,"_26291":248,"_18309":43779,"_5":12556,"_24913":43620,"_2529":43780},[],"Check, in order:",{"_3023":312,"_26291":248,"_18309":43782,"_5":12556,"_24913":43620,"_2529":43783},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3023":313,"_26291":248,"_18309":43785,"_5":12556,"_24913":43620,"_2529":43786},[],"Its status contains the expected address.",{"_3023":314,"_26291":248,"_18309":43788,"_5":12556,"_24913":43620,"_2529":43789},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3023":315,"_26291":248,"_18309":43791,"_5":12556,"_24913":43620,"_2529":43792},[],"Port 443 reaches that address from the client network.",{"_3023":316,"_26291":248,"_18309":43794,"_5":12556,"_24913":43620,"_2529":43795},[],"DNS resolves to the externally reachable endpoint.",{"_3023":317,"_26291":248,"_18309":43797,"_5":12556,"_24913":43620,"_2529":43798},[],"The certificate contains the DNS name or IP used by the client.",{"_3023":318,"_26291":248,"_18309":43800,"_5":12556,"_24913":43620,"_2529":43801},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3023":319,"_26291":319,"_5":12871,"_2529":42962,"_26635":43803,"_18309":43804,"_24913":319},[42855,42856,42962],[],{"_3023":320,"_26291":319,"_18309":43806,"_5":12556,"_24913":319,"_2529":43807},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3023":321,"_26291":319,"_5":26632,"_18309":43809,"_24913":43810,"_2529":43811},[],"/docs/pr-preview/pr-47/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3023":322,"_26291":319,"_5":26632,"_18309":43813,"_24913":43814,"_2529":43815},[],"/docs/pr-preview/pr-47/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3023":323,"_26291":319,"_5":26632,"_18309":43817,"_24913":43818,"_2529":43819},[],"/docs/pr-preview/pr-47/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3023":324,"_26291":319,"_5":26632,"_18309":43821,"_24913":43822,"_2529":43823},[],"/docs/pr-preview/pr-47/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3023":325,"_26291":319,"_5":26632,"_18309":43825,"_24913":43826,"_2529":43827},[],"/docs/pr-preview/pr-47/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3023":326,"_26291":319,"_5":26632,"_18309":43829,"_24913":43830,"_2529":43831},[],"/docs/pr-preview/pr-47/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3023":327,"_26291":319,"_18309":43833,"_5":12556,"_24913":43810,"_2529":43834},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3023":328,"_26291":319,"_18309":43836,"_5":12556,"_24913":43814,"_2529":43837},[],"Workflow",{"_3023":329,"_26291":319,"_18309":43839,"_5":12556,"_24913":43814,"_2529":43840},[],"Use it for",{"_3023":330,"_26291":319,"_18309":43842,"_5":12556,"_24913":43814,"_2529":43843},[],"What it installs",{"_3023":331,"_26291":319,"_18309":43845,"_5":12556,"_24913":43814,"_2529":43846},[],"Helm",{"_3023":332,"_26291":319,"_18309":43848,"_5":12556,"_24913":43814,"_2529":43849},[],"Production and controlled environments",{"_3023":333,"_26291":319,"_18309":43851,"_5":12556,"_24913":43814,"_2529":43852},[],"Lamassu services and Gateway API resources",{"_3023":334,"_26291":319,"_18309":43854,"_5":12556,"_24913":43814,"_2529":43099},[],{"_3023":335,"_26291":319,"_18309":43856,"_5":12556,"_24913":43814,"_2529":43857},[],"Evaluation, demos, CI and small lab clusters",{"_3023":336,"_26291":319,"_18309":43859,"_5":12556,"_24913":43814,"_2529":43860},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3023":337,"_26291":319,"_18309":43862,"_5":12556,"_24913":43818,"_2529":43863},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3023":338,"_26291":319,"_18309":43865,"_5":12556,"_24913":43818,"_2529":43866},[],"Area",{"_3023":339,"_26291":319,"_18309":43868,"_5":12556,"_24913":43818,"_2529":43869},[],"The Lamassu chart provides",{"_3023":340,"_26291":319,"_18309":43871,"_5":12556,"_24913":43818,"_2529":43872},[],"You provide",{"_3023":341,"_26291":319,"_18309":43874,"_5":12556,"_24913":43818,"_2529":43875},[],"Lamassu applications",{"_3023":342,"_26291":319,"_18309":43877,"_5":12556,"_24913":43818,"_2529":43878},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3023":343,"_26291":319,"_18309":43880,"_5":12556,"_24913":43818,"_2529":43881},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3023":344,"_26291":319,"_18309":43883,"_5":12556,"_24913":43818,"_2529":43884},[],"PostgreSQL data",{"_3023":345,"_26291":319,"_18309":43886,"_5":12556,"_24913":43818,"_2529":43887},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3023":346,"_26291":319,"_18309":43889,"_5":12556,"_24913":43818,"_2529":43890},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3023":347,"_26291":319,"_18309":43892,"_5":12556,"_24913":43818,"_2529":43893},[],"Messaging",{"_3023":348,"_26291":319,"_18309":43895,"_5":12556,"_24913":43818,"_2529":43896},[],"RabbitMQ connection configuration for the Lamassu services",{"_3023":349,"_26291":319,"_18309":43898,"_5":12556,"_24913":43818,"_2529":43899},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3023":350,"_26291":319,"_18309":43901,"_5":12556,"_24913":43818,"_2529":43902},[],"Identity",{"_3023":351,"_26291":319,"_18309":43904,"_5":12556,"_24913":43818,"_2529":43905},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3023":352,"_26291":319,"_18309":43907,"_5":12556,"_24913":43818,"_2529":43908},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3023":353,"_26291":319,"_18309":43910,"_5":12556,"_24913":43818,"_2529":43911},[],"External routing",{"_3023":354,"_26291":319,"_18309":43913,"_5":12556,"_24913":43818,"_2529":43914},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3023":355,"_26291":319,"_18309":43916,"_5":12556,"_24913":43818,"_2529":43917},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3023":356,"_26291":319,"_18309":43919,"_5":12556,"_24913":43818,"_2529":43920},[],"TLS",{"_3023":357,"_26291":319,"_18309":43922,"_5":12556,"_24913":43818,"_2529":43923},[],"cert-manager `Issuer` and CA `Certificate` resources; either a chart-managed downstream `Certificate` or a reference to your TLS Secret",{"_3023":358,"_26291":319,"_18309":43925,"_5":12556,"_24913":43818,"_2529":43926},[],"cert-manager itself; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3023":359,"_26291":319,"_18309":43928,"_5":12556,"_24913":43818,"_2529":43929},[],"Persistent application data",{"_3023":360,"_26291":319,"_18309":43931,"_5":12556,"_24913":43818,"_2529":43932},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3023":361,"_26291":319,"_18309":43934,"_5":12556,"_24913":43818,"_2529":43935},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3023":362,"_26291":319,"_18309":43937,"_5":12556,"_24913":43818,"_2529":43938},[],"Optional integrations",{"_3023":363,"_26291":319,"_18309":43940,"_5":12556,"_24913":43818,"_2529":43941},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3023":364,"_26291":319,"_18309":43943,"_5":12556,"_24913":43818,"_2529":43944},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3023":365,"_26291":319,"_18309":43946,"_5":12556,"_24913":43818,"_2529":43947},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3023":366,"_26291":319,"_18309":43949,"_5":12556,"_24913":43818,"_2529":43950},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3023":367,"_26291":319,"_18309":43952,"_5":12556,"_24913":43822,"_2529":43953},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3023":368,"_26291":319,"_18309":43955,"_5":12556,"_24913":43822,"_2529":43956},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3023":369,"_26291":319,"_18309":43958,"_5":12556,"_24913":43826,"_2529":43959},[],"Kubernetes 1.24 or newer",{"_3023":370,"_26291":319,"_18309":43961,"_5":12556,"_24913":43826,"_2529":43962},[],"Helm 3.2 or newer",{"_3023":371,"_26291":319,"_18309":43964,"_5":12556,"_24913":43826,"_2529":43965},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3023":372,"_26291":319,"_18309":43967,"_5":12556,"_24913":43826,"_2529":43968},[],"cert-manager 1.14 or newer; the current chart renders cert-manager issuer and certificate resources",{"_3023":373,"_26291":319,"_18309":43970,"_5":12556,"_24913":43826,"_2529":43971},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3023":374,"_26291":319,"_18309":43973,"_5":12556,"_24913":43826,"_2529":43974},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3023":375,"_26291":319,"_18309":43976,"_5":12556,"_24913":43826,"_2529":43977},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer.",{"_3023":376,"_26291":319,"_18309":43979,"_5":12556,"_24913":43830,"_2529":43980},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3023":377,"_26291":319,"_18309":43982,"_5":12556,"_24913":43830,"_2529":43983},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3023":378,"_26291":319,"_18309":43985,"_5":12556,"_24913":43830,"_2529":43986},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3023":379,"_26291":379,"_5":12871,"_2529":43988,"_26635":43989,"_18309":43991,"_24913":379},"Deployment troubleshooting",[42855,42856,43990],"Operations",[],{"_3023":380,"_26291":379,"_18309":43993,"_5":12556,"_24913":379,"_2529":43994},[],"Diagnose access, service health and infrastructure dependencies.",{"_3023":381,"_26291":379,"_5":26632,"_18309":43996,"_24913":43997,"_2529":43998},[],"/docs/pr-preview/pr-47/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3023":382,"_26291":379,"_5":26632,"_18309":44000,"_24913":44001,"_2529":44002},[],"/docs/pr-preview/pr-47/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3023":383,"_26291":379,"_5":26632,"_18309":44004,"_24913":44005,"_2529":44006},[],"/docs/pr-preview/pr-47/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3023":384,"_26291":379,"_5":26632,"_18309":44008,"_24913":44009,"_2529":44010},[],"/docs/pr-preview/pr-47/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3023":385,"_26291":379,"_5":26632,"_18309":44012,"_24913":44013,"_2529":44014},[],"/docs/pr-preview/pr-47/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3023":386,"_26291":379,"_5":26632,"_18309":44016,"_24913":44017,"_2529":44018},[],"/docs/pr-preview/pr-47/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3023":387,"_26291":379,"_5":26632,"_18309":44020,"_24913":44021,"_2529":44022},[],"/docs/pr-preview/pr-47/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3023":388,"_26291":379,"_5":26632,"_18309":44024,"_24913":44025,"_2529":44026},[],"/docs/pr-preview/pr-47/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3023":389,"_26291":379,"_5":26632,"_18309":44028,"_24913":44029,"_2529":44030},[],"/docs/pr-preview/pr-47/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3023":390,"_26291":379,"_5":26632,"_18309":44032,"_24913":44033,"_2529":44034},[],"/docs/pr-preview/pr-47/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3023":391,"_26291":379,"_5":26632,"_18309":44036,"_24913":44037,"_2529":44038},[],"/docs/pr-preview/pr-47/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3023":392,"_26291":379,"_5":26632,"_18309":44040,"_24913":44041,"_2529":44042},[],"/docs/pr-preview/pr-47/deployment/troubleshooting#observability","Observability",{"_3023":393,"_26291":379,"_18309":44044,"_5":12556,"_24913":379,"_2529":44045},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3023":394,"_26291":379,"_18309":44047,"_5":12556,"_24913":44001,"_2529":44048},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3023":395,"_26291":379,"_18309":44050,"_5":12556,"_24913":44005,"_2529":44051},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3023":396,"_26291":379,"_18309":44053,"_5":12556,"_24913":44009,"_2529":44054},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3023":397,"_26291":379,"_18309":44056,"_5":12556,"_24913":44013,"_2529":44057},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3023":398,"_26291":379,"_18309":44059,"_5":12556,"_24913":44017,"_2529":44060},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3023":399,"_26291":379,"_18309":44062,"_5":12556,"_24913":44021,"_2529":44063},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3023":400,"_26291":379,"_18309":44065,"_5":12556,"_24913":44021,"_2529":44066},[],"Also run the chart's connectivity test:",{"_3023":401,"_26291":379,"_18309":44068,"_5":12556,"_24913":44021,"_2529":44069},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3023":402,"_26291":379,"_18309":44071,"_5":12556,"_24913":44021,"_2529":44072},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3023":403,"_26291":379,"_18309":44074,"_5":12556,"_24913":44025,"_2529":44075},[],"If you receive a 401:",{"_3023":404,"_26291":379,"_18309":44077,"_5":12556,"_24913":44025,"_2529":44078},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3023":405,"_26291":379,"_18309":44080,"_5":12556,"_24913":44025,"_2529":44081},[],"verify issuer, audience and expiration of the token;",{"_3023":406,"_26291":379,"_18309":44083,"_5":12556,"_24913":44025,"_2529":44084},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3023":407,"_26291":379,"_18309":44086,"_5":12556,"_24913":44025,"_2529":44087},[],"check that the provider's public and internal routes point to the same realm.",{"_3023":408,"_26291":379,"_18309":44089,"_5":12556,"_24913":44025,"_2529":44090},[],"If login succeeds but the APIs return 403:",{"_3023":409,"_26291":379,"_18309":44092,"_5":12556,"_24913":44025,"_2529":44093},[],"inspect the token's real claims;",{"_3023":410,"_26291":379,"_18309":44095,"_5":12556,"_24913":44025,"_2529":44096},[],"confirm they match an active principal;",{"_3023":411,"_26291":379,"_18309":44098,"_5":12556,"_24913":44025,"_2529":44099},[],"review the policies granted to that principal;",{"_3023":412,"_26291":379,"_18309":44101,"_5":12556,"_24913":44025,"_2529":44102},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3023":413,"_26291":379,"_18309":44104,"_5":12556,"_24913":44025,"_2529":44105},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3023":414,"_26291":379,"_18309":44107,"_5":12556,"_24913":44029,"_2529":44108},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3023":415,"_26291":379,"_18309":44110,"_5":12556,"_24913":44029,"_2529":44111},[],"Locate the authz pod and Service.",{"_3023":416,"_26291":379,"_18309":44113,"_5":12556,"_24913":44029,"_2529":44114},[],"Check /health, logs and its database connection.",{"_3023":417,"_26291":379,"_18309":44116,"_5":12556,"_24913":44029,"_2529":44117},[],"Verify the DNS and port configured in externalAuthorization.",{"_3023":418,"_26291":379,"_18309":44119,"_5":12556,"_24913":44029,"_2529":44120},[],"Check the check route is /v1/ext\\_authz/check.",{"_3023":419,"_26291":379,"_18309":44122,"_5":12556,"_24913":44029,"_2529":44123},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3023":420,"_26291":379,"_18309":44125,"_5":12556,"_24913":44033,"_2529":44126},[],"Review kubectl describe pod first. Common causes are:",{"_3023":421,"_26291":379,"_18309":44128,"_5":12556,"_24913":44033,"_2529":44129},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3023":422,"_26291":379,"_18309":44131,"_5":12556,"_24913":44033,"_2529":44132},[],"unbound persistent volume;",{"_3023":423,"_26291":379,"_18309":44134,"_5":12556,"_24913":44033,"_2529":44135},[],"inaccessible image or incorrect pull policy;",{"_3023":424,"_26291":379,"_18309":44137,"_5":12556,"_24913":44033,"_2529":44138},[],"invalid cryptographic engine configuration;",{"_3023":425,"_26291":379,"_18309":44140,"_5":12556,"_24913":44033,"_2529":44141},[],"CPU or memory limits set too low;",{"_3023":426,"_26291":379,"_18309":44143,"_5":12556,"_24913":44033,"_2529":44144},[],"an incomplete prior migration.",{"_3023":427,"_26291":379,"_18309":44146,"_5":12556,"_24913":44033,"_2529":44147},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3023":428,"_26291":379,"_18309":44149,"_5":12556,"_24913":44033,"_2529":44150},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3023":429,"_26291":379,"_18309":44152,"_5":12556,"_24913":44037,"_2529":44153},[],"Domain and audit events depend on the bus publisher:",{"_3023":430,"_26291":379,"_18309":44155,"_5":12556,"_24913":44037,"_2529":44156},[],"verify it is enabled in the emitting service;",{"_3023":431,"_26291":379,"_18309":44158,"_5":12556,"_24913":44037,"_2529":44159},[],"check AMQP connectivity and credentials;",{"_3023":432,"_26291":379,"_18309":44161,"_5":12556,"_24913":44037,"_2529":44162},[],"review exchange, routing key, queues and consumers;",{"_3023":433,"_26291":379,"_18309":44164,"_5":12556,"_24913":44037,"_2529":44165},[],"inspect dead-letter queues;",{"_3023":434,"_26291":379,"_18309":44167,"_5":12556,"_24913":44037,"_2529":44168},[],"alert on orphan durable queues and backlog growth.",{"_3023":435,"_26291":379,"_18309":44170,"_5":12556,"_24913":44037,"_2529":44171},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3023":436,"_26291":379,"_18309":44173,"_5":12556,"_24913":44041,"_2529":44174},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_3023":437,"_26291":379,"_18309":44176,"_5":12556,"_24913":44041,"_2529":44177},[],"Before closing an incident, record:",{"_3023":438,"_26291":379,"_18309":44179,"_5":12556,"_24913":44041,"_2529":44180},[],"the confirmed cause;",{"_3023":439,"_26291":379,"_18309":44182,"_5":12556,"_24913":44041,"_2529":44183},[],"the time scope and affected resources;",{"_3023":440,"_26291":379,"_18309":44185,"_5":12556,"_24913":44041,"_2529":44186},[],"the commands or queries used;",{"_3023":441,"_26291":379,"_18309":44188,"_5":12556,"_24913":44041,"_2529":44189},[],"the applied change and how to revert it;",{"_3023":442,"_26291":379,"_18309":44191,"_5":12556,"_24913":44041,"_2529":44192},[],"validation from a consumer;",{"_3023":443,"_26291":379,"_18309":44194,"_5":12556,"_24913":44041,"_2529":44195},[],"the preventive action and its owner.",{"_3023":444,"_26291":444,"_5":12871,"_2529":44197,"_26635":44198,"_18309":44201,"_24913":444},"Access control",[42855,44199,44200],"Platform","Administration",[],{"_3023":445,"_26291":444,"_18309":44203,"_5":12556,"_24913":444,"_2529":44204},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3023":446,"_26291":444,"_5":26632,"_18309":44206,"_24913":44207,"_2529":44208},[],"/docs/pr-preview/pr-47/platform/administration/access-control#essential-concepts","Essential concepts",{"_3023":447,"_26291":444,"_5":26632,"_18309":44210,"_24913":44211,"_2529":44212},[],"/docs/pr-preview/pr-47/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3023":448,"_26291":444,"_5":26632,"_18309":44214,"_24913":44215,"_2529":44216},[],"/docs/pr-preview/pr-47/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3023":449,"_26291":444,"_5":26632,"_18309":44218,"_24913":44219,"_2529":44220},[],"/docs/pr-preview/pr-47/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3023":450,"_26291":444,"_5":26632,"_18309":44222,"_24913":44223,"_2529":44224},[],"/docs/pr-preview/pr-47/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3023":451,"_26291":444,"_5":26632,"_18309":44226,"_24913":44227,"_2529":44228},[],"/docs/pr-preview/pr-47/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3023":452,"_26291":444,"_5":26632,"_18309":44230,"_24913":44231,"_2529":44232},[],"/docs/pr-preview/pr-47/platform/administration/access-control#oidc-principals","OIDC principals",{"_3023":453,"_26291":444,"_5":26632,"_18309":44234,"_24913":44235,"_2529":44236},[],"/docs/pr-preview/pr-47/platform/administration/access-control#x509-principals","X.509 principals",{"_3023":454,"_26291":444,"_5":26632,"_18309":44238,"_24913":44239,"_2529":44240},[],"/docs/pr-preview/pr-47/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3023":455,"_26291":444,"_5":26632,"_18309":44242,"_24913":44243,"_2529":44244},[],"/docs/pr-preview/pr-47/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3023":456,"_26291":444,"_5":26632,"_18309":44246,"_24913":44247,"_2529":44248},[],"/docs/pr-preview/pr-47/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3023":457,"_26291":444,"_5":26632,"_18309":44250,"_24913":44251,"_2529":44252},[],"/docs/pr-preview/pr-47/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3023":458,"_26291":444,"_5":26632,"_18309":44254,"_24913":44255,"_2529":44256},[],"/docs/pr-preview/pr-47/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3023":459,"_26291":444,"_5":26632,"_18309":44258,"_24913":44259,"_2529":44260},[],"/docs/pr-preview/pr-47/platform/administration/access-control#http-rules","HTTP rules",{"_3023":460,"_26291":444,"_5":26632,"_18309":44262,"_24913":44263,"_2529":44264},[],"/docs/pr-preview/pr-47/platform/administration/access-control#included-policies","Included policies",{"_3023":461,"_26291":444,"_5":26632,"_18309":44266,"_24913":44267,"_2529":43458},[],"/docs/pr-preview/pr-47/platform/administration/access-control#provision-the-first-administrator",{"_3023":462,"_26291":444,"_5":26632,"_18309":44269,"_24913":44270,"_2529":44271},[],"/docs/pr-preview/pr-47/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3023":463,"_26291":444,"_5":26632,"_18309":44273,"_24913":44274,"_2529":44275},[],"/docs/pr-preview/pr-47/platform/administration/access-control#configure-the-two-jwt-validations","Configure the two JWT validations",{"_3023":464,"_26291":444,"_5":26632,"_18309":44277,"_24913":44278,"_2529":44279},[],"/docs/pr-preview/pr-47/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3023":465,"_26291":444,"_5":26632,"_18309":44281,"_24913":44282,"_2529":44283},[],"/docs/pr-preview/pr-47/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3023":466,"_26291":444,"_5":26632,"_18309":44285,"_24913":44286,"_2529":44287},[],"/docs/pr-preview/pr-47/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3023":467,"_26291":444,"_5":26632,"_18309":44289,"_24913":44290,"_2529":44291},[],"/docs/pr-preview/pr-47/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3023":468,"_26291":444,"_5":26632,"_18309":44293,"_24913":44294,"_2529":44295},[],"/docs/pr-preview/pr-47/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3023":469,"_26291":444,"_5":26632,"_18309":44297,"_24913":44298,"_2529":44299},[],"/docs/pr-preview/pr-47/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3023":470,"_26291":444,"_5":26632,"_18309":44301,"_24913":44302,"_2529":44303},[],"/docs/pr-preview/pr-47/platform/administration/access-control#operational-checklist","Operational checklist",{"_3023":471,"_26291":444,"_5":26632,"_18309":44305,"_24913":44306,"_2529":44307},[],"/docs/pr-preview/pr-47/platform/administration/access-control#diagnostics","Diagnostics",{"_3023":472,"_26291":444,"_5":26632,"_18309":44309,"_24913":44310,"_2529":44311},[],"/docs/pr-preview/pr-47/platform/administration/access-control#the-response-is-401","The response is 401",{"_3023":473,"_26291":444,"_5":26632,"_18309":44313,"_24913":44314,"_2529":44315},[],"/docs/pr-preview/pr-47/platform/administration/access-control#the-response-is-403","The response is 403",{"_3023":474,"_26291":444,"_5":26632,"_18309":44317,"_24913":44318,"_2529":44319},[],"/docs/pr-preview/pr-47/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3023":475,"_26291":444,"_5":26632,"_18309":44321,"_24913":44322,"_2529":44323},[],"/docs/pr-preview/pr-47/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3023":476,"_26291":444,"_5":26632,"_18309":44325,"_24913":44326,"_2529":44327},[],"/docs/pr-preview/pr-47/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3023":477,"_26291":444,"_18309":44329,"_5":12556,"_24913":444,"_2529":44330},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3023":478,"_26291":444,"_18309":44332,"_5":12556,"_24913":444,"_2529":44333},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3023":479,"_26291":444,"_18309":44335,"_5":12556,"_24913":444,"_2529":44336},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3023":480,"_26291":444,"_18309":44338,"_5":12556,"_24913":44207,"_2529":44339},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3023":481,"_26291":444,"_18309":44341,"_5":12556,"_24913":44207,"_2529":44342},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3023":482,"_26291":444,"_18309":44344,"_5":12556,"_24913":44207,"_2529":44345},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3023":483,"_26291":444,"_18309":44347,"_5":12556,"_24913":44207,"_2529":44348},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3023":484,"_26291":444,"_18309":44350,"_5":12556,"_24913":44207,"_2529":44351},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3023":485,"_26291":444,"_18309":44353,"_5":12556,"_24913":44207,"_2529":44354},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3023":486,"_26291":444,"_18309":44356,"_5":12556,"_24913":44211,"_2529":44357},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3023":487,"_26291":444,"_18309":44359,"_5":12556,"_24913":44211,"_2529":44360},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3023":488,"_26291":444,"_18309":44362,"_5":12556,"_24913":44215,"_2529":44363},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3023":489,"_26291":444,"_18309":44365,"_5":12556,"_24913":44215,"_2529":44366},[],"The decision is made **before forwarding the request to the service**:",{"_3023":490,"_26291":444,"_18309":44368,"_5":12556,"_24913":44215,"_2529":44369},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3023":491,"_26291":444,"_18309":44371,"_5":12556,"_24913":44215,"_2529":44372},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3023":492,"_26291":444,"_18309":44374,"_5":12556,"_24913":44215,"_2529":44375},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3023":493,"_26291":444,"_18309":44377,"_5":12556,"_24913":44215,"_2529":44378},[],"It separately loads the policies granted to each principal.",{"_3023":494,"_26291":444,"_18309":44380,"_5":12556,"_24913":44215,"_2529":44381},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3023":495,"_26291":444,"_18309":44383,"_5":12556,"_24913":44215,"_2529":44384},[],"`authz` looks for an HTTP rule granting that action.",{"_3023":496,"_26291":444,"_18309":44386,"_5":12556,"_24913":44215,"_2529":44387},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3023":497,"_26291":444,"_18309":44389,"_5":12556,"_24913":44215,"_2529":44390},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3023":498,"_26291":444,"_18309":44392,"_5":12556,"_24913":44215,"_2529":44393},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3023":499,"_26291":444,"_18309":44395,"_5":12556,"_24913":44215,"_2529":44396},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3023":500,"_26291":444,"_18309":44398,"_5":12556,"_24913":44219,"_2529":44399},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3023":501,"_26291":444,"_18309":44401,"_5":12556,"_24913":44219,"_2529":44402},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3023":502,"_26291":444,"_18309":44404,"_5":12556,"_24913":44219,"_2529":44405},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3023":503,"_26291":444,"_18309":44407,"_5":12556,"_24913":44219,"_2529":44408},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3023":504,"_26291":444,"_18309":44410,"_5":12556,"_24913":44219,"_2529":44411},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3023":505,"_26291":444,"_18309":44413,"_5":12556,"_24913":44219,"_2529":44414},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3023":506,"_26291":444,"_18309":44416,"_5":12556,"_24913":44219,"_2529":44417},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3023":507,"_26291":444,"_18309":44419,"_5":12556,"_24913":44219,"_2529":44420},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3023":508,"_26291":444,"_18309":44422,"_5":12556,"_24913":44223,"_2529":44423},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3023":509,"_26291":444,"_18309":44425,"_5":12556,"_24913":44223,"_2529":44426},[],"The decision is made with the domain operation context:",{"_3023":510,"_26291":444,"_18309":44428,"_5":12556,"_24913":44223,"_2529":44429},[],"The middleware extracts the credential and resolves the matching principals.",{"_3023":511,"_26291":444,"_18309":44431,"_5":12556,"_24913":44223,"_2529":44432},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3023":512,"_26291":444,"_18309":44434,"_5":12556,"_24913":44223,"_2529":44435},[],"`authz` gathers the entity rules of the granted policies.",{"_3023":513,"_26291":444,"_18309":44437,"_5":12556,"_24913":44223,"_2529":44438},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3023":514,"_26291":444,"_18309":44440,"_5":12556,"_24913":44223,"_2529":44441},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3023":515,"_26291":444,"_18309":44443,"_5":12556,"_24913":44223,"_2529":44444},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3023":516,"_26291":444,"_18309":44446,"_5":12556,"_24913":44223,"_2529":44447},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3023":517,"_26291":444,"_18309":44449,"_5":12556,"_24913":44223,"_2529":44450},[],"Actions fall into two groups:",{"_3023":518,"_26291":444,"_18309":44452,"_5":12556,"_24913":44223,"_2529":44453},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3023":519,"_26291":444,"_18309":44455,"_5":12556,"_24913":44223,"_2529":44456},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3023":520,"_26291":444,"_18309":44458,"_5":12556,"_24913":44223,"_2529":44459},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3023":521,"_26291":444,"_18309":44461,"_5":12556,"_24913":44227,"_2529":44462},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3023":522,"_26291":444,"_18309":44464,"_5":12556,"_24913":44227,"_2529":44465},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3023":523,"_26291":444,"_18309":44467,"_5":12556,"_24913":44227,"_2529":44468},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3023":524,"_26291":444,"_18309":44470,"_5":12556,"_24913":44231,"_2529":44471},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3023":525,"_26291":444,"_18309":44473,"_5":12556,"_24913":44231,"_2529":44474},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3023":526,"_26291":444,"_18309":44476,"_5":12556,"_24913":44231,"_2529":44477},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3023":527,"_26291":444,"_18309":44479,"_5":12556,"_24913":44231,"_2529":44480},[],"The implemented operators are:",{"_3023":528,"_26291":444,"_18309":44482,"_5":12556,"_24913":44231,"_2529":44483},[],"`equals`, for exact equality;",{"_3023":529,"_26291":444,"_18309":44485,"_5":12556,"_24913":44231,"_2529":44486},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3023":530,"_26291":444,"_18309":44488,"_5":12556,"_24913":44231,"_2529":44489},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3023":531,"_26291":444,"_18309":44491,"_5":12556,"_24913":44231,"_2529":44492},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3023":532,"_26291":444,"_18309":44494,"_5":12556,"_24913":44235,"_2529":44495},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3023":533,"_26291":444,"_18309":44497,"_5":12556,"_24913":44235,"_2529":44498},[],"The available modes are:",{"_3023":534,"_26291":444,"_18309":44500,"_5":12556,"_24913":44235,"_2529":44501},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3023":535,"_26291":444,"_18309":44503,"_5":12556,"_24913":44235,"_2529":44504},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3023":536,"_26291":444,"_18309":44506,"_5":12556,"_24913":44235,"_2529":44507},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3023":537,"_26291":444,"_18309":44509,"_5":12556,"_24913":44235,"_2529":44510},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3023":538,"_26291":444,"_18309":44512,"_5":12556,"_24913":44235,"_2529":44513},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3023":539,"_26291":444,"_18309":44515,"_5":12556,"_24913":44235,"_2529":44516},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3023":540,"_26291":444,"_18309":44518,"_5":12556,"_24913":44239,"_2529":44519},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3023":541,"_26291":444,"_18309":44521,"_5":12556,"_24913":44239,"_2529":44522},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3023":542,"_26291":444,"_18309":44524,"_5":12556,"_24913":44239,"_2529":44525},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3023":543,"_26291":444,"_18309":44527,"_5":12556,"_24913":44239,"_2529":44528},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3023":544,"_26291":444,"_18309":44530,"_5":12556,"_24913":44247,"_2529":44531},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3023":545,"_26291":444,"_18309":44533,"_5":12556,"_24913":44247,"_2529":44534},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3023":546,"_26291":444,"_18309":44536,"_5":12556,"_24913":44251,"_2529":44537},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3023":547,"_26291":444,"_18309":44539,"_5":12556,"_24913":44251,"_2529":44540},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3023":548,"_26291":444,"_18309":44542,"_5":12556,"_24913":44255,"_2529":44543},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3023":549,"_26291":444,"_18309":44545,"_5":12556,"_24913":44255,"_2529":44546},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3023":550,"_26291":444,"_18309":44548,"_5":12556,"_24913":44255,"_2529":44549},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3023":551,"_26291":444,"_18309":44551,"_5":12556,"_24913":44259,"_2529":44552},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3023":552,"_26291":444,"_18309":44554,"_5":12556,"_24913":44259,"_2529":44555},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3023":553,"_26291":444,"_18309":44557,"_5":12556,"_24913":44259,"_2529":44558},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3023":554,"_26291":444,"_18309":44560,"_5":12556,"_24913":44259,"_2529":44561},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3023":555,"_26291":444,"_18309":44563,"_5":12556,"_24913":44259,"_2529":44564},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3023":556,"_26291":444,"_18309":44566,"_5":12556,"_24913":44259,"_2529":44567},[],"Note that:",{"_3023":557,"_26291":444,"_18309":44569,"_5":12556,"_24913":44259,"_2529":44570},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3023":558,"_26291":444,"_18309":44572,"_5":12556,"_24913":44259,"_2529":44573},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3023":559,"_26291":444,"_18309":44575,"_5":12556,"_24913":44259,"_2529":44576},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3023":560,"_26291":444,"_18309":44578,"_5":12556,"_24913":44263,"_2529":44579},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3023":561,"_26291":444,"_18309":44581,"_5":12556,"_24913":44263,"_2529":44582},[],"full and read-only access to certificates and authorities;",{"_3023":562,"_26291":444,"_18309":44584,"_5":12556,"_24913":44263,"_2529":44585},[],"full and read-only access to the KMS;",{"_3023":563,"_26291":444,"_18309":44587,"_5":12556,"_24913":44263,"_2529":44588},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3023":564,"_26291":444,"_18309":44590,"_5":12556,"_24913":44263,"_2529":44591},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3023":565,"_26291":444,"_18309":44593,"_5":12556,"_24913":44263,"_2529":44594},[],"console access;",{"_3023":566,"_26291":444,"_18309":44596,"_5":12556,"_24913":44263,"_2529":44597},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3023":567,"_26291":444,"_18309":44599,"_5":12556,"_24913":44263,"_2529":44600},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3023":568,"_26291":444,"_18309":44602,"_5":12556,"_24913":44263,"_2529":44603},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3023":569,"_26291":444,"_18309":44605,"_5":12556,"_24913":44267,"_2529":44606},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3023":570,"_26291":444,"_18309":44608,"_5":12556,"_24913":44267,"_2529":44609},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3023":571,"_26291":444,"_18309":44611,"_5":12556,"_24913":44267,"_2529":44612},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3023":572,"_26291":444,"_18309":44614,"_5":12556,"_24913":44270,"_2529":44615},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3023":573,"_26291":444,"_18309":44617,"_5":12556,"_24913":44274,"_2529":44618},[],"The Gateway uses `auth.authentication.apiGateway.jwks` to authenticate requests. `authz` uses `services.authz.jwkUrl` to resolve OIDC principals. Both endpoints must contain the keys of the same issuer and be reachable from their respective components.",{"_3023":574,"_26291":444,"_18309":44620,"_5":12556,"_24913":44278,"_2529":44621},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3023":575,"_26291":444,"_18309":44623,"_5":12556,"_24913":44282,"_2529":44624},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3023":576,"_26291":444,"_18309":44626,"_5":12556,"_24913":44286,"_2529":44627},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3023":577,"_26291":444,"_18309":44629,"_5":12556,"_24913":44290,"_2529":44630},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3023":578,"_26291":444,"_18309":44632,"_5":12556,"_24913":44290,"_2529":44633},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3023":579,"_26291":444,"_18309":44635,"_5":12556,"_24913":44294,"_2529":44636},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3023":580,"_26291":444,"_18309":44638,"_5":12556,"_24913":44294,"_2529":44639},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3023":581,"_26291":444,"_18309":44641,"_5":12556,"_24913":44294,"_2529":44642},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3023":582,"_26291":444,"_18309":44644,"_5":12556,"_24913":44294,"_2529":44645},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3023":583,"_26291":444,"_18309":44647,"_5":12556,"_24913":44294,"_2529":44648},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3023":584,"_26291":444,"_18309":44650,"_5":12556,"_24913":44294,"_2529":44651},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3023":585,"_26291":444,"_18309":44653,"_5":12556,"_24913":44294,"_2529":44654},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3023":586,"_26291":444,"_18309":44656,"_5":12556,"_24913":44294,"_2529":44657},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3023":587,"_26291":444,"_18309":44659,"_5":12556,"_24913":44298,"_2529":44660},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3023":588,"_26291":444,"_18309":44662,"_5":12556,"_24913":44298,"_2529":44663},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3023":589,"_26291":444,"_18309":44665,"_5":12556,"_24913":44298,"_2529":44666},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3023":590,"_26291":444,"_18309":44668,"_5":12556,"_24913":44302,"_2529":44669},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3023":591,"_26291":444,"_18309":44671,"_5":12556,"_24913":44302,"_2529":44672},[],"Use groups or stable roles for people and independent identities for automations.",{"_3023":592,"_26291":444,"_18309":44674,"_5":12556,"_24913":44302,"_2529":44675},[],"Keep at least two recovery administrators and test their access periodically.",{"_3023":593,"_26291":444,"_18309":44677,"_5":12556,"_24913":44302,"_2529":44678},[],"Review active principals, their matches and their grants after IdP changes.",{"_3023":594,"_26291":444,"_18309":44680,"_5":12556,"_24913":44302,"_2529":44681},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3023":595,"_26291":444,"_18309":44683,"_5":12556,"_24913":44302,"_2529":44684},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3023":596,"_26291":444,"_18309":44686,"_5":12556,"_24913":44302,"_2529":44687},[],"Always test one allowed and one denied operation for each role.",{"_3023":597,"_26291":444,"_18309":44689,"_5":12556,"_24913":44302,"_2529":44690},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3023":598,"_26291":444,"_18309":44692,"_5":12556,"_24913":44310,"_2529":44693},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3023":599,"_26291":444,"_18309":44695,"_5":12556,"_24913":44314,"_2529":44696},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3023":600,"_26291":444,"_18309":44698,"_5":12556,"_24913":44314,"_2529":44699},[],"that an active principal of the correct type exists;",{"_3023":601,"_26291":444,"_18309":44701,"_5":12556,"_24913":44314,"_2529":44702},[],"that the claim paths and values match the real token exactly;",{"_3023":602,"_26291":444,"_18309":44704,"_5":12556,"_24913":44314,"_2529":44705},[],"that all of the principal's conditions hold;",{"_3023":603,"_26291":444,"_18309":44707,"_5":12556,"_24913":44314,"_2529":44708},[],"that the principal has the expected policy granted;",{"_3023":604,"_26291":444,"_18309":44710,"_5":12556,"_24913":44314,"_2529":44711},[],"that the policy includes the action and the requested resource type or route;",{"_3023":605,"_26291":444,"_18309":44713,"_5":12556,"_24913":44314,"_2529":44714},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3023":606,"_26291":444,"_18309":44716,"_5":12556,"_24913":44314,"_2529":44717},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_3023":607,"_26291":444,"_18309":44719,"_5":12556,"_24913":44318,"_2529":44720},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3023":608,"_26291":444,"_18309":44722,"_5":12556,"_24913":44322,"_2529":44723},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3023":609,"_26291":444,"_18309":44725,"_5":12556,"_24913":44326,"_2529":44726},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3023":610,"_26291":444,"_18309":44728,"_5":12556,"_24913":44326,"_2529":44729},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3023":611,"_26291":611,"_5":12871,"_2529":44731,"_26635":44732,"_18309":44733,"_24913":611},"Alerts and subscriptions",[42855,44199,44200],[],{"_3023":612,"_26291":611,"_18309":44735,"_5":12556,"_24913":611,"_2529":44736},[],"Send PKI events to people and external systems.",{"_3023":613,"_26291":611,"_5":26632,"_18309":44738,"_24913":44739,"_2529":44740},[],"/docs/pr-preview/pr-47/platform/administration/alerts#how-it-works","How it works",{"_3023":614,"_26291":611,"_5":26632,"_18309":44742,"_24913":44743,"_2529":44744},[],"/docs/pr-preview/pr-47/platform/administration/alerts#available-channels","Available channels",{"_3023":615,"_26291":611,"_5":26632,"_18309":44746,"_24913":44747,"_2529":44748},[],"/docs/pr-preview/pr-47/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3023":616,"_26291":611,"_5":26632,"_18309":44750,"_24913":44751,"_2529":44752},[],"/docs/pr-preview/pr-47/platform/administration/alerts#choose-the-event","Choose the event",{"_3023":617,"_26291":611,"_5":26632,"_18309":44754,"_24913":44755,"_2529":44756},[],"/docs/pr-preview/pr-47/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3023":618,"_26291":611,"_5":26632,"_18309":44758,"_24913":44759,"_2529":44760},[],"/docs/pr-preview/pr-47/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3023":619,"_26291":611,"_5":26632,"_18309":44762,"_24913":44763,"_2529":44764},[],"/docs/pr-preview/pr-47/platform/administration/alerts#review-and-activate","Review and activate",{"_3023":620,"_26291":611,"_5":26632,"_18309":44766,"_24913":44767,"_2529":44768},[],"/docs/pr-preview/pr-47/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3023":621,"_26291":611,"_5":26632,"_18309":44770,"_24913":44771,"_2529":44772},[],"/docs/pr-preview/pr-47/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3023":622,"_26291":611,"_5":26632,"_18309":44774,"_24913":44775,"_2529":44776},[],"/docs/pr-preview/pr-47/platform/administration/alerts#event-families","Event families",{"_3023":623,"_26291":611,"_18309":44778,"_5":12556,"_24913":611,"_2529":44779},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3023":624,"_26291":611,"_18309":44781,"_5":12556,"_24913":44739,"_2529":44782},[],"A service publishes a domain event.",{"_3023":625,"_26291":611,"_18309":44784,"_5":12556,"_24913":44739,"_2529":44785},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3023":626,"_26291":611,"_18309":44787,"_5":12556,"_24913":44739,"_2529":44788},[],"Each subscription's filter decides whether it should be notified.",{"_3023":627,"_26291":611,"_18309":44790,"_5":12556,"_24913":44739,"_2529":44791},[],"Lamassu delivers the event to the configured channel.",{"_3023":628,"_26291":611,"_18309":44793,"_5":12556,"_24913":44739,"_2529":44794},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3023":629,"_26291":611,"_18309":44796,"_5":12556,"_24913":44743,"_2529":44797},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3023":630,"_26291":611,"_18309":44799,"_5":12556,"_24913":44743,"_2529":44800},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3023":631,"_26291":611,"_18309":44802,"_5":12556,"_24913":44743,"_2529":44803},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3023":632,"_26291":611,"_18309":44805,"_5":12556,"_24913":44743,"_2529":44806},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3023":633,"_26291":611,"_18309":44808,"_5":12556,"_24913":44743,"_2529":44809},[],"`apikey_options` requires `header` and `key`.",{"_3023":634,"_26291":611,"_18309":44811,"_5":12556,"_24913":44743,"_2529":44812},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3023":635,"_26291":611,"_18309":44814,"_5":12556,"_24913":44743,"_2529":44815},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3023":636,"_26291":611,"_18309":44817,"_5":12556,"_24913":44743,"_2529":44818},[],"The alerts API reference documents the full `http_client` schema.",{"_3023":637,"_26291":611,"_18309":44820,"_5":12556,"_24913":44751,"_2529":44821},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3023":638,"_26291":611,"_18309":44823,"_5":12556,"_24913":44755,"_2529":44824},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3023":639,"_26291":611,"_18309":44826,"_5":12556,"_24913":44759,"_2529":44827},[],"Add a filter if you don't want to receive every instance of the event.",{"_3023":640,"_26291":611,"_18309":44829,"_5":12556,"_24913":44759,"_2529":44830},[],"**None** notifies all instances of the event.",{"_3023":641,"_26291":611,"_18309":44832,"_5":12556,"_24913":44759,"_2529":44833},[],"**JSON Path** evaluates one or more specific fields.",{"_3023":642,"_26291":611,"_18309":44835,"_5":12556,"_24913":44759,"_2529":44836},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3023":643,"_26291":611,"_18309":44838,"_5":12556,"_24913":44759,"_2529":44839},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3023":644,"_26291":611,"_18309":44841,"_5":12556,"_24913":44759,"_2529":44842},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3023":645,"_26291":611,"_18309":44844,"_5":12556,"_24913":44763,"_2529":44845},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3023":646,"_26291":611,"_18309":44847,"_5":12556,"_24913":44767,"_2529":44848},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3023":647,"_26291":611,"_18309":44850,"_5":12556,"_24913":44767,"_2529":44851},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3023":648,"_26291":611,"_18309":44853,"_5":12556,"_24913":44767,"_2529":44854},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3023":649,"_26291":611,"_18309":44856,"_5":12556,"_24913":44767,"_2529":44857},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3023":650,"_26291":611,"_18309":44859,"_5":12556,"_24913":44767,"_2529":44860},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3023":651,"_26291":611,"_18309":44862,"_5":12556,"_24913":44767,"_2529":44863},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3023":652,"_26291":611,"_18309":44865,"_5":12556,"_24913":44767,"_2529":44866},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3023":653,"_26291":611,"_18309":44868,"_5":12556,"_24913":44767,"_2529":44869},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3023":654,"_26291":611,"_18309":44871,"_5":12556,"_24913":44771,"_2529":44872},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3023":655,"_26291":611,"_18309":44874,"_5":12556,"_24913":44775,"_2529":44875},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3023":656,"_26291":611,"_18309":44877,"_5":12556,"_24913":44775,"_2529":44878},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3023":657,"_26291":611,"_18309":44880,"_5":12556,"_24913":44775,"_2529":44881},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3023":658,"_26291":611,"_18309":44883,"_5":12556,"_24913":44775,"_2529":44884},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3023":659,"_26291":611,"_18309":44886,"_5":12556,"_24913":44775,"_2529":44887},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3023":660,"_26291":611,"_18309":44889,"_5":12556,"_24913":44775,"_2529":44890},[],"**Validation:** `va.role.crl.create`.",{"_3023":661,"_26291":611,"_18309":44892,"_5":12556,"_24913":44775,"_2529":44893},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3023":662,"_26291":611,"_18309":44895,"_5":12556,"_24913":44775,"_2529":44896},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3023":663,"_26291":663,"_5":12871,"_2529":44898,"_26635":44899,"_18309":44900,"_24913":663},"Audit logs",[42855,44199,44200],[],{"_3023":664,"_26291":663,"_18309":44902,"_5":12556,"_24913":663,"_2529":44903},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3023":665,"_26291":663,"_5":26632,"_18309":44905,"_24913":44906,"_2529":44907},[],"/docs/pr-preview/pr-47/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3023":666,"_26291":663,"_5":26632,"_18309":44909,"_24913":44910,"_2529":44911},[],"/docs/pr-preview/pr-47/platform/administration/audit-logs#coverage","Coverage",{"_3023":667,"_26291":663,"_5":26632,"_18309":44913,"_24913":44914,"_2529":44915},[],"/docs/pr-preview/pr-47/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3023":668,"_26291":663,"_5":26632,"_18309":44917,"_24913":44918,"_2529":44919},[],"/docs/pr-preview/pr-47/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3023":669,"_26291":663,"_5":26632,"_18309":44921,"_24913":44922,"_2529":44923},[],"/docs/pr-preview/pr-47/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3023":670,"_26291":663,"_5":26632,"_18309":44925,"_24913":44926,"_2529":44927},[],"/docs/pr-preview/pr-47/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3023":671,"_26291":663,"_5":26632,"_18309":44929,"_24913":44930,"_2529":44931},[],"/docs/pr-preview/pr-47/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3023":672,"_26291":663,"_5":26632,"_18309":44933,"_24913":44934,"_2529":44935},[],"/docs/pr-preview/pr-47/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3023":673,"_26291":663,"_5":26632,"_18309":44937,"_24913":44938,"_2529":44939},[],"/docs/pr-preview/pr-47/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3023":674,"_26291":663,"_5":26632,"_18309":44941,"_24913":44942,"_2529":44943},[],"/docs/pr-preview/pr-47/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3023":675,"_26291":663,"_5":26632,"_18309":44945,"_24913":44946,"_2529":44947},[],"/docs/pr-preview/pr-47/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3023":676,"_26291":663,"_18309":44949,"_5":12556,"_24913":663,"_2529":44950},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3023":677,"_26291":663,"_18309":44952,"_5":12556,"_24913":44906,"_2529":44953},[],"The audit body includes:",{"_3023":678,"_26291":663,"_18309":44955,"_5":12556,"_24913":44906,"_2529":44956},[],"input: data received by the operation;",{"_3023":679,"_26291":663,"_18309":44958,"_5":12556,"_24913":44906,"_2529":44959},[],"has\\_error: whether the service returned an error;",{"_3023":680,"_26291":663,"_18309":44961,"_5":12556,"_24913":44906,"_2529":44962},[],"output: produced result or error message;",{"_3023":681,"_26291":663,"_18309":44964,"_5":12556,"_24913":44906,"_2529":44965},[],"principals: identifiers of the principals that matched the request.",{"_3023":682,"_26291":663,"_18309":44967,"_5":12556,"_24913":44906,"_2529":44968},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3023":683,"_26291":663,"_18309":44970,"_5":12556,"_24913":44906,"_2529":44971},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3023":684,"_26291":663,"_18309":44973,"_5":12556,"_24913":44910,"_2529":44974},[],"The backend applies auditing to mutations of:",{"_3023":685,"_26291":663,"_18309":44976,"_5":12556,"_24913":44910,"_2529":44977},[],"authorities, certificates and issuance profiles;",{"_3023":686,"_26291":663,"_18309":44979,"_5":12556,"_24913":44910,"_2529":44980},[],"keys and KMS engines;",{"_3023":687,"_26291":663,"_18309":44982,"_5":12556,"_24913":44910,"_2529":44983},[],"devices and identities;",{"_3023":688,"_26291":663,"_18309":44985,"_5":12556,"_24913":44910,"_2529":44986},[],"DMSs and enrollment operations;",{"_3023":689,"_26291":663,"_18309":44988,"_5":12556,"_24913":44910,"_2529":44989},[],"validation functions and CRL;",{"_3023":690,"_26291":663,"_18309":44991,"_5":12556,"_24913":44910,"_2529":44992},[],"principals, policies and authorization grants.",{"_3023":691,"_26291":663,"_18309":44994,"_5":12556,"_24913":44910,"_2529":44995},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3023":692,"_26291":663,"_18309":44997,"_5":12556,"_24913":44914,"_2529":44998},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3023":693,"_26291":663,"_18309":45000,"_5":12556,"_24913":44914,"_2529":45001},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3023":694,"_26291":663,"_18309":45003,"_5":12556,"_24913":44914,"_2529":45004},[],"Design the consumer to:",{"_3023":695,"_26291":663,"_18309":45006,"_5":12556,"_24913":44914,"_2529":45007},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3023":696,"_26291":663,"_18309":45009,"_5":12556,"_24913":44914,"_2529":45010},[],"keep the complete CloudEvent unmodified;",{"_3023":697,"_26291":663,"_18309":45012,"_5":12556,"_24913":44914,"_2529":45013},[],"record the ingestion time and detect duplicates by ID;",{"_3023":698,"_26291":663,"_18309":45015,"_5":12556,"_24913":44914,"_2529":45016},[],"encrypt in transit and at rest;",{"_3023":699,"_26291":663,"_18309":45018,"_5":12556,"_24913":44914,"_2529":45019},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3023":700,"_26291":663,"_18309":45021,"_5":12556,"_24913":44914,"_2529":45022},[],"apply an explicit retention and legal hold policy;",{"_3023":701,"_26291":663,"_18309":45024,"_5":12556,"_24913":44914,"_2529":45025},[],"alert if it stops consuming or the pending queue grows.",{"_3023":702,"_26291":663,"_18309":45027,"_5":12556,"_24913":44918,"_2529":45028},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3023":703,"_26291":663,"_18309":45030,"_5":12556,"_24913":44918,"_2529":45031},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3023":704,"_26291":663,"_18309":45033,"_5":12556,"_24913":44926,"_2529":45034},[],"Start from the reported time and normalize every source to UTC.",{"_3023":705,"_26291":663,"_18309":45036,"_5":12556,"_24913":44930,"_2529":45037},[],"Filter by event type, service source and resource identifier.",{"_3023":706,"_26291":663,"_18309":45039,"_5":12556,"_24913":44934,"_2529":45040},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3023":707,"_26291":663,"_18309":45042,"_5":12556,"_24913":44938,"_2529":45043},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3023":708,"_26291":663,"_18309":45045,"_5":12556,"_24913":44942,"_2529":45046},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3023":709,"_26291":663,"_18309":45048,"_5":12556,"_24913":44946,"_2529":45049},[],"Generate a controlled mutation in a test environment and check that:",{"_3023":710,"_26291":663,"_18309":45051,"_5":12556,"_24913":44946,"_2529":45052},[],"a successful audit event appears;",{"_3023":711,"_26291":663,"_18309":45054,"_5":12556,"_24913":44946,"_2529":45055},[],"the principal matches the identity used;",{"_3023":712,"_26291":663,"_18309":45057,"_5":12556,"_24913":44946,"_2529":45058},[],"the consumer persists it exactly once;",{"_3023":713,"_26291":663,"_18309":45060,"_5":12556,"_24913":44946,"_2529":45061},[],"it can be retrieved by resource, actor and period;",{"_3023":714,"_26291":663,"_18309":45063,"_5":12556,"_24913":44946,"_2529":45064},[],"a consumer outage raises an alert.",{"_3023":715,"_26291":663,"_18309":45066,"_5":12556,"_24913":44946,"_2529":45067},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3023":716,"_26291":716,"_5":12871,"_2529":45069,"_26635":45070,"_18309":45071,"_24913":716},"Platform architecture",[42855,44199],[],{"_3023":717,"_26291":716,"_18309":45073,"_5":12556,"_24913":716,"_2529":45074},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3023":718,"_26291":716,"_5":26632,"_18309":45076,"_24913":45077,"_2529":45078},[],"/docs/pr-preview/pr-47/platform/concepts/architecture#control-plane","Control plane",{"_3023":719,"_26291":716,"_5":26632,"_18309":45080,"_24913":45081,"_2529":45082},[],"/docs/pr-preview/pr-47/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3023":720,"_26291":716,"_5":26632,"_18309":45084,"_24913":45085,"_2529":45086},[],"/docs/pr-preview/pr-47/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3023":721,"_26291":716,"_5":26632,"_18309":45088,"_24913":45089,"_2529":45090},[],"/docs/pr-preview/pr-47/platform/concepts/architecture#status-and-validation","Status and validation",{"_3023":722,"_26291":716,"_5":26632,"_18309":45092,"_24913":45093,"_2529":45094},[],"/docs/pr-preview/pr-47/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3023":723,"_26291":716,"_18309":45096,"_5":12556,"_24913":716,"_2529":45097},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3023":724,"_26291":716,"_18309":45099,"_5":12556,"_24913":716,"_2529":45100},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3023":725,"_26291":716,"_18309":45102,"_5":12556,"_24913":45077,"_2529":45103},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3023":726,"_26291":716,"_18309":45105,"_5":12556,"_24913":45081,"_2529":45106},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3023":727,"_26291":716,"_18309":45108,"_5":12556,"_24913":45085,"_2529":45109},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3023":728,"_26291":716,"_18309":45111,"_5":12556,"_24913":45089,"_2529":45112},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3023":729,"_26291":716,"_18309":45114,"_5":12556,"_24913":45093,"_2529":45115},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3023":730,"_26291":730,"_5":12871,"_2529":45117,"_26635":45118,"_18309":45119,"_24913":730},"How Lamassu works",[42855,44199],[],{"_3023":731,"_26291":730,"_18309":45121,"_5":12556,"_24913":730,"_2529":45122},[],"The mental model of trust, keys, certificates and devices.",{"_3023":732,"_26291":730,"_5":26632,"_18309":45124,"_24913":45125,"_2529":45126},[],"/docs/pr-preview/pr-47/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3023":733,"_26291":730,"_5":26632,"_18309":45128,"_24913":45129,"_2529":45130},[],"/docs/pr-preview/pr-47/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3023":734,"_26291":730,"_18309":45132,"_5":12556,"_24913":730,"_2529":45133},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3023":735,"_26291":730,"_18309":45135,"_5":12556,"_24913":45125,"_2529":45136},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3023":736,"_26291":730,"_18309":45138,"_5":12556,"_24913":45125,"_2529":45139},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3023":737,"_26291":730,"_18309":45141,"_5":12556,"_24913":45125,"_2529":45142},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3023":738,"_26291":730,"_18309":45144,"_5":12556,"_24913":45125,"_2529":45145},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3023":739,"_26291":730,"_18309":45147,"_5":12556,"_24913":45125,"_2529":45148},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3023":740,"_26291":730,"_18309":45150,"_5":12556,"_24913":45129,"_2529":45151},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3023":741,"_26291":730,"_18309":45153,"_5":12556,"_24913":45129,"_2529":45154},[],"A DMS relates that CA to an enrollment policy.",{"_3023":742,"_26291":730,"_18309":45156,"_5":12556,"_24913":45129,"_2529":45157},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3023":743,"_26291":730,"_18309":45159,"_5":12556,"_24913":45129,"_2529":45160},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3023":744,"_26291":730,"_18309":45162,"_5":12556,"_24913":45129,"_2529":45163},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3023":745,"_26291":730,"_18309":45165,"_5":12556,"_24913":45129,"_2529":45166},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3023":746,"_26291":730,"_18309":45168,"_5":12556,"_24913":45129,"_2529":45169},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3023":747,"_26291":747,"_5":12871,"_2529":45171,"_26635":45172,"_18309":45174,"_24913":747},"Devices and identities",[42855,44199,45173,45171],"IoT Fleets",[],{"_3023":748,"_26291":747,"_18309":45176,"_5":12556,"_24913":747,"_2529":45177},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3023":749,"_26291":747,"_5":26632,"_18309":45179,"_24913":45180,"_2529":45181},[],"/docs/pr-preview/pr-47/platform/iot-fleets/device-management#device-states","Device states",{"_3023":750,"_26291":747,"_5":26632,"_18309":45183,"_24913":45184,"_2529":45185},[],"/docs/pr-preview/pr-47/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3023":751,"_26291":747,"_5":26632,"_18309":45187,"_24913":45188,"_2529":45189},[],"/docs/pr-preview/pr-47/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3023":752,"_26291":747,"_5":26632,"_18309":45191,"_24913":45192,"_2529":45193},[],"/docs/pr-preview/pr-47/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3023":753,"_26291":747,"_5":26632,"_18309":45195,"_24913":45196,"_2529":45197},[],"/docs/pr-preview/pr-47/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3023":754,"_26291":747,"_5":26632,"_18309":45199,"_24913":45200,"_2529":45201},[],"/docs/pr-preview/pr-47/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3023":755,"_26291":747,"_5":26632,"_18309":45203,"_24913":45204,"_2529":45205},[],"/docs/pr-preview/pr-47/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3023":756,"_26291":747,"_5":26632,"_18309":45207,"_24913":45208,"_2529":45209},[],"/docs/pr-preview/pr-47/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3023":757,"_26291":747,"_5":26632,"_18309":45211,"_24913":45212,"_2529":45213},[],"/docs/pr-preview/pr-47/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3023":758,"_26291":747,"_5":26632,"_18309":45215,"_24913":45216,"_2529":45217},[],"/docs/pr-preview/pr-47/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3023":759,"_26291":747,"_5":26632,"_18309":45219,"_24913":45220,"_2529":45221},[],"/docs/pr-preview/pr-47/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3023":760,"_26291":747,"_18309":45223,"_5":12556,"_24913":747,"_2529":45224},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3023":761,"_26291":747,"_18309":45226,"_5":12556,"_24913":747,"_2529":45227},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3023":762,"_26291":747,"_18309":45229,"_5":12556,"_24913":45180,"_2529":45230},[],"Operational view",{"_3023":763,"_26291":747,"_18309":45232,"_5":12556,"_24913":45180,"_2529":45233},[],"Meaning",{"_3023":764,"_26291":747,"_18309":45235,"_5":12556,"_24913":45180,"_2529":45236},[],"**No Identity**",{"_3023":765,"_26291":747,"_18309":45238,"_5":12556,"_24913":45180,"_2529":45239},[],"A record exists without an associated identity.",{"_3023":766,"_26291":747,"_18309":45241,"_5":12556,"_24913":45180,"_2529":45242},[],"**Active**",{"_3023":767,"_26291":747,"_18309":45244,"_5":12556,"_24913":45180,"_2529":45245},[],"The slot is active; also check certificate dates, status and usages.",{"_3023":768,"_26291":747,"_18309":45247,"_5":12556,"_24913":45180,"_2529":45248},[],"**Renewal Pending**",{"_3023":769,"_26291":747,"_18309":45250,"_5":12556,"_24913":45180,"_2529":45251},[],"The identity is in the operational renewal window.",{"_3023":770,"_26291":747,"_18309":45253,"_5":12556,"_24913":45180,"_2529":45254},[],"**Expiring Soon**",{"_3023":771,"_26291":747,"_18309":45256,"_5":12556,"_24913":45180,"_2529":45257},[],"Expiration is approaching according to configured thresholds.",{"_3023":772,"_26291":747,"_18309":45259,"_5":12556,"_24913":45180,"_2529":45260},[],"**Expired**",{"_3023":773,"_26291":747,"_18309":45262,"_5":12556,"_24913":45180,"_2529":45263},[],"The identity has expired.",{"_3023":774,"_26291":747,"_18309":45265,"_5":12556,"_24913":45180,"_2529":45266},[],"**Revoked**",{"_3023":775,"_26291":747,"_18309":45268,"_5":12556,"_24913":45180,"_2529":45269},[],"The identity is marked revoked.",{"_3023":776,"_26291":747,"_18309":45271,"_5":12556,"_24913":45180,"_2529":45272},[],"**Decommissioned**",{"_3023":777,"_26291":747,"_18309":45274,"_5":12556,"_24913":45180,"_2529":45275},[],"The record is retired and ordinary updates do not restore operation.",{"_3023":778,"_26291":747,"_18309":45277,"_5":12556,"_24913":45180,"_2529":45278},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3023":779,"_26291":747,"_18309":45280,"_5":12556,"_24913":45184,"_2529":45281},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3023":780,"_26291":747,"_18309":45283,"_5":12556,"_24913":45184,"_2529":45284},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3023":781,"_26291":747,"_18309":45286,"_5":12556,"_24913":45184,"_2529":45287},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3023":782,"_26291":747,"_18309":45289,"_5":12556,"_24913":45184,"_2529":45290},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3023":783,"_26291":747,"_18309":45292,"_5":12556,"_24913":45188,"_2529":45293},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3023":784,"_26291":747,"_18309":45295,"_5":12556,"_24913":45192,"_2529":45296},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3023":785,"_26291":747,"_18309":45298,"_5":12556,"_24913":45196,"_2529":45299},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3023":786,"_26291":747,"_18309":45301,"_5":12556,"_24913":45200,"_2529":45302},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3023":787,"_26291":747,"_18309":45304,"_5":12556,"_24913":45204,"_2529":45305},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3023":788,"_26291":747,"_18309":45307,"_5":12556,"_24913":45204,"_2529":45308},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3023":789,"_26291":747,"_18309":45310,"_5":12556,"_24913":45208,"_2529":45311},[],"From **No Identity**, use **Assign Identity**:",{"_3023":790,"_26291":747,"_18309":45313,"_5":12556,"_24913":45208,"_2529":45314},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3023":791,"_26291":747,"_18309":45316,"_5":12556,"_24913":45208,"_2529":45317},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3023":792,"_26291":747,"_18309":45319,"_5":12556,"_24913":45208,"_2529":45320},[],"Confirm and read the serial, active version and history again.",{"_3023":793,"_26291":747,"_18309":45322,"_5":12556,"_24913":45208,"_2529":45323},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3023":794,"_26291":747,"_18309":45325,"_5":12556,"_24913":45208,"_2529":45326},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3023":795,"_26291":747,"_18309":45328,"_5":12556,"_24913":45212,"_2529":45329},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3023":796,"_26291":747,"_18309":45331,"_5":12556,"_24913":45212,"_2529":45332},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3023":797,"_26291":747,"_18309":45334,"_5":12556,"_24913":45216,"_2529":45335},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3023":798,"_26291":747,"_18309":45337,"_5":12556,"_24913":45216,"_2529":45338},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3023":799,"_26291":747,"_18309":45340,"_5":12556,"_24913":45216,"_2529":45341},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3023":800,"_26291":747,"_18309":45343,"_5":12556,"_24913":45216,"_2529":45344},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3023":801,"_26291":747,"_18309":45346,"_5":12556,"_24913":45220,"_2529":45347},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3023":802,"_26291":747,"_18309":45349,"_5":12556,"_24913":45220,"_2529":45350},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3023":803,"_26291":803,"_5":12871,"_2529":45352,"_26635":45353,"_18309":45355,"_24913":803},"Bootstrap identity and authentication",[42855,44199,45173,45171,45354],"Enrollment with PKI",[],{"_3023":804,"_26291":803,"_18309":45357,"_5":12556,"_24913":803,"_2529":45358},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3023":805,"_26291":803,"_5":26632,"_18309":45360,"_24913":45361,"_2529":45362},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3023":806,"_26291":803,"_5":26632,"_18309":45364,"_24913":45365,"_2529":45366},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3023":807,"_26291":803,"_5":26632,"_18309":45368,"_24913":45369,"_2529":45370},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3023":808,"_26291":803,"_5":26632,"_18309":45372,"_24913":45373,"_2529":45374},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3023":809,"_26291":803,"_5":26632,"_18309":45376,"_24913":45377,"_2529":45378},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3023":810,"_26291":803,"_18309":45380,"_5":12556,"_24913":803,"_2529":45381},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3023":811,"_26291":803,"_18309":45383,"_5":12556,"_24913":45361,"_2529":45384},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3023":812,"_26291":803,"_18309":45386,"_5":12556,"_24913":45361,"_2529":45387},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3023":813,"_26291":803,"_18309":45389,"_5":12556,"_24913":45365,"_2529":45390},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3023":814,"_26291":803,"_18309":45392,"_5":12556,"_24913":45365,"_2529":45393},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3023":815,"_26291":803,"_18309":45395,"_5":12556,"_24913":45365,"_2529":45396},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3023":816,"_26291":803,"_18309":45398,"_5":12556,"_24913":45369,"_2529":45399},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3023":817,"_26291":803,"_18309":45401,"_5":12556,"_24913":45369,"_2529":45402},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3023":818,"_26291":803,"_18309":45404,"_5":12556,"_24913":45373,"_2529":45405},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3023":819,"_26291":803,"_18309":45407,"_5":12556,"_24913":45373,"_2529":45408},[],"Example body:",{"_3023":820,"_26291":803,"_18309":45410,"_5":12556,"_24913":45373,"_2529":45411},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3023":821,"_26291":803,"_18309":45413,"_5":12556,"_24913":45373,"_2529":45414},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3023":822,"_26291":803,"_18309":45416,"_5":12556,"_24913":45373,"_2529":45417},[],"Continuation requires a successful HTTP response and JSON:",{"_3023":823,"_26291":803,"_18309":45419,"_5":12556,"_24913":45373,"_2529":45420},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3023":824,"_26291":803,"_18309":45422,"_5":12556,"_24913":45377,"_2529":45423},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3023":825,"_26291":803,"_18309":45425,"_5":12556,"_24913":45377,"_2529":45426},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3023":826,"_26291":826,"_5":12871,"_2529":45428,"_26635":45429,"_18309":45430,"_24913":826},"Configure and operate the DMS",[42855,44199,45173,45171,45354],[],{"_3023":827,"_26291":826,"_18309":45432,"_5":12556,"_24913":826,"_2529":45433},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3023":828,"_26291":826,"_5":26632,"_18309":45435,"_24913":45436,"_2529":42865},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3023":829,"_26291":826,"_5":26632,"_18309":45438,"_24913":45439,"_2529":45440},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3023":830,"_26291":826,"_5":26632,"_18309":45442,"_24913":45443,"_2529":45444},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3023":831,"_26291":826,"_5":26632,"_18309":45446,"_24913":45447,"_2529":45448},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3023":832,"_26291":826,"_5":26632,"_18309":45450,"_24913":45451,"_2529":45452},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3023":833,"_26291":826,"_5":26632,"_18309":45454,"_24913":45455,"_2529":45456},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3023":834,"_26291":826,"_5":26632,"_18309":45458,"_24913":45459,"_2529":45460},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3023":835,"_26291":826,"_5":26632,"_18309":45462,"_24913":45463,"_2529":45464},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3023":836,"_26291":826,"_5":26632,"_18309":45466,"_24913":45467,"_2529":45468},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3023":837,"_26291":826,"_5":26632,"_18309":45470,"_24913":45471,"_2529":45472},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3023":838,"_26291":826,"_5":26632,"_18309":45474,"_24913":45475,"_2529":45476},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3023":839,"_26291":826,"_5":26632,"_18309":45478,"_24913":45479,"_2529":45480},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3023":840,"_26291":826,"_5":26632,"_18309":45482,"_24913":45483,"_2529":45484},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3023":841,"_26291":826,"_5":26632,"_18309":45486,"_24913":45487,"_2529":45488},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3023":842,"_26291":826,"_5":26632,"_18309":45490,"_24913":45491,"_2529":45492},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3023":843,"_26291":826,"_5":26632,"_18309":45494,"_24913":45495,"_2529":45496},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3023":844,"_26291":826,"_5":26632,"_18309":45498,"_24913":45499,"_2529":45500},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3023":845,"_26291":826,"_5":26632,"_18309":45502,"_24913":45503,"_2529":45504},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3023":846,"_26291":826,"_18309":45506,"_5":12556,"_24913":826,"_2529":45507},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3023":847,"_26291":826,"_18309":45509,"_5":12556,"_24913":45436,"_2529":45510},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3023":848,"_26291":826,"_18309":45512,"_5":12556,"_24913":45436,"_2529":45513},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3023":849,"_26291":826,"_18309":45515,"_5":12556,"_24913":45443,"_2529":45516},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3023":850,"_26291":826,"_18309":45518,"_5":12556,"_24913":45447,"_2529":45519},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3023":851,"_26291":826,"_18309":45521,"_5":12556,"_24913":45451,"_2529":45522},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3023":852,"_26291":826,"_18309":45524,"_5":12556,"_24913":45455,"_2529":45525},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3023":853,"_26291":826,"_18309":45527,"_5":12556,"_24913":45459,"_2529":45528},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3023":854,"_26291":826,"_18309":45530,"_5":12556,"_24913":45467,"_2529":45531},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3023":855,"_26291":826,"_18309":45533,"_5":12556,"_24913":45467,"_2529":45534},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3023":856,"_26291":826,"_18309":45536,"_5":12556,"_24913":45471,"_2529":45537},[],"`settings.enrollment_settings` field",{"_3023":857,"_26291":826,"_18309":45539,"_5":12556,"_24913":45471,"_2529":45540},[],"Decision",{"_3023":858,"_26291":826,"_18309":45542,"_5":12556,"_24913":45471,"_2529":45543},[],"`protocol`",{"_3023":859,"_26291":826,"_18309":45545,"_5":12556,"_24913":45471,"_2529":45546},[],"`EST_RFC7030` for these operations.",{"_3023":860,"_26291":826,"_18309":45548,"_5":12556,"_24913":45471,"_2529":45549},[],"`enrollment_ca`",{"_3023":861,"_26291":826,"_18309":45551,"_5":12556,"_24913":45471,"_2529":45552},[],"ID of the signing CA.",{"_3023":862,"_26291":826,"_18309":45554,"_5":12556,"_24913":45471,"_2529":45555},[],"`verify_csr_signature`",{"_3023":863,"_26291":826,"_18309":45557,"_5":12556,"_24913":45471,"_2529":45558},[],"Keep `true` to verify CSR key possession.",{"_3023":864,"_26291":826,"_18309":45560,"_5":12556,"_24913":45471,"_2529":45561},[],"`enable_replaceable_enrollment`",{"_3023":865,"_26291":826,"_18309":45563,"_5":12556,"_24913":45471,"_2529":45564},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3023":866,"_26291":826,"_18309":45566,"_5":12556,"_24913":45471,"_2529":45567},[],"`est_rfc7030_settings.auth_mode`",{"_3023":867,"_26291":826,"_18309":45569,"_5":12556,"_24913":45471,"_2529":45570},[],"One of the four authentication modes.",{"_3023":868,"_26291":826,"_18309":45572,"_5":12556,"_24913":45471,"_2529":45573},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3023":869,"_26291":826,"_18309":45575,"_5":12556,"_24913":45475,"_2529":45576},[],"The blocks are independent:",{"_3023":870,"_26291":826,"_18309":45578,"_5":12556,"_24913":45475,"_2529":45579},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3023":871,"_26291":826,"_18309":45581,"_5":12556,"_24913":45475,"_2529":45582},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3023":872,"_26291":826,"_18309":45584,"_5":12556,"_24913":45475,"_2529":45585},[],"`auth_mode`",{"_3023":873,"_26291":826,"_18309":45587,"_5":12556,"_24913":45475,"_2529":45588},[],"Control applied in the configured operation",{"_3023":874,"_26291":826,"_18309":45590,"_5":12556,"_24913":45475,"_2529":45591},[],"`CLIENT_CERTIFICATE`",{"_3023":875,"_26291":826,"_18309":45593,"_5":12556,"_24913":45475,"_2529":45594},[],"Presented certificate validation.",{"_3023":876,"_26291":826,"_18309":45596,"_5":12556,"_24913":45475,"_2529":45597},[],"`EXTERNAL_WEBHOOK`",{"_3023":877,"_26291":826,"_18309":45599,"_5":12556,"_24913":45475,"_2529":45600},[],"Configured webhook authorization.",{"_3023":878,"_26291":826,"_18309":45602,"_5":12556,"_24913":45475,"_2529":45603},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3023":879,"_26291":826,"_18309":45605,"_5":12556,"_24913":45475,"_2529":45606},[],"Certificate validation followed by webhook approval.",{"_3023":880,"_26291":826,"_18309":45608,"_5":12556,"_24913":45475,"_2529":45609},[],"`NO_AUTH`",{"_3023":881,"_26291":826,"_18309":45611,"_5":12556,"_24913":45475,"_2529":45612},[],"No DMS requester authentication.",{"_3023":882,"_26291":826,"_18309":45614,"_5":12556,"_24913":45475,"_2529":45615},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3023":883,"_26291":826,"_18309":45617,"_5":12556,"_24913":45475,"_2529":45618},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3023":884,"_26291":826,"_18309":45620,"_5":12556,"_24913":45475,"_2529":45621},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3023":885,"_26291":826,"_18309":45623,"_5":12556,"_24913":45475,"_2529":45624},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3023":886,"_26291":826,"_18309":45626,"_5":12556,"_24913":45479,"_2529":45627},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3023":887,"_26291":826,"_18309":45629,"_5":12556,"_24913":45479,"_2529":45630},[],"`external_webhook_settings` field",{"_3023":888,"_26291":826,"_18309":45632,"_5":12556,"_24913":45479,"_2529":45540},[],{"_3023":889,"_26291":826,"_18309":45634,"_5":12556,"_24913":45479,"_2529":45635},[],"`url`",{"_3023":890,"_26291":826,"_18309":45637,"_5":12556,"_24913":45479,"_2529":45638},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3023":891,"_26291":826,"_18309":45640,"_5":12556,"_24913":45479,"_2529":45641},[],"`method`",{"_3023":892,"_26291":826,"_18309":45643,"_5":12556,"_24913":45479,"_2529":45644},[],"`POST` or `PUT`; `POST` by default.",{"_3023":893,"_26291":826,"_18309":45646,"_5":12556,"_24913":45479,"_2529":45647},[],"`name`",{"_3023":894,"_26291":826,"_18309":45649,"_5":12556,"_24913":45479,"_2529":45650},[],"Label used in service logs.",{"_3023":895,"_26291":826,"_18309":45652,"_5":12556,"_24913":45479,"_2529":45653},[],"`config.auth_mode`",{"_3023":896,"_26291":826,"_18309":45655,"_5":12556,"_24913":45479,"_2529":45656},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3023":897,"_26291":826,"_18309":45658,"_5":12556,"_24913":45479,"_2529":45659},[],"`config.apikey_options`",{"_3023":898,"_26291":826,"_18309":45661,"_5":12556,"_24913":45479,"_2529":45662},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3023":899,"_26291":826,"_18309":45664,"_5":12556,"_24913":45479,"_2529":45665},[],"`config.jwt_options`",{"_3023":900,"_26291":826,"_18309":45667,"_5":12556,"_24913":45479,"_2529":45668},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3023":901,"_26291":826,"_18309":45670,"_5":12556,"_24913":45479,"_2529":45671},[],"`config.mtls_options`",{"_3023":902,"_26291":826,"_18309":45673,"_5":12556,"_24913":45479,"_2529":45674},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3023":903,"_26291":826,"_18309":45676,"_5":12556,"_24913":45479,"_2529":45677},[],"`config.insecure_skip_verify`",{"_3023":904,"_26291":826,"_18309":45679,"_5":12556,"_24913":45479,"_2529":45680},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3023":905,"_26291":826,"_18309":45682,"_5":12556,"_24913":45479,"_2529":45683},[],"`config.call_timeout`",{"_3023":906,"_26291":826,"_18309":45685,"_5":12556,"_24913":45479,"_2529":45686},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3023":907,"_26291":826,"_18309":45688,"_5":12556,"_24913":45479,"_2529":45689},[],"Rules for that configuration:",{"_3023":908,"_26291":826,"_18309":45691,"_5":12556,"_24913":45479,"_2529":45692},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3023":909,"_26291":826,"_18309":45694,"_5":12556,"_24913":45479,"_2529":45695},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3023":910,"_26291":826,"_18309":45697,"_5":12556,"_24913":45479,"_2529":45698},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3023":911,"_26291":826,"_18309":45700,"_5":12556,"_24913":45479,"_2529":45701},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3023":912,"_26291":826,"_18309":45703,"_5":12556,"_24913":45479,"_2529":45704},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3023":913,"_26291":826,"_18309":45706,"_5":12556,"_24913":45479,"_2529":45707},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3023":914,"_26291":826,"_18309":45709,"_5":12556,"_24913":45479,"_2529":45710},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing, and if your version's console does not expose independent settings, use the DMS API.",{"_3023":915,"_26291":826,"_18309":45712,"_5":12556,"_24913":45479,"_2529":45713},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3023":916,"_26291":826,"_18309":45715,"_5":12556,"_24913":45479,"_2529":45716},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3023":917,"_26291":826,"_18309":45718,"_5":12556,"_24913":45483,"_2529":45719},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3023":918,"_26291":826,"_18309":45721,"_5":12556,"_24913":45487,"_2529":45722},[],"`settings.reenrollment_settings` field",{"_3023":919,"_26291":826,"_18309":45724,"_5":12556,"_24913":45487,"_2529":43238},[],{"_3023":920,"_26291":826,"_18309":45726,"_5":12556,"_24913":45487,"_2529":45727},[],"`reenrollment_delta`",{"_3023":921,"_26291":826,"_18309":45729,"_5":12556,"_24913":45487,"_2529":45730},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3023":922,"_26291":826,"_18309":45732,"_5":12556,"_24913":45487,"_2529":45733},[],"`preventive_delta`",{"_3023":923,"_26291":826,"_18309":45735,"_5":12556,"_24913":45487,"_2529":45736},[],"Preventive operational monitoring threshold.",{"_3023":924,"_26291":826,"_18309":45738,"_5":12556,"_24913":45487,"_2529":45739},[],"`critical_delta`",{"_3023":925,"_26291":826,"_18309":45741,"_5":12556,"_24913":45487,"_2529":45742},[],"Critical operational monitoring threshold.",{"_3023":926,"_26291":826,"_18309":45744,"_5":12556,"_24913":45487,"_2529":45745},[],"`enable_expired_renewal`",{"_3023":927,"_26291":826,"_18309":45747,"_5":12556,"_24913":45487,"_2529":45748},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3023":928,"_26291":826,"_18309":45750,"_5":12556,"_24913":45487,"_2529":45751},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3023":929,"_26291":826,"_18309":45753,"_5":12556,"_24913":45487,"_2529":45754},[],"Additional validation CAs for the renewal mTLS credential, tried after the enrollment CA; typically populated during CA rotation while old-CA cohorts renew.",{"_3023":930,"_26291":826,"_18309":45756,"_5":12556,"_24913":45487,"_2529":45757},[],"`revoke_on_reenrollment`",{"_3023":931,"_26291":826,"_18309":45759,"_5":12556,"_24913":45487,"_2529":45760},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3023":932,"_26291":826,"_18309":45762,"_5":12556,"_24913":45487,"_2529":45763},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3023":933,"_26291":826,"_18309":45765,"_5":12556,"_24913":45491,"_2529":45766},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. Algorithm and size come from its `key` field; the profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3023":934,"_26291":826,"_18309":45768,"_5":12556,"_24913":45495,"_2529":43232},[],{"_3023":935,"_26291":826,"_18309":45770,"_5":12556,"_24913":45495,"_2529":45771},[],"Published material",{"_3023":936,"_26291":826,"_18309":45773,"_5":12556,"_24913":45495,"_2529":45774},[],"**Include Lamassu System CA**",{"_3023":937,"_26291":826,"_18309":45776,"_5":12556,"_24913":45495,"_2529":45777},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3023":938,"_26291":826,"_18309":45779,"_5":12556,"_24913":45495,"_2529":45780},[],"**Include Enrollment CA**",{"_3023":939,"_26291":826,"_18309":45782,"_5":12556,"_24913":45495,"_2529":45783},[],"Selected issuing CA certificate.",{"_3023":940,"_26291":826,"_18309":45785,"_5":12556,"_24913":45495,"_2529":45786},[],"**Managed CAs**",{"_3023":941,"_26291":826,"_18309":45788,"_5":12556,"_24913":45495,"_2529":45789},[],"Explicitly selected CA certificates.",{"_3023":942,"_26291":826,"_18309":45791,"_5":12556,"_24913":45495,"_2529":45792},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3023":943,"_26291":826,"_18309":45794,"_5":12556,"_24913":45499,"_2529":45795},[],"**Edit** changes name, settings and metadata. Backend updates replace these complete blocks; read the DMS before sending API edits to avoid losing fields.",{"_3023":944,"_26291":826,"_18309":45797,"_5":12556,"_24913":45499,"_2529":45798},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3023":945,"_26291":826,"_18309":45800,"_5":12556,"_24913":45499,"_2529":45801},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3023":946,"_26291":826,"_18309":45803,"_5":12556,"_24913":45503,"_2529":45804},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3023":947,"_26291":947,"_5":12871,"_2529":45806,"_26635":45807,"_18309":45808,"_24913":947},"Integrate the EST client",[42855,44199,45173,45171,45354],[],{"_3023":948,"_26291":947,"_18309":45810,"_5":12556,"_24913":947,"_2529":45811},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3023":949,"_26291":947,"_5":26632,"_18309":45813,"_24913":45814,"_2529":42865},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3023":950,"_26291":947,"_5":26632,"_18309":45816,"_24913":45817,"_2529":45818},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3023":951,"_26291":947,"_5":26632,"_18309":45820,"_24913":45821,"_2529":45822},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3023":952,"_26291":947,"_5":26632,"_18309":45824,"_24913":45825,"_2529":45826},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3023":953,"_26291":947,"_5":26632,"_18309":45828,"_24913":45829,"_2529":45830},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3023":954,"_26291":947,"_5":26632,"_18309":45832,"_24913":45833,"_2529":45834},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3023":955,"_26291":947,"_18309":45836,"_5":12556,"_24913":947,"_2529":45837},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3023":956,"_26291":947,"_18309":45839,"_5":12556,"_24913":45814,"_2529":45840},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3023":957,"_26291":947,"_18309":45842,"_5":12556,"_24913":45814,"_2529":45843},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3023":958,"_26291":947,"_18309":45845,"_5":12556,"_24913":45814,"_2529":45846},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3023":959,"_26291":947,"_18309":45848,"_5":12556,"_24913":45817,"_2529":45849},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3023":960,"_26291":947,"_18309":45851,"_5":12556,"_24913":45817,"_2529":45852},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3023":961,"_26291":947,"_18309":45854,"_5":12556,"_24913":45821,"_2529":45855},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3023":962,"_26291":947,"_18309":45857,"_5":12556,"_24913":45821,"_2529":45858},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3023":963,"_26291":947,"_18309":45860,"_5":12556,"_24913":45825,"_2529":45861},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3023":964,"_26291":947,"_18309":45863,"_5":12556,"_24913":45825,"_2529":45864},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3023":965,"_26291":947,"_18309":45866,"_5":12556,"_24913":45829,"_2529":45867},[],"For a root that issues directly:",{"_3023":966,"_26291":947,"_18309":45869,"_5":12556,"_24913":45829,"_2529":45870},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3023":967,"_26291":947,"_18309":45872,"_5":12556,"_24913":45829,"_2529":45873},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3023":968,"_26291":947,"_18309":45875,"_5":12556,"_24913":45833,"_2529":45876},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3023":969,"_26291":969,"_5":12871,"_2529":45878,"_26635":45879,"_18309":45880,"_24913":969},"EST reference",[42855,44199,45173,45171,45354],[],{"_3023":970,"_26291":969,"_18309":45882,"_5":12556,"_24913":969,"_2529":45883},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3023":971,"_26291":969,"_5":26632,"_18309":45885,"_24913":45886,"_2529":45887},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3023":972,"_26291":969,"_5":26632,"_18309":45889,"_24913":45890,"_2529":19908},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3023":973,"_26291":969,"_5":26632,"_18309":45892,"_24913":45893,"_2529":22817},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3023":974,"_26291":969,"_5":26632,"_18309":45895,"_24913":45896,"_2529":22824},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3023":975,"_26291":969,"_5":26632,"_18309":45898,"_24913":45899,"_2529":22178},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3023":976,"_26291":969,"_5":26632,"_18309":45901,"_24913":45902,"_2529":45903},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3023":977,"_26291":969,"_5":26632,"_18309":45905,"_24913":45906,"_2529":45907},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3023":978,"_26291":969,"_5":26632,"_18309":45909,"_24913":45910,"_2529":45911},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3023":979,"_26291":969,"_18309":45913,"_5":12556,"_24913":969,"_2529":45914},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3023":980,"_26291":969,"_18309":45916,"_5":12556,"_24913":45886,"_2529":45917},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3023":981,"_26291":969,"_18309":45919,"_5":12556,"_24913":45886,"_2529":45920},[],"Operation",{"_3023":982,"_26291":969,"_18309":45922,"_5":12556,"_24913":45886,"_2529":45923},[],"Method",{"_3023":983,"_26291":969,"_18309":45925,"_5":12556,"_24913":45886,"_2529":45926},[],"Authentication and condition",{"_3023":984,"_26291":969,"_18309":45928,"_5":12556,"_24913":45886,"_2529":45929},[],"`/cacerts`",{"_3023":985,"_26291":969,"_18309":45931,"_5":12556,"_24913":45886,"_2529":45932},[],"GET",{"_3023":986,"_26291":969,"_18309":45934,"_5":12556,"_24913":45886,"_2529":45935},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3023":987,"_26291":969,"_18309":45937,"_5":12556,"_24913":45886,"_2529":45938},[],"`/simpleenroll`",{"_3023":988,"_26291":969,"_18309":45940,"_5":12556,"_24913":45886,"_2529":45941},[],"POST",{"_3023":989,"_26291":969,"_18309":45943,"_5":12556,"_24913":45886,"_2529":45944},[],"Initial authentication and DMS registration/replacement policy.",{"_3023":990,"_26291":969,"_18309":45946,"_5":12556,"_24913":45886,"_2529":45947},[],"`/simplereenroll`",{"_3023":991,"_26291":969,"_18309":45949,"_5":12556,"_24913":45886,"_2529":45941},[],{"_3023":992,"_26291":969,"_18309":45951,"_5":12556,"_24913":45886,"_2529":45952},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3023":993,"_26291":969,"_18309":45954,"_5":12556,"_24913":45886,"_2529":45955},[],"`/serverkeygen`",{"_3023":994,"_26291":969,"_18309":45957,"_5":12556,"_24913":45886,"_2529":45941},[],{"_3023":995,"_26291":969,"_18309":45959,"_5":12556,"_24913":45886,"_2529":45960},[],"Initial authentication and admission; server generation enabled.",{"_3023":996,"_26291":969,"_18309":45962,"_5":12556,"_24913":45886,"_2529":45963},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3023":997,"_26291":969,"_18309":45965,"_5":12556,"_24913":45890,"_2529":45966},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3023":998,"_26291":969,"_18309":45968,"_5":12556,"_24913":45890,"_2529":45969},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3023":999,"_26291":969,"_18309":45971,"_5":12556,"_24913":45893,"_2529":45972},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3023":1000,"_26291":969,"_18309":45974,"_5":12556,"_24913":45893,"_2529":45975},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3023":1001,"_26291":969,"_18309":45977,"_5":12556,"_24913":45896,"_2529":45978},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3023":1002,"_26291":969,"_18309":45980,"_5":12556,"_24913":45896,"_2529":45981},[],"The enrollment CA or a validation CA configured in the re-enrollment block validates the credential in mTLS mode. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3023":1003,"_26291":969,"_18309":45983,"_5":12556,"_24913":45899,"_2529":45984},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3023":1004,"_26291":969,"_18309":45986,"_5":12556,"_24913":45899,"_2529":45987},[],"The code supports RSA and ECDSA with 224, 256, 384 or 521 bits. An unrecognized ECDSA size can fall back to 256; explicitly select a compatible size and check the resulting key. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3023":1005,"_26291":969,"_18309":45989,"_5":12556,"_24913":45902,"_2529":45990},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3023":1006,"_26291":969,"_18309":45992,"_5":12556,"_24913":45902,"_2529":45993},[],"Part",{"_3023":1007,"_26291":969,"_18309":45995,"_5":12556,"_24913":45902,"_2529":45996},[],"Content after decoding its Base64",{"_3023":1008,"_26291":969,"_18309":45998,"_5":12556,"_24913":45902,"_2529":45999},[],"`application/pkcs8`",{"_3023":1009,"_26291":969,"_18309":46001,"_5":12556,"_24913":45902,"_2529":46002},[],"Unencrypted DER PKCS#8 private key.",{"_3023":1010,"_26291":969,"_18309":46004,"_5":12556,"_24913":45902,"_2529":46005},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3023":1011,"_26291":969,"_18309":46007,"_5":12556,"_24913":45902,"_2529":46008},[],"DER PKCS#7 containing the issued certificate.",{"_3023":1012,"_26291":969,"_18309":46010,"_5":12556,"_24913":45902,"_2529":46011},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3023":1013,"_26291":969,"_18309":46013,"_5":12556,"_24913":45906,"_2529":46014},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3023":1014,"_26291":969,"_18309":46016,"_5":12556,"_24913":45906,"_2529":46017},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3023":1015,"_26291":969,"_18309":46019,"_5":12556,"_24913":45906,"_2529":46020},[],"Convert and check the result:",{"_3023":1016,"_26291":969,"_18309":46022,"_5":12556,"_24913":45906,"_2529":46023},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3023":1017,"_26291":969,"_18309":46025,"_5":12556,"_24913":45910,"_2529":46026},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3023":1018,"_26291":969,"_18309":46028,"_5":12556,"_24913":45910,"_2529":46029},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3023":1019,"_26291":1019,"_5":12871,"_2529":45354,"_26635":46031,"_18309":46032,"_24913":1019},[42855,44199,45173,45171,45354],[],{"_3023":1020,"_26291":1019,"_18309":46034,"_5":12556,"_24913":1019,"_2529":46035},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3023":1021,"_26291":1019,"_5":26632,"_18309":46037,"_24913":46038,"_2529":46039},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3023":1022,"_26291":1019,"_5":26632,"_18309":46041,"_24913":46042,"_2529":46043},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3023":1023,"_26291":1019,"_5":26632,"_18309":46045,"_24913":46046,"_2529":46047},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3023":1024,"_26291":1019,"_5":26632,"_18309":46049,"_24913":46050,"_2529":46051},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3023":1025,"_26291":1019,"_18309":46053,"_5":12556,"_24913":1019,"_2529":46054},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3023":1026,"_26291":1019,"_18309":46056,"_5":12556,"_24913":46038,"_2529":46057},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3023":1027,"_26291":1019,"_18309":46059,"_5":12556,"_24913":46038,"_2529":46060},[],"The integrator installs initial EST server trust and an admission credential.",{"_3023":1028,"_26291":1019,"_18309":46062,"_5":12556,"_24913":46038,"_2529":46063},[],"The client requests an identity for its `Device ID` through EST.",{"_3023":1029,"_26291":1019,"_18309":46065,"_5":12556,"_24913":46038,"_2529":46066},[],"Certificate, device binding and key/certificate installation are checked.",{"_3023":1030,"_26291":1019,"_18309":46068,"_5":12556,"_24913":46038,"_2529":46069},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3023":1031,"_26291":1019,"_18309":46071,"_5":12556,"_24913":46038,"_2529":46072},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3023":1032,"_26291":1019,"_18309":46074,"_5":12556,"_24913":46042,"_2529":46075},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3023":1033,"_26291":1019,"_18309":46077,"_5":12556,"_24913":46042,"_2529":46078},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3023":1034,"_26291":1019,"_18309":46080,"_5":12556,"_24913":46042,"_2529":46081},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3023":1035,"_26291":1019,"_18309":46083,"_5":12556,"_24913":46042,"_2529":46084},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3023":1036,"_26291":1019,"_18309":46086,"_5":12556,"_24913":46046,"_2529":46087},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3023":1037,"_26291":1019,"_18309":46089,"_5":12556,"_24913":46046,"_2529":46090},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3023":1038,"_26291":1019,"_18309":46092,"_5":12556,"_24913":46046,"_2529":46093},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3023":1039,"_26291":1019,"_18309":46095,"_5":12556,"_24913":46046,"_2529":46096},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3023":1040,"_26291":1019,"_18309":46098,"_5":12556,"_24913":46050,"_2529":46099},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3023":1041,"_26291":1019,"_18309":46101,"_5":12556,"_24913":46050,"_2529":46102},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3023":1042,"_26291":1042,"_5":12871,"_2529":46104,"_26635":46105,"_18309":46106,"_24913":1042},"Provisioning strategies",[42855,44199,45173,45171,45354],[],{"_3023":1043,"_26291":1042,"_18309":46108,"_5":12556,"_24913":1042,"_2529":46109},[],"Choose device registration, identity authorization and key generation.",{"_3023":1044,"_26291":1042,"_5":26632,"_18309":46111,"_24913":46112,"_2529":46113},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3023":1045,"_26291":1042,"_5":26632,"_18309":46115,"_24913":46116,"_2529":46117},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3023":1046,"_26291":1042,"_5":26632,"_18309":46119,"_24913":46120,"_2529":46121},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3023":1047,"_26291":1042,"_5":26632,"_18309":46123,"_24913":46124,"_2529":46125},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3023":1048,"_26291":1042,"_5":26632,"_18309":46127,"_24913":46128,"_2529":46129},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3023":1049,"_26291":1042,"_18309":46131,"_5":12556,"_24913":1042,"_2529":46132},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3023":1050,"_26291":1042,"_18309":46134,"_5":12556,"_24913":46112,"_2529":46135},[],"Path",{"_3023":1051,"_26291":1042,"_18309":46137,"_5":12556,"_24913":46112,"_2529":46138},[],"When the device exists",{"_3023":1052,"_26291":1042,"_18309":46140,"_5":12556,"_24913":46112,"_2529":46141},[],"What to check",{"_3023":1053,"_26291":1042,"_18309":46143,"_5":12556,"_24913":46112,"_2529":46144},[],"Manual assignment",{"_3023":1054,"_26291":1042,"_18309":46146,"_5":12556,"_24913":46112,"_2529":46147},[],"An operator creates it before associating a certificate.",{"_3023":1055,"_26291":1042,"_18309":46149,"_5":12556,"_24913":46112,"_2529":46150},[],"ID, owning DMS, certificate CN and bound serial.",{"_3023":1056,"_26291":1042,"_18309":46152,"_5":12556,"_24913":46112,"_2529":46153},[],"EST with `JITP`",{"_3023":1057,"_26291":1042,"_18309":46155,"_5":12556,"_24913":46112,"_2529":46156},[],"Created for an unknown CN during `/simpleenroll`.",{"_3023":1058,"_26291":1042,"_18309":46158,"_5":12556,"_24913":46112,"_2529":46159},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3023":1059,"_26291":1042,"_18309":46161,"_5":12556,"_24913":46112,"_2529":46162},[],"EST with `PRE_REGISTRATION`",{"_3023":1060,"_26291":1042,"_18309":46164,"_5":12556,"_24913":46112,"_2529":46165},[],"Must exist before `/simpleenroll`.",{"_3023":1061,"_26291":1042,"_18309":46167,"_5":12556,"_24913":46112,"_2529":46168},[],"Approved record, same DMS and replacement conditions for your version.",{"_3023":1062,"_26291":1042,"_18309":46170,"_5":12556,"_24913":46112,"_2529":46171},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3023":1063,"_26291":1042,"_18309":46173,"_5":12556,"_24913":46112,"_2529":46174},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3023":1064,"_26291":1042,"_18309":46176,"_5":12556,"_24913":46116,"_2529":46177},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3023":1065,"_26291":1042,"_18309":46179,"_5":12556,"_24913":46116,"_2529":46180},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3023":1066,"_26291":1042,"_18309":46182,"_5":12556,"_24913":46116,"_2529":46183},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3023":1067,"_26291":1042,"_18309":46185,"_5":12556,"_24913":46120,"_2529":46186},[],"Decide initial enrollment and re-enrollment separately:",{"_3023":1068,"_26291":1042,"_18309":46188,"_5":12556,"_24913":46120,"_2529":46189},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3023":1069,"_26291":1042,"_18309":46191,"_5":12556,"_24913":46120,"_2529":46192},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3023":1070,"_26291":1042,"_18309":46194,"_5":12556,"_24913":46120,"_2529":46195},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3023":1071,"_26291":1042,"_18309":46197,"_5":12556,"_24913":46120,"_2529":46198},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3023":1072,"_26291":1042,"_18309":46200,"_5":12556,"_24913":46120,"_2529":46201},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3023":1073,"_26291":1042,"_18309":46203,"_5":12556,"_24913":46124,"_2529":43232},[],{"_3023":1074,"_26291":1042,"_18309":46205,"_5":12556,"_24913":46124,"_2529":46206},[],"Material crossing EST",{"_3023":1075,"_26291":1042,"_18309":46208,"_5":12556,"_24913":46124,"_2529":46209},[],"Device-generated key",{"_3023":1076,"_26291":1042,"_18309":46211,"_5":12556,"_24913":46124,"_2529":46212},[],"Public CSR and certificate; the key stays on the client.",{"_3023":1077,"_26291":1042,"_18309":46214,"_5":12556,"_24913":46124,"_2529":46215},[],"Existing device key",{"_3023":1078,"_26291":1042,"_18309":46217,"_5":12556,"_24913":46124,"_2529":46218},[],"CSR signed with that key and a new certificate.",{"_3023":1079,"_26291":1042,"_18309":46220,"_5":12556,"_24913":46124,"_2529":45492},[],{"_3023":1080,"_26291":1042,"_18309":46222,"_5":12556,"_24913":46124,"_2529":46223},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3023":1081,"_26291":1042,"_18309":46225,"_5":12556,"_24913":46124,"_2529":46226},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3023":1082,"_26291":1042,"_18309":46228,"_5":12556,"_24913":46128,"_2529":46229},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3023":1083,"_26291":1083,"_5":12871,"_2529":46231,"_26635":46232,"_18309":46233,"_24913":1083},"Renewal and recovery",[42855,44199,45173,45171,45354],[],{"_3023":1084,"_26291":1083,"_18309":46235,"_5":12556,"_24913":1083,"_2529":46236},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3023":1085,"_26291":1083,"_5":26632,"_18309":46238,"_24913":46239,"_2529":46240},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3023":1086,"_26291":1083,"_5":26632,"_18309":46242,"_24913":46243,"_2529":46244},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3023":1087,"_26291":1083,"_5":26632,"_18309":46246,"_24913":46247,"_2529":46248},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3023":1088,"_26291":1083,"_5":26632,"_18309":46250,"_24913":46251,"_2529":46252},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3023":1089,"_26291":1083,"_5":26632,"_18309":46254,"_24913":46255,"_2529":46256},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3023":1090,"_26291":1083,"_18309":46258,"_5":12556,"_24913":1083,"_2529":46259},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3023":1091,"_26291":1083,"_18309":46261,"_5":12556,"_24913":46239,"_2529":46262},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3023":1092,"_26291":1083,"_18309":46264,"_5":12556,"_24913":46239,"_2529":46265},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3023":1093,"_26291":1083,"_18309":46267,"_5":12556,"_24913":46239,"_2529":46268},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3023":1094,"_26291":1083,"_18309":46270,"_5":12556,"_24913":46239,"_2529":46271},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3023":1095,"_26291":1083,"_18309":46273,"_5":12556,"_24913":46243,"_2529":46274},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3023":1096,"_26291":1083,"_18309":46276,"_5":12556,"_24913":46243,"_2529":46277},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3023":1097,"_26291":1083,"_18309":46279,"_5":12556,"_24913":46247,"_2529":46280},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3023":1098,"_26291":1083,"_18309":46282,"_5":12556,"_24913":46247,"_2529":46283},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3023":1099,"_26291":1083,"_18309":46285,"_5":12556,"_24913":46247,"_2529":46286},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3023":1100,"_26291":1083,"_18309":46288,"_5":12556,"_24913":46251,"_2529":46289},[],"Situation",{"_3023":1101,"_26291":1083,"_18309":46291,"_5":12556,"_24913":46251,"_2529":46292},[],"Procedure",{"_3023":1102,"_26291":1083,"_18309":46294,"_5":12556,"_24913":46251,"_2529":46295},[],"Valid certificate, outside the window",{"_3023":1103,"_26291":1083,"_18309":46297,"_5":12556,"_24913":46251,"_2529":46298},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3023":1104,"_26291":1083,"_18309":46300,"_5":12556,"_24913":46251,"_2529":46301},[],"Expired certificate, key available",{"_3023":1105,"_26291":1083,"_18309":46303,"_5":12556,"_24913":46251,"_2529":46304},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3023":1106,"_26291":1083,"_18309":46306,"_5":12556,"_24913":46251,"_2529":46307},[],"Renewal through webhook or `NO_AUTH`",{"_3023":1107,"_26291":1083,"_18309":46309,"_5":12556,"_24913":46251,"_2529":46310},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3023":1108,"_26291":1083,"_18309":46312,"_5":12556,"_24913":46251,"_2529":46313},[],"Lost or inaccessible key",{"_3023":1109,"_26291":1083,"_18309":46315,"_5":12556,"_24913":46251,"_2529":46316},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3023":1110,"_26291":1083,"_18309":46318,"_5":12556,"_24913":46251,"_2529":46319},[],"Current identity revoked",{"_3023":1111,"_26291":1083,"_18309":46321,"_5":12556,"_24913":46251,"_2529":46322},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3023":1112,"_26291":1083,"_18309":46324,"_5":12556,"_24913":46251,"_2529":46325},[],"Device without an identity",{"_3023":1113,"_26291":1083,"_18309":46327,"_5":12556,"_24913":46251,"_2529":46328},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3023":1114,"_26291":1083,"_18309":46330,"_5":12556,"_24913":46251,"_2529":46331},[],"Retired device",{"_3023":1115,"_26291":1083,"_18309":46333,"_5":12556,"_24913":46251,"_2529":46334},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3023":1116,"_26291":1083,"_18309":46336,"_5":12556,"_24913":46251,"_2529":46337},[],"Timeout, HTTP 500 or installation failure",{"_3023":1117,"_26291":1083,"_18309":46339,"_5":12556,"_24913":46251,"_2529":46340},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3023":1118,"_26291":1083,"_18309":46342,"_5":12556,"_24913":46255,"_2529":46343},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3023":1119,"_26291":1083,"_18309":46345,"_5":12556,"_24913":46255,"_2529":46346},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3023":1120,"_26291":1120,"_5":12871,"_2529":46348,"_26635":46349,"_18309":46350,"_24913":1120},"Enrollment troubleshooting",[42855,44199,45173,45171,45354],[],{"_3023":1121,"_26291":1120,"_18309":46352,"_5":12556,"_24913":1120,"_2529":46353},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3023":1122,"_26291":1120,"_5":26632,"_18309":46355,"_24913":46356,"_2529":46357},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3023":1123,"_26291":1120,"_5":26632,"_18309":46359,"_24913":46360,"_2529":46361},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3023":1124,"_26291":1120,"_5":26632,"_18309":46363,"_24913":46364,"_2529":45911},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3023":1125,"_26291":1120,"_5":26632,"_18309":46366,"_24913":46367,"_2529":46368},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3023":1126,"_26291":1120,"_18309":46370,"_5":12556,"_24913":1120,"_2529":46371},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3023":1127,"_26291":1120,"_18309":46373,"_5":12556,"_24913":46360,"_2529":46374},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3023":1128,"_26291":1120,"_18309":46376,"_5":12556,"_24913":46360,"_2529":46377},[],"Symptom or message",{"_3023":1129,"_26291":1120,"_18309":46379,"_5":12556,"_24913":46360,"_2529":46141},[],{"_3023":1130,"_26291":1120,"_18309":46381,"_5":12556,"_24913":46360,"_2529":46382},[],"curl rejects TLS, name or issuer",{"_3023":1131,"_26291":1120,"_18309":46384,"_5":12556,"_24913":46360,"_2529":46385},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3023":1132,"_26291":1120,"_18309":46387,"_5":12556,"_24913":46360,"_2529":46388},[],"404 or missing APS",{"_3023":1133,"_26291":1120,"_18309":46390,"_5":12556,"_24913":46360,"_2529":46391},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3023":1134,"_26291":1120,"_18309":46393,"_5":12556,"_24913":46360,"_2529":46394},[],"400, CSR or format error",{"_3023":1135,"_26291":1120,"_18309":46396,"_5":12556,"_24913":46360,"_2529":46397},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3023":1136,"_26291":1120,"_18309":46399,"_5":12556,"_24913":46360,"_2529":46400},[],"Missing credential or invalid certificate",{"_3023":1137,"_26291":1120,"_18309":46402,"_5":12556,"_24913":46360,"_2529":46403},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3023":1138,"_26291":1120,"_18309":46405,"_5":12556,"_24913":46360,"_2529":46406},[],"Webhook denies, times out or responds without authorization",{"_3023":1139,"_26291":1120,"_18309":46408,"_5":12556,"_24913":46360,"_2529":46409},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3023":1140,"_26291":1120,"_18309":46411,"_5":12556,"_24913":46360,"_2529":46412},[],"`unexpected status code: <n>: redirects are not followed`",{"_3023":1141,"_26291":1120,"_18309":46414,"_5":12556,"_24913":46360,"_2529":46415},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3023":1142,"_26291":1120,"_18309":46417,"_5":12556,"_24913":46360,"_2529":46418},[],"`webhook response exceeds 1048576 bytes`",{"_3023":1143,"_26291":1120,"_18309":46420,"_5":12556,"_24913":46360,"_2529":46421},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3023":1144,"_26291":1120,"_18309":46423,"_5":12556,"_24913":46360,"_2529":46424},[],"`webhook config must not reference files`",{"_3023":1145,"_26291":1120,"_18309":46426,"_5":12556,"_24913":46360,"_2529":46427},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3023":1146,"_26291":1120,"_18309":46429,"_5":12556,"_24913":46360,"_2529":46430},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3023":1147,"_26291":1120,"_18309":46432,"_5":12556,"_24913":46360,"_2529":46433},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3023":1148,"_26291":1120,"_18309":46435,"_5":12556,"_24913":46360,"_2529":46436},[],"`webhook mTLS certificate and key are invalid: …`",{"_3023":1149,"_26291":1120,"_18309":46438,"_5":12556,"_24913":46360,"_2529":46439},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3023":1150,"_26291":1120,"_18309":46441,"_5":12556,"_24913":46360,"_2529":46442},[],"400 `struct validation error` creating or updating a DMS",{"_3023":1151,"_26291":1120,"_18309":46444,"_5":12556,"_24913":46360,"_2529":46445},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3023":1152,"_26291":1120,"_18309":46447,"_5":12556,"_24913":46360,"_2529":46448},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3023":1153,"_26291":1120,"_18309":46450,"_5":12556,"_24913":46360,"_2529":46451},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3023":1154,"_26291":1120,"_18309":46453,"_5":12556,"_24913":46360,"_2529":46454},[],"`device not preregistered`",{"_3023":1155,"_26291":1120,"_18309":46456,"_5":12556,"_24913":46360,"_2529":46457},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3023":1156,"_26291":1120,"_18309":46459,"_5":12556,"_24913":46360,"_2529":46460},[],"`forbiddenNewEnrollment`",{"_3023":1157,"_26291":1120,"_18309":46462,"_5":12556,"_24913":46360,"_2529":46463},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3023":1158,"_26291":1120,"_18309":46465,"_5":12556,"_24913":46360,"_2529":46466},[],"Different owning DMS",{"_3023":1159,"_26291":1120,"_18309":46468,"_5":12556,"_24913":46360,"_2529":46469},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3023":1160,"_26291":1120,"_18309":46471,"_5":12556,"_24913":46360,"_2529":46472},[],"`invalid RawSubject bytes`",{"_3023":1161,"_26291":1120,"_18309":46474,"_5":12556,"_24913":46360,"_2529":46475},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3023":1162,"_26291":1120,"_18309":46477,"_5":12556,"_24913":46360,"_2529":46478},[],"`invalid reenroll window`",{"_3023":1163,"_26291":1120,"_18309":46480,"_5":12556,"_24913":46360,"_2529":46481},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3023":1164,"_26291":1120,"_18309":46483,"_5":12556,"_24913":46360,"_2529":46484},[],"Current certificate revoked",{"_3023":1165,"_26291":1120,"_18309":46486,"_5":12556,"_24913":46360,"_2529":46487},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3023":1166,"_26291":1120,"_18309":46489,"_5":12556,"_24913":46360,"_2529":46490},[],"CA, profile or signing error",{"_3023":1167,"_26291":1120,"_18309":46492,"_5":12556,"_24913":46360,"_2529":46493},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3023":1168,"_26291":1120,"_18309":46495,"_5":12556,"_24913":46360,"_2529":46496},[],"HTTP 200 without a device connection",{"_3023":1169,"_26291":1120,"_18309":46498,"_5":12556,"_24913":46360,"_2529":46499},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3023":1170,"_26291":1120,"_18309":46501,"_5":12556,"_24913":46360,"_2529":46502},[],"Timeout or error after issuance",{"_3023":1171,"_26291":1120,"_18309":46504,"_5":12556,"_24913":46360,"_2529":46505},[],"New certificates, current slot and previous identity's state before retrying.",{"_3023":1172,"_26291":1120,"_18309":46507,"_5":12556,"_24913":46364,"_2529":46508},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3023":1173,"_26291":1120,"_18309":46510,"_5":12556,"_24913":46364,"_2529":46511},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3023":1174,"_26291":1120,"_18309":46513,"_5":12556,"_24913":46367,"_2529":46514},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3023":1175,"_26291":1120,"_18309":46516,"_5":12556,"_24913":46367,"_2529":46517},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3023":1176,"_26291":1120,"_18309":46519,"_5":12556,"_24913":46367,"_2529":46520},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3023":1177,"_26291":1120,"_18309":46522,"_5":12556,"_24913":46367,"_2529":46523},[],"Make one request, save headers/body and query the device and certificates.",{"_3023":1178,"_26291":1120,"_18309":46525,"_5":12556,"_24913":46367,"_2529":46526},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3023":1179,"_26291":1120,"_18309":46528,"_5":12556,"_24913":46367,"_2529":46529},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3023":1180,"_26291":1120,"_18309":46531,"_5":12556,"_24913":46367,"_2529":46532},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3023":1181,"_26291":1181,"_5":12871,"_2529":46534,"_26635":46535,"_18309":46536,"_24913":1181},"Trust distribution and updates",[42855,44199,45173,45171,45354],[],{"_3023":1182,"_26291":1181,"_18309":46538,"_5":12556,"_24913":1181,"_2529":46539},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3023":1183,"_26291":1181,"_5":26632,"_18309":46541,"_24913":46542,"_2529":46543},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3023":1184,"_26291":1181,"_5":26632,"_18309":46545,"_24913":46546,"_2529":46547},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3023":1185,"_26291":1181,"_5":26632,"_18309":46549,"_24913":46550,"_2529":46551},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3023":1186,"_26291":1181,"_5":26632,"_18309":46553,"_24913":46554,"_2529":46555},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3023":1187,"_26291":1181,"_5":26632,"_18309":46557,"_24913":46558,"_2529":46559},[],"/docs/pr-preview/pr-47/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3023":1188,"_26291":1181,"_18309":46561,"_5":12556,"_24913":1181,"_2529":46562},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3023":1189,"_26291":1181,"_18309":46564,"_5":12556,"_24913":46542,"_2529":46565},[],"Relationship",{"_3023":1190,"_26291":1181,"_18309":46567,"_5":12556,"_24913":46542,"_2529":46568},[],"Material prepared by its owner",{"_3023":1191,"_26291":1181,"_18309":46570,"_5":12556,"_24913":46542,"_2529":46571},[],"Device → EST server",{"_3023":1192,"_26291":1181,"_18309":46573,"_5":12556,"_24913":46542,"_2529":46574},[],"Previously verified server root, chain or pin and TLS name.",{"_3023":1193,"_26291":1181,"_18309":46576,"_5":12556,"_24913":46542,"_2529":46577},[],"DMS → requester",{"_3023":1194,"_26291":1181,"_18309":46579,"_5":12556,"_24913":46542,"_2529":46580},[],"CAs and rules authorizing initial or renewal credentials.",{"_3023":1195,"_26291":1181,"_18309":46582,"_5":12556,"_24913":46542,"_2529":46583},[],"Consumer → device",{"_3023":1196,"_26291":1181,"_18309":46585,"_5":12556,"_24913":46542,"_2529":46586},[],"Operational identity roots, intermediates, validation and permissions.",{"_3023":1197,"_26291":1181,"_18309":46588,"_5":12556,"_24913":46542,"_2529":46589},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3023":1198,"_26291":1181,"_18309":46591,"_5":12556,"_24913":46546,"_2529":46592},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3023":1199,"_26291":1181,"_18309":46594,"_5":12556,"_24913":46546,"_2529":46595},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3023":1200,"_26291":1181,"_18309":46597,"_5":12556,"_24913":46550,"_2529":46598},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3023":1201,"_26291":1181,"_18309":46600,"_5":12556,"_24913":46550,"_2529":46601},[],"Select policy-approved roots as anchors.",{"_3023":1202,"_26291":1181,"_18309":46603,"_5":12556,"_24913":46550,"_2529":46604},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3023":1203,"_26291":1181,"_18309":46606,"_5":12556,"_24913":46550,"_2529":46607},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3023":1204,"_26291":1181,"_18309":46609,"_5":12556,"_24913":46550,"_2529":46610},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3023":1205,"_26291":1181,"_18309":46612,"_5":12556,"_24913":46550,"_2529":46613},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3023":1206,"_26291":1181,"_18309":46615,"_5":12556,"_24913":46554,"_2529":46616},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3023":1207,"_26291":1181,"_18309":46618,"_5":12556,"_24913":46554,"_2529":46619},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. When switching the enrollment CA, add the previous issuance CA to that list so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3023":1208,"_26291":1181,"_18309":46621,"_5":12556,"_24913":46554,"_2529":46622},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3023":1209,"_26291":1181,"_18309":46624,"_5":12556,"_24913":46558,"_2529":46625},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3023":1210,"_26291":1210,"_5":12871,"_2529":46627,"_26635":46628,"_18309":46630,"_24913":1210},"AWS IoT Core",[42855,44199,45173,45171,46629],"Integrations",[],{"_3023":1211,"_26291":1210,"_18309":46632,"_5":12556,"_24913":1210,"_2529":46633},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3023":1212,"_26291":1210,"_5":26632,"_18309":46635,"_24913":46636,"_2529":46637},[],"/docs/pr-preview/pr-47/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3023":1213,"_26291":1210,"_5":26632,"_18309":46639,"_24913":46640,"_2529":46641},[],"/docs/pr-preview/pr-47/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3023":1214,"_26291":1210,"_5":26632,"_18309":46643,"_24913":46644,"_2529":46645},[],"/docs/pr-preview/pr-47/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3023":1215,"_26291":1210,"_5":26632,"_18309":46647,"_24913":46648,"_2529":46649},[],"/docs/pr-preview/pr-47/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3023":1216,"_26291":1210,"_5":26632,"_18309":46651,"_24913":46652,"_2529":46653},[],"/docs/pr-preview/pr-47/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3023":1217,"_26291":1210,"_5":26632,"_18309":46655,"_24913":46656,"_2529":46657},[],"/docs/pr-preview/pr-47/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3023":1218,"_26291":1210,"_5":26632,"_18309":46659,"_24913":46660,"_2529":46661},[],"/docs/pr-preview/pr-47/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3023":1219,"_26291":1210,"_5":26632,"_18309":46663,"_24913":46664,"_2529":46665},[],"/docs/pr-preview/pr-47/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3023":1220,"_26291":1210,"_5":26632,"_18309":46667,"_24913":46668,"_2529":46669},[],"/docs/pr-preview/pr-47/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3023":1221,"_26291":1210,"_5":26632,"_18309":46671,"_24913":46672,"_2529":46673},[],"/docs/pr-preview/pr-47/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3023":1222,"_26291":1210,"_5":26632,"_18309":46675,"_24913":46676,"_2529":46677},[],"/docs/pr-preview/pr-47/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3023":1223,"_26291":1210,"_5":26632,"_18309":46679,"_24913":46680,"_2529":46681},[],"/docs/pr-preview/pr-47/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3023":1224,"_26291":1210,"_5":26632,"_18309":46683,"_24913":46684,"_2529":46685},[],"/docs/pr-preview/pr-47/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3023":1225,"_26291":1210,"_5":26632,"_18309":46687,"_24913":46688,"_2529":46689},[],"/docs/pr-preview/pr-47/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3023":1226,"_26291":1210,"_5":26632,"_18309":46691,"_24913":46692,"_2529":46693},[],"/docs/pr-preview/pr-47/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3023":1227,"_26291":1210,"_5":26632,"_18309":46695,"_24913":46696,"_2529":46697},[],"/docs/pr-preview/pr-47/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3023":1228,"_26291":1210,"_5":26632,"_18309":46699,"_24913":46700,"_2529":46701},[],"/docs/pr-preview/pr-47/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3023":1229,"_26291":1210,"_5":26632,"_18309":46703,"_24913":46704,"_2529":46705},[],"/docs/pr-preview/pr-47/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3023":1230,"_26291":1210,"_5":26632,"_18309":46707,"_24913":46708,"_2529":46709},[],"/docs/pr-preview/pr-47/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3023":1231,"_26291":1210,"_5":26632,"_18309":46711,"_24913":46712,"_2529":46713},[],"/docs/pr-preview/pr-47/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3023":1232,"_26291":1210,"_18309":46715,"_5":12556,"_24913":1210,"_2529":46716},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3023":1233,"_26291":1210,"_18309":46718,"_5":12556,"_24913":1210,"_2529":46719},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3023":1234,"_26291":1210,"_18309":46721,"_5":12556,"_24913":1210,"_2529":46722},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3023":1235,"_26291":1210,"_18309":46724,"_5":12556,"_24913":46636,"_2529":46725},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3023":1236,"_26291":1210,"_18309":46727,"_5":12556,"_24913":46636,"_2529":46728},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3023":1237,"_26291":1210,"_18309":46730,"_5":12556,"_24913":46636,"_2529":46731},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3023":1238,"_26291":1210,"_18309":46733,"_5":12556,"_24913":46636,"_2529":46734},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3023":1239,"_26291":1210,"_18309":46736,"_5":12556,"_24913":46640,"_2529":46737},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3023":1240,"_26291":1210,"_18309":46739,"_5":12556,"_24913":46644,"_2529":46740},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3023":1241,"_26291":1210,"_18309":46742,"_5":12556,"_24913":46644,"_2529":46743},[],"IAM action",{"_3023":1242,"_26291":1210,"_18309":46745,"_5":12556,"_24913":46644,"_2529":43238},[],{"_3023":1243,"_26291":1210,"_18309":46747,"_5":12556,"_24913":46644,"_2529":46748},[],"`iot:GetRegistrationCode`",{"_3023":1244,"_26291":1210,"_18309":46750,"_5":12556,"_24913":46644,"_2529":46751},[],"Obtain the verification code for CA registration in the Primary Account",{"_3023":1245,"_26291":1210,"_18309":46753,"_5":12556,"_24913":46644,"_2529":46754},[],"`iot:RegisterCACertificate`",{"_3023":1246,"_26291":1210,"_18309":46756,"_5":12556,"_24913":46644,"_2529":46757},[],"Register the CA in AWS IoT",{"_3023":1247,"_26291":1210,"_18309":46759,"_5":12556,"_24913":46644,"_2529":46760},[],"`iot:DescribeCACertificate`",{"_3023":1248,"_26291":1210,"_18309":46762,"_5":12556,"_24913":46644,"_2529":46763},[],"Check the CA registration status",{"_3023":1249,"_26291":1210,"_18309":46765,"_5":12556,"_24913":46644,"_2529":46766},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3023":1250,"_26291":1210,"_18309":46768,"_5":12556,"_24913":46644,"_2529":46769},[],"Create or update Things in IoT Core",{"_3023":1251,"_26291":1210,"_18309":46771,"_5":12556,"_24913":46644,"_2529":46772},[],"`iot:RegisterThing`",{"_3023":1252,"_26291":1210,"_18309":46774,"_5":12556,"_24913":46644,"_2529":46775},[],"Provision Things through a template",{"_3023":1253,"_26291":1210,"_18309":46777,"_5":12556,"_24913":46644,"_2529":46778},[],"`iot:RegisterCertificate`",{"_3023":1254,"_26291":1210,"_18309":46780,"_5":12556,"_24913":46644,"_2529":46781},[],"Register device certificates",{"_3023":1255,"_26291":1210,"_18309":46783,"_5":12556,"_24913":46644,"_2529":46784},[],"`iot:UpdateCertificate`",{"_3023":1256,"_26291":1210,"_18309":46786,"_5":12556,"_24913":46644,"_2529":46787},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3023":1257,"_26291":1210,"_18309":46789,"_5":12556,"_24913":46644,"_2529":46790},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3023":1258,"_26291":1210,"_18309":46792,"_5":12556,"_24913":46644,"_2529":46793},[],"Create and attach IoT policies",{"_3023":1259,"_26291":1210,"_18309":46795,"_5":12556,"_24913":46644,"_2529":46796},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3023":1260,"_26291":1210,"_18309":46798,"_5":12556,"_24913":46644,"_2529":46799},[],"Manage Thing groups",{"_3023":1261,"_26291":1210,"_18309":46801,"_5":12556,"_24913":46644,"_2529":46802},[],"`iot:CreateProvisioningTemplate`",{"_3023":1262,"_26291":1210,"_18309":46804,"_5":12556,"_24913":46644,"_2529":46805},[],"Create JITP templates",{"_3023":1263,"_26291":1210,"_18309":46807,"_5":12556,"_24913":46644,"_2529":46808},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3023":1264,"_26291":1210,"_18309":46810,"_5":12556,"_24913":46644,"_2529":46811},[],"Read and write the Device Shadow",{"_3023":1265,"_26291":1210,"_18309":46813,"_5":12556,"_24913":46644,"_2529":46814},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3023":1266,"_26291":1210,"_18309":46816,"_5":12556,"_24913":46648,"_2529":46817},[],"Parameter",{"_3023":1267,"_26291":1210,"_18309":46819,"_5":12556,"_24913":46648,"_2529":46820},[],"Type",{"_3023":1268,"_26291":1210,"_18309":46822,"_5":12556,"_24913":46648,"_2529":46823},[],"Required",{"_3023":1269,"_26291":1210,"_18309":46825,"_5":12556,"_24913":46648,"_2529":46826},[],"Description",{"_3023":1270,"_26291":1210,"_18309":46828,"_5":12556,"_24913":46648,"_2529":46829},[],"`connector_id`",{"_3023":1271,"_26291":1210,"_18309":46831,"_5":12556,"_24913":46648,"_2529":21905},[],{"_3023":1272,"_26291":1210,"_18309":46833,"_5":12556,"_24913":46648,"_2529":46834},[],"Yes",{"_3023":1273,"_26291":1210,"_18309":46836,"_5":12556,"_24913":46648,"_2529":46837},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3023":1274,"_26291":1210,"_18309":46839,"_5":12556,"_24913":46648,"_2529":46840},[],"`aws_config.region`",{"_3023":1275,"_26291":1210,"_18309":46842,"_5":12556,"_24913":46648,"_2529":21905},[],{"_3023":1276,"_26291":1210,"_18309":46844,"_5":12556,"_24913":46648,"_2529":46834},[],{"_3023":1277,"_26291":1210,"_18309":46846,"_5":12556,"_24913":46648,"_2529":46847},[],"AWS region where the connector operates.",{"_3023":1278,"_26291":1210,"_18309":46849,"_5":12556,"_24913":46648,"_2529":46850},[],"`aws_config.auth_method`",{"_3023":1279,"_26291":1210,"_18309":46852,"_5":12556,"_24913":46648,"_2529":21905},[],{"_3023":1280,"_26291":1210,"_18309":46854,"_5":12556,"_24913":46648,"_2529":46834},[],{"_3023":1281,"_26291":1210,"_18309":46856,"_5":12556,"_24913":46648,"_2529":46857},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3023":1282,"_26291":1210,"_18309":46859,"_5":12556,"_24913":46648,"_2529":46860},[],"`aws_config.access_key_id`",{"_3023":1283,"_26291":1210,"_18309":46862,"_5":12556,"_24913":46648,"_2529":21905},[],{"_3023":1284,"_26291":1210,"_18309":46864,"_5":12556,"_24913":46648,"_2529":46865},[],"Only with `auth_method=static`",{"_3023":1285,"_26291":1210,"_18309":46867,"_5":12556,"_24913":46648,"_2529":46868},[],"AWS access key.",{"_3023":1286,"_26291":1210,"_18309":46870,"_5":12556,"_24913":46648,"_2529":46871},[],"`aws_config.secret_access_key`",{"_3023":1287,"_26291":1210,"_18309":46873,"_5":12556,"_24913":46648,"_2529":21905},[],{"_3023":1288,"_26291":1210,"_18309":46875,"_5":12556,"_24913":46648,"_2529":46865},[],{"_3023":1289,"_26291":1210,"_18309":46877,"_5":12556,"_24913":46648,"_2529":46878},[],"AWS secret key.",{"_3023":1290,"_26291":1210,"_18309":46880,"_5":12556,"_24913":46648,"_2529":46881},[],"`aws_config.session_token`",{"_3023":1291,"_26291":1210,"_18309":46883,"_5":12556,"_24913":46648,"_2529":21905},[],{"_3023":1292,"_26291":1210,"_18309":46885,"_5":12556,"_24913":46648,"_2529":46886},[],"No",{"_3023":1293,"_26291":1210,"_18309":46888,"_5":12556,"_24913":46648,"_2529":46889},[],"Session token (with `auth_method=static`).",{"_3023":1294,"_26291":1210,"_18309":46891,"_5":12556,"_24913":46648,"_2529":46892},[],"`aws_config.role_arn`",{"_3023":1295,"_26291":1210,"_18309":46894,"_5":12556,"_24913":46648,"_2529":21905},[],{"_3023":1296,"_26291":1210,"_18309":46896,"_5":12556,"_24913":46648,"_2529":46897},[],"Only with `auth_method=role`",{"_3023":1297,"_26291":1210,"_18309":46899,"_5":12556,"_24913":46648,"_2529":46900},[],"ARN of the role to assume.",{"_3023":1298,"_26291":1210,"_18309":46902,"_5":12556,"_24913":46648,"_2529":46903},[],"`aws_config.endpoint_url`",{"_3023":1299,"_26291":1210,"_18309":46905,"_5":12556,"_24913":46648,"_2529":21905},[],{"_3023":1300,"_26291":1210,"_18309":46907,"_5":12556,"_24913":46648,"_2529":46886},[],{"_3023":1301,"_26291":1210,"_18309":46909,"_5":12556,"_24913":46648,"_2529":46910},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3023":1302,"_26291":1210,"_18309":46912,"_5":12556,"_24913":46648,"_2529":46913},[],"`subscriber_event_bus`",{"_3023":1303,"_26291":1210,"_18309":46915,"_5":12556,"_24913":46648,"_2529":15359},[],{"_3023":1304,"_26291":1210,"_18309":46917,"_5":12556,"_24913":46648,"_2529":46834},[],{"_3023":1305,"_26291":1210,"_18309":46919,"_5":12556,"_24913":46648,"_2529":46920},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3023":1306,"_26291":1210,"_18309":46922,"_5":12556,"_24913":46648,"_2529":46923},[],"`dms_manager_client`",{"_3023":1307,"_26291":1210,"_18309":46925,"_5":12556,"_24913":46648,"_2529":21905},[],{"_3023":1308,"_26291":1210,"_18309":46927,"_5":12556,"_24913":46648,"_2529":46834},[],{"_3023":1309,"_26291":1210,"_18309":46929,"_5":12556,"_24913":46648,"_2529":46930},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3023":1310,"_26291":1210,"_18309":46932,"_5":12556,"_24913":46648,"_2529":46933},[],"`device_manager_client`",{"_3023":1311,"_26291":1210,"_18309":46935,"_5":12556,"_24913":46648,"_2529":21905},[],{"_3023":1312,"_26291":1210,"_18309":46937,"_5":12556,"_24913":46648,"_2529":46834},[],{"_3023":1313,"_26291":1210,"_18309":46939,"_5":12556,"_24913":46648,"_2529":46940},[],"HTTP URL of Lamassu's Device Manager.",{"_3023":1314,"_26291":1210,"_18309":46942,"_5":12556,"_24913":46648,"_2529":46943},[],"`ca_client`",{"_3023":1315,"_26291":1210,"_18309":46945,"_5":12556,"_24913":46648,"_2529":21905},[],{"_3023":1316,"_26291":1210,"_18309":46947,"_5":12556,"_24913":46648,"_2529":46834},[],{"_3023":1317,"_26291":1210,"_18309":46949,"_5":12556,"_24913":46648,"_2529":46950},[],"HTTP URL of Lamassu's CA service.",{"_3023":1318,"_26291":1210,"_18309":46952,"_5":12556,"_24913":46652,"_2529":46953},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3023":1319,"_26291":1210,"_18309":46955,"_5":12556,"_24913":46656,"_2529":46956},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3023":1320,"_26291":1210,"_18309":46958,"_5":12556,"_24913":46656,"_2529":46959},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3023":1321,"_26291":1210,"_18309":46961,"_5":12556,"_24913":46660,"_2529":46962},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3023":1322,"_26291":1210,"_18309":46964,"_5":12556,"_24913":46660,"_2529":46965},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3023":1323,"_26291":1210,"_18309":46967,"_5":12556,"_24913":46660,"_2529":46968},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3023":1324,"_26291":1210,"_18309":46970,"_5":12556,"_24913":46660,"_2529":46971},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3023":1325,"_26291":1210,"_18309":46973,"_5":12556,"_24913":46660,"_2529":46974},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3023":1326,"_26291":1210,"_18309":46976,"_5":12556,"_24913":46660,"_2529":46977},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3023":1327,"_26291":1210,"_18309":46979,"_5":12556,"_24913":46664,"_2529":46980},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3023":1328,"_26291":1210,"_18309":46982,"_5":12556,"_24913":46668,"_2529":46983},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3023":1329,"_26291":1210,"_18309":46985,"_5":12556,"_24913":46668,"_2529":46986},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3023":1330,"_26291":1210,"_18309":46988,"_5":12556,"_24913":46672,"_2529":46989},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3023":1331,"_26291":1210,"_18309":46991,"_5":12556,"_24913":46676,"_2529":46992},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3023":1332,"_26291":1210,"_18309":46994,"_5":12556,"_24913":46676,"_2529":46995},[],"Creates or updates the IoT policies configured in the DMS.",{"_3023":1333,"_26291":1210,"_18309":46997,"_5":12556,"_24913":46676,"_2529":46998},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3023":1334,"_26291":1210,"_18309":47000,"_5":12556,"_24913":46676,"_2529":47001},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3023":1335,"_26291":1210,"_18309":47003,"_5":12556,"_24913":46676,"_2529":47004},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3023":1336,"_26291":1210,"_18309":47006,"_5":12556,"_24913":46676,"_2529":47007},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3023":1337,"_26291":1210,"_18309":47009,"_5":12556,"_24913":46676,"_2529":47010},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3023":1338,"_26291":1210,"_18309":47012,"_5":12556,"_24913":46680,"_2529":47013},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3023":1339,"_26291":1210,"_18309":47015,"_5":12556,"_24913":46680,"_2529":47016},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3023":1340,"_26291":1210,"_18309":47018,"_5":12556,"_24913":46680,"_2529":47019},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3023":1341,"_26291":1210,"_18309":47021,"_5":12556,"_24913":46684,"_2529":47022},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3023":1342,"_26291":1210,"_18309":47024,"_5":12556,"_24913":46684,"_2529":47025},[],"The full flow from the device's perspective is:",{"_3023":1343,"_26291":1210,"_18309":47027,"_5":12556,"_24913":46684,"_2529":47028},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3023":1344,"_26291":1210,"_18309":47030,"_5":12556,"_24913":46688,"_2529":47031},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3023":1345,"_26291":1210,"_18309":47033,"_5":12556,"_24913":46688,"_2529":47034},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3023":1346,"_26291":1210,"_18309":47036,"_5":12556,"_24913":46688,"_2529":47037},[],"For the JITP flow to work correctly:",{"_3023":1347,"_26291":1210,"_18309":47039,"_5":12556,"_24913":46688,"_2529":47040},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3023":1348,"_26291":1210,"_18309":47042,"_5":12556,"_24913":46688,"_2529":47043},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3023":1349,"_26291":1210,"_18309":47045,"_5":12556,"_24913":46688,"_2529":47046},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3023":1350,"_26291":1210,"_18309":47048,"_5":12556,"_24913":46688,"_2529":47049},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3023":1351,"_26291":1210,"_18309":47051,"_5":12556,"_24913":46692,"_2529":47052},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3023":1352,"_26291":1210,"_18309":47054,"_5":12556,"_24913":46692,"_2529":47055},[],"Status in Lamassu",{"_3023":1353,"_26291":1210,"_18309":47057,"_5":12556,"_24913":46692,"_2529":47058},[],"Revocation reason",{"_3023":1354,"_26291":1210,"_18309":47060,"_5":12556,"_24913":46692,"_2529":47061},[],"Status in AWS IoT Core",{"_3023":1355,"_26291":1210,"_18309":47063,"_5":12556,"_24913":46692,"_2529":47064},[],"`Active`",{"_3023":1356,"_26291":1210,"_18309":47066,"_5":12556,"_24913":46692,"_2529":47067},[],"None",{"_3023":1357,"_26291":1210,"_18309":47069,"_5":12556,"_24913":46692,"_2529":47070},[],"`ACTIVE`",{"_3023":1358,"_26291":1210,"_18309":47072,"_5":12556,"_24913":46692,"_2529":47073},[],"`Revoked`",{"_3023":1359,"_26291":1210,"_18309":47075,"_5":12556,"_24913":46692,"_2529":47076},[],"`certificateHold`",{"_3023":1360,"_26291":1210,"_18309":47078,"_5":12556,"_24913":46692,"_2529":47079},[],"`INACTIVE`",{"_3023":1361,"_26291":1210,"_18309":47081,"_5":12556,"_24913":46692,"_2529":47073},[],{"_3023":1362,"_26291":1210,"_18309":47083,"_5":12556,"_24913":46692,"_2529":47084},[],"Any other reason",{"_3023":1363,"_26291":1210,"_18309":47086,"_5":12556,"_24913":46692,"_2529":47087},[],"`REVOKED`",{"_3023":1364,"_26291":1210,"_18309":47089,"_5":12556,"_24913":46692,"_2529":47090},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3023":1365,"_26291":1210,"_18309":47092,"_5":12556,"_24913":46696,"_2529":47093},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3023":1366,"_26291":1210,"_18309":47095,"_5":12556,"_24913":46696,"_2529":47096},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3023":1367,"_26291":1210,"_18309":47098,"_5":12556,"_24913":46696,"_2529":47099},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3023":1368,"_26291":1210,"_18309":47101,"_5":12556,"_24913":46700,"_2529":47102},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3023":1369,"_26291":1210,"_18309":47104,"_5":12556,"_24913":46700,"_2529":47105},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3023":1370,"_26291":1210,"_18309":47107,"_5":12556,"_24913":46704,"_2529":47108},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3023":1371,"_26291":1210,"_18309":47110,"_5":12556,"_24913":46704,"_2529":47111},[],"There are two action types:",{"_3023":1372,"_26291":1210,"_18309":47113,"_5":12556,"_24913":46704,"_2529":47114},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3023":1373,"_26291":1210,"_18309":47116,"_5":12556,"_24913":46704,"_2529":47117},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3023":1374,"_26291":1210,"_18309":47119,"_5":12556,"_24913":46704,"_2529":47120},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3023":1375,"_26291":1210,"_18309":47122,"_5":12556,"_24913":46708,"_2529":47123},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3023":1376,"_26291":1210,"_18309":47125,"_5":12556,"_24913":46708,"_2529":47126},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3023":1377,"_26291":1210,"_18309":47128,"_5":12556,"_24913":46708,"_2529":47129},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3023":1378,"_26291":1210,"_18309":47131,"_5":12556,"_24913":46712,"_2529":47132},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3023":1379,"_26291":1210,"_18309":47134,"_5":12556,"_24913":46712,"_2529":47135},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3023":1380,"_26291":1210,"_18309":47137,"_5":12556,"_24913":46712,"_2529":47138},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3023":1381,"_26291":1210,"_18309":47140,"_5":12556,"_24913":46712,"_2529":47141},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3023":1382,"_26291":1210,"_18309":47143,"_5":12556,"_24913":46712,"_2529":47144},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3023":1383,"_26291":1210,"_18309":47146,"_5":12556,"_24913":46712,"_2529":47147},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3023":1384,"_26291":1210,"_18309":47149,"_5":12556,"_24913":46712,"_2529":47150},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3023":1385,"_26291":1210,"_18309":47152,"_5":12556,"_24913":46712,"_2529":47153},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3023":1386,"_26291":1210,"_18309":47155,"_5":12556,"_24913":46712,"_2529":47156},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3023":1387,"_26291":1210,"_18309":47158,"_5":12556,"_24913":46712,"_2529":47159},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3023":1388,"_26291":1210,"_18309":47161,"_5":12556,"_24913":46712,"_2529":47162},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3023":1389,"_26291":1210,"_18309":47164,"_5":12556,"_24913":46712,"_2529":47165},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3023":1390,"_26291":1210,"_18309":47167,"_5":12556,"_24913":46712,"_2529":47168},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3023":1391,"_26291":1210,"_18309":47170,"_5":12556,"_24913":46712,"_2529":47171},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3023":1392,"_26291":1210,"_18309":47173,"_5":12556,"_24913":46712,"_2529":47174},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3023":1393,"_26291":1210,"_18309":47176,"_5":12556,"_24913":46712,"_2529":47177},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3023":1394,"_26291":1210,"_18309":47179,"_5":12556,"_24913":46712,"_2529":47180},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3023":1395,"_26291":1210,"_18309":47182,"_5":12556,"_24913":46712,"_2529":47183},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3023":1396,"_26291":1210,"_18309":47185,"_5":12556,"_24913":46712,"_2529":47186},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3023":1397,"_26291":1210,"_18309":47188,"_5":12556,"_24913":46712,"_2529":47189},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3023":1398,"_26291":1210,"_18309":47191,"_5":12556,"_24913":46712,"_2529":47192},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3023":1399,"_26291":1399,"_5":12871,"_2529":45173,"_26635":47194,"_18309":47195,"_24913":1399},[42855,44199,45173],[],{"_3023":1400,"_26291":1399,"_18309":47197,"_5":12556,"_24913":1399,"_2529":47198},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3023":1401,"_26291":1399,"_5":26632,"_18309":47200,"_24913":47201,"_2529":47202},[],"/docs/pr-preview/pr-47/platform/iot-fleets/overview#start-here","Start here",{"_3023":1402,"_26291":1399,"_5":26632,"_18309":47204,"_24913":47205,"_2529":45171},[],"/docs/pr-preview/pr-47/platform/iot-fleets/overview#devices-and-identities",{"_3023":1403,"_26291":1399,"_5":26632,"_18309":47207,"_24913":47208,"_2529":45354},[],"/docs/pr-preview/pr-47/platform/iot-fleets/overview#enrollment-with-pki",{"_3023":1404,"_26291":1399,"_5":26632,"_18309":47210,"_24913":47211,"_2529":46629},[],"/docs/pr-preview/pr-47/platform/iot-fleets/overview#integrations",{"_3023":1405,"_26291":1399,"_5":26632,"_18309":47213,"_24913":47214,"_2529":47215},[],"/docs/pr-preview/pr-47/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3023":1406,"_26291":1399,"_18309":47217,"_5":12556,"_24913":1399,"_2529":47218},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3023":1407,"_26291":1399,"_18309":47220,"_5":12556,"_24913":47201,"_2529":47221},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3023":1408,"_26291":1399,"_18309":47223,"_5":12556,"_24913":47201,"_2529":47224},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3023":1409,"_26291":1399,"_18309":47226,"_5":12556,"_24913":47205,"_2529":47227},[],"Resource",{"_3023":1410,"_26291":1399,"_18309":47229,"_5":12556,"_24913":47205,"_2529":47230},[],"What it represents",{"_3023":1411,"_26291":1399,"_18309":47232,"_5":12556,"_24913":47205,"_2529":47233},[],"**Device**",{"_3023":1412,"_26291":1399,"_18309":47235,"_5":12556,"_24913":47205,"_2529":47236},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3023":1413,"_26291":1399,"_18309":47238,"_5":12556,"_24913":47205,"_2529":47239},[],"**Identity**",{"_3023":1414,"_26291":1399,"_18309":47241,"_5":12556,"_24913":47205,"_2529":47242},[],"The device's association with its certificates: an active version and a history.",{"_3023":1415,"_26291":1399,"_18309":47244,"_5":12556,"_24913":47205,"_2529":47245},[],"**DMS**",{"_3023":1416,"_26291":1399,"_18309":47247,"_5":12556,"_24913":47205,"_2529":47248},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3023":1417,"_26291":1399,"_18309":47250,"_5":12556,"_24913":47205,"_2529":47251},[],"**Fleet**",{"_3023":1418,"_26291":1399,"_18309":47253,"_5":12556,"_24913":47205,"_2529":47254},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3023":1419,"_26291":1399,"_18309":47256,"_5":12556,"_24913":47205,"_2529":47257},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3023":1420,"_26291":1399,"_18309":47259,"_5":12556,"_24913":47205,"_2529":47260},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3023":1421,"_26291":1399,"_18309":47262,"_5":12556,"_24913":47208,"_2529":47263},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3023":1422,"_26291":1399,"_18309":47265,"_5":12556,"_24913":47208,"_2529":47266},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3023":1423,"_26291":1399,"_18309":47268,"_5":12556,"_24913":47208,"_2529":47269},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3023":1424,"_26291":1399,"_18309":47271,"_5":12556,"_24913":47208,"_2529":47272},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3023":1425,"_26291":1399,"_18309":47274,"_5":12556,"_24913":47208,"_2529":47275},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3023":1426,"_26291":1399,"_18309":47277,"_5":12556,"_24913":47208,"_2529":47278},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3023":1427,"_26291":1399,"_18309":47280,"_5":12556,"_24913":47208,"_2529":47281},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3023":1428,"_26291":1399,"_18309":47283,"_5":12556,"_24913":47208,"_2529":47284},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3023":1429,"_26291":1399,"_18309":47286,"_5":12556,"_24913":47211,"_2529":47287},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3023":1430,"_26291":1399,"_18309":47289,"_5":12556,"_24913":47211,"_2529":47290},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3023":1431,"_26291":1399,"_18309":47292,"_5":12556,"_24913":47214,"_2529":47293},[],"Participant",{"_3023":1432,"_26291":1399,"_18309":47295,"_5":12556,"_24913":47214,"_2529":47296},[],"Responsibility",{"_3023":1433,"_26291":1399,"_18309":47298,"_5":12556,"_24913":47214,"_2529":47299},[],"PKI administrator",{"_3023":1434,"_26291":1399,"_18309":47301,"_5":12556,"_24913":47214,"_2529":47302},[],"CA, issuance profile, chain and revocation publication.",{"_3023":1435,"_26291":1399,"_18309":47304,"_5":12556,"_24913":47214,"_2529":47305},[],"Provisioning administrator",{"_3023":1436,"_26291":1399,"_18309":47307,"_5":12556,"_24913":47214,"_2529":47308},[],"DMS, admission, authentication per operation and inventory.",{"_3023":1437,"_26291":1399,"_18309":47310,"_5":12556,"_24913":47214,"_2529":47311},[],"Device integrator",{"_3023":1438,"_26291":1399,"_18309":47313,"_5":12556,"_24913":47214,"_2529":47314},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3023":1439,"_26291":1399,"_18309":47316,"_5":12556,"_24913":47214,"_2529":47317},[],"Consumer integrator",{"_3023":1440,"_26291":1399,"_18309":47319,"_5":12556,"_24913":47214,"_2529":47320},[],"Trusted issuers, validation and device permissions in the destination.",{"_3023":1441,"_26291":1399,"_18309":47322,"_5":12556,"_24913":47214,"_2529":47323},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3023":1442,"_26291":1442,"_5":12871,"_2529":47325,"_26635":47326,"_18309":47328,"_24913":1442},"Enroll and connect your first device",[42855,44199,45173,47327],"Getting started",[],{"_3023":1443,"_26291":1442,"_18309":47330,"_5":12556,"_24913":1442,"_2529":47331},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3023":1444,"_26291":1442,"_5":26632,"_18309":47333,"_24913":47334,"_2529":42865},[],"/docs/pr-preview/pr-47/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3023":1445,"_26291":1442,"_5":26632,"_18309":47336,"_24913":47337,"_2529":47338},[],"/docs/pr-preview/pr-47/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3023":1446,"_26291":1442,"_5":26632,"_18309":47340,"_24913":47341,"_2529":47342},[],"/docs/pr-preview/pr-47/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3023":1447,"_26291":1442,"_5":26632,"_18309":47344,"_24913":47345,"_2529":47346},[],"/docs/pr-preview/pr-47/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3023":1448,"_26291":1442,"_5":26632,"_18309":47348,"_24913":47349,"_2529":47350},[],"/docs/pr-preview/pr-47/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3023":1449,"_26291":1442,"_5":26632,"_18309":47352,"_24913":47353,"_2529":47354},[],"/docs/pr-preview/pr-47/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3023":1450,"_26291":1442,"_5":26632,"_18309":47356,"_24913":47357,"_2529":47358},[],"/docs/pr-preview/pr-47/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3023":1451,"_26291":1442,"_5":26632,"_18309":47360,"_24913":47361,"_2529":47362},[],"/docs/pr-preview/pr-47/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3023":1452,"_26291":1442,"_18309":47364,"_5":12556,"_24913":1442,"_2529":47365},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3023":1453,"_26291":1442,"_18309":47367,"_5":12556,"_24913":47334,"_2529":47368},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3023":1454,"_26291":1442,"_18309":47370,"_5":12556,"_24913":47334,"_2529":47371},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3023":1455,"_26291":1442,"_18309":47373,"_5":12556,"_24913":47334,"_2529":47374},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3023":1456,"_26291":1442,"_18309":47376,"_5":12556,"_24913":47334,"_2529":47377},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3023":1457,"_26291":1442,"_18309":47379,"_5":12556,"_24913":47334,"_2529":47380},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3023":1458,"_26291":1442,"_18309":47382,"_5":12556,"_24913":47337,"_2529":47383},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3023":1459,"_26291":1442,"_18309":47385,"_5":12556,"_24913":47337,"_2529":47386},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3023":1460,"_26291":1442,"_18309":47388,"_5":12556,"_24913":47341,"_2529":47389},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3023":1461,"_26291":1442,"_18309":47391,"_5":12556,"_24913":47341,"_2529":47392},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3023":1462,"_26291":1442,"_18309":47394,"_5":12556,"_24913":47341,"_2529":47395},[],"Setting",{"_3023":1463,"_26291":1442,"_18309":47397,"_5":12556,"_24913":47341,"_2529":47398},[],"Evaluation value",{"_3023":1464,"_26291":1442,"_18309":47400,"_5":12556,"_24913":47341,"_2529":47401},[],"Enrollment CA",{"_3023":1465,"_26291":1442,"_18309":47403,"_5":12556,"_24913":47341,"_2529":47404},[],"Issuing root from `device-root.pem`.",{"_3023":1466,"_26291":1442,"_18309":47406,"_5":12556,"_24913":47341,"_2529":45484},[],{"_3023":1467,"_26291":1442,"_18309":47408,"_5":12556,"_24913":47341,"_2529":47409},[],"The 1-hour leaf profile you just prepared.",{"_3023":1468,"_26291":1442,"_18309":47411,"_5":12556,"_24913":47341,"_2529":47412},[],"Protocol / Registration Mode",{"_3023":1469,"_26291":1442,"_18309":47414,"_5":12556,"_24913":47341,"_2529":47415},[],"`EST_RFC7030` / `JITP`.",{"_3023":1470,"_26291":1442,"_18309":47417,"_5":12556,"_24913":47341,"_2529":47418},[],"Verify CSR Signature",{"_3023":1471,"_26291":1442,"_18309":47420,"_5":12556,"_24913":47341,"_2529":47421},[],"Enabled.",{"_3023":1472,"_26291":1442,"_18309":47423,"_5":12556,"_24913":47341,"_2529":47424},[],"Enable Replaceable Enrollment",{"_3023":1473,"_26291":1442,"_18309":47426,"_5":12556,"_24913":47341,"_2529":47427},[],"Disabled; the ID must be new.",{"_3023":1474,"_26291":1442,"_18309":47429,"_5":12556,"_24913":47341,"_2529":47430},[],"Initial authentication",{"_3023":1475,"_26291":1442,"_18309":47432,"_5":12556,"_24913":47341,"_2529":47433},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3023":1476,"_26291":1442,"_18309":47435,"_5":12556,"_24913":47341,"_2529":47436},[],"Renewal authentication",{"_3023":1477,"_26291":1442,"_18309":47438,"_5":12556,"_24913":47341,"_2529":47439},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3023":1478,"_26291":1442,"_18309":47441,"_5":12556,"_24913":47341,"_2529":47442},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3023":1479,"_26291":1442,"_18309":47444,"_5":12556,"_24913":47341,"_2529":47445},[],"Empty list for this direct issuance / disabled.",{"_3023":1480,"_26291":1442,"_18309":47447,"_5":12556,"_24913":47341,"_2529":47448},[],"Re-enrollment Delta",{"_3023":1481,"_26291":1442,"_18309":47450,"_5":12556,"_24913":47341,"_2529":47451},[],"1 hour.",{"_3023":1482,"_26291":1442,"_18309":47453,"_5":12556,"_24913":47341,"_2529":47454},[],"Preventive / Critical Delta",{"_3023":1483,"_26291":1442,"_18309":47456,"_5":12556,"_24913":47341,"_2529":47457},[],"30 minutes / 10 minutes.",{"_3023":1484,"_26291":1442,"_18309":47459,"_5":12556,"_24913":47341,"_2529":47460},[],"Revoke on Re-enrollment",{"_3023":1485,"_26291":1442,"_18309":47462,"_5":12556,"_24913":47341,"_2529":47463},[],"Disabled to test the successor before retiring the previous identity.",{"_3023":1486,"_26291":1442,"_18309":47465,"_5":12556,"_24913":47341,"_2529":45492},[],{"_3023":1487,"_26291":1442,"_18309":47467,"_5":12556,"_24913":47341,"_2529":47468},[],"Disabled; the operational key is generated in the client.",{"_3023":1488,"_26291":1442,"_18309":47470,"_5":12556,"_24913":47341,"_2529":47471},[],"CA Distribution",{"_3023":1489,"_26291":1442,"_18309":47473,"_5":12556,"_24913":47341,"_2529":47474},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3023":1490,"_26291":1442,"_18309":47476,"_5":12556,"_24913":47341,"_2529":47477},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. If your console does not expose the independent block, configure and check the resource through the DMS API and DMS guide.",{"_3023":1491,"_26291":1442,"_18309":47479,"_5":12556,"_24913":47345,"_2529":47480},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3023":1492,"_26291":1442,"_18309":47482,"_5":12556,"_24913":47345,"_2529":47483},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3023":1493,"_26291":1442,"_18309":47485,"_5":12556,"_24913":47349,"_2529":47486},[],"Generate a new key and CSR with the selected identifier:",{"_3023":1494,"_26291":1442,"_18309":47488,"_5":12556,"_24913":47349,"_2529":47489},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3023":1495,"_26291":1442,"_18309":47491,"_5":12556,"_24913":47349,"_2529":47492},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3023":1496,"_26291":1442,"_18309":47494,"_5":12556,"_24913":47353,"_2529":47495},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3023":1497,"_26291":1442,"_18309":47497,"_5":12556,"_24913":47353,"_2529":47498},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3023":1498,"_26291":1442,"_18309":47500,"_5":12556,"_24913":47357,"_2529":47501},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3023":1499,"_26291":1442,"_18309":47503,"_5":12556,"_24913":47357,"_2529":47504},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3023":1500,"_26291":1442,"_18309":47506,"_5":12556,"_24913":47357,"_2529":47507},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3023":1501,"_26291":1442,"_18309":47509,"_5":12556,"_24913":47357,"_2529":47510},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3023":1502,"_26291":1442,"_18309":47512,"_5":12556,"_24913":47357,"_2529":47513},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3023":1503,"_26291":1442,"_18309":47515,"_5":12556,"_24913":47361,"_2529":47516},[],"Check",{"_3023":1504,"_26291":1442,"_18309":47518,"_5":12556,"_24913":47361,"_2529":47519},[],"Expected result",{"_3023":1505,"_26291":1442,"_18309":47521,"_5":12556,"_24913":47361,"_2529":47522},[],"Registration",{"_3023":1506,"_26291":1442,"_18309":47524,"_5":12556,"_24913":47361,"_2529":47525},[],"ID created automatically and correct DMS.",{"_3023":1507,"_26291":1442,"_18309":47527,"_5":12556,"_24913":47361,"_2529":47528},[],"Certificate",{"_3023":1508,"_26291":1442,"_18309":47530,"_5":12556,"_24913":47361,"_2529":47531},[],"CN, profile, serial and key verified.",{"_3023":1509,"_26291":1442,"_18309":47533,"_5":12556,"_24913":47361,"_2529":47534},[],"Inventory",{"_3023":1510,"_26291":1442,"_18309":47536,"_5":12556,"_24913":47361,"_2529":47537},[],"Received serial visible as the current identity and in history.",{"_3023":1511,"_26291":1442,"_18309":47539,"_5":12556,"_24913":47361,"_2529":47540},[],"Consumer",{"_3023":1512,"_26291":1442,"_18309":47542,"_5":12556,"_24913":47361,"_2529":47543},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3023":1513,"_26291":1442,"_18309":47545,"_5":12556,"_24913":47361,"_2529":47546},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3023":1514,"_26291":1442,"_18309":47548,"_5":12556,"_24913":47361,"_2529":47549},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3023":1515,"_26291":1515,"_5":12871,"_2529":45189,"_26635":47551,"_18309":47552,"_24913":1515},[42855,44199,45173,47327],[],{"_3023":1516,"_26291":1515,"_18309":47554,"_5":12556,"_24913":1515,"_2529":47555},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3023":1517,"_26291":1515,"_5":26632,"_18309":47557,"_24913":47558,"_2529":42865},[],"/docs/pr-preview/pr-47/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3023":1518,"_26291":1515,"_5":26632,"_18309":47560,"_24913":47561,"_2529":47562},[],"/docs/pr-preview/pr-47/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3023":1519,"_26291":1515,"_5":26632,"_18309":47564,"_24913":47565,"_2529":47566},[],"/docs/pr-preview/pr-47/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3023":1520,"_26291":1515,"_5":26632,"_18309":47568,"_24913":47569,"_2529":47570},[],"/docs/pr-preview/pr-47/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3023":1521,"_26291":1515,"_5":26632,"_18309":47572,"_24913":47573,"_2529":47574},[],"/docs/pr-preview/pr-47/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3023":1522,"_26291":1515,"_5":26632,"_18309":47576,"_24913":47577,"_2529":47578},[],"/docs/pr-preview/pr-47/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3023":1523,"_26291":1515,"_5":26632,"_18309":47580,"_24913":47581,"_2529":47519},[],"/docs/pr-preview/pr-47/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3023":1524,"_26291":1515,"_5":26632,"_18309":47583,"_24913":47584,"_2529":47585},[],"/docs/pr-preview/pr-47/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3023":1525,"_26291":1515,"_5":26632,"_18309":47587,"_24913":47588,"_2529":47589},[],"/docs/pr-preview/pr-47/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3023":1526,"_26291":1515,"_18309":47591,"_5":12556,"_24913":1515,"_2529":47592},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3023":1527,"_26291":1515,"_18309":47594,"_5":12556,"_24913":1515,"_2529":47595},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3023":1528,"_26291":1515,"_18309":47597,"_5":12556,"_24913":47558,"_2529":47598},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3023":1529,"_26291":1515,"_18309":47600,"_5":12556,"_24913":47558,"_2529":47601},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3023":1530,"_26291":1515,"_18309":47603,"_5":12556,"_24913":47558,"_2529":47604},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3023":1531,"_26291":1515,"_18309":47606,"_5":12556,"_24913":47558,"_2529":47607},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3023":1532,"_26291":1515,"_18309":47609,"_5":12556,"_24913":47561,"_2529":47610},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3023":1533,"_26291":1515,"_18309":47612,"_5":12556,"_24913":47561,"_2529":47613},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3023":1534,"_26291":1515,"_18309":47615,"_5":12556,"_24913":47561,"_2529":47616},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3023":1535,"_26291":1515,"_18309":47618,"_5":12556,"_24913":47561,"_2529":47619},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3023":1536,"_26291":1515,"_18309":47621,"_5":12556,"_24913":47561,"_2529":47622},[],"Set **Authentication Mode** to `CLIENT_CERTIFICATE` and add the CA whose initial certificates you will accept in **Validation CAs**. For this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and server key generation disabled if you will not use it.",{"_3023":1537,"_26291":1515,"_18309":47624,"_5":12556,"_24913":47561,"_2529":47625},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3023":1538,"_26291":1515,"_18309":47627,"_5":12556,"_24913":47561,"_2529":47628},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3023":1539,"_26291":1515,"_18309":47630,"_5":12556,"_24913":47561,"_2529":47631},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3023":1540,"_26291":1515,"_18309":47633,"_5":12556,"_24913":47565,"_2529":47634},[],"Open **Managed Devices** and the registration action. Complete:",{"_3023":1541,"_26291":1515,"_18309":47636,"_5":12556,"_24913":47565,"_2529":47637},[],"**Device ID**: `device-001`.",{"_3023":1542,"_26291":1515,"_18309":47639,"_5":12556,"_24913":47565,"_2529":47640},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3023":1543,"_26291":1515,"_18309":47642,"_5":12556,"_24913":47565,"_2529":47643},[],"**Icon** and **Tags**: optional classification.",{"_3023":1544,"_26291":1515,"_18309":47645,"_5":12556,"_24913":47565,"_2529":47646},[],"Confirm registration.",{"_3023":1545,"_26291":1515,"_18309":47648,"_5":12556,"_24913":47569,"_2529":47649},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3023":1546,"_26291":1515,"_18309":47651,"_5":12556,"_24913":47569,"_2529":47652},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3023":1547,"_26291":1515,"_18309":47654,"_5":12556,"_24913":47573,"_2529":47655},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3023":1548,"_26291":1515,"_18309":47657,"_5":12556,"_24913":47573,"_2529":47658},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3023":1549,"_26291":1515,"_18309":47660,"_5":12556,"_24913":47577,"_2529":47661},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3023":1550,"_26291":1515,"_18309":47663,"_5":12556,"_24913":47577,"_2529":47664},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3023":1551,"_26291":1515,"_18309":47666,"_5":12556,"_24913":47581,"_2529":47516},[],{"_3023":1552,"_26291":1515,"_18309":47668,"_5":12556,"_24913":47581,"_2529":47669},[],"Result",{"_3023":1553,"_26291":1515,"_18309":47671,"_5":12556,"_24913":47581,"_2529":47672},[],"Device",{"_3023":1554,"_26291":1515,"_18309":47674,"_5":12556,"_24913":47581,"_2529":47675},[],"`device-001` appears in inventory with the expected DMS.",{"_3023":1555,"_26291":1515,"_18309":47677,"_5":12556,"_24913":47581,"_2529":47678},[],"Current identity",{"_3023":1556,"_26291":1515,"_18309":47680,"_5":12556,"_24913":47581,"_2529":47681},[],"The associated certificate matches the one you verified in PKI.",{"_3023":1557,"_26291":1515,"_18309":47683,"_5":12556,"_24913":47581,"_2529":47684},[],"History",{"_3023":1558,"_26291":1515,"_18309":47686,"_5":12556,"_24913":47581,"_2529":47687},[],"The associated issuance appears with its serial number and dates.",{"_3023":1559,"_26291":1515,"_18309":47689,"_5":12556,"_24913":47581,"_2529":47690},[],"Key and certificate",{"_3023":1560,"_26291":1515,"_18309":47692,"_5":12556,"_24913":47581,"_2529":47693},[],"You have the verified pair ready to install on the device.",{"_3023":1561,"_26291":1515,"_18309":47695,"_5":12556,"_24913":47584,"_2529":47696},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3023":1562,"_26291":1515,"_18309":47698,"_5":12556,"_24913":47584,"_2529":47699},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3023":1563,"_26291":1515,"_18309":47701,"_5":12556,"_24913":47584,"_2529":47702},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3023":1564,"_26291":1515,"_18309":47704,"_5":12556,"_24913":47584,"_2529":47705},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3023":1565,"_26291":1515,"_18309":47707,"_5":12556,"_24913":47588,"_2529":47708},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3023":1566,"_26291":1515,"_18309":47710,"_5":12556,"_24913":47588,"_2529":47711},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3023":1567,"_26291":1515,"_18309":47713,"_5":12556,"_24913":47588,"_2529":47714},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3023":1568,"_26291":1568,"_5":12871,"_2529":47716,"_26635":47717,"_18309":47718,"_24913":1568},"Lamassu IoT Platform",[42855,44199],[],{"_3023":1569,"_26291":1568,"_18309":47720,"_5":12556,"_24913":1568,"_2529":47721},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3023":1570,"_26291":1568,"_5":26632,"_18309":47723,"_24913":47724,"_2529":47202},[],"/docs/pr-preview/pr-47/platform/overview#start-here",{"_3023":1571,"_26291":1568,"_5":26632,"_18309":47726,"_24913":47727,"_2529":47728},[],"/docs/pr-preview/pr-47/platform/overview#choose-your-path","Choose your path",{"_3023":1572,"_26291":1568,"_5":26632,"_18309":47730,"_24913":47731,"_2529":47732},[],"/docs/pr-preview/pr-47/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3023":1573,"_26291":1568,"_5":26632,"_18309":47734,"_24913":47735,"_2529":47736},[],"/docs/pr-preview/pr-47/platform/overview#core-capabilities","Core capabilities",{"_3023":1574,"_26291":1568,"_5":26632,"_18309":47738,"_24913":47739,"_2529":47740},[],"/docs/pr-preview/pr-47/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3023":1575,"_26291":1568,"_5":26632,"_18309":47742,"_24913":47743,"_2529":47744},[],"/docs/pr-preview/pr-47/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3023":1576,"_26291":1568,"_5":26632,"_18309":47746,"_24913":47747,"_2529":47748},[],"/docs/pr-preview/pr-47/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3023":1577,"_26291":1568,"_5":26632,"_18309":47750,"_24913":47751,"_2529":47752},[],"/docs/pr-preview/pr-47/platform/overview#automate-device-identities","Automate device identities",{"_3023":1578,"_26291":1568,"_5":26632,"_18309":47754,"_24913":47755,"_2529":47756},[],"/docs/pr-preview/pr-47/platform/overview#publish-validation-status","Publish validation status",{"_3023":1579,"_26291":1568,"_5":26632,"_18309":47758,"_24913":47759,"_2529":47760},[],"/docs/pr-preview/pr-47/platform/overview#react-to-events","React to events",{"_3023":1580,"_26291":1568,"_5":26632,"_18309":47762,"_24913":47763,"_2529":47764},[],"/docs/pr-preview/pr-47/platform/overview#operational-reference","Operational reference",{"_3023":1581,"_26291":1568,"_18309":47766,"_5":12556,"_24913":1568,"_2529":47767},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3023":1582,"_26291":1568,"_18309":47769,"_5":12556,"_24913":47724,"_2529":47770},[],"Choose the result you need:",{"_3023":1583,"_26291":1568,"_18309":47772,"_5":12556,"_24913":47724,"_2529":47773},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3023":1584,"_26291":1568,"_18309":47775,"_5":12556,"_24913":47724,"_2529":47776},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3023":1585,"_26291":1568,"_18309":47778,"_5":12556,"_24913":47724,"_2529":47779},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3023":1586,"_26291":1568,"_18309":47781,"_5":12556,"_24913":47727,"_2529":47782},[],"Section",{"_3023":1587,"_26291":1568,"_18309":47784,"_5":12556,"_24913":47727,"_2529":47785},[],"What you manage",{"_3023":1588,"_26291":1568,"_18309":47787,"_5":12556,"_24913":47727,"_2529":47788},[],"Entry point",{"_3023":1589,"_26291":1568,"_18309":47790,"_5":12556,"_24913":47727,"_2529":47791},[],"**PKI**",{"_3023":1590,"_26291":1568,"_18309":47793,"_5":12556,"_24913":47727,"_2529":47794},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3023":1591,"_26291":1568,"_18309":47796,"_5":12556,"_24913":47727,"_2529":47797},[],"PKI overview",{"_3023":1592,"_26291":1568,"_18309":47799,"_5":12556,"_24913":47727,"_2529":47800},[],"**IoT Fleets**",{"_3023":1593,"_26291":1568,"_18309":47802,"_5":12556,"_24913":47727,"_2529":47803},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3023":1594,"_26291":1568,"_18309":47805,"_5":12556,"_24913":47727,"_2529":47806},[],"IoT Fleets overview",{"_3023":1595,"_26291":1568,"_18309":47808,"_5":12556,"_24913":47727,"_2529":47809},[],"**Administration**",{"_3023":1596,"_26291":1568,"_18309":47811,"_5":12556,"_24913":47727,"_2529":47812},[],"Operator permissions, audit and event subscriptions.",{"_3023":1597,"_26291":1568,"_18309":47814,"_5":12556,"_24913":47727,"_2529":44197},[],{"_3023":1598,"_26291":1568,"_18309":47816,"_5":12556,"_24913":47727,"_2529":47817},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3023":1599,"_26291":1568,"_18309":47819,"_5":12556,"_24913":47731,"_2529":47820},[],"An identity's journey connects four responsibilities:",{"_3023":1600,"_26291":1568,"_18309":47822,"_5":12556,"_24913":47731,"_2529":47823},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3023":1601,"_26291":1568,"_18309":47825,"_5":12556,"_24913":47731,"_2529":47826},[],"The provisioning administrator configures the DMS and initial trust.",{"_3023":1602,"_26291":1568,"_18309":47828,"_5":12556,"_24913":47731,"_2529":47829},[],"The device client requests a certificate and installs it with the matching key.",{"_3023":1603,"_26291":1568,"_18309":47831,"_5":12556,"_24913":47731,"_2529":47832},[],"The consumer validates the identity and applies its access permissions.",{"_3023":1604,"_26291":1568,"_18309":47834,"_5":12556,"_24913":47731,"_2529":47835},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3023":1605,"_26291":1568,"_18309":47837,"_5":12556,"_24913":47739,"_2529":47838},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3023":1606,"_26291":1568,"_18309":47840,"_5":12556,"_24913":47743,"_2529":47841},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3023":1607,"_26291":1568,"_18309":47843,"_5":12556,"_24913":47747,"_2529":47844},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3023":1608,"_26291":1568,"_18309":47846,"_5":12556,"_24913":47751,"_2529":47847},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3023":1609,"_26291":1568,"_18309":47849,"_5":12556,"_24913":47755,"_2529":47850},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3023":1610,"_26291":1568,"_18309":47852,"_5":12556,"_24913":47759,"_2529":47853},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3023":1611,"_26291":1568,"_18309":47855,"_5":12556,"_24913":47763,"_2529":47296},[],{"_3023":1612,"_26291":1568,"_18309":47857,"_5":12556,"_24913":47763,"_2529":47858},[],"What it prepares or checks",{"_3023":1613,"_26291":1568,"_18309":47860,"_5":12556,"_24913":47763,"_2529":47299},[],{"_3023":1614,"_26291":1568,"_18309":47862,"_5":12556,"_24913":47763,"_2529":47863},[],"Key custody, CA hierarchy, profiles and validation.",{"_3023":1615,"_26291":1568,"_18309":47865,"_5":12556,"_24913":47763,"_2529":47866},[],"Fleet administrator",{"_3023":1616,"_26291":1568,"_18309":47868,"_5":12556,"_24913":47763,"_2529":47869},[],"DMS, device admission, renewal policy and inventory.",{"_3023":1617,"_26291":1568,"_18309":47871,"_5":12556,"_24913":47763,"_2529":47311},[],{"_3023":1618,"_26291":1568,"_18309":47873,"_5":12556,"_24913":47763,"_2529":47874},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3023":1619,"_26291":1568,"_18309":47876,"_5":12556,"_24913":47763,"_2529":47317},[],{"_3023":1620,"_26291":1568,"_18309":47878,"_5":12556,"_24913":47763,"_2529":47879},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3023":1621,"_26291":1568,"_18309":47881,"_5":12556,"_24913":47763,"_2529":47882},[],"Infrastructure operator",{"_3023":1622,"_26291":1568,"_18309":47884,"_5":12556,"_24913":47763,"_2529":47885},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3023":1623,"_26291":1568,"_18309":47887,"_5":12556,"_24913":47763,"_2529":47888},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3023":1624,"_26291":1624,"_5":12871,"_2529":47890,"_26635":47891,"_18309":47894,"_24913":1624},"CA hierarchy and rotation",[42855,44199,47892,47893],"PKI","Keys, authorities and certificates",[],{"_3023":1625,"_26291":1624,"_18309":47896,"_5":12556,"_24913":1624,"_2529":47897},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3023":1626,"_26291":1624,"_5":26632,"_18309":47899,"_24913":47900,"_2529":47901},[],"/docs/pr-preview/pr-47/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3023":1627,"_26291":1624,"_5":26632,"_18309":47903,"_24913":47904,"_2529":47905},[],"/docs/pr-preview/pr-47/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3023":1628,"_26291":1624,"_5":26632,"_18309":47907,"_24913":47908,"_2529":47909},[],"/docs/pr-preview/pr-47/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3023":1629,"_26291":1624,"_5":26632,"_18309":47911,"_24913":47912,"_2529":47913},[],"/docs/pr-preview/pr-47/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3023":1630,"_26291":1624,"_5":26632,"_18309":47915,"_24913":47916,"_2529":47917},[],"/docs/pr-preview/pr-47/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3023":1631,"_26291":1624,"_5":26632,"_18309":47919,"_24913":47920,"_2529":47921},[],"/docs/pr-preview/pr-47/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3023":1632,"_26291":1624,"_5":26632,"_18309":47923,"_24913":47924,"_2529":47925},[],"/docs/pr-preview/pr-47/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3023":1633,"_26291":1624,"_5":26632,"_18309":47927,"_24913":47928,"_2529":47929},[],"/docs/pr-preview/pr-47/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3023":1634,"_26291":1624,"_5":26632,"_18309":47931,"_24913":47932,"_2529":47933},[],"/docs/pr-preview/pr-47/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3023":1635,"_26291":1624,"_5":26632,"_18309":47935,"_24913":47936,"_2529":47937},[],"/docs/pr-preview/pr-47/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3023":1636,"_26291":1624,"_5":26632,"_18309":47939,"_24913":47940,"_2529":47941},[],"/docs/pr-preview/pr-47/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3023":1637,"_26291":1624,"_5":26632,"_18309":47943,"_24913":47944,"_2529":47945},[],"/docs/pr-preview/pr-47/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3023":1638,"_26291":1624,"_18309":47947,"_5":12556,"_24913":1624,"_2529":47948},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3023":1639,"_26291":1624,"_18309":47950,"_5":12556,"_24913":1624,"_2529":47951},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3023":1640,"_26291":1624,"_18309":47953,"_5":12556,"_24913":47900,"_2529":47954},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3023":1641,"_26291":1624,"_18309":47956,"_5":12556,"_24913":47900,"_2529":47957},[],"environment, such as production and preproduction;",{"_3023":1642,"_26291":1624,"_18309":47959,"_5":12556,"_24913":47900,"_2529":47960},[],"owner or operating team;",{"_3023":1643,"_26291":1624,"_18309":47962,"_5":12556,"_24913":47900,"_2529":47963},[],"device family or manufacturing process;",{"_3023":1644,"_26291":1624,"_18309":47965,"_5":12556,"_24913":47900,"_2529":47966},[],"region or regulatory requirement;",{"_3023":1645,"_26291":1624,"_18309":47968,"_5":12556,"_24913":47900,"_2529":47969},[],"cryptographic engine or key policy;",{"_3023":1646,"_26291":1624,"_18309":47971,"_5":12556,"_24913":47900,"_2529":47972},[],"maintenance window and renewal cadence.",{"_3023":1647,"_26291":1624,"_18309":47974,"_5":12556,"_24913":47900,"_2529":47975},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3023":1648,"_26291":1624,"_18309":47977,"_5":12556,"_24913":47900,"_2529":47978},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3023":1649,"_26291":1624,"_18309":47980,"_5":12556,"_24913":47904,"_2529":47981},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3023":1650,"_26291":1624,"_18309":47983,"_5":12556,"_24913":47904,"_2529":47984},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3023":1651,"_26291":1624,"_18309":47986,"_5":12556,"_24913":47904,"_2529":47987},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3023":1652,"_26291":1624,"_18309":47989,"_5":12556,"_24913":47908,"_2529":47990},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3023":1653,"_26291":1624,"_18309":47992,"_5":12556,"_24913":47908,"_2529":47993},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3023":1654,"_26291":1624,"_18309":47995,"_5":12556,"_24913":47908,"_2529":47996},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3023":1655,"_26291":1624,"_18309":47998,"_5":12556,"_24913":47908,"_2529":47999},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3023":1656,"_26291":1624,"_18309":48001,"_5":12556,"_24913":47916,"_2529":48002},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3023":1657,"_26291":1624,"_18309":48004,"_5":12556,"_24913":47920,"_2529":48005},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3023":1658,"_26291":1624,"_18309":48007,"_5":12556,"_24913":47924,"_2529":48008},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3023":1659,"_26291":1624,"_18309":48010,"_5":12556,"_24913":47928,"_2529":48011},[],"Update the enrollment CA and profile of the DMSs, and add the old CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) while old-CA cohorts still renew. The DMS guide documents the setting.",{"_3023":1660,"_26291":1624,"_18309":48013,"_5":12556,"_24913":47932,"_2529":48014},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3023":1661,"_26291":1624,"_18309":48016,"_5":12556,"_24913":47936,"_2529":48017},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance and from the distributed CAs. Revoke it if policy requires it.",{"_3023":1662,"_26291":1624,"_18309":48019,"_5":12556,"_24913":47940,"_2529":48020},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3023":1663,"_26291":1624,"_18309":48022,"_5":12556,"_24913":47940,"_2529":48023},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3023":1664,"_26291":1624,"_18309":48025,"_5":12556,"_24913":47940,"_2529":48026},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3023":1665,"_26291":1624,"_18309":48028,"_5":12556,"_24913":47940,"_2529":48029},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3023":1666,"_26291":1624,"_18309":48031,"_5":12556,"_24913":47944,"_2529":48032},[],"The new chain ends in an anchor installed by the consumer.",{"_3023":1667,"_26291":1624,"_18309":48034,"_5":12556,"_24913":47944,"_2529":48035},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3023":1668,"_26291":1624,"_18309":48037,"_5":12556,"_24913":47944,"_2529":48038},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3023":1669,"_26291":1624,"_18309":48040,"_5":12556,"_24913":47944,"_2529":48041},[],"Re-enrollment accepts the old identity during the planned period.",{"_3023":1670,"_26291":1624,"_18309":48043,"_5":12556,"_24913":47944,"_2529":48044},[],"OCSP and CRL respond for the authorities that remain active.",{"_3023":1671,"_26291":1624,"_18309":48046,"_5":12556,"_24913":47944,"_2529":48047},[],"No DMS is left accidentally issuing from the old CA.",{"_3023":1672,"_26291":1624,"_18309":48049,"_5":12556,"_24913":47944,"_2529":48050},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3023":1673,"_26291":1673,"_5":12871,"_2529":48052,"_26635":48053,"_18309":48054,"_24913":1673},"Certification authorities",[42855,44199,47892,47893],[],{"_3023":1674,"_26291":1673,"_18309":48056,"_5":12556,"_24913":1673,"_2529":48057},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3023":1675,"_26291":1673,"_5":26632,"_18309":48059,"_24913":48060,"_2529":48061},[],"/docs/pr-preview/pr-47/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3023":1676,"_26291":1673,"_5":26632,"_18309":48063,"_24913":48064,"_2529":48065},[],"/docs/pr-preview/pr-47/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3023":1677,"_26291":1673,"_5":26632,"_18309":48067,"_24913":48068,"_2529":42865},[],"/docs/pr-preview/pr-47/platform/pki/certificate-authorities#before-you-begin",{"_3023":1678,"_26291":1673,"_5":26632,"_18309":48070,"_24913":48071,"_2529":48072},[],"/docs/pr-preview/pr-47/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3023":1679,"_26291":1673,"_5":26632,"_18309":48074,"_24913":48075,"_2529":48076},[],"/docs/pr-preview/pr-47/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3023":1680,"_26291":1673,"_5":26632,"_18309":48078,"_24913":48079,"_2529":48080},[],"/docs/pr-preview/pr-47/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3023":1681,"_26291":1673,"_5":26632,"_18309":48082,"_24913":48083,"_2529":48084},[],"/docs/pr-preview/pr-47/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3023":1682,"_26291":1673,"_5":26632,"_18309":48086,"_24913":48087,"_2529":48088},[],"/docs/pr-preview/pr-47/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3023":1683,"_26291":1673,"_5":26632,"_18309":48090,"_24913":48091,"_2529":48092},[],"/docs/pr-preview/pr-47/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3023":1684,"_26291":1673,"_5":26632,"_18309":48094,"_24913":48095,"_2529":48096},[],"/docs/pr-preview/pr-47/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3023":1685,"_26291":1673,"_5":26632,"_18309":48098,"_24913":48099,"_2529":48100},[],"/docs/pr-preview/pr-47/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3023":1686,"_26291":1673,"_5":26632,"_18309":48102,"_24913":48103,"_2529":48104},[],"/docs/pr-preview/pr-47/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3023":1687,"_26291":1673,"_5":26632,"_18309":48106,"_24913":48107,"_2529":48108},[],"/docs/pr-preview/pr-47/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3023":1688,"_26291":1673,"_5":26632,"_18309":48110,"_24913":48111,"_2529":48112},[],"/docs/pr-preview/pr-47/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3023":1689,"_26291":1673,"_5":26632,"_18309":48114,"_24913":48115,"_2529":48116},[],"/docs/pr-preview/pr-47/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3023":1690,"_26291":1673,"_5":26632,"_18309":48118,"_24913":48119,"_2529":48120},[],"/docs/pr-preview/pr-47/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3023":1691,"_26291":1673,"_5":26632,"_18309":48122,"_24913":48123,"_2529":48124},[],"/docs/pr-preview/pr-47/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3023":1692,"_26291":1673,"_5":26632,"_18309":48126,"_24913":48127,"_2529":48128},[],"/docs/pr-preview/pr-47/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3023":1693,"_26291":1673,"_5":26632,"_18309":48130,"_24913":48131,"_2529":48132},[],"/docs/pr-preview/pr-47/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3023":1694,"_26291":1673,"_5":26632,"_18309":48134,"_24913":48135,"_2529":48136},[],"/docs/pr-preview/pr-47/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3023":1695,"_26291":1673,"_5":26632,"_18309":48138,"_24913":48139,"_2529":48140},[],"/docs/pr-preview/pr-47/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3023":1696,"_26291":1673,"_5":26632,"_18309":48142,"_24913":48143,"_2529":48144},[],"/docs/pr-preview/pr-47/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3023":1697,"_26291":1673,"_18309":48146,"_5":12556,"_24913":1673,"_2529":48147},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3023":1698,"_26291":1673,"_18309":48149,"_5":12556,"_24913":1673,"_2529":48150},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3023":1699,"_26291":1673,"_18309":48152,"_5":12556,"_24913":1673,"_2529":48153},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3023":1700,"_26291":1673,"_18309":48155,"_5":12556,"_24913":48060,"_2529":48156},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3023":1701,"_26291":1673,"_18309":48158,"_5":12556,"_24913":48060,"_2529":48159},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3023":1702,"_26291":1673,"_18309":48161,"_5":12556,"_24913":48060,"_2529":48162},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3023":1703,"_26291":1673,"_18309":48164,"_5":12556,"_24913":48060,"_2529":48165},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3023":1704,"_26291":1673,"_18309":48167,"_5":12556,"_24913":48060,"_2529":48168},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3023":1705,"_26291":1673,"_18309":48170,"_5":12556,"_24913":48068,"_2529":48171},[],"Decide whether the CA will be a root or an intermediate.",{"_3023":1706,"_26291":1673,"_18309":48173,"_5":12556,"_24913":48068,"_2529":48174},[],"Choose the engine that will keep the key.",{"_3023":1707,"_26291":1673,"_18309":48176,"_5":12556,"_24913":48068,"_2529":48177},[],"Define a validity longer than that of the certificates it will issue.",{"_3023":1708,"_26291":1673,"_18309":48179,"_5":12556,"_24913":48068,"_2529":48180},[],"For an intermediate CA, make sure the parent CA is active.",{"_3023":1709,"_26291":1673,"_18309":48182,"_5":12556,"_24913":48071,"_2529":48183},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3023":1710,"_26291":1673,"_18309":48185,"_5":12556,"_24913":48075,"_2529":48186},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3023":1711,"_26291":1673,"_18309":48188,"_5":12556,"_24913":48075,"_2529":48189},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3023":1712,"_26291":1673,"_18309":48191,"_5":12556,"_24913":48079,"_2529":48192},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3023":1713,"_26291":1673,"_18309":48194,"_5":12556,"_24913":48083,"_2529":48195},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3023":1714,"_26291":1673,"_18309":48197,"_5":12556,"_24913":48083,"_2529":48198},[],"`C`: two-letter ISO 3166-1 country code.",{"_3023":1715,"_26291":1673,"_18309":48200,"_5":12556,"_24913":48083,"_2529":48201},[],"`ST`: state or province.",{"_3023":1716,"_26291":1673,"_18309":48203,"_5":12556,"_24913":48083,"_2529":48204},[],"`L`: locality.",{"_3023":1717,"_26291":1673,"_18309":48206,"_5":12556,"_24913":48083,"_2529":48207},[],"`O`: organization.",{"_3023":1718,"_26291":1673,"_18309":48209,"_5":12556,"_24913":48083,"_2529":48210},[],"`OU`: organizational unit.",{"_3023":1719,"_26291":1673,"_18309":48212,"_5":12556,"_24913":48083,"_2529":48213},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3023":1720,"_26291":1673,"_18309":48215,"_5":12556,"_24913":48087,"_2529":48216},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3023":1721,"_26291":1673,"_18309":48218,"_5":12556,"_24913":48087,"_2529":48219},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3023":1722,"_26291":1673,"_18309":48221,"_5":12556,"_24913":48091,"_2529":48222},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3023":1723,"_26291":1673,"_18309":48224,"_5":12556,"_24913":48091,"_2529":48225},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3023":1724,"_26291":1673,"_18309":48227,"_5":12556,"_24913":48095,"_2529":48228},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3023":1725,"_26291":1673,"_18309":48230,"_5":12556,"_24913":48095,"_2529":48231},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3023":1726,"_26291":1673,"_18309":48233,"_5":12556,"_24913":48099,"_2529":48234},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3023":1727,"_26291":1673,"_18309":48236,"_5":12556,"_24913":48103,"_2529":48237},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3023":1728,"_26291":1673,"_18309":48239,"_5":12556,"_24913":48107,"_2529":48240},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3023":1729,"_26291":1673,"_18309":48242,"_5":12556,"_24913":48111,"_2529":48243},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3023":1730,"_26291":1673,"_18309":48245,"_5":12556,"_24913":48115,"_2529":48246},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3023":1731,"_26291":1673,"_18309":48248,"_5":12556,"_24913":48115,"_2529":48249},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3023":1732,"_26291":1673,"_18309":48251,"_5":12556,"_24913":48119,"_2529":48252},[],"Open a CA from the inventory to review:",{"_3023":1733,"_26291":1673,"_18309":48254,"_5":12556,"_24913":48119,"_2529":48255},[],"Status and validity period.",{"_3023":1734,"_26291":1673,"_18309":48257,"_5":12556,"_24913":48119,"_2529":48258},[],"Certificate and chain in PEM format.",{"_3023":1735,"_26291":1673,"_18309":48260,"_5":12556,"_24913":48119,"_2529":48261},[],"Number of active, expired and revoked certificates.",{"_3023":1736,"_26291":1673,"_18309":48263,"_5":12556,"_24913":48119,"_2529":48264},[],"Certificates issued in **Issued Certificates**.",{"_3023":1737,"_26291":1673,"_18309":48266,"_5":12556,"_24913":48119,"_2529":48267},[],"The CRL linked to the authority.",{"_3023":1738,"_26291":1673,"_18309":48269,"_5":12556,"_24913":48119,"_2529":48270},[],"Metadata and the associated cryptographic engine.",{"_3023":1739,"_26291":1673,"_18309":48272,"_5":12556,"_24913":48119,"_2529":48273},[],"You can filter the inventory by name, status and CA type.",{"_3023":1740,"_26291":1673,"_18309":48275,"_5":12556,"_24913":48123,"_2529":48276},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3023":1741,"_26291":1673,"_18309":48278,"_5":12556,"_24913":48123,"_2529":48279},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3023":1742,"_26291":1673,"_18309":48281,"_5":12556,"_24913":48123,"_2529":48282},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3023":1743,"_26291":1673,"_18309":48284,"_5":12556,"_24913":48123,"_2529":48285},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3023":1744,"_26291":1673,"_18309":48287,"_5":12556,"_24913":48127,"_2529":48288},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3023":1745,"_26291":1673,"_18309":48290,"_5":12556,"_24913":48131,"_2529":48291},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3023":1746,"_26291":1673,"_18309":48293,"_5":12556,"_24913":48135,"_2529":48294},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3023":1747,"_26291":1673,"_18309":48296,"_5":12556,"_24913":48139,"_2529":48297},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3023":1748,"_26291":1673,"_18309":48299,"_5":12556,"_24913":48143,"_2529":48300},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3023":1749,"_26291":1673,"_18309":48302,"_5":12556,"_24913":48143,"_2529":48303},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_3023":1750,"_26291":1750,"_5":12871,"_2529":48305,"_26635":48306,"_18309":48307,"_24913":1750},"Certificate profiles",[42855,44199,47892,47893],[],{"_3023":1751,"_26291":1750,"_18309":48309,"_5":12556,"_24913":1750,"_2529":48310},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3023":1752,"_26291":1750,"_5":26632,"_18309":48312,"_24913":48313,"_2529":48314},[],"/docs/pr-preview/pr-47/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3023":1753,"_26291":1750,"_5":26632,"_18309":48316,"_24913":48317,"_2529":48318},[],"/docs/pr-preview/pr-47/platform/pki/certificate-profiles#validity","Validity",{"_3023":1754,"_26291":1750,"_5":26632,"_18309":48320,"_24913":48321,"_2529":48322},[],"/docs/pr-preview/pr-47/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3023":1755,"_26291":1750,"_5":26632,"_18309":48324,"_24913":48325,"_2529":48326},[],"/docs/pr-preview/pr-47/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3023":1756,"_26291":1750,"_5":26632,"_18309":48328,"_24913":48329,"_2529":48330},[],"/docs/pr-preview/pr-47/platform/pki/certificate-profiles#subject","Subject",{"_3023":1757,"_26291":1750,"_5":26632,"_18309":48332,"_24913":48333,"_2529":48334},[],"/docs/pr-preview/pr-47/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3023":1758,"_26291":1750,"_5":26632,"_18309":48336,"_24913":48337,"_2529":48338},[],"/docs/pr-preview/pr-47/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3023":1759,"_26291":1750,"_5":26632,"_18309":48340,"_24913":48341,"_2529":48342},[],"/docs/pr-preview/pr-47/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3023":1760,"_26291":1750,"_5":26632,"_18309":48344,"_24913":48345,"_2529":48346},[],"/docs/pr-preview/pr-47/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3023":1761,"_26291":1750,"_5":26632,"_18309":48348,"_24913":48349,"_2529":48350},[],"/docs/pr-preview/pr-47/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3023":1762,"_26291":1750,"_5":26632,"_18309":48352,"_24913":48353,"_2529":48354},[],"/docs/pr-preview/pr-47/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3023":1763,"_26291":1750,"_5":26632,"_18309":48356,"_24913":48357,"_2529":48358},[],"/docs/pr-preview/pr-47/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3023":1764,"_26291":1750,"_5":26632,"_18309":48360,"_24913":48361,"_2529":48362},[],"/docs/pr-preview/pr-47/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3023":1765,"_26291":1750,"_5":26632,"_18309":48364,"_24913":48365,"_2529":48366},[],"/docs/pr-preview/pr-47/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3023":1766,"_26291":1750,"_5":26632,"_18309":48368,"_24913":48369,"_2529":48370},[],"/docs/pr-preview/pr-47/platform/pki/certificate-profiles#design-examples","Design examples",{"_3023":1767,"_26291":1750,"_5":26632,"_18309":48372,"_24913":48373,"_2529":48374},[],"/docs/pr-preview/pr-47/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3023":1768,"_26291":1750,"_18309":48376,"_5":12556,"_24913":1750,"_2529":48377},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3023":1769,"_26291":1750,"_18309":48379,"_5":12556,"_24913":1750,"_2529":48380},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3023":1770,"_26291":1750,"_18309":48382,"_5":12556,"_24913":48317,"_2529":48383},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3023":1771,"_26291":1750,"_18309":48385,"_5":12556,"_24913":48317,"_2529":48386},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3023":1772,"_26291":1750,"_18309":48388,"_5":12556,"_24913":48321,"_2529":48389},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3023":1773,"_26291":1750,"_18309":48391,"_5":12556,"_24913":48325,"_2529":48392},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3023":1774,"_26291":1750,"_18309":48394,"_5":12556,"_24913":48325,"_2529":48395},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3023":1775,"_26291":1750,"_18309":48397,"_5":12556,"_24913":48325,"_2529":48398},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3023":1776,"_26291":1750,"_18309":48400,"_5":12556,"_24913":48329,"_2529":48401},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3023":1777,"_26291":1750,"_18309":48403,"_5":12556,"_24913":48333,"_2529":48404},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3023":1778,"_26291":1750,"_18309":48406,"_5":12556,"_24913":48333,"_2529":48407},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3023":1779,"_26291":1750,"_18309":48409,"_5":12556,"_24913":48337,"_2529":48410},[],"The cryptographic enforcement can:",{"_3023":1780,"_26291":1750,"_18309":48412,"_5":12556,"_24913":48337,"_2529":48413},[],"allow or block RSA keys;",{"_3023":1781,"_26291":1750,"_18309":48415,"_5":12556,"_24913":48337,"_2529":48416},[],"limit the supported RSA sizes;",{"_3023":1782,"_26291":1750,"_18309":48418,"_5":12556,"_24913":48337,"_2529":48419},[],"allow or block ECDSA keys;",{"_3023":1783,"_26291":1750,"_18309":48421,"_5":12556,"_24913":48337,"_2529":48422},[],"limit the supported ECDSA sizes or curves.",{"_3023":1784,"_26291":1750,"_18309":48424,"_5":12556,"_24913":48337,"_2529":48425},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3023":1785,"_26291":1750,"_18309":48427,"_5":12556,"_24913":48341,"_2529":48428},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3023":1786,"_26291":1750,"_18309":48430,"_5":12556,"_24913":48341,"_2529":45920},[],{"_3023":1787,"_26291":1750,"_18309":48432,"_5":12556,"_24913":48341,"_2529":48433},[],"First choice",{"_3023":1788,"_26291":1750,"_18309":48435,"_5":12556,"_24913":48341,"_2529":48436},[],"Second choice",{"_3023":1789,"_26291":1750,"_18309":48438,"_5":12556,"_24913":48341,"_2529":48439},[],"If neither is supplied",{"_3023":1790,"_26291":1750,"_18309":48441,"_5":12556,"_24913":48341,"_2529":48442},[],"Direct signing with a CA",{"_3023":1791,"_26291":1750,"_18309":48444,"_5":12556,"_24913":48341,"_2529":48445},[],"`issuance_profile` embedded in the request",{"_3023":1792,"_26291":1750,"_18309":48447,"_5":12556,"_24913":48341,"_2529":48448},[],"Request `issuance_profile_id`",{"_3023":1793,"_26291":1750,"_18309":48450,"_5":12556,"_24913":48341,"_2529":48451},[],"CA default profile (`profile_id`).",{"_3023":1794,"_26291":1750,"_18309":48453,"_5":12556,"_24913":48341,"_2529":48454},[],"Issuance through a DMS",{"_3023":1795,"_26291":1750,"_18309":48456,"_5":12556,"_24913":48341,"_2529":48457},[],"`settings.issuance_profile_id`",{"_3023":1796,"_26291":1750,"_18309":48459,"_5":12556,"_24913":48341,"_2529":48460},[],"`settings.issuance_profile` embedded in the DMS",{"_3023":1797,"_26291":1750,"_18309":48462,"_5":12556,"_24913":48341,"_2529":48463},[],"Enrollment CA default profile.",{"_3023":1798,"_26291":1750,"_18309":48465,"_5":12556,"_24913":48341,"_2529":48466},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3023":1799,"_26291":1750,"_18309":48468,"_5":12556,"_24913":48341,"_2529":48469},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3023":1800,"_26291":1750,"_18309":48471,"_5":12556,"_24913":48349,"_2529":48472},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3023":1801,"_26291":1750,"_18309":48474,"_5":12556,"_24913":48353,"_2529":48475},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3023":1802,"_26291":1750,"_18309":48477,"_5":12556,"_24913":48357,"_2529":48478},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3023":1803,"_26291":1750,"_18309":48480,"_5":12556,"_24913":48361,"_2529":48481},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3023":1804,"_26291":1750,"_18309":48483,"_5":12556,"_24913":48365,"_2529":48484},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3023":1805,"_26291":1750,"_18309":48486,"_5":12556,"_24913":48365,"_2529":48487},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3023":1806,"_26291":1750,"_18309":48489,"_5":12556,"_24913":48369,"_2529":48490},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3023":1807,"_26291":1750,"_18309":48492,"_5":12556,"_24913":48369,"_2529":48493},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3023":1808,"_26291":1750,"_18309":48495,"_5":12556,"_24913":48369,"_2529":48496},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3023":1809,"_26291":1750,"_18309":48498,"_5":12556,"_24913":48369,"_2529":48499},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3023":1810,"_26291":1750,"_18309":48501,"_5":12556,"_24913":48373,"_2529":48502},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3023":1811,"_26291":1750,"_18309":48504,"_5":12556,"_24913":48373,"_2529":48505},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3023":1812,"_26291":1812,"_5":12871,"_2529":48507,"_26635":48508,"_18309":48510,"_24913":1812},"Certificate validation",[42855,44199,47892,48509],"Validation",[],{"_3023":1813,"_26291":1812,"_18309":48512,"_5":12556,"_24913":1812,"_2529":48513},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3023":1814,"_26291":1812,"_5":26632,"_18309":48515,"_24913":48516,"_2529":48517},[],"/docs/pr-preview/pr-47/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3023":1815,"_26291":1812,"_5":26632,"_18309":48519,"_24913":48520,"_2529":48521},[],"/docs/pr-preview/pr-47/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3023":1816,"_26291":1812,"_5":26632,"_18309":48523,"_24913":48524,"_2529":48525},[],"/docs/pr-preview/pr-47/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3023":1817,"_26291":1812,"_18309":48527,"_5":12556,"_24913":1812,"_2529":48528},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3023":1818,"_26291":1812,"_18309":48530,"_5":12556,"_24913":48516,"_2529":48531},[],"Verify these criteria together:",{"_3023":1819,"_26291":1812,"_18309":48533,"_5":12556,"_24913":48516,"_2529":47516},[],{"_3023":1820,"_26291":1812,"_18309":48535,"_5":12556,"_24913":48516,"_2529":48536},[],"Required result",{"_3023":1821,"_26291":1812,"_18309":48538,"_5":12556,"_24913":48516,"_2529":48539},[],"Chain and signature",{"_3023":1822,"_26291":1812,"_18309":48541,"_5":12556,"_24913":48516,"_2529":48542},[],"Valid chain to a root deliberately installed in the consumer.",{"_3023":1823,"_26291":1812,"_18309":48544,"_5":12556,"_24913":48516,"_2529":48545},[],"Dates",{"_3023":1824,"_26291":1812,"_18309":48547,"_5":12556,"_24913":48516,"_2529":48548},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3023":1825,"_26291":1812,"_18309":48550,"_5":12556,"_24913":48516,"_2529":43902},[],{"_3023":1826,"_26291":1812,"_18309":48552,"_5":12556,"_24913":48516,"_2529":48553},[],"Name, SAN or identifier matches the expected peer.",{"_3023":1827,"_26291":1812,"_18309":48555,"_5":12556,"_24913":48516,"_2529":43238},[],{"_3023":1828,"_26291":1812,"_18309":48557,"_5":12556,"_24913":48516,"_2529":48558},[],"KU, EKU and constraints permit the specific operation.",{"_3023":1829,"_26291":1812,"_18309":48560,"_5":12556,"_24913":48516,"_2529":48561},[],"Revocation",{"_3023":1830,"_26291":1812,"_18309":48563,"_5":12556,"_24913":48516,"_2529":48564},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3023":1831,"_26291":1812,"_18309":48566,"_5":12556,"_24913":48516,"_2529":48567},[],"Authorization",{"_3023":1832,"_26291":1812,"_18309":48569,"_5":12556,"_24913":48516,"_2529":48570},[],"The application permits that identity to perform the action.",{"_3023":1833,"_26291":1812,"_18309":48572,"_5":12556,"_24913":48516,"_2529":48573},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3023":1834,"_26291":1812,"_18309":48575,"_5":12556,"_24913":48520,"_2529":48576},[],"Mechanism",{"_3023":1835,"_26291":1812,"_18309":48578,"_5":12556,"_24913":48520,"_2529":48579},[],"When to use it",{"_3023":1836,"_26291":1812,"_18309":48581,"_5":12556,"_24913":48520,"_2529":48582},[],"What you must maintain",{"_3023":1837,"_26291":1812,"_18309":48584,"_5":12556,"_24913":48520,"_2529":48585},[],"OCSP",{"_3023":1838,"_26291":1812,"_18309":48587,"_5":12556,"_24913":48520,"_2529":48588},[],"Status query for a specific certificate.",{"_3023":1839,"_26291":1812,"_18309":48590,"_5":12556,"_24913":48520,"_2529":48591},[],"Responder access, signature verification and cache/freshness policy.",{"_3023":1840,"_26291":1812,"_18309":48593,"_5":12556,"_24913":48520,"_2529":48594},[],"CRL",{"_3023":1841,"_26291":1812,"_18309":48596,"_5":12556,"_24913":48520,"_2529":48597},[],"Local checks for many certificates or offline operation.",{"_3023":1842,"_26291":1812,"_18309":48599,"_5":12556,"_24913":48520,"_2529":48600},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3023":1843,"_26291":1812,"_18309":48602,"_5":12556,"_24913":48520,"_2529":48603},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3023":1844,"_26291":1812,"_18309":48605,"_5":12556,"_24913":48520,"_2529":48606},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3023":1845,"_26291":1812,"_18309":48608,"_5":12556,"_24913":48524,"_2529":48609},[],"Accept a current, authorized certificate with a known chain.",{"_3023":1846,"_26291":1812,"_18309":48611,"_5":12556,"_24913":48524,"_2529":48612},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3023":1847,"_26291":1812,"_18309":48614,"_5":12556,"_24913":48524,"_2529":48615},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3023":1848,"_26291":1812,"_18309":48617,"_5":12556,"_24913":48524,"_2529":48618},[],"Check that a new connection with that identity is rejected.",{"_3023":1849,"_26291":1812,"_18309":48620,"_5":12556,"_24913":48524,"_2529":48621},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3023":1850,"_26291":1812,"_18309":48623,"_5":12556,"_24913":48524,"_2529":48624},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3023":1851,"_26291":1812,"_18309":48626,"_5":12556,"_24913":48524,"_2529":48627},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3023":1852,"_26291":1812,"_18309":48629,"_5":12556,"_24913":48524,"_2529":48630},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3023":1853,"_26291":1812,"_18309":48632,"_5":12556,"_24913":48524,"_2529":48633},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3023":1854,"_26291":1854,"_5":12871,"_2529":48635,"_26635":48636,"_18309":48637,"_24913":1854},"Certificates",[42855,44199,47892,47893],[],{"_3023":1855,"_26291":1854,"_18309":48639,"_5":12556,"_24913":1854,"_2529":48640},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3023":1856,"_26291":1854,"_5":26632,"_18309":48642,"_24913":48643,"_2529":48644},[],"/docs/pr-preview/pr-47/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3023":1857,"_26291":1854,"_5":26632,"_18309":48646,"_24913":48647,"_2529":48648},[],"/docs/pr-preview/pr-47/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3023":1858,"_26291":1854,"_5":26632,"_18309":48650,"_24913":48651,"_2529":48652},[],"/docs/pr-preview/pr-47/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3023":1859,"_26291":1854,"_5":26632,"_18309":48654,"_24913":48655,"_2529":48656},[],"/docs/pr-preview/pr-47/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3023":1860,"_26291":1854,"_5":26632,"_18309":48658,"_24913":48659,"_2529":48660},[],"/docs/pr-preview/pr-47/platform/pki/certificates#open-the-action","Open the action",{"_3023":1861,"_26291":1854,"_5":26632,"_18309":48662,"_24913":48663,"_2529":48664},[],"/docs/pr-preview/pr-47/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3023":1862,"_26291":1854,"_5":26632,"_18309":48666,"_24913":48667,"_2529":48668},[],"/docs/pr-preview/pr-47/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3023":1863,"_26291":1854,"_5":26632,"_18309":48670,"_24913":48671,"_2529":48672},[],"/docs/pr-preview/pr-47/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3023":1864,"_26291":1854,"_5":26632,"_18309":48674,"_24913":48675,"_2529":48676},[],"/docs/pr-preview/pr-47/platform/pki/certificates#continue","Continue",{"_3023":1865,"_26291":1854,"_18309":48678,"_5":12556,"_24913":1854,"_2529":48679},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3023":1866,"_26291":1854,"_18309":48681,"_5":12556,"_24913":48643,"_2529":48682},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3023":1867,"_26291":1854,"_18309":48684,"_5":12556,"_24913":48643,"_2529":48685},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3023":1868,"_26291":1854,"_18309":48687,"_5":12556,"_24913":48647,"_2529":48688},[],"Download the PEM and inspect it:",{"_3023":1869,"_26291":1854,"_18309":48690,"_5":12556,"_24913":48647,"_2529":48691},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3023":1870,"_26291":1854,"_18309":48693,"_5":12556,"_24913":48651,"_2529":48694},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3023":1871,"_26291":1854,"_18309":48696,"_5":12556,"_24913":48651,"_2529":48697},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3023":1872,"_26291":1854,"_18309":48699,"_5":12556,"_24913":48651,"_2529":48700},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3023":1873,"_26291":1854,"_18309":48702,"_5":12556,"_24913":48651,"_2529":48703},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3023":1874,"_26291":1854,"_18309":48705,"_5":12556,"_24913":48651,"_2529":48706},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3023":1875,"_26291":1854,"_18309":48708,"_5":12556,"_24913":48651,"_2529":48709},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3023":1876,"_26291":1854,"_18309":48711,"_5":12556,"_24913":48651,"_2529":48712},[],"For browser key generation, follow Issue your first certificate.",{"_3023":1877,"_26291":1854,"_18309":48714,"_5":12556,"_24913":48655,"_2529":48715},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3023":1878,"_26291":1854,"_18309":48717,"_5":12556,"_24913":48659,"_2529":48718},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3023":1879,"_26291":1854,"_18309":48720,"_5":12556,"_24913":48663,"_2529":48721},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3023":1880,"_26291":1854,"_18309":48723,"_5":12556,"_24913":48667,"_2529":48724},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3023":1881,"_26291":1854,"_18309":48726,"_5":12556,"_24913":48667,"_2529":48727},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3023":1882,"_26291":1854,"_18309":48729,"_5":12556,"_24913":48667,"_2529":48730},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3023":1883,"_26291":1854,"_18309":48732,"_5":12556,"_24913":48671,"_2529":48733},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3023":1884,"_26291":1854,"_18309":48735,"_5":12556,"_24913":48671,"_2529":48736},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3023":1885,"_26291":1854,"_18309":48738,"_5":12556,"_24913":48671,"_2529":48739},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3023":1886,"_26291":1854,"_18309":48741,"_5":12556,"_24913":48675,"_2529":48742},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3023":1887,"_26291":1854,"_18309":48744,"_5":12556,"_24913":48675,"_2529":48745},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3023":1888,"_26291":1888,"_5":12871,"_2529":48747,"_26635":48748,"_18309":48750,"_24913":1888},"Certificate lifecycle",[42855,44199,47892,48749],"Concepts",[],{"_3023":1889,"_26291":1888,"_18309":48752,"_5":12556,"_24913":1888,"_2529":48753},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3023":1890,"_26291":1888,"_5":26632,"_18309":48755,"_24913":48756,"_2529":48757},[],"/docs/pr-preview/pr-47/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3023":1891,"_26291":1888,"_5":26632,"_18309":48759,"_24913":48760,"_2529":48761},[],"/docs/pr-preview/pr-47/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3023":1892,"_26291":1888,"_5":26632,"_18309":48763,"_24913":48764,"_2529":48765},[],"/docs/pr-preview/pr-47/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3023":1893,"_26291":1888,"_5":26632,"_18309":48767,"_24913":48768,"_2529":48769},[],"/docs/pr-preview/pr-47/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3023":1894,"_26291":1888,"_5":26632,"_18309":48771,"_24913":48772,"_2529":48773},[],"/docs/pr-preview/pr-47/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3023":1895,"_26291":1888,"_5":26632,"_18309":48775,"_24913":48776,"_2529":48777},[],"/docs/pr-preview/pr-47/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3023":1896,"_26291":1888,"_5":26632,"_18309":48779,"_24913":48780,"_2529":48781},[],"/docs/pr-preview/pr-47/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3023":1897,"_26291":1888,"_5":26632,"_18309":48783,"_24913":48784,"_2529":48785},[],"/docs/pr-preview/pr-47/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3023":1898,"_26291":1888,"_5":26632,"_18309":48787,"_24913":48788,"_2529":48789},[],"/docs/pr-preview/pr-47/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3023":1899,"_26291":1888,"_5":26632,"_18309":48791,"_24913":48792,"_2529":48793},[],"/docs/pr-preview/pr-47/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3023":1900,"_26291":1888,"_18309":48795,"_5":12556,"_24913":1888,"_2529":48796},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3023":1901,"_26291":1888,"_18309":48798,"_5":12556,"_24913":48760,"_2529":48799},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3023":1902,"_26291":1888,"_18309":48801,"_5":12556,"_24913":48764,"_2529":48802},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3023":1903,"_26291":1888,"_18309":48804,"_5":12556,"_24913":48768,"_2529":48805},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3023":1904,"_26291":1888,"_18309":48807,"_5":12556,"_24913":48772,"_2529":48808},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3023":1905,"_26291":1888,"_18309":48810,"_5":12556,"_24913":48776,"_2529":48811},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3023":1906,"_26291":1888,"_18309":48813,"_5":12556,"_24913":48780,"_2529":48814},[],"Lamassu persists four X.509 states:",{"_3023":1907,"_26291":1888,"_18309":48816,"_5":12556,"_24913":48780,"_2529":48817},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3023":1908,"_26291":1888,"_18309":48819,"_5":12556,"_24913":48780,"_2529":48820},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3023":1909,"_26291":1888,"_18309":48822,"_5":12556,"_24913":48780,"_2529":48823},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3023":1910,"_26291":1888,"_18309":48825,"_5":12556,"_24913":48780,"_2529":48826},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3023":1911,"_26291":1888,"_18309":48828,"_5":12556,"_24913":48780,"_2529":48829},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3023":1912,"_26291":1888,"_18309":48831,"_5":12556,"_24913":48784,"_2529":48832},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3023":1913,"_26291":1888,"_18309":48834,"_5":12556,"_24913":48784,"_2529":48835},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3023":1914,"_26291":1888,"_18309":48837,"_5":12556,"_24913":48784,"_2529":48838},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3023":1915,"_26291":1888,"_18309":48840,"_5":12556,"_24913":48788,"_2529":48841},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3023":1916,"_26291":1888,"_18309":48843,"_5":12556,"_24913":48788,"_2529":48844},[],"Before confirming:",{"_3023":1917,"_26291":1888,"_18309":48846,"_5":12556,"_24913":48788,"_2529":48847},[],"Identify DMSs, devices and services that trust that chain.",{"_3023":1918,"_26291":1888,"_18309":48849,"_5":12556,"_24913":48788,"_2529":48850},[],"Distribute the new chain of trust.",{"_3023":1919,"_26291":1888,"_18309":48852,"_5":12556,"_24913":48788,"_2529":48853},[],"Reissue the necessary identities.",{"_3023":1920,"_26291":1888,"_18309":48855,"_5":12556,"_24913":48788,"_2529":48856},[],"Check OCSP and CRL from a real consumer.",{"_3023":1921,"_26291":1888,"_18309":48858,"_5":12556,"_24913":48788,"_2529":48859},[],"Revoke the old CA once no legitimate traffic remains.",{"_3023":1922,"_26291":1888,"_18309":48861,"_5":12556,"_24913":48788,"_2529":48862},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3023":1923,"_26291":1888,"_18309":48864,"_5":12556,"_24913":48792,"_2529":48865},[],"Certificates entering the preventive or critical renewal window.",{"_3023":1924,"_26291":1888,"_18309":48867,"_5":12556,"_24913":48792,"_2529":48868},[],"Repeated enrollment or re-enrollment failures.",{"_3023":1925,"_26291":1888,"_18309":48870,"_5":12556,"_24913":48792,"_2529":48871},[],"Status changes and revocation reasons.",{"_3023":1926,"_26291":1888,"_18309":48873,"_5":12556,"_24913":48792,"_2529":48874},[],"OCSP and CRL publication and validity.",{"_3023":1927,"_26291":1888,"_18309":48876,"_5":12556,"_24913":48792,"_2529":48877},[],"Dependencies still presenting a replaced certificate.",{"_3023":1928,"_26291":1888,"_18309":48879,"_5":12556,"_24913":48792,"_2529":48880},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3023":1929,"_26291":1929,"_5":12871,"_2529":48882,"_26635":48883,"_18309":48884,"_24913":1929},"Trust model",[42855,44199,47892,48749],[],{"_3023":1930,"_26291":1929,"_18309":48886,"_5":12556,"_24913":1929,"_2529":48887},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3023":1931,"_26291":1929,"_5":26632,"_18309":48889,"_24913":48890,"_2529":48891},[],"/docs/pr-preview/pr-47/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3023":1932,"_26291":1929,"_5":26632,"_18309":48893,"_24913":48894,"_2529":48895},[],"/docs/pr-preview/pr-47/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3023":1933,"_26291":1929,"_5":26632,"_18309":48897,"_24913":48898,"_2529":48899},[],"/docs/pr-preview/pr-47/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3023":1934,"_26291":1929,"_5":26632,"_18309":48901,"_24913":48902,"_2529":48903},[],"/docs/pr-preview/pr-47/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3023":1935,"_26291":1929,"_5":26632,"_18309":48905,"_24913":48906,"_2529":48907},[],"/docs/pr-preview/pr-47/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3023":1936,"_26291":1929,"_5":26632,"_18309":48909,"_24913":48910,"_2529":48911},[],"/docs/pr-preview/pr-47/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3023":1937,"_26291":1929,"_5":26632,"_18309":48913,"_24913":48914,"_2529":48915},[],"/docs/pr-preview/pr-47/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3023":1938,"_26291":1929,"_5":26632,"_18309":48917,"_24913":48918,"_2529":48919},[],"/docs/pr-preview/pr-47/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3023":1939,"_26291":1929,"_5":26632,"_18309":48921,"_24913":48922,"_2529":48923},[],"/docs/pr-preview/pr-47/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3023":1940,"_26291":1929,"_5":26632,"_18309":48925,"_24913":48926,"_2529":48927},[],"/docs/pr-preview/pr-47/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3023":1941,"_26291":1929,"_18309":48929,"_5":12556,"_24913":1929,"_2529":48930},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3023":1942,"_26291":1929,"_18309":48932,"_5":12556,"_24913":48894,"_2529":48933},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3023":1943,"_26291":1929,"_18309":48935,"_5":12556,"_24913":48898,"_2529":48936},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3023":1944,"_26291":1929,"_18309":48938,"_5":12556,"_24913":48902,"_2529":48939},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3023":1945,"_26291":1929,"_18309":48941,"_5":12556,"_24913":48906,"_2529":48942},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3023":1946,"_26291":1929,"_18309":48944,"_5":12556,"_24913":48910,"_2529":48945},[],"The device proves it can enroll according to the DMS policy.",{"_3023":1947,"_26291":1929,"_18309":48947,"_5":12556,"_24913":48910,"_2529":48948},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3023":1948,"_26291":1929,"_18309":48950,"_5":12556,"_24913":48910,"_2529":48951},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3023":1949,"_26291":1929,"_18309":48953,"_5":12556,"_24913":48910,"_2529":48954},[],"The device installs the certificate and the chain it needs.",{"_3023":1950,"_26291":1929,"_18309":48956,"_5":12556,"_24913":48910,"_2529":48957},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3023":1951,"_26291":1929,"_18309":48959,"_5":12556,"_24913":48910,"_2529":48960},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3023":1952,"_26291":1929,"_18309":48962,"_5":12556,"_24913":48914,"_2529":48963},[],"A DMS relates three sets that are worth designing separately:",{"_3023":1953,"_26291":1929,"_18309":48965,"_5":12556,"_24913":48914,"_2529":48966},[],"**Enrollment CA:** signs the new identities.",{"_3023":1954,"_26291":1929,"_18309":48968,"_5":12556,"_24913":48914,"_2529":48969},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, Lamassu tries the enrollment CA first and then the validation CAs configured in the re-enrollment block.",{"_3023":1955,"_26291":1929,"_18309":48971,"_5":12556,"_24913":48914,"_2529":48972},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3023":1956,"_26291":1929,"_18309":48974,"_5":12556,"_24913":48914,"_2529":48975},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3023":1957,"_26291":1929,"_18309":48977,"_5":12556,"_24913":48918,"_2529":48978},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3023":1958,"_26291":1929,"_18309":48980,"_5":12556,"_24913":48918,"_2529":48981},[],"that the current date is between `Not Before` and `Not After`;",{"_3023":1959,"_26291":1929,"_18309":48983,"_5":12556,"_24913":48918,"_2529":48984},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3023":1960,"_26291":1929,"_18309":48986,"_5":12556,"_24913":48918,"_2529":48987},[],"that names, SANs and subject match the expected identity;",{"_3023":1961,"_26291":1929,"_18309":48989,"_5":12556,"_24913":48918,"_2529":48990},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3023":1962,"_26291":1929,"_18309":48992,"_5":12556,"_24913":48918,"_2529":48993},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3023":1963,"_26291":1929,"_18309":48995,"_5":12556,"_24913":48918,"_2529":48996},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3023":1964,"_26291":1929,"_18309":48998,"_5":12556,"_24913":48922,"_2529":48999},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3023":1965,"_26291":1929,"_18309":49001,"_5":12556,"_24913":48926,"_2529":49002},[],"Keep the root out of daily operations, or with very restricted access.",{"_3023":1966,"_26291":1929,"_18309":49004,"_5":12556,"_24913":48926,"_2529":49005},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3023":1967,"_26291":1929,"_18309":49007,"_5":12556,"_24913":48926,"_2529":49008},[],"Assign explicit profiles to every use case.",{"_3023":1968,"_26291":1929,"_18309":49010,"_5":12556,"_24913":48926,"_2529":49011},[],"Distribute the new trust before starting a rotation.",{"_3023":1969,"_26291":1929,"_18309":49013,"_5":12556,"_24913":48926,"_2529":49014},[],"Keep enough overlap to renew a disconnected fleet.",{"_3023":1970,"_26291":1929,"_18309":49016,"_5":12556,"_24913":48926,"_2529":49017},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3023":1971,"_26291":1929,"_18309":49019,"_5":12556,"_24913":48926,"_2529":49020},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3023":1972,"_26291":1972,"_5":12871,"_2529":49022,"_26635":49023,"_18309":49024,"_24913":1972},"Revocation lists (CRL)",[42855,44199,47892,48509],[],{"_3023":1973,"_26291":1972,"_18309":49026,"_5":12556,"_24913":1972,"_2529":49027},[],"Generate and distribute signed lists to validate certificates offline.",{"_3023":1974,"_26291":1972,"_5":26632,"_18309":49029,"_24913":49030,"_2529":49031},[],"/docs/pr-preview/pr-47/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_3023":1975,"_26291":1972,"_5":26632,"_18309":49033,"_24913":49034,"_2529":49035},[],"/docs/pr-preview/pr-47/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3023":1976,"_26291":1972,"_5":26632,"_18309":49037,"_24913":49038,"_2529":49039},[],"/docs/pr-preview/pr-47/platform/pki/crl#crl-contents","CRL contents",{"_3023":1977,"_26291":1972,"_5":26632,"_18309":49041,"_24913":49042,"_2529":49043},[],"/docs/pr-preview/pr-47/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3023":1978,"_26291":1972,"_5":26632,"_18309":49045,"_24913":49046,"_2529":49047},[],"/docs/pr-preview/pr-47/platform/pki/crl#va-role-management-api","VA role management API",{"_3023":1979,"_26291":1972,"_5":26632,"_18309":49049,"_24913":49050,"_2529":49051},[],"/docs/pr-preview/pr-47/platform/pki/crl#from-the-interface","From the interface",{"_3023":1980,"_26291":1972,"_5":26632,"_18309":49053,"_24913":49054,"_2529":49055},[],"/docs/pr-preview/pr-47/platform/pki/crl#references","References",{"_3023":1981,"_26291":1972,"_18309":49057,"_5":12556,"_24913":1972,"_2529":49058},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3023":1982,"_26291":1972,"_18309":49060,"_5":12556,"_24913":49030,"_2529":49061},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3023":1983,"_26291":1972,"_18309":49063,"_5":12556,"_24913":49030,"_2529":49064},[],"`crl_options` field",{"_3023":1984,"_26291":1972,"_18309":49066,"_5":12556,"_24913":49030,"_2529":43238},[],{"_3023":1985,"_26291":1972,"_18309":49068,"_5":12556,"_24913":49030,"_2529":49069},[],"Backend initial value",{"_3023":1986,"_26291":1972,"_18309":49071,"_5":12556,"_24913":49030,"_2529":49072},[],"`validity`",{"_3023":1987,"_26291":1972,"_18309":49074,"_5":12556,"_24913":49030,"_2529":49075},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3023":1988,"_26291":1972,"_18309":49077,"_5":12556,"_24913":49030,"_2529":49078},[],"7 days.",{"_3023":1989,"_26291":1972,"_18309":49080,"_5":12556,"_24913":49030,"_2529":49081},[],"`refresh_interval`",{"_3023":1990,"_26291":1972,"_18309":49083,"_5":12556,"_24913":49030,"_2529":49084},[],"Time since publication that triggers scheduled renewal.",{"_3023":1991,"_26291":1972,"_18309":49086,"_5":12556,"_24913":49030,"_2529":49087},[],"6 days and 23 hours.",{"_3023":1992,"_26291":1972,"_18309":49089,"_5":12556,"_24913":49030,"_2529":49090},[],"`regenerate_on_revoke`",{"_3023":1993,"_26291":1972,"_18309":49092,"_5":12556,"_24913":49030,"_2529":49093},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3023":1994,"_26291":1972,"_18309":49095,"_5":12556,"_24913":49030,"_2529":49096},[],"`true`.",{"_3023":1995,"_26291":1972,"_18309":49098,"_5":12556,"_24913":49030,"_2529":49099},[],"`subject_key_id_signer`",{"_3023":1996,"_26291":1972,"_18309":49101,"_5":12556,"_24913":49030,"_2529":49102},[],"Configuration field initialized with the CA’s SKI.",{"_3023":1997,"_26291":1972,"_18309":49104,"_5":12556,"_24913":49030,"_2529":49105},[],"CA SKI.",{"_3023":1998,"_26291":1972,"_18309":49107,"_5":12556,"_24913":49030,"_2529":49108},[],"The generator uses the key of the CA identified by the requested SKI. Do not interpret `subject_key_id_signer` as verified support for a different delegated CA: changing that field does not change the signer in this flow.",{"_3023":1999,"_26291":1972,"_18309":49110,"_5":12556,"_24913":49030,"_2529":49111},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_3023":2000,"_26291":1972,"_18309":49113,"_5":12556,"_24913":49034,"_2529":49114},[],"The scheduled job requests another list when `refresh_interval` is reached or when the list approaches expiration within the configured watch period. This depends on working jobs, storage and signing; it does not guarantee renewal during a service failure.",{"_3023":2001,"_26291":1972,"_18309":49116,"_5":12556,"_24913":49034,"_2529":49117},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3023":2002,"_26291":1972,"_18309":49119,"_5":12556,"_24913":49034,"_2529":49120},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3023":2003,"_26291":1972,"_18309":49122,"_5":12556,"_24913":49038,"_2529":49123},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3023":2004,"_26291":1972,"_18309":49125,"_5":12556,"_24913":49038,"_2529":49126},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3023":2005,"_26291":1972,"_18309":49128,"_5":12556,"_24913":49042,"_2529":49129},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_3023":2006,"_26291":1972,"_18309":49131,"_5":12556,"_24913":49042,"_2529":49132},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3023":2007,"_26291":1972,"_18309":49134,"_5":12556,"_24913":49042,"_2529":49135},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3023":2008,"_26291":1972,"_18309":49137,"_5":12556,"_24913":49042,"_2529":49138},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3023":2009,"_26291":1972,"_18309":49140,"_5":12556,"_24913":49042,"_2529":49141},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3023":2010,"_26291":1972,"_18309":49143,"_5":12556,"_24913":49046,"_2529":49144},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3023":2011,"_26291":1972,"_18309":49146,"_5":12556,"_24913":49046,"_2529":45923},[],{"_3023":2012,"_26291":1972,"_18309":49148,"_5":12556,"_24913":49046,"_2529":49149},[],"Relative path",{"_3023":2013,"_26291":1972,"_18309":49151,"_5":12556,"_24913":49046,"_2529":45920},[],{"_3023":2014,"_26291":1972,"_18309":49153,"_5":12556,"_24913":49046,"_2529":49154},[],"`GET`",{"_3023":2015,"_26291":1972,"_18309":49156,"_5":12556,"_24913":49046,"_2529":49157},[],"`/v1/roles/{ca-ski}`",{"_3023":2016,"_26291":1972,"_18309":49159,"_5":12556,"_24913":49046,"_2529":49160},[],"Read `crl_options` and `latest_crl`.",{"_3023":2017,"_26291":1972,"_18309":49162,"_5":12556,"_24913":49046,"_2529":49163},[],"`PUT`",{"_3023":2018,"_26291":1972,"_18309":49165,"_5":12556,"_24913":49046,"_2529":49157},[],{"_3023":2019,"_26291":1972,"_18309":49167,"_5":12556,"_24913":49046,"_2529":49168},[],"Replace CRL configuration.",{"_3023":2020,"_26291":1972,"_18309":49170,"_5":12556,"_24913":49046,"_2529":49171},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_3023":2021,"_26291":1972,"_18309":49173,"_5":12556,"_24913":49046,"_2529":49174},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_3023":2022,"_26291":1972,"_18309":49176,"_5":12556,"_24913":49050,"_2529":49177},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_3023":2023,"_26291":1972,"_18309":49179,"_5":12556,"_24913":49054,"_2529":49180},[],"RFC 5280: X.509 and CRL profile.",{"_3023":2024,"_26291":1972,"_18309":49182,"_5":12556,"_24913":49054,"_2529":49183},[],"OpenSSL: openssl-crl.",{"_3023":2025,"_26291":1972,"_18309":49185,"_5":12556,"_24913":49054,"_2529":49186},[],"OpenSSL: openssl-verify.",{"_3023":2026,"_26291":1972,"_18309":49188,"_5":12556,"_24913":49054,"_2529":49189},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3023":2027,"_26291":1972,"_18309":49191,"_5":12556,"_24913":49054,"_2529":49192},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3023":2028,"_26291":2028,"_5":12871,"_2529":49194,"_26635":49195,"_18309":49196,"_24913":2028},"Keys and cryptographic engines",[42855,44199,47892,47893],[],{"_3023":2029,"_26291":2028,"_18309":49198,"_5":12556,"_24913":2028,"_2529":49199},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3023":2030,"_26291":2028,"_5":26632,"_18309":49201,"_24913":49202,"_2529":49203},[],"/docs/pr-preview/pr-47/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3023":2031,"_26291":2028,"_5":26632,"_18309":49205,"_24913":49206,"_2529":49207},[],"/docs/pr-preview/pr-47/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3023":2032,"_26291":2028,"_5":26632,"_18309":49209,"_24913":49210,"_2529":49211},[],"/docs/pr-preview/pr-47/platform/pki/key-management#file-system","File System",{"_3023":2033,"_26291":2028,"_5":26632,"_18309":49213,"_24913":49214,"_2529":49215},[],"/docs/pr-preview/pr-47/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3023":2034,"_26291":2028,"_5":26632,"_18309":49217,"_24913":49218,"_2529":49219},[],"/docs/pr-preview/pr-47/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3023":2035,"_26291":2028,"_5":26632,"_18309":49221,"_24913":49222,"_2529":49223},[],"/docs/pr-preview/pr-47/platform/pki/key-management#aws-kms","AWS KMS",{"_3023":2036,"_26291":2028,"_5":26632,"_18309":49225,"_24913":49226,"_2529":49227},[],"/docs/pr-preview/pr-47/platform/pki/key-management#pkcs11","PKCS#11",{"_3023":2037,"_26291":2028,"_5":26632,"_18309":49229,"_24913":49230,"_2529":49231},[],"/docs/pr-preview/pr-47/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3023":2038,"_26291":2028,"_5":26632,"_18309":49233,"_24913":49234,"_2529":49235},[],"/docs/pr-preview/pr-47/platform/pki/key-management#key-inventory","Key inventory",{"_3023":2039,"_26291":2028,"_5":26632,"_18309":49237,"_24913":49238,"_2529":49239},[],"/docs/pr-preview/pr-47/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3023":2040,"_26291":2028,"_5":26632,"_18309":49241,"_24913":49242,"_2529":49243},[],"/docs/pr-preview/pr-47/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3023":2041,"_26291":2028,"_5":26632,"_18309":49245,"_24913":49246,"_2529":49247},[],"/docs/pr-preview/pr-47/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3023":2042,"_26291":2028,"_5":26632,"_18309":49249,"_24913":49250,"_2529":49251},[],"/docs/pr-preview/pr-47/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3023":2043,"_26291":2028,"_5":26632,"_18309":49253,"_24913":49254,"_2529":49255},[],"/docs/pr-preview/pr-47/platform/pki/key-management#view-details","View details",{"_3023":2044,"_26291":2028,"_5":26632,"_18309":49257,"_24913":49258,"_2529":49259},[],"/docs/pr-preview/pr-47/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3023":2045,"_26291":2028,"_5":26632,"_18309":49261,"_24913":49262,"_2529":49263},[],"/docs/pr-preview/pr-47/platform/pki/key-management#sign","Sign",{"_3023":2046,"_26291":2028,"_5":26632,"_18309":49265,"_24913":49266,"_2529":49267},[],"/docs/pr-preview/pr-47/platform/pki/key-management#verify","Verify",{"_3023":2047,"_26291":2028,"_5":26632,"_18309":49269,"_24913":49270,"_2529":49271},[],"/docs/pr-preview/pr-47/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3023":2048,"_26291":2028,"_5":26632,"_18309":49273,"_24913":49274,"_2529":49275},[],"/docs/pr-preview/pr-47/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3023":2049,"_26291":2028,"_5":26632,"_18309":49277,"_24913":49278,"_2529":49279},[],"/docs/pr-preview/pr-47/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3023":2050,"_26291":2028,"_18309":49281,"_5":12556,"_24913":2028,"_2529":49282},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3023":2051,"_26291":2028,"_18309":49284,"_5":12556,"_24913":2028,"_2529":49285},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3023":2052,"_26291":2028,"_18309":49287,"_5":12556,"_24913":49202,"_2529":49288},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3023":2053,"_26291":2028,"_18309":49290,"_5":12556,"_24913":49202,"_2529":49291},[],"In practice, it lets you:",{"_3023":2054,"_26291":2028,"_18309":49293,"_5":12556,"_24913":49202,"_2529":49294},[],"Generate new key pairs from Lamassu IoT.",{"_3023":2055,"_26291":2028,"_18309":49296,"_5":12556,"_24913":49202,"_2529":49297},[],"Import keys created externally.",{"_3023":2056,"_26291":2028,"_18309":49299,"_5":12556,"_24913":49202,"_2529":49300},[],"Delegate custody and cryptographic operations to external engines.",{"_3023":2057,"_26291":2028,"_18309":49302,"_5":12556,"_24913":49202,"_2529":49303},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3023":2058,"_26291":2028,"_18309":49305,"_5":12556,"_24913":49206,"_2529":49306},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3023":2059,"_26291":2028,"_18309":49308,"_5":12556,"_24913":49206,"_2529":49309},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3023":2060,"_26291":2028,"_18309":49311,"_5":12556,"_24913":49206,"_2529":49312},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3023":2061,"_26291":2028,"_18309":49314,"_5":12556,"_24913":49210,"_2529":49315},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3023":2062,"_26291":2028,"_18309":49317,"_5":12556,"_24913":49214,"_2529":49318},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3023":2063,"_26291":2028,"_18309":49320,"_5":12556,"_24913":49218,"_2529":49321},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3023":2064,"_26291":2028,"_18309":49323,"_5":12556,"_24913":49222,"_2529":49324},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3023":2065,"_26291":2028,"_18309":49326,"_5":12556,"_24913":49226,"_2529":49327},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3023":2066,"_26291":2028,"_18309":49329,"_5":12556,"_24913":49230,"_2529":49330},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3023":2067,"_26291":2028,"_18309":49332,"_5":12556,"_24913":49230,"_2529":49333},[],"Lamassu shows the enabled engines in the console.",{"_3023":2068,"_26291":2028,"_18309":49335,"_5":12556,"_24913":49230,"_2529":49336},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3023":2069,"_26291":2028,"_18309":49338,"_5":12556,"_24913":49230,"_2529":49339},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3023":2070,"_26291":2028,"_18309":49341,"_5":12556,"_24913":49234,"_2529":49342},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3023":2071,"_26291":2028,"_18309":49344,"_5":12556,"_24913":49234,"_2529":49345},[],"The table includes the following fields:",{"_3023":2072,"_26291":2028,"_18309":49347,"_5":12556,"_24913":49234,"_2529":49348},[],"**Name**: descriptive name of the key.",{"_3023":2073,"_26291":2028,"_18309":49350,"_5":12556,"_24913":49234,"_2529":49351},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3023":2074,"_26291":2028,"_18309":49353,"_5":12556,"_24913":49234,"_2529":49354},[],"**Strength**: visual indicator of cryptographic strength.",{"_3023":2075,"_26291":2028,"_18309":49356,"_5":12556,"_24913":49234,"_2529":49357},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3023":2076,"_26291":2028,"_18309":49359,"_5":12556,"_24913":49234,"_2529":49360},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3023":2077,"_26291":2028,"_18309":49362,"_5":12556,"_24913":49234,"_2529":49363},[],"**Aliases**: alternative names associated with the key.",{"_3023":2078,"_26291":2028,"_18309":49365,"_5":12556,"_24913":49234,"_2529":49366},[],"**Tags**: labels for classification and search.",{"_3023":2079,"_26291":2028,"_18309":49368,"_5":12556,"_24913":49234,"_2529":49369},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3023":2080,"_26291":2028,"_18309":49371,"_5":12556,"_24913":49234,"_2529":49372},[],"From this view you also reach the most common actions:",{"_3023":2081,"_26291":2028,"_18309":49374,"_5":12556,"_24913":49234,"_2529":49375},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3023":2082,"_26291":2028,"_18309":49377,"_5":12556,"_24913":49234,"_2529":49378},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3023":2083,"_26291":2028,"_18309":49380,"_5":12556,"_24913":49234,"_2529":49381},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3023":2084,"_26291":2028,"_18309":49383,"_5":12556,"_24913":49234,"_2529":49384},[],"**Delete Key** to remove the key from the system.",{"_3023":2085,"_26291":2028,"_18309":49386,"_5":12556,"_24913":49238,"_2529":49387},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3023":2086,"_26291":2028,"_18309":49389,"_5":12556,"_24913":49242,"_2529":49390},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3023":2087,"_26291":2028,"_18309":49392,"_5":12556,"_24913":49242,"_2529":49393},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3023":2088,"_26291":2028,"_18309":49395,"_5":12556,"_24913":49242,"_2529":49396},[],"**Key Name**: unique and descriptive name.",{"_3023":2089,"_26291":2028,"_18309":49398,"_5":12556,"_24913":49242,"_2529":49399},[],"**Crypto Engine**: engine that will keep the key.",{"_3023":2090,"_26291":2028,"_18309":49401,"_5":12556,"_24913":49242,"_2529":49402},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3023":2091,"_26291":2028,"_18309":49404,"_5":12556,"_24913":49242,"_2529":49405},[],"**Tags**: metadata to classify the key.",{"_3023":2092,"_26291":2028,"_18309":49407,"_5":12556,"_24913":49242,"_2529":49408},[],"**Metadata**: additional information for advanced uses.",{"_3023":2093,"_26291":2028,"_18309":49410,"_5":12556,"_24913":49246,"_2529":49411},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3023":2094,"_26291":2028,"_18309":49413,"_5":12556,"_24913":49246,"_2529":49414},[],"When you have an exportable private key and the destination engine supports import.",{"_3023":2095,"_26291":2028,"_18309":49416,"_5":12556,"_24913":49246,"_2529":49417},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3023":2096,"_26291":2028,"_18309":49419,"_5":12556,"_24913":49246,"_2529":49420},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3023":2097,"_26291":2028,"_18309":49422,"_5":12556,"_24913":49246,"_2529":49423},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3023":2098,"_26291":2028,"_18309":49425,"_5":12556,"_24913":49246,"_2529":49426},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3023":2099,"_26291":2028,"_18309":49428,"_5":12556,"_24913":49246,"_2529":49429},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3023":2100,"_26291":2028,"_18309":49431,"_5":12556,"_24913":49246,"_2529":49432},[],"**Tags**: labels for organization and search.",{"_3023":2101,"_26291":2028,"_18309":49434,"_5":12556,"_24913":49246,"_2529":49435},[],"**Metadata**: additional optional information.",{"_3023":2102,"_26291":2028,"_18309":49437,"_5":12556,"_24913":49246,"_2529":49438},[],"**Private Key (PEM)**: private key in PEM format.",{"_3023":2103,"_26291":2028,"_18309":49440,"_5":12556,"_24913":49246,"_2529":49441},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3023":2104,"_26291":2028,"_18309":49443,"_5":12556,"_24913":49250,"_2529":49444},[],"Each registered key has a detail view and several operational actions.",{"_3023":2105,"_26291":2028,"_18309":49446,"_5":12556,"_24913":49254,"_2529":49447},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3023":2106,"_26291":2028,"_18309":49449,"_5":12556,"_24913":49254,"_2529":49450},[],"The **Overview** tab shows, among others, these fields:",{"_3023":2107,"_26291":2028,"_18309":49452,"_5":12556,"_24913":49254,"_2529":49453},[],"**Key Name**: descriptive name.",{"_3023":2108,"_26291":2028,"_18309":49455,"_5":12556,"_24913":49254,"_2529":49456},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3023":2109,"_26291":2028,"_18309":49458,"_5":12556,"_24913":49254,"_2529":49459},[],"**Tags**: associated labels.",{"_3023":2110,"_26291":2028,"_18309":49461,"_5":12556,"_24913":49254,"_2529":49462},[],"**Aliases**: alternative names.",{"_3023":2111,"_26291":2028,"_18309":49464,"_5":12556,"_24913":49254,"_2529":49465},[],"**Crypto Engine**: engine where the key resides.",{"_3023":2112,"_26291":2028,"_18309":49467,"_5":12556,"_24913":49254,"_2529":49468},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3023":2113,"_26291":2028,"_18309":49470,"_5":12556,"_24913":49254,"_2529":49471},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3023":2114,"_26291":2028,"_18309":49473,"_5":12556,"_24913":49254,"_2529":49474},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3023":2115,"_26291":2028,"_18309":49476,"_5":12556,"_24913":49258,"_2529":49477},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3023":2116,"_26291":2028,"_18309":49479,"_5":12556,"_24913":49258,"_2529":49480},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3023":2117,"_26291":2028,"_18309":49482,"_5":12556,"_24913":49258,"_2529":49483},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3023":2118,"_26291":2028,"_18309":49485,"_5":12556,"_24913":49262,"_2529":49486},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3023":2119,"_26291":2028,"_18309":49488,"_5":12556,"_24913":49262,"_2529":49489},[],"Main fields:",{"_3023":2120,"_26291":2028,"_18309":49491,"_5":12556,"_24913":49262,"_2529":49492},[],"**Algorithm**: signing algorithm available for the key type.",{"_3023":2121,"_26291":2028,"_18309":49494,"_5":12556,"_24913":49262,"_2529":49495},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3023":2122,"_26291":2028,"_18309":49497,"_5":12556,"_24913":49262,"_2529":49498},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3023":2123,"_26291":2028,"_18309":49500,"_5":12556,"_24913":49262,"_2529":49501},[],"**Message**: content to sign.",{"_3023":2124,"_26291":2028,"_18309":49503,"_5":12556,"_24913":49262,"_2529":49504},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3023":2125,"_26291":2028,"_18309":49506,"_5":12556,"_24913":49266,"_2529":49507},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3023":2126,"_26291":2028,"_18309":49509,"_5":12556,"_24913":49266,"_2529":49489},[],{"_3023":2127,"_26291":2028,"_18309":49511,"_5":12556,"_24913":49266,"_2529":49512},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3023":2128,"_26291":2028,"_18309":49514,"_5":12556,"_24913":49266,"_2529":49515},[],"**Message Type**: `Raw` or `Digest`.",{"_3023":2129,"_26291":2028,"_18309":49517,"_5":12556,"_24913":49266,"_2529":49518},[],"**Payload Encoding**: encoding of the message.",{"_3023":2130,"_26291":2028,"_18309":49520,"_5":12556,"_24913":49266,"_2529":49521},[],"**Message**: original message or hash.",{"_3023":2131,"_26291":2028,"_18309":49523,"_5":12556,"_24913":49266,"_2529":49524},[],"**Signature**: signature to check.",{"_3023":2132,"_26291":2028,"_18309":49526,"_5":12556,"_24913":49266,"_2529":49527},[],"**Result**: indicator of the validation result.",{"_3023":2133,"_26291":2028,"_18309":49529,"_5":12556,"_24913":49270,"_2529":49530},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3023":2134,"_26291":2028,"_18309":49532,"_5":12556,"_24913":49270,"_2529":49533},[],"This flow is useful for:",{"_3023":2135,"_26291":2028,"_18309":49535,"_5":12556,"_24913":49270,"_2529":49536},[],"Requesting certificates from an external CA.",{"_3023":2136,"_26291":2028,"_18309":49538,"_5":12556,"_24913":49270,"_2529":49539},[],"Renewing an identity while keeping the same key.",{"_3023":2137,"_26291":2028,"_18309":49541,"_5":12556,"_24913":49270,"_2529":49542},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3023":2138,"_26291":2028,"_18309":49544,"_5":12556,"_24913":49270,"_2529":49545},[],"**Common Name (CN)**: main name of the identity.",{"_3023":2139,"_26291":2028,"_18309":49547,"_5":12556,"_24913":49270,"_2529":49548},[],"**Organization (O)**: organization or company.",{"_3023":2140,"_26291":2028,"_18309":49550,"_5":12556,"_24913":49270,"_2529":49551},[],"**Organizational Unit (OU)**: department or unit.",{"_3023":2141,"_26291":2028,"_18309":49553,"_5":12556,"_24913":49270,"_2529":49554},[],"**Country (C)**: two-letter country code.",{"_3023":2142,"_26291":2028,"_18309":49556,"_5":12556,"_24913":49270,"_2529":49557},[],"**State / Province (ST)**: state or province.",{"_3023":2143,"_26291":2028,"_18309":49559,"_5":12556,"_24913":49270,"_2529":49560},[],"**Locality (L)**: city or locality.",{"_3023":2144,"_26291":2028,"_18309":49562,"_5":12556,"_24913":49270,"_2529":49563},[],"**Email Address**: contact email.",{"_3023":2145,"_26291":2028,"_18309":49565,"_5":12556,"_24913":49270,"_2529":49566},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3023":2146,"_26291":2028,"_18309":49568,"_5":12556,"_24913":49270,"_2529":49569},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3023":2147,"_26291":2028,"_18309":49571,"_5":12556,"_24913":49274,"_2529":49572},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3023":2148,"_26291":2028,"_18309":49574,"_5":12556,"_24913":49274,"_2529":49575},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3023":2149,"_26291":2028,"_18309":49577,"_5":12556,"_24913":49278,"_2529":49578},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3023":2150,"_26291":2150,"_5":12871,"_2529":49580,"_26635":49581,"_18309":49582,"_24913":2150},"Online validation with OCSP",[42855,44199,47892,48509],[],{"_3023":2151,"_26291":2150,"_18309":49584,"_5":12556,"_24913":2150,"_2529":49585},[],"Query signed status and verify the responder’s response.",{"_3023":2152,"_26291":2150,"_5":26632,"_18309":49587,"_24913":49588,"_2529":49589},[],"/docs/pr-preview/pr-47/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3023":2153,"_26291":2150,"_5":26632,"_18309":49591,"_24913":49592,"_2529":49593},[],"/docs/pr-preview/pr-47/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3023":2154,"_26291":2150,"_5":26632,"_18309":49595,"_24913":49596,"_2529":49597},[],"/docs/pr-preview/pr-47/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3023":2155,"_26291":2150,"_5":26632,"_18309":49599,"_24913":49600,"_2529":49601},[],"/docs/pr-preview/pr-47/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3023":2156,"_26291":2150,"_5":26632,"_18309":49603,"_24913":49604,"_2529":49605},[],"/docs/pr-preview/pr-47/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3023":2157,"_26291":2150,"_5":26632,"_18309":49607,"_24913":49608,"_2529":49055},[],"/docs/pr-preview/pr-47/platform/pki/ocsp#references",{"_3023":2158,"_26291":2150,"_18309":49610,"_5":12556,"_24913":2150,"_2529":49611},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3023":2159,"_26291":2150,"_18309":49613,"_5":12556,"_24913":49588,"_2529":49614},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3023":2160,"_26291":2150,"_18309":49616,"_5":12556,"_24913":49588,"_2529":49617},[],"Record status",{"_3023":2161,"_26291":2150,"_18309":49619,"_5":12556,"_24913":49588,"_2529":49620},[],"Signed response",{"_3023":2162,"_26291":2150,"_18309":49622,"_5":12556,"_24913":49588,"_2529":47070},[],{"_3023":2163,"_26291":2150,"_18309":49624,"_5":12556,"_24913":49588,"_2529":49625},[],"`Good`.",{"_3023":2164,"_26291":2150,"_18309":49627,"_5":12556,"_24913":49588,"_2529":47087},[],{"_3023":2165,"_26291":2150,"_18309":49629,"_5":12556,"_24913":49588,"_2529":49630},[],"`Revoked`, with revocation reason and timestamp.",{"_3023":2166,"_26291":2150,"_18309":49632,"_5":12556,"_24913":49588,"_2529":49633},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3023":2167,"_26291":2150,"_18309":49635,"_5":12556,"_24913":49588,"_2529":49636},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3023":2168,"_26291":2150,"_18309":49638,"_5":12556,"_24913":49588,"_2529":49639},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3023":2169,"_26291":2150,"_18309":49641,"_5":12556,"_24913":49588,"_2529":49642},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3023":2170,"_26291":2150,"_18309":49644,"_5":12556,"_24913":49588,"_2529":49645},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3023":2171,"_26291":2150,"_18309":49647,"_5":12556,"_24913":49592,"_2529":49648},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3023":2172,"_26291":2150,"_18309":49650,"_5":12556,"_24913":49592,"_2529":49651},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3023":2173,"_26291":2150,"_18309":49653,"_5":12556,"_24913":49596,"_2529":49654},[],"The service accepts:",{"_3023":2174,"_26291":2150,"_18309":49656,"_5":12556,"_24913":49596,"_2529":45923},[],{"_3023":2175,"_26291":2150,"_18309":49658,"_5":12556,"_24913":49596,"_2529":49659},[],"VA service path",{"_3023":2176,"_26291":2150,"_18309":49661,"_5":12556,"_24913":49596,"_2529":49662},[],"Format",{"_3023":2177,"_26291":2150,"_18309":49664,"_5":12556,"_24913":49596,"_2529":49665},[],"`POST`",{"_3023":2178,"_26291":2150,"_18309":49667,"_5":12556,"_24913":49596,"_2529":49668},[],"`/ocsp`",{"_3023":2179,"_26291":2150,"_18309":49670,"_5":12556,"_24913":49596,"_2529":49671},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3023":2180,"_26291":2150,"_18309":49673,"_5":12556,"_24913":49596,"_2529":49154},[],{"_3023":2181,"_26291":2150,"_18309":49675,"_5":12556,"_24913":49596,"_2529":49676},[],"`/ocsp/{ocsp_request}`",{"_3023":2182,"_26291":2150,"_18309":49678,"_5":12556,"_24913":49596,"_2529":49679},[],"DER request encoded using padded URL Base64.",{"_3023":2183,"_26291":2150,"_18309":49681,"_5":12556,"_24913":49596,"_2529":49682},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3023":2184,"_26291":2150,"_18309":49684,"_5":12556,"_24913":49600,"_2529":49685},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3023":2185,"_26291":2150,"_18309":49687,"_5":12556,"_24913":49600,"_2529":49688},[],"Generate the request:",{"_3023":2186,"_26291":2150,"_18309":49690,"_5":12556,"_24913":49600,"_2529":49691},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3023":2187,"_26291":2150,"_18309":49693,"_5":12556,"_24913":49600,"_2529":49694},[],"Replace the example URL with the inspected endpoint:",{"_3023":2188,"_26291":2150,"_18309":49696,"_5":12556,"_24913":49600,"_2529":49697},[],"Verify the returned DER:",{"_3023":2189,"_26291":2150,"_18309":49699,"_5":12556,"_24913":49600,"_2529":49700},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3023":2190,"_26291":2150,"_18309":49702,"_5":12556,"_24913":49604,"_2529":49703},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3023":2191,"_26291":2150,"_18309":49705,"_5":12556,"_24913":49604,"_2529":49706},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3023":2192,"_26291":2150,"_18309":49708,"_5":12556,"_24913":49608,"_2529":49709},[],"RFC 6960: OCSP.",{"_3023":2193,"_26291":2150,"_18309":49711,"_5":12556,"_24913":49608,"_2529":49712},[],"OpenSSL: openssl-ocsp.",{"_3023":2194,"_26291":2150,"_18309":49714,"_5":12556,"_24913":49608,"_2529":49715},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3023":2195,"_26291":2150,"_18309":49717,"_5":12556,"_24913":49608,"_2529":49192},[],{"_3023":2196,"_26291":2196,"_5":12871,"_2529":47892,"_26635":49719,"_18309":49720,"_24913":2196},[42855,44199,47892],[],{"_3023":2197,"_26291":2196,"_18309":49722,"_5":12556,"_24913":2196,"_2529":49723},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3023":2198,"_26291":2196,"_5":26632,"_18309":49725,"_24913":49726,"_2529":47202},[],"/docs/pr-preview/pr-47/platform/pki/overview#start-here",{"_3023":2199,"_26291":2196,"_5":26632,"_18309":49728,"_24913":49729,"_2529":49730},[],"/docs/pr-preview/pr-47/platform/pki/overview#what-you-need","What you need",{"_3023":2200,"_26291":2196,"_5":26632,"_18309":49732,"_24913":49733,"_2529":47736},[],"/docs/pr-preview/pr-47/platform/pki/overview#core-capabilities",{"_3023":2201,"_26291":2196,"_5":26632,"_18309":49735,"_24913":49736,"_2529":47740},[],"/docs/pr-preview/pr-47/platform/pki/overview#build-your-trust-hierarchy",{"_3023":2202,"_26291":2196,"_5":26632,"_18309":49738,"_24913":49739,"_2529":47744},[],"/docs/pr-preview/pr-47/platform/pki/overview#protect-cryptographic-keys",{"_3023":2203,"_26291":2196,"_5":26632,"_18309":49741,"_24913":49742,"_2529":47748},[],"/docs/pr-preview/pr-47/platform/pki/overview#issue-and-control-certificates",{"_3023":2204,"_26291":2196,"_5":26632,"_18309":49744,"_24913":49745,"_2529":47756},[],"/docs/pr-preview/pr-47/platform/pki/overview#publish-validation-status",{"_3023":2205,"_26291":2196,"_5":26632,"_18309":49747,"_24913":49748,"_2529":49749},[],"/docs/pr-preview/pr-47/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3023":2206,"_26291":2196,"_5":26632,"_18309":49751,"_24913":49752,"_2529":48676},[],"/docs/pr-preview/pr-47/platform/pki/overview#continue",{"_3023":2207,"_26291":2196,"_18309":49754,"_5":12556,"_24913":2196,"_2529":49755},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3023":2208,"_26291":2196,"_18309":49757,"_5":12556,"_24913":49726,"_2529":49758},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3023":2209,"_26291":2196,"_18309":49760,"_5":12556,"_24913":49726,"_2529":49761},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3023":2210,"_26291":2196,"_18309":49763,"_5":12556,"_24913":49729,"_2529":49764},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3023":2211,"_26291":2196,"_18309":49766,"_5":12556,"_24913":49729,"_2529":49767},[],"An available cryptographic engine to keep the authority's key.",{"_3023":2212,"_26291":2196,"_18309":49769,"_5":12556,"_24913":49729,"_2529":49770},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3023":2213,"_26291":2196,"_18309":49772,"_5":12556,"_24913":49729,"_2529":49773},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3023":2214,"_26291":2196,"_18309":49775,"_5":12556,"_24913":49729,"_2529":49776},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3023":2215,"_26291":2196,"_18309":49778,"_5":12556,"_24913":49736,"_2529":49779},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3023":2216,"_26291":2196,"_18309":49781,"_5":12556,"_24913":49739,"_2529":49782},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3023":2217,"_26291":2196,"_18309":49784,"_5":12556,"_24913":49742,"_2529":49785},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3023":2218,"_26291":2196,"_18309":49787,"_5":12556,"_24913":49745,"_2529":49788},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3023":2219,"_26291":2196,"_18309":49790,"_5":12556,"_24913":49748,"_2529":49791},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3023":2220,"_26291":2196,"_18309":49793,"_5":12556,"_24913":49748,"_2529":49794},[],"its subject and extensions identify the expected client;",{"_3023":2221,"_26291":2196,"_18309":49796,"_5":12556,"_24913":49748,"_2529":49797},[],"its public key matches the client's private key;",{"_3023":2222,"_26291":2196,"_18309":49799,"_5":12556,"_24913":49748,"_2529":49800},[],"its chain reaches a root trusted by the consumer;",{"_3023":2223,"_26291":2196,"_18309":49802,"_5":12556,"_24913":49748,"_2529":49803},[],"its dates and usages allow the operation;",{"_3023":2224,"_26291":2196,"_18309":49805,"_5":12556,"_24913":49748,"_2529":49806},[],"the consumer applies revocation checks and authorization.",{"_3023":2225,"_26291":2196,"_18309":49808,"_5":12556,"_24913":49748,"_2529":49809},[],"The issuance path includes the first independent checks.",{"_3023":2226,"_26291":2196,"_18309":49811,"_5":12556,"_24913":49752,"_2529":49812},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3023":2227,"_26291":2196,"_18309":49814,"_5":12556,"_24913":49752,"_2529":49815},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3023":2228,"_26291":2196,"_18309":49817,"_5":12556,"_24913":49752,"_2529":49818},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3023":2229,"_26291":2229,"_5":12871,"_2529":49820,"_26635":49821,"_18309":49822,"_24913":2229},"Create your first CA",[42855,44199,47892,47327],[],{"_3023":2230,"_26291":2229,"_18309":49824,"_5":12556,"_24913":2229,"_2529":49825},[],"Create an evaluation root and check its certificate before issuing.",{"_3023":2231,"_26291":2229,"_5":26632,"_18309":49827,"_24913":49828,"_2529":42865},[],"/docs/pr-preview/pr-47/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3023":2232,"_26291":2229,"_5":26632,"_18309":49830,"_24913":49831,"_2529":49832},[],"/docs/pr-preview/pr-47/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_3023":2233,"_26291":2229,"_5":26632,"_18309":49834,"_24913":49835,"_2529":49836},[],"/docs/pr-preview/pr-47/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_3023":2234,"_26291":2229,"_5":26632,"_18309":49838,"_24913":49839,"_2529":49840},[],"/docs/pr-preview/pr-47/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_3023":2235,"_26291":2229,"_5":26632,"_18309":49842,"_24913":49843,"_2529":49844},[],"/docs/pr-preview/pr-47/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_3023":2236,"_26291":2229,"_5":26632,"_18309":49846,"_24913":49847,"_2529":49848},[],"/docs/pr-preview/pr-47/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_3023":2237,"_26291":2229,"_5":26632,"_18309":49850,"_24913":49851,"_2529":49852},[],"/docs/pr-preview/pr-47/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3023":2238,"_26291":2229,"_5":26632,"_18309":49854,"_24913":49855,"_2529":47585},[],"/docs/pr-preview/pr-47/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3023":2239,"_26291":2229,"_5":26632,"_18309":49857,"_24913":49858,"_2529":42889},[],"/docs/pr-preview/pr-47/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3023":2240,"_26291":2229,"_18309":49860,"_5":12556,"_24913":2229,"_2529":49861},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3023":2241,"_26291":2229,"_18309":49863,"_5":12556,"_24913":49828,"_2529":49864},[],"Console access and permission to create keys and authorities.",{"_3023":2242,"_26291":2229,"_18309":49866,"_5":12556,"_24913":49828,"_2529":49867},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3023":2243,"_26291":2229,"_18309":49869,"_5":12556,"_24913":49828,"_2529":49870},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3023":2244,"_26291":2229,"_18309":49872,"_5":12556,"_24913":49828,"_2529":49873},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3023":2245,"_26291":2229,"_18309":49875,"_5":12556,"_24913":49831,"_2529":49876},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3023":2246,"_26291":2229,"_18309":49878,"_5":12556,"_24913":49831,"_2529":49879},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3023":2247,"_26291":2229,"_18309":49881,"_5":12556,"_24913":49835,"_2529":49882},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3023":2248,"_26291":2229,"_18309":49884,"_5":12556,"_24913":49835,"_2529":49885},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3023":2249,"_26291":2229,"_18309":49887,"_5":12556,"_24913":49839,"_2529":49888},[],"Select **Root CA** and complete:",{"_3023":2250,"_26291":2229,"_18309":49890,"_5":12556,"_24913":49839,"_2529":49891},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3023":2251,"_26291":2229,"_18309":49893,"_5":12556,"_24913":49839,"_2529":49894},[],"**Subject**: organization and country details for your evaluation.",{"_3023":2252,"_26291":2229,"_18309":49896,"_5":12556,"_24913":49839,"_2529":49897},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3023":2253,"_26291":2229,"_18309":49899,"_5":12556,"_24913":49839,"_2529":49900},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3023":2254,"_26291":2229,"_18309":49902,"_5":12556,"_24913":49839,"_2529":49903},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3023":2255,"_26291":2229,"_18309":49905,"_5":12556,"_24913":49843,"_2529":49906},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3023":2256,"_26291":2229,"_18309":49908,"_5":12556,"_24913":49847,"_2529":49909},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3023":2257,"_26291":2229,"_18309":49911,"_5":12556,"_24913":49847,"_2529":49912},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3023":2258,"_26291":2229,"_18309":49914,"_5":12556,"_24913":49851,"_2529":49915},[],"Run from the directory where you saved `ca.pem`:",{"_3023":2259,"_26291":2229,"_18309":49917,"_5":12556,"_24913":49851,"_2529":49918},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3023":2260,"_26291":2229,"_18309":49920,"_5":12556,"_24913":49851,"_2529":49921},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3023":2261,"_26291":2229,"_18309":49923,"_5":12556,"_24913":49855,"_2529":49924},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3023":2262,"_26291":2229,"_18309":49926,"_5":12556,"_24913":49855,"_2529":49927},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3023":2263,"_26291":2229,"_18309":49929,"_5":12556,"_24913":49855,"_2529":49930},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3023":2264,"_26291":2229,"_18309":49932,"_5":12556,"_24913":49855,"_2529":49933},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3023":2265,"_26291":2229,"_18309":49935,"_5":12556,"_24913":49858,"_2529":49936},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3023":2266,"_26291":2266,"_5":12871,"_2529":49938,"_26635":49939,"_18309":49940,"_24913":2266},"Issue and verify a certificate",[42855,44199,47892,47327],[],{"_3023":2267,"_26291":2266,"_18309":49942,"_5":12556,"_24913":2266,"_2529":49943},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3023":2268,"_26291":2266,"_5":26632,"_18309":49945,"_24913":49946,"_2529":42865},[],"/docs/pr-preview/pr-47/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3023":2269,"_26291":2266,"_5":26632,"_18309":49948,"_24913":49949,"_2529":49950},[],"/docs/pr-preview/pr-47/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3023":2270,"_26291":2266,"_5":26632,"_18309":49952,"_24913":49953,"_2529":49954},[],"/docs/pr-preview/pr-47/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3023":2271,"_26291":2266,"_5":26632,"_18309":49956,"_24913":49957,"_2529":49958},[],"/docs/pr-preview/pr-47/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3023":2272,"_26291":2266,"_5":26632,"_18309":49960,"_24913":49961,"_2529":49962},[],"/docs/pr-preview/pr-47/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3023":2273,"_26291":2266,"_5":26632,"_18309":49964,"_24913":49965,"_2529":49966},[],"/docs/pr-preview/pr-47/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3023":2274,"_26291":2266,"_5":26632,"_18309":49968,"_24913":49969,"_2529":49848},[],"/docs/pr-preview/pr-47/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_3023":2275,"_26291":2266,"_5":26632,"_18309":49971,"_24913":49972,"_2529":49973},[],"/docs/pr-preview/pr-47/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3023":2276,"_26291":2266,"_5":26632,"_18309":49975,"_24913":49976,"_2529":49977},[],"/docs/pr-preview/pr-47/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3023":2277,"_26291":2266,"_5":26632,"_18309":49979,"_24913":49980,"_2529":49981},[],"/docs/pr-preview/pr-47/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3023":2278,"_26291":2266,"_5":26632,"_18309":49983,"_24913":49984,"_2529":47585},[],"/docs/pr-preview/pr-47/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3023":2279,"_26291":2266,"_5":26632,"_18309":49986,"_24913":49987,"_2529":42889},[],"/docs/pr-preview/pr-47/platform/pki/quickstarts/issue-certificate#next-step",{"_3023":2280,"_26291":2266,"_18309":49989,"_5":12556,"_24913":2266,"_2529":49990},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3023":2281,"_26291":2266,"_18309":49992,"_5":12556,"_24913":49946,"_2529":49993},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3023":2282,"_26291":2266,"_18309":49995,"_5":12556,"_24913":49946,"_2529":49996},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3023":2283,"_26291":2266,"_18309":49998,"_5":12556,"_24913":49946,"_2529":49999},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3023":2284,"_26291":2266,"_18309":50001,"_5":12556,"_24913":49946,"_2529":50002},[],"A client identifier: here we use `device-001`.",{"_3023":2285,"_26291":2266,"_18309":50004,"_5":12556,"_24913":49946,"_2529":50005},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3023":2286,"_26291":2266,"_18309":50007,"_5":12556,"_24913":49949,"_2529":50008},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3023":2287,"_26291":2266,"_18309":50010,"_5":12556,"_24913":49953,"_2529":50011},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3023":2288,"_26291":2266,"_18309":50013,"_5":12556,"_24913":49953,"_2529":50014},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3023":2289,"_26291":2266,"_18309":50016,"_5":12556,"_24913":49957,"_2529":50017},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3023":2290,"_26291":2266,"_18309":50019,"_5":12556,"_24913":49957,"_2529":50020},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3023":2291,"_26291":2266,"_18309":50022,"_5":12556,"_24913":49961,"_2529":50023},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3023":2292,"_26291":2266,"_18309":50025,"_5":12556,"_24913":49961,"_2529":50026},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3023":2293,"_26291":2266,"_18309":50028,"_5":12556,"_24913":49965,"_2529":50029},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3023":2294,"_26291":2266,"_18309":50031,"_5":12556,"_24913":49969,"_2529":50032},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3023":2295,"_26291":2266,"_18309":50034,"_5":12556,"_24913":49972,"_2529":50035},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3023":2296,"_26291":2266,"_18309":50037,"_5":12556,"_24913":49976,"_2529":50038},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3023":2297,"_26291":2266,"_18309":50040,"_5":12556,"_24913":49976,"_2529":50041},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3023":2298,"_26291":2266,"_18309":50043,"_5":12556,"_24913":49976,"_2529":50044},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3023":2299,"_26291":2266,"_18309":50046,"_5":12556,"_24913":49980,"_2529":50047},[],"In Bash, compare the two public-key digests:",{"_3023":2300,"_26291":2266,"_18309":50049,"_5":12556,"_24913":49980,"_2529":50050},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3023":2301,"_26291":2266,"_18309":50052,"_5":12556,"_24913":49980,"_2529":50053},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3023":2302,"_26291":2266,"_18309":50055,"_5":12556,"_24913":49984,"_2529":47669},[],{"_3023":2303,"_26291":2266,"_18309":50057,"_5":12556,"_24913":49984,"_2529":50058},[],"What to review",{"_3023":2304,"_26291":2266,"_18309":50060,"_5":12556,"_24913":49984,"_2529":50061},[],"The CA rejects issuance",{"_3023":2305,"_26291":2266,"_18309":50063,"_5":12556,"_24913":49984,"_2529":50064},[],"Permissions, CA state and key, algorithm and profile.",{"_3023":2306,"_26291":2266,"_18309":50066,"_5":12556,"_24913":49984,"_2529":50067},[],"Different subject or usages",{"_3023":2307,"_26291":2266,"_18309":50069,"_5":12556,"_24913":49984,"_2529":50070},[],"Applied profile and requested values.",{"_3023":2308,"_26291":2266,"_18309":50072,"_5":12556,"_24913":49984,"_2529":50073},[],"Issuer cannot be found",{"_3023":2309,"_26291":2266,"_18309":50075,"_5":12556,"_24913":49984,"_2529":50076},[],"Downloaded CA and required intermediate chain.",{"_3023":2310,"_26291":2266,"_18309":50078,"_5":12556,"_24913":49984,"_2529":50079},[],"Validity fails",{"_3023":2311,"_26291":2266,"_18309":50081,"_5":12556,"_24913":49984,"_2529":50082},[],"Certificate and CA dates, and the computer's clock.",{"_3023":2312,"_26291":2266,"_18309":50084,"_5":12556,"_24913":49984,"_2529":50085},[],"Public-key digests differ",{"_3023":2313,"_26291":2266,"_18309":50087,"_5":12556,"_24913":49984,"_2529":50088},[],"Certificate and key files from the same issuance.",{"_3023":2314,"_26291":2266,"_18309":50090,"_5":12556,"_24913":49984,"_2529":50091},[],"See PKI diagnostics to narrow an issuance failure.",{"_3023":2315,"_26291":2266,"_18309":50093,"_5":12556,"_24913":49987,"_2529":50094},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3023":2316,"_26291":2266,"_18309":50096,"_5":12556,"_24913":49987,"_2529":50097},[],"Manage certificates for inspection, status and revocation.",{"_3023":2317,"_26291":2266,"_18309":50099,"_5":12556,"_24913":49987,"_2529":50100},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3023":2318,"_26291":2266,"_18309":50102,"_5":12556,"_24913":49987,"_2529":50103},[],"Prepare EST for the device to request its next identities.",{"_3023":2319,"_26291":2266,"_18309":50105,"_5":12556,"_24913":49987,"_2529":50106},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3023":2320,"_26291":2320,"_5":12871,"_2529":50108,"_26635":50109,"_18309":50110,"_24913":2320},"PKI getting started",[42855,44199,47892,47327],[],{"_3023":2321,"_26291":2320,"_18309":50112,"_5":12556,"_24913":2320,"_2529":50113},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3023":2322,"_26291":2320,"_5":26632,"_18309":50115,"_24913":50116,"_2529":42865},[],"/docs/pr-preview/pr-47/platform/pki/quickstarts/overview#before-you-begin",{"_3023":2323,"_26291":2320,"_5":26632,"_18309":50118,"_24913":50119,"_2529":50120},[],"/docs/pr-preview/pr-47/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3023":2324,"_26291":2320,"_5":26632,"_18309":50122,"_24913":50123,"_2529":47519},[],"/docs/pr-preview/pr-47/platform/pki/quickstarts/overview#expected-result",{"_3023":2325,"_26291":2320,"_5":26632,"_18309":50125,"_24913":50126,"_2529":50127},[],"/docs/pr-preview/pr-47/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3023":2326,"_26291":2320,"_18309":50129,"_5":12556,"_24913":2320,"_2529":50130},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3023":2327,"_26291":2320,"_18309":50132,"_5":12556,"_24913":50116,"_2529":50133},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3023":2328,"_26291":2320,"_18309":50135,"_5":12556,"_24913":50116,"_2529":50136},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3023":2329,"_26291":2320,"_18309":50138,"_5":12556,"_24913":50116,"_2529":50139},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3023":2330,"_26291":2320,"_18309":50141,"_5":12556,"_24913":50116,"_2529":50142},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3023":2331,"_26291":2320,"_18309":50144,"_5":12556,"_24913":50116,"_2529":50145},[],"A working directory with restricted access for the downloaded key.",{"_3023":2332,"_26291":2320,"_18309":50147,"_5":12556,"_24913":50119,"_2529":50148},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3023":2333,"_26291":2320,"_18309":50150,"_5":12556,"_24913":50119,"_2529":50151},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3023":2334,"_26291":2320,"_18309":50153,"_5":12556,"_24913":50119,"_2529":50154},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3023":2335,"_26291":2320,"_18309":50156,"_5":12556,"_24913":50119,"_2529":50157},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3023":2336,"_26291":2320,"_18309":50159,"_5":12556,"_24913":50123,"_2529":50160},[],"File or resource",{"_3023":2337,"_26291":2320,"_18309":50162,"_5":12556,"_24913":50123,"_2529":47516},[],{"_3023":2338,"_26291":2320,"_18309":50164,"_5":12556,"_24913":50123,"_2529":50165},[],"Active root CA and `ca.pem`",{"_3023":2339,"_26291":2320,"_18309":50167,"_5":12556,"_24913":50123,"_2529":50168},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3023":2340,"_26291":2320,"_18309":50170,"_5":12556,"_24913":50123,"_2529":50171},[],"End-entity certificate and `device.crt`",{"_3023":2341,"_26291":2320,"_18309":50173,"_5":12556,"_24913":50123,"_2529":50174},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3023":2342,"_26291":2320,"_18309":50176,"_5":12556,"_24913":50123,"_2529":50177},[],"Private key `device.key`",{"_3023":2343,"_26291":2320,"_18309":50179,"_5":12556,"_24913":50123,"_2529":50180},[],"Its public key matches the one included in `device.crt`.",{"_3023":2344,"_26291":2320,"_18309":50182,"_5":12556,"_24913":50123,"_2529":50183},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3023":2345,"_26291":2320,"_18309":50185,"_5":12556,"_24913":50126,"_2529":50186},[],"To operate certificates, continue with Certificates and Validation.",{"_3023":2346,"_26291":2320,"_18309":50188,"_5":12556,"_24913":50126,"_2529":50189},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3023":2347,"_26291":2320,"_18309":50191,"_5":12556,"_24913":50126,"_2529":50192},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3023":2348,"_26291":2348,"_5":12871,"_2529":50194,"_26635":50195,"_18309":50196,"_24913":2348},"PKI troubleshooting",[42855,44199,47892,46713],[],{"_3023":2349,"_26291":2348,"_18309":50198,"_5":12556,"_24913":2348,"_2529":50199},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3023":2350,"_26291":2348,"_5":26632,"_18309":50201,"_24913":50202,"_2529":50203},[],"/docs/pr-preview/pr-47/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3023":2351,"_26291":2348,"_5":26632,"_18309":50205,"_24913":50206,"_2529":50207},[],"/docs/pr-preview/pr-47/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3023":2352,"_26291":2348,"_5":26632,"_18309":50209,"_24913":50210,"_2529":50211},[],"/docs/pr-preview/pr-47/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3023":2353,"_26291":2348,"_18309":50213,"_5":12556,"_24913":2348,"_2529":50214},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3023":2354,"_26291":2348,"_18309":50216,"_5":12556,"_24913":2348,"_2529":50217},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3023":2355,"_26291":2348,"_18309":50219,"_5":12556,"_24913":50202,"_2529":47516},[],{"_3023":2356,"_26291":2348,"_18309":50221,"_5":12556,"_24913":50202,"_2529":50222},[],"What to inspect",{"_3023":2357,"_26291":2348,"_18309":50224,"_5":12556,"_24913":50202,"_2529":42889},[],{"_3023":2358,"_26291":2348,"_18309":50226,"_5":12556,"_24913":50202,"_2529":50227},[],"CA",{"_3023":2359,"_26291":2348,"_18309":50229,"_5":12556,"_24913":50202,"_2529":50230},[],"Exists, is active and has usable dates.",{"_3023":2360,"_26291":2348,"_18309":50232,"_5":12556,"_24913":50202,"_2529":50233},[],"Authorities.",{"_3023":2361,"_26291":2348,"_18309":50235,"_5":12556,"_24913":50202,"_2529":50236},[],"Key",{"_3023":2362,"_26291":2348,"_18309":50238,"_5":12556,"_24913":50202,"_2529":50239},[],"The record has a usable private key and the engine can sign.",{"_3023":2363,"_26291":2348,"_18309":50241,"_5":12556,"_24913":50202,"_2529":50242},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3023":2364,"_26291":2348,"_18309":50244,"_5":12556,"_24913":50202,"_2529":50245},[],"CSR",{"_3023":2365,"_26291":2348,"_18309":50247,"_5":12556,"_24913":50202,"_2529":50248},[],"Correct PEM and verifiable signature.",{"_3023":2366,"_26291":2348,"_18309":50250,"_5":12556,"_24913":50202,"_2529":50251},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3023":2367,"_26291":2348,"_18309":50253,"_5":12556,"_24913":50202,"_2529":50254},[],"Profile",{"_3023":2368,"_26291":2348,"_18309":50256,"_5":12556,"_24913":50202,"_2529":50257},[],"Selected source, existing ID, allowed algorithm and size.",{"_3023":2369,"_26291":2348,"_18309":50259,"_5":12556,"_24913":50202,"_2529":50260},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3023":2370,"_26291":2348,"_18309":50262,"_5":12556,"_24913":50202,"_2529":47669},[],{"_3023":2371,"_26291":2348,"_18309":50264,"_5":12556,"_24913":50202,"_2529":50265},[],"Appropriate subject, SAN, usages and dates.",{"_3023":2372,"_26291":2348,"_18309":50267,"_5":12556,"_24913":50202,"_2529":50268},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3023":2373,"_26291":2348,"_18309":50270,"_5":12556,"_24913":50202,"_2529":50271},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3023":2374,"_26291":2348,"_18309":50273,"_5":12556,"_24913":50202,"_2529":50274},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3023":2375,"_26291":2348,"_18309":50276,"_5":12556,"_24913":50206,"_2529":50277},[],"Check each boundary independently:",{"_3023":2376,"_26291":2348,"_18309":50279,"_5":12556,"_24913":50206,"_2529":50280},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3023":2377,"_26291":2348,"_18309":50282,"_5":12556,"_24913":50206,"_2529":50283},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3023":2378,"_26291":2348,"_18309":50285,"_5":12556,"_24913":50206,"_2529":50286},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3023":2379,"_26291":2348,"_18309":50288,"_5":12556,"_24913":50206,"_2529":50289},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3023":2380,"_26291":2348,"_18309":50291,"_5":12556,"_24913":50206,"_2529":50292},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3023":2381,"_26291":2348,"_18309":50294,"_5":12556,"_24913":50206,"_2529":50295},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3023":2382,"_26291":2348,"_18309":50297,"_5":12556,"_24913":50210,"_2529":50298},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3023":2383,"_26291":2348,"_18309":50300,"_5":12556,"_24913":50210,"_2529":50301},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3023":2384,"_26291":2384,"_5":12871,"_2529":50303,"_26635":50304,"_18309":50306,"_24913":2384},"3.8.0 to 4.0.0",[42855,50305],"Upgrades",[],{"_3023":2385,"_26291":2384,"_18309":50308,"_5":12556,"_24913":2384,"_2529":50309},[],"4.0.0 changes that affect DMS configuration, backend storage, device events and authorization; what can break after upgrading from 3.8.0, and how to verify it.",{"_3023":2386,"_26291":2384,"_5":26632,"_18309":50311,"_24913":50312,"_2529":50313},[],"/docs/pr-preview/pr-47/upgrades/3-8-0-to-4-0-0#summary","Summary",{"_3023":2387,"_26291":2384,"_5":26632,"_18309":50315,"_24913":50316,"_2529":50317},[],"/docs/pr-preview/pr-47/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3023":2388,"_26291":2384,"_5":26632,"_18309":50319,"_24913":50320,"_2529":50321},[],"/docs/pr-preview/pr-47/upgrades/3-8-0-to-4-0-0#webhooks-with-file-references","Webhooks with file references",{"_3023":2389,"_26291":2384,"_5":26632,"_18309":50323,"_24913":50324,"_2529":50325},[],"/docs/pr-preview/pr-47/upgrades/3-8-0-to-4-0-0#receiver-certificate-verification","Receiver certificate verification",{"_3023":2390,"_26291":2384,"_5":26632,"_18309":50327,"_24913":50328,"_2529":50329},[],"/docs/pr-preview/pr-47/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3023":2391,"_26291":2384,"_5":26632,"_18309":50331,"_24913":50332,"_2529":50333},[],"/docs/pr-preview/pr-47/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3023":2392,"_26291":2384,"_5":26632,"_18309":50335,"_24913":50336,"_2529":50337},[],"/docs/pr-preview/pr-47/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3023":2393,"_26291":2384,"_5":26632,"_18309":50339,"_24913":50340,"_2529":50341},[],"/docs/pr-preview/pr-47/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3023":2394,"_26291":2384,"_5":26632,"_18309":50343,"_24913":50344,"_2529":50345},[],"/docs/pr-preview/pr-47/upgrades/3-8-0-to-4-0-0#migrations-against-the-pki-database","Migrations against the pki database",{"_3023":2395,"_26291":2384,"_5":26632,"_18309":50347,"_24913":50348,"_2529":50349},[],"/docs/pr-preview/pr-47/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3023":2396,"_26291":2384,"_5":26632,"_18309":50351,"_24913":50352,"_2529":50353},[],"/docs/pr-preview/pr-47/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3023":2397,"_26291":2384,"_5":26632,"_18309":50355,"_24913":50356,"_2529":50357},[],"/docs/pr-preview/pr-47/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3023":2398,"_26291":2384,"_5":26632,"_18309":50359,"_24913":50360,"_2529":50361},[],"/docs/pr-preview/pr-47/upgrades/3-8-0-to-4-0-0#authorization-cutover","Authorization cutover",{"_3023":2399,"_26291":2384,"_5":26632,"_18309":50363,"_24913":50364,"_2529":50365},[],"/docs/pr-preview/pr-47/upgrades/3-8-0-to-4-0-0#amqp","AMQP",{"_3023":2400,"_26291":2384,"_5":26632,"_18309":50367,"_24913":50368,"_2529":50369},[],"/docs/pr-preview/pr-47/upgrades/3-8-0-to-4-0-0#local-storage-and-container-images","Local storage and container images",{"_3023":2401,"_26291":2384,"_5":26632,"_18309":50371,"_24913":50372,"_2529":50373},[],"/docs/pr-preview/pr-47/upgrades/3-8-0-to-4-0-0#verification-checklist","Verification checklist",{"_3023":2402,"_26291":2384,"_18309":50375,"_5":12556,"_24913":2384,"_2529":50376},[],"Upgrading from 3.8.0 to 4.0.0 automatically migrates stored DMS configuration. Most of it converts without intervention, but three changes can leave enrollments failing or configs holding unexpected values if they are not reviewed. This page states what changes, what symptoms to expect and what to do in each case. Current behavior of each feature is documented in the DMS pages.",{"_3023":2403,"_26291":2384,"_18309":50378,"_5":12556,"_24913":2384,"_2529":50379},[],"The upgrade also carries backend changes that are not DMS-specific: storage consolidates into the PostgreSQL `pki` database, legacy CA keys can be registered in the KMS, device events move to a dedicated store, `authz` replaces the gateway's token validation, and SQLite storage disappears. These steps are covered from PostgreSQL consolidation onward and should be completed before the DMS checks.",{"_3023":2404,"_26291":2384,"_18309":50381,"_5":12556,"_24913":2384,"_2529":50382},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3023":2405,"_26291":2384,"_18309":50384,"_5":12556,"_24913":50312,"_2529":50385},[],"Change",{"_3023":2406,"_26291":2384,"_18309":50387,"_5":12556,"_24913":50312,"_2529":50388},[],"Who is affected",{"_3023":2407,"_26291":2384,"_18309":50390,"_5":12556,"_24913":50312,"_2529":50391},[],"Severity",{"_3023":2408,"_26291":2384,"_18309":50393,"_5":12556,"_24913":50312,"_2529":50394},[],"Action",{"_3023":2409,"_26291":2384,"_18309":50396,"_5":12556,"_24913":50312,"_2529":50321},[],{"_3023":2410,"_26291":2384,"_18309":50398,"_5":12556,"_24913":50312,"_2529":50399},[],"DMSs with a webhook whose mTLS certificate or key were file paths",{"_3023":2411,"_26291":2384,"_18309":50401,"_5":12556,"_24913":50312,"_2529":50402},[],"High: enrollments and re-enrollments calling the webhook fail",{"_3023":2412,"_26291":2384,"_18309":50404,"_5":12556,"_24913":50312,"_2529":50405},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3023":2413,"_26291":2384,"_18309":50407,"_5":12556,"_24913":50312,"_2529":50325},[],{"_3023":2414,"_26291":2384,"_18309":50409,"_5":12556,"_24913":50312,"_2529":50410},[],"DMSs with a webhook that had `validate_server_cert: false`",{"_3023":2415,"_26291":2384,"_18309":50412,"_5":12556,"_24913":50312,"_2529":50413},[],"Medium: webhook credentials are sent to an unverified receiver",{"_3023":2416,"_26291":2384,"_18309":50415,"_5":12556,"_24913":50312,"_2529":50416},[],"Set `insecure_skip_verify` to `false`",{"_3023":2417,"_26291":2384,"_18309":50418,"_5":12556,"_24913":50312,"_2529":50329},[],{"_3023":2418,"_26291":2384,"_18309":50420,"_5":12556,"_24913":50312,"_2529":50421},[],"Scripts and consoles that edit DMSs through the API",{"_3023":2419,"_26291":2384,"_18309":50423,"_5":12556,"_24913":50312,"_2529":50424},[],"Medium: an edit in the old layout silently empties `validation_cas`",{"_3023":2420,"_26291":2384,"_18309":50426,"_5":12556,"_24913":50312,"_2529":50427},[],"Read the DMS before editing and use the new field",{"_3023":2421,"_26291":2384,"_18309":50429,"_5":12556,"_24913":50312,"_2529":50333},[],{"_3023":2422,"_26291":2384,"_18309":50431,"_5":12556,"_24913":50312,"_2529":50432},[],"Any DMS",{"_3023":2423,"_26291":2384,"_18309":50434,"_5":12556,"_24913":50312,"_2529":50435},[],"Low: informational",{"_3023":2424,"_26291":2384,"_18309":50437,"_5":12556,"_24913":50312,"_2529":50438},[],"Read both blocks before editing",{"_3023":2425,"_26291":2384,"_18309":50440,"_5":12556,"_24913":50312,"_2529":50337},[],{"_3023":2426,"_26291":2384,"_18309":50442,"_5":12556,"_24913":50312,"_2529":50443},[],"Clients that send the DMS ID in the update body",{"_3023":2427,"_26291":2384,"_18309":50445,"_5":12556,"_24913":50312,"_2529":50446},[],"Low: the update targets the ID in the URL",{"_3023":2428,"_26291":2384,"_18309":50448,"_5":12556,"_24913":50312,"_2529":50449},[],"Send update requests with the ID in the URL",{"_3023":2429,"_26291":2384,"_18309":50451,"_5":12556,"_24913":50312,"_2529":50341},[],{"_3023":2430,"_26291":2384,"_18309":50453,"_5":12556,"_24913":50312,"_2529":50454},[],"3.8.0 deployments with per-service databases",{"_3023":2431,"_26291":2384,"_18309":50456,"_5":12556,"_24913":50312,"_2529":50457},[],"High: services find no data after the upgrade",{"_3023":2432,"_26291":2384,"_18309":50459,"_5":12556,"_24913":50312,"_2529":50460},[],"Move data and migration history into the `pki` schemas",{"_3023":2433,"_26291":2384,"_18309":50462,"_5":12556,"_24913":50312,"_2529":50349},[],{"_3023":2434,"_26291":2384,"_18309":50464,"_5":12556,"_24913":50312,"_2529":50465},[],"Installations whose CA keys predate the KMS",{"_3023":2435,"_26291":2384,"_18309":50467,"_5":12556,"_24913":50312,"_2529":50468},[],"Medium: CA keys stay unmanaged",{"_3023":2436,"_26291":2384,"_18309":50470,"_5":12556,"_24913":50312,"_2529":50471},[],"Run `ca-to-kms-migration`, with `--dry-run` first",{"_3023":2437,"_26291":2384,"_18309":50473,"_5":12556,"_24913":50312,"_2529":50353},[],{"_3023":2438,"_26291":2384,"_18309":50475,"_5":12556,"_24913":50312,"_2529":50476},[],"Consumers that read the device `events` field",{"_3023":2439,"_26291":2384,"_18309":50478,"_5":12556,"_24913":50312,"_2529":50479},[],"Medium: the field disappears from the device representation",{"_3023":2440,"_26291":2384,"_18309":50481,"_5":12556,"_24913":50312,"_2529":50482},[],"Use the new event endpoints",{"_3023":2441,"_26291":2384,"_18309":50484,"_5":12556,"_24913":50312,"_2529":50357},[],{"_3023":2442,"_26291":2384,"_18309":50486,"_5":12556,"_24913":50312,"_2529":50487},[],"Deployments with SQLite storage",{"_3023":2443,"_26291":2384,"_18309":50489,"_5":12556,"_24913":50312,"_2529":50490},[],"High: the backend no longer supports it",{"_3023":2444,"_26291":2384,"_18309":50492,"_5":12556,"_24913":50312,"_2529":50493},[],"Move to PostgreSQL before upgrading",{"_3023":2445,"_26291":2384,"_18309":50495,"_5":12556,"_24913":50312,"_2529":50361},[],{"_3023":2446,"_26291":2384,"_18309":50497,"_5":12556,"_24913":50312,"_2529":50498},[],"All deployments",{"_3023":2447,"_26291":2384,"_18309":50500,"_5":12556,"_24913":50312,"_2529":50501},[],"High: without bootstrap there is no administrator",{"_3023":2448,"_26291":2384,"_18309":50503,"_5":12556,"_24913":50312,"_2529":50504},[],"Configure `authz` following the access-control guide",{"_3023":2449,"_26291":2384,"_18309":50506,"_5":12556,"_24913":50312,"_2529":50507},[],"AMQP over TLS",{"_3023":2450,"_26291":2384,"_18309":50509,"_5":12556,"_24913":50312,"_2529":50510},[],"Deployments with TLS on the message broker",{"_3023":2451,"_26291":2384,"_18309":50512,"_5":12556,"_24913":50312,"_2529":50513},[],"Medium: plaintext clients are rejected",{"_3023":2452,"_26291":2384,"_18309":50515,"_5":12556,"_24913":50312,"_2529":50516},[],"Point clients at the TLS port and trust the broker certificate",{"_3023":2453,"_26291":2384,"_18309":50518,"_5":12556,"_24913":50312,"_2529":50369},[],{"_3023":2454,"_26291":2384,"_18309":50520,"_5":12556,"_24913":50312,"_2529":50521},[],"Filesystem KMS engines and locally stored CRLs",{"_3023":2455,"_26291":2384,"_18309":50523,"_5":12556,"_24913":50312,"_2529":50524},[],"Medium: data can be left behind",{"_3023":2456,"_26291":2384,"_18309":50526,"_5":12556,"_24913":50312,"_2529":50527},[],"Preserve volumes, transfer data and check permissions",{"_3023":2457,"_26291":2384,"_18309":50529,"_5":12556,"_24913":50312,"_2529":50530},[],"A verification checklist at the end confirms the result.",{"_3023":2458,"_26291":2384,"_18309":50532,"_5":12556,"_24913":50316,"_2529":50533},[],"Stored webhook configs are rewritten to the current layout. Fields are renamed as follows:",{"_3023":2459,"_26291":2384,"_18309":50535,"_5":12556,"_24913":50316,"_2529":50536},[],"Field in 3.8.0",{"_3023":2460,"_26291":2384,"_18309":50538,"_5":12556,"_24913":50316,"_2529":50539},[],"Field in 4.0.0",{"_3023":2461,"_26291":2384,"_18309":50541,"_5":12556,"_24913":50316,"_2529":50542},[],"`validate_server_cert`",{"_3023":2462,"_26291":2384,"_18309":50544,"_5":12556,"_24913":50316,"_2529":50545},[],"`insecure_skip_verify` (value negated)",{"_3023":2463,"_26291":2384,"_18309":50547,"_5":12556,"_24913":50316,"_2529":50548},[],"`oidc`",{"_3023":2464,"_26291":2384,"_18309":50550,"_5":12556,"_24913":50316,"_2529":50551},[],"`jwt_options`",{"_3023":2465,"_26291":2384,"_18309":50553,"_5":12556,"_24913":50316,"_2529":50554},[],"`apikey`",{"_3023":2466,"_26291":2384,"_18309":50556,"_5":12556,"_24913":50316,"_2529":50557},[],"`apikey_options`",{"_3023":2467,"_26291":2384,"_18309":50559,"_5":12556,"_24913":50316,"_2529":50560},[],"`mtls`",{"_3023":2468,"_26291":2384,"_18309":50562,"_5":12556,"_24913":50316,"_2529":50563},[],"`mtls_options`",{"_3023":2469,"_26291":2384,"_18309":50565,"_5":12556,"_24913":50316,"_2529":50566},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. The two cases below do need it.",{"_3023":2470,"_26291":2384,"_18309":50568,"_5":12556,"_24913":50320,"_2529":50569},[],"A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields, and does so on every call, whatever the configured authentication mode. As a result, every enroll and re-enroll that calls that webhook fails until the config is fixed.",{"_3023":2471,"_26291":2384,"_18309":50571,"_5":12556,"_24913":50320,"_2529":50572},[],"There are two ways to fix it, depending on the webhook:",{"_3023":2472,"_26291":2384,"_18309":50574,"_5":12556,"_24913":50320,"_2529":50575},[],"If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM.",{"_3023":2473,"_26291":2384,"_18309":50577,"_5":12556,"_24913":50320,"_2529":50578},[],"If the webhook does not use mTLS, remove the leftover file fields.",{"_3023":2474,"_26291":2384,"_18309":50580,"_5":12556,"_24913":50320,"_2529":50581},[],"Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`).",{"_3023":2475,"_26291":2384,"_18309":50583,"_5":12556,"_24913":50320,"_2529":50584},[],"A variant of the same problem exists: if the stored config holds file paths inside `mtls_options.cert_content` or `mtls_options.key_content`, every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fails validation. Settings are replaced wholesale, so the stored config must be resent with the certificate and key as PEM.",{"_3023":2476,"_26291":2384,"_18309":50586,"_5":12556,"_24913":50324,"_2529":50587},[],"A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`. Receiver certificate verification therefore stays skipped until that field is set to `false`.",{"_3023":2477,"_26291":2384,"_18309":50589,"_5":12556,"_24913":50324,"_2529":50590},[],"It should be corrected on every migrated config. The webhook authorization channel carries the API key or bearer token, so skipping verification exposes those credentials to a network-positioned attacker. Keeping `insecure_skip_verify: true` is only justified when the receiver certificate is deliberately unverifiable.",{"_3023":2478,"_26291":2384,"_18309":50592,"_5":12556,"_24913":50328,"_2529":50593},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`.",{"_3023":2479,"_26291":2384,"_18309":50595,"_5":12556,"_24913":50328,"_2529":50596},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3023":2480,"_26291":2384,"_18309":50598,"_5":12556,"_24913":50328,"_2529":50599},[],"What does change is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently ignored because unknown JSON fields are dropped, and GET responses no longer include it. Consequently, an update body built from the old layout empties `validation_cas` without returning any error. To avoid it, always read the DMS before sending an edit and reuse the layout the API returns.",{"_3023":2481,"_26291":2384,"_18309":50601,"_5":12556,"_24913":50332,"_2529":50602},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but both blocks should be read before editing a DMS so that one is not modified while believing the other is being edited.",{"_3023":2482,"_26291":2384,"_18309":50604,"_5":12556,"_24913":50332,"_2529":50605},[],"If the console version does not expose independent settings, they can be edited through the DMS API.",{"_3023":2483,"_26291":2384,"_18309":50607,"_5":12556,"_24913":50336,"_2529":50608},[],"`PUT /v1/dms/:id` now takes the DMS ID from the URL and validates the request body. An ID in the body is ignored. Update clients that relied on the body ID.",{"_3023":2484,"_26291":2384,"_18309":50610,"_5":12556,"_24913":50340,"_2529":50611},[],"The 4.0.0 backend connects to one PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. Standalone `authz` can use a separate `authz` database; the development monolith stores its data in the `authz` schema of `pki`. WFX keeps its own `wfx` database.",{"_3023":2485,"_26291":2384,"_18309":50613,"_5":12556,"_24913":50340,"_2529":50614},[],"Installations on 3.8.0 with separate per-service databases must move their data and migration history into the corresponding `pki` schemas, preserving structure, indexes, constraints and data.",{"_3023":2486,"_26291":2384,"_18309":50616,"_5":12556,"_24913":50340,"_2529":50617},[],"The migration tooling applies migrations to an existing schema; no command moves data between databases. The transfer procedure on this page is provisional — validate it against the final release artifacts before upgrading production.",{"_3023":2487,"_26291":2384,"_18309":50619,"_5":12556,"_24913":50340,"_2529":50620},[],"Plan the transfer like any data migration: take a verifiable backup of PostgreSQL first, schedule downtime and prevent writes while data is copied.",{"_3023":2488,"_26291":2384,"_18309":50622,"_5":12556,"_24913":50344,"_2529":50623},[],"For manual migration, `goose-lamassu` requires `search_path=<schema>` in the connection string and must run against the `pki` database. The binary does not validate the database name, so verify `dbname=pki` before running:",{"_3023":2489,"_26291":2384,"_18309":50625,"_5":12556,"_24913":50344,"_2529":50626},[],"Use the connection and TLS options appropriate for your environment, and repeat per schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`.",{"_3023":2490,"_26291":2384,"_18309":50628,"_5":12556,"_24913":50344,"_2529":50629},[],"The `goose-lamassu` documentation still shows per-database examples (`dbname=ca`, `dbname=kms`) and claims the tool validates the database name. It does not — only `search_path` is validated. Follow the `dbname=pki` form above.",{"_3023":2491,"_26291":2384,"_18309":50631,"_5":12556,"_24913":50348,"_2529":50632},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no record in the KMS. The `ca-to-kms-migration` tool registers them:",{"_3023":2492,"_26291":2384,"_18309":50634,"_5":12556,"_24913":50348,"_2529":50635},[],"`key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_3023":2493,"_26291":2384,"_18309":50637,"_5":12556,"_24913":50348,"_2529":50638},[],"The tool is idempotent: keys already present in the KMS are skipped, so it can be run several times safely.",{"_3023":2494,"_26291":2384,"_18309":50640,"_5":12556,"_24913":50348,"_2529":50641},[],"Certificates that cannot be read, or that lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve affected records.",{"_3023":2495,"_26291":2384,"_18309":50643,"_5":12556,"_24913":50348,"_2529":50644},[],"Run it with `--dry-run` first to scan and report without writing to KMS storage, then run the real migration:",{"_3023":2496,"_26291":2384,"_18309":50646,"_5":12556,"_24913":50348,"_2529":50647},[],"Point the tool's `storage` configuration at the `pki` database: in 4.0.0 the CA and KMS data live in the `ca` and `kms` schemas of the same database. The tool's README still describes the pre-4.0.0 two-database layout, so do not copy its examples. In Kubernetes, the recommended approach is to run the migration as a Helm `pre-upgrade` hook Job; see the tool's README (`backend/cmd/ca-to-kms-migration/README.md` in the repository).",{"_3023":2497,"_26291":2384,"_18309":50649,"_5":12556,"_24913":50352,"_2529":50650},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store. The upgrade transforms the existing data.",{"_3023":2498,"_26291":2384,"_18309":50652,"_5":12556,"_24913":50352,"_2529":50653},[],"The `events` field no longer appears in the device representation. Adapt consumers that read it and use the new endpoints instead:",{"_3023":2499,"_26291":2384,"_18309":50655,"_5":12556,"_24913":50352,"_2529":50656},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3023":2500,"_26291":2384,"_18309":50658,"_5":12556,"_24913":50352,"_2529":50659},[],"`POST /v1/devices/:id/events` creates an event.",{"_3023":2501,"_26291":2384,"_18309":50661,"_5":12556,"_24913":50352,"_2529":50662},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams events over Server-Sent Events, with a keepalive every 15 seconds. SSE returns `501` when it is disabled in the deployment.",{"_3023":2502,"_26291":2384,"_18309":50664,"_5":12556,"_24913":50352,"_2529":50665},[],"SSE needs to fan out across service instances, so each instance binds its own durable AMQP queue (named `device-manager-sse-<uuid>`). Queues from crashed or replaced instances linger until cleaned up out-of-band — configure an expiration or cleanup policy on the broker to avoid accumulating queues.",{"_3023":2503,"_26291":2384,"_18309":50667,"_5":12556,"_24913":50356,"_2529":50668},[],"The SQLite storage engine is removed. Supported providers are `postgres`, `couch_db` and `dynamo_db`. Deployments that used SQLite must move to PostgreSQL first and consolidate their data into the `pki` schemas as described in PostgreSQL consolidation.",{"_3023":2504,"_26291":2384,"_18309":50670,"_5":12556,"_24913":50360,"_2529":50671},[],"4.0.0 introduces the `authz` service, which validates tokens against the OIDC provider's JWKS endpoint and applies fine-grained authorization to service requests. Validation no longer uses the gateway's former JWT policy.",{"_3023":2505,"_26291":2384,"_18309":50673,"_5":12556,"_24913":50360,"_2529":50674},[],"Configure the JWKS endpoint, the credentials for accessing PKI and authz data, the policies, and an initial bootstrap principal. Without a matching principal there is no implicit initial administrator, so nobody can administer the PKI.",{"_3023":2506,"_26291":2384,"_18309":50676,"_5":12556,"_24913":50360,"_2529":50677},[],"The access control page documents principals, policies and the first administrator. The Helm installation page documents `services.authz.bootstrap` and how the pre-install job applies it.",{"_3023":2507,"_26291":2384,"_18309":50679,"_5":12556,"_24913":50364,"_2529":50680},[],"If TLS is enabled for AMQP, clients connect to the broker's TLS port — `amqps`, commonly `5671` — and must trust the broker's certificate. Verify the effective configuration before upgrading, especially if plaintext AMQP was previously used. The port is operator-configured, so check the one your deployment uses.",{"_3023":2508,"_26291":2384,"_18309":50682,"_5":12556,"_24913":50368,"_2529":50683},[],"If the KMS uses a filesystem engine or the VA stores CRLs locally, preserve that data during the upgrade and, where necessary, transfer it. Make sure the identity running the services can access keys, CRLs and cryptographic devices, and verify their operation before retiring the original data.",{"_3023":2509,"_26291":2384,"_18309":50685,"_5":12556,"_24913":50368,"_2529":50686},[],"Service images run on a distroless, non-root base with numeric UID `65532`; the `authz` image is Ubuntu with a non-root user (the same numeric UID). If you mount volumes holding keys or CRLs, ensure ownership and permissions allow that identity to read them and, where applicable, write them.",{"_3023":2510,"_26291":2384,"_18309":50688,"_5":12556,"_24913":50372,"_2529":50689},[],"After applying the upgrade, check in this order:",{"_3023":2511,"_26291":2384,"_18309":50691,"_5":12556,"_24913":50372,"_2529":50692},[],"**Databases.** Confirm each service reads the `pki` database with its own schema (`kms`, `ca`, `va`, `devicemanager`, `dmsmanager`, `alerts`), that `authz` and `wfx` data are reachable, and that the migration status is registered per schema. If the deployment used SQLite, confirm the new PostgreSQL storage works end to end.",{"_3023":2512,"_26291":2384,"_18309":50694,"_5":12556,"_24913":50372,"_2529":50695},[],"**Legacy CA keys.** Run `ca-to-kms-migration` with `--dry-run`, review the report and any warnings, then run it without the flag and confirm the expected keys appear in the KMS.",{"_3023":2513,"_26291":2384,"_18309":50697,"_5":12556,"_24913":50372,"_2529":50698},[],"**Device events.** Query `GET /v1/devices/:id/events` for devices with historical events, confirm the data was migrated, and point consumers at the new endpoints.",{"_3023":2514,"_26291":2384,"_18309":50700,"_5":12556,"_24913":50372,"_2529":50701},[],"**Authorization.** Authenticate as the bootstrap principal and confirm administration works; check that a denied identity receives `403`; review client and integration permissions.",{"_3023":2515,"_26291":2384,"_18309":50703,"_5":12556,"_24913":50372,"_2529":50704},[],"**AMQP.** Confirm the backend connects to the broker with the expected TLS settings and that the cleanup policy for SSE queues is in place.",{"_3023":2516,"_26291":2384,"_18309":50706,"_5":12556,"_24913":50372,"_2529":50707},[],"**Local storage.** Confirm the services can read the KMS keys and CRLs on their volumes, and that CRL issuance and retrieval work.",{"_3023":2517,"_26291":2384,"_18309":50709,"_5":12556,"_24913":50372,"_2529":50710},[],"**Webhooks without file fields.** List the DMSs that use a webhook for enrollment or re-enrollment and confirm each `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3023":2518,"_26291":2384,"_18309":50712,"_5":12556,"_24913":50372,"_2529":50713},[],"**Receiver verification.** Confirm `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3023":2519,"_26291":2384,"_18309":50715,"_5":12556,"_24913":50372,"_2529":50716},[],"**Delivery.** Trigger, or wait for, one enroll or re-enroll through each migrated webhook and confirm the authorization call completes.",{"_3023":2520,"_26291":2384,"_18309":50718,"_5":12556,"_24913":50372,"_2529":50719},[],"**Trust set.** Read `est_rfc7030_settings.client_certificate_settings.validation_cas` and confirm it holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3023":2521,"_26291":2384,"_18309":50721,"_5":12556,"_24913":50372,"_2529":50722},[],"**API clients.** Update any script or console that uses the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), since they silently drop those values, and confirm DMS updates send the ID in the URL.",{"_3023":2522,"_26291":2384,"_18309":50724,"_5":12556,"_24913":50372,"_2529":47186},[],{"_3023":2523,"_26291":2384,"_18309":50726,"_5":12556,"_24913":50372,"_2529":50727},[],"<Card title=\"DMS API\" href=\"/docs/api-reference/dms-manager\" />",{"_3023":2524,"_26291":2384,"_18309":50729,"_5":12556,"_24913":50372,"_2529":50730},[],"<Card title=\"Access control\" href=\"/docs/platform/administration/access-control\" />","count","sorting",{"_50734":50735,"_50736":50737,"_50738":50739,"_50740":50741,"_15900":2551,"_60795":2551},"language","english","sortableProperties",[2529,26291,5,24913],"sortablePropertiesWithTypes",{"_2529":21905,"_26291":21905,"_5":21905,"_24913":21905},"sorts",{"_2529":50742,"_26291":53256,"_5":55769,"_24913":58282},{"_4036":50743,"_50744":50745,"_5":21905},{"_12611":13007,"_12964":2925,"_12971":4284,"_11328":4464,"_25037":3442,"_17374":13885,"_12632":4788,"_12639":4834,"_25440":4479,"_25811":3842,"_25832":6043,"_25458":6002,"_30248":3655,"_25843":2581,"_25871":26028,"_30255":4053,"_30258":5191,"_30261":2929,"_30264":18678,"_26161":3864,"_30269":4441,"_30271":4206,"_26191":16272,"_26151":2777,"_30275":4702,"_30278":5158,"_30280":2619,"_25861":3085,"_26156":3555,"_26209":5615,"_30285":4705,"_30287":16970,"_30289":4221,"_30291":4044,"_30293":11290,"_30295":64