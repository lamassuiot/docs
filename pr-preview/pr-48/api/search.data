4362":49368,"_34364":49371,"_34367":49374,"_34369":49377,"_34371":49380,"_34373":49383,"_34375":49386,"_34377":49389,"_34379":49392,"_34381":49395,"_34383":49398,"_34385":49400},{"_2926":15,"_25639":15,"_5":12558,"_2452":41758,"_25983":41759,"_17911":41763,"_24291":15},"Deploy from AWS Marketplace",[41760,41761,41762],"Docs","Deployment","Other models",[],{"_2926":16,"_25639":15,"_17911":41765,"_5":17806,"_24291":15,"_2452":41766},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_2926":17,"_25639":15,"_5":25980,"_17911":41768,"_24291":41769,"_2452":41770},[],"/docs/pr-preview/pr-48/deployment/aws-marketplace#before-you-begin","Before you begin",{"_2926":18,"_25639":15,"_5":25980,"_17911":41772,"_24291":41773,"_2452":41774},[],"/docs/pr-preview/pr-48/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_2926":19,"_25639":15,"_5":25980,"_17911":41776,"_24291":41777,"_2452":41778},[],"/docs/pr-preview/pr-48/deployment/aws-marketplace#open-the-offer","Open the offer",{"_2926":20,"_25639":15,"_5":25980,"_17911":41780,"_24291":41781,"_2452":41782},[],"/docs/pr-preview/pr-48/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_2926":21,"_25639":15,"_5":25980,"_17911":41784,"_24291":41785,"_2452":41786},[],"/docs/pr-preview/pr-48/deployment/aws-marketplace#limit-network-access","Limit network access",{"_2926":22,"_25639":15,"_5":25980,"_17911":41788,"_24291":41789,"_2452":41790},[],"/docs/pr-preview/pr-48/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_2926":23,"_25639":15,"_5":25980,"_17911":41792,"_24291":41793,"_2452":41794},[],"/docs/pr-preview/pr-48/deployment/aws-marketplace#next-step","Next step",{"_2926":24,"_25639":15,"_17911":41796,"_5":17806,"_24291":15,"_2452":41797},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_2926":25,"_25639":15,"_17911":41799,"_5":17806,"_24291":41769,"_2452":41800},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_2926":26,"_25639":15,"_17911":41802,"_5":17806,"_24291":41769,"_2452":41803},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_2926":27,"_25639":15,"_17911":41805,"_5":17806,"_24291":41769,"_2452":41806},[],"A security group allowing the necessary endpoints.",{"_2926":28,"_25639":15,"_17911":41808,"_5":17806,"_24291":41773,"_2452":41809},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_2926":29,"_25639":15,"_17911":41811,"_5":17806,"_24291":41773,"_2452":41812},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_2926":30,"_25639":15,"_17911":41814,"_5":17806,"_24291":41773,"_2452":41815},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_2926":31,"_25639":15,"_17911":41817,"_5":17806,"_24291":41777,"_2452":41818},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_2926":32,"_25639":15,"_17911":41820,"_5":17806,"_24291":41781,"_2452":41821},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_2926":33,"_25639":15,"_17911":41823,"_5":17806,"_24291":41785,"_2452":41824},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_2926":34,"_25639":15,"_17911":41826,"_5":17806,"_24291":41789,"_2452":41827},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_2926":35,"_25639":15,"_17911":41829,"_5":17806,"_24291":41793,"_2452":41830},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_2926":36,"_25639":36,"_5":12558,"_2452":41832,"_25983":41833,"_17911":41834,"_24291":36},"Deploy Lamassu",[41760,41761],[],{"_2926":37,"_25639":36,"_17911":41836,"_5":17806,"_24291":36,"_2452":41837},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_2926":38,"_25639":36,"_5":25980,"_17911":41839,"_24291":41840,"_2452":41841},[],"/docs/pr-preview/pr-48/deployment/overview#choose-a-model","Choose a model",{"_2926":39,"_25639":36,"_5":25980,"_17911":41843,"_24291":41844,"_2452":41845},[],"/docs/pr-preview/pr-48/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_2926":40,"_25639":36,"_5":25980,"_17911":41847,"_24291":41848,"_2452":41849},[],"/docs/pr-preview/pr-48/deployment/overview#after-deployment","After deployment",{"_2926":41,"_25639":36,"_17911":41851,"_5":17806,"_24291":36,"_2452":41852},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_2926":42,"_25639":36,"_17911":41854,"_5":17806,"_24291":41840,"_2452":41855},[],"Model",{"_2926":43,"_25639":36,"_17911":41857,"_5":17806,"_24291":41840,"_2452":41858},[],"Recommended for",{"_2926":44,"_25639":36,"_17911":41860,"_5":17806,"_24291":41840,"_2452":41861},[],"Who operates the infrastructure",{"_2926":45,"_25639":36,"_17911":41863,"_5":17806,"_24291":41840,"_2452":41864},[],"Starting point",{"_2926":46,"_25639":36,"_17911":41866,"_5":17806,"_24291":41840,"_2452":41867},[],"Kubernetes self-managed",{"_2926":47,"_25639":36,"_17911":41869,"_5":17806,"_24291":41840,"_2452":41870},[],"Production, regulated environments and custom deployments",{"_2926":48,"_25639":36,"_17911":41872,"_5":17806,"_24291":41840,"_2452":41873},[],"Your team",{"_2926":49,"_25639":36,"_17911":41875,"_5":17806,"_24291":41840,"_2452":41876},[],"Helm or Fastlane",{"_2926":50,"_25639":36,"_17911":41878,"_5":17806,"_24291":41840,"_2452":41879},[],"AWS Marketplace",{"_2926":51,"_25639":36,"_17911":41881,"_5":17806,"_24291":41840,"_2452":41882},[],"Evaluation or a dedicated deployment inside an AWS account",{"_2926":52,"_25639":36,"_17911":41884,"_5":17806,"_24291":41840,"_2452":41873},[],{"_2926":53,"_25639":36,"_17911":41886,"_5":17806,"_24291":41840,"_2452":41887},[],"Preconfigured image on EC2",{"_2926":54,"_25639":36,"_17911":41889,"_5":17806,"_24291":41840,"_2452":41890},[],"SaaS",{"_2926":55,"_25639":36,"_17911":41892,"_5":17806,"_24291":41840,"_2452":41893},[],"Teams that want to use the platform without operating it",{"_2926":56,"_25639":36,"_17911":41895,"_5":17806,"_24291":41840,"_2452":41896},[],"Lamassu",{"_2926":57,"_25639":36,"_17911":41898,"_5":17806,"_24291":41840,"_2452":41899},[],"Managed subscription",{"_2926":58,"_25639":36,"_17911":41901,"_5":17806,"_24291":41840,"_2452":41902},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2926":59,"_25639":36,"_17911":41904,"_5":17806,"_24291":41840,"_2452":41905},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2926":60,"_25639":36,"_17911":41907,"_5":17806,"_24291":41840,"_2452":41908},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_2926":61,"_25639":36,"_17911":41910,"_5":17806,"_24291":41844,"_2452":41911},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_2926":62,"_25639":36,"_17911":41913,"_5":17806,"_24291":41848,"_2452":41914},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_2926":63,"_25639":63,"_5":12558,"_2452":41916,"_25983":41917,"_17911":41918,"_24291":63},"Use Lamassu as SaaS",[41760,41761,41762],[],{"_2926":64,"_25639":63,"_17911":41920,"_5":17806,"_24291":63,"_2452":41921},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_2926":65,"_25639":63,"_5":25980,"_17911":41923,"_24291":41924,"_2452":41925},[],"/docs/pr-preview/pr-48/deployment/saas#what-the-service-manages","What the service manages",{"_2926":66,"_25639":63,"_5":25980,"_17911":41927,"_24291":41928,"_2452":41929},[],"/docs/pr-preview/pr-48/deployment/saas#plans","Plans",{"_2926":67,"_25639":63,"_5":25980,"_17911":41931,"_24291":41932,"_2452":41933},[],"/docs/pr-preview/pr-48/deployment/saas#request-access","Request access",{"_2926":68,"_25639":63,"_17911":41935,"_5":17806,"_24291":63,"_2452":41936},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_2926":69,"_25639":63,"_17911":41938,"_5":17806,"_24291":41924,"_2452":41939},[],"Platform availability and maintenance.",{"_2926":70,"_25639":63,"_17911":41941,"_5":17806,"_24291":41924,"_2452":41942},[],"Automatic backups.",{"_2926":71,"_25639":63,"_17911":41944,"_5":17806,"_24291":41924,"_2452":41945},[],"Version upgrades.",{"_2926":72,"_25639":63,"_17911":41947,"_5":17806,"_24291":41924,"_2452":41948},[],"Technical support and SLA according to your plan.",{"_2926":73,"_25639":63,"_17911":41950,"_5":17806,"_24291":41928,"_2452":41951},[],"Plan",{"_2926":74,"_25639":63,"_17911":41953,"_5":17806,"_24291":41928,"_2452":41954},[],"Devices",{"_2926":75,"_25639":63,"_17911":41956,"_5":17806,"_24291":41928,"_2452":41957},[],"Support",{"_2926":76,"_25639":63,"_17911":41959,"_5":17806,"_24291":41928,"_2452":41960},[],"SLA",{"_2926":77,"_25639":63,"_17911":41962,"_5":17806,"_24291":41928,"_2452":41963},[],"Starter",{"_2926":78,"_25639":63,"_17911":41965,"_5":17806,"_24291":41928,"_2452":41966},[],"Up to 1,000",{"_2926":79,"_25639":63,"_17911":41968,"_5":17806,"_24291":41928,"_2452":41969},[],"Email",{"_2926":80,"_25639":63,"_17911":41971,"_5":17806,"_24291":41928,"_2452":41972},[],"99.5 %",{"_2926":81,"_25639":63,"_17911":41974,"_5":17806,"_24291":41928,"_2452":41975},[],"Professional",{"_2926":82,"_25639":63,"_17911":41977,"_5":17806,"_24291":41928,"_2452":41978},[],"Up to 10,000",{"_2926":83,"_25639":63,"_17911":41980,"_5":17806,"_24291":41928,"_2452":41981},[],"Email and chat",{"_2926":84,"_25639":63,"_17911":41983,"_5":17806,"_24291":41928,"_2452":41984},[],"99.9 %",{"_2926":85,"_25639":63,"_17911":41986,"_5":17806,"_24291":41928,"_2452":41987},[],"Enterprise",{"_2926":86,"_25639":63,"_17911":41989,"_5":17806,"_24291":41928,"_2452":41990},[],"Unlimited",{"_2926":87,"_25639":63,"_17911":41992,"_5":17806,"_24291":41928,"_2452":41993},[],"Dedicated",{"_2926":88,"_25639":63,"_17911":41995,"_5":17806,"_24291":41928,"_2452":41996},[],"99.99 %",{"_2926":89,"_25639":63,"_17911":41998,"_5":17806,"_24291":41932,"_2452":41999},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_2926":90,"_25639":63,"_17911":42001,"_5":17806,"_24291":41932,"_2452":42002},[],"When you receive your instance's credentials, continue with Get started.",{"_2926":91,"_25639":91,"_5":12558,"_2452":42004,"_25983":42005,"_17911":42006,"_24291":91},"Fastlane",[41760,41761,41867],[],{"_2926":92,"_25639":91,"_17911":42008,"_5":17806,"_24291":91,"_2452":42009},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_2926":93,"_25639":91,"_5":25980,"_17911":42011,"_24291":42012,"_2452":42013},[],"/docs/pr-preview/pr-48/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_2926":94,"_25639":91,"_5":25980,"_17911":42015,"_24291":42016,"_2452":42017},[],"/docs/pr-preview/pr-48/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_2926":95,"_25639":91,"_5":25980,"_17911":42019,"_24291":42020,"_2452":41770},[],"/docs/pr-preview/pr-48/deployment/self-hosted/fastlane#before-you-begin",{"_2926":96,"_25639":91,"_5":25980,"_17911":42022,"_24291":42023,"_2452":42024},[],"/docs/pr-preview/pr-48/deployment/self-hosted/fastlane#quick-start","Quick start",{"_2926":97,"_25639":91,"_5":25980,"_17911":42026,"_24291":42027,"_2452":42028},[],"/docs/pr-preview/pr-48/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_2926":98,"_25639":91,"_5":25980,"_17911":42030,"_24291":42031,"_2452":42032},[],"/docs/pr-preview/pr-48/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_2926":99,"_25639":91,"_5":25980,"_17911":42034,"_24291":42035,"_2452":42036},[],"/docs/pr-preview/pr-48/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_2926":100,"_25639":91,"_5":25980,"_17911":42038,"_24291":42039,"_2452":42040},[],"/docs/pr-preview/pr-48/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_2926":101,"_25639":91,"_5":25980,"_17911":42042,"_24291":42043,"_2452":42044},[],"/docs/pr-preview/pr-48/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_2926":102,"_25639":91,"_5":25980,"_17911":42046,"_24291":42047,"_2452":42048},[],"/docs/pr-preview/pr-48/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_2926":103,"_25639":91,"_17911":42050,"_5":17806,"_24291":42012,"_2452":42051},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_2926":104,"_25639":91,"_17911":42053,"_5":17806,"_24291":42012,"_2452":42054},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_2926":105,"_25639":91,"_17911":42056,"_5":17806,"_24291":42016,"_2452":42057},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_2926":106,"_25639":91,"_17911":42059,"_5":17806,"_24291":42016,"_2452":42060},[],"Fastlane installs or configures",{"_2926":107,"_25639":91,"_17911":42062,"_5":17806,"_24291":42016,"_2452":42063},[],"You still provide",{"_2926":108,"_25639":91,"_17911":42065,"_5":17806,"_24291":42016,"_2452":42066},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_2926":109,"_25639":91,"_17911":42068,"_5":17806,"_24291":42016,"_2452":42069},[],"The Kubernetes cluster, nodes and persistent storage",{"_2926":110,"_25639":91,"_17911":42071,"_5":17806,"_24291":42016,"_2452":42072},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_2926":111,"_25639":91,"_17911":42074,"_5":17806,"_24291":42016,"_2452":42075},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_2926":112,"_25639":91,"_17911":42077,"_5":17806,"_24291":42016,"_2452":42078},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_2926":113,"_25639":91,"_17911":42080,"_5":17806,"_24291":42016,"_2452":42081},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_2926":114,"_25639":91,"_17911":42083,"_5":17806,"_24291":42016,"_2452":42084},[],"Optional observability and lab HSM components",{"_2926":115,"_25639":91,"_17911":42086,"_5":17806,"_24291":42016,"_2452":42087},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_2926":116,"_25639":91,"_17911":42089,"_5":17806,"_24291":42016,"_2452":42090},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_2926":117,"_25639":91,"_17911":42092,"_5":17806,"_24291":42020,"_2452":42093},[],"You need:",{"_2926":118,"_25639":91,"_17911":42095,"_5":17806,"_24291":42020,"_2452":42096},[],"an existing Kubernetes cluster",{"_2926":119,"_25639":91,"_17911":42098,"_5":17806,"_24291":42020,"_2452":42099},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_2926":120,"_25639":91,"_17911":42101,"_5":17806,"_24291":42020,"_2452":42102},[],"`yq`",{"_2926":121,"_25639":91,"_17911":42104,"_5":17806,"_24291":42020,"_2452":20264},[],{"_2926":122,"_25639":91,"_17911":42106,"_5":17806,"_24291":42020,"_2452":42107},[],"`jq` only when using `--sample-data`",{"_2926":123,"_25639":91,"_17911":42109,"_5":17806,"_24291":42020,"_2452":42110},[],"free external ports 80 and 443 on a single-node K3s host",{"_2926":124,"_25639":91,"_17911":42112,"_5":17806,"_24291":42020,"_2452":42113},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_2926":125,"_25639":91,"_17911":42115,"_5":17806,"_24291":42020,"_2452":42116},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_2926":126,"_25639":91,"_17911":42118,"_5":17806,"_24291":42023,"_2452":42119},[],"Run the script from a clone of the Helm repository:",{"_2926":127,"_25639":91,"_17911":42121,"_5":17806,"_24291":42023,"_2452":42122},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_2926":128,"_25639":91,"_17911":42124,"_5":17806,"_24291":42027,"_2452":42125},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_2926":129,"_25639":91,"_17911":42127,"_5":17806,"_24291":42027,"_2452":42128},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_2926":130,"_25639":91,"_17911":42130,"_5":17806,"_24291":42027,"_2452":42131},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_2926":131,"_25639":91,"_17911":42133,"_5":17806,"_24291":42027,"_2452":42134},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_2926":132,"_25639":91,"_17911":42136,"_5":17806,"_24291":42031,"_2452":42137},[],"Option",{"_2926":133,"_25639":91,"_17911":42139,"_5":17806,"_24291":42031,"_2452":42140},[],"Default",{"_2926":134,"_25639":91,"_17911":42142,"_5":17806,"_24291":42031,"_2452":42143},[],"Purpose",{"_2926":135,"_25639":91,"_17911":42145,"_5":17806,"_24291":42031,"_2452":42146},[],"`-h`, `--help`",{"_2926":136,"_25639":91,"_17911":42148,"_5":17806,"_24291":42031,"_2452":42149},[],"—",{"_2926":137,"_25639":91,"_17911":42151,"_5":17806,"_24291":42031,"_2452":42152},[],"Show help",{"_2926":138,"_25639":91,"_17911":42154,"_5":17806,"_24291":42031,"_2452":42155},[],"`-c`, `--context`",{"_2926":139,"_25639":91,"_17911":42157,"_5":17806,"_24291":42031,"_2452":42158},[],"current context",{"_2926":140,"_25639":91,"_17911":42160,"_5":17806,"_24291":42031,"_2452":42161},[],"Select the kubeconfig context for kubectl and Helm",{"_2926":141,"_25639":91,"_17911":42163,"_5":17806,"_24291":42031,"_2452":42164},[],"`-n`, `--non-interactive`",{"_2926":142,"_25639":91,"_17911":42166,"_5":17806,"_24291":42031,"_2452":5464},[],{"_2926":143,"_25639":91,"_17911":42168,"_5":17806,"_24291":42031,"_2452":42169},[],"Skip prompts and generate dependency credentials",{"_2926":144,"_25639":91,"_17911":42171,"_5":17806,"_24291":42031,"_2452":42172},[],"`-ns`, `--namespace`",{"_2926":145,"_25639":91,"_17911":42174,"_5":17806,"_24291":42031,"_2452":42175},[],"`lamassu-dev`",{"_2926":146,"_25639":91,"_17911":42177,"_5":17806,"_24291":42031,"_2452":42178},[],"Namespace for the installation",{"_2926":147,"_25639":91,"_17911":42180,"_5":17806,"_24291":42031,"_2452":42181},[],"`-d`, `--domain`",{"_2926":148,"_25639":91,"_17911":42183,"_5":17806,"_24291":42031,"_2452":42184},[],"`dev.lamassu.io`",{"_2926":149,"_25639":91,"_17911":42186,"_5":17806,"_24291":42031,"_2452":42187},[],"Domain used by the UI, OIDC and certificate",{"_2926":150,"_25639":91,"_17911":42189,"_5":17806,"_24291":42031,"_2452":42190},[],"`-v`, `--version`",{"_2926":151,"_25639":91,"_17911":42192,"_5":17806,"_24291":42031,"_2452":12795},[],{"_2926":152,"_25639":91,"_17911":42194,"_5":17806,"_24291":42031,"_2452":42195},[],"Lamassu chart version",{"_2926":153,"_25639":91,"_17911":42197,"_5":17806,"_24291":42031,"_2452":42198},[],"`--https-port`",{"_2926":154,"_25639":91,"_17911":42200,"_5":17806,"_24291":42031,"_2452":42201},[],"`443`",{"_2926":155,"_25639":91,"_17911":42203,"_5":17806,"_24291":42031,"_2452":42204},[],"Gateway HTTPS listener port",{"_2926":156,"_25639":91,"_17911":42206,"_5":17806,"_24291":42031,"_2452":42207},[],"`--http-port`",{"_2926":157,"_25639":91,"_17911":42209,"_5":17806,"_24291":42031,"_2452":42210},[],"`80`",{"_2926":158,"_25639":91,"_17911":42212,"_5":17806,"_24291":42031,"_2452":42213},[],"Gateway HTTP listener port",{"_2926":159,"_25639":91,"_17911":42215,"_5":17806,"_24291":42031,"_2452":42216},[],"`--tls-crt`",{"_2926":160,"_25639":91,"_17911":42218,"_5":17806,"_24291":42031,"_2452":42149},[],{"_2926":161,"_25639":91,"_17911":42220,"_5":17806,"_24291":42031,"_2452":42221},[],"PEM certificate for downstream TLS",{"_2926":162,"_25639":91,"_17911":42223,"_5":17806,"_24291":42031,"_2452":42224},[],"`--tls-key`",{"_2926":163,"_25639":91,"_17911":42226,"_5":17806,"_24291":42031,"_2452":42149},[],{"_2926":164,"_25639":91,"_17911":42228,"_5":17806,"_24291":42031,"_2452":42229},[],"PEM private key for downstream TLS",{"_2926":165,"_25639":91,"_17911":42231,"_5":17806,"_24291":42031,"_2452":42232},[],"`-l`, `--local-chart-path`",{"_2926":166,"_25639":91,"_17911":42234,"_5":17806,"_24291":42031,"_2452":42235},[],"repository chart",{"_2926":167,"_25639":91,"_17911":42237,"_5":17806,"_24291":42031,"_2452":42238},[],"Use an unpacked local Lamassu chart",{"_2926":168,"_25639":91,"_17911":42240,"_5":17806,"_24291":42031,"_2452":42241},[],"`-ip`, `--gateway-ip`",{"_2926":169,"_25639":91,"_17911":42243,"_5":17806,"_24291":42031,"_2452":7406},[],{"_2926":170,"_25639":91,"_17911":42245,"_5":17806,"_24291":42031,"_2452":42246},[],"Override the address written to `gateway.addresses`",{"_2926":171,"_25639":91,"_17911":42248,"_5":17806,"_24291":42031,"_2452":42249},[],"`--otel`",{"_2926":172,"_25639":91,"_17911":42251,"_5":17806,"_24291":42031,"_2452":5464},[],{"_2926":173,"_25639":91,"_17911":42253,"_5":17806,"_24291":42031,"_2452":42254},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_2926":174,"_25639":91,"_17911":42256,"_5":17806,"_24291":42031,"_2452":42257},[],"`--sample-data`",{"_2926":175,"_25639":91,"_17911":42259,"_5":17806,"_24291":42031,"_2452":5464},[],{"_2926":176,"_25639":91,"_17911":42261,"_5":17806,"_24291":42031,"_2452":42262},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_2926":177,"_25639":91,"_17911":42264,"_5":17806,"_24291":42031,"_2452":42265},[],"`--with-hsm`",{"_2926":178,"_25639":91,"_17911":42267,"_5":17806,"_24291":42031,"_2452":5464},[],{"_2926":179,"_25639":91,"_17911":42269,"_5":17806,"_24291":42031,"_2452":42270},[],"Install lab HSM components and configure KMS for PKCS#11",{"_2926":180,"_25639":91,"_17911":42272,"_5":17806,"_24291":42031,"_2452":42273},[],"`--softhsm-chart-path`",{"_2926":181,"_25639":91,"_17911":42275,"_5":17806,"_24291":42031,"_2452":42276},[],"`./charts/softhsm`",{"_2926":182,"_25639":91,"_17911":42278,"_5":17806,"_24291":42031,"_2452":42279},[],"Use a different local SoftHSM chart",{"_2926":183,"_25639":91,"_17911":42281,"_5":17806,"_24291":42031,"_2452":42282},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_2926":184,"_25639":91,"_17911":42284,"_5":17806,"_24291":42035,"_2452":42285},[],"Fastlane:",{"_2926":185,"_25639":91,"_17911":42287,"_5":17806,"_24291":42035,"_2452":42288},[],"validates local tools and the selected cluster",{"_2926":186,"_25639":91,"_17911":42290,"_5":17806,"_24291":42035,"_2452":42291},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_2926":187,"_25639":91,"_17911":42293,"_5":17806,"_24291":42035,"_2452":42294},[],"creates the namespace",{"_2926":188,"_25639":91,"_17911":42296,"_5":17806,"_24291":42035,"_2452":42297},[],"installs PostgreSQL and creates the required databases",{"_2926":189,"_25639":91,"_17911":42299,"_5":17806,"_24291":42035,"_2452":42300},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_2926":190,"_25639":91,"_17911":42302,"_5":17806,"_24291":42035,"_2452":42303},[],"installs RabbitMQ",{"_2926":191,"_25639":91,"_17911":42305,"_5":17806,"_24291":42035,"_2452":42306},[],"optionally installs observability and lab HSM components",{"_2926":192,"_25639":91,"_17911":42308,"_5":17806,"_24291":42035,"_2452":42309},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_2926":193,"_25639":91,"_17911":42311,"_5":17806,"_24291":42035,"_2452":42312},[],"optionally loads sample data",{"_2926":194,"_25639":91,"_17911":42314,"_5":17806,"_24291":42035,"_2452":42315},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_2926":195,"_25639":91,"_17911":42317,"_5":17806,"_24291":42039,"_2452":42318},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_2926":196,"_25639":91,"_17911":42320,"_5":17806,"_24291":42039,"_2452":42321},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_2926":197,"_25639":91,"_17911":42323,"_5":17806,"_24291":42043,"_2452":42324},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use.",{"_2926":198,"_25639":91,"_17911":42326,"_5":17806,"_24291":42043,"_2452":42327},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_2926":199,"_25639":91,"_17911":42329,"_5":17806,"_24291":42043,"_2452":42330},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_2926":200,"_25639":91,"_17911":42332,"_5":17806,"_24291":42047,"_2452":42333},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_2926":201,"_25639":201,"_5":12558,"_2452":42335,"_25983":42336,"_17911":42337,"_24291":201},"Install with Helm",[41760,41761,41867],[],{"_2926":202,"_25639":201,"_17911":42339,"_5":17806,"_24291":201,"_2452":42340},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_2926":203,"_25639":201,"_5":25980,"_17911":42342,"_24291":42343,"_2452":42344},[],"/docs/pr-preview/pr-48/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_2926":204,"_25639":201,"_5":25980,"_17911":42346,"_24291":42347,"_2452":41770},[],"/docs/pr-preview/pr-48/deployment/self-hosted/helm#before-you-begin",{"_2926":205,"_25639":201,"_5":25980,"_17911":42349,"_24291":42350,"_2452":42351},[],"/docs/pr-preview/pr-48/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_2926":206,"_25639":201,"_5":25980,"_17911":42353,"_24291":42354,"_2452":42355},[],"/docs/pr-preview/pr-48/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_2926":207,"_25639":201,"_5":25980,"_17911":42357,"_24291":42358,"_2452":42359},[],"/docs/pr-preview/pr-48/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_2926":208,"_25639":201,"_5":25980,"_17911":42361,"_24291":42362,"_2452":42363},[],"/docs/pr-preview/pr-48/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_2926":209,"_25639":201,"_5":25980,"_17911":42365,"_24291":42366,"_2452":42367},[],"/docs/pr-preview/pr-48/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_2926":210,"_25639":201,"_5":25980,"_17911":42369,"_24291":42370,"_2452":42371},[],"/docs/pr-preview/pr-48/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_2926":211,"_25639":201,"_5":25980,"_17911":42373,"_24291":42374,"_2452":42375},[],"/docs/pr-preview/pr-48/deployment/self-hosted/helm#production-decisions","Production decisions",{"_2926":212,"_25639":201,"_17911":42377,"_5":17806,"_24291":42343,"_2452":42378},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_2926":213,"_25639":201,"_17911":42380,"_5":17806,"_24291":42347,"_2452":42381},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_2926":214,"_25639":201,"_17911":42383,"_5":17806,"_24291":42347,"_2452":42384},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_2926":215,"_25639":201,"_17911":42386,"_5":17806,"_24291":42347,"_2452":42387},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_2926":216,"_25639":201,"_17911":42389,"_5":17806,"_24291":42347,"_2452":42390},[],"a reachable RabbitMQ broker and credentials",{"_2926":217,"_25639":201,"_17911":42392,"_5":17806,"_24291":42347,"_2452":42393},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_2926":218,"_25639":201,"_17911":42395,"_5":17806,"_24291":42347,"_2452":42396},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_2926":219,"_25639":201,"_17911":42398,"_5":17806,"_24291":42347,"_2452":42399},[],"cert-manager 1.14+; for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_2926":220,"_25639":201,"_17911":42401,"_5":17806,"_24291":42347,"_2452":42402},[],"a StorageClass and an external traffic design",{"_2926":221,"_25639":201,"_17911":42404,"_5":17806,"_24291":42347,"_2452":42405},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_2926":222,"_25639":201,"_17911":42407,"_5":17806,"_24291":42347,"_2452":42408},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_2926":223,"_25639":201,"_17911":42410,"_5":17806,"_24291":42347,"_2452":42411},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_2926":224,"_25639":201,"_17911":42413,"_5":17806,"_24291":42350,"_2452":42414},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_2926":225,"_25639":201,"_17911":42416,"_5":17806,"_24291":42350,"_2452":42417},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_2926":226,"_25639":201,"_17911":42419,"_5":17806,"_24291":42350,"_2452":42420},[],"Install cert-manager separately before Lamassu. The current chart renders its self-signed issuer and CA certificate resources even when `tls.type: external` makes the Gateway use an existing TLS Secret. Selecting external TLS therefore does not remove the cert-manager prerequisite.",{"_2926":227,"_25639":201,"_17911":42422,"_5":17806,"_24291":42354,"_2452":42423},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_2926":228,"_25639":201,"_17911":42425,"_5":17806,"_24291":42354,"_2452":42426},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_2926":229,"_25639":201,"_17911":42428,"_5":17806,"_24291":42354,"_2452":42429},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_2926":230,"_25639":201,"_17911":42431,"_5":17806,"_24291":42358,"_2452":42432},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it:",{"_2926":231,"_25639":201,"_17911":42434,"_5":17806,"_24291":42362,"_2452":42435},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_2926":232,"_25639":201,"_17911":42437,"_5":17806,"_24291":42362,"_2452":42438},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_2926":233,"_25639":201,"_17911":42440,"_5":17806,"_24291":42362,"_2452":42441},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_2926":234,"_25639":201,"_17911":42443,"_5":17806,"_24291":42362,"_2452":42444},[],"See Access control for the principal and policy model.",{"_2926":235,"_25639":201,"_17911":42446,"_5":17806,"_24291":42366,"_2452":42447},[],"To install a local checkout instead:",{"_2926":236,"_25639":201,"_17911":42449,"_5":17806,"_24291":42370,"_2452":42450},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_2926":237,"_25639":201,"_17911":42452,"_5":17806,"_24291":42370,"_2452":42453},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_2926":238,"_25639":201,"_17911":42455,"_5":17806,"_24291":42374,"_2452":42456},[],"Before going live, review:",{"_2926":239,"_25639":201,"_17911":42458,"_5":17806,"_24291":42374,"_2452":42459},[],"backup and recovery for PostgreSQL and persistent volumes",{"_2926":240,"_25639":201,"_17911":42461,"_5":17806,"_24291":42374,"_2452":42462},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_2926":241,"_25639":201,"_17911":42464,"_5":17806,"_24291":42374,"_2452":42465},[],"shared VA storage before increasing VA replicas",{"_2926":242,"_25639":201,"_17911":42467,"_5":17806,"_24291":42374,"_2452":42468},[],"managed OIDC roles and removal of evaluation credentials",{"_2926":243,"_25639":201,"_17911":42470,"_5":17806,"_24291":42374,"_2452":42471},[],"a trusted TLS issuer or externally managed certificate",{"_2926":244,"_25639":201,"_17911":42473,"_5":17806,"_24291":42374,"_2452":42474},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_2926":245,"_25639":201,"_17911":42476,"_5":17806,"_24291":42374,"_2452":42477},[],"SMTP, observability and alert delivery",{"_2926":246,"_25639":201,"_17911":42479,"_5":17806,"_24291":42374,"_2452":42480},[],"the migration notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_2926":247,"_25639":201,"_17911":42482,"_5":17806,"_24291":42374,"_2452":42483},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_2926":248,"_25639":248,"_5":12558,"_2452":42485,"_25983":42486,"_17911":42487,"_24291":248},"Expose the Gateway",[41760,41761,41867],[],{"_2926":249,"_25639":248,"_17911":42489,"_5":17806,"_24291":248,"_2452":42490},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_2926":250,"_25639":248,"_5":25980,"_17911":42492,"_24291":42493,"_2452":42494},[],"/docs/pr-preview/pr-48/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_2926":251,"_25639":248,"_5":25980,"_17911":42496,"_24291":42497,"_2452":42498},[],"/docs/pr-preview/pr-48/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_2926":252,"_25639":248,"_5":25980,"_17911":42500,"_24291":42501,"_2452":42502},[],"/docs/pr-preview/pr-48/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_2926":253,"_25639":248,"_5":25980,"_17911":42504,"_24291":42505,"_2452":42506},[],"/docs/pr-preview/pr-48/deployment/self-hosted/networking#k3s","K3s",{"_2926":254,"_25639":248,"_5":25980,"_17911":42508,"_24291":42509,"_2452":42510},[],"/docs/pr-preview/pr-48/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_2926":255,"_25639":248,"_5":25980,"_17911":42512,"_24291":42513,"_2452":42514},[],"/docs/pr-preview/pr-48/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_2926":256,"_25639":248,"_5":25980,"_17911":42516,"_24291":42517,"_2452":42518},[],"/docs/pr-preview/pr-48/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_2926":257,"_25639":248,"_5":25980,"_17911":42520,"_24291":42521,"_2452":42522},[],"/docs/pr-preview/pr-48/deployment/self-hosted/networking#decision-guide","Decision guide",{"_2926":258,"_25639":248,"_5":25980,"_17911":42524,"_24291":42525,"_2452":42526},[],"/docs/pr-preview/pr-48/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_2926":259,"_25639":248,"_17911":42528,"_5":17806,"_24291":42493,"_2452":42529},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_2926":260,"_25639":248,"_17911":42531,"_5":17806,"_24291":42493,"_2452":42532},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_2926":261,"_25639":248,"_17911":42534,"_5":17806,"_24291":42497,"_2452":42535},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_2926":262,"_25639":248,"_17911":42537,"_5":17806,"_24291":42497,"_2452":42538},[],"Set it only when:",{"_2926":263,"_25639":248,"_17911":42540,"_5":17806,"_24291":42497,"_2452":42541},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_2926":264,"_25639":248,"_17911":42543,"_5":17806,"_24291":42497,"_2452":42544},[],"that address is allocated to this Gateway",{"_2926":265,"_25639":248,"_17911":42546,"_5":17806,"_24291":42497,"_2452":42547},[],"the surrounding network already routes traffic for it to the cluster",{"_2926":266,"_25639":248,"_17911":42549,"_5":17806,"_24291":42497,"_2452":42550},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_2926":267,"_25639":248,"_17911":42552,"_5":17806,"_24291":42497,"_2452":42553},[],"Keep these two settings separate:",{"_2926":268,"_25639":248,"_17911":42555,"_5":17806,"_24291":42497,"_2452":42556},[],"`gateway.addresses` requests an address for the Gateway.",{"_2926":269,"_25639":248,"_17911":42558,"_5":17806,"_24291":42497,"_2452":42559},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_2926":270,"_25639":248,"_17911":42561,"_5":17806,"_24291":42497,"_2452":42562},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_2926":271,"_25639":248,"_17911":42564,"_5":17806,"_24291":42501,"_2452":42565},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_2926":272,"_25639":248,"_17911":42567,"_5":17806,"_24291":42501,"_2452":42568},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_2926":273,"_25639":248,"_17911":42570,"_5":17806,"_24291":42505,"_2452":42571},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_2926":274,"_25639":248,"_17911":42573,"_5":17806,"_24291":42505,"_2452":42574},[],"For the recommended design:",{"_2926":275,"_25639":248,"_17911":42576,"_5":17806,"_24291":42505,"_2452":42577},[],"Use only one externally exposed Lamassu Gateway.",{"_2926":276,"_25639":248,"_17911":42579,"_5":17806,"_24291":42505,"_2452":42580},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_2926":277,"_25639":248,"_17911":42582,"_5":17806,"_24291":42505,"_2452":42583},[],"Allow those ports through the VM firewall and any upstream security group.",{"_2926":278,"_25639":248,"_17911":42585,"_5":17806,"_24291":42505,"_2452":42586},[],"Point DNS at the VM's reachable address.",{"_2926":279,"_25639":248,"_17911":42588,"_5":17806,"_24291":42505,"_2452":42589},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_2926":280,"_25639":248,"_17911":42591,"_5":17806,"_24291":42509,"_2452":42592},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_2926":281,"_25639":248,"_17911":42594,"_5":17806,"_24291":42513,"_2452":42595},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_2926":282,"_25639":248,"_17911":42597,"_5":17806,"_24291":42513,"_2452":42598},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_2926":283,"_25639":248,"_17911":42600,"_5":17806,"_24291":42517,"_2452":42601},[],"First decide whether you need three independent data planes or only three hostnames.",{"_2926":284,"_25639":248,"_17911":42603,"_5":17806,"_24291":42517,"_2452":42604},[],"Requirement",{"_2926":285,"_25639":248,"_17911":42606,"_5":17806,"_24291":42517,"_2452":42607},[],"Recommended design",{"_2926":286,"_25639":248,"_17911":42609,"_5":17806,"_24291":42517,"_2452":42610},[],"Consequence",{"_2926":287,"_25639":248,"_17911":42612,"_5":17806,"_24291":42517,"_2452":42613},[],"Several Lamassu URLs or services",{"_2926":288,"_25639":248,"_17911":42615,"_5":17806,"_24291":42517,"_2452":42616},[],"One Gateway with multiple routes",{"_2926":289,"_25639":248,"_17911":42618,"_5":17806,"_24291":42517,"_2452":42619},[],"One IP and one proxy fleet; this is the chart default",{"_2926":290,"_25639":248,"_17911":42621,"_5":17806,"_24291":42517,"_2452":42622},[],"Independent Gateways and separate external IPs",{"_2926":291,"_25639":248,"_17911":42624,"_5":17806,"_24291":42517,"_2452":42625},[],"One VIP per Gateway",{"_2926":292,"_25639":248,"_17911":42627,"_5":17806,"_24291":42517,"_2452":42628},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_2926":293,"_25639":248,"_17911":42630,"_5":17806,"_24291":42517,"_2452":42631},[],"Independent Gateways on one node and one IP",{"_2926":294,"_25639":248,"_17911":42633,"_5":17806,"_24291":42517,"_2452":42634},[],"Use different external ports",{"_2926":295,"_25639":248,"_17911":42636,"_5":17806,"_24291":42517,"_2452":42637},[],"Clients must include non-standard ports",{"_2926":296,"_25639":248,"_17911":42639,"_5":17806,"_24291":42517,"_2452":42640},[],"Separate TLS/mTLS termination behind one IP",{"_2926":297,"_25639":248,"_17911":42642,"_5":17806,"_24291":42517,"_2452":42643},[],"Front-door SNI routing to internal Gateways",{"_2926":298,"_25639":248,"_17911":42645,"_5":17806,"_24291":42517,"_2452":42646},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_2926":299,"_25639":248,"_17911":42648,"_5":17806,"_24291":42517,"_2452":42649},[],"Separate Gateway resources but shared proxy infrastructure",{"_2926":300,"_25639":248,"_17911":42651,"_5":17806,"_24291":42517,"_2452":42652},[],"Envoy merged-Gateway mode",{"_2926":301,"_25639":248,"_17911":42654,"_5":17806,"_24291":42517,"_2452":42655},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_2926":302,"_25639":248,"_17911":42657,"_5":17806,"_24291":42517,"_2452":42658},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_2926":303,"_25639":248,"_17911":42660,"_5":17806,"_24291":42517,"_2452":42661},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_2926":304,"_25639":248,"_17911":42663,"_5":17806,"_24291":42517,"_2452":42664},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_2926":305,"_25639":248,"_17911":42666,"_5":17806,"_24291":42517,"_2452":42667},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_2926":306,"_25639":248,"_17911":42669,"_5":17806,"_24291":42521,"_2452":42670},[],"If one Gateway can own TLS and routing, use the chart default.",{"_2926":307,"_25639":248,"_17911":42672,"_5":17806,"_24291":42521,"_2452":42673},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_2926":308,"_25639":248,"_17911":42675,"_5":17806,"_24291":42521,"_2452":42676},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_2926":309,"_25639":248,"_17911":42678,"_5":17806,"_24291":42521,"_2452":42679},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_2926":310,"_25639":248,"_17911":42681,"_5":17806,"_24291":42521,"_2452":42682},[],"If none of those are possible, use different external ports or change the external network design.",{"_2926":311,"_25639":248,"_17911":42684,"_5":17806,"_24291":42525,"_2452":42685},[],"Check, in order:",{"_2926":312,"_25639":248,"_17911":42687,"_5":17806,"_24291":42525,"_2452":42688},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_2926":313,"_25639":248,"_17911":42690,"_5":17806,"_24291":42525,"_2452":42691},[],"Its status contains the expected address.",{"_2926":314,"_25639":248,"_17911":42693,"_5":17806,"_24291":42525,"_2452":42694},[],"The generated `LoadBalancer` Service has a usable external address.",{"_2926":315,"_25639":248,"_17911":42696,"_5":17806,"_24291":42525,"_2452":42697},[],"Port 443 reaches that address from the client network.",{"_2926":316,"_25639":248,"_17911":42699,"_5":17806,"_24291":42525,"_2452":42700},[],"DNS resolves to the externally reachable endpoint.",{"_2926":317,"_25639":248,"_17911":42702,"_5":17806,"_24291":42525,"_2452":42703},[],"The certificate contains the DNS name or IP used by the client.",{"_2926":318,"_25639":248,"_17911":42705,"_5":17806,"_24291":42525,"_2452":42706},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_2926":319,"_25639":319,"_5":12558,"_2452":41867,"_25983":42708,"_17911":42709,"_24291":319},[41760,41761,41867],[],{"_2926":320,"_25639":319,"_17911":42711,"_5":17806,"_24291":319,"_2452":42712},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_2926":321,"_25639":319,"_5":25980,"_17911":42714,"_24291":42715,"_2452":42716},[],"/docs/pr-preview/pr-48/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_2926":322,"_25639":319,"_5":25980,"_17911":42718,"_24291":42719,"_2452":42720},[],"/docs/pr-preview/pr-48/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_2926":323,"_25639":319,"_5":25980,"_17911":42722,"_24291":42723,"_2452":42724},[],"/docs/pr-preview/pr-48/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_2926":324,"_25639":319,"_5":25980,"_17911":42726,"_24291":42727,"_2452":42728},[],"/docs/pr-preview/pr-48/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_2926":325,"_25639":319,"_5":25980,"_17911":42730,"_24291":42731,"_2452":42732},[],"/docs/pr-preview/pr-48/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_2926":326,"_25639":319,"_5":25980,"_17911":42734,"_24291":42735,"_2452":42736},[],"/docs/pr-preview/pr-48/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_2926":327,"_25639":319,"_17911":42738,"_5":17806,"_24291":42715,"_2452":42739},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_2926":328,"_25639":319,"_17911":42741,"_5":17806,"_24291":42719,"_2452":42742},[],"Workflow",{"_2926":329,"_25639":319,"_17911":42744,"_5":17806,"_24291":42719,"_2452":42745},[],"Use it for",{"_2926":330,"_25639":319,"_17911":42747,"_5":17806,"_24291":42719,"_2452":42748},[],"What it installs",{"_2926":331,"_25639":319,"_17911":42750,"_5":17806,"_24291":42719,"_2452":42751},[],"Helm",{"_2926":332,"_25639":319,"_17911":42753,"_5":17806,"_24291":42719,"_2452":42754},[],"Production and controlled environments",{"_2926":333,"_25639":319,"_17911":42756,"_5":17806,"_24291":42719,"_2452":42757},[],"Lamassu services and Gateway API resources",{"_2926":334,"_25639":319,"_17911":42759,"_5":17806,"_24291":42719,"_2452":42004},[],{"_2926":335,"_25639":319,"_17911":42761,"_5":17806,"_24291":42719,"_2452":42762},[],"Evaluation, demos, CI and small lab clusters",{"_2926":336,"_25639":319,"_17911":42764,"_5":17806,"_24291":42719,"_2452":42765},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_2926":337,"_25639":319,"_17911":42767,"_5":17806,"_24291":42723,"_2452":42768},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_2926":338,"_25639":319,"_17911":42770,"_5":17806,"_24291":42723,"_2452":42771},[],"Area",{"_2926":339,"_25639":319,"_17911":42773,"_5":17806,"_24291":42723,"_2452":42774},[],"The Lamassu chart provides",{"_2926":340,"_25639":319,"_17911":42776,"_5":17806,"_24291":42723,"_2452":42777},[],"You provide",{"_2926":341,"_25639":319,"_17911":42779,"_5":17806,"_24291":42723,"_2452":42780},[],"Lamassu applications",{"_2926":342,"_25639":319,"_17911":42782,"_5":17806,"_24291":42723,"_2452":42783},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_2926":343,"_25639":319,"_17911":42785,"_5":17806,"_24291":42723,"_2452":42786},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_2926":344,"_25639":319,"_17911":42788,"_5":17806,"_24291":42723,"_2452":42789},[],"PostgreSQL data",{"_2926":345,"_25639":319,"_17911":42791,"_5":17806,"_24291":42723,"_2452":42792},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_2926":346,"_25639":319,"_17911":42794,"_5":17806,"_24291":42723,"_2452":42795},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_2926":347,"_25639":319,"_17911":42797,"_5":17806,"_24291":42723,"_2452":42798},[],"Messaging",{"_2926":348,"_25639":319,"_17911":42800,"_5":17806,"_24291":42723,"_2452":42801},[],"RabbitMQ connection configuration for the Lamassu services",{"_2926":349,"_25639":319,"_17911":42803,"_5":17806,"_24291":42723,"_2452":42804},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_2926":350,"_25639":319,"_17911":42806,"_5":17806,"_24291":42723,"_2452":42807},[],"Identity",{"_2926":351,"_25639":319,"_17911":42809,"_5":17806,"_24291":42723,"_2452":42810},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_2926":352,"_25639":319,"_17911":42812,"_5":17806,"_24291":42723,"_2452":42813},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_2926":353,"_25639":319,"_17911":42815,"_5":17806,"_24291":42723,"_2452":42816},[],"External routing",{"_2926":354,"_25639":319,"_17911":42818,"_5":17806,"_24291":42723,"_2452":42819},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_2926":355,"_25639":319,"_17911":42821,"_5":17806,"_24291":42723,"_2452":42822},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_2926":356,"_25639":319,"_17911":42824,"_5":17806,"_24291":42723,"_2452":42825},[],"TLS",{"_2926":357,"_25639":319,"_17911":42827,"_5":17806,"_24291":42723,"_2452":42828},[],"cert-manager `Issuer` and CA `Certificate` resources; either a chart-managed downstream `Certificate` or a reference to your TLS Secret",{"_2926":358,"_25639":319,"_17911":42830,"_5":17806,"_24291":42723,"_2452":42831},[],"cert-manager itself; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_2926":359,"_25639":319,"_17911":42833,"_5":17806,"_24291":42723,"_2452":42834},[],"Persistent application data",{"_2926":360,"_25639":319,"_17911":42836,"_5":17806,"_24291":42723,"_2452":42837},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_2926":361,"_25639":319,"_17911":42839,"_5":17806,"_24291":42723,"_2452":42840},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_2926":362,"_25639":319,"_17911":42842,"_5":17806,"_24291":42723,"_2452":42843},[],"Optional integrations",{"_2926":363,"_25639":319,"_17911":42845,"_5":17806,"_24291":42723,"_2452":42846},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_2926":364,"_25639":319,"_17911":42848,"_5":17806,"_24291":42723,"_2452":42849},[],"The observability backends, cloud credentials and production HSM or external key service",{"_2926":365,"_25639":319,"_17911":42851,"_5":17806,"_24291":42723,"_2452":42852},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_2926":366,"_25639":319,"_17911":42854,"_5":17806,"_24291":42723,"_2452":42855},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_2926":367,"_25639":319,"_17911":42857,"_5":17806,"_24291":42727,"_2452":42858},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_2926":368,"_25639":319,"_17911":42860,"_5":17806,"_24291":42727,"_2452":42861},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_2926":369,"_25639":319,"_17911":42863,"_5":17806,"_24291":42731,"_2452":42864},[],"Kubernetes 1.24 or newer",{"_2926":370,"_25639":319,"_17911":42866,"_5":17806,"_24291":42731,"_2452":42867},[],"Helm 3.2 or newer",{"_2926":371,"_25639":319,"_17911":42869,"_5":17806,"_24291":42731,"_2452":42870},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_2926":372,"_25639":319,"_17911":42872,"_5":17806,"_24291":42731,"_2452":42873},[],"cert-manager 1.14 or newer; the current chart renders cert-manager issuer and certificate resources",{"_2926":373,"_25639":319,"_17911":42875,"_5":17806,"_24291":42731,"_2452":42876},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_2926":374,"_25639":319,"_17911":42878,"_5":17806,"_24291":42731,"_2452":42879},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_2926":375,"_25639":319,"_17911":42881,"_5":17806,"_24291":42731,"_2452":42882},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_2926":376,"_25639":319,"_17911":42884,"_5":17806,"_24291":42735,"_2452":42885},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2926":377,"_25639":319,"_17911":42887,"_5":17806,"_24291":42735,"_2452":42888},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2926":378,"_25639":319,"_17911":42890,"_5":17806,"_24291":42735,"_2452":42891},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2926":379,"_25639":379,"_5":12558,"_2452":42893,"_25983":42894,"_17911":42896,"_24291":379},"Deployment troubleshooting",[41760,41761,42895],"Operations",[],{"_2926":380,"_25639":379,"_17911":42898,"_5":17806,"_24291":379,"_2452":42899},[],"Diagnose access, service health and infrastructure dependencies.",{"_2926":381,"_25639":379,"_5":25980,"_17911":42901,"_24291":42902,"_2452":42903},[],"/docs/pr-preview/pr-48/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_2926":382,"_25639":379,"_5":25980,"_17911":42905,"_24291":42906,"_2452":42907},[],"/docs/pr-preview/pr-48/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_2926":383,"_25639":379,"_5":25980,"_17911":42909,"_24291":42910,"_2452":42911},[],"/docs/pr-preview/pr-48/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_2926":384,"_25639":379,"_5":25980,"_17911":42913,"_24291":42914,"_2452":42915},[],"/docs/pr-preview/pr-48/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_2926":385,"_25639":379,"_5":25980,"_17911":42917,"_24291":42918,"_2452":42919},[],"/docs/pr-preview/pr-48/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_2926":386,"_25639":379,"_5":25980,"_17911":42921,"_24291":42922,"_2452":42923},[],"/docs/pr-preview/pr-48/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_2926":387,"_25639":379,"_5":25980,"_17911":42925,"_24291":42926,"_2452":42927},[],"/docs/pr-preview/pr-48/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_2926":388,"_25639":379,"_5":25980,"_17911":42929,"_24291":42930,"_2452":42931},[],"/docs/pr-preview/pr-48/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_2926":389,"_25639":379,"_5":25980,"_17911":42933,"_24291":42934,"_2452":42935},[],"/docs/pr-preview/pr-48/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_2926":390,"_25639":379,"_5":25980,"_17911":42937,"_24291":42938,"_2452":42939},[],"/docs/pr-preview/pr-48/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_2926":391,"_25639":379,"_5":25980,"_17911":42941,"_24291":42942,"_2452":42943},[],"/docs/pr-preview/pr-48/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_2926":392,"_25639":379,"_5":25980,"_17911":42945,"_24291":42946,"_2452":42947},[],"/docs/pr-preview/pr-48/deployment/troubleshooting#observability","Observability",{"_2926":393,"_25639":379,"_17911":42949,"_5":17806,"_24291":379,"_2452":42950},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_2926":394,"_25639":379,"_17911":42952,"_5":17806,"_24291":42906,"_2452":42953},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_2926":395,"_25639":379,"_17911":42955,"_5":17806,"_24291":42910,"_2452":42956},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_2926":396,"_25639":379,"_17911":42958,"_5":17806,"_24291":42914,"_2452":42959},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_2926":397,"_25639":379,"_17911":42961,"_5":17806,"_24291":42918,"_2452":42962},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_2926":398,"_25639":379,"_17911":42964,"_5":17806,"_24291":42922,"_2452":42965},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_2926":399,"_25639":379,"_17911":42967,"_5":17806,"_24291":42926,"_2452":42968},[],"Replace the placeholders with your real release, namespace and deployment.",{"_2926":400,"_25639":379,"_17911":42970,"_5":17806,"_24291":42926,"_2452":42971},[],"Also run the chart's connectivity test:",{"_2926":401,"_25639":379,"_17911":42973,"_5":17806,"_24291":42926,"_2452":42974},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_2926":402,"_25639":379,"_17911":42976,"_5":17806,"_24291":42926,"_2452":42977},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_2926":403,"_25639":379,"_17911":42979,"_5":17806,"_24291":42930,"_2452":42980},[],"If you receive a 401:",{"_2926":404,"_25639":379,"_17911":42982,"_5":17806,"_24291":42930,"_2452":42983},[],"check that the UI's OIDC authority is reachable from the browser;",{"_2926":405,"_25639":379,"_17911":42985,"_5":17806,"_24291":42930,"_2452":42986},[],"verify issuer, audience and expiration of the token;",{"_2926":406,"_25639":379,"_17911":42988,"_5":17806,"_24291":42930,"_2452":42989},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_2926":407,"_25639":379,"_17911":42991,"_5":17806,"_24291":42930,"_2452":42992},[],"check that the provider's public and internal routes point to the same realm.",{"_2926":408,"_25639":379,"_17911":42994,"_5":17806,"_24291":42930,"_2452":42995},[],"If login succeeds but the APIs return 403:",{"_2926":409,"_25639":379,"_17911":42997,"_5":17806,"_24291":42930,"_2452":42998},[],"inspect the token's real claims;",{"_2926":410,"_25639":379,"_17911":43000,"_5":17806,"_24291":42930,"_2452":43001},[],"confirm they match an active principal;",{"_2926":411,"_25639":379,"_17911":43003,"_5":17806,"_24291":42930,"_2452":43004},[],"review the policies granted to that principal;",{"_2926":412,"_25639":379,"_17911":43006,"_5":17806,"_24291":42930,"_2452":43007},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_2926":413,"_25639":379,"_17911":43009,"_5":17806,"_24291":42930,"_2452":43010},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_2926":414,"_25639":379,"_17911":43012,"_5":17806,"_24291":42934,"_2452":43013},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_2926":415,"_25639":379,"_17911":43015,"_5":17806,"_24291":42934,"_2452":43016},[],"Locate the authz pod and Service.",{"_2926":416,"_25639":379,"_17911":43018,"_5":17806,"_24291":42934,"_2452":43019},[],"Check /health, logs and its database connection.",{"_2926":417,"_25639":379,"_17911":43021,"_5":17806,"_24291":42934,"_2452":43022},[],"Verify the DNS and port configured in externalAuthorization.",{"_2926":418,"_25639":379,"_17911":43024,"_5":17806,"_24291":42934,"_2452":43025},[],"Check the check route is /v1/ext\\_authz/check.",{"_2926":419,"_25639":379,"_17911":43027,"_5":17806,"_24291":42934,"_2452":43028},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_2926":420,"_25639":379,"_17911":43030,"_5":17806,"_24291":42938,"_2452":43031},[],"Review kubectl describe pod first. Common causes are:",{"_2926":421,"_25639":379,"_17911":43033,"_5":17806,"_24291":42938,"_2452":43034},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_2926":422,"_25639":379,"_17911":43036,"_5":17806,"_24291":42938,"_2452":43037},[],"unbound persistent volume;",{"_2926":423,"_25639":379,"_17911":43039,"_5":17806,"_24291":42938,"_2452":43040},[],"inaccessible image or incorrect pull policy;",{"_2926":424,"_25639":379,"_17911":43042,"_5":17806,"_24291":42938,"_2452":43043},[],"invalid cryptographic engine configuration;",{"_2926":425,"_25639":379,"_17911":43045,"_5":17806,"_24291":42938,"_2452":43046},[],"CPU or memory limits set too low;",{"_2926":426,"_25639":379,"_17911":43048,"_5":17806,"_24291":42938,"_2452":43049},[],"an incomplete prior migration.",{"_2926":427,"_25639":379,"_17911":43051,"_5":17806,"_24291":42938,"_2452":43052},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_2926":428,"_25639":379,"_17911":43054,"_5":17806,"_24291":42938,"_2452":43055},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_2926":429,"_25639":379,"_17911":43057,"_5":17806,"_24291":42942,"_2452":43058},[],"Domain and audit events depend on the bus publisher:",{"_2926":430,"_25639":379,"_17911":43060,"_5":17806,"_24291":42942,"_2452":43061},[],"verify it is enabled in the emitting service;",{"_2926":431,"_25639":379,"_17911":43063,"_5":17806,"_24291":42942,"_2452":43064},[],"check AMQP connectivity and credentials;",{"_2926":432,"_25639":379,"_17911":43066,"_5":17806,"_24291":42942,"_2452":43067},[],"review exchange, routing key, queues and consumers;",{"_2926":433,"_25639":379,"_17911":43069,"_5":17806,"_24291":42942,"_2452":43070},[],"inspect dead-letter queues;",{"_2926":434,"_25639":379,"_17911":43072,"_5":17806,"_24291":42942,"_2452":43073},[],"alert on orphan durable queues and backlog growth.",{"_2926":435,"_25639":379,"_17911":43075,"_5":17806,"_24291":42942,"_2452":43076},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_2926":436,"_25639":379,"_17911":43078,"_5":17806,"_24291":42946,"_2452":43079},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_2926":437,"_25639":379,"_17911":43081,"_5":17806,"_24291":42946,"_2452":43082},[],"Before closing an incident, record:",{"_2926":438,"_25639":379,"_17911":43084,"_5":17806,"_24291":42946,"_2452":43085},[],"the confirmed cause;",{"_2926":439,"_25639":379,"_17911":43087,"_5":17806,"_24291":42946,"_2452":43088},[],"the time scope and affected resources;",{"_2926":440,"_25639":379,"_17911":43090,"_5":17806,"_24291":42946,"_2452":43091},[],"the commands or queries used;",{"_2926":441,"_25639":379,"_17911":43093,"_5":17806,"_24291":42946,"_2452":43094},[],"the applied change and how to revert it;",{"_2926":442,"_25639":379,"_17911":43096,"_5":17806,"_24291":42946,"_2452":43097},[],"validation from a consumer;",{"_2926":443,"_25639":379,"_17911":43099,"_5":17806,"_24291":42946,"_2452":43100},[],"the preventive action and its owner.",{"_2926":444,"_25639":444,"_5":12558,"_2452":43102,"_25983":43103,"_17911":43106,"_24291":444},"Access control",[41760,43104,43105],"Platform","Administration",[],{"_2926":445,"_25639":444,"_17911":43108,"_5":17806,"_24291":444,"_2452":43109},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_2926":446,"_25639":444,"_5":25980,"_17911":43111,"_24291":43112,"_2452":43113},[],"/docs/pr-preview/pr-48/platform/administration/access-control#essential-concepts","Essential concepts",{"_2926":447,"_25639":444,"_5":25980,"_17911":43115,"_24291":43116,"_2452":43117},[],"/docs/pr-preview/pr-48/platform/administration/access-control#two-decision-systems","Two decision systems",{"_2926":448,"_25639":444,"_5":25980,"_17911":43119,"_24291":43120,"_2452":43121},[],"/docs/pr-preview/pr-48/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_2926":449,"_25639":444,"_5":25980,"_17911":43123,"_24291":43124,"_2452":43125},[],"/docs/pr-preview/pr-48/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_2926":450,"_25639":444,"_5":25980,"_17911":43127,"_24291":43128,"_2452":43129},[],"/docs/pr-preview/pr-48/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_2926":451,"_25639":444,"_5":25980,"_17911":43131,"_24291":43132,"_2452":43133},[],"/docs/pr-preview/pr-48/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_2926":452,"_25639":444,"_5":25980,"_17911":43135,"_24291":43136,"_2452":43137},[],"/docs/pr-preview/pr-48/platform/administration/access-control#oidc-principals","OIDC principals",{"_2926":453,"_25639":444,"_5":25980,"_17911":43139,"_24291":43140,"_2452":43141},[],"/docs/pr-preview/pr-48/platform/administration/access-control#x509-principals","X.509 principals",{"_2926":454,"_25639":444,"_5":25980,"_17911":43143,"_24291":43144,"_2452":43145},[],"/docs/pr-preview/pr-48/platform/administration/access-control#when-several-principals-match","When several principals match",{"_2926":455,"_25639":444,"_5":25980,"_17911":43147,"_24291":43148,"_2452":43149},[],"/docs/pr-preview/pr-48/platform/administration/access-control#how-policies-express-access","How policies express access",{"_2926":456,"_25639":444,"_5":25980,"_17911":43151,"_24291":43152,"_2452":43153},[],"/docs/pr-preview/pr-48/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_2926":457,"_25639":444,"_5":25980,"_17911":43155,"_24291":43156,"_2452":43157},[],"/docs/pr-preview/pr-48/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_2926":458,"_25639":444,"_5":25980,"_17911":43159,"_24291":43160,"_2452":43161},[],"/docs/pr-preview/pr-48/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_2926":459,"_25639":444,"_5":25980,"_17911":43163,"_24291":43164,"_2452":43165},[],"/docs/pr-preview/pr-48/platform/administration/access-control#http-rules","HTTP rules",{"_2926":460,"_25639":444,"_5":25980,"_17911":43167,"_24291":43168,"_2452":43169},[],"/docs/pr-preview/pr-48/platform/administration/access-control#included-policies","Included policies",{"_2926":461,"_25639":444,"_5":25980,"_17911":43171,"_24291":43172,"_2452":42363},[],"/docs/pr-preview/pr-48/platform/administration/access-control#provision-the-first-administrator",{"_2926":462,"_25639":444,"_5":25980,"_17911":43174,"_24291":43175,"_2452":43176},[],"/docs/pr-preview/pr-48/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_2926":463,"_25639":444,"_5":25980,"_17911":43178,"_24291":43179,"_2452":43180},[],"/docs/pr-preview/pr-48/platform/administration/access-control#configure-the-two-jwt-validations","Configure the two JWT validations",{"_2926":464,"_25639":444,"_5":25980,"_17911":43182,"_24291":43183,"_2452":43184},[],"/docs/pr-preview/pr-48/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_2926":465,"_25639":444,"_5":25980,"_17911":43186,"_24291":43187,"_2452":43188},[],"/docs/pr-preview/pr-48/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_2926":466,"_25639":444,"_5":25980,"_17911":43190,"_24291":43191,"_2452":43192},[],"/docs/pr-preview/pr-48/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_2926":467,"_25639":444,"_5":25980,"_17911":43194,"_24291":43195,"_2452":43196},[],"/docs/pr-preview/pr-48/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_2926":468,"_25639":444,"_5":25980,"_17911":43198,"_24291":43199,"_2452":43200},[],"/docs/pr-preview/pr-48/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_2926":469,"_25639":444,"_5":25980,"_17911":43202,"_24291":43203,"_2452":43204},[],"/docs/pr-preview/pr-48/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_2926":470,"_25639":444,"_5":25980,"_17911":43206,"_24291":43207,"_2452":43208},[],"/docs/pr-preview/pr-48/platform/administration/access-control#operational-checklist","Operational checklist",{"_2926":471,"_25639":444,"_5":25980,"_17911":43210,"_24291":43211,"_2452":43212},[],"/docs/pr-preview/pr-48/platform/administration/access-control#diagnostics","Diagnostics",{"_2926":472,"_25639":444,"_5":25980,"_17911":43214,"_24291":43215,"_2452":43216},[],"/docs/pr-preview/pr-48/platform/administration/access-control#the-response-is-401","The response is 401",{"_2926":473,"_25639":444,"_5":25980,"_17911":43218,"_24291":43219,"_2452":43220},[],"/docs/pr-preview/pr-48/platform/administration/access-control#the-response-is-403","The response is 403",{"_2926":474,"_25639":444,"_5":25980,"_17911":43222,"_24291":43223,"_2452":43224},[],"/docs/pr-preview/pr-48/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_2926":475,"_25639":444,"_5":25980,"_17911":43226,"_24291":43227,"_2452":43228},[],"/docs/pr-preview/pr-48/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_2926":476,"_25639":444,"_5":25980,"_17911":43230,"_24291":43231,"_2452":43232},[],"/docs/pr-preview/pr-48/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_2926":477,"_25639":444,"_17911":43234,"_5":17806,"_24291":444,"_2452":43235},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_2926":478,"_25639":444,"_17911":43237,"_5":17806,"_24291":444,"_2452":43238},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_2926":479,"_25639":444,"_17911":43240,"_5":17806,"_24291":444,"_2452":43241},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_2926":480,"_25639":444,"_17911":43243,"_5":17806,"_24291":43112,"_2452":43244},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_2926":481,"_25639":444,"_17911":43246,"_5":17806,"_24291":43112,"_2452":43247},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_2926":482,"_25639":444,"_17911":43249,"_5":17806,"_24291":43112,"_2452":43250},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_2926":483,"_25639":444,"_17911":43252,"_5":17806,"_24291":43112,"_2452":43253},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_2926":484,"_25639":444,"_17911":43255,"_5":17806,"_24291":43112,"_2452":43256},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_2926":485,"_25639":444,"_17911":43258,"_5":17806,"_24291":43112,"_2452":43259},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_2926":486,"_25639":444,"_17911":43261,"_5":17806,"_24291":43116,"_2452":43262},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_2926":487,"_25639":444,"_17911":43264,"_5":17806,"_24291":43116,"_2452":43265},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_2926":488,"_25639":444,"_17911":43267,"_5":17806,"_24291":43120,"_2452":43268},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_2926":489,"_25639":444,"_17911":43270,"_5":17806,"_24291":43120,"_2452":43271},[],"The decision is made **before forwarding the request to the service**:",{"_2926":490,"_25639":444,"_17911":43273,"_5":17806,"_24291":43120,"_2452":43274},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_2926":491,"_25639":444,"_17911":43276,"_5":17806,"_24291":43120,"_2452":43277},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_2926":492,"_25639":444,"_17911":43279,"_5":17806,"_24291":43120,"_2452":43280},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_2926":493,"_25639":444,"_17911":43282,"_5":17806,"_24291":43120,"_2452":43283},[],"It separately loads the policies granted to each principal.",{"_2926":494,"_25639":444,"_17911":43285,"_5":17806,"_24291":43120,"_2452":43286},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_2926":495,"_25639":444,"_17911":43288,"_5":17806,"_24291":43120,"_2452":43289},[],"`authz` looks for an HTTP rule granting that action.",{"_2926":496,"_25639":444,"_17911":43291,"_5":17806,"_24291":43120,"_2452":43292},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_2926":497,"_25639":444,"_17911":43294,"_5":17806,"_24291":43120,"_2452":43295},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_2926":498,"_25639":444,"_17911":43297,"_5":17806,"_24291":43120,"_2452":43298},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_2926":499,"_25639":444,"_17911":43300,"_5":17806,"_24291":43120,"_2452":43301},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_2926":500,"_25639":444,"_17911":43303,"_5":17806,"_24291":43124,"_2452":43304},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_2926":501,"_25639":444,"_17911":43306,"_5":17806,"_24291":43124,"_2452":43307},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_2926":502,"_25639":444,"_17911":43309,"_5":17806,"_24291":43124,"_2452":43310},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_2926":503,"_25639":444,"_17911":43312,"_5":17806,"_24291":43124,"_2452":43313},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_2926":504,"_25639":444,"_17911":43315,"_5":17806,"_24291":43124,"_2452":43316},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_2926":505,"_25639":444,"_17911":43318,"_5":17806,"_24291":43124,"_2452":43319},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_2926":506,"_25639":444,"_17911":43321,"_5":17806,"_24291":43124,"_2452":43322},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_2926":507,"_25639":444,"_17911":43324,"_5":17806,"_24291":43124,"_2452":43325},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_2926":508,"_25639":444,"_17911":43327,"_5":17806,"_24291":43128,"_2452":43328},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_2926":509,"_25639":444,"_17911":43330,"_5":17806,"_24291":43128,"_2452":43331},[],"The decision is made with the domain operation context:",{"_2926":510,"_25639":444,"_17911":43333,"_5":17806,"_24291":43128,"_2452":43334},[],"The middleware extracts the credential and resolves the matching principals.",{"_2926":511,"_25639":444,"_17911":43336,"_5":17806,"_24291":43128,"_2452":43337},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_2926":512,"_25639":444,"_17911":43339,"_5":17806,"_24291":43128,"_2452":43340},[],"`authz` gathers the entity rules of the granted policies.",{"_2926":513,"_25639":444,"_17911":43342,"_5":17806,"_24291":43128,"_2452":43343},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_2926":514,"_25639":444,"_17911":43345,"_5":17806,"_24291":43128,"_2452":43346},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_2926":515,"_25639":444,"_17911":43348,"_5":17806,"_24291":43128,"_2452":43349},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_2926":516,"_25639":444,"_17911":43351,"_5":17806,"_24291":43128,"_2452":43352},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_2926":517,"_25639":444,"_17911":43354,"_5":17806,"_24291":43128,"_2452":43355},[],"Actions fall into two groups:",{"_2926":518,"_25639":444,"_17911":43357,"_5":17806,"_24291":43128,"_2452":43358},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_2926":519,"_25639":444,"_17911":43360,"_5":17806,"_24291":43128,"_2452":43361},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_2926":520,"_25639":444,"_17911":43363,"_5":17806,"_24291":43128,"_2452":43364},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_2926":521,"_25639":444,"_17911":43366,"_5":17806,"_24291":43132,"_2452":43367},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_2926":522,"_25639":444,"_17911":43369,"_5":17806,"_24291":43132,"_2452":43370},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_2926":523,"_25639":444,"_17911":43372,"_5":17806,"_24291":43132,"_2452":43373},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_2926":524,"_25639":444,"_17911":43375,"_5":17806,"_24291":43136,"_2452":43376},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_2926":525,"_25639":444,"_17911":43378,"_5":17806,"_24291":43136,"_2452":43379},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_2926":526,"_25639":444,"_17911":43381,"_5":17806,"_24291":43136,"_2452":43382},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_2926":527,"_25639":444,"_17911":43384,"_5":17806,"_24291":43136,"_2452":43385},[],"The implemented operators are:",{"_2926":528,"_25639":444,"_17911":43387,"_5":17806,"_24291":43136,"_2452":43388},[],"`equals`, for exact equality;",{"_2926":529,"_25639":444,"_17911":43390,"_5":17806,"_24291":43136,"_2452":43391},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_2926":530,"_25639":444,"_17911":43393,"_5":17806,"_24291":43136,"_2452":43394},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_2926":531,"_25639":444,"_17911":43396,"_5":17806,"_24291":43136,"_2452":43397},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_2926":532,"_25639":444,"_17911":43399,"_5":17806,"_24291":43140,"_2452":43400},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_2926":533,"_25639":444,"_17911":43402,"_5":17806,"_24291":43140,"_2452":43403},[],"The available modes are:",{"_2926":534,"_25639":444,"_17911":43405,"_5":17806,"_24291":43140,"_2452":43406},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_2926":535,"_25639":444,"_17911":43408,"_5":17806,"_24291":43140,"_2452":43409},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_2926":536,"_25639":444,"_17911":43411,"_5":17806,"_24291":43140,"_2452":43412},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_2926":537,"_25639":444,"_17911":43414,"_5":17806,"_24291":43140,"_2452":43415},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_2926":538,"_25639":444,"_17911":43417,"_5":17806,"_24291":43140,"_2452":43418},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_2926":539,"_25639":444,"_17911":43420,"_5":17806,"_24291":43140,"_2452":43421},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_2926":540,"_25639":444,"_17911":43423,"_5":17806,"_24291":43144,"_2452":43424},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_2926":541,"_25639":444,"_17911":43426,"_5":17806,"_24291":43144,"_2452":43427},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_2926":542,"_25639":444,"_17911":43429,"_5":17806,"_24291":43144,"_2452":43430},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_2926":543,"_25639":444,"_17911":43432,"_5":17806,"_24291":43144,"_2452":43433},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_2926":544,"_25639":444,"_17911":43435,"_5":17806,"_24291":43152,"_2452":43436},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_2926":545,"_25639":444,"_17911":43438,"_5":17806,"_24291":43152,"_2452":43439},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_2926":546,"_25639":444,"_17911":43441,"_5":17806,"_24291":43156,"_2452":43442},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_2926":547,"_25639":444,"_17911":43444,"_5":17806,"_24291":43156,"_2452":43445},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_2926":548,"_25639":444,"_17911":43447,"_5":17806,"_24291":43160,"_2452":43448},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_2926":549,"_25639":444,"_17911":43450,"_5":17806,"_24291":43160,"_2452":43451},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_2926":550,"_25639":444,"_17911":43453,"_5":17806,"_24291":43160,"_2452":43454},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_2926":551,"_25639":444,"_17911":43456,"_5":17806,"_24291":43164,"_2452":43457},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_2926":552,"_25639":444,"_17911":43459,"_5":17806,"_24291":43164,"_2452":43460},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_2926":553,"_25639":444,"_17911":43462,"_5":17806,"_24291":43164,"_2452":43463},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_2926":554,"_25639":444,"_17911":43465,"_5":17806,"_24291":43164,"_2452":43466},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_2926":555,"_25639":444,"_17911":43468,"_5":17806,"_24291":43164,"_2452":43469},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_2926":556,"_25639":444,"_17911":43471,"_5":17806,"_24291":43164,"_2452":43472},[],"Note that:",{"_2926":557,"_25639":444,"_17911":43474,"_5":17806,"_24291":43164,"_2452":43475},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_2926":558,"_25639":444,"_17911":43477,"_5":17806,"_24291":43164,"_2452":43478},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_2926":559,"_25639":444,"_17911":43480,"_5":17806,"_24291":43164,"_2452":43481},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_2926":560,"_25639":444,"_17911":43483,"_5":17806,"_24291":43168,"_2452":43484},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_2926":561,"_25639":444,"_17911":43486,"_5":17806,"_24291":43168,"_2452":43487},[],"full and read-only access to certificates and authorities;",{"_2926":562,"_25639":444,"_17911":43489,"_5":17806,"_24291":43168,"_2452":43490},[],"full and read-only access to the KMS;",{"_2926":563,"_25639":444,"_17911":43492,"_5":17806,"_24291":43168,"_2452":43493},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_2926":564,"_25639":444,"_17911":43495,"_5":17806,"_24291":43168,"_2452":43496},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_2926":565,"_25639":444,"_17911":43498,"_5":17806,"_24291":43168,"_2452":43499},[],"console access;",{"_2926":566,"_25639":444,"_17911":43501,"_5":17806,"_24291":43168,"_2452":43502},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_2926":567,"_25639":444,"_17911":43504,"_5":17806,"_24291":43168,"_2452":43505},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_2926":568,"_25639":444,"_17911":43507,"_5":17806,"_24291":43168,"_2452":43508},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_2926":569,"_25639":444,"_17911":43510,"_5":17806,"_24291":43172,"_2452":43511},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_2926":570,"_25639":444,"_17911":43513,"_5":17806,"_24291":43172,"_2452":43514},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_2926":571,"_25639":444,"_17911":43516,"_5":17806,"_24291":43172,"_2452":43517},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_2926":572,"_25639":444,"_17911":43519,"_5":17806,"_24291":43175,"_2452":43520},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_2926":573,"_25639":444,"_17911":43522,"_5":17806,"_24291":43179,"_2452":43523},[],"The Gateway uses `auth.authentication.apiGateway.jwks` to authenticate requests. `authz` uses `services.authz.jwkUrl` to resolve OIDC principals. Both endpoints must contain the keys of the same issuer and be reachable from their respective components.",{"_2926":574,"_25639":444,"_17911":43525,"_5":17806,"_24291":43183,"_2452":43526},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_2926":575,"_25639":444,"_17911":43528,"_5":17806,"_24291":43187,"_2452":43529},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_2926":576,"_25639":444,"_17911":43531,"_5":17806,"_24291":43191,"_2452":43532},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_2926":577,"_25639":444,"_17911":43534,"_5":17806,"_24291":43195,"_2452":43535},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_2926":578,"_25639":444,"_17911":43537,"_5":17806,"_24291":43195,"_2452":43538},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_2926":579,"_25639":444,"_17911":43540,"_5":17806,"_24291":43199,"_2452":43541},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_2926":580,"_25639":444,"_17911":43543,"_5":17806,"_24291":43199,"_2452":43544},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_2926":581,"_25639":444,"_17911":43546,"_5":17806,"_24291":43199,"_2452":43547},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_2926":582,"_25639":444,"_17911":43549,"_5":17806,"_24291":43199,"_2452":43550},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_2926":583,"_25639":444,"_17911":43552,"_5":17806,"_24291":43199,"_2452":43553},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_2926":584,"_25639":444,"_17911":43555,"_5":17806,"_24291":43199,"_2452":43556},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_2926":585,"_25639":444,"_17911":43558,"_5":17806,"_24291":43199,"_2452":43559},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_2926":586,"_25639":444,"_17911":43561,"_5":17806,"_24291":43199,"_2452":43562},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_2926":587,"_25639":444,"_17911":43564,"_5":17806,"_24291":43203,"_2452":43565},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_2926":588,"_25639":444,"_17911":43567,"_5":17806,"_24291":43203,"_2452":43568},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_2926":589,"_25639":444,"_17911":43570,"_5":17806,"_24291":43203,"_2452":43571},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_2926":590,"_25639":444,"_17911":43573,"_5":17806,"_24291":43207,"_2452":43574},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_2926":591,"_25639":444,"_17911":43576,"_5":17806,"_24291":43207,"_2452":43577},[],"Use groups or stable roles for people and independent identities for automations.",{"_2926":592,"_25639":444,"_17911":43579,"_5":17806,"_24291":43207,"_2452":43580},[],"Keep at least two recovery administrators and test their access periodically.",{"_2926":593,"_25639":444,"_17911":43582,"_5":17806,"_24291":43207,"_2452":43583},[],"Review active principals, their matches and their grants after IdP changes.",{"_2926":594,"_25639":444,"_17911":43585,"_5":17806,"_24291":43207,"_2452":43586},[],"Search for wildcards in policies before upgrading Lamassu.",{"_2926":595,"_25639":444,"_17911":43588,"_5":17806,"_24291":43207,"_2452":43589},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_2926":596,"_25639":444,"_17911":43591,"_5":17806,"_24291":43207,"_2452":43592},[],"Always test one allowed and one denied operation for each role.",{"_2926":597,"_25639":444,"_17911":43594,"_5":17806,"_24291":43207,"_2452":43595},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_2926":598,"_25639":444,"_17911":43597,"_5":17806,"_24291":43215,"_2452":43598},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_2926":599,"_25639":444,"_17911":43600,"_5":17806,"_24291":43219,"_2452":43601},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_2926":600,"_25639":444,"_17911":43603,"_5":17806,"_24291":43219,"_2452":43604},[],"that an active principal of the correct type exists;",{"_2926":601,"_25639":444,"_17911":43606,"_5":17806,"_24291":43219,"_2452":43607},[],"that the claim paths and values match the real token exactly;",{"_2926":602,"_25639":444,"_17911":43609,"_5":17806,"_24291":43219,"_2452":43610},[],"that all of the principal's conditions hold;",{"_2926":603,"_25639":444,"_17911":43612,"_5":17806,"_24291":43219,"_2452":43613},[],"that the principal has the expected policy granted;",{"_2926":604,"_25639":444,"_17911":43615,"_5":17806,"_24291":43219,"_2452":43616},[],"that the policy includes the action and the requested resource type or route;",{"_2926":605,"_25639":444,"_17911":43618,"_5":17806,"_24291":43219,"_2452":43619},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_2926":606,"_25639":444,"_17911":43621,"_5":17806,"_24291":43219,"_2452":43622},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_2926":607,"_25639":444,"_17911":43624,"_5":17806,"_24291":43223,"_2452":43625},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_2926":608,"_25639":444,"_17911":43627,"_5":17806,"_24291":43227,"_2452":43628},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_2926":609,"_25639":444,"_17911":43630,"_5":17806,"_24291":43231,"_2452":43631},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_2926":610,"_25639":444,"_17911":43633,"_5":17806,"_24291":43231,"_2452":43634},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_2926":611,"_25639":611,"_5":12558,"_2452":43636,"_25983":43637,"_17911":43638,"_24291":611},"Alerts and subscriptions",[41760,43104,43105],[],{"_2926":612,"_25639":611,"_17911":43640,"_5":17806,"_24291":611,"_2452":43641},[],"Send PKI events to people and external systems.",{"_2926":613,"_25639":611,"_5":25980,"_17911":43643,"_24291":43644,"_2452":43645},[],"/docs/pr-preview/pr-48/platform/administration/alerts#how-it-works","How it works",{"_2926":614,"_25639":611,"_5":25980,"_17911":43647,"_24291":43648,"_2452":43649},[],"/docs/pr-preview/pr-48/platform/administration/alerts#available-channels","Available channels",{"_2926":615,"_25639":611,"_5":25980,"_17911":43651,"_24291":43652,"_2452":43653},[],"/docs/pr-preview/pr-48/platform/administration/alerts#create-a-subscription","Create a subscription",{"_2926":616,"_25639":611,"_5":25980,"_17911":43655,"_24291":43656,"_2452":43657},[],"/docs/pr-preview/pr-48/platform/administration/alerts#choose-the-event","Choose the event",{"_2926":617,"_25639":611,"_5":25980,"_17911":43659,"_24291":43660,"_2452":43661},[],"/docs/pr-preview/pr-48/platform/administration/alerts#configure-the-destination","Configure the destination",{"_2926":618,"_25639":611,"_5":25980,"_17911":43663,"_24291":43664,"_2452":43665},[],"/docs/pr-preview/pr-48/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_2926":619,"_25639":611,"_5":25980,"_17911":43667,"_24291":43668,"_2452":43669},[],"/docs/pr-preview/pr-48/platform/administration/alerts#review-and-activate","Review and activate",{"_2926":620,"_25639":611,"_5":25980,"_17911":43671,"_24291":43672,"_2452":43673},[],"/docs/pr-preview/pr-48/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_2926":621,"_25639":611,"_5":25980,"_17911":43675,"_24291":43676,"_2452":43677},[],"/docs/pr-preview/pr-48/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_2926":622,"_25639":611,"_5":25980,"_17911":43679,"_24291":43680,"_2452":43681},[],"/docs/pr-preview/pr-48/platform/administration/alerts#event-families","Event families",{"_2926":623,"_25639":611,"_17911":43683,"_5":17806,"_24291":611,"_2452":43684},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_2926":624,"_25639":611,"_17911":43686,"_5":17806,"_24291":43644,"_2452":43687},[],"A service publishes a domain event.",{"_2926":625,"_25639":611,"_17911":43689,"_5":17806,"_24291":43644,"_2452":43690},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_2926":626,"_25639":611,"_17911":43692,"_5":17806,"_24291":43644,"_2452":43693},[],"Each subscription's filter decides whether it should be notified.",{"_2926":627,"_25639":611,"_17911":43695,"_5":17806,"_24291":43644,"_2452":43696},[],"Lamassu delivers the event to the configured channel.",{"_2926":628,"_25639":611,"_17911":43698,"_5":17806,"_24291":43644,"_2452":43699},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_2926":629,"_25639":611,"_17911":43701,"_5":17806,"_24291":43648,"_2452":43702},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_2926":630,"_25639":611,"_17911":43704,"_5":17806,"_24291":43648,"_2452":43705},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_2926":631,"_25639":611,"_17911":43707,"_5":17806,"_24291":43648,"_2452":43708},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_2926":632,"_25639":611,"_17911":43710,"_5":17806,"_24291":43648,"_2452":43711},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_2926":633,"_25639":611,"_17911":43713,"_5":17806,"_24291":43648,"_2452":43714},[],"`apikey_options` requires `header` and `key`.",{"_2926":634,"_25639":611,"_17911":43716,"_5":17806,"_24291":43648,"_2452":43717},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_2926":635,"_25639":611,"_17911":43719,"_5":17806,"_24291":43648,"_2452":43720},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_2926":636,"_25639":611,"_17911":43722,"_5":17806,"_24291":43648,"_2452":43723},[],"The alerts API reference documents the full `http_client` schema.",{"_2926":637,"_25639":611,"_17911":43725,"_5":17806,"_24291":43656,"_2452":43726},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_2926":638,"_25639":611,"_17911":43728,"_5":17806,"_24291":43660,"_2452":43729},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_2926":639,"_25639":611,"_17911":43731,"_5":17806,"_24291":43664,"_2452":43732},[],"Add a filter if you don't want to receive every instance of the event.",{"_2926":640,"_25639":611,"_17911":43734,"_5":17806,"_24291":43664,"_2452":43735},[],"**None** notifies all instances of the event.",{"_2926":641,"_25639":611,"_17911":43737,"_5":17806,"_24291":43664,"_2452":43738},[],"**JSON Path** evaluates one or more specific fields.",{"_2926":642,"_25639":611,"_17911":43740,"_5":17806,"_24291":43664,"_2452":43741},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_2926":643,"_25639":611,"_17911":43743,"_5":17806,"_24291":43664,"_2452":43744},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_2926":644,"_25639":611,"_17911":43746,"_5":17806,"_24291":43664,"_2452":43747},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_2926":645,"_25639":611,"_17911":43749,"_5":17806,"_24291":43668,"_2452":43750},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_2926":646,"_25639":611,"_17911":43752,"_5":17806,"_24291":43672,"_2452":43753},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_2926":647,"_25639":611,"_17911":43755,"_5":17806,"_24291":43672,"_2452":43756},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_2926":648,"_25639":611,"_17911":43758,"_5":17806,"_24291":43672,"_2452":43759},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_2926":649,"_25639":611,"_17911":43761,"_5":17806,"_24291":43672,"_2452":43762},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_2926":650,"_25639":611,"_17911":43764,"_5":17806,"_24291":43672,"_2452":43765},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_2926":651,"_25639":611,"_17911":43767,"_5":17806,"_24291":43672,"_2452":43768},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_2926":652,"_25639":611,"_17911":43770,"_5":17806,"_24291":43672,"_2452":43771},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_2926":653,"_25639":611,"_17911":43773,"_5":17806,"_24291":43672,"_2452":43774},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_2926":654,"_25639":611,"_17911":43776,"_5":17806,"_24291":43676,"_2452":43777},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_2926":655,"_25639":611,"_17911":43779,"_5":17806,"_24291":43680,"_2452":43780},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_2926":656,"_25639":611,"_17911":43782,"_5":17806,"_24291":43680,"_2452":43783},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_2926":657,"_25639":611,"_17911":43785,"_5":17806,"_24291":43680,"_2452":43786},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_2926":658,"_25639":611,"_17911":43788,"_5":17806,"_24291":43680,"_2452":43789},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_2926":659,"_25639":611,"_17911":43791,"_5":17806,"_24291":43680,"_2452":43792},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_2926":660,"_25639":611,"_17911":43794,"_5":17806,"_24291":43680,"_2452":43795},[],"**Validation:** `va.role.crl.create`.",{"_2926":661,"_25639":611,"_17911":43797,"_5":17806,"_24291":43680,"_2452":43798},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_2926":662,"_25639":611,"_17911":43800,"_5":17806,"_24291":43680,"_2452":43801},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_2926":663,"_25639":663,"_5":12558,"_2452":43803,"_25983":43804,"_17911":43805,"_24291":663},"Audit logs",[41760,43104,43105],[],{"_2926":664,"_25639":663,"_17911":43807,"_5":17806,"_24291":663,"_2452":43808},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_2926":665,"_25639":663,"_5":25980,"_17911":43810,"_24291":43811,"_2452":43812},[],"/docs/pr-preview/pr-48/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_2926":666,"_25639":663,"_5":25980,"_17911":43814,"_24291":43815,"_2452":43816},[],"/docs/pr-preview/pr-48/platform/administration/audit-logs#coverage","Coverage",{"_2926":667,"_25639":663,"_5":25980,"_17911":43818,"_24291":43819,"_2452":43820},[],"/docs/pr-preview/pr-48/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_2926":668,"_25639":663,"_5":25980,"_17911":43822,"_24291":43823,"_2452":43824},[],"/docs/pr-preview/pr-48/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_2926":669,"_25639":663,"_5":25980,"_17911":43826,"_24291":43827,"_2452":43828},[],"/docs/pr-preview/pr-48/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_2926":670,"_25639":663,"_5":25980,"_17911":43830,"_24291":43831,"_2452":43832},[],"/docs/pr-preview/pr-48/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_2926":671,"_25639":663,"_5":25980,"_17911":43834,"_24291":43835,"_2452":43836},[],"/docs/pr-preview/pr-48/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_2926":672,"_25639":663,"_5":25980,"_17911":43838,"_24291":43839,"_2452":43840},[],"/docs/pr-preview/pr-48/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_2926":673,"_25639":663,"_5":25980,"_17911":43842,"_24291":43843,"_2452":43844},[],"/docs/pr-preview/pr-48/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_2926":674,"_25639":663,"_5":25980,"_17911":43846,"_24291":43847,"_2452":43848},[],"/docs/pr-preview/pr-48/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_2926":675,"_25639":663,"_5":25980,"_17911":43850,"_24291":43851,"_2452":43852},[],"/docs/pr-preview/pr-48/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_2926":676,"_25639":663,"_17911":43854,"_5":17806,"_24291":663,"_2452":43855},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_2926":677,"_25639":663,"_17911":43857,"_5":17806,"_24291":43811,"_2452":43858},[],"The audit body includes:",{"_2926":678,"_25639":663,"_17911":43860,"_5":17806,"_24291":43811,"_2452":43861},[],"input: data received by the operation;",{"_2926":679,"_25639":663,"_17911":43863,"_5":17806,"_24291":43811,"_2452":43864},[],"has\\_error: whether the service returned an error;",{"_2926":680,"_25639":663,"_17911":43866,"_5":17806,"_24291":43811,"_2452":43867},[],"output: produced result or error message;",{"_2926":681,"_25639":663,"_17911":43869,"_5":17806,"_24291":43811,"_2452":43870},[],"principals: identifiers of the principals that matched the request.",{"_2926":682,"_25639":663,"_17911":43872,"_5":17806,"_24291":43811,"_2452":43873},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_2926":683,"_25639":663,"_17911":43875,"_5":17806,"_24291":43811,"_2452":43876},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_2926":684,"_25639":663,"_17911":43878,"_5":17806,"_24291":43815,"_2452":43879},[],"The backend applies auditing to mutations of:",{"_2926":685,"_25639":663,"_17911":43881,"_5":17806,"_24291":43815,"_2452":43882},[],"authorities, certificates and issuance profiles;",{"_2926":686,"_25639":663,"_17911":43884,"_5":17806,"_24291":43815,"_2452":43885},[],"keys and KMS engines;",{"_2926":687,"_25639":663,"_17911":43887,"_5":17806,"_24291":43815,"_2452":43888},[],"devices and identities;",{"_2926":688,"_25639":663,"_17911":43890,"_5":17806,"_24291":43815,"_2452":43891},[],"DMSs and enrollment operations;",{"_2926":689,"_25639":663,"_17911":43893,"_5":17806,"_24291":43815,"_2452":43894},[],"validation functions and CRL;",{"_2926":690,"_25639":663,"_17911":43896,"_5":17806,"_24291":43815,"_2452":43897},[],"principals, policies and authorization grants.",{"_2926":691,"_25639":663,"_17911":43899,"_5":17806,"_24291":43815,"_2452":43900},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_2926":692,"_25639":663,"_17911":43902,"_5":17806,"_24291":43819,"_2452":43903},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_2926":693,"_25639":663,"_17911":43905,"_5":17806,"_24291":43819,"_2452":43906},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_2926":694,"_25639":663,"_17911":43908,"_5":17806,"_24291":43819,"_2452":43909},[],"Design the consumer to:",{"_2926":695,"_25639":663,"_17911":43911,"_5":17806,"_24291":43819,"_2452":43912},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_2926":696,"_25639":663,"_17911":43914,"_5":17806,"_24291":43819,"_2452":43915},[],"keep the complete CloudEvent unmodified;",{"_2926":697,"_25639":663,"_17911":43917,"_5":17806,"_24291":43819,"_2452":43918},[],"record the ingestion time and detect duplicates by ID;",{"_2926":698,"_25639":663,"_17911":43920,"_5":17806,"_24291":43819,"_2452":43921},[],"encrypt in transit and at rest;",{"_2926":699,"_25639":663,"_17911":43923,"_5":17806,"_24291":43819,"_2452":43924},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_2926":700,"_25639":663,"_17911":43926,"_5":17806,"_24291":43819,"_2452":43927},[],"apply an explicit retention and legal hold policy;",{"_2926":701,"_25639":663,"_17911":43929,"_5":17806,"_24291":43819,"_2452":43930},[],"alert if it stops consuming or the pending queue grows.",{"_2926":702,"_25639":663,"_17911":43932,"_5":17806,"_24291":43823,"_2452":43933},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_2926":703,"_25639":663,"_17911":43935,"_5":17806,"_24291":43823,"_2452":43936},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_2926":704,"_25639":663,"_17911":43938,"_5":17806,"_24291":43831,"_2452":43939},[],"Start from the reported time and normalize every source to UTC.",{"_2926":705,"_25639":663,"_17911":43941,"_5":17806,"_24291":43835,"_2452":43942},[],"Filter by event type, service source and resource identifier.",{"_2926":706,"_25639":663,"_17911":43944,"_5":17806,"_24291":43839,"_2452":43945},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_2926":707,"_25639":663,"_17911":43947,"_5":17806,"_24291":43843,"_2452":43948},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_2926":708,"_25639":663,"_17911":43950,"_5":17806,"_24291":43847,"_2452":43951},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_2926":709,"_25639":663,"_17911":43953,"_5":17806,"_24291":43851,"_2452":43954},[],"Generate a controlled mutation in a test environment and check that:",{"_2926":710,"_25639":663,"_17911":43956,"_5":17806,"_24291":43851,"_2452":43957},[],"a successful audit event appears;",{"_2926":711,"_25639":663,"_17911":43959,"_5":17806,"_24291":43851,"_2452":43960},[],"the principal matches the identity used;",{"_2926":712,"_25639":663,"_17911":43962,"_5":17806,"_24291":43851,"_2452":43963},[],"the consumer persists it exactly once;",{"_2926":713,"_25639":663,"_17911":43965,"_5":17806,"_24291":43851,"_2452":43966},[],"it can be retrieved by resource, actor and period;",{"_2926":714,"_25639":663,"_17911":43968,"_5":17806,"_24291":43851,"_2452":43969},[],"a consumer outage raises an alert.",{"_2926":715,"_25639":663,"_17911":43971,"_5":17806,"_24291":43851,"_2452":43972},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_2926":716,"_25639":716,"_5":12558,"_2452":43974,"_25983":43975,"_17911":43976,"_24291":716},"Platform architecture",[41760,43104],[],{"_2926":717,"_25639":716,"_17911":43978,"_5":17806,"_24291":716,"_2452":43979},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_2926":718,"_25639":716,"_5":25980,"_17911":43981,"_24291":43982,"_2452":43983},[],"/docs/pr-preview/pr-48/platform/concepts/architecture#control-plane","Control plane",{"_2926":719,"_25639":716,"_5":25980,"_17911":43985,"_24291":43986,"_2452":43987},[],"/docs/pr-preview/pr-48/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_2926":720,"_25639":716,"_5":25980,"_17911":43989,"_24291":43990,"_2452":43991},[],"/docs/pr-preview/pr-48/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_2926":721,"_25639":716,"_5":25980,"_17911":43993,"_24291":43994,"_2452":43995},[],"/docs/pr-preview/pr-48/platform/concepts/architecture#status-and-validation","Status and validation",{"_2926":722,"_25639":716,"_5":25980,"_17911":43997,"_24291":43998,"_2452":43999},[],"/docs/pr-preview/pr-48/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_2926":723,"_25639":716,"_17911":44001,"_5":17806,"_24291":716,"_2452":44002},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_2926":724,"_25639":716,"_17911":44004,"_5":17806,"_24291":716,"_2452":44005},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_2926":725,"_25639":716,"_17911":44007,"_5":17806,"_24291":43982,"_2452":44008},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_2926":726,"_25639":716,"_17911":44010,"_5":17806,"_24291":43986,"_2452":44011},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_2926":727,"_25639":716,"_17911":44013,"_5":17806,"_24291":43990,"_2452":44014},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_2926":728,"_25639":716,"_17911":44016,"_5":17806,"_24291":43994,"_2452":44017},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_2926":729,"_25639":716,"_17911":44019,"_5":17806,"_24291":43998,"_2452":44020},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_2926":730,"_25639":730,"_5":12558,"_2452":44022,"_25983":44023,"_17911":44024,"_24291":730},"How Lamassu works",[41760,43104],[],{"_2926":731,"_25639":730,"_17911":44026,"_5":17806,"_24291":730,"_2452":44027},[],"The mental model of trust, keys, certificates and devices.",{"_2926":732,"_25639":730,"_5":25980,"_17911":44029,"_24291":44030,"_2452":44031},[],"/docs/pr-preview/pr-48/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_2926":733,"_25639":730,"_5":25980,"_17911":44033,"_24291":44034,"_2452":44035},[],"/docs/pr-preview/pr-48/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_2926":734,"_25639":730,"_17911":44037,"_5":17806,"_24291":730,"_2452":44038},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_2926":735,"_25639":730,"_17911":44040,"_5":17806,"_24291":44030,"_2452":44041},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_2926":736,"_25639":730,"_17911":44043,"_5":17806,"_24291":44030,"_2452":44044},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_2926":737,"_25639":730,"_17911":44046,"_5":17806,"_24291":44030,"_2452":44047},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_2926":738,"_25639":730,"_17911":44049,"_5":17806,"_24291":44030,"_2452":44050},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_2926":739,"_25639":730,"_17911":44052,"_5":17806,"_24291":44030,"_2452":44053},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_2926":740,"_25639":730,"_17911":44055,"_5":17806,"_24291":44034,"_2452":44056},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_2926":741,"_25639":730,"_17911":44058,"_5":17806,"_24291":44034,"_2452":44059},[],"A DMS relates that CA to an enrollment policy.",{"_2926":742,"_25639":730,"_17911":44061,"_5":17806,"_24291":44034,"_2452":44062},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_2926":743,"_25639":730,"_17911":44064,"_5":17806,"_24291":44034,"_2452":44065},[],"Lamassu keeps the inventory, history and status of the identity.",{"_2926":744,"_25639":730,"_17911":44067,"_5":17806,"_24291":44034,"_2452":44068},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_2926":745,"_25639":730,"_17911":44070,"_5":17806,"_24291":44034,"_2452":44071},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_2926":746,"_25639":730,"_17911":44073,"_5":17806,"_24291":44034,"_2452":44074},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2926":747,"_25639":747,"_5":12558,"_2452":44076,"_25983":44077,"_17911":44079,"_24291":747},"Devices and identities",[41760,43104,44078,44076],"IoT Fleets",[],{"_2926":748,"_25639":747,"_17911":44081,"_5":17806,"_24291":747,"_2452":44082},[],"Register, inspect and retire devices while checking their current identity and history.",{"_2926":749,"_25639":747,"_5":25980,"_17911":44084,"_24291":44085,"_2452":44086},[],"/docs/pr-preview/pr-48/platform/iot-fleets/device-management#device-states","Device states",{"_2926":750,"_25639":747,"_5":25980,"_17911":44088,"_24291":44089,"_2452":44090},[],"/docs/pr-preview/pr-48/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_2926":751,"_25639":747,"_5":25980,"_17911":44092,"_24291":44093,"_2452":44094},[],"/docs/pr-preview/pr-48/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_2926":752,"_25639":747,"_5":25980,"_17911":44096,"_24291":44097,"_2452":44098},[],"/docs/pr-preview/pr-48/platform/iot-fleets/device-management#create-the-device","Create the device",{"_2926":753,"_25639":747,"_5":25980,"_17911":44100,"_24291":44101,"_2452":44102},[],"/docs/pr-preview/pr-48/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_2926":754,"_25639":747,"_5":25980,"_17911":44104,"_24291":44105,"_2452":44106},[],"/docs/pr-preview/pr-48/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_2926":755,"_25639":747,"_5":25980,"_17911":44108,"_24291":44109,"_2452":44110},[],"/docs/pr-preview/pr-48/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_2926":756,"_25639":747,"_5":25980,"_17911":44112,"_24291":44113,"_2452":44114},[],"/docs/pr-preview/pr-48/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_2926":757,"_25639":747,"_5":25980,"_17911":44116,"_24291":44117,"_2452":44118},[],"/docs/pr-preview/pr-48/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_2926":758,"_25639":747,"_5":25980,"_17911":44120,"_24291":44121,"_2452":44122},[],"/docs/pr-preview/pr-48/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_2926":759,"_25639":747,"_5":25980,"_17911":44124,"_24291":44125,"_2452":44126},[],"/docs/pr-preview/pr-48/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_2926":760,"_25639":747,"_17911":44128,"_5":17806,"_24291":747,"_2452":44129},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_2926":761,"_25639":747,"_17911":44131,"_5":17806,"_24291":747,"_2452":44132},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_2926":762,"_25639":747,"_17911":44134,"_5":17806,"_24291":44085,"_2452":44135},[],"Operational view",{"_2926":763,"_25639":747,"_17911":44137,"_5":17806,"_24291":44085,"_2452":44138},[],"Meaning",{"_2926":764,"_25639":747,"_17911":44140,"_5":17806,"_24291":44085,"_2452":44141},[],"**No Identity**",{"_2926":765,"_25639":747,"_17911":44143,"_5":17806,"_24291":44085,"_2452":44144},[],"A record exists without an associated identity.",{"_2926":766,"_25639":747,"_17911":44146,"_5":17806,"_24291":44085,"_2452":44147},[],"**Active**",{"_2926":767,"_25639":747,"_17911":44149,"_5":17806,"_24291":44085,"_2452":44150},[],"The slot is active; also check certificate dates, status and usages.",{"_2926":768,"_25639":747,"_17911":44152,"_5":17806,"_24291":44085,"_2452":44153},[],"**Renewal Pending**",{"_2926":769,"_25639":747,"_17911":44155,"_5":17806,"_24291":44085,"_2452":44156},[],"The identity is in the operational renewal window.",{"_2926":770,"_25639":747,"_17911":44158,"_5":17806,"_24291":44085,"_2452":44159},[],"**Expiring Soon**",{"_2926":771,"_25639":747,"_17911":44161,"_5":17806,"_24291":44085,"_2452":44162},[],"Expiration is approaching according to configured thresholds.",{"_2926":772,"_25639":747,"_17911":44164,"_5":17806,"_24291":44085,"_2452":44165},[],"**Expired**",{"_2926":773,"_25639":747,"_17911":44167,"_5":17806,"_24291":44085,"_2452":44168},[],"The identity has expired.",{"_2926":774,"_25639":747,"_17911":44170,"_5":17806,"_24291":44085,"_2452":44171},[],"**Revoked**",{"_2926":775,"_25639":747,"_17911":44173,"_5":17806,"_24291":44085,"_2452":44174},[],"The identity is marked revoked.",{"_2926":776,"_25639":747,"_17911":44176,"_5":17806,"_24291":44085,"_2452":44177},[],"**Decommissioned**",{"_2926":777,"_25639":747,"_17911":44179,"_5":17806,"_24291":44085,"_2452":44180},[],"The record is retired and ordinary updates do not restore operation.",{"_2926":778,"_25639":747,"_17911":44182,"_5":17806,"_24291":44085,"_2452":44183},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_2926":779,"_25639":747,"_17911":44185,"_5":17806,"_24291":44089,"_2452":44186},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_2926":780,"_25639":747,"_17911":44188,"_5":17806,"_24291":44089,"_2452":44189},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_2926":781,"_25639":747,"_17911":44191,"_5":17806,"_24291":44089,"_2452":44192},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_2926":782,"_25639":747,"_17911":44194,"_5":17806,"_24291":44089,"_2452":44195},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_2926":783,"_25639":747,"_17911":44197,"_5":17806,"_24291":44093,"_2452":44198},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_2926":784,"_25639":747,"_17911":44200,"_5":17806,"_24291":44097,"_2452":44201},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_2926":785,"_25639":747,"_17911":44203,"_5":17806,"_24291":44101,"_2452":44204},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_2926":786,"_25639":747,"_17911":44206,"_5":17806,"_24291":44105,"_2452":44207},[],"Add model, environment or location tags and an icon according to your inventory.",{"_2926":787,"_25639":747,"_17911":44209,"_5":17806,"_24291":44109,"_2452":44210},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_2926":788,"_25639":747,"_17911":44212,"_5":17806,"_24291":44109,"_2452":44213},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_2926":789,"_25639":747,"_17911":44215,"_5":17806,"_24291":44113,"_2452":44216},[],"From **No Identity**, use **Assign Identity**:",{"_2926":790,"_25639":747,"_17911":44218,"_5":17806,"_24291":44113,"_2452":44219},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_2926":791,"_25639":747,"_17911":44221,"_5":17806,"_24291":44113,"_2452":44222},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_2926":792,"_25639":747,"_17911":44224,"_5":17806,"_24291":44113,"_2452":44225},[],"Confirm and read the serial, active version and history again.",{"_2926":793,"_25639":747,"_17911":44227,"_5":17806,"_24291":44113,"_2452":44228},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_2926":794,"_25639":747,"_17911":44230,"_5":17806,"_24291":44113,"_2452":44231},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_2926":795,"_25639":747,"_17911":44233,"_5":17806,"_24291":44117,"_2452":44234},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_2926":796,"_25639":747,"_17911":44236,"_5":17806,"_24291":44117,"_2452":44237},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_2926":797,"_25639":747,"_17911":44239,"_5":17806,"_24291":44121,"_2452":44240},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_2926":798,"_25639":747,"_17911":44242,"_5":17806,"_24291":44121,"_2452":44243},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_2926":799,"_25639":747,"_17911":44245,"_5":17806,"_24291":44121,"_2452":44246},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_2926":800,"_25639":747,"_17911":44248,"_5":17806,"_24291":44121,"_2452":44249},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_2926":801,"_25639":747,"_17911":44251,"_5":17806,"_24291":44125,"_2452":44252},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2926":802,"_25639":747,"_17911":44254,"_5":17806,"_24291":44125,"_2452":44255},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2926":803,"_25639":803,"_5":12558,"_2452":44257,"_25983":44258,"_17911":44260,"_24291":803},"Bootstrap identity and authentication",[41760,43104,44078,44076,44259],"Enrollment with PKI",[],{"_2926":804,"_25639":803,"_17911":44262,"_5":17806,"_24291":803,"_2452":44263},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_2926":805,"_25639":803,"_5":25980,"_17911":44265,"_24291":44266,"_2452":44267},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_2926":806,"_25639":803,"_5":25980,"_17911":44269,"_24291":44270,"_2452":44271},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_2926":807,"_25639":803,"_5":25980,"_17911":44273,"_24291":44274,"_2452":44275},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_2926":808,"_25639":803,"_5":25980,"_17911":44277,"_24291":44278,"_2452":44279},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_2926":809,"_25639":803,"_5":25980,"_17911":44281,"_24291":44282,"_2452":44283},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_2926":810,"_25639":803,"_17911":44285,"_5":17806,"_24291":803,"_2452":44286},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_2926":811,"_25639":803,"_17911":44288,"_5":17806,"_24291":44266,"_2452":44289},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_2926":812,"_25639":803,"_17911":44291,"_5":17806,"_24291":44266,"_2452":44292},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_2926":813,"_25639":803,"_17911":44294,"_5":17806,"_24291":44270,"_2452":44295},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_2926":814,"_25639":803,"_17911":44297,"_5":17806,"_24291":44270,"_2452":44298},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_2926":815,"_25639":803,"_17911":44300,"_5":17806,"_24291":44270,"_2452":44301},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_2926":816,"_25639":803,"_17911":44303,"_5":17806,"_24291":44274,"_2452":44304},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_2926":817,"_25639":803,"_17911":44306,"_5":17806,"_24291":44274,"_2452":44307},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_2926":818,"_25639":803,"_17911":44309,"_5":17806,"_24291":44278,"_2452":44310},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_2926":819,"_25639":803,"_17911":44312,"_5":17806,"_24291":44278,"_2452":44313},[],"Example body:",{"_2926":820,"_25639":803,"_17911":44315,"_5":17806,"_24291":44278,"_2452":44316},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_2926":821,"_25639":803,"_17911":44318,"_5":17806,"_24291":44278,"_2452":44319},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_2926":822,"_25639":803,"_17911":44321,"_5":17806,"_24291":44278,"_2452":44322},[],"Continuation requires a successful HTTP response and JSON:",{"_2926":823,"_25639":803,"_17911":44324,"_5":17806,"_24291":44278,"_2452":44325},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_2926":824,"_25639":803,"_17911":44327,"_5":17806,"_24291":44282,"_2452":44328},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_2926":825,"_25639":803,"_17911":44330,"_5":17806,"_24291":44282,"_2452":44331},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_2926":826,"_25639":826,"_5":12558,"_2452":44333,"_25983":44334,"_17911":44335,"_24291":826},"Configure and operate the DMS",[41760,43104,44078,44076,44259],[],{"_2926":827,"_25639":826,"_17911":44337,"_5":17806,"_24291":826,"_2452":44338},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_2926":828,"_25639":826,"_5":25980,"_17911":44340,"_24291":44341,"_2452":41770},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/dms#before-you-begin",{"_2926":829,"_25639":826,"_5":25980,"_17911":44343,"_24291":44344,"_2452":44345},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_2926":830,"_25639":826,"_5":25980,"_17911":44347,"_24291":44348,"_2452":44349},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_2926":831,"_25639":826,"_5":25980,"_17911":44351,"_24291":44352,"_2452":44353},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_2926":832,"_25639":826,"_5":25980,"_17911":44355,"_24291":44356,"_2452":44357},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_2926":833,"_25639":826,"_5":25980,"_17911":44359,"_24291":44360,"_2452":44361},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_2926":834,"_25639":826,"_5":25980,"_17911":44363,"_24291":44364,"_2452":44365},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_2926":835,"_25639":826,"_5":25980,"_17911":44367,"_24291":44368,"_2452":44369},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_2926":836,"_25639":826,"_5":25980,"_17911":44371,"_24291":44372,"_2452":44373},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_2926":837,"_25639":826,"_5":25980,"_17911":44375,"_24291":44376,"_2452":44377},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_2926":838,"_25639":826,"_5":25980,"_17911":44379,"_24291":44380,"_2452":44381},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_2926":839,"_25639":826,"_5":25980,"_17911":44383,"_24291":44384,"_2452":44385},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_2926":840,"_25639":826,"_5":25980,"_17911":44387,"_24291":44388,"_2452":44389},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_2926":841,"_25639":826,"_5":25980,"_17911":44391,"_24291":44392,"_2452":44393},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_2926":842,"_25639":826,"_5":25980,"_17911":44395,"_24291":44396,"_2452":44397},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_2926":843,"_25639":826,"_5":25980,"_17911":44399,"_24291":44400,"_2452":44401},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_2926":844,"_25639":826,"_5":25980,"_17911":44403,"_24291":44404,"_2452":44405},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_2926":845,"_25639":826,"_5":25980,"_17911":44407,"_24291":44408,"_2452":44409},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_2926":846,"_25639":826,"_17911":44411,"_5":17806,"_24291":826,"_2452":44412},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_2926":847,"_25639":826,"_17911":44414,"_5":17806,"_24291":44341,"_2452":44415},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_2926":848,"_25639":826,"_17911":44417,"_5":17806,"_24291":44341,"_2452":44418},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_2926":849,"_25639":826,"_17911":44420,"_5":17806,"_24291":44348,"_2452":44421},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_2926":850,"_25639":826,"_17911":44423,"_5":17806,"_24291":44352,"_2452":44424},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_2926":851,"_25639":826,"_17911":44426,"_5":17806,"_24291":44356,"_2452":44427},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_2926":852,"_25639":826,"_17911":44429,"_5":17806,"_24291":44360,"_2452":44430},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_2926":853,"_25639":826,"_17911":44432,"_5":17806,"_24291":44364,"_2452":44433},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_2926":854,"_25639":826,"_17911":44435,"_5":17806,"_24291":44372,"_2452":44436},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_2926":855,"_25639":826,"_17911":44438,"_5":17806,"_24291":44372,"_2452":44439},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_2926":856,"_25639":826,"_17911":44441,"_5":17806,"_24291":44376,"_2452":44442},[],"`settings.enrollment_settings` field",{"_2926":857,"_25639":826,"_17911":44444,"_5":17806,"_24291":44376,"_2452":44445},[],"Decision",{"_2926":858,"_25639":826,"_17911":44447,"_5":17806,"_24291":44376,"_2452":44448},[],"`protocol`",{"_2926":859,"_25639":826,"_17911":44450,"_5":17806,"_24291":44376,"_2452":44451},[],"`EST_RFC7030` for these operations.",{"_2926":860,"_25639":826,"_17911":44453,"_5":17806,"_24291":44376,"_2452":44454},[],"`enrollment_ca`",{"_2926":861,"_25639":826,"_17911":44456,"_5":17806,"_24291":44376,"_2452":44457},[],"ID of the signing CA.",{"_2926":862,"_25639":826,"_17911":44459,"_5":17806,"_24291":44376,"_2452":44460},[],"`verify_csr_signature`",{"_2926":863,"_25639":826,"_17911":44462,"_5":17806,"_24291":44376,"_2452":44463},[],"Keep `true` to verify CSR key possession.",{"_2926":864,"_25639":826,"_17911":44465,"_5":17806,"_24291":44376,"_2452":44466},[],"`enable_replaceable_enrollment`",{"_2926":865,"_25639":826,"_17911":44468,"_5":17806,"_24291":44376,"_2452":44469},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_2926":866,"_25639":826,"_17911":44471,"_5":17806,"_24291":44376,"_2452":44472},[],"`est_rfc7030_settings.auth_mode`",{"_2926":867,"_25639":826,"_17911":44474,"_5":17806,"_24291":44376,"_2452":44475},[],"One of the four authentication modes.",{"_2926":868,"_25639":826,"_17911":44477,"_5":17806,"_24291":44376,"_2452":44478},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_2926":869,"_25639":826,"_17911":44480,"_5":17806,"_24291":44380,"_2452":44481},[],"The blocks are independent:",{"_2926":870,"_25639":826,"_17911":44483,"_5":17806,"_24291":44380,"_2452":44484},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_2926":871,"_25639":826,"_17911":44486,"_5":17806,"_24291":44380,"_2452":44487},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_2926":872,"_25639":826,"_17911":44489,"_5":17806,"_24291":44380,"_2452":44490},[],"`auth_mode`",{"_2926":873,"_25639":826,"_17911":44492,"_5":17806,"_24291":44380,"_2452":44493},[],"Control applied in the configured operation",{"_2926":874,"_25639":826,"_17911":44495,"_5":17806,"_24291":44380,"_2452":44496},[],"`CLIENT_CERTIFICATE`",{"_2926":875,"_25639":826,"_17911":44498,"_5":17806,"_24291":44380,"_2452":44499},[],"Presented certificate validation.",{"_2926":876,"_25639":826,"_17911":44501,"_5":17806,"_24291":44380,"_2452":44502},[],"`EXTERNAL_WEBHOOK`",{"_2926":877,"_25639":826,"_17911":44504,"_5":17806,"_24291":44380,"_2452":44505},[],"Configured webhook authorization.",{"_2926":878,"_25639":826,"_17911":44507,"_5":17806,"_24291":44380,"_2452":44508},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_2926":879,"_25639":826,"_17911":44510,"_5":17806,"_24291":44380,"_2452":44511},[],"Certificate validation followed by webhook approval.",{"_2926":880,"_25639":826,"_17911":44513,"_5":17806,"_24291":44380,"_2452":44514},[],"`NO_AUTH`",{"_2926":881,"_25639":826,"_17911":44516,"_5":17806,"_24291":44380,"_2452":44517},[],"No DMS requester authentication.",{"_2926":882,"_25639":826,"_17911":44519,"_5":17806,"_24291":44380,"_2452":44520},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_2926":883,"_25639":826,"_17911":44522,"_5":17806,"_24291":44380,"_2452":44523},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_2926":884,"_25639":826,"_17911":44525,"_5":17806,"_24291":44380,"_2452":44526},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_2926":885,"_25639":826,"_17911":44528,"_5":17806,"_24291":44380,"_2452":44529},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_2926":886,"_25639":826,"_17911":44531,"_5":17806,"_24291":44384,"_2452":44532},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_2926":887,"_25639":826,"_17911":44534,"_5":17806,"_24291":44384,"_2452":44535},[],"`external_webhook_settings` field",{"_2926":888,"_25639":826,"_17911":44537,"_5":17806,"_24291":44384,"_2452":44445},[],{"_2926":889,"_25639":826,"_17911":44539,"_5":17806,"_24291":44384,"_2452":44540},[],"`url`",{"_2926":890,"_25639":826,"_17911":44542,"_5":17806,"_24291":44384,"_2452":44543},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_2926":891,"_25639":826,"_17911":44545,"_5":17806,"_24291":44384,"_2452":44546},[],"`method`",{"_2926":892,"_25639":826,"_17911":44548,"_5":17806,"_24291":44384,"_2452":44549},[],"`POST` or `PUT`; `POST` by default.",{"_2926":893,"_25639":826,"_17911":44551,"_5":17806,"_24291":44384,"_2452":44552},[],"`name`",{"_2926":894,"_25639":826,"_17911":44554,"_5":17806,"_24291":44384,"_2452":44555},[],"Label used in service logs.",{"_2926":895,"_25639":826,"_17911":44557,"_5":17806,"_24291":44384,"_2452":44558},[],"`config.auth_mode`",{"_2926":896,"_25639":826,"_17911":44560,"_5":17806,"_24291":44384,"_2452":44561},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_2926":897,"_25639":826,"_17911":44563,"_5":17806,"_24291":44384,"_2452":44564},[],"`config.apikey_options`",{"_2926":898,"_25639":826,"_17911":44566,"_5":17806,"_24291":44384,"_2452":44567},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_2926":899,"_25639":826,"_17911":44569,"_5":17806,"_24291":44384,"_2452":44570},[],"`config.jwt_options`",{"_2926":900,"_25639":826,"_17911":44572,"_5":17806,"_24291":44384,"_2452":44573},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_2926":901,"_25639":826,"_17911":44575,"_5":17806,"_24291":44384,"_2452":44576},[],"`config.mtls_options`",{"_2926":902,"_25639":826,"_17911":44578,"_5":17806,"_24291":44384,"_2452":44579},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_2926":903,"_25639":826,"_17911":44581,"_5":17806,"_24291":44384,"_2452":44582},[],"`config.insecure_skip_verify`",{"_2926":904,"_25639":826,"_17911":44584,"_5":17806,"_24291":44384,"_2452":44585},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_2926":905,"_25639":826,"_17911":44587,"_5":17806,"_24291":44384,"_2452":44588},[],"`config.call_timeout`",{"_2926":906,"_25639":826,"_17911":44590,"_5":17806,"_24291":44384,"_2452":44591},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_2926":907,"_25639":826,"_17911":44593,"_5":17806,"_24291":44384,"_2452":44594},[],"Rules for that configuration:",{"_2926":908,"_25639":826,"_17911":44596,"_5":17806,"_24291":44384,"_2452":44597},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_2926":909,"_25639":826,"_17911":44599,"_5":17806,"_24291":44384,"_2452":44600},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_2926":910,"_25639":826,"_17911":44602,"_5":17806,"_24291":44384,"_2452":44603},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_2926":911,"_25639":826,"_17911":44605,"_5":17806,"_24291":44384,"_2452":44606},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_2926":912,"_25639":826,"_17911":44608,"_5":17806,"_24291":44384,"_2452":44609},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_2926":913,"_25639":826,"_17911":44611,"_5":17806,"_24291":44384,"_2452":44612},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_2926":914,"_25639":826,"_17911":44614,"_5":17806,"_24291":44384,"_2452":44615},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing, and if your version's console does not expose independent settings, use the DMS API.",{"_2926":915,"_25639":826,"_17911":44617,"_5":17806,"_24291":44384,"_2452":44618},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_2926":916,"_25639":826,"_17911":44620,"_5":17806,"_24291":44384,"_2452":44621},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_2926":917,"_25639":826,"_17911":44623,"_5":17806,"_24291":44388,"_2452":44624},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_2926":918,"_25639":826,"_17911":44626,"_5":17806,"_24291":44392,"_2452":44627},[],"`settings.reenrollment_settings` field",{"_2926":919,"_25639":826,"_17911":44629,"_5":17806,"_24291":44392,"_2452":42143},[],{"_2926":920,"_25639":826,"_17911":44631,"_5":17806,"_24291":44392,"_2452":44632},[],"`reenrollment_delta`",{"_2926":921,"_25639":826,"_17911":44634,"_5":17806,"_24291":44392,"_2452":44635},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_2926":922,"_25639":826,"_17911":44637,"_5":17806,"_24291":44392,"_2452":44638},[],"`preventive_delta`",{"_2926":923,"_25639":826,"_17911":44640,"_5":17806,"_24291":44392,"_2452":44641},[],"Preventive operational monitoring threshold.",{"_2926":924,"_25639":826,"_17911":44643,"_5":17806,"_24291":44392,"_2452":44644},[],"`critical_delta`",{"_2926":925,"_25639":826,"_17911":44646,"_5":17806,"_24291":44392,"_2452":44647},[],"Critical operational monitoring threshold.",{"_2926":926,"_25639":826,"_17911":44649,"_5":17806,"_24291":44392,"_2452":44650},[],"`enable_expired_renewal`",{"_2926":927,"_25639":826,"_17911":44652,"_5":17806,"_24291":44392,"_2452":44653},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_2926":928,"_25639":826,"_17911":44655,"_5":17806,"_24291":44392,"_2452":44656},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_2926":929,"_25639":826,"_17911":44658,"_5":17806,"_24291":44392,"_2452":44659},[],"Additional validation CAs for the renewal mTLS credential, tried after the enrollment CA; typically populated during CA rotation while old-CA cohorts renew.",{"_2926":930,"_25639":826,"_17911":44661,"_5":17806,"_24291":44392,"_2452":44662},[],"`revoke_on_reenrollment`",{"_2926":931,"_25639":826,"_17911":44664,"_5":17806,"_24291":44392,"_2452":44665},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_2926":932,"_25639":826,"_17911":44667,"_5":17806,"_24291":44392,"_2452":44668},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_2926":933,"_25639":826,"_17911":44670,"_5":17806,"_24291":44396,"_2452":44671},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. Algorithm and size come from its `key` field; the profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_2926":934,"_25639":826,"_17911":44673,"_5":17806,"_24291":44400,"_2452":42137},[],{"_2926":935,"_25639":826,"_17911":44675,"_5":17806,"_24291":44400,"_2452":44676},[],"Published material",{"_2926":936,"_25639":826,"_17911":44678,"_5":17806,"_24291":44400,"_2452":44679},[],"**Include Lamassu System CA**",{"_2926":937,"_25639":826,"_17911":44681,"_5":17806,"_24291":44400,"_2452":44682},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_2926":938,"_25639":826,"_17911":44684,"_5":17806,"_24291":44400,"_2452":44685},[],"**Include Enrollment CA**",{"_2926":939,"_25639":826,"_17911":44687,"_5":17806,"_24291":44400,"_2452":44688},[],"Selected issuing CA certificate.",{"_2926":940,"_25639":826,"_17911":44690,"_5":17806,"_24291":44400,"_2452":44691},[],"**Managed CAs**",{"_2926":941,"_25639":826,"_17911":44693,"_5":17806,"_24291":44400,"_2452":44694},[],"Explicitly selected CA certificates.",{"_2926":942,"_25639":826,"_17911":44696,"_5":17806,"_24291":44400,"_2452":44697},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_2926":943,"_25639":826,"_17911":44699,"_5":17806,"_24291":44404,"_2452":44700},[],"**Edit** changes name, settings and metadata. Backend updates replace these complete blocks; read the DMS before sending API edits to avoid losing fields.",{"_2926":944,"_25639":826,"_17911":44702,"_5":17806,"_24291":44404,"_2452":44703},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_2926":945,"_25639":826,"_17911":44705,"_5":17806,"_24291":44404,"_2452":44706},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_2926":946,"_25639":826,"_17911":44708,"_5":17806,"_24291":44408,"_2452":44709},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_2926":947,"_25639":947,"_5":12558,"_2452":44711,"_25983":44712,"_17911":44713,"_24291":947},"Integrate the EST client",[41760,43104,44078,44076,44259],[],{"_2926":948,"_25639":947,"_17911":44715,"_5":17806,"_24291":947,"_2452":44716},[],"Prepare trust, send a CSR and check the identity you receive.",{"_2926":949,"_25639":947,"_5":25980,"_17911":44718,"_24291":44719,"_2452":41770},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_2926":950,"_25639":947,"_5":25980,"_17911":44721,"_24291":44722,"_2452":44723},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_2926":951,"_25639":947,"_5":25980,"_17911":44725,"_24291":44726,"_2452":44727},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_2926":952,"_25639":947,"_5":25980,"_17911":44729,"_24291":44730,"_2452":44731},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_2926":953,"_25639":947,"_5":25980,"_17911":44733,"_24291":44734,"_2452":44735},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_2926":954,"_25639":947,"_5":25980,"_17911":44737,"_24291":44738,"_2452":44739},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_2926":955,"_25639":947,"_17911":44741,"_5":17806,"_24291":947,"_2452":44742},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_2926":956,"_25639":947,"_17911":44744,"_5":17806,"_24291":44719,"_2452":44745},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_2926":957,"_25639":947,"_17911":44747,"_5":17806,"_24291":44719,"_2452":44748},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_2926":958,"_25639":947,"_17911":44750,"_5":17806,"_24291":44719,"_2452":44751},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_2926":959,"_25639":947,"_17911":44753,"_5":17806,"_24291":44722,"_2452":44754},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_2926":960,"_25639":947,"_17911":44756,"_5":17806,"_24291":44722,"_2452":44757},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_2926":961,"_25639":947,"_17911":44759,"_5":17806,"_24291":44726,"_2452":44760},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_2926":962,"_25639":947,"_17911":44762,"_5":17806,"_24291":44726,"_2452":44763},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_2926":963,"_25639":947,"_17911":44765,"_5":17806,"_24291":44730,"_2452":44766},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_2926":964,"_25639":947,"_17911":44768,"_5":17806,"_24291":44730,"_2452":44769},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_2926":965,"_25639":947,"_17911":44771,"_5":17806,"_24291":44734,"_2452":44772},[],"For a root that issues directly:",{"_2926":966,"_25639":947,"_17911":44774,"_5":17806,"_24291":44734,"_2452":44775},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_2926":967,"_25639":947,"_17911":44777,"_5":17806,"_24291":44734,"_2452":44778},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_2926":968,"_25639":947,"_17911":44780,"_5":17806,"_24291":44738,"_2452":44781},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_2926":969,"_25639":969,"_5":12558,"_2452":44783,"_25983":44784,"_17911":44785,"_24291":969},"EST reference",[41760,43104,44078,44076,44259],[],{"_2926":970,"_25639":969,"_17911":44787,"_5":17806,"_24291":969,"_2452":44788},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_2926":971,"_25639":969,"_5":25980,"_17911":44790,"_24291":44791,"_2452":44792},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_2926":972,"_25639":969,"_5":25980,"_17911":44794,"_24291":44795,"_2452":19460},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2926":973,"_25639":969,"_5":25980,"_17911":44797,"_24291":44798,"_2452":22267},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2926":974,"_25639":969,"_5":25980,"_17911":44800,"_24291":44801,"_2452":22274},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2926":975,"_25639":969,"_5":25980,"_17911":44803,"_24291":44804,"_2452":21633},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2926":976,"_25639":969,"_5":25980,"_17911":44806,"_24291":44807,"_2452":44808},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_2926":977,"_25639":969,"_5":25980,"_17911":44810,"_24291":44811,"_2452":44812},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_2926":978,"_25639":969,"_5":25980,"_17911":44814,"_24291":44815,"_2452":44816},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_2926":979,"_25639":969,"_17911":44818,"_5":17806,"_24291":969,"_2452":44819},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_2926":980,"_25639":969,"_17911":44821,"_5":17806,"_24291":44791,"_2452":44822},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_2926":981,"_25639":969,"_17911":44824,"_5":17806,"_24291":44791,"_2452":44825},[],"Operation",{"_2926":982,"_25639":969,"_17911":44827,"_5":17806,"_24291":44791,"_2452":44828},[],"Method",{"_2926":983,"_25639":969,"_17911":44830,"_5":17806,"_24291":44791,"_2452":44831},[],"Authentication and condition",{"_2926":984,"_25639":969,"_17911":44833,"_5":17806,"_24291":44791,"_2452":44834},[],"`/cacerts`",{"_2926":985,"_25639":969,"_17911":44836,"_5":17806,"_24291":44791,"_2452":44837},[],"GET",{"_2926":986,"_25639":969,"_17911":44839,"_5":17806,"_24291":44791,"_2452":44840},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_2926":987,"_25639":969,"_17911":44842,"_5":17806,"_24291":44791,"_2452":44843},[],"`/simpleenroll`",{"_2926":988,"_25639":969,"_17911":44845,"_5":17806,"_24291":44791,"_2452":44846},[],"POST",{"_2926":989,"_25639":969,"_17911":44848,"_5":17806,"_24291":44791,"_2452":44849},[],"Initial authentication and DMS registration/replacement policy.",{"_2926":990,"_25639":969,"_17911":44851,"_5":17806,"_24291":44791,"_2452":44852},[],"`/simplereenroll`",{"_2926":991,"_25639":969,"_17911":44854,"_5":17806,"_24291":44791,"_2452":44846},[],{"_2926":992,"_25639":969,"_17911":44856,"_5":17806,"_24291":44791,"_2452":44857},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_2926":993,"_25639":969,"_17911":44859,"_5":17806,"_24291":44791,"_2452":44860},[],"`/serverkeygen`",{"_2926":994,"_25639":969,"_17911":44862,"_5":17806,"_24291":44791,"_2452":44846},[],{"_2926":995,"_25639":969,"_17911":44864,"_5":17806,"_24291":44791,"_2452":44865},[],"Initial authentication and admission; server generation enabled.",{"_2926":996,"_25639":969,"_17911":44867,"_5":17806,"_24291":44791,"_2452":44868},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_2926":997,"_25639":969,"_17911":44870,"_5":17806,"_24291":44795,"_2452":44871},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_2926":998,"_25639":969,"_17911":44873,"_5":17806,"_24291":44795,"_2452":44874},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_2926":999,"_25639":969,"_17911":44876,"_5":17806,"_24291":44798,"_2452":44877},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_2926":1000,"_25639":969,"_17911":44879,"_5":17806,"_24291":44798,"_2452":44880},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_2926":1001,"_25639":969,"_17911":44882,"_5":17806,"_24291":44801,"_2452":44883},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_2926":1002,"_25639":969,"_17911":44885,"_5":17806,"_24291":44801,"_2452":44886},[],"The enrollment CA or a validation CA configured in the re-enrollment block validates the credential in mTLS mode. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_2926":1003,"_25639":969,"_17911":44888,"_5":17806,"_24291":44804,"_2452":44889},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_2926":1004,"_25639":969,"_17911":44891,"_5":17806,"_24291":44804,"_2452":44892},[],"The code supports RSA and ECDSA with 224, 256, 384 or 521 bits. An unrecognized ECDSA size can fall back to 256; explicitly select a compatible size and check the resulting key. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_2926":1005,"_25639":969,"_17911":44894,"_5":17806,"_24291":44807,"_2452":44895},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_2926":1006,"_25639":969,"_17911":44897,"_5":17806,"_24291":44807,"_2452":44898},[],"Part",{"_2926":1007,"_25639":969,"_17911":44900,"_5":17806,"_24291":44807,"_2452":44901},[],"Content after decoding its Base64",{"_2926":1008,"_25639":969,"_17911":44903,"_5":17806,"_24291":44807,"_2452":44904},[],"`application/pkcs8`",{"_2926":1009,"_25639":969,"_17911":44906,"_5":17806,"_24291":44807,"_2452":44907},[],"Unencrypted DER PKCS#8 private key.",{"_2926":1010,"_25639":969,"_17911":44909,"_5":17806,"_24291":44807,"_2452":44910},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_2926":1011,"_25639":969,"_17911":44912,"_5":17806,"_24291":44807,"_2452":44913},[],"DER PKCS#7 containing the issued certificate.",{"_2926":1012,"_25639":969,"_17911":44915,"_5":17806,"_24291":44807,"_2452":44916},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_2926":1013,"_25639":969,"_17911":44918,"_5":17806,"_24291":44811,"_2452":44919},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_2926":1014,"_25639":969,"_17911":44921,"_5":17806,"_24291":44811,"_2452":44922},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_2926":1015,"_25639":969,"_17911":44924,"_5":17806,"_24291":44811,"_2452":44925},[],"Convert and check the result:",{"_2926":1016,"_25639":969,"_17911":44927,"_5":17806,"_24291":44811,"_2452":44928},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_2926":1017,"_25639":969,"_17911":44930,"_5":17806,"_24291":44815,"_2452":44931},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_2926":1018,"_25639":969,"_17911":44933,"_5":17806,"_24291":44815,"_2452":44934},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_2926":1019,"_25639":1019,"_5":12558,"_2452":44259,"_25983":44936,"_17911":44937,"_24291":1019},[41760,43104,44078,44076,44259],[],{"_2926":1020,"_25639":1019,"_17911":44939,"_5":17806,"_24291":1019,"_2452":44940},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_2926":1021,"_25639":1019,"_5":25980,"_17911":44942,"_24291":44943,"_2452":44944},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_2926":1022,"_25639":1019,"_5":25980,"_17911":44946,"_24291":44947,"_2452":44948},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_2926":1023,"_25639":1019,"_5":25980,"_17911":44950,"_24291":44951,"_2452":44952},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_2926":1024,"_25639":1019,"_5":25980,"_17911":44954,"_24291":44955,"_2452":44956},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_2926":1025,"_25639":1019,"_17911":44958,"_5":17806,"_24291":1019,"_2452":44959},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_2926":1026,"_25639":1019,"_17911":44961,"_5":17806,"_24291":44943,"_2452":44962},[],"The administrator prepares the CA, issuance profile and DMS.",{"_2926":1027,"_25639":1019,"_17911":44964,"_5":17806,"_24291":44943,"_2452":44965},[],"The integrator installs initial EST server trust and an admission credential.",{"_2926":1028,"_25639":1019,"_17911":44967,"_5":17806,"_24291":44943,"_2452":44968},[],"The client requests an identity for its `Device ID` through EST.",{"_2926":1029,"_25639":1019,"_17911":44970,"_5":17806,"_24291":44943,"_2452":44971},[],"Certificate, device binding and key/certificate installation are checked.",{"_2926":1030,"_25639":1019,"_17911":44973,"_5":17806,"_24291":44943,"_2452":44974},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_2926":1031,"_25639":1019,"_17911":44976,"_5":17806,"_24291":44943,"_2452":44977},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_2926":1032,"_25639":1019,"_17911":44979,"_5":17806,"_24291":44947,"_2452":44980},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2926":1033,"_25639":1019,"_17911":44982,"_5":17806,"_24291":44947,"_2452":44983},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2926":1034,"_25639":1019,"_17911":44985,"_5":17806,"_24291":44947,"_2452":44986},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2926":1035,"_25639":1019,"_17911":44988,"_5":17806,"_24291":44947,"_2452":44989},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2926":1036,"_25639":1019,"_17911":44991,"_5":17806,"_24291":44951,"_2452":44992},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2926":1037,"_25639":1019,"_17911":44994,"_5":17806,"_24291":44951,"_2452":44995},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2926":1038,"_25639":1019,"_17911":44997,"_5":17806,"_24291":44951,"_2452":44998},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2926":1039,"_25639":1019,"_17911":45000,"_5":17806,"_24291":44951,"_2452":45001},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2926":1040,"_25639":1019,"_17911":45003,"_5":17806,"_24291":44955,"_2452":45004},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_2926":1041,"_25639":1019,"_17911":45006,"_5":17806,"_24291":44955,"_2452":45007},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_2926":1042,"_25639":1042,"_5":12558,"_2452":45009,"_25983":45010,"_17911":45011,"_24291":1042},"Provisioning strategies",[41760,43104,44078,44076,44259],[],{"_2926":1043,"_25639":1042,"_17911":45013,"_5":17806,"_24291":1042,"_2452":45014},[],"Choose device registration, identity authorization and key generation.",{"_2926":1044,"_25639":1042,"_5":25980,"_17911":45016,"_24291":45017,"_2452":45018},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_2926":1045,"_25639":1042,"_5":25980,"_17911":45020,"_24291":45021,"_2452":45022},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_2926":1046,"_25639":1042,"_5":25980,"_17911":45024,"_24291":45025,"_2452":45026},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_2926":1047,"_25639":1042,"_5":25980,"_17911":45028,"_24291":45029,"_2452":45030},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_2926":1048,"_25639":1042,"_5":25980,"_17911":45032,"_24291":45033,"_2452":45034},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_2926":1049,"_25639":1042,"_17911":45036,"_5":17806,"_24291":1042,"_2452":45037},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_2926":1050,"_25639":1042,"_17911":45039,"_5":17806,"_24291":45017,"_2452":45040},[],"Path",{"_2926":1051,"_25639":1042,"_17911":45042,"_5":17806,"_24291":45017,"_2452":45043},[],"When the device exists",{"_2926":1052,"_25639":1042,"_17911":45045,"_5":17806,"_24291":45017,"_2452":45046},[],"What to check",{"_2926":1053,"_25639":1042,"_17911":45048,"_5":17806,"_24291":45017,"_2452":45049},[],"Manual assignment",{"_2926":1054,"_25639":1042,"_17911":45051,"_5":17806,"_24291":45017,"_2452":45052},[],"An operator creates it before associating a certificate.",{"_2926":1055,"_25639":1042,"_17911":45054,"_5":17806,"_24291":45017,"_2452":45055},[],"ID, owning DMS, certificate CN and bound serial.",{"_2926":1056,"_25639":1042,"_17911":45057,"_5":17806,"_24291":45017,"_2452":45058},[],"EST with `JITP`",{"_2926":1057,"_25639":1042,"_17911":45060,"_5":17806,"_24291":45017,"_2452":45061},[],"Created for an unknown CN during `/simpleenroll`.",{"_2926":1058,"_25639":1042,"_17911":45063,"_5":17806,"_24291":45017,"_2452":45064},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_2926":1059,"_25639":1042,"_17911":45066,"_5":17806,"_24291":45017,"_2452":45067},[],"EST with `PRE_REGISTRATION`",{"_2926":1060,"_25639":1042,"_17911":45069,"_5":17806,"_24291":45017,"_2452":45070},[],"Must exist before `/simpleenroll`.",{"_2926":1061,"_25639":1042,"_17911":45072,"_5":17806,"_24291":45017,"_2452":45073},[],"Approved record, same DMS and replacement conditions for your version.",{"_2926":1062,"_25639":1042,"_17911":45075,"_5":17806,"_24291":45017,"_2452":45076},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_2926":1063,"_25639":1042,"_17911":45078,"_5":17806,"_24291":45017,"_2452":45079},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_2926":1064,"_25639":1042,"_17911":45081,"_5":17806,"_24291":45021,"_2452":45082},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_2926":1065,"_25639":1042,"_17911":45084,"_5":17806,"_24291":45021,"_2452":45085},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_2926":1066,"_25639":1042,"_17911":45087,"_5":17806,"_24291":45021,"_2452":45088},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_2926":1067,"_25639":1042,"_17911":45090,"_5":17806,"_24291":45025,"_2452":45091},[],"Decide initial enrollment and re-enrollment separately:",{"_2926":1068,"_25639":1042,"_17911":45093,"_5":17806,"_24291":45025,"_2452":45094},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_2926":1069,"_25639":1042,"_17911":45096,"_5":17806,"_24291":45025,"_2452":45097},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_2926":1070,"_25639":1042,"_17911":45099,"_5":17806,"_24291":45025,"_2452":45100},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_2926":1071,"_25639":1042,"_17911":45102,"_5":17806,"_24291":45025,"_2452":45103},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_2926":1072,"_25639":1042,"_17911":45105,"_5":17806,"_24291":45025,"_2452":45106},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_2926":1073,"_25639":1042,"_17911":45108,"_5":17806,"_24291":45029,"_2452":42137},[],{"_2926":1074,"_25639":1042,"_17911":45110,"_5":17806,"_24291":45029,"_2452":45111},[],"Material crossing EST",{"_2926":1075,"_25639":1042,"_17911":45113,"_5":17806,"_24291":45029,"_2452":45114},[],"Device-generated key",{"_2926":1076,"_25639":1042,"_17911":45116,"_5":17806,"_24291":45029,"_2452":45117},[],"Public CSR and certificate; the key stays on the client.",{"_2926":1077,"_25639":1042,"_17911":45119,"_5":17806,"_24291":45029,"_2452":45120},[],"Existing device key",{"_2926":1078,"_25639":1042,"_17911":45122,"_5":17806,"_24291":45029,"_2452":45123},[],"CSR signed with that key and a new certificate.",{"_2926":1079,"_25639":1042,"_17911":45125,"_5":17806,"_24291":45029,"_2452":44397},[],{"_2926":1080,"_25639":1042,"_17911":45127,"_5":17806,"_24291":45029,"_2452":45128},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_2926":1081,"_25639":1042,"_17911":45130,"_5":17806,"_24291":45029,"_2452":45131},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_2926":1082,"_25639":1042,"_17911":45133,"_5":17806,"_24291":45033,"_2452":45134},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_2926":1083,"_25639":1083,"_5":12558,"_2452":45136,"_25983":45137,"_17911":45138,"_24291":1083},"Renewal and recovery",[41760,43104,44078,44076,44259],[],{"_2926":1084,"_25639":1083,"_17911":45140,"_5":17806,"_24291":1083,"_2452":45141},[],"Renew without losing the identity and recover devices according to their actual state.",{"_2926":1085,"_25639":1083,"_5":25980,"_17911":45143,"_24291":45144,"_2452":45145},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_2926":1086,"_25639":1083,"_5":25980,"_17911":45147,"_24291":45148,"_2452":45149},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_2926":1087,"_25639":1083,"_5":25980,"_17911":45151,"_24291":45152,"_2452":45153},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_2926":1088,"_25639":1083,"_5":25980,"_17911":45155,"_24291":45156,"_2452":45157},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_2926":1089,"_25639":1083,"_5":25980,"_17911":45159,"_24291":45160,"_2452":45161},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_2926":1090,"_25639":1083,"_17911":45163,"_5":17806,"_24291":1083,"_2452":45164},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_2926":1091,"_25639":1083,"_17911":45166,"_5":17806,"_24291":45144,"_2452":45167},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_2926":1092,"_25639":1083,"_17911":45169,"_5":17806,"_24291":45144,"_2452":45170},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_2926":1093,"_25639":1083,"_17911":45172,"_5":17806,"_24291":45144,"_2452":45173},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_2926":1094,"_25639":1083,"_17911":45175,"_5":17806,"_24291":45144,"_2452":45176},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_2926":1095,"_25639":1083,"_17911":45178,"_5":17806,"_24291":45148,"_2452":45179},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_2926":1096,"_25639":1083,"_17911":45181,"_5":17806,"_24291":45148,"_2452":45182},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_2926":1097,"_25639":1083,"_17911":45184,"_5":17806,"_24291":45152,"_2452":45185},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_2926":1098,"_25639":1083,"_17911":45187,"_5":17806,"_24291":45152,"_2452":45188},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_2926":1099,"_25639":1083,"_17911":45190,"_5":17806,"_24291":45152,"_2452":45191},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_2926":1100,"_25639":1083,"_17911":45193,"_5":17806,"_24291":45156,"_2452":45194},[],"Situation",{"_2926":1101,"_25639":1083,"_17911":45196,"_5":17806,"_24291":45156,"_2452":45197},[],"Procedure",{"_2926":1102,"_25639":1083,"_17911":45199,"_5":17806,"_24291":45156,"_2452":45200},[],"Valid certificate, outside the window",{"_2926":1103,"_25639":1083,"_17911":45202,"_5":17806,"_24291":45156,"_2452":45203},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_2926":1104,"_25639":1083,"_17911":45205,"_5":17806,"_24291":45156,"_2452":45206},[],"Expired certificate, key available",{"_2926":1105,"_25639":1083,"_17911":45208,"_5":17806,"_24291":45156,"_2452":45209},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_2926":1106,"_25639":1083,"_17911":45211,"_5":17806,"_24291":45156,"_2452":45212},[],"Renewal through webhook or `NO_AUTH`",{"_2926":1107,"_25639":1083,"_17911":45214,"_5":17806,"_24291":45156,"_2452":45215},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_2926":1108,"_25639":1083,"_17911":45217,"_5":17806,"_24291":45156,"_2452":45218},[],"Lost or inaccessible key",{"_2926":1109,"_25639":1083,"_17911":45220,"_5":17806,"_24291":45156,"_2452":45221},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_2926":1110,"_25639":1083,"_17911":45223,"_5":17806,"_24291":45156,"_2452":45224},[],"Current identity revoked",{"_2926":1111,"_25639":1083,"_17911":45226,"_5":17806,"_24291":45156,"_2452":45227},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_2926":1112,"_25639":1083,"_17911":45229,"_5":17806,"_24291":45156,"_2452":45230},[],"Device without an identity",{"_2926":1113,"_25639":1083,"_17911":45232,"_5":17806,"_24291":45156,"_2452":45233},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_2926":1114,"_25639":1083,"_17911":45235,"_5":17806,"_24291":45156,"_2452":45236},[],"Retired device",{"_2926":1115,"_25639":1083,"_17911":45238,"_5":17806,"_24291":45156,"_2452":45239},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_2926":1116,"_25639":1083,"_17911":45241,"_5":17806,"_24291":45156,"_2452":45242},[],"Timeout, HTTP 500 or installation failure",{"_2926":1117,"_25639":1083,"_17911":45244,"_5":17806,"_24291":45156,"_2452":45245},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_2926":1118,"_25639":1083,"_17911":45247,"_5":17806,"_24291":45160,"_2452":45248},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_2926":1119,"_25639":1083,"_17911":45250,"_5":17806,"_24291":45160,"_2452":45251},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_2926":1120,"_25639":1120,"_5":12558,"_2452":45253,"_25983":45254,"_17911":45255,"_24291":1120},"Enrollment troubleshooting",[41760,43104,44078,44076,44259],[],{"_2926":1121,"_25639":1120,"_17911":45257,"_5":17806,"_24291":1120,"_2452":45258},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_2926":1122,"_25639":1120,"_5":25980,"_17911":45260,"_24291":45261,"_2452":45262},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_2926":1123,"_25639":1120,"_5":25980,"_17911":45264,"_24291":45265,"_2452":45266},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_2926":1124,"_25639":1120,"_5":25980,"_17911":45268,"_24291":45269,"_2452":44816},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_2926":1125,"_25639":1120,"_5":25980,"_17911":45271,"_24291":45272,"_2452":45273},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_2926":1126,"_25639":1120,"_17911":45275,"_5":17806,"_24291":1120,"_2452":45276},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_2926":1127,"_25639":1120,"_17911":45278,"_5":17806,"_24291":45265,"_2452":45279},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_2926":1128,"_25639":1120,"_17911":45281,"_5":17806,"_24291":45265,"_2452":45282},[],"Symptom or message",{"_2926":1129,"_25639":1120,"_17911":45284,"_5":17806,"_24291":45265,"_2452":45046},[],{"_2926":1130,"_25639":1120,"_17911":45286,"_5":17806,"_24291":45265,"_2452":45287},[],"curl rejects TLS, name or issuer",{"_2926":1131,"_25639":1120,"_17911":45289,"_5":17806,"_24291":45265,"_2452":45290},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_2926":1132,"_25639":1120,"_17911":45292,"_5":17806,"_24291":45265,"_2452":45293},[],"404 or missing APS",{"_2926":1133,"_25639":1120,"_17911":45295,"_5":17806,"_24291":45265,"_2452":45296},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_2926":1134,"_25639":1120,"_17911":45298,"_5":17806,"_24291":45265,"_2452":45299},[],"400, CSR or format error",{"_2926":1135,"_25639":1120,"_17911":45301,"_5":17806,"_24291":45265,"_2452":45302},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_2926":1136,"_25639":1120,"_17911":45304,"_5":17806,"_24291":45265,"_2452":45305},[],"Missing credential or invalid certificate",{"_2926":1137,"_25639":1120,"_17911":45307,"_5":17806,"_24291":45265,"_2452":45308},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_2926":1138,"_25639":1120,"_17911":45310,"_5":17806,"_24291":45265,"_2452":45311},[],"Webhook denies, times out or responds without authorization",{"_2926":1139,"_25639":1120,"_17911":45313,"_5":17806,"_24291":45265,"_2452":45314},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_2926":1140,"_25639":1120,"_17911":45316,"_5":17806,"_24291":45265,"_2452":45317},[],"`unexpected status code: <n>: redirects are not followed`",{"_2926":1141,"_25639":1120,"_17911":45319,"_5":17806,"_24291":45265,"_2452":45320},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_2926":1142,"_25639":1120,"_17911":45322,"_5":17806,"_24291":45265,"_2452":45323},[],"`webhook response exceeds 1048576 bytes`",{"_2926":1143,"_25639":1120,"_17911":45325,"_5":17806,"_24291":45265,"_2452":45326},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_2926":1144,"_25639":1120,"_17911":45328,"_5":17806,"_24291":45265,"_2452":45329},[],"`webhook config must not reference files`",{"_2926":1145,"_25639":1120,"_17911":45331,"_5":17806,"_24291":45265,"_2452":45332},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_2926":1146,"_25639":1120,"_17911":45334,"_5":17806,"_24291":45265,"_2452":45335},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_2926":1147,"_25639":1120,"_17911":45337,"_5":17806,"_24291":45265,"_2452":45338},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_2926":1148,"_25639":1120,"_17911":45340,"_5":17806,"_24291":45265,"_2452":45341},[],"`webhook mTLS certificate and key are invalid: …`",{"_2926":1149,"_25639":1120,"_17911":45343,"_5":17806,"_24291":45265,"_2452":45344},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_2926":1150,"_25639":1120,"_17911":45346,"_5":17806,"_24291":45265,"_2452":45347},[],"400 `struct validation error` creating or updating a DMS",{"_2926":1151,"_25639":1120,"_17911":45349,"_5":17806,"_24291":45265,"_2452":45350},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_2926":1152,"_25639":1120,"_17911":45352,"_5":17806,"_24291":45265,"_2452":45353},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_2926":1153,"_25639":1120,"_17911":45355,"_5":17806,"_24291":45265,"_2452":45356},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_2926":1154,"_25639":1120,"_17911":45358,"_5":17806,"_24291":45265,"_2452":45359},[],"`device not preregistered`",{"_2926":1155,"_25639":1120,"_17911":45361,"_5":17806,"_24291":45265,"_2452":45362},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_2926":1156,"_25639":1120,"_17911":45364,"_5":17806,"_24291":45265,"_2452":45365},[],"`forbiddenNewEnrollment`",{"_2926":1157,"_25639":1120,"_17911":45367,"_5":17806,"_24291":45265,"_2452":45368},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_2926":1158,"_25639":1120,"_17911":45370,"_5":17806,"_24291":45265,"_2452":45371},[],"Different owning DMS",{"_2926":1159,"_25639":1120,"_17911":45373,"_5":17806,"_24291":45265,"_2452":45374},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_2926":1160,"_25639":1120,"_17911":45376,"_5":17806,"_24291":45265,"_2452":45377},[],"`invalid RawSubject bytes`",{"_2926":1161,"_25639":1120,"_17911":45379,"_5":17806,"_24291":45265,"_2452":45380},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_2926":1162,"_25639":1120,"_17911":45382,"_5":17806,"_24291":45265,"_2452":45383},[],"`invalid reenroll window`",{"_2926":1163,"_25639":1120,"_17911":45385,"_5":17806,"_24291":45265,"_2452":45386},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_2926":1164,"_25639":1120,"_17911":45388,"_5":17806,"_24291":45265,"_2452":45389},[],"Current certificate revoked",{"_2926":1165,"_25639":1120,"_17911":45391,"_5":17806,"_24291":45265,"_2452":45392},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_2926":1166,"_25639":1120,"_17911":45394,"_5":17806,"_24291":45265,"_2452":45395},[],"CA, profile or signing error",{"_2926":1167,"_25639":1120,"_17911":45397,"_5":17806,"_24291":45265,"_2452":45398},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_2926":1168,"_25639":1120,"_17911":45400,"_5":17806,"_24291":45265,"_2452":45401},[],"HTTP 200 without a device connection",{"_2926":1169,"_25639":1120,"_17911":45403,"_5":17806,"_24291":45265,"_2452":45404},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_2926":1170,"_25639":1120,"_17911":45406,"_5":17806,"_24291":45265,"_2452":45407},[],"Timeout or error after issuance",{"_2926":1171,"_25639":1120,"_17911":45409,"_5":17806,"_24291":45265,"_2452":45410},[],"New certificates, current slot and previous identity's state before retrying.",{"_2926":1172,"_25639":1120,"_17911":45412,"_5":17806,"_24291":45269,"_2452":45413},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_2926":1173,"_25639":1120,"_17911":45415,"_5":17806,"_24291":45269,"_2452":45416},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_2926":1174,"_25639":1120,"_17911":45418,"_5":17806,"_24291":45272,"_2452":45419},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_2926":1175,"_25639":1120,"_17911":45421,"_5":17806,"_24291":45272,"_2452":45422},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_2926":1176,"_25639":1120,"_17911":45424,"_5":17806,"_24291":45272,"_2452":45425},[],"Verify the CSR locally and relate its CN to the inventory.",{"_2926":1177,"_25639":1120,"_17911":45427,"_5":17806,"_24291":45272,"_2452":45428},[],"Make one request, save headers/body and query the device and certificates.",{"_2926":1178,"_25639":1120,"_17911":45430,"_5":17806,"_24291":45272,"_2452":45431},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_2926":1179,"_25639":1120,"_17911":45433,"_5":17806,"_24291":45272,"_2452":45434},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_2926":1180,"_25639":1120,"_17911":45436,"_5":17806,"_24291":45272,"_2452":45437},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_2926":1181,"_25639":1181,"_5":12558,"_2452":45439,"_25983":45440,"_17911":45441,"_24291":1181},"Trust distribution and updates",[41760,43104,44078,44076,44259],[],{"_2926":1182,"_25639":1181,"_17911":45443,"_5":17806,"_24291":1181,"_2452":45444},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_2926":1183,"_25639":1181,"_5":25980,"_17911":45446,"_24291":45447,"_2452":45448},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_2926":1184,"_25639":1181,"_5":25980,"_17911":45450,"_24291":45451,"_2452":45452},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_2926":1185,"_25639":1181,"_5":25980,"_17911":45454,"_24291":45455,"_2452":45456},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_2926":1186,"_25639":1181,"_5":25980,"_17911":45458,"_24291":45459,"_2452":45460},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_2926":1187,"_25639":1181,"_5":25980,"_17911":45462,"_24291":45463,"_2452":45464},[],"/docs/pr-preview/pr-48/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_2926":1188,"_25639":1181,"_17911":45466,"_5":17806,"_24291":1181,"_2452":45467},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_2926":1189,"_25639":1181,"_17911":45469,"_5":17806,"_24291":45447,"_2452":45470},[],"Relationship",{"_2926":1190,"_25639":1181,"_17911":45472,"_5":17806,"_24291":45447,"_2452":45473},[],"Material prepared by its owner",{"_2926":1191,"_25639":1181,"_17911":45475,"_5":17806,"_24291":45447,"_2452":45476},[],"Device → EST server",{"_2926":1192,"_25639":1181,"_17911":45478,"_5":17806,"_24291":45447,"_2452":45479},[],"Previously verified server root, chain or pin and TLS name.",{"_2926":1193,"_25639":1181,"_17911":45481,"_5":17806,"_24291":45447,"_2452":45482},[],"DMS → requester",{"_2926":1194,"_25639":1181,"_17911":45484,"_5":17806,"_24291":45447,"_2452":45485},[],"CAs and rules authorizing initial or renewal credentials.",{"_2926":1195,"_25639":1181,"_17911":45487,"_5":17806,"_24291":45447,"_2452":45488},[],"Consumer → device",{"_2926":1196,"_25639":1181,"_17911":45490,"_5":17806,"_24291":45447,"_2452":45491},[],"Operational identity roots, intermediates, validation and permissions.",{"_2926":1197,"_25639":1181,"_17911":45493,"_5":17806,"_24291":45447,"_2452":45494},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_2926":1198,"_25639":1181,"_17911":45496,"_5":17806,"_24291":45451,"_2452":45497},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_2926":1199,"_25639":1181,"_17911":45499,"_5":17806,"_24291":45451,"_2452":45500},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_2926":1200,"_25639":1181,"_17911":45502,"_5":17806,"_24291":45455,"_2452":45503},[],"Keep initial EST server trust separate from identity consumer trust.",{"_2926":1201,"_25639":1181,"_17911":45505,"_5":17806,"_24291":45455,"_2452":45506},[],"Select policy-approved roots as anchors.",{"_2926":1202,"_25639":1181,"_17911":45508,"_5":17806,"_24291":45455,"_2452":45509},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_2926":1203,"_25639":1181,"_17911":45511,"_5":17806,"_24291":45455,"_2452":45512},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_2926":1204,"_25639":1181,"_17911":45514,"_5":17806,"_24291":45455,"_2452":45515},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_2926":1205,"_25639":1181,"_17911":45517,"_5":17806,"_24291":45455,"_2452":45518},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_2926":1206,"_25639":1181,"_17911":45520,"_5":17806,"_24291":45459,"_2452":45521},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_2926":1207,"_25639":1181,"_17911":45523,"_5":17806,"_24291":45459,"_2452":45524},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. When switching the enrollment CA, add the previous issuance CA to that list so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_2926":1208,"_25639":1181,"_17911":45526,"_5":17806,"_24291":45459,"_2452":45527},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_2926":1209,"_25639":1181,"_17911":45529,"_5":17806,"_24291":45463,"_2452":45530},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_2926":1210,"_25639":1210,"_5":12558,"_2452":45532,"_25983":45533,"_17911":45535,"_24291":1210},"AWS IoT Core",[41760,43104,44078,44076,45534],"Integrations",[],{"_2926":1211,"_25639":1210,"_17911":45537,"_5":17806,"_24291":1210,"_2452":45538},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_2926":1212,"_25639":1210,"_5":25980,"_17911":45540,"_24291":45541,"_2452":45542},[],"/docs/pr-preview/pr-48/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_2926":1213,"_25639":1210,"_5":25980,"_17911":45544,"_24291":45545,"_2452":45546},[],"/docs/pr-preview/pr-48/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_2926":1214,"_25639":1210,"_5":25980,"_17911":45548,"_24291":45549,"_2452":45550},[],"/docs/pr-preview/pr-48/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_2926":1215,"_25639":1210,"_5":25980,"_17911":45552,"_24291":45553,"_2452":45554},[],"/docs/pr-preview/pr-48/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_2926":1216,"_25639":1210,"_5":25980,"_17911":45556,"_24291":45557,"_2452":45558},[],"/docs/pr-preview/pr-48/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_2926":1217,"_25639":1210,"_5":25980,"_17911":45560,"_24291":45561,"_2452":45562},[],"/docs/pr-preview/pr-48/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_2926":1218,"_25639":1210,"_5":25980,"_17911":45564,"_24291":45565,"_2452":45566},[],"/docs/pr-preview/pr-48/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_2926":1219,"_25639":1210,"_5":25980,"_17911":45568,"_24291":45569,"_2452":45570},[],"/docs/pr-preview/pr-48/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_2926":1220,"_25639":1210,"_5":25980,"_17911":45572,"_24291":45573,"_2452":45574},[],"/docs/pr-preview/pr-48/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_2926":1221,"_25639":1210,"_5":25980,"_17911":45576,"_24291":45577,"_2452":45578},[],"/docs/pr-preview/pr-48/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_2926":1222,"_25639":1210,"_5":25980,"_17911":45580,"_24291":45581,"_2452":45582},[],"/docs/pr-preview/pr-48/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_2926":1223,"_25639":1210,"_5":25980,"_17911":45584,"_24291":45585,"_2452":45586},[],"/docs/pr-preview/pr-48/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_2926":1224,"_25639":1210,"_5":25980,"_17911":45588,"_24291":45589,"_2452":45590},[],"/docs/pr-preview/pr-48/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_2926":1225,"_25639":1210,"_5":25980,"_17911":45592,"_24291":45593,"_2452":45594},[],"/docs/pr-preview/pr-48/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_2926":1226,"_25639":1210,"_5":25980,"_17911":45596,"_24291":45597,"_2452":45598},[],"/docs/pr-preview/pr-48/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_2926":1227,"_25639":1210,"_5":25980,"_17911":45600,"_24291":45601,"_2452":45602},[],"/docs/pr-preview/pr-48/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_2926":1228,"_25639":1210,"_5":25980,"_17911":45604,"_24291":45605,"_2452":45606},[],"/docs/pr-preview/pr-48/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_2926":1229,"_25639":1210,"_5":25980,"_17911":45608,"_24291":45609,"_2452":45610},[],"/docs/pr-preview/pr-48/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_2926":1230,"_25639":1210,"_5":25980,"_17911":45612,"_24291":45613,"_2452":45614},[],"/docs/pr-preview/pr-48/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_2926":1231,"_25639":1210,"_5":25980,"_17911":45616,"_24291":45617,"_2452":45618},[],"/docs/pr-preview/pr-48/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_2926":1232,"_25639":1210,"_17911":45620,"_5":17806,"_24291":1210,"_2452":45621},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_2926":1233,"_25639":1210,"_17911":45623,"_5":17806,"_24291":1210,"_2452":45624},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_2926":1234,"_25639":1210,"_17911":45626,"_5":17806,"_24291":1210,"_2452":45627},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_2926":1235,"_25639":1210,"_17911":45629,"_5":17806,"_24291":45541,"_2452":45630},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_2926":1236,"_25639":1210,"_17911":45632,"_5":17806,"_24291":45541,"_2452":45633},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_2926":1237,"_25639":1210,"_17911":45635,"_5":17806,"_24291":45541,"_2452":45636},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_2926":1238,"_25639":1210,"_17911":45638,"_5":17806,"_24291":45541,"_2452":45639},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_2926":1239,"_25639":1210,"_17911":45641,"_5":17806,"_24291":45545,"_2452":45642},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_2926":1240,"_25639":1210,"_17911":45644,"_5":17806,"_24291":45549,"_2452":45645},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_2926":1241,"_25639":1210,"_17911":45647,"_5":17806,"_24291":45549,"_2452":45648},[],"IAM action",{"_2926":1242,"_25639":1210,"_17911":45650,"_5":17806,"_24291":45549,"_2452":42143},[],{"_2926":1243,"_25639":1210,"_17911":45652,"_5":17806,"_24291":45549,"_2452":45653},[],"`iot:GetRegistrationCode`",{"_2926":1244,"_25639":1210,"_17911":45655,"_5":17806,"_24291":45549,"_2452":45656},[],"Obtain the verification code for CA registration in the Primary Account",{"_2926":1245,"_25639":1210,"_17911":45658,"_5":17806,"_24291":45549,"_2452":45659},[],"`iot:RegisterCACertificate`",{"_2926":1246,"_25639":1210,"_17911":45661,"_5":17806,"_24291":45549,"_2452":45662},[],"Register the CA in AWS IoT",{"_2926":1247,"_25639":1210,"_17911":45664,"_5":17806,"_24291":45549,"_2452":45665},[],"`iot:DescribeCACertificate`",{"_2926":1248,"_25639":1210,"_17911":45667,"_5":17806,"_24291":45549,"_2452":45668},[],"Check the CA registration status",{"_2926":1249,"_25639":1210,"_17911":45670,"_5":17806,"_24291":45549,"_2452":45671},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_2926":1250,"_25639":1210,"_17911":45673,"_5":17806,"_24291":45549,"_2452":45674},[],"Create or update Things in IoT Core",{"_2926":1251,"_25639":1210,"_17911":45676,"_5":17806,"_24291":45549,"_2452":45677},[],"`iot:RegisterThing`",{"_2926":1252,"_25639":1210,"_17911":45679,"_5":17806,"_24291":45549,"_2452":45680},[],"Provision Things through a template",{"_2926":1253,"_25639":1210,"_17911":45682,"_5":17806,"_24291":45549,"_2452":45683},[],"`iot:RegisterCertificate`",{"_2926":1254,"_25639":1210,"_17911":45685,"_5":17806,"_24291":45549,"_2452":45686},[],"Register device certificates",{"_2926":1255,"_25639":1210,"_17911":45688,"_5":17806,"_24291":45549,"_2452":45689},[],"`iot:UpdateCertificate`",{"_2926":1256,"_25639":1210,"_17911":45691,"_5":17806,"_24291":45549,"_2452":45692},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_2926":1257,"_25639":1210,"_17911":45694,"_5":17806,"_24291":45549,"_2452":45695},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_2926":1258,"_25639":1210,"_17911":45697,"_5":17806,"_24291":45549,"_2452":45698},[],"Create and attach IoT policies",{"_2926":1259,"_25639":1210,"_17911":45700,"_5":17806,"_24291":45549,"_2452":45701},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_2926":1260,"_25639":1210,"_17911":45703,"_5":17806,"_24291":45549,"_2452":45704},[],"Manage Thing groups",{"_2926":1261,"_25639":1210,"_17911":45706,"_5":17806,"_24291":45549,"_2452":45707},[],"`iot:CreateProvisioningTemplate`",{"_2926":1262,"_25639":1210,"_17911":45709,"_5":17806,"_24291":45549,"_2452":45710},[],"Create JITP templates",{"_2926":1263,"_25639":1210,"_17911":45712,"_5":17806,"_24291":45549,"_2452":45713},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_2926":1264,"_25639":1210,"_17911":45715,"_5":17806,"_24291":45549,"_2452":45716},[],"Read and write the Device Shadow",{"_2926":1265,"_25639":1210,"_17911":45718,"_5":17806,"_24291":45549,"_2452":45719},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_2926":1266,"_25639":1210,"_17911":45721,"_5":17806,"_24291":45553,"_2452":45722},[],"Parameter",{"_2926":1267,"_25639":1210,"_17911":45724,"_5":17806,"_24291":45553,"_2452":45725},[],"Type",{"_2926":1268,"_25639":1210,"_17911":45727,"_5":17806,"_24291":45553,"_2452":45728},[],"Required",{"_2926":1269,"_25639":1210,"_17911":45730,"_5":17806,"_24291":45553,"_2452":45731},[],"Description",{"_2926":1270,"_25639":1210,"_17911":45733,"_5":17806,"_24291":45553,"_2452":45734},[],"`connector_id`",{"_2926":1271,"_25639":1210,"_17911":45736,"_5":17806,"_24291":45553,"_2452":21377},[],{"_2926":1272,"_25639":1210,"_17911":45738,"_5":17806,"_24291":45553,"_2452":45739},[],"Yes",{"_2926":1273,"_25639":1210,"_17911":45741,"_5":17806,"_24291":45553,"_2452":45742},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_2926":1274,"_25639":1210,"_17911":45744,"_5":17806,"_24291":45553,"_2452":45745},[],"`aws_config.region`",{"_2926":1275,"_25639":1210,"_17911":45747,"_5":17806,"_24291":45553,"_2452":21377},[],{"_2926":1276,"_25639":1210,"_17911":45749,"_5":17806,"_24291":45553,"_2452":45739},[],{"_2926":1277,"_25639":1210,"_17911":45751,"_5":17806,"_24291":45553,"_2452":45752},[],"AWS region where the connector operates.",{"_2926":1278,"_25639":1210,"_17911":45754,"_5":17806,"_24291":45553,"_2452":45755},[],"`aws_config.auth_method`",{"_2926":1279,"_25639":1210,"_17911":45757,"_5":17806,"_24291":45553,"_2452":21377},[],{"_2926":1280,"_25639":1210,"_17911":45759,"_5":17806,"_24291":45553,"_2452":45739},[],{"_2926":1281,"_25639":1210,"_17911":45761,"_5":17806,"_24291":45553,"_2452":45762},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_2926":1282,"_25639":1210,"_17911":45764,"_5":17806,"_24291":45553,"_2452":45765},[],"`aws_config.access_key_id`",{"_2926":1283,"_25639":1210,"_17911":45767,"_5":17806,"_24291":45553,"_2452":21377},[],{"_2926":1284,"_25639":1210,"_17911":45769,"_5":17806,"_24291":45553,"_2452":45770},[],"Only with `auth_method=static`",{"_2926":1285,"_25639":1210,"_17911":45772,"_5":17806,"_24291":45553,"_2452":45773},[],"AWS access key.",{"_2926":1286,"_25639":1210,"_17911":45775,"_5":17806,"_24291":45553,"_2452":45776},[],"`aws_config.secret_access_key`",{"_2926":1287,"_25639":1210,"_17911":45778,"_5":17806,"_24291":45553,"_2452":21377},[],{"_2926":1288,"_25639":1210,"_17911":45780,"_5":17806,"_24291":45553,"_2452":45770},[],{"_2926":1289,"_25639":1210,"_17911":45782,"_5":17806,"_24291":45553,"_2452":45783},[],"AWS secret key.",{"_2926":1290,"_25639":1210,"_17911":45785,"_5":17806,"_24291":45553,"_2452":45786},[],"`aws_config.session_token`",{"_2926":1291,"_25639":1210,"_17911":45788,"_5":17806,"_24291":45553,"_2452":21377},[],{"_2926":1292,"_25639":1210,"_17911":45790,"_5":17806,"_24291":45553,"_2452":45791},[],"No",{"_2926":1293,"_25639":1210,"_17911":45793,"_5":17806,"_24291":45553,"_2452":45794},[],"Session token (with `auth_method=static`).",{"_2926":1294,"_25639":1210,"_17911":45796,"_5":17806,"_24291":45553,"_2452":45797},[],"`aws_config.role_arn`",{"_2926":1295,"_25639":1210,"_17911":45799,"_5":17806,"_24291":45553,"_2452":21377},[],{"_2926":1296,"_25639":1210,"_17911":45801,"_5":17806,"_24291":45553,"_2452":45802},[],"Only with `auth_method=role`",{"_2926":1297,"_25639":1210,"_17911":45804,"_5":17806,"_24291":45553,"_2452":45805},[],"ARN of the role to assume.",{"_2926":1298,"_25639":1210,"_17911":45807,"_5":17806,"_24291":45553,"_2452":45808},[],"`aws_config.endpoint_url`",{"_2926":1299,"_25639":1210,"_17911":45810,"_5":17806,"_24291":45553,"_2452":21377},[],{"_2926":1300,"_25639":1210,"_17911":45812,"_5":17806,"_24291":45553,"_2452":45791},[],{"_2926":1301,"_25639":1210,"_17911":45814,"_5":17806,"_24291":45553,"_2452":45815},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_2926":1302,"_25639":1210,"_17911":45817,"_5":17806,"_24291":45553,"_2452":45818},[],"`subscriber_event_bus`",{"_2926":1303,"_25639":1210,"_17911":45820,"_5":17806,"_24291":45553,"_2452":15023},[],{"_2926":1304,"_25639":1210,"_17911":45822,"_5":17806,"_24291":45553,"_2452":45739},[],{"_2926":1305,"_25639":1210,"_17911":45824,"_5":17806,"_24291":45553,"_2452":45825},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_2926":1306,"_25639":1210,"_17911":45827,"_5":17806,"_24291":45553,"_2452":45828},[],"`dms_manager_client`",{"_2926":1307,"_25639":1210,"_17911":45830,"_5":17806,"_24291":45553,"_2452":21377},[],{"_2926":1308,"_25639":1210,"_17911":45832,"_5":17806,"_24291":45553,"_2452":45739},[],{"_2926":1309,"_25639":1210,"_17911":45834,"_5":17806,"_24291":45553,"_2452":45835},[],"HTTP URL of Lamassu's DMS Manager service.",{"_2926":1310,"_25639":1210,"_17911":45837,"_5":17806,"_24291":45553,"_2452":45838},[],"`device_manager_client`",{"_2926":1311,"_25639":1210,"_17911":45840,"_5":17806,"_24291":45553,"_2452":21377},[],{"_2926":1312,"_25639":1210,"_17911":45842,"_5":17806,"_24291":45553,"_2452":45739},[],{"_2926":1313,"_25639":1210,"_17911":45844,"_5":17806,"_24291":45553,"_2452":45845},[],"HTTP URL of Lamassu's Device Manager.",{"_2926":1314,"_25639":1210,"_17911":45847,"_5":17806,"_24291":45553,"_2452":45848},[],"`ca_client`",{"_2926":1315,"_25639":1210,"_17911":45850,"_5":17806,"_24291":45553,"_2452":21377},[],{"_2926":1316,"_25639":1210,"_17911":45852,"_5":17806,"_24291":45553,"_2452":45739},[],{"_2926":1317,"_25639":1210,"_17911":45854,"_5":17806,"_24291":45553,"_2452":45855},[],"HTTP URL of Lamassu's CA service.",{"_2926":1318,"_25639":1210,"_17911":45857,"_5":17806,"_24291":45557,"_2452":45858},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_2926":1319,"_25639":1210,"_17911":45860,"_5":17806,"_24291":45561,"_2452":45861},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_2926":1320,"_25639":1210,"_17911":45863,"_5":17806,"_24291":45561,"_2452":45864},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_2926":1321,"_25639":1210,"_17911":45866,"_5":17806,"_24291":45565,"_2452":45867},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_2926":1322,"_25639":1210,"_17911":45869,"_5":17806,"_24291":45565,"_2452":45870},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_2926":1323,"_25639":1210,"_17911":45872,"_5":17806,"_24291":45565,"_2452":45873},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_2926":1324,"_25639":1210,"_17911":45875,"_5":17806,"_24291":45565,"_2452":45876},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_2926":1325,"_25639":1210,"_17911":45878,"_5":17806,"_24291":45565,"_2452":45879},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_2926":1326,"_25639":1210,"_17911":45881,"_5":17806,"_24291":45565,"_2452":45882},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_2926":1327,"_25639":1210,"_17911":45884,"_5":17806,"_24291":45569,"_2452":45885},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_2926":1328,"_25639":1210,"_17911":45887,"_5":17806,"_24291":45573,"_2452":45888},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_2926":1329,"_25639":1210,"_17911":45890,"_5":17806,"_24291":45573,"_2452":45891},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_2926":1330,"_25639":1210,"_17911":45893,"_5":17806,"_24291":45577,"_2452":45894},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_2926":1331,"_25639":1210,"_17911":45896,"_5":17806,"_24291":45581,"_2452":45897},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_2926":1332,"_25639":1210,"_17911":45899,"_5":17806,"_24291":45581,"_2452":45900},[],"Creates or updates the IoT policies configured in the DMS.",{"_2926":1333,"_25639":1210,"_17911":45902,"_5":17806,"_24291":45581,"_2452":45903},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_2926":1334,"_25639":1210,"_17911":45905,"_5":17806,"_24291":45581,"_2452":45906},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_2926":1335,"_25639":1210,"_17911":45908,"_5":17806,"_24291":45581,"_2452":45909},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_2926":1336,"_25639":1210,"_17911":45911,"_5":17806,"_24291":45581,"_2452":45912},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_2926":1337,"_25639":1210,"_17911":45914,"_5":17806,"_24291":45581,"_2452":45915},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_2926":1338,"_25639":1210,"_17911":45917,"_5":17806,"_24291":45585,"_2452":45918},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_2926":1339,"_25639":1210,"_17911":45920,"_5":17806,"_24291":45585,"_2452":45921},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_2926":1340,"_25639":1210,"_17911":45923,"_5":17806,"_24291":45585,"_2452":45924},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_2926":1341,"_25639":1210,"_17911":45926,"_5":17806,"_24291":45589,"_2452":45927},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_2926":1342,"_25639":1210,"_17911":45929,"_5":17806,"_24291":45589,"_2452":45930},[],"The full flow from the device's perspective is:",{"_2926":1343,"_25639":1210,"_17911":45932,"_5":17806,"_24291":45589,"_2452":45933},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_2926":1344,"_25639":1210,"_17911":45935,"_5":17806,"_24291":45593,"_2452":45936},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_2926":1345,"_25639":1210,"_17911":45938,"_5":17806,"_24291":45593,"_2452":45939},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_2926":1346,"_25639":1210,"_17911":45941,"_5":17806,"_24291":45593,"_2452":45942},[],"For the JITP flow to work correctly:",{"_2926":1347,"_25639":1210,"_17911":45944,"_5":17806,"_24291":45593,"_2452":45945},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_2926":1348,"_25639":1210,"_17911":45947,"_5":17806,"_24291":45593,"_2452":45948},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_2926":1349,"_25639":1210,"_17911":45950,"_5":17806,"_24291":45593,"_2452":45951},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_2926":1350,"_25639":1210,"_17911":45953,"_5":17806,"_24291":45593,"_2452":45954},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_2926":1351,"_25639":1210,"_17911":45956,"_5":17806,"_24291":45597,"_2452":45957},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_2926":1352,"_25639":1210,"_17911":45959,"_5":17806,"_24291":45597,"_2452":45960},[],"Status in Lamassu",{"_2926":1353,"_25639":1210,"_17911":45962,"_5":17806,"_24291":45597,"_2452":45963},[],"Revocation reason",{"_2926":1354,"_25639":1210,"_17911":45965,"_5":17806,"_24291":45597,"_2452":45966},[],"Status in AWS IoT Core",{"_2926":1355,"_25639":1210,"_17911":45968,"_5":17806,"_24291":45597,"_2452":45969},[],"`Active`",{"_2926":1356,"_25639":1210,"_17911":45971,"_5":17806,"_24291":45597,"_2452":45972},[],"None",{"_2926":1357,"_25639":1210,"_17911":45974,"_5":17806,"_24291":45597,"_2452":45975},[],"`ACTIVE`",{"_2926":1358,"_25639":1210,"_17911":45977,"_5":17806,"_24291":45597,"_2452":45978},[],"`Revoked`",{"_2926":1359,"_25639":1210,"_17911":45980,"_5":17806,"_24291":45597,"_2452":45981},[],"`certificateHold`",{"_2926":1360,"_25639":1210,"_17911":45983,"_5":17806,"_24291":45597,"_2452":45984},[],"`INACTIVE`",{"_2926":1361,"_25639":1210,"_17911":45986,"_5":17806,"_24291":45597,"_2452":45978},[],{"_2926":1362,"_25639":1210,"_17911":45988,"_5":17806,"_24291":45597,"_2452":45989},[],"Any other reason",{"_2926":1363,"_25639":1210,"_17911":45991,"_5":17806,"_24291":45597,"_2452":45992},[],"`REVOKED`",{"_2926":1364,"_25639":1210,"_17911":45994,"_5":17806,"_24291":45597,"_2452":45995},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_2926":1365,"_25639":1210,"_17911":45997,"_5":17806,"_24291":45601,"_2452":45998},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_2926":1366,"_25639":1210,"_17911":46000,"_5":17806,"_24291":45601,"_2452":46001},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_2926":1367,"_25639":1210,"_17911":46003,"_5":17806,"_24291":45601,"_2452":46004},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_2926":1368,"_25639":1210,"_17911":46006,"_5":17806,"_24291":45605,"_2452":46007},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_2926":1369,"_25639":1210,"_17911":46009,"_5":17806,"_24291":45605,"_2452":46010},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_2926":1370,"_25639":1210,"_17911":46012,"_5":17806,"_24291":45609,"_2452":46013},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_2926":1371,"_25639":1210,"_17911":46015,"_5":17806,"_24291":45609,"_2452":46016},[],"There are two action types:",{"_2926":1372,"_25639":1210,"_17911":46018,"_5":17806,"_24291":45609,"_2452":46019},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_2926":1373,"_25639":1210,"_17911":46021,"_5":17806,"_24291":45609,"_2452":46022},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_2926":1374,"_25639":1210,"_17911":46024,"_5":17806,"_24291":45609,"_2452":46025},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_2926":1375,"_25639":1210,"_17911":46027,"_5":17806,"_24291":45613,"_2452":46028},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_2926":1376,"_25639":1210,"_17911":46030,"_5":17806,"_24291":45613,"_2452":46031},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_2926":1377,"_25639":1210,"_17911":46033,"_5":17806,"_24291":45613,"_2452":46034},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_2926":1378,"_25639":1210,"_17911":46036,"_5":17806,"_24291":45617,"_2452":46037},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_2926":1379,"_25639":1210,"_17911":46039,"_5":17806,"_24291":45617,"_2452":46040},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_2926":1380,"_25639":1210,"_17911":46042,"_5":17806,"_24291":45617,"_2452":46043},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_2926":1381,"_25639":1210,"_17911":46045,"_5":17806,"_24291":45617,"_2452":46046},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_2926":1382,"_25639":1210,"_17911":46048,"_5":17806,"_24291":45617,"_2452":46049},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_2926":1383,"_25639":1210,"_17911":46051,"_5":17806,"_24291":45617,"_2452":46052},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_2926":1384,"_25639":1210,"_17911":46054,"_5":17806,"_24291":45617,"_2452":46055},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_2926":1385,"_25639":1210,"_17911":46057,"_5":17806,"_24291":45617,"_2452":46058},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_2926":1386,"_25639":1210,"_17911":46060,"_5":17806,"_24291":45617,"_2452":46061},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_2926":1387,"_25639":1210,"_17911":46063,"_5":17806,"_24291":45617,"_2452":46064},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_2926":1388,"_25639":1210,"_17911":46066,"_5":17806,"_24291":45617,"_2452":46067},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_2926":1389,"_25639":1210,"_17911":46069,"_5":17806,"_24291":45617,"_2452":46070},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_2926":1390,"_25639":1210,"_17911":46072,"_5":17806,"_24291":45617,"_2452":46073},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_2926":1391,"_25639":1210,"_17911":46075,"_5":17806,"_24291":45617,"_2452":46076},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_2926":1392,"_25639":1210,"_17911":46078,"_5":17806,"_24291":45617,"_2452":46079},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_2926":1393,"_25639":1210,"_17911":46081,"_5":17806,"_24291":45617,"_2452":46082},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_2926":1394,"_25639":1210,"_17911":46084,"_5":17806,"_24291":45617,"_2452":46085},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_2926":1395,"_25639":1210,"_17911":46087,"_5":17806,"_24291":45617,"_2452":46088},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_2926":1396,"_25639":1210,"_17911":46090,"_5":17806,"_24291":45617,"_2452":46091},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2926":1397,"_25639":1210,"_17911":46093,"_5":17806,"_24291":45617,"_2452":46094},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2926":1398,"_25639":1210,"_17911":46096,"_5":17806,"_24291":45617,"_2452":46097},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_2926":1399,"_25639":1399,"_5":12558,"_2452":44078,"_25983":46099,"_17911":46100,"_24291":1399},[41760,43104,44078],[],{"_2926":1400,"_25639":1399,"_17911":46102,"_5":17806,"_24291":1399,"_2452":46103},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_2926":1401,"_25639":1399,"_5":25980,"_17911":46105,"_24291":46106,"_2452":46107},[],"/docs/pr-preview/pr-48/platform/iot-fleets/overview#start-here","Start here",{"_2926":1402,"_25639":1399,"_5":25980,"_17911":46109,"_24291":46110,"_2452":44076},[],"/docs/pr-preview/pr-48/platform/iot-fleets/overview#devices-and-identities",{"_2926":1403,"_25639":1399,"_5":25980,"_17911":46112,"_24291":46113,"_2452":44259},[],"/docs/pr-preview/pr-48/platform/iot-fleets/overview#enrollment-with-pki",{"_2926":1404,"_25639":1399,"_5":25980,"_17911":46115,"_24291":46116,"_2452":45534},[],"/docs/pr-preview/pr-48/platform/iot-fleets/overview#integrations",{"_2926":1405,"_25639":1399,"_5":25980,"_17911":46118,"_24291":46119,"_2452":46120},[],"/docs/pr-preview/pr-48/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_2926":1406,"_25639":1399,"_17911":46122,"_5":17806,"_24291":1399,"_2452":46123},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_2926":1407,"_25639":1399,"_17911":46125,"_5":17806,"_24291":46106,"_2452":46126},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_2926":1408,"_25639":1399,"_17911":46128,"_5":17806,"_24291":46106,"_2452":46129},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_2926":1409,"_25639":1399,"_17911":46131,"_5":17806,"_24291":46110,"_2452":46132},[],"Resource",{"_2926":1410,"_25639":1399,"_17911":46134,"_5":17806,"_24291":46110,"_2452":46135},[],"What it represents",{"_2926":1411,"_25639":1399,"_17911":46137,"_5":17806,"_24291":46110,"_2452":46138},[],"**Device**",{"_2926":1412,"_25639":1399,"_17911":46140,"_5":17806,"_24291":46110,"_2452":46141},[],"An inventory entry with an identifier, owning DMS and classification.",{"_2926":1413,"_25639":1399,"_17911":46143,"_5":17806,"_24291":46110,"_2452":46144},[],"**Identity**",{"_2926":1414,"_25639":1399,"_17911":46146,"_5":17806,"_24291":46110,"_2452":46147},[],"The device's association with its certificates: an active version and a history.",{"_2926":1415,"_25639":1399,"_17911":46149,"_5":17806,"_24291":46110,"_2452":46150},[],"**DMS**",{"_2926":1416,"_25639":1399,"_17911":46152,"_5":17806,"_24291":46110,"_2452":46153},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_2926":1417,"_25639":1399,"_17911":46155,"_5":17806,"_24291":46110,"_2452":46156},[],"**Fleet**",{"_2926":1418,"_25639":1399,"_17911":46158,"_5":17806,"_24291":46110,"_2452":46159},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_2926":1419,"_25639":1399,"_17911":46161,"_5":17806,"_24291":46110,"_2452":46162},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_2926":1420,"_25639":1399,"_17911":46164,"_5":17806,"_24291":46110,"_2452":46165},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_2926":1421,"_25639":1399,"_17911":46167,"_5":17806,"_24291":46113,"_2452":46168},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_2926":1422,"_25639":1399,"_17911":46170,"_5":17806,"_24291":46113,"_2452":46171},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_2926":1423,"_25639":1399,"_17911":46173,"_5":17806,"_24291":46113,"_2452":46174},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_2926":1424,"_25639":1399,"_17911":46176,"_5":17806,"_24291":46113,"_2452":46177},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_2926":1425,"_25639":1399,"_17911":46179,"_5":17806,"_24291":46113,"_2452":46180},[],"**Result:** request the certificate, install it and check its association with the device.",{"_2926":1426,"_25639":1399,"_17911":46182,"_5":17806,"_24291":46113,"_2452":46183},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_2926":1427,"_25639":1399,"_17911":46185,"_5":17806,"_24291":46113,"_2452":46186},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2926":1428,"_25639":1399,"_17911":46188,"_5":17806,"_24291":46113,"_2452":46189},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2926":1429,"_25639":1399,"_17911":46191,"_5":17806,"_24291":46116,"_2452":46192},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_2926":1430,"_25639":1399,"_17911":46194,"_5":17806,"_24291":46116,"_2452":46195},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_2926":1431,"_25639":1399,"_17911":46197,"_5":17806,"_24291":46119,"_2452":46198},[],"Participant",{"_2926":1432,"_25639":1399,"_17911":46200,"_5":17806,"_24291":46119,"_2452":46201},[],"Responsibility",{"_2926":1433,"_25639":1399,"_17911":46203,"_5":17806,"_24291":46119,"_2452":46204},[],"PKI administrator",{"_2926":1434,"_25639":1399,"_17911":46206,"_5":17806,"_24291":46119,"_2452":46207},[],"CA, issuance profile, chain and revocation publication.",{"_2926":1435,"_25639":1399,"_17911":46209,"_5":17806,"_24291":46119,"_2452":46210},[],"Provisioning administrator",{"_2926":1436,"_25639":1399,"_17911":46212,"_5":17806,"_24291":46119,"_2452":46213},[],"DMS, admission, authentication per operation and inventory.",{"_2926":1437,"_25639":1399,"_17911":46215,"_5":17806,"_24291":46119,"_2452":46216},[],"Device integrator",{"_2926":1438,"_25639":1399,"_17911":46218,"_5":17806,"_24291":46119,"_2452":46219},[],"Initial credential, key, EST client, trust and certificate installation.",{"_2926":1439,"_25639":1399,"_17911":46221,"_5":17806,"_24291":46119,"_2452":46222},[],"Consumer integrator",{"_2926":1440,"_25639":1399,"_17911":46224,"_5":17806,"_24291":46119,"_2452":46225},[],"Trusted issuers, validation and device permissions in the destination.",{"_2926":1441,"_25639":1399,"_17911":46227,"_5":17806,"_24291":46119,"_2452":46228},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_2926":1442,"_25639":1442,"_5":12558,"_2452":46230,"_25983":46231,"_17911":46233,"_24291":1442},"Enroll and connect your first device",[41760,43104,44078,46232],"Getting started",[],{"_2926":1443,"_25639":1442,"_17911":46235,"_5":17806,"_24291":1442,"_2452":46236},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_2926":1444,"_25639":1442,"_5":25980,"_17911":46238,"_24291":46239,"_2452":41770},[],"/docs/pr-preview/pr-48/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_2926":1445,"_25639":1442,"_5":25980,"_17911":46241,"_24291":46242,"_2452":46243},[],"/docs/pr-preview/pr-48/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_2926":1446,"_25639":1442,"_5":25980,"_17911":46245,"_24291":46246,"_2452":46247},[],"/docs/pr-preview/pr-48/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_2926":1447,"_25639":1442,"_5":25980,"_17911":46249,"_24291":46250,"_2452":46251},[],"/docs/pr-preview/pr-48/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_2926":1448,"_25639":1442,"_5":25980,"_17911":46253,"_24291":46254,"_2452":46255},[],"/docs/pr-preview/pr-48/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_2926":1449,"_25639":1442,"_5":25980,"_17911":46257,"_24291":46258,"_2452":46259},[],"/docs/pr-preview/pr-48/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_2926":1450,"_25639":1442,"_5":25980,"_17911":46261,"_24291":46262,"_2452":46263},[],"/docs/pr-preview/pr-48/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_2926":1451,"_25639":1442,"_5":25980,"_17911":46265,"_24291":46266,"_2452":46267},[],"/docs/pr-preview/pr-48/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_2926":1452,"_25639":1442,"_17911":46269,"_5":17806,"_24291":1442,"_2452":46270},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_2926":1453,"_25639":1442,"_17911":46272,"_5":17806,"_24291":46239,"_2452":46273},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_2926":1454,"_25639":1442,"_17911":46275,"_5":17806,"_24291":46239,"_2452":46276},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_2926":1455,"_25639":1442,"_17911":46278,"_5":17806,"_24291":46239,"_2452":46279},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_2926":1456,"_25639":1442,"_17911":46281,"_5":17806,"_24291":46239,"_2452":46282},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_2926":1457,"_25639":1442,"_17911":46284,"_5":17806,"_24291":46239,"_2452":46285},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_2926":1458,"_25639":1442,"_17911":46287,"_5":17806,"_24291":46242,"_2452":46288},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_2926":1459,"_25639":1442,"_17911":46290,"_5":17806,"_24291":46242,"_2452":46291},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_2926":1460,"_25639":1442,"_17911":46293,"_5":17806,"_24291":46246,"_2452":46294},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_2926":1461,"_25639":1442,"_17911":46296,"_5":17806,"_24291":46246,"_2452":46297},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_2926":1462,"_25639":1442,"_17911":46299,"_5":17806,"_24291":46246,"_2452":46300},[],"Setting",{"_2926":1463,"_25639":1442,"_17911":46302,"_5":17806,"_24291":46246,"_2452":46303},[],"Evaluation value",{"_2926":1464,"_25639":1442,"_17911":46305,"_5":17806,"_24291":46246,"_2452":46306},[],"Enrollment CA",{"_2926":1465,"_25639":1442,"_17911":46308,"_5":17806,"_24291":46246,"_2452":46309},[],"Issuing root from `device-root.pem`.",{"_2926":1466,"_25639":1442,"_17911":46311,"_5":17806,"_24291":46246,"_2452":44389},[],{"_2926":1467,"_25639":1442,"_17911":46313,"_5":17806,"_24291":46246,"_2452":46314},[],"The 1-hour leaf profile you just prepared.",{"_2926":1468,"_25639":1442,"_17911":46316,"_5":17806,"_24291":46246,"_2452":46317},[],"Protocol / Registration Mode",{"_2926":1469,"_25639":1442,"_17911":46319,"_5":17806,"_24291":46246,"_2452":46320},[],"`EST_RFC7030` / `JITP`.",{"_2926":1470,"_25639":1442,"_17911":46322,"_5":17806,"_24291":46246,"_2452":46323},[],"Verify CSR Signature",{"_2926":1471,"_25639":1442,"_17911":46325,"_5":17806,"_24291":46246,"_2452":46326},[],"Enabled.",{"_2926":1472,"_25639":1442,"_17911":46328,"_5":17806,"_24291":46246,"_2452":46329},[],"Enable Replaceable Enrollment",{"_2926":1473,"_25639":1442,"_17911":46331,"_5":17806,"_24291":46246,"_2452":46332},[],"Disabled; the ID must be new.",{"_2926":1474,"_25639":1442,"_17911":46334,"_5":17806,"_24291":46246,"_2452":46335},[],"Initial authentication",{"_2926":1475,"_25639":1442,"_17911":46337,"_5":17806,"_24291":46246,"_2452":46338},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_2926":1476,"_25639":1442,"_17911":46340,"_5":17806,"_24291":46246,"_2452":46341},[],"Renewal authentication",{"_2926":1477,"_25639":1442,"_17911":46343,"_5":17806,"_24291":46246,"_2452":46344},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_2926":1478,"_25639":1442,"_17911":46346,"_5":17806,"_24291":46246,"_2452":46347},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_2926":1479,"_25639":1442,"_17911":46349,"_5":17806,"_24291":46246,"_2452":46350},[],"Empty list for this direct issuance / disabled.",{"_2926":1480,"_25639":1442,"_17911":46352,"_5":17806,"_24291":46246,"_2452":46353},[],"Re-enrollment Delta",{"_2926":1481,"_25639":1442,"_17911":46355,"_5":17806,"_24291":46246,"_2452":46356},[],"1 hour.",{"_2926":1482,"_25639":1442,"_17911":46358,"_5":17806,"_24291":46246,"_2452":46359},[],"Preventive / Critical Delta",{"_2926":1483,"_25639":1442,"_17911":46361,"_5":17806,"_24291":46246,"_2452":46362},[],"30 minutes / 10 minutes.",{"_2926":1484,"_25639":1442,"_17911":46364,"_5":17806,"_24291":46246,"_2452":46365},[],"Revoke on Re-enrollment",{"_2926":1485,"_25639":1442,"_17911":46367,"_5":17806,"_24291":46246,"_2452":46368},[],"Disabled to test the successor before retiring the previous identity.",{"_2926":1486,"_25639":1442,"_17911":46370,"_5":17806,"_24291":46246,"_2452":44397},[],{"_2926":1487,"_25639":1442,"_17911":46372,"_5":17806,"_24291":46246,"_2452":46373},[],"Disabled; the operational key is generated in the client.",{"_2926":1488,"_25639":1442,"_17911":46375,"_5":17806,"_24291":46246,"_2452":46376},[],"CA Distribution",{"_2926":1489,"_25639":1442,"_17911":46378,"_5":17806,"_24291":46246,"_2452":46379},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_2926":1490,"_25639":1442,"_17911":46381,"_5":17806,"_24291":46246,"_2452":46382},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. If your console does not expose the independent block, configure and check the resource through the DMS API and DMS guide.",{"_2926":1491,"_25639":1442,"_17911":46384,"_5":17806,"_24291":46250,"_2452":46385},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_2926":1492,"_25639":1442,"_17911":46387,"_5":17806,"_24291":46250,"_2452":46388},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_2926":1493,"_25639":1442,"_17911":46390,"_5":17806,"_24291":46254,"_2452":46391},[],"Generate a new key and CSR with the selected identifier:",{"_2926":1494,"_25639":1442,"_17911":46393,"_5":17806,"_24291":46254,"_2452":46394},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_2926":1495,"_25639":1442,"_17911":46396,"_5":17806,"_24291":46254,"_2452":46397},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_2926":1496,"_25639":1442,"_17911":46399,"_5":17806,"_24291":46258,"_2452":46400},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_2926":1497,"_25639":1442,"_17911":46402,"_5":17806,"_24291":46258,"_2452":46403},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_2926":1498,"_25639":1442,"_17911":46405,"_5":17806,"_24291":46262,"_2452":46406},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_2926":1499,"_25639":1442,"_17911":46408,"_5":17806,"_24291":46262,"_2452":46409},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_2926":1500,"_25639":1442,"_17911":46411,"_5":17806,"_24291":46262,"_2452":46412},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_2926":1501,"_25639":1442,"_17911":46414,"_5":17806,"_24291":46262,"_2452":46415},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_2926":1502,"_25639":1442,"_17911":46417,"_5":17806,"_24291":46262,"_2452":46418},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_2926":1503,"_25639":1442,"_17911":46420,"_5":17806,"_24291":46266,"_2452":46421},[],"Check",{"_2926":1504,"_25639":1442,"_17911":46423,"_5":17806,"_24291":46266,"_2452":46424},[],"Expected result",{"_2926":1505,"_25639":1442,"_17911":46426,"_5":17806,"_24291":46266,"_2452":46427},[],"Registration",{"_2926":1506,"_25639":1442,"_17911":46429,"_5":17806,"_24291":46266,"_2452":46430},[],"ID created automatically and correct DMS.",{"_2926":1507,"_25639":1442,"_17911":46432,"_5":17806,"_24291":46266,"_2452":46433},[],"Certificate",{"_2926":1508,"_25639":1442,"_17911":46435,"_5":17806,"_24291":46266,"_2452":46436},[],"CN, profile, serial and key verified.",{"_2926":1509,"_25639":1442,"_17911":46438,"_5":17806,"_24291":46266,"_2452":46439},[],"Inventory",{"_2926":1510,"_25639":1442,"_17911":46441,"_5":17806,"_24291":46266,"_2452":46442},[],"Received serial visible as the current identity and in history.",{"_2926":1511,"_25639":1442,"_17911":46444,"_5":17806,"_24291":46266,"_2452":46445},[],"Consumer",{"_2926":1512,"_25639":1442,"_17911":46447,"_5":17806,"_24291":46266,"_2452":46448},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_2926":1513,"_25639":1442,"_17911":46450,"_5":17806,"_24291":46266,"_2452":46451},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_2926":1514,"_25639":1442,"_17911":46453,"_5":17806,"_24291":46266,"_2452":46454},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_2926":1515,"_25639":1515,"_5":12558,"_2452":44094,"_25983":46456,"_17911":46457,"_24291":1515},[41760,43104,44078,46232],[],{"_2926":1516,"_25639":1515,"_17911":46459,"_5":17806,"_24291":1515,"_2452":46460},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_2926":1517,"_25639":1515,"_5":25980,"_17911":46462,"_24291":46463,"_2452":41770},[],"/docs/pr-preview/pr-48/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_2926":1518,"_25639":1515,"_5":25980,"_17911":46465,"_24291":46466,"_2452":46467},[],"/docs/pr-preview/pr-48/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_2926":1519,"_25639":1515,"_5":25980,"_17911":46469,"_24291":46470,"_2452":46471},[],"/docs/pr-preview/pr-48/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_2926":1520,"_25639":1515,"_5":25980,"_17911":46473,"_24291":46474,"_2452":46475},[],"/docs/pr-preview/pr-48/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_2926":1521,"_25639":1515,"_5":25980,"_17911":46477,"_24291":46478,"_2452":46479},[],"/docs/pr-preview/pr-48/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_2926":1522,"_25639":1515,"_5":25980,"_17911":46481,"_24291":46482,"_2452":46483},[],"/docs/pr-preview/pr-48/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_2926":1523,"_25639":1515,"_5":25980,"_17911":46485,"_24291":46486,"_2452":46424},[],"/docs/pr-preview/pr-48/platform/iot-fleets/quickstarts/register-device#expected-result",{"_2926":1524,"_25639":1515,"_5":25980,"_17911":46488,"_24291":46489,"_2452":46490},[],"/docs/pr-preview/pr-48/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_2926":1525,"_25639":1515,"_5":25980,"_17911":46492,"_24291":46493,"_2452":46494},[],"/docs/pr-preview/pr-48/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_2926":1526,"_25639":1515,"_17911":46496,"_5":17806,"_24291":1515,"_2452":46497},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_2926":1527,"_25639":1515,"_17911":46499,"_5":17806,"_24291":1515,"_2452":46500},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_2926":1528,"_25639":1515,"_17911":46502,"_5":17806,"_24291":46463,"_2452":46503},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_2926":1529,"_25639":1515,"_17911":46505,"_5":17806,"_24291":46463,"_2452":46506},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_2926":1530,"_25639":1515,"_17911":46508,"_5":17806,"_24291":46463,"_2452":46509},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_2926":1531,"_25639":1515,"_17911":46511,"_5":17806,"_24291":46463,"_2452":46512},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_2926":1532,"_25639":1515,"_17911":46514,"_5":17806,"_24291":46466,"_2452":46515},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_2926":1533,"_25639":1515,"_17911":46517,"_5":17806,"_24291":46466,"_2452":46518},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_2926":1534,"_25639":1515,"_17911":46520,"_5":17806,"_24291":46466,"_2452":46521},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_2926":1535,"_25639":1515,"_17911":46523,"_5":17806,"_24291":46466,"_2452":46524},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_2926":1536,"_25639":1515,"_17911":46526,"_5":17806,"_24291":46466,"_2452":46527},[],"Set **Authentication Mode** to `CLIENT_CERTIFICATE` and add the CA whose initial certificates you will accept in **Validation CAs**. For this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and server key generation disabled if you will not use it.",{"_2926":1537,"_25639":1515,"_17911":46529,"_5":17806,"_24291":46466,"_2452":46530},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_2926":1538,"_25639":1515,"_17911":46532,"_5":17806,"_24291":46466,"_2452":46533},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_2926":1539,"_25639":1515,"_17911":46535,"_5":17806,"_24291":46466,"_2452":46536},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_2926":1540,"_25639":1515,"_17911":46538,"_5":17806,"_24291":46470,"_2452":46539},[],"Open **Managed Devices** and the registration action. Complete:",{"_2926":1541,"_25639":1515,"_17911":46541,"_5":17806,"_24291":46470,"_2452":46542},[],"**Device ID**: `device-001`.",{"_2926":1542,"_25639":1515,"_17911":46544,"_5":17806,"_24291":46470,"_2452":46545},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_2926":1543,"_25639":1515,"_17911":46547,"_5":17806,"_24291":46470,"_2452":46548},[],"**Icon** and **Tags**: optional classification.",{"_2926":1544,"_25639":1515,"_17911":46550,"_5":17806,"_24291":46470,"_2452":46551},[],"Confirm registration.",{"_2926":1545,"_25639":1515,"_17911":46553,"_5":17806,"_24291":46474,"_2452":46554},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_2926":1546,"_25639":1515,"_17911":46556,"_5":17806,"_24291":46474,"_2452":46557},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_2926":1547,"_25639":1515,"_17911":46559,"_5":17806,"_24291":46478,"_2452":46560},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_2926":1548,"_25639":1515,"_17911":46562,"_5":17806,"_24291":46478,"_2452":46563},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_2926":1549,"_25639":1515,"_17911":46565,"_5":17806,"_24291":46482,"_2452":46566},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_2926":1550,"_25639":1515,"_17911":46568,"_5":17806,"_24291":46482,"_2452":46569},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_2926":1551,"_25639":1515,"_17911":46571,"_5":17806,"_24291":46486,"_2452":46421},[],{"_2926":1552,"_25639":1515,"_17911":46573,"_5":17806,"_24291":46486,"_2452":46574},[],"Result",{"_2926":1553,"_25639":1515,"_17911":46576,"_5":17806,"_24291":46486,"_2452":46577},[],"Device",{"_2926":1554,"_25639":1515,"_17911":46579,"_5":17806,"_24291":46486,"_2452":46580},[],"`device-001` appears in inventory with the expected DMS.",{"_2926":1555,"_25639":1515,"_17911":46582,"_5":17806,"_24291":46486,"_2452":46583},[],"Current identity",{"_2926":1556,"_25639":1515,"_17911":46585,"_5":17806,"_24291":46486,"_2452":46586},[],"The associated certificate matches the one you verified in PKI.",{"_2926":1557,"_25639":1515,"_17911":46588,"_5":17806,"_24291":46486,"_2452":46589},[],"History",{"_2926":1558,"_25639":1515,"_17911":46591,"_5":17806,"_24291":46486,"_2452":46592},[],"The associated issuance appears with its serial number and dates.",{"_2926":1559,"_25639":1515,"_17911":46594,"_5":17806,"_24291":46486,"_2452":46595},[],"Key and certificate",{"_2926":1560,"_25639":1515,"_17911":46597,"_5":17806,"_24291":46486,"_2452":46598},[],"You have the verified pair ready to install on the device.",{"_2926":1561,"_25639":1515,"_17911":46600,"_5":17806,"_24291":46489,"_2452":46601},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_2926":1562,"_25639":1515,"_17911":46603,"_5":17806,"_24291":46489,"_2452":46604},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_2926":1563,"_25639":1515,"_17911":46606,"_5":17806,"_24291":46489,"_2452":46607},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_2926":1564,"_25639":1515,"_17911":46609,"_5":17806,"_24291":46489,"_2452":46610},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_2926":1565,"_25639":1515,"_17911":46612,"_5":17806,"_24291":46493,"_2452":46613},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_2926":1566,"_25639":1515,"_17911":46615,"_5":17806,"_24291":46493,"_2452":46616},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_2926":1567,"_25639":1515,"_17911":46618,"_5":17806,"_24291":46493,"_2452":46619},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_2926":1568,"_25639":1568,"_5":12558,"_2452":46621,"_25983":46622,"_17911":46623,"_24291":1568},"Lamassu IoT Platform",[41760,43104],[],{"_2926":1569,"_25639":1568,"_17911":46625,"_5":17806,"_24291":1568,"_2452":46626},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_2926":1570,"_25639":1568,"_5":25980,"_17911":46628,"_24291":46629,"_2452":46107},[],"/docs/pr-preview/pr-48/platform/overview#start-here",{"_2926":1571,"_25639":1568,"_5":25980,"_17911":46631,"_24291":46632,"_2452":46633},[],"/docs/pr-preview/pr-48/platform/overview#choose-your-path","Choose your path",{"_2926":1572,"_25639":1568,"_5":25980,"_17911":46635,"_24291":46636,"_2452":46637},[],"/docs/pr-preview/pr-48/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_2926":1573,"_25639":1568,"_5":25980,"_17911":46639,"_24291":46640,"_2452":46641},[],"/docs/pr-preview/pr-48/platform/overview#core-capabilities","Core capabilities",{"_2926":1574,"_25639":1568,"_5":25980,"_17911":46643,"_24291":46644,"_2452":46645},[],"/docs/pr-preview/pr-48/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_2926":1575,"_25639":1568,"_5":25980,"_17911":46647,"_24291":46648,"_2452":46649},[],"/docs/pr-preview/pr-48/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_2926":1576,"_25639":1568,"_5":25980,"_17911":46651,"_24291":46652,"_2452":46653},[],"/docs/pr-preview/pr-48/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_2926":1577,"_25639":1568,"_5":25980,"_17911":46655,"_24291":46656,"_2452":46657},[],"/docs/pr-preview/pr-48/platform/overview#automate-device-identities","Automate device identities",{"_2926":1578,"_25639":1568,"_5":25980,"_17911":46659,"_24291":46660,"_2452":46661},[],"/docs/pr-preview/pr-48/platform/overview#publish-validation-status","Publish validation status",{"_2926":1579,"_25639":1568,"_5":25980,"_17911":46663,"_24291":46664,"_2452":46665},[],"/docs/pr-preview/pr-48/platform/overview#react-to-events","React to events",{"_2926":1580,"_25639":1568,"_5":25980,"_17911":46667,"_24291":46668,"_2452":46669},[],"/docs/pr-preview/pr-48/platform/overview#operational-reference","Operational reference",{"_2926":1581,"_25639":1568,"_17911":46671,"_5":17806,"_24291":1568,"_2452":46672},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_2926":1582,"_25639":1568,"_17911":46674,"_5":17806,"_24291":46629,"_2452":46675},[],"Choose the result you need:",{"_2926":1583,"_25639":1568,"_17911":46677,"_5":17806,"_24291":46629,"_2452":46678},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2926":1584,"_25639":1568,"_17911":46680,"_5":17806,"_24291":46629,"_2452":46681},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2926":1585,"_25639":1568,"_17911":46683,"_5":17806,"_24291":46629,"_2452":46684},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_2926":1586,"_25639":1568,"_17911":46686,"_5":17806,"_24291":46632,"_2452":46687},[],"Section",{"_2926":1587,"_25639":1568,"_17911":46689,"_5":17806,"_24291":46632,"_2452":46690},[],"What you manage",{"_2926":1588,"_25639":1568,"_17911":46692,"_5":17806,"_24291":46632,"_2452":46693},[],"Entry point",{"_2926":1589,"_25639":1568,"_17911":46695,"_5":17806,"_24291":46632,"_2452":46696},[],"**PKI**",{"_2926":1590,"_25639":1568,"_17911":46698,"_5":17806,"_24291":46632,"_2452":46699},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_2926":1591,"_25639":1568,"_17911":46701,"_5":17806,"_24291":46632,"_2452":46702},[],"PKI overview",{"_2926":1592,"_25639":1568,"_17911":46704,"_5":17806,"_24291":46632,"_2452":46705},[],"**IoT Fleets**",{"_2926":1593,"_25639":1568,"_17911":46707,"_5":17806,"_24291":46632,"_2452":46708},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_2926":1594,"_25639":1568,"_17911":46710,"_5":17806,"_24291":46632,"_2452":46711},[],"IoT Fleets overview",{"_2926":1595,"_25639":1568,"_17911":46713,"_5":17806,"_24291":46632,"_2452":46714},[],"**Administration**",{"_2926":1596,"_25639":1568,"_17911":46716,"_5":17806,"_24291":46632,"_2452":46717},[],"Operator permissions, audit and event subscriptions.",{"_2926":1597,"_25639":1568,"_17911":46719,"_5":17806,"_24291":46632,"_2452":43102},[],{"_2926":1598,"_25639":1568,"_17911":46721,"_5":17806,"_24291":46632,"_2452":46722},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_2926":1599,"_25639":1568,"_17911":46724,"_5":17806,"_24291":46636,"_2452":46725},[],"An identity's journey connects four responsibilities:",{"_2926":1600,"_25639":1568,"_17911":46727,"_5":17806,"_24291":46636,"_2452":46728},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_2926":1601,"_25639":1568,"_17911":46730,"_5":17806,"_24291":46636,"_2452":46731},[],"The provisioning administrator configures the DMS and initial trust.",{"_2926":1602,"_25639":1568,"_17911":46733,"_5":17806,"_24291":46636,"_2452":46734},[],"The device client requests a certificate and installs it with the matching key.",{"_2926":1603,"_25639":1568,"_17911":46736,"_5":17806,"_24291":46636,"_2452":46737},[],"The consumer validates the identity and applies its access permissions.",{"_2926":1604,"_25639":1568,"_17911":46739,"_5":17806,"_24291":46636,"_2452":46740},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_2926":1605,"_25639":1568,"_17911":46742,"_5":17806,"_24291":46644,"_2452":46743},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_2926":1606,"_25639":1568,"_17911":46745,"_5":17806,"_24291":46648,"_2452":46746},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_2926":1607,"_25639":1568,"_17911":46748,"_5":17806,"_24291":46652,"_2452":46749},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_2926":1608,"_25639":1568,"_17911":46751,"_5":17806,"_24291":46656,"_2452":46752},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_2926":1609,"_25639":1568,"_17911":46754,"_5":17806,"_24291":46660,"_2452":46755},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_2926":1610,"_25639":1568,"_17911":46757,"_5":17806,"_24291":46664,"_2452":46758},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_2926":1611,"_25639":1568,"_17911":46760,"_5":17806,"_24291":46668,"_2452":46201},[],{"_2926":1612,"_25639":1568,"_17911":46762,"_5":17806,"_24291":46668,"_2452":46763},[],"What it prepares or checks",{"_2926":1613,"_25639":1568,"_17911":46765,"_5":17806,"_24291":46668,"_2452":46204},[],{"_2926":1614,"_25639":1568,"_17911":46767,"_5":17806,"_24291":46668,"_2452":46768},[],"Key custody, CA hierarchy, profiles and validation.",{"_2926":1615,"_25639":1568,"_17911":46770,"_5":17806,"_24291":46668,"_2452":46771},[],"Fleet administrator",{"_2926":1616,"_25639":1568,"_17911":46773,"_5":17806,"_24291":46668,"_2452":46774},[],"DMS, device admission, renewal policy and inventory.",{"_2926":1617,"_25639":1568,"_17911":46776,"_5":17806,"_24291":46668,"_2452":46216},[],{"_2926":1618,"_25639":1568,"_17911":46778,"_5":17806,"_24291":46668,"_2452":46779},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_2926":1619,"_25639":1568,"_17911":46781,"_5":17806,"_24291":46668,"_2452":46222},[],{"_2926":1620,"_25639":1568,"_17911":46783,"_5":17806,"_24291":46668,"_2452":46784},[],"Issuer trust, certificate validation and permissions in the destination.",{"_2926":1621,"_25639":1568,"_17911":46786,"_5":17806,"_24291":46668,"_2452":46787},[],"Infrastructure operator",{"_2926":1622,"_25639":1568,"_17911":46789,"_5":17806,"_24291":46668,"_2452":46790},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_2926":1623,"_25639":1568,"_17911":46792,"_5":17806,"_24291":46668,"_2452":46793},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_2926":1624,"_25639":1624,"_5":12558,"_2452":46795,"_25983":46796,"_17911":46799,"_24291":1624},"CA hierarchy and rotation",[41760,43104,46797,46798],"PKI","Keys, authorities and certificates",[],{"_2926":1625,"_25639":1624,"_17911":46801,"_5":17806,"_24291":1624,"_2452":46802},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_2926":1626,"_25639":1624,"_5":25980,"_17911":46804,"_24291":46805,"_2452":46806},[],"/docs/pr-preview/pr-48/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_2926":1627,"_25639":1624,"_5":25980,"_17911":46808,"_24291":46809,"_2452":46810},[],"/docs/pr-preview/pr-48/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_2926":1628,"_25639":1624,"_5":25980,"_17911":46812,"_24291":46813,"_2452":46814},[],"/docs/pr-preview/pr-48/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_2926":1629,"_25639":1624,"_5":25980,"_17911":46816,"_24291":46817,"_2452":46818},[],"/docs/pr-preview/pr-48/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_2926":1630,"_25639":1624,"_5":25980,"_17911":46820,"_24291":46821,"_2452":46822},[],"/docs/pr-preview/pr-48/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_2926":1631,"_25639":1624,"_5":25980,"_17911":46824,"_24291":46825,"_2452":46826},[],"/docs/pr-preview/pr-48/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_2926":1632,"_25639":1624,"_5":25980,"_17911":46828,"_24291":46829,"_2452":46830},[],"/docs/pr-preview/pr-48/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_2926":1633,"_25639":1624,"_5":25980,"_17911":46832,"_24291":46833,"_2452":46834},[],"/docs/pr-preview/pr-48/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_2926":1634,"_25639":1624,"_5":25980,"_17911":46836,"_24291":46837,"_2452":46838},[],"/docs/pr-preview/pr-48/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_2926":1635,"_25639":1624,"_5":25980,"_17911":46840,"_24291":46841,"_2452":46842},[],"/docs/pr-preview/pr-48/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_2926":1636,"_25639":1624,"_5":25980,"_17911":46844,"_24291":46845,"_2452":46846},[],"/docs/pr-preview/pr-48/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_2926":1637,"_25639":1624,"_5":25980,"_17911":46848,"_24291":46849,"_2452":46850},[],"/docs/pr-preview/pr-48/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_2926":1638,"_25639":1624,"_17911":46852,"_5":17806,"_24291":1624,"_2452":46853},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_2926":1639,"_25639":1624,"_17911":46855,"_5":17806,"_24291":1624,"_2452":46856},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_2926":1640,"_25639":1624,"_17911":46858,"_5":17806,"_24291":46805,"_2452":46859},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_2926":1641,"_25639":1624,"_17911":46861,"_5":17806,"_24291":46805,"_2452":46862},[],"environment, such as production and preproduction;",{"_2926":1642,"_25639":1624,"_17911":46864,"_5":17806,"_24291":46805,"_2452":46865},[],"owner or operating team;",{"_2926":1643,"_25639":1624,"_17911":46867,"_5":17806,"_24291":46805,"_2452":46868},[],"device family or manufacturing process;",{"_2926":1644,"_25639":1624,"_17911":46870,"_5":17806,"_24291":46805,"_2452":46871},[],"region or regulatory requirement;",{"_2926":1645,"_25639":1624,"_17911":46873,"_5":17806,"_24291":46805,"_2452":46874},[],"cryptographic engine or key policy;",{"_2926":1646,"_25639":1624,"_17911":46876,"_5":17806,"_24291":46805,"_2452":46877},[],"maintenance window and renewal cadence.",{"_2926":1647,"_25639":1624,"_17911":46879,"_5":17806,"_24291":46805,"_2452":46880},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_2926":1648,"_25639":1624,"_17911":46882,"_5":17806,"_24291":46805,"_2452":46883},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_2926":1649,"_25639":1624,"_17911":46885,"_5":17806,"_24291":46809,"_2452":46886},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_2926":1650,"_25639":1624,"_17911":46888,"_5":17806,"_24291":46809,"_2452":46889},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_2926":1651,"_25639":1624,"_17911":46891,"_5":17806,"_24291":46809,"_2452":46892},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_2926":1652,"_25639":1624,"_17911":46894,"_5":17806,"_24291":46813,"_2452":46895},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_2926":1653,"_25639":1624,"_17911":46897,"_5":17806,"_24291":46813,"_2452":46898},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_2926":1654,"_25639":1624,"_17911":46900,"_5":17806,"_24291":46813,"_2452":46901},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_2926":1655,"_25639":1624,"_17911":46903,"_5":17806,"_24291":46813,"_2452":46904},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_2926":1656,"_25639":1624,"_17911":46906,"_5":17806,"_24291":46821,"_2452":46907},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_2926":1657,"_25639":1624,"_17911":46909,"_5":17806,"_24291":46825,"_2452":46910},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_2926":1658,"_25639":1624,"_17911":46912,"_5":17806,"_24291":46829,"_2452":46913},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_2926":1659,"_25639":1624,"_17911":46915,"_5":17806,"_24291":46833,"_2452":46916},[],"Update the enrollment CA and profile of the DMSs, and add the old CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) while old-CA cohorts still renew. The DMS guide documents the setting.",{"_2926":1660,"_25639":1624,"_17911":46918,"_5":17806,"_24291":46837,"_2452":46919},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_2926":1661,"_25639":1624,"_17911":46921,"_5":17806,"_24291":46841,"_2452":46922},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance and from the distributed CAs. Revoke it if policy requires it.",{"_2926":1662,"_25639":1624,"_17911":46924,"_5":17806,"_24291":46845,"_2452":46925},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_2926":1663,"_25639":1624,"_17911":46927,"_5":17806,"_24291":46845,"_2452":46928},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_2926":1664,"_25639":1624,"_17911":46930,"_5":17806,"_24291":46845,"_2452":46931},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_2926":1665,"_25639":1624,"_17911":46933,"_5":17806,"_24291":46845,"_2452":46934},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_2926":1666,"_25639":1624,"_17911":46936,"_5":17806,"_24291":46849,"_2452":46937},[],"The new chain ends in an anchor installed by the consumer.",{"_2926":1667,"_25639":1624,"_17911":46939,"_5":17806,"_24291":46849,"_2452":46940},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_2926":1668,"_25639":1624,"_17911":46942,"_5":17806,"_24291":46849,"_2452":46943},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_2926":1669,"_25639":1624,"_17911":46945,"_5":17806,"_24291":46849,"_2452":46946},[],"Re-enrollment accepts the old identity during the planned period.",{"_2926":1670,"_25639":1624,"_17911":46948,"_5":17806,"_24291":46849,"_2452":46949},[],"OCSP and CRL respond for the authorities that remain active.",{"_2926":1671,"_25639":1624,"_17911":46951,"_5":17806,"_24291":46849,"_2452":46952},[],"No DMS is left accidentally issuing from the old CA.",{"_2926":1672,"_25639":1624,"_17911":46954,"_5":17806,"_24291":46849,"_2452":46955},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_2926":1673,"_25639":1673,"_5":12558,"_2452":46957,"_25983":46958,"_17911":46959,"_24291":1673},"Certification authorities",[41760,43104,46797,46798],[],{"_2926":1674,"_25639":1673,"_17911":46961,"_5":17806,"_24291":1673,"_2452":46962},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_2926":1675,"_25639":1673,"_5":25980,"_17911":46964,"_24291":46965,"_2452":46966},[],"/docs/pr-preview/pr-48/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_2926":1676,"_25639":1673,"_5":25980,"_17911":46968,"_24291":46969,"_2452":46970},[],"/docs/pr-preview/pr-48/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_2926":1677,"_25639":1673,"_5":25980,"_17911":46972,"_24291":46973,"_2452":41770},[],"/docs/pr-preview/pr-48/platform/pki/certificate-authorities#before-you-begin",{"_2926":1678,"_25639":1673,"_5":25980,"_17911":46975,"_24291":46976,"_2452":46977},[],"/docs/pr-preview/pr-48/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_2926":1679,"_25639":1673,"_5":25980,"_17911":46979,"_24291":46980,"_2452":46981},[],"/docs/pr-preview/pr-48/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_2926":1680,"_25639":1673,"_5":25980,"_17911":46983,"_24291":46984,"_2452":46985},[],"/docs/pr-preview/pr-48/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_2926":1681,"_25639":1673,"_5":25980,"_17911":46987,"_24291":46988,"_2452":46989},[],"/docs/pr-preview/pr-48/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_2926":1682,"_25639":1673,"_5":25980,"_17911":46991,"_24291":46992,"_2452":46993},[],"/docs/pr-preview/pr-48/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_2926":1683,"_25639":1673,"_5":25980,"_17911":46995,"_24291":46996,"_2452":46997},[],"/docs/pr-preview/pr-48/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_2926":1684,"_25639":1673,"_5":25980,"_17911":46999,"_24291":47000,"_2452":47001},[],"/docs/pr-preview/pr-48/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_2926":1685,"_25639":1673,"_5":25980,"_17911":47003,"_24291":47004,"_2452":47005},[],"/docs/pr-preview/pr-48/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_2926":1686,"_25639":1673,"_5":25980,"_17911":47007,"_24291":47008,"_2452":47009},[],"/docs/pr-preview/pr-48/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_2926":1687,"_25639":1673,"_5":25980,"_17911":47011,"_24291":47012,"_2452":47013},[],"/docs/pr-preview/pr-48/platform/pki/certificate-authorities#load-the-material","Load the material",{"_2926":1688,"_25639":1673,"_5":25980,"_17911":47015,"_24291":47016,"_2452":47017},[],"/docs/pr-preview/pr-48/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_2926":1689,"_25639":1673,"_5":25980,"_17911":47019,"_24291":47020,"_2452":47021},[],"/docs/pr-preview/pr-48/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_2926":1690,"_25639":1673,"_5":25980,"_17911":47023,"_24291":47024,"_2452":47025},[],"/docs/pr-preview/pr-48/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_2926":1691,"_25639":1673,"_5":25980,"_17911":47027,"_24291":47028,"_2452":47029},[],"/docs/pr-preview/pr-48/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_2926":1692,"_25639":1673,"_5":25980,"_17911":47031,"_24291":47032,"_2452":47033},[],"/docs/pr-preview/pr-48/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_2926":1693,"_25639":1673,"_5":25980,"_17911":47035,"_24291":47036,"_2452":47037},[],"/docs/pr-preview/pr-48/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_2926":1694,"_25639":1673,"_5":25980,"_17911":47039,"_24291":47040,"_2452":47041},[],"/docs/pr-preview/pr-48/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_2926":1695,"_25639":1673,"_5":25980,"_17911":47043,"_24291":47044,"_2452":47045},[],"/docs/pr-preview/pr-48/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_2926":1696,"_25639":1673,"_5":25980,"_17911":47047,"_24291":47048,"_2452":47049},[],"/docs/pr-preview/pr-48/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_2926":1697,"_25639":1673,"_17911":47051,"_5":17806,"_24291":1673,"_2452":47052},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_2926":1698,"_25639":1673,"_17911":47054,"_5":17806,"_24291":1673,"_2452":47055},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_2926":1699,"_25639":1673,"_17911":47057,"_5":17806,"_24291":1673,"_2452":47058},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_2926":1700,"_25639":1673,"_17911":47060,"_5":17806,"_24291":46965,"_2452":47061},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_2926":1701,"_25639":1673,"_17911":47063,"_5":17806,"_24291":46965,"_2452":47064},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_2926":1702,"_25639":1673,"_17911":47066,"_5":17806,"_24291":46965,"_2452":47067},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_2926":1703,"_25639":1673,"_17911":47069,"_5":17806,"_24291":46965,"_2452":47070},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_2926":1704,"_25639":1673,"_17911":47072,"_5":17806,"_24291":46965,"_2452":47073},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_2926":1705,"_25639":1673,"_17911":47075,"_5":17806,"_24291":46973,"_2452":47076},[],"Decide whether the CA will be a root or an intermediate.",{"_2926":1706,"_25639":1673,"_17911":47078,"_5":17806,"_24291":46973,"_2452":47079},[],"Choose the engine that will keep the key.",{"_2926":1707,"_25639":1673,"_17911":47081,"_5":17806,"_24291":46973,"_2452":47082},[],"Define a validity longer than that of the certificates it will issue.",{"_2926":1708,"_25639":1673,"_17911":47084,"_5":17806,"_24291":46973,"_2452":47085},[],"For an intermediate CA, make sure the parent CA is active.",{"_2926":1709,"_25639":1673,"_17911":47087,"_5":17806,"_24291":46976,"_2452":47088},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_2926":1710,"_25639":1673,"_17911":47090,"_5":17806,"_24291":46980,"_2452":47091},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_2926":1711,"_25639":1673,"_17911":47093,"_5":17806,"_24291":46980,"_2452":47094},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_2926":1712,"_25639":1673,"_17911":47096,"_5":17806,"_24291":46984,"_2452":47097},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_2926":1713,"_25639":1673,"_17911":47099,"_5":17806,"_24291":46988,"_2452":47100},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_2926":1714,"_25639":1673,"_17911":47102,"_5":17806,"_24291":46988,"_2452":47103},[],"`C`: two-letter ISO 3166-1 country code.",{"_2926":1715,"_25639":1673,"_17911":47105,"_5":17806,"_24291":46988,"_2452":47106},[],"`ST`: state or province.",{"_2926":1716,"_25639":1673,"_17911":47108,"_5":17806,"_24291":46988,"_2452":47109},[],"`L`: locality.",{"_2926":1717,"_25639":1673,"_17911":47111,"_5":17806,"_24291":46988,"_2452":47112},[],"`O`: organization.",{"_2926":1718,"_25639":1673,"_17911":47114,"_5":17806,"_24291":46988,"_2452":47115},[],"`OU`: organizational unit.",{"_2926":1719,"_25639":1673,"_17911":47117,"_5":17806,"_24291":46988,"_2452":47118},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_2926":1720,"_25639":1673,"_17911":47120,"_5":17806,"_24291":46992,"_2452":47121},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_2926":1721,"_25639":1673,"_17911":47123,"_5":17806,"_24291":46992,"_2452":47124},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_2926":1722,"_25639":1673,"_17911":47126,"_5":17806,"_24291":46996,"_2452":47127},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_2926":1723,"_25639":1673,"_17911":47129,"_5":17806,"_24291":46996,"_2452":47130},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_2926":1724,"_25639":1673,"_17911":47132,"_5":17806,"_24291":47000,"_2452":47133},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_2926":1725,"_25639":1673,"_17911":47135,"_5":17806,"_24291":47000,"_2452":47136},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_2926":1726,"_25639":1673,"_17911":47138,"_5":17806,"_24291":47004,"_2452":47139},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_2926":1727,"_25639":1673,"_17911":47141,"_5":17806,"_24291":47008,"_2452":47142},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_2926":1728,"_25639":1673,"_17911":47144,"_5":17806,"_24291":47012,"_2452":47145},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_2926":1729,"_25639":1673,"_17911":47147,"_5":17806,"_24291":47016,"_2452":47148},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_2926":1730,"_25639":1673,"_17911":47150,"_5":17806,"_24291":47020,"_2452":47151},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_2926":1731,"_25639":1673,"_17911":47153,"_5":17806,"_24291":47020,"_2452":47154},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_2926":1732,"_25639":1673,"_17911":47156,"_5":17806,"_24291":47024,"_2452":47157},[],"Open a CA from the inventory to review:",{"_2926":1733,"_25639":1673,"_17911":47159,"_5":17806,"_24291":47024,"_2452":47160},[],"Status and validity period.",{"_2926":1734,"_25639":1673,"_17911":47162,"_5":17806,"_24291":47024,"_2452":47163},[],"Certificate and chain in PEM format.",{"_2926":1735,"_25639":1673,"_17911":47165,"_5":17806,"_24291":47024,"_2452":47166},[],"Number of active, expired and revoked certificates.",{"_2926":1736,"_25639":1673,"_17911":47168,"_5":17806,"_24291":47024,"_2452":47169},[],"Certificates issued in **Issued Certificates**.",{"_2926":1737,"_25639":1673,"_17911":47171,"_5":17806,"_24291":47024,"_2452":47172},[],"The CRL linked to the authority.",{"_2926":1738,"_25639":1673,"_17911":47174,"_5":17806,"_24291":47024,"_2452":47175},[],"Metadata and the associated cryptographic engine.",{"_2926":1739,"_25639":1673,"_17911":47177,"_5":17806,"_24291":47024,"_2452":47178},[],"You can filter the inventory by name, status and CA type.",{"_2926":1740,"_25639":1673,"_17911":47180,"_5":17806,"_24291":47028,"_2452":47181},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_2926":1741,"_25639":1673,"_17911":47183,"_5":17806,"_24291":47028,"_2452":47184},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_2926":1742,"_25639":1673,"_17911":47186,"_5":17806,"_24291":47028,"_2452":47187},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_2926":1743,"_25639":1673,"_17911":47189,"_5":17806,"_24291":47028,"_2452":47190},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_2926":1744,"_25639":1673,"_17911":47192,"_5":17806,"_24291":47032,"_2452":47193},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_2926":1745,"_25639":1673,"_17911":47195,"_5":17806,"_24291":47036,"_2452":47196},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_2926":1746,"_25639":1673,"_17911":47198,"_5":17806,"_24291":47040,"_2452":47199},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_2926":1747,"_25639":1673,"_17911":47201,"_5":17806,"_24291":47044,"_2452":47202},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_2926":1748,"_25639":1673,"_17911":47204,"_5":17806,"_24291":47048,"_2452":47205},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_2926":1749,"_25639":1673,"_17911":47207,"_5":17806,"_24291":47048,"_2452":47208},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_2926":1750,"_25639":1750,"_5":12558,"_2452":47210,"_25983":47211,"_17911":47212,"_24291":1750},"Certificate profiles",[41760,43104,46797,46798],[],{"_2926":1751,"_25639":1750,"_17911":47214,"_5":17806,"_24291":1750,"_2452":47215},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_2926":1752,"_25639":1750,"_5":25980,"_17911":47217,"_24291":47218,"_2452":47219},[],"/docs/pr-preview/pr-48/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_2926":1753,"_25639":1750,"_5":25980,"_17911":47221,"_24291":47222,"_2452":47223},[],"/docs/pr-preview/pr-48/platform/pki/certificate-profiles#validity","Validity",{"_2926":1754,"_25639":1750,"_5":25980,"_17911":47225,"_24291":47226,"_2452":47227},[],"/docs/pr-preview/pr-48/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_2926":1755,"_25639":1750,"_5":25980,"_17911":47229,"_24291":47230,"_2452":47231},[],"/docs/pr-preview/pr-48/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_2926":1756,"_25639":1750,"_5":25980,"_17911":47233,"_24291":47234,"_2452":47235},[],"/docs/pr-preview/pr-48/platform/pki/certificate-profiles#subject","Subject",{"_2926":1757,"_25639":1750,"_5":25980,"_17911":47237,"_24291":47238,"_2452":47239},[],"/docs/pr-preview/pr-48/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_2926":1758,"_25639":1750,"_5":25980,"_17911":47241,"_24291":47242,"_2452":47243},[],"/docs/pr-preview/pr-48/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_2926":1759,"_25639":1750,"_5":25980,"_17911":47245,"_24291":47246,"_2452":47247},[],"/docs/pr-preview/pr-48/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_2926":1760,"_25639":1750,"_5":25980,"_17911":47249,"_24291":47250,"_2452":47251},[],"/docs/pr-preview/pr-48/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_2926":1761,"_25639":1750,"_5":25980,"_17911":47253,"_24291":47254,"_2452":47255},[],"/docs/pr-preview/pr-48/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_2926":1762,"_25639":1750,"_5":25980,"_17911":47257,"_24291":47258,"_2452":47259},[],"/docs/pr-preview/pr-48/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_2926":1763,"_25639":1750,"_5":25980,"_17911":47261,"_24291":47262,"_2452":47263},[],"/docs/pr-preview/pr-48/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_2926":1764,"_25639":1750,"_5":25980,"_17911":47265,"_24291":47266,"_2452":47267},[],"/docs/pr-preview/pr-48/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_2926":1765,"_25639":1750,"_5":25980,"_17911":47269,"_24291":47270,"_2452":47271},[],"/docs/pr-preview/pr-48/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_2926":1766,"_25639":1750,"_5":25980,"_17911":47273,"_24291":47274,"_2452":47275},[],"/docs/pr-preview/pr-48/platform/pki/certificate-profiles#design-examples","Design examples",{"_2926":1767,"_25639":1750,"_5":25980,"_17911":47277,"_24291":47278,"_2452":47279},[],"/docs/pr-preview/pr-48/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_2926":1768,"_25639":1750,"_17911":47281,"_5":17806,"_24291":1750,"_2452":47282},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_2926":1769,"_25639":1750,"_17911":47284,"_5":17806,"_24291":1750,"_2452":47285},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_2926":1770,"_25639":1750,"_17911":47287,"_5":17806,"_24291":47222,"_2452":47288},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_2926":1771,"_25639":1750,"_17911":47290,"_5":17806,"_24291":47222,"_2452":47291},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_2926":1772,"_25639":1750,"_17911":47293,"_5":17806,"_24291":47226,"_2452":47294},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_2926":1773,"_25639":1750,"_17911":47296,"_5":17806,"_24291":47230,"_2452":47297},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_2926":1774,"_25639":1750,"_17911":47299,"_5":17806,"_24291":47230,"_2452":47300},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_2926":1775,"_25639":1750,"_17911":47302,"_5":17806,"_24291":47230,"_2452":47303},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_2926":1776,"_25639":1750,"_17911":47305,"_5":17806,"_24291":47234,"_2452":47306},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_2926":1777,"_25639":1750,"_17911":47308,"_5":17806,"_24291":47238,"_2452":47309},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_2926":1778,"_25639":1750,"_17911":47311,"_5":17806,"_24291":47238,"_2452":47312},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_2926":1779,"_25639":1750,"_17911":47314,"_5":17806,"_24291":47242,"_2452":47315},[],"The cryptographic enforcement can:",{"_2926":1780,"_25639":1750,"_17911":47317,"_5":17806,"_24291":47242,"_2452":47318},[],"allow or block RSA keys;",{"_2926":1781,"_25639":1750,"_17911":47320,"_5":17806,"_24291":47242,"_2452":47321},[],"limit the supported RSA sizes;",{"_2926":1782,"_25639":1750,"_17911":47323,"_5":17806,"_24291":47242,"_2452":47324},[],"allow or block ECDSA keys;",{"_2926":1783,"_25639":1750,"_17911":47326,"_5":17806,"_24291":47242,"_2452":47327},[],"limit the supported ECDSA sizes or curves.",{"_2926":1784,"_25639":1750,"_17911":47329,"_5":17806,"_24291":47242,"_2452":47330},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_2926":1785,"_25639":1750,"_17911":47332,"_5":17806,"_24291":47246,"_2452":47333},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_2926":1786,"_25639":1750,"_17911":47335,"_5":17806,"_24291":47246,"_2452":44825},[],{"_2926":1787,"_25639":1750,"_17911":47337,"_5":17806,"_24291":47246,"_2452":47338},[],"First choice",{"_2926":1788,"_25639":1750,"_17911":47340,"_5":17806,"_24291":47246,"_2452":47341},[],"Second choice",{"_2926":1789,"_25639":1750,"_17911":47343,"_5":17806,"_24291":47246,"_2452":47344},[],"If neither is supplied",{"_2926":1790,"_25639":1750,"_17911":47346,"_5":17806,"_24291":47246,"_2452":47347},[],"Direct signing with a CA",{"_2926":1791,"_25639":1750,"_17911":47349,"_5":17806,"_24291":47246,"_2452":47350},[],"`issuance_profile` embedded in the request",{"_2926":1792,"_25639":1750,"_17911":47352,"_5":17806,"_24291":47246,"_2452":47353},[],"Request `issuance_profile_id`",{"_2926":1793,"_25639":1750,"_17911":47355,"_5":17806,"_24291":47246,"_2452":47356},[],"CA default profile (`profile_id`).",{"_2926":1794,"_25639":1750,"_17911":47358,"_5":17806,"_24291":47246,"_2452":47359},[],"Issuance through a DMS",{"_2926":1795,"_25639":1750,"_17911":47361,"_5":17806,"_24291":47246,"_2452":47362},[],"`settings.issuance_profile_id`",{"_2926":1796,"_25639":1750,"_17911":47364,"_5":17806,"_24291":47246,"_2452":47365},[],"`settings.issuance_profile` embedded in the DMS",{"_2926":1797,"_25639":1750,"_17911":47367,"_5":17806,"_24291":47246,"_2452":47368},[],"Enrollment CA default profile.",{"_2926":1798,"_25639":1750,"_17911":47370,"_5":17806,"_24291":47246,"_2452":47371},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_2926":1799,"_25639":1750,"_17911":47373,"_5":17806,"_24291":47246,"_2452":47374},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_2926":1800,"_25639":1750,"_17911":47376,"_5":17806,"_24291":47254,"_2452":47377},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_2926":1801,"_25639":1750,"_17911":47379,"_5":17806,"_24291":47258,"_2452":47380},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_2926":1802,"_25639":1750,"_17911":47382,"_5":17806,"_24291":47262,"_2452":47383},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_2926":1803,"_25639":1750,"_17911":47385,"_5":17806,"_24291":47266,"_2452":47386},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_2926":1804,"_25639":1750,"_17911":47388,"_5":17806,"_24291":47270,"_2452":47389},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_2926":1805,"_25639":1750,"_17911":47391,"_5":17806,"_24291":47270,"_2452":47392},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_2926":1806,"_25639":1750,"_17911":47394,"_5":17806,"_24291":47274,"_2452":47395},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_2926":1807,"_25639":1750,"_17911":47397,"_5":17806,"_24291":47274,"_2452":47398},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_2926":1808,"_25639":1750,"_17911":47400,"_5":17806,"_24291":47274,"_2452":47401},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_2926":1809,"_25639":1750,"_17911":47403,"_5":17806,"_24291":47274,"_2452":47404},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_2926":1810,"_25639":1750,"_17911":47406,"_5":17806,"_24291":47278,"_2452":47407},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_2926":1811,"_25639":1750,"_17911":47409,"_5":17806,"_24291":47278,"_2452":47410},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_2926":1812,"_25639":1812,"_5":12558,"_2452":47412,"_25983":47413,"_17911":47415,"_24291":1812},"Certificate validation",[41760,43104,46797,47414],"Validation",[],{"_2926":1813,"_25639":1812,"_17911":47417,"_5":17806,"_24291":1812,"_2452":47418},[],"Check chain, identity, purpose and revocation from the consumer.",{"_2926":1814,"_25639":1812,"_5":25980,"_17911":47420,"_24291":47421,"_2452":47422},[],"/docs/pr-preview/pr-48/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_2926":1815,"_25639":1812,"_5":25980,"_17911":47424,"_24291":47425,"_2452":47426},[],"/docs/pr-preview/pr-48/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_2926":1816,"_25639":1812,"_5":25980,"_17911":47428,"_24291":47429,"_2452":47430},[],"/docs/pr-preview/pr-48/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_2926":1817,"_25639":1812,"_17911":47432,"_5":17806,"_24291":1812,"_2452":47433},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_2926":1818,"_25639":1812,"_17911":47435,"_5":17806,"_24291":47421,"_2452":47436},[],"Verify these criteria together:",{"_2926":1819,"_25639":1812,"_17911":47438,"_5":17806,"_24291":47421,"_2452":46421},[],{"_2926":1820,"_25639":1812,"_17911":47440,"_5":17806,"_24291":47421,"_2452":47441},[],"Required result",{"_2926":1821,"_25639":1812,"_17911":47443,"_5":17806,"_24291":47421,"_2452":47444},[],"Chain and signature",{"_2926":1822,"_25639":1812,"_17911":47446,"_5":17806,"_24291":47421,"_2452":47447},[],"Valid chain to a root deliberately installed in the consumer.",{"_2926":1823,"_25639":1812,"_17911":47449,"_5":17806,"_24291":47421,"_2452":47450},[],"Dates",{"_2926":1824,"_25639":1812,"_17911":47452,"_5":17806,"_24291":47421,"_2452":47453},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_2926":1825,"_25639":1812,"_17911":47455,"_5":17806,"_24291":47421,"_2452":42807},[],{"_2926":1826,"_25639":1812,"_17911":47457,"_5":17806,"_24291":47421,"_2452":47458},[],"Name, SAN or identifier matches the expected peer.",{"_2926":1827,"_25639":1812,"_17911":47460,"_5":17806,"_24291":47421,"_2452":42143},[],{"_2926":1828,"_25639":1812,"_17911":47462,"_5":17806,"_24291":47421,"_2452":47463},[],"KU, EKU and constraints permit the specific operation.",{"_2926":1829,"_25639":1812,"_17911":47465,"_5":17806,"_24291":47421,"_2452":47466},[],"Revocation",{"_2926":1830,"_25639":1812,"_17911":47468,"_5":17806,"_24291":47421,"_2452":47469},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_2926":1831,"_25639":1812,"_17911":47471,"_5":17806,"_24291":47421,"_2452":47472},[],"Authorization",{"_2926":1832,"_25639":1812,"_17911":47474,"_5":17806,"_24291":47421,"_2452":47475},[],"The application permits that identity to perform the action.",{"_2926":1833,"_25639":1812,"_17911":47477,"_5":17806,"_24291":47421,"_2452":47478},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_2926":1834,"_25639":1812,"_17911":47480,"_5":17806,"_24291":47425,"_2452":47481},[],"Mechanism",{"_2926":1835,"_25639":1812,"_17911":47483,"_5":17806,"_24291":47425,"_2452":47484},[],"When to use it",{"_2926":1836,"_25639":1812,"_17911":47486,"_5":17806,"_24291":47425,"_2452":47487},[],"What you must maintain",{"_2926":1837,"_25639":1812,"_17911":47489,"_5":17806,"_24291":47425,"_2452":47490},[],"OCSP",{"_2926":1838,"_25639":1812,"_17911":47492,"_5":17806,"_24291":47425,"_2452":47493},[],"Status query for a specific certificate.",{"_2926":1839,"_25639":1812,"_17911":47495,"_5":17806,"_24291":47425,"_2452":47496},[],"Responder access, signature verification and cache/freshness policy.",{"_2926":1840,"_25639":1812,"_17911":47498,"_5":17806,"_24291":47425,"_2452":47499},[],"CRL",{"_2926":1841,"_25639":1812,"_17911":47501,"_5":17806,"_24291":47425,"_2452":47502},[],"Local checks for many certificates or offline operation.",{"_2926":1842,"_25639":1812,"_17911":47504,"_5":17806,"_24291":47425,"_2452":47505},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_2926":1843,"_25639":1812,"_17911":47507,"_5":17806,"_24291":47425,"_2452":47508},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_2926":1844,"_25639":1812,"_17911":47510,"_5":17806,"_24291":47425,"_2452":47511},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_2926":1845,"_25639":1812,"_17911":47513,"_5":17806,"_24291":47429,"_2452":47514},[],"Accept a current, authorized certificate with a known chain.",{"_2926":1846,"_25639":1812,"_17911":47516,"_5":17806,"_24291":47429,"_2452":47517},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_2926":1847,"_25639":1812,"_17911":47519,"_5":17806,"_24291":47429,"_2452":47520},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_2926":1848,"_25639":1812,"_17911":47522,"_5":17806,"_24291":47429,"_2452":47523},[],"Check that a new connection with that identity is rejected.",{"_2926":1849,"_25639":1812,"_17911":47525,"_5":17806,"_24291":47429,"_2452":47526},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_2926":1850,"_25639":1812,"_17911":47528,"_5":17806,"_24291":47429,"_2452":47529},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_2926":1851,"_25639":1812,"_17911":47531,"_5":17806,"_24291":47429,"_2452":47532},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_2926":1852,"_25639":1812,"_17911":47534,"_5":17806,"_24291":47429,"_2452":47535},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_2926":1853,"_25639":1812,"_17911":47537,"_5":17806,"_24291":47429,"_2452":47538},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_2926":1854,"_25639":1854,"_5":12558,"_2452":47540,"_25983":47541,"_17911":47542,"_24291":1854},"Certificates",[41760,43104,46797,46798],[],{"_2926":1855,"_25639":1854,"_17911":47544,"_5":17806,"_24291":1854,"_2452":47545},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_2926":1856,"_25639":1854,"_5":25980,"_17911":47547,"_24291":47548,"_2452":47549},[],"/docs/pr-preview/pr-48/platform/pki/certificates#find-a-certificate","Find a certificate",{"_2926":1857,"_25639":1854,"_5":25980,"_17911":47551,"_24291":47552,"_2452":47553},[],"/docs/pr-preview/pr-48/platform/pki/certificates#download-the-certificate","Download the certificate",{"_2926":1858,"_25639":1854,"_5":25980,"_17911":47555,"_24291":47556,"_2452":47557},[],"/docs/pr-preview/pr-48/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_2926":1859,"_25639":1854,"_5":25980,"_17911":47559,"_24291":47560,"_2452":47561},[],"/docs/pr-preview/pr-48/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_2926":1860,"_25639":1854,"_5":25980,"_17911":47563,"_24291":47564,"_2452":47565},[],"/docs/pr-preview/pr-48/platform/pki/certificates#open-the-action","Open the action",{"_2926":1861,"_25639":1854,"_5":25980,"_17911":47567,"_24291":47568,"_2452":47569},[],"/docs/pr-preview/pr-48/platform/pki/certificates#choose-a-reason","Choose a reason",{"_2926":1862,"_25639":1854,"_5":25980,"_17911":47571,"_24291":47572,"_2452":47573},[],"/docs/pr-preview/pr-48/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_2926":1863,"_25639":1854,"_5":25980,"_17911":47575,"_24291":47576,"_2452":47577},[],"/docs/pr-preview/pr-48/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_2926":1864,"_25639":1854,"_5":25980,"_17911":47579,"_24291":47580,"_2452":47581},[],"/docs/pr-preview/pr-48/platform/pki/certificates#continue","Continue",{"_2926":1865,"_25639":1854,"_17911":47583,"_5":17806,"_24291":1854,"_2452":47584},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_2926":1866,"_25639":1854,"_17911":47586,"_5":17806,"_24291":47548,"_2452":47587},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_2926":1867,"_25639":1854,"_17911":47589,"_5":17806,"_24291":47548,"_2452":47590},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_2926":1868,"_25639":1854,"_17911":47592,"_5":17806,"_24291":47552,"_2452":47593},[],"Download the PEM and inspect it:",{"_2926":1869,"_25639":1854,"_17911":47595,"_5":17806,"_24291":47552,"_2452":47596},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_2926":1870,"_25639":1854,"_17911":47598,"_5":17806,"_24291":47556,"_2452":47599},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_2926":1871,"_25639":1854,"_17911":47601,"_5":17806,"_24291":47556,"_2452":47602},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_2926":1872,"_25639":1854,"_17911":47604,"_5":17806,"_24291":47556,"_2452":47605},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_2926":1873,"_25639":1854,"_17911":47607,"_5":17806,"_24291":47556,"_2452":47608},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_2926":1874,"_25639":1854,"_17911":47610,"_5":17806,"_24291":47556,"_2452":47611},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_2926":1875,"_25639":1854,"_17911":47613,"_5":17806,"_24291":47556,"_2452":47614},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_2926":1876,"_25639":1854,"_17911":47616,"_5":17806,"_24291":47556,"_2452":47617},[],"For browser key generation, follow Issue your first certificate.",{"_2926":1877,"_25639":1854,"_17911":47619,"_5":17806,"_24291":47560,"_2452":47620},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_2926":1878,"_25639":1854,"_17911":47622,"_5":17806,"_24291":47564,"_2452":47623},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_2926":1879,"_25639":1854,"_17911":47625,"_5":17806,"_24291":47568,"_2452":47626},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_2926":1880,"_25639":1854,"_17911":47628,"_5":17806,"_24291":47572,"_2452":47629},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_2926":1881,"_25639":1854,"_17911":47631,"_5":17806,"_24291":47572,"_2452":47632},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_2926":1882,"_25639":1854,"_17911":47634,"_5":17806,"_24291":47572,"_2452":47635},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_2926":1883,"_25639":1854,"_17911":47637,"_5":17806,"_24291":47576,"_2452":47638},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_2926":1884,"_25639":1854,"_17911":47640,"_5":17806,"_24291":47576,"_2452":47641},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_2926":1885,"_25639":1854,"_17911":47643,"_5":17806,"_24291":47576,"_2452":47644},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_2926":1886,"_25639":1854,"_17911":47646,"_5":17806,"_24291":47580,"_2452":47647},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_2926":1887,"_25639":1854,"_17911":47649,"_5":17806,"_24291":47580,"_2452":47650},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_2926":1888,"_25639":1888,"_5":12558,"_2452":47652,"_25983":47653,"_17911":47655,"_24291":1888},"Certificate lifecycle",[41760,43104,46797,47654],"Concepts",[],{"_2926":1889,"_25639":1888,"_17911":47657,"_5":17806,"_24291":1888,"_2452":47658},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_2926":1890,"_25639":1888,"_5":25980,"_17911":47660,"_24291":47661,"_2452":47662},[],"/docs/pr-preview/pr-48/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_2926":1891,"_25639":1888,"_5":25980,"_17911":47664,"_24291":47665,"_2452":47666},[],"/docs/pr-preview/pr-48/platform/pki/concepts/certificate-lifecycle#request","Request",{"_2926":1892,"_25639":1888,"_5":25980,"_17911":47668,"_24291":47669,"_2452":47670},[],"/docs/pr-preview/pr-48/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_2926":1893,"_25639":1888,"_5":25980,"_17911":47672,"_24291":47673,"_2452":47674},[],"/docs/pr-preview/pr-48/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_2926":1894,"_25639":1888,"_5":25980,"_17911":47676,"_24291":47677,"_2452":47678},[],"/docs/pr-preview/pr-48/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_2926":1895,"_25639":1888,"_5":25980,"_17911":47680,"_24291":47681,"_2452":47682},[],"/docs/pr-preview/pr-48/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_2926":1896,"_25639":1888,"_5":25980,"_17911":47684,"_24291":47685,"_2452":47686},[],"/docs/pr-preview/pr-48/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_2926":1897,"_25639":1888,"_5":25980,"_17911":47688,"_24291":47689,"_2452":47690},[],"/docs/pr-preview/pr-48/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_2926":1898,"_25639":1888,"_5":25980,"_17911":47692,"_24291":47693,"_2452":47694},[],"/docs/pr-preview/pr-48/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_2926":1899,"_25639":1888,"_5":25980,"_17911":47696,"_24291":47697,"_2452":47698},[],"/docs/pr-preview/pr-48/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_2926":1900,"_25639":1888,"_17911":47700,"_5":17806,"_24291":1888,"_2452":47701},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_2926":1901,"_25639":1888,"_17911":47703,"_5":17806,"_24291":47665,"_2452":47704},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_2926":1902,"_25639":1888,"_17911":47706,"_5":17806,"_24291":47669,"_2452":47707},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_2926":1903,"_25639":1888,"_17911":47709,"_5":17806,"_24291":47673,"_2452":47710},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_2926":1904,"_25639":1888,"_17911":47712,"_5":17806,"_24291":47677,"_2452":47713},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_2926":1905,"_25639":1888,"_17911":47715,"_5":17806,"_24291":47681,"_2452":47716},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_2926":1906,"_25639":1888,"_17911":47718,"_5":17806,"_24291":47685,"_2452":47719},[],"Lamassu persists four X.509 states:",{"_2926":1907,"_25639":1888,"_17911":47721,"_5":17806,"_24291":47685,"_2452":47722},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_2926":1908,"_25639":1888,"_17911":47724,"_5":17806,"_24291":47685,"_2452":47725},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_2926":1909,"_25639":1888,"_17911":47727,"_5":17806,"_24291":47685,"_2452":47728},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_2926":1910,"_25639":1888,"_17911":47730,"_5":17806,"_24291":47685,"_2452":47731},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_2926":1911,"_25639":1888,"_17911":47733,"_5":17806,"_24291":47685,"_2452":47734},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_2926":1912,"_25639":1888,"_17911":47736,"_5":17806,"_24291":47689,"_2452":47737},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_2926":1913,"_25639":1888,"_17911":47739,"_5":17806,"_24291":47689,"_2452":47740},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_2926":1914,"_25639":1888,"_17911":47742,"_5":17806,"_24291":47689,"_2452":47743},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_2926":1915,"_25639":1888,"_17911":47745,"_5":17806,"_24291":47693,"_2452":47746},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_2926":1916,"_25639":1888,"_17911":47748,"_5":17806,"_24291":47693,"_2452":47749},[],"Before confirming:",{"_2926":1917,"_25639":1888,"_17911":47751,"_5":17806,"_24291":47693,"_2452":47752},[],"Identify DMSs, devices and services that trust that chain.",{"_2926":1918,"_25639":1888,"_17911":47754,"_5":17806,"_24291":47693,"_2452":47755},[],"Distribute the new chain of trust.",{"_2926":1919,"_25639":1888,"_17911":47757,"_5":17806,"_24291":47693,"_2452":47758},[],"Reissue the necessary identities.",{"_2926":1920,"_25639":1888,"_17911":47760,"_5":17806,"_24291":47693,"_2452":47761},[],"Check OCSP and CRL from a real consumer.",{"_2926":1921,"_25639":1888,"_17911":47763,"_5":17806,"_24291":47693,"_2452":47764},[],"Revoke the old CA once no legitimate traffic remains.",{"_2926":1922,"_25639":1888,"_17911":47766,"_5":17806,"_24291":47693,"_2452":47767},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_2926":1923,"_25639":1888,"_17911":47769,"_5":17806,"_24291":47697,"_2452":47770},[],"Certificates entering the preventive or critical renewal window.",{"_2926":1924,"_25639":1888,"_17911":47772,"_5":17806,"_24291":47697,"_2452":47773},[],"Repeated enrollment or re-enrollment failures.",{"_2926":1925,"_25639":1888,"_17911":47775,"_5":17806,"_24291":47697,"_2452":47776},[],"Status changes and revocation reasons.",{"_2926":1926,"_25639":1888,"_17911":47778,"_5":17806,"_24291":47697,"_2452":47779},[],"OCSP and CRL publication and validity.",{"_2926":1927,"_25639":1888,"_17911":47781,"_5":17806,"_24291":47697,"_2452":47782},[],"Dependencies still presenting a replaced certificate.",{"_2926":1928,"_25639":1888,"_17911":47784,"_5":17806,"_24291":47697,"_2452":47785},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_2926":1929,"_25639":1929,"_5":12558,"_2452":47787,"_25983":47788,"_17911":47789,"_24291":1929},"Trust model",[41760,43104,46797,47654],[],{"_2926":1930,"_25639":1929,"_17911":47791,"_5":17806,"_24291":1929,"_2452":47792},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_2926":1931,"_25639":1929,"_5":25980,"_17911":47794,"_24291":47795,"_2452":47796},[],"/docs/pr-preview/pr-48/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_2926":1932,"_25639":1929,"_5":25980,"_17911":47798,"_24291":47799,"_2452":47800},[],"/docs/pr-preview/pr-48/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_2926":1933,"_25639":1929,"_5":25980,"_17911":47802,"_24291":47803,"_2452":47804},[],"/docs/pr-preview/pr-48/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_2926":1934,"_25639":1929,"_5":25980,"_17911":47806,"_24291":47807,"_2452":47808},[],"/docs/pr-preview/pr-48/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_2926":1935,"_25639":1929,"_5":25980,"_17911":47810,"_24291":47811,"_2452":47812},[],"/docs/pr-preview/pr-48/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_2926":1936,"_25639":1929,"_5":25980,"_17911":47814,"_24291":47815,"_2452":47816},[],"/docs/pr-preview/pr-48/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_2926":1937,"_25639":1929,"_5":25980,"_17911":47818,"_24291":47819,"_2452":47820},[],"/docs/pr-preview/pr-48/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_2926":1938,"_25639":1929,"_5":25980,"_17911":47822,"_24291":47823,"_2452":47824},[],"/docs/pr-preview/pr-48/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_2926":1939,"_25639":1929,"_5":25980,"_17911":47826,"_24291":47827,"_2452":47828},[],"/docs/pr-preview/pr-48/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_2926":1940,"_25639":1929,"_5":25980,"_17911":47830,"_24291":47831,"_2452":47832},[],"/docs/pr-preview/pr-48/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_2926":1941,"_25639":1929,"_17911":47834,"_5":17806,"_24291":1929,"_2452":47835},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_2926":1942,"_25639":1929,"_17911":47837,"_5":17806,"_24291":47799,"_2452":47838},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_2926":1943,"_25639":1929,"_17911":47840,"_5":17806,"_24291":47803,"_2452":47841},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_2926":1944,"_25639":1929,"_17911":47843,"_5":17806,"_24291":47807,"_2452":47844},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_2926":1945,"_25639":1929,"_17911":47846,"_5":17806,"_24291":47811,"_2452":47847},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_2926":1946,"_25639":1929,"_17911":47849,"_5":17806,"_24291":47815,"_2452":47850},[],"The device proves it can enroll according to the DMS policy.",{"_2926":1947,"_25639":1929,"_17911":47852,"_5":17806,"_24291":47815,"_2452":47853},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_2926":1948,"_25639":1929,"_17911":47855,"_5":17806,"_24291":47815,"_2452":47856},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_2926":1949,"_25639":1929,"_17911":47858,"_5":17806,"_24291":47815,"_2452":47859},[],"The device installs the certificate and the chain it needs.",{"_2926":1950,"_25639":1929,"_17911":47861,"_5":17806,"_24291":47815,"_2452":47862},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_2926":1951,"_25639":1929,"_17911":47864,"_5":17806,"_24291":47815,"_2452":47865},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_2926":1952,"_25639":1929,"_17911":47867,"_5":17806,"_24291":47819,"_2452":47868},[],"A DMS relates three sets that are worth designing separately:",{"_2926":1953,"_25639":1929,"_17911":47870,"_5":17806,"_24291":47819,"_2452":47871},[],"**Enrollment CA:** signs the new identities.",{"_2926":1954,"_25639":1929,"_17911":47873,"_5":17806,"_24291":47819,"_2452":47874},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, Lamassu tries the enrollment CA first and then the validation CAs configured in the re-enrollment block.",{"_2926":1955,"_25639":1929,"_17911":47876,"_5":17806,"_24291":47819,"_2452":47877},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_2926":1956,"_25639":1929,"_17911":47879,"_5":17806,"_24291":47819,"_2452":47880},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_2926":1957,"_25639":1929,"_17911":47882,"_5":17806,"_24291":47823,"_2452":47883},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_2926":1958,"_25639":1929,"_17911":47885,"_5":17806,"_24291":47823,"_2452":47886},[],"that the current date is between `Not Before` and `Not After`;",{"_2926":1959,"_25639":1929,"_17911":47888,"_5":17806,"_24291":47823,"_2452":47889},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_2926":1960,"_25639":1929,"_17911":47891,"_5":17806,"_24291":47823,"_2452":47892},[],"that names, SANs and subject match the expected identity;",{"_2926":1961,"_25639":1929,"_17911":47894,"_5":17806,"_24291":47823,"_2452":47895},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_2926":1962,"_25639":1929,"_17911":47897,"_5":17806,"_24291":47823,"_2452":47898},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_2926":1963,"_25639":1929,"_17911":47900,"_5":17806,"_24291":47823,"_2452":47901},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_2926":1964,"_25639":1929,"_17911":47903,"_5":17806,"_24291":47827,"_2452":47904},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_2926":1965,"_25639":1929,"_17911":47906,"_5":17806,"_24291":47831,"_2452":47907},[],"Keep the root out of daily operations, or with very restricted access.",{"_2926":1966,"_25639":1929,"_17911":47909,"_5":17806,"_24291":47831,"_2452":47910},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_2926":1967,"_25639":1929,"_17911":47912,"_5":17806,"_24291":47831,"_2452":47913},[],"Assign explicit profiles to every use case.",{"_2926":1968,"_25639":1929,"_17911":47915,"_5":17806,"_24291":47831,"_2452":47916},[],"Distribute the new trust before starting a rotation.",{"_2926":1969,"_25639":1929,"_17911":47918,"_5":17806,"_24291":47831,"_2452":47919},[],"Keep enough overlap to renew a disconnected fleet.",{"_2926":1970,"_25639":1929,"_17911":47921,"_5":17806,"_24291":47831,"_2452":47922},[],"Validate from the consuming system, not only from the Lamassu console.",{"_2926":1971,"_25639":1929,"_17911":47924,"_5":17806,"_24291":47831,"_2452":47925},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_2926":1972,"_25639":1972,"_5":12558,"_2452":47927,"_25983":47928,"_17911":47929,"_24291":1972},"Revocation lists (CRL)",[41760,43104,46797,47414],[],{"_2926":1973,"_25639":1972,"_17911":47931,"_5":17806,"_24291":1972,"_2452":47932},[],"Generate and distribute signed lists to validate certificates offline.",{"_2926":1974,"_25639":1972,"_5":25980,"_17911":47934,"_24291":47935,"_2452":47936},[],"/docs/pr-preview/pr-48/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_2926":1975,"_25639":1972,"_5":25980,"_17911":47938,"_24291":47939,"_2452":47940},[],"/docs/pr-preview/pr-48/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_2926":1976,"_25639":1972,"_5":25980,"_17911":47942,"_24291":47943,"_2452":47944},[],"/docs/pr-preview/pr-48/platform/pki/crl#crl-contents","CRL contents",{"_2926":1977,"_25639":1972,"_5":25980,"_17911":47946,"_24291":47947,"_2452":47948},[],"/docs/pr-preview/pr-48/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_2926":1978,"_25639":1972,"_5":25980,"_17911":47950,"_24291":47951,"_2452":47952},[],"/docs/pr-preview/pr-48/platform/pki/crl#va-role-management-api","VA role management API",{"_2926":1979,"_25639":1972,"_5":25980,"_17911":47954,"_24291":47955,"_2452":47956},[],"/docs/pr-preview/pr-48/platform/pki/crl#from-the-interface","From the interface",{"_2926":1980,"_25639":1972,"_5":25980,"_17911":47958,"_24291":47959,"_2452":47960},[],"/docs/pr-preview/pr-48/platform/pki/crl#references","References",{"_2926":1981,"_25639":1972,"_17911":47962,"_5":17806,"_24291":1972,"_2452":47963},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_2926":1982,"_25639":1972,"_17911":47965,"_5":17806,"_24291":47935,"_2452":47966},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_2926":1983,"_25639":1972,"_17911":47968,"_5":17806,"_24291":47935,"_2452":47969},[],"`crl_options` field",{"_2926":1984,"_25639":1972,"_17911":47971,"_5":17806,"_24291":47935,"_2452":42143},[],{"_2926":1985,"_25639":1972,"_17911":47973,"_5":17806,"_24291":47935,"_2452":47974},[],"Backend initial value",{"_2926":1986,"_25639":1972,"_17911":47976,"_5":17806,"_24291":47935,"_2452":47977},[],"`validity`",{"_2926":1987,"_25639":1972,"_17911":47979,"_5":17806,"_24291":47935,"_2452":47980},[],"Time from `thisUpdate` to `nextUpdate`.",{"_2926":1988,"_25639":1972,"_17911":47982,"_5":17806,"_24291":47935,"_2452":47983},[],"7 days.",{"_2926":1989,"_25639":1972,"_17911":47985,"_5":17806,"_24291":47935,"_2452":47986},[],"`refresh_interval`",{"_2926":1990,"_25639":1972,"_17911":47988,"_5":17806,"_24291":47935,"_2452":47989},[],"Time since publication that triggers scheduled renewal.",{"_2926":1991,"_25639":1972,"_17911":47991,"_5":17806,"_24291":47935,"_2452":47992},[],"6 days and 23 hours.",{"_2926":1992,"_25639":1972,"_17911":47994,"_5":17806,"_24291":47935,"_2452":47995},[],"`regenerate_on_revoke`",{"_2926":1993,"_25639":1972,"_17911":47997,"_5":17806,"_24291":47935,"_2452":47998},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_2926":1994,"_25639":1972,"_17911":48000,"_5":17806,"_24291":47935,"_2452":48001},[],"`true`.",{"_2926":1995,"_25639":1972,"_17911":48003,"_5":17806,"_24291":47935,"_2452":48004},[],"`subject_key_id_signer`",{"_2926":1996,"_25639":1972,"_17911":48006,"_5":17806,"_24291":47935,"_2452":48007},[],"Configuration field initialized with the CA’s SKI.",{"_2926":1997,"_25639":1972,"_17911":48009,"_5":17806,"_24291":47935,"_2452":48010},[],"CA SKI.",{"_2926":1998,"_25639":1972,"_17911":48012,"_5":17806,"_24291":47935,"_2452":48013},[],"The generator uses the key of the CA identified by the requested SKI. Do not interpret `subject_key_id_signer` as verified support for a different delegated CA: changing that field does not change the signer in this flow.",{"_2926":1999,"_25639":1972,"_17911":48015,"_5":17806,"_24291":47935,"_2452":48016},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_2926":2000,"_25639":1972,"_17911":48018,"_5":17806,"_24291":47939,"_2452":48019},[],"The scheduled job requests another list when `refresh_interval` is reached or when the list approaches expiration within the configured watch period. This depends on working jobs, storage and signing; it does not guarantee renewal during a service failure.",{"_2926":2001,"_25639":1972,"_17911":48021,"_5":17806,"_24291":47939,"_2452":48022},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_2926":2002,"_25639":1972,"_17911":48024,"_5":17806,"_24291":47939,"_2452":48025},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_2926":2003,"_25639":1972,"_17911":48027,"_5":17806,"_24291":47943,"_2452":48028},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_2926":2004,"_25639":1972,"_17911":48030,"_5":17806,"_24291":47943,"_2452":48031},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_2926":2005,"_25639":1972,"_17911":48033,"_5":17806,"_24291":47947,"_2452":48034},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_2926":2006,"_25639":1972,"_17911":48036,"_5":17806,"_24291":47947,"_2452":48037},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_2926":2007,"_25639":1972,"_17911":48039,"_5":17806,"_24291":47947,"_2452":48040},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_2926":2008,"_25639":1972,"_17911":48042,"_5":17806,"_24291":47947,"_2452":48043},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_2926":2009,"_25639":1972,"_17911":48045,"_5":17806,"_24291":47947,"_2452":48046},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_2926":2010,"_25639":1972,"_17911":48048,"_5":17806,"_24291":47951,"_2452":48049},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_2926":2011,"_25639":1972,"_17911":48051,"_5":17806,"_24291":47951,"_2452":44828},[],{"_2926":2012,"_25639":1972,"_17911":48053,"_5":17806,"_24291":47951,"_2452":48054},[],"Relative path",{"_2926":2013,"_25639":1972,"_17911":48056,"_5":17806,"_24291":47951,"_2452":44825},[],{"_2926":2014,"_25639":1972,"_17911":48058,"_5":17806,"_24291":47951,"_2452":48059},[],"`GET`",{"_2926":2015,"_25639":1972,"_17911":48061,"_5":17806,"_24291":47951,"_2452":48062},[],"`/v1/roles/{ca-ski}`",{"_2926":2016,"_25639":1972,"_17911":48064,"_5":17806,"_24291":47951,"_2452":48065},[],"Read `crl_options` and `latest_crl`.",{"_2926":2017,"_25639":1972,"_17911":48067,"_5":17806,"_24291":47951,"_2452":48068},[],"`PUT`",{"_2926":2018,"_25639":1972,"_17911":48070,"_5":17806,"_24291":47951,"_2452":48062},[],{"_2926":2019,"_25639":1972,"_17911":48072,"_5":17806,"_24291":47951,"_2452":48073},[],"Replace CRL configuration.",{"_2926":2020,"_25639":1972,"_17911":48075,"_5":17806,"_24291":47951,"_2452":48076},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_2926":2021,"_25639":1972,"_17911":48078,"_5":17806,"_24291":47951,"_2452":48079},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_2926":2022,"_25639":1972,"_17911":48081,"_5":17806,"_24291":47955,"_2452":48082},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_2926":2023,"_25639":1972,"_17911":48084,"_5":17806,"_24291":47959,"_2452":48085},[],"RFC 5280: X.509 and CRL profile.",{"_2926":2024,"_25639":1972,"_17911":48087,"_5":17806,"_24291":47959,"_2452":48088},[],"OpenSSL: openssl-crl.",{"_2926":2025,"_25639":1972,"_17911":48090,"_5":17806,"_24291":47959,"_2452":48091},[],"OpenSSL: openssl-verify.",{"_2926":2026,"_25639":1972,"_17911":48093,"_5":17806,"_24291":47959,"_2452":48094},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_2926":2027,"_25639":1972,"_17911":48096,"_5":17806,"_24291":47959,"_2452":48097},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2926":2028,"_25639":2028,"_5":12558,"_2452":48099,"_25983":48100,"_17911":48101,"_24291":2028},"Keys and cryptographic engines",[41760,43104,46797,46798],[],{"_2926":2029,"_25639":2028,"_17911":48103,"_5":17806,"_24291":2028,"_2452":48104},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_2926":2030,"_25639":2028,"_5":25980,"_17911":48106,"_24291":48107,"_2452":48108},[],"/docs/pr-preview/pr-48/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_2926":2031,"_25639":2028,"_5":25980,"_17911":48110,"_24291":48111,"_2452":48112},[],"/docs/pr-preview/pr-48/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_2926":2032,"_25639":2028,"_5":25980,"_17911":48114,"_24291":48115,"_2452":48116},[],"/docs/pr-preview/pr-48/platform/pki/key-management#file-system","File System",{"_2926":2033,"_25639":2028,"_5":25980,"_17911":48118,"_24291":48119,"_2452":48120},[],"/docs/pr-preview/pr-48/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_2926":2034,"_25639":2028,"_5":25980,"_17911":48122,"_24291":48123,"_2452":48124},[],"/docs/pr-preview/pr-48/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_2926":2035,"_25639":2028,"_5":25980,"_17911":48126,"_24291":48127,"_2452":48128},[],"/docs/pr-preview/pr-48/platform/pki/key-management#aws-kms","AWS KMS",{"_2926":2036,"_25639":2028,"_5":25980,"_17911":48130,"_24291":48131,"_2452":48132},[],"/docs/pr-preview/pr-48/platform/pki/key-management#pkcs11","PKCS#11",{"_2926":2037,"_25639":2028,"_5":25980,"_17911":48134,"_24291":48135,"_2452":48136},[],"/docs/pr-preview/pr-48/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_2926":2038,"_25639":2028,"_5":25980,"_17911":48138,"_24291":48139,"_2452":48140},[],"/docs/pr-preview/pr-48/platform/pki/key-management#key-inventory","Key inventory",{"_2926":2039,"_25639":2028,"_5":25980,"_17911":48142,"_24291":48143,"_2452":48144},[],"/docs/pr-preview/pr-48/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_2926":2040,"_25639":2028,"_5":25980,"_17911":48146,"_24291":48147,"_2452":48148},[],"/docs/pr-preview/pr-48/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_2926":2041,"_25639":2028,"_5":25980,"_17911":48150,"_24291":48151,"_2452":48152},[],"/docs/pr-preview/pr-48/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_2926":2042,"_25639":2028,"_5":25980,"_17911":48154,"_24291":48155,"_2452":48156},[],"/docs/pr-preview/pr-48/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_2926":2043,"_25639":2028,"_5":25980,"_17911":48158,"_24291":48159,"_2452":48160},[],"/docs/pr-preview/pr-48/platform/pki/key-management#view-details","View details",{"_2926":2044,"_25639":2028,"_5":25980,"_17911":48162,"_24291":48163,"_2452":48164},[],"/docs/pr-preview/pr-48/platform/pki/key-management#sign-and-verify","Sign and verify",{"_2926":2045,"_25639":2028,"_5":25980,"_17911":48166,"_24291":48167,"_2452":48168},[],"/docs/pr-preview/pr-48/platform/pki/key-management#sign","Sign",{"_2926":2046,"_25639":2028,"_5":25980,"_17911":48170,"_24291":48171,"_2452":48172},[],"/docs/pr-preview/pr-48/platform/pki/key-management#verify","Verify",{"_2926":2047,"_25639":2028,"_5":25980,"_17911":48174,"_24291":48175,"_2452":48176},[],"/docs/pr-preview/pr-48/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_2926":2048,"_25639":2028,"_5":25980,"_17911":48178,"_24291":48179,"_2452":48180},[],"/docs/pr-preview/pr-48/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_2926":2049,"_25639":2028,"_5":25980,"_17911":48182,"_24291":48183,"_2452":48184},[],"/docs/pr-preview/pr-48/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_2926":2050,"_25639":2028,"_17911":48186,"_5":17806,"_24291":2028,"_2452":48187},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_2926":2051,"_25639":2028,"_17911":48189,"_5":17806,"_24291":2028,"_2452":48190},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_2926":2052,"_25639":2028,"_17911":48192,"_5":17806,"_24291":48107,"_2452":48193},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_2926":2053,"_25639":2028,"_17911":48195,"_5":17806,"_24291":48107,"_2452":48196},[],"In practice, it lets you:",{"_2926":2054,"_25639":2028,"_17911":48198,"_5":17806,"_24291":48107,"_2452":48199},[],"Generate new key pairs from Lamassu IoT.",{"_2926":2055,"_25639":2028,"_17911":48201,"_5":17806,"_24291":48107,"_2452":48202},[],"Import keys created externally.",{"_2926":2056,"_25639":2028,"_17911":48204,"_5":17806,"_24291":48107,"_2452":48205},[],"Delegate custody and cryptographic operations to external engines.",{"_2926":2057,"_25639":2028,"_17911":48207,"_5":17806,"_24291":48107,"_2452":48208},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_2926":2058,"_25639":2028,"_17911":48210,"_5":17806,"_24291":48111,"_2452":48211},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_2926":2059,"_25639":2028,"_17911":48213,"_5":17806,"_24291":48111,"_2452":48214},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_2926":2060,"_25639":2028,"_17911":48216,"_5":17806,"_24291":48111,"_2452":48217},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_2926":2061,"_25639":2028,"_17911":48219,"_5":17806,"_24291":48115,"_2452":48220},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_2926":2062,"_25639":2028,"_17911":48222,"_5":17806,"_24291":48119,"_2452":48223},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_2926":2063,"_25639":2028,"_17911":48225,"_5":17806,"_24291":48123,"_2452":48226},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_2926":2064,"_25639":2028,"_17911":48228,"_5":17806,"_24291":48127,"_2452":48229},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_2926":2065,"_25639":2028,"_17911":48231,"_5":17806,"_24291":48131,"_2452":48232},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_2926":2066,"_25639":2028,"_17911":48234,"_5":17806,"_24291":48135,"_2452":48235},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_2926":2067,"_25639":2028,"_17911":48237,"_5":17806,"_24291":48135,"_2452":48238},[],"Lamassu shows the enabled engines in the console.",{"_2926":2068,"_25639":2028,"_17911":48240,"_5":17806,"_24291":48135,"_2452":48241},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_2926":2069,"_25639":2028,"_17911":48243,"_5":17806,"_24291":48135,"_2452":48244},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_2926":2070,"_25639":2028,"_17911":48246,"_5":17806,"_24291":48139,"_2452":48247},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_2926":2071,"_25639":2028,"_17911":48249,"_5":17806,"_24291":48139,"_2452":48250},[],"The table includes the following fields:",{"_2926":2072,"_25639":2028,"_17911":48252,"_5":17806,"_24291":48139,"_2452":48253},[],"**Name**: descriptive name of the key.",{"_2926":2073,"_25639":2028,"_17911":48255,"_5":17806,"_24291":48139,"_2452":48256},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_2926":2074,"_25639":2028,"_17911":48258,"_5":17806,"_24291":48139,"_2452":48259},[],"**Strength**: visual indicator of cryptographic strength.",{"_2926":2075,"_25639":2028,"_17911":48261,"_5":17806,"_24291":48139,"_2452":48262},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_2926":2076,"_25639":2028,"_17911":48264,"_5":17806,"_24291":48139,"_2452":48265},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_2926":2077,"_25639":2028,"_17911":48267,"_5":17806,"_24291":48139,"_2452":48268},[],"**Aliases**: alternative names associated with the key.",{"_2926":2078,"_25639":2028,"_17911":48270,"_5":17806,"_24291":48139,"_2452":48271},[],"**Tags**: labels for classification and search.",{"_2926":2079,"_25639":2028,"_17911":48273,"_5":17806,"_24291":48139,"_2452":48274},[],"**Related Entities**: certificates or other entities linked to that key.",{"_2926":2080,"_25639":2028,"_17911":48276,"_5":17806,"_24291":48139,"_2452":48277},[],"From this view you also reach the most common actions:",{"_2926":2081,"_25639":2028,"_17911":48279,"_5":17806,"_24291":48139,"_2452":48280},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_2926":2082,"_25639":2028,"_17911":48282,"_5":17806,"_24291":48139,"_2452":48283},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_2926":2083,"_25639":2028,"_17911":48285,"_5":17806,"_24291":48139,"_2452":48286},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_2926":2084,"_25639":2028,"_17911":48288,"_5":17806,"_24291":48139,"_2452":48289},[],"**Delete Key** to remove the key from the system.",{"_2926":2085,"_25639":2028,"_17911":48291,"_5":17806,"_24291":48143,"_2452":48292},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_2926":2086,"_25639":2028,"_17911":48294,"_5":17806,"_24291":48147,"_2452":48295},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_2926":2087,"_25639":2028,"_17911":48297,"_5":17806,"_24291":48147,"_2452":48298},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_2926":2088,"_25639":2028,"_17911":48300,"_5":17806,"_24291":48147,"_2452":48301},[],"**Key Name**: unique and descriptive name.",{"_2926":2089,"_25639":2028,"_17911":48303,"_5":17806,"_24291":48147,"_2452":48304},[],"**Crypto Engine**: engine that will keep the key.",{"_2926":2090,"_25639":2028,"_17911":48306,"_5":17806,"_24291":48147,"_2452":48307},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_2926":2091,"_25639":2028,"_17911":48309,"_5":17806,"_24291":48147,"_2452":48310},[],"**Tags**: metadata to classify the key.",{"_2926":2092,"_25639":2028,"_17911":48312,"_5":17806,"_24291":48147,"_2452":48313},[],"**Metadata**: additional information for advanced uses.",{"_2926":2093,"_25639":2028,"_17911":48315,"_5":17806,"_24291":48151,"_2452":48316},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_2926":2094,"_25639":2028,"_17911":48318,"_5":17806,"_24291":48151,"_2452":48319},[],"When you have an exportable private key and the destination engine supports import.",{"_2926":2095,"_25639":2028,"_17911":48321,"_5":17806,"_24291":48151,"_2452":48322},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_2926":2096,"_25639":2028,"_17911":48324,"_5":17806,"_24291":48151,"_2452":48325},[],"When Lamassu must operate with a root of trust created by a third party.",{"_2926":2097,"_25639":2028,"_17911":48327,"_5":17806,"_24291":48151,"_2452":48328},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_2926":2098,"_25639":2028,"_17911":48330,"_5":17806,"_24291":48151,"_2452":48331},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_2926":2099,"_25639":2028,"_17911":48333,"_5":17806,"_24291":48151,"_2452":48334},[],"**Crypto Engine**: engine that will keep the imported key.",{"_2926":2100,"_25639":2028,"_17911":48336,"_5":17806,"_24291":48151,"_2452":48337},[],"**Tags**: labels for organization and search.",{"_2926":2101,"_25639":2028,"_17911":48339,"_5":17806,"_24291":48151,"_2452":48340},[],"**Metadata**: additional optional information.",{"_2926":2102,"_25639":2028,"_17911":48342,"_5":17806,"_24291":48151,"_2452":48343},[],"**Private Key (PEM)**: private key in PEM format.",{"_2926":2103,"_25639":2028,"_17911":48345,"_5":17806,"_24291":48151,"_2452":48346},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_2926":2104,"_25639":2028,"_17911":48348,"_5":17806,"_24291":48155,"_2452":48349},[],"Each registered key has a detail view and several operational actions.",{"_2926":2105,"_25639":2028,"_17911":48351,"_5":17806,"_24291":48159,"_2452":48352},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_2926":2106,"_25639":2028,"_17911":48354,"_5":17806,"_24291":48159,"_2452":48355},[],"The **Overview** tab shows, among others, these fields:",{"_2926":2107,"_25639":2028,"_17911":48357,"_5":17806,"_24291":48159,"_2452":48358},[],"**Key Name**: descriptive name.",{"_2926":2108,"_25639":2028,"_17911":48360,"_5":17806,"_24291":48159,"_2452":48361},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_2926":2109,"_25639":2028,"_17911":48363,"_5":17806,"_24291":48159,"_2452":48364},[],"**Tags**: associated labels.",{"_2926":2110,"_25639":2028,"_17911":48366,"_5":17806,"_24291":48159,"_2452":48367},[],"**Aliases**: alternative names.",{"_2926":2111,"_25639":2028,"_17911":48369,"_5":17806,"_24291":48159,"_2452":48370},[],"**Crypto Engine**: engine where the key resides.",{"_2926":2112,"_25639":2028,"_17911":48372,"_5":17806,"_24291":48159,"_2452":48373},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_2926":2113,"_25639":2028,"_17911":48375,"_5":17806,"_24291":48159,"_2452":48376},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_2926":2114,"_25639":2028,"_17911":48378,"_5":17806,"_24291":48159,"_2452":48379},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_2926":2115,"_25639":2028,"_17911":48381,"_5":17806,"_24291":48163,"_2452":48382},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_2926":2116,"_25639":2028,"_17911":48384,"_5":17806,"_24291":48163,"_2452":48385},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_2926":2117,"_25639":2028,"_17911":48387,"_5":17806,"_24291":48163,"_2452":48388},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_2926":2118,"_25639":2028,"_17911":48390,"_5":17806,"_24291":48167,"_2452":48391},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_2926":2119,"_25639":2028,"_17911":48393,"_5":17806,"_24291":48167,"_2452":48394},[],"Main fields:",{"_2926":2120,"_25639":2028,"_17911":48396,"_5":17806,"_24291":48167,"_2452":48397},[],"**Algorithm**: signing algorithm available for the key type.",{"_2926":2121,"_25639":2028,"_17911":48399,"_5":17806,"_24291":48167,"_2452":48400},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_2926":2122,"_25639":2028,"_17911":48402,"_5":17806,"_24291":48167,"_2452":48403},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_2926":2123,"_25639":2028,"_17911":48405,"_5":17806,"_24291":48167,"_2452":48406},[],"**Message**: content to sign.",{"_2926":2124,"_25639":2028,"_17911":48408,"_5":17806,"_24291":48167,"_2452":48409},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_2926":2125,"_25639":2028,"_17911":48411,"_5":17806,"_24291":48171,"_2452":48412},[],"This tab checks whether a signature corresponds to the associated public key.",{"_2926":2126,"_25639":2028,"_17911":48414,"_5":17806,"_24291":48171,"_2452":48394},[],{"_2926":2127,"_25639":2028,"_17911":48416,"_5":17806,"_24291":48171,"_2452":48417},[],"**Algorithm**: must match the algorithm used for the signature.",{"_2926":2128,"_25639":2028,"_17911":48419,"_5":17806,"_24291":48171,"_2452":48420},[],"**Message Type**: `Raw` or `Digest`.",{"_2926":2129,"_25639":2028,"_17911":48422,"_5":17806,"_24291":48171,"_2452":48423},[],"**Payload Encoding**: encoding of the message.",{"_2926":2130,"_25639":2028,"_17911":48425,"_5":17806,"_24291":48171,"_2452":48426},[],"**Message**: original message or hash.",{"_2926":2131,"_25639":2028,"_17911":48428,"_5":17806,"_24291":48171,"_2452":48429},[],"**Signature**: signature to check.",{"_2926":2132,"_25639":2028,"_17911":48431,"_5":17806,"_24291":48171,"_2452":48432},[],"**Result**: indicator of the validation result.",{"_2926":2133,"_25639":2028,"_17911":48434,"_5":17806,"_24291":48175,"_2452":48435},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_2926":2134,"_25639":2028,"_17911":48437,"_5":17806,"_24291":48175,"_2452":48438},[],"This flow is useful for:",{"_2926":2135,"_25639":2028,"_17911":48440,"_5":17806,"_24291":48175,"_2452":48441},[],"Requesting certificates from an external CA.",{"_2926":2136,"_25639":2028,"_17911":48443,"_5":17806,"_24291":48175,"_2452":48444},[],"Renewing an identity while keeping the same key.",{"_2926":2137,"_25639":2028,"_17911":48446,"_5":17806,"_24291":48175,"_2452":48447},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_2926":2138,"_25639":2028,"_17911":48449,"_5":17806,"_24291":48175,"_2452":48450},[],"**Common Name (CN)**: main name of the identity.",{"_2926":2139,"_25639":2028,"_17911":48452,"_5":17806,"_24291":48175,"_2452":48453},[],"**Organization (O)**: organization or company.",{"_2926":2140,"_25639":2028,"_17911":48455,"_5":17806,"_24291":48175,"_2452":48456},[],"**Organizational Unit (OU)**: department or unit.",{"_2926":2141,"_25639":2028,"_17911":48458,"_5":17806,"_24291":48175,"_2452":48459},[],"**Country (C)**: two-letter country code.",{"_2926":2142,"_25639":2028,"_17911":48461,"_5":17806,"_24291":48175,"_2452":48462},[],"**State / Province (ST)**: state or province.",{"_2926":2143,"_25639":2028,"_17911":48464,"_5":17806,"_24291":48175,"_2452":48465},[],"**Locality (L)**: city or locality.",{"_2926":2144,"_25639":2028,"_17911":48467,"_5":17806,"_24291":48175,"_2452":48468},[],"**Email Address**: contact email.",{"_2926":2145,"_25639":2028,"_17911":48470,"_5":17806,"_24291":48175,"_2452":48471},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_2926":2146,"_25639":2028,"_17911":48473,"_5":17806,"_24291":48175,"_2452":48474},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_2926":2147,"_25639":2028,"_17911":48476,"_5":17806,"_24291":48179,"_2452":48477},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_2926":2148,"_25639":2028,"_17911":48479,"_5":17806,"_24291":48179,"_2452":48480},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_2926":2149,"_25639":2028,"_17911":48482,"_5":17806,"_24291":48183,"_2452":48483},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_2926":2150,"_25639":2150,"_5":12558,"_2452":48485,"_25983":48486,"_17911":48487,"_24291":2150},"Online validation with OCSP",[41760,43104,46797,47414],[],{"_2926":2151,"_25639":2150,"_17911":48489,"_5":17806,"_24291":2150,"_2452":48490},[],"Query signed status and verify the responder’s response.",{"_2926":2152,"_25639":2150,"_5":25980,"_17911":48492,"_24291":48493,"_2452":48494},[],"/docs/pr-preview/pr-48/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_2926":2153,"_25639":2150,"_5":25980,"_17911":48496,"_24291":48497,"_2452":48498},[],"/docs/pr-preview/pr-48/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_2926":2154,"_25639":2150,"_5":25980,"_17911":48500,"_24291":48501,"_2452":48502},[],"/docs/pr-preview/pr-48/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_2926":2155,"_25639":2150,"_5":25980,"_17911":48504,"_24291":48505,"_2452":48506},[],"/docs/pr-preview/pr-48/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_2926":2156,"_25639":2150,"_5":25980,"_17911":48508,"_24291":48509,"_2452":48510},[],"/docs/pr-preview/pr-48/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_2926":2157,"_25639":2150,"_5":25980,"_17911":48512,"_24291":48513,"_2452":47960},[],"/docs/pr-preview/pr-48/platform/pki/ocsp#references",{"_2926":2158,"_25639":2150,"_17911":48515,"_5":17806,"_24291":2150,"_2452":48516},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_2926":2159,"_25639":2150,"_17911":48518,"_5":17806,"_24291":48493,"_2452":48519},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_2926":2160,"_25639":2150,"_17911":48521,"_5":17806,"_24291":48493,"_2452":48522},[],"Record status",{"_2926":2161,"_25639":2150,"_17911":48524,"_5":17806,"_24291":48493,"_2452":48525},[],"Signed response",{"_2926":2162,"_25639":2150,"_17911":48527,"_5":17806,"_24291":48493,"_2452":45975},[],{"_2926":2163,"_25639":2150,"_17911":48529,"_5":17806,"_24291":48493,"_2452":48530},[],"`Good`.",{"_2926":2164,"_25639":2150,"_17911":48532,"_5":17806,"_24291":48493,"_2452":45992},[],{"_2926":2165,"_25639":2150,"_17911":48534,"_5":17806,"_24291":48493,"_2452":48535},[],"`Revoked`, with revocation reason and timestamp.",{"_2926":2166,"_25639":2150,"_17911":48537,"_5":17806,"_24291":48493,"_2452":48538},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_2926":2167,"_25639":2150,"_17911":48540,"_5":17806,"_24291":48493,"_2452":48541},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_2926":2168,"_25639":2150,"_17911":48543,"_5":17806,"_24291":48493,"_2452":48544},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_2926":2169,"_25639":2150,"_17911":48546,"_5":17806,"_24291":48493,"_2452":48547},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_2926":2170,"_25639":2150,"_17911":48549,"_5":17806,"_24291":48493,"_2452":48550},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_2926":2171,"_25639":2150,"_17911":48552,"_5":17806,"_24291":48497,"_2452":48553},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_2926":2172,"_25639":2150,"_17911":48555,"_5":17806,"_24291":48497,"_2452":48556},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_2926":2173,"_25639":2150,"_17911":48558,"_5":17806,"_24291":48501,"_2452":48559},[],"The service accepts:",{"_2926":2174,"_25639":2150,"_17911":48561,"_5":17806,"_24291":48501,"_2452":44828},[],{"_2926":2175,"_25639":2150,"_17911":48563,"_5":17806,"_24291":48501,"_2452":48564},[],"VA service path",{"_2926":2176,"_25639":2150,"_17911":48566,"_5":17806,"_24291":48501,"_2452":48567},[],"Format",{"_2926":2177,"_25639":2150,"_17911":48569,"_5":17806,"_24291":48501,"_2452":48570},[],"`POST`",{"_2926":2178,"_25639":2150,"_17911":48572,"_5":17806,"_24291":48501,"_2452":48573},[],"`/ocsp`",{"_2926":2179,"_25639":2150,"_17911":48575,"_5":17806,"_24291":48501,"_2452":48576},[],"DER request, `Content-Type: application/ocsp-request`.",{"_2926":2180,"_25639":2150,"_17911":48578,"_5":17806,"_24291":48501,"_2452":48059},[],{"_2926":2181,"_25639":2150,"_17911":48580,"_5":17806,"_24291":48501,"_2452":48581},[],"`/ocsp/{ocsp_request}`",{"_2926":2182,"_25639":2150,"_17911":48583,"_5":17806,"_24291":48501,"_2452":48584},[],"DER request encoded using padded URL Base64.",{"_2926":2183,"_25639":2150,"_17911":48586,"_5":17806,"_24291":48501,"_2452":48587},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_2926":2184,"_25639":2150,"_17911":48589,"_5":17806,"_24291":48505,"_2452":48590},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_2926":2185,"_25639":2150,"_17911":48592,"_5":17806,"_24291":48505,"_2452":48593},[],"Generate the request:",{"_2926":2186,"_25639":2150,"_17911":48595,"_5":17806,"_24291":48505,"_2452":48596},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_2926":2187,"_25639":2150,"_17911":48598,"_5":17806,"_24291":48505,"_2452":48599},[],"Replace the example URL with the inspected endpoint:",{"_2926":2188,"_25639":2150,"_17911":48601,"_5":17806,"_24291":48505,"_2452":48602},[],"Verify the returned DER:",{"_2926":2189,"_25639":2150,"_17911":48604,"_5":17806,"_24291":48505,"_2452":48605},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_2926":2190,"_25639":2150,"_17911":48607,"_5":17806,"_24291":48509,"_2452":48608},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_2926":2191,"_25639":2150,"_17911":48610,"_5":17806,"_24291":48509,"_2452":48611},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_2926":2192,"_25639":2150,"_17911":48613,"_5":17806,"_24291":48513,"_2452":48614},[],"RFC 6960: OCSP.",{"_2926":2193,"_25639":2150,"_17911":48616,"_5":17806,"_24291":48513,"_2452":48617},[],"OpenSSL: openssl-ocsp.",{"_2926":2194,"_25639":2150,"_17911":48619,"_5":17806,"_24291":48513,"_2452":48620},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_2926":2195,"_25639":2150,"_17911":48622,"_5":17806,"_24291":48513,"_2452":48097},[],{"_2926":2196,"_25639":2196,"_5":12558,"_2452":46797,"_25983":48624,"_17911":48625,"_24291":2196},[41760,43104,46797],[],{"_2926":2197,"_25639":2196,"_17911":48627,"_5":17806,"_24291":2196,"_2452":48628},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_2926":2198,"_25639":2196,"_5":25980,"_17911":48630,"_24291":48631,"_2452":46107},[],"/docs/pr-preview/pr-48/platform/pki/overview#start-here",{"_2926":2199,"_25639":2196,"_5":25980,"_17911":48633,"_24291":48634,"_2452":48635},[],"/docs/pr-preview/pr-48/platform/pki/overview#what-you-need","What you need",{"_2926":2200,"_25639":2196,"_5":25980,"_17911":48637,"_24291":48638,"_2452":46641},[],"/docs/pr-preview/pr-48/platform/pki/overview#core-capabilities",{"_2926":2201,"_25639":2196,"_5":25980,"_17911":48640,"_24291":48641,"_2452":46645},[],"/docs/pr-preview/pr-48/platform/pki/overview#build-your-trust-hierarchy",{"_2926":2202,"_25639":2196,"_5":25980,"_17911":48643,"_24291":48644,"_2452":46649},[],"/docs/pr-preview/pr-48/platform/pki/overview#protect-cryptographic-keys",{"_2926":2203,"_25639":2196,"_5":25980,"_17911":48646,"_24291":48647,"_2452":46653},[],"/docs/pr-preview/pr-48/platform/pki/overview#issue-and-control-certificates",{"_2926":2204,"_25639":2196,"_5":25980,"_17911":48649,"_24291":48650,"_2452":46661},[],"/docs/pr-preview/pr-48/platform/pki/overview#publish-validation-status",{"_2926":2205,"_25639":2196,"_5":25980,"_17911":48652,"_24291":48653,"_2452":48654},[],"/docs/pr-preview/pr-48/platform/pki/overview#how-to-check-the-result","How to check the result",{"_2926":2206,"_25639":2196,"_5":25980,"_17911":48656,"_24291":48657,"_2452":47581},[],"/docs/pr-preview/pr-48/platform/pki/overview#continue",{"_2926":2207,"_25639":2196,"_17911":48659,"_5":17806,"_24291":2196,"_2452":48660},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_2926":2208,"_25639":2196,"_17911":48662,"_5":17806,"_24291":48631,"_2452":48663},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_2926":2209,"_25639":2196,"_17911":48665,"_5":17806,"_24291":48631,"_2452":48666},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_2926":2210,"_25639":2196,"_17911":48668,"_5":17806,"_24291":48634,"_2452":48669},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_2926":2211,"_25639":2196,"_17911":48671,"_5":17806,"_24291":48634,"_2452":48672},[],"An available cryptographic engine to keep the authority's key.",{"_2926":2212,"_25639":2196,"_17911":48674,"_5":17806,"_24291":48634,"_2452":48675},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_2926":2213,"_25639":2196,"_17911":48677,"_5":17806,"_24291":48634,"_2452":48678},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_2926":2214,"_25639":2196,"_17911":48680,"_5":17806,"_24291":48634,"_2452":48681},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_2926":2215,"_25639":2196,"_17911":48683,"_5":17806,"_24291":48641,"_2452":48684},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_2926":2216,"_25639":2196,"_17911":48686,"_5":17806,"_24291":48644,"_2452":48687},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_2926":2217,"_25639":2196,"_17911":48689,"_5":17806,"_24291":48647,"_2452":48690},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_2926":2218,"_25639":2196,"_17911":48692,"_5":17806,"_24291":48650,"_2452":48693},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_2926":2219,"_25639":2196,"_17911":48695,"_5":17806,"_24291":48653,"_2452":48696},[],"An active certificate in the console is one part of the check. Also verify that:",{"_2926":2220,"_25639":2196,"_17911":48698,"_5":17806,"_24291":48653,"_2452":48699},[],"its subject and extensions identify the expected client;",{"_2926":2221,"_25639":2196,"_17911":48701,"_5":17806,"_24291":48653,"_2452":48702},[],"its public key matches the client's private key;",{"_2926":2222,"_25639":2196,"_17911":48704,"_5":17806,"_24291":48653,"_2452":48705},[],"its chain reaches a root trusted by the consumer;",{"_2926":2223,"_25639":2196,"_17911":48707,"_5":17806,"_24291":48653,"_2452":48708},[],"its dates and usages allow the operation;",{"_2926":2224,"_25639":2196,"_17911":48710,"_5":17806,"_24291":48653,"_2452":48711},[],"the consumer applies revocation checks and authorization.",{"_2926":2225,"_25639":2196,"_17911":48713,"_5":17806,"_24291":48653,"_2452":48714},[],"The issuance path includes the first independent checks.",{"_2926":2226,"_25639":2196,"_17911":48716,"_5":17806,"_24291":48657,"_2452":48717},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2926":2227,"_25639":2196,"_17911":48719,"_5":17806,"_24291":48657,"_2452":48720},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2926":2228,"_25639":2196,"_17911":48722,"_5":17806,"_24291":48657,"_2452":48723},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2926":2229,"_25639":2229,"_5":12558,"_2452":48725,"_25983":48726,"_17911":48727,"_24291":2229},"Create your first CA",[41760,43104,46797,46232],[],{"_2926":2230,"_25639":2229,"_17911":48729,"_5":17806,"_24291":2229,"_2452":48730},[],"Create an evaluation root and check its certificate before issuing.",{"_2926":2231,"_25639":2229,"_5":25980,"_17911":48732,"_24291":48733,"_2452":41770},[],"/docs/pr-preview/pr-48/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_2926":2232,"_25639":2229,"_5":25980,"_17911":48735,"_24291":48736,"_2452":48737},[],"/docs/pr-preview/pr-48/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_2926":2233,"_25639":2229,"_5":25980,"_17911":48739,"_24291":48740,"_2452":48741},[],"/docs/pr-preview/pr-48/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_2926":2234,"_25639":2229,"_5":25980,"_17911":48743,"_24291":48744,"_2452":48745},[],"/docs/pr-preview/pr-48/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_2926":2235,"_25639":2229,"_5":25980,"_17911":48747,"_24291":48748,"_2452":48749},[],"/docs/pr-preview/pr-48/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_2926":2236,"_25639":2229,"_5":25980,"_17911":48751,"_24291":48752,"_2452":48753},[],"/docs/pr-preview/pr-48/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_2926":2237,"_25639":2229,"_5":25980,"_17911":48755,"_24291":48756,"_2452":48757},[],"/docs/pr-preview/pr-48/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_2926":2238,"_25639":2229,"_5":25980,"_17911":48759,"_24291":48760,"_2452":46490},[],"/docs/pr-preview/pr-48/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_2926":2239,"_25639":2229,"_5":25980,"_17911":48762,"_24291":48763,"_2452":41794},[],"/docs/pr-preview/pr-48/platform/pki/quickstarts/create-certificate-authority#next-step",{"_2926":2240,"_25639":2229,"_17911":48765,"_5":17806,"_24291":2229,"_2452":48766},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_2926":2241,"_25639":2229,"_17911":48768,"_5":17806,"_24291":48733,"_2452":48769},[],"Console access and permission to create keys and authorities.",{"_2926":2242,"_25639":2229,"_17911":48771,"_5":17806,"_24291":48733,"_2452":48772},[],"An available cryptographic engine that supports the chosen algorithm.",{"_2926":2243,"_25639":2229,"_17911":48774,"_5":17806,"_24291":48733,"_2452":48775},[],"OpenSSL 3.x to check the downloaded certificate.",{"_2926":2244,"_25639":2229,"_17911":48777,"_5":17806,"_24291":48733,"_2452":48778},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_2926":2245,"_25639":2229,"_17911":48780,"_5":17806,"_24291":48736,"_2452":48781},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_2926":2246,"_25639":2229,"_17911":48783,"_5":17806,"_24291":48736,"_2452":48784},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_2926":2247,"_25639":2229,"_17911":48786,"_5":17806,"_24291":48740,"_2452":48787},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_2926":2248,"_25639":2229,"_17911":48789,"_5":17806,"_24291":48740,"_2452":48790},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_2926":2249,"_25639":2229,"_17911":48792,"_5":17806,"_24291":48744,"_2452":48793},[],"Select **Root CA** and complete:",{"_2926":2250,"_25639":2229,"_17911":48795,"_5":17806,"_24291":48744,"_2452":48796},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_2926":2251,"_25639":2229,"_17911":48798,"_5":17806,"_24291":48744,"_2452":48799},[],"**Subject**: organization and country details for your evaluation.",{"_2926":2252,"_25639":2229,"_17911":48801,"_5":17806,"_24291":48744,"_2452":48802},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_2926":2253,"_25639":2229,"_17911":48804,"_5":17806,"_24291":48744,"_2452":48805},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_2926":2254,"_25639":2229,"_17911":48807,"_5":17806,"_24291":48744,"_2452":48808},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_2926":2255,"_25639":2229,"_17911":48810,"_5":17806,"_24291":48748,"_2452":48811},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_2926":2256,"_25639":2229,"_17911":48813,"_5":17806,"_24291":48752,"_2452":48814},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_2926":2257,"_25639":2229,"_17911":48816,"_5":17806,"_24291":48752,"_2452":48817},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_2926":2258,"_25639":2229,"_17911":48819,"_5":17806,"_24291":48756,"_2452":48820},[],"Run from the directory where you saved `ca.pem`:",{"_2926":2259,"_25639":2229,"_17911":48822,"_5":17806,"_24291":48756,"_2452":48823},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_2926":2260,"_25639":2229,"_17911":48825,"_5":17806,"_24291":48756,"_2452":48826},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_2926":2261,"_25639":2229,"_17911":48828,"_5":17806,"_24291":48760,"_2452":48829},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_2926":2262,"_25639":2229,"_17911":48831,"_5":17806,"_24291":48760,"_2452":48832},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_2926":2263,"_25639":2229,"_17911":48834,"_5":17806,"_24291":48760,"_2452":48835},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_2926":2264,"_25639":2229,"_17911":48837,"_5":17806,"_24291":48760,"_2452":48838},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_2926":2265,"_25639":2229,"_17911":48840,"_5":17806,"_24291":48763,"_2452":48841},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_2926":2266,"_25639":2266,"_5":12558,"_2452":48843,"_25983":48844,"_17911":48845,"_24291":2266},"Issue and verify a certificate",[41760,43104,46797,46232],[],{"_2926":2267,"_25639":2266,"_17911":48847,"_5":17806,"_24291":2266,"_2452":48848},[],"Issue a client certificate and check content, chain and key correspondence.",{"_2926":2268,"_25639":2266,"_5":25980,"_17911":48850,"_24291":48851,"_2452":41770},[],"/docs/pr-preview/pr-48/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_2926":2269,"_25639":2266,"_5":25980,"_17911":48853,"_24291":48854,"_2452":48855},[],"/docs/pr-preview/pr-48/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_2926":2270,"_25639":2266,"_5":25980,"_17911":48857,"_24291":48858,"_2452":48859},[],"/docs/pr-preview/pr-48/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_2926":2271,"_25639":2266,"_5":25980,"_17911":48861,"_24291":48862,"_2452":48863},[],"/docs/pr-preview/pr-48/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_2926":2272,"_25639":2266,"_5":25980,"_17911":48865,"_24291":48866,"_2452":48867},[],"/docs/pr-preview/pr-48/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_2926":2273,"_25639":2266,"_5":25980,"_17911":48869,"_24291":48870,"_2452":48871},[],"/docs/pr-preview/pr-48/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_2926":2274,"_25639":2266,"_5":25980,"_17911":48873,"_24291":48874,"_2452":48753},[],"/docs/pr-preview/pr-48/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_2926":2275,"_25639":2266,"_5":25980,"_17911":48876,"_24291":48877,"_2452":48878},[],"/docs/pr-preview/pr-48/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_2926":2276,"_25639":2266,"_5":25980,"_17911":48880,"_24291":48881,"_2452":48882},[],"/docs/pr-preview/pr-48/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_2926":2277,"_25639":2266,"_5":25980,"_17911":48884,"_24291":48885,"_2452":48886},[],"/docs/pr-preview/pr-48/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_2926":2278,"_25639":2266,"_5":25980,"_17911":48888,"_24291":48889,"_2452":46490},[],"/docs/pr-preview/pr-48/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_2926":2279,"_25639":2266,"_5":25980,"_17911":48891,"_24291":48892,"_2452":41794},[],"/docs/pr-preview/pr-48/platform/pki/quickstarts/issue-certificate#next-step",{"_2926":2280,"_25639":2266,"_17911":48894,"_5":17806,"_24291":2266,"_2452":48895},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_2926":2281,"_25639":2266,"_17911":48897,"_5":17806,"_24291":48851,"_2452":48898},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_2926":2282,"_25639":2266,"_17911":48900,"_5":17806,"_24291":48851,"_2452":48901},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_2926":2283,"_25639":2266,"_17911":48903,"_5":17806,"_24291":48851,"_2452":48904},[],"OpenSSL 3.x and a working directory with restricted access.",{"_2926":2284,"_25639":2266,"_17911":48906,"_5":17806,"_24291":48851,"_2452":48907},[],"A client identifier: here we use `device-001`.",{"_2926":2285,"_25639":2266,"_17911":48909,"_5":17806,"_24291":48851,"_2452":48910},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_2926":2286,"_25639":2266,"_17911":48912,"_5":17806,"_24291":48854,"_2452":48913},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_2926":2287,"_25639":2266,"_17911":48915,"_5":17806,"_24291":48858,"_2452":48916},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_2926":2288,"_25639":2266,"_17911":48918,"_5":17806,"_24291":48858,"_2452":48919},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_2926":2289,"_25639":2266,"_17911":48921,"_5":17806,"_24291":48862,"_2452":48922},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_2926":2290,"_25639":2266,"_17911":48924,"_5":17806,"_24291":48862,"_2452":48925},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_2926":2291,"_25639":2266,"_17911":48927,"_5":17806,"_24291":48866,"_2452":48928},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_2926":2292,"_25639":2266,"_17911":48930,"_5":17806,"_24291":48866,"_2452":48931},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_2926":2293,"_25639":2266,"_17911":48933,"_5":17806,"_24291":48870,"_2452":48934},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_2926":2294,"_25639":2266,"_17911":48936,"_5":17806,"_24291":48874,"_2452":48937},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_2926":2295,"_25639":2266,"_17911":48939,"_5":17806,"_24291":48877,"_2452":48940},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_2926":2296,"_25639":2266,"_17911":48942,"_5":17806,"_24291":48881,"_2452":48943},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_2926":2297,"_25639":2266,"_17911":48945,"_5":17806,"_24291":48881,"_2452":48946},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_2926":2298,"_25639":2266,"_17911":48948,"_5":17806,"_24291":48881,"_2452":48949},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_2926":2299,"_25639":2266,"_17911":48951,"_5":17806,"_24291":48885,"_2452":48952},[],"In Bash, compare the two public-key digests:",{"_2926":2300,"_25639":2266,"_17911":48954,"_5":17806,"_24291":48885,"_2452":48955},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_2926":2301,"_25639":2266,"_17911":48957,"_5":17806,"_24291":48885,"_2452":48958},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_2926":2302,"_25639":2266,"_17911":48960,"_5":17806,"_24291":48889,"_2452":46574},[],{"_2926":2303,"_25639":2266,"_17911":48962,"_5":17806,"_24291":48889,"_2452":48963},[],"What to review",{"_2926":2304,"_25639":2266,"_17911":48965,"_5":17806,"_24291":48889,"_2452":48966},[],"The CA rejects issuance",{"_2926":2305,"_25639":2266,"_17911":48968,"_5":17806,"_24291":48889,"_2452":48969},[],"Permissions, CA state and key, algorithm and profile.",{"_2926":2306,"_25639":2266,"_17911":48971,"_5":17806,"_24291":48889,"_2452":48972},[],"Different subject or usages",{"_2926":2307,"_25639":2266,"_17911":48974,"_5":17806,"_24291":48889,"_2452":48975},[],"Applied profile and requested values.",{"_2926":2308,"_25639":2266,"_17911":48977,"_5":17806,"_24291":48889,"_2452":48978},[],"Issuer cannot be found",{"_2926":2309,"_25639":2266,"_17911":48980,"_5":17806,"_24291":48889,"_2452":48981},[],"Downloaded CA and required intermediate chain.",{"_2926":2310,"_25639":2266,"_17911":48983,"_5":17806,"_24291":48889,"_2452":48984},[],"Validity fails",{"_2926":2311,"_25639":2266,"_17911":48986,"_5":17806,"_24291":48889,"_2452":48987},[],"Certificate and CA dates, and the computer's clock.",{"_2926":2312,"_25639":2266,"_17911":48989,"_5":17806,"_24291":48889,"_2452":48990},[],"Public-key digests differ",{"_2926":2313,"_25639":2266,"_17911":48992,"_5":17806,"_24291":48889,"_2452":48993},[],"Certificate and key files from the same issuance.",{"_2926":2314,"_25639":2266,"_17911":48995,"_5":17806,"_24291":48889,"_2452":48996},[],"See PKI diagnostics to narrow an issuance failure.",{"_2926":2315,"_25639":2266,"_17911":48998,"_5":17806,"_24291":48892,"_2452":48999},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_2926":2316,"_25639":2266,"_17911":49001,"_5":17806,"_24291":48892,"_2452":49002},[],"Manage certificates for inspection, status and revocation.",{"_2926":2317,"_25639":2266,"_17911":49004,"_5":17806,"_24291":48892,"_2452":49005},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_2926":2318,"_25639":2266,"_17911":49007,"_5":17806,"_24291":48892,"_2452":49008},[],"Prepare EST for the device to request its next identities.",{"_2926":2319,"_25639":2266,"_17911":49010,"_5":17806,"_24291":48892,"_2452":49011},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_2926":2320,"_25639":2320,"_5":12558,"_2452":49013,"_25983":49014,"_17911":49015,"_24291":2320},"PKI getting started",[41760,43104,46797,46232],[],{"_2926":2321,"_25639":2320,"_17911":49017,"_5":17806,"_24291":2320,"_2452":49018},[],"Create a CA, issue a client certificate and check its chain and key.",{"_2926":2322,"_25639":2320,"_5":25980,"_17911":49020,"_24291":49021,"_2452":41770},[],"/docs/pr-preview/pr-48/platform/pki/quickstarts/overview#before-you-begin",{"_2926":2323,"_25639":2320,"_5":25980,"_17911":49023,"_24291":49024,"_2452":49025},[],"/docs/pr-preview/pr-48/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_2926":2324,"_25639":2320,"_5":25980,"_17911":49027,"_24291":49028,"_2452":46424},[],"/docs/pr-preview/pr-48/platform/pki/quickstarts/overview#expected-result",{"_2926":2325,"_25639":2320,"_5":25980,"_17911":49030,"_24291":49031,"_2452":49032},[],"/docs/pr-preview/pr-48/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_2926":2326,"_25639":2320,"_17911":49034,"_5":17806,"_24291":2320,"_2452":49035},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_2926":2327,"_25639":2320,"_17911":49037,"_5":17806,"_24291":49021,"_2452":49038},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_2926":2328,"_25639":2320,"_17911":49040,"_5":17806,"_24291":49021,"_2452":49041},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_2926":2329,"_25639":2320,"_17911":49043,"_5":17806,"_24291":49021,"_2452":49044},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_2926":2330,"_25639":2320,"_17911":49046,"_5":17806,"_24291":49021,"_2452":49047},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_2926":2331,"_25639":2320,"_17911":49049,"_5":17806,"_24291":49021,"_2452":49050},[],"A working directory with restricted access for the downloaded key.",{"_2926":2332,"_25639":2320,"_17911":49052,"_5":17806,"_24291":49024,"_2452":49053},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2926":2333,"_25639":2320,"_17911":49055,"_5":17806,"_24291":49024,"_2452":49056},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2926":2334,"_25639":2320,"_17911":49058,"_5":17806,"_24291":49024,"_2452":49059},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_2926":2335,"_25639":2320,"_17911":49061,"_5":17806,"_24291":49024,"_2452":49062},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_2926":2336,"_25639":2320,"_17911":49064,"_5":17806,"_24291":49028,"_2452":49065},[],"File or resource",{"_2926":2337,"_25639":2320,"_17911":49067,"_5":17806,"_24291":49028,"_2452":46421},[],{"_2926":2338,"_25639":2320,"_17911":49069,"_5":17806,"_24291":49028,"_2452":49070},[],"Active root CA and `ca.pem`",{"_2926":2339,"_25639":2320,"_17911":49072,"_5":17806,"_24291":49028,"_2452":49073},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_2926":2340,"_25639":2320,"_17911":49075,"_5":17806,"_24291":49028,"_2452":49076},[],"End-entity certificate and `device.crt`",{"_2926":2341,"_25639":2320,"_17911":49078,"_5":17806,"_24291":49028,"_2452":49079},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_2926":2342,"_25639":2320,"_17911":49081,"_5":17806,"_24291":49028,"_2452":49082},[],"Private key `device.key`",{"_2926":2343,"_25639":2320,"_17911":49084,"_5":17806,"_24291":49028,"_2452":49085},[],"Its public key matches the one included in `device.crt`.",{"_2926":2344,"_25639":2320,"_17911":49087,"_5":17806,"_24291":49028,"_2452":49088},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_2926":2345,"_25639":2320,"_17911":49090,"_5":17806,"_24291":49031,"_2452":49091},[],"To operate certificates, continue with Certificates and Validation.",{"_2926":2346,"_25639":2320,"_17911":49093,"_5":17806,"_24291":49031,"_2452":49094},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_2926":2347,"_25639":2320,"_17911":49096,"_5":17806,"_24291":49031,"_2452":49097},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_2926":2348,"_25639":2348,"_5":12558,"_2452":49099,"_25983":49100,"_17911":49101,"_24291":2348},"PKI troubleshooting",[41760,43104,46797,45618],[],{"_2926":2349,"_25639":2348,"_17911":49103,"_5":17806,"_24291":2348,"_2452":49104},[],"Diagnose certificate issuance, OCSP and CRL.",{"_2926":2350,"_25639":2348,"_5":25980,"_17911":49106,"_24291":49107,"_2452":49108},[],"/docs/pr-preview/pr-48/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_2926":2351,"_25639":2348,"_5":25980,"_17911":49110,"_24291":49111,"_2452":49112},[],"/docs/pr-preview/pr-48/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_2926":2352,"_25639":2348,"_5":25980,"_17911":49114,"_24291":49115,"_2452":49116},[],"/docs/pr-preview/pr-48/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_2926":2353,"_25639":2348,"_17911":49118,"_5":17806,"_24291":2348,"_2452":49119},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_2926":2354,"_25639":2348,"_17911":49121,"_5":17806,"_24291":2348,"_2452":49122},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_2926":2355,"_25639":2348,"_17911":49124,"_5":17806,"_24291":49107,"_2452":46421},[],{"_2926":2356,"_25639":2348,"_17911":49126,"_5":17806,"_24291":49107,"_2452":49127},[],"What to inspect",{"_2926":2357,"_25639":2348,"_17911":49129,"_5":17806,"_24291":49107,"_2452":41794},[],{"_2926":2358,"_25639":2348,"_17911":49131,"_5":17806,"_24291":49107,"_2452":49132},[],"CA",{"_2926":2359,"_25639":2348,"_17911":49134,"_5":17806,"_24291":49107,"_2452":49135},[],"Exists, is active and has usable dates.",{"_2926":2360,"_25639":2348,"_17911":49137,"_5":17806,"_24291":49107,"_2452":49138},[],"Authorities.",{"_2926":2361,"_25639":2348,"_17911":49140,"_5":17806,"_24291":49107,"_2452":49141},[],"Key",{"_2926":2362,"_25639":2348,"_17911":49143,"_5":17806,"_24291":49107,"_2452":49144},[],"The record has a usable private key and the engine can sign.",{"_2926":2363,"_25639":2348,"_17911":49146,"_5":17806,"_24291":49107,"_2452":49147},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_2926":2364,"_25639":2348,"_17911":49149,"_5":17806,"_24291":49107,"_2452":49150},[],"CSR",{"_2926":2365,"_25639":2348,"_17911":49152,"_5":17806,"_24291":49107,"_2452":49153},[],"Correct PEM and verifiable signature.",{"_2926":2366,"_25639":2348,"_17911":49155,"_5":17806,"_24291":49107,"_2452":49156},[],"`openssl req -in request.csr -noout -verify -text`.",{"_2926":2367,"_25639":2348,"_17911":49158,"_5":17806,"_24291":49107,"_2452":49159},[],"Profile",{"_2926":2368,"_25639":2348,"_17911":49161,"_5":17806,"_24291":49107,"_2452":49162},[],"Selected source, existing ID, allowed algorithm and size.",{"_2926":2369,"_25639":2348,"_17911":49164,"_5":17806,"_24291":49107,"_2452":49165},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_2926":2370,"_25639":2348,"_17911":49167,"_5":17806,"_24291":49107,"_2452":46574},[],{"_2926":2371,"_25639":2348,"_17911":49169,"_5":17806,"_24291":49107,"_2452":49170},[],"Appropriate subject, SAN, usages and dates.",{"_2926":2372,"_25639":2348,"_17911":49172,"_5":17806,"_24291":49107,"_2452":49173},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_2926":2373,"_25639":2348,"_17911":49175,"_5":17806,"_24291":49107,"_2452":49176},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_2926":2374,"_25639":2348,"_17911":49178,"_5":17806,"_24291":49107,"_2452":49179},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_2926":2375,"_25639":2348,"_17911":49181,"_5":17806,"_24291":49111,"_2452":49182},[],"Check each boundary independently:",{"_2926":2376,"_25639":2348,"_17911":49184,"_5":17806,"_24291":49111,"_2452":49185},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_2926":2377,"_25639":2348,"_17911":49187,"_5":17806,"_24291":49111,"_2452":49188},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_2926":2378,"_25639":2348,"_17911":49190,"_5":17806,"_24291":49111,"_2452":49191},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_2926":2379,"_25639":2348,"_17911":49193,"_5":17806,"_24291":49111,"_2452":49194},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_2926":2380,"_25639":2348,"_17911":49196,"_5":17806,"_24291":49111,"_2452":49197},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_2926":2381,"_25639":2348,"_17911":49199,"_5":17806,"_24291":49111,"_2452":49200},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_2926":2382,"_25639":2348,"_17911":49202,"_5":17806,"_24291":49115,"_2452":49203},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_2926":2383,"_25639":2348,"_17911":49205,"_5":17806,"_24291":49115,"_2452":49206},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_2926":2384,"_25639":2384,"_5":12558,"_2452":49208,"_25983":49209,"_17911":49211,"_24291":2384},"3.8.0 to 4.0.0",[41760,49210],"Upgrades",[],{"_2926":2385,"_25639":2384,"_17911":49213,"_5":17806,"_24291":2384,"_2452":49214},[],"4.0.0 changes that affect DMS configuration, what can break after upgrading from 3.8.0, and how to verify it.",{"_2926":2386,"_25639":2384,"_5":25980,"_17911":49216,"_24291":49217,"_2452":49218},[],"/docs/pr-preview/pr-48/upgrades/3-8-0-to-4-0-0#summary","Summary",{"_2926":2387,"_25639":2384,"_5":25980,"_17911":49220,"_24291":49221,"_2452":49222},[],"/docs/pr-preview/pr-48/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_2926":2388,"_25639":2384,"_5":25980,"_17911":49224,"_24291":49225,"_2452":49226},[],"/docs/pr-preview/pr-48/upgrades/3-8-0-to-4-0-0#webhooks-with-file-references","Webhooks with file references",{"_2926":2389,"_25639":2384,"_5":25980,"_17911":49228,"_24291":49229,"_2452":49230},[],"/docs/pr-preview/pr-48/upgrades/3-8-0-to-4-0-0#receiver-certificate-verification","Receiver certificate verification",{"_2926":2390,"_25639":2384,"_5":25980,"_17911":49232,"_24291":49233,"_2452":49234},[],"/docs/pr-preview/pr-48/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_2926":2391,"_25639":2384,"_5":25980,"_17911":49236,"_24291":49237,"_2452":49238},[],"/docs/pr-preview/pr-48/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_2926":2392,"_25639":2384,"_5":25980,"_17911":49240,"_24291":49241,"_2452":49242},[],"/docs/pr-preview/pr-48/upgrades/3-8-0-to-4-0-0#verification-checklist","Verification checklist",{"_2926":2393,"_25639":2384,"_17911":49244,"_5":17806,"_24291":2384,"_2452":49245},[],"Upgrading from 3.8.0 to 4.0.0 automatically migrates stored DMS configuration. Most of it converts without intervention, but three changes can leave enrollments failing or configs holding unexpected values if they are not reviewed. This page states what changes, what symptoms to expect and what to do in each case. Current behavior of each feature is documented in the DMS pages.",{"_2926":2394,"_25639":2384,"_17911":49247,"_5":17806,"_24291":49217,"_2452":49248},[],"Change",{"_2926":2395,"_25639":2384,"_17911":49250,"_5":17806,"_24291":49217,"_2452":49251},[],"Who is affected",{"_2926":2396,"_25639":2384,"_17911":49253,"_5":17806,"_24291":49217,"_2452":49254},[],"Severity",{"_2926":2397,"_25639":2384,"_17911":49256,"_5":17806,"_24291":49217,"_2452":49257},[],"Action",{"_2926":2398,"_25639":2384,"_17911":49259,"_5":17806,"_24291":49217,"_2452":49226},[],{"_2926":2399,"_25639":2384,"_17911":49261,"_5":17806,"_24291":49217,"_2452":49262},[],"DMSs with a webhook whose mTLS certificate or key were file paths",{"_2926":2400,"_25639":2384,"_17911":49264,"_5":17806,"_24291":49217,"_2452":49265},[],"High: enrollments and re-enrollments calling the webhook fail",{"_2926":2401,"_25639":2384,"_17911":49267,"_5":17806,"_24291":49217,"_2452":49268},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_2926":2402,"_25639":2384,"_17911":49270,"_5":17806,"_24291":49217,"_2452":49230},[],{"_2926":2403,"_25639":2384,"_17911":49272,"_5":17806,"_24291":49217,"_2452":49273},[],"DMSs with a webhook that had `validate_server_cert: false`",{"_2926":2404,"_25639":2384,"_17911":49275,"_5":17806,"_24291":49217,"_2452":49276},[],"Medium: webhook credentials are sent to an unverified receiver",{"_2926":2405,"_25639":2384,"_17911":49278,"_5":17806,"_24291":49217,"_2452":49279},[],"Set `insecure_skip_verify` to `false`",{"_2926":2406,"_25639":2384,"_17911":49281,"_5":17806,"_24291":49217,"_2452":49234},[],{"_2926":2407,"_25639":2384,"_17911":49283,"_5":17806,"_24291":49217,"_2452":49284},[],"Scripts and consoles that edit DMSs through the API",{"_2926":2408,"_25639":2384,"_17911":49286,"_5":17806,"_24291":49217,"_2452":49287},[],"Medium: an edit in the old layout silently empties `validation_cas`",{"_2926":2409,"_25639":2384,"_17911":49289,"_5":17806,"_24291":49217,"_2452":49290},[],"Read the DMS before editing and use the new field",{"_2926":2410,"_25639":2384,"_17911":49292,"_5":17806,"_24291":49217,"_2452":49238},[],{"_2926":2411,"_25639":2384,"_17911":49294,"_5":17806,"_24291":49217,"_2452":49295},[],"Any DMS",{"_2926":2412,"_25639":2384,"_17911":49297,"_5":17806,"_24291":49217,"_2452":49298},[],"Low: informational",{"_2926":2413,"_25639":2384,"_17911":49300,"_5":17806,"_24291":49217,"_2452":49301},[],"Read both blocks before editing",{"_2926":2414,"_25639":2384,"_17911":49303,"_5":17806,"_24291":49217,"_2452":49304},[],"A verification checklist at the end confirms the result.",{"_2926":2415,"_25639":2384,"_17911":49306,"_5":17806,"_24291":49221,"_2452":49307},[],"Stored webhook configs are rewritten to the current layout. Fields are renamed as follows:",{"_2926":2416,"_25639":2384,"_17911":49309,"_5":17806,"_24291":49221,"_2452":49310},[],"Field in 3.8.0",{"_2926":2417,"_25639":2384,"_17911":49312,"_5":17806,"_24291":49221,"_2452":49313},[],"Field in 4.0.0",{"_2926":2418,"_25639":2384,"_17911":49315,"_5":17806,"_24291":49221,"_2452":49316},[],"`validate_server_cert`",{"_2926":2419,"_25639":2384,"_17911":49318,"_5":17806,"_24291":49221,"_2452":49319},[],"`insecure_skip_verify` (value negated)",{"_2926":2420,"_25639":2384,"_17911":49321,"_5":17806,"_24291":49221,"_2452":49322},[],"`oidc`",{"_2926":2421,"_25639":2384,"_17911":49324,"_5":17806,"_24291":49221,"_2452":49325},[],"`jwt_options`",{"_2926":2422,"_25639":2384,"_17911":49327,"_5":17806,"_24291":49221,"_2452":49328},[],"`apikey`",{"_2926":2423,"_25639":2384,"_17911":49330,"_5":17806,"_24291":49221,"_2452":49331},[],"`apikey_options`",{"_2926":2424,"_25639":2384,"_17911":49333,"_5":17806,"_24291":49221,"_2452":49334},[],"`mtls`",{"_2926":2425,"_25639":2384,"_17911":49336,"_5":17806,"_24291":49221,"_2452":49337},[],"`mtls_options`",{"_2926":2426,"_25639":2384,"_17911":49339,"_5":17806,"_24291":49221,"_2452":49340},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. The two cases below do need it.",{"_2926":2427,"_25639":2384,"_17911":49342,"_5":17806,"_24291":49225,"_2452":49343},[],"A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields, and does so on every call, whatever the configured authentication mode. As a result, every enroll and re-enroll that calls that webhook fails until the config is fixed.",{"_2926":2428,"_25639":2384,"_17911":49345,"_5":17806,"_24291":49225,"_2452":49346},[],"There are two ways to fix it, depending on the webhook:",{"_2926":2429,"_25639":2384,"_17911":49348,"_5":17806,"_24291":49225,"_2452":49349},[],"If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM.",{"_2926":2430,"_25639":2384,"_17911":49351,"_5":17806,"_24291":49225,"_2452":49352},[],"If the webhook does not use mTLS, remove the leftover file fields.",{"_2926":2431,"_25639":2384,"_17911":49354,"_5":17806,"_24291":49225,"_2452":49355},[],"Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`).",{"_2926":2432,"_25639":2384,"_17911":49357,"_5":17806,"_24291":49225,"_2452":49358},[],"A variant of the same problem exists: if the stored config holds file paths inside `mtls_options.cert_content` or `mtls_options.key_content`, every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fails validation. Settings are replaced wholesale, so the stored config must be resent with the certificate and key as PEM.",{"_2926":2433,"_25639":2384,"_17911":49360,"_5":17806,"_24291":49229,"_2452":49361},[],"A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`. Receiver certificate verification therefore stays skipped until that field is set to `false`.",{"_2926":2434,"_25639":2384,"_17911":49363,"_5":17806,"_24291":49229,"_2452":49364},[],"It should be corrected on every migrated config. The webhook authorization channel carries the API key or bearer token, so skipping verification exposes those credentials to a network-positioned attacker. Keeping `insecure_skip_verify: true` is only justified when the receiver certificate is deliberately unverifiable.",{"_2926":2435,"_25639":2384,"_17911":49366,"_5":17806,"_24291":49233,"_2452":49367},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`.",{"_2926":2436,"_25639":2384,"_17911":49369,"_5":17806,"_24291":49233,"_2452":49370},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_2926":2437,"_25639":2384,"_17911":49372,"_5":17806,"_24291":49233,"_2452":49373},[],"What does change is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently ignored because unknown JSON fields are dropped, and GET responses no longer include it. Consequently, an update body built from the old layout empties `validation_cas` without returning any error. To avoid it, always read the DMS before sending an edit and reuse the layout the API returns.",{"_2926":2438,"_25639":2384,"_17911":49375,"_5":17806,"_24291":49237,"_2452":49376},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but both blocks should be read before editing a DMS so that one is not modified while believing the other is being edited.",{"_2926":2439,"_25639":2384,"_17911":49378,"_5":17806,"_24291":49237,"_2452":49379},[],"If the console version does not expose independent settings, they can be edited through the DMS API.",{"_2926":2440,"_25639":2384,"_17911":49381,"_5":17806,"_24291":49241,"_2452":49382},[],"After applying the upgrade, check in this order:",{"_2926":2441,"_25639":2384,"_17911":49384,"_5":17806,"_24291":49241,"_2452":49385},[],"**Webhooks without file fields.** List the DMSs that use a webhook for enrollment or re-enrollment and confirm each `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_2926":2442,"_25639":2384,"_17911":49387,"_5":17806,"_24291":49241,"_2452":49388},[],"**Receiver verification.** Confirm `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_2926":2443,"_25639":2384,"_17911":49390,"_5":17806,"_24291":49241,"_2452":49391},[],"**Delivery.** Trigger, or wait for, one enroll or re-enroll through each migrated webhook and confirm the authorization call completes.",{"_2926":2444,"_25639":2384,"_17911":49393,"_5":17806,"_24291":49241,"_2452":49394},[],"**Trust set.** Read `est_rfc7030_settings.client_certificate_settings.validation_cas` and confirm it holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_2926":2445,"_25639":2384,"_17911":49396,"_5":17806,"_24291":49241,"_2452":49397},[],"**API clients.** Update any script or console that uses the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), since they silently drop those values.",{"_2926":2446,"_25639":2384,"_17911":49399,"_5":17806,"_24291":49241,"_2452":46091},[],{"_2926":2447,"_25639":2384,"_17911":49401,"_5":17806,"_24291":49241,"_2452":49402},[],"<Card title=\"DMS API\" href=\"/docs/api-reference/dms-manager\" />","count","sorting",{"_49406":49407,"_49408":49409,"_49410":49411,"_49412":49413,"_15557":2474,"_59159":2474},"language","english","sortableProperties",[2452,25639,5,24291],"sortablePropertiesWithTypes",{"_2452":21377,"_25639":21377,"_5":21377,"_24291":21377},"sorts",{"_2452":49414,"_25639":51851,"_5":54287,"_24291":56723},{"_3912":49415,"_49416":49417,"_5":21377},{"_12298":5511,"_12657":4095,"_12664":5808,"_24854":5944,"_24416":2817,"_17011":4295,"_12319":2796,"_12326":6576,"_24816":3999,"_25177":23602,"_25198":6027,"_24829":3526,"_29535":6020,"_25209":7997,"_29540":25363,"_29543":4925,"_29546":6382,"_29549":4098,"_29552":2699,"_25510":14242,"_29557":3821,"_29559":4999,"_25540":2691,"_25500":5816,"_29563":2779,"_29566":3398,"_29568":8853,"_25227":24782,"_25505":14863,"_25558":4358,"_29573":12862,"_29575":13788,"_29577":4004,"_29579":4351,"_29581":4535,"_29583":6343,"_29585":6371,"_29587":3920,"_29589":2600,"_24867":6285,"_29592":4471,"_29594":2786,"_24861":21440,"_29597":3211,"_29599":6329,"_29601":2612,"_29604":2855,"_24897":2810,"_29608":4121,"_24807":13581,"_29611":8924,"_24834":6403,"_29614":3458,"_29616":4326,"_29619":2830,"_25535":4985,"_29622":2861,"_29624":4884,"_29627":9545,"_29629":4302,"_29631":3727,"_29633":5547,"_29635":6432,"_17014":9429,"_29638":4870,"_29640":4285,"_29642":2616,"_25221":4249,"_29645":5000,"_29647":11773,"_29649":2724,"_29651":4105,