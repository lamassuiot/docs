 acceso de red",{"_2926":59173,"_25639":59166,"_5":25980,"_17911":98164,"_24291":98165,"_2452":98166},[],"/docs/pr-preview/pr-48/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_2926":59174,"_25639":59166,"_5":25980,"_17911":98168,"_24291":98169,"_2452":98170},[],"/docs/pr-preview/pr-48/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_2926":59175,"_25639":59166,"_17911":98172,"_5":17806,"_24291":59166,"_2452":98173},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_2926":59176,"_25639":59166,"_17911":98175,"_5":17806,"_24291":98145,"_2452":98176},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_2926":59177,"_25639":59166,"_17911":98178,"_5":17806,"_24291":98145,"_2452":98179},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_2926":59178,"_25639":59166,"_17911":98181,"_5":17806,"_24291":98145,"_2452":98182},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_2926":59179,"_25639":59166,"_17911":98184,"_5":17806,"_24291":98149,"_2452":98185},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_2926":59180,"_25639":59166,"_17911":98187,"_5":17806,"_24291":98149,"_2452":98188},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_2926":59181,"_25639":59166,"_17911":98190,"_5":17806,"_24291":98149,"_2452":98191},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_2926":59182,"_25639":59166,"_17911":98193,"_5":17806,"_24291":98153,"_2452":98194},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_2926":59183,"_25639":59166,"_17911":98196,"_5":17806,"_24291":98157,"_2452":98197},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_2926":59184,"_25639":59166,"_17911":98199,"_5":17806,"_24291":98161,"_2452":98200},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_2926":59185,"_25639":59166,"_17911":98202,"_5":17806,"_24291":98165,"_2452":98203},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_2926":59186,"_25639":59166,"_17911":98205,"_5":17806,"_24291":98169,"_2452":98206},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_2926":59187,"_25639":59187,"_5":12558,"_2452":98208,"_25983":98209,"_17911":98210,"_24291":59187},"Despliega Lamassu",[41760,98137],[],{"_2926":59188,"_25639":59187,"_17911":98212,"_5":17806,"_24291":59187,"_2452":98213},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_2926":59189,"_25639":59187,"_5":25980,"_17911":98215,"_24291":98216,"_2452":98217},[],"/docs/pr-preview/pr-48/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_2926":59190,"_25639":59187,"_5":25980,"_17911":98219,"_24291":98220,"_2452":98221},[],"/docs/pr-preview/pr-48/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_2926":59191,"_25639":59187,"_5":25980,"_17911":98223,"_24291":98224,"_2452":98225},[],"/docs/pr-preview/pr-48/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_2926":59192,"_25639":59187,"_17911":98227,"_5":17806,"_24291":59187,"_2452":98228},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_2926":59193,"_25639":59187,"_17911":98230,"_5":17806,"_24291":98216,"_2452":98231},[],"Modelo",{"_2926":59194,"_25639":59187,"_17911":98233,"_5":17806,"_24291":98216,"_2452":98234},[],"Recomendado para",{"_2926":59195,"_25639":59187,"_17911":98236,"_5":17806,"_24291":98216,"_2452":98237},[],"Quién opera la infraestructura",{"_2926":59196,"_25639":59187,"_17911":98239,"_5":17806,"_24291":98216,"_2452":98240},[],"Punto de partida",{"_2926":59197,"_25639":59187,"_17911":98242,"_5":17806,"_24291":98216,"_2452":41867},[],{"_2926":59198,"_25639":59187,"_17911":98244,"_5":17806,"_24291":98216,"_2452":98245},[],"Producción, entornos regulados y despliegues personalizados",{"_2926":59199,"_25639":59187,"_17911":98247,"_5":17806,"_24291":98216,"_2452":98248},[],"Tu equipo",{"_2926":59200,"_25639":59187,"_17911":98250,"_5":17806,"_24291":98216,"_2452":98251},[],"Helm o Fastlane",{"_2926":59201,"_25639":59187,"_17911":98253,"_5":17806,"_24291":98216,"_2452":41879},[],{"_2926":59202,"_25639":59187,"_17911":98255,"_5":17806,"_24291":98216,"_2452":98256},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_2926":59203,"_25639":59187,"_17911":98258,"_5":17806,"_24291":98216,"_2452":98248},[],{"_2926":59204,"_25639":59187,"_17911":98260,"_5":17806,"_24291":98216,"_2452":98261},[],"Imagen preconfigurada en EC2",{"_2926":59205,"_25639":59187,"_17911":98263,"_5":17806,"_24291":98216,"_2452":41890},[],{"_2926":59206,"_25639":59187,"_17911":98265,"_5":17806,"_24291":98216,"_2452":98266},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_2926":59207,"_25639":59187,"_17911":98268,"_5":17806,"_24291":98216,"_2452":41896},[],{"_2926":59208,"_25639":59187,"_17911":98270,"_5":17806,"_24291":98216,"_2452":98271},[],"Suscripción gestionada",{"_2926":59209,"_25639":59187,"_17911":98273,"_5":17806,"_24291":98216,"_2452":98274},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2926":59210,"_25639":59187,"_17911":98276,"_5":17806,"_24291":98216,"_2452":98277},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2926":59211,"_25639":59187,"_17911":98279,"_5":17806,"_24291":98216,"_2452":98280},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_2926":59212,"_25639":59187,"_17911":98282,"_5":17806,"_24291":98220,"_2452":98283},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_2926":59213,"_25639":59187,"_17911":98285,"_5":17806,"_24291":98224,"_2452":98286},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_2926":59214,"_25639":59214,"_5":12558,"_2452":98288,"_25983":98289,"_17911":98290,"_24291":59214},"Utiliza Lamassu como SaaS",[41760,98137,98138],[],{"_2926":59215,"_25639":59214,"_17911":98292,"_5":17806,"_24291":59214,"_2452":98293},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_2926":59216,"_25639":59214,"_5":25980,"_17911":98295,"_24291":98296,"_2452":98297},[],"/docs/pr-preview/pr-48/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_2926":59217,"_25639":59214,"_5":25980,"_17911":98299,"_24291":98300,"_2452":98301},[],"/docs/pr-preview/pr-48/es/deployment/saas#planes","Planes",{"_2926":59218,"_25639":59214,"_5":25980,"_17911":98303,"_24291":98304,"_2452":98305},[],"/docs/pr-preview/pr-48/es/deployment/saas#solicita-acceso","Solicita acceso",{"_2926":59219,"_25639":59214,"_17911":98307,"_5":17806,"_24291":59214,"_2452":98308},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_2926":59220,"_25639":59214,"_17911":98310,"_5":17806,"_24291":98296,"_2452":98311},[],"Disponibilidad y mantenimiento de la plataforma.",{"_2926":59221,"_25639":59214,"_17911":98313,"_5":17806,"_24291":98296,"_2452":98314},[],"Copias de seguridad automáticas.",{"_2926":59222,"_25639":59214,"_17911":98316,"_5":17806,"_24291":98296,"_2452":98317},[],"Actualizaciones de versión.",{"_2926":59223,"_25639":59214,"_17911":98319,"_5":17806,"_24291":98296,"_2452":98320},[],"Soporte técnico y SLA según el plan contratado.",{"_2926":59224,"_25639":59214,"_17911":98322,"_5":17806,"_24291":98300,"_2452":41951},[],{"_2926":59225,"_25639":59214,"_17911":98324,"_5":17806,"_24291":98300,"_2452":98325},[],"Dispositivos",{"_2926":59226,"_25639":59214,"_17911":98327,"_5":17806,"_24291":98300,"_2452":98328},[],"Soporte",{"_2926":59227,"_25639":59214,"_17911":98330,"_5":17806,"_24291":98300,"_2452":41960},[],{"_2926":59228,"_25639":59214,"_17911":98332,"_5":17806,"_24291":98300,"_2452":41963},[],{"_2926":59229,"_25639":59214,"_17911":98334,"_5":17806,"_24291":98300,"_2452":98335},[],"Hasta 1.000",{"_2926":59230,"_25639":59214,"_17911":98337,"_5":17806,"_24291":98300,"_2452":41969},[],{"_2926":59231,"_25639":59214,"_17911":98339,"_5":17806,"_24291":98300,"_2452":98340},[],"99,5 %",{"_2926":59232,"_25639":59214,"_17911":98342,"_5":17806,"_24291":98300,"_2452":41975},[],{"_2926":59233,"_25639":59214,"_17911":98344,"_5":17806,"_24291":98300,"_2452":98345},[],"Hasta 10.000",{"_2926":59234,"_25639":59214,"_17911":98347,"_5":17806,"_24291":98300,"_2452":98348},[],"Email y chat",{"_2926":59235,"_25639":59214,"_17911":98350,"_5":17806,"_24291":98300,"_2452":98351},[],"99,9 %",{"_2926":59236,"_25639":59214,"_17911":98353,"_5":17806,"_24291":98300,"_2452":41987},[],{"_2926":59237,"_25639":59214,"_17911":98355,"_5":17806,"_24291":98300,"_2452":98356},[],"Ilimitados",{"_2926":59238,"_25639":59214,"_17911":98358,"_5":17806,"_24291":98300,"_2452":98359},[],"Dedicado",{"_2926":59239,"_25639":59214,"_17911":98361,"_5":17806,"_24291":98300,"_2452":98362},[],"99,99 %",{"_2926":59240,"_25639":59214,"_17911":98364,"_5":17806,"_24291":98304,"_2452":98365},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_2926":59241,"_25639":59214,"_17911":98367,"_5":17806,"_24291":98304,"_2452":98368},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_2926":59242,"_25639":59242,"_5":12558,"_2452":42004,"_25983":98370,"_17911":98372,"_24291":59242},[41760,98137,98371],"Kubernetes autogestionado",[],{"_2926":59243,"_25639":59242,"_17911":98374,"_5":17806,"_24291":59242,"_2452":98375},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_2926":59244,"_25639":59242,"_5":25980,"_17911":98377,"_24291":98378,"_2452":98379},[],"/docs/pr-preview/pr-48/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_2926":59245,"_25639":59242,"_5":25980,"_17911":98381,"_24291":98382,"_2452":98383},[],"/docs/pr-preview/pr-48/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_2926":59246,"_25639":59242,"_5":25980,"_17911":98385,"_24291":98386,"_2452":98387},[],"/docs/pr-preview/pr-48/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_2926":59247,"_25639":59242,"_5":25980,"_17911":98389,"_24291":98390,"_2452":98391},[],"/docs/pr-preview/pr-48/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_2926":59248,"_25639":59242,"_5":25980,"_17911":98393,"_24291":98394,"_2452":98395},[],"/docs/pr-preview/pr-48/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_2926":59249,"_25639":59242,"_5":25980,"_17911":98397,"_24291":98398,"_2452":98399},[],"/docs/pr-preview/pr-48/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_2926":59250,"_25639":59242,"_5":25980,"_17911":98401,"_24291":98402,"_2452":98403},[],"/docs/pr-preview/pr-48/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_2926":59251,"_25639":59242,"_5":25980,"_17911":98405,"_24291":98406,"_2452":98407},[],"/docs/pr-preview/pr-48/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_2926":59252,"_25639":59242,"_5":25980,"_17911":98409,"_24291":98410,"_2452":98411},[],"/docs/pr-preview/pr-48/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_2926":59253,"_25639":59242,"_5":25980,"_17911":98413,"_24291":98414,"_2452":98415},[],"/docs/pr-preview/pr-48/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_2926":59254,"_25639":59242,"_17911":98417,"_5":17806,"_24291":98378,"_2452":98418},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_2926":59255,"_25639":59242,"_17911":98420,"_5":17806,"_24291":98378,"_2452":98421},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_2926":59256,"_25639":59242,"_17911":98423,"_5":17806,"_24291":98382,"_2452":98424},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_2926":59257,"_25639":59242,"_17911":98426,"_5":17806,"_24291":98382,"_2452":98427},[],"Fastlane instala o configura",{"_2926":59258,"_25639":59242,"_17911":98429,"_5":17806,"_24291":98382,"_2452":98430},[],"Tú sigues proporcionando",{"_2926":59259,"_25639":59242,"_17911":98432,"_5":17806,"_24291":98382,"_2452":98433},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_2926":59260,"_25639":59242,"_17911":98435,"_5":17806,"_24291":98382,"_2452":98436},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_2926":59261,"_25639":59242,"_17911":98438,"_5":17806,"_24291":98382,"_2452":98439},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_2926":59262,"_25639":59242,"_17911":98441,"_5":17806,"_24291":98382,"_2452":98442},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_2926":59263,"_25639":59242,"_17911":98444,"_5":17806,"_24291":98382,"_2452":98445},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_2926":59264,"_25639":59242,"_17911":98447,"_5":17806,"_24291":98382,"_2452":98448},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_2926":59265,"_25639":59242,"_17911":98450,"_5":17806,"_24291":98382,"_2452":98451},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_2926":59266,"_25639":59242,"_17911":98453,"_5":17806,"_24291":98382,"_2452":98454},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_2926":59267,"_25639":59242,"_17911":98456,"_5":17806,"_24291":98382,"_2452":98457},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_2926":59268,"_25639":59242,"_17911":98459,"_5":17806,"_24291":98386,"_2452":98460},[],"Necesitas:",{"_2926":59269,"_25639":59242,"_17911":98462,"_5":17806,"_24291":98386,"_2452":98463},[],"un clúster Kubernetes existente",{"_2926":59270,"_25639":59242,"_17911":98465,"_5":17806,"_24291":98386,"_2452":98466},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_2926":59271,"_25639":59242,"_17911":98468,"_5":17806,"_24291":98386,"_2452":42102},[],{"_2926":59272,"_25639":59242,"_17911":98470,"_5":17806,"_24291":98386,"_2452":20264},[],{"_2926":59273,"_25639":59242,"_17911":98472,"_5":17806,"_24291":98386,"_2452":98473},[],"`jq` solo si usas `--sample-data`",{"_2926":59274,"_25639":59242,"_17911":98475,"_5":17806,"_24291":98386,"_2452":98476},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_2926":59275,"_25639":59242,"_17911":98478,"_5":17806,"_24291":98386,"_2452":98479},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_2926":59276,"_25639":59242,"_17911":98481,"_5":17806,"_24291":98386,"_2452":98482},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_2926":59277,"_25639":59242,"_17911":98484,"_5":17806,"_24291":98390,"_2452":98485},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_2926":59278,"_25639":59242,"_17911":98487,"_5":17806,"_24291":98390,"_2452":98488},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_2926":59279,"_25639":59242,"_17911":98490,"_5":17806,"_24291":98394,"_2452":98491},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_2926":59280,"_25639":59242,"_17911":98493,"_5":17806,"_24291":98394,"_2452":98494},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_2926":59281,"_25639":59242,"_17911":98496,"_5":17806,"_24291":98394,"_2452":98497},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_2926":59282,"_25639":59242,"_17911":98499,"_5":17806,"_24291":98394,"_2452":98500},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_2926":59283,"_25639":59242,"_17911":98502,"_5":17806,"_24291":98398,"_2452":98503},[],"Opción",{"_2926":59284,"_25639":59242,"_17911":98505,"_5":17806,"_24291":98398,"_2452":98506},[],"Valor predeterminado",{"_2926":59285,"_25639":59242,"_17911":98508,"_5":17806,"_24291":98398,"_2452":98509},[],"Propósito",{"_2926":59286,"_25639":59242,"_17911":98511,"_5":17806,"_24291":98398,"_2452":42146},[],{"_2926":59287,"_25639":59242,"_17911":98513,"_5":17806,"_24291":98398,"_2452":42149},[],{"_2926":59288,"_25639":59242,"_17911":98515,"_5":17806,"_24291":98398,"_2452":98516},[],"Muestra la ayuda",{"_2926":59289,"_25639":59242,"_17911":98518,"_5":17806,"_24291":98398,"_2452":42155},[],{"_2926":59290,"_25639":59242,"_17911":98520,"_5":17806,"_24291":98398,"_2452":98521},[],"contexto actual",{"_2926":59291,"_25639":59242,"_17911":98523,"_5":17806,"_24291":98398,"_2452":98524},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_2926":59292,"_25639":59242,"_17911":98526,"_5":17806,"_24291":98398,"_2452":42164},[],{"_2926":59293,"_25639":59242,"_17911":98528,"_5":17806,"_24291":98398,"_2452":5464},[],{"_2926":59294,"_25639":59242,"_17911":98530,"_5":17806,"_24291":98398,"_2452":98531},[],"Omite prompts y genera credenciales para las dependencias",{"_2926":59295,"_25639":59242,"_17911":98533,"_5":17806,"_24291":98398,"_2452":42172},[],{"_2926":59296,"_25639":59242,"_17911":98535,"_5":17806,"_24291":98398,"_2452":42175},[],{"_2926":59297,"_25639":59242,"_17911":98537,"_5":17806,"_24291":98398,"_2452":98538},[],"Namespace de la instalación",{"_2926":59298,"_25639":59242,"_17911":98540,"_5":17806,"_24291":98398,"_2452":42181},[],{"_2926":59299,"_25639":59242,"_17911":98542,"_5":17806,"_24291":98398,"_2452":42184},[],{"_2926":59300,"_25639":59242,"_17911":98544,"_5":17806,"_24291":98398,"_2452":98545},[],"Dominio usado por la UI, OIDC y el certificado",{"_2926":59301,"_25639":59242,"_17911":98547,"_5":17806,"_24291":98398,"_2452":42190},[],{"_2926":59302,"_25639":59242,"_17911":98549,"_5":17806,"_24291":98398,"_2452":12795},[],{"_2926":59303,"_25639":59242,"_17911":98551,"_5":17806,"_24291":98398,"_2452":98552},[],"Versión del chart de Lamassu",{"_2926":59304,"_25639":59242,"_17911":98554,"_5":17806,"_24291":98398,"_2452":42198},[],{"_2926":59305,"_25639":59242,"_17911":98556,"_5":17806,"_24291":98398,"_2452":42201},[],{"_2926":59306,"_25639":59242,"_17911":98558,"_5":17806,"_24291":98398,"_2452":98559},[],"Puerto del listener HTTPS",{"_2926":59307,"_25639":59242,"_17911":98561,"_5":17806,"_24291":98398,"_2452":42207},[],{"_2926":59308,"_25639":59242,"_17911":98563,"_5":17806,"_24291":98398,"_2452":42210},[],{"_2926":59309,"_25639":59242,"_17911":98565,"_5":17806,"_24291":98398,"_2452":98566},[],"Puerto del listener HTTP",{"_2926":59310,"_25639":59242,"_17911":98568,"_5":17806,"_24291":98398,"_2452":42216},[],{"_2926":59311,"_25639":59242,"_17911":98570,"_5":17806,"_24291":98398,"_2452":42149},[],{"_2926":59312,"_25639":59242,"_17911":98572,"_5":17806,"_24291":98398,"_2452":98573},[],"Certificado PEM para TLS downstream",{"_2926":59313,"_25639":59242,"_17911":98575,"_5":17806,"_24291":98398,"_2452":42224},[],{"_2926":59314,"_25639":59242,"_17911":98577,"_5":17806,"_24291":98398,"_2452":42149},[],{"_2926":59315,"_25639":59242,"_17911":98579,"_5":17806,"_24291":98398,"_2452":98580},[],"Clave privada PEM para TLS downstream",{"_2926":59316,"_25639":59242,"_17911":98582,"_5":17806,"_24291":98398,"_2452":42232},[],{"_2926":59317,"_25639":59242,"_17911":98584,"_5":17806,"_24291":98398,"_2452":98585},[],"chart del repositorio",{"_2926":59318,"_25639":59242,"_17911":98587,"_5":17806,"_24291":98398,"_2452":98588},[],"Usa un chart local de Lamassu sin empaquetar",{"_2926":59319,"_25639":59242,"_17911":98590,"_5":17806,"_24291":98398,"_2452":42241},[],{"_2926":59320,"_25639":59242,"_17911":98592,"_5":17806,"_24291":98398,"_2452":98593},[],"detección automática",{"_2926":59321,"_25639":59242,"_17911":98595,"_5":17806,"_24291":98398,"_2452":98596},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_2926":59322,"_25639":59242,"_17911":98598,"_5":17806,"_24291":98398,"_2452":42249},[],{"_2926":59323,"_25639":59242,"_17911":98600,"_5":17806,"_24291":98398,"_2452":5464},[],{"_2926":59324,"_25639":59242,"_17911":98602,"_5":17806,"_24291":98398,"_2452":98603},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_2926":59325,"_25639":59242,"_17911":98605,"_5":17806,"_24291":98398,"_2452":42257},[],{"_2926":59326,"_25639":59242,"_17911":98607,"_5":17806,"_24291":98398,"_2452":5464},[],{"_2926":59327,"_25639":59242,"_17911":98609,"_5":17806,"_24291":98398,"_2452":98610},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_2926":59328,"_25639":59242,"_17911":98612,"_5":17806,"_24291":98398,"_2452":42265},[],{"_2926":59329,"_25639":59242,"_17911":98614,"_5":17806,"_24291":98398,"_2452":5464},[],{"_2926":59330,"_25639":59242,"_17911":98616,"_5":17806,"_24291":98398,"_2452":98617},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_2926":59331,"_25639":59242,"_17911":98619,"_5":17806,"_24291":98398,"_2452":42273},[],{"_2926":59332,"_25639":59242,"_17911":98621,"_5":17806,"_24291":98398,"_2452":42276},[],{"_2926":59333,"_25639":59242,"_17911":98623,"_5":17806,"_24291":98398,"_2452":98624},[],"Usa otro chart local de SoftHSM",{"_2926":59334,"_25639":59242,"_17911":98626,"_5":17806,"_24291":98398,"_2452":98627},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_2926":59335,"_25639":59242,"_17911":98629,"_5":17806,"_24291":98402,"_2452":42285},[],{"_2926":59336,"_25639":59242,"_17911":98631,"_5":17806,"_24291":98402,"_2452":98632},[],"valida las herramientas locales y el clúster seleccionado",{"_2926":59337,"_25639":59242,"_17911":98634,"_5":17806,"_24291":98402,"_2452":98635},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_2926":59338,"_25639":59242,"_17911":98637,"_5":17806,"_24291":98402,"_2452":98638},[],"crea el namespace",{"_2926":59339,"_25639":59242,"_17911":98640,"_5":17806,"_24291":98402,"_2452":98641},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_2926":59340,"_25639":59242,"_17911":98643,"_5":17806,"_24291":98402,"_2452":98644},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_2926":59341,"_25639":59242,"_17911":98646,"_5":17806,"_24291":98402,"_2452":98647},[],"instala RabbitMQ",{"_2926":59342,"_25639":59242,"_17911":98649,"_5":17806,"_24291":98402,"_2452":98650},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_2926":59343,"_25639":59242,"_17911":98652,"_5":17806,"_24291":98402,"_2452":98653},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_2926":59344,"_25639":59242,"_17911":98655,"_5":17806,"_24291":98402,"_2452":98656},[],"carga datos de ejemplo opcionalmente",{"_2926":59345,"_25639":59242,"_17911":98658,"_5":17806,"_24291":98402,"_2452":98659},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_2926":59346,"_25639":59242,"_17911":98661,"_5":17806,"_24291":98406,"_2452":98662},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_2926":59347,"_25639":59242,"_17911":98664,"_5":17806,"_24291":98406,"_2452":98665},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_2926":59348,"_25639":59242,"_17911":98667,"_5":17806,"_24291":98410,"_2452":98668},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso.",{"_2926":59349,"_25639":59242,"_17911":98670,"_5":17806,"_24291":98410,"_2452":98671},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_2926":59350,"_25639":59242,"_17911":98673,"_5":17806,"_24291":98410,"_2452":98674},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_2926":59351,"_25639":59242,"_17911":98676,"_5":17806,"_24291":98414,"_2452":98677},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_2926":59352,"_25639":59352,"_5":12558,"_2452":98679,"_25983":98680,"_17911":98681,"_24291":59352},"Instala con Helm",[41760,98137,98371],[],{"_2926":59353,"_25639":59352,"_17911":98683,"_5":17806,"_24291":59352,"_2452":98684},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_2926":59354,"_25639":59352,"_5":25980,"_17911":98686,"_24291":98687,"_2452":98688},[],"/docs/pr-preview/pr-48/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_2926":59355,"_25639":59352,"_5":25980,"_17911":98690,"_24291":98691,"_2452":98387},[],"/docs/pr-preview/pr-48/es/deployment/self-hosted/helm#antes-de-comenzar",{"_2926":59356,"_25639":59352,"_5":25980,"_17911":98693,"_24291":98694,"_2452":98695},[],"/docs/pr-preview/pr-48/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_2926":59357,"_25639":59352,"_5":25980,"_17911":98697,"_24291":98698,"_2452":98699},[],"/docs/pr-preview/pr-48/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_2926":59358,"_25639":59352,"_5":25980,"_17911":98701,"_24291":98702,"_2452":98703},[],"/docs/pr-preview/pr-48/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_2926":59359,"_25639":59352,"_5":25980,"_17911":98705,"_24291":98706,"_2452":98707},[],"/docs/pr-preview/pr-48/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_2926":59360,"_25639":59352,"_5":25980,"_17911":98709,"_24291":98710,"_2452":98711},[],"/docs/pr-preview/pr-48/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_2926":59361,"_25639":59352,"_5":25980,"_17911":98713,"_24291":98714,"_2452":98715},[],"/docs/pr-preview/pr-48/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_2926":59362,"_25639":59352,"_5":25980,"_17911":98717,"_24291":98718,"_2452":98719},[],"/docs/pr-preview/pr-48/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_2926":59363,"_25639":59352,"_17911":98721,"_5":17806,"_24291":98687,"_2452":98722},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_2926":59364,"_25639":59352,"_17911":98724,"_5":17806,"_24291":98691,"_2452":98725},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_2926":59365,"_25639":59352,"_17911":98727,"_5":17806,"_24291":98691,"_2452":98728},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_2926":59366,"_25639":59352,"_17911":98730,"_5":17806,"_24291":98691,"_2452":98731},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_2926":59367,"_25639":59352,"_17911":98733,"_5":17806,"_24291":98691,"_2452":98734},[],"un broker RabbitMQ accesible y sus credenciales",{"_2926":59368,"_25639":59352,"_17911":98736,"_5":17806,"_24291":98691,"_2452":98737},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_2926":59369,"_25639":59352,"_17911":98739,"_5":17806,"_24291":98691,"_2452":98740},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_2926":59370,"_25639":59352,"_17911":98742,"_5":17806,"_24291":98691,"_2452":98743},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_2926":59371,"_25639":59352,"_17911":98745,"_5":17806,"_24291":98691,"_2452":98746},[],"una StorageClass y un diseño de tráfico externo",{"_2926":59372,"_25639":59352,"_17911":98748,"_5":17806,"_24291":98691,"_2452":98749},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_2926":59373,"_25639":59352,"_17911":98751,"_5":17806,"_24291":98691,"_2452":98752},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_2926":59374,"_25639":59352,"_17911":98754,"_5":17806,"_24291":98691,"_2452":98755},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_2926":59375,"_25639":59352,"_17911":98757,"_5":17806,"_24291":98694,"_2452":98758},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_2926":59376,"_25639":59352,"_17911":98760,"_5":17806,"_24291":98694,"_2452":98761},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_2926":59377,"_25639":59352,"_17911":98763,"_5":17806,"_24291":98694,"_2452":98764},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_2926":59378,"_25639":59352,"_17911":98766,"_5":17806,"_24291":98698,"_2452":98767},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_2926":59379,"_25639":59352,"_17911":98769,"_5":17806,"_24291":98698,"_2452":98770},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_2926":59380,"_25639":59352,"_17911":98772,"_5":17806,"_24291":98698,"_2452":98773},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_2926":59381,"_25639":59352,"_17911":98775,"_5":17806,"_24291":98702,"_2452":98776},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_2926":59382,"_25639":59352,"_17911":98778,"_5":17806,"_24291":98706,"_2452":98779},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_2926":59383,"_25639":59352,"_17911":98781,"_5":17806,"_24291":98706,"_2452":98782},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_2926":59384,"_25639":59352,"_17911":98784,"_5":17806,"_24291":98706,"_2452":98785},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_2926":59385,"_25639":59352,"_17911":98787,"_5":17806,"_24291":98706,"_2452":98788},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_2926":59386,"_25639":59352,"_17911":98790,"_5":17806,"_24291":98710,"_2452":98791},[],"Para instalar un checkout local:",{"_2926":59387,"_25639":59352,"_17911":98793,"_5":17806,"_24291":98714,"_2452":98794},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_2926":59388,"_25639":59352,"_17911":98796,"_5":17806,"_24291":98714,"_2452":98797},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_2926":59389,"_25639":59352,"_17911":98799,"_5":17806,"_24291":98718,"_2452":98800},[],"Antes de pasar a producción, revisa:",{"_2926":59390,"_25639":59352,"_17911":98802,"_5":17806,"_24291":98718,"_2452":98803},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_2926":59391,"_25639":59352,"_17911":98805,"_5":17806,"_24291":98718,"_2452":98806},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_2926":59392,"_25639":59352,"_17911":98808,"_5":17806,"_24291":98718,"_2452":98809},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_2926":59393,"_25639":59352,"_17911":98811,"_5":17806,"_24291":98718,"_2452":98812},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_2926":59394,"_25639":59352,"_17911":98814,"_5":17806,"_24291":98718,"_2452":98815},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_2926":59395,"_25639":59352,"_17911":98817,"_5":17806,"_24291":98718,"_2452":98818},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_2926":59396,"_25639":59352,"_17911":98820,"_5":17806,"_24291":98718,"_2452":98821},[],"SMTP, observabilidad y entrega de alertas",{"_2926":59397,"_25639":59352,"_17911":98823,"_5":17806,"_24291":98718,"_2452":98824},[],"las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_2926":59398,"_25639":59352,"_17911":98826,"_5":17806,"_24291":98718,"_2452":98827},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_2926":59399,"_25639":59399,"_5":12558,"_2452":98829,"_25983":98830,"_17911":98831,"_24291":59399},"Expón el Gateway",[41760,98137,98371],[],{"_2926":59400,"_25639":59399,"_17911":98833,"_5":17806,"_24291":59399,"_2452":98834},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_2926":59401,"_25639":59399,"_5":25980,"_17911":98836,"_24291":98837,"_2452":98838},[],"/docs/pr-preview/pr-48/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_2926":59402,"_25639":59399,"_5":25980,"_17911":98840,"_24291":98841,"_2452":98842},[],"/docs/pr-preview/pr-48/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_2926":59403,"_25639":59399,"_5":25980,"_17911":98844,"_24291":98845,"_2452":98846},[],"/docs/pr-preview/pr-48/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_2926":59404,"_25639":59399,"_5":25980,"_17911":98848,"_24291":98849,"_2452":42506},[],"/docs/pr-preview/pr-48/es/deployment/self-hosted/networking#k3s",{"_2926":59405,"_25639":59399,"_5":25980,"_17911":98851,"_24291":98852,"_2452":98853},[],"/docs/pr-preview/pr-48/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_2926":59406,"_25639":59399,"_5":25980,"_17911":98855,"_24291":98856,"_2452":98857},[],"/docs/pr-preview/pr-48/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_2926":59407,"_25639":59399,"_5":25980,"_17911":98859,"_24291":98860,"_2452":98861},[],"/docs/pr-preview/pr-48/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_2926":59408,"_25639":59399,"_5":25980,"_17911":98863,"_24291":98864,"_2452":98865},[],"/docs/pr-preview/pr-48/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_2926":59409,"_25639":59399,"_5":25980,"_17911":98867,"_24291":98868,"_2452":98869},[],"/docs/pr-preview/pr-48/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_2926":59410,"_25639":59399,"_17911":98871,"_5":17806,"_24291":98837,"_2452":98872},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_2926":59411,"_25639":59399,"_17911":98874,"_5":17806,"_24291":98837,"_2452":98875},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_2926":59412,"_25639":59399,"_17911":98877,"_5":17806,"_24291":98841,"_2452":98878},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_2926":59413,"_25639":59399,"_17911":98880,"_5":17806,"_24291":98841,"_2452":98881},[],"Defínelo únicamente cuando:",{"_2926":59414,"_25639":59399,"_17911":98883,"_5":17806,"_24291":98841,"_2452":98884},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_2926":59415,"_25639":59399,"_17911":98886,"_5":17806,"_24291":98841,"_2452":98887},[],"esa dirección está asignada a este Gateway",{"_2926":59416,"_25639":59399,"_17911":98889,"_5":17806,"_24291":98841,"_2452":98890},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_2926":59417,"_25639":59399,"_17911":98892,"_5":17806,"_24291":98841,"_2452":98893},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_2926":59418,"_25639":59399,"_17911":98895,"_5":17806,"_24291":98841,"_2452":98896},[],"No confundas estos valores:",{"_2926":59419,"_25639":59399,"_17911":98898,"_5":17806,"_24291":98841,"_2452":98899},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_2926":59420,"_25639":59399,"_17911":98901,"_5":17806,"_24291":98841,"_2452":98902},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_2926":59421,"_25639":59399,"_17911":98904,"_5":17806,"_24291":98841,"_2452":98905},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_2926":59422,"_25639":59399,"_17911":98907,"_5":17806,"_24291":98845,"_2452":98908},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_2926":59423,"_25639":59399,"_17911":98910,"_5":17806,"_24291":98845,"_2452":98911},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_2926":59424,"_25639":59399,"_17911":98913,"_5":17806,"_24291":98849,"_2452":98914},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_2926":59425,"_25639":59399,"_17911":98916,"_5":17806,"_24291":98849,"_2452":98917},[],"Para el diseño recomendado:",{"_2926":59426,"_25639":59399,"_17911":98919,"_5":17806,"_24291":98849,"_2452":98920},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_2926":59427,"_25639":59399,"_17911":98922,"_5":17806,"_24291":98849,"_2452":98923},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_2926":59428,"_25639":59399,"_17911":98925,"_5":17806,"_24291":98849,"_2452":98926},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_2926":59429,"_25639":59399,"_17911":98928,"_5":17806,"_24291":98849,"_2452":98929},[],"Apunta DNS a la dirección accesible de la VM.",{"_2926":59430,"_25639":59399,"_17911":98931,"_5":17806,"_24291":98849,"_2452":98932},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_2926":59431,"_25639":59399,"_17911":98934,"_5":17806,"_24291":98852,"_2452":98935},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_2926":59432,"_25639":59399,"_17911":98937,"_5":17806,"_24291":98856,"_2452":98938},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_2926":59433,"_25639":59399,"_17911":98940,"_5":17806,"_24291":98856,"_2452":98941},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_2926":59434,"_25639":59399,"_17911":98943,"_5":17806,"_24291":98860,"_2452":98944},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_2926":59435,"_25639":59399,"_17911":98946,"_5":17806,"_24291":98860,"_2452":98947},[],"Requisito",{"_2926":59436,"_25639":59399,"_17911":98949,"_5":17806,"_24291":98860,"_2452":98950},[],"Diseño recomendado",{"_2926":59437,"_25639":59399,"_17911":98952,"_5":17806,"_24291":98860,"_2452":98953},[],"Consecuencia",{"_2926":59438,"_25639":59399,"_17911":98955,"_5":17806,"_24291":98860,"_2452":98956},[],"Varias URL o servicios de Lamassu",{"_2926":59439,"_25639":59399,"_17911":98958,"_5":17806,"_24291":98860,"_2452":98959},[],"Un Gateway con varias rutas",{"_2926":59440,"_25639":59399,"_17911":98961,"_5":17806,"_24291":98860,"_2452":98962},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_2926":59441,"_25639":59399,"_17911":98964,"_5":17806,"_24291":98860,"_2452":98965},[],"Gateways independientes e IP externas distintas",{"_2926":59442,"_25639":59399,"_17911":98967,"_5":17806,"_24291":98860,"_2452":98968},[],"Una VIP por Gateway",{"_2926":59443,"_25639":59399,"_17911":98970,"_5":17806,"_24291":98860,"_2452":98971},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_2926":59444,"_25639":59399,"_17911":98973,"_5":17806,"_24291":98860,"_2452":98974},[],"Gateways independientes, un nodo y una IP",{"_2926":59445,"_25639":59399,"_17911":98976,"_5":17806,"_24291":98860,"_2452":98977},[],"Puertos externos diferentes",{"_2926":59446,"_25639":59399,"_17911":98979,"_5":17806,"_24291":98860,"_2452":98980},[],"Los clientes deben indicar puertos no estándar",{"_2926":59447,"_25639":59399,"_17911":98982,"_5":17806,"_24291":98860,"_2452":98983},[],"Terminación TLS/mTLS separada detrás de una IP",{"_2926":59448,"_25639":59399,"_17911":98985,"_5":17806,"_24291":98860,"_2452":98986},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_2926":59449,"_25639":59399,"_17911":98988,"_5":17806,"_24291":98860,"_2452":98989},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_2926":59450,"_25639":59399,"_17911":98991,"_5":17806,"_24291":98860,"_2452":98992},[],"Recursos Gateway separados pero proxy compartido",{"_2926":59451,"_25639":59399,"_17911":98994,"_5":17806,"_24291":98860,"_2452":98995},[],"Modo merged Gateway de Envoy",{"_2926":59452,"_25639":59399,"_17911":98997,"_5":17806,"_24291":98860,"_2452":98998},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_2926":59453,"_25639":59399,"_17911":99000,"_5":17806,"_24291":98860,"_2452":99001},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_2926":59454,"_25639":59399,"_17911":99003,"_5":17806,"_24291":98860,"_2452":99004},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_2926":59455,"_25639":59399,"_17911":99006,"_5":17806,"_24291":98860,"_2452":99007},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_2926":59456,"_25639":59399,"_17911":99009,"_5":17806,"_24291":98860,"_2452":99010},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_2926":59457,"_25639":59399,"_17911":99012,"_5":17806,"_24291":98864,"_2452":99013},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_2926":59458,"_25639":59399,"_17911":99015,"_5":17806,"_24291":98864,"_2452":99016},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_2926":59459,"_25639":59399,"_17911":99018,"_5":17806,"_24291":98864,"_2452":99019},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_2926":59460,"_25639":59399,"_17911":99021,"_5":17806,"_24291":98864,"_2452":99022},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_2926":59461,"_25639":59399,"_17911":99024,"_5":17806,"_24291":98864,"_2452":99025},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_2926":59462,"_25639":59399,"_17911":99027,"_5":17806,"_24291":98868,"_2452":99028},[],"Comprueba, en orden:",{"_2926":59463,"_25639":59399,"_17911":99030,"_5":17806,"_24291":98868,"_2452":99031},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_2926":59464,"_25639":59399,"_17911":99033,"_5":17806,"_24291":98868,"_2452":99034},[],"Su estado contiene la dirección esperada.",{"_2926":59465,"_25639":59399,"_17911":99036,"_5":17806,"_24291":98868,"_2452":99037},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_2926":59466,"_25639":59399,"_17911":99039,"_5":17806,"_24291":98868,"_2452":99040},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_2926":59467,"_25639":59399,"_17911":99042,"_5":17806,"_24291":98868,"_2452":99043},[],"DNS resuelve al endpoint accesible externamente.",{"_2926":59468,"_25639":59399,"_17911":99045,"_5":17806,"_24291":98868,"_2452":99046},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_2926":59469,"_25639":59399,"_17911":99048,"_5":17806,"_24291":98868,"_2452":99049},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_2926":59470,"_25639":59470,"_5":12558,"_2452":41867,"_25983":99051,"_17911":99052,"_24291":59470},[41760,98137,98371],[],{"_2926":59471,"_25639":59470,"_17911":99054,"_5":17806,"_24291":59470,"_2452":99055},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_2926":59472,"_25639":59470,"_5":25980,"_17911":99057,"_24291":99058,"_2452":99059},[],"/docs/pr-preview/pr-48/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_2926":59473,"_25639":59470,"_5":25980,"_17911":99061,"_24291":99062,"_2452":99063},[],"/docs/pr-preview/pr-48/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_2926":59474,"_25639":59470,"_5":25980,"_17911":99065,"_24291":99066,"_2452":99067},[],"/docs/pr-preview/pr-48/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_2926":59475,"_25639":59470,"_5":25980,"_17911":99069,"_24291":99070,"_2452":99071},[],"/docs/pr-preview/pr-48/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_2926":59476,"_25639":59470,"_5":25980,"_17911":99073,"_24291":99074,"_2452":99075},[],"/docs/pr-preview/pr-48/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_2926":59477,"_25639":59470,"_5":25980,"_17911":99077,"_24291":99078,"_2452":99079},[],"/docs/pr-preview/pr-48/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_2926":59478,"_25639":59470,"_17911":99081,"_5":17806,"_24291":99058,"_2452":99082},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_2926":59479,"_25639":59470,"_17911":99084,"_5":17806,"_24291":99062,"_2452":99085},[],"Flujo",{"_2926":59480,"_25639":59470,"_17911":99087,"_5":17806,"_24291":99062,"_2452":99088},[],"Úsalo para",{"_2926":59481,"_25639":59470,"_17911":99090,"_5":17806,"_24291":99062,"_2452":99091},[],"Qué instala",{"_2926":59482,"_25639":59470,"_17911":99093,"_5":17806,"_24291":99062,"_2452":42751},[],{"_2926":59483,"_25639":59470,"_17911":99095,"_5":17806,"_24291":99062,"_2452":99096},[],"Producción y entornos controlados",{"_2926":59484,"_25639":59470,"_17911":99098,"_5":17806,"_24291":99062,"_2452":99099},[],"Servicios de Lamassu y recursos de Gateway API",{"_2926":59485,"_25639":59470,"_17911":99101,"_5":17806,"_24291":99062,"_2452":42004},[],{"_2926":59486,"_25639":59470,"_17911":99103,"_5":17806,"_24291":99062,"_2452":99104},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_2926":59487,"_25639":59470,"_17911":99106,"_5":17806,"_24291":99062,"_2452":99107},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_2926":59488,"_25639":59470,"_17911":99109,"_5":17806,"_24291":99066,"_2452":99110},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_2926":59489,"_25639":59470,"_17911":99112,"_5":17806,"_24291":99066,"_2452":99113},[],"Área",{"_2926":59490,"_25639":59470,"_17911":99115,"_5":17806,"_24291":99066,"_2452":99116},[],"El chart de Lamassu proporciona",{"_2926":59491,"_25639":59470,"_17911":99118,"_5":17806,"_24291":99066,"_2452":99119},[],"Tú proporcionas",{"_2926":59492,"_25639":59470,"_17911":99121,"_5":17806,"_24291":99066,"_2452":99122},[],"Aplicaciones Lamassu",{"_2926":59493,"_25639":59470,"_17911":99124,"_5":17806,"_24291":99066,"_2452":99125},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_2926":59494,"_25639":59470,"_17911":99127,"_5":17806,"_24291":99066,"_2452":99128},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_2926":59495,"_25639":59470,"_17911":99130,"_5":17806,"_24291":99066,"_2452":99131},[],"Datos PostgreSQL",{"_2926":59496,"_25639":59470,"_17911":99133,"_5":17806,"_24291":99066,"_2452":99134},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_2926":59497,"_25639":59470,"_17911":99136,"_5":17806,"_24291":99066,"_2452":99137},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_2926":59498,"_25639":59470,"_17911":99139,"_5":17806,"_24291":99066,"_2452":99140},[],"Mensajería",{"_2926":59499,"_25639":59470,"_17911":99142,"_5":17806,"_24291":99066,"_2452":99143},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_2926":59500,"_25639":59470,"_17911":99145,"_5":17806,"_24291":99066,"_2452":99146},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_2926":59501,"_25639":59470,"_17911":99148,"_5":17806,"_24291":99066,"_2452":99149},[],"Identidad",{"_2926":59502,"_25639":59470,"_17911":99151,"_5":17806,"_24291":99066,"_2452":99152},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_2926":59503,"_25639":59470,"_17911":99154,"_5":17806,"_24291":99066,"_2452":99155},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_2926":59504,"_25639":59470,"_17911":99157,"_5":17806,"_24291":99066,"_2452":99158},[],"Enrutamiento externo",{"_2926":59505,"_25639":59470,"_17911":99160,"_5":17806,"_24291":99066,"_2452":99161},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_2926":59506,"_25639":59470,"_17911":99163,"_5":17806,"_24291":99066,"_2452":99164},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_2926":59507,"_25639":59470,"_17911":99166,"_5":17806,"_24291":99066,"_2452":42825},[],{"_2926":59508,"_25639":59470,"_17911":99168,"_5":17806,"_24291":99066,"_2452":99169},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_2926":59509,"_25639":59470,"_17911":99171,"_5":17806,"_24291":99066,"_2452":99172},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_2926":59510,"_25639":59470,"_17911":99174,"_5":17806,"_24291":99066,"_2452":99175},[],"Datos persistentes de la aplicación",{"_2926":59511,"_25639":59470,"_17911":99177,"_5":17806,"_24291":99066,"_2452":99178},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_2926":59512,"_25639":59470,"_17911":99180,"_5":17806,"_24291":99066,"_2452":99181},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_2926":59513,"_25639":59470,"_17911":99183,"_5":17806,"_24291":99066,"_2452":99184},[],"Integraciones opcionales",{"_2926":59514,"_25639":59470,"_17911":99186,"_5":17806,"_24291":99066,"_2452":99187},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_2926":59515,"_25639":59470,"_17911":99189,"_5":17806,"_24291":99066,"_2452":99190},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_2926":59516,"_25639":59470,"_17911":99192,"_5":17806,"_24291":99066,"_2452":99193},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_2926":59517,"_25639":59470,"_17911":99195,"_5":17806,"_24291":99066,"_2452":99196},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_2926":59518,"_25639":59470,"_17911":99198,"_5":17806,"_24291":99070,"_2452":99199},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_2926":59519,"_25639":59470,"_17911":99201,"_5":17806,"_24291":99070,"_2452":99202},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_2926":59520,"_25639":59470,"_17911":99204,"_5":17806,"_24291":99074,"_2452":99205},[],"Kubernetes 1.24 o posterior",{"_2926":59521,"_25639":59470,"_17911":99207,"_5":17806,"_24291":99074,"_2452":99208},[],"Helm 3.2 o posterior",{"_2926":59522,"_25639":59470,"_17911":99210,"_5":17806,"_24291":99074,"_2452":99211},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_2926":59523,"_25639":59470,"_17911":99213,"_5":17806,"_24291":99074,"_2452":99214},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_2926":59524,"_25639":59470,"_17911":99216,"_5":17806,"_24291":99074,"_2452":99217},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_2926":59525,"_25639":59470,"_17911":99219,"_5":17806,"_24291":99074,"_2452":99220},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_2926":59526,"_25639":59470,"_17911":99222,"_5":17806,"_24291":99074,"_2452":99223},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_2926":59527,"_25639":59470,"_17911":99225,"_5":17806,"_24291":99078,"_2452":99226},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2926":59528,"_25639":59470,"_17911":99228,"_5":17806,"_24291":99078,"_2452":99229},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2926":59529,"_25639":59470,"_17911":99231,"_5":17806,"_24291":99078,"_2452":99232},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2926":59530,"_25639":59530,"_5":12558,"_2452":99234,"_25983":99235,"_17911":99237,"_24291":59530},"Resolución de problemas de despliegue",[41760,98137,99236],"Operación",[],{"_2926":59531,"_25639":59530,"_17911":99239,"_5":17806,"_24291":59530,"_2452":99240},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_2926":59532,"_25639":59530,"_5":25980,"_17911":99242,"_24291":99243,"_2452":99244},[],"/docs/pr-preview/pr-48/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_2926":59533,"_25639":59530,"_5":25980,"_17911":99246,"_24291":99247,"_2452":99248},[],"/docs/pr-preview/pr-48/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_2926":59534,"_25639":59530,"_5":25980,"_17911":99250,"_24291":99251,"_2452":99252},[],"/docs/pr-preview/pr-48/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_2926":59535,"_25639":59530,"_5":25980,"_17911":99254,"_24291":99255,"_2452":99256},[],"/docs/pr-preview/pr-48/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_2926":59536,"_25639":59530,"_5":25980,"_17911":99258,"_24291":99259,"_2452":99260},[],"/docs/pr-preview/pr-48/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_2926":59537,"_25639":59530,"_5":25980,"_17911":99262,"_24291":99263,"_2452":99264},[],"/docs/pr-preview/pr-48/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_2926":59538,"_25639":59530,"_5":25980,"_17911":99266,"_24291":99267,"_2452":99268},[],"/docs/pr-preview/pr-48/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_2926":59539,"_25639":59530,"_5":25980,"_17911":99270,"_24291":99271,"_2452":99272},[],"/docs/pr-preview/pr-48/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_2926":59540,"_25639":59530,"_5":25980,"_17911":99274,"_24291":99275,"_2452":99276},[],"/docs/pr-preview/pr-48/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_2926":59541,"_25639":59530,"_5":25980,"_17911":99278,"_24291":99279,"_2452":99280},[],"/docs/pr-preview/pr-48/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_2926":59542,"_25639":59530,"_5":25980,"_17911":99282,"_24291":99283,"_2452":99284},[],"/docs/pr-preview/pr-48/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_2926":59543,"_25639":59530,"_5":25980,"_17911":99286,"_24291":99287,"_2452":99288},[],"/docs/pr-preview/pr-48/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_2926":59544,"_25639":59530,"_17911":99290,"_5":17806,"_24291":59530,"_2452":99291},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_2926":59545,"_25639":59530,"_17911":99293,"_5":17806,"_24291":99247,"_2452":99294},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_2926":59546,"_25639":59530,"_17911":99296,"_5":17806,"_24291":99251,"_2452":99297},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_2926":59547,"_25639":59530,"_17911":99299,"_5":17806,"_24291":99255,"_2452":99300},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_2926":59548,"_25639":59530,"_17911":99302,"_5":17806,"_24291":99259,"_2452":99303},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_2926":59549,"_25639":59530,"_17911":99305,"_5":17806,"_24291":99263,"_2452":99306},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_2926":59550,"_25639":59530,"_17911":99308,"_5":17806,"_24291":99267,"_2452":99309},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_2926":59551,"_25639":59530,"_17911":99311,"_5":17806,"_24291":99267,"_2452":99312},[],"Ejecuta también la prueba de conectividad del chart:",{"_2926":59552,"_25639":59530,"_17911":99314,"_5":17806,"_24291":99267,"_2452":99315},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_2926":59553,"_25639":59530,"_17911":99317,"_5":17806,"_24291":99267,"_2452":99318},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_2926":59554,"_25639":59530,"_17911":99320,"_5":17806,"_24291":99271,"_2452":99321},[],"Si recibes un 401:",{"_2926":59555,"_25639":59530,"_17911":99323,"_5":17806,"_24291":99271,"_2452":99324},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_2926":59556,"_25639":59530,"_17911":99326,"_5":17806,"_24291":99271,"_2452":99327},[],"verifica emisor, audiencia y expiración del token;",{"_2926":59557,"_25639":59530,"_17911":99329,"_5":17806,"_24291":99271,"_2452":99330},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_2926":59558,"_25639":59530,"_17911":99332,"_5":17806,"_24291":99271,"_2452":99333},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_2926":59559,"_25639":59530,"_17911":99335,"_5":17806,"_24291":99271,"_2452":99336},[],"Si el login termina pero las APIs devuelven 403:",{"_2926":59560,"_25639":59530,"_17911":99338,"_5":17806,"_24291":99271,"_2452":99339},[],"inspecciona los claims reales del token;",{"_2926":59561,"_25639":59530,"_17911":99341,"_5":17806,"_24291":99271,"_2452":99342},[],"confirma que coinciden con un principal activo;",{"_2926":59562,"_25639":59530,"_17911":99344,"_5":17806,"_24291":99271,"_2452":99345},[],"revisa las políticas concedidas al principal;",{"_2926":59563,"_25639":59530,"_17911":99347,"_5":17806,"_24291":99271,"_2452":99348},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_2926":59564,"_25639":59530,"_17911":99350,"_5":17806,"_24291":99271,"_2452":99351},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_2926":59565,"_25639":59530,"_17911":99353,"_5":17806,"_24291":99275,"_2452":99354},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_2926":59566,"_25639":59530,"_17911":99356,"_5":17806,"_24291":99275,"_2452":99357},[],"Localiza el pod y Service de authz.",{"_2926":59567,"_25639":59530,"_17911":99359,"_5":17806,"_24291":99275,"_2452":99360},[],"Comprueba /health, logs y conexión a su base de datos.",{"_2926":59568,"_25639":59530,"_17911":99362,"_5":17806,"_24291":99275,"_2452":99363},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_2926":59569,"_25639":59530,"_17911":99365,"_5":17806,"_24291":99275,"_2452":99366},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_2926":59570,"_25639":59530,"_17911":99368,"_5":17806,"_24291":99275,"_2452":99369},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_2926":59571,"_25639":59530,"_17911":99371,"_5":17806,"_24291":99279,"_2452":99372},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_2926":59572,"_25639":59530,"_17911":99374,"_5":17806,"_24291":99279,"_2452":99375},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_2926":59573,"_25639":59530,"_17911":99377,"_5":17806,"_24291":99279,"_2452":99378},[],"volumen persistente sin enlazar;",{"_2926":59574,"_25639":59530,"_17911":99380,"_5":17806,"_24291":99279,"_2452":99381},[],"imagen inaccesible o política de pull incorrecta;",{"_2926":59575,"_25639":59530,"_17911":99383,"_5":17806,"_24291":99279,"_2452":99384},[],"configuración inválida del motor criptográfico;",{"_2926":59576,"_25639":59530,"_17911":99386,"_5":17806,"_24291":99279,"_2452":99387},[],"límites de CPU o memoria demasiado bajos;",{"_2926":59577,"_25639":59530,"_17911":99389,"_5":17806,"_24291":99279,"_2452":99390},[],"migración previa incompleta.",{"_2926":59578,"_25639":59530,"_17911":99392,"_5":17806,"_24291":99279,"_2452":99393},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_2926":59579,"_25639":59530,"_17911":99395,"_5":17806,"_24291":99279,"_2452":99396},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_2926":59580,"_25639":59530,"_17911":99398,"_5":17806,"_24291":99283,"_2452":99399},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_2926":59581,"_25639":59530,"_17911":99401,"_5":17806,"_24291":99283,"_2452":99402},[],"verifica que esté habilitado en el servicio emisor;",{"_2926":59582,"_25639":59530,"_17911":99404,"_5":17806,"_24291":99283,"_2452":99405},[],"comprueba conectividad y credenciales AMQP;",{"_2926":59583,"_25639":59530,"_17911":99407,"_5":17806,"_24291":99283,"_2452":99408},[],"revisa exchange, routing key, colas y consumidores;",{"_2926":59584,"_25639":59530,"_17911":99410,"_5":17806,"_24291":99283,"_2452":99411},[],"inspecciona dead-letter queues;",{"_2926":59585,"_25639":59530,"_17911":99413,"_5":17806,"_24291":99283,"_2452":99414},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_2926":59586,"_25639":59530,"_17911":99416,"_5":17806,"_24291":99283,"_2452":99417},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_2926":59587,"_25639":59530,"_17911":99419,"_5":17806,"_24291":99287,"_2452":99420},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_2926":59588,"_25639":59530,"_17911":99422,"_5":17806,"_24291":99287,"_2452":99423},[],"Antes de cerrar una incidencia, guarda:",{"_2926":59589,"_25639":59530,"_17911":99425,"_5":17806,"_24291":99287,"_2452":99426},[],"causa confirmada;",{"_2926":59590,"_25639":59530,"_17911":99428,"_5":17806,"_24291":99287,"_2452":99429},[],"alcance temporal y recursos afectados;",{"_2926":59591,"_25639":59530,"_17911":99431,"_5":17806,"_24291":99287,"_2452":99432},[],"comandos o consultas utilizados;",{"_2926":59592,"_25639":59530,"_17911":99434,"_5":17806,"_24291":99287,"_2452":99435},[],"cambio aplicado y forma de revertirlo;",{"_2926":59593,"_25639":59530,"_17911":99437,"_5":17806,"_24291":99287,"_2452":99438},[],"validación desde un consumidor;",{"_2926":59594,"_25639":59530,"_17911":99440,"_5":17806,"_24291":99287,"_2452":99441},[],"acción preventiva y propietario.",{"_2926":59595,"_25639":59595,"_5":12558,"_2452":99443,"_25983":99444,"_17911":99447,"_24291":59595},"Control de acceso",[41760,99445,99446],"Plataforma","Administración",[],{"_2926":59596,"_25639":59595,"_17911":99449,"_5":17806,"_24291":59595,"_2452":99450},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_2926":59597,"_25639":59595,"_5":25980,"_17911":99452,"_24291":99453,"_2452":99454},[],"/docs/pr-preview/pr-48/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_2926":59598,"_25639":59595,"_5":25980,"_17911":99456,"_24291":99457,"_2452":99458},[],"/docs/pr-preview/pr-48/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_2926":59599,"_25639":59595,"_5":25980,"_17911":99460,"_24291":99461,"_2452":99462},[],"/docs/pr-preview/pr-48/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_2926":59600,"_25639":59595,"_5":25980,"_17911":99464,"_24291":99465,"_2452":99466},[],"/docs/pr-preview/pr-48/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_2926":59601,"_25639":59595,"_5":25980,"_17911":99468,"_24291":99469,"_2452":99470},[],"/docs/pr-preview/pr-48/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_2926":59602,"_25639":59595,"_5":25980,"_17911":99472,"_24291":99473,"_2452":99474},[],"/docs/pr-preview/pr-48/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_2926":59603,"_25639":59595,"_5":25980,"_17911":99476,"_24291":99477,"_2452":99478},[],"/docs/pr-preview/pr-48/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_2926":59604,"_25639":59595,"_5":25980,"_17911":99480,"_24291":99481,"_2452":99482},[],"/docs/pr-preview/pr-48/es/platform/administration/access-control#principales-x509","Principales X.509",{"_2926":59605,"_25639":59595,"_5":25980,"_17911":99484,"_24291":99485,"_2452":99486},[],"/docs/pr-preview/pr-48/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_2926":59606,"_25639":59595,"_5":25980,"_17911":99488,"_24291":99489,"_2452":99490},[],"/docs/pr-preview/pr-48/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_2926":59607,"_25639":59595,"_5":25980,"_17911":99492,"_24291":99493,"_2452":99494},[],"/docs/pr-preview/pr-48/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_2926":59608,"_25639":59595,"_5":25980,"_17911":99496,"_24291":99497,"_2452":99498},[],"/docs/pr-preview/pr-48/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_2926":59609,"_25639":59595,"_5":25980,"_17911":99500,"_24291":99501,"_2452":99502},[],"/docs/pr-preview/pr-48/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_2926":59610,"_25639":59595,"_5":25980,"_17911":99504,"_24291":99505,"_2452":99506},[],"/docs/pr-preview/pr-48/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_2926":59611,"_25639":59595,"_5":25980,"_17911":99508,"_24291":99509,"_2452":99510},[],"/docs/pr-preview/pr-48/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_2926":59612,"_25639":59595,"_5":25980,"_17911":99512,"_24291":99513,"_2452":98707},[],"/docs/pr-preview/pr-48/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_2926":59613,"_25639":59595,"_5":25980,"_17911":99515,"_24291":99516,"_2452":99517},[],"/docs/pr-preview/pr-48/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_2926":59614,"_25639":59595,"_5":25980,"_17911":99519,"_24291":99520,"_2452":99521},[],"/docs/pr-preview/pr-48/es/platform/administration/access-control#configura-las-dos-validaciones-jwt","Configura las dos validaciones JWT",{"_2926":59615,"_25639":59595,"_5":25980,"_17911":99523,"_24291":99524,"_2452":99525},[],"/docs/pr-preview/pr-48/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_2926":59616,"_25639":59595,"_5":25980,"_17911":99527,"_24291":99528,"_2452":99529},[],"/docs/pr-preview/pr-48/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_2926":59617,"_25639":59595,"_5":25980,"_17911":99531,"_24291":99532,"_2452":99533},[],"/docs/pr-preview/pr-48/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_2926":59618,"_25639":59595,"_5":25980,"_17911":99535,"_24291":99536,"_2452":99537},[],"/docs/pr-preview/pr-48/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_2926":59619,"_25639":59595,"_5":25980,"_17911":99539,"_24291":99540,"_2452":99541},[],"/docs/pr-preview/pr-48/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_2926":59620,"_25639":59595,"_5":25980,"_17911":99543,"_24291":99544,"_2452":99545},[],"/docs/pr-preview/pr-48/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_2926":59621,"_25639":59595,"_5":25980,"_17911":99547,"_24291":99548,"_2452":99549},[],"/docs/pr-preview/pr-48/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_2926":59622,"_25639":59595,"_5":25980,"_17911":99551,"_24291":99552,"_2452":99553},[],"/docs/pr-preview/pr-48/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_2926":59623,"_25639":59595,"_5":25980,"_17911":99555,"_24291":99556,"_2452":99557},[],"/docs/pr-preview/pr-48/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_2926":59624,"_25639":59595,"_5":25980,"_17911":99559,"_24291":99560,"_2452":99561},[],"/docs/pr-preview/pr-48/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_2926":59625,"_25639":59595,"_5":25980,"_17911":99563,"_24291":99564,"_2452":99565},[],"/docs/pr-preview/pr-48/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_2926":59626,"_25639":59595,"_5":25980,"_17911":99567,"_24291":99568,"_2452":99569},[],"/docs/pr-preview/pr-48/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_2926":59627,"_25639":59595,"_5":25980,"_17911":99571,"_24291":99572,"_2452":99573},[],"/docs/pr-preview/pr-48/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_2926":59628,"_25639":59595,"_17911":99575,"_5":17806,"_24291":59595,"_2452":99576},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_2926":59629,"_25639":59595,"_17911":99578,"_5":17806,"_24291":59595,"_2452":99579},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_2926":59630,"_25639":59595,"_17911":99581,"_5":17806,"_24291":59595,"_2452":99582},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_2926":59631,"_25639":59595,"_17911":99584,"_5":17806,"_24291":99453,"_2452":99585},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_2926":59632,"_25639":59595,"_17911":99587,"_5":17806,"_24291":99453,"_2452":99588},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_2926":59633,"_25639":59595,"_17911":99590,"_5":17806,"_24291":99453,"_2452":99591},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_2926":59634,"_25639":59595,"_17911":99593,"_5":17806,"_24291":99453,"_2452":99594},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_2926":59635,"_25639":59595,"_17911":99596,"_5":17806,"_24291":99453,"_2452":99597},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_2926":59636,"_25639":59595,"_17911":99599,"_5":17806,"_24291":99453,"_2452":99600},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_2926":59637,"_25639":59595,"_17911":99602,"_5":17806,"_24291":99457,"_2452":99603},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_2926":59638,"_25639":59595,"_17911":99605,"_5":17806,"_24291":99457,"_2452":99606},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_2926":59639,"_25639":59595,"_17911":99608,"_5":17806,"_24291":99461,"_2452":99609},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_2926":59640,"_25639":59595,"_17911":99611,"_5":17806,"_24291":99461,"_2452":99612},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_2926":59641,"_25639":59595,"_17911":99614,"_5":17806,"_24291":99461,"_2452":99615},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_2926":59642,"_25639":59595,"_17911":99617,"_5":17806,"_24291":99461,"_2452":99618},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_2926":59643,"_25639":59595,"_17911":99620,"_5":17806,"_24291":99461,"_2452":99621},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_2926":59644,"_25639":59595,"_17911":99623,"_5":17806,"_24291":99461,"_2452":99624},[],"Carga por separado las políticas concedidas a cada principal.",{"_2926":59645,"_25639":59595,"_17911":99626,"_5":17806,"_24291":99461,"_2452":99627},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_2926":59646,"_25639":59595,"_17911":99629,"_5":17806,"_24291":99461,"_2452":99630},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_2926":59647,"_25639":59595,"_17911":99632,"_5":17806,"_24291":99461,"_2452":99633},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_2926":59648,"_25639":59595,"_17911":99635,"_5":17806,"_24291":99461,"_2452":99636},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_2926":59649,"_25639":59595,"_17911":99638,"_5":17806,"_24291":99461,"_2452":99639},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_2926":59650,"_25639":59595,"_17911":99641,"_5":17806,"_24291":99461,"_2452":99642},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_2926":59651,"_25639":59595,"_17911":99644,"_5":17806,"_24291":99465,"_2452":99645},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_2926":59652,"_25639":59595,"_17911":99647,"_5":17806,"_24291":99465,"_2452":99648},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_2926":59653,"_25639":59595,"_17911":99650,"_5":17806,"_24291":99465,"_2452":99651},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_2926":59654,"_25639":59595,"_17911":99653,"_5":17806,"_24291":99465,"_2452":99654},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_2926":59655,"_25639":59595,"_17911":99656,"_5":17806,"_24291":99465,"_2452":99657},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_2926":59656,"_25639":59595,"_17911":99659,"_5":17806,"_24291":99465,"_2452":99660},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_2926":59657,"_25639":59595,"_17911":99662,"_5":17806,"_24291":99465,"_2452":99663},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_2926":59658,"_25639":59595,"_17911":99665,"_5":17806,"_24291":99465,"_2452":99666},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_2926":59659,"_25639":59595,"_17911":99668,"_5":17806,"_24291":99469,"_2452":99669},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_2926":59660,"_25639":59595,"_17911":99671,"_5":17806,"_24291":99469,"_2452":99672},[],"La decisión se toma con el contexto de la operación de dominio:",{"_2926":59661,"_25639":59595,"_17911":99674,"_5":17806,"_24291":99469,"_2452":99675},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_2926":59662,"_25639":59595,"_17911":99677,"_5":17806,"_24291":99469,"_2452":99678},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_2926":59663,"_25639":59595,"_17911":99680,"_5":17806,"_24291":99469,"_2452":99681},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_2926":59664,"_25639":59595,"_17911":99683,"_5":17806,"_24291":99469,"_2452":99684},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_2926":59665,"_25639":59595,"_17911":99686,"_5":17806,"_24291":99469,"_2452":99687},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_2926":59666,"_25639":59595,"_17911":99689,"_5":17806,"_24291":99469,"_2452":99690},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_2926":59667,"_25639":59595,"_17911":99692,"_5":17806,"_24291":99469,"_2452":99693},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_2926":59668,"_25639":59595,"_17911":99695,"_5":17806,"_24291":99469,"_2452":99696},[],"Las acciones se dividen en dos grupos:",{"_2926":59669,"_25639":59595,"_17911":99698,"_5":17806,"_24291":99469,"_2452":99699},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_2926":59670,"_25639":59595,"_17911":99701,"_5":17806,"_24291":99469,"_2452":99702},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_2926":59671,"_25639":59595,"_17911":99704,"_5":17806,"_24291":99469,"_2452":99705},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_2926":59672,"_25639":59595,"_17911":99707,"_5":17806,"_24291":99473,"_2452":99708},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_2926":59673,"_25639":59595,"_17911":99710,"_5":17806,"_24291":99473,"_2452":99711},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_2926":59674,"_25639":59595,"_17911":99713,"_5":17806,"_24291":99473,"_2452":99714},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_2926":59675,"_25639":59595,"_17911":99716,"_5":17806,"_24291":99477,"_2452":99717},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_2926":59676,"_25639":59595,"_17911":99719,"_5":17806,"_24291":99477,"_2452":99720},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_2926":59677,"_25639":59595,"_17911":99722,"_5":17806,"_24291":99477,"_2452":99723},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_2926":59678,"_25639":59595,"_17911":99725,"_5":17806,"_24291":99477,"_2452":99726},[],"Los operadores implementados son:",{"_2926":59679,"_25639":59595,"_17911":99728,"_5":17806,"_24291":99477,"_2452":99729},[],"`equals`, para igualdad exacta;",{"_2926":59680,"_25639":59595,"_17911":99731,"_5":17806,"_24291":99477,"_2452":99732},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_2926":59681,"_25639":59595,"_17911":99734,"_5":17806,"_24291":99477,"_2452":99735},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_2926":59682,"_25639":59595,"_17911":99737,"_5":17806,"_24291":99477,"_2452":99738},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_2926":59683,"_25639":59595,"_17911":99740,"_5":17806,"_24291":99481,"_2452":99741},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_2926":59684,"_25639":59595,"_17911":99743,"_5":17806,"_24291":99481,"_2452":99744},[],"Los modos disponibles son:",{"_2926":59685,"_25639":59595,"_17911":99746,"_5":17806,"_24291":99481,"_2452":99747},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_2926":59686,"_25639":59595,"_17911":99749,"_5":17806,"_24291":99481,"_2452":99750},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_2926":59687,"_25639":59595,"_17911":99752,"_5":17806,"_24291":99481,"_2452":99753},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_2926":59688,"_25639":59595,"_17911":99755,"_5":17806,"_24291":99481,"_2452":99756},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_2926":59689,"_25639":59595,"_17911":99758,"_5":17806,"_24291":99481,"_2452":99759},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_2926":59690,"_25639":59595,"_17911":99761,"_5":17806,"_24291":99481,"_2452":99762},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_2926":59691,"_25639":59595,"_17911":99764,"_5":17806,"_24291":99485,"_2452":99765},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_2926":59692,"_25639":59595,"_17911":99767,"_5":17806,"_24291":99485,"_2452":99768},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_2926":59693,"_25639":59595,"_17911":99770,"_5":17806,"_24291":99485,"_2452":99771},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_2926":59694,"_25639":59595,"_17911":99773,"_5":17806,"_24291":99485,"_2452":99774},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_2926":59695,"_25639":59595,"_17911":99776,"_5":17806,"_24291":99493,"_2452":99777},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_2926":59696,"_25639":59595,"_17911":99779,"_5":17806,"_24291":99493,"_2452":99780},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_2926":59697,"_25639":59595,"_17911":99782,"_5":17806,"_24291":99497,"_2452":99783},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_2926":59698,"_25639":59595,"_17911":99785,"_5":17806,"_24291":99497,"_2452":99786},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_2926":59699,"_25639":59595,"_17911":99788,"_5":17806,"_24291":99501,"_2452":99789},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_2926":59700,"_25639":59595,"_17911":99791,"_5":17806,"_24291":99501,"_2452":99792},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_2926":59701,"_25639":59595,"_17911":99794,"_5":17806,"_24291":99501,"_2452":99795},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_2926":59702,"_25639":59595,"_17911":99797,"_5":17806,"_24291":99505,"_2452":99798},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_2926":59703,"_25639":59595,"_17911":99800,"_5":17806,"_24291":99505,"_2452":99801},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_2926":59704,"_25639":59595,"_17911":99803,"_5":17806,"_24291":99505,"_2452":99804},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_2926":59705,"_25639":59595,"_17911":99806,"_5":17806,"_24291":99505,"_2452":99807},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_2926":59706,"_25639":59595,"_17911":99809,"_5":17806,"_24291":99505,"_2452":99810},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_2926":59707,"_25639":59595,"_17911":99812,"_5":17806,"_24291":99505,"_2452":99813},[],"Ten en cuenta que:",{"_2926":59708,"_25639":59595,"_17911":99815,"_5":17806,"_24291":99505,"_2452":99816},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_2926":59709,"_25639":59595,"_17911":99818,"_5":17806,"_24291":99505,"_2452":99819},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_2926":59710,"_25639":59595,"_17911":99821,"_5":17806,"_24291":99505,"_2452":99822},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_2926":59711,"_25639":59595,"_17911":99824,"_5":17806,"_24291":99509,"_2452":99825},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_2926":59712,"_25639":59595,"_17911":99827,"_5":17806,"_24291":99509,"_2452":99828},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_2926":59713,"_25639":59595,"_17911":99830,"_5":17806,"_24291":99509,"_2452":99831},[],"acceso completo y de solo lectura a KMS;",{"_2926":59714,"_25639":59595,"_17911":99833,"_5":17806,"_24291":99509,"_2452":99834},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_2926":59715,"_25639":59595,"_17911":99836,"_5":17806,"_24291":99509,"_2452":99837},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_2926":59716,"_25639":59595,"_17911":99839,"_5":17806,"_24291":99509,"_2452":99840},[],"acceso a la interfaz;",{"_2926":59717,"_25639":59595,"_17911":99842,"_5":17806,"_24291":99509,"_2452":99843},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_2926":59718,"_25639":59595,"_17911":99845,"_5":17806,"_24291":99509,"_2452":99846},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_2926":59719,"_25639":59595,"_17911":99848,"_5":17806,"_24291":99509,"_2452":99849},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_2926":59720,"_25639":59595,"_17911":99851,"_5":17806,"_24291":99513,"_2452":99852},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_2926":59721,"_25639":59595,"_17911":99854,"_5":17806,"_24291":99513,"_2452":99855},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_2926":59722,"_25639":59595,"_17911":99857,"_5":17806,"_24291":99513,"_2452":99858},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_2926":59723,"_25639":59595,"_17911":99860,"_5":17806,"_24291":99516,"_2452":99861},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_2926":59724,"_25639":59595,"_17911":99863,"_5":17806,"_24291":99520,"_2452":99864},[],"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes.",{"_2926":59725,"_25639":59595,"_17911":99866,"_5":17806,"_24291":99524,"_2452":99867},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_2926":59726,"_25639":59595,"_17911":99869,"_5":17806,"_24291":99528,"_2452":99870},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_2926":59727,"_25639":59595,"_17911":99872,"_5":17806,"_24291":99532,"_2452":99873},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_2926":59728,"_25639":59595,"_17911":99875,"_5":17806,"_24291":99536,"_2452":99876},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_2926":59729,"_25639":59595,"_17911":99878,"_5":17806,"_24291":99536,"_2452":99879},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_2926":59730,"_25639":59595,"_17911":99881,"_5":17806,"_24291":99540,"_2452":99882},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_2926":59731,"_25639":59595,"_17911":99884,"_5":17806,"_24291":99540,"_2452":99885},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_2926":59732,"_25639":59595,"_17911":99887,"_5":17806,"_24291":99540,"_2452":99888},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_2926":59733,"_25639":59595,"_17911":99890,"_5":17806,"_24291":99540,"_2452":99891},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_2926":59734,"_25639":59595,"_17911":99893,"_5":17806,"_24291":99540,"_2452":99894},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_2926":59735,"_25639":59595,"_17911":99896,"_5":17806,"_24291":99540,"_2452":99897},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_2926":59736,"_25639":59595,"_17911":99899,"_5":17806,"_24291":99540,"_2452":99900},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_2926":59737,"_25639":59595,"_17911":99902,"_5":17806,"_24291":99540,"_2452":99903},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_2926":59738,"_25639":59595,"_17911":99905,"_5":17806,"_24291":99544,"_2452":99906},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_2926":59739,"_25639":59595,"_17911":99908,"_5":17806,"_24291":99544,"_2452":99909},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_2926":59740,"_25639":59595,"_17911":99911,"_5":17806,"_24291":99544,"_2452":99912},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_2926":59741,"_25639":59595,"_17911":99914,"_5":17806,"_24291":99548,"_2452":99915},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_2926":59742,"_25639":59595,"_17911":99917,"_5":17806,"_24291":99548,"_2452":99918},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_2926":59743,"_25639":59595,"_17911":99920,"_5":17806,"_24291":99548,"_2452":99921},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_2926":59744,"_25639":59595,"_17911":99923,"_5":17806,"_24291":99548,"_2452":99924},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_2926":59745,"_25639":59595,"_17911":99926,"_5":17806,"_24291":99548,"_2452":99927},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_2926":59746,"_25639":59595,"_17911":99929,"_5":17806,"_24291":99548,"_2452":99930},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_2926":59747,"_25639":59595,"_17911":99932,"_5":17806,"_24291":99548,"_2452":99933},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_2926":59748,"_25639":59595,"_17911":99935,"_5":17806,"_24291":99548,"_2452":99936},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_2926":59749,"_25639":59595,"_17911":99938,"_5":17806,"_24291":99556,"_2452":99939},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_2926":59750,"_25639":59595,"_17911":99941,"_5":17806,"_24291":99560,"_2452":99942},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_2926":59751,"_25639":59595,"_17911":99944,"_5":17806,"_24291":99560,"_2452":99945},[],"que exista un principal activo del tipo correcto;",{"_2926":59752,"_25639":59595,"_17911":99947,"_5":17806,"_24291":99560,"_2452":99948},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_2926":59753,"_25639":59595,"_17911":99950,"_5":17806,"_24291":99560,"_2452":99951},[],"que todas las condiciones del principal se cumplan;",{"_2926":59754,"_25639":59595,"_17911":99953,"_5":17806,"_24291":99560,"_2452":99954},[],"que el principal tenga concedida la política esperada;",{"_2926":59755,"_25639":59595,"_17911":99956,"_5":17806,"_24291":99560,"_2452":99957},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_2926":59756,"_25639":59595,"_17911":99959,"_5":17806,"_24291":99560,"_2452":99960},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_2926":59757,"_25639":59595,"_17911":99962,"_5":17806,"_24291":99560,"_2452":99963},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_2926":59758,"_25639":59595,"_17911":99965,"_5":17806,"_24291":99564,"_2452":99966},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_2926":59759,"_25639":59595,"_17911":99968,"_5":17806,"_24291":99568,"_2452":99969},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_2926":59760,"_25639":59595,"_17911":99971,"_5":17806,"_24291":99572,"_2452":99972},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_2926":59761,"_25639":59595,"_17911":99974,"_5":17806,"_24291":99572,"_2452":99975},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_2926":59762,"_25639":59762,"_5":12558,"_2452":99977,"_25983":99978,"_17911":99979,"_24291":59762},"Alertas y suscripciones",[41760,99445,99446],[],{"_2926":59763,"_25639":59762,"_17911":99981,"_5":17806,"_24291":59762,"_2452":99982},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_2926":59764,"_25639":59762,"_5":25980,"_17911":99984,"_24291":99985,"_2452":99986},[],"/docs/pr-preview/pr-48/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_2926":59765,"_25639":59762,"_5":25980,"_17911":99988,"_24291":99989,"_2452":99990},[],"/docs/pr-preview/pr-48/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_2926":59766,"_25639":59762,"_5":25980,"_17911":99992,"_24291":99993,"_2452":99994},[],"/docs/pr-preview/pr-48/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_2926":59767,"_25639":59762,"_5":25980,"_17911":99996,"_24291":99997,"_2452":99998},[],"/docs/pr-preview/pr-48/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_2926":59768,"_25639":59762,"_5":25980,"_17911":100000,"_24291":100001,"_2452":100002},[],"/docs/pr-preview/pr-48/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_2926":59769,"_25639":59762,"_5":25980,"_17911":100004,"_24291":100005,"_2452":100006},[],"/docs/pr-preview/pr-48/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_2926":59770,"_25639":59762,"_5":25980,"_17911":100008,"_24291":100009,"_2452":100010},[],"/docs/pr-preview/pr-48/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_2926":59771,"_25639":59762,"_5":25980,"_17911":100012,"_24291":100013,"_2452":100014},[],"/docs/pr-preview/pr-48/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_2926":59772,"_25639":59762,"_5":25980,"_17911":100016,"_24291":100017,"_2452":100018},[],"/docs/pr-preview/pr-48/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_2926":59773,"_25639":59762,"_5":25980,"_17911":100020,"_24291":100021,"_2452":100022},[],"/docs/pr-preview/pr-48/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_2926":59774,"_25639":59762,"_17911":100024,"_5":17806,"_24291":59762,"_2452":100025},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_2926":59775,"_25639":59762,"_17911":100027,"_5":17806,"_24291":99985,"_2452":100028},[],"Un servicio publica un evento de dominio.",{"_2926":59776,"_25639":59762,"_17911":100030,"_5":17806,"_24291":99985,"_2452":100031},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_2926":59777,"_25639":59762,"_17911":100033,"_5":17806,"_24291":99985,"_2452":100034},[],"El filtro de cada suscripción decide si debe notificarse.",{"_2926":59778,"_25639":59762,"_17911":100036,"_5":17806,"_24291":99985,"_2452":100037},[],"Lamassu entrega el evento al canal configurado.",{"_2926":59779,"_25639":59762,"_17911":100039,"_5":17806,"_24291":99985,"_2452":100040},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_2926":59780,"_25639":59762,"_17911":100042,"_5":17806,"_24291":99989,"_2452":100043},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_2926":59781,"_25639":59762,"_17911":100045,"_5":17806,"_24291":99989,"_2452":100046},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_2926":59782,"_25639":59762,"_17911":100048,"_5":17806,"_24291":99989,"_2452":100049},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_2926":59783,"_25639":59762,"_17911":100051,"_5":17806,"_24291":99989,"_2452":100052},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_2926":59784,"_25639":59762,"_17911":100054,"_5":17806,"_24291":99989,"_2452":100055},[],"`apikey_options` necesita `header` y `key`.",{"_2926":59785,"_25639":59762,"_17911":100057,"_5":17806,"_24291":99989,"_2452":100058},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2926":59786,"_25639":59762,"_17911":100060,"_5":17806,"_24291":99989,"_2452":100061},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_2926":59787,"_25639":59762,"_17911":100063,"_5":17806,"_24291":99989,"_2452":100064},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_2926":59788,"_25639":59762,"_17911":100066,"_5":17806,"_24291":99997,"_2452":100067},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_2926":59789,"_25639":59762,"_17911":100069,"_5":17806,"_24291":100001,"_2452":100070},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_2926":59790,"_25639":59762,"_17911":100072,"_5":17806,"_24291":100005,"_2452":100073},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_2926":59791,"_25639":59762,"_17911":100075,"_5":17806,"_24291":100005,"_2452":100076},[],"**None** notifica todas las instancias del evento.",{"_2926":59792,"_25639":59762,"_17911":100078,"_5":17806,"_24291":100005,"_2452":100079},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_2926":59793,"_25639":59762,"_17911":100081,"_5":17806,"_24291":100005,"_2452":100082},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_2926":59794,"_25639":59762,"_17911":100084,"_5":17806,"_24291":100005,"_2452":100085},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_2926":59795,"_25639":59762,"_17911":100087,"_5":17806,"_24291":100005,"_2452":100088},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_2926":59796,"_25639":59762,"_17911":100090,"_5":17806,"_24291":100009,"_2452":100091},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_2926":59797,"_25639":59762,"_17911":100093,"_5":17806,"_24291":100013,"_2452":100094},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_2926":59798,"_25639":59762,"_17911":100096,"_5":17806,"_24291":100013,"_2452":100097},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_2926":59799,"_25639":59762,"_17911":100099,"_5":17806,"_24291":100013,"_2452":100100},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_2926":59800,"_25639":59762,"_17911":100102,"_5":17806,"_24291":100013,"_2452":100103},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_2926":59801,"_25639":59762,"_17911":100105,"_5":17806,"_24291":100013,"_2452":100106},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_2926":59802,"_25639":59762,"_17911":100108,"_5":17806,"_24291":100013,"_2452":100109},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_2926":59803,"_25639":59762,"_17911":100111,"_5":17806,"_24291":100013,"_2452":100112},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_2926":59804,"_25639":59762,"_17911":100114,"_5":17806,"_24291":100013,"_2452":100115},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_2926":59805,"_25639":59762,"_17911":100117,"_5":17806,"_24291":100017,"_2452":100118},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_2926":59806,"_25639":59762,"_17911":100120,"_5":17806,"_24291":100021,"_2452":100121},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_2926":59807,"_25639":59762,"_17911":100123,"_5":17806,"_24291":100021,"_2452":100124},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_2926":59808,"_25639":59762,"_17911":100126,"_5":17806,"_24291":100021,"_2452":100127},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_2926":59809,"_25639":59762,"_17911":100129,"_5":17806,"_24291":100021,"_2452":100130},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_2926":59810,"_25639":59762,"_17911":100132,"_5":17806,"_24291":100021,"_2452":100133},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_2926":59811,"_25639":59762,"_17911":100135,"_5":17806,"_24291":100021,"_2452":100136},[],"**Validación:** `va.role.crl.create`.",{"_2926":59812,"_25639":59762,"_17911":100138,"_5":17806,"_24291":100021,"_2452":100139},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_2926":59813,"_25639":59762,"_17911":100141,"_5":17806,"_24291":100021,"_2452":100142},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_2926":59814,"_25639":59814,"_5":12558,"_2452":100144,"_25983":100145,"_17911":100146,"_24291":59814},"Registros de auditoría",[41760,99445,99446],[],{"_2926":59815,"_25639":59814,"_17911":100148,"_5":17806,"_24291":59814,"_2452":100149},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_2926":59816,"_25639":59814,"_5":25980,"_17911":100151,"_24291":100152,"_2452":100153},[],"/docs/pr-preview/pr-48/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_2926":59817,"_25639":59814,"_5":25980,"_17911":100155,"_24291":100156,"_2452":100157},[],"/docs/pr-preview/pr-48/es/platform/administration/audit-logs#cobertura","Cobertura",{"_2926":59818,"_25639":59814,"_5":25980,"_17911":100159,"_24291":100160,"_2452":100161},[],"/docs/pr-preview/pr-48/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_2926":59819,"_25639":59814,"_5":25980,"_17911":100163,"_24291":100164,"_2452":100165},[],"/docs/pr-preview/pr-48/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_2926":59820,"_25639":59814,"_5":25980,"_17911":100167,"_24291":100168,"_2452":100169},[],"/docs/pr-preview/pr-48/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_2926":59821,"_25639":59814,"_5":25980,"_17911":100171,"_24291":100172,"_2452":100173},[],"/docs/pr-preview/pr-48/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_2926":59822,"_25639":59814,"_5":25980,"_17911":100175,"_24291":100176,"_2452":100177},[],"/docs/pr-preview/pr-48/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_2926":59823,"_25639":59814,"_5":25980,"_17911":100179,"_24291":100180,"_2452":100181},[],"/docs/pr-preview/pr-48/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_2926":59824,"_25639":59814,"_5":25980,"_17911":100183,"_24291":100184,"_2452":100185},[],"/docs/pr-preview/pr-48/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_2926":59825,"_25639":59814,"_5":25980,"_17911":100187,"_24291":100188,"_2452":100189},[],"/docs/pr-preview/pr-48/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_2926":59826,"_25639":59814,"_5":25980,"_17911":100191,"_24291":100192,"_2452":100193},[],"/docs/pr-preview/pr-48/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_2926":59827,"_25639":59814,"_17911":100195,"_5":17806,"_24291":59814,"_2452":100196},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_2926":59828,"_25639":59814,"_17911":100198,"_5":17806,"_24291":100152,"_2452":100199},[],"El cuerpo de auditoría incluye:",{"_2926":59829,"_25639":59814,"_17911":100201,"_5":17806,"_24291":100152,"_2452":100202},[],"input: datos recibidos por la operación;",{"_2926":59830,"_25639":59814,"_17911":100204,"_5":17806,"_24291":100152,"_2452":100205},[],"has\\_error: indica si el servicio devolvió un error;",{"_2926":59831,"_25639":59814,"_17911":100207,"_5":17806,"_24291":100152,"_2452":100208},[],"output: resultado producido o mensaje de error;",{"_2926":59832,"_25639":59814,"_17911":100210,"_5":17806,"_24291":100152,"_2452":100211},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_2926":59833,"_25639":59814,"_17911":100213,"_5":17806,"_24291":100152,"_2452":100214},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_2926":59834,"_25639":59814,"_17911":100216,"_5":17806,"_24291":100152,"_2452":100217},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_2926":59835,"_25639":59814,"_17911":100219,"_5":17806,"_24291":100156,"_2452":100220},[],"El backend aplica auditoría a mutaciones de:",{"_2926":59836,"_25639":59814,"_17911":100222,"_5":17806,"_24291":100156,"_2452":100223},[],"autoridades, certificados y perfiles de emisión;",{"_2926":59837,"_25639":59814,"_17911":100225,"_5":17806,"_24291":100156,"_2452":100226},[],"claves y motores KMS;",{"_2926":59838,"_25639":59814,"_17911":100228,"_5":17806,"_24291":100156,"_2452":100229},[],"dispositivos e identidades;",{"_2926":59839,"_25639":59814,"_17911":100231,"_5":17806,"_24291":100156,"_2452":100232},[],"DMS y operaciones de enrolamiento;",{"_2926":59840,"_25639":59814,"_17911":100234,"_5":17806,"_24291":100156,"_2452":100235},[],"funciones de validación y CRL;",{"_2926":59841,"_25639":59814,"_17911":100237,"_5":17806,"_24291":100156,"_2452":100238},[],"principales, políticas y concesiones de autorización.",{"_2926":59842,"_25639":59814,"_17911":100240,"_5":17806,"_24291":100156,"_2452":100241},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_2926":59843,"_25639":59814,"_17911":100243,"_5":17806,"_24291":100160,"_2452":100244},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_2926":59844,"_25639":59814,"_17911":100246,"_5":17806,"_24291":100160,"_2452":100247},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_2926":59845,"_25639":59814,"_17911":100249,"_5":17806,"_24291":100160,"_2452":100250},[],"Diseña el consumidor para:",{"_2926":59846,"_25639":59814,"_17911":100252,"_5":17806,"_24291":100160,"_2452":100253},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_2926":59847,"_25639":59814,"_17911":100255,"_5":17806,"_24291":100160,"_2452":100256},[],"conservar el CloudEvent completo sin modificar;",{"_2926":59848,"_25639":59814,"_17911":100258,"_5":17806,"_24291":100160,"_2452":100259},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_2926":59849,"_25639":59814,"_17911":100261,"_5":17806,"_24291":100160,"_2452":100262},[],"cifrar en tránsito y en reposo;",{"_2926":59850,"_25639":59814,"_17911":100264,"_5":17806,"_24291":100160,"_2452":100265},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_2926":59851,"_25639":59814,"_17911":100267,"_5":17806,"_24291":100160,"_2452":100268},[],"aplicar una política explícita de retención y legal hold;",{"_2926":59852,"_25639":59814,"_17911":100270,"_5":17806,"_24291":100160,"_2452":100271},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_2926":59853,"_25639":59814,"_17911":100273,"_5":17806,"_24291":100164,"_2452":100274},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_2926":59854,"_25639":59814,"_17911":100276,"_5":17806,"_24291":100164,"_2452":100277},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_2926":59855,"_25639":59814,"_17911":100279,"_5":17806,"_24291":100172,"_2452":100280},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_2926":59856,"_25639":59814,"_17911":100282,"_5":17806,"_24291":100176,"_2452":100283},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_2926":59857,"_25639":59814,"_17911":100285,"_5":17806,"_24291":100180,"_2452":100286},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_2926":59858,"_25639":59814,"_17911":100288,"_5":17806,"_24291":100184,"_2452":100289},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_2926":59859,"_25639":59814,"_17911":100291,"_5":17806,"_24291":100188,"_2452":100292},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_2926":59860,"_25639":59814,"_17911":100294,"_5":17806,"_24291":100192,"_2452":100295},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_2926":59861,"_25639":59814,"_17911":100297,"_5":17806,"_24291":100192,"_2452":100298},[],"aparece un evento de auditoría correcto;",{"_2926":59862,"_25639":59814,"_17911":100300,"_5":17806,"_24291":100192,"_2452":100301},[],"el principal coincide con la identidad utilizada;",{"_2926":59863,"_25639":59814,"_17911":100303,"_5":17806,"_24291":100192,"_2452":100304},[],"el consumidor lo persiste una sola vez;",{"_2926":59864,"_25639":59814,"_17911":100306,"_5":17806,"_24291":100192,"_2452":100307},[],"puede recuperarse por recurso, actor y periodo;",{"_2926":59865,"_25639":59814,"_17911":100309,"_5":17806,"_24291":100192,"_2452":100310},[],"una interrupción del consumidor produce una alerta.",{"_2926":59866,"_25639":59814,"_17911":100312,"_5":17806,"_24291":100192,"_2452":100313},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_2926":59867,"_25639":59867,"_5":12558,"_2452":100315,"_25983":100316,"_17911":100317,"_24291":59867},"Arquitectura de la plataforma",[41760,99445],[],{"_2926":59868,"_25639":59867,"_17911":100319,"_5":17806,"_24291":59867,"_2452":100320},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_2926":59869,"_25639":59867,"_5":25980,"_17911":100322,"_24291":100323,"_2452":100324},[],"/docs/pr-preview/pr-48/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_2926":59870,"_25639":59867,"_5":25980,"_17911":100326,"_24291":100327,"_2452":100328},[],"/docs/pr-preview/pr-48/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_2926":59871,"_25639":59867,"_5":25980,"_17911":100330,"_24291":100331,"_2452":100332},[],"/docs/pr-preview/pr-48/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_2926":59872,"_25639":59867,"_5":25980,"_17911":100334,"_24291":100335,"_2452":100336},[],"/docs/pr-preview/pr-48/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_2926":59873,"_25639":59867,"_5":25980,"_17911":100338,"_24291":100339,"_2452":100340},[],"/docs/pr-preview/pr-48/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_2926":59874,"_25639":59867,"_17911":100342,"_5":17806,"_24291":59867,"_2452":100343},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_2926":59875,"_25639":59867,"_17911":100345,"_5":17806,"_24291":59867,"_2452":100346},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_2926":59876,"_25639":59867,"_17911":100348,"_5":17806,"_24291":100323,"_2452":100349},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_2926":59877,"_25639":59867,"_17911":100351,"_5":17806,"_24291":100327,"_2452":100352},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_2926":59878,"_25639":59867,"_17911":100354,"_5":17806,"_24291":100331,"_2452":100355},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_2926":59879,"_25639":59867,"_17911":100357,"_5":17806,"_24291":100335,"_2452":100358},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_2926":59880,"_25639":59867,"_17911":100360,"_5":17806,"_24291":100339,"_2452":100361},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_2926":59881,"_25639":59881,"_5":12558,"_2452":100363,"_25983":100364,"_17911":100365,"_24291":59881},"Cómo funciona Lamassu",[41760,99445],[],{"_2926":59882,"_25639":59881,"_17911":100367,"_5":17806,"_24291":59881,"_2452":100368},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_2926":59883,"_25639":59881,"_5":25980,"_17911":100370,"_24291":100371,"_2452":100372},[],"/docs/pr-preview/pr-48/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_2926":59884,"_25639":59881,"_5":25980,"_17911":100374,"_24291":100375,"_2452":100376},[],"/docs/pr-preview/pr-48/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_2926":59885,"_25639":59881,"_17911":100378,"_5":17806,"_24291":59881,"_2452":100379},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_2926":59886,"_25639":59881,"_17911":100381,"_5":17806,"_24291":100371,"_2452":100382},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_2926":59887,"_25639":59881,"_17911":100384,"_5":17806,"_24291":100371,"_2452":100385},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_2926":59888,"_25639":59881,"_17911":100387,"_5":17806,"_24291":100371,"_2452":100388},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_2926":59889,"_25639":59881,"_17911":100390,"_5":17806,"_24291":100371,"_2452":100391},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_2926":59890,"_25639":59881,"_17911":100393,"_5":17806,"_24291":100371,"_2452":100394},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_2926":59891,"_25639":59881,"_17911":100396,"_5":17806,"_24291":100375,"_2452":100397},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_2926":59892,"_25639":59881,"_17911":100399,"_5":17806,"_24291":100375,"_2452":100400},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_2926":59893,"_25639":59881,"_17911":100402,"_5":17806,"_24291":100375,"_2452":100403},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_2926":59894,"_25639":59881,"_17911":100405,"_5":17806,"_24291":100375,"_2452":100406},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_2926":59895,"_25639":59881,"_17911":100408,"_5":17806,"_24291":100375,"_2452":100409},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_2926":59896,"_25639":59881,"_17911":100411,"_5":17806,"_24291":100375,"_2452":100412},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_2926":59897,"_25639":59881,"_17911":100414,"_5":17806,"_24291":100375,"_2452":100415},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2926":59898,"_25639":59898,"_5":12558,"_2452":100417,"_25983":100418,"_17911":100419,"_24291":59898},"Dispositivos e identidades",[41760,99445,44078,100417],[],{"_2926":59899,"_25639":59898,"_17911":100421,"_5":17806,"_24291":59898,"_2452":100422},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_2926":59900,"_25639":59898,"_5":25980,"_17911":100424,"_24291":100425,"_2452":100426},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_2926":59901,"_25639":59898,"_5":25980,"_17911":100428,"_24291":100429,"_2452":100430},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_2926":59902,"_25639":59898,"_5":25980,"_17911":100432,"_24291":100433,"_2452":100434},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_2926":59903,"_25639":59898,"_5":25980,"_17911":100436,"_24291":100437,"_2452":100438},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_2926":59904,"_25639":59898,"_5":25980,"_17911":100440,"_24291":100441,"_2452":100442},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_2926":59905,"_25639":59898,"_5":25980,"_17911":100444,"_24291":100445,"_2452":100446},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_2926":59906,"_25639":59898,"_5":25980,"_17911":100448,"_24291":100449,"_2452":100450},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_2926":59907,"_25639":59898,"_5":25980,"_17911":100452,"_24291":100453,"_2452":100454},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_2926":59908,"_25639":59898,"_5":25980,"_17911":100456,"_24291":100457,"_2452":100458},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_2926":59909,"_25639":59898,"_5":25980,"_17911":100460,"_24291":100461,"_2452":100462},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_2926":59910,"_25639":59898,"_5":25980,"_17911":100464,"_24291":100465,"_2452":100466},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_2926":59911,"_25639":59898,"_17911":100468,"_5":17806,"_24291":59898,"_2452":100469},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_2926":59912,"_25639":59898,"_17911":100471,"_5":17806,"_24291":59898,"_2452":100472},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_2926":59913,"_25639":59898,"_17911":100474,"_5":17806,"_24291":100425,"_2452":100475},[],"Vista operativa",{"_2926":59914,"_25639":59898,"_17911":100477,"_5":17806,"_24291":100425,"_2452":100478},[],"Interpretación",{"_2926":59915,"_25639":59898,"_17911":100480,"_5":17806,"_24291":100425,"_2452":44141},[],{"_2926":59916,"_25639":59898,"_17911":100482,"_5":17806,"_24291":100425,"_2452":100483},[],"Hay registro, pero todavía no hay identidad asociada.",{"_2926":59917,"_25639":59898,"_17911":100485,"_5":17806,"_24291":100425,"_2452":44147},[],{"_2926":59918,"_25639":59898,"_17911":100487,"_5":17806,"_24291":100425,"_2452":100488},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_2926":59919,"_25639":59898,"_17911":100490,"_5":17806,"_24291":100425,"_2452":44153},[],{"_2926":59920,"_25639":59898,"_17911":100492,"_5":17806,"_24291":100425,"_2452":100493},[],"La identidad está en la ventana operativa de renovación.",{"_2926":59921,"_25639":59898,"_17911":100495,"_5":17806,"_24291":100425,"_2452":44159},[],{"_2926":59922,"_25639":59898,"_17911":100497,"_5":17806,"_24291":100425,"_2452":100498},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_2926":59923,"_25639":59898,"_17911":100500,"_5":17806,"_24291":100425,"_2452":44165},[],{"_2926":59924,"_25639":59898,"_17911":100502,"_5":17806,"_24291":100425,"_2452":100503},[],"La identidad ha vencido.",{"_2926":59925,"_25639":59898,"_17911":100505,"_5":17806,"_24291":100425,"_2452":44171},[],{"_2926":59926,"_25639":59898,"_17911":100507,"_5":17806,"_24291":100425,"_2452":100508},[],"La identidad está marcada como revocada.",{"_2926":59927,"_25639":59898,"_17911":100510,"_5":17806,"_24291":100425,"_2452":44177},[],{"_2926":59928,"_25639":59898,"_17911":100512,"_5":17806,"_24291":100425,"_2452":100513},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_2926":59929,"_25639":59898,"_17911":100515,"_5":17806,"_24291":100425,"_2452":100516},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_2926":59930,"_25639":59898,"_17911":100518,"_5":17806,"_24291":100429,"_2452":100519},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_2926":59931,"_25639":59898,"_17911":100521,"_5":17806,"_24291":100429,"_2452":100522},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_2926":59932,"_25639":59898,"_17911":100524,"_5":17806,"_24291":100429,"_2452":100525},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_2926":59933,"_25639":59898,"_17911":100527,"_5":17806,"_24291":100429,"_2452":100528},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_2926":59934,"_25639":59898,"_17911":100530,"_5":17806,"_24291":100433,"_2452":100531},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_2926":59935,"_25639":59898,"_17911":100533,"_5":17806,"_24291":100437,"_2452":100534},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_2926":59936,"_25639":59898,"_17911":100536,"_5":17806,"_24291":100441,"_2452":100537},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_2926":59937,"_25639":59898,"_17911":100539,"_5":17806,"_24291":100445,"_2452":100540},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_2926":59938,"_25639":59898,"_17911":100542,"_5":17806,"_24291":100449,"_2452":100543},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_2926":59939,"_25639":59898,"_17911":100545,"_5":17806,"_24291":100449,"_2452":100546},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_2926":59940,"_25639":59898,"_17911":100548,"_5":17806,"_24291":100453,"_2452":100549},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_2926":59941,"_25639":59898,"_17911":100551,"_5":17806,"_24291":100453,"_2452":100552},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_2926":59942,"_25639":59898,"_17911":100554,"_5":17806,"_24291":100453,"_2452":100555},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_2926":59943,"_25639":59898,"_17911":100557,"_5":17806,"_24291":100453,"_2452":100558},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_2926":59944,"_25639":59898,"_17911":100560,"_5":17806,"_24291":100453,"_2452":100561},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_2926":59945,"_25639":59898,"_17911":100563,"_5":17806,"_24291":100453,"_2452":100564},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_2926":59946,"_25639":59898,"_17911":100566,"_5":17806,"_24291":100457,"_2452":100567},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_2926":59947,"_25639":59898,"_17911":100569,"_5":17806,"_24291":100457,"_2452":100570},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_2926":59948,"_25639":59898,"_17911":100572,"_5":17806,"_24291":100461,"_2452":100573},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_2926":59949,"_25639":59898,"_17911":100575,"_5":17806,"_24291":100461,"_2452":100576},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_2926":59950,"_25639":59898,"_17911":100578,"_5":17806,"_24291":100461,"_2452":100579},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_2926":59951,"_25639":59898,"_17911":100581,"_5":17806,"_24291":100461,"_2452":100582},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_2926":59952,"_25639":59898,"_17911":100584,"_5":17806,"_24291":100465,"_2452":100585},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2926":59953,"_25639":59898,"_17911":100587,"_5":17806,"_24291":100465,"_2452":100588},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2926":59954,"_25639":59954,"_5":12558,"_2452":100590,"_25983":100591,"_17911":100593,"_24291":59954},"Identidad inicial y autenticación",[41760,99445,44078,100417,100592],"Enrolamiento con PKI",[],{"_2926":59955,"_25639":59954,"_17911":100595,"_5":17806,"_24291":59954,"_2452":100596},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_2926":59956,"_25639":59954,"_5":25980,"_17911":100598,"_24291":100599,"_2452":100600},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_2926":59957,"_25639":59954,"_5":25980,"_17911":100602,"_24291":100603,"_2452":100604},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_2926":59958,"_25639":59954,"_5":25980,"_17911":100606,"_24291":100607,"_2452":100608},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_2926":59959,"_25639":59954,"_5":25980,"_17911":100610,"_24291":100611,"_2452":100612},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_2926":59960,"_25639":59954,"_5":25980,"_17911":100614,"_24291":100615,"_2452":100616},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_2926":59961,"_25639":59954,"_17911":100618,"_5":17806,"_24291":59954,"_2452":100619},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_2926":59962,"_25639":59954,"_17911":100621,"_5":17806,"_24291":100599,"_2452":100622},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_2926":59963,"_25639":59954,"_17911":100624,"_5":17806,"_24291":100599,"_2452":100625},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_2926":59964,"_25639":59954,"_17911":100627,"_5":17806,"_24291":100603,"_2452":100628},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_2926":59965,"_25639":59954,"_17911":100630,"_5":17806,"_24291":100603,"_2452":100631},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_2926":59966,"_25639":59954,"_17911":100633,"_5":17806,"_24291":100603,"_2452":100634},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_2926":59967,"_25639":59954,"_17911":100636,"_5":17806,"_24291":100607,"_2452":100637},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_2926":59968,"_25639":59954,"_17911":100639,"_5":17806,"_24291":100607,"_2452":100640},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_2926":59969,"_25639":59954,"_17911":100642,"_5":17806,"_24291":100611,"_2452":100643},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_2926":59970,"_25639":59954,"_17911":100645,"_5":17806,"_24291":100611,"_2452":100646},[],"Ejemplo de cuerpo:",{"_2926":59971,"_25639":59954,"_17911":100648,"_5":17806,"_24291":100611,"_2452":100649},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_2926":59972,"_25639":59954,"_17911":100651,"_5":17806,"_24291":100611,"_2452":100652},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_2926":59973,"_25639":59954,"_17911":100654,"_5":17806,"_24291":100611,"_2452":100655},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_2926":59974,"_25639":59954,"_17911":100657,"_5":17806,"_24291":100611,"_2452":100658},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_2926":59975,"_25639":59954,"_17911":100660,"_5":17806,"_24291":100615,"_2452":100661},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_2926":59976,"_25639":59954,"_17911":100663,"_5":17806,"_24291":100615,"_2452":100664},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_2926":59977,"_25639":59977,"_5":12558,"_2452":100666,"_25983":100667,"_17911":100668,"_24291":59977},"Configura y opera el DMS",[41760,99445,44078,100417,100592],[],{"_2926":59978,"_25639":59977,"_17911":100670,"_5":17806,"_24291":59977,"_2452":100671},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_2926":59979,"_25639":59977,"_5":25980,"_17911":100673,"_24291":100674,"_2452":98146},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_2926":59980,"_25639":59977,"_5":25980,"_17911":100676,"_24291":100677,"_2452":100678},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_2926":59981,"_25639":59977,"_5":25980,"_17911":100680,"_24291":100681,"_2452":100682},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_2926":59982,"_25639":59977,"_5":25980,"_17911":100684,"_24291":100685,"_2452":100686},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_2926":59983,"_25639":59977,"_5":25980,"_17911":100688,"_24291":100689,"_2452":100690},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_2926":59984,"_25639":59977,"_5":25980,"_17911":100692,"_24291":100693,"_2452":100694},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_2926":59985,"_25639":59977,"_5":25980,"_17911":100696,"_24291":100697,"_2452":100698},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_2926":59986,"_25639":59977,"_5":25980,"_17911":100700,"_24291":100701,"_2452":100702},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_2926":59987,"_25639":59977,"_5":25980,"_17911":100704,"_24291":100705,"_2452":44373},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_2926":59988,"_25639":59977,"_5":25980,"_17911":100707,"_24291":100708,"_2452":44377},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_2926":59989,"_25639":59977,"_5":25980,"_17911":100710,"_24291":100711,"_2452":100712},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_2926":59990,"_25639":59977,"_5":25980,"_17911":100714,"_24291":100715,"_2452":100716},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_2926":59991,"_25639":59977,"_5":25980,"_17911":100718,"_24291":100719,"_2452":100720},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_2926":59992,"_25639":59977,"_5":25980,"_17911":100722,"_24291":100723,"_2452":100724},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_2926":59993,"_25639":59977,"_5":25980,"_17911":100726,"_24291":100727,"_2452":44397},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_2926":59994,"_25639":59977,"_5":25980,"_17911":100729,"_24291":100730,"_2452":100731},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_2926":59995,"_25639":59977,"_5":25980,"_17911":100733,"_24291":100734,"_2452":100735},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_2926":59996,"_25639":59977,"_5":25980,"_17911":100737,"_24291":100738,"_2452":100739},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_2926":59997,"_25639":59977,"_17911":100741,"_5":17806,"_24291":59977,"_2452":100742},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_2926":59998,"_25639":59977,"_17911":100744,"_5":17806,"_24291":100674,"_2452":100745},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_2926":59999,"_25639":59977,"_17911":100747,"_5":17806,"_24291":100674,"_2452":100748},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_2926":60000,"_25639":59977,"_17911":100750,"_5":17806,"_24291":100681,"_2452":100751},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_2926":60001,"_25639":59977,"_17911":100753,"_5":17806,"_24291":100685,"_2452":100754},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_2926":60002,"_25639":59977,"_17911":100756,"_5":17806,"_24291":100689,"_2452":100757},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_2926":60003,"_25639":59977,"_17911":100759,"_5":17806,"_24291":100693,"_2452":100760},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_2926":60004,"_25639":59977,"_17911":100762,"_5":17806,"_24291":100697,"_2452":100763},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_2926":60005,"_25639":59977,"_17911":100765,"_5":17806,"_24291":100705,"_2452":100766},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_2926":60006,"_25639":59977,"_17911":100768,"_5":17806,"_24291":100705,"_2452":100769},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_2926":60007,"_25639":59977,"_17911":100771,"_5":17806,"_24291":100708,"_2452":100772},[],"Campo de `settings.enrollment_settings`",{"_2926":60008,"_25639":59977,"_17911":100774,"_5":17806,"_24291":100708,"_2452":100775},[],"Decisión",{"_2926":60009,"_25639":59977,"_17911":100777,"_5":17806,"_24291":100708,"_2452":44448},[],{"_2926":60010,"_25639":59977,"_17911":100779,"_5":17806,"_24291":100708,"_2452":100780},[],"`EST_RFC7030` para estas operaciones.",{"_2926":60011,"_25639":59977,"_17911":100782,"_5":17806,"_24291":100708,"_2452":44454},[],{"_2926":60012,"_25639":59977,"_17911":100784,"_5":17806,"_24291":100708,"_2452":100785},[],"ID de la CA que firmará.",{"_2926":60013,"_25639":59977,"_17911":100787,"_5":17806,"_24291":100708,"_2452":44460},[],{"_2926":60014,"_25639":59977,"_17911":100789,"_5":17806,"_24291":100708,"_2452":100790},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_2926":60015,"_25639":59977,"_17911":100792,"_5":17806,"_24291":100708,"_2452":44466},[],{"_2926":60016,"_25639":59977,"_17911":100794,"_5":17806,"_24291":100708,"_2452":100795},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_2926":60017,"_25639":59977,"_17911":100797,"_5":17806,"_24291":100708,"_2452":44472},[],{"_2926":60018,"_25639":59977,"_17911":100799,"_5":17806,"_24291":100708,"_2452":100800},[],"Uno de los cuatro modos de autenticación.",{"_2926":60019,"_25639":59977,"_17911":100802,"_5":17806,"_24291":100708,"_2452":100803},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_2926":60020,"_25639":59977,"_17911":100805,"_5":17806,"_24291":100711,"_2452":100806},[],"Los bloques son independientes:",{"_2926":60021,"_25639":59977,"_17911":100808,"_5":17806,"_24291":100711,"_2452":100809},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_2926":60022,"_25639":59977,"_17911":100811,"_5":17806,"_24291":100711,"_2452":100812},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_2926":60023,"_25639":59977,"_17911":100814,"_5":17806,"_24291":100711,"_2452":44490},[],{"_2926":60024,"_25639":59977,"_17911":100816,"_5":17806,"_24291":100711,"_2452":100817},[],"Control aplicado en la operación configurada",{"_2926":60025,"_25639":59977,"_17911":100819,"_5":17806,"_24291":100711,"_2452":44496},[],{"_2926":60026,"_25639":59977,"_17911":100821,"_5":17806,"_24291":100711,"_2452":100822},[],"Validación del certificado presentado.",{"_2926":60027,"_25639":59977,"_17911":100824,"_5":17806,"_24291":100711,"_2452":44502},[],{"_2926":60028,"_25639":59977,"_17911":100826,"_5":17806,"_24291":100711,"_2452":100827},[],"Autorización del webhook configurado.",{"_2926":60029,"_25639":59977,"_17911":100829,"_5":17806,"_24291":100711,"_2452":44508},[],{"_2926":60030,"_25639":59977,"_17911":100831,"_5":17806,"_24291":100711,"_2452":100832},[],"Validación del certificado y, después, aprobación del webhook.",{"_2926":60031,"_25639":59977,"_17911":100834,"_5":17806,"_24291":100711,"_2452":44514},[],{"_2926":60032,"_25639":59977,"_17911":100836,"_5":17806,"_24291":100711,"_2452":100837},[],"Sin autenticación del solicitante por el DMS.",{"_2926":60033,"_25639":59977,"_17911":100839,"_5":17806,"_24291":100711,"_2452":100840},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_2926":60034,"_25639":59977,"_17911":100842,"_5":17806,"_24291":100711,"_2452":100843},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_2926":60035,"_25639":59977,"_17911":100845,"_5":17806,"_24291":100711,"_2452":100846},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_2926":60036,"_25639":59977,"_17911":100848,"_5":17806,"_24291":100711,"_2452":100849},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_2926":60037,"_25639":59977,"_17911":100851,"_5":17806,"_24291":100715,"_2452":100852},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_2926":60038,"_25639":59977,"_17911":100854,"_5":17806,"_24291":100715,"_2452":100855},[],"Campo de `external_webhook_settings`",{"_2926":60039,"_25639":59977,"_17911":100857,"_5":17806,"_24291":100715,"_2452":100775},[],{"_2926":60040,"_25639":59977,"_17911":100859,"_5":17806,"_24291":100715,"_2452":44540},[],{"_2926":60041,"_25639":59977,"_17911":100861,"_5":17806,"_24291":100715,"_2452":100862},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_2926":60042,"_25639":59977,"_17911":100864,"_5":17806,"_24291":100715,"_2452":44546},[],{"_2926":60043,"_25639":59977,"_17911":100866,"_5":17806,"_24291":100715,"_2452":100867},[],"`POST` o `PUT`; `POST` por defecto.",{"_2926":60044,"_25639":59977,"_17911":100869,"_5":17806,"_24291":100715,"_2452":44552},[],{"_2926":60045,"_25639":59977,"_17911":100871,"_5":17806,"_24291":100715,"_2452":100872},[],"Etiqueta usada en los logs del servicio.",{"_2926":60046,"_25639":59977,"_17911":100874,"_5":17806,"_24291":100715,"_2452":44558},[],{"_2926":60047,"_25639":59977,"_17911":100876,"_5":17806,"_24291":100715,"_2452":100877},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_2926":60048,"_25639":59977,"_17911":100879,"_5":17806,"_24291":100715,"_2452":44564},[],{"_2926":60049,"_25639":59977,"_17911":100881,"_5":17806,"_24291":100715,"_2452":100882},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_2926":60050,"_25639":59977,"_17911":100884,"_5":17806,"_24291":100715,"_2452":44570},[],{"_2926":60051,"_25639":59977,"_17911":100886,"_5":17806,"_24291":100715,"_2452":100887},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2926":60052,"_25639":59977,"_17911":100889,"_5":17806,"_24291":100715,"_2452":44576},[],{"_2926":60053,"_25639":59977,"_17911":100891,"_5":17806,"_24291":100715,"_2452":100892},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_2926":60054,"_25639":59977,"_17911":100894,"_5":17806,"_24291":100715,"_2452":44582},[],{"_2926":60055,"_25639":59977,"_17911":100896,"_5":17806,"_24291":100715,"_2452":100897},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_2926":60056,"_25639":59977,"_17911":100899,"_5":17806,"_24291":100715,"_2452":44588},[],{"_2926":60057,"_25639":59977,"_17911":100901,"_5":17806,"_24291":100715,"_2452":100902},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_2926":60058,"_25639":59977,"_17911":100904,"_5":17806,"_24291":100715,"_2452":100905},[],"Reglas de esa configuración:",{"_2926":60059,"_25639":59977,"_17911":100907,"_5":17806,"_24291":100715,"_2452":100908},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_2926":60060,"_25639":59977,"_17911":100910,"_5":17806,"_24291":100715,"_2452":100911},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_2926":60061,"_25639":59977,"_17911":100913,"_5":17806,"_24291":100715,"_2452":100914},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_2926":60062,"_25639":59977,"_17911":100916,"_5":17806,"_24291":100715,"_2452":100917},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_2926":60063,"_25639":59977,"_17911":100919,"_5":17806,"_24291":100715,"_2452":100920},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_2926":60064,"_25639":59977,"_17911":100922,"_5":17806,"_24291":100715,"_2452":100923},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_2926":60065,"_25639":59977,"_17911":100925,"_5":17806,"_24291":100715,"_2452":100926},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar, y si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_2926":60066,"_25639":59977,"_17911":100928,"_5":17806,"_24291":100715,"_2452":100929},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_2926":60067,"_25639":59977,"_17911":100931,"_5":17806,"_24291":100715,"_2452":100932},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_2926":60068,"_25639":59977,"_17911":100934,"_5":17806,"_24291":100719,"_2452":100935},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_2926":60069,"_25639":59977,"_17911":100937,"_5":17806,"_24291":100723,"_2452":100938},[],"Campo de `settings.reenrollment_settings`",{"_2926":60070,"_25639":59977,"_17911":100940,"_5":17806,"_24291":100723,"_2452":100941},[],"Función",{"_2926":60071,"_25639":59977,"_17911":100943,"_5":17806,"_24291":100723,"_2452":44632},[],{"_2926":60072,"_25639":59977,"_17911":100945,"_5":17806,"_24291":100723,"_2452":100946},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_2926":60073,"_25639":59977,"_17911":100948,"_5":17806,"_24291":100723,"_2452":44638},[],{"_2926":60074,"_25639":59977,"_17911":100950,"_5":17806,"_24291":100723,"_2452":100951},[],"Umbral operativo preventivo de monitorización.",{"_2926":60075,"_25639":59977,"_17911":100953,"_5":17806,"_24291":100723,"_2452":44644},[],{"_2926":60076,"_25639":59977,"_17911":100955,"_5":17806,"_24291":100723,"_2452":100956},[],"Umbral operativo crítico de monitorización.",{"_2926":60077,"_25639":59977,"_17911":100958,"_5":17806,"_24291":100723,"_2452":44650},[],{"_2926":60078,"_25639":59977,"_17911":100960,"_5":17806,"_24291":100723,"_2452":100961},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_2926":60079,"_25639":59977,"_17911":100963,"_5":17806,"_24291":100723,"_2452":44656},[],{"_2926":60080,"_25639":59977,"_17911":100965,"_5":17806,"_24291":100723,"_2452":100966},[],"CAs de validación adicionales para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_2926":60081,"_25639":59977,"_17911":100968,"_5":17806,"_24291":100723,"_2452":44662},[],{"_2926":60082,"_25639":59977,"_17911":100970,"_5":17806,"_24291":100723,"_2452":100971},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_2926":60083,"_25639":59977,"_17911":100973,"_5":17806,"_24291":100723,"_2452":100974},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_2926":60084,"_25639":59977,"_17911":100976,"_5":17806,"_24291":100727,"_2452":100977},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. Algoritmo y tamaño proceden de su campo `key`; el perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_2926":60085,"_25639":59977,"_17911":100979,"_5":17806,"_24291":100730,"_2452":98503},[],{"_2926":60086,"_25639":59977,"_17911":100981,"_5":17806,"_24291":100730,"_2452":100982},[],"Qué publica",{"_2926":60087,"_25639":59977,"_17911":100984,"_5":17806,"_24291":100730,"_2452":44679},[],{"_2926":60088,"_25639":59977,"_17911":100986,"_5":17806,"_24291":100730,"_2452":100987},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_2926":60089,"_25639":59977,"_17911":100989,"_5":17806,"_24291":100730,"_2452":44685},[],{"_2926":60090,"_25639":59977,"_17911":100991,"_5":17806,"_24291":100730,"_2452":100992},[],"Certificado de la CA emisora seleccionada.",{"_2926":60091,"_25639":59977,"_17911":100994,"_5":17806,"_24291":100730,"_2452":44691},[],{"_2926":60092,"_25639":59977,"_17911":100996,"_5":17806,"_24291":100730,"_2452":100997},[],"Certificados de las CAs elegidas explícitamente.",{"_2926":60093,"_25639":59977,"_17911":100999,"_5":17806,"_24291":100730,"_2452":101000},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_2926":60094,"_25639":59977,"_17911":101002,"_5":17806,"_24291":100734,"_2452":101003},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_2926":60095,"_25639":59977,"_17911":101005,"_5":17806,"_24291":100734,"_2452":101006},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_2926":60096,"_25639":59977,"_17911":101008,"_5":17806,"_24291":100734,"_2452":101009},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_2926":60097,"_25639":59977,"_17911":101011,"_5":17806,"_24291":100738,"_2452":101012},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_2926":60098,"_25639":60098,"_5":12558,"_2452":101014,"_25983":101015,"_17911":101016,"_24291":60098},"Integra el cliente EST",[41760,99445,44078,100417,100592],[],{"_2926":60099,"_25639":60098,"_17911":101018,"_5":17806,"_24291":60098,"_2452":101019},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_2926":60100,"_25639":60098,"_5":25980,"_17911":101021,"_24291":101022,"_2452":98146},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_2926":60101,"_25639":60098,"_5":25980,"_17911":101024,"_24291":101025,"_2452":101026},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_2926":60102,"_25639":60098,"_5":25980,"_17911":101028,"_24291":101029,"_2452":101030},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_2926":60103,"_25639":60098,"_5":25980,"_17911":101032,"_24291":101033,"_2452":101034},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_2926":60104,"_25639":60098,"_5":25980,"_17911":101036,"_24291":101037,"_2452":101038},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_2926":60105,"_25639":60098,"_5":25980,"_17911":101040,"_24291":101041,"_2452":101042},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_2926":60106,"_25639":60098,"_17911":101044,"_5":17806,"_24291":60098,"_2452":101045},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_2926":60107,"_25639":60098,"_17911":101047,"_5":17806,"_24291":101022,"_2452":101048},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_2926":60108,"_25639":60098,"_17911":101050,"_5":17806,"_24291":101022,"_2452":101051},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_2926":60109,"_25639":60098,"_17911":101053,"_5":17806,"_24291":101022,"_2452":101054},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_2926":60110,"_25639":60098,"_17911":101056,"_5":17806,"_24291":101025,"_2452":101057},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_2926":60111,"_25639":60098,"_17911":101059,"_5":17806,"_24291":101025,"_2452":101060},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_2926":60112,"_25639":60098,"_17911":101062,"_5":17806,"_24291":101029,"_2452":101063},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_2926":60113,"_25639":60098,"_17911":101065,"_5":17806,"_24291":101029,"_2452":101066},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_2926":60114,"_25639":60098,"_17911":101068,"_5":17806,"_24291":101033,"_2452":101069},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_2926":60115,"_25639":60098,"_17911":101071,"_5":17806,"_24291":101033,"_2452":101072},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_2926":60116,"_25639":60098,"_17911":101074,"_5":17806,"_24291":101037,"_2452":101075},[],"Para el caso de una raíz que emite directamente:",{"_2926":60117,"_25639":60098,"_17911":101077,"_5":17806,"_24291":101037,"_2452":101078},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_2926":60118,"_25639":60098,"_17911":101080,"_5":17806,"_24291":101037,"_2452":101081},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_2926":60119,"_25639":60098,"_17911":101083,"_5":17806,"_24291":101041,"_2452":101084},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_2926":60120,"_25639":60120,"_5":12558,"_2452":101086,"_25983":101087,"_17911":101088,"_24291":60120},"Referencia EST",[41760,99445,44078,100417,100592],[],{"_2926":60121,"_25639":60120,"_17911":101090,"_5":17806,"_24291":60120,"_2452":101091},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_2926":60122,"_25639":60120,"_5":25980,"_17911":101093,"_24291":101094,"_2452":101095},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_2926":60123,"_25639":60120,"_5":25980,"_17911":101097,"_24291":101098,"_2452":19460},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2926":60124,"_25639":60120,"_5":25980,"_17911":101100,"_24291":101101,"_2452":22267},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2926":60125,"_25639":60120,"_5":25980,"_17911":101103,"_24291":101104,"_2452":22274},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2926":60126,"_25639":60120,"_5":25980,"_17911":101106,"_24291":101107,"_2452":21633},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2926":60127,"_25639":60120,"_5":25980,"_17911":101109,"_24291":101110,"_2452":101111},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_2926":60128,"_25639":60120,"_5":25980,"_17911":101113,"_24291":101114,"_2452":101115},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_2926":60129,"_25639":60120,"_5":25980,"_17911":101117,"_24291":101118,"_2452":101119},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_2926":60130,"_25639":60120,"_17911":101121,"_5":17806,"_24291":60120,"_2452":101122},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_2926":60131,"_25639":60120,"_17911":101124,"_5":17806,"_24291":101094,"_2452":101125},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_2926":60132,"_25639":60120,"_17911":101127,"_5":17806,"_24291":101094,"_2452":99236},[],{"_2926":60133,"_25639":60120,"_17911":101129,"_5":17806,"_24291":101094,"_2452":101130},[],"Método",{"_2926":60134,"_25639":60120,"_17911":101132,"_5":17806,"_24291":101094,"_2452":101133},[],"Autenticación y condición",{"_2926":60135,"_25639":60120,"_17911":101135,"_5":17806,"_24291":101094,"_2452":44834},[],{"_2926":60136,"_25639":60120,"_17911":101137,"_5":17806,"_24291":101094,"_2452":44837},[],{"_2926":60137,"_25639":60120,"_17911":101139,"_5":17806,"_24291":101094,"_2452":101140},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_2926":60138,"_25639":60120,"_17911":101142,"_5":17806,"_24291":101094,"_2452":44843},[],{"_2926":60139,"_25639":60120,"_17911":101144,"_5":17806,"_24291":101094,"_2452":44846},[],{"_2926":60140,"_25639":60120,"_17911":101146,"_5":17806,"_24291":101094,"_2452":101147},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_2926":60141,"_25639":60120,"_17911":101149,"_5":17806,"_24291":101094,"_2452":44852},[],{"_2926":60142,"_25639":60120,"_17911":101151,"_5":17806,"_24291":101094,"_2452":44846},[],{"_2926":60143,"_25639":60120,"_17911":101153,"_5":17806,"_24291":101094,"_2452":101154},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_2926":60144,"_25639":60120,"_17911":101156,"_5":17806,"_24291":101094,"_2452":44860},[],{"_2926":60145,"_25639":60120,"_17911":101158,"_5":17806,"_24291":101094,"_2452":44846},[],{"_2926":60146,"_25639":60120,"_17911":101160,"_5":17806,"_24291":101094,"_2452":101161},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_2926":60147,"_25639":60120,"_17911":101163,"_5":17806,"_24291":101094,"_2452":101164},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_2926":60148,"_25639":60120,"_17911":101166,"_5":17806,"_24291":101098,"_2452":101167},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_2926":60149,"_25639":60120,"_17911":101169,"_5":17806,"_24291":101098,"_2452":101170},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_2926":60150,"_25639":60120,"_17911":101172,"_5":17806,"_24291":101101,"_2452":101173},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_2926":60151,"_25639":60120,"_17911":101175,"_5":17806,"_24291":101101,"_2452":101176},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_2926":60152,"_25639":60120,"_17911":101178,"_5":17806,"_24291":101104,"_2452":101179},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_2926":60153,"_25639":60120,"_17911":101181,"_5":17806,"_24291":101104,"_2452":101182},[],"La CA de enrolamiento o una CA de validación configurada en el bloque de reenrolamiento valida la credencial en el modo mTLS. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_2926":60154,"_25639":60120,"_17911":101184,"_5":17806,"_24291":101107,"_2452":101185},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_2926":60155,"_25639":60120,"_17911":101187,"_5":17806,"_24291":101107,"_2452":101188},[],"El código admite RSA y ECDSA de 224, 256, 384 o 521 bits. Un tamaño ECDSA no reconocido puede producir fallback a 256; elige explícitamente un tamaño compatible y comprueba la clave resultante. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_2926":60156,"_25639":60120,"_17911":101190,"_5":17806,"_24291":101110,"_2452":101191},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_2926":60157,"_25639":60120,"_17911":101193,"_5":17806,"_24291":101110,"_2452":101194},[],"Parte",{"_2926":60158,"_25639":60120,"_17911":101196,"_5":17806,"_24291":101110,"_2452":101197},[],"Contenido tras decodificar su Base64",{"_2926":60159,"_25639":60120,"_17911":101199,"_5":17806,"_24291":101110,"_2452":44904},[],{"_2926":60160,"_25639":60120,"_17911":101201,"_5":17806,"_24291":101110,"_2452":101202},[],"Clave privada PKCS#8 DER sin cifrar.",{"_2926":60161,"_25639":60120,"_17911":101204,"_5":17806,"_24291":101110,"_2452":44910},[],{"_2926":60162,"_25639":60120,"_17911":101206,"_5":17806,"_24291":101110,"_2452":101207},[],"PKCS#7 DER con el certificado emitido.",{"_2926":60163,"_25639":60120,"_17911":101209,"_5":17806,"_24291":101110,"_2452":101210},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_2926":60164,"_25639":60120,"_17911":101212,"_5":17806,"_24291":101114,"_2452":101213},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_2926":60165,"_25639":60120,"_17911":101215,"_5":17806,"_24291":101114,"_2452":101216},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_2926":60166,"_25639":60120,"_17911":101218,"_5":17806,"_24291":101114,"_2452":101219},[],"Convierte y comprueba el resultado:",{"_2926":60167,"_25639":60120,"_17911":101221,"_5":17806,"_24291":101114,"_2452":101222},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_2926":60168,"_25639":60120,"_17911":101224,"_5":17806,"_24291":101118,"_2452":101225},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_2926":60169,"_25639":60120,"_17911":101227,"_5":17806,"_24291":101118,"_2452":101228},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_2926":60170,"_25639":60170,"_5":12558,"_2452":100592,"_25983":101230,"_17911":101231,"_24291":60170},[41760,99445,44078,100417,100592],[],{"_2926":60171,"_25639":60170,"_17911":101233,"_5":17806,"_24291":60170,"_2452":101234},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_2926":60172,"_25639":60170,"_5":25980,"_17911":101236,"_24291":101237,"_2452":101238},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_2926":60173,"_25639":60170,"_5":25980,"_17911":101240,"_24291":101241,"_2452":101242},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_2926":60174,"_25639":60170,"_5":25980,"_17911":101244,"_24291":101245,"_2452":101246},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_2926":60175,"_25639":60170,"_5":25980,"_17911":101248,"_24291":101249,"_2452":101250},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_2926":60176,"_25639":60170,"_17911":101252,"_5":17806,"_24291":60170,"_2452":101253},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_2926":60177,"_25639":60170,"_17911":101255,"_5":17806,"_24291":101237,"_2452":101256},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_2926":60178,"_25639":60170,"_17911":101258,"_5":17806,"_24291":101237,"_2452":101259},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_2926":60179,"_25639":60170,"_17911":101261,"_5":17806,"_24291":101237,"_2452":101262},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_2926":60180,"_25639":60170,"_17911":101264,"_5":17806,"_24291":101237,"_2452":101265},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_2926":60181,"_25639":60170,"_17911":101267,"_5":17806,"_24291":101237,"_2452":101268},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_2926":60182,"_25639":60170,"_17911":101270,"_5":17806,"_24291":101237,"_2452":101271},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_2926":60183,"_25639":60170,"_17911":101273,"_5":17806,"_24291":101241,"_2452":101274},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2926":60184,"_25639":60170,"_17911":101276,"_5":17806,"_24291":101241,"_2452":101277},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2926":60185,"_25639":60170,"_17911":101279,"_5":17806,"_24291":101241,"_2452":101280},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2926":60186,"_25639":60170,"_17911":101282,"_5":17806,"_24291":101241,"_2452":101283},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2926":60187,"_25639":60170,"_17911":101285,"_5":17806,"_24291":101245,"_2452":101286},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2926":60188,"_25639":60170,"_17911":101288,"_5":17806,"_24291":101245,"_2452":101289},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2926":60189,"_25639":60170,"_17911":101291,"_5":17806,"_24291":101245,"_2452":101292},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2926":60190,"_25639":60170,"_17911":101294,"_5":17806,"_24291":101245,"_2452":101295},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2926":60191,"_25639":60170,"_17911":101297,"_5":17806,"_24291":101249,"_2452":101298},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_2926":60192,"_25639":60170,"_17911":101300,"_5":17806,"_24291":101249,"_2452":101301},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_2926":60193,"_25639":60193,"_5":12558,"_2452":101303,"_25983":101304,"_17911":101305,"_24291":60193},"Estrategias de aprovisionamiento",[41760,99445,44078,100417,100592],[],{"_2926":60194,"_25639":60193,"_17911":101307,"_5":17806,"_24291":60193,"_2452":101308},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_2926":60195,"_25639":60193,"_5":25980,"_17911":101310,"_24291":101311,"_2452":101312},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_2926":60196,"_25639":60193,"_5":25980,"_17911":101314,"_24291":101315,"_2452":101316},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_2926":60197,"_25639":60193,"_5":25980,"_17911":101318,"_24291":101319,"_2452":101320},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_2926":60198,"_25639":60193,"_5":25980,"_17911":101322,"_24291":101323,"_2452":101324},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_2926":60199,"_25639":60193,"_5":25980,"_17911":101326,"_24291":101327,"_2452":101328},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_2926":60200,"_25639":60193,"_17911":101330,"_5":17806,"_24291":60193,"_2452":101331},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_2926":60201,"_25639":60193,"_17911":101333,"_5":17806,"_24291":101311,"_2452":101334},[],"Recorrido",{"_2926":60202,"_25639":60193,"_17911":101336,"_5":17806,"_24291":101311,"_2452":101337},[],"Cuándo existe el dispositivo",{"_2926":60203,"_25639":60193,"_17911":101339,"_5":17806,"_24291":101311,"_2452":101340},[],"Qué compruebas",{"_2926":60204,"_25639":60193,"_17911":101342,"_5":17806,"_24291":101311,"_2452":101343},[],"Asignación manual",{"_2926":60205,"_25639":60193,"_17911":101345,"_5":17806,"_24291":101311,"_2452":101346},[],"El operador lo crea antes de asociar un certificado.",{"_2926":60206,"_25639":60193,"_17911":101348,"_5":17806,"_24291":101311,"_2452":101349},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_2926":60207,"_25639":60193,"_17911":101351,"_5":17806,"_24291":101311,"_2452":101352},[],"EST con `JITP`",{"_2926":60208,"_25639":60193,"_17911":101354,"_5":17806,"_24291":101311,"_2452":101355},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_2926":60209,"_25639":60193,"_17911":101357,"_5":17806,"_24291":101311,"_2452":101358},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_2926":60210,"_25639":60193,"_17911":101360,"_5":17806,"_24291":101311,"_2452":101361},[],"EST con `PRE_REGISTRATION`",{"_2926":60211,"_25639":60193,"_17911":101363,"_5":17806,"_24291":101311,"_2452":101364},[],"Debe existir antes de `/simpleenroll`.",{"_2926":60212,"_25639":60193,"_17911":101366,"_5":17806,"_24291":101311,"_2452":101367},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_2926":60213,"_25639":60193,"_17911":101369,"_5":17806,"_24291":101311,"_2452":101370},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_2926":60214,"_25639":60193,"_17911":101372,"_5":17806,"_24291":101311,"_2452":101373},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_2926":60215,"_25639":60193,"_17911":101375,"_5":17806,"_24291":101315,"_2452":101376},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_2926":60216,"_25639":60193,"_17911":101378,"_5":17806,"_24291":101315,"_2452":101379},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_2926":60217,"_25639":60193,"_17911":101381,"_5":17806,"_24291":101315,"_2452":101382},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_2926":60218,"_25639":60193,"_17911":101384,"_5":17806,"_24291":101319,"_2452":101385},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_2926":60219,"_25639":60193,"_17911":101387,"_5":17806,"_24291":101319,"_2452":101388},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_2926":60220,"_25639":60193,"_17911":101390,"_5":17806,"_24291":101319,"_2452":101391},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_2926":60221,"_25639":60193,"_17911":101393,"_5":17806,"_24291":101319,"_2452":101394},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_2926":60222,"_25639":60193,"_17911":101396,"_5":17806,"_24291":101319,"_2452":101397},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_2926":60223,"_25639":60193,"_17911":101399,"_5":17806,"_24291":101319,"_2452":101400},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_2926":60224,"_25639":60193,"_17911":101402,"_5":17806,"_24291":101323,"_2452":98503},[],{"_2926":60225,"_25639":60193,"_17911":101404,"_5":17806,"_24291":101323,"_2452":101405},[],"Material que atraviesa EST",{"_2926":60226,"_25639":60193,"_17911":101407,"_5":17806,"_24291":101323,"_2452":101408},[],"Clave generada por el dispositivo",{"_2926":60227,"_25639":60193,"_17911":101410,"_5":17806,"_24291":101323,"_2452":101411},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_2926":60228,"_25639":60193,"_17911":101413,"_5":17806,"_24291":101323,"_2452":101414},[],"Clave ya disponible en el dispositivo",{"_2926":60229,"_25639":60193,"_17911":101416,"_5":17806,"_24291":101323,"_2452":101417},[],"CSR firmada con la clave existente y certificado nuevo.",{"_2926":60230,"_25639":60193,"_17911":101419,"_5":17806,"_24291":101323,"_2452":44397},[],{"_2926":60231,"_25639":60193,"_17911":101421,"_5":17806,"_24291":101323,"_2452":101422},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_2926":60232,"_25639":60193,"_17911":101424,"_5":17806,"_24291":101323,"_2452":101425},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_2926":60233,"_25639":60193,"_17911":101427,"_5":17806,"_24291":101327,"_2452":101428},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_2926":60234,"_25639":60234,"_5":12558,"_2452":101430,"_25983":101431,"_17911":101432,"_24291":60234},"Renovación y recuperación",[41760,99445,44078,100417,100592],[],{"_2926":60235,"_25639":60234,"_17911":101434,"_5":17806,"_24291":60234,"_2452":101435},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_2926":60236,"_25639":60234,"_5":25980,"_17911":101437,"_24291":101438,"_2452":101439},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_2926":60237,"_25639":60234,"_5":25980,"_17911":101441,"_24291":101442,"_2452":101443},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_2926":60238,"_25639":60234,"_5":25980,"_17911":101445,"_24291":101446,"_2452":101447},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_2926":60239,"_25639":60234,"_5":25980,"_17911":101449,"_24291":101450,"_2452":101451},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_2926":60240,"_25639":60234,"_5":25980,"_17911":101453,"_24291":101454,"_2452":101455},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_2926":60241,"_25639":60234,"_17911":101457,"_5":17806,"_24291":60234,"_2452":101458},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_2926":60242,"_25639":60234,"_17911":101460,"_5":17806,"_24291":101438,"_2452":101461},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_2926":60243,"_25639":60234,"_17911":101463,"_5":17806,"_24291":101438,"_2452":101464},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_2926":60244,"_25639":60234,"_17911":101466,"_5":17806,"_24291":101438,"_2452":101467},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_2926":60245,"_25639":60234,"_17911":101469,"_5":17806,"_24291":101438,"_2452":101470},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_2926":60246,"_25639":60234,"_17911":101472,"_5":17806,"_24291":101442,"_2452":101473},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_2926":60247,"_25639":60234,"_17911":101475,"_5":17806,"_24291":101442,"_2452":101476},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_2926":60248,"_25639":60234,"_17911":101478,"_5":17806,"_24291":101446,"_2452":101479},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_2926":60249,"_25639":60234,"_17911":101481,"_5":17806,"_24291":101446,"_2452":101482},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_2926":60250,"_25639":60234,"_17911":101484,"_5":17806,"_24291":101446,"_2452":101485},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_2926":60251,"_25639":60234,"_17911":101487,"_5":17806,"_24291":101450,"_2452":101488},[],"Situación",{"_2926":60252,"_25639":60234,"_17911":101490,"_5":17806,"_24291":101450,"_2452":101491},[],"Procedimiento",{"_2926":60253,"_25639":60234,"_17911":101493,"_5":17806,"_24291":101450,"_2452":101494},[],"Certificado vigente, fuera de ventana",{"_2926":60254,"_25639":60234,"_17911":101496,"_5":17806,"_24291":101450,"_2452":101497},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_2926":60255,"_25639":60234,"_17911":101499,"_5":17806,"_24291":101450,"_2452":101500},[],"Certificado vencido, clave disponible",{"_2926":60256,"_25639":60234,"_17911":101502,"_5":17806,"_24291":101450,"_2452":101503},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_2926":60257,"_25639":60234,"_17911":101505,"_5":17806,"_24291":101450,"_2452":101506},[],"Renovación por webhook o `NO_AUTH`",{"_2926":60258,"_25639":60234,"_17911":101508,"_5":17806,"_24291":101450,"_2452":101509},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_2926":60259,"_25639":60234,"_17911":101511,"_5":17806,"_24291":101450,"_2452":101512},[],"Clave perdida o inaccesible",{"_2926":60260,"_25639":60234,"_17911":101514,"_5":17806,"_24291":101450,"_2452":101515},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_2926":60261,"_25639":60234,"_17911":101517,"_5":17806,"_24291":101450,"_2452":101518},[],"Identidad actual revocada",{"_2926":60262,"_25639":60234,"_17911":101520,"_5":17806,"_24291":101450,"_2452":101521},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_2926":60263,"_25639":60234,"_17911":101523,"_5":17806,"_24291":101450,"_2452":101524},[],"Dispositivo sin identidad",{"_2926":60264,"_25639":60234,"_17911":101526,"_5":17806,"_24291":101450,"_2452":101527},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_2926":60265,"_25639":60234,"_17911":101529,"_5":17806,"_24291":101450,"_2452":101530},[],"Dispositivo retirado",{"_2926":60266,"_25639":60234,"_17911":101532,"_5":17806,"_24291":101450,"_2452":101533},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_2926":60267,"_25639":60234,"_17911":101535,"_5":17806,"_24291":101450,"_2452":101536},[],"Timeout, HTTP 500 o fallo de instalación",{"_2926":60268,"_25639":60234,"_17911":101538,"_5":17806,"_24291":101450,"_2452":101539},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_2926":60269,"_25639":60234,"_17911":101541,"_5":17806,"_24291":101454,"_2452":101542},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_2926":60270,"_25639":60234,"_17911":101544,"_5":17806,"_24291":101454,"_2452":101545},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_2926":60271,"_25639":60271,"_5":12558,"_2452":101547,"_25983":101548,"_17911":101549,"_24291":60271},"Diagnóstico de enrolamiento",[41760,99445,44078,100417,100592],[],{"_2926":60272,"_25639":60271,"_17911":101551,"_5":17806,"_24291":60271,"_2452":101552},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_2926":60273,"_25639":60271,"_5":25980,"_17911":101554,"_24291":101555,"_2452":101556},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_2926":60274,"_25639":60271,"_5":25980,"_17911":101558,"_24291":101559,"_2452":101560},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_2926":60275,"_25639":60271,"_5":25980,"_17911":101562,"_24291":101563,"_2452":101119},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_2926":60276,"_25639":60271,"_5":25980,"_17911":101565,"_24291":101566,"_2452":101567},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_2926":60277,"_25639":60271,"_17911":101569,"_5":17806,"_24291":60271,"_2452":101570},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_2926":60278,"_25639":60271,"_17911":101572,"_5":17806,"_24291":101559,"_2452":101573},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_2926":60279,"_25639":60271,"_17911":101575,"_5":17806,"_24291":101559,"_2452":101576},[],"Síntoma o mensaje",{"_2926":60280,"_25639":60271,"_17911":101578,"_5":17806,"_24291":101559,"_2452":101579},[],"Qué revisar",{"_2926":60281,"_25639":60271,"_17911":101581,"_5":17806,"_24291":101559,"_2452":101582},[],"curl rechaza TLS, nombre o emisor",{"_2926":60282,"_25639":60271,"_17911":101584,"_5":17806,"_24291":101559,"_2452":101585},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_2926":60283,"_25639":60271,"_17911":101587,"_5":17806,"_24291":101559,"_2452":101588},[],"404 o APS ausente",{"_2926":60284,"_25639":60271,"_17911":101590,"_5":17806,"_24291":101559,"_2452":101591},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_2926":60285,"_25639":60271,"_17911":101593,"_5":17806,"_24291":101559,"_2452":101594},[],"400, error de CSR o formato",{"_2926":60286,"_25639":60271,"_17911":101596,"_5":17806,"_24291":101559,"_2452":101597},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_2926":60287,"_25639":60271,"_17911":101599,"_5":17806,"_24291":101559,"_2452":101600},[],"Credencial ausente o certificado no válido",{"_2926":60288,"_25639":60271,"_17911":101602,"_5":17806,"_24291":101559,"_2452":101603},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_2926":60289,"_25639":60271,"_17911":101605,"_5":17806,"_24291":101559,"_2452":101606},[],"Webhook deniega, expira o responde sin autorización",{"_2926":60290,"_25639":60271,"_17911":101608,"_5":17806,"_24291":101559,"_2452":101609},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_2926":60291,"_25639":60271,"_17911":101611,"_5":17806,"_24291":101559,"_2452":45317},[],{"_2926":60292,"_25639":60271,"_17911":101613,"_5":17806,"_24291":101559,"_2452":101614},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_2926":60293,"_25639":60271,"_17911":101616,"_5":17806,"_24291":101559,"_2452":45323},[],{"_2926":60294,"_25639":60271,"_17911":101618,"_5":17806,"_24291":101559,"_2452":101619},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_2926":60295,"_25639":60271,"_17911":101621,"_5":17806,"_24291":101559,"_2452":45329},[],{"_2926":60296,"_25639":60271,"_17911":101623,"_5":17806,"_24291":101559,"_2452":101624},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_2926":60297,"_25639":60271,"_17911":101626,"_5":17806,"_24291":101559,"_2452":45335},[],{"_2926":60298,"_25639":60271,"_17911":101628,"_5":17806,"_24291":101559,"_2452":101629},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_2926":60299,"_25639":60271,"_17911":101631,"_5":17806,"_24291":101559,"_2452":45341},[],{"_2926":60300,"_25639":60271,"_17911":101633,"_5":17806,"_24291":101559,"_2452":101634},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_2926":60301,"_25639":60271,"_17911":101636,"_5":17806,"_24291":101559,"_2452":101637},[],"400 `struct validation error` al crear o actualizar un DMS",{"_2926":60302,"_25639":60271,"_17911":101639,"_5":17806,"_24291":101559,"_2452":101640},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_2926":60303,"_25639":60271,"_17911":101642,"_5":17806,"_24291":101559,"_2452":101643},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_2926":60304,"_25639":60271,"_17911":101645,"_5":17806,"_24291":101559,"_2452":101646},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_2926":60305,"_25639":60271,"_17911":101648,"_5":17806,"_24291":101559,"_2452":45359},[],{"_2926":60306,"_25639":60271,"_17911":101650,"_5":17806,"_24291":101559,"_2452":101651},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_2926":60307,"_25639":60271,"_17911":101653,"_5":17806,"_24291":101559,"_2452":45365},[],{"_2926":60308,"_25639":60271,"_17911":101655,"_5":17806,"_24291":101559,"_2452":101656},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_2926":60309,"_25639":60271,"_17911":101658,"_5":17806,"_24291":101559,"_2452":101659},[],"DMS propietario distinto",{"_2926":60310,"_25639":60271,"_17911":101661,"_5":17806,"_24291":101559,"_2452":101662},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_2926":60311,"_25639":60271,"_17911":101664,"_5":17806,"_24291":101559,"_2452":45377},[],{"_2926":60312,"_25639":60271,"_17911":101666,"_5":17806,"_24291":101559,"_2452":101667},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_2926":60313,"_25639":60271,"_17911":101669,"_5":17806,"_24291":101559,"_2452":45383},[],{"_2926":60314,"_25639":60271,"_17911":101671,"_5":17806,"_24291":101559,"_2452":101672},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_2926":60315,"_25639":60271,"_17911":101674,"_5":17806,"_24291":101559,"_2452":101675},[],"Certificado actual revocado",{"_2926":60316,"_25639":60271,"_17911":101677,"_5":17806,"_24291":101559,"_2452":101678},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_2926":60317,"_25639":60271,"_17911":101680,"_5":17806,"_24291":101559,"_2452":101681},[],"Error de CA, perfil o firma",{"_2926":60318,"_25639":60271,"_17911":101683,"_5":17806,"_24291":101559,"_2452":101684},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_2926":60319,"_25639":60271,"_17911":101686,"_5":17806,"_24291":101559,"_2452":101687},[],"HTTP 200 sin conexión del dispositivo",{"_2926":60320,"_25639":60271,"_17911":101689,"_5":17806,"_24291":101559,"_2452":101690},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_2926":60321,"_25639":60271,"_17911":101692,"_5":17806,"_24291":101559,"_2452":101693},[],"Timeout o error después de emitir",{"_2926":60322,"_25639":60271,"_17911":101695,"_5":17806,"_24291":101559,"_2452":101696},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_2926":60323,"_25639":60271,"_17911":101698,"_5":17806,"_24291":101563,"_2452":101699},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_2926":60324,"_25639":60271,"_17911":101701,"_5":17806,"_24291":101563,"_2452":101702},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_2926":60325,"_25639":60271,"_17911":101704,"_5":17806,"_24291":101566,"_2452":101705},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_2926":60326,"_25639":60271,"_17911":101707,"_5":17806,"_24291":101566,"_2452":101708},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_2926":60327,"_25639":60271,"_17911":101710,"_5":17806,"_24291":101566,"_2452":101711},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_2926":60328,"_25639":60271,"_17911":101713,"_5":17806,"_24291":101566,"_2452":101714},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_2926":60329,"_25639":60271,"_17911":101716,"_5":17806,"_24291":101566,"_2452":101717},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_2926":60330,"_25639":60271,"_17911":101719,"_5":17806,"_24291":101566,"_2452":101720},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_2926":60331,"_25639":60271,"_17911":101722,"_5":17806,"_24291":101566,"_2452":101723},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_2926":60332,"_25639":60332,"_5":12558,"_2452":101725,"_25983":101726,"_17911":101727,"_24291":60332},"Distribución y actualización de confianza",[41760,99445,44078,100417,100592],[],{"_2926":60333,"_25639":60332,"_17911":101729,"_5":17806,"_24291":60332,"_2452":101730},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_2926":60334,"_25639":60332,"_5":25980,"_17911":101732,"_24291":101733,"_2452":101734},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_2926":60335,"_25639":60332,"_5":25980,"_17911":101736,"_24291":101737,"_2452":101738},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_2926":60336,"_25639":60332,"_5":25980,"_17911":101740,"_24291":101741,"_2452":101742},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_2926":60337,"_25639":60332,"_5":25980,"_17911":101744,"_24291":101745,"_2452":101746},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_2926":60338,"_25639":60332,"_5":25980,"_17911":101748,"_24291":101749,"_2452":101750},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_2926":60339,"_25639":60332,"_17911":101752,"_5":17806,"_24291":60332,"_2452":101753},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_2926":60340,"_25639":60332,"_17911":101755,"_5":17806,"_24291":101733,"_2452":101756},[],"Relación",{"_2926":60341,"_25639":60332,"_17911":101758,"_5":17806,"_24291":101733,"_2452":101759},[],"Material que prepara el responsable",{"_2926":60342,"_25639":60332,"_17911":101761,"_5":17806,"_24291":101733,"_2452":101762},[],"Dispositivo → servidor EST",{"_2926":60343,"_25639":60332,"_17911":101764,"_5":17806,"_24291":101733,"_2452":101765},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_2926":60344,"_25639":60332,"_17911":101767,"_5":17806,"_24291":101733,"_2452":101768},[],"DMS → solicitante",{"_2926":60345,"_25639":60332,"_17911":101770,"_5":17806,"_24291":101733,"_2452":101771},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_2926":60346,"_25639":60332,"_17911":101773,"_5":17806,"_24291":101733,"_2452":101774},[],"Consumidor → dispositivo",{"_2926":60347,"_25639":60332,"_17911":101776,"_5":17806,"_24291":101733,"_2452":101777},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_2926":60348,"_25639":60332,"_17911":101779,"_5":17806,"_24291":101733,"_2452":101780},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_2926":60349,"_25639":60332,"_17911":101782,"_5":17806,"_24291":101737,"_2452":101783},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_2926":60350,"_25639":60332,"_17911":101785,"_5":17806,"_24291":101737,"_2452":101786},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_2926":60351,"_25639":60332,"_17911":101788,"_5":17806,"_24291":101741,"_2452":101789},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_2926":60352,"_25639":60332,"_17911":101791,"_5":17806,"_24291":101741,"_2452":101792},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_2926":60353,"_25639":60332,"_17911":101794,"_5":17806,"_24291":101741,"_2452":101795},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_2926":60354,"_25639":60332,"_17911":101797,"_5":17806,"_24291":101741,"_2452":101798},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_2926":60355,"_25639":60332,"_17911":101800,"_5":17806,"_24291":101741,"_2452":101801},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_2926":60356,"_25639":60332,"_17911":101803,"_5":17806,"_24291":101741,"_2452":101804},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_2926":60357,"_25639":60332,"_17911":101806,"_5":17806,"_24291":101745,"_2452":101807},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_2926":60358,"_25639":60332,"_17911":101809,"_5":17806,"_24291":101745,"_2452":101810},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Al cambiar la CA de enrolamiento, añade a esa lista la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_2926":60359,"_25639":60332,"_17911":101812,"_5":17806,"_24291":101745,"_2452":101813},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_2926":60360,"_25639":60332,"_17911":101815,"_5":17806,"_24291":101749,"_2452":101816},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_2926":60361,"_25639":60361,"_5":12558,"_2452":45532,"_25983":101818,"_17911":101820,"_24291":60361},[41760,99445,44078,100417,101819],"Integraciones",[],{"_2926":60362,"_25639":60361,"_17911":101822,"_5":17806,"_24291":60361,"_2452":101823},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_2926":60363,"_25639":60361,"_5":25980,"_17911":101825,"_24291":101826,"_2452":101827},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_2926":60364,"_25639":60361,"_5":25980,"_17911":101829,"_24291":101830,"_2452":101831},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_2926":60365,"_25639":60361,"_5":25980,"_17911":101833,"_24291":101834,"_2452":101835},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_2926":60366,"_25639":60361,"_5":25980,"_17911":101837,"_24291":101838,"_2452":101839},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_2926":60367,"_25639":60361,"_5":25980,"_17911":101841,"_24291":101842,"_2452":101843},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_2926":60368,"_25639":60361,"_5":25980,"_17911":101845,"_24291":101846,"_2452":101847},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_2926":60369,"_25639":60361,"_5":25980,"_17911":101849,"_24291":101850,"_2452":45566},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_2926":60370,"_25639":60361,"_5":25980,"_17911":101852,"_24291":101853,"_2452":45570},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_2926":60371,"_25639":60361,"_5":25980,"_17911":101855,"_24291":101856,"_2452":101857},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_2926":60372,"_25639":60361,"_5":25980,"_17911":101859,"_24291":101860,"_2452":101861},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_2926":60373,"_25639":60361,"_5":25980,"_17911":101863,"_24291":101864,"_2452":101865},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_2926":60374,"_25639":60361,"_5":25980,"_17911":101867,"_24291":101868,"_2452":101869},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_2926":60375,"_25639":60361,"_5":25980,"_17911":101871,"_24291":101872,"_2452":101873},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_2926":60376,"_25639":60361,"_5":25980,"_17911":101875,"_24291":101876,"_2452":101877},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_2926":60377,"_25639":60361,"_5":25980,"_17911":101879,"_24291":101880,"_2452":101881},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_2926":60378,"_25639":60361,"_5":25980,"_17911":101883,"_24291":101884,"_2452":101885},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_2926":60379,"_25639":60361,"_5":25980,"_17911":101887,"_24291":101888,"_2452":101889},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_2926":60380,"_25639":60361,"_5":25980,"_17911":101891,"_24291":101892,"_2452":101893},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_2926":60381,"_25639":60361,"_5":25980,"_17911":101895,"_24291":101896,"_2452":101897},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_2926":60382,"_25639":60361,"_5":25980,"_17911":101899,"_24291":101900,"_2452":101901},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_2926":60383,"_25639":60361,"_17911":101903,"_5":17806,"_24291":60361,"_2452":101904},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_2926":60384,"_25639":60361,"_17911":101906,"_5":17806,"_24291":60361,"_2452":101907},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_2926":60385,"_25639":60361,"_17911":101909,"_5":17806,"_24291":60361,"_2452":101910},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_2926":60386,"_25639":60361,"_17911":101912,"_5":17806,"_24291":101826,"_2452":101913},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_2926":60387,"_25639":60361,"_17911":101915,"_5":17806,"_24291":101826,"_2452":101916},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_2926":60388,"_25639":60361,"_17911":101918,"_5":17806,"_24291":101826,"_2452":101919},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_2926":60389,"_25639":60361,"_17911":101921,"_5":17806,"_24291":101826,"_2452":101922},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_2926":60390,"_25639":60361,"_17911":101924,"_5":17806,"_24291":101830,"_2452":101925},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_2926":60391,"_25639":60361,"_17911":101927,"_5":17806,"_24291":101834,"_2452":101928},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_2926":60392,"_25639":60361,"_17911":101930,"_5":17806,"_24291":101834,"_2452":101931},[],"Acción IAM",{"_2926":60393,"_25639":60361,"_17911":101933,"_5":17806,"_24291":101834,"_2452":98509},[],{"_2926":60394,"_25639":60361,"_17911":101935,"_5":17806,"_24291":101834,"_2452":45653},[],{"_2926":60395,"_25639":60361,"_17911":101937,"_5":17806,"_24291":101834,"_2452":101938},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_2926":60396,"_25639":60361,"_17911":101940,"_5":17806,"_24291":101834,"_2452":45659},[],{"_2926":60397,"_25639":60361,"_17911":101942,"_5":17806,"_24291":101834,"_2452":101943},[],"Registrar la CA en AWS IoT",{"_2926":60398,"_25639":60361,"_17911":101945,"_5":17806,"_24291":101834,"_2452":45665},[],{"_2926":60399,"_25639":60361,"_17911":101947,"_5":17806,"_24291":101834,"_2452":101948},[],"Consultar el estado del registro de la CA",{"_2926":60400,"_25639":60361,"_17911":101950,"_5":17806,"_24291":101834,"_2452":45671},[],{"_2926":60401,"_25639":60361,"_17911":101952,"_5":17806,"_24291":101834,"_2452":101953},[],"Crear o actualizar Things en IoT Core",{"_2926":60402,"_25639":60361,"_17911":101955,"_5":17806,"_24291":101834,"_2452":45677},[],{"_2926":60403,"_25639":60361,"_17911":101957,"_5":17806,"_24291":101834,"_2452":101958},[],"Aprovisionar Things mediante plantilla",{"_2926":60404,"_25639":60361,"_17911":101960,"_5":17806,"_24291":101834,"_2452":45683},[],{"_2926":60405,"_25639":60361,"_17911":101962,"_5":17806,"_24291":101834,"_2452":101963},[],"Registrar certificados de dispositivo",{"_2926":60406,"_25639":60361,"_17911":101965,"_5":17806,"_24291":101834,"_2452":45689},[],{"_2926":60407,"_25639":60361,"_17911":101967,"_5":17806,"_24291":101834,"_2452":101968},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_2926":60408,"_25639":60361,"_17911":101970,"_5":17806,"_24291":101834,"_2452":45695},[],{"_2926":60409,"_25639":60361,"_17911":101972,"_5":17806,"_24291":101834,"_2452":101973},[],"Crear y adjuntar políticas IoT",{"_2926":60410,"_25639":60361,"_17911":101975,"_5":17806,"_24291":101834,"_2452":45701},[],{"_2926":60411,"_25639":60361,"_17911":101977,"_5":17806,"_24291":101834,"_2452":101978},[],"Gestionar grupos de Things",{"_2926":60412,"_25639":60361,"_17911":101980,"_5":17806,"_24291":101834,"_2452":45707},[],{"_2926":60413,"_25639":60361,"_17911":101982,"_5":17806,"_24291":101834,"_2452":101983},[],"Crear plantillas JITP",{"_2926":60414,"_25639":60361,"_17911":101985,"_5":17806,"_24291":101834,"_2452":45713},[],{"_2926":60415,"_25639":60361,"_17911":101987,"_5":17806,"_24291":101834,"_2452":101988},[],"Leer y escribir el Device Shadow",{"_2926":60416,"_25639":60361,"_17911":101990,"_5":17806,"_24291":101834,"_2452":101991},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_2926":60417,"_25639":60361,"_17911":101993,"_5":17806,"_24291":101838,"_2452":101994},[],"Parámetro",{"_2926":60418,"_25639":60361,"_17911":101996,"_5":17806,"_24291":101838,"_2452":101997},[],"Tipo",{"_2926":60419,"_25639":60361,"_17911":101999,"_5":17806,"_24291":101838,"_2452":102000},[],"Requerido",{"_2926":60420,"_25639":60361,"_17911":102002,"_5":17806,"_24291":101838,"_2452":102003},[],"Descripción",{"_2926":60421,"_25639":60361,"_17911":102005,"_5":17806,"_24291":101838,"_2452":45734},[],{"_2926":60422,"_25639":60361,"_17911":102007,"_5":17806,"_24291":101838,"_2452":21377},[],{"_2926":60423,"_25639":60361,"_17911":102009,"_5":17806,"_24291":101838,"_2452":102010},[],"Sí",{"_2926":60424,"_25639":60361,"_17911":102012,"_5":17806,"_24291":101838,"_2452":102013},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_2926":60425,"_25639":60361,"_17911":102015,"_5":17806,"_24291":101838,"_2452":45745},[],{"_2926":60426,"_25639":60361,"_17911":102017,"_5":17806,"_24291":101838,"_2452":21377},[],{"_2926":60427,"_25639":60361,"_17911":102019,"_5":17806,"_24291":101838,"_2452":102010},[],{"_2926":60428,"_25639":60361,"_17911":102021,"_5":17806,"_24291":101838,"_2452":102022},[],"Región AWS donde opera el conector.",{"_2926":60429,"_25639":60361,"_17911":102024,"_5":17806,"_24291":101838,"_2452":45755},[],{"_2926":60430,"_25639":60361,"_17911":102026,"_5":17806,"_24291":101838,"_2452":21377},[],{"_2926":60431,"_25639":60361,"_17911":102028,"_5":17806,"_24291":101838,"_2452":102010},[],{"_2926":60432,"_25639":60361,"_17911":102030,"_5":17806,"_24291":101838,"_2452":102031},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_2926":60433,"_25639":60361,"_17911":102033,"_5":17806,"_24291":101838,"_2452":45765},[],{"_2926":60434,"_25639":60361,"_17911":102035,"_5":17806,"_24291":101838,"_2452":21377},[],{"_2926":60435,"_25639":60361,"_17911":102037,"_5":17806,"_24291":101838,"_2452":102038},[],"Solo con `auth_method=static`",{"_2926":60436,"_25639":60361,"_17911":102040,"_5":17806,"_24291":101838,"_2452":102041},[],"Clave de acceso AWS.",{"_2926":60437,"_25639":60361,"_17911":102043,"_5":17806,"_24291":101838,"_2452":45776},[],{"_2926":60438,"_25639":60361,"_17911":102045,"_5":17806,"_24291":101838,"_2452":21377},[],{"_2926":60439,"_25639":60361,"_17911":102047,"_5":17806,"_24291":101838,"_2452":102038},[],{"_2926":60440,"_25639":60361,"_17911":102049,"_5":17806,"_24291":101838,"_2452":102050},[],"Clave secreta AWS.",{"_2926":60441,"_25639":60361,"_17911":102052,"_5":17806,"_24291":101838,"_2452":45786},[],{"_2926":60442,"_25639":60361,"_17911":102054,"_5":17806,"_24291":101838,"_2452":21377},[],{"_2926":60443,"_25639":60361,"_17911":102056,"_5":17806,"_24291":101838,"_2452":45791},[],{"_2926":60444,"_25639":60361,"_17911":102058,"_5":17806,"_24291":101838,"_2452":102059},[],"Token de sesión (con `auth_method=static`).",{"_2926":60445,"_25639":60361,"_17911":102061,"_5":17806,"_24291":101838,"_2452":45797},[],{"_2926":60446,"_25639":60361,"_17911":102063,"_5":17806,"_24291":101838,"_2452":21377},[],{"_2926":60447,"_25639":60361,"_17911":102065,"_5":17806,"_24291":101838,"_2452":102066},[],"Solo con `auth_method=role`",{"_2926":60448,"_25639":60361,"_17911":102068,"_5":17806,"_24291":101838,"_2452":102069},[],"ARN del rol a asumir.",{"_2926":60449,"_25639":60361,"_17911":102071,"_5":17806,"_24291":101838,"_2452":45808},[],{"_2926":60450,"_25639":60361,"_17911":102073,"_5":17806,"_24291":101838,"_2452":21377},[],{"_2926":60451,"_25639":60361,"_17911":102075,"_5":17806,"_24291":101838,"_2452":45791},[],{"_2926":60452,"_25639":60361,"_17911":102077,"_5":17806,"_24291":101838,"_2452":102078},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_2926":60453,"_25639":60361,"_17911":102080,"_5":17806,"_24291":101838,"_2452":45818},[],{"_2926":60454,"_25639":60361,"_17911":102082,"_5":17806,"_24291":101838,"_2452":15034},[],{"_2926":60455,"_25639":60361,"_17911":102084,"_5":17806,"_24291":101838,"_2452":102010},[],{"_2926":60456,"_25639":60361,"_17911":102086,"_5":17806,"_24291":101838,"_2452":102087},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_2926":60457,"_25639":60361,"_17911":102089,"_5":17806,"_24291":101838,"_2452":45828},[],{"_2926":60458,"_25639":60361,"_17911":102091,"_5":17806,"_24291":101838,"_2452":21377},[],{"_2926":60459,"_25639":60361,"_17911":102093,"_5":17806,"_24291":101838,"_2452":102010},[],{"_2926":60460,"_25639":60361,"_17911":102095,"_5":17806,"_24291":101838,"_2452":102096},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_2926":60461,"_25639":60361,"_17911":102098,"_5":17806,"_24291":101838,"_2452":45838},[],{"_2926":60462,"_25639":60361,"_17911":102100,"_5":17806,"_24291":101838,"_2452":21377},[],{"_2926":60463,"_25639":60361,"_17911":102102,"_5":17806,"_24291":101838,"_2452":102010},[],{"_2926":60464,"_25639":60361,"_17911":102104,"_5":17806,"_24291":101838,"_2452":102105},[],"URL HTTP del Device Manager de Lamassu.",{"_2926":60465,"_25639":60361,"_17911":102107,"_5":17806,"_24291":101838,"_2452":45848},[],{"_2926":60466,"_25639":60361,"_17911":102109,"_5":17806,"_24291":101838,"_2452":21377},[],{"_2926":60467,"_25639":60361,"_17911":102111,"_5":17806,"_24291":101838,"_2452":102010},[],{"_2926":60468,"_25639":60361,"_17911":102113,"_5":17806,"_24291":101838,"_2452":102114},[],"URL HTTP del servicio de CA de Lamassu.",{"_2926":60469,"_25639":60361,"_17911":102116,"_5":17806,"_24291":101842,"_2452":102117},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_2926":60470,"_25639":60361,"_17911":102119,"_5":17806,"_24291":101846,"_2452":102120},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_2926":60471,"_25639":60361,"_17911":102122,"_5":17806,"_24291":101846,"_2452":102123},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_2926":60472,"_25639":60361,"_17911":102125,"_5":17806,"_24291":101850,"_2452":102126},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_2926":60473,"_25639":60361,"_17911":102128,"_5":17806,"_24291":101850,"_2452":102129},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_2926":60474,"_25639":60361,"_17911":102131,"_5":17806,"_24291":101850,"_2452":102132},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_2926":60475,"_25639":60361,"_17911":102134,"_5":17806,"_24291":101850,"_2452":102135},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_2926":60476,"_25639":60361,"_17911":102137,"_5":17806,"_24291":101850,"_2452":102138},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_2926":60477,"_25639":60361,"_17911":102140,"_5":17806,"_24291":101850,"_2452":102141},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_2926":60478,"_25639":60361,"_17911":102143,"_5":17806,"_24291":101853,"_2452":102144},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_2926":60479,"_25639":60361,"_17911":102146,"_5":17806,"_24291":101856,"_2452":102147},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_2926":60480,"_25639":60361,"_17911":102149,"_5":17806,"_24291":101856,"_2452":102150},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_2926":60481,"_25639":60361,"_17911":102152,"_5":17806,"_24291":101860,"_2452":102153},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_2926":60482,"_25639":60361,"_17911":102155,"_5":17806,"_24291":101864,"_2452":102156},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_2926":60483,"_25639":60361,"_17911":102158,"_5":17806,"_24291":101864,"_2452":102159},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_2926":60484,"_25639":60361,"_17911":102161,"_5":17806,"_24291":101864,"_2452":102162},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_2926":60485,"_25639":60361,"_17911":102164,"_5":17806,"_24291":101864,"_2452":102165},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_2926":60486,"_25639":60361,"_17911":102167,"_5":17806,"_24291":101864,"_2452":102168},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_2926":60487,"_25639":60361,"_17911":102170,"_5":17806,"_24291":101864,"_2452":102171},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_2926":60488,"_25639":60361,"_17911":102173,"_5":17806,"_24291":101868,"_2452":102174},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_2926":60489,"_25639":60361,"_17911":102176,"_5":17806,"_24291":101868,"_2452":102177},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_2926":60490,"_25639":60361,"_17911":102179,"_5":17806,"_24291":101868,"_2452":102180},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_2926":60491,"_25639":60361,"_17911":102182,"_5":17806,"_24291":101872,"_2452":102183},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_2926":60492,"_25639":60361,"_17911":102185,"_5":17806,"_24291":101872,"_2452":102186},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_2926":60493,"_25639":60361,"_17911":102188,"_5":17806,"_24291":101872,"_2452":102189},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_2926":60494,"_25639":60361,"_17911":102191,"_5":17806,"_24291":101876,"_2452":102192},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_2926":60495,"_25639":60361,"_17911":102194,"_5":17806,"_24291":101876,"_2452":102195},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_2926":60496,"_25639":60361,"_17911":102197,"_5":17806,"_24291":101876,"_2452":102198},[],"Para que el flujo JITP funcione correctamente:",{"_2926":60497,"_25639":60361,"_17911":102200,"_5":17806,"_24291":101876,"_2452":102201},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_2926":60498,"_25639":60361,"_17911":102203,"_5":17806,"_24291":101876,"_2452":102204},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_2926":60499,"_25639":60361,"_17911":102206,"_5":17806,"_24291":101876,"_2452":102207},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_2926":60500,"_25639":60361,"_17911":102209,"_5":17806,"_24291":101876,"_2452":102210},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_2926":60501,"_25639":60361,"_17911":102212,"_5":17806,"_24291":101880,"_2452":102213},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_2926":60502,"_25639":60361,"_17911":102215,"_5":17806,"_24291":101880,"_2452":102216},[],"Estado en Lamassu",{"_2926":60503,"_25639":60361,"_17911":102218,"_5":17806,"_24291":101880,"_2452":102219},[],"Razón de revocación",{"_2926":60504,"_25639":60361,"_17911":102221,"_5":17806,"_24291":101880,"_2452":102222},[],"Estado en AWS IoT Core",{"_2926":60505,"_25639":60361,"_17911":102224,"_5":17806,"_24291":101880,"_2452":45969},[],{"_2926":60506,"_25639":60361,"_17911":102226,"_5":17806,"_24291":101880,"_2452":102227},[],"Ninguna",{"_2926":60507,"_25639":60361,"_17911":102229,"_5":17806,"_24291":101880,"_2452":45975},[],{"_2926":60508,"_25639":60361,"_17911":102231,"_5":17806,"_24291":101880,"_2452":45978},[],{"_2926":60509,"_25639":60361,"_17911":102233,"_5":17806,"_24291":101880,"_2452":45981},[],{"_2926":60510,"_25639":60361,"_17911":102235,"_5":17806,"_24291":101880,"_2452":45984},[],{"_2926":60511,"_25639":60361,"_17911":102237,"_5":17806,"_24291":101880,"_2452":45978},[],{"_2926":60512,"_25639":60361,"_17911":102239,"_5":17806,"_24291":101880,"_2452":102240},[],"Cualquier otra razón",{"_2926":60513,"_25639":60361,"_17911":102242,"_5":17806,"_24291":101880,"_2452":45992},[],{"_2926":60514,"_25639":60361,"_17911":102244,"_5":17806,"_24291":101880,"_2452":102245},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_2926":60515,"_25639":60361,"_17911":102247,"_5":17806,"_24291":101884,"_2452":102248},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_2926":60516,"_25639":60361,"_17911":102250,"_5":17806,"_24291":101884,"_2452":102251},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_2926":60517,"_25639":60361,"_17911":102253,"_5":17806,"_24291":101884,"_2452":102254},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_2926":60518,"_25639":60361,"_17911":102256,"_5":17806,"_24291":101888,"_2452":102257},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_2926":60519,"_25639":60361,"_17911":102259,"_5":17806,"_24291":101888,"_2452":102260},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_2926":60520,"_25639":60361,"_17911":102262,"_5":17806,"_24291":101892,"_2452":102263},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_2926":60521,"_25639":60361,"_17911":102265,"_5":17806,"_24291":101892,"_2452":102266},[],"Existen dos tipos de acciones:",{"_2926":60522,"_25639":60361,"_17911":102268,"_5":17806,"_24291":101892,"_2452":102269},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_2926":60523,"_25639":60361,"_17911":102271,"_5":17806,"_24291":101892,"_2452":102272},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_2926":60524,"_25639":60361,"_17911":102274,"_5":17806,"_24291":101892,"_2452":102275},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_2926":60525,"_25639":60361,"_17911":102277,"_5":17806,"_24291":101896,"_2452":102278},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_2926":60526,"_25639":60361,"_17911":102280,"_5":17806,"_24291":101896,"_2452":102281},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_2926":60527,"_25639":60361,"_17911":102283,"_5":17806,"_24291":101896,"_2452":102284},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_2926":60528,"_25639":60361,"_17911":102286,"_5":17806,"_24291":101900,"_2452":102287},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_2926":60529,"_25639":60361,"_17911":102289,"_5":17806,"_24291":101900,"_2452":102290},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_2926":60530,"_25639":60361,"_17911":102292,"_5":17806,"_24291":101900,"_2452":102293},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_2926":60531,"_25639":60361,"_17911":102295,"_5":17806,"_24291":101900,"_2452":102296},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_2926":60532,"_25639":60361,"_17911":102298,"_5":17806,"_24291":101900,"_2452":102299},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_2926":60533,"_25639":60361,"_17911":102301,"_5":17806,"_24291":101900,"_2452":102302},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_2926":60534,"_25639":60361,"_17911":102304,"_5":17806,"_24291":101900,"_2452":102305},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_2926":60535,"_25639":60361,"_17911":102307,"_5":17806,"_24291":101900,"_2452":102308},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_2926":60536,"_25639":60361,"_17911":102310,"_5":17806,"_24291":101900,"_2452":102311},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_2926":60537,"_25639":60361,"_17911":102313,"_5":17806,"_24291":101900,"_2452":102314},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_2926":60538,"_25639":60361,"_17911":102316,"_5":17806,"_24291":101900,"_2452":102317},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_2926":60539,"_25639":60361,"_17911":102319,"_5":17806,"_24291":101900,"_2452":102320},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_2926":60540,"_25639":60361,"_17911":102322,"_5":17806,"_24291":101900,"_2452":102323},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_2926":60541,"_25639":60361,"_17911":102325,"_5":17806,"_24291":101900,"_2452":102326},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_2926":60542,"_25639":60361,"_17911":102328,"_5":17806,"_24291":101900,"_2452":102329},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_2926":60543,"_25639":60361,"_17911":102331,"_5":17806,"_24291":101900,"_2452":102332},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_2926":60544,"_25639":60361,"_17911":102334,"_5":17806,"_24291":101900,"_2452":102335},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_2926":60545,"_25639":60361,"_17911":102337,"_5":17806,"_24291":101900,"_2452":102338},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_2926":60546,"_25639":60361,"_17911":102340,"_5":17806,"_24291":101900,"_2452":102341},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2926":60547,"_25639":60361,"_17911":102343,"_5":17806,"_24291":101900,"_2452":102344},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2926":60548,"_25639":60361,"_17911":102346,"_5":17806,"_24291":101900,"_2452":102347},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_2926":60549,"_25639":60549,"_5":12558,"_2452":44078,"_25983":102349,"_17911":102350,"_24291":60549},[41760,99445,44078],[],{"_2926":60550,"_25639":60549,"_17911":102352,"_5":17806,"_24291":60549,"_2452":102353},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_2926":60551,"_25639":60549,"_5":25980,"_17911":102355,"_24291":102356,"_2452":102357},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_2926":60552,"_25639":60549,"_5":25980,"_17911":102359,"_24291":102360,"_2452":100417},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_2926":60553,"_25639":60549,"_5":25980,"_17911":102362,"_24291":102363,"_2452":100592},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_2926":60554,"_25639":60549,"_5":25980,"_17911":102365,"_24291":102366,"_2452":101819},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/overview#integraciones",{"_2926":60555,"_25639":60549,"_5":25980,"_17911":102368,"_24291":102369,"_2452":102370},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_2926":60556,"_25639":60549,"_17911":102372,"_5":17806,"_24291":60549,"_2452":102373},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_2926":60557,"_25639":60549,"_17911":102375,"_5":17806,"_24291":102356,"_2452":102376},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_2926":60558,"_25639":60549,"_17911":102378,"_5":17806,"_24291":102356,"_2452":102379},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_2926":60559,"_25639":60549,"_17911":102381,"_5":17806,"_24291":102360,"_2452":102382},[],"Recurso",{"_2926":60560,"_25639":60549,"_17911":102384,"_5":17806,"_24291":102360,"_2452":102385},[],"Qué representa",{"_2926":60561,"_25639":60549,"_17911":102387,"_5":17806,"_24291":102360,"_2452":102388},[],"**Dispositivo**",{"_2926":60562,"_25639":60549,"_17911":102390,"_5":17806,"_24291":102360,"_2452":102391},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_2926":60563,"_25639":60549,"_17911":102393,"_5":17806,"_24291":102360,"_2452":102394},[],"**Identidad**",{"_2926":60564,"_25639":60549,"_17911":102396,"_5":17806,"_24291":102360,"_2452":102397},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_2926":60565,"_25639":60549,"_17911":102399,"_5":17806,"_24291":102360,"_2452":46150},[],{"_2926":60566,"_25639":60549,"_17911":102401,"_5":17806,"_24291":102360,"_2452":102402},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_2926":60567,"_25639":60549,"_17911":102404,"_5":17806,"_24291":102360,"_2452":102405},[],"**Flota**",{"_2926":60568,"_25639":60549,"_17911":102407,"_5":17806,"_24291":102360,"_2452":102408},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_2926":60569,"_25639":60549,"_17911":102410,"_5":17806,"_24291":102360,"_2452":102411},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_2926":60570,"_25639":60549,"_17911":102413,"_5":17806,"_24291":102360,"_2452":102414},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_2926":60571,"_25639":60549,"_17911":102416,"_5":17806,"_24291":102363,"_2452":102417},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_2926":60572,"_25639":60549,"_17911":102419,"_5":17806,"_24291":102363,"_2452":102420},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_2926":60573,"_25639":60549,"_17911":102422,"_5":17806,"_24291":102363,"_2452":102423},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_2926":60574,"_25639":60549,"_17911":102425,"_5":17806,"_24291":102363,"_2452":102426},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_2926":60575,"_25639":60549,"_17911":102428,"_5":17806,"_24291":102363,"_2452":102429},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_2926":60576,"_25639":60549,"_17911":102431,"_5":17806,"_24291":102363,"_2452":102432},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_2926":60577,"_25639":60549,"_17911":102434,"_5":17806,"_24291":102363,"_2452":102435},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2926":60578,"_25639":60549,"_17911":102437,"_5":17806,"_24291":102363,"_2452":102438},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2926":60579,"_25639":60549,"_17911":102440,"_5":17806,"_24291":102366,"_2452":102441},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_2926":60580,"_25639":60549,"_17911":102443,"_5":17806,"_24291":102366,"_2452":102444},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_2926":60581,"_25639":60549,"_17911":102446,"_5":17806,"_24291":102369,"_2452":102447},[],"Participante",{"_2926":60582,"_25639":60549,"_17911":102449,"_5":17806,"_24291":102369,"_2452":102450},[],"Responsabilidad",{"_2926":60583,"_25639":60549,"_17911":102452,"_5":17806,"_24291":102369,"_2452":102453},[],"Administrador PKI",{"_2926":60584,"_25639":60549,"_17911":102455,"_5":17806,"_24291":102369,"_2452":102456},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_2926":60585,"_25639":60549,"_17911":102458,"_5":17806,"_24291":102369,"_2452":102459},[],"Administrador del aprovisionamiento",{"_2926":60586,"_25639":60549,"_17911":102461,"_5":17806,"_24291":102369,"_2452":102462},[],"DMS, admisión, autenticación por operación e inventario.",{"_2926":60587,"_25639":60549,"_17911":102464,"_5":17806,"_24291":102369,"_2452":102465},[],"Integrador del dispositivo",{"_2926":60588,"_25639":60549,"_17911":102467,"_5":17806,"_24291":102369,"_2452":102468},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_2926":60589,"_25639":60549,"_17911":102470,"_5":17806,"_24291":102369,"_2452":102471},[],"Integrador del consumidor",{"_2926":60590,"_25639":60549,"_17911":102473,"_5":17806,"_24291":102369,"_2452":102474},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_2926":60591,"_25639":60549,"_17911":102476,"_5":17806,"_24291":102369,"_2452":102477},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_2926":60592,"_25639":60592,"_5":12558,"_2452":102479,"_25983":102480,"_17911":102482,"_24291":60592},"Enrola y conecta tu primer dispositivo",[41760,99445,44078,102481],"Primeros pasos",[],{"_2926":60593,"_25639":60592,"_17911":102484,"_5":17806,"_24291":60592,"_2452":102485},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_2926":60594,"_25639":60592,"_5":25980,"_17911":102487,"_24291":102488,"_2452":98146},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_2926":60595,"_25639":60592,"_5":25980,"_17911":102490,"_24291":102491,"_2452":102492},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_2926":60596,"_25639":60592,"_5":25980,"_17911":102494,"_24291":102495,"_2452":102496},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_2926":60597,"_25639":60592,"_5":25980,"_17911":102498,"_24291":102499,"_2452":102500},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_2926":60598,"_25639":60592,"_5":25980,"_17911":102502,"_24291":102503,"_2452":102504},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_2926":60599,"_25639":60592,"_5":25980,"_17911":102506,"_24291":102507,"_2452":102508},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_2926":60600,"_25639":60592,"_5":25980,"_17911":102510,"_24291":102511,"_2452":102512},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_2926":60601,"_25639":60592,"_5":25980,"_17911":102514,"_24291":102515,"_2452":102516},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_2926":60602,"_25639":60592,"_17911":102518,"_5":17806,"_24291":60592,"_2452":102519},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_2926":60603,"_25639":60592,"_17911":102521,"_5":17806,"_24291":102488,"_2452":102522},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_2926":60604,"_25639":60592,"_17911":102524,"_5":17806,"_24291":102488,"_2452":102525},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_2926":60605,"_25639":60592,"_17911":102527,"_5":17806,"_24291":102488,"_2452":102528},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_2926":60606,"_25639":60592,"_17911":102530,"_5":17806,"_24291":102488,"_2452":102531},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_2926":60607,"_25639":60592,"_17911":102533,"_5":17806,"_24291":102488,"_2452":102534},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_2926":60608,"_25639":60592,"_17911":102536,"_5":17806,"_24291":102491,"_2452":102537},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_2926":60609,"_25639":60592,"_17911":102539,"_5":17806,"_24291":102491,"_2452":102540},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_2926":60610,"_25639":60592,"_17911":102542,"_5":17806,"_24291":102495,"_2452":102543},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_2926":60611,"_25639":60592,"_17911":102545,"_5":17806,"_24291":102495,"_2452":102546},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_2926":60612,"_25639":60592,"_17911":102548,"_5":17806,"_24291":102495,"_2452":102549},[],"Ajuste",{"_2926":60613,"_25639":60592,"_17911":102551,"_5":17806,"_24291":102495,"_2452":102552},[],"Valor de evaluación",{"_2926":60614,"_25639":60592,"_17911":102554,"_5":17806,"_24291":102495,"_2452":46306},[],{"_2926":60615,"_25639":60592,"_17911":102556,"_5":17806,"_24291":102495,"_2452":102557},[],"Raíz emisora de `device-root.pem`.",{"_2926":60616,"_25639":60592,"_17911":102559,"_5":17806,"_24291":102495,"_2452":100720},[],{"_2926":60617,"_25639":60592,"_17911":102561,"_5":17806,"_24291":102495,"_2452":102562},[],"Perfil final de 1 hora que acabas de preparar.",{"_2926":60618,"_25639":60592,"_17911":102564,"_5":17806,"_24291":102495,"_2452":46317},[],{"_2926":60619,"_25639":60592,"_17911":102566,"_5":17806,"_24291":102495,"_2452":46320},[],{"_2926":60620,"_25639":60592,"_17911":102568,"_5":17806,"_24291":102495,"_2452":46323},[],{"_2926":60621,"_25639":60592,"_17911":102570,"_5":17806,"_24291":102495,"_2452":102571},[],"Habilitado.",{"_2926":60622,"_25639":60592,"_17911":102573,"_5":17806,"_24291":102495,"_2452":46329},[],{"_2926":60623,"_25639":60592,"_17911":102575,"_5":17806,"_24291":102495,"_2452":102576},[],"Deshabilitado; el ID debe ser nuevo.",{"_2926":60624,"_25639":60592,"_17911":102578,"_5":17806,"_24291":102495,"_2452":102579},[],"Autenticación inicial",{"_2926":60625,"_25639":60592,"_17911":102581,"_5":17806,"_24291":102495,"_2452":102582},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_2926":60626,"_25639":60592,"_17911":102584,"_5":17806,"_24291":102495,"_2452":102585},[],"Autenticación de renovación",{"_2926":60627,"_25639":60592,"_17911":102587,"_5":17806,"_24291":102495,"_2452":102588},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_2926":60628,"_25639":60592,"_17911":102590,"_5":17806,"_24291":102495,"_2452":46347},[],{"_2926":60629,"_25639":60592,"_17911":102592,"_5":17806,"_24291":102495,"_2452":102593},[],"Lista vacía para esta emisión directa / deshabilitado.",{"_2926":60630,"_25639":60592,"_17911":102595,"_5":17806,"_24291":102495,"_2452":46353},[],{"_2926":60631,"_25639":60592,"_17911":102597,"_5":17806,"_24291":102495,"_2452":102598},[],"1 hora.",{"_2926":60632,"_25639":60592,"_17911":102600,"_5":17806,"_24291":102495,"_2452":46359},[],{"_2926":60633,"_25639":60592,"_17911":102602,"_5":17806,"_24291":102495,"_2452":102603},[],"30 minutos / 10 minutos.",{"_2926":60634,"_25639":60592,"_17911":102605,"_5":17806,"_24291":102495,"_2452":46365},[],{"_2926":60635,"_25639":60592,"_17911":102607,"_5":17806,"_24291":102495,"_2452":102608},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_2926":60636,"_25639":60592,"_17911":102610,"_5":17806,"_24291":102495,"_2452":44397},[],{"_2926":60637,"_25639":60592,"_17911":102612,"_5":17806,"_24291":102495,"_2452":102613},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_2926":60638,"_25639":60592,"_17911":102615,"_5":17806,"_24291":102495,"_2452":46376},[],{"_2926":60639,"_25639":60592,"_17911":102617,"_5":17806,"_24291":102495,"_2452":102618},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_2926":60640,"_25639":60592,"_17911":102620,"_5":17806,"_24291":102495,"_2452":102621},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_2926":60641,"_25639":60592,"_17911":102623,"_5":17806,"_24291":102499,"_2452":102624},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_2926":60642,"_25639":60592,"_17911":102626,"_5":17806,"_24291":102499,"_2452":102627},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_2926":60643,"_25639":60592,"_17911":102629,"_5":17806,"_24291":102503,"_2452":102630},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_2926":60644,"_25639":60592,"_17911":102632,"_5":17806,"_24291":102503,"_2452":102633},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_2926":60645,"_25639":60592,"_17911":102635,"_5":17806,"_24291":102503,"_2452":102636},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_2926":60646,"_25639":60592,"_17911":102638,"_5":17806,"_24291":102507,"_2452":102639},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_2926":60647,"_25639":60592,"_17911":102641,"_5":17806,"_24291":102507,"_2452":102642},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_2926":60648,"_25639":60592,"_17911":102644,"_5":17806,"_24291":102511,"_2452":102645},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_2926":60649,"_25639":60592,"_17911":102647,"_5":17806,"_24291":102511,"_2452":102648},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_2926":60650,"_25639":60592,"_17911":102650,"_5":17806,"_24291":102511,"_2452":102651},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_2926":60651,"_25639":60592,"_17911":102653,"_5":17806,"_24291":102511,"_2452":102654},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_2926":60652,"_25639":60592,"_17911":102656,"_5":17806,"_24291":102511,"_2452":102657},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_2926":60653,"_25639":60592,"_17911":102659,"_5":17806,"_24291":102515,"_2452":102660},[],"Comprobación",{"_2926":60654,"_25639":60592,"_17911":102662,"_5":17806,"_24291":102515,"_2452":102663},[],"Resultado esperado",{"_2926":60655,"_25639":60592,"_17911":102665,"_5":17806,"_24291":102515,"_2452":102666},[],"Registro",{"_2926":60656,"_25639":60592,"_17911":102668,"_5":17806,"_24291":102515,"_2452":102669},[],"ID creado automáticamente y DMS correcto.",{"_2926":60657,"_25639":60592,"_17911":102671,"_5":17806,"_24291":102515,"_2452":102672},[],"Certificado",{"_2926":60658,"_25639":60592,"_17911":102674,"_5":17806,"_24291":102515,"_2452":102675},[],"CN, perfil, serie y clave verificados.",{"_2926":60659,"_25639":60592,"_17911":102677,"_5":17806,"_24291":102515,"_2452":102678},[],"Inventario",{"_2926":60660,"_25639":60592,"_17911":102680,"_5":17806,"_24291":102515,"_2452":102681},[],"Serie recibida visible como identidad actual y en el historial.",{"_2926":60661,"_25639":60592,"_17911":102683,"_5":17806,"_24291":102515,"_2452":102684},[],"Consumidor",{"_2926":60662,"_25639":60592,"_17911":102686,"_5":17806,"_24291":102515,"_2452":102687},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_2926":60663,"_25639":60592,"_17911":102689,"_5":17806,"_24291":102515,"_2452":102690},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_2926":60664,"_25639":60592,"_17911":102692,"_5":17806,"_24291":102515,"_2452":102693},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_2926":60665,"_25639":60665,"_5":12558,"_2452":100434,"_25983":102695,"_17911":102696,"_24291":60665},[41760,99445,44078,102481],[],{"_2926":60666,"_25639":60665,"_17911":102698,"_5":17806,"_24291":60665,"_2452":102699},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_2926":60667,"_25639":60665,"_5":25980,"_17911":102701,"_24291":102702,"_2452":98146},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_2926":60668,"_25639":60665,"_5":25980,"_17911":102704,"_24291":102705,"_2452":102706},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_2926":60669,"_25639":60665,"_5":25980,"_17911":102708,"_24291":102709,"_2452":102710},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_2926":60670,"_25639":60665,"_5":25980,"_17911":102712,"_24291":102713,"_2452":102714},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_2926":60671,"_25639":60665,"_5":25980,"_17911":102716,"_24291":102717,"_2452":102718},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_2926":60672,"_25639":60665,"_5":25980,"_17911":102720,"_24291":102721,"_2452":102722},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_2926":60673,"_25639":60665,"_5":25980,"_17911":102724,"_24291":102725,"_2452":102663},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_2926":60674,"_25639":60665,"_5":25980,"_17911":102727,"_24291":102728,"_2452":102729},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_2926":60675,"_25639":60665,"_5":25980,"_17911":102731,"_24291":102732,"_2452":102733},[],"/docs/pr-preview/pr-48/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_2926":60676,"_25639":60665,"_17911":102735,"_5":17806,"_24291":60665,"_2452":102736},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_2926":60677,"_25639":60665,"_17911":102738,"_5":17806,"_24291":60665,"_2452":102739},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_2926":60678,"_25639":60665,"_17911":102741,"_5":17806,"_24291":102702,"_2452":102742},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_2926":60679,"_25639":60665,"_17911":102744,"_5":17806,"_24291":102702,"_2452":102745},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_2926":60680,"_25639":60665,"_17911":102747,"_5":17806,"_24291":102702,"_2452":102748},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_2926":60681,"_25639":60665,"_17911":102750,"_5":17806,"_24291":102702,"_2452":102751},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_2926":60682,"_25639":60665,"_17911":102753,"_5":17806,"_24291":102705,"_2452":102754},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_2926":60683,"_25639":60665,"_17911":102756,"_5":17806,"_24291":102705,"_2452":102757},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_2926":60684,"_25639":60665,"_17911":102759,"_5":17806,"_24291":102705,"_2452":102760},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_2926":60685,"_25639":60665,"_17911":102762,"_5":17806,"_24291":102705,"_2452":102763},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_2926":60686,"_25639":60665,"_17911":102765,"_5":17806,"_24291":102705,"_2452":102766},[],"Configura **Authentication Mode** como `CLIENT_CERTIFICATE` y añade en **Validation CAs** la CA cuyos certificados iniciales aceptarás. Para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deshabilitada la generación de claves en servidor si no la vas a utilizar.",{"_2926":60687,"_25639":60665,"_17911":102768,"_5":17806,"_24291":102705,"_2452":102769},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_2926":60688,"_25639":60665,"_17911":102771,"_5":17806,"_24291":102705,"_2452":102772},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_2926":60689,"_25639":60665,"_17911":102774,"_5":17806,"_24291":102705,"_2452":102775},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_2926":60690,"_25639":60665,"_17911":102777,"_5":17806,"_24291":102709,"_2452":102778},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_2926":60691,"_25639":60665,"_17911":102780,"_5":17806,"_24291":102709,"_2452":46542},[],{"_2926":60692,"_25639":60665,"_17911":102782,"_5":17806,"_24291":102709,"_2452":102783},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_2926":60693,"_25639":60665,"_17911":102785,"_5":17806,"_24291":102709,"_2452":102786},[],"**Icon** y **Tags**: clasificación opcional.",{"_2926":60694,"_25639":60665,"_17911":102788,"_5":17806,"_24291":102709,"_2452":102789},[],"Confirma el registro.",{"_2926":60695,"_25639":60665,"_17911":102791,"_5":17806,"_24291":102713,"_2452":102792},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_2926":60696,"_25639":60665,"_17911":102794,"_5":17806,"_24291":102713,"_2452":102795},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_2926":60697,"_25639":60665,"_17911":102797,"_5":17806,"_24291":102717,"_2452":102798},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_2926":60698,"_25639":60665,"_17911":102800,"_5":17806,"_24291":102717,"_2452":102801},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_2926":60699,"_25639":60665,"_17911":102803,"_5":17806,"_24291":102721,"_2452":102804},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_2926":60700,"_25639":60665,"_17911":102806,"_5":17806,"_24291":102721,"_2452":102807},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_2926":60701,"_25639":60665,"_17911":102809,"_5":17806,"_24291":102725,"_2452":102660},[],{"_2926":60702,"_25639":60665,"_17911":102811,"_5":17806,"_24291":102725,"_2452":102812},[],"Resultado",{"_2926":60703,"_25639":60665,"_17911":102814,"_5":17806,"_24291":102725,"_2452":102815},[],"Dispositivo",{"_2926":60704,"_25639":60665,"_17911":102817,"_5":17806,"_24291":102725,"_2452":102818},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_2926":60705,"_25639":60665,"_17911":102820,"_5":17806,"_24291":102725,"_2452":102821},[],"Identidad actual",{"_2926":60706,"_25639":60665,"_17911":102823,"_5":17806,"_24291":102725,"_2452":102824},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_2926":60707,"_25639":60665,"_17911":102826,"_5":17806,"_24291":102725,"_2452":102827},[],"Historial",{"_2926":60708,"_25639":60665,"_17911":102829,"_5":17806,"_24291":102725,"_2452":102830},[],"La emisión asociada aparece con su número de serie y fechas.",{"_2926":60709,"_25639":60665,"_17911":102832,"_5":17806,"_24291":102725,"_2452":102833},[],"Clave y certificado",{"_2926":60710,"_25639":60665,"_17911":102835,"_5":17806,"_24291":102725,"_2452":102836},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_2926":60711,"_25639":60665,"_17911":102838,"_5":17806,"_24291":102728,"_2452":102839},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_2926":60712,"_25639":60665,"_17911":102841,"_5":17806,"_24291":102728,"_2452":102842},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_2926":60713,"_25639":60665,"_17911":102844,"_5":17806,"_24291":102728,"_2452":102845},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_2926":60714,"_25639":60665,"_17911":102847,"_5":17806,"_24291":102728,"_2452":102848},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_2926":60715,"_25639":60665,"_17911":102850,"_5":17806,"_24291":102732,"_2452":102851},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_2926":60716,"_25639":60665,"_17911":102853,"_5":17806,"_24291":102732,"_2452":102854},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_2926":60717,"_25639":60665,"_17911":102856,"_5":17806,"_24291":102732,"_2452":102857},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_2926":60718,"_25639":60718,"_5":12558,"_2452":102859,"_25983":102860,"_17911":102861,"_24291":60718},"Plataforma Lamassu IoT",[41760,99445],[],{"_2926":60719,"_25639":60718,"_17911":102863,"_5":17806,"_24291":60718,"_2452":102864},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_2926":60720,"_25639":60718,"_5":25980,"_17911":102866,"_24291":102867,"_2452":102357},[],"/docs/pr-preview/pr-48/es/platform/overview#empieza-aquí",{"_2926":60721,"_25639":60718,"_5":25980,"_17911":102869,"_24291":102870,"_2452":102871},[],"/docs/pr-preview/pr-48/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_2926":60722,"_25639":60718,"_5":25980,"_17911":102873,"_24291":102874,"_2452":102875},[],"/docs/pr-preview/pr-48/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_2926":60723,"_25639":60718,"_5":25980,"_17911":102877,"_24291":102878,"_2452":102879},[],"/docs/pr-preview/pr-48/es/platform/overview#capacidades-principales","Capacidades principales",{"_2926":60724,"_25639":60718,"_5":25980,"_17911":102881,"_24291":102882,"_2452":102883},[],"/docs/pr-preview/pr-48/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_2926":60725,"_25639":60718,"_5":25980,"_17911":102885,"_24291":102886,"_2452":102887},[],"/docs/pr-preview/pr-48/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_2926":60726,"_25639":60718,"_5":25980,"_17911":102889,"_24291":102890,"_2452":102891},[],"/docs/pr-preview/pr-48/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_2926":60727,"_25639":60718,"_5":25980,"_17911":102893,"_24291":102894,"_2452":102895},[],"/docs/pr-preview/pr-48/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_2926":60728,"_25639":60718,"_5":25980,"_17911":102897,"_24291":102898,"_2452":102899},[],"/docs/pr-preview/pr-48/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_2926":60729,"_25639":60718,"_5":25980,"_17911":102901,"_24291":102902,"_2452":102903},[],"/docs/pr-preview/pr-48/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_2926":60730,"_25639":60718,"_5":25980,"_17911":102905,"_24291":102906,"_2452":102907},[],"/docs/pr-preview/pr-48/es/platform/overview#referencia-operativa","Referencia operativa",{"_2926":60731,"_25639":60718,"_17911":102909,"_5":17806,"_24291":60718,"_2452":102910},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_2926":60732,"_25639":60718,"_17911":102912,"_5":17806,"_24291":102867,"_2452":102913},[],"Elige el resultado que necesitas obtener:",{"_2926":60733,"_25639":60718,"_17911":102915,"_5":17806,"_24291":102867,"_2452":102916},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2926":60734,"_25639":60718,"_17911":102918,"_5":17806,"_24291":102867,"_2452":102919},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2926":60735,"_25639":60718,"_17911":102921,"_5":17806,"_24291":102867,"_2452":102922},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_2926":60736,"_25639":60718,"_17911":102924,"_5":17806,"_24291":102870,"_2452":102925},[],"Bloque",{"_2926":60737,"_25639":60718,"_17911":102927,"_5":17806,"_24291":102870,"_2452":102928},[],"Qué gestionas",{"_2926":60738,"_25639":60718,"_17911":102930,"_5":17806,"_24291":102870,"_2452":102931},[],"Punto de entrada",{"_2926":60739,"_25639":60718,"_17911":102933,"_5":17806,"_24291":102870,"_2452":46696},[],{"_2926":60740,"_25639":60718,"_17911":102935,"_5":17806,"_24291":102870,"_2452":102936},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_2926":60741,"_25639":60718,"_17911":102938,"_5":17806,"_24291":102870,"_2452":102939},[],"Visión general de PKI",{"_2926":60742,"_25639":60718,"_17911":102941,"_5":17806,"_24291":102870,"_2452":46705},[],{"_2926":60743,"_25639":60718,"_17911":102943,"_5":17806,"_24291":102870,"_2452":102944},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_2926":60744,"_25639":60718,"_17911":102946,"_5":17806,"_24291":102870,"_2452":102947},[],"Visión general de IoT Fleets",{"_2926":60745,"_25639":60718,"_17911":102949,"_5":17806,"_24291":102870,"_2452":102950},[],"**Administración**",{"_2926":60746,"_25639":60718,"_17911":102952,"_5":17806,"_24291":102870,"_2452":102953},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_2926":60747,"_25639":60718,"_17911":102955,"_5":17806,"_24291":102870,"_2452":99443},[],{"_2926":60748,"_25639":60718,"_17911":102957,"_5":17806,"_24291":102870,"_2452":102958},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_2926":60749,"_25639":60718,"_17911":102960,"_5":17806,"_24291":102874,"_2452":102961},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_2926":60750,"_25639":60718,"_17911":102963,"_5":17806,"_24291":102874,"_2452":102964},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_2926":60751,"_25639":60718,"_17911":102966,"_5":17806,"_24291":102874,"_2452":102967},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_2926":60752,"_25639":60718,"_17911":102969,"_5":17806,"_24291":102874,"_2452":102970},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_2926":60753,"_25639":60718,"_17911":102972,"_5":17806,"_24291":102874,"_2452":102973},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_2926":60754,"_25639":60718,"_17911":102975,"_5":17806,"_24291":102874,"_2452":102976},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_2926":60755,"_25639":60718,"_17911":102978,"_5":17806,"_24291":102882,"_2452":102979},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_2926":60756,"_25639":60718,"_17911":102981,"_5":17806,"_24291":102886,"_2452":102982},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_2926":60757,"_25639":60718,"_17911":102984,"_5":17806,"_24291":102890,"_2452":102985},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_2926":60758,"_25639":60718,"_17911":102987,"_5":17806,"_24291":102894,"_2452":102988},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_2926":60759,"_25639":60718,"_17911":102990,"_5":17806,"_24291":102898,"_2452":102991},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_2926":60760,"_25639":60718,"_17911":102993,"_5":17806,"_24291":102902,"_2452":102994},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_2926":60761,"_25639":60718,"_17911":102996,"_5":17806,"_24291":102906,"_2452":102450},[],{"_2926":60762,"_25639":60718,"_17911":102998,"_5":17806,"_24291":102906,"_2452":102999},[],"Qué prepara o comprueba",{"_2926":60763,"_25639":60718,"_17911":103001,"_5":17806,"_24291":102906,"_2452":102453},[],{"_2926":60764,"_25639":60718,"_17911":103003,"_5":17806,"_24291":102906,"_2452":103004},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_2926":60765,"_25639":60718,"_17911":103006,"_5":17806,"_24291":102906,"_2452":103007},[],"Administrador de la flota",{"_2926":60766,"_25639":60718,"_17911":103009,"_5":17806,"_24291":102906,"_2452":103010},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_2926":60767,"_25639":60718,"_17911":103012,"_5":17806,"_24291":102906,"_2452":102465},[],{"_2926":60768,"_25639":60718,"_17911":103014,"_5":17806,"_24291":102906,"_2452":103015},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_2926":60769,"_25639":60718,"_17911":103017,"_5":17806,"_24291":102906,"_2452":102471},[],{"_2926":60770,"_25639":60718,"_17911":103019,"_5":17806,"_24291":102906,"_2452":103020},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_2926":60771,"_25639":60718,"_17911":103022,"_5":17806,"_24291":102906,"_2452":103023},[],"Operador de infraestructura",{"_2926":60772,"_25639":60718,"_17911":103025,"_5":17806,"_24291":102906,"_2452":103026},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_2926":60773,"_25639":60718,"_17911":103028,"_5":17806,"_24291":102906,"_2452":103029},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_2926":60774,"_25639":60774,"_5":12558,"_2452":103031,"_25983":103032,"_17911":103034,"_24291":60774},"Jerarquía y rotación de CAs",[41760,99445,46797,103033],"Claves, autoridades y certificados",[],{"_2926":60775,"_25639":60774,"_17911":103036,"_5":17806,"_24291":60774,"_2452":103037},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_2926":60776,"_25639":60774,"_5":25980,"_17911":103039,"_24291":103040,"_2452":103041},[],"/docs/pr-preview/pr-48/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_2926":60777,"_25639":60774,"_5":25980,"_17911":103043,"_24291":103044,"_2452":103045},[],"/docs/pr-preview/pr-48/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_2926":60778,"_25639":60774,"_5":25980,"_17911":103047,"_24291":103048,"_2452":103049},[],"/docs/pr-preview/pr-48/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_2926":60779,"_25639":60774,"_5":25980,"_17911":103051,"_24291":103052,"_2452":103053},[],"/docs/pr-preview/pr-48/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_2926":60780,"_25639":60774,"_5":25980,"_17911":103055,"_24291":103056,"_2452":103057},[],"/docs/pr-preview/pr-48/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_2926":60781,"_25639":60774,"_5":25980,"_17911":103059,"_24291":103060,"_2452":103061},[],"/docs/pr-preview/pr-48/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_2926":60782,"_25639":60774,"_5":25980,"_17911":103063,"_24291":103064,"_2452":103065},[],"/docs/pr-preview/pr-48/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_2926":60783,"_25639":60774,"_5":25980,"_17911":103067,"_24291":103068,"_2452":103069},[],"/docs/pr-preview/pr-48/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_2926":60784,"_25639":60774,"_5":25980,"_17911":103071,"_24291":103072,"_2452":103073},[],"/docs/pr-preview/pr-48/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_2926":60785,"_25639":60774,"_5":25980,"_17911":103075,"_24291":103076,"_2452":103077},[],"/docs/pr-preview/pr-48/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_2926":60786,"_25639":60774,"_5":25980,"_17911":103079,"_24291":103080,"_2452":103081},[],"/docs/pr-preview/pr-48/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_2926":60787,"_25639":60774,"_5":25980,"_17911":103083,"_24291":103084,"_2452":103085},[],"/docs/pr-preview/pr-48/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_2926":60788,"_25639":60774,"_17911":103087,"_5":17806,"_24291":60774,"_2452":103088},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_2926":60789,"_25639":60774,"_17911":103090,"_5":17806,"_24291":60774,"_2452":103091},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_2926":60790,"_25639":60774,"_17911":103093,"_5":17806,"_24291":103040,"_2452":103094},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_2926":60791,"_25639":60774,"_17911":103096,"_5":17806,"_24291":103040,"_2452":103097},[],"entorno, como producción y preproducción;",{"_2926":60792,"_25639":60774,"_17911":103099,"_5":17806,"_24291":103040,"_2452":103100},[],"propietario o equipo operador;",{"_2926":60793,"_25639":60774,"_17911":103102,"_5":17806,"_24291":103040,"_2452":103103},[],"familia de dispositivos o proceso de fabricación;",{"_2926":60794,"_25639":60774,"_17911":103105,"_5":17806,"_24291":103040,"_2452":103106},[],"región o requisito regulatorio;",{"_2926":60795,"_25639":60774,"_17911":103108,"_5":17806,"_24291":103040,"_2452":103109},[],"motor criptográfico o política de clave;",{"_2926":60796,"_25639":60774,"_17911":103111,"_5":17806,"_24291":103040,"_2452":103112},[],"ventana de mantenimiento y ritmo de renovación.",{"_2926":60797,"_25639":60774,"_17911":103114,"_5":17806,"_24291":103040,"_2452":103115},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_2926":60798,"_25639":60774,"_17911":103117,"_5":17806,"_24291":103040,"_2452":103118},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_2926":60799,"_25639":60774,"_17911":103120,"_5":17806,"_24291":103044,"_2452":103121},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_2926":60800,"_25639":60774,"_17911":103123,"_5":17806,"_24291":103044,"_2452":103124},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_2926":60801,"_25639":60774,"_17911":103126,"_5":17806,"_24291":103044,"_2452":103127},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_2926":60802,"_25639":60774,"_17911":103129,"_5":17806,"_24291":103048,"_2452":103130},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_2926":60803,"_25639":60774,"_17911":103132,"_5":17806,"_24291":103048,"_2452":103133},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_2926":60804,"_25639":60774,"_17911":103135,"_5":17806,"_24291":103048,"_2452":103136},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_2926":60805,"_25639":60774,"_17911":103138,"_5":17806,"_24291":103048,"_2452":103139},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_2926":60806,"_25639":60774,"_17911":103141,"_5":17806,"_24291":103056,"_2452":103142},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_2926":60807,"_25639":60774,"_17911":103144,"_5":17806,"_24291":103060,"_2452":103145},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_2926":60808,"_25639":60774,"_17911":103147,"_5":17806,"_24291":103064,"_2452":103148},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_2926":60809,"_25639":60774,"_17911":103150,"_5":17806,"_24291":103068,"_2452":103151},[],"Actualiza la CA de enrolamiento y el perfil de los DMS y añade la CA anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS mientras sigan renovando cohortes con certificados antiguos. La guía DMS documenta ese ajuste.",{"_2926":60810,"_25639":60774,"_17911":103153,"_5":17806,"_24291":103072,"_2452":103154},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_2926":60811,"_25639":60774,"_17911":103156,"_5":17806,"_24291":103076,"_2452":103157},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_2926":60812,"_25639":60774,"_17911":103159,"_5":17806,"_24291":103080,"_2452":103160},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_2926":60813,"_25639":60774,"_17911":103162,"_5":17806,"_24291":103080,"_2452":103163},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_2926":60814,"_25639":60774,"_17911":103165,"_5":17806,"_24291":103080,"_2452":103166},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_2926":60815,"_25639":60774,"_17911":103168,"_5":17806,"_24291":103080,"_2452":103169},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_2926":60816,"_25639":60774,"_17911":103171,"_5":17806,"_24291":103084,"_2452":103172},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_2926":60817,"_25639":60774,"_17911":103174,"_5":17806,"_24291":103084,"_2452":103175},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_2926":60818,"_25639":60774,"_17911":103177,"_5":17806,"_24291":103084,"_2452":103178},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_2926":60819,"_25639":60774,"_17911":103180,"_5":17806,"_24291":103084,"_2452":103181},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_2926":60820,"_25639":60774,"_17911":103183,"_5":17806,"_24291":103084,"_2452":103184},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_2926":60821,"_25639":60774,"_17911":103186,"_5":17806,"_24291":103084,"_2452":103187},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_2926":60822,"_25639":60774,"_17911":103189,"_5":17806,"_24291":103084,"_2452":103190},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_2926":60823,"_25639":60823,"_5":12558,"_2452":103192,"_25983":103193,"_17911":103194,"_24291":60823},"Autoridades de certificación",[41760,99445,46797,103033],[],{"_2926":60824,"_25639":60823,"_17911":103196,"_5":17806,"_24291":60823,"_2452":103197},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_2926":60825,"_25639":60823,"_5":25980,"_17911":103199,"_24291":103200,"_2452":103201},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_2926":60826,"_25639":60823,"_5":25980,"_17911":103203,"_24291":103204,"_2452":103205},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_2926":60827,"_25639":60823,"_5":25980,"_17911":103207,"_24291":103208,"_2452":98146},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-authorities#antes-de-empezar",{"_2926":60828,"_25639":60823,"_5":25980,"_17911":103210,"_24291":103211,"_2452":103212},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_2926":60829,"_25639":60823,"_5":25980,"_17911":103214,"_24291":103215,"_2452":103216},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_2926":60830,"_25639":60823,"_5":25980,"_17911":103218,"_24291":103219,"_2452":103220},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_2926":60831,"_25639":60823,"_5":25980,"_17911":103222,"_24291":103223,"_2452":103224},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_2926":60832,"_25639":60823,"_5":25980,"_17911":103226,"_24291":103227,"_2452":103228},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_2926":60833,"_25639":60823,"_5":25980,"_17911":103230,"_24291":103231,"_2452":103232},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_2926":60834,"_25639":60823,"_5":25980,"_17911":103234,"_24291":103235,"_2452":103236},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_2926":60835,"_25639":60823,"_5":25980,"_17911":103238,"_24291":103239,"_2452":103240},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_2926":60836,"_25639":60823,"_5":25980,"_17911":103242,"_24291":103243,"_2452":103244},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_2926":60837,"_25639":60823,"_5":25980,"_17911":103246,"_24291":103247,"_2452":103248},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_2926":60838,"_25639":60823,"_5":25980,"_17911":103250,"_24291":103251,"_2452":103252},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_2926":60839,"_25639":60823,"_5":25980,"_17911":103254,"_24291":103255,"_2452":103256},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_2926":60840,"_25639":60823,"_5":25980,"_17911":103258,"_24291":103259,"_2452":103260},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_2926":60841,"_25639":60823,"_5":25980,"_17911":103262,"_24291":103263,"_2452":103264},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_2926":60842,"_25639":60823,"_5":25980,"_17911":103266,"_24291":103267,"_2452":103268},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_2926":60843,"_25639":60823,"_5":25980,"_17911":103270,"_24291":103271,"_2452":103272},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_2926":60844,"_25639":60823,"_5":25980,"_17911":103274,"_24291":103275,"_2452":103276},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_2926":60845,"_25639":60823,"_5":25980,"_17911":103278,"_24291":103279,"_2452":103280},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_2926":60846,"_25639":60823,"_5":25980,"_17911":103282,"_24291":103283,"_2452":103284},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_2926":60847,"_25639":60823,"_17911":103286,"_5":17806,"_24291":60823,"_2452":103287},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_2926":60848,"_25639":60823,"_17911":103289,"_5":17806,"_24291":60823,"_2452":103290},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_2926":60849,"_25639":60823,"_17911":103292,"_5":17806,"_24291":60823,"_2452":103293},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_2926":60850,"_25639":60823,"_17911":103295,"_5":17806,"_24291":103200,"_2452":103296},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_2926":60851,"_25639":60823,"_17911":103298,"_5":17806,"_24291":103200,"_2452":103299},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_2926":60852,"_25639":60823,"_17911":103301,"_5":17806,"_24291":103200,"_2452":103302},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_2926":60853,"_25639":60823,"_17911":103304,"_5":17806,"_24291":103200,"_2452":103305},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_2926":60854,"_25639":60823,"_17911":103307,"_5":17806,"_24291":103200,"_2452":103308},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_2926":60855,"_25639":60823,"_17911":103310,"_5":17806,"_24291":103208,"_2452":103311},[],"Decide si la CA será raíz o intermedia.",{"_2926":60856,"_25639":60823,"_17911":103313,"_5":17806,"_24291":103208,"_2452":103314},[],"Elige el motor que custodiará la clave.",{"_2926":60857,"_25639":60823,"_17911":103316,"_5":17806,"_24291":103208,"_2452":103317},[],"Define una validez superior a la de los certificados que emitirá.",{"_2926":60858,"_25639":60823,"_17911":103319,"_5":17806,"_24291":103208,"_2452":103320},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_2926":60859,"_25639":60823,"_17911":103322,"_5":17806,"_24291":103211,"_2452":103323},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_2926":60860,"_25639":60823,"_17911":103325,"_5":17806,"_24291":103215,"_2452":103326},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_2926":60861,"_25639":60823,"_17911":103328,"_5":17806,"_24291":103215,"_2452":103329},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_2926":60862,"_25639":60823,"_17911":103331,"_5":17806,"_24291":103219,"_2452":103332},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_2926":60863,"_25639":60823,"_17911":103334,"_5":17806,"_24291":103223,"_2452":103335},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_2926":60864,"_25639":60823,"_17911":103337,"_5":17806,"_24291":103223,"_2452":103338},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_2926":60865,"_25639":60823,"_17911":103340,"_5":17806,"_24291":103223,"_2452":103341},[],"`ST`: estado o provincia.",{"_2926":60866,"_25639":60823,"_17911":103343,"_5":17806,"_24291":103223,"_2452":103344},[],"`L`: localidad.",{"_2926":60867,"_25639":60823,"_17911":103346,"_5":17806,"_24291":103223,"_2452":103347},[],"`O`: organización.",{"_2926":60868,"_25639":60823,"_17911":103349,"_5":17806,"_24291":103223,"_2452":103350},[],"`OU`: unidad organizativa.",{"_2926":60869,"_25639":60823,"_17911":103352,"_5":17806,"_24291":103223,"_2452":103353},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_2926":60870,"_25639":60823,"_17911":103355,"_5":17806,"_24291":103227,"_2452":103356},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_2926":60871,"_25639":60823,"_17911":103358,"_5":17806,"_24291":103227,"_2452":103359},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_2926":60872,"_25639":60823,"_17911":103361,"_5":17806,"_24291":103231,"_2452":103362},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_2926":60873,"_25639":60823,"_17911":103364,"_5":17806,"_24291":103231,"_2452":103365},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_2926":60874,"_25639":60823,"_17911":103367,"_5":17806,"_24291":103235,"_2452":103368},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_2926":60875,"_25639":60823,"_17911":103370,"_5":17806,"_24291":103235,"_2452":103371},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_2926":60876,"_25639":60823,"_17911":103373,"_5":17806,"_24291":103239,"_2452":103374},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_2926":60877,"_25639":60823,"_17911":103376,"_5":17806,"_24291":103243,"_2452":103377},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_2926":60878,"_25639":60823,"_17911":103379,"_5":17806,"_24291":103247,"_2452":103380},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_2926":60879,"_25639":60823,"_17911":103382,"_5":17806,"_24291":103251,"_2452":103383},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_2926":60880,"_25639":60823,"_17911":103385,"_5":17806,"_24291":103255,"_2452":103386},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_2926":60881,"_25639":60823,"_17911":103388,"_5":17806,"_24291":103255,"_2452":103389},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_2926":60882,"_25639":60823,"_17911":103391,"_5":17806,"_24291":103259,"_2452":103392},[],"Abre una CA desde el inventario para consultar:",{"_2926":60883,"_25639":60823,"_17911":103394,"_5":17806,"_24291":103259,"_2452":103395},[],"Estado y periodo de validez.",{"_2926":60884,"_25639":60823,"_17911":103397,"_5":17806,"_24291":103259,"_2452":103398},[],"Certificado y cadena en formato PEM.",{"_2926":60885,"_25639":60823,"_17911":103400,"_5":17806,"_24291":103259,"_2452":103401},[],"Número de certificados activos, expirados y revocados.",{"_2926":60886,"_25639":60823,"_17911":103403,"_5":17806,"_24291":103259,"_2452":103404},[],"Certificados emitidos en **Issued Certificates**.",{"_2926":60887,"_25639":60823,"_17911":103406,"_5":17806,"_24291":103259,"_2452":103407},[],"CRL vinculada a la autoridad.",{"_2926":60888,"_25639":60823,"_17911":103409,"_5":17806,"_24291":103259,"_2452":103410},[],"Metadatos y motor criptográfico asociado.",{"_2926":60889,"_25639":60823,"_17911":103412,"_5":17806,"_24291":103259,"_2452":103413},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_2926":60890,"_25639":60823,"_17911":103415,"_5":17806,"_24291":103263,"_2452":103416},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_2926":60891,"_25639":60823,"_17911":103418,"_5":17806,"_24291":103263,"_2452":103419},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_2926":60892,"_25639":60823,"_17911":103421,"_5":17806,"_24291":103263,"_2452":103422},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_2926":60893,"_25639":60823,"_17911":103424,"_5":17806,"_24291":103263,"_2452":103425},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_2926":60894,"_25639":60823,"_17911":103427,"_5":17806,"_24291":103267,"_2452":103428},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_2926":60895,"_25639":60823,"_17911":103430,"_5":17806,"_24291":103271,"_2452":103431},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_2926":60896,"_25639":60823,"_17911":103433,"_5":17806,"_24291":103275,"_2452":103434},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_2926":60897,"_25639":60823,"_17911":103436,"_5":17806,"_24291":103279,"_2452":103437},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_2926":60898,"_25639":60823,"_17911":103439,"_5":17806,"_24291":103283,"_2452":103440},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_2926":60899,"_25639":60823,"_17911":103442,"_5":17806,"_24291":103283,"_2452":103443},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_2926":60900,"_25639":60900,"_5":12558,"_2452":103445,"_25983":103446,"_17911":103447,"_24291":60900},"Perfiles de certificado",[41760,99445,46797,103033],[],{"_2926":60901,"_25639":60900,"_17911":103449,"_5":17806,"_24291":60900,"_2452":103450},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_2926":60902,"_25639":60900,"_5":25980,"_17911":103452,"_24291":103453,"_2452":103454},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_2926":60903,"_25639":60900,"_5":25980,"_17911":103456,"_24291":103457,"_2452":103458},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-profiles#validez","Validez",{"_2926":60904,"_25639":60900,"_5":25980,"_17911":103460,"_24291":103461,"_2452":103462},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_2926":60905,"_25639":60900,"_5":25980,"_17911":103464,"_24291":103465,"_2452":103466},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_2926":60906,"_25639":60900,"_5":25980,"_17911":103468,"_24291":103469,"_2452":103470},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_2926":60907,"_25639":60900,"_5":25980,"_17911":103472,"_24291":103473,"_2452":103474},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_2926":60908,"_25639":60900,"_5":25980,"_17911":103476,"_24291":103477,"_2452":103478},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_2926":60909,"_25639":60900,"_5":25980,"_17911":103480,"_24291":103481,"_2452":103482},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_2926":60910,"_25639":60900,"_5":25980,"_17911":103484,"_24291":103485,"_2452":103486},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_2926":60911,"_25639":60900,"_5":25980,"_17911":103488,"_24291":103489,"_2452":103490},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_2926":60912,"_25639":60900,"_5":25980,"_17911":103492,"_24291":103493,"_2452":103494},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_2926":60913,"_25639":60900,"_5":25980,"_17911":103496,"_24291":103497,"_2452":103498},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_2926":60914,"_25639":60900,"_5":25980,"_17911":103500,"_24291":103501,"_2452":103502},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_2926":60915,"_25639":60900,"_5":25980,"_17911":103504,"_24291":103505,"_2452":103506},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_2926":60916,"_25639":60900,"_5":25980,"_17911":103508,"_24291":103509,"_2452":103510},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_2926":60917,"_25639":60900,"_5":25980,"_17911":103512,"_24291":103513,"_2452":103514},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_2926":60918,"_25639":60900,"_17911":103516,"_5":17806,"_24291":60900,"_2452":103517},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_2926":60919,"_25639":60900,"_17911":103519,"_5":17806,"_24291":60900,"_2452":103520},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_2926":60920,"_25639":60900,"_17911":103522,"_5":17806,"_24291":103457,"_2452":103523},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_2926":60921,"_25639":60900,"_17911":103525,"_5":17806,"_24291":103457,"_2452":103526},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_2926":60922,"_25639":60900,"_17911":103528,"_5":17806,"_24291":103461,"_2452":103529},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_2926":60923,"_25639":60900,"_17911":103531,"_5":17806,"_24291":103465,"_2452":103532},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_2926":60924,"_25639":60900,"_17911":103534,"_5":17806,"_24291":103465,"_2452":103535},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_2926":60925,"_25639":60900,"_17911":103537,"_5":17806,"_24291":103465,"_2452":103538},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_2926":60926,"_25639":60900,"_17911":103540,"_5":17806,"_24291":103469,"_2452":103541},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_2926":60927,"_25639":60900,"_17911":103543,"_5":17806,"_24291":103473,"_2452":103544},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_2926":60928,"_25639":60900,"_17911":103546,"_5":17806,"_24291":103473,"_2452":103547},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_2926":60929,"_25639":60900,"_17911":103549,"_5":17806,"_24291":103477,"_2452":103550},[],"La aplicación criptográfica puede:",{"_2926":60930,"_25639":60900,"_17911":103552,"_5":17806,"_24291":103477,"_2452":103553},[],"permitir o bloquear claves RSA;",{"_2926":60931,"_25639":60900,"_17911":103555,"_5":17806,"_24291":103477,"_2452":103556},[],"limitar los tamaños RSA admitidos;",{"_2926":60932,"_25639":60900,"_17911":103558,"_5":17806,"_24291":103477,"_2452":103559},[],"permitir o bloquear claves ECDSA;",{"_2926":60933,"_25639":60900,"_17911":103561,"_5":17806,"_24291":103477,"_2452":103562},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_2926":60934,"_25639":60900,"_17911":103564,"_5":17806,"_24291":103477,"_2452":103565},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_2926":60935,"_25639":60900,"_17911":103567,"_5":17806,"_24291":103481,"_2452":103568},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_2926":60936,"_25639":60900,"_17911":103570,"_5":17806,"_24291":103481,"_2452":99236},[],{"_2926":60937,"_25639":60900,"_17911":103572,"_5":17806,"_24291":103481,"_2452":103573},[],"Primera opción",{"_2926":60938,"_25639":60900,"_17911":103575,"_5":17806,"_24291":103481,"_2452":103576},[],"Segunda opción",{"_2926":60939,"_25639":60900,"_17911":103578,"_5":17806,"_24291":103481,"_2452":103579},[],"Si no hay ninguna",{"_2926":60940,"_25639":60900,"_17911":103581,"_5":17806,"_24291":103481,"_2452":103582},[],"Firma directa con una CA",{"_2926":60941,"_25639":60900,"_17911":103584,"_5":17806,"_24291":103481,"_2452":103585},[],"`issuance_profile` incluido en la solicitud",{"_2926":60942,"_25639":60900,"_17911":103587,"_5":17806,"_24291":103481,"_2452":103588},[],"`issuance_profile_id` de la solicitud",{"_2926":60943,"_25639":60900,"_17911":103590,"_5":17806,"_24291":103481,"_2452":103591},[],"Perfil predeterminado de la CA (`profile_id`).",{"_2926":60944,"_25639":60900,"_17911":103593,"_5":17806,"_24291":103481,"_2452":103594},[],"Emisión mediante DMS",{"_2926":60945,"_25639":60900,"_17911":103596,"_5":17806,"_24291":103481,"_2452":47362},[],{"_2926":60946,"_25639":60900,"_17911":103598,"_5":17806,"_24291":103481,"_2452":103599},[],"`settings.issuance_profile` incluido en el DMS",{"_2926":60947,"_25639":60900,"_17911":103601,"_5":17806,"_24291":103481,"_2452":103602},[],"Perfil predeterminado de la CA de enrolamiento.",{"_2926":60948,"_25639":60900,"_17911":103604,"_5":17806,"_24291":103481,"_2452":103605},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_2926":60949,"_25639":60900,"_17911":103607,"_5":17806,"_24291":103481,"_2452":103608},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_2926":60950,"_25639":60900,"_17911":103610,"_5":17806,"_24291":103489,"_2452":103611},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_2926":60951,"_25639":60900,"_17911":103613,"_5":17806,"_24291":103493,"_2452":103614},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_2926":60952,"_25639":60900,"_17911":103616,"_5":17806,"_24291":103497,"_2452":103617},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_2926":60953,"_25639":60900,"_17911":103619,"_5":17806,"_24291":103501,"_2452":103620},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_2926":60954,"_25639":60900,"_17911":103622,"_5":17806,"_24291":103505,"_2452":103623},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_2926":60955,"_25639":60900,"_17911":103625,"_5":17806,"_24291":103505,"_2452":103626},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_2926":60956,"_25639":60900,"_17911":103628,"_5":17806,"_24291":103509,"_2452":103629},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_2926":60957,"_25639":60900,"_17911":103631,"_5":17806,"_24291":103509,"_2452":103632},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_2926":60958,"_25639":60900,"_17911":103634,"_5":17806,"_24291":103509,"_2452":103635},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_2926":60959,"_25639":60900,"_17911":103637,"_5":17806,"_24291":103509,"_2452":103638},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_2926":60960,"_25639":60900,"_17911":103640,"_5":17806,"_24291":103513,"_2452":103641},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_2926":60961,"_25639":60900,"_17911":103643,"_5":17806,"_24291":103513,"_2452":103644},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_2926":60962,"_25639":60962,"_5":12558,"_2452":103646,"_25983":103647,"_17911":103649,"_24291":60962},"Validación de certificados",[41760,99445,46797,103648],"Validación",[],{"_2926":60963,"_25639":60962,"_17911":103651,"_5":17806,"_24291":60962,"_2452":103652},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_2926":60964,"_25639":60962,"_5":25980,"_17911":103654,"_24291":103655,"_2452":103656},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_2926":60965,"_25639":60962,"_5":25980,"_17911":103658,"_24291":103659,"_2452":103660},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_2926":60966,"_25639":60962,"_5":25980,"_17911":103662,"_24291":103663,"_2452":103664},[],"/docs/pr-preview/pr-48/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_2926":60967,"_25639":60962,"_17911":103666,"_5":17806,"_24291":60962,"_2452":103667},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_2926":60968,"_25639":60962,"_17911":103669,"_5":17806,"_24291":103655,"_2452":103670},[],"Verifica estos criterios juntos:",{"_2926":60969,"_25639":60962,"_17911":103672,"_5":17806,"_24291":103655,"_2452":102660},[],{"_2926":60970,"_25639":60962,"_17911":103674,"_5":17806,"_24291":103655,"_2452":103675},[],"Resultado necesario",{"_2926":60971,"_25639":60962,"_17911":103677,"_5":17806,"_24291":103655,"_2452":103678},[],"Cadena y firma",{"_2926":60972,"_25639":60962,"_17911":103680,"_5":17806,"_24291":103655,"_2452":103681},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_2926":60973,"_25639":60962,"_17911":103683,"_5":17806,"_24291":103655,"_2452":103684},[],"Fechas",{"_2926":60974,"_25639":60962,"_17911":103686,"_5":17806,"_24291":103655,"_2452":103687},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_2926":60975,"_25639":60962,"_17911":103689,"_5":17806,"_24291":103655,"_2452":99149},[],{"_2926":60976,"_25639":60962,"_17911":103691,"_5":17806,"_24291":103655,"_2452":103692},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_2926":60977,"_25639":60962,"_17911":103694,"_5":17806,"_24291":103655,"_2452":103695},[],"Uso",{"_2926":60978,"_25639":60962,"_17911":103697,"_5":17806,"_24291":103655,"_2452":103698},[],"KU, EKU y restricciones permiten la operación concreta.",{"_2926":60979,"_25639":60962,"_17911":103700,"_5":17806,"_24291":103655,"_2452":103701},[],"Revocación",{"_2926":60980,"_25639":60962,"_17911":103703,"_5":17806,"_24291":103655,"_2452":103704},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_2926":60981,"_25639":60962,"_17911":103706,"_5":17806,"_24291":103655,"_2452":103707},[],"Autorización",{"_2926":60982,"_25639":60962,"_17911":103709,"_5":17806,"_24291":103655,"_2452":103710},[],"La aplicación permite la acción a esa identidad.",{"_2926":60983,"_25639":60962,"_17911":103712,"_5":17806,"_24291":103655,"_2452":103713},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_2926":60984,"_25639":60962,"_17911":103715,"_5":17806,"_24291":103659,"_2452":103716},[],"Mecanismo",{"_2926":60985,"_25639":60962,"_17911":103718,"_5":17806,"_24291":103659,"_2452":103719},[],"Cuándo utilizarlo",{"_2926":60986,"_25639":60962,"_17911":103721,"_5":17806,"_24291":103659,"_2452":103722},[],"Qué debes mantener",{"_2926":60987,"_25639":60962,"_17911":103724,"_5":17806,"_24291":103659,"_2452":47490},[],{"_2926":60988,"_25639":60962,"_17911":103726,"_5":17806,"_24291":103659,"_2452":103727},[],"Consulta del estado de un certificado concreto.",{"_2926":60989,"_25639":60962,"_17911":103729,"_5":17806,"_24291":103659,"_2452":103730},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_2926":60990,"_25639":60962,"_17911":103732,"_5":17806,"_24291":103659,"_2452":47499},[],{"_2926":60991,"_25639":60962,"_17911":103734,"_5":17806,"_24291":103659,"_2452":103735},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_2926":60992,"_25639":60962,"_17911":103737,"_5":17806,"_24291":103659,"_2452":103738},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_2926":60993,"_25639":60962,"_17911":103740,"_5":17806,"_24291":103659,"_2452":103741},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_2926":60994,"_25639":60962,"_17911":103743,"_5":17806,"_24291":103659,"_2452":103744},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_2926":60995,"_25639":60962,"_17911":103746,"_5":17806,"_24291":103663,"_2452":103747},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_2926":60996,"_25639":60962,"_17911":103749,"_5":17806,"_24291":103663,"_2452":103750},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_2926":60997,"_25639":60962,"_17911":103752,"_5":17806,"_24291":103663,"_2452":103753},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_2926":60998,"_25639":60962,"_17911":103755,"_5":17806,"_24291":103663,"_2452":103756},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_2926":60999,"_25639":60962,"_17911":103758,"_5":17806,"_24291":103663,"_2452":103759},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_2926":61000,"_25639":60962,"_17911":103761,"_5":17806,"_24291":103663,"_2452":103762},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_2926":61001,"_25639":60962,"_17911":103764,"_5":17806,"_24291":103663,"_2452":103765},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_2926":61002,"_25639":60962,"_17911":103767,"_5":17806,"_24291":103663,"_2452":103768},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_2926":61003,"_25639":60962,"_17911":103770,"_5":17806,"_24291":103663,"_2452":103771},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_2926":61004,"_25639":61004,"_5":12558,"_2452":103773,"_25983":103774,"_17911":103775,"_24291":61004},"Certificados",[41760,99445,46797,103033],[],{"_2926":61005,"_25639":61004,"_17911":103777,"_5":17806,"_24291":61004,"_2452":103778},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_2926":61006,"_25639":61004,"_5":25980,"_17911":103780,"_24291":103781,"_2452":103782},[],"/docs/pr-preview/pr-48/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_2926":61007,"_25639":61004,"_5":25980,"_17911":103784,"_24291":103785,"_2452":103786},[],"/docs/pr-preview/pr-48/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_2926":61008,"_25639":61004,"_5":25980,"_17911":103788,"_24291":103789,"_2452":103790},[],"/docs/pr-preview/pr-48/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_2926":61009,"_25639":61004,"_5":25980,"_17911":103792,"_24291":103793,"_2452":103794},[],"/docs/pr-preview/pr-48/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_2926":61010,"_25639":61004,"_5":25980,"_17911":103796,"_24291":103797,"_2452":103798},[],"/docs/pr-preview/pr-48/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_2926":61011,"_25639":61004,"_5":25980,"_17911":103800,"_24291":103801,"_2452":103802},[],"/docs/pr-preview/pr-48/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_2926":61012,"_25639":61004,"_5":25980,"_17911":103804,"_24291":103805,"_2452":103806},[],"/docs/pr-preview/pr-48/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_2926":61013,"_25639":61004,"_5":25980,"_17911":103808,"_24291":103809,"_2452":103810},[],"/docs/pr-preview/pr-48/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_2926":61014,"_25639":61004,"_5":25980,"_17911":103812,"_24291":103813,"_2452":103814},[],"/docs/pr-preview/pr-48/es/platform/pki/certificates#continúa","Continúa",{"_2926":61015,"_25639":61004,"_17911":103816,"_5":17806,"_24291":61004,"_2452":103817},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_2926":61016,"_25639":61004,"_17911":103819,"_5":17806,"_24291":103781,"_2452":103820},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_2926":61017,"_25639":61004,"_17911":103822,"_5":17806,"_24291":103781,"_2452":103823},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_2926":61018,"_25639":61004,"_17911":103825,"_5":17806,"_24291":103785,"_2452":103826},[],"Descarga el PEM e inspecciónalo:",{"_2926":61019,"_25639":61004,"_17911":103828,"_5":17806,"_24291":103785,"_2452":103829},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_2926":61020,"_25639":61004,"_17911":103831,"_5":17806,"_24291":103789,"_2452":103832},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_2926":61021,"_25639":61004,"_17911":103834,"_5":17806,"_24291":103789,"_2452":103835},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_2926":61022,"_25639":61004,"_17911":103837,"_5":17806,"_24291":103789,"_2452":103838},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_2926":61023,"_25639":61004,"_17911":103840,"_5":17806,"_24291":103789,"_2452":103841},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_2926":61024,"_25639":61004,"_17911":103843,"_5":17806,"_24291":103789,"_2452":103844},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_2926":61025,"_25639":61004,"_17911":103846,"_5":17806,"_24291":103789,"_2452":103847},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_2926":61026,"_25639":61004,"_17911":103849,"_5":17806,"_24291":103789,"_2452":103850},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_2926":61027,"_25639":61004,"_17911":103852,"_5":17806,"_24291":103793,"_2452":103853},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_2926":61028,"_25639":61004,"_17911":103855,"_5":17806,"_24291":103797,"_2452":103856},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_2926":61029,"_25639":61004,"_17911":103858,"_5":17806,"_24291":103801,"_2452":103859},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_2926":61030,"_25639":61004,"_17911":103861,"_5":17806,"_24291":103805,"_2452":103862},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_2926":61031,"_25639":61004,"_17911":103864,"_5":17806,"_24291":103805,"_2452":103865},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_2926":61032,"_25639":61004,"_17911":103867,"_5":17806,"_24291":103805,"_2452":103868},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_2926":61033,"_25639":61004,"_17911":103870,"_5":17806,"_24291":103809,"_2452":103871},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_2926":61034,"_25639":61004,"_17911":103873,"_5":17806,"_24291":103809,"_2452":103874},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_2926":61035,"_25639":61004,"_17911":103876,"_5":17806,"_24291":103809,"_2452":103877},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_2926":61036,"_25639":61004,"_17911":103879,"_5":17806,"_24291":103813,"_2452":103880},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_2926":61037,"_25639":61004,"_17911":103882,"_5":17806,"_24291":103813,"_2452":103883},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_2926":61038,"_25639":61038,"_5":12558,"_2452":103885,"_25983":103886,"_17911":103888,"_24291":61038},"Ciclo de vida de un certificado",[41760,99445,46797,103887],"Conceptos",[],{"_2926":61039,"_25639":61038,"_17911":103890,"_5":17806,"_24291":61038,"_2452":103891},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_2926":61040,"_25639":61038,"_5":25980,"_17911":103893,"_24291":103894,"_2452":103895},[],"/docs/pr-preview/pr-48/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_2926":61041,"_25639":61038,"_5":25980,"_17911":103897,"_24291":103898,"_2452":103899},[],"/docs/pr-preview/pr-48/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_2926":61042,"_25639":61038,"_5":25980,"_17911":103901,"_24291":103902,"_2452":103903},[],"/docs/pr-preview/pr-48/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_2926":61043,"_25639":61038,"_5":25980,"_17911":103905,"_24291":103906,"_2452":103907},[],"/docs/pr-preview/pr-48/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_2926":61044,"_25639":61038,"_5":25980,"_17911":103909,"_24291":103910,"_2452":103911},[],"/docs/pr-preview/pr-48/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_2926":61045,"_25639":61038,"_5":25980,"_17911":103913,"_24291":103914,"_2452":103915},[],"/docs/pr-preview/pr-48/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_2926":61046,"_25639":61038,"_5":25980,"_17911":103917,"_24291":103918,"_2452":103919},[],"/docs/pr-preview/pr-48/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_2926":61047,"_25639":61038,"_5":25980,"_17911":103921,"_24291":103922,"_2452":103923},[],"/docs/pr-preview/pr-48/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_2926":61048,"_25639":61038,"_5":25980,"_17911":103925,"_24291":103926,"_2452":103927},[],"/docs/pr-preview/pr-48/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_2926":61049,"_25639":61038,"_5":25980,"_17911":103929,"_24291":103930,"_2452":103931},[],"/docs/pr-preview/pr-48/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_2926":61050,"_25639":61038,"_17911":103933,"_5":17806,"_24291":61038,"_2452":103934},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_2926":61051,"_25639":61038,"_17911":103936,"_5":17806,"_24291":103898,"_2452":103937},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_2926":61052,"_25639":61038,"_17911":103939,"_5":17806,"_24291":103902,"_2452":103940},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_2926":61053,"_25639":61038,"_17911":103942,"_5":17806,"_24291":103906,"_2452":103943},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_2926":61054,"_25639":61038,"_17911":103945,"_5":17806,"_24291":103910,"_2452":103946},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_2926":61055,"_25639":61038,"_17911":103948,"_5":17806,"_24291":103914,"_2452":103949},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_2926":61056,"_25639":61038,"_17911":103951,"_5":17806,"_24291":103918,"_2452":103952},[],"Lamassu persiste cuatro estados X.509:",{"_2926":61057,"_25639":61038,"_17911":103954,"_5":17806,"_24291":103918,"_2452":103955},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_2926":61058,"_25639":61038,"_17911":103957,"_5":17806,"_24291":103918,"_2452":103958},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_2926":61059,"_25639":61038,"_17911":103960,"_5":17806,"_24291":103918,"_2452":103961},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_2926":61060,"_25639":61038,"_17911":103963,"_5":17806,"_24291":103918,"_2452":103964},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_2926":61061,"_25639":61038,"_17911":103966,"_5":17806,"_24291":103918,"_2452":103967},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_2926":61062,"_25639":61038,"_17911":103969,"_5":17806,"_24291":103922,"_2452":103970},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_2926":61063,"_25639":61038,"_17911":103972,"_5":17806,"_24291":103922,"_2452":103973},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_2926":61064,"_25639":61038,"_17911":103975,"_5":17806,"_24291":103922,"_2452":103976},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_2926":61065,"_25639":61038,"_17911":103978,"_5":17806,"_24291":103926,"_2452":103979},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_2926":61066,"_25639":61038,"_17911":103981,"_5":17806,"_24291":103926,"_2452":103982},[],"Antes de confirmar:",{"_2926":61067,"_25639":61038,"_17911":103984,"_5":17806,"_24291":103926,"_2452":103985},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_2926":61068,"_25639":61038,"_17911":103987,"_5":17806,"_24291":103926,"_2452":103988},[],"Distribuye la nueva cadena de confianza.",{"_2926":61069,"_25639":61038,"_17911":103990,"_5":17806,"_24291":103926,"_2452":103991},[],"Reemite las identidades necesarias.",{"_2926":61070,"_25639":61038,"_17911":103993,"_5":17806,"_24291":103926,"_2452":103994},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_2926":61071,"_25639":61038,"_17911":103996,"_5":17806,"_24291":103926,"_2452":103997},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_2926":61072,"_25639":61038,"_17911":103999,"_5":17806,"_24291":103926,"_2452":104000},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_2926":61073,"_25639":61038,"_17911":104002,"_5":17806,"_24291":103930,"_2452":104003},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_2926":61074,"_25639":61038,"_17911":104005,"_5":17806,"_24291":103930,"_2452":104006},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_2926":61075,"_25639":61038,"_17911":104008,"_5":17806,"_24291":103930,"_2452":104009},[],"Cambios de estado y razones de revocación.",{"_2926":61076,"_25639":61038,"_17911":104011,"_5":17806,"_24291":103930,"_2452":104012},[],"Publicación y vigencia de OCSP y CRLs.",{"_2926":61077,"_25639":61038,"_17911":104014,"_5":17806,"_24291":103930,"_2452":104015},[],"Dependencias que todavía presentan un certificado sustituido.",{"_2926":61078,"_25639":61038,"_17911":104017,"_5":17806,"_24291":103930,"_2452":104018},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_2926":61079,"_25639":61079,"_5":12558,"_2452":104020,"_25983":104021,"_17911":104022,"_24291":61079},"Modelo de confianza",[41760,99445,46797,103887],[],{"_2926":61080,"_25639":61079,"_17911":104024,"_5":17806,"_24291":61079,"_2452":104025},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_2926":61081,"_25639":61079,"_5":25980,"_17911":104027,"_24291":104028,"_2452":104029},[],"/docs/pr-preview/pr-48/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_2926":61082,"_25639":61079,"_5":25980,"_17911":104031,"_24291":104032,"_2452":104033},[],"/docs/pr-preview/pr-48/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_2926":61083,"_25639":61079,"_5":25980,"_17911":104035,"_24291":104036,"_2452":104037},[],"/docs/pr-preview/pr-48/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_2926":61084,"_25639":61079,"_5":25980,"_17911":104039,"_24291":104040,"_2452":104041},[],"/docs/pr-preview/pr-48/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_2926":61085,"_25639":61079,"_5":25980,"_17911":104043,"_24291":104044,"_2452":104045},[],"/docs/pr-preview/pr-48/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_2926":61086,"_25639":61079,"_5":25980,"_17911":104047,"_24291":104048,"_2452":104049},[],"/docs/pr-preview/pr-48/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_2926":61087,"_25639":61079,"_5":25980,"_17911":104051,"_24291":104052,"_2452":104053},[],"/docs/pr-preview/pr-48/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_2926":61088,"_25639":61079,"_5":25980,"_17911":104055,"_24291":104056,"_2452":104057},[],"/docs/pr-preview/pr-48/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_2926":61089,"_25639":61079,"_5":25980,"_17911":104059,"_24291":104060,"_2452":104061},[],"/docs/pr-preview/pr-48/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_2926":61090,"_25639":61079,"_5":25980,"_17911":104063,"_24291":104064,"_2452":104065},[],"/docs/pr-preview/pr-48/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_2926":61091,"_25639":61079,"_17911":104067,"_5":17806,"_24291":61079,"_2452":104068},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_2926":61092,"_25639":61079,"_17911":104070,"_5":17806,"_24291":104032,"_2452":104071},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_2926":61093,"_25639":61079,"_17911":104073,"_5":17806,"_24291":104036,"_2452":104074},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_2926":61094,"_25639":61079,"_17911":104076,"_5":17806,"_24291":104040,"_2452":104077},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_2926":61095,"_25639":61079,"_17911":104079,"_5":17806,"_24291":104044,"_2452":104080},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_2926":61096,"_25639":61079,"_17911":104082,"_5":17806,"_24291":104048,"_2452":104083},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_2926":61097,"_25639":61079,"_17911":104085,"_5":17806,"_24291":104048,"_2452":104086},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_2926":61098,"_25639":61079,"_17911":104088,"_5":17806,"_24291":104048,"_2452":104089},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_2926":61099,"_25639":61079,"_17911":104091,"_5":17806,"_24291":104048,"_2452":104092},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_2926":61100,"_25639":61079,"_17911":104094,"_5":17806,"_24291":104048,"_2452":104095},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_2926":61101,"_25639":61079,"_17911":104097,"_5":17806,"_24291":104048,"_2452":104098},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_2926":61102,"_25639":61079,"_17911":104100,"_5":17806,"_24291":104052,"_2452":104101},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_2926":61103,"_25639":61079,"_17911":104103,"_5":17806,"_24291":104052,"_2452":104104},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_2926":61104,"_25639":61079,"_17911":104106,"_5":17806,"_24291":104052,"_2452":104107},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación configuradas en el bloque de re-enrolamiento.",{"_2926":61105,"_25639":61079,"_17911":104109,"_5":17806,"_24291":104052,"_2452":104110},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_2926":61106,"_25639":61079,"_17911":104112,"_5":17806,"_24291":104052,"_2452":104113},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_2926":61107,"_25639":61079,"_17911":104115,"_5":17806,"_24291":104056,"_2452":104116},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_2926":61108,"_25639":61079,"_17911":104118,"_5":17806,"_24291":104056,"_2452":104119},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_2926":61109,"_25639":61079,"_17911":104121,"_5":17806,"_24291":104056,"_2452":104122},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_2926":61110,"_25639":61079,"_17911":104124,"_5":17806,"_24291":104056,"_2452":104125},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_2926":61111,"_25639":61079,"_17911":104127,"_5":17806,"_24291":104056,"_2452":104128},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_2926":61112,"_25639":61079,"_17911":104130,"_5":17806,"_24291":104056,"_2452":104131},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_2926":61113,"_25639":61079,"_17911":104133,"_5":17806,"_24291":104056,"_2452":104134},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_2926":61114,"_25639":61079,"_17911":104136,"_5":17806,"_24291":104060,"_2452":104137},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_2926":61115,"_25639":61079,"_17911":104139,"_5":17806,"_24291":104064,"_2452":104140},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_2926":61116,"_25639":61079,"_17911":104142,"_5":17806,"_24291":104064,"_2452":104143},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_2926":61117,"_25639":61079,"_17911":104145,"_5":17806,"_24291":104064,"_2452":104146},[],"Asigna perfiles explícitos a cada caso de uso.",{"_2926":61118,"_25639":61079,"_17911":104148,"_5":17806,"_24291":104064,"_2452":104149},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_2926":61119,"_25639":61079,"_17911":104151,"_5":17806,"_24291":104064,"_2452":104152},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_2926":61120,"_25639":61079,"_17911":104154,"_5":17806,"_24291":104064,"_2452":104155},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_2926":61121,"_25639":61079,"_17911":104157,"_5":17806,"_24291":104064,"_2452":104158},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_2926":61122,"_25639":61122,"_5":12558,"_2452":104160,"_25983":104161,"_17911":104162,"_24291":61122},"Listas de revocación (CRL)",[41760,99445,46797,103648],[],{"_2926":61123,"_25639":61122,"_17911":104164,"_5":17806,"_24291":61122,"_2452":104165},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_2926":61124,"_25639":61122,"_5":25980,"_17911":104167,"_24291":104168,"_2452":104169},[],"/docs/pr-preview/pr-48/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_2926":61125,"_25639":61122,"_5":25980,"_17911":104171,"_24291":104172,"_2452":104173},[],"/docs/pr-preview/pr-48/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_2926":61126,"_25639":61122,"_5":25980,"_17911":104175,"_24291":104176,"_2452":104177},[],"/docs/pr-preview/pr-48/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_2926":61127,"_25639":61122,"_5":25980,"_17911":104179,"_24291":104180,"_2452":104181},[],"/docs/pr-preview/pr-48/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_2926":61128,"_25639":61122,"_5":25980,"_17911":104183,"_24291":104184,"_2452":104185},[],"/docs/pr-preview/pr-48/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_2926":61129,"_25639":61122,"_5":25980,"_17911":104187,"_24291":104188,"_2452":104189},[],"/docs/pr-preview/pr-48/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_2926":61130,"_25639":61122,"_5":25980,"_17911":104191,"_24291":104192,"_2452":104193},[],"/docs/pr-preview/pr-48/es/platform/pki/crl#referencias","Referencias",{"_2926":61131,"_25639":61122,"_17911":104195,"_5":17806,"_24291":61122,"_2452":104196},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_2926":61132,"_25639":61122,"_17911":104198,"_5":17806,"_24291":104168,"_2452":104199},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_2926":61133,"_25639":61122,"_17911":104201,"_5":17806,"_24291":104168,"_2452":104202},[],"Campo de `crl_options`",{"_2926":61134,"_25639":61122,"_17911":104204,"_5":17806,"_24291":104168,"_2452":100941},[],{"_2926":61135,"_25639":61122,"_17911":104206,"_5":17806,"_24291":104168,"_2452":104207},[],"Valor inicial del backend",{"_2926":61136,"_25639":61122,"_17911":104209,"_5":17806,"_24291":104168,"_2452":47977},[],{"_2926":61137,"_25639":61122,"_17911":104211,"_5":17806,"_24291":104168,"_2452":104212},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_2926":61138,"_25639":61122,"_17911":104214,"_5":17806,"_24291":104168,"_2452":104215},[],"7 días.",{"_2926":61139,"_25639":61122,"_17911":104217,"_5":17806,"_24291":104168,"_2452":47986},[],{"_2926":61140,"_25639":61122,"_17911":104219,"_5":17806,"_24291":104168,"_2452":104220},[],"Plazo desde la publicación que activa la renovación programada.",{"_2926":61141,"_25639":61122,"_17911":104222,"_5":17806,"_24291":104168,"_2452":104223},[],"6 días y 23 horas.",{"_2926":61142,"_25639":61122,"_17911":104225,"_5":17806,"_24291":104168,"_2452":47995},[],{"_2926":61143,"_25639":61122,"_17911":104227,"_5":17806,"_24291":104168,"_2452":104228},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_2926":61144,"_25639":61122,"_17911":104230,"_5":17806,"_24291":104168,"_2452":48001},[],{"_2926":61145,"_25639":61122,"_17911":104232,"_5":17806,"_24291":104168,"_2452":48004},[],{"_2926":61146,"_25639":61122,"_17911":104234,"_5":17806,"_24291":104168,"_2452":104235},[],"Campo de configuración inicializado con el SKI de la CA.",{"_2926":61147,"_25639":61122,"_17911":104237,"_5":17806,"_24291":104168,"_2452":104238},[],"SKI de la CA.",{"_2926":61148,"_25639":61122,"_17911":104240,"_5":17806,"_24291":104168,"_2452":104241},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_2926":61149,"_25639":61122,"_17911":104243,"_5":17806,"_24291":104168,"_2452":104244},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_2926":61150,"_25639":61122,"_17911":104246,"_5":17806,"_24291":104172,"_2452":104247},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_2926":61151,"_25639":61122,"_17911":104249,"_5":17806,"_24291":104172,"_2452":104250},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_2926":61152,"_25639":61122,"_17911":104252,"_5":17806,"_24291":104172,"_2452":104253},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_2926":61153,"_25639":61122,"_17911":104255,"_5":17806,"_24291":104176,"_2452":104256},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_2926":61154,"_25639":61122,"_17911":104258,"_5":17806,"_24291":104176,"_2452":104259},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_2926":61155,"_25639":61122,"_17911":104261,"_5":17806,"_24291":104180,"_2452":104262},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_2926":61156,"_25639":61122,"_17911":104264,"_5":17806,"_24291":104180,"_2452":104265},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_2926":61157,"_25639":61122,"_17911":104267,"_5":17806,"_24291":104180,"_2452":104268},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_2926":61158,"_25639":61122,"_17911":104270,"_5":17806,"_24291":104180,"_2452":104271},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_2926":61159,"_25639":61122,"_17911":104273,"_5":17806,"_24291":104180,"_2452":104274},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_2926":61160,"_25639":61122,"_17911":104276,"_5":17806,"_24291":104184,"_2452":104277},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_2926":61161,"_25639":61122,"_17911":104279,"_5":17806,"_24291":104184,"_2452":101130},[],{"_2926":61162,"_25639":61122,"_17911":104281,"_5":17806,"_24291":104184,"_2452":104282},[],"Path relativo",{"_2926":61163,"_25639":61122,"_17911":104284,"_5":17806,"_24291":104184,"_2452":99236},[],{"_2926":61164,"_25639":61122,"_17911":104286,"_5":17806,"_24291":104184,"_2452":48059},[],{"_2926":61165,"_25639":61122,"_17911":104288,"_5":17806,"_24291":104184,"_2452":48062},[],{"_2926":61166,"_25639":61122,"_17911":104290,"_5":17806,"_24291":104184,"_2452":104291},[],"Consultar `crl_options` y `latest_crl`.",{"_2926":61167,"_25639":61122,"_17911":104293,"_5":17806,"_24291":104184,"_2452":48068},[],{"_2926":61168,"_25639":61122,"_17911":104295,"_5":17806,"_24291":104184,"_2452":48062},[],{"_2926":61169,"_25639":61122,"_17911":104297,"_5":17806,"_24291":104184,"_2452":104298},[],"Sustituir la configuración de CRL.",{"_2926":61170,"_25639":61122,"_17911":104300,"_5":17806,"_24291":104184,"_2452":104301},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_2926":61171,"_25639":61122,"_17911":104303,"_5":17806,"_24291":104184,"_2452":104304},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_2926":61172,"_25639":61122,"_17911":104306,"_5":17806,"_24291":104188,"_2452":104307},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_2926":61173,"_25639":61122,"_17911":104309,"_5":17806,"_24291":104192,"_2452":104310},[],"RFC 5280: perfil X.509 y CRL.",{"_2926":61174,"_25639":61122,"_17911":104312,"_5":17806,"_24291":104192,"_2452":48088},[],{"_2926":61175,"_25639":61122,"_17911":104314,"_5":17806,"_24291":104192,"_2452":48091},[],{"_2926":61176,"_25639":61122,"_17911":104316,"_5":17806,"_24291":104192,"_2452":104317},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_2926":61177,"_25639":61122,"_17911":104319,"_5":17806,"_24291":104192,"_2452":104320},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2926":61178,"_25639":61178,"_5":12558,"_2452":104322,"_25983":104323,"_17911":104324,"_24291":61178},"Claves y motores criptográficos",[41760,99445,46797,103033],[],{"_2926":61179,"_25639":61178,"_17911":104326,"_5":17806,"_24291":61178,"_2452":104327},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_2926":61180,"_25639":61178,"_5":25980,"_17911":104329,"_24291":104330,"_2452":104331},[],"/docs/pr-preview/pr-48/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_2926":61181,"_25639":61178,"_5":25980,"_17911":104333,"_24291":104334,"_2452":104335},[],"/docs/pr-preview/pr-48/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_2926":61182,"_25639":61178,"_5":25980,"_17911":104337,"_24291":104338,"_2452":48116},[],"/docs/pr-preview/pr-48/es/platform/pki/key-management#file-system",{"_2926":61183,"_25639":61178,"_5":25980,"_17911":104340,"_24291":104341,"_2452":48120},[],"/docs/pr-preview/pr-48/es/platform/pki/key-management#hashicorp-vault",{"_2926":61184,"_25639":61178,"_5":25980,"_17911":104343,"_24291":104344,"_2452":48124},[],"/docs/pr-preview/pr-48/es/platform/pki/key-management#aws-secrets-manager",{"_2926":61185,"_25639":61178,"_5":25980,"_17911":104346,"_24291":104347,"_2452":48128},[],"/docs/pr-preview/pr-48/es/platform/pki/key-management#aws-kms",{"_2926":61186,"_25639":61178,"_5":25980,"_17911":104349,"_24291":104350,"_2452":48132},[],"/docs/pr-preview/pr-48/es/platform/pki/key-management#pkcs11",{"_2926":61187,"_25639":61178,"_5":25980,"_17911":104352,"_24291":104353,"_2452":48136},[],"/docs/pr-preview/pr-48/es/platform/pki/key-management#azure-key-vault",{"_2926":61188,"_25639":61178,"_5":25980,"_17911":104355,"_24291":104356,"_2452":104357},[],"/docs/pr-preview/pr-48/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_2926":61189,"_25639":61178,"_5":25980,"_17911":104359,"_24291":104360,"_2452":104361},[],"/docs/pr-preview/pr-48/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_2926":61190,"_25639":61178,"_5":25980,"_17911":104363,"_24291":104364,"_2452":104365},[],"/docs/pr-preview/pr-48/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_2926":61191,"_25639":61178,"_5":25980,"_17911":104367,"_24291":104368,"_2452":104369},[],"/docs/pr-preview/pr-48/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_2926":61192,"_25639":61178,"_5":25980,"_17911":104371,"_24291":104372,"_2452":104373},[],"/docs/pr-preview/pr-48/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_2926":61193,"_25639":61178,"_5":25980,"_17911":104375,"_24291":104376,"_2452":104377},[],"/docs/pr-preview/pr-48/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_2926":61194,"_25639":61178,"_5":25980,"_17911":104379,"_24291":104380,"_2452":104381},[],"/docs/pr-preview/pr-48/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_2926":61195,"_25639":61178,"_5":25980,"_17911":104383,"_24291":104384,"_2452":48168},[],"/docs/pr-preview/pr-48/es/platform/pki/key-management#sign",{"_2926":61196,"_25639":61178,"_5":25980,"_17911":104386,"_24291":104387,"_2452":48172},[],"/docs/pr-preview/pr-48/es/platform/pki/key-management#verify",{"_2926":61197,"_25639":61178,"_5":25980,"_17911":104389,"_24291":104390,"_2452":104391},[],"/docs/pr-preview/pr-48/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_2926":61198,"_25639":61178,"_5":25980,"_17911":104393,"_24291":104394,"_2452":104395},[],"/docs/pr-preview/pr-48/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_2926":61199,"_25639":61178,"_5":25980,"_17911":104397,"_24291":104398,"_2452":104399},[],"/docs/pr-preview/pr-48/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_2926":61200,"_25639":61178,"_17911":104401,"_5":17806,"_24291":61178,"_2452":104402},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_2926":61201,"_25639":61178,"_17911":104404,"_5":17806,"_24291":61178,"_2452":104405},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_2926":61202,"_25639":61178,"_17911":104407,"_5":17806,"_24291":104330,"_2452":104408},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_2926":61203,"_25639":61178,"_17911":104410,"_5":17806,"_24291":104330,"_2452":104411},[],"En la práctica, permite:",{"_2926":61204,"_25639":61178,"_17911":104413,"_5":17806,"_24291":104330,"_2452":104414},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_2926":61205,"_25639":61178,"_17911":104416,"_5":17806,"_24291":104330,"_2452":104417},[],"Importar claves creadas externamente.",{"_2926":61206,"_25639":61178,"_17911":104419,"_5":17806,"_24291":104330,"_2452":104420},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_2926":61207,"_25639":61178,"_17911":104422,"_5":17806,"_24291":104330,"_2452":104423},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_2926":61208,"_25639":61178,"_17911":104425,"_5":17806,"_24291":104334,"_2452":104426},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_2926":61209,"_25639":61178,"_17911":104428,"_5":17806,"_24291":104334,"_2452":104429},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_2926":61210,"_25639":61178,"_17911":104431,"_5":17806,"_24291":104334,"_2452":104432},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_2926":61211,"_25639":61178,"_17911":104434,"_5":17806,"_24291":104338,"_2452":104435},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_2926":61212,"_25639":61178,"_17911":104437,"_5":17806,"_24291":104341,"_2452":104438},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_2926":61213,"_25639":61178,"_17911":104440,"_5":17806,"_24291":104344,"_2452":104441},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_2926":61214,"_25639":61178,"_17911":104443,"_5":17806,"_24291":104347,"_2452":104444},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_2926":61215,"_25639":61178,"_17911":104446,"_5":17806,"_24291":104350,"_2452":104447},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_2926":61216,"_25639":61178,"_17911":104449,"_5":17806,"_24291":104353,"_2452":104450},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_2926":61217,"_25639":61178,"_17911":104452,"_5":17806,"_24291":104353,"_2452":104453},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_2926":61218,"_25639":61178,"_17911":104455,"_5":17806,"_24291":104353,"_2452":104456},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_2926":61219,"_25639":61178,"_17911":104458,"_5":17806,"_24291":104353,"_2452":104459},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_2926":61220,"_25639":61178,"_17911":104461,"_5":17806,"_24291":104356,"_2452":104462},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_2926":61221,"_25639":61178,"_17911":104464,"_5":17806,"_24291":104356,"_2452":104465},[],"La tabla incluye los siguientes campos:",{"_2926":61222,"_25639":61178,"_17911":104467,"_5":17806,"_24291":104356,"_2452":104468},[],"**Name**: nombre descriptivo de la clave.",{"_2926":61223,"_25639":61178,"_17911":104470,"_5":17806,"_24291":104356,"_2452":104471},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_2926":61224,"_25639":61178,"_17911":104473,"_5":17806,"_24291":104356,"_2452":104474},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_2926":61225,"_25639":61178,"_17911":104476,"_5":17806,"_24291":104356,"_2452":104477},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_2926":61226,"_25639":61178,"_17911":104479,"_5":17806,"_24291":104356,"_2452":104480},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_2926":61227,"_25639":61178,"_17911":104482,"_5":17806,"_24291":104356,"_2452":104483},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_2926":61228,"_25639":61178,"_17911":104485,"_5":17806,"_24291":104356,"_2452":104486},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_2926":61229,"_25639":61178,"_17911":104488,"_5":17806,"_24291":104356,"_2452":104489},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_2926":61230,"_25639":61178,"_17911":104491,"_5":17806,"_24291":104356,"_2452":104492},[],"Desde esta vista también se accede a las acciones más habituales:",{"_2926":61231,"_25639":61178,"_17911":104494,"_5":17806,"_24291":104356,"_2452":104495},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_2926":61232,"_25639":61178,"_17911":104497,"_5":17806,"_24291":104356,"_2452":104498},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_2926":61233,"_25639":61178,"_17911":104500,"_5":17806,"_24291":104356,"_2452":104501},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_2926":61234,"_25639":61178,"_17911":104503,"_5":17806,"_24291":104356,"_2452":104504},[],"**Delete Key** para eliminar la clave del sistema.",{"_2926":61235,"_25639":61178,"_17911":104506,"_5":17806,"_24291":104360,"_2452":104507},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_2926":61236,"_25639":61178,"_17911":104509,"_5":17806,"_24291":104364,"_2452":104510},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_2926":61237,"_25639":61178,"_17911":104512,"_5":17806,"_24291":104364,"_2452":104513},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_2926":61238,"_25639":61178,"_17911":104515,"_5":17806,"_24291":104364,"_2452":104516},[],"**Key Name**: nombre único y descriptivo.",{"_2926":61239,"_25639":61178,"_17911":104518,"_5":17806,"_24291":104364,"_2452":104519},[],"**Crypto Engine**: motor que custodiará la clave.",{"_2926":61240,"_25639":61178,"_17911":104521,"_5":17806,"_24291":104364,"_2452":104522},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_2926":61241,"_25639":61178,"_17911":104524,"_5":17806,"_24291":104364,"_2452":104525},[],"**Tags**: metadatos para clasificar la clave.",{"_2926":61242,"_25639":61178,"_17911":104527,"_5":17806,"_24291":104364,"_2452":104528},[],"**Metadata**: información adicional para usos avanzados.",{"_2926":61243,"_25639":61178,"_17911":104530,"_5":17806,"_24291":104368,"_2452":104531},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_2926":61244,"_25639":61178,"_17911":104533,"_5":17806,"_24291":104368,"_2452":104534},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_2926":61245,"_25639":61178,"_17911":104536,"_5":17806,"_24291":104368,"_2452":104537},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_2926":61246,"_25639":61178,"_17911":104539,"_5":17806,"_24291":104368,"_2452":104540},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_2926":61247,"_25639":61178,"_17911":104542,"_5":17806,"_24291":104368,"_2452":104543},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_2926":61248,"_25639":61178,"_17911":104545,"_5":17806,"_24291":104368,"_2452":104546},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_2926":61249,"_25639":61178,"_17911":104548,"_5":17806,"_24291":104368,"_2452":104549},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_2926":61250,"_25639":61178,"_17911":104551,"_5":17806,"_24291":104368,"_2452":104552},[],"**Tags**: etiquetas para organización y búsqueda.",{"_2926":61251,"_25639":61178,"_17911":104554,"_5":17806,"_24291":104368,"_2452":104555},[],"**Metadata**: información adicional opcional.",{"_2926":61252,"_25639":61178,"_17911":104557,"_5":17806,"_24291":104368,"_2452":104558},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_2926":61253,"_25639":61178,"_17911":104560,"_5":17806,"_24291":104368,"_2452":104561},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_2926":61254,"_25639":61178,"_17911":104563,"_5":17806,"_24291":104372,"_2452":104564},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_2926":61255,"_25639":61178,"_17911":104566,"_5":17806,"_24291":104376,"_2452":104567},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_2926":61256,"_25639":61178,"_17911":104569,"_5":17806,"_24291":104376,"_2452":104570},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_2926":61257,"_25639":61178,"_17911":104572,"_5":17806,"_24291":104376,"_2452":104573},[],"**Key Name**: nombre descriptivo.",{"_2926":61258,"_25639":61178,"_17911":104575,"_5":17806,"_24291":104376,"_2452":104576},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_2926":61259,"_25639":61178,"_17911":104578,"_5":17806,"_24291":104376,"_2452":104579},[],"**Tags**: etiquetas asociadas.",{"_2926":61260,"_25639":61178,"_17911":104581,"_5":17806,"_24291":104376,"_2452":104582},[],"**Aliases**: nombres alternativos.",{"_2926":61261,"_25639":61178,"_17911":104584,"_5":17806,"_24291":104376,"_2452":104585},[],"**Crypto Engine**: motor en el que reside la clave.",{"_2926":61262,"_25639":61178,"_17911":104587,"_5":17806,"_24291":104376,"_2452":104588},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_2926":61263,"_25639":61178,"_17911":104590,"_5":17806,"_24291":104376,"_2452":104591},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_2926":61264,"_25639":61178,"_17911":104593,"_5":17806,"_24291":104376,"_2452":104594},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_2926":61265,"_25639":61178,"_17911":104596,"_5":17806,"_24291":104380,"_2452":104597},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_2926":61266,"_25639":61178,"_17911":104599,"_5":17806,"_24291":104380,"_2452":104600},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_2926":61267,"_25639":61178,"_17911":104602,"_5":17806,"_24291":104380,"_2452":104603},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_2926":61268,"_25639":61178,"_17911":104605,"_5":17806,"_24291":104384,"_2452":104606},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_2926":61269,"_25639":61178,"_17911":104608,"_5":17806,"_24291":104384,"_2452":104609},[],"Campos principales:",{"_2926":61270,"_25639":61178,"_17911":104611,"_5":17806,"_24291":104384,"_2452":104612},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_2926":61271,"_25639":61178,"_17911":104614,"_5":17806,"_24291":104384,"_2452":104615},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_2926":61272,"_25639":61178,"_17911":104617,"_5":17806,"_24291":104384,"_2452":104618},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_2926":61273,"_25639":61178,"_17911":104620,"_5":17806,"_24291":104384,"_2452":104621},[],"**Message**: contenido que se va a firmar.",{"_2926":61274,"_25639":61178,"_17911":104623,"_5":17806,"_24291":104384,"_2452":104624},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_2926":61275,"_25639":61178,"_17911":104626,"_5":17806,"_24291":104387,"_2452":104627},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_2926":61276,"_25639":61178,"_17911":104629,"_5":17806,"_24291":104387,"_2452":104609},[],{"_2926":61277,"_25639":61178,"_17911":104631,"_5":17806,"_24291":104387,"_2452":104632},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_2926":61278,"_25639":61178,"_17911":104634,"_5":17806,"_24291":104387,"_2452":104635},[],"**Message Type**: `Raw` o `Digest`.",{"_2926":61279,"_25639":61178,"_17911":104637,"_5":17806,"_24291":104387,"_2452":104638},[],"**Payload Encoding**: codificación del mensaje.",{"_2926":61280,"_25639":61178,"_17911":104640,"_5":17806,"_24291":104387,"_2452":104641},[],"**Message**: mensaje original o hash.",{"_2926":61281,"_25639":61178,"_17911":104643,"_5":17806,"_24291":104387,"_2452":104644},[],"**Signature**: firma que se desea comprobar.",{"_2926":61282,"_25639":61178,"_17911":104646,"_5":17806,"_24291":104387,"_2452":104647},[],"**Result**: indicador del resultado de la validación.",{"_2926":61283,"_25639":61178,"_17911":104649,"_5":17806,"_24291":104390,"_2452":104650},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_2926":61284,"_25639":61178,"_17911":104652,"_5":17806,"_24291":104390,"_2452":104653},[],"Este flujo es útil para:",{"_2926":61285,"_25639":61178,"_17911":104655,"_5":17806,"_24291":104390,"_2452":104656},[],"Solicitar certificados a una CA externa.",{"_2926":61286,"_25639":61178,"_17911":104658,"_5":17806,"_24291":104390,"_2452":104659},[],"Renovar una identidad manteniendo la misma clave.",{"_2926":61287,"_25639":61178,"_17911":104661,"_5":17806,"_24291":104390,"_2452":104662},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_2926":61288,"_25639":61178,"_17911":104664,"_5":17806,"_24291":104390,"_2452":104665},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_2926":61289,"_25639":61178,"_17911":104667,"_5":17806,"_24291":104390,"_2452":104668},[],"**Organization (O)**: organización o empresa.",{"_2926":61290,"_25639":61178,"_17911":104670,"_5":17806,"_24291":104390,"_2452":104671},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_2926":61291,"_25639":61178,"_17911":104673,"_5":17806,"_24291":104390,"_2452":104674},[],"**Country (C)**: código de país de dos letras.",{"_2926":61292,"_25639":61178,"_17911":104676,"_5":17806,"_24291":104390,"_2452":104677},[],"**State / Province (ST)**: estado o provincia.",{"_2926":61293,"_25639":61178,"_17911":104679,"_5":17806,"_24291":104390,"_2452":104680},[],"**Locality (L)**: ciudad o localidad.",{"_2926":61294,"_25639":61178,"_17911":104682,"_5":17806,"_24291":104390,"_2452":104683},[],"**Email Address**: correo de contacto.",{"_2926":61295,"_25639":61178,"_17911":104685,"_5":17806,"_24291":104390,"_2452":104686},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_2926":61296,"_25639":61178,"_17911":104688,"_5":17806,"_24291":104390,"_2452":104689},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_2926":61297,"_25639":61178,"_17911":104691,"_5":17806,"_24291":104394,"_2452":104692},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_2926":61298,"_25639":61178,"_17911":104694,"_5":17806,"_24291":104394,"_2452":48480},[],{"_2926":61299,"_25639":61178,"_17911":104696,"_5":17806,"_24291":104398,"_2452":104697},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_2926":61300,"_25639":61300,"_5":12558,"_2452":104699,"_25983":104700,"_17911":104701,"_24291":61300},"Validación online con OCSP",[41760,99445,46797,103648],[],{"_2926":61301,"_25639":61300,"_17911":104703,"_5":17806,"_24291":61300,"_2452":104704},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_2926":61302,"_25639":61300,"_5":25980,"_17911":104706,"_24291":104707,"_2452":104708},[],"/docs/pr-preview/pr-48/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_2926":61303,"_25639":61300,"_5":25980,"_17911":104710,"_24291":104711,"_2452":104712},[],"/docs/pr-preview/pr-48/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_2926":61304,"_25639":61300,"_5":25980,"_17911":104714,"_24291":104715,"_2452":104716},[],"/docs/pr-preview/pr-48/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_2926":61305,"_25639":61300,"_5":25980,"_17911":104718,"_24291":104719,"_2452":104720},[],"/docs/pr-preview/pr-48/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_2926":61306,"_25639":61300,"_5":25980,"_17911":104722,"_24291":104723,"_2452":104724},[],"/docs/pr-preview/pr-48/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_2926":61307,"_25639":61300,"_5":25980,"_17911":104726,"_24291":104727,"_2452":104193},[],"/docs/pr-preview/pr-48/es/platform/pki/ocsp#referencias",{"_2926":61308,"_25639":61300,"_17911":104729,"_5":17806,"_24291":61300,"_2452":104730},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_2926":61309,"_25639":61300,"_17911":104732,"_5":17806,"_24291":104707,"_2452":104733},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_2926":61310,"_25639":61300,"_17911":104735,"_5":17806,"_24291":104707,"_2452":104736},[],"Estado del registro",{"_2926":61311,"_25639":61300,"_17911":104738,"_5":17806,"_24291":104707,"_2452":104739},[],"Respuesta firmada",{"_2926":61312,"_25639":61300,"_17911":104741,"_5":17806,"_24291":104707,"_2452":45975},[],{"_2926":61313,"_25639":61300,"_17911":104743,"_5":17806,"_24291":104707,"_2452":48530},[],{"_2926":61314,"_25639":61300,"_17911":104745,"_5":17806,"_24291":104707,"_2452":45992},[],{"_2926":61315,"_25639":61300,"_17911":104747,"_5":17806,"_24291":104707,"_2452":104748},[],"`Revoked`, con razón y fecha de revocación.",{"_2926":61316,"_25639":61300,"_17911":104750,"_5":17806,"_24291":104707,"_2452":104751},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_2926":61317,"_25639":61300,"_17911":104753,"_5":17806,"_24291":104707,"_2452":104754},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_2926":61318,"_25639":61300,"_17911":104756,"_5":17806,"_24291":104707,"_2452":104757},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_2926":61319,"_25639":61300,"_17911":104759,"_5":17806,"_24291":104707,"_2452":104760},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_2926":61320,"_25639":61300,"_17911":104762,"_5":17806,"_24291":104707,"_2452":104763},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_2926":61321,"_25639":61300,"_17911":104765,"_5":17806,"_24291":104711,"_2452":104766},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_2926":61322,"_25639":61300,"_17911":104768,"_5":17806,"_24291":104711,"_2452":104769},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_2926":61323,"_25639":61300,"_17911":104771,"_5":17806,"_24291":104715,"_2452":104772},[],"El servicio acepta:",{"_2926":61324,"_25639":61300,"_17911":104774,"_5":17806,"_24291":104715,"_2452":101130},[],{"_2926":61325,"_25639":61300,"_17911":104776,"_5":17806,"_24291":104715,"_2452":104777},[],"Ruta del servicio VA",{"_2926":61326,"_25639":61300,"_17911":104779,"_5":17806,"_24291":104715,"_2452":104780},[],"Formato",{"_2926":61327,"_25639":61300,"_17911":104782,"_5":17806,"_24291":104715,"_2452":48570},[],{"_2926":61328,"_25639":61300,"_17911":104784,"_5":17806,"_24291":104715,"_2452":48573},[],{"_2926":61329,"_25639":61300,"_17911":104786,"_5":17806,"_24291":104715,"_2452":104787},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_2926":61330,"_25639":61300,"_17911":104789,"_5":17806,"_24291":104715,"_2452":48059},[],{"_2926":61331,"_25639":61300,"_17911":104791,"_5":17806,"_24291":104715,"_2452":48581},[],{"_2926":61332,"_25639":61300,"_17911":104793,"_5":17806,"_24291":104715,"_2452":104794},[],"Solicitud DER codificada en Base64 URL con padding.",{"_2926":61333,"_25639":61300,"_17911":104796,"_5":17806,"_24291":104715,"_2452":104797},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_2926":61334,"_25639":61300,"_17911":104799,"_5":17806,"_24291":104719,"_2452":104800},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_2926":61335,"_25639":61300,"_17911":104802,"_5":17806,"_24291":104719,"_2452":104803},[],"Genera la solicitud:",{"_2926":61336,"_25639":61300,"_17911":104805,"_5":17806,"_24291":104719,"_2452":104806},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_2926":61337,"_25639":61300,"_17911":104808,"_5":17806,"_24291":104719,"_2452":104809},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_2926":61338,"_25639":61300,"_17911":104811,"_5":17806,"_24291":104719,"_2452":104812},[],"Verifica el DER recibido:",{"_2926":61339,"_25639":61300,"_17911":104814,"_5":17806,"_24291":104719,"_2452":104815},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_2926":61340,"_25639":61300,"_17911":104817,"_5":17806,"_24291":104723,"_2452":104818},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_2926":61341,"_25639":61300,"_17911":104820,"_5":17806,"_24291":104723,"_2452":104821},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_2926":61342,"_25639":61300,"_17911":104823,"_5":17806,"_24291":104727,"_2452":48614},[],{"_2926":61343,"_25639":61300,"_17911":104825,"_5":17806,"_24291":104727,"_2452":48617},[],{"_2926":61344,"_25639":61300,"_17911":104827,"_5":17806,"_24291":104727,"_2452":104828},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_2926":61345,"_25639":61300,"_17911":104830,"_5":17806,"_24291":104727,"_2452":104320},[],{"_2926":61346,"_25639":61346,"_5":12558,"_2452":46797,"_25983":104832,"_17911":104833,"_24291":61346},[41760,99445,46797],[],{"_2926":61347,"_25639":61346,"_17911":104835,"_5":17806,"_24291":61346,"_2452":104836},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_2926":61348,"_25639":61346,"_5":25980,"_17911":104838,"_24291":104839,"_2452":102357},[],"/docs/pr-preview/pr-48/es/platform/pki/overview#empieza-aquí",{"_2926":61349,"_25639":61346,"_5":25980,"_17911":104841,"_24291":104842,"_2452":104843},[],"/docs/pr-preview/pr-48/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_2926":61350,"_25639":61346,"_5":25980,"_17911":104845,"_24291":104846,"_2452":102879},[],"/docs/pr-preview/pr-48/es/platform/pki/overview#capacidades-principales",{"_2926":61351,"_25639":61346,"_5":25980,"_17911":104848,"_24291":104849,"_2452":102883},[],"/docs/pr-preview/pr-48/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_2926":61352,"_25639":61346,"_5":25980,"_17911":104851,"_24291":104852,"_2452":102887},[],"/docs/pr-preview/pr-48/es/platform/pki/overview#protege-las-claves-criptográficas",{"_2926":61353,"_25639":61346,"_5":25980,"_17911":104854,"_24291":104855,"_2452":102891},[],"/docs/pr-preview/pr-48/es/platform/pki/overview#emite-y-controla-certificados",{"_2926":61354,"_25639":61346,"_5":25980,"_17911":104857,"_24291":104858,"_2452":102899},[],"/docs/pr-preview/pr-48/es/platform/pki/overview#publica-el-estado-de-validación",{"_2926":61355,"_25639":61346,"_5":25980,"_17911":104860,"_24291":104861,"_2452":104862},[],"/docs/pr-preview/pr-48/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_2926":61356,"_25639":61346,"_5":25980,"_17911":104864,"_24291":104865,"_2452":103814},[],"/docs/pr-preview/pr-48/es/platform/pki/overview#continúa",{"_2926":61357,"_25639":61346,"_17911":104867,"_5":17806,"_24291":61346,"_2452":104868},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_2926":61358,"_25639":61346,"_17911":104870,"_5":17806,"_24291":104839,"_2452":104871},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_2926":61359,"_25639":61346,"_17911":104873,"_5":17806,"_24291":104839,"_2452":104874},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_2926":61360,"_25639":61346,"_17911":104876,"_5":17806,"_24291":104842,"_2452":104877},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_2926":61361,"_25639":61346,"_17911":104879,"_5":17806,"_24291":104842,"_2452":104880},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_2926":61362,"_25639":61346,"_17911":104882,"_5":17806,"_24291":104842,"_2452":104883},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_2926":61363,"_25639":61346,"_17911":104885,"_5":17806,"_24291":104842,"_2452":104886},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_2926":61364,"_25639":61346,"_17911":104888,"_5":17806,"_24291":104842,"_2452":104889},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_2926":61365,"_25639":61346,"_17911":104891,"_5":17806,"_24291":104849,"_2452":104892},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_2926":61366,"_25639":61346,"_17911":104894,"_5":17806,"_24291":104852,"_2452":104895},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_2926":61367,"_25639":61346,"_17911":104897,"_5":17806,"_24291":104855,"_2452":104898},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_2926":61368,"_25639":61346,"_17911":104900,"_5":17806,"_24291":104858,"_2452":104901},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_2926":61369,"_25639":61346,"_17911":104903,"_5":17806,"_24291":104861,"_2452":104904},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_2926":61370,"_25639":61346,"_17911":104906,"_5":17806,"_24291":104861,"_2452":104907},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_2926":61371,"_25639":61346,"_17911":104909,"_5":17806,"_24291":104861,"_2452":104910},[],"su clave pública corresponda a la clave privada del cliente;",{"_2926":61372,"_25639":61346,"_17911":104912,"_5":17806,"_24291":104861,"_2452":104913},[],"su cadena alcance una raíz confiable para el consumidor;",{"_2926":61373,"_25639":61346,"_17911":104915,"_5":17806,"_24291":104861,"_2452":104916},[],"sus fechas y usos permitan la operación;",{"_2926":61374,"_25639":61346,"_17911":104918,"_5":17806,"_24291":104861,"_2452":104919},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_2926":61375,"_25639":61346,"_17911":104921,"_5":17806,"_24291":104861,"_2452":104922},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_2926":61376,"_25639":61346,"_17911":104924,"_5":17806,"_24291":104865,"_2452":104925},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2926":61377,"_25639":61346,"_17911":104927,"_5":17806,"_24291":104865,"_2452":104928},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2926":61378,"_25639":61346,"_17911":104930,"_5":17806,"_24291":104865,"_2452":104931},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2926":61379,"_25639":61379,"_5":12558,"_2452":104933,"_25983":104934,"_17911":104935,"_24291":61379},"Crea tu primera CA",[41760,99445,46797,102481],[],{"_2926":61380,"_25639":61379,"_17911":104937,"_5":17806,"_24291":61379,"_2452":104938},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_2926":61381,"_25639":61379,"_5":25980,"_17911":104940,"_24291":104941,"_2452":98146},[],"/docs/pr-preview/pr-48/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_2926":61382,"_25639":61379,"_5":25980,"_17911":104943,"_24291":104944,"_2452":104945},[],"/docs/pr-preview/pr-48/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_2926":61383,"_25639":61379,"_5":25980,"_17911":104947,"_24291":104948,"_2452":104949},[],"/docs/pr-preview/pr-48/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_2926":61384,"_25639":61379,"_5":25980,"_17911":104951,"_24291":104952,"_2452":104953},[],"/docs/pr-preview/pr-48/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_2926":61385,"_25639":61379,"_5":25980,"_17911":104955,"_24291":104956,"_2452":104957},[],"/docs/pr-preview/pr-48/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_2926":61386,"_25639":61379,"_5":25980,"_17911":104959,"_24291":104960,"_2452":104961},[],"/docs/pr-preview/pr-48/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_2926":61387,"_25639":61379,"_5":25980,"_17911":104963,"_24291":104964,"_2452":104965},[],"/docs/pr-preview/pr-48/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_2926":61388,"_25639":61379,"_5":25980,"_17911":104967,"_24291":104968,"_2452":102729},[],"/docs/pr-preview/pr-48/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_2926":61389,"_25639":61379,"_5":25980,"_17911":104970,"_24291":104971,"_2452":98170},[],"/docs/pr-preview/pr-48/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_2926":61390,"_25639":61379,"_17911":104973,"_5":17806,"_24291":61379,"_2452":104974},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_2926":61391,"_25639":61379,"_17911":104976,"_5":17806,"_24291":104941,"_2452":104977},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_2926":61392,"_25639":61379,"_17911":104979,"_5":17806,"_24291":104941,"_2452":104980},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_2926":61393,"_25639":61379,"_17911":104982,"_5":17806,"_24291":104941,"_2452":104983},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_2926":61394,"_25639":61379,"_17911":104985,"_5":17806,"_24291":104941,"_2452":104986},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_2926":61395,"_25639":61379,"_17911":104988,"_5":17806,"_24291":104944,"_2452":104989},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_2926":61396,"_25639":61379,"_17911":104991,"_5":17806,"_24291":104944,"_2452":104992},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_2926":61397,"_25639":61379,"_17911":104994,"_5":17806,"_24291":104948,"_2452":104995},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_2926":61398,"_25639":61379,"_17911":104997,"_5":17806,"_24291":104948,"_2452":104998},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_2926":61399,"_25639":61379,"_17911":105000,"_5":17806,"_24291":104952,"_2452":105001},[],"Selecciona **Root CA** y completa:",{"_2926":61400,"_25639":61379,"_17911":105003,"_5":17806,"_24291":104952,"_2452":48796},[],{"_2926":61401,"_25639":61379,"_17911":105005,"_5":17806,"_24291":104952,"_2452":105006},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_2926":61402,"_25639":61379,"_17911":105008,"_5":17806,"_24291":104952,"_2452":105009},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_2926":61403,"_25639":61379,"_17911":105011,"_5":17806,"_24291":104952,"_2452":105012},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_2926":61404,"_25639":61379,"_17911":105014,"_5":17806,"_24291":104952,"_2452":105015},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_2926":61405,"_25639":61379,"_17911":105017,"_5":17806,"_24291":104956,"_2452":105018},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_2926":61406,"_25639":61379,"_17911":105020,"_5":17806,"_24291":104960,"_2452":105021},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_2926":61407,"_25639":61379,"_17911":105023,"_5":17806,"_24291":104960,"_2452":105024},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_2926":61408,"_25639":61379,"_17911":105026,"_5":17806,"_24291":104964,"_2452":105027},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_2926":61409,"_25639":61379,"_17911":105029,"_5":17806,"_24291":104964,"_2452":105030},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_2926":61410,"_25639":61379,"_17911":105032,"_5":17806,"_24291":104964,"_2452":105033},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_2926":61411,"_25639":61379,"_17911":105035,"_5":17806,"_24291":104968,"_2452":105036},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_2926":61412,"_25639":61379,"_17911":105038,"_5":17806,"_24291":104968,"_2452":105039},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_2926":61413,"_25639":61379,"_17911":105041,"_5":17806,"_24291":104968,"_2452":105042},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_2926":61414,"_25639":61379,"_17911":105044,"_5":17806,"_24291":104968,"_2452":105045},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_2926":61415,"_25639":61379,"_17911":105047,"_5":17806,"_24291":104971,"_2452":105048},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_2926":61416,"_25639":61416,"_5":12558,"_2452":105050,"_25983":105051,"_17911":105052,"_24291":61416},"Emite y verifica un certificado",[41760,99445,46797,102481],[],{"_2926":61417,"_25639":61416,"_17911":105054,"_5":17806,"_24291":61416,"_2452":105055},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_2926":61418,"_25639":61416,"_5":25980,"_17911":105057,"_24291":105058,"_2452":98146},[],"/docs/pr-preview/pr-48/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_2926":61419,"_25639":61416,"_5":25980,"_17911":105060,"_24291":105061,"_2452":105062},[],"/docs/pr-preview/pr-48/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_2926":61420,"_25639":61416,"_5":25980,"_17911":105064,"_24291":105065,"_2452":105066},[],"/docs/pr-preview/pr-48/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_2926":61421,"_25639":61416,"_5":25980,"_17911":105068,"_24291":105069,"_2452":105070},[],"/docs/pr-preview/pr-48/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_2926":61422,"_25639":61416,"_5":25980,"_17911":105072,"_24291":105073,"_2452":105074},[],"/docs/pr-preview/pr-48/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_2926":61423,"_25639":61416,"_5":25980,"_17911":105076,"_24291":105077,"_2452":105078},[],"/docs/pr-preview/pr-48/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_2926":61424,"_25639":61416,"_5":25980,"_17911":105080,"_24291":105081,"_2452":104961},[],"/docs/pr-preview/pr-48/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_2926":61425,"_25639":61416,"_5":25980,"_17911":105083,"_24291":105084,"_2452":105085},[],"/docs/pr-preview/pr-48/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_2926":61426,"_25639":61416,"_5":25980,"_17911":105087,"_24291":105088,"_2452":105089},[],"/docs/pr-preview/pr-48/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_2926":61427,"_25639":61416,"_5":25980,"_17911":105091,"_24291":105092,"_2452":105093},[],"/docs/pr-preview/pr-48/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_2926":61428,"_25639":61416,"_5":25980,"_17911":105095,"_24291":105096,"_2452":102729},[],"/docs/pr-preview/pr-48/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_2926":61429,"_25639":61416,"_5":25980,"_17911":105098,"_24291":105099,"_2452":98170},[],"/docs/pr-preview/pr-48/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_2926":61430,"_25639":61416,"_17911":105101,"_5":17806,"_24291":61416,"_2452":105102},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_2926":61431,"_25639":61416,"_17911":105104,"_5":17806,"_24291":105058,"_2452":105105},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_2926":61432,"_25639":61416,"_17911":105107,"_5":17806,"_24291":105058,"_2452":105108},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_2926":61433,"_25639":61416,"_17911":105110,"_5":17806,"_24291":105058,"_2452":105111},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_2926":61434,"_25639":61416,"_17911":105113,"_5":17806,"_24291":105058,"_2452":105114},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_2926":61435,"_25639":61416,"_17911":105116,"_5":17806,"_24291":105058,"_2452":105117},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_2926":61436,"_25639":61416,"_17911":105119,"_5":17806,"_24291":105061,"_2452":105120},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_2926":61437,"_25639":61416,"_17911":105122,"_5":17806,"_24291":105065,"_2452":105123},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_2926":61438,"_25639":61416,"_17911":105125,"_5":17806,"_24291":105065,"_2452":105126},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_2926":61439,"_25639":61416,"_17911":105128,"_5":17806,"_24291":105069,"_2452":105129},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_2926":61440,"_25639":61416,"_17911":105131,"_5":17806,"_24291":105069,"_2452":105132},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_2926":61441,"_25639":61416,"_17911":105134,"_5":17806,"_24291":105073,"_2452":105135},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_2926":61442,"_25639":61416,"_17911":105137,"_5":17806,"_24291":105073,"_2452":105138},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_2926":61443,"_25639":61416,"_17911":105140,"_5":17806,"_24291":105077,"_2452":105141},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_2926":61444,"_25639":61416,"_17911":105143,"_5":17806,"_24291":105081,"_2452":105144},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_2926":61445,"_25639":61416,"_17911":105146,"_5":17806,"_24291":105084,"_2452":105147},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_2926":61446,"_25639":61416,"_17911":105149,"_5":17806,"_24291":105088,"_2452":105150},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_2926":61447,"_25639":61416,"_17911":105152,"_5":17806,"_24291":105088,"_2452":105153},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_2926":61448,"_25639":61416,"_17911":105155,"_5":17806,"_24291":105088,"_2452":105156},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_2926":61449,"_25639":61416,"_17911":105158,"_5":17806,"_24291":105092,"_2452":105159},[],"En Bash, compara los dos resúmenes de clave pública:",{"_2926":61450,"_25639":61416,"_17911":105161,"_5":17806,"_24291":105092,"_2452":105162},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_2926":61451,"_25639":61416,"_17911":105164,"_5":17806,"_24291":105092,"_2452":105165},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_2926":61452,"_25639":61416,"_17911":105167,"_5":17806,"_24291":105096,"_2452":102812},[],{"_2926":61453,"_25639":61416,"_17911":105169,"_5":17806,"_24291":105096,"_2452":101579},[],{"_2926":61454,"_25639":61416,"_17911":105171,"_5":17806,"_24291":105096,"_2452":105172},[],"La CA rechaza la emisión",{"_2926":61455,"_25639":61416,"_17911":105174,"_5":17806,"_24291":105096,"_2452":105175},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_2926":61456,"_25639":61416,"_17911":105177,"_5":17806,"_24291":105096,"_2452":105178},[],"Sujeto o usos diferentes",{"_2926":61457,"_25639":61416,"_17911":105180,"_5":17806,"_24291":105096,"_2452":105181},[],"Perfil aplicado y valores solicitados.",{"_2926":61458,"_25639":61416,"_17911":105183,"_5":17806,"_24291":105096,"_2452":105184},[],"No se encuentra el emisor",{"_2926":61459,"_25639":61416,"_17911":105186,"_5":17806,"_24291":105096,"_2452":105187},[],"CA descargada y cadena intermedia necesaria.",{"_2926":61460,"_25639":61416,"_17911":105189,"_5":17806,"_24291":105096,"_2452":105190},[],"Falla la vigencia",{"_2926":61461,"_25639":61416,"_17911":105192,"_5":17806,"_24291":105096,"_2452":105193},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_2926":61462,"_25639":61416,"_17911":105195,"_5":17806,"_24291":105096,"_2452":105196},[],"Los resúmenes de clave difieren",{"_2926":61463,"_25639":61416,"_17911":105198,"_5":17806,"_24291":105096,"_2452":105199},[],"Archivos de certificado y clave de la misma emisión.",{"_2926":61464,"_25639":61416,"_17911":105201,"_5":17806,"_24291":105096,"_2452":105202},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_2926":61465,"_25639":61416,"_17911":105204,"_5":17806,"_24291":105099,"_2452":105205},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_2926":61466,"_25639":61416,"_17911":105207,"_5":17806,"_24291":105099,"_2452":105208},[],"Gestionar certificados para inspección, estado y revocación.",{"_2926":61467,"_25639":61416,"_17911":105210,"_5":17806,"_24291":105099,"_2452":105211},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_2926":61468,"_25639":61416,"_17911":105213,"_5":17806,"_24291":105099,"_2452":105214},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_2926":61469,"_25639":61416,"_17911":105216,"_5":17806,"_24291":105099,"_2452":105217},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_2926":61470,"_25639":61470,"_5":12558,"_2452":105219,"_25983":105220,"_17911":105221,"_24291":61470},"Primeros pasos de PKI",[41760,99445,46797,102481],[],{"_2926":61471,"_25639":61470,"_17911":105223,"_5":17806,"_24291":61470,"_2452":105224},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_2926":61472,"_25639":61470,"_5":25980,"_17911":105226,"_24291":105227,"_2452":98146},[],"/docs/pr-preview/pr-48/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_2926":61473,"_25639":61470,"_5":25980,"_17911":105229,"_24291":105230,"_2452":105231},[],"/docs/pr-preview/pr-48/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_2926":61474,"_25639":61470,"_5":25980,"_17911":105233,"_24291":105234,"_2452":102663},[],"/docs/pr-preview/pr-48/es/platform/pki/quickstarts/overview#resultado-esperado",{"_2926":61475,"_25639":61470,"_5":25980,"_17911":105236,"_24291":105237,"_2452":105238},[],"/docs/pr-preview/pr-48/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_2926":61476,"_25639":61470,"_17911":105240,"_5":17806,"_24291":61470,"_2452":105241},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_2926":61477,"_25639":61470,"_17911":105243,"_5":17806,"_24291":105227,"_2452":105244},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_2926":61478,"_25639":61470,"_17911":105246,"_5":17806,"_24291":105227,"_2452":105247},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_2926":61479,"_25639":61470,"_17911":105249,"_5":17806,"_24291":105227,"_2452":105250},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_2926":61480,"_25639":61470,"_17911":105252,"_5":17806,"_24291":105227,"_2452":105253},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_2926":61481,"_25639":61470,"_17911":105255,"_5":17806,"_24291":105227,"_2452":105256},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_2926":61482,"_25639":61470,"_17911":105258,"_5":17806,"_24291":105230,"_2452":105259},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2926":61483,"_25639":61470,"_17911":105261,"_5":17806,"_24291":105230,"_2452":105262},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2926":61484,"_25639":61470,"_17911":105264,"_5":17806,"_24291":105230,"_2452":105265},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_2926":61485,"_25639":61470,"_17911":105267,"_5":17806,"_24291":105230,"_2452":105268},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_2926":61486,"_25639":61470,"_17911":105270,"_5":17806,"_24291":105234,"_2452":105271},[],"Archivo o recurso",{"_2926":61487,"_25639":61470,"_17911":105273,"_5":17806,"_24291":105234,"_2452":102660},[],{"_2926":61488,"_25639":61470,"_17911":105275,"_5":17806,"_24291":105234,"_2452":105276},[],"CA raíz activa y `ca.pem`",{"_2926":61489,"_25639":61470,"_17911":105278,"_5":17806,"_24291":105234,"_2452":105279},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_2926":61490,"_25639":61470,"_17911":105281,"_5":17806,"_24291":105234,"_2452":105282},[],"Certificado final y `device.crt`",{"_2926":61491,"_25639":61470,"_17911":105284,"_5":17806,"_24291":105234,"_2452":105285},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_2926":61492,"_25639":61470,"_17911":105287,"_5":17806,"_24291":105234,"_2452":105288},[],"Clave privada `device.key`",{"_2926":61493,"_25639":61470,"_17911":105290,"_5":17806,"_24291":105234,"_2452":105291},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_2926":61494,"_25639":61470,"_17911":105293,"_5":17806,"_24291":105234,"_2452":105294},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_2926":61495,"_25639":61470,"_17911":105296,"_5":17806,"_24291":105237,"_2452":105297},[],"Para operar certificados, continúa con Certificados y Validación.",{"_2926":61496,"_25639":61470,"_17911":105299,"_5":17806,"_24291":105237,"_2452":105300},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_2926":61497,"_25639":61470,"_17911":105302,"_5":17806,"_24291":105237,"_2452":105303},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_2926":61498,"_25639":61498,"_5":12558,"_2452":105305,"_25983":105306,"_17911":105308,"_24291":61498},"Resolución de problemas PKI",[41760,99445,46797,105307],"Resolución de problemas",[],{"_2926":61499,"_25639":61498,"_17911":105310,"_5":17806,"_24291":61498,"_2452":105311},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_2926":61500,"_25639":61498,"_5":25980,"_17911":105313,"_24291":105314,"_2452":105315},[],"/docs/pr-preview/pr-48/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_2926":61501,"_25639":61498,"_5":25980,"_17911":105317,"_24291":105318,"_2452":105319},[],"/docs/pr-preview/pr-48/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_2926":61502,"_25639":61498,"_5":25980,"_17911":105321,"_24291":105322,"_2452":105323},[],"/docs/pr-preview/pr-48/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_2926":61503,"_25639":61498,"_17911":105325,"_5":17806,"_24291":61498,"_2452":105326},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_2926":61504,"_25639":61498,"_17911":105328,"_5":17806,"_24291":61498,"_2452":105329},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_2926":61505,"_25639":61498,"_17911":105331,"_5":17806,"_24291":105314,"_2452":102660},[],{"_2926":61506,"_25639":61498,"_17911":105333,"_5":17806,"_24291":105314,"_2452":101579},[],{"_2926":61507,"_25639":61498,"_17911":105335,"_5":17806,"_24291":105314,"_2452":98170},[],{"_2926":61508,"_25639":61498,"_17911":105337,"_5":17806,"_24291":105314,"_2452":49132},[],{"_2926":61509,"_25639":61498,"_17911":105339,"_5":17806,"_24291":105314,"_2452":105340},[],"Existe, está activa y sus fechas son utilizables.",{"_2926":61510,"_25639":61498,"_17911":105342,"_5":17806,"_24291":105314,"_2452":105343},[],"Autoridades.",{"_2926":61511,"_25639":61498,"_17911":105345,"_5":17806,"_24291":105314,"_2452":105346},[],"Clave",{"_2926":61512,"_25639":61498,"_17911":105348,"_5":17806,"_24291":105314,"_2452":105349},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_2926":61513,"_25639":61498,"_17911":105351,"_5":17806,"_24291":105314,"_2452":105352},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_2926":61514,"_25639":61498,"_17911":105354,"_5":17806,"_24291":105314,"_2452":49150},[],{"_2926":61515,"_25639":61498,"_17911":105356,"_5":17806,"_24291":105314,"_2452":105357},[],"PEM correcto y firma verificable.",{"_2926":61516,"_25639":61498,"_17911":105359,"_5":17806,"_24291":105314,"_2452":49156},[],{"_2926":61517,"_25639":61498,"_17911":105361,"_5":17806,"_24291":105314,"_2452":105362},[],"Perfil",{"_2926":61518,"_25639":61498,"_17911":105364,"_5":17806,"_24291":105314,"_2452":105365},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_2926":61519,"_25639":61498,"_17911":105367,"_5":17806,"_24291":105314,"_2452":105368},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_2926":61520,"_25639":61498,"_17911":105370,"_5":17806,"_24291":105314,"_2452":102812},[],{"_2926":61521,"_25639":61498,"_17911":105372,"_5":17806,"_24291":105314,"_2452":105373},[],"Sujeto, SAN, usos y fechas adecuados.",{"_2926":61522,"_25639":61498,"_17911":105375,"_5":17806,"_24291":105314,"_2452":105376},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_2926":61523,"_25639":61498,"_17911":105378,"_5":17806,"_24291":105314,"_2452":105379},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_2926":61524,"_25639":61498,"_17911":105381,"_5":17806,"_24291":105314,"_2452":105382},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_2926":61525,"_25639":61498,"_17911":105384,"_5":17806,"_24291":105318,"_2452":105385},[],"Revisa cada frontera por separado:",{"_2926":61526,"_25639":61498,"_17911":105387,"_5":17806,"_24291":105318,"_2452":105388},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_2926":61527,"_25639":61498,"_17911":105390,"_5":17806,"_24291":105318,"_2452":105391},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_2926":61528,"_25639":61498,"_17911":105393,"_5":17806,"_24291":105318,"_2452":105394},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_2926":61529,"_25639":61498,"_17911":105396,"_5":17806,"_24291":105318,"_2452":105397},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_2926":61530,"_25639":61498,"_17911":105399,"_5":17806,"_24291":105318,"_2452":105400},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_2926":61531,"_25639":61498,"_17911":105402,"_5":17806,"_24291":105318,"_2452":105403},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_2926":61532,"_25639":61498,"_17911":105405,"_5":17806,"_24291":105322,"_2452":105406},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_2926":61533,"_25639":61498,"_17911":105408,"_5":17806,"_24291":105322,"_2452":105409},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_2926":61534,"_25639":61534,"_5":12558,"_2452":105411,"_25983":105412,"_17911":105414,"_24291":61534},"3.8.0 a 4.0.0",[41760,105413],"Actualizaciones",[],{"_2926":61535,"_25639":61534,"_17911":105416,"_5":17806,"_24291":61534,"_2452":105417},[],"Cambios de 4.0.0 que afectan a la configuración de los DMS, qué puede fallar tras actualizar desde 3.8.0 y cómo comprobarlo.",{"_2926":61536,"_25639":61534,"_5":25980,"_17911":105419,"_24291":105420,"_2452":105421},[],"/docs/pr-preview/pr-48/es/upgrades/3-8-0-to-4-0-0#resumen","Resumen",{"_2926":61537,"_25639":61534,"_5":25980,"_17911":105423,"_24291":105424,"_2452":105425},[],"/docs/pr-preview/pr-48/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_2926":61538,"_25639":61534,"_5":25980,"_17911":105427,"_24291":105428,"_2452":105429},[],"/docs/pr-preview/pr-48/es/upgrades/3-8-0-to-4-0-0#webhooks-con-referencias-a-archivos","Webhooks con referencias a archivos",{"_2926":61539,"_25639":61534,"_5":25980,"_17911":105431,"_24291":105432,"_2452":105433},[],"/docs/pr-preview/pr-48/es/upgrades/3-8-0-to-4-0-0#verificación-del-certificado-del-receptor","Verificación del certificado del receptor",{"_2926":61540,"_25639":61534,"_5":25980,"_17911":105435,"_24291":105436,"_2452":105437},[],"/docs/pr-preview/pr-48/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_2926":61541,"_25639":61534,"_5":25980,"_17911":105439,"_24291":105440,"_2452":105441},[],"/docs/pr-preview/pr-48/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_2926":61542,"_25639":61534,"_5":25980,"_17911":105443,"_24291":105444,"_2452":105445},[],"/docs/pr-preview/pr-48/es/upgrades/3-8-0-to-4-0-0#lista-de-verificación","Lista de verificación",{"_2926":61543,"_25639":61534,"_17911":105447,"_5":17806,"_24291":61534,"_2452":105448},[],"La actualización de 3.8.0 a 4.0.0 migra automáticamente la configuración almacenada de los DMS. Casi todo se convierte sin intervención, pero hay tres cambios que pueden dejar enrolamientos fallando o configuraciones con valores inesperados si no se revisan. Esta página indica qué cambia, qué síntomas produce y qué hacer en cada caso. El comportamiento vigente de cada funcionalidad está en las páginas de DMS.",{"_2926":61544,"_25639":61534,"_17911":105450,"_5":17806,"_24291":105420,"_2452":105451},[],"Cambio",{"_2926":61545,"_25639":61534,"_17911":105453,"_5":17806,"_24291":105420,"_2452":105454},[],"Quién se ve afectado",{"_2926":61546,"_25639":61534,"_17911":105456,"_5":17806,"_24291":105420,"_2452":105457},[],"Gravedad",{"_2926":61547,"_25639":61534,"_17911":105459,"_5":17806,"_24291":105420,"_2452":105460},[],"Acción",{"_2926":61548,"_25639":61534,"_17911":105462,"_5":17806,"_24291":105420,"_2452":105429},[],{"_2926":61549,"_25639":61534,"_17911":105464,"_5":17806,"_24291":105420,"_2452":105465},[],"DMS con webhook cuyo certificado o clave de mTLS eran rutas de archivo",{"_2926":61550,"_25639":61534,"_17911":105467,"_5":17806,"_24291":105420,"_2452":105468},[],"Alta: los enrolamientos y reenrolamientos que llaman al webhook fallan",{"_2926":61551,"_25639":61534,"_17911":105470,"_5":17806,"_24291":105420,"_2452":105471},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_2926":61552,"_25639":61534,"_17911":105473,"_5":17806,"_24291":105420,"_2452":105433},[],{"_2926":61553,"_25639":61534,"_17911":105475,"_5":17806,"_24291":105420,"_2452":105476},[],"DMS con webhook que tenían `validate_server_cert: false`",{"_2926":61554,"_25639":61534,"_17911":105478,"_5":17806,"_24291":105420,"_2452":105479},[],"Media: las credenciales del webhook viajan sin verificar al receptor",{"_2926":61555,"_25639":61534,"_17911":105481,"_5":17806,"_24291":105420,"_2452":105482},[],"Poner `insecure_skip_verify` a `false`",{"_2926":61556,"_25639":61534,"_17911":105484,"_5":17806,"_24291":105420,"_2452":105437},[],{"_2926":61557,"_25639":61534,"_17911":105486,"_5":17806,"_24291":105420,"_2452":105487},[],"Scripts y consolas que editan DMS por API",{"_2926":61558,"_25639":61534,"_17911":105489,"_5":17806,"_24291":105420,"_2452":105490},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_2926":61559,"_25639":61534,"_17911":105492,"_5":17806,"_24291":105420,"_2452":105493},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_2926":61560,"_25639":61534,"_17911":105495,"_5":17806,"_24291":105420,"_2452":105441},[],{"_2926":61561,"_25639":61534,"_17911":105497,"_5":17806,"_24291":105420,"_2452":105498},[],"Cualquier DMS",{"_2926":61562,"_25639":61534,"_17911":105500,"_5":17806,"_24291":105420,"_2452":105501},[],"Baja: solo informativo",{"_2926":61563,"_25639":61534,"_17911":105503,"_5":17806,"_24291":105420,"_2452":105504},[],"Revisar ambos bloques antes de editar",{"_2926":61564,"_25639":61534,"_17911":105506,"_5":17806,"_24291":105420,"_2452":105507},[],"Al final se incluye una lista de verificación para confirmar el resultado.",{"_2926":61565,"_25639":61534,"_17911":105509,"_5":17806,"_24291":105424,"_2452":105510},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual. Los campos se renombran de la siguiente manera:",{"_2926":61566,"_25639":61534,"_17911":105512,"_5":17806,"_24291":105424,"_2452":105513},[],"Campo en 3.8.0",{"_2926":61567,"_25639":61534,"_17911":105515,"_5":17806,"_24291":105424,"_2452":105516},[],"Campo en 4.0.0",{"_2926":61568,"_25639":61534,"_17911":105518,"_5":17806,"_24291":105424,"_2452":49316},[],{"_2926":61569,"_25639":61534,"_17911":105520,"_5":17806,"_24291":105424,"_2452":105521},[],"`insecure_skip_verify` (con el valor negado)",{"_2926":61570,"_25639":61534,"_17911":105523,"_5":17806,"_24291":105424,"_2452":49322},[],{"_2926":61571,"_25639":61534,"_17911":105525,"_5":17806,"_24291":105424,"_2452":49325},[],{"_2926":61572,"_25639":61534,"_17911":105527,"_5":17806,"_24291":105424,"_2452":49328},[],{"_2926":61573,"_25639":61534,"_17911":105529,"_5":17806,"_24291":105424,"_2452":49331},[],{"_2926":61574,"_25639":61534,"_17911":105531,"_5":17806,"_24291":105424,"_2452":49334},[],{"_2926":61575,"_25639":61534,"_17911":105533,"_5":17806,"_24291":105424,"_2452":49337},[],{"_2926":61576,"_25639":61534,"_17911":105535,"_5":17806,"_24291":105424,"_2452":105536},[],"Cuando el certificado y la clave heredados de mTLS son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren ninguna acción. Los dos casos siguientes son los que sí la requieren.",{"_2926":61577,"_25639":61534,"_17911":105538,"_5":17806,"_24291":105428,"_2452":105539},[],"Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos, y lo hace en cada llamada, sea cual sea el modo de autenticación configurado. El efecto es que todos los enrolamientos y reenrolamientos que invocan ese webhook fallan hasta corregir la configuración.",{"_2926":61578,"_25639":61534,"_17911":105541,"_5":17806,"_24291":105428,"_2452":105542},[],"Para corregirlo hay dos opciones, según el webhook:",{"_2926":61579,"_25639":61534,"_17911":105544,"_5":17806,"_24291":105428,"_2452":105545},[],"Si el webhook usa mTLS, volver a introducir el certificado y la clave como PEM, en Base64 o en texto plano.",{"_2926":61580,"_25639":61534,"_17911":105547,"_5":17806,"_24291":105428,"_2452":105548},[],"Si el webhook no usa mTLS, eliminar los campos de archivo sobrantes.",{"_2926":61581,"_25639":61534,"_17911":105550,"_5":17806,"_24291":105428,"_2452":105551},[],"Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`).",{"_2926":61582,"_25639":61534,"_17911":105553,"_5":17806,"_24291":105428,"_2452":105554},[],"Existe una variante del mismo problema: si la configuración almacenada guarda rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content`, toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`) falla la validación. Los ajustes se sustituyen al completo, de modo que la configuración almacenada debe reenviarse con el certificado y la clave como PEM.",{"_2926":61583,"_25639":61534,"_17911":105556,"_5":17806,"_24291":105432,"_2452":105557},[],"Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`. Por tanto, la verificación del certificado del receptor sigue sin realizarse hasta que se ponga ese campo a `false`.",{"_2926":61584,"_25639":61534,"_17911":105559,"_5":17806,"_24291":105432,"_2452":105560},[],"Conviene corregirlo en cada configuración migrada. El canal de autorización del webhook transporta la API key o el bearer token, de modo que saltarse la verificación expone esas credenciales a un atacante con posición de red. Solo se justifica mantener `insecure_skip_verify: true` si el certificado del receptor no es verificable de forma deliberada.",{"_2926":61585,"_25639":61534,"_17911":105562,"_5":17806,"_24291":105436,"_2452":105563},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`.",{"_2926":61586,"_25639":61534,"_17911":105565,"_5":17806,"_24291":105436,"_2452":105566},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_2926":61587,"_25639":61534,"_17911":105568,"_5":17806,"_24291":105436,"_2452":105569},[],"Lo que sí cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se ignora en silencio porque los campos JSON desconocidos se descartan, y las respuestas GET ya no lo incluyen. En consecuencia, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin devolver ningún error. Para evitarlo, leer siempre el DMS antes de enviar una edición y reutilizar el formato que devuelve la API.",{"_2926":61588,"_25639":61534,"_17911":105571,"_5":17806,"_24291":105440,"_2452":105572},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero antes de editar un DMS conviene leer ambos bloques para no modificar uno creyendo que se está editando el otro.",{"_2926":61589,"_25639":61534,"_17911":105574,"_5":17806,"_24291":105440,"_2452":105575},[],"Si la versión de la consola no expone los ajustes independientes, pueden editarse mediante la API DMS.",{"_2926":61590,"_25639":61534,"_17911":105577,"_5":17806,"_24291":105444,"_2452":105578},[],"Tras aplicar la actualización, comprobar en este orden:",{"_2926":61591,"_25639":61534,"_17911":105580,"_5":17806,"_24291":105444,"_2452":105581},[],"**Webhooks sin campos de archivo.** Listar los DMS que usan webhook en enrolamiento o reenrolamiento y confirmar que cada bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_2926":61592,"_25639":61534,"_17911":105583,"_5":17806,"_24291":105444,"_2452":105584},[],"**Verificación del receptor.** Confirmar que `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_2926":61593,"_25639":61534,"_17911":105586,"_5":17806,"_24291":105444,"_2452":105587},[],"**Entrega.** Lanzar, o esperar a que ocurra, un enrolamiento o reenrolamiento a través de cada webhook migrado y confirmar que la llamada de autorización se completa.",{"_2926":61594,"_25639":61534,"_17911":105589,"_5":17806,"_24291":105444,"_2452":105590},[],"**Conjunto de confianza.** Leer `est_rfc7030_settings.client_certificate_settings.validation_cas` y confirmar que contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_2926":61595,"_25639":61534,"_17911":105592,"_5":17806,"_24291":105444,"_2452":105593},[],"**Clientes de la API.** Actualizar los scripts y consolas que usen el formato antiguo del DMS (`additional_validation_cas` plano, o los campos `mtls`, `apikey` y `oidc` heredados), ya que descartan esos valores sin avisar.",{"_2926":61596,"_25639":61534,"_17911":105595,"_5":17806,"_24291":105444,"_2452":102341},[],{"_2926":61597,"_25639":61534,"_17911":105597,"_5":17806,"_24291":105444,"_2452":105598},[],"<Card title=\"API DMS\" href=\"/docs/api-reference/dms-manager\" />",{"_49406":105600,"_49408":105601,"_49410":105602,"_49412":105603,"_15557":2474,"_59159":2474},"spanish",[2452,25639,5,24291],{"_2452":21377,"_25639":21377,"_5":21377,"_24291":21377},{"_2452":105604,"_25639":108039,"_5":110474,"_24291":112909},{"_3912":105605,"_49416":105606,"_5":21377},{"_12298":10645,"_12657":14646,"_12664":4970,"_24854":4888,"_24416":5293,"_17011":2879,"_12319":6398,"_12326":2821,"_24816":8711,"_25177":2895,"_25198":2643,"_24829":19551,"_29535":4273,"_25209":5775,"_29540":5254,"_29543":4954,"_29546":5982,"_29549":8684,"_29552":2597,"_25510":11002,"_29557":4868,"_29559":3743,"_25540":8648,"_25500":4190,"_29563":13417,"_29566":19867,"_29568":4228,"_25227":6409,"_25505":4023,"_25558":2845,"_29573":2842,"_29575":3890,"_29577":4099,"_29579":4033,"_29581":2999,"_29583":2676,"_29585":21383,"_29587":5516,"_29589":3914,"_24867":15355,"_29592":2753,"_29594":2898,"_24861":17277,"_29597":13361,"_29599":4185,"_29601":9247,"_29604":8924,"_24897":15516,"_29608":4564,"_24807":3335,"_29611":2601,"_24834":4243,"_29614":5143,"_29616":4337,"_29619":2599,"_25535":4991,"_29622":6340,"_29624":5870,"_29627":3628,"_29629":4092,"_29631":6292,"_29633":3829,"_29635":6063,"_17014":3375,"_29638":4313,"_29640":3360,"_29642":2838,"_25221":2775,"_29645":4314,"_29647":6335,"_29649":5896,"_29651":4219,"_29653":3847,"_29655":4201,"_29657":2698,"_25625":4299,"_25248":4383,"_29661":4973,"_29663":12150,"_24845":5029,"_29666":3971,"_29668":2787,"_29670":5865,"_25563":4878,"_29673":16616,"_24354":2563,"_29676":21636,"_29678":15046,"_29680":2948,"_24943":4755,"_29685":17236,"_25215":17237,"_29688":2603,"_29690":4327,"_29692":7545,"_29694":2751,"_29696":3866,"_29698":2855,"_24937":2517,"_25182":3711,"_29702":3917,"_29704":21389,"_29707":3377,"_29709":2854,"_29711":3160,"_29713":5791,"_29715":6209,"_29717":6321,"_29720":2901,"_29722":4320,"_29724":19435,"_29726":18795,"_29728":2935,"_29731":4013,"_29733":3887,"_29736":4478,"_29739":15920,"_29741":4242,"_29743":5497,"_29745":3895,"_29747":13432,"_29749":41750,"_29751":17271,"_29753":3860,"_29755":2699,"