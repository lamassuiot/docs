"Docs","Deployment","Other models",[],{"_2936":16,"_25651":15,"_17922":41837,"_5":17817,"_24317":15,"_2462":41838},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_2936":17,"_25651":15,"_5":25993,"_17922":41840,"_24317":41841,"_2462":41842},[],"/docs/pr-preview/pr-49/deployment/aws-marketplace#before-you-begin","Before you begin",{"_2936":18,"_25651":15,"_5":25993,"_17922":41844,"_24317":41845,"_2462":41846},[],"/docs/pr-preview/pr-49/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_2936":19,"_25651":15,"_5":25993,"_17922":41848,"_24317":41849,"_2462":41850},[],"/docs/pr-preview/pr-49/deployment/aws-marketplace#open-the-offer","Open the offer",{"_2936":20,"_25651":15,"_5":25993,"_17922":41852,"_24317":41853,"_2462":41854},[],"/docs/pr-preview/pr-49/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_2936":21,"_25651":15,"_5":25993,"_17922":41856,"_24317":41857,"_2462":41858},[],"/docs/pr-preview/pr-49/deployment/aws-marketplace#limit-network-access","Limit network access",{"_2936":22,"_25651":15,"_5":25993,"_17922":41860,"_24317":41861,"_2462":41862},[],"/docs/pr-preview/pr-49/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_2936":23,"_25651":15,"_5":25993,"_17922":41864,"_24317":41865,"_2462":41866},[],"/docs/pr-preview/pr-49/deployment/aws-marketplace#next-step","Next step",{"_2936":24,"_25651":15,"_17922":41868,"_5":17817,"_24317":15,"_2462":41869},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_2936":25,"_25651":15,"_17922":41871,"_5":17817,"_24317":41841,"_2462":41872},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_2936":26,"_25651":15,"_17922":41874,"_5":17817,"_24317":41841,"_2462":41875},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_2936":27,"_25651":15,"_17922":41877,"_5":17817,"_24317":41841,"_2462":41878},[],"A security group allowing the necessary endpoints.",{"_2936":28,"_25651":15,"_17922":41880,"_5":17817,"_24317":41845,"_2462":41881},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_2936":29,"_25651":15,"_17922":41883,"_5":17817,"_24317":41845,"_2462":41884},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_2936":30,"_25651":15,"_17922":41886,"_5":17817,"_24317":41845,"_2462":41887},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_2936":31,"_25651":15,"_17922":41889,"_5":17817,"_24317":41849,"_2462":41890},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_2936":32,"_25651":15,"_17922":41892,"_5":17817,"_24317":41853,"_2462":41893},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_2936":33,"_25651":15,"_17922":41895,"_5":17817,"_24317":41857,"_2462":41896},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_2936":34,"_25651":15,"_17922":41898,"_5":17817,"_24317":41861,"_2462":41899},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_2936":35,"_25651":15,"_17922":41901,"_5":17817,"_24317":41865,"_2462":41902},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_2936":36,"_25651":36,"_5":12587,"_2462":41904,"_25996":41905,"_17922":41906,"_24317":36},"Deploy Lamassu",[41832,41833],[],{"_2936":37,"_25651":36,"_17922":41908,"_5":17817,"_24317":36,"_2462":41909},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_2936":38,"_25651":36,"_5":25993,"_17922":41911,"_24317":41912,"_2462":41913},[],"/docs/pr-preview/pr-49/deployment/overview#choose-a-model","Choose a model",{"_2936":39,"_25651":36,"_5":25993,"_17922":41915,"_24317":41916,"_2462":41917},[],"/docs/pr-preview/pr-49/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_2936":40,"_25651":36,"_5":25993,"_17922":41919,"_24317":41920,"_2462":41921},[],"/docs/pr-preview/pr-49/deployment/overview#after-deployment","After deployment",{"_2936":41,"_25651":36,"_17922":41923,"_5":17817,"_24317":36,"_2462":41924},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_2936":42,"_25651":36,"_17922":41926,"_5":17817,"_24317":41912,"_2462":41927},[],"Model",{"_2936":43,"_25651":36,"_17922":41929,"_5":17817,"_24317":41912,"_2462":41930},[],"Recommended for",{"_2936":44,"_25651":36,"_17922":41932,"_5":17817,"_24317":41912,"_2462":41933},[],"Who operates the infrastructure",{"_2936":45,"_25651":36,"_17922":41935,"_5":17817,"_24317":41912,"_2462":41936},[],"Starting point",{"_2936":46,"_25651":36,"_17922":41938,"_5":17817,"_24317":41912,"_2462":41939},[],"Kubernetes self-managed",{"_2936":47,"_25651":36,"_17922":41941,"_5":17817,"_24317":41912,"_2462":41942},[],"Production, regulated environments and custom deployments",{"_2936":48,"_25651":36,"_17922":41944,"_5":17817,"_24317":41912,"_2462":41945},[],"Your team",{"_2936":49,"_25651":36,"_17922":41947,"_5":17817,"_24317":41912,"_2462":41948},[],"Helm or Fastlane",{"_2936":50,"_25651":36,"_17922":41950,"_5":17817,"_24317":41912,"_2462":41951},[],"AWS Marketplace",{"_2936":51,"_25651":36,"_17922":41953,"_5":17817,"_24317":41912,"_2462":41954},[],"Evaluation or a dedicated deployment inside an AWS account",{"_2936":52,"_25651":36,"_17922":41956,"_5":17817,"_24317":41912,"_2462":41945},[],{"_2936":53,"_25651":36,"_17922":41958,"_5":17817,"_24317":41912,"_2462":41959},[],"Preconfigured image on EC2",{"_2936":54,"_25651":36,"_17922":41961,"_5":17817,"_24317":41912,"_2462":41962},[],"SaaS",{"_2936":55,"_25651":36,"_17922":41964,"_5":17817,"_24317":41912,"_2462":41965},[],"Teams that want to use the platform without operating it",{"_2936":56,"_25651":36,"_17922":41967,"_5":17817,"_24317":41912,"_2462":41968},[],"Lamassu",{"_2936":57,"_25651":36,"_17922":41970,"_5":17817,"_24317":41912,"_2462":41971},[],"Managed subscription",{"_2936":58,"_25651":36,"_17922":41973,"_5":17817,"_24317":41912,"_2462":41974},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2936":59,"_25651":36,"_17922":41976,"_5":17817,"_24317":41912,"_2462":41977},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2936":60,"_25651":36,"_17922":41979,"_5":17817,"_24317":41912,"_2462":41980},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_2936":61,"_25651":36,"_17922":41982,"_5":17817,"_24317":41916,"_2462":41983},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_2936":62,"_25651":36,"_17922":41985,"_5":17817,"_24317":41920,"_2462":41986},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_2936":63,"_25651":63,"_5":12587,"_2462":41988,"_25996":41989,"_17922":41990,"_24317":63},"Use Lamassu as SaaS",[41832,41833,41834],[],{"_2936":64,"_25651":63,"_17922":41992,"_5":17817,"_24317":63,"_2462":41993},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_2936":65,"_25651":63,"_5":25993,"_17922":41995,"_24317":41996,"_2462":41997},[],"/docs/pr-preview/pr-49/deployment/saas#what-the-service-manages","What the service manages",{"_2936":66,"_25651":63,"_5":25993,"_17922":41999,"_24317":42000,"_2462":42001},[],"/docs/pr-preview/pr-49/deployment/saas#plans","Plans",{"_2936":67,"_25651":63,"_5":25993,"_17922":42003,"_24317":42004,"_2462":42005},[],"/docs/pr-preview/pr-49/deployment/saas#request-access","Request access",{"_2936":68,"_25651":63,"_17922":42007,"_5":17817,"_24317":63,"_2462":42008},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_2936":69,"_25651":63,"_17922":42010,"_5":17817,"_24317":41996,"_2462":42011},[],"Platform availability and maintenance.",{"_2936":70,"_25651":63,"_17922":42013,"_5":17817,"_24317":41996,"_2462":42014},[],"Automatic backups.",{"_2936":71,"_25651":63,"_17922":42016,"_5":17817,"_24317":41996,"_2462":42017},[],"Version upgrades.",{"_2936":72,"_25651":63,"_17922":42019,"_5":17817,"_24317":41996,"_2462":42020},[],"Technical support and SLA according to your plan.",{"_2936":73,"_25651":63,"_17922":42022,"_5":17817,"_24317":42000,"_2462":42023},[],"Plan",{"_2936":74,"_25651":63,"_17922":42025,"_5":17817,"_24317":42000,"_2462":42026},[],"Devices",{"_2936":75,"_25651":63,"_17922":42028,"_5":17817,"_24317":42000,"_2462":42029},[],"Support",{"_2936":76,"_25651":63,"_17922":42031,"_5":17817,"_24317":42000,"_2462":42032},[],"SLA",{"_2936":77,"_25651":63,"_17922":42034,"_5":17817,"_24317":42000,"_2462":42035},[],"Starter",{"_2936":78,"_25651":63,"_17922":42037,"_5":17817,"_24317":42000,"_2462":42038},[],"Up to 1,000",{"_2936":79,"_25651":63,"_17922":42040,"_5":17817,"_24317":42000,"_2462":42041},[],"Email",{"_2936":80,"_25651":63,"_17922":42043,"_5":17817,"_24317":42000,"_2462":42044},[],"99.5 %",{"_2936":81,"_25651":63,"_17922":42046,"_5":17817,"_24317":42000,"_2462":42047},[],"Professional",{"_2936":82,"_25651":63,"_17922":42049,"_5":17817,"_24317":42000,"_2462":42050},[],"Up to 10,000",{"_2936":83,"_25651":63,"_17922":42052,"_5":17817,"_24317":42000,"_2462":42053},[],"Email and chat",{"_2936":84,"_25651":63,"_17922":42055,"_5":17817,"_24317":42000,"_2462":42056},[],"99.9 %",{"_2936":85,"_25651":63,"_17922":42058,"_5":17817,"_24317":42000,"_2462":42059},[],"Enterprise",{"_2936":86,"_25651":63,"_17922":42061,"_5":17817,"_24317":42000,"_2462":42062},[],"Unlimited",{"_2936":87,"_25651":63,"_17922":42064,"_5":17817,"_24317":42000,"_2462":42065},[],"Dedicated",{"_2936":88,"_25651":63,"_17922":42067,"_5":17817,"_24317":42000,"_2462":42068},[],"99.99 %",{"_2936":89,"_25651":63,"_17922":42070,"_5":17817,"_24317":42004,"_2462":42071},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_2936":90,"_25651":63,"_17922":42073,"_5":17817,"_24317":42004,"_2462":42074},[],"When you receive your instance's credentials, continue with Get started.",{"_2936":91,"_25651":91,"_5":12587,"_2462":42076,"_25996":42077,"_17922":42078,"_24317":91},"Fastlane",[41832,41833,41939],[],{"_2936":92,"_25651":91,"_17922":42080,"_5":17817,"_24317":91,"_2462":42081},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_2936":93,"_25651":91,"_5":25993,"_17922":42083,"_24317":42084,"_2462":42085},[],"/docs/pr-preview/pr-49/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_2936":94,"_25651":91,"_5":25993,"_17922":42087,"_24317":42088,"_2462":42089},[],"/docs/pr-preview/pr-49/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_2936":95,"_25651":91,"_5":25993,"_17922":42091,"_24317":42092,"_2462":41842},[],"/docs/pr-preview/pr-49/deployment/self-hosted/fastlane#before-you-begin",{"_2936":96,"_25651":91,"_5":25993,"_17922":42094,"_24317":42095,"_2462":42096},[],"/docs/pr-preview/pr-49/deployment/self-hosted/fastlane#quick-start","Quick start",{"_2936":97,"_25651":91,"_5":25993,"_17922":42098,"_24317":42099,"_2462":42100},[],"/docs/pr-preview/pr-49/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_2936":98,"_25651":91,"_5":25993,"_17922":42102,"_24317":42103,"_2462":42104},[],"/docs/pr-preview/pr-49/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_2936":99,"_25651":91,"_5":25993,"_17922":42106,"_24317":42107,"_2462":42108},[],"/docs/pr-preview/pr-49/deployment/self-hosted/fastlane#development-mode","Development mode",{"_2936":100,"_25651":91,"_5":25993,"_17922":42110,"_24317":42111,"_2462":42112},[],"/docs/pr-preview/pr-49/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_2936":101,"_25651":91,"_5":25993,"_17922":42114,"_24317":42115,"_2462":42116},[],"/docs/pr-preview/pr-49/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_2936":102,"_25651":91,"_5":25993,"_17922":42118,"_24317":42119,"_2462":42120},[],"/docs/pr-preview/pr-49/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_2936":103,"_25651":91,"_5":25993,"_17922":42122,"_24317":42123,"_2462":42124},[],"/docs/pr-preview/pr-49/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_2936":104,"_25651":91,"_17922":42126,"_5":17817,"_24317":42084,"_2462":42127},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_2936":105,"_25651":91,"_17922":42129,"_5":17817,"_24317":42084,"_2462":42130},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_2936":106,"_25651":91,"_17922":42132,"_5":17817,"_24317":42088,"_2462":42133},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_2936":107,"_25651":91,"_17922":42135,"_5":17817,"_24317":42088,"_2462":42136},[],"Fastlane installs or configures",{"_2936":108,"_25651":91,"_17922":42138,"_5":17817,"_24317":42088,"_2462":42139},[],"You still provide",{"_2936":109,"_25651":91,"_17922":42141,"_5":17817,"_24317":42088,"_2462":42142},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_2936":110,"_25651":91,"_17922":42144,"_5":17817,"_24317":42088,"_2462":42145},[],"The Kubernetes cluster, nodes and persistent storage",{"_2936":111,"_25651":91,"_17922":42147,"_5":17817,"_24317":42088,"_2462":42148},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_2936":112,"_25651":91,"_17922":42150,"_5":17817,"_24317":42088,"_2462":42151},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_2936":113,"_25651":91,"_17922":42153,"_5":17817,"_24317":42088,"_2462":42154},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_2936":114,"_25651":91,"_17922":42156,"_5":17817,"_24317":42088,"_2462":42157},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_2936":115,"_25651":91,"_17922":42159,"_5":17817,"_24317":42088,"_2462":42160},[],"Optional observability and lab HSM components",{"_2936":116,"_25651":91,"_17922":42162,"_5":17817,"_24317":42088,"_2462":42163},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_2936":117,"_25651":91,"_17922":42165,"_5":17817,"_24317":42088,"_2462":42166},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_2936":118,"_25651":91,"_17922":42168,"_5":17817,"_24317":42092,"_2462":42169},[],"You need:",{"_2936":119,"_25651":91,"_17922":42171,"_5":17817,"_24317":42092,"_2462":42172},[],"an existing Kubernetes cluster",{"_2936":120,"_25651":91,"_17922":42174,"_5":17817,"_24317":42092,"_2462":42175},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_2936":121,"_25651":91,"_17922":42177,"_5":17817,"_24317":42092,"_2462":42178},[],"`yq`",{"_2936":122,"_25651":91,"_17922":42180,"_5":17817,"_24317":42092,"_2462":20275},[],{"_2936":123,"_25651":91,"_17922":42182,"_5":17817,"_24317":42092,"_2462":42183},[],"`jq` only when using `--sample-data` or `--development`",{"_2936":124,"_25651":91,"_17922":42185,"_5":17817,"_24317":42092,"_2462":42186},[],"free external ports 80 and 443 on a single-node K3s host",{"_2936":125,"_25651":91,"_17922":42188,"_5":17817,"_24317":42092,"_2462":42189},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_2936":126,"_25651":91,"_17922":42191,"_5":17817,"_24317":42092,"_2462":42192},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_2936":127,"_25651":91,"_17922":42194,"_5":17817,"_24317":42095,"_2462":42195},[],"Run the script from a clone of the Helm repository:",{"_2936":128,"_25651":91,"_17922":42197,"_5":17817,"_24317":42095,"_2462":42198},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_2936":129,"_25651":91,"_17922":42200,"_5":17817,"_24317":42099,"_2462":42201},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_2936":130,"_25651":91,"_17922":42203,"_5":17817,"_24317":42099,"_2462":42204},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_2936":131,"_25651":91,"_17922":42206,"_5":17817,"_24317":42099,"_2462":42207},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_2936":132,"_25651":91,"_17922":42209,"_5":17817,"_24317":42099,"_2462":42210},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_2936":133,"_25651":91,"_17922":42212,"_5":17817,"_24317":42103,"_2462":42213},[],"Option",{"_2936":134,"_25651":91,"_17922":42215,"_5":17817,"_24317":42103,"_2462":42216},[],"Default",{"_2936":135,"_25651":91,"_17922":42218,"_5":17817,"_24317":42103,"_2462":42219},[],"Purpose",{"_2936":136,"_25651":91,"_17922":42221,"_5":17817,"_24317":42103,"_2462":42222},[],"`-h`, `--help`",{"_2936":137,"_25651":91,"_17922":42224,"_5":17817,"_24317":42103,"_2462":42225},[],"—",{"_2936":138,"_25651":91,"_17922":42227,"_5":17817,"_24317":42103,"_2462":42228},[],"Show help",{"_2936":139,"_25651":91,"_17922":42230,"_5":17817,"_24317":42103,"_2462":42231},[],"`-c`, `--context`",{"_2936":140,"_25651":91,"_17922":42233,"_5":17817,"_24317":42103,"_2462":42234},[],"current context",{"_2936":141,"_25651":91,"_17922":42236,"_5":17817,"_24317":42103,"_2462":42237},[],"Select the kubeconfig context for kubectl and Helm",{"_2936":142,"_25651":91,"_17922":42239,"_5":17817,"_24317":42103,"_2462":42240},[],"`-n`, `--non-interactive`",{"_2936":143,"_25651":91,"_17922":42242,"_5":17817,"_24317":42103,"_2462":5498},[],{"_2936":144,"_25651":91,"_17922":42244,"_5":17817,"_24317":42103,"_2462":42245},[],"Skip prompts and generate dependency credentials",{"_2936":145,"_25651":91,"_17922":42247,"_5":17817,"_24317":42103,"_2462":42248},[],"`-ns`, `--namespace`",{"_2936":146,"_25651":91,"_17922":42250,"_5":17817,"_24317":42103,"_2462":42251},[],"`lamassu-dev`",{"_2936":147,"_25651":91,"_17922":42253,"_5":17817,"_24317":42103,"_2462":42254},[],"Namespace for the installation",{"_2936":148,"_25651":91,"_17922":42256,"_5":17817,"_24317":42103,"_2462":42257},[],"`-d`, `--domain`",{"_2936":149,"_25651":91,"_17922":42259,"_5":17817,"_24317":42103,"_2462":42260},[],"`dev.lamassu.io`",{"_2936":150,"_25651":91,"_17922":42262,"_5":17817,"_24317":42103,"_2462":42263},[],"Domain used by the UI, OIDC and certificate",{"_2936":151,"_25651":91,"_17922":42265,"_5":17817,"_24317":42103,"_2462":42266},[],"`-v`, `--version`",{"_2936":152,"_25651":91,"_17922":42268,"_5":17817,"_24317":42103,"_2462":12818},[],{"_2936":153,"_25651":91,"_17922":42270,"_5":17817,"_24317":42103,"_2462":42271},[],"Lamassu chart version",{"_2936":154,"_25651":91,"_17922":42273,"_5":17817,"_24317":42103,"_2462":42274},[],"`--https-port`",{"_2936":155,"_25651":91,"_17922":42276,"_5":17817,"_24317":42103,"_2462":42277},[],"`443`",{"_2936":156,"_25651":91,"_17922":42279,"_5":17817,"_24317":42103,"_2462":42280},[],"Gateway HTTPS listener port",{"_2936":157,"_25651":91,"_17922":42282,"_5":17817,"_24317":42103,"_2462":42283},[],"`--http-port`",{"_2936":158,"_25651":91,"_17922":42285,"_5":17817,"_24317":42103,"_2462":42286},[],"`80`",{"_2936":159,"_25651":91,"_17922":42288,"_5":17817,"_24317":42103,"_2462":42289},[],"Gateway HTTP listener port",{"_2936":160,"_25651":91,"_17922":42291,"_5":17817,"_24317":42103,"_2462":42292},[],"`--tls-crt`",{"_2936":161,"_25651":91,"_17922":42294,"_5":17817,"_24317":42103,"_2462":42225},[],{"_2936":162,"_25651":91,"_17922":42296,"_5":17817,"_24317":42103,"_2462":42297},[],"PEM certificate for downstream TLS",{"_2936":163,"_25651":91,"_17922":42299,"_5":17817,"_24317":42103,"_2462":42300},[],"`--tls-key`",{"_2936":164,"_25651":91,"_17922":42302,"_5":17817,"_24317":42103,"_2462":42225},[],{"_2936":165,"_25651":91,"_17922":42304,"_5":17817,"_24317":42103,"_2462":42305},[],"PEM private key for downstream TLS",{"_2936":166,"_25651":91,"_17922":42307,"_5":17817,"_24317":42103,"_2462":42308},[],"`-l`, `--local-chart-path`",{"_2936":167,"_25651":91,"_17922":42310,"_5":17817,"_24317":42103,"_2462":42311},[],"repository chart",{"_2936":168,"_25651":91,"_17922":42313,"_5":17817,"_24317":42103,"_2462":42314},[],"Use an unpacked local Lamassu chart",{"_2936":169,"_25651":91,"_17922":42316,"_5":17817,"_24317":42103,"_2462":42317},[],"`-ip`, `--gateway-ip`",{"_2936":170,"_25651":91,"_17922":42319,"_5":17817,"_24317":42103,"_2462":7449},[],{"_2936":171,"_25651":91,"_17922":42321,"_5":17817,"_24317":42103,"_2462":42322},[],"Override the address written to `gateway.addresses`",{"_2936":172,"_25651":91,"_17922":42324,"_5":17817,"_24317":42103,"_2462":42325},[],"`--otel`",{"_2936":173,"_25651":91,"_17922":42327,"_5":17817,"_24317":42103,"_2462":5498},[],{"_2936":174,"_25651":91,"_17922":42329,"_5":17817,"_24317":42103,"_2462":42330},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_2936":175,"_25651":91,"_17922":42332,"_5":17817,"_24317":42103,"_2462":42333},[],"`--development`",{"_2936":176,"_25651":91,"_17922":42335,"_5":17817,"_24317":42103,"_2462":5498},[],{"_2936":177,"_25651":91,"_17922":42337,"_5":17817,"_24317":42103,"_2462":42338},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_2936":178,"_25651":91,"_17922":42340,"_5":17817,"_24317":42103,"_2462":42341},[],"`--sample-data`",{"_2936":179,"_25651":91,"_17922":42343,"_5":17817,"_24317":42103,"_2462":5498},[],{"_2936":180,"_25651":91,"_17922":42345,"_5":17817,"_24317":42103,"_2462":42346},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_2936":181,"_25651":91,"_17922":42348,"_5":17817,"_24317":42103,"_2462":42349},[],"`--with-hsm`",{"_2936":182,"_25651":91,"_17922":42351,"_5":17817,"_24317":42103,"_2462":5498},[],{"_2936":183,"_25651":91,"_17922":42353,"_5":17817,"_24317":42103,"_2462":42354},[],"Install lab HSM components and configure KMS for PKCS#11",{"_2936":184,"_25651":91,"_17922":42356,"_5":17817,"_24317":42103,"_2462":42357},[],"`--softhsm-chart-path`",{"_2936":185,"_25651":91,"_17922":42359,"_5":17817,"_24317":42103,"_2462":42360},[],"`./charts/softhsm`",{"_2936":186,"_25651":91,"_17922":42362,"_5":17817,"_24317":42103,"_2462":42363},[],"Use a different local SoftHSM chart",{"_2936":187,"_25651":91,"_17922":42365,"_5":17817,"_24317":42103,"_2462":42366},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_2936":188,"_25651":91,"_17922":42368,"_5":17817,"_24317":42107,"_2462":42369},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_2936":189,"_25651":91,"_17922":42371,"_5":17817,"_24317":42107,"_2462":42372},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_2936":190,"_25651":91,"_17922":42374,"_5":17817,"_24317":42107,"_2462":42375},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_2936":191,"_25651":91,"_17922":42377,"_5":17817,"_24317":42107,"_2462":42378},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_2936":192,"_25651":91,"_17922":42380,"_5":17817,"_24317":42107,"_2462":42381},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_2936":193,"_25651":91,"_17922":42383,"_5":17817,"_24317":42107,"_2462":42384},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_2936":194,"_25651":91,"_17922":42386,"_5":17817,"_24317":42111,"_2462":42387},[],"Fastlane:",{"_2936":195,"_25651":91,"_17922":42389,"_5":17817,"_24317":42111,"_2462":42390},[],"validates local tools and the selected cluster",{"_2936":196,"_25651":91,"_17922":42392,"_5":17817,"_24317":42111,"_2462":42393},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_2936":197,"_25651":91,"_17922":42395,"_5":17817,"_24317":42111,"_2462":42396},[],"creates the namespace",{"_2936":198,"_25651":91,"_17922":42398,"_5":17817,"_24317":42111,"_2462":42399},[],"installs PostgreSQL and creates the required databases",{"_2936":199,"_25651":91,"_17922":42401,"_5":17817,"_24317":42111,"_2462":42402},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_2936":200,"_25651":91,"_17922":42404,"_5":17817,"_24317":42111,"_2462":42405},[],"installs RabbitMQ",{"_2936":201,"_25651":91,"_17922":42407,"_5":17817,"_24317":42111,"_2462":42408},[],"optionally installs observability and lab HSM components",{"_2936":202,"_25651":91,"_17922":42410,"_5":17817,"_24317":42111,"_2462":42411},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_2936":203,"_25651":91,"_17922":42413,"_5":17817,"_24317":42111,"_2462":42414},[],"optionally loads sample data",{"_2936":204,"_25651":91,"_17922":42416,"_5":17817,"_24317":42111,"_2462":42417},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_2936":205,"_25651":91,"_17922":42419,"_5":17817,"_24317":42115,"_2462":42420},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_2936":206,"_25651":91,"_17922":42422,"_5":17817,"_24317":42115,"_2462":42423},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_2936":207,"_25651":91,"_17922":42425,"_5":17817,"_24317":42119,"_2462":42426},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_2936":208,"_25651":91,"_17922":42428,"_5":17817,"_24317":42119,"_2462":42429},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_2936":209,"_25651":91,"_17922":42431,"_5":17817,"_24317":42119,"_2462":42432},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_2936":210,"_25651":91,"_17922":42434,"_5":17817,"_24317":42123,"_2462":42435},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_2936":211,"_25651":211,"_5":12587,"_2462":42437,"_25996":42438,"_17922":42439,"_24317":211},"Install with Helm",[41832,41833,41939],[],{"_2936":212,"_25651":211,"_17922":42441,"_5":17817,"_24317":211,"_2462":42442},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_2936":213,"_25651":211,"_5":25993,"_17922":42444,"_24317":42445,"_2462":42446},[],"/docs/pr-preview/pr-49/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_2936":214,"_25651":211,"_5":25993,"_17922":42448,"_24317":42449,"_2462":41842},[],"/docs/pr-preview/pr-49/deployment/self-hosted/helm#before-you-begin",{"_2936":215,"_25651":211,"_5":25993,"_17922":42451,"_24317":42452,"_2462":42453},[],"/docs/pr-preview/pr-49/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_2936":216,"_25651":211,"_5":25993,"_17922":42455,"_24317":42456,"_2462":42457},[],"/docs/pr-preview/pr-49/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_2936":217,"_25651":211,"_5":25993,"_17922":42459,"_24317":42460,"_2462":42461},[],"/docs/pr-preview/pr-49/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_2936":218,"_25651":211,"_5":25993,"_17922":42463,"_24317":42464,"_2462":42465},[],"/docs/pr-preview/pr-49/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_2936":219,"_25651":211,"_5":25993,"_17922":42467,"_24317":42468,"_2462":42469},[],"/docs/pr-preview/pr-49/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_2936":220,"_25651":211,"_5":25993,"_17922":42471,"_24317":42472,"_2462":42473},[],"/docs/pr-preview/pr-49/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_2936":221,"_25651":211,"_5":25993,"_17922":42475,"_24317":42476,"_2462":42477},[],"/docs/pr-preview/pr-49/deployment/self-hosted/helm#production-decisions","Production decisions",{"_2936":222,"_25651":211,"_17922":42479,"_5":17817,"_24317":42445,"_2462":42480},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_2936":223,"_25651":211,"_17922":42482,"_5":17817,"_24317":42449,"_2462":42483},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_2936":224,"_25651":211,"_17922":42485,"_5":17817,"_24317":42449,"_2462":42486},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_2936":225,"_25651":211,"_17922":42488,"_5":17817,"_24317":42449,"_2462":42489},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_2936":226,"_25651":211,"_17922":42491,"_5":17817,"_24317":42449,"_2462":42492},[],"a reachable RabbitMQ broker and credentials",{"_2936":227,"_25651":211,"_17922":42494,"_5":17817,"_24317":42449,"_2462":42495},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_2936":228,"_25651":211,"_17922":42497,"_5":17817,"_24317":42449,"_2462":42498},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_2936":229,"_25651":211,"_17922":42500,"_5":17817,"_24317":42449,"_2462":42501},[],"cert-manager 1.14+; for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_2936":230,"_25651":211,"_17922":42503,"_5":17817,"_24317":42449,"_2462":42504},[],"a StorageClass and an external traffic design",{"_2936":231,"_25651":211,"_17922":42506,"_5":17817,"_24317":42449,"_2462":42507},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_2936":232,"_25651":211,"_17922":42509,"_5":17817,"_24317":42449,"_2462":42510},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_2936":233,"_25651":211,"_17922":42512,"_5":17817,"_24317":42449,"_2462":42513},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_2936":234,"_25651":211,"_17922":42515,"_5":17817,"_24317":42452,"_2462":42516},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_2936":235,"_25651":211,"_17922":42518,"_5":17817,"_24317":42452,"_2462":42519},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_2936":236,"_25651":211,"_17922":42521,"_5":17817,"_24317":42452,"_2462":42522},[],"Install cert-manager separately before Lamassu. The current chart renders its self-signed issuer and CA certificate resources even when `tls.type: external` makes the Gateway use an existing TLS Secret. Selecting external TLS therefore does not remove the cert-manager prerequisite.",{"_2936":237,"_25651":211,"_17922":42524,"_5":17817,"_24317":42456,"_2462":42525},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_2936":238,"_25651":211,"_17922":42527,"_5":17817,"_24317":42456,"_2462":42528},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_2936":239,"_25651":211,"_17922":42530,"_5":17817,"_24317":42456,"_2462":42531},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_2936":240,"_25651":211,"_17922":42533,"_5":17817,"_24317":42460,"_2462":42534},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it:",{"_2936":241,"_25651":211,"_17922":42536,"_5":17817,"_24317":42464,"_2462":42537},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_2936":242,"_25651":211,"_17922":42539,"_5":17817,"_24317":42464,"_2462":42540},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_2936":243,"_25651":211,"_17922":42542,"_5":17817,"_24317":42464,"_2462":42543},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_2936":244,"_25651":211,"_17922":42545,"_5":17817,"_24317":42464,"_2462":42546},[],"See Access control for the principal and policy model.",{"_2936":245,"_25651":211,"_17922":42548,"_5":17817,"_24317":42468,"_2462":42549},[],"To install a local checkout instead:",{"_2936":246,"_25651":211,"_17922":42551,"_5":17817,"_24317":42472,"_2462":42552},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_2936":247,"_25651":211,"_17922":42554,"_5":17817,"_24317":42472,"_2462":42555},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_2936":248,"_25651":211,"_17922":42557,"_5":17817,"_24317":42476,"_2462":42558},[],"Before going live, review:",{"_2936":249,"_25651":211,"_17922":42560,"_5":17817,"_24317":42476,"_2462":42561},[],"backup and recovery for PostgreSQL and persistent volumes",{"_2936":250,"_25651":211,"_17922":42563,"_5":17817,"_24317":42476,"_2462":42564},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_2936":251,"_25651":211,"_17922":42566,"_5":17817,"_24317":42476,"_2462":42567},[],"shared VA storage before increasing VA replicas",{"_2936":252,"_25651":211,"_17922":42569,"_5":17817,"_24317":42476,"_2462":42570},[],"managed OIDC roles and removal of evaluation credentials",{"_2936":253,"_25651":211,"_17922":42572,"_5":17817,"_24317":42476,"_2462":42573},[],"a trusted TLS issuer or externally managed certificate",{"_2936":254,"_25651":211,"_17922":42575,"_5":17817,"_24317":42476,"_2462":42576},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_2936":255,"_25651":211,"_17922":42578,"_5":17817,"_24317":42476,"_2462":42579},[],"SMTP, observability and alert delivery",{"_2936":256,"_25651":211,"_17922":42581,"_5":17817,"_24317":42476,"_2462":42582},[],"the migration notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_2936":257,"_25651":211,"_17922":42584,"_5":17817,"_24317":42476,"_2462":42585},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_2936":258,"_25651":258,"_5":12587,"_2462":42587,"_25996":42588,"_17922":42589,"_24317":258},"Expose the Gateway",[41832,41833,41939],[],{"_2936":259,"_25651":258,"_17922":42591,"_5":17817,"_24317":258,"_2462":42592},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_2936":260,"_25651":258,"_5":25993,"_17922":42594,"_24317":42595,"_2462":42596},[],"/docs/pr-preview/pr-49/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_2936":261,"_25651":258,"_5":25993,"_17922":42598,"_24317":42599,"_2462":42600},[],"/docs/pr-preview/pr-49/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_2936":262,"_25651":258,"_5":25993,"_17922":42602,"_24317":42603,"_2462":42604},[],"/docs/pr-preview/pr-49/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_2936":263,"_25651":258,"_5":25993,"_17922":42606,"_24317":42607,"_2462":42608},[],"/docs/pr-preview/pr-49/deployment/self-hosted/networking#k3s","K3s",{"_2936":264,"_25651":258,"_5":25993,"_17922":42610,"_24317":42611,"_2462":42612},[],"/docs/pr-preview/pr-49/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_2936":265,"_25651":258,"_5":25993,"_17922":42614,"_24317":42615,"_2462":42616},[],"/docs/pr-preview/pr-49/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_2936":266,"_25651":258,"_5":25993,"_17922":42618,"_24317":42619,"_2462":42620},[],"/docs/pr-preview/pr-49/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_2936":267,"_25651":258,"_5":25993,"_17922":42622,"_24317":42623,"_2462":42624},[],"/docs/pr-preview/pr-49/deployment/self-hosted/networking#decision-guide","Decision guide",{"_2936":268,"_25651":258,"_5":25993,"_17922":42626,"_24317":42627,"_2462":42628},[],"/docs/pr-preview/pr-49/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_2936":269,"_25651":258,"_17922":42630,"_5":17817,"_24317":42595,"_2462":42631},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_2936":270,"_25651":258,"_17922":42633,"_5":17817,"_24317":42595,"_2462":42634},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_2936":271,"_25651":258,"_17922":42636,"_5":17817,"_24317":42599,"_2462":42637},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_2936":272,"_25651":258,"_17922":42639,"_5":17817,"_24317":42599,"_2462":42640},[],"Set it only when:",{"_2936":273,"_25651":258,"_17922":42642,"_5":17817,"_24317":42599,"_2462":42643},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_2936":274,"_25651":258,"_17922":42645,"_5":17817,"_24317":42599,"_2462":42646},[],"that address is allocated to this Gateway",{"_2936":275,"_25651":258,"_17922":42648,"_5":17817,"_24317":42599,"_2462":42649},[],"the surrounding network already routes traffic for it to the cluster",{"_2936":276,"_25651":258,"_17922":42651,"_5":17817,"_24317":42599,"_2462":42652},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_2936":277,"_25651":258,"_17922":42654,"_5":17817,"_24317":42599,"_2462":42655},[],"Keep these two settings separate:",{"_2936":278,"_25651":258,"_17922":42657,"_5":17817,"_24317":42599,"_2462":42658},[],"`gateway.addresses` requests an address for the Gateway.",{"_2936":279,"_25651":258,"_17922":42660,"_5":17817,"_24317":42599,"_2462":42661},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_2936":280,"_25651":258,"_17922":42663,"_5":17817,"_24317":42599,"_2462":42664},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_2936":281,"_25651":258,"_17922":42666,"_5":17817,"_24317":42603,"_2462":42667},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_2936":282,"_25651":258,"_17922":42669,"_5":17817,"_24317":42603,"_2462":42670},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_2936":283,"_25651":258,"_17922":42672,"_5":17817,"_24317":42607,"_2462":42673},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_2936":284,"_25651":258,"_17922":42675,"_5":17817,"_24317":42607,"_2462":42676},[],"For the recommended design:",{"_2936":285,"_25651":258,"_17922":42678,"_5":17817,"_24317":42607,"_2462":42679},[],"Use only one externally exposed Lamassu Gateway.",{"_2936":286,"_25651":258,"_17922":42681,"_5":17817,"_24317":42607,"_2462":42682},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_2936":287,"_25651":258,"_17922":42684,"_5":17817,"_24317":42607,"_2462":42685},[],"Allow those ports through the VM firewall and any upstream security group.",{"_2936":288,"_25651":258,"_17922":42687,"_5":17817,"_24317":42607,"_2462":42688},[],"Point DNS at the VM's reachable address.",{"_2936":289,"_25651":258,"_17922":42690,"_5":17817,"_24317":42607,"_2462":42691},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_2936":290,"_25651":258,"_17922":42693,"_5":17817,"_24317":42611,"_2462":42694},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_2936":291,"_25651":258,"_17922":42696,"_5":17817,"_24317":42615,"_2462":42697},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_2936":292,"_25651":258,"_17922":42699,"_5":17817,"_24317":42615,"_2462":42700},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_2936":293,"_25651":258,"_17922":42702,"_5":17817,"_24317":42619,"_2462":42703},[],"First decide whether you need three independent data planes or only three hostnames.",{"_2936":294,"_25651":258,"_17922":42705,"_5":17817,"_24317":42619,"_2462":42706},[],"Requirement",{"_2936":295,"_25651":258,"_17922":42708,"_5":17817,"_24317":42619,"_2462":42709},[],"Recommended design",{"_2936":296,"_25651":258,"_17922":42711,"_5":17817,"_24317":42619,"_2462":42712},[],"Consequence",{"_2936":297,"_25651":258,"_17922":42714,"_5":17817,"_24317":42619,"_2462":42715},[],"Several Lamassu URLs or services",{"_2936":298,"_25651":258,"_17922":42717,"_5":17817,"_24317":42619,"_2462":42718},[],"One Gateway with multiple routes",{"_2936":299,"_25651":258,"_17922":42720,"_5":17817,"_24317":42619,"_2462":42721},[],"One IP and one proxy fleet; this is the chart default",{"_2936":300,"_25651":258,"_17922":42723,"_5":17817,"_24317":42619,"_2462":42724},[],"Independent Gateways and separate external IPs",{"_2936":301,"_25651":258,"_17922":42726,"_5":17817,"_24317":42619,"_2462":42727},[],"One VIP per Gateway",{"_2936":302,"_25651":258,"_17922":42729,"_5":17817,"_24317":42619,"_2462":42730},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_2936":303,"_25651":258,"_17922":42732,"_5":17817,"_24317":42619,"_2462":42733},[],"Independent Gateways on one node and one IP",{"_2936":304,"_25651":258,"_17922":42735,"_5":17817,"_24317":42619,"_2462":42736},[],"Use different external ports",{"_2936":305,"_25651":258,"_17922":42738,"_5":17817,"_24317":42619,"_2462":42739},[],"Clients must include non-standard ports",{"_2936":306,"_25651":258,"_17922":42741,"_5":17817,"_24317":42619,"_2462":42742},[],"Separate TLS/mTLS termination behind one IP",{"_2936":307,"_25651":258,"_17922":42744,"_5":17817,"_24317":42619,"_2462":42745},[],"Front-door SNI routing to internal Gateways",{"_2936":308,"_25651":258,"_17922":42747,"_5":17817,"_24317":42619,"_2462":42748},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_2936":309,"_25651":258,"_17922":42750,"_5":17817,"_24317":42619,"_2462":42751},[],"Separate Gateway resources but shared proxy infrastructure",{"_2936":310,"_25651":258,"_17922":42753,"_5":17817,"_24317":42619,"_2462":42754},[],"Envoy merged-Gateway mode",{"_2936":311,"_25651":258,"_17922":42756,"_5":17817,"_24317":42619,"_2462":42757},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_2936":312,"_25651":258,"_17922":42759,"_5":17817,"_24317":42619,"_2462":42760},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_2936":313,"_25651":258,"_17922":42762,"_5":17817,"_24317":42619,"_2462":42763},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_2936":314,"_25651":258,"_17922":42765,"_5":17817,"_24317":42619,"_2462":42766},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_2936":315,"_25651":258,"_17922":42768,"_5":17817,"_24317":42619,"_2462":42769},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_2936":316,"_25651":258,"_17922":42771,"_5":17817,"_24317":42623,"_2462":42772},[],"If one Gateway can own TLS and routing, use the chart default.",{"_2936":317,"_25651":258,"_17922":42774,"_5":17817,"_24317":42623,"_2462":42775},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_2936":318,"_25651":258,"_17922":42777,"_5":17817,"_24317":42623,"_2462":42778},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_2936":319,"_25651":258,"_17922":42780,"_5":17817,"_24317":42623,"_2462":42781},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_2936":320,"_25651":258,"_17922":42783,"_5":17817,"_24317":42623,"_2462":42784},[],"If none of those are possible, use different external ports or change the external network design.",{"_2936":321,"_25651":258,"_17922":42786,"_5":17817,"_24317":42627,"_2462":42787},[],"Check, in order:",{"_2936":322,"_25651":258,"_17922":42789,"_5":17817,"_24317":42627,"_2462":42790},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_2936":323,"_25651":258,"_17922":42792,"_5":17817,"_24317":42627,"_2462":42793},[],"Its status contains the expected address.",{"_2936":324,"_25651":258,"_17922":42795,"_5":17817,"_24317":42627,"_2462":42796},[],"The generated `LoadBalancer` Service has a usable external address.",{"_2936":325,"_25651":258,"_17922":42798,"_5":17817,"_24317":42627,"_2462":42799},[],"Port 443 reaches that address from the client network.",{"_2936":326,"_25651":258,"_17922":42801,"_5":17817,"_24317":42627,"_2462":42802},[],"DNS resolves to the externally reachable endpoint.",{"_2936":327,"_25651":258,"_17922":42804,"_5":17817,"_24317":42627,"_2462":42805},[],"The certificate contains the DNS name or IP used by the client.",{"_2936":328,"_25651":258,"_17922":42807,"_5":17817,"_24317":42627,"_2462":42808},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_2936":329,"_25651":329,"_5":12587,"_2462":41939,"_25996":42810,"_17922":42811,"_24317":329},[41832,41833,41939],[],{"_2936":330,"_25651":329,"_17922":42813,"_5":17817,"_24317":329,"_2462":42814},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_2936":331,"_25651":329,"_5":25993,"_17922":42816,"_24317":42817,"_2462":42818},[],"/docs/pr-preview/pr-49/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_2936":332,"_25651":329,"_5":25993,"_17922":42820,"_24317":42821,"_2462":42822},[],"/docs/pr-preview/pr-49/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_2936":333,"_25651":329,"_5":25993,"_17922":42824,"_24317":42825,"_2462":42826},[],"/docs/pr-preview/pr-49/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_2936":334,"_25651":329,"_5":25993,"_17922":42828,"_24317":42829,"_2462":42830},[],"/docs/pr-preview/pr-49/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_2936":335,"_25651":329,"_5":25993,"_17922":42832,"_24317":42833,"_2462":42834},[],"/docs/pr-preview/pr-49/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_2936":336,"_25651":329,"_5":25993,"_17922":42836,"_24317":42837,"_2462":42838},[],"/docs/pr-preview/pr-49/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_2936":337,"_25651":329,"_17922":42840,"_5":17817,"_24317":42817,"_2462":42841},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_2936":338,"_25651":329,"_17922":42843,"_5":17817,"_24317":42821,"_2462":42844},[],"Workflow",{"_2936":339,"_25651":329,"_17922":42846,"_5":17817,"_24317":42821,"_2462":42847},[],"Use it for",{"_2936":340,"_25651":329,"_17922":42849,"_5":17817,"_24317":42821,"_2462":42850},[],"What it installs",{"_2936":341,"_25651":329,"_17922":42852,"_5":17817,"_24317":42821,"_2462":42853},[],"Helm",{"_2936":342,"_25651":329,"_17922":42855,"_5":17817,"_24317":42821,"_2462":42856},[],"Production and controlled environments",{"_2936":343,"_25651":329,"_17922":42858,"_5":17817,"_24317":42821,"_2462":42859},[],"Lamassu services and Gateway API resources",{"_2936":344,"_25651":329,"_17922":42861,"_5":17817,"_24317":42821,"_2462":42076},[],{"_2936":345,"_25651":329,"_17922":42863,"_5":17817,"_24317":42821,"_2462":42864},[],"Evaluation, demos, CI and small lab clusters",{"_2936":346,"_25651":329,"_17922":42866,"_5":17817,"_24317":42821,"_2462":42867},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_2936":347,"_25651":329,"_17922":42869,"_5":17817,"_24317":42825,"_2462":42870},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_2936":348,"_25651":329,"_17922":42872,"_5":17817,"_24317":42825,"_2462":42873},[],"Area",{"_2936":349,"_25651":329,"_17922":42875,"_5":17817,"_24317":42825,"_2462":42876},[],"The Lamassu chart provides",{"_2936":350,"_25651":329,"_17922":42878,"_5":17817,"_24317":42825,"_2462":42879},[],"You provide",{"_2936":351,"_25651":329,"_17922":42881,"_5":17817,"_24317":42825,"_2462":42882},[],"Lamassu applications",{"_2936":352,"_25651":329,"_17922":42884,"_5":17817,"_24317":42825,"_2462":42885},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_2936":353,"_25651":329,"_17922":42887,"_5":17817,"_24317":42825,"_2462":42888},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_2936":354,"_25651":329,"_17922":42890,"_5":17817,"_24317":42825,"_2462":42891},[],"PostgreSQL data",{"_2936":355,"_25651":329,"_17922":42893,"_5":17817,"_24317":42825,"_2462":42894},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_2936":356,"_25651":329,"_17922":42896,"_5":17817,"_24317":42825,"_2462":42897},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_2936":357,"_25651":329,"_17922":42899,"_5":17817,"_24317":42825,"_2462":42900},[],"Messaging",{"_2936":358,"_25651":329,"_17922":42902,"_5":17817,"_24317":42825,"_2462":42903},[],"RabbitMQ connection configuration for the Lamassu services",{"_2936":359,"_25651":329,"_17922":42905,"_5":17817,"_24317":42825,"_2462":42906},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_2936":360,"_25651":329,"_17922":42908,"_5":17817,"_24317":42825,"_2462":42909},[],"Identity",{"_2936":361,"_25651":329,"_17922":42911,"_5":17817,"_24317":42825,"_2462":42912},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_2936":362,"_25651":329,"_17922":42914,"_5":17817,"_24317":42825,"_2462":42915},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_2936":363,"_25651":329,"_17922":42917,"_5":17817,"_24317":42825,"_2462":42918},[],"External routing",{"_2936":364,"_25651":329,"_17922":42920,"_5":17817,"_24317":42825,"_2462":42921},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_2936":365,"_25651":329,"_17922":42923,"_5":17817,"_24317":42825,"_2462":42924},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_2936":366,"_25651":329,"_17922":42926,"_5":17817,"_24317":42825,"_2462":42927},[],"TLS",{"_2936":367,"_25651":329,"_17922":42929,"_5":17817,"_24317":42825,"_2462":42930},[],"cert-manager `Issuer` and CA `Certificate` resources; either a chart-managed downstream `Certificate` or a reference to your TLS Secret",{"_2936":368,"_25651":329,"_17922":42932,"_5":17817,"_24317":42825,"_2462":42933},[],"cert-manager itself; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_2936":369,"_25651":329,"_17922":42935,"_5":17817,"_24317":42825,"_2462":42936},[],"Persistent application data",{"_2936":370,"_25651":329,"_17922":42938,"_5":17817,"_24317":42825,"_2462":42939},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_2936":371,"_25651":329,"_17922":42941,"_5":17817,"_24317":42825,"_2462":42942},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_2936":372,"_25651":329,"_17922":42944,"_5":17817,"_24317":42825,"_2462":42945},[],"Optional integrations",{"_2936":373,"_25651":329,"_17922":42947,"_5":17817,"_24317":42825,"_2462":42948},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_2936":374,"_25651":329,"_17922":42950,"_5":17817,"_24317":42825,"_2462":42951},[],"The observability backends, cloud credentials and production HSM or external key service",{"_2936":375,"_25651":329,"_17922":42953,"_5":17817,"_24317":42825,"_2462":42954},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_2936":376,"_25651":329,"_17922":42956,"_5":17817,"_24317":42825,"_2462":42957},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_2936":377,"_25651":329,"_17922":42959,"_5":17817,"_24317":42829,"_2462":42960},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_2936":378,"_25651":329,"_17922":42962,"_5":17817,"_24317":42829,"_2462":42963},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_2936":379,"_25651":329,"_17922":42965,"_5":17817,"_24317":42833,"_2462":42966},[],"Kubernetes 1.24 or newer",{"_2936":380,"_25651":329,"_17922":42968,"_5":17817,"_24317":42833,"_2462":42969},[],"Helm 3.2 or newer",{"_2936":381,"_25651":329,"_17922":42971,"_5":17817,"_24317":42833,"_2462":42972},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_2936":382,"_25651":329,"_17922":42974,"_5":17817,"_24317":42833,"_2462":42975},[],"cert-manager 1.14 or newer; the current chart renders cert-manager issuer and certificate resources",{"_2936":383,"_25651":329,"_17922":42977,"_5":17817,"_24317":42833,"_2462":42978},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_2936":384,"_25651":329,"_17922":42980,"_5":17817,"_24317":42833,"_2462":42981},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_2936":385,"_25651":329,"_17922":42983,"_5":17817,"_24317":42833,"_2462":42984},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer.",{"_2936":386,"_25651":329,"_17922":42986,"_5":17817,"_24317":42837,"_2462":42987},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2936":387,"_25651":329,"_17922":42989,"_5":17817,"_24317":42837,"_2462":42990},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2936":388,"_25651":329,"_17922":42992,"_5":17817,"_24317":42837,"_2462":42993},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2936":389,"_25651":389,"_5":12587,"_2462":42995,"_25996":42996,"_17922":42998,"_24317":389},"Deployment troubleshooting",[41832,41833,42997],"Operations",[],{"_2936":390,"_25651":389,"_17922":43000,"_5":17817,"_24317":389,"_2462":43001},[],"Diagnose access, service health and infrastructure dependencies.",{"_2936":391,"_25651":389,"_5":25993,"_17922":43003,"_24317":43004,"_2462":43005},[],"/docs/pr-preview/pr-49/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_2936":392,"_25651":389,"_5":25993,"_17922":43007,"_24317":43008,"_2462":43009},[],"/docs/pr-preview/pr-49/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_2936":393,"_25651":389,"_5":25993,"_17922":43011,"_24317":43012,"_2462":43013},[],"/docs/pr-preview/pr-49/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_2936":394,"_25651":389,"_5":25993,"_17922":43015,"_24317":43016,"_2462":43017},[],"/docs/pr-preview/pr-49/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_2936":395,"_25651":389,"_5":25993,"_17922":43019,"_24317":43020,"_2462":43021},[],"/docs/pr-preview/pr-49/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_2936":396,"_25651":389,"_5":25993,"_17922":43023,"_24317":43024,"_2462":43025},[],"/docs/pr-preview/pr-49/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_2936":397,"_25651":389,"_5":25993,"_17922":43027,"_24317":43028,"_2462":43029},[],"/docs/pr-preview/pr-49/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_2936":398,"_25651":389,"_5":25993,"_17922":43031,"_24317":43032,"_2462":43033},[],"/docs/pr-preview/pr-49/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_2936":399,"_25651":389,"_5":25993,"_17922":43035,"_24317":43036,"_2462":43037},[],"/docs/pr-preview/pr-49/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_2936":400,"_25651":389,"_5":25993,"_17922":43039,"_24317":43040,"_2462":43041},[],"/docs/pr-preview/pr-49/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_2936":401,"_25651":389,"_5":25993,"_17922":43043,"_24317":43044,"_2462":43045},[],"/docs/pr-preview/pr-49/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_2936":402,"_25651":389,"_5":25993,"_17922":43047,"_24317":43048,"_2462":43049},[],"/docs/pr-preview/pr-49/deployment/troubleshooting#observability","Observability",{"_2936":403,"_25651":389,"_17922":43051,"_5":17817,"_24317":389,"_2462":43052},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_2936":404,"_25651":389,"_17922":43054,"_5":17817,"_24317":43008,"_2462":43055},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_2936":405,"_25651":389,"_17922":43057,"_5":17817,"_24317":43012,"_2462":43058},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_2936":406,"_25651":389,"_17922":43060,"_5":17817,"_24317":43016,"_2462":43061},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_2936":407,"_25651":389,"_17922":43063,"_5":17817,"_24317":43020,"_2462":43064},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_2936":408,"_25651":389,"_17922":43066,"_5":17817,"_24317":43024,"_2462":43067},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_2936":409,"_25651":389,"_17922":43069,"_5":17817,"_24317":43028,"_2462":43070},[],"Replace the placeholders with your real release, namespace and deployment.",{"_2936":410,"_25651":389,"_17922":43072,"_5":17817,"_24317":43028,"_2462":43073},[],"Also run the chart's connectivity test:",{"_2936":411,"_25651":389,"_17922":43075,"_5":17817,"_24317":43028,"_2462":43076},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_2936":412,"_25651":389,"_17922":43078,"_5":17817,"_24317":43028,"_2462":43079},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_2936":413,"_25651":389,"_17922":43081,"_5":17817,"_24317":43032,"_2462":43082},[],"If you receive a 401:",{"_2936":414,"_25651":389,"_17922":43084,"_5":17817,"_24317":43032,"_2462":43085},[],"check that the UI's OIDC authority is reachable from the browser;",{"_2936":415,"_25651":389,"_17922":43087,"_5":17817,"_24317":43032,"_2462":43088},[],"verify issuer, audience and expiration of the token;",{"_2936":416,"_25651":389,"_17922":43090,"_5":17817,"_24317":43032,"_2462":43091},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_2936":417,"_25651":389,"_17922":43093,"_5":17817,"_24317":43032,"_2462":43094},[],"check that the provider's public and internal routes point to the same realm.",{"_2936":418,"_25651":389,"_17922":43096,"_5":17817,"_24317":43032,"_2462":43097},[],"If login succeeds but the APIs return 403:",{"_2936":419,"_25651":389,"_17922":43099,"_5":17817,"_24317":43032,"_2462":43100},[],"inspect the token's real claims;",{"_2936":420,"_25651":389,"_17922":43102,"_5":17817,"_24317":43032,"_2462":43103},[],"confirm they match an active principal;",{"_2936":421,"_25651":389,"_17922":43105,"_5":17817,"_24317":43032,"_2462":43106},[],"review the policies granted to that principal;",{"_2936":422,"_25651":389,"_17922":43108,"_5":17817,"_24317":43032,"_2462":43109},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_2936":423,"_25651":389,"_17922":43111,"_5":17817,"_24317":43032,"_2462":43112},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_2936":424,"_25651":389,"_17922":43114,"_5":17817,"_24317":43036,"_2462":43115},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_2936":425,"_25651":389,"_17922":43117,"_5":17817,"_24317":43036,"_2462":43118},[],"Locate the authz pod and Service.",{"_2936":426,"_25651":389,"_17922":43120,"_5":17817,"_24317":43036,"_2462":43121},[],"Check /health, logs and its database connection.",{"_2936":427,"_25651":389,"_17922":43123,"_5":17817,"_24317":43036,"_2462":43124},[],"Verify the DNS and port configured in externalAuthorization.",{"_2936":428,"_25651":389,"_17922":43126,"_5":17817,"_24317":43036,"_2462":43127},[],"Check the check route is /v1/ext\\_authz/check.",{"_2936":429,"_25651":389,"_17922":43129,"_5":17817,"_24317":43036,"_2462":43130},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_2936":430,"_25651":389,"_17922":43132,"_5":17817,"_24317":43040,"_2462":43133},[],"Review kubectl describe pod first. Common causes are:",{"_2936":431,"_25651":389,"_17922":43135,"_5":17817,"_24317":43040,"_2462":43136},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_2936":432,"_25651":389,"_17922":43138,"_5":17817,"_24317":43040,"_2462":43139},[],"unbound persistent volume;",{"_2936":433,"_25651":389,"_17922":43141,"_5":17817,"_24317":43040,"_2462":43142},[],"inaccessible image or incorrect pull policy;",{"_2936":434,"_25651":389,"_17922":43144,"_5":17817,"_24317":43040,"_2462":43145},[],"invalid cryptographic engine configuration;",{"_2936":435,"_25651":389,"_17922":43147,"_5":17817,"_24317":43040,"_2462":43148},[],"CPU or memory limits set too low;",{"_2936":436,"_25651":389,"_17922":43150,"_5":17817,"_24317":43040,"_2462":43151},[],"an incomplete prior migration.",{"_2936":437,"_25651":389,"_17922":43153,"_5":17817,"_24317":43040,"_2462":43154},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_2936":438,"_25651":389,"_17922":43156,"_5":17817,"_24317":43040,"_2462":43157},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_2936":439,"_25651":389,"_17922":43159,"_5":17817,"_24317":43044,"_2462":43160},[],"Domain and audit events depend on the bus publisher:",{"_2936":440,"_25651":389,"_17922":43162,"_5":17817,"_24317":43044,"_2462":43163},[],"verify it is enabled in the emitting service;",{"_2936":441,"_25651":389,"_17922":43165,"_5":17817,"_24317":43044,"_2462":43166},[],"check AMQP connectivity and credentials;",{"_2936":442,"_25651":389,"_17922":43168,"_5":17817,"_24317":43044,"_2462":43169},[],"review exchange, routing key, queues and consumers;",{"_2936":443,"_25651":389,"_17922":43171,"_5":17817,"_24317":43044,"_2462":43172},[],"inspect dead-letter queues;",{"_2936":444,"_25651":389,"_17922":43174,"_5":17817,"_24317":43044,"_2462":43175},[],"alert on orphan durable queues and backlog growth.",{"_2936":445,"_25651":389,"_17922":43177,"_5":17817,"_24317":43044,"_2462":43178},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_2936":446,"_25651":389,"_17922":43180,"_5":17817,"_24317":43048,"_2462":43181},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_2936":447,"_25651":389,"_17922":43183,"_5":17817,"_24317":43048,"_2462":43184},[],"Before closing an incident, record:",{"_2936":448,"_25651":389,"_17922":43186,"_5":17817,"_24317":43048,"_2462":43187},[],"the confirmed cause;",{"_2936":449,"_25651":389,"_17922":43189,"_5":17817,"_24317":43048,"_2462":43190},[],"the time scope and affected resources;",{"_2936":450,"_25651":389,"_17922":43192,"_5":17817,"_24317":43048,"_2462":43193},[],"the commands or queries used;",{"_2936":451,"_25651":389,"_17922":43195,"_5":17817,"_24317":43048,"_2462":43196},[],"the applied change and how to revert it;",{"_2936":452,"_25651":389,"_17922":43198,"_5":17817,"_24317":43048,"_2462":43199},[],"validation from a consumer;",{"_2936":453,"_25651":389,"_17922":43201,"_5":17817,"_24317":43048,"_2462":43202},[],"the preventive action and its owner.",{"_2936":454,"_25651":454,"_5":12587,"_2462":43204,"_25996":43205,"_17922":43208,"_24317":454},"Access control",[41832,43206,43207],"Platform","Administration",[],{"_2936":455,"_25651":454,"_17922":43210,"_5":17817,"_24317":454,"_2462":43211},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_2936":456,"_25651":454,"_5":25993,"_17922":43213,"_24317":43214,"_2462":43215},[],"/docs/pr-preview/pr-49/platform/administration/access-control#essential-concepts","Essential concepts",{"_2936":457,"_25651":454,"_5":25993,"_17922":43217,"_24317":43218,"_2462":43219},[],"/docs/pr-preview/pr-49/platform/administration/access-control#two-decision-systems","Two decision systems",{"_2936":458,"_25651":454,"_5":25993,"_17922":43221,"_24317":43222,"_2462":43223},[],"/docs/pr-preview/pr-49/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_2936":459,"_25651":454,"_5":25993,"_17922":43225,"_24317":43226,"_2462":43227},[],"/docs/pr-preview/pr-49/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_2936":460,"_25651":454,"_5":25993,"_17922":43229,"_24317":43230,"_2462":43231},[],"/docs/pr-preview/pr-49/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_2936":461,"_25651":454,"_5":25993,"_17922":43233,"_24317":43234,"_2462":43235},[],"/docs/pr-preview/pr-49/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_2936":462,"_25651":454,"_5":25993,"_17922":43237,"_24317":43238,"_2462":43239},[],"/docs/pr-preview/pr-49/platform/administration/access-control#oidc-principals","OIDC principals",{"_2936":463,"_25651":454,"_5":25993,"_17922":43241,"_24317":43242,"_2462":43243},[],"/docs/pr-preview/pr-49/platform/administration/access-control#x509-principals","X.509 principals",{"_2936":464,"_25651":454,"_5":25993,"_17922":43245,"_24317":43246,"_2462":43247},[],"/docs/pr-preview/pr-49/platform/administration/access-control#when-several-principals-match","When several principals match",{"_2936":465,"_25651":454,"_5":25993,"_17922":43249,"_24317":43250,"_2462":43251},[],"/docs/pr-preview/pr-49/platform/administration/access-control#how-policies-express-access","How policies express access",{"_2936":466,"_25651":454,"_5":25993,"_17922":43253,"_24317":43254,"_2462":43255},[],"/docs/pr-preview/pr-49/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_2936":467,"_25651":454,"_5":25993,"_17922":43257,"_24317":43258,"_2462":43259},[],"/docs/pr-preview/pr-49/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_2936":468,"_25651":454,"_5":25993,"_17922":43261,"_24317":43262,"_2462":43263},[],"/docs/pr-preview/pr-49/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_2936":469,"_25651":454,"_5":25993,"_17922":43265,"_24317":43266,"_2462":43267},[],"/docs/pr-preview/pr-49/platform/administration/access-control#http-rules","HTTP rules",{"_2936":470,"_25651":454,"_5":25993,"_17922":43269,"_24317":43270,"_2462":43271},[],"/docs/pr-preview/pr-49/platform/administration/access-control#included-policies","Included policies",{"_2936":471,"_25651":454,"_5":25993,"_17922":43273,"_24317":43274,"_2462":42465},[],"/docs/pr-preview/pr-49/platform/administration/access-control#provision-the-first-administrator",{"_2936":472,"_25651":454,"_5":25993,"_17922":43276,"_24317":43277,"_2462":43278},[],"/docs/pr-preview/pr-49/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_2936":473,"_25651":454,"_5":25993,"_17922":43280,"_24317":43281,"_2462":43282},[],"/docs/pr-preview/pr-49/platform/administration/access-control#configure-the-two-jwt-validations","Configure the two JWT validations",{"_2936":474,"_25651":454,"_5":25993,"_17922":43284,"_24317":43285,"_2462":43286},[],"/docs/pr-preview/pr-49/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_2936":475,"_25651":454,"_5":25993,"_17922":43288,"_24317":43289,"_2462":43290},[],"/docs/pr-preview/pr-49/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_2936":476,"_25651":454,"_5":25993,"_17922":43292,"_24317":43293,"_2462":43294},[],"/docs/pr-preview/pr-49/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_2936":477,"_25651":454,"_5":25993,"_17922":43296,"_24317":43297,"_2462":43298},[],"/docs/pr-preview/pr-49/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_2936":478,"_25651":454,"_5":25993,"_17922":43300,"_24317":43301,"_2462":43302},[],"/docs/pr-preview/pr-49/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_2936":479,"_25651":454,"_5":25993,"_17922":43304,"_24317":43305,"_2462":43306},[],"/docs/pr-preview/pr-49/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_2936":480,"_25651":454,"_5":25993,"_17922":43308,"_24317":43309,"_2462":43310},[],"/docs/pr-preview/pr-49/platform/administration/access-control#operational-checklist","Operational checklist",{"_2936":481,"_25651":454,"_5":25993,"_17922":43312,"_24317":43313,"_2462":43314},[],"/docs/pr-preview/pr-49/platform/administration/access-control#diagnostics","Diagnostics",{"_2936":482,"_25651":454,"_5":25993,"_17922":43316,"_24317":43317,"_2462":43318},[],"/docs/pr-preview/pr-49/platform/administration/access-control#the-response-is-401","The response is 401",{"_2936":483,"_25651":454,"_5":25993,"_17922":43320,"_24317":43321,"_2462":43322},[],"/docs/pr-preview/pr-49/platform/administration/access-control#the-response-is-403","The response is 403",{"_2936":484,"_25651":454,"_5":25993,"_17922":43324,"_24317":43325,"_2462":43326},[],"/docs/pr-preview/pr-49/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_2936":485,"_25651":454,"_5":25993,"_17922":43328,"_24317":43329,"_2462":43330},[],"/docs/pr-preview/pr-49/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_2936":486,"_25651":454,"_5":25993,"_17922":43332,"_24317":43333,"_2462":43334},[],"/docs/pr-preview/pr-49/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_2936":487,"_25651":454,"_17922":43336,"_5":17817,"_24317":454,"_2462":43337},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_2936":488,"_25651":454,"_17922":43339,"_5":17817,"_24317":454,"_2462":43340},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_2936":489,"_25651":454,"_17922":43342,"_5":17817,"_24317":454,"_2462":43343},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_2936":490,"_25651":454,"_17922":43345,"_5":17817,"_24317":43214,"_2462":43346},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_2936":491,"_25651":454,"_17922":43348,"_5":17817,"_24317":43214,"_2462":43349},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_2936":492,"_25651":454,"_17922":43351,"_5":17817,"_24317":43214,"_2462":43352},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_2936":493,"_25651":454,"_17922":43354,"_5":17817,"_24317":43214,"_2462":43355},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_2936":494,"_25651":454,"_17922":43357,"_5":17817,"_24317":43214,"_2462":43358},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_2936":495,"_25651":454,"_17922":43360,"_5":17817,"_24317":43214,"_2462":43361},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_2936":496,"_25651":454,"_17922":43363,"_5":17817,"_24317":43218,"_2462":43364},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_2936":497,"_25651":454,"_17922":43366,"_5":17817,"_24317":43218,"_2462":43367},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_2936":498,"_25651":454,"_17922":43369,"_5":17817,"_24317":43222,"_2462":43370},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_2936":499,"_25651":454,"_17922":43372,"_5":17817,"_24317":43222,"_2462":43373},[],"The decision is made **before forwarding the request to the service**:",{"_2936":500,"_25651":454,"_17922":43375,"_5":17817,"_24317":43222,"_2462":43376},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_2936":501,"_25651":454,"_17922":43378,"_5":17817,"_24317":43222,"_2462":43379},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_2936":502,"_25651":454,"_17922":43381,"_5":17817,"_24317":43222,"_2462":43382},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_2936":503,"_25651":454,"_17922":43384,"_5":17817,"_24317":43222,"_2462":43385},[],"It separately loads the policies granted to each principal.",{"_2936":504,"_25651":454,"_17922":43387,"_5":17817,"_24317":43222,"_2462":43388},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_2936":505,"_25651":454,"_17922":43390,"_5":17817,"_24317":43222,"_2462":43391},[],"`authz` looks for an HTTP rule granting that action.",{"_2936":506,"_25651":454,"_17922":43393,"_5":17817,"_24317":43222,"_2462":43394},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_2936":507,"_25651":454,"_17922":43396,"_5":17817,"_24317":43222,"_2462":43397},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_2936":508,"_25651":454,"_17922":43399,"_5":17817,"_24317":43222,"_2462":43400},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_2936":509,"_25651":454,"_17922":43402,"_5":17817,"_24317":43222,"_2462":43403},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_2936":510,"_25651":454,"_17922":43405,"_5":17817,"_24317":43226,"_2462":43406},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_2936":511,"_25651":454,"_17922":43408,"_5":17817,"_24317":43226,"_2462":43409},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_2936":512,"_25651":454,"_17922":43411,"_5":17817,"_24317":43226,"_2462":43412},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_2936":513,"_25651":454,"_17922":43414,"_5":17817,"_24317":43226,"_2462":43415},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_2936":514,"_25651":454,"_17922":43417,"_5":17817,"_24317":43226,"_2462":43418},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_2936":515,"_25651":454,"_17922":43420,"_5":17817,"_24317":43226,"_2462":43421},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_2936":516,"_25651":454,"_17922":43423,"_5":17817,"_24317":43226,"_2462":43424},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_2936":517,"_25651":454,"_17922":43426,"_5":17817,"_24317":43226,"_2462":43427},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_2936":518,"_25651":454,"_17922":43429,"_5":17817,"_24317":43230,"_2462":43430},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_2936":519,"_25651":454,"_17922":43432,"_5":17817,"_24317":43230,"_2462":43433},[],"The decision is made with the domain operation context:",{"_2936":520,"_25651":454,"_17922":43435,"_5":17817,"_24317":43230,"_2462":43436},[],"The middleware extracts the credential and resolves the matching principals.",{"_2936":521,"_25651":454,"_17922":43438,"_5":17817,"_24317":43230,"_2462":43439},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_2936":522,"_25651":454,"_17922":43441,"_5":17817,"_24317":43230,"_2462":43442},[],"`authz` gathers the entity rules of the granted policies.",{"_2936":523,"_25651":454,"_17922":43444,"_5":17817,"_24317":43230,"_2462":43445},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_2936":524,"_25651":454,"_17922":43447,"_5":17817,"_24317":43230,"_2462":43448},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_2936":525,"_25651":454,"_17922":43450,"_5":17817,"_24317":43230,"_2462":43451},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_2936":526,"_25651":454,"_17922":43453,"_5":17817,"_24317":43230,"_2462":43454},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_2936":527,"_25651":454,"_17922":43456,"_5":17817,"_24317":43230,"_2462":43457},[],"Actions fall into two groups:",{"_2936":528,"_25651":454,"_17922":43459,"_5":17817,"_24317":43230,"_2462":43460},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_2936":529,"_25651":454,"_17922":43462,"_5":17817,"_24317":43230,"_2462":43463},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_2936":530,"_25651":454,"_17922":43465,"_5":17817,"_24317":43230,"_2462":43466},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_2936":531,"_25651":454,"_17922":43468,"_5":17817,"_24317":43234,"_2462":43469},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_2936":532,"_25651":454,"_17922":43471,"_5":17817,"_24317":43234,"_2462":43472},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_2936":533,"_25651":454,"_17922":43474,"_5":17817,"_24317":43234,"_2462":43475},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_2936":534,"_25651":454,"_17922":43477,"_5":17817,"_24317":43238,"_2462":43478},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_2936":535,"_25651":454,"_17922":43480,"_5":17817,"_24317":43238,"_2462":43481},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_2936":536,"_25651":454,"_17922":43483,"_5":17817,"_24317":43238,"_2462":43484},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_2936":537,"_25651":454,"_17922":43486,"_5":17817,"_24317":43238,"_2462":43487},[],"The implemented operators are:",{"_2936":538,"_25651":454,"_17922":43489,"_5":17817,"_24317":43238,"_2462":43490},[],"`equals`, for exact equality;",{"_2936":539,"_25651":454,"_17922":43492,"_5":17817,"_24317":43238,"_2462":43493},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_2936":540,"_25651":454,"_17922":43495,"_5":17817,"_24317":43238,"_2462":43496},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_2936":541,"_25651":454,"_17922":43498,"_5":17817,"_24317":43238,"_2462":43499},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_2936":542,"_25651":454,"_17922":43501,"_5":17817,"_24317":43242,"_2462":43502},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_2936":543,"_25651":454,"_17922":43504,"_5":17817,"_24317":43242,"_2462":43505},[],"The available modes are:",{"_2936":544,"_25651":454,"_17922":43507,"_5":17817,"_24317":43242,"_2462":43508},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_2936":545,"_25651":454,"_17922":43510,"_5":17817,"_24317":43242,"_2462":43511},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_2936":546,"_25651":454,"_17922":43513,"_5":17817,"_24317":43242,"_2462":43514},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_2936":547,"_25651":454,"_17922":43516,"_5":17817,"_24317":43242,"_2462":43517},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_2936":548,"_25651":454,"_17922":43519,"_5":17817,"_24317":43242,"_2462":43520},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_2936":549,"_25651":454,"_17922":43522,"_5":17817,"_24317":43242,"_2462":43523},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_2936":550,"_25651":454,"_17922":43525,"_5":17817,"_24317":43246,"_2462":43526},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_2936":551,"_25651":454,"_17922":43528,"_5":17817,"_24317":43246,"_2462":43529},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_2936":552,"_25651":454,"_17922":43531,"_5":17817,"_24317":43246,"_2462":43532},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_2936":553,"_25651":454,"_17922":43534,"_5":17817,"_24317":43246,"_2462":43535},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_2936":554,"_25651":454,"_17922":43537,"_5":17817,"_24317":43254,"_2462":43538},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_2936":555,"_25651":454,"_17922":43540,"_5":17817,"_24317":43254,"_2462":43541},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_2936":556,"_25651":454,"_17922":43543,"_5":17817,"_24317":43258,"_2462":43544},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_2936":557,"_25651":454,"_17922":43546,"_5":17817,"_24317":43258,"_2462":43547},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_2936":558,"_25651":454,"_17922":43549,"_5":17817,"_24317":43262,"_2462":43550},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_2936":559,"_25651":454,"_17922":43552,"_5":17817,"_24317":43262,"_2462":43553},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_2936":560,"_25651":454,"_17922":43555,"_5":17817,"_24317":43262,"_2462":43556},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_2936":561,"_25651":454,"_17922":43558,"_5":17817,"_24317":43266,"_2462":43559},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_2936":562,"_25651":454,"_17922":43561,"_5":17817,"_24317":43266,"_2462":43562},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_2936":563,"_25651":454,"_17922":43564,"_5":17817,"_24317":43266,"_2462":43565},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_2936":564,"_25651":454,"_17922":43567,"_5":17817,"_24317":43266,"_2462":43568},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_2936":565,"_25651":454,"_17922":43570,"_5":17817,"_24317":43266,"_2462":43571},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_2936":566,"_25651":454,"_17922":43573,"_5":17817,"_24317":43266,"_2462":43574},[],"Note that:",{"_2936":567,"_25651":454,"_17922":43576,"_5":17817,"_24317":43266,"_2462":43577},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_2936":568,"_25651":454,"_17922":43579,"_5":17817,"_24317":43266,"_2462":43580},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_2936":569,"_25651":454,"_17922":43582,"_5":17817,"_24317":43266,"_2462":43583},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_2936":570,"_25651":454,"_17922":43585,"_5":17817,"_24317":43270,"_2462":43586},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_2936":571,"_25651":454,"_17922":43588,"_5":17817,"_24317":43270,"_2462":43589},[],"full and read-only access to certificates and authorities;",{"_2936":572,"_25651":454,"_17922":43591,"_5":17817,"_24317":43270,"_2462":43592},[],"full and read-only access to the KMS;",{"_2936":573,"_25651":454,"_17922":43594,"_5":17817,"_24317":43270,"_2462":43595},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_2936":574,"_25651":454,"_17922":43597,"_5":17817,"_24317":43270,"_2462":43598},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_2936":575,"_25651":454,"_17922":43600,"_5":17817,"_24317":43270,"_2462":43601},[],"console access;",{"_2936":576,"_25651":454,"_17922":43603,"_5":17817,"_24317":43270,"_2462":43604},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_2936":577,"_25651":454,"_17922":43606,"_5":17817,"_24317":43270,"_2462":43607},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_2936":578,"_25651":454,"_17922":43609,"_5":17817,"_24317":43270,"_2462":43610},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_2936":579,"_25651":454,"_17922":43612,"_5":17817,"_24317":43274,"_2462":43613},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_2936":580,"_25651":454,"_17922":43615,"_5":17817,"_24317":43274,"_2462":43616},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_2936":581,"_25651":454,"_17922":43618,"_5":17817,"_24317":43274,"_2462":43619},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_2936":582,"_25651":454,"_17922":43621,"_5":17817,"_24317":43277,"_2462":43622},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_2936":583,"_25651":454,"_17922":43624,"_5":17817,"_24317":43281,"_2462":43625},[],"The Gateway uses `auth.authentication.apiGateway.jwks` to authenticate requests. `authz` uses `services.authz.jwkUrl` to resolve OIDC principals. Both endpoints must contain the keys of the same issuer and be reachable from their respective components.",{"_2936":584,"_25651":454,"_17922":43627,"_5":17817,"_24317":43285,"_2462":43628},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_2936":585,"_25651":454,"_17922":43630,"_5":17817,"_24317":43289,"_2462":43631},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_2936":586,"_25651":454,"_17922":43633,"_5":17817,"_24317":43293,"_2462":43634},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_2936":587,"_25651":454,"_17922":43636,"_5":17817,"_24317":43297,"_2462":43637},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_2936":588,"_25651":454,"_17922":43639,"_5":17817,"_24317":43297,"_2462":43640},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_2936":589,"_25651":454,"_17922":43642,"_5":17817,"_24317":43301,"_2462":43643},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_2936":590,"_25651":454,"_17922":43645,"_5":17817,"_24317":43301,"_2462":43646},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_2936":591,"_25651":454,"_17922":43648,"_5":17817,"_24317":43301,"_2462":43649},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_2936":592,"_25651":454,"_17922":43651,"_5":17817,"_24317":43301,"_2462":43652},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_2936":593,"_25651":454,"_17922":43654,"_5":17817,"_24317":43301,"_2462":43655},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_2936":594,"_25651":454,"_17922":43657,"_5":17817,"_24317":43301,"_2462":43658},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_2936":595,"_25651":454,"_17922":43660,"_5":17817,"_24317":43301,"_2462":43661},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_2936":596,"_25651":454,"_17922":43663,"_5":17817,"_24317":43301,"_2462":43664},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_2936":597,"_25651":454,"_17922":43666,"_5":17817,"_24317":43305,"_2462":43667},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_2936":598,"_25651":454,"_17922":43669,"_5":17817,"_24317":43305,"_2462":43670},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_2936":599,"_25651":454,"_17922":43672,"_5":17817,"_24317":43305,"_2462":43673},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_2936":600,"_25651":454,"_17922":43675,"_5":17817,"_24317":43309,"_2462":43676},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_2936":601,"_25651":454,"_17922":43678,"_5":17817,"_24317":43309,"_2462":43679},[],"Use groups or stable roles for people and independent identities for automations.",{"_2936":602,"_25651":454,"_17922":43681,"_5":17817,"_24317":43309,"_2462":43682},[],"Keep at least two recovery administrators and test their access periodically.",{"_2936":603,"_25651":454,"_17922":43684,"_5":17817,"_24317":43309,"_2462":43685},[],"Review active principals, their matches and their grants after IdP changes.",{"_2936":604,"_25651":454,"_17922":43687,"_5":17817,"_24317":43309,"_2462":43688},[],"Search for wildcards in policies before upgrading Lamassu.",{"_2936":605,"_25651":454,"_17922":43690,"_5":17817,"_24317":43309,"_2462":43691},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_2936":606,"_25651":454,"_17922":43693,"_5":17817,"_24317":43309,"_2462":43694},[],"Always test one allowed and one denied operation for each role.",{"_2936":607,"_25651":454,"_17922":43696,"_5":17817,"_24317":43309,"_2462":43697},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_2936":608,"_25651":454,"_17922":43699,"_5":17817,"_24317":43317,"_2462":43700},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_2936":609,"_25651":454,"_17922":43702,"_5":17817,"_24317":43321,"_2462":43703},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_2936":610,"_25651":454,"_17922":43705,"_5":17817,"_24317":43321,"_2462":43706},[],"that an active principal of the correct type exists;",{"_2936":611,"_25651":454,"_17922":43708,"_5":17817,"_24317":43321,"_2462":43709},[],"that the claim paths and values match the real token exactly;",{"_2936":612,"_25651":454,"_17922":43711,"_5":17817,"_24317":43321,"_2462":43712},[],"that all of the principal's conditions hold;",{"_2936":613,"_25651":454,"_17922":43714,"_5":17817,"_24317":43321,"_2462":43715},[],"that the principal has the expected policy granted;",{"_2936":614,"_25651":454,"_17922":43717,"_5":17817,"_24317":43321,"_2462":43718},[],"that the policy includes the action and the requested resource type or route;",{"_2936":615,"_25651":454,"_17922":43720,"_5":17817,"_24317":43321,"_2462":43721},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_2936":616,"_25651":454,"_17922":43723,"_5":17817,"_24317":43321,"_2462":43724},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_2936":617,"_25651":454,"_17922":43726,"_5":17817,"_24317":43325,"_2462":43727},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_2936":618,"_25651":454,"_17922":43729,"_5":17817,"_24317":43329,"_2462":43730},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_2936":619,"_25651":454,"_17922":43732,"_5":17817,"_24317":43333,"_2462":43733},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_2936":620,"_25651":454,"_17922":43735,"_5":17817,"_24317":43333,"_2462":43736},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_2936":621,"_25651":621,"_5":12587,"_2462":43738,"_25996":43739,"_17922":43740,"_24317":621},"Alerts and subscriptions",[41832,43206,43207],[],{"_2936":622,"_25651":621,"_17922":43742,"_5":17817,"_24317":621,"_2462":43743},[],"Send PKI events to people and external systems.",{"_2936":623,"_25651":621,"_5":25993,"_17922":43745,"_24317":43746,"_2462":43747},[],"/docs/pr-preview/pr-49/platform/administration/alerts#how-it-works","How it works",{"_2936":624,"_25651":621,"_5":25993,"_17922":43749,"_24317":43750,"_2462":43751},[],"/docs/pr-preview/pr-49/platform/administration/alerts#available-channels","Available channels",{"_2936":625,"_25651":621,"_5":25993,"_17922":43753,"_24317":43754,"_2462":43755},[],"/docs/pr-preview/pr-49/platform/administration/alerts#create-a-subscription","Create a subscription",{"_2936":626,"_25651":621,"_5":25993,"_17922":43757,"_24317":43758,"_2462":43759},[],"/docs/pr-preview/pr-49/platform/administration/alerts#choose-the-event","Choose the event",{"_2936":627,"_25651":621,"_5":25993,"_17922":43761,"_24317":43762,"_2462":43763},[],"/docs/pr-preview/pr-49/platform/administration/alerts#configure-the-destination","Configure the destination",{"_2936":628,"_25651":621,"_5":25993,"_17922":43765,"_24317":43766,"_2462":43767},[],"/docs/pr-preview/pr-49/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_2936":629,"_25651":621,"_5":25993,"_17922":43769,"_24317":43770,"_2462":43771},[],"/docs/pr-preview/pr-49/platform/administration/alerts#review-and-activate","Review and activate",{"_2936":630,"_25651":621,"_5":25993,"_17922":43773,"_24317":43774,"_2462":43775},[],"/docs/pr-preview/pr-49/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_2936":631,"_25651":621,"_5":25993,"_17922":43777,"_24317":43778,"_2462":43779},[],"/docs/pr-preview/pr-49/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_2936":632,"_25651":621,"_5":25993,"_17922":43781,"_24317":43782,"_2462":43783},[],"/docs/pr-preview/pr-49/platform/administration/alerts#event-families","Event families",{"_2936":633,"_25651":621,"_17922":43785,"_5":17817,"_24317":621,"_2462":43786},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_2936":634,"_25651":621,"_17922":43788,"_5":17817,"_24317":43746,"_2462":43789},[],"A service publishes a domain event.",{"_2936":635,"_25651":621,"_17922":43791,"_5":17817,"_24317":43746,"_2462":43792},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_2936":636,"_25651":621,"_17922":43794,"_5":17817,"_24317":43746,"_2462":43795},[],"Each subscription's filter decides whether it should be notified.",{"_2936":637,"_25651":621,"_17922":43797,"_5":17817,"_24317":43746,"_2462":43798},[],"Lamassu delivers the event to the configured channel.",{"_2936":638,"_25651":621,"_17922":43800,"_5":17817,"_24317":43746,"_2462":43801},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_2936":639,"_25651":621,"_17922":43803,"_5":17817,"_24317":43750,"_2462":43804},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_2936":640,"_25651":621,"_17922":43806,"_5":17817,"_24317":43750,"_2462":43807},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_2936":641,"_25651":621,"_17922":43809,"_5":17817,"_24317":43750,"_2462":43810},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_2936":642,"_25651":621,"_17922":43812,"_5":17817,"_24317":43750,"_2462":43813},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_2936":643,"_25651":621,"_17922":43815,"_5":17817,"_24317":43750,"_2462":43816},[],"`apikey_options` requires `header` and `key`.",{"_2936":644,"_25651":621,"_17922":43818,"_5":17817,"_24317":43750,"_2462":43819},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_2936":645,"_25651":621,"_17922":43821,"_5":17817,"_24317":43750,"_2462":43822},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_2936":646,"_25651":621,"_17922":43824,"_5":17817,"_24317":43750,"_2462":43825},[],"The alerts API reference documents the full `http_client` schema.",{"_2936":647,"_25651":621,"_17922":43827,"_5":17817,"_24317":43758,"_2462":43828},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_2936":648,"_25651":621,"_17922":43830,"_5":17817,"_24317":43762,"_2462":43831},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_2936":649,"_25651":621,"_17922":43833,"_5":17817,"_24317":43766,"_2462":43834},[],"Add a filter if you don't want to receive every instance of the event.",{"_2936":650,"_25651":621,"_17922":43836,"_5":17817,"_24317":43766,"_2462":43837},[],"**None** notifies all instances of the event.",{"_2936":651,"_25651":621,"_17922":43839,"_5":17817,"_24317":43766,"_2462":43840},[],"**JSON Path** evaluates one or more specific fields.",{"_2936":652,"_25651":621,"_17922":43842,"_5":17817,"_24317":43766,"_2462":43843},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_2936":653,"_25651":621,"_17922":43845,"_5":17817,"_24317":43766,"_2462":43846},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_2936":654,"_25651":621,"_17922":43848,"_5":17817,"_24317":43766,"_2462":43849},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_2936":655,"_25651":621,"_17922":43851,"_5":17817,"_24317":43770,"_2462":43852},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_2936":656,"_25651":621,"_17922":43854,"_5":17817,"_24317":43774,"_2462":43855},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_2936":657,"_25651":621,"_17922":43857,"_5":17817,"_24317":43774,"_2462":43858},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_2936":658,"_25651":621,"_17922":43860,"_5":17817,"_24317":43774,"_2462":43861},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_2936":659,"_25651":621,"_17922":43863,"_5":17817,"_24317":43774,"_2462":43864},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_2936":660,"_25651":621,"_17922":43866,"_5":17817,"_24317":43774,"_2462":43867},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_2936":661,"_25651":621,"_17922":43869,"_5":17817,"_24317":43774,"_2462":43870},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_2936":662,"_25651":621,"_17922":43872,"_5":17817,"_24317":43774,"_2462":43873},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_2936":663,"_25651":621,"_17922":43875,"_5":17817,"_24317":43774,"_2462":43876},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_2936":664,"_25651":621,"_17922":43878,"_5":17817,"_24317":43778,"_2462":43879},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_2936":665,"_25651":621,"_17922":43881,"_5":17817,"_24317":43782,"_2462":43882},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_2936":666,"_25651":621,"_17922":43884,"_5":17817,"_24317":43782,"_2462":43885},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_2936":667,"_25651":621,"_17922":43887,"_5":17817,"_24317":43782,"_2462":43888},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_2936":668,"_25651":621,"_17922":43890,"_5":17817,"_24317":43782,"_2462":43891},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_2936":669,"_25651":621,"_17922":43893,"_5":17817,"_24317":43782,"_2462":43894},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_2936":670,"_25651":621,"_17922":43896,"_5":17817,"_24317":43782,"_2462":43897},[],"**Validation:** `va.role.crl.create`.",{"_2936":671,"_25651":621,"_17922":43899,"_5":17817,"_24317":43782,"_2462":43900},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_2936":672,"_25651":621,"_17922":43902,"_5":17817,"_24317":43782,"_2462":43903},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_2936":673,"_25651":673,"_5":12587,"_2462":43905,"_25996":43906,"_17922":43907,"_24317":673},"Audit logs",[41832,43206,43207],[],{"_2936":674,"_25651":673,"_17922":43909,"_5":17817,"_24317":673,"_2462":43910},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_2936":675,"_25651":673,"_5":25993,"_17922":43912,"_24317":43913,"_2462":43914},[],"/docs/pr-preview/pr-49/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_2936":676,"_25651":673,"_5":25993,"_17922":43916,"_24317":43917,"_2462":43918},[],"/docs/pr-preview/pr-49/platform/administration/audit-logs#coverage","Coverage",{"_2936":677,"_25651":673,"_5":25993,"_17922":43920,"_24317":43921,"_2462":43922},[],"/docs/pr-preview/pr-49/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_2936":678,"_25651":673,"_5":25993,"_17922":43924,"_24317":43925,"_2462":43926},[],"/docs/pr-preview/pr-49/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_2936":679,"_25651":673,"_5":25993,"_17922":43928,"_24317":43929,"_2462":43930},[],"/docs/pr-preview/pr-49/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_2936":680,"_25651":673,"_5":25993,"_17922":43932,"_24317":43933,"_2462":43934},[],"/docs/pr-preview/pr-49/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_2936":681,"_25651":673,"_5":25993,"_17922":43936,"_24317":43937,"_2462":43938},[],"/docs/pr-preview/pr-49/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_2936":682,"_25651":673,"_5":25993,"_17922":43940,"_24317":43941,"_2462":43942},[],"/docs/pr-preview/pr-49/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_2936":683,"_25651":673,"_5":25993,"_17922":43944,"_24317":43945,"_2462":43946},[],"/docs/pr-preview/pr-49/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_2936":684,"_25651":673,"_5":25993,"_17922":43948,"_24317":43949,"_2462":43950},[],"/docs/pr-preview/pr-49/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_2936":685,"_25651":673,"_5":25993,"_17922":43952,"_24317":43953,"_2462":43954},[],"/docs/pr-preview/pr-49/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_2936":686,"_25651":673,"_17922":43956,"_5":17817,"_24317":673,"_2462":43957},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_2936":687,"_25651":673,"_17922":43959,"_5":17817,"_24317":43913,"_2462":43960},[],"The audit body includes:",{"_2936":688,"_25651":673,"_17922":43962,"_5":17817,"_24317":43913,"_2462":43963},[],"input: data received by the operation;",{"_2936":689,"_25651":673,"_17922":43965,"_5":17817,"_24317":43913,"_2462":43966},[],"has\\_error: whether the service returned an error;",{"_2936":690,"_25651":673,"_17922":43968,"_5":17817,"_24317":43913,"_2462":43969},[],"output: produced result or error message;",{"_2936":691,"_25651":673,"_17922":43971,"_5":17817,"_24317":43913,"_2462":43972},[],"principals: identifiers of the principals that matched the request.",{"_2936":692,"_25651":673,"_17922":43974,"_5":17817,"_24317":43913,"_2462":43975},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_2936":693,"_25651":673,"_17922":43977,"_5":17817,"_24317":43913,"_2462":43978},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_2936":694,"_25651":673,"_17922":43980,"_5":17817,"_24317":43917,"_2462":43981},[],"The backend applies auditing to mutations of:",{"_2936":695,"_25651":673,"_17922":43983,"_5":17817,"_24317":43917,"_2462":43984},[],"authorities, certificates and issuance profiles;",{"_2936":696,"_25651":673,"_17922":43986,"_5":17817,"_24317":43917,"_2462":43987},[],"keys and KMS engines;",{"_2936":697,"_25651":673,"_17922":43989,"_5":17817,"_24317":43917,"_2462":43990},[],"devices and identities;",{"_2936":698,"_25651":673,"_17922":43992,"_5":17817,"_24317":43917,"_2462":43993},[],"DMSs and enrollment operations;",{"_2936":699,"_25651":673,"_17922":43995,"_5":17817,"_24317":43917,"_2462":43996},[],"validation functions and CRL;",{"_2936":700,"_25651":673,"_17922":43998,"_5":17817,"_24317":43917,"_2462":43999},[],"principals, policies and authorization grants.",{"_2936":701,"_25651":673,"_17922":44001,"_5":17817,"_24317":43917,"_2462":44002},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_2936":702,"_25651":673,"_17922":44004,"_5":17817,"_24317":43921,"_2462":44005},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_2936":703,"_25651":673,"_17922":44007,"_5":17817,"_24317":43921,"_2462":44008},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_2936":704,"_25651":673,"_17922":44010,"_5":17817,"_24317":43921,"_2462":44011},[],"Design the consumer to:",{"_2936":705,"_25651":673,"_17922":44013,"_5":17817,"_24317":43921,"_2462":44014},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_2936":706,"_25651":673,"_17922":44016,"_5":17817,"_24317":43921,"_2462":44017},[],"keep the complete CloudEvent unmodified;",{"_2936":707,"_25651":673,"_17922":44019,"_5":17817,"_24317":43921,"_2462":44020},[],"record the ingestion time and detect duplicates by ID;",{"_2936":708,"_25651":673,"_17922":44022,"_5":17817,"_24317":43921,"_2462":44023},[],"encrypt in transit and at rest;",{"_2936":709,"_25651":673,"_17922":44025,"_5":17817,"_24317":43921,"_2462":44026},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_2936":710,"_25651":673,"_17922":44028,"_5":17817,"_24317":43921,"_2462":44029},[],"apply an explicit retention and legal hold policy;",{"_2936":711,"_25651":673,"_17922":44031,"_5":17817,"_24317":43921,"_2462":44032},[],"alert if it stops consuming or the pending queue grows.",{"_2936":712,"_25651":673,"_17922":44034,"_5":17817,"_24317":43925,"_2462":44035},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_2936":713,"_25651":673,"_17922":44037,"_5":17817,"_24317":43925,"_2462":44038},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_2936":714,"_25651":673,"_17922":44040,"_5":17817,"_24317":43933,"_2462":44041},[],"Start from the reported time and normalize every source to UTC.",{"_2936":715,"_25651":673,"_17922":44043,"_5":17817,"_24317":43937,"_2462":44044},[],"Filter by event type, service source and resource identifier.",{"_2936":716,"_25651":673,"_17922":44046,"_5":17817,"_24317":43941,"_2462":44047},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_2936":717,"_25651":673,"_17922":44049,"_5":17817,"_24317":43945,"_2462":44050},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_2936":718,"_25651":673,"_17922":44052,"_5":17817,"_24317":43949,"_2462":44053},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_2936":719,"_25651":673,"_17922":44055,"_5":17817,"_24317":43953,"_2462":44056},[],"Generate a controlled mutation in a test environment and check that:",{"_2936":720,"_25651":673,"_17922":44058,"_5":17817,"_24317":43953,"_2462":44059},[],"a successful audit event appears;",{"_2936":721,"_25651":673,"_17922":44061,"_5":17817,"_24317":43953,"_2462":44062},[],"the principal matches the identity used;",{"_2936":722,"_25651":673,"_17922":44064,"_5":17817,"_24317":43953,"_2462":44065},[],"the consumer persists it exactly once;",{"_2936":723,"_25651":673,"_17922":44067,"_5":17817,"_24317":43953,"_2462":44068},[],"it can be retrieved by resource, actor and period;",{"_2936":724,"_25651":673,"_17922":44070,"_5":17817,"_24317":43953,"_2462":44071},[],"a consumer outage raises an alert.",{"_2936":725,"_25651":673,"_17922":44073,"_5":17817,"_24317":43953,"_2462":44074},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_2936":726,"_25651":726,"_5":12587,"_2462":44076,"_25996":44077,"_17922":44078,"_24317":726},"Platform architecture",[41832,43206],[],{"_2936":727,"_25651":726,"_17922":44080,"_5":17817,"_24317":726,"_2462":44081},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_2936":728,"_25651":726,"_5":25993,"_17922":44083,"_24317":44084,"_2462":44085},[],"/docs/pr-preview/pr-49/platform/concepts/architecture#control-plane","Control plane",{"_2936":729,"_25651":726,"_5":25993,"_17922":44087,"_24317":44088,"_2462":44089},[],"/docs/pr-preview/pr-49/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_2936":730,"_25651":726,"_5":25993,"_17922":44091,"_24317":44092,"_2462":44093},[],"/docs/pr-preview/pr-49/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_2936":731,"_25651":726,"_5":25993,"_17922":44095,"_24317":44096,"_2462":44097},[],"/docs/pr-preview/pr-49/platform/concepts/architecture#status-and-validation","Status and validation",{"_2936":732,"_25651":726,"_5":25993,"_17922":44099,"_24317":44100,"_2462":44101},[],"/docs/pr-preview/pr-49/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_2936":733,"_25651":726,"_17922":44103,"_5":17817,"_24317":726,"_2462":44104},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_2936":734,"_25651":726,"_17922":44106,"_5":17817,"_24317":726,"_2462":44107},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_2936":735,"_25651":726,"_17922":44109,"_5":17817,"_24317":44084,"_2462":44110},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_2936":736,"_25651":726,"_17922":44112,"_5":17817,"_24317":44088,"_2462":44113},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_2936":737,"_25651":726,"_17922":44115,"_5":17817,"_24317":44092,"_2462":44116},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_2936":738,"_25651":726,"_17922":44118,"_5":17817,"_24317":44096,"_2462":44119},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_2936":739,"_25651":726,"_17922":44121,"_5":17817,"_24317":44100,"_2462":44122},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_2936":740,"_25651":740,"_5":12587,"_2462":44124,"_25996":44125,"_17922":44126,"_24317":740},"How Lamassu works",[41832,43206],[],{"_2936":741,"_25651":740,"_17922":44128,"_5":17817,"_24317":740,"_2462":44129},[],"The mental model of trust, keys, certificates and devices.",{"_2936":742,"_25651":740,"_5":25993,"_17922":44131,"_24317":44132,"_2462":44133},[],"/docs/pr-preview/pr-49/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_2936":743,"_25651":740,"_5":25993,"_17922":44135,"_24317":44136,"_2462":44137},[],"/docs/pr-preview/pr-49/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_2936":744,"_25651":740,"_17922":44139,"_5":17817,"_24317":740,"_2462":44140},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_2936":745,"_25651":740,"_17922":44142,"_5":17817,"_24317":44132,"_2462":44143},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_2936":746,"_25651":740,"_17922":44145,"_5":17817,"_24317":44132,"_2462":44146},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_2936":747,"_25651":740,"_17922":44148,"_5":17817,"_24317":44132,"_2462":44149},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_2936":748,"_25651":740,"_17922":44151,"_5":17817,"_24317":44132,"_2462":44152},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_2936":749,"_25651":740,"_17922":44154,"_5":17817,"_24317":44132,"_2462":44155},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_2936":750,"_25651":740,"_17922":44157,"_5":17817,"_24317":44136,"_2462":44158},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_2936":751,"_25651":740,"_17922":44160,"_5":17817,"_24317":44136,"_2462":44161},[],"A DMS relates that CA to an enrollment policy.",{"_2936":752,"_25651":740,"_17922":44163,"_5":17817,"_24317":44136,"_2462":44164},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_2936":753,"_25651":740,"_17922":44166,"_5":17817,"_24317":44136,"_2462":44167},[],"Lamassu keeps the inventory, history and status of the identity.",{"_2936":754,"_25651":740,"_17922":44169,"_5":17817,"_24317":44136,"_2462":44170},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_2936":755,"_25651":740,"_17922":44172,"_5":17817,"_24317":44136,"_2462":44173},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_2936":756,"_25651":740,"_17922":44175,"_5":17817,"_24317":44136,"_2462":44176},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2936":757,"_25651":757,"_5":12587,"_2462":44178,"_25996":44179,"_17922":44181,"_24317":757},"Devices and identities",[41832,43206,44180,44178],"IoT Fleets",[],{"_2936":758,"_25651":757,"_17922":44183,"_5":17817,"_24317":757,"_2462":44184},[],"Register, inspect and retire devices while checking their current identity and history.",{"_2936":759,"_25651":757,"_5":25993,"_17922":44186,"_24317":44187,"_2462":44188},[],"/docs/pr-preview/pr-49/platform/iot-fleets/device-management#device-states","Device states",{"_2936":760,"_25651":757,"_5":25993,"_17922":44190,"_24317":44191,"_2462":44192},[],"/docs/pr-preview/pr-49/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_2936":761,"_25651":757,"_5":25993,"_17922":44194,"_24317":44195,"_2462":44196},[],"/docs/pr-preview/pr-49/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_2936":762,"_25651":757,"_5":25993,"_17922":44198,"_24317":44199,"_2462":44200},[],"/docs/pr-preview/pr-49/platform/iot-fleets/device-management#create-the-device","Create the device",{"_2936":763,"_25651":757,"_5":25993,"_17922":44202,"_24317":44203,"_2462":44204},[],"/docs/pr-preview/pr-49/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_2936":764,"_25651":757,"_5":25993,"_17922":44206,"_24317":44207,"_2462":44208},[],"/docs/pr-preview/pr-49/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_2936":765,"_25651":757,"_5":25993,"_17922":44210,"_24317":44211,"_2462":44212},[],"/docs/pr-preview/pr-49/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_2936":766,"_25651":757,"_5":25993,"_17922":44214,"_24317":44215,"_2462":44216},[],"/docs/pr-preview/pr-49/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_2936":767,"_25651":757,"_5":25993,"_17922":44218,"_24317":44219,"_2462":44220},[],"/docs/pr-preview/pr-49/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_2936":768,"_25651":757,"_5":25993,"_17922":44222,"_24317":44223,"_2462":44224},[],"/docs/pr-preview/pr-49/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_2936":769,"_25651":757,"_5":25993,"_17922":44226,"_24317":44227,"_2462":44228},[],"/docs/pr-preview/pr-49/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_2936":770,"_25651":757,"_17922":44230,"_5":17817,"_24317":757,"_2462":44231},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_2936":771,"_25651":757,"_17922":44233,"_5":17817,"_24317":757,"_2462":44234},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_2936":772,"_25651":757,"_17922":44236,"_5":17817,"_24317":44187,"_2462":44237},[],"Operational view",{"_2936":773,"_25651":757,"_17922":44239,"_5":17817,"_24317":44187,"_2462":44240},[],"Meaning",{"_2936":774,"_25651":757,"_17922":44242,"_5":17817,"_24317":44187,"_2462":44243},[],"**No Identity**",{"_2936":775,"_25651":757,"_17922":44245,"_5":17817,"_24317":44187,"_2462":44246},[],"A record exists without an associated identity.",{"_2936":776,"_25651":757,"_17922":44248,"_5":17817,"_24317":44187,"_2462":44249},[],"**Active**",{"_2936":777,"_25651":757,"_17922":44251,"_5":17817,"_24317":44187,"_2462":44252},[],"The slot is active; also check certificate dates, status and usages.",{"_2936":778,"_25651":757,"_17922":44254,"_5":17817,"_24317":44187,"_2462":44255},[],"**Renewal Pending**",{"_2936":779,"_25651":757,"_17922":44257,"_5":17817,"_24317":44187,"_2462":44258},[],"The identity is in the operational renewal window.",{"_2936":780,"_25651":757,"_17922":44260,"_5":17817,"_24317":44187,"_2462":44261},[],"**Expiring Soon**",{"_2936":781,"_25651":757,"_17922":44263,"_5":17817,"_24317":44187,"_2462":44264},[],"Expiration is approaching according to configured thresholds.",{"_2936":782,"_25651":757,"_17922":44266,"_5":17817,"_24317":44187,"_2462":44267},[],"**Expired**",{"_2936":783,"_25651":757,"_17922":44269,"_5":17817,"_24317":44187,"_2462":44270},[],"The identity has expired.",{"_2936":784,"_25651":757,"_17922":44272,"_5":17817,"_24317":44187,"_2462":44273},[],"**Revoked**",{"_2936":785,"_25651":757,"_17922":44275,"_5":17817,"_24317":44187,"_2462":44276},[],"The identity is marked revoked.",{"_2936":786,"_25651":757,"_17922":44278,"_5":17817,"_24317":44187,"_2462":44279},[],"**Decommissioned**",{"_2936":787,"_25651":757,"_17922":44281,"_5":17817,"_24317":44187,"_2462":44282},[],"The record is retired and ordinary updates do not restore operation.",{"_2936":788,"_25651":757,"_17922":44284,"_5":17817,"_24317":44187,"_2462":44285},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_2936":789,"_25651":757,"_17922":44287,"_5":17817,"_24317":44191,"_2462":44288},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_2936":790,"_25651":757,"_17922":44290,"_5":17817,"_24317":44191,"_2462":44291},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_2936":791,"_25651":757,"_17922":44293,"_5":17817,"_24317":44191,"_2462":44294},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_2936":792,"_25651":757,"_17922":44296,"_5":17817,"_24317":44191,"_2462":44297},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_2936":793,"_25651":757,"_17922":44299,"_5":17817,"_24317":44195,"_2462":44300},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_2936":794,"_25651":757,"_17922":44302,"_5":17817,"_24317":44199,"_2462":44303},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_2936":795,"_25651":757,"_17922":44305,"_5":17817,"_24317":44203,"_2462":44306},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_2936":796,"_25651":757,"_17922":44308,"_5":17817,"_24317":44207,"_2462":44309},[],"Add model, environment or location tags and an icon according to your inventory.",{"_2936":797,"_25651":757,"_17922":44311,"_5":17817,"_24317":44211,"_2462":44312},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_2936":798,"_25651":757,"_17922":44314,"_5":17817,"_24317":44211,"_2462":44315},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_2936":799,"_25651":757,"_17922":44317,"_5":17817,"_24317":44215,"_2462":44318},[],"From **No Identity**, use **Assign Identity**:",{"_2936":800,"_25651":757,"_17922":44320,"_5":17817,"_24317":44215,"_2462":44321},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_2936":801,"_25651":757,"_17922":44323,"_5":17817,"_24317":44215,"_2462":44324},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_2936":802,"_25651":757,"_17922":44326,"_5":17817,"_24317":44215,"_2462":44327},[],"Confirm and read the serial, active version and history again.",{"_2936":803,"_25651":757,"_17922":44329,"_5":17817,"_24317":44215,"_2462":44330},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_2936":804,"_25651":757,"_17922":44332,"_5":17817,"_24317":44215,"_2462":44333},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_2936":805,"_25651":757,"_17922":44335,"_5":17817,"_24317":44219,"_2462":44336},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_2936":806,"_25651":757,"_17922":44338,"_5":17817,"_24317":44219,"_2462":44339},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_2936":807,"_25651":757,"_17922":44341,"_5":17817,"_24317":44223,"_2462":44342},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_2936":808,"_25651":757,"_17922":44344,"_5":17817,"_24317":44223,"_2462":44345},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_2936":809,"_25651":757,"_17922":44347,"_5":17817,"_24317":44223,"_2462":44348},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_2936":810,"_25651":757,"_17922":44350,"_5":17817,"_24317":44223,"_2462":44351},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_2936":811,"_25651":757,"_17922":44353,"_5":17817,"_24317":44227,"_2462":44354},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2936":812,"_25651":757,"_17922":44356,"_5":17817,"_24317":44227,"_2462":44357},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2936":813,"_25651":813,"_5":12587,"_2462":44359,"_25996":44360,"_17922":44362,"_24317":813},"Bootstrap identity and authentication",[41832,43206,44180,44178,44361],"Enrollment with PKI",[],{"_2936":814,"_25651":813,"_17922":44364,"_5":17817,"_24317":813,"_2462":44365},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_2936":815,"_25651":813,"_5":25993,"_17922":44367,"_24317":44368,"_2462":44369},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_2936":816,"_25651":813,"_5":25993,"_17922":44371,"_24317":44372,"_2462":44373},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_2936":817,"_25651":813,"_5":25993,"_17922":44375,"_24317":44376,"_2462":44377},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_2936":818,"_25651":813,"_5":25993,"_17922":44379,"_24317":44380,"_2462":44381},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_2936":819,"_25651":813,"_5":25993,"_17922":44383,"_24317":44384,"_2462":44385},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_2936":820,"_25651":813,"_17922":44387,"_5":17817,"_24317":813,"_2462":44388},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_2936":821,"_25651":813,"_17922":44390,"_5":17817,"_24317":44368,"_2462":44391},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_2936":822,"_25651":813,"_17922":44393,"_5":17817,"_24317":44368,"_2462":44394},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_2936":823,"_25651":813,"_17922":44396,"_5":17817,"_24317":44372,"_2462":44397},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_2936":824,"_25651":813,"_17922":44399,"_5":17817,"_24317":44372,"_2462":44400},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_2936":825,"_25651":813,"_17922":44402,"_5":17817,"_24317":44372,"_2462":44403},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_2936":826,"_25651":813,"_17922":44405,"_5":17817,"_24317":44376,"_2462":44406},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_2936":827,"_25651":813,"_17922":44408,"_5":17817,"_24317":44376,"_2462":44409},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_2936":828,"_25651":813,"_17922":44411,"_5":17817,"_24317":44380,"_2462":44412},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_2936":829,"_25651":813,"_17922":44414,"_5":17817,"_24317":44380,"_2462":44415},[],"Example body:",{"_2936":830,"_25651":813,"_17922":44417,"_5":17817,"_24317":44380,"_2462":44418},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_2936":831,"_25651":813,"_17922":44420,"_5":17817,"_24317":44380,"_2462":44421},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_2936":832,"_25651":813,"_17922":44423,"_5":17817,"_24317":44380,"_2462":44424},[],"Continuation requires a successful HTTP response and JSON:",{"_2936":833,"_25651":813,"_17922":44426,"_5":17817,"_24317":44380,"_2462":44427},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_2936":834,"_25651":813,"_17922":44429,"_5":17817,"_24317":44384,"_2462":44430},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_2936":835,"_25651":813,"_17922":44432,"_5":17817,"_24317":44384,"_2462":44433},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_2936":836,"_25651":836,"_5":12587,"_2462":44435,"_25996":44436,"_17922":44437,"_24317":836},"Configure and operate the DMS",[41832,43206,44180,44178,44361],[],{"_2936":837,"_25651":836,"_17922":44439,"_5":17817,"_24317":836,"_2462":44440},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_2936":838,"_25651":836,"_5":25993,"_17922":44442,"_24317":44443,"_2462":41842},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/dms#before-you-begin",{"_2936":839,"_25651":836,"_5":25993,"_17922":44445,"_24317":44446,"_2462":44447},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_2936":840,"_25651":836,"_5":25993,"_17922":44449,"_24317":44450,"_2462":44451},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_2936":841,"_25651":836,"_5":25993,"_17922":44453,"_24317":44454,"_2462":44455},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_2936":842,"_25651":836,"_5":25993,"_17922":44457,"_24317":44458,"_2462":44459},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_2936":843,"_25651":836,"_5":25993,"_17922":44461,"_24317":44462,"_2462":44463},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_2936":844,"_25651":836,"_5":25993,"_17922":44465,"_24317":44466,"_2462":44467},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_2936":845,"_25651":836,"_5":25993,"_17922":44469,"_24317":44470,"_2462":44471},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_2936":846,"_25651":836,"_5":25993,"_17922":44473,"_24317":44474,"_2462":44475},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_2936":847,"_25651":836,"_5":25993,"_17922":44477,"_24317":44478,"_2462":44479},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_2936":848,"_25651":836,"_5":25993,"_17922":44481,"_24317":44482,"_2462":44483},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_2936":849,"_25651":836,"_5":25993,"_17922":44485,"_24317":44486,"_2462":44487},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_2936":850,"_25651":836,"_5":25993,"_17922":44489,"_24317":44490,"_2462":44491},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_2936":851,"_25651":836,"_5":25993,"_17922":44493,"_24317":44494,"_2462":44495},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_2936":852,"_25651":836,"_5":25993,"_17922":44497,"_24317":44498,"_2462":44499},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_2936":853,"_25651":836,"_5":25993,"_17922":44501,"_24317":44502,"_2462":44503},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_2936":854,"_25651":836,"_5":25993,"_17922":44505,"_24317":44506,"_2462":44507},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_2936":855,"_25651":836,"_5":25993,"_17922":44509,"_24317":44510,"_2462":44511},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_2936":856,"_25651":836,"_17922":44513,"_5":17817,"_24317":836,"_2462":44514},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_2936":857,"_25651":836,"_17922":44516,"_5":17817,"_24317":44443,"_2462":44517},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_2936":858,"_25651":836,"_17922":44519,"_5":17817,"_24317":44443,"_2462":44520},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_2936":859,"_25651":836,"_17922":44522,"_5":17817,"_24317":44450,"_2462":44523},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_2936":860,"_25651":836,"_17922":44525,"_5":17817,"_24317":44454,"_2462":44526},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_2936":861,"_25651":836,"_17922":44528,"_5":17817,"_24317":44458,"_2462":44529},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_2936":862,"_25651":836,"_17922":44531,"_5":17817,"_24317":44462,"_2462":44532},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_2936":863,"_25651":836,"_17922":44534,"_5":17817,"_24317":44466,"_2462":44535},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_2936":864,"_25651":836,"_17922":44537,"_5":17817,"_24317":44474,"_2462":44538},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_2936":865,"_25651":836,"_17922":44540,"_5":17817,"_24317":44474,"_2462":44541},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_2936":866,"_25651":836,"_17922":44543,"_5":17817,"_24317":44478,"_2462":44544},[],"`settings.enrollment_settings` field",{"_2936":867,"_25651":836,"_17922":44546,"_5":17817,"_24317":44478,"_2462":44547},[],"Decision",{"_2936":868,"_25651":836,"_17922":44549,"_5":17817,"_24317":44478,"_2462":44550},[],"`protocol`",{"_2936":869,"_25651":836,"_17922":44552,"_5":17817,"_24317":44478,"_2462":44553},[],"`EST_RFC7030` for these operations.",{"_2936":870,"_25651":836,"_17922":44555,"_5":17817,"_24317":44478,"_2462":44556},[],"`enrollment_ca`",{"_2936":871,"_25651":836,"_17922":44558,"_5":17817,"_24317":44478,"_2462":44559},[],"ID of the signing CA.",{"_2936":872,"_25651":836,"_17922":44561,"_5":17817,"_24317":44478,"_2462":44562},[],"`verify_csr_signature`",{"_2936":873,"_25651":836,"_17922":44564,"_5":17817,"_24317":44478,"_2462":44565},[],"Keep `true` to verify CSR key possession.",{"_2936":874,"_25651":836,"_17922":44567,"_5":17817,"_24317":44478,"_2462":44568},[],"`enable_replaceable_enrollment`",{"_2936":875,"_25651":836,"_17922":44570,"_5":17817,"_24317":44478,"_2462":44571},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_2936":876,"_25651":836,"_17922":44573,"_5":17817,"_24317":44478,"_2462":44574},[],"`est_rfc7030_settings.auth_mode`",{"_2936":877,"_25651":836,"_17922":44576,"_5":17817,"_24317":44478,"_2462":44577},[],"One of the four authentication modes.",{"_2936":878,"_25651":836,"_17922":44579,"_5":17817,"_24317":44478,"_2462":44580},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_2936":879,"_25651":836,"_17922":44582,"_5":17817,"_24317":44482,"_2462":44583},[],"The blocks are independent:",{"_2936":880,"_25651":836,"_17922":44585,"_5":17817,"_24317":44482,"_2462":44586},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_2936":881,"_25651":836,"_17922":44588,"_5":17817,"_24317":44482,"_2462":44589},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_2936":882,"_25651":836,"_17922":44591,"_5":17817,"_24317":44482,"_2462":44592},[],"`auth_mode`",{"_2936":883,"_25651":836,"_17922":44594,"_5":17817,"_24317":44482,"_2462":44595},[],"Control applied in the configured operation",{"_2936":884,"_25651":836,"_17922":44597,"_5":17817,"_24317":44482,"_2462":44598},[],"`CLIENT_CERTIFICATE`",{"_2936":885,"_25651":836,"_17922":44600,"_5":17817,"_24317":44482,"_2462":44601},[],"Presented certificate validation.",{"_2936":886,"_25651":836,"_17922":44603,"_5":17817,"_24317":44482,"_2462":44604},[],"`EXTERNAL_WEBHOOK`",{"_2936":887,"_25651":836,"_17922":44606,"_5":17817,"_24317":44482,"_2462":44607},[],"Configured webhook authorization.",{"_2936":888,"_25651":836,"_17922":44609,"_5":17817,"_24317":44482,"_2462":44610},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_2936":889,"_25651":836,"_17922":44612,"_5":17817,"_24317":44482,"_2462":44613},[],"Certificate validation followed by webhook approval.",{"_2936":890,"_25651":836,"_17922":44615,"_5":17817,"_24317":44482,"_2462":44616},[],"`NO_AUTH`",{"_2936":891,"_25651":836,"_17922":44618,"_5":17817,"_24317":44482,"_2462":44619},[],"No DMS requester authentication.",{"_2936":892,"_25651":836,"_17922":44621,"_5":17817,"_24317":44482,"_2462":44622},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_2936":893,"_25651":836,"_17922":44624,"_5":17817,"_24317":44482,"_2462":44625},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_2936":894,"_25651":836,"_17922":44627,"_5":17817,"_24317":44482,"_2462":44628},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_2936":895,"_25651":836,"_17922":44630,"_5":17817,"_24317":44482,"_2462":44631},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_2936":896,"_25651":836,"_17922":44633,"_5":17817,"_24317":44486,"_2462":44634},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_2936":897,"_25651":836,"_17922":44636,"_5":17817,"_24317":44486,"_2462":44637},[],"`external_webhook_settings` field",{"_2936":898,"_25651":836,"_17922":44639,"_5":17817,"_24317":44486,"_2462":44547},[],{"_2936":899,"_25651":836,"_17922":44641,"_5":17817,"_24317":44486,"_2462":44642},[],"`url`",{"_2936":900,"_25651":836,"_17922":44644,"_5":17817,"_24317":44486,"_2462":44645},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_2936":901,"_25651":836,"_17922":44647,"_5":17817,"_24317":44486,"_2462":44648},[],"`method`",{"_2936":902,"_25651":836,"_17922":44650,"_5":17817,"_24317":44486,"_2462":44651},[],"`POST` or `PUT`; `POST` by default.",{"_2936":903,"_25651":836,"_17922":44653,"_5":17817,"_24317":44486,"_2462":44654},[],"`name`",{"_2936":904,"_25651":836,"_17922":44656,"_5":17817,"_24317":44486,"_2462":44657},[],"Label used in service logs.",{"_2936":905,"_25651":836,"_17922":44659,"_5":17817,"_24317":44486,"_2462":44660},[],"`config.auth_mode`",{"_2936":906,"_25651":836,"_17922":44662,"_5":17817,"_24317":44486,"_2462":44663},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_2936":907,"_25651":836,"_17922":44665,"_5":17817,"_24317":44486,"_2462":44666},[],"`config.apikey_options`",{"_2936":908,"_25651":836,"_17922":44668,"_5":17817,"_24317":44486,"_2462":44669},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_2936":909,"_25651":836,"_17922":44671,"_5":17817,"_24317":44486,"_2462":44672},[],"`config.jwt_options`",{"_2936":910,"_25651":836,"_17922":44674,"_5":17817,"_24317":44486,"_2462":44675},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_2936":911,"_25651":836,"_17922":44677,"_5":17817,"_24317":44486,"_2462":44678},[],"`config.mtls_options`",{"_2936":912,"_25651":836,"_17922":44680,"_5":17817,"_24317":44486,"_2462":44681},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_2936":913,"_25651":836,"_17922":44683,"_5":17817,"_24317":44486,"_2462":44684},[],"`config.insecure_skip_verify`",{"_2936":914,"_25651":836,"_17922":44686,"_5":17817,"_24317":44486,"_2462":44687},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_2936":915,"_25651":836,"_17922":44689,"_5":17817,"_24317":44486,"_2462":44690},[],"`config.call_timeout`",{"_2936":916,"_25651":836,"_17922":44692,"_5":17817,"_24317":44486,"_2462":44693},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_2936":917,"_25651":836,"_17922":44695,"_5":17817,"_24317":44486,"_2462":44696},[],"Rules for that configuration:",{"_2936":918,"_25651":836,"_17922":44698,"_5":17817,"_24317":44486,"_2462":44699},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_2936":919,"_25651":836,"_17922":44701,"_5":17817,"_24317":44486,"_2462":44702},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_2936":920,"_25651":836,"_17922":44704,"_5":17817,"_24317":44486,"_2462":44705},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_2936":921,"_25651":836,"_17922":44707,"_5":17817,"_24317":44486,"_2462":44708},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_2936":922,"_25651":836,"_17922":44710,"_5":17817,"_24317":44486,"_2462":44711},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_2936":923,"_25651":836,"_17922":44713,"_5":17817,"_24317":44486,"_2462":44714},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_2936":924,"_25651":836,"_17922":44716,"_5":17817,"_24317":44486,"_2462":44717},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing, and if your version's console does not expose independent settings, use the DMS API.",{"_2936":925,"_25651":836,"_17922":44719,"_5":17817,"_24317":44486,"_2462":44720},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_2936":926,"_25651":836,"_17922":44722,"_5":17817,"_24317":44486,"_2462":44723},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_2936":927,"_25651":836,"_17922":44725,"_5":17817,"_24317":44490,"_2462":44726},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_2936":928,"_25651":836,"_17922":44728,"_5":17817,"_24317":44494,"_2462":44729},[],"`settings.reenrollment_settings` field",{"_2936":929,"_25651":836,"_17922":44731,"_5":17817,"_24317":44494,"_2462":42219},[],{"_2936":930,"_25651":836,"_17922":44733,"_5":17817,"_24317":44494,"_2462":44734},[],"`reenrollment_delta`",{"_2936":931,"_25651":836,"_17922":44736,"_5":17817,"_24317":44494,"_2462":44737},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_2936":932,"_25651":836,"_17922":44739,"_5":17817,"_24317":44494,"_2462":44740},[],"`preventive_delta`",{"_2936":933,"_25651":836,"_17922":44742,"_5":17817,"_24317":44494,"_2462":44743},[],"Preventive operational monitoring threshold.",{"_2936":934,"_25651":836,"_17922":44745,"_5":17817,"_24317":44494,"_2462":44746},[],"`critical_delta`",{"_2936":935,"_25651":836,"_17922":44748,"_5":17817,"_24317":44494,"_2462":44749},[],"Critical operational monitoring threshold.",{"_2936":936,"_25651":836,"_17922":44751,"_5":17817,"_24317":44494,"_2462":44752},[],"`enable_expired_renewal`",{"_2936":937,"_25651":836,"_17922":44754,"_5":17817,"_24317":44494,"_2462":44755},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_2936":938,"_25651":836,"_17922":44757,"_5":17817,"_24317":44494,"_2462":44758},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_2936":939,"_25651":836,"_17922":44760,"_5":17817,"_24317":44494,"_2462":44761},[],"Additional validation CAs for the renewal mTLS credential, tried after the enrollment CA; typically populated during CA rotation while old-CA cohorts renew.",{"_2936":940,"_25651":836,"_17922":44763,"_5":17817,"_24317":44494,"_2462":44764},[],"`revoke_on_reenrollment`",{"_2936":941,"_25651":836,"_17922":44766,"_5":17817,"_24317":44494,"_2462":44767},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_2936":942,"_25651":836,"_17922":44769,"_5":17817,"_24317":44494,"_2462":44770},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_2936":943,"_25651":836,"_17922":44772,"_5":17817,"_24317":44498,"_2462":44773},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. Algorithm and size come from its `key` field; the profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_2936":944,"_25651":836,"_17922":44775,"_5":17817,"_24317":44502,"_2462":42213},[],{"_2936":945,"_25651":836,"_17922":44777,"_5":17817,"_24317":44502,"_2462":44778},[],"Published material",{"_2936":946,"_25651":836,"_17922":44780,"_5":17817,"_24317":44502,"_2462":44781},[],"**Include Lamassu System CA**",{"_2936":947,"_25651":836,"_17922":44783,"_5":17817,"_24317":44502,"_2462":44784},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_2936":948,"_25651":836,"_17922":44786,"_5":17817,"_24317":44502,"_2462":44787},[],"**Include Enrollment CA**",{"_2936":949,"_25651":836,"_17922":44789,"_5":17817,"_24317":44502,"_2462":44790},[],"Selected issuing CA certificate.",{"_2936":950,"_25651":836,"_17922":44792,"_5":17817,"_24317":44502,"_2462":44793},[],"**Managed CAs**",{"_2936":951,"_25651":836,"_17922":44795,"_5":17817,"_24317":44502,"_2462":44796},[],"Explicitly selected CA certificates.",{"_2936":952,"_25651":836,"_17922":44798,"_5":17817,"_24317":44502,"_2462":44799},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_2936":953,"_25651":836,"_17922":44801,"_5":17817,"_24317":44506,"_2462":44802},[],"**Edit** changes name, settings and metadata. Backend updates replace these complete blocks; read the DMS before sending API edits to avoid losing fields.",{"_2936":954,"_25651":836,"_17922":44804,"_5":17817,"_24317":44506,"_2462":44805},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_2936":955,"_25651":836,"_17922":44807,"_5":17817,"_24317":44506,"_2462":44808},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_2936":956,"_25651":836,"_17922":44810,"_5":17817,"_24317":44510,"_2462":44811},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_2936":957,"_25651":957,"_5":12587,"_2462":44813,"_25996":44814,"_17922":44815,"_24317":957},"Integrate the EST client",[41832,43206,44180,44178,44361],[],{"_2936":958,"_25651":957,"_17922":44817,"_5":17817,"_24317":957,"_2462":44818},[],"Prepare trust, send a CSR and check the identity you receive.",{"_2936":959,"_25651":957,"_5":25993,"_17922":44820,"_24317":44821,"_2462":41842},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_2936":960,"_25651":957,"_5":25993,"_17922":44823,"_24317":44824,"_2462":44825},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_2936":961,"_25651":957,"_5":25993,"_17922":44827,"_24317":44828,"_2462":44829},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_2936":962,"_25651":957,"_5":25993,"_17922":44831,"_24317":44832,"_2462":44833},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_2936":963,"_25651":957,"_5":25993,"_17922":44835,"_24317":44836,"_2462":44837},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_2936":964,"_25651":957,"_5":25993,"_17922":44839,"_24317":44840,"_2462":44841},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_2936":965,"_25651":957,"_17922":44843,"_5":17817,"_24317":957,"_2462":44844},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_2936":966,"_25651":957,"_17922":44846,"_5":17817,"_24317":44821,"_2462":44847},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_2936":967,"_25651":957,"_17922":44849,"_5":17817,"_24317":44821,"_2462":44850},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_2936":968,"_25651":957,"_17922":44852,"_5":17817,"_24317":44821,"_2462":44853},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_2936":969,"_25651":957,"_17922":44855,"_5":17817,"_24317":44824,"_2462":44856},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_2936":970,"_25651":957,"_17922":44858,"_5":17817,"_24317":44824,"_2462":44859},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_2936":971,"_25651":957,"_17922":44861,"_5":17817,"_24317":44828,"_2462":44862},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_2936":972,"_25651":957,"_17922":44864,"_5":17817,"_24317":44828,"_2462":44865},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_2936":973,"_25651":957,"_17922":44867,"_5":17817,"_24317":44832,"_2462":44868},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_2936":974,"_25651":957,"_17922":44870,"_5":17817,"_24317":44832,"_2462":44871},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_2936":975,"_25651":957,"_17922":44873,"_5":17817,"_24317":44836,"_2462":44874},[],"For a root that issues directly:",{"_2936":976,"_25651":957,"_17922":44876,"_5":17817,"_24317":44836,"_2462":44877},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_2936":977,"_25651":957,"_17922":44879,"_5":17817,"_24317":44836,"_2462":44880},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_2936":978,"_25651":957,"_17922":44882,"_5":17817,"_24317":44840,"_2462":44883},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_2936":979,"_25651":979,"_5":12587,"_2462":44885,"_25996":44886,"_17922":44887,"_24317":979},"EST reference",[41832,43206,44180,44178,44361],[],{"_2936":980,"_25651":979,"_17922":44889,"_5":17817,"_24317":979,"_2462":44890},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_2936":981,"_25651":979,"_5":25993,"_17922":44892,"_24317":44893,"_2462":44894},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_2936":982,"_25651":979,"_5":25993,"_17922":44896,"_24317":44897,"_2462":19471},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2936":983,"_25651":979,"_5":25993,"_17922":44899,"_24317":44900,"_2462":22288},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2936":984,"_25651":979,"_5":25993,"_17922":44902,"_24317":44903,"_2462":22295},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2936":985,"_25651":979,"_5":25993,"_17922":44905,"_24317":44906,"_2462":21654},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2936":986,"_25651":979,"_5":25993,"_17922":44908,"_24317":44909,"_2462":44910},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_2936":987,"_25651":979,"_5":25993,"_17922":44912,"_24317":44913,"_2462":44914},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_2936":988,"_25651":979,"_5":25993,"_17922":44916,"_24317":44917,"_2462":44918},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_2936":989,"_25651":979,"_17922":44920,"_5":17817,"_24317":979,"_2462":44921},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_2936":990,"_25651":979,"_17922":44923,"_5":17817,"_24317":44893,"_2462":44924},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_2936":991,"_25651":979,"_17922":44926,"_5":17817,"_24317":44893,"_2462":44927},[],"Operation",{"_2936":992,"_25651":979,"_17922":44929,"_5":17817,"_24317":44893,"_2462":44930},[],"Method",{"_2936":993,"_25651":979,"_17922":44932,"_5":17817,"_24317":44893,"_2462":44933},[],"Authentication and condition",{"_2936":994,"_25651":979,"_17922":44935,"_5":17817,"_24317":44893,"_2462":44936},[],"`/cacerts`",{"_2936":995,"_25651":979,"_17922":44938,"_5":17817,"_24317":44893,"_2462":44939},[],"GET",{"_2936":996,"_25651":979,"_17922":44941,"_5":17817,"_24317":44893,"_2462":44942},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_2936":997,"_25651":979,"_17922":44944,"_5":17817,"_24317":44893,"_2462":44945},[],"`/simpleenroll`",{"_2936":998,"_25651":979,"_17922":44947,"_5":17817,"_24317":44893,"_2462":44948},[],"POST",{"_2936":999,"_25651":979,"_17922":44950,"_5":17817,"_24317":44893,"_2462":44951},[],"Initial authentication and DMS registration/replacement policy.",{"_2936":1000,"_25651":979,"_17922":44953,"_5":17817,"_24317":44893,"_2462":44954},[],"`/simplereenroll`",{"_2936":1001,"_25651":979,"_17922":44956,"_5":17817,"_24317":44893,"_2462":44948},[],{"_2936":1002,"_25651":979,"_17922":44958,"_5":17817,"_24317":44893,"_2462":44959},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_2936":1003,"_25651":979,"_17922":44961,"_5":17817,"_24317":44893,"_2462":44962},[],"`/serverkeygen`",{"_2936":1004,"_25651":979,"_17922":44964,"_5":17817,"_24317":44893,"_2462":44948},[],{"_2936":1005,"_25651":979,"_17922":44966,"_5":17817,"_24317":44893,"_2462":44967},[],"Initial authentication and admission; server generation enabled.",{"_2936":1006,"_25651":979,"_17922":44969,"_5":17817,"_24317":44893,"_2462":44970},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_2936":1007,"_25651":979,"_17922":44972,"_5":17817,"_24317":44897,"_2462":44973},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_2936":1008,"_25651":979,"_17922":44975,"_5":17817,"_24317":44897,"_2462":44976},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_2936":1009,"_25651":979,"_17922":44978,"_5":17817,"_24317":44900,"_2462":44979},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_2936":1010,"_25651":979,"_17922":44981,"_5":17817,"_24317":44900,"_2462":44982},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_2936":1011,"_25651":979,"_17922":44984,"_5":17817,"_24317":44903,"_2462":44985},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_2936":1012,"_25651":979,"_17922":44987,"_5":17817,"_24317":44903,"_2462":44988},[],"The enrollment CA or a validation CA configured in the re-enrollment block validates the credential in mTLS mode. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_2936":1013,"_25651":979,"_17922":44990,"_5":17817,"_24317":44906,"_2462":44991},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_2936":1014,"_25651":979,"_17922":44993,"_5":17817,"_24317":44906,"_2462":44994},[],"The code supports RSA and ECDSA with 224, 256, 384 or 521 bits. An unrecognized ECDSA size can fall back to 256; explicitly select a compatible size and check the resulting key. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_2936":1015,"_25651":979,"_17922":44996,"_5":17817,"_24317":44909,"_2462":44997},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_2936":1016,"_25651":979,"_17922":44999,"_5":17817,"_24317":44909,"_2462":45000},[],"Part",{"_2936":1017,"_25651":979,"_17922":45002,"_5":17817,"_24317":44909,"_2462":45003},[],"Content after decoding its Base64",{"_2936":1018,"_25651":979,"_17922":45005,"_5":17817,"_24317":44909,"_2462":45006},[],"`application/pkcs8`",{"_2936":1019,"_25651":979,"_17922":45008,"_5":17817,"_24317":44909,"_2462":45009},[],"Unencrypted DER PKCS#8 private key.",{"_2936":1020,"_25651":979,"_17922":45011,"_5":17817,"_24317":44909,"_2462":45012},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_2936":1021,"_25651":979,"_17922":45014,"_5":17817,"_24317":44909,"_2462":45015},[],"DER PKCS#7 containing the issued certificate.",{"_2936":1022,"_25651":979,"_17922":45017,"_5":17817,"_24317":44909,"_2462":45018},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_2936":1023,"_25651":979,"_17922":45020,"_5":17817,"_24317":44913,"_2462":45021},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_2936":1024,"_25651":979,"_17922":45023,"_5":17817,"_24317":44913,"_2462":45024},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_2936":1025,"_25651":979,"_17922":45026,"_5":17817,"_24317":44913,"_2462":45027},[],"Convert and check the result:",{"_2936":1026,"_25651":979,"_17922":45029,"_5":17817,"_24317":44913,"_2462":45030},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_2936":1027,"_25651":979,"_17922":45032,"_5":17817,"_24317":44917,"_2462":45033},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_2936":1028,"_25651":979,"_17922":45035,"_5":17817,"_24317":44917,"_2462":45036},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_2936":1029,"_25651":1029,"_5":12587,"_2462":44361,"_25996":45038,"_17922":45039,"_24317":1029},[41832,43206,44180,44178,44361],[],{"_2936":1030,"_25651":1029,"_17922":45041,"_5":17817,"_24317":1029,"_2462":45042},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_2936":1031,"_25651":1029,"_5":25993,"_17922":45044,"_24317":45045,"_2462":45046},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_2936":1032,"_25651":1029,"_5":25993,"_17922":45048,"_24317":45049,"_2462":45050},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_2936":1033,"_25651":1029,"_5":25993,"_17922":45052,"_24317":45053,"_2462":45054},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_2936":1034,"_25651":1029,"_5":25993,"_17922":45056,"_24317":45057,"_2462":45058},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_2936":1035,"_25651":1029,"_17922":45060,"_5":17817,"_24317":1029,"_2462":45061},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_2936":1036,"_25651":1029,"_17922":45063,"_5":17817,"_24317":45045,"_2462":45064},[],"The administrator prepares the CA, issuance profile and DMS.",{"_2936":1037,"_25651":1029,"_17922":45066,"_5":17817,"_24317":45045,"_2462":45067},[],"The integrator installs initial EST server trust and an admission credential.",{"_2936":1038,"_25651":1029,"_17922":45069,"_5":17817,"_24317":45045,"_2462":45070},[],"The client requests an identity for its `Device ID` through EST.",{"_2936":1039,"_25651":1029,"_17922":45072,"_5":17817,"_24317":45045,"_2462":45073},[],"Certificate, device binding and key/certificate installation are checked.",{"_2936":1040,"_25651":1029,"_17922":45075,"_5":17817,"_24317":45045,"_2462":45076},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_2936":1041,"_25651":1029,"_17922":45078,"_5":17817,"_24317":45045,"_2462":45079},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_2936":1042,"_25651":1029,"_17922":45081,"_5":17817,"_24317":45049,"_2462":45082},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2936":1043,"_25651":1029,"_17922":45084,"_5":17817,"_24317":45049,"_2462":45085},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2936":1044,"_25651":1029,"_17922":45087,"_5":17817,"_24317":45049,"_2462":45088},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2936":1045,"_25651":1029,"_17922":45090,"_5":17817,"_24317":45049,"_2462":45091},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2936":1046,"_25651":1029,"_17922":45093,"_5":17817,"_24317":45053,"_2462":45094},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2936":1047,"_25651":1029,"_17922":45096,"_5":17817,"_24317":45053,"_2462":45097},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2936":1048,"_25651":1029,"_17922":45099,"_5":17817,"_24317":45053,"_2462":45100},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2936":1049,"_25651":1029,"_17922":45102,"_5":17817,"_24317":45053,"_2462":45103},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2936":1050,"_25651":1029,"_17922":45105,"_5":17817,"_24317":45057,"_2462":45106},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_2936":1051,"_25651":1029,"_17922":45108,"_5":17817,"_24317":45057,"_2462":45109},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_2936":1052,"_25651":1052,"_5":12587,"_2462":45111,"_25996":45112,"_17922":45113,"_24317":1052},"Provisioning strategies",[41832,43206,44180,44178,44361],[],{"_2936":1053,"_25651":1052,"_17922":45115,"_5":17817,"_24317":1052,"_2462":45116},[],"Choose device registration, identity authorization and key generation.",{"_2936":1054,"_25651":1052,"_5":25993,"_17922":45118,"_24317":45119,"_2462":45120},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_2936":1055,"_25651":1052,"_5":25993,"_17922":45122,"_24317":45123,"_2462":45124},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_2936":1056,"_25651":1052,"_5":25993,"_17922":45126,"_24317":45127,"_2462":45128},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_2936":1057,"_25651":1052,"_5":25993,"_17922":45130,"_24317":45131,"_2462":45132},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_2936":1058,"_25651":1052,"_5":25993,"_17922":45134,"_24317":45135,"_2462":45136},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_2936":1059,"_25651":1052,"_17922":45138,"_5":17817,"_24317":1052,"_2462":45139},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_2936":1060,"_25651":1052,"_17922":45141,"_5":17817,"_24317":45119,"_2462":45142},[],"Path",{"_2936":1061,"_25651":1052,"_17922":45144,"_5":17817,"_24317":45119,"_2462":45145},[],"When the device exists",{"_2936":1062,"_25651":1052,"_17922":45147,"_5":17817,"_24317":45119,"_2462":45148},[],"What to check",{"_2936":1063,"_25651":1052,"_17922":45150,"_5":17817,"_24317":45119,"_2462":45151},[],"Manual assignment",{"_2936":1064,"_25651":1052,"_17922":45153,"_5":17817,"_24317":45119,"_2462":45154},[],"An operator creates it before associating a certificate.",{"_2936":1065,"_25651":1052,"_17922":45156,"_5":17817,"_24317":45119,"_2462":45157},[],"ID, owning DMS, certificate CN and bound serial.",{"_2936":1066,"_25651":1052,"_17922":45159,"_5":17817,"_24317":45119,"_2462":45160},[],"EST with `JITP`",{"_2936":1067,"_25651":1052,"_17922":45162,"_5":17817,"_24317":45119,"_2462":45163},[],"Created for an unknown CN during `/simpleenroll`.",{"_2936":1068,"_25651":1052,"_17922":45165,"_5":17817,"_24317":45119,"_2462":45166},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_2936":1069,"_25651":1052,"_17922":45168,"_5":17817,"_24317":45119,"_2462":45169},[],"EST with `PRE_REGISTRATION`",{"_2936":1070,"_25651":1052,"_17922":45171,"_5":17817,"_24317":45119,"_2462":45172},[],"Must exist before `/simpleenroll`.",{"_2936":1071,"_25651":1052,"_17922":45174,"_5":17817,"_24317":45119,"_2462":45175},[],"Approved record, same DMS and replacement conditions for your version.",{"_2936":1072,"_25651":1052,"_17922":45177,"_5":17817,"_24317":45119,"_2462":45178},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_2936":1073,"_25651":1052,"_17922":45180,"_5":17817,"_24317":45119,"_2462":45181},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_2936":1074,"_25651":1052,"_17922":45183,"_5":17817,"_24317":45123,"_2462":45184},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_2936":1075,"_25651":1052,"_17922":45186,"_5":17817,"_24317":45123,"_2462":45187},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_2936":1076,"_25651":1052,"_17922":45189,"_5":17817,"_24317":45123,"_2462":45190},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_2936":1077,"_25651":1052,"_17922":45192,"_5":17817,"_24317":45127,"_2462":45193},[],"Decide initial enrollment and re-enrollment separately:",{"_2936":1078,"_25651":1052,"_17922":45195,"_5":17817,"_24317":45127,"_2462":45196},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_2936":1079,"_25651":1052,"_17922":45198,"_5":17817,"_24317":45127,"_2462":45199},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_2936":1080,"_25651":1052,"_17922":45201,"_5":17817,"_24317":45127,"_2462":45202},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_2936":1081,"_25651":1052,"_17922":45204,"_5":17817,"_24317":45127,"_2462":45205},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_2936":1082,"_25651":1052,"_17922":45207,"_5":17817,"_24317":45127,"_2462":45208},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_2936":1083,"_25651":1052,"_17922":45210,"_5":17817,"_24317":45131,"_2462":42213},[],{"_2936":1084,"_25651":1052,"_17922":45212,"_5":17817,"_24317":45131,"_2462":45213},[],"Material crossing EST",{"_2936":1085,"_25651":1052,"_17922":45215,"_5":17817,"_24317":45131,"_2462":45216},[],"Device-generated key",{"_2936":1086,"_25651":1052,"_17922":45218,"_5":17817,"_24317":45131,"_2462":45219},[],"Public CSR and certificate; the key stays on the client.",{"_2936":1087,"_25651":1052,"_17922":45221,"_5":17817,"_24317":45131,"_2462":45222},[],"Existing device key",{"_2936":1088,"_25651":1052,"_17922":45224,"_5":17817,"_24317":45131,"_2462":45225},[],"CSR signed with that key and a new certificate.",{"_2936":1089,"_25651":1052,"_17922":45227,"_5":17817,"_24317":45131,"_2462":44499},[],{"_2936":1090,"_25651":1052,"_17922":45229,"_5":17817,"_24317":45131,"_2462":45230},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_2936":1091,"_25651":1052,"_17922":45232,"_5":17817,"_24317":45131,"_2462":45233},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_2936":1092,"_25651":1052,"_17922":45235,"_5":17817,"_24317":45135,"_2462":45236},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_2936":1093,"_25651":1093,"_5":12587,"_2462":45238,"_25996":45239,"_17922":45240,"_24317":1093},"Renewal and recovery",[41832,43206,44180,44178,44361],[],{"_2936":1094,"_25651":1093,"_17922":45242,"_5":17817,"_24317":1093,"_2462":45243},[],"Renew without losing the identity and recover devices according to their actual state.",{"_2936":1095,"_25651":1093,"_5":25993,"_17922":45245,"_24317":45246,"_2462":45247},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_2936":1096,"_25651":1093,"_5":25993,"_17922":45249,"_24317":45250,"_2462":45251},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_2936":1097,"_25651":1093,"_5":25993,"_17922":45253,"_24317":45254,"_2462":45255},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_2936":1098,"_25651":1093,"_5":25993,"_17922":45257,"_24317":45258,"_2462":45259},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_2936":1099,"_25651":1093,"_5":25993,"_17922":45261,"_24317":45262,"_2462":45263},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_2936":1100,"_25651":1093,"_17922":45265,"_5":17817,"_24317":1093,"_2462":45266},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_2936":1101,"_25651":1093,"_17922":45268,"_5":17817,"_24317":45246,"_2462":45269},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_2936":1102,"_25651":1093,"_17922":45271,"_5":17817,"_24317":45246,"_2462":45272},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_2936":1103,"_25651":1093,"_17922":45274,"_5":17817,"_24317":45246,"_2462":45275},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_2936":1104,"_25651":1093,"_17922":45277,"_5":17817,"_24317":45246,"_2462":45278},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_2936":1105,"_25651":1093,"_17922":45280,"_5":17817,"_24317":45250,"_2462":45281},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_2936":1106,"_25651":1093,"_17922":45283,"_5":17817,"_24317":45250,"_2462":45284},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_2936":1107,"_25651":1093,"_17922":45286,"_5":17817,"_24317":45254,"_2462":45287},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_2936":1108,"_25651":1093,"_17922":45289,"_5":17817,"_24317":45254,"_2462":45290},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_2936":1109,"_25651":1093,"_17922":45292,"_5":17817,"_24317":45254,"_2462":45293},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_2936":1110,"_25651":1093,"_17922":45295,"_5":17817,"_24317":45258,"_2462":45296},[],"Situation",{"_2936":1111,"_25651":1093,"_17922":45298,"_5":17817,"_24317":45258,"_2462":45299},[],"Procedure",{"_2936":1112,"_25651":1093,"_17922":45301,"_5":17817,"_24317":45258,"_2462":45302},[],"Valid certificate, outside the window",{"_2936":1113,"_25651":1093,"_17922":45304,"_5":17817,"_24317":45258,"_2462":45305},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_2936":1114,"_25651":1093,"_17922":45307,"_5":17817,"_24317":45258,"_2462":45308},[],"Expired certificate, key available",{"_2936":1115,"_25651":1093,"_17922":45310,"_5":17817,"_24317":45258,"_2462":45311},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_2936":1116,"_25651":1093,"_17922":45313,"_5":17817,"_24317":45258,"_2462":45314},[],"Renewal through webhook or `NO_AUTH`",{"_2936":1117,"_25651":1093,"_17922":45316,"_5":17817,"_24317":45258,"_2462":45317},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_2936":1118,"_25651":1093,"_17922":45319,"_5":17817,"_24317":45258,"_2462":45320},[],"Lost or inaccessible key",{"_2936":1119,"_25651":1093,"_17922":45322,"_5":17817,"_24317":45258,"_2462":45323},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_2936":1120,"_25651":1093,"_17922":45325,"_5":17817,"_24317":45258,"_2462":45326},[],"Current identity revoked",{"_2936":1121,"_25651":1093,"_17922":45328,"_5":17817,"_24317":45258,"_2462":45329},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_2936":1122,"_25651":1093,"_17922":45331,"_5":17817,"_24317":45258,"_2462":45332},[],"Device without an identity",{"_2936":1123,"_25651":1093,"_17922":45334,"_5":17817,"_24317":45258,"_2462":45335},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_2936":1124,"_25651":1093,"_17922":45337,"_5":17817,"_24317":45258,"_2462":45338},[],"Retired device",{"_2936":1125,"_25651":1093,"_17922":45340,"_5":17817,"_24317":45258,"_2462":45341},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_2936":1126,"_25651":1093,"_17922":45343,"_5":17817,"_24317":45258,"_2462":45344},[],"Timeout, HTTP 500 or installation failure",{"_2936":1127,"_25651":1093,"_17922":45346,"_5":17817,"_24317":45258,"_2462":45347},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_2936":1128,"_25651":1093,"_17922":45349,"_5":17817,"_24317":45262,"_2462":45350},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_2936":1129,"_25651":1093,"_17922":45352,"_5":17817,"_24317":45262,"_2462":45353},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_2936":1130,"_25651":1130,"_5":12587,"_2462":45355,"_25996":45356,"_17922":45357,"_24317":1130},"Enrollment troubleshooting",[41832,43206,44180,44178,44361],[],{"_2936":1131,"_25651":1130,"_17922":45359,"_5":17817,"_24317":1130,"_2462":45360},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_2936":1132,"_25651":1130,"_5":25993,"_17922":45362,"_24317":45363,"_2462":45364},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_2936":1133,"_25651":1130,"_5":25993,"_17922":45366,"_24317":45367,"_2462":45368},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_2936":1134,"_25651":1130,"_5":25993,"_17922":45370,"_24317":45371,"_2462":44918},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_2936":1135,"_25651":1130,"_5":25993,"_17922":45373,"_24317":45374,"_2462":45375},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_2936":1136,"_25651":1130,"_17922":45377,"_5":17817,"_24317":1130,"_2462":45378},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_2936":1137,"_25651":1130,"_17922":45380,"_5":17817,"_24317":45367,"_2462":45381},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_2936":1138,"_25651":1130,"_17922":45383,"_5":17817,"_24317":45367,"_2462":45384},[],"Symptom or message",{"_2936":1139,"_25651":1130,"_17922":45386,"_5":17817,"_24317":45367,"_2462":45148},[],{"_2936":1140,"_25651":1130,"_17922":45388,"_5":17817,"_24317":45367,"_2462":45389},[],"curl rejects TLS, name or issuer",{"_2936":1141,"_25651":1130,"_17922":45391,"_5":17817,"_24317":45367,"_2462":45392},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_2936":1142,"_25651":1130,"_17922":45394,"_5":17817,"_24317":45367,"_2462":45395},[],"404 or missing APS",{"_2936":1143,"_25651":1130,"_17922":45397,"_5":17817,"_24317":45367,"_2462":45398},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_2936":1144,"_25651":1130,"_17922":45400,"_5":17817,"_24317":45367,"_2462":45401},[],"400, CSR or format error",{"_2936":1145,"_25651":1130,"_17922":45403,"_5":17817,"_24317":45367,"_2462":45404},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_2936":1146,"_25651":1130,"_17922":45406,"_5":17817,"_24317":45367,"_2462":45407},[],"Missing credential or invalid certificate",{"_2936":1147,"_25651":1130,"_17922":45409,"_5":17817,"_24317":45367,"_2462":45410},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_2936":1148,"_25651":1130,"_17922":45412,"_5":17817,"_24317":45367,"_2462":45413},[],"Webhook denies, times out or responds without authorization",{"_2936":1149,"_25651":1130,"_17922":45415,"_5":17817,"_24317":45367,"_2462":45416},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_2936":1150,"_25651":1130,"_17922":45418,"_5":17817,"_24317":45367,"_2462":45419},[],"`unexpected status code: <n>: redirects are not followed`",{"_2936":1151,"_25651":1130,"_17922":45421,"_5":17817,"_24317":45367,"_2462":45422},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_2936":1152,"_25651":1130,"_17922":45424,"_5":17817,"_24317":45367,"_2462":45425},[],"`webhook response exceeds 1048576 bytes`",{"_2936":1153,"_25651":1130,"_17922":45427,"_5":17817,"_24317":45367,"_2462":45428},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_2936":1154,"_25651":1130,"_17922":45430,"_5":17817,"_24317":45367,"_2462":45431},[],"`webhook config must not reference files`",{"_2936":1155,"_25651":1130,"_17922":45433,"_5":17817,"_24317":45367,"_2462":45434},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_2936":1156,"_25651":1130,"_17922":45436,"_5":17817,"_24317":45367,"_2462":45437},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_2936":1157,"_25651":1130,"_17922":45439,"_5":17817,"_24317":45367,"_2462":45440},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_2936":1158,"_25651":1130,"_17922":45442,"_5":17817,"_24317":45367,"_2462":45443},[],"`webhook mTLS certificate and key are invalid: …`",{"_2936":1159,"_25651":1130,"_17922":45445,"_5":17817,"_24317":45367,"_2462":45446},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_2936":1160,"_25651":1130,"_17922":45448,"_5":17817,"_24317":45367,"_2462":45449},[],"400 `struct validation error` creating or updating a DMS",{"_2936":1161,"_25651":1130,"_17922":45451,"_5":17817,"_24317":45367,"_2462":45452},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_2936":1162,"_25651":1130,"_17922":45454,"_5":17817,"_24317":45367,"_2462":45455},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_2936":1163,"_25651":1130,"_17922":45457,"_5":17817,"_24317":45367,"_2462":45458},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_2936":1164,"_25651":1130,"_17922":45460,"_5":17817,"_24317":45367,"_2462":45461},[],"`device not preregistered`",{"_2936":1165,"_25651":1130,"_17922":45463,"_5":17817,"_24317":45367,"_2462":45464},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_2936":1166,"_25651":1130,"_17922":45466,"_5":17817,"_24317":45367,"_2462":45467},[],"`forbiddenNewEnrollment`",{"_2936":1167,"_25651":1130,"_17922":45469,"_5":17817,"_24317":45367,"_2462":45470},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_2936":1168,"_25651":1130,"_17922":45472,"_5":17817,"_24317":45367,"_2462":45473},[],"Different owning DMS",{"_2936":1169,"_25651":1130,"_17922":45475,"_5":17817,"_24317":45367,"_2462":45476},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_2936":1170,"_25651":1130,"_17922":45478,"_5":17817,"_24317":45367,"_2462":45479},[],"`invalid RawSubject bytes`",{"_2936":1171,"_25651":1130,"_17922":45481,"_5":17817,"_24317":45367,"_2462":45482},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_2936":1172,"_25651":1130,"_17922":45484,"_5":17817,"_24317":45367,"_2462":45485},[],"`invalid reenroll window`",{"_2936":1173,"_25651":1130,"_17922":45487,"_5":17817,"_24317":45367,"_2462":45488},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_2936":1174,"_25651":1130,"_17922":45490,"_5":17817,"_24317":45367,"_2462":45491},[],"Current certificate revoked",{"_2936":1175,"_25651":1130,"_17922":45493,"_5":17817,"_24317":45367,"_2462":45494},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_2936":1176,"_25651":1130,"_17922":45496,"_5":17817,"_24317":45367,"_2462":45497},[],"CA, profile or signing error",{"_2936":1177,"_25651":1130,"_17922":45499,"_5":17817,"_24317":45367,"_2462":45500},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_2936":1178,"_25651":1130,"_17922":45502,"_5":17817,"_24317":45367,"_2462":45503},[],"HTTP 200 without a device connection",{"_2936":1179,"_25651":1130,"_17922":45505,"_5":17817,"_24317":45367,"_2462":45506},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_2936":1180,"_25651":1130,"_17922":45508,"_5":17817,"_24317":45367,"_2462":45509},[],"Timeout or error after issuance",{"_2936":1181,"_25651":1130,"_17922":45511,"_5":17817,"_24317":45367,"_2462":45512},[],"New certificates, current slot and previous identity's state before retrying.",{"_2936":1182,"_25651":1130,"_17922":45514,"_5":17817,"_24317":45371,"_2462":45515},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_2936":1183,"_25651":1130,"_17922":45517,"_5":17817,"_24317":45371,"_2462":45518},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_2936":1184,"_25651":1130,"_17922":45520,"_5":17817,"_24317":45374,"_2462":45521},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_2936":1185,"_25651":1130,"_17922":45523,"_5":17817,"_24317":45374,"_2462":45524},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_2936":1186,"_25651":1130,"_17922":45526,"_5":17817,"_24317":45374,"_2462":45527},[],"Verify the CSR locally and relate its CN to the inventory.",{"_2936":1187,"_25651":1130,"_17922":45529,"_5":17817,"_24317":45374,"_2462":45530},[],"Make one request, save headers/body and query the device and certificates.",{"_2936":1188,"_25651":1130,"_17922":45532,"_5":17817,"_24317":45374,"_2462":45533},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_2936":1189,"_25651":1130,"_17922":45535,"_5":17817,"_24317":45374,"_2462":45536},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_2936":1190,"_25651":1130,"_17922":45538,"_5":17817,"_24317":45374,"_2462":45539},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_2936":1191,"_25651":1191,"_5":12587,"_2462":45541,"_25996":45542,"_17922":45543,"_24317":1191},"Trust distribution and updates",[41832,43206,44180,44178,44361],[],{"_2936":1192,"_25651":1191,"_17922":45545,"_5":17817,"_24317":1191,"_2462":45546},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_2936":1193,"_25651":1191,"_5":25993,"_17922":45548,"_24317":45549,"_2462":45550},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_2936":1194,"_25651":1191,"_5":25993,"_17922":45552,"_24317":45553,"_2462":45554},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_2936":1195,"_25651":1191,"_5":25993,"_17922":45556,"_24317":45557,"_2462":45558},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_2936":1196,"_25651":1191,"_5":25993,"_17922":45560,"_24317":45561,"_2462":45562},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_2936":1197,"_25651":1191,"_5":25993,"_17922":45564,"_24317":45565,"_2462":45566},[],"/docs/pr-preview/pr-49/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_2936":1198,"_25651":1191,"_17922":45568,"_5":17817,"_24317":1191,"_2462":45569},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_2936":1199,"_25651":1191,"_17922":45571,"_5":17817,"_24317":45549,"_2462":45572},[],"Relationship",{"_2936":1200,"_25651":1191,"_17922":45574,"_5":17817,"_24317":45549,"_2462":45575},[],"Material prepared by its owner",{"_2936":1201,"_25651":1191,"_17922":45577,"_5":17817,"_24317":45549,"_2462":45578},[],"Device → EST server",{"_2936":1202,"_25651":1191,"_17922":45580,"_5":17817,"_24317":45549,"_2462":45581},[],"Previously verified server root, chain or pin and TLS name.",{"_2936":1203,"_25651":1191,"_17922":45583,"_5":17817,"_24317":45549,"_2462":45584},[],"DMS → requester",{"_2936":1204,"_25651":1191,"_17922":45586,"_5":17817,"_24317":45549,"_2462":45587},[],"CAs and rules authorizing initial or renewal credentials.",{"_2936":1205,"_25651":1191,"_17922":45589,"_5":17817,"_24317":45549,"_2462":45590},[],"Consumer → device",{"_2936":1206,"_25651":1191,"_17922":45592,"_5":17817,"_24317":45549,"_2462":45593},[],"Operational identity roots, intermediates, validation and permissions.",{"_2936":1207,"_25651":1191,"_17922":45595,"_5":17817,"_24317":45549,"_2462":45596},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_2936":1208,"_25651":1191,"_17922":45598,"_5":17817,"_24317":45553,"_2462":45599},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_2936":1209,"_25651":1191,"_17922":45601,"_5":17817,"_24317":45553,"_2462":45602},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_2936":1210,"_25651":1191,"_17922":45604,"_5":17817,"_24317":45557,"_2462":45605},[],"Keep initial EST server trust separate from identity consumer trust.",{"_2936":1211,"_25651":1191,"_17922":45607,"_5":17817,"_24317":45557,"_2462":45608},[],"Select policy-approved roots as anchors.",{"_2936":1212,"_25651":1191,"_17922":45610,"_5":17817,"_24317":45557,"_2462":45611},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_2936":1213,"_25651":1191,"_17922":45613,"_5":17817,"_24317":45557,"_2462":45614},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_2936":1214,"_25651":1191,"_17922":45616,"_5":17817,"_24317":45557,"_2462":45617},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_2936":1215,"_25651":1191,"_17922":45619,"_5":17817,"_24317":45557,"_2462":45620},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_2936":1216,"_25651":1191,"_17922":45622,"_5":17817,"_24317":45561,"_2462":45623},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_2936":1217,"_25651":1191,"_17922":45625,"_5":17817,"_24317":45561,"_2462":45626},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. When switching the enrollment CA, add the previous issuance CA to that list so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_2936":1218,"_25651":1191,"_17922":45628,"_5":17817,"_24317":45561,"_2462":45629},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_2936":1219,"_25651":1191,"_17922":45631,"_5":17817,"_24317":45565,"_2462":45632},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_2936":1220,"_25651":1220,"_5":12587,"_2462":45634,"_25996":45635,"_17922":45637,"_24317":1220},"AWS IoT Core",[41832,43206,44180,44178,45636],"Integrations",[],{"_2936":1221,"_25651":1220,"_17922":45639,"_5":17817,"_24317":1220,"_2462":45640},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_2936":1222,"_25651":1220,"_5":25993,"_17922":45642,"_24317":45643,"_2462":45644},[],"/docs/pr-preview/pr-49/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_2936":1223,"_25651":1220,"_5":25993,"_17922":45646,"_24317":45647,"_2462":45648},[],"/docs/pr-preview/pr-49/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_2936":1224,"_25651":1220,"_5":25993,"_17922":45650,"_24317":45651,"_2462":45652},[],"/docs/pr-preview/pr-49/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_2936":1225,"_25651":1220,"_5":25993,"_17922":45654,"_24317":45655,"_2462":45656},[],"/docs/pr-preview/pr-49/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_2936":1226,"_25651":1220,"_5":25993,"_17922":45658,"_24317":45659,"_2462":45660},[],"/docs/pr-preview/pr-49/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_2936":1227,"_25651":1220,"_5":25993,"_17922":45662,"_24317":45663,"_2462":45664},[],"/docs/pr-preview/pr-49/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_2936":1228,"_25651":1220,"_5":25993,"_17922":45666,"_24317":45667,"_2462":45668},[],"/docs/pr-preview/pr-49/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_2936":1229,"_25651":1220,"_5":25993,"_17922":45670,"_24317":45671,"_2462":45672},[],"/docs/pr-preview/pr-49/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_2936":1230,"_25651":1220,"_5":25993,"_17922":45674,"_24317":45675,"_2462":45676},[],"/docs/pr-preview/pr-49/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_2936":1231,"_25651":1220,"_5":25993,"_17922":45678,"_24317":45679,"_2462":45680},[],"/docs/pr-preview/pr-49/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_2936":1232,"_25651":1220,"_5":25993,"_17922":45682,"_24317":45683,"_2462":45684},[],"/docs/pr-preview/pr-49/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_2936":1233,"_25651":1220,"_5":25993,"_17922":45686,"_24317":45687,"_2462":45688},[],"/docs/pr-preview/pr-49/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_2936":1234,"_25651":1220,"_5":25993,"_17922":45690,"_24317":45691,"_2462":45692},[],"/docs/pr-preview/pr-49/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_2936":1235,"_25651":1220,"_5":25993,"_17922":45694,"_24317":45695,"_2462":45696},[],"/docs/pr-preview/pr-49/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_2936":1236,"_25651":1220,"_5":25993,"_17922":45698,"_24317":45699,"_2462":45700},[],"/docs/pr-preview/pr-49/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_2936":1237,"_25651":1220,"_5":25993,"_17922":45702,"_24317":45703,"_2462":45704},[],"/docs/pr-preview/pr-49/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_2936":1238,"_25651":1220,"_5":25993,"_17922":45706,"_24317":45707,"_2462":45708},[],"/docs/pr-preview/pr-49/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_2936":1239,"_25651":1220,"_5":25993,"_17922":45710,"_24317":45711,"_2462":45712},[],"/docs/pr-preview/pr-49/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_2936":1240,"_25651":1220,"_5":25993,"_17922":45714,"_24317":45715,"_2462":45716},[],"/docs/pr-preview/pr-49/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_2936":1241,"_25651":1220,"_5":25993,"_17922":45718,"_24317":45719,"_2462":45720},[],"/docs/pr-preview/pr-49/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_2936":1242,"_25651":1220,"_17922":45722,"_5":17817,"_24317":1220,"_2462":45723},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_2936":1243,"_25651":1220,"_17922":45725,"_5":17817,"_24317":1220,"_2462":45726},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_2936":1244,"_25651":1220,"_17922":45728,"_5":17817,"_24317":1220,"_2462":45729},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_2936":1245,"_25651":1220,"_17922":45731,"_5":17817,"_24317":45643,"_2462":45732},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_2936":1246,"_25651":1220,"_17922":45734,"_5":17817,"_24317":45643,"_2462":45735},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_2936":1247,"_25651":1220,"_17922":45737,"_5":17817,"_24317":45643,"_2462":45738},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_2936":1248,"_25651":1220,"_17922":45740,"_5":17817,"_24317":45643,"_2462":45741},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_2936":1249,"_25651":1220,"_17922":45743,"_5":17817,"_24317":45647,"_2462":45744},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_2936":1250,"_25651":1220,"_17922":45746,"_5":17817,"_24317":45651,"_2462":45747},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_2936":1251,"_25651":1220,"_17922":45749,"_5":17817,"_24317":45651,"_2462":45750},[],"IAM action",{"_2936":1252,"_25651":1220,"_17922":45752,"_5":17817,"_24317":45651,"_2462":42219},[],{"_2936":1253,"_25651":1220,"_17922":45754,"_5":17817,"_24317":45651,"_2462":45755},[],"`iot:GetRegistrationCode`",{"_2936":1254,"_25651":1220,"_17922":45757,"_5":17817,"_24317":45651,"_2462":45758},[],"Obtain the verification code for CA registration in the Primary Account",{"_2936":1255,"_25651":1220,"_17922":45760,"_5":17817,"_24317":45651,"_2462":45761},[],"`iot:RegisterCACertificate`",{"_2936":1256,"_25651":1220,"_17922":45763,"_5":17817,"_24317":45651,"_2462":45764},[],"Register the CA in AWS IoT",{"_2936":1257,"_25651":1220,"_17922":45766,"_5":17817,"_24317":45651,"_2462":45767},[],"`iot:DescribeCACertificate`",{"_2936":1258,"_25651":1220,"_17922":45769,"_5":17817,"_24317":45651,"_2462":45770},[],"Check the CA registration status",{"_2936":1259,"_25651":1220,"_17922":45772,"_5":17817,"_24317":45651,"_2462":45773},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_2936":1260,"_25651":1220,"_17922":45775,"_5":17817,"_24317":45651,"_2462":45776},[],"Create or update Things in IoT Core",{"_2936":1261,"_25651":1220,"_17922":45778,"_5":17817,"_24317":45651,"_2462":45779},[],"`iot:RegisterThing`",{"_2936":1262,"_25651":1220,"_17922":45781,"_5":17817,"_24317":45651,"_2462":45782},[],"Provision Things through a template",{"_2936":1263,"_25651":1220,"_17922":45784,"_5":17817,"_24317":45651,"_2462":45785},[],"`iot:RegisterCertificate`",{"_2936":1264,"_25651":1220,"_17922":45787,"_5":17817,"_24317":45651,"_2462":45788},[],"Register device certificates",{"_2936":1265,"_25651":1220,"_17922":45790,"_5":17817,"_24317":45651,"_2462":45791},[],"`iot:UpdateCertificate`",{"_2936":1266,"_25651":1220,"_17922":45793,"_5":17817,"_24317":45651,"_2462":45794},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_2936":1267,"_25651":1220,"_17922":45796,"_5":17817,"_24317":45651,"_2462":45797},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_2936":1268,"_25651":1220,"_17922":45799,"_5":17817,"_24317":45651,"_2462":45800},[],"Create and attach IoT policies",{"_2936":1269,"_25651":1220,"_17922":45802,"_5":17817,"_24317":45651,"_2462":45803},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_2936":1270,"_25651":1220,"_17922":45805,"_5":17817,"_24317":45651,"_2462":45806},[],"Manage Thing groups",{"_2936":1271,"_25651":1220,"_17922":45808,"_5":17817,"_24317":45651,"_2462":45809},[],"`iot:CreateProvisioningTemplate`",{"_2936":1272,"_25651":1220,"_17922":45811,"_5":17817,"_24317":45651,"_2462":45812},[],"Create JITP templates",{"_2936":1273,"_25651":1220,"_17922":45814,"_5":17817,"_24317":45651,"_2462":45815},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_2936":1274,"_25651":1220,"_17922":45817,"_5":17817,"_24317":45651,"_2462":45818},[],"Read and write the Device Shadow",{"_2936":1275,"_25651":1220,"_17922":45820,"_5":17817,"_24317":45651,"_2462":45821},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_2936":1276,"_25651":1220,"_17922":45823,"_5":17817,"_24317":45655,"_2462":45824},[],"Parameter",{"_2936":1277,"_25651":1220,"_17922":45826,"_5":17817,"_24317":45655,"_2462":45827},[],"Type",{"_2936":1278,"_25651":1220,"_17922":45829,"_5":17817,"_24317":45655,"_2462":45830},[],"Required",{"_2936":1279,"_25651":1220,"_17922":45832,"_5":17817,"_24317":45655,"_2462":45833},[],"Description",{"_2936":1280,"_25651":1220,"_17922":45835,"_5":17817,"_24317":45655,"_2462":45836},[],"`connector_id`",{"_2936":1281,"_25651":1220,"_17922":45838,"_5":17817,"_24317":45655,"_2462":21398},[],{"_2936":1282,"_25651":1220,"_17922":45840,"_5":17817,"_24317":45655,"_2462":45841},[],"Yes",{"_2936":1283,"_25651":1220,"_17922":45843,"_5":17817,"_24317":45655,"_2462":45844},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_2936":1284,"_25651":1220,"_17922":45846,"_5":17817,"_24317":45655,"_2462":45847},[],"`aws_config.region`",{"_2936":1285,"_25651":1220,"_17922":45849,"_5":17817,"_24317":45655,"_2462":21398},[],{"_2936":1286,"_25651":1220,"_17922":45851,"_5":17817,"_24317":45655,"_2462":45841},[],{"_2936":1287,"_25651":1220,"_17922":45853,"_5":17817,"_24317":45655,"_2462":45854},[],"AWS region where the connector operates.",{"_2936":1288,"_25651":1220,"_17922":45856,"_5":17817,"_24317":45655,"_2462":45857},[],"`aws_config.auth_method`",{"_2936":1289,"_25651":1220,"_17922":45859,"_5":17817,"_24317":45655,"_2462":21398},[],{"_2936":1290,"_25651":1220,"_17922":45861,"_5":17817,"_24317":45655,"_2462":45841},[],{"_2936":1291,"_25651":1220,"_17922":45863,"_5":17817,"_24317":45655,"_2462":45864},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_2936":1292,"_25651":1220,"_17922":45866,"_5":17817,"_24317":45655,"_2462":45867},[],"`aws_config.access_key_id`",{"_2936":1293,"_25651":1220,"_17922":45869,"_5":17817,"_24317":45655,"_2462":21398},[],{"_2936":1294,"_25651":1220,"_17922":45871,"_5":17817,"_24317":45655,"_2462":45872},[],"Only with `auth_method=static`",{"_2936":1295,"_25651":1220,"_17922":45874,"_5":17817,"_24317":45655,"_2462":45875},[],"AWS access key.",{"_2936":1296,"_25651":1220,"_17922":45877,"_5":17817,"_24317":45655,"_2462":45878},[],"`aws_config.secret_access_key`",{"_2936":1297,"_25651":1220,"_17922":45880,"_5":17817,"_24317":45655,"_2462":21398},[],{"_2936":1298,"_25651":1220,"_17922":45882,"_5":17817,"_24317":45655,"_2462":45872},[],{"_2936":1299,"_25651":1220,"_17922":45884,"_5":17817,"_24317":45655,"_2462":45885},[],"AWS secret key.",{"_2936":1300,"_25651":1220,"_17922":45887,"_5":17817,"_24317":45655,"_2462":45888},[],"`aws_config.session_token`",{"_2936":1301,"_25651":1220,"_17922":45890,"_5":17817,"_24317":45655,"_2462":21398},[],{"_2936":1302,"_25651":1220,"_17922":45892,"_5":17817,"_24317":45655,"_2462":45893},[],"No",{"_2936":1303,"_25651":1220,"_17922":45895,"_5":17817,"_24317":45655,"_2462":45896},[],"Session token (with `auth_method=static`).",{"_2936":1304,"_25651":1220,"_17922":45898,"_5":17817,"_24317":45655,"_2462":45899},[],"`aws_config.role_arn`",{"_2936":1305,"_25651":1220,"_17922":45901,"_5":17817,"_24317":45655,"_2462":21398},[],{"_2936":1306,"_25651":1220,"_17922":45903,"_5":17817,"_24317":45655,"_2462":45904},[],"Only with `auth_method=role`",{"_2936":1307,"_25651":1220,"_17922":45906,"_5":17817,"_24317":45655,"_2462":45907},[],"ARN of the role to assume.",{"_2936":1308,"_25651":1220,"_17922":45909,"_5":17817,"_24317":45655,"_2462":45910},[],"`aws_config.endpoint_url`",{"_2936":1309,"_25651":1220,"_17922":45912,"_5":17817,"_24317":45655,"_2462":21398},[],{"_2936":1310,"_25651":1220,"_17922":45914,"_5":17817,"_24317":45655,"_2462":45893},[],{"_2936":1311,"_25651":1220,"_17922":45916,"_5":17817,"_24317":45655,"_2462":45917},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_2936":1312,"_25651":1220,"_17922":45919,"_5":17817,"_24317":45655,"_2462":45920},[],"`subscriber_event_bus`",{"_2936":1313,"_25651":1220,"_17922":45922,"_5":17817,"_24317":45655,"_2462":15029},[],{"_2936":1314,"_25651":1220,"_17922":45924,"_5":17817,"_24317":45655,"_2462":45841},[],{"_2936":1315,"_25651":1220,"_17922":45926,"_5":17817,"_24317":45655,"_2462":45927},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_2936":1316,"_25651":1220,"_17922":45929,"_5":17817,"_24317":45655,"_2462":45930},[],"`dms_manager_client`",{"_2936":1317,"_25651":1220,"_17922":45932,"_5":17817,"_24317":45655,"_2462":21398},[],{"_2936":1318,"_25651":1220,"_17922":45934,"_5":17817,"_24317":45655,"_2462":45841},[],{"_2936":1319,"_25651":1220,"_17922":45936,"_5":17817,"_24317":45655,"_2462":45937},[],"HTTP URL of Lamassu's DMS Manager service.",{"_2936":1320,"_25651":1220,"_17922":45939,"_5":17817,"_24317":45655,"_2462":45940},[],"`device_manager_client`",{"_2936":1321,"_25651":1220,"_17922":45942,"_5":17817,"_24317":45655,"_2462":21398},[],{"_2936":1322,"_25651":1220,"_17922":45944,"_5":17817,"_24317":45655,"_2462":45841},[],{"_2936":1323,"_25651":1220,"_17922":45946,"_5":17817,"_24317":45655,"_2462":45947},[],"HTTP URL of Lamassu's Device Manager.",{"_2936":1324,"_25651":1220,"_17922":45949,"_5":17817,"_24317":45655,"_2462":45950},[],"`ca_client`",{"_2936":1325,"_25651":1220,"_17922":45952,"_5":17817,"_24317":45655,"_2462":21398},[],{"_2936":1326,"_25651":1220,"_17922":45954,"_5":17817,"_24317":45655,"_2462":45841},[],{"_2936":1327,"_25651":1220,"_17922":45956,"_5":17817,"_24317":45655,"_2462":45957},[],"HTTP URL of Lamassu's CA service.",{"_2936":1328,"_25651":1220,"_17922":45959,"_5":17817,"_24317":45659,"_2462":45960},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_2936":1329,"_25651":1220,"_17922":45962,"_5":17817,"_24317":45663,"_2462":45963},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_2936":1330,"_25651":1220,"_17922":45965,"_5":17817,"_24317":45663,"_2462":45966},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_2936":1331,"_25651":1220,"_17922":45968,"_5":17817,"_24317":45667,"_2462":45969},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_2936":1332,"_25651":1220,"_17922":45971,"_5":17817,"_24317":45667,"_2462":45972},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_2936":1333,"_25651":1220,"_17922":45974,"_5":17817,"_24317":45667,"_2462":45975},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_2936":1334,"_25651":1220,"_17922":45977,"_5":17817,"_24317":45667,"_2462":45978},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_2936":1335,"_25651":1220,"_17922":45980,"_5":17817,"_24317":45667,"_2462":45981},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_2936":1336,"_25651":1220,"_17922":45983,"_5":17817,"_24317":45667,"_2462":45984},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_2936":1337,"_25651":1220,"_17922":45986,"_5":17817,"_24317":45671,"_2462":45987},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_2936":1338,"_25651":1220,"_17922":45989,"_5":17817,"_24317":45675,"_2462":45990},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_2936":1339,"_25651":1220,"_17922":45992,"_5":17817,"_24317":45675,"_2462":45993},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_2936":1340,"_25651":1220,"_17922":45995,"_5":17817,"_24317":45679,"_2462":45996},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_2936":1341,"_25651":1220,"_17922":45998,"_5":17817,"_24317":45683,"_2462":45999},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_2936":1342,"_25651":1220,"_17922":46001,"_5":17817,"_24317":45683,"_2462":46002},[],"Creates or updates the IoT policies configured in the DMS.",{"_2936":1343,"_25651":1220,"_17922":46004,"_5":17817,"_24317":45683,"_2462":46005},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_2936":1344,"_25651":1220,"_17922":46007,"_5":17817,"_24317":45683,"_2462":46008},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_2936":1345,"_25651":1220,"_17922":46010,"_5":17817,"_24317":45683,"_2462":46011},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_2936":1346,"_25651":1220,"_17922":46013,"_5":17817,"_24317":45683,"_2462":46014},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_2936":1347,"_25651":1220,"_17922":46016,"_5":17817,"_24317":45683,"_2462":46017},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_2936":1348,"_25651":1220,"_17922":46019,"_5":17817,"_24317":45687,"_2462":46020},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_2936":1349,"_25651":1220,"_17922":46022,"_5":17817,"_24317":45687,"_2462":46023},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_2936":1350,"_25651":1220,"_17922":46025,"_5":17817,"_24317":45687,"_2462":46026},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_2936":1351,"_25651":1220,"_17922":46028,"_5":17817,"_24317":45691,"_2462":46029},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_2936":1352,"_25651":1220,"_17922":46031,"_5":17817,"_24317":45691,"_2462":46032},[],"The full flow from the device's perspective is:",{"_2936":1353,"_25651":1220,"_17922":46034,"_5":17817,"_24317":45691,"_2462":46035},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_2936":1354,"_25651":1220,"_17922":46037,"_5":17817,"_24317":45695,"_2462":46038},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_2936":1355,"_25651":1220,"_17922":46040,"_5":17817,"_24317":45695,"_2462":46041},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_2936":1356,"_25651":1220,"_17922":46043,"_5":17817,"_24317":45695,"_2462":46044},[],"For the JITP flow to work correctly:",{"_2936":1357,"_25651":1220,"_17922":46046,"_5":17817,"_24317":45695,"_2462":46047},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_2936":1358,"_25651":1220,"_17922":46049,"_5":17817,"_24317":45695,"_2462":46050},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_2936":1359,"_25651":1220,"_17922":46052,"_5":17817,"_24317":45695,"_2462":46053},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_2936":1360,"_25651":1220,"_17922":46055,"_5":17817,"_24317":45695,"_2462":46056},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_2936":1361,"_25651":1220,"_17922":46058,"_5":17817,"_24317":45699,"_2462":46059},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_2936":1362,"_25651":1220,"_17922":46061,"_5":17817,"_24317":45699,"_2462":46062},[],"Status in Lamassu",{"_2936":1363,"_25651":1220,"_17922":46064,"_5":17817,"_24317":45699,"_2462":46065},[],"Revocation reason",{"_2936":1364,"_25651":1220,"_17922":46067,"_5":17817,"_24317":45699,"_2462":46068},[],"Status in AWS IoT Core",{"_2936":1365,"_25651":1220,"_17922":46070,"_5":17817,"_24317":45699,"_2462":46071},[],"`Active`",{"_2936":1366,"_25651":1220,"_17922":46073,"_5":17817,"_24317":45699,"_2462":46074},[],"None",{"_2936":1367,"_25651":1220,"_17922":46076,"_5":17817,"_24317":45699,"_2462":46077},[],"`ACTIVE`",{"_2936":1368,"_25651":1220,"_17922":46079,"_5":17817,"_24317":45699,"_2462":46080},[],"`Revoked`",{"_2936":1369,"_25651":1220,"_17922":46082,"_5":17817,"_24317":45699,"_2462":46083},[],"`certificateHold`",{"_2936":1370,"_25651":1220,"_17922":46085,"_5":17817,"_24317":45699,"_2462":46086},[],"`INACTIVE`",{"_2936":1371,"_25651":1220,"_17922":46088,"_5":17817,"_24317":45699,"_2462":46080},[],{"_2936":1372,"_25651":1220,"_17922":46090,"_5":17817,"_24317":45699,"_2462":46091},[],"Any other reason",{"_2936":1373,"_25651":1220,"_17922":46093,"_5":17817,"_24317":45699,"_2462":46094},[],"`REVOKED`",{"_2936":1374,"_25651":1220,"_17922":46096,"_5":17817,"_24317":45699,"_2462":46097},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_2936":1375,"_25651":1220,"_17922":46099,"_5":17817,"_24317":45703,"_2462":46100},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_2936":1376,"_25651":1220,"_17922":46102,"_5":17817,"_24317":45703,"_2462":46103},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_2936":1377,"_25651":1220,"_17922":46105,"_5":17817,"_24317":45703,"_2462":46106},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_2936":1378,"_25651":1220,"_17922":46108,"_5":17817,"_24317":45707,"_2462":46109},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_2936":1379,"_25651":1220,"_17922":46111,"_5":17817,"_24317":45707,"_2462":46112},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_2936":1380,"_25651":1220,"_17922":46114,"_5":17817,"_24317":45711,"_2462":46115},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_2936":1381,"_25651":1220,"_17922":46117,"_5":17817,"_24317":45711,"_2462":46118},[],"There are two action types:",{"_2936":1382,"_25651":1220,"_17922":46120,"_5":17817,"_24317":45711,"_2462":46121},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_2936":1383,"_25651":1220,"_17922":46123,"_5":17817,"_24317":45711,"_2462":46124},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_2936":1384,"_25651":1220,"_17922":46126,"_5":17817,"_24317":45711,"_2462":46127},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_2936":1385,"_25651":1220,"_17922":46129,"_5":17817,"_24317":45715,"_2462":46130},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_2936":1386,"_25651":1220,"_17922":46132,"_5":17817,"_24317":45715,"_2462":46133},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_2936":1387,"_25651":1220,"_17922":46135,"_5":17817,"_24317":45715,"_2462":46136},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_2936":1388,"_25651":1220,"_17922":46138,"_5":17817,"_24317":45719,"_2462":46139},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_2936":1389,"_25651":1220,"_17922":46141,"_5":17817,"_24317":45719,"_2462":46142},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_2936":1390,"_25651":1220,"_17922":46144,"_5":17817,"_24317":45719,"_2462":46145},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_2936":1391,"_25651":1220,"_17922":46147,"_5":17817,"_24317":45719,"_2462":46148},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_2936":1392,"_25651":1220,"_17922":46150,"_5":17817,"_24317":45719,"_2462":46151},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_2936":1393,"_25651":1220,"_17922":46153,"_5":17817,"_24317":45719,"_2462":46154},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_2936":1394,"_25651":1220,"_17922":46156,"_5":17817,"_24317":45719,"_2462":46157},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_2936":1395,"_25651":1220,"_17922":46159,"_5":17817,"_24317":45719,"_2462":46160},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_2936":1396,"_25651":1220,"_17922":46162,"_5":17817,"_24317":45719,"_2462":46163},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_2936":1397,"_25651":1220,"_17922":46165,"_5":17817,"_24317":45719,"_2462":46166},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_2936":1398,"_25651":1220,"_17922":46168,"_5":17817,"_24317":45719,"_2462":46169},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_2936":1399,"_25651":1220,"_17922":46171,"_5":17817,"_24317":45719,"_2462":46172},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_2936":1400,"_25651":1220,"_17922":46174,"_5":17817,"_24317":45719,"_2462":46175},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_2936":1401,"_25651":1220,"_17922":46177,"_5":17817,"_24317":45719,"_2462":46178},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_2936":1402,"_25651":1220,"_17922":46180,"_5":17817,"_24317":45719,"_2462":46181},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_2936":1403,"_25651":1220,"_17922":46183,"_5":17817,"_24317":45719,"_2462":46184},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_2936":1404,"_25651":1220,"_17922":46186,"_5":17817,"_24317":45719,"_2462":46187},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_2936":1405,"_25651":1220,"_17922":46189,"_5":17817,"_24317":45719,"_2462":46190},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_2936":1406,"_25651":1220,"_17922":46192,"_5":17817,"_24317":45719,"_2462":46193},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2936":1407,"_25651":1220,"_17922":46195,"_5":17817,"_24317":45719,"_2462":46196},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2936":1408,"_25651":1220,"_17922":46198,"_5":17817,"_24317":45719,"_2462":46199},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_2936":1409,"_25651":1409,"_5":12587,"_2462":44180,"_25996":46201,"_17922":46202,"_24317":1409},[41832,43206,44180],[],{"_2936":1410,"_25651":1409,"_17922":46204,"_5":17817,"_24317":1409,"_2462":46205},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_2936":1411,"_25651":1409,"_5":25993,"_17922":46207,"_24317":46208,"_2462":46209},[],"/docs/pr-preview/pr-49/platform/iot-fleets/overview#start-here","Start here",{"_2936":1412,"_25651":1409,"_5":25993,"_17922":46211,"_24317":46212,"_2462":44178},[],"/docs/pr-preview/pr-49/platform/iot-fleets/overview#devices-and-identities",{"_2936":1413,"_25651":1409,"_5":25993,"_17922":46214,"_24317":46215,"_2462":44361},[],"/docs/pr-preview/pr-49/platform/iot-fleets/overview#enrollment-with-pki",{"_2936":1414,"_25651":1409,"_5":25993,"_17922":46217,"_24317":46218,"_2462":45636},[],"/docs/pr-preview/pr-49/platform/iot-fleets/overview#integrations",{"_2936":1415,"_25651":1409,"_5":25993,"_17922":46220,"_24317":46221,"_2462":46222},[],"/docs/pr-preview/pr-49/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_2936":1416,"_25651":1409,"_17922":46224,"_5":17817,"_24317":1409,"_2462":46225},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_2936":1417,"_25651":1409,"_17922":46227,"_5":17817,"_24317":46208,"_2462":46228},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_2936":1418,"_25651":1409,"_17922":46230,"_5":17817,"_24317":46208,"_2462":46231},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_2936":1419,"_25651":1409,"_17922":46233,"_5":17817,"_24317":46212,"_2462":46234},[],"Resource",{"_2936":1420,"_25651":1409,"_17922":46236,"_5":17817,"_24317":46212,"_2462":46237},[],"What it represents",{"_2936":1421,"_25651":1409,"_17922":46239,"_5":17817,"_24317":46212,"_2462":46240},[],"**Device**",{"_2936":1422,"_25651":1409,"_17922":46242,"_5":17817,"_24317":46212,"_2462":46243},[],"An inventory entry with an identifier, owning DMS and classification.",{"_2936":1423,"_25651":1409,"_17922":46245,"_5":17817,"_24317":46212,"_2462":46246},[],"**Identity**",{"_2936":1424,"_25651":1409,"_17922":46248,"_5":17817,"_24317":46212,"_2462":46249},[],"The device's association with its certificates: an active version and a history.",{"_2936":1425,"_25651":1409,"_17922":46251,"_5":17817,"_24317":46212,"_2462":46252},[],"**DMS**",{"_2936":1426,"_25651":1409,"_17922":46254,"_5":17817,"_24317":46212,"_2462":46255},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_2936":1427,"_25651":1409,"_17922":46257,"_5":17817,"_24317":46212,"_2462":46258},[],"**Fleet**",{"_2936":1428,"_25651":1409,"_17922":46260,"_5":17817,"_24317":46212,"_2462":46261},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_2936":1429,"_25651":1409,"_17922":46263,"_5":17817,"_24317":46212,"_2462":46264},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_2936":1430,"_25651":1409,"_17922":46266,"_5":17817,"_24317":46212,"_2462":46267},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_2936":1431,"_25651":1409,"_17922":46269,"_5":17817,"_24317":46215,"_2462":46270},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_2936":1432,"_25651":1409,"_17922":46272,"_5":17817,"_24317":46215,"_2462":46273},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_2936":1433,"_25651":1409,"_17922":46275,"_5":17817,"_24317":46215,"_2462":46276},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_2936":1434,"_25651":1409,"_17922":46278,"_5":17817,"_24317":46215,"_2462":46279},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_2936":1435,"_25651":1409,"_17922":46281,"_5":17817,"_24317":46215,"_2462":46282},[],"**Result:** request the certificate, install it and check its association with the device.",{"_2936":1436,"_25651":1409,"_17922":46284,"_5":17817,"_24317":46215,"_2462":46285},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_2936":1437,"_25651":1409,"_17922":46287,"_5":17817,"_24317":46215,"_2462":46288},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2936":1438,"_25651":1409,"_17922":46290,"_5":17817,"_24317":46215,"_2462":46291},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2936":1439,"_25651":1409,"_17922":46293,"_5":17817,"_24317":46218,"_2462":46294},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_2936":1440,"_25651":1409,"_17922":46296,"_5":17817,"_24317":46218,"_2462":46297},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_2936":1441,"_25651":1409,"_17922":46299,"_5":17817,"_24317":46221,"_2462":46300},[],"Participant",{"_2936":1442,"_25651":1409,"_17922":46302,"_5":17817,"_24317":46221,"_2462":46303},[],"Responsibility",{"_2936":1443,"_25651":1409,"_17922":46305,"_5":17817,"_24317":46221,"_2462":46306},[],"PKI administrator",{"_2936":1444,"_25651":1409,"_17922":46308,"_5":17817,"_24317":46221,"_2462":46309},[],"CA, issuance profile, chain and revocation publication.",{"_2936":1445,"_25651":1409,"_17922":46311,"_5":17817,"_24317":46221,"_2462":46312},[],"Provisioning administrator",{"_2936":1446,"_25651":1409,"_17922":46314,"_5":17817,"_24317":46221,"_2462":46315},[],"DMS, admission, authentication per operation and inventory.",{"_2936":1447,"_25651":1409,"_17922":46317,"_5":17817,"_24317":46221,"_2462":46318},[],"Device integrator",{"_2936":1448,"_25651":1409,"_17922":46320,"_5":17817,"_24317":46221,"_2462":46321},[],"Initial credential, key, EST client, trust and certificate installation.",{"_2936":1449,"_25651":1409,"_17922":46323,"_5":17817,"_24317":46221,"_2462":46324},[],"Consumer integrator",{"_2936":1450,"_25651":1409,"_17922":46326,"_5":17817,"_24317":46221,"_2462":46327},[],"Trusted issuers, validation and device permissions in the destination.",{"_2936":1451,"_25651":1409,"_17922":46329,"_5":17817,"_24317":46221,"_2462":46330},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_2936":1452,"_25651":1452,"_5":12587,"_2462":46332,"_25996":46333,"_17922":46335,"_24317":1452},"Enroll and connect your first device",[41832,43206,44180,46334],"Getting started",[],{"_2936":1453,"_25651":1452,"_17922":46337,"_5":17817,"_24317":1452,"_2462":46338},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_2936":1454,"_25651":1452,"_5":25993,"_17922":46340,"_24317":46341,"_2462":41842},[],"/docs/pr-preview/pr-49/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_2936":1455,"_25651":1452,"_5":25993,"_17922":46343,"_24317":46344,"_2462":46345},[],"/docs/pr-preview/pr-49/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_2936":1456,"_25651":1452,"_5":25993,"_17922":46347,"_24317":46348,"_2462":46349},[],"/docs/pr-preview/pr-49/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_2936":1457,"_25651":1452,"_5":25993,"_17922":46351,"_24317":46352,"_2462":46353},[],"/docs/pr-preview/pr-49/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_2936":1458,"_25651":1452,"_5":25993,"_17922":46355,"_24317":46356,"_2462":46357},[],"/docs/pr-preview/pr-49/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_2936":1459,"_25651":1452,"_5":25993,"_17922":46359,"_24317":46360,"_2462":46361},[],"/docs/pr-preview/pr-49/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_2936":1460,"_25651":1452,"_5":25993,"_17922":46363,"_24317":46364,"_2462":46365},[],"/docs/pr-preview/pr-49/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_2936":1461,"_25651":1452,"_5":25993,"_17922":46367,"_24317":46368,"_2462":46369},[],"/docs/pr-preview/pr-49/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_2936":1462,"_25651":1452,"_17922":46371,"_5":17817,"_24317":1452,"_2462":46372},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_2936":1463,"_25651":1452,"_17922":46374,"_5":17817,"_24317":46341,"_2462":46375},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_2936":1464,"_25651":1452,"_17922":46377,"_5":17817,"_24317":46341,"_2462":46378},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_2936":1465,"_25651":1452,"_17922":46380,"_5":17817,"_24317":46341,"_2462":46381},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_2936":1466,"_25651":1452,"_17922":46383,"_5":17817,"_24317":46341,"_2462":46384},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_2936":1467,"_25651":1452,"_17922":46386,"_5":17817,"_24317":46341,"_2462":46387},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_2936":1468,"_25651":1452,"_17922":46389,"_5":17817,"_24317":46344,"_2462":46390},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_2936":1469,"_25651":1452,"_17922":46392,"_5":17817,"_24317":46344,"_2462":46393},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_2936":1470,"_25651":1452,"_17922":46395,"_5":17817,"_24317":46348,"_2462":46396},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_2936":1471,"_25651":1452,"_17922":46398,"_5":17817,"_24317":46348,"_2462":46399},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_2936":1472,"_25651":1452,"_17922":46401,"_5":17817,"_24317":46348,"_2462":46402},[],"Setting",{"_2936":1473,"_25651":1452,"_17922":46404,"_5":17817,"_24317":46348,"_2462":46405},[],"Evaluation value",{"_2936":1474,"_25651":1452,"_17922":46407,"_5":17817,"_24317":46348,"_2462":46408},[],"Enrollment CA",{"_2936":1475,"_25651":1452,"_17922":46410,"_5":17817,"_24317":46348,"_2462":46411},[],"Issuing root from `device-root.pem`.",{"_2936":1476,"_25651":1452,"_17922":46413,"_5":17817,"_24317":46348,"_2462":44491},[],{"_2936":1477,"_25651":1452,"_17922":46415,"_5":17817,"_24317":46348,"_2462":46416},[],"The 1-hour leaf profile you just prepared.",{"_2936":1478,"_25651":1452,"_17922":46418,"_5":17817,"_24317":46348,"_2462":46419},[],"Protocol / Registration Mode",{"_2936":1479,"_25651":1452,"_17922":46421,"_5":17817,"_24317":46348,"_2462":46422},[],"`EST_RFC7030` / `JITP`.",{"_2936":1480,"_25651":1452,"_17922":46424,"_5":17817,"_24317":46348,"_2462":46425},[],"Verify CSR Signature",{"_2936":1481,"_25651":1452,"_17922":46427,"_5":17817,"_24317":46348,"_2462":46428},[],"Enabled.",{"_2936":1482,"_25651":1452,"_17922":46430,"_5":17817,"_24317":46348,"_2462":46431},[],"Enable Replaceable Enrollment",{"_2936":1483,"_25651":1452,"_17922":46433,"_5":17817,"_24317":46348,"_2462":46434},[],"Disabled; the ID must be new.",{"_2936":1484,"_25651":1452,"_17922":46436,"_5":17817,"_24317":46348,"_2462":46437},[],"Initial authentication",{"_2936":1485,"_25651":1452,"_17922":46439,"_5":17817,"_24317":46348,"_2462":46440},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_2936":1486,"_25651":1452,"_17922":46442,"_5":17817,"_24317":46348,"_2462":46443},[],"Renewal authentication",{"_2936":1487,"_25651":1452,"_17922":46445,"_5":17817,"_24317":46348,"_2462":46446},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_2936":1488,"_25651":1452,"_17922":46448,"_5":17817,"_24317":46348,"_2462":46449},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_2936":1489,"_25651":1452,"_17922":46451,"_5":17817,"_24317":46348,"_2462":46452},[],"Empty list for this direct issuance / disabled.",{"_2936":1490,"_25651":1452,"_17922":46454,"_5":17817,"_24317":46348,"_2462":46455},[],"Re-enrollment Delta",{"_2936":1491,"_25651":1452,"_17922":46457,"_5":17817,"_24317":46348,"_2462":46458},[],"1 hour.",{"_2936":1492,"_25651":1452,"_17922":46460,"_5":17817,"_24317":46348,"_2462":46461},[],"Preventive / Critical Delta",{"_2936":1493,"_25651":1452,"_17922":46463,"_5":17817,"_24317":46348,"_2462":46464},[],"30 minutes / 10 minutes.",{"_2936":1494,"_25651":1452,"_17922":46466,"_5":17817,"_24317":46348,"_2462":46467},[],"Revoke on Re-enrollment",{"_2936":1495,"_25651":1452,"_17922":46469,"_5":17817,"_24317":46348,"_2462":46470},[],"Disabled to test the successor before retiring the previous identity.",{"_2936":1496,"_25651":1452,"_17922":46472,"_5":17817,"_24317":46348,"_2462":44499},[],{"_2936":1497,"_25651":1452,"_17922":46474,"_5":17817,"_24317":46348,"_2462":46475},[],"Disabled; the operational key is generated in the client.",{"_2936":1498,"_25651":1452,"_17922":46477,"_5":17817,"_24317":46348,"_2462":46478},[],"CA Distribution",{"_2936":1499,"_25651":1452,"_17922":46480,"_5":17817,"_24317":46348,"_2462":46481},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_2936":1500,"_25651":1452,"_17922":46483,"_5":17817,"_24317":46348,"_2462":46484},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. If your console does not expose the independent block, configure and check the resource through the DMS API and DMS guide.",{"_2936":1501,"_25651":1452,"_17922":46486,"_5":17817,"_24317":46352,"_2462":46487},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_2936":1502,"_25651":1452,"_17922":46489,"_5":17817,"_24317":46352,"_2462":46490},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_2936":1503,"_25651":1452,"_17922":46492,"_5":17817,"_24317":46356,"_2462":46493},[],"Generate a new key and CSR with the selected identifier:",{"_2936":1504,"_25651":1452,"_17922":46495,"_5":17817,"_24317":46356,"_2462":46496},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_2936":1505,"_25651":1452,"_17922":46498,"_5":17817,"_24317":46356,"_2462":46499},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_2936":1506,"_25651":1452,"_17922":46501,"_5":17817,"_24317":46360,"_2462":46502},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_2936":1507,"_25651":1452,"_17922":46504,"_5":17817,"_24317":46360,"_2462":46505},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_2936":1508,"_25651":1452,"_17922":46507,"_5":17817,"_24317":46364,"_2462":46508},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_2936":1509,"_25651":1452,"_17922":46510,"_5":17817,"_24317":46364,"_2462":46511},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_2936":1510,"_25651":1452,"_17922":46513,"_5":17817,"_24317":46364,"_2462":46514},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_2936":1511,"_25651":1452,"_17922":46516,"_5":17817,"_24317":46364,"_2462":46517},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_2936":1512,"_25651":1452,"_17922":46519,"_5":17817,"_24317":46364,"_2462":46520},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_2936":1513,"_25651":1452,"_17922":46522,"_5":17817,"_24317":46368,"_2462":46523},[],"Check",{"_2936":1514,"_25651":1452,"_17922":46525,"_5":17817,"_24317":46368,"_2462":46526},[],"Expected result",{"_2936":1515,"_25651":1452,"_17922":46528,"_5":17817,"_24317":46368,"_2462":46529},[],"Registration",{"_2936":1516,"_25651":1452,"_17922":46531,"_5":17817,"_24317":46368,"_2462":46532},[],"ID created automatically and correct DMS.",{"_2936":1517,"_25651":1452,"_17922":46534,"_5":17817,"_24317":46368,"_2462":46535},[],"Certificate",{"_2936":1518,"_25651":1452,"_17922":46537,"_5":17817,"_24317":46368,"_2462":46538},[],"CN, profile, serial and key verified.",{"_2936":1519,"_25651":1452,"_17922":46540,"_5":17817,"_24317":46368,"_2462":46541},[],"Inventory",{"_2936":1520,"_25651":1452,"_17922":46543,"_5":17817,"_24317":46368,"_2462":46544},[],"Received serial visible as the current identity and in history.",{"_2936":1521,"_25651":1452,"_17922":46546,"_5":17817,"_24317":46368,"_2462":46547},[],"Consumer",{"_2936":1522,"_25651":1452,"_17922":46549,"_5":17817,"_24317":46368,"_2462":46550},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_2936":1523,"_25651":1452,"_17922":46552,"_5":17817,"_24317":46368,"_2462":46553},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_2936":1524,"_25651":1452,"_17922":46555,"_5":17817,"_24317":46368,"_2462":46556},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_2936":1525,"_25651":1525,"_5":12587,"_2462":44196,"_25996":46558,"_17922":46559,"_24317":1525},[41832,43206,44180,46334],[],{"_2936":1526,"_25651":1525,"_17922":46561,"_5":17817,"_24317":1525,"_2462":46562},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_2936":1527,"_25651":1525,"_5":25993,"_17922":46564,"_24317":46565,"_2462":41842},[],"/docs/pr-preview/pr-49/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_2936":1528,"_25651":1525,"_5":25993,"_17922":46567,"_24317":46568,"_2462":46569},[],"/docs/pr-preview/pr-49/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_2936":1529,"_25651":1525,"_5":25993,"_17922":46571,"_24317":46572,"_2462":46573},[],"/docs/pr-preview/pr-49/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_2936":1530,"_25651":1525,"_5":25993,"_17922":46575,"_24317":46576,"_2462":46577},[],"/docs/pr-preview/pr-49/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_2936":1531,"_25651":1525,"_5":25993,"_17922":46579,"_24317":46580,"_2462":46581},[],"/docs/pr-preview/pr-49/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_2936":1532,"_25651":1525,"_5":25993,"_17922":46583,"_24317":46584,"_2462":46585},[],"/docs/pr-preview/pr-49/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_2936":1533,"_25651":1525,"_5":25993,"_17922":46587,"_24317":46588,"_2462":46526},[],"/docs/pr-preview/pr-49/platform/iot-fleets/quickstarts/register-device#expected-result",{"_2936":1534,"_25651":1525,"_5":25993,"_17922":46590,"_24317":46591,"_2462":46592},[],"/docs/pr-preview/pr-49/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_2936":1535,"_25651":1525,"_5":25993,"_17922":46594,"_24317":46595,"_2462":46596},[],"/docs/pr-preview/pr-49/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_2936":1536,"_25651":1525,"_17922":46598,"_5":17817,"_24317":1525,"_2462":46599},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_2936":1537,"_25651":1525,"_17922":46601,"_5":17817,"_24317":1525,"_2462":46602},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_2936":1538,"_25651":1525,"_17922":46604,"_5":17817,"_24317":46565,"_2462":46605},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_2936":1539,"_25651":1525,"_17922":46607,"_5":17817,"_24317":46565,"_2462":46608},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_2936":1540,"_25651":1525,"_17922":46610,"_5":17817,"_24317":46565,"_2462":46611},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_2936":1541,"_25651":1525,"_17922":46613,"_5":17817,"_24317":46565,"_2462":46614},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_2936":1542,"_25651":1525,"_17922":46616,"_5":17817,"_24317":46568,"_2462":46617},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_2936":1543,"_25651":1525,"_17922":46619,"_5":17817,"_24317":46568,"_2462":46620},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_2936":1544,"_25651":1525,"_17922":46622,"_5":17817,"_24317":46568,"_2462":46623},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_2936":1545,"_25651":1525,"_17922":46625,"_5":17817,"_24317":46568,"_2462":46626},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_2936":1546,"_25651":1525,"_17922":46628,"_5":17817,"_24317":46568,"_2462":46629},[],"Set **Authentication Mode** to `CLIENT_CERTIFICATE` and add the CA whose initial certificates you will accept in **Validation CAs**. For this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and server key generation disabled if you will not use it.",{"_2936":1547,"_25651":1525,"_17922":46631,"_5":17817,"_24317":46568,"_2462":46632},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_2936":1548,"_25651":1525,"_17922":46634,"_5":17817,"_24317":46568,"_2462":46635},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_2936":1549,"_25651":1525,"_17922":46637,"_5":17817,"_24317":46568,"_2462":46638},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_2936":1550,"_25651":1525,"_17922":46640,"_5":17817,"_24317":46572,"_2462":46641},[],"Open **Managed Devices** and the registration action. Complete:",{"_2936":1551,"_25651":1525,"_17922":46643,"_5":17817,"_24317":46572,"_2462":46644},[],"**Device ID**: `device-001`.",{"_2936":1552,"_25651":1525,"_17922":46646,"_5":17817,"_24317":46572,"_2462":46647},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_2936":1553,"_25651":1525,"_17922":46649,"_5":17817,"_24317":46572,"_2462":46650},[],"**Icon** and **Tags**: optional classification.",{"_2936":1554,"_25651":1525,"_17922":46652,"_5":17817,"_24317":46572,"_2462":46653},[],"Confirm registration.",{"_2936":1555,"_25651":1525,"_17922":46655,"_5":17817,"_24317":46576,"_2462":46656},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_2936":1556,"_25651":1525,"_17922":46658,"_5":17817,"_24317":46576,"_2462":46659},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_2936":1557,"_25651":1525,"_17922":46661,"_5":17817,"_24317":46580,"_2462":46662},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_2936":1558,"_25651":1525,"_17922":46664,"_5":17817,"_24317":46580,"_2462":46665},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_2936":1559,"_25651":1525,"_17922":46667,"_5":17817,"_24317":46584,"_2462":46668},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_2936":1560,"_25651":1525,"_17922":46670,"_5":17817,"_24317":46584,"_2462":46671},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_2936":1561,"_25651":1525,"_17922":46673,"_5":17817,"_24317":46588,"_2462":46523},[],{"_2936":1562,"_25651":1525,"_17922":46675,"_5":17817,"_24317":46588,"_2462":46676},[],"Result",{"_2936":1563,"_25651":1525,"_17922":46678,"_5":17817,"_24317":46588,"_2462":46679},[],"Device",{"_2936":1564,"_25651":1525,"_17922":46681,"_5":17817,"_24317":46588,"_2462":46682},[],"`device-001` appears in inventory with the expected DMS.",{"_2936":1565,"_25651":1525,"_17922":46684,"_5":17817,"_24317":46588,"_2462":46685},[],"Current identity",{"_2936":1566,"_25651":1525,"_17922":46687,"_5":17817,"_24317":46588,"_2462":46688},[],"The associated certificate matches the one you verified in PKI.",{"_2936":1567,"_25651":1525,"_17922":46690,"_5":17817,"_24317":46588,"_2462":46691},[],"History",{"_2936":1568,"_25651":1525,"_17922":46693,"_5":17817,"_24317":46588,"_2462":46694},[],"The associated issuance appears with its serial number and dates.",{"_2936":1569,"_25651":1525,"_17922":46696,"_5":17817,"_24317":46588,"_2462":46697},[],"Key and certificate",{"_2936":1570,"_25651":1525,"_17922":46699,"_5":17817,"_24317":46588,"_2462":46700},[],"You have the verified pair ready to install on the device.",{"_2936":1571,"_25651":1525,"_17922":46702,"_5":17817,"_24317":46591,"_2462":46703},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_2936":1572,"_25651":1525,"_17922":46705,"_5":17817,"_24317":46591,"_2462":46706},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_2936":1573,"_25651":1525,"_17922":46708,"_5":17817,"_24317":46591,"_2462":46709},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_2936":1574,"_25651":1525,"_17922":46711,"_5":17817,"_24317":46591,"_2462":46712},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_2936":1575,"_25651":1525,"_17922":46714,"_5":17817,"_24317":46595,"_2462":46715},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_2936":1576,"_25651":1525,"_17922":46717,"_5":17817,"_24317":46595,"_2462":46718},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_2936":1577,"_25651":1525,"_17922":46720,"_5":17817,"_24317":46595,"_2462":46721},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_2936":1578,"_25651":1578,"_5":12587,"_2462":46723,"_25996":46724,"_17922":46725,"_24317":1578},"Lamassu IoT Platform",[41832,43206],[],{"_2936":1579,"_25651":1578,"_17922":46727,"_5":17817,"_24317":1578,"_2462":46728},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_2936":1580,"_25651":1578,"_5":25993,"_17922":46730,"_24317":46731,"_2462":46209},[],"/docs/pr-preview/pr-49/platform/overview#start-here",{"_2936":1581,"_25651":1578,"_5":25993,"_17922":46733,"_24317":46734,"_2462":46735},[],"/docs/pr-preview/pr-49/platform/overview#choose-your-path","Choose your path",{"_2936":1582,"_25651":1578,"_5":25993,"_17922":46737,"_24317":46738,"_2462":46739},[],"/docs/pr-preview/pr-49/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_2936":1583,"_25651":1578,"_5":25993,"_17922":46741,"_24317":46742,"_2462":46743},[],"/docs/pr-preview/pr-49/platform/overview#core-capabilities","Core capabilities",{"_2936":1584,"_25651":1578,"_5":25993,"_17922":46745,"_24317":46746,"_2462":46747},[],"/docs/pr-preview/pr-49/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_2936":1585,"_25651":1578,"_5":25993,"_17922":46749,"_24317":46750,"_2462":46751},[],"/docs/pr-preview/pr-49/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_2936":1586,"_25651":1578,"_5":25993,"_17922":46753,"_24317":46754,"_2462":46755},[],"/docs/pr-preview/pr-49/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_2936":1587,"_25651":1578,"_5":25993,"_17922":46757,"_24317":46758,"_2462":46759},[],"/docs/pr-preview/pr-49/platform/overview#automate-device-identities","Automate device identities",{"_2936":1588,"_25651":1578,"_5":25993,"_17922":46761,"_24317":46762,"_2462":46763},[],"/docs/pr-preview/pr-49/platform/overview#publish-validation-status","Publish validation status",{"_2936":1589,"_25651":1578,"_5":25993,"_17922":46765,"_24317":46766,"_2462":46767},[],"/docs/pr-preview/pr-49/platform/overview#react-to-events","React to events",{"_2936":1590,"_25651":1578,"_5":25993,"_17922":46769,"_24317":46770,"_2462":46771},[],"/docs/pr-preview/pr-49/platform/overview#operational-reference","Operational reference",{"_2936":1591,"_25651":1578,"_17922":46773,"_5":17817,"_24317":1578,"_2462":46774},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_2936":1592,"_25651":1578,"_17922":46776,"_5":17817,"_24317":46731,"_2462":46777},[],"Choose the result you need:",{"_2936":1593,"_25651":1578,"_17922":46779,"_5":17817,"_24317":46731,"_2462":46780},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2936":1594,"_25651":1578,"_17922":46782,"_5":17817,"_24317":46731,"_2462":46783},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2936":1595,"_25651":1578,"_17922":46785,"_5":17817,"_24317":46731,"_2462":46786},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_2936":1596,"_25651":1578,"_17922":46788,"_5":17817,"_24317":46734,"_2462":46789},[],"Section",{"_2936":1597,"_25651":1578,"_17922":46791,"_5":17817,"_24317":46734,"_2462":46792},[],"What you manage",{"_2936":1598,"_25651":1578,"_17922":46794,"_5":17817,"_24317":46734,"_2462":46795},[],"Entry point",{"_2936":1599,"_25651":1578,"_17922":46797,"_5":17817,"_24317":46734,"_2462":46798},[],"**PKI**",{"_2936":1600,"_25651":1578,"_17922":46800,"_5":17817,"_24317":46734,"_2462":46801},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_2936":1601,"_25651":1578,"_17922":46803,"_5":17817,"_24317":46734,"_2462":46804},[],"PKI overview",{"_2936":1602,"_25651":1578,"_17922":46806,"_5":17817,"_24317":46734,"_2462":46807},[],"**IoT Fleets**",{"_2936":1603,"_25651":1578,"_17922":46809,"_5":17817,"_24317":46734,"_2462":46810},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_2936":1604,"_25651":1578,"_17922":46812,"_5":17817,"_24317":46734,"_2462":46813},[],"IoT Fleets overview",{"_2936":1605,"_25651":1578,"_17922":46815,"_5":17817,"_24317":46734,"_2462":46816},[],"**Administration**",{"_2936":1606,"_25651":1578,"_17922":46818,"_5":17817,"_24317":46734,"_2462":46819},[],"Operator permissions, audit and event subscriptions.",{"_2936":1607,"_25651":1578,"_17922":46821,"_5":17817,"_24317":46734,"_2462":43204},[],{"_2936":1608,"_25651":1578,"_17922":46823,"_5":17817,"_24317":46734,"_2462":46824},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_2936":1609,"_25651":1578,"_17922":46826,"_5":17817,"_24317":46738,"_2462":46827},[],"An identity's journey connects four responsibilities:",{"_2936":1610,"_25651":1578,"_17922":46829,"_5":17817,"_24317":46738,"_2462":46830},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_2936":1611,"_25651":1578,"_17922":46832,"_5":17817,"_24317":46738,"_2462":46833},[],"The provisioning administrator configures the DMS and initial trust.",{"_2936":1612,"_25651":1578,"_17922":46835,"_5":17817,"_24317":46738,"_2462":46836},[],"The device client requests a certificate and installs it with the matching key.",{"_2936":1613,"_25651":1578,"_17922":46838,"_5":17817,"_24317":46738,"_2462":46839},[],"The consumer validates the identity and applies its access permissions.",{"_2936":1614,"_25651":1578,"_17922":46841,"_5":17817,"_24317":46738,"_2462":46842},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_2936":1615,"_25651":1578,"_17922":46844,"_5":17817,"_24317":46746,"_2462":46845},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_2936":1616,"_25651":1578,"_17922":46847,"_5":17817,"_24317":46750,"_2462":46848},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_2936":1617,"_25651":1578,"_17922":46850,"_5":17817,"_24317":46754,"_2462":46851},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_2936":1618,"_25651":1578,"_17922":46853,"_5":17817,"_24317":46758,"_2462":46854},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_2936":1619,"_25651":1578,"_17922":46856,"_5":17817,"_24317":46762,"_2462":46857},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_2936":1620,"_25651":1578,"_17922":46859,"_5":17817,"_24317":46766,"_2462":46860},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_2936":1621,"_25651":1578,"_17922":46862,"_5":17817,"_24317":46770,"_2462":46303},[],{"_2936":1622,"_25651":1578,"_17922":46864,"_5":17817,"_24317":46770,"_2462":46865},[],"What it prepares or checks",{"_2936":1623,"_25651":1578,"_17922":46867,"_5":17817,"_24317":46770,"_2462":46306},[],{"_2936":1624,"_25651":1578,"_17922":46869,"_5":17817,"_24317":46770,"_2462":46870},[],"Key custody, CA hierarchy, profiles and validation.",{"_2936":1625,"_25651":1578,"_17922":46872,"_5":17817,"_24317":46770,"_2462":46873},[],"Fleet administrator",{"_2936":1626,"_25651":1578,"_17922":46875,"_5":17817,"_24317":46770,"_2462":46876},[],"DMS, device admission, renewal policy and inventory.",{"_2936":1627,"_25651":1578,"_17922":46878,"_5":17817,"_24317":46770,"_2462":46318},[],{"_2936":1628,"_25651":1578,"_17922":46880,"_5":17817,"_24317":46770,"_2462":46881},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_2936":1629,"_25651":1578,"_17922":46883,"_5":17817,"_24317":46770,"_2462":46324},[],{"_2936":1630,"_25651":1578,"_17922":46885,"_5":17817,"_24317":46770,"_2462":46886},[],"Issuer trust, certificate validation and permissions in the destination.",{"_2936":1631,"_25651":1578,"_17922":46888,"_5":17817,"_24317":46770,"_2462":46889},[],"Infrastructure operator",{"_2936":1632,"_25651":1578,"_17922":46891,"_5":17817,"_24317":46770,"_2462":46892},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_2936":1633,"_25651":1578,"_17922":46894,"_5":17817,"_24317":46770,"_2462":46895},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_2936":1634,"_25651":1634,"_5":12587,"_2462":46897,"_25996":46898,"_17922":46901,"_24317":1634},"CA hierarchy and rotation",[41832,43206,46899,46900],"PKI","Keys, authorities and certificates",[],{"_2936":1635,"_25651":1634,"_17922":46903,"_5":17817,"_24317":1634,"_2462":46904},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_2936":1636,"_25651":1634,"_5":25993,"_17922":46906,"_24317":46907,"_2462":46908},[],"/docs/pr-preview/pr-49/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_2936":1637,"_25651":1634,"_5":25993,"_17922":46910,"_24317":46911,"_2462":46912},[],"/docs/pr-preview/pr-49/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_2936":1638,"_25651":1634,"_5":25993,"_17922":46914,"_24317":46915,"_2462":46916},[],"/docs/pr-preview/pr-49/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_2936":1639,"_25651":1634,"_5":25993,"_17922":46918,"_24317":46919,"_2462":46920},[],"/docs/pr-preview/pr-49/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_2936":1640,"_25651":1634,"_5":25993,"_17922":46922,"_24317":46923,"_2462":46924},[],"/docs/pr-preview/pr-49/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_2936":1641,"_25651":1634,"_5":25993,"_17922":46926,"_24317":46927,"_2462":46928},[],"/docs/pr-preview/pr-49/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_2936":1642,"_25651":1634,"_5":25993,"_17922":46930,"_24317":46931,"_2462":46932},[],"/docs/pr-preview/pr-49/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_2936":1643,"_25651":1634,"_5":25993,"_17922":46934,"_24317":46935,"_2462":46936},[],"/docs/pr-preview/pr-49/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_2936":1644,"_25651":1634,"_5":25993,"_17922":46938,"_24317":46939,"_2462":46940},[],"/docs/pr-preview/pr-49/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_2936":1645,"_25651":1634,"_5":25993,"_17922":46942,"_24317":46943,"_2462":46944},[],"/docs/pr-preview/pr-49/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_2936":1646,"_25651":1634,"_5":25993,"_17922":46946,"_24317":46947,"_2462":46948},[],"/docs/pr-preview/pr-49/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_2936":1647,"_25651":1634,"_5":25993,"_17922":46950,"_24317":46951,"_2462":46952},[],"/docs/pr-preview/pr-49/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_2936":1648,"_25651":1634,"_17922":46954,"_5":17817,"_24317":1634,"_2462":46955},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_2936":1649,"_25651":1634,"_17922":46957,"_5":17817,"_24317":1634,"_2462":46958},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_2936":1650,"_25651":1634,"_17922":46960,"_5":17817,"_24317":46907,"_2462":46961},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_2936":1651,"_25651":1634,"_17922":46963,"_5":17817,"_24317":46907,"_2462":46964},[],"environment, such as production and preproduction;",{"_2936":1652,"_25651":1634,"_17922":46966,"_5":17817,"_24317":46907,"_2462":46967},[],"owner or operating team;",{"_2936":1653,"_25651":1634,"_17922":46969,"_5":17817,"_24317":46907,"_2462":46970},[],"device family or manufacturing process;",{"_2936":1654,"_25651":1634,"_17922":46972,"_5":17817,"_24317":46907,"_2462":46973},[],"region or regulatory requirement;",{"_2936":1655,"_25651":1634,"_17922":46975,"_5":17817,"_24317":46907,"_2462":46976},[],"cryptographic engine or key policy;",{"_2936":1656,"_25651":1634,"_17922":46978,"_5":17817,"_24317":46907,"_2462":46979},[],"maintenance window and renewal cadence.",{"_2936":1657,"_25651":1634,"_17922":46981,"_5":17817,"_24317":46907,"_2462":46982},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_2936":1658,"_25651":1634,"_17922":46984,"_5":17817,"_24317":46907,"_2462":46985},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_2936":1659,"_25651":1634,"_17922":46987,"_5":17817,"_24317":46911,"_2462":46988},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_2936":1660,"_25651":1634,"_17922":46990,"_5":17817,"_24317":46911,"_2462":46991},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_2936":1661,"_25651":1634,"_17922":46993,"_5":17817,"_24317":46911,"_2462":46994},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_2936":1662,"_25651":1634,"_17922":46996,"_5":17817,"_24317":46915,"_2462":46997},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_2936":1663,"_25651":1634,"_17922":46999,"_5":17817,"_24317":46915,"_2462":47000},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_2936":1664,"_25651":1634,"_17922":47002,"_5":17817,"_24317":46915,"_2462":47003},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_2936":1665,"_25651":1634,"_17922":47005,"_5":17817,"_24317":46915,"_2462":47006},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_2936":1666,"_25651":1634,"_17922":47008,"_5":17817,"_24317":46923,"_2462":47009},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_2936":1667,"_25651":1634,"_17922":47011,"_5":17817,"_24317":46927,"_2462":47012},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_2936":1668,"_25651":1634,"_17922":47014,"_5":17817,"_24317":46931,"_2462":47015},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_2936":1669,"_25651":1634,"_17922":47017,"_5":17817,"_24317":46935,"_2462":47018},[],"Update the enrollment CA and profile of the DMSs, and add the old CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) while old-CA cohorts still renew. The DMS guide documents the setting.",{"_2936":1670,"_25651":1634,"_17922":47020,"_5":17817,"_24317":46939,"_2462":47021},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_2936":1671,"_25651":1634,"_17922":47023,"_5":17817,"_24317":46943,"_2462":47024},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance and from the distributed CAs. Revoke it if policy requires it.",{"_2936":1672,"_25651":1634,"_17922":47026,"_5":17817,"_24317":46947,"_2462":47027},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_2936":1673,"_25651":1634,"_17922":47029,"_5":17817,"_24317":46947,"_2462":47030},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_2936":1674,"_25651":1634,"_17922":47032,"_5":17817,"_24317":46947,"_2462":47033},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_2936":1675,"_25651":1634,"_17922":47035,"_5":17817,"_24317":46947,"_2462":47036},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_2936":1676,"_25651":1634,"_17922":47038,"_5":17817,"_24317":46951,"_2462":47039},[],"The new chain ends in an anchor installed by the consumer.",{"_2936":1677,"_25651":1634,"_17922":47041,"_5":17817,"_24317":46951,"_2462":47042},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_2936":1678,"_25651":1634,"_17922":47044,"_5":17817,"_24317":46951,"_2462":47045},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_2936":1679,"_25651":1634,"_17922":47047,"_5":17817,"_24317":46951,"_2462":47048},[],"Re-enrollment accepts the old identity during the planned period.",{"_2936":1680,"_25651":1634,"_17922":47050,"_5":17817,"_24317":46951,"_2462":47051},[],"OCSP and CRL respond for the authorities that remain active.",{"_2936":1681,"_25651":1634,"_17922":47053,"_5":17817,"_24317":46951,"_2462":47054},[],"No DMS is left accidentally issuing from the old CA.",{"_2936":1682,"_25651":1634,"_17922":47056,"_5":17817,"_24317":46951,"_2462":47057},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_2936":1683,"_25651":1683,"_5":12587,"_2462":47059,"_25996":47060,"_17922":47061,"_24317":1683},"Certification authorities",[41832,43206,46899,46900],[],{"_2936":1684,"_25651":1683,"_17922":47063,"_5":17817,"_24317":1683,"_2462":47064},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_2936":1685,"_25651":1683,"_5":25993,"_17922":47066,"_24317":47067,"_2462":47068},[],"/docs/pr-preview/pr-49/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_2936":1686,"_25651":1683,"_5":25993,"_17922":47070,"_24317":47071,"_2462":47072},[],"/docs/pr-preview/pr-49/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_2936":1687,"_25651":1683,"_5":25993,"_17922":47074,"_24317":47075,"_2462":41842},[],"/docs/pr-preview/pr-49/platform/pki/certificate-authorities#before-you-begin",{"_2936":1688,"_25651":1683,"_5":25993,"_17922":47077,"_24317":47078,"_2462":47079},[],"/docs/pr-preview/pr-49/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_2936":1689,"_25651":1683,"_5":25993,"_17922":47081,"_24317":47082,"_2462":47083},[],"/docs/pr-preview/pr-49/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_2936":1690,"_25651":1683,"_5":25993,"_17922":47085,"_24317":47086,"_2462":47087},[],"/docs/pr-preview/pr-49/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_2936":1691,"_25651":1683,"_5":25993,"_17922":47089,"_24317":47090,"_2462":47091},[],"/docs/pr-preview/pr-49/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_2936":1692,"_25651":1683,"_5":25993,"_17922":47093,"_24317":47094,"_2462":47095},[],"/docs/pr-preview/pr-49/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_2936":1693,"_25651":1683,"_5":25993,"_17922":47097,"_24317":47098,"_2462":47099},[],"/docs/pr-preview/pr-49/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_2936":1694,"_25651":1683,"_5":25993,"_17922":47101,"_24317":47102,"_2462":47103},[],"/docs/pr-preview/pr-49/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_2936":1695,"_25651":1683,"_5":25993,"_17922":47105,"_24317":47106,"_2462":47107},[],"/docs/pr-preview/pr-49/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_2936":1696,"_25651":1683,"_5":25993,"_17922":47109,"_24317":47110,"_2462":47111},[],"/docs/pr-preview/pr-49/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_2936":1697,"_25651":1683,"_5":25993,"_17922":47113,"_24317":47114,"_2462":47115},[],"/docs/pr-preview/pr-49/platform/pki/certificate-authorities#load-the-material","Load the material",{"_2936":1698,"_25651":1683,"_5":25993,"_17922":47117,"_24317":47118,"_2462":47119},[],"/docs/pr-preview/pr-49/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_2936":1699,"_25651":1683,"_5":25993,"_17922":47121,"_24317":47122,"_2462":47123},[],"/docs/pr-preview/pr-49/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_2936":1700,"_25651":1683,"_5":25993,"_17922":47125,"_24317":47126,"_2462":47127},[],"/docs/pr-preview/pr-49/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_2936":1701,"_25651":1683,"_5":25993,"_17922":47129,"_24317":47130,"_2462":47131},[],"/docs/pr-preview/pr-49/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_2936":1702,"_25651":1683,"_5":25993,"_17922":47133,"_24317":47134,"_2462":47135},[],"/docs/pr-preview/pr-49/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_2936":1703,"_25651":1683,"_5":25993,"_17922":47137,"_24317":47138,"_2462":47139},[],"/docs/pr-preview/pr-49/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_2936":1704,"_25651":1683,"_5":25993,"_17922":47141,"_24317":47142,"_2462":47143},[],"/docs/pr-preview/pr-49/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_2936":1705,"_25651":1683,"_5":25993,"_17922":47145,"_24317":47146,"_2462":47147},[],"/docs/pr-preview/pr-49/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_2936":1706,"_25651":1683,"_5":25993,"_17922":47149,"_24317":47150,"_2462":47151},[],"/docs/pr-preview/pr-49/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_2936":1707,"_25651":1683,"_17922":47153,"_5":17817,"_24317":1683,"_2462":47154},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_2936":1708,"_25651":1683,"_17922":47156,"_5":17817,"_24317":1683,"_2462":47157},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_2936":1709,"_25651":1683,"_17922":47159,"_5":17817,"_24317":1683,"_2462":47160},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_2936":1710,"_25651":1683,"_17922":47162,"_5":17817,"_24317":47067,"_2462":47163},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_2936":1711,"_25651":1683,"_17922":47165,"_5":17817,"_24317":47067,"_2462":47166},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_2936":1712,"_25651":1683,"_17922":47168,"_5":17817,"_24317":47067,"_2462":47169},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_2936":1713,"_25651":1683,"_17922":47171,"_5":17817,"_24317":47067,"_2462":47172},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_2936":1714,"_25651":1683,"_17922":47174,"_5":17817,"_24317":47067,"_2462":47175},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_2936":1715,"_25651":1683,"_17922":47177,"_5":17817,"_24317":47075,"_2462":47178},[],"Decide whether the CA will be a root or an intermediate.",{"_2936":1716,"_25651":1683,"_17922":47180,"_5":17817,"_24317":47075,"_2462":47181},[],"Choose the engine that will keep the key.",{"_2936":1717,"_25651":1683,"_17922":47183,"_5":17817,"_24317":47075,"_2462":47184},[],"Define a validity longer than that of the certificates it will issue.",{"_2936":1718,"_25651":1683,"_17922":47186,"_5":17817,"_24317":47075,"_2462":47187},[],"For an intermediate CA, make sure the parent CA is active.",{"_2936":1719,"_25651":1683,"_17922":47189,"_5":17817,"_24317":47078,"_2462":47190},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_2936":1720,"_25651":1683,"_17922":47192,"_5":17817,"_24317":47082,"_2462":47193},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_2936":1721,"_25651":1683,"_17922":47195,"_5":17817,"_24317":47082,"_2462":47196},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_2936":1722,"_25651":1683,"_17922":47198,"_5":17817,"_24317":47086,"_2462":47199},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_2936":1723,"_25651":1683,"_17922":47201,"_5":17817,"_24317":47090,"_2462":47202},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_2936":1724,"_25651":1683,"_17922":47204,"_5":17817,"_24317":47090,"_2462":47205},[],"`C`: two-letter ISO 3166-1 country code.",{"_2936":1725,"_25651":1683,"_17922":47207,"_5":17817,"_24317":47090,"_2462":47208},[],"`ST`: state or province.",{"_2936":1726,"_25651":1683,"_17922":47210,"_5":17817,"_24317":47090,"_2462":47211},[],"`L`: locality.",{"_2936":1727,"_25651":1683,"_17922":47213,"_5":17817,"_24317":47090,"_2462":47214},[],"`O`: organization.",{"_2936":1728,"_25651":1683,"_17922":47216,"_5":17817,"_24317":47090,"_2462":47217},[],"`OU`: organizational unit.",{"_2936":1729,"_25651":1683,"_17922":47219,"_5":17817,"_24317":47090,"_2462":47220},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_2936":1730,"_25651":1683,"_17922":47222,"_5":17817,"_24317":47094,"_2462":47223},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_2936":1731,"_25651":1683,"_17922":47225,"_5":17817,"_24317":47094,"_2462":47226},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_2936":1732,"_25651":1683,"_17922":47228,"_5":17817,"_24317":47098,"_2462":47229},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_2936":1733,"_25651":1683,"_17922":47231,"_5":17817,"_24317":47098,"_2462":47232},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_2936":1734,"_25651":1683,"_17922":47234,"_5":17817,"_24317":47102,"_2462":47235},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_2936":1735,"_25651":1683,"_17922":47237,"_5":17817,"_24317":47102,"_2462":47238},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_2936":1736,"_25651":1683,"_17922":47240,"_5":17817,"_24317":47106,"_2462":47241},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_2936":1737,"_25651":1683,"_17922":47243,"_5":17817,"_24317":47110,"_2462":47244},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_2936":1738,"_25651":1683,"_17922":47246,"_5":17817,"_24317":47114,"_2462":47247},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_2936":1739,"_25651":1683,"_17922":47249,"_5":17817,"_24317":47118,"_2462":47250},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_2936":1740,"_25651":1683,"_17922":47252,"_5":17817,"_24317":47122,"_2462":47253},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_2936":1741,"_25651":1683,"_17922":47255,"_5":17817,"_24317":47122,"_2462":47256},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_2936":1742,"_25651":1683,"_17922":47258,"_5":17817,"_24317":47126,"_2462":47259},[],"Open a CA from the inventory to review:",{"_2936":1743,"_25651":1683,"_17922":47261,"_5":17817,"_24317":47126,"_2462":47262},[],"Status and validity period.",{"_2936":1744,"_25651":1683,"_17922":47264,"_5":17817,"_24317":47126,"_2462":47265},[],"Certificate and chain in PEM format.",{"_2936":1745,"_25651":1683,"_17922":47267,"_5":17817,"_24317":47126,"_2462":47268},[],"Number of active, expired and revoked certificates.",{"_2936":1746,"_25651":1683,"_17922":47270,"_5":17817,"_24317":47126,"_2462":47271},[],"Certificates issued in **Issued Certificates**.",{"_2936":1747,"_25651":1683,"_17922":47273,"_5":17817,"_24317":47126,"_2462":47274},[],"The CRL linked to the authority.",{"_2936":1748,"_25651":1683,"_17922":47276,"_5":17817,"_24317":47126,"_2462":47277},[],"Metadata and the associated cryptographic engine.",{"_2936":1749,"_25651":1683,"_17922":47279,"_5":17817,"_24317":47126,"_2462":47280},[],"You can filter the inventory by name, status and CA type.",{"_2936":1750,"_25651":1683,"_17922":47282,"_5":17817,"_24317":47130,"_2462":47283},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_2936":1751,"_25651":1683,"_17922":47285,"_5":17817,"_24317":47130,"_2462":47286},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_2936":1752,"_25651":1683,"_17922":47288,"_5":17817,"_24317":47130,"_2462":47289},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_2936":1753,"_25651":1683,"_17922":47291,"_5":17817,"_24317":47130,"_2462":47292},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_2936":1754,"_25651":1683,"_17922":47294,"_5":17817,"_24317":47134,"_2462":47295},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_2936":1755,"_25651":1683,"_17922":47297,"_5":17817,"_24317":47138,"_2462":47298},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_2936":1756,"_25651":1683,"_17922":47300,"_5":17817,"_24317":47142,"_2462":47301},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_2936":1757,"_25651":1683,"_17922":47303,"_5":17817,"_24317":47146,"_2462":47304},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_2936":1758,"_25651":1683,"_17922":47306,"_5":17817,"_24317":47150,"_2462":47307},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_2936":1759,"_25651":1683,"_17922":47309,"_5":17817,"_24317":47150,"_2462":47310},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_2936":1760,"_25651":1760,"_5":12587,"_2462":47312,"_25996":47313,"_17922":47314,"_24317":1760},"Certificate profiles",[41832,43206,46899,46900],[],{"_2936":1761,"_25651":1760,"_17922":47316,"_5":17817,"_24317":1760,"_2462":47317},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_2936":1762,"_25651":1760,"_5":25993,"_17922":47319,"_24317":47320,"_2462":47321},[],"/docs/pr-preview/pr-49/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_2936":1763,"_25651":1760,"_5":25993,"_17922":47323,"_24317":47324,"_2462":47325},[],"/docs/pr-preview/pr-49/platform/pki/certificate-profiles#validity","Validity",{"_2936":1764,"_25651":1760,"_5":25993,"_17922":47327,"_24317":47328,"_2462":47329},[],"/docs/pr-preview/pr-49/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_2936":1765,"_25651":1760,"_5":25993,"_17922":47331,"_24317":47332,"_2462":47333},[],"/docs/pr-preview/pr-49/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_2936":1766,"_25651":1760,"_5":25993,"_17922":47335,"_24317":47336,"_2462":47337},[],"/docs/pr-preview/pr-49/platform/pki/certificate-profiles#subject","Subject",{"_2936":1767,"_25651":1760,"_5":25993,"_17922":47339,"_24317":47340,"_2462":47341},[],"/docs/pr-preview/pr-49/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_2936":1768,"_25651":1760,"_5":25993,"_17922":47343,"_24317":47344,"_2462":47345},[],"/docs/pr-preview/pr-49/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_2936":1769,"_25651":1760,"_5":25993,"_17922":47347,"_24317":47348,"_2462":47349},[],"/docs/pr-preview/pr-49/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_2936":1770,"_25651":1760,"_5":25993,"_17922":47351,"_24317":47352,"_2462":47353},[],"/docs/pr-preview/pr-49/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_2936":1771,"_25651":1760,"_5":25993,"_17922":47355,"_24317":47356,"_2462":47357},[],"/docs/pr-preview/pr-49/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_2936":1772,"_25651":1760,"_5":25993,"_17922":47359,"_24317":47360,"_2462":47361},[],"/docs/pr-preview/pr-49/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_2936":1773,"_25651":1760,"_5":25993,"_17922":47363,"_24317":47364,"_2462":47365},[],"/docs/pr-preview/pr-49/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_2936":1774,"_25651":1760,"_5":25993,"_17922":47367,"_24317":47368,"_2462":47369},[],"/docs/pr-preview/pr-49/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_2936":1775,"_25651":1760,"_5":25993,"_17922":47371,"_24317":47372,"_2462":47373},[],"/docs/pr-preview/pr-49/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_2936":1776,"_25651":1760,"_5":25993,"_17922":47375,"_24317":47376,"_2462":47377},[],"/docs/pr-preview/pr-49/platform/pki/certificate-profiles#design-examples","Design examples",{"_2936":1777,"_25651":1760,"_5":25993,"_17922":47379,"_24317":47380,"_2462":47381},[],"/docs/pr-preview/pr-49/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_2936":1778,"_25651":1760,"_17922":47383,"_5":17817,"_24317":1760,"_2462":47384},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_2936":1779,"_25651":1760,"_17922":47386,"_5":17817,"_24317":1760,"_2462":47387},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_2936":1780,"_25651":1760,"_17922":47389,"_5":17817,"_24317":47324,"_2462":47390},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_2936":1781,"_25651":1760,"_17922":47392,"_5":17817,"_24317":47324,"_2462":47393},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_2936":1782,"_25651":1760,"_17922":47395,"_5":17817,"_24317":47328,"_2462":47396},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_2936":1783,"_25651":1760,"_17922":47398,"_5":17817,"_24317":47332,"_2462":47399},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_2936":1784,"_25651":1760,"_17922":47401,"_5":17817,"_24317":47332,"_2462":47402},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_2936":1785,"_25651":1760,"_17922":47404,"_5":17817,"_24317":47332,"_2462":47405},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_2936":1786,"_25651":1760,"_17922":47407,"_5":17817,"_24317":47336,"_2462":47408},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_2936":1787,"_25651":1760,"_17922":47410,"_5":17817,"_24317":47340,"_2462":47411},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_2936":1788,"_25651":1760,"_17922":47413,"_5":17817,"_24317":47340,"_2462":47414},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_2936":1789,"_25651":1760,"_17922":47416,"_5":17817,"_24317":47344,"_2462":47417},[],"The cryptographic enforcement can:",{"_2936":1790,"_25651":1760,"_17922":47419,"_5":17817,"_24317":47344,"_2462":47420},[],"allow or block RSA keys;",{"_2936":1791,"_25651":1760,"_17922":47422,"_5":17817,"_24317":47344,"_2462":47423},[],"limit the supported RSA sizes;",{"_2936":1792,"_25651":1760,"_17922":47425,"_5":17817,"_24317":47344,"_2462":47426},[],"allow or block ECDSA keys;",{"_2936":1793,"_25651":1760,"_17922":47428,"_5":17817,"_24317":47344,"_2462":47429},[],"limit the supported ECDSA sizes or curves.",{"_2936":1794,"_25651":1760,"_17922":47431,"_5":17817,"_24317":47344,"_2462":47432},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_2936":1795,"_25651":1760,"_17922":47434,"_5":17817,"_24317":47348,"_2462":47435},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_2936":1796,"_25651":1760,"_17922":47437,"_5":17817,"_24317":47348,"_2462":44927},[],{"_2936":1797,"_25651":1760,"_17922":47439,"_5":17817,"_24317":47348,"_2462":47440},[],"First choice",{"_2936":1798,"_25651":1760,"_17922":47442,"_5":17817,"_24317":47348,"_2462":47443},[],"Second choice",{"_2936":1799,"_25651":1760,"_17922":47445,"_5":17817,"_24317":47348,"_2462":47446},[],"If neither is supplied",{"_2936":1800,"_25651":1760,"_17922":47448,"_5":17817,"_24317":47348,"_2462":47449},[],"Direct signing with a CA",{"_2936":1801,"_25651":1760,"_17922":47451,"_5":17817,"_24317":47348,"_2462":47452},[],"`issuance_profile` embedded in the request",{"_2936":1802,"_25651":1760,"_17922":47454,"_5":17817,"_24317":47348,"_2462":47455},[],"Request `issuance_profile_id`",{"_2936":1803,"_25651":1760,"_17922":47457,"_5":17817,"_24317":47348,"_2462":47458},[],"CA default profile (`profile_id`).",{"_2936":1804,"_25651":1760,"_17922":47460,"_5":17817,"_24317":47348,"_2462":47461},[],"Issuance through a DMS",{"_2936":1805,"_25651":1760,"_17922":47463,"_5":17817,"_24317":47348,"_2462":47464},[],"`settings.issuance_profile_id`",{"_2936":1806,"_25651":1760,"_17922":47466,"_5":17817,"_24317":47348,"_2462":47467},[],"`settings.issuance_profile` embedded in the DMS",{"_2936":1807,"_25651":1760,"_17922":47469,"_5":17817,"_24317":47348,"_2462":47470},[],"Enrollment CA default profile.",{"_2936":1808,"_25651":1760,"_17922":47472,"_5":17817,"_24317":47348,"_2462":47473},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_2936":1809,"_25651":1760,"_17922":47475,"_5":17817,"_24317":47348,"_2462":47476},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_2936":1810,"_25651":1760,"_17922":47478,"_5":17817,"_24317":47356,"_2462":47479},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_2936":1811,"_25651":1760,"_17922":47481,"_5":17817,"_24317":47360,"_2462":47482},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_2936":1812,"_25651":1760,"_17922":47484,"_5":17817,"_24317":47364,"_2462":47485},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_2936":1813,"_25651":1760,"_17922":47487,"_5":17817,"_24317":47368,"_2462":47488},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_2936":1814,"_25651":1760,"_17922":47490,"_5":17817,"_24317":47372,"_2462":47491},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_2936":1815,"_25651":1760,"_17922":47493,"_5":17817,"_24317":47372,"_2462":47494},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_2936":1816,"_25651":1760,"_17922":47496,"_5":17817,"_24317":47376,"_2462":47497},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_2936":1817,"_25651":1760,"_17922":47499,"_5":17817,"_24317":47376,"_2462":47500},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_2936":1818,"_25651":1760,"_17922":47502,"_5":17817,"_24317":47376,"_2462":47503},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_2936":1819,"_25651":1760,"_17922":47505,"_5":17817,"_24317":47376,"_2462":47506},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_2936":1820,"_25651":1760,"_17922":47508,"_5":17817,"_24317":47380,"_2462":47509},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_2936":1821,"_25651":1760,"_17922":47511,"_5":17817,"_24317":47380,"_2462":47512},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_2936":1822,"_25651":1822,"_5":12587,"_2462":47514,"_25996":47515,"_17922":47517,"_24317":1822},"Certificate validation",[41832,43206,46899,47516],"Validation",[],{"_2936":1823,"_25651":1822,"_17922":47519,"_5":17817,"_24317":1822,"_2462":47520},[],"Check chain, identity, purpose and revocation from the consumer.",{"_2936":1824,"_25651":1822,"_5":25993,"_17922":47522,"_24317":47523,"_2462":47524},[],"/docs/pr-preview/pr-49/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_2936":1825,"_25651":1822,"_5":25993,"_17922":47526,"_24317":47527,"_2462":47528},[],"/docs/pr-preview/pr-49/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_2936":1826,"_25651":1822,"_5":25993,"_17922":47530,"_24317":47531,"_2462":47532},[],"/docs/pr-preview/pr-49/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_2936":1827,"_25651":1822,"_17922":47534,"_5":17817,"_24317":1822,"_2462":47535},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_2936":1828,"_25651":1822,"_17922":47537,"_5":17817,"_24317":47523,"_2462":47538},[],"Verify these criteria together:",{"_2936":1829,"_25651":1822,"_17922":47540,"_5":17817,"_24317":47523,"_2462":46523},[],{"_2936":1830,"_25651":1822,"_17922":47542,"_5":17817,"_24317":47523,"_2462":47543},[],"Required result",{"_2936":1831,"_25651":1822,"_17922":47545,"_5":17817,"_24317":47523,"_2462":47546},[],"Chain and signature",{"_2936":1832,"_25651":1822,"_17922":47548,"_5":17817,"_24317":47523,"_2462":47549},[],"Valid chain to a root deliberately installed in the consumer.",{"_2936":1833,"_25651":1822,"_17922":47551,"_5":17817,"_24317":47523,"_2462":47552},[],"Dates",{"_2936":1834,"_25651":1822,"_17922":47554,"_5":17817,"_24317":47523,"_2462":47555},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_2936":1835,"_25651":1822,"_17922":47557,"_5":17817,"_24317":47523,"_2462":42909},[],{"_2936":1836,"_25651":1822,"_17922":47559,"_5":17817,"_24317":47523,"_2462":47560},[],"Name, SAN or identifier matches the expected peer.",{"_2936":1837,"_25651":1822,"_17922":47562,"_5":17817,"_24317":47523,"_2462":42219},[],{"_2936":1838,"_25651":1822,"_17922":47564,"_5":17817,"_24317":47523,"_2462":47565},[],"KU, EKU and constraints permit the specific operation.",{"_2936":1839,"_25651":1822,"_17922":47567,"_5":17817,"_24317":47523,"_2462":47568},[],"Revocation",{"_2936":1840,"_25651":1822,"_17922":47570,"_5":17817,"_24317":47523,"_2462":47571},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_2936":1841,"_25651":1822,"_17922":47573,"_5":17817,"_24317":47523,"_2462":47574},[],"Authorization",{"_2936":1842,"_25651":1822,"_17922":47576,"_5":17817,"_24317":47523,"_2462":47577},[],"The application permits that identity to perform the action.",{"_2936":1843,"_25651":1822,"_17922":47579,"_5":17817,"_24317":47523,"_2462":47580},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_2936":1844,"_25651":1822,"_17922":47582,"_5":17817,"_24317":47527,"_2462":47583},[],"Mechanism",{"_2936":1845,"_25651":1822,"_17922":47585,"_5":17817,"_24317":47527,"_2462":47586},[],"When to use it",{"_2936":1846,"_25651":1822,"_17922":47588,"_5":17817,"_24317":47527,"_2462":47589},[],"What you must maintain",{"_2936":1847,"_25651":1822,"_17922":47591,"_5":17817,"_24317":47527,"_2462":47592},[],"OCSP",{"_2936":1848,"_25651":1822,"_17922":47594,"_5":17817,"_24317":47527,"_2462":47595},[],"Status query for a specific certificate.",{"_2936":1849,"_25651":1822,"_17922":47597,"_5":17817,"_24317":47527,"_2462":47598},[],"Responder access, signature verification and cache/freshness policy.",{"_2936":1850,"_25651":1822,"_17922":47600,"_5":17817,"_24317":47527,"_2462":47601},[],"CRL",{"_2936":1851,"_25651":1822,"_17922":47603,"_5":17817,"_24317":47527,"_2462":47604},[],"Local checks for many certificates or offline operation.",{"_2936":1852,"_25651":1822,"_17922":47606,"_5":17817,"_24317":47527,"_2462":47607},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_2936":1853,"_25651":1822,"_17922":47609,"_5":17817,"_24317":47527,"_2462":47610},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_2936":1854,"_25651":1822,"_17922":47612,"_5":17817,"_24317":47527,"_2462":47613},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_2936":1855,"_25651":1822,"_17922":47615,"_5":17817,"_24317":47531,"_2462":47616},[],"Accept a current, authorized certificate with a known chain.",{"_2936":1856,"_25651":1822,"_17922":47618,"_5":17817,"_24317":47531,"_2462":47619},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_2936":1857,"_25651":1822,"_17922":47621,"_5":17817,"_24317":47531,"_2462":47622},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_2936":1858,"_25651":1822,"_17922":47624,"_5":17817,"_24317":47531,"_2462":47625},[],"Check that a new connection with that identity is rejected.",{"_2936":1859,"_25651":1822,"_17922":47627,"_5":17817,"_24317":47531,"_2462":47628},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_2936":1860,"_25651":1822,"_17922":47630,"_5":17817,"_24317":47531,"_2462":47631},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_2936":1861,"_25651":1822,"_17922":47633,"_5":17817,"_24317":47531,"_2462":47634},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_2936":1862,"_25651":1822,"_17922":47636,"_5":17817,"_24317":47531,"_2462":47637},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_2936":1863,"_25651":1822,"_17922":47639,"_5":17817,"_24317":47531,"_2462":47640},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_2936":1864,"_25651":1864,"_5":12587,"_2462":47642,"_25996":47643,"_17922":47644,"_24317":1864},"Certificates",[41832,43206,46899,46900],[],{"_2936":1865,"_25651":1864,"_17922":47646,"_5":17817,"_24317":1864,"_2462":47647},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_2936":1866,"_25651":1864,"_5":25993,"_17922":47649,"_24317":47650,"_2462":47651},[],"/docs/pr-preview/pr-49/platform/pki/certificates#find-a-certificate","Find a certificate",{"_2936":1867,"_25651":1864,"_5":25993,"_17922":47653,"_24317":47654,"_2462":47655},[],"/docs/pr-preview/pr-49/platform/pki/certificates#download-the-certificate","Download the certificate",{"_2936":1868,"_25651":1864,"_5":25993,"_17922":47657,"_24317":47658,"_2462":47659},[],"/docs/pr-preview/pr-49/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_2936":1869,"_25651":1864,"_5":25993,"_17922":47661,"_24317":47662,"_2462":47663},[],"/docs/pr-preview/pr-49/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_2936":1870,"_25651":1864,"_5":25993,"_17922":47665,"_24317":47666,"_2462":47667},[],"/docs/pr-preview/pr-49/platform/pki/certificates#open-the-action","Open the action",{"_2936":1871,"_25651":1864,"_5":25993,"_17922":47669,"_24317":47670,"_2462":47671},[],"/docs/pr-preview/pr-49/platform/pki/certificates#choose-a-reason","Choose a reason",{"_2936":1872,"_25651":1864,"_5":25993,"_17922":47673,"_24317":47674,"_2462":47675},[],"/docs/pr-preview/pr-49/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_2936":1873,"_25651":1864,"_5":25993,"_17922":47677,"_24317":47678,"_2462":47679},[],"/docs/pr-preview/pr-49/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_2936":1874,"_25651":1864,"_5":25993,"_17922":47681,"_24317":47682,"_2462":47683},[],"/docs/pr-preview/pr-49/platform/pki/certificates#continue","Continue",{"_2936":1875,"_25651":1864,"_17922":47685,"_5":17817,"_24317":1864,"_2462":47686},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_2936":1876,"_25651":1864,"_17922":47688,"_5":17817,"_24317":47650,"_2462":47689},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_2936":1877,"_25651":1864,"_17922":47691,"_5":17817,"_24317":47650,"_2462":47692},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_2936":1878,"_25651":1864,"_17922":47694,"_5":17817,"_24317":47654,"_2462":47695},[],"Download the PEM and inspect it:",{"_2936":1879,"_25651":1864,"_17922":47697,"_5":17817,"_24317":47654,"_2462":47698},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_2936":1880,"_25651":1864,"_17922":47700,"_5":17817,"_24317":47658,"_2462":47701},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_2936":1881,"_25651":1864,"_17922":47703,"_5":17817,"_24317":47658,"_2462":47704},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_2936":1882,"_25651":1864,"_17922":47706,"_5":17817,"_24317":47658,"_2462":47707},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_2936":1883,"_25651":1864,"_17922":47709,"_5":17817,"_24317":47658,"_2462":47710},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_2936":1884,"_25651":1864,"_17922":47712,"_5":17817,"_24317":47658,"_2462":47713},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_2936":1885,"_25651":1864,"_17922":47715,"_5":17817,"_24317":47658,"_2462":47716},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_2936":1886,"_25651":1864,"_17922":47718,"_5":17817,"_24317":47658,"_2462":47719},[],"For browser key generation, follow Issue your first certificate.",{"_2936":1887,"_25651":1864,"_17922":47721,"_5":17817,"_24317":47662,"_2462":47722},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_2936":1888,"_25651":1864,"_17922":47724,"_5":17817,"_24317":47666,"_2462":47725},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_2936":1889,"_25651":1864,"_17922":47727,"_5":17817,"_24317":47670,"_2462":47728},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_2936":1890,"_25651":1864,"_17922":47730,"_5":17817,"_24317":47674,"_2462":47731},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_2936":1891,"_25651":1864,"_17922":47733,"_5":17817,"_24317":47674,"_2462":47734},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_2936":1892,"_25651":1864,"_17922":47736,"_5":17817,"_24317":47674,"_2462":47737},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_2936":1893,"_25651":1864,"_17922":47739,"_5":17817,"_24317":47678,"_2462":47740},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_2936":1894,"_25651":1864,"_17922":47742,"_5":17817,"_24317":47678,"_2462":47743},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_2936":1895,"_25651":1864,"_17922":47745,"_5":17817,"_24317":47678,"_2462":47746},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_2936":1896,"_25651":1864,"_17922":47748,"_5":17817,"_24317":47682,"_2462":47749},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_2936":1897,"_25651":1864,"_17922":47751,"_5":17817,"_24317":47682,"_2462":47752},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_2936":1898,"_25651":1898,"_5":12587,"_2462":47754,"_25996":47755,"_17922":47757,"_24317":1898},"Certificate lifecycle",[41832,43206,46899,47756],"Concepts",[],{"_2936":1899,"_25651":1898,"_17922":47759,"_5":17817,"_24317":1898,"_2462":47760},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_2936":1900,"_25651":1898,"_5":25993,"_17922":47762,"_24317":47763,"_2462":47764},[],"/docs/pr-preview/pr-49/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_2936":1901,"_25651":1898,"_5":25993,"_17922":47766,"_24317":47767,"_2462":47768},[],"/docs/pr-preview/pr-49/platform/pki/concepts/certificate-lifecycle#request","Request",{"_2936":1902,"_25651":1898,"_5":25993,"_17922":47770,"_24317":47771,"_2462":47772},[],"/docs/pr-preview/pr-49/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_2936":1903,"_25651":1898,"_5":25993,"_17922":47774,"_24317":47775,"_2462":47776},[],"/docs/pr-preview/pr-49/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_2936":1904,"_25651":1898,"_5":25993,"_17922":47778,"_24317":47779,"_2462":47780},[],"/docs/pr-preview/pr-49/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_2936":1905,"_25651":1898,"_5":25993,"_17922":47782,"_24317":47783,"_2462":47784},[],"/docs/pr-preview/pr-49/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_2936":1906,"_25651":1898,"_5":25993,"_17922":47786,"_24317":47787,"_2462":47788},[],"/docs/pr-preview/pr-49/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_2936":1907,"_25651":1898,"_5":25993,"_17922":47790,"_24317":47791,"_2462":47792},[],"/docs/pr-preview/pr-49/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_2936":1908,"_25651":1898,"_5":25993,"_17922":47794,"_24317":47795,"_2462":47796},[],"/docs/pr-preview/pr-49/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_2936":1909,"_25651":1898,"_5":25993,"_17922":47798,"_24317":47799,"_2462":47800},[],"/docs/pr-preview/pr-49/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_2936":1910,"_25651":1898,"_17922":47802,"_5":17817,"_24317":1898,"_2462":47803},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_2936":1911,"_25651":1898,"_17922":47805,"_5":17817,"_24317":47767,"_2462":47806},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_2936":1912,"_25651":1898,"_17922":47808,"_5":17817,"_24317":47771,"_2462":47809},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_2936":1913,"_25651":1898,"_17922":47811,"_5":17817,"_24317":47775,"_2462":47812},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_2936":1914,"_25651":1898,"_17922":47814,"_5":17817,"_24317":47779,"_2462":47815},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_2936":1915,"_25651":1898,"_17922":47817,"_5":17817,"_24317":47783,"_2462":47818},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_2936":1916,"_25651":1898,"_17922":47820,"_5":17817,"_24317":47787,"_2462":47821},[],"Lamassu persists four X.509 states:",{"_2936":1917,"_25651":1898,"_17922":47823,"_5":17817,"_24317":47787,"_2462":47824},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_2936":1918,"_25651":1898,"_17922":47826,"_5":17817,"_24317":47787,"_2462":47827},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_2936":1919,"_25651":1898,"_17922":47829,"_5":17817,"_24317":47787,"_2462":47830},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_2936":1920,"_25651":1898,"_17922":47832,"_5":17817,"_24317":47787,"_2462":47833},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_2936":1921,"_25651":1898,"_17922":47835,"_5":17817,"_24317":47787,"_2462":47836},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_2936":1922,"_25651":1898,"_17922":47838,"_5":17817,"_24317":47791,"_2462":47839},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_2936":1923,"_25651":1898,"_17922":47841,"_5":17817,"_24317":47791,"_2462":47842},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_2936":1924,"_25651":1898,"_17922":47844,"_5":17817,"_24317":47791,"_2462":47845},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_2936":1925,"_25651":1898,"_17922":47847,"_5":17817,"_24317":47795,"_2462":47848},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_2936":1926,"_25651":1898,"_17922":47850,"_5":17817,"_24317":47795,"_2462":47851},[],"Before confirming:",{"_2936":1927,"_25651":1898,"_17922":47853,"_5":17817,"_24317":47795,"_2462":47854},[],"Identify DMSs, devices and services that trust that chain.",{"_2936":1928,"_25651":1898,"_17922":47856,"_5":17817,"_24317":47795,"_2462":47857},[],"Distribute the new chain of trust.",{"_2936":1929,"_25651":1898,"_17922":47859,"_5":17817,"_24317":47795,"_2462":47860},[],"Reissue the necessary identities.",{"_2936":1930,"_25651":1898,"_17922":47862,"_5":17817,"_24317":47795,"_2462":47863},[],"Check OCSP and CRL from a real consumer.",{"_2936":1931,"_25651":1898,"_17922":47865,"_5":17817,"_24317":47795,"_2462":47866},[],"Revoke the old CA once no legitimate traffic remains.",{"_2936":1932,"_25651":1898,"_17922":47868,"_5":17817,"_24317":47795,"_2462":47869},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_2936":1933,"_25651":1898,"_17922":47871,"_5":17817,"_24317":47799,"_2462":47872},[],"Certificates entering the preventive or critical renewal window.",{"_2936":1934,"_25651":1898,"_17922":47874,"_5":17817,"_24317":47799,"_2462":47875},[],"Repeated enrollment or re-enrollment failures.",{"_2936":1935,"_25651":1898,"_17922":47877,"_5":17817,"_24317":47799,"_2462":47878},[],"Status changes and revocation reasons.",{"_2936":1936,"_25651":1898,"_17922":47880,"_5":17817,"_24317":47799,"_2462":47881},[],"OCSP and CRL publication and validity.",{"_2936":1937,"_25651":1898,"_17922":47883,"_5":17817,"_24317":47799,"_2462":47884},[],"Dependencies still presenting a replaced certificate.",{"_2936":1938,"_25651":1898,"_17922":47886,"_5":17817,"_24317":47799,"_2462":47887},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_2936":1939,"_25651":1939,"_5":12587,"_2462":47889,"_25996":47890,"_17922":47891,"_24317":1939},"Trust model",[41832,43206,46899,47756],[],{"_2936":1940,"_25651":1939,"_17922":47893,"_5":17817,"_24317":1939,"_2462":47894},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_2936":1941,"_25651":1939,"_5":25993,"_17922":47896,"_24317":47897,"_2462":47898},[],"/docs/pr-preview/pr-49/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_2936":1942,"_25651":1939,"_5":25993,"_17922":47900,"_24317":47901,"_2462":47902},[],"/docs/pr-preview/pr-49/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_2936":1943,"_25651":1939,"_5":25993,"_17922":47904,"_24317":47905,"_2462":47906},[],"/docs/pr-preview/pr-49/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_2936":1944,"_25651":1939,"_5":25993,"_17922":47908,"_24317":47909,"_2462":47910},[],"/docs/pr-preview/pr-49/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_2936":1945,"_25651":1939,"_5":25993,"_17922":47912,"_24317":47913,"_2462":47914},[],"/docs/pr-preview/pr-49/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_2936":1946,"_25651":1939,"_5":25993,"_17922":47916,"_24317":47917,"_2462":47918},[],"/docs/pr-preview/pr-49/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_2936":1947,"_25651":1939,"_5":25993,"_17922":47920,"_24317":47921,"_2462":47922},[],"/docs/pr-preview/pr-49/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_2936":1948,"_25651":1939,"_5":25993,"_17922":47924,"_24317":47925,"_2462":47926},[],"/docs/pr-preview/pr-49/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_2936":1949,"_25651":1939,"_5":25993,"_17922":47928,"_24317":47929,"_2462":47930},[],"/docs/pr-preview/pr-49/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_2936":1950,"_25651":1939,"_5":25993,"_17922":47932,"_24317":47933,"_2462":47934},[],"/docs/pr-preview/pr-49/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_2936":1951,"_25651":1939,"_17922":47936,"_5":17817,"_24317":1939,"_2462":47937},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_2936":1952,"_25651":1939,"_17922":47939,"_5":17817,"_24317":47901,"_2462":47940},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_2936":1953,"_25651":1939,"_17922":47942,"_5":17817,"_24317":47905,"_2462":47943},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_2936":1954,"_25651":1939,"_17922":47945,"_5":17817,"_24317":47909,"_2462":47946},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_2936":1955,"_25651":1939,"_17922":47948,"_5":17817,"_24317":47913,"_2462":47949},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_2936":1956,"_25651":1939,"_17922":47951,"_5":17817,"_24317":47917,"_2462":47952},[],"The device proves it can enroll according to the DMS policy.",{"_2936":1957,"_25651":1939,"_17922":47954,"_5":17817,"_24317":47917,"_2462":47955},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_2936":1958,"_25651":1939,"_17922":47957,"_5":17817,"_24317":47917,"_2462":47958},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_2936":1959,"_25651":1939,"_17922":47960,"_5":17817,"_24317":47917,"_2462":47961},[],"The device installs the certificate and the chain it needs.",{"_2936":1960,"_25651":1939,"_17922":47963,"_5":17817,"_24317":47917,"_2462":47964},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_2936":1961,"_25651":1939,"_17922":47966,"_5":17817,"_24317":47917,"_2462":47967},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_2936":1962,"_25651":1939,"_17922":47969,"_5":17817,"_24317":47921,"_2462":47970},[],"A DMS relates three sets that are worth designing separately:",{"_2936":1963,"_25651":1939,"_17922":47972,"_5":17817,"_24317":47921,"_2462":47973},[],"**Enrollment CA:** signs the new identities.",{"_2936":1964,"_25651":1939,"_17922":47975,"_5":17817,"_24317":47921,"_2462":47976},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, Lamassu tries the enrollment CA first and then the validation CAs configured in the re-enrollment block.",{"_2936":1965,"_25651":1939,"_17922":47978,"_5":17817,"_24317":47921,"_2462":47979},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_2936":1966,"_25651":1939,"_17922":47981,"_5":17817,"_24317":47921,"_2462":47982},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_2936":1967,"_25651":1939,"_17922":47984,"_5":17817,"_24317":47925,"_2462":47985},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_2936":1968,"_25651":1939,"_17922":47987,"_5":17817,"_24317":47925,"_2462":47988},[],"that the current date is between `Not Before` and `Not After`;",{"_2936":1969,"_25651":1939,"_17922":47990,"_5":17817,"_24317":47925,"_2462":47991},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_2936":1970,"_25651":1939,"_17922":47993,"_5":17817,"_24317":47925,"_2462":47994},[],"that names, SANs and subject match the expected identity;",{"_2936":1971,"_25651":1939,"_17922":47996,"_5":17817,"_24317":47925,"_2462":47997},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_2936":1972,"_25651":1939,"_17922":47999,"_5":17817,"_24317":47925,"_2462":48000},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_2936":1973,"_25651":1939,"_17922":48002,"_5":17817,"_24317":47925,"_2462":48003},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_2936":1974,"_25651":1939,"_17922":48005,"_5":17817,"_24317":47929,"_2462":48006},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_2936":1975,"_25651":1939,"_17922":48008,"_5":17817,"_24317":47933,"_2462":48009},[],"Keep the root out of daily operations, or with very restricted access.",{"_2936":1976,"_25651":1939,"_17922":48011,"_5":17817,"_24317":47933,"_2462":48012},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_2936":1977,"_25651":1939,"_17922":48014,"_5":17817,"_24317":47933,"_2462":48015},[],"Assign explicit profiles to every use case.",{"_2936":1978,"_25651":1939,"_17922":48017,"_5":17817,"_24317":47933,"_2462":48018},[],"Distribute the new trust before starting a rotation.",{"_2936":1979,"_25651":1939,"_17922":48020,"_5":17817,"_24317":47933,"_2462":48021},[],"Keep enough overlap to renew a disconnected fleet.",{"_2936":1980,"_25651":1939,"_17922":48023,"_5":17817,"_24317":47933,"_2462":48024},[],"Validate from the consuming system, not only from the Lamassu console.",{"_2936":1981,"_25651":1939,"_17922":48026,"_5":17817,"_24317":47933,"_2462":48027},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_2936":1982,"_25651":1982,"_5":12587,"_2462":48029,"_25996":48030,"_17922":48031,"_24317":1982},"Revocation lists (CRL)",[41832,43206,46899,47516],[],{"_2936":1983,"_25651":1982,"_17922":48033,"_5":17817,"_24317":1982,"_2462":48034},[],"Generate and distribute signed lists to validate certificates offline.",{"_2936":1984,"_25651":1982,"_5":25993,"_17922":48036,"_24317":48037,"_2462":48038},[],"/docs/pr-preview/pr-49/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_2936":1985,"_25651":1982,"_5":25993,"_17922":48040,"_24317":48041,"_2462":48042},[],"/docs/pr-preview/pr-49/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_2936":1986,"_25651":1982,"_5":25993,"_17922":48044,"_24317":48045,"_2462":48046},[],"/docs/pr-preview/pr-49/platform/pki/crl#crl-contents","CRL contents",{"_2936":1987,"_25651":1982,"_5":25993,"_17922":48048,"_24317":48049,"_2462":48050},[],"/docs/pr-preview/pr-49/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_2936":1988,"_25651":1982,"_5":25993,"_17922":48052,"_24317":48053,"_2462":48054},[],"/docs/pr-preview/pr-49/platform/pki/crl#va-role-management-api","VA role management API",{"_2936":1989,"_25651":1982,"_5":25993,"_17922":48056,"_24317":48057,"_2462":48058},[],"/docs/pr-preview/pr-49/platform/pki/crl#from-the-interface","From the interface",{"_2936":1990,"_25651":1982,"_5":25993,"_17922":48060,"_24317":48061,"_2462":48062},[],"/docs/pr-preview/pr-49/platform/pki/crl#references","References",{"_2936":1991,"_25651":1982,"_17922":48064,"_5":17817,"_24317":1982,"_2462":48065},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_2936":1992,"_25651":1982,"_17922":48067,"_5":17817,"_24317":48037,"_2462":48068},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_2936":1993,"_25651":1982,"_17922":48070,"_5":17817,"_24317":48037,"_2462":48071},[],"`crl_options` field",{"_2936":1994,"_25651":1982,"_17922":48073,"_5":17817,"_24317":48037,"_2462":42219},[],{"_2936":1995,"_25651":1982,"_17922":48075,"_5":17817,"_24317":48037,"_2462":48076},[],"Backend initial value",{"_2936":1996,"_25651":1982,"_17922":48078,"_5":17817,"_24317":48037,"_2462":48079},[],"`validity`",{"_2936":1997,"_25651":1982,"_17922":48081,"_5":17817,"_24317":48037,"_2462":48082},[],"Time from `thisUpdate` to `nextUpdate`.",{"_2936":1998,"_25651":1982,"_17922":48084,"_5":17817,"_24317":48037,"_2462":48085},[],"7 days.",{"_2936":1999,"_25651":1982,"_17922":48087,"_5":17817,"_24317":48037,"_2462":48088},[],"`refresh_interval`",{"_2936":2000,"_25651":1982,"_17922":48090,"_5":17817,"_24317":48037,"_2462":48091},[],"Time since publication that triggers scheduled renewal.",{"_2936":2001,"_25651":1982,"_17922":48093,"_5":17817,"_24317":48037,"_2462":48094},[],"6 days and 23 hours.",{"_2936":2002,"_25651":1982,"_17922":48096,"_5":17817,"_24317":48037,"_2462":48097},[],"`regenerate_on_revoke`",{"_2936":2003,"_25651":1982,"_17922":48099,"_5":17817,"_24317":48037,"_2462":48100},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_2936":2004,"_25651":1982,"_17922":48102,"_5":17817,"_24317":48037,"_2462":48103},[],"`true`.",{"_2936":2005,"_25651":1982,"_17922":48105,"_5":17817,"_24317":48037,"_2462":48106},[],"`subject_key_id_signer`",{"_2936":2006,"_25651":1982,"_17922":48108,"_5":17817,"_24317":48037,"_2462":48109},[],"Configuration field initialized with the CA’s SKI.",{"_2936":2007,"_25651":1982,"_17922":48111,"_5":17817,"_24317":48037,"_2462":48112},[],"CA SKI.",{"_2936":2008,"_25651":1982,"_17922":48114,"_5":17817,"_24317":48037,"_2462":48115},[],"The generator uses the key of the CA identified by the requested SKI. Do not interpret `subject_key_id_signer` as verified support for a different delegated CA: changing that field does not change the signer in this flow.",{"_2936":2009,"_25651":1982,"_17922":48117,"_5":17817,"_24317":48037,"_2462":48118},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_2936":2010,"_25651":1982,"_17922":48120,"_5":17817,"_24317":48041,"_2462":48121},[],"The scheduled job requests another list when `refresh_interval` is reached or when the list approaches expiration within the configured watch period. This depends on working jobs, storage and signing; it does not guarantee renewal during a service failure.",{"_2936":2011,"_25651":1982,"_17922":48123,"_5":17817,"_24317":48041,"_2462":48124},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_2936":2012,"_25651":1982,"_17922":48126,"_5":17817,"_24317":48041,"_2462":48127},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_2936":2013,"_25651":1982,"_17922":48129,"_5":17817,"_24317":48045,"_2462":48130},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_2936":2014,"_25651":1982,"_17922":48132,"_5":17817,"_24317":48045,"_2462":48133},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_2936":2015,"_25651":1982,"_17922":48135,"_5":17817,"_24317":48049,"_2462":48136},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_2936":2016,"_25651":1982,"_17922":48138,"_5":17817,"_24317":48049,"_2462":48139},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_2936":2017,"_25651":1982,"_17922":48141,"_5":17817,"_24317":48049,"_2462":48142},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_2936":2018,"_25651":1982,"_17922":48144,"_5":17817,"_24317":48049,"_2462":48145},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_2936":2019,"_25651":1982,"_17922":48147,"_5":17817,"_24317":48049,"_2462":48148},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_2936":2020,"_25651":1982,"_17922":48150,"_5":17817,"_24317":48053,"_2462":48151},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_2936":2021,"_25651":1982,"_17922":48153,"_5":17817,"_24317":48053,"_2462":44930},[],{"_2936":2022,"_25651":1982,"_17922":48155,"_5":17817,"_24317":48053,"_2462":48156},[],"Relative path",{"_2936":2023,"_25651":1982,"_17922":48158,"_5":17817,"_24317":48053,"_2462":44927},[],{"_2936":2024,"_25651":1982,"_17922":48160,"_5":17817,"_24317":48053,"_2462":48161},[],"`GET`",{"_2936":2025,"_25651":1982,"_17922":48163,"_5":17817,"_24317":48053,"_2462":48164},[],"`/v1/roles/{ca-ski}`",{"_2936":2026,"_25651":1982,"_17922":48166,"_5":17817,"_24317":48053,"_2462":48167},[],"Read `crl_options` and `latest_crl`.",{"_2936":2027,"_25651":1982,"_17922":48169,"_5":17817,"_24317":48053,"_2462":48170},[],"`PUT`",{"_2936":2028,"_25651":1982,"_17922":48172,"_5":17817,"_24317":48053,"_2462":48164},[],{"_2936":2029,"_25651":1982,"_17922":48174,"_5":17817,"_24317":48053,"_2462":48175},[],"Replace CRL configuration.",{"_2936":2030,"_25651":1982,"_17922":48177,"_5":17817,"_24317":48053,"_2462":48178},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_2936":2031,"_25651":1982,"_17922":48180,"_5":17817,"_24317":48053,"_2462":48181},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_2936":2032,"_25651":1982,"_17922":48183,"_5":17817,"_24317":48057,"_2462":48184},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_2936":2033,"_25651":1982,"_17922":48186,"_5":17817,"_24317":48061,"_2462":48187},[],"RFC 5280: X.509 and CRL profile.",{"_2936":2034,"_25651":1982,"_17922":48189,"_5":17817,"_24317":48061,"_2462":48190},[],"OpenSSL: openssl-crl.",{"_2936":2035,"_25651":1982,"_17922":48192,"_5":17817,"_24317":48061,"_2462":48193},[],"OpenSSL: openssl-verify.",{"_2936":2036,"_25651":1982,"_17922":48195,"_5":17817,"_24317":48061,"_2462":48196},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_2936":2037,"_25651":1982,"_17922":48198,"_5":17817,"_24317":48061,"_2462":48199},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2936":2038,"_25651":2038,"_5":12587,"_2462":48201,"_25996":48202,"_17922":48203,"_24317":2038},"Keys and cryptographic engines",[41832,43206,46899,46900],[],{"_2936":2039,"_25651":2038,"_17922":48205,"_5":17817,"_24317":2038,"_2462":48206},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_2936":2040,"_25651":2038,"_5":25993,"_17922":48208,"_24317":48209,"_2462":48210},[],"/docs/pr-preview/pr-49/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_2936":2041,"_25651":2038,"_5":25993,"_17922":48212,"_24317":48213,"_2462":48214},[],"/docs/pr-preview/pr-49/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_2936":2042,"_25651":2038,"_5":25993,"_17922":48216,"_24317":48217,"_2462":48218},[],"/docs/pr-preview/pr-49/platform/pki/key-management#file-system","File System",{"_2936":2043,"_25651":2038,"_5":25993,"_17922":48220,"_24317":48221,"_2462":48222},[],"/docs/pr-preview/pr-49/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_2936":2044,"_25651":2038,"_5":25993,"_17922":48224,"_24317":48225,"_2462":48226},[],"/docs/pr-preview/pr-49/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_2936":2045,"_25651":2038,"_5":25993,"_17922":48228,"_24317":48229,"_2462":48230},[],"/docs/pr-preview/pr-49/platform/pki/key-management#aws-kms","AWS KMS",{"_2936":2046,"_25651":2038,"_5":25993,"_17922":48232,"_24317":48233,"_2462":48234},[],"/docs/pr-preview/pr-49/platform/pki/key-management#pkcs11","PKCS#11",{"_2936":2047,"_25651":2038,"_5":25993,"_17922":48236,"_24317":48237,"_2462":48238},[],"/docs/pr-preview/pr-49/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_2936":2048,"_25651":2038,"_5":25993,"_17922":48240,"_24317":48241,"_2462":48242},[],"/docs/pr-preview/pr-49/platform/pki/key-management#key-inventory","Key inventory",{"_2936":2049,"_25651":2038,"_5":25993,"_17922":48244,"_24317":48245,"_2462":48246},[],"/docs/pr-preview/pr-49/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_2936":2050,"_25651":2038,"_5":25993,"_17922":48248,"_24317":48249,"_2462":48250},[],"/docs/pr-preview/pr-49/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_2936":2051,"_25651":2038,"_5":25993,"_17922":48252,"_24317":48253,"_2462":48254},[],"/docs/pr-preview/pr-49/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_2936":2052,"_25651":2038,"_5":25993,"_17922":48256,"_24317":48257,"_2462":48258},[],"/docs/pr-preview/pr-49/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_2936":2053,"_25651":2038,"_5":25993,"_17922":48260,"_24317":48261,"_2462":48262},[],"/docs/pr-preview/pr-49/platform/pki/key-management#view-details","View details",{"_2936":2054,"_25651":2038,"_5":25993,"_17922":48264,"_24317":48265,"_2462":48266},[],"/docs/pr-preview/pr-49/platform/pki/key-management#sign-and-verify","Sign and verify",{"_2936":2055,"_25651":2038,"_5":25993,"_17922":48268,"_24317":48269,"_2462":48270},[],"/docs/pr-preview/pr-49/platform/pki/key-management#sign","Sign",{"_2936":2056,"_25651":2038,"_5":25993,"_17922":48272,"_24317":48273,"_2462":48274},[],"/docs/pr-preview/pr-49/platform/pki/key-management#verify","Verify",{"_2936":2057,"_25651":2038,"_5":25993,"_17922":48276,"_24317":48277,"_2462":48278},[],"/docs/pr-preview/pr-49/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_2936":2058,"_25651":2038,"_5":25993,"_17922":48280,"_24317":48281,"_2462":48282},[],"/docs/pr-preview/pr-49/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_2936":2059,"_25651":2038,"_5":25993,"_17922":48284,"_24317":48285,"_2462":48286},[],"/docs/pr-preview/pr-49/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_2936":2060,"_25651":2038,"_17922":48288,"_5":17817,"_24317":2038,"_2462":48289},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_2936":2061,"_25651":2038,"_17922":48291,"_5":17817,"_24317":2038,"_2462":48292},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_2936":2062,"_25651":2038,"_17922":48294,"_5":17817,"_24317":48209,"_2462":48295},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_2936":2063,"_25651":2038,"_17922":48297,"_5":17817,"_24317":48209,"_2462":48298},[],"In practice, it lets you:",{"_2936":2064,"_25651":2038,"_17922":48300,"_5":17817,"_24317":48209,"_2462":48301},[],"Generate new key pairs from Lamassu IoT.",{"_2936":2065,"_25651":2038,"_17922":48303,"_5":17817,"_24317":48209,"_2462":48304},[],"Import keys created externally.",{"_2936":2066,"_25651":2038,"_17922":48306,"_5":17817,"_24317":48209,"_2462":48307},[],"Delegate custody and cryptographic operations to external engines.",{"_2936":2067,"_25651":2038,"_17922":48309,"_5":17817,"_24317":48209,"_2462":48310},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_2936":2068,"_25651":2038,"_17922":48312,"_5":17817,"_24317":48213,"_2462":48313},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_2936":2069,"_25651":2038,"_17922":48315,"_5":17817,"_24317":48213,"_2462":48316},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_2936":2070,"_25651":2038,"_17922":48318,"_5":17817,"_24317":48213,"_2462":48319},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_2936":2071,"_25651":2038,"_17922":48321,"_5":17817,"_24317":48217,"_2462":48322},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_2936":2072,"_25651":2038,"_17922":48324,"_5":17817,"_24317":48221,"_2462":48325},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_2936":2073,"_25651":2038,"_17922":48327,"_5":17817,"_24317":48225,"_2462":48328},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_2936":2074,"_25651":2038,"_17922":48330,"_5":17817,"_24317":48229,"_2462":48331},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_2936":2075,"_25651":2038,"_17922":48333,"_5":17817,"_24317":48233,"_2462":48334},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_2936":2076,"_25651":2038,"_17922":48336,"_5":17817,"_24317":48237,"_2462":48337},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_2936":2077,"_25651":2038,"_17922":48339,"_5":17817,"_24317":48237,"_2462":48340},[],"Lamassu shows the enabled engines in the console.",{"_2936":2078,"_25651":2038,"_17922":48342,"_5":17817,"_24317":48237,"_2462":48343},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_2936":2079,"_25651":2038,"_17922":48345,"_5":17817,"_24317":48237,"_2462":48346},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_2936":2080,"_25651":2038,"_17922":48348,"_5":17817,"_24317":48241,"_2462":48349},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_2936":2081,"_25651":2038,"_17922":48351,"_5":17817,"_24317":48241,"_2462":48352},[],"The table includes the following fields:",{"_2936":2082,"_25651":2038,"_17922":48354,"_5":17817,"_24317":48241,"_2462":48355},[],"**Name**: descriptive name of the key.",{"_2936":2083,"_25651":2038,"_17922":48357,"_5":17817,"_24317":48241,"_2462":48358},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_2936":2084,"_25651":2038,"_17922":48360,"_5":17817,"_24317":48241,"_2462":48361},[],"**Strength**: visual indicator of cryptographic strength.",{"_2936":2085,"_25651":2038,"_17922":48363,"_5":17817,"_24317":48241,"_2462":48364},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_2936":2086,"_25651":2038,"_17922":48366,"_5":17817,"_24317":48241,"_2462":48367},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_2936":2087,"_25651":2038,"_17922":48369,"_5":17817,"_24317":48241,"_2462":48370},[],"**Aliases**: alternative names associated with the key.",{"_2936":2088,"_25651":2038,"_17922":48372,"_5":17817,"_24317":48241,"_2462":48373},[],"**Tags**: labels for classification and search.",{"_2936":2089,"_25651":2038,"_17922":48375,"_5":17817,"_24317":48241,"_2462":48376},[],"**Related Entities**: certificates or other entities linked to that key.",{"_2936":2090,"_25651":2038,"_17922":48378,"_5":17817,"_24317":48241,"_2462":48379},[],"From this view you also reach the most common actions:",{"_2936":2091,"_25651":2038,"_17922":48381,"_5":17817,"_24317":48241,"_2462":48382},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_2936":2092,"_25651":2038,"_17922":48384,"_5":17817,"_24317":48241,"_2462":48385},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_2936":2093,"_25651":2038,"_17922":48387,"_5":17817,"_24317":48241,"_2462":48388},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_2936":2094,"_25651":2038,"_17922":48390,"_5":17817,"_24317":48241,"_2462":48391},[],"**Delete Key** to remove the key from the system.",{"_2936":2095,"_25651":2038,"_17922":48393,"_5":17817,"_24317":48245,"_2462":48394},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_2936":2096,"_25651":2038,"_17922":48396,"_5":17817,"_24317":48249,"_2462":48397},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_2936":2097,"_25651":2038,"_17922":48399,"_5":17817,"_24317":48249,"_2462":48400},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_2936":2098,"_25651":2038,"_17922":48402,"_5":17817,"_24317":48249,"_2462":48403},[],"**Key Name**: unique and descriptive name.",{"_2936":2099,"_25651":2038,"_17922":48405,"_5":17817,"_24317":48249,"_2462":48406},[],"**Crypto Engine**: engine that will keep the key.",{"_2936":2100,"_25651":2038,"_17922":48408,"_5":17817,"_24317":48249,"_2462":48409},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_2936":2101,"_25651":2038,"_17922":48411,"_5":17817,"_24317":48249,"_2462":48412},[],"**Tags**: metadata to classify the key.",{"_2936":2102,"_25651":2038,"_17922":48414,"_5":17817,"_24317":48249,"_2462":48415},[],"**Metadata**: additional information for advanced uses.",{"_2936":2103,"_25651":2038,"_17922":48417,"_5":17817,"_24317":48253,"_2462":48418},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_2936":2104,"_25651":2038,"_17922":48420,"_5":17817,"_24317":48253,"_2462":48421},[],"When you have an exportable private key and the destination engine supports import.",{"_2936":2105,"_25651":2038,"_17922":48423,"_5":17817,"_24317":48253,"_2462":48424},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_2936":2106,"_25651":2038,"_17922":48426,"_5":17817,"_24317":48253,"_2462":48427},[],"When Lamassu must operate with a root of trust created by a third party.",{"_2936":2107,"_25651":2038,"_17922":48429,"_5":17817,"_24317":48253,"_2462":48430},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_2936":2108,"_25651":2038,"_17922":48432,"_5":17817,"_24317":48253,"_2462":48433},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_2936":2109,"_25651":2038,"_17922":48435,"_5":17817,"_24317":48253,"_2462":48436},[],"**Crypto Engine**: engine that will keep the imported key.",{"_2936":2110,"_25651":2038,"_17922":48438,"_5":17817,"_24317":48253,"_2462":48439},[],"**Tags**: labels for organization and search.",{"_2936":2111,"_25651":2038,"_17922":48441,"_5":17817,"_24317":48253,"_2462":48442},[],"**Metadata**: additional optional information.",{"_2936":2112,"_25651":2038,"_17922":48444,"_5":17817,"_24317":48253,"_2462":48445},[],"**Private Key (PEM)**: private key in PEM format.",{"_2936":2113,"_25651":2038,"_17922":48447,"_5":17817,"_24317":48253,"_2462":48448},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_2936":2114,"_25651":2038,"_17922":48450,"_5":17817,"_24317":48257,"_2462":48451},[],"Each registered key has a detail view and several operational actions.",{"_2936":2115,"_25651":2038,"_17922":48453,"_5":17817,"_24317":48261,"_2462":48454},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_2936":2116,"_25651":2038,"_17922":48456,"_5":17817,"_24317":48261,"_2462":48457},[],"The **Overview** tab shows, among others, these fields:",{"_2936":2117,"_25651":2038,"_17922":48459,"_5":17817,"_24317":48261,"_2462":48460},[],"**Key Name**: descriptive name.",{"_2936":2118,"_25651":2038,"_17922":48462,"_5":17817,"_24317":48261,"_2462":48463},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_2936":2119,"_25651":2038,"_17922":48465,"_5":17817,"_24317":48261,"_2462":48466},[],"**Tags**: associated labels.",{"_2936":2120,"_25651":2038,"_17922":48468,"_5":17817,"_24317":48261,"_2462":48469},[],"**Aliases**: alternative names.",{"_2936":2121,"_25651":2038,"_17922":48471,"_5":17817,"_24317":48261,"_2462":48472},[],"**Crypto Engine**: engine where the key resides.",{"_2936":2122,"_25651":2038,"_17922":48474,"_5":17817,"_24317":48261,"_2462":48475},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_2936":2123,"_25651":2038,"_17922":48477,"_5":17817,"_24317":48261,"_2462":48478},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_2936":2124,"_25651":2038,"_17922":48480,"_5":17817,"_24317":48261,"_2462":48481},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_2936":2125,"_25651":2038,"_17922":48483,"_5":17817,"_24317":48265,"_2462":48484},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_2936":2126,"_25651":2038,"_17922":48486,"_5":17817,"_24317":48265,"_2462":48487},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_2936":2127,"_25651":2038,"_17922":48489,"_5":17817,"_24317":48265,"_2462":48490},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_2936":2128,"_25651":2038,"_17922":48492,"_5":17817,"_24317":48269,"_2462":48493},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_2936":2129,"_25651":2038,"_17922":48495,"_5":17817,"_24317":48269,"_2462":48496},[],"Main fields:",{"_2936":2130,"_25651":2038,"_17922":48498,"_5":17817,"_24317":48269,"_2462":48499},[],"**Algorithm**: signing algorithm available for the key type.",{"_2936":2131,"_25651":2038,"_17922":48501,"_5":17817,"_24317":48269,"_2462":48502},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_2936":2132,"_25651":2038,"_17922":48504,"_5":17817,"_24317":48269,"_2462":48505},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_2936":2133,"_25651":2038,"_17922":48507,"_5":17817,"_24317":48269,"_2462":48508},[],"**Message**: content to sign.",{"_2936":2134,"_25651":2038,"_17922":48510,"_5":17817,"_24317":48269,"_2462":48511},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_2936":2135,"_25651":2038,"_17922":48513,"_5":17817,"_24317":48273,"_2462":48514},[],"This tab checks whether a signature corresponds to the associated public key.",{"_2936":2136,"_25651":2038,"_17922":48516,"_5":17817,"_24317":48273,"_2462":48496},[],{"_2936":2137,"_25651":2038,"_17922":48518,"_5":17817,"_24317":48273,"_2462":48519},[],"**Algorithm**: must match the algorithm used for the signature.",{"_2936":2138,"_25651":2038,"_17922":48521,"_5":17817,"_24317":48273,"_2462":48522},[],"**Message Type**: `Raw` or `Digest`.",{"_2936":2139,"_25651":2038,"_17922":48524,"_5":17817,"_24317":48273,"_2462":48525},[],"**Payload Encoding**: encoding of the message.",{"_2936":2140,"_25651":2038,"_17922":48527,"_5":17817,"_24317":48273,"_2462":48528},[],"**Message**: original message or hash.",{"_2936":2141,"_25651":2038,"_17922":48530,"_5":17817,"_24317":48273,"_2462":48531},[],"**Signature**: signature to check.",{"_2936":2142,"_25651":2038,"_17922":48533,"_5":17817,"_24317":48273,"_2462":48534},[],"**Result**: indicator of the validation result.",{"_2936":2143,"_25651":2038,"_17922":48536,"_5":17817,"_24317":48277,"_2462":48537},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_2936":2144,"_25651":2038,"_17922":48539,"_5":17817,"_24317":48277,"_2462":48540},[],"This flow is useful for:",{"_2936":2145,"_25651":2038,"_17922":48542,"_5":17817,"_24317":48277,"_2462":48543},[],"Requesting certificates from an external CA.",{"_2936":2146,"_25651":2038,"_17922":48545,"_5":17817,"_24317":48277,"_2462":48546},[],"Renewing an identity while keeping the same key.",{"_2936":2147,"_25651":2038,"_17922":48548,"_5":17817,"_24317":48277,"_2462":48549},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_2936":2148,"_25651":2038,"_17922":48551,"_5":17817,"_24317":48277,"_2462":48552},[],"**Common Name (CN)**: main name of the identity.",{"_2936":2149,"_25651":2038,"_17922":48554,"_5":17817,"_24317":48277,"_2462":48555},[],"**Organization (O)**: organization or company.",{"_2936":2150,"_25651":2038,"_17922":48557,"_5":17817,"_24317":48277,"_2462":48558},[],"**Organizational Unit (OU)**: department or unit.",{"_2936":2151,"_25651":2038,"_17922":48560,"_5":17817,"_24317":48277,"_2462":48561},[],"**Country (C)**: two-letter country code.",{"_2936":2152,"_25651":2038,"_17922":48563,"_5":17817,"_24317":48277,"_2462":48564},[],"**State / Province (ST)**: state or province.",{"_2936":2153,"_25651":2038,"_17922":48566,"_5":17817,"_24317":48277,"_2462":48567},[],"**Locality (L)**: city or locality.",{"_2936":2154,"_25651":2038,"_17922":48569,"_5":17817,"_24317":48277,"_2462":48570},[],"**Email Address**: contact email.",{"_2936":2155,"_25651":2038,"_17922":48572,"_5":17817,"_24317":48277,"_2462":48573},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_2936":2156,"_25651":2038,"_17922":48575,"_5":17817,"_24317":48277,"_2462":48576},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_2936":2157,"_25651":2038,"_17922":48578,"_5":17817,"_24317":48281,"_2462":48579},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_2936":2158,"_25651":2038,"_17922":48581,"_5":17817,"_24317":48281,"_2462":48582},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_2936":2159,"_25651":2038,"_17922":48584,"_5":17817,"_24317":48285,"_2462":48585},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_2936":2160,"_25651":2160,"_5":12587,"_2462":48587,"_25996":48588,"_17922":48589,"_24317":2160},"Online validation with OCSP",[41832,43206,46899,47516],[],{"_2936":2161,"_25651":2160,"_17922":48591,"_5":17817,"_24317":2160,"_2462":48592},[],"Query signed status and verify the responder’s response.",{"_2936":2162,"_25651":2160,"_5":25993,"_17922":48594,"_24317":48595,"_2462":48596},[],"/docs/pr-preview/pr-49/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_2936":2163,"_25651":2160,"_5":25993,"_17922":48598,"_24317":48599,"_2462":48600},[],"/docs/pr-preview/pr-49/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_2936":2164,"_25651":2160,"_5":25993,"_17922":48602,"_24317":48603,"_2462":48604},[],"/docs/pr-preview/pr-49/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_2936":2165,"_25651":2160,"_5":25993,"_17922":48606,"_24317":48607,"_2462":48608},[],"/docs/pr-preview/pr-49/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_2936":2166,"_25651":2160,"_5":25993,"_17922":48610,"_24317":48611,"_2462":48612},[],"/docs/pr-preview/pr-49/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_2936":2167,"_25651":2160,"_5":25993,"_17922":48614,"_24317":48615,"_2462":48062},[],"/docs/pr-preview/pr-49/platform/pki/ocsp#references",{"_2936":2168,"_25651":2160,"_17922":48617,"_5":17817,"_24317":2160,"_2462":48618},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_2936":2169,"_25651":2160,"_17922":48620,"_5":17817,"_24317":48595,"_2462":48621},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_2936":2170,"_25651":2160,"_17922":48623,"_5":17817,"_24317":48595,"_2462":48624},[],"Record status",{"_2936":2171,"_25651":2160,"_17922":48626,"_5":17817,"_24317":48595,"_2462":48627},[],"Signed response",{"_2936":2172,"_25651":2160,"_17922":48629,"_5":17817,"_24317":48595,"_2462":46077},[],{"_2936":2173,"_25651":2160,"_17922":48631,"_5":17817,"_24317":48595,"_2462":48632},[],"`Good`.",{"_2936":2174,"_25651":2160,"_17922":48634,"_5":17817,"_24317":48595,"_2462":46094},[],{"_2936":2175,"_25651":2160,"_17922":48636,"_5":17817,"_24317":48595,"_2462":48637},[],"`Revoked`, with revocation reason and timestamp.",{"_2936":2176,"_25651":2160,"_17922":48639,"_5":17817,"_24317":48595,"_2462":48640},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_2936":2177,"_25651":2160,"_17922":48642,"_5":17817,"_24317":48595,"_2462":48643},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_2936":2178,"_25651":2160,"_17922":48645,"_5":17817,"_24317":48595,"_2462":48646},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_2936":2179,"_25651":2160,"_17922":48648,"_5":17817,"_24317":48595,"_2462":48649},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_2936":2180,"_25651":2160,"_17922":48651,"_5":17817,"_24317":48595,"_2462":48652},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_2936":2181,"_25651":2160,"_17922":48654,"_5":17817,"_24317":48599,"_2462":48655},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_2936":2182,"_25651":2160,"_17922":48657,"_5":17817,"_24317":48599,"_2462":48658},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_2936":2183,"_25651":2160,"_17922":48660,"_5":17817,"_24317":48603,"_2462":48661},[],"The service accepts:",{"_2936":2184,"_25651":2160,"_17922":48663,"_5":17817,"_24317":48603,"_2462":44930},[],{"_2936":2185,"_25651":2160,"_17922":48665,"_5":17817,"_24317":48603,"_2462":48666},[],"VA service path",{"_2936":2186,"_25651":2160,"_17922":48668,"_5":17817,"_24317":48603,"_2462":48669},[],"Format",{"_2936":2187,"_25651":2160,"_17922":48671,"_5":17817,"_24317":48603,"_2462":48672},[],"`POST`",{"_2936":2188,"_25651":2160,"_17922":48674,"_5":17817,"_24317":48603,"_2462":48675},[],"`/ocsp`",{"_2936":2189,"_25651":2160,"_17922":48677,"_5":17817,"_24317":48603,"_2462":48678},[],"DER request, `Content-Type: application/ocsp-request`.",{"_2936":2190,"_25651":2160,"_17922":48680,"_5":17817,"_24317":48603,"_2462":48161},[],{"_2936":2191,"_25651":2160,"_17922":48682,"_5":17817,"_24317":48603,"_2462":48683},[],"`/ocsp/{ocsp_request}`",{"_2936":2192,"_25651":2160,"_17922":48685,"_5":17817,"_24317":48603,"_2462":48686},[],"DER request encoded using padded URL Base64.",{"_2936":2193,"_25651":2160,"_17922":48688,"_5":17817,"_24317":48603,"_2462":48689},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_2936":2194,"_25651":2160,"_17922":48691,"_5":17817,"_24317":48607,"_2462":48692},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_2936":2195,"_25651":2160,"_17922":48694,"_5":17817,"_24317":48607,"_2462":48695},[],"Generate the request:",{"_2936":2196,"_25651":2160,"_17922":48697,"_5":17817,"_24317":48607,"_2462":48698},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_2936":2197,"_25651":2160,"_17922":48700,"_5":17817,"_24317":48607,"_2462":48701},[],"Replace the example URL with the inspected endpoint:",{"_2936":2198,"_25651":2160,"_17922":48703,"_5":17817,"_24317":48607,"_2462":48704},[],"Verify the returned DER:",{"_2936":2199,"_25651":2160,"_17922":48706,"_5":17817,"_24317":48607,"_2462":48707},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_2936":2200,"_25651":2160,"_17922":48709,"_5":17817,"_24317":48611,"_2462":48710},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_2936":2201,"_25651":2160,"_17922":48712,"_5":17817,"_24317":48611,"_2462":48713},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_2936":2202,"_25651":2160,"_17922":48715,"_5":17817,"_24317":48615,"_2462":48716},[],"RFC 6960: OCSP.",{"_2936":2203,"_25651":2160,"_17922":48718,"_5":17817,"_24317":48615,"_2462":48719},[],"OpenSSL: openssl-ocsp.",{"_2936":2204,"_25651":2160,"_17922":48721,"_5":17817,"_24317":48615,"_2462":48722},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_2936":2205,"_25651":2160,"_17922":48724,"_5":17817,"_24317":48615,"_2462":48199},[],{"_2936":2206,"_25651":2206,"_5":12587,"_2462":46899,"_25996":48726,"_17922":48727,"_24317":2206},[41832,43206,46899],[],{"_2936":2207,"_25651":2206,"_17922":48729,"_5":17817,"_24317":2206,"_2462":48730},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_2936":2208,"_25651":2206,"_5":25993,"_17922":48732,"_24317":48733,"_2462":46209},[],"/docs/pr-preview/pr-49/platform/pki/overview#start-here",{"_2936":2209,"_25651":2206,"_5":25993,"_17922":48735,"_24317":48736,"_2462":48737},[],"/docs/pr-preview/pr-49/platform/pki/overview#what-you-need","What you need",{"_2936":2210,"_25651":2206,"_5":25993,"_17922":48739,"_24317":48740,"_2462":46743},[],"/docs/pr-preview/pr-49/platform/pki/overview#core-capabilities",{"_2936":2211,"_25651":2206,"_5":25993,"_17922":48742,"_24317":48743,"_2462":46747},[],"/docs/pr-preview/pr-49/platform/pki/overview#build-your-trust-hierarchy",{"_2936":2212,"_25651":2206,"_5":25993,"_17922":48745,"_24317":48746,"_2462":46751},[],"/docs/pr-preview/pr-49/platform/pki/overview#protect-cryptographic-keys",{"_2936":2213,"_25651":2206,"_5":25993,"_17922":48748,"_24317":48749,"_2462":46755},[],"/docs/pr-preview/pr-49/platform/pki/overview#issue-and-control-certificates",{"_2936":2214,"_25651":2206,"_5":25993,"_17922":48751,"_24317":48752,"_2462":46763},[],"/docs/pr-preview/pr-49/platform/pki/overview#publish-validation-status",{"_2936":2215,"_25651":2206,"_5":25993,"_17922":48754,"_24317":48755,"_2462":48756},[],"/docs/pr-preview/pr-49/platform/pki/overview#how-to-check-the-result","How to check the result",{"_2936":2216,"_25651":2206,"_5":25993,"_17922":48758,"_24317":48759,"_2462":47683},[],"/docs/pr-preview/pr-49/platform/pki/overview#continue",{"_2936":2217,"_25651":2206,"_17922":48761,"_5":17817,"_24317":2206,"_2462":48762},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_2936":2218,"_25651":2206,"_17922":48764,"_5":17817,"_24317":48733,"_2462":48765},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_2936":2219,"_25651":2206,"_17922":48767,"_5":17817,"_24317":48733,"_2462":48768},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_2936":2220,"_25651":2206,"_17922":48770,"_5":17817,"_24317":48736,"_2462":48771},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_2936":2221,"_25651":2206,"_17922":48773,"_5":17817,"_24317":48736,"_2462":48774},[],"An available cryptographic engine to keep the authority's key.",{"_2936":2222,"_25651":2206,"_17922":48776,"_5":17817,"_24317":48736,"_2462":48777},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_2936":2223,"_25651":2206,"_17922":48779,"_5":17817,"_24317":48736,"_2462":48780},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_2936":2224,"_25651":2206,"_17922":48782,"_5":17817,"_24317":48736,"_2462":48783},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_2936":2225,"_25651":2206,"_17922":48785,"_5":17817,"_24317":48743,"_2462":48786},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_2936":2226,"_25651":2206,"_17922":48788,"_5":17817,"_24317":48746,"_2462":48789},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_2936":2227,"_25651":2206,"_17922":48791,"_5":17817,"_24317":48749,"_2462":48792},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_2936":2228,"_25651":2206,"_17922":48794,"_5":17817,"_24317":48752,"_2462":48795},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_2936":2229,"_25651":2206,"_17922":48797,"_5":17817,"_24317":48755,"_2462":48798},[],"An active certificate in the console is one part of the check. Also verify that:",{"_2936":2230,"_25651":2206,"_17922":48800,"_5":17817,"_24317":48755,"_2462":48801},[],"its subject and extensions identify the expected client;",{"_2936":2231,"_25651":2206,"_17922":48803,"_5":17817,"_24317":48755,"_2462":48804},[],"its public key matches the client's private key;",{"_2936":2232,"_25651":2206,"_17922":48806,"_5":17817,"_24317":48755,"_2462":48807},[],"its chain reaches a root trusted by the consumer;",{"_2936":2233,"_25651":2206,"_17922":48809,"_5":17817,"_24317":48755,"_2462":48810},[],"its dates and usages allow the operation;",{"_2936":2234,"_25651":2206,"_17922":48812,"_5":17817,"_24317":48755,"_2462":48813},[],"the consumer applies revocation checks and authorization.",{"_2936":2235,"_25651":2206,"_17922":48815,"_5":17817,"_24317":48755,"_2462":48816},[],"The issuance path includes the first independent checks.",{"_2936":2236,"_25651":2206,"_17922":48818,"_5":17817,"_24317":48759,"_2462":48819},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2936":2237,"_25651":2206,"_17922":48821,"_5":17817,"_24317":48759,"_2462":48822},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2936":2238,"_25651":2206,"_17922":48824,"_5":17817,"_24317":48759,"_2462":48825},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2936":2239,"_25651":2239,"_5":12587,"_2462":48827,"_25996":48828,"_17922":48829,"_24317":2239},"Create your first CA",[41832,43206,46899,46334],[],{"_2936":2240,"_25651":2239,"_17922":48831,"_5":17817,"_24317":2239,"_2462":48832},[],"Create an evaluation root and check its certificate before issuing.",{"_2936":2241,"_25651":2239,"_5":25993,"_17922":48834,"_24317":48835,"_2462":41842},[],"/docs/pr-preview/pr-49/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_2936":2242,"_25651":2239,"_5":25993,"_17922":48837,"_24317":48838,"_2462":48839},[],"/docs/pr-preview/pr-49/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_2936":2243,"_25651":2239,"_5":25993,"_17922":48841,"_24317":48842,"_2462":48843},[],"/docs/pr-preview/pr-49/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_2936":2244,"_25651":2239,"_5":25993,"_17922":48845,"_24317":48846,"_2462":48847},[],"/docs/pr-preview/pr-49/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_2936":2245,"_25651":2239,"_5":25993,"_17922":48849,"_24317":48850,"_2462":48851},[],"/docs/pr-preview/pr-49/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_2936":2246,"_25651":2239,"_5":25993,"_17922":48853,"_24317":48854,"_2462":48855},[],"/docs/pr-preview/pr-49/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_2936":2247,"_25651":2239,"_5":25993,"_17922":48857,"_24317":48858,"_2462":48859},[],"/docs/pr-preview/pr-49/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_2936":2248,"_25651":2239,"_5":25993,"_17922":48861,"_24317":48862,"_2462":46592},[],"/docs/pr-preview/pr-49/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_2936":2249,"_25651":2239,"_5":25993,"_17922":48864,"_24317":48865,"_2462":41866},[],"/docs/pr-preview/pr-49/platform/pki/quickstarts/create-certificate-authority#next-step",{"_2936":2250,"_25651":2239,"_17922":48867,"_5":17817,"_24317":2239,"_2462":48868},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_2936":2251,"_25651":2239,"_17922":48870,"_5":17817,"_24317":48835,"_2462":48871},[],"Console access and permission to create keys and authorities.",{"_2936":2252,"_25651":2239,"_17922":48873,"_5":17817,"_24317":48835,"_2462":48874},[],"An available cryptographic engine that supports the chosen algorithm.",{"_2936":2253,"_25651":2239,"_17922":48876,"_5":17817,"_24317":48835,"_2462":48877},[],"OpenSSL 3.x to check the downloaded certificate.",{"_2936":2254,"_25651":2239,"_17922":48879,"_5":17817,"_24317":48835,"_2462":48880},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_2936":2255,"_25651":2239,"_17922":48882,"_5":17817,"_24317":48838,"_2462":48883},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_2936":2256,"_25651":2239,"_17922":48885,"_5":17817,"_24317":48838,"_2462":48886},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_2936":2257,"_25651":2239,"_17922":48888,"_5":17817,"_24317":48842,"_2462":48889},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_2936":2258,"_25651":2239,"_17922":48891,"_5":17817,"_24317":48842,"_2462":48892},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_2936":2259,"_25651":2239,"_17922":48894,"_5":17817,"_24317":48846,"_2462":48895},[],"Select **Root CA** and complete:",{"_2936":2260,"_25651":2239,"_17922":48897,"_5":17817,"_24317":48846,"_2462":48898},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_2936":2261,"_25651":2239,"_17922":48900,"_5":17817,"_24317":48846,"_2462":48901},[],"**Subject**: organization and country details for your evaluation.",{"_2936":2262,"_25651":2239,"_17922":48903,"_5":17817,"_24317":48846,"_2462":48904},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_2936":2263,"_25651":2239,"_17922":48906,"_5":17817,"_24317":48846,"_2462":48907},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_2936":2264,"_25651":2239,"_17922":48909,"_5":17817,"_24317":48846,"_2462":48910},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_2936":2265,"_25651":2239,"_17922":48912,"_5":17817,"_24317":48850,"_2462":48913},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_2936":2266,"_25651":2239,"_17922":48915,"_5":17817,"_24317":48854,"_2462":48916},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_2936":2267,"_25651":2239,"_17922":48918,"_5":17817,"_24317":48854,"_2462":48919},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_2936":2268,"_25651":2239,"_17922":48921,"_5":17817,"_24317":48858,"_2462":48922},[],"Run from the directory where you saved `ca.pem`:",{"_2936":2269,"_25651":2239,"_17922":48924,"_5":17817,"_24317":48858,"_2462":48925},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_2936":2270,"_25651":2239,"_17922":48927,"_5":17817,"_24317":48858,"_2462":48928},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_2936":2271,"_25651":2239,"_17922":48930,"_5":17817,"_24317":48862,"_2462":48931},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_2936":2272,"_25651":2239,"_17922":48933,"_5":17817,"_24317":48862,"_2462":48934},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_2936":2273,"_25651":2239,"_17922":48936,"_5":17817,"_24317":48862,"_2462":48937},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_2936":2274,"_25651":2239,"_17922":48939,"_5":17817,"_24317":48862,"_2462":48940},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_2936":2275,"_25651":2239,"_17922":48942,"_5":17817,"_24317":48865,"_2462":48943},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_2936":2276,"_25651":2276,"_5":12587,"_2462":48945,"_25996":48946,"_17922":48947,"_24317":2276},"Issue and verify a certificate",[41832,43206,46899,46334],[],{"_2936":2277,"_25651":2276,"_17922":48949,"_5":17817,"_24317":2276,"_2462":48950},[],"Issue a client certificate and check content, chain and key correspondence.",{"_2936":2278,"_25651":2276,"_5":25993,"_17922":48952,"_24317":48953,"_2462":41842},[],"/docs/pr-preview/pr-49/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_2936":2279,"_25651":2276,"_5":25993,"_17922":48955,"_24317":48956,"_2462":48957},[],"/docs/pr-preview/pr-49/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_2936":2280,"_25651":2276,"_5":25993,"_17922":48959,"_24317":48960,"_2462":48961},[],"/docs/pr-preview/pr-49/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_2936":2281,"_25651":2276,"_5":25993,"_17922":48963,"_24317":48964,"_2462":48965},[],"/docs/pr-preview/pr-49/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_2936":2282,"_25651":2276,"_5":25993,"_17922":48967,"_24317":48968,"_2462":48969},[],"/docs/pr-preview/pr-49/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_2936":2283,"_25651":2276,"_5":25993,"_17922":48971,"_24317":48972,"_2462":48973},[],"/docs/pr-preview/pr-49/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_2936":2284,"_25651":2276,"_5":25993,"_17922":48975,"_24317":48976,"_2462":48855},[],"/docs/pr-preview/pr-49/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_2936":2285,"_25651":2276,"_5":25993,"_17922":48978,"_24317":48979,"_2462":48980},[],"/docs/pr-preview/pr-49/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_2936":2286,"_25651":2276,"_5":25993,"_17922":48982,"_24317":48983,"_2462":48984},[],"/docs/pr-preview/pr-49/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_2936":2287,"_25651":2276,"_5":25993,"_17922":48986,"_24317":48987,"_2462":48988},[],"/docs/pr-preview/pr-49/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_2936":2288,"_25651":2276,"_5":25993,"_17922":48990,"_24317":48991,"_2462":46592},[],"/docs/pr-preview/pr-49/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_2936":2289,"_25651":2276,"_5":25993,"_17922":48993,"_24317":48994,"_2462":41866},[],"/docs/pr-preview/pr-49/platform/pki/quickstarts/issue-certificate#next-step",{"_2936":2290,"_25651":2276,"_17922":48996,"_5":17817,"_24317":2276,"_2462":48997},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_2936":2291,"_25651":2276,"_17922":48999,"_5":17817,"_24317":48953,"_2462":49000},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_2936":2292,"_25651":2276,"_17922":49002,"_5":17817,"_24317":48953,"_2462":49003},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_2936":2293,"_25651":2276,"_17922":49005,"_5":17817,"_24317":48953,"_2462":49006},[],"OpenSSL 3.x and a working directory with restricted access.",{"_2936":2294,"_25651":2276,"_17922":49008,"_5":17817,"_24317":48953,"_2462":49009},[],"A client identifier: here we use `device-001`.",{"_2936":2295,"_25651":2276,"_17922":49011,"_5":17817,"_24317":48953,"_2462":49012},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_2936":2296,"_25651":2276,"_17922":49014,"_5":17817,"_24317":48956,"_2462":49015},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_2936":2297,"_25651":2276,"_17922":49017,"_5":17817,"_24317":48960,"_2462":49018},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_2936":2298,"_25651":2276,"_17922":49020,"_5":17817,"_24317":48960,"_2462":49021},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_2936":2299,"_25651":2276,"_17922":49023,"_5":17817,"_24317":48964,"_2462":49024},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_2936":2300,"_25651":2276,"_17922":49026,"_5":17817,"_24317":48964,"_2462":49027},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_2936":2301,"_25651":2276,"_17922":49029,"_5":17817,"_24317":48968,"_2462":49030},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_2936":2302,"_25651":2276,"_17922":49032,"_5":17817,"_24317":48968,"_2462":49033},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_2936":2303,"_25651":2276,"_17922":49035,"_5":17817,"_24317":48972,"_2462":49036},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_2936":2304,"_25651":2276,"_17922":49038,"_5":17817,"_24317":48976,"_2462":49039},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_2936":2305,"_25651":2276,"_17922":49041,"_5":17817,"_24317":48979,"_2462":49042},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_2936":2306,"_25651":2276,"_17922":49044,"_5":17817,"_24317":48983,"_2462":49045},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_2936":2307,"_25651":2276,"_17922":49047,"_5":17817,"_24317":48983,"_2462":49048},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_2936":2308,"_25651":2276,"_17922":49050,"_5":17817,"_24317":48983,"_2462":49051},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_2936":2309,"_25651":2276,"_17922":49053,"_5":17817,"_24317":48987,"_2462":49054},[],"In Bash, compare the two public-key digests:",{"_2936":2310,"_25651":2276,"_17922":49056,"_5":17817,"_24317":48987,"_2462":49057},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_2936":2311,"_25651":2276,"_17922":49059,"_5":17817,"_24317":48987,"_2462":49060},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_2936":2312,"_25651":2276,"_17922":49062,"_5":17817,"_24317":48991,"_2462":46676},[],{"_2936":2313,"_25651":2276,"_17922":49064,"_5":17817,"_24317":48991,"_2462":49065},[],"What to review",{"_2936":2314,"_25651":2276,"_17922":49067,"_5":17817,"_24317":48991,"_2462":49068},[],"The CA rejects issuance",{"_2936":2315,"_25651":2276,"_17922":49070,"_5":17817,"_24317":48991,"_2462":49071},[],"Permissions, CA state and key, algorithm and profile.",{"_2936":2316,"_25651":2276,"_17922":49073,"_5":17817,"_24317":48991,"_2462":49074},[],"Different subject or usages",{"_2936":2317,"_25651":2276,"_17922":49076,"_5":17817,"_24317":48991,"_2462":49077},[],"Applied profile and requested values.",{"_2936":2318,"_25651":2276,"_17922":49079,"_5":17817,"_24317":48991,"_2462":49080},[],"Issuer cannot be found",{"_2936":2319,"_25651":2276,"_17922":49082,"_5":17817,"_24317":48991,"_2462":49083},[],"Downloaded CA and required intermediate chain.",{"_2936":2320,"_25651":2276,"_17922":49085,"_5":17817,"_24317":48991,"_2462":49086},[],"Validity fails",{"_2936":2321,"_25651":2276,"_17922":49088,"_5":17817,"_24317":48991,"_2462":49089},[],"Certificate and CA dates, and the computer's clock.",{"_2936":2322,"_25651":2276,"_17922":49091,"_5":17817,"_24317":48991,"_2462":49092},[],"Public-key digests differ",{"_2936":2323,"_25651":2276,"_17922":49094,"_5":17817,"_24317":48991,"_2462":49095},[],"Certificate and key files from the same issuance.",{"_2936":2324,"_25651":2276,"_17922":49097,"_5":17817,"_24317":48991,"_2462":49098},[],"See PKI diagnostics to narrow an issuance failure.",{"_2936":2325,"_25651":2276,"_17922":49100,"_5":17817,"_24317":48994,"_2462":49101},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_2936":2326,"_25651":2276,"_17922":49103,"_5":17817,"_24317":48994,"_2462":49104},[],"Manage certificates for inspection, status and revocation.",{"_2936":2327,"_25651":2276,"_17922":49106,"_5":17817,"_24317":48994,"_2462":49107},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_2936":2328,"_25651":2276,"_17922":49109,"_5":17817,"_24317":48994,"_2462":49110},[],"Prepare EST for the device to request its next identities.",{"_2936":2329,"_25651":2276,"_17922":49112,"_5":17817,"_24317":48994,"_2462":49113},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_2936":2330,"_25651":2330,"_5":12587,"_2462":49115,"_25996":49116,"_17922":49117,"_24317":2330},"PKI getting started",[41832,43206,46899,46334],[],{"_2936":2331,"_25651":2330,"_17922":49119,"_5":17817,"_24317":2330,"_2462":49120},[],"Create a CA, issue a client certificate and check its chain and key.",{"_2936":2332,"_25651":2330,"_5":25993,"_17922":49122,"_24317":49123,"_2462":41842},[],"/docs/pr-preview/pr-49/platform/pki/quickstarts/overview#before-you-begin",{"_2936":2333,"_25651":2330,"_5":25993,"_17922":49125,"_24317":49126,"_2462":49127},[],"/docs/pr-preview/pr-49/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_2936":2334,"_25651":2330,"_5":25993,"_17922":49129,"_24317":49130,"_2462":46526},[],"/docs/pr-preview/pr-49/platform/pki/quickstarts/overview#expected-result",{"_2936":2335,"_25651":2330,"_5":25993,"_17922":49132,"_24317":49133,"_2462":49134},[],"/docs/pr-preview/pr-49/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_2936":2336,"_25651":2330,"_17922":49136,"_5":17817,"_24317":2330,"_2462":49137},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_2936":2337,"_25651":2330,"_17922":49139,"_5":17817,"_24317":49123,"_2462":49140},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_2936":2338,"_25651":2330,"_17922":49142,"_5":17817,"_24317":49123,"_2462":49143},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_2936":2339,"_25651":2330,"_17922":49145,"_5":17817,"_24317":49123,"_2462":49146},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_2936":2340,"_25651":2330,"_17922":49148,"_5":17817,"_24317":49123,"_2462":49149},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_2936":2341,"_25651":2330,"_17922":49151,"_5":17817,"_24317":49123,"_2462":49152},[],"A working directory with restricted access for the downloaded key.",{"_2936":2342,"_25651":2330,"_17922":49154,"_5":17817,"_24317":49126,"_2462":49155},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2936":2343,"_25651":2330,"_17922":49157,"_5":17817,"_24317":49126,"_2462":49158},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2936":2344,"_25651":2330,"_17922":49160,"_5":17817,"_24317":49126,"_2462":49161},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_2936":2345,"_25651":2330,"_17922":49163,"_5":17817,"_24317":49126,"_2462":49164},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_2936":2346,"_25651":2330,"_17922":49166,"_5":17817,"_24317":49130,"_2462":49167},[],"File or resource",{"_2936":2347,"_25651":2330,"_17922":49169,"_5":17817,"_24317":49130,"_2462":46523},[],{"_2936":2348,"_25651":2330,"_17922":49171,"_5":17817,"_24317":49130,"_2462":49172},[],"Active root CA and `ca.pem`",{"_2936":2349,"_25651":2330,"_17922":49174,"_5":17817,"_24317":49130,"_2462":49175},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_2936":2350,"_25651":2330,"_17922":49177,"_5":17817,"_24317":49130,"_2462":49178},[],"End-entity certificate and `device.crt`",{"_2936":2351,"_25651":2330,"_17922":49180,"_5":17817,"_24317":49130,"_2462":49181},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_2936":2352,"_25651":2330,"_17922":49183,"_5":17817,"_24317":49130,"_2462":49184},[],"Private key `device.key`",{"_2936":2353,"_25651":2330,"_17922":49186,"_5":17817,"_24317":49130,"_2462":49187},[],"Its public key matches the one included in `device.crt`.",{"_2936":2354,"_25651":2330,"_17922":49189,"_5":17817,"_24317":49130,"_2462":49190},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_2936":2355,"_25651":2330,"_17922":49192,"_5":17817,"_24317":49133,"_2462":49193},[],"To operate certificates, continue with Certificates and Validation.",{"_2936":2356,"_25651":2330,"_17922":49195,"_5":17817,"_24317":49133,"_2462":49196},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_2936":2357,"_25651":2330,"_17922":49198,"_5":17817,"_24317":49133,"_2462":49199},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_2936":2358,"_25651":2358,"_5":12587,"_2462":49201,"_25996":49202,"_17922":49203,"_24317":2358},"PKI troubleshooting",[41832,43206,46899,45720],[],{"_2936":2359,"_25651":2358,"_17922":49205,"_5":17817,"_24317":2358,"_2462":49206},[],"Diagnose certificate issuance, OCSP and CRL.",{"_2936":2360,"_25651":2358,"_5":25993,"_17922":49208,"_24317":49209,"_2462":49210},[],"/docs/pr-preview/pr-49/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_2936":2361,"_25651":2358,"_5":25993,"_17922":49212,"_24317":49213,"_2462":49214},[],"/docs/pr-preview/pr-49/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_2936":2362,"_25651":2358,"_5":25993,"_17922":49216,"_24317":49217,"_2462":49218},[],"/docs/pr-preview/pr-49/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_2936":2363,"_25651":2358,"_17922":49220,"_5":17817,"_24317":2358,"_2462":49221},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_2936":2364,"_25651":2358,"_17922":49223,"_5":17817,"_24317":2358,"_2462":49224},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_2936":2365,"_25651":2358,"_17922":49226,"_5":17817,"_24317":49209,"_2462":46523},[],{"_2936":2366,"_25651":2358,"_17922":49228,"_5":17817,"_24317":49209,"_2462":49229},[],"What to inspect",{"_2936":2367,"_25651":2358,"_17922":49231,"_5":17817,"_24317":49209,"_2462":41866},[],{"_2936":2368,"_25651":2358,"_17922":49233,"_5":17817,"_24317":49209,"_2462":49234},[],"CA",{"_2936":2369,"_25651":2358,"_17922":49236,"_5":17817,"_24317":49209,"_2462":49237},[],"Exists, is active and has usable dates.",{"_2936":2370,"_25651":2358,"_17922":49239,"_5":17817,"_24317":49209,"_2462":49240},[],"Authorities.",{"_2936":2371,"_25651":2358,"_17922":49242,"_5":17817,"_24317":49209,"_2462":49243},[],"Key",{"_2936":2372,"_25651":2358,"_17922":49245,"_5":17817,"_24317":49209,"_2462":49246},[],"The record has a usable private key and the engine can sign.",{"_2936":2373,"_25651":2358,"_17922":49248,"_5":17817,"_24317":49209,"_2462":49249},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_2936":2374,"_25651":2358,"_17922":49251,"_5":17817,"_24317":49209,"_2462":49252},[],"CSR",{"_2936":2375,"_25651":2358,"_17922":49254,"_5":17817,"_24317":49209,"_2462":49255},[],"Correct PEM and verifiable signature.",{"_2936":2376,"_25651":2358,"_17922":49257,"_5":17817,"_24317":49209,"_2462":49258},[],"`openssl req -in request.csr -noout -verify -text`.",{"_2936":2377,"_25651":2358,"_17922":49260,"_5":17817,"_24317":49209,"_2462":49261},[],"Profile",{"_2936":2378,"_25651":2358,"_17922":49263,"_5":17817,"_24317":49209,"_2462":49264},[],"Selected source, existing ID, allowed algorithm and size.",{"_2936":2379,"_25651":2358,"_17922":49266,"_5":17817,"_24317":49209,"_2462":49267},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_2936":2380,"_25651":2358,"_17922":49269,"_5":17817,"_24317":49209,"_2462":46676},[],{"_2936":2381,"_25651":2358,"_17922":49271,"_5":17817,"_24317":49209,"_2462":49272},[],"Appropriate subject, SAN, usages and dates.",{"_2936":2382,"_25651":2358,"_17922":49274,"_5":17817,"_24317":49209,"_2462":49275},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_2936":2383,"_25651":2358,"_17922":49277,"_5":17817,"_24317":49209,"_2462":49278},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_2936":2384,"_25651":2358,"_17922":49280,"_5":17817,"_24317":49209,"_2462":49281},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_2936":2385,"_25651":2358,"_17922":49283,"_5":17817,"_24317":49213,"_2462":49284},[],"Check each boundary independently:",{"_2936":2386,"_25651":2358,"_17922":49286,"_5":17817,"_24317":49213,"_2462":49287},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_2936":2387,"_25651":2358,"_17922":49289,"_5":17817,"_24317":49213,"_2462":49290},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_2936":2388,"_25651":2358,"_17922":49292,"_5":17817,"_24317":49213,"_2462":49293},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_2936":2389,"_25651":2358,"_17922":49295,"_5":17817,"_24317":49213,"_2462":49296},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_2936":2390,"_25651":2358,"_17922":49298,"_5":17817,"_24317":49213,"_2462":49299},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_2936":2391,"_25651":2358,"_17922":49301,"_5":17817,"_24317":49213,"_2462":49302},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_2936":2392,"_25651":2358,"_17922":49304,"_5":17817,"_24317":49217,"_2462":49305},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_2936":2393,"_25651":2358,"_17922":49307,"_5":17817,"_24317":49217,"_2462":49308},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_2936":2394,"_25651":2394,"_5":12587,"_2462":49310,"_25996":49311,"_17922":49313,"_24317":2394},"3.8.0 to 4.0.0",[41832,49312],"Upgrades",[],{"_2936":2395,"_25651":2394,"_17922":49315,"_5":17817,"_24317":2394,"_2462":49316},[],"4.0.0 changes that affect DMS configuration, what can break after upgrading from 3.8.0, and how to verify it.",{"_2936":2396,"_25651":2394,"_5":25993,"_17922":49318,"_24317":49319,"_2462":49320},[],"/docs/pr-preview/pr-49/upgrades/3-8-0-to-4-0-0#summary","Summary",{"_2936":2397,"_25651":2394,"_5":25993,"_17922":49322,"_24317":49323,"_2462":49324},[],"/docs/pr-preview/pr-49/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_2936":2398,"_25651":2394,"_5":25993,"_17922":49326,"_24317":49327,"_2462":49328},[],"/docs/pr-preview/pr-49/upgrades/3-8-0-to-4-0-0#webhooks-with-file-references","Webhooks with file references",{"_2936":2399,"_25651":2394,"_5":25993,"_17922":49330,"_24317":49331,"_2462":49332},[],"/docs/pr-preview/pr-49/upgrades/3-8-0-to-4-0-0#receiver-certificate-verification","Receiver certificate verification",{"_2936":2400,"_25651":2394,"_5":25993,"_17922":49334,"_24317":49335,"_2462":49336},[],"/docs/pr-preview/pr-49/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_2936":2401,"_25651":2394,"_5":25993,"_17922":49338,"_24317":49339,"_2462":49340},[],"/docs/pr-preview/pr-49/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_2936":2402,"_25651":2394,"_5":25993,"_17922":49342,"_24317":49343,"_2462":49344},[],"/docs/pr-preview/pr-49/upgrades/3-8-0-to-4-0-0#verification-checklist","Verification checklist",{"_2936":2403,"_25651":2394,"_17922":49346,"_5":17817,"_24317":2394,"_2462":49347},[],"Upgrading from 3.8.0 to 4.0.0 automatically migrates stored DMS configuration. Most of it converts without intervention, but three changes can leave enrollments failing or configs holding unexpected values if they are not reviewed. This page states what changes, what symptoms to expect and what to do in each case. Current behavior of each feature is documented in the DMS pages.",{"_2936":2404,"_25651":2394,"_17922":49349,"_5":17817,"_24317":49319,"_2462":49350},[],"Change",{"_2936":2405,"_25651":2394,"_17922":49352,"_5":17817,"_24317":49319,"_2462":49353},[],"Who is affected",{"_2936":2406,"_25651":2394,"_17922":49355,"_5":17817,"_24317":49319,"_2462":49356},[],"Severity",{"_2936":2407,"_25651":2394,"_17922":49358,"_5":17817,"_24317":49319,"_2462":49359},[],"Action",{"_2936":2408,"_25651":2394,"_17922":49361,"_5":17817,"_24317":49319,"_2462":49328},[],{"_2936":2409,"_25651":2394,"_17922":49363,"_5":17817,"_24317":49319,"_2462":49364},[],"DMSs with a webhook whose mTLS certificate or key were file paths",{"_2936":2410,"_25651":2394,"_17922":49366,"_5":17817,"_24317":49319,"_2462":49367},[],"High: enrollments and re-enrollments calling the webhook fail",{"_2936":2411,"_25651":2394,"_17922":49369,"_5":17817,"_24317":49319,"_2462":49370},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_2936":2412,"_25651":2394,"_17922":49372,"_5":17817,"_24317":49319,"_2462":49332},[],{"_2936":2413,"_25651":2394,"_17922":49374,"_5":17817,"_24317":49319,"_2462":49375},[],"DMSs with a webhook that had `validate_server_cert: false`",{"_2936":2414,"_25651":2394,"_17922":49377,"_5":17817,"_24317":49319,"_2462":49378},[],"Medium: webhook credentials are sent to an unverified receiver",{"_2936":2415,"_25651":2394,"_17922":49380,"_5":17817,"_24317":49319,"_2462":49381},[],"Set `insecure_skip_verify` to `false`",{"_2936":2416,"_25651":2394,"_17922":49383,"_5":17817,"_24317":49319,"_2462":49336},[],{"_2936":2417,"_25651":2394,"_17922":49385,"_5":17817,"_24317":49319,"_2462":49386},[],"Scripts and consoles that edit DMSs through the API",{"_2936":2418,"_25651":2394,"_17922":49388,"_5":17817,"_24317":49319,"_2462":49389},[],"Medium: an edit in the old layout silently empties `validation_cas`",{"_2936":2419,"_25651":2394,"_17922":49391,"_5":17817,"_24317":49319,"_2462":49392},[],"Read the DMS before editing and use the new field",{"_2936":2420,"_25651":2394,"_17922":49394,"_5":17817,"_24317":49319,"_2462":49340},[],{"_2936":2421,"_25651":2394,"_17922":49396,"_5":17817,"_24317":49319,"_2462":49397},[],"Any DMS",{"_2936":2422,"_25651":2394,"_17922":49399,"_5":17817,"_24317":49319,"_2462":49400},[],"Low: informational",{"_2936":2423,"_25651":2394,"_17922":49402,"_5":17817,"_24317":49319,"_2462":49403},[],"Read both blocks before editing",{"_2936":2424,"_25651":2394,"_17922":49405,"_5":17817,"_24317":49319,"_2462":49406},[],"A verification checklist at the end confirms the result.",{"_2936":2425,"_25651":2394,"_17922":49408,"_5":17817,"_24317":49323,"_2462":49409},[],"Stored webhook configs are rewritten to the current layout. Fields are renamed as follows:",{"_2936":2426,"_25651":2394,"_17922":49411,"_5":17817,"_24317":49323,"_2462":49412},[],"Field in 3.8.0",{"_2936":2427,"_25651":2394,"_17922":49414,"_5":17817,"_24317":49323,"_2462":49415},[],"Field in 4.0.0",{"_2936":2428,"_25651":2394,"_17922":49417,"_5":17817,"_24317":49323,"_2462":49418},[],"`validate_server_cert`",{"_2936":2429,"_25651":2394,"_17922":49420,"_5":17817,"_24317":49323,"_2462":49421},[],"`insecure_skip_verify` (value negated)",{"_2936":2430,"_25651":2394,"_17922":49423,"_5":17817,"_24317":49323,"_2462":49424},[],"`oidc`",{"_2936":2431,"_25651":2394,"_17922":49426,"_5":17817,"_24317":49323,"_2462":49427},[],"`jwt_options`",{"_2936":2432,"_25651":2394,"_17922":49429,"_5":17817,"_24317":49323,"_2462":49430},[],"`apikey`",{"_2936":2433,"_25651":2394,"_17922":49432,"_5":17817,"_24317":49323,"_2462":49433},[],"`apikey_options`",{"_2936":2434,"_25651":2394,"_17922":49435,"_5":17817,"_24317":49323,"_2462":49436},[],"`mtls`",{"_2936":2435,"_25651":2394,"_17922":49438,"_5":17817,"_24317":49323,"_2462":49439},[],"`mtls_options`",{"_2936":2436,"_25651":2394,"_17922":49441,"_5":17817,"_24317":49323,"_2462":49442},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. The two cases below do need it.",{"_2936":2437,"_25651":2394,"_17922":49444,"_5":17817,"_24317":49327,"_2462":49445},[],"A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields, and does so on every call, whatever the configured authentication mode. As a result, every enroll and re-enroll that calls that webhook fails until the config is fixed.",{"_2936":2438,"_25651":2394,"_17922":49447,"_5":17817,"_24317":49327,"_2462":49448},[],"There are two ways to fix it, depending on the webhook:",{"_2936":2439,"_25651":2394,"_17922":49450,"_5":17817,"_24317":49327,"_2462":49451},[],"If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM.",{"_2936":2440,"_25651":2394,"_17922":49453,"_5":17817,"_24317":49327,"_2462":49454},[],"If the webhook does not use mTLS, remove the leftover file fields.",{"_2936":2441,"_25651":2394,"_17922":49456,"_5":17817,"_24317":49327,"_2462":49457},[],"Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`).",{"_2936":2442,"_25651":2394,"_17922":49459,"_5":17817,"_24317":49327,"_2462":49460},[],"A variant of the same problem exists: if the stored config holds file paths inside `mtls_options.cert_content` or `mtls_options.key_content`, every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fails validation. Settings are replaced wholesale, so the stored config must be resent with the certificate and key as PEM.",{"_2936":2443,"_25651":2394,"_17922":49462,"_5":17817,"_24317":49331,"_2462":49463},[],"A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`. Receiver certificate verification therefore stays skipped until that field is set to `false`.",{"_2936":2444,"_25651":2394,"_17922":49465,"_5":17817,"_24317":49331,"_2462":49466},[],"It should be corrected on every migrated config. The webhook authorization channel carries the API key or bearer token, so skipping verification exposes those credentials to a network-positioned attacker. Keeping `insecure_skip_verify: true` is only justified when the receiver certificate is deliberately unverifiable.",{"_2936":2445,"_25651":2394,"_17922":49468,"_5":17817,"_24317":49335,"_2462":49469},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`.",{"_2936":2446,"_25651":2394,"_17922":49471,"_5":17817,"_24317":49335,"_2462":49472},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_2936":2447,"_25651":2394,"_17922":49474,"_5":17817,"_24317":49335,"_2462":49475},[],"What does change is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently ignored because unknown JSON fields are dropped, and GET responses no longer include it. Consequently, an update body built from the old layout empties `validation_cas` without returning any error. To avoid it, always read the DMS before sending an edit and reuse the layout the API returns.",{"_2936":2448,"_25651":2394,"_17922":49477,"_5":17817,"_24317":49339,"_2462":49478},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but both blocks should be read before editing a DMS so that one is not modified while believing the other is being edited.",{"_2936":2449,"_25651":2394,"_17922":49480,"_5":17817,"_24317":49339,"_2462":49481},[],"If the console version does not expose independent settings, they can be edited through the DMS API.",{"_2936":2450,"_25651":2394,"_17922":49483,"_5":17817,"_24317":49343,"_2462":49484},[],"After applying the upgrade, check in this order:",{"_2936":2451,"_25651":2394,"_17922":49486,"_5":17817,"_24317":49343,"_2462":49487},[],"**Webhooks without file fields.** List the DMSs that use a webhook for enrollment or re-enrollment and confirm each `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_2936":2452,"_25651":2394,"_17922":49489,"_5":17817,"_24317":49343,"_2462":49490},[],"**Receiver verification.** Confirm `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_2936":2453,"_25651":2394,"_17922":49492,"_5":17817,"_24317":49343,"_2462":49493},[],"**Delivery.** Trigger, or wait for, one enroll or re-enroll through each migrated webhook and confirm the authorization call completes.",{"_2936":2454,"_25651":2394,"_17922":49495,"_5":17817,"_24317":49343,"_2462":49496},[],"**Trust set.** Read `est_rfc7030_settings.client_certificate_settings.validation_cas` and confirm it holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_2936":2455,"_25651":2394,"_17922":49498,"_5":17817,"_24317":49343,"_2462":49499},[],"**API clients.** Update any script or console that uses the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), since they silently drop those values.",{"_2936":2456,"_25651":2394,"_17922":49501,"_5":17817,"_24317":49343,"_2462":46193},[],{"_2936":2457,"_25651":2394,"_17922":49503,"_5":17817,"_24317":49343,"_2462":49504},[],"<Card title=\"DMS API\" href=\"/docs/api-reference/dms-manager\" />","count","sorting",{"_49508":49509,"_49510":49511,"_49512":49513,"_49514":49515,"_15563":2484,"_59301":2484},"language","english","sortableProperties",[2462,25651,5,24317],"sortablePropertiesWithTypes",{"_2462":21398,"_25651":21398,"_5":21398,"_24317":21398},"sorts",{"_2462":49516,"_25651":51963,"_5":54409,"_24317":56855},{"_3930":49517,"_49518":49519,"_5":21398},{"_12327":18113,"_12680":5050,"_12687":7542,"_24858":5983,"_24420":2825,"_17017":3625,"_12348":6615,"_12355":12506,"_24820":21661,"_25181":10570,"_25202":2910,"_24833":14667,"_29557":6052,"_25213":8023,"_29562":4093,"_29565":14501,"_29568":3903,"_29571":18316,"_29574":2706,"_25527":8462,"_29579":2716,"_29581":3392,"_25557":3082,"_25517":2693,"_29585":2786,"_29588":4998,"_29590":8879,"_25231":10692,"_25522":14270,"_25575":5304,"_29595":6095,"_29597":2901,"_29599":2913,"_29601":4369,"_29603":2755,"_29605":5013,"_29607":3139,"_29609":3938,"_29611":3192,"_24871":4113,"_29614":4278,"_29616":12290,"_24865":5167,"_29619":8276,"_29621":3986,"_29623":13367,"_29626":2996,"_24901":9448,"_25709":2866,"_24811":3496,"_29632":6496,"_24838":6436,"_29635":6452,"_29637":6421,"_29640":11032,"_25552":5635,"_29643":3000,"_29645":4072,"_29648":3444,"_29650":13845,"_29652":6468,"_29654":4908,"_29656":9020,"_17020":4123,"_29659":3894,"_29661":3384,"_29663":2651,"_25225":9455,"_29666":3395,"_29668":6369,"_29670":5029,"_29672":6490,"_29674":3521,"_29676":4219,"_29678":13587,"_25637":3920,"_25252":3441,"_29682":7161,"_29684":5025,"_24849":13500,"_29687":5847,"_29689":14226,"_29691":6310,"_25580":9739,"_29694":3767,"_29696":20364,"_29698":3197,"_29700":14290,"_29702":3102,"_24947":3254,"_29706":2531,"_25219":2983,"_29710":5868,"_29712":7505,"_29714":2541,"_29716":4788,"_29718":4326,"_29720":3251,"_24941":6053,"_