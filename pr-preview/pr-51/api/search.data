7391":114961,"_37394":114964,"_37396":114967,"_37398":114970,"_37400":114973,"_37402":114976,"_37404":114979,"_37406":114982,"_37408":114985,"_37410":114988,"_37412":114991,"_37414":114994,"_37416":114997,"_37418":115000,"_37421":115003,"_37423":115006,"_37425":115009,"_37427":115012,"_37429":115015,"_37431":115018,"_37433":115021,"_37435":115024,"_37437":115027,"_37439":115030,"_37441":115033,"_37443":115036,"_37445":115039,"_37447":115042,"_37449":115045,"_37451":115048,"_37453":115051,"_37455":115054,"_37457":115057,"_37459":115060,"_37461":115063,"_37464":115066,"_37466":115069,"_37468":115072},{"_3172":64453,"_28020":64453,"_5":13734,"_2670":106937,"_28372":106938,"_19450":106941,"_26522":64453},"Despliega desde AWS Marketplace",[45500,106939,106940],"Despliegue","Otros modelos",[],{"_3172":64454,"_28020":64453,"_19450":106943,"_5":13408,"_26522":64453,"_2670":106944},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3172":64455,"_28020":64453,"_5":28369,"_19450":106946,"_26522":106947,"_2670":106948},[],"/docs/pr-preview/pr-51/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3172":64456,"_28020":64453,"_5":28369,"_19450":106950,"_26522":106951,"_2670":106952},[],"/docs/pr-preview/pr-51/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3172":64457,"_28020":64453,"_5":28369,"_19450":106954,"_26522":106955,"_2670":106956},[],"/docs/pr-preview/pr-51/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3172":64458,"_28020":64453,"_5":28369,"_19450":106958,"_26522":106959,"_2670":106960},[],"/docs/pr-preview/pr-51/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3172":64459,"_28020":64453,"_5":28369,"_19450":106962,"_26522":106963,"_2670":106964},[],"/docs/pr-preview/pr-51/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3172":64460,"_28020":64453,"_5":28369,"_19450":106966,"_26522":106967,"_2670":106968},[],"/docs/pr-preview/pr-51/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3172":64461,"_28020":64453,"_5":28369,"_19450":106970,"_26522":106971,"_2670":106972},[],"/docs/pr-preview/pr-51/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3172":64462,"_28020":64453,"_19450":106974,"_5":13408,"_26522":64453,"_2670":106975},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3172":64463,"_28020":64453,"_19450":106977,"_5":13408,"_26522":106947,"_2670":106978},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3172":64464,"_28020":64453,"_19450":106980,"_5":13408,"_26522":106947,"_2670":106981},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3172":64465,"_28020":64453,"_19450":106983,"_5":13408,"_26522":106947,"_2670":106984},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3172":64466,"_28020":64453,"_19450":106986,"_5":13408,"_26522":106951,"_2670":106987},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3172":64467,"_28020":64453,"_19450":106989,"_5":13408,"_26522":106951,"_2670":106990},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3172":64468,"_28020":64453,"_19450":106992,"_5":13408,"_26522":106951,"_2670":106993},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3172":64469,"_28020":64453,"_19450":106995,"_5":13408,"_26522":106955,"_2670":106996},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3172":64470,"_28020":64453,"_19450":106998,"_5":13408,"_26522":106959,"_2670":106999},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3172":64471,"_28020":64453,"_19450":107001,"_5":13408,"_26522":106963,"_2670":107002},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3172":64472,"_28020":64453,"_19450":107004,"_5":13408,"_26522":106967,"_2670":107005},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3172":64473,"_28020":64453,"_19450":107007,"_5":13408,"_26522":106971,"_2670":107008},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3172":64474,"_28020":64474,"_5":13734,"_2670":107010,"_28372":107011,"_19450":107012,"_26522":64474},"Despliega Lamassu",[45500,106939],[],{"_3172":64475,"_28020":64474,"_19450":107014,"_5":13408,"_26522":64474,"_2670":107015},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3172":64476,"_28020":64474,"_5":28369,"_19450":107017,"_26522":107018,"_2670":107019},[],"/docs/pr-preview/pr-51/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3172":64477,"_28020":64474,"_5":28369,"_19450":107021,"_26522":107022,"_2670":107023},[],"/docs/pr-preview/pr-51/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3172":64478,"_28020":64474,"_5":28369,"_19450":107025,"_26522":107026,"_2670":107027},[],"/docs/pr-preview/pr-51/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3172":64479,"_28020":64474,"_19450":107029,"_5":13408,"_26522":64474,"_2670":107030},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3172":64480,"_28020":64474,"_19450":107032,"_5":13408,"_26522":107018,"_2670":107033},[],"Modelo",{"_3172":64481,"_28020":64474,"_19450":107035,"_5":13408,"_26522":107018,"_2670":107036},[],"Recomendado para",{"_3172":64482,"_28020":64474,"_19450":107038,"_5":13408,"_26522":107018,"_2670":107039},[],"Quién opera la infraestructura",{"_3172":64483,"_28020":64474,"_19450":107041,"_5":13408,"_26522":107018,"_2670":107042},[],"Punto de partida",{"_3172":64484,"_28020":64474,"_19450":107044,"_5":13408,"_26522":107018,"_2670":45607},[],{"_3172":64485,"_28020":64474,"_19450":107046,"_5":13408,"_26522":107018,"_2670":107047},[],"Producción, entornos regulados y despliegues personalizados",{"_3172":64486,"_28020":64474,"_19450":107049,"_5":13408,"_26522":107018,"_2670":107050},[],"Tu equipo",{"_3172":64487,"_28020":64474,"_19450":107052,"_5":13408,"_26522":107018,"_2670":107053},[],"Helm o Fastlane",{"_3172":64488,"_28020":64474,"_19450":107055,"_5":13408,"_26522":107018,"_2670":45619},[],{"_3172":64489,"_28020":64474,"_19450":107057,"_5":13408,"_26522":107018,"_2670":107058},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3172":64490,"_28020":64474,"_19450":107060,"_5":13408,"_26522":107018,"_2670":107050},[],{"_3172":64491,"_28020":64474,"_19450":107062,"_5":13408,"_26522":107018,"_2670":107063},[],"Imagen preconfigurada en EC2",{"_3172":64492,"_28020":64474,"_19450":107065,"_5":13408,"_26522":107018,"_2670":45630},[],{"_3172":64493,"_28020":64474,"_19450":107067,"_5":13408,"_26522":107018,"_2670":107068},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3172":64494,"_28020":64474,"_19450":107070,"_5":13408,"_26522":107018,"_2670":45636},[],{"_3172":64495,"_28020":64474,"_19450":107072,"_5":13408,"_26522":107018,"_2670":107073},[],"Suscripción gestionada",{"_3172":64496,"_28020":64474,"_19450":107075,"_5":13408,"_26522":107018,"_2670":107076},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3172":64497,"_28020":64474,"_19450":107078,"_5":13408,"_26522":107018,"_2670":107079},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3172":64498,"_28020":64474,"_19450":107081,"_5":13408,"_26522":107018,"_2670":107082},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3172":64499,"_28020":64474,"_19450":107084,"_5":13408,"_26522":107022,"_2670":107085},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3172":64500,"_28020":64474,"_19450":107087,"_5":13408,"_26522":107026,"_2670":107088},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3172":64501,"_28020":64501,"_5":13734,"_2670":107090,"_28372":107091,"_19450":107092,"_26522":64501},"Utiliza Lamassu como SaaS",[45500,106939,106940],[],{"_3172":64502,"_28020":64501,"_19450":107094,"_5":13408,"_26522":64501,"_2670":107095},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3172":64503,"_28020":64501,"_5":28369,"_19450":107097,"_26522":107098,"_2670":107099},[],"/docs/pr-preview/pr-51/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3172":64504,"_28020":64501,"_5":28369,"_19450":107101,"_26522":107102,"_2670":107103},[],"/docs/pr-preview/pr-51/es/deployment/saas#planes","Planes",{"_3172":64505,"_28020":64501,"_5":28369,"_19450":107105,"_26522":107106,"_2670":107107},[],"/docs/pr-preview/pr-51/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3172":64506,"_28020":64501,"_19450":107109,"_5":13408,"_26522":64501,"_2670":107110},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3172":64507,"_28020":64501,"_19450":107112,"_5":13408,"_26522":107098,"_2670":107113},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3172":64508,"_28020":64501,"_19450":107115,"_5":13408,"_26522":107098,"_2670":107116},[],"Copias de seguridad automáticas.",{"_3172":64509,"_28020":64501,"_19450":107118,"_5":13408,"_26522":107098,"_2670":107119},[],"Actualizaciones de versión.",{"_3172":64510,"_28020":64501,"_19450":107121,"_5":13408,"_26522":107098,"_2670":107122},[],"Soporte técnico y SLA según el plan contratado.",{"_3172":64511,"_28020":64501,"_19450":107124,"_5":13408,"_26522":107102,"_2670":45691},[],{"_3172":64512,"_28020":64501,"_19450":107126,"_5":13408,"_26522":107102,"_2670":107127},[],"Dispositivos",{"_3172":64513,"_28020":64501,"_19450":107129,"_5":13408,"_26522":107102,"_2670":107130},[],"Soporte",{"_3172":64514,"_28020":64501,"_19450":107132,"_5":13408,"_26522":107102,"_2670":45700},[],{"_3172":64515,"_28020":64501,"_19450":107134,"_5":13408,"_26522":107102,"_2670":45703},[],{"_3172":64516,"_28020":64501,"_19450":107136,"_5":13408,"_26522":107102,"_2670":107137},[],"Hasta 1.000",{"_3172":64517,"_28020":64501,"_19450":107139,"_5":13408,"_26522":107102,"_2670":45709},[],{"_3172":64518,"_28020":64501,"_19450":107141,"_5":13408,"_26522":107102,"_2670":107142},[],"99,5 %",{"_3172":64519,"_28020":64501,"_19450":107144,"_5":13408,"_26522":107102,"_2670":45715},[],{"_3172":64520,"_28020":64501,"_19450":107146,"_5":13408,"_26522":107102,"_2670":107147},[],"Hasta 10.000",{"_3172":64521,"_28020":64501,"_19450":107149,"_5":13408,"_26522":107102,"_2670":107150},[],"Email y chat",{"_3172":64522,"_28020":64501,"_19450":107152,"_5":13408,"_26522":107102,"_2670":107153},[],"99,9 %",{"_3172":64523,"_28020":64501,"_19450":107155,"_5":13408,"_26522":107102,"_2670":45727},[],{"_3172":64524,"_28020":64501,"_19450":107157,"_5":13408,"_26522":107102,"_2670":107158},[],"Ilimitados",{"_3172":64525,"_28020":64501,"_19450":107160,"_5":13408,"_26522":107102,"_2670":107161},[],"Dedicado",{"_3172":64526,"_28020":64501,"_19450":107163,"_5":13408,"_26522":107102,"_2670":107164},[],"99,99 %",{"_3172":64527,"_28020":64501,"_19450":107166,"_5":13408,"_26522":107106,"_2670":107167},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3172":64528,"_28020":64501,"_19450":107169,"_5":13408,"_26522":107106,"_2670":107170},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3172":64529,"_28020":64529,"_5":13734,"_2670":45744,"_28372":107172,"_19450":107174,"_26522":64529},[45500,106939,107173],"Kubernetes autogestionado",[],{"_3172":64530,"_28020":64529,"_19450":107176,"_5":13408,"_26522":64529,"_2670":107177},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3172":64531,"_28020":64529,"_5":28369,"_19450":107179,"_26522":107180,"_2670":107181},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3172":64532,"_28020":64529,"_5":28369,"_19450":107183,"_26522":107184,"_2670":107185},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3172":64533,"_28020":64529,"_5":28369,"_19450":107187,"_26522":107188,"_2670":107189},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3172":64534,"_28020":64529,"_5":28369,"_19450":107191,"_26522":107192,"_2670":107193},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3172":64535,"_28020":64529,"_5":28369,"_19450":107195,"_26522":107196,"_2670":107197},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3172":64536,"_28020":64529,"_5":28369,"_19450":107199,"_26522":107200,"_2670":107201},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3172":64537,"_28020":64529,"_5":28369,"_19450":107203,"_26522":107204,"_2670":107205},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3172":64538,"_28020":64529,"_5":28369,"_19450":107207,"_26522":107208,"_2670":107209},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3172":64539,"_28020":64529,"_5":28369,"_19450":107211,"_26522":107212,"_2670":107213},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3172":64540,"_28020":64529,"_5":28369,"_19450":107215,"_26522":107216,"_2670":107217},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3172":64541,"_28020":64529,"_5":28369,"_19450":107219,"_26522":107220,"_2670":107221},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3172":64542,"_28020":64529,"_19450":107223,"_5":13408,"_26522":107180,"_2670":107224},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3172":64543,"_28020":64529,"_19450":107226,"_5":13408,"_26522":107180,"_2670":107227},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3172":64544,"_28020":64529,"_19450":107229,"_5":13408,"_26522":107184,"_2670":107230},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3172":64545,"_28020":64529,"_19450":107232,"_5":13408,"_26522":107184,"_2670":107233},[],"Fastlane instala o configura",{"_3172":64546,"_28020":64529,"_19450":107235,"_5":13408,"_26522":107184,"_2670":107236},[],"Tú sigues proporcionando",{"_3172":64547,"_28020":64529,"_19450":107238,"_5":13408,"_26522":107184,"_2670":107239},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3172":64548,"_28020":64529,"_19450":107241,"_5":13408,"_26522":107184,"_2670":107242},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3172":64549,"_28020":64529,"_19450":107244,"_5":13408,"_26522":107184,"_2670":107245},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3172":64550,"_28020":64529,"_19450":107247,"_5":13408,"_26522":107184,"_2670":107248},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3172":64551,"_28020":64529,"_19450":107250,"_5":13408,"_26522":107184,"_2670":107251},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3172":64552,"_28020":64529,"_19450":107253,"_5":13408,"_26522":107184,"_2670":107254},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3172":64553,"_28020":64529,"_19450":107256,"_5":13408,"_26522":107184,"_2670":107257},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3172":64554,"_28020":64529,"_19450":107259,"_5":13408,"_26522":107184,"_2670":107260},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3172":64555,"_28020":64529,"_19450":107262,"_5":13408,"_26522":107184,"_2670":107263},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3172":64556,"_28020":64529,"_19450":107265,"_5":13408,"_26522":107188,"_2670":107266},[],"Necesitas:",{"_3172":64557,"_28020":64529,"_19450":107268,"_5":13408,"_26522":107188,"_2670":107269},[],"un clúster Kubernetes existente",{"_3172":64558,"_28020":64529,"_19450":107271,"_5":13408,"_26522":107188,"_2670":107272},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3172":64559,"_28020":64529,"_19450":107274,"_5":13408,"_26522":107188,"_2670":45846},[],{"_3172":64560,"_28020":64529,"_19450":107276,"_5":13408,"_26522":107188,"_2670":22024},[],{"_3172":64561,"_28020":64529,"_19450":107278,"_5":13408,"_26522":107188,"_2670":107279},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3172":64562,"_28020":64529,"_19450":107281,"_5":13408,"_26522":107188,"_2670":107282},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3172":64563,"_28020":64529,"_19450":107284,"_5":13408,"_26522":107188,"_2670":107285},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3172":64564,"_28020":64529,"_19450":107287,"_5":13408,"_26522":107188,"_2670":107288},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3172":64565,"_28020":64529,"_19450":107290,"_5":13408,"_26522":107188,"_2670":107291},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3172":64566,"_28020":64529,"_19450":107293,"_5":13408,"_26522":107192,"_2670":107294},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3172":64567,"_28020":64529,"_19450":107296,"_5":13408,"_26522":107192,"_2670":107297},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3172":64568,"_28020":64529,"_19450":107299,"_5":13408,"_26522":107196,"_2670":107300},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3172":64569,"_28020":64529,"_19450":107302,"_5":13408,"_26522":107196,"_2670":107303},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3172":64570,"_28020":64529,"_19450":107305,"_5":13408,"_26522":107196,"_2670":107306},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3172":64571,"_28020":64529,"_19450":107308,"_5":13408,"_26522":107196,"_2670":107309},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3172":64572,"_28020":64529,"_19450":107311,"_5":13408,"_26522":107200,"_2670":107312},[],"Opción",{"_3172":64573,"_28020":64529,"_19450":107314,"_5":13408,"_26522":107200,"_2670":107315},[],"Valor predeterminado",{"_3172":64574,"_28020":64529,"_19450":107317,"_5":13408,"_26522":107200,"_2670":107318},[],"Propósito",{"_3172":64575,"_28020":64529,"_19450":107320,"_5":13408,"_26522":107200,"_2670":45893},[],{"_3172":64576,"_28020":64529,"_19450":107322,"_5":13408,"_26522":107200,"_2670":45896},[],{"_3172":64577,"_28020":64529,"_19450":107324,"_5":13408,"_26522":107200,"_2670":107325},[],"Muestra la ayuda",{"_3172":64578,"_28020":64529,"_19450":107327,"_5":13408,"_26522":107200,"_2670":45902},[],{"_3172":64579,"_28020":64529,"_19450":107329,"_5":13408,"_26522":107200,"_2670":107330},[],"contexto actual",{"_3172":64580,"_28020":64529,"_19450":107332,"_5":13408,"_26522":107200,"_2670":107333},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3172":64581,"_28020":64529,"_19450":107335,"_5":13408,"_26522":107200,"_2670":45911},[],{"_3172":64582,"_28020":64529,"_19450":107337,"_5":13408,"_26522":107200,"_2670":5990},[],{"_3172":64583,"_28020":64529,"_19450":107339,"_5":13408,"_26522":107200,"_2670":107340},[],"Omite prompts y genera credenciales para las dependencias",{"_3172":64584,"_28020":64529,"_19450":107342,"_5":13408,"_26522":107200,"_2670":45919},[],{"_3172":64585,"_28020":64529,"_19450":107344,"_5":13408,"_26522":107200,"_2670":45922},[],{"_3172":64586,"_28020":64529,"_19450":107346,"_5":13408,"_26522":107200,"_2670":107347},[],"Namespace de la instalación",{"_3172":64587,"_28020":64529,"_19450":107349,"_5":13408,"_26522":107200,"_2670":45928},[],{"_3172":64588,"_28020":64529,"_19450":107351,"_5":13408,"_26522":107200,"_2670":45931},[],{"_3172":64589,"_28020":64529,"_19450":107353,"_5":13408,"_26522":107200,"_2670":107354},[],"Dominio usado por la UI, OIDC y el certificado",{"_3172":64590,"_28020":64529,"_19450":107356,"_5":13408,"_26522":107200,"_2670":45937},[],{"_3172":64591,"_28020":64529,"_19450":107358,"_5":13408,"_26522":107200,"_2670":14028},[],{"_3172":64592,"_28020":64529,"_19450":107360,"_5":13408,"_26522":107200,"_2670":107361},[],"Versión del chart de Lamassu",{"_3172":64593,"_28020":64529,"_19450":107363,"_5":13408,"_26522":107200,"_2670":45945},[],{"_3172":64594,"_28020":64529,"_19450":107365,"_5":13408,"_26522":107200,"_2670":45948},[],{"_3172":64595,"_28020":64529,"_19450":107367,"_5":13408,"_26522":107200,"_2670":107368},[],"Puerto del listener HTTPS",{"_3172":64596,"_28020":64529,"_19450":107370,"_5":13408,"_26522":107200,"_2670":45954},[],{"_3172":64597,"_28020":64529,"_19450":107372,"_5":13408,"_26522":107200,"_2670":45957},[],{"_3172":64598,"_28020":64529,"_19450":107374,"_5":13408,"_26522":107200,"_2670":107375},[],"Puerto del listener HTTP",{"_3172":64599,"_28020":64529,"_19450":107377,"_5":13408,"_26522":107200,"_2670":45963},[],{"_3172":64600,"_28020":64529,"_19450":107379,"_5":13408,"_26522":107200,"_2670":45896},[],{"_3172":64601,"_28020":64529,"_19450":107381,"_5":13408,"_26522":107200,"_2670":107382},[],"Certificado PEM para TLS downstream",{"_3172":64602,"_28020":64529,"_19450":107384,"_5":13408,"_26522":107200,"_2670":45971},[],{"_3172":64603,"_28020":64529,"_19450":107386,"_5":13408,"_26522":107200,"_2670":45896},[],{"_3172":64604,"_28020":64529,"_19450":107388,"_5":13408,"_26522":107200,"_2670":107389},[],"Clave privada PEM para TLS downstream",{"_3172":64605,"_28020":64529,"_19450":107391,"_5":13408,"_26522":107200,"_2670":45979},[],{"_3172":64606,"_28020":64529,"_19450":107393,"_5":13408,"_26522":107200,"_2670":107394},[],"chart del repositorio",{"_3172":64607,"_28020":64529,"_19450":107396,"_5":13408,"_26522":107200,"_2670":107397},[],"Usa un chart local de Lamassu sin empaquetar",{"_3172":64608,"_28020":64529,"_19450":107399,"_5":13408,"_26522":107200,"_2670":45988},[],{"_3172":64609,"_28020":64529,"_19450":107401,"_5":13408,"_26522":107200,"_2670":107402},[],"detección automática",{"_3172":64610,"_28020":64529,"_19450":107404,"_5":13408,"_26522":107200,"_2670":107405},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3172":64611,"_28020":64529,"_19450":107407,"_5":13408,"_26522":107200,"_2670":45996},[],{"_3172":64612,"_28020":64529,"_19450":107409,"_5":13408,"_26522":107200,"_2670":5990},[],{"_3172":64613,"_28020":64529,"_19450":107411,"_5":13408,"_26522":107200,"_2670":107412},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3172":64614,"_28020":64529,"_19450":107414,"_5":13408,"_26522":107200,"_2670":46004},[],{"_3172":64615,"_28020":64529,"_19450":107416,"_5":13408,"_26522":107200,"_2670":5990},[],{"_3172":64616,"_28020":64529,"_19450":107418,"_5":13408,"_26522":107200,"_2670":107419},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3172":64617,"_28020":64529,"_19450":107421,"_5":13408,"_26522":107200,"_2670":46012},[],{"_3172":64618,"_28020":64529,"_19450":107423,"_5":13408,"_26522":107200,"_2670":5990},[],{"_3172":64619,"_28020":64529,"_19450":107425,"_5":13408,"_26522":107200,"_2670":107426},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3172":64620,"_28020":64529,"_19450":107428,"_5":13408,"_26522":107200,"_2670":46020},[],{"_3172":64621,"_28020":64529,"_19450":107430,"_5":13408,"_26522":107200,"_2670":5990},[],{"_3172":64622,"_28020":64529,"_19450":107432,"_5":13408,"_26522":107200,"_2670":107433},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3172":64623,"_28020":64529,"_19450":107435,"_5":13408,"_26522":107200,"_2670":46028},[],{"_3172":64624,"_28020":64529,"_19450":107437,"_5":13408,"_26522":107200,"_2670":46031},[],{"_3172":64625,"_28020":64529,"_19450":107439,"_5":13408,"_26522":107200,"_2670":107440},[],"Usa otro chart local de SoftHSM",{"_3172":64626,"_28020":64529,"_19450":107442,"_5":13408,"_26522":107200,"_2670":107443},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3172":64627,"_28020":64529,"_19450":107445,"_5":13408,"_26522":107204,"_2670":107446},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3172":64628,"_28020":64529,"_19450":107448,"_5":13408,"_26522":107204,"_2670":107449},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3172":64629,"_28020":64529,"_19450":107451,"_5":13408,"_26522":107204,"_2670":107452},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3172":64630,"_28020":64529,"_19450":107454,"_5":13408,"_26522":107204,"_2670":107455},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3172":64631,"_28020":64529,"_19450":107457,"_5":13408,"_26522":107204,"_2670":107458},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3172":64632,"_28020":64529,"_19450":107460,"_5":13408,"_26522":107204,"_2670":107461},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3172":64633,"_28020":64529,"_19450":107463,"_5":13408,"_26522":107208,"_2670":46058},[],{"_3172":64634,"_28020":64529,"_19450":107465,"_5":13408,"_26522":107208,"_2670":107466},[],"valida las herramientas locales y el clúster seleccionado",{"_3172":64635,"_28020":64529,"_19450":107468,"_5":13408,"_26522":107208,"_2670":107469},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3172":64636,"_28020":64529,"_19450":107471,"_5":13408,"_26522":107208,"_2670":107472},[],"crea el namespace",{"_3172":64637,"_28020":64529,"_19450":107474,"_5":13408,"_26522":107208,"_2670":107475},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3172":64638,"_28020":64529,"_19450":107477,"_5":13408,"_26522":107208,"_2670":107478},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3172":64639,"_28020":64529,"_19450":107480,"_5":13408,"_26522":107208,"_2670":107481},[],"instala RabbitMQ",{"_3172":64640,"_28020":64529,"_19450":107483,"_5":13408,"_26522":107208,"_2670":107484},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3172":64641,"_28020":64529,"_19450":107486,"_5":13408,"_26522":107208,"_2670":107487},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3172":64642,"_28020":64529,"_19450":107489,"_5":13408,"_26522":107208,"_2670":107490},[],"carga datos de ejemplo opcionalmente",{"_3172":64643,"_28020":64529,"_19450":107492,"_5":13408,"_26522":107208,"_2670":107493},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3172":64644,"_28020":64529,"_19450":107495,"_5":13408,"_26522":107212,"_2670":107496},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3172":64645,"_28020":64529,"_19450":107498,"_5":13408,"_26522":107212,"_2670":107499},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3172":64646,"_28020":64529,"_19450":107501,"_5":13408,"_26522":107216,"_2670":107502},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3172":64647,"_28020":64529,"_19450":107504,"_5":13408,"_26522":107216,"_2670":107505},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3172":64648,"_28020":64529,"_19450":107507,"_5":13408,"_26522":107216,"_2670":107508},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3172":64649,"_28020":64529,"_19450":107510,"_5":13408,"_26522":107220,"_2670":107511},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3172":64650,"_28020":64650,"_5":13734,"_2670":107513,"_28372":107514,"_19450":107515,"_26522":64650},"Instala con Helm",[45500,106939,107173],[],{"_3172":64651,"_28020":64650,"_19450":107517,"_5":13408,"_26522":64650,"_2670":107518},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3172":64652,"_28020":64650,"_5":28369,"_19450":107520,"_26522":107521,"_2670":107522},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3172":64653,"_28020":64650,"_5":28369,"_19450":107524,"_26522":107525,"_2670":107189},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3172":64654,"_28020":64650,"_5":28369,"_19450":107527,"_26522":107528,"_2670":107529},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3172":64655,"_28020":64650,"_5":28369,"_19450":107531,"_26522":107532,"_2670":107533},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3172":64656,"_28020":64650,"_5":28369,"_19450":107535,"_26522":107536,"_2670":107537},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3172":64657,"_28020":64650,"_5":28369,"_19450":107539,"_26522":107540,"_2670":107541},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3172":64658,"_28020":64650,"_5":28369,"_19450":107543,"_26522":107544,"_2670":107545},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3172":64659,"_28020":64650,"_5":28369,"_19450":107547,"_26522":107548,"_2670":107549},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3172":64660,"_28020":64650,"_5":28369,"_19450":107551,"_26522":107552,"_2670":107553},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3172":64661,"_28020":64650,"_19450":107555,"_5":13408,"_26522":107521,"_2670":107556},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3172":64662,"_28020":64650,"_19450":107558,"_5":13408,"_26522":107525,"_2670":107559},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3172":64663,"_28020":64650,"_19450":107561,"_5":13408,"_26522":107525,"_2670":107562},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3172":64664,"_28020":64650,"_19450":107564,"_5":13408,"_26522":107525,"_2670":107565},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3172":64665,"_28020":64650,"_19450":107567,"_5":13408,"_26522":107525,"_2670":107568},[],"un broker RabbitMQ accesible y sus credenciales",{"_3172":64666,"_28020":64650,"_19450":107570,"_5":13408,"_26522":107525,"_2670":107571},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3172":64667,"_28020":64650,"_19450":107573,"_5":13408,"_26522":107525,"_2670":107574},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3172":64668,"_28020":64650,"_19450":107576,"_5":13408,"_26522":107525,"_2670":107577},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3172":64669,"_28020":64650,"_19450":107579,"_5":13408,"_26522":107525,"_2670":107580},[],"una StorageClass y un diseño de tráfico externo",{"_3172":64670,"_28020":64650,"_19450":107582,"_5":13408,"_26522":107525,"_2670":107583},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3172":64671,"_28020":64650,"_19450":107585,"_5":13408,"_26522":107525,"_2670":107586},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3172":64672,"_28020":64650,"_19450":107588,"_5":13408,"_26522":107525,"_2670":107589},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3172":64673,"_28020":64650,"_19450":107591,"_5":13408,"_26522":107528,"_2670":107592},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3172":64674,"_28020":64650,"_19450":107594,"_5":13408,"_26522":107528,"_2670":107595},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3172":64675,"_28020":64650,"_19450":107597,"_5":13408,"_26522":107528,"_2670":107598},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3172":64676,"_28020":64650,"_19450":107600,"_5":13408,"_26522":107532,"_2670":107601},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3172":64677,"_28020":64650,"_19450":107603,"_5":13408,"_26522":107532,"_2670":107604},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3172":64678,"_28020":64650,"_19450":107606,"_5":13408,"_26522":107532,"_2670":107607},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3172":64679,"_28020":64650,"_19450":107609,"_5":13408,"_26522":107536,"_2670":107610},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3172":64680,"_28020":64650,"_19450":107612,"_5":13408,"_26522":107540,"_2670":107613},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3172":64681,"_28020":64650,"_19450":107615,"_5":13408,"_26522":107540,"_2670":107616},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3172":64682,"_28020":64650,"_19450":107618,"_5":13408,"_26522":107540,"_2670":107619},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3172":64683,"_28020":64650,"_19450":107621,"_5":13408,"_26522":107540,"_2670":107622},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3172":64684,"_28020":64650,"_19450":107624,"_5":13408,"_26522":107544,"_2670":107625},[],"Para instalar un checkout local:",{"_3172":64685,"_28020":64650,"_19450":107627,"_5":13408,"_26522":107548,"_2670":107628},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3172":64686,"_28020":64650,"_19450":107630,"_5":13408,"_26522":107548,"_2670":107631},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3172":64687,"_28020":64650,"_19450":107633,"_5":13408,"_26522":107552,"_2670":107634},[],"Antes de pasar a producción, revisa:",{"_3172":64688,"_28020":64650,"_19450":107636,"_5":13408,"_26522":107552,"_2670":107637},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3172":64689,"_28020":64650,"_19450":107639,"_5":13408,"_26522":107552,"_2670":107640},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3172":64690,"_28020":64650,"_19450":107642,"_5":13408,"_26522":107552,"_2670":107643},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3172":64691,"_28020":64650,"_19450":107645,"_5":13408,"_26522":107552,"_2670":107646},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3172":64692,"_28020":64650,"_19450":107648,"_5":13408,"_26522":107552,"_2670":107649},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3172":64693,"_28020":64650,"_19450":107651,"_5":13408,"_26522":107552,"_2670":107652},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3172":64694,"_28020":64650,"_19450":107654,"_5":13408,"_26522":107552,"_2670":107655},[],"SMTP, observabilidad y entrega de alertas",{"_3172":64695,"_28020":64650,"_19450":107657,"_5":13408,"_26522":107552,"_2670":107658},[],"las guías de actualización entre versiones y las notas de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_3172":64696,"_28020":64650,"_19450":107660,"_5":13408,"_26522":107552,"_2670":107661},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3172":64697,"_28020":64697,"_5":13734,"_2670":107663,"_28372":107664,"_19450":107665,"_26522":64697},"Expón el Gateway",[45500,106939,107173],[],{"_3172":64698,"_28020":64697,"_19450":107667,"_5":13408,"_26522":64697,"_2670":107668},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3172":64699,"_28020":64697,"_5":28369,"_19450":107670,"_26522":107671,"_2670":107672},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3172":64700,"_28020":64697,"_5":28369,"_19450":107674,"_26522":107675,"_2670":107676},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3172":64701,"_28020":64697,"_5":28369,"_19450":107678,"_26522":107679,"_2670":107680},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3172":64702,"_28020":64697,"_5":28369,"_19450":107682,"_26522":107683,"_2670":46279},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/networking#k3s",{"_3172":64703,"_28020":64697,"_5":28369,"_19450":107685,"_26522":107686,"_2670":107687},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3172":64704,"_28020":64697,"_5":28369,"_19450":107689,"_26522":107690,"_2670":107691},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3172":64705,"_28020":64697,"_5":28369,"_19450":107693,"_26522":107694,"_2670":107695},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3172":64706,"_28020":64697,"_5":28369,"_19450":107697,"_26522":107698,"_2670":107699},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3172":64707,"_28020":64697,"_5":28369,"_19450":107701,"_26522":107702,"_2670":107703},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3172":64708,"_28020":64697,"_19450":107705,"_5":13408,"_26522":107671,"_2670":107706},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3172":64709,"_28020":64697,"_19450":107708,"_5":13408,"_26522":107671,"_2670":107709},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3172":64710,"_28020":64697,"_19450":107711,"_5":13408,"_26522":107675,"_2670":107712},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3172":64711,"_28020":64697,"_19450":107714,"_5":13408,"_26522":107675,"_2670":107715},[],"Defínelo únicamente cuando:",{"_3172":64712,"_28020":64697,"_19450":107717,"_5":13408,"_26522":107675,"_2670":107718},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3172":64713,"_28020":64697,"_19450":107720,"_5":13408,"_26522":107675,"_2670":107721},[],"esa dirección está asignada a este Gateway",{"_3172":64714,"_28020":64697,"_19450":107723,"_5":13408,"_26522":107675,"_2670":107724},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3172":64715,"_28020":64697,"_19450":107726,"_5":13408,"_26522":107675,"_2670":107727},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3172":64716,"_28020":64697,"_19450":107729,"_5":13408,"_26522":107675,"_2670":107730},[],"No confundas estos valores:",{"_3172":64717,"_28020":64697,"_19450":107732,"_5":13408,"_26522":107675,"_2670":107733},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3172":64718,"_28020":64697,"_19450":107735,"_5":13408,"_26522":107675,"_2670":107736},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3172":64719,"_28020":64697,"_19450":107738,"_5":13408,"_26522":107675,"_2670":107739},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3172":64720,"_28020":64697,"_19450":107741,"_5":13408,"_26522":107679,"_2670":107742},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3172":64721,"_28020":64697,"_19450":107744,"_5":13408,"_26522":107679,"_2670":107745},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3172":64722,"_28020":64697,"_19450":107747,"_5":13408,"_26522":107683,"_2670":107748},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3172":64723,"_28020":64697,"_19450":107750,"_5":13408,"_26522":107683,"_2670":107751},[],"Para el diseño recomendado:",{"_3172":64724,"_28020":64697,"_19450":107753,"_5":13408,"_26522":107683,"_2670":107754},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3172":64725,"_28020":64697,"_19450":107756,"_5":13408,"_26522":107683,"_2670":107757},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3172":64726,"_28020":64697,"_19450":107759,"_5":13408,"_26522":107683,"_2670":107760},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3172":64727,"_28020":64697,"_19450":107762,"_5":13408,"_26522":107683,"_2670":107763},[],"Apunta DNS a la dirección accesible de la VM.",{"_3172":64728,"_28020":64697,"_19450":107765,"_5":13408,"_26522":107683,"_2670":107766},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3172":64729,"_28020":64697,"_19450":107768,"_5":13408,"_26522":107686,"_2670":107769},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3172":64730,"_28020":64697,"_19450":107771,"_5":13408,"_26522":107690,"_2670":107772},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3172":64731,"_28020":64697,"_19450":107774,"_5":13408,"_26522":107690,"_2670":107775},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3172":64732,"_28020":64697,"_19450":107777,"_5":13408,"_26522":107694,"_2670":107778},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3172":64733,"_28020":64697,"_19450":107780,"_5":13408,"_26522":107694,"_2670":107781},[],"Requisito",{"_3172":64734,"_28020":64697,"_19450":107783,"_5":13408,"_26522":107694,"_2670":107784},[],"Diseño recomendado",{"_3172":64735,"_28020":64697,"_19450":107786,"_5":13408,"_26522":107694,"_2670":107787},[],"Consecuencia",{"_3172":64736,"_28020":64697,"_19450":107789,"_5":13408,"_26522":107694,"_2670":107790},[],"Varias URL o servicios de Lamassu",{"_3172":64737,"_28020":64697,"_19450":107792,"_5":13408,"_26522":107694,"_2670":107793},[],"Un Gateway con varias rutas",{"_3172":64738,"_28020":64697,"_19450":107795,"_5":13408,"_26522":107694,"_2670":107796},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3172":64739,"_28020":64697,"_19450":107798,"_5":13408,"_26522":107694,"_2670":107799},[],"Gateways independientes e IP externas distintas",{"_3172":64740,"_28020":64697,"_19450":107801,"_5":13408,"_26522":107694,"_2670":107802},[],"Una VIP por Gateway",{"_3172":64741,"_28020":64697,"_19450":107804,"_5":13408,"_26522":107694,"_2670":107805},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3172":64742,"_28020":64697,"_19450":107807,"_5":13408,"_26522":107694,"_2670":107808},[],"Gateways independientes, un nodo y una IP",{"_3172":64743,"_28020":64697,"_19450":107810,"_5":13408,"_26522":107694,"_2670":107811},[],"Puertos externos diferentes",{"_3172":64744,"_28020":64697,"_19450":107813,"_5":13408,"_26522":107694,"_2670":107814},[],"Los clientes deben indicar puertos no estándar",{"_3172":64745,"_28020":64697,"_19450":107816,"_5":13408,"_26522":107694,"_2670":107817},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3172":64746,"_28020":64697,"_19450":107819,"_5":13408,"_26522":107694,"_2670":107820},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3172":64747,"_28020":64697,"_19450":107822,"_5":13408,"_26522":107694,"_2670":107823},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3172":64748,"_28020":64697,"_19450":107825,"_5":13408,"_26522":107694,"_2670":107826},[],"Recursos Gateway separados pero proxy compartido",{"_3172":64749,"_28020":64697,"_19450":107828,"_5":13408,"_26522":107694,"_2670":107829},[],"Modo merged Gateway de Envoy",{"_3172":64750,"_28020":64697,"_19450":107831,"_5":13408,"_26522":107694,"_2670":107832},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3172":64751,"_28020":64697,"_19450":107834,"_5":13408,"_26522":107694,"_2670":107835},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3172":64752,"_28020":64697,"_19450":107837,"_5":13408,"_26522":107694,"_2670":107838},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3172":64753,"_28020":64697,"_19450":107840,"_5":13408,"_26522":107694,"_2670":107841},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3172":64754,"_28020":64697,"_19450":107843,"_5":13408,"_26522":107694,"_2670":107844},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3172":64755,"_28020":64697,"_19450":107846,"_5":13408,"_26522":107698,"_2670":107847},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3172":64756,"_28020":64697,"_19450":107849,"_5":13408,"_26522":107698,"_2670":107850},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3172":64757,"_28020":64697,"_19450":107852,"_5":13408,"_26522":107698,"_2670":107853},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3172":64758,"_28020":64697,"_19450":107855,"_5":13408,"_26522":107698,"_2670":107856},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3172":64759,"_28020":64697,"_19450":107858,"_5":13408,"_26522":107698,"_2670":107859},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3172":64760,"_28020":64697,"_19450":107861,"_5":13408,"_26522":107702,"_2670":107862},[],"Comprueba, en orden:",{"_3172":64761,"_28020":64697,"_19450":107864,"_5":13408,"_26522":107702,"_2670":107865},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3172":64762,"_28020":64697,"_19450":107867,"_5":13408,"_26522":107702,"_2670":107868},[],"Su estado contiene la dirección esperada.",{"_3172":64763,"_28020":64697,"_19450":107870,"_5":13408,"_26522":107702,"_2670":107871},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3172":64764,"_28020":64697,"_19450":107873,"_5":13408,"_26522":107702,"_2670":107874},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3172":64765,"_28020":64697,"_19450":107876,"_5":13408,"_26522":107702,"_2670":107877},[],"DNS resuelve al endpoint accesible externamente.",{"_3172":64766,"_28020":64697,"_19450":107879,"_5":13408,"_26522":107702,"_2670":107880},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3172":64767,"_28020":64697,"_19450":107882,"_5":13408,"_26522":107702,"_2670":107883},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3172":64768,"_28020":64768,"_5":13734,"_2670":45607,"_28372":107885,"_19450":107886,"_26522":64768},[45500,106939,107173],[],{"_3172":64769,"_28020":64768,"_19450":107888,"_5":13408,"_26522":64768,"_2670":107889},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3172":64770,"_28020":64768,"_5":28369,"_19450":107891,"_26522":107892,"_2670":107893},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3172":64771,"_28020":64768,"_5":28369,"_19450":107895,"_26522":107896,"_2670":107897},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3172":64772,"_28020":64768,"_5":28369,"_19450":107899,"_26522":107900,"_2670":107901},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3172":64773,"_28020":64768,"_5":28369,"_19450":107903,"_26522":107904,"_2670":107905},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3172":64774,"_28020":64768,"_5":28369,"_19450":107907,"_26522":107908,"_2670":107909},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3172":64775,"_28020":64768,"_5":28369,"_19450":107911,"_26522":107912,"_2670":107913},[],"/docs/pr-preview/pr-51/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3172":64776,"_28020":64768,"_19450":107915,"_5":13408,"_26522":107892,"_2670":107916},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3172":64777,"_28020":64768,"_19450":107918,"_5":13408,"_26522":107896,"_2670":107919},[],"Flujo",{"_3172":64778,"_28020":64768,"_19450":107921,"_5":13408,"_26522":107896,"_2670":107922},[],"Úsalo para",{"_3172":64779,"_28020":64768,"_19450":107924,"_5":13408,"_26522":107896,"_2670":107925},[],"Qué instala",{"_3172":64780,"_28020":64768,"_19450":107927,"_5":13408,"_26522":107896,"_2670":46524},[],{"_3172":64781,"_28020":64768,"_19450":107929,"_5":13408,"_26522":107896,"_2670":107930},[],"Producción y entornos controlados",{"_3172":64782,"_28020":64768,"_19450":107932,"_5":13408,"_26522":107896,"_2670":107933},[],"Servicios de Lamassu y recursos de Gateway API",{"_3172":64783,"_28020":64768,"_19450":107935,"_5":13408,"_26522":107896,"_2670":45744},[],{"_3172":64784,"_28020":64768,"_19450":107937,"_5":13408,"_26522":107896,"_2670":107938},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3172":64785,"_28020":64768,"_19450":107940,"_5":13408,"_26522":107896,"_2670":107941},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3172":64786,"_28020":64768,"_19450":107943,"_5":13408,"_26522":107900,"_2670":107944},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3172":64787,"_28020":64768,"_19450":107946,"_5":13408,"_26522":107900,"_2670":107947},[],"Área",{"_3172":64788,"_28020":64768,"_19450":107949,"_5":13408,"_26522":107900,"_2670":107950},[],"El chart de Lamassu proporciona",{"_3172":64789,"_28020":64768,"_19450":107952,"_5":13408,"_26522":107900,"_2670":107953},[],"Tú proporcionas",{"_3172":64790,"_28020":64768,"_19450":107955,"_5":13408,"_26522":107900,"_2670":107956},[],"Aplicaciones Lamassu",{"_3172":64791,"_28020":64768,"_19450":107958,"_5":13408,"_26522":107900,"_2670":107959},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3172":64792,"_28020":64768,"_19450":107961,"_5":13408,"_26522":107900,"_2670":107962},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3172":64793,"_28020":64768,"_19450":107964,"_5":13408,"_26522":107900,"_2670":107965},[],"Datos PostgreSQL",{"_3172":64794,"_28020":64768,"_19450":107967,"_5":13408,"_26522":107900,"_2670":107968},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3172":64795,"_28020":64768,"_19450":107970,"_5":13408,"_26522":107900,"_2670":107971},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3172":64796,"_28020":64768,"_19450":107973,"_5":13408,"_26522":107900,"_2670":107974},[],"Mensajería",{"_3172":64797,"_28020":64768,"_19450":107976,"_5":13408,"_26522":107900,"_2670":107977},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_3172":64798,"_28020":64768,"_19450":107979,"_5":13408,"_26522":107900,"_2670":107980},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3172":64799,"_28020":64768,"_19450":107982,"_5":13408,"_26522":107900,"_2670":107983},[],"Identidad",{"_3172":64800,"_28020":64768,"_19450":107985,"_5":13408,"_26522":107900,"_2670":107986},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3172":64801,"_28020":64768,"_19450":107988,"_5":13408,"_26522":107900,"_2670":107989},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3172":64802,"_28020":64768,"_19450":107991,"_5":13408,"_26522":107900,"_2670":107992},[],"Enrutamiento externo",{"_3172":64803,"_28020":64768,"_19450":107994,"_5":13408,"_26522":107900,"_2670":107995},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3172":64804,"_28020":64768,"_19450":107997,"_5":13408,"_26522":107900,"_2670":107998},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3172":64805,"_28020":64768,"_19450":108000,"_5":13408,"_26522":107900,"_2670":46598},[],{"_3172":64806,"_28020":64768,"_19450":108002,"_5":13408,"_26522":107900,"_2670":108003},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3172":64807,"_28020":64768,"_19450":108005,"_5":13408,"_26522":107900,"_2670":108006},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3172":64808,"_28020":64768,"_19450":108008,"_5":13408,"_26522":107900,"_2670":108009},[],"Datos persistentes de la aplicación",{"_3172":64809,"_28020":64768,"_19450":108011,"_5":13408,"_26522":107900,"_2670":108012},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3172":64810,"_28020":64768,"_19450":108014,"_5":13408,"_26522":107900,"_2670":108015},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3172":64811,"_28020":64768,"_19450":108017,"_5":13408,"_26522":107900,"_2670":108018},[],"Integraciones opcionales",{"_3172":64812,"_28020":64768,"_19450":108020,"_5":13408,"_26522":107900,"_2670":108021},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3172":64813,"_28020":64768,"_19450":108023,"_5":13408,"_26522":107900,"_2670":108024},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3172":64814,"_28020":64768,"_19450":108026,"_5":13408,"_26522":107900,"_2670":108027},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3172":64815,"_28020":64768,"_19450":108029,"_5":13408,"_26522":107900,"_2670":108030},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3172":64816,"_28020":64768,"_19450":108032,"_5":13408,"_26522":107904,"_2670":108033},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3172":64817,"_28020":64768,"_19450":108035,"_5":13408,"_26522":107904,"_2670":108036},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3172":64818,"_28020":64768,"_19450":108038,"_5":13408,"_26522":107908,"_2670":108039},[],"Kubernetes 1.24 o posterior",{"_3172":64819,"_28020":64768,"_19450":108041,"_5":13408,"_26522":107908,"_2670":108042},[],"Helm 3.2 o posterior",{"_3172":64820,"_28020":64768,"_19450":108044,"_5":13408,"_26522":107908,"_2670":108045},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3172":64821,"_28020":64768,"_19450":108047,"_5":13408,"_26522":107908,"_2670":108048},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3172":64822,"_28020":64768,"_19450":108050,"_5":13408,"_26522":107908,"_2670":108051},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3172":64823,"_28020":64768,"_19450":108053,"_5":13408,"_26522":107908,"_2670":108054},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3172":64824,"_28020":64768,"_19450":108056,"_5":13408,"_26522":107908,"_2670":108057},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3172":64825,"_28020":64768,"_19450":108059,"_5":13408,"_26522":107912,"_2670":108060},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3172":64826,"_28020":64768,"_19450":108062,"_5":13408,"_26522":107912,"_2670":108063},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3172":64827,"_28020":64768,"_19450":108065,"_5":13408,"_26522":107912,"_2670":108066},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3172":64828,"_28020":64768,"_19450":108068,"_5":13408,"_26522":107912,"_2670":108069},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3172":64829,"_28020":64829,"_5":13734,"_2670":108071,"_28372":108072,"_19450":108074,"_26522":64829},"Resolución de problemas de despliegue",[45500,106939,108073],"Operación",[],{"_3172":64830,"_28020":64829,"_19450":108076,"_5":13408,"_26522":64829,"_2670":108077},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3172":64831,"_28020":64829,"_5":28369,"_19450":108079,"_26522":108080,"_2670":108081},[],"/docs/pr-preview/pr-51/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3172":64832,"_28020":64829,"_5":28369,"_19450":108083,"_26522":108084,"_2670":108085},[],"/docs/pr-preview/pr-51/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3172":64833,"_28020":64829,"_5":28369,"_19450":108087,"_26522":108088,"_2670":108089},[],"/docs/pr-preview/pr-51/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3172":64834,"_28020":64829,"_5":28369,"_19450":108091,"_26522":108092,"_2670":108093},[],"/docs/pr-preview/pr-51/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3172":64835,"_28020":64829,"_5":28369,"_19450":108095,"_26522":108096,"_2670":108097},[],"/docs/pr-preview/pr-51/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3172":64836,"_28020":64829,"_5":28369,"_19450":108099,"_26522":108100,"_2670":108101},[],"/docs/pr-preview/pr-51/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3172":64837,"_28020":64829,"_5":28369,"_19450":108103,"_26522":108104,"_2670":108105},[],"/docs/pr-preview/pr-51/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3172":64838,"_28020":64829,"_5":28369,"_19450":108107,"_26522":108108,"_2670":108109},[],"/docs/pr-preview/pr-51/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3172":64839,"_28020":64829,"_5":28369,"_19450":108111,"_26522":108112,"_2670":108113},[],"/docs/pr-preview/pr-51/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3172":64840,"_28020":64829,"_5":28369,"_19450":108115,"_26522":108116,"_2670":108117},[],"/docs/pr-preview/pr-51/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3172":64841,"_28020":64829,"_5":28369,"_19450":108119,"_26522":108120,"_2670":108121},[],"/docs/pr-preview/pr-51/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3172":64842,"_28020":64829,"_5":28369,"_19450":108123,"_26522":108124,"_2670":108125},[],"/docs/pr-preview/pr-51/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3172":64843,"_28020":64829,"_19450":108127,"_5":13408,"_26522":64829,"_2670":108128},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3172":64844,"_28020":64829,"_19450":108130,"_5":13408,"_26522":108084,"_2670":108131},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3172":64845,"_28020":64829,"_19450":108133,"_5":13408,"_26522":108088,"_2670":108134},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3172":64846,"_28020":64829,"_19450":108136,"_5":13408,"_26522":108092,"_2670":108137},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3172":64847,"_28020":64829,"_19450":108139,"_5":13408,"_26522":108096,"_2670":108140},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3172":64848,"_28020":64829,"_19450":108142,"_5":13408,"_26522":108100,"_2670":108143},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3172":64849,"_28020":64829,"_19450":108145,"_5":13408,"_26522":108104,"_2670":108146},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3172":64850,"_28020":64829,"_19450":108148,"_5":13408,"_26522":108104,"_2670":108149},[],"Ejecuta también la prueba de conectividad del chart:",{"_3172":64851,"_28020":64829,"_19450":108151,"_5":13408,"_26522":108104,"_2670":108152},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3172":64852,"_28020":64829,"_19450":108154,"_5":13408,"_26522":108104,"_2670":108155},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3172":64853,"_28020":64829,"_19450":108157,"_5":13408,"_26522":108108,"_2670":108158},[],"Si recibes un 401:",{"_3172":64854,"_28020":64829,"_19450":108160,"_5":13408,"_26522":108108,"_2670":108161},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3172":64855,"_28020":64829,"_19450":108163,"_5":13408,"_26522":108108,"_2670":108164},[],"verifica emisor, audiencia y expiración del token;",{"_3172":64856,"_28020":64829,"_19450":108166,"_5":13408,"_26522":108108,"_2670":108167},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3172":64857,"_28020":64829,"_19450":108169,"_5":13408,"_26522":108108,"_2670":108170},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3172":64858,"_28020":64829,"_19450":108172,"_5":13408,"_26522":108108,"_2670":108173},[],"Si el login termina pero las APIs devuelven 403:",{"_3172":64859,"_28020":64829,"_19450":108175,"_5":13408,"_26522":108108,"_2670":108176},[],"inspecciona los claims reales del token;",{"_3172":64860,"_28020":64829,"_19450":108178,"_5":13408,"_26522":108108,"_2670":108179},[],"confirma que coinciden con un principal activo;",{"_3172":64861,"_28020":64829,"_19450":108181,"_5":13408,"_26522":108108,"_2670":108182},[],"revisa las políticas concedidas al principal;",{"_3172":64862,"_28020":64829,"_19450":108184,"_5":13408,"_26522":108108,"_2670":108185},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3172":64863,"_28020":64829,"_19450":108187,"_5":13408,"_26522":108108,"_2670":108188},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3172":64864,"_28020":64829,"_19450":108190,"_5":13408,"_26522":108112,"_2670":108191},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3172":64865,"_28020":64829,"_19450":108193,"_5":13408,"_26522":108112,"_2670":108194},[],"Localiza el pod y Service de authz.",{"_3172":64866,"_28020":64829,"_19450":108196,"_5":13408,"_26522":108112,"_2670":108197},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3172":64867,"_28020":64829,"_19450":108199,"_5":13408,"_26522":108112,"_2670":108200},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3172":64868,"_28020":64829,"_19450":108202,"_5":13408,"_26522":108112,"_2670":108203},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3172":64869,"_28020":64829,"_19450":108205,"_5":13408,"_26522":108112,"_2670":108206},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3172":64870,"_28020":64829,"_19450":108208,"_5":13408,"_26522":108116,"_2670":108209},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3172":64871,"_28020":64829,"_19450":108211,"_5":13408,"_26522":108116,"_2670":108212},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3172":64872,"_28020":64829,"_19450":108214,"_5":13408,"_26522":108116,"_2670":108215},[],"volumen persistente sin enlazar;",{"_3172":64873,"_28020":64829,"_19450":108217,"_5":13408,"_26522":108116,"_2670":108218},[],"imagen inaccesible o política de pull incorrecta;",{"_3172":64874,"_28020":64829,"_19450":108220,"_5":13408,"_26522":108116,"_2670":108221},[],"configuración inválida del motor criptográfico;",{"_3172":64875,"_28020":64829,"_19450":108223,"_5":13408,"_26522":108116,"_2670":108224},[],"límites de CPU o memoria demasiado bajos;",{"_3172":64876,"_28020":64829,"_19450":108226,"_5":13408,"_26522":108116,"_2670":108227},[],"migración previa incompleta.",{"_3172":64877,"_28020":64829,"_19450":108229,"_5":13408,"_26522":108116,"_2670":108230},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3172":64878,"_28020":64829,"_19450":108232,"_5":13408,"_26522":108116,"_2670":108233},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3172":64879,"_28020":64829,"_19450":108235,"_5":13408,"_26522":108120,"_2670":108236},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3172":64880,"_28020":64829,"_19450":108238,"_5":13408,"_26522":108120,"_2670":108239},[],"verifica que esté habilitado en el servicio emisor;",{"_3172":64881,"_28020":64829,"_19450":108241,"_5":13408,"_26522":108120,"_2670":108242},[],"comprueba conectividad y credenciales AMQP;",{"_3172":64882,"_28020":64829,"_19450":108244,"_5":13408,"_26522":108120,"_2670":108245},[],"revisa exchange, routing key, colas y consumidores;",{"_3172":64883,"_28020":64829,"_19450":108247,"_5":13408,"_26522":108120,"_2670":108248},[],"inspecciona dead-letter queues;",{"_3172":64884,"_28020":64829,"_19450":108250,"_5":13408,"_26522":108120,"_2670":108251},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3172":64885,"_28020":64829,"_19450":108253,"_5":13408,"_26522":108120,"_2670":108254},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3172":64886,"_28020":64829,"_19450":108256,"_5":13408,"_26522":108124,"_2670":108257},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_3172":64887,"_28020":64829,"_19450":108259,"_5":13408,"_26522":108124,"_2670":108260},[],"Antes de cerrar una incidencia, guarda:",{"_3172":64888,"_28020":64829,"_19450":108262,"_5":13408,"_26522":108124,"_2670":108263},[],"causa confirmada;",{"_3172":64889,"_28020":64829,"_19450":108265,"_5":13408,"_26522":108124,"_2670":108266},[],"alcance temporal y recursos afectados;",{"_3172":64890,"_28020":64829,"_19450":108268,"_5":13408,"_26522":108124,"_2670":108269},[],"comandos o consultas utilizados;",{"_3172":64891,"_28020":64829,"_19450":108271,"_5":13408,"_26522":108124,"_2670":108272},[],"cambio aplicado y forma de revertirlo;",{"_3172":64892,"_28020":64829,"_19450":108274,"_5":13408,"_26522":108124,"_2670":108275},[],"validación desde un consumidor;",{"_3172":64893,"_28020":64829,"_19450":108277,"_5":13408,"_26522":108124,"_2670":108278},[],"acción preventiva y propietario.",{"_3172":64894,"_28020":64894,"_5":13734,"_2670":108280,"_28372":108281,"_19450":108284,"_26522":64894},"Control de acceso",[45500,108282,108283],"Plataforma","Administración",[],{"_3172":64895,"_28020":64894,"_19450":108286,"_5":13408,"_26522":64894,"_2670":108287},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3172":64896,"_28020":64894,"_5":28369,"_19450":108289,"_26522":108290,"_2670":108291},[],"/docs/pr-preview/pr-51/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3172":64897,"_28020":64894,"_5":28369,"_19450":108293,"_26522":108294,"_2670":108295},[],"/docs/pr-preview/pr-51/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3172":64898,"_28020":64894,"_5":28369,"_19450":108297,"_26522":108298,"_2670":108299},[],"/docs/pr-preview/pr-51/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3172":64899,"_28020":64894,"_5":28369,"_19450":108301,"_26522":108302,"_2670":108303},[],"/docs/pr-preview/pr-51/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3172":64900,"_28020":64894,"_5":28369,"_19450":108305,"_26522":108306,"_2670":108307},[],"/docs/pr-preview/pr-51/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3172":64901,"_28020":64894,"_5":28369,"_19450":108309,"_26522":108310,"_2670":108311},[],"/docs/pr-preview/pr-51/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3172":64902,"_28020":64894,"_5":28369,"_19450":108313,"_26522":108314,"_2670":108315},[],"/docs/pr-preview/pr-51/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3172":64903,"_28020":64894,"_5":28369,"_19450":108317,"_26522":108318,"_2670":108319},[],"/docs/pr-preview/pr-51/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3172":64904,"_28020":64894,"_5":28369,"_19450":108321,"_26522":108322,"_2670":108323},[],"/docs/pr-preview/pr-51/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3172":64905,"_28020":64894,"_5":28369,"_19450":108325,"_26522":108326,"_2670":108327},[],"/docs/pr-preview/pr-51/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3172":64906,"_28020":64894,"_5":28369,"_19450":108329,"_26522":108330,"_2670":108331},[],"/docs/pr-preview/pr-51/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3172":64907,"_28020":64894,"_5":28369,"_19450":108333,"_26522":108334,"_2670":108335},[],"/docs/pr-preview/pr-51/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3172":64908,"_28020":64894,"_5":28369,"_19450":108337,"_26522":108338,"_2670":108339},[],"/docs/pr-preview/pr-51/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3172":64909,"_28020":64894,"_5":28369,"_19450":108341,"_26522":108342,"_2670":108343},[],"/docs/pr-preview/pr-51/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3172":64910,"_28020":64894,"_5":28369,"_19450":108345,"_26522":108346,"_2670":108347},[],"/docs/pr-preview/pr-51/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3172":64911,"_28020":64894,"_5":28369,"_19450":108349,"_26522":108350,"_2670":107541},[],"/docs/pr-preview/pr-51/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3172":64912,"_28020":64894,"_5":28369,"_19450":108352,"_26522":108353,"_2670":108354},[],"/docs/pr-preview/pr-51/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3172":64913,"_28020":64894,"_5":28369,"_19450":108356,"_26522":108357,"_2670":108358},[],"/docs/pr-preview/pr-51/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3172":64914,"_28020":64894,"_5":28369,"_19450":108360,"_26522":108361,"_2670":108362},[],"/docs/pr-preview/pr-51/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3172":64915,"_28020":64894,"_5":28369,"_19450":108364,"_26522":108365,"_2670":108366},[],"/docs/pr-preview/pr-51/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3172":64916,"_28020":64894,"_5":28369,"_19450":108368,"_26522":108369,"_2670":108370},[],"/docs/pr-preview/pr-51/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3172":64917,"_28020":64894,"_5":28369,"_19450":108372,"_26522":108373,"_2670":108374},[],"/docs/pr-preview/pr-51/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3172":64918,"_28020":64894,"_5":28369,"_19450":108376,"_26522":108377,"_2670":108378},[],"/docs/pr-preview/pr-51/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3172":64919,"_28020":64894,"_5":28369,"_19450":108380,"_26522":108381,"_2670":108382},[],"/docs/pr-preview/pr-51/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3172":64920,"_28020":64894,"_5":28369,"_19450":108384,"_26522":108385,"_2670":108386},[],"/docs/pr-preview/pr-51/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3172":64921,"_28020":64894,"_5":28369,"_19450":108388,"_26522":108389,"_2670":108390},[],"/docs/pr-preview/pr-51/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3172":64922,"_28020":64894,"_5":28369,"_19450":108392,"_26522":108393,"_2670":108394},[],"/docs/pr-preview/pr-51/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3172":64923,"_28020":64894,"_5":28369,"_19450":108396,"_26522":108397,"_2670":108398},[],"/docs/pr-preview/pr-51/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3172":64924,"_28020":64894,"_5":28369,"_19450":108400,"_26522":108401,"_2670":108402},[],"/docs/pr-preview/pr-51/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3172":64925,"_28020":64894,"_5":28369,"_19450":108404,"_26522":108405,"_2670":108406},[],"/docs/pr-preview/pr-51/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3172":64926,"_28020":64894,"_5":28369,"_19450":108408,"_26522":108409,"_2670":108410},[],"/docs/pr-preview/pr-51/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3172":64927,"_28020":64894,"_19450":108412,"_5":13408,"_26522":64894,"_2670":108413},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3172":64928,"_28020":64894,"_19450":108415,"_5":13408,"_26522":64894,"_2670":108416},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3172":64929,"_28020":64894,"_19450":108418,"_5":13408,"_26522":64894,"_2670":108419},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3172":64930,"_28020":64894,"_19450":108421,"_5":13408,"_26522":108290,"_2670":108422},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3172":64931,"_28020":64894,"_19450":108424,"_5":13408,"_26522":108290,"_2670":108425},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3172":64932,"_28020":64894,"_19450":108427,"_5":13408,"_26522":108290,"_2670":108428},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3172":64933,"_28020":64894,"_19450":108430,"_5":13408,"_26522":108290,"_2670":108431},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3172":64934,"_28020":64894,"_19450":108433,"_5":13408,"_26522":108290,"_2670":108434},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3172":64935,"_28020":64894,"_19450":108436,"_5":13408,"_26522":108290,"_2670":108437},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3172":64936,"_28020":64894,"_19450":108439,"_5":13408,"_26522":108294,"_2670":108440},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3172":64937,"_28020":64894,"_19450":108442,"_5":13408,"_26522":108294,"_2670":108443},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3172":64938,"_28020":64894,"_19450":108445,"_5":13408,"_26522":108298,"_2670":108446},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3172":64939,"_28020":64894,"_19450":108448,"_5":13408,"_26522":108298,"_2670":108449},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3172":64940,"_28020":64894,"_19450":108451,"_5":13408,"_26522":108298,"_2670":108452},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3172":64941,"_28020":64894,"_19450":108454,"_5":13408,"_26522":108298,"_2670":108455},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3172":64942,"_28020":64894,"_19450":108457,"_5":13408,"_26522":108298,"_2670":108458},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3172":64943,"_28020":64894,"_19450":108460,"_5":13408,"_26522":108298,"_2670":108461},[],"Carga por separado las políticas concedidas a cada principal.",{"_3172":64944,"_28020":64894,"_19450":108463,"_5":13408,"_26522":108298,"_2670":108464},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3172":64945,"_28020":64894,"_19450":108466,"_5":13408,"_26522":108298,"_2670":108467},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3172":64946,"_28020":64894,"_19450":108469,"_5":13408,"_26522":108298,"_2670":108470},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3172":64947,"_28020":64894,"_19450":108472,"_5":13408,"_26522":108298,"_2670":108473},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3172":64948,"_28020":64894,"_19450":108475,"_5":13408,"_26522":108298,"_2670":108476},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3172":64949,"_28020":64894,"_19450":108478,"_5":13408,"_26522":108298,"_2670":108479},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3172":64950,"_28020":64894,"_19450":108481,"_5":13408,"_26522":108302,"_2670":108482},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3172":64951,"_28020":64894,"_19450":108484,"_5":13408,"_26522":108302,"_2670":108485},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3172":64952,"_28020":64894,"_19450":108487,"_5":13408,"_26522":108302,"_2670":108488},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3172":64953,"_28020":64894,"_19450":108490,"_5":13408,"_26522":108302,"_2670":108491},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3172":64954,"_28020":64894,"_19450":108493,"_5":13408,"_26522":108302,"_2670":108494},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3172":64955,"_28020":64894,"_19450":108496,"_5":13408,"_26522":108302,"_2670":108497},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3172":64956,"_28020":64894,"_19450":108499,"_5":13408,"_26522":108302,"_2670":108500},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3172":64957,"_28020":64894,"_19450":108502,"_5":13408,"_26522":108302,"_2670":108503},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3172":64958,"_28020":64894,"_19450":108505,"_5":13408,"_26522":108306,"_2670":108506},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3172":64959,"_28020":64894,"_19450":108508,"_5":13408,"_26522":108306,"_2670":108509},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3172":64960,"_28020":64894,"_19450":108511,"_5":13408,"_26522":108306,"_2670":108512},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3172":64961,"_28020":64894,"_19450":108514,"_5":13408,"_26522":108306,"_2670":108515},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3172":64962,"_28020":64894,"_19450":108517,"_5":13408,"_26522":108306,"_2670":108518},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3172":64963,"_28020":64894,"_19450":108520,"_5":13408,"_26522":108306,"_2670":108521},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3172":64964,"_28020":64894,"_19450":108523,"_5":13408,"_26522":108306,"_2670":108524},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3172":64965,"_28020":64894,"_19450":108526,"_5":13408,"_26522":108306,"_2670":108527},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3172":64966,"_28020":64894,"_19450":108529,"_5":13408,"_26522":108306,"_2670":108530},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3172":64967,"_28020":64894,"_19450":108532,"_5":13408,"_26522":108306,"_2670":108533},[],"Las acciones se dividen en dos grupos:",{"_3172":64968,"_28020":64894,"_19450":108535,"_5":13408,"_26522":108306,"_2670":108536},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3172":64969,"_28020":64894,"_19450":108538,"_5":13408,"_26522":108306,"_2670":108539},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3172":64970,"_28020":64894,"_19450":108541,"_5":13408,"_26522":108306,"_2670":108542},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3172":64971,"_28020":64894,"_19450":108544,"_5":13408,"_26522":108310,"_2670":108545},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3172":64972,"_28020":64894,"_19450":108547,"_5":13408,"_26522":108310,"_2670":108548},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3172":64973,"_28020":64894,"_19450":108550,"_5":13408,"_26522":108310,"_2670":108551},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3172":64974,"_28020":64894,"_19450":108553,"_5":13408,"_26522":108314,"_2670":108554},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3172":64975,"_28020":64894,"_19450":108556,"_5":13408,"_26522":108314,"_2670":108557},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3172":64976,"_28020":64894,"_19450":108559,"_5":13408,"_26522":108314,"_2670":108560},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3172":64977,"_28020":64894,"_19450":108562,"_5":13408,"_26522":108314,"_2670":108563},[],"Los operadores implementados son:",{"_3172":64978,"_28020":64894,"_19450":108565,"_5":13408,"_26522":108314,"_2670":108566},[],"`equals`, para igualdad exacta;",{"_3172":64979,"_28020":64894,"_19450":108568,"_5":13408,"_26522":108314,"_2670":108569},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3172":64980,"_28020":64894,"_19450":108571,"_5":13408,"_26522":108314,"_2670":108572},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3172":64981,"_28020":64894,"_19450":108574,"_5":13408,"_26522":108314,"_2670":108575},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3172":64982,"_28020":64894,"_19450":108577,"_5":13408,"_26522":108318,"_2670":108578},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3172":64983,"_28020":64894,"_19450":108580,"_5":13408,"_26522":108318,"_2670":108581},[],"Los modos disponibles son:",{"_3172":64984,"_28020":64894,"_19450":108583,"_5":13408,"_26522":108318,"_2670":108584},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3172":64985,"_28020":64894,"_19450":108586,"_5":13408,"_26522":108318,"_2670":108587},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3172":64986,"_28020":64894,"_19450":108589,"_5":13408,"_26522":108318,"_2670":108590},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3172":64987,"_28020":64894,"_19450":108592,"_5":13408,"_26522":108318,"_2670":108593},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3172":64988,"_28020":64894,"_19450":108595,"_5":13408,"_26522":108318,"_2670":108596},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3172":64989,"_28020":64894,"_19450":108598,"_5":13408,"_26522":108318,"_2670":108599},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3172":64990,"_28020":64894,"_19450":108601,"_5":13408,"_26522":108322,"_2670":108602},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3172":64991,"_28020":64894,"_19450":108604,"_5":13408,"_26522":108322,"_2670":108605},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3172":64992,"_28020":64894,"_19450":108607,"_5":13408,"_26522":108322,"_2670":108608},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3172":64993,"_28020":64894,"_19450":108610,"_5":13408,"_26522":108322,"_2670":108611},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3172":64994,"_28020":64894,"_19450":108613,"_5":13408,"_26522":108330,"_2670":108614},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3172":64995,"_28020":64894,"_19450":108616,"_5":13408,"_26522":108330,"_2670":108617},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3172":64996,"_28020":64894,"_19450":108619,"_5":13408,"_26522":108334,"_2670":108620},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3172":64997,"_28020":64894,"_19450":108622,"_5":13408,"_26522":108334,"_2670":108623},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3172":64998,"_28020":64894,"_19450":108625,"_5":13408,"_26522":108338,"_2670":108626},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3172":64999,"_28020":64894,"_19450":108628,"_5":13408,"_26522":108338,"_2670":108629},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3172":65000,"_28020":64894,"_19450":108631,"_5":13408,"_26522":108338,"_2670":108632},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3172":65001,"_28020":64894,"_19450":108634,"_5":13408,"_26522":108342,"_2670":108635},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3172":65002,"_28020":64894,"_19450":108637,"_5":13408,"_26522":108342,"_2670":108638},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3172":65003,"_28020":64894,"_19450":108640,"_5":13408,"_26522":108342,"_2670":108641},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3172":65004,"_28020":64894,"_19450":108643,"_5":13408,"_26522":108342,"_2670":108644},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3172":65005,"_28020":64894,"_19450":108646,"_5":13408,"_26522":108342,"_2670":108647},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3172":65006,"_28020":64894,"_19450":108649,"_5":13408,"_26522":108342,"_2670":108650},[],"Ten en cuenta que:",{"_3172":65007,"_28020":64894,"_19450":108652,"_5":13408,"_26522":108342,"_2670":108653},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3172":65008,"_28020":64894,"_19450":108655,"_5":13408,"_26522":108342,"_2670":108656},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3172":65009,"_28020":64894,"_19450":108658,"_5":13408,"_26522":108342,"_2670":108659},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3172":65010,"_28020":64894,"_19450":108661,"_5":13408,"_26522":108346,"_2670":108662},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3172":65011,"_28020":64894,"_19450":108664,"_5":13408,"_26522":108346,"_2670":108665},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3172":65012,"_28020":64894,"_19450":108667,"_5":13408,"_26522":108346,"_2670":108668},[],"acceso completo y de solo lectura a KMS;",{"_3172":65013,"_28020":64894,"_19450":108670,"_5":13408,"_26522":108346,"_2670":108671},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3172":65014,"_28020":64894,"_19450":108673,"_5":13408,"_26522":108346,"_2670":108674},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3172":65015,"_28020":64894,"_19450":108676,"_5":13408,"_26522":108346,"_2670":108677},[],"acceso a la interfaz;",{"_3172":65016,"_28020":64894,"_19450":108679,"_5":13408,"_26522":108346,"_2670":108680},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3172":65017,"_28020":64894,"_19450":108682,"_5":13408,"_26522":108346,"_2670":108683},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3172":65018,"_28020":64894,"_19450":108685,"_5":13408,"_26522":108346,"_2670":108686},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3172":65019,"_28020":64894,"_19450":108688,"_5":13408,"_26522":108350,"_2670":108689},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3172":65020,"_28020":64894,"_19450":108691,"_5":13408,"_26522":108350,"_2670":108692},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3172":65021,"_28020":64894,"_19450":108694,"_5":13408,"_26522":108350,"_2670":108695},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3172":65022,"_28020":64894,"_19450":108697,"_5":13408,"_26522":108353,"_2670":108698},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3172":65023,"_28020":64894,"_19450":108700,"_5":13408,"_26522":108357,"_2670":108701},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3172":65024,"_28020":64894,"_19450":108703,"_5":13408,"_26522":108357,"_2670":108704},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3172":65025,"_28020":64894,"_19450":108706,"_5":13408,"_26522":108361,"_2670":108707},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3172":65026,"_28020":64894,"_19450":108709,"_5":13408,"_26522":108365,"_2670":108710},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3172":65027,"_28020":64894,"_19450":108712,"_5":13408,"_26522":108369,"_2670":108713},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3172":65028,"_28020":64894,"_19450":108715,"_5":13408,"_26522":108373,"_2670":108716},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3172":65029,"_28020":64894,"_19450":108718,"_5":13408,"_26522":108373,"_2670":108719},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3172":65030,"_28020":64894,"_19450":108721,"_5":13408,"_26522":108377,"_2670":108722},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3172":65031,"_28020":64894,"_19450":108724,"_5":13408,"_26522":108377,"_2670":108725},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3172":65032,"_28020":64894,"_19450":108727,"_5":13408,"_26522":108377,"_2670":108728},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3172":65033,"_28020":64894,"_19450":108730,"_5":13408,"_26522":108377,"_2670":108731},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3172":65034,"_28020":64894,"_19450":108733,"_5":13408,"_26522":108377,"_2670":108734},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3172":65035,"_28020":64894,"_19450":108736,"_5":13408,"_26522":108377,"_2670":108737},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3172":65036,"_28020":64894,"_19450":108739,"_5":13408,"_26522":108377,"_2670":108740},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3172":65037,"_28020":64894,"_19450":108742,"_5":13408,"_26522":108377,"_2670":108743},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3172":65038,"_28020":64894,"_19450":108745,"_5":13408,"_26522":108381,"_2670":108746},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3172":65039,"_28020":64894,"_19450":108748,"_5":13408,"_26522":108381,"_2670":108749},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3172":65040,"_28020":64894,"_19450":108751,"_5":13408,"_26522":108381,"_2670":108752},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3172":65041,"_28020":64894,"_19450":108754,"_5":13408,"_26522":108385,"_2670":108755},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3172":65042,"_28020":64894,"_19450":108757,"_5":13408,"_26522":108385,"_2670":108758},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3172":65043,"_28020":64894,"_19450":108760,"_5":13408,"_26522":108385,"_2670":108761},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3172":65044,"_28020":64894,"_19450":108763,"_5":13408,"_26522":108385,"_2670":108764},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3172":65045,"_28020":64894,"_19450":108766,"_5":13408,"_26522":108385,"_2670":108767},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3172":65046,"_28020":64894,"_19450":108769,"_5":13408,"_26522":108385,"_2670":108770},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3172":65047,"_28020":64894,"_19450":108772,"_5":13408,"_26522":108385,"_2670":108773},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3172":65048,"_28020":64894,"_19450":108775,"_5":13408,"_26522":108385,"_2670":108776},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3172":65049,"_28020":64894,"_19450":108778,"_5":13408,"_26522":108393,"_2670":108779},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3172":65050,"_28020":64894,"_19450":108781,"_5":13408,"_26522":108397,"_2670":108782},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3172":65051,"_28020":64894,"_19450":108784,"_5":13408,"_26522":108397,"_2670":108785},[],"que exista un principal activo del tipo correcto;",{"_3172":65052,"_28020":64894,"_19450":108787,"_5":13408,"_26522":108397,"_2670":108788},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3172":65053,"_28020":64894,"_19450":108790,"_5":13408,"_26522":108397,"_2670":108791},[],"que todas las condiciones del principal se cumplan;",{"_3172":65054,"_28020":64894,"_19450":108793,"_5":13408,"_26522":108397,"_2670":108794},[],"que el principal tenga concedida la política esperada;",{"_3172":65055,"_28020":64894,"_19450":108796,"_5":13408,"_26522":108397,"_2670":108797},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3172":65056,"_28020":64894,"_19450":108799,"_5":13408,"_26522":108397,"_2670":108800},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3172":65057,"_28020":64894,"_19450":108802,"_5":13408,"_26522":108397,"_2670":108803},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_3172":65058,"_28020":64894,"_19450":108805,"_5":13408,"_26522":108401,"_2670":108806},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3172":65059,"_28020":64894,"_19450":108808,"_5":13408,"_26522":108405,"_2670":108809},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3172":65060,"_28020":64894,"_19450":108811,"_5":13408,"_26522":108409,"_2670":108812},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3172":65061,"_28020":64894,"_19450":108814,"_5":13408,"_26522":108409,"_2670":108815},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3172":65062,"_28020":65062,"_5":13734,"_2670":108817,"_28372":108818,"_19450":108819,"_26522":65062},"Alertas y suscripciones",[45500,108282,108283],[],{"_3172":65063,"_28020":65062,"_19450":108821,"_5":13408,"_26522":65062,"_2670":108822},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3172":65064,"_28020":65062,"_5":28369,"_19450":108824,"_26522":108825,"_2670":108826},[],"/docs/pr-preview/pr-51/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3172":65065,"_28020":65062,"_5":28369,"_19450":108828,"_26522":108829,"_2670":108830},[],"/docs/pr-preview/pr-51/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3172":65066,"_28020":65062,"_5":28369,"_19450":108832,"_26522":108833,"_2670":108834},[],"/docs/pr-preview/pr-51/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3172":65067,"_28020":65062,"_5":28369,"_19450":108836,"_26522":108837,"_2670":108838},[],"/docs/pr-preview/pr-51/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3172":65068,"_28020":65062,"_5":28369,"_19450":108840,"_26522":108841,"_2670":108842},[],"/docs/pr-preview/pr-51/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3172":65069,"_28020":65062,"_5":28369,"_19450":108844,"_26522":108845,"_2670":108846},[],"/docs/pr-preview/pr-51/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3172":65070,"_28020":65062,"_5":28369,"_19450":108848,"_26522":108849,"_2670":108850},[],"/docs/pr-preview/pr-51/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3172":65071,"_28020":65062,"_5":28369,"_19450":108852,"_26522":108853,"_2670":108854},[],"/docs/pr-preview/pr-51/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3172":65072,"_28020":65062,"_5":28369,"_19450":108856,"_26522":108857,"_2670":108858},[],"/docs/pr-preview/pr-51/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3172":65073,"_28020":65062,"_5":28369,"_19450":108860,"_26522":108861,"_2670":108862},[],"/docs/pr-preview/pr-51/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3172":65074,"_28020":65062,"_19450":108864,"_5":13408,"_26522":65062,"_2670":108865},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3172":65075,"_28020":65062,"_19450":108867,"_5":13408,"_26522":108825,"_2670":108868},[],"Un servicio publica un evento de dominio.",{"_3172":65076,"_28020":65062,"_19450":108870,"_5":13408,"_26522":108825,"_2670":108871},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3172":65077,"_28020":65062,"_19450":108873,"_5":13408,"_26522":108825,"_2670":108874},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3172":65078,"_28020":65062,"_19450":108876,"_5":13408,"_26522":108825,"_2670":108877},[],"Lamassu entrega el evento al canal configurado.",{"_3172":65079,"_28020":65062,"_19450":108879,"_5":13408,"_26522":108825,"_2670":108880},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3172":65080,"_28020":65062,"_19450":108882,"_5":13408,"_26522":108829,"_2670":108883},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3172":65081,"_28020":65062,"_19450":108885,"_5":13408,"_26522":108829,"_2670":108886},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3172":65082,"_28020":65062,"_19450":108888,"_5":13408,"_26522":108829,"_2670":108889},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3172":65083,"_28020":65062,"_19450":108891,"_5":13408,"_26522":108829,"_2670":108892},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3172":65084,"_28020":65062,"_19450":108894,"_5":13408,"_26522":108829,"_2670":108895},[],"`apikey_options` necesita `header` y `key`.",{"_3172":65085,"_28020":65062,"_19450":108897,"_5":13408,"_26522":108829,"_2670":108898},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3172":65086,"_28020":65062,"_19450":108900,"_5":13408,"_26522":108829,"_2670":108901},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3172":65087,"_28020":65062,"_19450":108903,"_5":13408,"_26522":108829,"_2670":108904},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3172":65088,"_28020":65062,"_19450":108906,"_5":13408,"_26522":108837,"_2670":108907},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3172":65089,"_28020":65062,"_19450":108909,"_5":13408,"_26522":108841,"_2670":108910},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3172":65090,"_28020":65062,"_19450":108912,"_5":13408,"_26522":108845,"_2670":108913},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3172":65091,"_28020":65062,"_19450":108915,"_5":13408,"_26522":108845,"_2670":108916},[],"**None** notifica todas las instancias del evento.",{"_3172":65092,"_28020":65062,"_19450":108918,"_5":13408,"_26522":108845,"_2670":108919},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3172":65093,"_28020":65062,"_19450":108921,"_5":13408,"_26522":108845,"_2670":108922},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3172":65094,"_28020":65062,"_19450":108924,"_5":13408,"_26522":108845,"_2670":108925},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3172":65095,"_28020":65062,"_19450":108927,"_5":13408,"_26522":108845,"_2670":108928},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3172":65096,"_28020":65062,"_19450":108930,"_5":13408,"_26522":108849,"_2670":108931},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3172":65097,"_28020":65062,"_19450":108933,"_5":13408,"_26522":108853,"_2670":108934},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3172":65098,"_28020":65062,"_19450":108936,"_5":13408,"_26522":108853,"_2670":108937},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3172":65099,"_28020":65062,"_19450":108939,"_5":13408,"_26522":108853,"_2670":108940},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3172":65100,"_28020":65062,"_19450":108942,"_5":13408,"_26522":108853,"_2670":108943},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3172":65101,"_28020":65062,"_19450":108945,"_5":13408,"_26522":108853,"_2670":108946},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3172":65102,"_28020":65062,"_19450":108948,"_5":13408,"_26522":108853,"_2670":108949},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3172":65103,"_28020":65062,"_19450":108951,"_5":13408,"_26522":108853,"_2670":108952},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3172":65104,"_28020":65062,"_19450":108954,"_5":13408,"_26522":108853,"_2670":108955},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3172":65105,"_28020":65062,"_19450":108957,"_5":13408,"_26522":108857,"_2670":108958},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3172":65106,"_28020":65062,"_19450":108960,"_5":13408,"_26522":108861,"_2670":108961},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3172":65107,"_28020":65062,"_19450":108963,"_5":13408,"_26522":108861,"_2670":108964},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3172":65108,"_28020":65062,"_19450":108966,"_5":13408,"_26522":108861,"_2670":108967},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3172":65109,"_28020":65062,"_19450":108969,"_5":13408,"_26522":108861,"_2670":108970},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3172":65110,"_28020":65062,"_19450":108972,"_5":13408,"_26522":108861,"_2670":108973},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3172":65111,"_28020":65062,"_19450":108975,"_5":13408,"_26522":108861,"_2670":108976},[],"**Validación:** `va.role.crl.create`.",{"_3172":65112,"_28020":65062,"_19450":108978,"_5":13408,"_26522":108861,"_2670":108979},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3172":65113,"_28020":65062,"_19450":108981,"_5":13408,"_26522":108861,"_2670":108982},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3172":65114,"_28020":65114,"_5":13734,"_2670":108984,"_28372":108985,"_19450":108986,"_26522":65114},"Registros de auditoría",[45500,108282,108283],[],{"_3172":65115,"_28020":65114,"_19450":108988,"_5":13408,"_26522":65114,"_2670":108989},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3172":65116,"_28020":65114,"_5":28369,"_19450":108991,"_26522":108992,"_2670":108993},[],"/docs/pr-preview/pr-51/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3172":65117,"_28020":65114,"_5":28369,"_19450":108995,"_26522":108996,"_2670":108997},[],"/docs/pr-preview/pr-51/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3172":65118,"_28020":65114,"_5":28369,"_19450":108999,"_26522":109000,"_2670":109001},[],"/docs/pr-preview/pr-51/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3172":65119,"_28020":65114,"_5":28369,"_19450":109003,"_26522":109004,"_2670":109005},[],"/docs/pr-preview/pr-51/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3172":65120,"_28020":65114,"_5":28369,"_19450":109007,"_26522":109008,"_2670":109009},[],"/docs/pr-preview/pr-51/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3172":65121,"_28020":65114,"_5":28369,"_19450":109011,"_26522":109012,"_2670":109013},[],"/docs/pr-preview/pr-51/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3172":65122,"_28020":65114,"_5":28369,"_19450":109015,"_26522":109016,"_2670":109017},[],"/docs/pr-preview/pr-51/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3172":65123,"_28020":65114,"_5":28369,"_19450":109019,"_26522":109020,"_2670":109021},[],"/docs/pr-preview/pr-51/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3172":65124,"_28020":65114,"_5":28369,"_19450":109023,"_26522":109024,"_2670":109025},[],"/docs/pr-preview/pr-51/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3172":65125,"_28020":65114,"_5":28369,"_19450":109027,"_26522":109028,"_2670":109029},[],"/docs/pr-preview/pr-51/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3172":65126,"_28020":65114,"_5":28369,"_19450":109031,"_26522":109032,"_2670":109033},[],"/docs/pr-preview/pr-51/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3172":65127,"_28020":65114,"_19450":109035,"_5":13408,"_26522":65114,"_2670":109036},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3172":65128,"_28020":65114,"_19450":109038,"_5":13408,"_26522":108992,"_2670":109039},[],"El cuerpo de auditoría incluye:",{"_3172":65129,"_28020":65114,"_19450":109041,"_5":13408,"_26522":108992,"_2670":109042},[],"input: datos recibidos por la operación;",{"_3172":65130,"_28020":65114,"_19450":109044,"_5":13408,"_26522":108992,"_2670":109045},[],"has\\_error: indica si el servicio devolvió un error;",{"_3172":65131,"_28020":65114,"_19450":109047,"_5":13408,"_26522":108992,"_2670":109048},[],"output: resultado producido o mensaje de error;",{"_3172":65132,"_28020":65114,"_19450":109050,"_5":13408,"_26522":108992,"_2670":109051},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3172":65133,"_28020":65114,"_19450":109053,"_5":13408,"_26522":108992,"_2670":109054},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3172":65134,"_28020":65114,"_19450":109056,"_5":13408,"_26522":108992,"_2670":109057},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3172":65135,"_28020":65114,"_19450":109059,"_5":13408,"_26522":108996,"_2670":109060},[],"El backend aplica auditoría a mutaciones de:",{"_3172":65136,"_28020":65114,"_19450":109062,"_5":13408,"_26522":108996,"_2670":109063},[],"autoridades, certificados y perfiles de emisión;",{"_3172":65137,"_28020":65114,"_19450":109065,"_5":13408,"_26522":108996,"_2670":109066},[],"claves y motores KMS;",{"_3172":65138,"_28020":65114,"_19450":109068,"_5":13408,"_26522":108996,"_2670":109069},[],"dispositivos e identidades;",{"_3172":65139,"_28020":65114,"_19450":109071,"_5":13408,"_26522":108996,"_2670":109072},[],"DMS y operaciones de enrolamiento;",{"_3172":65140,"_28020":65114,"_19450":109074,"_5":13408,"_26522":108996,"_2670":109075},[],"funciones de validación y CRL;",{"_3172":65141,"_28020":65114,"_19450":109077,"_5":13408,"_26522":108996,"_2670":109078},[],"principales, políticas y concesiones de autorización.",{"_3172":65142,"_28020":65114,"_19450":109080,"_5":13408,"_26522":108996,"_2670":109081},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3172":65143,"_28020":65114,"_19450":109083,"_5":13408,"_26522":109000,"_2670":109084},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3172":65144,"_28020":65114,"_19450":109086,"_5":13408,"_26522":109000,"_2670":109087},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3172":65145,"_28020":65114,"_19450":109089,"_5":13408,"_26522":109000,"_2670":109090},[],"Diseña el consumidor para:",{"_3172":65146,"_28020":65114,"_19450":109092,"_5":13408,"_26522":109000,"_2670":109093},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3172":65147,"_28020":65114,"_19450":109095,"_5":13408,"_26522":109000,"_2670":109096},[],"conservar el CloudEvent completo sin modificar;",{"_3172":65148,"_28020":65114,"_19450":109098,"_5":13408,"_26522":109000,"_2670":109099},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3172":65149,"_28020":65114,"_19450":109101,"_5":13408,"_26522":109000,"_2670":109102},[],"cifrar en tránsito y en reposo;",{"_3172":65150,"_28020":65114,"_19450":109104,"_5":13408,"_26522":109000,"_2670":109105},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3172":65151,"_28020":65114,"_19450":109107,"_5":13408,"_26522":109000,"_2670":109108},[],"aplicar una política explícita de retención y legal hold;",{"_3172":65152,"_28020":65114,"_19450":109110,"_5":13408,"_26522":109000,"_2670":109111},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3172":65153,"_28020":65114,"_19450":109113,"_5":13408,"_26522":109004,"_2670":109114},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3172":65154,"_28020":65114,"_19450":109116,"_5":13408,"_26522":109004,"_2670":109117},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3172":65155,"_28020":65114,"_19450":109119,"_5":13408,"_26522":109012,"_2670":109120},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3172":65156,"_28020":65114,"_19450":109122,"_5":13408,"_26522":109016,"_2670":109123},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3172":65157,"_28020":65114,"_19450":109125,"_5":13408,"_26522":109020,"_2670":109126},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3172":65158,"_28020":65114,"_19450":109128,"_5":13408,"_26522":109024,"_2670":109129},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3172":65159,"_28020":65114,"_19450":109131,"_5":13408,"_26522":109028,"_2670":109132},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3172":65160,"_28020":65114,"_19450":109134,"_5":13408,"_26522":109032,"_2670":109135},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3172":65161,"_28020":65114,"_19450":109137,"_5":13408,"_26522":109032,"_2670":109138},[],"aparece un evento de auditoría correcto;",{"_3172":65162,"_28020":65114,"_19450":109140,"_5":13408,"_26522":109032,"_2670":109141},[],"el principal coincide con la identidad utilizada;",{"_3172":65163,"_28020":65114,"_19450":109143,"_5":13408,"_26522":109032,"_2670":109144},[],"el consumidor lo persiste una sola vez;",{"_3172":65164,"_28020":65114,"_19450":109146,"_5":13408,"_26522":109032,"_2670":109147},[],"puede recuperarse por recurso, actor y periodo;",{"_3172":65165,"_28020":65114,"_19450":109149,"_5":13408,"_26522":109032,"_2670":109150},[],"una interrupción del consumidor produce una alerta.",{"_3172":65166,"_28020":65114,"_19450":109152,"_5":13408,"_26522":109032,"_2670":109153},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3172":65167,"_28020":65167,"_5":13734,"_2670":109155,"_28372":109156,"_19450":109157,"_26522":65167},"Arquitectura de la plataforma",[45500,108282],[],{"_3172":65168,"_28020":65167,"_19450":109159,"_5":13408,"_26522":65167,"_2670":109160},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3172":65169,"_28020":65167,"_5":28369,"_19450":109162,"_26522":109163,"_2670":109164},[],"/docs/pr-preview/pr-51/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3172":65170,"_28020":65167,"_5":28369,"_19450":109166,"_26522":109167,"_2670":109168},[],"/docs/pr-preview/pr-51/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3172":65171,"_28020":65167,"_5":28369,"_19450":109170,"_26522":109171,"_2670":109172},[],"/docs/pr-preview/pr-51/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3172":65172,"_28020":65167,"_5":28369,"_19450":109174,"_26522":109175,"_2670":109176},[],"/docs/pr-preview/pr-51/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3172":65173,"_28020":65167,"_5":28369,"_19450":109178,"_26522":109179,"_2670":109180},[],"/docs/pr-preview/pr-51/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3172":65174,"_28020":65167,"_19450":109182,"_5":13408,"_26522":65167,"_2670":109183},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3172":65175,"_28020":65167,"_19450":109185,"_5":13408,"_26522":65167,"_2670":109186},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3172":65176,"_28020":65167,"_19450":109188,"_5":13408,"_26522":109163,"_2670":109189},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3172":65177,"_28020":65167,"_19450":109191,"_5":13408,"_26522":109167,"_2670":109192},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3172":65178,"_28020":65167,"_19450":109194,"_5":13408,"_26522":109171,"_2670":109195},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3172":65179,"_28020":65167,"_19450":109197,"_5":13408,"_26522":109175,"_2670":109198},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3172":65180,"_28020":65167,"_19450":109200,"_5":13408,"_26522":109179,"_2670":109201},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3172":65181,"_28020":65181,"_5":13734,"_2670":109203,"_28372":109204,"_19450":109205,"_26522":65181},"Cómo funciona Lamassu",[45500,108282],[],{"_3172":65182,"_28020":65181,"_19450":109207,"_5":13408,"_26522":65181,"_2670":109208},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3172":65183,"_28020":65181,"_5":28369,"_19450":109210,"_26522":109211,"_2670":109212},[],"/docs/pr-preview/pr-51/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3172":65184,"_28020":65181,"_5":28369,"_19450":109214,"_26522":109215,"_2670":109216},[],"/docs/pr-preview/pr-51/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3172":65185,"_28020":65181,"_19450":109218,"_5":13408,"_26522":65181,"_2670":109219},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3172":65186,"_28020":65181,"_19450":109221,"_5":13408,"_26522":109211,"_2670":109222},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3172":65187,"_28020":65181,"_19450":109224,"_5":13408,"_26522":109211,"_2670":109225},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3172":65188,"_28020":65181,"_19450":109227,"_5":13408,"_26522":109211,"_2670":109228},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3172":65189,"_28020":65181,"_19450":109230,"_5":13408,"_26522":109211,"_2670":109231},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3172":65190,"_28020":65181,"_19450":109233,"_5":13408,"_26522":109211,"_2670":109234},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3172":65191,"_28020":65181,"_19450":109236,"_5":13408,"_26522":109215,"_2670":109237},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3172":65192,"_28020":65181,"_19450":109239,"_5":13408,"_26522":109215,"_2670":109240},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3172":65193,"_28020":65181,"_19450":109242,"_5":13408,"_26522":109215,"_2670":109243},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3172":65194,"_28020":65181,"_19450":109245,"_5":13408,"_26522":109215,"_2670":109246},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3172":65195,"_28020":65181,"_19450":109248,"_5":13408,"_26522":109215,"_2670":109249},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3172":65196,"_28020":65181,"_19450":109251,"_5":13408,"_26522":109215,"_2670":109252},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3172":65197,"_28020":65181,"_19450":109254,"_5":13408,"_26522":109215,"_2670":109255},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3172":65198,"_28020":65198,"_5":13734,"_2670":109257,"_28372":109258,"_19450":109259,"_26522":65198},"Dispositivos e identidades",[45500,108282,47857,109257],[],{"_3172":65199,"_28020":65198,"_19450":109261,"_5":13408,"_26522":65198,"_2670":109262},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3172":65200,"_28020":65198,"_5":28369,"_19450":109264,"_26522":109265,"_2670":109266},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3172":65201,"_28020":65198,"_5":28369,"_19450":109268,"_26522":109269,"_2670":109270},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3172":65202,"_28020":65198,"_5":28369,"_19450":109272,"_26522":109273,"_2670":109274},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3172":65203,"_28020":65198,"_5":28369,"_19450":109276,"_26522":109277,"_2670":109278},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3172":65204,"_28020":65198,"_5":28369,"_19450":109280,"_26522":109281,"_2670":109282},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3172":65205,"_28020":65198,"_5":28369,"_19450":109284,"_26522":109285,"_2670":109286},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3172":65206,"_28020":65198,"_5":28369,"_19450":109288,"_26522":109289,"_2670":109290},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3172":65207,"_28020":65198,"_5":28369,"_19450":109292,"_26522":109293,"_2670":109294},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3172":65208,"_28020":65198,"_5":28369,"_19450":109296,"_26522":109297,"_2670":109298},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3172":65209,"_28020":65198,"_5":28369,"_19450":109300,"_26522":109301,"_2670":109302},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3172":65210,"_28020":65198,"_5":28369,"_19450":109304,"_26522":109305,"_2670":109306},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3172":65211,"_28020":65198,"_19450":109308,"_5":13408,"_26522":65198,"_2670":109309},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3172":65212,"_28020":65198,"_19450":109311,"_5":13408,"_26522":65198,"_2670":109312},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3172":65213,"_28020":65198,"_19450":109314,"_5":13408,"_26522":109265,"_2670":109315},[],"Vista operativa",{"_3172":65214,"_28020":65198,"_19450":109317,"_5":13408,"_26522":109265,"_2670":109318},[],"Interpretación",{"_3172":65215,"_28020":65198,"_19450":109320,"_5":13408,"_26522":109265,"_2670":47920},[],{"_3172":65216,"_28020":65198,"_19450":109322,"_5":13408,"_26522":109265,"_2670":109323},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3172":65217,"_28020":65198,"_19450":109325,"_5":13408,"_26522":109265,"_2670":47926},[],{"_3172":65218,"_28020":65198,"_19450":109327,"_5":13408,"_26522":109265,"_2670":109328},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3172":65219,"_28020":65198,"_19450":109330,"_5":13408,"_26522":109265,"_2670":47932},[],{"_3172":65220,"_28020":65198,"_19450":109332,"_5":13408,"_26522":109265,"_2670":109333},[],"La identidad está en la ventana operativa de renovación.",{"_3172":65221,"_28020":65198,"_19450":109335,"_5":13408,"_26522":109265,"_2670":47938},[],{"_3172":65222,"_28020":65198,"_19450":109337,"_5":13408,"_26522":109265,"_2670":109338},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3172":65223,"_28020":65198,"_19450":109340,"_5":13408,"_26522":109265,"_2670":47944},[],{"_3172":65224,"_28020":65198,"_19450":109342,"_5":13408,"_26522":109265,"_2670":109343},[],"La identidad ha vencido.",{"_3172":65225,"_28020":65198,"_19450":109345,"_5":13408,"_26522":109265,"_2670":47950},[],{"_3172":65226,"_28020":65198,"_19450":109347,"_5":13408,"_26522":109265,"_2670":109348},[],"La identidad está marcada como revocada.",{"_3172":65227,"_28020":65198,"_19450":109350,"_5":13408,"_26522":109265,"_2670":47956},[],{"_3172":65228,"_28020":65198,"_19450":109352,"_5":13408,"_26522":109265,"_2670":109353},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3172":65229,"_28020":65198,"_19450":109355,"_5":13408,"_26522":109265,"_2670":109356},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3172":65230,"_28020":65198,"_19450":109358,"_5":13408,"_26522":109269,"_2670":109359},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3172":65231,"_28020":65198,"_19450":109361,"_5":13408,"_26522":109269,"_2670":109362},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3172":65232,"_28020":65198,"_19450":109364,"_5":13408,"_26522":109269,"_2670":109365},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3172":65233,"_28020":65198,"_19450":109367,"_5":13408,"_26522":109269,"_2670":109368},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3172":65234,"_28020":65198,"_19450":109370,"_5":13408,"_26522":109273,"_2670":109371},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3172":65235,"_28020":65198,"_19450":109373,"_5":13408,"_26522":109277,"_2670":109374},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3172":65236,"_28020":65198,"_19450":109376,"_5":13408,"_26522":109281,"_2670":109377},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3172":65237,"_28020":65198,"_19450":109379,"_5":13408,"_26522":109285,"_2670":109380},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3172":65238,"_28020":65198,"_19450":109382,"_5":13408,"_26522":109289,"_2670":109383},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3172":65239,"_28020":65198,"_19450":109385,"_5":13408,"_26522":109289,"_2670":109386},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3172":65240,"_28020":65198,"_19450":109388,"_5":13408,"_26522":109293,"_2670":109389},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3172":65241,"_28020":65198,"_19450":109391,"_5":13408,"_26522":109293,"_2670":109392},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3172":65242,"_28020":65198,"_19450":109394,"_5":13408,"_26522":109293,"_2670":109395},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3172":65243,"_28020":65198,"_19450":109397,"_5":13408,"_26522":109293,"_2670":109398},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3172":65244,"_28020":65198,"_19450":109400,"_5":13408,"_26522":109293,"_2670":109401},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3172":65245,"_28020":65198,"_19450":109403,"_5":13408,"_26522":109293,"_2670":109404},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3172":65246,"_28020":65198,"_19450":109406,"_5":13408,"_26522":109297,"_2670":109407},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3172":65247,"_28020":65198,"_19450":109409,"_5":13408,"_26522":109297,"_2670":109410},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3172":65248,"_28020":65198,"_19450":109412,"_5":13408,"_26522":109301,"_2670":109413},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3172":65249,"_28020":65198,"_19450":109415,"_5":13408,"_26522":109301,"_2670":109416},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3172":65250,"_28020":65198,"_19450":109418,"_5":13408,"_26522":109301,"_2670":109419},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3172":65251,"_28020":65198,"_19450":109421,"_5":13408,"_26522":109301,"_2670":109422},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3172":65252,"_28020":65198,"_19450":109424,"_5":13408,"_26522":109305,"_2670":109425},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3172":65253,"_28020":65198,"_19450":109427,"_5":13408,"_26522":109305,"_2670":109428},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3172":65254,"_28020":65254,"_5":13734,"_2670":109430,"_28372":109431,"_19450":109433,"_26522":65254},"Identidad inicial y autenticación",[45500,108282,47857,109257,109432],"Enrolamiento con PKI",[],{"_3172":65255,"_28020":65254,"_19450":109435,"_5":13408,"_26522":65254,"_2670":109436},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3172":65256,"_28020":65254,"_5":28369,"_19450":109438,"_26522":109439,"_2670":109440},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3172":65257,"_28020":65254,"_5":28369,"_19450":109442,"_26522":109443,"_2670":109444},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3172":65258,"_28020":65254,"_5":28369,"_19450":109446,"_26522":109447,"_2670":109448},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3172":65259,"_28020":65254,"_5":28369,"_19450":109450,"_26522":109451,"_2670":109452},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3172":65260,"_28020":65254,"_5":28369,"_19450":109454,"_26522":109455,"_2670":109456},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3172":65261,"_28020":65254,"_19450":109458,"_5":13408,"_26522":65254,"_2670":109459},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3172":65262,"_28020":65254,"_19450":109461,"_5":13408,"_26522":109439,"_2670":109462},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3172":65263,"_28020":65254,"_19450":109464,"_5":13408,"_26522":109439,"_2670":109465},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3172":65264,"_28020":65254,"_19450":109467,"_5":13408,"_26522":109443,"_2670":109468},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3172":65265,"_28020":65254,"_19450":109470,"_5":13408,"_26522":109443,"_2670":109471},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3172":65266,"_28020":65254,"_19450":109473,"_5":13408,"_26522":109443,"_2670":109474},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3172":65267,"_28020":65254,"_19450":109476,"_5":13408,"_26522":109447,"_2670":109477},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3172":65268,"_28020":65254,"_19450":109479,"_5":13408,"_26522":109447,"_2670":109480},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3172":65269,"_28020":65254,"_19450":109482,"_5":13408,"_26522":109451,"_2670":109483},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3172":65270,"_28020":65254,"_19450":109485,"_5":13408,"_26522":109451,"_2670":109486},[],"Ejemplo de cuerpo:",{"_3172":65271,"_28020":65254,"_19450":109488,"_5":13408,"_26522":109451,"_2670":109489},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3172":65272,"_28020":65254,"_19450":109491,"_5":13408,"_26522":109451,"_2670":109492},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3172":65273,"_28020":65254,"_19450":109494,"_5":13408,"_26522":109451,"_2670":109495},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3172":65274,"_28020":65254,"_19450":109497,"_5":13408,"_26522":109451,"_2670":109498},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3172":65275,"_28020":65254,"_19450":109500,"_5":13408,"_26522":109455,"_2670":109501},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3172":65276,"_28020":65254,"_19450":109503,"_5":13408,"_26522":109455,"_2670":109504},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3172":65277,"_28020":65277,"_5":13734,"_2670":109506,"_28372":109507,"_19450":109508,"_26522":65277},"Configura y opera el DMS",[45500,108282,47857,109257,109432],[],{"_3172":65278,"_28020":65277,"_19450":109510,"_5":13408,"_26522":65277,"_2670":109511},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3172":65279,"_28020":65277,"_5":28369,"_19450":109513,"_26522":109514,"_2670":106948},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3172":65280,"_28020":65277,"_5":28369,"_19450":109516,"_26522":109517,"_2670":109518},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3172":65281,"_28020":65277,"_5":28369,"_19450":109520,"_26522":109521,"_2670":109522},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3172":65282,"_28020":65277,"_5":28369,"_19450":109524,"_26522":109525,"_2670":109526},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3172":65283,"_28020":65277,"_5":28369,"_19450":109528,"_26522":109529,"_2670":109530},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3172":65284,"_28020":65277,"_5":28369,"_19450":109532,"_26522":109533,"_2670":109534},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3172":65285,"_28020":65277,"_5":28369,"_19450":109536,"_26522":109537,"_2670":109538},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3172":65286,"_28020":65277,"_5":28369,"_19450":109540,"_26522":109541,"_2670":109542},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3172":65287,"_28020":65277,"_5":28369,"_19450":109544,"_26522":109545,"_2670":48152},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3172":65288,"_28020":65277,"_5":28369,"_19450":109547,"_26522":109548,"_2670":48156},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3172":65289,"_28020":65277,"_5":28369,"_19450":109550,"_26522":109551,"_2670":109552},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3172":65290,"_28020":65277,"_5":28369,"_19450":109554,"_26522":109555,"_2670":109556},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3172":65291,"_28020":65277,"_5":28369,"_19450":109558,"_26522":109559,"_2670":109560},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3172":65292,"_28020":65277,"_5":28369,"_19450":109562,"_26522":109563,"_2670":109564},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3172":65293,"_28020":65277,"_5":28369,"_19450":109566,"_26522":109567,"_2670":48176},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3172":65294,"_28020":65277,"_5":28369,"_19450":109569,"_26522":109570,"_2670":109571},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3172":65295,"_28020":65277,"_5":28369,"_19450":109573,"_26522":109574,"_2670":109575},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3172":65296,"_28020":65277,"_5":28369,"_19450":109577,"_26522":109578,"_2670":109579},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3172":65297,"_28020":65277,"_19450":109581,"_5":13408,"_26522":65277,"_2670":109582},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3172":65298,"_28020":65277,"_19450":109584,"_5":13408,"_26522":109514,"_2670":109585},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3172":65299,"_28020":65277,"_19450":109587,"_5":13408,"_26522":109514,"_2670":109588},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3172":65300,"_28020":65277,"_19450":109590,"_5":13408,"_26522":109521,"_2670":109591},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3172":65301,"_28020":65277,"_19450":109593,"_5":13408,"_26522":109525,"_2670":109594},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3172":65302,"_28020":65277,"_19450":109596,"_5":13408,"_26522":109529,"_2670":109597},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3172":65303,"_28020":65277,"_19450":109599,"_5":13408,"_26522":109533,"_2670":109600},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3172":65304,"_28020":65277,"_19450":109602,"_5":13408,"_26522":109537,"_2670":109603},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3172":65305,"_28020":65277,"_19450":109605,"_5":13408,"_26522":109545,"_2670":109606},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3172":65306,"_28020":65277,"_19450":109608,"_5":13408,"_26522":109545,"_2670":109609},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3172":65307,"_28020":65277,"_19450":109611,"_5":13408,"_26522":109548,"_2670":109612},[],"Campo de `settings.enrollment_settings`",{"_3172":65308,"_28020":65277,"_19450":109614,"_5":13408,"_26522":109548,"_2670":109615},[],"Decisión",{"_3172":65309,"_28020":65277,"_19450":109617,"_5":13408,"_26522":109548,"_2670":48227},[],{"_3172":65310,"_28020":65277,"_19450":109619,"_5":13408,"_26522":109548,"_2670":109620},[],"`EST_RFC7030` para estas operaciones.",{"_3172":65311,"_28020":65277,"_19450":109622,"_5":13408,"_26522":109548,"_2670":48233},[],{"_3172":65312,"_28020":65277,"_19450":109624,"_5":13408,"_26522":109548,"_2670":109625},[],"ID de la CA que firmará.",{"_3172":65313,"_28020":65277,"_19450":109627,"_5":13408,"_26522":109548,"_2670":48239},[],{"_3172":65314,"_28020":65277,"_19450":109629,"_5":13408,"_26522":109548,"_2670":109630},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3172":65315,"_28020":65277,"_19450":109632,"_5":13408,"_26522":109548,"_2670":48245},[],{"_3172":65316,"_28020":65277,"_19450":109634,"_5":13408,"_26522":109548,"_2670":109635},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3172":65317,"_28020":65277,"_19450":109637,"_5":13408,"_26522":109548,"_2670":48251},[],{"_3172":65318,"_28020":65277,"_19450":109639,"_5":13408,"_26522":109548,"_2670":109640},[],"Uno de los cuatro modos de autenticación.",{"_3172":65319,"_28020":65277,"_19450":109642,"_5":13408,"_26522":109548,"_2670":109643},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3172":65320,"_28020":65277,"_19450":109645,"_5":13408,"_26522":109551,"_2670":109646},[],"Los bloques son independientes:",{"_3172":65321,"_28020":65277,"_19450":109648,"_5":13408,"_26522":109551,"_2670":109649},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3172":65322,"_28020":65277,"_19450":109651,"_5":13408,"_26522":109551,"_2670":109652},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3172":65323,"_28020":65277,"_19450":109654,"_5":13408,"_26522":109551,"_2670":48269},[],{"_3172":65324,"_28020":65277,"_19450":109656,"_5":13408,"_26522":109551,"_2670":109657},[],"Control aplicado en la operación configurada",{"_3172":65325,"_28020":65277,"_19450":109659,"_5":13408,"_26522":109551,"_2670":48275},[],{"_3172":65326,"_28020":65277,"_19450":109661,"_5":13408,"_26522":109551,"_2670":109662},[],"Validación del certificado presentado.",{"_3172":65327,"_28020":65277,"_19450":109664,"_5":13408,"_26522":109551,"_2670":48281},[],{"_3172":65328,"_28020":65277,"_19450":109666,"_5":13408,"_26522":109551,"_2670":109667},[],"Autorización del webhook configurado.",{"_3172":65329,"_28020":65277,"_19450":109669,"_5":13408,"_26522":109551,"_2670":48287},[],{"_3172":65330,"_28020":65277,"_19450":109671,"_5":13408,"_26522":109551,"_2670":109672},[],"Validación del certificado y, después, aprobación del webhook.",{"_3172":65331,"_28020":65277,"_19450":109674,"_5":13408,"_26522":109551,"_2670":48293},[],{"_3172":65332,"_28020":65277,"_19450":109676,"_5":13408,"_26522":109551,"_2670":109677},[],"Sin autenticación del solicitante por el DMS.",{"_3172":65333,"_28020":65277,"_19450":109679,"_5":13408,"_26522":109551,"_2670":109680},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3172":65334,"_28020":65277,"_19450":109682,"_5":13408,"_26522":109551,"_2670":109683},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3172":65335,"_28020":65277,"_19450":109685,"_5":13408,"_26522":109551,"_2670":109686},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3172":65336,"_28020":65277,"_19450":109688,"_5":13408,"_26522":109551,"_2670":109689},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3172":65337,"_28020":65277,"_19450":109691,"_5":13408,"_26522":109555,"_2670":109692},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3172":65338,"_28020":65277,"_19450":109694,"_5":13408,"_26522":109555,"_2670":109695},[],"Campo de `external_webhook_settings`",{"_3172":65339,"_28020":65277,"_19450":109697,"_5":13408,"_26522":109555,"_2670":109615},[],{"_3172":65340,"_28020":65277,"_19450":109699,"_5":13408,"_26522":109555,"_2670":48319},[],{"_3172":65341,"_28020":65277,"_19450":109701,"_5":13408,"_26522":109555,"_2670":109702},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3172":65342,"_28020":65277,"_19450":109704,"_5":13408,"_26522":109555,"_2670":48325},[],{"_3172":65343,"_28020":65277,"_19450":109706,"_5":13408,"_26522":109555,"_2670":109707},[],"`POST` o `PUT`; `POST` por defecto.",{"_3172":65344,"_28020":65277,"_19450":109709,"_5":13408,"_26522":109555,"_2670":48331},[],{"_3172":65345,"_28020":65277,"_19450":109711,"_5":13408,"_26522":109555,"_2670":109712},[],"Etiqueta usada en los logs del servicio.",{"_3172":65346,"_28020":65277,"_19450":109714,"_5":13408,"_26522":109555,"_2670":48337},[],{"_3172":65347,"_28020":65277,"_19450":109716,"_5":13408,"_26522":109555,"_2670":109717},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3172":65348,"_28020":65277,"_19450":109719,"_5":13408,"_26522":109555,"_2670":48343},[],{"_3172":65349,"_28020":65277,"_19450":109721,"_5":13408,"_26522":109555,"_2670":109722},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3172":65350,"_28020":65277,"_19450":109724,"_5":13408,"_26522":109555,"_2670":48349},[],{"_3172":65351,"_28020":65277,"_19450":109726,"_5":13408,"_26522":109555,"_2670":109727},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3172":65352,"_28020":65277,"_19450":109729,"_5":13408,"_26522":109555,"_2670":48355},[],{"_3172":65353,"_28020":65277,"_19450":109731,"_5":13408,"_26522":109555,"_2670":109732},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3172":65354,"_28020":65277,"_19450":109734,"_5":13408,"_26522":109555,"_2670":48361},[],{"_3172":65355,"_28020":65277,"_19450":109736,"_5":13408,"_26522":109555,"_2670":109737},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3172":65356,"_28020":65277,"_19450":109739,"_5":13408,"_26522":109555,"_2670":48367},[],{"_3172":65357,"_28020":65277,"_19450":109741,"_5":13408,"_26522":109555,"_2670":109742},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3172":65358,"_28020":65277,"_19450":109744,"_5":13408,"_26522":109555,"_2670":109745},[],"Reglas de esa configuración:",{"_3172":65359,"_28020":65277,"_19450":109747,"_5":13408,"_26522":109555,"_2670":109748},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3172":65360,"_28020":65277,"_19450":109750,"_5":13408,"_26522":109555,"_2670":109751},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3172":65361,"_28020":65277,"_19450":109753,"_5":13408,"_26522":109555,"_2670":109754},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3172":65362,"_28020":65277,"_19450":109756,"_5":13408,"_26522":109555,"_2670":109757},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3172":65363,"_28020":65277,"_19450":109759,"_5":13408,"_26522":109555,"_2670":109760},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3172":65364,"_28020":65277,"_19450":109762,"_5":13408,"_26522":109555,"_2670":109763},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3172":65365,"_28020":65277,"_19450":109765,"_5":13408,"_26522":109555,"_2670":109766},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar, y si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_3172":65366,"_28020":65277,"_19450":109768,"_5":13408,"_26522":109555,"_2670":109769},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3172":65367,"_28020":65277,"_19450":109771,"_5":13408,"_26522":109555,"_2670":109772},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3172":65368,"_28020":65277,"_19450":109774,"_5":13408,"_26522":109559,"_2670":109775},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3172":65369,"_28020":65277,"_19450":109777,"_5":13408,"_26522":109563,"_2670":109778},[],"Campo de `settings.reenrollment_settings`",{"_3172":65370,"_28020":65277,"_19450":109780,"_5":13408,"_26522":109563,"_2670":109781},[],"Función",{"_3172":65371,"_28020":65277,"_19450":109783,"_5":13408,"_26522":109563,"_2670":48411},[],{"_3172":65372,"_28020":65277,"_19450":109785,"_5":13408,"_26522":109563,"_2670":109786},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3172":65373,"_28020":65277,"_19450":109788,"_5":13408,"_26522":109563,"_2670":48417},[],{"_3172":65374,"_28020":65277,"_19450":109790,"_5":13408,"_26522":109563,"_2670":109791},[],"Umbral operativo preventivo de monitorización.",{"_3172":65375,"_28020":65277,"_19450":109793,"_5":13408,"_26522":109563,"_2670":48423},[],{"_3172":65376,"_28020":65277,"_19450":109795,"_5":13408,"_26522":109563,"_2670":109796},[],"Umbral operativo crítico de monitorización.",{"_3172":65377,"_28020":65277,"_19450":109798,"_5":13408,"_26522":109563,"_2670":48429},[],{"_3172":65378,"_28020":65277,"_19450":109800,"_5":13408,"_26522":109563,"_2670":109801},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3172":65379,"_28020":65277,"_19450":109803,"_5":13408,"_26522":109563,"_2670":48435},[],{"_3172":65380,"_28020":65277,"_19450":109805,"_5":13408,"_26522":109563,"_2670":109806},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3172":65381,"_28020":65277,"_19450":109808,"_5":13408,"_26522":109563,"_2670":48441},[],{"_3172":65382,"_28020":65277,"_19450":109810,"_5":13408,"_26522":109563,"_2670":109811},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3172":65383,"_28020":65277,"_19450":109813,"_5":13408,"_26522":109563,"_2670":109814},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3172":65384,"_28020":65277,"_19450":109816,"_5":13408,"_26522":109567,"_2670":109817},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3172":65385,"_28020":65277,"_19450":109819,"_5":13408,"_26522":109570,"_2670":107312},[],{"_3172":65386,"_28020":65277,"_19450":109821,"_5":13408,"_26522":109570,"_2670":109822},[],"Qué publica",{"_3172":65387,"_28020":65277,"_19450":109824,"_5":13408,"_26522":109570,"_2670":48458},[],{"_3172":65388,"_28020":65277,"_19450":109826,"_5":13408,"_26522":109570,"_2670":109827},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3172":65389,"_28020":65277,"_19450":109829,"_5":13408,"_26522":109570,"_2670":48464},[],{"_3172":65390,"_28020":65277,"_19450":109831,"_5":13408,"_26522":109570,"_2670":109832},[],"Certificado de la CA emisora seleccionada.",{"_3172":65391,"_28020":65277,"_19450":109834,"_5":13408,"_26522":109570,"_2670":48470},[],{"_3172":65392,"_28020":65277,"_19450":109836,"_5":13408,"_26522":109570,"_2670":109837},[],"Certificados de las CAs elegidas explícitamente.",{"_3172":65393,"_28020":65277,"_19450":109839,"_5":13408,"_26522":109570,"_2670":109840},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3172":65394,"_28020":65277,"_19450":109842,"_5":13408,"_26522":109574,"_2670":109843},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_3172":65395,"_28020":65277,"_19450":109845,"_5":13408,"_26522":109574,"_2670":109846},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3172":65396,"_28020":65277,"_19450":109848,"_5":13408,"_26522":109574,"_2670":109849},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3172":65397,"_28020":65277,"_19450":109851,"_5":13408,"_26522":109578,"_2670":109852},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3172":65398,"_28020":65398,"_5":13734,"_2670":109854,"_28372":109855,"_19450":109856,"_26522":65398},"Integra el cliente EST",[45500,108282,47857,109257,109432],[],{"_3172":65399,"_28020":65398,"_19450":109858,"_5":13408,"_26522":65398,"_2670":109859},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3172":65400,"_28020":65398,"_5":28369,"_19450":109861,"_26522":109862,"_2670":106948},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3172":65401,"_28020":65398,"_5":28369,"_19450":109864,"_26522":109865,"_2670":109866},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3172":65402,"_28020":65398,"_5":28369,"_19450":109868,"_26522":109869,"_2670":109870},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3172":65403,"_28020":65398,"_5":28369,"_19450":109872,"_26522":109873,"_2670":109874},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3172":65404,"_28020":65398,"_5":28369,"_19450":109876,"_26522":109877,"_2670":109878},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3172":65405,"_28020":65398,"_5":28369,"_19450":109880,"_26522":109881,"_2670":109882},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3172":65406,"_28020":65398,"_19450":109884,"_5":13408,"_26522":65398,"_2670":109885},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3172":65407,"_28020":65398,"_19450":109887,"_5":13408,"_26522":109862,"_2670":109888},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3172":65408,"_28020":65398,"_19450":109890,"_5":13408,"_26522":109862,"_2670":109891},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3172":65409,"_28020":65398,"_19450":109893,"_5":13408,"_26522":109862,"_2670":109894},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3172":65410,"_28020":65398,"_19450":109896,"_5":13408,"_26522":109865,"_2670":109897},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3172":65411,"_28020":65398,"_19450":109899,"_5":13408,"_26522":109865,"_2670":109900},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3172":65412,"_28020":65398,"_19450":109902,"_5":13408,"_26522":109869,"_2670":109903},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3172":65413,"_28020":65398,"_19450":109905,"_5":13408,"_26522":109869,"_2670":109906},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3172":65414,"_28020":65398,"_19450":109908,"_5":13408,"_26522":109873,"_2670":109909},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3172":65415,"_28020":65398,"_19450":109911,"_5":13408,"_26522":109873,"_2670":109912},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3172":65416,"_28020":65398,"_19450":109914,"_5":13408,"_26522":109877,"_2670":109915},[],"Para el caso de una raíz que emite directamente:",{"_3172":65417,"_28020":65398,"_19450":109917,"_5":13408,"_26522":109877,"_2670":109918},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3172":65418,"_28020":65398,"_19450":109920,"_5":13408,"_26522":109877,"_2670":109921},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3172":65419,"_28020":65398,"_19450":109923,"_5":13408,"_26522":109881,"_2670":109924},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3172":65420,"_28020":65420,"_5":13734,"_2670":109926,"_28372":109927,"_19450":109928,"_26522":65420},"Referencia EST",[45500,108282,47857,109257,109432],[],{"_3172":65421,"_28020":65420,"_19450":109930,"_5":13408,"_26522":65420,"_2670":109931},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3172":65422,"_28020":65420,"_5":28369,"_19450":109933,"_26522":109934,"_2670":109935},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3172":65423,"_28020":65420,"_5":28369,"_19450":109937,"_26522":109938,"_2670":21132},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3172":65424,"_28020":65420,"_5":28369,"_19450":109940,"_26522":109941,"_2670":24255},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3172":65425,"_28020":65420,"_5":28369,"_19450":109943,"_26522":109944,"_2670":24262},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3172":65426,"_28020":65420,"_5":28369,"_19450":109946,"_26522":109947,"_2670":23608},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3172":65427,"_28020":65420,"_5":28369,"_19450":109949,"_26522":109950,"_2670":109951},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3172":65428,"_28020":65420,"_5":28369,"_19450":109953,"_26522":109954,"_2670":109955},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3172":65429,"_28020":65420,"_5":28369,"_19450":109957,"_26522":109958,"_2670":109959},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3172":65430,"_28020":65420,"_19450":109961,"_5":13408,"_26522":65420,"_2670":109962},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3172":65431,"_28020":65420,"_19450":109964,"_5":13408,"_26522":109934,"_2670":109965},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3172":65432,"_28020":65420,"_19450":109967,"_5":13408,"_26522":109934,"_2670":108073},[],{"_3172":65433,"_28020":65420,"_19450":109969,"_5":13408,"_26522":109934,"_2670":109970},[],"Método",{"_3172":65434,"_28020":65420,"_19450":109972,"_5":13408,"_26522":109934,"_2670":109973},[],"Autenticación y condición",{"_3172":65435,"_28020":65420,"_19450":109975,"_5":13408,"_26522":109934,"_2670":48613},[],{"_3172":65436,"_28020":65420,"_19450":109977,"_5":13408,"_26522":109934,"_2670":48616},[],{"_3172":65437,"_28020":65420,"_19450":109979,"_5":13408,"_26522":109934,"_2670":109980},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3172":65438,"_28020":65420,"_19450":109982,"_5":13408,"_26522":109934,"_2670":48622},[],{"_3172":65439,"_28020":65420,"_19450":109984,"_5":13408,"_26522":109934,"_2670":48625},[],{"_3172":65440,"_28020":65420,"_19450":109986,"_5":13408,"_26522":109934,"_2670":109987},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3172":65441,"_28020":65420,"_19450":109989,"_5":13408,"_26522":109934,"_2670":48631},[],{"_3172":65442,"_28020":65420,"_19450":109991,"_5":13408,"_26522":109934,"_2670":48625},[],{"_3172":65443,"_28020":65420,"_19450":109993,"_5":13408,"_26522":109934,"_2670":109994},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3172":65444,"_28020":65420,"_19450":109996,"_5":13408,"_26522":109934,"_2670":48639},[],{"_3172":65445,"_28020":65420,"_19450":109998,"_5":13408,"_26522":109934,"_2670":48625},[],{"_3172":65446,"_28020":65420,"_19450":110000,"_5":13408,"_26522":109934,"_2670":110001},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3172":65447,"_28020":65420,"_19450":110003,"_5":13408,"_26522":109934,"_2670":110004},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3172":65448,"_28020":65420,"_19450":110006,"_5":13408,"_26522":109938,"_2670":110007},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3172":65449,"_28020":65420,"_19450":110009,"_5":13408,"_26522":109938,"_2670":110010},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3172":65450,"_28020":65420,"_19450":110012,"_5":13408,"_26522":109941,"_2670":110013},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3172":65451,"_28020":65420,"_19450":110015,"_5":13408,"_26522":109941,"_2670":110016},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3172":65452,"_28020":65420,"_19450":110018,"_5":13408,"_26522":109944,"_2670":110019},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3172":65453,"_28020":65420,"_19450":110021,"_5":13408,"_26522":109944,"_2670":110022},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3172":65454,"_28020":65420,"_19450":110024,"_5":13408,"_26522":109947,"_2670":110025},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3172":65455,"_28020":65420,"_19450":110027,"_5":13408,"_26522":109947,"_2670":110028},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3172":65456,"_28020":65420,"_19450":110030,"_5":13408,"_26522":109950,"_2670":110031},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3172":65457,"_28020":65420,"_19450":110033,"_5":13408,"_26522":109950,"_2670":110034},[],"Parte",{"_3172":65458,"_28020":65420,"_19450":110036,"_5":13408,"_26522":109950,"_2670":110037},[],"Contenido tras decodificar su Base64",{"_3172":65459,"_28020":65420,"_19450":110039,"_5":13408,"_26522":109950,"_2670":48683},[],{"_3172":65460,"_28020":65420,"_19450":110041,"_5":13408,"_26522":109950,"_2670":110042},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3172":65461,"_28020":65420,"_19450":110044,"_5":13408,"_26522":109950,"_2670":48689},[],{"_3172":65462,"_28020":65420,"_19450":110046,"_5":13408,"_26522":109950,"_2670":110047},[],"PKCS#7 DER con el certificado emitido.",{"_3172":65463,"_28020":65420,"_19450":110049,"_5":13408,"_26522":109950,"_2670":110050},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3172":65464,"_28020":65420,"_19450":110052,"_5":13408,"_26522":109954,"_2670":110053},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3172":65465,"_28020":65420,"_19450":110055,"_5":13408,"_26522":109954,"_2670":110056},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3172":65466,"_28020":65420,"_19450":110058,"_5":13408,"_26522":109954,"_2670":110059},[],"Convierte y comprueba el resultado:",{"_3172":65467,"_28020":65420,"_19450":110061,"_5":13408,"_26522":109954,"_2670":110062},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3172":65468,"_28020":65420,"_19450":110064,"_5":13408,"_26522":109958,"_2670":110065},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3172":65469,"_28020":65420,"_19450":110067,"_5":13408,"_26522":109958,"_2670":110068},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3172":65470,"_28020":65470,"_5":13734,"_2670":109432,"_28372":110070,"_19450":110071,"_26522":65470},[45500,108282,47857,109257,109432],[],{"_3172":65471,"_28020":65470,"_19450":110073,"_5":13408,"_26522":65470,"_2670":110074},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3172":65472,"_28020":65470,"_5":28369,"_19450":110076,"_26522":110077,"_2670":110078},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3172":65473,"_28020":65470,"_5":28369,"_19450":110080,"_26522":110081,"_2670":110082},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3172":65474,"_28020":65470,"_5":28369,"_19450":110084,"_26522":110085,"_2670":110086},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3172":65475,"_28020":65470,"_5":28369,"_19450":110088,"_26522":110089,"_2670":110090},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3172":65476,"_28020":65470,"_19450":110092,"_5":13408,"_26522":65470,"_2670":110093},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3172":65477,"_28020":65470,"_19450":110095,"_5":13408,"_26522":110077,"_2670":110096},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3172":65478,"_28020":65470,"_19450":110098,"_5":13408,"_26522":110077,"_2670":110099},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3172":65479,"_28020":65470,"_19450":110101,"_5":13408,"_26522":110077,"_2670":110102},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3172":65480,"_28020":65470,"_19450":110104,"_5":13408,"_26522":110077,"_2670":110105},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3172":65481,"_28020":65470,"_19450":110107,"_5":13408,"_26522":110077,"_2670":110108},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3172":65482,"_28020":65470,"_19450":110110,"_5":13408,"_26522":110077,"_2670":110111},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3172":65483,"_28020":65470,"_19450":110113,"_5":13408,"_26522":110081,"_2670":110114},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3172":65484,"_28020":65470,"_19450":110116,"_5":13408,"_26522":110081,"_2670":110117},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3172":65485,"_28020":65470,"_19450":110119,"_5":13408,"_26522":110081,"_2670":110120},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3172":65486,"_28020":65470,"_19450":110122,"_5":13408,"_26522":110081,"_2670":110123},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3172":65487,"_28020":65470,"_19450":110125,"_5":13408,"_26522":110085,"_2670":110126},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3172":65488,"_28020":65470,"_19450":110128,"_5":13408,"_26522":110085,"_2670":110129},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3172":65489,"_28020":65470,"_19450":110131,"_5":13408,"_26522":110085,"_2670":110132},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3172":65490,"_28020":65470,"_19450":110134,"_5":13408,"_26522":110085,"_2670":110135},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3172":65491,"_28020":65470,"_19450":110137,"_5":13408,"_26522":110089,"_2670":110138},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3172":65492,"_28020":65470,"_19450":110140,"_5":13408,"_26522":110089,"_2670":110141},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3172":65493,"_28020":65493,"_5":13734,"_2670":110143,"_28372":110144,"_19450":110145,"_26522":65493},"Estrategias de aprovisionamiento",[45500,108282,47857,109257,109432],[],{"_3172":65494,"_28020":65493,"_19450":110147,"_5":13408,"_26522":65493,"_2670":110148},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3172":65495,"_28020":65493,"_5":28369,"_19450":110150,"_26522":110151,"_2670":110152},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3172":65496,"_28020":65493,"_5":28369,"_19450":110154,"_26522":110155,"_2670":110156},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3172":65497,"_28020":65493,"_5":28369,"_19450":110158,"_26522":110159,"_2670":110160},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3172":65498,"_28020":65493,"_5":28369,"_19450":110162,"_26522":110163,"_2670":110164},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3172":65499,"_28020":65493,"_5":28369,"_19450":110166,"_26522":110167,"_2670":110168},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3172":65500,"_28020":65493,"_19450":110170,"_5":13408,"_26522":65493,"_2670":110171},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3172":65501,"_28020":65493,"_19450":110173,"_5":13408,"_26522":110151,"_2670":110174},[],"Recorrido",{"_3172":65502,"_28020":65493,"_19450":110176,"_5":13408,"_26522":110151,"_2670":110177},[],"Cuándo existe el dispositivo",{"_3172":65503,"_28020":65493,"_19450":110179,"_5":13408,"_26522":110151,"_2670":110180},[],"Qué compruebas",{"_3172":65504,"_28020":65493,"_19450":110182,"_5":13408,"_26522":110151,"_2670":110183},[],"Asignación manual",{"_3172":65505,"_28020":65493,"_19450":110185,"_5":13408,"_26522":110151,"_2670":110186},[],"El operador lo crea antes de asociar un certificado.",{"_3172":65506,"_28020":65493,"_19450":110188,"_5":13408,"_26522":110151,"_2670":110189},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3172":65507,"_28020":65493,"_19450":110191,"_5":13408,"_26522":110151,"_2670":110192},[],"EST con `JITP`",{"_3172":65508,"_28020":65493,"_19450":110194,"_5":13408,"_26522":110151,"_2670":110195},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3172":65509,"_28020":65493,"_19450":110197,"_5":13408,"_26522":110151,"_2670":110198},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3172":65510,"_28020":65493,"_19450":110200,"_5":13408,"_26522":110151,"_2670":110201},[],"EST con `PRE_REGISTRATION`",{"_3172":65511,"_28020":65493,"_19450":110203,"_5":13408,"_26522":110151,"_2670":110204},[],"Debe existir antes de `/simpleenroll`.",{"_3172":65512,"_28020":65493,"_19450":110206,"_5":13408,"_26522":110151,"_2670":110207},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3172":65513,"_28020":65493,"_19450":110209,"_5":13408,"_26522":110151,"_2670":110210},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3172":65514,"_28020":65493,"_19450":110212,"_5":13408,"_26522":110151,"_2670":110213},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3172":65515,"_28020":65493,"_19450":110215,"_5":13408,"_26522":110155,"_2670":110216},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3172":65516,"_28020":65493,"_19450":110218,"_5":13408,"_26522":110155,"_2670":110219},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3172":65517,"_28020":65493,"_19450":110221,"_5":13408,"_26522":110155,"_2670":110222},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3172":65518,"_28020":65493,"_19450":110224,"_5":13408,"_26522":110159,"_2670":110225},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3172":65519,"_28020":65493,"_19450":110227,"_5":13408,"_26522":110159,"_2670":110228},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3172":65520,"_28020":65493,"_19450":110230,"_5":13408,"_26522":110159,"_2670":110231},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3172":65521,"_28020":65493,"_19450":110233,"_5":13408,"_26522":110159,"_2670":110234},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3172":65522,"_28020":65493,"_19450":110236,"_5":13408,"_26522":110159,"_2670":110237},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3172":65523,"_28020":65493,"_19450":110239,"_5":13408,"_26522":110159,"_2670":110240},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3172":65524,"_28020":65493,"_19450":110242,"_5":13408,"_26522":110163,"_2670":107312},[],{"_3172":65525,"_28020":65493,"_19450":110244,"_5":13408,"_26522":110163,"_2670":110245},[],"Material que atraviesa EST",{"_3172":65526,"_28020":65493,"_19450":110247,"_5":13408,"_26522":110163,"_2670":110248},[],"Clave generada por el dispositivo",{"_3172":65527,"_28020":65493,"_19450":110250,"_5":13408,"_26522":110163,"_2670":110251},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3172":65528,"_28020":65493,"_19450":110253,"_5":13408,"_26522":110163,"_2670":110254},[],"Clave ya disponible en el dispositivo",{"_3172":65529,"_28020":65493,"_19450":110256,"_5":13408,"_26522":110163,"_2670":110257},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3172":65530,"_28020":65493,"_19450":110259,"_5":13408,"_26522":110163,"_2670":48176},[],{"_3172":65531,"_28020":65493,"_19450":110261,"_5":13408,"_26522":110163,"_2670":110262},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3172":65532,"_28020":65493,"_19450":110264,"_5":13408,"_26522":110163,"_2670":110265},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3172":65533,"_28020":65493,"_19450":110267,"_5":13408,"_26522":110167,"_2670":110268},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3172":65534,"_28020":65534,"_5":13734,"_2670":110270,"_28372":110271,"_19450":110272,"_26522":65534},"Renovación y recuperación",[45500,108282,47857,109257,109432],[],{"_3172":65535,"_28020":65534,"_19450":110274,"_5":13408,"_26522":65534,"_2670":110275},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3172":65536,"_28020":65534,"_5":28369,"_19450":110277,"_26522":110278,"_2670":110279},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3172":65537,"_28020":65534,"_5":28369,"_19450":110281,"_26522":110282,"_2670":110283},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3172":65538,"_28020":65534,"_5":28369,"_19450":110285,"_26522":110286,"_2670":110287},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3172":65539,"_28020":65534,"_5":28369,"_19450":110289,"_26522":110290,"_2670":110291},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3172":65540,"_28020":65534,"_5":28369,"_19450":110293,"_26522":110294,"_2670":110295},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3172":65541,"_28020":65534,"_19450":110297,"_5":13408,"_26522":65534,"_2670":110298},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3172":65542,"_28020":65534,"_19450":110300,"_5":13408,"_26522":110278,"_2670":110301},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3172":65543,"_28020":65534,"_19450":110303,"_5":13408,"_26522":110278,"_2670":110304},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3172":65544,"_28020":65534,"_19450":110306,"_5":13408,"_26522":110278,"_2670":110307},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3172":65545,"_28020":65534,"_19450":110309,"_5":13408,"_26522":110278,"_2670":110310},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3172":65546,"_28020":65534,"_19450":110312,"_5":13408,"_26522":110282,"_2670":110313},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3172":65547,"_28020":65534,"_19450":110315,"_5":13408,"_26522":110282,"_2670":110316},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3172":65548,"_28020":65534,"_19450":110318,"_5":13408,"_26522":110286,"_2670":110319},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3172":65549,"_28020":65534,"_19450":110321,"_5":13408,"_26522":110286,"_2670":110322},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3172":65550,"_28020":65534,"_19450":110324,"_5":13408,"_26522":110286,"_2670":110325},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3172":65551,"_28020":65534,"_19450":110327,"_5":13408,"_26522":110290,"_2670":110328},[],"Situación",{"_3172":65552,"_28020":65534,"_19450":110330,"_5":13408,"_26522":110290,"_2670":110331},[],"Procedimiento",{"_3172":65553,"_28020":65534,"_19450":110333,"_5":13408,"_26522":110290,"_2670":110334},[],"Certificado vigente, fuera de ventana",{"_3172":65554,"_28020":65534,"_19450":110336,"_5":13408,"_26522":110290,"_2670":110337},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3172":65555,"_28020":65534,"_19450":110339,"_5":13408,"_26522":110290,"_2670":110340},[],"Certificado vencido, clave disponible",{"_3172":65556,"_28020":65534,"_19450":110342,"_5":13408,"_26522":110290,"_2670":110343},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3172":65557,"_28020":65534,"_19450":110345,"_5":13408,"_26522":110290,"_2670":110346},[],"Renovación por webhook o `NO_AUTH`",{"_3172":65558,"_28020":65534,"_19450":110348,"_5":13408,"_26522":110290,"_2670":110349},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3172":65559,"_28020":65534,"_19450":110351,"_5":13408,"_26522":110290,"_2670":110352},[],"Clave perdida o inaccesible",{"_3172":65560,"_28020":65534,"_19450":110354,"_5":13408,"_26522":110290,"_2670":110355},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3172":65561,"_28020":65534,"_19450":110357,"_5":13408,"_26522":110290,"_2670":110358},[],"Identidad actual revocada",{"_3172":65562,"_28020":65534,"_19450":110360,"_5":13408,"_26522":110290,"_2670":110361},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3172":65563,"_28020":65534,"_19450":110363,"_5":13408,"_26522":110290,"_2670":110364},[],"Dispositivo sin identidad",{"_3172":65564,"_28020":65534,"_19450":110366,"_5":13408,"_26522":110290,"_2670":110367},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3172":65565,"_28020":65534,"_19450":110369,"_5":13408,"_26522":110290,"_2670":110370},[],"Dispositivo retirado",{"_3172":65566,"_28020":65534,"_19450":110372,"_5":13408,"_26522":110290,"_2670":110373},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3172":65567,"_28020":65534,"_19450":110375,"_5":13408,"_26522":110290,"_2670":110376},[],"Timeout, HTTP 500 o fallo de instalación",{"_3172":65568,"_28020":65534,"_19450":110378,"_5":13408,"_26522":110290,"_2670":110379},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3172":65569,"_28020":65534,"_19450":110381,"_5":13408,"_26522":110294,"_2670":110382},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3172":65570,"_28020":65534,"_19450":110384,"_5":13408,"_26522":110294,"_2670":110385},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3172":65571,"_28020":65571,"_5":13734,"_2670":110387,"_28372":110388,"_19450":110389,"_26522":65571},"Diagnóstico de enrolamiento",[45500,108282,47857,109257,109432],[],{"_3172":65572,"_28020":65571,"_19450":110391,"_5":13408,"_26522":65571,"_2670":110392},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3172":65573,"_28020":65571,"_5":28369,"_19450":110394,"_26522":110395,"_2670":110396},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3172":65574,"_28020":65571,"_5":28369,"_19450":110398,"_26522":110399,"_2670":110400},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3172":65575,"_28020":65571,"_5":28369,"_19450":110402,"_26522":110403,"_2670":109959},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3172":65576,"_28020":65571,"_5":28369,"_19450":110405,"_26522":110406,"_2670":110407},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3172":65577,"_28020":65571,"_19450":110409,"_5":13408,"_26522":65571,"_2670":110410},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3172":65578,"_28020":65571,"_19450":110412,"_5":13408,"_26522":110399,"_2670":110413},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3172":65579,"_28020":65571,"_19450":110415,"_5":13408,"_26522":110399,"_2670":110416},[],"Síntoma o mensaje",{"_3172":65580,"_28020":65571,"_19450":110418,"_5":13408,"_26522":110399,"_2670":110419},[],"Qué revisar",{"_3172":65581,"_28020":65571,"_19450":110421,"_5":13408,"_26522":110399,"_2670":110422},[],"curl rechaza TLS, nombre o emisor",{"_3172":65582,"_28020":65571,"_19450":110424,"_5":13408,"_26522":110399,"_2670":110425},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3172":65583,"_28020":65571,"_19450":110427,"_5":13408,"_26522":110399,"_2670":110428},[],"404 o APS ausente",{"_3172":65584,"_28020":65571,"_19450":110430,"_5":13408,"_26522":110399,"_2670":110431},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3172":65585,"_28020":65571,"_19450":110433,"_5":13408,"_26522":110399,"_2670":110434},[],"400, error de CSR o formato",{"_3172":65586,"_28020":65571,"_19450":110436,"_5":13408,"_26522":110399,"_2670":110437},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3172":65587,"_28020":65571,"_19450":110439,"_5":13408,"_26522":110399,"_2670":110440},[],"Credencial ausente o certificado no válido",{"_3172":65588,"_28020":65571,"_19450":110442,"_5":13408,"_26522":110399,"_2670":110443},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3172":65589,"_28020":65571,"_19450":110445,"_5":13408,"_26522":110399,"_2670":110446},[],"Webhook deniega, expira o responde sin autorización",{"_3172":65590,"_28020":65571,"_19450":110448,"_5":13408,"_26522":110399,"_2670":110449},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3172":65591,"_28020":65571,"_19450":110451,"_5":13408,"_26522":110399,"_2670":49096},[],{"_3172":65592,"_28020":65571,"_19450":110453,"_5":13408,"_26522":110399,"_2670":110454},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3172":65593,"_28020":65571,"_19450":110456,"_5":13408,"_26522":110399,"_2670":49102},[],{"_3172":65594,"_28020":65571,"_19450":110458,"_5":13408,"_26522":110399,"_2670":110459},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3172":65595,"_28020":65571,"_19450":110461,"_5":13408,"_26522":110399,"_2670":49108},[],{"_3172":65596,"_28020":65571,"_19450":110463,"_5":13408,"_26522":110399,"_2670":110464},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3172":65597,"_28020":65571,"_19450":110466,"_5":13408,"_26522":110399,"_2670":49114},[],{"_3172":65598,"_28020":65571,"_19450":110468,"_5":13408,"_26522":110399,"_2670":110469},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3172":65599,"_28020":65571,"_19450":110471,"_5":13408,"_26522":110399,"_2670":49120},[],{"_3172":65600,"_28020":65571,"_19450":110473,"_5":13408,"_26522":110399,"_2670":110474},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3172":65601,"_28020":65571,"_19450":110476,"_5":13408,"_26522":110399,"_2670":110477},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3172":65602,"_28020":65571,"_19450":110479,"_5":13408,"_26522":110399,"_2670":110480},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3172":65603,"_28020":65571,"_19450":110482,"_5":13408,"_26522":110399,"_2670":110483},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3172":65604,"_28020":65571,"_19450":110485,"_5":13408,"_26522":110399,"_2670":110486},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3172":65605,"_28020":65571,"_19450":110488,"_5":13408,"_26522":110399,"_2670":49138},[],{"_3172":65606,"_28020":65571,"_19450":110490,"_5":13408,"_26522":110399,"_2670":110491},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3172":65607,"_28020":65571,"_19450":110493,"_5":13408,"_26522":110399,"_2670":49144},[],{"_3172":65608,"_28020":65571,"_19450":110495,"_5":13408,"_26522":110399,"_2670":110496},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3172":65609,"_28020":65571,"_19450":110498,"_5":13408,"_26522":110399,"_2670":110499},[],"DMS propietario distinto",{"_3172":65610,"_28020":65571,"_19450":110501,"_5":13408,"_26522":110399,"_2670":110502},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3172":65611,"_28020":65571,"_19450":110504,"_5":13408,"_26522":110399,"_2670":49156},[],{"_3172":65612,"_28020":65571,"_19450":110506,"_5":13408,"_26522":110399,"_2670":110507},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3172":65613,"_28020":65571,"_19450":110509,"_5":13408,"_26522":110399,"_2670":49162},[],{"_3172":65614,"_28020":65571,"_19450":110511,"_5":13408,"_26522":110399,"_2670":110512},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3172":65615,"_28020":65571,"_19450":110514,"_5":13408,"_26522":110399,"_2670":110515},[],"Certificado actual revocado",{"_3172":65616,"_28020":65571,"_19450":110517,"_5":13408,"_26522":110399,"_2670":110518},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3172":65617,"_28020":65571,"_19450":110520,"_5":13408,"_26522":110399,"_2670":110521},[],"Error de CA, perfil o firma",{"_3172":65618,"_28020":65571,"_19450":110523,"_5":13408,"_26522":110399,"_2670":110524},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3172":65619,"_28020":65571,"_19450":110526,"_5":13408,"_26522":110399,"_2670":110527},[],"HTTP 200 sin conexión del dispositivo",{"_3172":65620,"_28020":65571,"_19450":110529,"_5":13408,"_26522":110399,"_2670":110530},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3172":65621,"_28020":65571,"_19450":110532,"_5":13408,"_26522":110399,"_2670":110533},[],"Timeout o error después de emitir",{"_3172":65622,"_28020":65571,"_19450":110535,"_5":13408,"_26522":110399,"_2670":110536},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3172":65623,"_28020":65571,"_19450":110538,"_5":13408,"_26522":110403,"_2670":110539},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3172":65624,"_28020":65571,"_19450":110541,"_5":13408,"_26522":110403,"_2670":110542},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3172":65625,"_28020":65571,"_19450":110544,"_5":13408,"_26522":110406,"_2670":110545},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3172":65626,"_28020":65571,"_19450":110547,"_5":13408,"_26522":110406,"_2670":110548},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3172":65627,"_28020":65571,"_19450":110550,"_5":13408,"_26522":110406,"_2670":110551},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3172":65628,"_28020":65571,"_19450":110553,"_5":13408,"_26522":110406,"_2670":110554},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3172":65629,"_28020":65571,"_19450":110556,"_5":13408,"_26522":110406,"_2670":110557},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3172":65630,"_28020":65571,"_19450":110559,"_5":13408,"_26522":110406,"_2670":110560},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3172":65631,"_28020":65571,"_19450":110562,"_5":13408,"_26522":110406,"_2670":110563},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3172":65632,"_28020":65632,"_5":13734,"_2670":110565,"_28372":110566,"_19450":110567,"_26522":65632},"Distribución y actualización de confianza",[45500,108282,47857,109257,109432],[],{"_3172":65633,"_28020":65632,"_19450":110569,"_5":13408,"_26522":65632,"_2670":110570},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3172":65634,"_28020":65632,"_5":28369,"_19450":110572,"_26522":110573,"_2670":110574},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3172":65635,"_28020":65632,"_5":28369,"_19450":110576,"_26522":110577,"_2670":110578},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3172":65636,"_28020":65632,"_5":28369,"_19450":110580,"_26522":110581,"_2670":110582},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3172":65637,"_28020":65632,"_5":28369,"_19450":110584,"_26522":110585,"_2670":110586},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3172":65638,"_28020":65632,"_5":28369,"_19450":110588,"_26522":110589,"_2670":110590},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3172":65639,"_28020":65632,"_19450":110592,"_5":13408,"_26522":65632,"_2670":110593},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3172":65640,"_28020":65632,"_19450":110595,"_5":13408,"_26522":110573,"_2670":110596},[],"Relación",{"_3172":65641,"_28020":65632,"_19450":110598,"_5":13408,"_26522":110573,"_2670":110599},[],"Material que prepara el responsable",{"_3172":65642,"_28020":65632,"_19450":110601,"_5":13408,"_26522":110573,"_2670":110602},[],"Dispositivo → servidor EST",{"_3172":65643,"_28020":65632,"_19450":110604,"_5":13408,"_26522":110573,"_2670":110605},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3172":65644,"_28020":65632,"_19450":110607,"_5":13408,"_26522":110573,"_2670":110608},[],"DMS → solicitante",{"_3172":65645,"_28020":65632,"_19450":110610,"_5":13408,"_26522":110573,"_2670":110611},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3172":65646,"_28020":65632,"_19450":110613,"_5":13408,"_26522":110573,"_2670":110614},[],"Consumidor → dispositivo",{"_3172":65647,"_28020":65632,"_19450":110616,"_5":13408,"_26522":110573,"_2670":110617},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3172":65648,"_28020":65632,"_19450":110619,"_5":13408,"_26522":110573,"_2670":110620},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3172":65649,"_28020":65632,"_19450":110622,"_5":13408,"_26522":110577,"_2670":110623},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3172":65650,"_28020":65632,"_19450":110625,"_5":13408,"_26522":110577,"_2670":110626},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3172":65651,"_28020":65632,"_19450":110628,"_5":13408,"_26522":110581,"_2670":110629},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3172":65652,"_28020":65632,"_19450":110631,"_5":13408,"_26522":110581,"_2670":110632},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3172":65653,"_28020":65632,"_19450":110634,"_5":13408,"_26522":110581,"_2670":110635},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3172":65654,"_28020":65632,"_19450":110637,"_5":13408,"_26522":110581,"_2670":110638},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3172":65655,"_28020":65632,"_19450":110640,"_5":13408,"_26522":110581,"_2670":110641},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3172":65656,"_28020":65632,"_19450":110643,"_5":13408,"_26522":110581,"_2670":110644},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3172":65657,"_28020":65632,"_19450":110646,"_5":13408,"_26522":110585,"_2670":110647},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3172":65658,"_28020":65632,"_19450":110649,"_5":13408,"_26522":110585,"_2670":110650},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3172":65659,"_28020":65632,"_19450":110652,"_5":13408,"_26522":110585,"_2670":110653},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3172":65660,"_28020":65632,"_19450":110655,"_5":13408,"_26522":110589,"_2670":110656},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3172":65661,"_28020":65661,"_5":13734,"_2670":49311,"_28372":110658,"_19450":110660,"_26522":65661},[45500,108282,47857,109257,110659],"Integraciones",[],{"_3172":65662,"_28020":65661,"_19450":110662,"_5":13408,"_26522":65661,"_2670":110663},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3172":65663,"_28020":65661,"_5":28369,"_19450":110665,"_26522":110666,"_2670":110667},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3172":65664,"_28020":65661,"_5":28369,"_19450":110669,"_26522":110670,"_2670":110671},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3172":65665,"_28020":65661,"_5":28369,"_19450":110673,"_26522":110674,"_2670":110675},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3172":65666,"_28020":65661,"_5":28369,"_19450":110677,"_26522":110678,"_2670":110679},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3172":65667,"_28020":65661,"_5":28369,"_19450":110681,"_26522":110682,"_2670":110683},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3172":65668,"_28020":65661,"_5":28369,"_19450":110685,"_26522":110686,"_2670":110687},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3172":65669,"_28020":65661,"_5":28369,"_19450":110689,"_26522":110690,"_2670":49345},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3172":65670,"_28020":65661,"_5":28369,"_19450":110692,"_26522":110693,"_2670":49349},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3172":65671,"_28020":65661,"_5":28369,"_19450":110695,"_26522":110696,"_2670":110697},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3172":65672,"_28020":65661,"_5":28369,"_19450":110699,"_26522":110700,"_2670":110701},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3172":65673,"_28020":65661,"_5":28369,"_19450":110703,"_26522":110704,"_2670":110705},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3172":65674,"_28020":65661,"_5":28369,"_19450":110707,"_26522":110708,"_2670":110709},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3172":65675,"_28020":65661,"_5":28369,"_19450":110711,"_26522":110712,"_2670":110713},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3172":65676,"_28020":65661,"_5":28369,"_19450":110715,"_26522":110716,"_2670":110717},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3172":65677,"_28020":65661,"_5":28369,"_19450":110719,"_26522":110720,"_2670":110721},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3172":65678,"_28020":65661,"_5":28369,"_19450":110723,"_26522":110724,"_2670":110725},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3172":65679,"_28020":65661,"_5":28369,"_19450":110727,"_26522":110728,"_2670":110729},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3172":65680,"_28020":65661,"_5":28369,"_19450":110731,"_26522":110732,"_2670":110733},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3172":65681,"_28020":65661,"_5":28369,"_19450":110735,"_26522":110736,"_2670":110737},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3172":65682,"_28020":65661,"_5":28369,"_19450":110739,"_26522":110740,"_2670":110741},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3172":65683,"_28020":65661,"_19450":110743,"_5":13408,"_26522":65661,"_2670":110744},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3172":65684,"_28020":65661,"_19450":110746,"_5":13408,"_26522":65661,"_2670":110747},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3172":65685,"_28020":65661,"_19450":110749,"_5":13408,"_26522":65661,"_2670":110750},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3172":65686,"_28020":65661,"_19450":110752,"_5":13408,"_26522":110666,"_2670":110753},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3172":65687,"_28020":65661,"_19450":110755,"_5":13408,"_26522":110666,"_2670":110756},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3172":65688,"_28020":65661,"_19450":110758,"_5":13408,"_26522":110666,"_2670":110759},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3172":65689,"_28020":65661,"_19450":110761,"_5":13408,"_26522":110666,"_2670":110762},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3172":65690,"_28020":65661,"_19450":110764,"_5":13408,"_26522":110670,"_2670":110765},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3172":65691,"_28020":65661,"_19450":110767,"_5":13408,"_26522":110674,"_2670":110768},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3172":65692,"_28020":65661,"_19450":110770,"_5":13408,"_26522":110674,"_2670":110771},[],"Acción IAM",{"_3172":65693,"_28020":65661,"_19450":110773,"_5":13408,"_26522":110674,"_2670":107318},[],{"_3172":65694,"_28020":65661,"_19450":110775,"_5":13408,"_26522":110674,"_2670":49432},[],{"_3172":65695,"_28020":65661,"_19450":110777,"_5":13408,"_26522":110674,"_2670":110778},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3172":65696,"_28020":65661,"_19450":110780,"_5":13408,"_26522":110674,"_2670":49438},[],{"_3172":65697,"_28020":65661,"_19450":110782,"_5":13408,"_26522":110674,"_2670":110783},[],"Registrar la CA en AWS IoT",{"_3172":65698,"_28020":65661,"_19450":110785,"_5":13408,"_26522":110674,"_2670":49444},[],{"_3172":65699,"_28020":65661,"_19450":110787,"_5":13408,"_26522":110674,"_2670":110788},[],"Consultar el estado del registro de la CA",{"_3172":65700,"_28020":65661,"_19450":110790,"_5":13408,"_26522":110674,"_2670":49450},[],{"_3172":65701,"_28020":65661,"_19450":110792,"_5":13408,"_26522":110674,"_2670":110793},[],"Crear o actualizar Things en IoT Core",{"_3172":65702,"_28020":65661,"_19450":110795,"_5":13408,"_26522":110674,"_2670":49456},[],{"_3172":65703,"_28020":65661,"_19450":110797,"_5":13408,"_26522":110674,"_2670":110798},[],"Aprovisionar Things mediante plantilla",{"_3172":65704,"_28020":65661,"_19450":110800,"_5":13408,"_26522":110674,"_2670":49462},[],{"_3172":65705,"_28020":65661,"_19450":110802,"_5":13408,"_26522":110674,"_2670":110803},[],"Registrar certificados de dispositivo",{"_3172":65706,"_28020":65661,"_19450":110805,"_5":13408,"_26522":110674,"_2670":49468},[],{"_3172":65707,"_28020":65661,"_19450":110807,"_5":13408,"_26522":110674,"_2670":110808},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3172":65708,"_28020":65661,"_19450":110810,"_5":13408,"_26522":110674,"_2670":49474},[],{"_3172":65709,"_28020":65661,"_19450":110812,"_5":13408,"_26522":110674,"_2670":110813},[],"Crear y adjuntar políticas IoT",{"_3172":65710,"_28020":65661,"_19450":110815,"_5":13408,"_26522":110674,"_2670":49480},[],{"_3172":65711,"_28020":65661,"_19450":110817,"_5":13408,"_26522":110674,"_2670":110818},[],"Gestionar grupos de Things",{"_3172":65712,"_28020":65661,"_19450":110820,"_5":13408,"_26522":110674,"_2670":49486},[],{"_3172":65713,"_28020":65661,"_19450":110822,"_5":13408,"_26522":110674,"_2670":110823},[],"Crear plantillas JITP",{"_3172":65714,"_28020":65661,"_19450":110825,"_5":13408,"_26522":110674,"_2670":49492},[],{"_3172":65715,"_28020":65661,"_19450":110827,"_5":13408,"_26522":110674,"_2670":110828},[],"Leer y escribir el Device Shadow",{"_3172":65716,"_28020":65661,"_19450":110830,"_5":13408,"_26522":110674,"_2670":110831},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3172":65717,"_28020":65661,"_19450":110833,"_5":13408,"_26522":110678,"_2670":110834},[],"Parámetro",{"_3172":65718,"_28020":65661,"_19450":110836,"_5":13408,"_26522":110678,"_2670":110837},[],"Tipo",{"_3172":65719,"_28020":65661,"_19450":110839,"_5":13408,"_26522":110678,"_2670":110840},[],"Requerido",{"_3172":65720,"_28020":65661,"_19450":110842,"_5":13408,"_26522":110678,"_2670":110843},[],"Descripción",{"_3172":65721,"_28020":65661,"_19450":110845,"_5":13408,"_26522":110678,"_2670":49513},[],{"_3172":65722,"_28020":65661,"_19450":110847,"_5":13408,"_26522":110678,"_2670":23284},[],{"_3172":65723,"_28020":65661,"_19450":110849,"_5":13408,"_26522":110678,"_2670":110850},[],"Sí",{"_3172":65724,"_28020":65661,"_19450":110852,"_5":13408,"_26522":110678,"_2670":110853},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3172":65725,"_28020":65661,"_19450":110855,"_5":13408,"_26522":110678,"_2670":49524},[],{"_3172":65726,"_28020":65661,"_19450":110857,"_5":13408,"_26522":110678,"_2670":23284},[],{"_3172":65727,"_28020":65661,"_19450":110859,"_5":13408,"_26522":110678,"_2670":110850},[],{"_3172":65728,"_28020":65661,"_19450":110861,"_5":13408,"_26522":110678,"_2670":110862},[],"Región AWS donde opera el conector.",{"_3172":65729,"_28020":65661,"_19450":110864,"_5":13408,"_26522":110678,"_2670":49534},[],{"_3172":65730,"_28020":65661,"_19450":110866,"_5":13408,"_26522":110678,"_2670":23284},[],{"_3172":65731,"_28020":65661,"_19450":110868,"_5":13408,"_26522":110678,"_2670":110850},[],{"_3172":65732,"_28020":65661,"_19450":110870,"_5":13408,"_26522":110678,"_2670":110871},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3172":65733,"_28020":65661,"_19450":110873,"_5":13408,"_26522":110678,"_2670":49544},[],{"_3172":65734,"_28020":65661,"_19450":110875,"_5":13408,"_26522":110678,"_2670":23284},[],{"_3172":65735,"_28020":65661,"_19450":110877,"_5":13408,"_26522":110678,"_2670":110878},[],"Solo con `auth_method=static`",{"_3172":65736,"_28020":65661,"_19450":110880,"_5":13408,"_26522":110678,"_2670":110881},[],"Clave de acceso AWS.",{"_3172":65737,"_28020":65661,"_19450":110883,"_5":13408,"_26522":110678,"_2670":49555},[],{"_3172":65738,"_28020":65661,"_19450":110885,"_5":13408,"_26522":110678,"_2670":23284},[],{"_3172":65739,"_28020":65661,"_19450":110887,"_5":13408,"_26522":110678,"_2670":110878},[],{"_3172":65740,"_28020":65661,"_19450":110889,"_5":13408,"_26522":110678,"_2670":110890},[],"Clave secreta AWS.",{"_3172":65741,"_28020":65661,"_19450":110892,"_5":13408,"_26522":110678,"_2670":49565},[],{"_3172":65742,"_28020":65661,"_19450":110894,"_5":13408,"_26522":110678,"_2670":23284},[],{"_3172":65743,"_28020":65661,"_19450":110896,"_5":13408,"_26522":110678,"_2670":49570},[],{"_3172":65744,"_28020":65661,"_19450":110898,"_5":13408,"_26522":110678,"_2670":110899},[],"Token de sesión (con `auth_method=static`).",{"_3172":65745,"_28020":65661,"_19450":110901,"_5":13408,"_26522":110678,"_2670":49576},[],{"_3172":65746,"_28020":65661,"_19450":110903,"_5":13408,"_26522":110678,"_2670":23284},[],{"_3172":65747,"_28020":65661,"_19450":110905,"_5":13408,"_26522":110678,"_2670":110906},[],"Solo con `auth_method=role`",{"_3172":65748,"_28020":65661,"_19450":110908,"_5":13408,"_26522":110678,"_2670":110909},[],"ARN del rol a asumir.",{"_3172":65749,"_28020":65661,"_19450":110911,"_5":13408,"_26522":110678,"_2670":49587},[],{"_3172":65750,"_28020":65661,"_19450":110913,"_5":13408,"_26522":110678,"_2670":23284},[],{"_3172":65751,"_28020":65661,"_19450":110915,"_5":13408,"_26522":110678,"_2670":49570},[],{"_3172":65752,"_28020":65661,"_19450":110917,"_5":13408,"_26522":110678,"_2670":110918},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3172":65753,"_28020":65661,"_19450":110920,"_5":13408,"_26522":110678,"_2670":49597},[],{"_3172":65754,"_28020":65661,"_19450":110922,"_5":13408,"_26522":110678,"_2670":16435},[],{"_3172":65755,"_28020":65661,"_19450":110924,"_5":13408,"_26522":110678,"_2670":110850},[],{"_3172":65756,"_28020":65661,"_19450":110926,"_5":13408,"_26522":110678,"_2670":110927},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3172":65757,"_28020":65661,"_19450":110929,"_5":13408,"_26522":110678,"_2670":49607},[],{"_3172":65758,"_28020":65661,"_19450":110931,"_5":13408,"_26522":110678,"_2670":23284},[],{"_3172":65759,"_28020":65661,"_19450":110933,"_5":13408,"_26522":110678,"_2670":110850},[],{"_3172":65760,"_28020":65661,"_19450":110935,"_5":13408,"_26522":110678,"_2670":110936},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3172":65761,"_28020":65661,"_19450":110938,"_5":13408,"_26522":110678,"_2670":49617},[],{"_3172":65762,"_28020":65661,"_19450":110940,"_5":13408,"_26522":110678,"_2670":23284},[],{"_3172":65763,"_28020":65661,"_19450":110942,"_5":13408,"_26522":110678,"_2670":110850},[],{"_3172":65764,"_28020":65661,"_19450":110944,"_5":13408,"_26522":110678,"_2670":110945},[],"URL HTTP del Device Manager de Lamassu.",{"_3172":65765,"_28020":65661,"_19450":110947,"_5":13408,"_26522":110678,"_2670":49627},[],{"_3172":65766,"_28020":65661,"_19450":110949,"_5":13408,"_26522":110678,"_2670":23284},[],{"_3172":65767,"_28020":65661,"_19450":110951,"_5":13408,"_26522":110678,"_2670":110850},[],{"_3172":65768,"_28020":65661,"_19450":110953,"_5":13408,"_26522":110678,"_2670":110954},[],"URL HTTP del servicio de CA de Lamassu.",{"_3172":65769,"_28020":65661,"_19450":110956,"_5":13408,"_26522":110682,"_2670":110957},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3172":65770,"_28020":65661,"_19450":110959,"_5":13408,"_26522":110686,"_2670":110960},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3172":65771,"_28020":65661,"_19450":110962,"_5":13408,"_26522":110686,"_2670":110963},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3172":65772,"_28020":65661,"_19450":110965,"_5":13408,"_26522":110690,"_2670":110966},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3172":65773,"_28020":65661,"_19450":110968,"_5":13408,"_26522":110690,"_2670":110969},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3172":65774,"_28020":65661,"_19450":110971,"_5":13408,"_26522":110690,"_2670":110972},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3172":65775,"_28020":65661,"_19450":110974,"_5":13408,"_26522":110690,"_2670":110975},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3172":65776,"_28020":65661,"_19450":110977,"_5":13408,"_26522":110690,"_2670":110978},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3172":65777,"_28020":65661,"_19450":110980,"_5":13408,"_26522":110690,"_2670":110981},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3172":65778,"_28020":65661,"_19450":110983,"_5":13408,"_26522":110693,"_2670":110984},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3172":65779,"_28020":65661,"_19450":110986,"_5":13408,"_26522":110696,"_2670":110987},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3172":65780,"_28020":65661,"_19450":110989,"_5":13408,"_26522":110696,"_2670":110990},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3172":65781,"_28020":65661,"_19450":110992,"_5":13408,"_26522":110700,"_2670":110993},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3172":65782,"_28020":65661,"_19450":110995,"_5":13408,"_26522":110704,"_2670":110996},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3172":65783,"_28020":65661,"_19450":110998,"_5":13408,"_26522":110704,"_2670":110999},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3172":65784,"_28020":65661,"_19450":111001,"_5":13408,"_26522":110704,"_2670":111002},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3172":65785,"_28020":65661,"_19450":111004,"_5":13408,"_26522":110704,"_2670":111005},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3172":65786,"_28020":65661,"_19450":111007,"_5":13408,"_26522":110704,"_2670":111008},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3172":65787,"_28020":65661,"_19450":111010,"_5":13408,"_26522":110704,"_2670":111011},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3172":65788,"_28020":65661,"_19450":111013,"_5":13408,"_26522":110708,"_2670":111014},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3172":65789,"_28020":65661,"_19450":111016,"_5":13408,"_26522":110708,"_2670":111017},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3172":65790,"_28020":65661,"_19450":111019,"_5":13408,"_26522":110708,"_2670":111020},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3172":65791,"_28020":65661,"_19450":111022,"_5":13408,"_26522":110712,"_2670":111023},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3172":65792,"_28020":65661,"_19450":111025,"_5":13408,"_26522":110712,"_2670":111026},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3172":65793,"_28020":65661,"_19450":111028,"_5":13408,"_26522":110712,"_2670":111029},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3172":65794,"_28020":65661,"_19450":111031,"_5":13408,"_26522":110716,"_2670":111032},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3172":65795,"_28020":65661,"_19450":111034,"_5":13408,"_26522":110716,"_2670":111035},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3172":65796,"_28020":65661,"_19450":111037,"_5":13408,"_26522":110716,"_2670":111038},[],"Para que el flujo JITP funcione correctamente:",{"_3172":65797,"_28020":65661,"_19450":111040,"_5":13408,"_26522":110716,"_2670":111041},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3172":65798,"_28020":65661,"_19450":111043,"_5":13408,"_26522":110716,"_2670":111044},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3172":65799,"_28020":65661,"_19450":111046,"_5":13408,"_26522":110716,"_2670":111047},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3172":65800,"_28020":65661,"_19450":111049,"_5":13408,"_26522":110716,"_2670":111050},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3172":65801,"_28020":65661,"_19450":111052,"_5":13408,"_26522":110720,"_2670":111053},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3172":65802,"_28020":65661,"_19450":111055,"_5":13408,"_26522":110720,"_2670":111056},[],"Estado en Lamassu",{"_3172":65803,"_28020":65661,"_19450":111058,"_5":13408,"_26522":110720,"_2670":111059},[],"Razón de revocación",{"_3172":65804,"_28020":65661,"_19450":111061,"_5":13408,"_26522":110720,"_2670":111062},[],"Estado en AWS IoT Core",{"_3172":65805,"_28020":65661,"_19450":111064,"_5":13408,"_26522":110720,"_2670":49748},[],{"_3172":65806,"_28020":65661,"_19450":111066,"_5":13408,"_26522":110720,"_2670":111067},[],"Ninguna",{"_3172":65807,"_28020":65661,"_19450":111069,"_5":13408,"_26522":110720,"_2670":49754},[],{"_3172":65808,"_28020":65661,"_19450":111071,"_5":13408,"_26522":110720,"_2670":49757},[],{"_3172":65809,"_28020":65661,"_19450":111073,"_5":13408,"_26522":110720,"_2670":49760},[],{"_3172":65810,"_28020":65661,"_19450":111075,"_5":13408,"_26522":110720,"_2670":49763},[],{"_3172":65811,"_28020":65661,"_19450":111077,"_5":13408,"_26522":110720,"_2670":49757},[],{"_3172":65812,"_28020":65661,"_19450":111079,"_5":13408,"_26522":110720,"_2670":111080},[],"Cualquier otra razón",{"_3172":65813,"_28020":65661,"_19450":111082,"_5":13408,"_26522":110720,"_2670":49771},[],{"_3172":65814,"_28020":65661,"_19450":111084,"_5":13408,"_26522":110720,"_2670":111085},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3172":65815,"_28020":65661,"_19450":111087,"_5":13408,"_26522":110724,"_2670":111088},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3172":65816,"_28020":65661,"_19450":111090,"_5":13408,"_26522":110724,"_2670":111091},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3172":65817,"_28020":65661,"_19450":111093,"_5":13408,"_26522":110724,"_2670":111094},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3172":65818,"_28020":65661,"_19450":111096,"_5":13408,"_26522":110728,"_2670":111097},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3172":65819,"_28020":65661,"_19450":111099,"_5":13408,"_26522":110728,"_2670":111100},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3172":65820,"_28020":65661,"_19450":111102,"_5":13408,"_26522":110732,"_2670":111103},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3172":65821,"_28020":65661,"_19450":111105,"_5":13408,"_26522":110732,"_2670":111106},[],"Existen dos tipos de acciones:",{"_3172":65822,"_28020":65661,"_19450":111108,"_5":13408,"_26522":110732,"_2670":111109},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3172":65823,"_28020":65661,"_19450":111111,"_5":13408,"_26522":110732,"_2670":111112},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3172":65824,"_28020":65661,"_19450":111114,"_5":13408,"_26522":110732,"_2670":111115},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3172":65825,"_28020":65661,"_19450":111117,"_5":13408,"_26522":110736,"_2670":111118},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3172":65826,"_28020":65661,"_19450":111120,"_5":13408,"_26522":110736,"_2670":111121},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3172":65827,"_28020":65661,"_19450":111123,"_5":13408,"_26522":110736,"_2670":111124},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3172":65828,"_28020":65661,"_19450":111126,"_5":13408,"_26522":110740,"_2670":111127},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3172":65829,"_28020":65661,"_19450":111129,"_5":13408,"_26522":110740,"_2670":111130},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3172":65830,"_28020":65661,"_19450":111132,"_5":13408,"_26522":110740,"_2670":111133},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3172":65831,"_28020":65661,"_19450":111135,"_5":13408,"_26522":110740,"_2670":111136},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3172":65832,"_28020":65661,"_19450":111138,"_5":13408,"_26522":110740,"_2670":111139},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3172":65833,"_28020":65661,"_19450":111141,"_5":13408,"_26522":110740,"_2670":111142},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3172":65834,"_28020":65661,"_19450":111144,"_5":13408,"_26522":110740,"_2670":111145},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3172":65835,"_28020":65661,"_19450":111147,"_5":13408,"_26522":110740,"_2670":111148},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3172":65836,"_28020":65661,"_19450":111150,"_5":13408,"_26522":110740,"_2670":111151},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3172":65837,"_28020":65661,"_19450":111153,"_5":13408,"_26522":110740,"_2670":111154},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3172":65838,"_28020":65661,"_19450":111156,"_5":13408,"_26522":110740,"_2670":111157},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3172":65839,"_28020":65661,"_19450":111159,"_5":13408,"_26522":110740,"_2670":111160},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3172":65840,"_28020":65661,"_19450":111162,"_5":13408,"_26522":110740,"_2670":111163},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3172":65841,"_28020":65661,"_19450":111165,"_5":13408,"_26522":110740,"_2670":111166},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3172":65842,"_28020":65661,"_19450":111168,"_5":13408,"_26522":110740,"_2670":111169},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3172":65843,"_28020":65661,"_19450":111171,"_5":13408,"_26522":110740,"_2670":111172},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3172":65844,"_28020":65661,"_19450":111174,"_5":13408,"_26522":110740,"_2670":111175},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3172":65845,"_28020":65661,"_19450":111177,"_5":13408,"_26522":110740,"_2670":111178},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3172":65846,"_28020":65661,"_19450":111180,"_5":13408,"_26522":110740,"_2670":111181},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3172":65847,"_28020":65661,"_19450":111183,"_5":13408,"_26522":110740,"_2670":111184},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3172":65848,"_28020":65661,"_19450":111186,"_5":13408,"_26522":110740,"_2670":111187},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3172":65849,"_28020":65849,"_5":13734,"_2670":47857,"_28372":111189,"_19450":111190,"_26522":65849},[45500,108282,47857],[],{"_3172":65850,"_28020":65849,"_19450":111192,"_5":13408,"_26522":65849,"_2670":111193},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3172":65851,"_28020":65849,"_5":28369,"_19450":111195,"_26522":111196,"_2670":111197},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3172":65852,"_28020":65849,"_5":28369,"_19450":111199,"_26522":111200,"_2670":109257},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3172":65853,"_28020":65849,"_5":28369,"_19450":111202,"_26522":111203,"_2670":109432},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3172":65854,"_28020":65849,"_5":28369,"_19450":111205,"_26522":111206,"_2670":110659},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/overview#integraciones",{"_3172":65855,"_28020":65849,"_5":28369,"_19450":111208,"_26522":111209,"_2670":111210},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3172":65856,"_28020":65849,"_19450":111212,"_5":13408,"_26522":65849,"_2670":111213},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3172":65857,"_28020":65849,"_19450":111215,"_5":13408,"_26522":111196,"_2670":111216},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3172":65858,"_28020":65849,"_19450":111218,"_5":13408,"_26522":111196,"_2670":111219},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3172":65859,"_28020":65849,"_19450":111221,"_5":13408,"_26522":111200,"_2670":111222},[],"Recurso",{"_3172":65860,"_28020":65849,"_19450":111224,"_5":13408,"_26522":111200,"_2670":111225},[],"Qué representa",{"_3172":65861,"_28020":65849,"_19450":111227,"_5":13408,"_26522":111200,"_2670":111228},[],"**Dispositivo**",{"_3172":65862,"_28020":65849,"_19450":111230,"_5":13408,"_26522":111200,"_2670":111231},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3172":65863,"_28020":65849,"_19450":111233,"_5":13408,"_26522":111200,"_2670":111234},[],"**Identidad**",{"_3172":65864,"_28020":65849,"_19450":111236,"_5":13408,"_26522":111200,"_2670":111237},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3172":65865,"_28020":65849,"_19450":111239,"_5":13408,"_26522":111200,"_2670":49929},[],{"_3172":65866,"_28020":65849,"_19450":111241,"_5":13408,"_26522":111200,"_2670":111242},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3172":65867,"_28020":65849,"_19450":111244,"_5":13408,"_26522":111200,"_2670":111245},[],"**Flota**",{"_3172":65868,"_28020":65849,"_19450":111247,"_5":13408,"_26522":111200,"_2670":111248},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3172":65869,"_28020":65849,"_19450":111250,"_5":13408,"_26522":111200,"_2670":111251},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3172":65870,"_28020":65849,"_19450":111253,"_5":13408,"_26522":111200,"_2670":111254},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3172":65871,"_28020":65849,"_19450":111256,"_5":13408,"_26522":111203,"_2670":111257},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3172":65872,"_28020":65849,"_19450":111259,"_5":13408,"_26522":111203,"_2670":111260},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3172":65873,"_28020":65849,"_19450":111262,"_5":13408,"_26522":111203,"_2670":111263},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3172":65874,"_28020":65849,"_19450":111265,"_5":13408,"_26522":111203,"_2670":111266},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3172":65875,"_28020":65849,"_19450":111268,"_5":13408,"_26522":111203,"_2670":111269},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3172":65876,"_28020":65849,"_19450":111271,"_5":13408,"_26522":111203,"_2670":111272},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3172":65877,"_28020":65849,"_19450":111274,"_5":13408,"_26522":111203,"_2670":111275},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3172":65878,"_28020":65849,"_19450":111277,"_5":13408,"_26522":111203,"_2670":111278},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3172":65879,"_28020":65849,"_19450":111280,"_5":13408,"_26522":111206,"_2670":111281},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3172":65880,"_28020":65849,"_19450":111283,"_5":13408,"_26522":111206,"_2670":111284},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3172":65881,"_28020":65849,"_19450":111286,"_5":13408,"_26522":111209,"_2670":111287},[],"Participante",{"_3172":65882,"_28020":65849,"_19450":111289,"_5":13408,"_26522":111209,"_2670":111290},[],"Responsabilidad",{"_3172":65883,"_28020":65849,"_19450":111292,"_5":13408,"_26522":111209,"_2670":111293},[],"Administrador PKI",{"_3172":65884,"_28020":65849,"_19450":111295,"_5":13408,"_26522":111209,"_2670":111296},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3172":65885,"_28020":65849,"_19450":111298,"_5":13408,"_26522":111209,"_2670":111299},[],"Administrador del aprovisionamiento",{"_3172":65886,"_28020":65849,"_19450":111301,"_5":13408,"_26522":111209,"_2670":111302},[],"DMS, admisión, autenticación por operación e inventario.",{"_3172":65887,"_28020":65849,"_19450":111304,"_5":13408,"_26522":111209,"_2670":111305},[],"Integrador del dispositivo",{"_3172":65888,"_28020":65849,"_19450":111307,"_5":13408,"_26522":111209,"_2670":111308},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3172":65889,"_28020":65849,"_19450":111310,"_5":13408,"_26522":111209,"_2670":111311},[],"Integrador del consumidor",{"_3172":65890,"_28020":65849,"_19450":111313,"_5":13408,"_26522":111209,"_2670":111314},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3172":65891,"_28020":65849,"_19450":111316,"_5":13408,"_26522":111209,"_2670":111317},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3172":65892,"_28020":65892,"_5":13734,"_2670":111319,"_28372":111320,"_19450":111322,"_26522":65892},"Enrola y conecta tu primer dispositivo",[45500,108282,47857,111321],"Primeros pasos",[],{"_3172":65893,"_28020":65892,"_19450":111324,"_5":13408,"_26522":65892,"_2670":111325},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3172":65894,"_28020":65892,"_5":28369,"_19450":111327,"_26522":111328,"_2670":106948},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3172":65895,"_28020":65892,"_5":28369,"_19450":111330,"_26522":111331,"_2670":111332},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3172":65896,"_28020":65892,"_5":28369,"_19450":111334,"_26522":111335,"_2670":111336},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3172":65897,"_28020":65892,"_5":28369,"_19450":111338,"_26522":111339,"_2670":111340},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3172":65898,"_28020":65892,"_5":28369,"_19450":111342,"_26522":111343,"_2670":111344},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3172":65899,"_28020":65892,"_5":28369,"_19450":111346,"_26522":111347,"_2670":111348},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3172":65900,"_28020":65892,"_5":28369,"_19450":111350,"_26522":111351,"_2670":111352},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3172":65901,"_28020":65892,"_5":28369,"_19450":111354,"_26522":111355,"_2670":111356},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3172":65902,"_28020":65892,"_19450":111358,"_5":13408,"_26522":65892,"_2670":111359},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3172":65903,"_28020":65892,"_19450":111361,"_5":13408,"_26522":111328,"_2670":111362},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3172":65904,"_28020":65892,"_19450":111364,"_5":13408,"_26522":111328,"_2670":111365},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3172":65905,"_28020":65892,"_19450":111367,"_5":13408,"_26522":111328,"_2670":111368},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3172":65906,"_28020":65892,"_19450":111370,"_5":13408,"_26522":111328,"_2670":111371},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3172":65907,"_28020":65892,"_19450":111373,"_5":13408,"_26522":111328,"_2670":111374},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3172":65908,"_28020":65892,"_19450":111376,"_5":13408,"_26522":111331,"_2670":111377},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3172":65909,"_28020":65892,"_19450":111379,"_5":13408,"_26522":111331,"_2670":111380},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3172":65910,"_28020":65892,"_19450":111382,"_5":13408,"_26522":111335,"_2670":111383},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3172":65911,"_28020":65892,"_19450":111385,"_5":13408,"_26522":111335,"_2670":111386},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3172":65912,"_28020":65892,"_19450":111388,"_5":13408,"_26522":111335,"_2670":111389},[],"Ajuste",{"_3172":65913,"_28020":65892,"_19450":111391,"_5":13408,"_26522":111335,"_2670":111392},[],"Valor de evaluación",{"_3172":65914,"_28020":65892,"_19450":111394,"_5":13408,"_26522":111335,"_2670":50085},[],{"_3172":65915,"_28020":65892,"_19450":111396,"_5":13408,"_26522":111335,"_2670":111397},[],"Raíz emisora de `device-root.pem`.",{"_3172":65916,"_28020":65892,"_19450":111399,"_5":13408,"_26522":111335,"_2670":109560},[],{"_3172":65917,"_28020":65892,"_19450":111401,"_5":13408,"_26522":111335,"_2670":111402},[],"Perfil final de 1 hora que acabas de preparar.",{"_3172":65918,"_28020":65892,"_19450":111404,"_5":13408,"_26522":111335,"_2670":50096},[],{"_3172":65919,"_28020":65892,"_19450":111406,"_5":13408,"_26522":111335,"_2670":50099},[],{"_3172":65920,"_28020":65892,"_19450":111408,"_5":13408,"_26522":111335,"_2670":50102},[],{"_3172":65921,"_28020":65892,"_19450":111410,"_5":13408,"_26522":111335,"_2670":111411},[],"Habilitado.",{"_3172":65922,"_28020":65892,"_19450":111413,"_5":13408,"_26522":111335,"_2670":50108},[],{"_3172":65923,"_28020":65892,"_19450":111415,"_5":13408,"_26522":111335,"_2670":111416},[],"Deshabilitado; el ID debe ser nuevo.",{"_3172":65924,"_28020":65892,"_19450":111418,"_5":13408,"_26522":111335,"_2670":111419},[],"Autenticación inicial",{"_3172":65925,"_28020":65892,"_19450":111421,"_5":13408,"_26522":111335,"_2670":111422},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3172":65926,"_28020":65892,"_19450":111424,"_5":13408,"_26522":111335,"_2670":111425},[],"Autenticación de renovación",{"_3172":65927,"_28020":65892,"_19450":111427,"_5":13408,"_26522":111335,"_2670":111428},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3172":65928,"_28020":65892,"_19450":111430,"_5":13408,"_26522":111335,"_2670":50126},[],{"_3172":65929,"_28020":65892,"_19450":111432,"_5":13408,"_26522":111335,"_2670":111433},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3172":65930,"_28020":65892,"_19450":111435,"_5":13408,"_26522":111335,"_2670":50132},[],{"_3172":65931,"_28020":65892,"_19450":111437,"_5":13408,"_26522":111335,"_2670":111438},[],"1 hora.",{"_3172":65932,"_28020":65892,"_19450":111440,"_5":13408,"_26522":111335,"_2670":50138},[],{"_3172":65933,"_28020":65892,"_19450":111442,"_5":13408,"_26522":111335,"_2670":111443},[],"30 minutos / 10 minutos.",{"_3172":65934,"_28020":65892,"_19450":111445,"_5":13408,"_26522":111335,"_2670":50144},[],{"_3172":65935,"_28020":65892,"_19450":111447,"_5":13408,"_26522":111335,"_2670":111448},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3172":65936,"_28020":65892,"_19450":111450,"_5":13408,"_26522":111335,"_2670":48176},[],{"_3172":65937,"_28020":65892,"_19450":111452,"_5":13408,"_26522":111335,"_2670":111453},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3172":65938,"_28020":65892,"_19450":111455,"_5":13408,"_26522":111335,"_2670":50155},[],{"_3172":65939,"_28020":65892,"_19450":111457,"_5":13408,"_26522":111335,"_2670":111458},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3172":65940,"_28020":65892,"_19450":111460,"_5":13408,"_26522":111335,"_2670":111461},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_3172":65941,"_28020":65892,"_19450":111463,"_5":13408,"_26522":111339,"_2670":111464},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3172":65942,"_28020":65892,"_19450":111466,"_5":13408,"_26522":111339,"_2670":111467},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3172":65943,"_28020":65892,"_19450":111469,"_5":13408,"_26522":111343,"_2670":111470},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3172":65944,"_28020":65892,"_19450":111472,"_5":13408,"_26522":111343,"_2670":111473},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3172":65945,"_28020":65892,"_19450":111475,"_5":13408,"_26522":111343,"_2670":111476},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3172":65946,"_28020":65892,"_19450":111478,"_5":13408,"_26522":111347,"_2670":111479},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3172":65947,"_28020":65892,"_19450":111481,"_5":13408,"_26522":111347,"_2670":111482},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3172":65948,"_28020":65892,"_19450":111484,"_5":13408,"_26522":111351,"_2670":111485},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3172":65949,"_28020":65892,"_19450":111487,"_5":13408,"_26522":111351,"_2670":111488},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3172":65950,"_28020":65892,"_19450":111490,"_5":13408,"_26522":111351,"_2670":111491},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3172":65951,"_28020":65892,"_19450":111493,"_5":13408,"_26522":111351,"_2670":111494},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3172":65952,"_28020":65892,"_19450":111496,"_5":13408,"_26522":111351,"_2670":111497},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3172":65953,"_28020":65892,"_19450":111499,"_5":13408,"_26522":111355,"_2670":111500},[],"Comprobación",{"_3172":65954,"_28020":65892,"_19450":111502,"_5":13408,"_26522":111355,"_2670":111503},[],"Resultado esperado",{"_3172":65955,"_28020":65892,"_19450":111505,"_5":13408,"_26522":111355,"_2670":111506},[],"Registro",{"_3172":65956,"_28020":65892,"_19450":111508,"_5":13408,"_26522":111355,"_2670":111509},[],"ID creado automáticamente y DMS correcto.",{"_3172":65957,"_28020":65892,"_19450":111511,"_5":13408,"_26522":111355,"_2670":111512},[],"Certificado",{"_3172":65958,"_28020":65892,"_19450":111514,"_5":13408,"_26522":111355,"_2670":111515},[],"CN, perfil, serie y clave verificados.",{"_3172":65959,"_28020":65892,"_19450":111517,"_5":13408,"_26522":111355,"_2670":111518},[],"Inventario",{"_3172":65960,"_28020":65892,"_19450":111520,"_5":13408,"_26522":111355,"_2670":111521},[],"Serie recibida visible como identidad actual y en el historial.",{"_3172":65961,"_28020":65892,"_19450":111523,"_5":13408,"_26522":111355,"_2670":111524},[],"Consumidor",{"_3172":65962,"_28020":65892,"_19450":111526,"_5":13408,"_26522":111355,"_2670":111527},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3172":65963,"_28020":65892,"_19450":111529,"_5":13408,"_26522":111355,"_2670":111530},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3172":65964,"_28020":65892,"_19450":111532,"_5":13408,"_26522":111355,"_2670":111533},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3172":65965,"_28020":65965,"_5":13734,"_2670":109274,"_28372":111535,"_19450":111536,"_26522":65965},[45500,108282,47857,111321],[],{"_3172":65966,"_28020":65965,"_19450":111538,"_5":13408,"_26522":65965,"_2670":111539},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3172":65967,"_28020":65965,"_5":28369,"_19450":111541,"_26522":111542,"_2670":106948},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3172":65968,"_28020":65965,"_5":28369,"_19450":111544,"_26522":111545,"_2670":111546},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3172":65969,"_28020":65965,"_5":28369,"_19450":111548,"_26522":111549,"_2670":111550},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3172":65970,"_28020":65965,"_5":28369,"_19450":111552,"_26522":111553,"_2670":111554},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3172":65971,"_28020":65965,"_5":28369,"_19450":111556,"_26522":111557,"_2670":111558},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3172":65972,"_28020":65965,"_5":28369,"_19450":111560,"_26522":111561,"_2670":111562},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3172":65973,"_28020":65965,"_5":28369,"_19450":111564,"_26522":111565,"_2670":111503},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3172":65974,"_28020":65965,"_5":28369,"_19450":111567,"_26522":111568,"_2670":111569},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3172":65975,"_28020":65965,"_5":28369,"_19450":111571,"_26522":111572,"_2670":111573},[],"/docs/pr-preview/pr-51/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3172":65976,"_28020":65965,"_19450":111575,"_5":13408,"_26522":65965,"_2670":111576},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3172":65977,"_28020":65965,"_19450":111578,"_5":13408,"_26522":65965,"_2670":111579},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3172":65978,"_28020":65965,"_19450":111581,"_5":13408,"_26522":111542,"_2670":111582},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3172":65979,"_28020":65965,"_19450":111584,"_5":13408,"_26522":111542,"_2670":111585},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3172":65980,"_28020":65965,"_19450":111587,"_5":13408,"_26522":111542,"_2670":111588},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3172":65981,"_28020":65965,"_19450":111590,"_5":13408,"_26522":111542,"_2670":111591},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3172":65982,"_28020":65965,"_19450":111593,"_5":13408,"_26522":111545,"_2670":111594},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3172":65983,"_28020":65965,"_19450":111596,"_5":13408,"_26522":111545,"_2670":111597},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3172":65984,"_28020":65965,"_19450":111599,"_5":13408,"_26522":111545,"_2670":111600},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3172":65985,"_28020":65965,"_19450":111602,"_5":13408,"_26522":111545,"_2670":111603},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3172":65986,"_28020":65965,"_19450":111605,"_5":13408,"_26522":111545,"_2670":111606},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3172":65987,"_28020":65965,"_19450":111608,"_5":13408,"_26522":111545,"_2670":111609},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3172":65988,"_28020":65965,"_19450":111611,"_5":13408,"_26522":111545,"_2670":111612},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3172":65989,"_28020":65965,"_19450":111614,"_5":13408,"_26522":111545,"_2670":111615},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3172":65990,"_28020":65965,"_19450":111617,"_5":13408,"_26522":111549,"_2670":111618},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3172":65991,"_28020":65965,"_19450":111620,"_5":13408,"_26522":111549,"_2670":50321},[],{"_3172":65992,"_28020":65965,"_19450":111622,"_5":13408,"_26522":111549,"_2670":111623},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3172":65993,"_28020":65965,"_19450":111625,"_5":13408,"_26522":111549,"_2670":111626},[],"**Icon** y **Tags**: clasificación opcional.",{"_3172":65994,"_28020":65965,"_19450":111628,"_5":13408,"_26522":111549,"_2670":111629},[],"Confirma el registro.",{"_3172":65995,"_28020":65965,"_19450":111631,"_5":13408,"_26522":111553,"_2670":111632},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3172":65996,"_28020":65965,"_19450":111634,"_5":13408,"_26522":111553,"_2670":111635},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3172":65997,"_28020":65965,"_19450":111637,"_5":13408,"_26522":111557,"_2670":111638},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3172":65998,"_28020":65965,"_19450":111640,"_5":13408,"_26522":111557,"_2670":111641},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3172":65999,"_28020":65965,"_19450":111643,"_5":13408,"_26522":111561,"_2670":111644},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3172":66000,"_28020":65965,"_19450":111646,"_5":13408,"_26522":111561,"_2670":111647},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3172":66001,"_28020":65965,"_19450":111649,"_5":13408,"_26522":111565,"_2670":111500},[],{"_3172":66002,"_28020":65965,"_19450":111651,"_5":13408,"_26522":111565,"_2670":111652},[],"Resultado",{"_3172":66003,"_28020":65965,"_19450":111654,"_5":13408,"_26522":111565,"_2670":111655},[],"Dispositivo",{"_3172":66004,"_28020":65965,"_19450":111657,"_5":13408,"_26522":111565,"_2670":111658},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3172":66005,"_28020":65965,"_19450":111660,"_5":13408,"_26522":111565,"_2670":111661},[],"Identidad actual",{"_3172":66006,"_28020":65965,"_19450":111663,"_5":13408,"_26522":111565,"_2670":111664},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3172":66007,"_28020":65965,"_19450":111666,"_5":13408,"_26522":111565,"_2670":111667},[],"Historial",{"_3172":66008,"_28020":65965,"_19450":111669,"_5":13408,"_26522":111565,"_2670":111670},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3172":66009,"_28020":65965,"_19450":111672,"_5":13408,"_26522":111565,"_2670":111673},[],"Clave y certificado",{"_3172":66010,"_28020":65965,"_19450":111675,"_5":13408,"_26522":111565,"_2670":111676},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3172":66011,"_28020":65965,"_19450":111678,"_5":13408,"_26522":111568,"_2670":111679},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3172":66012,"_28020":65965,"_19450":111681,"_5":13408,"_26522":111568,"_2670":111682},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3172":66013,"_28020":65965,"_19450":111684,"_5":13408,"_26522":111568,"_2670":111685},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3172":66014,"_28020":65965,"_19450":111687,"_5":13408,"_26522":111568,"_2670":111688},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3172":66015,"_28020":65965,"_19450":111690,"_5":13408,"_26522":111572,"_2670":111691},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3172":66016,"_28020":65965,"_19450":111693,"_5":13408,"_26522":111572,"_2670":111694},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3172":66017,"_28020":65965,"_19450":111696,"_5":13408,"_26522":111572,"_2670":111697},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3172":66018,"_28020":66018,"_5":13734,"_2670":111699,"_28372":111700,"_19450":111701,"_26522":66018},"Plataforma Lamassu IoT",[45500,108282],[],{"_3172":66019,"_28020":66018,"_19450":111703,"_5":13408,"_26522":66018,"_2670":111704},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3172":66020,"_28020":66018,"_5":28369,"_19450":111706,"_26522":111707,"_2670":111197},[],"/docs/pr-preview/pr-51/es/platform/overview#empieza-aquí",{"_3172":66021,"_28020":66018,"_5":28369,"_19450":111709,"_26522":111710,"_2670":111711},[],"/docs/pr-preview/pr-51/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3172":66022,"_28020":66018,"_5":28369,"_19450":111713,"_26522":111714,"_2670":111715},[],"/docs/pr-preview/pr-51/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3172":66023,"_28020":66018,"_5":28369,"_19450":111717,"_26522":111718,"_2670":111719},[],"/docs/pr-preview/pr-51/es/platform/overview#capacidades-principales","Capacidades principales",{"_3172":66024,"_28020":66018,"_5":28369,"_19450":111721,"_26522":111722,"_2670":111723},[],"/docs/pr-preview/pr-51/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3172":66025,"_28020":66018,"_5":28369,"_19450":111725,"_26522":111726,"_2670":111727},[],"/docs/pr-preview/pr-51/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3172":66026,"_28020":66018,"_5":28369,"_19450":111729,"_26522":111730,"_2670":111731},[],"/docs/pr-preview/pr-51/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3172":66027,"_28020":66018,"_5":28369,"_19450":111733,"_26522":111734,"_2670":111735},[],"/docs/pr-preview/pr-51/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3172":66028,"_28020":66018,"_5":28369,"_19450":111737,"_26522":111738,"_2670":111739},[],"/docs/pr-preview/pr-51/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3172":66029,"_28020":66018,"_5":28369,"_19450":111741,"_26522":111742,"_2670":111743},[],"/docs/pr-preview/pr-51/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3172":66030,"_28020":66018,"_5":28369,"_19450":111745,"_26522":111746,"_2670":111747},[],"/docs/pr-preview/pr-51/es/platform/overview#referencia-operativa","Referencia operativa",{"_3172":66031,"_28020":66018,"_19450":111749,"_5":13408,"_26522":66018,"_2670":111750},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3172":66032,"_28020":66018,"_19450":111752,"_5":13408,"_26522":111707,"_2670":111753},[],"Elige el resultado que necesitas obtener:",{"_3172":66033,"_28020":66018,"_19450":111755,"_5":13408,"_26522":111707,"_2670":111756},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3172":66034,"_28020":66018,"_19450":111758,"_5":13408,"_26522":111707,"_2670":111759},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3172":66035,"_28020":66018,"_19450":111761,"_5":13408,"_26522":111707,"_2670":111762},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3172":66036,"_28020":66018,"_19450":111764,"_5":13408,"_26522":111710,"_2670":111765},[],"Bloque",{"_3172":66037,"_28020":66018,"_19450":111767,"_5":13408,"_26522":111710,"_2670":111768},[],"Qué gestionas",{"_3172":66038,"_28020":66018,"_19450":111770,"_5":13408,"_26522":111710,"_2670":111771},[],"Punto de entrada",{"_3172":66039,"_28020":66018,"_19450":111773,"_5":13408,"_26522":111710,"_2670":50475},[],{"_3172":66040,"_28020":66018,"_19450":111775,"_5":13408,"_26522":111710,"_2670":111776},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3172":66041,"_28020":66018,"_19450":111778,"_5":13408,"_26522":111710,"_2670":111779},[],"Visión general de PKI",{"_3172":66042,"_28020":66018,"_19450":111781,"_5":13408,"_26522":111710,"_2670":50484},[],{"_3172":66043,"_28020":66018,"_19450":111783,"_5":13408,"_26522":111710,"_2670":111784},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3172":66044,"_28020":66018,"_19450":111786,"_5":13408,"_26522":111710,"_2670":111787},[],"Visión general de IoT Fleets",{"_3172":66045,"_28020":66018,"_19450":111789,"_5":13408,"_26522":111710,"_2670":111790},[],"**Administración**",{"_3172":66046,"_28020":66018,"_19450":111792,"_5":13408,"_26522":111710,"_2670":111793},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3172":66047,"_28020":66018,"_19450":111795,"_5":13408,"_26522":111710,"_2670":108280},[],{"_3172":66048,"_28020":66018,"_19450":111797,"_5":13408,"_26522":111710,"_2670":111798},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3172":66049,"_28020":66018,"_19450":111800,"_5":13408,"_26522":111714,"_2670":111801},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3172":66050,"_28020":66018,"_19450":111803,"_5":13408,"_26522":111714,"_2670":111804},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3172":66051,"_28020":66018,"_19450":111806,"_5":13408,"_26522":111714,"_2670":111807},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3172":66052,"_28020":66018,"_19450":111809,"_5":13408,"_26522":111714,"_2670":111810},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3172":66053,"_28020":66018,"_19450":111812,"_5":13408,"_26522":111714,"_2670":111813},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3172":66054,"_28020":66018,"_19450":111815,"_5":13408,"_26522":111714,"_2670":111816},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3172":66055,"_28020":66018,"_19450":111818,"_5":13408,"_26522":111722,"_2670":111819},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3172":66056,"_28020":66018,"_19450":111821,"_5":13408,"_26522":111726,"_2670":111822},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3172":66057,"_28020":66018,"_19450":111824,"_5":13408,"_26522":111730,"_2670":111825},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3172":66058,"_28020":66018,"_19450":111827,"_5":13408,"_26522":111734,"_2670":111828},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3172":66059,"_28020":66018,"_19450":111830,"_5":13408,"_26522":111738,"_2670":111831},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3172":66060,"_28020":66018,"_19450":111833,"_5":13408,"_26522":111742,"_2670":111834},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3172":66061,"_28020":66018,"_19450":111836,"_5":13408,"_26522":111746,"_2670":111290},[],{"_3172":66062,"_28020":66018,"_19450":111838,"_5":13408,"_26522":111746,"_2670":111839},[],"Qué prepara o comprueba",{"_3172":66063,"_28020":66018,"_19450":111841,"_5":13408,"_26522":111746,"_2670":111293},[],{"_3172":66064,"_28020":66018,"_19450":111843,"_5":13408,"_26522":111746,"_2670":111844},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3172":66065,"_28020":66018,"_19450":111846,"_5":13408,"_26522":111746,"_2670":111847},[],"Administrador de la flota",{"_3172":66066,"_28020":66018,"_19450":111849,"_5":13408,"_26522":111746,"_2670":111850},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3172":66067,"_28020":66018,"_19450":111852,"_5":13408,"_26522":111746,"_2670":111305},[],{"_3172":66068,"_28020":66018,"_19450":111854,"_5":13408,"_26522":111746,"_2670":111855},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3172":66069,"_28020":66018,"_19450":111857,"_5":13408,"_26522":111746,"_2670":111311},[],{"_3172":66070,"_28020":66018,"_19450":111859,"_5":13408,"_26522":111746,"_2670":111860},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3172":66071,"_28020":66018,"_19450":111862,"_5":13408,"_26522":111746,"_2670":111863},[],"Operador de infraestructura",{"_3172":66072,"_28020":66018,"_19450":111865,"_5":13408,"_26522":111746,"_2670":111866},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3172":66073,"_28020":66018,"_19450":111868,"_5":13408,"_26522":111746,"_2670":111869},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3172":66074,"_28020":66074,"_5":13734,"_2670":111871,"_28372":111872,"_19450":111874,"_26522":66074},"Jerarquía y rotación de CAs",[45500,108282,50576,111873],"Claves, autoridades y certificados",[],{"_3172":66075,"_28020":66074,"_19450":111876,"_5":13408,"_26522":66074,"_2670":111877},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3172":66076,"_28020":66074,"_5":28369,"_19450":111879,"_26522":111880,"_2670":111881},[],"/docs/pr-preview/pr-51/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3172":66077,"_28020":66074,"_5":28369,"_19450":111883,"_26522":111884,"_2670":111885},[],"/docs/pr-preview/pr-51/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3172":66078,"_28020":66074,"_5":28369,"_19450":111887,"_26522":111888,"_2670":111889},[],"/docs/pr-preview/pr-51/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3172":66079,"_28020":66074,"_5":28369,"_19450":111891,"_26522":111892,"_2670":111893},[],"/docs/pr-preview/pr-51/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3172":66080,"_28020":66074,"_5":28369,"_19450":111895,"_26522":111896,"_2670":111897},[],"/docs/pr-preview/pr-51/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3172":66081,"_28020":66074,"_5":28369,"_19450":111899,"_26522":111900,"_2670":111901},[],"/docs/pr-preview/pr-51/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3172":66082,"_28020":66074,"_5":28369,"_19450":111903,"_26522":111904,"_2670":111905},[],"/docs/pr-preview/pr-51/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3172":66083,"_28020":66074,"_5":28369,"_19450":111907,"_26522":111908,"_2670":111909},[],"/docs/pr-preview/pr-51/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3172":66084,"_28020":66074,"_5":28369,"_19450":111911,"_26522":111912,"_2670":111913},[],"/docs/pr-preview/pr-51/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3172":66085,"_28020":66074,"_5":28369,"_19450":111915,"_26522":111916,"_2670":111917},[],"/docs/pr-preview/pr-51/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3172":66086,"_28020":66074,"_5":28369,"_19450":111919,"_26522":111920,"_2670":111921},[],"/docs/pr-preview/pr-51/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3172":66087,"_28020":66074,"_5":28369,"_19450":111923,"_26522":111924,"_2670":111925},[],"/docs/pr-preview/pr-51/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3172":66088,"_28020":66074,"_19450":111927,"_5":13408,"_26522":66074,"_2670":111928},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3172":66089,"_28020":66074,"_19450":111930,"_5":13408,"_26522":66074,"_2670":111931},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3172":66090,"_28020":66074,"_19450":111933,"_5":13408,"_26522":111880,"_2670":111934},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3172":66091,"_28020":66074,"_19450":111936,"_5":13408,"_26522":111880,"_2670":111937},[],"entorno, como producción y preproducción;",{"_3172":66092,"_28020":66074,"_19450":111939,"_5":13408,"_26522":111880,"_2670":111940},[],"propietario o equipo operador;",{"_3172":66093,"_28020":66074,"_19450":111942,"_5":13408,"_26522":111880,"_2670":111943},[],"familia de dispositivos o proceso de fabricación;",{"_3172":66094,"_28020":66074,"_19450":111945,"_5":13408,"_26522":111880,"_2670":111946},[],"región o requisito regulatorio;",{"_3172":66095,"_28020":66074,"_19450":111948,"_5":13408,"_26522":111880,"_2670":111949},[],"motor criptográfico o política de clave;",{"_3172":66096,"_28020":66074,"_19450":111951,"_5":13408,"_26522":111880,"_2670":111952},[],"ventana de mantenimiento y ritmo de renovación.",{"_3172":66097,"_28020":66074,"_19450":111954,"_5":13408,"_26522":111880,"_2670":111955},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3172":66098,"_28020":66074,"_19450":111957,"_5":13408,"_26522":111880,"_2670":111958},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3172":66099,"_28020":66074,"_19450":111960,"_5":13408,"_26522":111884,"_2670":111961},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3172":66100,"_28020":66074,"_19450":111963,"_5":13408,"_26522":111884,"_2670":111964},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3172":66101,"_28020":66074,"_19450":111966,"_5":13408,"_26522":111884,"_2670":111967},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3172":66102,"_28020":66074,"_19450":111969,"_5":13408,"_26522":111888,"_2670":111970},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3172":66103,"_28020":66074,"_19450":111972,"_5":13408,"_26522":111888,"_2670":111973},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3172":66104,"_28020":66074,"_19450":111975,"_5":13408,"_26522":111888,"_2670":111976},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3172":66105,"_28020":66074,"_19450":111978,"_5":13408,"_26522":111888,"_2670":111979},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3172":66106,"_28020":66074,"_19450":111981,"_5":13408,"_26522":111896,"_2670":111982},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3172":66107,"_28020":66074,"_19450":111984,"_5":13408,"_26522":111900,"_2670":111985},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3172":66108,"_28020":66074,"_19450":111987,"_5":13408,"_26522":111904,"_2670":111988},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3172":66109,"_28020":66074,"_19450":111990,"_5":13408,"_26522":111908,"_2670":111991},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3172":66110,"_28020":66074,"_19450":111993,"_5":13408,"_26522":111912,"_2670":111994},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3172":66111,"_28020":66074,"_19450":111996,"_5":13408,"_26522":111916,"_2670":111997},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3172":66112,"_28020":66074,"_19450":111999,"_5":13408,"_26522":111920,"_2670":112000},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3172":66113,"_28020":66074,"_19450":112002,"_5":13408,"_26522":111920,"_2670":112003},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3172":66114,"_28020":66074,"_19450":112005,"_5":13408,"_26522":111920,"_2670":112006},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3172":66115,"_28020":66074,"_19450":112008,"_5":13408,"_26522":111920,"_2670":112009},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3172":66116,"_28020":66074,"_19450":112011,"_5":13408,"_26522":111924,"_2670":112012},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3172":66117,"_28020":66074,"_19450":112014,"_5":13408,"_26522":111924,"_2670":112015},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3172":66118,"_28020":66074,"_19450":112017,"_5":13408,"_26522":111924,"_2670":112018},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3172":66119,"_28020":66074,"_19450":112020,"_5":13408,"_26522":111924,"_2670":112021},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3172":66120,"_28020":66074,"_19450":112023,"_5":13408,"_26522":111924,"_2670":112024},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3172":66121,"_28020":66074,"_19450":112026,"_5":13408,"_26522":111924,"_2670":112027},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3172":66122,"_28020":66074,"_19450":112029,"_5":13408,"_26522":111924,"_2670":112030},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3172":66123,"_28020":66123,"_5":13734,"_2670":112032,"_28372":112033,"_19450":112034,"_26522":66123},"Autoridades de certificación",[45500,108282,50576,111873],[],{"_3172":66124,"_28020":66123,"_19450":112036,"_5":13408,"_26522":66123,"_2670":112037},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3172":66125,"_28020":66123,"_5":28369,"_19450":112039,"_26522":112040,"_2670":112041},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3172":66126,"_28020":66123,"_5":28369,"_19450":112043,"_26522":112044,"_2670":112045},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3172":66127,"_28020":66123,"_5":28369,"_19450":112047,"_26522":112048,"_2670":106948},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3172":66128,"_28020":66123,"_5":28369,"_19450":112050,"_26522":112051,"_2670":112052},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3172":66129,"_28020":66123,"_5":28369,"_19450":112054,"_26522":112055,"_2670":112056},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3172":66130,"_28020":66123,"_5":28369,"_19450":112058,"_26522":112059,"_2670":112060},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3172":66131,"_28020":66123,"_5":28369,"_19450":112062,"_26522":112063,"_2670":112064},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3172":66132,"_28020":66123,"_5":28369,"_19450":112066,"_26522":112067,"_2670":112068},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3172":66133,"_28020":66123,"_5":28369,"_19450":112070,"_26522":112071,"_2670":112072},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3172":66134,"_28020":66123,"_5":28369,"_19450":112074,"_26522":112075,"_2670":112076},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3172":66135,"_28020":66123,"_5":28369,"_19450":112078,"_26522":112079,"_2670":112080},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3172":66136,"_28020":66123,"_5":28369,"_19450":112082,"_26522":112083,"_2670":112084},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3172":66137,"_28020":66123,"_5":28369,"_19450":112086,"_26522":112087,"_2670":112088},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3172":66138,"_28020":66123,"_5":28369,"_19450":112090,"_26522":112091,"_2670":112092},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3172":66139,"_28020":66123,"_5":28369,"_19450":112094,"_26522":112095,"_2670":112096},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3172":66140,"_28020":66123,"_5":28369,"_19450":112098,"_26522":112099,"_2670":112100},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3172":66141,"_28020":66123,"_5":28369,"_19450":112102,"_26522":112103,"_2670":112104},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3172":66142,"_28020":66123,"_5":28369,"_19450":112106,"_26522":112107,"_2670":112108},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3172":66143,"_28020":66123,"_5":28369,"_19450":112110,"_26522":112111,"_2670":112112},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3172":66144,"_28020":66123,"_5":28369,"_19450":112114,"_26522":112115,"_2670":112116},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3172":66145,"_28020":66123,"_5":28369,"_19450":112118,"_26522":112119,"_2670":112120},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3172":66146,"_28020":66123,"_5":28369,"_19450":112122,"_26522":112123,"_2670":112124},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3172":66147,"_28020":66123,"_19450":112126,"_5":13408,"_26522":66123,"_2670":112127},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3172":66148,"_28020":66123,"_19450":112129,"_5":13408,"_26522":66123,"_2670":112130},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3172":66149,"_28020":66123,"_19450":112132,"_5":13408,"_26522":66123,"_2670":112133},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3172":66150,"_28020":66123,"_19450":112135,"_5":13408,"_26522":112040,"_2670":112136},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3172":66151,"_28020":66123,"_19450":112138,"_5":13408,"_26522":112040,"_2670":112139},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3172":66152,"_28020":66123,"_19450":112141,"_5":13408,"_26522":112040,"_2670":112142},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3172":66153,"_28020":66123,"_19450":112144,"_5":13408,"_26522":112040,"_2670":112145},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3172":66154,"_28020":66123,"_19450":112147,"_5":13408,"_26522":112040,"_2670":112148},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3172":66155,"_28020":66123,"_19450":112150,"_5":13408,"_26522":112048,"_2670":112151},[],"Decide si la CA será raíz o intermedia.",{"_3172":66156,"_28020":66123,"_19450":112153,"_5":13408,"_26522":112048,"_2670":112154},[],"Elige el motor que custodiará la clave.",{"_3172":66157,"_28020":66123,"_19450":112156,"_5":13408,"_26522":112048,"_2670":112157},[],"Define una validez superior a la de los certificados que emitirá.",{"_3172":66158,"_28020":66123,"_19450":112159,"_5":13408,"_26522":112048,"_2670":112160},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3172":66159,"_28020":66123,"_19450":112162,"_5":13408,"_26522":112051,"_2670":112163},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3172":66160,"_28020":66123,"_19450":112165,"_5":13408,"_26522":112055,"_2670":112166},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3172":66161,"_28020":66123,"_19450":112168,"_5":13408,"_26522":112055,"_2670":112169},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3172":66162,"_28020":66123,"_19450":112171,"_5":13408,"_26522":112059,"_2670":112172},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3172":66163,"_28020":66123,"_19450":112174,"_5":13408,"_26522":112063,"_2670":112175},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3172":66164,"_28020":66123,"_19450":112177,"_5":13408,"_26522":112063,"_2670":112178},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3172":66165,"_28020":66123,"_19450":112180,"_5":13408,"_26522":112063,"_2670":112181},[],"`ST`: estado o provincia.",{"_3172":66166,"_28020":66123,"_19450":112183,"_5":13408,"_26522":112063,"_2670":112184},[],"`L`: localidad.",{"_3172":66167,"_28020":66123,"_19450":112186,"_5":13408,"_26522":112063,"_2670":112187},[],"`O`: organización.",{"_3172":66168,"_28020":66123,"_19450":112189,"_5":13408,"_26522":112063,"_2670":112190},[],"`OU`: unidad organizativa.",{"_3172":66169,"_28020":66123,"_19450":112192,"_5":13408,"_26522":112063,"_2670":112193},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3172":66170,"_28020":66123,"_19450":112195,"_5":13408,"_26522":112067,"_2670":112196},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3172":66171,"_28020":66123,"_19450":112198,"_5":13408,"_26522":112067,"_2670":112199},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3172":66172,"_28020":66123,"_19450":112201,"_5":13408,"_26522":112071,"_2670":112202},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3172":66173,"_28020":66123,"_19450":112204,"_5":13408,"_26522":112071,"_2670":112205},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3172":66174,"_28020":66123,"_19450":112207,"_5":13408,"_26522":112075,"_2670":112208},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3172":66175,"_28020":66123,"_19450":112210,"_5":13408,"_26522":112075,"_2670":112211},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3172":66176,"_28020":66123,"_19450":112213,"_5":13408,"_26522":112079,"_2670":112214},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3172":66177,"_28020":66123,"_19450":112216,"_5":13408,"_26522":112083,"_2670":112217},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3172":66178,"_28020":66123,"_19450":112219,"_5":13408,"_26522":112087,"_2670":112220},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3172":66179,"_28020":66123,"_19450":112222,"_5":13408,"_26522":112091,"_2670":112223},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3172":66180,"_28020":66123,"_19450":112225,"_5":13408,"_26522":112095,"_2670":112226},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3172":66181,"_28020":66123,"_19450":112228,"_5":13408,"_26522":112095,"_2670":112229},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3172":66182,"_28020":66123,"_19450":112231,"_5":13408,"_26522":112099,"_2670":112232},[],"Abre una CA desde el inventario para consultar:",{"_3172":66183,"_28020":66123,"_19450":112234,"_5":13408,"_26522":112099,"_2670":112235},[],"Estado y periodo de validez.",{"_3172":66184,"_28020":66123,"_19450":112237,"_5":13408,"_26522":112099,"_2670":112238},[],"Certificado y cadena en formato PEM.",{"_3172":66185,"_28020":66123,"_19450":112240,"_5":13408,"_26522":112099,"_2670":112241},[],"Número de certificados activos, expirados y revocados.",{"_3172":66186,"_28020":66123,"_19450":112243,"_5":13408,"_26522":112099,"_2670":112244},[],"Certificados emitidos en **Issued Certificates**.",{"_3172":66187,"_28020":66123,"_19450":112246,"_5":13408,"_26522":112099,"_2670":112247},[],"CRL vinculada a la autoridad.",{"_3172":66188,"_28020":66123,"_19450":112249,"_5":13408,"_26522":112099,"_2670":112250},[],"Metadatos y motor criptográfico asociado.",{"_3172":66189,"_28020":66123,"_19450":112252,"_5":13408,"_26522":112099,"_2670":112253},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3172":66190,"_28020":66123,"_19450":112255,"_5":13408,"_26522":112103,"_2670":112256},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3172":66191,"_28020":66123,"_19450":112258,"_5":13408,"_26522":112103,"_2670":112259},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3172":66192,"_28020":66123,"_19450":112261,"_5":13408,"_26522":112103,"_2670":112262},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3172":66193,"_28020":66123,"_19450":112264,"_5":13408,"_26522":112103,"_2670":112265},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3172":66194,"_28020":66123,"_19450":112267,"_5":13408,"_26522":112107,"_2670":112268},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3172":66195,"_28020":66123,"_19450":112270,"_5":13408,"_26522":112111,"_2670":112271},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3172":66196,"_28020":66123,"_19450":112273,"_5":13408,"_26522":112115,"_2670":112274},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3172":66197,"_28020":66123,"_19450":112276,"_5":13408,"_26522":112119,"_2670":112277},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3172":66198,"_28020":66123,"_19450":112279,"_5":13408,"_26522":112123,"_2670":112280},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3172":66199,"_28020":66123,"_19450":112282,"_5":13408,"_26522":112123,"_2670":112283},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3172":66200,"_28020":66200,"_5":13734,"_2670":112285,"_28372":112286,"_19450":112287,"_26522":66200},"Perfiles de certificado",[45500,108282,50576,111873],[],{"_3172":66201,"_28020":66200,"_19450":112289,"_5":13408,"_26522":66200,"_2670":112290},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3172":66202,"_28020":66200,"_5":28369,"_19450":112292,"_26522":112293,"_2670":112294},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3172":66203,"_28020":66200,"_5":28369,"_19450":112296,"_26522":112297,"_2670":112298},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-profiles#validez","Validez",{"_3172":66204,"_28020":66200,"_5":28369,"_19450":112300,"_26522":112301,"_2670":112302},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3172":66205,"_28020":66200,"_5":28369,"_19450":112304,"_26522":112305,"_2670":112306},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3172":66206,"_28020":66200,"_5":28369,"_19450":112308,"_26522":112309,"_2670":112310},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3172":66207,"_28020":66200,"_5":28369,"_19450":112312,"_26522":112313,"_2670":112314},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3172":66208,"_28020":66200,"_5":28369,"_19450":112316,"_26522":112317,"_2670":112318},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3172":66209,"_28020":66200,"_5":28369,"_19450":112320,"_26522":112321,"_2670":112322},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3172":66210,"_28020":66200,"_5":28369,"_19450":112324,"_26522":112325,"_2670":112326},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3172":66211,"_28020":66200,"_5":28369,"_19450":112328,"_26522":112329,"_2670":112330},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3172":66212,"_28020":66200,"_5":28369,"_19450":112332,"_26522":112333,"_2670":112334},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3172":66213,"_28020":66200,"_5":28369,"_19450":112336,"_26522":112337,"_2670":112338},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3172":66214,"_28020":66200,"_5":28369,"_19450":112340,"_26522":112341,"_2670":112342},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3172":66215,"_28020":66200,"_5":28369,"_19450":112344,"_26522":112345,"_2670":112346},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3172":66216,"_28020":66200,"_5":28369,"_19450":112348,"_26522":112349,"_2670":112350},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3172":66217,"_28020":66200,"_5":28369,"_19450":112352,"_26522":112353,"_2670":112354},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3172":66218,"_28020":66200,"_19450":112356,"_5":13408,"_26522":66200,"_2670":112357},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3172":66219,"_28020":66200,"_19450":112359,"_5":13408,"_26522":66200,"_2670":112360},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3172":66220,"_28020":66200,"_19450":112362,"_5":13408,"_26522":112297,"_2670":112363},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3172":66221,"_28020":66200,"_19450":112365,"_5":13408,"_26522":112297,"_2670":112366},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3172":66222,"_28020":66200,"_19450":112368,"_5":13408,"_26522":112301,"_2670":112369},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3172":66223,"_28020":66200,"_19450":112371,"_5":13408,"_26522":112305,"_2670":112372},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3172":66224,"_28020":66200,"_19450":112374,"_5":13408,"_26522":112305,"_2670":112375},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3172":66225,"_28020":66200,"_19450":112377,"_5":13408,"_26522":112305,"_2670":112378},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3172":66226,"_28020":66200,"_19450":112380,"_5":13408,"_26522":112309,"_2670":112381},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3172":66227,"_28020":66200,"_19450":112383,"_5":13408,"_26522":112313,"_2670":112384},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3172":66228,"_28020":66200,"_19450":112386,"_5":13408,"_26522":112313,"_2670":112387},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3172":66229,"_28020":66200,"_19450":112389,"_5":13408,"_26522":112317,"_2670":112390},[],"La aplicación criptográfica puede:",{"_3172":66230,"_28020":66200,"_19450":112392,"_5":13408,"_26522":112317,"_2670":112393},[],"permitir o bloquear claves RSA;",{"_3172":66231,"_28020":66200,"_19450":112395,"_5":13408,"_26522":112317,"_2670":112396},[],"limitar los tamaños RSA admitidos;",{"_3172":66232,"_28020":66200,"_19450":112398,"_5":13408,"_26522":112317,"_2670":112399},[],"permitir o bloquear claves ECDSA;",{"_3172":66233,"_28020":66200,"_19450":112401,"_5":13408,"_26522":112317,"_2670":112402},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3172":66234,"_28020":66200,"_19450":112404,"_5":13408,"_26522":112317,"_2670":112405},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3172":66235,"_28020":66200,"_19450":112407,"_5":13408,"_26522":112321,"_2670":112408},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3172":66236,"_28020":66200,"_19450":112410,"_5":13408,"_26522":112321,"_2670":108073},[],{"_3172":66237,"_28020":66200,"_19450":112412,"_5":13408,"_26522":112321,"_2670":112413},[],"Primera opción",{"_3172":66238,"_28020":66200,"_19450":112415,"_5":13408,"_26522":112321,"_2670":112416},[],"Segunda opción",{"_3172":66239,"_28020":66200,"_19450":112418,"_5":13408,"_26522":112321,"_2670":112419},[],"Si no hay ninguna",{"_3172":66240,"_28020":66200,"_19450":112421,"_5":13408,"_26522":112321,"_2670":112422},[],"Firma directa con una CA",{"_3172":66241,"_28020":66200,"_19450":112424,"_5":13408,"_26522":112321,"_2670":112425},[],"`issuance_profile` incluido en la solicitud",{"_3172":66242,"_28020":66200,"_19450":112427,"_5":13408,"_26522":112321,"_2670":112428},[],"`issuance_profile_id` de la solicitud",{"_3172":66243,"_28020":66200,"_19450":112430,"_5":13408,"_26522":112321,"_2670":112431},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3172":66244,"_28020":66200,"_19450":112433,"_5":13408,"_26522":112321,"_2670":112434},[],"Emisión mediante DMS",{"_3172":66245,"_28020":66200,"_19450":112436,"_5":13408,"_26522":112321,"_2670":51141},[],{"_3172":66246,"_28020":66200,"_19450":112438,"_5":13408,"_26522":112321,"_2670":112439},[],"`settings.issuance_profile` incluido en el DMS",{"_3172":66247,"_28020":66200,"_19450":112441,"_5":13408,"_26522":112321,"_2670":112442},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3172":66248,"_28020":66200,"_19450":112444,"_5":13408,"_26522":112321,"_2670":112445},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3172":66249,"_28020":66200,"_19450":112447,"_5":13408,"_26522":112321,"_2670":112448},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3172":66250,"_28020":66200,"_19450":112450,"_5":13408,"_26522":112329,"_2670":112451},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3172":66251,"_28020":66200,"_19450":112453,"_5":13408,"_26522":112333,"_2670":112454},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3172":66252,"_28020":66200,"_19450":112456,"_5":13408,"_26522":112337,"_2670":112457},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3172":66253,"_28020":66200,"_19450":112459,"_5":13408,"_26522":112341,"_2670":112460},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3172":66254,"_28020":66200,"_19450":112462,"_5":13408,"_26522":112345,"_2670":112463},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3172":66255,"_28020":66200,"_19450":112465,"_5":13408,"_26522":112345,"_2670":112466},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3172":66256,"_28020":66200,"_19450":112468,"_5":13408,"_26522":112349,"_2670":112469},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3172":66257,"_28020":66200,"_19450":112471,"_5":13408,"_26522":112349,"_2670":112472},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3172":66258,"_28020":66200,"_19450":112474,"_5":13408,"_26522":112349,"_2670":112475},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3172":66259,"_28020":66200,"_19450":112477,"_5":13408,"_26522":112349,"_2670":112478},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3172":66260,"_28020":66200,"_19450":112480,"_5":13408,"_26522":112353,"_2670":112481},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3172":66261,"_28020":66200,"_19450":112483,"_5":13408,"_26522":112353,"_2670":112484},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3172":66262,"_28020":66262,"_5":13734,"_2670":112486,"_28372":112487,"_19450":112489,"_26522":66262},"Validación de certificados",[45500,108282,50576,112488],"Validación",[],{"_3172":66263,"_28020":66262,"_19450":112491,"_5":13408,"_26522":66262,"_2670":112492},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3172":66264,"_28020":66262,"_5":28369,"_19450":112494,"_26522":112495,"_2670":112496},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3172":66265,"_28020":66262,"_5":28369,"_19450":112498,"_26522":112499,"_2670":112500},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3172":66266,"_28020":66262,"_5":28369,"_19450":112502,"_26522":112503,"_2670":112504},[],"/docs/pr-preview/pr-51/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3172":66267,"_28020":66262,"_19450":112506,"_5":13408,"_26522":66262,"_2670":112507},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3172":66268,"_28020":66262,"_19450":112509,"_5":13408,"_26522":112495,"_2670":112510},[],"Verifica estos criterios juntos:",{"_3172":66269,"_28020":66262,"_19450":112512,"_5":13408,"_26522":112495,"_2670":111500},[],{"_3172":66270,"_28020":66262,"_19450":112514,"_5":13408,"_26522":112495,"_2670":112515},[],"Resultado necesario",{"_3172":66271,"_28020":66262,"_19450":112517,"_5":13408,"_26522":112495,"_2670":112518},[],"Cadena y firma",{"_3172":66272,"_28020":66262,"_19450":112520,"_5":13408,"_26522":112495,"_2670":112521},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3172":66273,"_28020":66262,"_19450":112523,"_5":13408,"_26522":112495,"_2670":112524},[],"Fechas",{"_3172":66274,"_28020":66262,"_19450":112526,"_5":13408,"_26522":112495,"_2670":112527},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3172":66275,"_28020":66262,"_19450":112529,"_5":13408,"_26522":112495,"_2670":107983},[],{"_3172":66276,"_28020":66262,"_19450":112531,"_5":13408,"_26522":112495,"_2670":112532},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3172":66277,"_28020":66262,"_19450":112534,"_5":13408,"_26522":112495,"_2670":112535},[],"Uso",{"_3172":66278,"_28020":66262,"_19450":112537,"_5":13408,"_26522":112495,"_2670":112538},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3172":66279,"_28020":66262,"_19450":112540,"_5":13408,"_26522":112495,"_2670":112541},[],"Revocación",{"_3172":66280,"_28020":66262,"_19450":112543,"_5":13408,"_26522":112495,"_2670":112544},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3172":66281,"_28020":66262,"_19450":112546,"_5":13408,"_26522":112495,"_2670":112547},[],"Autorización",{"_3172":66282,"_28020":66262,"_19450":112549,"_5":13408,"_26522":112495,"_2670":112550},[],"La aplicación permite la acción a esa identidad.",{"_3172":66283,"_28020":66262,"_19450":112552,"_5":13408,"_26522":112495,"_2670":112553},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3172":66284,"_28020":66262,"_19450":112555,"_5":13408,"_26522":112499,"_2670":112556},[],"Mecanismo",{"_3172":66285,"_28020":66262,"_19450":112558,"_5":13408,"_26522":112499,"_2670":112559},[],"Cuándo utilizarlo",{"_3172":66286,"_28020":66262,"_19450":112561,"_5":13408,"_26522":112499,"_2670":112562},[],"Qué debes mantener",{"_3172":66287,"_28020":66262,"_19450":112564,"_5":13408,"_26522":112499,"_2670":51269},[],{"_3172":66288,"_28020":66262,"_19450":112566,"_5":13408,"_26522":112499,"_2670":112567},[],"Consulta del estado de un certificado concreto.",{"_3172":66289,"_28020":66262,"_19450":112569,"_5":13408,"_26522":112499,"_2670":112570},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3172":66290,"_28020":66262,"_19450":112572,"_5":13408,"_26522":112499,"_2670":51278},[],{"_3172":66291,"_28020":66262,"_19450":112574,"_5":13408,"_26522":112499,"_2670":112575},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3172":66292,"_28020":66262,"_19450":112577,"_5":13408,"_26522":112499,"_2670":112578},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3172":66293,"_28020":66262,"_19450":112580,"_5":13408,"_26522":112499,"_2670":112581},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3172":66294,"_28020":66262,"_19450":112583,"_5":13408,"_26522":112499,"_2670":112584},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3172":66295,"_28020":66262,"_19450":112586,"_5":13408,"_26522":112503,"_2670":112587},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3172":66296,"_28020":66262,"_19450":112589,"_5":13408,"_26522":112503,"_2670":112590},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3172":66297,"_28020":66262,"_19450":112592,"_5":13408,"_26522":112503,"_2670":112593},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3172":66298,"_28020":66262,"_19450":112595,"_5":13408,"_26522":112503,"_2670":112596},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3172":66299,"_28020":66262,"_19450":112598,"_5":13408,"_26522":112503,"_2670":112599},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3172":66300,"_28020":66262,"_19450":112601,"_5":13408,"_26522":112503,"_2670":112602},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3172":66301,"_28020":66262,"_19450":112604,"_5":13408,"_26522":112503,"_2670":112605},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3172":66302,"_28020":66262,"_19450":112607,"_5":13408,"_26522":112503,"_2670":112608},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3172":66303,"_28020":66262,"_19450":112610,"_5":13408,"_26522":112503,"_2670":112611},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3172":66304,"_28020":66304,"_5":13734,"_2670":112613,"_28372":112614,"_19450":112615,"_26522":66304},"Certificados",[45500,108282,50576,111873],[],{"_3172":66305,"_28020":66304,"_19450":112617,"_5":13408,"_26522":66304,"_2670":112618},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3172":66306,"_28020":66304,"_5":28369,"_19450":112620,"_26522":112621,"_2670":112622},[],"/docs/pr-preview/pr-51/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3172":66307,"_28020":66304,"_5":28369,"_19450":112624,"_26522":112625,"_2670":112626},[],"/docs/pr-preview/pr-51/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3172":66308,"_28020":66304,"_5":28369,"_19450":112628,"_26522":112629,"_2670":112630},[],"/docs/pr-preview/pr-51/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3172":66309,"_28020":66304,"_5":28369,"_19450":112632,"_26522":112633,"_2670":112634},[],"/docs/pr-preview/pr-51/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3172":66310,"_28020":66304,"_5":28369,"_19450":112636,"_26522":112637,"_2670":112638},[],"/docs/pr-preview/pr-51/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3172":66311,"_28020":66304,"_5":28369,"_19450":112640,"_26522":112641,"_2670":112642},[],"/docs/pr-preview/pr-51/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3172":66312,"_28020":66304,"_5":28369,"_19450":112644,"_26522":112645,"_2670":112646},[],"/docs/pr-preview/pr-51/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3172":66313,"_28020":66304,"_5":28369,"_19450":112648,"_26522":112649,"_2670":112650},[],"/docs/pr-preview/pr-51/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3172":66314,"_28020":66304,"_5":28369,"_19450":112652,"_26522":112653,"_2670":112654},[],"/docs/pr-preview/pr-51/es/platform/pki/certificates#continúa","Continúa",{"_3172":66315,"_28020":66304,"_19450":112656,"_5":13408,"_26522":66304,"_2670":112657},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3172":66316,"_28020":66304,"_19450":112659,"_5":13408,"_26522":112621,"_2670":112660},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3172":66317,"_28020":66304,"_19450":112662,"_5":13408,"_26522":112621,"_2670":112663},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3172":66318,"_28020":66304,"_19450":112665,"_5":13408,"_26522":112625,"_2670":112666},[],"Descarga el PEM e inspecciónalo:",{"_3172":66319,"_28020":66304,"_19450":112668,"_5":13408,"_26522":112625,"_2670":112669},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3172":66320,"_28020":66304,"_19450":112671,"_5":13408,"_26522":112629,"_2670":112672},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3172":66321,"_28020":66304,"_19450":112674,"_5":13408,"_26522":112629,"_2670":112675},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3172":66322,"_28020":66304,"_19450":112677,"_5":13408,"_26522":112629,"_2670":112678},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3172":66323,"_28020":66304,"_19450":112680,"_5":13408,"_26522":112629,"_2670":112681},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3172":66324,"_28020":66304,"_19450":112683,"_5":13408,"_26522":112629,"_2670":112684},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3172":66325,"_28020":66304,"_19450":112686,"_5":13408,"_26522":112629,"_2670":112687},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3172":66326,"_28020":66304,"_19450":112689,"_5":13408,"_26522":112629,"_2670":112690},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3172":66327,"_28020":66304,"_19450":112692,"_5":13408,"_26522":112633,"_2670":112693},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3172":66328,"_28020":66304,"_19450":112695,"_5":13408,"_26522":112637,"_2670":112696},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3172":66329,"_28020":66304,"_19450":112698,"_5":13408,"_26522":112641,"_2670":112699},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3172":66330,"_28020":66304,"_19450":112701,"_5":13408,"_26522":112645,"_2670":112702},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3172":66331,"_28020":66304,"_19450":112704,"_5":13408,"_26522":112645,"_2670":112705},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3172":66332,"_28020":66304,"_19450":112707,"_5":13408,"_26522":112645,"_2670":112708},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3172":66333,"_28020":66304,"_19450":112710,"_5":13408,"_26522":112649,"_2670":112711},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3172":66334,"_28020":66304,"_19450":112713,"_5":13408,"_26522":112649,"_2670":112714},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3172":66335,"_28020":66304,"_19450":112716,"_5":13408,"_26522":112649,"_2670":112717},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3172":66336,"_28020":66304,"_19450":112719,"_5":13408,"_26522":112653,"_2670":112720},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3172":66337,"_28020":66304,"_19450":112722,"_5":13408,"_26522":112653,"_2670":112723},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3172":66338,"_28020":66338,"_5":13734,"_2670":112725,"_28372":112726,"_19450":112728,"_26522":66338},"Ciclo de vida de un certificado",[45500,108282,50576,112727],"Conceptos",[],{"_3172":66339,"_28020":66338,"_19450":112730,"_5":13408,"_26522":66338,"_2670":112731},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3172":66340,"_28020":66338,"_5":28369,"_19450":112733,"_26522":112734,"_2670":112735},[],"/docs/pr-preview/pr-51/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3172":66341,"_28020":66338,"_5":28369,"_19450":112737,"_26522":112738,"_2670":112739},[],"/docs/pr-preview/pr-51/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3172":66342,"_28020":66338,"_5":28369,"_19450":112741,"_26522":112742,"_2670":112743},[],"/docs/pr-preview/pr-51/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3172":66343,"_28020":66338,"_5":28369,"_19450":112745,"_26522":112746,"_2670":112747},[],"/docs/pr-preview/pr-51/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3172":66344,"_28020":66338,"_5":28369,"_19450":112749,"_26522":112750,"_2670":112751},[],"/docs/pr-preview/pr-51/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3172":66345,"_28020":66338,"_5":28369,"_19450":112753,"_26522":112754,"_2670":112755},[],"/docs/pr-preview/pr-51/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3172":66346,"_28020":66338,"_5":28369,"_19450":112757,"_26522":112758,"_2670":112759},[],"/docs/pr-preview/pr-51/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_3172":66347,"_28020":66338,"_5":28369,"_19450":112761,"_26522":112762,"_2670":112763},[],"/docs/pr-preview/pr-51/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3172":66348,"_28020":66338,"_5":28369,"_19450":112765,"_26522":112766,"_2670":112767},[],"/docs/pr-preview/pr-51/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3172":66349,"_28020":66338,"_5":28369,"_19450":112769,"_26522":112770,"_2670":112771},[],"/docs/pr-preview/pr-51/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3172":66350,"_28020":66338,"_19450":112773,"_5":13408,"_26522":66338,"_2670":112774},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3172":66351,"_28020":66338,"_19450":112776,"_5":13408,"_26522":112738,"_2670":112777},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3172":66352,"_28020":66338,"_19450":112779,"_5":13408,"_26522":112742,"_2670":112780},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3172":66353,"_28020":66338,"_19450":112782,"_5":13408,"_26522":112746,"_2670":112783},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3172":66354,"_28020":66338,"_19450":112785,"_5":13408,"_26522":112750,"_2670":112786},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3172":66355,"_28020":66338,"_19450":112788,"_5":13408,"_26522":112754,"_2670":112789},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3172":66356,"_28020":66338,"_19450":112791,"_5":13408,"_26522":112758,"_2670":112792},[],"Lamassu persiste cuatro estados X.509:",{"_3172":66357,"_28020":66338,"_19450":112794,"_5":13408,"_26522":112758,"_2670":112795},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3172":66358,"_28020":66338,"_19450":112797,"_5":13408,"_26522":112758,"_2670":112798},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3172":66359,"_28020":66338,"_19450":112800,"_5":13408,"_26522":112758,"_2670":112801},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3172":66360,"_28020":66338,"_19450":112803,"_5":13408,"_26522":112758,"_2670":112804},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3172":66361,"_28020":66338,"_19450":112806,"_5":13408,"_26522":112758,"_2670":112807},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3172":66362,"_28020":66338,"_19450":112809,"_5":13408,"_26522":112762,"_2670":112810},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3172":66363,"_28020":66338,"_19450":112812,"_5":13408,"_26522":112762,"_2670":112813},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3172":66364,"_28020":66338,"_19450":112815,"_5":13408,"_26522":112762,"_2670":112816},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3172":66365,"_28020":66338,"_19450":112818,"_5":13408,"_26522":112766,"_2670":112819},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3172":66366,"_28020":66338,"_19450":112821,"_5":13408,"_26522":112766,"_2670":112822},[],"Antes de confirmar:",{"_3172":66367,"_28020":66338,"_19450":112824,"_5":13408,"_26522":112766,"_2670":112825},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3172":66368,"_28020":66338,"_19450":112827,"_5":13408,"_26522":112766,"_2670":112828},[],"Distribuye la nueva cadena de confianza.",{"_3172":66369,"_28020":66338,"_19450":112830,"_5":13408,"_26522":112766,"_2670":112831},[],"Reemite las identidades necesarias.",{"_3172":66370,"_28020":66338,"_19450":112833,"_5":13408,"_26522":112766,"_2670":112834},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3172":66371,"_28020":66338,"_19450":112836,"_5":13408,"_26522":112766,"_2670":112837},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3172":66372,"_28020":66338,"_19450":112839,"_5":13408,"_26522":112766,"_2670":112840},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3172":66373,"_28020":66338,"_19450":112842,"_5":13408,"_26522":112770,"_2670":112843},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3172":66374,"_28020":66338,"_19450":112845,"_5":13408,"_26522":112770,"_2670":112846},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3172":66375,"_28020":66338,"_19450":112848,"_5":13408,"_26522":112770,"_2670":112849},[],"Cambios de estado y razones de revocación.",{"_3172":66376,"_28020":66338,"_19450":112851,"_5":13408,"_26522":112770,"_2670":112852},[],"Publicación y vigencia de OCSP y CRLs.",{"_3172":66377,"_28020":66338,"_19450":112854,"_5":13408,"_26522":112770,"_2670":112855},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3172":66378,"_28020":66338,"_19450":112857,"_5":13408,"_26522":112770,"_2670":112858},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3172":66379,"_28020":66379,"_5":13734,"_2670":112860,"_28372":112861,"_19450":112862,"_26522":66379},"Modelo de confianza",[45500,108282,50576,112727],[],{"_3172":66380,"_28020":66379,"_19450":112864,"_5":13408,"_26522":66379,"_2670":112865},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3172":66381,"_28020":66379,"_5":28369,"_19450":112867,"_26522":112868,"_2670":112869},[],"/docs/pr-preview/pr-51/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3172":66382,"_28020":66379,"_5":28369,"_19450":112871,"_26522":112872,"_2670":112873},[],"/docs/pr-preview/pr-51/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3172":66383,"_28020":66379,"_5":28369,"_19450":112875,"_26522":112876,"_2670":112877},[],"/docs/pr-preview/pr-51/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3172":66384,"_28020":66379,"_5":28369,"_19450":112879,"_26522":112880,"_2670":112881},[],"/docs/pr-preview/pr-51/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3172":66385,"_28020":66379,"_5":28369,"_19450":112883,"_26522":112884,"_2670":112885},[],"/docs/pr-preview/pr-51/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3172":66386,"_28020":66379,"_5":28369,"_19450":112887,"_26522":112888,"_2670":112889},[],"/docs/pr-preview/pr-51/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3172":66387,"_28020":66379,"_5":28369,"_19450":112891,"_26522":112892,"_2670":112893},[],"/docs/pr-preview/pr-51/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3172":66388,"_28020":66379,"_5":28369,"_19450":112895,"_26522":112896,"_2670":112897},[],"/docs/pr-preview/pr-51/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3172":66389,"_28020":66379,"_5":28369,"_19450":112899,"_26522":112900,"_2670":112901},[],"/docs/pr-preview/pr-51/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3172":66390,"_28020":66379,"_5":28369,"_19450":112903,"_26522":112904,"_2670":112905},[],"/docs/pr-preview/pr-51/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3172":66391,"_28020":66379,"_19450":112907,"_5":13408,"_26522":66379,"_2670":112908},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3172":66392,"_28020":66379,"_19450":112910,"_5":13408,"_26522":112872,"_2670":112911},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3172":66393,"_28020":66379,"_19450":112913,"_5":13408,"_26522":112876,"_2670":112914},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3172":66394,"_28020":66379,"_19450":112916,"_5":13408,"_26522":112880,"_2670":112917},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3172":66395,"_28020":66379,"_19450":112919,"_5":13408,"_26522":112884,"_2670":112920},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3172":66396,"_28020":66379,"_19450":112922,"_5":13408,"_26522":112888,"_2670":112923},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3172":66397,"_28020":66379,"_19450":112925,"_5":13408,"_26522":112888,"_2670":112926},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3172":66398,"_28020":66379,"_19450":112928,"_5":13408,"_26522":112888,"_2670":112929},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3172":66399,"_28020":66379,"_19450":112931,"_5":13408,"_26522":112888,"_2670":112932},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3172":66400,"_28020":66379,"_19450":112934,"_5":13408,"_26522":112888,"_2670":112935},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3172":66401,"_28020":66379,"_19450":112937,"_5":13408,"_26522":112888,"_2670":112938},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3172":66402,"_28020":66379,"_19450":112940,"_5":13408,"_26522":112892,"_2670":112941},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3172":66403,"_28020":66379,"_19450":112943,"_5":13408,"_26522":112892,"_2670":112944},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3172":66404,"_28020":66379,"_19450":112946,"_5":13408,"_26522":112892,"_2670":112947},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3172":66405,"_28020":66379,"_19450":112949,"_5":13408,"_26522":112892,"_2670":112950},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3172":66406,"_28020":66379,"_19450":112952,"_5":13408,"_26522":112892,"_2670":112953},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3172":66407,"_28020":66379,"_19450":112955,"_5":13408,"_26522":112896,"_2670":112956},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3172":66408,"_28020":66379,"_19450":112958,"_5":13408,"_26522":112896,"_2670":112959},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3172":66409,"_28020":66379,"_19450":112961,"_5":13408,"_26522":112896,"_2670":112962},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3172":66410,"_28020":66379,"_19450":112964,"_5":13408,"_26522":112896,"_2670":112965},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3172":66411,"_28020":66379,"_19450":112967,"_5":13408,"_26522":112896,"_2670":112968},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3172":66412,"_28020":66379,"_19450":112970,"_5":13408,"_26522":112896,"_2670":112971},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3172":66413,"_28020":66379,"_19450":112973,"_5":13408,"_26522":112896,"_2670":112974},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3172":66414,"_28020":66379,"_19450":112976,"_5":13408,"_26522":112900,"_2670":112977},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3172":66415,"_28020":66379,"_19450":112979,"_5":13408,"_26522":112904,"_2670":112980},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3172":66416,"_28020":66379,"_19450":112982,"_5":13408,"_26522":112904,"_2670":112983},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3172":66417,"_28020":66379,"_19450":112985,"_5":13408,"_26522":112904,"_2670":112986},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3172":66418,"_28020":66379,"_19450":112988,"_5":13408,"_26522":112904,"_2670":112989},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3172":66419,"_28020":66379,"_19450":112991,"_5":13408,"_26522":112904,"_2670":112992},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3172":66420,"_28020":66379,"_19450":112994,"_5":13408,"_26522":112904,"_2670":112995},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3172":66421,"_28020":66379,"_19450":112997,"_5":13408,"_26522":112904,"_2670":112998},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3172":66422,"_28020":66422,"_5":13734,"_2670":113000,"_28372":113001,"_19450":113002,"_26522":66422},"Listas de revocación (CRL)",[45500,108282,50576,112488],[],{"_3172":66423,"_28020":66422,"_19450":113004,"_5":13408,"_26522":66422,"_2670":113005},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3172":66424,"_28020":66422,"_5":28369,"_19450":113007,"_26522":113008,"_2670":113009},[],"/docs/pr-preview/pr-51/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3172":66425,"_28020":66422,"_5":28369,"_19450":113011,"_26522":113012,"_2670":113013},[],"/docs/pr-preview/pr-51/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3172":66426,"_28020":66422,"_5":28369,"_19450":113015,"_26522":113016,"_2670":113017},[],"/docs/pr-preview/pr-51/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3172":66427,"_28020":66422,"_5":28369,"_19450":113019,"_26522":113020,"_2670":113021},[],"/docs/pr-preview/pr-51/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3172":66428,"_28020":66422,"_5":28369,"_19450":113023,"_26522":113024,"_2670":113025},[],"/docs/pr-preview/pr-51/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3172":66429,"_28020":66422,"_5":28369,"_19450":113027,"_26522":113028,"_2670":113029},[],"/docs/pr-preview/pr-51/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3172":66430,"_28020":66422,"_5":28369,"_19450":113031,"_26522":113032,"_2670":113033},[],"/docs/pr-preview/pr-51/es/platform/pki/crl#referencias","Referencias",{"_3172":66431,"_28020":66422,"_19450":113035,"_5":13408,"_26522":66422,"_2670":113036},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3172":66432,"_28020":66422,"_19450":113038,"_5":13408,"_26522":113008,"_2670":113039},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3172":66433,"_28020":66422,"_19450":113041,"_5":13408,"_26522":113008,"_2670":113042},[],"Campo de `crl_options`",{"_3172":66434,"_28020":66422,"_19450":113044,"_5":13408,"_26522":113008,"_2670":109781},[],{"_3172":66435,"_28020":66422,"_19450":113046,"_5":13408,"_26522":113008,"_2670":113047},[],"Valor inicial del backend",{"_3172":66436,"_28020":66422,"_19450":113049,"_5":13408,"_26522":113008,"_2670":51756},[],{"_3172":66437,"_28020":66422,"_19450":113051,"_5":13408,"_26522":113008,"_2670":113052},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3172":66438,"_28020":66422,"_19450":113054,"_5":13408,"_26522":113008,"_2670":113055},[],"7 días.",{"_3172":66439,"_28020":66422,"_19450":113057,"_5":13408,"_26522":113008,"_2670":51765},[],{"_3172":66440,"_28020":66422,"_19450":113059,"_5":13408,"_26522":113008,"_2670":113060},[],"Plazo desde la publicación que activa la renovación programada.",{"_3172":66441,"_28020":66422,"_19450":113062,"_5":13408,"_26522":113008,"_2670":113063},[],"6 días y 23 horas.",{"_3172":66442,"_28020":66422,"_19450":113065,"_5":13408,"_26522":113008,"_2670":51774},[],{"_3172":66443,"_28020":66422,"_19450":113067,"_5":13408,"_26522":113008,"_2670":113068},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3172":66444,"_28020":66422,"_19450":113070,"_5":13408,"_26522":113008,"_2670":51780},[],{"_3172":66445,"_28020":66422,"_19450":113072,"_5":13408,"_26522":113008,"_2670":51783},[],{"_3172":66446,"_28020":66422,"_19450":113074,"_5":13408,"_26522":113008,"_2670":113075},[],"Campo de configuración inicializado con el SKI de la CA.",{"_3172":66447,"_28020":66422,"_19450":113077,"_5":13408,"_26522":113008,"_2670":113078},[],"SKI de la CA.",{"_3172":66448,"_28020":66422,"_19450":113080,"_5":13408,"_26522":113008,"_2670":113081},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_3172":66449,"_28020":66422,"_19450":113083,"_5":13408,"_26522":113008,"_2670":113084},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_3172":66450,"_28020":66422,"_19450":113086,"_5":13408,"_26522":113012,"_2670":113087},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_3172":66451,"_28020":66422,"_19450":113089,"_5":13408,"_26522":113012,"_2670":113090},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3172":66452,"_28020":66422,"_19450":113092,"_5":13408,"_26522":113012,"_2670":113093},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3172":66453,"_28020":66422,"_19450":113095,"_5":13408,"_26522":113016,"_2670":113096},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3172":66454,"_28020":66422,"_19450":113098,"_5":13408,"_26522":113016,"_2670":113099},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3172":66455,"_28020":66422,"_19450":113101,"_5":13408,"_26522":113020,"_2670":113102},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_3172":66456,"_28020":66422,"_19450":113104,"_5":13408,"_26522":113020,"_2670":113105},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3172":66457,"_28020":66422,"_19450":113107,"_5":13408,"_26522":113020,"_2670":113108},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3172":66458,"_28020":66422,"_19450":113110,"_5":13408,"_26522":113020,"_2670":113111},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3172":66459,"_28020":66422,"_19450":113113,"_5":13408,"_26522":113020,"_2670":113114},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3172":66460,"_28020":66422,"_19450":113116,"_5":13408,"_26522":113024,"_2670":113117},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3172":66461,"_28020":66422,"_19450":113119,"_5":13408,"_26522":113024,"_2670":109970},[],{"_3172":66462,"_28020":66422,"_19450":113121,"_5":13408,"_26522":113024,"_2670":113122},[],"Path relativo",{"_3172":66463,"_28020":66422,"_19450":113124,"_5":13408,"_26522":113024,"_2670":108073},[],{"_3172":66464,"_28020":66422,"_19450":113126,"_5":13408,"_26522":113024,"_2670":51838},[],{"_3172":66465,"_28020":66422,"_19450":113128,"_5":13408,"_26522":113024,"_2670":51841},[],{"_3172":66466,"_28020":66422,"_19450":113130,"_5":13408,"_26522":113024,"_2670":113131},[],"Consultar `crl_options` y `latest_crl`.",{"_3172":66467,"_28020":66422,"_19450":113133,"_5":13408,"_26522":113024,"_2670":51847},[],{"_3172":66468,"_28020":66422,"_19450":113135,"_5":13408,"_26522":113024,"_2670":51841},[],{"_3172":66469,"_28020":66422,"_19450":113137,"_5":13408,"_26522":113024,"_2670":113138},[],"Sustituir la configuración de CRL.",{"_3172":66470,"_28020":66422,"_19450":113140,"_5":13408,"_26522":113024,"_2670":113141},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_3172":66471,"_28020":66422,"_19450":113143,"_5":13408,"_26522":113024,"_2670":113144},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3172":66472,"_28020":66422,"_19450":113146,"_5":13408,"_26522":113028,"_2670":113147},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3172":66473,"_28020":66422,"_19450":113149,"_5":13408,"_26522":113032,"_2670":113150},[],"RFC 5280: perfil X.509 y CRL.",{"_3172":66474,"_28020":66422,"_19450":113152,"_5":13408,"_26522":113032,"_2670":51867},[],{"_3172":66475,"_28020":66422,"_19450":113154,"_5":13408,"_26522":113032,"_2670":51870},[],{"_3172":66476,"_28020":66422,"_19450":113156,"_5":13408,"_26522":113032,"_2670":113157},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3172":66477,"_28020":66422,"_19450":113159,"_5":13408,"_26522":113032,"_2670":113160},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3172":66478,"_28020":66478,"_5":13734,"_2670":113162,"_28372":113163,"_19450":113164,"_26522":66478},"Claves y motores criptográficos",[45500,108282,50576,111873],[],{"_3172":66479,"_28020":66478,"_19450":113166,"_5":13408,"_26522":66478,"_2670":113167},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3172":66480,"_28020":66478,"_5":28369,"_19450":113169,"_26522":113170,"_2670":113171},[],"/docs/pr-preview/pr-51/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3172":66481,"_28020":66478,"_5":28369,"_19450":113173,"_26522":113174,"_2670":113175},[],"/docs/pr-preview/pr-51/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3172":66482,"_28020":66478,"_5":28369,"_19450":113177,"_26522":113178,"_2670":51895},[],"/docs/pr-preview/pr-51/es/platform/pki/key-management#file-system",{"_3172":66483,"_28020":66478,"_5":28369,"_19450":113180,"_26522":113181,"_2670":51899},[],"/docs/pr-preview/pr-51/es/platform/pki/key-management#hashicorp-vault",{"_3172":66484,"_28020":66478,"_5":28369,"_19450":113183,"_26522":113184,"_2670":51903},[],"/docs/pr-preview/pr-51/es/platform/pki/key-management#aws-secrets-manager",{"_3172":66485,"_28020":66478,"_5":28369,"_19450":113186,"_26522":113187,"_2670":51907},[],"/docs/pr-preview/pr-51/es/platform/pki/key-management#aws-kms",{"_3172":66486,"_28020":66478,"_5":28369,"_19450":113189,"_26522":113190,"_2670":51911},[],"/docs/pr-preview/pr-51/es/platform/pki/key-management#pkcs11",{"_3172":66487,"_28020":66478,"_5":28369,"_19450":113192,"_26522":113193,"_2670":51915},[],"/docs/pr-preview/pr-51/es/platform/pki/key-management#azure-key-vault",{"_3172":66488,"_28020":66478,"_5":28369,"_19450":113195,"_26522":113196,"_2670":113197},[],"/docs/pr-preview/pr-51/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3172":66489,"_28020":66478,"_5":28369,"_19450":113199,"_26522":113200,"_2670":113201},[],"/docs/pr-preview/pr-51/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3172":66490,"_28020":66478,"_5":28369,"_19450":113203,"_26522":113204,"_2670":113205},[],"/docs/pr-preview/pr-51/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3172":66491,"_28020":66478,"_5":28369,"_19450":113207,"_26522":113208,"_2670":113209},[],"/docs/pr-preview/pr-51/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3172":66492,"_28020":66478,"_5":28369,"_19450":113211,"_26522":113212,"_2670":113213},[],"/docs/pr-preview/pr-51/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3172":66493,"_28020":66478,"_5":28369,"_19450":113215,"_26522":113216,"_2670":113217},[],"/docs/pr-preview/pr-51/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3172":66494,"_28020":66478,"_5":28369,"_19450":113219,"_26522":113220,"_2670":113221},[],"/docs/pr-preview/pr-51/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3172":66495,"_28020":66478,"_5":28369,"_19450":113223,"_26522":113224,"_2670":51947},[],"/docs/pr-preview/pr-51/es/platform/pki/key-management#sign",{"_3172":66496,"_28020":66478,"_5":28369,"_19450":113226,"_26522":113227,"_2670":51951},[],"/docs/pr-preview/pr-51/es/platform/pki/key-management#verify",{"_3172":66497,"_28020":66478,"_5":28369,"_19450":113229,"_26522":113230,"_2670":113231},[],"/docs/pr-preview/pr-51/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3172":66498,"_28020":66478,"_5":28369,"_19450":113233,"_26522":113234,"_2670":113235},[],"/docs/pr-preview/pr-51/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3172":66499,"_28020":66478,"_5":28369,"_19450":113237,"_26522":113238,"_2670":113239},[],"/docs/pr-preview/pr-51/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3172":66500,"_28020":66478,"_19450":113241,"_5":13408,"_26522":66478,"_2670":113242},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3172":66501,"_28020":66478,"_19450":113244,"_5":13408,"_26522":66478,"_2670":113245},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3172":66502,"_28020":66478,"_19450":113247,"_5":13408,"_26522":113170,"_2670":113248},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3172":66503,"_28020":66478,"_19450":113250,"_5":13408,"_26522":113170,"_2670":113251},[],"En la práctica, permite:",{"_3172":66504,"_28020":66478,"_19450":113253,"_5":13408,"_26522":113170,"_2670":113254},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3172":66505,"_28020":66478,"_19450":113256,"_5":13408,"_26522":113170,"_2670":113257},[],"Importar claves creadas externamente.",{"_3172":66506,"_28020":66478,"_19450":113259,"_5":13408,"_26522":113170,"_2670":113260},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3172":66507,"_28020":66478,"_19450":113262,"_5":13408,"_26522":113170,"_2670":113263},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3172":66508,"_28020":66478,"_19450":113265,"_5":13408,"_26522":113174,"_2670":113266},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3172":66509,"_28020":66478,"_19450":113268,"_5":13408,"_26522":113174,"_2670":113269},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3172":66510,"_28020":66478,"_19450":113271,"_5":13408,"_26522":113174,"_2670":113272},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3172":66511,"_28020":66478,"_19450":113274,"_5":13408,"_26522":113178,"_2670":113275},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3172":66512,"_28020":66478,"_19450":113277,"_5":13408,"_26522":113181,"_2670":113278},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3172":66513,"_28020":66478,"_19450":113280,"_5":13408,"_26522":113184,"_2670":113281},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3172":66514,"_28020":66478,"_19450":113283,"_5":13408,"_26522":113187,"_2670":113284},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3172":66515,"_28020":66478,"_19450":113286,"_5":13408,"_26522":113190,"_2670":113287},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3172":66516,"_28020":66478,"_19450":113289,"_5":13408,"_26522":113193,"_2670":113290},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3172":66517,"_28020":66478,"_19450":113292,"_5":13408,"_26522":113193,"_2670":113293},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3172":66518,"_28020":66478,"_19450":113295,"_5":13408,"_26522":113193,"_2670":113296},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3172":66519,"_28020":66478,"_19450":113298,"_5":13408,"_26522":113193,"_2670":113299},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3172":66520,"_28020":66478,"_19450":113301,"_5":13408,"_26522":113196,"_2670":113302},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3172":66521,"_28020":66478,"_19450":113304,"_5":13408,"_26522":113196,"_2670":113305},[],"La tabla incluye los siguientes campos:",{"_3172":66522,"_28020":66478,"_19450":113307,"_5":13408,"_26522":113196,"_2670":113308},[],"**Name**: nombre descriptivo de la clave.",{"_3172":66523,"_28020":66478,"_19450":113310,"_5":13408,"_26522":113196,"_2670":113311},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3172":66524,"_28020":66478,"_19450":113313,"_5":13408,"_26522":113196,"_2670":113314},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3172":66525,"_28020":66478,"_19450":113316,"_5":13408,"_26522":113196,"_2670":113317},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3172":66526,"_28020":66478,"_19450":113319,"_5":13408,"_26522":113196,"_2670":113320},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3172":66527,"_28020":66478,"_19450":113322,"_5":13408,"_26522":113196,"_2670":113323},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3172":66528,"_28020":66478,"_19450":113325,"_5":13408,"_26522":113196,"_2670":113326},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3172":66529,"_28020":66478,"_19450":113328,"_5":13408,"_26522":113196,"_2670":113329},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3172":66530,"_28020":66478,"_19450":113331,"_5":13408,"_26522":113196,"_2670":113332},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3172":66531,"_28020":66478,"_19450":113334,"_5":13408,"_26522":113196,"_2670":113335},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3172":66532,"_28020":66478,"_19450":113337,"_5":13408,"_26522":113196,"_2670":113338},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3172":66533,"_28020":66478,"_19450":113340,"_5":13408,"_26522":113196,"_2670":113341},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3172":66534,"_28020":66478,"_19450":113343,"_5":13408,"_26522":113196,"_2670":113344},[],"**Delete Key** para eliminar la clave del sistema.",{"_3172":66535,"_28020":66478,"_19450":113346,"_5":13408,"_26522":113200,"_2670":113347},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3172":66536,"_28020":66478,"_19450":113349,"_5":13408,"_26522":113204,"_2670":113350},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3172":66537,"_28020":66478,"_19450":113352,"_5":13408,"_26522":113204,"_2670":113353},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3172":66538,"_28020":66478,"_19450":113355,"_5":13408,"_26522":113204,"_2670":113356},[],"**Key Name**: nombre único y descriptivo.",{"_3172":66539,"_28020":66478,"_19450":113358,"_5":13408,"_26522":113204,"_2670":113359},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3172":66540,"_28020":66478,"_19450":113361,"_5":13408,"_26522":113204,"_2670":113362},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3172":66541,"_28020":66478,"_19450":113364,"_5":13408,"_26522":113204,"_2670":113365},[],"**Tags**: metadatos para clasificar la clave.",{"_3172":66542,"_28020":66478,"_19450":113367,"_5":13408,"_26522":113204,"_2670":113368},[],"**Metadata**: información adicional para usos avanzados.",{"_3172":66543,"_28020":66478,"_19450":113370,"_5":13408,"_26522":113208,"_2670":113371},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3172":66544,"_28020":66478,"_19450":113373,"_5":13408,"_26522":113208,"_2670":113374},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3172":66545,"_28020":66478,"_19450":113376,"_5":13408,"_26522":113208,"_2670":113377},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3172":66546,"_28020":66478,"_19450":113379,"_5":13408,"_26522":113208,"_2670":113380},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3172":66547,"_28020":66478,"_19450":113382,"_5":13408,"_26522":113208,"_2670":113383},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3172":66548,"_28020":66478,"_19450":113385,"_5":13408,"_26522":113208,"_2670":113386},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3172":66549,"_28020":66478,"_19450":113388,"_5":13408,"_26522":113208,"_2670":113389},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3172":66550,"_28020":66478,"_19450":113391,"_5":13408,"_26522":113208,"_2670":113392},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3172":66551,"_28020":66478,"_19450":113394,"_5":13408,"_26522":113208,"_2670":113395},[],"**Metadata**: información adicional opcional.",{"_3172":66552,"_28020":66478,"_19450":113397,"_5":13408,"_26522":113208,"_2670":113398},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3172":66553,"_28020":66478,"_19450":113400,"_5":13408,"_26522":113208,"_2670":113401},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3172":66554,"_28020":66478,"_19450":113403,"_5":13408,"_26522":113212,"_2670":113404},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3172":66555,"_28020":66478,"_19450":113406,"_5":13408,"_26522":113216,"_2670":113407},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3172":66556,"_28020":66478,"_19450":113409,"_5":13408,"_26522":113216,"_2670":113410},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3172":66557,"_28020":66478,"_19450":113412,"_5":13408,"_26522":113216,"_2670":113413},[],"**Key Name**: nombre descriptivo.",{"_3172":66558,"_28020":66478,"_19450":113415,"_5":13408,"_26522":113216,"_2670":113416},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3172":66559,"_28020":66478,"_19450":113418,"_5":13408,"_26522":113216,"_2670":113419},[],"**Tags**: etiquetas asociadas.",{"_3172":66560,"_28020":66478,"_19450":113421,"_5":13408,"_26522":113216,"_2670":113422},[],"**Aliases**: nombres alternativos.",{"_3172":66561,"_28020":66478,"_19450":113424,"_5":13408,"_26522":113216,"_2670":113425},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3172":66562,"_28020":66478,"_19450":113427,"_5":13408,"_26522":113216,"_2670":113428},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3172":66563,"_28020":66478,"_19450":113430,"_5":13408,"_26522":113216,"_2670":113431},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3172":66564,"_28020":66478,"_19450":113433,"_5":13408,"_26522":113216,"_2670":113434},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3172":66565,"_28020":66478,"_19450":113436,"_5":13408,"_26522":113220,"_2670":113437},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3172":66566,"_28020":66478,"_19450":113439,"_5":13408,"_26522":113220,"_2670":113440},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3172":66567,"_28020":66478,"_19450":113442,"_5":13408,"_26522":113220,"_2670":113443},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3172":66568,"_28020":66478,"_19450":113445,"_5":13408,"_26522":113224,"_2670":113446},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3172":66569,"_28020":66478,"_19450":113448,"_5":13408,"_26522":113224,"_2670":113449},[],"Campos principales:",{"_3172":66570,"_28020":66478,"_19450":113451,"_5":13408,"_26522":113224,"_2670":113452},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3172":66571,"_28020":66478,"_19450":113454,"_5":13408,"_26522":113224,"_2670":113455},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3172":66572,"_28020":66478,"_19450":113457,"_5":13408,"_26522":113224,"_2670":113458},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3172":66573,"_28020":66478,"_19450":113460,"_5":13408,"_26522":113224,"_2670":113461},[],"**Message**: contenido que se va a firmar.",{"_3172":66574,"_28020":66478,"_19450":113463,"_5":13408,"_26522":113224,"_2670":113464},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3172":66575,"_28020":66478,"_19450":113466,"_5":13408,"_26522":113227,"_2670":113467},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3172":66576,"_28020":66478,"_19450":113469,"_5":13408,"_26522":113227,"_2670":113449},[],{"_3172":66577,"_28020":66478,"_19450":113471,"_5":13408,"_26522":113227,"_2670":113472},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3172":66578,"_28020":66478,"_19450":113474,"_5":13408,"_26522":113227,"_2670":113475},[],"**Message Type**: `Raw` o `Digest`.",{"_3172":66579,"_28020":66478,"_19450":113477,"_5":13408,"_26522":113227,"_2670":113478},[],"**Payload Encoding**: codificación del mensaje.",{"_3172":66580,"_28020":66478,"_19450":113480,"_5":13408,"_26522":113227,"_2670":113481},[],"**Message**: mensaje original o hash.",{"_3172":66581,"_28020":66478,"_19450":113483,"_5":13408,"_26522":113227,"_2670":113484},[],"**Signature**: firma que se desea comprobar.",{"_3172":66582,"_28020":66478,"_19450":113486,"_5":13408,"_26522":113227,"_2670":113487},[],"**Result**: indicador del resultado de la validación.",{"_3172":66583,"_28020":66478,"_19450":113489,"_5":13408,"_26522":113230,"_2670":113490},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3172":66584,"_28020":66478,"_19450":113492,"_5":13408,"_26522":113230,"_2670":113493},[],"Este flujo es útil para:",{"_3172":66585,"_28020":66478,"_19450":113495,"_5":13408,"_26522":113230,"_2670":113496},[],"Solicitar certificados a una CA externa.",{"_3172":66586,"_28020":66478,"_19450":113498,"_5":13408,"_26522":113230,"_2670":113499},[],"Renovar una identidad manteniendo la misma clave.",{"_3172":66587,"_28020":66478,"_19450":113501,"_5":13408,"_26522":113230,"_2670":113502},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3172":66588,"_28020":66478,"_19450":113504,"_5":13408,"_26522":113230,"_2670":113505},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3172":66589,"_28020":66478,"_19450":113507,"_5":13408,"_26522":113230,"_2670":113508},[],"**Organization (O)**: organización o empresa.",{"_3172":66590,"_28020":66478,"_19450":113510,"_5":13408,"_26522":113230,"_2670":113511},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3172":66591,"_28020":66478,"_19450":113513,"_5":13408,"_26522":113230,"_2670":113514},[],"**Country (C)**: código de país de dos letras.",{"_3172":66592,"_28020":66478,"_19450":113516,"_5":13408,"_26522":113230,"_2670":113517},[],"**State / Province (ST)**: estado o provincia.",{"_3172":66593,"_28020":66478,"_19450":113519,"_5":13408,"_26522":113230,"_2670":113520},[],"**Locality (L)**: ciudad o localidad.",{"_3172":66594,"_28020":66478,"_19450":113522,"_5":13408,"_26522":113230,"_2670":113523},[],"**Email Address**: correo de contacto.",{"_3172":66595,"_28020":66478,"_19450":113525,"_5":13408,"_26522":113230,"_2670":113526},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3172":66596,"_28020":66478,"_19450":113528,"_5":13408,"_26522":113230,"_2670":113529},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3172":66597,"_28020":66478,"_19450":113531,"_5":13408,"_26522":113234,"_2670":113532},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3172":66598,"_28020":66478,"_19450":113534,"_5":13408,"_26522":113234,"_2670":52259},[],{"_3172":66599,"_28020":66478,"_19450":113536,"_5":13408,"_26522":113238,"_2670":113537},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3172":66600,"_28020":66600,"_5":13734,"_2670":113539,"_28372":113540,"_19450":113541,"_26522":66600},"Validación online con OCSP",[45500,108282,50576,112488],[],{"_3172":66601,"_28020":66600,"_19450":113543,"_5":13408,"_26522":66600,"_2670":113544},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3172":66602,"_28020":66600,"_5":28369,"_19450":113546,"_26522":113547,"_2670":113548},[],"/docs/pr-preview/pr-51/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3172":66603,"_28020":66600,"_5":28369,"_19450":113550,"_26522":113551,"_2670":113552},[],"/docs/pr-preview/pr-51/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3172":66604,"_28020":66600,"_5":28369,"_19450":113554,"_26522":113555,"_2670":113556},[],"/docs/pr-preview/pr-51/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3172":66605,"_28020":66600,"_5":28369,"_19450":113558,"_26522":113559,"_2670":113560},[],"/docs/pr-preview/pr-51/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3172":66606,"_28020":66600,"_5":28369,"_19450":113562,"_26522":113563,"_2670":113564},[],"/docs/pr-preview/pr-51/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3172":66607,"_28020":66600,"_5":28369,"_19450":113566,"_26522":113567,"_2670":113033},[],"/docs/pr-preview/pr-51/es/platform/pki/ocsp#referencias",{"_3172":66608,"_28020":66600,"_19450":113569,"_5":13408,"_26522":66600,"_2670":113570},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3172":66609,"_28020":66600,"_19450":113572,"_5":13408,"_26522":113547,"_2670":113573},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3172":66610,"_28020":66600,"_19450":113575,"_5":13408,"_26522":113547,"_2670":113576},[],"Estado del registro",{"_3172":66611,"_28020":66600,"_19450":113578,"_5":13408,"_26522":113547,"_2670":113579},[],"Respuesta firmada",{"_3172":66612,"_28020":66600,"_19450":113581,"_5":13408,"_26522":113547,"_2670":49754},[],{"_3172":66613,"_28020":66600,"_19450":113583,"_5":13408,"_26522":113547,"_2670":52309},[],{"_3172":66614,"_28020":66600,"_19450":113585,"_5":13408,"_26522":113547,"_2670":49771},[],{"_3172":66615,"_28020":66600,"_19450":113587,"_5":13408,"_26522":113547,"_2670":113588},[],"`Revoked`, con razón y fecha de revocación.",{"_3172":66616,"_28020":66600,"_19450":113590,"_5":13408,"_26522":113547,"_2670":113591},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3172":66617,"_28020":66600,"_19450":113593,"_5":13408,"_26522":113547,"_2670":113594},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3172":66618,"_28020":66600,"_19450":113596,"_5":13408,"_26522":113547,"_2670":113597},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3172":66619,"_28020":66600,"_19450":113599,"_5":13408,"_26522":113547,"_2670":113600},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3172":66620,"_28020":66600,"_19450":113602,"_5":13408,"_26522":113547,"_2670":113603},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3172":66621,"_28020":66600,"_19450":113605,"_5":13408,"_26522":113551,"_2670":113606},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3172":66622,"_28020":66600,"_19450":113608,"_5":13408,"_26522":113551,"_2670":113609},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3172":66623,"_28020":66600,"_19450":113611,"_5":13408,"_26522":113555,"_2670":113612},[],"El servicio acepta:",{"_3172":66624,"_28020":66600,"_19450":113614,"_5":13408,"_26522":113555,"_2670":109970},[],{"_3172":66625,"_28020":66600,"_19450":113616,"_5":13408,"_26522":113555,"_2670":113617},[],"Ruta del servicio VA",{"_3172":66626,"_28020":66600,"_19450":113619,"_5":13408,"_26522":113555,"_2670":113620},[],"Formato",{"_3172":66627,"_28020":66600,"_19450":113622,"_5":13408,"_26522":113555,"_2670":52349},[],{"_3172":66628,"_28020":66600,"_19450":113624,"_5":13408,"_26522":113555,"_2670":52352},[],{"_3172":66629,"_28020":66600,"_19450":113626,"_5":13408,"_26522":113555,"_2670":113627},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3172":66630,"_28020":66600,"_19450":113629,"_5":13408,"_26522":113555,"_2670":51838},[],{"_3172":66631,"_28020":66600,"_19450":113631,"_5":13408,"_26522":113555,"_2670":52360},[],{"_3172":66632,"_28020":66600,"_19450":113633,"_5":13408,"_26522":113555,"_2670":113634},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3172":66633,"_28020":66600,"_19450":113636,"_5":13408,"_26522":113555,"_2670":113637},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3172":66634,"_28020":66600,"_19450":113639,"_5":13408,"_26522":113559,"_2670":113640},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3172":66635,"_28020":66600,"_19450":113642,"_5":13408,"_26522":113559,"_2670":113643},[],"Genera la solicitud:",{"_3172":66636,"_28020":66600,"_19450":113645,"_5":13408,"_26522":113559,"_2670":113646},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3172":66637,"_28020":66600,"_19450":113648,"_5":13408,"_26522":113559,"_2670":113649},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3172":66638,"_28020":66600,"_19450":113651,"_5":13408,"_26522":113559,"_2670":113652},[],"Verifica el DER recibido:",{"_3172":66639,"_28020":66600,"_19450":113654,"_5":13408,"_26522":113559,"_2670":113655},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3172":66640,"_28020":66600,"_19450":113657,"_5":13408,"_26522":113563,"_2670":113658},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3172":66641,"_28020":66600,"_19450":113660,"_5":13408,"_26522":113563,"_2670":113661},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3172":66642,"_28020":66600,"_19450":113663,"_5":13408,"_26522":113567,"_2670":52393},[],{"_3172":66643,"_28020":66600,"_19450":113665,"_5":13408,"_26522":113567,"_2670":52396},[],{"_3172":66644,"_28020":66600,"_19450":113667,"_5":13408,"_26522":113567,"_2670":113668},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3172":66645,"_28020":66600,"_19450":113670,"_5":13408,"_26522":113567,"_2670":113160},[],{"_3172":66646,"_28020":66646,"_5":13734,"_2670":50576,"_28372":113672,"_19450":113673,"_26522":66646},[45500,108282,50576],[],{"_3172":66647,"_28020":66646,"_19450":113675,"_5":13408,"_26522":66646,"_2670":113676},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3172":66648,"_28020":66646,"_5":28369,"_19450":113678,"_26522":113679,"_2670":111197},[],"/docs/pr-preview/pr-51/es/platform/pki/overview#empieza-aquí",{"_3172":66649,"_28020":66646,"_5":28369,"_19450":113681,"_26522":113682,"_2670":113683},[],"/docs/pr-preview/pr-51/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3172":66650,"_28020":66646,"_5":28369,"_19450":113685,"_26522":113686,"_2670":111719},[],"/docs/pr-preview/pr-51/es/platform/pki/overview#capacidades-principales",{"_3172":66651,"_28020":66646,"_5":28369,"_19450":113688,"_26522":113689,"_2670":111723},[],"/docs/pr-preview/pr-51/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3172":66652,"_28020":66646,"_5":28369,"_19450":113691,"_26522":113692,"_2670":111727},[],"/docs/pr-preview/pr-51/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3172":66653,"_28020":66646,"_5":28369,"_19450":113694,"_26522":113695,"_2670":111731},[],"/docs/pr-preview/pr-51/es/platform/pki/overview#emite-y-controla-certificados",{"_3172":66654,"_28020":66646,"_5":28369,"_19450":113697,"_26522":113698,"_2670":111739},[],"/docs/pr-preview/pr-51/es/platform/pki/overview#publica-el-estado-de-validación",{"_3172":66655,"_28020":66646,"_5":28369,"_19450":113700,"_26522":113701,"_2670":113702},[],"/docs/pr-preview/pr-51/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3172":66656,"_28020":66646,"_5":28369,"_19450":113704,"_26522":113705,"_2670":112654},[],"/docs/pr-preview/pr-51/es/platform/pki/overview#continúa",{"_3172":66657,"_28020":66646,"_19450":113707,"_5":13408,"_26522":66646,"_2670":113708},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3172":66658,"_28020":66646,"_19450":113710,"_5":13408,"_26522":113679,"_2670":113711},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3172":66659,"_28020":66646,"_19450":113713,"_5":13408,"_26522":113679,"_2670":113714},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3172":66660,"_28020":66646,"_19450":113716,"_5":13408,"_26522":113682,"_2670":113717},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3172":66661,"_28020":66646,"_19450":113719,"_5":13408,"_26522":113682,"_2670":113720},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3172":66662,"_28020":66646,"_19450":113722,"_5":13408,"_26522":113682,"_2670":113723},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3172":66663,"_28020":66646,"_19450":113725,"_5":13408,"_26522":113682,"_2670":113726},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3172":66664,"_28020":66646,"_19450":113728,"_5":13408,"_26522":113682,"_2670":113729},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3172":66665,"_28020":66646,"_19450":113731,"_5":13408,"_26522":113689,"_2670":113732},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3172":66666,"_28020":66646,"_19450":113734,"_5":13408,"_26522":113692,"_2670":113735},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3172":66667,"_28020":66646,"_19450":113737,"_5":13408,"_26522":113695,"_2670":113738},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3172":66668,"_28020":66646,"_19450":113740,"_5":13408,"_26522":113698,"_2670":113741},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3172":66669,"_28020":66646,"_19450":113743,"_5":13408,"_26522":113701,"_2670":113744},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3172":66670,"_28020":66646,"_19450":113746,"_5":13408,"_26522":113701,"_2670":113747},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3172":66671,"_28020":66646,"_19450":113749,"_5":13408,"_26522":113701,"_2670":113750},[],"su clave pública corresponda a la clave privada del cliente;",{"_3172":66672,"_28020":66646,"_19450":113752,"_5":13408,"_26522":113701,"_2670":113753},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3172":66673,"_28020":66646,"_19450":113755,"_5":13408,"_26522":113701,"_2670":113756},[],"sus fechas y usos permitan la operación;",{"_3172":66674,"_28020":66646,"_19450":113758,"_5":13408,"_26522":113701,"_2670":113759},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3172":66675,"_28020":66646,"_19450":113761,"_5":13408,"_26522":113701,"_2670":113762},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3172":66676,"_28020":66646,"_19450":113764,"_5":13408,"_26522":113705,"_2670":113765},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3172":66677,"_28020":66646,"_19450":113767,"_5":13408,"_26522":113705,"_2670":113768},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3172":66678,"_28020":66646,"_19450":113770,"_5":13408,"_26522":113705,"_2670":113771},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3172":66679,"_28020":66679,"_5":13734,"_2670":113773,"_28372":113774,"_19450":113775,"_26522":66679},"Crea tu primera CA",[45500,108282,50576,111321],[],{"_3172":66680,"_28020":66679,"_19450":113777,"_5":13408,"_26522":66679,"_2670":113778},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3172":66681,"_28020":66679,"_5":28369,"_19450":113780,"_26522":113781,"_2670":106948},[],"/docs/pr-preview/pr-51/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3172":66682,"_28020":66679,"_5":28369,"_19450":113783,"_26522":113784,"_2670":113785},[],"/docs/pr-preview/pr-51/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_3172":66683,"_28020":66679,"_5":28369,"_19450":113787,"_26522":113788,"_2670":113789},[],"/docs/pr-preview/pr-51/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_3172":66684,"_28020":66679,"_5":28369,"_19450":113791,"_26522":113792,"_2670":113793},[],"/docs/pr-preview/pr-51/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_3172":66685,"_28020":66679,"_5":28369,"_19450":113795,"_26522":113796,"_2670":113797},[],"/docs/pr-preview/pr-51/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_3172":66686,"_28020":66679,"_5":28369,"_19450":113799,"_26522":113800,"_2670":113801},[],"/docs/pr-preview/pr-51/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_3172":66687,"_28020":66679,"_5":28369,"_19450":113803,"_26522":113804,"_2670":113805},[],"/docs/pr-preview/pr-51/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3172":66688,"_28020":66679,"_5":28369,"_19450":113807,"_26522":113808,"_2670":111569},[],"/docs/pr-preview/pr-51/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3172":66689,"_28020":66679,"_5":28369,"_19450":113810,"_26522":113811,"_2670":106972},[],"/docs/pr-preview/pr-51/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3172":66690,"_28020":66679,"_19450":113813,"_5":13408,"_26522":66679,"_2670":113814},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3172":66691,"_28020":66679,"_19450":113816,"_5":13408,"_26522":113781,"_2670":113817},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3172":66692,"_28020":66679,"_19450":113819,"_5":13408,"_26522":113781,"_2670":113820},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3172":66693,"_28020":66679,"_19450":113822,"_5":13408,"_26522":113781,"_2670":113823},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3172":66694,"_28020":66679,"_19450":113825,"_5":13408,"_26522":113781,"_2670":113826},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3172":66695,"_28020":66679,"_19450":113828,"_5":13408,"_26522":113784,"_2670":113829},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3172":66696,"_28020":66679,"_19450":113831,"_5":13408,"_26522":113784,"_2670":113832},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3172":66697,"_28020":66679,"_19450":113834,"_5":13408,"_26522":113788,"_2670":113835},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3172":66698,"_28020":66679,"_19450":113837,"_5":13408,"_26522":113788,"_2670":113838},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3172":66699,"_28020":66679,"_19450":113840,"_5":13408,"_26522":113792,"_2670":113841},[],"Selecciona **Root CA** y completa:",{"_3172":66700,"_28020":66679,"_19450":113843,"_5":13408,"_26522":113792,"_2670":52575},[],{"_3172":66701,"_28020":66679,"_19450":113845,"_5":13408,"_26522":113792,"_2670":113846},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3172":66702,"_28020":66679,"_19450":113848,"_5":13408,"_26522":113792,"_2670":113849},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3172":66703,"_28020":66679,"_19450":113851,"_5":13408,"_26522":113792,"_2670":113852},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3172":66704,"_28020":66679,"_19450":113854,"_5":13408,"_26522":113792,"_2670":113855},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3172":66705,"_28020":66679,"_19450":113857,"_5":13408,"_26522":113796,"_2670":113858},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3172":66706,"_28020":66679,"_19450":113860,"_5":13408,"_26522":113800,"_2670":113861},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3172":66707,"_28020":66679,"_19450":113863,"_5":13408,"_26522":113800,"_2670":113864},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3172":66708,"_28020":66679,"_19450":113866,"_5":13408,"_26522":113804,"_2670":113867},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3172":66709,"_28020":66679,"_19450":113869,"_5":13408,"_26522":113804,"_2670":113870},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3172":66710,"_28020":66679,"_19450":113872,"_5":13408,"_26522":113804,"_2670":113873},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3172":66711,"_28020":66679,"_19450":113875,"_5":13408,"_26522":113808,"_2670":113876},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3172":66712,"_28020":66679,"_19450":113878,"_5":13408,"_26522":113808,"_2670":113879},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3172":66713,"_28020":66679,"_19450":113881,"_5":13408,"_26522":113808,"_2670":113882},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3172":66714,"_28020":66679,"_19450":113884,"_5":13408,"_26522":113808,"_2670":113885},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3172":66715,"_28020":66679,"_19450":113887,"_5":13408,"_26522":113811,"_2670":113888},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3172":66716,"_28020":66716,"_5":13734,"_2670":113890,"_28372":113891,"_19450":113892,"_26522":66716},"Emite y verifica un certificado",[45500,108282,50576,111321],[],{"_3172":66717,"_28020":66716,"_19450":113894,"_5":13408,"_26522":66716,"_2670":113895},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3172":66718,"_28020":66716,"_5":28369,"_19450":113897,"_26522":113898,"_2670":106948},[],"/docs/pr-preview/pr-51/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3172":66719,"_28020":66716,"_5":28369,"_19450":113900,"_26522":113901,"_2670":113902},[],"/docs/pr-preview/pr-51/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3172":66720,"_28020":66716,"_5":28369,"_19450":113904,"_26522":113905,"_2670":113906},[],"/docs/pr-preview/pr-51/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3172":66721,"_28020":66716,"_5":28369,"_19450":113908,"_26522":113909,"_2670":113910},[],"/docs/pr-preview/pr-51/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3172":66722,"_28020":66716,"_5":28369,"_19450":113912,"_26522":113913,"_2670":113914},[],"/docs/pr-preview/pr-51/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3172":66723,"_28020":66716,"_5":28369,"_19450":113916,"_26522":113917,"_2670":113918},[],"/docs/pr-preview/pr-51/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3172":66724,"_28020":66716,"_5":28369,"_19450":113920,"_26522":113921,"_2670":113801},[],"/docs/pr-preview/pr-51/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_3172":66725,"_28020":66716,"_5":28369,"_19450":113923,"_26522":113924,"_2670":113925},[],"/docs/pr-preview/pr-51/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3172":66726,"_28020":66716,"_5":28369,"_19450":113927,"_26522":113928,"_2670":113929},[],"/docs/pr-preview/pr-51/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3172":66727,"_28020":66716,"_5":28369,"_19450":113931,"_26522":113932,"_2670":113933},[],"/docs/pr-preview/pr-51/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3172":66728,"_28020":66716,"_5":28369,"_19450":113935,"_26522":113936,"_2670":111569},[],"/docs/pr-preview/pr-51/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3172":66729,"_28020":66716,"_5":28369,"_19450":113938,"_26522":113939,"_2670":106972},[],"/docs/pr-preview/pr-51/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3172":66730,"_28020":66716,"_19450":113941,"_5":13408,"_26522":66716,"_2670":113942},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3172":66731,"_28020":66716,"_19450":113944,"_5":13408,"_26522":113898,"_2670":113945},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3172":66732,"_28020":66716,"_19450":113947,"_5":13408,"_26522":113898,"_2670":113948},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3172":66733,"_28020":66716,"_19450":113950,"_5":13408,"_26522":113898,"_2670":113951},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3172":66734,"_28020":66716,"_19450":113953,"_5":13408,"_26522":113898,"_2670":113954},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3172":66735,"_28020":66716,"_19450":113956,"_5":13408,"_26522":113898,"_2670":113957},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3172":66736,"_28020":66716,"_19450":113959,"_5":13408,"_26522":113901,"_2670":113960},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3172":66737,"_28020":66716,"_19450":113962,"_5":13408,"_26522":113905,"_2670":113963},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3172":66738,"_28020":66716,"_19450":113965,"_5":13408,"_26522":113905,"_2670":113966},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3172":66739,"_28020":66716,"_19450":113968,"_5":13408,"_26522":113909,"_2670":113969},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3172":66740,"_28020":66716,"_19450":113971,"_5":13408,"_26522":113909,"_2670":113972},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3172":66741,"_28020":66716,"_19450":113974,"_5":13408,"_26522":113913,"_2670":113975},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3172":66742,"_28020":66716,"_19450":113977,"_5":13408,"_26522":113913,"_2670":113978},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3172":66743,"_28020":66716,"_19450":113980,"_5":13408,"_26522":113917,"_2670":113981},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3172":66744,"_28020":66716,"_19450":113983,"_5":13408,"_26522":113921,"_2670":113984},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3172":66745,"_28020":66716,"_19450":113986,"_5":13408,"_26522":113924,"_2670":113987},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3172":66746,"_28020":66716,"_19450":113989,"_5":13408,"_26522":113928,"_2670":113990},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3172":66747,"_28020":66716,"_19450":113992,"_5":13408,"_26522":113928,"_2670":113993},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3172":66748,"_28020":66716,"_19450":113995,"_5":13408,"_26522":113928,"_2670":113996},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3172":66749,"_28020":66716,"_19450":113998,"_5":13408,"_26522":113932,"_2670":113999},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3172":66750,"_28020":66716,"_19450":114001,"_5":13408,"_26522":113932,"_2670":114002},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3172":66751,"_28020":66716,"_19450":114004,"_5":13408,"_26522":113932,"_2670":114005},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3172":66752,"_28020":66716,"_19450":114007,"_5":13408,"_26522":113936,"_2670":111652},[],{"_3172":66753,"_28020":66716,"_19450":114009,"_5":13408,"_26522":113936,"_2670":110419},[],{"_3172":66754,"_28020":66716,"_19450":114011,"_5":13408,"_26522":113936,"_2670":114012},[],"La CA rechaza la emisión",{"_3172":66755,"_28020":66716,"_19450":114014,"_5":13408,"_26522":113936,"_2670":114015},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3172":66756,"_28020":66716,"_19450":114017,"_5":13408,"_26522":113936,"_2670":114018},[],"Sujeto o usos diferentes",{"_3172":66757,"_28020":66716,"_19450":114020,"_5":13408,"_26522":113936,"_2670":114021},[],"Perfil aplicado y valores solicitados.",{"_3172":66758,"_28020":66716,"_19450":114023,"_5":13408,"_26522":113936,"_2670":114024},[],"No se encuentra el emisor",{"_3172":66759,"_28020":66716,"_19450":114026,"_5":13408,"_26522":113936,"_2670":114027},[],"CA descargada y cadena intermedia necesaria.",{"_3172":66760,"_28020":66716,"_19450":114029,"_5":13408,"_26522":113936,"_2670":114030},[],"Falla la vigencia",{"_3172":66761,"_28020":66716,"_19450":114032,"_5":13408,"_26522":113936,"_2670":114033},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3172":66762,"_28020":66716,"_19450":114035,"_5":13408,"_26522":113936,"_2670":114036},[],"Los resúmenes de clave difieren",{"_3172":66763,"_28020":66716,"_19450":114038,"_5":13408,"_26522":113936,"_2670":114039},[],"Archivos de certificado y clave de la misma emisión.",{"_3172":66764,"_28020":66716,"_19450":114041,"_5":13408,"_26522":113936,"_2670":114042},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3172":66765,"_28020":66716,"_19450":114044,"_5":13408,"_26522":113939,"_2670":114045},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3172":66766,"_28020":66716,"_19450":114047,"_5":13408,"_26522":113939,"_2670":114048},[],"Gestionar certificados para inspección, estado y revocación.",{"_3172":66767,"_28020":66716,"_19450":114050,"_5":13408,"_26522":113939,"_2670":114051},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3172":66768,"_28020":66716,"_19450":114053,"_5":13408,"_26522":113939,"_2670":114054},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3172":66769,"_28020":66716,"_19450":114056,"_5":13408,"_26522":113939,"_2670":114057},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3172":66770,"_28020":66770,"_5":13734,"_2670":114059,"_28372":114060,"_19450":114061,"_26522":66770},"Primeros pasos de PKI",[45500,108282,50576,111321],[],{"_3172":66771,"_28020":66770,"_19450":114063,"_5":13408,"_26522":66770,"_2670":114064},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3172":66772,"_28020":66770,"_5":28369,"_19450":114066,"_26522":114067,"_2670":106948},[],"/docs/pr-preview/pr-51/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3172":66773,"_28020":66770,"_5":28369,"_19450":114069,"_26522":114070,"_2670":114071},[],"/docs/pr-preview/pr-51/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3172":66774,"_28020":66770,"_5":28369,"_19450":114073,"_26522":114074,"_2670":111503},[],"/docs/pr-preview/pr-51/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3172":66775,"_28020":66770,"_5":28369,"_19450":114076,"_26522":114077,"_2670":114078},[],"/docs/pr-preview/pr-51/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3172":66776,"_28020":66770,"_19450":114080,"_5":13408,"_26522":66770,"_2670":114081},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3172":66777,"_28020":66770,"_19450":114083,"_5":13408,"_26522":114067,"_2670":114084},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3172":66778,"_28020":66770,"_19450":114086,"_5":13408,"_26522":114067,"_2670":114087},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3172":66779,"_28020":66770,"_19450":114089,"_5":13408,"_26522":114067,"_2670":114090},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3172":66780,"_28020":66770,"_19450":114092,"_5":13408,"_26522":114067,"_2670":114093},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3172":66781,"_28020":66770,"_19450":114095,"_5":13408,"_26522":114067,"_2670":114096},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3172":66782,"_28020":66770,"_19450":114098,"_5":13408,"_26522":114070,"_2670":114099},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3172":66783,"_28020":66770,"_19450":114101,"_5":13408,"_26522":114070,"_2670":114102},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3172":66784,"_28020":66770,"_19450":114104,"_5":13408,"_26522":114070,"_2670":114105},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3172":66785,"_28020":66770,"_19450":114107,"_5":13408,"_26522":114070,"_2670":114108},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3172":66786,"_28020":66770,"_19450":114110,"_5":13408,"_26522":114074,"_2670":114111},[],"Archivo o recurso",{"_3172":66787,"_28020":66770,"_19450":114113,"_5":13408,"_26522":114074,"_2670":111500},[],{"_3172":66788,"_28020":66770,"_19450":114115,"_5":13408,"_26522":114074,"_2670":114116},[],"CA raíz activa y `ca.pem`",{"_3172":66789,"_28020":66770,"_19450":114118,"_5":13408,"_26522":114074,"_2670":114119},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3172":66790,"_28020":66770,"_19450":114121,"_5":13408,"_26522":114074,"_2670":114122},[],"Certificado final y `device.crt`",{"_3172":66791,"_28020":66770,"_19450":114124,"_5":13408,"_26522":114074,"_2670":114125},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3172":66792,"_28020":66770,"_19450":114127,"_5":13408,"_26522":114074,"_2670":114128},[],"Clave privada `device.key`",{"_3172":66793,"_28020":66770,"_19450":114130,"_5":13408,"_26522":114074,"_2670":114131},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3172":66794,"_28020":66770,"_19450":114133,"_5":13408,"_26522":114074,"_2670":114134},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3172":66795,"_28020":66770,"_19450":114136,"_5":13408,"_26522":114077,"_2670":114137},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3172":66796,"_28020":66770,"_19450":114139,"_5":13408,"_26522":114077,"_2670":114140},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3172":66797,"_28020":66770,"_19450":114142,"_5":13408,"_26522":114077,"_2670":114143},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3172":66798,"_28020":66798,"_5":13734,"_2670":114145,"_28372":114146,"_19450":114148,"_26522":66798},"Resolución de problemas PKI",[45500,108282,50576,114147],"Resolución de problemas",[],{"_3172":66799,"_28020":66798,"_19450":114150,"_5":13408,"_26522":66798,"_2670":114151},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3172":66800,"_28020":66798,"_5":28369,"_19450":114153,"_26522":114154,"_2670":114155},[],"/docs/pr-preview/pr-51/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3172":66801,"_28020":66798,"_5":28369,"_19450":114157,"_26522":114158,"_2670":114159},[],"/docs/pr-preview/pr-51/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3172":66802,"_28020":66798,"_5":28369,"_19450":114161,"_26522":114162,"_2670":114163},[],"/docs/pr-preview/pr-51/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3172":66803,"_28020":66798,"_19450":114165,"_5":13408,"_26522":66798,"_2670":114166},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3172":66804,"_28020":66798,"_19450":114168,"_5":13408,"_26522":66798,"_2670":114169},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3172":66805,"_28020":66798,"_19450":114171,"_5":13408,"_26522":114154,"_2670":111500},[],{"_3172":66806,"_28020":66798,"_19450":114173,"_5":13408,"_26522":114154,"_2670":110419},[],{"_3172":66807,"_28020":66798,"_19450":114175,"_5":13408,"_26522":114154,"_2670":106972},[],{"_3172":66808,"_28020":66798,"_19450":114177,"_5":13408,"_26522":114154,"_2670":52911},[],{"_3172":66809,"_28020":66798,"_19450":114179,"_5":13408,"_26522":114154,"_2670":114180},[],"Existe, está activa y sus fechas son utilizables.",{"_3172":66810,"_28020":66798,"_19450":114182,"_5":13408,"_26522":114154,"_2670":114183},[],"Autoridades.",{"_3172":66811,"_28020":66798,"_19450":114185,"_5":13408,"_26522":114154,"_2670":114186},[],"Clave",{"_3172":66812,"_28020":66798,"_19450":114188,"_5":13408,"_26522":114154,"_2670":114189},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3172":66813,"_28020":66798,"_19450":114191,"_5":13408,"_26522":114154,"_2670":114192},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3172":66814,"_28020":66798,"_19450":114194,"_5":13408,"_26522":114154,"_2670":52929},[],{"_3172":66815,"_28020":66798,"_19450":114196,"_5":13408,"_26522":114154,"_2670":114197},[],"PEM correcto y firma verificable.",{"_3172":66816,"_28020":66798,"_19450":114199,"_5":13408,"_26522":114154,"_2670":52935},[],{"_3172":66817,"_28020":66798,"_19450":114201,"_5":13408,"_26522":114154,"_2670":114202},[],"Perfil",{"_3172":66818,"_28020":66798,"_19450":114204,"_5":13408,"_26522":114154,"_2670":114205},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3172":66819,"_28020":66798,"_19450":114207,"_5":13408,"_26522":114154,"_2670":114208},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3172":66820,"_28020":66798,"_19450":114210,"_5":13408,"_26522":114154,"_2670":111652},[],{"_3172":66821,"_28020":66798,"_19450":114212,"_5":13408,"_26522":114154,"_2670":114213},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3172":66822,"_28020":66798,"_19450":114215,"_5":13408,"_26522":114154,"_2670":114216},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3172":66823,"_28020":66798,"_19450":114218,"_5":13408,"_26522":114154,"_2670":114219},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3172":66824,"_28020":66798,"_19450":114221,"_5":13408,"_26522":114154,"_2670":114222},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3172":66825,"_28020":66798,"_19450":114224,"_5":13408,"_26522":114158,"_2670":114225},[],"Revisa cada frontera por separado:",{"_3172":66826,"_28020":66798,"_19450":114227,"_5":13408,"_26522":114158,"_2670":114228},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3172":66827,"_28020":66798,"_19450":114230,"_5":13408,"_26522":114158,"_2670":114231},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3172":66828,"_28020":66798,"_19450":114233,"_5":13408,"_26522":114158,"_2670":114234},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3172":66829,"_28020":66798,"_19450":114236,"_5":13408,"_26522":114158,"_2670":114237},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3172":66830,"_28020":66798,"_19450":114239,"_5":13408,"_26522":114158,"_2670":114240},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3172":66831,"_28020":66798,"_19450":114242,"_5":13408,"_26522":114158,"_2670":114243},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3172":66832,"_28020":66798,"_19450":114245,"_5":13408,"_26522":114162,"_2670":114246},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3172":66833,"_28020":66798,"_19450":114248,"_5":13408,"_26522":114162,"_2670":114249},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3172":66834,"_28020":66834,"_5":13734,"_2670":114251,"_28372":114252,"_19450":114253,"_26522":66834},"Seguridad",[45500],[],{"_3172":66835,"_28020":66834,"_19450":114255,"_5":13408,"_26522":66834,"_2670":114256},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3172":66836,"_28020":66834,"_5":28369,"_19450":114258,"_26522":114259,"_2670":114260},[],"/docs/pr-preview/pr-51/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3172":66837,"_28020":66834,"_5":28369,"_19450":114262,"_26522":114263,"_2670":114264},[],"/docs/pr-preview/pr-51/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3172":66838,"_28020":66834,"_5":28369,"_19450":114266,"_26522":114267,"_2670":114268},[],"/docs/pr-preview/pr-51/es/security#versiones-soportadas","Versiones soportadas",{"_3172":66839,"_28020":66834,"_5":28369,"_19450":114270,"_26522":114271,"_2670":114272},[],"/docs/pr-preview/pr-51/es/security#divulgación-responsable","Divulgación responsable",{"_3172":66840,"_28020":66834,"_19450":114274,"_5":13408,"_26522":66834,"_2670":114275},[],"¿Has encontrado una vulnerabilidad de seguridad en Lamassu? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3172":66841,"_28020":66834,"_19450":114277,"_5":13408,"_26522":114259,"_2670":114278},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3172":66842,"_28020":66834,"_19450":114280,"_5":13408,"_26522":114259,"_2670":114281},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para ese repositorio. Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3172":66843,"_28020":66834,"_19450":114283,"_5":13408,"_26522":114259,"_2670":114284},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3172":66844,"_28020":66834,"_19450":114286,"_5":13408,"_26522":114263,"_2670":114287},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3172":66845,"_28020":66834,"_19450":114289,"_5":13408,"_26522":114263,"_2670":114290},[],"No incluyas en el reporte:",{"_3172":66846,"_28020":66834,"_19450":114292,"_5":13408,"_26522":114263,"_2670":114293},[],"Credenciales, tokens o claves privadas",{"_3172":66847,"_28020":66834,"_19450":114295,"_5":13408,"_26522":114263,"_2670":114296},[],"Datos de clientes o información identificable de clientes",{"_3172":66848,"_28020":66834,"_19450":114298,"_5":13408,"_26522":114263,"_2670":114299},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3172":66849,"_28020":66834,"_19450":114301,"_5":13408,"_26522":114267,"_2670":114302},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3172":66850,"_28020":66834,"_19450":114304,"_5":13408,"_26522":114267,"_2670":114305},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3172":66851,"_28020":66834,"_19450":114307,"_5":13408,"_26522":114271,"_2670":114308},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3172":66852,"_28020":66834,"_19450":114310,"_5":13408,"_26522":114271,"_2670":114311},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3172":66853,"_28020":66834,"_19450":114313,"_5":13408,"_26522":114271,"_2670":114314},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3172":66854,"_28020":66834,"_19450":114316,"_5":13408,"_26522":114271,"_2670":114317},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3172":66855,"_28020":66834,"_19450":114319,"_5":13408,"_26522":114271,"_2670":114320},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de este repositorio.",{"_3172":66856,"_28020":66856,"_5":13734,"_2670":114322,"_28372":114323,"_19450":114325,"_26522":66856},"3.8.0 a 4.0.0",[45500,114324],"Actualizaciones",[],{"_3172":66857,"_28020":66856,"_19450":114327,"_5":13408,"_26522":66856,"_2670":114328},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3172":66858,"_28020":66856,"_5":28369,"_19450":114330,"_26522":114331,"_2670":114332},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3172":66859,"_28020":66856,"_5":28369,"_19450":114334,"_26522":114335,"_2670":114336},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3172":66860,"_28020":66856,"_5":28369,"_19450":114338,"_26522":114339,"_2670":114340},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3172":66861,"_28020":66856,"_5":28369,"_19450":114342,"_26522":114343,"_2670":114344},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3172":66862,"_28020":66856,"_5":28369,"_19450":114346,"_26522":114347,"_2670":114348},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3172":66863,"_28020":66856,"_5":28369,"_19450":114350,"_26522":114351,"_2670":114352},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3172":66864,"_28020":66856,"_5":28369,"_19450":114354,"_26522":114355,"_2670":53092},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3172":66865,"_28020":66856,"_5":28369,"_19450":114357,"_26522":114358,"_2670":114359},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3172":66866,"_28020":66856,"_5":28369,"_19450":114361,"_26522":114362,"_2670":114363},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3172":66867,"_28020":66856,"_5":28369,"_19450":114365,"_26522":114366,"_2670":114367},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3172":66868,"_28020":66856,"_5":28369,"_19450":114369,"_26522":114370,"_2670":114371},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3172":66869,"_28020":66856,"_5":28369,"_19450":114373,"_26522":114374,"_2670":114375},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3172":66870,"_28020":66856,"_5":28369,"_19450":114377,"_26522":114378,"_2670":114379},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3172":66871,"_28020":66856,"_5":28369,"_19450":114381,"_26522":114382,"_2670":114383},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3172":66872,"_28020":66856,"_5":28369,"_19450":114385,"_26522":114386,"_2670":114387},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3172":66873,"_28020":66856,"_5":28369,"_19450":114389,"_26522":114390,"_2670":114391},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3172":66874,"_28020":66856,"_5":28369,"_19450":114393,"_26522":114394,"_2670":114395},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3172":66875,"_28020":66856,"_5":28369,"_19450":114397,"_26522":114398,"_2670":114399},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3172":66876,"_28020":66856,"_5":28369,"_19450":114401,"_26522":114402,"_2670":114403},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3172":66877,"_28020":66856,"_5":28369,"_19450":114405,"_26522":114406,"_2670":114407},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3172":66878,"_28020":66856,"_5":28369,"_19450":114409,"_26522":114410,"_2670":114411},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3172":66879,"_28020":66856,"_5":28369,"_19450":114413,"_26522":114414,"_2670":114415},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3172":66880,"_28020":66856,"_5":28369,"_19450":114417,"_26522":114418,"_2670":114419},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3172":66881,"_28020":66856,"_5":28369,"_19450":114421,"_26522":114422,"_2670":114423},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3172":66882,"_28020":66856,"_5":28369,"_19450":114425,"_26522":114426,"_2670":114427},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3172":66883,"_28020":66856,"_5":28369,"_19450":114429,"_26522":114430,"_2670":114431},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3172":66884,"_28020":66856,"_5":28369,"_19450":114433,"_26522":114434,"_2670":114435},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3172":66885,"_28020":66856,"_5":28369,"_19450":114437,"_26522":114438,"_2670":114439},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3172":66886,"_28020":66856,"_5":28369,"_19450":114441,"_26522":114442,"_2670":114443},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3172":66887,"_28020":66856,"_5":28369,"_19450":114445,"_26522":114446,"_2670":114447},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3172":66888,"_28020":66856,"_5":28369,"_19450":114449,"_26522":114450,"_2670":114451},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3172":66889,"_28020":66856,"_5":28369,"_19450":114453,"_26522":114454,"_2670":114455},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3172":66890,"_28020":66856,"_5":28369,"_19450":114457,"_26522":114458,"_2670":114459},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3172":66891,"_28020":66856,"_5":28369,"_19450":114461,"_26522":114462,"_2670":110741},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3172":66892,"_28020":66856,"_5":28369,"_19450":114464,"_26522":114465,"_2670":114466},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3172":66893,"_28020":66856,"_5":28369,"_19450":114468,"_26522":114469,"_2670":114470},[],"/docs/pr-preview/pr-51/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3172":66894,"_28020":66856,"_19450":114472,"_5":13408,"_26522":66856,"_2670":114473},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3172":66895,"_28020":66856,"_19450":114475,"_5":13408,"_26522":66856,"_2670":114476},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3172":66896,"_28020":66856,"_19450":114478,"_5":13408,"_26522":66856,"_2670":114479},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3172":66897,"_28020":66856,"_19450":114481,"_5":13408,"_26522":66856,"_2670":114482},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3172":66898,"_28020":66856,"_19450":114484,"_5":13408,"_26522":66856,"_2670":114485},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3172":66899,"_28020":66856,"_19450":114487,"_5":13408,"_26522":66856,"_2670":114488},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3172":66900,"_28020":66856,"_19450":114490,"_5":13408,"_26522":66856,"_2670":114491},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3172":66901,"_28020":66856,"_19450":114493,"_5":13408,"_26522":114335,"_2670":114494},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3172":66902,"_28020":66856,"_19450":114496,"_5":13408,"_26522":114335,"_2670":114497},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3172":66903,"_28020":66856,"_19450":114499,"_5":13408,"_26522":114339,"_2670":114500},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3172":66904,"_28020":66856,"_19450":114502,"_5":13408,"_26522":114339,"_2670":114503},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3172":66905,"_28020":66856,"_19450":114505,"_5":13408,"_26522":114343,"_2670":114506},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3172":66906,"_28020":66856,"_19450":114508,"_5":13408,"_26522":114347,"_2670":114509},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3172":66907,"_28020":66856,"_19450":114511,"_5":13408,"_26522":114347,"_2670":114512},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3172":66908,"_28020":66856,"_19450":114514,"_5":13408,"_26522":114347,"_2670":114515},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3172":66909,"_28020":66856,"_19450":114517,"_5":13408,"_26522":114347,"_2670":114518},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3172":66910,"_28020":66856,"_19450":114520,"_5":13408,"_26522":114347,"_2670":114521},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3172":66911,"_28020":66856,"_19450":114523,"_5":13408,"_26522":114351,"_2670":114524},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3172":66912,"_28020":66856,"_19450":114526,"_5":13408,"_26522":114351,"_2670":114527},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3172":66913,"_28020":66856,"_19450":114529,"_5":13408,"_26522":114351,"_2670":114530},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3172":66914,"_28020":66856,"_19450":114532,"_5":13408,"_26522":114351,"_2670":114533},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3172":66915,"_28020":66856,"_19450":114535,"_5":13408,"_26522":114351,"_2670":114536},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3172":66916,"_28020":66856,"_19450":114538,"_5":13408,"_26522":114355,"_2670":114539},[],"Cambio",{"_3172":66917,"_28020":66856,"_19450":114541,"_5":13408,"_26522":114355,"_2670":114542},[],"A quién afecta",{"_3172":66918,"_28020":66856,"_19450":114544,"_5":13408,"_26522":114355,"_2670":114545},[],"Gravedad",{"_3172":66919,"_28020":66856,"_19450":114547,"_5":13408,"_26522":114355,"_2670":114548},[],"Acción",{"_3172":66920,"_28020":66856,"_19450":114550,"_5":13408,"_26522":114355,"_2670":114363},[],{"_3172":66921,"_28020":66856,"_19450":114552,"_5":13408,"_26522":114355,"_2670":114553},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3172":66922,"_28020":66856,"_19450":114555,"_5":13408,"_26522":114355,"_2670":114556},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3172":66923,"_28020":66856,"_19450":114558,"_5":13408,"_26522":114355,"_2670":114559},[],"Copiar los datos a los volúmenes nuevos",{"_3172":66924,"_28020":66856,"_19450":114561,"_5":13408,"_26522":114355,"_2670":114367},[],{"_3172":66925,"_28020":66856,"_19450":114563,"_5":13408,"_26522":114355,"_2670":114564},[],"Todas las releases de Helm",{"_3172":66926,"_28020":66856,"_19450":114566,"_5":13408,"_26522":114355,"_2670":114567},[],"Alta: `helm upgrade` falla",{"_3172":66927,"_28020":66856,"_19450":114569,"_5":13408,"_26522":114355,"_2670":114570},[],"Eliminar o renombrar las claves heredadas",{"_3172":66928,"_28020":66856,"_19450":114572,"_5":13408,"_26522":114355,"_2670":114371},[],{"_3172":66929,"_28020":66856,"_19450":114574,"_5":13408,"_26522":114355,"_2670":114575},[],"Todos los despliegues",{"_3172":66930,"_28020":66856,"_19450":114577,"_5":13408,"_26522":114355,"_2670":114578},[],"Alta: sin principal de bootstrap no hay administrador",{"_3172":66931,"_28020":66856,"_19450":114580,"_5":13408,"_26522":114355,"_2670":114581},[],"Configurar `services.authz`",{"_3172":66932,"_28020":66856,"_19450":114583,"_5":13408,"_26522":114355,"_2670":114375},[],{"_3172":66933,"_28020":66856,"_19450":114585,"_5":13408,"_26522":114355,"_2670":114564},[],{"_3172":66934,"_28020":66856,"_19450":114587,"_5":13408,"_26522":114355,"_2670":114588},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3172":66935,"_28020":66856,"_19450":114590,"_5":13408,"_26522":114355,"_2670":114591},[],"Mover JWKS y roles a `services.authz`",{"_3172":66936,"_28020":66856,"_19450":114593,"_5":13408,"_26522":114355,"_2670":114395},[],{"_3172":66937,"_28020":66856,"_19450":114595,"_5":13408,"_26522":114355,"_2670":114596},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3172":66938,"_28020":66856,"_19450":114598,"_5":13408,"_26522":114355,"_2670":114599},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3172":66939,"_28020":66856,"_19450":114601,"_5":13408,"_26522":114355,"_2670":114602},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3172":66940,"_28020":66856,"_19450":114604,"_5":13408,"_26522":114355,"_2670":114399},[],{"_3172":66941,"_28020":66856,"_19450":114606,"_5":13408,"_26522":114355,"_2670":114607},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3172":66942,"_28020":66856,"_19450":114609,"_5":13408,"_26522":114355,"_2670":114610},[],"Alta: el backend ya no arranca con ellos",{"_3172":66943,"_28020":66856,"_19450":114612,"_5":13408,"_26522":114355,"_2670":114613},[],"Pasar a PostgreSQL antes de actualizar",{"_3172":66944,"_28020":66856,"_19450":114615,"_5":13408,"_26522":114355,"_2670":114616},[],"Webhooks con referencias a archivos",{"_3172":66945,"_28020":66856,"_19450":114618,"_5":13408,"_26522":114355,"_2670":114619},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3172":66946,"_28020":66856,"_19450":114621,"_5":13408,"_26522":114355,"_2670":114622},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3172":66947,"_28020":66856,"_19450":114624,"_5":13408,"_26522":114355,"_2670":114625},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3172":66948,"_28020":66856,"_19450":114627,"_5":13408,"_26522":114355,"_2670":114379},[],{"_3172":66949,"_28020":66856,"_19450":114629,"_5":13408,"_26522":114355,"_2670":114630},[],"Releases con identidades por servicio o material de claves montado",{"_3172":66950,"_28020":66856,"_19450":114632,"_5":13408,"_26522":114355,"_2670":114633},[],"Media: los servicios no pueden leer sus archivos",{"_3172":66951,"_28020":66856,"_19450":114635,"_5":13408,"_26522":114355,"_2670":114636},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3172":66952,"_28020":66856,"_19450":114638,"_5":13408,"_26522":114355,"_2670":114383},[],{"_3172":66953,"_28020":66856,"_19450":114640,"_5":13408,"_26522":114355,"_2670":114641},[],"Releases que definen `amqp.tls`",{"_3172":66954,"_28020":66856,"_19450":114643,"_5":13408,"_26522":114355,"_2670":114644},[],"Media: los clientes se conectan al puerto equivocado",{"_3172":66955,"_28020":66856,"_19450":114646,"_5":13408,"_26522":114355,"_2670":114647},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3172":66956,"_28020":66856,"_19450":114649,"_5":13408,"_26522":114355,"_2670":114403},[],{"_3172":66957,"_28020":66856,"_19450":114651,"_5":13408,"_26522":114355,"_2670":114652},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3172":66958,"_28020":66856,"_19450":114654,"_5":13408,"_26522":114355,"_2670":114655},[],"Media: las claves de CA quedan sin gestionar",{"_3172":66959,"_28020":66856,"_19450":114657,"_5":13408,"_26522":114355,"_2670":114658},[],"Ejecutar la migración de CA a KMS",{"_3172":66960,"_28020":66856,"_19450":114660,"_5":13408,"_26522":114355,"_2670":114661},[],"Verificación del certificado del receptor",{"_3172":66961,"_28020":66856,"_19450":114663,"_5":13408,"_26522":114355,"_2670":114664},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3172":66962,"_28020":66856,"_19450":114666,"_5":13408,"_26522":114355,"_2670":114667},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3172":66963,"_28020":66856,"_19450":114669,"_5":13408,"_26522":114355,"_2670":114670},[],"Poner `insecure_skip_verify` a `false`",{"_3172":66964,"_28020":66856,"_19450":114672,"_5":13408,"_26522":114355,"_2670":114415},[],{"_3172":66965,"_28020":66856,"_19450":114674,"_5":13408,"_26522":114355,"_2670":114675},[],"Scripts y consolas que editan DMS por API",{"_3172":66966,"_28020":66856,"_19450":114677,"_5":13408,"_26522":114355,"_2670":114678},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3172":66967,"_28020":66856,"_19450":114680,"_5":13408,"_26522":114355,"_2670":114681},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3172":66968,"_28020":66856,"_19450":114683,"_5":13408,"_26522":114355,"_2670":114431},[],{"_3172":66969,"_28020":66856,"_19450":114685,"_5":13408,"_26522":114355,"_2670":114686},[],"Consumidores que leen el campo `events` del dispositivo",{"_3172":66970,"_28020":66856,"_19450":114688,"_5":13408,"_26522":114355,"_2670":114689},[],"Media: el campo desaparece",{"_3172":66971,"_28020":66856,"_19450":114691,"_5":13408,"_26522":114355,"_2670":114692},[],"Usar los nuevos endpoints de eventos",{"_3172":66972,"_28020":66856,"_19450":114694,"_5":13408,"_26522":114355,"_2670":114387},[],{"_3172":66973,"_28020":66856,"_19450":114696,"_5":13408,"_26522":114355,"_2670":114697},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3172":66974,"_28020":66856,"_19450":114699,"_5":13408,"_26522":114355,"_2670":114700},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3172":66975,"_28020":66856,"_19450":114702,"_5":13408,"_26522":114355,"_2670":114703},[],"Actualizar el archivo de values",{"_3172":66976,"_28020":66856,"_19450":114705,"_5":13408,"_26522":114355,"_2670":114423},[],{"_3172":66977,"_28020":66856,"_19450":114707,"_5":13408,"_26522":114355,"_2670":114708},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3172":66978,"_28020":66856,"_19450":114710,"_5":13408,"_26522":114355,"_2670":114711},[],"Baja: prevalece el ID de la URL",{"_3172":66979,"_28020":66856,"_19450":114713,"_5":13408,"_26522":114355,"_2670":114714},[],"Enviar el ID en la URL",{"_3172":66980,"_28020":66856,"_19450":114716,"_5":13408,"_26522":114355,"_2670":114427},[],{"_3172":66981,"_28020":66856,"_19450":114718,"_5":13408,"_26522":114355,"_2670":114719},[],"Consumidores que comparan el `type` del certificado",{"_3172":66982,"_28020":66856,"_19450":114721,"_5":13408,"_26522":114355,"_2670":114722},[],"Baja: dos valores cambian de nombre",{"_3172":66983,"_28020":66856,"_19450":114724,"_5":13408,"_26522":114355,"_2670":114725},[],"Adaptar los consumidores",{"_3172":66984,"_28020":66856,"_19450":114727,"_5":13408,"_26522":114355,"_2670":114419},[],{"_3172":66985,"_28020":66856,"_19450":114729,"_5":13408,"_26522":114355,"_2670":114730},[],"Cualquier DMS",{"_3172":66986,"_28020":66856,"_19450":114732,"_5":13408,"_26522":114355,"_2670":114733},[],"Baja: solo informativo",{"_3172":66987,"_28020":66856,"_19450":114735,"_5":13408,"_26522":114355,"_2670":114736},[],"Revisar ambos bloques antes de editar",{"_3172":66988,"_28020":66856,"_19450":114738,"_5":13408,"_26522":114362,"_2670":114739},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3172":66989,"_28020":66856,"_19450":114741,"_5":13408,"_26522":114362,"_2670":114742},[],"El paso 4 de la guía de migración copia los datos.",{"_3172":66990,"_28020":66856,"_19450":114744,"_5":13408,"_26522":114366,"_2670":114745},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3172":66991,"_28020":66856,"_19450":114747,"_5":13408,"_26522":114370,"_2670":114748},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3172":66992,"_28020":66856,"_19450":114750,"_5":13408,"_26522":114374,"_2670":114751},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3172":66993,"_28020":66856,"_19450":114753,"_5":13408,"_26522":114378,"_2670":114754},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3172":66994,"_28020":66856,"_19450":114756,"_5":13408,"_26522":114378,"_2670":114757},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3172":66995,"_28020":66856,"_19450":114759,"_5":13408,"_26522":114382,"_2670":114760},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3172":66996,"_28020":66856,"_19450":114762,"_5":13408,"_26522":114386,"_2670":114763},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3172":66997,"_28020":66856,"_19450":114765,"_5":13408,"_26522":114386,"_2670":114766},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3172":66998,"_28020":66856,"_19450":114768,"_5":13408,"_26522":114386,"_2670":114769},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3172":66999,"_28020":66856,"_19450":114771,"_5":13408,"_26522":114386,"_2670":114772},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3172":67000,"_28020":66856,"_19450":114774,"_5":13408,"_26522":114386,"_2670":114775},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3172":67001,"_28020":66856,"_19450":114777,"_5":13408,"_26522":114386,"_2670":114778},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3172":67002,"_28020":66856,"_19450":114780,"_5":13408,"_26522":114394,"_2670":114781},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3172":67003,"_28020":66856,"_19450":114783,"_5":13408,"_26522":114394,"_2670":114784},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3172":67004,"_28020":66856,"_19450":114786,"_5":13408,"_26522":114394,"_2670":114787},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3172":67005,"_28020":66856,"_19450":114789,"_5":13408,"_26522":114394,"_2670":114790},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3172":67006,"_28020":66856,"_19450":114792,"_5":13408,"_26522":114394,"_2670":114793},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3172":67007,"_28020":66856,"_19450":114795,"_5":13408,"_26522":114398,"_2670":114796},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3172":67008,"_28020":66856,"_19450":114798,"_5":13408,"_26522":114402,"_2670":114799},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3172":67009,"_28020":66856,"_19450":114801,"_5":13408,"_26522":114402,"_2670":114802},[],"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_3172":67010,"_28020":66856,"_19450":114804,"_5":13408,"_26522":114402,"_2670":114805},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3172":67011,"_28020":66856,"_19450":114807,"_5":13408,"_26522":114402,"_2670":114808},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3172":67012,"_28020":66856,"_19450":114810,"_5":13408,"_26522":114402,"_2670":114811},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3172":67013,"_28020":66856,"_19450":114813,"_5":13408,"_26522":114402,"_2670":114814},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3172":67014,"_28020":66856,"_19450":114816,"_5":13408,"_26522":114410,"_2670":114817},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3172":67015,"_28020":66856,"_19450":114819,"_5":13408,"_26522":114410,"_2670":114820},[],"Campo en 3.8.0",{"_3172":67016,"_28020":66856,"_19450":114822,"_5":13408,"_26522":114410,"_2670":114823},[],"Campo en 4.0.0",{"_3172":67017,"_28020":66856,"_19450":114825,"_5":13408,"_26522":114410,"_2670":53563},[],{"_3172":67018,"_28020":66856,"_19450":114827,"_5":13408,"_26522":114410,"_2670":114828},[],"`insecure_skip_verify` (con el valor negado)",{"_3172":67019,"_28020":66856,"_19450":114830,"_5":13408,"_26522":114410,"_2670":53569},[],{"_3172":67020,"_28020":66856,"_19450":114832,"_5":13408,"_26522":114410,"_2670":53572},[],{"_3172":67021,"_28020":66856,"_19450":114834,"_5":13408,"_26522":114410,"_2670":53575},[],{"_3172":67022,"_28020":66856,"_19450":114836,"_5":13408,"_26522":114410,"_2670":53578},[],{"_3172":67023,"_28020":66856,"_19450":114838,"_5":13408,"_26522":114410,"_2670":53581},[],{"_3172":67024,"_28020":66856,"_19450":114840,"_5":13408,"_26522":114410,"_2670":53584},[],{"_3172":67025,"_28020":66856,"_19450":114842,"_5":13408,"_26522":114410,"_2670":114843},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3172":67026,"_28020":66856,"_19450":114845,"_5":13408,"_26522":114410,"_2670":114846},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3172":67027,"_28020":66856,"_19450":114848,"_5":13408,"_26522":114410,"_2670":114849},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3172":67028,"_28020":66856,"_19450":114851,"_5":13408,"_26522":114414,"_2670":114852},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3172":67029,"_28020":66856,"_19450":114854,"_5":13408,"_26522":114414,"_2670":114855},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3172":67030,"_28020":66856,"_19450":114857,"_5":13408,"_26522":114414,"_2670":114858},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3172":67031,"_28020":66856,"_19450":114860,"_5":13408,"_26522":114418,"_2670":114861},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. Si la versión de la consola no expone los ajustes independientes, edítalos mediante la API DMS.",{"_3172":67032,"_28020":66856,"_19450":114863,"_5":13408,"_26522":114422,"_2670":114864},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3172":67033,"_28020":66856,"_19450":114866,"_5":13408,"_26522":114426,"_2670":114867},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3172":67034,"_28020":66856,"_19450":114869,"_5":13408,"_26522":114430,"_2670":114870},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3172":67035,"_28020":66856,"_19450":114872,"_5":13408,"_26522":114430,"_2670":114873},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3172":67036,"_28020":66856,"_19450":114875,"_5":13408,"_26522":114430,"_2670":114876},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3172":67037,"_28020":66856,"_19450":114878,"_5":13408,"_26522":114430,"_2670":114879},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3172":67038,"_28020":66856,"_19450":114881,"_5":13408,"_26522":114434,"_2670":114882},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3172":67039,"_28020":66856,"_19450":114884,"_5":13408,"_26522":114438,"_2670":114885},[],"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`.",{"_3172":67040,"_28020":66856,"_19450":114887,"_5":13408,"_26522":114438,"_2670":114888},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3172":67041,"_28020":66856,"_19450":114890,"_5":13408,"_26522":114438,"_2670":114891},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3172":67042,"_28020":66856,"_19450":114893,"_5":13408,"_26522":114438,"_2670":114894},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3172":67043,"_28020":66856,"_19450":114896,"_5":13408,"_26522":114438,"_2670":114897},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3172":67044,"_28020":66856,"_19450":114899,"_5":13408,"_26522":114442,"_2670":114900},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3172":67045,"_28020":66856,"_19450":114902,"_5":13408,"_26522":114442,"_2670":114903},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3172":67046,"_28020":66856,"_19450":114905,"_5":13408,"_26522":114442,"_2670":114906},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3172":67047,"_28020":66856,"_19450":114908,"_5":13408,"_26522":114442,"_2670":114909},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3172":67048,"_28020":66856,"_19450":114911,"_5":13408,"_26522":114442,"_2670":114912},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3172":67049,"_28020":66856,"_19450":114914,"_5":13408,"_26522":114442,"_2670":114915},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3172":67050,"_28020":66856,"_19450":114917,"_5":13408,"_26522":114442,"_2670":114918},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3172":67051,"_28020":66856,"_19450":114920,"_5":13408,"_26522":114442,"_2670":114921},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3172":67052,"_28020":66856,"_19450":114923,"_5":13408,"_26522":114442,"_2670":114924},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3172":67053,"_28020":66856,"_19450":114926,"_5":13408,"_26522":114442,"_2670":114927},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3172":67054,"_28020":66856,"_19450":114929,"_5":13408,"_26522":114442,"_2670":114930},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3172":67055,"_28020":66856,"_19450":114932,"_5":13408,"_26522":114442,"_2670":114933},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3172":67056,"_28020":66856,"_19450":114935,"_5":13408,"_26522":114446,"_2670":114936},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3172":67057,"_28020":66856,"_19450":114938,"_5":13408,"_26522":114446,"_2670":114939},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3172":67058,"_28020":66856,"_19450":114941,"_5":13408,"_26522":114450,"_2670":114942},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3172":67059,"_28020":66856,"_19450":114944,"_5":13408,"_26522":114450,"_2670":114945},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3172":67060,"_28020":66856,"_19450":114947,"_5":13408,"_26522":114450,"_2670":114948},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3172":67061,"_28020":66856,"_19450":114950,"_5":13408,"_26522":114450,"_2670":114951},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3172":67062,"_28020":66856,"_19450":114953,"_5":13408,"_26522":114450,"_2670":114954},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3172":67063,"_28020":66856,"_19450":114956,"_5":13408,"_26522":114450,"_2670":114957},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3172":67064,"_28020":66856,"_19450":114959,"_5":13408,"_26522":114450,"_2670":114960},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3172":67065,"_28020":66856,"_19450":114962,"_5":13408,"_26522":114450,"_2670":114963},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3172":67066,"_28020":66856,"_19450":114965,"_5":13408,"_26522":114450,"_2670":114966},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3172":67067,"_28020":66856,"_19450":114968,"_5":13408,"_26522":114450,"_2670":114969},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3172":67068,"_28020":66856,"_19450":114971,"_5":13408,"_26522":114450,"_2670":114972},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3172":67069,"_28020":66856,"_19450":114974,"_5":13408,"_26522":114454,"_2670":114975},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3172":67070,"_28020":66856,"_19450":114977,"_5":13408,"_26522":114454,"_2670":114978},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3172":67071,"_28020":66856,"_19450":114980,"_5":13408,"_26522":114458,"_2670":114981},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3172":67072,"_28020":66856,"_19450":114983,"_5":13408,"_26522":114458,"_2670":114984},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3172":67073,"_28020":66856,"_19450":114986,"_5":13408,"_26522":114458,"_2670":114987},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3172":67074,"_28020":66856,"_19450":114989,"_5":13408,"_26522":114458,"_2670":114990},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3172":67075,"_28020":66856,"_19450":114992,"_5":13408,"_26522":114458,"_2670":114993},[],"El README de `goose-lamassu` aún muestra ejemplos por base de datos (`dbname=ca`, `dbname=kms`) y afirma que la herramienta valida el nombre de la base de datos, y el README de `ca-to-kms-migration` sigue describiendo el modelo de dos bases anterior a 4.0.0. Sigue la forma con `dbname=pki` de esta página en lugar de sus ejemplos.",{"_3172":67076,"_28020":66856,"_19450":114995,"_5":13408,"_26522":114462,"_2670":114996},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3172":67077,"_28020":66856,"_19450":114998,"_5":13408,"_26522":114462,"_2670":114999},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3172":67078,"_28020":66856,"_19450":115001,"_5":13408,"_26522":114462,"_2670":115002},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3172":67079,"_28020":66856,"_19450":115004,"_5":13408,"_26522":114462,"_2670":115005},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3172":67080,"_28020":66856,"_19450":115007,"_5":13408,"_26522":114462,"_2670":115008},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización.",{"_3172":67081,"_28020":66856,"_19450":115010,"_5":13408,"_26522":114462,"_2670":115011},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3172":67082,"_28020":66856,"_19450":115013,"_5":13408,"_26522":114462,"_2670":115014},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3172":67083,"_28020":66856,"_19450":115016,"_5":13408,"_26522":114465,"_2670":115017},[],"Tras la actualización, comprueba en este orden:",{"_3172":67084,"_28020":66856,"_19450":115019,"_5":13408,"_26522":114465,"_2670":115020},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS.",{"_3172":67085,"_28020":66856,"_19450":115022,"_5":13408,"_26522":114465,"_2670":115023},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3172":67086,"_28020":66856,"_19450":115025,"_5":13408,"_26522":114465,"_2670":115026},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3172":67087,"_28020":66856,"_19450":115028,"_5":13408,"_26522":114465,"_2670":115029},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas.",{"_3172":67088,"_28020":66856,"_19450":115031,"_5":13408,"_26522":114465,"_2670":115032},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS.",{"_3172":67089,"_28020":66856,"_19450":115034,"_5":13408,"_26522":114465,"_2670":115035},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3172":67090,"_28020":66856,"_19450":115037,"_5":13408,"_26522":114465,"_2670":115038},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3172":67091,"_28020":66856,"_19450":115040,"_5":13408,"_26522":114465,"_2670":115041},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3172":67092,"_28020":66856,"_19450":115043,"_5":13408,"_26522":114465,"_2670":115044},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3172":67093,"_28020":66856,"_19450":115046,"_5":13408,"_26522":114465,"_2670":115047},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3172":67094,"_28020":66856,"_19450":115049,"_5":13408,"_26522":114465,"_2670":115050},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3172":67095,"_28020":66856,"_19450":115052,"_5":13408,"_26522":114465,"_2670":115053},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3172":67096,"_28020":66856,"_19450":115055,"_5":13408,"_26522":114465,"_2670":115056},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3172":67097,"_28020":66856,"_19450":115058,"_5":13408,"_26522":114465,"_2670":115059},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3172":67098,"_28020":66856,"_19450":115061,"_5":13408,"_26522":114469,"_2670":115062},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3172":67099,"_28020":66856,"_19450":115064,"_5":13408,"_26522":114469,"_2670":115065},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3172":67100,"_28020":66856,"_19450":115067,"_5":13408,"_26522":114469,"_2670":115068},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3172":67101,"_28020":66856,"_19450":115070,"_5":13408,"_26522":114469,"_2670":115071},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3172":67102,"_28020":66856,"_19450":115073,"_5":13408,"_26522":114469,"_2670":115074},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_53821":115076,"_53823":115077,"_53825":115078,"_53827":115079,"_16988":2692,"_64446":2692},"spanish",[2670,28020,5,26522],{"_2670":23284,"_28020":23284,"_5":23284,"_26522":23284},{"_2670":115080,"_28020":117733,"_5":120386,"_26522":123039},{"_4258":115081,"_53831":115082,"_5":23284},{"_13463":6382,"_13833":16029,"_13852":4318,"_12071":11906,"_13839":6354,"_18476":18314,"_13484":5503,"_13491":12431,"_27074":7053,"_27465":3146,"_27486":4666,"_27092":5296,"_32186":2779,"_27497":23924,"_27526":2710,"_32193":27583,"_32196":4314,"_32199":3088,"_32202":6953,"_27873":4731,"_32207":5648,"_32209":13425,"_27903":10867,"_13848":2993,"_32213":6592,"_32216":2957,"_32218":3641,"_27515":7013,"_27868":19612,"_27927":5520,"_32223":16776,"_32225":6991,"_32227":5146,"_32229":3309,"_32231":20012,"_32233":3813,"_32235":6166,"_32237":6025,"_32239":4728,"_27144":4474,"_32242":22482,"_32244":6401,"_27138":19573,"_32247":6552,"_32249":8331,"_32251":6928,"_32254":5941,"_27184":22212,"_32258":4746,"_27065":4694,"_28078":5952,"_27097":2878,"_32263":5054,"_32265":7004,"_32268":3816,"_13842":14004,"_32271":3865,"_32273":2760,"_32276":4162,"_32278":7708,"_32280":18912,"_32282":5530,"_32284":8397,"_18479":10241,"_32287":20236,"_32289":13151,"_27118":12771,"_27509":10833,"_32293":23286,"_32295":5701,"_32297":3002,"_27933":3234,"_32300":4700,"_32302":11978,"_32304":5475,"_28000":3680,"_27542":15122,"_32308":3456,"_32310":3910,"_27107":5517,"_32313":5144,"_32315":3048,"_32317":10249,"_27938":3624,"_27204":4357,"_26586":6880,"_32322":6375,"_32324":4215,"_32326":4567,"_27241":6869,"_32330":4365,"_27503":2743,"_32334":11980,"_32336":3395,"_32338":18569,"_32340":20426,"_32342":13912,"_32344":4550,"_27230":4563,"_27470":3530,"_32348":6951,"_32350":6616,"_3235