control-6","page_id":"/docs/pr-preview/pr-52/es/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-52/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","content":"Cómo se relacionan ambos caminos"},"450":{"id":"/docs/pr-preview/pr-52/es/platform/administration/access-control-7","page_id":"/docs/pr-preview/pr-52/es/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-52/es/platform/administration/access-control#principales-oidc","content":"Principales OIDC"},"451":{"id":"/docs/pr-preview/pr-52/es/platform/administration/access-control-8","page_id":"/docs/pr-preview/pr-52/es/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-52/es/platform/administration/access-control#principales-x509","content":"Principales X.509"},"452":{"id":"/docs/pr-preview/pr-52/es/platform/administration/access-control-9","page_id":"/docs/pr-preview/pr-52/es/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-52/es/platform/administration/access-control#cuando-coinciden-varios-principales","content":"Cuando coinciden varios principales"},"453":{"id":"/docs/pr-preview/pr-52/es/platform/administration/access-control-10","page_id":"/docs/pr-preview/pr-52/es/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-52/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","content":"Cómo expresan acceso las políticas"},"454":{"id":"/docs/pr-preview/pr-52/es/platform/administration/access-control-11","page_id":"/docs/pr-preview/pr-52/es/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-52/es/platform/administration/access-control#acceso-global-y-acceso-directo","content":"Acceso global y acceso directo"},"455":{"id":"/docs/pr-preview/pr-52/es/platform/administration/access-control-12","page_id":"/docs/pr-p