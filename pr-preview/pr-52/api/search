osted/overview#what-the-lamassu-chart-provides","content":"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret"},"355":{"id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview-38","page_id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret"},"356":{"id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview-39","page_id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"Persistent application data"},"357":{"id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview-40","page_id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"PersistentVolumeClaims required by the default local KMS and VA storage"},"358":{"id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview-41","page_id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one"},"359":{"id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview-42","page_id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"Optional integrations"},"360":{"id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview-43","page_id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity"},"361":{"id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview-44","page_id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"The observability backends, cloud credentials and production HSM or external key service"},"362":{"id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview-45","page_id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network."},"363":{"id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview-46","page_id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service."},"364":{"id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview-47","page_id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/deployment/self-hosted/overview#how-the-deployment-fits-together","content":"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway."},"365":{"id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview-48","page_id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/deployment/self-hosted/overview#how-the-deployment-fits-together","content":"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it."},"366":{"id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview-49","page_id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/deployment/self-hosted/overview#platform-requirements","content":"Kubernetes 1.24 or newer"},"367":{"id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview-50","page_id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/deployment/self-hosted/overview#platform-requirements","content":"Helm 3.2 or newer"},"368":{"id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview-51","page_id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/deployment/self-hosted/overview#platform-requirements","content":"Envoy Gateway 1.8 or newer and a `GatewayClass`"},"369":{"id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview-52","page_id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/deployment/self-hosted/overview#platform-requirements","content":"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`"},"370":{"id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview-53","page_id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/deployment/self-hosted/overview#platform-requirements","content":"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration"},"371":{"id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview-54","page_id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/deployment/self-hosted/overview#platform-requirements","content":"a load-balancer implementation or another deliberate path from clients to the Gateway"},"372":{"id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview-55","page_id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/deployment/self-hosted/overview#platform-requirements","content":"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations."},"373":{"id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview-56","page_id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/deployment/self-hosted/overview#choose-the-next-page","content":"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />"},"374":{"id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview-57","page_id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/deployment/self-hosted/overview#choose-the-next-page","content":"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />"},"375":{"id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview-58","page_id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/deployment/self-hosted/overview#choose-the-next-page","content":"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />"},"376":{"id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview-59","page_id":"/docs/pr-preview/pr-52/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/deployment/self-hosted/overview#choose-the-next-page","content":"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />"},"377":{"id":"/docs/pr-preview/pr-52/deployment/troubleshooting","page_id":"/docs/pr-preview/pr-52/deployment/troubleshooting","type":"page","content":"Deployment troubleshooting","breadcrumbs":["Docs","Deployment","Operations"],"tags":[],"url":"/docs/pr-preview/pr-52/deployment/troubleshooting"},"378":{"id":"/docs/pr-preview/pr-52/deployment/troubleshooting-0","page_id":"/docs/pr-preview/pr-52/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/deployment/troubleshooting","content":"Diagnose access, service health and infrastructure dependencies."},"379":{"id":"/docs/pr-preview/pr-52/deployment/troubleshooting-1","page_id":"/docs/pr-preview/pr-52/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-52/deployment/troubleshooting#diagnostic-sequence","content":"Di