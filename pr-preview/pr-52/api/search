0#step-1-prepare","content":"Step 1: Prepare"},"2419":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-31","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","type":"heading","tags":[],"url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","content":"Step 2: Update the values file"},"2420":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-32","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","type":"heading","tags":[],"url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","content":"Step 3: Run the upgrade"},"2421":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-33","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","type":"heading","tags":[],"url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","content":"Step 4: Migrate the KMS and VA data"},"2422":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-34","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","type":"heading","tags":[],"url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","content":"Step 5: Remove the one-off migration values"},"2423":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-35","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","type":"heading","tags":[],"url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#deployments-without-helm","content":"Deployments without Helm"},"2424":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-36","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","type":"heading","tags":[],"url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#troubleshooting","content":"Troubleshooting"},"2425":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-37","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","type":"heading","tags":[],"url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#validation-checklist","content":"Validation checklist"},"2426":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-38","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","type":"heading","tags":[],"url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","content":"Delete the old volumes"},"2427":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-39","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","content":"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it."},"2428":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-40","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","content":"This page is organized in four parts. Read them in order before you upgrade production:"},"2429":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-41","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","content":"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own."},"2430":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-42","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","content":"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do."},"2431":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-43","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","content":"Helm migration guide: the step-by-step procedure for a Helm-managed release."},"2432":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-44","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","content":"Validation checklist: how to confirm the upgrade worked before you remove the old data."},"2433":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-45","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","content":"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production."},"2434":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-46","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","content":"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database."},"2435":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-47","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","content":"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0."},"2436":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-48","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","content":"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check."},"2437":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-49","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","content":"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator."},"2438":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-50","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","content":"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue."},"2439":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-51","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","content":"Version 4.0.0 of the chart is a security-hardening release:"},"2440":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-52","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","content":"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix."},"2441":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-53","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","content":"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount."},"2442":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-54","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","content":"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored."},"2443":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-55","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","content":"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own."},"2444":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-56","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","content":"Several migrations run without intervention when you upgrade a Helm release:"},"2445":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-57","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","content":"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm."},"2446":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-58","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","content":"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store."},"2447":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-59","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","content":"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS."},"2448":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-60","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","content":"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm."},"2449":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-61","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#breaking-changes","content":"Change"},"2450":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-62","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#breaking-changes","content":"Who is affected"},"2451":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-63","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#breaking-changes","content":"Severity"},"2452":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-64","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#breaking-changes","content":"Action"},"2453":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-65","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#breaking-changes","content":"Release-scoped resource names"},"2454":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-66","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#breaking-changes","content":"Helm releases with a filesystem KMS engine or local VA CRL storage"},"2455":{"id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0-67","page_id":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#break