-preview/pr-52/platform/pki/quickstarts/create-certificate-authority-4","page_id":"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority","type":"heading","tags":[],"url":"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#define-the-authority","content":"Define the authority"},"2238":{"id":"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority-5","page_id":"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority","type":"heading","tags":[],"url":"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","content":"Review and create the CA"},"2239":{"id":"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority-6","page_id":"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority","type":"heading","tags":[],"url":"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#verify-the-result","content":"Verify the result"},"2240":{"id":"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority-7","page_id":"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority","type":"heading","tags":[],"url":"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","content":"Check the CA certificate"},"2241":{"id":"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority-8","page_id":"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority","type":"heading","tags":[],"url":"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails","content":"If the result fails"},"2242":{"id":"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority-9","page_id":"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority","type":"heading","tags":[],"url":"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#next-step","content":"Next step"},"2243":{"id":"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority-10","page_id":"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority","content":"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path."},"2244":{"id":"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority-11","page_id":"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#before-you-begin","content":"Console access and permission to create keys and authorities."},"2245":{"id":"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority-12","page_id":"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#before-you-begin","content":"An available cryptographic engine that supports the chosen algorithm."},"2246":{"id":"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority-13","page_id":"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#before-you-begin","content":"OpenSSL 3.x to check the downloaded certificate."},"2247":{"id":"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority-14","page_id":"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#befo