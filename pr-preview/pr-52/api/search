iew#cómo-comprobar-el-resultado","content":"El recorrido de emisión incluye las primeras comprobaciones independientes."},"2228":{"id":"/docs/pr-preview/pr-52/es/platform/pki/overview-29","page_id":"/docs/pr-preview/pr-52/es/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/es/platform/pki/overview#continúa","content":"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />"},"2229":{"id":"/docs/pr-preview/pr-52/es/platform/pki/overview-30","page_id":"/docs/pr-preview/pr-52/es/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/es/platform/pki/overview#continúa","content":"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />"},"2230":{"id":"/docs/pr-preview/pr-52/es/platform/pki/overview-31","page_id":"/docs/pr-preview/pr-52/es/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/es/platform/pki/overview#continúa","content":"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />"},"2231":{"id":"/docs/pr-preview/pr-52/es/platform/pki/quickstarts/create-certificate-authority","page_id":"/docs/pr-preview/pr-52/es/platform/pki/quickstarts/create-certificate-authority","type":"page","content":"Crea tu primera CA","breadcrumbs":["Docs","Plataforma","PKI","Primeros pasos"],"tags":[],"url":"/docs/pr-preview/pr-52/es/platform/pki/quickstarts/create-certificate-authority"},"2232":{"id":"/docs/pr-preview/pr-52/es/platform/pki/quickstarts/create-certificate-authority-0","page_id":"/docs/pr-preview/pr-52/es/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/pr-preview/pr-52/es/platform/pki/quickstarts/create-certificate-authority","content":"Crea un