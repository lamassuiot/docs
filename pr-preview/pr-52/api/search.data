":53380,"_37101":53383,"_37103":53386,"_37105":53389,"_37107":53392,"_37109":53395,"_37111":53398,"_37113":53401,"_37115":53404,"_37117":53407,"_37120":53410,"_37122":53413,"_37124":53416,"_37126":53419,"_37128":53422,"_37130":53425,"_37132":53428,"_37134":53431,"_37136":53434,"_37138":53437,"_37140":53440,"_37142":53443,"_37144":53446,"_37146":53449,"_37148":53452,"_37150":53455,"_37152":53458,"_37154":53461,"_37156":53464,"_37158":53467,"_37160":53470,"_37162":53473,"_37164":53476,"_37166":53479,"_37168":53482,"_37171":53485,"_37173":53488,"_37175":53491,"_37177":53494},{"_3170":15,"_27782":15,"_5":13558,"_2666":45192,"_28124":45193,"_19244":45197,"_26277":15},"Deploy from AWS Marketplace",[45194,45195,45196],"Docs","Deployment","Other models",[],{"_3170":16,"_27782":15,"_19244":45199,"_5":13232,"_26277":15,"_2666":45200},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3170":17,"_27782":15,"_5":28121,"_19244":45202,"_26277":45203,"_2666":45204},[],"/docs/pr-preview/pr-52/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3170":18,"_27782":15,"_5":28121,"_19244":45206,"_26277":45207,"_2666":45208},[],"/docs/pr-preview/pr-52/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3170":19,"_27782":15,"_5":28121,"_19244":45210,"_26277":45211,"_2666":45212},[],"/docs/pr-preview/pr-52/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3170":20,"_27782":15,"_5":28121,"_19244":45214,"_26277":45215,"_2666":45216},[],"/docs/pr-preview/pr-52/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3170":21,"_27782":15,"_5":28121,"_19244":45218,"_26277":45219,"_2666":45220},[],"/docs/pr-preview/pr-52/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3170":22,"_27782":15,"_5":28121,"_19244":45222,"_26277":45223,"_2666":45224},[],"/docs/pr-preview/pr-52/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3170":23,"_27782":15,"_5":28121,"_19244":45226,"_26277":45227,"_2666":45228},[],"/docs/pr-preview/pr-52/deployment/aws-marketplace#next-step","Next step",{"_3170":24,"_27782":15,"_19244":45230,"_5":13232,"_26277":15,"_2666":45231},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3170":25,"_27782":15,"_19244":45233,"_5":13232,"_26277":45203,"_2666":45234},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3170":26,"_27782":15,"_19244":45236,"_5":13232,"_26277":45203,"_2666":45237},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3170":27,"_27782":15,"_19244":45239,"_5":13232,"_26277":45203,"_2666":45240},[],"A security group allowing the necessary endpoints.",{"_3170":28,"_27782":15,"_19244":45242,"_5":13232,"_26277":45207,"_2666":45243},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3170":29,"_27782":15,"_19244":45245,"_5":13232,"_26277":45207,"_2666":45246},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3170":30,"_27782":15,"_19244":45248,"_5":13232,"_26277":45207,"_2666":45249},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3170":31,"_27782":15,"_19244":45251,"_5":13232,"_26277":45211,"_2666":45252},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3170":32,"_27782":15,"_19244":45254,"_5":13232,"_26277":45215,"_2666":45255},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3170":33,"_27782":15,"_19244":45257,"_5":13232,"_26277":45219,"_2666":45258},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3170":34,"_27782":15,"_19244":45260,"_5":13232,"_26277":45223,"_2666":45261},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3170":35,"_27782":15,"_19244":45263,"_5":13232,"_26277":45227,"_2666":45264},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3170":36,"_27782":36,"_5":13558,"_2666":45266,"_28124":45267,"_19244":45268,"_26277":36},"Deploy Lamassu",[45194,45195],[],{"_3170":37,"_27782":36,"_19244":45270,"_5":13232,"_26277":36,"_2666":45271},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3170":38,"_27782":36,"_5":28121,"_19244":45273,"_26277":45274,"_2666":45275},[],"/docs/pr-preview/pr-52/deployment/overview#choose-a-model","Choose a model",{"_3170":39,"_27782":36,"_5":28121,"_19244":45277,"_26277":45278,"_2666":45279},[],"/docs/pr-preview/pr-52/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3170":40,"_27782":36,"_5":28121,"_19244":45281,"_26277":45282,"_2666":45283},[],"/docs/pr-preview/pr-52/deployment/overview#after-deployment","After deployment",{"_3170":41,"_27782":36,"_19244":45285,"_5":13232,"_26277":36,"_2666":45286},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3170":42,"_27782":36,"_19244":45288,"_5":13232,"_26277":45274,"_2666":45289},[],"Model",{"_3170":43,"_27782":36,"_19244":45291,"_5":13232,"_26277":45274,"_2666":45292},[],"Recommended for",{"_3170":44,"_27782":36,"_19244":45294,"_5":13232,"_26277":45274,"_2666":45295},[],"Who operates the infrastructure",{"_3170":45,"_27782":36,"_19244":45297,"_5":13232,"_26277":45274,"_2666":45298},[],"Starting point",{"_3170":46,"_27782":36,"_19244":45300,"_5":13232,"_26277":45274,"_2666":45301},[],"Kubernetes self-managed",{"_3170":47,"_27782":36,"_19244":45303,"_5":13232,"_26277":45274,"_2666":45304},[],"Production, regulated environments and custom deployments",{"_3170":48,"_27782":36,"_19244":45306,"_5":13232,"_26277":45274,"_2666":45307},[],"Your team",{"_3170":49,"_27782":36,"_19244":45309,"_5":13232,"_26277":45274,"_2666":45310},[],"Helm or Fastlane",{"_3170":50,"_27782":36,"_19244":45312,"_5":13232,"_26277":45274,"_2666":45313},[],"AWS Marketplace",{"_3170":51,"_27782":36,"_19244":45315,"_5":13232,"_26277":45274,"_2666":45316},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3170":52,"_27782":36,"_19244":45318,"_5":13232,"_26277":45274,"_2666":45307},[],{"_3170":53,"_27782":36,"_19244":45320,"_5":13232,"_26277":45274,"_2666":45321},[],"Preconfigured image on EC2",{"_3170":54,"_27782":36,"_19244":45323,"_5":13232,"_26277":45274,"_2666":45324},[],"SaaS",{"_3170":55,"_27782":36,"_19244":45326,"_5":13232,"_26277":45274,"_2666":45327},[],"Teams that want to use the platform without operating it",{"_3170":56,"_27782":36,"_19244":45329,"_5":13232,"_26277":45274,"_2666":45330},[],"Lamassu",{"_3170":57,"_27782":36,"_19244":45332,"_5":13232,"_26277":45274,"_2666":45333},[],"Managed subscription",{"_3170":58,"_27782":36,"_19244":45335,"_5":13232,"_26277":45274,"_2666":45336},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3170":59,"_27782":36,"_19244":45338,"_5":13232,"_26277":45274,"_2666":45339},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3170":60,"_27782":36,"_19244":45341,"_5":13232,"_26277":45274,"_2666":45342},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3170":61,"_27782":36,"_19244":45344,"_5":13232,"_26277":45278,"_2666":45345},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3170":62,"_27782":36,"_19244":45347,"_5":13232,"_26277":45282,"_2666":45348},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3170":63,"_27782":63,"_5":13558,"_2666":45350,"_28124":45351,"_19244":45352,"_26277":63},"Use Lamassu as SaaS",[45194,45195,45196],[],{"_3170":64,"_27782":63,"_19244":45354,"_5":13232,"_26277":63,"_2666":45355},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3170":65,"_27782":63,"_5":28121,"_19244":45357,"_26277":45358,"_2666":45359},[],"/docs/pr-preview/pr-52/deployment/saas#what-the-service-manages","What the service manages",{"_3170":66,"_27782":63,"_5":28121,"_19244":45361,"_26277":45362,"_2666":45363},[],"/docs/pr-preview/pr-52/deployment/saas#plans","Plans",{"_3170":67,"_27782":63,"_5":28121,"_19244":45365,"_26277":45366,"_2666":45367},[],"/docs/pr-preview/pr-52/deployment/saas#request-access","Request access",{"_3170":68,"_27782":63,"_19244":45369,"_5":13232,"_26277":63,"_2666":45370},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3170":69,"_27782":63,"_19244":45372,"_5":13232,"_26277":45358,"_2666":45373},[],"Platform availability and maintenance.",{"_3170":70,"_27782":63,"_19244":45375,"_5":13232,"_26277":45358,"_2666":45376},[],"Automatic backups.",{"_3170":71,"_27782":63,"_19244":45378,"_5":13232,"_26277":45358,"_2666":45379},[],"Version upgrades.",{"_3170":72,"_27782":63,"_19244":45381,"_5":13232,"_26277":45358,"_2666":45382},[],"Technical support and SLA according to your plan.",{"_3170":73,"_27782":63,"_19244":45384,"_5":13232,"_26277":45362,"_2666":45385},[],"Plan",{"_3170":74,"_27782":63,"_19244":45387,"_5":13232,"_26277":45362,"_2666":45388},[],"Devices",{"_3170":75,"_27782":63,"_19244":45390,"_5":13232,"_26277":45362,"_2666":45391},[],"Support",{"_3170":76,"_27782":63,"_19244":45393,"_5":13232,"_26277":45362,"_2666":45394},[],"SLA",{"_3170":77,"_27782":63,"_19244":45396,"_5":13232,"_26277":45362,"_2666":45397},[],"Starter",{"_3170":78,"_27782":63,"_19244":45399,"_5":13232,"_26277":45362,"_2666":45400},[],"Up to 1,000",{"_3170":79,"_27782":63,"_19244":45402,"_5":13232,"_26277":45362,"_2666":45403},[],"Email",{"_3170":80,"_27782":63,"_19244":45405,"_5":13232,"_26277":45362,"_2666":45406},[],"99.5 %",{"_3170":81,"_27782":63,"_19244":45408,"_5":13232,"_26277":45362,"_2666":45409},[],"Professional",{"_3170":82,"_27782":63,"_19244":45411,"_5":13232,"_26277":45362,"_2666":45412},[],"Up to 10,000",{"_3170":83,"_27782":63,"_19244":45414,"_5":13232,"_26277":45362,"_2666":45415},[],"Email and chat",{"_3170":84,"_27782":63,"_19244":45417,"_5":13232,"_26277":45362,"_2666":45418},[],"99.9 %",{"_3170":85,"_27782":63,"_19244":45420,"_5":13232,"_26277":45362,"_2666":45421},[],"Enterprise",{"_3170":86,"_27782":63,"_19244":45423,"_5":13232,"_26277":45362,"_2666":45424},[],"Unlimited",{"_3170":87,"_27782":63,"_19244":45426,"_5":13232,"_26277":45362,"_2666":45427},[],"Dedicated",{"_3170":88,"_27782":63,"_19244":45429,"_5":13232,"_26277":45362,"_2666":45430},[],"99.99 %",{"_3170":89,"_27782":63,"_19244":45432,"_5":13232,"_26277":45366,"_2666":45433},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3170":90,"_27782":63,"_19244":45435,"_5":13232,"_26277":45366,"_2666":45436},[],"When you receive your instance's credentials, continue with Get started.",{"_3170":91,"_27782":91,"_5":13558,"_2666":45438,"_28124":45439,"_19244":45440,"_26277":91},"Fastlane",[45194,45195,45301],[],{"_3170":92,"_27782":91,"_19244":45442,"_5":13232,"_26277":91,"_2666":45443},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3170":93,"_27782":91,"_5":28121,"_19244":45445,"_26277":45446,"_2666":45447},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3170":94,"_27782":91,"_5":28121,"_19244":45449,"_26277":45450,"_2666":45451},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3170":95,"_27782":91,"_5":28121,"_19244":45453,"_26277":45454,"_2666":45204},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#before-you-begin",{"_3170":96,"_27782":91,"_5":28121,"_19244":45456,"_26277":45457,"_2666":45458},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3170":97,"_27782":91,"_5":28121,"_19244":45460,"_26277":45461,"_2666":45462},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3170":98,"_27782":91,"_5":28121,"_19244":45464,"_26277":45465,"_2666":45466},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3170":99,"_27782":91,"_5":28121,"_19244":45468,"_26277":45469,"_2666":45470},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3170":100,"_27782":91,"_5":28121,"_19244":45472,"_26277":45473,"_2666":45474},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3170":101,"_27782":91,"_5":28121,"_19244":45476,"_26277":45477,"_2666":45478},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3170":102,"_27782":91,"_5":28121,"_19244":45480,"_26277":45481,"_2666":45482},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3170":103,"_27782":91,"_5":28121,"_19244":45484,"_26277":45485,"_2666":45486},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3170":104,"_27782":91,"_19244":45488,"_5":13232,"_26277":45446,"_2666":45489},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3170":105,"_27782":91,"_19244":45491,"_5":13232,"_26277":45446,"_2666":45492},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3170":106,"_27782":91,"_19244":45494,"_5":13232,"_26277":45450,"_2666":45495},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3170":107,"_27782":91,"_19244":45497,"_5":13232,"_26277":45450,"_2666":45498},[],"Fastlane installs or configures",{"_3170":108,"_27782":91,"_19244":45500,"_5":13232,"_26277":45450,"_2666":45501},[],"You still provide",{"_3170":109,"_27782":91,"_19244":45503,"_5":13232,"_26277":45450,"_2666":45504},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3170":110,"_27782":91,"_19244":45506,"_5":13232,"_26277":45450,"_2666":45507},[],"The Kubernetes cluster, nodes and persistent storage",{"_3170":111,"_27782":91,"_19244":45509,"_5":13232,"_26277":45450,"_2666":45510},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3170":112,"_27782":91,"_19244":45512,"_5":13232,"_26277":45450,"_2666":45513},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3170":113,"_27782":91,"_19244":45515,"_5":13232,"_26277":45450,"_2666":45516},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3170":114,"_27782":91,"_19244":45518,"_5":13232,"_26277":45450,"_2666":45519},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3170":115,"_27782":91,"_19244":45521,"_5":13232,"_26277":45450,"_2666":45522},[],"Optional observability and lab HSM components",{"_3170":116,"_27782":91,"_19244":45524,"_5":13232,"_26277":45450,"_2666":45525},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3170":117,"_27782":91,"_19244":45527,"_5":13232,"_26277":45450,"_2666":45528},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3170":118,"_27782":91,"_19244":45530,"_5":13232,"_26277":45454,"_2666":45531},[],"You need:",{"_3170":119,"_27782":91,"_19244":45533,"_5":13232,"_26277":45454,"_2666":45534},[],"an existing Kubernetes cluster",{"_3170":120,"_27782":91,"_19244":45536,"_5":13232,"_26277":45454,"_2666":45537},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3170":121,"_27782":91,"_19244":45539,"_5":13232,"_26277":45454,"_2666":45540},[],"`yq`",{"_3170":122,"_27782":91,"_19244":45542,"_5":13232,"_26277":45454,"_2666":21800},[],{"_3170":123,"_27782":91,"_19244":45544,"_5":13232,"_26277":45454,"_2666":45545},[],"`jq` only when using `--sample-data` or `--development`",{"_3170":124,"_27782":91,"_19244":45547,"_5":13232,"_26277":45454,"_2666":45548},[],"`ssh-keygen` only when using `--with-hsm`",{"_3170":125,"_27782":91,"_19244":45550,"_5":13232,"_26277":45454,"_2666":45551},[],"free external ports 80 and 443 on a single-node K3s host",{"_3170":126,"_27782":91,"_19244":45553,"_5":13232,"_26277":45454,"_2666":45554},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3170":127,"_27782":91,"_19244":45556,"_5":13232,"_26277":45454,"_2666":45557},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3170":128,"_27782":91,"_19244":45559,"_5":13232,"_26277":45457,"_2666":45560},[],"Run the script from a clone of the Helm repository:",{"_3170":129,"_27782":91,"_19244":45562,"_5":13232,"_26277":45457,"_2666":45563},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3170":130,"_27782":91,"_19244":45565,"_5":13232,"_26277":45461,"_2666":45566},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3170":131,"_27782":91,"_19244":45568,"_5":13232,"_26277":45461,"_2666":45569},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3170":132,"_27782":91,"_19244":45571,"_5":13232,"_26277":45461,"_2666":45572},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3170":133,"_27782":91,"_19244":45574,"_5":13232,"_26277":45461,"_2666":45575},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3170":134,"_27782":91,"_19244":45577,"_5":13232,"_26277":45465,"_2666":45578},[],"Option",{"_3170":135,"_27782":91,"_19244":45580,"_5":13232,"_26277":45465,"_2666":45581},[],"Default",{"_3170":136,"_27782":91,"_19244":45583,"_5":13232,"_26277":45465,"_2666":45584},[],"Purpose",{"_3170":137,"_27782":91,"_19244":45586,"_5":13232,"_26277":45465,"_2666":45587},[],"`-h`, `--help`",{"_3170":138,"_27782":91,"_19244":45589,"_5":13232,"_26277":45465,"_2666":45590},[],"—",{"_3170":139,"_27782":91,"_19244":45592,"_5":13232,"_26277":45465,"_2666":45593},[],"Show help",{"_3170":140,"_27782":91,"_19244":45595,"_5":13232,"_26277":45465,"_2666":45596},[],"`-c`, `--context`",{"_3170":141,"_27782":91,"_19244":45598,"_5":13232,"_26277":45465,"_2666":45599},[],"current context",{"_3170":142,"_27782":91,"_19244":45601,"_5":13232,"_26277":45465,"_2666":45602},[],"Select the kubeconfig context for kubectl and Helm",{"_3170":143,"_27782":91,"_19244":45604,"_5":13232,"_26277":45465,"_2666":45605},[],"`-n`, `--non-interactive`",{"_3170":144,"_27782":91,"_19244":45607,"_5":13232,"_26277":45465,"_2666":5936},[],{"_3170":145,"_27782":91,"_19244":45609,"_5":13232,"_26277":45465,"_2666":45610},[],"Skip prompts and generate dependency credentials",{"_3170":146,"_27782":91,"_19244":45612,"_5":13232,"_26277":45465,"_2666":45613},[],"`-ns`, `--namespace`",{"_3170":147,"_27782":91,"_19244":45615,"_5":13232,"_26277":45465,"_2666":45616},[],"`lamassu-dev`",{"_3170":148,"_27782":91,"_19244":45618,"_5":13232,"_26277":45465,"_2666":45619},[],"Namespace for the installation",{"_3170":149,"_27782":91,"_19244":45621,"_5":13232,"_26277":45465,"_2666":45622},[],"`-d`, `--domain`",{"_3170":150,"_27782":91,"_19244":45624,"_5":13232,"_26277":45465,"_2666":45625},[],"`dev.lamassu.io`",{"_3170":151,"_27782":91,"_19244":45627,"_5":13232,"_26277":45465,"_2666":45628},[],"Domain used by the UI, OIDC and certificate",{"_3170":152,"_27782":91,"_19244":45630,"_5":13232,"_26277":45465,"_2666":45631},[],"`-v`, `--version`",{"_3170":153,"_27782":91,"_19244":45633,"_5":13232,"_26277":45465,"_2666":13852},[],{"_3170":154,"_27782":91,"_19244":45635,"_5":13232,"_26277":45465,"_2666":45636},[],"Lamassu chart version",{"_3170":155,"_27782":91,"_19244":45638,"_5":13232,"_26277":45465,"_2666":45639},[],"`--https-port`",{"_3170":156,"_27782":91,"_19244":45641,"_5":13232,"_26277":45465,"_2666":45642},[],"`443`",{"_3170":157,"_27782":91,"_19244":45644,"_5":13232,"_26277":45465,"_2666":45645},[],"Gateway HTTPS listener port",{"_3170":158,"_27782":91,"_19244":45647,"_5":13232,"_26277":45465,"_2666":45648},[],"`--http-port`",{"_3170":159,"_27782":91,"_19244":45650,"_5":13232,"_26277":45465,"_2666":45651},[],"`80`",{"_3170":160,"_27782":91,"_19244":45653,"_5":13232,"_26277":45465,"_2666":45654},[],"Gateway HTTP listener port",{"_3170":161,"_27782":91,"_19244":45656,"_5":13232,"_26277":45465,"_2666":45657},[],"`--tls-crt`",{"_3170":162,"_27782":91,"_19244":45659,"_5":13232,"_26277":45465,"_2666":45590},[],{"_3170":163,"_27782":91,"_19244":45661,"_5":13232,"_26277":45465,"_2666":45662},[],"PEM certificate for downstream TLS",{"_3170":164,"_27782":91,"_19244":45664,"_5":13232,"_26277":45465,"_2666":45665},[],"`--tls-key`",{"_3170":165,"_27782":91,"_19244":45667,"_5":13232,"_26277":45465,"_2666":45590},[],{"_3170":166,"_27782":91,"_19244":45669,"_5":13232,"_26277":45465,"_2666":45670},[],"PEM private key for downstream TLS",{"_3170":167,"_27782":91,"_19244":45672,"_5":13232,"_26277":45465,"_2666":45673},[],"`-l`, `--local-chart-path`",{"_3170":168,"_27782":91,"_19244":45675,"_5":13232,"_26277":45465,"_2666":45676},[],"repository chart",{"_3170":169,"_27782":91,"_19244":45678,"_5":13232,"_26277":45465,"_2666":45679},[],"Use an unpacked local Lamassu chart",{"_3170":170,"_27782":91,"_19244":45681,"_5":13232,"_26277":45465,"_2666":45682},[],"`-ip`, `--gateway-ip`",{"_3170":171,"_27782":91,"_19244":45684,"_5":13232,"_26277":45465,"_2666":7990},[],{"_3170":172,"_27782":91,"_19244":45686,"_5":13232,"_26277":45465,"_2666":45687},[],"Override the address written to `gateway.addresses`",{"_3170":173,"_27782":91,"_19244":45689,"_5":13232,"_26277":45465,"_2666":45690},[],"`--otel`",{"_3170":174,"_27782":91,"_19244":45692,"_5":13232,"_26277":45465,"_2666":5936},[],{"_3170":175,"_27782":91,"_19244":45694,"_5":13232,"_26277":45465,"_2666":45695},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3170":176,"_27782":91,"_19244":45697,"_5":13232,"_26277":45465,"_2666":45698},[],"`--development`",{"_3170":177,"_27782":91,"_19244":45700,"_5":13232,"_26277":45465,"_2666":5936},[],{"_3170":178,"_27782":91,"_19244":45702,"_5":13232,"_26277":45465,"_2666":45703},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3170":179,"_27782":91,"_19244":45705,"_5":13232,"_26277":45465,"_2666":45706},[],"`--sample-data`",{"_3170":180,"_27782":91,"_19244":45708,"_5":13232,"_26277":45465,"_2666":5936},[],{"_3170":181,"_27782":91,"_19244":45710,"_5":13232,"_26277":45465,"_2666":45711},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3170":182,"_27782":91,"_19244":45713,"_5":13232,"_26277":45465,"_2666":45714},[],"`--with-hsm`",{"_3170":183,"_27782":91,"_19244":45716,"_5":13232,"_26277":45465,"_2666":5936},[],{"_3170":184,"_27782":91,"_19244":45718,"_5":13232,"_26277":45465,"_2666":45719},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3170":185,"_27782":91,"_19244":45721,"_5":13232,"_26277":45465,"_2666":45722},[],"`--softhsm-chart-path`",{"_3170":186,"_27782":91,"_19244":45724,"_5":13232,"_26277":45465,"_2666":45725},[],"`./charts/softhsm`",{"_3170":187,"_27782":91,"_19244":45727,"_5":13232,"_26277":45465,"_2666":45728},[],"Use a different local SoftHSM chart",{"_3170":188,"_27782":91,"_19244":45730,"_5":13232,"_26277":45465,"_2666":45731},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3170":189,"_27782":91,"_19244":45733,"_5":13232,"_26277":45469,"_2666":45734},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3170":190,"_27782":91,"_19244":45736,"_5":13232,"_26277":45469,"_2666":45737},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3170":191,"_27782":91,"_19244":45739,"_5":13232,"_26277":45469,"_2666":45740},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3170":192,"_27782":91,"_19244":45742,"_5":13232,"_26277":45469,"_2666":45743},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3170":193,"_27782":91,"_19244":45745,"_5":13232,"_26277":45469,"_2666":45746},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3170":194,"_27782":91,"_19244":45748,"_5":13232,"_26277":45469,"_2666":45749},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3170":195,"_27782":91,"_19244":45751,"_5":13232,"_26277":45473,"_2666":45752},[],"Fastlane:",{"_3170":196,"_27782":91,"_19244":45754,"_5":13232,"_26277":45473,"_2666":45755},[],"validates local tools and the selected cluster",{"_3170":197,"_27782":91,"_19244":45757,"_5":13232,"_26277":45473,"_2666":45758},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3170":198,"_27782":91,"_19244":45760,"_5":13232,"_26277":45473,"_2666":45761},[],"creates the namespace",{"_3170":199,"_27782":91,"_19244":45763,"_5":13232,"_26277":45473,"_2666":45764},[],"installs PostgreSQL and creates the required databases",{"_3170":200,"_27782":91,"_19244":45766,"_5":13232,"_26277":45473,"_2666":45767},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3170":201,"_27782":91,"_19244":45769,"_5":13232,"_26277":45473,"_2666":45770},[],"installs RabbitMQ",{"_3170":202,"_27782":91,"_19244":45772,"_5":13232,"_26277":45473,"_2666":45773},[],"optionally installs observability and lab HSM components",{"_3170":203,"_27782":91,"_19244":45775,"_5":13232,"_26277":45473,"_2666":45776},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3170":204,"_27782":91,"_19244":45778,"_5":13232,"_26277":45473,"_2666":45779},[],"optionally loads sample data",{"_3170":205,"_27782":91,"_19244":45781,"_5":13232,"_26277":45473,"_2666":45782},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3170":206,"_27782":91,"_19244":45784,"_5":13232,"_26277":45477,"_2666":45785},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3170":207,"_27782":91,"_19244":45787,"_5":13232,"_26277":45477,"_2666":45788},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3170":208,"_27782":91,"_19244":45790,"_5":13232,"_26277":45481,"_2666":45791},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3170":209,"_27782":91,"_19244":45793,"_5":13232,"_26277":45481,"_2666":45794},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3170":210,"_27782":91,"_19244":45796,"_5":13232,"_26277":45481,"_2666":45797},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3170":211,"_27782":91,"_19244":45799,"_5":13232,"_26277":45485,"_2666":45800},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3170":212,"_27782":212,"_5":13558,"_2666":45802,"_28124":45803,"_19244":45804,"_26277":212},"Install with Helm",[45194,45195,45301],[],{"_3170":213,"_27782":212,"_19244":45806,"_5":13232,"_26277":212,"_2666":45807},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3170":214,"_27782":212,"_5":28121,"_19244":45809,"_26277":45810,"_2666":45811},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3170":215,"_27782":212,"_5":28121,"_19244":45813,"_26277":45814,"_2666":45204},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#before-you-begin",{"_3170":216,"_27782":212,"_5":28121,"_19244":45816,"_26277":45817,"_2666":45818},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3170":217,"_27782":212,"_5":28121,"_19244":45820,"_26277":45821,"_2666":45822},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3170":218,"_27782":212,"_5":28121,"_19244":45824,"_26277":45825,"_2666":45826},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3170":219,"_27782":212,"_5":28121,"_19244":45828,"_26277":45829,"_2666":45830},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3170":220,"_27782":212,"_5":28121,"_19244":45832,"_26277":45833,"_2666":45834},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3170":221,"_27782":212,"_5":28121,"_19244":45836,"_26277":45837,"_2666":45838},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3170":222,"_27782":212,"_5":28121,"_19244":45840,"_26277":45841,"_2666":45842},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3170":223,"_27782":212,"_19244":45844,"_5":13232,"_26277":45810,"_2666":45845},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3170":224,"_27782":212,"_19244":45847,"_5":13232,"_26277":45814,"_2666":45848},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3170":225,"_27782":212,"_19244":45850,"_5":13232,"_26277":45814,"_2666":45851},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3170":226,"_27782":212,"_19244":45853,"_5":13232,"_26277":45814,"_2666":45854},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3170":227,"_27782":212,"_19244":45856,"_5":13232,"_26277":45814,"_2666":45857},[],"a reachable RabbitMQ broker and credentials",{"_3170":228,"_27782":212,"_19244":45859,"_5":13232,"_26277":45814,"_2666":45860},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3170":229,"_27782":212,"_19244":45862,"_5":13232,"_26277":45814,"_2666":45863},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3170":230,"_27782":212,"_19244":45865,"_5":13232,"_26277":45814,"_2666":45866},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3170":231,"_27782":212,"_19244":45868,"_5":13232,"_26277":45814,"_2666":45869},[],"a StorageClass and an external traffic design",{"_3170":232,"_27782":212,"_19244":45871,"_5":13232,"_26277":45814,"_2666":45872},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3170":233,"_27782":212,"_19244":45874,"_5":13232,"_26277":45814,"_2666":45875},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3170":234,"_27782":212,"_19244":45877,"_5":13232,"_26277":45814,"_2666":45878},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3170":235,"_27782":212,"_19244":45880,"_5":13232,"_26277":45817,"_2666":45881},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3170":236,"_27782":212,"_19244":45883,"_5":13232,"_26277":45817,"_2666":45884},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3170":237,"_27782":212,"_19244":45886,"_5":13232,"_26277":45817,"_2666":45887},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3170":238,"_27782":212,"_19244":45889,"_5":13232,"_26277":45821,"_2666":45890},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3170":239,"_27782":212,"_19244":45892,"_5":13232,"_26277":45821,"_2666":45893},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3170":240,"_27782":212,"_19244":45895,"_5":13232,"_26277":45821,"_2666":45896},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3170":241,"_27782":212,"_19244":45898,"_5":13232,"_26277":45825,"_2666":45899},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3170":242,"_27782":212,"_19244":45901,"_5":13232,"_26277":45829,"_2666":45902},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3170":243,"_27782":212,"_19244":45904,"_5":13232,"_26277":45829,"_2666":45905},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3170":244,"_27782":212,"_19244":45907,"_5":13232,"_26277":45829,"_2666":45908},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3170":245,"_27782":212,"_19244":45910,"_5":13232,"_26277":45829,"_2666":45911},[],"See Access control for the principal and policy model.",{"_3170":246,"_27782":212,"_19244":45913,"_5":13232,"_26277":45833,"_2666":45914},[],"To install a local checkout instead:",{"_3170":247,"_27782":212,"_19244":45916,"_5":13232,"_26277":45837,"_2666":45917},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3170":248,"_27782":212,"_19244":45919,"_5":13232,"_26277":45837,"_2666":45920},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3170":249,"_27782":212,"_19244":45922,"_5":13232,"_26277":45841,"_2666":45923},[],"Before going live, review:",{"_3170":250,"_27782":212,"_19244":45925,"_5":13232,"_26277":45841,"_2666":45926},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3170":251,"_27782":212,"_19244":45928,"_5":13232,"_26277":45841,"_2666":45929},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3170":252,"_27782":212,"_19244":45931,"_5":13232,"_26277":45841,"_2666":45932},[],"shared VA storage before increasing VA replicas",{"_3170":253,"_27782":212,"_19244":45934,"_5":13232,"_26277":45841,"_2666":45935},[],"managed OIDC roles and removal of evaluation credentials",{"_3170":254,"_27782":212,"_19244":45937,"_5":13232,"_26277":45841,"_2666":45938},[],"a trusted TLS issuer or externally managed certificate",{"_3170":255,"_27782":212,"_19244":45940,"_5":13232,"_26277":45841,"_2666":45941},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3170":256,"_27782":212,"_19244":45943,"_5":13232,"_26277":45841,"_2666":45944},[],"SMTP, observability and alert delivery",{"_3170":257,"_27782":212,"_19244":45946,"_5":13232,"_26277":45841,"_2666":45947},[],"the version upgrade guides and the notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_3170":258,"_27782":212,"_19244":45949,"_5":13232,"_26277":45841,"_2666":45950},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3170":259,"_27782":259,"_5":13558,"_2666":45952,"_28124":45953,"_19244":45954,"_26277":259},"Expose the Gateway",[45194,45195,45301],[],{"_3170":260,"_27782":259,"_19244":45956,"_5":13232,"_26277":259,"_2666":45957},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3170":261,"_27782":259,"_5":28121,"_19244":45959,"_26277":45960,"_2666":45961},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3170":262,"_27782":259,"_5":28121,"_19244":45963,"_26277":45964,"_2666":45965},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3170":263,"_27782":259,"_5":28121,"_19244":45967,"_26277":45968,"_2666":45969},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3170":264,"_27782":259,"_5":28121,"_19244":45971,"_26277":45972,"_2666":45973},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#k3s","K3s",{"_3170":265,"_27782":259,"_5":28121,"_19244":45975,"_26277":45976,"_2666":45977},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3170":266,"_27782":259,"_5":28121,"_19244":45979,"_26277":45980,"_2666":45981},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3170":267,"_27782":259,"_5":28121,"_19244":45983,"_26277":45984,"_2666":45985},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3170":268,"_27782":259,"_5":28121,"_19244":45987,"_26277":45988,"_2666":45989},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3170":269,"_27782":259,"_5":28121,"_19244":45991,"_26277":45992,"_2666":45993},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3170":270,"_27782":259,"_19244":45995,"_5":13232,"_26277":45960,"_2666":45996},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3170":271,"_27782":259,"_19244":45998,"_5":13232,"_26277":45960,"_2666":45999},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3170":272,"_27782":259,"_19244":46001,"_5":13232,"_26277":45964,"_2666":46002},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3170":273,"_27782":259,"_19244":46004,"_5":13232,"_26277":45964,"_2666":46005},[],"Set it only when:",{"_3170":274,"_27782":259,"_19244":46007,"_5":13232,"_26277":45964,"_2666":46008},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3170":275,"_27782":259,"_19244":46010,"_5":13232,"_26277":45964,"_2666":46011},[],"that address is allocated to this Gateway",{"_3170":276,"_27782":259,"_19244":46013,"_5":13232,"_26277":45964,"_2666":46014},[],"the surrounding network already routes traffic for it to the cluster",{"_3170":277,"_27782":259,"_19244":46016,"_5":13232,"_26277":45964,"_2666":46017},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3170":278,"_27782":259,"_19244":46019,"_5":13232,"_26277":45964,"_2666":46020},[],"Keep these two settings separate:",{"_3170":279,"_27782":259,"_19244":46022,"_5":13232,"_26277":45964,"_2666":46023},[],"`gateway.addresses` requests an address for the Gateway.",{"_3170":280,"_27782":259,"_19244":46025,"_5":13232,"_26277":45964,"_2666":46026},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3170":281,"_27782":259,"_19244":46028,"_5":13232,"_26277":45964,"_2666":46029},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3170":282,"_27782":259,"_19244":46031,"_5":13232,"_26277":45968,"_2666":46032},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3170":283,"_27782":259,"_19244":46034,"_5":13232,"_26277":45968,"_2666":46035},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3170":284,"_27782":259,"_19244":46037,"_5":13232,"_26277":45972,"_2666":46038},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3170":285,"_27782":259,"_19244":46040,"_5":13232,"_26277":45972,"_2666":46041},[],"For the recommended design:",{"_3170":286,"_27782":259,"_19244":46043,"_5":13232,"_26277":45972,"_2666":46044},[],"Use only one externally exposed Lamassu Gateway.",{"_3170":287,"_27782":259,"_19244":46046,"_5":13232,"_26277":45972,"_2666":46047},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3170":288,"_27782":259,"_19244":46049,"_5":13232,"_26277":45972,"_2666":46050},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3170":289,"_27782":259,"_19244":46052,"_5":13232,"_26277":45972,"_2666":46053},[],"Point DNS at the VM's reachable address.",{"_3170":290,"_27782":259,"_19244":46055,"_5":13232,"_26277":45972,"_2666":46056},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3170":291,"_27782":259,"_19244":46058,"_5":13232,"_26277":45976,"_2666":46059},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3170":292,"_27782":259,"_19244":46061,"_5":13232,"_26277":45980,"_2666":46062},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3170":293,"_27782":259,"_19244":46064,"_5":13232,"_26277":45980,"_2666":46065},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3170":294,"_27782":259,"_19244":46067,"_5":13232,"_26277":45984,"_2666":46068},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3170":295,"_27782":259,"_19244":46070,"_5":13232,"_26277":45984,"_2666":46071},[],"Requirement",{"_3170":296,"_27782":259,"_19244":46073,"_5":13232,"_26277":45984,"_2666":46074},[],"Recommended design",{"_3170":297,"_27782":259,"_19244":46076,"_5":13232,"_26277":45984,"_2666":46077},[],"Consequence",{"_3170":298,"_27782":259,"_19244":46079,"_5":13232,"_26277":45984,"_2666":46080},[],"Several Lamassu URLs or services",{"_3170":299,"_27782":259,"_19244":46082,"_5":13232,"_26277":45984,"_2666":46083},[],"One Gateway with multiple routes",{"_3170":300,"_27782":259,"_19244":46085,"_5":13232,"_26277":45984,"_2666":46086},[],"One IP and one proxy fleet; this is the chart default",{"_3170":301,"_27782":259,"_19244":46088,"_5":13232,"_26277":45984,"_2666":46089},[],"Independent Gateways and separate external IPs",{"_3170":302,"_27782":259,"_19244":46091,"_5":13232,"_26277":45984,"_2666":46092},[],"One VIP per Gateway",{"_3170":303,"_27782":259,"_19244":46094,"_5":13232,"_26277":45984,"_2666":46095},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3170":304,"_27782":259,"_19244":46097,"_5":13232,"_26277":45984,"_2666":46098},[],"Independent Gateways on one node and one IP",{"_3170":305,"_27782":259,"_19244":46100,"_5":13232,"_26277":45984,"_2666":46101},[],"Use different external ports",{"_3170":306,"_27782":259,"_19244":46103,"_5":13232,"_26277":45984,"_2666":46104},[],"Clients must include non-standard ports",{"_3170":307,"_27782":259,"_19244":46106,"_5":13232,"_26277":45984,"_2666":46107},[],"Separate TLS/mTLS termination behind one IP",{"_3170":308,"_27782":259,"_19244":46109,"_5":13232,"_26277":45984,"_2666":46110},[],"Front-door SNI routing to internal Gateways",{"_3170":309,"_27782":259,"_19244":46112,"_5":13232,"_26277":45984,"_2666":46113},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3170":310,"_27782":259,"_19244":46115,"_5":13232,"_26277":45984,"_2666":46116},[],"Separate Gateway resources but shared proxy infrastructure",{"_3170":311,"_27782":259,"_19244":46118,"_5":13232,"_26277":45984,"_2666":46119},[],"Envoy merged-Gateway mode",{"_3170":312,"_27782":259,"_19244":46121,"_5":13232,"_26277":45984,"_2666":46122},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3170":313,"_27782":259,"_19244":46124,"_5":13232,"_26277":45984,"_2666":46125},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3170":314,"_27782":259,"_19244":46127,"_5":13232,"_26277":45984,"_2666":46128},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3170":315,"_27782":259,"_19244":46130,"_5":13232,"_26277":45984,"_2666":46131},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3170":316,"_27782":259,"_19244":46133,"_5":13232,"_26277":45984,"_2666":46134},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3170":317,"_27782":259,"_19244":46136,"_5":13232,"_26277":45988,"_2666":46137},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3170":318,"_27782":259,"_19244":46139,"_5":13232,"_26277":45988,"_2666":46140},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3170":319,"_27782":259,"_19244":46142,"_5":13232,"_26277":45988,"_2666":46143},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3170":320,"_27782":259,"_19244":46145,"_5":13232,"_26277":45988,"_2666":46146},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3170":321,"_27782":259,"_19244":46148,"_5":13232,"_26277":45988,"_2666":46149},[],"If none of those are possible, use different external ports or change the external network design.",{"_3170":322,"_27782":259,"_19244":46151,"_5":13232,"_26277":45992,"_2666":46152},[],"Check, in order:",{"_3170":323,"_27782":259,"_19244":46154,"_5":13232,"_26277":45992,"_2666":46155},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3170":324,"_27782":259,"_19244":46157,"_5":13232,"_26277":45992,"_2666":46158},[],"Its status contains the expected address.",{"_3170":325,"_27782":259,"_19244":46160,"_5":13232,"_26277":45992,"_2666":46161},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3170":326,"_27782":259,"_19244":46163,"_5":13232,"_26277":45992,"_2666":46164},[],"Port 443 reaches that address from the client network.",{"_3170":327,"_27782":259,"_19244":46166,"_5":13232,"_26277":45992,"_2666":46167},[],"DNS resolves to the externally reachable endpoint.",{"_3170":328,"_27782":259,"_19244":46169,"_5":13232,"_26277":45992,"_2666":46170},[],"The certificate contains the DNS name or IP used by the client.",{"_3170":329,"_27782":259,"_19244":46172,"_5":13232,"_26277":45992,"_2666":46173},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3170":330,"_27782":330,"_5":13558,"_2666":45301,"_28124":46175,"_19244":46176,"_26277":330},[45194,45195,45301],[],{"_3170":331,"_27782":330,"_19244":46178,"_5":13232,"_26277":330,"_2666":46179},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3170":332,"_27782":330,"_5":28121,"_19244":46181,"_26277":46182,"_2666":46183},[],"/docs/pr-preview/pr-52/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3170":333,"_27782":330,"_5":28121,"_19244":46185,"_26277":46186,"_2666":46187},[],"/docs/pr-preview/pr-52/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3170":334,"_27782":330,"_5":28121,"_19244":46189,"_26277":46190,"_2666":46191},[],"/docs/pr-preview/pr-52/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3170":335,"_27782":330,"_5":28121,"_19244":46193,"_26277":46194,"_2666":46195},[],"/docs/pr-preview/pr-52/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3170":336,"_27782":330,"_5":28121,"_19244":46197,"_26277":46198,"_2666":46199},[],"/docs/pr-preview/pr-52/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3170":337,"_27782":330,"_5":28121,"_19244":46201,"_26277":46202,"_2666":46203},[],"/docs/pr-preview/pr-52/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3170":338,"_27782":330,"_19244":46205,"_5":13232,"_26277":46182,"_2666":46206},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3170":339,"_27782":330,"_19244":46208,"_5":13232,"_26277":46186,"_2666":46209},[],"Workflow",{"_3170":340,"_27782":330,"_19244":46211,"_5":13232,"_26277":46186,"_2666":46212},[],"Use it for",{"_3170":341,"_27782":330,"_19244":46214,"_5":13232,"_26277":46186,"_2666":46215},[],"What it installs",{"_3170":342,"_27782":330,"_19244":46217,"_5":13232,"_26277":46186,"_2666":46218},[],"Helm",{"_3170":343,"_27782":330,"_19244":46220,"_5":13232,"_26277":46186,"_2666":46221},[],"Production and controlled environments",{"_3170":344,"_27782":330,"_19244":46223,"_5":13232,"_26277":46186,"_2666":46224},[],"Lamassu services and Gateway API resources",{"_3170":345,"_27782":330,"_19244":46226,"_5":13232,"_26277":46186,"_2666":45438},[],{"_3170":346,"_27782":330,"_19244":46228,"_5":13232,"_26277":46186,"_2666":46229},[],"Evaluation, demos, CI and small lab clusters",{"_3170":347,"_27782":330,"_19244":46231,"_5":13232,"_26277":46186,"_2666":46232},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3170":348,"_27782":330,"_19244":46234,"_5":13232,"_26277":46190,"_2666":46235},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3170":349,"_27782":330,"_19244":46237,"_5":13232,"_26277":46190,"_2666":46238},[],"Area",{"_3170":350,"_27782":330,"_19244":46240,"_5":13232,"_26277":46190,"_2666":46241},[],"The Lamassu chart provides",{"_3170":351,"_27782":330,"_19244":46243,"_5":13232,"_26277":46190,"_2666":46244},[],"You provide",{"_3170":352,"_27782":330,"_19244":46246,"_5":13232,"_26277":46190,"_2666":46247},[],"Lamassu applications",{"_3170":353,"_27782":330,"_19244":46249,"_5":13232,"_26277":46190,"_2666":46250},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3170":354,"_27782":330,"_19244":46252,"_5":13232,"_26277":46190,"_2666":46253},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3170":355,"_27782":330,"_19244":46255,"_5":13232,"_26277":46190,"_2666":46256},[],"PostgreSQL data",{"_3170":356,"_27782":330,"_19244":46258,"_5":13232,"_26277":46190,"_2666":46259},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3170":357,"_27782":330,"_19244":46261,"_5":13232,"_26277":46190,"_2666":46262},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3170":358,"_27782":330,"_19244":46264,"_5":13232,"_26277":46190,"_2666":46265},[],"Messaging",{"_3170":359,"_27782":330,"_19244":46267,"_5":13232,"_26277":46190,"_2666":46268},[],"RabbitMQ connection configuration for the Lamassu services",{"_3170":360,"_27782":330,"_19244":46270,"_5":13232,"_26277":46190,"_2666":46271},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3170":361,"_27782":330,"_19244":46273,"_5":13232,"_26277":46190,"_2666":46274},[],"Identity",{"_3170":362,"_27782":330,"_19244":46276,"_5":13232,"_26277":46190,"_2666":46277},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3170":363,"_27782":330,"_19244":46279,"_5":13232,"_26277":46190,"_2666":46280},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3170":364,"_27782":330,"_19244":46282,"_5":13232,"_26277":46190,"_2666":46283},[],"External routing",{"_3170":365,"_27782":330,"_19244":46285,"_5":13232,"_26277":46190,"_2666":46286},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3170":366,"_27782":330,"_19244":46288,"_5":13232,"_26277":46190,"_2666":46289},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3170":367,"_27782":330,"_19244":46291,"_5":13232,"_26277":46190,"_2666":46292},[],"TLS",{"_3170":368,"_27782":330,"_19244":46294,"_5":13232,"_26277":46190,"_2666":46295},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3170":369,"_27782":330,"_19244":46297,"_5":13232,"_26277":46190,"_2666":46298},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3170":370,"_27782":330,"_19244":46300,"_5":13232,"_26277":46190,"_2666":46301},[],"Persistent application data",{"_3170":371,"_27782":330,"_19244":46303,"_5":13232,"_26277":46190,"_2666":46304},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3170":372,"_27782":330,"_19244":46306,"_5":13232,"_26277":46190,"_2666":46307},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3170":373,"_27782":330,"_19244":46309,"_5":13232,"_26277":46190,"_2666":46310},[],"Optional integrations",{"_3170":374,"_27782":330,"_19244":46312,"_5":13232,"_26277":46190,"_2666":46313},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3170":375,"_27782":330,"_19244":46315,"_5":13232,"_26277":46190,"_2666":46316},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3170":376,"_27782":330,"_19244":46318,"_5":13232,"_26277":46190,"_2666":46319},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3170":377,"_27782":330,"_19244":46321,"_5":13232,"_26277":46190,"_2666":46322},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3170":378,"_27782":330,"_19244":46324,"_5":13232,"_26277":46194,"_2666":46325},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3170":379,"_27782":330,"_19244":46327,"_5":13232,"_26277":46194,"_2666":46328},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3170":380,"_27782":330,"_19244":46330,"_5":13232,"_26277":46198,"_2666":46331},[],"Kubernetes 1.24 or newer",{"_3170":381,"_27782":330,"_19244":46333,"_5":13232,"_26277":46198,"_2666":46334},[],"Helm 3.2 or newer",{"_3170":382,"_27782":330,"_19244":46336,"_5":13232,"_26277":46198,"_2666":46337},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3170":383,"_27782":330,"_19244":46339,"_5":13232,"_26277":46198,"_2666":46340},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3170":384,"_27782":330,"_19244":46342,"_5":13232,"_26277":46198,"_2666":46343},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3170":385,"_27782":330,"_19244":46345,"_5":13232,"_26277":46198,"_2666":46346},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3170":386,"_27782":330,"_19244":46348,"_5":13232,"_26277":46198,"_2666":46349},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3170":387,"_27782":330,"_19244":46351,"_5":13232,"_26277":46202,"_2666":46352},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3170":388,"_27782":330,"_19244":46354,"_5":13232,"_26277":46202,"_2666":46355},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3170":389,"_27782":330,"_19244":46357,"_5":13232,"_26277":46202,"_2666":46358},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3170":390,"_27782":330,"_19244":46360,"_5":13232,"_26277":46202,"_2666":46361},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3170":391,"_27782":391,"_5":13558,"_2666":46363,"_28124":46364,"_19244":46366,"_26277":391},"Deployment troubleshooting",[45194,45195,46365],"Operations",[],{"_3170":392,"_27782":391,"_19244":46368,"_5":13232,"_26277":391,"_2666":46369},[],"Diagnose access, service health and infrastructure dependencies.",{"_3170":393,"_27782":391,"_5":28121,"_19244":46371,"_26277":46372,"_2666":46373},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3170":394,"_27782":391,"_5":28121,"_19244":46375,"_26277":46376,"_2666":46377},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3170":395,"_27782":391,"_5":28121,"_19244":46379,"_26277":46380,"_2666":46381},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3170":396,"_27782":391,"_5":28121,"_19244":46383,"_26277":46384,"_2666":46385},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3170":397,"_27782":391,"_5":28121,"_19244":46387,"_26277":46388,"_2666":46389},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3170":398,"_27782":391,"_5":28121,"_19244":46391,"_26277":46392,"_2666":46393},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3170":399,"_27782":391,"_5":28121,"_19244":46395,"_26277":46396,"_2666":46397},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3170":400,"_27782":391,"_5":28121,"_19244":46399,"_26277":46400,"_2666":46401},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3170":401,"_27782":391,"_5":28121,"_19244":46403,"_26277":46404,"_2666":46405},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3170":402,"_27782":391,"_5":28121,"_19244":46407,"_26277":46408,"_2666":46409},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3170":403,"_27782":391,"_5":28121,"_19244":46411,"_26277":46412,"_2666":46413},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3170":404,"_27782":391,"_5":28121,"_19244":46415,"_26277":46416,"_2666":46417},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#observability","Observability",{"_3170":405,"_27782":391,"_19244":46419,"_5":13232,"_26277":391,"_2666":46420},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3170":406,"_27782":391,"_19244":46422,"_5":13232,"_26277":46376,"_2666":46423},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3170":407,"_27782":391,"_19244":46425,"_5":13232,"_26277":46380,"_2666":46426},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3170":408,"_27782":391,"_19244":46428,"_5":13232,"_26277":46384,"_2666":46429},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3170":409,"_27782":391,"_19244":46431,"_5":13232,"_26277":46388,"_2666":46432},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3170":410,"_27782":391,"_19244":46434,"_5":13232,"_26277":46392,"_2666":46435},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3170":411,"_27782":391,"_19244":46437,"_5":13232,"_26277":46396,"_2666":46438},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3170":412,"_27782":391,"_19244":46440,"_5":13232,"_26277":46396,"_2666":46441},[],"Also run the chart's connectivity test:",{"_3170":413,"_27782":391,"_19244":46443,"_5":13232,"_26277":46396,"_2666":46444},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3170":414,"_27782":391,"_19244":46446,"_5":13232,"_26277":46396,"_2666":46447},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3170":415,"_27782":391,"_19244":46449,"_5":13232,"_26277":46400,"_2666":46450},[],"If you receive a 401:",{"_3170":416,"_27782":391,"_19244":46452,"_5":13232,"_26277":46400,"_2666":46453},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3170":417,"_27782":391,"_19244":46455,"_5":13232,"_26277":46400,"_2666":46456},[],"verify issuer, audience and expiration of the token;",{"_3170":418,"_27782":391,"_19244":46458,"_5":13232,"_26277":46400,"_2666":46459},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3170":419,"_27782":391,"_19244":46461,"_5":13232,"_26277":46400,"_2666":46462},[],"check that the provider's public and internal routes point to the same realm.",{"_3170":420,"_27782":391,"_19244":46464,"_5":13232,"_26277":46400,"_2666":46465},[],"If login succeeds but the APIs return 403:",{"_3170":421,"_27782":391,"_19244":46467,"_5":13232,"_26277":46400,"_2666":46468},[],"inspect the token's real claims;",{"_3170":422,"_27782":391,"_19244":46470,"_5":13232,"_26277":46400,"_2666":46471},[],"confirm they match an active principal;",{"_3170":423,"_27782":391,"_19244":46473,"_5":13232,"_26277":46400,"_2666":46474},[],"review the policies granted to that principal;",{"_3170":424,"_27782":391,"_19244":46476,"_5":13232,"_26277":46400,"_2666":46477},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3170":425,"_27782":391,"_19244":46479,"_5":13232,"_26277":46400,"_2666":46480},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3170":426,"_27782":391,"_19244":46482,"_5":13232,"_26277":46404,"_2666":46483},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3170":427,"_27782":391,"_19244":46485,"_5":13232,"_26277":46404,"_2666":46486},[],"Locate the authz pod and Service.",{"_3170":428,"_27782":391,"_19244":46488,"_5":13232,"_26277":46404,"_2666":46489},[],"Check /health, logs and its database connection.",{"_3170":429,"_27782":391,"_19244":46491,"_5":13232,"_26277":46404,"_2666":46492},[],"Verify the DNS and port configured in externalAuthorization.",{"_3170":430,"_27782":391,"_19244":46494,"_5":13232,"_26277":46404,"_2666":46495},[],"Check the check route is /v1/ext\\_authz/check.",{"_3170":431,"_27782":391,"_19244":46497,"_5":13232,"_26277":46404,"_2666":46498},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3170":432,"_27782":391,"_19244":46500,"_5":13232,"_26277":46408,"_2666":46501},[],"Review kubectl describe pod first. Common causes are:",{"_3170":433,"_27782":391,"_19244":46503,"_5":13232,"_26277":46408,"_2666":46504},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3170":434,"_27782":391,"_19244":46506,"_5":13232,"_26277":46408,"_2666":46507},[],"unbound persistent volume;",{"_3170":435,"_27782":391,"_19244":46509,"_5":13232,"_26277":46408,"_2666":46510},[],"inaccessible image or incorrect pull policy;",{"_3170":436,"_27782":391,"_19244":46512,"_5":13232,"_26277":46408,"_2666":46513},[],"invalid cryptographic engine configuration;",{"_3170":437,"_27782":391,"_19244":46515,"_5":13232,"_26277":46408,"_2666":46516},[],"CPU or memory limits set too low;",{"_3170":438,"_27782":391,"_19244":46518,"_5":13232,"_26277":46408,"_2666":46519},[],"an incomplete prior migration.",{"_3170":439,"_27782":391,"_19244":46521,"_5":13232,"_26277":46408,"_2666":46522},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3170":440,"_27782":391,"_19244":46524,"_5":13232,"_26277":46408,"_2666":46525},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3170":441,"_27782":391,"_19244":46527,"_5":13232,"_26277":46412,"_2666":46528},[],"Domain and audit events depend on the bus publisher:",{"_3170":442,"_27782":391,"_19244":46530,"_5":13232,"_26277":46412,"_2666":46531},[],"verify it is enabled in the emitting service;",{"_3170":443,"_27782":391,"_19244":46533,"_5":13232,"_26277":46412,"_2666":46534},[],"check AMQP connectivity and credentials;",{"_3170":444,"_27782":391,"_19244":46536,"_5":13232,"_26277":46412,"_2666":46537},[],"review exchange, routing key, queues and consumers;",{"_3170":445,"_27782":391,"_19244":46539,"_5":13232,"_26277":46412,"_2666":46540},[],"inspect dead-letter queues;",{"_3170":446,"_27782":391,"_19244":46542,"_5":13232,"_26277":46412,"_2666":46543},[],"alert on orphan durable queues and backlog growth.",{"_3170":447,"_27782":391,"_19244":46545,"_5":13232,"_26277":46412,"_2666":46546},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3170":448,"_27782":391,"_19244":46548,"_5":13232,"_26277":46416,"_2666":46549},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_3170":449,"_27782":391,"_19244":46551,"_5":13232,"_26277":46416,"_2666":46552},[],"Before closing an incident, record:",{"_3170":450,"_27782":391,"_19244":46554,"_5":13232,"_26277":46416,"_2666":46555},[],"the confirmed cause;",{"_3170":451,"_27782":391,"_19244":46557,"_5":13232,"_26277":46416,"_2666":46558},[],"the time scope and affected resources;",{"_3170":452,"_27782":391,"_19244":46560,"_5":13232,"_26277":46416,"_2666":46561},[],"the commands or queries used;",{"_3170":453,"_27782":391,"_19244":46563,"_5":13232,"_26277":46416,"_2666":46564},[],"the applied change and how to revert it;",{"_3170":454,"_27782":391,"_19244":46566,"_5":13232,"_26277":46416,"_2666":46567},[],"validation from a consumer;",{"_3170":455,"_27782":391,"_19244":46569,"_5":13232,"_26277":46416,"_2666":46570},[],"the preventive action and its owner.",{"_3170":456,"_27782":456,"_5":13558,"_2666":46572,"_28124":46573,"_19244":46576,"_26277":456},"Access control",[45194,46574,46575],"Platform","Administration",[],{"_3170":457,"_27782":456,"_19244":46578,"_5":13232,"_26277":456,"_2666":46579},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3170":458,"_27782":456,"_5":28121,"_19244":46581,"_26277":46582,"_2666":46583},[],"/docs/pr-preview/pr-52/platform/administration/access-control#essential-concepts","Essential concepts",{"_3170":459,"_27782":456,"_5":28121,"_19244":46585,"_26277":46586,"_2666":46587},[],"/docs/pr-preview/pr-52/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3170":460,"_27782":456,"_5":28121,"_19244":46589,"_26277":46590,"_2666":46591},[],"/docs/pr-preview/pr-52/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3170":461,"_27782":456,"_5":28121,"_19244":46593,"_26277":46594,"_2666":46595},[],"/docs/pr-preview/pr-52/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3170":462,"_27782":456,"_5":28121,"_19244":46597,"_26277":46598,"_2666":46599},[],"/docs/pr-preview/pr-52/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3170":463,"_27782":456,"_5":28121,"_19244":46601,"_26277":46602,"_2666":46603},[],"/docs/pr-preview/pr-52/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3170":464,"_27782":456,"_5":28121,"_19244":46605,"_26277":46606,"_2666":46607},[],"/docs/pr-preview/pr-52/platform/administration/access-control#oidc-principals","OIDC principals",{"_3170":465,"_27782":456,"_5":28121,"_19244":46609,"_26277":46610,"_2666":46611},[],"/docs/pr-preview/pr-52/platform/administration/access-control#x509-principals","X.509 principals",{"_3170":466,"_27782":456,"_5":28121,"_19244":46613,"_26277":46614,"_2666":46615},[],"/docs/pr-preview/pr-52/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3170":467,"_27782":456,"_5":28121,"_19244":46617,"_26277":46618,"_2666":46619},[],"/docs/pr-preview/pr-52/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3170":468,"_27782":456,"_5":28121,"_19244":46621,"_26277":46622,"_2666":46623},[],"/docs/pr-preview/pr-52/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3170":469,"_27782":456,"_5":28121,"_19244":46625,"_26277":46626,"_2666":46627},[],"/docs/pr-preview/pr-52/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3170":470,"_27782":456,"_5":28121,"_19244":46629,"_26277":46630,"_2666":46631},[],"/docs/pr-preview/pr-52/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3170":471,"_27782":456,"_5":28121,"_19244":46633,"_26277":46634,"_2666":46635},[],"/docs/pr-preview/pr-52/platform/administration/access-control#http-rules","HTTP rules",{"_3170":472,"_27782":456,"_5":28121,"_19244":46637,"_26277":46638,"_2666":46639},[],"/docs/pr-preview/pr-52/platform/administration/access-control#included-policies","Included policies",{"_3170":473,"_27782":456,"_5":28121,"_19244":46641,"_26277":46642,"_2666":45830},[],"/docs/pr-preview/pr-52/platform/administration/access-control#provision-the-first-administrator",{"_3170":474,"_27782":456,"_5":28121,"_19244":46644,"_26277":46645,"_2666":46646},[],"/docs/pr-preview/pr-52/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3170":475,"_27782":456,"_5":28121,"_19244":46648,"_26277":46649,"_2666":46650},[],"/docs/pr-preview/pr-52/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3170":476,"_27782":456,"_5":28121,"_19244":46652,"_26277":46653,"_2666":46654},[],"/docs/pr-preview/pr-52/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3170":477,"_27782":456,"_5":28121,"_19244":46656,"_26277":46657,"_2666":46658},[],"/docs/pr-preview/pr-52/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3170":478,"_27782":456,"_5":28121,"_19244":46660,"_26277":46661,"_2666":46662},[],"/docs/pr-preview/pr-52/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3170":479,"_27782":456,"_5":28121,"_19244":46664,"_26277":46665,"_2666":46666},[],"/docs/pr-preview/pr-52/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3170":480,"_27782":456,"_5":28121,"_19244":46668,"_26277":46669,"_2666":46670},[],"/docs/pr-preview/pr-52/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3170":481,"_27782":456,"_5":28121,"_19244":46672,"_26277":46673,"_2666":46674},[],"/docs/pr-preview/pr-52/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3170":482,"_27782":456,"_5":28121,"_19244":46676,"_26277":46677,"_2666":46678},[],"/docs/pr-preview/pr-52/platform/administration/access-control#operational-checklist","Operational checklist",{"_3170":483,"_27782":456,"_5":28121,"_19244":46680,"_26277":46681,"_2666":46682},[],"/docs/pr-preview/pr-52/platform/administration/access-control#diagnostics","Diagnostics",{"_3170":484,"_27782":456,"_5":28121,"_19244":46684,"_26277":46685,"_2666":46686},[],"/docs/pr-preview/pr-52/platform/administration/access-control#the-response-is-401","The response is 401",{"_3170":485,"_27782":456,"_5":28121,"_19244":46688,"_26277":46689,"_2666":46690},[],"/docs/pr-preview/pr-52/platform/administration/access-control#the-response-is-403","The response is 403",{"_3170":486,"_27782":456,"_5":28121,"_19244":46692,"_26277":46693,"_2666":46694},[],"/docs/pr-preview/pr-52/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3170":487,"_27782":456,"_5":28121,"_19244":46696,"_26277":46697,"_2666":46698},[],"/docs/pr-preview/pr-52/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3170":488,"_27782":456,"_5":28121,"_19244":46700,"_26277":46701,"_2666":46702},[],"/docs/pr-preview/pr-52/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3170":489,"_27782":456,"_19244":46704,"_5":13232,"_26277":456,"_2666":46705},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3170":490,"_27782":456,"_19244":46707,"_5":13232,"_26277":456,"_2666":46708},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3170":491,"_27782":456,"_19244":46710,"_5":13232,"_26277":456,"_2666":46711},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3170":492,"_27782":456,"_19244":46713,"_5":13232,"_26277":46582,"_2666":46714},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3170":493,"_27782":456,"_19244":46716,"_5":13232,"_26277":46582,"_2666":46717},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3170":494,"_27782":456,"_19244":46719,"_5":13232,"_26277":46582,"_2666":46720},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3170":495,"_27782":456,"_19244":46722,"_5":13232,"_26277":46582,"_2666":46723},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3170":496,"_27782":456,"_19244":46725,"_5":13232,"_26277":46582,"_2666":46726},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3170":497,"_27782":456,"_19244":46728,"_5":13232,"_26277":46582,"_2666":46729},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3170":498,"_27782":456,"_19244":46731,"_5":13232,"_26277":46586,"_2666":46732},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3170":499,"_27782":456,"_19244":46734,"_5":13232,"_26277":46586,"_2666":46735},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3170":500,"_27782":456,"_19244":46737,"_5":13232,"_26277":46590,"_2666":46738},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3170":501,"_27782":456,"_19244":46740,"_5":13232,"_26277":46590,"_2666":46741},[],"The decision is made **before forwarding the request to the service**:",{"_3170":502,"_27782":456,"_19244":46743,"_5":13232,"_26277":46590,"_2666":46744},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3170":503,"_27782":456,"_19244":46746,"_5":13232,"_26277":46590,"_2666":46747},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3170":504,"_27782":456,"_19244":46749,"_5":13232,"_26277":46590,"_2666":46750},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3170":505,"_27782":456,"_19244":46752,"_5":13232,"_26277":46590,"_2666":46753},[],"It separately loads the policies granted to each principal.",{"_3170":506,"_27782":456,"_19244":46755,"_5":13232,"_26277":46590,"_2666":46756},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3170":507,"_27782":456,"_19244":46758,"_5":13232,"_26277":46590,"_2666":46759},[],"`authz` looks for an HTTP rule granting that action.",{"_3170":508,"_27782":456,"_19244":46761,"_5":13232,"_26277":46590,"_2666":46762},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3170":509,"_27782":456,"_19244":46764,"_5":13232,"_26277":46590,"_2666":46765},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3170":510,"_27782":456,"_19244":46767,"_5":13232,"_26277":46590,"_2666":46768},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3170":511,"_27782":456,"_19244":46770,"_5":13232,"_26277":46590,"_2666":46771},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3170":512,"_27782":456,"_19244":46773,"_5":13232,"_26277":46594,"_2666":46774},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3170":513,"_27782":456,"_19244":46776,"_5":13232,"_26277":46594,"_2666":46777},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3170":514,"_27782":456,"_19244":46779,"_5":13232,"_26277":46594,"_2666":46780},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3170":515,"_27782":456,"_19244":46782,"_5":13232,"_26277":46594,"_2666":46783},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3170":516,"_27782":456,"_19244":46785,"_5":13232,"_26277":46594,"_2666":46786},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3170":517,"_27782":456,"_19244":46788,"_5":13232,"_26277":46594,"_2666":46789},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3170":518,"_27782":456,"_19244":46791,"_5":13232,"_26277":46594,"_2666":46792},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3170":519,"_27782":456,"_19244":46794,"_5":13232,"_26277":46594,"_2666":46795},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3170":520,"_27782":456,"_19244":46797,"_5":13232,"_26277":46598,"_2666":46798},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3170":521,"_27782":456,"_19244":46800,"_5":13232,"_26277":46598,"_2666":46801},[],"The decision is made with the domain operation context:",{"_3170":522,"_27782":456,"_19244":46803,"_5":13232,"_26277":46598,"_2666":46804},[],"The middleware extracts the credential and resolves the matching principals.",{"_3170":523,"_27782":456,"_19244":46806,"_5":13232,"_26277":46598,"_2666":46807},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3170":524,"_27782":456,"_19244":46809,"_5":13232,"_26277":46598,"_2666":46810},[],"`authz` gathers the entity rules of the granted policies.",{"_3170":525,"_27782":456,"_19244":46812,"_5":13232,"_26277":46598,"_2666":46813},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3170":526,"_27782":456,"_19244":46815,"_5":13232,"_26277":46598,"_2666":46816},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3170":527,"_27782":456,"_19244":46818,"_5":13232,"_26277":46598,"_2666":46819},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3170":528,"_27782":456,"_19244":46821,"_5":13232,"_26277":46598,"_2666":46822},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3170":529,"_27782":456,"_19244":46824,"_5":13232,"_26277":46598,"_2666":46825},[],"Actions fall into two groups:",{"_3170":530,"_27782":456,"_19244":46827,"_5":13232,"_26277":46598,"_2666":46828},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3170":531,"_27782":456,"_19244":46830,"_5":13232,"_26277":46598,"_2666":46831},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3170":532,"_27782":456,"_19244":46833,"_5":13232,"_26277":46598,"_2666":46834},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3170":533,"_27782":456,"_19244":46836,"_5":13232,"_26277":46602,"_2666":46837},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3170":534,"_27782":456,"_19244":46839,"_5":13232,"_26277":46602,"_2666":46840},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3170":535,"_27782":456,"_19244":46842,"_5":13232,"_26277":46602,"_2666":46843},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3170":536,"_27782":456,"_19244":46845,"_5":13232,"_26277":46606,"_2666":46846},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3170":537,"_27782":456,"_19244":46848,"_5":13232,"_26277":46606,"_2666":46849},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3170":538,"_27782":456,"_19244":46851,"_5":13232,"_26277":46606,"_2666":46852},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3170":539,"_27782":456,"_19244":46854,"_5":13232,"_26277":46606,"_2666":46855},[],"The implemented operators are:",{"_3170":540,"_27782":456,"_19244":46857,"_5":13232,"_26277":46606,"_2666":46858},[],"`equals`, for exact equality;",{"_3170":541,"_27782":456,"_19244":46860,"_5":13232,"_26277":46606,"_2666":46861},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3170":542,"_27782":456,"_19244":46863,"_5":13232,"_26277":46606,"_2666":46864},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3170":543,"_27782":456,"_19244":46866,"_5":13232,"_26277":46606,"_2666":46867},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3170":544,"_27782":456,"_19244":46869,"_5":13232,"_26277":46610,"_2666":46870},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3170":545,"_27782":456,"_19244":46872,"_5":13232,"_26277":46610,"_2666":46873},[],"The available modes are:",{"_3170":546,"_27782":456,"_19244":46875,"_5":13232,"_26277":46610,"_2666":46876},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3170":547,"_27782":456,"_19244":46878,"_5":13232,"_26277":46610,"_2666":46879},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3170":548,"_27782":456,"_19244":46881,"_5":13232,"_26277":46610,"_2666":46882},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3170":549,"_27782":456,"_19244":46884,"_5":13232,"_26277":46610,"_2666":46885},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3170":550,"_27782":456,"_19244":46887,"_5":13232,"_26277":46610,"_2666":46888},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3170":551,"_27782":456,"_19244":46890,"_5":13232,"_26277":46610,"_2666":46891},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3170":552,"_27782":456,"_19244":46893,"_5":13232,"_26277":46614,"_2666":46894},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3170":553,"_27782":456,"_19244":46896,"_5":13232,"_26277":46614,"_2666":46897},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3170":554,"_27782":456,"_19244":46899,"_5":13232,"_26277":46614,"_2666":46900},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3170":555,"_27782":456,"_19244":46902,"_5":13232,"_26277":46614,"_2666":46903},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3170":556,"_27782":456,"_19244":46905,"_5":13232,"_26277":46622,"_2666":46906},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3170":557,"_27782":456,"_19244":46908,"_5":13232,"_26277":46622,"_2666":46909},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3170":558,"_27782":456,"_19244":46911,"_5":13232,"_26277":46626,"_2666":46912},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3170":559,"_27782":456,"_19244":46914,"_5":13232,"_26277":46626,"_2666":46915},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3170":560,"_27782":456,"_19244":46917,"_5":13232,"_26277":46630,"_2666":46918},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3170":561,"_27782":456,"_19244":46920,"_5":13232,"_26277":46630,"_2666":46921},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3170":562,"_27782":456,"_19244":46923,"_5":13232,"_26277":46630,"_2666":46924},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3170":563,"_27782":456,"_19244":46926,"_5":13232,"_26277":46634,"_2666":46927},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3170":564,"_27782":456,"_19244":46929,"_5":13232,"_26277":46634,"_2666":46930},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3170":565,"_27782":456,"_19244":46932,"_5":13232,"_26277":46634,"_2666":46933},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3170":566,"_27782":456,"_19244":46935,"_5":13232,"_26277":46634,"_2666":46936},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3170":567,"_27782":456,"_19244":46938,"_5":13232,"_26277":46634,"_2666":46939},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3170":568,"_27782":456,"_19244":46941,"_5":13232,"_26277":46634,"_2666":46942},[],"Note that:",{"_3170":569,"_27782":456,"_19244":46944,"_5":13232,"_26277":46634,"_2666":46945},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3170":570,"_27782":456,"_19244":46947,"_5":13232,"_26277":46634,"_2666":46948},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3170":571,"_27782":456,"_19244":46950,"_5":13232,"_26277":46634,"_2666":46951},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3170":572,"_27782":456,"_19244":46953,"_5":13232,"_26277":46638,"_2666":46954},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3170":573,"_27782":456,"_19244":46956,"_5":13232,"_26277":46638,"_2666":46957},[],"full and read-only access to certificates and authorities;",{"_3170":574,"_27782":456,"_19244":46959,"_5":13232,"_26277":46638,"_2666":46960},[],"full and read-only access to the KMS;",{"_3170":575,"_27782":456,"_19244":46962,"_5":13232,"_26277":46638,"_2666":46963},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3170":576,"_27782":456,"_19244":46965,"_5":13232,"_26277":46638,"_2666":46966},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3170":577,"_27782":456,"_19244":46968,"_5":13232,"_26277":46638,"_2666":46969},[],"console access;",{"_3170":578,"_27782":456,"_19244":46971,"_5":13232,"_26277":46638,"_2666":46972},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3170":579,"_27782":456,"_19244":46974,"_5":13232,"_26277":46638,"_2666":46975},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3170":580,"_27782":456,"_19244":46977,"_5":13232,"_26277":46638,"_2666":46978},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3170":581,"_27782":456,"_19244":46980,"_5":13232,"_26277":46642,"_2666":46981},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3170":582,"_27782":456,"_19244":46983,"_5":13232,"_26277":46642,"_2666":46984},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3170":583,"_27782":456,"_19244":46986,"_5":13232,"_26277":46642,"_2666":46987},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3170":584,"_27782":456,"_19244":46989,"_5":13232,"_26277":46645,"_2666":46990},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3170":585,"_27782":456,"_19244":46992,"_5":13232,"_26277":46649,"_2666":46993},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3170":586,"_27782":456,"_19244":46995,"_5":13232,"_26277":46649,"_2666":46996},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3170":587,"_27782":456,"_19244":46998,"_5":13232,"_26277":46653,"_2666":46999},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3170":588,"_27782":456,"_19244":47001,"_5":13232,"_26277":46657,"_2666":47002},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3170":589,"_27782":456,"_19244":47004,"_5":13232,"_26277":46661,"_2666":47005},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3170":590,"_27782":456,"_19244":47007,"_5":13232,"_26277":46665,"_2666":47008},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3170":591,"_27782":456,"_19244":47010,"_5":13232,"_26277":46665,"_2666":47011},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3170":592,"_27782":456,"_19244":47013,"_5":13232,"_26277":46669,"_2666":47014},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3170":593,"_27782":456,"_19244":47016,"_5":13232,"_26277":46669,"_2666":47017},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3170":594,"_27782":456,"_19244":47019,"_5":13232,"_26277":46669,"_2666":47020},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3170":595,"_27782":456,"_19244":47022,"_5":13232,"_26277":46669,"_2666":47023},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3170":596,"_27782":456,"_19244":47025,"_5":13232,"_26277":46669,"_2666":47026},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3170":597,"_27782":456,"_19244":47028,"_5":13232,"_26277":46669,"_2666":47029},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3170":598,"_27782":456,"_19244":47031,"_5":13232,"_26277":46669,"_2666":47032},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3170":599,"_27782":456,"_19244":47034,"_5":13232,"_26277":46669,"_2666":47035},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3170":600,"_27782":456,"_19244":47037,"_5":13232,"_26277":46673,"_2666":47038},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3170":601,"_27782":456,"_19244":47040,"_5":13232,"_26277":46673,"_2666":47041},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3170":602,"_27782":456,"_19244":47043,"_5":13232,"_26277":46673,"_2666":47044},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3170":603,"_27782":456,"_19244":47046,"_5":13232,"_26277":46677,"_2666":47047},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3170":604,"_27782":456,"_19244":47049,"_5":13232,"_26277":46677,"_2666":47050},[],"Use groups or stable roles for people and independent identities for automations.",{"_3170":605,"_27782":456,"_19244":47052,"_5":13232,"_26277":46677,"_2666":47053},[],"Keep at least two recovery administrators and test their access periodically.",{"_3170":606,"_27782":456,"_19244":47055,"_5":13232,"_26277":46677,"_2666":47056},[],"Review active principals, their matches and their grants after IdP changes.",{"_3170":607,"_27782":456,"_19244":47058,"_5":13232,"_26277":46677,"_2666":47059},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3170":608,"_27782":456,"_19244":47061,"_5":13232,"_26277":46677,"_2666":47062},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3170":609,"_27782":456,"_19244":47064,"_5":13232,"_26277":46677,"_2666":47065},[],"Always test one allowed and one denied operation for each role.",{"_3170":610,"_27782":456,"_19244":47067,"_5":13232,"_26277":46677,"_2666":47068},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3170":611,"_27782":456,"_19244":47070,"_5":13232,"_26277":46685,"_2666":47071},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3170":612,"_27782":456,"_19244":47073,"_5":13232,"_26277":46689,"_2666":47074},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3170":613,"_27782":456,"_19244":47076,"_5":13232,"_26277":46689,"_2666":47077},[],"that an active principal of the correct type exists;",{"_3170":614,"_27782":456,"_19244":47079,"_5":13232,"_26277":46689,"_2666":47080},[],"that the claim paths and values match the real token exactly;",{"_3170":615,"_27782":456,"_19244":47082,"_5":13232,"_26277":46689,"_2666":47083},[],"that all of the principal's conditions hold;",{"_3170":616,"_27782":456,"_19244":47085,"_5":13232,"_26277":46689,"_2666":47086},[],"that the principal has the expected policy granted;",{"_3170":617,"_27782":456,"_19244":47088,"_5":13232,"_26277":46689,"_2666":47089},[],"that the policy includes the action and the requested resource type or route;",{"_3170":618,"_27782":456,"_19244":47091,"_5":13232,"_26277":46689,"_2666":47092},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3170":619,"_27782":456,"_19244":47094,"_5":13232,"_26277":46689,"_2666":47095},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_3170":620,"_27782":456,"_19244":47097,"_5":13232,"_26277":46693,"_2666":47098},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3170":621,"_27782":456,"_19244":47100,"_5":13232,"_26277":46697,"_2666":47101},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3170":622,"_27782":456,"_19244":47103,"_5":13232,"_26277":46701,"_2666":47104},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3170":623,"_27782":456,"_19244":47106,"_5":13232,"_26277":46701,"_2666":47107},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3170":624,"_27782":624,"_5":13558,"_2666":47109,"_28124":47110,"_19244":47111,"_26277":624},"Alerts and subscriptions",[45194,46574,46575],[],{"_3170":625,"_27782":624,"_19244":47113,"_5":13232,"_26277":624,"_2666":47114},[],"Send PKI events to people and external systems.",{"_3170":626,"_27782":624,"_5":28121,"_19244":47116,"_26277":47117,"_2666":47118},[],"/docs/pr-preview/pr-52/platform/administration/alerts#how-it-works","How it works",{"_3170":627,"_27782":624,"_5":28121,"_19244":47120,"_26277":47121,"_2666":47122},[],"/docs/pr-preview/pr-52/platform/administration/alerts#available-channels","Available channels",{"_3170":628,"_27782":624,"_5":28121,"_19244":47124,"_26277":47125,"_2666":47126},[],"/docs/pr-preview/pr-52/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3170":629,"_27782":624,"_5":28121,"_19244":47128,"_26277":47129,"_2666":47130},[],"/docs/pr-preview/pr-52/platform/administration/alerts#choose-the-event","Choose the event",{"_3170":630,"_27782":624,"_5":28121,"_19244":47132,"_26277":47133,"_2666":47134},[],"/docs/pr-preview/pr-52/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3170":631,"_27782":624,"_5":28121,"_19244":47136,"_26277":47137,"_2666":47138},[],"/docs/pr-preview/pr-52/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3170":632,"_27782":624,"_5":28121,"_19244":47140,"_26277":47141,"_2666":47142},[],"/docs/pr-preview/pr-52/platform/administration/alerts#review-and-activate","Review and activate",{"_3170":633,"_27782":624,"_5":28121,"_19244":47144,"_26277":47145,"_2666":47146},[],"/docs/pr-preview/pr-52/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3170":634,"_27782":624,"_5":28121,"_19244":47148,"_26277":47149,"_2666":47150},[],"/docs/pr-preview/pr-52/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3170":635,"_27782":624,"_5":28121,"_19244":47152,"_26277":47153,"_2666":47154},[],"/docs/pr-preview/pr-52/platform/administration/alerts#event-families","Event families",{"_3170":636,"_27782":624,"_19244":47156,"_5":13232,"_26277":624,"_2666":47157},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3170":637,"_27782":624,"_19244":47159,"_5":13232,"_26277":47117,"_2666":47160},[],"A service publishes a domain event.",{"_3170":638,"_27782":624,"_19244":47162,"_5":13232,"_26277":47117,"_2666":47163},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3170":639,"_27782":624,"_19244":47165,"_5":13232,"_26277":47117,"_2666":47166},[],"Each subscription's filter decides whether it should be notified.",{"_3170":640,"_27782":624,"_19244":47168,"_5":13232,"_26277":47117,"_2666":47169},[],"Lamassu delivers the event to the configured channel.",{"_3170":641,"_27782":624,"_19244":47171,"_5":13232,"_26277":47117,"_2666":47172},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3170":642,"_27782":624,"_19244":47174,"_5":13232,"_26277":47121,"_2666":47175},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3170":643,"_27782":624,"_19244":47177,"_5":13232,"_26277":47121,"_2666":47178},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3170":644,"_27782":624,"_19244":47180,"_5":13232,"_26277":47121,"_2666":47181},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3170":645,"_27782":624,"_19244":47183,"_5":13232,"_26277":47121,"_2666":47184},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3170":646,"_27782":624,"_19244":47186,"_5":13232,"_26277":47121,"_2666":47187},[],"`apikey_options` requires `header` and `key`.",{"_3170":647,"_27782":624,"_19244":47189,"_5":13232,"_26277":47121,"_2666":47190},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3170":648,"_27782":624,"_19244":47192,"_5":13232,"_26277":47121,"_2666":47193},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3170":649,"_27782":624,"_19244":47195,"_5":13232,"_26277":47121,"_2666":47196},[],"The alerts API reference documents the full `http_client` schema.",{"_3170":650,"_27782":624,"_19244":47198,"_5":13232,"_26277":47129,"_2666":47199},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3170":651,"_27782":624,"_19244":47201,"_5":13232,"_26277":47133,"_2666":47202},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3170":652,"_27782":624,"_19244":47204,"_5":13232,"_26277":47137,"_2666":47205},[],"Add a filter if you don't want to receive every instance of the event.",{"_3170":653,"_27782":624,"_19244":47207,"_5":13232,"_26277":47137,"_2666":47208},[],"**None** notifies all instances of the event.",{"_3170":654,"_27782":624,"_19244":47210,"_5":13232,"_26277":47137,"_2666":47211},[],"**JSON Path** evaluates one or more specific fields.",{"_3170":655,"_27782":624,"_19244":47213,"_5":13232,"_26277":47137,"_2666":47214},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3170":656,"_27782":624,"_19244":47216,"_5":13232,"_26277":47137,"_2666":47217},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3170":657,"_27782":624,"_19244":47219,"_5":13232,"_26277":47137,"_2666":47220},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3170":658,"_27782":624,"_19244":47222,"_5":13232,"_26277":47141,"_2666":47223},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3170":659,"_27782":624,"_19244":47225,"_5":13232,"_26277":47145,"_2666":47226},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3170":660,"_27782":624,"_19244":47228,"_5":13232,"_26277":47145,"_2666":47229},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3170":661,"_27782":624,"_19244":47231,"_5":13232,"_26277":47145,"_2666":47232},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3170":662,"_27782":624,"_19244":47234,"_5":13232,"_26277":47145,"_2666":47235},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3170":663,"_27782":624,"_19244":47237,"_5":13232,"_26277":47145,"_2666":47238},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3170":664,"_27782":624,"_19244":47240,"_5":13232,"_26277":47145,"_2666":47241},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3170":665,"_27782":624,"_19244":47243,"_5":13232,"_26277":47145,"_2666":47244},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3170":666,"_27782":624,"_19244":47246,"_5":13232,"_26277":47145,"_2666":47247},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3170":667,"_27782":624,"_19244":47249,"_5":13232,"_26277":47149,"_2666":47250},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3170":668,"_27782":624,"_19244":47252,"_5":13232,"_26277":47153,"_2666":47253},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3170":669,"_27782":624,"_19244":47255,"_5":13232,"_26277":47153,"_2666":47256},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3170":670,"_27782":624,"_19244":47258,"_5":13232,"_26277":47153,"_2666":47259},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3170":671,"_27782":624,"_19244":47261,"_5":13232,"_26277":47153,"_2666":47262},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3170":672,"_27782":624,"_19244":47264,"_5":13232,"_26277":47153,"_2666":47265},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3170":673,"_27782":624,"_19244":47267,"_5":13232,"_26277":47153,"_2666":47268},[],"**Validation:** `va.role.crl.create`.",{"_3170":674,"_27782":624,"_19244":47270,"_5":13232,"_26277":47153,"_2666":47271},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3170":675,"_27782":624,"_19244":47273,"_5":13232,"_26277":47153,"_2666":47274},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3170":676,"_27782":676,"_5":13558,"_2666":47276,"_28124":47277,"_19244":47278,"_26277":676},"Audit logs",[45194,46574,46575],[],{"_3170":677,"_27782":676,"_19244":47280,"_5":13232,"_26277":676,"_2666":47281},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3170":678,"_27782":676,"_5":28121,"_19244":47283,"_26277":47284,"_2666":47285},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3170":679,"_27782":676,"_5":28121,"_19244":47287,"_26277":47288,"_2666":47289},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#coverage","Coverage",{"_3170":680,"_27782":676,"_5":28121,"_19244":47291,"_26277":47292,"_2666":47293},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3170":681,"_27782":676,"_5":28121,"_19244":47295,"_26277":47296,"_2666":47297},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3170":682,"_27782":676,"_5":28121,"_19244":47299,"_26277":47300,"_2666":47301},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3170":683,"_27782":676,"_5":28121,"_19244":47303,"_26277":47304,"_2666":47305},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3170":684,"_27782":676,"_5":28121,"_19244":47307,"_26277":47308,"_2666":47309},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3170":685,"_27782":676,"_5":28121,"_19244":47311,"_26277":47312,"_2666":47313},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3170":686,"_27782":676,"_5":28121,"_19244":47315,"_26277":47316,"_2666":47317},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3170":687,"_27782":676,"_5":28121,"_19244":47319,"_26277":47320,"_2666":47321},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3170":688,"_27782":676,"_5":28121,"_19244":47323,"_26277":47324,"_2666":47325},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3170":689,"_27782":676,"_19244":47327,"_5":13232,"_26277":676,"_2666":47328},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3170":690,"_27782":676,"_19244":47330,"_5":13232,"_26277":47284,"_2666":47331},[],"The audit body includes:",{"_3170":691,"_27782":676,"_19244":47333,"_5":13232,"_26277":47284,"_2666":47334},[],"input: data received by the operation;",{"_3170":692,"_27782":676,"_19244":47336,"_5":13232,"_26277":47284,"_2666":47337},[],"has\\_error: whether the service returned an error;",{"_3170":693,"_27782":676,"_19244":47339,"_5":13232,"_26277":47284,"_2666":47340},[],"output: produced result or error message;",{"_3170":694,"_27782":676,"_19244":47342,"_5":13232,"_26277":47284,"_2666":47343},[],"principals: identifiers of the principals that matched the request.",{"_3170":695,"_27782":676,"_19244":47345,"_5":13232,"_26277":47284,"_2666":47346},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3170":696,"_27782":676,"_19244":47348,"_5":13232,"_26277":47284,"_2666":47349},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3170":697,"_27782":676,"_19244":47351,"_5":13232,"_26277":47288,"_2666":47352},[],"The backend applies auditing to mutations of:",{"_3170":698,"_27782":676,"_19244":47354,"_5":13232,"_26277":47288,"_2666":47355},[],"authorities, certificates and issuance profiles;",{"_3170":699,"_27782":676,"_19244":47357,"_5":13232,"_26277":47288,"_2666":47358},[],"keys and KMS engines;",{"_3170":700,"_27782":676,"_19244":47360,"_5":13232,"_26277":47288,"_2666":47361},[],"devices and identities;",{"_3170":701,"_27782":676,"_19244":47363,"_5":13232,"_26277":47288,"_2666":47364},[],"DMSs and enrollment operations;",{"_3170":702,"_27782":676,"_19244":47366,"_5":13232,"_26277":47288,"_2666":47367},[],"validation functions and CRL;",{"_3170":703,"_27782":676,"_19244":47369,"_5":13232,"_26277":47288,"_2666":47370},[],"principals, policies and authorization grants.",{"_3170":704,"_27782":676,"_19244":47372,"_5":13232,"_26277":47288,"_2666":47373},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3170":705,"_27782":676,"_19244":47375,"_5":13232,"_26277":47292,"_2666":47376},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3170":706,"_27782":676,"_19244":47378,"_5":13232,"_26277":47292,"_2666":47379},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3170":707,"_27782":676,"_19244":47381,"_5":13232,"_26277":47292,"_2666":47382},[],"Design the consumer to:",{"_3170":708,"_27782":676,"_19244":47384,"_5":13232,"_26277":47292,"_2666":47385},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3170":709,"_27782":676,"_19244":47387,"_5":13232,"_26277":47292,"_2666":47388},[],"keep the complete CloudEvent unmodified;",{"_3170":710,"_27782":676,"_19244":47390,"_5":13232,"_26277":47292,"_2666":47391},[],"record the ingestion time and detect duplicates by ID;",{"_3170":711,"_27782":676,"_19244":47393,"_5":13232,"_26277":47292,"_2666":47394},[],"encrypt in transit and at rest;",{"_3170":712,"_27782":676,"_19244":47396,"_5":13232,"_26277":47292,"_2666":47397},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3170":713,"_27782":676,"_19244":47399,"_5":13232,"_26277":47292,"_2666":47400},[],"apply an explicit retention and legal hold policy;",{"_3170":714,"_27782":676,"_19244":47402,"_5":13232,"_26277":47292,"_2666":47403},[],"alert if it stops consuming or the pending queue grows.",{"_3170":715,"_27782":676,"_19244":47405,"_5":13232,"_26277":47296,"_2666":47406},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3170":716,"_27782":676,"_19244":47408,"_5":13232,"_26277":47296,"_2666":47409},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3170":717,"_27782":676,"_19244":47411,"_5":13232,"_26277":47304,"_2666":47412},[],"Start from the reported time and normalize every source to UTC.",{"_3170":718,"_27782":676,"_19244":47414,"_5":13232,"_26277":47308,"_2666":47415},[],"Filter by event type, service source and resource identifier.",{"_3170":719,"_27782":676,"_19244":47417,"_5":13232,"_26277":47312,"_2666":47418},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3170":720,"_27782":676,"_19244":47420,"_5":13232,"_26277":47316,"_2666":47421},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3170":721,"_27782":676,"_19244":47423,"_5":13232,"_26277":47320,"_2666":47424},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3170":722,"_27782":676,"_19244":47426,"_5":13232,"_26277":47324,"_2666":47427},[],"Generate a controlled mutation in a test environment and check that:",{"_3170":723,"_27782":676,"_19244":47429,"_5":13232,"_26277":47324,"_2666":47430},[],"a successful audit event appears;",{"_3170":724,"_27782":676,"_19244":47432,"_5":13232,"_26277":47324,"_2666":47433},[],"the principal matches the identity used;",{"_3170":725,"_27782":676,"_19244":47435,"_5":13232,"_26277":47324,"_2666":47436},[],"the consumer persists it exactly once;",{"_3170":726,"_27782":676,"_19244":47438,"_5":13232,"_26277":47324,"_2666":47439},[],"it can be retrieved by resource, actor and period;",{"_3170":727,"_27782":676,"_19244":47441,"_5":13232,"_26277":47324,"_2666":47442},[],"a consumer outage raises an alert.",{"_3170":728,"_27782":676,"_19244":47444,"_5":13232,"_26277":47324,"_2666":47445},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3170":729,"_27782":729,"_5":13558,"_2666":47447,"_28124":47448,"_19244":47449,"_26277":729},"Platform architecture",[45194,46574],[],{"_3170":730,"_27782":729,"_19244":47451,"_5":13232,"_26277":729,"_2666":47452},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3170":731,"_27782":729,"_5":28121,"_19244":47454,"_26277":47455,"_2666":47456},[],"/docs/pr-preview/pr-52/platform/concepts/architecture#control-plane","Control plane",{"_3170":732,"_27782":729,"_5":28121,"_19244":47458,"_26277":47459,"_2666":47460},[],"/docs/pr-preview/pr-52/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3170":733,"_27782":729,"_5":28121,"_19244":47462,"_26277":47463,"_2666":47464},[],"/docs/pr-preview/pr-52/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3170":734,"_27782":729,"_5":28121,"_19244":47466,"_26277":47467,"_2666":47468},[],"/docs/pr-preview/pr-52/platform/concepts/architecture#status-and-validation","Status and validation",{"_3170":735,"_27782":729,"_5":28121,"_19244":47470,"_26277":47471,"_2666":47472},[],"/docs/pr-preview/pr-52/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3170":736,"_27782":729,"_19244":47474,"_5":13232,"_26277":729,"_2666":47475},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3170":737,"_27782":729,"_19244":47477,"_5":13232,"_26277":729,"_2666":47478},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3170":738,"_27782":729,"_19244":47480,"_5":13232,"_26277":47455,"_2666":47481},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3170":739,"_27782":729,"_19244":47483,"_5":13232,"_26277":47459,"_2666":47484},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3170":740,"_27782":729,"_19244":47486,"_5":13232,"_26277":47463,"_2666":47487},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3170":741,"_27782":729,"_19244":47489,"_5":13232,"_26277":47467,"_2666":47490},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3170":742,"_27782":729,"_19244":47492,"_5":13232,"_26277":47471,"_2666":47493},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3170":743,"_27782":743,"_5":13558,"_2666":47495,"_28124":47496,"_19244":47497,"_26277":743},"How Lamassu works",[45194,46574],[],{"_3170":744,"_27782":743,"_19244":47499,"_5":13232,"_26277":743,"_2666":47500},[],"The mental model of trust, keys, certificates and devices.",{"_3170":745,"_27782":743,"_5":28121,"_19244":47502,"_26277":47503,"_2666":47504},[],"/docs/pr-preview/pr-52/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3170":746,"_27782":743,"_5":28121,"_19244":47506,"_26277":47507,"_2666":47508},[],"/docs/pr-preview/pr-52/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3170":747,"_27782":743,"_19244":47510,"_5":13232,"_26277":743,"_2666":47511},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3170":748,"_27782":743,"_19244":47513,"_5":13232,"_26277":47503,"_2666":47514},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3170":749,"_27782":743,"_19244":47516,"_5":13232,"_26277":47503,"_2666":47517},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3170":750,"_27782":743,"_19244":47519,"_5":13232,"_26277":47503,"_2666":47520},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3170":751,"_27782":743,"_19244":47522,"_5":13232,"_26277":47503,"_2666":47523},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3170":752,"_27782":743,"_19244":47525,"_5":13232,"_26277":47503,"_2666":47526},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3170":753,"_27782":743,"_19244":47528,"_5":13232,"_26277":47507,"_2666":47529},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3170":754,"_27782":743,"_19244":47531,"_5":13232,"_26277":47507,"_2666":47532},[],"A DMS relates that CA to an enrollment policy.",{"_3170":755,"_27782":743,"_19244":47534,"_5":13232,"_26277":47507,"_2666":47535},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3170":756,"_27782":743,"_19244":47537,"_5":13232,"_26277":47507,"_2666":47538},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3170":757,"_27782":743,"_19244":47540,"_5":13232,"_26277":47507,"_2666":47541},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3170":758,"_27782":743,"_19244":47543,"_5":13232,"_26277":47507,"_2666":47544},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3170":759,"_27782":743,"_19244":47546,"_5":13232,"_26277":47507,"_2666":47547},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3170":760,"_27782":760,"_5":13558,"_2666":47549,"_28124":47550,"_19244":47552,"_26277":760},"Devices and identities",[45194,46574,47551,47549],"IoT Fleets",[],{"_3170":761,"_27782":760,"_19244":47554,"_5":13232,"_26277":760,"_2666":47555},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3170":762,"_27782":760,"_5":28121,"_19244":47557,"_26277":47558,"_2666":47559},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#device-states","Device states",{"_3170":763,"_27782":760,"_5":28121,"_19244":47561,"_26277":47562,"_2666":47563},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3170":764,"_27782":760,"_5":28121,"_19244":47565,"_26277":47566,"_2666":47567},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3170":765,"_27782":760,"_5":28121,"_19244":47569,"_26277":47570,"_2666":47571},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3170":766,"_27782":760,"_5":28121,"_19244":47573,"_26277":47574,"_2666":47575},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3170":767,"_27782":760,"_5":28121,"_19244":47577,"_26277":47578,"_2666":47579},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3170":768,"_27782":760,"_5":28121,"_19244":47581,"_26277":47582,"_2666":47583},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3170":769,"_27782":760,"_5":28121,"_19244":47585,"_26277":47586,"_2666":47587},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3170":770,"_27782":760,"_5":28121,"_19244":47589,"_26277":47590,"_2666":47591},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3170":771,"_27782":760,"_5":28121,"_19244":47593,"_26277":47594,"_2666":47595},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3170":772,"_27782":760,"_5":28121,"_19244":47597,"_26277":47598,"_2666":47599},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3170":773,"_27782":760,"_19244":47601,"_5":13232,"_26277":760,"_2666":47602},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3170":774,"_27782":760,"_19244":47604,"_5":13232,"_26277":760,"_2666":47605},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3170":775,"_27782":760,"_19244":47607,"_5":13232,"_26277":47558,"_2666":47608},[],"Operational view",{"_3170":776,"_27782":760,"_19244":47610,"_5":13232,"_26277":47558,"_2666":47611},[],"Meaning",{"_3170":777,"_27782":760,"_19244":47613,"_5":13232,"_26277":47558,"_2666":47614},[],"**No Identity**",{"_3170":778,"_27782":760,"_19244":47616,"_5":13232,"_26277":47558,"_2666":47617},[],"A record exists without an associated identity.",{"_3170":779,"_27782":760,"_19244":47619,"_5":13232,"_26277":47558,"_2666":47620},[],"**Active**",{"_3170":780,"_27782":760,"_19244":47622,"_5":13232,"_26277":47558,"_2666":47623},[],"The slot is active; also check certificate dates, status and usages.",{"_3170":781,"_27782":760,"_19244":47625,"_5":13232,"_26277":47558,"_2666":47626},[],"**Renewal Pending**",{"_3170":782,"_27782":760,"_19244":47628,"_5":13232,"_26277":47558,"_2666":47629},[],"The identity is in the operational renewal window.",{"_3170":783,"_27782":760,"_19244":47631,"_5":13232,"_26277":47558,"_2666":47632},[],"**Expiring Soon**",{"_3170":784,"_27782":760,"_19244":47634,"_5":13232,"_26277":47558,"_2666":47635},[],"Expiration is approaching according to configured thresholds.",{"_3170":785,"_27782":760,"_19244":47637,"_5":13232,"_26277":47558,"_2666":47638},[],"**Expired**",{"_3170":786,"_27782":760,"_19244":47640,"_5":13232,"_26277":47558,"_2666":47641},[],"The identity has expired.",{"_3170":787,"_27782":760,"_19244":47643,"_5":13232,"_26277":47558,"_2666":47644},[],"**Revoked**",{"_3170":788,"_27782":760,"_19244":47646,"_5":13232,"_26277":47558,"_2666":47647},[],"The identity is marked revoked.",{"_3170":789,"_27782":760,"_19244":47649,"_5":13232,"_26277":47558,"_2666":47650},[],"**Decommissioned**",{"_3170":790,"_27782":760,"_19244":47652,"_5":13232,"_26277":47558,"_2666":47653},[],"The record is retired and ordinary updates do not restore operation.",{"_3170":791,"_27782":760,"_19244":47655,"_5":13232,"_26277":47558,"_2666":47656},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3170":792,"_27782":760,"_19244":47658,"_5":13232,"_26277":47562,"_2666":47659},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3170":793,"_27782":760,"_19244":47661,"_5":13232,"_26277":47562,"_2666":47662},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3170":794,"_27782":760,"_19244":47664,"_5":13232,"_26277":47562,"_2666":47665},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3170":795,"_27782":760,"_19244":47667,"_5":13232,"_26277":47562,"_2666":47668},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3170":796,"_27782":760,"_19244":47670,"_5":13232,"_26277":47566,"_2666":47671},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3170":797,"_27782":760,"_19244":47673,"_5":13232,"_26277":47570,"_2666":47674},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3170":798,"_27782":760,"_19244":47676,"_5":13232,"_26277":47574,"_2666":47677},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3170":799,"_27782":760,"_19244":47679,"_5":13232,"_26277":47578,"_2666":47680},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3170":800,"_27782":760,"_19244":47682,"_5":13232,"_26277":47582,"_2666":47683},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3170":801,"_27782":760,"_19244":47685,"_5":13232,"_26277":47582,"_2666":47686},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3170":802,"_27782":760,"_19244":47688,"_5":13232,"_26277":47586,"_2666":47689},[],"From **No Identity**, use **Assign Identity**:",{"_3170":803,"_27782":760,"_19244":47691,"_5":13232,"_26277":47586,"_2666":47692},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3170":804,"_27782":760,"_19244":47694,"_5":13232,"_26277":47586,"_2666":47695},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3170":805,"_27782":760,"_19244":47697,"_5":13232,"_26277":47586,"_2666":47698},[],"Confirm and read the serial, active version and history again.",{"_3170":806,"_27782":760,"_19244":47700,"_5":13232,"_26277":47586,"_2666":47701},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3170":807,"_27782":760,"_19244":47703,"_5":13232,"_26277":47586,"_2666":47704},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3170":808,"_27782":760,"_19244":47706,"_5":13232,"_26277":47590,"_2666":47707},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3170":809,"_27782":760,"_19244":47709,"_5":13232,"_26277":47590,"_2666":47710},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3170":810,"_27782":760,"_19244":47712,"_5":13232,"_26277":47594,"_2666":47713},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3170":811,"_27782":760,"_19244":47715,"_5":13232,"_26277":47594,"_2666":47716},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3170":812,"_27782":760,"_19244":47718,"_5":13232,"_26277":47594,"_2666":47719},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3170":813,"_27782":760,"_19244":47721,"_5":13232,"_26277":47594,"_2666":47722},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3170":814,"_27782":760,"_19244":47724,"_5":13232,"_26277":47598,"_2666":47725},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3170":815,"_27782":760,"_19244":47727,"_5":13232,"_26277":47598,"_2666":47728},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3170":816,"_27782":816,"_5":13558,"_2666":47730,"_28124":47731,"_19244":47733,"_26277":816},"Bootstrap identity and authentication",[45194,46574,47551,47549,47732],"Enrollment with PKI",[],{"_3170":817,"_27782":816,"_19244":47735,"_5":13232,"_26277":816,"_2666":47736},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3170":818,"_27782":816,"_5":28121,"_19244":47738,"_26277":47739,"_2666":47740},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3170":819,"_27782":816,"_5":28121,"_19244":47742,"_26277":47743,"_2666":47744},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3170":820,"_27782":816,"_5":28121,"_19244":47746,"_26277":47747,"_2666":47748},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3170":821,"_27782":816,"_5":28121,"_19244":47750,"_26277":47751,"_2666":47752},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3170":822,"_27782":816,"_5":28121,"_19244":47754,"_26277":47755,"_2666":47756},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3170":823,"_27782":816,"_19244":47758,"_5":13232,"_26277":816,"_2666":47759},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3170":824,"_27782":816,"_19244":47761,"_5":13232,"_26277":47739,"_2666":47762},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3170":825,"_27782":816,"_19244":47764,"_5":13232,"_26277":47739,"_2666":47765},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3170":826,"_27782":816,"_19244":47767,"_5":13232,"_26277":47743,"_2666":47768},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3170":827,"_27782":816,"_19244":47770,"_5":13232,"_26277":47743,"_2666":47771},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3170":828,"_27782":816,"_19244":47773,"_5":13232,"_26277":47743,"_2666":47774},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3170":829,"_27782":816,"_19244":47776,"_5":13232,"_26277":47747,"_2666":47777},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3170":830,"_27782":816,"_19244":47779,"_5":13232,"_26277":47747,"_2666":47780},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3170":831,"_27782":816,"_19244":47782,"_5":13232,"_26277":47751,"_2666":47783},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3170":832,"_27782":816,"_19244":47785,"_5":13232,"_26277":47751,"_2666":47786},[],"Example body:",{"_3170":833,"_27782":816,"_19244":47788,"_5":13232,"_26277":47751,"_2666":47789},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3170":834,"_27782":816,"_19244":47791,"_5":13232,"_26277":47751,"_2666":47792},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3170":835,"_27782":816,"_19244":47794,"_5":13232,"_26277":47751,"_2666":47795},[],"Continuation requires a successful HTTP response and JSON:",{"_3170":836,"_27782":816,"_19244":47797,"_5":13232,"_26277":47751,"_2666":47798},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3170":837,"_27782":816,"_19244":47800,"_5":13232,"_26277":47755,"_2666":47801},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3170":838,"_27782":816,"_19244":47803,"_5":13232,"_26277":47755,"_2666":47804},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3170":839,"_27782":839,"_5":13558,"_2666":47806,"_28124":47807,"_19244":47808,"_26277":839},"Configure and operate the DMS",[45194,46574,47551,47549,47732],[],{"_3170":840,"_27782":839,"_19244":47810,"_5":13232,"_26277":839,"_2666":47811},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3170":841,"_27782":839,"_5":28121,"_19244":47813,"_26277":47814,"_2666":45204},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3170":842,"_27782":839,"_5":28121,"_19244":47816,"_26277":47817,"_2666":47818},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3170":843,"_27782":839,"_5":28121,"_19244":47820,"_26277":47821,"_2666":47822},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3170":844,"_27782":839,"_5":28121,"_19244":47824,"_26277":47825,"_2666":47826},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3170":845,"_27782":839,"_5":28121,"_19244":47828,"_26277":47829,"_2666":47830},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3170":846,"_27782":839,"_5":28121,"_19244":47832,"_26277":47833,"_2666":47834},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3170":847,"_27782":839,"_5":28121,"_19244":47836,"_26277":47837,"_2666":47838},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3170":848,"_27782":839,"_5":28121,"_19244":47840,"_26277":47841,"_2666":47842},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3170":849,"_27782":839,"_5":28121,"_19244":47844,"_26277":47845,"_2666":47846},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3170":850,"_27782":839,"_5":28121,"_19244":47848,"_26277":47849,"_2666":47850},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3170":851,"_27782":839,"_5":28121,"_19244":47852,"_26277":47853,"_2666":47854},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3170":852,"_27782":839,"_5":28121,"_19244":47856,"_26277":47857,"_2666":47858},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3170":853,"_27782":839,"_5":28121,"_19244":47860,"_26277":47861,"_2666":47862},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3170":854,"_27782":839,"_5":28121,"_19244":47864,"_26277":47865,"_2666":47866},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3170":855,"_27782":839,"_5":28121,"_19244":47868,"_26277":47869,"_2666":47870},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3170":856,"_27782":839,"_5":28121,"_19244":47872,"_26277":47873,"_2666":47874},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3170":857,"_27782":839,"_5":28121,"_19244":47876,"_26277":47877,"_2666":47878},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3170":858,"_27782":839,"_5":28121,"_19244":47880,"_26277":47881,"_2666":47882},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3170":859,"_27782":839,"_19244":47884,"_5":13232,"_26277":839,"_2666":47885},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3170":860,"_27782":839,"_19244":47887,"_5":13232,"_26277":47814,"_2666":47888},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3170":861,"_27782":839,"_19244":47890,"_5":13232,"_26277":47814,"_2666":47891},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3170":862,"_27782":839,"_19244":47893,"_5":13232,"_26277":47821,"_2666":47894},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3170":863,"_27782":839,"_19244":47896,"_5":13232,"_26277":47825,"_2666":47897},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3170":864,"_27782":839,"_19244":47899,"_5":13232,"_26277":47829,"_2666":47900},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3170":865,"_27782":839,"_19244":47902,"_5":13232,"_26277":47833,"_2666":47903},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3170":866,"_27782":839,"_19244":47905,"_5":13232,"_26277":47837,"_2666":47906},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3170":867,"_27782":839,"_19244":47908,"_5":13232,"_26277":47845,"_2666":47909},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3170":868,"_27782":839,"_19244":47911,"_5":13232,"_26277":47845,"_2666":47912},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3170":869,"_27782":839,"_19244":47914,"_5":13232,"_26277":47849,"_2666":47915},[],"`settings.enrollment_settings` field",{"_3170":870,"_27782":839,"_19244":47917,"_5":13232,"_26277":47849,"_2666":47918},[],"Decision",{"_3170":871,"_27782":839,"_19244":47920,"_5":13232,"_26277":47849,"_2666":47921},[],"`protocol`",{"_3170":872,"_27782":839,"_19244":47923,"_5":13232,"_26277":47849,"_2666":47924},[],"`EST_RFC7030` for these operations.",{"_3170":873,"_27782":839,"_19244":47926,"_5":13232,"_26277":47849,"_2666":47927},[],"`enrollment_ca`",{"_3170":874,"_27782":839,"_19244":47929,"_5":13232,"_26277":47849,"_2666":47930},[],"ID of the signing CA.",{"_3170":875,"_27782":839,"_19244":47932,"_5":13232,"_26277":47849,"_2666":47933},[],"`verify_csr_signature`",{"_3170":876,"_27782":839,"_19244":47935,"_5":13232,"_26277":47849,"_2666":47936},[],"Keep `true` to verify CSR key possession.",{"_3170":877,"_27782":839,"_19244":47938,"_5":13232,"_26277":47849,"_2666":47939},[],"`enable_replaceable_enrollment`",{"_3170":878,"_27782":839,"_19244":47941,"_5":13232,"_26277":47849,"_2666":47942},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3170":879,"_27782":839,"_19244":47944,"_5":13232,"_26277":47849,"_2666":47945},[],"`est_rfc7030_settings.auth_mode`",{"_3170":880,"_27782":839,"_19244":47947,"_5":13232,"_26277":47849,"_2666":47948},[],"One of the four authentication modes.",{"_3170":881,"_27782":839,"_19244":47950,"_5":13232,"_26277":47849,"_2666":47951},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3170":882,"_27782":839,"_19244":47953,"_5":13232,"_26277":47853,"_2666":47954},[],"The blocks are independent:",{"_3170":883,"_27782":839,"_19244":47956,"_5":13232,"_26277":47853,"_2666":47957},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3170":884,"_27782":839,"_19244":47959,"_5":13232,"_26277":47853,"_2666":47960},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3170":885,"_27782":839,"_19244":47962,"_5":13232,"_26277":47853,"_2666":47963},[],"`auth_mode`",{"_3170":886,"_27782":839,"_19244":47965,"_5":13232,"_26277":47853,"_2666":47966},[],"Control applied in the configured operation",{"_3170":887,"_27782":839,"_19244":47968,"_5":13232,"_26277":47853,"_2666":47969},[],"`CLIENT_CERTIFICATE`",{"_3170":888,"_27782":839,"_19244":47971,"_5":13232,"_26277":47853,"_2666":47972},[],"Presented certificate validation.",{"_3170":889,"_27782":839,"_19244":47974,"_5":13232,"_26277":47853,"_2666":47975},[],"`EXTERNAL_WEBHOOK`",{"_3170":890,"_27782":839,"_19244":47977,"_5":13232,"_26277":47853,"_2666":47978},[],"Configured webhook authorization.",{"_3170":891,"_27782":839,"_19244":47980,"_5":13232,"_26277":47853,"_2666":47981},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3170":892,"_27782":839,"_19244":47983,"_5":13232,"_26277":47853,"_2666":47984},[],"Certificate validation followed by webhook approval.",{"_3170":893,"_27782":839,"_19244":47986,"_5":13232,"_26277":47853,"_2666":47987},[],"`NO_AUTH`",{"_3170":894,"_27782":839,"_19244":47989,"_5":13232,"_26277":47853,"_2666":47990},[],"No DMS requester authentication.",{"_3170":895,"_27782":839,"_19244":47992,"_5":13232,"_26277":47853,"_2666":47993},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3170":896,"_27782":839,"_19244":47995,"_5":13232,"_26277":47853,"_2666":47996},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3170":897,"_27782":839,"_19244":47998,"_5":13232,"_26277":47853,"_2666":47999},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3170":898,"_27782":839,"_19244":48001,"_5":13232,"_26277":47853,"_2666":48002},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3170":899,"_27782":839,"_19244":48004,"_5":13232,"_26277":47857,"_2666":48005},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3170":900,"_27782":839,"_19244":48007,"_5":13232,"_26277":47857,"_2666":48008},[],"`external_webhook_settings` field",{"_3170":901,"_27782":839,"_19244":48010,"_5":13232,"_26277":47857,"_2666":47918},[],{"_3170":902,"_27782":839,"_19244":48012,"_5":13232,"_26277":47857,"_2666":48013},[],"`url`",{"_3170":903,"_27782":839,"_19244":48015,"_5":13232,"_26277":47857,"_2666":48016},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3170":904,"_27782":839,"_19244":48018,"_5":13232,"_26277":47857,"_2666":48019},[],"`method`",{"_3170":905,"_27782":839,"_19244":48021,"_5":13232,"_26277":47857,"_2666":48022},[],"`POST` or `PUT`; `POST` by default.",{"_3170":906,"_27782":839,"_19244":48024,"_5":13232,"_26277":47857,"_2666":48025},[],"`name`",{"_3170":907,"_27782":839,"_19244":48027,"_5":13232,"_26277":47857,"_2666":48028},[],"Label used in service logs.",{"_3170":908,"_27782":839,"_19244":48030,"_5":13232,"_26277":47857,"_2666":48031},[],"`config.auth_mode`",{"_3170":909,"_27782":839,"_19244":48033,"_5":13232,"_26277":47857,"_2666":48034},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3170":910,"_27782":839,"_19244":48036,"_5":13232,"_26277":47857,"_2666":48037},[],"`config.apikey_options`",{"_3170":911,"_27782":839,"_19244":48039,"_5":13232,"_26277":47857,"_2666":48040},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3170":912,"_27782":839,"_19244":48042,"_5":13232,"_26277":47857,"_2666":48043},[],"`config.jwt_options`",{"_3170":913,"_27782":839,"_19244":48045,"_5":13232,"_26277":47857,"_2666":48046},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3170":914,"_27782":839,"_19244":48048,"_5":13232,"_26277":47857,"_2666":48049},[],"`config.mtls_options`",{"_3170":915,"_27782":839,"_19244":48051,"_5":13232,"_26277":47857,"_2666":48052},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3170":916,"_27782":839,"_19244":48054,"_5":13232,"_26277":47857,"_2666":48055},[],"`config.insecure_skip_verify`",{"_3170":917,"_27782":839,"_19244":48057,"_5":13232,"_26277":47857,"_2666":48058},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3170":918,"_27782":839,"_19244":48060,"_5":13232,"_26277":47857,"_2666":48061},[],"`config.call_timeout`",{"_3170":919,"_27782":839,"_19244":48063,"_5":13232,"_26277":47857,"_2666":48064},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3170":920,"_27782":839,"_19244":48066,"_5":13232,"_26277":47857,"_2666":48067},[],"Rules for that configuration:",{"_3170":921,"_27782":839,"_19244":48069,"_5":13232,"_26277":47857,"_2666":48070},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3170":922,"_27782":839,"_19244":48072,"_5":13232,"_26277":47857,"_2666":48073},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3170":923,"_27782":839,"_19244":48075,"_5":13232,"_26277":47857,"_2666":48076},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3170":924,"_27782":839,"_19244":48078,"_5":13232,"_26277":47857,"_2666":48079},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3170":925,"_27782":839,"_19244":48081,"_5":13232,"_26277":47857,"_2666":48082},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3170":926,"_27782":839,"_19244":48084,"_5":13232,"_26277":47857,"_2666":48085},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3170":927,"_27782":839,"_19244":48087,"_5":13232,"_26277":47857,"_2666":48088},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing, and if your version's console does not expose independent settings, use the DMS API.",{"_3170":928,"_27782":839,"_19244":48090,"_5":13232,"_26277":47857,"_2666":48091},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3170":929,"_27782":839,"_19244":48093,"_5":13232,"_26277":47857,"_2666":48094},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3170":930,"_27782":839,"_19244":48096,"_5":13232,"_26277":47861,"_2666":48097},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3170":931,"_27782":839,"_19244":48099,"_5":13232,"_26277":47865,"_2666":48100},[],"`settings.reenrollment_settings` field",{"_3170":932,"_27782":839,"_19244":48102,"_5":13232,"_26277":47865,"_2666":45584},[],{"_3170":933,"_27782":839,"_19244":48104,"_5":13232,"_26277":47865,"_2666":48105},[],"`reenrollment_delta`",{"_3170":934,"_27782":839,"_19244":48107,"_5":13232,"_26277":47865,"_2666":48108},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3170":935,"_27782":839,"_19244":48110,"_5":13232,"_26277":47865,"_2666":48111},[],"`preventive_delta`",{"_3170":936,"_27782":839,"_19244":48113,"_5":13232,"_26277":47865,"_2666":48114},[],"Preventive operational monitoring threshold.",{"_3170":937,"_27782":839,"_19244":48116,"_5":13232,"_26277":47865,"_2666":48117},[],"`critical_delta`",{"_3170":938,"_27782":839,"_19244":48119,"_5":13232,"_26277":47865,"_2666":48120},[],"Critical operational monitoring threshold.",{"_3170":939,"_27782":839,"_19244":48122,"_5":13232,"_26277":47865,"_2666":48123},[],"`enable_expired_renewal`",{"_3170":940,"_27782":839,"_19244":48125,"_5":13232,"_26277":47865,"_2666":48126},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3170":941,"_27782":839,"_19244":48128,"_5":13232,"_26277":47865,"_2666":48129},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3170":942,"_27782":839,"_19244":48131,"_5":13232,"_26277":47865,"_2666":48132},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3170":943,"_27782":839,"_19244":48134,"_5":13232,"_26277":47865,"_2666":48135},[],"`revoke_on_reenrollment`",{"_3170":944,"_27782":839,"_19244":48137,"_5":13232,"_26277":47865,"_2666":48138},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3170":945,"_27782":839,"_19244":48140,"_5":13232,"_26277":47865,"_2666":48141},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3170":946,"_27782":839,"_19244":48143,"_5":13232,"_26277":47869,"_2666":48144},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3170":947,"_27782":839,"_19244":48146,"_5":13232,"_26277":47873,"_2666":45578},[],{"_3170":948,"_27782":839,"_19244":48148,"_5":13232,"_26277":47873,"_2666":48149},[],"Published material",{"_3170":949,"_27782":839,"_19244":48151,"_5":13232,"_26277":47873,"_2666":48152},[],"**Include Lamassu System CA**",{"_3170":950,"_27782":839,"_19244":48154,"_5":13232,"_26277":47873,"_2666":48155},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3170":951,"_27782":839,"_19244":48157,"_5":13232,"_26277":47873,"_2666":48158},[],"**Include Enrollment CA**",{"_3170":952,"_27782":839,"_19244":48160,"_5":13232,"_26277":47873,"_2666":48161},[],"Selected issuing CA certificate.",{"_3170":953,"_27782":839,"_19244":48163,"_5":13232,"_26277":47873,"_2666":48164},[],"**Managed CAs**",{"_3170":954,"_27782":839,"_19244":48166,"_5":13232,"_26277":47873,"_2666":48167},[],"Explicitly selected CA certificates.",{"_3170":955,"_27782":839,"_19244":48169,"_5":13232,"_26277":47873,"_2666":48170},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3170":956,"_27782":839,"_19244":48172,"_5":13232,"_26277":47877,"_2666":48173},[],"**Edit** changes name, settings and metadata. Backend updates replace these complete blocks; read the DMS before sending API edits to avoid losing fields.",{"_3170":957,"_27782":839,"_19244":48175,"_5":13232,"_26277":47877,"_2666":48176},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3170":958,"_27782":839,"_19244":48178,"_5":13232,"_26277":47877,"_2666":48179},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3170":959,"_27782":839,"_19244":48181,"_5":13232,"_26277":47881,"_2666":48182},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3170":960,"_27782":960,"_5":13558,"_2666":48184,"_28124":48185,"_19244":48186,"_26277":960},"Integrate the EST client",[45194,46574,47551,47549,47732],[],{"_3170":961,"_27782":960,"_19244":48188,"_5":13232,"_26277":960,"_2666":48189},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3170":962,"_27782":960,"_5":28121,"_19244":48191,"_26277":48192,"_2666":45204},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3170":963,"_27782":960,"_5":28121,"_19244":48194,"_26277":48195,"_2666":48196},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3170":964,"_27782":960,"_5":28121,"_19244":48198,"_26277":48199,"_2666":48200},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3170":965,"_27782":960,"_5":28121,"_19244":48202,"_26277":48203,"_2666":48204},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3170":966,"_27782":960,"_5":28121,"_19244":48206,"_26277":48207,"_2666":48208},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3170":967,"_27782":960,"_5":28121,"_19244":48210,"_26277":48211,"_2666":48212},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3170":968,"_27782":960,"_19244":48214,"_5":13232,"_26277":960,"_2666":48215},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3170":969,"_27782":960,"_19244":48217,"_5":13232,"_26277":48192,"_2666":48218},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3170":970,"_27782":960,"_19244":48220,"_5":13232,"_26277":48192,"_2666":48221},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3170":971,"_27782":960,"_19244":48223,"_5":13232,"_26277":48192,"_2666":48224},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3170":972,"_27782":960,"_19244":48226,"_5":13232,"_26277":48195,"_2666":48227},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3170":973,"_27782":960,"_19244":48229,"_5":13232,"_26277":48195,"_2666":48230},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3170":974,"_27782":960,"_19244":48232,"_5":13232,"_26277":48199,"_2666":48233},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3170":975,"_27782":960,"_19244":48235,"_5":13232,"_26277":48199,"_2666":48236},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3170":976,"_27782":960,"_19244":48238,"_5":13232,"_26277":48203,"_2666":48239},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3170":977,"_27782":960,"_19244":48241,"_5":13232,"_26277":48203,"_2666":48242},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3170":978,"_27782":960,"_19244":48244,"_5":13232,"_26277":48207,"_2666":48245},[],"For a root that issues directly:",{"_3170":979,"_27782":960,"_19244":48247,"_5":13232,"_26277":48207,"_2666":48248},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3170":980,"_27782":960,"_19244":48250,"_5":13232,"_26277":48207,"_2666":48251},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3170":981,"_27782":960,"_19244":48253,"_5":13232,"_26277":48211,"_2666":48254},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3170":982,"_27782":982,"_5":13558,"_2666":48256,"_28124":48257,"_19244":48258,"_26277":982},"EST reference",[45194,46574,47551,47549,47732],[],{"_3170":983,"_27782":982,"_19244":48260,"_5":13232,"_26277":982,"_2666":48261},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3170":984,"_27782":982,"_5":28121,"_19244":48263,"_26277":48264,"_2666":48265},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3170":985,"_27782":982,"_5":28121,"_19244":48267,"_26277":48268,"_2666":20880},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3170":986,"_27782":982,"_5":28121,"_19244":48270,"_26277":48271,"_2666":24010},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3170":987,"_27782":982,"_5":28121,"_19244":48273,"_26277":48274,"_2666":24017},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3170":988,"_27782":982,"_5":28121,"_19244":48276,"_26277":48277,"_2666":23345},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3170":989,"_27782":982,"_5":28121,"_19244":48279,"_26277":48280,"_2666":48281},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3170":990,"_27782":982,"_5":28121,"_19244":48283,"_26277":48284,"_2666":48285},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3170":991,"_27782":982,"_5":28121,"_19244":48287,"_26277":48288,"_2666":48289},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3170":992,"_27782":982,"_19244":48291,"_5":13232,"_26277":982,"_2666":48292},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3170":993,"_27782":982,"_19244":48294,"_5":13232,"_26277":48264,"_2666":48295},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3170":994,"_27782":982,"_19244":48297,"_5":13232,"_26277":48264,"_2666":48298},[],"Operation",{"_3170":995,"_27782":982,"_19244":48300,"_5":13232,"_26277":48264,"_2666":48301},[],"Method",{"_3170":996,"_27782":982,"_19244":48303,"_5":13232,"_26277":48264,"_2666":48304},[],"Authentication and condition",{"_3170":997,"_27782":982,"_19244":48306,"_5":13232,"_26277":48264,"_2666":48307},[],"`/cacerts`",{"_3170":998,"_27782":982,"_19244":48309,"_5":13232,"_26277":48264,"_2666":48310},[],"GET",{"_3170":999,"_27782":982,"_19244":48312,"_5":13232,"_26277":48264,"_2666":48313},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3170":1000,"_27782":982,"_19244":48315,"_5":13232,"_26277":48264,"_2666":48316},[],"`/simpleenroll`",{"_3170":1001,"_27782":982,"_19244":48318,"_5":13232,"_26277":48264,"_2666":48319},[],"POST",{"_3170":1002,"_27782":982,"_19244":48321,"_5":13232,"_26277":48264,"_2666":48322},[],"Initial authentication and DMS registration/replacement policy.",{"_3170":1003,"_27782":982,"_19244":48324,"_5":13232,"_26277":48264,"_2666":48325},[],"`/simplereenroll`",{"_3170":1004,"_27782":982,"_19244":48327,"_5":13232,"_26277":48264,"_2666":48319},[],{"_3170":1005,"_27782":982,"_19244":48329,"_5":13232,"_26277":48264,"_2666":48330},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3170":1006,"_27782":982,"_19244":48332,"_5":13232,"_26277":48264,"_2666":48333},[],"`/serverkeygen`",{"_3170":1007,"_27782":982,"_19244":48335,"_5":13232,"_26277":48264,"_2666":48319},[],{"_3170":1008,"_27782":982,"_19244":48337,"_5":13232,"_26277":48264,"_2666":48338},[],"Initial authentication and admission; server generation enabled.",{"_3170":1009,"_27782":982,"_19244":48340,"_5":13232,"_26277":48264,"_2666":48341},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3170":1010,"_27782":982,"_19244":48343,"_5":13232,"_26277":48268,"_2666":48344},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3170":1011,"_27782":982,"_19244":48346,"_5":13232,"_26277":48268,"_2666":48347},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3170":1012,"_27782":982,"_19244":48349,"_5":13232,"_26277":48271,"_2666":48350},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3170":1013,"_27782":982,"_19244":48352,"_5":13232,"_26277":48271,"_2666":48353},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3170":1014,"_27782":982,"_19244":48355,"_5":13232,"_26277":48274,"_2666":48356},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3170":1015,"_27782":982,"_19244":48358,"_5":13232,"_26277":48274,"_2666":48359},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3170":1016,"_27782":982,"_19244":48361,"_5":13232,"_26277":48277,"_2666":48362},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3170":1017,"_27782":982,"_19244":48364,"_5":13232,"_26277":48277,"_2666":48365},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3170":1018,"_27782":982,"_19244":48367,"_5":13232,"_26277":48280,"_2666":48368},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3170":1019,"_27782":982,"_19244":48370,"_5":13232,"_26277":48280,"_2666":48371},[],"Part",{"_3170":1020,"_27782":982,"_19244":48373,"_5":13232,"_26277":48280,"_2666":48374},[],"Content after decoding its Base64",{"_3170":1021,"_27782":982,"_19244":48376,"_5":13232,"_26277":48280,"_2666":48377},[],"`application/pkcs8`",{"_3170":1022,"_27782":982,"_19244":48379,"_5":13232,"_26277":48280,"_2666":48380},[],"Unencrypted DER PKCS#8 private key.",{"_3170":1023,"_27782":982,"_19244":48382,"_5":13232,"_26277":48280,"_2666":48383},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3170":1024,"_27782":982,"_19244":48385,"_5":13232,"_26277":48280,"_2666":48386},[],"DER PKCS#7 containing the issued certificate.",{"_3170":1025,"_27782":982,"_19244":48388,"_5":13232,"_26277":48280,"_2666":48389},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3170":1026,"_27782":982,"_19244":48391,"_5":13232,"_26277":48284,"_2666":48392},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3170":1027,"_27782":982,"_19244":48394,"_5":13232,"_26277":48284,"_2666":48395},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3170":1028,"_27782":982,"_19244":48397,"_5":13232,"_26277":48284,"_2666":48398},[],"Convert and check the result:",{"_3170":1029,"_27782":982,"_19244":48400,"_5":13232,"_26277":48284,"_2666":48401},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3170":1030,"_27782":982,"_19244":48403,"_5":13232,"_26277":48288,"_2666":48404},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3170":1031,"_27782":982,"_19244":48406,"_5":13232,"_26277":48288,"_2666":48407},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3170":1032,"_27782":1032,"_5":13558,"_2666":47732,"_28124":48409,"_19244":48410,"_26277":1032},[45194,46574,47551,47549,47732],[],{"_3170":1033,"_27782":1032,"_19244":48412,"_5":13232,"_26277":1032,"_2666":48413},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3170":1034,"_27782":1032,"_5":28121,"_19244":48415,"_26277":48416,"_2666":48417},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3170":1035,"_27782":1032,"_5":28121,"_19244":48419,"_26277":48420,"_2666":48421},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3170":1036,"_27782":1032,"_5":28121,"_19244":48423,"_26277":48424,"_2666":48425},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3170":1037,"_27782":1032,"_5":28121,"_19244":48427,"_26277":48428,"_2666":48429},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3170":1038,"_27782":1032,"_19244":48431,"_5":13232,"_26277":1032,"_2666":48432},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3170":1039,"_27782":1032,"_19244":48434,"_5":13232,"_26277":48416,"_2666":48435},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3170":1040,"_27782":1032,"_19244":48437,"_5":13232,"_26277":48416,"_2666":48438},[],"The integrator installs initial EST server trust and an admission credential.",{"_3170":1041,"_27782":1032,"_19244":48440,"_5":13232,"_26277":48416,"_2666":48441},[],"The client requests an identity for its `Device ID` through EST.",{"_3170":1042,"_27782":1032,"_19244":48443,"_5":13232,"_26277":48416,"_2666":48444},[],"Certificate, device binding and key/certificate installation are checked.",{"_3170":1043,"_27782":1032,"_19244":48446,"_5":13232,"_26277":48416,"_2666":48447},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3170":1044,"_27782":1032,"_19244":48449,"_5":13232,"_26277":48416,"_2666":48450},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3170":1045,"_27782":1032,"_19244":48452,"_5":13232,"_26277":48420,"_2666":48453},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3170":1046,"_27782":1032,"_19244":48455,"_5":13232,"_26277":48420,"_2666":48456},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3170":1047,"_27782":1032,"_19244":48458,"_5":13232,"_26277":48420,"_2666":48459},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3170":1048,"_27782":1032,"_19244":48461,"_5":13232,"_26277":48420,"_2666":48462},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3170":1049,"_27782":1032,"_19244":48464,"_5":13232,"_26277":48424,"_2666":48465},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3170":1050,"_27782":1032,"_19244":48467,"_5":13232,"_26277":48424,"_2666":48468},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3170":1051,"_27782":1032,"_19244":48470,"_5":13232,"_26277":48424,"_2666":48471},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3170":1052,"_27782":1032,"_19244":48473,"_5":13232,"_26277":48424,"_2666":48474},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3170":1053,"_27782":1032,"_19244":48476,"_5":13232,"_26277":48428,"_2666":48477},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3170":1054,"_27782":1032,"_19244":48479,"_5":13232,"_26277":48428,"_2666":48480},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3170":1055,"_27782":1055,"_5":13558,"_2666":48482,"_28124":48483,"_19244":48484,"_26277":1055},"Provisioning strategies",[45194,46574,47551,47549,47732],[],{"_3170":1056,"_27782":1055,"_19244":48486,"_5":13232,"_26277":1055,"_2666":48487},[],"Choose device registration, identity authorization and key generation.",{"_3170":1057,"_27782":1055,"_5":28121,"_19244":48489,"_26277":48490,"_2666":48491},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3170":1058,"_27782":1055,"_5":28121,"_19244":48493,"_26277":48494,"_2666":48495},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3170":1059,"_27782":1055,"_5":28121,"_19244":48497,"_26277":48498,"_2666":48499},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3170":1060,"_27782":1055,"_5":28121,"_19244":48501,"_26277":48502,"_2666":48503},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3170":1061,"_27782":1055,"_5":28121,"_19244":48505,"_26277":48506,"_2666":48507},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3170":1062,"_27782":1055,"_19244":48509,"_5":13232,"_26277":1055,"_2666":48510},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3170":1063,"_27782":1055,"_19244":48512,"_5":13232,"_26277":48490,"_2666":48513},[],"Path",{"_3170":1064,"_27782":1055,"_19244":48515,"_5":13232,"_26277":48490,"_2666":48516},[],"When the device exists",{"_3170":1065,"_27782":1055,"_19244":48518,"_5":13232,"_26277":48490,"_2666":48519},[],"What to check",{"_3170":1066,"_27782":1055,"_19244":48521,"_5":13232,"_26277":48490,"_2666":48522},[],"Manual assignment",{"_3170":1067,"_27782":1055,"_19244":48524,"_5":13232,"_26277":48490,"_2666":48525},[],"An operator creates it before associating a certificate.",{"_3170":1068,"_27782":1055,"_19244":48527,"_5":13232,"_26277":48490,"_2666":48528},[],"ID, owning DMS, certificate CN and bound serial.",{"_3170":1069,"_27782":1055,"_19244":48530,"_5":13232,"_26277":48490,"_2666":48531},[],"EST with `JITP`",{"_3170":1070,"_27782":1055,"_19244":48533,"_5":13232,"_26277":48490,"_2666":48534},[],"Created for an unknown CN during `/simpleenroll`.",{"_3170":1071,"_27782":1055,"_19244":48536,"_5":13232,"_26277":48490,"_2666":48537},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3170":1072,"_27782":1055,"_19244":48539,"_5":13232,"_26277":48490,"_2666":48540},[],"EST with `PRE_REGISTRATION`",{"_3170":1073,"_27782":1055,"_19244":48542,"_5":13232,"_26277":48490,"_2666":48543},[],"Must exist before `/simpleenroll`.",{"_3170":1074,"_27782":1055,"_19244":48545,"_5":13232,"_26277":48490,"_2666":48546},[],"Approved record, same DMS and replacement conditions for your version.",{"_3170":1075,"_27782":1055,"_19244":48548,"_5":13232,"_26277":48490,"_2666":48549},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3170":1076,"_27782":1055,"_19244":48551,"_5":13232,"_26277":48490,"_2666":48552},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3170":1077,"_27782":1055,"_19244":48554,"_5":13232,"_26277":48494,"_2666":48555},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3170":1078,"_27782":1055,"_19244":48557,"_5":13232,"_26277":48494,"_2666":48558},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3170":1079,"_27782":1055,"_19244":48560,"_5":13232,"_26277":48494,"_2666":48561},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3170":1080,"_27782":1055,"_19244":48563,"_5":13232,"_26277":48498,"_2666":48564},[],"Decide initial enrollment and re-enrollment separately:",{"_3170":1081,"_27782":1055,"_19244":48566,"_5":13232,"_26277":48498,"_2666":48567},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3170":1082,"_27782":1055,"_19244":48569,"_5":13232,"_26277":48498,"_2666":48570},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3170":1083,"_27782":1055,"_19244":48572,"_5":13232,"_26277":48498,"_2666":48573},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3170":1084,"_27782":1055,"_19244":48575,"_5":13232,"_26277":48498,"_2666":48576},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3170":1085,"_27782":1055,"_19244":48578,"_5":13232,"_26277":48498,"_2666":48579},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3170":1086,"_27782":1055,"_19244":48581,"_5":13232,"_26277":48502,"_2666":45578},[],{"_3170":1087,"_27782":1055,"_19244":48583,"_5":13232,"_26277":48502,"_2666":48584},[],"Material crossing EST",{"_3170":1088,"_27782":1055,"_19244":48586,"_5":13232,"_26277":48502,"_2666":48587},[],"Device-generated key",{"_3170":1089,"_27782":1055,"_19244":48589,"_5":13232,"_26277":48502,"_2666":48590},[],"Public CSR and certificate; the key stays on the client.",{"_3170":1090,"_27782":1055,"_19244":48592,"_5":13232,"_26277":48502,"_2666":48593},[],"Existing device key",{"_3170":1091,"_27782":1055,"_19244":48595,"_5":13232,"_26277":48502,"_2666":48596},[],"CSR signed with that key and a new certificate.",{"_3170":1092,"_27782":1055,"_19244":48598,"_5":13232,"_26277":48502,"_2666":47870},[],{"_3170":1093,"_27782":1055,"_19244":48600,"_5":13232,"_26277":48502,"_2666":48601},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3170":1094,"_27782":1055,"_19244":48603,"_5":13232,"_26277":48502,"_2666":48604},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3170":1095,"_27782":1055,"_19244":48606,"_5":13232,"_26277":48506,"_2666":48607},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3170":1096,"_27782":1096,"_5":13558,"_2666":48609,"_28124":48610,"_19244":48611,"_26277":1096},"Renewal and recovery",[45194,46574,47551,47549,47732],[],{"_3170":1097,"_27782":1096,"_19244":48613,"_5":13232,"_26277":1096,"_2666":48614},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3170":1098,"_27782":1096,"_5":28121,"_19244":48616,"_26277":48617,"_2666":48618},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3170":1099,"_27782":1096,"_5":28121,"_19244":48620,"_26277":48621,"_2666":48622},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3170":1100,"_27782":1096,"_5":28121,"_19244":48624,"_26277":48625,"_2666":48626},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3170":1101,"_27782":1096,"_5":28121,"_19244":48628,"_26277":48629,"_2666":48630},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3170":1102,"_27782":1096,"_5":28121,"_19244":48632,"_26277":48633,"_2666":48634},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3170":1103,"_27782":1096,"_19244":48636,"_5":13232,"_26277":1096,"_2666":48637},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3170":1104,"_27782":1096,"_19244":48639,"_5":13232,"_26277":48617,"_2666":48640},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3170":1105,"_27782":1096,"_19244":48642,"_5":13232,"_26277":48617,"_2666":48643},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3170":1106,"_27782":1096,"_19244":48645,"_5":13232,"_26277":48617,"_2666":48646},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3170":1107,"_27782":1096,"_19244":48648,"_5":13232,"_26277":48617,"_2666":48649},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3170":1108,"_27782":1096,"_19244":48651,"_5":13232,"_26277":48621,"_2666":48652},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3170":1109,"_27782":1096,"_19244":48654,"_5":13232,"_26277":48621,"_2666":48655},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3170":1110,"_27782":1096,"_19244":48657,"_5":13232,"_26277":48625,"_2666":48658},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3170":1111,"_27782":1096,"_19244":48660,"_5":13232,"_26277":48625,"_2666":48661},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3170":1112,"_27782":1096,"_19244":48663,"_5":13232,"_26277":48625,"_2666":48664},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3170":1113,"_27782":1096,"_19244":48666,"_5":13232,"_26277":48629,"_2666":48667},[],"Situation",{"_3170":1114,"_27782":1096,"_19244":48669,"_5":13232,"_26277":48629,"_2666":48670},[],"Procedure",{"_3170":1115,"_27782":1096,"_19244":48672,"_5":13232,"_26277":48629,"_2666":48673},[],"Valid certificate, outside the window",{"_3170":1116,"_27782":1096,"_19244":48675,"_5":13232,"_26277":48629,"_2666":48676},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3170":1117,"_27782":1096,"_19244":48678,"_5":13232,"_26277":48629,"_2666":48679},[],"Expired certificate, key available",{"_3170":1118,"_27782":1096,"_19244":48681,"_5":13232,"_26277":48629,"_2666":48682},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3170":1119,"_27782":1096,"_19244":48684,"_5":13232,"_26277":48629,"_2666":48685},[],"Renewal through webhook or `NO_AUTH`",{"_3170":1120,"_27782":1096,"_19244":48687,"_5":13232,"_26277":48629,"_2666":48688},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3170":1121,"_27782":1096,"_19244":48690,"_5":13232,"_26277":48629,"_2666":48691},[],"Lost or inaccessible key",{"_3170":1122,"_27782":1096,"_19244":48693,"_5":13232,"_26277":48629,"_2666":48694},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3170":1123,"_27782":1096,"_19244":48696,"_5":13232,"_26277":48629,"_2666":48697},[],"Current identity revoked",{"_3170":1124,"_27782":1096,"_19244":48699,"_5":13232,"_26277":48629,"_2666":48700},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3170":1125,"_27782":1096,"_19244":48702,"_5":13232,"_26277":48629,"_2666":48703},[],"Device without an identity",{"_3170":1126,"_27782":1096,"_19244":48705,"_5":13232,"_26277":48629,"_2666":48706},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3170":1127,"_27782":1096,"_19244":48708,"_5":13232,"_26277":48629,"_2666":48709},[],"Retired device",{"_3170":1128,"_27782":1096,"_19244":48711,"_5":13232,"_26277":48629,"_2666":48712},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3170":1129,"_27782":1096,"_19244":48714,"_5":13232,"_26277":48629,"_2666":48715},[],"Timeout, HTTP 500 or installation failure",{"_3170":1130,"_27782":1096,"_19244":48717,"_5":13232,"_26277":48629,"_2666":48718},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3170":1131,"_27782":1096,"_19244":48720,"_5":13232,"_26277":48633,"_2666":48721},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3170":1132,"_27782":1096,"_19244":48723,"_5":13232,"_26277":48633,"_2666":48724},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3170":1133,"_27782":1133,"_5":13558,"_2666":48726,"_28124":48727,"_19244":48728,"_26277":1133},"Enrollment troubleshooting",[45194,46574,47551,47549,47732],[],{"_3170":1134,"_27782":1133,"_19244":48730,"_5":13232,"_26277":1133,"_2666":48731},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3170":1135,"_27782":1133,"_5":28121,"_19244":48733,"_26277":48734,"_2666":48735},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3170":1136,"_27782":1133,"_5":28121,"_19244":48737,"_26277":48738,"_2666":48739},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3170":1137,"_27782":1133,"_5":28121,"_19244":48741,"_26277":48742,"_2666":48289},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3170":1138,"_27782":1133,"_5":28121,"_19244":48744,"_26277":48745,"_2666":48746},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3170":1139,"_27782":1133,"_19244":48748,"_5":13232,"_26277":1133,"_2666":48749},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3170":1140,"_27782":1133,"_19244":48751,"_5":13232,"_26277":48738,"_2666":48752},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3170":1141,"_27782":1133,"_19244":48754,"_5":13232,"_26277":48738,"_2666":48755},[],"Symptom or message",{"_3170":1142,"_27782":1133,"_19244":48757,"_5":13232,"_26277":48738,"_2666":48519},[],{"_3170":1143,"_27782":1133,"_19244":48759,"_5":13232,"_26277":48738,"_2666":48760},[],"curl rejects TLS, name or issuer",{"_3170":1144,"_27782":1133,"_19244":48762,"_5":13232,"_26277":48738,"_2666":48763},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3170":1145,"_27782":1133,"_19244":48765,"_5":13232,"_26277":48738,"_2666":48766},[],"404 or missing APS",{"_3170":1146,"_27782":1133,"_19244":48768,"_5":13232,"_26277":48738,"_2666":48769},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3170":1147,"_27782":1133,"_19244":48771,"_5":13232,"_26277":48738,"_2666":48772},[],"400, CSR or format error",{"_3170":1148,"_27782":1133,"_19244":48774,"_5":13232,"_26277":48738,"_2666":48775},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3170":1149,"_27782":1133,"_19244":48777,"_5":13232,"_26277":48738,"_2666":48778},[],"Missing credential or invalid certificate",{"_3170":1150,"_27782":1133,"_19244":48780,"_5":13232,"_26277":48738,"_2666":48781},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3170":1151,"_27782":1133,"_19244":48783,"_5":13232,"_26277":48738,"_2666":48784},[],"Webhook denies, times out or responds without authorization",{"_3170":1152,"_27782":1133,"_19244":48786,"_5":13232,"_26277":48738,"_2666":48787},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3170":1153,"_27782":1133,"_19244":48789,"_5":13232,"_26277":48738,"_2666":48790},[],"`unexpected status code: <n>: redirects are not followed`",{"_3170":1154,"_27782":1133,"_19244":48792,"_5":13232,"_26277":48738,"_2666":48793},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3170":1155,"_27782":1133,"_19244":48795,"_5":13232,"_26277":48738,"_2666":48796},[],"`webhook response exceeds 1048576 bytes`",{"_3170":1156,"_27782":1133,"_19244":48798,"_5":13232,"_26277":48738,"_2666":48799},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3170":1157,"_27782":1133,"_19244":48801,"_5":13232,"_26277":48738,"_2666":48802},[],"`webhook config must not reference files`",{"_3170":1158,"_27782":1133,"_19244":48804,"_5":13232,"_26277":48738,"_2666":48805},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3170":1159,"_27782":1133,"_19244":48807,"_5":13232,"_26277":48738,"_2666":48808},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3170":1160,"_27782":1133,"_19244":48810,"_5":13232,"_26277":48738,"_2666":48811},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3170":1161,"_27782":1133,"_19244":48813,"_5":13232,"_26277":48738,"_2666":48814},[],"`webhook mTLS certificate and key are invalid: …`",{"_3170":1162,"_27782":1133,"_19244":48816,"_5":13232,"_26277":48738,"_2666":48817},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3170":1163,"_27782":1133,"_19244":48819,"_5":13232,"_26277":48738,"_2666":48820},[],"400 `struct validation error` creating or updating a DMS",{"_3170":1164,"_27782":1133,"_19244":48822,"_5":13232,"_26277":48738,"_2666":48823},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3170":1165,"_27782":1133,"_19244":48825,"_5":13232,"_26277":48738,"_2666":48826},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3170":1166,"_27782":1133,"_19244":48828,"_5":13232,"_26277":48738,"_2666":48829},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3170":1167,"_27782":1133,"_19244":48831,"_5":13232,"_26277":48738,"_2666":48832},[],"`device not preregistered`",{"_3170":1168,"_27782":1133,"_19244":48834,"_5":13232,"_26277":48738,"_2666":48835},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3170":1169,"_27782":1133,"_19244":48837,"_5":13232,"_26277":48738,"_2666":48838},[],"`forbiddenNewEnrollment`",{"_3170":1170,"_27782":1133,"_19244":48840,"_5":13232,"_26277":48738,"_2666":48841},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3170":1171,"_27782":1133,"_19244":48843,"_5":13232,"_26277":48738,"_2666":48844},[],"Different owning DMS",{"_3170":1172,"_27782":1133,"_19244":48846,"_5":13232,"_26277":48738,"_2666":48847},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3170":1173,"_27782":1133,"_19244":48849,"_5":13232,"_26277":48738,"_2666":48850},[],"`invalid RawSubject bytes`",{"_3170":1174,"_27782":1133,"_19244":48852,"_5":13232,"_26277":48738,"_2666":48853},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3170":1175,"_27782":1133,"_19244":48855,"_5":13232,"_26277":48738,"_2666":48856},[],"`invalid reenroll window`",{"_3170":1176,"_27782":1133,"_19244":48858,"_5":13232,"_26277":48738,"_2666":48859},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3170":1177,"_27782":1133,"_19244":48861,"_5":13232,"_26277":48738,"_2666":48862},[],"Current certificate revoked",{"_3170":1178,"_27782":1133,"_19244":48864,"_5":13232,"_26277":48738,"_2666":48865},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3170":1179,"_27782":1133,"_19244":48867,"_5":13232,"_26277":48738,"_2666":48868},[],"CA, profile or signing error",{"_3170":1180,"_27782":1133,"_19244":48870,"_5":13232,"_26277":48738,"_2666":48871},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3170":1181,"_27782":1133,"_19244":48873,"_5":13232,"_26277":48738,"_2666":48874},[],"HTTP 200 without a device connection",{"_3170":1182,"_27782":1133,"_19244":48876,"_5":13232,"_26277":48738,"_2666":48877},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3170":1183,"_27782":1133,"_19244":48879,"_5":13232,"_26277":48738,"_2666":48880},[],"Timeout or error after issuance",{"_3170":1184,"_27782":1133,"_19244":48882,"_5":13232,"_26277":48738,"_2666":48883},[],"New certificates, current slot and previous identity's state before retrying.",{"_3170":1185,"_27782":1133,"_19244":48885,"_5":13232,"_26277":48742,"_2666":48886},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3170":1186,"_27782":1133,"_19244":48888,"_5":13232,"_26277":48742,"_2666":48889},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3170":1187,"_27782":1133,"_19244":48891,"_5":13232,"_26277":48745,"_2666":48892},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3170":1188,"_27782":1133,"_19244":48894,"_5":13232,"_26277":48745,"_2666":48895},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3170":1189,"_27782":1133,"_19244":48897,"_5":13232,"_26277":48745,"_2666":48898},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3170":1190,"_27782":1133,"_19244":48900,"_5":13232,"_26277":48745,"_2666":48901},[],"Make one request, save headers/body and query the device and certificates.",{"_3170":1191,"_27782":1133,"_19244":48903,"_5":13232,"_26277":48745,"_2666":48904},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3170":1192,"_27782":1133,"_19244":48906,"_5":13232,"_26277":48745,"_2666":48907},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3170":1193,"_27782":1133,"_19244":48909,"_5":13232,"_26277":48745,"_2666":48910},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3170":1194,"_27782":1194,"_5":13558,"_2666":48912,"_28124":48913,"_19244":48914,"_26277":1194},"Trust distribution and updates",[45194,46574,47551,47549,47732],[],{"_3170":1195,"_27782":1194,"_19244":48916,"_5":13232,"_26277":1194,"_2666":48917},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3170":1196,"_27782":1194,"_5":28121,"_19244":48919,"_26277":48920,"_2666":48921},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3170":1197,"_27782":1194,"_5":28121,"_19244":48923,"_26277":48924,"_2666":48925},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3170":1198,"_27782":1194,"_5":28121,"_19244":48927,"_26277":48928,"_2666":48929},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3170":1199,"_27782":1194,"_5":28121,"_19244":48931,"_26277":48932,"_2666":48933},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3170":1200,"_27782":1194,"_5":28121,"_19244":48935,"_26277":48936,"_2666":48937},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3170":1201,"_27782":1194,"_19244":48939,"_5":13232,"_26277":1194,"_2666":48940},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3170":1202,"_27782":1194,"_19244":48942,"_5":13232,"_26277":48920,"_2666":48943},[],"Relationship",{"_3170":1203,"_27782":1194,"_19244":48945,"_5":13232,"_26277":48920,"_2666":48946},[],"Material prepared by its owner",{"_3170":1204,"_27782":1194,"_19244":48948,"_5":13232,"_26277":48920,"_2666":48949},[],"Device → EST server",{"_3170":1205,"_27782":1194,"_19244":48951,"_5":13232,"_26277":48920,"_2666":48952},[],"Previously verified server root, chain or pin and TLS name.",{"_3170":1206,"_27782":1194,"_19244":48954,"_5":13232,"_26277":48920,"_2666":48955},[],"DMS → requester",{"_3170":1207,"_27782":1194,"_19244":48957,"_5":13232,"_26277":48920,"_2666":48958},[],"CAs and rules authorizing initial or renewal credentials.",{"_3170":1208,"_27782":1194,"_19244":48960,"_5":13232,"_26277":48920,"_2666":48961},[],"Consumer → device",{"_3170":1209,"_27782":1194,"_19244":48963,"_5":13232,"_26277":48920,"_2666":48964},[],"Operational identity roots, intermediates, validation and permissions.",{"_3170":1210,"_27782":1194,"_19244":48966,"_5":13232,"_26277":48920,"_2666":48967},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3170":1211,"_27782":1194,"_19244":48969,"_5":13232,"_26277":48924,"_2666":48970},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3170":1212,"_27782":1194,"_19244":48972,"_5":13232,"_26277":48924,"_2666":48973},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3170":1213,"_27782":1194,"_19244":48975,"_5":13232,"_26277":48928,"_2666":48976},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3170":1214,"_27782":1194,"_19244":48978,"_5":13232,"_26277":48928,"_2666":48979},[],"Select policy-approved roots as anchors.",{"_3170":1215,"_27782":1194,"_19244":48981,"_5":13232,"_26277":48928,"_2666":48982},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3170":1216,"_27782":1194,"_19244":48984,"_5":13232,"_26277":48928,"_2666":48985},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3170":1217,"_27782":1194,"_19244":48987,"_5":13232,"_26277":48928,"_2666":48988},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3170":1218,"_27782":1194,"_19244":48990,"_5":13232,"_26277":48928,"_2666":48991},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3170":1219,"_27782":1194,"_19244":48993,"_5":13232,"_26277":48932,"_2666":48994},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3170":1220,"_27782":1194,"_19244":48996,"_5":13232,"_26277":48932,"_2666":48997},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3170":1221,"_27782":1194,"_19244":48999,"_5":13232,"_26277":48932,"_2666":49000},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3170":1222,"_27782":1194,"_19244":49002,"_5":13232,"_26277":48936,"_2666":49003},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3170":1223,"_27782":1223,"_5":13558,"_2666":49005,"_28124":49006,"_19244":49008,"_26277":1223},"AWS IoT Core",[45194,46574,47551,47549,49007],"Integrations",[],{"_3170":1224,"_27782":1223,"_19244":49010,"_5":13232,"_26277":1223,"_2666":49011},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3170":1225,"_27782":1223,"_5":28121,"_19244":49013,"_26277":49014,"_2666":49015},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3170":1226,"_27782":1223,"_5":28121,"_19244":49017,"_26277":49018,"_2666":49019},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3170":1227,"_27782":1223,"_5":28121,"_19244":49021,"_26277":49022,"_2666":49023},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3170":1228,"_27782":1223,"_5":28121,"_19244":49025,"_26277":49026,"_2666":49027},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3170":1229,"_27782":1223,"_5":28121,"_19244":49029,"_26277":49030,"_2666":49031},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3170":1230,"_27782":1223,"_5":28121,"_19244":49033,"_26277":49034,"_2666":49035},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3170":1231,"_27782":1223,"_5":28121,"_19244":49037,"_26277":49038,"_2666":49039},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3170":1232,"_27782":1223,"_5":28121,"_19244":49041,"_26277":49042,"_2666":49043},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3170":1233,"_27782":1223,"_5":28121,"_19244":49045,"_26277":49046,"_2666":49047},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3170":1234,"_27782":1223,"_5":28121,"_19244":49049,"_26277":49050,"_2666":49051},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3170":1235,"_27782":1223,"_5":28121,"_19244":49053,"_26277":49054,"_2666":49055},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3170":1236,"_27782":1223,"_5":28121,"_19244":49057,"_26277":49058,"_2666":49059},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3170":1237,"_27782":1223,"_5":28121,"_19244":49061,"_26277":49062,"_2666":49063},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3170":1238,"_27782":1223,"_5":28121,"_19244":49065,"_26277":49066,"_2666":49067},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3170":1239,"_27782":1223,"_5":28121,"_19244":49069,"_26277":49070,"_2666":49071},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3170":1240,"_27782":1223,"_5":28121,"_19244":49073,"_26277":49074,"_2666":49075},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3170":1241,"_27782":1223,"_5":28121,"_19244":49077,"_26277":49078,"_2666":49079},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3170":1242,"_27782":1223,"_5":28121,"_19244":49081,"_26277":49082,"_2666":49083},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3170":1243,"_27782":1223,"_5":28121,"_19244":49085,"_26277":49086,"_2666":49087},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3170":1244,"_27782":1223,"_5":28121,"_19244":49089,"_26277":49090,"_2666":49091},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3170":1245,"_27782":1223,"_19244":49093,"_5":13232,"_26277":1223,"_2666":49094},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3170":1246,"_27782":1223,"_19244":49096,"_5":13232,"_26277":1223,"_2666":49097},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3170":1247,"_27782":1223,"_19244":49099,"_5":13232,"_26277":1223,"_2666":49100},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3170":1248,"_27782":1223,"_19244":49102,"_5":13232,"_26277":49014,"_2666":49103},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3170":1249,"_27782":1223,"_19244":49105,"_5":13232,"_26277":49014,"_2666":49106},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3170":1250,"_27782":1223,"_19244":49108,"_5":13232,"_26277":49014,"_2666":49109},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3170":1251,"_27782":1223,"_19244":49111,"_5":13232,"_26277":49014,"_2666":49112},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3170":1252,"_27782":1223,"_19244":49114,"_5":13232,"_26277":49018,"_2666":49115},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3170":1253,"_27782":1223,"_19244":49117,"_5":13232,"_26277":49022,"_2666":49118},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3170":1254,"_27782":1223,"_19244":49120,"_5":13232,"_26277":49022,"_2666":49121},[],"IAM action",{"_3170":1255,"_27782":1223,"_19244":49123,"_5":13232,"_26277":49022,"_2666":45584},[],{"_3170":1256,"_27782":1223,"_19244":49125,"_5":13232,"_26277":49022,"_2666":49126},[],"`iot:GetRegistrationCode`",{"_3170":1257,"_27782":1223,"_19244":49128,"_5":13232,"_26277":49022,"_2666":49129},[],"Obtain the verification code for CA registration in the Primary Account",{"_3170":1258,"_27782":1223,"_19244":49131,"_5":13232,"_26277":49022,"_2666":49132},[],"`iot:RegisterCACertificate`",{"_3170":1259,"_27782":1223,"_19244":49134,"_5":13232,"_26277":49022,"_2666":49135},[],"Register the CA in AWS IoT",{"_3170":1260,"_27782":1223,"_19244":49137,"_5":13232,"_26277":49022,"_2666":49138},[],"`iot:DescribeCACertificate`",{"_3170":1261,"_27782":1223,"_19244":49140,"_5":13232,"_26277":49022,"_2666":49141},[],"Check the CA registration status",{"_3170":1262,"_27782":1223,"_19244":49143,"_5":13232,"_26277":49022,"_2666":49144},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3170":1263,"_27782":1223,"_19244":49146,"_5":13232,"_26277":49022,"_2666":49147},[],"Create or update Things in IoT Core",{"_3170":1264,"_27782":1223,"_19244":49149,"_5":13232,"_26277":49022,"_2666":49150},[],"`iot:RegisterThing`",{"_3170":1265,"_27782":1223,"_19244":49152,"_5":13232,"_26277":49022,"_2666":49153},[],"Provision Things through a template",{"_3170":1266,"_27782":1223,"_19244":49155,"_5":13232,"_26277":49022,"_2666":49156},[],"`iot:RegisterCertificate`",{"_3170":1267,"_27782":1223,"_19244":49158,"_5":13232,"_26277":49022,"_2666":49159},[],"Register device certificates",{"_3170":1268,"_27782":1223,"_19244":49161,"_5":13232,"_26277":49022,"_2666":49162},[],"`iot:UpdateCertificate`",{"_3170":1269,"_27782":1223,"_19244":49164,"_5":13232,"_26277":49022,"_2666":49165},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3170":1270,"_27782":1223,"_19244":49167,"_5":13232,"_26277":49022,"_2666":49168},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3170":1271,"_27782":1223,"_19244":49170,"_5":13232,"_26277":49022,"_2666":49171},[],"Create and attach IoT policies",{"_3170":1272,"_27782":1223,"_19244":49173,"_5":13232,"_26277":49022,"_2666":49174},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3170":1273,"_27782":1223,"_19244":49176,"_5":13232,"_26277":49022,"_2666":49177},[],"Manage Thing groups",{"_3170":1274,"_27782":1223,"_19244":49179,"_5":13232,"_26277":49022,"_2666":49180},[],"`iot:CreateProvisioningTemplate`",{"_3170":1275,"_27782":1223,"_19244":49182,"_5":13232,"_26277":49022,"_2666":49183},[],"Create JITP templates",{"_3170":1276,"_27782":1223,"_19244":49185,"_5":13232,"_26277":49022,"_2666":49186},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3170":1277,"_27782":1223,"_19244":49188,"_5":13232,"_26277":49022,"_2666":49189},[],"Read and write the Device Shadow",{"_3170":1278,"_27782":1223,"_19244":49191,"_5":13232,"_26277":49022,"_2666":49192},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3170":1279,"_27782":1223,"_19244":49194,"_5":13232,"_26277":49026,"_2666":49195},[],"Parameter",{"_3170":1280,"_27782":1223,"_19244":49197,"_5":13232,"_26277":49026,"_2666":49198},[],"Type",{"_3170":1281,"_27782":1223,"_19244":49200,"_5":13232,"_26277":49026,"_2666":49201},[],"Required",{"_3170":1282,"_27782":1223,"_19244":49203,"_5":13232,"_26277":49026,"_2666":49204},[],"Description",{"_3170":1283,"_27782":1223,"_19244":49206,"_5":13232,"_26277":49026,"_2666":49207},[],"`connector_id`",{"_3170":1284,"_27782":1223,"_19244":49209,"_5":13232,"_26277":49026,"_2666":23022},[],{"_3170":1285,"_27782":1223,"_19244":49211,"_5":13232,"_26277":49026,"_2666":49212},[],"Yes",{"_3170":1286,"_27782":1223,"_19244":49214,"_5":13232,"_26277":49026,"_2666":49215},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3170":1287,"_27782":1223,"_19244":49217,"_5":13232,"_26277":49026,"_2666":49218},[],"`aws_config.region`",{"_3170":1288,"_27782":1223,"_19244":49220,"_5":13232,"_26277":49026,"_2666":23022},[],{"_3170":1289,"_27782":1223,"_19244":49222,"_5":13232,"_26277":49026,"_2666":49212},[],{"_3170":1290,"_27782":1223,"_19244":49224,"_5":13232,"_26277":49026,"_2666":49225},[],"AWS region where the connector operates.",{"_3170":1291,"_27782":1223,"_19244":49227,"_5":13232,"_26277":49026,"_2666":49228},[],"`aws_config.auth_method`",{"_3170":1292,"_27782":1223,"_19244":49230,"_5":13232,"_26277":49026,"_2666":23022},[],{"_3170":1293,"_27782":1223,"_19244":49232,"_5":13232,"_26277":49026,"_2666":49212},[],{"_3170":1294,"_27782":1223,"_19244":49234,"_5":13232,"_26277":49026,"_2666":49235},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3170":1295,"_27782":1223,"_19244":49237,"_5":13232,"_26277":49026,"_2666":49238},[],"`aws_config.access_key_id`",{"_3170":1296,"_27782":1223,"_19244":49240,"_5":13232,"_26277":49026,"_2666":23022},[],{"_3170":1297,"_27782":1223,"_19244":49242,"_5":13232,"_26277":49026,"_2666":49243},[],"Only with `auth_method=static`",{"_3170":1298,"_27782":1223,"_19244":49245,"_5":13232,"_26277":49026,"_2666":49246},[],"AWS access key.",{"_3170":1299,"_27782":1223,"_19244":49248,"_5":13232,"_26277":49026,"_2666":49249},[],"`aws_config.secret_access_key`",{"_3170":1300,"_27782":1223,"_19244":49251,"_5":13232,"_26277":49026,"_2666":23022},[],{"_3170":1301,"_27782":1223,"_19244":49253,"_5":13232,"_26277":49026,"_2666":49243},[],{"_3170":1302,"_27782":1223,"_19244":49255,"_5":13232,"_26277":49026,"_2666":49256},[],"AWS secret key.",{"_3170":1303,"_27782":1223,"_19244":49258,"_5":13232,"_26277":49026,"_2666":49259},[],"`aws_config.session_token`",{"_3170":1304,"_27782":1223,"_19244":49261,"_5":13232,"_26277":49026,"_2666":23022},[],{"_3170":1305,"_27782":1223,"_19244":49263,"_5":13232,"_26277":49026,"_2666":49264},[],"No",{"_3170":1306,"_27782":1223,"_19244":49266,"_5":13232,"_26277":49026,"_2666":49267},[],"Session token (with `auth_method=static`).",{"_3170":1307,"_27782":1223,"_19244":49269,"_5":13232,"_26277":49026,"_2666":49270},[],"`aws_config.role_arn`",{"_3170":1308,"_27782":1223,"_19244":49272,"_5":13232,"_26277":49026,"_2666":23022},[],{"_3170":1309,"_27782":1223,"_19244":49274,"_5":13232,"_26277":49026,"_2666":49275},[],"Only with `auth_method=role`",{"_3170":1310,"_27782":1223,"_19244":49277,"_5":13232,"_26277":49026,"_2666":49278},[],"ARN of the role to assume.",{"_3170":1311,"_27782":1223,"_19244":49280,"_5":13232,"_26277":49026,"_2666":49281},[],"`aws_config.endpoint_url`",{"_3170":1312,"_27782":1223,"_19244":49283,"_5":13232,"_26277":49026,"_2666":23022},[],{"_3170":1313,"_27782":1223,"_19244":49285,"_5":13232,"_26277":49026,"_2666":49264},[],{"_3170":1314,"_27782":1223,"_19244":49287,"_5":13232,"_26277":49026,"_2666":49288},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3170":1315,"_27782":1223,"_19244":49290,"_5":13232,"_26277":49026,"_2666":49291},[],"`subscriber_event_bus`",{"_3170":1316,"_27782":1223,"_19244":49293,"_5":13232,"_26277":49026,"_2666":16222},[],{"_3170":1317,"_27782":1223,"_19244":49295,"_5":13232,"_26277":49026,"_2666":49212},[],{"_3170":1318,"_27782":1223,"_19244":49297,"_5":13232,"_26277":49026,"_2666":49298},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3170":1319,"_27782":1223,"_19244":49300,"_5":13232,"_26277":49026,"_2666":49301},[],"`dms_manager_client`",{"_3170":1320,"_27782":1223,"_19244":49303,"_5":13232,"_26277":49026,"_2666":23022},[],{"_3170":1321,"_27782":1223,"_19244":49305,"_5":13232,"_26277":49026,"_2666":49212},[],{"_3170":1322,"_27782":1223,"_19244":49307,"_5":13232,"_26277":49026,"_2666":49308},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3170":1323,"_27782":1223,"_19244":49310,"_5":13232,"_26277":49026,"_2666":49311},[],"`device_manager_client`",{"_3170":1324,"_27782":1223,"_19244":49313,"_5":13232,"_26277":49026,"_2666":23022},[],{"_3170":1325,"_27782":1223,"_19244":49315,"_5":13232,"_26277":49026,"_2666":49212},[],{"_3170":1326,"_27782":1223,"_19244":49317,"_5":13232,"_26277":49026,"_2666":49318},[],"HTTP URL of Lamassu's Device Manager.",{"_3170":1327,"_27782":1223,"_19244":49320,"_5":13232,"_26277":49026,"_2666":49321},[],"`ca_client`",{"_3170":1328,"_27782":1223,"_19244":49323,"_5":13232,"_26277":49026,"_2666":23022},[],{"_3170":1329,"_27782":1223,"_19244":49325,"_5":13232,"_26277":49026,"_2666":49212},[],{"_3170":1330,"_27782":1223,"_19244":49327,"_5":13232,"_26277":49026,"_2666":49328},[],"HTTP URL of Lamassu's CA service.",{"_3170":1331,"_27782":1223,"_19244":49330,"_5":13232,"_26277":49030,"_2666":49331},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3170":1332,"_27782":1223,"_19244":49333,"_5":13232,"_26277":49034,"_2666":49334},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3170":1333,"_27782":1223,"_19244":49336,"_5":13232,"_26277":49034,"_2666":49337},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3170":1334,"_27782":1223,"_19244":49339,"_5":13232,"_26277":49038,"_2666":49340},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3170":1335,"_27782":1223,"_19244":49342,"_5":13232,"_26277":49038,"_2666":49343},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3170":1336,"_27782":1223,"_19244":49345,"_5":13232,"_26277":49038,"_2666":49346},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3170":1337,"_27782":1223,"_19244":49348,"_5":13232,"_26277":49038,"_2666":49349},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3170":1338,"_27782":1223,"_19244":49351,"_5":13232,"_26277":49038,"_2666":49352},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3170":1339,"_27782":1223,"_19244":49354,"_5":13232,"_26277":49038,"_2666":49355},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3170":1340,"_27782":1223,"_19244":49357,"_5":13232,"_26277":49042,"_2666":49358},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3170":1341,"_27782":1223,"_19244":49360,"_5":13232,"_26277":49046,"_2666":49361},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3170":1342,"_27782":1223,"_19244":49363,"_5":13232,"_26277":49046,"_2666":49364},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3170":1343,"_27782":1223,"_19244":49366,"_5":13232,"_26277":49050,"_2666":49367},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3170":1344,"_27782":1223,"_19244":49369,"_5":13232,"_26277":49054,"_2666":49370},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3170":1345,"_27782":1223,"_19244":49372,"_5":13232,"_26277":49054,"_2666":49373},[],"Creates or updates the IoT policies configured in the DMS.",{"_3170":1346,"_27782":1223,"_19244":49375,"_5":13232,"_26277":49054,"_2666":49376},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3170":1347,"_27782":1223,"_19244":49378,"_5":13232,"_26277":49054,"_2666":49379},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3170":1348,"_27782":1223,"_19244":49381,"_5":13232,"_26277":49054,"_2666":49382},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3170":1349,"_27782":1223,"_19244":49384,"_5":13232,"_26277":49054,"_2666":49385},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3170":1350,"_27782":1223,"_19244":49387,"_5":13232,"_26277":49054,"_2666":49388},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3170":1351,"_27782":1223,"_19244":49390,"_5":13232,"_26277":49058,"_2666":49391},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3170":1352,"_27782":1223,"_19244":49393,"_5":13232,"_26277":49058,"_2666":49394},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3170":1353,"_27782":1223,"_19244":49396,"_5":13232,"_26277":49058,"_2666":49397},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3170":1354,"_27782":1223,"_19244":49399,"_5":13232,"_26277":49062,"_2666":49400},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3170":1355,"_27782":1223,"_19244":49402,"_5":13232,"_26277":49062,"_2666":49403},[],"The full flow from the device's perspective is:",{"_3170":1356,"_27782":1223,"_19244":49405,"_5":13232,"_26277":49062,"_2666":49406},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3170":1357,"_27782":1223,"_19244":49408,"_5":13232,"_26277":49066,"_2666":49409},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3170":1358,"_27782":1223,"_19244":49411,"_5":13232,"_26277":49066,"_2666":49412},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3170":1359,"_27782":1223,"_19244":49414,"_5":13232,"_26277":49066,"_2666":49415},[],"For the JITP flow to work correctly:",{"_3170":1360,"_27782":1223,"_19244":49417,"_5":13232,"_26277":49066,"_2666":49418},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3170":1361,"_27782":1223,"_19244":49420,"_5":13232,"_26277":49066,"_2666":49421},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3170":1362,"_27782":1223,"_19244":49423,"_5":13232,"_26277":49066,"_2666":49424},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3170":1363,"_27782":1223,"_19244":49426,"_5":13232,"_26277":49066,"_2666":49427},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3170":1364,"_27782":1223,"_19244":49429,"_5":13232,"_26277":49070,"_2666":49430},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3170":1365,"_27782":1223,"_19244":49432,"_5":13232,"_26277":49070,"_2666":49433},[],"Status in Lamassu",{"_3170":1366,"_27782":1223,"_19244":49435,"_5":13232,"_26277":49070,"_2666":49436},[],"Revocation reason",{"_3170":1367,"_27782":1223,"_19244":49438,"_5":13232,"_26277":49070,"_2666":49439},[],"Status in AWS IoT Core",{"_3170":1368,"_27782":1223,"_19244":49441,"_5":13232,"_26277":49070,"_2666":49442},[],"`Active`",{"_3170":1369,"_27782":1223,"_19244":49444,"_5":13232,"_26277":49070,"_2666":49445},[],"None",{"_3170":1370,"_27782":1223,"_19244":49447,"_5":13232,"_26277":49070,"_2666":49448},[],"`ACTIVE`",{"_3170":1371,"_27782":1223,"_19244":49450,"_5":13232,"_26277":49070,"_2666":49451},[],"`Revoked`",{"_3170":1372,"_27782":1223,"_19244":49453,"_5":13232,"_26277":49070,"_2666":49454},[],"`certificateHold`",{"_3170":1373,"_27782":1223,"_19244":49456,"_5":13232,"_26277":49070,"_2666":49457},[],"`INACTIVE`",{"_3170":1374,"_27782":1223,"_19244":49459,"_5":13232,"_26277":49070,"_2666":49451},[],{"_3170":1375,"_27782":1223,"_19244":49461,"_5":13232,"_26277":49070,"_2666":49462},[],"Any other reason",{"_3170":1376,"_27782":1223,"_19244":49464,"_5":13232,"_26277":49070,"_2666":49465},[],"`REVOKED`",{"_3170":1377,"_27782":1223,"_19244":49467,"_5":13232,"_26277":49070,"_2666":49468},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3170":1378,"_27782":1223,"_19244":49470,"_5":13232,"_26277":49074,"_2666":49471},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3170":1379,"_27782":1223,"_19244":49473,"_5":13232,"_26277":49074,"_2666":49474},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3170":1380,"_27782":1223,"_19244":49476,"_5":13232,"_26277":49074,"_2666":49477},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3170":1381,"_27782":1223,"_19244":49479,"_5":13232,"_26277":49078,"_2666":49480},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3170":1382,"_27782":1223,"_19244":49482,"_5":13232,"_26277":49078,"_2666":49483},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3170":1383,"_27782":1223,"_19244":49485,"_5":13232,"_26277":49082,"_2666":49486},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3170":1384,"_27782":1223,"_19244":49488,"_5":13232,"_26277":49082,"_2666":49489},[],"There are two action types:",{"_3170":1385,"_27782":1223,"_19244":49491,"_5":13232,"_26277":49082,"_2666":49492},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3170":1386,"_27782":1223,"_19244":49494,"_5":13232,"_26277":49082,"_2666":49495},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3170":1387,"_27782":1223,"_19244":49497,"_5":13232,"_26277":49082,"_2666":49498},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3170":1388,"_27782":1223,"_19244":49500,"_5":13232,"_26277":49086,"_2666":49501},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3170":1389,"_27782":1223,"_19244":49503,"_5":13232,"_26277":49086,"_2666":49504},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3170":1390,"_27782":1223,"_19244":49506,"_5":13232,"_26277":49086,"_2666":49507},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3170":1391,"_27782":1223,"_19244":49509,"_5":13232,"_26277":49090,"_2666":49510},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3170":1392,"_27782":1223,"_19244":49512,"_5":13232,"_26277":49090,"_2666":49513},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3170":1393,"_27782":1223,"_19244":49515,"_5":13232,"_26277":49090,"_2666":49516},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3170":1394,"_27782":1223,"_19244":49518,"_5":13232,"_26277":49090,"_2666":49519},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3170":1395,"_27782":1223,"_19244":49521,"_5":13232,"_26277":49090,"_2666":49522},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3170":1396,"_27782":1223,"_19244":49524,"_5":13232,"_26277":49090,"_2666":49525},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3170":1397,"_27782":1223,"_19244":49527,"_5":13232,"_26277":49090,"_2666":49528},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3170":1398,"_27782":1223,"_19244":49530,"_5":13232,"_26277":49090,"_2666":49531},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3170":1399,"_27782":1223,"_19244":49533,"_5":13232,"_26277":49090,"_2666":49534},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3170":1400,"_27782":1223,"_19244":49536,"_5":13232,"_26277":49090,"_2666":49537},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3170":1401,"_27782":1223,"_19244":49539,"_5":13232,"_26277":49090,"_2666":49540},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3170":1402,"_27782":1223,"_19244":49542,"_5":13232,"_26277":49090,"_2666":49543},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3170":1403,"_27782":1223,"_19244":49545,"_5":13232,"_26277":49090,"_2666":49546},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3170":1404,"_27782":1223,"_19244":49548,"_5":13232,"_26277":49090,"_2666":49549},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3170":1405,"_27782":1223,"_19244":49551,"_5":13232,"_26277":49090,"_2666":49552},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3170":1406,"_27782":1223,"_19244":49554,"_5":13232,"_26277":49090,"_2666":49555},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3170":1407,"_27782":1223,"_19244":49557,"_5":13232,"_26277":49090,"_2666":49558},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3170":1408,"_27782":1223,"_19244":49560,"_5":13232,"_26277":49090,"_2666":49561},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3170":1409,"_27782":1223,"_19244":49563,"_5":13232,"_26277":49090,"_2666":49564},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3170":1410,"_27782":1223,"_19244":49566,"_5":13232,"_26277":49090,"_2666":49567},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3170":1411,"_27782":1223,"_19244":49569,"_5":13232,"_26277":49090,"_2666":49570},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3170":1412,"_27782":1412,"_5":13558,"_2666":47551,"_28124":49572,"_19244":49573,"_26277":1412},[45194,46574,47551],[],{"_3170":1413,"_27782":1412,"_19244":49575,"_5":13232,"_26277":1412,"_2666":49576},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3170":1414,"_27782":1412,"_5":28121,"_19244":49578,"_26277":49579,"_2666":49580},[],"/docs/pr-preview/pr-52/platform/iot-fleets/overview#start-here","Start here",{"_3170":1415,"_27782":1412,"_5":28121,"_19244":49582,"_26277":49583,"_2666":47549},[],"/docs/pr-preview/pr-52/platform/iot-fleets/overview#devices-and-identities",{"_3170":1416,"_27782":1412,"_5":28121,"_19244":49585,"_26277":49586,"_2666":47732},[],"/docs/pr-preview/pr-52/platform/iot-fleets/overview#enrollment-with-pki",{"_3170":1417,"_27782":1412,"_5":28121,"_19244":49588,"_26277":49589,"_2666":49007},[],"/docs/pr-preview/pr-52/platform/iot-fleets/overview#integrations",{"_3170":1418,"_27782":1412,"_5":28121,"_19244":49591,"_26277":49592,"_2666":49593},[],"/docs/pr-preview/pr-52/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3170":1419,"_27782":1412,"_19244":49595,"_5":13232,"_26277":1412,"_2666":49596},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3170":1420,"_27782":1412,"_19244":49598,"_5":13232,"_26277":49579,"_2666":49599},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3170":1421,"_27782":1412,"_19244":49601,"_5":13232,"_26277":49579,"_2666":49602},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3170":1422,"_27782":1412,"_19244":49604,"_5":13232,"_26277":49583,"_2666":49605},[],"Resource",{"_3170":1423,"_27782":1412,"_19244":49607,"_5":13232,"_26277":49583,"_2666":49608},[],"What it represents",{"_3170":1424,"_27782":1412,"_19244":49610,"_5":13232,"_26277":49583,"_2666":49611},[],"**Device**",{"_3170":1425,"_27782":1412,"_19244":49613,"_5":13232,"_26277":49583,"_2666":49614},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3170":1426,"_27782":1412,"_19244":49616,"_5":13232,"_26277":49583,"_2666":49617},[],"**Identity**",{"_3170":1427,"_27782":1412,"_19244":49619,"_5":13232,"_26277":49583,"_2666":49620},[],"The device's association with its certificates: an active version and a history.",{"_3170":1428,"_27782":1412,"_19244":49622,"_5":13232,"_26277":49583,"_2666":49623},[],"**DMS**",{"_3170":1429,"_27782":1412,"_19244":49625,"_5":13232,"_26277":49583,"_2666":49626},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3170":1430,"_27782":1412,"_19244":49628,"_5":13232,"_26277":49583,"_2666":49629},[],"**Fleet**",{"_3170":1431,"_27782":1412,"_19244":49631,"_5":13232,"_26277":49583,"_2666":49632},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3170":1432,"_27782":1412,"_19244":49634,"_5":13232,"_26277":49583,"_2666":49635},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3170":1433,"_27782":1412,"_19244":49637,"_5":13232,"_26277":49583,"_2666":49638},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3170":1434,"_27782":1412,"_19244":49640,"_5":13232,"_26277":49586,"_2666":49641},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3170":1435,"_27782":1412,"_19244":49643,"_5":13232,"_26277":49586,"_2666":49644},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3170":1436,"_27782":1412,"_19244":49646,"_5":13232,"_26277":49586,"_2666":49647},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3170":1437,"_27782":1412,"_19244":49649,"_5":13232,"_26277":49586,"_2666":49650},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3170":1438,"_27782":1412,"_19244":49652,"_5":13232,"_26277":49586,"_2666":49653},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3170":1439,"_27782":1412,"_19244":49655,"_5":13232,"_26277":49586,"_2666":49656},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3170":1440,"_27782":1412,"_19244":49658,"_5":13232,"_26277":49586,"_2666":49659},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3170":1441,"_27782":1412,"_19244":49661,"_5":13232,"_26277":49586,"_2666":49662},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3170":1442,"_27782":1412,"_19244":49664,"_5":13232,"_26277":49589,"_2666":49665},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3170":1443,"_27782":1412,"_19244":49667,"_5":13232,"_26277":49589,"_2666":49668},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3170":1444,"_27782":1412,"_19244":49670,"_5":13232,"_26277":49592,"_2666":49671},[],"Participant",{"_3170":1445,"_27782":1412,"_19244":49673,"_5":13232,"_26277":49592,"_2666":49674},[],"Responsibility",{"_3170":1446,"_27782":1412,"_19244":49676,"_5":13232,"_26277":49592,"_2666":49677},[],"PKI administrator",{"_3170":1447,"_27782":1412,"_19244":49679,"_5":13232,"_26277":49592,"_2666":49680},[],"CA, issuance profile, chain and revocation publication.",{"_3170":1448,"_27782":1412,"_19244":49682,"_5":13232,"_26277":49592,"_2666":49683},[],"Provisioning administrator",{"_3170":1449,"_27782":1412,"_19244":49685,"_5":13232,"_26277":49592,"_2666":49686},[],"DMS, admission, authentication per operation and inventory.",{"_3170":1450,"_27782":1412,"_19244":49688,"_5":13232,"_26277":49592,"_2666":49689},[],"Device integrator",{"_3170":1451,"_27782":1412,"_19244":49691,"_5":13232,"_26277":49592,"_2666":49692},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3170":1452,"_27782":1412,"_19244":49694,"_5":13232,"_26277":49592,"_2666":49695},[],"Consumer integrator",{"_3170":1453,"_27782":1412,"_19244":49697,"_5":13232,"_26277":49592,"_2666":49698},[],"Trusted issuers, validation and device permissions in the destination.",{"_3170":1454,"_27782":1412,"_19244":49700,"_5":13232,"_26277":49592,"_2666":49701},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3170":1455,"_27782":1455,"_5":13558,"_2666":49703,"_28124":49704,"_19244":49706,"_26277":1455},"Enroll and connect your first device",[45194,46574,47551,49705],"Getting started",[],{"_3170":1456,"_27782":1455,"_19244":49708,"_5":13232,"_26277":1455,"_2666":49709},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3170":1457,"_27782":1455,"_5":28121,"_19244":49711,"_26277":49712,"_2666":45204},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3170":1458,"_27782":1455,"_5":28121,"_19244":49714,"_26277":49715,"_2666":49716},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3170":1459,"_27782":1455,"_5":28121,"_19244":49718,"_26277":49719,"_2666":49720},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3170":1460,"_27782":1455,"_5":28121,"_19244":49722,"_26277":49723,"_2666":49724},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3170":1461,"_27782":1455,"_5":28121,"_19244":49726,"_26277":49727,"_2666":49728},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3170":1462,"_27782":1455,"_5":28121,"_19244":49730,"_26277":49731,"_2666":49732},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3170":1463,"_27782":1455,"_5":28121,"_19244":49734,"_26277":49735,"_2666":49736},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3170":1464,"_27782":1455,"_5":28121,"_19244":49738,"_26277":49739,"_2666":49740},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3170":1465,"_27782":1455,"_19244":49742,"_5":13232,"_26277":1455,"_2666":49743},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3170":1466,"_27782":1455,"_19244":49745,"_5":13232,"_26277":49712,"_2666":49746},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3170":1467,"_27782":1455,"_19244":49748,"_5":13232,"_26277":49712,"_2666":49749},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3170":1468,"_27782":1455,"_19244":49751,"_5":13232,"_26277":49712,"_2666":49752},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3170":1469,"_27782":1455,"_19244":49754,"_5":13232,"_26277":49712,"_2666":49755},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3170":1470,"_27782":1455,"_19244":49757,"_5":13232,"_26277":49712,"_2666":49758},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3170":1471,"_27782":1455,"_19244":49760,"_5":13232,"_26277":49715,"_2666":49761},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3170":1472,"_27782":1455,"_19244":49763,"_5":13232,"_26277":49715,"_2666":49764},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3170":1473,"_27782":1455,"_19244":49766,"_5":13232,"_26277":49719,"_2666":49767},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3170":1474,"_27782":1455,"_19244":49769,"_5":13232,"_26277":49719,"_2666":49770},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3170":1475,"_27782":1455,"_19244":49772,"_5":13232,"_26277":49719,"_2666":49773},[],"Setting",{"_3170":1476,"_27782":1455,"_19244":49775,"_5":13232,"_26277":49719,"_2666":49776},[],"Evaluation value",{"_3170":1477,"_27782":1455,"_19244":49778,"_5":13232,"_26277":49719,"_2666":49779},[],"Enrollment CA",{"_3170":1478,"_27782":1455,"_19244":49781,"_5":13232,"_26277":49719,"_2666":49782},[],"Issuing root from `device-root.pem`.",{"_3170":1479,"_27782":1455,"_19244":49784,"_5":13232,"_26277":49719,"_2666":47862},[],{"_3170":1480,"_27782":1455,"_19244":49786,"_5":13232,"_26277":49719,"_2666":49787},[],"The 1-hour leaf profile you just prepared.",{"_3170":1481,"_27782":1455,"_19244":49789,"_5":13232,"_26277":49719,"_2666":49790},[],"Protocol / Registration Mode",{"_3170":1482,"_27782":1455,"_19244":49792,"_5":13232,"_26277":49719,"_2666":49793},[],"`EST_RFC7030` / `JITP`.",{"_3170":1483,"_27782":1455,"_19244":49795,"_5":13232,"_26277":49719,"_2666":49796},[],"Verify CSR Signature",{"_3170":1484,"_27782":1455,"_19244":49798,"_5":13232,"_26277":49719,"_2666":49799},[],"Enabled.",{"_3170":1485,"_27782":1455,"_19244":49801,"_5":13232,"_26277":49719,"_2666":49802},[],"Enable Replaceable Enrollment",{"_3170":1486,"_27782":1455,"_19244":49804,"_5":13232,"_26277":49719,"_2666":49805},[],"Disabled; the ID must be new.",{"_3170":1487,"_27782":1455,"_19244":49807,"_5":13232,"_26277":49719,"_2666":49808},[],"Initial authentication",{"_3170":1488,"_27782":1455,"_19244":49810,"_5":13232,"_26277":49719,"_2666":49811},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3170":1489,"_27782":1455,"_19244":49813,"_5":13232,"_26277":49719,"_2666":49814},[],"Renewal authentication",{"_3170":1490,"_27782":1455,"_19244":49816,"_5":13232,"_26277":49719,"_2666":49817},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3170":1491,"_27782":1455,"_19244":49819,"_5":13232,"_26277":49719,"_2666":49820},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3170":1492,"_27782":1455,"_19244":49822,"_5":13232,"_26277":49719,"_2666":49823},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3170":1493,"_27782":1455,"_19244":49825,"_5":13232,"_26277":49719,"_2666":49826},[],"Re-enrollment Delta",{"_3170":1494,"_27782":1455,"_19244":49828,"_5":13232,"_26277":49719,"_2666":49829},[],"1 hour.",{"_3170":1495,"_27782":1455,"_19244":49831,"_5":13232,"_26277":49719,"_2666":49832},[],"Preventive / Critical Delta",{"_3170":1496,"_27782":1455,"_19244":49834,"_5":13232,"_26277":49719,"_2666":49835},[],"30 minutes / 10 minutes.",{"_3170":1497,"_27782":1455,"_19244":49837,"_5":13232,"_26277":49719,"_2666":49838},[],"Revoke on Re-enrollment",{"_3170":1498,"_27782":1455,"_19244":49840,"_5":13232,"_26277":49719,"_2666":49841},[],"Disabled to test the successor before retiring the previous identity.",{"_3170":1499,"_27782":1455,"_19244":49843,"_5":13232,"_26277":49719,"_2666":47870},[],{"_3170":1500,"_27782":1455,"_19244":49845,"_5":13232,"_26277":49719,"_2666":49846},[],"Disabled; the operational key is generated in the client.",{"_3170":1501,"_27782":1455,"_19244":49848,"_5":13232,"_26277":49719,"_2666":49849},[],"CA Distribution",{"_3170":1502,"_27782":1455,"_19244":49851,"_5":13232,"_26277":49719,"_2666":49852},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3170":1503,"_27782":1455,"_19244":49854,"_5":13232,"_26277":49719,"_2666":49855},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. If your console does not expose the independent block, configure and check the resource through the DMS API and DMS guide.",{"_3170":1504,"_27782":1455,"_19244":49857,"_5":13232,"_26277":49723,"_2666":49858},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3170":1505,"_27782":1455,"_19244":49860,"_5":13232,"_26277":49723,"_2666":49861},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3170":1506,"_27782":1455,"_19244":49863,"_5":13232,"_26277":49727,"_2666":49864},[],"Generate a new key and CSR with the selected identifier:",{"_3170":1507,"_27782":1455,"_19244":49866,"_5":13232,"_26277":49727,"_2666":49867},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3170":1508,"_27782":1455,"_19244":49869,"_5":13232,"_26277":49727,"_2666":49870},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3170":1509,"_27782":1455,"_19244":49872,"_5":13232,"_26277":49731,"_2666":49873},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3170":1510,"_27782":1455,"_19244":49875,"_5":13232,"_26277":49731,"_2666":49876},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3170":1511,"_27782":1455,"_19244":49878,"_5":13232,"_26277":49735,"_2666":49879},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3170":1512,"_27782":1455,"_19244":49881,"_5":13232,"_26277":49735,"_2666":49882},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3170":1513,"_27782":1455,"_19244":49884,"_5":13232,"_26277":49735,"_2666":49885},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3170":1514,"_27782":1455,"_19244":49887,"_5":13232,"_26277":49735,"_2666":49888},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3170":1515,"_27782":1455,"_19244":49890,"_5":13232,"_26277":49735,"_2666":49891},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3170":1516,"_27782":1455,"_19244":49893,"_5":13232,"_26277":49739,"_2666":49894},[],"Check",{"_3170":1517,"_27782":1455,"_19244":49896,"_5":13232,"_26277":49739,"_2666":49897},[],"Expected result",{"_3170":1518,"_27782":1455,"_19244":49899,"_5":13232,"_26277":49739,"_2666":49900},[],"Registration",{"_3170":1519,"_27782":1455,"_19244":49902,"_5":13232,"_26277":49739,"_2666":49903},[],"ID created automatically and correct DMS.",{"_3170":1520,"_27782":1455,"_19244":49905,"_5":13232,"_26277":49739,"_2666":49906},[],"Certificate",{"_3170":1521,"_27782":1455,"_19244":49908,"_5":13232,"_26277":49739,"_2666":49909},[],"CN, profile, serial and key verified.",{"_3170":1522,"_27782":1455,"_19244":49911,"_5":13232,"_26277":49739,"_2666":49912},[],"Inventory",{"_3170":1523,"_27782":1455,"_19244":49914,"_5":13232,"_26277":49739,"_2666":49915},[],"Received serial visible as the current identity and in history.",{"_3170":1524,"_27782":1455,"_19244":49917,"_5":13232,"_26277":49739,"_2666":49918},[],"Consumer",{"_3170":1525,"_27782":1455,"_19244":49920,"_5":13232,"_26277":49739,"_2666":49921},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3170":1526,"_27782":1455,"_19244":49923,"_5":13232,"_26277":49739,"_2666":49924},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3170":1527,"_27782":1455,"_19244":49926,"_5":13232,"_26277":49739,"_2666":49927},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3170":1528,"_27782":1528,"_5":13558,"_2666":47567,"_28124":49929,"_19244":49930,"_26277":1528},[45194,46574,47551,49705],[],{"_3170":1529,"_27782":1528,"_19244":49932,"_5":13232,"_26277":1528,"_2666":49933},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3170":1530,"_27782":1528,"_5":28121,"_19244":49935,"_26277":49936,"_2666":45204},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3170":1531,"_27782":1528,"_5":28121,"_19244":49938,"_26277":49939,"_2666":49940},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3170":1532,"_27782":1528,"_5":28121,"_19244":49942,"_26277":49943,"_2666":49944},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3170":1533,"_27782":1528,"_5":28121,"_19244":49946,"_26277":49947,"_2666":49948},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3170":1534,"_27782":1528,"_5":28121,"_19244":49950,"_26277":49951,"_2666":49952},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3170":1535,"_27782":1528,"_5":28121,"_19244":49954,"_26277":49955,"_2666":49956},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3170":1536,"_27782":1528,"_5":28121,"_19244":49958,"_26277":49959,"_2666":49897},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3170":1537,"_27782":1528,"_5":28121,"_19244":49961,"_26277":49962,"_2666":49963},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3170":1538,"_27782":1528,"_5":28121,"_19244":49965,"_26277":49966,"_2666":49967},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3170":1539,"_27782":1528,"_19244":49969,"_5":13232,"_26277":1528,"_2666":49970},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3170":1540,"_27782":1528,"_19244":49972,"_5":13232,"_26277":1528,"_2666":49973},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3170":1541,"_27782":1528,"_19244":49975,"_5":13232,"_26277":49936,"_2666":49976},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3170":1542,"_27782":1528,"_19244":49978,"_5":13232,"_26277":49936,"_2666":49979},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3170":1543,"_27782":1528,"_19244":49981,"_5":13232,"_26277":49936,"_2666":49982},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3170":1544,"_27782":1528,"_19244":49984,"_5":13232,"_26277":49936,"_2666":49985},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3170":1545,"_27782":1528,"_19244":49987,"_5":13232,"_26277":49939,"_2666":49988},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3170":1546,"_27782":1528,"_19244":49990,"_5":13232,"_26277":49939,"_2666":49991},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3170":1547,"_27782":1528,"_19244":49993,"_5":13232,"_26277":49939,"_2666":49994},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3170":1548,"_27782":1528,"_19244":49996,"_5":13232,"_26277":49939,"_2666":49997},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3170":1549,"_27782":1528,"_19244":49999,"_5":13232,"_26277":49939,"_2666":50000},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3170":1550,"_27782":1528,"_19244":50002,"_5":13232,"_26277":49939,"_2666":50003},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3170":1551,"_27782":1528,"_19244":50005,"_5":13232,"_26277":49939,"_2666":50006},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3170":1552,"_27782":1528,"_19244":50008,"_5":13232,"_26277":49939,"_2666":50009},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3170":1553,"_27782":1528,"_19244":50011,"_5":13232,"_26277":49943,"_2666":50012},[],"Open **Managed Devices** and the registration action. Complete:",{"_3170":1554,"_27782":1528,"_19244":50014,"_5":13232,"_26277":49943,"_2666":50015},[],"**Device ID**: `device-001`.",{"_3170":1555,"_27782":1528,"_19244":50017,"_5":13232,"_26277":49943,"_2666":50018},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3170":1556,"_27782":1528,"_19244":50020,"_5":13232,"_26277":49943,"_2666":50021},[],"**Icon** and **Tags**: optional classification.",{"_3170":1557,"_27782":1528,"_19244":50023,"_5":13232,"_26277":49943,"_2666":50024},[],"Confirm registration.",{"_3170":1558,"_27782":1528,"_19244":50026,"_5":13232,"_26277":49947,"_2666":50027},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3170":1559,"_27782":1528,"_19244":50029,"_5":13232,"_26277":49947,"_2666":50030},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3170":1560,"_27782":1528,"_19244":50032,"_5":13232,"_26277":49951,"_2666":50033},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3170":1561,"_27782":1528,"_19244":50035,"_5":13232,"_26277":49951,"_2666":50036},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3170":1562,"_27782":1528,"_19244":50038,"_5":13232,"_26277":49955,"_2666":50039},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3170":1563,"_27782":1528,"_19244":50041,"_5":13232,"_26277":49955,"_2666":50042},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3170":1564,"_27782":1528,"_19244":50044,"_5":13232,"_26277":49959,"_2666":49894},[],{"_3170":1565,"_27782":1528,"_19244":50046,"_5":13232,"_26277":49959,"_2666":50047},[],"Result",{"_3170":1566,"_27782":1528,"_19244":50049,"_5":13232,"_26277":49959,"_2666":50050},[],"Device",{"_3170":1567,"_27782":1528,"_19244":50052,"_5":13232,"_26277":49959,"_2666":50053},[],"`device-001` appears in inventory with the expected DMS.",{"_3170":1568,"_27782":1528,"_19244":50055,"_5":13232,"_26277":49959,"_2666":50056},[],"Current identity",{"_3170":1569,"_27782":1528,"_19244":50058,"_5":13232,"_26277":49959,"_2666":50059},[],"The associated certificate matches the one you verified in PKI.",{"_3170":1570,"_27782":1528,"_19244":50061,"_5":13232,"_26277":49959,"_2666":50062},[],"History",{"_3170":1571,"_27782":1528,"_19244":50064,"_5":13232,"_26277":49959,"_2666":50065},[],"The associated issuance appears with its serial number and dates.",{"_3170":1572,"_27782":1528,"_19244":50067,"_5":13232,"_26277":49959,"_2666":50068},[],"Key and certificate",{"_3170":1573,"_27782":1528,"_19244":50070,"_5":13232,"_26277":49959,"_2666":50071},[],"You have the verified pair ready to install on the device.",{"_3170":1574,"_27782":1528,"_19244":50073,"_5":13232,"_26277":49962,"_2666":50074},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3170":1575,"_27782":1528,"_19244":50076,"_5":13232,"_26277":49962,"_2666":50077},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3170":1576,"_27782":1528,"_19244":50079,"_5":13232,"_26277":49962,"_2666":50080},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3170":1577,"_27782":1528,"_19244":50082,"_5":13232,"_26277":49962,"_2666":50083},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3170":1578,"_27782":1528,"_19244":50085,"_5":13232,"_26277":49966,"_2666":50086},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3170":1579,"_27782":1528,"_19244":50088,"_5":13232,"_26277":49966,"_2666":50089},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3170":1580,"_27782":1528,"_19244":50091,"_5":13232,"_26277":49966,"_2666":50092},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3170":1581,"_27782":1581,"_5":13558,"_2666":50094,"_28124":50095,"_19244":50096,"_26277":1581},"Lamassu IoT Platform",[45194,46574],[],{"_3170":1582,"_27782":1581,"_19244":50098,"_5":13232,"_26277":1581,"_2666":50099},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3170":1583,"_27782":1581,"_5":28121,"_19244":50101,"_26277":50102,"_2666":49580},[],"/docs/pr-preview/pr-52/platform/overview#start-here",{"_3170":1584,"_27782":1581,"_5":28121,"_19244":50104,"_26277":50105,"_2666":50106},[],"/docs/pr-preview/pr-52/platform/overview#choose-your-path","Choose your path",{"_3170":1585,"_27782":1581,"_5":28121,"_19244":50108,"_26277":50109,"_2666":50110},[],"/docs/pr-preview/pr-52/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3170":1586,"_27782":1581,"_5":28121,"_19244":50112,"_26277":50113,"_2666":50114},[],"/docs/pr-preview/pr-52/platform/overview#core-capabilities","Core capabilities",{"_3170":1587,"_27782":1581,"_5":28121,"_19244":50116,"_26277":50117,"_2666":50118},[],"/docs/pr-preview/pr-52/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3170":1588,"_27782":1581,"_5":28121,"_19244":50120,"_26277":50121,"_2666":50122},[],"/docs/pr-preview/pr-52/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3170":1589,"_27782":1581,"_5":28121,"_19244":50124,"_26277":50125,"_2666":50126},[],"/docs/pr-preview/pr-52/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3170":1590,"_27782":1581,"_5":28121,"_19244":50128,"_26277":50129,"_2666":50130},[],"/docs/pr-preview/pr-52/platform/overview#automate-device-identities","Automate device identities",{"_3170":1591,"_27782":1581,"_5":28121,"_19244":50132,"_26277":50133,"_2666":50134},[],"/docs/pr-preview/pr-52/platform/overview#publish-validation-status","Publish validation status",{"_3170":1592,"_27782":1581,"_5":28121,"_19244":50136,"_26277":50137,"_2666":50138},[],"/docs/pr-preview/pr-52/platform/overview#react-to-events","React to events",{"_3170":1593,"_27782":1581,"_5":28121,"_19244":50140,"_26277":50141,"_2666":50142},[],"/docs/pr-preview/pr-52/platform/overview#operational-reference","Operational reference",{"_3170":1594,"_27782":1581,"_19244":50144,"_5":13232,"_26277":1581,"_2666":50145},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3170":1595,"_27782":1581,"_19244":50147,"_5":13232,"_26277":50102,"_2666":50148},[],"Choose the result you need:",{"_3170":1596,"_27782":1581,"_19244":50150,"_5":13232,"_26277":50102,"_2666":50151},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3170":1597,"_27782":1581,"_19244":50153,"_5":13232,"_26277":50102,"_2666":50154},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3170":1598,"_27782":1581,"_19244":50156,"_5":13232,"_26277":50102,"_2666":50157},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3170":1599,"_27782":1581,"_19244":50159,"_5":13232,"_26277":50105,"_2666":50160},[],"Section",{"_3170":1600,"_27782":1581,"_19244":50162,"_5":13232,"_26277":50105,"_2666":50163},[],"What you manage",{"_3170":1601,"_27782":1581,"_19244":50165,"_5":13232,"_26277":50105,"_2666":50166},[],"Entry point",{"_3170":1602,"_27782":1581,"_19244":50168,"_5":13232,"_26277":50105,"_2666":50169},[],"**PKI**",{"_3170":1603,"_27782":1581,"_19244":50171,"_5":13232,"_26277":50105,"_2666":50172},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3170":1604,"_27782":1581,"_19244":50174,"_5":13232,"_26277":50105,"_2666":50175},[],"PKI overview",{"_3170":1605,"_27782":1581,"_19244":50177,"_5":13232,"_26277":50105,"_2666":50178},[],"**IoT Fleets**",{"_3170":1606,"_27782":1581,"_19244":50180,"_5":13232,"_26277":50105,"_2666":50181},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3170":1607,"_27782":1581,"_19244":50183,"_5":13232,"_26277":50105,"_2666":50184},[],"IoT Fleets overview",{"_3170":1608,"_27782":1581,"_19244":50186,"_5":13232,"_26277":50105,"_2666":50187},[],"**Administration**",{"_3170":1609,"_27782":1581,"_19244":50189,"_5":13232,"_26277":50105,"_2666":50190},[],"Operator permissions, audit and event subscriptions.",{"_3170":1610,"_27782":1581,"_19244":50192,"_5":13232,"_26277":50105,"_2666":46572},[],{"_3170":1611,"_27782":1581,"_19244":50194,"_5":13232,"_26277":50105,"_2666":50195},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3170":1612,"_27782":1581,"_19244":50197,"_5":13232,"_26277":50109,"_2666":50198},[],"An identity's journey connects four responsibilities:",{"_3170":1613,"_27782":1581,"_19244":50200,"_5":13232,"_26277":50109,"_2666":50201},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3170":1614,"_27782":1581,"_19244":50203,"_5":13232,"_26277":50109,"_2666":50204},[],"The provisioning administrator configures the DMS and initial trust.",{"_3170":1615,"_27782":1581,"_19244":50206,"_5":13232,"_26277":50109,"_2666":50207},[],"The device client requests a certificate and installs it with the matching key.",{"_3170":1616,"_27782":1581,"_19244":50209,"_5":13232,"_26277":50109,"_2666":50210},[],"The consumer validates the identity and applies its access permissions.",{"_3170":1617,"_27782":1581,"_19244":50212,"_5":13232,"_26277":50109,"_2666":50213},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3170":1618,"_27782":1581,"_19244":50215,"_5":13232,"_26277":50117,"_2666":50216},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3170":1619,"_27782":1581,"_19244":50218,"_5":13232,"_26277":50121,"_2666":50219},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3170":1620,"_27782":1581,"_19244":50221,"_5":13232,"_26277":50125,"_2666":50222},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3170":1621,"_27782":1581,"_19244":50224,"_5":13232,"_26277":50129,"_2666":50225},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3170":1622,"_27782":1581,"_19244":50227,"_5":13232,"_26277":50133,"_2666":50228},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3170":1623,"_27782":1581,"_19244":50230,"_5":13232,"_26277":50137,"_2666":50231},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3170":1624,"_27782":1581,"_19244":50233,"_5":13232,"_26277":50141,"_2666":49674},[],{"_3170":1625,"_27782":1581,"_19244":50235,"_5":13232,"_26277":50141,"_2666":50236},[],"What it prepares or checks",{"_3170":1626,"_27782":1581,"_19244":50238,"_5":13232,"_26277":50141,"_2666":49677},[],{"_3170":1627,"_27782":1581,"_19244":50240,"_5":13232,"_26277":50141,"_2666":50241},[],"Key custody, CA hierarchy, profiles and validation.",{"_3170":1628,"_27782":1581,"_19244":50243,"_5":13232,"_26277":50141,"_2666":50244},[],"Fleet administrator",{"_3170":1629,"_27782":1581,"_19244":50246,"_5":13232,"_26277":50141,"_2666":50247},[],"DMS, device admission, renewal policy and inventory.",{"_3170":1630,"_27782":1581,"_19244":50249,"_5":13232,"_26277":50141,"_2666":49689},[],{"_3170":1631,"_27782":1581,"_19244":50251,"_5":13232,"_26277":50141,"_2666":50252},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3170":1632,"_27782":1581,"_19244":50254,"_5":13232,"_26277":50141,"_2666":49695},[],{"_3170":1633,"_27782":1581,"_19244":50256,"_5":13232,"_26277":50141,"_2666":50257},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3170":1634,"_27782":1581,"_19244":50259,"_5":13232,"_26277":50141,"_2666":50260},[],"Infrastructure operator",{"_3170":1635,"_27782":1581,"_19244":50262,"_5":13232,"_26277":50141,"_2666":50263},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3170":1636,"_27782":1581,"_19244":50265,"_5":13232,"_26277":50141,"_2666":50266},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3170":1637,"_27782":1637,"_5":13558,"_2666":50268,"_28124":50269,"_19244":50272,"_26277":1637},"CA hierarchy and rotation",[45194,46574,50270,50271],"PKI","Keys, authorities and certificates",[],{"_3170":1638,"_27782":1637,"_19244":50274,"_5":13232,"_26277":1637,"_2666":50275},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3170":1639,"_27782":1637,"_5":28121,"_19244":50277,"_26277":50278,"_2666":50279},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3170":1640,"_27782":1637,"_5":28121,"_19244":50281,"_26277":50282,"_2666":50283},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3170":1641,"_27782":1637,"_5":28121,"_19244":50285,"_26277":50286,"_2666":50287},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3170":1642,"_27782":1637,"_5":28121,"_19244":50289,"_26277":50290,"_2666":50291},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3170":1643,"_27782":1637,"_5":28121,"_19244":50293,"_26277":50294,"_2666":50295},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3170":1644,"_27782":1637,"_5":28121,"_19244":50297,"_26277":50298,"_2666":50299},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3170":1645,"_27782":1637,"_5":28121,"_19244":50301,"_26277":50302,"_2666":50303},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3170":1646,"_27782":1637,"_5":28121,"_19244":50305,"_26277":50306,"_2666":50307},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3170":1647,"_27782":1637,"_5":28121,"_19244":50309,"_26277":50310,"_2666":50311},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3170":1648,"_27782":1637,"_5":28121,"_19244":50313,"_26277":50314,"_2666":50315},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3170":1649,"_27782":1637,"_5":28121,"_19244":50317,"_26277":50318,"_2666":50319},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3170":1650,"_27782":1637,"_5":28121,"_19244":50321,"_26277":50322,"_2666":50323},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3170":1651,"_27782":1637,"_19244":50325,"_5":13232,"_26277":1637,"_2666":50326},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3170":1652,"_27782":1637,"_19244":50328,"_5":13232,"_26277":1637,"_2666":50329},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3170":1653,"_27782":1637,"_19244":50331,"_5":13232,"_26277":50278,"_2666":50332},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3170":1654,"_27782":1637,"_19244":50334,"_5":13232,"_26277":50278,"_2666":50335},[],"environment, such as production and preproduction;",{"_3170":1655,"_27782":1637,"_19244":50337,"_5":13232,"_26277":50278,"_2666":50338},[],"owner or operating team;",{"_3170":1656,"_27782":1637,"_19244":50340,"_5":13232,"_26277":50278,"_2666":50341},[],"device family or manufacturing process;",{"_3170":1657,"_27782":1637,"_19244":50343,"_5":13232,"_26277":50278,"_2666":50344},[],"region or regulatory requirement;",{"_3170":1658,"_27782":1637,"_19244":50346,"_5":13232,"_26277":50278,"_2666":50347},[],"cryptographic engine or key policy;",{"_3170":1659,"_27782":1637,"_19244":50349,"_5":13232,"_26277":50278,"_2666":50350},[],"maintenance window and renewal cadence.",{"_3170":1660,"_27782":1637,"_19244":50352,"_5":13232,"_26277":50278,"_2666":50353},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3170":1661,"_27782":1637,"_19244":50355,"_5":13232,"_26277":50278,"_2666":50356},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3170":1662,"_27782":1637,"_19244":50358,"_5":13232,"_26277":50282,"_2666":50359},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3170":1663,"_27782":1637,"_19244":50361,"_5":13232,"_26277":50282,"_2666":50362},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3170":1664,"_27782":1637,"_19244":50364,"_5":13232,"_26277":50282,"_2666":50365},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3170":1665,"_27782":1637,"_19244":50367,"_5":13232,"_26277":50286,"_2666":50368},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3170":1666,"_27782":1637,"_19244":50370,"_5":13232,"_26277":50286,"_2666":50371},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3170":1667,"_27782":1637,"_19244":50373,"_5":13232,"_26277":50286,"_2666":50374},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3170":1668,"_27782":1637,"_19244":50376,"_5":13232,"_26277":50286,"_2666":50377},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3170":1669,"_27782":1637,"_19244":50379,"_5":13232,"_26277":50294,"_2666":50380},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3170":1670,"_27782":1637,"_19244":50382,"_5":13232,"_26277":50298,"_2666":50383},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3170":1671,"_27782":1637,"_19244":50385,"_5":13232,"_26277":50302,"_2666":50386},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3170":1672,"_27782":1637,"_19244":50388,"_5":13232,"_26277":50306,"_2666":50389},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3170":1673,"_27782":1637,"_19244":50391,"_5":13232,"_26277":50310,"_2666":50392},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3170":1674,"_27782":1637,"_19244":50394,"_5":13232,"_26277":50314,"_2666":50395},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3170":1675,"_27782":1637,"_19244":50397,"_5":13232,"_26277":50318,"_2666":50398},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3170":1676,"_27782":1637,"_19244":50400,"_5":13232,"_26277":50318,"_2666":50401},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3170":1677,"_27782":1637,"_19244":50403,"_5":13232,"_26277":50318,"_2666":50404},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3170":1678,"_27782":1637,"_19244":50406,"_5":13232,"_26277":50318,"_2666":50407},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3170":1679,"_27782":1637,"_19244":50409,"_5":13232,"_26277":50322,"_2666":50410},[],"The new chain ends in an anchor installed by the consumer.",{"_3170":1680,"_27782":1637,"_19244":50412,"_5":13232,"_26277":50322,"_2666":50413},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3170":1681,"_27782":1637,"_19244":50415,"_5":13232,"_26277":50322,"_2666":50416},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3170":1682,"_27782":1637,"_19244":50418,"_5":13232,"_26277":50322,"_2666":50419},[],"Re-enrollment accepts the old identity during the planned period.",{"_3170":1683,"_27782":1637,"_19244":50421,"_5":13232,"_26277":50322,"_2666":50422},[],"OCSP and CRL respond for the authorities that remain active.",{"_3170":1684,"_27782":1637,"_19244":50424,"_5":13232,"_26277":50322,"_2666":50425},[],"No DMS is left accidentally issuing from the old CA.",{"_3170":1685,"_27782":1637,"_19244":50427,"_5":13232,"_26277":50322,"_2666":50428},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3170":1686,"_27782":1686,"_5":13558,"_2666":50430,"_28124":50431,"_19244":50432,"_26277":1686},"Certification authorities",[45194,46574,50270,50271],[],{"_3170":1687,"_27782":1686,"_19244":50434,"_5":13232,"_26277":1686,"_2666":50435},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3170":1688,"_27782":1686,"_5":28121,"_19244":50437,"_26277":50438,"_2666":50439},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3170":1689,"_27782":1686,"_5":28121,"_19244":50441,"_26277":50442,"_2666":50443},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3170":1690,"_27782":1686,"_5":28121,"_19244":50445,"_26277":50446,"_2666":45204},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#before-you-begin",{"_3170":1691,"_27782":1686,"_5":28121,"_19244":50448,"_26277":50449,"_2666":50450},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3170":1692,"_27782":1686,"_5":28121,"_19244":50452,"_26277":50453,"_2666":50454},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3170":1693,"_27782":1686,"_5":28121,"_19244":50456,"_26277":50457,"_2666":50458},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3170":1694,"_27782":1686,"_5":28121,"_19244":50460,"_26277":50461,"_2666":50462},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3170":1695,"_27782":1686,"_5":28121,"_19244":50464,"_26277":50465,"_2666":50466},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3170":1696,"_27782":1686,"_5":28121,"_19244":50468,"_26277":50469,"_2666":50470},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3170":1697,"_27782":1686,"_5":28121,"_19244":50472,"_26277":50473,"_2666":50474},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3170":1698,"_27782":1686,"_5":28121,"_19244":50476,"_26277":50477,"_2666":50478},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3170":1699,"_27782":1686,"_5":28121,"_19244":50480,"_26277":50481,"_2666":50482},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3170":1700,"_27782":1686,"_5":28121,"_19244":50484,"_26277":50485,"_2666":50486},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3170":1701,"_27782":1686,"_5":28121,"_19244":50488,"_26277":50489,"_2666":50490},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3170":1702,"_27782":1686,"_5":28121,"_19244":50492,"_26277":50493,"_2666":50494},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3170":1703,"_27782":1686,"_5":28121,"_19244":50496,"_26277":50497,"_2666":50498},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3170":1704,"_27782":1686,"_5":28121,"_19244":50500,"_26277":50501,"_2666":50502},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3170":1705,"_27782":1686,"_5":28121,"_19244":50504,"_26277":50505,"_2666":50506},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3170":1706,"_27782":1686,"_5":28121,"_19244":50508,"_26277":50509,"_2666":50510},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3170":1707,"_27782":1686,"_5":28121,"_19244":50512,"_26277":50513,"_2666":50514},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3170":1708,"_27782":1686,"_5":28121,"_19244":50516,"_26277":50517,"_2666":50518},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3170":1709,"_27782":1686,"_5":28121,"_19244":50520,"_26277":50521,"_2666":50522},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3170":1710,"_27782":1686,"_19244":50524,"_5":13232,"_26277":1686,"_2666":50525},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3170":1711,"_27782":1686,"_19244":50527,"_5":13232,"_26277":1686,"_2666":50528},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3170":1712,"_27782":1686,"_19244":50530,"_5":13232,"_26277":1686,"_2666":50531},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3170":1713,"_27782":1686,"_19244":50533,"_5":13232,"_26277":50438,"_2666":50534},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3170":1714,"_27782":1686,"_19244":50536,"_5":13232,"_26277":50438,"_2666":50537},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3170":1715,"_27782":1686,"_19244":50539,"_5":13232,"_26277":50438,"_2666":50540},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3170":1716,"_27782":1686,"_19244":50542,"_5":13232,"_26277":50438,"_2666":50543},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3170":1717,"_27782":1686,"_19244":50545,"_5":13232,"_26277":50438,"_2666":50546},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3170":1718,"_27782":1686,"_19244":50548,"_5":13232,"_26277":50446,"_2666":50549},[],"Decide whether the CA will be a root or an intermediate.",{"_3170":1719,"_27782":1686,"_19244":50551,"_5":13232,"_26277":50446,"_2666":50552},[],"Choose the engine that will keep the key.",{"_3170":1720,"_27782":1686,"_19244":50554,"_5":13232,"_26277":50446,"_2666":50555},[],"Define a validity longer than that of the certificates it will issue.",{"_3170":1721,"_27782":1686,"_19244":50557,"_5":13232,"_26277":50446,"_2666":50558},[],"For an intermediate CA, make sure the parent CA is active.",{"_3170":1722,"_27782":1686,"_19244":50560,"_5":13232,"_26277":50449,"_2666":50561},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3170":1723,"_27782":1686,"_19244":50563,"_5":13232,"_26277":50453,"_2666":50564},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3170":1724,"_27782":1686,"_19244":50566,"_5":13232,"_26277":50453,"_2666":50567},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3170":1725,"_27782":1686,"_19244":50569,"_5":13232,"_26277":50457,"_2666":50570},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3170":1726,"_27782":1686,"_19244":50572,"_5":13232,"_26277":50461,"_2666":50573},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3170":1727,"_27782":1686,"_19244":50575,"_5":13232,"_26277":50461,"_2666":50576},[],"`C`: two-letter ISO 3166-1 country code.",{"_3170":1728,"_27782":1686,"_19244":50578,"_5":13232,"_26277":50461,"_2666":50579},[],"`ST`: state or province.",{"_3170":1729,"_27782":1686,"_19244":50581,"_5":13232,"_26277":50461,"_2666":50582},[],"`L`: locality.",{"_3170":1730,"_27782":1686,"_19244":50584,"_5":13232,"_26277":50461,"_2666":50585},[],"`O`: organization.",{"_3170":1731,"_27782":1686,"_19244":50587,"_5":13232,"_26277":50461,"_2666":50588},[],"`OU`: organizational unit.",{"_3170":1732,"_27782":1686,"_19244":50590,"_5":13232,"_26277":50461,"_2666":50591},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3170":1733,"_27782":1686,"_19244":50593,"_5":13232,"_26277":50465,"_2666":50594},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3170":1734,"_27782":1686,"_19244":50596,"_5":13232,"_26277":50465,"_2666":50597},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3170":1735,"_27782":1686,"_19244":50599,"_5":13232,"_26277":50469,"_2666":50600},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3170":1736,"_27782":1686,"_19244":50602,"_5":13232,"_26277":50469,"_2666":50603},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3170":1737,"_27782":1686,"_19244":50605,"_5":13232,"_26277":50473,"_2666":50606},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3170":1738,"_27782":1686,"_19244":50608,"_5":13232,"_26277":50473,"_2666":50609},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3170":1739,"_27782":1686,"_19244":50611,"_5":13232,"_26277":50477,"_2666":50612},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3170":1740,"_27782":1686,"_19244":50614,"_5":13232,"_26277":50477,"_2666":50615},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number collides with a different existing certificate, or which is an identical duplicate CA. A deleted CA's certificate record is kept and reused on re-import, including its previous status. Deleting a CA releases its key, which the KMS keeps while other certificates still reference it.",{"_3170":1741,"_27782":1686,"_19244":50617,"_5":13232,"_26277":50481,"_2666":50618},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3170":1742,"_27782":1686,"_19244":50620,"_5":13232,"_26277":50485,"_2666":50621},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3170":1743,"_27782":1686,"_19244":50623,"_5":13232,"_26277":50489,"_2666":50624},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3170":1744,"_27782":1686,"_19244":50626,"_5":13232,"_26277":50493,"_2666":50627},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3170":1745,"_27782":1686,"_19244":50629,"_5":13232,"_26277":50493,"_2666":50630},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3170":1746,"_27782":1686,"_19244":50632,"_5":13232,"_26277":50497,"_2666":50633},[],"Open a CA from the inventory to review:",{"_3170":1747,"_27782":1686,"_19244":50635,"_5":13232,"_26277":50497,"_2666":50636},[],"Status and validity period.",{"_3170":1748,"_27782":1686,"_19244":50638,"_5":13232,"_26277":50497,"_2666":50639},[],"Certificate and chain in PEM format.",{"_3170":1749,"_27782":1686,"_19244":50641,"_5":13232,"_26277":50497,"_2666":50642},[],"Number of active, expired and revoked certificates.",{"_3170":1750,"_27782":1686,"_19244":50644,"_5":13232,"_26277":50497,"_2666":50645},[],"Certificates issued in **Issued Certificates**.",{"_3170":1751,"_27782":1686,"_19244":50647,"_5":13232,"_26277":50497,"_2666":50648},[],"The CRL linked to the authority.",{"_3170":1752,"_27782":1686,"_19244":50650,"_5":13232,"_26277":50497,"_2666":50651},[],"Metadata and the associated cryptographic engine.",{"_3170":1753,"_27782":1686,"_19244":50653,"_5":13232,"_26277":50497,"_2666":50654},[],"You can filter the inventory by name, status and CA type.",{"_3170":1754,"_27782":1686,"_19244":50656,"_5":13232,"_26277":50501,"_2666":50657},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3170":1755,"_27782":1686,"_19244":50659,"_5":13232,"_26277":50501,"_2666":50660},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3170":1756,"_27782":1686,"_19244":50662,"_5":13232,"_26277":50501,"_2666":50663},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3170":1757,"_27782":1686,"_19244":50665,"_5":13232,"_26277":50501,"_2666":50666},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3170":1758,"_27782":1686,"_19244":50668,"_5":13232,"_26277":50505,"_2666":50669},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3170":1759,"_27782":1686,"_19244":50671,"_5":13232,"_26277":50509,"_2666":50672},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3170":1760,"_27782":1686,"_19244":50674,"_5":13232,"_26277":50513,"_2666":50675},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3170":1761,"_27782":1686,"_19244":50677,"_5":13232,"_26277":50517,"_2666":50678},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3170":1762,"_27782":1686,"_19244":50680,"_5":13232,"_26277":50521,"_2666":50681},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3170":1763,"_27782":1686,"_19244":50683,"_5":13232,"_26277":50521,"_2666":50684},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_3170":1764,"_27782":1764,"_5":13558,"_2666":50686,"_28124":50687,"_19244":50688,"_26277":1764},"Certificate profiles",[45194,46574,50270,50271],[],{"_3170":1765,"_27782":1764,"_19244":50690,"_5":13232,"_26277":1764,"_2666":50691},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3170":1766,"_27782":1764,"_5":28121,"_19244":50693,"_26277":50694,"_2666":50695},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3170":1767,"_27782":1764,"_5":28121,"_19244":50697,"_26277":50698,"_2666":50699},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#validity","Validity",{"_3170":1768,"_27782":1764,"_5":28121,"_19244":50701,"_26277":50702,"_2666":50703},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3170":1769,"_27782":1764,"_5":28121,"_19244":50705,"_26277":50706,"_2666":50707},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3170":1770,"_27782":1764,"_5":28121,"_19244":50709,"_26277":50710,"_2666":50711},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#subject","Subject",{"_3170":1771,"_27782":1764,"_5":28121,"_19244":50713,"_26277":50714,"_2666":50715},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3170":1772,"_27782":1764,"_5":28121,"_19244":50717,"_26277":50718,"_2666":50719},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3170":1773,"_27782":1764,"_5":28121,"_19244":50721,"_26277":50722,"_2666":50723},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3170":1774,"_27782":1764,"_5":28121,"_19244":50725,"_26277":50726,"_2666":50727},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3170":1775,"_27782":1764,"_5":28121,"_19244":50729,"_26277":50730,"_2666":50731},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3170":1776,"_27782":1764,"_5":28121,"_19244":50733,"_26277":50734,"_2666":50735},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3170":1777,"_27782":1764,"_5":28121,"_19244":50737,"_26277":50738,"_2666":50739},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3170":1778,"_27782":1764,"_5":28121,"_19244":50741,"_26277":50742,"_2666":50743},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3170":1779,"_27782":1764,"_5":28121,"_19244":50745,"_26277":50746,"_2666":50747},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3170":1780,"_27782":1764,"_5":28121,"_19244":50749,"_26277":50750,"_2666":50751},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#design-examples","Design examples",{"_3170":1781,"_27782":1764,"_5":28121,"_19244":50753,"_26277":50754,"_2666":50755},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3170":1782,"_27782":1764,"_19244":50757,"_5":13232,"_26277":1764,"_2666":50758},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3170":1783,"_27782":1764,"_19244":50760,"_5":13232,"_26277":1764,"_2666":50761},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3170":1784,"_27782":1764,"_19244":50763,"_5":13232,"_26277":50698,"_2666":50764},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3170":1785,"_27782":1764,"_19244":50766,"_5":13232,"_26277":50698,"_2666":50767},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3170":1786,"_27782":1764,"_19244":50769,"_5":13232,"_26277":50702,"_2666":50770},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3170":1787,"_27782":1764,"_19244":50772,"_5":13232,"_26277":50706,"_2666":50773},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3170":1788,"_27782":1764,"_19244":50775,"_5":13232,"_26277":50706,"_2666":50776},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3170":1789,"_27782":1764,"_19244":50778,"_5":13232,"_26277":50706,"_2666":50779},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3170":1790,"_27782":1764,"_19244":50781,"_5":13232,"_26277":50710,"_2666":50782},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3170":1791,"_27782":1764,"_19244":50784,"_5":13232,"_26277":50714,"_2666":50785},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3170":1792,"_27782":1764,"_19244":50787,"_5":13232,"_26277":50714,"_2666":50788},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3170":1793,"_27782":1764,"_19244":50790,"_5":13232,"_26277":50718,"_2666":50791},[],"The cryptographic enforcement can:",{"_3170":1794,"_27782":1764,"_19244":50793,"_5":13232,"_26277":50718,"_2666":50794},[],"allow or block RSA keys;",{"_3170":1795,"_27782":1764,"_19244":50796,"_5":13232,"_26277":50718,"_2666":50797},[],"limit the supported RSA sizes;",{"_3170":1796,"_27782":1764,"_19244":50799,"_5":13232,"_26277":50718,"_2666":50800},[],"allow or block ECDSA keys;",{"_3170":1797,"_27782":1764,"_19244":50802,"_5":13232,"_26277":50718,"_2666":50803},[],"limit the supported ECDSA sizes or curves.",{"_3170":1798,"_27782":1764,"_19244":50805,"_5":13232,"_26277":50718,"_2666":50806},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3170":1799,"_27782":1764,"_19244":50808,"_5":13232,"_26277":50722,"_2666":50809},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3170":1800,"_27782":1764,"_19244":50811,"_5":13232,"_26277":50722,"_2666":48298},[],{"_3170":1801,"_27782":1764,"_19244":50813,"_5":13232,"_26277":50722,"_2666":50814},[],"First choice",{"_3170":1802,"_27782":1764,"_19244":50816,"_5":13232,"_26277":50722,"_2666":50817},[],"Second choice",{"_3170":1803,"_27782":1764,"_19244":50819,"_5":13232,"_26277":50722,"_2666":50820},[],"If neither is supplied",{"_3170":1804,"_27782":1764,"_19244":50822,"_5":13232,"_26277":50722,"_2666":50823},[],"Direct signing with a CA",{"_3170":1805,"_27782":1764,"_19244":50825,"_5":13232,"_26277":50722,"_2666":50826},[],"`issuance_profile` embedded in the request",{"_3170":1806,"_27782":1764,"_19244":50828,"_5":13232,"_26277":50722,"_2666":50829},[],"Request `issuance_profile_id`",{"_3170":1807,"_27782":1764,"_19244":50831,"_5":13232,"_26277":50722,"_2666":50832},[],"CA default profile (`profile_id`).",{"_3170":1808,"_27782":1764,"_19244":50834,"_5":13232,"_26277":50722,"_2666":50835},[],"Issuance through a DMS",{"_3170":1809,"_27782":1764,"_19244":50837,"_5":13232,"_26277":50722,"_2666":50838},[],"`settings.issuance_profile_id`",{"_3170":1810,"_27782":1764,"_19244":50840,"_5":13232,"_26277":50722,"_2666":50841},[],"`settings.issuance_profile` embedded in the DMS",{"_3170":1811,"_27782":1764,"_19244":50843,"_5":13232,"_26277":50722,"_2666":50844},[],"Enrollment CA default profile.",{"_3170":1812,"_27782":1764,"_19244":50846,"_5":13232,"_26277":50722,"_2666":50847},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3170":1813,"_27782":1764,"_19244":50849,"_5":13232,"_26277":50722,"_2666":50850},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3170":1814,"_27782":1764,"_19244":50852,"_5":13232,"_26277":50730,"_2666":50853},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3170":1815,"_27782":1764,"_19244":50855,"_5":13232,"_26277":50734,"_2666":50856},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3170":1816,"_27782":1764,"_19244":50858,"_5":13232,"_26277":50738,"_2666":50859},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3170":1817,"_27782":1764,"_19244":50861,"_5":13232,"_26277":50742,"_2666":50862},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3170":1818,"_27782":1764,"_19244":50864,"_5":13232,"_26277":50746,"_2666":50865},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3170":1819,"_27782":1764,"_19244":50867,"_5":13232,"_26277":50746,"_2666":50868},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3170":1820,"_27782":1764,"_19244":50870,"_5":13232,"_26277":50750,"_2666":50871},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3170":1821,"_27782":1764,"_19244":50873,"_5":13232,"_26277":50750,"_2666":50874},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3170":1822,"_27782":1764,"_19244":50876,"_5":13232,"_26277":50750,"_2666":50877},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3170":1823,"_27782":1764,"_19244":50879,"_5":13232,"_26277":50750,"_2666":50880},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3170":1824,"_27782":1764,"_19244":50882,"_5":13232,"_26277":50754,"_2666":50883},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3170":1825,"_27782":1764,"_19244":50885,"_5":13232,"_26277":50754,"_2666":50886},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3170":1826,"_27782":1826,"_5":13558,"_2666":50888,"_28124":50889,"_19244":50891,"_26277":1826},"Certificate validation",[45194,46574,50270,50890],"Validation",[],{"_3170":1827,"_27782":1826,"_19244":50893,"_5":13232,"_26277":1826,"_2666":50894},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3170":1828,"_27782":1826,"_5":28121,"_19244":50896,"_26277":50897,"_2666":50898},[],"/docs/pr-preview/pr-52/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3170":1829,"_27782":1826,"_5":28121,"_19244":50900,"_26277":50901,"_2666":50902},[],"/docs/pr-preview/pr-52/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3170":1830,"_27782":1826,"_5":28121,"_19244":50904,"_26277":50905,"_2666":50906},[],"/docs/pr-preview/pr-52/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3170":1831,"_27782":1826,"_19244":50908,"_5":13232,"_26277":1826,"_2666":50909},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3170":1832,"_27782":1826,"_19244":50911,"_5":13232,"_26277":50897,"_2666":50912},[],"Verify these criteria together:",{"_3170":1833,"_27782":1826,"_19244":50914,"_5":13232,"_26277":50897,"_2666":49894},[],{"_3170":1834,"_27782":1826,"_19244":50916,"_5":13232,"_26277":50897,"_2666":50917},[],"Required result",{"_3170":1835,"_27782":1826,"_19244":50919,"_5":13232,"_26277":50897,"_2666":50920},[],"Chain and signature",{"_3170":1836,"_27782":1826,"_19244":50922,"_5":13232,"_26277":50897,"_2666":50923},[],"Valid chain to a root deliberately installed in the consumer.",{"_3170":1837,"_27782":1826,"_19244":50925,"_5":13232,"_26277":50897,"_2666":50926},[],"Dates",{"_3170":1838,"_27782":1826,"_19244":50928,"_5":13232,"_26277":50897,"_2666":50929},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3170":1839,"_27782":1826,"_19244":50931,"_5":13232,"_26277":50897,"_2666":46274},[],{"_3170":1840,"_27782":1826,"_19244":50933,"_5":13232,"_26277":50897,"_2666":50934},[],"Name, SAN or identifier matches the expected peer.",{"_3170":1841,"_27782":1826,"_19244":50936,"_5":13232,"_26277":50897,"_2666":45584},[],{"_3170":1842,"_27782":1826,"_19244":50938,"_5":13232,"_26277":50897,"_2666":50939},[],"KU, EKU and constraints permit the specific operation.",{"_3170":1843,"_27782":1826,"_19244":50941,"_5":13232,"_26277":50897,"_2666":50942},[],"Revocation",{"_3170":1844,"_27782":1826,"_19244":50944,"_5":13232,"_26277":50897,"_2666":50945},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3170":1845,"_27782":1826,"_19244":50947,"_5":13232,"_26277":50897,"_2666":50948},[],"Authorization",{"_3170":1846,"_27782":1826,"_19244":50950,"_5":13232,"_26277":50897,"_2666":50951},[],"The application permits that identity to perform the action.",{"_3170":1847,"_27782":1826,"_19244":50953,"_5":13232,"_26277":50897,"_2666":50954},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3170":1848,"_27782":1826,"_19244":50956,"_5":13232,"_26277":50901,"_2666":50957},[],"Mechanism",{"_3170":1849,"_27782":1826,"_19244":50959,"_5":13232,"_26277":50901,"_2666":50960},[],"When to use it",{"_3170":1850,"_27782":1826,"_19244":50962,"_5":13232,"_26277":50901,"_2666":50963},[],"What you must maintain",{"_3170":1851,"_27782":1826,"_19244":50965,"_5":13232,"_26277":50901,"_2666":50966},[],"OCSP",{"_3170":1852,"_27782":1826,"_19244":50968,"_5":13232,"_26277":50901,"_2666":50969},[],"Status query for a specific certificate.",{"_3170":1853,"_27782":1826,"_19244":50971,"_5":13232,"_26277":50901,"_2666":50972},[],"Responder access, signature verification and cache/freshness policy.",{"_3170":1854,"_27782":1826,"_19244":50974,"_5":13232,"_26277":50901,"_2666":50975},[],"CRL",{"_3170":1855,"_27782":1826,"_19244":50977,"_5":13232,"_26277":50901,"_2666":50978},[],"Local checks for many certificates or offline operation.",{"_3170":1856,"_27782":1826,"_19244":50980,"_5":13232,"_26277":50901,"_2666":50981},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3170":1857,"_27782":1826,"_19244":50983,"_5":13232,"_26277":50901,"_2666":50984},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3170":1858,"_27782":1826,"_19244":50986,"_5":13232,"_26277":50901,"_2666":50987},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3170":1859,"_27782":1826,"_19244":50989,"_5":13232,"_26277":50905,"_2666":50990},[],"Accept a current, authorized certificate with a known chain.",{"_3170":1860,"_27782":1826,"_19244":50992,"_5":13232,"_26277":50905,"_2666":50993},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3170":1861,"_27782":1826,"_19244":50995,"_5":13232,"_26277":50905,"_2666":50996},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3170":1862,"_27782":1826,"_19244":50998,"_5":13232,"_26277":50905,"_2666":50999},[],"Check that a new connection with that identity is rejected.",{"_3170":1863,"_27782":1826,"_19244":51001,"_5":13232,"_26277":50905,"_2666":51002},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3170":1864,"_27782":1826,"_19244":51004,"_5":13232,"_26277":50905,"_2666":51005},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3170":1865,"_27782":1826,"_19244":51007,"_5":13232,"_26277":50905,"_2666":51008},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3170":1866,"_27782":1826,"_19244":51010,"_5":13232,"_26277":50905,"_2666":51011},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3170":1867,"_27782":1826,"_19244":51013,"_5":13232,"_26277":50905,"_2666":51014},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3170":1868,"_27782":1868,"_5":13558,"_2666":51016,"_28124":51017,"_19244":51018,"_26277":1868},"Certificates",[45194,46574,50270,50271],[],{"_3170":1869,"_27782":1868,"_19244":51020,"_5":13232,"_26277":1868,"_2666":51021},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3170":1870,"_27782":1868,"_5":28121,"_19244":51023,"_26277":51024,"_2666":51025},[],"/docs/pr-preview/pr-52/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3170":1871,"_27782":1868,"_5":28121,"_19244":51027,"_26277":51028,"_2666":51029},[],"/docs/pr-preview/pr-52/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3170":1872,"_27782":1868,"_5":28121,"_19244":51031,"_26277":51032,"_2666":51033},[],"/docs/pr-preview/pr-52/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3170":1873,"_27782":1868,"_5":28121,"_19244":51035,"_26277":51036,"_2666":51037},[],"/docs/pr-preview/pr-52/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3170":1874,"_27782":1868,"_5":28121,"_19244":51039,"_26277":51040,"_2666":51041},[],"/docs/pr-preview/pr-52/platform/pki/certificates#open-the-action","Open the action",{"_3170":1875,"_27782":1868,"_5":28121,"_19244":51043,"_26277":51044,"_2666":51045},[],"/docs/pr-preview/pr-52/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3170":1876,"_27782":1868,"_5":28121,"_19244":51047,"_26277":51048,"_2666":51049},[],"/docs/pr-preview/pr-52/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3170":1877,"_27782":1868,"_5":28121,"_19244":51051,"_26277":51052,"_2666":51053},[],"/docs/pr-preview/pr-52/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3170":1878,"_27782":1868,"_5":28121,"_19244":51055,"_26277":51056,"_2666":51057},[],"/docs/pr-preview/pr-52/platform/pki/certificates#continue","Continue",{"_3170":1879,"_27782":1868,"_19244":51059,"_5":13232,"_26277":1868,"_2666":51060},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3170":1880,"_27782":1868,"_19244":51062,"_5":13232,"_26277":51024,"_2666":51063},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata. Certificate details include the key reference (`key_id`) and whether the private key is managed (`has_private_key`), and certificate lists can be filtered on `has_private_key`.",{"_3170":1881,"_27782":1868,"_19244":51065,"_5":13232,"_26277":51024,"_2666":51066},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3170":1882,"_27782":1868,"_19244":51068,"_5":13232,"_26277":51028,"_2666":51069},[],"Download the PEM and inspect it:",{"_3170":1883,"_27782":1868,"_19244":51071,"_5":13232,"_26277":51028,"_2666":51072},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3170":1884,"_27782":1868,"_19244":51074,"_5":13232,"_26277":51032,"_2666":51075},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3170":1885,"_27782":1868,"_19244":51077,"_5":13232,"_26277":51032,"_2666":51078},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3170":1886,"_27782":1868,"_19244":51080,"_5":13232,"_26277":51032,"_2666":51081},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3170":1887,"_27782":1868,"_19244":51083,"_5":13232,"_26277":51032,"_2666":51084},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3170":1888,"_27782":1868,"_19244":51086,"_5":13232,"_26277":51032,"_2666":51087},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3170":1889,"_27782":1868,"_19244":51089,"_5":13232,"_26277":51032,"_2666":51090},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3170":1890,"_27782":1868,"_19244":51092,"_5":13232,"_26277":51032,"_2666":51093},[],"For browser key generation, follow Issue your first certificate.",{"_3170":1891,"_27782":1868,"_19244":51095,"_5":13232,"_26277":51036,"_2666":51096},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3170":1892,"_27782":1868,"_19244":51098,"_5":13232,"_26277":51040,"_2666":51099},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3170":1893,"_27782":1868,"_19244":51101,"_5":13232,"_26277":51044,"_2666":51102},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3170":1894,"_27782":1868,"_19244":51104,"_5":13232,"_26277":51048,"_2666":51105},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3170":1895,"_27782":1868,"_19244":51107,"_5":13232,"_26277":51048,"_2666":51108},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3170":1896,"_27782":1868,"_19244":51110,"_5":13232,"_26277":51048,"_2666":51111},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3170":1897,"_27782":1868,"_19244":51113,"_5":13232,"_26277":51052,"_2666":51114},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3170":1898,"_27782":1868,"_19244":51116,"_5":13232,"_26277":51052,"_2666":51117},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3170":1899,"_27782":1868,"_19244":51119,"_5":13232,"_26277":51052,"_2666":51120},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3170":1900,"_27782":1868,"_19244":51122,"_5":13232,"_26277":51056,"_2666":51123},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3170":1901,"_27782":1868,"_19244":51125,"_5":13232,"_26277":51056,"_2666":51126},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3170":1902,"_27782":1902,"_5":13558,"_2666":51128,"_28124":51129,"_19244":51131,"_26277":1902},"Certificate lifecycle",[45194,46574,50270,51130],"Concepts",[],{"_3170":1903,"_27782":1902,"_19244":51133,"_5":13232,"_26277":1902,"_2666":51134},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3170":1904,"_27782":1902,"_5":28121,"_19244":51136,"_26277":51137,"_2666":51138},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3170":1905,"_27782":1902,"_5":28121,"_19244":51140,"_26277":51141,"_2666":51142},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3170":1906,"_27782":1902,"_5":28121,"_19244":51144,"_26277":51145,"_2666":51146},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3170":1907,"_27782":1902,"_5":28121,"_19244":51148,"_26277":51149,"_2666":51150},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3170":1908,"_27782":1902,"_5":28121,"_19244":51152,"_26277":51153,"_2666":51154},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3170":1909,"_27782":1902,"_5":28121,"_19244":51156,"_26277":51157,"_2666":51158},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3170":1910,"_27782":1902,"_5":28121,"_19244":51160,"_26277":51161,"_2666":51162},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3170":1911,"_27782":1902,"_5":28121,"_19244":51164,"_26277":51165,"_2666":51166},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3170":1912,"_27782":1902,"_5":28121,"_19244":51168,"_26277":51169,"_2666":51170},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3170":1913,"_27782":1902,"_5":28121,"_19244":51172,"_26277":51173,"_2666":51174},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3170":1914,"_27782":1902,"_19244":51176,"_5":13232,"_26277":1902,"_2666":51177},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3170":1915,"_27782":1902,"_19244":51179,"_5":13232,"_26277":51141,"_2666":51180},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3170":1916,"_27782":1902,"_19244":51182,"_5":13232,"_26277":51145,"_2666":51183},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3170":1917,"_27782":1902,"_19244":51185,"_5":13232,"_26277":51149,"_2666":51186},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3170":1918,"_27782":1902,"_19244":51188,"_5":13232,"_26277":51153,"_2666":51189},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3170":1919,"_27782":1902,"_19244":51191,"_5":13232,"_26277":51157,"_2666":51192},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3170":1920,"_27782":1902,"_19244":51194,"_5":13232,"_26277":51161,"_2666":51195},[],"Lamassu persists four X.509 states:",{"_3170":1921,"_27782":1902,"_19244":51197,"_5":13232,"_26277":51161,"_2666":51198},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3170":1922,"_27782":1902,"_19244":51200,"_5":13232,"_26277":51161,"_2666":51201},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3170":1923,"_27782":1902,"_19244":51203,"_5":13232,"_26277":51161,"_2666":51204},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3170":1924,"_27782":1902,"_19244":51206,"_5":13232,"_26277":51161,"_2666":51207},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3170":1925,"_27782":1902,"_19244":51209,"_5":13232,"_26277":51161,"_2666":51210},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3170":1926,"_27782":1902,"_19244":51212,"_5":13232,"_26277":51165,"_2666":51213},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3170":1927,"_27782":1902,"_19244":51215,"_5":13232,"_26277":51165,"_2666":51216},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3170":1928,"_27782":1902,"_19244":51218,"_5":13232,"_26277":51165,"_2666":51219},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3170":1929,"_27782":1902,"_19244":51221,"_5":13232,"_26277":51169,"_2666":51222},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3170":1930,"_27782":1902,"_19244":51224,"_5":13232,"_26277":51169,"_2666":51225},[],"Before confirming:",{"_3170":1931,"_27782":1902,"_19244":51227,"_5":13232,"_26277":51169,"_2666":51228},[],"Identify DMSs, devices and services that trust that chain.",{"_3170":1932,"_27782":1902,"_19244":51230,"_5":13232,"_26277":51169,"_2666":51231},[],"Distribute the new chain of trust.",{"_3170":1933,"_27782":1902,"_19244":51233,"_5":13232,"_26277":51169,"_2666":51234},[],"Reissue the necessary identities.",{"_3170":1934,"_27782":1902,"_19244":51236,"_5":13232,"_26277":51169,"_2666":51237},[],"Check OCSP and CRL from a real consumer.",{"_3170":1935,"_27782":1902,"_19244":51239,"_5":13232,"_26277":51169,"_2666":51240},[],"Revoke the old CA once no legitimate traffic remains.",{"_3170":1936,"_27782":1902,"_19244":51242,"_5":13232,"_26277":51169,"_2666":51243},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3170":1937,"_27782":1902,"_19244":51245,"_5":13232,"_26277":51173,"_2666":51246},[],"Certificates entering the preventive or critical renewal window.",{"_3170":1938,"_27782":1902,"_19244":51248,"_5":13232,"_26277":51173,"_2666":51249},[],"Repeated enrollment or re-enrollment failures.",{"_3170":1939,"_27782":1902,"_19244":51251,"_5":13232,"_26277":51173,"_2666":51252},[],"Status changes and revocation reasons.",{"_3170":1940,"_27782":1902,"_19244":51254,"_5":13232,"_26277":51173,"_2666":51255},[],"OCSP and CRL publication and validity.",{"_3170":1941,"_27782":1902,"_19244":51257,"_5":13232,"_26277":51173,"_2666":51258},[],"Dependencies still presenting a replaced certificate.",{"_3170":1942,"_27782":1902,"_19244":51260,"_5":13232,"_26277":51173,"_2666":51261},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3170":1943,"_27782":1943,"_5":13558,"_2666":51263,"_28124":51264,"_19244":51265,"_26277":1943},"Trust model",[45194,46574,50270,51130],[],{"_3170":1944,"_27782":1943,"_19244":51267,"_5":13232,"_26277":1943,"_2666":51268},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3170":1945,"_27782":1943,"_5":28121,"_19244":51270,"_26277":51271,"_2666":51272},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3170":1946,"_27782":1943,"_5":28121,"_19244":51274,"_26277":51275,"_2666":51276},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3170":1947,"_27782":1943,"_5":28121,"_19244":51278,"_26277":51279,"_2666":51280},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3170":1948,"_27782":1943,"_5":28121,"_19244":51282,"_26277":51283,"_2666":51284},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3170":1949,"_27782":1943,"_5":28121,"_19244":51286,"_26277":51287,"_2666":51288},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3170":1950,"_27782":1943,"_5":28121,"_19244":51290,"_26277":51291,"_2666":51292},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3170":1951,"_27782":1943,"_5":28121,"_19244":51294,"_26277":51295,"_2666":51296},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3170":1952,"_27782":1943,"_5":28121,"_19244":51298,"_26277":51299,"_2666":51300},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3170":1953,"_27782":1943,"_5":28121,"_19244":51302,"_26277":51303,"_2666":51304},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3170":1954,"_27782":1943,"_5":28121,"_19244":51306,"_26277":51307,"_2666":51308},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3170":1955,"_27782":1943,"_19244":51310,"_5":13232,"_26277":1943,"_2666":51311},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3170":1956,"_27782":1943,"_19244":51313,"_5":13232,"_26277":51275,"_2666":51314},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3170":1957,"_27782":1943,"_19244":51316,"_5":13232,"_26277":51279,"_2666":51317},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3170":1958,"_27782":1943,"_19244":51319,"_5":13232,"_26277":51283,"_2666":51320},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3170":1959,"_27782":1943,"_19244":51322,"_5":13232,"_26277":51287,"_2666":51323},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3170":1960,"_27782":1943,"_19244":51325,"_5":13232,"_26277":51291,"_2666":51326},[],"The device proves it can enroll according to the DMS policy.",{"_3170":1961,"_27782":1943,"_19244":51328,"_5":13232,"_26277":51291,"_2666":51329},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3170":1962,"_27782":1943,"_19244":51331,"_5":13232,"_26277":51291,"_2666":51332},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3170":1963,"_27782":1943,"_19244":51334,"_5":13232,"_26277":51291,"_2666":51335},[],"The device installs the certificate and the chain it needs.",{"_3170":1964,"_27782":1943,"_19244":51337,"_5":13232,"_26277":51291,"_2666":51338},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3170":1965,"_27782":1943,"_19244":51340,"_5":13232,"_26277":51291,"_2666":51341},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3170":1966,"_27782":1943,"_19244":51343,"_5":13232,"_26277":51295,"_2666":51344},[],"A DMS relates three sets that are worth designing separately:",{"_3170":1967,"_27782":1943,"_19244":51346,"_5":13232,"_26277":51295,"_2666":51347},[],"**Enrollment CA:** signs the new identities.",{"_3170":1968,"_27782":1943,"_19244":51349,"_5":13232,"_26277":51295,"_2666":51350},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3170":1969,"_27782":1943,"_19244":51352,"_5":13232,"_26277":51295,"_2666":51353},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3170":1970,"_27782":1943,"_19244":51355,"_5":13232,"_26277":51295,"_2666":51356},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3170":1971,"_27782":1943,"_19244":51358,"_5":13232,"_26277":51299,"_2666":51359},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3170":1972,"_27782":1943,"_19244":51361,"_5":13232,"_26277":51299,"_2666":51362},[],"that the current date is between `Not Before` and `Not After`;",{"_3170":1973,"_27782":1943,"_19244":51364,"_5":13232,"_26277":51299,"_2666":51365},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3170":1974,"_27782":1943,"_19244":51367,"_5":13232,"_26277":51299,"_2666":51368},[],"that names, SANs and subject match the expected identity;",{"_3170":1975,"_27782":1943,"_19244":51370,"_5":13232,"_26277":51299,"_2666":51371},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3170":1976,"_27782":1943,"_19244":51373,"_5":13232,"_26277":51299,"_2666":51374},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3170":1977,"_27782":1943,"_19244":51376,"_5":13232,"_26277":51299,"_2666":51377},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3170":1978,"_27782":1943,"_19244":51379,"_5":13232,"_26277":51303,"_2666":51380},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3170":1979,"_27782":1943,"_19244":51382,"_5":13232,"_26277":51307,"_2666":51383},[],"Keep the root out of daily operations, or with very restricted access.",{"_3170":1980,"_27782":1943,"_19244":51385,"_5":13232,"_26277":51307,"_2666":51386},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3170":1981,"_27782":1943,"_19244":51388,"_5":13232,"_26277":51307,"_2666":51389},[],"Assign explicit profiles to every use case.",{"_3170":1982,"_27782":1943,"_19244":51391,"_5":13232,"_26277":51307,"_2666":51392},[],"Distribute the new trust before starting a rotation.",{"_3170":1983,"_27782":1943,"_19244":51394,"_5":13232,"_26277":51307,"_2666":51395},[],"Keep enough overlap to renew a disconnected fleet.",{"_3170":1984,"_27782":1943,"_19244":51397,"_5":13232,"_26277":51307,"_2666":51398},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3170":1985,"_27782":1943,"_19244":51400,"_5":13232,"_26277":51307,"_2666":51401},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3170":1986,"_27782":1986,"_5":13558,"_2666":51403,"_28124":51404,"_19244":51405,"_26277":1986},"Revocation lists (CRL)",[45194,46574,50270,50890],[],{"_3170":1987,"_27782":1986,"_19244":51407,"_5":13232,"_26277":1986,"_2666":51408},[],"Generate and distribute signed lists to validate certificates offline.",{"_3170":1988,"_27782":1986,"_5":28121,"_19244":51410,"_26277":51411,"_2666":51412},[],"/docs/pr-preview/pr-52/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_3170":1989,"_27782":1986,"_5":28121,"_19244":51414,"_26277":51415,"_2666":51416},[],"/docs/pr-preview/pr-52/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3170":1990,"_27782":1986,"_5":28121,"_19244":51418,"_26277":51419,"_2666":51420},[],"/docs/pr-preview/pr-52/platform/pki/crl#crl-contents","CRL contents",{"_3170":1991,"_27782":1986,"_5":28121,"_19244":51422,"_26277":51423,"_2666":51424},[],"/docs/pr-preview/pr-52/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3170":1992,"_27782":1986,"_5":28121,"_19244":51426,"_26277":51427,"_2666":51428},[],"/docs/pr-preview/pr-52/platform/pki/crl#va-role-management-api","VA role management API",{"_3170":1993,"_27782":1986,"_5":28121,"_19244":51430,"_26277":51431,"_2666":51432},[],"/docs/pr-preview/pr-52/platform/pki/crl#from-the-interface","From the interface",{"_3170":1994,"_27782":1986,"_5":28121,"_19244":51434,"_26277":51435,"_2666":51436},[],"/docs/pr-preview/pr-52/platform/pki/crl#references","References",{"_3170":1995,"_27782":1986,"_19244":51438,"_5":13232,"_26277":1986,"_2666":51439},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3170":1996,"_27782":1986,"_19244":51441,"_5":13232,"_26277":51411,"_2666":51442},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3170":1997,"_27782":1986,"_19244":51444,"_5":13232,"_26277":51411,"_2666":51445},[],"`crl_options` field",{"_3170":1998,"_27782":1986,"_19244":51447,"_5":13232,"_26277":51411,"_2666":45584},[],{"_3170":1999,"_27782":1986,"_19244":51449,"_5":13232,"_26277":51411,"_2666":51450},[],"Backend initial value",{"_3170":2000,"_27782":1986,"_19244":51452,"_5":13232,"_26277":51411,"_2666":51453},[],"`validity`",{"_3170":2001,"_27782":1986,"_19244":51455,"_5":13232,"_26277":51411,"_2666":51456},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3170":2002,"_27782":1986,"_19244":51458,"_5":13232,"_26277":51411,"_2666":51459},[],"7 days.",{"_3170":2003,"_27782":1986,"_19244":51461,"_5":13232,"_26277":51411,"_2666":51462},[],"`refresh_interval`",{"_3170":2004,"_27782":1986,"_19244":51464,"_5":13232,"_26277":51411,"_2666":51465},[],"Time since publication that triggers scheduled renewal.",{"_3170":2005,"_27782":1986,"_19244":51467,"_5":13232,"_26277":51411,"_2666":51468},[],"6 days and 23 hours.",{"_3170":2006,"_27782":1986,"_19244":51470,"_5":13232,"_26277":51411,"_2666":51471},[],"`regenerate_on_revoke`",{"_3170":2007,"_27782":1986,"_19244":51473,"_5":13232,"_26277":51411,"_2666":51474},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3170":2008,"_27782":1986,"_19244":51476,"_5":13232,"_26277":51411,"_2666":51477},[],"`true`.",{"_3170":2009,"_27782":1986,"_19244":51479,"_5":13232,"_26277":51411,"_2666":51480},[],"`signer_certificate_serial_number`",{"_3170":2010,"_27782":1986,"_19244":51482,"_5":13232,"_26277":51411,"_2666":51483},[],"Serial number of the existing certificate that signs the CRL.",{"_3170":2011,"_27782":1986,"_19244":51485,"_5":13232,"_26277":51411,"_2666":51486},[],"Serial number of the CA’s current certificate.",{"_3170":2012,"_27782":1986,"_19244":51488,"_5":13232,"_26277":51411,"_2666":51489},[],"The signer must be an existing certificate with the `cRLSign` key usage whose subject and public key match the CA of the role. Reissued certificates that share the CA’s key are valid signers; unrelated signers are rejected. The certificate referenced as signer cannot be deleted while the role uses it.",{"_3170":2013,"_27782":1986,"_19244":51491,"_5":13232,"_26277":51411,"_2666":51492},[],"CAs that share a key share one VA role and one CRL.",{"_3170":2014,"_27782":1986,"_19244":51494,"_5":13232,"_26277":51411,"_2666":51495},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_3170":2015,"_27782":1986,"_19244":51497,"_5":13232,"_26277":51415,"_2666":51498},[],"The scheduled job requests another list when `refresh_interval` is reached or when the list approaches expiration within the configured watch period. This depends on working jobs, storage and signing; it does not guarantee renewal during a service failure.",{"_3170":2016,"_27782":1986,"_19244":51500,"_5":13232,"_26277":51415,"_2666":51501},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3170":2017,"_27782":1986,"_19244":51503,"_5":13232,"_26277":51415,"_2666":51504},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3170":2018,"_27782":1986,"_19244":51506,"_5":13232,"_26277":51419,"_2666":51507},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3170":2019,"_27782":1986,"_19244":51509,"_5":13232,"_26277":51419,"_2666":51510},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3170":2020,"_27782":1986,"_19244":51512,"_5":13232,"_26277":51423,"_2666":51513},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_3170":2021,"_27782":1986,"_19244":51515,"_5":13232,"_26277":51423,"_2666":51516},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3170":2022,"_27782":1986,"_19244":51518,"_5":13232,"_26277":51423,"_2666":51519},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3170":2023,"_27782":1986,"_19244":51521,"_5":13232,"_26277":51423,"_2666":51522},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3170":2024,"_27782":1986,"_19244":51524,"_5":13232,"_26277":51423,"_2666":51525},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3170":2025,"_27782":1986,"_19244":51527,"_5":13232,"_26277":51427,"_2666":51528},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3170":2026,"_27782":1986,"_19244":51530,"_5":13232,"_26277":51427,"_2666":48301},[],{"_3170":2027,"_27782":1986,"_19244":51532,"_5":13232,"_26277":51427,"_2666":51533},[],"Relative path",{"_3170":2028,"_27782":1986,"_19244":51535,"_5":13232,"_26277":51427,"_2666":48298},[],{"_3170":2029,"_27782":1986,"_19244":51537,"_5":13232,"_26277":51427,"_2666":51538},[],"`GET`",{"_3170":2030,"_27782":1986,"_19244":51540,"_5":13232,"_26277":51427,"_2666":51541},[],"`/v1/roles/{ca-ski}`",{"_3170":2031,"_27782":1986,"_19244":51543,"_5":13232,"_26277":51427,"_2666":51544},[],"Read `crl_options` and `latest_crl`.",{"_3170":2032,"_27782":1986,"_19244":51546,"_5":13232,"_26277":51427,"_2666":51547},[],"`PUT`",{"_3170":2033,"_27782":1986,"_19244":51549,"_5":13232,"_26277":51427,"_2666":51541},[],{"_3170":2034,"_27782":1986,"_19244":51551,"_5":13232,"_26277":51427,"_2666":51552},[],"Replace CRL configuration.",{"_3170":2035,"_27782":1986,"_19244":51554,"_5":13232,"_26277":51427,"_2666":51555},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_3170":2036,"_27782":1986,"_19244":51557,"_5":13232,"_26277":51427,"_2666":51558},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_3170":2037,"_27782":1986,"_19244":51560,"_5":13232,"_26277":51431,"_2666":51561},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_3170":2038,"_27782":1986,"_19244":51563,"_5":13232,"_26277":51435,"_2666":51564},[],"RFC 5280: X.509 and CRL profile.",{"_3170":2039,"_27782":1986,"_19244":51566,"_5":13232,"_26277":51435,"_2666":51567},[],"OpenSSL: openssl-crl.",{"_3170":2040,"_27782":1986,"_19244":51569,"_5":13232,"_26277":51435,"_2666":51570},[],"OpenSSL: openssl-verify.",{"_3170":2041,"_27782":1986,"_19244":51572,"_5":13232,"_26277":51435,"_2666":51573},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3170":2042,"_27782":1986,"_19244":51575,"_5":13232,"_26277":51435,"_2666":51576},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3170":2043,"_27782":2043,"_5":13558,"_2666":51578,"_28124":51579,"_19244":51580,"_26277":2043},"Keys and cryptographic engines",[45194,46574,50270,50271],[],{"_3170":2044,"_27782":2043,"_19244":51582,"_5":13232,"_26277":2043,"_2666":51583},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3170":2045,"_27782":2043,"_5":28121,"_19244":51585,"_26277":51586,"_2666":51587},[],"/docs/pr-preview/pr-52/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3170":2046,"_27782":2043,"_5":28121,"_19244":51589,"_26277":51590,"_2666":51591},[],"/docs/pr-preview/pr-52/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3170":2047,"_27782":2043,"_5":28121,"_19244":51593,"_26277":51594,"_2666":51595},[],"/docs/pr-preview/pr-52/platform/pki/key-management#file-system","File System",{"_3170":2048,"_27782":2043,"_5":28121,"_19244":51597,"_26277":51598,"_2666":51599},[],"/docs/pr-preview/pr-52/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3170":2049,"_27782":2043,"_5":28121,"_19244":51601,"_26277":51602,"_2666":51603},[],"/docs/pr-preview/pr-52/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3170":2050,"_27782":2043,"_5":28121,"_19244":51605,"_26277":51606,"_2666":51607},[],"/docs/pr-preview/pr-52/platform/pki/key-management#aws-kms","AWS KMS",{"_3170":2051,"_27782":2043,"_5":28121,"_19244":51609,"_26277":51610,"_2666":51611},[],"/docs/pr-preview/pr-52/platform/pki/key-management#pkcs11","PKCS#11",{"_3170":2052,"_27782":2043,"_5":28121,"_19244":51613,"_26277":51614,"_2666":51615},[],"/docs/pr-preview/pr-52/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3170":2053,"_27782":2043,"_5":28121,"_19244":51617,"_26277":51618,"_2666":51619},[],"/docs/pr-preview/pr-52/platform/pki/key-management#key-inventory","Key inventory",{"_3170":2054,"_27782":2043,"_5":28121,"_19244":51621,"_26277":51622,"_2666":51623},[],"/docs/pr-preview/pr-52/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3170":2055,"_27782":2043,"_5":28121,"_19244":51625,"_26277":51626,"_2666":51627},[],"/docs/pr-preview/pr-52/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3170":2056,"_27782":2043,"_5":28121,"_19244":51629,"_26277":51630,"_2666":51631},[],"/docs/pr-preview/pr-52/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3170":2057,"_27782":2043,"_5":28121,"_19244":51633,"_26277":51634,"_2666":51635},[],"/docs/pr-preview/pr-52/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3170":2058,"_27782":2043,"_5":28121,"_19244":51637,"_26277":51638,"_2666":51639},[],"/docs/pr-preview/pr-52/platform/pki/key-management#view-details","View details",{"_3170":2059,"_27782":2043,"_5":28121,"_19244":51641,"_26277":51642,"_2666":51643},[],"/docs/pr-preview/pr-52/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3170":2060,"_27782":2043,"_5":28121,"_19244":51645,"_26277":51646,"_2666":51647},[],"/docs/pr-preview/pr-52/platform/pki/key-management#sign","Sign",{"_3170":2061,"_27782":2043,"_5":28121,"_19244":51649,"_26277":51650,"_2666":51651},[],"/docs/pr-preview/pr-52/platform/pki/key-management#verify","Verify",{"_3170":2062,"_27782":2043,"_5":28121,"_19244":51653,"_26277":51654,"_2666":51655},[],"/docs/pr-preview/pr-52/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3170":2063,"_27782":2043,"_5":28121,"_19244":51657,"_26277":51658,"_2666":51659},[],"/docs/pr-preview/pr-52/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3170":2064,"_27782":2043,"_5":28121,"_19244":51661,"_26277":51662,"_2666":51663},[],"/docs/pr-preview/pr-52/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3170":2065,"_27782":2043,"_19244":51665,"_5":13232,"_26277":2043,"_2666":51666},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3170":2066,"_27782":2043,"_19244":51668,"_5":13232,"_26277":2043,"_2666":51669},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3170":2067,"_27782":2043,"_19244":51671,"_5":13232,"_26277":51586,"_2666":51672},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3170":2068,"_27782":2043,"_19244":51674,"_5":13232,"_26277":51586,"_2666":51675},[],"In practice, it lets you:",{"_3170":2069,"_27782":2043,"_19244":51677,"_5":13232,"_26277":51586,"_2666":51678},[],"Generate new key pairs from Lamassu IoT.",{"_3170":2070,"_27782":2043,"_19244":51680,"_5":13232,"_26277":51586,"_2666":51681},[],"Import keys created externally.",{"_3170":2071,"_27782":2043,"_19244":51683,"_5":13232,"_26277":51586,"_2666":51684},[],"Delegate custody and cryptographic operations to external engines.",{"_3170":2072,"_27782":2043,"_19244":51686,"_5":13232,"_26277":51586,"_2666":51687},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3170":2073,"_27782":2043,"_19244":51689,"_5":13232,"_26277":51590,"_2666":51690},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3170":2074,"_27782":2043,"_19244":51692,"_5":13232,"_26277":51590,"_2666":51693},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3170":2075,"_27782":2043,"_19244":51695,"_5":13232,"_26277":51590,"_2666":51696},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3170":2076,"_27782":2043,"_19244":51698,"_5":13232,"_26277":51594,"_2666":51699},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3170":2077,"_27782":2043,"_19244":51701,"_5":13232,"_26277":51598,"_2666":51702},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3170":2078,"_27782":2043,"_19244":51704,"_5":13232,"_26277":51602,"_2666":51705},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3170":2079,"_27782":2043,"_19244":51707,"_5":13232,"_26277":51606,"_2666":51708},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3170":2080,"_27782":2043,"_19244":51710,"_5":13232,"_26277":51610,"_2666":51711},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3170":2081,"_27782":2043,"_19244":51713,"_5":13232,"_26277":51614,"_2666":51714},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3170":2082,"_27782":2043,"_19244":51716,"_5":13232,"_26277":51614,"_2666":51717},[],"Lamassu shows the enabled engines in the console.",{"_3170":2083,"_27782":2043,"_19244":51719,"_5":13232,"_26277":51614,"_2666":51720},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3170":2084,"_27782":2043,"_19244":51722,"_5":13232,"_26277":51614,"_2666":51723},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3170":2085,"_27782":2043,"_19244":51725,"_5":13232,"_26277":51618,"_2666":51726},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3170":2086,"_27782":2043,"_19244":51728,"_5":13232,"_26277":51618,"_2666":51729},[],"The table includes the following fields:",{"_3170":2087,"_27782":2043,"_19244":51731,"_5":13232,"_26277":51618,"_2666":51732},[],"**Name**: descriptive name of the key.",{"_3170":2088,"_27782":2043,"_19244":51734,"_5":13232,"_26277":51618,"_2666":51735},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3170":2089,"_27782":2043,"_19244":51737,"_5":13232,"_26277":51618,"_2666":51738},[],"**Strength**: visual indicator of cryptographic strength.",{"_3170":2090,"_27782":2043,"_19244":51740,"_5":13232,"_26277":51618,"_2666":51741},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3170":2091,"_27782":2043,"_19244":51743,"_5":13232,"_26277":51618,"_2666":51744},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3170":2092,"_27782":2043,"_19244":51746,"_5":13232,"_26277":51618,"_2666":51747},[],"**Aliases**: alternative names associated with the key.",{"_3170":2093,"_27782":2043,"_19244":51749,"_5":13232,"_26277":51618,"_2666":51750},[],"**Tags**: labels for classification and search.",{"_3170":2094,"_27782":2043,"_19244":51752,"_5":13232,"_26277":51618,"_2666":51753},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3170":2095,"_27782":2043,"_19244":51755,"_5":13232,"_26277":51618,"_2666":51756},[],"From this view you also reach the most common actions:",{"_3170":2096,"_27782":2043,"_19244":51758,"_5":13232,"_26277":51618,"_2666":51759},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3170":2097,"_27782":2043,"_19244":51761,"_5":13232,"_26277":51618,"_2666":51762},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3170":2098,"_27782":2043,"_19244":51764,"_5":13232,"_26277":51618,"_2666":51765},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3170":2099,"_27782":2043,"_19244":51767,"_5":13232,"_26277":51618,"_2666":51768},[],"**Delete Key** to remove the key from the system.",{"_3170":2100,"_27782":2043,"_19244":51770,"_5":13232,"_26277":51622,"_2666":51771},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3170":2101,"_27782":2043,"_19244":51773,"_5":13232,"_26277":51626,"_2666":51774},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3170":2102,"_27782":2043,"_19244":51776,"_5":13232,"_26277":51626,"_2666":51777},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3170":2103,"_27782":2043,"_19244":51779,"_5":13232,"_26277":51626,"_2666":51780},[],"**Key Name**: unique and descriptive name.",{"_3170":2104,"_27782":2043,"_19244":51782,"_5":13232,"_26277":51626,"_2666":51783},[],"**Crypto Engine**: engine that will keep the key.",{"_3170":2105,"_27782":2043,"_19244":51785,"_5":13232,"_26277":51626,"_2666":51786},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3170":2106,"_27782":2043,"_19244":51788,"_5":13232,"_26277":51626,"_2666":51789},[],"**Tags**: metadata to classify the key.",{"_3170":2107,"_27782":2043,"_19244":51791,"_5":13232,"_26277":51626,"_2666":51792},[],"**Metadata**: additional information for advanced uses.",{"_3170":2108,"_27782":2043,"_19244":51794,"_5":13232,"_26277":51630,"_2666":51795},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3170":2109,"_27782":2043,"_19244":51797,"_5":13232,"_26277":51630,"_2666":51798},[],"When you have an exportable private key and the destination engine supports import.",{"_3170":2110,"_27782":2043,"_19244":51800,"_5":13232,"_26277":51630,"_2666":51801},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3170":2111,"_27782":2043,"_19244":51803,"_5":13232,"_26277":51630,"_2666":51804},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3170":2112,"_27782":2043,"_19244":51806,"_5":13232,"_26277":51630,"_2666":51807},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3170":2113,"_27782":2043,"_19244":51809,"_5":13232,"_26277":51630,"_2666":51810},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3170":2114,"_27782":2043,"_19244":51812,"_5":13232,"_26277":51630,"_2666":51813},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3170":2115,"_27782":2043,"_19244":51815,"_5":13232,"_26277":51630,"_2666":51816},[],"**Tags**: labels for organization and search.",{"_3170":2116,"_27782":2043,"_19244":51818,"_5":13232,"_26277":51630,"_2666":51819},[],"**Metadata**: additional optional information.",{"_3170":2117,"_27782":2043,"_19244":51821,"_5":13232,"_26277":51630,"_2666":51822},[],"**Private Key (PEM)**: private key in PEM format.",{"_3170":2118,"_27782":2043,"_19244":51824,"_5":13232,"_26277":51630,"_2666":51825},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3170":2119,"_27782":2043,"_19244":51827,"_5":13232,"_26277":51634,"_2666":51828},[],"Each registered key has a detail view and several operational actions.",{"_3170":2120,"_27782":2043,"_19244":51830,"_5":13232,"_26277":51638,"_2666":51831},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3170":2121,"_27782":2043,"_19244":51833,"_5":13232,"_26277":51638,"_2666":51834},[],"The **Overview** tab shows, among others, these fields:",{"_3170":2122,"_27782":2043,"_19244":51836,"_5":13232,"_26277":51638,"_2666":51837},[],"**Key Name**: descriptive name.",{"_3170":2123,"_27782":2043,"_19244":51839,"_5":13232,"_26277":51638,"_2666":51840},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3170":2124,"_27782":2043,"_19244":51842,"_5":13232,"_26277":51638,"_2666":51843},[],"**Tags**: associated labels.",{"_3170":2125,"_27782":2043,"_19244":51845,"_5":13232,"_26277":51638,"_2666":51846},[],"**Aliases**: alternative names.",{"_3170":2126,"_27782":2043,"_19244":51848,"_5":13232,"_26277":51638,"_2666":51849},[],"**Crypto Engine**: engine where the key resides.",{"_3170":2127,"_27782":2043,"_19244":51851,"_5":13232,"_26277":51638,"_2666":51852},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3170":2128,"_27782":2043,"_19244":51854,"_5":13232,"_26277":51638,"_2666":51855},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3170":2129,"_27782":2043,"_19244":51857,"_5":13232,"_26277":51638,"_2666":51858},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3170":2130,"_27782":2043,"_19244":51860,"_5":13232,"_26277":51642,"_2666":51861},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3170":2131,"_27782":2043,"_19244":51863,"_5":13232,"_26277":51642,"_2666":51864},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3170":2132,"_27782":2043,"_19244":51866,"_5":13232,"_26277":51642,"_2666":51867},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3170":2133,"_27782":2043,"_19244":51869,"_5":13232,"_26277":51646,"_2666":51870},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3170":2134,"_27782":2043,"_19244":51872,"_5":13232,"_26277":51646,"_2666":51873},[],"Main fields:",{"_3170":2135,"_27782":2043,"_19244":51875,"_5":13232,"_26277":51646,"_2666":51876},[],"**Algorithm**: signing algorithm available for the key type.",{"_3170":2136,"_27782":2043,"_19244":51878,"_5":13232,"_26277":51646,"_2666":51879},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3170":2137,"_27782":2043,"_19244":51881,"_5":13232,"_26277":51646,"_2666":51882},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3170":2138,"_27782":2043,"_19244":51884,"_5":13232,"_26277":51646,"_2666":51885},[],"**Message**: content to sign.",{"_3170":2139,"_27782":2043,"_19244":51887,"_5":13232,"_26277":51646,"_2666":51888},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3170":2140,"_27782":2043,"_19244":51890,"_5":13232,"_26277":51650,"_2666":51891},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3170":2141,"_27782":2043,"_19244":51893,"_5":13232,"_26277":51650,"_2666":51873},[],{"_3170":2142,"_27782":2043,"_19244":51895,"_5":13232,"_26277":51650,"_2666":51896},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3170":2143,"_27782":2043,"_19244":51898,"_5":13232,"_26277":51650,"_2666":51899},[],"**Message Type**: `Raw` or `Digest`.",{"_3170":2144,"_27782":2043,"_19244":51901,"_5":13232,"_26277":51650,"_2666":51902},[],"**Payload Encoding**: encoding of the message.",{"_3170":2145,"_27782":2043,"_19244":51904,"_5":13232,"_26277":51650,"_2666":51905},[],"**Message**: original message or hash.",{"_3170":2146,"_27782":2043,"_19244":51907,"_5":13232,"_26277":51650,"_2666":51908},[],"**Signature**: signature to check.",{"_3170":2147,"_27782":2043,"_19244":51910,"_5":13232,"_26277":51650,"_2666":51911},[],"**Result**: indicator of the validation result.",{"_3170":2148,"_27782":2043,"_19244":51913,"_5":13232,"_26277":51654,"_2666":51914},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3170":2149,"_27782":2043,"_19244":51916,"_5":13232,"_26277":51654,"_2666":51917},[],"This flow is useful for:",{"_3170":2150,"_27782":2043,"_19244":51919,"_5":13232,"_26277":51654,"_2666":51920},[],"Requesting certificates from an external CA.",{"_3170":2151,"_27782":2043,"_19244":51922,"_5":13232,"_26277":51654,"_2666":51923},[],"Renewing an identity while keeping the same key.",{"_3170":2152,"_27782":2043,"_19244":51925,"_5":13232,"_26277":51654,"_2666":51926},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3170":2153,"_27782":2043,"_19244":51928,"_5":13232,"_26277":51654,"_2666":51929},[],"**Common Name (CN)**: main name of the identity.",{"_3170":2154,"_27782":2043,"_19244":51931,"_5":13232,"_26277":51654,"_2666":51932},[],"**Organization (O)**: organization or company.",{"_3170":2155,"_27782":2043,"_19244":51934,"_5":13232,"_26277":51654,"_2666":51935},[],"**Organizational Unit (OU)**: department or unit.",{"_3170":2156,"_27782":2043,"_19244":51937,"_5":13232,"_26277":51654,"_2666":51938},[],"**Country (C)**: two-letter country code.",{"_3170":2157,"_27782":2043,"_19244":51940,"_5":13232,"_26277":51654,"_2666":51941},[],"**State / Province (ST)**: state or province.",{"_3170":2158,"_27782":2043,"_19244":51943,"_5":13232,"_26277":51654,"_2666":51944},[],"**Locality (L)**: city or locality.",{"_3170":2159,"_27782":2043,"_19244":51946,"_5":13232,"_26277":51654,"_2666":51947},[],"**Email Address**: contact email.",{"_3170":2160,"_27782":2043,"_19244":51949,"_5":13232,"_26277":51654,"_2666":51950},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3170":2161,"_27782":2043,"_19244":51952,"_5":13232,"_26277":51654,"_2666":51953},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3170":2162,"_27782":2043,"_19244":51955,"_5":13232,"_26277":51658,"_2666":51956},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3170":2163,"_27782":2043,"_19244":51958,"_5":13232,"_26277":51658,"_2666":51959},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3170":2164,"_27782":2043,"_19244":51961,"_5":13232,"_26277":51662,"_2666":51962},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3170":2165,"_27782":2043,"_19244":51964,"_5":13232,"_26277":51662,"_2666":51965},[],"Note that the KMS refuses to delete a key that certificates still reference. The reference is released when the CA that owns those certificates is deleted; alternatively, you can keep the key deliberately.",{"_3170":2166,"_27782":2166,"_5":13558,"_2666":51967,"_28124":51968,"_19244":51969,"_26277":2166},"Online validation with OCSP",[45194,46574,50270,50890],[],{"_3170":2167,"_27782":2166,"_19244":51971,"_5":13232,"_26277":2166,"_2666":51972},[],"Query signed status and verify the responder’s response.",{"_3170":2168,"_27782":2166,"_5":28121,"_19244":51974,"_26277":51975,"_2666":51976},[],"/docs/pr-preview/pr-52/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3170":2169,"_27782":2166,"_5":28121,"_19244":51978,"_26277":51979,"_2666":51980},[],"/docs/pr-preview/pr-52/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3170":2170,"_27782":2166,"_5":28121,"_19244":51982,"_26277":51983,"_2666":51984},[],"/docs/pr-preview/pr-52/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3170":2171,"_27782":2166,"_5":28121,"_19244":51986,"_26277":51987,"_2666":51988},[],"/docs/pr-preview/pr-52/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3170":2172,"_27782":2166,"_5":28121,"_19244":51990,"_26277":51991,"_2666":51992},[],"/docs/pr-preview/pr-52/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3170":2173,"_27782":2166,"_5":28121,"_19244":51994,"_26277":51995,"_2666":51436},[],"/docs/pr-preview/pr-52/platform/pki/ocsp#references",{"_3170":2174,"_27782":2166,"_19244":51997,"_5":13232,"_26277":2166,"_2666":51998},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3170":2175,"_27782":2166,"_19244":52000,"_5":13232,"_26277":51975,"_2666":52001},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3170":2176,"_27782":2166,"_19244":52003,"_5":13232,"_26277":51975,"_2666":52004},[],"Record status",{"_3170":2177,"_27782":2166,"_19244":52006,"_5":13232,"_26277":51975,"_2666":52007},[],"Signed response",{"_3170":2178,"_27782":2166,"_19244":52009,"_5":13232,"_26277":51975,"_2666":49448},[],{"_3170":2179,"_27782":2166,"_19244":52011,"_5":13232,"_26277":51975,"_2666":52012},[],"`Good`.",{"_3170":2180,"_27782":2166,"_19244":52014,"_5":13232,"_26277":51975,"_2666":49465},[],{"_3170":2181,"_27782":2166,"_19244":52016,"_5":13232,"_26277":51975,"_2666":52017},[],"`Revoked`, with revocation reason and timestamp.",{"_3170":2182,"_27782":2166,"_19244":52019,"_5":13232,"_26277":51975,"_2666":52020},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3170":2183,"_27782":2166,"_19244":52022,"_5":13232,"_26277":51975,"_2666":52023},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3170":2184,"_27782":2166,"_19244":52025,"_5":13232,"_26277":51975,"_2666":52026},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3170":2185,"_27782":2166,"_19244":52028,"_5":13232,"_26277":51975,"_2666":52029},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3170":2186,"_27782":2166,"_19244":52031,"_5":13232,"_26277":51975,"_2666":52032},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3170":2187,"_27782":2166,"_19244":52034,"_5":13232,"_26277":51979,"_2666":52035},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3170":2188,"_27782":2166,"_19244":52037,"_5":13232,"_26277":51979,"_2666":52038},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3170":2189,"_27782":2166,"_19244":52040,"_5":13232,"_26277":51983,"_2666":52041},[],"The service accepts:",{"_3170":2190,"_27782":2166,"_19244":52043,"_5":13232,"_26277":51983,"_2666":48301},[],{"_3170":2191,"_27782":2166,"_19244":52045,"_5":13232,"_26277":51983,"_2666":52046},[],"VA service path",{"_3170":2192,"_27782":2166,"_19244":52048,"_5":13232,"_26277":51983,"_2666":52049},[],"Format",{"_3170":2193,"_27782":2166,"_19244":52051,"_5":13232,"_26277":51983,"_2666":52052},[],"`POST`",{"_3170":2194,"_27782":2166,"_19244":52054,"_5":13232,"_26277":51983,"_2666":52055},[],"`/ocsp`",{"_3170":2195,"_27782":2166,"_19244":52057,"_5":13232,"_26277":51983,"_2666":52058},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3170":2196,"_27782":2166,"_19244":52060,"_5":13232,"_26277":51983,"_2666":51538},[],{"_3170":2197,"_27782":2166,"_19244":52062,"_5":13232,"_26277":51983,"_2666":52063},[],"`/ocsp/{ocsp_request}`",{"_3170":2198,"_27782":2166,"_19244":52065,"_5":13232,"_26277":51983,"_2666":52066},[],"DER request encoded using padded URL Base64.",{"_3170":2199,"_27782":2166,"_19244":52068,"_5":13232,"_26277":51983,"_2666":52069},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3170":2200,"_27782":2166,"_19244":52071,"_5":13232,"_26277":51987,"_2666":52072},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3170":2201,"_27782":2166,"_19244":52074,"_5":13232,"_26277":51987,"_2666":52075},[],"Generate the request:",{"_3170":2202,"_27782":2166,"_19244":52077,"_5":13232,"_26277":51987,"_2666":52078},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3170":2203,"_27782":2166,"_19244":52080,"_5":13232,"_26277":51987,"_2666":52081},[],"Replace the example URL with the inspected endpoint:",{"_3170":2204,"_27782":2166,"_19244":52083,"_5":13232,"_26277":51987,"_2666":52084},[],"Verify the returned DER:",{"_3170":2205,"_27782":2166,"_19244":52086,"_5":13232,"_26277":51987,"_2666":52087},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3170":2206,"_27782":2166,"_19244":52089,"_5":13232,"_26277":51991,"_2666":52090},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3170":2207,"_27782":2166,"_19244":52092,"_5":13232,"_26277":51991,"_2666":52093},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3170":2208,"_27782":2166,"_19244":52095,"_5":13232,"_26277":51995,"_2666":52096},[],"RFC 6960: OCSP.",{"_3170":2209,"_27782":2166,"_19244":52098,"_5":13232,"_26277":51995,"_2666":52099},[],"OpenSSL: openssl-ocsp.",{"_3170":2210,"_27782":2166,"_19244":52101,"_5":13232,"_26277":51995,"_2666":52102},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3170":2211,"_27782":2166,"_19244":52104,"_5":13232,"_26277":51995,"_2666":51576},[],{"_3170":2212,"_27782":2212,"_5":13558,"_2666":50270,"_28124":52106,"_19244":52107,"_26277":2212},[45194,46574,50270],[],{"_3170":2213,"_27782":2212,"_19244":52109,"_5":13232,"_26277":2212,"_2666":52110},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3170":2214,"_27782":2212,"_5":28121,"_19244":52112,"_26277":52113,"_2666":49580},[],"/docs/pr-preview/pr-52/platform/pki/overview#start-here",{"_3170":2215,"_27782":2212,"_5":28121,"_19244":52115,"_26277":52116,"_2666":52117},[],"/docs/pr-preview/pr-52/platform/pki/overview#what-you-need","What you need",{"_3170":2216,"_27782":2212,"_5":28121,"_19244":52119,"_26277":52120,"_2666":50114},[],"/docs/pr-preview/pr-52/platform/pki/overview#core-capabilities",{"_3170":2217,"_27782":2212,"_5":28121,"_19244":52122,"_26277":52123,"_2666":50118},[],"/docs/pr-preview/pr-52/platform/pki/overview#build-your-trust-hierarchy",{"_3170":2218,"_27782":2212,"_5":28121,"_19244":52125,"_26277":52126,"_2666":50122},[],"/docs/pr-preview/pr-52/platform/pki/overview#protect-cryptographic-keys",{"_3170":2219,"_27782":2212,"_5":28121,"_19244":52128,"_26277":52129,"_2666":50126},[],"/docs/pr-preview/pr-52/platform/pki/overview#issue-and-control-certificates",{"_3170":2220,"_27782":2212,"_5":28121,"_19244":52131,"_26277":52132,"_2666":50134},[],"/docs/pr-preview/pr-52/platform/pki/overview#publish-validation-status",{"_3170":2221,"_27782":2212,"_5":28121,"_19244":52134,"_26277":52135,"_2666":52136},[],"/docs/pr-preview/pr-52/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3170":2222,"_27782":2212,"_5":28121,"_19244":52138,"_26277":52139,"_2666":51057},[],"/docs/pr-preview/pr-52/platform/pki/overview#continue",{"_3170":2223,"_27782":2212,"_19244":52141,"_5":13232,"_26277":2212,"_2666":52142},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3170":2224,"_27782":2212,"_19244":52144,"_5":13232,"_26277":52113,"_2666":52145},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3170":2225,"_27782":2212,"_19244":52147,"_5":13232,"_26277":52113,"_2666":52148},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3170":2226,"_27782":2212,"_19244":52150,"_5":13232,"_26277":52116,"_2666":52151},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3170":2227,"_27782":2212,"_19244":52153,"_5":13232,"_26277":52116,"_2666":52154},[],"An available cryptographic engine to keep the authority's key.",{"_3170":2228,"_27782":2212,"_19244":52156,"_5":13232,"_26277":52116,"_2666":52157},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3170":2229,"_27782":2212,"_19244":52159,"_5":13232,"_26277":52116,"_2666":52160},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3170":2230,"_27782":2212,"_19244":52162,"_5":13232,"_26277":52116,"_2666":52163},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3170":2231,"_27782":2212,"_19244":52165,"_5":13232,"_26277":52123,"_2666":52166},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3170":2232,"_27782":2212,"_19244":52168,"_5":13232,"_26277":52126,"_2666":52169},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3170":2233,"_27782":2212,"_19244":52171,"_5":13232,"_26277":52129,"_2666":52172},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3170":2234,"_27782":2212,"_19244":52174,"_5":13232,"_26277":52132,"_2666":52175},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3170":2235,"_27782":2212,"_19244":52177,"_5":13232,"_26277":52135,"_2666":52178},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3170":2236,"_27782":2212,"_19244":52180,"_5":13232,"_26277":52135,"_2666":52181},[],"its subject and extensions identify the expected client;",{"_3170":2237,"_27782":2212,"_19244":52183,"_5":13232,"_26277":52135,"_2666":52184},[],"its public key matches the client's private key;",{"_3170":2238,"_27782":2212,"_19244":52186,"_5":13232,"_26277":52135,"_2666":52187},[],"its chain reaches a root trusted by the consumer;",{"_3170":2239,"_27782":2212,"_19244":52189,"_5":13232,"_26277":52135,"_2666":52190},[],"its dates and usages allow the operation;",{"_3170":2240,"_27782":2212,"_19244":52192,"_5":13232,"_26277":52135,"_2666":52193},[],"the consumer applies revocation checks and authorization.",{"_3170":2241,"_27782":2212,"_19244":52195,"_5":13232,"_26277":52135,"_2666":52196},[],"The issuance path includes the first independent checks.",{"_3170":2242,"_27782":2212,"_19244":52198,"_5":13232,"_26277":52139,"_2666":52199},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3170":2243,"_27782":2212,"_19244":52201,"_5":13232,"_26277":52139,"_2666":52202},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3170":2244,"_27782":2212,"_19244":52204,"_5":13232,"_26277":52139,"_2666":52205},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3170":2245,"_27782":2245,"_5":13558,"_2666":52207,"_28124":52208,"_19244":52209,"_26277":2245},"Create your first CA",[45194,46574,50270,49705],[],{"_3170":2246,"_27782":2245,"_19244":52211,"_5":13232,"_26277":2245,"_2666":52212},[],"Create an evaluation root and check its certificate before issuing.",{"_3170":2247,"_27782":2245,"_5":28121,"_19244":52214,"_26277":52215,"_2666":45204},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3170":2248,"_27782":2245,"_5":28121,"_19244":52217,"_26277":52218,"_2666":52219},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_3170":2249,"_27782":2245,"_5":28121,"_19244":52221,"_26277":52222,"_2666":52223},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_3170":2250,"_27782":2245,"_5":28121,"_19244":52225,"_26277":52226,"_2666":52227},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_3170":2251,"_27782":2245,"_5":28121,"_19244":52229,"_26277":52230,"_2666":52231},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_3170":2252,"_27782":2245,"_5":28121,"_19244":52233,"_26277":52234,"_2666":52235},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_3170":2253,"_27782":2245,"_5":28121,"_19244":52237,"_26277":52238,"_2666":52239},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3170":2254,"_27782":2245,"_5":28121,"_19244":52241,"_26277":52242,"_2666":49963},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3170":2255,"_27782":2245,"_5":28121,"_19244":52244,"_26277":52245,"_2666":45228},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3170":2256,"_27782":2245,"_19244":52247,"_5":13232,"_26277":2245,"_2666":52248},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3170":2257,"_27782":2245,"_19244":52250,"_5":13232,"_26277":52215,"_2666":52251},[],"Console access and permission to create keys and authorities.",{"_3170":2258,"_27782":2245,"_19244":52253,"_5":13232,"_26277":52215,"_2666":52254},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3170":2259,"_27782":2245,"_19244":52256,"_5":13232,"_26277":52215,"_2666":52257},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3170":2260,"_27782":2245,"_19244":52259,"_5":13232,"_26277":52215,"_2666":52260},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3170":2261,"_27782":2245,"_19244":52262,"_5":13232,"_26277":52218,"_2666":52263},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3170":2262,"_27782":2245,"_19244":52265,"_5":13232,"_26277":52218,"_2666":52266},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3170":2263,"_27782":2245,"_19244":52268,"_5":13232,"_26277":52222,"_2666":52269},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3170":2264,"_27782":2245,"_19244":52271,"_5":13232,"_26277":52222,"_2666":52272},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3170":2265,"_27782":2245,"_19244":52274,"_5":13232,"_26277":52226,"_2666":52275},[],"Select **Root CA** and complete:",{"_3170":2266,"_27782":2245,"_19244":52277,"_5":13232,"_26277":52226,"_2666":52278},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3170":2267,"_27782":2245,"_19244":52280,"_5":13232,"_26277":52226,"_2666":52281},[],"**Subject**: organization and country details for your evaluation.",{"_3170":2268,"_27782":2245,"_19244":52283,"_5":13232,"_26277":52226,"_2666":52284},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3170":2269,"_27782":2245,"_19244":52286,"_5":13232,"_26277":52226,"_2666":52287},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3170":2270,"_27782":2245,"_19244":52289,"_5":13232,"_26277":52226,"_2666":52290},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3170":2271,"_27782":2245,"_19244":52292,"_5":13232,"_26277":52230,"_2666":52293},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3170":2272,"_27782":2245,"_19244":52295,"_5":13232,"_26277":52234,"_2666":52296},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3170":2273,"_27782":2245,"_19244":52298,"_5":13232,"_26277":52234,"_2666":52299},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3170":2274,"_27782":2245,"_19244":52301,"_5":13232,"_26277":52238,"_2666":52302},[],"Run from the directory where you saved `ca.pem`:",{"_3170":2275,"_27782":2245,"_19244":52304,"_5":13232,"_26277":52238,"_2666":52305},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3170":2276,"_27782":2245,"_19244":52307,"_5":13232,"_26277":52238,"_2666":52308},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3170":2277,"_27782":2245,"_19244":52310,"_5":13232,"_26277":52242,"_2666":52311},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3170":2278,"_27782":2245,"_19244":52313,"_5":13232,"_26277":52242,"_2666":52314},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3170":2279,"_27782":2245,"_19244":52316,"_5":13232,"_26277":52242,"_2666":52317},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3170":2280,"_27782":2245,"_19244":52319,"_5":13232,"_26277":52242,"_2666":52320},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3170":2281,"_27782":2245,"_19244":52322,"_5":13232,"_26277":52245,"_2666":52323},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3170":2282,"_27782":2282,"_5":13558,"_2666":52325,"_28124":52326,"_19244":52327,"_26277":2282},"Issue and verify a certificate",[45194,46574,50270,49705],[],{"_3170":2283,"_27782":2282,"_19244":52329,"_5":13232,"_26277":2282,"_2666":52330},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3170":2284,"_27782":2282,"_5":28121,"_19244":52332,"_26277":52333,"_2666":45204},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3170":2285,"_27782":2282,"_5":28121,"_19244":52335,"_26277":52336,"_2666":52337},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3170":2286,"_27782":2282,"_5":28121,"_19244":52339,"_26277":52340,"_2666":52341},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3170":2287,"_27782":2282,"_5":28121,"_19244":52343,"_26277":52344,"_2666":52345},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3170":2288,"_27782":2282,"_5":28121,"_19244":52347,"_26277":52348,"_2666":52349},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3170":2289,"_27782":2282,"_5":28121,"_19244":52351,"_26277":52352,"_2666":52353},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3170":2290,"_27782":2282,"_5":28121,"_19244":52355,"_26277":52356,"_2666":52235},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_3170":2291,"_27782":2282,"_5":28121,"_19244":52358,"_26277":52359,"_2666":52360},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3170":2292,"_27782":2282,"_5":28121,"_19244":52362,"_26277":52363,"_2666":52364},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3170":2293,"_27782":2282,"_5":28121,"_19244":52366,"_26277":52367,"_2666":52368},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3170":2294,"_27782":2282,"_5":28121,"_19244":52370,"_26277":52371,"_2666":49963},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3170":2295,"_27782":2282,"_5":28121,"_19244":52373,"_26277":52374,"_2666":45228},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#next-step",{"_3170":2296,"_27782":2282,"_19244":52376,"_5":13232,"_26277":2282,"_2666":52377},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3170":2297,"_27782":2282,"_19244":52379,"_5":13232,"_26277":52333,"_2666":52380},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3170":2298,"_27782":2282,"_19244":52382,"_5":13232,"_26277":52333,"_2666":52383},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3170":2299,"_27782":2282,"_19244":52385,"_5":13232,"_26277":52333,"_2666":52386},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3170":2300,"_27782":2282,"_19244":52388,"_5":13232,"_26277":52333,"_2666":52389},[],"A client identifier: here we use `device-001`.",{"_3170":2301,"_27782":2282,"_19244":52391,"_5":13232,"_26277":52333,"_2666":52392},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3170":2302,"_27782":2282,"_19244":52394,"_5":13232,"_26277":52336,"_2666":52395},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3170":2303,"_27782":2282,"_19244":52397,"_5":13232,"_26277":52340,"_2666":52398},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3170":2304,"_27782":2282,"_19244":52400,"_5":13232,"_26277":52340,"_2666":52401},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3170":2305,"_27782":2282,"_19244":52403,"_5":13232,"_26277":52344,"_2666":52404},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3170":2306,"_27782":2282,"_19244":52406,"_5":13232,"_26277":52344,"_2666":52407},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3170":2307,"_27782":2282,"_19244":52409,"_5":13232,"_26277":52348,"_2666":52410},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3170":2308,"_27782":2282,"_19244":52412,"_5":13232,"_26277":52348,"_2666":52413},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3170":2309,"_27782":2282,"_19244":52415,"_5":13232,"_26277":52352,"_2666":52416},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3170":2310,"_27782":2282,"_19244":52418,"_5":13232,"_26277":52356,"_2666":52419},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3170":2311,"_27782":2282,"_19244":52421,"_5":13232,"_26277":52359,"_2666":52422},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3170":2312,"_27782":2282,"_19244":52424,"_5":13232,"_26277":52363,"_2666":52425},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3170":2313,"_27782":2282,"_19244":52427,"_5":13232,"_26277":52363,"_2666":52428},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3170":2314,"_27782":2282,"_19244":52430,"_5":13232,"_26277":52363,"_2666":52431},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3170":2315,"_27782":2282,"_19244":52433,"_5":13232,"_26277":52367,"_2666":52434},[],"In Bash, compare the two public-key digests:",{"_3170":2316,"_27782":2282,"_19244":52436,"_5":13232,"_26277":52367,"_2666":52437},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3170":2317,"_27782":2282,"_19244":52439,"_5":13232,"_26277":52367,"_2666":52440},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3170":2318,"_27782":2282,"_19244":52442,"_5":13232,"_26277":52371,"_2666":50047},[],{"_3170":2319,"_27782":2282,"_19244":52444,"_5":13232,"_26277":52371,"_2666":52445},[],"What to review",{"_3170":2320,"_27782":2282,"_19244":52447,"_5":13232,"_26277":52371,"_2666":52448},[],"The CA rejects issuance",{"_3170":2321,"_27782":2282,"_19244":52450,"_5":13232,"_26277":52371,"_2666":52451},[],"Permissions, CA state and key, algorithm and profile.",{"_3170":2322,"_27782":2282,"_19244":52453,"_5":13232,"_26277":52371,"_2666":52454},[],"Different subject or usages",{"_3170":2323,"_27782":2282,"_19244":52456,"_5":13232,"_26277":52371,"_2666":52457},[],"Applied profile and requested values.",{"_3170":2324,"_27782":2282,"_19244":52459,"_5":13232,"_26277":52371,"_2666":52460},[],"Issuer cannot be found",{"_3170":2325,"_27782":2282,"_19244":52462,"_5":13232,"_26277":52371,"_2666":52463},[],"Downloaded CA and required intermediate chain.",{"_3170":2326,"_27782":2282,"_19244":52465,"_5":13232,"_26277":52371,"_2666":52466},[],"Validity fails",{"_3170":2327,"_27782":2282,"_19244":52468,"_5":13232,"_26277":52371,"_2666":52469},[],"Certificate and CA dates, and the computer's clock.",{"_3170":2328,"_27782":2282,"_19244":52471,"_5":13232,"_26277":52371,"_2666":52472},[],"Public-key digests differ",{"_3170":2329,"_27782":2282,"_19244":52474,"_5":13232,"_26277":52371,"_2666":52475},[],"Certificate and key files from the same issuance.",{"_3170":2330,"_27782":2282,"_19244":52477,"_5":13232,"_26277":52371,"_2666":52478},[],"See PKI diagnostics to narrow an issuance failure.",{"_3170":2331,"_27782":2282,"_19244":52480,"_5":13232,"_26277":52374,"_2666":52481},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3170":2332,"_27782":2282,"_19244":52483,"_5":13232,"_26277":52374,"_2666":52484},[],"Manage certificates for inspection, status and revocation.",{"_3170":2333,"_27782":2282,"_19244":52486,"_5":13232,"_26277":52374,"_2666":52487},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3170":2334,"_27782":2282,"_19244":52489,"_5":13232,"_26277":52374,"_2666":52490},[],"Prepare EST for the device to request its next identities.",{"_3170":2335,"_27782":2282,"_19244":52492,"_5":13232,"_26277":52374,"_2666":52493},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3170":2336,"_27782":2336,"_5":13558,"_2666":52495,"_28124":52496,"_19244":52497,"_26277":2336},"PKI getting started",[45194,46574,50270,49705],[],{"_3170":2337,"_27782":2336,"_19244":52499,"_5":13232,"_26277":2336,"_2666":52500},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3170":2338,"_27782":2336,"_5":28121,"_19244":52502,"_26277":52503,"_2666":45204},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/overview#before-you-begin",{"_3170":2339,"_27782":2336,"_5":28121,"_19244":52505,"_26277":52506,"_2666":52507},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3170":2340,"_27782":2336,"_5":28121,"_19244":52509,"_26277":52510,"_2666":49897},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/overview#expected-result",{"_3170":2341,"_27782":2336,"_5":28121,"_19244":52512,"_26277":52513,"_2666":52514},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3170":2342,"_27782":2336,"_19244":52516,"_5":13232,"_26277":2336,"_2666":52517},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3170":2343,"_27782":2336,"_19244":52519,"_5":13232,"_26277":52503,"_2666":52520},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3170":2344,"_27782":2336,"_19244":52522,"_5":13232,"_26277":52503,"_2666":52523},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3170":2345,"_27782":2336,"_19244":52525,"_5":13232,"_26277":52503,"_2666":52526},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3170":2346,"_27782":2336,"_19244":52528,"_5":13232,"_26277":52503,"_2666":52529},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3170":2347,"_27782":2336,"_19244":52531,"_5":13232,"_26277":52503,"_2666":52532},[],"A working directory with restricted access for the downloaded key.",{"_3170":2348,"_27782":2336,"_19244":52534,"_5":13232,"_26277":52506,"_2666":52535},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3170":2349,"_27782":2336,"_19244":52537,"_5":13232,"_26277":52506,"_2666":52538},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3170":2350,"_27782":2336,"_19244":52540,"_5":13232,"_26277":52506,"_2666":52541},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3170":2351,"_27782":2336,"_19244":52543,"_5":13232,"_26277":52506,"_2666":52544},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3170":2352,"_27782":2336,"_19244":52546,"_5":13232,"_26277":52510,"_2666":52547},[],"File or resource",{"_3170":2353,"_27782":2336,"_19244":52549,"_5":13232,"_26277":52510,"_2666":49894},[],{"_3170":2354,"_27782":2336,"_19244":52551,"_5":13232,"_26277":52510,"_2666":52552},[],"Active root CA and `ca.pem`",{"_3170":2355,"_27782":2336,"_19244":52554,"_5":13232,"_26277":52510,"_2666":52555},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3170":2356,"_27782":2336,"_19244":52557,"_5":13232,"_26277":52510,"_2666":52558},[],"End-entity certificate and `device.crt`",{"_3170":2357,"_27782":2336,"_19244":52560,"_5":13232,"_26277":52510,"_2666":52561},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3170":2358,"_27782":2336,"_19244":52563,"_5":13232,"_26277":52510,"_2666":52564},[],"Private key `device.key`",{"_3170":2359,"_27782":2336,"_19244":52566,"_5":13232,"_26277":52510,"_2666":52567},[],"Its public key matches the one included in `device.crt`.",{"_3170":2360,"_27782":2336,"_19244":52569,"_5":13232,"_26277":52510,"_2666":52570},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3170":2361,"_27782":2336,"_19244":52572,"_5":13232,"_26277":52513,"_2666":52573},[],"To operate certificates, continue with Certificates and Validation.",{"_3170":2362,"_27782":2336,"_19244":52575,"_5":13232,"_26277":52513,"_2666":52576},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3170":2363,"_27782":2336,"_19244":52578,"_5":13232,"_26277":52513,"_2666":52579},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3170":2364,"_27782":2364,"_5":13558,"_2666":52581,"_28124":52582,"_19244":52583,"_26277":2364},"PKI troubleshooting",[45194,46574,50270,49091],[],{"_3170":2365,"_27782":2364,"_19244":52585,"_5":13232,"_26277":2364,"_2666":52586},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3170":2366,"_27782":2364,"_5":28121,"_19244":52588,"_26277":52589,"_2666":52590},[],"/docs/pr-preview/pr-52/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3170":2367,"_27782":2364,"_5":28121,"_19244":52592,"_26277":52593,"_2666":52594},[],"/docs/pr-preview/pr-52/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3170":2368,"_27782":2364,"_5":28121,"_19244":52596,"_26277":52597,"_2666":52598},[],"/docs/pr-preview/pr-52/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3170":2369,"_27782":2364,"_19244":52600,"_5":13232,"_26277":2364,"_2666":52601},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3170":2370,"_27782":2364,"_19244":52603,"_5":13232,"_26277":2364,"_2666":52604},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3170":2371,"_27782":2364,"_19244":52606,"_5":13232,"_26277":52589,"_2666":49894},[],{"_3170":2372,"_27782":2364,"_19244":52608,"_5":13232,"_26277":52589,"_2666":52609},[],"What to inspect",{"_3170":2373,"_27782":2364,"_19244":52611,"_5":13232,"_26277":52589,"_2666":45228},[],{"_3170":2374,"_27782":2364,"_19244":52613,"_5":13232,"_26277":52589,"_2666":52614},[],"CA",{"_3170":2375,"_27782":2364,"_19244":52616,"_5":13232,"_26277":52589,"_2666":52617},[],"Exists, is active and has usable dates.",{"_3170":2376,"_27782":2364,"_19244":52619,"_5":13232,"_26277":52589,"_2666":52620},[],"Authorities.",{"_3170":2377,"_27782":2364,"_19244":52622,"_5":13232,"_26277":52589,"_2666":52623},[],"Key",{"_3170":2378,"_27782":2364,"_19244":52625,"_5":13232,"_26277":52589,"_2666":52626},[],"The record has a usable private key and the engine can sign.",{"_3170":2379,"_27782":2364,"_19244":52628,"_5":13232,"_26277":52589,"_2666":52629},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3170":2380,"_27782":2364,"_19244":52631,"_5":13232,"_26277":52589,"_2666":52632},[],"CSR",{"_3170":2381,"_27782":2364,"_19244":52634,"_5":13232,"_26277":52589,"_2666":52635},[],"Correct PEM and verifiable signature.",{"_3170":2382,"_27782":2364,"_19244":52637,"_5":13232,"_26277":52589,"_2666":52638},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3170":2383,"_27782":2364,"_19244":52640,"_5":13232,"_26277":52589,"_2666":52641},[],"Profile",{"_3170":2384,"_27782":2364,"_19244":52643,"_5":13232,"_26277":52589,"_2666":52644},[],"Selected source, existing ID, allowed algorithm and size.",{"_3170":2385,"_27782":2364,"_19244":52646,"_5":13232,"_26277":52589,"_2666":52647},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3170":2386,"_27782":2364,"_19244":52649,"_5":13232,"_26277":52589,"_2666":50047},[],{"_3170":2387,"_27782":2364,"_19244":52651,"_5":13232,"_26277":52589,"_2666":52652},[],"Appropriate subject, SAN, usages and dates.",{"_3170":2388,"_27782":2364,"_19244":52654,"_5":13232,"_26277":52589,"_2666":52655},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3170":2389,"_27782":2364,"_19244":52657,"_5":13232,"_26277":52589,"_2666":52658},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3170":2390,"_27782":2364,"_19244":52660,"_5":13232,"_26277":52589,"_2666":52661},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3170":2391,"_27782":2364,"_19244":52663,"_5":13232,"_26277":52593,"_2666":52664},[],"Check each boundary independently:",{"_3170":2392,"_27782":2364,"_19244":52666,"_5":13232,"_26277":52593,"_2666":52667},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3170":2393,"_27782":2364,"_19244":52669,"_5":13232,"_26277":52593,"_2666":52670},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3170":2394,"_27782":2364,"_19244":52672,"_5":13232,"_26277":52593,"_2666":52673},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3170":2395,"_27782":2364,"_19244":52675,"_5":13232,"_26277":52593,"_2666":52676},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3170":2396,"_27782":2364,"_19244":52678,"_5":13232,"_26277":52593,"_2666":52679},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3170":2397,"_27782":2364,"_19244":52681,"_5":13232,"_26277":52593,"_2666":52682},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3170":2398,"_27782":2364,"_19244":52684,"_5":13232,"_26277":52597,"_2666":52685},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3170":2399,"_27782":2364,"_19244":52687,"_5":13232,"_26277":52597,"_2666":52688},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3170":2400,"_27782":2400,"_5":13558,"_2666":52690,"_28124":52691,"_19244":52693,"_26277":2400},"3.8.0 to 4.0.0",[45194,52692],"Upgrades",[],{"_3170":2401,"_27782":2400,"_19244":52695,"_5":13232,"_26277":2400,"_2666":52696},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3170":2402,"_27782":2400,"_5":28121,"_19244":52698,"_26277":52699,"_2666":52700},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3170":2403,"_27782":2400,"_5":28121,"_19244":52702,"_26277":52703,"_2666":52704},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3170":2404,"_27782":2400,"_5":28121,"_19244":52706,"_26277":52707,"_2666":52708},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3170":2405,"_27782":2400,"_5":28121,"_19244":52710,"_26277":52711,"_2666":52712},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3170":2406,"_27782":2400,"_5":28121,"_19244":52714,"_26277":52715,"_2666":52716},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3170":2407,"_27782":2400,"_5":28121,"_19244":52718,"_26277":52719,"_2666":52720},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3170":2408,"_27782":2400,"_5":28121,"_19244":52722,"_26277":52723,"_2666":52724},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3170":2409,"_27782":2400,"_5":28121,"_19244":52726,"_26277":52727,"_2666":52728},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3170":2410,"_27782":2400,"_5":28121,"_19244":52730,"_26277":52731,"_2666":52732},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3170":2411,"_27782":2400,"_5":28121,"_19244":52734,"_26277":52735,"_2666":52736},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3170":2412,"_27782":2400,"_5":28121,"_19244":52738,"_26277":52739,"_2666":52740},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3170":2413,"_27782":2400,"_5":28121,"_19244":52742,"_26277":52743,"_2666":52744},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3170":2414,"_27782":2400,"_5":28121,"_19244":52746,"_26277":52747,"_2666":52748},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3170":2415,"_27782":2400,"_5":28121,"_19244":52750,"_26277":52751,"_2666":52752},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3170":2416,"_27782":2400,"_5":28121,"_19244":52754,"_26277":52755,"_2666":52756},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3170":2417,"_27782":2400,"_5":28121,"_19244":52758,"_26277":52759,"_2666":52760},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3170":2418,"_27782":2400,"_5":28121,"_19244":52762,"_26277":52763,"_2666":52764},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3170":2419,"_27782":2400,"_5":28121,"_19244":52766,"_26277":52767,"_2666":52768},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3170":2420,"_27782":2400,"_5":28121,"_19244":52770,"_26277":52771,"_2666":52772},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3170":2421,"_27782":2400,"_5":28121,"_19244":52774,"_26277":52775,"_2666":52776},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-va-roles","References between certificates, keys and VA roles",{"_3170":2422,"_27782":2400,"_5":28121,"_19244":52778,"_26277":52779,"_2666":52780},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3170":2423,"_27782":2400,"_5":28121,"_19244":52782,"_26277":52783,"_2666":52784},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3170":2424,"_27782":2400,"_5":28121,"_19244":52786,"_26277":52787,"_2666":52788},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3170":2425,"_27782":2400,"_5":28121,"_19244":52790,"_26277":52791,"_2666":52792},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3170":2426,"_27782":2400,"_5":28121,"_19244":52794,"_26277":52795,"_2666":52796},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3170":2427,"_27782":2400,"_5":28121,"_19244":52798,"_26277":52799,"_2666":52800},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3170":2428,"_27782":2400,"_5":28121,"_19244":52802,"_26277":52803,"_2666":52804},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3170":2429,"_27782":2400,"_5":28121,"_19244":52806,"_26277":52807,"_2666":52808},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#va-role-signer-field","VA role signer field",{"_3170":2430,"_27782":2400,"_5":28121,"_19244":52810,"_26277":52811,"_2666":52812},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3170":2431,"_27782":2400,"_5":28121,"_19244":52814,"_26277":52815,"_2666":52816},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3170":2432,"_27782":2400,"_5":28121,"_19244":52818,"_26277":52819,"_2666":52820},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3170":2433,"_27782":2400,"_5":28121,"_19244":52822,"_26277":52823,"_2666":52824},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3170":2434,"_27782":2400,"_5":28121,"_19244":52826,"_26277":52827,"_2666":52828},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3170":2435,"_27782":2400,"_5":28121,"_19244":52830,"_26277":52831,"_2666":52832},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3170":2436,"_27782":2400,"_5":28121,"_19244":52834,"_26277":52835,"_2666":52836},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3170":2437,"_27782":2400,"_5":28121,"_19244":52838,"_26277":52839,"_2666":49091},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3170":2438,"_27782":2400,"_5":28121,"_19244":52841,"_26277":52842,"_2666":52843},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3170":2439,"_27782":2400,"_5":28121,"_19244":52845,"_26277":52846,"_2666":52847},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3170":2440,"_27782":2400,"_19244":52849,"_5":13232,"_26277":2400,"_2666":52850},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3170":2441,"_27782":2400,"_19244":52852,"_5":13232,"_26277":2400,"_2666":52853},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3170":2442,"_27782":2400,"_19244":52855,"_5":13232,"_26277":2400,"_2666":52856},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3170":2443,"_27782":2400,"_19244":52858,"_5":13232,"_26277":2400,"_2666":52859},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3170":2444,"_27782":2400,"_19244":52861,"_5":13232,"_26277":2400,"_2666":52862},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3170":2445,"_27782":2400,"_19244":52864,"_5":13232,"_26277":2400,"_2666":52865},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3170":2446,"_27782":2400,"_19244":52867,"_5":13232,"_26277":2400,"_2666":52868},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3170":2447,"_27782":2400,"_19244":52870,"_5":13232,"_26277":52703,"_2666":52871},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3170":2448,"_27782":2400,"_19244":52873,"_5":13232,"_26277":52703,"_2666":52874},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3170":2449,"_27782":2400,"_19244":52876,"_5":13232,"_26277":52707,"_2666":52877},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3170":2450,"_27782":2400,"_19244":52879,"_5":13232,"_26277":52707,"_2666":52880},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3170":2451,"_27782":2400,"_19244":52882,"_5":13232,"_26277":52711,"_2666":52883},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3170":2452,"_27782":2400,"_19244":52885,"_5":13232,"_26277":52715,"_2666":52886},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3170":2453,"_27782":2400,"_19244":52888,"_5":13232,"_26277":52715,"_2666":52889},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3170":2454,"_27782":2400,"_19244":52891,"_5":13232,"_26277":52715,"_2666":52892},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3170":2455,"_27782":2400,"_19244":52894,"_5":13232,"_26277":52715,"_2666":52895},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3170":2456,"_27782":2400,"_19244":52897,"_5":13232,"_26277":52715,"_2666":52898},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3170":2457,"_27782":2400,"_19244":52900,"_5":13232,"_26277":52719,"_2666":52901},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3170":2458,"_27782":2400,"_19244":52903,"_5":13232,"_26277":52719,"_2666":52904},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3170":2459,"_27782":2400,"_19244":52906,"_5":13232,"_26277":52719,"_2666":52907},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3170":2460,"_27782":2400,"_19244":52909,"_5":13232,"_26277":52719,"_2666":52910},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3170":2461,"_27782":2400,"_19244":52912,"_5":13232,"_26277":52719,"_2666":52913},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3170":2462,"_27782":2400,"_19244":52915,"_5":13232,"_26277":52723,"_2666":52916},[],"Change",{"_3170":2463,"_27782":2400,"_19244":52918,"_5":13232,"_26277":52723,"_2666":52919},[],"Who is affected",{"_3170":2464,"_27782":2400,"_19244":52921,"_5":13232,"_26277":52723,"_2666":52922},[],"Severity",{"_3170":2465,"_27782":2400,"_19244":52924,"_5":13232,"_26277":52723,"_2666":52925},[],"Action",{"_3170":2466,"_27782":2400,"_19244":52927,"_5":13232,"_26277":52723,"_2666":52732},[],{"_3170":2467,"_27782":2400,"_19244":52929,"_5":13232,"_26277":52723,"_2666":52930},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3170":2468,"_27782":2400,"_19244":52932,"_5":13232,"_26277":52723,"_2666":52933},[],"High: KMS and VA start on empty volumes",{"_3170":2469,"_27782":2400,"_19244":52935,"_5":13232,"_26277":52723,"_2666":52936},[],"Copy the data into the new volumes",{"_3170":2470,"_27782":2400,"_19244":52938,"_5":13232,"_26277":52723,"_2666":52736},[],{"_3170":2471,"_27782":2400,"_19244":52940,"_5":13232,"_26277":52723,"_2666":52941},[],"Every Helm release",{"_3170":2472,"_27782":2400,"_19244":52943,"_5":13232,"_26277":52723,"_2666":52944},[],"High: `helm upgrade` fails",{"_3170":2473,"_27782":2400,"_19244":52946,"_5":13232,"_26277":52723,"_2666":52947},[],"Remove or rename legacy keys",{"_3170":2474,"_27782":2400,"_19244":52949,"_5":13232,"_26277":52723,"_2666":52740},[],{"_3170":2475,"_27782":2400,"_19244":52951,"_5":13232,"_26277":52723,"_2666":52952},[],"Every deployment",{"_3170":2476,"_27782":2400,"_19244":52954,"_5":13232,"_26277":52723,"_2666":52955},[],"High: without a bootstrap principal there is no administrator",{"_3170":2477,"_27782":2400,"_19244":52957,"_5":13232,"_26277":52723,"_2666":52958},[],"Configure `services.authz`",{"_3170":2478,"_27782":2400,"_19244":52960,"_5":13232,"_26277":52723,"_2666":52744},[],{"_3170":2479,"_27782":2400,"_19244":52962,"_5":13232,"_26277":52723,"_2666":52941},[],{"_3170":2480,"_27782":2400,"_19244":52964,"_5":13232,"_26277":52723,"_2666":52965},[],"High: `helm upgrade` fails on the old keys",{"_3170":2481,"_27782":2400,"_19244":52967,"_5":13232,"_26277":52723,"_2666":52968},[],"Move JWKS and roles into `services.authz`",{"_3170":2482,"_27782":2400,"_19244":52970,"_5":13232,"_26277":52723,"_2666":52764},[],{"_3170":2483,"_27782":2400,"_19244":52972,"_5":13232,"_26277":52723,"_2666":52973},[],"3.8.0 deployments with per-service databases",{"_3170":2484,"_27782":2400,"_19244":52975,"_5":13232,"_26277":52723,"_2666":52976},[],"High: services find no data, or a migration aborts",{"_3170":2485,"_27782":2400,"_19244":52978,"_5":13232,"_26277":52723,"_2666":52979},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3170":2486,"_27782":2400,"_19244":52981,"_5":13232,"_26277":52723,"_2666":52768},[],{"_3170":2487,"_27782":2400,"_19244":52983,"_5":13232,"_26277":52723,"_2666":52984},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3170":2488,"_27782":2400,"_19244":52986,"_5":13232,"_26277":52723,"_2666":52987},[],"High: the backend no longer starts with them",{"_3170":2489,"_27782":2400,"_19244":52989,"_5":13232,"_26277":52723,"_2666":52990},[],"Move to PostgreSQL before upgrading",{"_3170":2490,"_27782":2400,"_19244":52992,"_5":13232,"_26277":52723,"_2666":52993},[],"Webhooks with file references",{"_3170":2491,"_27782":2400,"_19244":52995,"_5":13232,"_26277":52723,"_2666":52996},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3170":2492,"_27782":2400,"_19244":52998,"_5":13232,"_26277":52723,"_2666":52999},[],"High: enrollments calling the webhook fail",{"_3170":2493,"_27782":2400,"_19244":53001,"_5":13232,"_26277":52723,"_2666":53002},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3170":2494,"_27782":2400,"_19244":53004,"_5":13232,"_26277":52723,"_2666":52748},[],{"_3170":2495,"_27782":2400,"_19244":53006,"_5":13232,"_26277":52723,"_2666":53007},[],"Releases with per-service identity overrides or mounted key material",{"_3170":2496,"_27782":2400,"_19244":53009,"_5":13232,"_26277":52723,"_2666":53010},[],"Medium: services cannot read their files",{"_3170":2497,"_27782":2400,"_19244":53012,"_5":13232,"_26277":52723,"_2666":53013},[],"Remove the overrides and fix volume ownership",{"_3170":2498,"_27782":2400,"_19244":53015,"_5":13232,"_26277":52723,"_2666":52752},[],{"_3170":2499,"_27782":2400,"_19244":53017,"_5":13232,"_26277":52723,"_2666":53018},[],"Releases that set `amqp.tls`",{"_3170":2500,"_27782":2400,"_19244":53020,"_5":13232,"_26277":52723,"_2666":53021},[],"Medium: clients connect to the wrong port",{"_3170":2501,"_27782":2400,"_19244":53023,"_5":13232,"_26277":52723,"_2666":53024},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3170":2502,"_27782":2400,"_19244":53026,"_5":13232,"_26277":52723,"_2666":52772},[],{"_3170":2503,"_27782":2400,"_19244":53028,"_5":13232,"_26277":52723,"_2666":53029},[],"Installations whose CA keys predate the KMS",{"_3170":2504,"_27782":2400,"_19244":53031,"_5":13232,"_26277":52723,"_2666":53032},[],"Medium: CA keys stay unmanaged",{"_3170":2505,"_27782":2400,"_19244":53034,"_5":13232,"_26277":52723,"_2666":53035},[],"Run the CA-to-KMS migration",{"_3170":2506,"_27782":2400,"_19244":53037,"_5":13232,"_26277":52723,"_2666":53038},[],"Receiver certificate verification",{"_3170":2507,"_27782":2400,"_19244":53040,"_5":13232,"_26277":52723,"_2666":53041},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3170":2508,"_27782":2400,"_19244":53043,"_5":13232,"_26277":52723,"_2666":53044},[],"Medium: credentials go to an unverified receiver",{"_3170":2509,"_27782":2400,"_19244":53046,"_5":13232,"_26277":52723,"_2666":53047},[],"Set `insecure_skip_verify` to `false`",{"_3170":2510,"_27782":2400,"_19244":53049,"_5":13232,"_26277":52723,"_2666":52788},[],{"_3170":2511,"_27782":2400,"_19244":53051,"_5":13232,"_26277":52723,"_2666":53052},[],"Scripts and consoles that edit DMSs through the API",{"_3170":2512,"_27782":2400,"_19244":53054,"_5":13232,"_26277":52723,"_2666":53055},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3170":2513,"_27782":2400,"_19244":53057,"_5":13232,"_26277":52723,"_2666":53058},[],"Read the DMS before editing and use the new field",{"_3170":2514,"_27782":2400,"_19244":53060,"_5":13232,"_26277":52723,"_2666":52808},[],{"_3170":2515,"_27782":2400,"_19244":53062,"_5":13232,"_26277":52723,"_2666":53063},[],"Clients that create or update VA roles through the API",{"_3170":2516,"_27782":2400,"_19244":53065,"_5":13232,"_26277":52723,"_2666":53066},[],"Medium: requests with the old field return an error",{"_3170":2517,"_27782":2400,"_19244":53068,"_5":13232,"_26277":52723,"_2666":53069},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_certificate_serial_number`",{"_3170":2518,"_27782":2400,"_19244":53071,"_5":13232,"_26277":52723,"_2666":52804},[],{"_3170":2519,"_27782":2400,"_19244":53073,"_5":13232,"_26277":52723,"_2666":53074},[],"Consumers that read the device `events` field",{"_3170":2520,"_27782":2400,"_19244":53076,"_5":13232,"_26277":52723,"_2666":53077},[],"Medium: the field disappears",{"_3170":2521,"_27782":2400,"_19244":53079,"_5":13232,"_26277":52723,"_2666":53080},[],"Use the new event endpoints",{"_3170":2522,"_27782":2400,"_19244":53082,"_5":13232,"_26277":52723,"_2666":52756},[],{"_3170":2523,"_27782":2400,"_19244":53084,"_5":13232,"_26277":52723,"_2666":53085},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3170":2524,"_27782":2400,"_19244":53087,"_5":13232,"_26277":52723,"_2666":53088},[],"Low to medium: validation errors or changed defaults",{"_3170":2525,"_27782":2400,"_19244":53090,"_5":13232,"_26277":52723,"_2666":53091},[],"Update the values file",{"_3170":2526,"_27782":2400,"_19244":53093,"_5":13232,"_26277":52723,"_2666":52796},[],{"_3170":2527,"_27782":2400,"_19244":53095,"_5":13232,"_26277":52723,"_2666":53096},[],"Clients that send the DMS ID in the update body",{"_3170":2528,"_27782":2400,"_19244":53098,"_5":13232,"_26277":52723,"_2666":53099},[],"Low: the ID in the URL wins",{"_3170":2529,"_27782":2400,"_19244":53101,"_5":13232,"_26277":52723,"_2666":53102},[],"Send the ID in the URL",{"_3170":2530,"_27782":2400,"_19244":53104,"_5":13232,"_26277":52723,"_2666":52800},[],{"_3170":2531,"_27782":2400,"_19244":53106,"_5":13232,"_26277":52723,"_2666":53107},[],"Consumers that match on certificate `type`",{"_3170":2532,"_27782":2400,"_19244":53109,"_5":13232,"_26277":52723,"_2666":53110},[],"Low: two values are renamed",{"_3170":2533,"_27782":2400,"_19244":53112,"_5":13232,"_26277":52723,"_2666":53113},[],"Adapt consumers",{"_3170":2534,"_27782":2400,"_19244":53115,"_5":13232,"_26277":52723,"_2666":52792},[],{"_3170":2535,"_27782":2400,"_19244":53117,"_5":13232,"_26277":52723,"_2666":53118},[],"Any DMS",{"_3170":2536,"_27782":2400,"_19244":53120,"_5":13232,"_26277":52723,"_2666":53121},[],"Low: informational",{"_3170":2537,"_27782":2400,"_19244":53123,"_5":13232,"_26277":52723,"_2666":53124},[],"Read both blocks before editing",{"_3170":2538,"_27782":2400,"_19244":53126,"_5":13232,"_26277":52731,"_2666":53127},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3170":2539,"_27782":2400,"_19244":53129,"_5":13232,"_26277":52731,"_2666":53130},[],"Step 4 of the migration guide copies the data.",{"_3170":2540,"_27782":2400,"_19244":53132,"_5":13232,"_26277":52735,"_2666":53133},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3170":2541,"_27782":2400,"_19244":53135,"_5":13232,"_26277":52739,"_2666":53136},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3170":2542,"_27782":2400,"_19244":53138,"_5":13232,"_26277":52743,"_2666":53139},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3170":2543,"_27782":2400,"_19244":53141,"_5":13232,"_26277":52747,"_2666":53142},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3170":2544,"_27782":2400,"_19244":53144,"_5":13232,"_26277":52747,"_2666":53145},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3170":2545,"_27782":2400,"_19244":53147,"_5":13232,"_26277":52751,"_2666":53148},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3170":2546,"_27782":2400,"_19244":53150,"_5":13232,"_26277":52755,"_2666":53151},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3170":2547,"_27782":2400,"_19244":53153,"_5":13232,"_26277":52755,"_2666":53154},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3170":2548,"_27782":2400,"_19244":53156,"_5":13232,"_26277":52755,"_2666":53157},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3170":2549,"_27782":2400,"_19244":53159,"_5":13232,"_26277":52755,"_2666":53160},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3170":2550,"_27782":2400,"_19244":53162,"_5":13232,"_26277":52755,"_2666":53163},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3170":2551,"_27782":2400,"_19244":53165,"_5":13232,"_26277":52755,"_2666":53166},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3170":2552,"_27782":2400,"_19244":53168,"_5":13232,"_26277":52763,"_2666":53169},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3170":2553,"_27782":2400,"_19244":53171,"_5":13232,"_26277":52763,"_2666":53172},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3170":2554,"_27782":2400,"_19244":53174,"_5":13232,"_26277":52763,"_2666":53175},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3170":2555,"_27782":2400,"_19244":53177,"_5":13232,"_26277":52763,"_2666":53178},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3170":2556,"_27782":2400,"_19244":53180,"_5":13232,"_26277":52763,"_2666":53181},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3170":2557,"_27782":2400,"_19244":53183,"_5":13232,"_26277":52767,"_2666":53184},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3170":2558,"_27782":2400,"_19244":53186,"_5":13232,"_26277":52771,"_2666":53187},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3170":2559,"_27782":2400,"_19244":53189,"_5":13232,"_26277":52771,"_2666":53190},[],"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_3170":2560,"_27782":2400,"_19244":53192,"_5":13232,"_26277":52771,"_2666":53193},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3170":2561,"_27782":2400,"_19244":53195,"_5":13232,"_26277":52771,"_2666":53196},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3170":2562,"_27782":2400,"_19244":53198,"_5":13232,"_26277":52771,"_2666":53199},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3170":2563,"_27782":2400,"_19244":53201,"_5":13232,"_26277":52771,"_2666":53202},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3170":2564,"_27782":2400,"_19244":53204,"_5":13232,"_26277":52771,"_2666":53205},[],"Once legacy keys are registered, starting the KMS with the backend configuration option `crypto_engines.migrate_keys_format` renames keys whose name is not the public-key SHA-256 digest, keeps the old name as an alias and moves certificate references along. It is safe to re-run and can be disabled afterwards.",{"_3170":2565,"_27782":2400,"_19244":53207,"_5":13232,"_26277":52775,"_2666":53208},[],"Certificates now reference their KMS key, and VA roles reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. The CA migration registers the public keys of deleted CAs as KMS keys without a private key; they exist to satisfy the reference and are safe to delete.",{"_3170":2566,"_27782":2400,"_19244":53210,"_5":13232,"_26277":52783,"_2666":53211},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3170":2567,"_27782":2400,"_19244":53213,"_5":13232,"_26277":52783,"_2666":53214},[],"Field in 3.8.0",{"_3170":2568,"_27782":2400,"_19244":53216,"_5":13232,"_26277":52783,"_2666":53217},[],"Field in 4.0.0",{"_3170":2569,"_27782":2400,"_19244":53219,"_5":13232,"_26277":52783,"_2666":53220},[],"`validate_server_cert`",{"_3170":2570,"_27782":2400,"_19244":53222,"_5":13232,"_26277":52783,"_2666":53223},[],"`insecure_skip_verify` (value negated)",{"_3170":2571,"_27782":2400,"_19244":53225,"_5":13232,"_26277":52783,"_2666":53226},[],"`oidc`",{"_3170":2572,"_27782":2400,"_19244":53228,"_5":13232,"_26277":52783,"_2666":53229},[],"`jwt_options`",{"_3170":2573,"_27782":2400,"_19244":53231,"_5":13232,"_26277":52783,"_2666":53232},[],"`apikey`",{"_3170":2574,"_27782":2400,"_19244":53234,"_5":13232,"_26277":52783,"_2666":53235},[],"`apikey_options`",{"_3170":2575,"_27782":2400,"_19244":53237,"_5":13232,"_26277":52783,"_2666":53238},[],"`mtls`",{"_3170":2576,"_27782":2400,"_19244":53240,"_5":13232,"_26277":52783,"_2666":53241},[],"`mtls_options`",{"_3170":2577,"_27782":2400,"_19244":53243,"_5":13232,"_26277":52783,"_2666":53244},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3170":2578,"_27782":2400,"_19244":53246,"_5":13232,"_26277":52783,"_2666":53247},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3170":2579,"_27782":2400,"_19244":53249,"_5":13232,"_26277":52783,"_2666":53250},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3170":2580,"_27782":2400,"_19244":53252,"_5":13232,"_26277":52787,"_2666":53253},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3170":2581,"_27782":2400,"_19244":53255,"_5":13232,"_26277":52787,"_2666":53256},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3170":2582,"_27782":2400,"_19244":53258,"_5":13232,"_26277":52787,"_2666":53259},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3170":2583,"_27782":2400,"_19244":53261,"_5":13232,"_26277":52791,"_2666":53262},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. If the console version does not expose independent settings, edit them through the DMS API.",{"_3170":2584,"_27782":2400,"_19244":53264,"_5":13232,"_26277":52795,"_2666":53265},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3170":2585,"_27782":2400,"_19244":53267,"_5":13232,"_26277":52799,"_2666":53268},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3170":2586,"_27782":2400,"_19244":53270,"_5":13232,"_26277":52803,"_2666":53271},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3170":2587,"_27782":2400,"_19244":53273,"_5":13232,"_26277":52803,"_2666":53274},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3170":2588,"_27782":2400,"_19244":53276,"_5":13232,"_26277":52803,"_2666":53277},[],"`POST /v1/devices/:id/events` creates an event.",{"_3170":2589,"_27782":2400,"_19244":53279,"_5":13232,"_26277":52803,"_2666":53280},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3170":2590,"_27782":2400,"_19244":53282,"_5":13232,"_26277":52807,"_2666":53283},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_certificate_serial_number`, the serial number of the existing certificate that signs the CRL. A new role's initial value is the CA's current certificate serial number. Requests that still carry `subject_key_id_signer` return an error. Custom authorization policies that filter on the old field must be updated: the filter `crl_subject_key_id_signer` is renamed to `crl_signer_certificate_serial_number` and takes serial-number values.",{"_3170":2591,"_27782":2400,"_19244":53285,"_5":13232,"_26277":52811,"_2666":53286},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3170":2592,"_27782":2400,"_19244":53288,"_5":13232,"_26277":52815,"_2666":53289},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_3170":2593,"_27782":2400,"_19244":53291,"_5":13232,"_26277":52815,"_2666":53292},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3170":2594,"_27782":2400,"_19244":53294,"_5":13232,"_26277":52815,"_2666":53295},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3170":2595,"_27782":2400,"_19244":53297,"_5":13232,"_26277":52815,"_2666":53298},[],"Record the names of your local-storage PVCs:",{"_3170":2596,"_27782":2400,"_19244":53300,"_5":13232,"_26277":52815,"_2666":53301},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3170":2597,"_27782":2400,"_19244":53303,"_5":13232,"_26277":52819,"_2666":53304},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3170":2598,"_27782":2400,"_19244":53306,"_5":13232,"_26277":52819,"_2666":53307},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3170":2599,"_27782":2400,"_19244":53309,"_5":13232,"_26277":52819,"_2666":53310},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3170":2600,"_27782":2400,"_19244":53312,"_5":13232,"_26277":52819,"_2666":53313},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3170":2601,"_27782":2400,"_19244":53315,"_5":13232,"_26277":52819,"_2666":53316},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3170":2602,"_27782":2400,"_19244":53318,"_5":13232,"_26277":52819,"_2666":53319},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3170":2603,"_27782":2400,"_19244":53321,"_5":13232,"_26277":52819,"_2666":53322},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3170":2604,"_27782":2400,"_19244":53324,"_5":13232,"_26277":52819,"_2666":53325},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3170":2605,"_27782":2400,"_19244":53327,"_5":13232,"_26277":52819,"_2666":53328},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3170":2606,"_27782":2400,"_19244":53330,"_5":13232,"_26277":52819,"_2666":53331},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3170":2607,"_27782":2400,"_19244":53333,"_5":13232,"_26277":52819,"_2666":53334},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3170":2608,"_27782":2400,"_19244":53336,"_5":13232,"_26277":52819,"_2666":53337},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3170":2609,"_27782":2400,"_19244":53339,"_5":13232,"_26277":52823,"_2666":53340},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3170":2610,"_27782":2400,"_19244":53342,"_5":13232,"_26277":52823,"_2666":53343},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3170":2611,"_27782":2400,"_19244":53345,"_5":13232,"_26277":52827,"_2666":53346},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3170":2612,"_27782":2400,"_19244":53348,"_5":13232,"_26277":52827,"_2666":53349},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3170":2613,"_27782":2400,"_19244":53351,"_5":13232,"_26277":52827,"_2666":53352},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3170":2614,"_27782":2400,"_19244":53354,"_5":13232,"_26277":52827,"_2666":53355},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3170":2615,"_27782":2400,"_19244":53357,"_5":13232,"_26277":52827,"_2666":53358},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3170":2616,"_27782":2400,"_19244":53360,"_5":13232,"_26277":52827,"_2666":53361},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3170":2617,"_27782":2400,"_19244":53363,"_5":13232,"_26277":52827,"_2666":53364},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3170":2618,"_27782":2400,"_19244":53366,"_5":13232,"_26277":52827,"_2666":53367},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3170":2619,"_27782":2400,"_19244":53369,"_5":13232,"_26277":52827,"_2666":53370},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3170":2620,"_27782":2400,"_19244":53372,"_5":13232,"_26277":52827,"_2666":53373},[],"**Remove the helper and restore the recorded replica counts:**",{"_3170":2621,"_27782":2400,"_19244":53375,"_5":13232,"_26277":52827,"_2666":53376},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3170":2622,"_27782":2400,"_19244":53378,"_5":13232,"_26277":52831,"_2666":53379},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3170":2623,"_27782":2400,"_19244":53381,"_5":13232,"_26277":52831,"_2666":53382},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3170":2624,"_27782":2400,"_19244":53384,"_5":13232,"_26277":52835,"_2666":53385},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3170":2625,"_27782":2400,"_19244":53387,"_5":13232,"_26277":52835,"_2666":53388},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3170":2626,"_27782":2400,"_19244":53390,"_5":13232,"_26277":52835,"_2666":53391},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates` and `SELECT` on `ca.ca_certificates`. If your services connect with a different user than the one that ran the migrations, grant that user `SELECT` on `ca.certificates_view` after the migrations.",{"_3170":2627,"_27782":2400,"_19244":53393,"_5":13232,"_26277":52835,"_2666":53394},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3170":2628,"_27782":2400,"_19244":53396,"_5":13232,"_26277":52835,"_2666":53397},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3170":2629,"_27782":2400,"_19244":53399,"_5":13232,"_26277":52835,"_2666":53400},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3170":2630,"_27782":2400,"_19244":53402,"_5":13232,"_26277":52835,"_2666":53403},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3170":2631,"_27782":2400,"_19244":53405,"_5":13232,"_26277":52839,"_2666":53406},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3170":2632,"_27782":2400,"_19244":53408,"_5":13232,"_26277":52839,"_2666":53409},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3170":2633,"_27782":2400,"_19244":53411,"_5":13232,"_26277":52839,"_2666":53412},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3170":2634,"_27782":2400,"_19244":53414,"_5":13232,"_26277":52839,"_2666":53415},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3170":2635,"_27782":2400,"_19244":53417,"_5":13232,"_26277":52839,"_2666":53418},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_3170":2636,"_27782":2400,"_19244":53420,"_5":13232,"_26277":52839,"_2666":53421},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3170":2637,"_27782":2400,"_19244":53423,"_5":13232,"_26277":52839,"_2666":53424},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3170":2638,"_27782":2400,"_19244":53426,"_5":13232,"_26277":52839,"_2666":53427},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` schema migration.",{"_3170":2639,"_27782":2400,"_19244":53429,"_5":13232,"_26277":52839,"_2666":53430},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3170":2640,"_27782":2400,"_19244":53432,"_5":13232,"_26277":52839,"_2666":53433},[],"**The VA cannot start with `cannot resolve signer certificate for VA role ... N candidates`.** The role's signer certificate cannot be identified uniquely among N matching certificates. Review the certificates that share the CA's subject and key, and set `signer_certificate_serial_number` on the role to the serial of the intended signer.",{"_3170":2641,"_27782":2400,"_19244":53435,"_5":13232,"_26277":52839,"_2666":53436},[],"**A migration or service fails with `permission denied for table ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped. Grant the missing privileges and re-run.",{"_3170":2642,"_27782":2400,"_19244":53438,"_5":13232,"_26277":52842,"_2666":53439},[],"After the upgrade, check in this order:",{"_3170":2643,"_27782":2400,"_19244":53441,"_5":13232,"_26277":52842,"_2666":53442},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3170":2644,"_27782":2400,"_19244":53444,"_5":13232,"_26277":52842,"_2666":53445},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3170":2645,"_27782":2400,"_19244":53447,"_5":13232,"_26277":52842,"_2666":53448},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3170":2646,"_27782":2400,"_19244":53450,"_5":13232,"_26277":52842,"_2666":53451},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_3170":2647,"_27782":2400,"_19244":53453,"_5":13232,"_26277":52842,"_2666":53454},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS.",{"_3170":2648,"_27782":2400,"_19244":53456,"_5":13232,"_26277":52842,"_2666":53457},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3170":2649,"_27782":2400,"_19244":53459,"_5":13232,"_26277":52842,"_2666":53460},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3170":2650,"_27782":2400,"_19244":53462,"_5":13232,"_26277":52842,"_2666":53463},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3170":2651,"_27782":2400,"_19244":53465,"_5":13232,"_26277":52842,"_2666":53466},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3170":2652,"_27782":2400,"_19244":53468,"_5":13232,"_26277":52842,"_2666":53469},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3170":2653,"_27782":2400,"_19244":53471,"_5":13232,"_26277":52842,"_2666":53472},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3170":2654,"_27782":2400,"_19244":53474,"_5":13232,"_26277":52842,"_2666":53475},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3170":2655,"_27782":2400,"_19244":53477,"_5":13232,"_26277":52842,"_2666":53478},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3170":2656,"_27782":2400,"_19244":53480,"_5":13232,"_26277":52842,"_2666":53481},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3170":2657,"_27782":2400,"_19244":53483,"_5":13232,"_26277":52846,"_2666":53484},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3170":2658,"_27782":2400,"_19244":53486,"_5":13232,"_26277":52846,"_2666":53487},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3170":2659,"_27782":2400,"_19244":53489,"_5":13232,"_26277":52846,"_2666":53490},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3170":2660,"_27782":2400,"_19244":53492,"_5":13232,"_26277":52846,"_2666":53493},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3170":2661,"_27782":2400,"_19244":53495,"_5":13232,"_26277":52846,"_2666":53496},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_53499":53500,"_53501":53502,"_53503":53504,"_53505":53506,"_16769":2701,"_64108":2701},"language","english","sortableProperties",[2666,27782,5,26277],"sortablePropertiesWithTypes",{"_2666":23022,"_27782":23022,"_5":23022,"_26277":23022},"sorts",{"_2666":53507,"_27782":56158,"_5":58808,"_26277":61458},{"_4232":53508,"_53509":53510,"_5":23022},{"_13287":20884,"_13657":4638,"_13676":4524,"_26893":4235,"_13663":15728,"_18258":2945,"_13308":7692,"_13315":4703,"_26835":3061,"_27227":9685,"_27248":4421,"_26853":5586,"_31900":5397,"_27259":13185,"_27288":6833,"_31907":2843,"_31910":14504,"_31913":11698,"_31916":4942,"_27635":3719,"_31921":26279,"_31923":25508,"_27665":2803,"_13672":3763,"_31927":26801,"_31930":5405,"_31932":5627,"_27277":6546,"_27630":6358,"_27689":7011,"_31937":6094,"_31939":6915,"_31941":3664,"_31943":2763,"_31945":23024,"_31947":4006,"_31949":5988,"_31951":3359,"_31953":11854,"_26906":18853,"_31956":6374,"_31958":4318,"_26900":18351,"_31961":15967,"_31963":11731,"_31965":6860,"_31968":5715,"_26946":6049,"_31972":19703,"_26826":7913,"_31975":16239,"_26858":6937,"_31978":3074,"_31980":4700,"_31983":5302,"_13666":3939,"_31986":6396,"_31988":5464,"_31991":6694,"_31993":5425,"_31995":5463,"_31997":16562,"_31999":5460,"_18261":7857,"_32002":3518,"_32004":10242,"_26879":4707,"_27271":2758,"_32008":6896,"_32010":10243,"_32012":14342,"_27695":10857,"_32015":3387,"_32017":9969,"_32019":4667,"_27762":6995,"_27304":7584,"_32023":6214,"_32025":4305,"_26868":3831,"