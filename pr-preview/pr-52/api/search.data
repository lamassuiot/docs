[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3171":17,"_27803":15,"_5":28142,"_19261":45229,"_26299":45230,"_2667":45231},[],"/docs/pr-preview/pr-52/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3171":18,"_27803":15,"_5":28142,"_19261":45233,"_26299":45234,"_2667":45235},[],"/docs/pr-preview/pr-52/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3171":19,"_27803":15,"_5":28142,"_19261":45237,"_26299":45238,"_2667":45239},[],"/docs/pr-preview/pr-52/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3171":20,"_27803":15,"_5":28142,"_19261":45241,"_26299":45242,"_2667":45243},[],"/docs/pr-preview/pr-52/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3171":21,"_27803":15,"_5":28142,"_19261":45245,"_26299":45246,"_2667":45247},[],"/docs/pr-preview/pr-52/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3171":22,"_27803":15,"_5":28142,"_19261":45249,"_26299":45250,"_2667":45251},[],"/docs/pr-preview/pr-52/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3171":23,"_27803":15,"_5":28142,"_19261":45253,"_26299":45254,"_2667":45255},[],"/docs/pr-preview/pr-52/deployment/aws-marketplace#next-step","Next step",{"_3171":24,"_27803":15,"_19261":45257,"_5":13244,"_26299":15,"_2667":45258},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3171":25,"_27803":15,"_19261":45260,"_5":13244,"_26299":45230,"_2667":45261},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3171":26,"_27803":15,"_19261":45263,"_5":13244,"_26299":45230,"_2667":45264},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3171":27,"_27803":15,"_19261":45266,"_5":13244,"_26299":45230,"_2667":45267},[],"A security group allowing the necessary endpoints.",{"_3171":28,"_27803":15,"_19261":45269,"_5":13244,"_26299":45234,"_2667":45270},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3171":29,"_27803":15,"_19261":45272,"_5":13244,"_26299":45234,"_2667":45273},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3171":30,"_27803":15,"_19261":45275,"_5":13244,"_26299":45234,"_2667":45276},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3171":31,"_27803":15,"_19261":45278,"_5":13244,"_26299":45238,"_2667":45279},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3171":32,"_27803":15,"_19261":45281,"_5":13244,"_26299":45242,"_2667":45282},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3171":33,"_27803":15,"_19261":45284,"_5":13244,"_26299":45246,"_2667":45285},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3171":34,"_27803":15,"_19261":45287,"_5":13244,"_26299":45250,"_2667":45288},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3171":35,"_27803":15,"_19261":45290,"_5":13244,"_26299":45254,"_2667":45291},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3171":36,"_27803":36,"_5":13570,"_2667":45293,"_28145":45294,"_19261":45295,"_26299":36},"Deploy Lamassu",[45221,45222],[],{"_3171":37,"_27803":36,"_19261":45297,"_5":13244,"_26299":36,"_2667":45298},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3171":38,"_27803":36,"_5":28142,"_19261":45300,"_26299":45301,"_2667":45302},[],"/docs/pr-preview/pr-52/deployment/overview#choose-a-model","Choose a model",{"_3171":39,"_27803":36,"_5":28142,"_19261":45304,"_26299":45305,"_2667":45306},[],"/docs/pr-preview/pr-52/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3171":40,"_27803":36,"_5":28142,"_19261":45308,"_26299":45309,"_2667":45310},[],"/docs/pr-preview/pr-52/deployment/overview#after-deployment","After deployment",{"_3171":41,"_27803":36,"_19261":45312,"_5":13244,"_26299":36,"_2667":45313},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3171":42,"_27803":36,"_19261":45315,"_5":13244,"_26299":45301,"_2667":45316},[],"Model",{"_3171":43,"_27803":36,"_19261":45318,"_5":13244,"_26299":45301,"_2667":45319},[],"Recommended for",{"_3171":44,"_27803":36,"_19261":45321,"_5":13244,"_26299":45301,"_2667":45322},[],"Who operates the infrastructure",{"_3171":45,"_27803":36,"_19261":45324,"_5":13244,"_26299":45301,"_2667":45325},[],"Starting point",{"_3171":46,"_27803":36,"_19261":45327,"_5":13244,"_26299":45301,"_2667":45328},[],"Kubernetes self-managed",{"_3171":47,"_27803":36,"_19261":45330,"_5":13244,"_26299":45301,"_2667":45331},[],"Production, regulated environments and custom deployments",{"_3171":48,"_27803":36,"_19261":45333,"_5":13244,"_26299":45301,"_2667":45334},[],"Your team",{"_3171":49,"_27803":36,"_19261":45336,"_5":13244,"_26299":45301,"_2667":45337},[],"Helm or Fastlane",{"_3171":50,"_27803":36,"_19261":45339,"_5":13244,"_26299":45301,"_2667":45340},[],"AWS Marketplace",{"_3171":51,"_27803":36,"_19261":45342,"_5":13244,"_26299":45301,"_2667":45343},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3171":52,"_27803":36,"_19261":45345,"_5":13244,"_26299":45301,"_2667":45334},[],{"_3171":53,"_27803":36,"_19261":45347,"_5":13244,"_26299":45301,"_2667":45348},[],"Preconfigured image on EC2",{"_3171":54,"_27803":36,"_19261":45350,"_5":13244,"_26299":45301,"_2667":45351},[],"SaaS",{"_3171":55,"_27803":36,"_19261":45353,"_5":13244,"_26299":45301,"_2667":45354},[],"Teams that want to use the platform without operating it",{"_3171":56,"_27803":36,"_19261":45356,"_5":13244,"_26299":45301,"_2667":45357},[],"Lamassu",{"_3171":57,"_27803":36,"_19261":45359,"_5":13244,"_26299":45301,"_2667":45360},[],"Managed subscription",{"_3171":58,"_27803":36,"_19261":45362,"_5":13244,"_26299":45301,"_2667":45363},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3171":59,"_27803":36,"_19261":45365,"_5":13244,"_26299":45301,"_2667":45366},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3171":60,"_27803":36,"_19261":45368,"_5":13244,"_26299":45301,"_2667":45369},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3171":61,"_27803":36,"_19261":45371,"_5":13244,"_26299":45305,"_2667":45372},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3171":62,"_27803":36,"_19261":45374,"_5":13244,"_26299":45309,"_2667":45375},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3171":63,"_27803":63,"_5":13570,"_2667":45377,"_28145":45378,"_19261":45379,"_26299":63},"Use Lamassu as SaaS",[45221,45222,45223],[],{"_3171":64,"_27803":63,"_19261":45381,"_5":13244,"_26299":63,"_2667":45382},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3171":65,"_27803":63,"_5":28142,"_19261":45384,"_26299":45385,"_2667":45386},[],"/docs/pr-preview/pr-52/deployment/saas#what-the-service-manages","What the service manages",{"_3171":66,"_27803":63,"_5":28142,"_19261":45388,"_26299":45389,"_2667":45390},[],"/docs/pr-preview/pr-52/deployment/saas#plans","Plans",{"_3171":67,"_27803":63,"_5":28142,"_19261":45392,"_26299":45393,"_2667":45394},[],"/docs/pr-preview/pr-52/deployment/saas#request-access","Request access",{"_3171":68,"_27803":63,"_19261":45396,"_5":13244,"_26299":63,"_2667":45397},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3171":69,"_27803":63,"_19261":45399,"_5":13244,"_26299":45385,"_2667":45400},[],"Platform availability and maintenance.",{"_3171":70,"_27803":63,"_19261":45402,"_5":13244,"_26299":45385,"_2667":45403},[],"Automatic backups.",{"_3171":71,"_27803":63,"_19261":45405,"_5":13244,"_26299":45385,"_2667":45406},[],"Version upgrades.",{"_3171":72,"_27803":63,"_19261":45408,"_5":13244,"_26299":45385,"_2667":45409},[],"Technical support and SLA according to your plan.",{"_3171":73,"_27803":63,"_19261":45411,"_5":13244,"_26299":45389,"_2667":45412},[],"Plan",{"_3171":74,"_27803":63,"_19261":45414,"_5":13244,"_26299":45389,"_2667":45415},[],"Devices",{"_3171":75,"_27803":63,"_19261":45417,"_5":13244,"_26299":45389,"_2667":45418},[],"Support",{"_3171":76,"_27803":63,"_19261":45420,"_5":13244,"_26299":45389,"_2667":45421},[],"SLA",{"_3171":77,"_27803":63,"_19261":45423,"_5":13244,"_26299":45389,"_2667":45424},[],"Starter",{"_3171":78,"_27803":63,"_19261":45426,"_5":13244,"_26299":45389,"_2667":45427},[],"Up to 1,000",{"_3171":79,"_27803":63,"_19261":45429,"_5":13244,"_26299":45389,"_2667":45430},[],"Email",{"_3171":80,"_27803":63,"_19261":45432,"_5":13244,"_26299":45389,"_2667":45433},[],"99.5 %",{"_3171":81,"_27803":63,"_19261":45435,"_5":13244,"_26299":45389,"_2667":45436},[],"Professional",{"_3171":82,"_27803":63,"_19261":45438,"_5":13244,"_26299":45389,"_2667":45439},[],"Up to 10,000",{"_3171":83,"_27803":63,"_19261":45441,"_5":13244,"_26299":45389,"_2667":45442},[],"Email and chat",{"_3171":84,"_27803":63,"_19261":45444,"_5":13244,"_26299":45389,"_2667":45445},[],"99.9 %",{"_3171":85,"_27803":63,"_19261":45447,"_5":13244,"_26299":45389,"_2667":45448},[],"Enterprise",{"_3171":86,"_27803":63,"_19261":45450,"_5":13244,"_26299":45389,"_2667":45451},[],"Unlimited",{"_3171":87,"_27803":63,"_19261":45453,"_5":13244,"_26299":45389,"_2667":45454},[],"Dedicated",{"_3171":88,"_27803":63,"_19261":45456,"_5":13244,"_26299":45389,"_2667":45457},[],"99.99 %",{"_3171":89,"_27803":63,"_19261":45459,"_5":13244,"_26299":45393,"_2667":45460},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3171":90,"_27803":63,"_19261":45462,"_5":13244,"_26299":45393,"_2667":45463},[],"When you receive your instance's credentials, continue with Get started.",{"_3171":91,"_27803":91,"_5":13570,"_2667":45465,"_28145":45466,"_19261":45467,"_26299":91},"Fastlane",[45221,45222,45328],[],{"_3171":92,"_27803":91,"_19261":45469,"_5":13244,"_26299":91,"_2667":45470},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3171":93,"_27803":91,"_5":28142,"_19261":45472,"_26299":45473,"_2667":45474},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3171":94,"_27803":91,"_5":28142,"_19261":45476,"_26299":45477,"_2667":45478},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3171":95,"_27803":91,"_5":28142,"_19261":45480,"_26299":45481,"_2667":45231},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#before-you-begin",{"_3171":96,"_27803":91,"_5":28142,"_19261":45483,"_26299":45484,"_2667":45485},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3171":97,"_27803":91,"_5":28142,"_19261":45487,"_26299":45488,"_2667":45489},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3171":98,"_27803":91,"_5":28142,"_19261":45491,"_26299":45492,"_2667":45493},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3171":99,"_27803":91,"_5":28142,"_19261":45495,"_26299":45496,"_2667":45497},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3171":100,"_27803":91,"_5":28142,"_19261":45499,"_26299":45500,"_2667":45501},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3171":101,"_27803":91,"_5":28142,"_19261":45503,"_26299":45504,"_2667":45505},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3171":102,"_27803":91,"_5":28142,"_19261":45507,"_26299":45508,"_2667":45509},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3171":103,"_27803":91,"_5":28142,"_19261":45511,"_26299":45512,"_2667":45513},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3171":104,"_27803":91,"_19261":45515,"_5":13244,"_26299":45473,"_2667":45516},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3171":105,"_27803":91,"_19261":45518,"_5":13244,"_26299":45473,"_2667":45519},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3171":106,"_27803":91,"_19261":45521,"_5":13244,"_26299":45477,"_2667":45522},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3171":107,"_27803":91,"_19261":45524,"_5":13244,"_26299":45477,"_2667":45525},[],"Fastlane installs or configures",{"_3171":108,"_27803":91,"_19261":45527,"_5":13244,"_26299":45477,"_2667":45528},[],"You still provide",{"_3171":109,"_27803":91,"_19261":45530,"_5":13244,"_26299":45477,"_2667":45531},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3171":110,"_27803":91,"_19261":45533,"_5":13244,"_26299":45477,"_2667":45534},[],"The Kubernetes cluster, nodes and persistent storage",{"_3171":111,"_27803":91,"_19261":45536,"_5":13244,"_26299":45477,"_2667":45537},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3171":112,"_27803":91,"_19261":45539,"_5":13244,"_26299":45477,"_2667":45540},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3171":113,"_27803":91,"_19261":45542,"_5":13244,"_26299":45477,"_2667":45543},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3171":114,"_27803":91,"_19261":45545,"_5":13244,"_26299":45477,"_2667":45546},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3171":115,"_27803":91,"_19261":45548,"_5":13244,"_26299":45477,"_2667":45549},[],"Optional observability and lab HSM components",{"_3171":116,"_27803":91,"_19261":45551,"_5":13244,"_26299":45477,"_2667":45552},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3171":117,"_27803":91,"_19261":45554,"_5":13244,"_26299":45477,"_2667":45555},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3171":118,"_27803":91,"_19261":45557,"_5":13244,"_26299":45481,"_2667":45558},[],"You need:",{"_3171":119,"_27803":91,"_19261":45560,"_5":13244,"_26299":45481,"_2667":45561},[],"an existing Kubernetes cluster",{"_3171":120,"_27803":91,"_19261":45563,"_5":13244,"_26299":45481,"_2667":45564},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3171":121,"_27803":91,"_19261":45566,"_5":13244,"_26299":45481,"_2667":45567},[],"`yq`",{"_3171":122,"_27803":91,"_19261":45569,"_5":13244,"_26299":45481,"_2667":21817},[],{"_3171":123,"_27803":91,"_19261":45571,"_5":13244,"_26299":45481,"_2667":45572},[],"`jq` only when using `--sample-data` or `--development`",{"_3171":124,"_27803":91,"_19261":45574,"_5":13244,"_26299":45481,"_2667":45575},[],"`ssh-keygen` only when using `--with-hsm`",{"_3171":125,"_27803":91,"_19261":45577,"_5":13244,"_26299":45481,"_2667":45578},[],"free external ports 80 and 443 on a single-node K3s host",{"_3171":126,"_27803":91,"_19261":45580,"_5":13244,"_26299":45481,"_2667":45581},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3171":127,"_27803":91,"_19261":45583,"_5":13244,"_26299":45481,"_2667":45584},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3171":128,"_27803":91,"_19261":45586,"_5":13244,"_26299":45484,"_2667":45587},[],"Run the script from a clone of the Helm repository:",{"_3171":129,"_27803":91,"_19261":45589,"_5":13244,"_26299":45484,"_2667":45590},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3171":130,"_27803":91,"_19261":45592,"_5":13244,"_26299":45488,"_2667":45593},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3171":131,"_27803":91,"_19261":45595,"_5":13244,"_26299":45488,"_2667":45596},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3171":132,"_27803":91,"_19261":45598,"_5":13244,"_26299":45488,"_2667":45599},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3171":133,"_27803":91,"_19261":45601,"_5":13244,"_26299":45488,"_2667":45602},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3171":134,"_27803":91,"_19261":45604,"_5":13244,"_26299":45492,"_2667":45605},[],"Option",{"_3171":135,"_27803":91,"_19261":45607,"_5":13244,"_26299":45492,"_2667":45608},[],"Default",{"_3171":136,"_27803":91,"_19261":45610,"_5":13244,"_26299":45492,"_2667":45611},[],"Purpose",{"_3171":137,"_27803":91,"_19261":45613,"_5":13244,"_26299":45492,"_2667":45614},[],"`-h`, `--help`",{"_3171":138,"_27803":91,"_19261":45616,"_5":13244,"_26299":45492,"_2667":45617},[],"—",{"_3171":139,"_27803":91,"_19261":45619,"_5":13244,"_26299":45492,"_2667":45620},[],"Show help",{"_3171":140,"_27803":91,"_19261":45622,"_5":13244,"_26299":45492,"_2667":45623},[],"`-c`, `--context`",{"_3171":141,"_27803":91,"_19261":45625,"_5":13244,"_26299":45492,"_2667":45626},[],"current context",{"_3171":142,"_27803":91,"_19261":45628,"_5":13244,"_26299":45492,"_2667":45629},[],"Select the kubeconfig context for kubectl and Helm",{"_3171":143,"_27803":91,"_19261":45631,"_5":13244,"_26299":45492,"_2667":45632},[],"`-n`, `--non-interactive`",{"_3171":144,"_27803":91,"_19261":45634,"_5":13244,"_26299":45492,"_2667":5939},[],{"_3171":145,"_27803":91,"_19261":45636,"_5":13244,"_26299":45492,"_2667":45637},[],"Skip prompts and generate dependency credentials",{"_3171":146,"_27803":91,"_19261":45639,"_5":13244,"_26299":45492,"_2667":45640},[],"`-ns`, `--namespace`",{"_3171":147,"_27803":91,"_19261":45642,"_5":13244,"_26299":45492,"_2667":45643},[],"`lamassu-dev`",{"_3171":148,"_27803":91,"_19261":45645,"_5":13244,"_26299":45492,"_2667":45646},[],"Namespace for the installation",{"_3171":149,"_27803":91,"_19261":45648,"_5":13244,"_26299":45492,"_2667":45649},[],"`-d`, `--domain`",{"_3171":150,"_27803":91,"_19261":45651,"_5":13244,"_26299":45492,"_2667":45652},[],"`dev.lamassu.io`",{"_3171":151,"_27803":91,"_19261":45654,"_5":13244,"_26299":45492,"_2667":45655},[],"Domain used by the UI, OIDC and certificate",{"_3171":152,"_27803":91,"_19261":45657,"_5":13244,"_26299":45492,"_2667":45658},[],"`-v`, `--version`",{"_3171":153,"_27803":91,"_19261":45660,"_5":13244,"_26299":45492,"_2667":13864},[],{"_3171":154,"_27803":91,"_19261":45662,"_5":13244,"_26299":45492,"_2667":45663},[],"Lamassu chart version",{"_3171":155,"_27803":91,"_19261":45665,"_5":13244,"_26299":45492,"_2667":45666},[],"`--https-port`",{"_3171":156,"_27803":91,"_19261":45668,"_5":13244,"_26299":45492,"_2667":45669},[],"`443`",{"_3171":157,"_27803":91,"_19261":45671,"_5":13244,"_26299":45492,"_2667":45672},[],"Gateway HTTPS listener port",{"_3171":158,"_27803":91,"_19261":45674,"_5":13244,"_26299":45492,"_2667":45675},[],"`--http-port`",{"_3171":159,"_27803":91,"_19261":45677,"_5":13244,"_26299":45492,"_2667":45678},[],"`80`",{"_3171":160,"_27803":91,"_19261":45680,"_5":13244,"_26299":45492,"_2667":45681},[],"Gateway HTTP listener port",{"_3171":161,"_27803":91,"_19261":45683,"_5":13244,"_26299":45492,"_2667":45684},[],"`--tls-crt`",{"_3171":162,"_27803":91,"_19261":45686,"_5":13244,"_26299":45492,"_2667":45617},[],{"_3171":163,"_27803":91,"_19261":45688,"_5":13244,"_26299":45492,"_2667":45689},[],"PEM certificate for downstream TLS",{"_3171":164,"_27803":91,"_19261":45691,"_5":13244,"_26299":45492,"_2667":45692},[],"`--tls-key`",{"_3171":165,"_27803":91,"_19261":45694,"_5":13244,"_26299":45492,"_2667":45617},[],{"_3171":166,"_27803":91,"_19261":45696,"_5":13244,"_26299":45492,"_2667":45697},[],"PEM private key for downstream TLS",{"_3171":167,"_27803":91,"_19261":45699,"_5":13244,"_26299":45492,"_2667":45700},[],"`-l`, `--local-chart-path`",{"_3171":168,"_27803":91,"_19261":45702,"_5":13244,"_26299":45492,"_2667":45703},[],"repository chart",{"_3171":169,"_27803":91,"_19261":45705,"_5":13244,"_26299":45492,"_2667":45706},[],"Use an unpacked local Lamassu chart",{"_3171":170,"_27803":91,"_19261":45708,"_5":13244,"_26299":45492,"_2667":45709},[],"`-ip`, `--gateway-ip`",{"_3171":171,"_27803":91,"_19261":45711,"_5":13244,"_26299":45492,"_2667":7997},[],{"_3171":172,"_27803":91,"_19261":45713,"_5":13244,"_26299":45492,"_2667":45714},[],"Override the address written to `gateway.addresses`",{"_3171":173,"_27803":91,"_19261":45716,"_5":13244,"_26299":45492,"_2667":45717},[],"`--otel`",{"_3171":174,"_27803":91,"_19261":45719,"_5":13244,"_26299":45492,"_2667":5939},[],{"_3171":175,"_27803":91,"_19261":45721,"_5":13244,"_26299":45492,"_2667":45722},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3171":176,"_27803":91,"_19261":45724,"_5":13244,"_26299":45492,"_2667":45725},[],"`--development`",{"_3171":177,"_27803":91,"_19261":45727,"_5":13244,"_26299":45492,"_2667":5939},[],{"_3171":178,"_27803":91,"_19261":45729,"_5":13244,"_26299":45492,"_2667":45730},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3171":179,"_27803":91,"_19261":45732,"_5":13244,"_26299":45492,"_2667":45733},[],"`--sample-data`",{"_3171":180,"_27803":91,"_19261":45735,"_5":13244,"_26299":45492,"_2667":5939},[],{"_3171":181,"_27803":91,"_19261":45737,"_5":13244,"_26299":45492,"_2667":45738},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3171":182,"_27803":91,"_19261":45740,"_5":13244,"_26299":45492,"_2667":45741},[],"`--with-hsm`",{"_3171":183,"_27803":91,"_19261":45743,"_5":13244,"_26299":45492,"_2667":5939},[],{"_3171":184,"_27803":91,"_19261":45745,"_5":13244,"_26299":45492,"_2667":45746},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3171":185,"_27803":91,"_19261":45748,"_5":13244,"_26299":45492,"_2667":45749},[],"`--softhsm-chart-path`",{"_3171":186,"_27803":91,"_19261":45751,"_5":13244,"_26299":45492,"_2667":45752},[],"`./charts/softhsm`",{"_3171":187,"_27803":91,"_19261":45754,"_5":13244,"_26299":45492,"_2667":45755},[],"Use a different local SoftHSM chart",{"_3171":188,"_27803":91,"_19261":45757,"_5":13244,"_26299":45492,"_2667":45758},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3171":189,"_27803":91,"_19261":45760,"_5":13244,"_26299":45496,"_2667":45761},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3171":190,"_27803":91,"_19261":45763,"_5":13244,"_26299":45496,"_2667":45764},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3171":191,"_27803":91,"_19261":45766,"_5":13244,"_26299":45496,"_2667":45767},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3171":192,"_27803":91,"_19261":45769,"_5":13244,"_26299":45496,"_2667":45770},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3171":193,"_27803":91,"_19261":45772,"_5":13244,"_26299":45496,"_2667":45773},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3171":194,"_27803":91,"_19261":45775,"_5":13244,"_26299":45496,"_2667":45776},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3171":195,"_27803":91,"_19261":45778,"_5":13244,"_26299":45500,"_2667":45779},[],"Fastlane:",{"_3171":196,"_27803":91,"_19261":45781,"_5":13244,"_26299":45500,"_2667":45782},[],"validates local tools and the selected cluster",{"_3171":197,"_27803":91,"_19261":45784,"_5":13244,"_26299":45500,"_2667":45785},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3171":198,"_27803":91,"_19261":45787,"_5":13244,"_26299":45500,"_2667":45788},[],"creates the namespace",{"_3171":199,"_27803":91,"_19261":45790,"_5":13244,"_26299":45500,"_2667":45791},[],"installs PostgreSQL and creates the required databases",{"_3171":200,"_27803":91,"_19261":45793,"_5":13244,"_26299":45500,"_2667":45794},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3171":201,"_27803":91,"_19261":45796,"_5":13244,"_26299":45500,"_2667":45797},[],"installs RabbitMQ",{"_3171":202,"_27803":91,"_19261":45799,"_5":13244,"_26299":45500,"_2667":45800},[],"optionally installs observability and lab HSM components",{"_3171":203,"_27803":91,"_19261":45802,"_5":13244,"_26299":45500,"_2667":45803},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3171":204,"_27803":91,"_19261":45805,"_5":13244,"_26299":45500,"_2667":45806},[],"optionally loads sample data",{"_3171":205,"_27803":91,"_19261":45808,"_5":13244,"_26299":45500,"_2667":45809},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3171":206,"_27803":91,"_19261":45811,"_5":13244,"_26299":45504,"_2667":45812},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3171":207,"_27803":91,"_19261":45814,"_5":13244,"_26299":45504,"_2667":45815},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3171":208,"_27803":91,"_19261":45817,"_5":13244,"_26299":45508,"_2667":45818},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3171":209,"_27803":91,"_19261":45820,"_5":13244,"_26299":45508,"_2667":45821},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3171":210,"_27803":91,"_19261":45823,"_5":13244,"_26299":45508,"_2667":45824},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3171":211,"_27803":91,"_19261":45826,"_5":13244,"_26299":45512,"_2667":45827},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3171":212,"_27803":212,"_5":13570,"_2667":45829,"_28145":45830,"_19261":45831,"_26299":212},"Install with Helm",[45221,45222,45328],[],{"_3171":213,"_27803":212,"_19261":45833,"_5":13244,"_26299":212,"_2667":45834},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3171":214,"_27803":212,"_5":28142,"_19261":45836,"_26299":45837,"_2667":45838},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3171":215,"_27803":212,"_5":28142,"_19261":45840,"_26299":45841,"_2667":45231},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#before-you-begin",{"_3171":216,"_27803":212,"_5":28142,"_19261":45843,"_26299":45844,"_2667":45845},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3171":217,"_27803":212,"_5":28142,"_19261":45847,"_26299":45848,"_2667":45849},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3171":218,"_27803":212,"_5":28142,"_19261":45851,"_26299":45852,"_2667":45853},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3171":219,"_27803":212,"_5":28142,"_19261":45855,"_26299":45856,"_2667":45857},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3171":220,"_27803":212,"_5":28142,"_19261":45859,"_26299":45860,"_2667":45861},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3171":221,"_27803":212,"_5":28142,"_19261":45863,"_26299":45864,"_2667":45865},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3171":222,"_27803":212,"_5":28142,"_19261":45867,"_26299":45868,"_2667":45869},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3171":223,"_27803":212,"_19261":45871,"_5":13244,"_26299":45837,"_2667":45872},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3171":224,"_27803":212,"_19261":45874,"_5":13244,"_26299":45841,"_2667":45875},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3171":225,"_27803":212,"_19261":45877,"_5":13244,"_26299":45841,"_2667":45878},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3171":226,"_27803":212,"_19261":45880,"_5":13244,"_26299":45841,"_2667":45881},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3171":227,"_27803":212,"_19261":45883,"_5":13244,"_26299":45841,"_2667":45884},[],"a reachable RabbitMQ broker and credentials",{"_3171":228,"_27803":212,"_19261":45886,"_5":13244,"_26299":45841,"_2667":45887},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3171":229,"_27803":212,"_19261":45889,"_5":13244,"_26299":45841,"_2667":45890},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3171":230,"_27803":212,"_19261":45892,"_5":13244,"_26299":45841,"_2667":45893},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3171":231,"_27803":212,"_19261":45895,"_5":13244,"_26299":45841,"_2667":45896},[],"a StorageClass and an external traffic design",{"_3171":232,"_27803":212,"_19261":45898,"_5":13244,"_26299":45841,"_2667":45899},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3171":233,"_27803":212,"_19261":45901,"_5":13244,"_26299":45841,"_2667":45902},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3171":234,"_27803":212,"_19261":45904,"_5":13244,"_26299":45841,"_2667":45905},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3171":235,"_27803":212,"_19261":45907,"_5":13244,"_26299":45844,"_2667":45908},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3171":236,"_27803":212,"_19261":45910,"_5":13244,"_26299":45844,"_2667":45911},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3171":237,"_27803":212,"_19261":45913,"_5":13244,"_26299":45844,"_2667":45914},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3171":238,"_27803":212,"_19261":45916,"_5":13244,"_26299":45848,"_2667":45917},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3171":239,"_27803":212,"_19261":45919,"_5":13244,"_26299":45848,"_2667":45920},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3171":240,"_27803":212,"_19261":45922,"_5":13244,"_26299":45848,"_2667":45923},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3171":241,"_27803":212,"_19261":45925,"_5":13244,"_26299":45852,"_2667":45926},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3171":242,"_27803":212,"_19261":45928,"_5":13244,"_26299":45856,"_2667":45929},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3171":243,"_27803":212,"_19261":45931,"_5":13244,"_26299":45856,"_2667":45932},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3171":244,"_27803":212,"_19261":45934,"_5":13244,"_26299":45856,"_2667":45935},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3171":245,"_27803":212,"_19261":45937,"_5":13244,"_26299":45856,"_2667":45938},[],"See Access control for the principal and policy model.",{"_3171":246,"_27803":212,"_19261":45940,"_5":13244,"_26299":45860,"_2667":45941},[],"To install a local checkout instead:",{"_3171":247,"_27803":212,"_19261":45943,"_5":13244,"_26299":45864,"_2667":45944},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3171":248,"_27803":212,"_19261":45946,"_5":13244,"_26299":45864,"_2667":45947},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3171":249,"_27803":212,"_19261":45949,"_5":13244,"_26299":45868,"_2667":45950},[],"Before going live, review:",{"_3171":250,"_27803":212,"_19261":45952,"_5":13244,"_26299":45868,"_2667":45953},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3171":251,"_27803":212,"_19261":45955,"_5":13244,"_26299":45868,"_2667":45956},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3171":252,"_27803":212,"_19261":45958,"_5":13244,"_26299":45868,"_2667":45959},[],"shared VA storage before increasing VA replicas",{"_3171":253,"_27803":212,"_19261":45961,"_5":13244,"_26299":45868,"_2667":45962},[],"managed OIDC roles and removal of evaluation credentials",{"_3171":254,"_27803":212,"_19261":45964,"_5":13244,"_26299":45868,"_2667":45965},[],"a trusted TLS issuer or externally managed certificate",{"_3171":255,"_27803":212,"_19261":45967,"_5":13244,"_26299":45868,"_2667":45968},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3171":256,"_27803":212,"_19261":45970,"_5":13244,"_26299":45868,"_2667":45971},[],"SMTP, observability and alert delivery",{"_3171":257,"_27803":212,"_19261":45973,"_5":13244,"_26299":45868,"_2667":45974},[],"the version upgrade guides and the notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_3171":258,"_27803":212,"_19261":45976,"_5":13244,"_26299":45868,"_2667":45977},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3171":259,"_27803":259,"_5":13570,"_2667":45979,"_28145":45980,"_19261":45981,"_26299":259},"Expose the Gateway",[45221,45222,45328],[],{"_3171":260,"_27803":259,"_19261":45983,"_5":13244,"_26299":259,"_2667":45984},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3171":261,"_27803":259,"_5":28142,"_19261":45986,"_26299":45987,"_2667":45988},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3171":262,"_27803":259,"_5":28142,"_19261":45990,"_26299":45991,"_2667":45992},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3171":263,"_27803":259,"_5":28142,"_19261":45994,"_26299":45995,"_2667":45996},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3171":264,"_27803":259,"_5":28142,"_19261":45998,"_26299":45999,"_2667":46000},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#k3s","K3s",{"_3171":265,"_27803":259,"_5":28142,"_19261":46002,"_26299":46003,"_2667":46004},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3171":266,"_27803":259,"_5":28142,"_19261":46006,"_26299":46007,"_2667":46008},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3171":267,"_27803":259,"_5":28142,"_19261":46010,"_26299":46011,"_2667":46012},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3171":268,"_27803":259,"_5":28142,"_19261":46014,"_26299":46015,"_2667":46016},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3171":269,"_27803":259,"_5":28142,"_19261":46018,"_26299":46019,"_2667":46020},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3171":270,"_27803":259,"_19261":46022,"_5":13244,"_26299":45987,"_2667":46023},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3171":271,"_27803":259,"_19261":46025,"_5":13244,"_26299":45987,"_2667":46026},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3171":272,"_27803":259,"_19261":46028,"_5":13244,"_26299":45991,"_2667":46029},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3171":273,"_27803":259,"_19261":46031,"_5":13244,"_26299":45991,"_2667":46032},[],"Set it only when:",{"_3171":274,"_27803":259,"_19261":46034,"_5":13244,"_26299":45991,"_2667":46035},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3171":275,"_27803":259,"_19261":46037,"_5":13244,"_26299":45991,"_2667":46038},[],"that address is allocated to this Gateway",{"_3171":276,"_27803":259,"_19261":46040,"_5":13244,"_26299":45991,"_2667":46041},[],"the surrounding network already routes traffic for it to the cluster",{"_3171":277,"_27803":259,"_19261":46043,"_5":13244,"_26299":45991,"_2667":46044},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3171":278,"_27803":259,"_19261":46046,"_5":13244,"_26299":45991,"_2667":46047},[],"Keep these two settings separate:",{"_3171":279,"_27803":259,"_19261":46049,"_5":13244,"_26299":45991,"_2667":46050},[],"`gateway.addresses` requests an address for the Gateway.",{"_3171":280,"_27803":259,"_19261":46052,"_5":13244,"_26299":45991,"_2667":46053},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3171":281,"_27803":259,"_19261":46055,"_5":13244,"_26299":45991,"_2667":46056},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3171":282,"_27803":259,"_19261":46058,"_5":13244,"_26299":45995,"_2667":46059},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3171":283,"_27803":259,"_19261":46061,"_5":13244,"_26299":45995,"_2667":46062},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3171":284,"_27803":259,"_19261":46064,"_5":13244,"_26299":45999,"_2667":46065},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3171":285,"_27803":259,"_19261":46067,"_5":13244,"_26299":45999,"_2667":46068},[],"For the recommended design:",{"_3171":286,"_27803":259,"_19261":46070,"_5":13244,"_26299":45999,"_2667":46071},[],"Use only one externally exposed Lamassu Gateway.",{"_3171":287,"_27803":259,"_19261":46073,"_5":13244,"_26299":45999,"_2667":46074},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3171":288,"_27803":259,"_19261":46076,"_5":13244,"_26299":45999,"_2667":46077},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3171":289,"_27803":259,"_19261":46079,"_5":13244,"_26299":45999,"_2667":46080},[],"Point DNS at the VM's reachable address.",{"_3171":290,"_27803":259,"_19261":46082,"_5":13244,"_26299":45999,"_2667":46083},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3171":291,"_27803":259,"_19261":46085,"_5":13244,"_26299":46003,"_2667":46086},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3171":292,"_27803":259,"_19261":46088,"_5":13244,"_26299":46007,"_2667":46089},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3171":293,"_27803":259,"_19261":46091,"_5":13244,"_26299":46007,"_2667":46092},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3171":294,"_27803":259,"_19261":46094,"_5":13244,"_26299":46011,"_2667":46095},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3171":295,"_27803":259,"_19261":46097,"_5":13244,"_26299":46011,"_2667":46098},[],"Requirement",{"_3171":296,"_27803":259,"_19261":46100,"_5":13244,"_26299":46011,"_2667":46101},[],"Recommended design",{"_3171":297,"_27803":259,"_19261":46103,"_5":13244,"_26299":46011,"_2667":46104},[],"Consequence",{"_3171":298,"_27803":259,"_19261":46106,"_5":13244,"_26299":46011,"_2667":46107},[],"Several Lamassu URLs or services",{"_3171":299,"_27803":259,"_19261":46109,"_5":13244,"_26299":46011,"_2667":46110},[],"One Gateway with multiple routes",{"_3171":300,"_27803":259,"_19261":46112,"_5":13244,"_26299":46011,"_2667":46113},[],"One IP and one proxy fleet; this is the chart default",{"_3171":301,"_27803":259,"_19261":46115,"_5":13244,"_26299":46011,"_2667":46116},[],"Independent Gateways and separate external IPs",{"_3171":302,"_27803":259,"_19261":46118,"_5":13244,"_26299":46011,"_2667":46119},[],"One VIP per Gateway",{"_3171":303,"_27803":259,"_19261":46121,"_5":13244,"_26299":46011,"_2667":46122},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3171":304,"_27803":259,"_19261":46124,"_5":13244,"_26299":46011,"_2667":46125},[],"Independent Gateways on one node and one IP",{"_3171":305,"_27803":259,"_19261":46127,"_5":13244,"_26299":46011,"_2667":46128},[],"Use different external ports",{"_3171":306,"_27803":259,"_19261":46130,"_5":13244,"_26299":46011,"_2667":46131},[],"Clients must include non-standard ports",{"_3171":307,"_27803":259,"_19261":46133,"_5":13244,"_26299":46011,"_2667":46134},[],"Separate TLS/mTLS termination behind one IP",{"_3171":308,"_27803":259,"_19261":46136,"_5":13244,"_26299":46011,"_2667":46137},[],"Front-door SNI routing to internal Gateways",{"_3171":309,"_27803":259,"_19261":46139,"_5":13244,"_26299":46011,"_2667":46140},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3171":310,"_27803":259,"_19261":46142,"_5":13244,"_26299":46011,"_2667":46143},[],"Separate Gateway resources but shared proxy infrastructure",{"_3171":311,"_27803":259,"_19261":46145,"_5":13244,"_26299":46011,"_2667":46146},[],"Envoy merged-Gateway mode",{"_3171":312,"_27803":259,"_19261":46148,"_5":13244,"_26299":46011,"_2667":46149},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3171":313,"_27803":259,"_19261":46151,"_5":13244,"_26299":46011,"_2667":46152},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3171":314,"_27803":259,"_19261":46154,"_5":13244,"_26299":46011,"_2667":46155},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3171":315,"_27803":259,"_19261":46157,"_5":13244,"_26299":46011,"_2667":46158},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3171":316,"_27803":259,"_19261":46160,"_5":13244,"_26299":46011,"_2667":46161},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3171":317,"_27803":259,"_19261":46163,"_5":13244,"_26299":46015,"_2667":46164},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3171":318,"_27803":259,"_19261":46166,"_5":13244,"_26299":46015,"_2667":46167},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3171":319,"_27803":259,"_19261":46169,"_5":13244,"_26299":46015,"_2667":46170},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3171":320,"_27803":259,"_19261":46172,"_5":13244,"_26299":46015,"_2667":46173},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3171":321,"_27803":259,"_19261":46175,"_5":13244,"_26299":46015,"_2667":46176},[],"If none of those are possible, use different external ports or change the external network design.",{"_3171":322,"_27803":259,"_19261":46178,"_5":13244,"_26299":46019,"_2667":46179},[],"Check, in order:",{"_3171":323,"_27803":259,"_19261":46181,"_5":13244,"_26299":46019,"_2667":46182},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3171":324,"_27803":259,"_19261":46184,"_5":13244,"_26299":46019,"_2667":46185},[],"Its status contains the expected address.",{"_3171":325,"_27803":259,"_19261":46187,"_5":13244,"_26299":46019,"_2667":46188},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3171":326,"_27803":259,"_19261":46190,"_5":13244,"_26299":46019,"_2667":46191},[],"Port 443 reaches that address from the client network.",{"_3171":327,"_27803":259,"_19261":46193,"_5":13244,"_26299":46019,"_2667":46194},[],"DNS resolves to the externally reachable endpoint.",{"_3171":328,"_27803":259,"_19261":46196,"_5":13244,"_26299":46019,"_2667":46197},[],"The certificate contains the DNS name or IP used by the client.",{"_3171":329,"_27803":259,"_19261":46199,"_5":13244,"_26299":46019,"_2667":46200},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3171":330,"_27803":330,"_5":13570,"_2667":45328,"_28145":46202,"_19261":46203,"_26299":330},[45221,45222,45328],[],{"_3171":331,"_27803":330,"_19261":46205,"_5":13244,"_26299":330,"_2667":46206},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3171":332,"_27803":330,"_5":28142,"_19261":46208,"_26299":46209,"_2667":46210},[],"/docs/pr-preview/pr-52/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3171":333,"_27803":330,"_5":28142,"_19261":46212,"_26299":46213,"_2667":46214},[],"/docs/pr-preview/pr-52/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3171":334,"_27803":330,"_5":28142,"_19261":46216,"_26299":46217,"_2667":46218},[],"/docs/pr-preview/pr-52/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3171":335,"_27803":330,"_5":28142,"_19261":46220,"_26299":46221,"_2667":46222},[],"/docs/pr-preview/pr-52/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3171":336,"_27803":330,"_5":28142,"_19261":46224,"_26299":46225,"_2667":46226},[],"/docs/pr-preview/pr-52/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3171":337,"_27803":330,"_5":28142,"_19261":46228,"_26299":46229,"_2667":46230},[],"/docs/pr-preview/pr-52/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3171":338,"_27803":330,"_19261":46232,"_5":13244,"_26299":46209,"_2667":46233},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3171":339,"_27803":330,"_19261":46235,"_5":13244,"_26299":46213,"_2667":46236},[],"Workflow",{"_3171":340,"_27803":330,"_19261":46238,"_5":13244,"_26299":46213,"_2667":46239},[],"Use it for",{"_3171":341,"_27803":330,"_19261":46241,"_5":13244,"_26299":46213,"_2667":46242},[],"What it installs",{"_3171":342,"_27803":330,"_19261":46244,"_5":13244,"_26299":46213,"_2667":46245},[],"Helm",{"_3171":343,"_27803":330,"_19261":46247,"_5":13244,"_26299":46213,"_2667":46248},[],"Production and controlled environments",{"_3171":344,"_27803":330,"_19261":46250,"_5":13244,"_26299":46213,"_2667":46251},[],"Lamassu services and Gateway API resources",{"_3171":345,"_27803":330,"_19261":46253,"_5":13244,"_26299":46213,"_2667":45465},[],{"_3171":346,"_27803":330,"_19261":46255,"_5":13244,"_26299":46213,"_2667":46256},[],"Evaluation, demos, CI and small lab clusters",{"_3171":347,"_27803":330,"_19261":46258,"_5":13244,"_26299":46213,"_2667":46259},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3171":348,"_27803":330,"_19261":46261,"_5":13244,"_26299":46217,"_2667":46262},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3171":349,"_27803":330,"_19261":46264,"_5":13244,"_26299":46217,"_2667":46265},[],"Area",{"_3171":350,"_27803":330,"_19261":46267,"_5":13244,"_26299":46217,"_2667":46268},[],"The Lamassu chart provides",{"_3171":351,"_27803":330,"_19261":46270,"_5":13244,"_26299":46217,"_2667":46271},[],"You provide",{"_3171":352,"_27803":330,"_19261":46273,"_5":13244,"_26299":46217,"_2667":46274},[],"Lamassu applications",{"_3171":353,"_27803":330,"_19261":46276,"_5":13244,"_26299":46217,"_2667":46277},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3171":354,"_27803":330,"_19261":46279,"_5":13244,"_26299":46217,"_2667":46280},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3171":355,"_27803":330,"_19261":46282,"_5":13244,"_26299":46217,"_2667":46283},[],"PostgreSQL data",{"_3171":356,"_27803":330,"_19261":46285,"_5":13244,"_26299":46217,"_2667":46286},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3171":357,"_27803":330,"_19261":46288,"_5":13244,"_26299":46217,"_2667":46289},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3171":358,"_27803":330,"_19261":46291,"_5":13244,"_26299":46217,"_2667":46292},[],"Messaging",{"_3171":359,"_27803":330,"_19261":46294,"_5":13244,"_26299":46217,"_2667":46295},[],"RabbitMQ connection configuration for the Lamassu services",{"_3171":360,"_27803":330,"_19261":46297,"_5":13244,"_26299":46217,"_2667":46298},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3171":361,"_27803":330,"_19261":46300,"_5":13244,"_26299":46217,"_2667":46301},[],"Identity",{"_3171":362,"_27803":330,"_19261":46303,"_5":13244,"_26299":46217,"_2667":46304},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3171":363,"_27803":330,"_19261":46306,"_5":13244,"_26299":46217,"_2667":46307},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3171":364,"_27803":330,"_19261":46309,"_5":13244,"_26299":46217,"_2667":46310},[],"External routing",{"_3171":365,"_27803":330,"_19261":46312,"_5":13244,"_26299":46217,"_2667":46313},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3171":366,"_27803":330,"_19261":46315,"_5":13244,"_26299":46217,"_2667":46316},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3171":367,"_27803":330,"_19261":46318,"_5":13244,"_26299":46217,"_2667":46319},[],"TLS",{"_3171":368,"_27803":330,"_19261":46321,"_5":13244,"_26299":46217,"_2667":46322},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3171":369,"_27803":330,"_19261":46324,"_5":13244,"_26299":46217,"_2667":46325},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3171":370,"_27803":330,"_19261":46327,"_5":13244,"_26299":46217,"_2667":46328},[],"Persistent application data",{"_3171":371,"_27803":330,"_19261":46330,"_5":13244,"_26299":46217,"_2667":46331},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3171":372,"_27803":330,"_19261":46333,"_5":13244,"_26299":46217,"_2667":46334},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3171":373,"_27803":330,"_19261":46336,"_5":13244,"_26299":46217,"_2667":46337},[],"Optional integrations",{"_3171":374,"_27803":330,"_19261":46339,"_5":13244,"_26299":46217,"_2667":46340},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3171":375,"_27803":330,"_19261":46342,"_5":13244,"_26299":46217,"_2667":46343},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3171":376,"_27803":330,"_19261":46345,"_5":13244,"_26299":46217,"_2667":46346},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3171":377,"_27803":330,"_19261":46348,"_5":13244,"_26299":46217,"_2667":46349},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3171":378,"_27803":330,"_19261":46351,"_5":13244,"_26299":46221,"_2667":46352},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3171":379,"_27803":330,"_19261":46354,"_5":13244,"_26299":46221,"_2667":46355},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3171":380,"_27803":330,"_19261":46357,"_5":13244,"_26299":46225,"_2667":46358},[],"Kubernetes 1.24 or newer",{"_3171":381,"_27803":330,"_19261":46360,"_5":13244,"_26299":46225,"_2667":46361},[],"Helm 3.2 or newer",{"_3171":382,"_27803":330,"_19261":46363,"_5":13244,"_26299":46225,"_2667":46364},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3171":383,"_27803":330,"_19261":46366,"_5":13244,"_26299":46225,"_2667":46367},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3171":384,"_27803":330,"_19261":46369,"_5":13244,"_26299":46225,"_2667":46370},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3171":385,"_27803":330,"_19261":46372,"_5":13244,"_26299":46225,"_2667":46373},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3171":386,"_27803":330,"_19261":46375,"_5":13244,"_26299":46225,"_2667":46376},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3171":387,"_27803":330,"_19261":46378,"_5":13244,"_26299":46229,"_2667":46379},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3171":388,"_27803":330,"_19261":46381,"_5":13244,"_26299":46229,"_2667":46382},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3171":389,"_27803":330,"_19261":46384,"_5":13244,"_26299":46229,"_2667":46385},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3171":390,"_27803":330,"_19261":46387,"_5":13244,"_26299":46229,"_2667":46388},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3171":391,"_27803":391,"_5":13570,"_2667":46390,"_28145":46391,"_19261":46393,"_26299":391},"Deployment troubleshooting",[45221,45222,46392],"Operations",[],{"_3171":392,"_27803":391,"_19261":46395,"_5":13244,"_26299":391,"_2667":46396},[],"Diagnose access, service health and infrastructure dependencies.",{"_3171":393,"_27803":391,"_5":28142,"_19261":46398,"_26299":46399,"_2667":46400},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3171":394,"_27803":391,"_5":28142,"_19261":46402,"_26299":46403,"_2667":46404},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3171":395,"_27803":391,"_5":28142,"_19261":46406,"_26299":46407,"_2667":46408},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3171":396,"_27803":391,"_5":28142,"_19261":46410,"_26299":46411,"_2667":46412},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3171":397,"_27803":391,"_5":28142,"_19261":46414,"_26299":46415,"_2667":46416},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3171":398,"_27803":391,"_5":28142,"_19261":46418,"_26299":46419,"_2667":46420},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3171":399,"_27803":391,"_5":28142,"_19261":46422,"_26299":46423,"_2667":46424},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3171":400,"_27803":391,"_5":28142,"_19261":46426,"_26299":46427,"_2667":46428},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3171":401,"_27803":391,"_5":28142,"_19261":46430,"_26299":46431,"_2667":46432},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3171":402,"_27803":391,"_5":28142,"_19261":46434,"_26299":46435,"_2667":46436},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3171":403,"_27803":391,"_5":28142,"_19261":46438,"_26299":46439,"_2667":46440},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3171":404,"_27803":391,"_5":28142,"_19261":46442,"_26299":46443,"_2667":46444},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#observability","Observability",{"_3171":405,"_27803":391,"_19261":46446,"_5":13244,"_26299":391,"_2667":46447},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3171":406,"_27803":391,"_19261":46449,"_5":13244,"_26299":46403,"_2667":46450},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3171":407,"_27803":391,"_19261":46452,"_5":13244,"_26299":46407,"_2667":46453},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3171":408,"_27803":391,"_19261":46455,"_5":13244,"_26299":46411,"_2667":46456},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3171":409,"_27803":391,"_19261":46458,"_5":13244,"_26299":46415,"_2667":46459},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3171":410,"_27803":391,"_19261":46461,"_5":13244,"_26299":46419,"_2667":46462},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3171":411,"_27803":391,"_19261":46464,"_5":13244,"_26299":46423,"_2667":46465},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3171":412,"_27803":391,"_19261":46467,"_5":13244,"_26299":46423,"_2667":46468},[],"Also run the chart's connectivity test:",{"_3171":413,"_27803":391,"_19261":46470,"_5":13244,"_26299":46423,"_2667":46471},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3171":414,"_27803":391,"_19261":46473,"_5":13244,"_26299":46423,"_2667":46474},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3171":415,"_27803":391,"_19261":46476,"_5":13244,"_26299":46427,"_2667":46477},[],"If you receive a 401:",{"_3171":416,"_27803":391,"_19261":46479,"_5":13244,"_26299":46427,"_2667":46480},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3171":417,"_27803":391,"_19261":46482,"_5":13244,"_26299":46427,"_2667":46483},[],"verify issuer, audience and expiration of the token;",{"_3171":418,"_27803":391,"_19261":46485,"_5":13244,"_26299":46427,"_2667":46486},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3171":419,"_27803":391,"_19261":46488,"_5":13244,"_26299":46427,"_2667":46489},[],"check that the provider's public and internal routes point to the same realm.",{"_3171":420,"_27803":391,"_19261":46491,"_5":13244,"_26299":46427,"_2667":46492},[],"If login succeeds but the APIs return 403:",{"_3171":421,"_27803":391,"_19261":46494,"_5":13244,"_26299":46427,"_2667":46495},[],"inspect the token's real claims;",{"_3171":422,"_27803":391,"_19261":46497,"_5":13244,"_26299":46427,"_2667":46498},[],"confirm they match an active principal;",{"_3171":423,"_27803":391,"_19261":46500,"_5":13244,"_26299":46427,"_2667":46501},[],"review the policies granted to that principal;",{"_3171":424,"_27803":391,"_19261":46503,"_5":13244,"_26299":46427,"_2667":46504},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3171":425,"_27803":391,"_19261":46506,"_5":13244,"_26299":46427,"_2667":46507},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3171":426,"_27803":391,"_19261":46509,"_5":13244,"_26299":46431,"_2667":46510},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3171":427,"_27803":391,"_19261":46512,"_5":13244,"_26299":46431,"_2667":46513},[],"Locate the authz pod and Service.",{"_3171":428,"_27803":391,"_19261":46515,"_5":13244,"_26299":46431,"_2667":46516},[],"Check /health, logs and its database connection.",{"_3171":429,"_27803":391,"_19261":46518,"_5":13244,"_26299":46431,"_2667":46519},[],"Verify the DNS and port configured in externalAuthorization.",{"_3171":430,"_27803":391,"_19261":46521,"_5":13244,"_26299":46431,"_2667":46522},[],"Check the check route is /v1/ext\\_authz/check.",{"_3171":431,"_27803":391,"_19261":46524,"_5":13244,"_26299":46431,"_2667":46525},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3171":432,"_27803":391,"_19261":46527,"_5":13244,"_26299":46435,"_2667":46528},[],"Review kubectl describe pod first. Common causes are:",{"_3171":433,"_27803":391,"_19261":46530,"_5":13244,"_26299":46435,"_2667":46531},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3171":434,"_27803":391,"_19261":46533,"_5":13244,"_26299":46435,"_2667":46534},[],"unbound persistent volume;",{"_3171":435,"_27803":391,"_19261":46536,"_5":13244,"_26299":46435,"_2667":46537},[],"inaccessible image or incorrect pull policy;",{"_3171":436,"_27803":391,"_19261":46539,"_5":13244,"_26299":46435,"_2667":46540},[],"invalid cryptographic engine configuration;",{"_3171":437,"_27803":391,"_19261":46542,"_5":13244,"_26299":46435,"_2667":46543},[],"CPU or memory limits set too low;",{"_3171":438,"_27803":391,"_19261":46545,"_5":13244,"_26299":46435,"_2667":46546},[],"an incomplete prior migration.",{"_3171":439,"_27803":391,"_19261":46548,"_5":13244,"_26299":46435,"_2667":46549},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3171":440,"_27803":391,"_19261":46551,"_5":13244,"_26299":46435,"_2667":46552},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3171":441,"_27803":391,"_19261":46554,"_5":13244,"_26299":46439,"_2667":46555},[],"Domain and audit events depend on the bus publisher:",{"_3171":442,"_27803":391,"_19261":46557,"_5":13244,"_26299":46439,"_2667":46558},[],"verify it is enabled in the emitting service;",{"_3171":443,"_27803":391,"_19261":46560,"_5":13244,"_26299":46439,"_2667":46561},[],"check AMQP connectivity and credentials;",{"_3171":444,"_27803":391,"_19261":46563,"_5":13244,"_26299":46439,"_2667":46564},[],"review exchange, routing key, queues and consumers;",{"_3171":445,"_27803":391,"_19261":46566,"_5":13244,"_26299":46439,"_2667":46567},[],"inspect dead-letter queues;",{"_3171":446,"_27803":391,"_19261":46569,"_5":13244,"_26299":46439,"_2667":46570},[],"alert on orphan durable queues and backlog growth.",{"_3171":447,"_27803":391,"_19261":46572,"_5":13244,"_26299":46439,"_2667":46573},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3171":448,"_27803":391,"_19261":46575,"_5":13244,"_26299":46443,"_2667":46576},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_3171":449,"_27803":391,"_19261":46578,"_5":13244,"_26299":46443,"_2667":46579},[],"Before closing an incident, record:",{"_3171":450,"_27803":391,"_19261":46581,"_5":13244,"_26299":46443,"_2667":46582},[],"the confirmed cause;",{"_3171":451,"_27803":391,"_19261":46584,"_5":13244,"_26299":46443,"_2667":46585},[],"the time scope and affected resources;",{"_3171":452,"_27803":391,"_19261":46587,"_5":13244,"_26299":46443,"_2667":46588},[],"the commands or queries used;",{"_3171":453,"_27803":391,"_19261":46590,"_5":13244,"_26299":46443,"_2667":46591},[],"the applied change and how to revert it;",{"_3171":454,"_27803":391,"_19261":46593,"_5":13244,"_26299":46443,"_2667":46594},[],"validation from a consumer;",{"_3171":455,"_27803":391,"_19261":46596,"_5":13244,"_26299":46443,"_2667":46597},[],"the preventive action and its owner.",{"_3171":456,"_27803":456,"_5":13570,"_2667":46599,"_28145":46600,"_19261":46603,"_26299":456},"Access control",[45221,46601,46602],"Platform","Administration",[],{"_3171":457,"_27803":456,"_19261":46605,"_5":13244,"_26299":456,"_2667":46606},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3171":458,"_27803":456,"_5":28142,"_19261":46608,"_26299":46609,"_2667":46610},[],"/docs/pr-preview/pr-52/platform/administration/access-control#essential-concepts","Essential concepts",{"_3171":459,"_27803":456,"_5":28142,"_19261":46612,"_26299":46613,"_2667":46614},[],"/docs/pr-preview/pr-52/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3171":460,"_27803":456,"_5":28142,"_19261":46616,"_26299":46617,"_2667":46618},[],"/docs/pr-preview/pr-52/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3171":461,"_27803":456,"_5":28142,"_19261":46620,"_26299":46621,"_2667":46622},[],"/docs/pr-preview/pr-52/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3171":462,"_27803":456,"_5":28142,"_19261":46624,"_26299":46625,"_2667":46626},[],"/docs/pr-preview/pr-52/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3171":463,"_27803":456,"_5":28142,"_19261":46628,"_26299":46629,"_2667":46630},[],"/docs/pr-preview/pr-52/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3171":464,"_27803":456,"_5":28142,"_19261":46632,"_26299":46633,"_2667":46634},[],"/docs/pr-preview/pr-52/platform/administration/access-control#oidc-principals","OIDC principals",{"_3171":465,"_27803":456,"_5":28142,"_19261":46636,"_26299":46637,"_2667":46638},[],"/docs/pr-preview/pr-52/platform/administration/access-control#x509-principals","X.509 principals",{"_3171":466,"_27803":456,"_5":28142,"_19261":46640,"_26299":46641,"_2667":46642},[],"/docs/pr-preview/pr-52/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3171":467,"_27803":456,"_5":28142,"_19261":46644,"_26299":46645,"_2667":46646},[],"/docs/pr-preview/pr-52/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3171":468,"_27803":456,"_5":28142,"_19261":46648,"_26299":46649,"_2667":46650},[],"/docs/pr-preview/pr-52/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3171":469,"_27803":456,"_5":28142,"_19261":46652,"_26299":46653,"_2667":46654},[],"/docs/pr-preview/pr-52/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3171":470,"_27803":456,"_5":28142,"_19261":46656,"_26299":46657,"_2667":46658},[],"/docs/pr-preview/pr-52/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3171":471,"_27803":456,"_5":28142,"_19261":46660,"_26299":46661,"_2667":46662},[],"/docs/pr-preview/pr-52/platform/administration/access-control#http-rules","HTTP rules",{"_3171":472,"_27803":456,"_5":28142,"_19261":46664,"_26299":46665,"_2667":46666},[],"/docs/pr-preview/pr-52/platform/administration/access-control#included-policies","Included policies",{"_3171":473,"_27803":456,"_5":28142,"_19261":46668,"_26299":46669,"_2667":45857},[],"/docs/pr-preview/pr-52/platform/administration/access-control#provision-the-first-administrator",{"_3171":474,"_27803":456,"_5":28142,"_19261":46671,"_26299":46672,"_2667":46673},[],"/docs/pr-preview/pr-52/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3171":475,"_27803":456,"_5":28142,"_19261":46675,"_26299":46676,"_2667":46677},[],"/docs/pr-preview/pr-52/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3171":476,"_27803":456,"_5":28142,"_19261":46679,"_26299":46680,"_2667":46681},[],"/docs/pr-preview/pr-52/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3171":477,"_27803":456,"_5":28142,"_19261":46683,"_26299":46684,"_2667":46685},[],"/docs/pr-preview/pr-52/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3171":478,"_27803":456,"_5":28142,"_19261":46687,"_26299":46688,"_2667":46689},[],"/docs/pr-preview/pr-52/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3171":479,"_27803":456,"_5":28142,"_19261":46691,"_26299":46692,"_2667":46693},[],"/docs/pr-preview/pr-52/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3171":480,"_27803":456,"_5":28142,"_19261":46695,"_26299":46696,"_2667":46697},[],"/docs/pr-preview/pr-52/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3171":481,"_27803":456,"_5":28142,"_19261":46699,"_26299":46700,"_2667":46701},[],"/docs/pr-preview/pr-52/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3171":482,"_27803":456,"_5":28142,"_19261":46703,"_26299":46704,"_2667":46705},[],"/docs/pr-preview/pr-52/platform/administration/access-control#operational-checklist","Operational checklist",{"_3171":483,"_27803":456,"_5":28142,"_19261":46707,"_26299":46708,"_2667":46709},[],"/docs/pr-preview/pr-52/platform/administration/access-control#diagnostics","Diagnostics",{"_3171":484,"_27803":456,"_5":28142,"_19261":46711,"_26299":46712,"_2667":46713},[],"/docs/pr-preview/pr-52/platform/administration/access-control#the-response-is-401","The response is 401",{"_3171":485,"_27803":456,"_5":28142,"_19261":46715,"_26299":46716,"_2667":46717},[],"/docs/pr-preview/pr-52/platform/administration/access-control#the-response-is-403","The response is 403",{"_3171":486,"_27803":456,"_5":28142,"_19261":46719,"_26299":46720,"_2667":46721},[],"/docs/pr-preview/pr-52/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3171":487,"_27803":456,"_5":28142,"_19261":46723,"_26299":46724,"_2667":46725},[],"/docs/pr-preview/pr-52/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3171":488,"_27803":456,"_5":28142,"_19261":46727,"_26299":46728,"_2667":46729},[],"/docs/pr-preview/pr-52/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3171":489,"_27803":456,"_19261":46731,"_5":13244,"_26299":456,"_2667":46732},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3171":490,"_27803":456,"_19261":46734,"_5":13244,"_26299":456,"_2667":46735},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3171":491,"_27803":456,"_19261":46737,"_5":13244,"_26299":456,"_2667":46738},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3171":492,"_27803":456,"_19261":46740,"_5":13244,"_26299":46609,"_2667":46741},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3171":493,"_27803":456,"_19261":46743,"_5":13244,"_26299":46609,"_2667":46744},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3171":494,"_27803":456,"_19261":46746,"_5":13244,"_26299":46609,"_2667":46747},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3171":495,"_27803":456,"_19261":46749,"_5":13244,"_26299":46609,"_2667":46750},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3171":496,"_27803":456,"_19261":46752,"_5":13244,"_26299":46609,"_2667":46753},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3171":497,"_27803":456,"_19261":46755,"_5":13244,"_26299":46609,"_2667":46756},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3171":498,"_27803":456,"_19261":46758,"_5":13244,"_26299":46613,"_2667":46759},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3171":499,"_27803":456,"_19261":46761,"_5":13244,"_26299":46613,"_2667":46762},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3171":500,"_27803":456,"_19261":46764,"_5":13244,"_26299":46617,"_2667":46765},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3171":501,"_27803":456,"_19261":46767,"_5":13244,"_26299":46617,"_2667":46768},[],"The decision is made **before forwarding the request to the service**:",{"_3171":502,"_27803":456,"_19261":46770,"_5":13244,"_26299":46617,"_2667":46771},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3171":503,"_27803":456,"_19261":46773,"_5":13244,"_26299":46617,"_2667":46774},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3171":504,"_27803":456,"_19261":46776,"_5":13244,"_26299":46617,"_2667":46777},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3171":505,"_27803":456,"_19261":46779,"_5":13244,"_26299":46617,"_2667":46780},[],"It separately loads the policies granted to each principal.",{"_3171":506,"_27803":456,"_19261":46782,"_5":13244,"_26299":46617,"_2667":46783},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3171":507,"_27803":456,"_19261":46785,"_5":13244,"_26299":46617,"_2667":46786},[],"`authz` looks for an HTTP rule granting that action.",{"_3171":508,"_27803":456,"_19261":46788,"_5":13244,"_26299":46617,"_2667":46789},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3171":509,"_27803":456,"_19261":46791,"_5":13244,"_26299":46617,"_2667":46792},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3171":510,"_27803":456,"_19261":46794,"_5":13244,"_26299":46617,"_2667":46795},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3171":511,"_27803":456,"_19261":46797,"_5":13244,"_26299":46617,"_2667":46798},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3171":512,"_27803":456,"_19261":46800,"_5":13244,"_26299":46621,"_2667":46801},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3171":513,"_27803":456,"_19261":46803,"_5":13244,"_26299":46621,"_2667":46804},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3171":514,"_27803":456,"_19261":46806,"_5":13244,"_26299":46621,"_2667":46807},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3171":515,"_27803":456,"_19261":46809,"_5":13244,"_26299":46621,"_2667":46810},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3171":516,"_27803":456,"_19261":46812,"_5":13244,"_26299":46621,"_2667":46813},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3171":517,"_27803":456,"_19261":46815,"_5":13244,"_26299":46621,"_2667":46816},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3171":518,"_27803":456,"_19261":46818,"_5":13244,"_26299":46621,"_2667":46819},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3171":519,"_27803":456,"_19261":46821,"_5":13244,"_26299":46621,"_2667":46822},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3171":520,"_27803":456,"_19261":46824,"_5":13244,"_26299":46625,"_2667":46825},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3171":521,"_27803":456,"_19261":46827,"_5":13244,"_26299":46625,"_2667":46828},[],"The decision is made with the domain operation context:",{"_3171":522,"_27803":456,"_19261":46830,"_5":13244,"_26299":46625,"_2667":46831},[],"The middleware extracts the credential and resolves the matching principals.",{"_3171":523,"_27803":456,"_19261":46833,"_5":13244,"_26299":46625,"_2667":46834},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3171":524,"_27803":456,"_19261":46836,"_5":13244,"_26299":46625,"_2667":46837},[],"`authz` gathers the entity rules of the granted policies.",{"_3171":525,"_27803":456,"_19261":46839,"_5":13244,"_26299":46625,"_2667":46840},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3171":526,"_27803":456,"_19261":46842,"_5":13244,"_26299":46625,"_2667":46843},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3171":527,"_27803":456,"_19261":46845,"_5":13244,"_26299":46625,"_2667":46846},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3171":528,"_27803":456,"_19261":46848,"_5":13244,"_26299":46625,"_2667":46849},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3171":529,"_27803":456,"_19261":46851,"_5":13244,"_26299":46625,"_2667":46852},[],"Actions fall into two groups:",{"_3171":530,"_27803":456,"_19261":46854,"_5":13244,"_26299":46625,"_2667":46855},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3171":531,"_27803":456,"_19261":46857,"_5":13244,"_26299":46625,"_2667":46858},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3171":532,"_27803":456,"_19261":46860,"_5":13244,"_26299":46625,"_2667":46861},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3171":533,"_27803":456,"_19261":46863,"_5":13244,"_26299":46629,"_2667":46864},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3171":534,"_27803":456,"_19261":46866,"_5":13244,"_26299":46629,"_2667":46867},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3171":535,"_27803":456,"_19261":46869,"_5":13244,"_26299":46629,"_2667":46870},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3171":536,"_27803":456,"_19261":46872,"_5":13244,"_26299":46633,"_2667":46873},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3171":537,"_27803":456,"_19261":46875,"_5":13244,"_26299":46633,"_2667":46876},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3171":538,"_27803":456,"_19261":46878,"_5":13244,"_26299":46633,"_2667":46879},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3171":539,"_27803":456,"_19261":46881,"_5":13244,"_26299":46633,"_2667":46882},[],"The implemented operators are:",{"_3171":540,"_27803":456,"_19261":46884,"_5":13244,"_26299":46633,"_2667":46885},[],"`equals`, for exact equality;",{"_3171":541,"_27803":456,"_19261":46887,"_5":13244,"_26299":46633,"_2667":46888},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3171":542,"_27803":456,"_19261":46890,"_5":13244,"_26299":46633,"_2667":46891},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3171":543,"_27803":456,"_19261":46893,"_5":13244,"_26299":46633,"_2667":46894},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3171":544,"_27803":456,"_19261":46896,"_5":13244,"_26299":46637,"_2667":46897},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3171":545,"_27803":456,"_19261":46899,"_5":13244,"_26299":46637,"_2667":46900},[],"The available modes are:",{"_3171":546,"_27803":456,"_19261":46902,"_5":13244,"_26299":46637,"_2667":46903},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3171":547,"_27803":456,"_19261":46905,"_5":13244,"_26299":46637,"_2667":46906},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3171":548,"_27803":456,"_19261":46908,"_5":13244,"_26299":46637,"_2667":46909},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3171":549,"_27803":456,"_19261":46911,"_5":13244,"_26299":46637,"_2667":46912},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3171":550,"_27803":456,"_19261":46914,"_5":13244,"_26299":46637,"_2667":46915},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3171":551,"_27803":456,"_19261":46917,"_5":13244,"_26299":46637,"_2667":46918},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3171":552,"_27803":456,"_19261":46920,"_5":13244,"_26299":46641,"_2667":46921},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3171":553,"_27803":456,"_19261":46923,"_5":13244,"_26299":46641,"_2667":46924},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3171":554,"_27803":456,"_19261":46926,"_5":13244,"_26299":46641,"_2667":46927},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3171":555,"_27803":456,"_19261":46929,"_5":13244,"_26299":46641,"_2667":46930},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3171":556,"_27803":456,"_19261":46932,"_5":13244,"_26299":46649,"_2667":46933},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3171":557,"_27803":456,"_19261":46935,"_5":13244,"_26299":46649,"_2667":46936},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3171":558,"_27803":456,"_19261":46938,"_5":13244,"_26299":46653,"_2667":46939},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3171":559,"_27803":456,"_19261":46941,"_5":13244,"_26299":46653,"_2667":46942},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3171":560,"_27803":456,"_19261":46944,"_5":13244,"_26299":46657,"_2667":46945},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3171":561,"_27803":456,"_19261":46947,"_5":13244,"_26299":46657,"_2667":46948},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3171":562,"_27803":456,"_19261":46950,"_5":13244,"_26299":46657,"_2667":46951},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3171":563,"_27803":456,"_19261":46953,"_5":13244,"_26299":46661,"_2667":46954},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3171":564,"_27803":456,"_19261":46956,"_5":13244,"_26299":46661,"_2667":46957},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3171":565,"_27803":456,"_19261":46959,"_5":13244,"_26299":46661,"_2667":46960},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3171":566,"_27803":456,"_19261":46962,"_5":13244,"_26299":46661,"_2667":46963},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3171":567,"_27803":456,"_19261":46965,"_5":13244,"_26299":46661,"_2667":46966},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3171":568,"_27803":456,"_19261":46968,"_5":13244,"_26299":46661,"_2667":46969},[],"Note that:",{"_3171":569,"_27803":456,"_19261":46971,"_5":13244,"_26299":46661,"_2667":46972},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3171":570,"_27803":456,"_19261":46974,"_5":13244,"_26299":46661,"_2667":46975},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3171":571,"_27803":456,"_19261":46977,"_5":13244,"_26299":46661,"_2667":46978},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3171":572,"_27803":456,"_19261":46980,"_5":13244,"_26299":46665,"_2667":46981},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3171":573,"_27803":456,"_19261":46983,"_5":13244,"_26299":46665,"_2667":46984},[],"full and read-only access to certificates and authorities;",{"_3171":574,"_27803":456,"_19261":46986,"_5":13244,"_26299":46665,"_2667":46987},[],"full and read-only access to the KMS;",{"_3171":575,"_27803":456,"_19261":46989,"_5":13244,"_26299":46665,"_2667":46990},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3171":576,"_27803":456,"_19261":46992,"_5":13244,"_26299":46665,"_2667":46993},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3171":577,"_27803":456,"_19261":46995,"_5":13244,"_26299":46665,"_2667":46996},[],"console access;",{"_3171":578,"_27803":456,"_19261":46998,"_5":13244,"_26299":46665,"_2667":46999},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3171":579,"_27803":456,"_19261":47001,"_5":13244,"_26299":46665,"_2667":47002},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3171":580,"_27803":456,"_19261":47004,"_5":13244,"_26299":46665,"_2667":47005},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3171":581,"_27803":456,"_19261":47007,"_5":13244,"_26299":46669,"_2667":47008},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3171":582,"_27803":456,"_19261":47010,"_5":13244,"_26299":46669,"_2667":47011},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3171":583,"_27803":456,"_19261":47013,"_5":13244,"_26299":46669,"_2667":47014},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3171":584,"_27803":456,"_19261":47016,"_5":13244,"_26299":46672,"_2667":47017},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3171":585,"_27803":456,"_19261":47019,"_5":13244,"_26299":46676,"_2667":47020},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3171":586,"_27803":456,"_19261":47022,"_5":13244,"_26299":46676,"_2667":47023},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3171":587,"_27803":456,"_19261":47025,"_5":13244,"_26299":46680,"_2667":47026},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3171":588,"_27803":456,"_19261":47028,"_5":13244,"_26299":46684,"_2667":47029},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3171":589,"_27803":456,"_19261":47031,"_5":13244,"_26299":46688,"_2667":47032},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3171":590,"_27803":456,"_19261":47034,"_5":13244,"_26299":46692,"_2667":47035},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3171":591,"_27803":456,"_19261":47037,"_5":13244,"_26299":46692,"_2667":47038},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3171":592,"_27803":456,"_19261":47040,"_5":13244,"_26299":46696,"_2667":47041},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3171":593,"_27803":456,"_19261":47043,"_5":13244,"_26299":46696,"_2667":47044},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3171":594,"_27803":456,"_19261":47046,"_5":13244,"_26299":46696,"_2667":47047},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3171":595,"_27803":456,"_19261":47049,"_5":13244,"_26299":46696,"_2667":47050},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3171":596,"_27803":456,"_19261":47052,"_5":13244,"_26299":46696,"_2667":47053},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3171":597,"_27803":456,"_19261":47055,"_5":13244,"_26299":46696,"_2667":47056},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3171":598,"_27803":456,"_19261":47058,"_5":13244,"_26299":46696,"_2667":47059},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3171":599,"_27803":456,"_19261":47061,"_5":13244,"_26299":46696,"_2667":47062},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3171":600,"_27803":456,"_19261":47064,"_5":13244,"_26299":46700,"_2667":47065},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3171":601,"_27803":456,"_19261":47067,"_5":13244,"_26299":46700,"_2667":47068},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3171":602,"_27803":456,"_19261":47070,"_5":13244,"_26299":46700,"_2667":47071},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3171":603,"_27803":456,"_19261":47073,"_5":13244,"_26299":46704,"_2667":47074},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3171":604,"_27803":456,"_19261":47076,"_5":13244,"_26299":46704,"_2667":47077},[],"Use groups or stable roles for people and independent identities for automations.",{"_3171":605,"_27803":456,"_19261":47079,"_5":13244,"_26299":46704,"_2667":47080},[],"Keep at least two recovery administrators and test their access periodically.",{"_3171":606,"_27803":456,"_19261":47082,"_5":13244,"_26299":46704,"_2667":47083},[],"Review active principals, their matches and their grants after IdP changes.",{"_3171":607,"_27803":456,"_19261":47085,"_5":13244,"_26299":46704,"_2667":47086},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3171":608,"_27803":456,"_19261":47088,"_5":13244,"_26299":46704,"_2667":47089},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3171":609,"_27803":456,"_19261":47091,"_5":13244,"_26299":46704,"_2667":47092},[],"Always test one allowed and one denied operation for each role.",{"_3171":610,"_27803":456,"_19261":47094,"_5":13244,"_26299":46704,"_2667":47095},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3171":611,"_27803":456,"_19261":47097,"_5":13244,"_26299":46712,"_2667":47098},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3171":612,"_27803":456,"_19261":47100,"_5":13244,"_26299":46716,"_2667":47101},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3171":613,"_27803":456,"_19261":47103,"_5":13244,"_26299":46716,"_2667":47104},[],"that an active principal of the correct type exists;",{"_3171":614,"_27803":456,"_19261":47106,"_5":13244,"_26299":46716,"_2667":47107},[],"that the claim paths and values match the real token exactly;",{"_3171":615,"_27803":456,"_19261":47109,"_5":13244,"_26299":46716,"_2667":47110},[],"that all of the principal's conditions hold;",{"_3171":616,"_27803":456,"_19261":47112,"_5":13244,"_26299":46716,"_2667":47113},[],"that the principal has the expected policy granted;",{"_3171":617,"_27803":456,"_19261":47115,"_5":13244,"_26299":46716,"_2667":47116},[],"that the policy includes the action and the requested resource type or route;",{"_3171":618,"_27803":456,"_19261":47118,"_5":13244,"_26299":46716,"_2667":47119},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3171":619,"_27803":456,"_19261":47121,"_5":13244,"_26299":46716,"_2667":47122},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_3171":620,"_27803":456,"_19261":47124,"_5":13244,"_26299":46720,"_2667":47125},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3171":621,"_27803":456,"_19261":47127,"_5":13244,"_26299":46724,"_2667":47128},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3171":622,"_27803":456,"_19261":47130,"_5":13244,"_26299":46728,"_2667":47131},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3171":623,"_27803":456,"_19261":47133,"_5":13244,"_26299":46728,"_2667":47134},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3171":624,"_27803":624,"_5":13570,"_2667":47136,"_28145":47137,"_19261":47138,"_26299":624},"Alerts and subscriptions",[45221,46601,46602],[],{"_3171":625,"_27803":624,"_19261":47140,"_5":13244,"_26299":624,"_2667":47141},[],"Send PKI events to people and external systems.",{"_3171":626,"_27803":624,"_5":28142,"_19261":47143,"_26299":47144,"_2667":47145},[],"/docs/pr-preview/pr-52/platform/administration/alerts#how-it-works","How it works",{"_3171":627,"_27803":624,"_5":28142,"_19261":47147,"_26299":47148,"_2667":47149},[],"/docs/pr-preview/pr-52/platform/administration/alerts#available-channels","Available channels",{"_3171":628,"_27803":624,"_5":28142,"_19261":47151,"_26299":47152,"_2667":47153},[],"/docs/pr-preview/pr-52/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3171":629,"_27803":624,"_5":28142,"_19261":47155,"_26299":47156,"_2667":47157},[],"/docs/pr-preview/pr-52/platform/administration/alerts#choose-the-event","Choose the event",{"_3171":630,"_27803":624,"_5":28142,"_19261":47159,"_26299":47160,"_2667":47161},[],"/docs/pr-preview/pr-52/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3171":631,"_27803":624,"_5":28142,"_19261":47163,"_26299":47164,"_2667":47165},[],"/docs/pr-preview/pr-52/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3171":632,"_27803":624,"_5":28142,"_19261":47167,"_26299":47168,"_2667":47169},[],"/docs/pr-preview/pr-52/platform/administration/alerts#review-and-activate","Review and activate",{"_3171":633,"_27803":624,"_5":28142,"_19261":47171,"_26299":47172,"_2667":47173},[],"/docs/pr-preview/pr-52/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3171":634,"_27803":624,"_5":28142,"_19261":47175,"_26299":47176,"_2667":47177},[],"/docs/pr-preview/pr-52/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3171":635,"_27803":624,"_5":28142,"_19261":47179,"_26299":47180,"_2667":47181},[],"/docs/pr-preview/pr-52/platform/administration/alerts#event-families","Event families",{"_3171":636,"_27803":624,"_19261":47183,"_5":13244,"_26299":624,"_2667":47184},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3171":637,"_27803":624,"_19261":47186,"_5":13244,"_26299":47144,"_2667":47187},[],"A service publishes a domain event.",{"_3171":638,"_27803":624,"_19261":47189,"_5":13244,"_26299":47144,"_2667":47190},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3171":639,"_27803":624,"_19261":47192,"_5":13244,"_26299":47144,"_2667":47193},[],"Each subscription's filter decides whether it should be notified.",{"_3171":640,"_27803":624,"_19261":47195,"_5":13244,"_26299":47144,"_2667":47196},[],"Lamassu delivers the event to the configured channel.",{"_3171":641,"_27803":624,"_19261":47198,"_5":13244,"_26299":47144,"_2667":47199},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3171":642,"_27803":624,"_19261":47201,"_5":13244,"_26299":47148,"_2667":47202},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3171":643,"_27803":624,"_19261":47204,"_5":13244,"_26299":47148,"_2667":47205},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3171":644,"_27803":624,"_19261":47207,"_5":13244,"_26299":47148,"_2667":47208},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3171":645,"_27803":624,"_19261":47210,"_5":13244,"_26299":47148,"_2667":47211},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3171":646,"_27803":624,"_19261":47213,"_5":13244,"_26299":47148,"_2667":47214},[],"`apikey_options` requires `header` and `key`.",{"_3171":647,"_27803":624,"_19261":47216,"_5":13244,"_26299":47148,"_2667":47217},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3171":648,"_27803":624,"_19261":47219,"_5":13244,"_26299":47148,"_2667":47220},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3171":649,"_27803":624,"_19261":47222,"_5":13244,"_26299":47148,"_2667":47223},[],"The alerts API reference documents the full `http_client` schema.",{"_3171":650,"_27803":624,"_19261":47225,"_5":13244,"_26299":47156,"_2667":47226},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3171":651,"_27803":624,"_19261":47228,"_5":13244,"_26299":47160,"_2667":47229},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3171":652,"_27803":624,"_19261":47231,"_5":13244,"_26299":47164,"_2667":47232},[],"Add a filter if you don't want to receive every instance of the event.",{"_3171":653,"_27803":624,"_19261":47234,"_5":13244,"_26299":47164,"_2667":47235},[],"**None** notifies all instances of the event.",{"_3171":654,"_27803":624,"_19261":47237,"_5":13244,"_26299":47164,"_2667":47238},[],"**JSON Path** evaluates one or more specific fields.",{"_3171":655,"_27803":624,"_19261":47240,"_5":13244,"_26299":47164,"_2667":47241},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3171":656,"_27803":624,"_19261":47243,"_5":13244,"_26299":47164,"_2667":47244},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3171":657,"_27803":624,"_19261":47246,"_5":13244,"_26299":47164,"_2667":47247},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3171":658,"_27803":624,"_19261":47249,"_5":13244,"_26299":47168,"_2667":47250},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3171":659,"_27803":624,"_19261":47252,"_5":13244,"_26299":47172,"_2667":47253},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3171":660,"_27803":624,"_19261":47255,"_5":13244,"_26299":47172,"_2667":47256},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3171":661,"_27803":624,"_19261":47258,"_5":13244,"_26299":47172,"_2667":47259},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3171":662,"_27803":624,"_19261":47261,"_5":13244,"_26299":47172,"_2667":47262},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3171":663,"_27803":624,"_19261":47264,"_5":13244,"_26299":47172,"_2667":47265},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3171":664,"_27803":624,"_19261":47267,"_5":13244,"_26299":47172,"_2667":47268},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3171":665,"_27803":624,"_19261":47270,"_5":13244,"_26299":47172,"_2667":47271},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3171":666,"_27803":624,"_19261":47273,"_5":13244,"_26299":47172,"_2667":47274},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3171":667,"_27803":624,"_19261":47276,"_5":13244,"_26299":47176,"_2667":47277},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3171":668,"_27803":624,"_19261":47279,"_5":13244,"_26299":47180,"_2667":47280},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3171":669,"_27803":624,"_19261":47282,"_5":13244,"_26299":47180,"_2667":47283},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3171":670,"_27803":624,"_19261":47285,"_5":13244,"_26299":47180,"_2667":47286},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3171":671,"_27803":624,"_19261":47288,"_5":13244,"_26299":47180,"_2667":47289},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3171":672,"_27803":624,"_19261":47291,"_5":13244,"_26299":47180,"_2667":47292},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3171":673,"_27803":624,"_19261":47294,"_5":13244,"_26299":47180,"_2667":47295},[],"**Validation:** `va.role.crl.create`.",{"_3171":674,"_27803":624,"_19261":47297,"_5":13244,"_26299":47180,"_2667":47298},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3171":675,"_27803":624,"_19261":47300,"_5":13244,"_26299":47180,"_2667":47301},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3171":676,"_27803":676,"_5":13570,"_2667":47303,"_28145":47304,"_19261":47305,"_26299":676},"Audit logs",[45221,46601,46602],[],{"_3171":677,"_27803":676,"_19261":47307,"_5":13244,"_26299":676,"_2667":47308},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3171":678,"_27803":676,"_5":28142,"_19261":47310,"_26299":47311,"_2667":47312},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3171":679,"_27803":676,"_5":28142,"_19261":47314,"_26299":47315,"_2667":47316},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#coverage","Coverage",{"_3171":680,"_27803":676,"_5":28142,"_19261":47318,"_26299":47319,"_2667":47320},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3171":681,"_27803":676,"_5":28142,"_19261":47322,"_26299":47323,"_2667":47324},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3171":682,"_27803":676,"_5":28142,"_19261":47326,"_26299":47327,"_2667":47328},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3171":683,"_27803":676,"_5":28142,"_19261":47330,"_26299":47331,"_2667":47332},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3171":684,"_27803":676,"_5":28142,"_19261":47334,"_26299":47335,"_2667":47336},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3171":685,"_27803":676,"_5":28142,"_19261":47338,"_26299":47339,"_2667":47340},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3171":686,"_27803":676,"_5":28142,"_19261":47342,"_26299":47343,"_2667":47344},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3171":687,"_27803":676,"_5":28142,"_19261":47346,"_26299":47347,"_2667":47348},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3171":688,"_27803":676,"_5":28142,"_19261":47350,"_26299":47351,"_2667":47352},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3171":689,"_27803":676,"_19261":47354,"_5":13244,"_26299":676,"_2667":47355},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3171":690,"_27803":676,"_19261":47357,"_5":13244,"_26299":47311,"_2667":47358},[],"The audit body includes:",{"_3171":691,"_27803":676,"_19261":47360,"_5":13244,"_26299":47311,"_2667":47361},[],"input: data received by the operation;",{"_3171":692,"_27803":676,"_19261":47363,"_5":13244,"_26299":47311,"_2667":47364},[],"has\\_error: whether the service returned an error;",{"_3171":693,"_27803":676,"_19261":47366,"_5":13244,"_26299":47311,"_2667":47367},[],"output: produced result or error message;",{"_3171":694,"_27803":676,"_19261":47369,"_5":13244,"_26299":47311,"_2667":47370},[],"principals: identifiers of the principals that matched the request.",{"_3171":695,"_27803":676,"_19261":47372,"_5":13244,"_26299":47311,"_2667":47373},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3171":696,"_27803":676,"_19261":47375,"_5":13244,"_26299":47311,"_2667":47376},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3171":697,"_27803":676,"_19261":47378,"_5":13244,"_26299":47315,"_2667":47379},[],"The backend applies auditing to mutations of:",{"_3171":698,"_27803":676,"_19261":47381,"_5":13244,"_26299":47315,"_2667":47382},[],"authorities, certificates and issuance profiles;",{"_3171":699,"_27803":676,"_19261":47384,"_5":13244,"_26299":47315,"_2667":47385},[],"keys and KMS engines;",{"_3171":700,"_27803":676,"_19261":47387,"_5":13244,"_26299":47315,"_2667":47388},[],"devices and identities;",{"_3171":701,"_27803":676,"_19261":47390,"_5":13244,"_26299":47315,"_2667":47391},[],"DMSs and enrollment operations;",{"_3171":702,"_27803":676,"_19261":47393,"_5":13244,"_26299":47315,"_2667":47394},[],"validation functions and CRL;",{"_3171":703,"_27803":676,"_19261":47396,"_5":13244,"_26299":47315,"_2667":47397},[],"principals, policies and authorization grants.",{"_3171":704,"_27803":676,"_19261":47399,"_5":13244,"_26299":47315,"_2667":47400},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3171":705,"_27803":676,"_19261":47402,"_5":13244,"_26299":47319,"_2667":47403},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3171":706,"_27803":676,"_19261":47405,"_5":13244,"_26299":47319,"_2667":47406},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3171":707,"_27803":676,"_19261":47408,"_5":13244,"_26299":47319,"_2667":47409},[],"Design the consumer to:",{"_3171":708,"_27803":676,"_19261":47411,"_5":13244,"_26299":47319,"_2667":47412},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3171":709,"_27803":676,"_19261":47414,"_5":13244,"_26299":47319,"_2667":47415},[],"keep the complete CloudEvent unmodified;",{"_3171":710,"_27803":676,"_19261":47417,"_5":13244,"_26299":47319,"_2667":47418},[],"record the ingestion time and detect duplicates by ID;",{"_3171":711,"_27803":676,"_19261":47420,"_5":13244,"_26299":47319,"_2667":47421},[],"encrypt in transit and at rest;",{"_3171":712,"_27803":676,"_19261":47423,"_5":13244,"_26299":47319,"_2667":47424},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3171":713,"_27803":676,"_19261":47426,"_5":13244,"_26299":47319,"_2667":47427},[],"apply an explicit retention and legal hold policy;",{"_3171":714,"_27803":676,"_19261":47429,"_5":13244,"_26299":47319,"_2667":47430},[],"alert if it stops consuming or the pending queue grows.",{"_3171":715,"_27803":676,"_19261":47432,"_5":13244,"_26299":47323,"_2667":47433},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3171":716,"_27803":676,"_19261":47435,"_5":13244,"_26299":47323,"_2667":47436},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3171":717,"_27803":676,"_19261":47438,"_5":13244,"_26299":47331,"_2667":47439},[],"Start from the reported time and normalize every source to UTC.",{"_3171":718,"_27803":676,"_19261":47441,"_5":13244,"_26299":47335,"_2667":47442},[],"Filter by event type, service source and resource identifier.",{"_3171":719,"_27803":676,"_19261":47444,"_5":13244,"_26299":47339,"_2667":47445},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3171":720,"_27803":676,"_19261":47447,"_5":13244,"_26299":47343,"_2667":47448},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3171":721,"_27803":676,"_19261":47450,"_5":13244,"_26299":47347,"_2667":47451},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3171":722,"_27803":676,"_19261":47453,"_5":13244,"_26299":47351,"_2667":47454},[],"Generate a controlled mutation in a test environment and check that:",{"_3171":723,"_27803":676,"_19261":47456,"_5":13244,"_26299":47351,"_2667":47457},[],"a successful audit event appears;",{"_3171":724,"_27803":676,"_19261":47459,"_5":13244,"_26299":47351,"_2667":47460},[],"the principal matches the identity used;",{"_3171":725,"_27803":676,"_19261":47462,"_5":13244,"_26299":47351,"_2667":47463},[],"the consumer persists it exactly once;",{"_3171":726,"_27803":676,"_19261":47465,"_5":13244,"_26299":47351,"_2667":47466},[],"it can be retrieved by resource, actor and period;",{"_3171":727,"_27803":676,"_19261":47468,"_5":13244,"_26299":47351,"_2667":47469},[],"a consumer outage raises an alert.",{"_3171":728,"_27803":676,"_19261":47471,"_5":13244,"_26299":47351,"_2667":47472},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3171":729,"_27803":729,"_5":13570,"_2667":47474,"_28145":47475,"_19261":47476,"_26299":729},"Platform architecture",[45221,46601],[],{"_3171":730,"_27803":729,"_19261":47478,"_5":13244,"_26299":729,"_2667":47479},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3171":731,"_27803":729,"_5":28142,"_19261":47481,"_26299":47482,"_2667":47483},[],"/docs/pr-preview/pr-52/platform/concepts/architecture#control-plane","Control plane",{"_3171":732,"_27803":729,"_5":28142,"_19261":47485,"_26299":47486,"_2667":47487},[],"/docs/pr-preview/pr-52/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3171":733,"_27803":729,"_5":28142,"_19261":47489,"_26299":47490,"_2667":47491},[],"/docs/pr-preview/pr-52/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3171":734,"_27803":729,"_5":28142,"_19261":47493,"_26299":47494,"_2667":47495},[],"/docs/pr-preview/pr-52/platform/concepts/architecture#status-and-validation","Status and validation",{"_3171":735,"_27803":729,"_5":28142,"_19261":47497,"_26299":47498,"_2667":47499},[],"/docs/pr-preview/pr-52/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3171":736,"_27803":729,"_19261":47501,"_5":13244,"_26299":729,"_2667":47502},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3171":737,"_27803":729,"_19261":47504,"_5":13244,"_26299":729,"_2667":47505},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3171":738,"_27803":729,"_19261":47507,"_5":13244,"_26299":47482,"_2667":47508},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3171":739,"_27803":729,"_19261":47510,"_5":13244,"_26299":47486,"_2667":47511},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3171":740,"_27803":729,"_19261":47513,"_5":13244,"_26299":47490,"_2667":47514},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3171":741,"_27803":729,"_19261":47516,"_5":13244,"_26299":47494,"_2667":47517},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3171":742,"_27803":729,"_19261":47519,"_5":13244,"_26299":47498,"_2667":47520},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3171":743,"_27803":743,"_5":13570,"_2667":47522,"_28145":47523,"_19261":47524,"_26299":743},"How Lamassu works",[45221,46601],[],{"_3171":744,"_27803":743,"_19261":47526,"_5":13244,"_26299":743,"_2667":47527},[],"The mental model of trust, keys, certificates and devices.",{"_3171":745,"_27803":743,"_5":28142,"_19261":47529,"_26299":47530,"_2667":47531},[],"/docs/pr-preview/pr-52/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3171":746,"_27803":743,"_5":28142,"_19261":47533,"_26299":47534,"_2667":47535},[],"/docs/pr-preview/pr-52/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3171":747,"_27803":743,"_19261":47537,"_5":13244,"_26299":743,"_2667":47538},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3171":748,"_27803":743,"_19261":47540,"_5":13244,"_26299":47530,"_2667":47541},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3171":749,"_27803":743,"_19261":47543,"_5":13244,"_26299":47530,"_2667":47544},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3171":750,"_27803":743,"_19261":47546,"_5":13244,"_26299":47530,"_2667":47547},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3171":751,"_27803":743,"_19261":47549,"_5":13244,"_26299":47530,"_2667":47550},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3171":752,"_27803":743,"_19261":47552,"_5":13244,"_26299":47530,"_2667":47553},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3171":753,"_27803":743,"_19261":47555,"_5":13244,"_26299":47534,"_2667":47556},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3171":754,"_27803":743,"_19261":47558,"_5":13244,"_26299":47534,"_2667":47559},[],"A DMS relates that CA to an enrollment policy.",{"_3171":755,"_27803":743,"_19261":47561,"_5":13244,"_26299":47534,"_2667":47562},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3171":756,"_27803":743,"_19261":47564,"_5":13244,"_26299":47534,"_2667":47565},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3171":757,"_27803":743,"_19261":47567,"_5":13244,"_26299":47534,"_2667":47568},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3171":758,"_27803":743,"_19261":47570,"_5":13244,"_26299":47534,"_2667":47571},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3171":759,"_27803":743,"_19261":47573,"_5":13244,"_26299":47534,"_2667":47574},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3171":760,"_27803":760,"_5":13570,"_2667":47576,"_28145":47577,"_19261":47579,"_26299":760},"Devices and identities",[45221,46601,47578,47576],"IoT Fleets",[],{"_3171":761,"_27803":760,"_19261":47581,"_5":13244,"_26299":760,"_2667":47582},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3171":762,"_27803":760,"_5":28142,"_19261":47584,"_26299":47585,"_2667":47586},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#device-states","Device states",{"_3171":763,"_27803":760,"_5":28142,"_19261":47588,"_26299":47589,"_2667":47590},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3171":764,"_27803":760,"_5":28142,"_19261":47592,"_26299":47593,"_2667":47594},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3171":765,"_27803":760,"_5":28142,"_19261":47596,"_26299":47597,"_2667":47598},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3171":766,"_27803":760,"_5":28142,"_19261":47600,"_26299":47601,"_2667":47602},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3171":767,"_27803":760,"_5":28142,"_19261":47604,"_26299":47605,"_2667":47606},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3171":768,"_27803":760,"_5":28142,"_19261":47608,"_26299":47609,"_2667":47610},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3171":769,"_27803":760,"_5":28142,"_19261":47612,"_26299":47613,"_2667":47614},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3171":770,"_27803":760,"_5":28142,"_19261":47616,"_26299":47617,"_2667":47618},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3171":771,"_27803":760,"_5":28142,"_19261":47620,"_26299":47621,"_2667":47622},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3171":772,"_27803":760,"_5":28142,"_19261":47624,"_26299":47625,"_2667":47626},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3171":773,"_27803":760,"_19261":47628,"_5":13244,"_26299":760,"_2667":47629},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3171":774,"_27803":760,"_19261":47631,"_5":13244,"_26299":760,"_2667":47632},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3171":775,"_27803":760,"_19261":47634,"_5":13244,"_26299":47585,"_2667":47635},[],"Operational view",{"_3171":776,"_27803":760,"_19261":47637,"_5":13244,"_26299":47585,"_2667":47638},[],"Meaning",{"_3171":777,"_27803":760,"_19261":47640,"_5":13244,"_26299":47585,"_2667":47641},[],"**No Identity**",{"_3171":778,"_27803":760,"_19261":47643,"_5":13244,"_26299":47585,"_2667":47644},[],"A record exists without an associated identity.",{"_3171":779,"_27803":760,"_19261":47646,"_5":13244,"_26299":47585,"_2667":47647},[],"**Active**",{"_3171":780,"_27803":760,"_19261":47649,"_5":13244,"_26299":47585,"_2667":47650},[],"The slot is active; also check certificate dates, status and usages.",{"_3171":781,"_27803":760,"_19261":47652,"_5":13244,"_26299":47585,"_2667":47653},[],"**Renewal Pending**",{"_3171":782,"_27803":760,"_19261":47655,"_5":13244,"_26299":47585,"_2667":47656},[],"The identity is in the operational renewal window.",{"_3171":783,"_27803":760,"_19261":47658,"_5":13244,"_26299":47585,"_2667":47659},[],"**Expiring Soon**",{"_3171":784,"_27803":760,"_19261":47661,"_5":13244,"_26299":47585,"_2667":47662},[],"Expiration is approaching according to configured thresholds.",{"_3171":785,"_27803":760,"_19261":47664,"_5":13244,"_26299":47585,"_2667":47665},[],"**Expired**",{"_3171":786,"_27803":760,"_19261":47667,"_5":13244,"_26299":47585,"_2667":47668},[],"The identity has expired.",{"_3171":787,"_27803":760,"_19261":47670,"_5":13244,"_26299":47585,"_2667":47671},[],"**Revoked**",{"_3171":788,"_27803":760,"_19261":47673,"_5":13244,"_26299":47585,"_2667":47674},[],"The identity is marked revoked.",{"_3171":789,"_27803":760,"_19261":47676,"_5":13244,"_26299":47585,"_2667":47677},[],"**Decommissioned**",{"_3171":790,"_27803":760,"_19261":47679,"_5":13244,"_26299":47585,"_2667":47680},[],"The record is retired and ordinary updates do not restore operation.",{"_3171":791,"_27803":760,"_19261":47682,"_5":13244,"_26299":47585,"_2667":47683},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3171":792,"_27803":760,"_19261":47685,"_5":13244,"_26299":47589,"_2667":47686},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3171":793,"_27803":760,"_19261":47688,"_5":13244,"_26299":47589,"_2667":47689},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3171":794,"_27803":760,"_19261":47691,"_5":13244,"_26299":47589,"_2667":47692},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3171":795,"_27803":760,"_19261":47694,"_5":13244,"_26299":47589,"_2667":47695},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3171":796,"_27803":760,"_19261":47697,"_5":13244,"_26299":47593,"_2667":47698},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3171":797,"_27803":760,"_19261":47700,"_5":13244,"_26299":47597,"_2667":47701},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3171":798,"_27803":760,"_19261":47703,"_5":13244,"_26299":47601,"_2667":47704},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3171":799,"_27803":760,"_19261":47706,"_5":13244,"_26299":47605,"_2667":47707},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3171":800,"_27803":760,"_19261":47709,"_5":13244,"_26299":47609,"_2667":47710},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3171":801,"_27803":760,"_19261":47712,"_5":13244,"_26299":47609,"_2667":47713},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3171":802,"_27803":760,"_19261":47715,"_5":13244,"_26299":47613,"_2667":47716},[],"From **No Identity**, use **Assign Identity**:",{"_3171":803,"_27803":760,"_19261":47718,"_5":13244,"_26299":47613,"_2667":47719},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3171":804,"_27803":760,"_19261":47721,"_5":13244,"_26299":47613,"_2667":47722},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3171":805,"_27803":760,"_19261":47724,"_5":13244,"_26299":47613,"_2667":47725},[],"Confirm and read the serial, active version and history again.",{"_3171":806,"_27803":760,"_19261":47727,"_5":13244,"_26299":47613,"_2667":47728},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3171":807,"_27803":760,"_19261":47730,"_5":13244,"_26299":47613,"_2667":47731},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3171":808,"_27803":760,"_19261":47733,"_5":13244,"_26299":47617,"_2667":47734},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3171":809,"_27803":760,"_19261":47736,"_5":13244,"_26299":47617,"_2667":47737},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3171":810,"_27803":760,"_19261":47739,"_5":13244,"_26299":47621,"_2667":47740},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3171":811,"_27803":760,"_19261":47742,"_5":13244,"_26299":47621,"_2667":47743},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3171":812,"_27803":760,"_19261":47745,"_5":13244,"_26299":47621,"_2667":47746},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3171":813,"_27803":760,"_19261":47748,"_5":13244,"_26299":47621,"_2667":47749},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3171":814,"_27803":760,"_19261":47751,"_5":13244,"_26299":47625,"_2667":47752},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3171":815,"_27803":760,"_19261":47754,"_5":13244,"_26299":47625,"_2667":47755},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3171":816,"_27803":816,"_5":13570,"_2667":47757,"_28145":47758,"_19261":47760,"_26299":816},"Bootstrap identity and authentication",[45221,46601,47578,47576,47759],"Enrollment with PKI",[],{"_3171":817,"_27803":816,"_19261":47762,"_5":13244,"_26299":816,"_2667":47763},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3171":818,"_27803":816,"_5":28142,"_19261":47765,"_26299":47766,"_2667":47767},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3171":819,"_27803":816,"_5":28142,"_19261":47769,"_26299":47770,"_2667":47771},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3171":820,"_27803":816,"_5":28142,"_19261":47773,"_26299":47774,"_2667":47775},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3171":821,"_27803":816,"_5":28142,"_19261":47777,"_26299":47778,"_2667":47779},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3171":822,"_27803":816,"_5":28142,"_19261":47781,"_26299":47782,"_2667":47783},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3171":823,"_27803":816,"_19261":47785,"_5":13244,"_26299":816,"_2667":47786},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3171":824,"_27803":816,"_19261":47788,"_5":13244,"_26299":47766,"_2667":47789},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3171":825,"_27803":816,"_19261":47791,"_5":13244,"_26299":47766,"_2667":47792},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3171":826,"_27803":816,"_19261":47794,"_5":13244,"_26299":47770,"_2667":47795},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3171":827,"_27803":816,"_19261":47797,"_5":13244,"_26299":47770,"_2667":47798},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3171":828,"_27803":816,"_19261":47800,"_5":13244,"_26299":47770,"_2667":47801},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3171":829,"_27803":816,"_19261":47803,"_5":13244,"_26299":47774,"_2667":47804},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3171":830,"_27803":816,"_19261":47806,"_5":13244,"_26299":47774,"_2667":47807},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3171":831,"_27803":816,"_19261":47809,"_5":13244,"_26299":47778,"_2667":47810},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3171":832,"_27803":816,"_19261":47812,"_5":13244,"_26299":47778,"_2667":47813},[],"Example body:",{"_3171":833,"_27803":816,"_19261":47815,"_5":13244,"_26299":47778,"_2667":47816},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3171":834,"_27803":816,"_19261":47818,"_5":13244,"_26299":47778,"_2667":47819},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3171":835,"_27803":816,"_19261":47821,"_5":13244,"_26299":47778,"_2667":47822},[],"Continuation requires a successful HTTP response and JSON:",{"_3171":836,"_27803":816,"_19261":47824,"_5":13244,"_26299":47778,"_2667":47825},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3171":837,"_27803":816,"_19261":47827,"_5":13244,"_26299":47782,"_2667":47828},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3171":838,"_27803":816,"_19261":47830,"_5":13244,"_26299":47782,"_2667":47831},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3171":839,"_27803":839,"_5":13570,"_2667":47833,"_28145":47834,"_19261":47835,"_26299":839},"Configure and operate the DMS",[45221,46601,47578,47576,47759],[],{"_3171":840,"_27803":839,"_19261":47837,"_5":13244,"_26299":839,"_2667":47838},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3171":841,"_27803":839,"_5":28142,"_19261":47840,"_26299":47841,"_2667":45231},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3171":842,"_27803":839,"_5":28142,"_19261":47843,"_26299":47844,"_2667":47845},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3171":843,"_27803":839,"_5":28142,"_19261":47847,"_26299":47848,"_2667":47849},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3171":844,"_27803":839,"_5":28142,"_19261":47851,"_26299":47852,"_2667":47853},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3171":845,"_27803":839,"_5":28142,"_19261":47855,"_26299":47856,"_2667":47857},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3171":846,"_27803":839,"_5":28142,"_19261":47859,"_26299":47860,"_2667":47861},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3171":847,"_27803":839,"_5":28142,"_19261":47863,"_26299":47864,"_2667":47865},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3171":848,"_27803":839,"_5":28142,"_19261":47867,"_26299":47868,"_2667":47869},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3171":849,"_27803":839,"_5":28142,"_19261":47871,"_26299":47872,"_2667":47873},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3171":850,"_27803":839,"_5":28142,"_19261":47875,"_26299":47876,"_2667":47877},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3171":851,"_27803":839,"_5":28142,"_19261":47879,"_26299":47880,"_2667":47881},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3171":852,"_27803":839,"_5":28142,"_19261":47883,"_26299":47884,"_2667":47885},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3171":853,"_27803":839,"_5":28142,"_19261":47887,"_26299":47888,"_2667":47889},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3171":854,"_27803":839,"_5":28142,"_19261":47891,"_26299":47892,"_2667":47893},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3171":855,"_27803":839,"_5":28142,"_19261":47895,"_26299":47896,"_2667":47897},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3171":856,"_27803":839,"_5":28142,"_19261":47899,"_26299":47900,"_2667":47901},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3171":857,"_27803":839,"_5":28142,"_19261":47903,"_26299":47904,"_2667":47905},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3171":858,"_27803":839,"_5":28142,"_19261":47907,"_26299":47908,"_2667":47909},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3171":859,"_27803":839,"_19261":47911,"_5":13244,"_26299":839,"_2667":47912},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3171":860,"_27803":839,"_19261":47914,"_5":13244,"_26299":47841,"_2667":47915},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3171":861,"_27803":839,"_19261":47917,"_5":13244,"_26299":47841,"_2667":47918},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3171":862,"_27803":839,"_19261":47920,"_5":13244,"_26299":47848,"_2667":47921},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3171":863,"_27803":839,"_19261":47923,"_5":13244,"_26299":47852,"_2667":47924},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3171":864,"_27803":839,"_19261":47926,"_5":13244,"_26299":47856,"_2667":47927},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3171":865,"_27803":839,"_19261":47929,"_5":13244,"_26299":47860,"_2667":47930},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3171":866,"_27803":839,"_19261":47932,"_5":13244,"_26299":47864,"_2667":47933},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3171":867,"_27803":839,"_19261":47935,"_5":13244,"_26299":47872,"_2667":47936},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3171":868,"_27803":839,"_19261":47938,"_5":13244,"_26299":47872,"_2667":47939},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3171":869,"_27803":839,"_19261":47941,"_5":13244,"_26299":47876,"_2667":47942},[],"`settings.enrollment_settings` field",{"_3171":870,"_27803":839,"_19261":47944,"_5":13244,"_26299":47876,"_2667":47945},[],"Decision",{"_3171":871,"_27803":839,"_19261":47947,"_5":13244,"_26299":47876,"_2667":47948},[],"`protocol`",{"_3171":872,"_27803":839,"_19261":47950,"_5":13244,"_26299":47876,"_2667":47951},[],"`EST_RFC7030` for these operations.",{"_3171":873,"_27803":839,"_19261":47953,"_5":13244,"_26299":47876,"_2667":47954},[],"`enrollment_ca`",{"_3171":874,"_27803":839,"_19261":47956,"_5":13244,"_26299":47876,"_2667":47957},[],"ID of the signing CA.",{"_3171":875,"_27803":839,"_19261":47959,"_5":13244,"_26299":47876,"_2667":47960},[],"`verify_csr_signature`",{"_3171":876,"_27803":839,"_19261":47962,"_5":13244,"_26299":47876,"_2667":47963},[],"Keep `true` to verify CSR key possession.",{"_3171":877,"_27803":839,"_19261":47965,"_5":13244,"_26299":47876,"_2667":47966},[],"`enable_replaceable_enrollment`",{"_3171":878,"_27803":839,"_19261":47968,"_5":13244,"_26299":47876,"_2667":47969},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3171":879,"_27803":839,"_19261":47971,"_5":13244,"_26299":47876,"_2667":47972},[],"`est_rfc7030_settings.auth_mode`",{"_3171":880,"_27803":839,"_19261":47974,"_5":13244,"_26299":47876,"_2667":47975},[],"One of the four authentication modes.",{"_3171":881,"_27803":839,"_19261":47977,"_5":13244,"_26299":47876,"_2667":47978},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3171":882,"_27803":839,"_19261":47980,"_5":13244,"_26299":47880,"_2667":47981},[],"The blocks are independent:",{"_3171":883,"_27803":839,"_19261":47983,"_5":13244,"_26299":47880,"_2667":47984},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3171":884,"_27803":839,"_19261":47986,"_5":13244,"_26299":47880,"_2667":47987},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3171":885,"_27803":839,"_19261":47989,"_5":13244,"_26299":47880,"_2667":47990},[],"`auth_mode`",{"_3171":886,"_27803":839,"_19261":47992,"_5":13244,"_26299":47880,"_2667":47993},[],"Control applied in the configured operation",{"_3171":887,"_27803":839,"_19261":47995,"_5":13244,"_26299":47880,"_2667":47996},[],"`CLIENT_CERTIFICATE`",{"_3171":888,"_27803":839,"_19261":47998,"_5":13244,"_26299":47880,"_2667":47999},[],"Presented certificate validation.",{"_3171":889,"_27803":839,"_19261":48001,"_5":13244,"_26299":47880,"_2667":48002},[],"`EXTERNAL_WEBHOOK`",{"_3171":890,"_27803":839,"_19261":48004,"_5":13244,"_26299":47880,"_2667":48005},[],"Configured webhook authorization.",{"_3171":891,"_27803":839,"_19261":48007,"_5":13244,"_26299":47880,"_2667":48008},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3171":892,"_27803":839,"_19261":48010,"_5":13244,"_26299":47880,"_2667":48011},[],"Certificate validation followed by webhook approval.",{"_3171":893,"_27803":839,"_19261":48013,"_5":13244,"_26299":47880,"_2667":48014},[],"`NO_AUTH`",{"_3171":894,"_27803":839,"_19261":48016,"_5":13244,"_26299":47880,"_2667":48017},[],"No DMS requester authentication.",{"_3171":895,"_27803":839,"_19261":48019,"_5":13244,"_26299":47880,"_2667":48020},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3171":896,"_27803":839,"_19261":48022,"_5":13244,"_26299":47880,"_2667":48023},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3171":897,"_27803":839,"_19261":48025,"_5":13244,"_26299":47880,"_2667":48026},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3171":898,"_27803":839,"_19261":48028,"_5":13244,"_26299":47880,"_2667":48029},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3171":899,"_27803":839,"_19261":48031,"_5":13244,"_26299":47884,"_2667":48032},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3171":900,"_27803":839,"_19261":48034,"_5":13244,"_26299":47884,"_2667":48035},[],"`external_webhook_settings` field",{"_3171":901,"_27803":839,"_19261":48037,"_5":13244,"_26299":47884,"_2667":47945},[],{"_3171":902,"_27803":839,"_19261":48039,"_5":13244,"_26299":47884,"_2667":48040},[],"`url`",{"_3171":903,"_27803":839,"_19261":48042,"_5":13244,"_26299":47884,"_2667":48043},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3171":904,"_27803":839,"_19261":48045,"_5":13244,"_26299":47884,"_2667":48046},[],"`method`",{"_3171":905,"_27803":839,"_19261":48048,"_5":13244,"_26299":47884,"_2667":48049},[],"`POST` or `PUT`; `POST` by default.",{"_3171":906,"_27803":839,"_19261":48051,"_5":13244,"_26299":47884,"_2667":48052},[],"`name`",{"_3171":907,"_27803":839,"_19261":48054,"_5":13244,"_26299":47884,"_2667":48055},[],"Label used in service logs.",{"_3171":908,"_27803":839,"_19261":48057,"_5":13244,"_26299":47884,"_2667":48058},[],"`config.auth_mode`",{"_3171":909,"_27803":839,"_19261":48060,"_5":13244,"_26299":47884,"_2667":48061},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3171":910,"_27803":839,"_19261":48063,"_5":13244,"_26299":47884,"_2667":48064},[],"`config.apikey_options`",{"_3171":911,"_27803":839,"_19261":48066,"_5":13244,"_26299":47884,"_2667":48067},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3171":912,"_27803":839,"_19261":48069,"_5":13244,"_26299":47884,"_2667":48070},[],"`config.jwt_options`",{"_3171":913,"_27803":839,"_19261":48072,"_5":13244,"_26299":47884,"_2667":48073},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3171":914,"_27803":839,"_19261":48075,"_5":13244,"_26299":47884,"_2667":48076},[],"`config.mtls_options`",{"_3171":915,"_27803":839,"_19261":48078,"_5":13244,"_26299":47884,"_2667":48079},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3171":916,"_27803":839,"_19261":48081,"_5":13244,"_26299":47884,"_2667":48082},[],"`config.insecure_skip_verify`",{"_3171":917,"_27803":839,"_19261":48084,"_5":13244,"_26299":47884,"_2667":48085},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3171":918,"_27803":839,"_19261":48087,"_5":13244,"_26299":47884,"_2667":48088},[],"`config.call_timeout`",{"_3171":919,"_27803":839,"_19261":48090,"_5":13244,"_26299":47884,"_2667":48091},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3171":920,"_27803":839,"_19261":48093,"_5":13244,"_26299":47884,"_2667":48094},[],"Rules for that configuration:",{"_3171":921,"_27803":839,"_19261":48096,"_5":13244,"_26299":47884,"_2667":48097},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3171":922,"_27803":839,"_19261":48099,"_5":13244,"_26299":47884,"_2667":48100},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3171":923,"_27803":839,"_19261":48102,"_5":13244,"_26299":47884,"_2667":48103},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3171":924,"_27803":839,"_19261":48105,"_5":13244,"_26299":47884,"_2667":48106},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3171":925,"_27803":839,"_19261":48108,"_5":13244,"_26299":47884,"_2667":48109},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3171":926,"_27803":839,"_19261":48111,"_5":13244,"_26299":47884,"_2667":48112},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3171":927,"_27803":839,"_19261":48114,"_5":13244,"_26299":47884,"_2667":48115},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing, and if your version's console does not expose independent settings, use the DMS API.",{"_3171":928,"_27803":839,"_19261":48117,"_5":13244,"_26299":47884,"_2667":48118},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3171":929,"_27803":839,"_19261":48120,"_5":13244,"_26299":47884,"_2667":48121},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3171":930,"_27803":839,"_19261":48123,"_5":13244,"_26299":47888,"_2667":48124},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3171":931,"_27803":839,"_19261":48126,"_5":13244,"_26299":47892,"_2667":48127},[],"`settings.reenrollment_settings` field",{"_3171":932,"_27803":839,"_19261":48129,"_5":13244,"_26299":47892,"_2667":45611},[],{"_3171":933,"_27803":839,"_19261":48131,"_5":13244,"_26299":47892,"_2667":48132},[],"`reenrollment_delta`",{"_3171":934,"_27803":839,"_19261":48134,"_5":13244,"_26299":47892,"_2667":48135},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3171":935,"_27803":839,"_19261":48137,"_5":13244,"_26299":47892,"_2667":48138},[],"`preventive_delta`",{"_3171":936,"_27803":839,"_19261":48140,"_5":13244,"_26299":47892,"_2667":48141},[],"Preventive operational monitoring threshold.",{"_3171":937,"_27803":839,"_19261":48143,"_5":13244,"_26299":47892,"_2667":48144},[],"`critical_delta`",{"_3171":938,"_27803":839,"_19261":48146,"_5":13244,"_26299":47892,"_2667":48147},[],"Critical operational monitoring threshold.",{"_3171":939,"_27803":839,"_19261":48149,"_5":13244,"_26299":47892,"_2667":48150},[],"`enable_expired_renewal`",{"_3171":940,"_27803":839,"_19261":48152,"_5":13244,"_26299":47892,"_2667":48153},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3171":941,"_27803":839,"_19261":48155,"_5":13244,"_26299":47892,"_2667":48156},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3171":942,"_27803":839,"_19261":48158,"_5":13244,"_26299":47892,"_2667":48159},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3171":943,"_27803":839,"_19261":48161,"_5":13244,"_26299":47892,"_2667":48162},[],"`revoke_on_reenrollment`",{"_3171":944,"_27803":839,"_19261":48164,"_5":13244,"_26299":47892,"_2667":48165},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3171":945,"_27803":839,"_19261":48167,"_5":13244,"_26299":47892,"_2667":48168},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3171":946,"_27803":839,"_19261":48170,"_5":13244,"_26299":47896,"_2667":48171},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3171":947,"_27803":839,"_19261":48173,"_5":13244,"_26299":47900,"_2667":45605},[],{"_3171":948,"_27803":839,"_19261":48175,"_5":13244,"_26299":47900,"_2667":48176},[],"Published material",{"_3171":949,"_27803":839,"_19261":48178,"_5":13244,"_26299":47900,"_2667":48179},[],"**Include Lamassu System CA**",{"_3171":950,"_27803":839,"_19261":48181,"_5":13244,"_26299":47900,"_2667":48182},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3171":951,"_27803":839,"_19261":48184,"_5":13244,"_26299":47900,"_2667":48185},[],"**Include Enrollment CA**",{"_3171":952,"_27803":839,"_19261":48187,"_5":13244,"_26299":47900,"_2667":48188},[],"Selected issuing CA certificate.",{"_3171":953,"_27803":839,"_19261":48190,"_5":13244,"_26299":47900,"_2667":48191},[],"**Managed CAs**",{"_3171":954,"_27803":839,"_19261":48193,"_5":13244,"_26299":47900,"_2667":48194},[],"Explicitly selected CA certificates.",{"_3171":955,"_27803":839,"_19261":48196,"_5":13244,"_26299":47900,"_2667":48197},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3171":956,"_27803":839,"_19261":48199,"_5":13244,"_26299":47904,"_2667":48200},[],"**Edit** changes name, settings and metadata. Backend updates replace these complete blocks; read the DMS before sending API edits to avoid losing fields.",{"_3171":957,"_27803":839,"_19261":48202,"_5":13244,"_26299":47904,"_2667":48203},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3171":958,"_27803":839,"_19261":48205,"_5":13244,"_26299":47904,"_2667":48206},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3171":959,"_27803":839,"_19261":48208,"_5":13244,"_26299":47908,"_2667":48209},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3171":960,"_27803":960,"_5":13570,"_2667":48211,"_28145":48212,"_19261":48213,"_26299":960},"Integrate the EST client",[45221,46601,47578,47576,47759],[],{"_3171":961,"_27803":960,"_19261":48215,"_5":13244,"_26299":960,"_2667":48216},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3171":962,"_27803":960,"_5":28142,"_19261":48218,"_26299":48219,"_2667":45231},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3171":963,"_27803":960,"_5":28142,"_19261":48221,"_26299":48222,"_2667":48223},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3171":964,"_27803":960,"_5":28142,"_19261":48225,"_26299":48226,"_2667":48227},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3171":965,"_27803":960,"_5":28142,"_19261":48229,"_26299":48230,"_2667":48231},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3171":966,"_27803":960,"_5":28142,"_19261":48233,"_26299":48234,"_2667":48235},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3171":967,"_27803":960,"_5":28142,"_19261":48237,"_26299":48238,"_2667":48239},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3171":968,"_27803":960,"_19261":48241,"_5":13244,"_26299":960,"_2667":48242},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3171":969,"_27803":960,"_19261":48244,"_5":13244,"_26299":48219,"_2667":48245},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3171":970,"_27803":960,"_19261":48247,"_5":13244,"_26299":48219,"_2667":48248},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3171":971,"_27803":960,"_19261":48250,"_5":13244,"_26299":48219,"_2667":48251},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3171":972,"_27803":960,"_19261":48253,"_5":13244,"_26299":48222,"_2667":48254},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3171":973,"_27803":960,"_19261":48256,"_5":13244,"_26299":48222,"_2667":48257},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3171":974,"_27803":960,"_19261":48259,"_5":13244,"_26299":48226,"_2667":48260},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3171":975,"_27803":960,"_19261":48262,"_5":13244,"_26299":48226,"_2667":48263},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3171":976,"_27803":960,"_19261":48265,"_5":13244,"_26299":48230,"_2667":48266},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3171":977,"_27803":960,"_19261":48268,"_5":13244,"_26299":48230,"_2667":48269},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3171":978,"_27803":960,"_19261":48271,"_5":13244,"_26299":48234,"_2667":48272},[],"For a root that issues directly:",{"_3171":979,"_27803":960,"_19261":48274,"_5":13244,"_26299":48234,"_2667":48275},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3171":980,"_27803":960,"_19261":48277,"_5":13244,"_26299":48234,"_2667":48278},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3171":981,"_27803":960,"_19261":48280,"_5":13244,"_26299":48238,"_2667":48281},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3171":982,"_27803":982,"_5":13570,"_2667":48283,"_28145":48284,"_19261":48285,"_26299":982},"EST reference",[45221,46601,47578,47576,47759],[],{"_3171":983,"_27803":982,"_19261":48287,"_5":13244,"_26299":982,"_2667":48288},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3171":984,"_27803":982,"_5":28142,"_19261":48290,"_26299":48291,"_2667":48292},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3171":985,"_27803":982,"_5":28142,"_19261":48294,"_26299":48295,"_2667":20897},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3171":986,"_27803":982,"_5":28142,"_19261":48297,"_26299":48298,"_2667":24027},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3171":987,"_27803":982,"_5":28142,"_19261":48300,"_26299":48301,"_2667":24034},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3171":988,"_27803":982,"_5":28142,"_19261":48303,"_26299":48304,"_2667":23362},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3171":989,"_27803":982,"_5":28142,"_19261":48306,"_26299":48307,"_2667":48308},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3171":990,"_27803":982,"_5":28142,"_19261":48310,"_26299":48311,"_2667":48312},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3171":991,"_27803":982,"_5":28142,"_19261":48314,"_26299":48315,"_2667":48316},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3171":992,"_27803":982,"_19261":48318,"_5":13244,"_26299":982,"_2667":48319},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3171":993,"_27803":982,"_19261":48321,"_5":13244,"_26299":48291,"_2667":48322},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3171":994,"_27803":982,"_19261":48324,"_5":13244,"_26299":48291,"_2667":48325},[],"Operation",{"_3171":995,"_27803":982,"_19261":48327,"_5":13244,"_26299":48291,"_2667":48328},[],"Method",{"_3171":996,"_27803":982,"_19261":48330,"_5":13244,"_26299":48291,"_2667":48331},[],"Authentication and condition",{"_3171":997,"_27803":982,"_19261":48333,"_5":13244,"_26299":48291,"_2667":48334},[],"`/cacerts`",{"_3171":998,"_27803":982,"_19261":48336,"_5":13244,"_26299":48291,"_2667":48337},[],"GET",{"_3171":999,"_27803":982,"_19261":48339,"_5":13244,"_26299":48291,"_2667":48340},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3171":1000,"_27803":982,"_19261":48342,"_5":13244,"_26299":48291,"_2667":48343},[],"`/simpleenroll`",{"_3171":1001,"_27803":982,"_19261":48345,"_5":13244,"_26299":48291,"_2667":48346},[],"POST",{"_3171":1002,"_27803":982,"_19261":48348,"_5":13244,"_26299":48291,"_2667":48349},[],"Initial authentication and DMS registration/replacement policy.",{"_3171":1003,"_27803":982,"_19261":48351,"_5":13244,"_26299":48291,"_2667":48352},[],"`/simplereenroll`",{"_3171":1004,"_27803":982,"_19261":48354,"_5":13244,"_26299":48291,"_2667":48346},[],{"_3171":1005,"_27803":982,"_19261":48356,"_5":13244,"_26299":48291,"_2667":48357},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3171":1006,"_27803":982,"_19261":48359,"_5":13244,"_26299":48291,"_2667":48360},[],"`/serverkeygen`",{"_3171":1007,"_27803":982,"_19261":48362,"_5":13244,"_26299":48291,"_2667":48346},[],{"_3171":1008,"_27803":982,"_19261":48364,"_5":13244,"_26299":48291,"_2667":48365},[],"Initial authentication and admission; server generation enabled.",{"_3171":1009,"_27803":982,"_19261":48367,"_5":13244,"_26299":48291,"_2667":48368},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3171":1010,"_27803":982,"_19261":48370,"_5":13244,"_26299":48295,"_2667":48371},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3171":1011,"_27803":982,"_19261":48373,"_5":13244,"_26299":48295,"_2667":48374},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3171":1012,"_27803":982,"_19261":48376,"_5":13244,"_26299":48298,"_2667":48377},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3171":1013,"_27803":982,"_19261":48379,"_5":13244,"_26299":48298,"_2667":48380},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3171":1014,"_27803":982,"_19261":48382,"_5":13244,"_26299":48301,"_2667":48383},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3171":1015,"_27803":982,"_19261":48385,"_5":13244,"_26299":48301,"_2667":48386},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3171":1016,"_27803":982,"_19261":48388,"_5":13244,"_26299":48304,"_2667":48389},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3171":1017,"_27803":982,"_19261":48391,"_5":13244,"_26299":48304,"_2667":48392},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3171":1018,"_27803":982,"_19261":48394,"_5":13244,"_26299":48307,"_2667":48395},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3171":1019,"_27803":982,"_19261":48397,"_5":13244,"_26299":48307,"_2667":48398},[],"Part",{"_3171":1020,"_27803":982,"_19261":48400,"_5":13244,"_26299":48307,"_2667":48401},[],"Content after decoding its Base64",{"_3171":1021,"_27803":982,"_19261":48403,"_5":13244,"_26299":48307,"_2667":48404},[],"`application/pkcs8`",{"_3171":1022,"_27803":982,"_19261":48406,"_5":13244,"_26299":48307,"_2667":48407},[],"Unencrypted DER PKCS#8 private key.",{"_3171":1023,"_27803":982,"_19261":48409,"_5":13244,"_26299":48307,"_2667":48410},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3171":1024,"_27803":982,"_19261":48412,"_5":13244,"_26299":48307,"_2667":48413},[],"DER PKCS#7 containing the issued certificate.",{"_3171":1025,"_27803":982,"_19261":48415,"_5":13244,"_26299":48307,"_2667":48416},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3171":1026,"_27803":982,"_19261":48418,"_5":13244,"_26299":48311,"_2667":48419},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3171":1027,"_27803":982,"_19261":48421,"_5":13244,"_26299":48311,"_2667":48422},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3171":1028,"_27803":982,"_19261":48424,"_5":13244,"_26299":48311,"_2667":48425},[],"Convert and check the result:",{"_3171":1029,"_27803":982,"_19261":48427,"_5":13244,"_26299":48311,"_2667":48428},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3171":1030,"_27803":982,"_19261":48430,"_5":13244,"_26299":48315,"_2667":48431},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3171":1031,"_27803":982,"_19261":48433,"_5":13244,"_26299":48315,"_2667":48434},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3171":1032,"_27803":1032,"_5":13570,"_2667":47759,"_28145":48436,"_19261":48437,"_26299":1032},[45221,46601,47578,47576,47759],[],{"_3171":1033,"_27803":1032,"_19261":48439,"_5":13244,"_26299":1032,"_2667":48440},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3171":1034,"_27803":1032,"_5":28142,"_19261":48442,"_26299":48443,"_2667":48444},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3171":1035,"_27803":1032,"_5":28142,"_19261":48446,"_26299":48447,"_2667":48448},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3171":1036,"_27803":1032,"_5":28142,"_19261":48450,"_26299":48451,"_2667":48452},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3171":1037,"_27803":1032,"_5":28142,"_19261":48454,"_26299":48455,"_2667":48456},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3171":1038,"_27803":1032,"_19261":48458,"_5":13244,"_26299":1032,"_2667":48459},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3171":1039,"_27803":1032,"_19261":48461,"_5":13244,"_26299":48443,"_2667":48462},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3171":1040,"_27803":1032,"_19261":48464,"_5":13244,"_26299":48443,"_2667":48465},[],"The integrator installs initial EST server trust and an admission credential.",{"_3171":1041,"_27803":1032,"_19261":48467,"_5":13244,"_26299":48443,"_2667":48468},[],"The client requests an identity for its `Device ID` through EST.",{"_3171":1042,"_27803":1032,"_19261":48470,"_5":13244,"_26299":48443,"_2667":48471},[],"Certificate, device binding and key/certificate installation are checked.",{"_3171":1043,"_27803":1032,"_19261":48473,"_5":13244,"_26299":48443,"_2667":48474},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3171":1044,"_27803":1032,"_19261":48476,"_5":13244,"_26299":48443,"_2667":48477},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3171":1045,"_27803":1032,"_19261":48479,"_5":13244,"_26299":48447,"_2667":48480},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3171":1046,"_27803":1032,"_19261":48482,"_5":13244,"_26299":48447,"_2667":48483},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3171":1047,"_27803":1032,"_19261":48485,"_5":13244,"_26299":48447,"_2667":48486},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3171":1048,"_27803":1032,"_19261":48488,"_5":13244,"_26299":48447,"_2667":48489},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3171":1049,"_27803":1032,"_19261":48491,"_5":13244,"_26299":48451,"_2667":48492},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3171":1050,"_27803":1032,"_19261":48494,"_5":13244,"_26299":48451,"_2667":48495},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3171":1051,"_27803":1032,"_19261":48497,"_5":13244,"_26299":48451,"_2667":48498},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3171":1052,"_27803":1032,"_19261":48500,"_5":13244,"_26299":48451,"_2667":48501},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3171":1053,"_27803":1032,"_19261":48503,"_5":13244,"_26299":48455,"_2667":48504},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3171":1054,"_27803":1032,"_19261":48506,"_5":13244,"_26299":48455,"_2667":48507},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3171":1055,"_27803":1055,"_5":13570,"_2667":48509,"_28145":48510,"_19261":48511,"_26299":1055},"Provisioning strategies",[45221,46601,47578,47576,47759],[],{"_3171":1056,"_27803":1055,"_19261":48513,"_5":13244,"_26299":1055,"_2667":48514},[],"Choose device registration, identity authorization and key generation.",{"_3171":1057,"_27803":1055,"_5":28142,"_19261":48516,"_26299":48517,"_2667":48518},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3171":1058,"_27803":1055,"_5":28142,"_19261":48520,"_26299":48521,"_2667":48522},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3171":1059,"_27803":1055,"_5":28142,"_19261":48524,"_26299":48525,"_2667":48526},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3171":1060,"_27803":1055,"_5":28142,"_19261":48528,"_26299":48529,"_2667":48530},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3171":1061,"_27803":1055,"_5":28142,"_19261":48532,"_26299":48533,"_2667":48534},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3171":1062,"_27803":1055,"_19261":48536,"_5":13244,"_26299":1055,"_2667":48537},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3171":1063,"_27803":1055,"_19261":48539,"_5":13244,"_26299":48517,"_2667":48540},[],"Path",{"_3171":1064,"_27803":1055,"_19261":48542,"_5":13244,"_26299":48517,"_2667":48543},[],"When the device exists",{"_3171":1065,"_27803":1055,"_19261":48545,"_5":13244,"_26299":48517,"_2667":48546},[],"What to check",{"_3171":1066,"_27803":1055,"_19261":48548,"_5":13244,"_26299":48517,"_2667":48549},[],"Manual assignment",{"_3171":1067,"_27803":1055,"_19261":48551,"_5":13244,"_26299":48517,"_2667":48552},[],"An operator creates it before associating a certificate.",{"_3171":1068,"_27803":1055,"_19261":48554,"_5":13244,"_26299":48517,"_2667":48555},[],"ID, owning DMS, certificate CN and bound serial.",{"_3171":1069,"_27803":1055,"_19261":48557,"_5":13244,"_26299":48517,"_2667":48558},[],"EST with `JITP`",{"_3171":1070,"_27803":1055,"_19261":48560,"_5":13244,"_26299":48517,"_2667":48561},[],"Created for an unknown CN during `/simpleenroll`.",{"_3171":1071,"_27803":1055,"_19261":48563,"_5":13244,"_26299":48517,"_2667":48564},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3171":1072,"_27803":1055,"_19261":48566,"_5":13244,"_26299":48517,"_2667":48567},[],"EST with `PRE_REGISTRATION`",{"_3171":1073,"_27803":1055,"_19261":48569,"_5":13244,"_26299":48517,"_2667":48570},[],"Must exist before `/simpleenroll`.",{"_3171":1074,"_27803":1055,"_19261":48572,"_5":13244,"_26299":48517,"_2667":48573},[],"Approved record, same DMS and replacement conditions for your version.",{"_3171":1075,"_27803":1055,"_19261":48575,"_5":13244,"_26299":48517,"_2667":48576},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3171":1076,"_27803":1055,"_19261":48578,"_5":13244,"_26299":48517,"_2667":48579},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3171":1077,"_27803":1055,"_19261":48581,"_5":13244,"_26299":48521,"_2667":48582},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3171":1078,"_27803":1055,"_19261":48584,"_5":13244,"_26299":48521,"_2667":48585},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3171":1079,"_27803":1055,"_19261":48587,"_5":13244,"_26299":48521,"_2667":48588},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3171":1080,"_27803":1055,"_19261":48590,"_5":13244,"_26299":48525,"_2667":48591},[],"Decide initial enrollment and re-enrollment separately:",{"_3171":1081,"_27803":1055,"_19261":48593,"_5":13244,"_26299":48525,"_2667":48594},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3171":1082,"_27803":1055,"_19261":48596,"_5":13244,"_26299":48525,"_2667":48597},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3171":1083,"_27803":1055,"_19261":48599,"_5":13244,"_26299":48525,"_2667":48600},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3171":1084,"_27803":1055,"_19261":48602,"_5":13244,"_26299":48525,"_2667":48603},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3171":1085,"_27803":1055,"_19261":48605,"_5":13244,"_26299":48525,"_2667":48606},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3171":1086,"_27803":1055,"_19261":48608,"_5":13244,"_26299":48529,"_2667":45605},[],{"_3171":1087,"_27803":1055,"_19261":48610,"_5":13244,"_26299":48529,"_2667":48611},[],"Material crossing EST",{"_3171":1088,"_27803":1055,"_19261":48613,"_5":13244,"_26299":48529,"_2667":48614},[],"Device-generated key",{"_3171":1089,"_27803":1055,"_19261":48616,"_5":13244,"_26299":48529,"_2667":48617},[],"Public CSR and certificate; the key stays on the client.",{"_3171":1090,"_27803":1055,"_19261":48619,"_5":13244,"_26299":48529,"_2667":48620},[],"Existing device key",{"_3171":1091,"_27803":1055,"_19261":48622,"_5":13244,"_26299":48529,"_2667":48623},[],"CSR signed with that key and a new certificate.",{"_3171":1092,"_27803":1055,"_19261":48625,"_5":13244,"_26299":48529,"_2667":47897},[],{"_3171":1093,"_27803":1055,"_19261":48627,"_5":13244,"_26299":48529,"_2667":48628},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3171":1094,"_27803":1055,"_19261":48630,"_5":13244,"_26299":48529,"_2667":48631},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3171":1095,"_27803":1055,"_19261":48633,"_5":13244,"_26299":48533,"_2667":48634},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3171":1096,"_27803":1096,"_5":13570,"_2667":48636,"_28145":48637,"_19261":48638,"_26299":1096},"Renewal and recovery",[45221,46601,47578,47576,47759],[],{"_3171":1097,"_27803":1096,"_19261":48640,"_5":13244,"_26299":1096,"_2667":48641},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3171":1098,"_27803":1096,"_5":28142,"_19261":48643,"_26299":48644,"_2667":48645},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3171":1099,"_27803":1096,"_5":28142,"_19261":48647,"_26299":48648,"_2667":48649},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3171":1100,"_27803":1096,"_5":28142,"_19261":48651,"_26299":48652,"_2667":48653},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3171":1101,"_27803":1096,"_5":28142,"_19261":48655,"_26299":48656,"_2667":48657},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3171":1102,"_27803":1096,"_5":28142,"_19261":48659,"_26299":48660,"_2667":48661},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3171":1103,"_27803":1096,"_19261":48663,"_5":13244,"_26299":1096,"_2667":48664},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3171":1104,"_27803":1096,"_19261":48666,"_5":13244,"_26299":48644,"_2667":48667},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3171":1105,"_27803":1096,"_19261":48669,"_5":13244,"_26299":48644,"_2667":48670},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3171":1106,"_27803":1096,"_19261":48672,"_5":13244,"_26299":48644,"_2667":48673},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3171":1107,"_27803":1096,"_19261":48675,"_5":13244,"_26299":48644,"_2667":48676},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3171":1108,"_27803":1096,"_19261":48678,"_5":13244,"_26299":48648,"_2667":48679},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3171":1109,"_27803":1096,"_19261":48681,"_5":13244,"_26299":48648,"_2667":48682},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3171":1110,"_27803":1096,"_19261":48684,"_5":13244,"_26299":48652,"_2667":48685},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3171":1111,"_27803":1096,"_19261":48687,"_5":13244,"_26299":48652,"_2667":48688},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3171":1112,"_27803":1096,"_19261":48690,"_5":13244,"_26299":48652,"_2667":48691},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3171":1113,"_27803":1096,"_19261":48693,"_5":13244,"_26299":48656,"_2667":48694},[],"Situation",{"_3171":1114,"_27803":1096,"_19261":48696,"_5":13244,"_26299":48656,"_2667":48697},[],"Procedure",{"_3171":1115,"_27803":1096,"_19261":48699,"_5":13244,"_26299":48656,"_2667":48700},[],"Valid certificate, outside the window",{"_3171":1116,"_27803":1096,"_19261":48702,"_5":13244,"_26299":48656,"_2667":48703},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3171":1117,"_27803":1096,"_19261":48705,"_5":13244,"_26299":48656,"_2667":48706},[],"Expired certificate, key available",{"_3171":1118,"_27803":1096,"_19261":48708,"_5":13244,"_26299":48656,"_2667":48709},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3171":1119,"_27803":1096,"_19261":48711,"_5":13244,"_26299":48656,"_2667":48712},[],"Renewal through webhook or `NO_AUTH`",{"_3171":1120,"_27803":1096,"_19261":48714,"_5":13244,"_26299":48656,"_2667":48715},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3171":1121,"_27803":1096,"_19261":48717,"_5":13244,"_26299":48656,"_2667":48718},[],"Lost or inaccessible key",{"_3171":1122,"_27803":1096,"_19261":48720,"_5":13244,"_26299":48656,"_2667":48721},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3171":1123,"_27803":1096,"_19261":48723,"_5":13244,"_26299":48656,"_2667":48724},[],"Current identity revoked",{"_3171":1124,"_27803":1096,"_19261":48726,"_5":13244,"_26299":48656,"_2667":48727},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3171":1125,"_27803":1096,"_19261":48729,"_5":13244,"_26299":48656,"_2667":48730},[],"Device without an identity",{"_3171":1126,"_27803":1096,"_19261":48732,"_5":13244,"_26299":48656,"_2667":48733},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3171":1127,"_27803":1096,"_19261":48735,"_5":13244,"_26299":48656,"_2667":48736},[],"Retired device",{"_3171":1128,"_27803":1096,"_19261":48738,"_5":13244,"_26299":48656,"_2667":48739},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3171":1129,"_27803":1096,"_19261":48741,"_5":13244,"_26299":48656,"_2667":48742},[],"Timeout, HTTP 500 or installation failure",{"_3171":1130,"_27803":1096,"_19261":48744,"_5":13244,"_26299":48656,"_2667":48745},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3171":1131,"_27803":1096,"_19261":48747,"_5":13244,"_26299":48660,"_2667":48748},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3171":1132,"_27803":1096,"_19261":48750,"_5":13244,"_26299":48660,"_2667":48751},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3171":1133,"_27803":1133,"_5":13570,"_2667":48753,"_28145":48754,"_19261":48755,"_26299":1133},"Enrollment troubleshooting",[45221,46601,47578,47576,47759],[],{"_3171":1134,"_27803":1133,"_19261":48757,"_5":13244,"_26299":1133,"_2667":48758},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3171":1135,"_27803":1133,"_5":28142,"_19261":48760,"_26299":48761,"_2667":48762},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3171":1136,"_27803":1133,"_5":28142,"_19261":48764,"_26299":48765,"_2667":48766},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3171":1137,"_27803":1133,"_5":28142,"_19261":48768,"_26299":48769,"_2667":48316},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3171":1138,"_27803":1133,"_5":28142,"_19261":48771,"_26299":48772,"_2667":48773},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3171":1139,"_27803":1133,"_19261":48775,"_5":13244,"_26299":1133,"_2667":48776},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3171":1140,"_27803":1133,"_19261":48778,"_5":13244,"_26299":48765,"_2667":48779},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3171":1141,"_27803":1133,"_19261":48781,"_5":13244,"_26299":48765,"_2667":48782},[],"Symptom or message",{"_3171":1142,"_27803":1133,"_19261":48784,"_5":13244,"_26299":48765,"_2667":48546},[],{"_3171":1143,"_27803":1133,"_19261":48786,"_5":13244,"_26299":48765,"_2667":48787},[],"curl rejects TLS, name or issuer",{"_3171":1144,"_27803":1133,"_19261":48789,"_5":13244,"_26299":48765,"_2667":48790},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3171":1145,"_27803":1133,"_19261":48792,"_5":13244,"_26299":48765,"_2667":48793},[],"404 or missing APS",{"_3171":1146,"_27803":1133,"_19261":48795,"_5":13244,"_26299":48765,"_2667":48796},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3171":1147,"_27803":1133,"_19261":48798,"_5":13244,"_26299":48765,"_2667":48799},[],"400, CSR or format error",{"_3171":1148,"_27803":1133,"_19261":48801,"_5":13244,"_26299":48765,"_2667":48802},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3171":1149,"_27803":1133,"_19261":48804,"_5":13244,"_26299":48765,"_2667":48805},[],"Missing credential or invalid certificate",{"_3171":1150,"_27803":1133,"_19261":48807,"_5":13244,"_26299":48765,"_2667":48808},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3171":1151,"_27803":1133,"_19261":48810,"_5":13244,"_26299":48765,"_2667":48811},[],"Webhook denies, times out or responds without authorization",{"_3171":1152,"_27803":1133,"_19261":48813,"_5":13244,"_26299":48765,"_2667":48814},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3171":1153,"_27803":1133,"_19261":48816,"_5":13244,"_26299":48765,"_2667":48817},[],"`unexpected status code: <n>: redirects are not followed`",{"_3171":1154,"_27803":1133,"_19261":48819,"_5":13244,"_26299":48765,"_2667":48820},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3171":1155,"_27803":1133,"_19261":48822,"_5":13244,"_26299":48765,"_2667":48823},[],"`webhook response exceeds 1048576 bytes`",{"_3171":1156,"_27803":1133,"_19261":48825,"_5":13244,"_26299":48765,"_2667":48826},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3171":1157,"_27803":1133,"_19261":48828,"_5":13244,"_26299":48765,"_2667":48829},[],"`webhook config must not reference files`",{"_3171":1158,"_27803":1133,"_19261":48831,"_5":13244,"_26299":48765,"_2667":48832},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3171":1159,"_27803":1133,"_19261":48834,"_5":13244,"_26299":48765,"_2667":48835},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3171":1160,"_27803":1133,"_19261":48837,"_5":13244,"_26299":48765,"_2667":48838},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3171":1161,"_27803":1133,"_19261":48840,"_5":13244,"_26299":48765,"_2667":48841},[],"`webhook mTLS certificate and key are invalid: …`",{"_3171":1162,"_27803":1133,"_19261":48843,"_5":13244,"_26299":48765,"_2667":48844},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3171":1163,"_27803":1133,"_19261":48846,"_5":13244,"_26299":48765,"_2667":48847},[],"400 `struct validation error` creating or updating a DMS",{"_3171":1164,"_27803":1133,"_19261":48849,"_5":13244,"_26299":48765,"_2667":48850},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3171":1165,"_27803":1133,"_19261":48852,"_5":13244,"_26299":48765,"_2667":48853},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3171":1166,"_27803":1133,"_19261":48855,"_5":13244,"_26299":48765,"_2667":48856},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3171":1167,"_27803":1133,"_19261":48858,"_5":13244,"_26299":48765,"_2667":48859},[],"`device not preregistered`",{"_3171":1168,"_27803":1133,"_19261":48861,"_5":13244,"_26299":48765,"_2667":48862},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3171":1169,"_27803":1133,"_19261":48864,"_5":13244,"_26299":48765,"_2667":48865},[],"`forbiddenNewEnrollment`",{"_3171":1170,"_27803":1133,"_19261":48867,"_5":13244,"_26299":48765,"_2667":48868},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3171":1171,"_27803":1133,"_19261":48870,"_5":13244,"_26299":48765,"_2667":48871},[],"Different owning DMS",{"_3171":1172,"_27803":1133,"_19261":48873,"_5":13244,"_26299":48765,"_2667":48874},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3171":1173,"_27803":1133,"_19261":48876,"_5":13244,"_26299":48765,"_2667":48877},[],"`invalid RawSubject bytes`",{"_3171":1174,"_27803":1133,"_19261":48879,"_5":13244,"_26299":48765,"_2667":48880},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3171":1175,"_27803":1133,"_19261":48882,"_5":13244,"_26299":48765,"_2667":48883},[],"`invalid reenroll window`",{"_3171":1176,"_27803":1133,"_19261":48885,"_5":13244,"_26299":48765,"_2667":48886},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3171":1177,"_27803":1133,"_19261":48888,"_5":13244,"_26299":48765,"_2667":48889},[],"Current certificate revoked",{"_3171":1178,"_27803":1133,"_19261":48891,"_5":13244,"_26299":48765,"_2667":48892},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3171":1179,"_27803":1133,"_19261":48894,"_5":13244,"_26299":48765,"_2667":48895},[],"CA, profile or signing error",{"_3171":1180,"_27803":1133,"_19261":48897,"_5":13244,"_26299":48765,"_2667":48898},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3171":1181,"_27803":1133,"_19261":48900,"_5":13244,"_26299":48765,"_2667":48901},[],"HTTP 200 without a device connection",{"_3171":1182,"_27803":1133,"_19261":48903,"_5":13244,"_26299":48765,"_2667":48904},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3171":1183,"_27803":1133,"_19261":48906,"_5":13244,"_26299":48765,"_2667":48907},[],"Timeout or error after issuance",{"_3171":1184,"_27803":1133,"_19261":48909,"_5":13244,"_26299":48765,"_2667":48910},[],"New certificates, current slot and previous identity's state before retrying.",{"_3171":1185,"_27803":1133,"_19261":48912,"_5":13244,"_26299":48769,"_2667":48913},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3171":1186,"_27803":1133,"_19261":48915,"_5":13244,"_26299":48769,"_2667":48916},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3171":1187,"_27803":1133,"_19261":48918,"_5":13244,"_26299":48772,"_2667":48919},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3171":1188,"_27803":1133,"_19261":48921,"_5":13244,"_26299":48772,"_2667":48922},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3171":1189,"_27803":1133,"_19261":48924,"_5":13244,"_26299":48772,"_2667":48925},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3171":1190,"_27803":1133,"_19261":48927,"_5":13244,"_26299":48772,"_2667":48928},[],"Make one request, save headers/body and query the device and certificates.",{"_3171":1191,"_27803":1133,"_19261":48930,"_5":13244,"_26299":48772,"_2667":48931},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3171":1192,"_27803":1133,"_19261":48933,"_5":13244,"_26299":48772,"_2667":48934},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3171":1193,"_27803":1133,"_19261":48936,"_5":13244,"_26299":48772,"_2667":48937},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3171":1194,"_27803":1194,"_5":13570,"_2667":48939,"_28145":48940,"_19261":48941,"_26299":1194},"Trust distribution and updates",[45221,46601,47578,47576,47759],[],{"_3171":1195,"_27803":1194,"_19261":48943,"_5":13244,"_26299":1194,"_2667":48944},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3171":1196,"_27803":1194,"_5":28142,"_19261":48946,"_26299":48947,"_2667":48948},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3171":1197,"_27803":1194,"_5":28142,"_19261":48950,"_26299":48951,"_2667":48952},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3171":1198,"_27803":1194,"_5":28142,"_19261":48954,"_26299":48955,"_2667":48956},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3171":1199,"_27803":1194,"_5":28142,"_19261":48958,"_26299":48959,"_2667":48960},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3171":1200,"_27803":1194,"_5":28142,"_19261":48962,"_26299":48963,"_2667":48964},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3171":1201,"_27803":1194,"_19261":48966,"_5":13244,"_26299":1194,"_2667":48967},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3171":1202,"_27803":1194,"_19261":48969,"_5":13244,"_26299":48947,"_2667":48970},[],"Relationship",{"_3171":1203,"_27803":1194,"_19261":48972,"_5":13244,"_26299":48947,"_2667":48973},[],"Material prepared by its owner",{"_3171":1204,"_27803":1194,"_19261":48975,"_5":13244,"_26299":48947,"_2667":48976},[],"Device → EST server",{"_3171":1205,"_27803":1194,"_19261":48978,"_5":13244,"_26299":48947,"_2667":48979},[],"Previously verified server root, chain or pin and TLS name.",{"_3171":1206,"_27803":1194,"_19261":48981,"_5":13244,"_26299":48947,"_2667":48982},[],"DMS → requester",{"_3171":1207,"_27803":1194,"_19261":48984,"_5":13244,"_26299":48947,"_2667":48985},[],"CAs and rules authorizing initial or renewal credentials.",{"_3171":1208,"_27803":1194,"_19261":48987,"_5":13244,"_26299":48947,"_2667":48988},[],"Consumer → device",{"_3171":1209,"_27803":1194,"_19261":48990,"_5":13244,"_26299":48947,"_2667":48991},[],"Operational identity roots, intermediates, validation and permissions.",{"_3171":1210,"_27803":1194,"_19261":48993,"_5":13244,"_26299":48947,"_2667":48994},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3171":1211,"_27803":1194,"_19261":48996,"_5":13244,"_26299":48951,"_2667":48997},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3171":1212,"_27803":1194,"_19261":48999,"_5":13244,"_26299":48951,"_2667":49000},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3171":1213,"_27803":1194,"_19261":49002,"_5":13244,"_26299":48955,"_2667":49003},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3171":1214,"_27803":1194,"_19261":49005,"_5":13244,"_26299":48955,"_2667":49006},[],"Select policy-approved roots as anchors.",{"_3171":1215,"_27803":1194,"_19261":49008,"_5":13244,"_26299":48955,"_2667":49009},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3171":1216,"_27803":1194,"_19261":49011,"_5":13244,"_26299":48955,"_2667":49012},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3171":1217,"_27803":1194,"_19261":49014,"_5":13244,"_26299":48955,"_2667":49015},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3171":1218,"_27803":1194,"_19261":49017,"_5":13244,"_26299":48955,"_2667":49018},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3171":1219,"_27803":1194,"_19261":49020,"_5":13244,"_26299":48959,"_2667":49021},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3171":1220,"_27803":1194,"_19261":49023,"_5":13244,"_26299":48959,"_2667":49024},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3171":1221,"_27803":1194,"_19261":49026,"_5":13244,"_26299":48959,"_2667":49027},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3171":1222,"_27803":1194,"_19261":49029,"_5":13244,"_26299":48963,"_2667":49030},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3171":1223,"_27803":1223,"_5":13570,"_2667":49032,"_28145":49033,"_19261":49035,"_26299":1223},"AWS IoT Core",[45221,46601,47578,47576,49034],"Integrations",[],{"_3171":1224,"_27803":1223,"_19261":49037,"_5":13244,"_26299":1223,"_2667":49038},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3171":1225,"_27803":1223,"_5":28142,"_19261":49040,"_26299":49041,"_2667":49042},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3171":1226,"_27803":1223,"_5":28142,"_19261":49044,"_26299":49045,"_2667":49046},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3171":1227,"_27803":1223,"_5":28142,"_19261":49048,"_26299":49049,"_2667":49050},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3171":1228,"_27803":1223,"_5":28142,"_19261":49052,"_26299":49053,"_2667":49054},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3171":1229,"_27803":1223,"_5":28142,"_19261":49056,"_26299":49057,"_2667":49058},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3171":1230,"_27803":1223,"_5":28142,"_19261":49060,"_26299":49061,"_2667":49062},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3171":1231,"_27803":1223,"_5":28142,"_19261":49064,"_26299":49065,"_2667":49066},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3171":1232,"_27803":1223,"_5":28142,"_19261":49068,"_26299":49069,"_2667":49070},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3171":1233,"_27803":1223,"_5":28142,"_19261":49072,"_26299":49073,"_2667":49074},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3171":1234,"_27803":1223,"_5":28142,"_19261":49076,"_26299":49077,"_2667":49078},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3171":1235,"_27803":1223,"_5":28142,"_19261":49080,"_26299":49081,"_2667":49082},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3171":1236,"_27803":1223,"_5":28142,"_19261":49084,"_26299":49085,"_2667":49086},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3171":1237,"_27803":1223,"_5":28142,"_19261":49088,"_26299":49089,"_2667":49090},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3171":1238,"_27803":1223,"_5":28142,"_19261":49092,"_26299":49093,"_2667":49094},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3171":1239,"_27803":1223,"_5":28142,"_19261":49096,"_26299":49097,"_2667":49098},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3171":1240,"_27803":1223,"_5":28142,"_19261":49100,"_26299":49101,"_2667":49102},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3171":1241,"_27803":1223,"_5":28142,"_19261":49104,"_26299":49105,"_2667":49106},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3171":1242,"_27803":1223,"_5":28142,"_19261":49108,"_26299":49109,"_2667":49110},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3171":1243,"_27803":1223,"_5":28142,"_19261":49112,"_26299":49113,"_2667":49114},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3171":1244,"_27803":1223,"_5":28142,"_19261":49116,"_26299":49117,"_2667":49118},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3171":1245,"_27803":1223,"_19261":49120,"_5":13244,"_26299":1223,"_2667":49121},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3171":1246,"_27803":1223,"_19261":49123,"_5":13244,"_26299":1223,"_2667":49124},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3171":1247,"_27803":1223,"_19261":49126,"_5":13244,"_26299":1223,"_2667":49127},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3171":1248,"_27803":1223,"_19261":49129,"_5":13244,"_26299":49041,"_2667":49130},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3171":1249,"_27803":1223,"_19261":49132,"_5":13244,"_26299":49041,"_2667":49133},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3171":1250,"_27803":1223,"_19261":49135,"_5":13244,"_26299":49041,"_2667":49136},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3171":1251,"_27803":1223,"_19261":49138,"_5":13244,"_26299":49041,"_2667":49139},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3171":1252,"_27803":1223,"_19261":49141,"_5":13244,"_26299":49045,"_2667":49142},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3171":1253,"_27803":1223,"_19261":49144,"_5":13244,"_26299":49049,"_2667":49145},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3171":1254,"_27803":1223,"_19261":49147,"_5":13244,"_26299":49049,"_2667":49148},[],"IAM action",{"_3171":1255,"_27803":1223,"_19261":49150,"_5":13244,"_26299":49049,"_2667":45611},[],{"_3171":1256,"_27803":1223,"_19261":49152,"_5":13244,"_26299":49049,"_2667":49153},[],"`iot:GetRegistrationCode`",{"_3171":1257,"_27803":1223,"_19261":49155,"_5":13244,"_26299":49049,"_2667":49156},[],"Obtain the verification code for CA registration in the Primary Account",{"_3171":1258,"_27803":1223,"_19261":49158,"_5":13244,"_26299":49049,"_2667":49159},[],"`iot:RegisterCACertificate`",{"_3171":1259,"_27803":1223,"_19261":49161,"_5":13244,"_26299":49049,"_2667":49162},[],"Register the CA in AWS IoT",{"_3171":1260,"_27803":1223,"_19261":49164,"_5":13244,"_26299":49049,"_2667":49165},[],"`iot:DescribeCACertificate`",{"_3171":1261,"_27803":1223,"_19261":49167,"_5":13244,"_26299":49049,"_2667":49168},[],"Check the CA registration status",{"_3171":1262,"_27803":1223,"_19261":49170,"_5":13244,"_26299":49049,"_2667":49171},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3171":1263,"_27803":1223,"_19261":49173,"_5":13244,"_26299":49049,"_2667":49174},[],"Create or update Things in IoT Core",{"_3171":1264,"_27803":1223,"_19261":49176,"_5":13244,"_26299":49049,"_2667":49177},[],"`iot:RegisterThing`",{"_3171":1265,"_27803":1223,"_19261":49179,"_5":13244,"_26299":49049,"_2667":49180},[],"Provision Things through a template",{"_3171":1266,"_27803":1223,"_19261":49182,"_5":13244,"_26299":49049,"_2667":49183},[],"`iot:RegisterCertificate`",{"_3171":1267,"_27803":1223,"_19261":49185,"_5":13244,"_26299":49049,"_2667":49186},[],"Register device certificates",{"_3171":1268,"_27803":1223,"_19261":49188,"_5":13244,"_26299":49049,"_2667":49189},[],"`iot:UpdateCertificate`",{"_3171":1269,"_27803":1223,"_19261":49191,"_5":13244,"_26299":49049,"_2667":49192},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3171":1270,"_27803":1223,"_19261":49194,"_5":13244,"_26299":49049,"_2667":49195},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3171":1271,"_27803":1223,"_19261":49197,"_5":13244,"_26299":49049,"_2667":49198},[],"Create and attach IoT policies",{"_3171":1272,"_27803":1223,"_19261":49200,"_5":13244,"_26299":49049,"_2667":49201},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3171":1273,"_27803":1223,"_19261":49203,"_5":13244,"_26299":49049,"_2667":49204},[],"Manage Thing groups",{"_3171":1274,"_27803":1223,"_19261":49206,"_5":13244,"_26299":49049,"_2667":49207},[],"`iot:CreateProvisioningTemplate`",{"_3171":1275,"_27803":1223,"_19261":49209,"_5":13244,"_26299":49049,"_2667":49210},[],"Create JITP templates",{"_3171":1276,"_27803":1223,"_19261":49212,"_5":13244,"_26299":49049,"_2667":49213},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3171":1277,"_27803":1223,"_19261":49215,"_5":13244,"_26299":49049,"_2667":49216},[],"Read and write the Device Shadow",{"_3171":1278,"_27803":1223,"_19261":49218,"_5":13244,"_26299":49049,"_2667":49219},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3171":1279,"_27803":1223,"_19261":49221,"_5":13244,"_26299":49053,"_2667":49222},[],"Parameter",{"_3171":1280,"_27803":1223,"_19261":49224,"_5":13244,"_26299":49053,"_2667":49225},[],"Type",{"_3171":1281,"_27803":1223,"_19261":49227,"_5":13244,"_26299":49053,"_2667":49228},[],"Required",{"_3171":1282,"_27803":1223,"_19261":49230,"_5":13244,"_26299":49053,"_2667":49231},[],"Description",{"_3171":1283,"_27803":1223,"_19261":49233,"_5":13244,"_26299":49053,"_2667":49234},[],"`connector_id`",{"_3171":1284,"_27803":1223,"_19261":49236,"_5":13244,"_26299":49053,"_2667":23039},[],{"_3171":1285,"_27803":1223,"_19261":49238,"_5":13244,"_26299":49053,"_2667":49239},[],"Yes",{"_3171":1286,"_27803":1223,"_19261":49241,"_5":13244,"_26299":49053,"_2667":49242},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3171":1287,"_27803":1223,"_19261":49244,"_5":13244,"_26299":49053,"_2667":49245},[],"`aws_config.region`",{"_3171":1288,"_27803":1223,"_19261":49247,"_5":13244,"_26299":49053,"_2667":23039},[],{"_3171":1289,"_27803":1223,"_19261":49249,"_5":13244,"_26299":49053,"_2667":49239},[],{"_3171":1290,"_27803":1223,"_19261":49251,"_5":13244,"_26299":49053,"_2667":49252},[],"AWS region where the connector operates.",{"_3171":1291,"_27803":1223,"_19261":49254,"_5":13244,"_26299":49053,"_2667":49255},[],"`aws_config.auth_method`",{"_3171":1292,"_27803":1223,"_19261":49257,"_5":13244,"_26299":49053,"_2667":23039},[],{"_3171":1293,"_27803":1223,"_19261":49259,"_5":13244,"_26299":49053,"_2667":49239},[],{"_3171":1294,"_27803":1223,"_19261":49261,"_5":13244,"_26299":49053,"_2667":49262},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3171":1295,"_27803":1223,"_19261":49264,"_5":13244,"_26299":49053,"_2667":49265},[],"`aws_config.access_key_id`",{"_3171":1296,"_27803":1223,"_19261":49267,"_5":13244,"_26299":49053,"_2667":23039},[],{"_3171":1297,"_27803":1223,"_19261":49269,"_5":13244,"_26299":49053,"_2667":49270},[],"Only with `auth_method=static`",{"_3171":1298,"_27803":1223,"_19261":49272,"_5":13244,"_26299":49053,"_2667":49273},[],"AWS access key.",{"_3171":1299,"_27803":1223,"_19261":49275,"_5":13244,"_26299":49053,"_2667":49276},[],"`aws_config.secret_access_key`",{"_3171":1300,"_27803":1223,"_19261":49278,"_5":13244,"_26299":49053,"_2667":23039},[],{"_3171":1301,"_27803":1223,"_19261":49280,"_5":13244,"_26299":49053,"_2667":49270},[],{"_3171":1302,"_27803":1223,"_19261":49282,"_5":13244,"_26299":49053,"_2667":49283},[],"AWS secret key.",{"_3171":1303,"_27803":1223,"_19261":49285,"_5":13244,"_26299":49053,"_2667":49286},[],"`aws_config.session_token`",{"_3171":1304,"_27803":1223,"_19261":49288,"_5":13244,"_26299":49053,"_2667":23039},[],{"_3171":1305,"_27803":1223,"_19261":49290,"_5":13244,"_26299":49053,"_2667":49291},[],"No",{"_3171":1306,"_27803":1223,"_19261":49293,"_5":13244,"_26299":49053,"_2667":49294},[],"Session token (with `auth_method=static`).",{"_3171":1307,"_27803":1223,"_19261":49296,"_5":13244,"_26299":49053,"_2667":49297},[],"`aws_config.role_arn`",{"_3171":1308,"_27803":1223,"_19261":49299,"_5":13244,"_26299":49053,"_2667":23039},[],{"_3171":1309,"_27803":1223,"_19261":49301,"_5":13244,"_26299":49053,"_2667":49302},[],"Only with `auth_method=role`",{"_3171":1310,"_27803":1223,"_19261":49304,"_5":13244,"_26299":49053,"_2667":49305},[],"ARN of the role to assume.",{"_3171":1311,"_27803":1223,"_19261":49307,"_5":13244,"_26299":49053,"_2667":49308},[],"`aws_config.endpoint_url`",{"_3171":1312,"_27803":1223,"_19261":49310,"_5":13244,"_26299":49053,"_2667":23039},[],{"_3171":1313,"_27803":1223,"_19261":49312,"_5":13244,"_26299":49053,"_2667":49291},[],{"_3171":1314,"_27803":1223,"_19261":49314,"_5":13244,"_26299":49053,"_2667":49315},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3171":1315,"_27803":1223,"_19261":49317,"_5":13244,"_26299":49053,"_2667":49318},[],"`subscriber_event_bus`",{"_3171":1316,"_27803":1223,"_19261":49320,"_5":13244,"_26299":49053,"_2667":16234},[],{"_3171":1317,"_27803":1223,"_19261":49322,"_5":13244,"_26299":49053,"_2667":49239},[],{"_3171":1318,"_27803":1223,"_19261":49324,"_5":13244,"_26299":49053,"_2667":49325},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3171":1319,"_27803":1223,"_19261":49327,"_5":13244,"_26299":49053,"_2667":49328},[],"`dms_manager_client`",{"_3171":1320,"_27803":1223,"_19261":49330,"_5":13244,"_26299":49053,"_2667":23039},[],{"_3171":1321,"_27803":1223,"_19261":49332,"_5":13244,"_26299":49053,"_2667":49239},[],{"_3171":1322,"_27803":1223,"_19261":49334,"_5":13244,"_26299":49053,"_2667":49335},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3171":1323,"_27803":1223,"_19261":49337,"_5":13244,"_26299":49053,"_2667":49338},[],"`device_manager_client`",{"_3171":1324,"_27803":1223,"_19261":49340,"_5":13244,"_26299":49053,"_2667":23039},[],{"_3171":1325,"_27803":1223,"_19261":49342,"_5":13244,"_26299":49053,"_2667":49239},[],{"_3171":1326,"_27803":1223,"_19261":49344,"_5":13244,"_26299":49053,"_2667":49345},[],"HTTP URL of Lamassu's Device Manager.",{"_3171":1327,"_27803":1223,"_19261":49347,"_5":13244,"_26299":49053,"_2667":49348},[],"`ca_client`",{"_3171":1328,"_27803":1223,"_19261":49350,"_5":13244,"_26299":49053,"_2667":23039},[],{"_3171":1329,"_27803":1223,"_19261":49352,"_5":13244,"_26299":49053,"_2667":49239},[],{"_3171":1330,"_27803":1223,"_19261":49354,"_5":13244,"_26299":49053,"_2667":49355},[],"HTTP URL of Lamassu's CA service.",{"_3171":1331,"_27803":1223,"_19261":49357,"_5":13244,"_26299":49057,"_2667":49358},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3171":1332,"_27803":1223,"_19261":49360,"_5":13244,"_26299":49061,"_2667":49361},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3171":1333,"_27803":1223,"_19261":49363,"_5":13244,"_26299":49061,"_2667":49364},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3171":1334,"_27803":1223,"_19261":49366,"_5":13244,"_26299":49065,"_2667":49367},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3171":1335,"_27803":1223,"_19261":49369,"_5":13244,"_26299":49065,"_2667":49370},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3171":1336,"_27803":1223,"_19261":49372,"_5":13244,"_26299":49065,"_2667":49373},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3171":1337,"_27803":1223,"_19261":49375,"_5":13244,"_26299":49065,"_2667":49376},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3171":1338,"_27803":1223,"_19261":49378,"_5":13244,"_26299":49065,"_2667":49379},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3171":1339,"_27803":1223,"_19261":49381,"_5":13244,"_26299":49065,"_2667":49382},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3171":1340,"_27803":1223,"_19261":49384,"_5":13244,"_26299":49069,"_2667":49385},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3171":1341,"_27803":1223,"_19261":49387,"_5":13244,"_26299":49073,"_2667":49388},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3171":1342,"_27803":1223,"_19261":49390,"_5":13244,"_26299":49073,"_2667":49391},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3171":1343,"_27803":1223,"_19261":49393,"_5":13244,"_26299":49077,"_2667":49394},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3171":1344,"_27803":1223,"_19261":49396,"_5":13244,"_26299":49081,"_2667":49397},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3171":1345,"_27803":1223,"_19261":49399,"_5":13244,"_26299":49081,"_2667":49400},[],"Creates or updates the IoT policies configured in the DMS.",{"_3171":1346,"_27803":1223,"_19261":49402,"_5":13244,"_26299":49081,"_2667":49403},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3171":1347,"_27803":1223,"_19261":49405,"_5":13244,"_26299":49081,"_2667":49406},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3171":1348,"_27803":1223,"_19261":49408,"_5":13244,"_26299":49081,"_2667":49409},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3171":1349,"_27803":1223,"_19261":49411,"_5":13244,"_26299":49081,"_2667":49412},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3171":1350,"_27803":1223,"_19261":49414,"_5":13244,"_26299":49081,"_2667":49415},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3171":1351,"_27803":1223,"_19261":49417,"_5":13244,"_26299":49085,"_2667":49418},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3171":1352,"_27803":1223,"_19261":49420,"_5":13244,"_26299":49085,"_2667":49421},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3171":1353,"_27803":1223,"_19261":49423,"_5":13244,"_26299":49085,"_2667":49424},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3171":1354,"_27803":1223,"_19261":49426,"_5":13244,"_26299":49089,"_2667":49427},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3171":1355,"_27803":1223,"_19261":49429,"_5":13244,"_26299":49089,"_2667":49430},[],"The full flow from the device's perspective is:",{"_3171":1356,"_27803":1223,"_19261":49432,"_5":13244,"_26299":49089,"_2667":49433},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3171":1357,"_27803":1223,"_19261":49435,"_5":13244,"_26299":49093,"_2667":49436},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3171":1358,"_27803":1223,"_19261":49438,"_5":13244,"_26299":49093,"_2667":49439},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3171":1359,"_27803":1223,"_19261":49441,"_5":13244,"_26299":49093,"_2667":49442},[],"For the JITP flow to work correctly:",{"_3171":1360,"_27803":1223,"_19261":49444,"_5":13244,"_26299":49093,"_2667":49445},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3171":1361,"_27803":1223,"_19261":49447,"_5":13244,"_26299":49093,"_2667":49448},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3171":1362,"_27803":1223,"_19261":49450,"_5":13244,"_26299":49093,"_2667":49451},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3171":1363,"_27803":1223,"_19261":49453,"_5":13244,"_26299":49093,"_2667":49454},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3171":1364,"_27803":1223,"_19261":49456,"_5":13244,"_26299":49097,"_2667":49457},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3171":1365,"_27803":1223,"_19261":49459,"_5":13244,"_26299":49097,"_2667":49460},[],"Status in Lamassu",{"_3171":1366,"_27803":1223,"_19261":49462,"_5":13244,"_26299":49097,"_2667":49463},[],"Revocation reason",{"_3171":1367,"_27803":1223,"_19261":49465,"_5":13244,"_26299":49097,"_2667":49466},[],"Status in AWS IoT Core",{"_3171":1368,"_27803":1223,"_19261":49468,"_5":13244,"_26299":49097,"_2667":49469},[],"`Active`",{"_3171":1369,"_27803":1223,"_19261":49471,"_5":13244,"_26299":49097,"_2667":49472},[],"None",{"_3171":1370,"_27803":1223,"_19261":49474,"_5":13244,"_26299":49097,"_2667":49475},[],"`ACTIVE`",{"_3171":1371,"_27803":1223,"_19261":49477,"_5":13244,"_26299":49097,"_2667":49478},[],"`Revoked`",{"_3171":1372,"_27803":1223,"_19261":49480,"_5":13244,"_26299":49097,"_2667":49481},[],"`certificateHold`",{"_3171":1373,"_27803":1223,"_19261":49483,"_5":13244,"_26299":49097,"_2667":49484},[],"`INACTIVE`",{"_3171":1374,"_27803":1223,"_19261":49486,"_5":13244,"_26299":49097,"_2667":49478},[],{"_3171":1375,"_27803":1223,"_19261":49488,"_5":13244,"_26299":49097,"_2667":49489},[],"Any other reason",{"_3171":1376,"_27803":1223,"_19261":49491,"_5":13244,"_26299":49097,"_2667":49492},[],"`REVOKED`",{"_3171":1377,"_27803":1223,"_19261":49494,"_5":13244,"_26299":49097,"_2667":49495},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3171":1378,"_27803":1223,"_19261":49497,"_5":13244,"_26299":49101,"_2667":49498},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3171":1379,"_27803":1223,"_19261":49500,"_5":13244,"_26299":49101,"_2667":49501},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3171":1380,"_27803":1223,"_19261":49503,"_5":13244,"_26299":49101,"_2667":49504},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3171":1381,"_27803":1223,"_19261":49506,"_5":13244,"_26299":49105,"_2667":49507},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3171":1382,"_27803":1223,"_19261":49509,"_5":13244,"_26299":49105,"_2667":49510},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3171":1383,"_27803":1223,"_19261":49512,"_5":13244,"_26299":49109,"_2667":49513},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3171":1384,"_27803":1223,"_19261":49515,"_5":13244,"_26299":49109,"_2667":49516},[],"There are two action types:",{"_3171":1385,"_27803":1223,"_19261":49518,"_5":13244,"_26299":49109,"_2667":49519},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3171":1386,"_27803":1223,"_19261":49521,"_5":13244,"_26299":49109,"_2667":49522},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3171":1387,"_27803":1223,"_19261":49524,"_5":13244,"_26299":49109,"_2667":49525},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3171":1388,"_27803":1223,"_19261":49527,"_5":13244,"_26299":49113,"_2667":49528},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3171":1389,"_27803":1223,"_19261":49530,"_5":13244,"_26299":49113,"_2667":49531},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3171":1390,"_27803":1223,"_19261":49533,"_5":13244,"_26299":49113,"_2667":49534},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3171":1391,"_27803":1223,"_19261":49536,"_5":13244,"_26299":49117,"_2667":49537},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3171":1392,"_27803":1223,"_19261":49539,"_5":13244,"_26299":49117,"_2667":49540},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3171":1393,"_27803":1223,"_19261":49542,"_5":13244,"_26299":49117,"_2667":49543},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3171":1394,"_27803":1223,"_19261":49545,"_5":13244,"_26299":49117,"_2667":49546},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3171":1395,"_27803":1223,"_19261":49548,"_5":13244,"_26299":49117,"_2667":49549},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3171":1396,"_27803":1223,"_19261":49551,"_5":13244,"_26299":49117,"_2667":49552},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3171":1397,"_27803":1223,"_19261":49554,"_5":13244,"_26299":49117,"_2667":49555},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3171":1398,"_27803":1223,"_19261":49557,"_5":13244,"_26299":49117,"_2667":49558},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3171":1399,"_27803":1223,"_19261":49560,"_5":13244,"_26299":49117,"_2667":49561},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3171":1400,"_27803":1223,"_19261":49563,"_5":13244,"_26299":49117,"_2667":49564},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3171":1401,"_27803":1223,"_19261":49566,"_5":13244,"_26299":49117,"_2667":49567},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3171":1402,"_27803":1223,"_19261":49569,"_5":13244,"_26299":49117,"_2667":49570},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3171":1403,"_27803":1223,"_19261":49572,"_5":13244,"_26299":49117,"_2667":49573},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3171":1404,"_27803":1223,"_19261":49575,"_5":13244,"_26299":49117,"_2667":49576},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3171":1405,"_27803":1223,"_19261":49578,"_5":13244,"_26299":49117,"_2667":49579},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3171":1406,"_27803":1223,"_19261":49581,"_5":13244,"_26299":49117,"_2667":49582},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3171":1407,"_27803":1223,"_19261":49584,"_5":13244,"_26299":49117,"_2667":49585},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3171":1408,"_27803":1223,"_19261":49587,"_5":13244,"_26299":49117,"_2667":49588},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3171":1409,"_27803":1223,"_19261":49590,"_5":13244,"_26299":49117,"_2667":49591},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3171":1410,"_27803":1223,"_19261":49593,"_5":13244,"_26299":49117,"_2667":49594},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3171":1411,"_27803":1223,"_19261":49596,"_5":13244,"_26299":49117,"_2667":49597},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3171":1412,"_27803":1412,"_5":13570,"_2667":47578,"_28145":49599,"_19261":49600,"_26299":1412},[45221,46601,47578],[],{"_3171":1413,"_27803":1412,"_19261":49602,"_5":13244,"_26299":1412,"_2667":49603},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3171":1414,"_27803":1412,"_5":28142,"_19261":49605,"_26299":49606,"_2667":49607},[],"/docs/pr-preview/pr-52/platform/iot-fleets/overview#start-here","Start here",{"_3171":1415,"_27803":1412,"_5":28142,"_19261":49609,"_26299":49610,"_2667":47576},[],"/docs/pr-preview/pr-52/platform/iot-fleets/overview#devices-and-identities",{"_3171":1416,"_27803":1412,"_5":28142,"_19261":49612,"_26299":49613,"_2667":47759},[],"/docs/pr-preview/pr-52/platform/iot-fleets/overview#enrollment-with-pki",{"_3171":1417,"_27803":1412,"_5":28142,"_19261":49615,"_26299":49616,"_2667":49034},[],"/docs/pr-preview/pr-52/platform/iot-fleets/overview#integrations",{"_3171":1418,"_27803":1412,"_5":28142,"_19261":49618,"_26299":49619,"_2667":49620},[],"/docs/pr-preview/pr-52/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3171":1419,"_27803":1412,"_19261":49622,"_5":13244,"_26299":1412,"_2667":49623},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3171":1420,"_27803":1412,"_19261":49625,"_5":13244,"_26299":49606,"_2667":49626},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3171":1421,"_27803":1412,"_19261":49628,"_5":13244,"_26299":49606,"_2667":49629},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3171":1422,"_27803":1412,"_19261":49631,"_5":13244,"_26299":49610,"_2667":49632},[],"Resource",{"_3171":1423,"_27803":1412,"_19261":49634,"_5":13244,"_26299":49610,"_2667":49635},[],"What it represents",{"_3171":1424,"_27803":1412,"_19261":49637,"_5":13244,"_26299":49610,"_2667":49638},[],"**Device**",{"_3171":1425,"_27803":1412,"_19261":49640,"_5":13244,"_26299":49610,"_2667":49641},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3171":1426,"_27803":1412,"_19261":49643,"_5":13244,"_26299":49610,"_2667":49644},[],"**Identity**",{"_3171":1427,"_27803":1412,"_19261":49646,"_5":13244,"_26299":49610,"_2667":49647},[],"The device's association with its certificates: an active version and a history.",{"_3171":1428,"_27803":1412,"_19261":49649,"_5":13244,"_26299":49610,"_2667":49650},[],"**DMS**",{"_3171":1429,"_27803":1412,"_19261":49652,"_5":13244,"_26299":49610,"_2667":49653},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3171":1430,"_27803":1412,"_19261":49655,"_5":13244,"_26299":49610,"_2667":49656},[],"**Fleet**",{"_3171":1431,"_27803":1412,"_19261":49658,"_5":13244,"_26299":49610,"_2667":49659},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3171":1432,"_27803":1412,"_19261":49661,"_5":13244,"_26299":49610,"_2667":49662},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3171":1433,"_27803":1412,"_19261":49664,"_5":13244,"_26299":49610,"_2667":49665},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3171":1434,"_27803":1412,"_19261":49667,"_5":13244,"_26299":49613,"_2667":49668},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3171":1435,"_27803":1412,"_19261":49670,"_5":13244,"_26299":49613,"_2667":49671},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3171":1436,"_27803":1412,"_19261":49673,"_5":13244,"_26299":49613,"_2667":49674},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3171":1437,"_27803":1412,"_19261":49676,"_5":13244,"_26299":49613,"_2667":49677},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3171":1438,"_27803":1412,"_19261":49679,"_5":13244,"_26299":49613,"_2667":49680},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3171":1439,"_27803":1412,"_19261":49682,"_5":13244,"_26299":49613,"_2667":49683},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3171":1440,"_27803":1412,"_19261":49685,"_5":13244,"_26299":49613,"_2667":49686},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3171":1441,"_27803":1412,"_19261":49688,"_5":13244,"_26299":49613,"_2667":49689},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3171":1442,"_27803":1412,"_19261":49691,"_5":13244,"_26299":49616,"_2667":49692},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3171":1443,"_27803":1412,"_19261":49694,"_5":13244,"_26299":49616,"_2667":49695},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3171":1444,"_27803":1412,"_19261":49697,"_5":13244,"_26299":49619,"_2667":49698},[],"Participant",{"_3171":1445,"_27803":1412,"_19261":49700,"_5":13244,"_26299":49619,"_2667":49701},[],"Responsibility",{"_3171":1446,"_27803":1412,"_19261":49703,"_5":13244,"_26299":49619,"_2667":49704},[],"PKI administrator",{"_3171":1447,"_27803":1412,"_19261":49706,"_5":13244,"_26299":49619,"_2667":49707},[],"CA, issuance profile, chain and revocation publication.",{"_3171":1448,"_27803":1412,"_19261":49709,"_5":13244,"_26299":49619,"_2667":49710},[],"Provisioning administrator",{"_3171":1449,"_27803":1412,"_19261":49712,"_5":13244,"_26299":49619,"_2667":49713},[],"DMS, admission, authentication per operation and inventory.",{"_3171":1450,"_27803":1412,"_19261":49715,"_5":13244,"_26299":49619,"_2667":49716},[],"Device integrator",{"_3171":1451,"_27803":1412,"_19261":49718,"_5":13244,"_26299":49619,"_2667":49719},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3171":1452,"_27803":1412,"_19261":49721,"_5":13244,"_26299":49619,"_2667":49722},[],"Consumer integrator",{"_3171":1453,"_27803":1412,"_19261":49724,"_5":13244,"_26299":49619,"_2667":49725},[],"Trusted issuers, validation and device permissions in the destination.",{"_3171":1454,"_27803":1412,"_19261":49727,"_5":13244,"_26299":49619,"_2667":49728},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3171":1455,"_27803":1455,"_5":13570,"_2667":49730,"_28145":49731,"_19261":49733,"_26299":1455},"Enroll and connect your first device",[45221,46601,47578,49732],"Getting started",[],{"_3171":1456,"_27803":1455,"_19261":49735,"_5":13244,"_26299":1455,"_2667":49736},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3171":1457,"_27803":1455,"_5":28142,"_19261":49738,"_26299":49739,"_2667":45231},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3171":1458,"_27803":1455,"_5":28142,"_19261":49741,"_26299":49742,"_2667":49743},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3171":1459,"_27803":1455,"_5":28142,"_19261":49745,"_26299":49746,"_2667":49747},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3171":1460,"_27803":1455,"_5":28142,"_19261":49749,"_26299":49750,"_2667":49751},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3171":1461,"_27803":1455,"_5":28142,"_19261":49753,"_26299":49754,"_2667":49755},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3171":1462,"_27803":1455,"_5":28142,"_19261":49757,"_26299":49758,"_2667":49759},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3171":1463,"_27803":1455,"_5":28142,"_19261":49761,"_26299":49762,"_2667":49763},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3171":1464,"_27803":1455,"_5":28142,"_19261":49765,"_26299":49766,"_2667":49767},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3171":1465,"_27803":1455,"_19261":49769,"_5":13244,"_26299":1455,"_2667":49770},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3171":1466,"_27803":1455,"_19261":49772,"_5":13244,"_26299":49739,"_2667":49773},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3171":1467,"_27803":1455,"_19261":49775,"_5":13244,"_26299":49739,"_2667":49776},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3171":1468,"_27803":1455,"_19261":49778,"_5":13244,"_26299":49739,"_2667":49779},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3171":1469,"_27803":1455,"_19261":49781,"_5":13244,"_26299":49739,"_2667":49782},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3171":1470,"_27803":1455,"_19261":49784,"_5":13244,"_26299":49739,"_2667":49785},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3171":1471,"_27803":1455,"_19261":49787,"_5":13244,"_26299":49742,"_2667":49788},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3171":1472,"_27803":1455,"_19261":49790,"_5":13244,"_26299":49742,"_2667":49791},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3171":1473,"_27803":1455,"_19261":49793,"_5":13244,"_26299":49746,"_2667":49794},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3171":1474,"_27803":1455,"_19261":49796,"_5":13244,"_26299":49746,"_2667":49797},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3171":1475,"_27803":1455,"_19261":49799,"_5":13244,"_26299":49746,"_2667":49800},[],"Setting",{"_3171":1476,"_27803":1455,"_19261":49802,"_5":13244,"_26299":49746,"_2667":49803},[],"Evaluation value",{"_3171":1477,"_27803":1455,"_19261":49805,"_5":13244,"_26299":49746,"_2667":49806},[],"Enrollment CA",{"_3171":1478,"_27803":1455,"_19261":49808,"_5":13244,"_26299":49746,"_2667":49809},[],"Issuing root from `device-root.pem`.",{"_3171":1479,"_27803":1455,"_19261":49811,"_5":13244,"_26299":49746,"_2667":47889},[],{"_3171":1480,"_27803":1455,"_19261":49813,"_5":13244,"_26299":49746,"_2667":49814},[],"The 1-hour leaf profile you just prepared.",{"_3171":1481,"_27803":1455,"_19261":49816,"_5":13244,"_26299":49746,"_2667":49817},[],"Protocol / Registration Mode",{"_3171":1482,"_27803":1455,"_19261":49819,"_5":13244,"_26299":49746,"_2667":49820},[],"`EST_RFC7030` / `JITP`.",{"_3171":1483,"_27803":1455,"_19261":49822,"_5":13244,"_26299":49746,"_2667":49823},[],"Verify CSR Signature",{"_3171":1484,"_27803":1455,"_19261":49825,"_5":13244,"_26299":49746,"_2667":49826},[],"Enabled.",{"_3171":1485,"_27803":1455,"_19261":49828,"_5":13244,"_26299":49746,"_2667":49829},[],"Enable Replaceable Enrollment",{"_3171":1486,"_27803":1455,"_19261":49831,"_5":13244,"_26299":49746,"_2667":49832},[],"Disabled; the ID must be new.",{"_3171":1487,"_27803":1455,"_19261":49834,"_5":13244,"_26299":49746,"_2667":49835},[],"Initial authentication",{"_3171":1488,"_27803":1455,"_19261":49837,"_5":13244,"_26299":49746,"_2667":49838},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3171":1489,"_27803":1455,"_19261":49840,"_5":13244,"_26299":49746,"_2667":49841},[],"Renewal authentication",{"_3171":1490,"_27803":1455,"_19261":49843,"_5":13244,"_26299":49746,"_2667":49844},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3171":1491,"_27803":1455,"_19261":49846,"_5":13244,"_26299":49746,"_2667":49847},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3171":1492,"_27803":1455,"_19261":49849,"_5":13244,"_26299":49746,"_2667":49850},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3171":1493,"_27803":1455,"_19261":49852,"_5":13244,"_26299":49746,"_2667":49853},[],"Re-enrollment Delta",{"_3171":1494,"_27803":1455,"_19261":49855,"_5":13244,"_26299":49746,"_2667":49856},[],"1 hour.",{"_3171":1495,"_27803":1455,"_19261":49858,"_5":13244,"_26299":49746,"_2667":49859},[],"Preventive / Critical Delta",{"_3171":1496,"_27803":1455,"_19261":49861,"_5":13244,"_26299":49746,"_2667":49862},[],"30 minutes / 10 minutes.",{"_3171":1497,"_27803":1455,"_19261":49864,"_5":13244,"_26299":49746,"_2667":49865},[],"Revoke on Re-enrollment",{"_3171":1498,"_27803":1455,"_19261":49867,"_5":13244,"_26299":49746,"_2667":49868},[],"Disabled to test the successor before retiring the previous identity.",{"_3171":1499,"_27803":1455,"_19261":49870,"_5":13244,"_26299":49746,"_2667":47897},[],{"_3171":1500,"_27803":1455,"_19261":49872,"_5":13244,"_26299":49746,"_2667":49873},[],"Disabled; the operational key is generated in the client.",{"_3171":1501,"_27803":1455,"_19261":49875,"_5":13244,"_26299":49746,"_2667":49876},[],"CA Distribution",{"_3171":1502,"_27803":1455,"_19261":49878,"_5":13244,"_26299":49746,"_2667":49879},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3171":1503,"_27803":1455,"_19261":49881,"_5":13244,"_26299":49746,"_2667":49882},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. If your console does not expose the independent block, configure and check the resource through the DMS API and DMS guide.",{"_3171":1504,"_27803":1455,"_19261":49884,"_5":13244,"_26299":49750,"_2667":49885},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3171":1505,"_27803":1455,"_19261":49887,"_5":13244,"_26299":49750,"_2667":49888},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3171":1506,"_27803":1455,"_19261":49890,"_5":13244,"_26299":49754,"_2667":49891},[],"Generate a new key and CSR with the selected identifier:",{"_3171":1507,"_27803":1455,"_19261":49893,"_5":13244,"_26299":49754,"_2667":49894},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3171":1508,"_27803":1455,"_19261":49896,"_5":13244,"_26299":49754,"_2667":49897},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3171":1509,"_27803":1455,"_19261":49899,"_5":13244,"_26299":49758,"_2667":49900},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3171":1510,"_27803":1455,"_19261":49902,"_5":13244,"_26299":49758,"_2667":49903},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3171":1511,"_27803":1455,"_19261":49905,"_5":13244,"_26299":49762,"_2667":49906},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3171":1512,"_27803":1455,"_19261":49908,"_5":13244,"_26299":49762,"_2667":49909},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3171":1513,"_27803":1455,"_19261":49911,"_5":13244,"_26299":49762,"_2667":49912},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3171":1514,"_27803":1455,"_19261":49914,"_5":13244,"_26299":49762,"_2667":49915},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3171":1515,"_27803":1455,"_19261":49917,"_5":13244,"_26299":49762,"_2667":49918},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3171":1516,"_27803":1455,"_19261":49920,"_5":13244,"_26299":49766,"_2667":49921},[],"Check",{"_3171":1517,"_27803":1455,"_19261":49923,"_5":13244,"_26299":49766,"_2667":49924},[],"Expected result",{"_3171":1518,"_27803":1455,"_19261":49926,"_5":13244,"_26299":49766,"_2667":49927},[],"Registration",{"_3171":1519,"_27803":1455,"_19261":49929,"_5":13244,"_26299":49766,"_2667":49930},[],"ID created automatically and correct DMS.",{"_3171":1520,"_27803":1455,"_19261":49932,"_5":13244,"_26299":49766,"_2667":49933},[],"Certificate",{"_3171":1521,"_27803":1455,"_19261":49935,"_5":13244,"_26299":49766,"_2667":49936},[],"CN, profile, serial and key verified.",{"_3171":1522,"_27803":1455,"_19261":49938,"_5":13244,"_26299":49766,"_2667":49939},[],"Inventory",{"_3171":1523,"_27803":1455,"_19261":49941,"_5":13244,"_26299":49766,"_2667":49942},[],"Received serial visible as the current identity and in history.",{"_3171":1524,"_27803":1455,"_19261":49944,"_5":13244,"_26299":49766,"_2667":49945},[],"Consumer",{"_3171":1525,"_27803":1455,"_19261":49947,"_5":13244,"_26299":49766,"_2667":49948},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3171":1526,"_27803":1455,"_19261":49950,"_5":13244,"_26299":49766,"_2667":49951},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3171":1527,"_27803":1455,"_19261":49953,"_5":13244,"_26299":49766,"_2667":49954},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3171":1528,"_27803":1528,"_5":13570,"_2667":47594,"_28145":49956,"_19261":49957,"_26299":1528},[45221,46601,47578,49732],[],{"_3171":1529,"_27803":1528,"_19261":49959,"_5":13244,"_26299":1528,"_2667":49960},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3171":1530,"_27803":1528,"_5":28142,"_19261":49962,"_26299":49963,"_2667":45231},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3171":1531,"_27803":1528,"_5":28142,"_19261":49965,"_26299":49966,"_2667":49967},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3171":1532,"_27803":1528,"_5":28142,"_19261":49969,"_26299":49970,"_2667":49971},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3171":1533,"_27803":1528,"_5":28142,"_19261":49973,"_26299":49974,"_2667":49975},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3171":1534,"_27803":1528,"_5":28142,"_19261":49977,"_26299":49978,"_2667":49979},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3171":1535,"_27803":1528,"_5":28142,"_19261":49981,"_26299":49982,"_2667":49983},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3171":1536,"_27803":1528,"_5":28142,"_19261":49985,"_26299":49986,"_2667":49924},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3171":1537,"_27803":1528,"_5":28142,"_19261":49988,"_26299":49989,"_2667":49990},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3171":1538,"_27803":1528,"_5":28142,"_19261":49992,"_26299":49993,"_2667":49994},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3171":1539,"_27803":1528,"_19261":49996,"_5":13244,"_26299":1528,"_2667":49997},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3171":1540,"_27803":1528,"_19261":49999,"_5":13244,"_26299":1528,"_2667":50000},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3171":1541,"_27803":1528,"_19261":50002,"_5":13244,"_26299":49963,"_2667":50003},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3171":1542,"_27803":1528,"_19261":50005,"_5":13244,"_26299":49963,"_2667":50006},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3171":1543,"_27803":1528,"_19261":50008,"_5":13244,"_26299":49963,"_2667":50009},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3171":1544,"_27803":1528,"_19261":50011,"_5":13244,"_26299":49963,"_2667":50012},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3171":1545,"_27803":1528,"_19261":50014,"_5":13244,"_26299":49966,"_2667":50015},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3171":1546,"_27803":1528,"_19261":50017,"_5":13244,"_26299":49966,"_2667":50018},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3171":1547,"_27803":1528,"_19261":50020,"_5":13244,"_26299":49966,"_2667":50021},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3171":1548,"_27803":1528,"_19261":50023,"_5":13244,"_26299":49966,"_2667":50024},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3171":1549,"_27803":1528,"_19261":50026,"_5":13244,"_26299":49966,"_2667":50027},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3171":1550,"_27803":1528,"_19261":50029,"_5":13244,"_26299":49966,"_2667":50030},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3171":1551,"_27803":1528,"_19261":50032,"_5":13244,"_26299":49966,"_2667":50033},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3171":1552,"_27803":1528,"_19261":50035,"_5":13244,"_26299":49966,"_2667":50036},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3171":1553,"_27803":1528,"_19261":50038,"_5":13244,"_26299":49970,"_2667":50039},[],"Open **Managed Devices** and the registration action. Complete:",{"_3171":1554,"_27803":1528,"_19261":50041,"_5":13244,"_26299":49970,"_2667":50042},[],"**Device ID**: `device-001`.",{"_3171":1555,"_27803":1528,"_19261":50044,"_5":13244,"_26299":49970,"_2667":50045},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3171":1556,"_27803":1528,"_19261":50047,"_5":13244,"_26299":49970,"_2667":50048},[],"**Icon** and **Tags**: optional classification.",{"_3171":1557,"_27803":1528,"_19261":50050,"_5":13244,"_26299":49970,"_2667":50051},[],"Confirm registration.",{"_3171":1558,"_27803":1528,"_19261":50053,"_5":13244,"_26299":49974,"_2667":50054},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3171":1559,"_27803":1528,"_19261":50056,"_5":13244,"_26299":49974,"_2667":50057},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3171":1560,"_27803":1528,"_19261":50059,"_5":13244,"_26299":49978,"_2667":50060},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3171":1561,"_27803":1528,"_19261":50062,"_5":13244,"_26299":49978,"_2667":50063},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3171":1562,"_27803":1528,"_19261":50065,"_5":13244,"_26299":49982,"_2667":50066},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3171":1563,"_27803":1528,"_19261":50068,"_5":13244,"_26299":49982,"_2667":50069},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3171":1564,"_27803":1528,"_19261":50071,"_5":13244,"_26299":49986,"_2667":49921},[],{"_3171":1565,"_27803":1528,"_19261":50073,"_5":13244,"_26299":49986,"_2667":50074},[],"Result",{"_3171":1566,"_27803":1528,"_19261":50076,"_5":13244,"_26299":49986,"_2667":50077},[],"Device",{"_3171":1567,"_27803":1528,"_19261":50079,"_5":13244,"_26299":49986,"_2667":50080},[],"`device-001` appears in inventory with the expected DMS.",{"_3171":1568,"_27803":1528,"_19261":50082,"_5":13244,"_26299":49986,"_2667":50083},[],"Current identity",{"_3171":1569,"_27803":1528,"_19261":50085,"_5":13244,"_26299":49986,"_2667":50086},[],"The associated certificate matches the one you verified in PKI.",{"_3171":1570,"_27803":1528,"_19261":50088,"_5":13244,"_26299":49986,"_2667":50089},[],"History",{"_3171":1571,"_27803":1528,"_19261":50091,"_5":13244,"_26299":49986,"_2667":50092},[],"The associated issuance appears with its serial number and dates.",{"_3171":1572,"_27803":1528,"_19261":50094,"_5":13244,"_26299":49986,"_2667":50095},[],"Key and certificate",{"_3171":1573,"_27803":1528,"_19261":50097,"_5":13244,"_26299":49986,"_2667":50098},[],"You have the verified pair ready to install on the device.",{"_3171":1574,"_27803":1528,"_19261":50100,"_5":13244,"_26299":49989,"_2667":50101},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3171":1575,"_27803":1528,"_19261":50103,"_5":13244,"_26299":49989,"_2667":50104},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3171":1576,"_27803":1528,"_19261":50106,"_5":13244,"_26299":49989,"_2667":50107},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3171":1577,"_27803":1528,"_19261":50109,"_5":13244,"_26299":49989,"_2667":50110},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3171":1578,"_27803":1528,"_19261":50112,"_5":13244,"_26299":49993,"_2667":50113},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3171":1579,"_27803":1528,"_19261":50115,"_5":13244,"_26299":49993,"_2667":50116},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3171":1580,"_27803":1528,"_19261":50118,"_5":13244,"_26299":49993,"_2667":50119},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3171":1581,"_27803":1581,"_5":13570,"_2667":50121,"_28145":50122,"_19261":50123,"_26299":1581},"Lamassu IoT Platform",[45221,46601],[],{"_3171":1582,"_27803":1581,"_19261":50125,"_5":13244,"_26299":1581,"_2667":50126},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3171":1583,"_27803":1581,"_5":28142,"_19261":50128,"_26299":50129,"_2667":49607},[],"/docs/pr-preview/pr-52/platform/overview#start-here",{"_3171":1584,"_27803":1581,"_5":28142,"_19261":50131,"_26299":50132,"_2667":50133},[],"/docs/pr-preview/pr-52/platform/overview#choose-your-path","Choose your path",{"_3171":1585,"_27803":1581,"_5":28142,"_19261":50135,"_26299":50136,"_2667":50137},[],"/docs/pr-preview/pr-52/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3171":1586,"_27803":1581,"_5":28142,"_19261":50139,"_26299":50140,"_2667":50141},[],"/docs/pr-preview/pr-52/platform/overview#core-capabilities","Core capabilities",{"_3171":1587,"_27803":1581,"_5":28142,"_19261":50143,"_26299":50144,"_2667":50145},[],"/docs/pr-preview/pr-52/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3171":1588,"_27803":1581,"_5":28142,"_19261":50147,"_26299":50148,"_2667":50149},[],"/docs/pr-preview/pr-52/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3171":1589,"_27803":1581,"_5":28142,"_19261":50151,"_26299":50152,"_2667":50153},[],"/docs/pr-preview/pr-52/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3171":1590,"_27803":1581,"_5":28142,"_19261":50155,"_26299":50156,"_2667":50157},[],"/docs/pr-preview/pr-52/platform/overview#automate-device-identities","Automate device identities",{"_3171":1591,"_27803":1581,"_5":28142,"_19261":50159,"_26299":50160,"_2667":50161},[],"/docs/pr-preview/pr-52/platform/overview#publish-validation-status","Publish validation status",{"_3171":1592,"_27803":1581,"_5":28142,"_19261":50163,"_26299":50164,"_2667":50165},[],"/docs/pr-preview/pr-52/platform/overview#react-to-events","React to events",{"_3171":1593,"_27803":1581,"_5":28142,"_19261":50167,"_26299":50168,"_2667":50169},[],"/docs/pr-preview/pr-52/platform/overview#operational-reference","Operational reference",{"_3171":1594,"_27803":1581,"_19261":50171,"_5":13244,"_26299":1581,"_2667":50172},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3171":1595,"_27803":1581,"_19261":50174,"_5":13244,"_26299":50129,"_2667":50175},[],"Choose the result you need:",{"_3171":1596,"_27803":1581,"_19261":50177,"_5":13244,"_26299":50129,"_2667":50178},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3171":1597,"_27803":1581,"_19261":50180,"_5":13244,"_26299":50129,"_2667":50181},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3171":1598,"_27803":1581,"_19261":50183,"_5":13244,"_26299":50129,"_2667":50184},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3171":1599,"_27803":1581,"_19261":50186,"_5":13244,"_26299":50132,"_2667":50187},[],"Section",{"_3171":1600,"_27803":1581,"_19261":50189,"_5":13244,"_26299":50132,"_2667":50190},[],"What you manage",{"_3171":1601,"_27803":1581,"_19261":50192,"_5":13244,"_26299":50132,"_2667":50193},[],"Entry point",{"_3171":1602,"_27803":1581,"_19261":50195,"_5":13244,"_26299":50132,"_2667":50196},[],"**PKI**",{"_3171":1603,"_27803":1581,"_19261":50198,"_5":13244,"_26299":50132,"_2667":50199},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3171":1604,"_27803":1581,"_19261":50201,"_5":13244,"_26299":50132,"_2667":50202},[],"PKI overview",{"_3171":1605,"_27803":1581,"_19261":50204,"_5":13244,"_26299":50132,"_2667":50205},[],"**IoT Fleets**",{"_3171":1606,"_27803":1581,"_19261":50207,"_5":13244,"_26299":50132,"_2667":50208},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3171":1607,"_27803":1581,"_19261":50210,"_5":13244,"_26299":50132,"_2667":50211},[],"IoT Fleets overview",{"_3171":1608,"_27803":1581,"_19261":50213,"_5":13244,"_26299":50132,"_2667":50214},[],"**Administration**",{"_3171":1609,"_27803":1581,"_19261":50216,"_5":13244,"_26299":50132,"_2667":50217},[],"Operator permissions, audit and event subscriptions.",{"_3171":1610,"_27803":1581,"_19261":50219,"_5":13244,"_26299":50132,"_2667":46599},[],{"_3171":1611,"_27803":1581,"_19261":50221,"_5":13244,"_26299":50132,"_2667":50222},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3171":1612,"_27803":1581,"_19261":50224,"_5":13244,"_26299":50136,"_2667":50225},[],"An identity's journey connects four responsibilities:",{"_3171":1613,"_27803":1581,"_19261":50227,"_5":13244,"_26299":50136,"_2667":50228},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3171":1614,"_27803":1581,"_19261":50230,"_5":13244,"_26299":50136,"_2667":50231},[],"The provisioning administrator configures the DMS and initial trust.",{"_3171":1615,"_27803":1581,"_19261":50233,"_5":13244,"_26299":50136,"_2667":50234},[],"The device client requests a certificate and installs it with the matching key.",{"_3171":1616,"_27803":1581,"_19261":50236,"_5":13244,"_26299":50136,"_2667":50237},[],"The consumer validates the identity and applies its access permissions.",{"_3171":1617,"_27803":1581,"_19261":50239,"_5":13244,"_26299":50136,"_2667":50240},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3171":1618,"_27803":1581,"_19261":50242,"_5":13244,"_26299":50144,"_2667":50243},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3171":1619,"_27803":1581,"_19261":50245,"_5":13244,"_26299":50148,"_2667":50246},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3171":1620,"_27803":1581,"_19261":50248,"_5":13244,"_26299":50152,"_2667":50249},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3171":1621,"_27803":1581,"_19261":50251,"_5":13244,"_26299":50156,"_2667":50252},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3171":1622,"_27803":1581,"_19261":50254,"_5":13244,"_26299":50160,"_2667":50255},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3171":1623,"_27803":1581,"_19261":50257,"_5":13244,"_26299":50164,"_2667":50258},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3171":1624,"_27803":1581,"_19261":50260,"_5":13244,"_26299":50168,"_2667":49701},[],{"_3171":1625,"_27803":1581,"_19261":50262,"_5":13244,"_26299":50168,"_2667":50263},[],"What it prepares or checks",{"_3171":1626,"_27803":1581,"_19261":50265,"_5":13244,"_26299":50168,"_2667":49704},[],{"_3171":1627,"_27803":1581,"_19261":50267,"_5":13244,"_26299":50168,"_2667":50268},[],"Key custody, CA hierarchy, profiles and validation.",{"_3171":1628,"_27803":1581,"_19261":50270,"_5":13244,"_26299":50168,"_2667":50271},[],"Fleet administrator",{"_3171":1629,"_27803":1581,"_19261":50273,"_5":13244,"_26299":50168,"_2667":50274},[],"DMS, device admission, renewal policy and inventory.",{"_3171":1630,"_27803":1581,"_19261":50276,"_5":13244,"_26299":50168,"_2667":49716},[],{"_3171":1631,"_27803":1581,"_19261":50278,"_5":13244,"_26299":50168,"_2667":50279},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3171":1632,"_27803":1581,"_19261":50281,"_5":13244,"_26299":50168,"_2667":49722},[],{"_3171":1633,"_27803":1581,"_19261":50283,"_5":13244,"_26299":50168,"_2667":50284},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3171":1634,"_27803":1581,"_19261":50286,"_5":13244,"_26299":50168,"_2667":50287},[],"Infrastructure operator",{"_3171":1635,"_27803":1581,"_19261":50289,"_5":13244,"_26299":50168,"_2667":50290},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3171":1636,"_27803":1581,"_19261":50292,"_5":13244,"_26299":50168,"_2667":50293},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3171":1637,"_27803":1637,"_5":13570,"_2667":50295,"_28145":50296,"_19261":50299,"_26299":1637},"CA hierarchy and rotation",[45221,46601,50297,50298],"PKI","Keys, authorities and certificates",[],{"_3171":1638,"_27803":1637,"_19261":50301,"_5":13244,"_26299":1637,"_2667":50302},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3171":1639,"_27803":1637,"_5":28142,"_19261":50304,"_26299":50305,"_2667":50306},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3171":1640,"_27803":1637,"_5":28142,"_19261":50308,"_26299":50309,"_2667":50310},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3171":1641,"_27803":1637,"_5":28142,"_19261":50312,"_26299":50313,"_2667":50314},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3171":1642,"_27803":1637,"_5":28142,"_19261":50316,"_26299":50317,"_2667":50318},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3171":1643,"_27803":1637,"_5":28142,"_19261":50320,"_26299":50321,"_2667":50322},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3171":1644,"_27803":1637,"_5":28142,"_19261":50324,"_26299":50325,"_2667":50326},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3171":1645,"_27803":1637,"_5":28142,"_19261":50328,"_26299":50329,"_2667":50330},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3171":1646,"_27803":1637,"_5":28142,"_19261":50332,"_26299":50333,"_2667":50334},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3171":1647,"_27803":1637,"_5":28142,"_19261":50336,"_26299":50337,"_2667":50338},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3171":1648,"_27803":1637,"_5":28142,"_19261":50340,"_26299":50341,"_2667":50342},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3171":1649,"_27803":1637,"_5":28142,"_19261":50344,"_26299":50345,"_2667":50346},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3171":1650,"_27803":1637,"_5":28142,"_19261":50348,"_26299":50349,"_2667":50350},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3171":1651,"_27803":1637,"_19261":50352,"_5":13244,"_26299":1637,"_2667":50353},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3171":1652,"_27803":1637,"_19261":50355,"_5":13244,"_26299":1637,"_2667":50356},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3171":1653,"_27803":1637,"_19261":50358,"_5":13244,"_26299":50305,"_2667":50359},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3171":1654,"_27803":1637,"_19261":50361,"_5":13244,"_26299":50305,"_2667":50362},[],"environment, such as production and preproduction;",{"_3171":1655,"_27803":1637,"_19261":50364,"_5":13244,"_26299":50305,"_2667":50365},[],"owner or operating team;",{"_3171":1656,"_27803":1637,"_19261":50367,"_5":13244,"_26299":50305,"_2667":50368},[],"device family or manufacturing process;",{"_3171":1657,"_27803":1637,"_19261":50370,"_5":13244,"_26299":50305,"_2667":50371},[],"region or regulatory requirement;",{"_3171":1658,"_27803":1637,"_19261":50373,"_5":13244,"_26299":50305,"_2667":50374},[],"cryptographic engine or key policy;",{"_3171":1659,"_27803":1637,"_19261":50376,"_5":13244,"_26299":50305,"_2667":50377},[],"maintenance window and renewal cadence.",{"_3171":1660,"_27803":1637,"_19261":50379,"_5":13244,"_26299":50305,"_2667":50380},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3171":1661,"_27803":1637,"_19261":50382,"_5":13244,"_26299":50305,"_2667":50383},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3171":1662,"_27803":1637,"_19261":50385,"_5":13244,"_26299":50309,"_2667":50386},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3171":1663,"_27803":1637,"_19261":50388,"_5":13244,"_26299":50309,"_2667":50389},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3171":1664,"_27803":1637,"_19261":50391,"_5":13244,"_26299":50309,"_2667":50392},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3171":1665,"_27803":1637,"_19261":50394,"_5":13244,"_26299":50313,"_2667":50395},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3171":1666,"_27803":1637,"_19261":50397,"_5":13244,"_26299":50313,"_2667":50398},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3171":1667,"_27803":1637,"_19261":50400,"_5":13244,"_26299":50313,"_2667":50401},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3171":1668,"_27803":1637,"_19261":50403,"_5":13244,"_26299":50313,"_2667":50404},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3171":1669,"_27803":1637,"_19261":50406,"_5":13244,"_26299":50321,"_2667":50407},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3171":1670,"_27803":1637,"_19261":50409,"_5":13244,"_26299":50325,"_2667":50410},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3171":1671,"_27803":1637,"_19261":50412,"_5":13244,"_26299":50329,"_2667":50413},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3171":1672,"_27803":1637,"_19261":50415,"_5":13244,"_26299":50333,"_2667":50416},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3171":1673,"_27803":1637,"_19261":50418,"_5":13244,"_26299":50337,"_2667":50419},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3171":1674,"_27803":1637,"_19261":50421,"_5":13244,"_26299":50341,"_2667":50422},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3171":1675,"_27803":1637,"_19261":50424,"_5":13244,"_26299":50345,"_2667":50425},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3171":1676,"_27803":1637,"_19261":50427,"_5":13244,"_26299":50345,"_2667":50428},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3171":1677,"_27803":1637,"_19261":50430,"_5":13244,"_26299":50345,"_2667":50431},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3171":1678,"_27803":1637,"_19261":50433,"_5":13244,"_26299":50345,"_2667":50434},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3171":1679,"_27803":1637,"_19261":50436,"_5":13244,"_26299":50349,"_2667":50437},[],"The new chain ends in an anchor installed by the consumer.",{"_3171":1680,"_27803":1637,"_19261":50439,"_5":13244,"_26299":50349,"_2667":50440},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3171":1681,"_27803":1637,"_19261":50442,"_5":13244,"_26299":50349,"_2667":50443},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3171":1682,"_27803":1637,"_19261":50445,"_5":13244,"_26299":50349,"_2667":50446},[],"Re-enrollment accepts the old identity during the planned period.",{"_3171":1683,"_27803":1637,"_19261":50448,"_5":13244,"_26299":50349,"_2667":50449},[],"OCSP and CRL respond for the authorities that remain active.",{"_3171":1684,"_27803":1637,"_19261":50451,"_5":13244,"_26299":50349,"_2667":50452},[],"No DMS is left accidentally issuing from the old CA.",{"_3171":1685,"_27803":1637,"_19261":50454,"_5":13244,"_26299":50349,"_2667":50455},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3171":1686,"_27803":1686,"_5":13570,"_2667":50457,"_28145":50458,"_19261":50459,"_26299":1686},"Certification authorities",[45221,46601,50297,50298],[],{"_3171":1687,"_27803":1686,"_19261":50461,"_5":13244,"_26299":1686,"_2667":50462},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3171":1688,"_27803":1686,"_5":28142,"_19261":50464,"_26299":50465,"_2667":50466},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3171":1689,"_27803":1686,"_5":28142,"_19261":50468,"_26299":50469,"_2667":50470},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3171":1690,"_27803":1686,"_5":28142,"_19261":50472,"_26299":50473,"_2667":45231},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#before-you-begin",{"_3171":1691,"_27803":1686,"_5":28142,"_19261":50475,"_26299":50476,"_2667":50477},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3171":1692,"_27803":1686,"_5":28142,"_19261":50479,"_26299":50480,"_2667":50481},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3171":1693,"_27803":1686,"_5":28142,"_19261":50483,"_26299":50484,"_2667":50485},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3171":1694,"_27803":1686,"_5":28142,"_19261":50487,"_26299":50488,"_2667":50489},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3171":1695,"_27803":1686,"_5":28142,"_19261":50491,"_26299":50492,"_2667":50493},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3171":1696,"_27803":1686,"_5":28142,"_19261":50495,"_26299":50496,"_2667":50497},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3171":1697,"_27803":1686,"_5":28142,"_19261":50499,"_26299":50500,"_2667":50501},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3171":1698,"_27803":1686,"_5":28142,"_19261":50503,"_26299":50504,"_2667":50505},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3171":1699,"_27803":1686,"_5":28142,"_19261":50507,"_26299":50508,"_2667":50509},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3171":1700,"_27803":1686,"_5":28142,"_19261":50511,"_26299":50512,"_2667":50513},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3171":1701,"_27803":1686,"_5":28142,"_19261":50515,"_26299":50516,"_2667":50517},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3171":1702,"_27803":1686,"_5":28142,"_19261":50519,"_26299":50520,"_2667":50521},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3171":1703,"_27803":1686,"_5":28142,"_19261":50523,"_26299":50524,"_2667":50525},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3171":1704,"_27803":1686,"_5":28142,"_19261":50527,"_26299":50528,"_2667":50529},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3171":1705,"_27803":1686,"_5":28142,"_19261":50531,"_26299":50532,"_2667":50533},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3171":1706,"_27803":1686,"_5":28142,"_19261":50535,"_26299":50536,"_2667":50537},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3171":1707,"_27803":1686,"_5":28142,"_19261":50539,"_26299":50540,"_2667":50541},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3171":1708,"_27803":1686,"_5":28142,"_19261":50543,"_26299":50544,"_2667":50545},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3171":1709,"_27803":1686,"_5":28142,"_19261":50547,"_26299":50548,"_2667":50549},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3171":1710,"_27803":1686,"_19261":50551,"_5":13244,"_26299":1686,"_2667":50552},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3171":1711,"_27803":1686,"_19261":50554,"_5":13244,"_26299":1686,"_2667":50555},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3171":1712,"_27803":1686,"_19261":50557,"_5":13244,"_26299":1686,"_2667":50558},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3171":1713,"_27803":1686,"_19261":50560,"_5":13244,"_26299":50465,"_2667":50561},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3171":1714,"_27803":1686,"_19261":50563,"_5":13244,"_26299":50465,"_2667":50564},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3171":1715,"_27803":1686,"_19261":50566,"_5":13244,"_26299":50465,"_2667":50567},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3171":1716,"_27803":1686,"_19261":50569,"_5":13244,"_26299":50465,"_2667":50570},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3171":1717,"_27803":1686,"_19261":50572,"_5":13244,"_26299":50465,"_2667":50573},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3171":1718,"_27803":1686,"_19261":50575,"_5":13244,"_26299":50473,"_2667":50576},[],"Decide whether the CA will be a root or an intermediate.",{"_3171":1719,"_27803":1686,"_19261":50578,"_5":13244,"_26299":50473,"_2667":50579},[],"Choose the engine that will keep the key.",{"_3171":1720,"_27803":1686,"_19261":50581,"_5":13244,"_26299":50473,"_2667":50582},[],"Define a validity longer than that of the certificates it will issue.",{"_3171":1721,"_27803":1686,"_19261":50584,"_5":13244,"_26299":50473,"_2667":50585},[],"For an intermediate CA, make sure the parent CA is active.",{"_3171":1722,"_27803":1686,"_19261":50587,"_5":13244,"_26299":50476,"_2667":50588},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3171":1723,"_27803":1686,"_19261":50590,"_5":13244,"_26299":50480,"_2667":50591},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3171":1724,"_27803":1686,"_19261":50593,"_5":13244,"_26299":50480,"_2667":50594},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3171":1725,"_27803":1686,"_19261":50596,"_5":13244,"_26299":50484,"_2667":50597},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3171":1726,"_27803":1686,"_19261":50599,"_5":13244,"_26299":50488,"_2667":50600},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3171":1727,"_27803":1686,"_19261":50602,"_5":13244,"_26299":50488,"_2667":50603},[],"`C`: two-letter ISO 3166-1 country code.",{"_3171":1728,"_27803":1686,"_19261":50605,"_5":13244,"_26299":50488,"_2667":50606},[],"`ST`: state or province.",{"_3171":1729,"_27803":1686,"_19261":50608,"_5":13244,"_26299":50488,"_2667":50609},[],"`L`: locality.",{"_3171":1730,"_27803":1686,"_19261":50611,"_5":13244,"_26299":50488,"_2667":50612},[],"`O`: organization.",{"_3171":1731,"_27803":1686,"_19261":50614,"_5":13244,"_26299":50488,"_2667":50615},[],"`OU`: organizational unit.",{"_3171":1732,"_27803":1686,"_19261":50617,"_5":13244,"_26299":50488,"_2667":50618},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3171":1733,"_27803":1686,"_19261":50620,"_5":13244,"_26299":50492,"_2667":50621},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3171":1734,"_27803":1686,"_19261":50623,"_5":13244,"_26299":50492,"_2667":50624},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3171":1735,"_27803":1686,"_19261":50626,"_5":13244,"_26299":50496,"_2667":50627},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3171":1736,"_27803":1686,"_19261":50629,"_5":13244,"_26299":50496,"_2667":50630},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3171":1737,"_27803":1686,"_19261":50632,"_5":13244,"_26299":50500,"_2667":50633},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3171":1738,"_27803":1686,"_19261":50635,"_5":13244,"_26299":50500,"_2667":50636},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3171":1739,"_27803":1686,"_19261":50638,"_5":13244,"_26299":50504,"_2667":50639},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3171":1740,"_27803":1686,"_19261":50641,"_5":13244,"_26299":50504,"_2667":50642},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number collides with a different existing certificate, or which is an identical duplicate CA. A deleted CA's certificate record is kept and reused on re-import, including its previous status. So if you re-import a CA with the same serial number but a different certificate, Lamassu keeps showing the old certificate's data: do not reuse serial numbers when re-importing, and check the result afterwards. Deleting a CA releases its key, which the KMS keeps while other certificates still reference it.",{"_3171":1741,"_27803":1686,"_19261":50644,"_5":13244,"_26299":50508,"_2667":50645},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3171":1742,"_27803":1686,"_19261":50647,"_5":13244,"_26299":50512,"_2667":50648},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3171":1743,"_27803":1686,"_19261":50650,"_5":13244,"_26299":50516,"_2667":50651},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3171":1744,"_27803":1686,"_19261":50653,"_5":13244,"_26299":50520,"_2667":50654},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3171":1745,"_27803":1686,"_19261":50656,"_5":13244,"_26299":50520,"_2667":50657},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3171":1746,"_27803":1686,"_19261":50659,"_5":13244,"_26299":50524,"_2667":50660},[],"Open a CA from the inventory to review:",{"_3171":1747,"_27803":1686,"_19261":50662,"_5":13244,"_26299":50524,"_2667":50663},[],"Status and validity period.",{"_3171":1748,"_27803":1686,"_19261":50665,"_5":13244,"_26299":50524,"_2667":50666},[],"Certificate and chain in PEM format.",{"_3171":1749,"_27803":1686,"_19261":50668,"_5":13244,"_26299":50524,"_2667":50669},[],"Number of active, expired and revoked certificates.",{"_3171":1750,"_27803":1686,"_19261":50671,"_5":13244,"_26299":50524,"_2667":50672},[],"Certificates issued in **Issued Certificates**.",{"_3171":1751,"_27803":1686,"_19261":50674,"_5":13244,"_26299":50524,"_2667":50675},[],"The CRL linked to the authority.",{"_3171":1752,"_27803":1686,"_19261":50677,"_5":13244,"_26299":50524,"_2667":50678},[],"Metadata and the associated cryptographic engine.",{"_3171":1753,"_27803":1686,"_19261":50680,"_5":13244,"_26299":50524,"_2667":50681},[],"You can filter the inventory by name, status and CA type.",{"_3171":1754,"_27803":1686,"_19261":50683,"_5":13244,"_26299":50528,"_2667":50684},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3171":1755,"_27803":1686,"_19261":50686,"_5":13244,"_26299":50528,"_2667":50687},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3171":1756,"_27803":1686,"_19261":50689,"_5":13244,"_26299":50528,"_2667":50690},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3171":1757,"_27803":1686,"_19261":50692,"_5":13244,"_26299":50528,"_2667":50693},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3171":1758,"_27803":1686,"_19261":50695,"_5":13244,"_26299":50532,"_2667":50696},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3171":1759,"_27803":1686,"_19261":50698,"_5":13244,"_26299":50536,"_2667":50699},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3171":1760,"_27803":1686,"_19261":50701,"_5":13244,"_26299":50540,"_2667":50702},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3171":1761,"_27803":1686,"_19261":50704,"_5":13244,"_26299":50544,"_2667":50705},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3171":1762,"_27803":1686,"_19261":50707,"_5":13244,"_26299":50548,"_2667":50708},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3171":1763,"_27803":1686,"_19261":50710,"_5":13244,"_26299":50548,"_2667":50711},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_3171":1764,"_27803":1764,"_5":13570,"_2667":50713,"_28145":50714,"_19261":50715,"_26299":1764},"Certificate profiles",[45221,46601,50297,50298],[],{"_3171":1765,"_27803":1764,"_19261":50717,"_5":13244,"_26299":1764,"_2667":50718},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3171":1766,"_27803":1764,"_5":28142,"_19261":50720,"_26299":50721,"_2667":50722},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3171":1767,"_27803":1764,"_5":28142,"_19261":50724,"_26299":50725,"_2667":50726},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#validity","Validity",{"_3171":1768,"_27803":1764,"_5":28142,"_19261":50728,"_26299":50729,"_2667":50730},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3171":1769,"_27803":1764,"_5":28142,"_19261":50732,"_26299":50733,"_2667":50734},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3171":1770,"_27803":1764,"_5":28142,"_19261":50736,"_26299":50737,"_2667":50738},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#subject","Subject",{"_3171":1771,"_27803":1764,"_5":28142,"_19261":50740,"_26299":50741,"_2667":50742},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3171":1772,"_27803":1764,"_5":28142,"_19261":50744,"_26299":50745,"_2667":50746},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3171":1773,"_27803":1764,"_5":28142,"_19261":50748,"_26299":50749,"_2667":50750},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3171":1774,"_27803":1764,"_5":28142,"_19261":50752,"_26299":50753,"_2667":50754},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3171":1775,"_27803":1764,"_5":28142,"_19261":50756,"_26299":50757,"_2667":50758},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3171":1776,"_27803":1764,"_5":28142,"_19261":50760,"_26299":50761,"_2667":50762},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3171":1777,"_27803":1764,"_5":28142,"_19261":50764,"_26299":50765,"_2667":50766},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3171":1778,"_27803":1764,"_5":28142,"_19261":50768,"_26299":50769,"_2667":50770},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3171":1779,"_27803":1764,"_5":28142,"_19261":50772,"_26299":50773,"_2667":50774},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3171":1780,"_27803":1764,"_5":28142,"_19261":50776,"_26299":50777,"_2667":50778},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#design-examples","Design examples",{"_3171":1781,"_27803":1764,"_5":28142,"_19261":50780,"_26299":50781,"_2667":50782},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3171":1782,"_27803":1764,"_19261":50784,"_5":13244,"_26299":1764,"_2667":50785},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3171":1783,"_27803":1764,"_19261":50787,"_5":13244,"_26299":1764,"_2667":50788},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3171":1784,"_27803":1764,"_19261":50790,"_5":13244,"_26299":50725,"_2667":50791},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3171":1785,"_27803":1764,"_19261":50793,"_5":13244,"_26299":50725,"_2667":50794},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3171":1786,"_27803":1764,"_19261":50796,"_5":13244,"_26299":50729,"_2667":50797},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3171":1787,"_27803":1764,"_19261":50799,"_5":13244,"_26299":50733,"_2667":50800},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3171":1788,"_27803":1764,"_19261":50802,"_5":13244,"_26299":50733,"_2667":50803},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3171":1789,"_27803":1764,"_19261":50805,"_5":13244,"_26299":50733,"_2667":50806},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3171":1790,"_27803":1764,"_19261":50808,"_5":13244,"_26299":50737,"_2667":50809},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3171":1791,"_27803":1764,"_19261":50811,"_5":13244,"_26299":50741,"_2667":50812},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3171":1792,"_27803":1764,"_19261":50814,"_5":13244,"_26299":50741,"_2667":50815},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3171":1793,"_27803":1764,"_19261":50817,"_5":13244,"_26299":50745,"_2667":50818},[],"The cryptographic enforcement can:",{"_3171":1794,"_27803":1764,"_19261":50820,"_5":13244,"_26299":50745,"_2667":50821},[],"allow or block RSA keys;",{"_3171":1795,"_27803":1764,"_19261":50823,"_5":13244,"_26299":50745,"_2667":50824},[],"limit the supported RSA sizes;",{"_3171":1796,"_27803":1764,"_19261":50826,"_5":13244,"_26299":50745,"_2667":50827},[],"allow or block ECDSA keys;",{"_3171":1797,"_27803":1764,"_19261":50829,"_5":13244,"_26299":50745,"_2667":50830},[],"limit the supported ECDSA sizes or curves.",{"_3171":1798,"_27803":1764,"_19261":50832,"_5":13244,"_26299":50745,"_2667":50833},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3171":1799,"_27803":1764,"_19261":50835,"_5":13244,"_26299":50749,"_2667":50836},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3171":1800,"_27803":1764,"_19261":50838,"_5":13244,"_26299":50749,"_2667":48325},[],{"_3171":1801,"_27803":1764,"_19261":50840,"_5":13244,"_26299":50749,"_2667":50841},[],"First choice",{"_3171":1802,"_27803":1764,"_19261":50843,"_5":13244,"_26299":50749,"_2667":50844},[],"Second choice",{"_3171":1803,"_27803":1764,"_19261":50846,"_5":13244,"_26299":50749,"_2667":50847},[],"If neither is supplied",{"_3171":1804,"_27803":1764,"_19261":50849,"_5":13244,"_26299":50749,"_2667":50850},[],"Direct signing with a CA",{"_3171":1805,"_27803":1764,"_19261":50852,"_5":13244,"_26299":50749,"_2667":50853},[],"`issuance_profile` embedded in the request",{"_3171":1806,"_27803":1764,"_19261":50855,"_5":13244,"_26299":50749,"_2667":50856},[],"Request `issuance_profile_id`",{"_3171":1807,"_27803":1764,"_19261":50858,"_5":13244,"_26299":50749,"_2667":50859},[],"CA default profile (`profile_id`).",{"_3171":1808,"_27803":1764,"_19261":50861,"_5":13244,"_26299":50749,"_2667":50862},[],"Issuance through a DMS",{"_3171":1809,"_27803":1764,"_19261":50864,"_5":13244,"_26299":50749,"_2667":50865},[],"`settings.issuance_profile_id`",{"_3171":1810,"_27803":1764,"_19261":50867,"_5":13244,"_26299":50749,"_2667":50868},[],"`settings.issuance_profile` embedded in the DMS",{"_3171":1811,"_27803":1764,"_19261":50870,"_5":13244,"_26299":50749,"_2667":50871},[],"Enrollment CA default profile.",{"_3171":1812,"_27803":1764,"_19261":50873,"_5":13244,"_26299":50749,"_2667":50874},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3171":1813,"_27803":1764,"_19261":50876,"_5":13244,"_26299":50749,"_2667":50877},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3171":1814,"_27803":1764,"_19261":50879,"_5":13244,"_26299":50757,"_2667":50880},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3171":1815,"_27803":1764,"_19261":50882,"_5":13244,"_26299":50761,"_2667":50883},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3171":1816,"_27803":1764,"_19261":50885,"_5":13244,"_26299":50765,"_2667":50886},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3171":1817,"_27803":1764,"_19261":50888,"_5":13244,"_26299":50769,"_2667":50889},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3171":1818,"_27803":1764,"_19261":50891,"_5":13244,"_26299":50773,"_2667":50892},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3171":1819,"_27803":1764,"_19261":50894,"_5":13244,"_26299":50773,"_2667":50895},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3171":1820,"_27803":1764,"_19261":50897,"_5":13244,"_26299":50777,"_2667":50898},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3171":1821,"_27803":1764,"_19261":50900,"_5":13244,"_26299":50777,"_2667":50901},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3171":1822,"_27803":1764,"_19261":50903,"_5":13244,"_26299":50777,"_2667":50904},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3171":1823,"_27803":1764,"_19261":50906,"_5":13244,"_26299":50777,"_2667":50907},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3171":1824,"_27803":1764,"_19261":50909,"_5":13244,"_26299":50781,"_2667":50910},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3171":1825,"_27803":1764,"_19261":50912,"_5":13244,"_26299":50781,"_2667":50913},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3171":1826,"_27803":1826,"_5":13570,"_2667":50915,"_28145":50916,"_19261":50918,"_26299":1826},"Certificate validation",[45221,46601,50297,50917],"Validation",[],{"_3171":1827,"_27803":1826,"_19261":50920,"_5":13244,"_26299":1826,"_2667":50921},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3171":1828,"_27803":1826,"_5":28142,"_19261":50923,"_26299":50924,"_2667":50925},[],"/docs/pr-preview/pr-52/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3171":1829,"_27803":1826,"_5":28142,"_19261":50927,"_26299":50928,"_2667":50929},[],"/docs/pr-preview/pr-52/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3171":1830,"_27803":1826,"_5":28142,"_19261":50931,"_26299":50932,"_2667":50933},[],"/docs/pr-preview/pr-52/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3171":1831,"_27803":1826,"_19261":50935,"_5":13244,"_26299":1826,"_2667":50936},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3171":1832,"_27803":1826,"_19261":50938,"_5":13244,"_26299":50924,"_2667":50939},[],"Verify these criteria together:",{"_3171":1833,"_27803":1826,"_19261":50941,"_5":13244,"_26299":50924,"_2667":49921},[],{"_3171":1834,"_27803":1826,"_19261":50943,"_5":13244,"_26299":50924,"_2667":50944},[],"Required result",{"_3171":1835,"_27803":1826,"_19261":50946,"_5":13244,"_26299":50924,"_2667":50947},[],"Chain and signature",{"_3171":1836,"_27803":1826,"_19261":50949,"_5":13244,"_26299":50924,"_2667":50950},[],"Valid chain to a root deliberately installed in the consumer.",{"_3171":1837,"_27803":1826,"_19261":50952,"_5":13244,"_26299":50924,"_2667":50953},[],"Dates",{"_3171":1838,"_27803":1826,"_19261":50955,"_5":13244,"_26299":50924,"_2667":50956},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3171":1839,"_27803":1826,"_19261":50958,"_5":13244,"_26299":50924,"_2667":46301},[],{"_3171":1840,"_27803":1826,"_19261":50960,"_5":13244,"_26299":50924,"_2667":50961},[],"Name, SAN or identifier matches the expected peer.",{"_3171":1841,"_27803":1826,"_19261":50963,"_5":13244,"_26299":50924,"_2667":45611},[],{"_3171":1842,"_27803":1826,"_19261":50965,"_5":13244,"_26299":50924,"_2667":50966},[],"KU, EKU and constraints permit the specific operation.",{"_3171":1843,"_27803":1826,"_19261":50968,"_5":13244,"_26299":50924,"_2667":50969},[],"Revocation",{"_3171":1844,"_27803":1826,"_19261":50971,"_5":13244,"_26299":50924,"_2667":50972},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3171":1845,"_27803":1826,"_19261":50974,"_5":13244,"_26299":50924,"_2667":50975},[],"Authorization",{"_3171":1846,"_27803":1826,"_19261":50977,"_5":13244,"_26299":50924,"_2667":50978},[],"The application permits that identity to perform the action.",{"_3171":1847,"_27803":1826,"_19261":50980,"_5":13244,"_26299":50924,"_2667":50981},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3171":1848,"_27803":1826,"_19261":50983,"_5":13244,"_26299":50928,"_2667":50984},[],"Mechanism",{"_3171":1849,"_27803":1826,"_19261":50986,"_5":13244,"_26299":50928,"_2667":50987},[],"When to use it",{"_3171":1850,"_27803":1826,"_19261":50989,"_5":13244,"_26299":50928,"_2667":50990},[],"What you must maintain",{"_3171":1851,"_27803":1826,"_19261":50992,"_5":13244,"_26299":50928,"_2667":50993},[],"OCSP",{"_3171":1852,"_27803":1826,"_19261":50995,"_5":13244,"_26299":50928,"_2667":50996},[],"Status query for a specific certificate.",{"_3171":1853,"_27803":1826,"_19261":50998,"_5":13244,"_26299":50928,"_2667":50999},[],"Responder access, signature verification and cache/freshness policy.",{"_3171":1854,"_27803":1826,"_19261":51001,"_5":13244,"_26299":50928,"_2667":51002},[],"CRL",{"_3171":1855,"_27803":1826,"_19261":51004,"_5":13244,"_26299":50928,"_2667":51005},[],"Local checks for many certificates or offline operation.",{"_3171":1856,"_27803":1826,"_19261":51007,"_5":13244,"_26299":50928,"_2667":51008},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3171":1857,"_27803":1826,"_19261":51010,"_5":13244,"_26299":50928,"_2667":51011},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3171":1858,"_27803":1826,"_19261":51013,"_5":13244,"_26299":50928,"_2667":51014},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3171":1859,"_27803":1826,"_19261":51016,"_5":13244,"_26299":50932,"_2667":51017},[],"Accept a current, authorized certificate with a known chain.",{"_3171":1860,"_27803":1826,"_19261":51019,"_5":13244,"_26299":50932,"_2667":51020},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3171":1861,"_27803":1826,"_19261":51022,"_5":13244,"_26299":50932,"_2667":51023},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3171":1862,"_27803":1826,"_19261":51025,"_5":13244,"_26299":50932,"_2667":51026},[],"Check that a new connection with that identity is rejected.",{"_3171":1863,"_27803":1826,"_19261":51028,"_5":13244,"_26299":50932,"_2667":51029},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3171":1864,"_27803":1826,"_19261":51031,"_5":13244,"_26299":50932,"_2667":51032},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3171":1865,"_27803":1826,"_19261":51034,"_5":13244,"_26299":50932,"_2667":51035},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3171":1866,"_27803":1826,"_19261":51037,"_5":13244,"_26299":50932,"_2667":51038},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3171":1867,"_27803":1826,"_19261":51040,"_5":13244,"_26299":50932,"_2667":51041},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3171":1868,"_27803":1868,"_5":13570,"_2667":51043,"_28145":51044,"_19261":51045,"_26299":1868},"Certificates",[45221,46601,50297,50298],[],{"_3171":1869,"_27803":1868,"_19261":51047,"_5":13244,"_26299":1868,"_2667":51048},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3171":1870,"_27803":1868,"_5":28142,"_19261":51050,"_26299":51051,"_2667":51052},[],"/docs/pr-preview/pr-52/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3171":1871,"_27803":1868,"_5":28142,"_19261":51054,"_26299":51055,"_2667":51056},[],"/docs/pr-preview/pr-52/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3171":1872,"_27803":1868,"_5":28142,"_19261":51058,"_26299":51059,"_2667":51060},[],"/docs/pr-preview/pr-52/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3171":1873,"_27803":1868,"_5":28142,"_19261":51062,"_26299":51063,"_2667":51064},[],"/docs/pr-preview/pr-52/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3171":1874,"_27803":1868,"_5":28142,"_19261":51066,"_26299":51067,"_2667":51068},[],"/docs/pr-preview/pr-52/platform/pki/certificates#open-the-action","Open the action",{"_3171":1875,"_27803":1868,"_5":28142,"_19261":51070,"_26299":51071,"_2667":51072},[],"/docs/pr-preview/pr-52/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3171":1876,"_27803":1868,"_5":28142,"_19261":51074,"_26299":51075,"_2667":51076},[],"/docs/pr-preview/pr-52/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3171":1877,"_27803":1868,"_5":28142,"_19261":51078,"_26299":51079,"_2667":51080},[],"/docs/pr-preview/pr-52/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3171":1878,"_27803":1868,"_5":28142,"_19261":51082,"_26299":51083,"_2667":51084},[],"/docs/pr-preview/pr-52/platform/pki/certificates#continue","Continue",{"_3171":1879,"_27803":1868,"_19261":51086,"_5":13244,"_26299":1868,"_2667":51087},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3171":1880,"_27803":1868,"_19261":51089,"_5":13244,"_26299":51051,"_2667":51090},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata. Certificate details include the key reference (`key_id`) and whether the private key is managed (`has_private_key`), and certificate lists can be filtered on `has_private_key`.",{"_3171":1881,"_27803":1868,"_19261":51092,"_5":13244,"_26299":51051,"_2667":51093},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3171":1882,"_27803":1868,"_19261":51095,"_5":13244,"_26299":51055,"_2667":51096},[],"Download the PEM and inspect it:",{"_3171":1883,"_27803":1868,"_19261":51098,"_5":13244,"_26299":51055,"_2667":51099},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3171":1884,"_27803":1868,"_19261":51101,"_5":13244,"_26299":51059,"_2667":51102},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3171":1885,"_27803":1868,"_19261":51104,"_5":13244,"_26299":51059,"_2667":51105},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3171":1886,"_27803":1868,"_19261":51107,"_5":13244,"_26299":51059,"_2667":51108},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3171":1887,"_27803":1868,"_19261":51110,"_5":13244,"_26299":51059,"_2667":51111},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3171":1888,"_27803":1868,"_19261":51113,"_5":13244,"_26299":51059,"_2667":51114},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3171":1889,"_27803":1868,"_19261":51116,"_5":13244,"_26299":51059,"_2667":51117},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3171":1890,"_27803":1868,"_19261":51119,"_5":13244,"_26299":51059,"_2667":51120},[],"For browser key generation, follow Issue your first certificate.",{"_3171":1891,"_27803":1868,"_19261":51122,"_5":13244,"_26299":51063,"_2667":51123},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3171":1892,"_27803":1868,"_19261":51125,"_5":13244,"_26299":51067,"_2667":51126},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3171":1893,"_27803":1868,"_19261":51128,"_5":13244,"_26299":51071,"_2667":51129},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3171":1894,"_27803":1868,"_19261":51131,"_5":13244,"_26299":51075,"_2667":51132},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3171":1895,"_27803":1868,"_19261":51134,"_5":13244,"_26299":51075,"_2667":51135},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3171":1896,"_27803":1868,"_19261":51137,"_5":13244,"_26299":51075,"_2667":51138},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3171":1897,"_27803":1868,"_19261":51140,"_5":13244,"_26299":51079,"_2667":51141},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3171":1898,"_27803":1868,"_19261":51143,"_5":13244,"_26299":51079,"_2667":51144},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3171":1899,"_27803":1868,"_19261":51146,"_5":13244,"_26299":51079,"_2667":51147},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3171":1900,"_27803":1868,"_19261":51149,"_5":13244,"_26299":51083,"_2667":51150},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3171":1901,"_27803":1868,"_19261":51152,"_5":13244,"_26299":51083,"_2667":51153},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3171":1902,"_27803":1902,"_5":13570,"_2667":51155,"_28145":51156,"_19261":51158,"_26299":1902},"Certificate lifecycle",[45221,46601,50297,51157],"Concepts",[],{"_3171":1903,"_27803":1902,"_19261":51160,"_5":13244,"_26299":1902,"_2667":51161},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3171":1904,"_27803":1902,"_5":28142,"_19261":51163,"_26299":51164,"_2667":51165},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3171":1905,"_27803":1902,"_5":28142,"_19261":51167,"_26299":51168,"_2667":51169},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3171":1906,"_27803":1902,"_5":28142,"_19261":51171,"_26299":51172,"_2667":51173},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3171":1907,"_27803":1902,"_5":28142,"_19261":51175,"_26299":51176,"_2667":51177},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3171":1908,"_27803":1902,"_5":28142,"_19261":51179,"_26299":51180,"_2667":51181},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3171":1909,"_27803":1902,"_5":28142,"_19261":51183,"_26299":51184,"_2667":51185},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3171":1910,"_27803":1902,"_5":28142,"_19261":51187,"_26299":51188,"_2667":51189},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3171":1911,"_27803":1902,"_5":28142,"_19261":51191,"_26299":51192,"_2667":51193},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3171":1912,"_27803":1902,"_5":28142,"_19261":51195,"_26299":51196,"_2667":51197},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3171":1913,"_27803":1902,"_5":28142,"_19261":51199,"_26299":51200,"_2667":51201},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3171":1914,"_27803":1902,"_19261":51203,"_5":13244,"_26299":1902,"_2667":51204},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3171":1915,"_27803":1902,"_19261":51206,"_5":13244,"_26299":51168,"_2667":51207},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3171":1916,"_27803":1902,"_19261":51209,"_5":13244,"_26299":51172,"_2667":51210},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3171":1917,"_27803":1902,"_19261":51212,"_5":13244,"_26299":51176,"_2667":51213},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3171":1918,"_27803":1902,"_19261":51215,"_5":13244,"_26299":51180,"_2667":51216},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3171":1919,"_27803":1902,"_19261":51218,"_5":13244,"_26299":51184,"_2667":51219},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3171":1920,"_27803":1902,"_19261":51221,"_5":13244,"_26299":51188,"_2667":51222},[],"Lamassu persists four X.509 states:",{"_3171":1921,"_27803":1902,"_19261":51224,"_5":13244,"_26299":51188,"_2667":51225},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3171":1922,"_27803":1902,"_19261":51227,"_5":13244,"_26299":51188,"_2667":51228},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3171":1923,"_27803":1902,"_19261":51230,"_5":13244,"_26299":51188,"_2667":51231},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3171":1924,"_27803":1902,"_19261":51233,"_5":13244,"_26299":51188,"_2667":51234},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3171":1925,"_27803":1902,"_19261":51236,"_5":13244,"_26299":51188,"_2667":51237},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3171":1926,"_27803":1902,"_19261":51239,"_5":13244,"_26299":51192,"_2667":51240},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3171":1927,"_27803":1902,"_19261":51242,"_5":13244,"_26299":51192,"_2667":51243},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3171":1928,"_27803":1902,"_19261":51245,"_5":13244,"_26299":51192,"_2667":51246},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3171":1929,"_27803":1902,"_19261":51248,"_5":13244,"_26299":51196,"_2667":51249},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3171":1930,"_27803":1902,"_19261":51251,"_5":13244,"_26299":51196,"_2667":51252},[],"Before confirming:",{"_3171":1931,"_27803":1902,"_19261":51254,"_5":13244,"_26299":51196,"_2667":51255},[],"Identify DMSs, devices and services that trust that chain.",{"_3171":1932,"_27803":1902,"_19261":51257,"_5":13244,"_26299":51196,"_2667":51258},[],"Distribute the new chain of trust.",{"_3171":1933,"_27803":1902,"_19261":51260,"_5":13244,"_26299":51196,"_2667":51261},[],"Reissue the necessary identities.",{"_3171":1934,"_27803":1902,"_19261":51263,"_5":13244,"_26299":51196,"_2667":51264},[],"Check OCSP and CRL from a real consumer.",{"_3171":1935,"_27803":1902,"_19261":51266,"_5":13244,"_26299":51196,"_2667":51267},[],"Revoke the old CA once no legitimate traffic remains.",{"_3171":1936,"_27803":1902,"_19261":51269,"_5":13244,"_26299":51196,"_2667":51270},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3171":1937,"_27803":1902,"_19261":51272,"_5":13244,"_26299":51200,"_2667":51273},[],"Certificates entering the preventive or critical renewal window.",{"_3171":1938,"_27803":1902,"_19261":51275,"_5":13244,"_26299":51200,"_2667":51276},[],"Repeated enrollment or re-enrollment failures.",{"_3171":1939,"_27803":1902,"_19261":51278,"_5":13244,"_26299":51200,"_2667":51279},[],"Status changes and revocation reasons.",{"_3171":1940,"_27803":1902,"_19261":51281,"_5":13244,"_26299":51200,"_2667":51282},[],"OCSP and CRL publication and validity.",{"_3171":1941,"_27803":1902,"_19261":51284,"_5":13244,"_26299":51200,"_2667":51285},[],"Dependencies still presenting a replaced certificate.",{"_3171":1942,"_27803":1902,"_19261":51287,"_5":13244,"_26299":51200,"_2667":51288},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3171":1943,"_27803":1943,"_5":13570,"_2667":51290,"_28145":51291,"_19261":51292,"_26299":1943},"Trust model",[45221,46601,50297,51157],[],{"_3171":1944,"_27803":1943,"_19261":51294,"_5":13244,"_26299":1943,"_2667":51295},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3171":1945,"_27803":1943,"_5":28142,"_19261":51297,"_26299":51298,"_2667":51299},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3171":1946,"_27803":1943,"_5":28142,"_19261":51301,"_26299":51302,"_2667":51303},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3171":1947,"_27803":1943,"_5":28142,"_19261":51305,"_26299":51306,"_2667":51307},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3171":1948,"_27803":1943,"_5":28142,"_19261":51309,"_26299":51310,"_2667":51311},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3171":1949,"_27803":1943,"_5":28142,"_19261":51313,"_26299":51314,"_2667":51315},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3171":1950,"_27803":1943,"_5":28142,"_19261":51317,"_26299":51318,"_2667":51319},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3171":1951,"_27803":1943,"_5":28142,"_19261":51321,"_26299":51322,"_2667":51323},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3171":1952,"_27803":1943,"_5":28142,"_19261":51325,"_26299":51326,"_2667":51327},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3171":1953,"_27803":1943,"_5":28142,"_19261":51329,"_26299":51330,"_2667":51331},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3171":1954,"_27803":1943,"_5":28142,"_19261":51333,"_26299":51334,"_2667":51335},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3171":1955,"_27803":1943,"_19261":51337,"_5":13244,"_26299":1943,"_2667":51338},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3171":1956,"_27803":1943,"_19261":51340,"_5":13244,"_26299":51302,"_2667":51341},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3171":1957,"_27803":1943,"_19261":51343,"_5":13244,"_26299":51306,"_2667":51344},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3171":1958,"_27803":1943,"_19261":51346,"_5":13244,"_26299":51310,"_2667":51347},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3171":1959,"_27803":1943,"_19261":51349,"_5":13244,"_26299":51314,"_2667":51350},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3171":1960,"_27803":1943,"_19261":51352,"_5":13244,"_26299":51318,"_2667":51353},[],"The device proves it can enroll according to the DMS policy.",{"_3171":1961,"_27803":1943,"_19261":51355,"_5":13244,"_26299":51318,"_2667":51356},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3171":1962,"_27803":1943,"_19261":51358,"_5":13244,"_26299":51318,"_2667":51359},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3171":1963,"_27803":1943,"_19261":51361,"_5":13244,"_26299":51318,"_2667":51362},[],"The device installs the certificate and the chain it needs.",{"_3171":1964,"_27803":1943,"_19261":51364,"_5":13244,"_26299":51318,"_2667":51365},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3171":1965,"_27803":1943,"_19261":51367,"_5":13244,"_26299":51318,"_2667":51368},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3171":1966,"_27803":1943,"_19261":51370,"_5":13244,"_26299":51322,"_2667":51371},[],"A DMS relates three sets that are worth designing separately:",{"_3171":1967,"_27803":1943,"_19261":51373,"_5":13244,"_26299":51322,"_2667":51374},[],"**Enrollment CA:** signs the new identities.",{"_3171":1968,"_27803":1943,"_19261":51376,"_5":13244,"_26299":51322,"_2667":51377},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3171":1969,"_27803":1943,"_19261":51379,"_5":13244,"_26299":51322,"_2667":51380},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3171":1970,"_27803":1943,"_19261":51382,"_5":13244,"_26299":51322,"_2667":51383},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3171":1971,"_27803":1943,"_19261":51385,"_5":13244,"_26299":51326,"_2667":51386},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3171":1972,"_27803":1943,"_19261":51388,"_5":13244,"_26299":51326,"_2667":51389},[],"that the current date is between `Not Before` and `Not After`;",{"_3171":1973,"_27803":1943,"_19261":51391,"_5":13244,"_26299":51326,"_2667":51392},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3171":1974,"_27803":1943,"_19261":51394,"_5":13244,"_26299":51326,"_2667":51395},[],"that names, SANs and subject match the expected identity;",{"_3171":1975,"_27803":1943,"_19261":51397,"_5":13244,"_26299":51326,"_2667":51398},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3171":1976,"_27803":1943,"_19261":51400,"_5":13244,"_26299":51326,"_2667":51401},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3171":1977,"_27803":1943,"_19261":51403,"_5":13244,"_26299":51326,"_2667":51404},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3171":1978,"_27803":1943,"_19261":51406,"_5":13244,"_26299":51330,"_2667":51407},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3171":1979,"_27803":1943,"_19261":51409,"_5":13244,"_26299":51334,"_2667":51410},[],"Keep the root out of daily operations, or with very restricted access.",{"_3171":1980,"_27803":1943,"_19261":51412,"_5":13244,"_26299":51334,"_2667":51413},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3171":1981,"_27803":1943,"_19261":51415,"_5":13244,"_26299":51334,"_2667":51416},[],"Assign explicit profiles to every use case.",{"_3171":1982,"_27803":1943,"_19261":51418,"_5":13244,"_26299":51334,"_2667":51419},[],"Distribute the new trust before starting a rotation.",{"_3171":1983,"_27803":1943,"_19261":51421,"_5":13244,"_26299":51334,"_2667":51422},[],"Keep enough overlap to renew a disconnected fleet.",{"_3171":1984,"_27803":1943,"_19261":51424,"_5":13244,"_26299":51334,"_2667":51425},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3171":1985,"_27803":1943,"_19261":51427,"_5":13244,"_26299":51334,"_2667":51428},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3171":1986,"_27803":1986,"_5":13570,"_2667":51430,"_28145":51431,"_19261":51432,"_26299":1986},"Revocation lists (CRL)",[45221,46601,50297,50917],[],{"_3171":1987,"_27803":1986,"_19261":51434,"_5":13244,"_26299":1986,"_2667":51435},[],"Generate and distribute signed lists to validate certificates offline.",{"_3171":1988,"_27803":1986,"_5":28142,"_19261":51437,"_26299":51438,"_2667":51439},[],"/docs/pr-preview/pr-52/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_3171":1989,"_27803":1986,"_5":28142,"_19261":51441,"_26299":51442,"_2667":51443},[],"/docs/pr-preview/pr-52/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3171":1990,"_27803":1986,"_5":28142,"_19261":51445,"_26299":51446,"_2667":51447},[],"/docs/pr-preview/pr-52/platform/pki/crl#crl-contents","CRL contents",{"_3171":1991,"_27803":1986,"_5":28142,"_19261":51449,"_26299":51450,"_2667":51451},[],"/docs/pr-preview/pr-52/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3171":1992,"_27803":1986,"_5":28142,"_19261":51453,"_26299":51454,"_2667":51455},[],"/docs/pr-preview/pr-52/platform/pki/crl#va-role-management-api","VA role management API",{"_3171":1993,"_27803":1986,"_5":28142,"_19261":51457,"_26299":51458,"_2667":51459},[],"/docs/pr-preview/pr-52/platform/pki/crl#from-the-interface","From the interface",{"_3171":1994,"_27803":1986,"_5":28142,"_19261":51461,"_26299":51462,"_2667":51463},[],"/docs/pr-preview/pr-52/platform/pki/crl#references","References",{"_3171":1995,"_27803":1986,"_19261":51465,"_5":13244,"_26299":1986,"_2667":51466},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3171":1996,"_27803":1986,"_19261":51468,"_5":13244,"_26299":51438,"_2667":51469},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3171":1997,"_27803":1986,"_19261":51471,"_5":13244,"_26299":51438,"_2667":51472},[],"`crl_options` field",{"_3171":1998,"_27803":1986,"_19261":51474,"_5":13244,"_26299":51438,"_2667":45611},[],{"_3171":1999,"_27803":1986,"_19261":51476,"_5":13244,"_26299":51438,"_2667":51477},[],"Backend initial value",{"_3171":2000,"_27803":1986,"_19261":51479,"_5":13244,"_26299":51438,"_2667":51480},[],"`validity`",{"_3171":2001,"_27803":1986,"_19261":51482,"_5":13244,"_26299":51438,"_2667":51483},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3171":2002,"_27803":1986,"_19261":51485,"_5":13244,"_26299":51438,"_2667":51486},[],"7 days.",{"_3171":2003,"_27803":1986,"_19261":51488,"_5":13244,"_26299":51438,"_2667":51489},[],"`refresh_interval`",{"_3171":2004,"_27803":1986,"_19261":51491,"_5":13244,"_26299":51438,"_2667":51492},[],"Time since publication that triggers scheduled renewal.",{"_3171":2005,"_27803":1986,"_19261":51494,"_5":13244,"_26299":51438,"_2667":51495},[],"6 days and 23 hours.",{"_3171":2006,"_27803":1986,"_19261":51497,"_5":13244,"_26299":51438,"_2667":51498},[],"`regenerate_on_revoke`",{"_3171":2007,"_27803":1986,"_19261":51500,"_5":13244,"_26299":51438,"_2667":51501},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3171":2008,"_27803":1986,"_19261":51503,"_5":13244,"_26299":51438,"_2667":51504},[],"`true`.",{"_3171":2009,"_27803":1986,"_19261":51506,"_5":13244,"_26299":51438,"_2667":51507},[],"`signer_certificate_serial_number`",{"_3171":2010,"_27803":1986,"_19261":51509,"_5":13244,"_26299":51438,"_2667":51510},[],"Serial number of the existing certificate that signs the CRL.",{"_3171":2011,"_27803":1986,"_19261":51512,"_5":13244,"_26299":51438,"_2667":51513},[],"Serial number of the CA’s current certificate.",{"_3171":2012,"_27803":1986,"_19261":51515,"_5":13244,"_26299":51438,"_2667":51516},[],"The signer must be an existing certificate with the `cRLSign` key usage whose subject and public key match the CA of the role. Reissued certificates that share the CA’s key are valid signers; unrelated signers are rejected. The certificate referenced as signer cannot be deleted while the role uses it.",{"_3171":2013,"_27803":1986,"_19261":51518,"_5":13244,"_26299":51438,"_2667":51519},[],"Today the VA identifies the CRL by the CA's SKI, so two CAs with the same key (or a CA imported with an SKI that already exists) share a single role and a single CRL. Certificates from one of them may never appear in the list, and clients will reject it because the issuer does not match. Create each CA with its own key. If you already have CAs that share a key, review them before upgrading.",{"_3171":2014,"_27803":1986,"_19261":51521,"_5":13244,"_26299":51438,"_2667":51522},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_3171":2015,"_27803":1986,"_19261":51524,"_5":13244,"_26299":51442,"_2667":51525},[],"The scheduled job requests another list when `refresh_interval` is reached or when the list approaches expiration within the configured watch period. This depends on working jobs, storage and signing; it does not guarantee renewal during a service failure.",{"_3171":2016,"_27803":1986,"_19261":51527,"_5":13244,"_26299":51442,"_2667":51528},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3171":2017,"_27803":1986,"_19261":51530,"_5":13244,"_26299":51442,"_2667":51531},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3171":2018,"_27803":1986,"_19261":51533,"_5":13244,"_26299":51446,"_2667":51534},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3171":2019,"_27803":1986,"_19261":51536,"_5":13244,"_26299":51446,"_2667":51537},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3171":2020,"_27803":1986,"_19261":51539,"_5":13244,"_26299":51450,"_2667":51540},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_3171":2021,"_27803":1986,"_19261":51542,"_5":13244,"_26299":51450,"_2667":51543},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3171":2022,"_27803":1986,"_19261":51545,"_5":13244,"_26299":51450,"_2667":51546},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3171":2023,"_27803":1986,"_19261":51548,"_5":13244,"_26299":51450,"_2667":51549},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3171":2024,"_27803":1986,"_19261":51551,"_5":13244,"_26299":51450,"_2667":51552},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3171":2025,"_27803":1986,"_19261":51554,"_5":13244,"_26299":51454,"_2667":51555},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3171":2026,"_27803":1986,"_19261":51557,"_5":13244,"_26299":51454,"_2667":48328},[],{"_3171":2027,"_27803":1986,"_19261":51559,"_5":13244,"_26299":51454,"_2667":51560},[],"Relative path",{"_3171":2028,"_27803":1986,"_19261":51562,"_5":13244,"_26299":51454,"_2667":48325},[],{"_3171":2029,"_27803":1986,"_19261":51564,"_5":13244,"_26299":51454,"_2667":51565},[],"`GET`",{"_3171":2030,"_27803":1986,"_19261":51567,"_5":13244,"_26299":51454,"_2667":51568},[],"`/v1/roles/{ca-ski}`",{"_3171":2031,"_27803":1986,"_19261":51570,"_5":13244,"_26299":51454,"_2667":51571},[],"Read `crl_options` and `latest_crl`.",{"_3171":2032,"_27803":1986,"_19261":51573,"_5":13244,"_26299":51454,"_2667":51574},[],"`PUT`",{"_3171":2033,"_27803":1986,"_19261":51576,"_5":13244,"_26299":51454,"_2667":51568},[],{"_3171":2034,"_27803":1986,"_19261":51578,"_5":13244,"_26299":51454,"_2667":51579},[],"Replace CRL configuration.",{"_3171":2035,"_27803":1986,"_19261":51581,"_5":13244,"_26299":51454,"_2667":51582},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_3171":2036,"_27803":1986,"_19261":51584,"_5":13244,"_26299":51454,"_2667":51585},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_3171":2037,"_27803":1986,"_19261":51587,"_5":13244,"_26299":51454,"_2667":51588},[],"When you delete a CA, its VA role is kept but can no longer be updated through the API (it returns 404). Adjust validity, interval and signer before deleting the CA, or do not delete it while it still publishes CRLs. A CA whose certificate lacks the `cRLSign` usage cannot generate its CRL or edit its role either.",{"_3171":2038,"_27803":1986,"_19261":51590,"_5":13244,"_26299":51458,"_2667":51591},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_3171":2039,"_27803":1986,"_19261":51593,"_5":13244,"_26299":51462,"_2667":51594},[],"RFC 5280: X.509 and CRL profile.",{"_3171":2040,"_27803":1986,"_19261":51596,"_5":13244,"_26299":51462,"_2667":51597},[],"OpenSSL: openssl-crl.",{"_3171":2041,"_27803":1986,"_19261":51599,"_5":13244,"_26299":51462,"_2667":51600},[],"OpenSSL: openssl-verify.",{"_3171":2042,"_27803":1986,"_19261":51602,"_5":13244,"_26299":51462,"_2667":51603},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3171":2043,"_27803":1986,"_19261":51605,"_5":13244,"_26299":51462,"_2667":51606},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3171":2044,"_27803":2044,"_5":13570,"_2667":51608,"_28145":51609,"_19261":51610,"_26299":2044},"Keys and cryptographic engines",[45221,46601,50297,50298],[],{"_3171":2045,"_27803":2044,"_19261":51612,"_5":13244,"_26299":2044,"_2667":51613},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3171":2046,"_27803":2044,"_5":28142,"_19261":51615,"_26299":51616,"_2667":51617},[],"/docs/pr-preview/pr-52/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3171":2047,"_27803":2044,"_5":28142,"_19261":51619,"_26299":51620,"_2667":51621},[],"/docs/pr-preview/pr-52/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3171":2048,"_27803":2044,"_5":28142,"_19261":51623,"_26299":51624,"_2667":51625},[],"/docs/pr-preview/pr-52/platform/pki/key-management#file-system","File System",{"_3171":2049,"_27803":2044,"_5":28142,"_19261":51627,"_26299":51628,"_2667":51629},[],"/docs/pr-preview/pr-52/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3171":2050,"_27803":2044,"_5":28142,"_19261":51631,"_26299":51632,"_2667":51633},[],"/docs/pr-preview/pr-52/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3171":2051,"_27803":2044,"_5":28142,"_19261":51635,"_26299":51636,"_2667":51637},[],"/docs/pr-preview/pr-52/platform/pki/key-management#aws-kms","AWS KMS",{"_3171":2052,"_27803":2044,"_5":28142,"_19261":51639,"_26299":51640,"_2667":51641},[],"/docs/pr-preview/pr-52/platform/pki/key-management#pkcs11","PKCS#11",{"_3171":2053,"_27803":2044,"_5":28142,"_19261":51643,"_26299":51644,"_2667":51645},[],"/docs/pr-preview/pr-52/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3171":2054,"_27803":2044,"_5":28142,"_19261":51647,"_26299":51648,"_2667":51649},[],"/docs/pr-preview/pr-52/platform/pki/key-management#key-inventory","Key inventory",{"_3171":2055,"_27803":2044,"_5":28142,"_19261":51651,"_26299":51652,"_2667":51653},[],"/docs/pr-preview/pr-52/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3171":2056,"_27803":2044,"_5":28142,"_19261":51655,"_26299":51656,"_2667":51657},[],"/docs/pr-preview/pr-52/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3171":2057,"_27803":2044,"_5":28142,"_19261":51659,"_26299":51660,"_2667":51661},[],"/docs/pr-preview/pr-52/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3171":2058,"_27803":2044,"_5":28142,"_19261":51663,"_26299":51664,"_2667":51665},[],"/docs/pr-preview/pr-52/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3171":2059,"_27803":2044,"_5":28142,"_19261":51667,"_26299":51668,"_2667":51669},[],"/docs/pr-preview/pr-52/platform/pki/key-management#view-details","View details",{"_3171":2060,"_27803":2044,"_5":28142,"_19261":51671,"_26299":51672,"_2667":51673},[],"/docs/pr-preview/pr-52/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3171":2061,"_27803":2044,"_5":28142,"_19261":51675,"_26299":51676,"_2667":51677},[],"/docs/pr-preview/pr-52/platform/pki/key-management#sign","Sign",{"_3171":2062,"_27803":2044,"_5":28142,"_19261":51679,"_26299":51680,"_2667":51681},[],"/docs/pr-preview/pr-52/platform/pki/key-management#verify","Verify",{"_3171":2063,"_27803":2044,"_5":28142,"_19261":51683,"_26299":51684,"_2667":51685},[],"/docs/pr-preview/pr-52/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3171":2064,"_27803":2044,"_5":28142,"_19261":51687,"_26299":51688,"_2667":51689},[],"/docs/pr-preview/pr-52/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3171":2065,"_27803":2044,"_5":28142,"_19261":51691,"_26299":51692,"_2667":51693},[],"/docs/pr-preview/pr-52/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3171":2066,"_27803":2044,"_19261":51695,"_5":13244,"_26299":2044,"_2667":51696},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3171":2067,"_27803":2044,"_19261":51698,"_5":13244,"_26299":2044,"_2667":51699},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3171":2068,"_27803":2044,"_19261":51701,"_5":13244,"_26299":51616,"_2667":51702},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3171":2069,"_27803":2044,"_19261":51704,"_5":13244,"_26299":51616,"_2667":51705},[],"In practice, it lets you:",{"_3171":2070,"_27803":2044,"_19261":51707,"_5":13244,"_26299":51616,"_2667":51708},[],"Generate new key pairs from Lamassu IoT.",{"_3171":2071,"_27803":2044,"_19261":51710,"_5":13244,"_26299":51616,"_2667":51711},[],"Import keys created externally.",{"_3171":2072,"_27803":2044,"_19261":51713,"_5":13244,"_26299":51616,"_2667":51714},[],"Delegate custody and cryptographic operations to external engines.",{"_3171":2073,"_27803":2044,"_19261":51716,"_5":13244,"_26299":51616,"_2667":51717},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3171":2074,"_27803":2044,"_19261":51719,"_5":13244,"_26299":51620,"_2667":51720},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3171":2075,"_27803":2044,"_19261":51722,"_5":13244,"_26299":51620,"_2667":51723},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3171":2076,"_27803":2044,"_19261":51725,"_5":13244,"_26299":51620,"_2667":51726},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3171":2077,"_27803":2044,"_19261":51728,"_5":13244,"_26299":51624,"_2667":51729},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3171":2078,"_27803":2044,"_19261":51731,"_5":13244,"_26299":51628,"_2667":51732},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3171":2079,"_27803":2044,"_19261":51734,"_5":13244,"_26299":51632,"_2667":51735},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3171":2080,"_27803":2044,"_19261":51737,"_5":13244,"_26299":51636,"_2667":51738},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3171":2081,"_27803":2044,"_19261":51740,"_5":13244,"_26299":51640,"_2667":51741},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3171":2082,"_27803":2044,"_19261":51743,"_5":13244,"_26299":51644,"_2667":51744},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3171":2083,"_27803":2044,"_19261":51746,"_5":13244,"_26299":51644,"_2667":51747},[],"Lamassu shows the enabled engines in the console.",{"_3171":2084,"_27803":2044,"_19261":51749,"_5":13244,"_26299":51644,"_2667":51750},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3171":2085,"_27803":2044,"_19261":51752,"_5":13244,"_26299":51644,"_2667":51753},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3171":2086,"_27803":2044,"_19261":51755,"_5":13244,"_26299":51648,"_2667":51756},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3171":2087,"_27803":2044,"_19261":51758,"_5":13244,"_26299":51648,"_2667":51759},[],"The table includes the following fields:",{"_3171":2088,"_27803":2044,"_19261":51761,"_5":13244,"_26299":51648,"_2667":51762},[],"**Name**: descriptive name of the key.",{"_3171":2089,"_27803":2044,"_19261":51764,"_5":13244,"_26299":51648,"_2667":51765},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3171":2090,"_27803":2044,"_19261":51767,"_5":13244,"_26299":51648,"_2667":51768},[],"**Strength**: visual indicator of cryptographic strength.",{"_3171":2091,"_27803":2044,"_19261":51770,"_5":13244,"_26299":51648,"_2667":51771},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3171":2092,"_27803":2044,"_19261":51773,"_5":13244,"_26299":51648,"_2667":51774},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3171":2093,"_27803":2044,"_19261":51776,"_5":13244,"_26299":51648,"_2667":51777},[],"**Aliases**: alternative names associated with the key.",{"_3171":2094,"_27803":2044,"_19261":51779,"_5":13244,"_26299":51648,"_2667":51780},[],"**Tags**: labels for classification and search.",{"_3171":2095,"_27803":2044,"_19261":51782,"_5":13244,"_26299":51648,"_2667":51783},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3171":2096,"_27803":2044,"_19261":51785,"_5":13244,"_26299":51648,"_2667":51786},[],"From this view you also reach the most common actions:",{"_3171":2097,"_27803":2044,"_19261":51788,"_5":13244,"_26299":51648,"_2667":51789},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3171":2098,"_27803":2044,"_19261":51791,"_5":13244,"_26299":51648,"_2667":51792},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3171":2099,"_27803":2044,"_19261":51794,"_5":13244,"_26299":51648,"_2667":51795},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3171":2100,"_27803":2044,"_19261":51797,"_5":13244,"_26299":51648,"_2667":51798},[],"**Delete Key** to remove the key from the system.",{"_3171":2101,"_27803":2044,"_19261":51800,"_5":13244,"_26299":51652,"_2667":51801},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3171":2102,"_27803":2044,"_19261":51803,"_5":13244,"_26299":51656,"_2667":51804},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3171":2103,"_27803":2044,"_19261":51806,"_5":13244,"_26299":51656,"_2667":51807},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3171":2104,"_27803":2044,"_19261":51809,"_5":13244,"_26299":51656,"_2667":51810},[],"**Key Name**: unique and descriptive name.",{"_3171":2105,"_27803":2044,"_19261":51812,"_5":13244,"_26299":51656,"_2667":51813},[],"**Crypto Engine**: engine that will keep the key.",{"_3171":2106,"_27803":2044,"_19261":51815,"_5":13244,"_26299":51656,"_2667":51816},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3171":2107,"_27803":2044,"_19261":51818,"_5":13244,"_26299":51656,"_2667":51819},[],"**Tags**: metadata to classify the key.",{"_3171":2108,"_27803":2044,"_19261":51821,"_5":13244,"_26299":51656,"_2667":51822},[],"**Metadata**: additional information for advanced uses.",{"_3171":2109,"_27803":2044,"_19261":51824,"_5":13244,"_26299":51660,"_2667":51825},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3171":2110,"_27803":2044,"_19261":51827,"_5":13244,"_26299":51660,"_2667":51828},[],"When you have an exportable private key and the destination engine supports import.",{"_3171":2111,"_27803":2044,"_19261":51830,"_5":13244,"_26299":51660,"_2667":51831},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3171":2112,"_27803":2044,"_19261":51833,"_5":13244,"_26299":51660,"_2667":51834},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3171":2113,"_27803":2044,"_19261":51836,"_5":13244,"_26299":51660,"_2667":51837},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3171":2114,"_27803":2044,"_19261":51839,"_5":13244,"_26299":51660,"_2667":51840},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3171":2115,"_27803":2044,"_19261":51842,"_5":13244,"_26299":51660,"_2667":51843},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3171":2116,"_27803":2044,"_19261":51845,"_5":13244,"_26299":51660,"_2667":51846},[],"**Tags**: labels for organization and search.",{"_3171":2117,"_27803":2044,"_19261":51848,"_5":13244,"_26299":51660,"_2667":51849},[],"**Metadata**: additional optional information.",{"_3171":2118,"_27803":2044,"_19261":51851,"_5":13244,"_26299":51660,"_2667":51852},[],"**Private Key (PEM)**: private key in PEM format.",{"_3171":2119,"_27803":2044,"_19261":51854,"_5":13244,"_26299":51660,"_2667":51855},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3171":2120,"_27803":2044,"_19261":51857,"_5":13244,"_26299":51664,"_2667":51858},[],"Each registered key has a detail view and several operational actions.",{"_3171":2121,"_27803":2044,"_19261":51860,"_5":13244,"_26299":51668,"_2667":51861},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3171":2122,"_27803":2044,"_19261":51863,"_5":13244,"_26299":51668,"_2667":51864},[],"The **Overview** tab shows, among others, these fields:",{"_3171":2123,"_27803":2044,"_19261":51866,"_5":13244,"_26299":51668,"_2667":51867},[],"**Key Name**: descriptive name.",{"_3171":2124,"_27803":2044,"_19261":51869,"_5":13244,"_26299":51668,"_2667":51870},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3171":2125,"_27803":2044,"_19261":51872,"_5":13244,"_26299":51668,"_2667":51873},[],"**Tags**: associated labels.",{"_3171":2126,"_27803":2044,"_19261":51875,"_5":13244,"_26299":51668,"_2667":51876},[],"**Aliases**: alternative names.",{"_3171":2127,"_27803":2044,"_19261":51878,"_5":13244,"_26299":51668,"_2667":51879},[],"**Crypto Engine**: engine where the key resides.",{"_3171":2128,"_27803":2044,"_19261":51881,"_5":13244,"_26299":51668,"_2667":51882},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3171":2129,"_27803":2044,"_19261":51884,"_5":13244,"_26299":51668,"_2667":51885},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3171":2130,"_27803":2044,"_19261":51887,"_5":13244,"_26299":51668,"_2667":51888},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3171":2131,"_27803":2044,"_19261":51890,"_5":13244,"_26299":51672,"_2667":51891},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3171":2132,"_27803":2044,"_19261":51893,"_5":13244,"_26299":51672,"_2667":51894},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3171":2133,"_27803":2044,"_19261":51896,"_5":13244,"_26299":51672,"_2667":51897},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3171":2134,"_27803":2044,"_19261":51899,"_5":13244,"_26299":51676,"_2667":51900},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3171":2135,"_27803":2044,"_19261":51902,"_5":13244,"_26299":51676,"_2667":51903},[],"Main fields:",{"_3171":2136,"_27803":2044,"_19261":51905,"_5":13244,"_26299":51676,"_2667":51906},[],"**Algorithm**: signing algorithm available for the key type.",{"_3171":2137,"_27803":2044,"_19261":51908,"_5":13244,"_26299":51676,"_2667":51909},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3171":2138,"_27803":2044,"_19261":51911,"_5":13244,"_26299":51676,"_2667":51912},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3171":2139,"_27803":2044,"_19261":51914,"_5":13244,"_26299":51676,"_2667":51915},[],"**Message**: content to sign.",{"_3171":2140,"_27803":2044,"_19261":51917,"_5":13244,"_26299":51676,"_2667":51918},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3171":2141,"_27803":2044,"_19261":51920,"_5":13244,"_26299":51680,"_2667":51921},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3171":2142,"_27803":2044,"_19261":51923,"_5":13244,"_26299":51680,"_2667":51903},[],{"_3171":2143,"_27803":2044,"_19261":51925,"_5":13244,"_26299":51680,"_2667":51926},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3171":2144,"_27803":2044,"_19261":51928,"_5":13244,"_26299":51680,"_2667":51929},[],"**Message Type**: `Raw` or `Digest`.",{"_3171":2145,"_27803":2044,"_19261":51931,"_5":13244,"_26299":51680,"_2667":51932},[],"**Payload Encoding**: encoding of the message.",{"_3171":2146,"_27803":2044,"_19261":51934,"_5":13244,"_26299":51680,"_2667":51935},[],"**Message**: original message or hash.",{"_3171":2147,"_27803":2044,"_19261":51937,"_5":13244,"_26299":51680,"_2667":51938},[],"**Signature**: signature to check.",{"_3171":2148,"_27803":2044,"_19261":51940,"_5":13244,"_26299":51680,"_2667":51941},[],"**Result**: indicator of the validation result.",{"_3171":2149,"_27803":2044,"_19261":51943,"_5":13244,"_26299":51684,"_2667":51944},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3171":2150,"_27803":2044,"_19261":51946,"_5":13244,"_26299":51684,"_2667":51947},[],"This flow is useful for:",{"_3171":2151,"_27803":2044,"_19261":51949,"_5":13244,"_26299":51684,"_2667":51950},[],"Requesting certificates from an external CA.",{"_3171":2152,"_27803":2044,"_19261":51952,"_5":13244,"_26299":51684,"_2667":51953},[],"Renewing an identity while keeping the same key.",{"_3171":2153,"_27803":2044,"_19261":51955,"_5":13244,"_26299":51684,"_2667":51956},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3171":2154,"_27803":2044,"_19261":51958,"_5":13244,"_26299":51684,"_2667":51959},[],"**Common Name (CN)**: main name of the identity.",{"_3171":2155,"_27803":2044,"_19261":51961,"_5":13244,"_26299":51684,"_2667":51962},[],"**Organization (O)**: organization or company.",{"_3171":2156,"_27803":2044,"_19261":51964,"_5":13244,"_26299":51684,"_2667":51965},[],"**Organizational Unit (OU)**: department or unit.",{"_3171":2157,"_27803":2044,"_19261":51967,"_5":13244,"_26299":51684,"_2667":51968},[],"**Country (C)**: two-letter country code.",{"_3171":2158,"_27803":2044,"_19261":51970,"_5":13244,"_26299":51684,"_2667":51971},[],"**State / Province (ST)**: state or province.",{"_3171":2159,"_27803":2044,"_19261":51973,"_5":13244,"_26299":51684,"_2667":51974},[],"**Locality (L)**: city or locality.",{"_3171":2160,"_27803":2044,"_19261":51976,"_5":13244,"_26299":51684,"_2667":51977},[],"**Email Address**: contact email.",{"_3171":2161,"_27803":2044,"_19261":51979,"_5":13244,"_26299":51684,"_2667":51980},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3171":2162,"_27803":2044,"_19261":51982,"_5":13244,"_26299":51684,"_2667":51983},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3171":2163,"_27803":2044,"_19261":51985,"_5":13244,"_26299":51688,"_2667":51986},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3171":2164,"_27803":2044,"_19261":51988,"_5":13244,"_26299":51688,"_2667":51989},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3171":2165,"_27803":2044,"_19261":51991,"_5":13244,"_26299":51692,"_2667":51992},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3171":2166,"_27803":2044,"_19261":51994,"_5":13244,"_26299":51692,"_2667":51995},[],"Note that the KMS refuses to delete a key that certificates still reference. The reference is released when the CA that owns those certificates is deleted; alternatively, you can keep the key deliberately.",{"_3171":2167,"_27803":2167,"_5":13570,"_2667":51997,"_28145":51998,"_19261":51999,"_26299":2167},"Online validation with OCSP",[45221,46601,50297,50917],[],{"_3171":2168,"_27803":2167,"_19261":52001,"_5":13244,"_26299":2167,"_2667":52002},[],"Query signed status and verify the responder’s response.",{"_3171":2169,"_27803":2167,"_5":28142,"_19261":52004,"_26299":52005,"_2667":52006},[],"/docs/pr-preview/pr-52/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3171":2170,"_27803":2167,"_5":28142,"_19261":52008,"_26299":52009,"_2667":52010},[],"/docs/pr-preview/pr-52/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3171":2171,"_27803":2167,"_5":28142,"_19261":52012,"_26299":52013,"_2667":52014},[],"/docs/pr-preview/pr-52/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3171":2172,"_27803":2167,"_5":28142,"_19261":52016,"_26299":52017,"_2667":52018},[],"/docs/pr-preview/pr-52/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3171":2173,"_27803":2167,"_5":28142,"_19261":52020,"_26299":52021,"_2667":52022},[],"/docs/pr-preview/pr-52/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3171":2174,"_27803":2167,"_5":28142,"_19261":52024,"_26299":52025,"_2667":51463},[],"/docs/pr-preview/pr-52/platform/pki/ocsp#references",{"_3171":2175,"_27803":2167,"_19261":52027,"_5":13244,"_26299":2167,"_2667":52028},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3171":2176,"_27803":2167,"_19261":52030,"_5":13244,"_26299":52005,"_2667":52031},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3171":2177,"_27803":2167,"_19261":52033,"_5":13244,"_26299":52005,"_2667":52034},[],"Record status",{"_3171":2178,"_27803":2167,"_19261":52036,"_5":13244,"_26299":52005,"_2667":52037},[],"Signed response",{"_3171":2179,"_27803":2167,"_19261":52039,"_5":13244,"_26299":52005,"_2667":49475},[],{"_3171":2180,"_27803":2167,"_19261":52041,"_5":13244,"_26299":52005,"_2667":52042},[],"`Good`.",{"_3171":2181,"_27803":2167,"_19261":52044,"_5":13244,"_26299":52005,"_2667":49492},[],{"_3171":2182,"_27803":2167,"_19261":52046,"_5":13244,"_26299":52005,"_2667":52047},[],"`Revoked`, with revocation reason and timestamp.",{"_3171":2183,"_27803":2167,"_19261":52049,"_5":13244,"_26299":52005,"_2667":52050},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3171":2184,"_27803":2167,"_19261":52052,"_5":13244,"_26299":52005,"_2667":52053},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3171":2185,"_27803":2167,"_19261":52055,"_5":13244,"_26299":52005,"_2667":52056},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3171":2186,"_27803":2167,"_19261":52058,"_5":13244,"_26299":52005,"_2667":52059},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3171":2187,"_27803":2167,"_19261":52061,"_5":13244,"_26299":52005,"_2667":52062},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3171":2188,"_27803":2167,"_19261":52064,"_5":13244,"_26299":52009,"_2667":52065},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3171":2189,"_27803":2167,"_19261":52067,"_5":13244,"_26299":52009,"_2667":52068},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3171":2190,"_27803":2167,"_19261":52070,"_5":13244,"_26299":52013,"_2667":52071},[],"The service accepts:",{"_3171":2191,"_27803":2167,"_19261":52073,"_5":13244,"_26299":52013,"_2667":48328},[],{"_3171":2192,"_27803":2167,"_19261":52075,"_5":13244,"_26299":52013,"_2667":52076},[],"VA service path",{"_3171":2193,"_27803":2167,"_19261":52078,"_5":13244,"_26299":52013,"_2667":52079},[],"Format",{"_3171":2194,"_27803":2167,"_19261":52081,"_5":13244,"_26299":52013,"_2667":52082},[],"`POST`",{"_3171":2195,"_27803":2167,"_19261":52084,"_5":13244,"_26299":52013,"_2667":52085},[],"`/ocsp`",{"_3171":2196,"_27803":2167,"_19261":52087,"_5":13244,"_26299":52013,"_2667":52088},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3171":2197,"_27803":2167,"_19261":52090,"_5":13244,"_26299":52013,"_2667":51565},[],{"_3171":2198,"_27803":2167,"_19261":52092,"_5":13244,"_26299":52013,"_2667":52093},[],"`/ocsp/{ocsp_request}`",{"_3171":2199,"_27803":2167,"_19261":52095,"_5":13244,"_26299":52013,"_2667":52096},[],"DER request encoded using padded URL Base64.",{"_3171":2200,"_27803":2167,"_19261":52098,"_5":13244,"_26299":52013,"_2667":52099},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3171":2201,"_27803":2167,"_19261":52101,"_5":13244,"_26299":52017,"_2667":52102},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3171":2202,"_27803":2167,"_19261":52104,"_5":13244,"_26299":52017,"_2667":52105},[],"Generate the request:",{"_3171":2203,"_27803":2167,"_19261":52107,"_5":13244,"_26299":52017,"_2667":52108},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3171":2204,"_27803":2167,"_19261":52110,"_5":13244,"_26299":52017,"_2667":52111},[],"Replace the example URL with the inspected endpoint:",{"_3171":2205,"_27803":2167,"_19261":52113,"_5":13244,"_26299":52017,"_2667":52114},[],"Verify the returned DER:",{"_3171":2206,"_27803":2167,"_19261":52116,"_5":13244,"_26299":52017,"_2667":52117},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3171":2207,"_27803":2167,"_19261":52119,"_5":13244,"_26299":52021,"_2667":52120},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3171":2208,"_27803":2167,"_19261":52122,"_5":13244,"_26299":52021,"_2667":52123},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3171":2209,"_27803":2167,"_19261":52125,"_5":13244,"_26299":52025,"_2667":52126},[],"RFC 6960: OCSP.",{"_3171":2210,"_27803":2167,"_19261":52128,"_5":13244,"_26299":52025,"_2667":52129},[],"OpenSSL: openssl-ocsp.",{"_3171":2211,"_27803":2167,"_19261":52131,"_5":13244,"_26299":52025,"_2667":52132},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3171":2212,"_27803":2167,"_19261":52134,"_5":13244,"_26299":52025,"_2667":51606},[],{"_3171":2213,"_27803":2213,"_5":13570,"_2667":50297,"_28145":52136,"_19261":52137,"_26299":2213},[45221,46601,50297],[],{"_3171":2214,"_27803":2213,"_19261":52139,"_5":13244,"_26299":2213,"_2667":52140},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3171":2215,"_27803":2213,"_5":28142,"_19261":52142,"_26299":52143,"_2667":49607},[],"/docs/pr-preview/pr-52/platform/pki/overview#start-here",{"_3171":2216,"_27803":2213,"_5":28142,"_19261":52145,"_26299":52146,"_2667":52147},[],"/docs/pr-preview/pr-52/platform/pki/overview#what-you-need","What you need",{"_3171":2217,"_27803":2213,"_5":28142,"_19261":52149,"_26299":52150,"_2667":50141},[],"/docs/pr-preview/pr-52/platform/pki/overview#core-capabilities",{"_3171":2218,"_27803":2213,"_5":28142,"_19261":52152,"_26299":52153,"_2667":50145},[],"/docs/pr-preview/pr-52/platform/pki/overview#build-your-trust-hierarchy",{"_3171":2219,"_27803":2213,"_5":28142,"_19261":52155,"_26299":52156,"_2667":50149},[],"/docs/pr-preview/pr-52/platform/pki/overview#protect-cryptographic-keys",{"_3171":2220,"_27803":2213,"_5":28142,"_19261":52158,"_26299":52159,"_2667":50153},[],"/docs/pr-preview/pr-52/platform/pki/overview#issue-and-control-certificates",{"_3171":2221,"_27803":2213,"_5":28142,"_19261":52161,"_26299":52162,"_2667":50161},[],"/docs/pr-preview/pr-52/platform/pki/overview#publish-validation-status",{"_3171":2222,"_27803":2213,"_5":28142,"_19261":52164,"_26299":52165,"_2667":52166},[],"/docs/pr-preview/pr-52/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3171":2223,"_27803":2213,"_5":28142,"_19261":52168,"_26299":52169,"_2667":51084},[],"/docs/pr-preview/pr-52/platform/pki/overview#continue",{"_3171":2224,"_27803":2213,"_19261":52171,"_5":13244,"_26299":2213,"_2667":52172},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3171":2225,"_27803":2213,"_19261":52174,"_5":13244,"_26299":52143,"_2667":52175},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3171":2226,"_27803":2213,"_19261":52177,"_5":13244,"_26299":52143,"_2667":52178},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3171":2227,"_27803":2213,"_19261":52180,"_5":13244,"_26299":52146,"_2667":52181},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3171":2228,"_27803":2213,"_19261":52183,"_5":13244,"_26299":52146,"_2667":52184},[],"An available cryptographic engine to keep the authority's key.",{"_3171":2229,"_27803":2213,"_19261":52186,"_5":13244,"_26299":52146,"_2667":52187},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3171":2230,"_27803":2213,"_19261":52189,"_5":13244,"_26299":52146,"_2667":52190},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3171":2231,"_27803":2213,"_19261":52192,"_5":13244,"_26299":52146,"_2667":52193},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3171":2232,"_27803":2213,"_19261":52195,"_5":13244,"_26299":52153,"_2667":52196},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3171":2233,"_27803":2213,"_19261":52198,"_5":13244,"_26299":52156,"_2667":52199},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3171":2234,"_27803":2213,"_19261":52201,"_5":13244,"_26299":52159,"_2667":52202},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3171":2235,"_27803":2213,"_19261":52204,"_5":13244,"_26299":52162,"_2667":52205},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3171":2236,"_27803":2213,"_19261":52207,"_5":13244,"_26299":52165,"_2667":52208},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3171":2237,"_27803":2213,"_19261":52210,"_5":13244,"_26299":52165,"_2667":52211},[],"its subject and extensions identify the expected client;",{"_3171":2238,"_27803":2213,"_19261":52213,"_5":13244,"_26299":52165,"_2667":52214},[],"its public key matches the client's private key;",{"_3171":2239,"_27803":2213,"_19261":52216,"_5":13244,"_26299":52165,"_2667":52217},[],"its chain reaches a root trusted by the consumer;",{"_3171":2240,"_27803":2213,"_19261":52219,"_5":13244,"_26299":52165,"_2667":52220},[],"its dates and usages allow the operation;",{"_3171":2241,"_27803":2213,"_19261":52222,"_5":13244,"_26299":52165,"_2667":52223},[],"the consumer applies revocation checks and authorization.",{"_3171":2242,"_27803":2213,"_19261":52225,"_5":13244,"_26299":52165,"_2667":52226},[],"The issuance path includes the first independent checks.",{"_3171":2243,"_27803":2213,"_19261":52228,"_5":13244,"_26299":52169,"_2667":52229},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3171":2244,"_27803":2213,"_19261":52231,"_5":13244,"_26299":52169,"_2667":52232},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3171":2245,"_27803":2213,"_19261":52234,"_5":13244,"_26299":52169,"_2667":52235},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3171":2246,"_27803":2246,"_5":13570,"_2667":52237,"_28145":52238,"_19261":52239,"_26299":2246},"Create your first CA",[45221,46601,50297,49732],[],{"_3171":2247,"_27803":2246,"_19261":52241,"_5":13244,"_26299":2246,"_2667":52242},[],"Create an evaluation root and check its certificate before issuing.",{"_3171":2248,"_27803":2246,"_5":28142,"_19261":52244,"_26299":52245,"_2667":45231},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3171":2249,"_27803":2246,"_5":28142,"_19261":52247,"_26299":52248,"_2667":52249},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_3171":2250,"_27803":2246,"_5":28142,"_19261":52251,"_26299":52252,"_2667":52253},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_3171":2251,"_27803":2246,"_5":28142,"_19261":52255,"_26299":52256,"_2667":52257},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_3171":2252,"_27803":2246,"_5":28142,"_19261":52259,"_26299":52260,"_2667":52261},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_3171":2253,"_27803":2246,"_5":28142,"_19261":52263,"_26299":52264,"_2667":52265},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_3171":2254,"_27803":2246,"_5":28142,"_19261":52267,"_26299":52268,"_2667":52269},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3171":2255,"_27803":2246,"_5":28142,"_19261":52271,"_26299":52272,"_2667":49990},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3171":2256,"_27803":2246,"_5":28142,"_19261":52274,"_26299":52275,"_2667":45255},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3171":2257,"_27803":2246,"_19261":52277,"_5":13244,"_26299":2246,"_2667":52278},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3171":2258,"_27803":2246,"_19261":52280,"_5":13244,"_26299":52245,"_2667":52281},[],"Console access and permission to create keys and authorities.",{"_3171":2259,"_27803":2246,"_19261":52283,"_5":13244,"_26299":52245,"_2667":52284},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3171":2260,"_27803":2246,"_19261":52286,"_5":13244,"_26299":52245,"_2667":52287},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3171":2261,"_27803":2246,"_19261":52289,"_5":13244,"_26299":52245,"_2667":52290},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3171":2262,"_27803":2246,"_19261":52292,"_5":13244,"_26299":52248,"_2667":52293},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3171":2263,"_27803":2246,"_19261":52295,"_5":13244,"_26299":52248,"_2667":52296},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3171":2264,"_27803":2246,"_19261":52298,"_5":13244,"_26299":52252,"_2667":52299},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3171":2265,"_27803":2246,"_19261":52301,"_5":13244,"_26299":52252,"_2667":52302},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3171":2266,"_27803":2246,"_19261":52304,"_5":13244,"_26299":52256,"_2667":52305},[],"Select **Root CA** and complete:",{"_3171":2267,"_27803":2246,"_19261":52307,"_5":13244,"_26299":52256,"_2667":52308},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3171":2268,"_27803":2246,"_19261":52310,"_5":13244,"_26299":52256,"_2667":52311},[],"**Subject**: organization and country details for your evaluation.",{"_3171":2269,"_27803":2246,"_19261":52313,"_5":13244,"_26299":52256,"_2667":52314},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3171":2270,"_27803":2246,"_19261":52316,"_5":13244,"_26299":52256,"_2667":52317},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3171":2271,"_27803":2246,"_19261":52319,"_5":13244,"_26299":52256,"_2667":52320},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3171":2272,"_27803":2246,"_19261":52322,"_5":13244,"_26299":52260,"_2667":52323},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3171":2273,"_27803":2246,"_19261":52325,"_5":13244,"_26299":52264,"_2667":52326},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3171":2274,"_27803":2246,"_19261":52328,"_5":13244,"_26299":52264,"_2667":52329},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3171":2275,"_27803":2246,"_19261":52331,"_5":13244,"_26299":52268,"_2667":52332},[],"Run from the directory where you saved `ca.pem`:",{"_3171":2276,"_27803":2246,"_19261":52334,"_5":13244,"_26299":52268,"_2667":52335},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3171":2277,"_27803":2246,"_19261":52337,"_5":13244,"_26299":52268,"_2667":52338},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3171":2278,"_27803":2246,"_19261":52340,"_5":13244,"_26299":52272,"_2667":52341},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3171":2279,"_27803":2246,"_19261":52343,"_5":13244,"_26299":52272,"_2667":52344},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3171":2280,"_27803":2246,"_19261":52346,"_5":13244,"_26299":52272,"_2667":52347},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3171":2281,"_27803":2246,"_19261":52349,"_5":13244,"_26299":52272,"_2667":52350},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3171":2282,"_27803":2246,"_19261":52352,"_5":13244,"_26299":52275,"_2667":52353},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3171":2283,"_27803":2283,"_5":13570,"_2667":52355,"_28145":52356,"_19261":52357,"_26299":2283},"Issue and verify a certificate",[45221,46601,50297,49732],[],{"_3171":2284,"_27803":2283,"_19261":52359,"_5":13244,"_26299":2283,"_2667":52360},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3171":2285,"_27803":2283,"_5":28142,"_19261":52362,"_26299":52363,"_2667":45231},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3171":2286,"_27803":2283,"_5":28142,"_19261":52365,"_26299":52366,"_2667":52367},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3171":2287,"_27803":2283,"_5":28142,"_19261":52369,"_26299":52370,"_2667":52371},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3171":2288,"_27803":2283,"_5":28142,"_19261":52373,"_26299":52374,"_2667":52375},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3171":2289,"_27803":2283,"_5":28142,"_19261":52377,"_26299":52378,"_2667":52379},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3171":2290,"_27803":2283,"_5":28142,"_19261":52381,"_26299":52382,"_2667":52383},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3171":2291,"_27803":2283,"_5":28142,"_19261":52385,"_26299":52386,"_2667":52265},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_3171":2292,"_27803":2283,"_5":28142,"_19261":52388,"_26299":52389,"_2667":52390},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3171":2293,"_27803":2283,"_5":28142,"_19261":52392,"_26299":52393,"_2667":52394},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3171":2294,"_27803":2283,"_5":28142,"_19261":52396,"_26299":52397,"_2667":52398},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3171":2295,"_27803":2283,"_5":28142,"_19261":52400,"_26299":52401,"_2667":49990},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3171":2296,"_27803":2283,"_5":28142,"_19261":52403,"_26299":52404,"_2667":45255},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#next-step",{"_3171":2297,"_27803":2283,"_19261":52406,"_5":13244,"_26299":2283,"_2667":52407},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3171":2298,"_27803":2283,"_19261":52409,"_5":13244,"_26299":52363,"_2667":52410},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3171":2299,"_27803":2283,"_19261":52412,"_5":13244,"_26299":52363,"_2667":52413},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3171":2300,"_27803":2283,"_19261":52415,"_5":13244,"_26299":52363,"_2667":52416},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3171":2301,"_27803":2283,"_19261":52418,"_5":13244,"_26299":52363,"_2667":52419},[],"A client identifier: here we use `device-001`.",{"_3171":2302,"_27803":2283,"_19261":52421,"_5":13244,"_26299":52363,"_2667":52422},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3171":2303,"_27803":2283,"_19261":52424,"_5":13244,"_26299":52366,"_2667":52425},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3171":2304,"_27803":2283,"_19261":52427,"_5":13244,"_26299":52370,"_2667":52428},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3171":2305,"_27803":2283,"_19261":52430,"_5":13244,"_26299":52370,"_2667":52431},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3171":2306,"_27803":2283,"_19261":52433,"_5":13244,"_26299":52374,"_2667":52434},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3171":2307,"_27803":2283,"_19261":52436,"_5":13244,"_26299":52374,"_2667":52437},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3171":2308,"_27803":2283,"_19261":52439,"_5":13244,"_26299":52378,"_2667":52440},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3171":2309,"_27803":2283,"_19261":52442,"_5":13244,"_26299":52378,"_2667":52443},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3171":2310,"_27803":2283,"_19261":52445,"_5":13244,"_26299":52382,"_2667":52446},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3171":2311,"_27803":2283,"_19261":52448,"_5":13244,"_26299":52386,"_2667":52449},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3171":2312,"_27803":2283,"_19261":52451,"_5":13244,"_26299":52389,"_2667":52452},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3171":2313,"_27803":2283,"_19261":52454,"_5":13244,"_26299":52393,"_2667":52455},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3171":2314,"_27803":2283,"_19261":52457,"_5":13244,"_26299":52393,"_2667":52458},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3171":2315,"_27803":2283,"_19261":52460,"_5":13244,"_26299":52393,"_2667":52461},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3171":2316,"_27803":2283,"_19261":52463,"_5":13244,"_26299":52397,"_2667":52464},[],"In Bash, compare the two public-key digests:",{"_3171":2317,"_27803":2283,"_19261":52466,"_5":13244,"_26299":52397,"_2667":52467},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3171":2318,"_27803":2283,"_19261":52469,"_5":13244,"_26299":52397,"_2667":52470},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3171":2319,"_27803":2283,"_19261":52472,"_5":13244,"_26299":52401,"_2667":50074},[],{"_3171":2320,"_27803":2283,"_19261":52474,"_5":13244,"_26299":52401,"_2667":52475},[],"What to review",{"_3171":2321,"_27803":2283,"_19261":52477,"_5":13244,"_26299":52401,"_2667":52478},[],"The CA rejects issuance",{"_3171":2322,"_27803":2283,"_19261":52480,"_5":13244,"_26299":52401,"_2667":52481},[],"Permissions, CA state and key, algorithm and profile.",{"_3171":2323,"_27803":2283,"_19261":52483,"_5":13244,"_26299":52401,"_2667":52484},[],"Different subject or usages",{"_3171":2324,"_27803":2283,"_19261":52486,"_5":13244,"_26299":52401,"_2667":52487},[],"Applied profile and requested values.",{"_3171":2325,"_27803":2283,"_19261":52489,"_5":13244,"_26299":52401,"_2667":52490},[],"Issuer cannot be found",{"_3171":2326,"_27803":2283,"_19261":52492,"_5":13244,"_26299":52401,"_2667":52493},[],"Downloaded CA and required intermediate chain.",{"_3171":2327,"_27803":2283,"_19261":52495,"_5":13244,"_26299":52401,"_2667":52496},[],"Validity fails",{"_3171":2328,"_27803":2283,"_19261":52498,"_5":13244,"_26299":52401,"_2667":52499},[],"Certificate and CA dates, and the computer's clock.",{"_3171":2329,"_27803":2283,"_19261":52501,"_5":13244,"_26299":52401,"_2667":52502},[],"Public-key digests differ",{"_3171":2330,"_27803":2283,"_19261":52504,"_5":13244,"_26299":52401,"_2667":52505},[],"Certificate and key files from the same issuance.",{"_3171":2331,"_27803":2283,"_19261":52507,"_5":13244,"_26299":52401,"_2667":52508},[],"See PKI diagnostics to narrow an issuance failure.",{"_3171":2332,"_27803":2283,"_19261":52510,"_5":13244,"_26299":52404,"_2667":52511},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3171":2333,"_27803":2283,"_19261":52513,"_5":13244,"_26299":52404,"_2667":52514},[],"Manage certificates for inspection, status and revocation.",{"_3171":2334,"_27803":2283,"_19261":52516,"_5":13244,"_26299":52404,"_2667":52517},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3171":2335,"_27803":2283,"_19261":52519,"_5":13244,"_26299":52404,"_2667":52520},[],"Prepare EST for the device to request its next identities.",{"_3171":2336,"_27803":2283,"_19261":52522,"_5":13244,"_26299":52404,"_2667":52523},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3171":2337,"_27803":2337,"_5":13570,"_2667":52525,"_28145":52526,"_19261":52527,"_26299":2337},"PKI getting started",[45221,46601,50297,49732],[],{"_3171":2338,"_27803":2337,"_19261":52529,"_5":13244,"_26299":2337,"_2667":52530},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3171":2339,"_27803":2337,"_5":28142,"_19261":52532,"_26299":52533,"_2667":45231},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/overview#before-you-begin",{"_3171":2340,"_27803":2337,"_5":28142,"_19261":52535,"_26299":52536,"_2667":52537},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3171":2341,"_27803":2337,"_5":28142,"_19261":52539,"_26299":52540,"_2667":49924},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/overview#expected-result",{"_3171":2342,"_27803":2337,"_5":28142,"_19261":52542,"_26299":52543,"_2667":52544},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3171":2343,"_27803":2337,"_19261":52546,"_5":13244,"_26299":2337,"_2667":52547},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3171":2344,"_27803":2337,"_19261":52549,"_5":13244,"_26299":52533,"_2667":52550},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3171":2345,"_27803":2337,"_19261":52552,"_5":13244,"_26299":52533,"_2667":52553},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3171":2346,"_27803":2337,"_19261":52555,"_5":13244,"_26299":52533,"_2667":52556},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3171":2347,"_27803":2337,"_19261":52558,"_5":13244,"_26299":52533,"_2667":52559},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3171":2348,"_27803":2337,"_19261":52561,"_5":13244,"_26299":52533,"_2667":52562},[],"A working directory with restricted access for the downloaded key.",{"_3171":2349,"_27803":2337,"_19261":52564,"_5":13244,"_26299":52536,"_2667":52565},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3171":2350,"_27803":2337,"_19261":52567,"_5":13244,"_26299":52536,"_2667":52568},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3171":2351,"_27803":2337,"_19261":52570,"_5":13244,"_26299":52536,"_2667":52571},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3171":2352,"_27803":2337,"_19261":52573,"_5":13244,"_26299":52536,"_2667":52574},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3171":2353,"_27803":2337,"_19261":52576,"_5":13244,"_26299":52540,"_2667":52577},[],"File or resource",{"_3171":2354,"_27803":2337,"_19261":52579,"_5":13244,"_26299":52540,"_2667":49921},[],{"_3171":2355,"_27803":2337,"_19261":52581,"_5":13244,"_26299":52540,"_2667":52582},[],"Active root CA and `ca.pem`",{"_3171":2356,"_27803":2337,"_19261":52584,"_5":13244,"_26299":52540,"_2667":52585},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3171":2357,"_27803":2337,"_19261":52587,"_5":13244,"_26299":52540,"_2667":52588},[],"End-entity certificate and `device.crt`",{"_3171":2358,"_27803":2337,"_19261":52590,"_5":13244,"_26299":52540,"_2667":52591},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3171":2359,"_27803":2337,"_19261":52593,"_5":13244,"_26299":52540,"_2667":52594},[],"Private key `device.key`",{"_3171":2360,"_27803":2337,"_19261":52596,"_5":13244,"_26299":52540,"_2667":52597},[],"Its public key matches the one included in `device.crt`.",{"_3171":2361,"_27803":2337,"_19261":52599,"_5":13244,"_26299":52540,"_2667":52600},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3171":2362,"_27803":2337,"_19261":52602,"_5":13244,"_26299":52543,"_2667":52603},[],"To operate certificates, continue with Certificates and Validation.",{"_3171":2363,"_27803":2337,"_19261":52605,"_5":13244,"_26299":52543,"_2667":52606},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3171":2364,"_27803":2337,"_19261":52608,"_5":13244,"_26299":52543,"_2667":52609},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3171":2365,"_27803":2365,"_5":13570,"_2667":52611,"_28145":52612,"_19261":52613,"_26299":2365},"PKI troubleshooting",[45221,46601,50297,49118],[],{"_3171":2366,"_27803":2365,"_19261":52615,"_5":13244,"_26299":2365,"_2667":52616},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3171":2367,"_27803":2365,"_5":28142,"_19261":52618,"_26299":52619,"_2667":52620},[],"/docs/pr-preview/pr-52/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3171":2368,"_27803":2365,"_5":28142,"_19261":52622,"_26299":52623,"_2667":52624},[],"/docs/pr-preview/pr-52/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3171":2369,"_27803":2365,"_5":28142,"_19261":52626,"_26299":52627,"_2667":52628},[],"/docs/pr-preview/pr-52/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3171":2370,"_27803":2365,"_19261":52630,"_5":13244,"_26299":2365,"_2667":52631},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3171":2371,"_27803":2365,"_19261":52633,"_5":13244,"_26299":2365,"_2667":52634},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3171":2372,"_27803":2365,"_19261":52636,"_5":13244,"_26299":52619,"_2667":49921},[],{"_3171":2373,"_27803":2365,"_19261":52638,"_5":13244,"_26299":52619,"_2667":52639},[],"What to inspect",{"_3171":2374,"_27803":2365,"_19261":52641,"_5":13244,"_26299":52619,"_2667":45255},[],{"_3171":2375,"_27803":2365,"_19261":52643,"_5":13244,"_26299":52619,"_2667":52644},[],"CA",{"_3171":2376,"_27803":2365,"_19261":52646,"_5":13244,"_26299":52619,"_2667":52647},[],"Exists, is active and has usable dates.",{"_3171":2377,"_27803":2365,"_19261":52649,"_5":13244,"_26299":52619,"_2667":52650},[],"Authorities.",{"_3171":2378,"_27803":2365,"_19261":52652,"_5":13244,"_26299":52619,"_2667":52653},[],"Key",{"_3171":2379,"_27803":2365,"_19261":52655,"_5":13244,"_26299":52619,"_2667":52656},[],"The record has a usable private key and the engine can sign.",{"_3171":2380,"_27803":2365,"_19261":52658,"_5":13244,"_26299":52619,"_2667":52659},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3171":2381,"_27803":2365,"_19261":52661,"_5":13244,"_26299":52619,"_2667":52662},[],"CSR",{"_3171":2382,"_27803":2365,"_19261":52664,"_5":13244,"_26299":52619,"_2667":52665},[],"Correct PEM and verifiable signature.",{"_3171":2383,"_27803":2365,"_19261":52667,"_5":13244,"_26299":52619,"_2667":52668},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3171":2384,"_27803":2365,"_19261":52670,"_5":13244,"_26299":52619,"_2667":52671},[],"Profile",{"_3171":2385,"_27803":2365,"_19261":52673,"_5":13244,"_26299":52619,"_2667":52674},[],"Selected source, existing ID, allowed algorithm and size.",{"_3171":2386,"_27803":2365,"_19261":52676,"_5":13244,"_26299":52619,"_2667":52677},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3171":2387,"_27803":2365,"_19261":52679,"_5":13244,"_26299":52619,"_2667":50074},[],{"_3171":2388,"_27803":2365,"_19261":52681,"_5":13244,"_26299":52619,"_2667":52682},[],"Appropriate subject, SAN, usages and dates.",{"_3171":2389,"_27803":2365,"_19261":52684,"_5":13244,"_26299":52619,"_2667":52685},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3171":2390,"_27803":2365,"_19261":52687,"_5":13244,"_26299":52619,"_2667":52688},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3171":2391,"_27803":2365,"_19261":52690,"_5":13244,"_26299":52619,"_2667":52691},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3171":2392,"_27803":2365,"_19261":52693,"_5":13244,"_26299":52623,"_2667":52694},[],"Check each boundary independently:",{"_3171":2393,"_27803":2365,"_19261":52696,"_5":13244,"_26299":52623,"_2667":52697},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3171":2394,"_27803":2365,"_19261":52699,"_5":13244,"_26299":52623,"_2667":52700},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3171":2395,"_27803":2365,"_19261":52702,"_5":13244,"_26299":52623,"_2667":52703},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3171":2396,"_27803":2365,"_19261":52705,"_5":13244,"_26299":52623,"_2667":52706},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3171":2397,"_27803":2365,"_19261":52708,"_5":13244,"_26299":52623,"_2667":52709},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3171":2398,"_27803":2365,"_19261":52711,"_5":13244,"_26299":52623,"_2667":52712},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3171":2399,"_27803":2365,"_19261":52714,"_5":13244,"_26299":52627,"_2667":52715},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3171":2400,"_27803":2365,"_19261":52717,"_5":13244,"_26299":52627,"_2667":52718},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3171":2401,"_27803":2401,"_5":13570,"_2667":52720,"_28145":52721,"_19261":52723,"_26299":2401},"3.8.0 to 4.0.0",[45221,52722],"Upgrades",[],{"_3171":2402,"_27803":2401,"_19261":52725,"_5":13244,"_26299":2401,"_2667":52726},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3171":2403,"_27803":2401,"_5":28142,"_19261":52728,"_26299":52729,"_2667":52730},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3171":2404,"_27803":2401,"_5":28142,"_19261":52732,"_26299":52733,"_2667":52734},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3171":2405,"_27803":2401,"_5":28142,"_19261":52736,"_26299":52737,"_2667":52738},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3171":2406,"_27803":2401,"_5":28142,"_19261":52740,"_26299":52741,"_2667":52742},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3171":2407,"_27803":2401,"_5":28142,"_19261":52744,"_26299":52745,"_2667":52746},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3171":2408,"_27803":2401,"_5":28142,"_19261":52748,"_26299":52749,"_2667":52750},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3171":2409,"_27803":2401,"_5":28142,"_19261":52752,"_26299":52753,"_2667":52754},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3171":2410,"_27803":2401,"_5":28142,"_19261":52756,"_26299":52757,"_2667":52758},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3171":2411,"_27803":2401,"_5":28142,"_19261":52760,"_26299":52761,"_2667":52762},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3171":2412,"_27803":2401,"_5":28142,"_19261":52764,"_26299":52765,"_2667":52766},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3171":2413,"_27803":2401,"_5":28142,"_19261":52768,"_26299":52769,"_2667":52770},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3171":2414,"_27803":2401,"_5":28142,"_19261":52772,"_26299":52773,"_2667":52774},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3171":2415,"_27803":2401,"_5":28142,"_19261":52776,"_26299":52777,"_2667":52778},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3171":2416,"_27803":2401,"_5":28142,"_19261":52780,"_26299":52781,"_2667":52782},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3171":2417,"_27803":2401,"_5":28142,"_19261":52784,"_26299":52785,"_2667":52786},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3171":2418,"_27803":2401,"_5":28142,"_19261":52788,"_26299":52789,"_2667":52790},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3171":2419,"_27803":2401,"_5":28142,"_19261":52792,"_26299":52793,"_2667":52794},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3171":2420,"_27803":2401,"_5":28142,"_19261":52796,"_26299":52797,"_2667":52798},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3171":2421,"_27803":2401,"_5":28142,"_19261":52800,"_26299":52801,"_2667":52802},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3171":2422,"_27803":2401,"_5":28142,"_19261":52804,"_26299":52805,"_2667":52806},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-va-roles","References between certificates, keys and VA roles",{"_3171":2423,"_27803":2401,"_5":28142,"_19261":52808,"_26299":52809,"_2667":52810},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3171":2424,"_27803":2401,"_5":28142,"_19261":52812,"_26299":52813,"_2667":52814},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3171":2425,"_27803":2401,"_5":28142,"_19261":52816,"_26299":52817,"_2667":52818},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3171":2426,"_27803":2401,"_5":28142,"_19261":52820,"_26299":52821,"_2667":52822},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3171":2427,"_27803":2401,"_5":28142,"_19261":52824,"_26299":52825,"_2667":52826},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3171":2428,"_27803":2401,"_5":28142,"_19261":52828,"_26299":52829,"_2667":52830},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3171":2429,"_27803":2401,"_5":28142,"_19261":52832,"_26299":52833,"_2667":52834},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3171":2430,"_27803":2401,"_5":28142,"_19261":52836,"_26299":52837,"_2667":52838},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#va-role-signer-field","VA role signer field",{"_3171":2431,"_27803":2401,"_5":28142,"_19261":52840,"_26299":52841,"_2667":52842},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3171":2432,"_27803":2401,"_5":28142,"_19261":52844,"_26299":52845,"_2667":52846},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3171":2433,"_27803":2401,"_5":28142,"_19261":52848,"_26299":52849,"_2667":52850},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3171":2434,"_27803":2401,"_5":28142,"_19261":52852,"_26299":52853,"_2667":52854},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3171":2435,"_27803":2401,"_5":28142,"_19261":52856,"_26299":52857,"_2667":52858},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3171":2436,"_27803":2401,"_5":28142,"_19261":52860,"_26299":52861,"_2667":52862},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3171":2437,"_27803":2401,"_5":28142,"_19261":52864,"_26299":52865,"_2667":52866},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3171":2438,"_27803":2401,"_5":28142,"_19261":52868,"_26299":52869,"_2667":49118},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3171":2439,"_27803":2401,"_5":28142,"_19261":52871,"_26299":52872,"_2667":52873},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3171":2440,"_27803":2401,"_5":28142,"_19261":52875,"_26299":52876,"_2667":52877},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3171":2441,"_27803":2401,"_19261":52879,"_5":13244,"_26299":2401,"_2667":52880},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3171":2442,"_27803":2401,"_19261":52882,"_5":13244,"_26299":2401,"_2667":52883},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3171":2443,"_27803":2401,"_19261":52885,"_5":13244,"_26299":2401,"_2667":52886},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3171":2444,"_27803":2401,"_19261":52888,"_5":13244,"_26299":2401,"_2667":52889},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3171":2445,"_27803":2401,"_19261":52891,"_5":13244,"_26299":2401,"_2667":52892},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3171":2446,"_27803":2401,"_19261":52894,"_5":13244,"_26299":2401,"_2667":52895},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3171":2447,"_27803":2401,"_19261":52897,"_5":13244,"_26299":2401,"_2667":52898},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3171":2448,"_27803":2401,"_19261":52900,"_5":13244,"_26299":52733,"_2667":52901},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3171":2449,"_27803":2401,"_19261":52903,"_5":13244,"_26299":52733,"_2667":52904},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3171":2450,"_27803":2401,"_19261":52906,"_5":13244,"_26299":52737,"_2667":52907},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3171":2451,"_27803":2401,"_19261":52909,"_5":13244,"_26299":52737,"_2667":52910},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3171":2452,"_27803":2401,"_19261":52912,"_5":13244,"_26299":52741,"_2667":52913},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3171":2453,"_27803":2401,"_19261":52915,"_5":13244,"_26299":52745,"_2667":52916},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3171":2454,"_27803":2401,"_19261":52918,"_5":13244,"_26299":52745,"_2667":52919},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3171":2455,"_27803":2401,"_19261":52921,"_5":13244,"_26299":52745,"_2667":52922},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3171":2456,"_27803":2401,"_19261":52924,"_5":13244,"_26299":52745,"_2667":52925},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3171":2457,"_27803":2401,"_19261":52927,"_5":13244,"_26299":52745,"_2667":52928},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3171":2458,"_27803":2401,"_19261":52930,"_5":13244,"_26299":52749,"_2667":52931},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3171":2459,"_27803":2401,"_19261":52933,"_5":13244,"_26299":52749,"_2667":52934},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3171":2460,"_27803":2401,"_19261":52936,"_5":13244,"_26299":52749,"_2667":52937},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3171":2461,"_27803":2401,"_19261":52939,"_5":13244,"_26299":52749,"_2667":52940},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3171":2462,"_27803":2401,"_19261":52942,"_5":13244,"_26299":52749,"_2667":52943},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3171":2463,"_27803":2401,"_19261":52945,"_5":13244,"_26299":52753,"_2667":52946},[],"Change",{"_3171":2464,"_27803":2401,"_19261":52948,"_5":13244,"_26299":52753,"_2667":52949},[],"Who is affected",{"_3171":2465,"_27803":2401,"_19261":52951,"_5":13244,"_26299":52753,"_2667":52952},[],"Severity",{"_3171":2466,"_27803":2401,"_19261":52954,"_5":13244,"_26299":52753,"_2667":52955},[],"Action",{"_3171":2467,"_27803":2401,"_19261":52957,"_5":13244,"_26299":52753,"_2667":52762},[],{"_3171":2468,"_27803":2401,"_19261":52959,"_5":13244,"_26299":52753,"_2667":52960},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3171":2469,"_27803":2401,"_19261":52962,"_5":13244,"_26299":52753,"_2667":52963},[],"High: KMS and VA start on empty volumes",{"_3171":2470,"_27803":2401,"_19261":52965,"_5":13244,"_26299":52753,"_2667":52966},[],"Copy the data into the new volumes",{"_3171":2471,"_27803":2401,"_19261":52968,"_5":13244,"_26299":52753,"_2667":52766},[],{"_3171":2472,"_27803":2401,"_19261":52970,"_5":13244,"_26299":52753,"_2667":52971},[],"Every Helm release",{"_3171":2473,"_27803":2401,"_19261":52973,"_5":13244,"_26299":52753,"_2667":52974},[],"High: `helm upgrade` fails",{"_3171":2474,"_27803":2401,"_19261":52976,"_5":13244,"_26299":52753,"_2667":52977},[],"Remove or rename legacy keys",{"_3171":2475,"_27803":2401,"_19261":52979,"_5":13244,"_26299":52753,"_2667":52770},[],{"_3171":2476,"_27803":2401,"_19261":52981,"_5":13244,"_26299":52753,"_2667":52982},[],"Every deployment",{"_3171":2477,"_27803":2401,"_19261":52984,"_5":13244,"_26299":52753,"_2667":52985},[],"High: without a bootstrap principal there is no administrator",{"_3171":2478,"_27803":2401,"_19261":52987,"_5":13244,"_26299":52753,"_2667":52988},[],"Configure `services.authz`",{"_3171":2479,"_27803":2401,"_19261":52990,"_5":13244,"_26299":52753,"_2667":52774},[],{"_3171":2480,"_27803":2401,"_19261":52992,"_5":13244,"_26299":52753,"_2667":52971},[],{"_3171":2481,"_27803":2401,"_19261":52994,"_5":13244,"_26299":52753,"_2667":52995},[],"High: `helm upgrade` fails on the old keys",{"_3171":2482,"_27803":2401,"_19261":52997,"_5":13244,"_26299":52753,"_2667":52998},[],"Move JWKS and roles into `services.authz`",{"_3171":2483,"_27803":2401,"_19261":53000,"_5":13244,"_26299":52753,"_2667":52794},[],{"_3171":2484,"_27803":2401,"_19261":53002,"_5":13244,"_26299":52753,"_2667":53003},[],"3.8.0 deployments with per-service databases",{"_3171":2485,"_27803":2401,"_19261":53005,"_5":13244,"_26299":52753,"_2667":53006},[],"High: services find no data, or a migration aborts",{"_3171":2486,"_27803":2401,"_19261":53008,"_5":13244,"_26299":52753,"_2667":53009},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3171":2487,"_27803":2401,"_19261":53011,"_5":13244,"_26299":52753,"_2667":52798},[],{"_3171":2488,"_27803":2401,"_19261":53013,"_5":13244,"_26299":52753,"_2667":53014},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3171":2489,"_27803":2401,"_19261":53016,"_5":13244,"_26299":52753,"_2667":53017},[],"High: the backend no longer starts with them",{"_3171":2490,"_27803":2401,"_19261":53019,"_5":13244,"_26299":52753,"_2667":53020},[],"Move to PostgreSQL before upgrading",{"_3171":2491,"_27803":2401,"_19261":53022,"_5":13244,"_26299":52753,"_2667":53023},[],"Webhooks with file references",{"_3171":2492,"_27803":2401,"_19261":53025,"_5":13244,"_26299":52753,"_2667":53026},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3171":2493,"_27803":2401,"_19261":53028,"_5":13244,"_26299":52753,"_2667":53029},[],"High: enrollments calling the webhook fail",{"_3171":2494,"_27803":2401,"_19261":53031,"_5":13244,"_26299":52753,"_2667":53032},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3171":2495,"_27803":2401,"_19261":53034,"_5":13244,"_26299":52753,"_2667":52778},[],{"_3171":2496,"_27803":2401,"_19261":53036,"_5":13244,"_26299":52753,"_2667":53037},[],"Releases with per-service identity overrides or mounted key material",{"_3171":2497,"_27803":2401,"_19261":53039,"_5":13244,"_26299":52753,"_2667":53040},[],"Medium: services cannot read their files",{"_3171":2498,"_27803":2401,"_19261":53042,"_5":13244,"_26299":52753,"_2667":53043},[],"Remove the overrides and fix volume ownership",{"_3171":2499,"_27803":2401,"_19261":53045,"_5":13244,"_26299":52753,"_2667":52782},[],{"_3171":2500,"_27803":2401,"_19261":53047,"_5":13244,"_26299":52753,"_2667":53048},[],"Releases that set `amqp.tls`",{"_3171":2501,"_27803":2401,"_19261":53050,"_5":13244,"_26299":52753,"_2667":53051},[],"Medium: clients connect to the wrong port",{"_3171":2502,"_27803":2401,"_19261":53053,"_5":13244,"_26299":52753,"_2667":53054},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3171":2503,"_27803":2401,"_19261":53056,"_5":13244,"_26299":52753,"_2667":52802},[],{"_3171":2504,"_27803":2401,"_19261":53058,"_5":13244,"_26299":52753,"_2667":53059},[],"Installations whose CA keys predate the KMS",{"_3171":2505,"_27803":2401,"_19261":53061,"_5":13244,"_26299":52753,"_2667":53062},[],"Medium: CA keys stay unmanaged",{"_3171":2506,"_27803":2401,"_19261":53064,"_5":13244,"_26299":52753,"_2667":53065},[],"Run the CA-to-KMS migration",{"_3171":2507,"_27803":2401,"_19261":53067,"_5":13244,"_26299":52753,"_2667":53068},[],"Receiver certificate verification",{"_3171":2508,"_27803":2401,"_19261":53070,"_5":13244,"_26299":52753,"_2667":53071},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3171":2509,"_27803":2401,"_19261":53073,"_5":13244,"_26299":52753,"_2667":53074},[],"Medium: credentials go to an unverified receiver",{"_3171":2510,"_27803":2401,"_19261":53076,"_5":13244,"_26299":52753,"_2667":53077},[],"Set `insecure_skip_verify` to `false`",{"_3171":2511,"_27803":2401,"_19261":53079,"_5":13244,"_26299":52753,"_2667":52818},[],{"_3171":2512,"_27803":2401,"_19261":53081,"_5":13244,"_26299":52753,"_2667":53082},[],"Scripts and consoles that edit DMSs through the API",{"_3171":2513,"_27803":2401,"_19261":53084,"_5":13244,"_26299":52753,"_2667":53085},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3171":2514,"_27803":2401,"_19261":53087,"_5":13244,"_26299":52753,"_2667":53088},[],"Read the DMS before editing and use the new field",{"_3171":2515,"_27803":2401,"_19261":53090,"_5":13244,"_26299":52753,"_2667":52838},[],{"_3171":2516,"_27803":2401,"_19261":53092,"_5":13244,"_26299":52753,"_2667":53093},[],"Clients that create or update VA roles through the API",{"_3171":2517,"_27803":2401,"_19261":53095,"_5":13244,"_26299":52753,"_2667":53096},[],"Medium: requests with the old field return an error",{"_3171":2518,"_27803":2401,"_19261":53098,"_5":13244,"_26299":52753,"_2667":53099},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_certificate_serial_number`",{"_3171":2519,"_27803":2401,"_19261":53101,"_5":13244,"_26299":52753,"_2667":52834},[],{"_3171":2520,"_27803":2401,"_19261":53103,"_5":13244,"_26299":52753,"_2667":53104},[],"Consumers that read the device `events` field",{"_3171":2521,"_27803":2401,"_19261":53106,"_5":13244,"_26299":52753,"_2667":53107},[],"Medium: the field disappears",{"_3171":2522,"_27803":2401,"_19261":53109,"_5":13244,"_26299":52753,"_2667":53110},[],"Use the new event endpoints",{"_3171":2523,"_27803":2401,"_19261":53112,"_5":13244,"_26299":52753,"_2667":52786},[],{"_3171":2524,"_27803":2401,"_19261":53114,"_5":13244,"_26299":52753,"_2667":53115},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3171":2525,"_27803":2401,"_19261":53117,"_5":13244,"_26299":52753,"_2667":53118},[],"Low to medium: validation errors or changed defaults",{"_3171":2526,"_27803":2401,"_19261":53120,"_5":13244,"_26299":52753,"_2667":53121},[],"Update the values file",{"_3171":2527,"_27803":2401,"_19261":53123,"_5":13244,"_26299":52753,"_2667":52826},[],{"_3171":2528,"_27803":2401,"_19261":53125,"_5":13244,"_26299":52753,"_2667":53126},[],"Clients that send the DMS ID in the update body",{"_3171":2529,"_27803":2401,"_19261":53128,"_5":13244,"_26299":52753,"_2667":53129},[],"Low: the ID in the URL wins",{"_3171":2530,"_27803":2401,"_19261":53131,"_5":13244,"_26299":52753,"_2667":53132},[],"Send the ID in the URL",{"_3171":2531,"_27803":2401,"_19261":53134,"_5":13244,"_26299":52753,"_2667":52830},[],{"_3171":2532,"_27803":2401,"_19261":53136,"_5":13244,"_26299":52753,"_2667":53137},[],"Consumers that match on certificate `type`",{"_3171":2533,"_27803":2401,"_19261":53139,"_5":13244,"_26299":52753,"_2667":53140},[],"Low: two values are renamed",{"_3171":2534,"_27803":2401,"_19261":53142,"_5":13244,"_26299":52753,"_2667":53143},[],"Adapt consumers",{"_3171":2535,"_27803":2401,"_19261":53145,"_5":13244,"_26299":52753,"_2667":52822},[],{"_3171":2536,"_27803":2401,"_19261":53147,"_5":13244,"_26299":52753,"_2667":53148},[],"Any DMS",{"_3171":2537,"_27803":2401,"_19261":53150,"_5":13244,"_26299":52753,"_2667":53151},[],"Low: informational",{"_3171":2538,"_27803":2401,"_19261":53153,"_5":13244,"_26299":52753,"_2667":53154},[],"Read both blocks before editing",{"_3171":2539,"_27803":2401,"_19261":53156,"_5":13244,"_26299":52761,"_2667":53157},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3171":2540,"_27803":2401,"_19261":53159,"_5":13244,"_26299":52761,"_2667":53160},[],"Step 4 of the migration guide copies the data.",{"_3171":2541,"_27803":2401,"_19261":53162,"_5":13244,"_26299":52765,"_2667":53163},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3171":2542,"_27803":2401,"_19261":53165,"_5":13244,"_26299":52769,"_2667":53166},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3171":2543,"_27803":2401,"_19261":53168,"_5":13244,"_26299":52773,"_2667":53169},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3171":2544,"_27803":2401,"_19261":53171,"_5":13244,"_26299":52777,"_2667":53172},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3171":2545,"_27803":2401,"_19261":53174,"_5":13244,"_26299":52777,"_2667":53175},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3171":2546,"_27803":2401,"_19261":53177,"_5":13244,"_26299":52781,"_2667":53178},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3171":2547,"_27803":2401,"_19261":53180,"_5":13244,"_26299":52785,"_2667":53181},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3171":2548,"_27803":2401,"_19261":53183,"_5":13244,"_26299":52785,"_2667":53184},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3171":2549,"_27803":2401,"_19261":53186,"_5":13244,"_26299":52785,"_2667":53187},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3171":2550,"_27803":2401,"_19261":53189,"_5":13244,"_26299":52785,"_2667":53190},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3171":2551,"_27803":2401,"_19261":53192,"_5":13244,"_26299":52785,"_2667":53193},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3171":2552,"_27803":2401,"_19261":53195,"_5":13244,"_26299":52785,"_2667":53196},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3171":2553,"_27803":2401,"_19261":53198,"_5":13244,"_26299":52793,"_2667":53199},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3171":2554,"_27803":2401,"_19261":53201,"_5":13244,"_26299":52793,"_2667":53202},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3171":2555,"_27803":2401,"_19261":53204,"_5":13244,"_26299":52793,"_2667":53205},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3171":2556,"_27803":2401,"_19261":53207,"_5":13244,"_26299":52793,"_2667":53208},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3171":2557,"_27803":2401,"_19261":53210,"_5":13244,"_26299":52793,"_2667":53211},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3171":2558,"_27803":2401,"_19261":53213,"_5":13244,"_26299":52797,"_2667":53214},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3171":2559,"_27803":2401,"_19261":53216,"_5":13244,"_26299":52801,"_2667":53217},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3171":2560,"_27803":2401,"_19261":53219,"_5":13244,"_26299":52801,"_2667":53220},[],"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_3171":2561,"_27803":2401,"_19261":53222,"_5":13244,"_26299":52801,"_2667":53223},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3171":2562,"_27803":2401,"_19261":53225,"_5":13244,"_26299":52801,"_2667":53226},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3171":2563,"_27803":2401,"_19261":53228,"_5":13244,"_26299":52801,"_2667":53229},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3171":2564,"_27803":2401,"_19261":53231,"_5":13244,"_26299":52801,"_2667":53232},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3171":2565,"_27803":2401,"_19261":53234,"_5":13244,"_26299":52801,"_2667":53235},[],"Once legacy keys are registered, starting the KMS with the backend configuration option `crypto_engines.migrate_keys_format` renames keys whose name is not the public-key SHA-256 digest, keeps the old name as an alias and moves certificate references along. It is safe to re-run and can be disabled afterwards.",{"_3171":2566,"_27803":2401,"_19261":53237,"_5":13244,"_26299":52805,"_2667":53238},[],"Certificates now reference their KMS key, and VA roles reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. The CA migration registers the public keys of deleted CAs as KMS keys without a private key; they exist to satisfy the reference and are safe to delete.",{"_3171":2567,"_27803":2401,"_19261":53240,"_5":13244,"_26299":52813,"_2667":53241},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3171":2568,"_27803":2401,"_19261":53243,"_5":13244,"_26299":52813,"_2667":53244},[],"Field in 3.8.0",{"_3171":2569,"_27803":2401,"_19261":53246,"_5":13244,"_26299":52813,"_2667":53247},[],"Field in 4.0.0",{"_3171":2570,"_27803":2401,"_19261":53249,"_5":13244,"_26299":52813,"_2667":53250},[],"`validate_server_cert`",{"_3171":2571,"_27803":2401,"_19261":53252,"_5":13244,"_26299":52813,"_2667":53253},[],"`insecure_skip_verify` (value negated)",{"_3171":2572,"_27803":2401,"_19261":53255,"_5":13244,"_26299":52813,"_2667":53256},[],"`oidc`",{"_3171":2573,"_27803":2401,"_19261":53258,"_5":13244,"_26299":52813,"_2667":53259},[],"`jwt_options`",{"_3171":2574,"_27803":2401,"_19261":53261,"_5":13244,"_26299":52813,"_2667":53262},[],"`apikey`",{"_3171":2575,"_27803":2401,"_19261":53264,"_5":13244,"_26299":52813,"_2667":53265},[],"`apikey_options`",{"_3171":2576,"_27803":2401,"_19261":53267,"_5":13244,"_26299":52813,"_2667":53268},[],"`mtls`",{"_3171":2577,"_27803":2401,"_19261":53270,"_5":13244,"_26299":52813,"_2667":53271},[],"`mtls_options`",{"_3171":2578,"_27803":2401,"_19261":53273,"_5":13244,"_26299":52813,"_2667":53274},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3171":2579,"_27803":2401,"_19261":53276,"_5":13244,"_26299":52813,"_2667":53277},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3171":2580,"_27803":2401,"_19261":53279,"_5":13244,"_26299":52813,"_2667":53280},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3171":2581,"_27803":2401,"_19261":53282,"_5":13244,"_26299":52817,"_2667":53283},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3171":2582,"_27803":2401,"_19261":53285,"_5":13244,"_26299":52817,"_2667":53286},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3171":2583,"_27803":2401,"_19261":53288,"_5":13244,"_26299":52817,"_2667":53289},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3171":2584,"_27803":2401,"_19261":53291,"_5":13244,"_26299":52821,"_2667":53292},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. If the console version does not expose independent settings, edit them through the DMS API.",{"_3171":2585,"_27803":2401,"_19261":53294,"_5":13244,"_26299":52825,"_2667":53295},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3171":2586,"_27803":2401,"_19261":53297,"_5":13244,"_26299":52829,"_2667":53298},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3171":2587,"_27803":2401,"_19261":53300,"_5":13244,"_26299":52833,"_2667":53301},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3171":2588,"_27803":2401,"_19261":53303,"_5":13244,"_26299":52833,"_2667":53304},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3171":2589,"_27803":2401,"_19261":53306,"_5":13244,"_26299":52833,"_2667":53307},[],"`POST /v1/devices/:id/events` creates an event.",{"_3171":2590,"_27803":2401,"_19261":53309,"_5":13244,"_26299":52833,"_2667":53310},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3171":2591,"_27803":2401,"_19261":53312,"_5":13244,"_26299":52837,"_2667":53313},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_certificate_serial_number`, the serial number of the existing certificate that signs the CRL. A new role's initial value is the CA's current certificate serial number. Requests that still carry `subject_key_id_signer` return an error. Custom authorization policies that filter on the old field must be updated: the filter `crl_subject_key_id_signer` is renamed to `crl_signer_certificate_serial_number` and takes serial-number values.",{"_3171":2592,"_27803":2401,"_19261":53315,"_5":13244,"_26299":52841,"_2667":53316},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3171":2593,"_27803":2401,"_19261":53318,"_5":13244,"_26299":52845,"_2667":53319},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_3171":2594,"_27803":2401,"_19261":53321,"_5":13244,"_26299":52845,"_2667":53322},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3171":2595,"_27803":2401,"_19261":53324,"_5":13244,"_26299":52845,"_2667":53325},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3171":2596,"_27803":2401,"_19261":53327,"_5":13244,"_26299":52845,"_2667":53328},[],"Record the names of your local-storage PVCs:",{"_3171":2597,"_27803":2401,"_19261":53330,"_5":13244,"_26299":52845,"_2667":53331},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3171":2598,"_27803":2401,"_19261":53333,"_5":13244,"_26299":52849,"_2667":53334},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3171":2599,"_27803":2401,"_19261":53336,"_5":13244,"_26299":52849,"_2667":53337},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3171":2600,"_27803":2401,"_19261":53339,"_5":13244,"_26299":52849,"_2667":53340},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3171":2601,"_27803":2401,"_19261":53342,"_5":13244,"_26299":52849,"_2667":53343},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3171":2602,"_27803":2401,"_19261":53345,"_5":13244,"_26299":52849,"_2667":53346},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3171":2603,"_27803":2401,"_19261":53348,"_5":13244,"_26299":52849,"_2667":53349},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3171":2604,"_27803":2401,"_19261":53351,"_5":13244,"_26299":52849,"_2667":53352},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3171":2605,"_27803":2401,"_19261":53354,"_5":13244,"_26299":52849,"_2667":53355},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3171":2606,"_27803":2401,"_19261":53357,"_5":13244,"_26299":52849,"_2667":53358},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3171":2607,"_27803":2401,"_19261":53360,"_5":13244,"_26299":52849,"_2667":53361},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3171":2608,"_27803":2401,"_19261":53363,"_5":13244,"_26299":52849,"_2667":53364},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3171":2609,"_27803":2401,"_19261":53366,"_5":13244,"_26299":52849,"_2667":53367},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3171":2610,"_27803":2401,"_19261":53369,"_5":13244,"_26299":52853,"_2667":53370},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3171":2611,"_27803":2401,"_19261":53372,"_5":13244,"_26299":52853,"_2667":53373},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3171":2612,"_27803":2401,"_19261":53375,"_5":13244,"_26299":52857,"_2667":53376},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3171":2613,"_27803":2401,"_19261":53378,"_5":13244,"_26299":52857,"_2667":53379},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3171":2614,"_27803":2401,"_19261":53381,"_5":13244,"_26299":52857,"_2667":53382},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3171":2615,"_27803":2401,"_19261":53384,"_5":13244,"_26299":52857,"_2667":53385},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3171":2616,"_27803":2401,"_19261":53387,"_5":13244,"_26299":52857,"_2667":53388},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3171":2617,"_27803":2401,"_19261":53390,"_5":13244,"_26299":52857,"_2667":53391},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3171":2618,"_27803":2401,"_19261":53393,"_5":13244,"_26299":52857,"_2667":53394},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3171":2619,"_27803":2401,"_19261":53396,"_5":13244,"_26299":52857,"_2667":53397},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3171":2620,"_27803":2401,"_19261":53399,"_5":13244,"_26299":52857,"_2667":53400},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3171":2621,"_27803":2401,"_19261":53402,"_5":13244,"_26299":52857,"_2667":53403},[],"**Remove the helper and restore the recorded replica counts:**",{"_3171":2622,"_27803":2401,"_19261":53405,"_5":13244,"_26299":52857,"_2667":53406},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3171":2623,"_27803":2401,"_19261":53408,"_5":13244,"_26299":52861,"_2667":53409},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3171":2624,"_27803":2401,"_19261":53411,"_5":13244,"_26299":52861,"_2667":53412},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3171":2625,"_27803":2401,"_19261":53414,"_5":13244,"_26299":52865,"_2667":53415},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3171":2626,"_27803":2401,"_19261":53417,"_5":13244,"_26299":52865,"_2667":53418},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3171":2627,"_27803":2401,"_19261":53420,"_5":13244,"_26299":52865,"_2667":53421},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates` and `SELECT` on `ca.ca_certificates`. If your services connect with a different user than the one that ran the migrations, grant that user `SELECT` on `ca.certificates_view` after the migrations.",{"_3171":2628,"_27803":2401,"_19261":53423,"_5":13244,"_26299":52865,"_2667":53424},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3171":2629,"_27803":2401,"_19261":53426,"_5":13244,"_26299":52865,"_2667":53427},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3171":2630,"_27803":2401,"_19261":53429,"_5":13244,"_26299":52865,"_2667":53430},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3171":2631,"_27803":2401,"_19261":53432,"_5":13244,"_26299":52865,"_2667":53433},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3171":2632,"_27803":2401,"_19261":53435,"_5":13244,"_26299":52869,"_2667":53436},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3171":2633,"_27803":2401,"_19261":53438,"_5":13244,"_26299":52869,"_2667":53439},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3171":2634,"_27803":2401,"_19261":53441,"_5":13244,"_26299":52869,"_2667":53442},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3171":2635,"_27803":2401,"_19261":53444,"_5":13244,"_26299":52869,"_2667":53445},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3171":2636,"_27803":2401,"_19261":53447,"_5":13244,"_26299":52869,"_2667":53448},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_3171":2637,"_27803":2401,"_19261":53450,"_5":13244,"_26299":52869,"_2667":53451},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3171":2638,"_27803":2401,"_19261":53453,"_5":13244,"_26299":52869,"_2667":53454},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3171":2639,"_27803":2401,"_19261":53456,"_5":13244,"_26299":52869,"_2667":53457},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` schema migration.",{"_3171":2640,"_27803":2401,"_19261":53459,"_5":13244,"_26299":52869,"_2667":53460},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3171":2641,"_27803":2401,"_19261":53462,"_5":13244,"_26299":52869,"_2667":53463},[],"**The VA cannot start with `cannot resolve signer certificate for VA role ... N candidates`.** The role's signer certificate cannot be identified uniquely among N matching certificates. Review the certificates that share the CA's subject and key, and set `signer_certificate_serial_number` on the role to the serial of the intended signer.",{"_3171":2642,"_27803":2401,"_19261":53465,"_5":13244,"_26299":52869,"_2667":53466},[],"**A migration or service fails with `permission denied for table ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped. Grant the missing privileges and re-run.",{"_3171":2643,"_27803":2401,"_19261":53468,"_5":13244,"_26299":52872,"_2667":53469},[],"After the upgrade, check in this order:",{"_3171":2644,"_27803":2401,"_19261":53471,"_5":13244,"_26299":52872,"_2667":53472},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3171":2645,"_27803":2401,"_19261":53474,"_5":13244,"_26299":52872,"_2667":53475},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3171":2646,"_27803":2401,"_19261":53477,"_5":13244,"_26299":52872,"_2667":53478},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3171":2647,"_27803":2401,"_19261":53480,"_5":13244,"_26299":52872,"_2667":53481},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_3171":2648,"_27803":2401,"_19261":53483,"_5":13244,"_26299":52872,"_2667":53484},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS.",{"_3171":2649,"_27803":2401,"_19261":53486,"_5":13244,"_26299":52872,"_2667":53487},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3171":2650,"_27803":2401,"_19261":53489,"_5":13244,"_26299":52872,"_2667":53490},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3171":2651,"_27803":2401,"_19261":53492,"_5":13244,"_26299":52872,"_2667":53493},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3171":2652,"_27803":2401,"_19261":53495,"_5":13244,"_26299":52872,"_2667":53496},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3171":2653,"_27803":2401,"_19261":53498,"_5":13244,"_26299":52872,"_2667":53499},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3171":2654,"_27803":2401,"_19261":53501,"_5":13244,"_26299":52872,"_2667":53502},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3171":2655,"_27803":2401,"_19261":53504,"_5":13244,"_26299":52872,"_2667":53505},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3171":2656,"_27803":2401,"_19261":53507,"_5":13244,"_26299":52872,"_2667":53508},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3171":2657,"_27803":2401,"_19261":53510,"_5":13244,"_26299":52872,"_2667":53511},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3171":2658,"_27803":2401,"_19261":53513,"_5":13244,"_26299":52876,"_2667":53514},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3171":2659,"_27803":2401,"_19261":53516,"_5":13244,"_26299":52876,"_2667":53517},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3171":2660,"_27803":2401,"_19261":53519,"_5":13244,"_26299":52876,"_2667":53520},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3171":2661,"_27803":2401,"_19261":53522,"_5":13244,"_26299":52876,"_2667":53523},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3171":2662,"_27803":2401,"_19261":53525,"_5":13244,"_26299":52876,"_2667":53526},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_53529":53530,"_53531":53532,"_53533":53534,"_53535":53536,"_16781":2702,"_64142":2702},"language","english","sortableProperties",[2667,27803,5,26299],"sortablePropertiesWithTypes",{"_2667":23039,"_27803":23039,"_5":23039,"_26299":23039},"sorts",{"_2667":53537,"_27803":56189,"_5":58840,"_26299":61491},{"_4234":53538,"_53539":53540,"_5":23039},{"_13299":6889,"_13669":5312,"_13688":4527,"_26915":3017,"_13675":17846,"_18270":2945,"_13320":3047,"_13327":3046,"_26857":3712,"_27248":2880,"_27269":3663,"_26875":5589,"_31921":5400,"_27280":13197,"_27309":6835,"_31928":2844,"_31931":19190,"_31934":25531,"_31937":5032,"_27656":6373,"_31942":3789,"_31944":20901,"_27686":2941,"_13684":3517,"_31948":4058,"_31951":5408,"_31953":5630,"_27298":6922,"_27651":6807,"_27710":7013,"_31958":9359,"_31960":14743,"_31962":9689,"_31964":2764,"_31966":20014,"_31968":4008,"_31970":20204,"_31972":3360,"_31974":19900,"_26928":5313,"_31977":18711,"_31979":6345,"_26922":20422,"_31982":15979,"_31984":11743,"_31986":6862,"_31989":9192,"_26968":6347,"_31993":5719,"_26848":5422,"_31996":14660,"_26880":7880,"_31999":3757,"_32001":3044,"_32004":5768,"_13678":3940,"_32007":5165,"_32009":10158,"_32012":5519,"_32014":18540,"_32016":6375,"_32018":15115,"_32020":6965,"_18273":10864,"_32023":2967,"_32025":10249,"_26901":3665,"_27292":7864,"_32029":3519,"_32031":10250,"_32033":3710,"_2771