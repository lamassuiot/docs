ws-marketplace#configure-the-instance","Configure the instance",{"_3376":21,"_29549":15,"_5":29898,"_20523":48167,"_26884":48168,"_2862":48169},[],"/docs/pr-preview/pr-52/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3376":22,"_29549":15,"_5":29898,"_20523":48171,"_26884":48172,"_2862":48173},[],"/docs/pr-preview/pr-52/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3376":23,"_29549":15,"_5":29898,"_20523":48175,"_26884":48176,"_2862":48177},[],"/docs/pr-preview/pr-52/deployment/aws-marketplace#next-step","Next step",{"_3376":24,"_29549":15,"_20523":48179,"_5":14087,"_26884":15,"_2862":48180},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3376":25,"_29549":15,"_20523":48182,"_5":14087,"_26884":48152,"_2862":48183},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3376":26,"_29549":15,"_20523":48185,"_5":14087,"_26884":48152,"_2862":48186},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3376":27,"_29549":15,"_20523":48188,"_5":14087,"_26884":48152,"_2862":48189},[],"A security group allowing the necessary endpoints.",{"_3376":28,"_29549":15,"_20523":48191,"_5":14087,"_26884":48156,"_2862":48192},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3376":29,"_29549":15,"_20523":48194,"_5":14087,"_26884":48156,"_2862":48195},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3376":30,"_29549":15,"_20523":48197,"_5":14087,"_26884":48156,"_2862":48198},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3376":31,"_29549":15,"_20523":48200,"_5":14087,"_26884":48160,"_2862":48201},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3376":32,"_29549":15,"_20523":48203,"_5":14087,"_26884":48164,"_2862":48204},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3376":33,"_29549":15,"_20523":48206,"_5":14087,"_26884":48168,"_2862":48207},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3376":34,"_29549":15,"_20523":48209,"_5":14087,"_26884":48172,"_2862":48210},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3376":35,"_29549":15,"_20523":48212,"_5":14087,"_26884":48176,"_2862":48213},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3376":36,"_29549":36,"_5":14445,"_2862":48215,"_29901":48216,"_20523":48217,"_26884":36},"Deploy Lamassu",[48143,48144],[],{"_3376":37,"_29549":36,"_20523":48219,"_5":14087,"_26884":36,"_2862":48220},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3376":38,"_29549":36,"_5":29898,"_20523":48222,"_26884":48223,"_2862":48224},[],"/docs/pr-preview/pr-52/deployment/overview#choose-a-model","Choose a model",{"_3376":39,"_29549":36,"_5":29898,"_20523":48226,"_26884":48227,"_2862":48228},[],"/docs/pr-preview/pr-52/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3376":40,"_29549":36,"_5":29898,"_20523":48230,"_26884":48231,"_2862":48232},[],"/docs/pr-preview/pr-52/deployment/overview#after-deployment","After deployment",{"_3376":41,"_29549":36,"_20523":48234,"_5":14087,"_26884":36,"_2862":48235},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3376":42,"_29549":36,"_20523":48237,"_5":14087,"_26884":48223,"_2862":48238},[],"Model",{"_3376":43,"_29549":36,"_20523":48240,"_5":14087,"_26884":48223,"_2862":48241},[],"Recommended for",{"_3376":44,"_29549":36,"_20523":48243,"_5":14087,"_26884":48223,"_2862":48244},[],"Who operates the infrastructure",{"_3376":45,"_29549":36,"_20523":48246,"_5":14087,"_26884":48223,"_2862":48247},[],"Starting point",{"_3376":46,"_29549":36,"_20523":48249,"_5":14087,"_26884":48223,"_2862":48250},[],"Kubernetes self-managed",{"_3376":47,"_29549":36,"_20523":48252,"_5":14087,"_26884":48223,"_2862":48253},[],"Production, regulated environments and custom deployments",{"_3376":48,"_29549":36,"_20523":48255,"_5":14087,"_26884":48223,"_2862":48256},[],"Your team",{"_3376":49,"_29549":36,"_20523":48258,"_5":14087,"_26884":48223,"_2862":48259},[],"Helm or Fastlane",{"_3376":50,"_29549":36,"_20523":48261,"_5":14087,"_26884":48223,"_2862":48262},[],"AWS Marketplace",{"_3376":51,"_29549":36,"_20523":48264,"_5":14087,"_26884":48223,"_2862":48265},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3376":52,"_29549":36,"_20523":48267,"_5":14087,"_26884":48223,"_2862":48256},[],{"_3376":53,"_29549":36,"_20523":48269,"_5":14087,"_26884":48223,"_2862":48270},[],"Preconfigured image on EC2",{"_3376":54,"_29549":36,"_20523":48272,"_5":14087,"_26884":48223,"_2862":48273},[],"SaaS",{"_3376":55,"_29549":36,"_20523":48275,"_5":14087,"_26884":48223,"_2862":48276},[],"Teams that want to use the platform without operating it",{"_3376":56,"_29549":36,"_20523":48278,"_5":14087,"_26884":48223,"_2862":48279},[],"Lamassu",{"_3376":57,"_29549":36,"_20523":48281,"_5":14087,"_26884":48223,"_2862":48282},[],"Managed subscription",{"_3376":58,"_29549":36,"_20523":48284,"_5":14087,"_26884":48223,"_2862":48285},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3376":59,"_29549":36,"_20523":48287,"_5":14087,"_26884":48223,"_2862":48288},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3376":60,"_29549":36,"_20523":48290,"_5":14087,"_26884":48223,"_2862":48291},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3376":61,"_29549":36,"_20523":48293,"_5":14087,"_26884":48227,"_2862":48294},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3376":62,"_29549":36,"_20523":48296,"_5":14087,"_26884":48231,"_2862":48297},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3376":63,"_29549":63,"_5":14445,"_2862":48299,"_29901":48300,"_20523":48301,"_26884":63},"Use Lamassu as SaaS",[48143,48144,48145],[],{"_3376":64,"_29549":63,"_20523":48303,"_5":14087,"_26884":63,"_2862":48304},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3376":65,"_29549":63,"_5":29898,"_20523":48306,"_26884":48307,"_2862":48308},[],"/docs/pr-preview/pr-52/deployment/saas#what-the-service-manages","What the service manages",{"_3376":66,"_29549":63,"_5":29898,"_20523":48310,"_26884":48311,"_2862":48312},[],"/docs/pr-preview/pr-52/deployment/saas#plans","Plans",{"_3376":67,"_29549":63,"_5":29898,"_20523":48314,"_26884":48315,"_2862":48316},[],"/docs/pr-preview/pr-52/deployment/saas#request-access","Request access",{"_3376":68,"_29549":63,"_20523":48318,"_5":14087,"_26884":63,"_2862":48319},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3376":69,"_29549":63,"_20523":48321,"_5":14087,"_26884":48307,"_2862":48322},[],"Platform availability and maintenance.",{"_3376":70,"_29549":63,"_20523":48324,"_5":14087,"_26884":48307,"_2862":48325},[],"Automatic backups.",{"_3376":71,"_29549":63,"_20523":48327,"_5":14087,"_26884":48307,"_2862":48328},[],"Version upgrades.",{"_3376":72,"_29549":63,"_20523":48330,"_5":14087,"_26884":48307,"_2862":48331},[],"Technical support and SLA according to your plan.",{"_3376":73,"_29549":63,"_20523":48333,"_5":14087,"_26884":48311,"_2862":48334},[],"Plan",{"_3376":74,"_29549":63,"_20523":48336,"_5":14087,"_26884":48311,"_2862":48337},[],"Devices",{"_3376":75,"_29549":63,"_20523":48339,"_5":14087,"_26884":48311,"_2862":48340},[],"Support",{"_3376":76,"_29549":63,"_20523":48342,"_5":14087,"_26884":48311,"_2862":48343},[],"SLA",{"_3376":77,"_29549":63,"_20523":48345,"_5":14087,"_26884":48311,"_2862":48346},[],"Starter",{"_3376":78,"_29549":63,"_20523":48348,"_5":14087,"_26884":48311,"_2862":48349},[],"Up to 1,000",{"_3376":79,"_29549":63,"_20523":48351,"_5":14087,"_26884":48311,"_2862":48352},[],"Email",{"_3376":80,"_29549":63,"_20523":48354,"_5":14087,"_26884":48311,"_2862":48355},[],"99.5 %",{"_3376":81,"_29549":63,"_20523":48357,"_5":14087,"_26884":48311,"_2862":48358},[],"Professional",{"_3376":82,"_29549":63,"_20523":48360,"_5":14087,"_26884":48311,"_2862":48361},[],"Up to 10,000",{"_3376":83,"_29549":63,"_20523":48363,"_5":14087,"_26884":48311,"_2862":48364},[],"Email and chat",{"_3376":84,"_29549":63,"_20523":48366,"_5":14087,"_26884":48311,"_2862":48367},[],"99.9 %",{"_3376":85,"_29549":63,"_20523":48369,"_5":14087,"_26884":48311,"_2862":48370},[],"Enterprise",{"_3376":86,"_29549":63,"_20523":48372,"_5":14087,"_26884":48311,"_2862":48373},[],"Unlimited",{"_3376":87,"_29549":63,"_20523":48375,"_5":14087,"_26884":48311,"_2862":48376},[],"Dedicated",{"_3376":88,"_29549":63,"_20523":48378,"_5":14087,"_26884":48311,"_2862":48379},[],"99.99 %",{"_3376":89,"_29549":63,"_20523":48381,"_5":14087,"_26884":48315,"_2862":48382},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3376":90,"_29549":63,"_20523":48384,"_5":14087,"_26884":48315,"_2862":48385},[],"When you receive your instance's credentials, continue with Get started.",{"_3376":91,"_29549":91,"_5":14445,"_2862":48387,"_29901":48388,"_20523":48389,"_26884":91},"Fastlane",[48143,48144,48250],[],{"_3376":92,"_29549":91,"_20523":48391,"_5":14087,"_26884":91,"_2862":48392},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3376":93,"_29549":91,"_5":29898,"_20523":48394,"_26884":48395,"_2862":48396},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3376":94,"_29549":91,"_5":29898,"_20523":48398,"_26884":48399,"_2862":48400},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3376":95,"_29549":91,"_5":29898,"_20523":48402,"_26884":48403,"_2862":48153},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#before-you-begin",{"_3376":96,"_29549":91,"_5":29898,"_20523":48405,"_26884":48406,"_2862":48407},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3376":97,"_29549":91,"_5":29898,"_20523":48409,"_26884":48410,"_2862":48411},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3376":98,"_29549":91,"_5":29898,"_20523":48413,"_26884":48414,"_2862":48415},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3376":99,"_29549":91,"_5":29898,"_20523":48417,"_26884":48418,"_2862":48419},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3376":100,"_29549":91,"_5":29898,"_20523":48421,"_26884":48422,"_2862":48423},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3376":101,"_29549":91,"_5":29898,"_20523":48425,"_26884":48426,"_2862":48427},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3376":102,"_29549":91,"_5":29898,"_20523":48429,"_26884":48430,"_2862":48431},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3376":103,"_29549":91,"_5":29898,"_20523":48433,"_26884":48434,"_2862":48435},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3376":104,"_29549":91,"_20523":48437,"_5":14087,"_26884":48395,"_2862":48438},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3376":105,"_29549":91,"_20523":48440,"_5":14087,"_26884":48395,"_2862":48441},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3376":106,"_29549":91,"_20523":48443,"_5":14087,"_26884":48399,"_2862":48444},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3376":107,"_29549":91,"_20523":48446,"_5":14087,"_26884":48399,"_2862":48447},[],"Fastlane installs or configures",{"_3376":108,"_29549":91,"_20523":48449,"_5":14087,"_26884":48399,"_2862":48450},[],"You still provide",{"_3376":109,"_29549":91,"_20523":48452,"_5":14087,"_26884":48399,"_2862":48453},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3376":110,"_29549":91,"_20523":48455,"_5":14087,"_26884":48399,"_2862":48456},[],"The Kubernetes cluster, nodes and persistent storage",{"_3376":111,"_29549":91,"_20523":48458,"_5":14087,"_26884":48399,"_2862":48459},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3376":112,"_29549":91,"_20523":48461,"_5":14087,"_26884":48399,"_2862":48462},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3376":113,"_29549":91,"_20523":48464,"_5":14087,"_26884":48399,"_2862":48465},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3376":114,"_29549":91,"_20523":48467,"_5":14087,"_26884":48399,"_2862":48468},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3376":115,"_29549":91,"_20523":48470,"_5":14087,"_26884":48399,"_2862":48471},[],"Optional observability and lab HSM components",{"_3376":116,"_29549":91,"_20523":48473,"_5":14087,"_26884":48399,"_2862":48474},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3376":117,"_29549":91,"_20523":48476,"_5":14087,"_26884":48399,"_2862":48477},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3376":118,"_29549":91,"_20523":48479,"_5":14087,"_26884":48403,"_2862":48480},[],"You need:",{"_3376":119,"_29549":91,"_20523":48482,"_5":14087,"_26884":48403,"_2862":48483},[],"an existing Kubernetes cluster",{"_3376":120,"_29549":91,"_20523":48485,"_5":14087,"_26884":48403,"_2862":48486},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3376":121,"_29549":91,"_20523":48488,"_5":14087,"_26884":48403,"_2862":48489},[],"`yq`",{"_3376":122,"_29549":91,"_20523":48491,"_5":14087,"_26884":48403,"_2862":23204},[],{"_3376":123,"_29549":91,"_20523":48493,"_5":14087,"_26884":48403,"_2862":48494},[],"`jq` only when using `--sample-data` or `--development`",{"_3376":124,"_29549":91,"_20523":48496,"_5":14087,"_26884":48403,"_2862":48497},[],"`ssh-keygen` only when using `--with-hsm`",{"_3376":125,"_29549":91,"_20523":48499,"_5":14087,"_26884":48403,"_2862":48500},[],"free external ports 80 and 443 on a single-node K3s host",{"_3376":126,"_29549":91,"_20523":48502,"_5":14087,"_26884":48403,"_2862":48503},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3376":127,"_29549":91,"_20523":48505,"_5":14087,"_26884":48403,"_2862":48506},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3376":128,"_29549":91,"_20523":48508,"_5":14087,"_26884":48406,"_2862":48509},[],"Run the script from a clone of the Helm repository:",{"_3376":129,"_29549":91,"_20523":48511,"_5":14087,"_26884":48406,"_2862":48512},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3376":130,"_29549":91,"_20523":48514,"_5":14087,"_26884":48410,"_2862":48515},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3376":131,"_29549":91,"_20523":48517,"_5":14087,"_26884":48410,"_2862":48518},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3376":132,"_29549":91,"_20523":48520,"_5":14087,"_26884":48410,"_2862":48521},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3376":133,"_29549":91,"_20523":48523,"_5":14087,"_26884":48410,"_2862":48524},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3376":134,"_29549":91,"_20523":48526,"_5":14087,"_26884":48414,"_2862":48527},[],"Option",{"_3376":135,"_29549":91,"_20523":48529,"_5":14087,"_26884":48414,"_2862":48530},[],"Default",{"_3376":136,"_29549":91,"_20523":48532,"_5":14087,"_26884":48414,"_2862":48533},[],"Purpose",{"_3376":137,"_29549":91,"_20523":48535,"_5":14087,"_26884":48414,"_2862":48536},[],"`-h`, `--help`",{"_3376":138,"_29549":91,"_20523":48538,"_5":14087,"_26884":48414,"_2862":48539},[],"—",{"_3376":139,"_29549":91,"_20523":48541,"_5":14087,"_26884":48414,"_2862":48542},[],"Show help",{"_3376":140,"_29549":91,"_20523":48544,"_5":14087,"_26884":48414,"_2862":48545},[],"`-c`, `--context`",{"_3376":141,"_29549":91,"_20523":48547,"_5":14087,"_26884":48414,"_2862":48548},[],"current context",{"_3376":142,"_29549":91,"_20523":48550,"_5":14087,"_26884":48414,"_2862":48551},[],"Select the kubeconfig context for kubectl and Helm",{"_3376":143,"_29549":91,"_20523":48553,"_5":14087,"_26884":48414,"_2862":48554},[],"`-n`, `--non-interactive`",{"_3376":144,"_29549":91,"_20523":48556,"_5":14087,"_26884":48414,"_2862":6381},[],{"_3376":145,"_29549":91,"_20523":48558,"_5":14087,"_26884":48414,"_2862":48559},[],"Skip prompts and generate dependency credentials",{"_3376":146,"_29549":91,"_20523":48561,"_5":14087,"_26884":48414,"_2862":48562},[],"`-ns`, `--namespace`",{"_3376":147,"_29549":91,"_20523":48564,"_5":14087,"_26884":48414,"_2862":48565},[],"`lamassu-dev`",{"_3376":148,"_29549":91,"_20523":48567,"_5":14087,"_26884":48414,"_2862":48568},[],"Namespace for the installation",{"_3376":149,"_29549":91,"_20523":48570,"_5":14087,"_26884":48414,"_2862":48571},[],"`-d`, `--domain`",{"_3376":150,"_29549":91,"_20523":48573,"_5":14087,"_26884":48414,"_2862":48574},[],"`dev.lamassu.io`",{"_3376":151,"_29549":91,"_20523":48576,"_5":14087,"_26884":48414,"_2862":48577},[],"Domain used by the UI, OIDC and certificate",{"_3376":152,"_29549":91,"_20523":48579,"_5":14087,"_26884":48414,"_2862":48580},[],"`-v`, `--version`",{"_3376":153,"_29549":91,"_20523":48582,"_5":14087,"_26884":48414,"_2862":14774},[],{"_3376":154,"_29549":91,"_20523":48584,"_5":14087,"_26884":48414,"_2862":48585},[],"Lamassu chart version",{"_3376":155,"_29549":91,"_20523":48587,"_5":14087,"_26884":48414,"_2862":48588},[],"`--https-port`",{"_3376":156,"_29549":91,"_20523":48590,"_5":14087,"_26884":48414,"_2862":48591},[],"`443`",{"_3376":157,"_29549":91,"_20523":48593,"_5":14087,"_26884":48414,"_2862":48594},[],"Gateway HTTPS listener port",{"_3376":158,"_29549":91,"_20523":48596,"_5":14087,"_26884":48414,"_2862":48597},[],"`--http-port`",{"_3376":159,"_29549":91,"_20523":48599,"_5":14087,"_26884":48414,"_2862":48600},[],"`80`",{"_3376":160,"_29549":91,"_20523":48602,"_5":14087,"_26884":48414,"_2862":48603},[],"Gateway HTTP listener port",{"_3376":161,"_29549":91,"_20523":48605,"_5":14087,"_26884":48414,"_2862":48606},[],"`--tls-crt`",{"_3376":162,"_29549":91,"_20523":48608,"_5":14087,"_26884":48414,"_2862":48539},[],{"_3376":163,"_29549":91,"_20523":48610,"_5":14087,"_26884":48414,"_2862":48611},[],"PEM certificate for downstream TLS",{"_3376":164,"_29549":91,"_20523":48613,"_5":14087,"_26884":48414,"_2862":48614},[],"`--tls-key`",{"_3376":165,"_29549":91,"_20523":48616,"_5":14087,"_26884":48414,"_2862":48539},[],{"_3376":166,"_29549":91,"_20523":48618,"_5":14087,"_26884":48414,"_2862":48619},[],"PEM private key for downstream TLS",{"_3376":167,"_29549":91,"_20523":48621,"_5":14087,"_26884":48414,"_2862":48622},[],"`-l`, `--local-chart-path`",{"_3376":168,"_29549":91,"_20523":48624,"_5":14087,"_26884":48414,"_2862":48625},[],"repository chart",{"_3376":169,"_29549":91,"_20523":48627,"_5":14087,"_26884":48414,"_2862":48628},[],"Use an unpacked local Lamassu chart",{"_3376":170,"_29549":91,"_20523":48630,"_5":14087,"_26884":48414,"_2862":48631},[],"`-ip`, `--gateway-ip`",{"_3376":171,"_29549":91,"_20523":48633,"_5":14087,"_26884":48414,"_2862":8549},[],{"_3376":172,"_29549":91,"_20523":48635,"_5":14087,"_26884":48414,"_2862":48636},[],"Override the address written to `gateway.addresses`",{"_3376":173,"_29549":91,"_20523":48638,"_5":14087,"_26884":48414,"_2862":48639},[],"`--otel`",{"_3376":174,"_29549":91,"_20523":48641,"_5":14087,"_26884":48414,"_2862":6381},[],{"_3376":175,"_29549":91,"_20523":48643,"_5":14087,"_26884":48414,"_2862":48644},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3376":176,"_29549":91,"_20523":48646,"_5":14087,"_26884":48414,"_2862":48647},[],"`--development`",{"_3376":177,"_29549":91,"_20523":48649,"_5":14087,"_26884":48414,"_2862":6381},[],{"_3376":178,"_29549":91,"_20523":48651,"_5":14087,"_26884":48414,"_2862":48652},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3376":179,"_29549":91,"_20523":48654,"_5":14087,"_26884":48414,"_2862":48655},[],"`--sample-data`",{"_3376":180,"_29549":91,"_20523":48657,"_5":14087,"_26884":48414,"_2862":6381},[],{"_3376":181,"_29549":91,"_20523":48659,"_5":14087,"_26884":48414,"_2862":48660},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3376":182,"_29549":91,"_20523":48662,"_5":14087,"_26884":48414,"_2862":48663},[],"`--with-hsm`",{"_3376":183,"_29549":91,"_20523":48665,"_5":14087,"_26884":48414,"_2862":6381},[],{"_3376":184,"_29549":91,"_20523":48667,"_5":14087,"_26884":48414,"_2862":48668},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3376":185,"_29549":91,"_20523":48670,"_5":14087,"_26884":48414,"_2862":48671},[],"`--softhsm-chart-path`",{"_3376":186,"_29549":91,"_20523":48673,"_5":14087,"_26884":48414,"_2862":48674},[],"`./charts/softhsm`",{"_3376":187,"_29549":91,"_20523":48676,"_5":14087,"_26884":48414,"_2862":48677},[],"Use a different local SoftHSM chart",{"_3376":188,"_29549":91,"_20523":48679,"_5":14087,"_26884":48414,"_2862":48680},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3376":189,"_29549":91,"_20523":48682,"_5":14087,"_26884":48418,"_2862":48683},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3376":190,"_29549":91,"_20523":48685,"_5":14087,"_26884":48418,"_2862":48686},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3376":191,"_29549":91,"_20523":48688,"_5":14087,"_26884":48418,"_2862":48689},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3376":192,"_29549":91,"_20523":48691,"_5":14087,"_26884":48418,"_2862":48692},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3376":193,"_29549":91,"_20523":48694,"_5":14087,"_26884":48418,"_2862":48695},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3376":194,"_29549":91,"_20523":48697,"_5":14087,"_26884":48418,"_2862":48698},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3376":195,"_29549":91,"_20523":48700,"_5":14087,"_26884":48422,"_2862":48701},[],"Fastlane:",{"_3376":196,"_29549":91,"_20523":48703,"_5":14087,"_26884":48422,"_2862":48704},[],"validates local tools and the selected cluster",{"_3376":197,"_29549":91,"_20523":48706,"_5":14087,"_26884":48422,"_2862":48707},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3376":198,"_29549":91,"_20523":48709,"_5":14087,"_26884":48422,"_2862":48710},[],"creates the namespace",{"_3376":199,"_29549":91,"_20523":48712,"_5":14087,"_26884":48422,"_2862":48713},[],"installs PostgreSQL and creates the required databases",{"_3376":200,"_29549":91,"_20523":48715,"_5":14087,"_26884":48422,"_2862":48716},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3376":201,"_29549":91,"_20523":48718,"_5":14087,"_26884":48422,"_2862":48719},[],"installs RabbitMQ",{"_3376":202,"_29549":91,"_20523":48721,"_5":14087,"_26884":48422,"_2862":48722},[],"optionally installs observability and lab HSM components",{"_3376":203,"_29549":91,"_20523":48724,"_5":14087,"_26884":48422,"_2862":48725},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3376":204,"_29549":91,"_20523":48727,"_5":14087,"_26884":48422,"_2862":48728},[],"optionally loads sample data",{"_3376":205,"_29549":91,"_20523":48730,"_5":14087,"_26884":48422,"_2862":48731},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3376":206,"_29549":91,"_20523":48733,"_5":14087,"_26884":48426,"_2862":48734},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3376":207,"_29549":91,"_20523":48736,"_5":14087,"_26884":48426,"_2862":48737},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3376":208,"_29549":91,"_20523":48739,"_5":14087,"_26884":48430,"_2862":48740},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3376":209,"_29549":91,"_20523":48742,"_5":14087,"_26884":48430,"_2862":48743},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3376":210,"_29549":91,"_20523":48745,"_5":14087,"_26884":48430,"_2862":48746},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3376":211,"_29549":91,"_20523":48748,"_5":14087,"_26884":48434,"_2862":48749},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3376":212,"_29549":212,"_5":14445,"_2862":48751,"_29901":48752,"_20523":48753,"_26884":212},"Install with Helm",[48143,48144,48250],[],{"_3376":213,"_29549":212,"_20523":48755,"_5":14087,"_26884":212,"_2862":48756},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3376":214,"_29549":212,"_5":29898,"_20523":48758,"_26884":48759,"_2862":48760},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3376":215,"_29549":212,"_5":29898,"_20523":48762,"_26884":48763,"_2862":48153},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#before-you-begin",{"_3376":216,"_29549":212,"_5":29898,"_20523":48765,"_26884":48766,"_2862":48767},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3376":217,"_29549":212,"_5":29898,"_20523":48769,"_26884":48770,"_2862":48771},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3376":218,"_29549":212,"_5":29898,"_20523":48773,"_26884":48774,"_2862":48775},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3376":219,"_29549":212,"_5":29898,"_20523":48777,"_26884":48778,"_2862":48779},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3376":220,"_29549":212,"_5":29898,"_20523":48781,"_26884":48782,"_2862":48783},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3376":221,"_29549":212,"_5":29898,"_20523":48785,"_26884":48786,"_2862":48787},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3376":222,"_29549":212,"_5":29898,"_20523":48789,"_26884":48790,"_2862":48791},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3376":223,"_29549":212,"_5":29898,"_20523":48793,"_26884":48794,"_2862":48795},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3376":224,"_29549":212,"_5":29898,"_20523":48797,"_26884":48798,"_2862":48799},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3376":225,"_29549":212,"_20523":48801,"_5":14087,"_26884":48759,"_2862":48802},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3376":226,"_29549":212,"_20523":48804,"_5":14087,"_26884":48763,"_2862":48805},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3376":227,"_29549":212,"_20523":48807,"_5":14087,"_26884":48763,"_2862":48808},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3376":228,"_29549":212,"_20523":48810,"_5":14087,"_26884":48763,"_2862":48811},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3376":229,"_29549":212,"_20523":48813,"_5":14087,"_26884":48763,"_2862":48814},[],"a reachable RabbitMQ broker and credentials",{"_3376":230,"_29549":212,"_20523":48816,"_5":14087,"_26884":48763,"_2862":48817},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3376":231,"_29549":212,"_20523":48819,"_5":14087,"_26884":48763,"_2862":48820},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3376":232,"_29549":212,"_20523":48822,"_5":14087,"_26884":48763,"_2862":48823},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3376":233,"_29549":212,"_20523":48825,"_5":14087,"_26884":48763,"_2862":48826},[],"a StorageClass and an external traffic design",{"_3376":234,"_29549":212,"_20523":48828,"_5":14087,"_26884":48763,"_2862":48829},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3376":235,"_29549":212,"_20523":48831,"_5":14087,"_26884":48763,"_2862":48832},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3376":236,"_29549":212,"_20523":48834,"_5":14087,"_26884":48763,"_2862":48835},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3376":237,"_29549":212,"_20523":48837,"_5":14087,"_26884":48766,"_2862":48838},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3376":238,"_29549":212,"_20523":48840,"_5":14087,"_26884":48766,"_2862":48841},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3376":239,"_29549":212,"_20523":48843,"_5":14087,"_26884":48766,"_2862":48844},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3376":240,"_29549":212,"_20523":48846,"_5":14087,"_26884":48770,"_2862":48847},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3376":241,"_29549":212,"_20523":48849,"_5":14087,"_26884":48770,"_2862":48850},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3376":242,"_29549":212,"_20523":48852,"_5":14087,"_26884":48770,"_2862":48853},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3376":243,"_29549":212,"_20523":48855,"_5":14087,"_26884":48770,"_2862":48856},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3376":244,"_29549":212,"_20523":48858,"_5":14087,"_26884":48774,"_2862":48859},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3376":245,"_29549":212,"_20523":48861,"_5":14087,"_26884":48778,"_2862":48862},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3376":246,"_29549":212,"_20523":48864,"_5":14087,"_26884":48778,"_2862":48865},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3376":247,"_29549":212,"_20523":48867,"_5":14087,"_26884":48778,"_2862":48868},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3376":248,"_29549":212,"_20523":48870,"_5":14087,"_26884":48778,"_2862":48871},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3376":249,"_29549":212,"_20523":48873,"_5":14087,"_26884":48778,"_2862":48874},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3376":250,"_29549":212,"_20523":48876,"_5":14087,"_26884":48778,"_2862":48877},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3376":251,"_29549":212,"_20523":48879,"_5":14087,"_26884":48778,"_2862":48880},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3376":252,"_29549":212,"_20523":48882,"_5":14087,"_26884":48782,"_2862":48883},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3376":253,"_29549":212,"_20523":48885,"_5":14087,"_26884":48782,"_2862":48886},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3376":254,"_29549":212,"_20523":48888,"_5":14087,"_26884":48782,"_2862":48889},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3376":255,"_29549":212,"_20523":48891,"_5":14087,"_26884":48782,"_2862":48892},[],"See Access control for the principal and policy model.",{"_3376":256,"_29549":212,"_20523":48894,"_5":14087,"_26884":48786,"_2862":48895},[],"To install a local checkout instead:",{"_3376":257,"_29549":212,"_20523":48897,"_5":14087,"_26884":48790,"_2862":48898},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3376":258,"_29549":212,"_20523":48900,"_5":14087,"_26884":48790,"_2862":48901},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3376":259,"_29549":212,"_20523":48903,"_5":14087,"_26884":48794,"_2862":48904},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3376":260,"_29549":212,"_20523":48906,"_5":14087,"_26884":48794,"_2862":48907},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3376":261,"_29549":212,"_20523":48909,"_5":14087,"_26884":48794,"_2862":48910},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3376":262,"_29549":212,"_20523":48912,"_5":14087,"_26884":48794,"_2862":48913},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3376":263,"_29549":212,"_20523":48915,"_5":14087,"_26884":48794,"_2862":48916},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3376":264,"_29549":212,"_20523":48918,"_5":14087,"_26884":48798,"_2862":48919},[],"Before going live, review:",{"_3376":265,"_29549":212,"_20523":48921,"_5":14087,"_26884":48798,"_2862":48922},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3376":266,"_29549":212,"_20523":48924,"_5":14087,"_26884":48798,"_2862":48925},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3376":267,"_29549":212,"_20523":48927,"_5":14087,"_26884":48798,"_2862":48928},[],"shared VA storage before increasing VA replicas",{"_3376":268,"_29549":212,"_20523":48930,"_5":14087,"_26884":48798,"_2862":48931},[],"managed OIDC roles and removal of evaluation credentials",{"_3376":269,"_29549":212,"_20523":48933,"_5":14087,"_26884":48798,"_2862":48934},[],"a trusted TLS issuer or externally managed certificate",{"_3376":270,"_29549":212,"_20523":48936,"_5":14087,"_26884":48798,"_2862":48937},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3376":271,"_29549":212,"_20523":48939,"_5":14087,"_26884":48798,"_2862":48940},[],"SMTP, observability and alert delivery",{"_3376":272,"_29549":212,"_20523":48942,"_5":14087,"_26884":48798,"_2862":48943},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3376":273,"_29549":212,"_20523":48945,"_5":14087,"_26884":48798,"_2862":48946},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3376":274,"_29549":274,"_5":14445,"_2862":48948,"_29901":48949,"_20523":48950,"_26884":274},"Expose the Gateway",[48143,48144,48250],[],{"_3376":275,"_29549":274,"_20523":48952,"_5":14087,"_26884":274,"_2862":48953},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3376":276,"_29549":274,"_5":29898,"_20523":48955,"_26884":48956,"_2862":48957},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3376":277,"_29549":274,"_5":29898,"_20523":48959,"_26884":48960,"_2862":48961},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3376":278,"_29549":274,"_5":29898,"_20523":48963,"_26884":48964,"_2862":48965},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3376":279,"_29549":274,"_5":29898,"_20523":48967,"_26884":48968,"_2862":48969},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#k3s","K3s",{"_3376":280,"_29549":274,"_5":29898,"_20523":48971,"_26884":48972,"_2862":48973},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3376":281,"_29549":274,"_5":29898,"_20523":48975,"_26884":48976,"_2862":48977},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3376":282,"_29549":274,"_5":29898,"_20523":48979,"_26884":48980,"_2862":48981},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3376":283,"_29549":274,"_5":29898,"_20523":48983,"_26884":48984,"_2862":48985},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3376":284,"_29549":274,"_5":29898,"_20523":48987,"_26884":48988,"_2862":48989},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3376":285,"_29549":274,"_5":29898,"_20523":48991,"_26884":48992,"_2862":48993},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3376":286,"_29549":274,"_20523":48995,"_5":14087,"_26884":48956,"_2862":48996},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3376":287,"_29549":274,"_20523":48998,"_5":14087,"_26884":48956,"_2862":48999},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3376":288,"_29549":274,"_20523":49001,"_5":14087,"_26884":48960,"_2862":49002},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3376":289,"_29549":274,"_20523":49004,"_5":14087,"_26884":48960,"_2862":49005},[],"Set it only when:",{"_3376":290,"_29549":274,"_20523":49007,"_5":14087,"_26884":48960,"_2862":49008},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3376":291,"_29549":274,"_20523":49010,"_5":14087,"_26884":48960,"_2862":49011},[],"that address is allocated to this Gateway",{"_3376":292,"_29549":274,"_20523":49013,"_5":14087,"_26884":48960,"_2862":49014},[],"the surrounding network already routes traffic for it to the cluster",{"_3376":293,"_29549":274,"_20523":49016,"_5":14087,"_26884":48960,"_2862":49017},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3376":294,"_29549":274,"_20523":49019,"_5":14087,"_26884":48960,"_2862":49020},[],"Keep these two settings separate:",{"_3376":295,"_29549":274,"_20523":49022,"_5":14087,"_26884":48960,"_2862":49023},[],"`gateway.addresses` requests an address for the Gateway.",{"_3376":296,"_29549":274,"_20523":49025,"_5":14087,"_26884":48960,"_2862":49026},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3376":297,"_29549":274,"_20523":49028,"_5":14087,"_26884":48960,"_2862":49029},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3376":298,"_29549":274,"_20523":49031,"_5":14087,"_26884":48964,"_2862":49032},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3376":299,"_29549":274,"_20523":49034,"_5":14087,"_26884":48964,"_2862":49035},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3376":300,"_29549":274,"_20523":49037,"_5":14087,"_26884":48968,"_2862":49038},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3376":301,"_29549":274,"_20523":49040,"_5":14087,"_26884":48968,"_2862":49041},[],"For the recommended design:",{"_3376":302,"_29549":274,"_20523":49043,"_5":14087,"_26884":48968,"_2862":49044},[],"Use only one externally exposed Lamassu Gateway.",{"_3376":303,"_29549":274,"_20523":49046,"_5":14087,"_26884":48968,"_2862":49047},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3376":304,"_29549":274,"_20523":49049,"_5":14087,"_26884":48968,"_2862":49050},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3376":305,"_29549":274,"_20523":49052,"_5":14087,"_26884":48968,"_2862":49053},[],"Point DNS at the VM's reachable address.",{"_3376":306,"_29549":274,"_20523":49055,"_5":14087,"_26884":48968,"_2862":49056},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3376":307,"_29549":274,"_20523":49058,"_5":14087,"_26884":48972,"_2862":49059},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3376":308,"_29549":274,"_20523":49061,"_5":14087,"_26884":48976,"_2862":49062},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3376":309,"_29549":274,"_20523":49064,"_5":14087,"_26884":48976,"_2862":49065},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3376":310,"_29549":274,"_20523":49067,"_5":14087,"_26884":48980,"_2862":49068},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3376":311,"_29549":274,"_20523":49070,"_5":14087,"_26884":48980,"_2862":49071},[],"Requirement",{"_3376":312,"_29549":274,"_20523":49073,"_5":14087,"_26884":48980,"_2862":49074},[],"Recommended design",{"_3376":313,"_29549":274,"_20523":49076,"_5":14087,"_26884":48980,"_2862":49077},[],"Consequence",{"_3376":314,"_29549":274,"_20523":49079,"_5":14087,"_26884":48980,"_2862":49080},[],"Several Lamassu URLs or services",{"_3376":315,"_29549":274,"_20523":49082,"_5":14087,"_26884":48980,"_2862":49083},[],"One Gateway with multiple routes",{"_3376":316,"_29549":274,"_20523":49085,"_5":14087,"_26884":48980,"_2862":49086},[],"One IP and one proxy fleet; this is the chart default",{"_3376":317,"_29549":274,"_20523":49088,"_5":14087,"_26884":48980,"_2862":49089},[],"Independent Gateways and separate external IPs",{"_3376":318,"_29549":274,"_20523":49091,"_5":14087,"_26884":48980,"_2862":49092},[],"One VIP per Gateway",{"_3376":319,"_29549":274,"_20523":49094,"_5":14087,"_26884":48980,"_2862":49095},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3376":320,"_29549":274,"_20523":49097,"_5":14087,"_26884":48980,"_2862":49098},[],"Independent Gateways on one node and one IP",{"_3376":321,"_29549":274,"_20523":49100,"_5":14087,"_26884":48980,"_2862":49101},[],"Use different external ports",{"_3376":322,"_29549":274,"_20523":49103,"_5":14087,"_26884":48980,"_2862":49104},[],"Clients must include non-standard ports",{"_3376":323,"_29549":274,"_20523":49106,"_5":14087,"_26884":48980,"_2862":49107},[],"Separate TLS/mTLS termination behind one IP",{"_3376":324,"_29549":274,"_20523":49109,"_5":14087,"_26884":48980,"_2862":49110},[],"Front-door SNI routing to internal Gateways",{"_3376":325,"_29549":274,"_20523":49112,"_5":14087,"_26884":48980,"_2862":49113},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3376":326,"_29549":274,"_20523":49115,"_5":14087,"_26884":48980,"_2862":49116},[],"Separate Gateway resources but shared proxy infrastructure",{"_3376":327,"_29549":274,"_20523":49118,"_5":14087,"_26884":48980,"_2862":49119},[],"Envoy merged-Gateway mode",{"_3376":328,"_29549":274,"_20523":49121,"_5":14087,"_26884":48980,"_2862":49122},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3376":329,"_29549":274,"_20523":49124,"_5":14087,"_26884":48980,"_2862":49125},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3376":330,"_29549":274,"_20523":49127,"_5":14087,"_26884":48980,"_2862":49128},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3376":331,"_29549":274,"_20523":49130,"_5":14087,"_26884":48980,"_2862":49131},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3376":332,"_29549":274,"_20523":49133,"_5":14087,"_26884":48980,"_2862":49134},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3376":333,"_29549":274,"_20523":49136,"_5":14087,"_26884":48984,"_2862":49137},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3376":334,"_29549":274,"_20523":49139,"_5":14087,"_26884":48984,"_2862":49140},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3376":335,"_29549":274,"_20523":49142,"_5":14087,"_26884":48984,"_2862":49143},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3376":336,"_29549":274,"_20523":49145,"_5":14087,"_26884":48984,"_2862":49146},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3376":337,"_29549":274,"_20523":49148,"_5":14087,"_26884":48984,"_2862":49149},[],"If none of those are possible, use different external ports or change the external network design.",{"_3376":338,"_29549":274,"_20523":49151,"_5":14087,"_26884":48988,"_2862":49152},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3376":339,"_29549":274,"_20523":49154,"_5":14087,"_26884":48988,"_2862":49155},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3376":340,"_29549":274,"_20523":49157,"_5":14087,"_26884":48992,"_2862":49158},[],"Check, in order:",{"_3376":341,"_29549":274,"_20523":49160,"_5":14087,"_26884":48992,"_2862":49161},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3376":342,"_29549":274,"_20523":49163,"_5":14087,"_26884":48992,"_2862":49164},[],"Its status contains the expected address.",{"_3376":343,"_29549":274,"_20523":49166,"_5":14087,"_26884":48992,"_2862":49167},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3376":344,"_29549":274,"_20523":49169,"_5":14087,"_26884":48992,"_2862":49170},[],"Port 443 reaches that address from the client network.",{"_3376":345,"_29549":274,"_20523":49172,"_5":14087,"_26884":48992,"_2862":49173},[],"DNS resolves to the externally reachable endpoint.",{"_3376":346,"_29549":274,"_20523":49175,"_5":14087,"_26884":48992,"_2862":49176},[],"The certificate contains the DNS name or IP used by the client.",{"_3376":347,"_29549":274,"_20523":49178,"_5":14087,"_26884":48992,"_2862":49179},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3376":348,"_29549":348,"_5":14445,"_2862":48250,"_29901":49181,"_20523":49182,"_26884":348},[48143,48144,48250],[],{"_3376":349,"_29549":348,"_20523":49184,"_5":14087,"_26884":348,"_2862":49185},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3376":350,"_29549":348,"_5":29898,"_20523":49187,"_26884":49188,"_2862":49189},[],"/docs/pr-preview/pr-52/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3376":351,"_29549":348,"_5":29898,"_20523":49191,"_26884":49192,"_2862":49193},[],"/docs/pr-preview/pr-52/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3376":352,"_29549":348,"_5":29898,"_20523":49195,"_26884":49196,"_2862":49197},[],"/docs/pr-preview/pr-52/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3376":353,"_29549":348,"_5":29898,"_20523":49199,"_26884":49200,"_2862":49201},[],"/docs/pr-preview/pr-52/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3376":354,"_29549":348,"_5":29898,"_20523":49203,"_26884":49204,"_2862":49205},[],"/docs/pr-preview/pr-52/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3376":355,"_29549":348,"_5":29898,"_20523":49207,"_26884":49208,"_2862":49209},[],"/docs/pr-preview/pr-52/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3376":356,"_29549":348,"_20523":49211,"_5":14087,"_26884":49188,"_2862":49212},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3376":357,"_29549":348,"_20523":49214,"_5":14087,"_26884":49192,"_2862":49215},[],"Workflow",{"_3376":358,"_29549":348,"_20523":49217,"_5":14087,"_26884":49192,"_2862":49218},[],"Use it for",{"_3376":359,"_29549":348,"_20523":49220,"_5":14087,"_26884":49192,"_2862":49221},[],"What it installs",{"_3376":360,"_29549":348,"_20523":49223,"_5":14087,"_26884":49192,"_2862":49224},[],"Helm",{"_3376":361,"_29549":348,"_20523":49226,"_5":14087,"_26884":49192,"_2862":49227},[],"Production and controlled environments",{"_3376":362,"_29549":348,"_20523":49229,"_5":14087,"_26884":49192,"_2862":49230},[],"Lamassu services and Gateway API resources",{"_3376":363,"_29549":348,"_20523":49232,"_5":14087,"_26884":49192,"_2862":48387},[],{"_3376":364,"_29549":348,"_20523":49234,"_5":14087,"_26884":49192,"_2862":49235},[],"Evaluation, demos, CI and small lab clusters",{"_3376":365,"_29549":348,"_20523":49237,"_5":14087,"_26884":49192,"_2862":49238},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3376":366,"_29549":348,"_20523":49240,"_5":14087,"_26884":49196,"_2862":49241},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3376":367,"_29549":348,"_20523":49243,"_5":14087,"_26884":49196,"_2862":49244},[],"Area",{"_3376":368,"_29549":348,"_20523":49246,"_5":14087,"_26884":49196,"_2862":49247},[],"The Lamassu chart provides",{"_3376":369,"_29549":348,"_20523":49249,"_5":14087,"_26884":49196,"_2862":49250},[],"You provide",{"_3376":370,"_29549":348,"_20523":49252,"_5":14087,"_26884":49196,"_2862":49253},[],"Lamassu applications",{"_3376":371,"_29549":348,"_20523":49255,"_5":14087,"_26884":49196,"_2862":49256},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3376":372,"_29549":348,"_20523":49258,"_5":14087,"_26884":49196,"_2862":49259},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3376":373,"_29549":348,"_20523":49261,"_5":14087,"_26884":49196,"_2862":49262},[],"PostgreSQL data",{"_3376":374,"_29549":348,"_20523":49264,"_5":14087,"_26884":49196,"_2862":49265},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3376":375,"_29549":348,"_20523":49267,"_5":14087,"_26884":49196,"_2862":49268},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3376":376,"_29549":348,"_20523":49270,"_5":14087,"_26884":49196,"_2862":49271},[],"Messaging",{"_3376":377,"_29549":348,"_20523":49273,"_5":14087,"_26884":49196,"_2862":49274},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3376":378,"_29549":348,"_20523":49276,"_5":14087,"_26884":49196,"_2862":49277},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3376":379,"_29549":348,"_20523":49279,"_5":14087,"_26884":49196,"_2862":49280},[],"Identity",{"_3376":380,"_29549":348,"_20523":49282,"_5":14087,"_26884":49196,"_2862":49283},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3376":381,"_29549":348,"_20523":49285,"_5":14087,"_26884":49196,"_2862":49286},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3376":382,"_29549":348,"_20523":49288,"_5":14087,"_26884":49196,"_2862":49289},[],"External routing",{"_3376":383,"_29549":348,"_20523":49291,"_5":14087,"_26884":49196,"_2862":49292},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3376":384,"_29549":348,"_20523":49294,"_5":14087,"_26884":49196,"_2862":49295},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3376":385,"_29549":348,"_20523":49297,"_5":14087,"_26884":49196,"_2862":49298},[],"TLS",{"_3376":386,"_29549":348,"_20523":49300,"_5":14087,"_26884":49196,"_2862":49301},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3376":387,"_29549":348,"_20523":49303,"_5":14087,"_26884":49196,"_2862":49304},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3376":388,"_29549":348,"_20523":49306,"_5":14087,"_26884":49196,"_2862":49307},[],"Persistent application data",{"_3376":389,"_29549":348,"_20523":49309,"_5":14087,"_26884":49196,"_2862":49310},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3376":390,"_29549":348,"_20523":49312,"_5":14087,"_26884":49196,"_2862":49313},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3376":391,"_29549":348,"_20523":49315,"_5":14087,"_26884":49196,"_2862":49316},[],"Optional integrations",{"_3376":392,"_29549":348,"_20523":49318,"_5":14087,"_26884":49196,"_2862":49319},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3376":393,"_29549":348,"_20523":49321,"_5":14087,"_26884":49196,"_2862":49322},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3376":394,"_29549":348,"_20523":49324,"_5":14087,"_26884":49196,"_2862":49325},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3376":395,"_29549":348,"_20523":49327,"_5":14087,"_26884":49196,"_2862":49328},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3376":396,"_29549":348,"_20523":49330,"_5":14087,"_26884":49200,"_2862":49331},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3376":397,"_29549":348,"_20523":49333,"_5":14087,"_26884":49200,"_2862":49334},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3376":398,"_29549":348,"_20523":49336,"_5":14087,"_26884":49204,"_2862":49337},[],"Kubernetes 1.24 or newer",{"_3376":399,"_29549":348,"_20523":49339,"_5":14087,"_26884":49204,"_2862":49340},[],"Helm 3.2 or newer",{"_3376":400,"_29549":348,"_20523":49342,"_5":14087,"_26884":49204,"_2862":49343},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3376":401,"_29549":348,"_20523":49345,"_5":14087,"_26884":49204,"_2862":49346},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3376":402,"_29549":348,"_20523":49348,"_5":14087,"_26884":49204,"_2862":49349},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3376":403,"_29549":348,"_20523":49351,"_5":14087,"_26884":49204,"_2862":49352},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3376":404,"_29549":348,"_20523":49354,"_5":14087,"_26884":49204,"_2862":49355},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3376":405,"_29549":348,"_20523":49357,"_5":14087,"_26884":49208,"_2862":49358},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3376":406,"_29549":348,"_20523":49360,"_5":14087,"_26884":49208,"_2862":49361},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3376":407,"_29549":348,"_20523":49363,"_5":14087,"_26884":49208,"_2862":49364},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3376":408,"_29549":348,"_20523":49366,"_5":14087,"_26884":49208,"_2862":49367},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3376":409,"_29549":409,"_5":14445,"_2862":49369,"_29901":49370,"_20523":49372,"_26884":409},"Deployment troubleshooting",[48143,48144,49371],"Operations",[],{"_3376":410,"_29549":409,"_20523":49374,"_5":14087,"_26884":409,"_2862":49375},[],"Diagnose access, service health and infrastructure dependencies.",{"_3376":411,"_29549":409,"_5":29898,"_20523":49377,"_26884":49378,"_2862":49379},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3376":412,"_29549":409,"_5":29898,"_20523":49381,"_26884":49382,"_2862":49383},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3376":413,"_29549":409,"_5":29898,"_20523":49385,"_26884":49386,"_2862":49387},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3376":414,"_29549":409,"_5":29898,"_20523":49389,"_26884":49390,"_2862":49391},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3376":415,"_29549":409,"_5":29898,"_20523":49393,"_26884":49394,"_2862":49395},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3376":416,"_29549":409,"_5":29898,"_20523":49397,"_26884":49398,"_2862":49399},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3376":417,"_29549":409,"_5":29898,"_20523":49401,"_26884":49402,"_2862":49403},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3376":418,"_29549":409,"_5":29898,"_20523":49405,"_26884":49406,"_2862":49407},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3376":419,"_29549":409,"_5":29898,"_20523":49409,"_26884":49410,"_2862":49411},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3376":420,"_29549":409,"_5":29898,"_20523":49413,"_26884":49414,"_2862":49415},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3376":421,"_29549":409,"_5":29898,"_20523":49417,"_26884":49418,"_2862":49419},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3376":422,"_29549":409,"_5":29898,"_20523":49421,"_26884":49422,"_2862":49423},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3376":423,"_29549":409,"_5":29898,"_20523":49425,"_26884":49426,"_2862":49427},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#observability","Observability",{"_3376":424,"_29549":409,"_20523":49429,"_5":14087,"_26884":409,"_2862":49430},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3376":425,"_29549":409,"_20523":49432,"_5":14087,"_26884":49382,"_2862":49433},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3376":426,"_29549":409,"_20523":49435,"_5":14087,"_26884":49386,"_2862":49436},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3376":427,"_29549":409,"_20523":49438,"_5":14087,"_26884":49390,"_2862":49439},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3376":428,"_29549":409,"_20523":49441,"_5":14087,"_26884":49394,"_2862":49442},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3376":429,"_29549":409,"_20523":49444,"_5":14087,"_26884":49398,"_2862":49445},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3376":430,"_29549":409,"_20523":49447,"_5":14087,"_26884":49402,"_2862":49448},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3376":431,"_29549":409,"_20523":49450,"_5":14087,"_26884":49402,"_2862":49451},[],"Also run the chart's connectivity test:",{"_3376":432,"_29549":409,"_20523":49453,"_5":14087,"_26884":49402,"_2862":49454},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3376":433,"_29549":409,"_20523":49456,"_5":14087,"_26884":49402,"_2862":49457},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3376":434,"_29549":409,"_20523":49459,"_5":14087,"_26884":49406,"_2862":49460},[],"If you receive a 401:",{"_3376":435,"_29549":409,"_20523":49462,"_5":14087,"_26884":49406,"_2862":49463},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3376":436,"_29549":409,"_20523":49465,"_5":14087,"_26884":49406,"_2862":49466},[],"verify issuer, audience and expiration of the token;",{"_3376":437,"_29549":409,"_20523":49468,"_5":14087,"_26884":49406,"_2862":49469},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3376":438,"_29549":409,"_20523":49471,"_5":14087,"_26884":49406,"_2862":49472},[],"check that the provider's public and internal routes point to the same realm.",{"_3376":439,"_29549":409,"_20523":49474,"_5":14087,"_26884":49406,"_2862":49475},[],"If login succeeds but the APIs return 403:",{"_3376":440,"_29549":409,"_20523":49477,"_5":14087,"_26884":49406,"_2862":49478},[],"inspect the token's real claims;",{"_3376":441,"_29549":409,"_20523":49480,"_5":14087,"_26884":49406,"_2862":49481},[],"confirm they match an active principal;",{"_3376":442,"_29549":409,"_20523":49483,"_5":14087,"_26884":49406,"_2862":49484},[],"review the policies granted to that principal;",{"_3376":443,"_29549":409,"_20523":49486,"_5":14087,"_26884":49406,"_2862":49487},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3376":444,"_29549":409,"_20523":49489,"_5":14087,"_26884":49406,"_2862":49490},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3376":445,"_29549":409,"_20523":49492,"_5":14087,"_26884":49410,"_2862":49493},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3376":446,"_29549":409,"_20523":49495,"_5":14087,"_26884":49410,"_2862":49496},[],"Locate the authz pod and Service.",{"_3376":447,"_29549":409,"_20523":49498,"_5":14087,"_26884":49410,"_2862":49499},[],"Check /health, logs and its database connection.",{"_3376":448,"_29549":409,"_20523":49501,"_5":14087,"_26884":49410,"_2862":49502},[],"Verify the DNS and port configured in externalAuthorization.",{"_3376":449,"_29549":409,"_20523":49504,"_5":14087,"_26884":49410,"_2862":49505},[],"Check the check route is /v1/ext\\_authz/check.",{"_3376":450,"_29549":409,"_20523":49507,"_5":14087,"_26884":49410,"_2862":49508},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3376":451,"_29549":409,"_20523":49510,"_5":14087,"_26884":49414,"_2862":49511},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3376":452,"_29549":409,"_20523":49513,"_5":14087,"_26884":49418,"_2862":49514},[],"Review kubectl describe pod first. Common causes are:",{"_3376":453,"_29549":409,"_20523":49516,"_5":14087,"_26884":49418,"_2862":49517},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3376":454,"_29549":409,"_20523":49519,"_5":14087,"_26884":49418,"_2862":49520},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3376":455,"_29549":409,"_20523":49522,"_5":14087,"_26884":49418,"_2862":49523},[],"unbound persistent volume;",{"_3376":456,"_29549":409,"_20523":49525,"_5":14087,"_26884":49418,"_2862":49526},[],"inaccessible image or incorrect pull policy;",{"_3376":457,"_29549":409,"_20523":49528,"_5":14087,"_26884":49418,"_2862":49529},[],"invalid cryptographic engine configuration;",{"_3376":458,"_29549":409,"_20523":49531,"_5":14087,"_26884":49418,"_2862":49532},[],"CPU or memory limits set too low;",{"_3376":459,"_29549":409,"_20523":49534,"_5":14087,"_26884":49418,"_2862":49535},[],"an incomplete prior migration.",{"_3376":460,"_29549":409,"_20523":49537,"_5":14087,"_26884":49418,"_2862":49538},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3376":461,"_29549":409,"_20523":49540,"_5":14087,"_26884":49418,"_2862":49541},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3376":462,"_29549":409,"_20523":49543,"_5":14087,"_26884":49418,"_2862":49544},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3376":463,"_29549":409,"_20523":49546,"_5":14087,"_26884":49422,"_2862":49547},[],"Domain and audit events depend on the bus publisher:",{"_3376":464,"_29549":409,"_20523":49549,"_5":14087,"_26884":49422,"_2862":49550},[],"verify it is enabled in the emitting service;",{"_3376":465,"_29549":409,"_20523":49552,"_5":14087,"_26884":49422,"_2862":49553},[],"check AMQP connectivity and credentials;",{"_3376":466,"_29549":409,"_20523":49555,"_5":14087,"_26884":49422,"_2862":49556},[],"review exchange, routing key, queues and consumers;",{"_3376":467,"_29549":409,"_20523":49558,"_5":14087,"_26884":49422,"_2862":49559},[],"inspect dead-letter queues;",{"_3376":468,"_29549":409,"_20523":49561,"_5":14087,"_26884":49422,"_2862":49562},[],"alert on orphan durable queues and backlog growth.",{"_3376":469,"_29549":409,"_20523":49564,"_5":14087,"_26884":49422,"_2862":49565},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3376":470,"_29549":409,"_20523":49567,"_5":14087,"_26884":49422,"_2862":49568},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3376":471,"_29549":409,"_20523":49570,"_5":14087,"_26884":49422,"_2862":49571},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3376":472,"_29549":409,"_20523":49573,"_5":14087,"_26884":49422,"_2862":49574},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3376":473,"_29549":409,"_20523":49576,"_5":14087,"_26884":49422,"_2862":49577},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3376":474,"_29549":409,"_20523":49579,"_5":14087,"_26884":49422,"_2862":49580},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3376":475,"_29549":409,"_20523":49582,"_5":14087,"_26884":49422,"_2862":49583},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3376":476,"_29549":409,"_20523":49585,"_5":14087,"_26884":49426,"_2862":49586},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3376":477,"_29549":409,"_20523":49588,"_5":14087,"_26884":49426,"_2862":49589},[],"Before closing an incident, record:",{"_3376":478,"_29549":409,"_20523":49591,"_5":14087,"_26884":49426,"_2862":49592},[],"the confirmed cause;",{"_3376":479,"_29549":409,"_20523":49594,"_5":14087,"_26884":49426,"_2862":49595},[],"the time scope and affected resources;",{"_3376":480,"_29549":409,"_20523":49597,"_5":14087,"_26884":49426,"_2862":49598},[],"the commands or queries used;",{"_3376":481,"_29549":409,"_20523":49600,"_5":14087,"_26884":49426,"_2862":49601},[],"the applied change and how to revert it;",{"_3376":482,"_29549":409,"_20523":49603,"_5":14087,"_26884":49426,"_2862":49604},[],"validation from a consumer;",{"_3376":483,"_29549":409,"_20523":49606,"_5":14087,"_26884":49426,"_2862":49607},[],"the preventive action and its owner.",{"_3376":484,"_29549":484,"_5":14445,"_2862":49609,"_29901":49610,"_20523":49613,"_26884":484},"Access control",[48143,49611,49612],"Platform","Administration",[],{"_3376":485,"_29549":484,"_20523":49615,"_5":14087,"_26884":484,"_2862":49616},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3376":486,"_29549":484,"_5":29898,"_20523":49618,"_26884":49619,"_2862":49620},[],"/docs/pr-preview/pr-52/platform/administration/access-control#essential-concepts","Essential concepts",{"_3376":487,"_29549":484,"_5":29898,"_20523":49622,"_26884":49623,"_2862":49624},[],"/docs/pr-preview/pr-52/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3376":488,"_29549":484,"_5":29898,"_20523":49626,"_26884":49627,"_2862":49628},[],"/docs/pr-preview/pr-52/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3376":489,"_29549":484,"_5":29898,"_20523":49630,"_26884":49631,"_2862":49632},[],"/docs/pr-preview/pr-52/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3376":490,"_29549":484,"_5":29898,"_20523":49634,"_26884":49635,"_2862":49636},[],"/docs/pr-preview/pr-52/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3376":491,"_29549":484,"_5":29898,"_20523":49638,"_26884":49639,"_2862":49640},[],"/docs/pr-preview/pr-52/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3376":492,"_29549":484,"_5":29898,"_20523":49642,"_26884":49643,"_2862":49644},[],"/docs/pr-preview/pr-52/platform/administration/access-control#oidc-principals","OIDC principals",{"_3376":493,"_29549":484,"_5":29898,"_20523":49646,"_26884":49647,"_2862":49648},[],"/docs/pr-preview/pr-52/platform/administration/access-control#x509-principals","X.509 principals",{"_3376":494,"_29549":484,"_5":29898,"_20523":49650,"_26884":49651,"_2862":49652},[],"/docs/pr-preview/pr-52/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3376":495,"_29549":484,"_5":29898,"_20523":49654,"_26884":49655,"_2862":49656},[],"/docs/pr-preview/pr-52/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3376":496,"_29549":484,"_5":29898,"_20523":49658,"_26884":49659,"_2862":49660},[],"/docs/pr-preview/pr-52/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3376":497,"_29549":484,"_5":29898,"_20523":49662,"_26884":49663,"_2862":49664},[],"/docs/pr-preview/pr-52/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3376":498,"_29549":484,"_5":29898,"_20523":49666,"_26884":49667,"_2862":49668},[],"/docs/pr-preview/pr-52/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3376":499,"_29549":484,"_5":29898,"_20523":49670,"_26884":49671,"_2862":49672},[],"/docs/pr-preview/pr-52/platform/administration/access-control#http-rules","HTTP rules",{"_3376":500,"_29549":484,"_5":29898,"_20523":49674,"_26884":49675,"_2862":49676},[],"/docs/pr-preview/pr-52/platform/administration/access-control#included-policies","Included policies",{"_3376":501,"_29549":484,"_5":29898,"_20523":49678,"_26884":49679,"_2862":48783},[],"/docs/pr-preview/pr-52/platform/administration/access-control#provision-the-first-administrator",{"_3376":502,"_29549":484,"_5":29898,"_20523":49681,"_26884":49682,"_2862":49683},[],"/docs/pr-preview/pr-52/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3376":503,"_29549":484,"_5":29898,"_20523":49685,"_26884":49686,"_2862":49687},[],"/docs/pr-preview/pr-52/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3376":504,"_29549":484,"_5":29898,"_20523":49689,"_26884":49690,"_2862":49691},[],"/docs/pr-preview/pr-52/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3376":505,"_29549":484,"_5":29898,"_20523":49693,"_26884":49694,"_2862":49695},[],"/docs/pr-preview/pr-52/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3376":506,"_29549":484,"_5":29898,"_20523":49697,"_26884":49698,"_2862":49699},[],"/docs/pr-preview/pr-52/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3376":507,"_29549":484,"_5":29898,"_20523":49701,"_26884":49702,"_2862":49703},[],"/docs/pr-preview/pr-52/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3376":508,"_29549":484,"_5":29898,"_20523":49705,"_26884":49706,"_2862":49707},[],"/docs/pr-preview/pr-52/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3376":509,"_29549":484,"_5":29898,"_20523":49709,"_26884":49710,"_2862":49711},[],"/docs/pr-preview/pr-52/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3376":510,"_29549":484,"_5":29898,"_20523":49713,"_26884":49714,"_2862":49715},[],"/docs/pr-preview/pr-52/platform/administration/access-control#operational-checklist","Operational checklist",{"_3376":511,"_29549":484,"_5":29898,"_20523":49717,"_26884":49718,"_2862":49719},[],"/docs/pr-preview/pr-52/platform/administration/access-control#diagnostics","Diagnostics",{"_3376":512,"_29549":484,"_5":29898,"_20523":49721,"_26884":49722,"_2862":49723},[],"/docs/pr-preview/pr-52/platform/administration/access-control#the-response-is-401","The response is 401",{"_3376":513,"_29549":484,"_5":29898,"_20523":49725,"_26884":49726,"_2862":49727},[],"/docs/pr-preview/pr-52/platform/administration/access-control#the-response-is-403","The response is 403",{"_3376":514,"_29549":484,"_5":29898,"_20523":49729,"_26884":49730,"_2862":49731},[],"/docs/pr-preview/pr-52/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3376":515,"_29549":484,"_5":29898,"_20523":49733,"_26884":49734,"_2862":49735},[],"/docs/pr-preview/pr-52/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3376":516,"_29549":484,"_5":29898,"_20523":49737,"_26884":49738,"_2862":49739},[],"/docs/pr-preview/pr-52/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3376":517,"_29549":484,"_20523":49741,"_5":14087,"_26884":484,"_2862":49742},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3376":518,"_29549":484,"_20523":49744,"_5":14087,"_26884":484,"_2862":49745},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3376":519,"_29549":484,"_20523":49747,"_5":14087,"_26884":484,"_2862":49748},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3376":520,"_29549":484,"_20523":49750,"_5":14087,"_26884":49619,"_2862":49751},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3376":521,"_29549":484,"_20523":49753,"_5":14087,"_26884":49619,"_2862":49754},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3376":522,"_29549":484,"_20523":49756,"_5":14087,"_26884":49619,"_2862":49757},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3376":523,"_29549":484,"_20523":49759,"_5":14087,"_26884":49619,"_2862":49760},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3376":524,"_29549":484,"_20523":49762,"_5":14087,"_26884":49619,"_2862":49763},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3376":525,"_29549":484,"_20523":49765,"_5":14087,"_26884":49619,"_2862":49766},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3376":526,"_29549":484,"_20523":49768,"_5":14087,"_26884":49623,"_2862":49769},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3376":527,"_29549":484,"_20523":49771,"_5":14087,"_26884":49623,"_2862":49772},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3376":528,"_29549":484,"_20523":49774,"_5":14087,"_26884":49627,"_2862":49775},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3376":529,"_29549":484,"_20523":49777,"_5":14087,"_26884":49627,"_2862":49778},[],"The decision is made **before forwarding the request to the service**:",{"_3376":530,"_29549":484,"_20523":49780,"_5":14087,"_26884":49627,"_2862":49781},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3376":531,"_29549":484,"_20523":49783,"_5":14087,"_26884":49627,"_2862":49784},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3376":532,"_29549":484,"_20523":49786,"_5":14087,"_26884":49627,"_2862":49787},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3376":533,"_29549":484,"_20523":49789,"_5":14087,"_26884":49627,"_2862":49790},[],"It separately loads the policies granted to each principal.",{"_3376":534,"_29549":484,"_20523":49792,"_5":14087,"_26884":49627,"_2862":49793},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3376":535,"_29549":484,"_20523":49795,"_5":14087,"_26884":49627,"_2862":49796},[],"`authz` looks for an HTTP rule granting that action.",{"_3376":536,"_29549":484,"_20523":49798,"_5":14087,"_26884":49627,"_2862":49799},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3376":537,"_29549":484,"_20523":49801,"_5":14087,"_26884":49627,"_2862":49802},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3376":538,"_29549":484,"_20523":49804,"_5":14087,"_26884":49627,"_2862":49805},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3376":539,"_29549":484,"_20523":49807,"_5":14087,"_26884":49627,"_2862":49808},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3376":540,"_29549":484,"_20523":49810,"_5":14087,"_26884":49631,"_2862":49811},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3376":541,"_29549":484,"_20523":49813,"_5":14087,"_26884":49631,"_2862":49814},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3376":542,"_29549":484,"_20523":49816,"_5":14087,"_26884":49631,"_2862":49817},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3376":543,"_29549":484,"_20523":49819,"_5":14087,"_26884":49631,"_2862":49820},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3376":544,"_29549":484,"_20523":49822,"_5":14087,"_26884":49631,"_2862":49823},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3376":545,"_29549":484,"_20523":49825,"_5":14087,"_26884":49631,"_2862":49826},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3376":546,"_29549":484,"_20523":49828,"_5":14087,"_26884":49631,"_2862":49829},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3376":547,"_29549":484,"_20523":49831,"_5":14087,"_26884":49631,"_2862":49832},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3376":548,"_29549":484,"_20523":49834,"_5":14087,"_26884":49635,"_2862":49835},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3376":549,"_29549":484,"_20523":49837,"_5":14087,"_26884":49635,"_2862":49838},[],"The decision is made with the domain operation context:",{"_3376":550,"_29549":484,"_20523":49840,"_5":14087,"_26884":49635,"_2862":49841},[],"The middleware extracts the credential and resolves the matching principals.",{"_3376":551,"_29549":484,"_20523":49843,"_5":14087,"_26884":49635,"_2862":49844},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3376":552,"_29549":484,"_20523":49846,"_5":14087,"_26884":49635,"_2862":49847},[],"`authz` gathers the entity rules of the granted policies.",{"_3376":553,"_29549":484,"_20523":49849,"_5":14087,"_26884":49635,"_2862":49850},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3376":554,"_29549":484,"_20523":49852,"_5":14087,"_26884":49635,"_2862":49853},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3376":555,"_29549":484,"_20523":49855,"_5":14087,"_26884":49635,"_2862":49856},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3376":556,"_29549":484,"_20523":49858,"_5":14087,"_26884":49635,"_2862":49859},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3376":557,"_29549":484,"_20523":49861,"_5":14087,"_26884":49635,"_2862":49862},[],"Actions fall into two groups:",{"_3376":558,"_29549":484,"_20523":49864,"_5":14087,"_26884":49635,"_2862":49865},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3376":559,"_29549":484,"_20523":49867,"_5":14087,"_26884":49635,"_2862":49868},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3376":560,"_29549":484,"_20523":49870,"_5":14087,"_26884":49635,"_2862":49871},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3376":561,"_29549":484,"_20523":49873,"_5":14087,"_26884":49639,"_2862":49874},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3376":562,"_29549":484,"_20523":49876,"_5":14087,"_26884":49639,"_2862":49877},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3376":563,"_29549":484,"_20523":49879,"_5":14087,"_26884":49639,"_2862":49880},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3376":564,"_29549":484,"_20523":49882,"_5":14087,"_26884":49643,"_2862":49883},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3376":565,"_29549":484,"_20523":49885,"_5":14087,"_26884":49643,"_2862":49886},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3376":566,"_29549":484,"_20523":49888,"_5":14087,"_26884":49643,"_2862":49889},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3376":567,"_29549":484,"_20523":49891,"_5":14087,"_26884":49643,"_2862":49892},[],"The implemented operators are:",{"_3376":568,"_29549":484,"_20523":49894,"_5":14087,"_26884":49643,"_2862":49895},[],"`equals`, for exact equality;",{"_3376":569,"_29549":484,"_20523":49897,"_5":14087,"_26884":49643,"_2862":49898},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3376":570,"_29549":484,"_20523":49900,"_5":14087,"_26884":49643,"_2862":49901},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3376":571,"_29549":484,"_20523":49903,"_5":14087,"_26884":49643,"_2862":49904},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3376":572,"_29549":484,"_20523":49906,"_5":14087,"_26884":49647,"_2862":49907},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3376":573,"_29549":484,"_20523":49909,"_5":14087,"_26884":49647,"_2862":49910},[],"The available modes are:",{"_3376":574,"_29549":484,"_20523":49912,"_5":14087,"_26884":49647,"_2862":49913},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3376":575,"_29549":484,"_20523":49915,"_5":14087,"_26884":49647,"_2862":49916},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3376":576,"_29549":484,"_20523":49918,"_5":14087,"_26884":49647,"_2862":49919},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3376":577,"_29549":484,"_20523":49921,"_5":14087,"_26884":49647,"_2862":49922},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3376":578,"_29549":484,"_20523":49924,"_5":14087,"_26884":49647,"_2862":49925},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3376":579,"_29549":484,"_20523":49927,"_5":14087,"_26884":49647,"_2862":49928},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3376":580,"_29549":484,"_20523":49930,"_5":14087,"_26884":49651,"_2862":49931},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3376":581,"_29549":484,"_20523":49933,"_5":14087,"_26884":49651,"_2862":49934},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3376":582,"_29549":484,"_20523":49936,"_5":14087,"_26884":49651,"_2862":49937},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3376":583,"_29549":484,"_20523":49939,"_5":14087,"_26884":49651,"_2862":49940},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3376":584,"_29549":484,"_20523":49942,"_5":14087,"_26884":49659,"_2862":49943},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3376":585,"_29549":484,"_20523":49945,"_5":14087,"_26884":49659,"_2862":49946},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3376":586,"_29549":484,"_20523":49948,"_5":14087,"_26884":49663,"_2862":49949},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3376":587,"_29549":484,"_20523":49951,"_5":14087,"_26884":49663,"_2862":49952},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3376":588,"_29549":484,"_20523":49954,"_5":14087,"_26884":49667,"_2862":49955},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3376":589,"_29549":484,"_20523":49957,"_5":14087,"_26884":49667,"_2862":49958},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3376":590,"_29549":484,"_20523":49960,"_5":14087,"_26884":49667,"_2862":49961},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3376":591,"_29549":484,"_20523":49963,"_5":14087,"_26884":49671,"_2862":49964},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3376":592,"_29549":484,"_20523":49966,"_5":14087,"_26884":49671,"_2862":49967},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3376":593,"_29549":484,"_20523":49969,"_5":14087,"_26884":49671,"_2862":49970},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3376":594,"_29549":484,"_20523":49972,"_5":14087,"_26884":49671,"_2862":49973},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3376":595,"_29549":484,"_20523":49975,"_5":14087,"_26884":49671,"_2862":49976},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3376":596,"_29549":484,"_20523":49978,"_5":14087,"_26884":49671,"_2862":49979},[],"Note that:",{"_3376":597,"_29549":484,"_20523":49981,"_5":14087,"_26884":49671,"_2862":49982},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3376":598,"_29549":484,"_20523":49984,"_5":14087,"_26884":49671,"_2862":49985},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3376":599,"_29549":484,"_20523":49987,"_5":14087,"_26884":49671,"_2862":49988},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3376":600,"_29549":484,"_20523":49990,"_5":14087,"_26884":49675,"_2862":49991},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3376":601,"_29549":484,"_20523":49993,"_5":14087,"_26884":49675,"_2862":49994},[],"full and read-only access to certificates and authorities;",{"_3376":602,"_29549":484,"_20523":49996,"_5":14087,"_26884":49675,"_2862":49997},[],"full and read-only access to the KMS;",{"_3376":603,"_29549":484,"_20523":49999,"_5":14087,"_26884":49675,"_2862":50000},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3376":604,"_29549":484,"_20523":50002,"_5":14087,"_26884":49675,"_2862":50003},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3376":605,"_29549":484,"_20523":50005,"_5":14087,"_26884":49675,"_2862":50006},[],"console access;",{"_3376":606,"_29549":484,"_20523":50008,"_5":14087,"_26884":49675,"_2862":50009},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3376":607,"_29549":484,"_20523":50011,"_5":14087,"_26884":49675,"_2862":50012},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3376":608,"_29549":484,"_20523":50014,"_5":14087,"_26884":49675,"_2862":50015},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3376":609,"_29549":484,"_20523":50017,"_5":14087,"_26884":49679,"_2862":50018},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3376":610,"_29549":484,"_20523":50020,"_5":14087,"_26884":49679,"_2862":50021},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3376":611,"_29549":484,"_20523":50023,"_5":14087,"_26884":49679,"_2862":50024},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3376":612,"_29549":484,"_20523":50026,"_5":14087,"_26884":49682,"_2862":50027},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3376":613,"_29549":484,"_20523":50029,"_5":14087,"_26884":49686,"_2862":50030},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3376":614,"_29549":484,"_20523":50032,"_5":14087,"_26884":49686,"_2862":50033},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3376":615,"_29549":484,"_20523":50035,"_5":14087,"_26884":49690,"_2862":50036},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3376":616,"_29549":484,"_20523":50038,"_5":14087,"_26884":49694,"_2862":50039},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3376":617,"_29549":484,"_20523":50041,"_5":14087,"_26884":49698,"_2862":50042},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3376":618,"_29549":484,"_20523":50044,"_5":14087,"_26884":49702,"_2862":50045},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3376":619,"_29549":484,"_20523":50047,"_5":14087,"_26884":49702,"_2862":50048},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3376":620,"_29549":484,"_20523":50050,"_5":14087,"_26884":49706,"_2862":50051},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3376":621,"_29549":484,"_20523":50053,"_5":14087,"_26884":49706,"_2862":50054},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3376":622,"_29549":484,"_20523":50056,"_5":14087,"_26884":49706,"_2862":50057},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3376":623,"_29549":484,"_20523":50059,"_5":14087,"_26884":49706,"_2862":50060},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3376":624,"_29549":484,"_20523":50062,"_5":14087,"_26884":49706,"_2862":50063},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3376":625,"_29549":484,"_20523":50065,"_5":14087,"_26884":49706,"_2862":50066},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3376":626,"_29549":484,"_20523":50068,"_5":14087,"_26884":49706,"_2862":50069},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3376":627,"_29549":484,"_20523":50071,"_5":14087,"_26884":49706,"_2862":50072},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3376":628,"_29549":484,"_20523":50074,"_5":14087,"_26884":49710,"_2862":50075},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3376":629,"_29549":484,"_20523":50077,"_5":14087,"_26884":49710,"_2862":50078},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3376":630,"_29549":484,"_20523":50080,"_5":14087,"_26884":49710,"_2862":50081},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3376":631,"_29549":484,"_20523":50083,"_5":14087,"_26884":49714,"_2862":50084},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3376":632,"_29549":484,"_20523":50086,"_5":14087,"_26884":49714,"_2862":50087},[],"Use groups or stable roles for people and independent identities for automations.",{"_3376":633,"_29549":484,"_20523":50089,"_5":14087,"_26884":49714,"_2862":50090},[],"Keep at least two recovery administrators and test their access periodically.",{"_3376":634,"_29549":484,"_20523":50092,"_5":14087,"_26884":49714,"_2862":50093},[],"Review active principals, their matches and their grants after IdP changes.",{"_3376":635,"_29549":484,"_20523":50095,"_5":14087,"_26884":49714,"_2862":50096},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3376":636,"_29549":484,"_20523":50098,"_5":14087,"_26884":49714,"_2862":50099},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3376":637,"_29549":484,"_20523":50101,"_5":14087,"_26884":49714,"_2862":50102},[],"Always test one allowed and one denied operation for each role.",{"_3376":638,"_29549":484,"_20523":50104,"_5":14087,"_26884":49714,"_2862":50105},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3376":639,"_29549":484,"_20523":50107,"_5":14087,"_26884":49722,"_2862":50108},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3376":640,"_29549":484,"_20523":50110,"_5":14087,"_26884":49726,"_2862":50111},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3376":641,"_29549":484,"_20523":50113,"_5":14087,"_26884":49726,"_2862":50114},[],"that an active principal of the correct type exists;",{"_3376":642,"_29549":484,"_20523":50116,"_5":14087,"_26884":49726,"_2862":50117},[],"that the claim paths and values match the real token exactly;",{"_3376":643,"_29549":484,"_20523":50119,"_5":14087,"_26884":49726,"_2862":50120},[],"that all of the principal's conditions hold;",{"_3376":644,"_29549":484,"_20523":50122,"_5":14087,"_26884":49726,"_2862":50123},[],"that the principal has the expected policy granted;",{"_3376":645,"_29549":484,"_20523":50125,"_5":14087,"_26884":49726,"_2862":50126},[],"that the policy includes the action and the requested resource type or route;",{"_3376":646,"_29549":484,"_20523":50128,"_5":14087,"_26884":49726,"_2862":50129},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3376":647,"_29549":484,"_20523":50131,"_5":14087,"_26884":49726,"_2862":50132},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3376":648,"_29549":484,"_20523":50134,"_5":14087,"_26884":49730,"_2862":50135},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3376":649,"_29549":484,"_20523":50137,"_5":14087,"_26884":49734,"_2862":50138},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3376":650,"_29549":484,"_20523":50140,"_5":14087,"_26884":49738,"_2862":50141},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3376":651,"_29549":484,"_20523":50143,"_5":14087,"_26884":49738,"_2862":50144},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3376":652,"_29549":652,"_5":14445,"_2862":50146,"_29901":50147,"_20523":50148,"_26884":652},"Alerts and subscriptions",[48143,49611,49612],[],{"_3376":653,"_29549":652,"_20523":50150,"_5":14087,"_26884":652,"_2862":50151},[],"Send PKI events to people and external systems.",{"_3376":654,"_29549":652,"_5":29898,"_20523":50153,"_26884":50154,"_2862":50155},[],"/docs/pr-preview/pr-52/platform/administration/alerts#how-it-works","How it works",{"_3376":655,"_29549":652,"_5":29898,"_20523":50157,"_26884":50158,"_2862":50159},[],"/docs/pr-preview/pr-52/platform/administration/alerts#available-channels","Available channels",{"_3376":656,"_29549":652,"_5":29898,"_20523":50161,"_26884":50162,"_2862":50163},[],"/docs/pr-preview/pr-52/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3376":657,"_29549":652,"_5":29898,"_20523":50165,"_26884":50166,"_2862":50167},[],"/docs/pr-preview/pr-52/platform/administration/alerts#choose-the-event","Choose the event",{"_3376":658,"_29549":652,"_5":29898,"_20523":50169,"_26884":50170,"_2862":50171},[],"/docs/pr-preview/pr-52/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3376":659,"_29549":652,"_5":29898,"_20523":50173,"_26884":50174,"_2862":50175},[],"/docs/pr-preview/pr-52/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3376":660,"_29549":652,"_5":29898,"_20523":50177,"_26884":50178,"_2862":50179},[],"/docs/pr-preview/pr-52/platform/administration/alerts#review-and-activate","Review and activate",{"_3376":661,"_29549":652,"_5":29898,"_20523":50181,"_26884":50182,"_2862":50183},[],"/docs/pr-preview/pr-52/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3376":662,"_29549":652,"_5":29898,"_20523":50185,"_26884":50186,"_2862":50187},[],"/docs/pr-preview/pr-52/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3376":663,"_29549":652,"_5":29898,"_20523":50189,"_26884":50190,"_2862":50191},[],"/docs/pr-preview/pr-52/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3376":664,"_29549":652,"_5":29898,"_20523":50193,"_26884":50194,"_2862":50195},[],"/docs/pr-preview/pr-52/platform/administration/alerts#event-families","Event families",{"_3376":665,"_29549":652,"_20523":50197,"_5":14087,"_26884":652,"_2862":50198},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3376":666,"_29549":652,"_20523":50200,"_5":14087,"_26884":50154,"_2862":50201},[],"A service publishes a domain event.",{"_3376":667,"_29549":652,"_20523":50203,"_5":14087,"_26884":50154,"_2862":50204},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3376":668,"_29549":652,"_20523":50206,"_5":14087,"_26884":50154,"_2862":50207},[],"Each subscription's filter decides whether it should be notified.",{"_3376":669,"_29549":652,"_20523":50209,"_5":14087,"_26884":50154,"_2862":50210},[],"Lamassu delivers the event to the configured channel.",{"_3376":670,"_29549":652,"_20523":50212,"_5":14087,"_26884":50154,"_2862":50213},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3376":671,"_29549":652,"_20523":50215,"_5":14087,"_26884":50158,"_2862":50216},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3376":672,"_29549":652,"_20523":50218,"_5":14087,"_26884":50158,"_2862":50219},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3376":673,"_29549":652,"_20523":50221,"_5":14087,"_26884":50158,"_2862":50222},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3376":674,"_29549":652,"_20523":50224,"_5":14087,"_26884":50158,"_2862":50225},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3376":675,"_29549":652,"_20523":50227,"_5":14087,"_26884":50158,"_2862":50228},[],"`apikey_options` requires `header` and `key`.",{"_3376":676,"_29549":652,"_20523":50230,"_5":14087,"_26884":50158,"_2862":50231},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3376":677,"_29549":652,"_20523":50233,"_5":14087,"_26884":50158,"_2862":50234},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3376":678,"_29549":652,"_20523":50236,"_5":14087,"_26884":50158,"_2862":50237},[],"The alerts API reference documents the full `http_client` schema.",{"_3376":679,"_29549":652,"_20523":50239,"_5":14087,"_26884":50166,"_2862":50240},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3376":680,"_29549":652,"_20523":50242,"_5":14087,"_26884":50170,"_2862":50243},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3376":681,"_29549":652,"_20523":50245,"_5":14087,"_26884":50174,"_2862":50246},[],"Add a filter if you don't want to receive every instance of the event.",{"_3376":682,"_29549":652,"_20523":50248,"_5":14087,"_26884":50174,"_2862":50249},[],"**None** notifies all instances of the event.",{"_3376":683,"_29549":652,"_20523":50251,"_5":14087,"_26884":50174,"_2862":50252},[],"**JSON Path** evaluates one or more specific fields.",{"_3376":684,"_29549":652,"_20523":50254,"_5":14087,"_26884":50174,"_2862":50255},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3376":685,"_29549":652,"_20523":50257,"_5":14087,"_26884":50174,"_2862":50258},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3376":686,"_29549":652,"_20523":50260,"_5":14087,"_26884":50174,"_2862":50261},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3376":687,"_29549":652,"_20523":50263,"_5":14087,"_26884":50174,"_2862":50264},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3376":688,"_29549":652,"_20523":50266,"_5":14087,"_26884":50178,"_2862":50267},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3376":689,"_29549":652,"_20523":50269,"_5":14087,"_26884":50182,"_2862":50270},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3376":690,"_29549":652,"_20523":50272,"_5":14087,"_26884":50182,"_2862":50273},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3376":691,"_29549":652,"_20523":50275,"_5":14087,"_26884":50182,"_2862":50276},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3376":692,"_29549":652,"_20523":50278,"_5":14087,"_26884":50182,"_2862":50279},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3376":693,"_29549":652,"_20523":50281,"_5":14087,"_26884":50182,"_2862":50282},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3376":694,"_29549":652,"_20523":50284,"_5":14087,"_26884":50182,"_2862":50285},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3376":695,"_29549":652,"_20523":50287,"_5":14087,"_26884":50182,"_2862":50288},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3376":696,"_29549":652,"_20523":50290,"_5":14087,"_26884":50182,"_2862":50291},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3376":697,"_29549":652,"_20523":50293,"_5":14087,"_26884":50186,"_2862":50294},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3376":698,"_29549":652,"_20523":50296,"_5":14087,"_26884":50186,"_2862":50297},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3376":699,"_29549":652,"_20523":50299,"_5":14087,"_26884":50186,"_2862":50300},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3376":700,"_29549":652,"_20523":50302,"_5":14087,"_26884":50186,"_2862":50303},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3376":701,"_29549":652,"_20523":50305,"_5":14087,"_26884":50186,"_2862":50306},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3376":702,"_29549":652,"_20523":50308,"_5":14087,"_26884":50186,"_2862":50309},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3376":703,"_29549":652,"_20523":50311,"_5":14087,"_26884":50186,"_2862":50312},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3376":704,"_29549":652,"_20523":50314,"_5":14087,"_26884":50186,"_2862":50315},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3376":705,"_29549":652,"_20523":50317,"_5":14087,"_26884":50190,"_2862":50318},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3376":706,"_29549":652,"_20523":50320,"_5":14087,"_26884":50190,"_2862":50321},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3376":707,"_29549":652,"_20523":50323,"_5":14087,"_26884":50194,"_2862":50324},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3376":708,"_29549":652,"_20523":50326,"_5":14087,"_26884":50194,"_2862":50327},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3376":709,"_29549":652,"_20523":50329,"_5":14087,"_26884":50194,"_2862":50330},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3376":710,"_29549":652,"_20523":50332,"_5":14087,"_26884":50194,"_2862":50333},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3376":711,"_29549":652,"_20523":50335,"_5":14087,"_26884":50194,"_2862":50336},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3376":712,"_29549":652,"_20523":50338,"_5":14087,"_26884":50194,"_2862":50339},[],"**Validation:** `va.role.crl.create`.",{"_3376":713,"_29549":652,"_20523":50341,"_5":14087,"_26884":50194,"_2862":50342},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3376":714,"_29549":652,"_20523":50344,"_5":14087,"_26884":50194,"_2862":50345},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3376":715,"_29549":715,"_5":14445,"_2862":50347,"_29901":50348,"_20523":50349,"_26884":715},"Audit logs",[48143,49611,49612],[],{"_3376":716,"_29549":715,"_20523":50351,"_5":14087,"_26884":715,"_2862":50352},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3376":717,"_29549":715,"_5":29898,"_20523":50354,"_26884":50355,"_2862":50356},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3376":718,"_29549":715,"_5":29898,"_20523":50358,"_26884":50359,"_2862":50360},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#coverage","Coverage",{"_3376":719,"_29549":715,"_5":29898,"_20523":50362,"_26884":50363,"_2862":50364},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3376":720,"_29549":715,"_5":29898,"_20523":50366,"_26884":50367,"_2862":50368},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3376":721,"_29549":715,"_5":29898,"_20523":50370,"_26884":50371,"_2862":50372},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3376":722,"_29549":715,"_5":29898,"_20523":50374,"_26884":50375,"_2862":50376},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3376":723,"_29549":715,"_5":29898,"_20523":50378,"_26884":50379,"_2862":50380},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3376":724,"_29549":715,"_5":29898,"_20523":50382,"_26884":50383,"_2862":50384},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3376":725,"_29549":715,"_5":29898,"_20523":50386,"_26884":50387,"_2862":50388},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3376":726,"_29549":715,"_5":29898,"_20523":50390,"_26884":50391,"_2862":50392},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3376":727,"_29549":715,"_5":29898,"_20523":50394,"_26884":50395,"_2862":50396},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3376":728,"_29549":715,"_20523":50398,"_5":14087,"_26884":715,"_2862":50399},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3376":729,"_29549":715,"_20523":50401,"_5":14087,"_26884":50355,"_2862":50402},[],"The audit body includes:",{"_3376":730,"_29549":715,"_20523":50404,"_5":14087,"_26884":50355,"_2862":50405},[],"input: data received by the operation;",{"_3376":731,"_29549":715,"_20523":50407,"_5":14087,"_26884":50355,"_2862":50408},[],"has\\_error: whether the service returned an error;",{"_3376":732,"_29549":715,"_20523":50410,"_5":14087,"_26884":50355,"_2862":50411},[],"output: produced result or error message;",{"_3376":733,"_29549":715,"_20523":50413,"_5":14087,"_26884":50355,"_2862":50414},[],"principals: identifiers of the principals that matched the request.",{"_3376":734,"_29549":715,"_20523":50416,"_5":14087,"_26884":50355,"_2862":50417},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3376":735,"_29549":715,"_20523":50419,"_5":14087,"_26884":50355,"_2862":50420},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3376":736,"_29549":715,"_20523":50422,"_5":14087,"_26884":50359,"_2862":50423},[],"The backend applies auditing to mutations of:",{"_3376":737,"_29549":715,"_20523":50425,"_5":14087,"_26884":50359,"_2862":50426},[],"authorities, certificates and issuance profiles;",{"_3376":738,"_29549":715,"_20523":50428,"_5":14087,"_26884":50359,"_2862":50429},[],"keys and KMS engines;",{"_3376":739,"_29549":715,"_20523":50431,"_5":14087,"_26884":50359,"_2862":50432},[],"devices and identities;",{"_3376":740,"_29549":715,"_20523":50434,"_5":14087,"_26884":50359,"_2862":50435},[],"DMSs and enrollment operations;",{"_3376":741,"_29549":715,"_20523":50437,"_5":14087,"_26884":50359,"_2862":50438},[],"validation functions and CRL;",{"_3376":742,"_29549":715,"_20523":50440,"_5":14087,"_26884":50359,"_2862":50441},[],"principals, policies and authorization grants.",{"_3376":743,"_29549":715,"_20523":50443,"_5":14087,"_26884":50359,"_2862":50444},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3376":744,"_29549":715,"_20523":50446,"_5":14087,"_26884":50363,"_2862":50447},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3376":745,"_29549":715,"_20523":50449,"_5":14087,"_26884":50363,"_2862":50450},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3376":746,"_29549":715,"_20523":50452,"_5":14087,"_26884":50363,"_2862":50453},[],"Design the consumer to:",{"_3376":747,"_29549":715,"_20523":50455,"_5":14087,"_26884":50363,"_2862":50456},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3376":748,"_29549":715,"_20523":50458,"_5":14087,"_26884":50363,"_2862":50459},[],"keep the complete CloudEvent unmodified;",{"_3376":749,"_29549":715,"_20523":50461,"_5":14087,"_26884":50363,"_2862":50462},[],"record the ingestion time and detect duplicates by ID;",{"_3376":750,"_29549":715,"_20523":50464,"_5":14087,"_26884":50363,"_2862":50465},[],"encrypt in transit and at rest;",{"_3376":751,"_29549":715,"_20523":50467,"_5":14087,"_26884":50363,"_2862":50468},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3376":752,"_29549":715,"_20523":50470,"_5":14087,"_26884":50363,"_2862":50471},[],"apply an explicit retention and legal hold policy;",{"_3376":753,"_29549":715,"_20523":50473,"_5":14087,"_26884":50363,"_2862":50474},[],"alert if it stops consuming or the pending queue grows.",{"_3376":754,"_29549":715,"_20523":50476,"_5":14087,"_26884":50367,"_2862":50477},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3376":755,"_29549":715,"_20523":50479,"_5":14087,"_26884":50367,"_2862":50480},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3376":756,"_29549":715,"_20523":50482,"_5":14087,"_26884":50375,"_2862":50483},[],"Start from the reported time and normalize every source to UTC.",{"_3376":757,"_29549":715,"_20523":50485,"_5":14087,"_26884":50379,"_2862":50486},[],"Filter by event type, service source and resource identifier.",{"_3376":758,"_29549":715,"_20523":50488,"_5":14087,"_26884":50383,"_2862":50489},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3376":759,"_29549":715,"_20523":50491,"_5":14087,"_26884":50387,"_2862":50492},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3376":760,"_29549":715,"_20523":50494,"_5":14087,"_26884":50391,"_2862":50495},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3376":761,"_29549":715,"_20523":50497,"_5":14087,"_26884":50395,"_2862":50498},[],"Generate a controlled mutation in a test environment and check that:",{"_3376":762,"_29549":715,"_20523":50500,"_5":14087,"_26884":50395,"_2862":50501},[],"a successful audit event appears;",{"_3376":763,"_29549":715,"_20523":50503,"_5":14087,"_26884":50395,"_2862":50504},[],"the principal matches the identity used;",{"_3376":764,"_29549":715,"_20523":50506,"_5":14087,"_26884":50395,"_2862":50507},[],"the consumer persists it exactly once;",{"_3376":765,"_29549":715,"_20523":50509,"_5":14087,"_26884":50395,"_2862":50510},[],"it can be retrieved by resource, actor and period;",{"_3376":766,"_29549":715,"_20523":50512,"_5":14087,"_26884":50395,"_2862":50513},[],"a consumer outage raises an alert.",{"_3376":767,"_29549":715,"_20523":50515,"_5":14087,"_26884":50395,"_2862":50516},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3376":768,"_29549":768,"_5":14445,"_2862":50518,"_29901":50519,"_20523":50520,"_26884":768},"Platform architecture",[48143,49611],[],{"_3376":769,"_29549":768,"_20523":50522,"_5":14087,"_26884":768,"_2862":50523},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3376":770,"_29549":768,"_5":29898,"_20523":50525,"_26884":50526,"_2862":50527},[],"/docs/pr-preview/pr-52/platform/concepts/architecture#control-plane","Control plane",{"_3376":771,"_29549":768,"_5":29898,"_20523":50529,"_26884":50530,"_2862":50531},[],"/docs/pr-preview/pr-52/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3376":772,"_29549":768,"_5":29898,"_20523":50533,"_26884":50534,"_2862":50535},[],"/docs/pr-preview/pr-52/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3376":773,"_29549":768,"_5":29898,"_20523":50537,"_26884":50538,"_2862":50539},[],"/docs/pr-preview/pr-52/platform/concepts/architecture#status-and-validation","Status and validation",{"_3376":774,"_29549":768,"_5":29898,"_20523":50541,"_26884":50542,"_2862":50543},[],"/docs/pr-preview/pr-52/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3376":775,"_29549":768,"_20523":50545,"_5":14087,"_26884":768,"_2862":50546},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3376":776,"_29549":768,"_20523":50548,"_5":14087,"_26884":768,"_2862":50549},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3376":777,"_29549":768,"_20523":50551,"_5":14087,"_26884":50526,"_2862":50552},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3376":778,"_29549":768,"_20523":50554,"_5":14087,"_26884":50530,"_2862":50555},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3376":779,"_29549":768,"_20523":50557,"_5":14087,"_26884":50534,"_2862":50558},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3376":780,"_29549":768,"_20523":50560,"_5":14087,"_26884":50538,"_2862":50561},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3376":781,"_29549":768,"_20523":50563,"_5":14087,"_26884":50542,"_2862":50564},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3376":782,"_29549":782,"_5":14445,"_2862":50566,"_29901":50567,"_20523":50568,"_26884":782},"How Lamassu works",[48143,49611],[],{"_3376":783,"_29549":782,"_20523":50570,"_5":14087,"_26884":782,"_2862":50571},[],"The mental model of trust, keys, certificates and devices.",{"_3376":784,"_29549":782,"_5":29898,"_20523":50573,"_26884":50574,"_2862":50575},[],"/docs/pr-preview/pr-52/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3376":785,"_29549":782,"_5":29898,"_20523":50577,"_26884":50578,"_2862":50579},[],"/docs/pr-preview/pr-52/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3376":786,"_29549":782,"_20523":50581,"_5":14087,"_26884":782,"_2862":50582},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3376":787,"_29549":782,"_20523":50584,"_5":14087,"_26884":50574,"_2862":50585},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3376":788,"_29549":782,"_20523":50587,"_5":14087,"_26884":50574,"_2862":50588},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3376":789,"_29549":782,"_20523":50590,"_5":14087,"_26884":50574,"_2862":50591},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3376":790,"_29549":782,"_20523":50593,"_5":14087,"_26884":50574,"_2862":50594},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3376":791,"_29549":782,"_20523":50596,"_5":14087,"_26884":50574,"_2862":50597},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3376":792,"_29549":782,"_20523":50599,"_5":14087,"_26884":50578,"_2862":50600},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3376":793,"_29549":782,"_20523":50602,"_5":14087,"_26884":50578,"_2862":50603},[],"A DMS relates that CA to an enrollment policy.",{"_3376":794,"_29549":782,"_20523":50605,"_5":14087,"_26884":50578,"_2862":50606},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3376":795,"_29549":782,"_20523":50608,"_5":14087,"_26884":50578,"_2862":50609},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3376":796,"_29549":782,"_20523":50611,"_5":14087,"_26884":50578,"_2862":50612},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3376":797,"_29549":782,"_20523":50614,"_5":14087,"_26884":50578,"_2862":50615},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3376":798,"_29549":782,"_20523":50617,"_5":14087,"_26884":50578,"_2862":50618},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3376":799,"_29549":799,"_5":14445,"_2862":50620,"_29901":50621,"_20523":50623,"_26884":799},"Devices and identities",[48143,49611,50622,50620],"IoT Fleets",[],{"_3376":800,"_29549":799,"_20523":50625,"_5":14087,"_26884":799,"_2862":50626},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3376":801,"_29549":799,"_5":29898,"_20523":50628,"_26884":50629,"_2862":50630},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#device-states","Device states",{"_3376":802,"_29549":799,"_5":29898,"_20523":50632,"_26884":50633,"_2862":50634},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3376":803,"_29549":799,"_5":29898,"_20523":50636,"_26884":50637,"_2862":50638},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3376":804,"_29549":799,"_5":29898,"_20523":50640,"_26884":50641,"_2862":50642},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3376":805,"_29549":799,"_5":29898,"_20523":50644,"_26884":50645,"_2862":50646},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3376":806,"_29549":799,"_5":29898,"_20523":50648,"_26884":50649,"_2862":50650},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3376":807,"_29549":799,"_5":29898,"_20523":50652,"_26884":50653,"_2862":50654},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3376":808,"_29549":799,"_5":29898,"_20523":50656,"_26884":50657,"_2862":50658},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3376":809,"_29549":799,"_5":29898,"_20523":50660,"_26884":50661,"_2862":50662},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3376":810,"_29549":799,"_5":29898,"_20523":50664,"_26884":50665,"_2862":50666},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3376":811,"_29549":799,"_5":29898,"_20523":50668,"_26884":50669,"_2862":50670},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3376":812,"_29549":799,"_20523":50672,"_5":14087,"_26884":799,"_2862":50673},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3376":813,"_29549":799,"_20523":50675,"_5":14087,"_26884":799,"_2862":50676},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3376":814,"_29549":799,"_20523":50678,"_5":14087,"_26884":50629,"_2862":50679},[],"Operational view",{"_3376":815,"_29549":799,"_20523":50681,"_5":14087,"_26884":50629,"_2862":50682},[],"Meaning",{"_3376":816,"_29549":799,"_20523":50684,"_5":14087,"_26884":50629,"_2862":50685},[],"**No Identity**",{"_3376":817,"_29549":799,"_20523":50687,"_5":14087,"_26884":50629,"_2862":50688},[],"A record exists without an associated identity.",{"_3376":818,"_29549":799,"_20523":50690,"_5":14087,"_26884":50629,"_2862":50691},[],"**Active**",{"_3376":819,"_29549":799,"_20523":50693,"_5":14087,"_26884":50629,"_2862":50694},[],"The slot is active; also check certificate dates, status and usages.",{"_3376":820,"_29549":799,"_20523":50696,"_5":14087,"_26884":50629,"_2862":50697},[],"**Renewal Pending**",{"_3376":821,"_29549":799,"_20523":50699,"_5":14087,"_26884":50629,"_2862":50700},[],"The identity is in the operational renewal window.",{"_3376":822,"_29549":799,"_20523":50702,"_5":14087,"_26884":50629,"_2862":50703},[],"**Expiring Soon**",{"_3376":823,"_29549":799,"_20523":50705,"_5":14087,"_26884":50629,"_2862":50706},[],"Expiration is approaching according to configured thresholds.",{"_3376":824,"_29549":799,"_20523":50708,"_5":14087,"_26884":50629,"_2862":50709},[],"**Expired**",{"_3376":825,"_29549":799,"_20523":50711,"_5":14087,"_26884":50629,"_2862":50712},[],"The identity has expired.",{"_3376":826,"_29549":799,"_20523":50714,"_5":14087,"_26884":50629,"_2862":50715},[],"**Revoked**",{"_3376":827,"_29549":799,"_20523":50717,"_5":14087,"_26884":50629,"_2862":50718},[],"The identity is marked revoked.",{"_3376":828,"_29549":799,"_20523":50720,"_5":14087,"_26884":50629,"_2862":50721},[],"**Decommissioned**",{"_3376":829,"_29549":799,"_20523":50723,"_5":14087,"_26884":50629,"_2862":50724},[],"The record is retired and ordinary updates do not restore operation.",{"_3376":830,"_29549":799,"_20523":50726,"_5":14087,"_26884":50629,"_2862":50727},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3376":831,"_29549":799,"_20523":50729,"_5":14087,"_26884":50633,"_2862":50730},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3376":832,"_29549":799,"_20523":50732,"_5":14087,"_26884":50633,"_2862":50733},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3376":833,"_29549":799,"_20523":50735,"_5":14087,"_26884":50633,"_2862":50736},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3376":834,"_29549":799,"_20523":50738,"_5":14087,"_26884":50633,"_2862":50739},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3376":835,"_29549":799,"_20523":50741,"_5":14087,"_26884":50637,"_2862":50742},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3376":836,"_29549":799,"_20523":50744,"_5":14087,"_26884":50641,"_2862":50745},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3376":837,"_29549":799,"_20523":50747,"_5":14087,"_26884":50645,"_2862":50748},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3376":838,"_29549":799,"_20523":50750,"_5":14087,"_26884":50649,"_2862":50751},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3376":839,"_29549":799,"_20523":50753,"_5":14087,"_26884":50653,"_2862":50754},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3376":840,"_29549":799,"_20523":50756,"_5":14087,"_26884":50653,"_2862":50757},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3376":841,"_29549":799,"_20523":50759,"_5":14087,"_26884":50657,"_2862":50760},[],"From **No Identity**, use **Assign Identity**:",{"_3376":842,"_29549":799,"_20523":50762,"_5":14087,"_26884":50657,"_2862":50763},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3376":843,"_29549":799,"_20523":50765,"_5":14087,"_26884":50657,"_2862":50766},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3376":844,"_29549":799,"_20523":50768,"_5":14087,"_26884":50657,"_2862":50769},[],"Confirm and read the serial, active version and history again.",{"_3376":845,"_29549":799,"_20523":50771,"_5":14087,"_26884":50657,"_2862":50772},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3376":846,"_29549":799,"_20523":50774,"_5":14087,"_26884":50657,"_2862":50775},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3376":847,"_29549":799,"_20523":50777,"_5":14087,"_26884":50661,"_2862":50778},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3376":848,"_29549":799,"_20523":50780,"_5":14087,"_26884":50661,"_2862":50781},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3376":849,"_29549":799,"_20523":50783,"_5":14087,"_26884":50665,"_2862":50784},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3376":850,"_29549":799,"_20523":50786,"_5":14087,"_26884":50665,"_2862":50787},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3376":851,"_29549":799,"_20523":50789,"_5":14087,"_26884":50665,"_2862":50790},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3376":852,"_29549":799,"_20523":50792,"_5":14087,"_26884":50665,"_2862":50793},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3376":853,"_29549":799,"_20523":50795,"_5":14087,"_26884":50669,"_2862":50796},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3376":854,"_29549":799,"_20523":50798,"_5":14087,"_26884":50669,"_2862":50799},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3376":855,"_29549":855,"_5":14445,"_2862":50801,"_29901":50802,"_20523":50804,"_26884":855},"Bootstrap identity and authentication",[48143,49611,50622,50620,50803],"Enrollment with PKI",[],{"_3376":856,"_29549":855,"_20523":50806,"_5":14087,"_26884":855,"_2862":50807},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3376":857,"_29549":855,"_5":29898,"_20523":50809,"_26884":50810,"_2862":50811},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3376":858,"_29549":855,"_5":29898,"_20523":50813,"_26884":50814,"_2862":50815},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3376":859,"_29549":855,"_5":29898,"_20523":50817,"_26884":50818,"_2862":50819},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3376":860,"_29549":855,"_5":29898,"_20523":50821,"_26884":50822,"_2862":50823},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3376":861,"_29549":855,"_5":29898,"_20523":50825,"_26884":50826,"_2862":50827},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3376":862,"_29549":855,"_20523":50829,"_5":14087,"_26884":855,"_2862":50830},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3376":863,"_29549":855,"_20523":50832,"_5":14087,"_26884":50810,"_2862":50833},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3376":864,"_29549":855,"_20523":50835,"_5":14087,"_26884":50810,"_2862":50836},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3376":865,"_29549":855,"_20523":50838,"_5":14087,"_26884":50814,"_2862":50839},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3376":866,"_29549":855,"_20523":50841,"_5":14087,"_26884":50814,"_2862":50842},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3376":867,"_29549":855,"_20523":50844,"_5":14087,"_26884":50814,"_2862":50845},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3376":868,"_29549":855,"_20523":50847,"_5":14087,"_26884":50818,"_2862":50848},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3376":869,"_29549":855,"_20523":50850,"_5":14087,"_26884":50818,"_2862":50851},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3376":870,"_29549":855,"_20523":50853,"_5":14087,"_26884":50822,"_2862":50854},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3376":871,"_29549":855,"_20523":50856,"_5":14087,"_26884":50822,"_2862":50857},[],"Example body:",{"_3376":872,"_29549":855,"_20523":50859,"_5":14087,"_26884":50822,"_2862":50860},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3376":873,"_29549":855,"_20523":50862,"_5":14087,"_26884":50822,"_2862":50863},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3376":874,"_29549":855,"_20523":50865,"_5":14087,"_26884":50822,"_2862":50866},[],"Continuation requires a successful HTTP response and JSON:",{"_3376":875,"_29549":855,"_20523":50868,"_5":14087,"_26884":50822,"_2862":50869},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3376":876,"_29549":855,"_20523":50871,"_5":14087,"_26884":50826,"_2862":50872},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3376":877,"_29549":855,"_20523":50874,"_5":14087,"_26884":50826,"_2862":50875},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3376":878,"_29549":878,"_5":14445,"_2862":50877,"_29901":50878,"_20523":50879,"_26884":878},"Configure and operate the DMS",[48143,49611,50622,50620,50803],[],{"_3376":879,"_29549":878,"_20523":50881,"_5":14087,"_26884":878,"_2862":50882},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3376":880,"_29549":878,"_5":29898,"_20523":50884,"_26884":50885,"_2862":48153},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3376":881,"_29549":878,"_5":29898,"_20523":50887,"_26884":50888,"_2862":50889},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3376":882,"_29549":878,"_5":29898,"_20523":50891,"_26884":50892,"_2862":50893},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3376":883,"_29549":878,"_5":29898,"_20523":50895,"_26884":50896,"_2862":50897},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3376":884,"_29549":878,"_5":29898,"_20523":50899,"_26884":50900,"_2862":50901},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3376":885,"_29549":878,"_5":29898,"_20523":50903,"_26884":50904,"_2862":50905},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3376":886,"_29549":878,"_5":29898,"_20523":50907,"_26884":50908,"_2862":50909},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3376":887,"_29549":878,"_5":29898,"_20523":50911,"_26884":50912,"_2862":50913},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3376":888,"_29549":878,"_5":29898,"_20523":50915,"_26884":50916,"_2862":50917},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3376":889,"_29549":878,"_5":29898,"_20523":50919,"_26884":50920,"_2862":50921},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3376":890,"_29549":878,"_5":29898,"_20523":50923,"_26884":50924,"_2862":50925},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3376":891,"_29549":878,"_5":29898,"_20523":50927,"_26884":50928,"_2862":50929},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3376":892,"_29549":878,"_5":29898,"_20523":50931,"_26884":50932,"_2862":50933},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3376":893,"_29549":878,"_5":29898,"_20523":50935,"_26884":50936,"_2862":50937},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3376":894,"_29549":878,"_5":29898,"_20523":50939,"_26884":50940,"_2862":50941},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3376":895,"_29549":878,"_5":29898,"_20523":50943,"_26884":50944,"_2862":50945},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3376":896,"_29549":878,"_5":29898,"_20523":50947,"_26884":50948,"_2862":50949},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3376":897,"_29549":878,"_5":29898,"_20523":50951,"_26884":50952,"_2862":50953},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3376":898,"_29549":878,"_20523":50955,"_5":14087,"_26884":878,"_2862":50956},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3376":899,"_29549":878,"_20523":50958,"_5":14087,"_26884":50885,"_2862":50959},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3376":900,"_29549":878,"_20523":50961,"_5":14087,"_26884":50885,"_2862":50962},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3376":901,"_29549":878,"_20523":50964,"_5":14087,"_26884":50892,"_2862":50965},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3376":902,"_29549":878,"_20523":50967,"_5":14087,"_26884":50896,"_2862":50968},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3376":903,"_29549":878,"_20523":50970,"_5":14087,"_26884":50900,"_2862":50971},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3376":904,"_29549":878,"_20523":50973,"_5":14087,"_26884":50904,"_2862":50974},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3376":905,"_29549":878,"_20523":50976,"_5":14087,"_26884":50908,"_2862":50977},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3376":906,"_29549":878,"_20523":50979,"_5":14087,"_26884":50916,"_2862":50980},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3376":907,"_29549":878,"_20523":50982,"_5":14087,"_26884":50916,"_2862":50983},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3376":908,"_29549":878,"_20523":50985,"_5":14087,"_26884":50920,"_2862":50986},[],"`settings.enrollment_settings` field",{"_3376":909,"_29549":878,"_20523":50988,"_5":14087,"_26884":50920,"_2862":50989},[],"Decision",{"_3376":910,"_29549":878,"_20523":50991,"_5":14087,"_26884":50920,"_2862":50992},[],"`protocol`",{"_3376":911,"_29549":878,"_20523":50994,"_5":14087,"_26884":50920,"_2862":50995},[],"`EST_RFC7030` for these operations.",{"_3376":912,"_29549":878,"_20523":50997,"_5":14087,"_26884":50920,"_2862":50998},[],"`enrollment_ca`",{"_3376":913,"_29549":878,"_20523":51000,"_5":14087,"_26884":50920,"_2862":51001},[],"ID of the signing CA.",{"_3376":914,"_29549":878,"_20523":51003,"_5":14087,"_26884":50920,"_2862":51004},[],"`verify_csr_signature`",{"_3376":915,"_29549":878,"_20523":51006,"_5":14087,"_26884":50920,"_2862":51007},[],"Keep `true` to verify CSR key possession.",{"_3376":916,"_29549":878,"_20523":51009,"_5":14087,"_26884":50920,"_2862":51010},[],"`enable_replaceable_enrollment`",{"_3376":917,"_29549":878,"_20523":51012,"_5":14087,"_26884":50920,"_2862":51013},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3376":918,"_29549":878,"_20523":51015,"_5":14087,"_26884":50920,"_2862":51016},[],"`est_rfc7030_settings.auth_mode`",{"_3376":919,"_29549":878,"_20523":51018,"_5":14087,"_26884":50920,"_2862":51019},[],"One of the four authentication modes.",{"_3376":920,"_29549":878,"_20523":51021,"_5":14087,"_26884":50920,"_2862":51022},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3376":921,"_29549":878,"_20523":51024,"_5":14087,"_26884":50924,"_2862":51025},[],"The blocks are independent:",{"_3376":922,"_29549":878,"_20523":51027,"_5":14087,"_26884":50924,"_2862":51028},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3376":923,"_29549":878,"_20523":51030,"_5":14087,"_26884":50924,"_2862":51031},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3376":924,"_29549":878,"_20523":51033,"_5":14087,"_26884":50924,"_2862":51034},[],"`auth_mode`",{"_3376":925,"_29549":878,"_20523":51036,"_5":14087,"_26884":50924,"_2862":51037},[],"Control applied in the configured operation",{"_3376":926,"_29549":878,"_20523":51039,"_5":14087,"_26884":50924,"_2862":51040},[],"`CLIENT_CERTIFICATE`",{"_3376":927,"_29549":878,"_20523":51042,"_5":14087,"_26884":50924,"_2862":51043},[],"Presented certificate validation.",{"_3376":928,"_29549":878,"_20523":51045,"_5":14087,"_26884":50924,"_2862":51046},[],"`EXTERNAL_WEBHOOK`",{"_3376":929,"_29549":878,"_20523":51048,"_5":14087,"_26884":50924,"_2862":51049},[],"Configured webhook authorization.",{"_3376":930,"_29549":878,"_20523":51051,"_5":14087,"_26884":50924,"_2862":51052},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3376":931,"_29549":878,"_20523":51054,"_5":14087,"_26884":50924,"_2862":51055},[],"Certificate validation followed by webhook approval.",{"_3376":932,"_29549":878,"_20523":51057,"_5":14087,"_26884":50924,"_2862":51058},[],"`NO_AUTH`",{"_3376":933,"_29549":878,"_20523":51060,"_5":14087,"_26884":50924,"_2862":51061},[],"No DMS requester authentication.",{"_3376":934,"_29549":878,"_20523":51063,"_5":14087,"_26884":50924,"_2862":51064},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3376":935,"_29549":878,"_20523":51066,"_5":14087,"_26884":50924,"_2862":51067},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3376":936,"_29549":878,"_20523":51069,"_5":14087,"_26884":50924,"_2862":51070},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3376":937,"_29549":878,"_20523":51072,"_5":14087,"_26884":50924,"_2862":51073},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3376":938,"_29549":878,"_20523":51075,"_5":14087,"_26884":50928,"_2862":51076},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3376":939,"_29549":878,"_20523":51078,"_5":14087,"_26884":50928,"_2862":51079},[],"`external_webhook_settings` field",{"_3376":940,"_29549":878,"_20523":51081,"_5":14087,"_26884":50928,"_2862":50989},[],{"_3376":941,"_29549":878,"_20523":51083,"_5":14087,"_26884":50928,"_2862":51084},[],"`url`",{"_3376":942,"_29549":878,"_20523":51086,"_5":14087,"_26884":50928,"_2862":51087},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3376":943,"_29549":878,"_20523":51089,"_5":14087,"_26884":50928,"_2862":51090},[],"`method`",{"_3376":944,"_29549":878,"_20523":51092,"_5":14087,"_26884":50928,"_2862":51093},[],"`POST` or `PUT`; `POST` by default.",{"_3376":945,"_29549":878,"_20523":51095,"_5":14087,"_26884":50928,"_2862":51096},[],"`name`",{"_3376":946,"_29549":878,"_20523":51098,"_5":14087,"_26884":50928,"_2862":51099},[],"Label used in service logs.",{"_3376":947,"_29549":878,"_20523":51101,"_5":14087,"_26884":50928,"_2862":51102},[],"`config.auth_mode`",{"_3376":948,"_29549":878,"_20523":51104,"_5":14087,"_26884":50928,"_2862":51105},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3376":949,"_29549":878,"_20523":51107,"_5":14087,"_26884":50928,"_2862":51108},[],"`config.log_level`",{"_3376":950,"_29549":878,"_20523":51110,"_5":14087,"_26884":50928,"_2862":51111},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3376":951,"_29549":878,"_20523":51113,"_5":14087,"_26884":50928,"_2862":51114},[],"`config.apikey_options`",{"_3376":952,"_29549":878,"_20523":51116,"_5":14087,"_26884":50928,"_2862":51117},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3376":953,"_29549":878,"_20523":51119,"_5":14087,"_26884":50928,"_2862":51120},[],"`config.jwt_options`",{"_3376":954,"_29549":878,"_20523":51122,"_5":14087,"_26884":50928,"_2862":51123},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3376":955,"_29549":878,"_20523":51125,"_5":14087,"_26884":50928,"_2862":51126},[],"`config.mtls_options`",{"_3376":956,"_29549":878,"_20523":51128,"_5":14087,"_26884":50928,"_2862":51129},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3376":957,"_29549":878,"_20523":51131,"_5":14087,"_26884":50928,"_2862":51132},[],"`config.insecure_skip_verify`",{"_3376":958,"_29549":878,"_20523":51134,"_5":14087,"_26884":50928,"_2862":51135},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3376":959,"_29549":878,"_20523":51137,"_5":14087,"_26884":50928,"_2862":51138},[],"`config.call_timeout`",{"_3376":960,"_29549":878,"_20523":51140,"_5":14087,"_26884":50928,"_2862":51141},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3376":961,"_29549":878,"_20523":51143,"_5":14087,"_26884":50928,"_2862":51144},[],"Rules for that configuration:",{"_3376":962,"_29549":878,"_20523":51146,"_5":14087,"_26884":50928,"_2862":51147},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3376":963,"_29549":878,"_20523":51149,"_5":14087,"_26884":50928,"_2862":51150},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3376":964,"_29549":878,"_20523":51152,"_5":14087,"_26884":50928,"_2862":51153},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3376":965,"_29549":878,"_20523":51155,"_5":14087,"_26884":50928,"_2862":51156},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3376":966,"_29549":878,"_20523":51158,"_5":14087,"_26884":50928,"_2862":51159},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3376":967,"_29549":878,"_20523":51161,"_5":14087,"_26884":50928,"_2862":51162},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3376":968,"_29549":878,"_20523":51164,"_5":14087,"_26884":50928,"_2862":51165},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3376":969,"_29549":878,"_20523":51167,"_5":14087,"_26884":50928,"_2862":51168},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3376":970,"_29549":878,"_20523":51170,"_5":14087,"_26884":50928,"_2862":51171},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3376":971,"_29549":878,"_20523":51173,"_5":14087,"_26884":50932,"_2862":51174},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3376":972,"_29549":878,"_20523":51176,"_5":14087,"_26884":50936,"_2862":51177},[],"`settings.reenrollment_settings` field",{"_3376":973,"_29549":878,"_20523":51179,"_5":14087,"_26884":50936,"_2862":48533},[],{"_3376":974,"_29549":878,"_20523":51181,"_5":14087,"_26884":50936,"_2862":51182},[],"`reenrollment_delta`",{"_3376":975,"_29549":878,"_20523":51184,"_5":14087,"_26884":50936,"_2862":51185},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3376":976,"_29549":878,"_20523":51187,"_5":14087,"_26884":50936,"_2862":51188},[],"`preventive_delta`",{"_3376":977,"_29549":878,"_20523":51190,"_5":14087,"_26884":50936,"_2862":51191},[],"Preventive operational monitoring threshold.",{"_3376":978,"_29549":878,"_20523":51193,"_5":14087,"_26884":50936,"_2862":51194},[],"`critical_delta`",{"_3376":979,"_29549":878,"_20523":51196,"_5":14087,"_26884":50936,"_2862":51197},[],"Critical operational monitoring threshold.",{"_3376":980,"_29549":878,"_20523":51199,"_5":14087,"_26884":50936,"_2862":51200},[],"`enable_expired_renewal`",{"_3376":981,"_29549":878,"_20523":51202,"_5":14087,"_26884":50936,"_2862":51203},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3376":982,"_29549":878,"_20523":51205,"_5":14087,"_26884":50936,"_2862":51206},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3376":983,"_29549":878,"_20523":51208,"_5":14087,"_26884":50936,"_2862":51209},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3376":984,"_29549":878,"_20523":51211,"_5":14087,"_26884":50936,"_2862":51212},[],"`revoke_on_reenrollment`",{"_3376":985,"_29549":878,"_20523":51214,"_5":14087,"_26884":50936,"_2862":51215},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3376":986,"_29549":878,"_20523":51217,"_5":14087,"_26884":50936,"_2862":51218},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3376":987,"_29549":878,"_20523":51220,"_5":14087,"_26884":50940,"_2862":51221},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3376":988,"_29549":878,"_20523":51223,"_5":14087,"_26884":50944,"_2862":48527},[],{"_3376":989,"_29549":878,"_20523":51225,"_5":14087,"_26884":50944,"_2862":51226},[],"Published material",{"_3376":990,"_29549":878,"_20523":51228,"_5":14087,"_26884":50944,"_2862":51229},[],"**Include Lamassu System CA**",{"_3376":991,"_29549":878,"_20523":51231,"_5":14087,"_26884":50944,"_2862":51232},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3376":992,"_29549":878,"_20523":51234,"_5":14087,"_26884":50944,"_2862":51235},[],"**Include Enrollment CA**",{"_3376":993,"_29549":878,"_20523":51237,"_5":14087,"_26884":50944,"_2862":51238},[],"Selected issuing CA certificate.",{"_3376":994,"_29549":878,"_20523":51240,"_5":14087,"_26884":50944,"_2862":51241},[],"**Managed CAs**",{"_3376":995,"_29549":878,"_20523":51243,"_5":14087,"_26884":50944,"_2862":51244},[],"Explicitly selected CA certificates.",{"_3376":996,"_29549":878,"_20523":51246,"_5":14087,"_26884":50944,"_2862":51247},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3376":997,"_29549":878,"_20523":51249,"_5":14087,"_26884":50948,"_2862":51250},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3376":998,"_29549":878,"_20523":51252,"_5":14087,"_26884":50948,"_2862":51253},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3376":999,"_29549":878,"_20523":51255,"_5":14087,"_26884":50948,"_2862":51256},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3376":1000,"_29549":878,"_20523":51258,"_5":14087,"_26884":50952,"_2862":51259},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3376":1001,"_29549":1001,"_5":14445,"_2862":51261,"_29901":51262,"_20523":51263,"_26884":1001},"Integrate the EST client",[48143,49611,50622,50620,50803],[],{"_3376":1002,"_29549":1001,"_20523":51265,"_5":14087,"_26884":1001,"_2862":51266},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3376":1003,"_29549":1001,"_5":29898,"_20523":51268,"_26884":51269,"_2862":48153},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3376":1004,"_29549":1001,"_5":29898,"_20523":51271,"_26884":51272,"_2862":51273},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3376":1005,"_29549":1001,"_5":29898,"_20523":51275,"_26884":51276,"_2862":51277},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3376":1006,"_29549":1001,"_5":29898,"_20523":51279,"_26884":51280,"_2862":51281},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3376":1007,"_29549":1001,"_5":29898,"_20523":51283,"_26884":51284,"_2862":51285},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3376":1008,"_29549":1001,"_5":29898,"_20523":51287,"_26884":51288,"_2862":51289},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3376":1009,"_29549":1001,"_20523":51291,"_5":14087,"_26884":1001,"_2862":51292},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3376":1010,"_29549":1001,"_20523":51294,"_5":14087,"_26884":51269,"_2862":51295},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3376":1011,"_29549":1001,"_20523":51297,"_5":14087,"_26884":51269,"_2862":51298},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3376":1012,"_29549":1001,"_20523":51300,"_5":14087,"_26884":51269,"_2862":51301},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3376":1013,"_29549":1001,"_20523":51303,"_5":14087,"_26884":51272,"_2862":51304},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3376":1014,"_29549":1001,"_20523":51306,"_5":14087,"_26884":51272,"_2862":51307},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3376":1015,"_29549":1001,"_20523":51309,"_5":14087,"_26884":51276,"_2862":51310},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3376":1016,"_29549":1001,"_20523":51312,"_5":14087,"_26884":51276,"_2862":51313},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3376":1017,"_29549":1001,"_20523":51315,"_5":14087,"_26884":51280,"_2862":51316},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3376":1018,"_29549":1001,"_20523":51318,"_5":14087,"_26884":51280,"_2862":51319},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3376":1019,"_29549":1001,"_20523":51321,"_5":14087,"_26884":51284,"_2862":51322},[],"For a root that issues directly:",{"_3376":1020,"_29549":1001,"_20523":51324,"_5":14087,"_26884":51284,"_2862":51325},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3376":1021,"_29549":1001,"_20523":51327,"_5":14087,"_26884":51284,"_2862":51328},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3376":1022,"_29549":1001,"_20523":51330,"_5":14087,"_26884":51288,"_2862":51331},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3376":1023,"_29549":1023,"_5":14445,"_2862":51333,"_29901":51334,"_20523":51335,"_26884":1023},"EST reference",[48143,49611,50622,50620,50803],[],{"_3376":1024,"_29549":1023,"_20523":51337,"_5":14087,"_26884":1023,"_2862":51338},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3376":1025,"_29549":1023,"_5":29898,"_20523":51340,"_26884":51341,"_2862":51342},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3376":1026,"_29549":1023,"_5":29898,"_20523":51344,"_26884":51345,"_2862":22251},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3376":1027,"_29549":1023,"_5":29898,"_20523":51347,"_26884":51348,"_2862":25531},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3376":1028,"_29549":1023,"_5":29898,"_20523":51350,"_26884":51351,"_2862":25538},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3376":1029,"_29549":1023,"_5":29898,"_20523":51353,"_26884":51354,"_2862":24866},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3376":1030,"_29549":1023,"_5":29898,"_20523":51356,"_26884":51357,"_2862":51358},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3376":1031,"_29549":1023,"_5":29898,"_20523":51360,"_26884":51361,"_2862":51362},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3376":1032,"_29549":1023,"_5":29898,"_20523":51364,"_26884":51365,"_2862":51366},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3376":1033,"_29549":1023,"_20523":51368,"_5":14087,"_26884":1023,"_2862":51369},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3376":1034,"_29549":1023,"_20523":51371,"_5":14087,"_26884":51341,"_2862":51372},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3376":1035,"_29549":1023,"_20523":51374,"_5":14087,"_26884":51341,"_2862":51375},[],"Operation",{"_3376":1036,"_29549":1023,"_20523":51377,"_5":14087,"_26884":51341,"_2862":51378},[],"Method",{"_3376":1037,"_29549":1023,"_20523":51380,"_5":14087,"_26884":51341,"_2862":51381},[],"Authentication and condition",{"_3376":1038,"_29549":1023,"_20523":51383,"_5":14087,"_26884":51341,"_2862":51384},[],"`/cacerts`",{"_3376":1039,"_29549":1023,"_20523":51386,"_5":14087,"_26884":51341,"_2862":51387},[],"GET",{"_3376":1040,"_29549":1023,"_20523":51389,"_5":14087,"_26884":51341,"_2862":51390},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3376":1041,"_29549":1023,"_20523":51392,"_5":14087,"_26884":51341,"_2862":51393},[],"`/simpleenroll`",{"_3376":1042,"_29549":1023,"_20523":51395,"_5":14087,"_26884":51341,"_2862":51396},[],"POST",{"_3376":1043,"_29549":1023,"_20523":51398,"_5":14087,"_26884":51341,"_2862":51399},[],"Initial authentication and DMS registration/replacement policy.",{"_3376":1044,"_29549":1023,"_20523":51401,"_5":14087,"_26884":51341,"_2862":51402},[],"`/simplereenroll`",{"_3376":1045,"_29549":1023,"_20523":51404,"_5":14087,"_26884":51341,"_2862":51396},[],{"_3376":1046,"_29549":1023,"_20523":51406,"_5":14087,"_26884":51341,"_2862":51407},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3376":1047,"_29549":1023,"_20523":51409,"_5":14087,"_26884":51341,"_2862":51410},[],"`/serverkeygen`",{"_3376":1048,"_29549":1023,"_20523":51412,"_5":14087,"_26884":51341,"_2862":51396},[],{"_3376":1049,"_29549":1023,"_20523":51414,"_5":14087,"_26884":51341,"_2862":51415},[],"Initial authentication and admission; server generation enabled.",{"_3376":1050,"_29549":1023,"_20523":51417,"_5":14087,"_26884":51341,"_2862":51418},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3376":1051,"_29549":1023,"_20523":51420,"_5":14087,"_26884":51345,"_2862":51421},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3376":1052,"_29549":1023,"_20523":51423,"_5":14087,"_26884":51345,"_2862":51424},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3376":1053,"_29549":1023,"_20523":51426,"_5":14087,"_26884":51348,"_2862":51427},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3376":1054,"_29549":1023,"_20523":51429,"_5":14087,"_26884":51348,"_2862":51430},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3376":1055,"_29549":1023,"_20523":51432,"_5":14087,"_26884":51351,"_2862":51433},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3376":1056,"_29549":1023,"_20523":51435,"_5":14087,"_26884":51351,"_2862":51436},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3376":1057,"_29549":1023,"_20523":51438,"_5":14087,"_26884":51354,"_2862":51439},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3376":1058,"_29549":1023,"_20523":51441,"_5":14087,"_26884":51354,"_2862":51442},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3376":1059,"_29549":1023,"_20523":51444,"_5":14087,"_26884":51357,"_2862":51445},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3376":1060,"_29549":1023,"_20523":51447,"_5":14087,"_26884":51357,"_2862":51448},[],"Part",{"_3376":1061,"_29549":1023,"_20523":51450,"_5":14087,"_26884":51357,"_2862":51451},[],"Content after decoding its Base64",{"_3376":1062,"_29549":1023,"_20523":51453,"_5":14087,"_26884":51357,"_2862":51454},[],"`application/pkcs8`",{"_3376":1063,"_29549":1023,"_20523":51456,"_5":14087,"_26884":51357,"_2862":51457},[],"Unencrypted DER PKCS#8 private key.",{"_3376":1064,"_29549":1023,"_20523":51459,"_5":14087,"_26884":51357,"_2862":51460},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3376":1065,"_29549":1023,"_20523":51462,"_5":14087,"_26884":51357,"_2862":51463},[],"DER PKCS#7 containing the issued certificate.",{"_3376":1066,"_29549":1023,"_20523":51465,"_5":14087,"_26884":51357,"_2862":51466},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3376":1067,"_29549":1023,"_20523":51468,"_5":14087,"_26884":51361,"_2862":51469},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3376":1068,"_29549":1023,"_20523":51471,"_5":14087,"_26884":51361,"_2862":51472},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3376":1069,"_29549":1023,"_20523":51474,"_5":14087,"_26884":51361,"_2862":51475},[],"Convert and check the result:",{"_3376":1070,"_29549":1023,"_20523":51477,"_5":14087,"_26884":51361,"_2862":51478},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3376":1071,"_29549":1023,"_20523":51480,"_5":14087,"_26884":51365,"_2862":51481},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3376":1072,"_29549":1023,"_20523":51483,"_5":14087,"_26884":51365,"_2862":51484},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3376":1073,"_29549":1073,"_5":14445,"_2862":50803,"_29901":51486,"_20523":51487,"_26884":1073},[48143,49611,50622,50620,50803],[],{"_3376":1074,"_29549":1073,"_20523":51489,"_5":14087,"_26884":1073,"_2862":51490},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3376":1075,"_29549":1073,"_5":29898,"_20523":51492,"_26884":51493,"_2862":51494},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3376":1076,"_29549":1073,"_5":29898,"_20523":51496,"_26884":51497,"_2862":51498},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3376":1077,"_29549":1073,"_5":29898,"_20523":51500,"_26884":51501,"_2862":51502},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3376":1078,"_29549":1073,"_5":29898,"_20523":51504,"_26884":51505,"_2862":51506},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3376":1079,"_29549":1073,"_20523":51508,"_5":14087,"_26884":1073,"_2862":51509},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3376":1080,"_29549":1073,"_20523":51511,"_5":14087,"_26884":51493,"_2862":51512},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3376":1081,"_29549":1073,"_20523":51514,"_5":14087,"_26884":51493,"_2862":51515},[],"The integrator installs initial EST server trust and an admission credential.",{"_3376":1082,"_29549":1073,"_20523":51517,"_5":14087,"_26884":51493,"_2862":51518},[],"The client requests an identity for its `Device ID` through EST.",{"_3376":1083,"_29549":1073,"_20523":51520,"_5":14087,"_26884":51493,"_2862":51521},[],"Certificate, device binding and key/certificate installation are checked.",{"_3376":1084,"_29549":1073,"_20523":51523,"_5":14087,"_26884":51493,"_2862":51524},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3376":1085,"_29549":1073,"_20523":51526,"_5":14087,"_26884":51493,"_2862":51527},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3376":1086,"_29549":1073,"_20523":51529,"_5":14087,"_26884":51497,"_2862":51530},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3376":1087,"_29549":1073,"_20523":51532,"_5":14087,"_26884":51497,"_2862":51533},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3376":1088,"_29549":1073,"_20523":51535,"_5":14087,"_26884":51497,"_2862":51536},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3376":1089,"_29549":1073,"_20523":51538,"_5":14087,"_26884":51497,"_2862":51539},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3376":1090,"_29549":1073,"_20523":51541,"_5":14087,"_26884":51501,"_2862":51542},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3376":1091,"_29549":1073,"_20523":51544,"_5":14087,"_26884":51501,"_2862":51545},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3376":1092,"_29549":1073,"_20523":51547,"_5":14087,"_26884":51501,"_2862":51548},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3376":1093,"_29549":1073,"_20523":51550,"_5":14087,"_26884":51501,"_2862":51551},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3376":1094,"_29549":1073,"_20523":51553,"_5":14087,"_26884":51505,"_2862":51554},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3376":1095,"_29549":1073,"_20523":51556,"_5":14087,"_26884":51505,"_2862":51557},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3376":1096,"_29549":1096,"_5":14445,"_2862":51559,"_29901":51560,"_20523":51561,"_26884":1096},"Provisioning strategies",[48143,49611,50622,50620,50803],[],{"_3376":1097,"_29549":1096,"_20523":51563,"_5":14087,"_26884":1096,"_2862":51564},[],"Choose device registration, identity authorization and key generation.",{"_3376":1098,"_29549":1096,"_5":29898,"_20523":51566,"_26884":51567,"_2862":51568},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3376":1099,"_29549":1096,"_5":29898,"_20523":51570,"_26884":51571,"_2862":51572},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3376":1100,"_29549":1096,"_5":29898,"_20523":51574,"_26884":51575,"_2862":51576},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3376":1101,"_29549":1096,"_5":29898,"_20523":51578,"_26884":51579,"_2862":51580},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3376":1102,"_29549":1096,"_5":29898,"_20523":51582,"_26884":51583,"_2862":51584},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3376":1103,"_29549":1096,"_20523":51586,"_5":14087,"_26884":1096,"_2862":51587},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3376":1104,"_29549":1096,"_20523":51589,"_5":14087,"_26884":51567,"_2862":51590},[],"Path",{"_3376":1105,"_29549":1096,"_20523":51592,"_5":14087,"_26884":51567,"_2862":51593},[],"When the device exists",{"_3376":1106,"_29549":1096,"_20523":51595,"_5":14087,"_26884":51567,"_2862":51596},[],"What to check",{"_3376":1107,"_29549":1096,"_20523":51598,"_5":14087,"_26884":51567,"_2862":51599},[],"Manual assignment",{"_3376":1108,"_29549":1096,"_20523":51601,"_5":14087,"_26884":51567,"_2862":51602},[],"An operator creates it before associating a certificate.",{"_3376":1109,"_29549":1096,"_20523":51604,"_5":14087,"_26884":51567,"_2862":51605},[],"ID, owning DMS, certificate CN and bound serial.",{"_3376":1110,"_29549":1096,"_20523":51607,"_5":14087,"_26884":51567,"_2862":51608},[],"EST with `JITP`",{"_3376":1111,"_29549":1096,"_20523":51610,"_5":14087,"_26884":51567,"_2862":51611},[],"Created for an unknown CN during `/simpleenroll`.",{"_3376":1112,"_29549":1096,"_20523":51613,"_5":14087,"_26884":51567,"_2862":51614},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3376":1113,"_29549":1096,"_20523":51616,"_5":14087,"_26884":51567,"_2862":51617},[],"EST with `PRE_REGISTRATION`",{"_3376":1114,"_29549":1096,"_20523":51619,"_5":14087,"_26884":51567,"_2862":51620},[],"Must exist before `/simpleenroll`.",{"_3376":1115,"_29549":1096,"_20523":51622,"_5":14087,"_26884":51567,"_2862":51623},[],"Approved record, same DMS and replacement conditions for your version.",{"_3376":1116,"_29549":1096,"_20523":51625,"_5":14087,"_26884":51567,"_2862":51626},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3376":1117,"_29549":1096,"_20523":51628,"_5":14087,"_26884":51567,"_2862":51629},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3376":1118,"_29549":1096,"_20523":51631,"_5":14087,"_26884":51571,"_2862":51632},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3376":1119,"_29549":1096,"_20523":51634,"_5":14087,"_26884":51571,"_2862":51635},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3376":1120,"_29549":1096,"_20523":51637,"_5":14087,"_26884":51571,"_2862":51638},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3376":1121,"_29549":1096,"_20523":51640,"_5":14087,"_26884":51575,"_2862":51641},[],"Decide initial enrollment and re-enrollment separately:",{"_3376":1122,"_29549":1096,"_20523":51643,"_5":14087,"_26884":51575,"_2862":51644},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3376":1123,"_29549":1096,"_20523":51646,"_5":14087,"_26884":51575,"_2862":51647},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3376":1124,"_29549":1096,"_20523":51649,"_5":14087,"_26884":51575,"_2862":51650},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3376":1125,"_29549":1096,"_20523":51652,"_5":14087,"_26884":51575,"_2862":51653},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3376":1126,"_29549":1096,"_20523":51655,"_5":14087,"_26884":51575,"_2862":51656},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3376":1127,"_29549":1096,"_20523":51658,"_5":14087,"_26884":51579,"_2862":48527},[],{"_3376":1128,"_29549":1096,"_20523":51660,"_5":14087,"_26884":51579,"_2862":51661},[],"Material crossing EST",{"_3376":1129,"_29549":1096,"_20523":51663,"_5":14087,"_26884":51579,"_2862":51664},[],"Device-generated key",{"_3376":1130,"_29549":1096,"_20523":51666,"_5":14087,"_26884":51579,"_2862":51667},[],"Public CSR and certificate; the key stays on the client.",{"_3376":1131,"_29549":1096,"_20523":51669,"_5":14087,"_26884":51579,"_2862":51670},[],"Existing device key",{"_3376":1132,"_29549":1096,"_20523":51672,"_5":14087,"_26884":51579,"_2862":51673},[],"CSR signed with that key and a new certificate.",{"_3376":1133,"_29549":1096,"_20523":51675,"_5":14087,"_26884":51579,"_2862":50941},[],{"_3376":1134,"_29549":1096,"_20523":51677,"_5":14087,"_26884":51579,"_2862":51678},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3376":1135,"_29549":1096,"_20523":51680,"_5":14087,"_26884":51579,"_2862":51681},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3376":1136,"_29549":1096,"_20523":51683,"_5":14087,"_26884":51583,"_2862":51684},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3376":1137,"_29549":1137,"_5":14445,"_2862":51686,"_29901":51687,"_20523":51688,"_26884":1137},"Renewal and recovery",[48143,49611,50622,50620,50803],[],{"_3376":1138,"_29549":1137,"_20523":51690,"_5":14087,"_26884":1137,"_2862":51691},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3376":1139,"_29549":1137,"_5":29898,"_20523":51693,"_26884":51694,"_2862":51695},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3376":1140,"_29549":1137,"_5":29898,"_20523":51697,"_26884":51698,"_2862":51699},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3376":1141,"_29549":1137,"_5":29898,"_20523":51701,"_26884":51702,"_2862":51703},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3376":1142,"_29549":1137,"_5":29898,"_20523":51705,"_26884":51706,"_2862":51707},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3376":1143,"_29549":1137,"_5":29898,"_20523":51709,"_26884":51710,"_2862":51711},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3376":1144,"_29549":1137,"_20523":51713,"_5":14087,"_26884":1137,"_2862":51714},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3376":1145,"_29549":1137,"_20523":51716,"_5":14087,"_26884":51694,"_2862":51717},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3376":1146,"_29549":1137,"_20523":51719,"_5":14087,"_26884":51694,"_2862":51720},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3376":1147,"_29549":1137,"_20523":51722,"_5":14087,"_26884":51694,"_2862":51723},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3376":1148,"_29549":1137,"_20523":51725,"_5":14087,"_26884":51694,"_2862":51726},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3376":1149,"_29549":1137,"_20523":51728,"_5":14087,"_26884":51698,"_2862":51729},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3376":1150,"_29549":1137,"_20523":51731,"_5":14087,"_26884":51698,"_2862":51732},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3376":1151,"_29549":1137,"_20523":51734,"_5":14087,"_26884":51702,"_2862":51735},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3376":1152,"_29549":1137,"_20523":51737,"_5":14087,"_26884":51702,"_2862":51738},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3376":1153,"_29549":1137,"_20523":51740,"_5":14087,"_26884":51702,"_2862":51741},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3376":1154,"_29549":1137,"_20523":51743,"_5":14087,"_26884":51706,"_2862":51744},[],"Situation",{"_3376":1155,"_29549":1137,"_20523":51746,"_5":14087,"_26884":51706,"_2862":51747},[],"Procedure",{"_3376":1156,"_29549":1137,"_20523":51749,"_5":14087,"_26884":51706,"_2862":51750},[],"Valid certificate, outside the window",{"_3376":1157,"_29549":1137,"_20523":51752,"_5":14087,"_26884":51706,"_2862":51753},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3376":1158,"_29549":1137,"_20523":51755,"_5":14087,"_26884":51706,"_2862":51756},[],"Expired certificate, key available",{"_3376":1159,"_29549":1137,"_20523":51758,"_5":14087,"_26884":51706,"_2862":51759},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3376":1160,"_29549":1137,"_20523":51761,"_5":14087,"_26884":51706,"_2862":51762},[],"Renewal through webhook or `NO_AUTH`",{"_3376":1161,"_29549":1137,"_20523":51764,"_5":14087,"_26884":51706,"_2862":51765},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3376":1162,"_29549":1137,"_20523":51767,"_5":14087,"_26884":51706,"_2862":51768},[],"Lost or inaccessible key",{"_3376":1163,"_29549":1137,"_20523":51770,"_5":14087,"_26884":51706,"_2862":51771},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3376":1164,"_29549":1137,"_20523":51773,"_5":14087,"_26884":51706,"_2862":51774},[],"Current identity revoked",{"_3376":1165,"_29549":1137,"_20523":51776,"_5":14087,"_26884":51706,"_2862":51777},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3376":1166,"_29549":1137,"_20523":51779,"_5":14087,"_26884":51706,"_2862":51780},[],"Device without an identity",{"_3376":1167,"_29549":1137,"_20523":51782,"_5":14087,"_26884":51706,"_2862":51783},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3376":1168,"_29549":1137,"_20523":51785,"_5":14087,"_26884":51706,"_2862":51786},[],"Retired device",{"_3376":1169,"_29549":1137,"_20523":51788,"_5":14087,"_26884":51706,"_2862":51789},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3376":1170,"_29549":1137,"_20523":51791,"_5":14087,"_26884":51706,"_2862":51792},[],"Timeout, HTTP 500 or installation failure",{"_3376":1171,"_29549":1137,"_20523":51794,"_5":14087,"_26884":51706,"_2862":51795},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3376":1172,"_29549":1137,"_20523":51797,"_5":14087,"_26884":51710,"_2862":51798},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3376":1173,"_29549":1137,"_20523":51800,"_5":14087,"_26884":51710,"_2862":51801},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3376":1174,"_29549":1174,"_5":14445,"_2862":51803,"_29901":51804,"_20523":51805,"_26884":1174},"Enrollment troubleshooting",[48143,49611,50622,50620,50803],[],{"_3376":1175,"_29549":1174,"_20523":51807,"_5":14087,"_26884":1174,"_2862":51808},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3376":1176,"_29549":1174,"_5":29898,"_20523":51810,"_26884":51811,"_2862":51812},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3376":1177,"_29549":1174,"_5":29898,"_20523":51814,"_26884":51815,"_2862":51816},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3376":1178,"_29549":1174,"_5":29898,"_20523":51818,"_26884":51819,"_2862":51366},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3376":1179,"_29549":1174,"_5":29898,"_20523":51821,"_26884":51822,"_2862":51823},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3376":1180,"_29549":1174,"_20523":51825,"_5":14087,"_26884":1174,"_2862":51826},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3376":1181,"_29549":1174,"_20523":51828,"_5":14087,"_26884":51815,"_2862":51829},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3376":1182,"_29549":1174,"_20523":51831,"_5":14087,"_26884":51815,"_2862":51832},[],"Symptom or message",{"_3376":1183,"_29549":1174,"_20523":51834,"_5":14087,"_26884":51815,"_2862":51596},[],{"_3376":1184,"_29549":1174,"_20523":51836,"_5":14087,"_26884":51815,"_2862":51837},[],"curl rejects TLS, name or issuer",{"_3376":1185,"_29549":1174,"_20523":51839,"_5":14087,"_26884":51815,"_2862":51840},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3376":1186,"_29549":1174,"_20523":51842,"_5":14087,"_26884":51815,"_2862":51843},[],"404 or missing APS",{"_3376":1187,"_29549":1174,"_20523":51845,"_5":14087,"_26884":51815,"_2862":51846},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3376":1188,"_29549":1174,"_20523":51848,"_5":14087,"_26884":51815,"_2862":51849},[],"400, CSR or format error",{"_3376":1189,"_29549":1174,"_20523":51851,"_5":14087,"_26884":51815,"_2862":51852},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3376":1190,"_29549":1174,"_20523":51854,"_5":14087,"_26884":51815,"_2862":51855},[],"Missing credential or invalid certificate",{"_3376":1191,"_29549":1174,"_20523":51857,"_5":14087,"_26884":51815,"_2862":51858},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3376":1192,"_29549":1174,"_20523":51860,"_5":14087,"_26884":51815,"_2862":51861},[],"Webhook denies, times out or responds without authorization",{"_3376":1193,"_29549":1174,"_20523":51863,"_5":14087,"_26884":51815,"_2862":51864},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3376":1194,"_29549":1174,"_20523":51866,"_5":14087,"_26884":51815,"_2862":51867},[],"`unexpected status code: <n>: redirects are not followed`",{"_3376":1195,"_29549":1174,"_20523":51869,"_5":14087,"_26884":51815,"_2862":51870},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3376":1196,"_29549":1174,"_20523":51872,"_5":14087,"_26884":51815,"_2862":51873},[],"`webhook response exceeds 1048576 bytes`",{"_3376":1197,"_29549":1174,"_20523":51875,"_5":14087,"_26884":51815,"_2862":51876},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3376":1198,"_29549":1174,"_20523":51878,"_5":14087,"_26884":51815,"_2862":51879},[],"`webhook config must not reference files`",{"_3376":1199,"_29549":1174,"_20523":51881,"_5":14087,"_26884":51815,"_2862":51882},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3376":1200,"_29549":1174,"_20523":51884,"_5":14087,"_26884":51815,"_2862":51885},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3376":1201,"_29549":1174,"_20523":51887,"_5":14087,"_26884":51815,"_2862":51888},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3376":1202,"_29549":1174,"_20523":51890,"_5":14087,"_26884":51815,"_2862":51891},[],"`webhook mTLS certificate and key are invalid: …`",{"_3376":1203,"_29549":1174,"_20523":51893,"_5":14087,"_26884":51815,"_2862":51894},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3376":1204,"_29549":1174,"_20523":51896,"_5":14087,"_26884":51815,"_2862":51897},[],"400 `struct validation error` creating or updating a DMS",{"_3376":1205,"_29549":1174,"_20523":51899,"_5":14087,"_26884":51815,"_2862":51900},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3376":1206,"_29549":1174,"_20523":51902,"_5":14087,"_26884":51815,"_2862":51903},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3376":1207,"_29549":1174,"_20523":51905,"_5":14087,"_26884":51815,"_2862":51906},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3376":1208,"_29549":1174,"_20523":51908,"_5":14087,"_26884":51815,"_2862":51909},[],"`device not preregistered`",{"_3376":1209,"_29549":1174,"_20523":51911,"_5":14087,"_26884":51815,"_2862":51912},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3376":1210,"_29549":1174,"_20523":51914,"_5":14087,"_26884":51815,"_2862":51915},[],"`forbiddenNewEnrollment`",{"_3376":1211,"_29549":1174,"_20523":51917,"_5":14087,"_26884":51815,"_2862":51918},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3376":1212,"_29549":1174,"_20523":51920,"_5":14087,"_26884":51815,"_2862":51921},[],"Different owning DMS",{"_3376":1213,"_29549":1174,"_20523":51923,"_5":14087,"_26884":51815,"_2862":51924},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3376":1214,"_29549":1174,"_20523":51926,"_5":14087,"_26884":51815,"_2862":51927},[],"`invalid RawSubject bytes`",{"_3376":1215,"_29549":1174,"_20523":51929,"_5":14087,"_26884":51815,"_2862":51930},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3376":1216,"_29549":1174,"_20523":51932,"_5":14087,"_26884":51815,"_2862":51933},[],"`invalid reenroll window`",{"_3376":1217,"_29549":1174,"_20523":51935,"_5":14087,"_26884":51815,"_2862":51936},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3376":1218,"_29549":1174,"_20523":51938,"_5":14087,"_26884":51815,"_2862":51939},[],"Current certificate revoked",{"_3376":1219,"_29549":1174,"_20523":51941,"_5":14087,"_26884":51815,"_2862":51942},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3376":1220,"_29549":1174,"_20523":51944,"_5":14087,"_26884":51815,"_2862":51945},[],"CA, profile or signing error",{"_3376":1221,"_29549":1174,"_20523":51947,"_5":14087,"_26884":51815,"_2862":51948},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3376":1222,"_29549":1174,"_20523":51950,"_5":14087,"_26884":51815,"_2862":51951},[],"HTTP 200 without a device connection",{"_3376":1223,"_29549":1174,"_20523":51953,"_5":14087,"_26884":51815,"_2862":51954},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3376":1224,"_29549":1174,"_20523":51956,"_5":14087,"_26884":51815,"_2862":51957},[],"Timeout or error after issuance",{"_3376":1225,"_29549":1174,"_20523":51959,"_5":14087,"_26884":51815,"_2862":51960},[],"New certificates, current slot and previous identity's state before retrying.",{"_3376":1226,"_29549":1174,"_20523":51962,"_5":14087,"_26884":51819,"_2862":51963},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3376":1227,"_29549":1174,"_20523":51965,"_5":14087,"_26884":51819,"_2862":51966},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3376":1228,"_29549":1174,"_20523":51968,"_5":14087,"_26884":51822,"_2862":51969},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3376":1229,"_29549":1174,"_20523":51971,"_5":14087,"_26884":51822,"_2862":51972},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3376":1230,"_29549":1174,"_20523":51974,"_5":14087,"_26884":51822,"_2862":51975},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3376":1231,"_29549":1174,"_20523":51977,"_5":14087,"_26884":51822,"_2862":51978},[],"Make one request, save headers/body and query the device and certificates.",{"_3376":1232,"_29549":1174,"_20523":51980,"_5":14087,"_26884":51822,"_2862":51981},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3376":1233,"_29549":1174,"_20523":51983,"_5":14087,"_26884":51822,"_2862":51984},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3376":1234,"_29549":1174,"_20523":51986,"_5":14087,"_26884":51822,"_2862":51987},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3376":1235,"_29549":1235,"_5":14445,"_2862":51989,"_29901":51990,"_20523":51991,"_26884":1235},"Trust distribution and updates",[48143,49611,50622,50620,50803],[],{"_3376":1236,"_29549":1235,"_20523":51993,"_5":14087,"_26884":1235,"_2862":51994},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3376":1237,"_29549":1235,"_5":29898,"_20523":51996,"_26884":51997,"_2862":51998},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3376":1238,"_29549":1235,"_5":29898,"_20523":52000,"_26884":52001,"_2862":52002},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3376":1239,"_29549":1235,"_5":29898,"_20523":52004,"_26884":52005,"_2862":52006},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3376":1240,"_29549":1235,"_5":29898,"_20523":52008,"_26884":52009,"_2862":52010},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3376":1241,"_29549":1235,"_5":29898,"_20523":52012,"_26884":52013,"_2862":52014},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3376":1242,"_29549":1235,"_20523":52016,"_5":14087,"_26884":1235,"_2862":52017},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3376":1243,"_29549":1235,"_20523":52019,"_5":14087,"_26884":51997,"_2862":52020},[],"Relationship",{"_3376":1244,"_29549":1235,"_20523":52022,"_5":14087,"_26884":51997,"_2862":52023},[],"Material prepared by its owner",{"_3376":1245,"_29549":1235,"_20523":52025,"_5":14087,"_26884":51997,"_2862":52026},[],"Device → EST server",{"_3376":1246,"_29549":1235,"_20523":52028,"_5":14087,"_26884":51997,"_2862":52029},[],"Previously verified server root, chain or pin and TLS name.",{"_3376":1247,"_29549":1235,"_20523":52031,"_5":14087,"_26884":51997,"_2862":52032},[],"DMS → requester",{"_3376":1248,"_29549":1235,"_20523":52034,"_5":14087,"_26884":51997,"_2862":52035},[],"CAs and rules authorizing initial or renewal credentials.",{"_3376":1249,"_29549":1235,"_20523":52037,"_5":14087,"_26884":51997,"_2862":52038},[],"Consumer → device",{"_3376":1250,"_29549":1235,"_20523":52040,"_5":14087,"_26884":51997,"_2862":52041},[],"Operational identity roots, intermediates, validation and permissions.",{"_3376":1251,"_29549":1235,"_20523":52043,"_5":14087,"_26884":51997,"_2862":52044},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3376":1252,"_29549":1235,"_20523":52046,"_5":14087,"_26884":52001,"_2862":52047},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3376":1253,"_29549":1235,"_20523":52049,"_5":14087,"_26884":52001,"_2862":52050},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3376":1254,"_29549":1235,"_20523":52052,"_5":14087,"_26884":52005,"_2862":52053},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3376":1255,"_29549":1235,"_20523":52055,"_5":14087,"_26884":52005,"_2862":52056},[],"Select policy-approved roots as anchors.",{"_3376":1256,"_29549":1235,"_20523":52058,"_5":14087,"_26884":52005,"_2862":52059},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3376":1257,"_29549":1235,"_20523":52061,"_5":14087,"_26884":52005,"_2862":52062},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3376":1258,"_29549":1235,"_20523":52064,"_5":14087,"_26884":52005,"_2862":52065},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3376":1259,"_29549":1235,"_20523":52067,"_5":14087,"_26884":52005,"_2862":52068},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3376":1260,"_29549":1235,"_20523":52070,"_5":14087,"_26884":52009,"_2862":52071},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3376":1261,"_29549":1235,"_20523":52073,"_5":14087,"_26884":52009,"_2862":52074},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3376":1262,"_29549":1235,"_20523":52076,"_5":14087,"_26884":52009,"_2862":52077},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3376":1263,"_29549":1235,"_20523":52079,"_5":14087,"_26884":52013,"_2862":52080},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3376":1264,"_29549":1264,"_5":14445,"_2862":52082,"_29901":52083,"_20523":52085,"_26884":1264},"AWS IoT Core",[48143,49611,50622,50620,52084],"Integrations",[],{"_3376":1265,"_29549":1264,"_20523":52087,"_5":14087,"_26884":1264,"_2862":52088},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3376":1266,"_29549":1264,"_5":29898,"_20523":52090,"_26884":52091,"_2862":52092},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3376":1267,"_29549":1264,"_5":29898,"_20523":52094,"_26884":52095,"_2862":52096},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3376":1268,"_29549":1264,"_5":29898,"_20523":52098,"_26884":52099,"_2862":52100},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3376":1269,"_29549":1264,"_5":29898,"_20523":52102,"_26884":52103,"_2862":52104},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3376":1270,"_29549":1264,"_5":29898,"_20523":52106,"_26884":52107,"_2862":52108},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#resource-state-machine","Resource state machine",{"_3376":1271,"_29549":1264,"_5":29898,"_20523":52110,"_26884":52111,"_2862":52112},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#events-the-connector-handles","Events the connector handles",{"_3376":1272,"_29549":1264,"_5":29898,"_20523":52114,"_26884":52115,"_2862":52116},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3376":1273,"_29549":1264,"_5":29898,"_20523":52118,"_26884":52119,"_2862":52120},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3376":1274,"_29549":1264,"_5":29898,"_20523":52122,"_26884":52123,"_2862":52124},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3376":1275,"_29549":1264,"_5":29898,"_20523":52126,"_26884":52127,"_2862":52128},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3376":1276,"_29549":1264,"_5":29898,"_20523":52130,"_26884":52131,"_2862":52132},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3376":1277,"_29549":1264,"_5":29898,"_20523":52134,"_26884":52135,"_2862":52136},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3376":1278,"_29549":1264,"_5":29898,"_20523":52138,"_26884":52139,"_2862":52140},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3376":1279,"_29549":1264,"_5":29898,"_20523":52142,"_26884":52143,"_2862":52144},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3376":1280,"_29549":1264,"_5":29898,"_20523":52146,"_26884":52147,"_2862":52148},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3376":1281,"_29549":1264,"_5":29898,"_20523":52150,"_26884":52151,"_2862":52152},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3376":1282,"_29549":1264,"_5":29898,"_20523":52154,"_26884":52155,"_2862":52156},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3376":1283,"_29549":1264,"_5":29898,"_20523":52158,"_26884":52159,"_2862":52160},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3376":1284,"_29549":1264,"_5":29898,"_20523":52162,"_26884":52163,"_2862":52164},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3376":1285,"_29549":1264,"_5":29898,"_20523":52166,"_26884":52167,"_2862":52168},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3376":1286,"_29549":1264,"_5":29898,"_20523":52170,"_26884":52171,"_2862":52172},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3376":1287,"_29549":1264,"_5":29898,"_20523":52174,"_26884":52175,"_2862":52176},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3376":1288,"_29549":1264,"_5":29898,"_20523":52178,"_26884":52179,"_2862":52180},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3376":1289,"_29549":1264,"_5":29898,"_20523":52182,"_26884":52183,"_2862":52184},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3376":1290,"_29549":1264,"_5":29898,"_20523":52186,"_26884":52187,"_2862":52188},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3376":1291,"_29549":1264,"_5":29898,"_20523":52190,"_26884":52191,"_2862":52192},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3376":1292,"_29549":1264,"_20523":52194,"_5":14087,"_26884":1264,"_2862":52195},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3376":1293,"_29549":1264,"_20523":52197,"_5":14087,"_26884":1264,"_2862":52198},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3376":1294,"_29549":1264,"_20523":52200,"_5":14087,"_26884":1264,"_2862":52201},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3376":1295,"_29549":1264,"_20523":52203,"_5":14087,"_26884":52091,"_2862":52204},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3376":1296,"_29549":1264,"_20523":52206,"_5":14087,"_26884":52091,"_2862":52207},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3376":1297,"_29549":1264,"_20523":52209,"_5":14087,"_26884":52091,"_2862":52210},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3376":1298,"_29549":1264,"_20523":52212,"_5":14087,"_26884":52091,"_2862":52213},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3376":1299,"_29549":1264,"_20523":52215,"_5":14087,"_26884":52095,"_2862":52216},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3376":1300,"_29549":1264,"_20523":52218,"_5":14087,"_26884":52099,"_2862":52219},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3376":1301,"_29549":1264,"_20523":52221,"_5":14087,"_26884":52099,"_2862":52222},[],"IAM action",{"_3376":1302,"_29549":1264,"_20523":52224,"_5":14087,"_26884":52099,"_2862":48533},[],{"_3376":1303,"_29549":1264,"_20523":52226,"_5":14087,"_26884":52099,"_2862":52227},[],"`iot:GetRegistrationCode`",{"_3376":1304,"_29549":1264,"_20523":52229,"_5":14087,"_26884":52099,"_2862":52230},[],"Obtain the verification code for CA registration in the Primary Account",{"_3376":1305,"_29549":1264,"_20523":52232,"_5":14087,"_26884":52099,"_2862":52233},[],"`iot:RegisterCACertificate`",{"_3376":1306,"_29549":1264,"_20523":52235,"_5":14087,"_26884":52099,"_2862":52236},[],"Register the CA in AWS IoT",{"_3376":1307,"_29549":1264,"_20523":52238,"_5":14087,"_26884":52099,"_2862":52239},[],"`iot:DescribeCACertificate`",{"_3376":1308,"_29549":1264,"_20523":52241,"_5":14087,"_26884":52099,"_2862":52242},[],"Check the CA registration status",{"_3376":1309,"_29549":1264,"_20523":52244,"_5":14087,"_26884":52099,"_2862":52245},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3376":1310,"_29549":1264,"_20523":52247,"_5":14087,"_26884":52099,"_2862":52248},[],"Create or update Things in IoT Core",{"_3376":1311,"_29549":1264,"_20523":52250,"_5":14087,"_26884":52099,"_2862":52251},[],"`iot:RegisterThing`",{"_3376":1312,"_29549":1264,"_20523":52253,"_5":14087,"_26884":52099,"_2862":52254},[],"Provision Things through a template",{"_3376":1313,"_29549":1264,"_20523":52256,"_5":14087,"_26884":52099,"_2862":52257},[],"`iot:RegisterCertificate`",{"_3376":1314,"_29549":1264,"_20523":52259,"_5":14087,"_26884":52099,"_2862":52260},[],"Register device certificates",{"_3376":1315,"_29549":1264,"_20523":52262,"_5":14087,"_26884":52099,"_2862":52263},[],"`iot:UpdateCertificate`",{"_3376":1316,"_29549":1264,"_20523":52265,"_5":14087,"_26884":52099,"_2862":52266},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3376":1317,"_29549":1264,"_20523":52268,"_5":14087,"_26884":52099,"_2862":52269},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3376":1318,"_29549":1264,"_20523":52271,"_5":14087,"_26884":52099,"_2862":52272},[],"Create and attach IoT policies",{"_3376":1319,"_29549":1264,"_20523":52274,"_5":14087,"_26884":52099,"_2862":52275},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3376":1320,"_29549":1264,"_20523":52277,"_5":14087,"_26884":52099,"_2862":52278},[],"Manage Thing groups",{"_3376":1321,"_29549":1264,"_20523":52280,"_5":14087,"_26884":52099,"_2862":52281},[],"`iot:CreateProvisioningTemplate`",{"_3376":1322,"_29549":1264,"_20523":52283,"_5":14087,"_26884":52099,"_2862":52284},[],"Create JITP templates",{"_3376":1323,"_29549":1264,"_20523":52286,"_5":14087,"_26884":52099,"_2862":52287},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3376":1324,"_29549":1264,"_20523":52289,"_5":14087,"_26884":52099,"_2862":52290},[],"Read and write the Device Shadow",{"_3376":1325,"_29549":1264,"_20523":52292,"_5":14087,"_26884":52099,"_2862":52293},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3376":1326,"_29549":1264,"_20523":52295,"_5":14087,"_26884":52103,"_2862":52296},[],"Parameter",{"_3376":1327,"_29549":1264,"_20523":52298,"_5":14087,"_26884":52103,"_2862":52299},[],"Type",{"_3376":1328,"_29549":1264,"_20523":52301,"_5":14087,"_26884":52103,"_2862":52302},[],"Required",{"_3376":1329,"_29549":1264,"_20523":52304,"_5":14087,"_26884":52103,"_2862":52305},[],"Description",{"_3376":1330,"_29549":1264,"_20523":52307,"_5":14087,"_26884":52103,"_2862":52308},[],"`connector_id`",{"_3376":1331,"_29549":1264,"_20523":52310,"_5":14087,"_26884":52103,"_2862":24522},[],{"_3376":1332,"_29549":1264,"_20523":52312,"_5":14087,"_26884":52103,"_2862":52313},[],"Yes",{"_3376":1333,"_29549":1264,"_20523":52315,"_5":14087,"_26884":52103,"_2862":52316},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3376":1334,"_29549":1264,"_20523":52318,"_5":14087,"_26884":52103,"_2862":52319},[],"`aws_config.region`",{"_3376":1335,"_29549":1264,"_20523":52321,"_5":14087,"_26884":52103,"_2862":24522},[],{"_3376":1336,"_29549":1264,"_20523":52323,"_5":14087,"_26884":52103,"_2862":52313},[],{"_3376":1337,"_29549":1264,"_20523":52325,"_5":14087,"_26884":52103,"_2862":52326},[],"AWS region where the connector operates.",{"_3376":1338,"_29549":1264,"_20523":52328,"_5":14087,"_26884":52103,"_2862":52329},[],"`aws_config.auth_method`",{"_3376":1339,"_29549":1264,"_20523":52331,"_5":14087,"_26884":52103,"_2862":24522},[],{"_3376":1340,"_29549":1264,"_20523":52333,"_5":14087,"_26884":52103,"_2862":52313},[],{"_3376":1341,"_29549":1264,"_20523":52335,"_5":14087,"_26884":52103,"_2862":52336},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3376":1342,"_29549":1264,"_20523":52338,"_5":14087,"_26884":52103,"_2862":52339},[],"`aws_config.access_key_id`",{"_3376":1343,"_29549":1264,"_20523":52341,"_5":14087,"_26884":52103,"_2862":24522},[],{"_3376":1344,"_29549":1264,"_20523":52343,"_5":14087,"_26884":52103,"_2862":52344},[],"Only with `auth_method=static`",{"_3376":1345,"_29549":1264,"_20523":52346,"_5":14087,"_26884":52103,"_2862":52347},[],"AWS access key.",{"_3376":1346,"_29549":1264,"_20523":52349,"_5":14087,"_26884":52103,"_2862":52350},[],"`aws_config.secret_access_key`",{"_3376":1347,"_29549":1264,"_20523":52352,"_5":14087,"_26884":52103,"_2862":24522},[],{"_3376":1348,"_29549":1264,"_20523":52354,"_5":14087,"_26884":52103,"_2862":52344},[],{"_3376":1349,"_29549":1264,"_20523":52356,"_5":14087,"_26884":52103,"_2862":52357},[],"AWS secret key.",{"_3376":1350,"_29549":1264,"_20523":52359,"_5":14087,"_26884":52103,"_2862":52360},[],"`aws_config.session_token`",{"_3376":1351,"_29549":1264,"_20523":52362,"_5":14087,"_26884":52103,"_2862":24522},[],{"_3376":1352,"_29549":1264,"_20523":52364,"_5":14087,"_26884":52103,"_2862":52365},[],"No",{"_3376":1353,"_29549":1264,"_20523":52367,"_5":14087,"_26884":52103,"_2862":52368},[],"Session token (with `auth_method=static`).",{"_3376":1354,"_29549":1264,"_20523":52370,"_5":14087,"_26884":52103,"_2862":52371},[],"`aws_config.role_arn`",{"_3376":1355,"_29549":1264,"_20523":52373,"_5":14087,"_26884":52103,"_2862":24522},[],{"_3376":1356,"_29549":1264,"_20523":52375,"_5":14087,"_26884":52103,"_2862":52376},[],"Only with `auth_method=role`",{"_3376":1357,"_29549":1264,"_20523":52378,"_5":14087,"_26884":52103,"_2862":52379},[],"ARN of the role to assume.",{"_3376":1358,"_29549":1264,"_20523":52381,"_5":14087,"_26884":52103,"_2862":52382},[],"`aws_config.endpoint_url`",{"_3376":1359,"_29549":1264,"_20523":52384,"_5":14087,"_26884":52103,"_2862":24522},[],{"_3376":1360,"_29549":1264,"_20523":52386,"_5":14087,"_26884":52103,"_2862":52365},[],{"_3376":1361,"_29549":1264,"_20523":52388,"_5":14087,"_26884":52103,"_2862":52389},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3376":1362,"_29549":1264,"_20523":52391,"_5":14087,"_26884":52103,"_2862":52392},[],"`subscriber_event_bus`",{"_3376":1363,"_29549":1264,"_20523":52394,"_5":14087,"_26884":52103,"_2862":17284},[],{"_3376":1364,"_29549":1264,"_20523":52396,"_5":14087,"_26884":52103,"_2862":52313},[],{"_3376":1365,"_29549":1264,"_20523":52398,"_5":14087,"_26884":52103,"_2862":52399},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3376":1366,"_29549":1264,"_20523":52401,"_5":14087,"_26884":52103,"_2862":52402},[],"`dms_manager_client`",{"_3376":1367,"_29549":1264,"_20523":52404,"_5":14087,"_26884":52103,"_2862":24522},[],{"_3376":1368,"_29549":1264,"_20523":52406,"_5":14087,"_26884":52103,"_2862":52313},[],{"_3376":1369,"_29549":1264,"_20523":52408,"_5":14087,"_26884":52103,"_2862":52409},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3376":1370,"_29549":1264,"_20523":52411,"_5":14087,"_26884":52103,"_2862":52412},[],"`device_manager_client`",{"_3376":1371,"_29549":1264,"_20523":52414,"_5":14087,"_26884":52103,"_2862":24522},[],{"_3376":1372,"_29549":1264,"_20523":52416,"_5":14087,"_26884":52103,"_2862":52313},[],{"_3376":1373,"_29549":1264,"_20523":52418,"_5":14087,"_26884":52103,"_2862":52419},[],"HTTP URL of Lamassu's Device Manager.",{"_3376":1374,"_29549":1264,"_20523":52421,"_5":14087,"_26884":52103,"_2862":52422},[],"`ca_client`",{"_3376":1375,"_29549":1264,"_20523":52424,"_5":14087,"_26884":52103,"_2862":24522},[],{"_3376":1376,"_29549":1264,"_20523":52426,"_5":14087,"_26884":52103,"_2862":52313},[],{"_3376":1377,"_29549":1264,"_20523":52428,"_5":14087,"_26884":52103,"_2862":52429},[],"HTTP URL of Lamassu's CA service.",{"_3376":1378,"_29549":1264,"_20523":52431,"_5":14087,"_26884":52107,"_2862":52432},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each transition performs. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3376":1379,"_29549":1264,"_20523":52434,"_5":14087,"_26884":52111,"_2862":52435},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3376":1380,"_29549":1264,"_20523":52437,"_5":14087,"_26884":52111,"_2862":52438},[],"CloudEvent type",{"_3376":1381,"_29549":1264,"_20523":52440,"_5":14087,"_26884":52111,"_2862":52441},[],"Lamassu resource",{"_3376":1382,"_29549":1264,"_20523":52443,"_5":14087,"_26884":52111,"_2862":52444},[],"AWS Resource",{"_3376":1383,"_29549":1264,"_20523":52446,"_5":14087,"_26884":52111,"_2862":52447},[],"IAM actions",{"_3376":1384,"_29549":1264,"_20523":52449,"_5":14087,"_26884":52111,"_2862":52450},[],"AWS calls and effect",{"_3376":1385,"_29549":1264,"_20523":52452,"_5":14087,"_26884":52111,"_2862":52453},[],"Where in this page",{"_3376":1386,"_29549":1264,"_20523":52455,"_5":14087,"_26884":52111,"_2862":52456},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3376":1387,"_29549":1264,"_20523":52458,"_5":14087,"_26884":52111,"_2862":52459},[],"CA",{"_3376":1388,"_29549":1264,"_20523":52461,"_5":14087,"_26884":52111,"_2862":52462},[],"`IoTCore/CACertificate`",{"_3376":1389,"_29549":1264,"_20523":52464,"_5":14087,"_26884":52111,"_2862":52465},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3376":1390,"_29549":1264,"_20523":52467,"_5":14087,"_26884":52111,"_2862":52468},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3376":1391,"_29549":1264,"_20523":52470,"_5":14087,"_26884":52111,"_2862":52116},[],{"_3376":1392,"_29549":1264,"_20523":52472,"_5":14087,"_26884":52111,"_2862":52473},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3376":1393,"_29549":1264,"_20523":52475,"_5":14087,"_26884":52111,"_2862":52476},[],"DMS",{"_3376":1394,"_29549":1264,"_20523":52478,"_5":14087,"_26884":52111,"_2862":52479},[],"`IoTCore/ProvisioningTemplate`",{"_3376":1395,"_29549":1264,"_20523":52481,"_5":14087,"_26884":52111,"_2862":52482},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3376":1396,"_29549":1264,"_20523":52484,"_5":14087,"_26884":52111,"_2862":52485},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3376":1397,"_29549":1264,"_20523":52487,"_5":14087,"_26884":52111,"_2862":52120},[],{"_3376":1398,"_29549":1264,"_20523":52489,"_5":14087,"_26884":52111,"_2862":52490},[],"`EventBindDeviceIdentityKey`",{"_3376":1399,"_29549":1264,"_20523":52492,"_5":14087,"_26884":52111,"_2862":52493},[],"Device",{"_3376":1400,"_29549":1264,"_20523":52495,"_5":14087,"_26884":52111,"_2862":52496},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3376":1401,"_29549":1264,"_20523":52498,"_5":14087,"_26884":52111,"_2862":52499},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3376":1402,"_29549":1264,"_20523":52501,"_5":14087,"_26884":52111,"_2862":52502},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3376":1403,"_29549":1264,"_20523":52504,"_5":14087,"_26884":52111,"_2862":52128},[],{"_3376":1404,"_29549":1264,"_20523":52506,"_5":14087,"_26884":52111,"_2862":52507},[],"`EventUpdateCertificateStatusKey`",{"_3376":1405,"_29549":1264,"_20523":52509,"_5":14087,"_26884":52111,"_2862":52510},[],"Certificate",{"_3376":1406,"_29549":1264,"_20523":52512,"_5":14087,"_26884":52111,"_2862":52513},[],"`IoTCore/Certificate`",{"_3376":1407,"_29549":1264,"_20523":52515,"_5":14087,"_26884":52111,"_2862":52516},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3376":1408,"_29549":1264,"_20523":52518,"_5":14087,"_26884":52111,"_2862":52519},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3376":1409,"_29549":1264,"_20523":52521,"_5":14087,"_26884":52111,"_2862":52124},[],{"_3376":1410,"_29549":1264,"_20523":52523,"_5":14087,"_26884":52111,"_2862":52524},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3376":1411,"_29549":1264,"_20523":52526,"_5":14087,"_26884":52111,"_2862":52527},[],"Certificate / Device",{"_3376":1412,"_29549":1264,"_20523":52529,"_5":14087,"_26884":52111,"_2862":52530},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3376":1413,"_29549":1264,"_20523":52532,"_5":14087,"_26884":52111,"_2862":48539},[],{"_3376":1414,"_29549":1264,"_20523":52534,"_5":14087,"_26884":52111,"_2862":52535},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3376":1415,"_29549":1264,"_20523":52537,"_5":14087,"_26884":52111,"_2862":52180},[],{"_3376":1416,"_29549":1264,"_20523":52539,"_5":14087,"_26884":52115,"_2862":52540},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3376":1417,"_29549":1264,"_20523":52542,"_5":14087,"_26884":52115,"_2862":52543},[],"by the `registration.status` field of the CA's connector metadata:",{"_3376":1418,"_29549":1264,"_20523":52545,"_5":14087,"_26884":52115,"_2862":52546},[],"Transition",{"_3376":1419,"_29549":1264,"_20523":52548,"_5":14087,"_26884":52115,"_2862":52549},[],"AWS calls",{"_3376":1420,"_29549":1264,"_20523":52551,"_5":14087,"_26884":52115,"_2862":52552},[],"`NotRegistered` → `Requested`",{"_3376":1421,"_29549":1264,"_20523":52554,"_5":14087,"_26884":52115,"_2862":52555},[],"none (metadata write only)",{"_3376":1422,"_29549":1264,"_20523":52557,"_5":14087,"_26884":52115,"_2862":52558},[],"`Requested` → `Registering`",{"_3376":1423,"_29549":1264,"_20523":52560,"_5":14087,"_26884":52115,"_2862":52561},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3376":1424,"_29549":1264,"_20523":52563,"_5":14087,"_26884":52115,"_2862":52564},[],"`Registering` → `Succeeded`",{"_3376":1425,"_29549":1264,"_20523":52566,"_5":14087,"_26884":52115,"_2862":52567},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3376":1426,"_29549":1264,"_20523":52569,"_5":14087,"_26884":52115,"_2862":52570},[],"`Registering` → `Failed`",{"_3376":1427,"_29549":1264,"_20523":52572,"_5":14087,"_26884":52115,"_2862":52573},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3376":1428,"_29549":1264,"_20523":52575,"_5":14087,"_26884":52115,"_2862":52576},[],"`Failed` / `Succeeded` → `Requested`",{"_3376":1429,"_29549":1264,"_20523":52578,"_5":14087,"_26884":52115,"_2862":52579},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3376":1430,"_29549":1264,"_20523":52581,"_5":14087,"_26884":52119,"_2862":52582},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3376":1431,"_29549":1264,"_20523":52584,"_5":14087,"_26884":52119,"_2862":52546},[],{"_3376":1432,"_29549":1264,"_20523":52586,"_5":14087,"_26884":52119,"_2862":52549},[],{"_3376":1433,"_29549":1264,"_20523":52588,"_5":14087,"_26884":52119,"_2862":52589},[],"`Unconfigured` → `None` / `Auto`",{"_3376":1434,"_29549":1264,"_20523":52591,"_5":14087,"_26884":52119,"_2862":52592},[],"none (configuration only)",{"_3376":1435,"_29549":1264,"_20523":52594,"_5":14087,"_26884":52119,"_2862":52595},[],"`None` ↔ `Auto`",{"_3376":1436,"_29549":1264,"_20523":52597,"_5":14087,"_26884":52119,"_2862":52592},[],{"_3376":1437,"_29549":1264,"_20523":52599,"_5":14087,"_26884":52119,"_2862":52600},[],"Any → `Jitp`",{"_3376":1438,"_29549":1264,"_20523":52602,"_5":14087,"_26884":52119,"_2862":52603},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3376":1439,"_29549":1264,"_20523":52605,"_5":14087,"_26884":52119,"_2862":52606},[],"`Jitp` → `None` / `Auto`",{"_3376":1440,"_29549":1264,"_20523":52608,"_5":14087,"_26884":52119,"_2862":52609},[],"none (the template stays in the AWS account)",{"_3376":1441,"_29549":1264,"_20523":52611,"_5":14087,"_26884":52123,"_2862":52612},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3376":1442,"_29549":1264,"_20523":52614,"_5":14087,"_26884":52123,"_2862":52546},[],{"_3376":1443,"_29549":1264,"_20523":52616,"_5":14087,"_26884":52123,"_2862":52549},[],{"_3376":1444,"_29549":1264,"_20523":52618,"_5":14087,"_26884":52123,"_2862":52619},[],"`NotSynced` → `Active`",{"_3376":1445,"_29549":1264,"_20523":52621,"_5":14087,"_26884":52123,"_2862":52263},[],{"_3376":1446,"_29549":1264,"_20523":52623,"_5":14087,"_26884":52123,"_2862":52624},[],"`Active` → `Inactive`",{"_3376":1447,"_29549":1264,"_20523":52626,"_5":14087,"_26884":52123,"_2862":52627},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3376":1448,"_29549":1264,"_20523":52629,"_5":14087,"_26884":52123,"_2862":52630},[],"`Active` → `Revoked`",{"_3376":1449,"_29549":1264,"_20523":52632,"_5":14087,"_26884":52123,"_2862":52627},[],{"_3376":1450,"_29549":1264,"_20523":52634,"_5":14087,"_26884":52123,"_2862":52635},[],"`Inactive` / `Revoked` → `Active`",{"_3376":1451,"_29549":1264,"_20523":52637,"_5":14087,"_26884":52123,"_2862":52263},[],{"_3376":1452,"_29549":1264,"_20523":52639,"_5":14087,"_26884":52123,"_2862":52640},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3376":1453,"_29549":1264,"_20523":52642,"_5":14087,"_26884":52123,"_2862":52643},[],"none (these states are not synced to AWS)",{"_3376":1454,"_29549":1264,"_20523":52645,"_5":14087,"_26884":52127,"_2862":52646},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3376":1455,"_29549":1264,"_20523":52648,"_5":14087,"_26884":52127,"_2862":52546},[],{"_3376":1456,"_29549":1264,"_20523":52650,"_5":14087,"_26884":52127,"_2862":52549},[],{"_3376":1457,"_29549":1264,"_20523":52652,"_5":14087,"_26884":52127,"_2862":52653},[],"`Absent` → `Provisioned`",{"_3376":1458,"_29549":1264,"_20523":52655,"_5":14087,"_26884":52127,"_2862":52656},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3376":1459,"_29549":1264,"_20523":52658,"_5":14087,"_26884":52127,"_2862":52659},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3376":1460,"_29549":1264,"_20523":52661,"_5":14087,"_26884":52127,"_2862":52662},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3376":1461,"_29549":1264,"_20523":52664,"_5":14087,"_26884":52127,"_2862":52665},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3376":1462,"_29549":1264,"_20523":52667,"_5":14087,"_26884":52131,"_2862":52668},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3376":1463,"_29549":1264,"_20523":52670,"_5":14087,"_26884":52135,"_2862":52671},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3376":1464,"_29549":1264,"_20523":52673,"_5":14087,"_26884":52135,"_2862":52674},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3376":1465,"_29549":1264,"_20523":52676,"_5":14087,"_26884":52139,"_2862":52677},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3376":1466,"_29549":1264,"_20523":52679,"_5":14087,"_26884":52139,"_2862":52680},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3376":1467,"_29549":1264,"_20523":52682,"_5":14087,"_26884":52139,"_2862":52683},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3376":1468,"_29549":1264,"_20523":52685,"_5":14087,"_26884":52139,"_2862":52686},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3376":1469,"_29549":1264,"_20523":52688,"_5":14087,"_26884":52139,"_2862":52689},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3376":1470,"_29549":1264,"_20523":52691,"_5":14087,"_26884":52139,"_2862":52692},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3376":1471,"_29549":1264,"_20523":52694,"_5":14087,"_26884":52143,"_2862":52695},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3376":1472,"_29549":1264,"_20523":52697,"_5":14087,"_26884":52147,"_2862":52698},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3376":1473,"_29549":1264,"_20523":52700,"_5":14087,"_26884":52147,"_2862":52701},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3376":1474,"_29549":1264,"_20523":52703,"_5":14087,"_26884":52151,"_2862":52704},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3376":1475,"_29549":1264,"_20523":52706,"_5":14087,"_26884":52155,"_2862":52707},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3376":1476,"_29549":1264,"_20523":52709,"_5":14087,"_26884":52155,"_2862":52710},[],"Creates or updates the IoT policies configured in the DMS.",{"_3376":1477,"_29549":1264,"_20523":52712,"_5":14087,"_26884":52155,"_2862":52713},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3376":1478,"_29549":1264,"_20523":52715,"_5":14087,"_26884":52155,"_2862":52716},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3376":1479,"_29549":1264,"_20523":52718,"_5":14087,"_26884":52155,"_2862":52719},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3376":1480,"_29549":1264,"_20523":52721,"_5":14087,"_26884":52155,"_2862":52722},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3376":1481,"_29549":1264,"_20523":52724,"_5":14087,"_26884":52155,"_2862":52725},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3376":1482,"_29549":1264,"_20523":52727,"_5":14087,"_26884":52159,"_2862":52728},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3376":1483,"_29549":1264,"_20523":52730,"_5":14087,"_26884":52159,"_2862":52731},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3376":1484,"_29549":1264,"_20523":52733,"_5":14087,"_26884":52159,"_2862":52734},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3376":1485,"_29549":1264,"_20523":52736,"_5":14087,"_26884":52159,"_2862":52737},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3376":1486,"_29549":1264,"_20523":52739,"_5":14087,"_26884":52159,"_2862":52740},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3376":1487,"_29549":1264,"_20523":52742,"_5":14087,"_26884":52163,"_2862":52743},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3376":1488,"_29549":1264,"_20523":52745,"_5":14087,"_26884":52163,"_2862":52746},[],"The full flow from the device's perspective is:",{"_3376":1489,"_29549":1264,"_20523":52748,"_5":14087,"_26884":52163,"_2862":52749},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3376":1490,"_29549":1264,"_20523":52751,"_5":14087,"_26884":52167,"_2862":52752},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3376":1491,"_29549":1264,"_20523":52754,"_5":14087,"_26884":52167,"_2862":52755},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3376":1492,"_29549":1264,"_20523":52757,"_5":14087,"_26884":52167,"_2862":52758},[],"For the JITP flow to work correctly:",{"_3376":1493,"_29549":1264,"_20523":52760,"_5":14087,"_26884":52167,"_2862":52761},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3376":1494,"_29549":1264,"_20523":52763,"_5":14087,"_26884":52167,"_2862":52764},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3376":1495,"_29549":1264,"_20523":52766,"_5":14087,"_26884":52167,"_2862":52767},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3376":1496,"_29549":1264,"_20523":52769,"_5":14087,"_26884":52167,"_2862":52770},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3376":1497,"_29549":1264,"_20523":52772,"_5":14087,"_26884":52171,"_2862":52773},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3376":1498,"_29549":1264,"_20523":52775,"_5":14087,"_26884":52171,"_2862":52776},[],"Status in Lamassu",{"_3376":1499,"_29549":1264,"_20523":52778,"_5":14087,"_26884":52171,"_2862":52779},[],"Revocation reason",{"_3376":1500,"_29549":1264,"_20523":52781,"_5":14087,"_26884":52171,"_2862":52782},[],"Status in AWS IoT Core",{"_3376":1501,"_29549":1264,"_20523":52784,"_5":14087,"_26884":52171,"_2862":52785},[],"`Active`",{"_3376":1502,"_29549":1264,"_20523":52787,"_5":14087,"_26884":52171,"_2862":52788},[],"None",{"_3376":1503,"_29549":1264,"_20523":52790,"_5":14087,"_26884":52171,"_2862":52791},[],"`ACTIVE`",{"_3376":1504,"_29549":1264,"_20523":52793,"_5":14087,"_26884":52171,"_2862":52794},[],"`Revoked`",{"_3376":1505,"_29549":1264,"_20523":52796,"_5":14087,"_26884":52171,"_2862":52797},[],"`certificateHold`",{"_3376":1506,"_29549":1264,"_20523":52799,"_5":14087,"_26884":52171,"_2862":52800},[],"`INACTIVE`",{"_3376":1507,"_29549":1264,"_20523":52802,"_5":14087,"_26884":52171,"_2862":52794},[],{"_3376":1508,"_29549":1264,"_20523":52804,"_5":14087,"_26884":52171,"_2862":52805},[],"Any other reason",{"_3376":1509,"_29549":1264,"_20523":52807,"_5":14087,"_26884":52171,"_2862":52808},[],"`REVOKED`",{"_3376":1510,"_29549":1264,"_20523":52810,"_5":14087,"_26884":52171,"_2862":52811},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3376":1511,"_29549":1264,"_20523":52813,"_5":14087,"_26884":52175,"_2862":52814},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3376":1512,"_29549":1264,"_20523":52816,"_5":14087,"_26884":52175,"_2862":52817},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3376":1513,"_29549":1264,"_20523":52819,"_5":14087,"_26884":52175,"_2862":52820},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3376":1514,"_29549":1264,"_20523":52822,"_5":14087,"_26884":52179,"_2862":52823},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3376":1515,"_29549":1264,"_20523":52825,"_5":14087,"_26884":52179,"_2862":52826},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3376":1516,"_29549":1264,"_20523":52828,"_5":14087,"_26884":52183,"_2862":52829},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3376":1517,"_29549":1264,"_20523":52831,"_5":14087,"_26884":52183,"_2862":52832},[],"There are two action types:",{"_3376":1518,"_29549":1264,"_20523":52834,"_5":14087,"_26884":52183,"_2862":52835},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3376":1519,"_29549":1264,"_20523":52837,"_5":14087,"_26884":52183,"_2862":52838},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3376":1520,"_29549":1264,"_20523":52840,"_5":14087,"_26884":52183,"_2862":52841},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3376":1521,"_29549":1264,"_20523":52843,"_5":14087,"_26884":52187,"_2862":52844},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3376":1522,"_29549":1264,"_20523":52846,"_5":14087,"_26884":52187,"_2862":52847},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3376":1523,"_29549":1264,"_20523":52849,"_5":14087,"_26884":52187,"_2862":52850},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3376":1524,"_29549":1264,"_20523":52852,"_5":14087,"_26884":52191,"_2862":52853},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3376":1525,"_29549":1264,"_20523":52855,"_5":14087,"_26884":52191,"_2862":52856},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3376":1526,"_29549":1264,"_20523":52858,"_5":14087,"_26884":52191,"_2862":52859},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3376":1527,"_29549":1264,"_20523":52861,"_5":14087,"_26884":52191,"_2862":52862},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3376":1528,"_29549":1264,"_20523":52864,"_5":14087,"_26884":52191,"_2862":52865},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3376":1529,"_29549":1264,"_20523":52867,"_5":14087,"_26884":52191,"_2862":52868},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3376":1530,"_29549":1264,"_20523":52870,"_5":14087,"_26884":52191,"_2862":52871},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3376":1531,"_29549":1264,"_20523":52873,"_5":14087,"_26884":52191,"_2862":52874},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3376":1532,"_29549":1264,"_20523":52876,"_5":14087,"_26884":52191,"_2862":52877},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3376":1533,"_29549":1264,"_20523":52879,"_5":14087,"_26884":52191,"_2862":52880},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3376":1534,"_29549":1264,"_20523":52882,"_5":14087,"_26884":52191,"_2862":52883},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3376":1535,"_29549":1264,"_20523":52885,"_5":14087,"_26884":52191,"_2862":52886},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3376":1536,"_29549":1264,"_20523":52888,"_5":14087,"_26884":52191,"_2862":52889},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3376":1537,"_29549":1264,"_20523":52891,"_5":14087,"_26884":52191,"_2862":52892},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3376":1538,"_29549":1264,"_20523":52894,"_5":14087,"_26884":52191,"_2862":52895},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3376":1539,"_29549":1264,"_20523":52897,"_5":14087,"_26884":52191,"_2862":52898},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3376":1540,"_29549":1264,"_20523":52900,"_5":14087,"_26884":52191,"_2862":52901},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3376":1541,"_29549":1264,"_20523":52903,"_5":14087,"_26884":52191,"_2862":52904},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3376":1542,"_29549":1264,"_20523":52906,"_5":14087,"_26884":52191,"_2862":52907},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3376":1543,"_29549":1264,"_20523":52909,"_5":14087,"_26884":52191,"_2862":52910},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3376":1544,"_29549":1264,"_20523":52912,"_5":14087,"_26884":52191,"_2862":52913},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3376":1545,"_29549":1264,"_20523":52915,"_5":14087,"_26884":52191,"_2862":52916},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3376":1546,"_29549":1264,"_20523":52918,"_5":14087,"_26884":52191,"_2862":52919},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3376":1547,"_29549":1264,"_20523":52921,"_5":14087,"_26884":52191,"_2862":52922},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3376":1548,"_29549":1548,"_5":14445,"_2862":50622,"_29901":52924,"_20523":52925,"_26884":1548},[48143,49611,50622],[],{"_3376":1549,"_29549":1548,"_20523":52927,"_5":14087,"_26884":1548,"_2862":52928},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3376":1550,"_29549":1548,"_5":29898,"_20523":52930,"_26884":52931,"_2862":52932},[],"/docs/pr-preview/pr-52/platform/iot-fleets/overview#start-here","Start here",{"_3376":1551,"_29549":1548,"_5":29898,"_20523":52934,"_26884":52935,"_2862":50620},[],"/docs/pr-preview/pr-52/platform/iot-fleets/overview#devices-and-identities",{"_3376":1552,"_29549":1548,"_5":29898,"_20523":52937,"_26884":52938,"_2862":50803},[],"/docs/pr-preview/pr-52/platform/iot-fleets/overview#enrollment-with-pki",{"_3376":1553,"_29549":1548,"_5":29898,"_20523":52940,"_26884":52941,"_2862":52084},[],"/docs/pr-preview/pr-52/platform/iot-fleets/overview#integrations",{"_3376":1554,"_29549":1548,"_5":29898,"_20523":52943,"_26884":52944,"_2862":52945},[],"/docs/pr-preview/pr-52/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3376":1555,"_29549":1548,"_20523":52947,"_5":14087,"_26884":1548,"_2862":52948},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3376":1556,"_29549":1548,"_20523":52950,"_5":14087,"_26884":52931,"_2862":52951},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3376":1557,"_29549":1548,"_20523":52953,"_5":14087,"_26884":52931,"_2862":52954},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3376":1558,"_29549":1548,"_20523":52956,"_5":14087,"_26884":52935,"_2862":52957},[],"Resource",{"_3376":1559,"_29549":1548,"_20523":52959,"_5":14087,"_26884":52935,"_2862":52960},[],"What it represents",{"_3376":1560,"_29549":1548,"_20523":52962,"_5":14087,"_26884":52935,"_2862":52963},[],"**Device**",{"_3376":1561,"_29549":1548,"_20523":52965,"_5":14087,"_26884":52935,"_2862":52966},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3376":1562,"_29549":1548,"_20523":52968,"_5":14087,"_26884":52935,"_2862":52969},[],"**Identity**",{"_3376":1563,"_29549":1548,"_20523":52971,"_5":14087,"_26884":52935,"_2862":52972},[],"The device's association with its certificates: an active version and a history.",{"_3376":1564,"_29549":1548,"_20523":52974,"_5":14087,"_26884":52935,"_2862":52975},[],"**DMS**",{"_3376":1565,"_29549":1548,"_20523":52977,"_5":14087,"_26884":52935,"_2862":52978},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3376":1566,"_29549":1548,"_20523":52980,"_5":14087,"_26884":52935,"_2862":52981},[],"**Fleet**",{"_3376":1567,"_29549":1548,"_20523":52983,"_5":14087,"_26884":52935,"_2862":52984},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3376":1568,"_29549":1548,"_20523":52986,"_5":14087,"_26884":52935,"_2862":52987},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3376":1569,"_29549":1548,"_20523":52989,"_5":14087,"_26884":52935,"_2862":52990},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3376":1570,"_29549":1548,"_20523":52992,"_5":14087,"_26884":52938,"_2862":52993},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3376":1571,"_29549":1548,"_20523":52995,"_5":14087,"_26884":52938,"_2862":52996},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3376":1572,"_29549":1548,"_20523":52998,"_5":14087,"_26884":52938,"_2862":52999},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3376":1573,"_29549":1548,"_20523":53001,"_5":14087,"_26884":52938,"_2862":53002},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3376":1574,"_29549":1548,"_20523":53004,"_5":14087,"_26884":52938,"_2862":53005},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3376":1575,"_29549":1548,"_20523":53007,"_5":14087,"_26884":52938,"_2862":53008},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3376":1576,"_29549":1548,"_20523":53010,"_5":14087,"_26884":52938,"_2862":53011},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3376":1577,"_29549":1548,"_20523":53013,"_5":14087,"_26884":52938,"_2862":53014},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3376":1578,"_29549":1548,"_20523":53016,"_5":14087,"_26884":52941,"_2862":53017},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3376":1579,"_29549":1548,"_20523":53019,"_5":14087,"_26884":52941,"_2862":53020},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3376":1580,"_29549":1548,"_20523":53022,"_5":14087,"_26884":52944,"_2862":53023},[],"Participant",{"_3376":1581,"_29549":1548,"_20523":53025,"_5":14087,"_26884":52944,"_2862":53026},[],"Responsibility",{"_3376":1582,"_29549":1548,"_20523":53028,"_5":14087,"_26884":52944,"_2862":53029},[],"PKI administrator",{"_3376":1583,"_29549":1548,"_20523":53031,"_5":14087,"_26884":52944,"_2862":53032},[],"CA, issuance profile, chain and revocation publication.",{"_3376":1584,"_29549":1548,"_20523":53034,"_5":14087,"_26884":52944,"_2862":53035},[],"Provisioning administrator",{"_3376":1585,"_29549":1548,"_20523":53037,"_5":14087,"_26884":52944,"_2862":53038},[],"DMS, admission, authentication per operation and inventory.",{"_3376":1586,"_29549":1548,"_20523":53040,"_5":14087,"_26884":52944,"_2862":53041},[],"Device integrator",{"_3376":1587,"_29549":1548,"_20523":53043,"_5":14087,"_26884":52944,"_2862":53044},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3376":1588,"_29549":1548,"_20523":53046,"_5":14087,"_26884":52944,"_2862":53047},[],"Consumer integrator",{"_3376":1589,"_29549":1548,"_20523":53049,"_5":14087,"_26884":52944,"_2862":53050},[],"Trusted issuers, validation and device permissions in the destination.",{"_3376":1590,"_29549":1548,"_20523":53052,"_5":14087,"_26884":52944,"_2862":53053},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3376":1591,"_29549":1591,"_5":14445,"_2862":53055,"_29901":53056,"_20523":53058,"_26884":1591},"Enroll and connect your first device",[48143,49611,50622,53057],"Getting started",[],{"_3376":1592,"_29549":1591,"_20523":53060,"_5":14087,"_26884":1591,"_2862":53061},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3376":1593,"_29549":1591,"_5":29898,"_20523":53063,"_26884":53064,"_2862":48153},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3376":1594,"_29549":1591,"_5":29898,"_20523":53066,"_26884":53067,"_2862":53068},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3376":1595,"_29549":1591,"_5":29898,"_20523":53070,"_26884":53071,"_2862":53072},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3376":1596,"_29549":1591,"_5":29898,"_20523":53074,"_26884":53075,"_2862":53076},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3376":1597,"_29549":1591,"_5":29898,"_20523":53078,"_26884":53079,"_2862":53080},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3376":1598,"_29549":1591,"_5":29898,"_20523":53082,"_26884":53083,"_2862":53084},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3376":1599,"_29549":1591,"_5":29898,"_20523":53086,"_26884":53087,"_2862":53088},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3376":1600,"_29549":1591,"_5":29898,"_20523":53090,"_26884":53091,"_2862":53092},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3376":1601,"_29549":1591,"_20523":53094,"_5":14087,"_26884":1591,"_2862":53095},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3376":1602,"_29549":1591,"_20523":53097,"_5":14087,"_26884":53064,"_2862":53098},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3376":1603,"_29549":1591,"_20523":53100,"_5":14087,"_26884":53064,"_2862":53101},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3376":1604,"_29549":1591,"_20523":53103,"_5":14087,"_26884":53064,"_2862":53104},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3376":1605,"_29549":1591,"_20523":53106,"_5":14087,"_26884":53064,"_2862":53107},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3376":1606,"_29549":1591,"_20523":53109,"_5":14087,"_26884":53064,"_2862":53110},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3376":1607,"_29549":1591,"_20523":53112,"_5":14087,"_26884":53067,"_2862":53113},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3376":1608,"_29549":1591,"_20523":53115,"_5":14087,"_26884":53067,"_2862":53116},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3376":1609,"_29549":1591,"_20523":53118,"_5":14087,"_26884":53071,"_2862":53119},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3376":1610,"_29549":1591,"_20523":53121,"_5":14087,"_26884":53071,"_2862":53122},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3376":1611,"_29549":1591,"_20523":53124,"_5":14087,"_26884":53071,"_2862":53125},[],"Setting",{"_3376":1612,"_29549":1591,"_20523":53127,"_5":14087,"_26884":53071,"_2862":53128},[],"Evaluation value",{"_3376":1613,"_29549":1591,"_20523":53130,"_5":14087,"_26884":53071,"_2862":53131},[],"Enrollment CA",{"_3376":1614,"_29549":1591,"_20523":53133,"_5":14087,"_26884":53071,"_2862":53134},[],"Issuing root from `device-root.pem`.",{"_3376":1615,"_29549":1591,"_20523":53136,"_5":14087,"_26884":53071,"_2862":50933},[],{"_3376":1616,"_29549":1591,"_20523":53138,"_5":14087,"_26884":53071,"_2862":53139},[],"The 1-hour leaf profile you just prepared.",{"_3376":1617,"_29549":1591,"_20523":53141,"_5":14087,"_26884":53071,"_2862":53142},[],"Protocol / Registration Mode",{"_3376":1618,"_29549":1591,"_20523":53144,"_5":14087,"_26884":53071,"_2862":53145},[],"`EST_RFC7030` / `JITP`.",{"_3376":1619,"_29549":1591,"_20523":53147,"_5":14087,"_26884":53071,"_2862":53148},[],"Verify CSR Signature",{"_3376":1620,"_29549":1591,"_20523":53150,"_5":14087,"_26884":53071,"_2862":53151},[],"Enabled.",{"_3376":1621,"_29549":1591,"_20523":53153,"_5":14087,"_26884":53071,"_2862":53154},[],"Enable Replaceable Enrollment",{"_3376":1622,"_29549":1591,"_20523":53156,"_5":14087,"_26884":53071,"_2862":53157},[],"Disabled; the ID must be new.",{"_3376":1623,"_29549":1591,"_20523":53159,"_5":14087,"_26884":53071,"_2862":53160},[],"Initial authentication",{"_3376":1624,"_29549":1591,"_20523":53162,"_5":14087,"_26884":53071,"_2862":53163},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3376":1625,"_29549":1591,"_20523":53165,"_5":14087,"_26884":53071,"_2862":53166},[],"Renewal authentication",{"_3376":1626,"_29549":1591,"_20523":53168,"_5":14087,"_26884":53071,"_2862":53169},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3376":1627,"_29549":1591,"_20523":53171,"_5":14087,"_26884":53071,"_2862":53172},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3376":1628,"_29549":1591,"_20523":53174,"_5":14087,"_26884":53071,"_2862":53175},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3376":1629,"_29549":1591,"_20523":53177,"_5":14087,"_26884":53071,"_2862":53178},[],"Re-enrollment Delta",{"_3376":1630,"_29549":1591,"_20523":53180,"_5":14087,"_26884":53071,"_2862":53181},[],"1 hour.",{"_3376":1631,"_29549":1591,"_20523":53183,"_5":14087,"_26884":53071,"_2862":53184},[],"Preventive / Critical Delta",{"_3376":1632,"_29549":1591,"_20523":53186,"_5":14087,"_26884":53071,"_2862":53187},[],"30 minutes / 10 minutes.",{"_3376":1633,"_29549":1591,"_20523":53189,"_5":14087,"_26884":53071,"_2862":53190},[],"Revoke on Re-enrollment",{"_3376":1634,"_29549":1591,"_20523":53192,"_5":14087,"_26884":53071,"_2862":53193},[],"Disabled to test the successor before retiring the previous identity.",{"_3376":1635,"_29549":1591,"_20523":53195,"_5":14087,"_26884":53071,"_2862":50941},[],{"_3376":1636,"_29549":1591,"_20523":53197,"_5":14087,"_26884":53071,"_2862":53198},[],"Disabled; the operational key is generated in the client.",{"_3376":1637,"_29549":1591,"_20523":53200,"_5":14087,"_26884":53071,"_2862":53201},[],"CA Distribution",{"_3376":1638,"_29549":1591,"_20523":53203,"_5":14087,"_26884":53071,"_2862":53204},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3376":1639,"_29549":1591,"_20523":53206,"_5":14087,"_26884":53071,"_2862":53207},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3376":1640,"_29549":1591,"_20523":53209,"_5":14087,"_26884":53075,"_2862":53210},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3376":1641,"_29549":1591,"_20523":53212,"_5":14087,"_26884":53075,"_2862":53213},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3376":1642,"_29549":1591,"_20523":53215,"_5":14087,"_26884":53079,"_2862":53216},[],"Generate a new key and CSR with the selected identifier:",{"_3376":1643,"_29549":1591,"_20523":53218,"_5":14087,"_26884":53079,"_2862":53219},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3376":1644,"_29549":1591,"_20523":53221,"_5":14087,"_26884":53079,"_2862":53222},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3376":1645,"_29549":1591,"_20523":53224,"_5":14087,"_26884":53083,"_2862":53225},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3376":1646,"_29549":1591,"_20523":53227,"_5":14087,"_26884":53083,"_2862":53228},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3376":1647,"_29549":1591,"_20523":53230,"_5":14087,"_26884":53087,"_2862":53231},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3376":1648,"_29549":1591,"_20523":53233,"_5":14087,"_26884":53087,"_2862":53234},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3376":1649,"_29549":1591,"_20523":53236,"_5":14087,"_26884":53087,"_2862":53237},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3376":1650,"_29549":1591,"_20523":53239,"_5":14087,"_26884":53087,"_2862":53240},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3376":1651,"_29549":1591,"_20523":53242,"_5":14087,"_26884":53087,"_2862":53243},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3376":1652,"_29549":1591,"_20523":53245,"_5":14087,"_26884":53091,"_2862":53246},[],"Check",{"_3376":1653,"_29549":1591,"_20523":53248,"_5":14087,"_26884":53091,"_2862":53249},[],"Expected result",{"_3376":1654,"_29549":1591,"_20523":53251,"_5":14087,"_26884":53091,"_2862":53252},[],"Registration",{"_3376":1655,"_29549":1591,"_20523":53254,"_5":14087,"_26884":53091,"_2862":53255},[],"ID created automatically and correct DMS.",{"_3376":1656,"_29549":1591,"_20523":53257,"_5":14087,"_26884":53091,"_2862":52510},[],{"_3376":1657,"_29549":1591,"_20523":53259,"_5":14087,"_26884":53091,"_2862":53260},[],"CN, profile, serial and key verified.",{"_3376":1658,"_29549":1591,"_20523":53262,"_5":14087,"_26884":53091,"_2862":53263},[],"Inventory",{"_3376":1659,"_29549":1591,"_20523":53265,"_5":14087,"_26884":53091,"_2862":53266},[],"Received serial visible as the current identity and in history.",{"_3376":1660,"_29549":1591,"_20523":53268,"_5":14087,"_26884":53091,"_2862":53269},[],"Consumer",{"_3376":1661,"_29549":1591,"_20523":53271,"_5":14087,"_26884":53091,"_2862":53272},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3376":1662,"_29549":1591,"_20523":53274,"_5":14087,"_26884":53091,"_2862":53275},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3376":1663,"_29549":1591,"_20523":53277,"_5":14087,"_26884":53091,"_2862":53278},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3376":1664,"_29549":1664,"_5":14445,"_2862":50638,"_29901":53280,"_20523":53281,"_26884":1664},[48143,49611,50622,53057],[],{"_3376":1665,"_29549":1664,"_20523":53283,"_5":14087,"_26884":1664,"_2862":53284},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3376":1666,"_29549":1664,"_5":29898,"_20523":53286,"_26884":53287,"_2862":48153},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3376":1667,"_29549":1664,"_5":29898,"_20523":53289,"_26884":53290,"_2862":53291},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3376":1668,"_29549":1664,"_5":29898,"_20523":53293,"_26884":53294,"_2862":53295},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3376":1669,"_29549":1664,"_5":29898,"_20523":53297,"_26884":53298,"_2862":53299},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3376":1670,"_29549":1664,"_5":29898,"_20523":53301,"_26884":53302,"_2862":53303},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3376":1671,"_29549":1664,"_5":29898,"_20523":53305,"_26884":53306,"_2862":53307},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3376":1672,"_29549":1664,"_5":29898,"_20523":53309,"_26884":53310,"_2862":53249},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3376":1673,"_29549":1664,"_5":29898,"_20523":53312,"_26884":53313,"_2862":53314},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3376":1674,"_29549":1664,"_5":29898,"_20523":53316,"_26884":53317,"_2862":53318},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3376":1675,"_29549":1664,"_20523":53320,"_5":14087,"_26884":1664,"_2862":53321},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3376":1676,"_29549":1664,"_20523":53323,"_5":14087,"_26884":1664,"_2862":53324},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3376":1677,"_29549":1664,"_20523":53326,"_5":14087,"_26884":53287,"_2862":53327},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3376":1678,"_29549":1664,"_20523":53329,"_5":14087,"_26884":53287,"_2862":53330},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3376":1679,"_29549":1664,"_20523":53332,"_5":14087,"_26884":53287,"_2862":53333},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3376":1680,"_29549":1664,"_20523":53335,"_5":14087,"_26884":53287,"_2862":53336},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3376":1681,"_29549":1664,"_20523":53338,"_5":14087,"_26884":53290,"_2862":53339},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3376":1682,"_29549":1664,"_20523":53341,"_5":14087,"_26884":53290,"_2862":53342},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3376":1683,"_29549":1664,"_20523":53344,"_5":14087,"_26884":53290,"_2862":53345},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3376":1684,"_29549":1664,"_20523":53347,"_5":14087,"_26884":53290,"_2862":53348},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3376":1685,"_29549":1664,"_20523":53350,"_5":14087,"_26884":53290,"_2862":53351},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3376":1686,"_29549":1664,"_20523":53353,"_5":14087,"_26884":53290,"_2862":53354},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3376":1687,"_29549":1664,"_20523":53356,"_5":14087,"_26884":53290,"_2862":53357},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3376":1688,"_29549":1664,"_20523":53359,"_5":14087,"_26884":53290,"_2862":53360},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3376":1689,"_29549":1664,"_20523":53362,"_5":14087,"_26884":53294,"_2862":53363},[],"Open **Managed Devices** and the registration action. Complete:",{"_3376":1690,"_29549":1664,"_20523":53365,"_5":14087,"_26884":53294,"_2862":53366},[],"**Device ID**: `device-001`.",{"_3376":1691,"_29549":1664,"_20523":53368,"_5":14087,"_26884":53294,"_2862":53369},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3376":1692,"_29549":1664,"_20523":53371,"_5":14087,"_26884":53294,"_2862":53372},[],"**Icon** and **Tags**: optional classification.",{"_3376":1693,"_29549":1664,"_20523":53374,"_5":14087,"_26884":53294,"_2862":53375},[],"Confirm registration.",{"_3376":1694,"_29549":1664,"_20523":53377,"_5":14087,"_26884":53298,"_2862":53378},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3376":1695,"_29549":1664,"_20523":53380,"_5":14087,"_26884":53298,"_2862":53381},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3376":1696,"_29549":1664,"_20523":53383,"_5":14087,"_26884":53302,"_2862":53384},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3376":1697,"_29549":1664,"_20523":53386,"_5":14087,"_26884":53302,"_2862":53387},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3376":1698,"_29549":1664,"_20523":53389,"_5":14087,"_26884":53306,"_2862":53390},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3376":1699,"_29549":1664,"_20523":53392,"_5":14087,"_26884":53306,"_2862":53393},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3376":1700,"_29549":1664,"_20523":53395,"_5":14087,"_26884":53310,"_2862":53246},[],{"_3376":1701,"_29549":1664,"_20523":53397,"_5":14087,"_26884":53310,"_2862":53398},[],"Result",{"_3376":1702,"_29549":1664,"_20523":53400,"_5":14087,"_26884":53310,"_2862":52493},[],{"_3376":1703,"_29549":1664,"_20523":53402,"_5":14087,"_26884":53310,"_2862":53403},[],"`device-001` appears in inventory with the expected DMS.",{"_3376":1704,"_29549":1664,"_20523":53405,"_5":14087,"_26884":53310,"_2862":53406},[],"Current identity",{"_3376":1705,"_29549":1664,"_20523":53408,"_5":14087,"_26884":53310,"_2862":53409},[],"The associated certificate matches the one you verified in PKI.",{"_3376":1706,"_29549":1664,"_20523":53411,"_5":14087,"_26884":53310,"_2862":53412},[],"History",{"_3376":1707,"_29549":1664,"_20523":53414,"_5":14087,"_26884":53310,"_2862":53415},[],"The associated issuance appears with its serial number and dates.",{"_3376":1708,"_29549":1664,"_20523":53417,"_5":14087,"_26884":53310,"_2862":53418},[],"Key and certificate",{"_3376":1709,"_29549":1664,"_20523":53420,"_5":14087,"_26884":53310,"_2862":53421},[],"You have the verified pair ready to install on the device.",{"_3376":1710,"_29549":1664,"_20523":53423,"_5":14087,"_26884":53313,"_2862":53424},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3376":1711,"_29549":1664,"_20523":53426,"_5":14087,"_26884":53313,"_2862":53427},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3376":1712,"_29549":1664,"_20523":53429,"_5":14087,"_26884":53313,"_2862":53430},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3376":1713,"_29549":1664,"_20523":53432,"_5":14087,"_26884":53313,"_2862":53433},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3376":1714,"_29549":1664,"_20523":53435,"_5":14087,"_26884":53317,"_2862":53436},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3376":1715,"_29549":1664,"_20523":53438,"_5":14087,"_26884":53317,"_2862":53439},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3376":1716,"_29549":1664,"_20523":53441,"_5":14087,"_26884":53317,"_2862":53442},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3376":1717,"_29549":1717,"_5":14445,"_2862":53444,"_29901":53445,"_20523":53446,"_26884":1717},"Lamassu IoT Platform",[48143,49611],[],{"_3376":1718,"_29549":1717,"_20523":53448,"_5":14087,"_26884":1717,"_2862":53449},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3376":1719,"_29549":1717,"_5":29898,"_20523":53451,"_26884":53452,"_2862":52932},[],"/docs/pr-preview/pr-52/platform/overview#start-here",{"_3376":1720,"_29549":1717,"_5":29898,"_20523":53454,"_26884":53455,"_2862":53456},[],"/docs/pr-preview/pr-52/platform/overview#choose-your-path","Choose your path",{"_3376":1721,"_29549":1717,"_5":29898,"_20523":53458,"_26884":53459,"_2862":53460},[],"/docs/pr-preview/pr-52/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3376":1722,"_29549":1717,"_5":29898,"_20523":53462,"_26884":53463,"_2862":53464},[],"/docs/pr-preview/pr-52/platform/overview#core-capabilities","Core capabilities",{"_3376":1723,"_29549":1717,"_5":29898,"_20523":53466,"_26884":53467,"_2862":53468},[],"/docs/pr-preview/pr-52/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3376":1724,"_29549":1717,"_5":29898,"_20523":53470,"_26884":53471,"_2862":53472},[],"/docs/pr-preview/pr-52/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3376":1725,"_29549":1717,"_5":29898,"_20523":53474,"_26884":53475,"_2862":53476},[],"/docs/pr-preview/pr-52/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3376":1726,"_29549":1717,"_5":29898,"_20523":53478,"_26884":53479,"_2862":53480},[],"/docs/pr-preview/pr-52/platform/overview#automate-device-identities","Automate device identities",{"_3376":1727,"_29549":1717,"_5":29898,"_20523":53482,"_26884":53483,"_2862":53484},[],"/docs/pr-preview/pr-52/platform/overview#publish-validation-status","Publish validation status",{"_3376":1728,"_29549":1717,"_5":29898,"_20523":53486,"_26884":53487,"_2862":53488},[],"/docs/pr-preview/pr-52/platform/overview#react-to-events","React to events",{"_3376":1729,"_29549":1717,"_5":29898,"_20523":53490,"_26884":53491,"_2862":53492},[],"/docs/pr-preview/pr-52/platform/overview#operational-reference","Operational reference",{"_3376":1730,"_29549":1717,"_20523":53494,"_5":14087,"_26884":1717,"_2862":53495},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3376":1731,"_29549":1717,"_20523":53497,"_5":14087,"_26884":53452,"_2862":53498},[],"Choose the result you need:",{"_3376":1732,"_29549":1717,"_20523":53500,"_5":14087,"_26884":53452,"_2862":53501},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3376":1733,"_29549":1717,"_20523":53503,"_5":14087,"_26884":53452,"_2862":53504},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3376":1734,"_29549":1717,"_20523":53506,"_5":14087,"_26884":53452,"_2862":53507},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3376":1735,"_29549":1717,"_20523":53509,"_5":14087,"_26884":53455,"_2862":53510},[],"Section",{"_3376":1736,"_29549":1717,"_20523":53512,"_5":14087,"_26884":53455,"_2862":53513},[],"What you manage",{"_3376":1737,"_29549":1717,"_20523":53515,"_5":14087,"_26884":53455,"_2862":53516},[],"Entry point",{"_3376":1738,"_29549":1717,"_20523":53518,"_5":14087,"_26884":53455,"_2862":53519},[],"**PKI**",{"_3376":1739,"_29549":1717,"_20523":53521,"_5":14087,"_26884":53455,"_2862":53522},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3376":1740,"_29549":1717,"_20523":53524,"_5":14087,"_26884":53455,"_2862":53525},[],"PKI overview",{"_3376":1741,"_29549":1717,"_20523":53527,"_5":14087,"_26884":53455,"_2862":53528},[],"**IoT Fleets**",{"_3376":1742,"_29549":1717,"_20523":53530,"_5":14087,"_26884":53455,"_2862":53531},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3376":1743,"_29549":1717,"_20523":53533,"_5":14087,"_26884":53455,"_2862":53534},[],"IoT Fleets overview",{"_3376":1744,"_29549":1717,"_20523":53536,"_5":14087,"_26884":53455,"_2862":53537},[],"**Administration**",{"_3376":1745,"_29549":1717,"_20523":53539,"_5":14087,"_26884":53455,"_2862":53540},[],"Operator permissions, audit and event subscriptions.",{"_3376":1746,"_29549":1717,"_20523":53542,"_5":14087,"_26884":53455,"_2862":49609},[],{"_3376":1747,"_29549":1717,"_20523":53544,"_5":14087,"_26884":53455,"_2862":53545},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3376":1748,"_29549":1717,"_20523":53547,"_5":14087,"_26884":53459,"_2862":53548},[],"An identity's journey connects four responsibilities:",{"_3376":1749,"_29549":1717,"_20523":53550,"_5":14087,"_26884":53459,"_2862":53551},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3376":1750,"_29549":1717,"_20523":53553,"_5":14087,"_26884":53459,"_2862":53554},[],"The provisioning administrator configures the DMS and initial trust.",{"_3376":1751,"_29549":1717,"_20523":53556,"_5":14087,"_26884":53459,"_2862":53557},[],"The device client requests a certificate and installs it with the matching key.",{"_3376":1752,"_29549":1717,"_20523":53559,"_5":14087,"_26884":53459,"_2862":53560},[],"The consumer validates the identity and applies its access permissions.",{"_3376":1753,"_29549":1717,"_20523":53562,"_5":14087,"_26884":53459,"_2862":53563},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3376":1754,"_29549":1717,"_20523":53565,"_5":14087,"_26884":53467,"_2862":53566},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3376":1755,"_29549":1717,"_20523":53568,"_5":14087,"_26884":53471,"_2862":53569},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3376":1756,"_29549":1717,"_20523":53571,"_5":14087,"_26884":53475,"_2862":53572},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3376":1757,"_29549":1717,"_20523":53574,"_5":14087,"_26884":53479,"_2862":53575},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3376":1758,"_29549":1717,"_20523":53577,"_5":14087,"_26884":53483,"_2862":53578},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3376":1759,"_29549":1717,"_20523":53580,"_5":14087,"_26884":53487,"_2862":53581},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3376":1760,"_29549":1717,"_20523":53583,"_5":14087,"_26884":53491,"_2862":53026},[],{"_3376":1761,"_29549":1717,"_20523":53585,"_5":14087,"_26884":53491,"_2862":53586},[],"What it prepares or checks",{"_3376":1762,"_29549":1717,"_20523":53588,"_5":14087,"_26884":53491,"_2862":53029},[],{"_3376":1763,"_29549":1717,"_20523":53590,"_5":14087,"_26884":53491,"_2862":53591},[],"Key custody, CA hierarchy, profiles and validation.",{"_3376":1764,"_29549":1717,"_20523":53593,"_5":14087,"_26884":53491,"_2862":53594},[],"Fleet administrator",{"_3376":1765,"_29549":1717,"_20523":53596,"_5":14087,"_26884":53491,"_2862":53597},[],"DMS, device admission, renewal policy and inventory.",{"_3376":1766,"_29549":1717,"_20523":53599,"_5":14087,"_26884":53491,"_2862":53041},[],{"_3376":1767,"_29549":1717,"_20523":53601,"_5":14087,"_26884":53491,"_2862":53602},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3376":1768,"_29549":1717,"_20523":53604,"_5":14087,"_26884":53491,"_2862":53047},[],{"_3376":1769,"_29549":1717,"_20523":53606,"_5":14087,"_26884":53491,"_2862":53607},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3376":1770,"_29549":1717,"_20523":53609,"_5":14087,"_26884":53491,"_2862":53610},[],"Infrastructure operator",{"_3376":1771,"_29549":1717,"_20523":53612,"_5":14087,"_26884":53491,"_2862":53613},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3376":1772,"_29549":1717,"_20523":53615,"_5":14087,"_26884":53491,"_2862":53616},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3376":1773,"_29549":1773,"_5":14445,"_2862":53618,"_29901":53619,"_20523":53622,"_26884":1773},"CA hierarchy and rotation",[48143,49611,53620,53621],"PKI","Keys, authorities and certificates",[],{"_3376":1774,"_29549":1773,"_20523":53624,"_5":14087,"_26884":1773,"_2862":53625},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3376":1775,"_29549":1773,"_5":29898,"_20523":53627,"_26884":53628,"_2862":53629},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3376":1776,"_29549":1773,"_5":29898,"_20523":53631,"_26884":53632,"_2862":53633},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3376":1777,"_29549":1773,"_5":29898,"_20523":53635,"_26884":53636,"_2862":53637},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3376":1778,"_29549":1773,"_5":29898,"_20523":53639,"_26884":53640,"_2862":53641},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3376":1779,"_29549":1773,"_5":29898,"_20523":53643,"_26884":53644,"_2862":53645},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3376":1780,"_29549":1773,"_5":29898,"_20523":53647,"_26884":53648,"_2862":53649},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3376":1781,"_29549":1773,"_5":29898,"_20523":53651,"_26884":53652,"_2862":53653},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3376":1782,"_29549":1773,"_5":29898,"_20523":53655,"_26884":53656,"_2862":53657},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3376":1783,"_29549":1773,"_5":29898,"_20523":53659,"_26884":53660,"_2862":53661},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3376":1784,"_29549":1773,"_5":29898,"_20523":53663,"_26884":53664,"_2862":53665},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3376":1785,"_29549":1773,"_5":29898,"_20523":53667,"_26884":53668,"_2862":53669},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3376":1786,"_29549":1773,"_5":29898,"_20523":53671,"_26884":53672,"_2862":53673},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3376":1787,"_29549":1773,"_20523":53675,"_5":14087,"_26884":1773,"_2862":53676},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3376":1788,"_29549":1773,"_20523":53678,"_5":14087,"_26884":1773,"_2862":53679},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3376":1789,"_29549":1773,"_20523":53681,"_5":14087,"_26884":53628,"_2862":53682},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3376":1790,"_29549":1773,"_20523":53684,"_5":14087,"_26884":53628,"_2862":53685},[],"environment, such as production and preproduction;",{"_3376":1791,"_29549":1773,"_20523":53687,"_5":14087,"_26884":53628,"_2862":53688},[],"owner or operating team;",{"_3376":1792,"_29549":1773,"_20523":53690,"_5":14087,"_26884":53628,"_2862":53691},[],"device family or manufacturing process;",{"_3376":1793,"_29549":1773,"_20523":53693,"_5":14087,"_26884":53628,"_2862":53694},[],"region or regulatory requirement;",{"_3376":1794,"_29549":1773,"_20523":53696,"_5":14087,"_26884":53628,"_2862":53697},[],"cryptographic engine or key policy;",{"_3376":1795,"_29549":1773,"_20523":53699,"_5":14087,"_26884":53628,"_2862":53700},[],"maintenance window and renewal cadence.",{"_3376":1796,"_29549":1773,"_20523":53702,"_5":14087,"_26884":53628,"_2862":53703},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3376":1797,"_29549":1773,"_20523":53705,"_5":14087,"_26884":53628,"_2862":53706},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3376":1798,"_29549":1773,"_20523":53708,"_5":14087,"_26884":53632,"_2862":53709},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3376":1799,"_29549":1773,"_20523":53711,"_5":14087,"_26884":53632,"_2862":53712},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3376":1800,"_29549":1773,"_20523":53714,"_5":14087,"_26884":53632,"_2862":53715},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3376":1801,"_29549":1773,"_20523":53717,"_5":14087,"_26884":53636,"_2862":53718},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3376":1802,"_29549":1773,"_20523":53720,"_5":14087,"_26884":53636,"_2862":53721},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3376":1803,"_29549":1773,"_20523":53723,"_5":14087,"_26884":53636,"_2862":53724},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3376":1804,"_29549":1773,"_20523":53726,"_5":14087,"_26884":53636,"_2862":53727},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3376":1805,"_29549":1773,"_20523":53729,"_5":14087,"_26884":53644,"_2862":53730},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3376":1806,"_29549":1773,"_20523":53732,"_5":14087,"_26884":53648,"_2862":53733},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3376":1807,"_29549":1773,"_20523":53735,"_5":14087,"_26884":53652,"_2862":53736},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3376":1808,"_29549":1773,"_20523":53738,"_5":14087,"_26884":53656,"_2862":53739},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3376":1809,"_29549":1773,"_20523":53741,"_5":14087,"_26884":53660,"_2862":53742},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3376":1810,"_29549":1773,"_20523":53744,"_5":14087,"_26884":53664,"_2862":53745},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3376":1811,"_29549":1773,"_20523":53747,"_5":14087,"_26884":53668,"_2862":53748},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3376":1812,"_29549":1773,"_20523":53750,"_5":14087,"_26884":53668,"_2862":53751},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3376":1813,"_29549":1773,"_20523":53753,"_5":14087,"_26884":53668,"_2862":53754},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3376":1814,"_29549":1773,"_20523":53756,"_5":14087,"_26884":53668,"_2862":53757},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3376":1815,"_29549":1773,"_20523":53759,"_5":14087,"_26884":53672,"_2862":53760},[],"The new chain ends in an anchor installed by the consumer.",{"_3376":1816,"_29549":1773,"_20523":53762,"_5":14087,"_26884":53672,"_2862":53763},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3376":1817,"_29549":1773,"_20523":53765,"_5":14087,"_26884":53672,"_2862":53766},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3376":1818,"_29549":1773,"_20523":53768,"_5":14087,"_26884":53672,"_2862":53769},[],"Re-enrollment accepts the old identity during the planned period.",{"_3376":1819,"_29549":1773,"_20523":53771,"_5":14087,"_26884":53672,"_2862":53772},[],"OCSP and CRL respond for the authorities that remain active.",{"_3376":1820,"_29549":1773,"_20523":53774,"_5":14087,"_26884":53672,"_2862":53775},[],"No DMS is left accidentally issuing from the old CA.",{"_3376":1821,"_29549":1773,"_20523":53777,"_5":14087,"_26884":53672,"_2862":53778},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3376":1822,"_29549":1822,"_5":14445,"_2862":53780,"_29901":53781,"_20523":53782,"_26884":1822},"Certification authorities",[48143,49611,53620,53621],[],{"_3376":1823,"_29549":1822,"_20523":53784,"_5":14087,"_26884":1822,"_2862":53785},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3376":1824,"_29549":1822,"_5":29898,"_20523":53787,"_26884":53788,"_2862":53789},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3376":1825,"_29549":1822,"_5":29898,"_20523":53791,"_26884":53792,"_2862":53793},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3376":1826,"_29549":1822,"_5":29898,"_20523":53795,"_26884":53796,"_2862":48153},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#before-you-begin",{"_3376":1827,"_29549":1822,"_5":29898,"_20523":53798,"_26884":53799,"_2862":53800},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3376":1828,"_29549":1822,"_5":29898,"_20523":53802,"_26884":53803,"_2862":53804},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3376":1829,"_29549":1822,"_5":29898,"_20523":53806,"_26884":53807,"_2862":53808},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3376":1830,"_29549":1822,"_5":29898,"_20523":53810,"_26884":53811,"_2862":53812},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3376":1831,"_29549":1822,"_5":29898,"_20523":53814,"_26884":53815,"_2862":53816},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3376":1832,"_29549":1822,"_5":29898,"_20523":53818,"_26884":53819,"_2862":53820},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3376":1833,"_29549":1822,"_5":29898,"_20523":53822,"_26884":53823,"_2862":53824},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3376":1834,"_29549":1822,"_5":29898,"_20523":53826,"_26884":53827,"_2862":53828},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3376":1835,"_29549":1822,"_5":29898,"_20523":53830,"_26884":53831,"_2862":53832},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3376":1836,"_29549":1822,"_5":29898,"_20523":53834,"_26884":53835,"_2862":53836},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3376":1837,"_29549":1822,"_5":29898,"_20523":53838,"_26884":53839,"_2862":53840},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3376":1838,"_29549":1822,"_5":29898,"_20523":53842,"_26884":53843,"_2862":53844},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3376":1839,"_29549":1822,"_5":29898,"_20523":53846,"_26884":53847,"_2862":53848},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3376":1840,"_29549":1822,"_5":29898,"_20523":53850,"_26884":53851,"_2862":53852},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3376":1841,"_29549":1822,"_5":29898,"_20523":53854,"_26884":53855,"_2862":53856},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3376":1842,"_29549":1822,"_5":29898,"_20523":53858,"_26884":53859,"_2862":53860},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3376":1843,"_29549":1822,"_5":29898,"_20523":53862,"_26884":53863,"_2862":53864},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3376":1844,"_29549":1822,"_5":29898,"_20523":53866,"_26884":53867,"_2862":53868},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3376":1845,"_29549":1822,"_5":29898,"_20523":53870,"_26884":53871,"_2862":53872},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3376":1846,"_29549":1822,"_5":29898,"_20523":53874,"_26884":53875,"_2862":53876},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3376":1847,"_29549":1822,"_20523":53878,"_5":14087,"_26884":1822,"_2862":53879},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3376":1848,"_29549":1822,"_20523":53881,"_5":14087,"_26884":1822,"_2862":53882},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3376":1849,"_29549":1822,"_20523":53884,"_5":14087,"_26884":1822,"_2862":53885},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3376":1850,"_29549":1822,"_20523":53887,"_5":14087,"_26884":53788,"_2862":53888},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3376":1851,"_29549":1822,"_20523":53890,"_5":14087,"_26884":53788,"_2862":53891},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3376":1852,"_29549":1822,"_20523":53893,"_5":14087,"_26884":53788,"_2862":53894},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3376":1853,"_29549":1822,"_20523":53896,"_5":14087,"_26884":53788,"_2862":53897},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3376":1854,"_29549":1822,"_20523":53899,"_5":14087,"_26884":53788,"_2862":53900},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3376":1855,"_29549":1822,"_20523":53902,"_5":14087,"_26884":53796,"_2862":53903},[],"Decide whether the CA will be a root or an intermediate.",{"_3376":1856,"_29549":1822,"_20523":53905,"_5":14087,"_26884":53796,"_2862":53906},[],"Choose the engine that will keep the key.",{"_3376":1857,"_29549":1822,"_20523":53908,"_5":14087,"_26884":53796,"_2862":53909},[],"Define a validity longer than that of the certificates it will issue.",{"_3376":1858,"_29549":1822,"_20523":53911,"_5":14087,"_26884":53796,"_2862":53912},[],"For an intermediate CA, make sure the parent CA is active.",{"_3376":1859,"_29549":1822,"_20523":53914,"_5":14087,"_26884":53799,"_2862":53915},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3376":1860,"_29549":1822,"_20523":53917,"_5":14087,"_26884":53803,"_2862":53918},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3376":1861,"_29549":1822,"_20523":53920,"_5":14087,"_26884":53803,"_2862":53921},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3376":1862,"_29549":1822,"_20523":53923,"_5":14087,"_26884":53807,"_2862":53924},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3376":1863,"_29549":1822,"_20523":53926,"_5":14087,"_26884":53811,"_2862":53927},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3376":1864,"_29549":1822,"_20523":53929,"_5":14087,"_26884":53811,"_2862":53930},[],"`C`: two-letter ISO 3166-1 country code.",{"_3376":1865,"_29549":1822,"_20523":53932,"_5":14087,"_26884":53811,"_2862":53933},[],"`ST`: state or province.",{"_3376":1866,"_29549":1822,"_20523":53935,"_5":14087,"_26884":53811,"_2862":53936},[],"`L`: locality.",{"_3376":1867,"_29549":1822,"_20523":53938,"_5":14087,"_26884":53811,"_2862":53939},[],"`O`: organization.",{"_3376":1868,"_29549":1822,"_20523":53941,"_5":14087,"_26884":53811,"_2862":53942},[],"`OU`: organizational unit.",{"_3376":1869,"_29549":1822,"_20523":53944,"_5":14087,"_26884":53811,"_2862":53945},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3376":1870,"_29549":1822,"_20523":53947,"_5":14087,"_26884":53815,"_2862":53948},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3376":1871,"_29549":1822,"_20523":53950,"_5":14087,"_26884":53815,"_2862":53951},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3376":1872,"_29549":1822,"_20523":53953,"_5":14087,"_26884":53819,"_2862":53954},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3376":1873,"_29549":1822,"_20523":53956,"_5":14087,"_26884":53819,"_2862":53957},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3376":1874,"_29549":1822,"_20523":53959,"_5":14087,"_26884":53823,"_2862":53960},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3376":1875,"_29549":1822,"_20523":53962,"_5":14087,"_26884":53823,"_2862":53963},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3376":1876,"_29549":1822,"_20523":53965,"_5":14087,"_26884":53827,"_2862":53966},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3376":1877,"_29549":1822,"_20523":53968,"_5":14087,"_26884":53827,"_2862":53969},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3376":1878,"_29549":1822,"_20523":53971,"_5":14087,"_26884":53827,"_2862":53972},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3376":1879,"_29549":1822,"_20523":53974,"_5":14087,"_26884":53831,"_2862":53975},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3376":1880,"_29549":1822,"_20523":53977,"_5":14087,"_26884":53835,"_2862":53978},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3376":1881,"_29549":1822,"_20523":53980,"_5":14087,"_26884":53839,"_2862":53981},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3376":1882,"_29549":1822,"_20523":53983,"_5":14087,"_26884":53843,"_2862":53984},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3376":1883,"_29549":1822,"_20523":53986,"_5":14087,"_26884":53843,"_2862":53987},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3376":1884,"_29549":1822,"_20523":53989,"_5":14087,"_26884":53847,"_2862":53990},[],"Open a CA from the inventory to review:",{"_3376":1885,"_29549":1822,"_20523":53992,"_5":14087,"_26884":53847,"_2862":53993},[],"Status and validity period.",{"_3376":1886,"_29549":1822,"_20523":53995,"_5":14087,"_26884":53847,"_2862":53996},[],"Certificate and chain in PEM format.",{"_3376":1887,"_29549":1822,"_20523":53998,"_5":14087,"_26884":53847,"_2862":53999},[],"Number of active, expired and revoked certificates.",{"_3376":1888,"_29549":1822,"_20523":54001,"_5":14087,"_26884":53847,"_2862":54002},[],"Certificates issued in **Issued Certificates**.",{"_3376":1889,"_29549":1822,"_20523":54004,"_5":14087,"_26884":53847,"_2862":54005},[],"The CRL linked to the authority.",{"_3376":1890,"_29549":1822,"_20523":54007,"_5":14087,"_26884":53847,"_2862":54008},[],"Metadata and the associated cryptographic engine.",{"_3376":1891,"_29549":1822,"_20523":54010,"_5":14087,"_26884":53847,"_2862":54011},[],"You can filter the inventory by name, status and CA type.",{"_3376":1892,"_29549":1822,"_20523":54013,"_5":14087,"_26884":53851,"_2862":54014},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3376":1893,"_29549":1822,"_20523":54016,"_5":14087,"_26884":53851,"_2862":54017},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3376":1894,"_29549":1822,"_20523":54019,"_5":14087,"_26884":53851,"_2862":54020},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3376":1895,"_29549":1822,"_20523":54022,"_5":14087,"_26884":53851,"_2862":54023},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3376":1896,"_29549":1822,"_20523":54025,"_5":14087,"_26884":53855,"_2862":54026},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3376":1897,"_29549":1822,"_20523":54028,"_5":14087,"_26884":53859,"_2862":54029},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3376":1898,"_29549":1822,"_20523":54031,"_5":14087,"_26884":53863,"_2862":54032},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3376":1899,"_29549":1822,"_20523":54034,"_5":14087,"_26884":53867,"_2862":54035},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3376":1900,"_29549":1822,"_20523":54037,"_5":14087,"_26884":53871,"_2862":54038},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3376":1901,"_29549":1822,"_20523":54040,"_5":14087,"_26884":53875,"_2862":54041},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3376":1902,"_29549":1822,"_20523":54043,"_5":14087,"_26884":53875,"_2862":54044},[],"The CA’s VA role is kept. If no other CA with the same SKI remains, it can no longer be edited (see CRL), so adjust its validity and signer beforehand. The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3376":1903,"_29549":1822,"_20523":54046,"_5":14087,"_26884":53875,"_2862":54047},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. If the new certificate uses the same key, it shares the SKI with the retained VA role of the deleted CA, whose signer is the old certificate: check that the CRL is generated and, if it is not, use `PUT` to set a signer of the new CA (see CRL).",{"_3376":1904,"_29549":1904,"_5":14445,"_2862":54049,"_29901":54050,"_20523":54051,"_26884":1904},"Certificate profiles",[48143,49611,53620,53621],[],{"_3376":1905,"_29549":1904,"_20523":54053,"_5":14087,"_26884":1904,"_2862":54054},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3376":1906,"_29549":1904,"_5":29898,"_20523":54056,"_26884":54057,"_2862":54058},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3376":1907,"_29549":1904,"_5":29898,"_20523":54060,"_26884":54061,"_2862":54062},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#validity","Validity",{"_3376":1908,"_29549":1904,"_5":29898,"_20523":54064,"_26884":54065,"_2862":54066},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3376":1909,"_29549":1904,"_5":29898,"_20523":54068,"_26884":54069,"_2862":54070},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3376":1910,"_29549":1904,"_5":29898,"_20523":54072,"_26884":54073,"_2862":54074},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#subject","Subject",{"_3376":1911,"_29549":1904,"_5":29898,"_20523":54076,"_26884":54077,"_2862":54078},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3376":1912,"_29549":1904,"_5":29898,"_20523":54080,"_26884":54081,"_2862":54082},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3376":1913,"_29549":1904,"_5":29898,"_20523":54084,"_26884":54085,"_2862":54086},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3376":1914,"_29549":1904,"_5":29898,"_20523":54088,"_26884":54089,"_2862":54090},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3376":1915,"_29549":1904,"_5":29898,"_20523":54092,"_26884":54093,"_2862":54094},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3376":1916,"_29549":1904,"_5":29898,"_20523":54096,"_26884":54097,"_2862":54098},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3376":1917,"_29549":1904,"_5":29898,"_20523":54100,"_26884":54101,"_2862":54102},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3376":1918,"_29549":1904,"_5":29898,"_20523":54104,"_26884":54105,"_2862":54106},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3376":1919,"_29549":1904,"_5":29898,"_20523":54108,"_26884":54109,"_2862":54110},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3376":1920,"_29549":1904,"_5":29898,"_20523":54112,"_26884":54113,"_2862":54114},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#design-examples","Design examples",{"_3376":1921,"_29549":1904,"_5":29898,"_20523":54116,"_26884":54117,"_2862":54118},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3376":1922,"_29549":1904,"_20523":54120,"_5":14087,"_26884":1904,"_2862":54121},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3376":1923,"_29549":1904,"_20523":54123,"_5":14087,"_26884":1904,"_2862":54124},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3376":1924,"_29549":1904,"_20523":54126,"_5":14087,"_26884":54061,"_2862":54127},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3376":1925,"_29549":1904,"_20523":54129,"_5":14087,"_26884":54061,"_2862":54130},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3376":1926,"_29549":1904,"_20523":54132,"_5":14087,"_26884":54065,"_2862":54133},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3376":1927,"_29549":1904,"_20523":54135,"_5":14087,"_26884":54069,"_2862":54136},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3376":1928,"_29549":1904,"_20523":54138,"_5":14087,"_26884":54069,"_2862":54139},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3376":1929,"_29549":1904,"_20523":54141,"_5":14087,"_26884":54069,"_2862":54142},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3376":1930,"_29549":1904,"_20523":54144,"_5":14087,"_26884":54073,"_2862":54145},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3376":1931,"_29549":1904,"_20523":54147,"_5":14087,"_26884":54077,"_2862":54148},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3376":1932,"_29549":1904,"_20523":54150,"_5":14087,"_26884":54077,"_2862":54151},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3376":1933,"_29549":1904,"_20523":54153,"_5":14087,"_26884":54081,"_2862":54154},[],"The cryptographic enforcement can:",{"_3376":1934,"_29549":1904,"_20523":54156,"_5":14087,"_26884":54081,"_2862":54157},[],"allow or block RSA keys;",{"_3376":1935,"_29549":1904,"_20523":54159,"_5":14087,"_26884":54081,"_2862":54160},[],"limit the supported RSA sizes;",{"_3376":1936,"_29549":1904,"_20523":54162,"_5":14087,"_26884":54081,"_2862":54163},[],"allow or block ECDSA keys;",{"_3376":1937,"_29549":1904,"_20523":54165,"_5":14087,"_26884":54081,"_2862":54166},[],"limit the supported ECDSA sizes or curves.",{"_3376":1938,"_29549":1904,"_20523":54168,"_5":14087,"_26884":54081,"_2862":54169},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3376":1939,"_29549":1904,"_20523":54171,"_5":14087,"_26884":54085,"_2862":54172},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3376":1940,"_29549":1904,"_20523":54174,"_5":14087,"_26884":54085,"_2862":51375},[],{"_3376":1941,"_29549":1904,"_20523":54176,"_5":14087,"_26884":54085,"_2862":54177},[],"First choice",{"_3376":1942,"_29549":1904,"_20523":54179,"_5":14087,"_26884":54085,"_2862":54180},[],"Second choice",{"_3376":1943,"_29549":1904,"_20523":54182,"_5":14087,"_26884":54085,"_2862":54183},[],"If neither is supplied",{"_3376":1944,"_29549":1904,"_20523":54185,"_5":14087,"_26884":54085,"_2862":54186},[],"Direct signing with a CA",{"_3376":1945,"_29549":1904,"_20523":54188,"_5":14087,"_26884":54085,"_2862":54189},[],"`issuance_profile` embedded in the request",{"_3376":1946,"_29549":1904,"_20523":54191,"_5":14087,"_26884":54085,"_2862":54192},[],"Request `issuance_profile_id`",{"_3376":1947,"_29549":1904,"_20523":54194,"_5":14087,"_26884":54085,"_2862":54195},[],"CA default profile (`profile_id`).",{"_3376":1948,"_29549":1904,"_20523":54197,"_5":14087,"_26884":54085,"_2862":54198},[],"Issuance through a DMS",{"_3376":1949,"_29549":1904,"_20523":54200,"_5":14087,"_26884":54085,"_2862":54201},[],"`settings.issuance_profile_id`",{"_3376":1950,"_29549":1904,"_20523":54203,"_5":14087,"_26884":54085,"_2862":54204},[],"`settings.issuance_profile` embedded in the DMS",{"_3376":1951,"_29549":1904,"_20523":54206,"_5":14087,"_26884":54085,"_2862":54207},[],"Enrollment CA default profile.",{"_3376":1952,"_29549":1904,"_20523":54209,"_5":14087,"_26884":54085,"_2862":54210},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3376":1953,"_29549":1904,"_20523":54212,"_5":14087,"_26884":54085,"_2862":54213},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3376":1954,"_29549":1904,"_20523":54215,"_5":14087,"_26884":54093,"_2862":54216},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3376":1955,"_29549":1904,"_20523":54218,"_5":14087,"_26884":54097,"_2862":54219},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3376":1956,"_29549":1904,"_20523":54221,"_5":14087,"_26884":54101,"_2862":54222},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3376":1957,"_29549":1904,"_20523":54224,"_5":14087,"_26884":54105,"_2862":54225},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3376":1958,"_29549":1904,"_20523":54227,"_5":14087,"_26884":54109,"_2862":54228},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3376":1959,"_29549":1904,"_20523":54230,"_5":14087,"_26884":54109,"_2862":54231},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3376":1960,"_29549":1904,"_20523":54233,"_5":14087,"_26884":54113,"_2862":54234},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3376":1961,"_29549":1904,"_20523":54236,"_5":14087,"_26884":54113,"_2862":54237},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3376":1962,"_29549":1904,"_20523":54239,"_5":14087,"_26884":54113,"_2862":54240},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3376":1963,"_29549":1904,"_20523":54242,"_5":14087,"_26884":54113,"_2862":54243},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3376":1964,"_29549":1904,"_20523":54245,"_5":14087,"_26884":54117,"_2862":54246},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3376":1965,"_29549":1904,"_20523":54248,"_5":14087,"_26884":54117,"_2862":54249},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3376":1966,"_29549":1966,"_5":14445,"_2862":54251,"_29901":54252,"_20523":54254,"_26884":1966},"Certificate validation",[48143,49611,53620,54253],"Validation",[],{"_3376":1967,"_29549":1966,"_20523":54256,"_5":14087,"_26884":1966,"_2862":54257},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3376":1968,"_29549":1966,"_5":29898,"_20523":54259,"_26884":54260,"_2862":54261},[],"/docs/pr-preview/pr-52/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3376":1969,"_29549":1966,"_5":29898,"_20523":54263,"_26884":54264,"_2862":54265},[],"/docs/pr-preview/pr-52/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3376":1970,"_29549":1966,"_5":29898,"_20523":54267,"_26884":54268,"_2862":54269},[],"/docs/pr-preview/pr-52/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3376":1971,"_29549":1966,"_20523":54271,"_5":14087,"_26884":1966,"_2862":54272},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3376":1972,"_29549":1966,"_20523":54274,"_5":14087,"_26884":54260,"_2862":54275},[],"Verify these criteria together:",{"_3376":1973,"_29549":1966,"_20523":54277,"_5":14087,"_26884":54260,"_2862":53246},[],{"_3376":1974,"_29549":1966,"_20523":54279,"_5":14087,"_26884":54260,"_2862":54280},[],"Required result",{"_3376":1975,"_29549":1966,"_20523":54282,"_5":14087,"_26884":54260,"_2862":54283},[],"Chain and signature",{"_3376":1976,"_29549":1966,"_20523":54285,"_5":14087,"_26884":54260,"_2862":54286},[],"Valid chain to a root deliberately installed in the consumer.",{"_3376":1977,"_29549":1966,"_20523":54288,"_5":14087,"_26884":54260,"_2862":54289},[],"Dates",{"_3376":1978,"_29549":1966,"_20523":54291,"_5":14087,"_26884":54260,"_2862":54292},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3376":1979,"_29549":1966,"_20523":54294,"_5":14087,"_26884":54260,"_2862":49280},[],{"_3376":1980,"_29549":1966,"_20523":54296,"_5":14087,"_26884":54260,"_2862":54297},[],"Name, SAN or identifier matches the expected peer.",{"_3376":1981,"_29549":1966,"_20523":54299,"_5":14087,"_26884":54260,"_2862":48533},[],{"_3376":1982,"_29549":1966,"_20523":54301,"_5":14087,"_26884":54260,"_2862":54302},[],"KU, EKU and constraints permit the specific operation.",{"_3376":1983,"_29549":1966,"_20523":54304,"_5":14087,"_26884":54260,"_2862":54305},[],"Revocation",{"_3376":1984,"_29549":1966,"_20523":54307,"_5":14087,"_26884":54260,"_2862":54308},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3376":1985,"_29549":1966,"_20523":54310,"_5":14087,"_26884":54260,"_2862":54311},[],"Authorization",{"_3376":1986,"_29549":1966,"_20523":54313,"_5":14087,"_26884":54260,"_2862":54314},[],"The application permits that identity to perform the action.",{"_3376":1987,"_29549":1966,"_20523":54316,"_5":14087,"_26884":54260,"_2862":54317},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3376":1988,"_29549":1966,"_20523":54319,"_5":14087,"_26884":54264,"_2862":54320},[],"Mechanism",{"_3376":1989,"_29549":1966,"_20523":54322,"_5":14087,"_26884":54264,"_2862":54323},[],"When to use it",{"_3376":1990,"_29549":1966,"_20523":54325,"_5":14087,"_26884":54264,"_2862":54326},[],"What you must maintain",{"_3376":1991,"_29549":1966,"_20523":54328,"_5":14087,"_26884":54264,"_2862":54329},[],"OCSP",{"_3376":1992,"_29549":1966,"_20523":54331,"_5":14087,"_26884":54264,"_2862":54332},[],"Status query for a specific certificate.",{"_3376":1993,"_29549":1966,"_20523":54334,"_5":14087,"_26884":54264,"_2862":54335},[],"Responder access, signature verification and cache/freshness policy.",{"_3376":1994,"_29549":1966,"_20523":54337,"_5":14087,"_26884":54264,"_2862":54338},[],"CRL",{"_3376":1995,"_29549":1966,"_20523":54340,"_5":14087,"_26884":54264,"_2862":54341},[],"Local checks for many certificates or offline operation.",{"_3376":1996,"_29549":1966,"_20523":54343,"_5":14087,"_26884":54264,"_2862":54344},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3376":1997,"_29549":1966,"_20523":54346,"_5":14087,"_26884":54264,"_2862":54347},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3376":1998,"_29549":1966,"_20523":54349,"_5":14087,"_26884":54264,"_2862":54350},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3376":1999,"_29549":1966,"_20523":54352,"_5":14087,"_26884":54268,"_2862":54353},[],"Accept a current, authorized certificate with a known chain.",{"_3376":2000,"_29549":1966,"_20523":54355,"_5":14087,"_26884":54268,"_2862":54356},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3376":2001,"_29549":1966,"_20523":54358,"_5":14087,"_26884":54268,"_2862":54359},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3376":2002,"_29549":1966,"_20523":54361,"_5":14087,"_26884":54268,"_2862":54362},[],"Check that a new connection with that identity is rejected.",{"_3376":2003,"_29549":1966,"_20523":54364,"_5":14087,"_26884":54268,"_2862":54365},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3376":2004,"_29549":1966,"_20523":54367,"_5":14087,"_26884":54268,"_2862":54368},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3376":2005,"_29549":1966,"_20523":54370,"_5":14087,"_26884":54268,"_2862":54371},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3376":2006,"_29549":1966,"_20523":54373,"_5":14087,"_26884":54268,"_2862":54374},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3376":2007,"_29549":1966,"_20523":54376,"_5":14087,"_26884":54268,"_2862":54377},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3376":2008,"_29549":2008,"_5":14445,"_2862":54379,"_29901":54380,"_20523":54381,"_26884":2008},"Certificates",[48143,49611,53620,53621],[],{"_3376":2009,"_29549":2008,"_20523":54383,"_5":14087,"_26884":2008,"_2862":54384},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3376":2010,"_29549":2008,"_5":29898,"_20523":54386,"_26884":54387,"_2862":54388},[],"/docs/pr-preview/pr-52/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3376":2011,"_29549":2008,"_5":29898,"_20523":54390,"_26884":54391,"_2862":54392},[],"/docs/pr-preview/pr-52/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3376":2012,"_29549":2008,"_5":29898,"_20523":54394,"_26884":54395,"_2862":54396},[],"/docs/pr-preview/pr-52/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3376":2013,"_29549":2008,"_5":29898,"_20523":54398,"_26884":54399,"_2862":54400},[],"/docs/pr-preview/pr-52/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3376":2014,"_29549":2008,"_5":29898,"_20523":54402,"_26884":54403,"_2862":54404},[],"/docs/pr-preview/pr-52/platform/pki/certificates#open-the-action","Open the action",{"_3376":2015,"_29549":2008,"_5":29898,"_20523":54406,"_26884":54407,"_2862":54408},[],"/docs/pr-preview/pr-52/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3376":2016,"_29549":2008,"_5":29898,"_20523":54410,"_26884":54411,"_2862":54412},[],"/docs/pr-preview/pr-52/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3376":2017,"_29549":2008,"_5":29898,"_20523":54414,"_26884":54415,"_2862":54416},[],"/docs/pr-preview/pr-52/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3376":2018,"_29549":2008,"_5":29898,"_20523":54418,"_26884":54419,"_2862":54420},[],"/docs/pr-preview/pr-52/platform/pki/certificates#continue","Continue",{"_3376":2019,"_29549":2008,"_20523":54422,"_5":14087,"_26884":2008,"_2862":54423},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3376":2020,"_29549":2008,"_20523":54425,"_5":14087,"_26884":54387,"_2862":54426},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata. Certificate details include the key reference (`key_id`) and whether the private key is managed (`has_private_key`), and certificate lists can be filtered on `has_private_key`.",{"_3376":2021,"_29549":2008,"_20523":54428,"_5":14087,"_26884":54387,"_2862":54429},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3376":2022,"_29549":2008,"_20523":54431,"_5":14087,"_26884":54391,"_2862":54432},[],"Download the PEM and inspect it:",{"_3376":2023,"_29549":2008,"_20523":54434,"_5":14087,"_26884":54391,"_2862":54435},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3376":2024,"_29549":2008,"_20523":54437,"_5":14087,"_26884":54395,"_2862":54438},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3376":2025,"_29549":2008,"_20523":54440,"_5":14087,"_26884":54395,"_2862":54441},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3376":2026,"_29549":2008,"_20523":54443,"_5":14087,"_26884":54395,"_2862":54444},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3376":2027,"_29549":2008,"_20523":54446,"_5":14087,"_26884":54395,"_2862":54447},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3376":2028,"_29549":2008,"_20523":54449,"_5":14087,"_26884":54395,"_2862":54450},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3376":2029,"_29549":2008,"_20523":54452,"_5":14087,"_26884":54395,"_2862":54453},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3376":2030,"_29549":2008,"_20523":54455,"_5":14087,"_26884":54395,"_2862":54456},[],"For browser key generation, follow Issue your first certificate.",{"_3376":2031,"_29549":2008,"_20523":54458,"_5":14087,"_26884":54399,"_2862":54459},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3376":2032,"_29549":2008,"_20523":54461,"_5":14087,"_26884":54403,"_2862":54462},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3376":2033,"_29549":2008,"_20523":54464,"_5":14087,"_26884":54407,"_2862":54465},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3376":2034,"_29549":2008,"_20523":54467,"_5":14087,"_26884":54411,"_2862":54468},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3376":2035,"_29549":2008,"_20523":54470,"_5":14087,"_26884":54411,"_2862":54471},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3376":2036,"_29549":2008,"_20523":54473,"_5":14087,"_26884":54411,"_2862":54474},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3376":2037,"_29549":2008,"_20523":54476,"_5":14087,"_26884":54415,"_2862":54477},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3376":2038,"_29549":2008,"_20523":54479,"_5":14087,"_26884":54415,"_2862":54480},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3376":2039,"_29549":2008,"_20523":54482,"_5":14087,"_26884":54415,"_2862":54483},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3376":2040,"_29549":2008,"_20523":54485,"_5":14087,"_26884":54419,"_2862":54486},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3376":2041,"_29549":2008,"_20523":54488,"_5":14087,"_26884":54419,"_2862":54489},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3376":2042,"_29549":2042,"_5":14445,"_2862":54491,"_29901":54492,"_20523":54494,"_26884":2042},"Certificate lifecycle",[48143,49611,53620,54493],"Concepts",[],{"_3376":2043,"_29549":2042,"_20523":54496,"_5":14087,"_26884":2042,"_2862":54497},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3376":2044,"_29549":2042,"_5":29898,"_20523":54499,"_26884":54500,"_2862":54501},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3376":2045,"_29549":2042,"_5":29898,"_20523":54503,"_26884":54504,"_2862":54505},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3376":2046,"_29549":2042,"_5":29898,"_20523":54507,"_26884":54508,"_2862":54509},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3376":2047,"_29549":2042,"_5":29898,"_20523":54511,"_26884":54512,"_2862":54513},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3376":2048,"_29549":2042,"_5":29898,"_20523":54515,"_26884":54516,"_2862":54517},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3376":2049,"_29549":2042,"_5":29898,"_20523":54519,"_26884":54520,"_2862":54521},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3376":2050,"_29549":2042,"_5":29898,"_20523":54523,"_26884":54524,"_2862":54525},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3376":2051,"_29549":2042,"_5":29898,"_20523":54527,"_26884":54528,"_2862":54529},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3376":2052,"_29549":2042,"_5":29898,"_20523":54531,"_26884":54532,"_2862":54533},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3376":2053,"_29549":2042,"_5":29898,"_20523":54535,"_26884":54536,"_2862":54537},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3376":2054,"_29549":2042,"_20523":54539,"_5":14087,"_26884":2042,"_2862":54540},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3376":2055,"_29549":2042,"_20523":54542,"_5":14087,"_26884":54504,"_2862":54543},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3376":2056,"_29549":2042,"_20523":54545,"_5":14087,"_26884":54508,"_2862":54546},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3376":2057,"_29549":2042,"_20523":54548,"_5":14087,"_26884":54512,"_2862":54549},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3376":2058,"_29549":2042,"_20523":54551,"_5":14087,"_26884":54516,"_2862":54552},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3376":2059,"_29549":2042,"_20523":54554,"_5":14087,"_26884":54520,"_2862":54555},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3376":2060,"_29549":2042,"_20523":54557,"_5":14087,"_26884":54524,"_2862":54558},[],"Lamassu persists four X.509 states:",{"_3376":2061,"_29549":2042,"_20523":54560,"_5":14087,"_26884":54524,"_2862":54561},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3376":2062,"_29549":2042,"_20523":54563,"_5":14087,"_26884":54524,"_2862":54564},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3376":2063,"_29549":2042,"_20523":54566,"_5":14087,"_26884":54524,"_2862":54567},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3376":2064,"_29549":2042,"_20523":54569,"_5":14087,"_26884":54524,"_2862":54570},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3376":2065,"_29549":2042,"_20523":54572,"_5":14087,"_26884":54524,"_2862":54573},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3376":2066,"_29549":2042,"_20523":54575,"_5":14087,"_26884":54528,"_2862":54576},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3376":2067,"_29549":2042,"_20523":54578,"_5":14087,"_26884":54528,"_2862":54579},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3376":2068,"_29549":2042,"_20523":54581,"_5":14087,"_26884":54528,"_2862":54582},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3376":2069,"_29549":2042,"_20523":54584,"_5":14087,"_26884":54532,"_2862":54585},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3376":2070,"_29549":2042,"_20523":54587,"_5":14087,"_26884":54532,"_2862":54588},[],"Before confirming:",{"_3376":2071,"_29549":2042,"_20523":54590,"_5":14087,"_26884":54532,"_2862":54591},[],"Identify DMSs, devices and services that trust that chain.",{"_3376":2072,"_29549":2042,"_20523":54593,"_5":14087,"_26884":54532,"_2862":54594},[],"Distribute the new chain of trust.",{"_3376":2073,"_29549":2042,"_20523":54596,"_5":14087,"_26884":54532,"_2862":54597},[],"Reissue the necessary identities.",{"_3376":2074,"_29549":2042,"_20523":54599,"_5":14087,"_26884":54532,"_2862":54600},[],"Check OCSP and CRL from a real consumer.",{"_3376":2075,"_29549":2042,"_20523":54602,"_5":14087,"_26884":54532,"_2862":54603},[],"Revoke the old CA once no legitimate traffic remains.",{"_3376":2076,"_29549":2042,"_20523":54605,"_5":14087,"_26884":54532,"_2862":54606},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3376":2077,"_29549":2042,"_20523":54608,"_5":14087,"_26884":54536,"_2862":54609},[],"Certificates entering the preventive or critical renewal window.",{"_3376":2078,"_29549":2042,"_20523":54611,"_5":14087,"_26884":54536,"_2862":54612},[],"Repeated enrollment or re-enrollment failures.",{"_3376":2079,"_29549":2042,"_20523":54614,"_5":14087,"_26884":54536,"_2862":54615},[],"Status changes and revocation reasons.",{"_3376":2080,"_29549":2042,"_20523":54617,"_5":14087,"_26884":54536,"_2862":54618},[],"OCSP and CRL publication and validity.",{"_3376":2081,"_29549":2042,"_20523":54620,"_5":14087,"_26884":54536,"_2862":54621},[],"Dependencies still presenting a replaced certificate.",{"_3376":2082,"_29549":2042,"_20523":54623,"_5":14087,"_26884":54536,"_2862":54624},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3376":2083,"_29549":2083,"_5":14445,"_2862":54626,"_29901":54627,"_20523":54628,"_26884":2083},"Trust model",[48143,49611,53620,54493],[],{"_3376":2084,"_29549":2083,"_20523":54630,"_5":14087,"_26884":2083,"_2862":54631},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3376":2085,"_29549":2083,"_5":29898,"_20523":54633,"_26884":54634,"_2862":54635},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3376":2086,"_29549":2083,"_5":29898,"_20523":54637,"_26884":54638,"_2862":54639},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3376":2087,"_29549":2083,"_5":29898,"_20523":54641,"_26884":54642,"_2862":54643},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3376":2088,"_29549":2083,"_5":29898,"_20523":54645,"_26884":54646,"_2862":54647},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3376":2089,"_29549":2083,"_5":29898,"_20523":54649,"_26884":54650,"_2862":54651},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3376":2090,"_29549":2083,"_5":29898,"_20523":54653,"_26884":54654,"_2862":54655},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3376":2091,"_29549":2083,"_5":29898,"_20523":54657,"_26884":54658,"_2862":54659},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3376":2092,"_29549":2083,"_5":29898,"_20523":54661,"_26884":54662,"_2862":54663},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3376":2093,"_29549":2083,"_5":29898,"_20523":54665,"_26884":54666,"_2862":54667},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3376":2094,"_29549":2083,"_5":29898,"_20523":54669,"_26884":54670,"_2862":54671},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3376":2095,"_29549":2083,"_20523":54673,"_5":14087,"_26884":2083,"_2862":54674},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3376":2096,"_29549":2083,"_20523":54676,"_5":14087,"_26884":54638,"_2862":54677},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3376":2097,"_29549":2083,"_20523":54679,"_5":14087,"_26884":54642,"_2862":54680},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3376":2098,"_29549":2083,"_20523":54682,"_5":14087,"_26884":54646,"_2862":54683},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3376":2099,"_29549":2083,"_20523":54685,"_5":14087,"_26884":54650,"_2862":54686},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3376":2100,"_29549":2083,"_20523":54688,"_5":14087,"_26884":54654,"_2862":54689},[],"The device proves it can enroll according to the DMS policy.",{"_3376":2101,"_29549":2083,"_20523":54691,"_5":14087,"_26884":54654,"_2862":54692},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3376":2102,"_29549":2083,"_20523":54694,"_5":14087,"_26884":54654,"_2862":54695},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3376":2103,"_29549":2083,"_20523":54697,"_5":14087,"_26884":54654,"_2862":54698},[],"The device installs the certificate and the chain it needs.",{"_3376":2104,"_29549":2083,"_20523":54700,"_5":14087,"_26884":54654,"_2862":54701},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3376":2105,"_29549":2083,"_20523":54703,"_5":14087,"_26884":54654,"_2862":54704},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3376":2106,"_29549":2083,"_20523":54706,"_5":14087,"_26884":54658,"_2862":54707},[],"A DMS relates three sets that are worth designing separately:",{"_3376":2107,"_29549":2083,"_20523":54709,"_5":14087,"_26884":54658,"_2862":54710},[],"**Enrollment CA:** signs the new identities.",{"_3376":2108,"_29549":2083,"_20523":54712,"_5":14087,"_26884":54658,"_2862":54713},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3376":2109,"_29549":2083,"_20523":54715,"_5":14087,"_26884":54658,"_2862":54716},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3376":2110,"_29549":2083,"_20523":54718,"_5":14087,"_26884":54658,"_2862":54719},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3376":2111,"_29549":2083,"_20523":54721,"_5":14087,"_26884":54662,"_2862":54722},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3376":2112,"_29549":2083,"_20523":54724,"_5":14087,"_26884":54662,"_2862":54725},[],"that the current date is between `Not Before` and `Not After`;",{"_3376":2113,"_29549":2083,"_20523":54727,"_5":14087,"_26884":54662,"_2862":54728},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3376":2114,"_29549":2083,"_20523":54730,"_5":14087,"_26884":54662,"_2862":54731},[],"that names, SANs and subject match the expected identity;",{"_3376":2115,"_29549":2083,"_20523":54733,"_5":14087,"_26884":54662,"_2862":54734},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3376":2116,"_29549":2083,"_20523":54736,"_5":14087,"_26884":54662,"_2862":54737},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3376":2117,"_29549":2083,"_20523":54739,"_5":14087,"_26884":54662,"_2862":54740},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3376":2118,"_29549":2083,"_20523":54742,"_5":14087,"_26884":54666,"_2862":54743},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3376":2119,"_29549":2083,"_20523":54745,"_5":14087,"_26884":54670,"_2862":54746},[],"Keep the root out of daily operations, or with very restricted access.",{"_3376":2120,"_29549":2083,"_20523":54748,"_5":14087,"_26884":54670,"_2862":54749},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3376":2121,"_29549":2083,"_20523":54751,"_5":14087,"_26884":54670,"_2862":54752},[],"Assign explicit profiles to every use case.",{"_3376":2122,"_29549":2083,"_20523":54754,"_5":14087,"_26884":54670,"_2862":54755},[],"Distribute the new trust before starting a rotation.",{"_3376":2123,"_29549":2083,"_20523":54757,"_5":14087,"_26884":54670,"_2862":54758},[],"Keep enough overlap to renew a disconnected fleet.",{"_3376":2124,"_29549":2083,"_20523":54760,"_5":14087,"_26884":54670,"_2862":54761},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3376":2125,"_29549":2083,"_20523":54763,"_5":14087,"_26884":54670,"_2862":54764},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3376":2126,"_29549":2126,"_5":14445,"_2862":54766,"_29901":54767,"_20523":54768,"_26884":2126},"Revocation lists (CRL)",[48143,49611,53620,54253],[],{"_3376":2127,"_29549":2126,"_20523":54770,"_5":14087,"_26884":2126,"_2862":54771},[],"Generate and distribute signed lists to validate certificates offline.",{"_3376":2128,"_29549":2126,"_5":29898,"_20523":54773,"_26884":54774,"_2862":54775},[],"/docs/pr-preview/pr-52/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_3376":2129,"_29549":2126,"_5":29898,"_20523":54777,"_26884":54778,"_2862":54779},[],"/docs/pr-preview/pr-52/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3376":2130,"_29549":2126,"_5":29898,"_20523":54781,"_26884":54782,"_2862":54783},[],"/docs/pr-preview/pr-52/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3376":2131,"_29549":2126,"_5":29898,"_20523":54785,"_26884":54786,"_2862":54787},[],"/docs/pr-preview/pr-52/platform/pki/crl#crl-contents","CRL contents",{"_3376":2132,"_29549":2126,"_5":29898,"_20523":54789,"_26884":54790,"_2862":54791},[],"/docs/pr-preview/pr-52/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3376":2133,"_29549":2126,"_5":29898,"_20523":54793,"_26884":54794,"_2862":54795},[],"/docs/pr-preview/pr-52/platform/pki/crl#va-role-management-api","VA role management API",{"_3376":2134,"_29549":2126,"_5":29898,"_20523":54797,"_26884":54798,"_2862":54799},[],"/docs/pr-preview/pr-52/platform/pki/crl#common-va-role-errors","Common VA role errors",{"_3376":2135,"_29549":2126,"_5":29898,"_20523":54801,"_26884":54802,"_2862":54803},[],"/docs/pr-preview/pr-52/platform/pki/crl#from-the-interface","From the interface",{"_3376":2136,"_29549":2126,"_5":29898,"_20523":54805,"_26884":54806,"_2862":54807},[],"/docs/pr-preview/pr-52/platform/pki/crl#references","References",{"_3376":2137,"_29549":2126,"_20523":54809,"_5":14087,"_26884":2126,"_2862":54810},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3376":2138,"_29549":2126,"_20523":54812,"_5":14087,"_26884":54774,"_2862":54813},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3376":2139,"_29549":2126,"_20523":54815,"_5":14087,"_26884":54774,"_2862":54816},[],"`crl_options` field",{"_3376":2140,"_29549":2126,"_20523":54818,"_5":14087,"_26884":54774,"_2862":48533},[],{"_3376":2141,"_29549":2126,"_20523":54820,"_5":14087,"_26884":54774,"_2862":54821},[],"Backend initial value",{"_3376":2142,"_29549":2126,"_20523":54823,"_5":14087,"_26884":54774,"_2862":54824},[],"`validity`",{"_3376":2143,"_29549":2126,"_20523":54826,"_5":14087,"_26884":54774,"_2862":54827},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3376":2144,"_29549":2126,"_20523":54829,"_5":14087,"_26884":54774,"_2862":54830},[],"7 days.",{"_3376":2145,"_29549":2126,"_20523":54832,"_5":14087,"_26884":54774,"_2862":54833},[],"`refresh_interval`",{"_3376":2146,"_29549":2126,"_20523":54835,"_5":14087,"_26884":54774,"_2862":54836},[],"Stored and returned by the API, but the VA does not use it: scheduled renewal does not depend on it (see Periodic and automatic regeneration).",{"_3376":2147,"_29549":2126,"_20523":54838,"_5":14087,"_26884":54774,"_2862":54839},[],"6 days and 23 hours.",{"_3376":2148,"_29549":2126,"_20523":54841,"_5":14087,"_26884":54774,"_2862":54842},[],"`regenerate_on_revoke`",{"_3376":2149,"_29549":2126,"_20523":54844,"_5":14087,"_26884":54774,"_2862":54845},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3376":2150,"_29549":2126,"_20523":54847,"_5":14087,"_26884":54774,"_2862":54848},[],"`true`.",{"_3376":2151,"_29549":2126,"_20523":54850,"_5":14087,"_26884":54774,"_2862":54851},[],"`signer_certificate_serial_number`",{"_3376":2152,"_29549":2126,"_20523":54853,"_5":14087,"_26884":54774,"_2862":54854},[],"Serial number of the existing certificate that signs the CRL.",{"_3376":2153,"_29549":2126,"_20523":54856,"_5":14087,"_26884":54774,"_2862":54857},[],"Serial number of the CA’s current certificate.",{"_3376":2154,"_29549":2126,"_20523":54859,"_5":14087,"_26884":54774,"_2862":54860},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3376":2155,"_29549":2126,"_20523":54862,"_5":14087,"_26884":54774,"_2862":54863},[],"When a CA is reissued, the role keeps pointing at the previous certificate. CRLs remain valid because both certificates share subject and key, but the previous certificate cannot be deleted while the role uses it. To retire it, update the role’s signer.",{"_3376":2156,"_29549":2126,"_20523":54865,"_5":14087,"_26884":54774,"_2862":54866},[],"When a CA is deleted, its VA role is kept and cannot be removed through the API. If no other CA with the same SKI remains, the role can be read but any `PUT` returns 404, and the renewal job logs a warning on every cycle because it no longer finds the CA. The API offers no way out; it can only be fixed by editing the database. If another CA with that SKI remains, the role is still editable (see CAs that share a key). Adjust validity and signer before deleting the CA.",{"_3376":2157,"_29549":2126,"_20523":54868,"_5":14087,"_26884":54774,"_2862":54869},[],"A CA whose certificate lacks `cRLSign` cannot generate its CRL or edit its role (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and set it as the signer with `PUT`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages.",{"_3376":2158,"_29549":2126,"_20523":54871,"_5":14087,"_26884":54774,"_2862":54872},[],"`PUT` always validates the signer, even when the request does not change it. If the stored signer is no longer valid, no field of the role can be modified, not even the validity, until a valid one is set.",{"_3376":2159,"_29549":2126,"_20523":54874,"_5":14087,"_26884":54774,"_2862":54875},[],"Sharing a key between CAs can prevent CRL validation. See CAs that share a key.",{"_3376":2160,"_29549":2126,"_20523":54877,"_5":14087,"_26884":54774,"_2862":54878},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_3376":2161,"_29549":2126,"_20523":54880,"_5":14087,"_26884":54778,"_2862":54881},[],"The VA identifies each CRL by the CA’s SKI, and the SKI is derived from its key. Two CAs with the same key have the same SKI and share a single VA role and a single CRL. This happens when a CA is created on an existing KMS key, or when a CA is imported whose certificate declares an SKI already in use. Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. The first CA creates the role and the others keep it.",{"_3376":2162,"_29549":2126,"_20523":54883,"_5":14087,"_26884":54778,"_2862":54884},[],"The certificates of all of them point to `/crl/{ski}`, but the published list has the first CA as issuer and only includes its revocations. A verifier compares the CRL issuer with the issuer of the certificate it validates (RFC 5280, §6.3.2) and rejects the list if they differ. Depending on its policy, the certificate is blocked (*hard-fail*) or accepted even though it is revoked (*soft-fail*). Revocations of the secondary CAs do not appear in any list.",{"_3376":2163,"_29549":2126,"_20523":54886,"_5":14087,"_26884":54778,"_2862":54887},[],"If the first CA is deleted, CRL generation for the remaining one fails because the configured signer no longer matches a CA with that name. Until the role’s signer is updated to a certificate of the remaining CA, the last published list keeps being served until it expires (7 days by default).",{"_3376":2164,"_29549":2126,"_20523":54889,"_5":14087,"_26884":54778,"_2862":54890},[],"Before upgrading, review CAs that share a key. To detect the problem, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued. A CA imported with an SKI already in use does not replace the existing one as CRL issuer, because the issuer is resolved from the role’s signer. However, its own certificates point to that same URL and its revocations are not published. Until Lamassu rejects these imports, restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same collision, so also avoid reusing keys across CAs. A per-CA CRL and the rejection of imports whose SKI collides with an existing CA are both proposed in lamassuiot#834, and neither is implemented yet.",{"_3376":2165,"_29549":2126,"_20523":54892,"_5":14087,"_26884":54782,"_2862":54893},[],"The VA scheduled job checks every role on each run and requests another list when the remaining validity of `latest_crl` is less than the interval between runs. The frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. `refresh_interval` plays no part. Keep `validity` well above the interval: with a shorter validity, the list is regenerated on every cycle.",{"_3376":2166,"_29549":2126,"_20523":54895,"_5":14087,"_26884":54782,"_2862":54896},[],"If generation fails (for example, because of a role without a CA or an invalid signer), the job logs the warning `something went wrong while calculating CRL for CA <ski>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3376":2167,"_29549":2126,"_20523":54898,"_5":14087,"_26884":54782,"_2862":54899},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if it fails (missing role, invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3376":2168,"_29549":2126,"_20523":54901,"_5":14087,"_26884":54782,"_2862":54902},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3376":2169,"_29549":2126,"_20523":54904,"_5":14087,"_26884":54786,"_2862":54905},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3376":2170,"_29549":2126,"_20523":54907,"_5":14087,"_26884":54786,"_2862":54908},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3376":2171,"_29549":2126,"_20523":54910,"_5":14087,"_26884":54790,"_2862":54911},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_3376":2172,"_29549":2126,"_20523":54913,"_5":14087,"_26884":54790,"_2862":54914},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3376":2173,"_29549":2126,"_20523":54916,"_5":14087,"_26884":54790,"_2862":54917},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3376":2174,"_29549":2126,"_20523":54919,"_5":14087,"_26884":54790,"_2862":54920},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3376":2175,"_29549":2126,"_20523":54922,"_5":14087,"_26884":54790,"_2862":54923},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3376":2176,"_29549":2126,"_20523":54925,"_5":14087,"_26884":54794,"_2862":54926},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3376":2177,"_29549":2126,"_20523":54928,"_5":14087,"_26884":54794,"_2862":51378},[],{"_3376":2178,"_29549":2126,"_20523":54930,"_5":14087,"_26884":54794,"_2862":54931},[],"Relative path",{"_3376":2179,"_29549":2126,"_20523":54933,"_5":14087,"_26884":54794,"_2862":51375},[],{"_3376":2180,"_29549":2126,"_20523":54935,"_5":14087,"_26884":54794,"_2862":54936},[],"`GET`",{"_3376":2181,"_29549":2126,"_20523":54938,"_5":14087,"_26884":54794,"_2862":54939},[],"`/v1/roles/{ca-ski}`",{"_3376":2182,"_29549":2126,"_20523":54941,"_5":14087,"_26884":54794,"_2862":54942},[],"Read `crl_options` and `latest_crl`.",{"_3376":2183,"_29549":2126,"_20523":54944,"_5":14087,"_26884":54794,"_2862":54945},[],"`PUT`",{"_3376":2184,"_29549":2126,"_20523":54947,"_5":14087,"_26884":54794,"_2862":54939},[],{"_3376":2185,"_29549":2126,"_20523":54949,"_5":14087,"_26884":54794,"_2862":54950},[],"Replace CRL configuration.",{"_3376":2186,"_29549":2126,"_20523":54952,"_5":14087,"_26884":54794,"_2862":54953},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_3376":2187,"_29549":2126,"_20523":54955,"_5":14087,"_26884":54794,"_2862":54956},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_3376":2188,"_29549":2126,"_20523":54958,"_5":14087,"_26884":54798,"_2862":54959},[],"Symptom",{"_3376":2189,"_29549":2126,"_20523":54961,"_5":14087,"_26884":54798,"_2862":54962},[],"Cause",{"_3376":2190,"_29549":2126,"_20523":54964,"_5":14087,"_26884":54798,"_2862":54965},[],"Action",{"_3376":2191,"_29549":2126,"_20523":54967,"_5":14087,"_26884":54798,"_2862":54968},[],"`PUT /v1/roles/{ca-ski}` returns 404 and `GET` returns 200.",{"_3376":2192,"_29549":2126,"_20523":54970,"_5":14087,"_26884":54798,"_2862":54971},[],"The role’s CA was deleted and no other CA with the same SKI remains.",{"_3376":2193,"_29549":2126,"_20523":54973,"_5":14087,"_26884":54798,"_2862":54974},[],"There is no API way out; it requires database intervention. Avoid it by adjusting the role before deleting the CA.",{"_3376":2194,"_29549":2126,"_20523":54976,"_5":14087,"_26884":54798,"_2862":54977},[],"`PUT` returns 400.",{"_3376":2195,"_29549":2126,"_20523":54979,"_5":14087,"_26884":54798,"_2862":54980},[],"The signer lacks `cRLSign`, or its subject and key match no CA with that SKI (for example, after deleting the first of two CAs that share a key).",{"_3376":2196,"_29549":2126,"_20523":54982,"_5":14087,"_26884":54798,"_2862":54983},[],"Use `PUT` to set the serial number of a valid certificate of the remaining CA.",{"_3376":2197,"_29549":2126,"_20523":54985,"_5":14087,"_26884":54798,"_2862":54986},[],"`PUT` returns 400 from a 3.x client.",{"_3376":2198,"_29549":2126,"_20523":54988,"_5":14087,"_26884":54798,"_2862":54989},[],"`crl_options.subject_key_id_signer` was replaced by `signer_certificate_serial_number`, which is required.",{"_3376":2199,"_29549":2126,"_20523":54991,"_5":14087,"_26884":54798,"_2862":54992},[],"Update the client to send the new field.",{"_3376":2200,"_29549":2126,"_20523":54994,"_5":14087,"_26884":54798,"_2862":54995},[],"The CRL does not change after revoking a certificate.",{"_3376":2201,"_29549":2126,"_20523":54997,"_5":14087,"_26884":54798,"_2862":54998},[],"`regenerate_on_revoke` is `false`, or the event failed because of a missing role or an invalid signer.",{"_3376":2202,"_29549":2126,"_20523":55000,"_5":14087,"_26884":54798,"_2862":55001},[],"Check the VA logs and the failed-events queue; fix the signer.",{"_3376":2203,"_29549":2126,"_20523":55003,"_5":14087,"_26884":54798,"_2862":55004},[],"A verifier rejects the CRL because of the issuer.",{"_3376":2204,"_29549":2126,"_20523":55006,"_5":14087,"_26884":54798,"_2862":55007},[],"Several CAs share an SKI.",{"_3376":2205,"_29549":2126,"_20523":55009,"_5":14087,"_26884":54798,"_2862":55010},[],"See CAs that share a key.",{"_3376":2206,"_29549":2126,"_20523":55012,"_5":14087,"_26884":54802,"_2862":55013},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_3376":2207,"_29549":2126,"_20523":55015,"_5":14087,"_26884":54806,"_2862":55016},[],"RFC 5280: X.509 and CRL profile.",{"_3376":2208,"_29549":2126,"_20523":55018,"_5":14087,"_26884":54806,"_2862":55019},[],"OpenSSL: openssl-crl.",{"_3376":2209,"_29549":2126,"_20523":55021,"_5":14087,"_26884":54806,"_2862":55022},[],"OpenSSL: openssl-verify.",{"_3376":2210,"_29549":2126,"_20523":55024,"_5":14087,"_26884":54806,"_2862":55025},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3376":2211,"_29549":2126,"_20523":55027,"_5":14087,"_26884":54806,"_2862":55028},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3376":2212,"_29549":2212,"_5":14445,"_2862":55030,"_29901":55031,"_20523":55032,"_26884":2212},"Keys and cryptographic engines",[48143,49611,53620,53621],[],{"_3376":2213,"_29549":2212,"_20523":55034,"_5":14087,"_26884":2212,"_2862":55035},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3376":2214,"_29549":2212,"_5":29898,"_20523":55037,"_26884":55038,"_2862":55039},[],"/docs/pr-preview/pr-52/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3376":2215,"_29549":2212,"_5":29898,"_20523":55041,"_26884":55042,"_2862":55043},[],"/docs/pr-preview/pr-52/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3376":2216,"_29549":2212,"_5":29898,"_20523":55045,"_26884":55046,"_2862":55047},[],"/docs/pr-preview/pr-52/platform/pki/key-management#file-system","File System",{"_3376":2217,"_29549":2212,"_5":29898,"_20523":55049,"_26884":55050,"_2862":55051},[],"/docs/pr-preview/pr-52/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3376":2218,"_29549":2212,"_5":29898,"_20523":55053,"_26884":55054,"_2862":55055},[],"/docs/pr-preview/pr-52/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3376":2219,"_29549":2212,"_5":29898,"_20523":55057,"_26884":55058,"_2862":55059},[],"/docs/pr-preview/pr-52/platform/pki/key-management#aws-kms","AWS KMS",{"_3376":2220,"_29549":2212,"_5":29898,"_20523":55061,"_26884":55062,"_2862":55063},[],"/docs/pr-preview/pr-52/platform/pki/key-management#pkcs11","PKCS#11",{"_3376":2221,"_29549":2212,"_5":29898,"_20523":55065,"_26884":55066,"_2862":55067},[],"/docs/pr-preview/pr-52/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3376":2222,"_29549":2212,"_5":29898,"_20523":55069,"_26884":55070,"_2862":55071},[],"/docs/pr-preview/pr-52/platform/pki/key-management#key-inventory","Key inventory",{"_3376":2223,"_29549":2212,"_5":29898,"_20523":55073,"_26884":55074,"_2862":55075},[],"/docs/pr-preview/pr-52/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3376":2224,"_29549":2212,"_5":29898,"_20523":55077,"_26884":55078,"_2862":55079},[],"/docs/pr-preview/pr-52/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3376":2225,"_29549":2212,"_5":29898,"_20523":55081,"_26884":55082,"_2862":55083},[],"/docs/pr-preview/pr-52/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3376":2226,"_29549":2212,"_5":29898,"_20523":55085,"_26884":55086,"_2862":55087},[],"/docs/pr-preview/pr-52/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3376":2227,"_29549":2212,"_5":29898,"_20523":55089,"_26884":55090,"_2862":55091},[],"/docs/pr-preview/pr-52/platform/pki/key-management#view-details","View details",{"_3376":2228,"_29549":2212,"_5":29898,"_20523":55093,"_26884":55094,"_2862":55095},[],"/docs/pr-preview/pr-52/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3376":2229,"_29549":2212,"_5":29898,"_20523":55097,"_26884":55098,"_2862":55099},[],"/docs/pr-preview/pr-52/platform/pki/key-management#sign","Sign",{"_3376":2230,"_29549":2212,"_5":29898,"_20523":55101,"_26884":55102,"_2862":55103},[],"/docs/pr-preview/pr-52/platform/pki/key-management#verify","Verify",{"_3376":2231,"_29549":2212,"_5":29898,"_20523":55105,"_26884":55106,"_2862":55107},[],"/docs/pr-preview/pr-52/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3376":2232,"_29549":2212,"_5":29898,"_20523":55109,"_26884":55110,"_2862":55111},[],"/docs/pr-preview/pr-52/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3376":2233,"_29549":2212,"_5":29898,"_20523":55113,"_26884":55114,"_2862":55115},[],"/docs/pr-preview/pr-52/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3376":2234,"_29549":2212,"_20523":55117,"_5":14087,"_26884":2212,"_2862":55118},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3376":2235,"_29549":2212,"_20523":55120,"_5":14087,"_26884":2212,"_2862":55121},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3376":2236,"_29549":2212,"_20523":55123,"_5":14087,"_26884":55038,"_2862":55124},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3376":2237,"_29549":2212,"_20523":55126,"_5":14087,"_26884":55038,"_2862":55127},[],"In practice, it lets you:",{"_3376":2238,"_29549":2212,"_20523":55129,"_5":14087,"_26884":55038,"_2862":55130},[],"Generate new key pairs from Lamassu IoT.",{"_3376":2239,"_29549":2212,"_20523":55132,"_5":14087,"_26884":55038,"_2862":55133},[],"Import keys created externally.",{"_3376":2240,"_29549":2212,"_20523":55135,"_5":14087,"_26884":55038,"_2862":55136},[],"Delegate custody and cryptographic operations to external engines.",{"_3376":2241,"_29549":2212,"_20523":55138,"_5":14087,"_26884":55038,"_2862":55139},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3376":2242,"_29549":2212,"_20523":55141,"_5":14087,"_26884":55042,"_2862":55142},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3376":2243,"_29549":2212,"_20523":55144,"_5":14087,"_26884":55042,"_2862":55145},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3376":2244,"_29549":2212,"_20523":55147,"_5":14087,"_26884":55042,"_2862":55148},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3376":2245,"_29549":2212,"_20523":55150,"_5":14087,"_26884":55046,"_2862":55151},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3376":2246,"_29549":2212,"_20523":55153,"_5":14087,"_26884":55050,"_2862":55154},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3376":2247,"_29549":2212,"_20523":55156,"_5":14087,"_26884":55050,"_2862":55157},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3376":2248,"_29549":2212,"_20523":55159,"_5":14087,"_26884":55054,"_2862":55160},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3376":2249,"_29549":2212,"_20523":55162,"_5":14087,"_26884":55058,"_2862":55163},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3376":2250,"_29549":2212,"_20523":55165,"_5":14087,"_26884":55062,"_2862":55166},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3376":2251,"_29549":2212,"_20523":55168,"_5":14087,"_26884":55066,"_2862":55169},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3376":2252,"_29549":2212,"_20523":55171,"_5":14087,"_26884":55066,"_2862":55172},[],"Lamassu shows the enabled engines in the console.",{"_3376":2253,"_29549":2212,"_20523":55174,"_5":14087,"_26884":55066,"_2862":55175},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3376":2254,"_29549":2212,"_20523":55177,"_5":14087,"_26884":55066,"_2862":55178},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3376":2255,"_29549":2212,"_20523":55180,"_5":14087,"_26884":55070,"_2862":55181},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3376":2256,"_29549":2212,"_20523":55183,"_5":14087,"_26884":55070,"_2862":55184},[],"The table includes the following fields:",{"_3376":2257,"_29549":2212,"_20523":55186,"_5":14087,"_26884":55070,"_2862":55187},[],"**Name**: descriptive name of the key.",{"_3376":2258,"_29549":2212,"_20523":55189,"_5":14087,"_26884":55070,"_2862":55190},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3376":2259,"_29549":2212,"_20523":55192,"_5":14087,"_26884":55070,"_2862":55193},[],"**Strength**: visual indicator of cryptographic strength.",{"_3376":2260,"_29549":2212,"_20523":55195,"_5":14087,"_26884":55070,"_2862":55196},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3376":2261,"_29549":2212,"_20523":55198,"_5":14087,"_26884":55070,"_2862":55199},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3376":2262,"_29549":2212,"_20523":55201,"_5":14087,"_26884":55070,"_2862":55202},[],"**Aliases**: alternative names associated with the key.",{"_3376":2263,"_29549":2212,"_20523":55204,"_5":14087,"_26884":55070,"_2862":55205},[],"**Tags**: labels for classification and search.",{"_3376":2264,"_29549":2212,"_20523":55207,"_5":14087,"_26884":55070,"_2862":55208},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3376":2265,"_29549":2212,"_20523":55210,"_5":14087,"_26884":55070,"_2862":55211},[],"From this view you also reach the most common actions:",{"_3376":2266,"_29549":2212,"_20523":55213,"_5":14087,"_26884":55070,"_2862":55214},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3376":2267,"_29549":2212,"_20523":55216,"_5":14087,"_26884":55070,"_2862":55217},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3376":2268,"_29549":2212,"_20523":55219,"_5":14087,"_26884":55070,"_2862":55220},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3376":2269,"_29549":2212,"_20523":55222,"_5":14087,"_26884":55070,"_2862":55223},[],"**Delete Key** to remove the key from the system.",{"_3376":2270,"_29549":2212,"_20523":55225,"_5":14087,"_26884":55074,"_2862":55226},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3376":2271,"_29549":2212,"_20523":55228,"_5":14087,"_26884":55078,"_2862":55229},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3376":2272,"_29549":2212,"_20523":55231,"_5":14087,"_26884":55078,"_2862":55232},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3376":2273,"_29549":2212,"_20523":55234,"_5":14087,"_26884":55078,"_2862":55235},[],"**Key Name**: unique and descriptive name.",{"_3376":2274,"_29549":2212,"_20523":55237,"_5":14087,"_26884":55078,"_2862":55238},[],"**Crypto Engine**: engine that will keep the key.",{"_3376":2275,"_29549":2212,"_20523":55240,"_5":14087,"_26884":55078,"_2862":55241},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3376":2276,"_29549":2212,"_20523":55243,"_5":14087,"_26884":55078,"_2862":55244},[],"**Tags**: metadata to classify the key.",{"_3376":2277,"_29549":2212,"_20523":55246,"_5":14087,"_26884":55078,"_2862":55247},[],"**Metadata**: additional information for advanced uses.",{"_3376":2278,"_29549":2212,"_20523":55249,"_5":14087,"_26884":55082,"_2862":55250},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3376":2279,"_29549":2212,"_20523":55252,"_5":14087,"_26884":55082,"_2862":55253},[],"When you have an exportable private key and the destination engine supports import.",{"_3376":2280,"_29549":2212,"_20523":55255,"_5":14087,"_26884":55082,"_2862":55256},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3376":2281,"_29549":2212,"_20523":55258,"_5":14087,"_26884":55082,"_2862":55259},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3376":2282,"_29549":2212,"_20523":55261,"_5":14087,"_26884":55082,"_2862":55262},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3376":2283,"_29549":2212,"_20523":55264,"_5":14087,"_26884":55082,"_2862":55265},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3376":2284,"_29549":2212,"_20523":55267,"_5":14087,"_26884":55082,"_2862":55268},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3376":2285,"_29549":2212,"_20523":55270,"_5":14087,"_26884":55082,"_2862":55271},[],"**Tags**: labels for organization and search.",{"_3376":2286,"_29549":2212,"_20523":55273,"_5":14087,"_26884":55082,"_2862":55274},[],"**Metadata**: additional optional information.",{"_3376":2287,"_29549":2212,"_20523":55276,"_5":14087,"_26884":55082,"_2862":55277},[],"**Private Key (PEM)**: private key in PEM format.",{"_3376":2288,"_29549":2212,"_20523":55279,"_5":14087,"_26884":55082,"_2862":55280},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3376":2289,"_29549":2212,"_20523":55282,"_5":14087,"_26884":55086,"_2862":55283},[],"Each registered key has a detail view and several operational actions.",{"_3376":2290,"_29549":2212,"_20523":55285,"_5":14087,"_26884":55090,"_2862":55286},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3376":2291,"_29549":2212,"_20523":55288,"_5":14087,"_26884":55090,"_2862":55289},[],"The **Overview** tab shows, among others, these fields:",{"_3376":2292,"_29549":2212,"_20523":55291,"_5":14087,"_26884":55090,"_2862":55292},[],"**Key Name**: descriptive name.",{"_3376":2293,"_29549":2212,"_20523":55294,"_5":14087,"_26884":55090,"_2862":55295},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3376":2294,"_29549":2212,"_20523":55297,"_5":14087,"_26884":55090,"_2862":55298},[],"**Tags**: associated labels.",{"_3376":2295,"_29549":2212,"_20523":55300,"_5":14087,"_26884":55090,"_2862":55301},[],"**Aliases**: alternative names.",{"_3376":2296,"_29549":2212,"_20523":55303,"_5":14087,"_26884":55090,"_2862":55304},[],"**Crypto Engine**: engine where the key resides.",{"_3376":2297,"_29549":2212,"_20523":55306,"_5":14087,"_26884":55090,"_2862":55307},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3376":2298,"_29549":2212,"_20523":55309,"_5":14087,"_26884":55090,"_2862":55310},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3376":2299,"_29549":2212,"_20523":55312,"_5":14087,"_26884":55090,"_2862":55313},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3376":2300,"_29549":2212,"_20523":55315,"_5":14087,"_26884":55094,"_2862":55316},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3376":2301,"_29549":2212,"_20523":55318,"_5":14087,"_26884":55094,"_2862":55319},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3376":2302,"_29549":2212,"_20523":55321,"_5":14087,"_26884":55094,"_2862":55322},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3376":2303,"_29549":2212,"_20523":55324,"_5":14087,"_26884":55098,"_2862":55325},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3376":2304,"_29549":2212,"_20523":55327,"_5":14087,"_26884":55098,"_2862":55328},[],"Main fields:",{"_3376":2305,"_29549":2212,"_20523":55330,"_5":14087,"_26884":55098,"_2862":55331},[],"**Algorithm**: signing algorithm available for the key type.",{"_3376":2306,"_29549":2212,"_20523":55333,"_5":14087,"_26884":55098,"_2862":55334},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3376":2307,"_29549":2212,"_20523":55336,"_5":14087,"_26884":55098,"_2862":55337},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3376":2308,"_29549":2212,"_20523":55339,"_5":14087,"_26884":55098,"_2862":55340},[],"**Message**: content to sign.",{"_3376":2309,"_29549":2212,"_20523":55342,"_5":14087,"_26884":55098,"_2862":55343},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3376":2310,"_29549":2212,"_20523":55345,"_5":14087,"_26884":55102,"_2862":55346},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3376":2311,"_29549":2212,"_20523":55348,"_5":14087,"_26884":55102,"_2862":55328},[],{"_3376":2312,"_29549":2212,"_20523":55350,"_5":14087,"_26884":55102,"_2862":55351},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3376":2313,"_29549":2212,"_20523":55353,"_5":14087,"_26884":55102,"_2862":55354},[],"**Message Type**: `Raw` or `Digest`.",{"_3376":2314,"_29549":2212,"_20523":55356,"_5":14087,"_26884":55102,"_2862":55357},[],"**Payload Encoding**: encoding of the message.",{"_3376":2315,"_29549":2212,"_20523":55359,"_5":14087,"_26884":55102,"_2862":55360},[],"**Message**: original message or hash.",{"_3376":2316,"_29549":2212,"_20523":55362,"_5":14087,"_26884":55102,"_2862":55363},[],"**Signature**: signature to check.",{"_3376":2317,"_29549":2212,"_20523":55365,"_5":14087,"_26884":55102,"_2862":55366},[],"**Result**: indicator of the validation result.",{"_3376":2318,"_29549":2212,"_20523":55368,"_5":14087,"_26884":55106,"_2862":55369},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3376":2319,"_29549":2212,"_20523":55371,"_5":14087,"_26884":55106,"_2862":55372},[],"This flow is useful for:",{"_3376":2320,"_29549":2212,"_20523":55374,"_5":14087,"_26884":55106,"_2862":55375},[],"Requesting certificates from an external CA.",{"_3376":2321,"_29549":2212,"_20523":55377,"_5":14087,"_26884":55106,"_2862":55378},[],"Renewing an identity while keeping the same key.",{"_3376":2322,"_29549":2212,"_20523":55380,"_5":14087,"_26884":55106,"_2862":55381},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3376":2323,"_29549":2212,"_20523":55383,"_5":14087,"_26884":55106,"_2862":55384},[],"**Common Name (CN)**: main name of the identity.",{"_3376":2324,"_29549":2212,"_20523":55386,"_5":14087,"_26884":55106,"_2862":55387},[],"**Organization (O)**: organization or company.",{"_3376":2325,"_29549":2212,"_20523":55389,"_5":14087,"_26884":55106,"_2862":55390},[],"**Organizational Unit (OU)**: department or unit.",{"_3376":2326,"_29549":2212,"_20523":55392,"_5":14087,"_26884":55106,"_2862":55393},[],"**Country (C)**: two-letter country code.",{"_3376":2327,"_29549":2212,"_20523":55395,"_5":14087,"_26884":55106,"_2862":55396},[],"**State / Province (ST)**: state or province.",{"_3376":2328,"_29549":2212,"_20523":55398,"_5":14087,"_26884":55106,"_2862":55399},[],"**Locality (L)**: city or locality.",{"_3376":2329,"_29549":2212,"_20523":55401,"_5":14087,"_26884":55106,"_2862":55402},[],"**Email Address**: contact email.",{"_3376":2330,"_29549":2212,"_20523":55404,"_5":14087,"_26884":55106,"_2862":55405},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3376":2331,"_29549":2212,"_20523":55407,"_5":14087,"_26884":55106,"_2862":55408},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3376":2332,"_29549":2212,"_20523":55410,"_5":14087,"_26884":55110,"_2862":55411},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3376":2333,"_29549":2212,"_20523":55413,"_5":14087,"_26884":55110,"_2862":55414},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3376":2334,"_29549":2212,"_20523":55416,"_5":14087,"_26884":55114,"_2862":55417},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3376":2335,"_29549":2212,"_20523":55419,"_5":14087,"_26884":55114,"_2862":55420},[],"The KMS refuses to delete a key that certificates still reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. Revoking certificates issued by the deleted CA does not release their own key references. Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3376":2336,"_29549":2336,"_5":14445,"_2862":55422,"_29901":55423,"_20523":55424,"_26884":2336},"Online validation with OCSP",[48143,49611,53620,54253],[],{"_3376":2337,"_29549":2336,"_20523":55426,"_5":14087,"_26884":2336,"_2862":55427},[],"Query signed status and verify the responder’s response.",{"_3376":2338,"_29549":2336,"_5":29898,"_20523":55429,"_26884":55430,"_2862":55431},[],"/docs/pr-preview/pr-52/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3376":2339,"_29549":2336,"_5":29898,"_20523":55433,"_26884":55434,"_2862":55435},[],"/docs/pr-preview/pr-52/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3376":2340,"_29549":2336,"_5":29898,"_20523":55437,"_26884":55438,"_2862":55439},[],"/docs/pr-preview/pr-52/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3376":2341,"_29549":2336,"_5":29898,"_20523":55441,"_26884":55442,"_2862":55443},[],"/docs/pr-preview/pr-52/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3376":2342,"_29549":2336,"_5":29898,"_20523":55445,"_26884":55446,"_2862":55447},[],"/docs/pr-preview/pr-52/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3376":2343,"_29549":2336,"_5":29898,"_20523":55449,"_26884":55450,"_2862":54807},[],"/docs/pr-preview/pr-52/platform/pki/ocsp#references",{"_3376":2344,"_29549":2336,"_20523":55452,"_5":14087,"_26884":2336,"_2862":55453},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3376":2345,"_29549":2336,"_20523":55455,"_5":14087,"_26884":55430,"_2862":55456},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3376":2346,"_29549":2336,"_20523":55458,"_5":14087,"_26884":55430,"_2862":55459},[],"Record status",{"_3376":2347,"_29549":2336,"_20523":55461,"_5":14087,"_26884":55430,"_2862":55462},[],"Signed response",{"_3376":2348,"_29549":2336,"_20523":55464,"_5":14087,"_26884":55430,"_2862":52791},[],{"_3376":2349,"_29549":2336,"_20523":55466,"_5":14087,"_26884":55430,"_2862":55467},[],"`Good`.",{"_3376":2350,"_29549":2336,"_20523":55469,"_5":14087,"_26884":55430,"_2862":52808},[],{"_3376":2351,"_29549":2336,"_20523":55471,"_5":14087,"_26884":55430,"_2862":55472},[],"`Revoked`, with revocation reason and timestamp.",{"_3376":2352,"_29549":2336,"_20523":55474,"_5":14087,"_26884":55430,"_2862":55475},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3376":2353,"_29549":2336,"_20523":55477,"_5":14087,"_26884":55430,"_2862":55478},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3376":2354,"_29549":2336,"_20523":55480,"_5":14087,"_26884":55430,"_2862":55481},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3376":2355,"_29549":2336,"_20523":55483,"_5":14087,"_26884":55430,"_2862":55484},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3376":2356,"_29549":2336,"_20523":55486,"_5":14087,"_26884":55430,"_2862":55487},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3376":2357,"_29549":2336,"_20523":55489,"_5":14087,"_26884":55434,"_2862":55490},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3376":2358,"_29549":2336,"_20523":55492,"_5":14087,"_26884":55434,"_2862":55493},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3376":2359,"_29549":2336,"_20523":55495,"_5":14087,"_26884":55438,"_2862":55496},[],"The service accepts:",{"_3376":2360,"_29549":2336,"_20523":55498,"_5":14087,"_26884":55438,"_2862":51378},[],{"_3376":2361,"_29549":2336,"_20523":55500,"_5":14087,"_26884":55438,"_2862":55501},[],"VA service path",{"_3376":2362,"_29549":2336,"_20523":55503,"_5":14087,"_26884":55438,"_2862":55504},[],"Format",{"_3376":2363,"_29549":2336,"_20523":55506,"_5":14087,"_26884":55438,"_2862":55507},[],"`POST`",{"_3376":2364,"_29549":2336,"_20523":55509,"_5":14087,"_26884":55438,"_2862":55510},[],"`/ocsp`",{"_3376":2365,"_29549":2336,"_20523":55512,"_5":14087,"_26884":55438,"_2862":55513},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3376":2366,"_29549":2336,"_20523":55515,"_5":14087,"_26884":55438,"_2862":54936},[],{"_3376":2367,"_29549":2336,"_20523":55517,"_5":14087,"_26884":55438,"_2862":55518},[],"`/ocsp/{ocsp_request}`",{"_3376":2368,"_29549":2336,"_20523":55520,"_5":14087,"_26884":55438,"_2862":55521},[],"DER request encoded using padded URL Base64.",{"_3376":2369,"_29549":2336,"_20523":55523,"_5":14087,"_26884":55438,"_2862":55524},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3376":2370,"_29549":2336,"_20523":55526,"_5":14087,"_26884":55442,"_2862":55527},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3376":2371,"_29549":2336,"_20523":55529,"_5":14087,"_26884":55442,"_2862":55530},[],"Generate the request:",{"_3376":2372,"_29549":2336,"_20523":55532,"_5":14087,"_26884":55442,"_2862":55533},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3376":2373,"_29549":2336,"_20523":55535,"_5":14087,"_26884":55442,"_2862":55536},[],"Replace the example URL with the inspected endpoint:",{"_3376":2374,"_29549":2336,"_20523":55538,"_5":14087,"_26884":55442,"_2862":55539},[],"Verify the returned DER:",{"_3376":2375,"_29549":2336,"_20523":55541,"_5":14087,"_26884":55442,"_2862":55542},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3376":2376,"_29549":2336,"_20523":55544,"_5":14087,"_26884":55446,"_2862":55545},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3376":2377,"_29549":2336,"_20523":55547,"_5":14087,"_26884":55446,"_2862":55548},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3376":2378,"_29549":2336,"_20523":55550,"_5":14087,"_26884":55450,"_2862":55551},[],"RFC 6960: OCSP.",{"_3376":2379,"_29549":2336,"_20523":55553,"_5":14087,"_26884":55450,"_2862":55554},[],"OpenSSL: openssl-ocsp.",{"_3376":2380,"_29549":2336,"_20523":55556,"_5":14087,"_26884":55450,"_2862":55557},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3376":2381,"_29549":2336,"_20523":55559,"_5":14087,"_26884":55450,"_2862":55028},[],{"_3376":2382,"_29549":2382,"_5":14445,"_2862":53620,"_29901":55561,"_20523":55562,"_26884":2382},[48143,49611,53620],[],{"_3376":2383,"_29549":2382,"_20523":55564,"_5":14087,"_26884":2382,"_2862":55565},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3376":2384,"_29549":2382,"_5":29898,"_20523":55567,"_26884":55568,"_2862":52932},[],"/docs/pr-preview/pr-52/platform/pki/overview#start-here",{"_3376":2385,"_29549":2382,"_5":29898,"_20523":55570,"_26884":55571,"_2862":55572},[],"/docs/pr-preview/pr-52/platform/pki/overview#what-you-need","What you need",{"_3376":2386,"_29549":2382,"_5":29898,"_20523":55574,"_26884":55575,"_2862":53464},[],"/docs/pr-preview/pr-52/platform/pki/overview#core-capabilities",{"_3376":2387,"_29549":2382,"_5":29898,"_20523":55577,"_26884":55578,"_2862":53468},[],"/docs/pr-preview/pr-52/platform/pki/overview#build-your-trust-hierarchy",{"_3376":2388,"_29549":2382,"_5":29898,"_20523":55580,"_26884":55581,"_2862":53472},[],"/docs/pr-preview/pr-52/platform/pki/overview#protect-cryptographic-keys",{"_3376":2389,"_29549":2382,"_5":29898,"_20523":55583,"_26884":55584,"_2862":53476},[],"/docs/pr-preview/pr-52/platform/pki/overview#issue-and-control-certificates",{"_3376":2390,"_29549":2382,"_5":29898,"_20523":55586,"_26884":55587,"_2862":53484},[],"/docs/pr-preview/pr-52/platform/pki/overview#publish-validation-status",{"_3376":2391,"_29549":2382,"_5":29898,"_20523":55589,"_26884":55590,"_2862":55591},[],"/docs/pr-preview/pr-52/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3376":2392,"_29549":2382,"_5":29898,"_20523":55593,"_26884":55594,"_2862":54420},[],"/docs/pr-preview/pr-52/platform/pki/overview#continue",{"_3376":2393,"_29549":2382,"_20523":55596,"_5":14087,"_26884":2382,"_2862":55597},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3376":2394,"_29549":2382,"_20523":55599,"_5":14087,"_26884":55568,"_2862":55600},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3376":2395,"_29549":2382,"_20523":55602,"_5":14087,"_26884":55568,"_2862":55603},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3376":2396,"_29549":2382,"_20523":55605,"_5":14087,"_26884":55571,"_2862":55606},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3376":2397,"_29549":2382,"_20523":55608,"_5":14087,"_26884":55571,"_2862":55609},[],"An available cryptographic engine to keep the authority's key.",{"_3376":2398,"_29549":2382,"_20523":55611,"_5":14087,"_26884":55571,"_2862":55612},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3376":2399,"_29549":2382,"_20523":55614,"_5":14087,"_26884":55571,"_2862":55615},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3376":2400,"_29549":2382,"_20523":55617,"_5":14087,"_26884":55571,"_2862":55618},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3376":2401,"_29549":2382,"_20523":55620,"_5":14087,"_26884":55578,"_2862":55621},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3376":2402,"_29549":2382,"_20523":55623,"_5":14087,"_26884":55581,"_2862":55624},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3376":2403,"_29549":2382,"_20523":55626,"_5":14087,"_26884":55584,"_2862":55627},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3376":2404,"_29549":2382,"_20523":55629,"_5":14087,"_26884":55587,"_2862":55630},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3376":2405,"_29549":2382,"_20523":55632,"_5":14087,"_26884":55590,"_2862":55633},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3376":2406,"_29549":2382,"_20523":55635,"_5":14087,"_26884":55590,"_2862":55636},[],"its subject and extensions identify the expected client;",{"_3376":2407,"_29549":2382,"_20523":55638,"_5":14087,"_26884":55590,"_2862":55639},[],"its public key matches the client's private key;",{"_3376":2408,"_29549":2382,"_20523":55641,"_5":14087,"_26884":55590,"_2862":55642},[],"its chain reaches a root trusted by the consumer;",{"_3376":2409,"_29549":2382,"_20523":55644,"_5":14087,"_26884":55590,"_2862":55645},[],"its dates and usages allow the operation;",{"_3376":2410,"_29549":2382,"_20523":55647,"_5":14087,"_26884":55590,"_2862":55648},[],"the consumer applies revocation checks and authorization.",{"_3376":2411,"_29549":2382,"_20523":55650,"_5":14087,"_26884":55590,"_2862":55651},[],"The issuance path includes the first independent checks.",{"_3376":2412,"_29549":2382,"_20523":55653,"_5":14087,"_26884":55594,"_2862":55654},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3376":2413,"_29549":2382,"_20523":55656,"_5":14087,"_26884":55594,"_2862":55657},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3376":2414,"_29549":2382,"_20523":55659,"_5":14087,"_26884":55594,"_2862":55660},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3376":2415,"_29549":2415,"_5":14445,"_2862":55662,"_29901":55663,"_20523":55664,"_26884":2415},"Create your first CA",[48143,49611,53620,53057],[],{"_3376":2416,"_29549":2415,"_20523":55666,"_5":14087,"_26884":2415,"_2862":55667},[],"Create an evaluation root and check its certificate before issuing.",{"_3376":2417,"_29549":2415,"_5":29898,"_20523":55669,"_26884":55670,"_2862":48153},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3376":2418,"_29549":2415,"_5":29898,"_20523":55672,"_26884":55673,"_2862":55674},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3376":2419,"_29549":2415,"_5":29898,"_20523":55676,"_26884":55677,"_2862":55678},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3376":2420,"_29549":2415,"_5":29898,"_20523":55680,"_26884":55681,"_2862":55682},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3376":2421,"_29549":2415,"_5":29898,"_20523":55684,"_26884":55685,"_2862":55686},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3376":2422,"_29549":2415,"_5":29898,"_20523":55688,"_26884":55689,"_2862":55690},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3376":2423,"_29549":2415,"_5":29898,"_20523":55692,"_26884":55693,"_2862":55694},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3376":2424,"_29549":2415,"_5":29898,"_20523":55696,"_26884":55697,"_2862":53314},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3376":2425,"_29549":2415,"_5":29898,"_20523":55699,"_26884":55700,"_2862":48177},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3376":2426,"_29549":2415,"_20523":55702,"_5":14087,"_26884":2415,"_2862":55703},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3376":2427,"_29549":2415,"_20523":55705,"_5":14087,"_26884":55670,"_2862":55706},[],"Console access and permission to create keys and authorities.",{"_3376":2428,"_29549":2415,"_20523":55708,"_5":14087,"_26884":55670,"_2862":55709},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3376":2429,"_29549":2415,"_20523":55711,"_5":14087,"_26884":55670,"_2862":55712},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3376":2430,"_29549":2415,"_20523":55714,"_5":14087,"_26884":55670,"_2862":55715},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3376":2431,"_29549":2415,"_20523":55717,"_5":14087,"_26884":55673,"_2862":55718},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3376":2432,"_29549":2415,"_20523":55720,"_5":14087,"_26884":55673,"_2862":55721},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3376":2433,"_29549":2415,"_20523":55723,"_5":14087,"_26884":55677,"_2862":55724},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3376":2434,"_29549":2415,"_20523":55726,"_5":14087,"_26884":55677,"_2862":55727},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3376":2435,"_29549":2415,"_20523":55729,"_5":14087,"_26884":55681,"_2862":55730},[],"Select **Root CA** and complete:",{"_3376":2436,"_29549":2415,"_20523":55732,"_5":14087,"_26884":55681,"_2862":55733},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3376":2437,"_29549":2415,"_20523":55735,"_5":14087,"_26884":55681,"_2862":55736},[],"**Subject**: organization and country details for your evaluation.",{"_3376":2438,"_29549":2415,"_20523":55738,"_5":14087,"_26884":55681,"_2862":55739},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3376":2439,"_29549":2415,"_20523":55741,"_5":14087,"_26884":55681,"_2862":55742},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3376":2440,"_29549":2415,"_20523":55744,"_5":14087,"_26884":55681,"_2862":55745},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3376":2441,"_29549":2415,"_20523":55747,"_5":14087,"_26884":55685,"_2862":55748},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3376":2442,"_29549":2415,"_20523":55750,"_5":14087,"_26884":55689,"_2862":55751},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3376":2443,"_29549":2415,"_20523":55753,"_5":14087,"_26884":55689,"_2862":55754},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3376":2444,"_29549":2415,"_20523":55756,"_5":14087,"_26884":55693,"_2862":55757},[],"Run from the directory where you saved `ca.pem`:",{"_3376":2445,"_29549":2415,"_20523":55759,"_5":14087,"_26884":55693,"_2862":55760},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3376":2446,"_29549":2415,"_20523":55762,"_5":14087,"_26884":55693,"_2862":55763},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3376":2447,"_29549":2415,"_20523":55765,"_5":14087,"_26884":55697,"_2862":55766},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3376":2448,"_29549":2415,"_20523":55768,"_5":14087,"_26884":55697,"_2862":55769},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3376":2449,"_29549":2415,"_20523":55771,"_5":14087,"_26884":55697,"_2862":55772},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3376":2450,"_29549":2415,"_20523":55774,"_5":14087,"_26884":55697,"_2862":55775},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3376":2451,"_29549":2415,"_20523":55777,"_5":14087,"_26884":55700,"_2862":55778},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3376":2452,"_29549":2452,"_5":14445,"_2862":55780,"_29901":55781,"_20523":55782,"_26884":2452},"Issue and verify a certificate",[48143,49611,53620,53057],[],{"_3376":2453,"_29549":2452,"_20523":55784,"_5":14087,"_26884":2452,"_2862":55785},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3376":2454,"_29549":2452,"_5":29898,"_20523":55787,"_26884":55788,"_2862":48153},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3376":2455,"_29549":2452,"_5":29898,"_20523":55790,"_26884":55791,"_2862":55792},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3376":2456,"_29549":2452,"_5":29898,"_20523":55794,"_26884":55795,"_2862":55796},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3376":2457,"_29549":2452,"_5":29898,"_20523":55798,"_26884":55799,"_2862":55800},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3376":2458,"_29549":2452,"_5":29898,"_20523":55802,"_26884":55803,"_2862":55804},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3376":2459,"_29549":2452,"_5":29898,"_20523":55806,"_26884":55807,"_2862":55808},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3376":2460,"_29549":2452,"_5":29898,"_20523":55810,"_26884":55811,"_2862":55812},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3376":2461,"_29549":2452,"_5":29898,"_20523":55814,"_26884":55815,"_2862":55816},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3376":2462,"_29549":2452,"_5":29898,"_20523":55818,"_26884":55819,"_2862":55820},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3376":2463,"_29549":2452,"_5":29898,"_20523":55822,"_26884":55823,"_2862":55824},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3376":2464,"_29549":2452,"_5":29898,"_20523":55826,"_26884":55827,"_2862":53314},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3376":2465,"_29549":2452,"_5":29898,"_20523":55829,"_26884":55830,"_2862":48177},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#next-step",{"_3376":2466,"_29549":2452,"_20523":55832,"_5":14087,"_26884":2452,"_2862":55833},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3376":2467,"_29549":2452,"_20523":55835,"_5":14087,"_26884":55788,"_2862":55836},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3376":2468,"_29549":2452,"_20523":55838,"_5":14087,"_26884":55788,"_2862":55839},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3376":2469,"_29549":2452,"_20523":55841,"_5":14087,"_26884":55788,"_2862":55842},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3376":2470,"_29549":2452,"_20523":55844,"_5":14087,"_26884":55788,"_2862":55845},[],"A client identifier: here we use `device-001`.",{"_3376":2471,"_29549":2452,"_20523":55847,"_5":14087,"_26884":55788,"_2862":55848},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3376":2472,"_29549":2452,"_20523":55850,"_5":14087,"_26884":55791,"_2862":55851},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3376":2473,"_29549":2452,"_20523":55853,"_5":14087,"_26884":55795,"_2862":55854},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3376":2474,"_29549":2452,"_20523":55856,"_5":14087,"_26884":55795,"_2862":55857},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3376":2475,"_29549":2452,"_20523":55859,"_5":14087,"_26884":55799,"_2862":55860},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3376":2476,"_29549":2452,"_20523":55862,"_5":14087,"_26884":55799,"_2862":55863},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3376":2477,"_29549":2452,"_20523":55865,"_5":14087,"_26884":55803,"_2862":55866},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3376":2478,"_29549":2452,"_20523":55868,"_5":14087,"_26884":55803,"_2862":55869},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3376":2479,"_29549":2452,"_20523":55871,"_5":14087,"_26884":55807,"_2862":55872},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3376":2480,"_29549":2452,"_20523":55874,"_5":14087,"_26884":55811,"_2862":55875},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3376":2481,"_29549":2452,"_20523":55877,"_5":14087,"_26884":55815,"_2862":55878},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3376":2482,"_29549":2452,"_20523":55880,"_5":14087,"_26884":55819,"_2862":55881},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3376":2483,"_29549":2452,"_20523":55883,"_5":14087,"_26884":55819,"_2862":55884},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3376":2484,"_29549":2452,"_20523":55886,"_5":14087,"_26884":55819,"_2862":55887},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3376":2485,"_29549":2452,"_20523":55889,"_5":14087,"_26884":55823,"_2862":55890},[],"In Bash, compare the two public-key digests:",{"_3376":2486,"_29549":2452,"_20523":55892,"_5":14087,"_26884":55823,"_2862":55893},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3376":2487,"_29549":2452,"_20523":55895,"_5":14087,"_26884":55823,"_2862":55896},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3376":2488,"_29549":2452,"_20523":55898,"_5":14087,"_26884":55827,"_2862":53398},[],{"_3376":2489,"_29549":2452,"_20523":55900,"_5":14087,"_26884":55827,"_2862":55901},[],"What to review",{"_3376":2490,"_29549":2452,"_20523":55903,"_5":14087,"_26884":55827,"_2862":55904},[],"The CA rejects issuance",{"_3376":2491,"_29549":2452,"_20523":55906,"_5":14087,"_26884":55827,"_2862":55907},[],"Permissions, CA state and key, algorithm and profile.",{"_3376":2492,"_29549":2452,"_20523":55909,"_5":14087,"_26884":55827,"_2862":55910},[],"Different subject or usages",{"_3376":2493,"_29549":2452,"_20523":55912,"_5":14087,"_26884":55827,"_2862":55913},[],"Applied profile and requested values.",{"_3376":2494,"_29549":2452,"_20523":55915,"_5":14087,"_26884":55827,"_2862":55916},[],"Issuer cannot be found",{"_3376":2495,"_29549":2452,"_20523":55918,"_5":14087,"_26884":55827,"_2862":55919},[],"Downloaded CA and required intermediate chain.",{"_3376":2496,"_29549":2452,"_20523":55921,"_5":14087,"_26884":55827,"_2862":55922},[],"Validity fails",{"_3376":2497,"_29549":2452,"_20523":55924,"_5":14087,"_26884":55827,"_2862":55925},[],"Certificate and CA dates, and the computer's clock.",{"_3376":2498,"_29549":2452,"_20523":55927,"_5":14087,"_26884":55827,"_2862":55928},[],"Public-key digests differ",{"_3376":2499,"_29549":2452,"_20523":55930,"_5":14087,"_26884":55827,"_2862":55931},[],"Certificate and key files from the same issuance.",{"_3376":2500,"_29549":2452,"_20523":55933,"_5":14087,"_26884":55827,"_2862":55934},[],"See PKI diagnostics to narrow an issuance failure.",{"_3376":2501,"_29549":2452,"_20523":55936,"_5":14087,"_26884":55830,"_2862":55937},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3376":2502,"_29549":2452,"_20523":55939,"_5":14087,"_26884":55830,"_2862":55940},[],"Manage certificates for inspection, status and revocation.",{"_3376":2503,"_29549":2452,"_20523":55942,"_5":14087,"_26884":55830,"_2862":55943},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3376":2504,"_29549":2452,"_20523":55945,"_5":14087,"_26884":55830,"_2862":55946},[],"Prepare EST for the device to request its next identities.",{"_3376":2505,"_29549":2452,"_20523":55948,"_5":14087,"_26884":55830,"_2862":55949},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3376":2506,"_29549":2506,"_5":14445,"_2862":55951,"_29901":55952,"_20523":55953,"_26884":2506},"PKI getting started",[48143,49611,53620,53057],[],{"_3376":2507,"_29549":2506,"_20523":55955,"_5":14087,"_26884":2506,"_2862":55956},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3376":2508,"_29549":2506,"_5":29898,"_20523":55958,"_26884":55959,"_2862":48153},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/overview#before-you-begin",{"_3376":2509,"_29549":2506,"_5":29898,"_20523":55961,"_26884":55962,"_2862":55963},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3376":2510,"_29549":2506,"_5":29898,"_20523":55965,"_26884":55966,"_2862":53249},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/overview#expected-result",{"_3376":2511,"_29549":2506,"_5":29898,"_20523":55968,"_26884":55969,"_2862":55970},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3376":2512,"_29549":2506,"_20523":55972,"_5":14087,"_26884":2506,"_2862":55973},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3376":2513,"_29549":2506,"_20523":55975,"_5":14087,"_26884":55959,"_2862":55976},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3376":2514,"_29549":2506,"_20523":55978,"_5":14087,"_26884":55959,"_2862":55979},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3376":2515,"_29549":2506,"_20523":55981,"_5":14087,"_26884":55959,"_2862":55982},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3376":2516,"_29549":2506,"_20523":55984,"_5":14087,"_26884":55959,"_2862":55985},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3376":2517,"_29549":2506,"_20523":55987,"_5":14087,"_26884":55959,"_2862":55988},[],"A working directory with restricted access for the downloaded key.",{"_3376":2518,"_29549":2506,"_20523":55990,"_5":14087,"_26884":55962,"_2862":55991},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3376":2519,"_29549":2506,"_20523":55993,"_5":14087,"_26884":55962,"_2862":55994},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3376":2520,"_29549":2506,"_20523":55996,"_5":14087,"_26884":55962,"_2862":55997},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3376":2521,"_29549":2506,"_20523":55999,"_5":14087,"_26884":55962,"_2862":56000},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3376":2522,"_29549":2506,"_20523":56002,"_5":14087,"_26884":55966,"_2862":56003},[],"File or resource",{"_3376":2523,"_29549":2506,"_20523":56005,"_5":14087,"_26884":55966,"_2862":53246},[],{"_3376":2524,"_29549":2506,"_20523":56007,"_5":14087,"_26884":55966,"_2862":56008},[],"Active root CA and `ca.pem`",{"_3376":2525,"_29549":2506,"_20523":56010,"_5":14087,"_26884":55966,"_2862":56011},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3376":2526,"_29549":2506,"_20523":56013,"_5":14087,"_26884":55966,"_2862":56014},[],"End-entity certificate and `device.crt`",{"_3376":2527,"_29549":2506,"_20523":56016,"_5":14087,"_26884":55966,"_2862":56017},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3376":2528,"_29549":2506,"_20523":56019,"_5":14087,"_26884":55966,"_2862":56020},[],"Private key `device.key`",{"_3376":2529,"_29549":2506,"_20523":56022,"_5":14087,"_26884":55966,"_2862":56023},[],"Its public key matches the one included in `device.crt`.",{"_3376":2530,"_29549":2506,"_20523":56025,"_5":14087,"_26884":55966,"_2862":56026},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3376":2531,"_29549":2506,"_20523":56028,"_5":14087,"_26884":55969,"_2862":56029},[],"To operate certificates, continue with Certificates and Validation.",{"_3376":2532,"_29549":2506,"_20523":56031,"_5":14087,"_26884":55969,"_2862":56032},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3376":2533,"_29549":2506,"_20523":56034,"_5":14087,"_26884":55969,"_2862":56035},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3376":2534,"_29549":2534,"_5":14445,"_2862":56037,"_29901":56038,"_20523":56039,"_26884":2534},"PKI troubleshooting",[48143,49611,53620,52192],[],{"_3376":2535,"_29549":2534,"_20523":56041,"_5":14087,"_26884":2534,"_2862":56042},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3376":2536,"_29549":2534,"_5":29898,"_20523":56044,"_26884":56045,"_2862":56046},[],"/docs/pr-preview/pr-52/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3376":2537,"_29549":2534,"_5":29898,"_20523":56048,"_26884":56049,"_2862":56050},[],"/docs/pr-preview/pr-52/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3376":2538,"_29549":2534,"_5":29898,"_20523":56052,"_26884":56053,"_2862":56054},[],"/docs/pr-preview/pr-52/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3376":2539,"_29549":2534,"_20523":56056,"_5":14087,"_26884":2534,"_2862":56057},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3376":2540,"_29549":2534,"_20523":56059,"_5":14087,"_26884":2534,"_2862":56060},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3376":2541,"_29549":2534,"_20523":56062,"_5":14087,"_26884":56045,"_2862":53246},[],{"_3376":2542,"_29549":2534,"_20523":56064,"_5":14087,"_26884":56045,"_2862":56065},[],"What to inspect",{"_3376":2543,"_29549":2534,"_20523":56067,"_5":14087,"_26884":56045,"_2862":48177},[],{"_3376":2544,"_29549":2534,"_20523":56069,"_5":14087,"_26884":56045,"_2862":52459},[],{"_3376":2545,"_29549":2534,"_20523":56071,"_5":14087,"_26884":56045,"_2862":56072},[],"Exists, is active and has usable dates.",{"_3376":2546,"_29549":2534,"_20523":56074,"_5":14087,"_26884":56045,"_2862":56075},[],"Authorities.",{"_3376":2547,"_29549":2534,"_20523":56077,"_5":14087,"_26884":56045,"_2862":56078},[],"Key",{"_3376":2548,"_29549":2534,"_20523":56080,"_5":14087,"_26884":56045,"_2862":56081},[],"The record has a usable private key and the engine can sign.",{"_3376":2549,"_29549":2534,"_20523":56083,"_5":14087,"_26884":56045,"_2862":56084},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3376":2550,"_29549":2534,"_20523":56086,"_5":14087,"_26884":56045,"_2862":56087},[],"CSR",{"_3376":2551,"_29549":2534,"_20523":56089,"_5":14087,"_26884":56045,"_2862":56090},[],"Correct PEM and verifiable signature.",{"_3376":2552,"_29549":2534,"_20523":56092,"_5":14087,"_26884":56045,"_2862":56093},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3376":2553,"_29549":2534,"_20523":56095,"_5":14087,"_26884":56045,"_2862":56096},[],"Profile",{"_3376":2554,"_29549":2534,"_20523":56098,"_5":14087,"_26884":56045,"_2862":56099},[],"Selected source, existing ID, allowed algorithm and size.",{"_3376":2555,"_29549":2534,"_20523":56101,"_5":14087,"_26884":56045,"_2862":56102},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3376":2556,"_29549":2534,"_20523":56104,"_5":14087,"_26884":56045,"_2862":53398},[],{"_3376":2557,"_29549":2534,"_20523":56106,"_5":14087,"_26884":56045,"_2862":56107},[],"Appropriate subject, SAN, usages and dates.",{"_3376":2558,"_29549":2534,"_20523":56109,"_5":14087,"_26884":56045,"_2862":56110},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3376":2559,"_29549":2534,"_20523":56112,"_5":14087,"_26884":56045,"_2862":56113},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3376":2560,"_29549":2534,"_20523":56115,"_5":14087,"_26884":56045,"_2862":56116},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3376":2561,"_29549":2534,"_20523":56118,"_5":14087,"_26884":56049,"_2862":56119},[],"Check each boundary independently:",{"_3376":2562,"_29549":2534,"_20523":56121,"_5":14087,"_26884":56049,"_2862":56122},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3376":2563,"_29549":2534,"_20523":56124,"_5":14087,"_26884":56049,"_2862":56125},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3376":2564,"_29549":2534,"_20523":56127,"_5":14087,"_26884":56049,"_2862":56128},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3376":2565,"_29549":2534,"_20523":56130,"_5":14087,"_26884":56049,"_2862":56131},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3376":2566,"_29549":2534,"_20523":56133,"_5":14087,"_26884":56049,"_2862":56134},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3376":2567,"_29549":2534,"_20523":56136,"_5":14087,"_26884":56049,"_2862":56137},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3376":2568,"_29549":2534,"_20523":56139,"_5":14087,"_26884":56053,"_2862":56140},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3376":2569,"_29549":2534,"_20523":56142,"_5":14087,"_26884":56053,"_2862":56143},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3376":2570,"_29549":2570,"_5":14445,"_2862":56145,"_29901":56146,"_20523":56147,"_26884":2570},"Security",[48143],[],{"_3376":2571,"_29549":2570,"_20523":56149,"_5":14087,"_26884":2570,"_2862":56150},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3376":2572,"_29549":2570,"_5":29898,"_20523":56152,"_26884":56153,"_2862":56154},[],"/docs/pr-preview/pr-52/security#report-a-vulnerability","Report a vulnerability",{"_3376":2573,"_29549":2570,"_5":29898,"_20523":56156,"_26884":56157,"_2862":56158},[],"/docs/pr-preview/pr-52/security#what-to-include-in-a-report","What to include in a report",{"_3376":2574,"_29549":2570,"_5":29898,"_20523":56160,"_26884":56161,"_2862":56162},[],"/docs/pr-preview/pr-52/security#supported-versions","Supported versions",{"_3376":2575,"_29549":2570,"_5":29898,"_20523":56164,"_26884":56165,"_2862":56166},[],"/docs/pr-preview/pr-52/security#responsible-disclosure","Responsible disclosure",{"_3376":2576,"_29549":2570,"_20523":56168,"_5":14087,"_26884":2570,"_2862":56169},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3376":2577,"_29549":2570,"_20523":56171,"_5":14087,"_26884":56153,"_2862":56172},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3376":2578,"_29549":2570,"_20523":56174,"_5":14087,"_26884":56153,"_2862":56175},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3376":2579,"_29549":2570,"_20523":56177,"_5":14087,"_26884":56153,"_2862":14707},[],{"_3376":2580,"_29549":2570,"_20523":56179,"_5":14087,"_26884":56153,"_2862":14653},[],{"_3376":2581,"_29549":2570,"_20523":56181,"_5":14087,"_26884":56153,"_2862":14700},[],{"_3376":2582,"_29549":2570,"_20523":56183,"_5":14087,"_26884":56153,"_2862":56184},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3376":2583,"_29549":2570,"_20523":56186,"_5":14087,"_26884":56153,"_2862":56187},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3376":2584,"_29549":2570,"_20523":56189,"_5":14087,"_26884":56157,"_2862":56190},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3376":2585,"_29549":2570,"_20523":56192,"_5":14087,"_26884":56157,"_2862":56193},[],"Do not include in the report:",{"_3376":2586,"_29549":2570,"_20523":56195,"_5":14087,"_26884":56157,"_2862":56196},[],"Credentials, tokens, or private keys",{"_3376":2587,"_29549":2570,"_20523":56198,"_5":14087,"_26884":56157,"_2862":56199},[],"Customer data or customer-identifiable information",{"_3376":2588,"_29549":2570,"_20523":56201,"_5":14087,"_26884":56157,"_2862":56202},[],"Confidential architecture or internal infrastructure details",{"_3376":2589,"_29549":2570,"_20523":56204,"_5":14087,"_26884":56161,"_2862":56205},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3376":2590,"_29549":2570,"_20523":56207,"_5":14087,"_26884":56161,"_2862":56208},[],"For upgrade guidance, see Upgrades.",{"_3376":2591,"_29549":2570,"_20523":56210,"_5":14087,"_26884":56165,"_2862":56211},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3376":2592,"_29549":2570,"_20523":56213,"_5":14087,"_26884":56165,"_2862":56214},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3376":2593,"_29549":2570,"_20523":56216,"_5":14087,"_26884":56165,"_2862":56217},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3376":2594,"_29549":2570,"_20523":56219,"_5":14087,"_26884":56165,"_2862":56220},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3376":2595,"_29549":2570,"_20523":56222,"_5":14087,"_26884":56165,"_2862":56223},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3376":2596,"_29549":2596,"_5":14445,"_2862":56225,"_29901":56226,"_20523":56228,"_26884":2596},"3.8.0 to 4.0.0",[48143,56227],"Upgrades",[],{"_3376":2597,"_29549":2596,"_20523":56230,"_5":14087,"_26884":2596,"_2862":56231},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3376":2598,"_29549":2596,"_5":29898,"_20523":56233,"_26884":56234,"_2862":56235},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3376":2599,"_29549":2596,"_5":29898,"_20523":56237,"_26884":56238,"_2862":56239},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3376":2600,"_29549":2596,"_5":29898,"_20523":56241,"_26884":56242,"_2862":56243},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3376":2601,"_29549":2596,"_5":29898,"_20523":56245,"_26884":56246,"_2862":56247},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3376":2602,"_29549":2596,"_5":29898,"_20523":56249,"_26884":56250,"_2862":56251},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3376":2603,"_29549":2596,"_5":29898,"_20523":56253,"_26884":56254,"_2862":56255},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3376":2604,"_29549":2596,"_5":29898,"_20523":56257,"_26884":56258,"_2862":56259},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3376":2605,"_29549":2596,"_5":29898,"_20523":56261,"_26884":56262,"_2862":56263},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3376":2606,"_29549":2596,"_5":29898,"_20523":56265,"_26884":56266,"_2862":56267},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3376":2607,"_29549":2596,"_5":29898,"_20523":56269,"_26884":56270,"_2862":56271},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3376":2608,"_29549":2596,"_5":29898,"_20523":56273,"_26884":56274,"_2862":56275},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3376":2609,"_29549":2596,"_5":29898,"_20523":56277,"_26884":56278,"_2862":56279},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3376":2610,"_29549":2596,"_5":29898,"_20523":56281,"_26884":56282,"_2862":56283},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3376":2611,"_29549":2596,"_5":29898,"_20523":56285,"_26884":56286,"_2862":56287},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3376":2612,"_29549":2596,"_5":29898,"_20523":56289,"_26884":56290,"_2862":56291},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3376":2613,"_29549":2596,"_5":29898,"_20523":56293,"_26884":56294,"_2862":56295},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3376":2614,"_29549":2596,"_5":29898,"_20523":56297,"_26884":56298,"_2862":56299},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3376":2615,"_29549":2596,"_5":29898,"_20523":56301,"_26884":56302,"_2862":56303},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3376":2616,"_29549":2596,"_5":29898,"_20523":56305,"_26884":56306,"_2862":56307},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3376":2617,"_29549":2596,"_5":29898,"_20523":56309,"_26884":56310,"_2862":56311},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-va-roles","References between certificates, keys and VA roles",{"_3376":2618,"_29549":2596,"_5":29898,"_20523":56313,"_26884":56314,"_2862":56315},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3376":2619,"_29549":2596,"_5":29898,"_20523":56317,"_26884":56318,"_2862":56319},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3376":2620,"_29549":2596,"_5":29898,"_20523":56321,"_26884":56322,"_2862":56323},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3376":2621,"_29549":2596,"_5":29898,"_20523":56325,"_26884":56326,"_2862":56327},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3376":2622,"_29549":2596,"_5":29898,"_20523":56329,"_26884":56330,"_2862":56331},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3376":2623,"_29549":2596,"_5":29898,"_20523":56333,"_26884":56334,"_2862":56335},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3376":2624,"_29549":2596,"_5":29898,"_20523":56337,"_26884":56338,"_2862":56339},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3376":2625,"_29549":2596,"_5":29898,"_20523":56341,"_26884":56342,"_2862":56343},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#va-role-signer-field","VA role signer field",{"_3376":2626,"_29549":2596,"_5":29898,"_20523":56345,"_26884":56346,"_2862":56347},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3376":2627,"_29549":2596,"_5":29898,"_20523":56349,"_26884":56350,"_2862":56351},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3376":2628,"_29549":2596,"_5":29898,"_20523":56353,"_26884":56354,"_2862":56355},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3376":2629,"_29549":2596,"_5":29898,"_20523":56357,"_26884":56358,"_2862":56359},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3376":2630,"_29549":2596,"_5":29898,"_20523":56361,"_26884":56362,"_2862":56363},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3376":2631,"_29549":2596,"_5":29898,"_20523":56365,"_26884":56366,"_2862":56367},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3376":2632,"_29549":2596,"_5":29898,"_20523":56369,"_26884":56370,"_2862":56371},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3376":2633,"_29549":2596,"_5":29898,"_20523":56373,"_26884":56374,"_2862":52192},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3376":2634,"_29549":2596,"_5":29898,"_20523":56376,"_26884":56377,"_2862":56378},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3376":2635,"_29549":2596,"_5":29898,"_20523":56380,"_26884":56381,"_2862":56382},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3376":2636,"_29549":2596,"_20523":56384,"_5":14087,"_26884":2596,"_2862":56385},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3376":2637,"_29549":2596,"_20523":56387,"_5":14087,"_26884":2596,"_2862":56388},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3376":2638,"_29549":2596,"_20523":56390,"_5":14087,"_26884":2596,"_2862":56391},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3376":2639,"_29549":2596,"_20523":56393,"_5":14087,"_26884":2596,"_2862":56394},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3376":2640,"_29549":2596,"_20523":56396,"_5":14087,"_26884":2596,"_2862":56397},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3376":2641,"_29549":2596,"_20523":56399,"_5":14087,"_26884":2596,"_2862":56400},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3376":2642,"_29549":2596,"_20523":56402,"_5":14087,"_26884":2596,"_2862":56403},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3376":2643,"_29549":2596,"_20523":56405,"_5":14087,"_26884":56238,"_2862":56406},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3376":2644,"_29549":2596,"_20523":56408,"_5":14087,"_26884":56238,"_2862":56409},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3376":2645,"_29549":2596,"_20523":56411,"_5":14087,"_26884":56242,"_2862":56412},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3376":2646,"_29549":2596,"_20523":56414,"_5":14087,"_26884":56242,"_2862":56415},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3376":2647,"_29549":2596,"_20523":56417,"_5":14087,"_26884":56246,"_2862":56418},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3376":2648,"_29549":2596,"_20523":56420,"_5":14087,"_26884":56250,"_2862":56421},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3376":2649,"_29549":2596,"_20523":56423,"_5":14087,"_26884":56250,"_2862":56424},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3376":2650,"_29549":2596,"_20523":56426,"_5":14087,"_26884":56250,"_2862":56427},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3376":2651,"_29549":2596,"_20523":56429,"_5":14087,"_26884":56250,"_2862":56430},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3376":2652,"_29549":2596,"_20523":56432,"_5":14087,"_26884":56250,"_2862":56433},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3376":2653,"_29549":2596,"_20523":56435,"_5":14087,"_26884":56254,"_2862":56436},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3376":2654,"_29549":2596,"_20523":56438,"_5":14087,"_26884":56254,"_2862":56439},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3376":2655,"_29549":2596,"_20523":56441,"_5":14087,"_26884":56254,"_2862":56442},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3376":2656,"_29549":2596,"_20523":56444,"_5":14087,"_26884":56254,"_2862":56445},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3376":2657,"_29549":2596,"_20523":56447,"_5":14087,"_26884":56254,"_2862":56448},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3376":2658,"_29549":2596,"_20523":56450,"_5":14087,"_26884":56258,"_2862":56451},[],"Change",{"_3376":2659,"_29549":2596,"_20523":56453,"_5":14087,"_26884":56258,"_2862":56454},[],"Who is affected",{"_3376":2660,"_29549":2596,"_20523":56456,"_5":14087,"_26884":56258,"_2862":56457},[],"Severity",{"_3376":2661,"_29549":2596,"_20523":56459,"_5":14087,"_26884":56258,"_2862":54965},[],{"_3376":2662,"_29549":2596,"_20523":56461,"_5":14087,"_26884":56258,"_2862":56267},[],{"_3376":2663,"_29549":2596,"_20523":56463,"_5":14087,"_26884":56258,"_2862":56464},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3376":2664,"_29549":2596,"_20523":56466,"_5":14087,"_26884":56258,"_2862":56467},[],"High: KMS and VA start on empty volumes",{"_3376":2665,"_29549":2596,"_20523":56469,"_5":14087,"_26884":56258,"_2862":56470},[],"Copy the data into the new volumes",{"_3376":2666,"_29549":2596,"_20523":56472,"_5":14087,"_26884":56258,"_2862":56271},[],{"_3376":2667,"_29549":2596,"_20523":56474,"_5":14087,"_26884":56258,"_2862":56475},[],"Every Helm release",{"_3376":2668,"_29549":2596,"_20523":56477,"_5":14087,"_26884":56258,"_2862":56478},[],"High: `helm upgrade` fails",{"_3376":2669,"_29549":2596,"_20523":56480,"_5":14087,"_26884":56258,"_2862":56481},[],"Remove or rename legacy keys",{"_3376":2670,"_29549":2596,"_20523":56483,"_5":14087,"_26884":56258,"_2862":56275},[],{"_3376":2671,"_29549":2596,"_20523":56485,"_5":14087,"_26884":56258,"_2862":56486},[],"Every deployment",{"_3376":2672,"_29549":2596,"_20523":56488,"_5":14087,"_26884":56258,"_2862":56489},[],"High: without a bootstrap principal there is no administrator",{"_3376":2673,"_29549":2596,"_20523":56491,"_5":14087,"_26884":56258,"_2862":56492},[],"Configure `services.authz`",{"_3376":2674,"_29549":2596,"_20523":56494,"_5":14087,"_26884":56258,"_2862":56279},[],{"_3376":2675,"_29549":2596,"_20523":56496,"_5":14087,"_26884":56258,"_2862":56475},[],{"_3376":2676,"_29549":2596,"_20523":56498,"_5":14087,"_26884":56258,"_2862":56499},[],"High: `helm upgrade` fails on the old keys",{"_3376":2677,"_29549":2596,"_20523":56501,"_5":14087,"_26884":56258,"_2862":56502},[],"Move JWKS and roles into `services.authz`",{"_3376":2678,"_29549":2596,"_20523":56504,"_5":14087,"_26884":56258,"_2862":56299},[],{"_3376":2679,"_29549":2596,"_20523":56506,"_5":14087,"_26884":56258,"_2862":56507},[],"3.8.0 deployments with per-service databases",{"_3376":2680,"_29549":2596,"_20523":56509,"_5":14087,"_26884":56258,"_2862":56510},[],"High: services find no data, or a migration aborts",{"_3376":2681,"_29549":2596,"_20523":56512,"_5":14087,"_26884":56258,"_2862":56513},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3376":2682,"_29549":2596,"_20523":56515,"_5":14087,"_26884":56258,"_2862":56303},[],{"_3376":2683,"_29549":2596,"_20523":56517,"_5":14087,"_26884":56258,"_2862":56518},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3376":2684,"_29549":2596,"_20523":56520,"_5":14087,"_26884":56258,"_2862":56521},[],"High: the backend no longer starts with them",{"_3376":2685,"_29549":2596,"_20523":56523,"_5":14087,"_26884":56258,"_2862":56524},[],"Move to PostgreSQL before upgrading",{"_3376":2686,"_29549":2596,"_20523":56526,"_5":14087,"_26884":56258,"_2862":56527},[],"Webhooks with file references",{"_3376":2687,"_29549":2596,"_20523":56529,"_5":14087,"_26884":56258,"_2862":56530},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3376":2688,"_29549":2596,"_20523":56532,"_5":14087,"_26884":56258,"_2862":56533},[],"High: enrollments calling the webhook fail",{"_3376":2689,"_29549":2596,"_20523":56535,"_5":14087,"_26884":56258,"_2862":56536},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3376":2690,"_29549":2596,"_20523":56538,"_5":14087,"_26884":56258,"_2862":56283},[],{"_3376":2691,"_29549":2596,"_20523":56540,"_5":14087,"_26884":56258,"_2862":56541},[],"Releases with per-service identity overrides or mounted key material",{"_3376":2692,"_29549":2596,"_20523":56543,"_5":14087,"_26884":56258,"_2862":56544},[],"Medium: services cannot read their files",{"_3376":2693,"_29549":2596,"_20523":56546,"_5":14087,"_26884":56258,"_2862":56547},[],"Remove the overrides and fix volume ownership",{"_3376":2694,"_29549":2596,"_20523":56549,"_5":14087,"_26884":56258,"_2862":56287},[],{"_3376":2695,"_29549":2596,"_20523":56551,"_5":14087,"_26884":56258,"_2862":56552},[],"Releases that set `amqp.tls`",{"_3376":2696,"_29549":2596,"_20523":56554,"_5":14087,"_26884":56258,"_2862":56555},[],"Medium: clients connect to the wrong port",{"_3376":2697,"_29549":2596,"_20523":56557,"_5":14087,"_26884":56258,"_2862":56558},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3376":2698,"_29549":2596,"_20523":56560,"_5":14087,"_26884":56258,"_2862":56307},[],{"_3376":2699,"_29549":2596,"_20523":56562,"_5":14087,"_26884":56258,"_2862":56563},[],"Installations whose CA keys predate the KMS",{"_3376":2700,"_29549":2596,"_20523":56565,"_5":14087,"_26884":56258,"_2862":56566},[],"Medium: CA keys stay unmanaged",{"_3376":2701,"_29549":2596,"_20523":56568,"_5":14087,"_26884":56258,"_2862":56569},[],"Run the CA-to-KMS migration",{"_3376":2702,"_29549":2596,"_20523":56571,"_5":14087,"_26884":56258,"_2862":56572},[],"Receiver certificate verification",{"_3376":2703,"_29549":2596,"_20523":56574,"_5":14087,"_26884":56258,"_2862":56575},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3376":2704,"_29549":2596,"_20523":56577,"_5":14087,"_26884":56258,"_2862":56578},[],"Medium: credentials go to an unverified receiver",{"_3376":2705,"_29549":2596,"_20523":56580,"_5":14087,"_26884":56258,"_2862":56581},[],"Set `insecure_skip_verify` to `false`",{"_3376":2706,"_29549":2596,"_20523":56583,"_5":14087,"_26884":56258,"_2862":56323},[],{"_3376":2707,"_29549":2596,"_20523":56585,"_5":14087,"_26884":56258,"_2862":56586},[],"Scripts and consoles that edit DMSs through the API",{"_3376":2708,"_29549":2596,"_20523":56588,"_5":14087,"_26884":56258,"_2862":56589},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3376":2709,"_29549":2596,"_20523":56591,"_5":14087,"_26884":56258,"_2862":56592},[],"Read the DMS before editing and use the new field",{"_3376":2710,"_29549":2596,"_20523":56594,"_5":14087,"_26884":56258,"_2862":56343},[],{"_3376":2711,"_29549":2596,"_20523":56596,"_5":14087,"_26884":56258,"_2862":56597},[],"Clients that create or update VA roles through the API",{"_3376":2712,"_29549":2596,"_20523":56599,"_5":14087,"_26884":56258,"_2862":56600},[],"Medium: requests with the old field return an error",{"_3376":2713,"_29549":2596,"_20523":56602,"_5":14087,"_26884":56258,"_2862":56603},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_certificate_serial_number`",{"_3376":2714,"_29549":2596,"_20523":56605,"_5":14087,"_26884":56258,"_2862":56339},[],{"_3376":2715,"_29549":2596,"_20523":56607,"_5":14087,"_26884":56258,"_2862":56608},[],"Consumers that read the device `events` field",{"_3376":2716,"_29549":2596,"_20523":56610,"_5":14087,"_26884":56258,"_2862":56611},[],"Medium: the field disappears",{"_3376":2717,"_29549":2596,"_20523":56613,"_5":14087,"_26884":56258,"_2862":56614},[],"Use the new event endpoints",{"_3376":2718,"_29549":2596,"_20523":56616,"_5":14087,"_26884":56258,"_2862":56291},[],{"_3376":2719,"_29549":2596,"_20523":56618,"_5":14087,"_26884":56258,"_2862":56619},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3376":2720,"_29549":2596,"_20523":56621,"_5":14087,"_26884":56258,"_2862":56622},[],"Low to medium: validation errors or changed defaults",{"_3376":2721,"_29549":2596,"_20523":56624,"_5":14087,"_26884":56258,"_2862":56625},[],"Update the values file",{"_3376":2722,"_29549":2596,"_20523":56627,"_5":14087,"_26884":56258,"_2862":56331},[],{"_3376":2723,"_29549":2596,"_20523":56629,"_5":14087,"_26884":56258,"_2862":56630},[],"Clients that send the DMS ID in the update body",{"_3376":2724,"_29549":2596,"_20523":56632,"_5":14087,"_26884":56258,"_2862":56633},[],"Low: the ID in the URL wins",{"_3376":2725,"_29549":2596,"_20523":56635,"_5":14087,"_26884":56258,"_2862":56636},[],"Send the ID in the URL",{"_3376":2726,"_29549":2596,"_20523":56638,"_5":14087,"_26884":56258,"_2862":56335},[],{"_3376":2727,"_29549":2596,"_20523":56640,"_5":14087,"_26884":56258,"_2862":56641},[],"Consumers that match on certificate `type`",{"_3376":2728,"_29549":2596,"_20523":56643,"_5":14087,"_26884":56258,"_2862":56644},[],"Low: two values are renamed",{"_3376":2729,"_29549":2596,"_20523":56646,"_5":14087,"_26884":56258,"_2862":56647},[],"Adapt consumers",{"_3376":2730,"_29549":2596,"_20523":56649,"_5":14087,"_26884":56258,"_2862":56327},[],{"_3376":2731,"_29549":2596,"_20523":56651,"_5":14087,"_26884":56258,"_2862":56652},[],"Any DMS",{"_3376":2732,"_29549":2596,"_20523":56654,"_5":14087,"_26884":56258,"_2862":56655},[],"Low: informational",{"_3376":2733,"_29549":2596,"_20523":56657,"_5":14087,"_26884":56258,"_2862":56658},[],"Read both blocks before editing",{"_3376":2734,"_29549":2596,"_20523":56660,"_5":14087,"_26884":56266,"_2862":56661},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3376":2735,"_29549":2596,"_20523":56663,"_5":14087,"_26884":56266,"_2862":56664},[],"Step 4 of the migration guide copies the data.",{"_3376":2736,"_29549":2596,"_20523":56666,"_5":14087,"_26884":56270,"_2862":56667},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3376":2737,"_29549":2596,"_20523":56669,"_5":14087,"_26884":56274,"_2862":56670},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3376":2738,"_29549":2596,"_20523":56672,"_5":14087,"_26884":56278,"_2862":56673},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3376":2739,"_29549":2596,"_20523":56675,"_5":14087,"_26884":56282,"_2862":56676},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3376":2740,"_29549":2596,"_20523":56678,"_5":14087,"_26884":56282,"_2862":56679},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3376":2741,"_29549":2596,"_20523":56681,"_5":14087,"_26884":56286,"_2862":56682},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3376":2742,"_29549":2596,"_20523":56684,"_5":14087,"_26884":56290,"_2862":56685},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3376":2743,"_29549":2596,"_20523":56687,"_5":14087,"_26884":56290,"_2862":56688},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3376":2744,"_29549":2596,"_20523":56690,"_5":14087,"_26884":56290,"_2862":56691},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3376":2745,"_29549":2596,"_20523":56693,"_5":14087,"_26884":56290,"_2862":56694},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3376":2746,"_29549":2596,"_20523":56696,"_5":14087,"_26884":56290,"_2862":56697},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3376":2747,"_29549":2596,"_20523":56699,"_5":14087,"_26884":56290,"_2862":56700},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3376":2748,"_29549":2596,"_20523":56702,"_5":14087,"_26884":56298,"_2862":56703},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3376":2749,"_29549":2596,"_20523":56705,"_5":14087,"_26884":56298,"_2862":56706},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3376":2750,"_29549":2596,"_20523":56708,"_5":14087,"_26884":56298,"_2862":56709},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3376":2751,"_29549":2596,"_20523":56711,"_5":14087,"_26884":56298,"_2862":56712},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3376":2752,"_29549":2596,"_20523":56714,"_5":14087,"_26884":56298,"_2862":56715},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3376":2753,"_29549":2596,"_20523":56717,"_5":14087,"_26884":56302,"_2862":56718},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3376":2754,"_29549":2596,"_20523":56720,"_5":14087,"_26884":56306,"_2862":56721},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3376":2755,"_29549":2596,"_20523":56723,"_5":14087,"_26884":56306,"_2862":56724},[],"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_3376":2756,"_29549":2596,"_20523":56726,"_5":14087,"_26884":56306,"_2862":56727},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3376":2757,"_29549":2596,"_20523":56729,"_5":14087,"_26884":56306,"_2862":56730},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3376":2758,"_29549":2596,"_20523":56732,"_5":14087,"_26884":56306,"_2862":56733},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3376":2759,"_29549":2596,"_20523":56735,"_5":14087,"_26884":56306,"_2862":56736},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3376":2760,"_29549":2596,"_20523":56738,"_5":14087,"_26884":56306,"_2862":56739},[],"Once legacy keys are registered, starting the KMS with the backend configuration option `crypto_engines.migrate_keys_format` renames keys whose name is not the public-key SHA-256 digest, keeps the old name as an alias and moves certificate references along. It is safe to re-run and can be disabled afterwards.",{"_3376":2761,"_29549":2596,"_20523":56741,"_5":14087,"_26884":56310,"_2862":56742},[],"Certificates now reference their KMS key, and VA roles reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3376":2762,"_29549":2596,"_20523":56744,"_5":14087,"_26884":56318,"_2862":56745},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3376":2763,"_29549":2596,"_20523":56747,"_5":14087,"_26884":56318,"_2862":56748},[],"Field in 3.8.0",{"_3376":2764,"_29549":2596,"_20523":56750,"_5":14087,"_26884":56318,"_2862":56751},[],"Field in 4.0.0",{"_3376":2765,"_29549":2596,"_20523":56753,"_5":14087,"_26884":56318,"_2862":56754},[],"`validate_server_cert`",{"_3376":2766,"_29549":2596,"_20523":56756,"_5":14087,"_26884":56318,"_2862":56757},[],"`insecure_skip_verify` (value negated)",{"_3376":2767,"_29549":2596,"_20523":56759,"_5":14087,"_26884":56318,"_2862":56760},[],"`oidc`",{"_3376":2768,"_29549":2596,"_20523":56762,"_5":14087,"_26884":56318,"_2862":56763},[],"`jwt_options`",{"_3376":2769,"_29549":2596,"_20523":56765,"_5":14087,"_26884":56318,"_2862":56766},[],"`apikey`",{"_3376":2770,"_29549":2596,"_20523":56768,"_5":14087,"_26884":56318,"_2862":56769},[],"`apikey_options`",{"_3376":2771,"_29549":2596,"_20523":56771,"_5":14087,"_26884":56318,"_2862":56772},[],"`mtls`",{"_3376":2772,"_29549":2596,"_20523":56774,"_5":14087,"_26884":56318,"_2862":56775},[],"`mtls_options`",{"_3376":2773,"_29549":2596,"_20523":56777,"_5":14087,"_26884":56318,"_2862":56778},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3376":2774,"_29549":2596,"_20523":56780,"_5":14087,"_26884":56318,"_2862":56781},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3376":2775,"_29549":2596,"_20523":56783,"_5":14087,"_26884":56318,"_2862":56784},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3376":2776,"_29549":2596,"_20523":56786,"_5":14087,"_26884":56322,"_2862":56787},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3376":2777,"_29549":2596,"_20523":56789,"_5":14087,"_26884":56322,"_2862":56790},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3376":2778,"_29549":2596,"_20523":56792,"_5":14087,"_26884":56322,"_2862":56793},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3376":2779,"_29549":2596,"_20523":56795,"_5":14087,"_26884":56326,"_2862":56796},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3376":2780,"_29549":2596,"_20523":56798,"_5":14087,"_26884":56330,"_2862":56799},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3376":2781,"_29549":2596,"_20523":56801,"_5":14087,"_26884":56334,"_2862":56802},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3376":2782,"_29549":2596,"_20523":56804,"_5":14087,"_26884":56338,"_2862":56805},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3376":2783,"_29549":2596,"_20523":56807,"_5":14087,"_26884":56338,"_2862":56808},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3376":2784,"_29549":2596,"_20523":56810,"_5":14087,"_26884":56338,"_2862":56811},[],"`POST /v1/devices/:id/events` creates an event.",{"_3376":2785,"_29549":2596,"_20523":56813,"_5":14087,"_26884":56338,"_2862":56814},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3376":2786,"_29549":2596,"_20523":56816,"_5":14087,"_26884":56342,"_2862":56817},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_certificate_serial_number`, the serial number of the existing certificate that signs the CRL. A new role's initial value is the CA's current certificate serial number. Requests that still carry `subject_key_id_signer` return an error. Custom authorization policies that filter on the old field must be updated: the filter `crl_subject_key_id_signer` is renamed to `crl_signer_certificate_serial_number` and takes serial-number values.",{"_3376":2787,"_29549":2596,"_20523":56819,"_5":14087,"_26884":56346,"_2862":56820},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3376":2788,"_29549":2596,"_20523":56822,"_5":14087,"_26884":56350,"_2862":56823},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_3376":2789,"_29549":2596,"_20523":56825,"_5":14087,"_26884":56350,"_2862":56826},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3376":2790,"_29549":2596,"_20523":56828,"_5":14087,"_26884":56350,"_2862":56829},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3376":2791,"_29549":2596,"_20523":56831,"_5":14087,"_26884":56350,"_2862":56832},[],"Record the names of your local-storage PVCs:",{"_3376":2792,"_29549":2596,"_20523":56834,"_5":14087,"_26884":56350,"_2862":56835},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3376":2793,"_29549":2596,"_20523":56837,"_5":14087,"_26884":56354,"_2862":56838},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3376":2794,"_29549":2596,"_20523":56840,"_5":14087,"_26884":56354,"_2862":56841},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3376":2795,"_29549":2596,"_20523":56843,"_5":14087,"_26884":56354,"_2862":56844},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3376":2796,"_29549":2596,"_20523":56846,"_5":14087,"_26884":56354,"_2862":56847},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3376":2797,"_29549":2596,"_20523":56849,"_5":14087,"_26884":56354,"_2862":56850},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3376":2798,"_29549":2596,"_20523":56852,"_5":14087,"_26884":56354,"_2862":56853},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3376":2799,"_29549":2596,"_20523":56855,"_5":14087,"_26884":56354,"_2862":56856},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3376":2800,"_29549":2596,"_20523":56858,"_5":14087,"_26884":56354,"_2862":56859},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3376":2801,"_29549":2596,"_20523":56861,"_5":14087,"_26884":56354,"_2862":56862},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3376":2802,"_29549":2596,"_20523":56864,"_5":14087,"_26884":56354,"_2862":56865},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3376":2803,"_29549":2596,"_20523":56867,"_5":14087,"_26884":56354,"_2862":56868},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3376":2804,"_29549":2596,"_20523":56870,"_5":14087,"_26884":56354,"_2862":56871},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3376":2805,"_29549":2596,"_20523":56873,"_5":14087,"_26884":56358,"_2862":56874},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3376":2806,"_29549":2596,"_20523":56876,"_5":14087,"_26884":56358,"_2862":56877},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3376":2807,"_29549":2596,"_20523":56879,"_5":14087,"_26884":56362,"_2862":56880},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3376":2808,"_29549":2596,"_20523":56882,"_5":14087,"_26884":56362,"_2862":56883},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3376":2809,"_29549":2596,"_20523":56885,"_5":14087,"_26884":56362,"_2862":56886},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3376":2810,"_29549":2596,"_20523":56888,"_5":14087,"_26884":56362,"_2862":56889},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3376":2811,"_29549":2596,"_20523":56891,"_5":14087,"_26884":56362,"_2862":56892},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3376":2812,"_29549":2596,"_20523":56894,"_5":14087,"_26884":56362,"_2862":56895},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3376":2813,"_29549":2596,"_20523":56897,"_5":14087,"_26884":56362,"_2862":56898},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3376":2814,"_29549":2596,"_20523":56900,"_5":14087,"_26884":56362,"_2862":56901},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3376":2815,"_29549":2596,"_20523":56903,"_5":14087,"_26884":56362,"_2862":56904},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3376":2816,"_29549":2596,"_20523":56906,"_5":14087,"_26884":56362,"_2862":56907},[],"**Remove the helper and restore the recorded replica counts:**",{"_3376":2817,"_29549":2596,"_20523":56909,"_5":14087,"_26884":56362,"_2862":56910},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3376":2818,"_29549":2596,"_20523":56912,"_5":14087,"_26884":56366,"_2862":56913},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3376":2819,"_29549":2596,"_20523":56915,"_5":14087,"_26884":56366,"_2862":56916},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3376":2820,"_29549":2596,"_20523":56918,"_5":14087,"_26884":56370,"_2862":56919},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3376":2821,"_29549":2596,"_20523":56921,"_5":14087,"_26884":56370,"_2862":56922},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3376":2822,"_29549":2596,"_20523":56924,"_5":14087,"_26884":56370,"_2862":56925},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates` and `SELECT` on `ca.ca_certificates`. If your services connect with a different user than the one that ran the migrations, grant that user `SELECT` on `ca.certificates_view` after the migrations.",{"_3376":2823,"_29549":2596,"_20523":56927,"_5":14087,"_26884":56370,"_2862":56928},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3376":2824,"_29549":2596,"_20523":56930,"_5":14087,"_26884":56370,"_2862":56931},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3376":2825,"_29549":2596,"_20523":56933,"_5":14087,"_26884":56370,"_2862":56934},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3376":2826,"_29549":2596,"_20523":56936,"_5":14087,"_26884":56370,"_2862":56937},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3376":2827,"_29549":2596,"_20523":56939,"_5":14087,"_26884":56374,"_2862":56940},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3376":2828,"_29549":2596,"_20523":56942,"_5":14087,"_26884":56374,"_2862":56943},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3376":2829,"_29549":2596,"_20523":56945,"_5":14087,"_26884":56374,"_2862":56946},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3376":2830,"_29549":2596,"_20523":56948,"_5":14087,"_26884":56374,"_2862":56949},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3376":2831,"_29549":2596,"_20523":56951,"_5":14087,"_26884":56374,"_2862":56952},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_3376":2832,"_29549":2596,"_20523":56954,"_5":14087,"_26884":56374,"_2862":56955},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3376":2833,"_29549":2596,"_20523":56957,"_5":14087,"_26884":56374,"_2862":56958},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3376":2834,"_29549":2596,"_20523":56960,"_5":14087,"_26884":56374,"_2862":56961},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` schema migration.",{"_3376":2835,"_29549":2596,"_20523":56963,"_5":14087,"_26884":56374,"_2862":56964},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3376":2836,"_29549":2596,"_20523":56966,"_5":14087,"_26884":56374,"_2862":56967},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_certificate_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3376":2837,"_29549":2596,"_20523":56969,"_5":14087,"_26884":56374,"_2862":56970},[],"**A migration or service fails with `permission denied for table ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped. Grant the missing privileges and re-run.",{"_3376":2838,"_29549":2596,"_20523":56972,"_5":14087,"_26884":56377,"_2862":56973},[],"After the upgrade, check in this order:",{"_3376":2839,"_29549":2596,"_20523":56975,"_5":14087,"_26884":56377,"_2862":56976},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3376":2840,"_29549":2596,"_20523":56978,"_5":14087,"_26884":56377,"_2862":56979},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3376":2841,"_29549":2596,"_20523":56981,"_5":14087,"_26884":56377,"_2862":56982},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3376":2842,"_29549":2596,"_20523":56984,"_5":14087,"_26884":56377,"_2862":56985},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_3376":2843,"_29549":2596,"_20523":56987,"_5":14087,"_26884":56377,"_2862":56988},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS.",{"_3376":2844,"_29549":2596,"_20523":56990,"_5":14087,"_26884":56377,"_2862":56991},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3376":2845,"_29549":2596,"_20523":56993,"_5":14087,"_26884":56377,"_2862":56994},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3376":2846,"_29549":2596,"_20523":56996,"_5":14087,"_26884":56377,"_2862":56997},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3376":2847,"_29549":2596,"_20523":56999,"_5":14087,"_26884":56377,"_2862":57000},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3376":2848,"_29549":2596,"_20523":57002,"_5":14087,"_26884":56377,"_2862":57003},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3376":2849,"_29549":2596,"_20523":57005,"_5":14087,"_26884":56377,"_2862":57006},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3376":2850,"_29549":2596,"_20523":57008,"_5":14087,"_26884":56377,"_2862":57009},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3376":2851,"_29549":2596,"_20523":57011,"_5":14087,"_26884":56377,"_2862":57012},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3376":2852,"_29549":2596,"_20523":57014,"_5":14087,"_26884":56377,"_2862":57015},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3376":2853,"_29549":2596,"_20523":57017,"_5":14087,"_26884":56381,"_2862":57018},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3376":2854,"_29549":2596,"_20523":57020,"_5":14087,"_26884":56381,"_2862":57021},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3376":2855,"_29549":2596,"_20523":57023,"_5":14087,"_26884":56381,"_2862":57024},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3376":2856,"_29549":2596,"_20523":57026,"_5":14087,"_26884":56381,"_2862":57027},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3376":2857,"_29549":2596,"_20523":57029,"_5":14087,"_26884":56381,"_2862":57030},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_57033":57034,"_57035":57036,"_57037":57038,"_57039":57040,"_17785":2897,"_68426":2897},"language","english","sortableProperties",[2862,29549,5,26884],"sortablePropertiesWithTypes",{"_2862":24522,"_29549":24522,"_5":24522,"_26884":24522},"sorts",{"_2862":57041,"_29549":59888,"_5":62734,"_26884":65580},{"_4531":57042,"_57043":57044,"_5":24522},{"_14169":3549,"_14545":11987,"_14564":4673,"_28558":6802,"_14551":16786,"_19483":8470,"_14190":5847,"_14197":3438,"_28500":5035,"_28909":4682,"_28930":4725,"_28534":3378,"_33862":5812,"_28637":7328,"_28974":7336,"_33869":3095,"_33872":10811,"_33875":6006,"_33878":15215,"_29381":4327,"_33883":16951,"_33885":3550,"_29411":13181,"_14560":13004,"_33889":17861,"_33892":5818,"_33894":6046,"_28958":7420,"_29376":6820,"_29424":3616,"_33899":3575,"_33901":3910,"_33903":10270,"_28654":2961,"_33906":3625,"_33908":7370,"_33910":12084,"_33912":3566,"_33914":18457,"_28571":25481,"_33917":4652,"_33919":5027,"_28565":3260,"_28995":19959,"_33923":7360,"_33925":7025,"_33928":2972,"_28611":3055,"_33932":2973,"_28491":3903,"_33935":4260,"_28539":8429,"_33938":5863,"_33940":3244,"_33943":6191,"_14554":6779,"_33946":6440,"_33948":7468,"_33951":5929,"_33953":9392,"_33955":5939,"_33957":16285,"_33959":6007,"_19486":24931,"_33962":6016,"_33964":5805,"_28512":10271,"_28952":7227,"_33968":6017,"_33970":4109,"_33972":13005,"_29441":8629,"_33975":5693,"_33977":5899,"_33979":17806,"_29535":3923,"_29011":14968,"_33983":7376,"_33985":3551,"_28549":4311,"_33988":6781,"_33990":4194,"_33992":6938,"_29457":22882,"_28631":19943,"_27966":5405,"_33997":20662,"_33999":7387,"_34001":20663,"_28680":3185,"_34005":24525,"_28946":7099,"_34009":9651,"_34011":4217,"_34013":17026,"_34015":10781,"_34017":7401,"_34019":11100,"_28669":4594,"_28914":4989,"_34023":5699,"_34025":5432,"_34027":9650,"_34030":3311,"_34032":19758,"_34034":3106,"_34036":4589,"_34038":3967,"_34040":15938,"_34042":15764,"_34045":8478,"_34047":7100,"_34049":3184,"_34051":20104,"_34053":23392,"_34056":3327,"_34058":16915,"_34061":5040,"_34064":3077,"_34066":6811,"_34068":6150,"_34070":5702,"_34072":5677,"_34074":48133,"_34076":6834,"_34078":4896,"_34080":6791,"_28957":26137,"_34083":4370,"_34085":9154,"_34087":5458,"_34089":5791,"_34091":4588,"_34093":3265,"_34095":4583,"_34097":10820,"_34099":5503,"_34101":6749,"_34103":3437,"_34105":10772,"_34107":5676,"_34109":3661,"_34111":5842,"_34113":3660,"_34115":11685,"_34117":23496,"_34119":4821,"_34121":2899,"_34123":5366,"_34125":4822,"_34127":6737,"_34129":16476,"_34131":7339,"_34133":3818,"_34135":12011,"_34137":7338,"_34139":7288,"_34141":3974,"_34143":4557,"_34145":18063,"_34147":3224,"_34149":3875,"_34151":11379,"_34153":8180,"_34155":6748,"_34157":5008,"_34159":11934,"_28951":3878,"_34162":23134,"_34164":3339,"_34166":3877,"_34168":7719,"_34170":8386,"_34172":5009,"_34175":3876,"_34177":3601,"_34179":5200,"_34181":5876,"_34183":6161,"_34185":3931,"_34187":5169,"_34189":6390,"_34191":16531,"_34193":3832,"_34195":3466,"_34197":5021,"_34199":5022,"_34201":6812,"_34203":24534,"_34205":5852,"_34207":9355,"_28945":4520,"_34210":4847,"_34213":7424,"_34216":23135,"_34218":3916,"_34220":2953,"_34222":3225,"_34224":3976,"_29396":14132,"_34227":6782,"_34229":3320,"_34231":3996,"_29386":3304,"_34234":7364,"_34236":3271,"_34238":3063,"_34240":4054,"_34242":24080,"_34244":16391,"_34246":21015,"_34248":5857,"_34250":4828,"_34252":3064,"_34254":7286,"_34256":7367,"_34258":7402,"_34260":11377,"_34262":3109,"_34264":19683,"_34266":6392,"_34268":21729,"_34270":15939,"_29406":11935,"_34273":3338,"_34276":2947,"_34278":4496,"_34281":15475,"_34283":4616,"_34286":4993,"_34288":14620,"_34290":7500,"_34293":9170,"_34295":13159,"_34298":2984,"_34301":5877,"_34304":13114,"_34307":5360,"_34309":11143,"_34311":4834,"_34313":3917,"_34315":4839,"_34317":4939,"_34319":6434,"_34321":4862,"_34324":11825,"_34327":4753,"_34329":3443,"_34332":18827,"_34334":6190,"_34